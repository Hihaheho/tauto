import "machine.taut"
import "programs.taut"
import "typing.taut"

perform show("2 + 3: output shape", output_shape(sum_program(), Empty))
perform show("2 + 3: result", check_and_run(sum_program(), EmptyStack))
perform show("branch true, then double", check_and_run(branch_program(true), EmptyStack))
perform show("branch false, then double", check_and_run(branch_program(false), EmptyStack))
perform show("preserved input tail", check_and_run(sum_program(), Boolean(false, EmptyStack)))
perform show("duplicate a boolean", check_and_run(Exec(Dup), Boolean(false, EmptyStack)))
perform show("underflow: rejected", output_shape(underflow_program(), Empty))
perform show("wrong operand: rejected", output_shape(wrong_kind_program(), Empty))
perform show("different branch types: rejected", output_shape(mismatched_branches(), Empty))
perform show("hidden error: unchecked run", run(hidden_error_program(), EmptyStack))
perform show("hidden error: rejected", output_shape(hidden_error_program(), Empty))
perform show("hidden error: checked run", check_and_run(hidden_error_program(), EmptyStack))
