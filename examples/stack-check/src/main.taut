import "machine.taut"
import "programs.taut"
import "typing.taut"

perform main(() => {
  show(&output_shape(sum_program(), Empty))
  show(&check_and_run(sum_program(), EmptyStack))
  show(&check_and_run(branch_program(true), EmptyStack))
  show(&check_and_run(branch_program(false), EmptyStack))
  show(&check_and_run(sum_program(), Boolean(false, EmptyStack)))
  show(&check_and_run(Exec(Dup), Boolean(false, EmptyStack)))
  show(&output_shape(underflow_program(), Empty))
  show(&output_shape(wrong_kind_program(), Empty))
  show(&output_shape(mismatched_branches(), Empty))
  show(&run(hidden_error_program(), EmptyStack))
  show(&output_shape(hidden_error_program(), Empty))
  show(&check_and_run(hidden_error_program(), EmptyStack))
})
