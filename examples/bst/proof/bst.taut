import "../src/bst.taut"
import "../../../std/Ord.taut"
import "../../../std/Base.taut"
import std::prelude::Ord

// What the tree operations do, proved for any keys with an order (`Ord(A)`). The proofs use the
// laws of `Ord` (`std/prelude/Ord.taut`) and nothing about the keys; the examples on `Nat` use
// `Ord(Nat)` of `std/Ord.taut`. No program imports this file; `tauto check` checks it.

pub(open) inductive In(A: Type, x: A): (Tree(A)) -> Prop {
  InHere<l: Tree(A), r: Tree(A)>: In(A, x, MkNode(l, x, r))
  InLeft<l: Tree(A), k: A, r: Tree(A)>(h: In(A, x, l)): In(A, x, MkNode(l, k, r))
  InRight<l: Tree(A), k: A, r: Tree(A)>(h: In(A, x, r)): In(A, x, MkNode(l, k, r))
}

pub fn lt<A>(a: A, b: A): Prop where Ord(A) { Ord::compare(a, b) = Less }

pub fn all_less<A>(t: Tree(A), k: A): Prop where Ord(A) { (∀ y: A. (In(A, y, t)) -> lt(y, k)) }

pub fn all_greater<A>(t: Tree(A), k: A): Prop where Ord(A) { (∀ y: A. (In(A, y, t)) -> lt(k, y)) }

// `t` is ordered: at every node, the keys on the left are smaller and those on the right larger.
// `R` is the "smaller" relation; `bst` below is it at `lt`.
pub(open) inductive Bst(A: Type, R: (A, A) -> Prop): (Tree(A)) -> Prop {
  BstLeaf: Bst(A, R, Leaf)
  BstNode<l: Tree(
    A
  ), k: A, r: Tree(
    A
  )>(
    hl: Bst(A, R, l),
    hr: Bst(A, R, r),
    al: (∀ y: A. (In(A, y, l)) -> R(y, k)),
    ar: (∀ y: A. (In(A, y, r)) -> R(k, y))
  ): Bst(A, R, MkNode(l, k, r))
}

pub fn bst<A>(t: Tree(A)): Prop where Ord(A) { Bst(A, (a: A, b: A) => lt(a, b), t) }

pub theorem bst_build<A, l: Tree(
  A
), k: A, r: Tree(
  A
)>(
  hl: bst(l),
  hr: bst(r),
  al: all_less(l, k),
  ar: all_greater(r, k)
): bst(MkNode(l, k, r)) where Ord(A) {
  BstNode(hl, hr, al, ar)
}

pub theorem bst_left<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  hb: bst(MkNode(l, k, r))
): bst(l) where Ord(A) {
  match hb: bst(l) {
    BstNode(l2, k2, r2, hl, hr, al, ar) => hl
  }
}

pub theorem bst_right<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  hb: bst(MkNode(l, k, r))
): bst(r) where Ord(A) {
  match hb: bst(r) {
    BstNode(l2, k2, r2, hl, hr, al, ar) => hr
  }
}

pub theorem bst_all_less<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  hb: bst(MkNode(l, k, r))
): all_less(l, k) where Ord(A) {
  match hb: all_less(l, k) {
    BstNode(l2, k2, r2, hl, hr, al, ar) => al
  }
}

pub theorem bst_all_greater<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  hb: bst(MkNode(l, k, r))
): all_greater(r, k) where Ord(A) {
  match hb: all_greater(r, k) {
    BstNode(l2, k2, r2, hl, hr, al, ar) => ar
  }
}

pub theorem cmp_less<A>(
  a: A,
  b: A,
  e: Ord::compare(a, b) = Less
): lt(a, b) where Ord(A) {
  e
}

pub theorem cmp_equal<A>(
  a: A,
  b: A,
  e: Ord::compare(a, b) = Equal
): a = b where Ord(A) {
  ord_equal_eq(a, b, e)
}

pub theorem cmp_greater<A>(
  a: A,
  b: A,
  e: Ord::compare(a, b) = Greater
): lt(b, a) where Ord(A) {
  ord_swap_greater(a, b, e)
}

pub theorem cmp_of_less<A>(
  a: A,
  b: A,
  h: lt(a, b)
): Ord::compare(a, b) = Less where Ord(A) {
  h
}

pub theorem cmp_of_greater<A>(
  a: A,
  b: A,
  h: lt(b, a)
): Ord::compare(a, b) = Greater where Ord(A) {
  ord_swap_less(b, a, h)
}

pub theorem cmp_refl<A>(a: A): Ord::compare(a, a) = Equal where Ord(A) {
  ord_eq_equal(a, a, Refl)
}

pub theorem lt_trans<A>(a: A, b: A, c: A, h1: lt(a, b), h2: lt(b, c)): lt(a, c) where Ord(A) {
  Ord::trans(h1, h2)
}

pub theorem less_irrefl<A>(a: A, h: Ord::compare(a, a) = Less): False where Ord(A) {
  equal_ne_less(Eq::trans(Eq::sym(cmp_refl(a)), h))
}

pub theorem less_asym<A>(
  a: A,
  b: A,
  h1: Ord::compare(a, b) = Less,
  h2: Ord::compare(b, a) = Less
): False where Ord(A) {
  greater_ne_less(Eq::trans(Eq::sym(ord_swap_less(a, b, h1)), h2))
}

// `Eq::subst` at `Ordering`: the motive is then known to be a function on `Ordering`, so it may `match` on its argument.
pub theorem ord_subst(
  P: (Ordering) -> Prop,
  a: Ordering,
  b: Ordering,
  e: a = b,
  p: P(a)
): P(b) {
  Eq::subst(P, e, p)
}

pub theorem insert_less<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Less
): tree_insert(x, MkNode(l, k, r)) = MkNode(tree_insert(x, l), k, r) where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Tree(A) {
        Less => MkNode(tree_insert(x, l), k, r)
        Equal => MkNode(l, k, r)
        Greater => MkNode(l, k, tree_insert(x, r))
      } = MkNode(tree_insert(x, l), k, r),
    Less,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

pub theorem insert_equal<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Equal
): tree_insert(x, MkNode(l, k, r)) = MkNode(l, k, r) where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Tree(A) {
        Less => MkNode(tree_insert(x, l), k, r)
        Equal => MkNode(l, k, r)
        Greater => MkNode(l, k, tree_insert(x, r))
      } = MkNode(l, k, r),
    Equal,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

pub theorem insert_greater<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Greater
): tree_insert(x, MkNode(l, k, r)) = MkNode(l, k, tree_insert(x, r)) where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Tree(A) {
        Less => MkNode(tree_insert(x, l), k, r)
        Equal => MkNode(l, k, r)
        Greater => MkNode(l, k, tree_insert(x, r))
      } = MkNode(l, k, tree_insert(x, r)),
    Greater,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

pub theorem in_of_key<A>(
  y: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  p: y = k
): In(A, y, MkNode(l, k, r)) where Ord(A) {
  let here: In(A, k, MkNode(l, k, r)) := InHere
  Eq::subst((z: A) => In(A, z, MkNode(l, k, r)), Eq::sym(p), here)
}

pub theorem in_node_inv<A>(
  y: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  h: In(A, y, MkNode(l, k, r))
): Or(y = k, Or(In(A, y, l), In(A, y, r))) where Ord(A) {
  match h: Or(y = k, Or(In(A, y, l), In(A, y, r))) {
    InHere(l2, r2) => OrInl(Refl)
    InLeft(l2, k2, r2, h1) => OrInr(OrInl(h1))
    InRight(l2, k2, r2, h1) => OrInr(OrInr(h1))
  }
}

pub theorem not_in_leaf<A>(y: A, h: In(A, y, Leaf)): False where Ord(A) {
  match h: False {
  }
}

pub theorem in_insert_inv<A>(
  x: A,
  t: Tree(A),
  y: A,
  h: In(A, y, tree_insert(x, t))
): Or(y = x, In(A, y, t)) where Ord(A) {
  match t: Or(y = x, In(A, y, t)) {
    Leaf => Or::elim(
      in_node_inv(y, Leaf, x, Leaf, h),
      p => OrInl(p),
      q => Or::elim(q, q1 => False::elim(not_in_leaf(y, q1)), q2 => False::elim(not_in_leaf(y, q2)))
    )
    MkNode(l, k, r) => Ordering::cases(
      (o: Ordering) => Or(y = x, In(A, y, MkNode(l, k, r))),
      Ord::compare(x, k),
      e => Or::elim(
        in_node_inv(
          y,
          tree_insert(x, l),
          k,
          r,
          Eq::subst((z: Tree(A)) => In(A, y, z), insert_less(x, l, k, r, e), h)
        ),
        p => OrInr(in_of_key(y, l, k, r, p)),
        q => Or::elim(
          q,
          q1 => Or::elim(in_insert_inv(x, l, y, q1), p => OrInl(p), p => OrInr(InLeft(p))),
          q2 => OrInr(InRight(q2))
        )
      ),
      e => OrInr(Eq::subst((z: Tree(A)) => In(A, y, z), insert_equal(x, l, k, r, e), h)),
      e => Or::elim(
        in_node_inv(
          y,
          l,
          k,
          tree_insert(x, r),
          Eq::subst((z: Tree(A)) => In(A, y, z), insert_greater(x, l, k, r, e), h)
        ),
        p => OrInr(in_of_key(y, l, k, r, p)),
        q => Or::elim(
          q,
          q1 => OrInr(InLeft(q1)),
          q2 => Or::elim(in_insert_inv(x, r, y, q2), p => OrInl(p), p => OrInr(InRight(p)))
        )
      )
    )
  }
}

pub theorem in_insert_intro<A>(
  x: A,
  t: Tree(A),
  y: A,
  p: Or(y = x, In(A, y, t))
): In(A, y, tree_insert(x, t)) where Ord(A) {
  match t: In(A, y, tree_insert(x, t)) {
    Leaf => Or::elim(p, e => in_of_key(y, Leaf, x, Leaf, e), q => False::elim(not_in_leaf(y, q)))
    MkNode(l, k, r) => match Ord::compare(x, k) eqn e: In(A, y, tree_insert(x, MkNode(l, k, r))) {
      Less => ⊢ In(A, y, MkNode(tree_insert(x, l), k, r)) from Or::elim(
        p,
        p1 => InLeft(in_insert_intro(x, l, y, OrInl(p1))),
        q => Or::elim(
          in_node_inv(y, l, k, r, q),
          q1 => in_of_key(y, tree_insert(x, l), k, r, q1),
          q2 => Or::elim(q2, q3 => InLeft(in_insert_intro(x, l, y, OrInr(q3))), q4 => InRight(q4))
        )
      )
      Equal => ⊢ In(A, y, MkNode(l, k, r)) from Or::elim(
        p,
        p1 => in_of_key(y, l, k, r, Eq::trans(p1, cmp_equal(x, k, e))),
        q => q
      )
      Greater => ⊢ In(A, y, MkNode(l, k, tree_insert(x, r))) from Or::elim(
        p,
        p1 => InRight(in_insert_intro(x, r, y, OrInl(p1))),
        q => Or::elim(
          in_node_inv(y, l, k, r, q),
          q1 => in_of_key(y, l, k, tree_insert(x, r), q1),
          q2 => Or::elim(q2, q3 => InLeft(q3), q4 => InRight(in_insert_intro(x, r, y, OrInr(q4))))
        )
      )
    }
  }
}

pub theorem insert_bst<A>(x: A, t: Tree(A), h: bst(t)): bst(tree_insert(x, t)) where Ord(A) {
  match t: bst(tree_insert(x, t)) {
    Leaf => bst_build(
      BstLeaf,
      BstLeaf,
      (y: A) => (hy: In(A, y, Leaf)) => False::elim(not_in_leaf(y, hy)),
      (y: A) => (hy: In(A, y, Leaf)) => False::elim(not_in_leaf(y, hy))
    )
    MkNode(l, k, r) => match Ord::compare(x, k) eqn e: bst(tree_insert(x, MkNode(l, k, r))) {
      Less => ⊢ bst(MkNode(tree_insert(x, l), k, r)) from bst_build(
        insert_bst(x, l, bst_left(l, k, r, h)),
        bst_right(l, k, r, h),
        (y: A) => (hy: In(A, y, tree_insert(x, l))) => Or::elim(
          in_insert_inv(x, l, y, hy),
          p => Eq::subst((z: A) => lt(z, k), Eq::sym(p), cmp_less(x, k, e)),
          q => bst_all_less(l, k, r, h)(y, q)
        ),
        bst_all_greater(l, k, r, h)
      )
      Equal => ⊢ bst(MkNode(l, k, r)) from bst_build(
        bst_left(l, k, r, h),
        bst_right(l, k, r, h),
        bst_all_less(l, k, r, h),
        bst_all_greater(l, k, r, h)
      )
      Greater => ⊢ bst(MkNode(l, k, tree_insert(x, r))) from bst_build(
        bst_left(l, k, r, h),
        insert_bst(x, r, bst_right(l, k, r, h)),
        bst_all_less(l, k, r, h),
        (y: A) => (hy: In(A, y, tree_insert(x, r))) => Or::elim(
          in_insert_inv(x, r, y, hy),
          p => Eq::subst((z: A) => lt(k, z), Eq::sym(p), cmp_greater(x, k, e)),
          q => bst_all_greater(l, k, r, h)(y, q)
        )
      )
    }
  }
}

pub theorem member_less<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Less
): tree_member(x, MkNode(l, k, r)) = tree_member(x, l) where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Bool {
        Less => tree_member(x, l)
        Equal => true
        Greater => tree_member(x, r)
      } = tree_member(x, l),
    Less,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

pub theorem member_equal<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Equal
): tree_member(x, MkNode(l, k, r)) = true where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Bool {
        Less => tree_member(x, l)
        Equal => true
        Greater => tree_member(x, r)
      } = true,
    Equal,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

pub theorem member_greater<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Greater
): tree_member(x, MkNode(l, k, r)) = tree_member(x, r) where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Bool {
        Less => tree_member(x, l)
        Equal => true
        Greater => tree_member(x, r)
      } = tree_member(x, r),
    Greater,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

// A key that is found is a key (the tree need not be ordered).
pub theorem member_sound<A>(
  x: A,
  t: Tree(A),
  h: tree_member(x, t) = true
): In(A, x, t) where Ord(A) {
  match t: In(A, x, t) {
    Leaf => False::elim(false_ne_true(h))
    MkNode(l, k, r) => Ordering::cases(
      (o: Ordering) => In(A, x, MkNode(l, k, r)),
      Ord::compare(x, k),
      e => InLeft(
        member_sound(x, l, Eq::subst((z: Bool) => z = true, member_less(x, l, k, r, e), h))
      ),
      e => in_of_key(x, l, k, r, cmp_equal(x, k, e)),
      e => InRight(
        member_sound(x, r, Eq::subst((z: Bool) => z = true, member_greater(x, l, k, r, e), h))
      )
    )
  }
}

pub theorem member_complete<A>(
  x: A,
  t: Tree(A),
  hb: bst(t),
  hi: In(A, x, t)
): tree_member(x, t) = true where Ord(A) {
  match t: (tree_member(x, t) = true) {
    Leaf => False::elim(not_in_leaf(x, hi))
    MkNode(l, k, r) => Ordering::cases(
      (o: Ordering) => tree_member(x, MkNode(l, k, r)) = true,
      Ord::compare(x, k),
      e => Eq::subst(
        (z: Bool) => z = true,
        Eq::sym(member_less(x, l, k, r, e)),
        member_complete(
          x,
          l,
          bst_left(l, k, r, hb),
          Or::elim(
            in_node_inv(x, l, k, r, hi),
            p => False::elim(less_irrefl(k, Eq::subst((z: A) => lt(z, k), p, cmp_less(x, k, e)))),
            q => Or::elim(
              q,
              q1 => q1,
              q2 => False::elim(
                less_asym(x, k, cmp_less(x, k, e), bst_all_greater(l, k, r, hb)(x, q2))
              )
            )
          )
        )
      ),
      e => member_equal(x, l, k, r, e),
      e => Eq::subst(
        (z: Bool) => z = true,
        Eq::sym(member_greater(x, l, k, r, e)),
        member_complete(
          x,
          r,
          bst_right(l, k, r, hb),
          Or::elim(
            in_node_inv(x, l, k, r, hi),
            p => False::elim(less_irrefl(k, Eq::subst((z: A) => lt(k, z), p, cmp_greater(x, k, e)))),
            q => Or::elim(
              q,
              q1 => False::elim(
                less_asym(x, k, bst_all_less(l, k, r, hb)(x, q1), cmp_greater(x, k, e))
              ),
              q2 => q2
            )
          )
        )
      )
    )
  }
}

pub theorem member_correct<A>(
  x: A,
  t: Tree(A),
  hb: bst(t)
): Iff(tree_member(x, t) = true, In(A, x, t)) where Ord(A) {
  IffIntro(
    (h: tree_member(x, t) = true) => member_sound(x, t, h),
    (h: In(A, x, t)) => member_complete(x, t, hb, h)
  )
}

pub theorem small_tree(): tree_insert(2, tree_insert(3, tree_insert(1, Leaf))) = MkNode(Leaf, 1, MkNode(MkNode(Leaf, 2, Leaf), 3, Leaf)) {
  Refl
}

pub theorem min_in<A>(
  l: Tree(A),
  k: A,
  r: Tree(A)
): In(A, tree_min(l, k), MkNode(l, k, r)) where Ord(A) {
  match l: In(A, tree_min(l, k), MkNode(l, k, r)) {
    Leaf => InHere
    MkNode(ll, lk, lr) => InLeft(min_in(ll, lk, lr))
  }
}

pub theorem remove_min_cases<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  y: A,
  h: In(A, y, MkNode(l, k, r))
): Or(y = tree_min(l, k), In(A, y, tree_remove_min(MkNode(l, k, r)))) where Ord(A) {
  match l: Or(y = tree_min(l, k), In(A, y, tree_remove_min(MkNode(l, k, r)))) {
    Leaf => Or::elim(
      in_node_inv(y, Leaf, k, r, h),
      p => OrInl(p),
      q => Or::elim(q, q1 => False::elim(not_in_leaf(y, q1)), q2 => OrInr(q2))
    )
    MkNode(ll, lk, lr) => Or::elim(
      in_node_inv(y, MkNode(ll, lk, lr), k, r, h),
      p => OrInr(in_of_key(y, tree_remove_min(MkNode(ll, lk, lr)), k, r, p)),
      q => Or::elim(
        q,
        q1 => Or::elim(remove_min_cases(ll, lk, lr, y, q1), p => OrInl(p), p => OrInr(InLeft(p))),
        q2 => OrInr(InRight(q2))
      )
    )
  }
}

pub theorem remove_min_sub<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  y: A,
  h: In(A, y, tree_remove_min(MkNode(l, k, r)))
): In(A, y, MkNode(l, k, r)) where Ord(A) {
  match l: In(A, y, MkNode(l, k, r)) {
    Leaf => InRight(h)
    MkNode(ll, lk, lr) => Or::elim(
      in_node_inv(y, tree_remove_min(MkNode(ll, lk, lr)), k, r, h),
      p => in_of_key(y, MkNode(ll, lk, lr), k, r, p),
      q => Or::elim(q, q1 => InLeft(remove_min_sub(ll, lk, lr, y, q1)), q2 => InRight(q2))
    )
  }
}

pub theorem min_least<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  hb: bst(MkNode(l, k, r)),
  y: A,
  h: In(A, y, MkNode(l, k, r))
): Or(tree_min(l, k) = y, lt(tree_min(l, k), y)) where Ord(A) {
  match l: Or(tree_min(l, k) = y, lt(tree_min(l, k), y)) {
    Leaf => Or::elim(
      in_node_inv(y, Leaf, k, r, h),
      p => OrInl(Eq::sym(p)),
      q => Or::elim(
        q,
        q1 => False::elim(not_in_leaf(y, q1)),
        q2 => OrInr(bst_all_greater(Leaf, k, r, hb)(y, q2))
      )
    )
    MkNode(ll, lk, lr) => Or::elim(
      in_node_inv(y, MkNode(ll, lk, lr), k, r, h),
      p => OrInr(
        Eq::subst(
          (z: A) => lt(tree_min(ll, lk), z),
          Eq::sym(p),
          bst_all_less(MkNode(ll, lk, lr), k, r, hb)(tree_min(ll, lk), min_in(ll, lk, lr))
        )
      ),
      q => Or::elim(
        q,
        q1 => min_least(ll, lk, lr, bst_left(MkNode(ll, lk, lr), k, r, hb), y, q1),
        q2 => OrInr(
          lt_trans(
            tree_min(ll, lk),
            k,
            y,
            bst_all_less(MkNode(ll, lk, lr), k, r, hb)(tree_min(ll, lk), min_in(ll, lk, lr)),
            bst_all_greater(MkNode(ll, lk, lr), k, r, hb)(y, q2)
          )
        )
      )
    )
  }
}

pub theorem remove_min_bst<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  hb: bst(MkNode(l, k, r))
): bst(tree_remove_min(MkNode(l, k, r))) where Ord(A) {
  match l: bst(tree_remove_min(MkNode(l, k, r))) {
    Leaf => bst_right(Leaf, k, r, hb)
    MkNode(ll, lk, lr) => bst_build(
      remove_min_bst(ll, lk, lr, bst_left(MkNode(ll, lk, lr), k, r, hb)),
      bst_right(MkNode(ll, lk, lr), k, r, hb),
      (y: A) => (hy: In(A, y, tree_remove_min(MkNode(ll, lk, lr)))) => bst_all_less(
        MkNode(ll, lk, lr),
        k,
        r,
        hb
      )(y, remove_min_sub(ll, lk, lr, y, hy)),
      bst_all_greater(MkNode(ll, lk, lr), k, r, hb)
    )
  }
}

pub theorem remove_min_greater<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  hb: bst(MkNode(l, k, r)),
  y: A,
  h: In(A, y, tree_remove_min(MkNode(l, k, r)))
): lt(tree_min(l, k), y) where Ord(A) {
  match l: lt(tree_min(l, k), y) {
    Leaf => bst_all_greater(Leaf, k, r, hb)(y, h)
    MkNode(ll, lk, lr) => Or::elim(
      in_node_inv(y, tree_remove_min(MkNode(ll, lk, lr)), k, r, h),
      p => Eq::subst(
        (z: A) => lt(tree_min(ll, lk), z),
        Eq::sym(p),
        bst_all_less(MkNode(ll, lk, lr), k, r, hb)(tree_min(ll, lk), min_in(ll, lk, lr))
      ),
      q => Or::elim(
        q,
        q1 => remove_min_greater(ll, lk, lr, bst_left(MkNode(ll, lk, lr), k, r, hb), y, q1),
        q2 => lt_trans(
          tree_min(ll, lk),
          k,
          y,
          bst_all_less(MkNode(ll, lk, lr), k, r, hb)(tree_min(ll, lk), min_in(ll, lk, lr)),
          bst_all_greater(MkNode(ll, lk, lr), k, r, hb)(y, q2)
        )
      )
    )
  }
}

pub theorem join_sub<A>(
  l: Tree(A),
  r: Tree(A),
  y: A,
  h: In(A, y, tree_join(l, r))
): Or(In(A, y, l), In(A, y, r)) where Ord(A) {
  match r: Or(In(A, y, l), In(A, y, r)) {
    Leaf => OrInl(h)
    MkNode(rl, rk, rr) => Or::elim(
      in_node_inv(y, l, tree_min(rl, rk), tree_remove_min(MkNode(rl, rk, rr)), h),
      p => OrInr(Eq::subst((z: A) => In(A, z, MkNode(rl, rk, rr)), Eq::sym(p), min_in(rl, rk, rr))),
      q => Or::elim(q, q1 => OrInl(q1), q2 => OrInr(remove_min_sub(rl, rk, rr, y, q2)))
    )
  }
}

pub theorem join_intro<A>(
  l: Tree(A),
  r: Tree(A),
  y: A,
  h: Or(In(A, y, l), In(A, y, r))
): In(A, y, tree_join(l, r)) where Ord(A) {
  match r: In(A, y, tree_join(l, r)) {
    Leaf => Or::elim(h, h1 => h1, h2 => False::elim(not_in_leaf(y, h2)))
    MkNode(rl, rk, rr) => Or::elim(
      h,
      h1 => InLeft(h1),
      h2 => Or::elim(
        remove_min_cases(rl, rk, rr, y, h2),
        p => in_of_key(y, l, tree_min(rl, rk), tree_remove_min(MkNode(rl, rk, rr)), p),
        q => InRight(q)
      )
    )
  }
}

pub theorem join_bst<A>(
  l: Tree(A),
  k: A,
  r: Tree(A),
  hb: bst(MkNode(l, k, r))
): bst(tree_join(l, r)) where Ord(A) {
  match r: bst(tree_join(l, r)) {
    Leaf => bst_left(l, k, r, hb)
    MkNode(rl, rk, rr) => bst_build(
      bst_left(l, k, r, hb),
      remove_min_bst(rl, rk, rr, bst_right(l, k, r, hb)),
      (y: A) => (hy: In(A, y, l)) => lt_trans(
        y,
        k,
        tree_min(rl, rk),
        bst_all_less(l, k, r, hb)(y, hy),
        bst_all_greater(l, k, r, hb)(tree_min(rl, rk), min_in(rl, rk, rr))
      ),
      (y: A) => (hy: In(A, y, tree_remove_min(MkNode(rl, rk, rr)))) => remove_min_greater(
        rl,
        rk,
        rr,
        bst_right(l, k, r, hb),
        y,
        hy
      )
    )
  }
}

pub theorem delete_less<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Less
): tree_delete(x, MkNode(l, k, r)) = MkNode(tree_delete(x, l), k, r) where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Tree(A) {
        Less => MkNode(tree_delete(x, l), k, r)
        Equal => tree_join(l, r)
        Greater => MkNode(l, k, tree_delete(x, r))
      } = MkNode(tree_delete(x, l), k, r),
    Less,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

pub theorem delete_equal<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Equal
): tree_delete(x, MkNode(l, k, r)) = tree_join(l, r) where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Tree(A) {
        Less => MkNode(tree_delete(x, l), k, r)
        Equal => tree_join(l, r)
        Greater => MkNode(l, k, tree_delete(x, r))
      } = tree_join(l, r),
    Equal,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

pub theorem delete_greater<A>(
  x: A,
  l: Tree(A),
  k: A,
  r: Tree(A),
  e: Ord::compare(x, k) = Greater
): tree_delete(x, MkNode(l, k, r)) = MkNode(l, k, tree_delete(x, r)) where Ord(A) {
  ord_subst(
    (q: Ordering) => match q: Tree(A) {
        Less => MkNode(tree_delete(x, l), k, r)
        Equal => tree_join(l, r)
        Greater => MkNode(l, k, tree_delete(x, r))
      } = MkNode(l, k, tree_delete(x, r)),
    Greater,
    Ord::compare(x, k),
    Eq::sym(e),
    Refl
  )
}

pub theorem delete_sub<A>(
  x: A,
  t: Tree(A),
  y: A,
  h: In(A, y, tree_delete(x, t))
): In(A, y, t) where Ord(A) {
  match t: In(A, y, t) {
    Leaf => h
    MkNode(l, k, r) => Ordering::cases(
      (o: Ordering) => In(A, y, MkNode(l, k, r)),
      Ord::compare(x, k),
      e => Or::elim(
        in_node_inv(
          y,
          tree_delete(x, l),
          k,
          r,
          Eq::subst((z: Tree(A)) => In(A, y, z), delete_less(x, l, k, r, e), h)
        ),
        p => in_of_key(y, l, k, r, p),
        q => Or::elim(q, q1 => InLeft(delete_sub(x, l, y, q1)), q2 => InRight(q2))
      ),
      e => Or::elim(
        join_sub(l, r, y, Eq::subst((z: Tree(A)) => In(A, y, z), delete_equal(x, l, k, r, e), h)),
        q1 => InLeft(q1),
        q2 => InRight(q2)
      ),
      e => Or::elim(
        in_node_inv(
          y,
          l,
          k,
          tree_delete(x, r),
          Eq::subst((z: Tree(A)) => In(A, y, z), delete_greater(x, l, k, r, e), h)
        ),
        p => in_of_key(y, l, k, r, p),
        q => Or::elim(q, q1 => InLeft(q1), q2 => InRight(delete_sub(x, r, y, q2)))
      )
    )
  }
}

pub theorem delete_gone<A>(
  x: A,
  t: Tree(A),
  hb: bst(t),
  y: A,
  h: In(A, y, tree_delete(x, t)),
  e: y = x
): False where Ord(A) {
  match t: False {
    Leaf => not_in_leaf(y, h)
    MkNode(l, k, r) => Ordering::cases(
      (o: Ordering) => False,
      Ord::compare(x, k),
      d => Or::elim(
        in_node_inv(
          y,
          tree_delete(x, l),
          k,
          r,
          Eq::subst((z: Tree(A)) => In(A, y, z), delete_less(x, l, k, r, d), h)
        ),
        p => less_irrefl(
          k,
          Eq::subst((z: A) => lt(z, k), Eq::trans(Eq::sym(e), p), cmp_less(x, k, d))
        ),
        q => Or::elim(
          q,
          q1 => delete_gone(x, l, bst_left(l, k, r, hb), y, q1, e),
          q2 => less_asym(
            x,
            k,
            cmp_less(x, k, d),
            Eq::subst((z: A) => lt(k, z), e, bst_all_greater(l, k, r, hb)(y, q2))
          )
        )
      ),
      d => Or::elim(
        join_sub(l, r, y, Eq::subst((z: Tree(A)) => In(A, y, z), delete_equal(x, l, k, r, d), h)),
        q1 => less_irrefl(
          k,
          Eq::subst(
            (z: A) => lt(z, k),
            Eq::trans(e, cmp_equal(x, k, d)),
            bst_all_less(l, k, r, hb)(y, q1)
          )
        ),
        q2 => less_irrefl(
          k,
          Eq::subst(
            (z: A) => lt(k, z),
            Eq::trans(e, cmp_equal(x, k, d)),
            bst_all_greater(l, k, r, hb)(y, q2)
          )
        )
      ),
      d => Or::elim(
        in_node_inv(
          y,
          l,
          k,
          tree_delete(x, r),
          Eq::subst((z: Tree(A)) => In(A, y, z), delete_greater(x, l, k, r, d), h)
        ),
        p => less_irrefl(
          k,
          Eq::subst((z: A) => lt(k, z), Eq::trans(Eq::sym(e), p), cmp_greater(x, k, d))
        ),
        q => Or::elim(
          q,
          q1 => less_asym(
            x,
            k,
            Eq::subst((z: A) => lt(z, k), e, bst_all_less(l, k, r, hb)(y, q1)),
            cmp_greater(x, k, d)
          ),
          q2 => delete_gone(x, r, bst_right(l, k, r, hb), y, q2, e)
        )
      )
    )
  }
}

pub theorem delete_keeps<A>(
  x: A,
  t: Tree(A),
  y: A,
  h: In(A, y, t),
  ne: (y = x) -> False
): In(A, y, tree_delete(x, t)) where Ord(A) {
  match t: In(A, y, tree_delete(x, t)) {
    Leaf => h
    MkNode(l, k, r) => Ordering::cases(
      (o: Ordering) => In(A, y, tree_delete(x, MkNode(l, k, r))),
      Ord::compare(x, k),
      e => Eq::subst(
        (z: Tree(A)) => In(A, y, z),
        Eq::sym(delete_less(x, l, k, r, e)),
        Or::elim(
          in_node_inv(y, l, k, r, h),
          p => in_of_key(y, tree_delete(x, l), k, r, p),
          q => Or::elim(q, q1 => InLeft(delete_keeps(x, l, y, q1, ne)), q2 => InRight(q2))
        )
      ),
      e => Eq::subst(
        (z: Tree(A)) => In(A, y, z),
        Eq::sym(delete_equal(x, l, k, r, e)),
        join_intro(
          l,
          r,
          y,
          Or::elim(
            in_node_inv(y, l, k, r, h),
            p => False::elim(ne(Eq::trans(p, Eq::sym(cmp_equal(x, k, e))))),
            q => q
          )
        )
      ),
      e => Eq::subst(
        (z: Tree(A)) => In(A, y, z),
        Eq::sym(delete_greater(x, l, k, r, e)),
        Or::elim(
          in_node_inv(y, l, k, r, h),
          p => in_of_key(y, l, k, tree_delete(x, r), p),
          q => Or::elim(q, q1 => InLeft(q1), q2 => InRight(delete_keeps(x, r, y, q2, ne)))
        )
      )
    )
  }
}

pub theorem delete_bst<A>(x: A, t: Tree(A), hb: bst(t)): bst(tree_delete(x, t)) where Ord(A) {
  match t: bst(tree_delete(x, t)) {
    Leaf => BstLeaf
    MkNode(l, k, r) => Ordering::cases(
      (o: Ordering) => bst(tree_delete(x, MkNode(l, k, r))),
      Ord::compare(x, k),
      e => Eq::subst(
        (z: Tree(A)) => bst(z),
        Eq::sym(delete_less(x, l, k, r, e)),
        bst_build(
          delete_bst(x, l, bst_left(l, k, r, hb)),
          bst_right(l, k, r, hb),
          (y: A) => (hy: In(A, y, tree_delete(x, l))) => bst_all_less(
            l,
            k,
            r,
            hb
          )(y, delete_sub(x, l, y, hy)),
          bst_all_greater(l, k, r, hb)
        )
      ),
      e => Eq::subst(
        (z: Tree(A)) => bst(z),
        Eq::sym(delete_equal(x, l, k, r, e)),
        join_bst(
          l,
          k,
          r,
          bst_build(
            bst_left(l, k, r, hb),
            bst_right(l, k, r, hb),
            bst_all_less(l, k, r, hb),
            bst_all_greater(l, k, r, hb)
          )
        )
      ),
      e => Eq::subst(
        (z: Tree(A)) => bst(z),
        Eq::sym(delete_greater(x, l, k, r, e)),
        bst_build(
          bst_left(l, k, r, hb),
          delete_bst(x, r, bst_right(l, k, r, hb)),
          bst_all_less(l, k, r, hb),
          (y: A) => (hy: In(A, y, tree_delete(x, r))) => bst_all_greater(
            l,
            k,
            r,
            hb
          )(y, delete_sub(x, r, y, hy))
        )
      )
    )
  }
}

// Computed: deleting the root of `1, 3, 2` brings the smallest key of the right subtree up.
pub theorem small_delete(): tree_delete(1, MkNode(Leaf, 1, MkNode(MkNode(Leaf, 2, Leaf), 3, Leaf))) = MkNode(Leaf, 2, MkNode(Leaf, 3, Leaf)) {
  Refl
}
