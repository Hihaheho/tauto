import "../../../std/Base.taut"
import std::prelude::Ord

// A binary search tree of any ordered keys (a set): `where Ord(A)` asks for the order of
// `std/prelude/Ord.taut`, and `Ord::compare` is the one three-way comparison, so each operation has one
// `match` on an `Ordering`. `proof/bst.taut` proves that the operations keep the tree ordered and
// that they do what a set does, from the laws of `Ord` alone.

pub(open) inductive Tree(A: Type): Type {
  Leaf: Tree(A)
  MkNode(l: Tree(A), k: A, r: Tree(A)): Tree(A)
}

pub fn tree_insert<A>(x: A, t: Tree(A)): Tree(A) where Ord(A) {
  match t: Tree(A) {
    Leaf => MkNode(Leaf, x, Leaf)
    MkNode(l, k, r) => match Ord::compare(x, k): Tree(A) {
      Less => MkNode(tree_insert(x, l), k, r)
      Equal => MkNode(l, k, r)
      Greater => MkNode(l, k, tree_insert(x, r))
    }
  }
}

pub fn tree_member<A>(x: A, t: Tree(A)): Bool where Ord(A) {
  match t: Bool {
    Leaf => false
    MkNode(l, k, r) => match Ord::compare(x, k): Bool {
      Less => tree_member(x, l)
      Equal => true
      Greater => tree_member(x, r)
    }
  }
}

pub fn tree_min<A>(l: Tree(A), k: A): A {
  match l: A {
    Leaf => k
    MkNode(ll, lk, lr) => tree_min(ll, lk)
  }
}

pub fn tree_remove_min<A>(t: Tree(A)): Tree(A) {
  match t: Tree(A) {
    Leaf => Leaf
    MkNode(l, k, r) => match l: Tree(A) {
      Leaf => r
      MkNode(ll, lk, lr) => MkNode(tree_remove_min(l), k, r)
    }
  }
}

// The two subtrees of a deleted node as one tree: the smallest key of the right one goes to the root.
pub fn tree_join<A>(l: Tree(A), r: Tree(A)): Tree(A) {
  match r: Tree(A) {
    Leaf => l
    MkNode(rl, rk, rr) => MkNode(l, tree_min(rl, rk), tree_remove_min(MkNode(rl, rk, rr)))
  }
}

pub fn tree_delete<A>(x: A, t: Tree(A)): Tree(A) where Ord(A) {
  match t: Tree(A) {
    Leaf => Leaf
    MkNode(l, k, r) => match Ord::compare(x, k): Tree(A) {
      Less => MkNode(tree_delete(x, l), k, r)
      Equal => tree_join(l, r)
      Greater => MkNode(l, k, tree_delete(x, r))
    }
  }
}
