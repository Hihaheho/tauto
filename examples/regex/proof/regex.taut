import "../../../std/Base.taut"
import "../src/regex.taut"

// What the matcher does, proved. No program imports this file; `tauto check`
// checks it.

pub(open) inductive Matches: (Re) -> (List(Nat)) -> Prop {
  MEps: Matches(REps, Nil)
  MChr<c: Nat>: Matches(RChr(c), Cons(c, Nil))
  MLeft<a: Re, b: Re, w: List(Nat)>(h: Matches(a, w)): Matches(RAlt(a, b), w)
  MRight<a: Re, b: Re, w: List(Nat)>(h: Matches(b, w)): Matches(RAlt(a, b), w)
  MSeq<a: Re, b: Re, s: List(
    Nat
  ), t: List(
    Nat
  ), w: List(
    Nat
  )>(
    ha: Matches(a, s),
    hb: Matches(b, t),
    e: List::append(s, t) = w
  ): Matches(RSeq(a, b), w)
  MStarNil<a: Re>: Matches(RStar(a), Nil)
  MStarCons<a: Re, c: Nat, s: List(
    Nat
  ), t: List(
    Nat
  ), w: List(
    Nat
  )>(
    ha: Matches(a, Cons(c, s)),
    ht: Matches(RStar(a), t),
    e: List::append(Cons(c, s), t) = w
  ): Matches(RStar(a), w)
}

pub theorem append_nil_left(
  s: List(Nat),
  t: List(Nat),
  e: List::append(s, t) = Nil
): s = Nil {
  match s: s = Nil {
    Nil => Refl
    Cons(h, tl) => match e: Cons(h, tl) = Nil {
    }
  }
}

pub theorem append_nil_right(
  s: List(Nat),
  t: List(Nat),
  e: List::append(s, t) = Nil
): t = Nil {
  match s: t = Nil {
    Nil => e
    Cons(h, tl) => match e: t = Nil {
    }
  }
}

pub theorem bool_or_true_right(a: Bool): Bool::or(a, true) = true {
  match a: Bool::or(a, true) = true {
    false => Refl
    true => Refl
  }
}

// `Eq::subst` at `Bool`: the motive is then known to be a function on `Bool`, so it may `match` on its argument.
pub theorem bool_subst(P: (Bool) -> Prop, a: Bool, b: Bool, e: a = b, p: P(a)): P(b) {
  Eq::subst(P, e, p)
}

pub theorem bool_or_inv(x: Bool, y: Bool, h: Bool::or(x, y) = true): x = true ∨ y = true {
  match x: x = true ∨ y = true {
    false => OrInr(h)
    true => OrInl(Refl)
  }
}

pub theorem bool_and_inv(
  x: Bool,
  y: Bool,
  h: Bool::and(x, y) = true
): x = true ∧ y = true {
  match x: x = true ∧ y = true {
    false => False::elim(false_ne_true(h))
    true => AndIntro(Refl, h)
  }
}

pub theorem nullable_sound(r: Re, h: re_nullable(r) = true): Matches(r, Nil) {
  match r: Matches(r, Nil) {
    REmpty => False::elim(false_ne_true(h))
    REps => MEps
    RChr(c) => False::elim(false_ne_true(h))
    RAlt(a, b) => Or::elim(
      bool_or_inv(re_nullable(a), re_nullable(b), h),
      h1 => MLeft(nullable_sound(a, h1)),
      h2 => MRight(nullable_sound(b, h2))
    )
    RSeq(a, b) => match bool_and_inv(re_nullable(a), re_nullable(b), h): Matches(RSeq(a, b), Nil) {
      AndIntro(h1, h2) => MSeq(nullable_sound(a, h1), nullable_sound(b, h2), Refl)
    }
    RStar(a) => MStarNil
  }
}

pub theorem nullable_complete(r: Re, h: Matches(r, Nil)): re_nullable(r) = true {
  match r: re_nullable(r) = true {
    REmpty => match h: false = true {
    }
    REps => Refl
    RChr(c) => match h: false = true {
    }
    RAlt(a, b) => match h: re_nullable(RAlt(a, b)) = true {
      MLeft(a2, b2, w, h1) => Eq::subst(
        (o: Bool) => Bool::or(o, re_nullable(b)) = true,
        Eq::sym(nullable_complete(a, h1)),
        Refl
      )
      MRight(a2, b2, w, h1) => Eq::subst(
        (o: Bool) => Bool::or(re_nullable(a), o) = true,
        Eq::sym(nullable_complete(b, h1)),
        bool_or_true_right(re_nullable(a))
      )
    }
    RSeq(a, b) => match h: re_nullable(RSeq(a, b)) = true {
      MSeq(a2, b2, s, t, w, ha, hb, e) => Eq::subst(
        (o: Bool) => Bool::and(o, re_nullable(b)) = true,
        Eq::sym(
          nullable_complete(
            a,
            Eq::subst((z: List(Nat)) => Matches(a, z), append_nil_left(s, t, e), ha)
          )
        ),
        Eq::subst(
          (o: Bool) => Bool::and(true, o) = true,
          Eq::sym(
            nullable_complete(
              b,
              Eq::subst((z: List(Nat)) => Matches(b, z), append_nil_right(s, t, e), hb)
            )
          ),
          Refl
        )
      )
    }
    RStar(a) => Refl
  }
}

pub theorem seq_cons(
  a: Re,
  b: Re,
  c: Nat,
  s1: List(Nat),
  t: List(Nat),
  s: List(Nat),
  ha: Matches(a, Cons(c, s1)),
  hb: Matches(b, t),
  e: List::append(s1, t) = s
): Matches(RSeq(a, b), Cons(c, s)) {
  MSeq(ha, hb, Eq::congr((z: List(Nat)) => Cons(c, z), e))
}

pub theorem no_match(s: List(Nat), h: Matches(REmpty, s)): False {
  match h: False {
  }
}

pub theorem eps_match(s: List(Nat), h: Matches(REps, s)): s = Nil {
  match h: s = Nil {
    MEps => Refl
  }
}

// The derivative of `d` by `c` is the empty expression, or the empty string, by whether they are equal.
pub theorem deriv_chr_false(
  c: Nat,
  d: Nat,
  s: List(Nat),
  e: Nat::eq(c, d) = false,
  h: Matches(re_deriv(c, RChr(d)), s)
): Matches(REmpty, s) {
  bool_subst(
    (q: Bool) => Matches(
      match q: Re {
        false => REmpty
        true => REps
      },
      s
    ),
    Nat::eq(c, d),
    false,
    e,
    h
  )
}

pub theorem deriv_chr_true(
  c: Nat,
  d: Nat,
  s: List(Nat),
  e: Nat::eq(c, d) = true,
  h: Matches(re_deriv(c, RChr(d)), s)
): Matches(REps, s) {
  bool_subst(
    (q: Bool) => Matches(
      match q: Re {
        false => REmpty
        true => REps
      },
      s
    ),
    Nat::eq(c, d),
    true,
    e,
    h
  )
}

// Past a first part `a`: nothing when `a` is not nullable, `r` when it is.
pub theorem if_nullable_false(
  a: Re,
  r: Re,
  s: List(Nat),
  e: re_nullable(a) = false,
  h: Matches(re_if_nullable(a, r), s)
): False {
  no_match(
    s,
    bool_subst(
      (q: Bool) => Matches(
        match q: Re {
          false => REmpty
          true => r
        },
        s
      ),
      re_nullable(a),
      false,
      e,
      h
    )
  )
}

pub theorem if_nullable_true(
  a: Re,
  r: Re,
  s: List(Nat),
  e: re_nullable(a) = true,
  h: Matches(re_if_nullable(a, r), s)
): Matches(r, s) {
  bool_subst(
    (q: Bool) => Matches(
      match q: Re {
        false => REmpty
        true => r
      },
      s
    ),
    re_nullable(a),
    true,
    e,
    h
  )
}

pub theorem deriv_sound(
  r: Re,
  c: Nat,
  s: List(Nat),
  h: Matches(re_deriv(c, r), s)
): Matches(r, Cons(c, s)) {
  match r: Matches(r, Cons(c, s)) {
    REmpty => match h: Matches(REmpty, Cons(c, s)) {
    }
    REps => match h: Matches(REps, Cons(c, s)) {
    }
    RChr(d) => Bool::cases(
      (o: Bool) => Matches(RChr(d), Cons(c, s)),
      Nat::eq(c, d),
      e => False::elim(no_match(s, deriv_chr_false(c, d, s, e, h))),
      e => Eq::subst(
        (z: List(Nat)) => Matches(RChr(d), Cons(c, z)),
        Eq::sym(eps_match(s, deriv_chr_true(c, d, s, e, h))),
        Eq::subst((x: Nat) => Matches(RChr(d), Cons(x, Nil)), Eq::sym(Nat::eq_sound(c, d, e)), MChr)
      )
    )
    RAlt(a, b) => match h: Matches(RAlt(a, b), Cons(c, s)) {
      MLeft(a2, b2, w, h1) => MLeft(deriv_sound(a, c, w, h1))
      MRight(a2, b2, w, h1) => MRight(deriv_sound(b, c, w, h1))
    }
    RSeq(a, b) => Bool::cases(
      (o: Bool) => Matches(RSeq(a, b), Cons(c, s)),
      re_nullable(a),
      e => match h: Matches(RSeq(a, b), Cons(c, s)) {
        MLeft(a2, b2, w, h1) => match h1: Matches(RSeq(a, b), Cons(c, w)) {
          MSeq(a3, b3, s1, t, w3, ha, hb, e1) => seq_cons(a, b, c, s1, t, w3, deriv_sound(a, c, s1, ha), hb, e1)
        }
        MRight(a2, b2, w, h1) => False::elim(if_nullable_false(a, re_deriv(c, b), w, e, h1))
      },
      e => match h: Matches(RSeq(a, b), Cons(c, s)) {
        MLeft(a2, b2, w, h1) => match h1: Matches(RSeq(a, b), Cons(c, w)) {
          MSeq(a3, b3, s1, t, w3, ha, hb, e1) => seq_cons(a, b, c, s1, t, w3, deriv_sound(a, c, s1, ha), hb, e1)
        }
        MRight(a2, b2, w, h1) => MSeq(
          nullable_sound(a, e),
          deriv_sound(b, c, w, if_nullable_true(a, re_deriv(c, b), w, e, h1)),
          Refl
        )
      }
    )
    RStar(a) => match h: Matches(RStar(a), Cons(c, s)) {
      MSeq(a2, b2, s1, t, w, ha, hb, e) => MStarCons(
        deriv_sound(a, c, s1, ha),
        hb,
        Eq::congr((z: List(Nat)) => Cons(c, z), e)
      )
    }
  }
}

pub theorem if_nullable_intro(
  a: Re,
  r: Re,
  s: List(Nat),
  e: re_nullable(a) = true,
  h: Matches(r, s)
): Matches(re_if_nullable(a, r), s) {
  bool_subst(
    (q: Bool) => Matches(
      match q: Re {
        false => REmpty
        true => r
      },
      s
    ),
    true,
    re_nullable(a),
    Eq::sym(e),
    h
  )
}

pub theorem deriv_chr_same(c: Nat): Matches(re_deriv(c, RChr(c)), Nil) {
  bool_subst(
    (q: Bool) => Matches(
      match q: Re {
        false => REmpty
        true => REps
      },
      Nil
    ),
    true,
    Nat::eq(c, c),
    Eq::sym(Nat::eq_refl(c)),
    MEps
  )
}

pub theorem chr_word(d: Nat, w: List(Nat), h: Matches(RChr(d), w)): Cons(d, Nil) = w {
  match h: Cons(d, Nil) = w {
    MChr(d2) => Refl
  }
}

pub theorem deriv_complete(
  r: Re,
  c: Nat,
  s: List(Nat),
  h: Matches(r, Cons(c, s))
): Matches(re_deriv(c, r), s) {
  match r: Matches(re_deriv(c, r), s) {
    REmpty => match h: Matches(REmpty, s) {
    }
    REps => match h: Matches(REmpty, s) {
    }
    RChr(d) => match chr_word(d, Cons(c, s), h): Matches(re_deriv(c, RChr(d)), s) {
      Refl => deriv_chr_same(c)
    }
    RAlt(a, b) => match h: Matches(re_deriv(c, RAlt(a, b)), s) {
      MLeft(a2, b2, w, h1) => MLeft(deriv_complete(a, c, s, h1))
      MRight(a2, b2, w, h1) => MRight(deriv_complete(b, c, s, h1))
    }
    RSeq(a, b) => match h: Matches(re_deriv(c, RSeq(a, b)), s) {
      MSeq(a2, b2, s1, t, w, ha, hb, e) => match s1: Matches(re_deriv(c, RSeq(a, b)), s) {
        Nil => MRight(
          if_nullable_intro(
            a,
            re_deriv(c, b),
            s,
            nullable_complete(a, ha),
            deriv_complete(b, c, s, Eq::subst((z: List(Nat)) => Matches(b, z), e, hb))
          )
        )
        Cons(c1, s2) => match e: Matches(re_deriv(c, RSeq(a, b)), s) {
          Refl => MLeft(MSeq(deriv_complete(a, c1, s2, ha), hb, Refl))
        }
      }
    }
    RStar(a) => match h: Matches(re_deriv(c, RStar(a)), s) {
      MStarCons(a2, c1, s1, t, w, ha, ht, e) => match e: Matches(re_deriv(c, RStar(a)), s) {
        Refl => MSeq(deriv_complete(a, c1, s1, ha), ht, Refl)
      }
    }
  }
}

pub theorem re_match_sound(w: List(Nat), r: Re, h: re_match(w, r) = true): Matches(r, w) {
  match w: Matches(r, w) {
    Nil => nullable_sound(r, h)
    Cons(c, rest) => deriv_sound(r, c, rest, re_match_sound(rest, re_deriv(c, r), h))
  }
}

pub theorem re_match_complete(w: List(Nat), r: Re, h: Matches(r, w)): re_match(w, r) = true {
  match w: re_match(w, r) = true {
    Nil => nullable_complete(r, h)
    Cons(c, rest) => re_match_complete(rest, re_deriv(c, r), deriv_complete(r, c, rest, h))
  }
}

pub theorem re_match_correct(w: List(Nat), r: Re): Iff(re_match(w, r) = true, Matches(r, w)) {
  IffIntro(re_match_sound(w, r), re_match_complete(w, r))
}

// `(a|b)*abb`, over the byte values of 'a' and 'b'.
pub def abb(): Re := RSeq(RStar(RAlt(RChr(97), RChr(98))), RSeq(RChr(97), RSeq(RChr(98), RChr(98))))

pub theorem aabb_matches(): re_match_text("aabb", abb()) = true {
  Refl
}

pub theorem abab_does_not(): re_match_text("abab", abb()) = false {
  Refl
}

// The matcher's true is a proof that the word is in the language (for all inputs it is `re_match_sound`).
pub theorem babb_is_in_the_language(): Matches(abb(), Cons(98, Cons(97, Cons(98, Cons(98, Nil))))) {
  re_match_sound(Cons(98, Cons(97, Cons(98, Cons(98, Nil)))), abb(), Refl)
}

pub theorem nothing_matches_the_empty_expression(w: List(Nat), h: Matches(REmpty, w)): False {
  no_match(w, h)
}
