// Matches a few words against (a|b)*abb.

fn show_match(w: Text, r: Re) -> () {
  os_print(w)
  match re_match_text(w, r) {
    true => os_print(" matches\n")
    false => os_print(" does not match\n")
  }
}

let ab = r_alt(r_chr(97), r_chr(98))
let abb = r_seq(r_star(ab), r_seq(r_chr(97), r_seq(r_chr(98), r_chr(98))))
show_match("abb", abb)
show_match("aabb", abb)
show_match("babb", abb)
show_match("abab", abb)
show_match("", abb)
