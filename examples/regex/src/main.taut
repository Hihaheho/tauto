import "regex.taut"
import std::builtin::os

pub fn show_match(w: Text, r: Re): Unit ! {stdout} {
  print(w)
  match re_match_text(w, r) {
    true => print(" matches\n")
    false => print(" does not match\n")
  }
}

perform main(() => {
  let ab := RAlt(RChr(97), RChr(98))
  let abb := RSeq(RStar(ab), RSeq(RChr(97), RSeq(RChr(98), RChr(98))))
  show_match("abb", abb)
  show_match("aabb", abb)
  show_match("babb", abb)
  show_match("abab", abb)
  show_match("", abb)
})
