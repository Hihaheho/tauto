import "../../../std/Base.taut"
import "../../../std/Text.taut"

// A regular-expression matcher by Brzozowski derivatives: to match `c` followed by `w`, match
// `w` against the derivative of the expression by `c`. `proof/regex.taut` proves that it
// decides the language the expression denotes.

pub(open) inductive Re: Type {
  REmpty: Re
  REps: Re
  RChr(c: Nat): Re
  RAlt(a: Re, b: Re): Re
  RSeq(a: Re, b: Re): Re
  RStar(a: Re): Re
}

pub fn re_nullable(r: Re): Bool {
  match r: Bool {
    REmpty => false
    REps => true
    RChr(c) => false
    RAlt(a, b) => Bool::or(re_nullable(a), re_nullable(b))
    RSeq(a, b) => Bool::and(re_nullable(a), re_nullable(b))
    RStar(a) => true
  }
}

// `r` when `a` matches the empty string, else nothing: what is left when a first part that can be empty is skipped.
pub fn re_if_nullable(a: Re, r: Re): Re {
  match re_nullable(a): Re {
    false => REmpty
    true => r
  }
}

pub fn re_deriv(c: Nat, r: Re): Re {
  match r: Re {
    REmpty => REmpty
    REps => REmpty
    RChr(d) => match Nat::eq(c, d): Re {
      false => REmpty
      true => REps
    }
    RAlt(a, b) => RAlt(re_deriv(c, a), re_deriv(c, b))
    RSeq(a, b) => RAlt(RSeq(re_deriv(c, a), b), re_if_nullable(a, re_deriv(c, b)))
    RStar(a) => RSeq(re_deriv(c, a), RStar(a))
  }
}

pub fn re_match(w: List(Nat), r: Re): Bool {
  match w: Bool {
    Nil => re_nullable(r)
    Cons(c, rest) => re_match(rest, re_deriv(c, r))
  }
}

pub fn re_match_text(t: Text, r: Re): Bool {
  re_match(Text::bytes(t), r)
}
