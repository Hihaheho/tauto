extern {
  type(affine) Token
  fn mint(): Token
  fn read(t: Token): i64
}

extern {
  pub struct(affine) Cell {
    token: Token,
  }

  pub fn Cell::new(): Cell {
    Cell { token: mint() }
  }

  pub fn Cell::read(c: Cell): i64 {
    read(c.token)
  }
}

perform main(() => {
  show(&Cell::read(Cell::new()))
})
