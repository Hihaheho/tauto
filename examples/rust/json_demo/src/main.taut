import std::builtin::os { stdout, stdout_flush }
import "../bind/serde_json.taut"

pub fn main() ! {stdout, stdout_flush} {
  match serde_json::from_str(&"[1, 2, 3]") {
    Ok(v) => {
      show(&Value::is_object(&v))
      show(&Value::is_array(&v))
      show(&Value::to_text(&v))
    }
    Err(e) => show(&JsonError::to_text(&e))
  }
  match serde_json::from_str(&"{") {
    Ok(v) => show(&Value::is_null(&v))
    Err(e) => show(&JsonError::is_eof(&e))
  }
}
perform main(() => {
  main()
})
