import std::builtin::os { stdout, stdout_flush }
import "../bind/regex.taut"

pub fn main() ! {div, stdout, stdout_flush} {
  match Regex::new(&"a+b") {
    Ok(re) => {
      show(&Regex::is_match(&re, &"xaaab"))
      show(&Regex::is_match(&re, &"xyz"))
      show(&Regex::to_text(&re))
      match Regex::find(&re, &"xaaab") {
        Some(m) => {
          show(&Match::as_str(&m))
          show(&Match::start(&m))
        }
        None => show(&"none")
      }
      match Regex::captures(&re, &"xaaab") {
        Some(c) => show(&Captures::len(&c))
        None => show(&0)
      }
      show(&Regex::shortest_match(&re, &"xaaab"))
      show(&Regex::shortest_match_at(&re, &"xaaab", 3))
      let words := "ab aab b aaab"
      var more_found := true
      var found := Regex::find_iter(&re, &words)
      while more_found {
        match Matches::next(&mut found) {
          Some(m) => show(&Match::as_str(&m))
          None => { more_found := false }
        }
      }
      let pair := "ab aab"
      var more_groups := true
      var groups := Regex::captures_iter(&re, &pair)
      while more_groups {
        match CaptureMatches::next(&mut groups) {
          Some(c) => show(&Captures::len(&c))
          None => { more_groups := false }
        }
      }
      let digits := "1ab2aab3"
      var more_parts := true
      var parts := Regex::split(&re, &digits)
      while more_parts {
        match Split::next(&mut parts) {
          Some(p) => show(&p)
          None => { more_parts := false }
        }
      }
      var more_two := true
      var two := Regex::splitn(&re, &digits, 2)
      while more_two {
        match SplitN::next(&mut two) {
          Some(p) => show(&p)
          None => { more_two := false }
        }
      }
      show(&Regex::replace(&re, &"ab aab", &"<>"))
      show(&Regex::replace_all(&re, &"ab aab", &"<>"))
      show(&Regex::replacen(&re, &"ab aab aaab", 2, &"<>"))
    }
    Err(e) => show(&RegexError::to_text(&e))
  }
}
perform main(() => {
  main()
})
