package {
  name = "main-thread"
  version = "0.1.0"
}

// `main` runs on the process's main thread, where host APIs such as macOS's
// AppKit must be called, instead of on a big-stack thread of its own.
rust {
  main-thread = true
  extern {
    on_main_thread = "tauto_rt::main_thread::is_main"
  }
}
