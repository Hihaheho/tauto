import std::builtin::par

// Tasks on threads share a host counter, an `Atomic` and a `Mutex`. The
// program starts tasks, so the Rust backend builds it for threads: every
// extern type must be `Send + Sync` (here `Counter` is).
pub(open) struct(shared) Counter {}

extern {
  fn counter_new(): Counter
  fn counter_add(c: Counter, n: u64): Unit
  fn counter_get(c: Counter): u64
}

pub fn work(c: Counter, hits: Atomic, n: u64): u64 ! {div, overflow, atomic_fetch_add} {
  var i: u64 := 0
  while i < n {
    counter_add(c, 2)
    let before := perform atomic_fetch_add(hits, 1)
    i := i + 1
  }
  n
}

perform main(() => {
  let c := counter_new()
  let hits := perform atomic_new(0)
  let log := perform mutex_new(Vec::new())
  let done := {
    let a := perform spawn(() => work(c, hits, 500))
    let b := perform spawn(() => work(c, hits, 1500))
    let d := perform spawn(() => {
      {
        var g := Mutex::lock(log)
        let v := MutexGuard::get_mut(&mut g)
        Vec::push(&mut v, 7)
      }
      1
    })
    // Every task is joined before the sum, which may overflow and not resume.
    let joined_a := Task::join(a)
    let joined_b := Task::join(b)
    let joined_d := Task::join(d)
    joined_a + joined_b + joined_d
  }
  show(&done)
  show(&counter_get(c))
  show(&perform atomic_load(hits))
  let logged := {
    let g := Mutex::lock(log)
    let v := MutexGuard::get(&g)
    Vec::len(&v)
  }
  show(&logged)
})
