import "../../../std/Nat.taut"
import "../../../std/State.taut"
import "../src/state.taut"

// An increasing transition cannot claim the balance-capacity invariant.
pub fn increasing(state: GateState, command: GateCommand): GateState {
  GateOpen(Succ(gate_balance(state)))
}
pub fn forged(commands: List(GateCommand), capacity: Nat): GateState {
  state_certified_run(
    increasing,
    (state: GateState) => GateInvariant(capacity, state),
    (state: GateState, command: GateCommand, valid: GateInvariant(capacity, state)) => valid,
    commands,
    GateClosed(capacity),
    Nat::le_refl(capacity)
  )
}
