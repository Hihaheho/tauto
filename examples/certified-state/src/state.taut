import "../../../std/State.taut"
import "../../../std/Nat.taut"
import "../../../std/Base.taut"

pub(open) inductive GateState: Type {
  GateClosed(balance: Nat): GateState
  GateOpen(balance: Nat): GateState
}
pub(open) inductive GateCommand: Type {
  GateAuthorize: GateCommand
  GateRevoke: GateCommand
  GateSpend: GateCommand
}
pub fn gate_balance(state: GateState): Nat {
  match state: Nat {
    GateClosed(n) => n
    GateOpen(n) => n
  }
}
pub fn gate_allowed(state: GateState): Bool {
  match state: Bool {
    GateClosed(n) => false
    GateOpen(n) => true
  }
}
pub fn gate_step(state: GateState, command: GateCommand): GateState {
  match command: GateState {
    GateAuthorize => GateOpen(gate_balance(state))
    GateRevoke => GateClosed(gate_balance(state))
    GateSpend => match state: GateState {
      GateClosed(n) => GateClosed(n)
      GateOpen(n) => GateOpen(Nat::pred(n))
    }
  }
}
pub def GateInvariant(capacity: Nat, state: GateState): Prop :=
Nat::le(gate_balance(state), capacity) = true

pub theorem gate_pred_bound(n: Nat): (Nat::le(Nat::pred(n), n) = true) {
  match n: (Nat::le(Nat::pred(n), n) = true) {
    Zero => Refl
    Succ(k) => Nat::le_succ(k)
  }
}
pub theorem gate_step_nonincreasing(
  state: GateState,
  command: GateCommand
): (Nat::le(gate_balance(gate_step(state, command)), gate_balance(state)) = true) {
  match command: (Nat::le(gate_balance(gate_step(state, command)), gate_balance(state)) = true) {
    GateAuthorize => Nat::le_refl(gate_balance(state))
    GateRevoke => Nat::le_refl(gate_balance(state))
    GateSpend => match state {
      GateClosed(n) => Nat::le_refl(n)
      GateOpen(n) => gate_pred_bound(n)
    }
  }
}
pub theorem gate_step_preserves(
  capacity: Nat,
  state: GateState,
  command: GateCommand,
  valid: GateInvariant(capacity, state)
): GateInvariant(capacity, gate_step(state, command)) {
  Nat::le_trans(
    gate_balance(gate_step(state, command)),
    gate_balance(state),
    capacity,
    gate_step_nonincreasing(state, command),
    valid
  )
}
pub theorem gate_authorize_opens(
  state: GateState
): (gate_allowed(gate_step(state, GateAuthorize)) = true) {
  Refl
}
pub theorem gate_revoke_closes(
  state: GateState
): (gate_allowed(gate_step(state, GateRevoke)) = false) {
  Refl
}
pub theorem gate_spend_denied(
  n: Nat
): gate_step(GateClosed(n), GateSpend) = GateClosed(n) {
  Refl
}
pub theorem gate_spend_authorized(
  n: Nat
): gate_step(GateOpen(n), GateSpend) = GateOpen(Nat::pred(n)) {
  Refl
}
pub theorem gate_hoare(
  capacity: Nat
): StateHoare(
  GateState,
  GateCommand,
  gate_step,
  (state: GateState, command: GateCommand) => GateInvariant(capacity, state),
  (before: GateState, command: GateCommand, after: GateState) => GateInvariant(capacity, after)
) {
  (state: GateState, command: GateCommand, valid: GateInvariant(capacity, state)) =>
  gate_step_preserves(capacity, state, command, valid)
}
pub fn gate_run(commands: List(GateCommand), capacity: Nat): GateState {
  state_certified_run(
    gate_step,
    (state: GateState) => GateInvariant(capacity, state),
    (
      state: GateState,
      command: GateCommand,
      valid: GateInvariant(capacity, state)
    ) => gate_step_preserves(capacity, state, command, valid),
    commands,
    GateClosed(capacity),
    Nat::le_refl(capacity)
  )
}
pub theorem gate_run_safe(
  commands: List(GateCommand),
  capacity: Nat
): GateInvariant(capacity, gate_run(commands, capacity)) {
  state_certified_run_preserves(
    gate_step,
    (state: GateState) => GateInvariant(capacity, state),
    (
      state: GateState,
      command: GateCommand,
      valid: GateInvariant(capacity, state)
    ) => gate_step_preserves(capacity, state, command, valid),
    commands,
    GateClosed(capacity),
    Nat::le_refl(capacity)
  )
}

pub fn gate_advance(commands: List(GateCommand), state: GateState): GateState {
  state_run(gate_step, commands, state)
}
pub theorem gate_advance_safe(
  capacity: Nat,
  commands: List(GateCommand),
  state: GateState,
  valid: GateInvariant(capacity, state)
): GateInvariant(capacity, gate_advance(commands, state)) {
  state_run_preserves(
    gate_step,
    (current: GateState) => GateInvariant(capacity, current),
    (
      current: GateState,
      command: GateCommand,
      h: GateInvariant(capacity, current)
    ) => gate_step_preserves(capacity, current, command, h),
    commands,
    state,
    valid
  )
}
