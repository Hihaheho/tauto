pub theorem OccLaws::take_same<S, M, u: (S, UHost, M) -> Bool, em: (UHost) -> S, vac: M, cp: (S) -> UHost, pu: (S, UHost, M, M) -> Option(S), ta: (S, UHost, M, M) -> Option(S), rc: (S, UHost) -> Option(S), fu: (S, UHost, UHost) -> Bool>(L: OccLaws(S, M, u, em, vac, cp, pu, ta, rc, fu), s: S, i: UHost, old: M, new: M, t: S, h: ta(s, i, old, new) = Some(t)): u(t, i, new) = false {
