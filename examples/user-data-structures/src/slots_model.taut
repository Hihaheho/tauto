  match L {
    Mk(q0, qe, q1, q2, q3, qc, q4, q5, q6, qd, q7, q8, qe2, p) => p(s, a, b, i, m, h, lo, hi)
  }
}

// The class's methods as values, for the indices above.
pub fn used_of<S, M>(s: S, i: UHost, m: M): Bool where Occupancy(S, M) {
  Occupancy::used(s, i, m)
}

pub fn put_of_c<S, M>(s: S, i: UHost, old: M, new: M): Option(S) where Occupancy(S, M) {
  Occupancy::put(s, i, old, new)
}

pub fn take_of_c<S, M>(s: S, i: UHost, old: M, new: M): Option(S) where Occupancy(S, M) {
  Occupancy::take(s, i, old, new)
}

// The laws of the class, as one value.
pub theorem occ_laws<S, M>(pm: Proxy(M), ps: Proxy(S)): OccLaws(S, M, used_of, c => Occupancy::empty(c, pm), Occupancy::vacant(ps, pm), s => Occupancy::cap(s, pm), put_of_c, take_of_c, (s, c) => Occupancy::recap(s, c, pm), (s, a, b) => Occupancy::full(s, a, b, pm)) where Occupancy(S, M) {
  OccLaws::Mk(
    c => i => Occupancy::empty_free(<S: S, M: M, c: c, i: i, pm: pm, ps: ps>),
    c => Occupancy::empty_cap(<S: S, M: M, c: c, pm: pm, ps: ps>),
    s => i => m => h => Occupancy::used_below(<S: S, M: M, s: s, i: i, m: m, pm: pm, ps: ps>, h),
    s => i => old => new => t => h => Occupancy::put_same(<S: S, M: M, s: s, i: i, old: old, new: new, t: t, pm: pm, ps: ps>, h),
    s => i => old => new => t => j => m => h => ne => Occupancy::put_other(<S: S, M: M, s: s, i: i, old: old, new: new, t: t, j: j, m: m, pm: pm, ps: ps>, h, ne),
    s => i => old => new => t => h => Occupancy::put_cap(<S: S, M: M, s: s, i: i, old: old, new: new, t: t, pm: pm, ps: ps>, h),
    s => i => old => new => t => h => Occupancy::take_live(<S: S, M: M, s: s, i: i, old: old, new: new, t: t, pm: pm, ps: ps>, h),
    s => i => old => new => t => h => Occupancy::take_same(<S: S, M: M, s: s, i: i, old: old, new: new, t: t, pm: pm, ps: ps>, h),
    s => i => old => new => t => j => m => h => ne => Occupancy::take_other(<S: S, M: M, s: s, i: i, old: old, new: new, t: t, j: j, m: m, pm: pm, ps: ps>, h, ne),
    s => i => old => new => t => h => Occupancy::take_cap(<S: S, M: M, s: s, i: i, old: old, new: new, t: t, pm: pm, ps: ps>, h),
    s => c => t => i => m => h => o => Occupancy::recap_keeps(<S: S, M: M, s: s, c: c, t: t, i: i, m: m, pm: pm, ps: ps>, h, o),
    s => c => t => i => h => n => Occupancy::recap_fresh(<S: S, M: M, s: s, c: c, t: t, i: i, pm: pm, ps: ps>, h, n),
    s => c => t => h => Occupancy::recap_cap(<S: S, M: M, s: s, c: c, t: t, pm: pm, ps: ps>, h),
    s => a => b => i => m => h => lo => hi => Occupancy::full_used(<S: S, M: M, s: s, a: a, b: b, i: i, m: m, pm: pm, ps: ps>, h, lo, hi)
  )
}
