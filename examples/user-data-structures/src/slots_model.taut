  }
}

pub theorem OccLaws::recap_keeps<S, M, u: (S, UHost, M) -> Bool, em: (UHost) -> S, vac: M, cp: (S) -> UHost, pu: (S, UHost, M, M) -> Option(S), ta: (S, UHost, M, M) -> Option(S), rc: (S, UHost) -> Option(S), fu: (S, UHost, UHost) -> Bool>(L: OccLaws(S, M, u, em, vac, cp, pu, ta, rc, fu), s: S, c: UHost, t: S, i: UHost, m: M, h: rc(s, c) = Some(t), o: UHost::lt(i, cp(s)) = true): u(t, i, m) = u(s, i, m) {
  match L {
    Mk(q0, qe, q1, q2, q3, qc, q4, q5, q6, qd, p, q8, qe2, q9) => p(s, c, t, i, m, h, o)
  }
}

pub theorem OccLaws::recap_fresh<S, M, u: (S, UHost, M) -> Bool, em: (UHost) -> S, vac: M, cp: (S) -> UHost, pu: (S, UHost, M, M) -> Option(S), ta: (S, UHost, M, M) -> Option(S), rc: (S, UHost) -> Option(S), fu: (S, UHost, UHost) -> Bool>(L: OccLaws(S, M, u, em, vac, cp, pu, ta, rc, fu), s: S, c: UHost, t: S, i: UHost, h: rc(s, c) = Some(t), n: UHost::le(cp(s), i) = true): u(t, i, vac) = false {
  match L {
