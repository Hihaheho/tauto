pub theorem OccLaws::take_other<S, M, u: (S, UHost, M) -> Bool, em: (UHost) -> S, vac: M, cp: (S) -> UHost, pu: (S, UHost, M, M) -> Option(S), ta: (S, UHost, M, M) -> Option(S), rc: (S, UHost) -> Option(S), fu: (S, UHost, UHost) -> Bool>(L: OccLaws(S, M, u, em, vac, cp, pu, ta, rc, fu), s: S, i: UHost, old: M, new: M, t: S, j: UHost, m: M, h: ta(s, i, old, new) = Some(t), ne: UHost::eq(i, j) = false): u(t, j, m) = u(s, j, m) {
  match L {
    Mk(q0, qe, q1, q2, q3, qc, q4, q5, p, qd, q7, q8, qe2, q9) => p(s, i, old, new, t, j, m, h, ne)
  }
}

pub theorem OccLaws::take_cap<S, M, u: (S, UHost, M) -> Bool, em: (UHost) -> S, vac: M, cp: (S) -> UHost, pu: (S, UHost, M, M) -> Option(S), ta: (S, UHost, M, M) -> Option(S), rc: (S, UHost) -> Option(S), fu: (S, UHost, UHost) -> Bool>(L: OccLaws(S, M, u, em, vac, cp, pu, ta, rc, fu), s: S, i: UHost, old: M, new: M, t: S, h: ta(s, i, old, new) = Some(t)): cp(t) = cp(s) {
  match L {
