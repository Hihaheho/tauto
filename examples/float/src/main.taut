import "geometry.taut"
import std::float

// What `geometry.taut` computes at run time.
perform main(() => {
  show(&hypot(3.0, 4.0))
  show(&hypot(3e-200, 4e-200))
  show(&(0.1 + 0.2 == 0.3))
  show(&mean(0.0, 0.0))
  show(&mean(3.0, 2.0))
  show(&units(-2.5))
  show(&units(Float::sqrt(-1.0)))
  show(&units(1e19))
  show(&Float::bits(Float::sqrt(-1.0)))
  show(&Float::bits(-Float::sqrt(-1.0)))
  show(&growth(0.05, 10.0))
})
