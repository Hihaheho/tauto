import "geometry.taut"
import std::Float

// What `geometry.taut` computes at run time.
perform show("hypot", hypot(3.0, 4.0))
perform show("hypot_tiny", hypot(3e-200, 4e-200))
perform show("tenths", 0.1 + 0.2 == 0.3)
perform show("mean_none", mean(0.0, 0.0))
perform show("mean", mean(3.0, 2.0))
perform show("units", units(-2.5))
perform show("units_nan", units(Float::sqrt(-1.0)))
perform show("units_large", units(1e19))
perform show("nan_bits", Float::bits(Float::sqrt(-1.0)))
perform show("neg_nan_bits", Float::bits(-Float::sqrt(-1.0)))
perform show("growth", growth(0.05, 10.0))
