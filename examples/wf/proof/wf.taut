import "../../../std/Base.taut"
import "../src/wf.taut"

// What the functions do, from their unfolding equations (`half::eq`, `pair_up::eq`, `count_up::eq`).
// `half(n)` does not compute on its own: the proof that `<` on the measure is well-founded is a
// theorem, so the kernel cannot run the recursion. The equation unfolds it once, and `match` on a
// constructor computes the rest. No program imports this file; `tauto check`
// checks it.

pub theorem half_zero(): half(Zero) = Zero {
  half::eq(Zero)
}

pub theorem half_one(): half(Succ(Zero)) = Zero {
  half::eq(Succ(Zero))
}

pub theorem half_step(k: Nat): half(Succ(Succ(k))) = Succ(half(k)) {
  half::eq(Succ(Succ(k)))
}

pub theorem pair_up_nil(): pair_up(Nil) = Nil {
  pair_up::eq(Nil)
}

pub theorem pair_up_single(x: Nat): pair_up(Cons(x, Nil)) = Cons(x, Nil) {
  pair_up::eq(Cons(x, Nil))
}

pub theorem pair_up_pair(
  x: Nat,
  y: Nat,
  t: List(Nat)
): pair_up(Cons(x, Cons(y, t))) = Cons(Nat::add(x, y), pair_up(t)) {
  pair_up::eq(Cons(x, Cons(y, t)))
}

pub theorem count_up_zero(acc: Nat): count_up(Zero, acc) = acc {
  count_up::eq(Zero, acc)
}

pub theorem count_up_succ(
  m: Nat,
  acc: Nat
): count_up(Succ(m), acc) = count_up(m, Succ(acc)) {
  count_up::eq(Succ(m), acc)
}
