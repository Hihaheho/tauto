// Runs the functions of wf.taut.

fn show_list(l: List(u64)) -> () {
  match l {
    Nil => os_print("\n")
    Cons(h, t) => {
      os_print(text_of_u64(h))
      os_print(" ")
      show_list(t)
    }
  }
}

os_print(text_of_u64(half(9)))
os_print("\n")
show_list(pair_up(Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Nil)))))))
os_print(text_of_u64(count_up(3, 10)))
os_print("\n")
