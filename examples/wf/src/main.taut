import "wf.taut"
import std::prelude::Os

pub fn show_list(l: List(nat)): Unit {
  match l {
    Nil => print("\n")
    Cons(h, t) => {
      print(Text::of_nat(h))
      print(" ")
      show_list(t)
    }
  }
}

print(Text::of_nat(half(9)))
print("\n")
show_list(pair_up(Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Nil)))))))
print(Text::of_nat(count_up(3, 10)))
print("\n")
