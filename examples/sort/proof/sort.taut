import "../src/sort.taut"
import std::prelude::Ord

// What the sort does, proved for any type with an order: `sort(l)` is in order (`sort_sorted`) and
// is a rearrangement of `l` (`sort_perm`). The proofs use the laws of `Ord` and nothing about the
// elements. No program imports this file; `tauto check` checks it.

pub fn le<A>(
  a: A,
  b: A
): Prop where Ord(A) { (∀ h: Ord::compare(a, b) = Greater. False) }

pub fn sorted<A>(l: List(A)): Prop where Ord(A) {
  match l: Prop {
    Nil => True
    Cons(x, t) => match t: Prop {
      Nil => True
      Cons(y, u) => And(le(x, y), sorted(t))
    }
  }
}

pub(open) inductive Perm(A: Type): (List(A)) -> (List(A)) -> Prop {
  PermNil: Perm(A, Nil, Nil)
  PermSkip<x: A, l: List(A), m: List(A)>(h: Perm(A, l, m)): Perm(A, Cons(x, l), Cons(x, m))
  PermSwap<x: A, y: A, l: List(A)>: Perm(A, Cons(x, Cons(y, l)), Cons(y, Cons(x, l)))
  PermTrans<l: List(A), m: List(A), n: List(A)>(a: Perm(A, l, m), b: Perm(A, m, n)): Perm(A, l, n)
}

pub theorem perm_refl<A>(l: List(A)): Perm(A, l, l) {
  match l: Perm(A, l, l) {
    Nil => PermNil
    Cons(x, t) => PermSkip(perm_refl(t))
  }
}

// The answer of `Ord::compare` as `le`: in each case the order is one of the laws.
pub theorem le_of_less<A>(
  a: A,
  b: A,
  e: Ord::compare(a, b) = Less
): le(a, b) where Ord(A) {
  (h: Ord::compare(a, b) = Greater) => less_ne_greater(Eq::trans(Eq::sym(e), h))
}

pub theorem le_of_equal<A>(
  a: A,
  b: A,
  e: Ord::compare(a, b) = Equal
): le(a, b) where Ord(A) {
  (h: Ord::compare(a, b) = Greater) => equal_ne_greater(Eq::trans(Eq::sym(e), h))
}

pub theorem le_of_greater<A>(
  a: A,
  b: A,
  e: Ord::compare(a, b) = Greater
): le(b, a) where Ord(A) {
  (h: Ord::compare(b, a) = Greater) => greater_ne_less(
    Eq::trans(Eq::sym(h), ord_swap_greater(a, b, e))
  )
}

pub theorem insert_perm<A>(x: A, l: List(A)): Perm(A, Cons(x, l), insert(x, l)) where Ord(A) {
  match l: Perm(A, Cons(x, l), insert(x, l)) {
    Nil => perm_refl(Cons(x, Nil))
    Cons(y, t) => match Ord::compare(x, y): Perm(A, Cons(x, Cons(y, t)), insert(x, Cons(y, t))) {
      Less => ⊢ Perm(A, Cons(x, Cons(y, t)), Cons(x, Cons(y, t))) from perm_refl(Cons(x, Cons(y, t)))
      Equal => ⊢ Perm(A, Cons(x, Cons(y, t)), Cons(x, Cons(y, t))) from perm_refl(Cons(x, Cons(y, t)))
      Greater => ⊢ Perm(A, Cons(x, Cons(y, t)), Cons(y, insert(x, t))) from PermTrans(
        PermSwap,
        PermSkip(insert_perm(x, t))
      )
    }
  }
}

pub theorem sort_perm<A>(l: List(A)): Perm(A, l, sort(l)) where Ord(A) {
  match l: Perm(A, l, sort(l)) {
    Nil => PermNil
    Cons(x, t) => PermTrans(PermSkip(sort_perm(t)), insert_perm(x, sort(t)))
  }
}

pub theorem insert_after<A>(
  l: List(A),
  y: A,
  x: A,
  hyx: le(y, x),
  h: sorted(Cons(y, l))
): sorted(Cons(y, insert(x, l))) where Ord(A) {
  match l: sorted(Cons(y, insert(x, l))) {
    Nil => AndIntro(hyx, Trivial)
    Cons(z, t) => match Ord::compare(x, z) eqn e: sorted(Cons(y, insert(x, Cons(z, t)))) {
      Less => AndIntro(hyx, AndIntro(le_of_less(x, z, e), And::right(h)))
      Equal => AndIntro(hyx, AndIntro(le_of_equal(x, z, e), And::right(h)))
      Greater => AndIntro(And::left(h), insert_after(t, z, x, le_of_greater(x, z, e), And::right(h)))
    }
  }
}

pub theorem insert_sorted<A>(x: A, l: List(A), h: sorted(l)): sorted(insert(x, l)) where Ord(A) {
  match l: sorted(insert(x, l)) {
    Nil => Trivial
    Cons(y, t) => match Ord::compare(x, y) eqn e: sorted(insert(x, Cons(y, t))) {
      Less => AndIntro(le_of_less(x, y, e), h)
      Equal => AndIntro(le_of_equal(x, y, e), h)
      Greater => insert_after(t, y, x, le_of_greater(x, y, e), h)
    }
  }
}

pub theorem sort_sorted<A>(l: List(A)): sorted(sort(l)) where Ord(A) {
  match l: sorted(sort(l)) {
    Nil => Trivial
    Cons(x, t) => {
      let h: sorted(sort(t)) := sort_sorted(t)
      insert_sorted(x, sort(t), h)
    }
  }
}

pub theorem sort_correct<A>(l: List(A)): sorted(sort(l)) ∧ Perm(A, l, sort(l)) where Ord(A) {
  AndIntro(sort_sorted(l), sort_perm(l))
}
