// Sorts a list and prints it before and after.

fn show_list(l: List(u64)) -> () {
  match l {
    Nil => os_print("\n")
    Cons(h, t) => {
      os_print(text_of_u64(h))
      os_print(" ")
      show_list(t)
    }
  }
}

let input = Cons(5, Cons(2, Cons(9, Cons(2, Cons(0, Cons(7, Nil))))))
show_list(input)
show_list(sort(input))

// The same `sort`, on words: `Ord(Text)` compares their bytes.
fn show_words(l: List(Text)) -> () {
  match l {
    Nil => os_print("\n")
    Cons(h, t) => {
      os_print(h)
      os_print(" ")
      show_words(t)
    }
  }
}

let words = Cons("pear", Cons("apple", Cons("fig", Cons("banana", Nil))))
show_words(sort(words))
