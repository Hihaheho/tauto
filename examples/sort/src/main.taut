import "sort.taut"
import std::prelude::Os

pub fn show_list(l: List(u64)): Unit {
  match l {
    Nil => print("\n")
    Cons(h, t) => {
      print(Text::of_u64(h))
      print(" ")
      show_list(t)
    }
  }
}

let input := Cons(5, Cons(2, Cons(9, Cons(2, Cons(0, Cons(7, Nil))))))
show_list(input)
show_list(sort(input))

// The same `sort`, on words: `Ord(Text)` compares their bytes.
pub fn show_words(l: List(Text)): Unit {
  match l {
    Nil => print("\n")
    Cons(h, t) => {
      print(h)
      print(" ")
      show_words(t)
    }
  }
}

let words := Cons("pear", Cons("apple", Cons("fig", Cons("banana", Nil))))
show_words(sort(words))
