import "../../../std/Base.taut"
import std::prelude::Ord

// Insertion sort on any type with an order (`Ord(A)`, `std/prelude/Ord.taut`). `proof/sort.taut` proves
// that `sort(l)` is in order and is a rearrangement of `l`, from the laws of `Ord` alone.

// `x` goes before the first element it is not after (`Less` or `Equal`), so equal elements keep their order.
pub fn insert<A>(x: A, l: List(A)): List(A) where Ord(A) {
  ⊢ List(A) from match l {
    Nil => Cons(x, Nil)
    Cons(y, t) => ⊢ List(A) from match Ord::compare(x, y) {
      Less => Cons(x, Cons(y, t))
      Equal => Cons(x, Cons(y, t))
      Greater => Cons(y, insert(x, t))
    }
  }
}

pub fn sort<A>(l: List(A)): List(A) where Ord(A) {
  ⊢ List(A) from match l {
    Nil => Nil
    Cons(x, t) => insert(x, sort(t))
  }
}
