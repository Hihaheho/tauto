import "batch.taut"

// The driver calls the checked functions, not a second batching algorithm.
let pending: List(Nat) := Cons(7, Cons(7, Cons(9, Nil)))
perform show("first", batch_items(2, pending))
let remaining := batch_remaining(2, pending)
perform show("remaining", remaining)
perform show("last", batch_items(2, remaining))
perform show("drained", batch_remaining(2, remaining))
perform show("paused", batch_items(0, pending))
perform show("paused remaining", batch_remaining(0, pending))
perform show("oversized", batch_items(9, pending))
perform show("oversized remaining", batch_remaining(9, pending))
let empty: List(Nat) := Nil
perform show("empty", batch_items(2, empty))
perform show("empty remaining", batch_remaining(2, empty))
