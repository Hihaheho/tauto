import "batch.taut"

// The driver calls the checked functions, not a second batching algorithm.
perform main(() => {
  let pending: List(Nat) := Cons(7, Cons(7, Cons(9, Nil)))
  show(&batch_items(2, pending))
  let remaining := batch_remaining(2, pending)
  show(&remaining)
  show(&batch_items(2, remaining))
  show(&batch_remaining(2, remaining))
  show(&batch_items(0, pending))
  show(&batch_remaining(0, pending))
  show(&batch_items(9, pending))
  show(&batch_remaining(9, pending))
  let empty: List(Nat) := Nil
  show(&batch_items(2, empty))
  show(&batch_remaining(2, empty))
})
