import "dot.taut"
import std::float32

// What `dot.taut` computes at run time.
perform main(() => {
  show(&dot2(f32(1.5), f32(2.0), f32(0.5), f32(4.0)))
  show(&(f32(0.1) + f32(0.2) == f32(0.3)))
  show(&f32(0.1))
  show(&Float32::bits(f32(0.1)))
  show(&ratio(f32(1.0), f32(0.0)))
  show(&ratio(f32(1.0), f32(3.0)))
  show(&(f32(3e38) * f32(10.0)))
  show(&Float32::bits(Float32::sqrt(f32(-1.0))))
  show(&Float32::exp(f32(1.0)))
})
