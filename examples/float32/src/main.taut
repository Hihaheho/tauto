import "dot.taut"
import std::Float32

// What `dot.taut` computes at run time.
perform show("dot2", dot2(f32(1.5), f32(2.0), f32(0.5), f32(4.0)))
perform show("tenths", f32(0.1) + f32(0.2) == f32(0.3))
perform show("tenth", f32(0.1))
perform show("tenth_bits", Float32::bits(f32(0.1)))
perform show("ratio_none", ratio(f32(1.0), f32(0.0)))
perform show("ratio", ratio(f32(1.0), f32(3.0)))
perform show("overflow", f32(3e38) * f32(10.0))
perform show("nan_bits", Float32::bits(Float32::sqrt(f32(-1.0))))
perform show("exp", Float32::exp(f32(1.0)))
