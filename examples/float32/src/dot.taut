import std::Float
import std::Float32

// `Float32` code the kernel checks: the proofs compute with
// `std/Float32.taut`'s definitions, and the program runs on Nib's `Float32`.
pub fn f32(x: Float): Float32 {
  Float32::of_float(x)
}

// `a * b + c * d`, each step rounded to a `Float32`.
pub fn dot2(a: Float32, b: Float32, c: Float32, d: Float32): Float32 {
  Float32::add(Float32::mul(a, b), Float32::mul(c, d))
}

pub theorem dot2_small(): dot2(f32(1.5), f32(2.0), f32(0.5), f32(4.0)) = f32(5.0) {
  Refl
}

// `0.1 + 0.2` in `Float32` is the `Float32` nearest to `0.3`, which it is
// not in `Float`.
pub theorem tenths(): Float32::eq(Float32::add(f32(0.1), f32(0.2)), f32(0.3)) = true {
  Refl
}

// A `Float32` is the same number as a `Float`: `0.1` is not.
pub theorem widen_tenth(): Float::eq(Float::of_float32(f32(0.1)), 0.1) = false {
  Refl
}

// A ratio that is `None` rather than dividing by zero.
pub fn ratio(a: Float32, b: Float32): Option(Float32) {
  Float32::checked_div(a, b)
}

pub theorem ratio_of_zero(): ratio(f32(1.0), f32(0.0)) = None {
  Refl
}
