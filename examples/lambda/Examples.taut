import "Lib.taut"
import "SN.taut"

pub theorem id_typed(): lc!(`|- fun x: unit. x : unit -> unit`) {
  TLam(TVar(HasHere))
}

pub theorem const_typed(): lc!(`|- fun x: unit. fun y: unit. x : unit -> unit -> unit`) {
  TLam(TLam(TVar(HasThere(HasHere))))
}

pub theorem two_typed(): lc!(
  `|- fun f: unit -> unit. fun x: unit. f (f x) : (unit -> unit) -> unit -> unit`
) {
  TLam(TLam(TApp(TVar(HasThere(HasHere)), TApp(TVar(HasThere(HasHere)), TVar(HasHere)))))
}

pub theorem application_typed(): lc!(`f: unit -> unit, x: unit |- f x : unit`) {
  TApp(TVar(HasThere(HasHere)), TVar(HasHere))
}

// Steps written by hand, chained by the untyped macro `steps!`.
pub theorem two_id_star(): lc!(
  `(fun f: unit -> unit. fun x: unit. f (f x)) (fun y: unit. y) star ~>* star`
) {
  steps!(then(SAppL(SBeta), SBeta, SBeta, SBeta))
}

// The same kind of claim, with the path found by `reduce!`; the kernel still checks every step.
pub theorem k_star(): lc!(`(fun x: unit. fun y: unit. x) star ~>* fun y: unit. star`) {
  reduce!(`(fun x: unit. fun y: unit. x) star`)
}

// The same, as a step: the tactic reads the term from the goal the step starts from.
pub theorem k_star_goal(): lc!(`(fun x: unit. fun y: unit. x) star ~>* fun y: unit. star`) {
  by reduce_goal!(): lc!(`(fun x: unit. fun y: unit. x) star ~>* fun y: unit. star`) {}
}

pub theorem two_plus_two(): lc!(
  `(fun m: (unit -> unit) -> unit -> unit. fun n: (unit -> unit) -> unit -> unit. fun f: unit -> unit. fun x: unit. m f (n f x)) (fun f: unit -> unit. fun x: unit. f (f x)) (fun f: unit -> unit. fun x: unit. f (f x)) ~>* fun f: unit -> unit. fun x: unit. f (f (f (f x)))`
) {
  reduce!(
    `(fun m: (unit -> unit) -> unit -> unit. fun n: (unit -> unit) -> unit -> unit. fun f: unit -> unit. fun x: unit. m f (n f x)) (fun f: unit -> unit. fun x: unit. f (f x)) (fun f: unit -> unit. fun x: unit. f (f x))`
  )
}

pub theorem two_normalizes(): SN(
  Lam(Arr(Tunit, Tunit), Lam(Tunit, App(Tvar(1), App(Tvar(1), Tvar(0)))))
) {
  strong_normalization(two_typed())
}

// Omega steps to itself, so it is not normalizing, so by strong normalization it has no type.
pub fn omega(): Tm {
  lc!(`(fun x: unit. x x) (fun x: unit. x x)`)
}

pub def NotOmega(x: Tm): Prop := (x = omega()) -> False

pub theorem omega_steps(): lc!(`$omega() ~> $omega()`) {
  SBeta
}

pub theorem omega_not_sn(h: SN(omega())): False {
  sn_induction(
    NotOmega,
    x => k => ih => e => ih(
      omega(),
      Eq::subst(y => Step(y, omega()), Eq::sym(e), omega_steps()),
      Refl
    ),
    omega(),
    h,
    Refl
  )
}

pub theorem omega_untypable<G: List(Ty), A: Ty>(h: lc!(`$G |- $omega() : $A`)): False {
  omega_not_sn(strong_normalization(h))
}
