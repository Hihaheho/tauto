import "../../std/Std.taut"
import "../../std/Mode.taut"
import std::prelude::Macro

pub(open) inductive Ty: Type {
  Tunit: Ty
  Arr(a: Ty, b: Ty): Ty
}

pub(open) inductive Tm: Type {
  Tvar(i: Nat): Tm
  Lam(A: Ty, b: Tm): Tm
  App(f: Tm, a: Tm): Tm
  Tstar: Tm
}

// Renaming and substitution act on de Bruijn indices; going under a binder lifts the map.
pub fn upR(xi: (Nat) -> Nat, n: Nat): Nat {
  match n: Nat {
    Zero => Zero
    Succ(m) => Succ(xi(m))
  }
}

pub fn ren(t: Tm, xi: (Nat) -> Nat): Tm {
  match t: Tm {
    Tvar(i) => Tvar(xi(i))
    Lam(A, b) => Lam(A, ren(b, upR(xi)))
    App(f, a) => App(ren(f, xi), ren(a, xi))
    Tstar => Tstar
  }
}

pub fn up(sigma: (Nat) -> Tm, n: Nat): Tm {
  match n: Tm {
    Zero => Tvar(Zero)
    Succ(m) => ren(sigma(m), Succ)
  }
}

pub fn subst(t: Tm, sigma: (Nat) -> Tm): Tm {
  match t: Tm {
    Tvar(i) => sigma(i)
    Lam(A, b) => Lam(A, subst(b, up(sigma)))
    App(f, a) => App(subst(f, sigma), subst(a, sigma))
    Tstar => Tstar
  }
}

pub fn single(a: Tm, n: Nat): Tm {
  match n: Tm {
    Zero => a
    Succ(m) => Tvar(m)
  }
}

// `lookup(G, i)` finds the type of the variable `i` with its proof, read from the rules
// of `Has`: the context and the index pick the rule, and an empty context finds nothing.
@mode!(`lookup(rec G, in i, out A) -> Looked { HasFound | HasNone }`) => inductive Looked, fn lookup
pub(open) inductive Has: (List(Ty)) -> (Nat) -> (Ty) -> Prop {
  HasHere<G: List(Ty), A: Ty>: Has(Cons(A, G), Zero, A)
  HasThere<G: List(Ty), A: Ty, B: Ty, i: Nat>(h: Has(G, i, A)): Has(Cons(B, G), Succ(i), A)
}

pub(open) inductive TyDec(A: Ty, C: Ty): Type {
  TySame(e: A = C): TyDec(A, C)
  TyDiff(refute: (A = C) -> False): TyDec(A, C)
}

pub fn ty_dec(A: Ty, C: Ty): TyDec(A, C) {
  match A: TyDec(A, C) {
    Tunit => match C: TyDec(Tunit, C) {
      Tunit => TySame(Refl)
      Arr(c1, c2) => TyDiff(e => match e: False {})
    }
    Arr(a1, a2) => match C: TyDec(Arr(a1, a2), C) {
      Tunit => TyDiff(e => match e: False {})
      Arr(c1, c2) => match ty_dec(a1, c1): TyDec(Arr(a1, a2), Arr(c1, c2)) {
        TySame(e1) => match ty_dec(a2, c2): TyDec(Arr(a1, a2), Arr(c1, c2)) {
          TySame(e2) => TySame(
            Eq::trans(Eq::congr((x: Ty) => Arr(x, a2), e1), Eq::congr((x: Ty) => Arr(c1, x), e2))
          )
          TyDiff(no2) => TyDiff(e => match e: False { Refl => no2(Refl) })
        }
        TyDiff(no1) => TyDiff(e => match e: False { Refl => no1(Refl) })
      }
    }
  }
}

// The rules of `Typing` are a program: `infer` reads them, with the proof that its answer is right
// (`Inferred`). A premise on `Has` is answered by `lookup`, and the type a rule asks to be the same
// twice is compared by `ty_dec`.
@mode!(
  ```
  infer(in G, rec t, out A) -> Inferred { inferred | not_inferred }
  via Has: lookup { HasFound | HasNone }
  eq Ty: ty_dec { TySame | TyDiff }
  ```
) => inductive Inferred, fn infer
pub(open) inductive Typing: (List(Ty)) -> (Tm) -> (Ty) -> Prop {
  TVar<G: List(Ty), i: Nat, A: Ty>(h: Has(G, i, A)): Typing(G, Tvar(i), A)
  TLam<G: List(
    Ty
  ), A: Ty, B: Ty, b: Tm>(h: Typing(Cons(A, G), b, B)): Typing(G, Lam(A, b), Arr(A, B))
  TApp<G: List(
    Ty
  ), A: Ty, B: Ty, f: Tm, a: Tm>(
    hf: Typing(G, f, Arr(A, B)),
    ha: Typing(G, a, A)
  ): Typing(G, App(f, a), B)
  TStar<G: List(Ty)>: Typing(G, Tstar, Tunit)
}

pub(open) inductive Value: (Tm) -> Prop {
  VLam<A: Ty, b: Tm>: Value(Lam(A, b))
  VStar: Value(Tstar)
}

pub(open) inductive Step: (Tm) -> (Tm) -> Prop {
  SBeta<A: Ty, b: Tm, a: Tm>: Step(App(Lam(A, b), a), subst(b, single(a)))
  SLam<A: Ty, b: Tm, b2: Tm>(h: Step(b, b2)): Step(Lam(A, b), Lam(A, b2))
  SAppL<f: Tm, f2: Tm, a: Tm>(h: Step(f, f2)): Step(App(f, a), App(f2, a))
  SAppR<f: Tm, a: Tm, a2: Tm>(h: Step(a, a2)): Step(App(f, a), App(f, a2))
}

pub(open) inductive Steps: (Tm) -> (Tm) -> Prop {
  StepsRefl<t: Tm>: Steps(t, t)
  StepsStep<t: Tm, u: Tm, w: Tm>(s: Step(t, u), r: Steps(u, w)): Steps(t, w)
}

// ---- the `lc` notation: named binders, judgements and reductions ---------------------------------
//
// ``lc!(`x: unit |- fun y: unit. x : unit -> unit`)`` is `Typing(Cons(Tunit, Nil), Lam(Tunit, Tvar(1)), Arr(Tunit, Tunit))`:
// names become de Bruijn indices (the last binding of a context is index 0), `$e` embeds a tauto term, a
// context or a type, `t[u]` is `subst(t, single(u))`, and `t ~> u` and `t ~>* u` are `Step` and `Steps`.
// A bare term is that term.

syntax!(lc, ```par
%start Stmt
%title "lc"
%%
Stmt: Judgement | Reduction;
Judgement: Ctx Turnstile Tm Colon Ty;
Reduction: Tm [Arrows Tm];
Arrows: StepStar | StepOne;
Ctx: [CtxHead] { Comma Bind };
CtxHead: Bind | CtxEmbed;
CtxEmbed: TautoExpr;
Bind: Name Colon Ty;
Tm: Lambda | Spine;
Lambda: KwFun Name Colon Ty Dot Tm;
Spine: Postfix { Postfix };
Postfix: Atom { LBracket Tm RBracket };
Atom: VarAtom | StarAtom | Paren | Embed;
VarAtom: Name;
StarAtom: KwStar;
Paren: LParen Tm RParen;
Embed: TautoExpr;
Ty: TyAtom [Arrow Ty];
TyAtom: UnitTy | TyParen | TyEmbed;
UnitTy: KwUnit;
TyParen: LParen Ty RParen;
TyEmbed: TautoExpr;
KwFun: 'fun';
KwStar: 'star';
KwUnit: 'unit';
Name: /[a-z][a-zA-Z0-9_']*/;
Turnstile: '|-';
StepStar: '~>*';
StepOne: '~>';
Arrow: '->';
Colon: ':';
Comma: ',';
Dot: '.';
LBracket: '[';
RBracket: ']';
LParen: '(';
RParen: ')';
```) => enum Arrows, enum Atom, struct Bind, struct Ctx, struct Ctx_Rep1,
  enum CtxHead, struct Judgement, struct Lambda, struct Paren, struct Postfix,
  struct Postfix_Rep1, struct Reduction, struct Reduction_Opt1, struct Spine,
  struct StarAtom, enum Stmt, enum Tm, struct Ty, struct Ty_Opt1, enum TyAtom,
  struct TyParen, struct UnitTy, struct VarAtom, fn parse

pub fn lc_ty_atom(t: lc::TyAtom): SynExpr ! {macro_error, Div} {
  match t {
    UnitTy(u) => quote { Tunit }
    TyParen(p) => lc_ty(p.ty)
    TyEmbed(e) => e
  }
}

pub fn lc_ty(t: lc::Ty): SynExpr ! {macro_error, Div} {
  let a := lc_ty_atom(t.ty_atom)
  match t.opt {
    None => a
    Some(o) => {
      let b := lc_ty(o.ty)
      quote { Arr($a, $b) }
    }
  }
}

// The de Bruijn index of a name in the list of names in scope, innermost first.
pub fn lc_index(env: List(Text), name: Text, span: SynSpan): SynExpr ! {macro_error, Div} {
  match env {
    Nil => Syn::error(span, "unbound variable")
    Cons(x, rest) => if x == name {
      quote { Zero }
    } else {
      let r := lc_index(rest, name, span)
      quote { Succ($r) }
    }
  }
}

pub fn lc_atom(env: List(Text), a: lc::Atom): SynExpr ! {macro_error, Div} {
  match a {
    VarAtom(v) => {
      let i := lc_index(env, Syn::ident(v.name).name, v.span)
      quote { Tvar($i) }
    }
    StarAtom(s) => quote { Tstar }
    Paren(p) => lc_tm(env, p.tm)
    Embed(e) => e
  }
}

pub fn lc_postfix_rest(
  env: List(Text),
  acc: SynExpr,
  rest: List(lc::Postfix_Rep1)
): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => {
      let u := lc_tm(env, r.tm)
      lc_postfix_rest(env, quote { subst($acc, single($u)) }, more)
    }
  }
}

pub fn lc_postfix(env: List(Text), p: lc::Postfix): SynExpr ! {macro_error, Div} {
  lc_postfix_rest(env, lc_atom(env, p.atom), p.rep)
}

pub fn lc_spine_rest(
  env: List(Text),
  acc: SynExpr,
  rest: List(lc::Postfix)
): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(p, more) => {
      let a := lc_postfix(env, p)
      lc_spine_rest(env, quote { App($acc, $a) }, more)
    }
  }
}

pub fn lc_tm(env: List(Text), t: lc::Tm): SynExpr ! {macro_error, Div} {
  match t {
    Lambda(l) => {
      let ty := lc_ty(l.ty)
      let body := lc_tm(Cons(Syn::ident(l.name).name, env), l.tm)
      quote { Lam($ty, $body) }
    }
    Spine(s) => lc_spine_rest(env, lc_postfix(env, s.postfix), s.postfix_2)
  }
}

// The context of a judgement: its names (innermost first) and the list of types.
pub fn lc_env_rest(env: List(Text), rest: List(lc::Ctx_Rep1)): List(Text) ! {macro_error, Div} {
  match rest {
    Nil => env
    Cons(r, more) => lc_env_rest(Cons(Syn::ident(r.bind.name).name, env), more)
  }
}

pub fn lc_ctx_env(c: lc::Ctx): List(Text) ! {macro_error, Div} {
  match c.ctx_head {
    None => lc_env_rest(Nil, c.rep)
    Some(h) => match h {
      Bind(b) => lc_env_rest(Cons(Syn::ident(b.name).name, Nil), c.rep)
      CtxEmbed(e) => lc_env_rest(Nil, c.rep)
    }
  }
}

pub fn lc_ctx_rest(acc: SynExpr, rest: List(lc::Ctx_Rep1)): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => {
      let ty := lc_ty(r.bind.ty)
      lc_ctx_rest(quote { Cons($ty, $acc) }, more)
    }
  }
}

pub fn lc_ctx(c: lc::Ctx): SynExpr ! {macro_error, Div} {
  match c.ctx_head {
    None => lc_ctx_rest(quote { Nil }, c.rep)
    Some(h) => match h {
      Bind(b) => {
        let ty := lc_ty(b.ty)
        lc_ctx_rest(quote { Cons($ty, Nil) }, c.rep)
      }
      CtxEmbed(e) => lc_ctx_rest(e, c.rep)
    }
  }
}

pub macro fn lc(s: lc::Stmt): SynExpr ! {macro_error, Div} {
  match s {
    Judgement(j) => {
      let g := lc_ctx(j.ctx)
      let t := lc_tm(lc_ctx_env(j.ctx), j.tm)
      let a := lc_ty(j.ty)
      quote { Typing($g, $t, $a) }
    }
    Reduction(r) => {
      let t := lc_tm(Nil, r.tm)
      match r.opt {
        None => t
        Some(o) => {
          let u := lc_tm(Nil, o.tm)
          match o.arrows {
            StepOne(k) => quote { Step($t, $u) }
            StepStar(k) => quote { Steps($t, $u) }
          }
        }
      }
    }
  }
}

// `steps!(then(s1, s2, s3))` chains single steps into a proof of `Steps`. It reads its argument as a tauto
// expression (an untyped macro); the kernel then checks that the steps follow one another.
pub fn steps_chain(args: List(SynExpr)): SynExpr ! {macro_error, Div} {
  match args {
    Nil => quote { StepsRefl }
    Cons(a, rest) => {
      let r := steps_chain(rest)
      quote { StepsStep($a, $r) }
    }
  }
}

pub macro fn steps(e: SynExpr): SynExpr ! {macro_error, Div} {
  match e {
    ExApp(f, args, sp) => steps_chain(args)
    _ => e
  }
}

// ---- ``reduce!(`t`)``: a macro that finds the reduction ----------------------------------------------
//
// ``reduce!(`t`)`` reads a closed term written like in `lc!`, reduces it in normal order on a copy of the syntax
// that has no types, and writes the proof of `Steps(t, nf)` that follows the same path. The kernel checks
// that proof against whatever the theorem claims, so a wrong normal form is rejected.

pub(open) enum LTm {
  LVar(u64)
  LLam(LTm)
  LApp(LTm, LTm)
  LStar
}

pub(open) struct LStep {
  proof: SynExpr
  next: LTm
}

pub fn lc_shift(t: LTm, c: u64, d: u64): LTm {
  match t {
    LVar(k) => if k < c { LVar(k) } else { LVar(k + d) }
    LLam(b) => LLam(lc_shift(b, c + 1, d))
    LApp(f, a) => LApp(lc_shift(f, c, d), lc_shift(a, c, d))
    LStar => LStar
  }
}

pub fn lc_unshift(t: LTm, c: u64): LTm {
  match t {
    LVar(k) => if k < c { LVar(k) } else { LVar(k - 1) }
    LLam(b) => LLam(lc_unshift(b, c + 1))
    LApp(f, a) => LApp(lc_unshift(f, c), lc_unshift(a, c))
    LStar => LStar
  }
}

pub fn lc_subst(t: LTm, j: u64, s: LTm): LTm {
  match t {
    LVar(k) => if k == j { s } else { LVar(k) }
    LLam(b) => LLam(lc_subst(b, j + 1, lc_shift(s, 0, 1)))
    LApp(f, a) => LApp(lc_subst(f, j, s), lc_subst(a, j, s))
    LStar => LStar
  }
}

pub fn lc_beta(b: LTm, a: LTm): LTm {
  lc_unshift(lc_subst(b, 0, lc_shift(a, 0, 1)), 0)
}

pub fn lc_step(t: LTm): Option(LStep) {
  match t {
    LApp(f, a) => match f {
      LLam(b) => Some(LStep { proof: quote { SBeta }, next: lc_beta(b, a) })
      _ => match lc_step(f) {
        Some(s) => {
          let p := s.proof
          Some(LStep { proof: quote { SAppL($p) }, next: LApp(s.next, a) })
        }
        None => match lc_step(a) {
          Some(s) => {
            let p := s.proof
            Some(LStep { proof: quote { SAppR($p) }, next: LApp(f, s.next) })
          }
          None => None
        }
      }
    }
    LLam(b) => match lc_step(b) {
      Some(s) => {
        let p := s.proof
        Some(LStep { proof: quote { SLam($p) }, next: LLam(s.next) })
      }
      None => None
    }
    LVar(k) => None
    LStar => None
  }
}

pub fn lc_chain(t: LTm, fuel: u64): SynExpr {
  if fuel == 0 { quote { StepsRefl } } else {
    match lc_step(t) {
      None => quote { StepsRefl }
      Some(s) => {
        let p := s.proof
        let rest := lc_chain(s.next, fuel - 1)
        quote { StepsStep($p, $rest) }
      }
    }
  }
}

pub fn lc_name(e: SynExpr): Text {
  match e {
    ExVar(id) => id.name
    _ => "?"
  }
}

pub fn lc_bad(sp: SynSpan): LTm ! {macro_error} {
  Syn::error(sp, "reduce! reads a term built from Tvar, Lam, App and Tstar")
}

// An index written `Zero`, `Succ(n)` or as a literal.
pub fn lc_read_index(sp: SynSpan, e: SynExpr): u64 ! {macro_error} {
  match e {
    ExVar(id) => if id.name == "Zero" { 0 } else {
      Syn::error(id.span, "an index is Zero, Succ(n) or a literal")
    }
    ExNat(text, sp2) => lc_digits(text, sp2)
    ExApp(f, args, sp2) => match args {
      Cons(n, Nil) => if lc_name(f) == "Succ" { lc_read_index(sp2, n) + 1 } else {
        Syn::error(sp2, "an index is Zero, Succ(n) or a literal")
      }
      _ => Syn::error(sp2, "an index is Zero, Succ(n) or a literal")
    }
    _ => Syn::error(sp, "an index is Zero, Succ(n) or a literal")
  }
}

pub fn lc_digits(text: Text, sp: SynSpan): u64 ! {macro_error} {
  if text == "0" { 0 } else {
    if text == "1" { 1 } else {
      if text == "2" { 2 } else {
        if text == "3" { 3 } else { Syn::error(sp, "this example reads indices up to 3") }
      }
    }
  }
}

pub fn lc_read(sp: SynSpan, e: SynExpr): LTm ! {macro_error, Div} {
  match e {
    ExVar(id) => if id.name == "Tstar" { LStar } else { lc_bad(id.span) }
    ExApp(f, args, sp2) => lc_read_app(sp2, lc_name(f), args)
    _ => lc_bad(sp)
  }
}

pub fn lc_read_app(sp: SynSpan, name: Text, args: List(SynExpr)): LTm ! {macro_error, Div} {
  match args {
    Cons(x, Nil) => if name == "Tvar" { LVar(lc_read_index(sp, x)) } else { lc_bad(sp) }
    Cons(x, Cons(y, Nil)) => if name == "Lam" { LLam(lc_read(sp, y)) } else {
      if name == "App" { LApp(lc_read(sp, x), lc_read(sp, y)) } else { lc_bad(sp) }
    }
    _ => lc_bad(sp)
  }
}

pub macro fn reduce(s: lc::Stmt): SynExpr ! {macro_error, Div} {
  match s {
    Judgement(j) => Syn::error(j.span, "reduce! takes a term, not a judgement")
    Reduction(r) => {
      let t := lc_tm(Nil, r.tm)
      lc_chain(lc_read(r.span, t), 100)
    }
  }
}

// `reduce_goal!` is a tactic (`docs/design/macro-steps.md`): in
// `by reduce_goal!(): Steps(t, nf) {}` it reads `t` from the goal written, and
// the proof is found from the claim.
pub macro fn reduce_goal(s: ProofStep): SynExpr ! {macro_error, Div} {
  match Judgement::term(s.before) {
    ExApp(f, args, sp) => match args {
      Cons(t, rest) => lc_chain(lc_read(sp, t), 100)
      Nil => Syn::error(sp, "reduce_goal! needs a Steps(t, u)")
    }
    _ => Syn::error(s.span, "reduce_goal! needs a Steps(t, u)")
  }
}
