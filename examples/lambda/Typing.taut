import "Lib.taut"

theorem has_pred<G: List(Ty), A: Ty, B: Ty, i: Nat>(h: Has(cons(B, G), succ(i), A)): Has(G, i, A) {
  match h -> Has(G, i, A) {
    has_there(h0) => h0
  }
}

// ---- weakening and renaming -------------------------------------------------------------

def RenOk(xi: (Nat) -> Nat, G: List(Ty), D: List(Ty)): Prop :=
∀ i: Nat. ∀ A: Ty. (Has(G, i, A)) -> Has(D, xi(i), A)

theorem renok_up_at<xi: (
  Nat
) -> Nat, G: List(
  Ty
), D: List(
  Ty
), C: Ty>(
  r: RenOk(xi, G, D),
  i: Nat,
  A: Ty,
  h: Has(cons(C, G), i, A)
): Has(cons(C, D), upR(xi, i), A) {
  match i -> Has(cons(C, D), upR(xi, i), A) {
    zero => match h -> Has(cons(Ty, C, D), zero, A) {
      has_here(g, a) => has_here()
    }
    succ(m) => has_there(r(m, A, has_pred(h)))
  }
}

theorem renok_up<xi: (
  Nat
) -> Nat, G: List(
  Ty
), D: List(Ty)>(C: Ty, r: RenOk(xi, G, D)): RenOk(upR(xi), cons(C, G), cons(C, D)) {
  i => A => h => renok_up_at(r, i, A, h)
}

theorem ren_typing<G: List(
  Ty
), t: Tm, A: Ty>(
  h: lc!(`${G} |- ${t} : ${A}`),
  xi: (Nat) -> Nat,
  D: List(Ty),
  r: RenOk(xi, G, D)
): lc!(`${D} |- ${ren(t, xi)} : ${A}`) {
  match h -> Typing(D, ren(t, xi), A) {
    t_var(G1, i, A1, hv) => t_var(r(i, A1, hv))
    t_lam(G1, A1, B1, b, hb) => t_lam(ren_typing(hb, upR(xi), cons(Ty, A1, D), renok_up(A1, r)))
    t_app(G1, A1, B1, f, a, hf, ha) => t_app(ren_typing(hf, xi, D, r), ren_typing(ha, xi, D, r))
    t_star(G1) => t_star()
  }
}

// ---- substitution -------------------------------------------------------------------------

def SubOk(sigma: (Nat) -> Tm, G: List(Ty), D: List(Ty)): Prop :=
∀ i: Nat. ∀ A: Ty. (Has(G, i, A)) -> Typing(D, sigma(i), A)

theorem renok_succ(D: List(Ty), C: Ty): RenOk(succ, D, cons(Ty, C, D)) {
  i => A => h => has_there(h)
}

theorem subok_up_at<sigma: (
  Nat
) -> Tm, G: List(
  Ty
), D: List(
  Ty
), C: Ty>(
  r: SubOk(sigma, G, D),
  i: Nat,
  A: Ty,
  h: Has(cons(Ty, C, G), i, A)
): Typing(cons(Ty, C, D), up(sigma, i), A) {
  match i -> Typing(cons(Ty, C, D), up(sigma, i), A) {
    zero => match h -> Typing(cons(Ty, C, D), tvar(zero), A) {
      has_here(g, a) => t_var(has_here())
    }
    succ(m) => ren_typing(r(m, A, has_pred(h)), succ, cons(Ty, C, D), renok_succ(D, C))
  }
}

theorem subok_up<sigma: (
  Nat
) -> Tm, G: List(
  Ty
), D: List(Ty)>(C: Ty, r: SubOk(sigma, G, D)): SubOk(up(sigma), cons(Ty, C, G), cons(Ty, C, D)) {
  i => A => h => subok_up_at(r, i, A, h)
}

theorem subst_typing<G: List(
  Ty
), t: Tm, A: Ty>(
  h: lc!(`${G} |- ${t} : ${A}`),
  sigma: (Nat) -> Tm,
  D: List(Ty),
  r: SubOk(sigma, G, D)
): lc!(`${D} |- ${subst(t, sigma)} : ${A}`) {
  match h -> Typing(D, subst(t, sigma), A) {
    t_var(G1, i, A1, hv) => r(i, A1, hv)
    t_lam(G1, A1, B1, b, hb) => t_lam(subst_typing(hb, up(sigma), cons(Ty, A1, D), subok_up(A1, r)))
    t_app(
      G1,
      A1,
      B1,
      f,
      a,
      hf,
      ha
    ) => t_app(subst_typing(hf, sigma, D, r), subst_typing(ha, sigma, D, r))
    t_star(G1) => t_star()
  }
}

theorem subok_single_at<G: List(
  Ty
), a: Tm, C: Ty>(
  ha: Typing(G, a, C),
  i: Nat,
  A: Ty,
  h: Has(cons(Ty, C, G), i, A)
): Typing(G, single(a, i), A) {
  match i -> Typing(G, single(a, i), A) {
    zero => match h -> Typing(G, a, A) {
      has_here(g, a0) => ha
    }
    succ(m) => t_var(has_pred(h))
  }
}

theorem subst_single_typing<G: List(
  Ty
), b: Tm, a: Tm, A: Ty, B: Ty>(
  hb: lc!(`${cons(A, G)} |- ${b} : ${B}`),
  ha: lc!(`${G} |- ${a} : ${A}`)
): lc!(`${G} |- ${b}[${a}] : ${B}`) {
  subst_typing(hb, single(a), G, i => C => h => subok_single_at(ha, i, C, h))
}

// ---- inversion ------------------------------------------------------------------------------

inductive InvApp(G: List(Ty), f: Tm, a: Tm, B: Ty): Prop {
  inv_app<A: Ty>(hf: Typing(G, f, arr(A, B)), ha: Typing(G, a, A)): InvApp(G, f, a, B)
}

theorem invert_app<G: List(
  Ty
), f: Tm, a: Tm, B: Ty>(h: lc!(`${G} |- ${f} ${a} : ${B}`)): InvApp(G, f, a, B) {
  match h -> InvApp(G, f, a, B) {
    t_app(hf, ha) => inv_app(hf, ha)
  }
}

inductive InvLam(G: List(Ty), A: Ty, b: Tm, T: Ty): Prop {
  inv_lam<B: Ty>(e: Eq(Ty, T, arr(A, B)), hb: Typing(cons(Ty, A, G), b, B)): InvLam(G, A, b, T)
}

theorem invert_lam<G: List(
  Ty
), A: Ty, b: Tm, T: Ty>(h: Typing(G, lam(A, b), T)): InvLam(G, A, b, T) {
  match h -> InvLam(G, A, b, T) {
    t_lam(hb) => inv_lam(refl(), hb)
  }
}

// ---- type safety ---------------------------------------------------------------------------

theorem preservation<t: Tm, t2: Tm>(
  s: lc!(`${t} ~> ${t2}`),
  G: List(Ty),
  A: Ty,
  h: lc!(`${G} |- ${t} : ${A}`)
): lc!(`${G} |- ${t2} : ${A}`) {
  match s -> Typing(G, t2, A) {
    s_beta(A0, b, a) => match invert_app(h) -> Typing(G, subst(b, single(a)), A) {
      inv_app(A1, hf, ha) => match invert_lam(hf) -> Typing(G, subst(b, single(a)), A) {
        inv_lam(B1, e, hb) => match e -> Typing(G, subst(b, single(a)), A) {
          refl => subst_single_typing(hb, ha)
        }
      }
    }
    s_lam(A0, b, b2, hs) => match invert_lam(h) -> Typing(G, lam(A0, b2), A) {
      inv_lam(B1, e, hb) => match e -> Typing(G, lam(A0, b2), A) {
        refl => t_lam(preservation(hs, cons(Ty, A0, G), B1, hb))
      }
    }
    s_app_l(f, f2, a, hs) => match invert_app(h) -> Typing(G, app(f2, a), A) {
      inv_app(A1, hf, ha) => t_app(preservation(hs, G, arr(A1, A), hf), ha)
    }
    s_app_r(f, a, a2, hs) => match invert_app(h) -> Typing(G, app(f, a2), A) {
      inv_app(A1, hf, ha) => t_app(hf, preservation(hs, G, A1, ha))
    }
  }
}

theorem star_not_arr<G: List(Ty), A: Ty, B: Ty>(h: Typing(G, tstar, arr(A, B))): False {
  match h -> False {
  }
}

inductive CanStep(t: Tm): Prop {
  can_step<t2: Tm>(s: Step(t, t2)): CanStep(t)
}

def Prog(t: Tm): Prop := Or(Value(t), CanStep(t))

theorem progress<t: Tm, A: Ty>(h: lc!(`|- ${t} : ${A}`)): Prog(t) {
  match h -> Prog(t) {
    t_var(G1, i, A1, hv) => match hv -> Prog(tvar(i)) {
    }
    t_lam(G1, A1, B1, b, hb) => or_inl(v_lam())
    t_app(G1, A1, B1, f, a, hf, ha) => match progress(f, arr(A1, B1), hf) -> Prog(app(f, a)) {
      or_inl(vf) => (match vf -> (Typing(nil(Ty), f, arr(A1, B1))) -> Prog(app(f, a)) {
        v_lam(A0, b) => k => or_inr(can_step(s_beta()))
        v_star => k => False_elim(star_not_arr(k))
      })(hf)
      or_inr(cf) => match cf -> Prog(app(f, a)) {
        can_step(f2, s) => or_inr(can_step(s_app_l(s)))
      }
    }
    t_star(G1) => or_inl(v_star())
  }
}

theorem type_safety<t: Tm, u: Tm, A: Ty>(
  r: lc!(`${t} ~>* ${u}`),
  h: lc!(`|- ${t} : ${A}`)
): Prog(u) {
  match r -> Prog(u) {
    steps_refl(t0) => progress(h)
    steps_step(t0, u0, w, s, r0) => type_safety(r0, preservation(s, nil(Ty), A, h))
  }
}
