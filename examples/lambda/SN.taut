import "Alg.taut"
import "Lib.taut"
import "Typing.taut"

pub(open) inductive SN: (Tm) -> Prop {
  SnIntro<t: Tm>(h: ∀ u: Tm. (Step(t, u)) -> SN(u)): SN(t)
}

// Induction on a normalizing term: the step case may use the claim for every reduct.
pub theorem sn_induction(
  P: (Tm) -> Prop,
  step: ∀ t: Tm. (∀ u: Tm. (Step(t, u)) -> SN(u)) -> (∀ u: Tm. (Step(t, u)) -> P(u)) -> P(t),
  t: Tm,
  h: SN(t)
): P(t) {
  match h: P(t) {
    SnIntro(t0, k) => step(t0, k, u => s => sn_induction(P, step, u, k(u, s)))
  }
}

pub theorem sn_step<t: Tm, u: Tm>(h: SN(t), s: lc!(`$t ~> $u`)): SN(u) {
  match h: SN(u) {
    SnIntro(t0, k) => k(u, s)
  }
}

pub theorem step_subst<t: Tm, u: Tm>(
  s: lc!(`$t ~> $u`),
  sigma: (Nat) -> Tm
): lc!(`${subst(t, sigma)} ~> ${subst(u, sigma)}`) {
  match s: Step(subst(t, sigma), subst(u, sigma)) {
    SBeta(A, b, a) => Eq::subst(
      x => Step(App(Lam(A, subst(b, up(sigma))), subst(a, sigma)), x),
      Eq::sym(subst_single_subst(b, a, sigma)),
      SBeta
    )
    SLam(A, b, b2, h) => SLam(step_subst(h, up(sigma)))
    SAppL(f, f2, a, h) => SAppL(step_subst(h, sigma))
    SAppR(f, a, a2, h) => SAppR(step_subst(h, sigma))
  }
}

pub def SnOfSubst(
  x: Tm
): Prop := ∀ t0: Tm. ∀ sigma0: (Nat) -> Tm. (x = subst(t0, sigma0)) -> SN(t0)

pub theorem sn_of_subst(t: Tm, sigma: (Nat) -> Tm, h: SN(subst(t, sigma))): SN(t) {
  sn_induction(
    SnOfSubst,
    x => k => ih => t0 => sigma0 => e => SnIntro(
      u => s => ih(
        subst(u, sigma0),
        Eq::subst(y => Step(y, subst(u, sigma0)), Eq::sym(e), step_subst(s, sigma0)),
        u,
        sigma0,
        Refl
      )
    ),
    subst(t, sigma),
    h,
    t,
    sigma,
    Refl
  )
}

pub theorem no_step_star<u: Tm>(s: Step(Tstar, u)): False {
  match s: False {
  }
}

pub theorem sn_star(): SN(Tstar) {
  SnIntro(u => s => False::elim(no_step_star(s)))
}

pub def SnApp(x: Tm): Prop := ∀ f: Tm. ∀ a: Tm. (x = App(f, a)) -> SN(f)

pub theorem sn_app_aux(t: Tm, h: SN(t)): ∀ f: Tm. ∀ a: Tm. (t = App(f, a)) -> SN(f) {
  sn_induction(
    SnApp,
    x => k => ih => f => a => e => SnIntro(
      f2 => s => ih(
        App(f2, a),
        Eq::subst(y => Step(y, App(f2, a)), Eq::sym(e), SAppL(s)),
        f2,
        a,
        Refl
      )
    ),
    t,
    h
  )
}

pub theorem sn_app_l<f: Tm, a: Tm>(h: SN(App(f, a))): SN(f) {
  sn_app_aux(App(f, a), h, f, a, Refl)
}

pub(open) inductive Neutral: (Tm) -> Prop {
  NeuVar<i: Nat>: Neutral(Tvar(i))
  NeuApp<f: Tm, a: Tm>: Neutral(App(f, a))
  NeuStar: Neutral(Tstar)
}

pub theorem neutral_lam<A: Ty, b: Tm>(n: Neutral(Lam(A, b))): False {
  match n: False {
  }
}

pub theorem no_step_var<i: Nat, u: Tm>(s: Step(Tvar(i), u)): False {
  match s: False {
  }
}

pub def RedArr(P: (Tm) -> Prop, Q: (Tm) -> Prop, t: Tm): Prop := ∀ w: Tm. (P(w)) -> Q(App(t, w))

// Reducibility candidates: strong normalization at the base type, and
// preservation of reducibility by application at an arrow.
pub fn Red(A: Ty, t: Tm): Prop {
  match A: Prop {
    Tunit => SN(t)
    Arr(A1, B1) => RedArr(w => Red(A1, w), w => Red(B1, w), t)
  }
}

pub def Cr1(A: Ty): Prop := ∀ t: Tm. (Red(A, t)) -> SN(t)

pub def Cr2(A: Ty): Prop := ∀ t: Tm. ∀ u: Tm. (Red(A, t)) -> (Step(t, u)) -> Red(A, u)

pub def Cr3(
  A: Ty
): Prop := ∀ t: Tm. (Neutral(t)) -> (∀ u: Tm. (Step(t, u)) -> Red(A, u)) -> Red(A, t)

pub def CrAll(A: Ty): Prop := And(Cr1(A), And(Cr2(A), Cr3(A)))

pub(open) inductive InvStepApp(t: Tm, x: Tm, v: Tm): Prop {
  IsaBeta<A0: Ty, b: Tm>(
    e: t = Lam(A0, b),
    ev: v = subst(b, single(x))
  ): InvStepApp(t, x, v)
  IsaL<f2: Tm>(s: Step(t, f2), ev: v = App(f2, x)): InvStepApp(t, x, v)
  IsaR<x2: Tm>(s: Step(x, x2), ev: v = App(t, x2)): InvStepApp(t, x, v)
}

pub theorem invert_step_app<t: Tm, x: Tm, v: Tm>(s: Step(App(t, x), v)): InvStepApp(t, x, v) {
  match s: InvStepApp(t, x, v) {
    SBeta(A0, b, a) => IsaBeta(Refl, Refl)
    SAppL(f, f2, a, h) => IsaL(h, Refl)
    SAppR(f, a, a2, h) => IsaR(h, Refl)
  }
}

pub def NeuP(A: Ty, B: Ty, t: Tm, x: Tm): Prop := (Red(A, x)) -> Red(B, App(t, x))

// A reduct of an application of a neutral term is reducible, given that the head's reducts and
// the argument's reducts are.
pub theorem neutral_app_reduct(
  A: Ty,
  B: Ty,
  ca: CrAll(A),
  cb: CrAll(B),
  t: Tm,
  n: Neutral(t),
  k: ∀ u: Tm. (Step(t, u)) -> Red(Arr(A, B), u),
  x: Tm,
  hx: Red(A, x),
  ih: ∀ x2: Tm. (Step(x, x2)) -> NeuP(A, B, t, x2),
  v: Tm,
  s: Step(App(t, x), v)
): Red(B, v) {
  match invert_step_app(s): Red(B, v) {
    IsaBeta(A0, b, e, ev) => False::elim(neutral_lam(Eq::subst(Neutral, e, n)))
    IsaL(f2, s2, ev) => Eq::subst(y => Red(B, y), Eq::sym(ev), k(f2, s2)(x, hx))
    IsaR(x2, s2, ev) => Eq::subst(
      y => Red(B, y),
      Eq::sym(ev),
      ih(x2, s2, And::left(And::right(ca))(x, x2, hx, s2))
    )
  }
}

pub theorem red_neutral_app(
  A: Ty,
  B: Ty,
  ca: CrAll(A),
  cb: CrAll(B),
  t: Tm,
  n: Neutral(t),
  k: ∀ u: Tm. (Step(t, u)) -> Red(Arr(A, B), u),
  x: Tm,
  hs: SN(x)
): NeuP(A, B, t, x) {
  sn_induction(
    NeuP(A, B, t),
    x0 => kx => ih => hx => And::right(
      And::right(cb)
    )(App(t, x0), NeuApp, v => s => neutral_app_reduct(A, B, ca, cb, t, n, k, x0, hx, ih, v, s)),
    x,
    hs
  )
}

pub theorem cr_arr(A1: Ty, B1: Ty, ca: CrAll(A1), cb: CrAll(B1)): CrAll(Arr(A1, B1)) {
  AndIntro(
    t => h => sn_app_l(
      And::left(
        cb
      )(
        App(t, Tvar(Zero)),
        h(
          Tvar(Zero),
          And::right(And::right(ca))(Tvar(Zero), NeuVar, u => s => False::elim(no_step_var(s)))
        )
      )
    ),
    AndIntro(
      t => u => h => s => w => hw => And::left(
        And::right(cb)
      )(App(t, w), App(u, w), h(w, hw), SAppL(s)),
      t => n => k => w => hw => red_neutral_app(A1, B1, ca, cb, t, n, k, w, And::left(ca)(w, hw), hw)
    )
  )
}

pub theorem cr(A: Ty): CrAll(A) {
  match A: CrAll(A) {
    Tunit => AndIntro(
      t => h => h,
      AndIntro(t => u => h => s => sn_step(h, s), t => n => k => SnIntro(k))
    )
    Arr(A1, B1) => cr_arr(A1, B1, cr(A1), cr(B1))
  }
}

pub theorem red_var(A: Ty, i: Nat): Red(A, Tvar(i)) {
  And::right(And::right(cr(A)))(Tvar(i), NeuVar, u => s => False::elim(no_step_var(s)))
}

pub(open) inductive InvStepLam(A: Ty, b: Tm, f2: Tm): Prop {
  Isl<b2: Tm>(s: Step(b, b2), e: f2 = Lam(A, b2)): InvStepLam(A, b, f2)
}

pub theorem invert_step_lam<A: Ty, b: Tm, f2: Tm>(s: Step(Lam(A, b), f2)): InvStepLam(A, b, f2) {
  match s: InvStepLam(A, b, f2) {
    SLam(A0, b0, b2, h) => Isl(h, Refl)
  }
}

pub fn lam_ty(t: Tm): Ty {
  match t: Ty {
    Tvar(i) => Tunit
    Lam(A, b) => A
    App(f, a) => Tunit
    Tstar => Tunit
  }
}

pub fn lam_body(t: Tm): Tm {
  match t: Tm {
    Tvar(i) => t
    Lam(A, b) => b
    App(f, a) => t
    Tstar => t
  }
}

pub def BetaHyp(A: Ty, B: Ty, b: Tm): Prop := ∀ w: Tm. (Red(A, w)) -> Red(B, subst(b, single(w)))

pub def BetaP1(
  A: Ty,
  B: Ty,
  b: Tm
): Prop := ∀ w: Tm. (SN(w)) -> (Red(A, w)) -> (BetaHyp(A, B, b)) -> Red(B, App(Lam(A, b), w))

pub def BetaP2(
  A: Ty,
  B: Ty,
  b: Tm,
  w: Tm
): Prop := (Red(A, w)) -> (BetaHyp(A, B, b)) -> Red(B, App(Lam(A, b), w))

pub theorem beta_step(
  A: Ty,
  B: Ty,
  ca: CrAll(A),
  cb: CrAll(B),
  b: Tm,
  w: Tm,
  hsw: SN(w),
  hw: Red(A, w),
  hyp: BetaHyp(A, B, b),
  ih1: ∀ b2: Tm. (Step(b, b2)) -> BetaP1(A, B, b2),
  ih2: ∀ w2: Tm. (Step(w, w2)) -> BetaP2(A, B, b, w2),
  v: Tm,
  s: Step(App(Lam(A, b), w), v)
): Red(B, v) {
  match invert_step_app(s): Red(B, v) {
    IsaBeta(A0, b0, e, ev) => Eq::subst(
      y => Red(B, y),
      Eq::sym(ev),
      Eq::subst(y => Red(B, subst(y, single(w))), Eq::congr(lam_body, e), hyp(w, hw))
    )
    IsaL(f2, s2, ev) => match invert_step_lam(s2): Red(B, v) {
      Isl(b2, s3, e2) => Eq::subst(
        y => Red(B, y),
        Eq::sym(ev),
        Eq::subst(
          y => Red(B, App(y, w)),
          Eq::sym(e2),
          ih1(
            b2,
            s3,
            w,
            hsw,
            hw,
            w2 => hw2 => And::left(
              And::right(cb)
            )(subst(b, single(w2)), subst(b2, single(w2)), hyp(w2, hw2), step_subst(s3, single(w2)))
          )
        )
      )
    }
    IsaR(x2, s2, ev) => Eq::subst(
      y => Red(B, y),
      Eq::sym(ev),
      ih2(x2, s2, And::left(And::right(ca))(w, x2, hw, s2), hyp)
    )
  }
}

// Beta expansion: a redex whose contractum is reducible for every reducible argument is reducible.
pub theorem red_beta(
  A: Ty,
  B: Ty,
  ca: CrAll(A),
  cb: CrAll(B),
  b: Tm,
  hb: SN(b),
  w: Tm,
  hw: SN(w),
  rw: Red(A, w),
  hyp: BetaHyp(A, B, b)
): Red(B, App(Lam(A, b), w)) {
  sn_induction(
    BetaP1(A, B),
    b0 => kb => ihb => w0 => hw0 => rw0 => hyp0 => sn_induction(
      BetaP2(A, B, b0),
      w1 => kw => ihw => rw1 => hyp1 => And::right(
        And::right(cb)
      )(
        App(Lam(A, b0), w1),
        NeuApp,
        v => s => beta_step(A, B, ca, cb, b0, w1, SnIntro(kw), rw1, hyp1, ihb, ihw, v, s)
      ),
      w0,
      hw0,
      rw0,
      hyp0
    ),
    b,
    hb,
    w,
    hw,
    rw,
    hyp
  )
}

pub def RedSub(
  sigma: (Nat) -> Tm,
  G: List(Ty)
): Prop := ∀ i: Nat. ∀ C: Ty. (Has(G, i, C)) -> Red(C, sigma(i))

pub theorem redsub_extend_at(
  sigma: (Nat) -> Tm,
  G: List(Ty),
  A: Ty,
  w: Tm,
  rw: Red(A, w),
  rs: RedSub(sigma, G),
  i: Nat,
  C: Ty,
  h: Has(Cons(Ty, A, G), i, C)
): Red(C, extend(w, sigma, i)) {
  match i: Red(C, extend(w, sigma, i)) {
    Zero => match h: Red(C, w) {
      HasHere(g, a) => rw
    }
    Succ(m) => rs(m, C, has_pred(h))
  }
}

pub theorem lam_red(
  A: Ty,
  B: Ty,
  b: Tm,
  sigma: (Nat) -> Tm,
  G: List(Ty),
  ihb: ∀ tau: (Nat) -> Tm. (RedSub(tau, Cons(Ty, A, G))) -> Red(B, subst(b, tau)),
  rs: RedSub(sigma, G)
): Red(Arr(A, B), Lam(A, subst(b, up(sigma)))) {
  w => hw => red_beta(
    A,
    B,
    cr(A),
    cr(B),
    subst(b, up(sigma)),
    sn_of_subst(
      subst(b, up(sigma)),
      single(Tvar(Zero)),
      And::left(
        cr(B)
      )(
        subst(subst(b, up(sigma)), single(Tvar(Zero))),
        Eq::subst(
          y => Red(B, y),
          Eq::sym(subst_up_single(b, sigma, Tvar(Zero))),
          ihb(
            extend(Tvar(Zero), sigma),
            i => C => h => redsub_extend_at(sigma, G, A, Tvar(Zero), red_var(A, Zero), rs, i, C, h)
          )
        )
      )
    ),
    w,
    And::left(cr(A))(w, hw),
    hw,
    w2 => hw2 => Eq::subst(
      y => Red(B, y),
      Eq::sym(subst_up_single(b, sigma, w2)),
      ihb(extend(w2, sigma), i => C => h => redsub_extend_at(sigma, G, A, w2, hw2, rs, i, C, h))
    )
  )
}

pub theorem fundamental<G: List(
  Ty
), t: Tm, A: Ty>(
  h: Typing(G, t, A),
  sigma: (Nat) -> Tm,
  rs: RedSub(sigma, G)
): Red(A, subst(t, sigma)) {
  match h: Red(A, subst(t, sigma)) {
    TVar(G1, i, A1, hv) => rs(i, A1, hv)
    TLam(G1, A1, B1, b, hb) => lam_red(
      A1,
      B1,
      b,
      sigma,
      G1,
      tau => rt => fundamental(hb, tau, rt),
      rs
    )
    TApp(G1, A1, B1, f, a, hf, ha) => fundamental(
      hf,
      sigma,
      rs
    )(subst(a, sigma), fundamental(ha, sigma, rs))
    TStar(G1) => sn_star()
  }
}

pub theorem strong_normalization<G: List(Ty), t: Tm, A: Ty>(h: lc!(`$G |- $t : $A`)): SN(t) {
  sn_of_subst(
    t,
    Tvar,
    And::left(cr(A))(subst(t, Tvar), fundamental(h, Tvar, i => C => hv => red_var(C, i)))
  )
}
