inductive UBox(u: Level, A: Type(u)): Type(u) {
  ubox(value: A): UBox(u, A)
}

theorem small_box(): UBox(0, Nat) { ubox(0, Nat, 3) }
theorem large_box(): UBox(2, Type1) { ubox(2, Type1, Type) }

theorem high_motive(): Type2 {
  recursor(UBox(1), 3)(Type, b => Type2, x => Type1, ubox(1, Type, Nat))
}
