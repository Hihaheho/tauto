// Universe levels: `UBox` takes a universe level `u` and a type `A : Type(u)`
// and lives in `Type(u)`, and its recursor can return a type in a higher universe.

pub(open) inductive UBox(u: Level, A: Type(u)): Type(u) {
  Ubox(value: A): UBox(u, A)
}

pub theorem small_box(): UBox(0, Nat) { Ubox(0, Nat, 3) }
pub theorem large_box(): UBox(2, Type1) { Ubox(2, Type1, Type) }

pub theorem high_motive(): Type2 {
  recursor(UBox(1), 3)(Type, b => Type2, x => Type1, Ubox(1, Type, Nat))
}
