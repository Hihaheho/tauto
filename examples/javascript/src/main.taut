import std::builtin::par
extern {
  fn get(url: Text): Text ! {wait}
  fn apply(f: &((n: i64) -> i64)): i64 ! {wait}
  fn identity<A>(value: A): A
  fn rust_apply(f: &((n: i64) -> i64)): i64
  fn borrow_number(value: &mut i64): &mut i64
  fn adder(n: i64): (i64) -> i64
  fn absolute(n: i64): i64
}
pub(open) effect http_get(url: Text): Text resume 1
pub(open) effect ask(n: i64): i64 resume 1

perform main(() => {
  let response := handle {
    perform http_get("data:text/plain,hello")
  } with {
    http_get(url), k => k(get(url))
  }
  show(&response)
  let result := handle {
    apply((n) => perform ask(n)) + 1
  } with {
    ask(n), k => k(n * 10)
  }
  show(&result)
  show(&absolute(0 - 42))

  show(&identity("hello"))
  var total := 40
  { let borrowed := borrow_number(&mut total); *borrowed := borrowed + 2 }
  show(&total)
  let add := adder(40)
  show(&add(2))
  let native := handle { rust_apply((n) => perform ask(n)) } with {
    ask(n), k => {
      let text := get("data:text/plain,hello"); k(n + if text == "hello" { 5 } else { 0 })
    }
  }
  show(&native)
})
