pub theorem two_plus_two(): Eq(Nat, 2 + 2, 4) {
  Refl(Nat, 4)
}

pub theorem and_swap(A: Prop, B: Prop, p: A ∧ B): B ∧ A {
  AndIntro(And::right(p), And::left(p))
}

pub theorem compose(A: Prop, B: Prop, C: Prop, f: (A) -> B, g: (B) -> C): (A) -> C {
  a => g(f(a))
}

pub axiom em(P: Prop): P ∨ ¬P

pub theorem not_not(P: Prop, n: ¬¬P): P {
  Or::elim(em(P), (p: P) => p, (np: ¬P) => False::elim(n(np)))
}

// A false claim has no proof, but its negation does.
pub theorem two_plus_two_ne_five(h: Eq(Nat, 2 + 2, 5)): False {
  ⊢ False from match h {
  }
}
