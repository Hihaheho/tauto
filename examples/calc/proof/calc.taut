import "../src/calc.taut"
import "../../compiler/proof/compiler.taut"
import "../../../std/Base.taut"
import compiler::compiler

// What the reader does, proved. The tote checks this file before extracting its programs.
// The tree is the `inductive` one `inductive_syntax!(arith, …)` makes (`arith::Expr::I`); `arith::Expr::to_i` turns
// what `arith::parse` read into it, and that step is the one thing here that is not proved.

mutual {
  pub theorem lower_expr_ok(
    e: arith::Expr::I
  ): eval_expr(calc_expr_lower(e)) = calc_expr_val(e) {
    match e: eval_expr(calc_expr_lower(e)) = calc_expr_val(e) {
      Mk(prod, rep) => Eq::trans(
        Eq::congr((x: Nat) => Nat::add(x, eval_expr(calc_sum_lower(rep))), lower_prod_ok(prod)),
        Eq::congr((x: Nat) => Nat::add(calc_prod_val(prod), x), lower_sum_ok(rep))
      )
    }
  }
  pub theorem lower_sum_ok(
    rep: List(arith::Expr_Rep1::I)
  ): eval_expr(calc_sum_lower(rep)) = calc_sum_val(rep) {
    match rep: eval_expr(calc_sum_lower(rep)) = calc_sum_val(rep) {
      Nil => Refl
      Cons(r, more) => Eq::trans(
        Eq::congr((x: Nat) => Nat::add(x, eval_expr(calc_sum_lower(more))), lower_plus_ok(r)),
        Eq::congr((x: Nat) => Nat::add(calc_plus_val(r), x), lower_sum_ok(more))
      )
    }
  }
  pub theorem lower_plus_ok(
    r: arith::Expr_Rep1::I
  ): eval_expr(calc_plus_lower(r)) = calc_plus_val(r) {
    match r: eval_expr(calc_plus_lower(r)) = calc_plus_val(r) {
      Mk(op, prod) => lower_prod_ok(prod)
    }
  }
  pub theorem lower_prod_ok(
    p: arith::Prod::I
  ): eval_expr(calc_prod_lower(p)) = calc_prod_val(p) {
    match p: eval_expr(calc_prod_lower(p)) = calc_prod_val(p) {
      Mk(atom, rep) => Eq::trans(
        Eq::congr((x: Nat) => Nat::mul(x, eval_expr(calc_factor_lower(rep))), lower_atom_ok(atom)),
        Eq::congr((x: Nat) => Nat::mul(calc_atom_val(atom), x), lower_factor_ok(rep))
      )
    }
  }
  pub theorem lower_factor_ok(
    rep: List(arith::Prod_Rep1::I)
  ): eval_expr(calc_factor_lower(rep)) = calc_factor_val(rep) {
    match rep: eval_expr(calc_factor_lower(rep)) = calc_factor_val(rep) {
      Nil => Refl
      Cons(r, more) => Eq::trans(
        Eq::congr((x: Nat) => Nat::mul(x, eval_expr(calc_factor_lower(more))), lower_star_ok(r)),
        Eq::congr((x: Nat) => Nat::mul(calc_star_val(r), x), lower_factor_ok(more))
      )
    }
  }
  pub theorem lower_star_ok(
    r: arith::Prod_Rep1::I
  ): eval_expr(calc_star_lower(r)) = calc_star_val(r) {
    match r: eval_expr(calc_star_lower(r)) = calc_star_val(r) {
      Mk(op, atom) => lower_atom_ok(atom)
    }
  }
  pub theorem lower_atom_ok(
    a: arith::Atom::I
  ): eval_expr(calc_atom_lower(a)) = calc_atom_val(a) {
    match a: eval_expr(calc_atom_lower(a)) = calc_atom_val(a) {
      Num_I(t) => Refl
      Paren_I(p) => lower_paren_ok(p)
    }
  }
  pub theorem lower_paren_ok(
    p: arith::Paren::I
  ): eval_expr(calc_paren_lower(p)) = calc_paren_val(p) {
    match p: eval_expr(calc_paren_lower(p)) = calc_paren_val(p) {
      Mk(l, e, r) => lower_expr_ok(e)
    }
  }
}

// What a text says is what the stack machine leaves: for every tree the reader can make, the compiled
// code never underflows and leaves the value of the tree.
pub theorem calc_run_correct(
  e: arith::Expr::I
): run_code(compile_expr(calc_expr_lower(e)), Nil) = Some(Cons(calc_expr_val(e), Nil)) {
  Eq::trans(
    compile_correct(calc_expr_lower(e)),
    Eq::congr((x: Nat) => Some(Cons(x, Nil)), lower_expr_ok(e))
  )
}

// With constant folding in between, as the program runs it.
pub theorem calc_run_folded_correct(
  e: arith::Expr::I
): run_code(compile_expr(fold_expr(calc_expr_lower(e))), Nil) = Some(Cons(calc_expr_val(e), Nil)) {
  Eq::trans(
    optimized_compile_correct(calc_expr_lower(e)),
    Eq::congr((x: Nat) => Some(Cons(x, Nil)), lower_expr_ok(e))
  )
}
