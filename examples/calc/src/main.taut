import "calc.taut"
import "../../compiler/src/compiler.taut"
import std::prelude::Os

pub fn show_stack(r: Option(List(nat))): Unit {
  match r {
    None => print("stack underflow\n")
    Some(st) => match st {
      Nil => print("empty\n")
      Cons(top, rest) => {
        print(Text::of_nat(top))
        print("\n")
      }
    }
  }
}

pub fn calc_main(src: Text): Unit ! {Div, stdout} {
  print(src)
  print(" => ")
  match arith::parse(src) {
    Err(d) => {
      print("error: ")
      print(d.message)
      print("\n")
    }
    Ok(t) => show_stack(run_code(compile_expr(fold_expr(calc_expr_lower(arith::Expr::to_i(t)))), Nil))
  }
}

calc_main("(2 + 3) * (4 + 5)")
calc_main("1 + 2 * 3")
calc_main("2 + * 3")
