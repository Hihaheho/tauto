import std::prelude::Macro

pub(open) inductive Le(n: Nat): (Nat) -> Prop {
  LeRefl: Le(n, n)
  LeStep<m: Nat>(h: Le(n, m)): Le(n, Succ(m))
}

pub def Lt(n: Nat, m: Nat): Prop := Le(Succ(n), m)

pub(open) inductive Dvd(a: Nat, b: Nat): Prop {
  DvdIntro(k: Nat, h: a * k = b): Dvd(a, b)
}

syntax!(nat, ```par
%start Stmt
%title "nat"
%%
Stmt: Disj [Arrow Stmt];
Disj: Conj { OrTok Conj };
Conj: Rel { AndTok Rel };
Rel: Sum RelTail;
RelTail: EqTail | LeTail | LtTail | DvdTail;
EqTail: Equals Sum;
LeTail: LeTok Sum;
LtTail: LtTok Sum;
DvdTail: Bar Sum;
Sum: Prod { Plus Prod };
Prod: Atom { Star Atom };
Atom: Num | Paren | Embed;
Paren: LParen Sum RParen;
Embed: TautoExpr;
Num: /[0-9]+/;
Equals: '=';
LeTok: '<=';
LtTok: '<';
Bar: '|';
Arrow: '->';
AndTok: 'and';
OrTok: 'or';
Plus: '+';
Star: '*';
LParen: '(';
RParen: ')';
```) => enum Atom, struct Conj, struct Conj_Rep1, struct Disj, struct Disj_Rep1,
  struct DvdTail, struct EqTail, struct LeTail, struct LtTail, struct Paren,
  struct Prod, struct Prod_Rep1, struct Rel, enum RelTail, struct Stmt,
  struct Stmt_Opt1, struct Sum, struct Sum_Rep1, fn parse

pub fn nat_atom(t: nat::Atom): SynExpr ! {macro_error, Div} {
  match t {
    Num(tok) => Syn::nat(tok)
    Paren(p) => nat_sum(p.sum)
    Embed(e) => e
  }
}

pub fn nat_prod_rest(acc: SynExpr, rest: List(nat::Prod_Rep1)): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => {
      let t := nat_atom(r.atom)
      nat_prod_rest(quote { $acc * $t }, more)
    }
  }
}

pub fn nat_prod(p: nat::Prod): SynExpr ! {macro_error, Div} {
  nat_prod_rest(nat_atom(p.atom), p.rep)
}

pub fn nat_sum_rest(acc: SynExpr, rest: List(nat::Sum_Rep1)): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => {
      let t := nat_prod(r.prod)
      nat_sum_rest(quote { $acc + $t }, more)
    }
  }
}

pub fn nat_sum(s: nat::Sum): SynExpr ! {macro_error, Div} {
  nat_sum_rest(nat_prod(s.prod), s.rep)
}

pub fn nat_rel(r: nat::Rel): SynExpr ! {macro_error, Div} {
  let l := nat_sum(r.sum)
  match r.rel_tail {
    EqTail(t) => {
      let x := nat_sum(t.sum)
      quote { Eq(Nat, $l, $x) }
    }
    LeTail(t) => {
      let x := nat_sum(t.sum)
      quote { Le($l, $x) }
    }
    LtTail(t) => {
      let x := nat_sum(t.sum)
      quote { Lt($l, $x) }
    }
    DvdTail(t) => {
      let x := nat_sum(t.sum)
      quote { Dvd($l, $x) }
    }
  }
}

pub fn nat_conj(first: nat::Rel, rest: List(nat::Conj_Rep1)): SynExpr ! {macro_error, Div} {
  let l := nat_rel(first)
  match rest {
    Nil => l
    Cons(r, more) => {
      let x := nat_conj(r.rel, more)
      quote { And($l, $x) }
    }
  }
}

pub fn nat_disj(first: nat::Conj, rest: List(nat::Disj_Rep1)): SynExpr ! {macro_error, Div} {
  let l := nat_conj(first.rel, first.rep)
  match rest {
    Nil => l
    Cons(r, more) => {
      let x := nat_disj(r.conj, more)
      quote { Or($l, $x) }
    }
  }
}

pub macro fn nat(s: nat::Stmt): SynExpr ! {macro_error, Div} {
  let l := nat_disj(s.disj.conj, s.disj.rep)
  match s.opt {
    None => l
    Some(o) => {
      let r := nat(o.stmt)
      ExPi(Cons(SynParam { name: None, ty: l }, Nil), r, None, s.span)
    }
  }
}
