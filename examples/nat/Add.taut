import "Lib.taut"
import "../../std/Tactic.taut"

fn pred(n: Nat) -> Nat {
  match n -> Nat {
    zero => zero
    succ(k) => k
  }
}

theorem succ_inj<a: Nat, b: Nat>(h: Eq(Nat, succ(a), succ(b))): Eq(Nat, a, b) {
  Eq_congr(pred, h)
}

theorem succ_cong<a: Nat, b: Nat>(h: Eq(Nat, a, b)): Eq(Nat, succ(a), succ(b)) {
  Eq_congr(x => succ(x), h)
}

theorem add_zero_r(n: Nat): nat!(`$n + 0 = $n`) {
  match n -> nat!(`$n + 0 = $n`) {
    zero => refl()
    succ(k) => succ_cong(add_zero_r(k))
  }
}

theorem add_succ_r(n: Nat, m: Nat): nat!(`$n + ${succ(m)} = ${succ(n + m)}`) {
  match n -> nat!(`$n + ${succ(m)} = ${succ(n + m)}`) {
    zero => refl()
    succ(k) => succ_cong(add_succ_r(k, m))
  }
}

theorem add_comm(n: Nat, m: Nat): nat!(`$n + $m = $m + $n`) {
  match n -> nat!(`$n + $m = $m + $n`) {
    zero => Eq_sym(add_zero_r(m))
    succ(k) => by rewrite!(add_succ_r(m, k)) -> nat!(`${succ(k)} + $m = $m + ${succ(k)}`) {
      ⊢ nat!(`${succ(k)} + $m = ${succ(m + k)}`) => succ_cong(add_comm(k, m))
    }
  }
}

theorem add_assoc(a: Nat, b: Nat, c: Nat): nat!(`($a + $b) + $c = $a + ($b + $c)`) {
  match a -> nat!(`($a + $b) + $c = $a + ($b + $c)`) {
    zero => refl()
    succ(k) => succ_cong(add_assoc(k, b, c))
  }
}

theorem add_cancel_l(
  a: Nat,
  b: Nat,
  c: Nat,
  h: nat!(`$a + $b = $a + $c`)
): nat!(`$b = $c`) {
  match a -> nat!(`$b = $c`) {
    zero => h
    succ(k) => add_cancel_l(k, b, c, succ_inj(h))
  }
}

theorem add_cancel_r(
  a: Nat,
  b: Nat,
  c: Nat,
  h: nat!(`$a + $c = $b + $c`)
): nat!(`$a = $b`) {
  add_cancel_l(c, a, b, Eq_trans(add_comm(c, a), Eq_trans(h, add_comm(b, c))))
}

theorem add_left_comm(a: Nat, b: Nat, c: Nat): nat!(`$a + ($b + $c) = $b + ($a + $c)`) {
  by nat_norm!(()) -> nat!(`$a + ($b + $c) = $b + ($a + $c)`) {}
}

theorem add_eq_zero_l(a: Nat, b: Nat, e: nat!(`$a + $b = 0`)): nat!(`$a = 0`) {
  match a -> nat!(`$a = 0`) {
    zero => refl()
    succ(k) => Nat_noconf(Eq(Nat, succ(k), 0), succ(k + b), zero, e)
  }
}
