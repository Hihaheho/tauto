import "Lib.taut"
import "Mul.taut"
import "Order.taut"

pub theorem dvd_refl(n: Nat): nat!(`$n | $n`) {
  DvdIntro(1, mul_one_r(n))
}

pub theorem one_dvd(n: Nat): nat!(`1 | $n`) {
  DvdIntro(n, mul_one_l(n))
}

pub theorem dvd_zero(n: Nat): nat!(`$n | 0`) {
  DvdIntro(0, mul_zero_r(n))
}

pub theorem dvd_mul_r(a: Nat, k: Nat): nat!(`$a | $a * $k`) {
  DvdIntro(k, Refl)
}

pub theorem dvd_trans<a: Nat, b: Nat, c: Nat>(
  h1: nat!(`$a | $b`),
  h2: nat!(`$b | $c`)
): nat!(`$a | $c`) {
  match h1: nat!(`$a | $c`) {
    DvdIntro(k, e1) => match h2: nat!(`$a | $c`) {
      DvdIntro(j, e2) => DvdIntro(
        k * j,
        Eq::trans(Eq::sym(mul_assoc(a, k, j)), Eq::trans(Eq::congr(x => x * j, e1), e2))
      )
    }
  }
}

pub theorem dvd_add<a: Nat, b: Nat, c: Nat>(
  h1: nat!(`$a | $b`),
  h2: nat!(`$a | $c`)
): nat!(`$a | $b + $c`) {
  match h1: nat!(`$a | $b + $c`) {
    DvdIntro(k, e1) => match h2: nat!(`$a | $b + $c`) {
      DvdIntro(j, e2) => DvdIntro(
        k + j,
        {
          let s1: nat!(`$a * ($k + $j) = $a * $k + $a * $j`) := mul_add_distrib_l(a, k, j)
          let s2: nat!(`$a * $k + $a * $j = $b + $a * $j`) := Eq::congr(x => x + a * j, e1)
          let s3: nat!(`$b + $a * $j = $b + $c`) := Eq::congr(x => b + x, e2)
          Eq::trans(s1, Eq::trans(s2, s3))
        }
      )
    }
  }
}

pub theorem dvd_mul_right<a: Nat, b: Nat>(c: Nat, h: nat!(`$a | $b`)): nat!(`$a | $b * $c`) {
  match h: nat!(`$a | $b * $c`) {
    DvdIntro(k, e) => DvdIntro(k * c, Eq::trans(Eq::sym(mul_assoc(a, k, c)), Eq::congr(x => x * c, e)))
  }
}

pub theorem dvd_zero_l<n: Nat>(h: nat!(`0 | $n`)): nat!(`0 = $n`) {
  match h: nat!(`0 = $n`) {
    DvdIntro(k, e) => Eq::trans(Eq::sym(mul_zero_l(k)), e)
  }
}

pub theorem le_of_mul_eq_zero(
  a: Nat,
  b: Nat,
  e: nat!(`$a * 0 = $b`),
  p: nat!(`1 <= $b`)
): nat!(`$a <= $b`) {
  let b0: nat!(`$b = 0`) := Eq::trans(Eq::sym(e), mul_zero_r(a))
  let p0: nat!(`1 <= 0`) := Eq::subst(x => nat!(`1 <= $x`), b0, p)
  False::elim(not_succ_le_zero(p0))
}

pub theorem le_of_mul_eq_succ(
  a: Nat,
  j: Nat,
  b: Nat,
  e: nat!(`$a * ${Succ(j)} = $b`)
): nat!(`$a <= $b`) {
  let s1: nat!(`$a <= $a + $a * $j`) := le_add_r(a, a * j)
  let s2: nat!(`$a * ${Succ(j)} = $a + $a * $j`) := mul_succ_r(a, j)
  Eq::subst(x => nat!(`$a <= $x`), e, Eq::subst(x => nat!(`$a <= $x`), Eq::sym(s2), s1))
}

pub theorem le_of_mul_eq(a: Nat, k: Nat, b: Nat): nat!(`$a * $k = $b -> 1 <= $b -> $a <= $b`) {
  match k: nat!(`$a * $k = $b -> 1 <= $b -> $a <= $b`) {
    Zero => e => p => le_of_mul_eq_zero(a, b, e, p)
    Succ(j) => e => p => le_of_mul_eq_succ(a, j, b, e)
  }
}

pub theorem le_of_dvd<a: Nat, b: Nat>(pos: nat!(`1 <= $b`), h: nat!(`$a | $b`)): nat!(`$a <= $b`) {
  match h: nat!(`$a <= $b`) {
    DvdIntro(k, e) => le_of_mul_eq(a, k, b, e, pos)
  }
}
