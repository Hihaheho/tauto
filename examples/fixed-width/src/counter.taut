import std::base
import std::uint

// A byte counter whose step is checked: the proofs see `Option(UInt(8))`, and the
// program runs on Nib's `u8`.
pub fn counter_step(c: UInt(8), r#by: UInt(8)): Option(UInt(8)) {
  UInt::checked_add8(c, r#by)
}

// A step the caller has shown fits: no check at run time.
pub fn counter_bump(
  c: UInt(8),
  r#by: UInt(8),
  h: Nat::lt(Nat::add(UInt::val8(c), UInt::val8(r#by)), 256) = true
): UInt(8) {
  UInt::add8(c, r#by, h)
}

// The caller gives the proof in a function the kernel checks: `200 + 55`
// fits, so `Refl` shows it. Code the kernel does not check, like `main`,
// cannot give one, and calls this instead.
pub fn counter_bump_200_55(): UInt(8) {
  counter_bump(UInt::mk8(200, Refl), UInt::mk8(55, Refl), Refl)
}

pub theorem counter_bump_val(
  c: UInt(8),
  r#by: UInt(8),
  h: Nat::lt(Nat::add(UInt::val8(c), UInt::val8(r#by)), 256) = true
): UInt::val8(counter_bump(c, r#by, h)) = Nat::add(UInt::val8(c), UInt::val8(r#by)) {
  Refl
}

pub theorem counter_step_overflows(): counter_step(UInt::mk8(200, Refl), UInt::mk8(56, Refl)) = None {
  Refl
}

// The same step, with `overflow` caught as `None`: the effect agrees with
// the decision.
pub fn counter_try(c: UInt(8), r#by: UInt(8)): Option(UInt(8)) {
  handle { Some(UInt::add_or_overflow8(c, r#by)) } with {
    overflow() => None
  }
}

pub theorem counter_try_is_step(
  c: UInt(8),
  r#by: UInt(8)
): counter_try(c, r#by) = counter_step(c, r#by) {
  UInt::catch_is8(UInt::checked_add8(c, r#by))
}
