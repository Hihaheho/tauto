import "counter.taut"
import "signed.taut"
import std::sint
import std::uint

// What the checked steps of `counter.taut` and `std/uint.taut` do at run time.
perform main(() => {
  show(&counter_step(U8::of_u64(200), U8::of_u64(55)))
  show(&counter_step(U8::of_u64(200), U8::of_u64(56)))
  show(&counter_bump_200_55())
  show(&UInt::checked_sub8(U8::of_u64(3), U8::of_u64(4)))
  show(&UInt::checked_mul32(U32::of_u64(65535), U32::of_u64(65537)))
  show(&UInt::checked_mul32(U32::of_u64(65536), U32::of_u64(65536)))
  let quarter := U64::of_i64(4611686018427387904)
  show(&UInt::checked_add64(quarter, quarter - 1))
  show(&UInt::checked_mul64(U64::of_u32(U32::of_u64(2147483648)), 2147483648))
  show(&UInt::checked_mul64(quarter, 8))
  show(&UInt::catch8(UInt::checked_add8(U8::of_u64(200), U8::of_u64(56))))
  let saturated := handle { UInt::add_or_overflow8(U8::of_u64(200), U8::of_u64(56)) } with {
    overflow() => U8::of_u64(255)
  }
  show(&saturated)
  let fits := handle { UInt::add_or_overflow8(U8::of_u64(200), U8::of_u64(55)) } with {
    overflow() => U8::of_u64(0)
  }
  show(&fits)
  show(&UInt::wrapping_add8(U8::of_u64(200), U8::of_u64(56)))
  show(&UInt::wrapping_sub32(U32::of_u64(0), U32::of_u64(1)))
  show(&UInt::wrapping_mul64(quarter, 8))
  show(&(Nat::of_u64(quarter) * 16))
  let big: i32 := I32::of_i64(2147483647)
  show(&SInt::checked_add32(big, I32::of_i64(1)))
  show(&SInt::checked_mul32(I32::of_i64(-65536), I32::of_i64(32768)))
  show(&SInt::checked_mul32(I32::of_i64(65536), I32::of_i64(32768)))
  let low: i64 := -9223372036854775807
  show(&SInt::checked_sub64(low, 1))
  show(&SInt::checked_sub64(low - 1, 1))
  show(&signed_step(big, I32::of_i64(1)))
  show(&signed_step(big, I32::of_i64(-7)))
  let top: u64 := 18446744073709551615
  show(&top)
  show(&U64::of_nat(Nat::of_u64(top) - 1))
  let wide: nat := 36893488147419103232
  show(&(wide + 1))
})
