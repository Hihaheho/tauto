import "../../../std/Base.taut"

// A compiler from arithmetic expressions to a stack machine. `proof/compiler.taut` proves
// that running the compiled code leaves the value of the expression on the stack, and that
// constant folding keeps the value.

pub(open) inductive Expr: Type {
  ELit(n: Nat): Expr
  EAdd(a: Expr, b: Expr): Expr
  EMul(a: Expr, b: Expr): Expr
}

pub(open) inductive Instr: Type {
  IPush(n: Nat): Instr
  IAdd: Instr
  IMul: Instr
}

pub fn eval_expr(e: Expr): Nat {
  ⊢ Nat from match e {
    ELit(n) => n
    EAdd(a, b) => Nat::add(eval_expr(a), eval_expr(b))
    EMul(a, b) => Nat::mul(eval_expr(a), eval_expr(b))
  }
}

// Runs `code` on the stack `st` (the top is the head). `None` when an instruction finds
// too few values on the stack.
pub fn run_code(code: List(Instr), st: List(Nat)): Option(List(Nat)) {
  ⊢ Option(List(Nat)) from match code {
    Nil => Some(st)
    Cons(i, rest) => ⊢ Option(List(Nat)) from match i {
      IPush(n) => run_code(rest, Cons(n, st))
      IAdd => ⊢ Option(List(Nat)) from match st {
        Nil => None
        Cons(b, s1) => ⊢ Option(List(Nat)) from match s1 {
          Nil => None
          Cons(a, s2) => run_code(rest, Cons(Nat::add(a, b), s2))
        }
      }
      IMul => ⊢ Option(List(Nat)) from match st {
        Nil => None
        Cons(b, s1) => ⊢ Option(List(Nat)) from match s1 {
          Nil => None
          Cons(a, s2) => run_code(rest, Cons(Nat::mul(a, b), s2))
        }
      }
    }
  }
}

// The code of `e` followed by `k`. (Passing the rest of the code along avoids appending lists.)
pub fn comp_expr(e: Expr, k: List(Instr)): List(Instr) {
  ⊢ List(Instr) from match e {
    ELit(n) => Cons(IPush(n), k)
    EAdd(a, b) => comp_expr(a, comp_expr(b, Cons(IAdd, k)))
    EMul(a, b) => comp_expr(a, comp_expr(b, Cons(IMul, k)))
  }
}

pub fn compile_expr(e: Expr): List(Instr) {
  comp_expr(e, Nil)
}

pub fn fold_add(a: Expr, b: Expr): Expr {
  ⊢ Expr from match a {
    ELit(n) => ⊢ Expr from match b {
      ELit(m) => ELit(Nat::add(n, m))
      EAdd(b1, b2) => EAdd(a, b)
      EMul(b1, b2) => EAdd(a, b)
    }
    EAdd(a1, a2) => EAdd(a, b)
    EMul(a1, a2) => EAdd(a, b)
  }
}

pub fn fold_mul(a: Expr, b: Expr): Expr {
  ⊢ Expr from match a {
    ELit(n) => ⊢ Expr from match b {
      ELit(m) => ELit(Nat::mul(n, m))
      EAdd(b1, b2) => EMul(a, b)
      EMul(b1, b2) => EMul(a, b)
    }
    EAdd(a1, a2) => EMul(a, b)
    EMul(a1, a2) => EMul(a, b)
  }
}

pub fn fold_expr(e: Expr): Expr {
  ⊢ Expr from match e {
    ELit(n) => ELit(n)
    EAdd(a, b) => fold_add(fold_expr(a), fold_expr(b))
    EMul(a, b) => fold_mul(fold_expr(a), fold_expr(b))
  }
}
