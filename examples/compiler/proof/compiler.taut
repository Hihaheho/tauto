import "../../../std/Base.taut"
import "../src/compiler.taut"

// What the compiler does, proved. The tote checks this file before extracting its programs.

pub theorem comp_correct(
  e: Expr,
  k: List(Instr),
  st: List(Nat)
): run_code(comp_expr(e, k), st) = run_code(k, Cons(eval_expr(e), st)) {
  ⊢ run_code(comp_expr(e, k), st) = run_code(k, Cons(eval_expr(e), st)) from match e {
    ELit(n) => Refl
    EAdd(a, b) => Eq::trans(
      comp_correct(a, comp_expr(b, Cons(IAdd, k)), st),
      comp_correct(b, Cons(IAdd, k), Cons(eval_expr(a), st))
    )
    EMul(a, b) => Eq::trans(
      comp_correct(a, comp_expr(b, Cons(IMul, k)), st),
      comp_correct(b, Cons(IMul, k), Cons(eval_expr(a), st))
    )
  }
}

pub theorem compile_correct(
  e: Expr
): run_code(compile_expr(e), Nil) = Some(Cons(eval_expr(e), Nil)) {
  comp_correct(e, Nil, Nil)
}

pub theorem fold_add_correct(
  a: Expr,
  b: Expr
): eval_expr(fold_add(a, b)) = Nat::add(eval_expr(a), eval_expr(b)) {
  ⊢ eval_expr(fold_add(a, b)) = Nat::add(eval_expr(a), eval_expr(b)) from match a {
    ELit(n) => ⊢ eval_expr(fold_add(ELit(n), b)) = Nat::add(n, eval_expr(b)) from match b {
      ELit(m) => Refl
      EAdd(b1, b2) => Refl
      EMul(b1, b2) => Refl
    }
    EAdd(a1, a2) => Refl
    EMul(a1, a2) => Refl
  }
}

pub theorem fold_mul_correct(
  a: Expr,
  b: Expr
): eval_expr(fold_mul(a, b)) = Nat::mul(eval_expr(a), eval_expr(b)) {
  ⊢ eval_expr(fold_mul(a, b)) = Nat::mul(eval_expr(a), eval_expr(b)) from match a {
    ELit(n) => ⊢ eval_expr(fold_mul(ELit(n), b)) = Nat::mul(n, eval_expr(b)) from match b {
      ELit(m) => Refl
      EAdd(b1, b2) => Refl
      EMul(b1, b2) => Refl
    }
    EAdd(a1, a2) => Refl
    EMul(a1, a2) => Refl
  }
}

pub theorem fold_correct(e: Expr): eval_expr(fold_expr(e)) = eval_expr(e) {
  ⊢ eval_expr(fold_expr(e)) = eval_expr(e) from match e {
    ELit(n) => Refl
    EAdd(a, b) => Eq::trans(
      fold_add_correct(fold_expr(a), fold_expr(b)),
      Eq::trans(
        Eq::congr((x: Nat) => Nat::add(x, eval_expr(fold_expr(b))), fold_correct(a)),
        Eq::congr((x: Nat) => Nat::add(eval_expr(a), x), fold_correct(b))
      )
    )
    EMul(a, b) => Eq::trans(
      fold_mul_correct(fold_expr(a), fold_expr(b)),
      Eq::trans(
        Eq::congr((x: Nat) => Nat::mul(x, eval_expr(fold_expr(b))), fold_correct(a)),
        Eq::congr((x: Nat) => Nat::mul(eval_expr(a), x), fold_correct(b))
      )
    )
  }
}

pub theorem optimized_compile_correct(
  e: Expr
): run_code(compile_expr(fold_expr(e)), Nil) = Some(Cons(eval_expr(e), Nil)) {
  Eq::trans(compile_correct(fold_expr(e)), Eq::congr((n: Nat) => Some(Cons(n, Nil)), fold_correct(e)))
}

// Computed: `(2 + 3) * (4 + 5)` is 45 on the machine, and folding leaves the number 45.
pub theorem example_runs(): run_code(compile_expr(EMul(EAdd(ELit(2), ELit(3)), EAdd(ELit(4), ELit(5)))), Nil) = Some(Cons(45, Nil)) {
  Refl
}

pub theorem example_folds(): fold_expr(EMul(EAdd(ELit(2), ELit(3)), EAdd(ELit(4), ELit(5)))) = ELit(45) {
  Refl
}
