import "../std/Row.taut" { Mem, Sub, append }
import "Effects.taut" { Eff, Ty, Width, divEff, exceededEff }
import std::prelude::Std { List, Option }

// A port of lean/Proto/Nib/Typing.lean: the typing of Nib's effects
// (functions, calls, `perform`, `handle`) with its effect rules. A function
// value performs nothing when made; its type carries the row it may perform
// when called. `handle` answers the effects its clauses name; the arms run
// outside the handler. `HasType sg G t A rho` reads "t has type A and
// performs at most rho"; rows are read as sets.

pub(open) inductive Bit: Type { B0: Bit, B1: Bit }

pub(open) inductive Prim: Type {
  Pbudget: Prim
  // `div(a, b)` at a width: integers have no `/`.
  Pdiv(w: Width): Prim
}

// `budget(T, e)(steps: I64, body: () -> T ! {Div} ∪ e) -> T ! {Exceeded(T)} ∪ e`
// with the row variable `e` taken to be `rho`; `div` at `w` is `(w, w) -> w`.
pub fn prim_ty(p: Prim, T: Ty, rho: List(Eff)): Ty {
  ⊢ Ty from match p {
    Pbudget => Tfn([Tint(I64), Tfn(Nil, T, Cons(divEff(), rho))], T, Cons(exceededEff(T), rho))
    Pdiv(w) => Tfn([Tint(w), Tint(w)], Tint(w), Nil)
  }
}

mutual {
  pub(open) inductive Tm: Type {
    Tvar(i: Nat): Tm
    // An integer literal at the width it is used with (a `Nat` here; the Lean
    // model's is an `Int`).
    TintLit(w: Width, n: Nat): Tm
    TboolLit(b: Bit): Tm
    TunitV: Tm
    Tprim(p: Prim, T: Ty, rho: List(Eff)): Tm
    // `(ps) => body`; the parameters are variables `0 … ps.length - 1`.
    Tlam(ps: List(Ty), body: Tm): Tm
    Tapp(f: Tm, args: List(Tm)): Tm
    Tperform(e: Eff, args: List(Tm)): Tm
    Thandle(body: Tm, ret: Option(Tm), clauses: List(Clause)): Tm
  }

  pub(open) inductive Clause: Type {
    Mk(eff: Eff, body: Tm): Clause
  }
}

pub fn eff_of(c: Clause): Eff {
  ⊢ Eff from match c {
    Mk(e, b) => ⊢ Eff from e
  }
}

pub fn clause_effs(cs: List(Clause)): List(Eff) {
  ⊢ List(Eff) from match cs {
    Nil => Nil
    Cons(c, rest) => Cons(eff_of(c), clause_effs(rest))
  }
}

// Declared effects: the parameter types and the result type of the operation.
pub(open) inductive Decl: Type {
  Mk(params: List(Ty), result: Ty): Decl
}

pub def Sig(): Type := (Eff) -> Option(Decl)

pub fn nth(A: Type, l: List(A), i: Nat): Option(A) {
  ⊢ Option(A) from match l {
    Nil => None
    Cons(h, t) => ⊢ Option(A) from match i {
      Zero => Some(h)
      Succ(k) => nth(A, t, k)
    }
  }
}

// A value of type `a` may be put where `t` is expected: it is `t`, or `t` is a
// union that holds `a`. Nothing is converted.
pub(open) inductive Fits: (Ty) -> (Ty) -> Prop {
  FitsRefl(a: Ty): Fits(a, a)
  FitsUnion<a: Ty, ts: List(Ty)>(m: Mem(Ty, a, ts)): Fits(a, Tunion(ts))
}

// Every effect of the body is answered by a clause or kept in the row.
pub def Covers(body: List(Eff), clauses: List(Clause), rho: List(Eff)): Prop :=
∀ e: Eff. (Mem(Eff, e, body)) -> Mem(Eff, e, clause_effs(clauses)) ∨ Mem(Eff, e, rho)

mutual {
  pub(open) inductive HasType(sg: Sig): (List(Ty)) -> (Tm) -> (Ty) -> (List(Eff)) -> Prop {
    HVar(
      G: List(Ty),
      i: Nat,
      A: Ty,
      e: nth(Ty, G, i) = Some(A)
    ): HasType(sg, G, Tvar(i), A, Nil(<A: Eff>))
    HPrim(
      G: List(Ty),
      p: Prim,
      T: Ty,
      rho: List(Eff)
    ): HasType(sg, G, Tprim(p, T, rho), prim_ty(p, T, rho), Nil(<A: Eff>))
    HInt(G: List(Ty), w: Width, n: Nat): HasType(sg, G, TintLit(w, n), Tint(w), Nil(<A: Eff>))
    HBool(G: List(Ty), b: Bit): HasType(sg, G, TboolLit(b), Tbool, Nil(<A: Eff>))
    HUnit(G: List(Ty)): HasType(sg, G, TunitV, Tunit, Nil(<A: Eff>))
    // Making a function performs nothing; the body's row is its latent row.
    HLam(
      G: List(Ty),
      ps: List(Ty),
      body: Tm,
      A: Ty,
      rho: List(Eff),
      h: HasType(sg, append(Ty, ps, G), body, A, rho)
    ): HasType(sg, G, Tlam(ps, body), Tfn(ps, A, rho), Nil(<A: Eff>))
    // A call performs the callee's row, the arguments' rows and the latent row.
    HApp(
      G: List(Ty),
      f: Tm,
      args: List(Tm),
      ps: List(Ty),
      A: Ty,
      rf: List(Eff),
      ra: List(Eff),
      rho: List(Eff),
      hf: HasType(sg, G, f, Tfn(ps, A, rho), rf),
      ha: HasTypes(sg, G, args, ps, ra)
    ): HasType(sg, G, Tapp(f, args), A, append(Eff, append(Eff, rf, ra), rho))
    HPerform(
      G: List(Ty),
      e: Eff,
      args: List(Tm),
      ps: List(Ty),
      R: Ty,
      ra: List(Eff),
      d: sg(e) = Some(Decl::Mk(ps, R)),
      ha: HasTypes(sg, G, args, ps, ra)
    ): HasType(sg, G, Tperform(e, args), R, Cons(e, ra))
    HHandleRet(
      G: List(Ty),
      body: Tm,
      ret: Tm,
      clauses: List(Clause),
      B: Ty,
      T: Ty,
      rb: List(Eff),
      rr: List(Eff),
      rho: List(Eff),
      hb: HasType(sg, G, body, B, rb),
      hr: HasType(sg, Cons(B, G), ret, T, rr),
      sub: Sub(Eff, rr, rho),
      cover: Covers(rb, clauses, rho),
      ok: ∀ c: Clause. (Mem(Clause, c, clauses)) -> ClauseOk(sg, G, T, rho, c)
    ): HasType(sg, G, Thandle(body, Some(ret), clauses), T, rho)
    // `handle` without one: the body's value is the result.
    HHandle(
      G: List(Ty),
      body: Tm,
      clauses: List(Clause),
      B: Ty,
      T: Ty,
      rb: List(Eff),
      rho: List(Eff),
      hb: HasType(sg, G, body, B, rb),
      f: Fits(B, T),
      cover: Covers(rb, clauses, rho),
      ok: ∀ c: Clause. (Mem(Clause, c, clauses)) -> ClauseOk(sg, G, T, rho, c)
    ): HasType(sg, G, Thandle(body, None, clauses), T, rho)
    // A bigger row is also fine.
    HWeaken(
      G: List(Ty),
      t: Tm,
      A: Ty,
      rho: List(Eff),
      rho2: List(Eff),
      h: HasType(sg, G, t, A, rho),
      sub: Sub(Eff, rho, rho2)
    ): HasType(sg, G, t, A, rho2)
  }

  pub(open) inductive HasTypes(sg: Sig): (
    List(Ty)
  ) -> (List(Tm)) -> (List(Ty)) -> (List(Eff)) -> Prop {
    HtNil(G: List(Ty)): HasTypes(sg, G, Nil(<A: Tm>), Nil(<A: Ty>), Nil(<A: Eff>))
    HtCons(
      G: List(Ty),
      t: Tm,
      ts: List(Tm),
      A: Ty,
      As: List(Ty),
      r: List(Eff),
      rs: List(Eff),
      h: HasType(sg, G, t, A, r),
      hs: HasTypes(sg, G, ts, As, rs)
    ): HasTypes(sg, G, Cons(t, ts), Cons(A, As), append(Eff, r, rs))
  }

  // An arm for `e`: it runs outside the handler, with the operation's values
  // and `k : (R) -> T ! rho` in scope, and gives the handle's result type `T`,
  // performing at most the handle's row `rho`.
  pub(open) inductive ClauseOk(sg: Sig): (List(Ty)) -> (Ty) -> (List(Eff)) -> (Clause) -> Prop {
    Mk(
      G: List(Ty),
      T: Ty,
      rho: List(Eff),
      e: Eff,
      body: Tm,
      ps: List(Ty),
      R: Ty,
      ra: List(Eff),
      A: Ty,
      d: sg(e) = Some(Decl::Mk(ps, R)),
      h: HasType(sg, append(Ty, append(Ty, ps, [Tfn([R], T, rho)]), G), body, A, ra),
      f: Fits(A, T),
      sub: Sub(Eff, ra, rho)
    ): ClauseOk(sg, G, T, rho, Clause::Mk(e, body))
  }
}

// A `perform` is in the row of whatever type derivation it has.
pub theorem perform_mem_aux<sg: Sig, G: List(Ty), t: Tm, A: Ty, rho: List(Eff)>(
  h: HasType(sg, G, t, A, rho),
  e: Eff,
  args: List(Tm),
  q: t = Tperform(e, args)
): Mem(Eff, e, rho) {
  ⊢ Mem(Eff, e, rho) from match h {
    HVar(G0, i, A0, d) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HPrim(G0, p, T0, r) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HInt(G0, w, n) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HBool(G0, b) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HUnit(G0) => ⊢ Mem(Eff, e, List::Nil(<A: Eff>)) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HLam(G0, ps, body, A0, r, h0) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HApp(G0, f, args0, ps, A0, rf, ra, r, hf, ha) => ⊢ Mem(
      Eff,
      e,
      append(Eff, append(Eff, rf, ra), r)
    ) from ⊢ Mem(Eff, e, append(Eff, append(Eff, rf, ra), r)) from match q {
    }
    HPerform(G0, e0, args0, ps, R, ra, d, ha) => ⊢ Mem(
      Eff,
      e,
      List::Cons(<A: Eff>, e0, ra)
    ) from ⊢ Mem(Eff, e, Cons(<A: Eff>, e0, ra)) from match q {
      Refl => MemHere(<A: Eff, a: e>, ra)
    }
    HHandleRet(G0, body, ret, cl, B, T0, rb, rr, r, hb, hr, sub, cover, ok) => ⊢ Mem(
      Eff,
      e,
      r
    ) from ⊢ Mem(Eff, e, r) from match q {
    }
    HHandle(G0, body, cl, B, T0, rb, r, hb, f, cover, ok) => ⊢ Mem(
      Eff,
      e,
      r
    ) from ⊢ Mem(Eff, e, r) from match q {
    }
    HWeaken(G0, t0, A0, r0, r1, h0, sub) => ⊢ Mem(
      Eff,
      e,
      r1
    ) from sub(e, perform_mem_aux(h0, e, args, q))
  }
}

pub theorem perform_mem<sg: Sig, G: List(Ty), e: Eff, args: List(Tm), R: Ty, rho: List(Eff)>(
  h: HasType(sg, G, Tperform(e, args), R, rho)
): Mem(Eff, e, rho) {
  perform_mem_aux(h, e, args, Refl)
}

// A handle with no clause answers nothing: the body's `perform` is still in
// its row.
pub theorem unhandled_perform_aux<sg: Sig, G: List(Ty), t: Tm, T: Ty, rho: List(Eff)>(
  h: HasType(sg, G, t, T, rho),
  e: Eff,
  args: List(Tm),
  q: t = Thandle(Tperform(e, args), None, Nil)
): Mem(Eff, e, rho) {
  ⊢ Mem(Eff, e, rho) from match h {
    HVar(G0, i, A0, d) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HPrim(G0, p, T0, r) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HInt(G0, w, n) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HBool(G0, b) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HUnit(G0) => ⊢ Mem(Eff, e, List::Nil(<A: Eff>)) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HLam(G0, ps, body, A0, r, h0) => ⊢ Mem(
      Eff,
      e,
      List::Nil(<A: Eff>)
    ) from ⊢ Mem(Eff, e, Nil(<A: Eff>)) from match q {
    }
    HApp(G0, f, args0, ps, A0, rf, ra, r, hf, ha) => ⊢ Mem(
      Eff,
      e,
      append(Eff, append(Eff, rf, ra), r)
    ) from ⊢ Mem(Eff, e, append(Eff, append(Eff, rf, ra), r)) from match q {
    }
    HPerform(G0, e0, args0, ps, R, ra, d, ha) => ⊢ Mem(
      Eff,
      e,
      List::Cons(<A: Eff>, e0, ra)
    ) from ⊢ Mem(Eff, e, Cons(<A: Eff>, e0, ra)) from match q {
    }
    HHandleRet(G0, body, ret, cl, B, T0, rb, rr, r, hb, hr, sub, cover, ok) => ⊢ Mem(
      Eff,
      e,
      r
    ) from ⊢ Mem(Eff, e, r) from match q {
    }
    HHandle(G0, body, cl, B, T0, rb, r, hb, f, cover, ok) => ⊢ Mem(
      Eff,
      e,
      r
    ) from ⊢ Mem(Eff, e, r) from match q {
      Refl => ⊢ Mem(Eff, e, r) from match cover(e, perform_mem(hb)) {
        OrInl(a) => Mem::nil(Mem(Eff, e, r), a)
        OrInr(a) => a
      }
    }
    HWeaken(G0, t0, A0, r0, r1, h0, sub) => ⊢ Mem(
      Eff,
      e,
      r1
    ) from sub(e, unhandled_perform_aux(h0, e, args, q))
  }
}

pub theorem unhandled_perform<sg: Sig, G: List(Ty), e: Eff, args: List(Tm), T: Ty, rho: List(Eff)>(
  h: HasType(sg, G, Thandle(Tperform(e, args), None, Nil), T, rho)
): Mem(Eff, e, rho) {
  unhandled_perform_aux(h, e, args, Refl)
}
