import "Renaming.taut" { upR }
import std::prelude::Std { List, Option }

// A port of lean/Proto/Core.lean, in tauto, in five parts: terms, renaming and
// substitution; typing; substitution preserves typing; reduction and
// preservation; progress. Every `fn` here is a structural recursion compiled to
// an eliminator.

// ---- part 1: terms, renaming and substitution -------------------------------
// The checks at the end of this part are computations the kernel runs.

pub(open) inductive Ty: Type {
  Tnat: Ty
  Tbool: Ty
  Arr(a: Ty, b: Ty): Ty
}

pub(open) inductive Tm: Type {
  Tvar(i: Nat): Tm
  Lam(A: Ty, b: Tm): Tm
  App(f: Tm, a: Tm): Tm
  Tzero: Tm
  Tsucc(n: Tm): Tm
  NatRec(A: Ty, z: Tm, s: Tm, n: Tm): Tm
  Tt: Tm
  Ff: Tm
  Ite(c: Tm, t: Tm, e: Tm): Tm
}

pub fn ren(t: Tm, xi: (Nat) -> Nat): Tm {
  ⊢ Tm from match t {
    Tvar(i) => Tvar(xi(i))
    Lam(A, b) => Lam(A, ren(b, upR(xi)))
    App(f, a) => App(ren(f, xi), ren(a, xi))
    Tzero => Tzero
    Tsucc(n) => Tsucc(ren(n, xi))
    NatRec(A, z, s, n) => NatRec(A, ren(z, xi), ren(s, xi), ren(n, xi))
    Tt => Tt
    Ff => Ff
    Ite(c, t1, e) => Ite(ren(c, xi), ren(t1, xi), ren(e, xi))
  }
}

pub fn up(sigma: (Nat) -> Tm, n: Nat): Tm {
  ⊢ Tm from match n {
    Zero => Tvar(Zero)
    Succ(m) => ren(sigma(m), Succ)
  }
}

pub fn subst(t: Tm, sigma: (Nat) -> Tm): Tm {
  ⊢ Tm from match t {
    Tvar(i) => sigma(i)
    Lam(A, b) => Lam(A, subst(b, up(sigma)))
    App(f, a) => App(subst(f, sigma), subst(a, sigma))
    Tzero => Tzero
    Tsucc(n) => Tsucc(subst(n, sigma))
    NatRec(A, z, s, n) => NatRec(A, subst(z, sigma), subst(s, sigma), subst(n, sigma))
    Tt => Tt
    Ff => Ff
    Ite(c, t1, e) => Ite(subst(c, sigma), subst(t1, sigma), subst(e, sigma))
  }
}

pub fn single(a: Tm, n: Nat): Tm {
  ⊢ Tm from match n {
    Zero => a
    Succ(m) => Tvar(m)
  }
}

pub theorem ren_var(): ren(Tvar(0), Succ) = Tvar(1) { Refl }

pub theorem ren_under_lam(): ren(Lam(Tnat, Tvar(0)), Succ) = Lam(Tnat, Tvar(0)) {
  Refl
}

pub theorem beta_by_substitution(): subst(Tvar(0), single(Tt)) = Tt { Refl }

pub fn nth(G: List(Ty), i: Nat): Option(Ty) {
  ⊢ Option(Ty) from match G {
    Nil => None(<A: Ty>)
    Cons(h, t) => ⊢ Option(Ty) from match i {
      Zero => Some(<A: Ty>, h)
      Succ(m) => nth(t, m)
    }
  }
}

pub(open) inductive HasType: (List(Ty), Tm, Ty) -> Prop {
  Hvar<G: List(Ty), i: Nat, A: Ty>(h: nth(G, i) = Some(<A: Ty>, A)): HasType(G, Tvar(i), A)
  Hlam<G: List(Ty), A: Ty, B: Ty, b: Tm>(
    h: HasType(Cons(<A: Ty>, A, G), b, B)
  ): HasType(G, Lam(A, b), Arr(A, B))
  Happ<G: List(Ty), A: Ty, B: Ty, f: Tm, a: Tm>(
    hf: HasType(G, f, Arr(A, B)),
    ha: HasType(G, a, A)
  ): HasType(G, App(f, a), B)
  Hzero(G: List(Ty)): HasType(G, Tzero, Tnat)
  Hsucc<G: List(Ty), n: Tm>(h: HasType(G, n, Tnat)): HasType(G, Tsucc(n), Tnat)
  Hnatrec<G: List(Ty), A: Ty, z: Tm, s: Tm, n: Tm>(
    hz: HasType(G, z, A),
    hs: HasType(G, s, Arr(Tnat, Arr(A, A))),
    hn: HasType(G, n, Tnat)
  ): HasType(G, NatRec(A, z, s, n), A)
  Htt(G: List(Ty)): HasType(G, Tt, Tbool)
  Hff(G: List(Ty)): HasType(G, Ff, Tbool)
  Hite<G: List(Ty), A: Ty, c: Tm, t: Tm, e: Tm>(
    hc: HasType(G, c, Tbool),
    ht: HasType(G, t, A),
    he: HasType(G, e, A)
  ): HasType(G, Ite(c, t, e), A)
}

pub def RenOk(xi: (Nat) -> Nat, G: List(Ty), D: List(Ty)): Prop :=
∀ i: Nat, A: Ty. (nth(G, i) = Some(<A: Ty>, A)) -> (nth(D, xi(i)) = Some(<A: Ty>, A))

pub theorem RenOk_up_at<xi: (Nat) -> Nat, G: List(Ty), D: List(Ty), A: Ty>(
  r: RenOk(xi, G, D),
  i: Nat,
  B: Ty,
  e: nth(Cons(<A: Ty>, A, G), i) = Some(<A: Ty>, B)
): nth(Cons(<A: Ty>, A, D), upR(xi, i)) = Some(<A: Ty>, B) {
  ⊢ nth(Cons(<A: Ty>, A, D), upR(xi, i)) = Some(<A: Ty>, B) from match i {
    Zero => e
    Succ(m) => r(m, B, e)
  }
}

pub theorem RenOk_up<xi: (Nat) -> Nat, G: List(Ty), D: List(Ty)>(
  A: Ty,
  r: RenOk(xi, G, D)
): RenOk(upR(xi), Cons(<A: Ty>, A, G), Cons(<A: Ty>, A, D)) {
  i => B => e => RenOk_up_at(r, i, B, e)
}

pub theorem ren_typing<G: List(Ty), t: Tm, A: Ty>(
  h: HasType(G, t, A),
  xi: (Nat) -> Nat,
  D: List(Ty),
  r: RenOk(xi, G, D)
): HasType(D, ren(t, xi), A) {
  ⊢ HasType(D, ren(t, xi), A) from match h {
    Hvar(G1, i, A1, e) => ⊢ HasType(D, ren(Tm::Tvar(i), xi), A1) from Hvar(r(i, A1, e))
    Hlam(G1, A1, B1, b, hb) => ⊢ HasType(
      D,
      ren(Tm::Lam(A1, b), xi),
      Ty::Arr(A1, B1)
    ) from Hlam(ren_typing(hb, upR(xi), Cons(<A: Ty>, A1, D), RenOk_up(A1, r)))
    Happ<G: G2, A: A3, B: B4, f: f5, a: a6>(hf, ha) => ⊢ HasType(
      D,
      ren(Tm::App(f5, a6), xi),
      B4
    ) from Happ(ren_typing(hf, xi, D, r), ren_typing(ha, xi, D, r))
    Hzero(G1) => ⊢ HasType(D, ren(Tm::Tzero, xi), Ty::Tnat) from Hzero(D)
    Hsucc<G: G7, n: n8>(hn) => ⊢ HasType(
      D,
      ren(Tm::Tsucc(n8), xi),
      Ty::Tnat
    ) from Hsucc(ren_typing(hn, xi, D, r))
    Hnatrec<G: G9, A: A10, z: z11, s: s12, n: n13>(hz, hs, hn) => ⊢ HasType(
      D,
      ren(Tm::NatRec(A10, z11, s12, n13), xi),
      A10
    ) from Hnatrec(ren_typing(hz, xi, D, r), ren_typing(hs, xi, D, r), ren_typing(hn, xi, D, r))
    Htt(G1) => ⊢ HasType(D, ren(Tm::Tt, xi), Ty::Tbool) from Htt(D)
    Hff(G1) => ⊢ HasType(D, ren(Tm::Ff, xi), Ty::Tbool) from Hff(D)
    Hite<G: G14, A: A15, c: c16, t: t17, e: e18>(hc, ht, he) => ⊢ HasType(
      D,
      ren(Tm::Ite(c16, t17, e18), xi),
      A15
    ) from Hite(ren_typing(hc, xi, D, r), ren_typing(ht, xi, D, r), ren_typing(he, xi, D, r))
  }
}

pub fn unwrap_or(o: Option(Ty), d: Ty): Ty {
  ⊢ Ty from match o {
    None => d
    Some(x) => x
  }
}

pub theorem some_inj<A: Ty, B: Ty>(e: Some(<A: Ty>, A) = Some(<A: Ty>, B)): A = B {
  Eq::congr(⟦unwrap_or(□, A)⟧, e)
}

pub theorem RenOk_succ(D: List(Ty), A: Ty): RenOk(Succ, D, Cons(<A: Ty>, A, D)) {
  i => B => e => e
}

pub def SubstOk(sigma: (Nat) -> Tm, G: List(Ty), D: List(Ty)): Prop :=
∀ i: Nat, A: Ty. (nth(G, i) = Some(<A: Ty>, A)) -> HasType(D, sigma(i), A)

pub theorem SubstOk_up_at<sigma: (Nat) -> Tm, G: List(Ty), D: List(Ty), A: Ty>(
  s: SubstOk(sigma, G, D),
  i: Nat,
  B: Ty,
  e: nth(Cons(<A: Ty>, A, G), i) = Some(<A: Ty>, B)
): HasType(Cons(<A: Ty>, A, D), up(sigma, i), B) {
  ⊢ HasType(Cons(<A: Ty>, A, D), up(sigma, i), B) from match i {
    Zero => Hvar(<G: Cons(<A: Ty>, A, D), i: Zero, A: B>, e)
    Succ(m) => ren_typing(s(m, B, e), Succ, Cons(<A: Ty>, A, D), RenOk_succ(D, A))
  }
}

pub theorem SubstOk_up<sigma: (Nat) -> Tm, G: List(Ty), D: List(Ty)>(
  A: Ty,
  s: SubstOk(sigma, G, D)
): SubstOk(up(sigma), Cons(<A: Ty>, A, G), Cons(<A: Ty>, A, D)) {
  i => B => e => SubstOk_up_at(s, i, B, e)
}

pub theorem subst_typing<G: List(Ty), t: Tm, A: Ty>(
  h: HasType(G, t, A),
  sigma: (Nat) -> Tm,
  D: List(Ty),
  s: SubstOk(sigma, G, D)
): HasType(D, subst(t, sigma), A) {
  ⊢ HasType(D, subst(t, sigma), A) from match h {
    Hvar(G1, i, A1, e) => ⊢ HasType(D, subst(Tm::Tvar(i), sigma), A1) from s(i, A1, e)
    Hlam(G1, A1, B1, b, hb) => ⊢ HasType(
      D,
      subst(Tm::Lam(A1, b), sigma),
      Ty::Arr(A1, B1)
    ) from Hlam(subst_typing(hb, up(sigma), Cons(<A: Ty>, A1, D), SubstOk_up(A1, s)))
    Happ<G: G19, A: A20, B: B21, f: f22, a: a23>(hf, ha) => ⊢ HasType(
      D,
      subst(Tm::App(f22, a23), sigma),
      B21
    ) from Happ(subst_typing(hf, sigma, D, s), subst_typing(ha, sigma, D, s))
    Hzero(G1) => ⊢ HasType(D, subst(Tm::Tzero, sigma), Ty::Tnat) from Hzero(D)
    Hsucc<G: G24, n: n25>(hn) => ⊢ HasType(
      D,
      subst(Tm::Tsucc(n25), sigma),
      Ty::Tnat
    ) from Hsucc(subst_typing(hn, sigma, D, s))
    Hnatrec<G: G26, A: A27, z: z28, s: s29, n: n30>(hz, hs, hn) => ⊢ HasType(
      D,
      subst(Tm::NatRec(A27, z28, s29, n30), sigma),
      A27
    ) from Hnatrec(
      subst_typing(hz, sigma, D, s),
      subst_typing(hs, sigma, D, s),
      subst_typing(hn, sigma, D, s)
    )
    Htt(G1) => ⊢ HasType(D, subst(Tm::Tt, sigma), Ty::Tbool) from Htt(D)
    Hff(G1) => ⊢ HasType(D, subst(Tm::Ff, sigma), Ty::Tbool) from Hff(D)
    Hite<G: G31, A: A32, c: c33, t: t34, e: e35>(hc, ht, he) => ⊢ HasType(
      D,
      subst(Tm::Ite(c33, t34, e35), sigma),
      A32
    ) from Hite(
      subst_typing(hc, sigma, D, s),
      subst_typing(ht, sigma, D, s),
      subst_typing(he, sigma, D, s)
    )
  }
}

pub theorem SubstOk_single_at<G: List(Ty), A: Ty, a: Tm>(
  ha: HasType(G, a, A),
  i: Nat,
  B: Ty,
  e: nth(Cons(<A: Ty>, A, G), i) = Some(<A: Ty>, B)
): HasType(G, single(a, i), B) {
  ⊢ HasType(G, single(a, i), B) from match i {
    Zero => Eq::subst(<A: Ty, a: A, b: B>, y => HasType(G, a, y), some_inj(e), ha)
    Succ(m) => Hvar(<G: G, i: m, A: B>, e)
  }
}

pub theorem subst_single_typing<G: List(Ty), A: Ty, B: Ty, b: Tm, a: Tm>(
  hb: HasType(Cons(<A: Ty>, A, G), b, B),
  ha: HasType(G, a, A)
): HasType(G, subst(b, single(a)), B) {
  subst_typing(hb, single(a), G, i => C => e => SubstOk_single_at(ha, i, C, e))
}

pub(open) inductive Value: (Tm) -> Prop {
  Vlam(A: Ty, b: Tm): Value(Lam(A, b))
  Vzero: Value(Tzero)
  Vsucc<n: Tm>(h: Value(n)): Value(Tsucc(n))
  Vtt: Value(Tt)
  Vff: Value(Ff)
}

pub(open) inductive Step: (Tm, Tm) -> Prop {
  AppL<f: Tm, f2: Tm>(a: Tm, s: Step(f, f2)): Step(App(f, a), App(f2, a))
  AppR<f: Tm, a: Tm, a2: Tm>(v: Value(f), s: Step(a, a2)): Step(App(f, a), App(f, a2))
  Beta(A: Ty, b: Tm, a: Tm, v: Value(a)): Step(App(Lam(A, b), a), subst(b, single(a)))
  Sstep<n: Tm, n2: Tm>(s: Step(n, n2)): Step(Tsucc(n), Tsucc(n2))
  RecN(
    A: Ty,
    z: Tm,
    s1: Tm,
    n: Tm,
    n2: Tm,
    s: Step(n, n2)
  ): Step(NatRec(A, z, s1, n), NatRec(A, z, s1, n2))
  RecZ(A: Ty, z: Tm, s1: Tm): Step(NatRec(A, z, s1, Tzero), z)
  RecS(
    A: Ty,
    z: Tm,
    s1: Tm,
    n: Tm,
    v: Value(n)
  ): Step(NatRec(A, z, s1, Tsucc(n)), App(App(s1, n), NatRec(A, z, s1, n)))
  IteC<c: Tm, c2: Tm>(t1: Tm, e1: Tm, s: Step(c, c2)): Step(Ite(c, t1, e1), Ite(c2, t1, e1))
  IteT(t1: Tm, e1: Tm): Step(Ite(Tt, t1, e1), t1)
  IteF(t1: Tm, e1: Tm): Step(Ite(Ff, t1, e1), e1)
}

// Inversion of a typing derivation, by computation on the term: each case is
// a continuation-passing statement of what the derivation must contain.
pub def InvVar(G: List(Ty), i: Nat, A: Ty): Prop :=
nth(G, i) = Some(<A: Ty>, A)

pub def InvLam(G: List(Ty), A1: Ty, b: Tm, A: Ty): Prop :=
∀ C: Prop. (∀ B: Ty. (A = Arr(A1, B)) -> (HasType(Cons(<A: Ty>, A1, G), b, B)) -> C) -> C

pub def InvApp(G: List(Ty), f: Tm, a: Tm, A: Ty): Prop :=
∀ C: Prop. (∀ B: Ty. (HasType(G, f, Arr(B, A))) -> (HasType(G, a, B)) -> C) -> C

pub def InvSucc(G: List(Ty), n: Tm, A: Ty): Prop :=
∀ C: Prop. ((A = Tnat) -> (HasType(G, n, Tnat)) -> C) -> C

pub def InvRec(G: List(Ty), A1: Ty, z: Tm, s1: Tm, n: Tm, A: Ty): Prop :=
∀ C: Prop. (
  (A = A1) -> (
    HasType(G, z, A1)
  ) -> (HasType(G, s1, Arr(Tnat, Arr(A1, A1)))) -> (HasType(G, n, Tnat)) -> C
) -> C

pub def InvIte(G: List(Ty), c: Tm, t1: Tm, e1: Tm, A: Ty): Prop :=
∀ C: Prop. ((HasType(G, c, Tbool)) -> (HasType(G, t1, A)) -> (HasType(G, e1, A)) -> C) -> C

pub def InvIs(A: Ty, B: Ty): Prop := A = B

pub fn Inv(t: Tm, G: List(Ty), A: Ty): Prop {
  ⊢ Prop from match t {
    Tvar(i) => InvVar(G, i, A)
    Lam(A1, b) => InvLam(G, A1, b, A)
    App(f, a) => InvApp(G, f, a, A)
    Tzero => InvIs(A, Tnat)
    Tsucc(n) => InvSucc(G, n, A)
    NatRec(A1, z, s1, n) => InvRec(G, A1, z, s1, n, A)
    Tt => InvIs(A, Tbool)
    Ff => InvIs(A, Tbool)
    Ite(c, t1, e1) => InvIte(G, c, t1, e1, A)
  }
}

pub theorem inversion<G: List(Ty), t: Tm, A: Ty>(h: HasType(G, t, A)): Inv(t, G, A) {
  ⊢ Inv(t, G, A) from match h {
    Hvar<G: G36, i: i37, A: A38>(e) => ⊢ Inv(Tm::Tvar(i37), G36, A38) from e
    Hlam(G1, A1, B1, b, hb) => ⊢ Inv(Tm::Lam(A1, b), G1, Ty::Arr(A1, B1)) from C => k => k(
      B1,
      Refl,
      hb
    )
    Happ(G1, A1, B1, f, a, hf, ha) => ⊢ Inv(Tm::App(f, a), G1, B1) from C => k => k(A1, hf, ha)
    Hzero(G1) => ⊢ Inv(Tm::Tzero, G1, Ty::Tnat) from Refl
    Hsucc<G: G39, n: n40>(hn) => ⊢ Inv(Tm::Tsucc(n40), G39, Ty::Tnat) from C => k => k(Refl, hn)
    Hnatrec(G1, A1, z, s1, n, hz, hs, hn) => ⊢ Inv(Tm::NatRec(A1, z, s1, n), G1, A1) from C => k => k(
      Refl,
      hz,
      hs,
      hn
    )
    Htt(G1) => ⊢ Inv(Tm::Tt, G1, Ty::Tbool) from Refl
    Hff(G1) => ⊢ Inv(Tm::Ff, G1, Ty::Tbool) from Refl
    Hite<G: G41, A: A42, c: c43, t: t44, e: e45>(hc, ht, he) => ⊢ Inv(Tm::Ite(c43, t44, e45), G41, A42) from C => k => k(
      hc,
      ht,
      he
    )
  }
}

pub theorem cast_type<G: List(Ty), t: Tm, A: Ty, B: Ty>(
  e: A = B,
  h: HasType(G, t, A)
): HasType(G, t, B) {
  Eq::subst(<A: Ty, a: A, b: B>, y => HasType(G, t, y), e, h)
}

pub fn dom(x: Ty, d: Ty): Ty {
  ⊢ Ty from match x {
    Tnat => d
    Tbool => d
    Arr(a, b) => a
  }
}

pub fn cod(x: Ty, d: Ty): Ty {
  ⊢ Ty from match x {
    Tnat => d
    Tbool => d
    Arr(a, b) => b
  }
}

pub theorem arr_dom<a: Ty, b: Ty, c: Ty, d: Ty>(e: Arr(a, b) = Arr(c, d)): a = c {
  Eq::congr(⟦dom(□, a)⟧, e)
}

pub theorem arr_cod<a: Ty, b: Ty, c: Ty, d: Ty>(e: Arr(a, b) = Arr(c, d)): b = d {
  Eq::congr(⟦cod(□, b)⟧, e)
}

pub theorem preservation<t: Tm, t2: Tm>(
  s: Step(t, t2),
  G: List(Ty),
  A: Ty,
  h: HasType(G, t, A)
): HasType(G, t2, A) {
  ⊢ HasType(G, t2, A) from match s {
    AppL(f, f2, a, sf) => ⊢ HasType(
      G,
      Tm::App(f2, a),
      A
    ) from inversion(
      G,
      App(f, a),
      A,
      h,
      HasType(G, App(f2, a), A),
      B => hf => ha => Happ(preservation(sf, G, Arr(B, A), hf), ha)
    )
    AppR(f, a, a2, vf, sa) => ⊢ HasType(
      G,
      Tm::App(f, a2),
      A
    ) from inversion(
      G,
      App(f, a),
      A,
      h,
      HasType(G, App(f, a2), A),
      B => hf => ha => Happ(hf, preservation(sa, G, B, ha))
    )
    Beta(A1, b, a, va) => ⊢ HasType(
      G,
      subst(b, single(a)),
      A
    ) from inversion(
      G,
      App(Lam(A1, b), a),
      A,
      h,
      HasType(G, subst(b, single(a)), A),
      B => hf => ha => inversion(
        G,
        Lam(A1, b),
        Arr(B, A),
        hf,
        HasType(G, subst(b, single(a)), A),
        B2 => eq => hb => cast_type(
          Eq::sym(<A: Ty, a: A, b: B2>, arr_cod(eq)),
          subst_single_typing(hb, cast_type(arr_dom(eq), ha))
        )
      )
    )
    Sstep(n, n2, sn) => ⊢ HasType(
      G,
      Tm::Tsucc(n2),
      A
    ) from inversion(
      G,
      Tsucc(n),
      A,
      h,
      HasType(G, Tsucc(n2), A),
      eq => hn => cast_type(
        Eq::sym(<A: Ty, a: A, b: Tnat>, eq),
        Hsucc(preservation(sn, G, Tnat, hn))
      )
    )
    RecN(A1, z, s1, n, n2, sn) => ⊢ HasType(
      G,
      Tm::NatRec(A1, z, s1, n2),
      A
    ) from inversion(
      G,
      NatRec(A1, z, s1, n),
      A,
      h,
      HasType(G, NatRec(A1, z, s1, n2), A),
      eq => hz => hs => hn => cast_type(
        Eq::sym(<A: Ty, a: A, b: A1>, eq),
        Hnatrec(hz, hs, preservation(sn, G, Tnat, hn))
      )
    )
    RecZ(A1, z, s1) => ⊢ HasType(
      G,
      z,
      A
    ) from inversion(
      G,
      NatRec(A1, z, s1, Tzero),
      A,
      h,
      HasType(G, z, A),
      eq => hz => hs => hn => cast_type(Eq::sym(<A: Ty, a: A, b: A1>, eq), hz)
    )
    RecS(A1, z, s1, n, vn) => ⊢ HasType(
      G,
      Tm::App(Tm::App(s1, n), Tm::NatRec(A1, z, s1, n)),
      A
    ) from inversion(
      G,
      NatRec(A1, z, s1, Tsucc(n)),
      A,
      h,
      HasType(G, App(App(s1, n), NatRec(A1, z, s1, n)), A),
      eq => hz => hs => hn => inversion(
        G,
        Tsucc(n),
        Tnat,
        hn,
        HasType(G, App(App(s1, n), NatRec(A1, z, s1, n)), A),
        eq2 => hn2 => cast_type(
          Eq::sym(<A: Ty, a: A, b: A1>, eq),
          Happ(Happ(hs, hn2), Hnatrec(hz, hs, hn2))
        )
      )
    )
    IteC(c, c2, t1, e1, sc) => ⊢ HasType(
      G,
      Tm::Ite(c2, t1, e1),
      A
    ) from inversion(
      G,
      Ite(c, t1, e1),
      A,
      h,
      HasType(G, Ite(c2, t1, e1), A),
      hc => ht => he => Hite(preservation(sc, G, Tbool, hc), ht, he)
    )
    IteT(t1, e1) => ⊢ HasType(
      G,
      t1,
      A
    ) from inversion(G, Ite(Tt, t1, e1), A, h, HasType(G, t1, A), hc => ht => he => ht)
    IteF(t1, e1) => ⊢ HasType(
      G,
      e1,
      A
    ) from inversion(G, Ite(Ff, t1, e1), A, h, HasType(G, e1, A), hc => ht => he => he)
  }
}

pub(open) inductive Steps(t: Tm): Prop {
  StepsTo<t2: Tm>(s: Step(t, t2)): Steps(t)
}

pub def Prog(t: Tm): Prop := Value(t) ∨ Steps(t)

pub theorem steps_elim<t: Tm>(C: Prop, st: Steps(t), k: ∀ t2: Tm. (Step(t, t2)) -> C): C {
  Steps::ind(<t: t>, w => C, t2 => s => k(t2, s), st)
}

pub theorem prog_val<t: Tm>(v: Value(t)): Prog(t) {
  OrInl(<A: Value(t), B: Steps(t)>, v)
}

pub theorem prog_step<t: Tm, t2: Tm>(s: Step(t, t2)): Prog(t) {
  OrInr(<A: Value(t), B: Steps(t)>, StepsTo(s))
}

pub fn isNatTy(x: Ty): Prop {
  ⊢ Prop from match x {
    Tnat => True
    Tbool => False
    Arr(a, b) => False
  }
}

pub fn isBoolTy(x: Ty): Prop {
  ⊢ Prop from match x {
    Tnat => False
    Tbool => True
    Arr(a, b) => False
  }
}

pub theorem ne_nat_bool(e: Tnat = Tbool): False {
  Eq::subst(<A: Ty, a: Tnat, b: Tbool>, y => isNatTy(y), e, Trivial)
}

pub theorem ne_nat_arr<a: Ty, b: Ty>(e: Tnat = Arr(a, b)): False {
  Eq::subst(<A: Ty, a: Tnat, b: Arr(a, b)>, y => isNatTy(y), e, Trivial)
}

pub theorem ne_bool_arr<a: Ty, b: Ty>(e: Tbool = Arr(a, b)): False {
  Eq::subst(<A: Ty, a: Tbool, b: Arr(a, b)>, y => isBoolTy(y), e, Trivial)
}

pub fn isNoneO(o: Option(Ty)): Prop {
  ⊢ Prop from match o {
    None => True
    Some(x) => False
  }
}

pub theorem nil_no_var<G: List(Ty), i: Nat, A: Ty>(
  e: G = Nil(<A: Ty>),
  eh: nth(G, i) = Some(<A: Ty>, A)
): False {
  Eq::subst(
    <A: Option(Ty), a: None(<A: Ty>), b: Some(<A: Ty>, A)>,
    o => isNoneO(o),
    Eq::subst(<A: List(Ty), a: G, b: Nil(<A: Ty>)>, y => nth(y, i) = Some(<A: Ty>, A), e, eh),
    Trivial
  )
}

pub def CanonArr(f: Tm): Prop :=
∀ C: Prop. ((∀ A2: Ty, b: Tm. (f = Lam(A2, b)) -> C)) -> C

pub def CanonNat(n: Tm): Prop :=
∀ C: Prop. ((n = Tzero) -> C) -> (∀ m: Tm. (Value(m)) -> (n = Tsucc(m)) -> C) -> C

pub def CanonBool(c: Tm): Prop :=
∀ C: Prop. ((c = Tt) -> C) -> ((c = Ff) -> C) -> C

pub theorem canon_arr<f: Tm>(
  v: Value(f),
  G: List(Ty),
  A1: Ty,
  B1: Ty,
  h: HasType(G, f, Arr(A1, B1))
): CanonArr(f) {
  ⊢ CanonArr(f) from match v {
    Vlam(A, b) => ⊢ CanonArr(Tm::Lam(A, b)) from C => k => k(A, b, Refl)
    Vzero => ⊢ CanonArr(Tm::Tzero) from False::elim(
      <P: CanonArr(Tzero)>,
      ne_nat_arr(Eq::sym(<A: Ty, a: Arr(A1, B1), b: Tnat>, inversion(h)))
    )
    Vsucc(n, vn) => ⊢ CanonArr(
      Tm::Tsucc(n)
    ) from inversion(
      G,
      Tsucc(n),
      Arr(A1, B1),
      h,
      CanonArr(Tsucc(n)),
      eq => hn => False::elim(
        <P: CanonArr(Tsucc(n))>,
        ne_nat_arr(Eq::sym(<A: Ty, a: Arr(A1, B1), b: Tnat>, eq))
      )
    )
    Vtt => ⊢ CanonArr(Tm::Tt) from False::elim(
      <P: CanonArr(Tt)>,
      ne_bool_arr(Eq::sym(<A: Ty, a: Arr(A1, B1), b: Tbool>, inversion(h)))
    )
    Vff => ⊢ CanonArr(Tm::Ff) from False::elim(
      <P: CanonArr(Ff)>,
      ne_bool_arr(Eq::sym(<A: Ty, a: Arr(A1, B1), b: Tbool>, inversion(h)))
    )
  }
}

pub theorem canon_nat<n: Tm>(v: Value(n), G: List(Ty), h: HasType(G, n, Tnat)): CanonNat(n) {
  ⊢ CanonNat(n) from match v {
    Vlam(A, b) => ⊢ CanonNat(
      Tm::Lam(A, b)
    ) from inversion(
      G,
      Lam(A, b),
      Tnat,
      h,
      CanonNat(Lam(A, b)),
      B2 => eq => hb => False::elim(<P: CanonNat(Lam(A, b))>, ne_nat_arr(eq))
    )
    Vzero => ⊢ CanonNat(Tm::Tzero) from C => k1 => k2 => k1(Refl)
    Vsucc(m, vm) => ⊢ CanonNat(Tm::Tsucc(m)) from C => k1 => k2 => k2(m, vm, Refl)
    Vtt => ⊢ CanonNat(Tm::Tt) from False::elim(<P: CanonNat(Tt)>, ne_nat_bool(inversion(h)))
    Vff => ⊢ CanonNat(Tm::Ff) from False::elim(<P: CanonNat(Ff)>, ne_nat_bool(inversion(h)))
  }
}

pub theorem canon_bool<c: Tm>(v: Value(c), G: List(Ty), h: HasType(G, c, Tbool)): CanonBool(c) {
  ⊢ CanonBool(c) from match v {
    Vlam(A, b) => ⊢ CanonBool(
      Tm::Lam(A, b)
    ) from inversion(
      G,
      Lam(A, b),
      Tbool,
      h,
      CanonBool(Lam(A, b)),
      B2 => eq => hb => False::elim(<P: CanonBool(Lam(A, b))>, ne_bool_arr(eq))
    )
    Vzero => ⊢ CanonBool(Tm::Tzero) from False::elim(
      <P: CanonBool(Tzero)>,
      ne_nat_bool(Eq::sym(<A: Ty, a: Tbool, b: Tnat>, inversion(h)))
    )
    Vsucc(m, vm) => ⊢ CanonBool(
      Tm::Tsucc(m)
    ) from inversion(
      G,
      Tsucc(m),
      Tbool,
      h,
      CanonBool(Tsucc(m)),
      eq => hm => False::elim(
        <P: CanonBool(Tsucc(m))>,
        ne_nat_bool(Eq::sym(<A: Ty, a: Tbool, b: Tnat>, eq))
      )
    )
    Vtt => ⊢ CanonBool(Tm::Tt) from C => k1 => k2 => k1(Refl)
    Vff => ⊢ CanonBool(Tm::Ff) from C => k1 => k2 => k2(Refl)
  }
}

pub theorem progress<G: List(Ty), t: Tm, A: Ty>(h: HasType(G, t, A), e: G = Nil(<A: Ty>)): Prog(t) {
  ⊢ Prog(t) from match h {
    Hvar(G1, i, A1, eh) => ⊢ Prog(
      Tm::Tvar(i)
    ) from False::elim(<P: Prog(Tvar(i))>, nil_no_var(e, eh))
    Hlam(G1, A1, B1, b, hb) => ⊢ Prog(Tm::Lam(A1, b)) from prog_val(Vlam(A1, b))
    Happ(G1, A1, B1, f, a, hf, ha) => ⊢ Prog(
      Tm::App(f, a)
    ) from Or::elim(
      Value(f),
      Steps(f),
      Prog(App(f, a)),
      progress(hf, e),
      vf => Or::elim(
        Value(a),
        Steps(a),
        Prog(App(f, a)),
        progress(ha, e),
        va => canon_arr(
          f,
          vf,
          G1,
          A1,
          B1,
          hf,
          Prog(App(f, a)),
          A2 => b => eqf => prog_step(
            Eq::subst(
              <A: Tm, a: Lam(A2, b), b: f>,
              y => Step(App(y, a), subst(b, single(a))),
              Eq::sym(<A: Tm, a: f, b: Lam(A2, b)>, eqf),
              Beta(A2, b, a, va)
            )
          )
        ),
        sa => steps_elim(Prog(App(f, a)), sa, a2 => s2 => prog_step(AppR(vf, s2)))
      ),
      sf => steps_elim(Prog(App(f, a)), sf, f2 => s2 => prog_step(AppL(a, s2)))
    )
    Hzero(G1) => ⊢ Prog(Tm::Tzero) from prog_val(Vzero)
    Hsucc(G1, n, hn) => ⊢ Prog(
      Tm::Tsucc(n)
    ) from Or::elim(
      Value(n),
      Steps(n),
      Prog(Tsucc(n)),
      progress(hn, e),
      vn => prog_val(Vsucc(vn)),
      sn => steps_elim(Prog(Tsucc(n)), sn, n2 => s2 => prog_step(Sstep(s2)))
    )
    Hnatrec(G1, A1, z, s1, n, hz, hs, hn) => ⊢ Prog(
      Tm::NatRec(A1, z, s1, n)
    ) from Or::elim(
      Value(n),
      Steps(n),
      Prog(NatRec(A1, z, s1, n)),
      progress(hn, e),
      vn => canon_nat(
        n,
        vn,
        G1,
        hn,
        Prog(NatRec(A1, z, s1, n)),
        eq0 => prog_step(
          Eq::subst(
            <A: Tm, a: Tzero, b: n>,
            y => Step(NatRec(A1, z, s1, y), z),
            Eq::sym(<A: Tm, a: n, b: Tzero>, eq0),
            RecZ(A1, z, s1)
          )
        ),
        m => vm => eqs => prog_step(
          Eq::subst(
            <A: Tm, a: Tsucc(m), b: n>,
            y => Step(NatRec(A1, z, s1, y), App(App(s1, m), NatRec(A1, z, s1, m))),
            Eq::sym(<A: Tm, a: n, b: Tsucc(m)>, eqs),
            RecS(A1, z, s1, m, vm)
          )
        )
      ),
      sn => steps_elim(
        Prog(NatRec(A1, z, s1, n)),
        sn,
        n2 => s2 => prog_step(RecN(A1, z, s1, n, n2, s2))
      )
    )
    Htt(G1) => ⊢ Prog(Tm::Tt) from prog_val(Vtt)
    Hff(G1) => ⊢ Prog(Tm::Ff) from prog_val(Vff)
    Hite(G1, A1, c, t1, e1, hc, ht, he) => ⊢ Prog(
      Tm::Ite(c, t1, e1)
    ) from Or::elim(
      Value(c),
      Steps(c),
      Prog(Ite(c, t1, e1)),
      progress(hc, e),
      vc => canon_bool(
        c,
        vc,
        G1,
        hc,
        Prog(Ite(c, t1, e1)),
        eqt => prog_step(
          Eq::subst(
            <A: Tm, a: Tt, b: c>,
            y => Step(Ite(y, t1, e1), t1),
            Eq::sym(<A: Tm, a: c, b: Tt>, eqt),
            IteT(t1, e1)
          )
        ),
        eqf => prog_step(
          Eq::subst(
            <A: Tm, a: Ff, b: c>,
            y => Step(Ite(y, t1, e1), e1),
            Eq::sym(<A: Tm, a: c, b: Ff>, eqf),
            IteF(t1, e1)
          )
        )
      ),
      sc => steps_elim(Prog(Ite(c, t1, e1)), sc, c2 => s2 => prog_step(IteC(t1, e1, s2)))
    )
  }
}

pub theorem type_safety<t: Tm, t2: Tm>(
  s: Step(t, t2),
  A: Ty,
  h: HasType(Nil(<A: Ty>), t, A)
): HasType(Nil(<A: Ty>), t2, A) ∧ Prog(t2) {
  AndIntro(
    <A: HasType(Nil(<A: Ty>), t2, A), B: Prog(t2)>,
    preservation(s, Nil(<A: Ty>), A, h),
    progress(preservation(s, Nil(<A: Ty>), A, h), Refl)
  )
}
