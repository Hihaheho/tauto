import "Kernel.taut" { KTm, Kinst, Klift, Kren, Ksingle, Ksubst, Kup }
import "Renaming.taut" { upR, upR_pw }
import "../std/Calc.taut" { calc }

// The algebra of renaming and substitution for lean/Proto/Kernel/Syntax.lean.
// There is no function extensionality in tauto, so every lemma is stated
// up to a pointwise equal renaming or substitution: `rho(i) = xi(zeta(i))`
// for all `i`, rather than `rho = xi ∘ zeta`.

pub theorem eq_Kpi<A: KTm, A2: KTm, B: KTm, B2: KTm>(
  e1: A = A2,
  e2: B = B2
): Kpi(A, B) = Kpi(A2, B2) {
  ⊢ Kpi(A, B) = Kpi(A2, B2) from match e1 {
    Refl => Eq::congr(⟦Kpi(A, □)⟧, e2)
  }
}

pub theorem eq_Klam<b: KTm, b2: KTm>(e: b = b2): Klam(b) = Klam(b2) {
  Eq::congr(⟦Klam(□)⟧, e)
}

pub theorem eq_Kapp<f: KTm, f2: KTm, a: KTm, a2: KTm>(
  e1: f = f2,
  e2: a = a2
): Kapp(f, a) = Kapp(f2, a2) {
  ⊢ Kapp(f, a) = Kapp(f2, a2) from match e1 {
    Refl => Eq::congr(⟦Kapp(f, □)⟧, e2)
  }
}

pub theorem eq_Ksucc<n: KTm, n2: KTm>(e: n = n2): Ksucc(n) = Ksucc(n2) {
  Eq::congr(⟦Ksucc(□)⟧, e)
}

pub theorem eq_KnatRec<P: KTm, P2: KTm, z: KTm, z2: KTm, s: KTm, s2: KTm, n: KTm, n2: KTm>(
  e1: P = P2,
  e2: z = z2,
  e3: s = s2,
  e4: n = n2
): KnatRec(P, z, s, n) = KnatRec(P2, z2, s2, n2) {
  ⊢ KnatRec(P, z, s, n) = KnatRec(P2, z2, s2, n2) from match e1 {
    Refl => ⊢ KnatRec(P, z, s, n) = KnatRec(P, z2, s2, n2) from match e2 {
      Refl => ⊢ KnatRec(P, z, s, n) = KnatRec(P, z, s2, n2) from match e3 {
        Refl => Eq::congr(⟦KnatRec(P, z, s, □)⟧, e4)
      }
    }
  }
}

pub theorem ren_pw(
  t: KTm,
  xi: (Nat) -> Nat,
  zeta: (Nat) -> Nat,
  h: ∀ i: Nat. xi(i) = zeta(i)
): Kren(t, xi) = Kren(t, zeta) {
  ⊢ Kren(t, xi) = Kren(t, zeta) from match t {
    Kvar(i) => Eq::congr(Kvar, h(i))
    Ksort(n) => Refl
    Kpi(A, B) => eq_Kpi(ren_pw(A, xi, zeta, h), ren_pw(B, upR(xi), upR(zeta), upR_pw(xi, zeta, h)))
    Klam(b) => eq_Klam(ren_pw(b, upR(xi), upR(zeta), upR_pw(xi, zeta, h)))
    Kapp(f, a) => eq_Kapp(ren_pw(f, xi, zeta, h), ren_pw(a, xi, zeta, h))
    Knat => Refl
    Kzero => Refl
    Ksucc(n) => eq_Ksucc(ren_pw(n, xi, zeta, h))
    KnatRec(P, z, s, n) => eq_KnatRec(
      ren_pw(P, xi, zeta, h),
      ren_pw(z, xi, zeta, h),
      ren_pw(s, xi, zeta, h),
      ren_pw(n, xi, zeta, h)
    )
  }
}

pub theorem up_pw_at(
  sigma: (Nat) -> KTm,
  tau: (Nat) -> KTm,
  h: ∀ i: Nat. sigma(i) = tau(i),
  i: Nat
): Kup(sigma, i) = Kup(tau, i) {
  ⊢ Kup(sigma, i) = Kup(tau, i) from match i {
    Zero => Refl
    Succ(m) => Eq::congr(⟦Kren(□, Succ)⟧, h(m))
  }
}

pub theorem up_pw(
  sigma: (Nat) -> KTm,
  tau: (Nat) -> KTm,
  h: ∀ i: Nat. sigma(i) = tau(i)
): ∀ i: Nat. Kup(sigma, i) = Kup(tau, i) {
  i => up_pw_at(sigma, tau, h, i)
}

pub theorem subst_pw(
  t: KTm,
  sigma: (Nat) -> KTm,
  tau: (Nat) -> KTm,
  h: ∀ i: Nat. sigma(i) = tau(i)
): Ksubst(t, sigma) = Ksubst(t, tau) {
  ⊢ Ksubst(t, sigma) = Ksubst(t, tau) from match t {
    Kvar(i) => h(i)
    Ksort(n) => Refl
    Kpi(A, B) => eq_Kpi(
      subst_pw(A, sigma, tau, h),
      subst_pw(B, Kup(sigma), Kup(tau), up_pw(sigma, tau, h))
    )
    Klam(b) => eq_Klam(subst_pw(b, Kup(sigma), Kup(tau), up_pw(sigma, tau, h)))
    Kapp(f, a) => eq_Kapp(subst_pw(f, sigma, tau, h), subst_pw(a, sigma, tau, h))
    Knat => Refl
    Kzero => Refl
    Ksucc(n) => eq_Ksucc(subst_pw(n, sigma, tau, h))
    KnatRec(P, z, s, n) => eq_KnatRec(
      subst_pw(P, sigma, tau, h),
      subst_pw(z, sigma, tau, h),
      subst_pw(s, sigma, tau, h),
      subst_pw(n, sigma, tau, h)
    )
  }
}

pub theorem rr_up_at(
  xi: (Nat) -> Nat,
  zeta: (Nat) -> Nat,
  rho: (Nat) -> Nat,
  h: ∀ i: Nat. rho(i) = xi(zeta(i)),
  i: Nat
): upR(rho, i) = upR(xi, upR(zeta, i)) {
  ⊢ upR(rho, i) = upR(xi, upR(zeta, i)) from match i {
    Zero => Refl
    Succ(m) => Eq::congr(Succ, h(m))
  }
}

pub theorem rr_up(
  xi: (Nat) -> Nat,
  zeta: (Nat) -> Nat,
  rho: (Nat) -> Nat,
  h: ∀ i: Nat. rho(i) = xi(zeta(i))
): ∀ i: Nat. upR(rho, i) = upR(xi, upR(zeta, i)) {
  i => rr_up_at(xi, zeta, rho, h, i)
}

pub theorem sr_up_at(
  sigma: (Nat) -> KTm,
  xi: (Nat) -> Nat,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = sigma(xi(i)),
  i: Nat
): Kup(rho, i) = Kup(sigma, upR(xi, i)) {
  ⊢ Kup(rho, i) = Kup(sigma, upR(xi, i)) from match i {
    Zero => Refl
    Succ(m) => Eq::congr(⟦Kren(□, Succ)⟧, h(m))
  }
}

pub theorem sr_up(
  sigma: (Nat) -> KTm,
  xi: (Nat) -> Nat,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = sigma(xi(i))
): ∀ i: Nat. Kup(rho, i) = Kup(sigma, upR(xi, i)) {
  i => sr_up_at(sigma, xi, rho, h, i)
}

pub theorem sv_up_at(
  sigma: (Nat) -> KTm,
  h: ∀ i: Nat. sigma(i) = Kvar(i),
  i: Nat
): Kup(sigma, i) = Kvar(i) {
  ⊢ Kup(sigma, i) = Kvar(i) from match i {
    Zero => Refl
    Succ(m) => Eq::congr(⟦Kren(□, Succ)⟧, h(m))
  }
}

pub theorem sv_up(
  sigma: (Nat) -> KTm,
  h: ∀ i: Nat. sigma(i) = Kvar(i)
): ∀ i: Nat. Kup(sigma, i) = Kvar(i) {
  i => sv_up_at(sigma, h, i)
}

pub theorem ren_ren(
  t: KTm,
  xi: (Nat) -> Nat,
  zeta: (Nat) -> Nat,
  rho: (Nat) -> Nat,
  h: ∀ i: Nat. rho(i) = xi(zeta(i))
): Kren(Kren(t, zeta), xi) = Kren(t, rho) {
  ⊢ Kren(Kren(t, zeta), xi) = Kren(t, rho) from match t {
    Kvar(i) => Eq::congr(Kvar, Eq::sym(h(i)))
    Ksort(n) => Refl
    Kpi(A, B) => eq_Kpi(
      ren_ren(A, xi, zeta, rho, h),
      ren_ren(B, upR(xi), upR(zeta), upR(rho), rr_up(xi, zeta, rho, h))
    )
    Klam(b) => eq_Klam(ren_ren(b, upR(xi), upR(zeta), upR(rho), rr_up(xi, zeta, rho, h)))
    Kapp(f, a) => eq_Kapp(ren_ren(f, xi, zeta, rho, h), ren_ren(a, xi, zeta, rho, h))
    Knat => Refl
    Kzero => Refl
    Ksucc(n) => eq_Ksucc(ren_ren(n, xi, zeta, rho, h))
    KnatRec(P, z, s, n) => eq_KnatRec(
      ren_ren(P, xi, zeta, rho, h),
      ren_ren(z, xi, zeta, rho, h),
      ren_ren(s, xi, zeta, rho, h),
      ren_ren(n, xi, zeta, rho, h)
    )
  }
}

pub theorem subst_ren(
  t: KTm,
  sigma: (Nat) -> KTm,
  xi: (Nat) -> Nat,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = sigma(xi(i))
): Ksubst(Kren(t, xi), sigma) = Ksubst(t, rho) {
  ⊢ Ksubst(Kren(t, xi), sigma) = Ksubst(t, rho) from match t {
    Kvar(i) => Eq::sym(h(i))
    Ksort(n) => Refl
    Kpi(A, B) => eq_Kpi(
      subst_ren(A, sigma, xi, rho, h),
      subst_ren(B, Kup(sigma), upR(xi), Kup(rho), sr_up(sigma, xi, rho, h))
    )
    Klam(b) => eq_Klam(subst_ren(b, Kup(sigma), upR(xi), Kup(rho), sr_up(sigma, xi, rho, h)))
    Kapp(f, a) => eq_Kapp(subst_ren(f, sigma, xi, rho, h), subst_ren(a, sigma, xi, rho, h))
    Knat => Refl
    Kzero => Refl
    Ksucc(n) => eq_Ksucc(subst_ren(n, sigma, xi, rho, h))
    KnatRec(P, z, s, n) => eq_KnatRec(
      subst_ren(P, sigma, xi, rho, h),
      subst_ren(z, sigma, xi, rho, h),
      subst_ren(s, sigma, xi, rho, h),
      subst_ren(n, sigma, xi, rho, h)
    )
  }
}

pub theorem subst_var(
  t: KTm,
  sigma: (Nat) -> KTm,
  h: ∀ i: Nat. sigma(i) = Kvar(i)
): Ksubst(t, sigma) = t {
  ⊢ Ksubst(t, sigma) = t from match t {
    Kvar(i) => h(i)
    Ksort(n) => Refl
    Kpi(A, B) => eq_Kpi(subst_var(A, sigma, h), subst_var(B, Kup(sigma), sv_up(sigma, h)))
    Klam(b) => eq_Klam(subst_var(b, Kup(sigma), sv_up(sigma, h)))
    Kapp(f, a) => eq_Kapp(subst_var(f, sigma, h), subst_var(a, sigma, h))
    Knat => Refl
    Kzero => Refl
    Ksucc(n) => eq_Ksucc(subst_var(n, sigma, h))
    KnatRec(P, z, s, n) => eq_KnatRec(
      subst_var(P, sigma, h),
      subst_var(z, sigma, h),
      subst_var(s, sigma, h),
      subst_var(n, sigma, h)
    )
  }
}

pub theorem rs_up_at(
  xi: (Nat) -> Nat,
  sigma: (Nat) -> KTm,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = Kren(sigma(i), xi),
  i: Nat
): Kup(rho, i) = Kren(Kup(sigma, i), upR(xi)) {
  ⊢ Kup(rho, i) = Kren(Kup(sigma, i), upR(xi)) from match i {
    Zero => Refl
    Succ(m) => Eq::trans(
      Eq::congr(⟦Kren(□, Succ)⟧, h(m)),
      Eq::trans(
        ren_ren(sigma(m), Succ, xi, j => Succ(xi(j)), j => Refl),
        Eq::sym(ren_ren(sigma(m), upR(xi), Succ, j => Succ(xi(j)), j => Refl))
      )
    )
  }
}

pub theorem rs_up(
  xi: (Nat) -> Nat,
  sigma: (Nat) -> KTm,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = Kren(sigma(i), xi)
): ∀ i: Nat. Kup(rho, i) = Kren(Kup(sigma, i), upR(xi)) {
  i => rs_up_at(xi, sigma, rho, h, i)
}

pub theorem ren_subst(
  t: KTm,
  xi: (Nat) -> Nat,
  sigma: (Nat) -> KTm,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = Kren(sigma(i), xi)
): Kren(Ksubst(t, sigma), xi) = Ksubst(t, rho) {
  ⊢ Kren(Ksubst(t, sigma), xi) = Ksubst(t, rho) from match t {
    Kvar(i) => Eq::sym(h(i))
    Ksort(n) => Refl
    Kpi(A, B) => eq_Kpi(
      ren_subst(A, xi, sigma, rho, h),
      ren_subst(B, upR(xi), Kup(sigma), Kup(rho), rs_up(xi, sigma, rho, h))
    )
    Klam(b) => eq_Klam(ren_subst(b, upR(xi), Kup(sigma), Kup(rho), rs_up(xi, sigma, rho, h)))
    Kapp(f, a) => eq_Kapp(ren_subst(f, xi, sigma, rho, h), ren_subst(a, xi, sigma, rho, h))
    Knat => Refl
    Kzero => Refl
    Ksucc(n) => eq_Ksucc(ren_subst(n, xi, sigma, rho, h))
    KnatRec(P, z, s, n) => eq_KnatRec(
      ren_subst(P, xi, sigma, rho, h),
      ren_subst(z, xi, sigma, rho, h),
      ren_subst(s, xi, sigma, rho, h),
      ren_subst(n, xi, sigma, rho, h)
    )
  }
}

pub theorem ss_up_at(
  tau: (Nat) -> KTm,
  sigma: (Nat) -> KTm,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = Ksubst(sigma(i), tau),
  i: Nat
): Kup(rho, i) = Ksubst(Kup(sigma, i), Kup(tau)) {
  ⊢ Kup(rho, i) = Ksubst(Kup(sigma, i), Kup(tau)) from match i {
    Zero => Refl
    Succ(m) => Eq::trans(
      Eq::congr(⟦Kren(□, Succ)⟧, h(m)),
      Eq::trans(
        ren_subst(sigma(m), Succ, tau, j => Kren(tau(j), Succ), j => Refl),
        Eq::sym(subst_ren(sigma(m), Kup(tau), Succ, j => Kren(tau(j), Succ), j => Refl))
      )
    )
  }
}

pub theorem ss_up(
  tau: (Nat) -> KTm,
  sigma: (Nat) -> KTm,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = Ksubst(sigma(i), tau)
): ∀ i: Nat. Kup(rho, i) = Ksubst(Kup(sigma, i), Kup(tau)) {
  i => ss_up_at(tau, sigma, rho, h, i)
}

pub theorem subst_subst(
  t: KTm,
  tau: (Nat) -> KTm,
  sigma: (Nat) -> KTm,
  rho: (Nat) -> KTm,
  h: ∀ i: Nat. rho(i) = Ksubst(sigma(i), tau)
): Ksubst(Ksubst(t, sigma), tau) = Ksubst(t, rho) {
  ⊢ Ksubst(Ksubst(t, sigma), tau) = Ksubst(t, rho) from match t {
    Kvar(i) => Eq::sym(h(i))
    Ksort(n) => Refl
    Kpi(A, B) => eq_Kpi(
      subst_subst(A, tau, sigma, rho, h),
      subst_subst(B, Kup(tau), Kup(sigma), Kup(rho), ss_up(tau, sigma, rho, h))
    )
    Klam(b) => eq_Klam(subst_subst(b, Kup(tau), Kup(sigma), Kup(rho), ss_up(tau, sigma, rho, h)))
    Kapp(f, a) => eq_Kapp(subst_subst(f, tau, sigma, rho, h), subst_subst(a, tau, sigma, rho, h))
    Knat => Refl
    Kzero => Refl
    Ksucc(n) => eq_Ksucc(subst_subst(n, tau, sigma, rho, h))
    KnatRec(P, z, s, n) => eq_KnatRec(
      subst_subst(P, tau, sigma, rho, h),
      subst_subst(z, tau, sigma, rho, h),
      subst_subst(s, tau, sigma, rho, h),
      subst_subst(n, tau, sigma, rho, h)
    )
  }
}

// ---- the instances the typing rules use ------------------------------------------

pub theorem subst_single_lift(t: KTm, a: KTm): Kinst(Klift(t), a) = t {
  calc!(```
    $Kinst(Klift(t), a)
    = $Ksubst(t, Kvar) from $subst_ren(t, Ksingle(a), Succ, Kvar, j => Refl)
    = $t from $subst_var(t, Kvar, j => Refl)
    ```)
}

pub theorem ren_lift(t: KTm, xi: (Nat) -> Nat): Kren(Klift(t), upR(xi)) = Klift(Kren(t, xi)) {
  calc!(```
    $Kren(Klift(t), upR(xi))
    = $Kren(t, j => Succ(xi(j))) from $ren_ren(t, upR(xi), Succ, j => Succ(xi(j)), j => Refl)
    = $Klift(Kren(t, xi)) from $Eq::sym(ren_ren(t, Succ, xi, j => Succ(xi(j)), j => Refl))
    ```)
}

pub theorem subst_lift(
  sigma: (Nat) -> KTm,
  t: KTm
): Ksubst(Klift(t), Kup(sigma)) = Klift(Ksubst(t, sigma)) {
  calc!(```
    $Ksubst(Klift(t), Kup(sigma))
    = $Ksubst(
      t,
      j => Kren(sigma(j), Succ)
    ) from $subst_ren(t, Kup(sigma), Succ, j => Kren(sigma(j), Succ), j => Refl)
    = $Klift(
      Ksubst(t, sigma)
    ) from $Eq::sym(ren_subst(t, Succ, sigma, j => Kren(sigma(j), Succ), j => Refl))
    ```)
}

pub theorem ri_h(
  xi: (Nat) -> Nat,
  a: KTm,
  j: Nat
): Kren(Ksingle(a, j), xi) = Ksingle(Kren(a, xi), upR(xi, j)) {
  ⊢ Kren(Ksingle(a, j), xi) = Ksingle(Kren(a, xi), upR(xi, j)) from match j {
    Zero => Refl
    Succ(m) => Refl
  }
}

pub theorem ren_inst(
  xi: (Nat) -> Nat,
  b: KTm,
  a: KTm
): Kren(Kinst(b, a), xi) = Kinst(Kren(b, upR(xi)), Kren(a, xi)) {
  Eq::trans(
    ren_subst(b, xi, Ksingle(a), j => Kren(Ksingle(a, j), xi), j => Refl),
    Eq::sym(
      subst_ren(b, Ksingle(Kren(a, xi)), upR(xi), j => Kren(Ksingle(a, j), xi), j => ri_h(xi, a, j))
    )
  )
}

pub theorem si_h(
  sigma: (Nat) -> KTm,
  a: KTm,
  j: Nat
): Ksubst(Ksingle(a, j), sigma) = Ksubst(Kup(sigma, j), Ksingle(Ksubst(a, sigma))) {
  ⊢ Ksubst(Ksingle(a, j), sigma) = Ksubst(Kup(sigma, j), Ksingle(Ksubst(a, sigma))) from match j {
    Zero => Refl
    Succ(m) => Eq::sym(subst_single_lift(sigma(m), Ksubst(a, sigma)))
  }
}

pub theorem subst_inst(
  sigma: (Nat) -> KTm,
  b: KTm,
  a: KTm
): Ksubst(Kinst(b, a), sigma) = Kinst(Ksubst(b, Kup(sigma)), Ksubst(a, sigma)) {
  Eq::trans(
    subst_subst(b, sigma, Ksingle(a), j => Ksubst(Ksingle(a, j), sigma), j => Refl),
    Eq::sym(
      subst_subst(
        b,
        Ksingle(Ksubst(a, sigma)),
        Kup(sigma),
        j => Ksubst(Ksingle(a, j), sigma),
        j => si_h(sigma, a, j)
      )
    )
  )
}
