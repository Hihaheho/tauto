import "../std/Row.taut" { append }
import "../std/Std.taut" { plus }
import std::prelude::Std { List }

// A port of lean/Proto/Choice.lean and lean/Proto/Budget.lean: a shared,
// resumable step budget for multi-shot branching. `Choose` stores the rest of
// the computation in a function of the answer; the machine evaluates both
// resumptions. One global budget serves the whole search machine, so
// duplicating a continuation does not duplicate fuel, and running `n + m`
// steps is running `n` and then resuming for `m`.

pub(open) inductive Bit: Type { B0: Bit, B1: Bit }

pub(open) inductive ChoiceTree(A: Type): Type {
  Pure(value: A): ChoiceTree(A)
  Choose(r#resume: (Bit) -> ChoiceTree(A)): ChoiceTree(A)
}

pub(open) inductive Machine(A: Type): Type {
  Mk(pending: List(ChoiceTree(A)), answers: List(A)): Machine(A)
}

pub fn start(A: Type, tree: ChoiceTree(A)): Machine(A) {
  Machine::Mk(Cons(tree, Nil), Nil)
}

pub fn step(A: Type, s: Machine(A)): Machine(A) {
  ⊢ Machine(A) from match s {
    Mk(p, ans) => ⊢ Machine(A) from match p {
      Nil => Machine::Mk(Nil, ans)
      Cons(t, rest) => ⊢ Machine(A) from match t {
        Pure(v) => Machine::Mk(rest, append(A, ans, Cons(v, Nil)))
        Choose(k) => Machine::Mk(Cons(k(B0), Cons(k(B1), rest)), ans)
      }
    }
  }
}

// Execute at most `fuel` steps; steps after completion do nothing.
pub fn advance(A: Type, fuel: Nat, s: Machine(A)): Machine(A) {
  ⊢ Machine(A) from match fuel {
    Zero => s
    Succ(n) => advance(A, n, step(A, s))
  }
}

pub theorem advance_add<A: Type>(
  n: Nat,
  m: Nat,
  s: Machine(A)
): advance(A, plus(n, m), s) = advance(A, m, advance(A, n, s)) {
  ⊢ advance(A, plus(n, m), s) = advance(A, m, advance(A, n, s)) from match n {
    Zero => Refl
    Succ(k) => advance_add(k, m, step(A, s))
  }
}

pub theorem step_complete<A: Type>(
  answers: List(A)
): step(A, Machine::Mk(Nil, answers)) = Machine::Mk(Nil, answers) {
  Refl
}

pub theorem advance_complete<A: Type>(
  n: Nat,
  answers: List(A)
): advance(A, n, Machine::Mk(Nil, answers)) = Machine::Mk(Nil, answers) {
  ⊢ advance(A, n, Machine::Mk(Nil, answers)) = Machine::Mk(Nil, answers) from match n {
    Zero => Refl
    Succ(k) => advance_complete(k, answers)
  }
}

pub fn pick(b: Bit): Nat {
  ⊢ Nat from match b { B0 => 1, B1 => 2 }
}

pub fn sample(): ChoiceTree(Nat) {
  Choose(b => Pure(pick(b)))
}

pub fn answers_of(A: Type, m: Machine(A)): List(A) {
  ⊢ List(A) from match m {
    Mk(p, a) => a
  }
}

pub fn pending_of(A: Type, m: Machine(A)): List(ChoiceTree(A)) {
  ⊢ List(ChoiceTree(A)) from match m {
    Mk(p, a) => p
  }
}

pub fn length(A: Type, l: List(A)): Nat {
  ⊢ Nat from match l {
    Nil => 0
    Cons(h, t) => Succ(length(A, t))
  }
}

pub theorem one_step_queues_two(): length(
  ChoiceTree(Nat),
  pending_of(Nat, advance(Nat, 1, start(Nat, sample())))
) = 2 { Refl }

// The two branches share one three-step budget.
pub theorem three_steps(): answers_of(Nat, advance(Nat, 3, start(Nat, sample()))) = [1, 2] { Refl }

pub theorem two_steps(): answers_of(
  Nat,
  advance(Nat, 2, start(Nat, sample()))
) = Cons(1, Nil) { Refl }
