import "../std/Row.taut" { Mem, Sub, append }
import "Effects.taut" { Nat_ne_succ }
import std::prelude::Std { List }

// A port of lean/Proto/Macro/Scope.lean:
// the resolution of an identifier among bindings by the scopes they carry, and
// the theorems of hygiene H1 to H3. A name is a `Nat`, the scopes of an
// identifier or a binding are a list read as a set (`Sub`, from Row.taut).

pub(open) inductive MBind: Type {
  Mbind(name: Nat, scopes: List(Nat), id: Nat): MBind
}

pub fn mname(b: MBind): Nat {
  ⊢ Nat from match b {
    Mbind(n, s, i) => n
  }
}

pub fn mscopes(b: MBind): List(Nat) {
  ⊢ List(Nat) from match b {
    Mbind(n, s, i) => s
  }
}

// What the identifier `x^S` may mean: a binding of the same name whose scopes
// are among its own.
pub def Cand(
  x: Nat,
  S: List(Nat),
  env: List(MBind),
  b: MBind
): Prop := Mem(MBind, b, env) ∧ mname(b) = x ∧ Sub(Nat, mscopes(b), S)

pub def Below(
  b: MBind,
  c: MBind
): Prop := Sub(Nat, mscopes(b), mscopes(c)) ∧ ¬Sub(Nat, mscopes(c), mscopes(b))

// `resolve(x^S, env) = b`: a candidate with no candidate above it.
pub def Found(
  x: Nat,
  S: List(Nat),
  env: List(MBind),
  b: MBind
): Prop := Cand(x, S, env, b) ∧ ∀ c: MBind. Cand(x, S, env, c) -> ¬Below(b, c)

// A binding with a scope the identifier lacks is never what it means.
pub theorem found_lacks<x: Nat, S: List(Nat), env: List(MBind), b: MBind, s: Nat>(
  h: Found(x, S, env, b),
  hs: Mem(Nat, s, mscopes(b))
): Mem(Nat, s, S) {
  ⊢ Mem(Nat, s, S) from match h {
    AndIntro(AndIntro(_, AndIntro(_, hsub)), _) => hsub(s, hs)
  }
}

// H1: an identifier from the input (without the expansion's scope `s`) does not
// resolve to a binding the expansion introduced (with it).
pub theorem resolve_not_intro<x: Nat, S: List(Nat), env: List(MBind), b: MBind, s: Nat>(
  hx: ¬Mem(Nat, s, S),
  hb: Mem(Nat, s, mscopes(b)),
  h: Found(x, S, env, b)
): False {
  hx(found_lacks(h, hb))
}

// H2: an identifier that lacks the scope `f` of an enclosing binding form does
// not resolve to a binding of that form.
pub theorem intro_not_capture<x: Nat, S: List(Nat), env: List(MBind), b: MBind, f: Nat>(
  hx: ¬Mem(Nat, f, S),
  hb: Mem(Nat, f, mscopes(b)),
  h: Found(x, S, env, b)
): False {
  resolve_not_intro(hx, hb, h)
}

// A candidate of the extended environment is a candidate of the old one, if
// every new binding has the scope the identifier lacks.
pub theorem cand_append_old<x: Nat, S: List(Nat), env: List(MBind), new: List(MBind), c: MBind, s: Nat>(
  hx: ¬Mem(Nat, s, S),
  hn: ∀ d: MBind. (Mem(MBind, d, new)) -> Mem(Nat, s, mscopes(d)),
  h: Cand(x, S, append(MBind, env, new), c)
): Cand(x, S, env, c) {
  ⊢ Cand(x, S, env, c) from match h {
    AndIntro(hm, AndIntro(hname, hsub)) => ⊢ Cand(
      x,
      S,
      env,
      c
    ) from match Mem::append_inv(MBind, c, env, new, hm) {
      OrInl(m) => AndIntro(m, AndIntro(hname, hsub))
      OrInr(m) => False::elim(<P: Cand(x, S, env, c)>, hx(hsub(s, hn(c, m))))
    }
  }
}

pub theorem cand_append_new<x: Nat, S: List(Nat), env: List(MBind), new: List(MBind), c: MBind>(
  h: Cand(x, S, env, c)
): Cand(x, S, append(MBind, env, new), c) {
  ⊢ Cand(x, S, append(MBind, env, new), c) from match h {
    AndIntro(hm, rest) => AndIntro(Mem::append_left(new, hm), rest)
  }
}

// H3: what an input identifier means is the same with the bindings the
// expansion introduced added.
pub theorem input_keeps_binding_fwd<x: Nat, S: List(Nat), env: List(MBind), new: List(MBind), b: MBind, s: Nat>(
  hx: ¬Mem(Nat, s, S),
  hn: ∀ d: MBind. (Mem(MBind, d, new)) -> Mem(Nat, s, mscopes(d)),
  h: Found(x, S, append(MBind, env, new), b)
): Found(x, S, env, b) {
  ⊢ Found(x, S, env, b) from match h {
    AndIntro(hcand, hmin) => AndIntro(
      cand_append_old(hx, hn, hcand),
      c => hc => hmin(c, cand_append_new(hc))
    )
  }
}

pub theorem input_keeps_binding_bwd<x: Nat, S: List(Nat), env: List(MBind), new: List(MBind), b: MBind, s: Nat>(
  hx: ¬Mem(Nat, s, S),
  hn: ∀ d: MBind. (Mem(MBind, d, new)) -> Mem(Nat, s, mscopes(d)),
  h: Found(x, S, env, b)
): Found(x, S, append(MBind, env, new), b) {
  ⊢ Found(x, S, append(MBind, env, new), b) from match h {
    AndIntro(hcand, hmin) => AndIntro(
      cand_append_new(hcand),
      c => hc => hmin(c, cand_append_old(hx, hn, hc))
    )
  }
}

// H4: the scopes handed out one after the other are different.
pub theorem fresh_injective(n: Nat): ¬(n = Succ(n)) {
  (e: n = Succ(n)) => Nat_ne_succ(n, e)
}
