import "Effects.taut" { Eff, Ty, Width, divEff, exceededEff }
import "Typing.taut" {
  Clause,
  ClauseOk,
  Decl,
  Fits,
  HasType,
  HasTypes,
  Prim,
  Tm,
  unhandled_perform
}
import "../std/Row.taut" { Mem, Sub, nil_sub }
import std::prelude::Std { List, Option }

// A port of lean/Proto/Nib/Examples.lean: small programs Nib's typing
// rules must accept, and a fact they must refuse.

pub fn ask(): Eff { Eff::Mk(0, Nil) }

pub fn askSig(e: Eff): Option(Decl) {
  ⊢ Option(Decl) from match e {
    Mk(d, a) => ⊢ Option(Decl) from match d {
      Zero => ⊢ Option(Decl) from match a {
        Nil => Some(Decl::Mk(Nil, Tint(I64)))
        Cons(h, t) => None
      }
      Succ(k) => None
    }
  }
}

pub theorem askSig_ask(): askSig(ask()) = Some(Decl::Mk(Nil, Tint(I64))) { Refl }

pub theorem perform_ask(): HasType(askSig, Nil(<A: Ty>), Tperform(ask(), Nil), Tint(I64), [ask()]) {
  HPerform(Nil, ask(), Nil, Nil, Tint(I64), Nil, askSig_ask(), HtNil(Nil))
}

pub theorem Sub_cons_right<A: Type>(r: List(A), x: A): Sub(A, r, Cons(x, r)) {
  e => m => MemThere(<A: A, a: e>, x, r, m)
}

pub theorem mem_singleton<A: Type, a: A, b: A>(m: Mem(A, a, [b])): a = b {
  ⊢ a = b from match m {
    MemHere(t) => Refl
    MemThere(b2, t2, m2) => Mem::nil(a = b, m2)
  }
}

// A function value that performs when called is not performing it now.
pub theorem lam_is_pure(): HasType(
  askSig,
  Nil(<A: Ty>),
  Tlam(Nil, Tperform(ask(), Nil)),
  Tfn(Nil, Tint(I64), [ask()]),
  Nil(<A: Eff>)
) {
  HLam(Nil, Nil, Tperform(ask(), Nil), Tint(I64), [ask()], perform_ask())
}

// Handling `ask` removes it: the arm answers `0`, and the handled
// computation is pure.
pub theorem ask_clause_ok<c: Clause>(
  m: Mem(Clause, c, [Clause::Mk(ask(), TintLit(I64, 0))])
): ClauseOk(askSig, Nil(<A: Ty>), Tint(I64), Nil(<A: Eff>), c) {
  Eq::subst(
    x => ClauseOk(askSig, Nil, Tint(I64), Nil, x),
    Eq::sym(mem_singleton(m)),
    ClauseOk::Mk(
      Nil,
      Tint(I64),
      Nil,
      ask(),
      TintLit(I64, 0),
      Nil,
      Tint(I64),
      Nil,
      Tint(I64),
      askSig_ask(),
      HInt([Tfn([Tint(I64)], Tint(I64), Nil)], I64, 0),
      FitsRefl(Tint(I64)),
      nil_sub(Nil)
    )
  )
}

pub theorem handled_ask(): HasType(
  askSig,
  Nil(<A: Ty>),
  Thandle(Tperform(ask(), Nil), None, [Clause::Mk(ask(), TintLit(I64, 0))]),
  Tint(I64),
  Nil(<A: Eff>)
) {
  HHandle(
    Nil,
    Tperform(ask(), Nil),
    [Clause::Mk(ask(), TintLit(I64, 0))],
    Tint(I64),
    Tint(I64),
    [ask()],
    Nil,
    perform_ask(),
    FitsRefl(Tint(I64)),
    e => m => OrInl(m),
    c => m => ask_clause_ok(m)
  )
}

// Without a clause for it, `ask` stays in the row of the handle.
pub theorem unhandled_ask(
  h: HasType(
    askSig,
    Nil(<A: Ty>),
    Thandle(Tperform(ask(), Nil), None, Nil),
    Tint(I64),
    Nil(<A: Eff>)
  )
): False {
  Mem::nil(False, unhandled_perform(h))
}

// `budget(steps: 100) { perform ask() }`: no rule of its own. The body may
// perform `Div` besides `ask`; the call performs `Exceeded(I64)` and what the
// body performs besides `Div`.
pub theorem budget_ask(): HasType(
  askSig,
  Nil(<A: Ty>),
  Tapp(Tprim(Pbudget, Tint(I64), [ask()]), [TintLit(I64, 100), Tlam(Nil, Tperform(ask(), Nil))]),
  Tint(I64),
  [exceededEff(Tint(I64)), ask()]
) {
  HApp(
    Nil,
    Tprim(Pbudget, Tint(I64), [ask()]),
    [TintLit(I64, 100), Tlam(Nil, Tperform(ask(), Nil))],
    [Tint(I64), Tfn(Nil, Tint(I64), [divEff(), ask()])],
    Tint(I64),
    Nil,
    Nil,
    [exceededEff(Tint(I64)), ask()],
    HPrim(Nil, Pbudget, Tint(I64), [ask()]),
    HtCons(
      Nil,
      TintLit(I64, 100),
      [Tlam(Nil, Tperform(ask(), Nil))],
      Tint(I64),
      [Tfn(Nil, Tint(I64), [divEff(), ask()])],
      Nil,
      Nil,
      HInt(Nil, I64, 100),
      HtCons(
        Nil,
        Tlam(Nil, Tperform(ask(), Nil)),
        Nil,
        Tfn(Nil, Tint(I64), [divEff(), ask()]),
        Nil,
        Nil,
        Nil,
        HLam(
          Nil,
          Nil,
          Tperform(ask(), Nil),
          Tint(I64),
          [divEff(), ask()],
          HWeaken(
            Nil,
            Tperform(ask(), Nil),
            Tint(I64),
            [ask()],
            [divEff(), ask()],
            perform_ask(),
            Sub_cons_right([ask()], divEff())
          )
        ),
        HtNil(Nil)
      )
    )
  )
}
