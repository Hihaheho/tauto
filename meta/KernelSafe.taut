import "Kernel.taut" {
  KConv,
  KLook,
  KSub,
  KTm,
  KTyping,
  Kinst,
  Klift,
  Kren,
  Ksingle,
  Ksubst,
  Kup,
  NLe,
  Red1,
  cv_app,
  cv_pi,
  imax,
  stepTy
}
import "KernelAlg.taut" {
  eq_Kapp,
  eq_Kpi,
  eq_Ksucc,
  ren_inst,
  ren_lift,
  subst_inst,
  subst_lift,
  subst_single_lift,
  subst_var
}
import "KernelPar.taut" { CvBoth, Par, pi_inj, pi_ne_sort, red1_par, sort_inj }
import "Renaming.taut" { upR }
import std::prelude::Std { List }

// Weakening, substitution and the structure of cumulativity for
// lean/Proto/Kernel/Typing.lean, and then subject reduction for
// lean/Proto/Kernel/Safety.lean, over the declarative `KTyping` of Kernel.taut.

pub theorem conv_ren<a: KTm, b: KTm>(
  h: KConv(a, b),
  xi: (Nat) -> Nat
): KConv(Kren(a, xi), Kren(b, xi)) {
  ⊢ KConv(Kren(a, xi), Kren(b, xi)) from match h {
    CvStep(r) => Par::conv(Par::ren(red1_par(r), xi))
    CvRefl(x) => CvRefl(Kren(x, xi))
    CvSymm(h1) => CvSymm(conv_ren(h1, xi))
    CvTrans(h1, h2) => CvTrans(conv_ren(h1, xi), conv_ren(h2, xi))
  }
}

module Par {
  pub theorem refl_pw(sigma: (Nat) -> KTm): ∀ i: Nat. Par(sigma(i), sigma(i)) {
    i => Par::refl(sigma(i))
  }
}

pub theorem conv_subst<a: KTm, b: KTm>(
  h: KConv(a, b),
  sigma: (Nat) -> KTm
): KConv(Ksubst(a, sigma), Ksubst(b, sigma)) {
  ⊢ KConv(Ksubst(a, sigma), Ksubst(b, sigma)) from match h {
    CvStep(r) => Par::conv(Par::subst(red1_par(r), sigma, sigma, Par::refl_pw(sigma)))
    CvRefl(x) => CvRefl(Ksubst(x, sigma))
    CvSymm(h1) => CvSymm(conv_subst(h1, sigma))
    CvTrans(h1, h2) => CvTrans(conv_subst(h1, sigma), conv_subst(h2, sigma))
  }
}

pub theorem conv_inst_r(
  b: KTm,
  a: KTm,
  a2: KTm,
  h: KConv(a, a2)
): KConv(Kinst(b, a), Kinst(b, a2)) {
  ⊢ KConv(Kinst(b, a), Kinst(b, a2)) from match h {
    CvStep(r) => Par::conv(Par::inst(Par::refl(b), red1_par(r)))
    CvRefl(x) => CvRefl(Kinst(b, x))
    CvSymm(x, y, h1) => CvSymm(conv_inst_r(b, x, y, h1))
    CvTrans(x, y, z, h1, h2) => CvTrans(conv_inst_r(b, x, y, h1), conv_inst_r(b, y, z, h2))
  }
}

pub theorem conv_inst<b: KTm, b2: KTm, a: KTm, a2: KTm>(
  hb: KConv(b, b2),
  ha: KConv(a, a2)
): KConv(Kinst(b, a), Kinst(b2, a2)) {
  CvTrans(conv_subst(hb, Ksingle(a)), conv_inst_r(b2, a, a2, ha))
}

pub theorem ren_stepTy(xi: (Nat) -> Nat, P: KTm): Kren(stepTy(P), xi) = stepTy(Kren(P, xi)) {
  eq_Kpi(
    Refl,
    eq_Kpi(
      eq_Kapp(ren_lift(P, xi), Refl),
      eq_Kapp(Eq::trans(ren_lift(Klift(P), upR(xi)), Eq::congr(Klift, ren_lift(P, xi))), Refl)
    )
  )
}

pub theorem subst_stepTy(
  sigma: (Nat) -> KTm,
  P: KTm
): Ksubst(stepTy(P), sigma) = stepTy(Ksubst(P, sigma)) {
  eq_Kpi(
    Refl,
    eq_Kpi(
      eq_Kapp(subst_lift(sigma, P), Refl),
      eq_Kapp(
        Eq::trans(subst_lift(Kup(sigma), Klift(P)), Eq::congr(Klift, subst_lift(sigma, P))),
        Refl
      )
    )
  )
}

pub theorem conv_stepTy<P: KTm, P2: KTm>(h: KConv(P, P2)): KConv(stepTy(P), stepTy(P2)) {
  cv_pi(
    CvRefl(Knat),
    cv_pi(
      cv_app(conv_ren(h, Succ), CvRefl(Kvar(0))),
      cv_app(conv_ren(conv_ren(h, Succ), Succ), CvRefl(Ksucc(Kvar(1))))
    )
  )
}

pub theorem nle_trans<n: Nat, m: Nat>(h1: NLe(n, m), k: Nat, h2: NLe(m, k)): NLe(n, k) {
  ⊢ NLe(n, k) from match h1 {
    LeZero(x) => LeZero(k)
    LeSucc(a, b, h) => ⊢ NLe(Succ(a), k) from match h2 {
      LeSucc(c, d, h3) => LeSucc(nle_trans(h, d, h3))
    }
  }
}

pub theorem sub_conv_left<A: KTm, A2: KTm, C: KTm>(s: KSub(A2, C), h: KConv(A, A2)): KSub(A, C) {
  ⊢ KSub(A, C) from match s {
    SbConv(c) => SbConv(CvTrans(h, c))
    SbSort(c1, c2, l) => SbSort(CvTrans(h, c1), c2, l)
    SbPi(c1, c2, d, s1) => SbPi(CvTrans(h, c1), c2, d, s1)
  }
}

pub theorem sub_conv_right<A: KTm, C: KTm, C2: KTm>(s: KSub(A, C), h: KConv(C, C2)): KSub(A, C2) {
  ⊢ KSub(A, C2) from match s {
    SbConv(c) => SbConv(CvTrans(c, h))
    SbSort(c1, c2, l) => SbSort(c1, CvTrans(CvSymm(h), c2), l)
    SbPi(c1, c2, d, s1) => SbPi(c1, CvTrans(CvSymm(h), c2), d, s1)
  }
}

pub theorem sub_refl(A: KTm): KSub(A, A) {
  SbConv(CvRefl(A))
}

pub(open) inductive CvSub(A: KTm, A2: KTm, B: KTm, B2: KTm): Prop {
  Mk(h1: KConv(A, A2), h2: KSub(B, B2)): CvSub(A, A2, B, B2)
}

pub theorem sub_pi_inv_pp<A: KTm, A2: KTm, B: KTm, B2: KTm, A1: KTm, B1: KTm, A3: KTm, B3: KTm>(
  d: KConv(A1, A3),
  s: KSub(B1, B3),
  e1: CvBoth(A, A1, B, B1),
  e2: CvBoth(A2, A3, B2, B3)
): CvSub(A, A2, B, B2) {
  ⊢ CvSub(A, A2, B, B2) from match e1 {
    Mk(f1, f2) => ⊢ CvSub(A, A2, B, B2) from match e2 {
      Mk(g1, g2) => CvSub::Mk(
        CvTrans(f1, CvTrans(d, CvSymm(g1))),
        sub_conv_right(sub_conv_left(s, f2), CvSymm(g2))
      )
    }
  }
}

pub theorem sub_trans_pi2<x: KTm, C1: KTm, A1: KTm, B1: KTm, A2: KTm, B2: KTm, A3: KTm, B3: KTm, A4: KTm, B4: KTm>(
  c1: KConv(x, Kpi(A1, B1)),
  d: KConv(A1, A2),
  e2: KConv(C1, Kpi(A4, B4)),
  e3: KConv(A3, A4),
  e4: KSub(B3, B4),
  ih: ∀ C: KTm. (KSub(B2, C)) -> KSub(B1, C),
  g: CvBoth(A2, A3, B2, B3)
): KSub(x, C1) {
  ⊢ KSub(x, C1) from match g {
    Mk(g1, g2) => SbPi(c1, e2, CvTrans(d, CvTrans(g1, e3)), ih(B4, sub_conv_left(e4, g2)))
  }
}

pub theorem sub_trans<A: KTm, B: KTm>(h1: KSub(A, B), C: KTm, h2: KSub(B, C)): KSub(A, C) {
  match h1 {
    SbConv(c) => sub_conv_left(h2, c)
    SbSort(x, y, n, m, c1, c2, l) => match h2 {
      SbConv(c) => SbSort(c1, CvTrans(CvSymm(c), c2), l)
      SbSort(y1, C1, n2, m2, d1, d2, l2) => SbSort(
        c1,
        d2,
        nle_trans(Eq::subst(z => NLe(n, z), sort_inj(CvTrans(CvSymm(c2), d1)), l), m2, l2)
      )
      SbPi(d1, d2, d3, d4) => False::elim(pi_ne_sort(CvTrans(CvSymm(d1), c2)))
    }
    SbPi(x, y, A1, B1, A2, B2, c1, c2, d, s) => match h2 {
      SbConv(c) => SbPi(c1, CvTrans(CvSymm(c), c2), d, sub_trans(s, B2, sub_refl(B2)))
      SbSort(d1, d2, l) => False::elim(pi_ne_sort(CvTrans(CvSymm(c2), d1)))
      SbPi(e1, e2, e3, e4) => sub_trans_pi2(
        c1,
        d,
        e2,
        e3,
        e4,
        C0 => h0 => sub_trans(s, C0, h0),
        pi_inj(CvTrans(CvSymm(c2), e1))
      )
    }
  }
}

pub theorem sub_pi_inv_c<A: KTm, A2: KTm, B: KTm, B2: KTm>(
  e: CvBoth(A, A2, B, B2)
): CvSub(A, A2, B, B2) {
  ⊢ CvSub(A, A2, B, B2) from match e {
    Mk(f1, f2) => CvSub::Mk(f1, SbConv(f2))
  }
}

pub theorem sub_pi_inv<A: KTm, B: KTm, A2: KTm, B2: KTm>(
  h: KSub(Kpi(A, B), Kpi(A2, B2))
): CvSub(A, A2, B, B2) {
  ⊢ CvSub(A, A2, B, B2) from match h {
    SbConv(c) => sub_pi_inv_c(pi_inj(c))
    SbSort(c1, c2, l) => False::elim(pi_ne_sort(c1))
    SbPi(c1, c2, d, s) => sub_pi_inv_pp(d, s, pi_inj(c1), pi_inj(c2))
  }
}

pub theorem sub_ren<A: KTm, B: KTm>(
  h: KSub(A, B),
  xi: (Nat) -> Nat
): KSub(Kren(A, xi), Kren(B, xi)) {
  ⊢ KSub(Kren(A, xi), Kren(B, xi)) from match h {
    SbConv(c) => SbConv(conv_ren(c, xi))
    SbSort(c1, c2, l) => SbSort(conv_ren(c1, xi), conv_ren(c2, xi), l)
    SbPi(c1, c2, d, s) => SbPi(
      conv_ren(c1, xi),
      conv_ren(c2, xi),
      conv_ren(d, xi),
      sub_ren(s, upR(xi))
    )
  }
}

pub theorem sub_subst<A: KTm, B: KTm>(
  h: KSub(A, B),
  sigma: (Nat) -> KTm
): KSub(Ksubst(A, sigma), Ksubst(B, sigma)) {
  ⊢ KSub(Ksubst(A, sigma), Ksubst(B, sigma)) from match h {
    SbConv(c) => SbConv(conv_subst(c, sigma))
    SbSort(c1, c2, l) => SbSort(conv_subst(c1, sigma), conv_subst(c2, sigma), l)
    SbPi(c1, c2, d, s) => SbPi(
      conv_subst(c1, sigma),
      conv_subst(c2, sigma),
      conv_subst(d, sigma),
      sub_subst(s, Kup(sigma))
    )
  }
}

pub theorem ty_cast<G: List(KTm), t: KTm, A: KTm, A2: KTm>(
  e: A = A2,
  h: KTyping(G, t, A)
): KTyping(G, t, A2) {
  ⊢ KTyping(G, t, A2) from match e {
    Refl => h
  }
}

pub theorem look_cast<G: List(KTm), i: Nat, A: KTm, A2: KTm>(
  e: A = A2,
  h: KLook(G, i, A)
): KLook(G, i, A2) {
  ⊢ KLook(G, i, A2) from match e {
    Refl => h
  }
}

pub theorem ren_up_ok(
  xi: (Nat) -> Nat,
  G: List(KTm),
  D: List(KTm),
  A: KTm,
  i: Nat,
  B: KTm,
  hi: KLook(Cons(A, G), i, B),
  r: ∀ j: Nat, C: KTm. (KLook(G, j, C)) -> KLook(D, xi(j), Kren(C, xi))
): KLook(Cons(Kren(A, xi), D), upR(xi, i), Kren(B, upR(xi))) {
  ⊢ KLook(Cons(Kren(A, xi), D), upR(xi, i), Kren(B, upR(xi))) from match hi {
    LkZero(G0, A0) => look_cast(Eq::sym(ren_lift(A0, xi)), LkZero(D, Kren(A0, xi)))
    LkSucc(B0, i0, A0, h0) => look_cast(
      Eq::sym(ren_lift(A0, xi)),
      LkSucc(Kren(B0, xi), xi(i0), Kren(A0, xi), r(i0, A0, h0))
    )
  }
}

pub theorem ren_succ_ok<G: List(KTm)>(
  A: KTm,
  i: Nat,
  B: KTm,
  h: KLook(G, i, B)
): KLook(Cons(A, G), Succ(i), Klift(B)) {
  LkSucc(A, i, B, h)
}

pub theorem ktyping_ren<G: List(KTm), t: KTm, A: KTm>(
  h: KTyping(G, t, A),
  xi: (Nat) -> Nat,
  D: List(KTm),
  r: ∀ j: Nat, C: KTm. (KLook(G, j, C)) -> KLook(D, xi(j), Kren(C, xi))
): KTyping(D, Kren(t, xi), Kren(A, xi)) {
  ⊢ KTyping(D, Kren(t, xi), Kren(A, xi)) from match h {
    TyVar(G0, i, A0, h0) => TyVar(r(i, A0, h0))
    TySort(G0, n) => TySort(D, n)
    TyPi(G0, A0, B0, s1, s2, hA, hB) => TyPi(
      ktyping_ren(hA, xi, D, r),
      ktyping_ren(
        hB,
        upR(xi),
        Cons(<A: KTm>, Kren(A0, xi), D),
        j => C => hj => ren_up_ok(xi, G0, D, A0, j, C, hj, r)
      )
    )
    TyLam(G0, A0, B0, b0, s, hA, hb) => TyLam(
      ktyping_ren(hA, xi, D, r),
      ktyping_ren(
        hb,
        upR(xi),
        Cons(<A: KTm>, Kren(A0, xi), D),
        j => C => hj => ren_up_ok(xi, G0, D, A0, j, C, hj, r)
      )
    )
    TyApp(G0, f, a, A0, B0, hf, ha) => ty_cast(
      Eq::sym(ren_inst(xi, B0, a)),
      TyApp(ktyping_ren(hf, xi, D, r), ktyping_ren(ha, xi, D, r))
    )
    TySub(h0, hB, sb) => TySub(
      ktyping_ren(h0, xi, D, r),
      ktyping_ren(hB, xi, D, r),
      sub_ren(sb, xi)
    )
    TyNat(G0) => TyNat(D)
    TyZero(G0) => TyZero(D)
    TySucc(h0) => TySucc(ktyping_ren(h0, xi, D, r))
    TyRec(G0, P, z, s2, n, s, hP, hz, hs, hn) => TyRec(
      ktyping_ren(hP, xi, D, r),
      ktyping_ren(hz, xi, D, r),
      ty_cast(ren_stepTy(xi, P), ktyping_ren(hs, xi, D, r)),
      ktyping_ren(hn, xi, D, r)
    )
  }
}

pub theorem ty_weaken<G: List(KTm), t: KTm, A: KTm>(
  B: KTm,
  h: KTyping(G, t, A)
): KTyping(Cons(B, G), Klift(t), Klift(A)) {
  ktyping_ren(h, Succ, Cons(<A: KTm>, B, G), j => C => hj => ren_succ_ok(B, j, C, hj))
}

pub theorem subst_up_ok(
  sigma: (Nat) -> KTm,
  G: List(KTm),
  D: List(KTm),
  A: KTm,
  i: Nat,
  B: KTm,
  hi: KLook(Cons(A, G), i, B),
  s: ∀ j: Nat, C: KTm. (KLook(G, j, C)) -> KTyping(D, sigma(j), Ksubst(C, sigma))
): KTyping(Cons(Ksubst(A, sigma), D), Kup(sigma, i), Ksubst(B, Kup(sigma))) {
  ⊢ KTyping(Cons(Ksubst(A, sigma), D), Kup(sigma, i), Ksubst(B, Kup(sigma))) from match hi {
    LkZero(G0, A0) => ty_cast(Eq::sym(subst_lift(sigma, A0)), TyVar(LkZero(D, Ksubst(A0, sigma))))
    LkSucc(B0, i0, A0, h0) => ty_cast(
      Eq::sym(subst_lift(sigma, A0)),
      ty_weaken(Ksubst(B0, sigma), s(i0, A0, h0))
    )
  }
}

pub theorem ktyping_subst<G: List(KTm), t: KTm, A: KTm>(
  h: KTyping(G, t, A),
  sigma: (Nat) -> KTm,
  D: List(KTm),
  s: ∀ j: Nat, C: KTm. (KLook(G, j, C)) -> KTyping(D, sigma(j), Ksubst(C, sigma))
): KTyping(D, Ksubst(t, sigma), Ksubst(A, sigma)) {
  ⊢ KTyping(D, Ksubst(t, sigma), Ksubst(A, sigma)) from match h {
    TyVar(G0, i, A0, h0) => s(i, A0, h0)
    TySort(G0, n) => TySort(D, n)
    TyPi(G0, A0, B0, s1, s2, hA, hB) => TyPi(
      ktyping_subst(hA, sigma, D, s),
      ktyping_subst(
        hB,
        Kup(sigma),
        Cons(<A: KTm>, Ksubst(A0, sigma), D),
        j => C => hj => subst_up_ok(sigma, G0, D, A0, j, C, hj, s)
      )
    )
    TyLam(G0, A0, B0, b0, s1, hA, hb) => TyLam(
      ktyping_subst(hA, sigma, D, s),
      ktyping_subst(
        hb,
        Kup(sigma),
        Cons(<A: KTm>, Ksubst(A0, sigma), D),
        j => C => hj => subst_up_ok(sigma, G0, D, A0, j, C, hj, s)
      )
    )
    TyApp(G0, f, a, A0, B0, hf, ha) => ty_cast(
      Eq::sym(subst_inst(sigma, B0, a)),
      TyApp(ktyping_subst(hf, sigma, D, s), ktyping_subst(ha, sigma, D, s))
    )
    TySub(h0, hB, sb) => TySub(
      ktyping_subst(h0, sigma, D, s),
      ktyping_subst(hB, sigma, D, s),
      sub_subst(sb, sigma)
    )
    TyNat(G0) => TyNat(D)
    TyZero(G0) => TyZero(D)
    TySucc(h0) => TySucc(ktyping_subst(h0, sigma, D, s))
    TyRec(G0, P, z, s2, n, s1, hP, hz, hs, hn) => TyRec(
      ktyping_subst(hP, sigma, D, s),
      ktyping_subst(hz, sigma, D, s),
      ty_cast(subst_stepTy(sigma, P), ktyping_subst(hs, sigma, D, s)),
      ktyping_subst(hn, sigma, D, s)
    )
  }
}

pub theorem single_ok<G: List(KTm), a: KTm, A: KTm, i: Nat, B: KTm>(
  hi: KLook(Cons(A, G), i, B),
  h: KTyping(G, a, A)
): KTyping(G, Ksingle(a, i), Kinst(B, a)) {
  ⊢ KTyping(G, Ksingle(a, i), Kinst(B, a)) from match hi {
    LkZero(G0, A0) => ty_cast(Eq::sym(subst_single_lift(A0, a)), h)
    LkSucc(B0, i0, A0, h0) => ty_cast(Eq::sym(subst_single_lift(A0, a)), TyVar(h0))
  }
}

pub theorem ty_inst<G: List(KTm), b: KTm, a: KTm, A: KTm, B: KTm>(
  hb: KTyping(Cons(A, G), b, B),
  ha: KTyping(G, a, A)
): KTyping(G, Kinst(b, a), Kinst(B, a)) {
  ktyping_subst(hb, Ksingle(a), G, j => C => hj => single_ok(hj, ha))
}

pub(open) inductive LamInv(G: List(KTm), b: KTm, T: KTm): Prop {
  LamIs<A: KTm, B: KTm, s: Nat>(
    hA: KTyping(G, A, Ksort(s)),
    hb: KTyping(Cons(A, G), b, B),
    sb: KSub(Kpi(A, B), T)
  ): LamInv(G, b, T)
}

pub theorem lam_inv_sub<G: List(KTm), b: KTm, A: KTm, B: KTm>(
  li: LamInv(G, b, A),
  sb: KSub(A, B)
): LamInv(G, b, B) {
  ⊢ LamInv(G, b, B) from match li {
    LamIs<A: A5, B: B6, s: s7>(hA, hb, sb1) => LamIs(hA, hb, sub_trans(sb1, B, sb))
  }
}

pub theorem lam_inv<G: List(KTm), b: KTm, T: KTm>(h: KTyping(G, Klam(b), T)): LamInv(G, b, T) {
  match h {
    TyLam(G0, A0, B0, b0, s, hA, hb) => LamIs(hA, hb, sub_refl(Kpi(A0, B0)))
    TySub(h0, hB, sb) => lam_inv_sub(lam_inv(h0), sb)
  }
}

pub(open) inductive PiGen(G: List(KTm), A: KTm, B: KTm, T: KTm): Prop {
  Pig<s1: Nat, s2: Nat>(
    hA: KTyping(G, A, Ksort(s1)),
    hB: KTyping(Cons(A, G), B, Ksort(s2)),
    sb: KSub(Ksort(imax(s1, s2)), T)
  ): PiGen(G, A, B, T)
}

pub theorem pi_gen_sub<G: List(KTm), A: KTm, B: KTm, T: KTm, T2: KTm>(
  pg: PiGen(G, A, B, T),
  sb: KSub(T, T2)
): PiGen(G, A, B, T2) {
  ⊢ PiGen(G, A, B, T2) from match pg {
    Pig<s1: s18, s2: s29>(hA, hB, sb1) => Pig(hA, hB, sub_trans(sb1, T2, sb))
  }
}

pub theorem pi_gen<G: List(KTm), A: KTm, B: KTm, T: KTm>(
  h: KTyping(G, Kpi(A, B), T)
): PiGen(G, A, B, T) {
  match h {
    TyPi(G0, A0, B0, s1, s2, hA, hB) => Pig(hA, hB, sub_refl(Ksort(imax(s1, s2))))
    TySub(h0, hB, sb) => pi_gen_sub(pi_gen(h0), sb)
  }
}

pub theorem succ_inv<G: List(KTm), n: KTm, T: KTm>(
  h: KTyping(G, Ksucc(n), T)
): KTyping(G, n, Knat) {
  match h {
    TySucc(h0) => h0
    TySub(h0, hB, sb) => succ_inv(h0)
  }
}

pub(open) inductive KWF: (List(KTm)) -> Prop {
  WfNil: KWF(Nil)
  WfCons<G: List(KTm), A: KTm, s: Nat>(hw: KWF(G), h: KTyping(G, A, Ksort(s))): KWF(Cons(A, G))
}

pub(open) inductive SortOf(G: List(KTm), A: KTm): Prop {
  Mk<s: Nat>(h: KTyping(G, A, Ksort(s))): SortOf(G, A)
}

pub theorem sortof_weaken<G: List(KTm), A: KTm>(
  B: KTm,
  so: SortOf(G, A)
): SortOf(Cons(B, G), Klift(A)) {
  ⊢ SortOf(Cons(B, G), Klift(A)) from match so {
    Mk<s: s10>(h) => SortOf::Mk(ty_weaken(B, h))
  }
}

pub theorem wf_lookup<G: List(KTm), i: Nat, A: KTm>(hi: KLook(G, i, A), hw: KWF(G)): SortOf(G, A) {
  ⊢ SortOf(G, A) from match hi {
    LkZero(G0, A0) => ⊢ SortOf(Cons(<A: KTm>, A0, G0), Klift(A0)) from match hw {
      WfCons(G1, A1, s, hw1, h1) => ⊢ SortOf(
        List::Cons(<A: KTm>, A0, G0),
        Klift(A0)
      ) from SortOf::Mk(ty_weaken(A1, h1))
    }
    LkSucc(G0, B0, i0, A0, h0) => ⊢ SortOf(Cons(<A: KTm>, B0, G0), Klift(A0)) from match hw {
      WfCons(G1, B1, s, hw1, h1) => ⊢ SortOf(
        List::Cons(<A: KTm>, B0, G0),
        Klift(A0)
      ) from sortof_weaken(B1, wf_lookup(h0, hw1))
    }
  }
}

pub theorem stepTy_typed<G: List(KTm), P: KTm, s: Nat>(
  hP: KTyping(G, P, Kpi(Knat, Ksort(s)))
): KTyping(G, stepTy(P), Ksort(imax(1, imax(s, s)))) {
  TyPi(
    TyNat(G),
    TyPi(
      TyApp(ty_weaken(Knat, hP), TyVar(LkZero(G, Knat))),
      TyApp(
        ty_weaken(Kapp(Klift(P), Kvar(0)), ty_weaken(Knat, hP)),
        TySucc(TyVar(LkSucc(Kapp(Klift(P), Kvar(0)), Zero, Klift(Knat), LkZero(G, Knat))))
      )
    )
  )
}

pub theorem valid_lam<G: List(KTm), A: KTm, B: KTm, s: Nat>(
  hA: KTyping(G, A, Ksort(s)),
  so: SortOf(Cons(A, G), B)
): SortOf(G, Kpi(A, B)) {
  ⊢ SortOf(G, Kpi(A, B)) from match so {
    Mk<s: s11>(hB) => SortOf::Mk(TyPi(hA, hB))
  }
}

pub theorem valid_app2<G: List(KTm), a: KTm, A: KTm, B: KTm, T: KTm>(
  ha: KTyping(G, a, A),
  pg: PiGen(G, A, B, T)
): SortOf(G, Kinst(B, a)) {
  ⊢ SortOf(G, Kinst(B, a)) from match pg {
    Pig<s1: s112, s2: s213>(hA, hB, sb) => SortOf::Mk(ty_inst(hB, ha))
  }
}

pub theorem valid_app<G: List(KTm), a: KTm, A: KTm, B: KTm>(
  ha: KTyping(G, a, A),
  so: SortOf(G, Kpi(A, B))
): SortOf(G, Kinst(B, a)) {
  ⊢ SortOf(G, Kinst(B, a)) from match so {
    Mk<s: s14>(hp) => valid_app2(ha, pi_gen(hp))
  }
}

pub theorem valid<G: List(KTm), t: KTm, A: KTm>(h: KTyping(G, t, A), hw: KWF(G)): SortOf(G, A) {
  ⊢ SortOf(G, A) from match h {
    TyVar(h0) => wf_lookup(h0, hw)
    TySort(G0, n) => SortOf::Mk(TySort(G0, Succ(n)))
    TyPi(G0, A0, B0, s1, s2, hA, hB) => SortOf::Mk(TySort(G0, imax(s1, s2)))
    TyLam(hA, hb) => valid_lam(hA, valid(hb, WfCons(hw, hA)))
    TyApp(hf, ha) => valid_app(ha, valid(hf, hw))
    TySub(h0, hB, sb) => SortOf::Mk(hB)
    TyNat(G0) => SortOf::Mk(TySort(G0, 1))
    TyZero(G0) => SortOf::Mk(TyNat(G0))
    TySucc(G0, n, h0) => SortOf::Mk(TyNat(G0))
    TyRec(hP, hz, hs, hn) => SortOf::Mk(TyApp(hP, hn))
  }
}

pub theorem iota_e0(P: KTm, n: KTm): Ksubst(Kapp(Klift(P), Kvar(0)), Ksingle(n)) = Kapp(P, n) {
  eq_Kapp(subst_single_lift(P, n), Refl)
}

pub theorem iota_e2(
  P: KTm,
  n: KTm,
  r: KTm
): Kinst(Ksubst(Kapp(Klift(Klift(P)), Ksucc(Kvar(1))), Kup(Ksingle(n))), r) = Kapp(P, Ksucc(n)) {
  eq_Kapp(
    Eq::trans(
      Eq::congr(
        x => Kinst(x, r),
        Eq::trans(subst_lift(Ksingle(n), Klift(P)), Eq::congr(Klift, subst_single_lift(P, n)))
      ),
      subst_single_lift(P, r)
    ),
    eq_Ksucc(subst_single_lift(n, r))
  )
}

pub theorem iota_typing<G: List(KTm), P: KTm, z: KTm, s2: KTm, n: KTm>(
  hs: KTyping(G, s2, stepTy(P)),
  hn: KTyping(G, n, Knat),
  hr: KTyping(G, KnatRec(P, z, s2, n), Kapp(P, n))
): KTyping(G, Kapp(Kapp(s2, n), KnatRec(P, z, s2, n)), Kapp(P, Ksucc(n))) {
  ty_cast(
    iota_e2(P, n, KnatRec(P, z, s2, n)),
    TyApp(TyApp(hs, hn), ty_cast(Eq::sym(iota_e0(P, n)), hr))
  )
}

pub theorem conv_ctx_ok<G: List(KTm), A: KTm, A2: KTm, j: Nat, C: KTm>(
  hj: KLook(Cons(A, G), j, C),
  s: Nat,
  hA: KTyping(G, A, Ksort(s)),
  c: KConv(A, A2)
): KTyping(Cons(A2, G), Kvar(j), Ksubst(C, Kvar)) {
  ⊢ KTyping(Cons(<A: KTm>, A2, G), Kvar(j), Ksubst(C, Kvar)) from match hj {
    LkZero(G0, A0) => ty_cast(
      Eq::sym(subst_var(Klift(A0), Kvar, i => Refl)),
      TySub(TyVar(LkZero(G0, A2)), ty_weaken(A2, hA), SbConv(conv_ren(CvSymm(c), Succ)))
    )
    LkSucc(B0, i0, A0, h0) => ty_cast(
      Eq::sym(subst_var(Klift(A0), Kvar, i => Refl)),
      TyVar(LkSucc(A2, i0, A0, h0))
    )
  }
}

pub theorem ty_cast_t<G: List(KTm), t: KTm, t2: KTm, A: KTm>(
  e: t = t2,
  h: KTyping(G, t, A)
): KTyping(G, t2, A) {
  ⊢ KTyping(G, t2, A) from match e {
    Refl => h
  }
}

pub theorem conv_ctx<G: List(KTm), A: KTm, A2: KTm, B: KTm, C: KTm, s: Nat>(
  h: KTyping(Cons(A, G), B, C),
  hA: KTyping(G, A, Ksort(s)),
  c: KConv(A, A2)
): KTyping(Cons(A2, G), B, C) {
  let moved: KTyping(
    Cons(A2, G),
    Ksubst(B, Kvar),
    Ksubst(C, Kvar)
  ) := ktyping_subst(h, Kvar, Cons(<A: KTm>, A2, G), j => D => hj => conv_ctx_ok(hj, s, hA, c))
  let typed: KTyping(
    Cons(A2, G),
    Ksubst(B, Kvar),
    C
  ) := ty_cast(subst_var(C, Kvar, i => Refl), moved)
  ty_cast_t(subst_var(B, Kvar, i => Refl), typed)
}

pub theorem sr_beta3<G: List(KTm), b: KTm, a: KTm, A0: KTm, B0: KTm, A1: KTm, B1: KTm, s: Nat>(
  ha: KTyping(G, a, A0),
  sv: Nat,
  hv: KTyping(G, Kinst(B0, a), Ksort(sv)),
  hA1: KTyping(G, A1, Ksort(s)),
  hb1: KTyping(Cons(A1, G), b, B1),
  cs: CvSub(A1, A0, B1, B0)
): KTyping(G, Kinst(b, a), Kinst(B0, a)) {
  ⊢ KTyping(G, Kinst(b, a), Kinst(B0, a)) from match cs {
    Mk(hc, hB) => TySub(
      ty_inst(hb1, TySub(ha, hA1, SbConv(CvSymm(hc)))),
      hv,
      sub_subst(hB, Ksingle(a))
    )
  }
}

pub theorem sr_beta2<G: List(KTm), b: KTm, a: KTm, A0: KTm, B0: KTm>(
  ha: KTyping(G, a, A0),
  sv: Nat,
  hv: KTyping(G, Kinst(B0, a), Ksort(sv)),
  li: LamInv(G, b, Kpi(A0, B0))
): KTyping(G, Kinst(b, a), Kinst(B0, a)) {
  ⊢ KTyping(G, Kinst(b, a), Kinst(B0, a)) from match li {
    LamIs<A: A15, B: B16, s: s17>(hA1, hb1, sb1) => sr_beta3(ha, sv, hv, hA1, hb1, sub_pi_inv(sb1))
  }
}

pub theorem sr_beta1<G: List(KTm), b: KTm, a: KTm, A0: KTm, B0: KTm>(
  hf: KTyping(G, Klam(b), Kpi(A0, B0)),
  ha: KTyping(G, a, A0),
  so: SortOf(G, Kinst(B0, a))
): KTyping(G, Kinst(b, a), Kinst(B0, a)) {
  ⊢ KTyping(G, Kinst(b, a), Kinst(B0, a)) from match so {
    Mk(sv, hv) => sr_beta2(ha, sv, hv, lam_inv(hf))
  }
}

pub theorem sr_appR<G: List(KTm), f: KTm, a: KTm, a2: KTm, A: KTm, B: KTm>(
  hf: KTyping(G, f, Kpi(A, B)),
  ha2: KTyping(G, a2, A),
  c: KConv(a, a2),
  so: SortOf(G, Kinst(B, a))
): KTyping(G, Kapp(f, a2), Kinst(B, a)) {
  ⊢ KTyping(G, Kapp(f, a2), Kinst(B, a)) from match so {
    Mk<s: s19>(hv) => TySub(TyApp(hf, ha2), hv, SbConv(conv_inst_r(B, a2, a, CvSymm(c))))
  }
}

pub theorem sr_recP<G: List(KTm), P: KTm, P2: KTm, z: KTm, s2: KTm, n: KTm, s: Nat>(
  hP: KTyping(G, P, Kpi(Knat, Ksort(s))),
  hz: KTyping(G, z, Kapp(P, Kzero)),
  hs: KTyping(G, s2, stepTy(P)),
  hn: KTyping(G, n, Knat),
  hP2: KTyping(G, P2, Kpi(Knat, Ksort(s))),
  hc: KConv(P, P2)
): KTyping(G, KnatRec(P2, z, s2, n), Kapp(P, n)) {
  TySub(
    TyRec(
      hP2,
      TySub(hz, TyApp(hP2, TyZero(G)), SbConv(cv_app(hc, CvRefl(Kzero)))),
      TySub(hs, stepTy_typed(hP2), SbConv(conv_stepTy(hc))),
      hn
    ),
    TyApp(hP, hn),
    SbConv(cv_app(CvSymm(hc), CvRefl(n)))
  )
}

pub theorem subject_reduction<G: List(KTm), t: KTm, A: KTm>(
  h: KTyping(G, t, A),
  hw: KWF(G),
  t2: KTm,
  r: Red1(t, t2)
): KTyping(G, t2, A) {
  ⊢ KTyping(G, t2, A) from match h {
    TyVar(G0, i, A0, h0) => ⊢ KTyping(G0, t2, A0) from match r {
    }
    TySort(G0, n) => ⊢ KTyping(G0, t2, Ksort(Succ(n))) from match r {
    }
    TyPi(G0, A0, B0, s1, s2, hA, hB) => ⊢ KTyping(G0, t2, Ksort(imax(s1, s2))) from match r {
      R1PiL(x, x2, y, r1) => TyPi(subject_reduction(hA, hw, x2, r1), conv_ctx(hB, hA, CvStep(r1)))
      R1PiR(x, y, y2, r1) => TyPi(hA, subject_reduction(hB, WfCons(hw, hA), y2, r1))
    }
    TyLam(G0, A0, B0, b0, s, hA, hb) => ⊢ KTyping(G0, t2, Kpi(A0, B0)) from match r {
      R1Lam(x, x2, r1) => TyLam(hA, subject_reduction(hb, WfCons(hw, hA), x2, r1))
    }
    TyApp(G0, f, a, A0, B0, hf, ha) => match r {
      R1Beta(b, a1) => sr_beta1(hf, ha, valid(TyApp(hf, ha), hw))
      R1AppL(f1, f2, a1, r1) => TyApp(subject_reduction(hf, hw, f2, r1), ha)
      R1AppR(f1, a1, a2, r1) => sr_appR(
        hf,
        subject_reduction(ha, hw, a2, r1),
        CvStep(r1),
        valid(TyApp(hf, ha), hw)
      )
    }
    TySub(h0, hB, sb) => TySub(subject_reduction(h0, hw, t2, r), hB, sb)
    TyNat(G0) => ⊢ KTyping(G0, t2, Ksort(1)) from match r {
    }
    TyZero(G0) => ⊢ KTyping(G0, t2, Knat) from match r {
    }
    TySucc(G0, n, h0) => ⊢ KTyping(G0, t2, Knat) from match r {
      R1Succ(x, x2, r1) => TySucc(subject_reduction(h0, hw, x2, r1))
    }
    TyRec(G0, P, z, s2, n, s, hP, hz, hs, hn) => match r {
      R1IotaZ(P1, z1, s1) => hz
      R1IotaS(P1, z1, s1, n1) => {
        let hn1: KTyping(G0, n1, Knat) := succ_inv(hn)
        iota_typing(hs, hn1, TyRec(hP, hz, hs, hn1))
      }
      R1RecP(P1, P2, z1, s1, n1, r1) => sr_recP(
        hP,
        hz,
        hs,
        hn,
        subject_reduction(hP, hw, P2, r1),
        CvStep(r1)
      )
      R1RecZ(P1, z1, z3, s1, n1, r1) => TyRec(hP, subject_reduction(hz, hw, z3, r1), hs, hn)
      R1RecS(P1, z1, s1, s3, n1, r1) => TyRec(hP, hz, subject_reduction(hs, hw, s3, r1), hn)
      R1RecN(P1, z1, s1, n1, n3, r1) => {
        let hn3: KTyping(G0, n3, Knat) := subject_reduction(hn, hw, n3, r1)
        let back: KConv(n3, n) := CvSymm(CvStep(r1))
        TySub(TyRec(hP, hz, hs, hn3), TyApp(hP, hn), SbConv(cv_app(CvRefl(P), back)))
      }
    }
  }
}
