import "../std/Row.taut" { Equiv, Mem, Sub, append, append_comm, append_idem }
import "../std/Std.taut" { plus }
import std::prelude::Std { List }

// A port of lean/Proto/Effects.lean: effect identities and rows. Keys are
// pure arithmetic terms compared by value, an effect is its declaration, type
// parameter, key and tags, and a row contains an effect modulo that
// equivalence. Names are numbers here (tauto has no text type in the kernel).

pub(open) inductive TypeCode: Type {
  Cnat: TypeCode
  Cbool: TypeCode
  Cunit: TypeCode
  Cvector(element: TypeCode, length: Nat): TypeCode
  Ctagged(tags: List(Nat), inner: TypeCode): TypeCode
}

pub(open) inductive KeyTerm: Type {
  Klit(value: Nat): KeyTerm
  Kadd(lhs: KeyTerm, rhs: KeyTerm): KeyTerm
}

pub fn eval(k: KeyTerm): Nat {
  ⊢ Nat from match k {
    Klit(n) => n
    Kadd(x, y) => plus(eval(x), eval(y))
  }
}

pub def KeyEq(x: KeyTerm, y: KeyTerm): Prop := eval(x) = eval(y)

pub theorem one_plus_one_is_two(): KeyEq(Kadd(Klit(1), Klit(1)), Klit(2)) { Refl }

pub(open) inductive EffectId: Type {
  Effid(declaration: Nat, parameter: TypeCode, key: KeyTerm, tags: List(Nat)): EffectId
}

pub fn declaration(x: EffectId): Nat {
  ⊢ Nat from match x {
    Effid(d, p, k, t) => d
  }
}

pub fn parameter(x: EffectId): TypeCode {
  ⊢ TypeCode from match x {
    Effid(d, p, k, t) => p
  }
}

pub fn key(x: EffectId): KeyTerm {
  ⊢ KeyTerm from match x {
    Effid(d, p, k, t) => k
  }
}

pub fn tags(x: EffectId): List(Nat) {
  ⊢ List(Nat) from match x {
    Effid(d, p, k, t) => t
  }
}

pub def TagEq(xs: List(Nat), ys: List(Nat)): Prop := Equiv(Nat, xs, ys)

// Effects are matched by this equivalence, not by subtyping.
pub def EffectEq(x: EffectId, y: EffectId): Prop :=
declaration(x) = declaration(y) ∧
parameter(x) = parameter(y) ∧
KeyEq(key(x), key(y)) ∧
TagEq(tags(x), tags(y))

pub theorem effectEq_refl(x: EffectId): EffectEq(x, x) {
  AndIntro(Refl, AndIntro(Refl, AndIntro(Refl, Equiv::refl(tags(x)))))
}

pub theorem effectEq_symm<x: EffectId, y: EffectId>(h: EffectEq(x, y)): EffectEq(y, x) {
  ⊢ EffectEq(y, x) from match h {
    AndIntro(d, AndIntro(p, AndIntro(k, t))) => AndIntro(
      Eq::sym(d),
      AndIntro(Eq::sym(p), AndIntro(Eq::sym(k), Equiv::symm(Nat, tags(x), tags(y), t)))
    )
  }
}

pub theorem effectEq_trans<x: EffectId, y: EffectId, z: EffectId>(
  h1: EffectEq(x, y),
  h2: EffectEq(y, z)
): EffectEq(x, z) {
  ⊢ EffectEq(x, z) from match h1 {
    AndIntro(d1, AndIntro(p1, AndIntro(k1, t1))) => ⊢ EffectEq(x, z) from match h2 {
      AndIntro(d2, AndIntro(p2, AndIntro(k2, t2))) => AndIntro(
        Eq::trans(d1, d2),
        AndIntro(
          Eq::trans(p1, p2),
          AndIntro(Eq::trans(k1, k2), Equiv::trans(Nat, tags(x), tags(y), tags(z), t1, t2))
        )
      )
    }
  }
}

pub(open) inductive RowContains(row: List(EffectId), target: EffectId): Prop {
  RcIntro<member: EffectId>(
    m: Mem(EffectId, member, row),
    e: EffectEq(member, target)
  ): RowContains(row, target)
}

pub def RowEq(a: List(EffectId), b: List(EffectId)): Prop :=
∀ e: EffectId. RowContains(a, e) ↔ RowContains(b, e)

// Membership modulo equivalence follows membership: a row with the same members
// (`Equiv` of std/Row.taut) is an equal row.
pub theorem rc_sub<a: List(EffectId), b: List(EffectId), e: EffectId>(
  s: Sub(EffectId, a, b),
  h: RowContains(a, e)
): RowContains(b, e) {
  ⊢ RowContains(b, e) from match h {
    RcIntro(member, m, q) => RcIntro(s(member, m), q)
  }
}

pub theorem rowEq_of_equiv<a: List(EffectId), b: List(EffectId)>(
  h: Equiv(EffectId, a, b)
): RowEq(a, b) {
  ⊢ RowEq(a, b) from match h {
    AndIntro(l, r) => e => IffIntro(x => rc_sub(l, x), x => rc_sub(r, x))
  }
}

pub theorem rowEq_refl(a: List(EffectId)): RowEq(a, a) {
  e => IffIntro(h => h, h => h)
}

pub theorem rowEq_symm<a: List(EffectId), b: List(EffectId)>(h: RowEq(a, b)): RowEq(b, a) {
  e => IffIntro(x => Iff::mpr(h(e), x), x => Iff::mp(h(e), x))
}

pub theorem rowEq_trans<a: List(EffectId), b: List(EffectId), c: List(EffectId)>(
  h1: RowEq(a, b),
  h2: RowEq(b, c)
): RowEq(a, c) {
  e => IffIntro(x => Iff::mp(h2(e), Iff::mp(h1(e), x)), x => Iff::mpr(h1(e), Iff::mpr(h2(e), x)))
}

// An unordered row union needs no normalization in the logic.
pub theorem row_union_comm(
  a: List(EffectId),
  b: List(EffectId)
): RowEq(append(EffectId, a, b), append(EffectId, b, a)) {
  rowEq_of_equiv(append_comm(a, b))
}

pub theorem row_union_idempotent(a: List(EffectId)): RowEq(append(EffectId, a, a), a) {
  rowEq_of_equiv(append_idem(a))
}

pub theorem tag_order_does_not_change_effect(
  x: EffectId,
  extra: List(Nat)
): EffectEq(
  Effid(declaration(x), parameter(x), key(x), append(Nat, tags(x), extra)),
  Effid(declaration(x), parameter(x), key(x), append(Nat, extra, tags(x)))
) {
  AndIntro(Refl, AndIntro(Refl, AndIntro(Refl, append_comm(tags(x), extra))))
}
