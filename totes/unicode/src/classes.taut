import std::base
import std::map
import "unicode.taut"
import "../../text/src/text.taut"
import "tables.taut"
// The classes from the tables of `tables.taut`. The tables are data: the
// proofs take them as given and say nothing about what they hold.
pub fn unicode_classes(): UnicodeClasses {
  unicode_classes_of(unicode_table_alphanumeric(), unicode_table_whitespace())
}

// What `char::to_lowercase` changes, from the table of `tables.taut`.
pub fn unicode_lowercase(): Ordmap(Nat, List(Nat)) {
  unicode_lowercase_of(unicode_table_lowercase())
}

// XID_Continue from U+0080 (`tauto-parol`'s `unicode::is_ident_continue`),
// as ranges, from the table of `tables.taut`.
pub fn unicode_xid_continue(): Ordmap(Nat, Nat) {
  unicode_ranges(text_split(unicode_table_xid_continue(), " "), None, Ordmap::empty())
}
