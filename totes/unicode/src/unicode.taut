import std::Base
import std::Map
import "../../ordmap/src/ordmap.taut"
import "../../text/src/text.taut"

// Which characters are letters or digits, and which are white space, as
// Rust's `char::is_alphanumeric` and `char::is_whitespace` say
// (`docs/design/self-host.md`「text と unicode（`totes/text`、`totes/unicode`）」). The ASCII ones are decided here; the others by the
// ranges of the tables that `tables.taut` holds and `classes.taut` passes in.

pub(open) inductive UnicodeClasses: Type {
  UnicodeClassesWith(alphanumeric: Ordmap(Nat, Nat), whitespace: Ordmap(Nat, Nat)): UnicodeClasses
}

pub fn unicode_number(t: Text): Nat {
  ⊢ Nat from match text_parse_u64(t) {
    None => 0
    Some(n) => n
  }
}

// The ranges of a table ("start end start end …", both ends in) by start;
// `first` is the start read before the end that comes next.
pub fn unicode_ranges(
  numbers: List(Text),
  first: Option(Nat),
  done: Ordmap(Nat, Nat)
): Ordmap(Nat, Nat) {
  ⊢ Ordmap(Nat, Nat) from match numbers {
    Nil => done
    Cons(n, rest) => ⊢ Ordmap(Nat, Nat) from match first {
      None => unicode_ranges(rest, Some(unicode_number(n)), done)
      Some(start) => unicode_ranges(
        rest,
        None,
        Ordmap::insert(done, start, unicode_number(n), Ordmap::compare_nat)
      )
    }
  }
}

pub fn unicode_classes_of(alphanumeric: Text, whitespace: Text): UnicodeClasses {
  UnicodeClassesWith(
    unicode_ranges(text_split(alphanumeric, " "), None, Ordmap::empty()),
    unicode_ranges(text_split(whitespace, " "), None, Ordmap::empty())
  )
}

pub fn unicode_in(ranges: Ordmap(Nat, Nat), c: Nat): Bool {
  ⊢ Bool from match Ordmap::floor(ranges, c, Ordmap::compare_nat) {
    None => false
    Some(range) => ⊢ Bool from match range {
      Pair { fst: start, snd: last } => Nat::le(c, last)
    }
  }
}

pub fn unicode_is_alphanumeric(classes: UnicodeClasses, c: Nat): Bool {
  ⊢ Bool from match Nat::lt(c, 128) {
    true => Bool::or(
      Bool::and(Nat::le(48, c), Nat::le(c, 57)),
      Bool::or(
        Bool::and(Nat::le(65, c), Nat::le(c, 90)),
        Bool::and(Nat::le(97, c), Nat::le(c, 122))
      )
    )
    false => ⊢ Bool from match classes {
      UnicodeClassesWith(alphanumeric, whitespace) => unicode_in(alphanumeric, c)
    }
  }
}

pub fn unicode_is_whitespace(classes: UnicodeClasses, c: Nat): Bool {
  ⊢ Bool from match Nat::lt(c, 128) {
    true => Bool::or(Nat::eq(c, 32), Bool::and(Nat::le(9, c), Nat::le(c, 13)))
    false => ⊢ Bool from match classes {
      UnicodeClassesWith(alphanumeric, whitespace) => unicode_in(whitespace, c)
    }
  }
}
