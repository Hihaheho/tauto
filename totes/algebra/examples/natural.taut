import "../src/Hom.taut"
import std::Nat

pub def natural_addition(): AlgebraMonoid(
  0,
  Nat
) := AlgebraMonoid::Mk(<u: 0, A: Nat>,
  Zero,
  Nat::add,
  x => y => z => algebra_from_eq(Nat::add_assoc(x, y, z)),
  x => algebra_from_eq(Nat::add_zero_left(x)),
  x => AlgebraRefl(<u: 0, A: Nat, a: x>)
)

pub def natural_multiplication(): AlgebraMonoid(
  0,
  Nat
) := AlgebraMonoid::Mk(<u: 0, A: Nat>,
  Succ(Zero),
  Nat::mul,
  x => y => z => algebra_from_eq(Nat::mul_assoc(x, y, z)),
  x => algebra_from_eq(Nat::mul_one_left(x)),
  x => algebra_from_eq(Nat::mul_one_right(x))
)

pub theorem addition_unit(): AlgebraEq(
  0,
  Nat,
  algebra_unit(<u: 0, A: Nat>, natural_addition),
  Zero
) { AlgebraRefl(<u: 0, A: Nat, a: Zero>) }
pub theorem multiplication_unit(): AlgebraEq(
  0,
  Nat,
  algebra_unit(<u: 0, A: Nat>, natural_multiplication),
  Succ(Zero)
) { AlgebraRefl(<u: 0, A: Nat, a: Succ(Zero)>) }

pub def additive_zero_map(): AlgebraHom(
  0,
  0,
  Nat,
  Nat,
  natural_addition,
  natural_addition
) := AlgebraHom::Mk(<u: 0, v: 0, A: Nat, B: Nat, source: natural_addition, target: natural_addition>,
  x => Zero,
  AlgebraRefl(<u: 0, A: Nat, a: Zero>),
  x => y => AlgebraRefl(<u: 0, A: Nat, a: Zero>)
)

pub theorem compose_zero_identity(
  n: Nat
): AlgebraEq(
  0,
  Nat,
  algebra_map(<u: 0, v: 0, A: Nat, B: Nat, source: natural_addition, target: natural_addition>,
    algebra_compose(<u: 0, v: 0, w: 0, A: Nat, B: Nat, C: Nat, source: natural_addition, middle: natural_addition, target: natural_addition>,
      additive_zero_map,
      algebra_identity(<u: 0, A: Nat>, natural_addition)
    )
  )(n),
  Zero
) { AlgebraRefl(<u: 0, A: Nat, a: Zero>) }

import "../src/Linear.taut"
import "../src/Equality.taut"
import "../src/Finite.taut"
import "../src/Matrix.taut"
import "../src/Monoid.taut"
import "../src/Semiring.taut"
import std::Base

pub theorem natural_semiring(): AlgebraSemiring(Nat, natural_addition, natural_multiplication) {
  AlgebraSemiring::Mk(<R: Nat, addition: natural_addition, multiplication: natural_multiplication>,
    x => y => algebra_from_eq(Nat::add_comm(x, y)),
    x => y => z => algebra_from_eq(Nat::mul_add_distrib(x, y, z)),
    x => y => z => algebra_from_eq(Nat::mul_add_distrib_right(x, y, z)),
    x => algebra_from_eq(Nat::mul_zero_left(x)),
    x => algebra_from_eq(Nat::mul_zero_right(x))
  )
}

pub fn natural_matrix(
  rows: Nat,
  columns: Nat,
  row: AlgebraFin(rows),
  column: AlgebraFin(columns)
): Nat {
  Succ(Nat::add(algebra_fin_value(rows, row), algebra_fin_value(columns, column)))
}

pub theorem natural_rectangular_action(): AlgebraEq(
  0,
  Nat,
  algebra_matrix_apply(<R: Nat>,
    natural_addition,
    natural_multiplication,
    2,
    3,
    row => column => natural_matrix(2, 3, row, column),
    column => 1
  )(AlgebraNext(1, AlgebraFirst(0))),
  9
) {
  AlgebraRefl(<u: 0, A: Nat, a: 9>)
}

pub theorem natural_rectangular_product(): AlgebraEq(
  0,
  Nat,
  algebra_matrix_product(<R: Nat>,
    natural_addition,
    natural_multiplication,
    2,
    3,
    4,
    row => column => natural_matrix(2, 3, row, column),
    row => column => natural_matrix(3, 4, row, column)
  )(AlgebraNext(1, AlgebraFirst(0)), AlgebraNext(3, AlgebraNext(2, AlgebraFirst(1)))),
  38
) {
  AlgebraRefl(<u: 0, A: Nat, a: 38>)
}

pub theorem natural_empty_sum(): AlgebraEq(
  0,
  Nat,
  algebra_sum(<R: Nat>, natural_addition, 0, index => 7),
  0
) {
  AlgebraRefl(<u: 0, A: Nat, a: 0>)
}

pub theorem natural_empty_inner_product(): AlgebraEq(
  0,
  Nat,
  algebra_matrix_product(<R: Nat>,
    natural_addition,
    natural_multiplication,
    1,
    0,
    1,
    row => column => 8,
    row => column => 9
  )(AlgebraFirst(0), AlgebraFirst(0)),
  0
) {
  AlgebraRefl(<u: 0, A: Nat, a: 0>)
}

pub theorem natural_matrix_is_linear(
  rows: Nat,
  columns: Nat
): AlgebraLinear(
  Nat,
  natural_addition,
  natural_multiplication,
  columns,
  rows,
  values => algebra_matrix_apply(<R: Nat>,
    natural_addition,
    natural_multiplication,
    rows,
    columns,
    row => column => natural_matrix(rows, columns, row, column),
    values
  )
) {
  algebra_matrix_linear(
    natural_semiring,
    rows,
    columns,
    row => column => natural_matrix(rows, columns, row, column)
  )
}

pub theorem natural_finite_sum(): AlgebraEq(
  0,
  Nat,
  algebra_sum(<R: Nat>, natural_addition, 5, index => algebra_fin_value(5, index)),
  10
) {
  AlgebraRefl(<u: 0, A: Nat, a: 10>)
}

pub theorem natural_matrix_addition(): AlgebraEq(
  0,
  Nat,
  algebra_matrix_add(<R: Nat>,
    natural_addition,
    2,
    3,
    row => column => natural_matrix(2, 3, row, column),
    row => column => natural_matrix(2, 3, row, column)
  )(AlgebraNext(1, AlgebraFirst(0)), AlgebraNext(2, AlgebraNext(1, AlgebraFirst(0)))),
  8
) {
  AlgebraRefl(<u: 0, A: Nat, a: 8>)
}

pub theorem natural_matrix_scaling(): AlgebraEq(
  0,
  Nat,
  algebra_matrix_scale(<R: Nat>,
    natural_multiplication,
    2,
    3,
    row => column => natural_matrix(2, 3, row, column),
    3
  )(AlgebraNext(1, AlgebraFirst(0)), AlgebraNext(2, AlgebraNext(1, AlgebraFirst(0)))),
  12
) {
  AlgebraRefl(<u: 0, A: Nat, a: 12>)
}
