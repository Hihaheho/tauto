import "../src/Group.taut"
import "../src/Equality.taut"
import "../src/Monoid.taut"

pub(open) inductive AlgebraBit: Type { BitZero: AlgebraBit
  BitOne: AlgebraBit }

pub def bit_flip(x: AlgebraBit): AlgebraBit := AlgebraBit::rec(x => AlgebraBit, BitOne, BitZero, x)
pub def bit_xor(
  x: AlgebraBit,
  y: AlgebraBit
): AlgebraBit := AlgebraBit::rec(x => AlgebraBit, y, bit_flip(y), x)

pub theorem bit_assoc(
  x: AlgebraBit,
  y: AlgebraBit,
  z: AlgebraBit
): AlgebraEq(0, AlgebraBit, bit_xor(bit_xor(x, y), z), bit_xor(x, bit_xor(y, z))) {
  ⊢ AlgebraEq(0, AlgebraBit, bit_xor(bit_xor(x, y), z), bit_xor(x, bit_xor(y, z))) from match x {
    BitZero => ⊢ AlgebraEq(
      0,
      AlgebraBit,
      bit_xor(bit_xor(BitZero, y), z),
      bit_xor(BitZero, bit_xor(y, z))
    ) from match y {
      BitZero => ⊢ AlgebraEq(
        0,
        AlgebraBit,
        bit_xor(bit_xor(BitZero, BitZero), z),
        bit_xor(BitZero, bit_xor(BitZero, z))
      ) from match z {
        BitZero => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(bit_xor(BitZero, BitZero), BitZero)>)
        BitOne => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(bit_xor(BitZero, BitZero), BitOne)>)
      }
      BitOne => ⊢ AlgebraEq(
        0,
        AlgebraBit,
        bit_xor(bit_xor(BitZero, BitOne), z),
        bit_xor(BitZero, bit_xor(BitOne, z))
      ) from match z {
        BitZero => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(bit_xor(BitZero, BitOne), BitZero)>)
        BitOne => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(bit_xor(BitZero, BitOne), BitOne)>)
      }
    }
    BitOne => ⊢ AlgebraEq(
      0,
      AlgebraBit,
      bit_xor(bit_xor(BitOne, y), z),
      bit_xor(BitOne, bit_xor(y, z))
    ) from match y {
      BitZero => ⊢ AlgebraEq(
        0,
        AlgebraBit,
        bit_xor(bit_xor(BitOne, BitZero), z),
        bit_xor(BitOne, bit_xor(BitZero, z))
      ) from match z {
        BitZero => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(bit_xor(BitOne, BitZero), BitZero)>)
        BitOne => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(bit_xor(BitOne, BitZero), BitOne)>)
      }
      BitOne => ⊢ AlgebraEq(
        0,
        AlgebraBit,
        bit_xor(bit_xor(BitOne, BitOne), z),
        bit_xor(BitOne, bit_xor(BitOne, z))
      ) from match z {
        BitZero => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(bit_xor(BitOne, BitOne), BitZero)>)
        BitOne => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(bit_xor(BitOne, BitOne), BitOne)>)
      }
    }
  }
}

pub theorem bit_left(x: AlgebraBit): AlgebraEq(0, AlgebraBit, bit_xor(BitZero, x), x) {
  ⊢ AlgebraEq(0, AlgebraBit, bit_xor(BitZero, x), x) from match x {
    BitZero => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(BitZero, BitZero)>)
    BitOne => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(BitZero, BitOne)>)
  }
}

pub theorem bit_right(x: AlgebraBit): AlgebraEq(0, AlgebraBit, bit_xor(x, BitZero), x) {
  ⊢ AlgebraEq(0, AlgebraBit, bit_xor(x, BitZero), x) from match x {
    BitZero => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(BitZero, BitZero)>)
    BitOne => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(BitOne, BitZero)>)
  }
}

pub theorem bit_inverse(x: AlgebraBit): AlgebraEq(0, AlgebraBit, bit_xor(x, x), BitZero) {
  ⊢ AlgebraEq(0, AlgebraBit, bit_xor(x, x), BitZero) from match x {
    BitZero => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(BitZero, BitZero)>)
    BitOne => AlgebraRefl(<u: 0, A: AlgebraBit, a: bit_xor(BitOne, BitOne)>)
  }
}

pub def bit_monoid(): AlgebraMonoid(
  0,
  AlgebraBit
) := AlgebraMonoid::Mk(<u: 0, A: AlgebraBit>, BitZero, bit_xor, bit_assoc, bit_left, bit_right)
pub theorem bit_group(): AlgebraGroup(
  0,
  AlgebraBit,
  bit_monoid,
  x => x
) { AlgebraGroup::Mk(<u: 0, A: AlgebraBit, m: bit_monoid, inverse: (x => x)>, bit_inverse, bit_inverse) }
pub theorem bit_cancel(
  a: AlgebraBit,
  b: AlgebraBit,
  c: AlgebraBit,
  h: AlgebraEq(0, AlgebraBit, bit_xor(a, b), bit_xor(a, c))
): AlgebraEq(
  0,
  AlgebraBit,
  b,
  c
) { algebra_cancel_left(<u: 0, A: AlgebraBit, m: bit_monoid, inverse: (x => x)>, bit_group, a, b, c, h) }
