import "../src/Hom.taut"

pub(open) inductive AlgebraOne(u: Level): Type(u) { Mk: AlgebraOne(u) }

pub theorem one_unique<u: Level>(
  x: AlgebraOne(u)
): AlgebraEq(u, AlgebraOne(u), AlgebraOne::Mk(u), x) {
  AlgebraOne::ind(
    u,
    y => AlgebraEq(u, AlgebraOne(u), AlgebraOne::Mk(u), y),
    AlgebraRefl(u, AlgebraOne(u), AlgebraOne::Mk(u)),
    x
  )
}

pub def one_monoid<u: Level>(): AlgebraMonoid(
  u,
  AlgebraOne(u)
) := AlgebraMonoid::Mk(
  u,
  AlgebraOne(u),
  AlgebraOne::Mk(u),
  x => y => AlgebraOne::Mk(u),
  x => y => z => AlgebraRefl(u, AlgebraOne(u), AlgebraOne::Mk(u)),
  one_unique(u),
  one_unique(u)
)

pub def one_cross_universe(): AlgebraHom(
  1,
  2,
  AlgebraOne(1),
  AlgebraOne(2),
  one_monoid(1),
  one_monoid(2)
) := AlgebraHom::Mk(
  1,
  2,
  AlgebraOne(1),
  AlgebraOne(2),
  one_monoid(1),
  one_monoid(2),
  x => AlgebraOne::Mk(2),
  AlgebraRefl(2, AlgebraOne(2), AlgebraOne::Mk(2)),
  x => y => AlgebraRefl(2, AlgebraOne(2), AlgebraOne::Mk(2))
)

pub theorem high_unit(): AlgebraEq(
  2,
  AlgebraOne(2),
  algebra_unit(2, AlgebraOne(2), one_monoid(2)),
  AlgebraOne::Mk(2)
) { AlgebraRefl(2, AlgebraOne(2), AlgebraOne::Mk(2)) }

pub theorem high_map(): AlgebraEq(
  2,
  AlgebraOne(2),
  algebra_map(
    1,
    2,
    AlgebraOne(1),
    AlgebraOne(2),
    one_monoid(1),
    one_monoid(2),
    one_cross_universe
  )(AlgebraOne::Mk(1)),
  AlgebraOne::Mk(2)
) { AlgebraRefl(2, AlgebraOne(2), AlgebraOne::Mk(2)) }

pub theorem equality_of_types(): AlgebraEq(2, Type1, Type, Type) { AlgebraRefl(2, Type1, Type) }

import "../src/Group.taut"

pub theorem one_group<u: Level>(): AlgebraGroup(u, AlgebraOne(u), one_monoid(u), x => x) {
  AlgebraGroup::Mk(
    u,
    AlgebraOne(u),
    one_monoid(u),
    x => x,
    x => AlgebraRefl(u, AlgebraOne(u), AlgebraOne::Mk(u)),
    x => AlgebraRefl(u, AlgebraOne(u), AlgebraOne::Mk(u))
  )
}

pub theorem high_cancel(
  a: AlgebraOne(2),
  b: AlgebraOne(2),
  c: AlgebraOne(2)
): AlgebraEq(2, AlgebraOne(2), b, c) {
  algebra_cancel_left(
    2,
    AlgebraOne(2),
    one_monoid(2),
    x => x,
    one_group(2),
    a,
    b,
    c,
    AlgebraRefl(2, AlgebraOne(2), AlgebraOne::Mk(2))
  )
}

pub theorem high_inverse_unique(
  a: AlgebraOne(2),
  b: AlgebraOne(2)
): AlgebraEq(2, AlgebraOne(2), b, a) {
  algebra_inverse_unique(
    2,
    AlgebraOne(2),
    one_monoid(2),
    x => x,
    one_group(2),
    a,
    b,
    AlgebraRefl(2, AlgebraOne(2), AlgebraOne::Mk(2))
  )
}

pub theorem high_composition(
  x: AlgebraOne(1)
): AlgebraEq(
  2,
  AlgebraOne(2),
  algebra_map(
    1,
    2,
    AlgebraOne(1),
    AlgebraOne(2),
    one_monoid(1),
    one_monoid(2),
    algebra_compose(
      1,
      2,
      2,
      AlgebraOne(1),
      AlgebraOne(2),
      AlgebraOne(2),
      one_monoid(1),
      one_monoid(2),
      one_monoid(2),
      one_cross_universe,
      algebra_identity(2, AlgebraOne(2), one_monoid(2))
    )
  )(x),
  algebra_map(
    1,
    2,
    AlgebraOne(1),
    AlgebraOne(2),
    one_monoid(1),
    one_monoid(2),
    one_cross_universe
  )(x)
) {
  algebra_identity_right(
    1,
    2,
    AlgebraOne(1),
    AlgebraOne(2),
    one_monoid(1),
    one_monoid(2),
    one_cross_universe,
    x
  )
}

pub theorem high_associativity(
  x: AlgebraOne(1)
): AlgebraEq(
  2,
  AlgebraOne(2),
  algebra_map(
    1,
    2,
    AlgebraOne(1),
    AlgebraOne(2),
    one_monoid(1),
    one_monoid(2),
    algebra_compose(
      1,
      2,
      2,
      AlgebraOne(1),
      AlgebraOne(2),
      AlgebraOne(2),
      one_monoid(1),
      one_monoid(2),
      one_monoid(2),
      algebra_compose(
        1,
        2,
        2,
        AlgebraOne(1),
        AlgebraOne(2),
        AlgebraOne(2),
        one_monoid(1),
        one_monoid(2),
        one_monoid(2),
        one_cross_universe,
        algebra_identity(2, AlgebraOne(2), one_monoid(2))
      ),
      algebra_identity(2, AlgebraOne(2), one_monoid(2))
    )
  )(x),
  algebra_map(
    1,
    2,
    AlgebraOne(1),
    AlgebraOne(2),
    one_monoid(1),
    one_monoid(2),
    algebra_compose(
      1,
      2,
      2,
      AlgebraOne(1),
      AlgebraOne(2),
      AlgebraOne(2),
      one_monoid(1),
      one_monoid(2),
      one_monoid(2),
      one_cross_universe,
      algebra_compose(
        2,
        2,
        2,
        AlgebraOne(2),
        AlgebraOne(2),
        AlgebraOne(2),
        one_monoid(2),
        one_monoid(2),
        one_monoid(2),
        algebra_identity(2, AlgebraOne(2), one_monoid(2)),
        algebra_identity(2, AlgebraOne(2), one_monoid(2))
      )
    )
  )(x)
) {
  algebra_compose_assoc(
    1,
    2,
    2,
    2,
    AlgebraOne(1),
    AlgebraOne(2),
    AlgebraOne(2),
    AlgebraOne(2),
    one_monoid(1),
    one_monoid(2),
    one_monoid(2),
    one_monoid(2),
    one_cross_universe,
    algebra_identity(2, AlgebraOne(2), one_monoid(2)),
    algebra_identity(2, AlgebraOne(2), one_monoid(2)),
    x
  )
}
