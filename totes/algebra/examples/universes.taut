import "../src/Hom.taut"

pub(open) inductive AlgebraOne(u: Level): Type(u) { Mk: AlgebraOne(u) }

pub theorem one_unique<u: Level>(
  x: AlgebraOne(u)
): AlgebraEq(u, AlgebraOne(u), AlgebraOne::Mk(u), x) {
  AlgebraOne::ind(
    u,
    y => AlgebraEq(u, AlgebraOne(u), AlgebraOne::Mk(u), y),
    AlgebraRefl(<u: u, A: AlgebraOne(u), a: AlgebraOne::Mk(u)>),
    x
  )
}

pub def one_monoid<u: Level>(): AlgebraMonoid(
  u,
  AlgebraOne(u)
) := AlgebraMonoid::Mk(<u: u, A: AlgebraOne(u)>,
  AlgebraOne::Mk(u),
  x => y => AlgebraOne::Mk(u),
  x => y => z => AlgebraRefl(<u: u, A: AlgebraOne(u), a: AlgebraOne::Mk(u)>),
  one_unique(u),
  one_unique(u)
)

pub def one_cross_universe(): AlgebraHom(
  1,
  2,
  AlgebraOne(1),
  AlgebraOne(2),
  one_monoid(<u: 1>),
  one_monoid(<u: 2>)
) := AlgebraHom::Mk(<u: 1, v: 2, A: AlgebraOne(1), B: AlgebraOne(2), source: one_monoid(<u: 1>), target: one_monoid(<u: 2>)>,
  x => AlgebraOne::Mk(2),
  AlgebraRefl(<u: 2, A: AlgebraOne(2), a: AlgebraOne::Mk(2)>),
  x => y => AlgebraRefl(<u: 2, A: AlgebraOne(2), a: AlgebraOne::Mk(2)>)
)

pub theorem high_unit(): AlgebraEq(
  2,
  AlgebraOne(2),
  algebra_unit(<u: 2, A: AlgebraOne(2)>, one_monoid(<u: 2>)),
  AlgebraOne::Mk(2)
) { AlgebraRefl(<u: 2, A: AlgebraOne(2), a: AlgebraOne::Mk(2)>) }

pub theorem high_map(): AlgebraEq(
  2,
  AlgebraOne(2),
  algebra_map(<u: 1, v: 2, A: AlgebraOne(1), B: AlgebraOne(2), source: one_monoid(<u: 1>), target: one_monoid(<u: 2>)>,
    one_cross_universe
  )(AlgebraOne::Mk(1)),
  AlgebraOne::Mk(2)
) { AlgebraRefl(<u: 2, A: AlgebraOne(2), a: AlgebraOne::Mk(2)>) }

pub theorem equality_of_types(): AlgebraEq(2, Type1, Type, Type) { AlgebraRefl(<u: 2, A: Type1, a: Type>) }

import "../src/Group.taut"
import "../src/Equality.taut"
import "../src/Monoid.taut"

pub theorem one_group<u: Level>(): AlgebraGroup(u, AlgebraOne(u), one_monoid(<u: u>), x => x) {
  AlgebraGroup::Mk(<u: u, A: AlgebraOne(u), m: one_monoid(<u: u>), inverse: (x => x)>,
    x => AlgebraRefl(<u: u, A: AlgebraOne(u), a: AlgebraOne::Mk(u)>),
    x => AlgebraRefl(<u: u, A: AlgebraOne(u), a: AlgebraOne::Mk(u)>)
  )
}

pub theorem high_cancel(
  a: AlgebraOne(2),
  b: AlgebraOne(2),
  c: AlgebraOne(2)
): AlgebraEq(2, AlgebraOne(2), b, c) {
  algebra_cancel_left(<u: 2, A: AlgebraOne(2), m: one_monoid(<u: 2>), inverse: (x => x)>,
    one_group(<u: 2>),
    a,
    b,
    c,
    AlgebraRefl(<u: 2, A: AlgebraOne(2), a: AlgebraOne::Mk(2)>)
  )
}

pub theorem high_inverse_unique(
  a: AlgebraOne(2),
  b: AlgebraOne(2)
): AlgebraEq(2, AlgebraOne(2), b, a) {
  algebra_inverse_unique(<u: 2, A: AlgebraOne(2), m: one_monoid(<u: 2>), inverse: (x => x)>,
    one_group(<u: 2>),
    a,
    b,
    AlgebraRefl(<u: 2, A: AlgebraOne(2), a: AlgebraOne::Mk(2)>)
  )
}

pub theorem high_composition(
  x: AlgebraOne(1)
): AlgebraEq(
  2,
  AlgebraOne(2),
  algebra_map(<u: 1, v: 2, A: AlgebraOne(1), B: AlgebraOne(2), source: one_monoid(<u: 1>), target: one_monoid(<u: 2>)>,
    algebra_compose(<u: 1, v: 2, w: 2, A: AlgebraOne(1), B: AlgebraOne(2), C: AlgebraOne(2), source: one_monoid(<u: 1>), middle: one_monoid(<u: 2>), target: one_monoid(<u: 2>)>,
      one_cross_universe,
      algebra_identity(<u: 2, A: AlgebraOne(2)>, one_monoid(<u: 2>))
    )
  )(x),
  algebra_map(<u: 1, v: 2, A: AlgebraOne(1), B: AlgebraOne(2), source: one_monoid(<u: 1>), target: one_monoid(<u: 2>)>,
    one_cross_universe
  )(x)
) {
  algebra_identity_right(<u: 1, v: 2, A: AlgebraOne(1), B: AlgebraOne(2), source: one_monoid(<u: 1>), target: one_monoid(<u: 2>)>,
    one_cross_universe,
    x
  )
}

pub theorem high_associativity(
  x: AlgebraOne(1)
): AlgebraEq(
  2,
  AlgebraOne(2),
  algebra_map(<u: 1, v: 2, A: AlgebraOne(1), B: AlgebraOne(2), source: one_monoid(<u: 1>), target: one_monoid(<u: 2>)>,
    algebra_compose(<u: 1, v: 2, w: 2, A: AlgebraOne(1), B: AlgebraOne(2), C: AlgebraOne(2), source: one_monoid(<u: 1>), middle: one_monoid(<u: 2>), target: one_monoid(<u: 2>)>,
      algebra_compose(<u: 1, v: 2, w: 2, A: AlgebraOne(1), B: AlgebraOne(2), C: AlgebraOne(2), source: one_monoid(<u: 1>), middle: one_monoid(<u: 2>), target: one_monoid(<u: 2>)>,
        one_cross_universe,
        algebra_identity(<u: 2, A: AlgebraOne(2)>, one_monoid(<u: 2>))
      ),
      algebra_identity(<u: 2, A: AlgebraOne(2)>, one_monoid(<u: 2>))
    )
  )(x),
  algebra_map(<u: 1, v: 2, A: AlgebraOne(1), B: AlgebraOne(2), source: one_monoid(<u: 1>), target: one_monoid(<u: 2>)>,
    algebra_compose(<u: 1, v: 2, w: 2, A: AlgebraOne(1), B: AlgebraOne(2), C: AlgebraOne(2), source: one_monoid(<u: 1>), middle: one_monoid(<u: 2>), target: one_monoid(<u: 2>)>,
      one_cross_universe,
      algebra_compose(<u: 2, v: 2, w: 2, A: AlgebraOne(2), B: AlgebraOne(2), C: AlgebraOne(2), source: one_monoid(<u: 2>), middle: one_monoid(<u: 2>), target: one_monoid(<u: 2>)>,
        algebra_identity(<u: 2, A: AlgebraOne(2)>, one_monoid(<u: 2>)),
        algebra_identity(<u: 2, A: AlgebraOne(2)>, one_monoid(<u: 2>))
      )
    )
  )(x)
) {
  algebra_compose_assoc(<u: 1, v: 2, w: 2, t: 2, A: AlgebraOne(1), B: AlgebraOne(2), C: AlgebraOne(2), D: AlgebraOne(2), ma: one_monoid(<u: 1>), mb: one_monoid(<u: 2>), mc: one_monoid(<u: 2>), md: one_monoid(<u: 2>)>,
    one_cross_universe,
    algebra_identity(<u: 2, A: AlgebraOne(2)>, one_monoid(<u: 2>)),
    algebra_identity(<u: 2, A: AlgebraOne(2)>, one_monoid(<u: 2>)),
    x
  )
}
