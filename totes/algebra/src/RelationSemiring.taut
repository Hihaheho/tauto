) -> R>(
  laws: AlgebraRelationSemiring(R, related, zero_value, one_value, add, mul)
): ∀ x: R. ∀ y: R. ∀ z: R. related(mul(x, add(y, z)), add(mul(x, y), mul(x, z))) {
  match laws: ∀ x: R. ∀ y: R. ∀ z: R. related(mul(x, add(y, z)), add(mul(x, y), mul(x, z))) {
    Mk(
      equivalence,
      add_respects,
      mul_respects,
      add_assoc,
      add_comm,
      add_zero_left,
      add_zero_right,
      mul_assoc,
      mul_one_left,
      mul_one_right,
      distribute_left,
      distribute_right,
      mul_zero_left,
      mul_zero_right
    ) => distribute_left
  }
}

