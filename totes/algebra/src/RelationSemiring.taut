pub theorem algebra_relation_refl<R: Type, related: (
  R,
  R
) -> Prop>(equivalence: AlgebraSetoid(R, related), x: R): related(x, x) {
  match equivalence: related(x, x) {
    Mk(reflexive, symmetric, transitive) => reflexive(x)
  }
}

pub theorem algebra_relation_sym<R: Type, related: (
  R,
  R
) -> Prop>(
  equivalence: AlgebraSetoid(R, related),
  x: R,
  y: R,
  equal: related(x, y)
): related(y, x) {
  match equivalence: related(y, x) {
    Mk(reflexive, symmetric, transitive) => symmetric(x, y, equal)
  }
}

pub theorem algebra_relation_trans<R: Type, related: (
  R,
  R
) -> Prop>(
  equivalence: AlgebraSetoid(R, related),
  x: R,
  y: R,
  z: R,
  first: related(x, y),
  second: related(y, z)
): related(x, z) {
  match equivalence: related(x, z) {
    Mk(reflexive, symmetric, transitive) => transitive(x, y, z, first, second)
  }
}
