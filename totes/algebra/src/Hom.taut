import "Monoid.taut"
import "Equality.taut"

pub def AlgebraFunction<u: Level, v: Level>(A: Type(u), B: Type(v)): Type(max(u, v)) := (A) -> B

pub(open) inductive AlgebraHom(
  u: Level,
  v: Level,
  A: Type(u),
  B: Type(v),
  source: AlgebraMonoid(u, A),
  target: AlgebraMonoid(v, B)
): Type(max(u, v)) {
  Mk(
    map: (A) -> B,
    unit: AlgebraEq(v, B, map(algebra_unit(<u: u, A: A>, source)), algebra_unit(<u: v, A: B>, target)),
    mul: ∀ x: A. ∀ y: A. AlgebraEq(
      v,
      B,
      map(algebra_op(<u: u, A: A>, source)(x, y)),
      algebra_op(<u: v, A: B>, target)(map(x), map(y))
    )
  ): AlgebraHom(u, v, A, B, source, target)
}

pub def algebra_hom_elim<u: Level, v: Level>(): ∀ A: Type(
  u
). ∀ B: Type(
  v
). ∀ source: AlgebraMonoid(
  u,
  A
). ∀ target: AlgebraMonoid(
  v,
  B
). ∀ motive: (
  AlgebraHom(u, v, A, B, source, target)
) -> Type(
  max(u, v)
). (
  ∀ map: (
    A
  ) -> B. ∀ unit: AlgebraEq(
    v,
    B,
    map(algebra_unit(<u: u, A: A>, source)),
    algebra_unit(<u: v, A: B>, target)
  ). ∀ mul: (
    ∀ x: A. ∀ y: A. AlgebraEq(
      v,
      B,
      map(algebra_op(<u: u, A: A>, source)(x, y)),
      algebra_op(<u: v, A: B>, target)(map(x), map(y))
    )
  ). motive(AlgebraHom::Mk(<u: u, v: v, A: A, B: B, source: source, target: target>, map, unit, mul))
) -> (
  ∀ h: AlgebraHom(u, v, A, B, source, target). motive(h)
) := recursor(AlgebraHom(u, v), max(u, v))

pub def algebra_map<u: Level, v: Level, A: Type(
  u
), B: Type(
  v
), source: AlgebraMonoid(
  u,
  A
), target: AlgebraMonoid(
  v,
  B
)>(
  h: AlgebraHom(u, v, A, B, source, target)
): (
  A
) -> B := algebra_hom_elim(
  u,
  v,
  A,
  B,
  source,
  target,
  h2 => AlgebraFunction(<u: u, v: v>, A, B),
  map => unit => mul => map,
  h
)

pub theorem algebra_map_unit<u: Level, v: Level, A: Type(
  u
), B: Type(
  v
), source: AlgebraMonoid(
  u,
  A
), target: AlgebraMonoid(
  v,
  B
)>(
  h: AlgebraHom(u, v, A, B, source, target)
): AlgebraEq(
  v,
  B,
  algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, h)(algebra_unit(<u: u, A: A>, source)),
  algebra_unit(<u: v, A: B>, target)
) {
  AlgebraHom::ind(<u: u, v: v, A: A, B: B, source: source, target: target>,
    h2 => AlgebraEq(
      v,
      B,
      algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, h2)(algebra_unit(<u: u, A: A>, source)),
      algebra_unit(<u: v, A: B>, target)
    ),
    map => unit => mul => unit,
    h
  )
}

pub theorem algebra_map_mul<u: Level, v: Level, A: Type(
  u
), B: Type(
  v
), source: AlgebraMonoid(
  u,
  A
), target: AlgebraMonoid(
  v,
  B
)>(
  h: AlgebraHom(u, v, A, B, source, target),
  x: A,
  y: A
): AlgebraEq(
  v,
  B,
  algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, h)(algebra_op(<u: u, A: A>, source)(x, y)),
  algebra_op(<u: v, A: B>,
    target
  )(algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, h)(x), algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, h)(y))
) {
  AlgebraHom::ind(<u: u, v: v, A: A, B: B, source: source, target: target>,
    h2 => AlgebraEq(
      v,
      B,
      algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, h2)(algebra_op(<u: u, A: A>, source)(x, y)),
      algebra_op(<u: v, A: B>,
        target
      )(
        algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, h2)(x),
        algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, h2)(y)
      )
    ),
    map => unit => mul => mul(x, y),
    h
  )
}

pub def algebra_identity<u: Level, A: Type(
  u
)>(
  m: AlgebraMonoid(u, A)
): AlgebraHom(
  u,
  u,
  A,
  A,
  m,
  m
) := AlgebraHom::Mk(<u: u, v: u, A: A, B: A, source: m, target: m>,
  x => x,
  AlgebraRefl(<u: u, A: A, a: algebra_unit(<u: u, A: A>, m)>),
  x => y => AlgebraRefl(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(x, y)>)
)

pub def algebra_compose<u: Level, v: Level, w: Level, A: Type(
  u
), B: Type(
  v
), C: Type(
  w
), source: AlgebraMonoid(
  u,
  A
), middle: AlgebraMonoid(
  v,
  B
), target: AlgebraMonoid(
  w,
  C
)>(
  f: AlgebraHom(u, v, A, B, source, middle),
  g: AlgebraHom(v, w, B, C, middle, target)
): AlgebraHom(
  u,
  w,
  A,
  C,
  source,
  target
) := AlgebraHom::Mk(<u: u, v: w, A: A, B: C, source: source, target: target>,
  x => algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>, g)(algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(x)),
  algebra_trans(<u: w, A: C, a: algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>,
      g
    )(algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(algebra_unit(<u: u, A: A>, source))), b: algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>, g)(algebra_unit(<u: v, A: B>, middle)), c: algebra_unit(<u: w, A: C>, target)>,
    algebra_congr(<u: v, v: w, A: B, B: C, a: algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(algebra_unit(<u: u, A: A>, source)), b: algebra_unit(<u: v, A: B>, middle)>,
      algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>, g),
      algebra_map_unit(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)
    ),
    algebra_map_unit(<u: v, v: w, A: B, B: C, source: middle, target: target>, g)
  ),
  x => y => algebra_trans(<u: w, A: C, a: algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>,
      g
    )(algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(algebra_op(<u: u, A: A>, source)(x, y))), b: algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>,
      g
    )(
      algebra_op(<u: v, A: B>,
        middle
      )(
        algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(x),
        algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(y)
      )
    ), c: algebra_op(<u: w, A: C>,
      target
    )(
      algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>, g)(algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(x)),
      algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>, g)(algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(y))
    )>,
    algebra_congr(<u: v, v: w, A: B, B: C, a: algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(algebra_op(<u: u, A: A>, source)(x, y)), b: algebra_op(<u: v, A: B>,
        middle
      )(
        algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(x),
        algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(y)
      )>,
      algebra_map(<u: v, v: w, A: B, B: C, source: middle, target: target>, g),
      algebra_map_mul(<u: u, v: v, A: A, B: B, source: source, target: middle>, f, x, y)
    ),
    algebra_map_mul(<u: v, v: w, A: B, B: C, source: middle, target: target>,
      g,
      algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(x),
      algebra_map(<u: u, v: v, A: A, B: B, source: source, target: middle>, f)(y)
    )
  )
)

// Laws compare maps pointwise; equality of bundled proof fields is not assumed.

pub theorem algebra_identity_right<u: Level, v: Level, A: Type(
  u
), B: Type(
  v
), source: AlgebraMonoid(
  u,
  A
), target: AlgebraMonoid(
  v,
  B
)>(
  f: AlgebraHom(u, v, A, B, source, target),
  x: A
): AlgebraEq(
  v,
  B,
  algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>,
    algebra_compose(<u: u, v: v, w: v, A: A, B: B, C: B, source: source, middle: target, target: target>, f, algebra_identity(<u: v, A: B>, target))
  )(x),
  algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, f)(x)
) { AlgebraRefl(<u: v, A: B, a: algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, f)(x)>) }

pub theorem algebra_identity_left<u: Level, v: Level, A: Type(
  u
), B: Type(
  v
), source: AlgebraMonoid(
  u,
  A
), target: AlgebraMonoid(
  v,
  B
)>(
  f: AlgebraHom(u, v, A, B, source, target),
  x: A
): AlgebraEq(
  v,
  B,
  algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>,
    algebra_compose(<u: u, v: u, w: v, A: A, B: A, C: B, source: source, middle: source, target: target>, algebra_identity(<u: u, A: A>, source), f)
  )(x),
  algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, f)(x)
) { AlgebraRefl(<u: v, A: B, a: algebra_map(<u: u, v: v, A: A, B: B, source: source, target: target>, f)(x)>) }

pub theorem algebra_compose_assoc<u: Level, v: Level, w: Level, t: Level, A: Type(
  u
), B: Type(
  v
), C: Type(
  w
), D: Type(
  t
), ma: AlgebraMonoid(
  u,
  A
), mb: AlgebraMonoid(
  v,
  B
), mc: AlgebraMonoid(
  w,
  C
), md: AlgebraMonoid(
  t,
  D
)>(
  f: AlgebraHom(u, v, A, B, ma, mb),
  g: AlgebraHom(v, w, B, C, mb, mc),
  h: AlgebraHom(w, t, C, D, mc, md),
  x: A
): AlgebraEq(
  t,
  D,
  algebra_map(<u: u, v: t, A: A, B: D, source: ma, target: md>,
    algebra_compose(<u: u, v: w, w: t, A: A, B: C, C: D, source: ma, middle: mc, target: md>,
      algebra_compose(<u: u, v: v, w: w, A: A, B: B, C: C, source: ma, middle: mb, target: mc>, f, g),
      h
    )
  )(x),
  algebra_map(<u: u, v: t, A: A, B: D, source: ma, target: md>,
    algebra_compose(<u: u, v: v, w: t, A: A, B: B, C: D, source: ma, middle: mb, target: md>,
      f,
      algebra_compose(<u: v, v: w, w: t, A: B, B: C, C: D, source: mb, middle: mc, target: md>, g, h)
    )
  )(x)
) {
  AlgebraRefl(<u: t, A: D, a: algebra_map(<u: u, v: t, A: A, B: D, source: ma, target: md>,
      algebra_compose(<u: u, v: w, w: t, A: A, B: C, C: D, source: ma, middle: mc, target: md>,
        algebra_compose(<u: u, v: v, w: w, A: A, B: B, C: C, source: ma, middle: mb, target: mc>, f, g),
        h
      )
    )(x)>)
}
