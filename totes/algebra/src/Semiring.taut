import "Monoid.taut"
import "Equality.taut"

// The two operations are shared monoid values, not copied fields.
pub(open) inductive AlgebraSemiring(
  R: Type,
  addition: AlgebraMonoid(0, R),
  multiplication: AlgebraMonoid(0, R)
): Prop {
  Mk(
    comm: ∀ x: R. ∀ y: R. AlgebraEq(
      0,
      R,
      algebra_op(<u: 0, A: R>, addition)(x, y),
      algebra_op(<u: 0, A: R>, addition)(y, x)
    ),
    distribute_left: ∀ x: R. ∀ y: R. ∀ z: R. AlgebraEq(
      0,
      R,
      algebra_op(<u: 0, A: R>, multiplication)(x, algebra_op(<u: 0, A: R>, addition)(y, z)),
      algebra_op(<u: 0, A: R>,
        addition
      )(algebra_op(<u: 0, A: R>, multiplication)(x, y), algebra_op(<u: 0, A: R>, multiplication)(x, z))
    ),
    distribute_right: ∀ x: R. ∀ y: R. ∀ z: R. AlgebraEq(
      0,
      R,
      algebra_op(<u: 0, A: R>, multiplication)(algebra_op(<u: 0, A: R>, addition)(x, y), z),
      algebra_op(<u: 0, A: R>,
        addition
      )(algebra_op(<u: 0, A: R>, multiplication)(x, z), algebra_op(<u: 0, A: R>, multiplication)(y, z))
    ),
    annihilate_left: ∀ x: R. AlgebraEq(
      0,
      R,
      algebra_op(<u: 0, A: R>, multiplication)(algebra_unit(<u: 0, A: R>, addition), x),
      algebra_unit(<u: 0, A: R>, addition)
    ),
    annihilate_right: ∀ x: R. AlgebraEq(
      0,
      R,
      algebra_op(<u: 0, A: R>, multiplication)(x, algebra_unit(<u: 0, A: R>, addition)),
      algebra_unit(<u: 0, A: R>, addition)
    )
  ): AlgebraSemiring(R, addition, multiplication)
}

pub theorem algebra_add_comm<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  x: R,
  y: R
): AlgebraEq(0, R, algebra_op(<u: 0, A: R>, addition)(x, y), algebra_op(<u: 0, A: R>, addition)(y, x)) {
  ⊢ AlgebraEq(0, R, algebra_op(<u: 0, A: R>, addition)(x, y), algebra_op(<u: 0, A: R>, addition)(y, x)) from match laws {
    Mk(comm, distribute_left, distribute_right, annihilate_left, annihilate_right) => comm(x, y)
  }
}

pub theorem algebra_distribute_left<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  x: R,
  y: R,
  z: R
): AlgebraEq(
  0,
  R,
  algebra_op(<u: 0, A: R>, multiplication)(x, algebra_op(<u: 0, A: R>, addition)(y, z)),
  algebra_op(<u: 0, A: R>,
    addition
  )(algebra_op(<u: 0, A: R>, multiplication)(x, y), algebra_op(<u: 0, A: R>, multiplication)(x, z))
) {
  ⊢ AlgebraEq(
    0,
    R,
    algebra_op(<u: 0, A: R>, multiplication)(x, algebra_op(<u: 0, A: R>, addition)(y, z)),
    algebra_op(<u: 0, A: R>,
      addition
    )(algebra_op(<u: 0, A: R>, multiplication)(x, y), algebra_op(<u: 0, A: R>, multiplication)(x, z))
  ) from match laws {
    Mk(comm, distribute_left, distribute_right, annihilate_left, annihilate_right) => distribute_left(
      x,
      y,
      z
    )
  }
}

pub theorem algebra_distribute_right<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  x: R,
  y: R,
  z: R
): AlgebraEq(
  0,
  R,
  algebra_op(<u: 0, A: R>, multiplication)(algebra_op(<u: 0, A: R>, addition)(x, y), z),
  algebra_op(<u: 0, A: R>,
    addition
  )(algebra_op(<u: 0, A: R>, multiplication)(x, z), algebra_op(<u: 0, A: R>, multiplication)(y, z))
) {
  ⊢ AlgebraEq(
    0,
    R,
    algebra_op(<u: 0, A: R>, multiplication)(algebra_op(<u: 0, A: R>, addition)(x, y), z),
    algebra_op(<u: 0, A: R>,
      addition
    )(algebra_op(<u: 0, A: R>, multiplication)(x, z), algebra_op(<u: 0, A: R>, multiplication)(y, z))
  ) from match laws {
    Mk(comm, distribute_left, distribute_right, annihilate_left, annihilate_right) => distribute_right(
      x,
      y,
      z
    )
  }
}

pub theorem algebra_zero_mul<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  x: R
): AlgebraEq(
  0,
  R,
  algebra_op(<u: 0, A: R>, multiplication)(algebra_unit(<u: 0, A: R>, addition), x),
  algebra_unit(<u: 0, A: R>, addition)
) {
  ⊢ AlgebraEq(
    0,
    R,
    algebra_op(<u: 0, A: R>, multiplication)(algebra_unit(<u: 0, A: R>, addition), x),
    algebra_unit(<u: 0, A: R>, addition)
  ) from match laws {
    Mk(comm, distribute_left, distribute_right, annihilate_left, annihilate_right) => annihilate_left(
      x
    )
  }
}

pub theorem algebra_mul_zero<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  x: R
): AlgebraEq(
  0,
  R,
  algebra_op(<u: 0, A: R>, multiplication)(x, algebra_unit(<u: 0, A: R>, addition)),
  algebra_unit(<u: 0, A: R>, addition)
) {
  ⊢ AlgebraEq(
    0,
    R,
    algebra_op(<u: 0, A: R>, multiplication)(x, algebra_unit(<u: 0, A: R>, addition)),
    algebra_unit(<u: 0, A: R>, addition)
  ) from match laws {
    Mk(comm, distribute_left, distribute_right, annihilate_left, annihilate_right) => annihilate_right(
      x
    )
  }
}

pub theorem algebra_chain<R: Type, a: R, b: R, c: R>(
  first: AlgebraEq(0, R, a, b),
  second: AlgebraEq(0, R, b, c)
): AlgebraEq(0, R, a, c) {
  algebra_trans(<u: 0, A: R, a: a, b: b, c: c>, first, second)
}

pub theorem algebra_flip<R: Type, a: R, b: R>(equal: AlgebraEq(0, R, a, b)): AlgebraEq(0, R, b, a) {
  algebra_sym(<u: 0, A: R, a: a, b: b>, equal)
}

pub theorem algebra_apply<R: Type, S: Type, a: R, b: R>(
  map: (R) -> S,
  equal: AlgebraEq(0, R, a, b)
): AlgebraEq(0, S, map(a), map(b)) {
  algebra_congr(<u: 0, v: 0, A: R, B: S, a: a, b: b>, map, equal)
}
