import "Setoid.taut"
import std::Tactic
import std::Base
import std::Nat

// A representative denotes positive - negative, not a bounded machine integer.
pub(open) inductive AlgebraInteger: Type {
  Mk(positive: Nat, negative: Nat): AlgebraInteger
}

pub fn integer_pos(x: AlgebraInteger): Nat {
  match x: Nat { Mk(p, n) => p } }
pub fn integer_neg_part(x: AlgebraInteger): Nat {
  match x: Nat { Mk(p, n) => n } }

pub def IntegerEq(x: AlgebraInteger, y: AlgebraInteger): Prop :=
Nat::add(integer_pos(x), integer_neg_part(y)) = Nat::add(integer_pos(y), integer_neg_part(x))

pub def integer_zero(): AlgebraInteger := AlgebraInteger::Mk(Zero, Zero)
pub def integer_one(): AlgebraInteger := AlgebraInteger::Mk(Succ(Zero), Zero)
pub def integer_of_nat(n: Nat): AlgebraInteger := AlgebraInteger::Mk(n, Zero)
pub def integer_neg(
  x: AlgebraInteger
): AlgebraInteger := AlgebraInteger::Mk(integer_neg_part(x), integer_pos(x))
pub def integer_add(x: AlgebraInteger, y: AlgebraInteger): AlgebraInteger :=
AlgebraInteger::Mk(
  Nat::add(integer_pos(x), integer_pos(y)),
  Nat::add(integer_neg_part(x), integer_neg_part(y))
)
pub def integer_sub(
  x: AlgebraInteger,
  y: AlgebraInteger
): AlgebraInteger := integer_add(x, integer_neg(y))
pub def integer_scale(x: AlgebraInteger, n: Nat): AlgebraInteger :=
AlgebraInteger::Mk(Nat::mul(integer_pos(x), n), Nat::mul(integer_neg_part(x), n))
pub def integer_mul(x: AlgebraInteger, y: AlgebraInteger): AlgebraInteger :=
integer_add(integer_scale(x, integer_pos(y)), integer_neg(integer_scale(x, integer_neg_part(y))))

pub theorem integer_eq_refl(x: AlgebraInteger): IntegerEq(x, x) { Refl }
pub theorem integer_eq_sym(
  x: AlgebraInteger,
  y: AlgebraInteger,
  h: IntegerEq(x, y)
): IntegerEq(y, x) { Eq::sym(h) }

pub theorem integer_nat_cancel(
  a: Nat,
  b: Nat,
  c: Nat,
  h: Nat::add(a, c) = Nat::add(b, c)
): a = b {
  match c: a = b {
    Zero => h
    Succ(k) => integer_nat_cancel(a, b, k, Eq::congr(Nat::pred, h))
  }
}

pub theorem integer_nat_add_congr(
  a: Nat,
  b: Nat,
  c: Nat,
  d: Nat,
  h: a = b,
  k: c = d
): Nat::add(a, c) = Nat::add(b, d) {
  Eq::trans(Eq::congr((t: Nat) => Nat::add(t, c), h), Eq::congr((t: Nat) => Nat::add(b, t), k))
}

pub theorem integer_eq_trans(
  x: AlgebraInteger,
  y: AlgebraInteger,
  z: AlgebraInteger,
  h: IntegerEq(x, y),
  k: IntegerEq(y, z)
): IntegerEq(x, z) {
  let a: Nat := integer_pos(x);
  let b: Nat := integer_neg_part(x);
  let c: Nat := integer_pos(y);
  let d: Nat := integer_neg_part(y);
  let e: Nat := integer_pos(z);
  let f: Nat := integer_neg_part(z);
  let first: Nat::add(Nat::add(a, f), d) = Nat::add(Nat::add(a, d), f) := Nat::add_swap(a, f, d);
  let second: Nat::add(Nat::add(a, d), f) = Nat::add(Nat::add(c, b), f) := Eq::congr((t: Nat) => Nat::add(t, f), h);
  let third: Nat::add(Nat::add(c, b), f) = Nat::add(Nat::add(c, f), b) := Nat::add_swap(c, b, f);
  let fourth: Nat::add(Nat::add(c, f), b) = Nat::add(Nat::add(e, d), b) := Eq::congr((t: Nat) => Nat::add(t, b), k);
  let fifth: Nat::add(Nat::add(e, d), b) = Nat::add(Nat::add(e, b), d) := Nat::add_swap(e, d, b);
  integer_nat_cancel(
    Nat::add(a, f),
    Nat::add(e, b),
    d,
    Eq::trans(first, Eq::trans(second, Eq::trans(third, Eq::trans(fourth, fifth))))
  )
}

pub theorem integer_neg_respects(
  x: AlgebraInteger,
  y: AlgebraInteger,
  h: IntegerEq(x, y)
): IntegerEq(integer_neg(x), integer_neg(y)) {
  Eq::trans(
    Nat::add_comm(integer_neg_part(x), integer_pos(y)),
    Eq::trans(Eq::sym(h), Nat::add_comm(integer_pos(x), integer_neg_part(y)))
  )
}

pub theorem integer_add_respects(
  x: AlgebraInteger,
  y: AlgebraInteger,
  z: AlgebraInteger,
  w: AlgebraInteger,
  h: IntegerEq(x, y),
  k: IntegerEq(z, w)
): IntegerEq(integer_add(x, z), integer_add(y, w)) {
  Eq::trans(
    Nat::add_shuffle(integer_pos(x), integer_pos(z), integer_neg_part(y), integer_neg_part(w)),
    Eq::trans(
      integer_nat_add_congr(
        Nat::add(integer_pos(x), integer_neg_part(y)),
        Nat::add(integer_pos(y), integer_neg_part(x)),
        Nat::add(integer_pos(z), integer_neg_part(w)),
        Nat::add(integer_pos(w), integer_neg_part(z)),
        h,
        k
      ),
      Eq::sym(
        Nat::add_shuffle(integer_pos(y), integer_pos(w), integer_neg_part(x), integer_neg_part(z))
      )
    )
  )
}

pub theorem integer_scale_respects(
  x: AlgebraInteger,
  y: AlgebraInteger,
  n: Nat,
  h: IntegerEq(x, y)
): IntegerEq(integer_scale(x, n), integer_scale(y, n)) {
  Eq::trans(
    Eq::sym(Nat::mul_add_distrib_right(integer_pos(x), integer_neg_part(y), n)),
    Eq::trans(
      Eq::congr((t: Nat) => Nat::mul(t, n), h),
      Nat::mul_add_distrib_right(integer_pos(y), integer_neg_part(x), n)
    )
  )
}

pub theorem integer_mul_respects_left(
  x: AlgebraInteger,
  y: AlgebraInteger,
  z: AlgebraInteger,
  h: IntegerEq(x, y)
): IntegerEq(integer_mul(x, z), integer_mul(y, z)) {
  integer_add_respects(
    integer_scale(x, integer_pos(z)),
    integer_scale(y, integer_pos(z)),
    integer_neg(integer_scale(x, integer_neg_part(z))),
    integer_neg(integer_scale(y, integer_neg_part(z))),
    integer_scale_respects(x, y, integer_pos(z), h),
    integer_neg_respects(
      integer_scale(x, integer_neg_part(z)),
      integer_scale(y, integer_neg_part(z)),
      integer_scale_respects(x, y, integer_neg_part(z), h)
    )
  )
}

pub theorem integer_add_assoc(
  x: AlgebraInteger,
  y: AlgebraInteger,
  z: AlgebraInteger
): IntegerEq(integer_add(integer_add(x, y), z), integer_add(x, integer_add(y, z))) {
  by nat_norm!(
    #()
  ): (Nat::add(
      Nat::add(Nat::add(integer_pos(x), integer_pos(y)), integer_pos(z)),
      Nat::add(integer_neg_part(x), Nat::add(integer_neg_part(y), integer_neg_part(z)))
    ) = Nat::add(
      Nat::add(integer_pos(x), Nat::add(integer_pos(y), integer_pos(z))),
      Nat::add(Nat::add(integer_neg_part(x), integer_neg_part(y)), integer_neg_part(z))
    )) {}
}

pub theorem integer_add_comm(
  x: AlgebraInteger,
  y: AlgebraInteger
): IntegerEq(integer_add(x, y), integer_add(y, x)) {
  by nat_norm!(
    #()
  ): (Nat::add(
      Nat::add(integer_pos(x), integer_pos(y)),
      Nat::add(integer_neg_part(y), integer_neg_part(x))
    ) = Nat::add(
      Nat::add(integer_pos(y), integer_pos(x)),
      Nat::add(integer_neg_part(x), integer_neg_part(y))
    )) {}
}

pub theorem integer_add_zero(x: AlgebraInteger): IntegerEq(integer_add(x, integer_zero), x) {
  by nat_norm!(
    #()
  ): (Nat::add(Nat::add(integer_pos(x), Zero), integer_neg_part(x)) = Nat::add(integer_pos(x), Nat::add(integer_neg_part(x), Zero))) {}
}

pub theorem integer_add_neg(
  x: AlgebraInteger
): IntegerEq(integer_add(x, integer_neg(x)), integer_zero) {
  by nat_norm!(
    #()
  ): (Nat::add(Nat::add(integer_pos(x), integer_neg_part(x)), Zero) = Nat::add(Zero, Nat::add(integer_neg_part(x), integer_pos(x)))) {}
}

pub theorem integer_neg_neg(x: AlgebraInteger): IntegerEq(integer_neg(integer_neg(x)), x) {
  by nat_norm!(
    #()
  ): (Nat::add(integer_pos(x), integer_neg_part(x)) = Nat::add(integer_pos(x), integer_neg_part(x))) {}
}

pub theorem integer_mul_comm(
  x: AlgebraInteger,
  y: AlgebraInteger
): IntegerEq(integer_mul(x, y), integer_mul(y, x)) {
  by nat_norm!(
    #()
  ): (Nat::add(
      Nat::add(
        Nat::mul(integer_pos(x), integer_pos(y)),
        Nat::mul(integer_neg_part(x), integer_neg_part(y))
      ),
      Nat::add(
        Nat::mul(integer_neg_part(y), integer_pos(x)),
        Nat::mul(integer_pos(y), integer_neg_part(x))
      )
    ) = Nat::add(
      Nat::add(
        Nat::mul(integer_pos(y), integer_pos(x)),
        Nat::mul(integer_neg_part(y), integer_neg_part(x))
      ),
      Nat::add(
        Nat::mul(integer_neg_part(x), integer_pos(y)),
        Nat::mul(integer_pos(x), integer_neg_part(y))
      )
    )) {}
}

pub theorem integer_mul_assoc(
  x: AlgebraInteger,
  y: AlgebraInteger,
  z: AlgebraInteger
): IntegerEq(integer_mul(integer_mul(x, y), z), integer_mul(x, integer_mul(y, z))) {
  by nat_norm!(
    #()
  ): (Nat::add(
      Nat::add(
        Nat::mul(
          Nat::add(
            Nat::mul(integer_pos(x), integer_pos(y)),
            Nat::mul(integer_neg_part(x), integer_neg_part(y))
          ),
          integer_pos(z)
        ),
        Nat::mul(
          Nat::add(
            Nat::mul(integer_neg_part(x), integer_pos(y)),
            Nat::mul(integer_pos(x), integer_neg_part(y))
          ),
          integer_neg_part(z)
        )
      ),
      Nat::add(
        Nat::mul(
          integer_neg_part(x),
          Nat::add(
            Nat::mul(integer_pos(y), integer_pos(z)),
            Nat::mul(integer_neg_part(y), integer_neg_part(z))
          )
        ),
        Nat::mul(
          integer_pos(x),
          Nat::add(
            Nat::mul(integer_neg_part(y), integer_pos(z)),
            Nat::mul(integer_pos(y), integer_neg_part(z))
          )
        )
      )
    ) = Nat::add(
      Nat::add(
        Nat::mul(
          integer_pos(x),
          Nat::add(
            Nat::mul(integer_pos(y), integer_pos(z)),
            Nat::mul(integer_neg_part(y), integer_neg_part(z))
          )
        ),
        Nat::mul(
          integer_neg_part(x),
          Nat::add(
            Nat::mul(integer_neg_part(y), integer_pos(z)),
            Nat::mul(integer_pos(y), integer_neg_part(z))
          )
        )
      ),
      Nat::add(
        Nat::mul(
          Nat::add(
            Nat::mul(integer_neg_part(x), integer_pos(y)),
            Nat::mul(integer_pos(x), integer_neg_part(y))
          ),
          integer_pos(z)
        ),
        Nat::mul(
          Nat::add(
            Nat::mul(integer_pos(x), integer_pos(y)),
            Nat::mul(integer_neg_part(x), integer_neg_part(y))
          ),
          integer_neg_part(z)
        )
      )
    )) {}
}

pub theorem integer_mul_one(x: AlgebraInteger): IntegerEq(integer_mul(x, integer_one), x) {
  by nat_norm!(
    #()
  ): (Nat::add(
      Nat::add(Nat::mul(integer_pos(x), Succ(Zero)), Nat::mul(integer_neg_part(x), Zero)),
      integer_neg_part(x)
    ) = Nat::add(
      integer_pos(x),
      Nat::add(Nat::mul(integer_neg_part(x), Succ(Zero)), Nat::mul(integer_pos(x), Zero))
    )) {}
}

pub theorem integer_mul_zero(
  x: AlgebraInteger
): IntegerEq(integer_mul(x, integer_zero), integer_zero) {
  by nat_norm!(
    #()
  ): (Nat::add(Nat::add(Nat::mul(integer_pos(x), Zero), Nat::mul(integer_neg_part(x), Zero)), Zero) = Nat::add(Zero, Nat::add(Nat::mul(integer_neg_part(x), Zero), Nat::mul(integer_pos(x), Zero)))) {}
}

pub theorem integer_mul_add(
  x: AlgebraInteger,
  y: AlgebraInteger,
  z: AlgebraInteger
): IntegerEq(integer_mul(x, integer_add(y, z)), integer_add(integer_mul(x, y), integer_mul(x, z))) {
  by nat_norm!(
    #()
  ): (Nat::add(
      Nat::add(
        Nat::mul(integer_pos(x), Nat::add(integer_pos(y), integer_pos(z))),
        Nat::mul(integer_neg_part(x), Nat::add(integer_neg_part(y), integer_neg_part(z)))
      ),
      Nat::add(
        Nat::add(
          Nat::mul(integer_neg_part(x), integer_pos(y)),
          Nat::mul(integer_pos(x), integer_neg_part(y))
        ),
        Nat::add(
          Nat::mul(integer_neg_part(x), integer_pos(z)),
          Nat::mul(integer_pos(x), integer_neg_part(z))
        )
      )
    ) = Nat::add(
      Nat::add(
        Nat::add(
          Nat::mul(integer_pos(x), integer_pos(y)),
          Nat::mul(integer_neg_part(x), integer_neg_part(y))
        ),
        Nat::add(
          Nat::mul(integer_pos(x), integer_pos(z)),
          Nat::mul(integer_neg_part(x), integer_neg_part(z))
        )
      ),
      Nat::add(
        Nat::mul(integer_neg_part(x), Nat::add(integer_pos(y), integer_pos(z))),
        Nat::mul(integer_pos(x), Nat::add(integer_neg_part(y), integer_neg_part(z)))
      )
    )) {}
}

pub theorem integer_mul_respects(
  x: AlgebraInteger,
  y: AlgebraInteger,
  z: AlgebraInteger,
  w: AlgebraInteger,
  h: IntegerEq(x, y),
  k: IntegerEq(z, w)
): IntegerEq(integer_mul(x, z), integer_mul(y, w)) {
  integer_eq_trans(
    integer_mul(x, z),
    integer_mul(y, z),
    integer_mul(y, w),
    integer_mul_respects_left(x, y, z, h),
    integer_eq_trans(
      integer_mul(y, z),
      integer_mul(z, y),
      integer_mul(y, w),
      integer_mul_comm(y, z),
      integer_eq_trans(
        integer_mul(z, y),
        integer_mul(w, y),
        integer_mul(y, w),
        integer_mul_respects_left(z, w, y, k),
        integer_mul_comm(w, y)
      )
    )
  )
}

pub theorem integer_sub_respects(
  x: AlgebraInteger,
  y: AlgebraInteger,
  z: AlgebraInteger,
  w: AlgebraInteger,
  h: IntegerEq(x, y),
  k: IntegerEq(z, w)
): IntegerEq(integer_sub(x, z), integer_sub(y, w)) {
  integer_add_respects(x, y, integer_neg(z), integer_neg(w), h, integer_neg_respects(z, w, k))
}

pub theorem integer_of_nat_injective(
  a: Nat,
  b: Nat,
  h: IntegerEq(integer_of_nat(a), integer_of_nat(b))
): a = b { h }

pub theorem integer_of_nat_add(
  a: Nat,
  b: Nat
): IntegerEq(
  integer_of_nat(Nat::add(a, b)),
  integer_add(integer_of_nat(a), integer_of_nat(b))
) { Refl }

pub theorem integer_of_nat_mul(
  a: Nat,
  b: Nat
): IntegerEq(integer_of_nat(Nat::mul(a, b)), integer_mul(integer_of_nat(a), integer_of_nat(b))) {
  by nat_norm!(
    #()
  ): (Nat::add(Nat::mul(a, b), Nat::add(Nat::mul(Zero, b), Nat::mul(a, Zero))) = Nat::add(Nat::mul(a, b), Nat::mul(Zero, Zero))) {}
}

pub theorem integer_shift(
  p: Nat,
  n: Nat,
  k: Nat
): IntegerEq(AlgebraInteger::Mk(Nat::add(p, k), Nat::add(n, k)), AlgebraInteger::Mk(p, n)) {
  Eq::trans(Nat::add_swap(p, k, n), Nat::add_assoc(p, n, k))
}

pub theorem integer_zero_representatives(n: Nat): IntegerEq(AlgebraInteger::Mk(n, n), integer_zero) {
  Eq::sym(Nat::add_zero_left(n))
}

pub theorem integer_setoid(): AlgebraSetoid(AlgebraInteger, IntegerEq) {
  AlgebraSetoid::Mk(AlgebraInteger, IntegerEq, integer_eq_refl, integer_eq_sym, integer_eq_trans)
}

pub theorem integer_nat_zero_ne_succ(n: Nat, h: Zero = Succ(n)): False {
  match h: False {
  }
}

pub theorem integer_nat_cancel_left(
  c: Nat,
  a: Nat,
  b: Nat,
  h: Nat::add(c, a) = Nat::add(c, b)
): a = b {
  integer_nat_cancel(a, b, c, Eq::trans(Nat::add_comm(a, c), Eq::trans(h, Nat::add_comm(c, b))))
}

pub theorem integer_nat_mul_cancel(
  a: Nat,
  b: Nat,
  n: Nat,
  h: Nat::mul(a, Succ(n)) = Nat::mul(b, Succ(n))
): a = b {
  match a: a = b {
    Zero => match b: Zero = b {
      Zero => Refl
      Succ(k) => False::elim(
        integer_nat_zero_ne_succ(
          Nat::add(Nat::mul(Succ(k), n), k),
          Eq::trans(Eq::sym(Nat::mul_zero_left(Succ(n))), h)
        )
      )
    }
    Succ(j) => match b: Succ(j) = b {
      Zero => False::elim(
        integer_nat_zero_ne_succ(
          Nat::add(Nat::mul(Succ(j), n), j),
          Eq::trans(Eq::sym(Nat::mul_zero_left(Succ(n))), Eq::sym(h))
        )
      )
      Succ(k) => Eq::congr(
        Succ,
        integer_nat_mul_cancel(
          j,
          k,
          n,
          integer_nat_cancel(
            Nat::mul(j, Succ(n)),
            Nat::mul(k, Succ(n)),
            Succ(n),
            Eq::trans(
              Eq::sym(Nat::mul_succ_left(j, Succ(n))),
              Eq::trans(h, Nat::mul_succ_left(k, Succ(n)))
            )
          )
        )
      )
    }
  }
}

pub theorem integer_scale_cancel(
  x: AlgebraInteger,
  y: AlgebraInteger,
  n: Nat,
  h: IntegerEq(integer_scale(x, Succ(n)), integer_scale(y, Succ(n)))
): IntegerEq(x, y) {
  integer_nat_mul_cancel(
    Nat::add(integer_pos(x), integer_neg_part(y)),
    Nat::add(integer_pos(y), integer_neg_part(x)),
    n,
    Eq::trans(
      Nat::mul_add_distrib_right(integer_pos(x), integer_neg_part(y), Succ(n)),
      Eq::trans(h, Eq::sym(Nat::mul_add_distrib_right(integer_pos(y), integer_neg_part(x), Succ(n))))
    )
  )
}

pub theorem integer_scale_swap(
  x: AlgebraInteger,
  n: Nat,
  m: Nat
): IntegerEq(integer_scale(integer_scale(x, n), m), integer_scale(integer_scale(x, m), n)) {
  by nat_norm!(
    #()
  ): (Nat::add(Nat::mul(Nat::mul(integer_pos(x), n), m), Nat::mul(Nat::mul(integer_neg_part(x), m), n)) = Nat::add(Nat::mul(Nat::mul(integer_pos(x), m), n), Nat::mul(Nat::mul(integer_neg_part(x), n), m))) {}
}

// A constructive sign view. The payload is a magnitude and an equation,
// never a choice axiom or an assumed normal form.
pub(open) inductive IntegerSign(p: Nat, n: Nat): Type {
  IntegerSignZero(equal: p = n): IntegerSign(p, n)
  IntegerSignPositive(k: Nat, equal: p = Nat::add(n, Succ(k))): IntegerSign(p, n)
  IntegerSignNegative(k: Nat, equal: n = Nat::add(p, Succ(k))): IntegerSign(p, n)
}

pub fn integer_sign(p: Nat, n: Nat): IntegerSign(p, n) {
  match p: IntegerSign(p, n) {
    Zero => match n: IntegerSign(Zero, n) {
      Zero => IntegerSignZero(Zero, Zero, Refl)
      Succ(k) => IntegerSignNegative(Zero, Succ(k), k, Eq::sym(Eq::congr(Succ, Nat::add_zero_left(k))))
    }
    Succ(j) => match n: IntegerSign(Succ(j), n) {
      Zero => IntegerSignPositive(Succ(j), Zero, j, Eq::sym(Eq::congr(Succ, Nat::add_zero_left(j))))
      Succ(k) => match integer_sign(j, k): IntegerSign(Succ(j), Succ(k)) {
        IntegerSignZero(h) => IntegerSignZero(Succ(j), Succ(k), Eq::congr(Succ, h))
        IntegerSignPositive(m, h) => IntegerSignPositive(
          Succ(j),
          Succ(k),
          m,
          Eq::trans(Eq::congr(Succ, h), Eq::sym(Nat::add_succ_left(k, Succ(m))))
        )
        IntegerSignNegative(m, h) => IntegerSignNegative(
          Succ(j),
          Succ(k),
          m,
          Eq::trans(Eq::congr(Succ, h), Eq::sym(Nat::add_succ_left(j, Succ(m))))
        )
      }
    }
  }
}

pub def IntegerNonzero(x: AlgebraInteger): Prop := ∀ h: IntegerEq(x, integer_zero). False

pub theorem integer_scale_zero(n: Nat): IntegerEq(integer_scale(integer_zero, n), integer_zero) {
  Eq::sym(Nat::add_zero_left(Nat::mul(Zero, n)))
}

pub theorem integer_scale_one(x: AlgebraInteger): IntegerEq(integer_scale(x, Succ(Zero)), x) {
  by nat_norm!(
    #()
  ): (Nat::add(Nat::mul(integer_pos(x), Succ(Zero)), integer_neg_part(x)) = Nat::add(integer_pos(x), Nat::mul(integer_neg_part(x), Succ(Zero)))) {}
}
