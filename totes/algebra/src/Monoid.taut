import "Equality.taut"

pub def AlgebraOperation<u: Level>(A: Type(u)): Type(u) := (A, A) -> A

// The carrier is a parameter, so distinct structures on one carrier are ordinary values.
pub(open) inductive AlgebraMonoid(u: Level, A: Type(u)): Type(u) {
  Mk(
    unit: A,
    op: (A, A) -> A,
    assoc: ∀ x: A. ∀ y: A. ∀ z: A. AlgebraEq(u, A, op(op(x, y), z), op(x, op(y, z))),
    left: ∀ x: A. AlgebraEq(u, A, op(unit, x), x),
    right: ∀ x: A. AlgebraEq(u, A, op(x, unit), x)
  ): AlgebraMonoid(u, A)
}

pub def algebra_monoid_elim<u: Level>(): ∀ A: Type(
  u
). ∀ motive: (
  AlgebraMonoid(u, A)
) -> Type(
  u
). (
  ∀ unit: A. ∀ op: (
    A,
    A
  ) -> A. ∀ assoc: (
    ∀ x: A. ∀ y: A. ∀ z: A. AlgebraEq(u, A, op(op(x, y), z), op(x, op(y, z)))
  ). ∀ left: (
    ∀ x: A. AlgebraEq(u, A, op(unit, x), x)
  ). ∀ right: (
    ∀ x: A. AlgebraEq(u, A, op(x, unit), x)
  ). motive(AlgebraMonoid::Mk(<u: u, A: A>, unit, op, assoc, left, right))
) -> (∀ structure: AlgebraMonoid(u, A). motive(structure)) := recursor(AlgebraMonoid(u), u)

pub def algebra_unit<u: Level, A: Type(u)>(m: AlgebraMonoid(u, A)): A :=
algebra_monoid_elim(u, A, structure => A, unit => op => assoc => left => right => unit, m)

pub def algebra_op<u: Level, A: Type(u)>(m: AlgebraMonoid(u, A)): (A, A) -> A :=
algebra_monoid_elim(
  u,
  A,
  structure => AlgebraOperation(<u: u>, A),
  unit => op => assoc => left => right => op,
  m
)

pub theorem algebra_assoc<u: Level, A: Type(
  u
)>(
  m: AlgebraMonoid(u, A),
  x: A,
  y: A,
  z: A
): AlgebraEq(
  u,
  A,
  algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(x, y), z),
  algebra_op(<u: u, A: A>, m)(x, algebra_op(<u: u, A: A>, m)(y, z))
) {
  AlgebraMonoid::ind(<u: u, A: A>,
    structure => AlgebraEq(
      u,
      A,
      algebra_op(<u: u, A: A>, structure)(algebra_op(<u: u, A: A>, structure)(x, y), z),
      algebra_op(<u: u, A: A>, structure)(x, algebra_op(<u: u, A: A>, structure)(y, z))
    ),
    unit => op => assoc => left => right => assoc(x, y, z),
    m
  )
}

pub theorem algebra_left_unit<u: Level, A: Type(
  u
)>(
  m: AlgebraMonoid(u, A),
  x: A
): AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), x), x) {
  AlgebraMonoid::ind(<u: u, A: A>,
    structure => AlgebraEq(u, A, algebra_op(<u: u, A: A>, structure)(algebra_unit(<u: u, A: A>, structure), x), x),
    unit => op => assoc => left => right => left(x),
    m
  )
}

pub theorem algebra_right_unit<u: Level, A: Type(
  u
)>(
  m: AlgebraMonoid(u, A),
  x: A
): AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(x, algebra_unit(<u: u, A: A>, m)), x) {
  AlgebraMonoid::ind(<u: u, A: A>,
    structure => AlgebraEq(u, A, algebra_op(<u: u, A: A>, structure)(x, algebra_unit(<u: u, A: A>, structure)), x),
    unit => op => assoc => left => right => right(x),
    m
  )
}

pub theorem algebra_unit_unique<u: Level, A: Type(
  u
)>(
  m: AlgebraMonoid(u, A),
  candidate: A,
  left: ∀ x: A. AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(candidate, x), x)
): AlgebraEq(u, A, candidate, algebra_unit(<u: u, A: A>, m)) {
  algebra_trans(<u: u, A: A, a: candidate, b: algebra_op(<u: u, A: A>, m)(candidate, algebra_unit(<u: u, A: A>, m)), c: algebra_unit(<u: u, A: A>, m)>,
    algebra_sym(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(candidate, algebra_unit(<u: u, A: A>, m)), b: candidate>,
      algebra_right_unit(<u: u, A: A>, m, candidate)
    ),
    left(algebra_unit(<u: u, A: A>, m))
  )
}
