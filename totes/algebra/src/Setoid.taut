// Representatives and their mathematical equality are separate data.
// No conversion from an arbitrary relation to the kernel's Eq is provided.
inductive AlgebraSetoid(A: Type, related: (A, A) -> Prop): Prop {
  algebra_setoid(
    reflexive: ∀ x: A. related(x, x),
    symmetric: ∀ x: A. ∀ y: A. ∀ h: related(x, y). related(y, x),
    transitive: ∀ x: A. ∀ y: A. ∀ z: A. ∀ h: related(x, y). ∀ k: related(y, z). related(x, z)
  ): AlgebraSetoid(A, related)
}
