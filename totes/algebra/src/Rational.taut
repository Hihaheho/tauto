import "Integer.taut"
import "Setoid.taut"
import std::Base
import std::Nat

pub def NaturalNonzero(n: Nat): Prop := ∀ h: n = Zero. False

pub theorem natural_succ_nonzero(n: Nat, h: Succ(n) = Zero): False {
  integer_nat_zero_ne_succ(n, Eq::sym(h))
}

pub theorem natural_one_nonzero(): NaturalNonzero(Succ(Zero)) { natural_succ_nonzero(Zero) }

pub theorem natural_mul_nonzero(
  a: Nat,
  b: Nat,
  ha: NaturalNonzero(a),
  hb: NaturalNonzero(b)
): NaturalNonzero(Nat::mul(a, b)) {
  ⊢ NaturalNonzero(Nat::mul(a, b)) from match b {
    Zero => h => False::elim(hb(Refl))
    Succ(k) => h => ha(
      integer_nat_mul_cancel(a, Zero, k, Eq::trans(h, Eq::sym(Nat::mul_zero_left(Succ(k)))))
    )
  }
}

// The denominator is a natural together with a proof that it is not zero.
// Fractions need not be reduced; equality is cross multiplication in IntegerEq.
pub(open) inductive AlgebraRational: Type {
  Mk(
    numerator: AlgebraInteger,
    denominator: Nat,
    nonzero: NaturalNonzero(denominator)
  ): AlgebraRational
}

pub fn rational_num(x: AlgebraRational): AlgebraInteger {
  ⊢ AlgebraInteger from match x { Mk(n, d, h) => n }
}
pub fn rational_den(x: AlgebraRational): Nat {
  ⊢ Nat from match x { Mk(n, d, h) => d }
}
pub theorem rational_den_nonzero(x: AlgebraRational): NaturalNonzero(rational_den(x)) {
  ⊢ NaturalNonzero(rational_den(x)) from match x { Mk(n, d, h) => h }
}

pub def RationalEq(x: AlgebraRational, y: AlgebraRational): Prop :=
IntegerEq(
  integer_scale(rational_num(x), rational_den(y)),
  integer_scale(rational_num(y), rational_den(x))
)

pub def rational_of_integer(
  x: AlgebraInteger
): AlgebraRational := AlgebraRational::Mk(x, Succ(Zero), natural_one_nonzero)
pub def rational_zero(): AlgebraRational := rational_of_integer(integer_zero)
pub def rational_one(): AlgebraRational := rational_of_integer(integer_one)
pub def rational_neg(
  x: AlgebraRational
): AlgebraRational := AlgebraRational::Mk(
  integer_neg(rational_num(x)),
  rational_den(x),
  rational_den_nonzero(x)
)
pub def rational_add(x: AlgebraRational, y: AlgebraRational): AlgebraRational :=
AlgebraRational::Mk(
  integer_add(
    integer_scale(rational_num(x), rational_den(y)),
    integer_scale(rational_num(y), rational_den(x))
  ),
  Nat::mul(rational_den(x), rational_den(y)),
  natural_mul_nonzero(
    rational_den(x),
    rational_den(y),
    rational_den_nonzero(x),
    rational_den_nonzero(y)
  )
)
pub def rational_sub(
  x: AlgebraRational,
  y: AlgebraRational
): AlgebraRational := rational_add(x, rational_neg(y))
pub def rational_mul(x: AlgebraRational, y: AlgebraRational): AlgebraRational :=
AlgebraRational::Mk(
  integer_mul(rational_num(x), rational_num(y)),
  Nat::mul(rational_den(x), rational_den(y)),
  natural_mul_nonzero(
    rational_den(x),
    rational_den(y),
    rational_den_nonzero(x),
    rational_den_nonzero(y)
  )
)

pub theorem rational_eq_refl(
  x: AlgebraRational
): RationalEq(x, x) { integer_eq_refl(integer_scale(rational_num(x), rational_den(x))) }
pub theorem rational_eq_sym(
  x: AlgebraRational,
  y: AlgebraRational,
  h: RationalEq(x, y)
): RationalEq(y, x) {
  integer_eq_sym(
    integer_scale(rational_num(x), rational_den(y)),
    integer_scale(rational_num(y), rational_den(x)),
    h
  )
}

pub theorem rational_cancel_scale(
  x: AlgebraInteger,
  y: AlgebraInteger,
  d: Nat,
  hd: NaturalNonzero(d),
  h: IntegerEq(integer_scale(x, d), integer_scale(y, d))
): IntegerEq(x, y) {
  ⊢ IntegerEq(x, y) from match d {
    Zero => False::elim(hd(Refl))
    Succ(k) => integer_scale_cancel(x, y, k, h)
  }
}

pub theorem rational_eq_trans(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational,
  h: RationalEq(x, y),
  k: RationalEq(y, z)
): RationalEq(x, z) {
  let a: AlgebraInteger := rational_num(x);
  let b: AlgebraInteger := rational_num(y);
  let c: AlgebraInteger := rational_num(z);
  let d: Nat := rational_den(x);
  let e: Nat := rational_den(y);
  let f: Nat := rational_den(z);
  let first: IntegerEq(
    integer_scale(integer_scale(a, f), e),
    integer_scale(integer_scale(a, e), f)
  ) := integer_scale_swap(a, f, e);
  let second: IntegerEq(
    integer_scale(integer_scale(a, e), f),
    integer_scale(integer_scale(b, d), f)
  ) := integer_scale_respects(integer_scale(a, e), integer_scale(b, d), f, h);
  let third: IntegerEq(
    integer_scale(integer_scale(b, d), f),
    integer_scale(integer_scale(b, f), d)
  ) := integer_scale_swap(b, d, f);
  let fourth: IntegerEq(
    integer_scale(integer_scale(b, f), d),
    integer_scale(integer_scale(c, e), d)
  ) := integer_scale_respects(integer_scale(b, f), integer_scale(c, e), d, k);
  let fifth: IntegerEq(
    integer_scale(integer_scale(c, e), d),
    integer_scale(integer_scale(c, d), e)
  ) := integer_scale_swap(c, e, d);
  rational_cancel_scale(
    integer_scale(a, f),
    integer_scale(c, d),
    e,
    rational_den_nonzero(y),
    integer_eq_trans(
      integer_scale(integer_scale(a, f), e),
      integer_scale(integer_scale(a, e), f),
      integer_scale(integer_scale(c, d), e),
      first,
      integer_eq_trans(
        integer_scale(integer_scale(a, e), f),
        integer_scale(integer_scale(b, d), f),
        integer_scale(integer_scale(c, d), e),
        second,
        integer_eq_trans(
          integer_scale(integer_scale(b, d), f),
          integer_scale(integer_scale(b, f), d),
          integer_scale(integer_scale(c, d), e),
          third,
          integer_eq_trans(
            integer_scale(integer_scale(b, f), d),
            integer_scale(integer_scale(c, e), d),
            integer_scale(integer_scale(c, d), e),
            fourth,
            fifth
          )
        )
      )
    )
  )
}

pub theorem rational_setoid(): AlgebraSetoid(AlgebraRational, RationalEq) {
  AlgebraSetoid::Mk(<A: AlgebraRational, related: RationalEq>,
    rational_eq_refl,
    rational_eq_sym,
    rational_eq_trans
  )
}

pub theorem rational_add_cross_left(
  a: AlgebraInteger,
  c: AlgebraInteger,
  d: Nat,
  e: Nat,
  f: Nat
): IntegerEq(
  integer_scale(integer_add(integer_scale(a, f), integer_scale(c, d)), Nat::mul(e, f)),
  integer_add(
    integer_scale(integer_scale(a, e), Nat::mul(f, f)),
    integer_scale(c, Nat::mul(Nat::mul(d, e), f))
  )
) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(Nat::add(Nat::mul(integer_pos(a), f), Nat::mul(integer_pos(c), d)), Nat::mul(e, f)),
      Nat::add(
        Nat::mul(Nat::mul(integer_neg_part(a), e), Nat::mul(f, f)),
        Nat::mul(integer_neg_part(c), Nat::mul(Nat::mul(d, e), f))
      )
    ) = Nat::add(
      Nat::add(
        Nat::mul(Nat::mul(integer_pos(a), e), Nat::mul(f, f)),
        Nat::mul(integer_pos(c), Nat::mul(Nat::mul(d, e), f))
      ),
      Nat::mul(
        Nat::add(Nat::mul(integer_neg_part(a), f), Nat::mul(integer_neg_part(c), d)),
        Nat::mul(e, f)
      )
    )
  ) {}
}

pub theorem rational_add_cross_right(
  b: AlgebraInteger,
  c: AlgebraInteger,
  d: Nat,
  e: Nat,
  f: Nat
): IntegerEq(
  integer_scale(integer_add(integer_scale(b, f), integer_scale(c, e)), Nat::mul(d, f)),
  integer_add(
    integer_scale(integer_scale(b, d), Nat::mul(f, f)),
    integer_scale(c, Nat::mul(Nat::mul(d, e), f))
  )
) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(Nat::add(Nat::mul(integer_pos(b), f), Nat::mul(integer_pos(c), e)), Nat::mul(d, f)),
      Nat::add(
        Nat::mul(Nat::mul(integer_neg_part(b), d), Nat::mul(f, f)),
        Nat::mul(integer_neg_part(c), Nat::mul(Nat::mul(d, e), f))
      )
    ) = Nat::add(
      Nat::add(
        Nat::mul(Nat::mul(integer_pos(b), d), Nat::mul(f, f)),
        Nat::mul(integer_pos(c), Nat::mul(Nat::mul(d, e), f))
      ),
      Nat::mul(
        Nat::add(Nat::mul(integer_neg_part(b), f), Nat::mul(integer_neg_part(c), e)),
        Nat::mul(d, f)
      )
    )
  ) {}
}

pub theorem rational_mul_cross(
  a: AlgebraInteger,
  c: AlgebraInteger,
  e: Nat,
  f: Nat
): IntegerEq(
  integer_scale(integer_mul(a, c), Nat::mul(e, f)),
  integer_mul(integer_scale(a, e), integer_scale(c, f))
) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(a), integer_pos(c)),
          Nat::mul(integer_neg_part(a), integer_neg_part(c))
        ),
        Nat::mul(e, f)
      ),
      Nat::add(
        Nat::mul(Nat::mul(integer_neg_part(a), e), Nat::mul(integer_pos(c), f)),
        Nat::mul(Nat::mul(integer_pos(a), e), Nat::mul(integer_neg_part(c), f))
      )
    ) = Nat::add(
      Nat::add(
        Nat::mul(Nat::mul(integer_pos(a), e), Nat::mul(integer_pos(c), f)),
        Nat::mul(Nat::mul(integer_neg_part(a), e), Nat::mul(integer_neg_part(c), f))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(a), integer_pos(c)),
          Nat::mul(integer_pos(a), integer_neg_part(c))
        ),
        Nat::mul(e, f)
      )
    )
  ) {}
}

pub theorem rational_add_respects_left(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational,
  h: RationalEq(x, y)
): RationalEq(rational_add(x, z), rational_add(y, z)) {
  let a: AlgebraInteger := rational_num(x);
  let b: AlgebraInteger := rational_num(y);
  let c: AlgebraInteger := rational_num(z);
  let d: Nat := rational_den(x);
  let e: Nat := rational_den(y);
  let f: Nat := rational_den(z);
  let common: AlgebraInteger := integer_scale(c, Nat::mul(Nat::mul(d, e), f));
  let left: AlgebraInteger := integer_add(
    integer_scale(integer_scale(a, e), Nat::mul(f, f)),
    common
  );
  let right: AlgebraInteger := integer_add(
    integer_scale(integer_scale(b, d), Nat::mul(f, f)),
    common
  );
  integer_eq_trans(
    integer_scale(rational_num(rational_add(x, z)), rational_den(rational_add(y, z))),
    left,
    integer_scale(rational_num(rational_add(y, z)), rational_den(rational_add(x, z))),
    rational_add_cross_left(a, c, d, e, f),
    integer_eq_trans(
      left,
      right,
      integer_scale(rational_num(rational_add(y, z)), rational_den(rational_add(x, z))),
      integer_add_respects(
        integer_scale(integer_scale(a, e), Nat::mul(f, f)),
        integer_scale(integer_scale(b, d), Nat::mul(f, f)),
        common,
        common,
        integer_scale_respects(integer_scale(a, e), integer_scale(b, d), Nat::mul(f, f), h),
        integer_eq_refl(common)
      ),
      integer_eq_sym(
        integer_scale(rational_num(rational_add(y, z)), rational_den(rational_add(x, z))),
        right,
        rational_add_cross_right(b, c, d, e, f)
      )
    )
  )
}

pub theorem rational_mul_respects_left(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational,
  h: RationalEq(x, y)
): RationalEq(rational_mul(x, z), rational_mul(y, z)) {
  let a: AlgebraInteger := rational_num(x);
  let b: AlgebraInteger := rational_num(y);
  let c: AlgebraInteger := rational_num(z);
  let d: Nat := rational_den(x);
  let e: Nat := rational_den(y);
  let f: Nat := rational_den(z);
  let left: AlgebraInteger := integer_mul(integer_scale(a, e), integer_scale(c, f));
  let right: AlgebraInteger := integer_mul(integer_scale(b, d), integer_scale(c, f));
  integer_eq_trans(
    integer_scale(integer_mul(a, c), Nat::mul(e, f)),
    left,
    integer_scale(integer_mul(b, c), Nat::mul(d, f)),
    rational_mul_cross(a, c, e, f),
    integer_eq_trans(
      left,
      right,
      integer_scale(integer_mul(b, c), Nat::mul(d, f)),
      integer_mul_respects_left(integer_scale(a, e), integer_scale(b, d), integer_scale(c, f), h),
      integer_eq_sym(
        integer_scale(integer_mul(b, c), Nat::mul(d, f)),
        right,
        rational_mul_cross(b, c, d, f)
      )
    )
  )
}

pub theorem rational_add_assoc(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational
): RationalEq(rational_add(rational_add(x, y), z), rational_add(x, rational_add(y, z))) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(
            Nat::add(
              Nat::mul(integer_pos(rational_num(x)), rational_den(y)),
              Nat::mul(integer_pos(rational_num(y)), rational_den(x))
            ),
            rational_den(z)
          ),
          Nat::mul(integer_pos(rational_num(z)), Nat::mul(rational_den(x), rational_den(y)))
        ),
        Nat::mul(rational_den(x), Nat::mul(rational_den(y), rational_den(z)))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(x)), Nat::mul(rational_den(y), rational_den(z))),
          Nat::mul(
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(y)), rational_den(z)),
              Nat::mul(integer_neg_part(rational_num(z)), rational_den(y))
            ),
            rational_den(x)
          )
        ),
        Nat::mul(Nat::mul(rational_den(x), rational_den(y)), rational_den(z))
      )
    ) = Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(x)), Nat::mul(rational_den(y), rational_den(z))),
          Nat::mul(
            Nat::add(
              Nat::mul(integer_pos(rational_num(y)), rational_den(z)),
              Nat::mul(integer_pos(rational_num(z)), rational_den(y))
            ),
            rational_den(x)
          )
        ),
        Nat::mul(Nat::mul(rational_den(x), rational_den(y)), rational_den(z))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(x)), rational_den(y)),
              Nat::mul(integer_neg_part(rational_num(y)), rational_den(x))
            ),
            rational_den(z)
          ),
          Nat::mul(integer_neg_part(rational_num(z)), Nat::mul(rational_den(x), rational_den(y)))
        ),
        Nat::mul(rational_den(x), Nat::mul(rational_den(y), rational_den(z)))
      )
    )
  ) {}
}

pub theorem rational_add_comm(
  x: AlgebraRational,
  y: AlgebraRational
): RationalEq(rational_add(x, y), rational_add(y, x)) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(x)), rational_den(y)),
          Nat::mul(integer_pos(rational_num(y)), rational_den(x))
        ),
        Nat::mul(rational_den(y), rational_den(x))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(y)), rational_den(x)),
          Nat::mul(integer_neg_part(rational_num(x)), rational_den(y))
        ),
        Nat::mul(rational_den(x), rational_den(y))
      )
    ) = Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(y)), rational_den(x)),
          Nat::mul(integer_pos(rational_num(x)), rational_den(y))
        ),
        Nat::mul(rational_den(x), rational_den(y))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(x)), rational_den(y)),
          Nat::mul(integer_neg_part(rational_num(y)), rational_den(x))
        ),
        Nat::mul(rational_den(y), rational_den(x))
      )
    )
  ) {}
}

pub theorem rational_add_zero(x: AlgebraRational): RationalEq(rational_add(x, rational_zero), x) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(x)), Succ(Zero)),
          Nat::mul(Zero, rational_den(x))
        ),
        rational_den(x)
      ),
      Nat::mul(integer_neg_part(rational_num(x)), Nat::mul(rational_den(x), Succ(Zero)))
    ) = Nat::add(
      Nat::mul(integer_pos(rational_num(x)), Nat::mul(rational_den(x), Succ(Zero))),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(x)), Succ(Zero)),
          Nat::mul(Zero, rational_den(x))
        ),
        rational_den(x)
      )
    )
  ) {}
}

pub theorem rational_add_neg(
  x: AlgebraRational
): RationalEq(rational_add(x, rational_neg(x)), rational_zero) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(x)), rational_den(x)),
          Nat::mul(integer_neg_part(rational_num(x)), rational_den(x))
        ),
        Succ(Zero)
      ),
      Nat::mul(Zero, Nat::mul(rational_den(x), rational_den(x)))
    ) = Nat::add(
      Nat::mul(Zero, Nat::mul(rational_den(x), rational_den(x))),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(x)), rational_den(x)),
          Nat::mul(integer_pos(rational_num(x)), rational_den(x))
        ),
        Succ(Zero)
      )
    )
  ) {}
}

pub theorem rational_neg_neg(x: AlgebraRational): RationalEq(rational_neg(rational_neg(x)), x) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(integer_pos(rational_num(x)), rational_den(x)),
      Nat::mul(integer_neg_part(rational_num(x)), rational_den(x))
    ) = Nat::add(
      Nat::mul(integer_pos(rational_num(x)), rational_den(x)),
      Nat::mul(integer_neg_part(rational_num(x)), rational_den(x))
    )
  ) {}
}

pub theorem rational_mul_comm(
  x: AlgebraRational,
  y: AlgebraRational
): RationalEq(rational_mul(x, y), rational_mul(y, x)) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(x)), integer_pos(rational_num(y))),
          Nat::mul(integer_neg_part(rational_num(x)), integer_neg_part(rational_num(y)))
        ),
        Nat::mul(rational_den(y), rational_den(x))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(y)), integer_pos(rational_num(x))),
          Nat::mul(integer_pos(rational_num(y)), integer_neg_part(rational_num(x)))
        ),
        Nat::mul(rational_den(x), rational_den(y))
      )
    ) = Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(y)), integer_pos(rational_num(x))),
          Nat::mul(integer_neg_part(rational_num(y)), integer_neg_part(rational_num(x)))
        ),
        Nat::mul(rational_den(x), rational_den(y))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(x)), integer_pos(rational_num(y))),
          Nat::mul(integer_pos(rational_num(x)), integer_neg_part(rational_num(y)))
        ),
        Nat::mul(rational_den(y), rational_den(x))
      )
    )
  ) {}
}

pub theorem rational_mul_assoc(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational
): RationalEq(rational_mul(rational_mul(x, y), z), rational_mul(x, rational_mul(y, z))) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(
            Nat::add(
              Nat::mul(integer_pos(rational_num(x)), integer_pos(rational_num(y))),
              Nat::mul(integer_neg_part(rational_num(x)), integer_neg_part(rational_num(y)))
            ),
            integer_pos(rational_num(z))
          ),
          Nat::mul(
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(x)), integer_pos(rational_num(y))),
              Nat::mul(integer_pos(rational_num(x)), integer_neg_part(rational_num(y)))
            ),
            integer_neg_part(rational_num(z))
          )
        ),
        Nat::mul(rational_den(x), Nat::mul(rational_den(y), rational_den(z)))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(
            integer_neg_part(rational_num(x)),
            Nat::add(
              Nat::mul(integer_pos(rational_num(y)), integer_pos(rational_num(z))),
              Nat::mul(integer_neg_part(rational_num(y)), integer_neg_part(rational_num(z)))
            )
          ),
          Nat::mul(
            integer_pos(rational_num(x)),
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(y)), integer_pos(rational_num(z))),
              Nat::mul(integer_pos(rational_num(y)), integer_neg_part(rational_num(z)))
            )
          )
        ),
        Nat::mul(Nat::mul(rational_den(x), rational_den(y)), rational_den(z))
      )
    ) = Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(
            integer_pos(rational_num(x)),
            Nat::add(
              Nat::mul(integer_pos(rational_num(y)), integer_pos(rational_num(z))),
              Nat::mul(integer_neg_part(rational_num(y)), integer_neg_part(rational_num(z)))
            )
          ),
          Nat::mul(
            integer_neg_part(rational_num(x)),
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(y)), integer_pos(rational_num(z))),
              Nat::mul(integer_pos(rational_num(y)), integer_neg_part(rational_num(z)))
            )
          )
        ),
        Nat::mul(Nat::mul(rational_den(x), rational_den(y)), rational_den(z))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(x)), integer_pos(rational_num(y))),
              Nat::mul(integer_pos(rational_num(x)), integer_neg_part(rational_num(y)))
            ),
            integer_pos(rational_num(z))
          ),
          Nat::mul(
            Nat::add(
              Nat::mul(integer_pos(rational_num(x)), integer_pos(rational_num(y))),
              Nat::mul(integer_neg_part(rational_num(x)), integer_neg_part(rational_num(y)))
            ),
            integer_neg_part(rational_num(z))
          )
        ),
        Nat::mul(rational_den(x), Nat::mul(rational_den(y), rational_den(z)))
      )
    )
  ) {}
}

pub theorem rational_mul_one(x: AlgebraRational): RationalEq(rational_mul(x, rational_one), x) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(x)), Succ(Zero)),
          Nat::mul(integer_neg_part(rational_num(x)), Zero)
        ),
        rational_den(x)
      ),
      Nat::mul(integer_neg_part(rational_num(x)), Nat::mul(rational_den(x), Succ(Zero)))
    ) = Nat::add(
      Nat::mul(integer_pos(rational_num(x)), Nat::mul(rational_den(x), Succ(Zero))),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(x)), Succ(Zero)),
          Nat::mul(integer_pos(rational_num(x)), Zero)
        ),
        rational_den(x)
      )
    )
  ) {}
}

pub theorem rational_mul_zero(
  x: AlgebraRational
): RationalEq(rational_mul(x, rational_zero), rational_zero) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(x)), Zero),
          Nat::mul(integer_neg_part(rational_num(x)), Zero)
        ),
        Succ(Zero)
      ),
      Nat::mul(Zero, Nat::mul(rational_den(x), Succ(Zero)))
    ) = Nat::add(
      Nat::mul(Zero, Nat::mul(rational_den(x), Succ(Zero))),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(x)), Zero),
          Nat::mul(integer_pos(rational_num(x)), Zero)
        ),
        Succ(Zero)
      )
    )
  ) {}
}

pub theorem rational_mul_add(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational
): RationalEq(
  rational_mul(x, rational_add(y, z)),
  rational_add(rational_mul(x, y), rational_mul(x, z))
) {
  by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(
            integer_pos(rational_num(x)),
            Nat::add(
              Nat::mul(integer_pos(rational_num(y)), rational_den(z)),
              Nat::mul(integer_pos(rational_num(z)), rational_den(y))
            )
          ),
          Nat::mul(
            integer_neg_part(rational_num(x)),
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(y)), rational_den(z)),
              Nat::mul(integer_neg_part(rational_num(z)), rational_den(y))
            )
          )
        ),
        Nat::mul(
          Nat::mul(rational_den(x), rational_den(y)),
          Nat::mul(rational_den(x), rational_den(z))
        )
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(x)), integer_pos(rational_num(y))),
              Nat::mul(integer_pos(rational_num(x)), integer_neg_part(rational_num(y)))
            ),
            Nat::mul(rational_den(x), rational_den(z))
          ),
          Nat::mul(
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(x)), integer_pos(rational_num(z))),
              Nat::mul(integer_pos(rational_num(x)), integer_neg_part(rational_num(z)))
            ),
            Nat::mul(rational_den(x), rational_den(y))
          )
        ),
        Nat::mul(rational_den(x), Nat::mul(rational_den(y), rational_den(z)))
      )
    ) = Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(
            Nat::add(
              Nat::mul(integer_pos(rational_num(x)), integer_pos(rational_num(y))),
              Nat::mul(integer_neg_part(rational_num(x)), integer_neg_part(rational_num(y)))
            ),
            Nat::mul(rational_den(x), rational_den(z))
          ),
          Nat::mul(
            Nat::add(
              Nat::mul(integer_pos(rational_num(x)), integer_pos(rational_num(z))),
              Nat::mul(integer_neg_part(rational_num(x)), integer_neg_part(rational_num(z)))
            ),
            Nat::mul(rational_den(x), rational_den(y))
          )
        ),
        Nat::mul(rational_den(x), Nat::mul(rational_den(y), rational_den(z)))
      ),
      Nat::mul(
        Nat::add(
          Nat::mul(
            integer_neg_part(rational_num(x)),
            Nat::add(
              Nat::mul(integer_pos(rational_num(y)), rational_den(z)),
              Nat::mul(integer_pos(rational_num(z)), rational_den(y))
            )
          ),
          Nat::mul(
            integer_pos(rational_num(x)),
            Nat::add(
              Nat::mul(integer_neg_part(rational_num(y)), rational_den(z)),
              Nat::mul(integer_neg_part(rational_num(z)), rational_den(y))
            )
          )
        ),
        Nat::mul(
          Nat::mul(rational_den(x), rational_den(y)),
          Nat::mul(rational_den(x), rational_den(z))
        )
      )
    )
  ) {}
}

pub theorem rational_neg_respects(
  x: AlgebraRational,
  y: AlgebraRational,
  h: RationalEq(x, y)
): RationalEq(rational_neg(x), rational_neg(y)) {
  integer_neg_respects(
    integer_scale(rational_num(x), rational_den(y)),
    integer_scale(rational_num(y), rational_den(x)),
    h
  )
}

pub theorem rational_add_respects(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational,
  w: AlgebraRational,
  h: RationalEq(x, y),
  k: RationalEq(z, w)
): RationalEq(rational_add(x, z), rational_add(y, w)) {
  rational_eq_trans(
    rational_add(x, z),
    rational_add(y, z),
    rational_add(y, w),
    rational_add_respects_left(x, y, z, h),
    rational_eq_trans(
      rational_add(y, z),
      rational_add(z, y),
      rational_add(y, w),
      rational_add_comm(y, z),
      rational_eq_trans(
        rational_add(z, y),
        rational_add(w, y),
        rational_add(y, w),
        rational_add_respects_left(z, w, y, k),
        rational_add_comm(w, y)
      )
    )
  )
}

pub theorem rational_mul_respects(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational,
  w: AlgebraRational,
  h: RationalEq(x, y),
  k: RationalEq(z, w)
): RationalEq(rational_mul(x, z), rational_mul(y, w)) {
  rational_eq_trans(
    rational_mul(x, z),
    rational_mul(y, z),
    rational_mul(y, w),
    rational_mul_respects_left(x, y, z, h),
    rational_eq_trans(
      rational_mul(y, z),
      rational_mul(z, y),
      rational_mul(y, w),
      rational_mul_comm(y, z),
      rational_eq_trans(
        rational_mul(z, y),
        rational_mul(w, y),
        rational_mul(y, w),
        rational_mul_respects_left(z, w, y, k),
        rational_mul_comm(w, y)
      )
    )
  )
}

pub theorem rational_sub_respects(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational,
  w: AlgebraRational,
  h: RationalEq(x, y),
  k: RationalEq(z, w)
): RationalEq(rational_sub(x, z), rational_sub(y, w)) {
  rational_add_respects(x, y, rational_neg(z), rational_neg(w), h, rational_neg_respects(z, w, k))
}

pub def RationalNonzero(x: AlgebraRational): Prop := IntegerNonzero(rational_num(x))

pub fn rational_inverse_sign(
  x: AlgebraRational,
  nonzero: RationalNonzero(x),
  s: IntegerSign(integer_pos(rational_num(x)), integer_neg_part(rational_num(x)))
): AlgebraRational {
  ⊢ AlgebraRational from match s {
    IntegerSignZero(h) => ⊢ AlgebraRational from match nonzero(
      Eq::trans(h, Eq::sym(Nat::add_zero_left(integer_neg_part(rational_num(x)))))
    ) {
    }
    IntegerSignPositive(k, h) => AlgebraRational::Mk(
      integer_of_nat(rational_den(x)),
      Succ(k),
      natural_succ_nonzero(k)
    )
    IntegerSignNegative(k, h) => AlgebraRational::Mk(
      integer_neg(integer_of_nat(rational_den(x))),
      Succ(k),
      natural_succ_nonzero(k)
    )
  }
}

pub def rational_inverse(x: AlgebraRational, nonzero: RationalNonzero(x)): AlgebraRational :=
rational_inverse_sign(
  x,
  nonzero,
  integer_sign(integer_pos(rational_num(x)), integer_neg_part(rational_num(x)))
)

pub def rational_div(
  x: AlgebraRational,
  y: AlgebraRational,
  nonzero: RationalNonzero(y)
): AlgebraRational := rational_mul(x, rational_inverse(y, nonzero))

pub theorem rational_inverse_positive(
  x: AlgebraRational,
  k: Nat,
  h: integer_pos(rational_num(x)) = Nat::add(integer_neg_part(rational_num(x)), Succ(k))
): RationalEq(
  rational_mul(
    x,
    AlgebraRational::Mk(integer_of_nat(rational_den(x)), Succ(k), natural_succ_nonzero(k))
  ),
  rational_one
) {
  let normalized: Nat::add(
    Nat::mul(
      Nat::add(
        Nat::mul(Nat::add(integer_neg_part(rational_num(x)), Succ(k)), rational_den(x)),
        Nat::mul(integer_neg_part(rational_num(x)), Zero)
      ),
      Succ(Zero)
    ),
    Nat::mul(Zero, Nat::mul(rational_den(x), Succ(k)))
  ) = Nat::add(
    Nat::mul(Succ(Zero), Nat::mul(rational_den(x), Succ(k))),
    Nat::mul(
      Nat::add(
        Nat::mul(integer_neg_part(rational_num(x)), rational_den(x)),
        Nat::mul(Nat::add(integer_neg_part(rational_num(x)), Succ(k)), Zero)
      ),
      Succ(Zero)
    )
  ) := by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(Nat::add(integer_neg_part(rational_num(x)), Succ(k)), rational_den(x)),
          Nat::mul(integer_neg_part(rational_num(x)), Zero)
        ),
        Succ(Zero)
      ),
      Nat::mul(Zero, Nat::mul(rational_den(x), Succ(k)))
    ) = Nat::add(
      Nat::mul(Succ(Zero), Nat::mul(rational_den(x), Succ(k))),
      Nat::mul(
        Nat::add(
          Nat::mul(integer_neg_part(rational_num(x)), rational_den(x)),
          Nat::mul(Nat::add(integer_neg_part(rational_num(x)), Succ(k)), Zero)
        ),
        Succ(Zero)
      )
    )
  ) {};
  Eq::subst(<A: Nat, a: Nat::add(integer_neg_part(rational_num(x)), Succ(k)), b: integer_pos(rational_num(x))>,
    (t: Nat) => Nat::add(
      Nat::mul(
        Nat::add(Nat::mul(t, rational_den(x)), Nat::mul(integer_neg_part(rational_num(x)), Zero)),
        Succ(Zero)
      ),
      Nat::mul(Zero, Nat::mul(rational_den(x), Succ(k)))
    ) = Nat::add(
      Nat::mul(Succ(Zero), Nat::mul(rational_den(x), Succ(k))),
      Nat::mul(
        Nat::add(Nat::mul(integer_neg_part(rational_num(x)), rational_den(x)), Nat::mul(t, Zero)),
        Succ(Zero)
      )
    ),
    Eq::sym(h),
    normalized
  )
}

pub theorem rational_inverse_negative(
  x: AlgebraRational,
  k: Nat,
  h: integer_neg_part(rational_num(x)) = Nat::add(integer_pos(rational_num(x)), Succ(k))
): RationalEq(
  rational_mul(
    x,
    AlgebraRational::Mk(
      integer_neg(integer_of_nat(rational_den(x))),
      Succ(k),
      natural_succ_nonzero(k)
    )
  ),
  rational_one
) {
  let normalized: Nat::add(
    Nat::mul(
      Nat::add(
        Nat::mul(integer_pos(rational_num(x)), Zero),
        Nat::mul(Nat::add(integer_pos(rational_num(x)), Succ(k)), rational_den(x))
      ),
      Succ(Zero)
    ),
    Nat::mul(Zero, Nat::mul(rational_den(x), Succ(k)))
  ) = Nat::add(
    Nat::mul(Succ(Zero), Nat::mul(rational_den(x), Succ(k))),
    Nat::mul(
      Nat::add(
        Nat::mul(Nat::add(integer_pos(rational_num(x)), Succ(k)), Zero),
        Nat::mul(integer_pos(rational_num(x)), rational_den(x))
      ),
      Succ(Zero)
    )
  ) := by nat_norm!(
    #()
  ): (
    Nat::add(
      Nat::mul(
        Nat::add(
          Nat::mul(integer_pos(rational_num(x)), Zero),
          Nat::mul(Nat::add(integer_pos(rational_num(x)), Succ(k)), rational_den(x))
        ),
        Succ(Zero)
      ),
      Nat::mul(Zero, Nat::mul(rational_den(x), Succ(k)))
    ) = Nat::add(
      Nat::mul(Succ(Zero), Nat::mul(rational_den(x), Succ(k))),
      Nat::mul(
        Nat::add(
          Nat::mul(Nat::add(integer_pos(rational_num(x)), Succ(k)), Zero),
          Nat::mul(integer_pos(rational_num(x)), rational_den(x))
        ),
        Succ(Zero)
      )
    )
  ) {};
  Eq::subst(<A: Nat, a: Nat::add(integer_pos(rational_num(x)), Succ(k)), b: integer_neg_part(rational_num(x))>,
    (t: Nat) => Nat::add(
      Nat::mul(
        Nat::add(Nat::mul(integer_pos(rational_num(x)), Zero), Nat::mul(t, rational_den(x))),
        Succ(Zero)
      ),
      Nat::mul(Zero, Nat::mul(rational_den(x), Succ(k)))
    ) = Nat::add(
      Nat::mul(Succ(Zero), Nat::mul(rational_den(x), Succ(k))),
      Nat::mul(
        Nat::add(Nat::mul(t, Zero), Nat::mul(integer_pos(rational_num(x)), rational_den(x))),
        Succ(Zero)
      )
    ),
    Eq::sym(h),
    normalized
  )
}

pub theorem rational_inverse_sign_law(
  x: AlgebraRational,
  nonzero: RationalNonzero(x),
  s: IntegerSign(integer_pos(rational_num(x)), integer_neg_part(rational_num(x)))
): RationalEq(rational_mul(x, rational_inverse_sign(x, nonzero, s)), rational_one) {
  ⊢ RationalEq(rational_mul(x, rational_inverse_sign(x, nonzero, s)), rational_one) from match s {
    IntegerSignZero(h) => False::elim(
      nonzero(Eq::trans(h, Eq::sym(Nat::add_zero_left(integer_neg_part(rational_num(x))))))
    )
    IntegerSignPositive(k, h) => rational_inverse_positive(x, k, h)
    IntegerSignNegative(k, h) => rational_inverse_negative(x, k, h)
  }
}

pub theorem rational_inverse_law(
  x: AlgebraRational,
  nonzero: RationalNonzero(x)
): RationalEq(rational_mul(x, rational_inverse(x, nonzero)), rational_one) {
  rational_inverse_sign_law(
    x,
    nonzero,
    integer_sign(integer_pos(rational_num(x)), integer_neg_part(rational_num(x)))
  )
}

pub theorem rational_left_one(x: AlgebraRational): RationalEq(rational_mul(rational_one, x), x) {
  rational_eq_trans(
    rational_mul(rational_one, x),
    rational_mul(x, rational_one),
    x,
    rational_mul_comm(rational_one, x),
    rational_mul_one(x)
  )
}

pub theorem rational_inverse_unique(
  x: AlgebraRational,
  a: AlgebraRational,
  b: AlgebraRational,
  ha: RationalEq(rational_mul(x, a), rational_one),
  hb: RationalEq(rational_mul(x, b), rational_one)
): RationalEq(a, b) {
  let first: RationalEq(
    a,
    rational_mul(a, rational_one)
  ) := rational_eq_sym(rational_mul(a, rational_one), a, rational_mul_one(a));
  let second: RationalEq(rational_mul(a, rational_one), rational_mul(a, rational_mul(x, b))) :=
  rational_mul_respects(
    a,
    a,
    rational_one,
    rational_mul(x, b),
    rational_eq_refl(a),
    rational_eq_sym(rational_mul(x, b), rational_one, hb)
  );
  let third: RationalEq(rational_mul(a, rational_mul(x, b)), rational_mul(rational_mul(a, x), b)) :=
  rational_eq_sym(
    rational_mul(rational_mul(a, x), b),
    rational_mul(a, rational_mul(x, b)),
    rational_mul_assoc(a, x, b)
  );
  let fourth: RationalEq(rational_mul(rational_mul(a, x), b), rational_mul(rational_mul(x, a), b)) :=
  rational_mul_respects_left(rational_mul(a, x), rational_mul(x, a), b, rational_mul_comm(a, x));
  let fifth: RationalEq(
    rational_mul(rational_mul(x, a), b),
    rational_mul(rational_one, b)
  ) := rational_mul_respects_left(rational_mul(x, a), rational_one, b, ha);
  rational_eq_trans(
    a,
    rational_mul(a, rational_one),
    b,
    first,
    rational_eq_trans(
      rational_mul(a, rational_one),
      rational_mul(a, rational_mul(x, b)),
      b,
      second,
      rational_eq_trans(
        rational_mul(a, rational_mul(x, b)),
        rational_mul(rational_mul(a, x), b),
        b,
        third,
        rational_eq_trans(
          rational_mul(rational_mul(a, x), b),
          rational_mul(rational_mul(x, a), b),
          b,
          fourth,
          rational_eq_trans(
            rational_mul(rational_mul(x, a), b),
            rational_mul(rational_one, b),
            b,
            fifth,
            rational_left_one(b)
          )
        )
      )
    )
  )
}

pub theorem rational_nonzero_respects(
  x: AlgebraRational,
  y: AlgebraRational,
  h: RationalEq(x, y),
  nx: RationalNonzero(x)
): RationalNonzero(y) {
  hy => nx(
    rational_cancel_scale(
      rational_num(x),
      integer_zero,
      rational_den(y),
      rational_den_nonzero(y),
      integer_eq_trans(
        integer_scale(rational_num(x), rational_den(y)),
        integer_zero,
        integer_scale(integer_zero, rational_den(y)),
        integer_eq_trans(
          integer_scale(rational_num(x), rational_den(y)),
          integer_scale(rational_num(y), rational_den(x)),
          integer_zero,
          h,
          integer_eq_trans(
            integer_scale(rational_num(y), rational_den(x)),
            integer_scale(integer_zero, rational_den(x)),
            integer_zero,
            integer_scale_respects(rational_num(y), integer_zero, rational_den(x), hy),
            integer_scale_zero(rational_den(x))
          )
        ),
        integer_eq_sym(
          integer_scale(integer_zero, rational_den(y)),
          integer_zero,
          integer_scale_zero(rational_den(y))
        )
      )
    )
  )
}

pub theorem rational_inverse_respects(
  x: AlgebraRational,
  y: AlgebraRational,
  nx: RationalNonzero(x),
  ny: RationalNonzero(y),
  h: RationalEq(x, y)
): RationalEq(rational_inverse(x, nx), rational_inverse(y, ny)) {
  rational_inverse_unique(
    y,
    rational_inverse(x, nx),
    rational_inverse(y, ny),
    rational_eq_trans(
      rational_mul(y, rational_inverse(x, nx)),
      rational_mul(x, rational_inverse(x, nx)),
      rational_one,
      rational_mul_respects_left(y, x, rational_inverse(x, nx), rational_eq_sym(x, y, h)),
      rational_inverse_law(x, nx)
    ),
    rational_inverse_law(y, ny)
  )
}

pub theorem rational_div_respects(
  x: AlgebraRational,
  y: AlgebraRational,
  z: AlgebraRational,
  w: AlgebraRational,
  nz: RationalNonzero(z),
  nw: RationalNonzero(w),
  h: RationalEq(x, y),
  k: RationalEq(z, w)
): RationalEq(rational_div(x, z, nz), rational_div(y, w, nw)) {
  rational_mul_respects(
    x,
    y,
    rational_inverse(z, nz),
    rational_inverse(w, nw),
    h,
    rational_inverse_respects(z, w, nz, nw, k)
  )
}

pub theorem rational_of_integer_respects(
  x: AlgebraInteger,
  y: AlgebraInteger,
  h: IntegerEq(x, y)
): RationalEq(rational_of_integer(x), rational_of_integer(y)) {
  integer_scale_respects(x, y, Succ(Zero), h)
}

pub theorem rational_of_integer_injective(
  x: AlgebraInteger,
  y: AlgebraInteger,
  h: RationalEq(rational_of_integer(x), rational_of_integer(y))
): IntegerEq(x, y) {
  integer_scale_cancel(x, y, Zero, h)
}

pub theorem rational_of_integer_add(
  x: AlgebraInteger,
  y: AlgebraInteger
): RationalEq(
  rational_of_integer(integer_add(x, y)),
  rational_add(rational_of_integer(x), rational_of_integer(y))
) {
  integer_scale_respects(
    integer_add(x, y),
    integer_add(integer_scale(x, Succ(Zero)), integer_scale(y, Succ(Zero))),
    Succ(Zero),
    integer_add_respects(
      x,
      integer_scale(x, Succ(Zero)),
      y,
      integer_scale(y, Succ(Zero)),
      integer_eq_sym(integer_scale(x, Succ(Zero)), x, integer_scale_one(x)),
      integer_eq_sym(integer_scale(y, Succ(Zero)), y, integer_scale_one(y))
    )
  )
}

pub theorem rational_of_integer_mul(
  x: AlgebraInteger,
  y: AlgebraInteger
): RationalEq(
  rational_of_integer(integer_mul(x, y)),
  rational_mul(rational_of_integer(x), rational_of_integer(y))
) {
  integer_eq_refl(integer_scale(integer_mul(x, y), Succ(Zero)))
}

pub theorem rational_nonzero_not_zero(
  x: AlgebraRational,
  nx: RationalNonzero(x),
  h: RationalEq(x, rational_zero)
): False {
  nx(
    integer_eq_trans(
      rational_num(x),
      integer_scale(rational_num(x), Succ(Zero)),
      integer_zero,
      integer_eq_sym(
        integer_scale(rational_num(x), Succ(Zero)),
        rational_num(x),
        integer_scale_one(rational_num(x))
      ),
      integer_eq_trans(
        integer_scale(rational_num(x), Succ(Zero)),
        integer_scale(integer_zero, rational_den(x)),
        integer_zero,
        h,
        integer_scale_zero(rational_den(x))
      )
    )
  )
}

pub theorem rational_nonzero_of_not_zero(
  x: AlgebraRational,
  h: ∀ e: RationalEq(x, rational_zero). False
): RationalNonzero(x) {
  n => h(
    integer_eq_trans(
      integer_scale(rational_num(x), Succ(Zero)),
      rational_num(x),
      integer_scale(integer_zero, rational_den(x)),
      integer_scale_one(rational_num(x)),
      integer_eq_trans(
        rational_num(x),
        integer_zero,
        integer_scale(integer_zero, rational_den(x)),
        n,
        integer_eq_sym(
          integer_scale(integer_zero, rational_den(x)),
          integer_zero,
          integer_scale_zero(rational_den(x))
        )
      )
    )
  )
}

pub theorem rational_zero_ne_one(h: RationalEq(rational_zero, rational_one)): False {
  integer_nat_zero_ne_succ(Zero, rational_of_integer_injective(integer_zero, integer_one, h))
}

pub theorem rational_div_cancel(
  x: AlgebraRational,
  y: AlgebraRational,
  ny: RationalNonzero(y)
): RationalEq(rational_mul(rational_div(x, y, ny), y), x) {
  rational_eq_trans(
    rational_mul(rational_div(x, y, ny), y),
    rational_mul(x, rational_mul(rational_inverse(y, ny), y)),
    x,
    rational_mul_assoc(x, rational_inverse(y, ny), y),
    rational_eq_trans(
      rational_mul(x, rational_mul(rational_inverse(y, ny), y)),
      rational_mul(x, rational_mul(y, rational_inverse(y, ny))),
      x,
      rational_mul_respects(
        x,
        x,
        rational_mul(rational_inverse(y, ny), y),
        rational_mul(y, rational_inverse(y, ny)),
        rational_eq_refl(x),
        rational_mul_comm(rational_inverse(y, ny), y)
      ),
      rational_eq_trans(
        rational_mul(x, rational_mul(y, rational_inverse(y, ny))),
        rational_mul(x, rational_one),
        x,
        rational_mul_respects(
          x,
          x,
          rational_mul(y, rational_inverse(y, ny)),
          rational_one,
          rational_eq_refl(x),
          rational_inverse_law(y, ny)
        ),
        rational_mul_one(x)
      )
    )
  )
}
