import "Finite.taut"

def AlgebraMatrix(R: Type, rows: Nat, columns: Nat): Type :=
(AlgebraFin(rows), AlgebraFin(columns)) -> R

def AlgebraMatrixEq(
  R: Type,
  rows: Nat,
  columns: Nat,
  left: AlgebraMatrix(R, rows, columns),
  right: AlgebraMatrix(R, rows, columns)
): Prop :=
∀ row: AlgebraFin(
  rows
). ∀ column: AlgebraFin(columns). AlgebraEq(0, R, left(row, column), right(row, column))

fn algebra_vector_zero<R: Type>(
  addition: AlgebraMonoid(0, R),
  n: Nat
) -> AlgebraVector(R, n) { index => algebra_unit(0, R, addition) }

fn algebra_vector_add<R: Type>(
  addition: AlgebraMonoid(0, R),
  n: Nat,
  left: AlgebraVector(R, n),
  right: AlgebraVector(R, n)
) -> AlgebraVector(R, n) { index => algebra_op(0, R, addition)(left(index), right(index)) }

// Right scalar multiplication needs no commutativity of the semiring product.
fn algebra_vector_scale<R: Type>(
  multiplication: AlgebraMonoid(0, R),
  n: Nat,
  values: AlgebraVector(R, n),
  scalar: R
) -> AlgebraVector(R, n) { index => algebra_op(0, R, multiplication)(values(index), scalar) }

fn algebra_matrix_add<R: Type>(
  addition: AlgebraMonoid(0, R),
  rows: Nat,
  columns: Nat,
  left: AlgebraMatrix(R, rows, columns),
  right: AlgebraMatrix(R, rows, columns)
) -> AlgebraMatrix(
  R,
  rows,
  columns
) { row => column => algebra_op(0, R, addition)(left(row, column), right(row, column)) }

fn algebra_matrix_scale<R: Type>(
  multiplication: AlgebraMonoid(0, R),
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  scalar: R
) -> AlgebraMatrix(
  R,
  rows,
  columns
) { row => column => algebra_op(0, R, multiplication)(matrix(row, column), scalar) }

fn algebra_matrix_apply<R: Type>(
  addition: AlgebraMonoid(0, R),
  multiplication: AlgebraMonoid(0, R),
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  values: AlgebraVector(R, columns)
) -> AlgebraVector(
  R,
  rows
) { row => algebra_sum(
  R,
  addition,
  columns,
  column => algebra_op(0, R, multiplication)(matrix(row, column), values(column))
) }

fn algebra_matrix_product<R: Type>(
  addition: AlgebraMonoid(0, R),
  multiplication: AlgebraMonoid(0, R),
  rows: Nat,
  inner: Nat,
  columns: Nat,
  left: AlgebraMatrix(R, rows, inner),
  right: AlgebraMatrix(R, inner, columns)
) -> AlgebraMatrix(
  R,
  rows,
  columns
) { row => column => algebra_sum(
  R,
  addition,
  inner,
  index => algebra_op(0, R, multiplication)(left(row, index), right(index, column))
) }

theorem algebra_matrix_apply_congr<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  left: AlgebraVector(R, columns),
  right: AlgebraVector(R, columns),
  equal: AlgebraVectorEq(R, columns, left, right),
  row: AlgebraFin(rows)
): AlgebraEq(
  0,
  R,
  algebra_matrix_apply(R, addition, multiplication, rows, columns, matrix, left)(row),
  algebra_matrix_apply(R, addition, multiplication, rows, columns, matrix, right)(row)
) {
  algebra_sum_congr(
    R,
    addition,
    columns,
    column => algebra_op(0, R, multiplication)(matrix(row, column), left(column)),
    column => algebra_op(0, R, multiplication)(matrix(row, column), right(column)),
    column => algebra_apply(
      (v: R) => algebra_op(0, R, multiplication)(matrix(row, column), v),
      equal(column)
    )
  )
}

theorem algebra_matrix_apply_zero<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  row: AlgebraFin(rows)
): AlgebraEq(
  0,
  R,
  algebra_matrix_apply(
    R,
    addition,
    multiplication,
    rows,
    columns,
    matrix,
    algebra_vector_zero(R, addition, columns)
  )(row),
  algebra_unit(0, R, addition)
) {
  algebra_chain(
    algebra_sum_congr(
      R,
      addition,
      columns,
      column => algebra_op(0, R, multiplication)(matrix(row, column), algebra_unit(0, R, addition)),
      column => algebra_unit(0, R, addition),
      column => algebra_mul_zero(laws, matrix(row, column))
    ),
    algebra_sum_zero(R, addition, columns)
  )
}

theorem algebra_matrix_apply_add<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  left: AlgebraVector(R, columns),
  right: AlgebraVector(R, columns),
  row: AlgebraFin(rows)
): AlgebraEq(
  0,
  R,
  algebra_matrix_apply(
    R,
    addition,
    multiplication,
    rows,
    columns,
    matrix,
    algebra_vector_add(R, addition, columns, left, right)
  )(row),
  algebra_op(
    0,
    R,
    addition
  )(
    algebra_matrix_apply(R, addition, multiplication, rows, columns, matrix, left)(row),
    algebra_matrix_apply(R, addition, multiplication, rows, columns, matrix, right)(row)
  )
) {
  algebra_chain(
    algebra_sum_congr(
      R,
      addition,
      columns,
      column => algebra_op(
        0,
        R,
        multiplication
      )(matrix(row, column), algebra_op(0, R, addition)(left(column), right(column))),
      column => algebra_op(
        0,
        R,
        addition
      )(
        algebra_op(0, R, multiplication)(matrix(row, column), left(column)),
        algebra_op(0, R, multiplication)(matrix(row, column), right(column))
      ),
      column => algebra_distribute_left(laws, matrix(row, column), left(column), right(column))
    ),
    algebra_sum_add(
      laws,
      columns,
      column => algebra_op(0, R, multiplication)(matrix(row, column), left(column)),
      column => algebra_op(0, R, multiplication)(matrix(row, column), right(column))
    )
  )
}

theorem algebra_matrix_apply_scale<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  values: AlgebraVector(R, columns),
  scalar: R,
  row: AlgebraFin(rows)
): AlgebraEq(
  0,
  R,
  algebra_matrix_apply(
    R,
    addition,
    multiplication,
    rows,
    columns,
    matrix,
    algebra_vector_scale(R, multiplication, columns, values, scalar)
  )(row),
  algebra_op(
    0,
    R,
    multiplication
  )(algebra_matrix_apply(R, addition, multiplication, rows, columns, matrix, values)(row), scalar)
) {
  algebra_chain(
    algebra_sum_congr(
      R,
      addition,
      columns,
      column => algebra_op(
        0,
        R,
        multiplication
      )(matrix(row, column), algebra_op(0, R, multiplication)(values(column), scalar)),
      column => algebra_op(
        0,
        R,
        multiplication
      )(algebra_op(0, R, multiplication)(matrix(row, column), values(column)), scalar),
      column => algebra_flip(
        algebra_assoc(0, R, multiplication, matrix(row, column), values(column), scalar)
      )
    ),
    algebra_sum_mul_right(
      laws,
      columns,
      column => algebra_op(0, R, multiplication)(matrix(row, column), values(column)),
      scalar
    )
  )
}

theorem algebra_sum_product<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  inner: Nat,
  columns: Nat,
  left: AlgebraVector(R, inner),
  middle: AlgebraMatrix(R, inner, columns),
  right: AlgebraVector(R, columns)
): AlgebraEq(
  0,
  R,
  algebra_sum(
    R,
    addition,
    columns,
    column => algebra_op(
      0,
      R,
      multiplication
    )(
      algebra_sum(
        R,
        addition,
        inner,
        index => algebra_op(0, R, multiplication)(left(index), middle(index, column))
      ),
      right(column)
    )
  ),
  algebra_sum(
    R,
    addition,
    inner,
    index => algebra_op(
      0,
      R,
      multiplication
    )(
      left(index),
      algebra_sum(
        R,
        addition,
        columns,
        column => algebra_op(0, R, multiplication)(middle(index, column), right(column))
      )
    )
  )
) {
  algebra_chain(
    algebra_sum_congr(
      R,
      addition,
      columns,
      column => algebra_op(
        0,
        R,
        multiplication
      )(
        algebra_sum(
          R,
          addition,
          inner,
          index => algebra_op(0, R, multiplication)(left(index), middle(index, column))
        ),
        right(column)
      ),
      column => algebra_sum(
        R,
        addition,
        inner,
        index => algebra_op(
          0,
          R,
          multiplication
        )(algebra_op(0, R, multiplication)(left(index), middle(index, column)), right(column))
      ),
      column => algebra_flip(
        algebra_sum_mul_right(
          laws,
          inner,
          index => algebra_op(0, R, multiplication)(left(index), middle(index, column)),
          right(column)
        )
      )
    ),
    algebra_chain(
      algebra_sum_congr(
        R,
        addition,
        columns,
        column => algebra_sum(
          R,
          addition,
          inner,
          index => algebra_op(
            0,
            R,
            multiplication
          )(algebra_op(0, R, multiplication)(left(index), middle(index, column)), right(column))
        ),
        column => algebra_sum(
          R,
          addition,
          inner,
          index => algebra_op(
            0,
            R,
            multiplication
          )(left(index), algebra_op(0, R, multiplication)(middle(index, column), right(column)))
        ),
        column => algebra_sum_congr(
          R,
          addition,
          inner,
          index => algebra_op(
            0,
            R,
            multiplication
          )(algebra_op(0, R, multiplication)(left(index), middle(index, column)), right(column)),
          index => algebra_op(
            0,
            R,
            multiplication
          )(left(index), algebra_op(0, R, multiplication)(middle(index, column), right(column))),
          index => algebra_assoc(
            0,
            R,
            multiplication,
            left(index),
            middle(index, column),
            right(column)
          )
        )
      ),
      algebra_chain(
        algebra_sum_swap(
          laws,
          columns,
          inner,
          column => index => algebra_op(
            0,
            R,
            multiplication
          )(left(index), algebra_op(0, R, multiplication)(middle(index, column), right(column)))
        ),
        algebra_sum_congr(
          R,
          addition,
          inner,
          index => algebra_sum(
            R,
            addition,
            columns,
            column => algebra_op(
              0,
              R,
              multiplication
            )(left(index), algebra_op(0, R, multiplication)(middle(index, column), right(column)))
          ),
          index => algebra_op(
            0,
            R,
            multiplication
          )(
            left(index),
            algebra_sum(
              R,
              addition,
              columns,
              column => algebra_op(0, R, multiplication)(middle(index, column), right(column))
            )
          ),
          index => algebra_sum_mul_left(
            laws,
            columns,
            column => algebra_op(0, R, multiplication)(middle(index, column), right(column)),
            left(index)
          )
        )
      )
    )
  )
}

theorem algebra_matrix_product_assoc<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  rows: Nat,
  first: Nat,
  second: Nat,
  columns: Nat,
  a: AlgebraMatrix(R, rows, first),
  b: AlgebraMatrix(R, first, second),
  c: AlgebraMatrix(R, second, columns),
  row: AlgebraFin(rows),
  column: AlgebraFin(columns)
): AlgebraEq(
  0,
  R,
  algebra_matrix_product(
    R,
    addition,
    multiplication,
    rows,
    second,
    columns,
    algebra_matrix_product(R, addition, multiplication, rows, first, second, a, b),
    c
  )(row, column),
  algebra_matrix_product(
    R,
    addition,
    multiplication,
    rows,
    first,
    columns,
    a,
    algebra_matrix_product(R, addition, multiplication, first, second, columns, b, c)
  )(row, column)
) {
  algebra_sum_product(laws, first, second, index => a(row, index), b, index => c(index, column))
}

theorem algebra_matrix_product_apply<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  rows: Nat,
  inner: Nat,
  columns: Nat,
  left: AlgebraMatrix(R, rows, inner),
  right: AlgebraMatrix(R, inner, columns),
  values: AlgebraVector(R, columns),
  row: AlgebraFin(rows)
): AlgebraEq(
  0,
  R,
  algebra_matrix_apply(
    R,
    addition,
    multiplication,
    rows,
    columns,
    algebra_matrix_product(R, addition, multiplication, rows, inner, columns, left, right),
    values
  )(row),
  algebra_matrix_apply(
    R,
    addition,
    multiplication,
    rows,
    inner,
    left,
    algebra_matrix_apply(R, addition, multiplication, inner, columns, right, values)
  )(row)
) {
  algebra_sum_product(laws, inner, columns, index => left(row, index), right, values)
}

fn algebra_matrix_identity<R: Type>(
  addition: AlgebraMonoid(0, R),
  multiplication: AlgebraMonoid(0, R),
  n: Nat,
  row: AlgebraFin(n),
  column: AlgebraFin(n)
) -> R {
  match row -> R {
    algebra_first(k) => match column -> R {
      algebra_first(j) => algebra_unit(0, R, multiplication)
      algebra_next(j, prior) => algebra_unit(0, R, addition)
    }
    algebra_next(k, prior_row) => match column -> R {
      algebra_first(j) => algebra_unit(0, R, addition)
      algebra_next(
        j,
        prior_column
      ) => algebra_matrix_identity(R, addition, multiplication, k, prior_row, prior_column)
    }
  }
}

theorem algebra_matrix_identity_sum_left<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  n: Nat,
  row: AlgebraFin(n),
  values: AlgebraVector(R, n)
): AlgebraEq(
  0,
  R,
  algebra_sum(
    R,
    addition,
    n,
    column => algebra_op(
      0,
      R,
      multiplication
    )(algebra_matrix_identity(R, addition, multiplication, n, row, column), values(column))
  ),
  values(row)
) {
  match row -> AlgebraEq(
    0,
    R,
    algebra_sum(
      R,
      addition,
      n,
      column => algebra_op(
        0,
        R,
        multiplication
      )(algebra_matrix_identity(R, addition, multiplication, n, row, column), values(column))
    ),
    values(row)
  ) {
    algebra_first(
      k
    ) => algebra_chain(
      algebra_binary_congr(
        algebra_op(0, R, addition),
        algebra_left_unit(0, R, multiplication, values(algebra_first(k))),
        algebra_chain(
          algebra_sum_congr(
            R,
            addition,
            k,
            column => algebra_op(
              0,
              R,
              multiplication
            )(algebra_unit(0, R, addition), values(algebra_next(k, column))),
            column => algebra_unit(0, R, addition),
            column => algebra_zero_mul(laws, values(algebra_next(k, column)))
          ),
          algebra_sum_zero(R, addition, k)
        )
      ),
      algebra_right_unit(0, R, addition, values(algebra_first(k)))
    )
    algebra_next(
      k,
      prior
    ) => algebra_chain(
      algebra_binary_congr(
        algebra_op(0, R, addition),
        algebra_zero_mul(laws, values(algebra_first(k))),
        algebra_matrix_identity_sum_left(laws, k, prior, column => values(algebra_next(k, column)))
      ),
      algebra_left_unit(0, R, addition, values(algebra_next(k, prior)))
    )
  }
}

theorem algebra_matrix_identity_sum_right<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  n: Nat,
  row: AlgebraFin(n),
  values: AlgebraVector(R, n)
): AlgebraEq(
  0,
  R,
  algebra_sum(
    R,
    addition,
    n,
    column => algebra_op(
      0,
      R,
      multiplication
    )(values(column), algebra_matrix_identity(R, addition, multiplication, n, column, row))
  ),
  values(row)
) {
  match row -> AlgebraEq(
    0,
    R,
    algebra_sum(
      R,
      addition,
      n,
      column => algebra_op(
        0,
        R,
        multiplication
      )(values(column), algebra_matrix_identity(R, addition, multiplication, n, column, row))
    ),
    values(row)
  ) {
    algebra_first(
      k
    ) => algebra_chain(
      algebra_binary_congr(
        algebra_op(0, R, addition),
        algebra_right_unit(0, R, multiplication, values(algebra_first(k))),
        algebra_chain(
          algebra_sum_congr(
            R,
            addition,
            k,
            column => algebra_op(
              0,
              R,
              multiplication
            )(values(algebra_next(k, column)), algebra_unit(0, R, addition)),
            column => algebra_unit(0, R, addition),
            column => algebra_mul_zero(laws, values(algebra_next(k, column)))
          ),
          algebra_sum_zero(R, addition, k)
        )
      ),
      algebra_right_unit(0, R, addition, values(algebra_first(k)))
    )
    algebra_next(
      k,
      prior
    ) => algebra_chain(
      algebra_binary_congr(
        algebra_op(0, R, addition),
        algebra_mul_zero(laws, values(algebra_first(k))),
        algebra_matrix_identity_sum_right(laws, k, prior, column => values(algebra_next(k, column)))
      ),
      algebra_left_unit(0, R, addition, values(algebra_next(k, prior)))
    )
  }
}

theorem algebra_matrix_identity_left<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  row: AlgebraFin(rows),
  column: AlgebraFin(columns)
): AlgebraEq(
  0,
  R,
  algebra_matrix_product(
    R,
    addition,
    multiplication,
    rows,
    rows,
    columns,
    i => j => algebra_matrix_identity(R, addition, multiplication, rows, i, j),
    matrix
  )(row, column),
  matrix(row, column)
) {
  algebra_matrix_identity_sum_left(laws, rows, row, index => matrix(index, column))
}

theorem algebra_matrix_identity_right<R: Type, addition: AlgebraMonoid(
  0,
  R
), multiplication: AlgebraMonoid(
  0,
  R
)>(
  laws: AlgebraSemiring(R, addition, multiplication),
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  row: AlgebraFin(rows),
  column: AlgebraFin(columns)
): AlgebraEq(
  0,
  R,
  algebra_matrix_product(
    R,
    addition,
    multiplication,
    rows,
    columns,
    columns,
    matrix,
    i => j => algebra_matrix_identity(R, addition, multiplication, columns, i, j)
  )(row, column),
  matrix(row, column)
) {
  algebra_matrix_identity_sum_right(laws, columns, column, index => matrix(row, index))
}

theorem algebra_matrix_add_assoc<R: Type>(
  addition: AlgebraMonoid(0, R),
  rows: Nat,
  columns: Nat,
  a: AlgebraMatrix(R, rows, columns),
  b: AlgebraMatrix(R, rows, columns),
  c: AlgebraMatrix(R, rows, columns),
  row: AlgebraFin(rows),
  column: AlgebraFin(columns)
): AlgebraEq(
  0,
  R,
  algebra_matrix_add(
    R,
    addition,
    rows,
    columns,
    algebra_matrix_add(R, addition, rows, columns, a, b),
    c
  )(row, column),
  algebra_matrix_add(
    R,
    addition,
    rows,
    columns,
    a,
    algebra_matrix_add(R, addition, rows, columns, b, c)
  )(row, column)
) {
  algebra_assoc(0, R, addition, a(row, column), b(row, column), c(row, column))
}

theorem algebra_matrix_scale_assoc<R: Type>(
  multiplication: AlgebraMonoid(0, R),
  rows: Nat,
  columns: Nat,
  matrix: AlgebraMatrix(R, rows, columns),
  a: R,
  b: R,
  row: AlgebraFin(rows),
  column: AlgebraFin(columns)
): AlgebraEq(
  0,
  R,
  algebra_matrix_scale(
    R,
    multiplication,
    rows,
    columns,
    algebra_matrix_scale(R, multiplication, rows, columns, matrix, a),
    b
  )(row, column),
  algebra_matrix_scale(
    R,
    multiplication,
    rows,
    columns,
    matrix,
    algebra_op(0, R, multiplication)(a, b)
  )(row, column)
) {
  algebra_assoc(0, R, multiplication, matrix(row, column), a, b)
}

theorem algebra_matrix_product_congr<R: Type, rows: Nat, inner: Nat, columns: Nat, left: AlgebraMatrix(
  R,
  rows,
  inner
), left_other: AlgebraMatrix(
  R,
  rows,
  inner
), right: AlgebraMatrix(
  R,
  inner,
  columns
), right_other: AlgebraMatrix(
  R,
  inner,
  columns
)>(
  addition: AlgebraMonoid(0, R),
  multiplication: AlgebraMonoid(0, R),
  left_equal: AlgebraMatrixEq(R, rows, inner, left, left_other),
  right_equal: AlgebraMatrixEq(R, inner, columns, right, right_other),
  row: AlgebraFin(rows),
  column: AlgebraFin(columns)
): AlgebraEq(
  0,
  R,
  algebra_matrix_product(
    R,
    addition,
    multiplication,
    rows,
    inner,
    columns,
    left,
    right
  )(row, column),
  algebra_matrix_product(
    R,
    addition,
    multiplication,
    rows,
    inner,
    columns,
    left_other,
    right_other
  )(row, column)
) {
  algebra_sum_congr(
    R,
    addition,
    inner,
    index => algebra_op(0, R, multiplication)(left(row, index), right(index, column)),
    index => algebra_op(0, R, multiplication)(left_other(row, index), right_other(index, column)),
    index => algebra_binary_congr(
      algebra_op(0, R, multiplication),
      left_equal(row, index),
      right_equal(index, column)
    )
  )
}
