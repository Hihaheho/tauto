import "Monoid.taut"
import "Equality.taut"

// A group is an explicit monoid, inverse operation, and this law witness.
pub(open) inductive AlgebraGroup(
  u: Level,
  A: Type(u),
  m: AlgebraMonoid(u, A),
  inverse: (A) -> A
): Prop {
  Mk(
    left: ∀ x: A. AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(inverse(x), x), algebra_unit(<u: u, A: A>, m)),
    right: ∀ x: A. AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(x, inverse(x)), algebra_unit(<u: u, A: A>, m))
  ): AlgebraGroup(u, A, m, inverse)
}

pub theorem algebra_inverse_left<u: Level, A: Type(
  u
), m: AlgebraMonoid(
  u,
  A
), inverse: (
  A
) -> A>(
  g: AlgebraGroup(u, A, m, inverse),
  x: A
): AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(inverse(x), x), algebra_unit(<u: u, A: A>, m)) {
  AlgebraGroup::ind(<u: u, A: A, m: m, inverse: inverse>,
    witness => AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(inverse(x), x), algebra_unit(<u: u, A: A>, m)),
    left => right => left(x),
    g
  )
}

pub theorem algebra_inverse_right<u: Level, A: Type(
  u
), m: AlgebraMonoid(
  u,
  A
), inverse: (
  A
) -> A>(
  g: AlgebraGroup(u, A, m, inverse),
  x: A
): AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(x, inverse(x)), algebra_unit(<u: u, A: A>, m)) {
  AlgebraGroup::ind(<u: u, A: A, m: m, inverse: inverse>,
    witness => AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(x, inverse(x)), algebra_unit(<u: u, A: A>, m)),
    left => right => right(x),
    g
  )
}

pub theorem algebra_cancel_left<u: Level, A: Type(
  u
), m: AlgebraMonoid(
  u,
  A
), inverse: (
  A
) -> A>(
  g: AlgebraGroup(u, A, m, inverse),
  a: A,
  b: A,
  c: A,
  h: AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(a, b), algebra_op(<u: u, A: A>, m)(a, c))
): AlgebraEq(u, A, b, c) {
  let step0: AlgebraEq(
    u,
    A,
    b,
    algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), b)
  ) := algebra_sym(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), b), b: b>,
    algebra_left_unit(<u: u, A: A>, m, b)
  );
  let step1: AlgebraEq(
    u,
    A,
    algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), b),
    algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), b)
  ) := algebra_congr(<u: u, v: u, A: A, B: A, a: algebra_unit(<u: u, A: A>, m), b: algebra_op(<u: u, A: A>, m)(inverse(a), a)>,
    t => algebra_op(<u: u, A: A>, m)(t, b),
    algebra_sym(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(inverse(a), a), b: algebra_unit(<u: u, A: A>, m)>,
      algebra_inverse_left(<u: u, A: A, m: m, inverse: inverse>, g, a)
    )
  );
  let step2: AlgebraEq(
    u,
    A,
    algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), b),
    algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, b))
  ) := algebra_assoc(<u: u, A: A>, m, inverse(a), a, b);
  let step3: AlgebraEq(
    u,
    A,
    algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, b)),
    algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, c))
  ) := algebra_congr(<u: u, v: u, A: A, B: A, a: algebra_op(<u: u, A: A>, m)(a, b), b: algebra_op(<u: u, A: A>, m)(a, c)>,
    t => algebra_op(<u: u, A: A>, m)(inverse(a), t),
    h
  );
  let step4: AlgebraEq(
    u,
    A,
    algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, c)),
    algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), c)
  ) := algebra_sym(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), c), b: algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, c))>,
    algebra_assoc(<u: u, A: A>, m, inverse(a), a, c)
  );
  let step5: AlgebraEq(
    u,
    A,
    algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), c),
    algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), c)
  ) := algebra_congr(<u: u, v: u, A: A, B: A, a: algebra_op(<u: u, A: A>, m)(inverse(a), a), b: algebra_unit(<u: u, A: A>, m)>,
    t => algebra_op(<u: u, A: A>, m)(t, c),
    algebra_inverse_left(<u: u, A: A, m: m, inverse: inverse>, g, a)
  );
  let step6: AlgebraEq(
    u,
    A,
    algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), c),
    c
  ) := algebra_left_unit(<u: u, A: A>, m, c);
  algebra_trans(<u: u, A: A, a: b, b: algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), b), c: c>,
    step0,
    algebra_trans(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), b), b: algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), b), c: c>,
      step1,
      algebra_trans(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), b), b: algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, b)), c: c>,
        step2,
        algebra_trans(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, b)), b: algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, c)), c: c>,
          step3,
          algebra_trans(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(inverse(a), algebra_op(<u: u, A: A>, m)(a, c)), b: algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), c), c: c>,
            step4,
            algebra_trans(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(algebra_op(<u: u, A: A>, m)(inverse(a), a), c), b: algebra_op(<u: u, A: A>, m)(algebra_unit(<u: u, A: A>, m), c), c: c>,
              step5,
              step6
            )
          )
        )
      )
    )
  )
}

pub theorem algebra_inverse_unique<u: Level, A: Type(
  u
), m: AlgebraMonoid(
  u,
  A
), inverse: (
  A
) -> A>(
  g: AlgebraGroup(u, A, m, inverse),
  a: A,
  candidate: A,
  h: AlgebraEq(u, A, algebra_op(<u: u, A: A>, m)(a, candidate), algebra_unit(<u: u, A: A>, m))
): AlgebraEq(u, A, candidate, inverse(a)) {
  algebra_cancel_left(<u: u, A: A, m: m, inverse: inverse>,
    g,
    a,
    candidate,
    inverse(a),
    algebra_trans(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(a, candidate), b: algebra_unit(<u: u, A: A>, m), c: algebra_op(<u: u, A: A>, m)(a, inverse(a))>,
      h,
      algebra_sym(<u: u, A: A, a: algebra_op(<u: u, A: A>, m)(a, inverse(a)), b: algebra_unit(<u: u, A: A>, m)>,
        algebra_inverse_right(<u: u, A: A, m: m, inverse: inverse>, g, a)
      )
    )
  )
}
