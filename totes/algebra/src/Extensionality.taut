import "Hom.taut"
import "Equality.taut"
import "Monoid.taut"
import std::Quot

// This bridge is restricted to Type, as `funext` is.
pub theorem algebra_maps_equal<A: Type, B: Type, source: AlgebraMonoid(
  0,
  A
), target: AlgebraMonoid(
  0,
  B
)>(
  f: AlgebraHom(0, 0, A, B, source, target),
  g: AlgebraHom(0, 0, A, B, source, target),
  pointwise: ∀ x: A. AlgebraEq(
    0,
    B,
    algebra_map(<u: 0, v: 0, A: A, B: B, source: source, target: target>, f)(x),
    algebra_map(<u: 0, v: 0, A: A, B: B, source: source, target: target>, g)(x)
  )
): algebra_map(<u: 0, v: 0, A: A, B: B, source: source, target: target>, f) = algebra_map(<u: 0, v: 0, A: A, B: B, source: source, target: target>, g) {
  funext(<A: A, B: (x => B)>,
    algebra_map(<u: 0, v: 0, A: A, B: B, source: source, target: target>, f),
    algebra_map(<u: 0, v: 0, A: A, B: B, source: source, target: target>, g),
    x => algebra_to_eq(pointwise(x))
  )
}
