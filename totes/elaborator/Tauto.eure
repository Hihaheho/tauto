package {
  name = "elaborator"
  version = "0.1.0"
}
dependencies {
  kernel { path = "../kernel" }
  surface { path = "../surface" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}

// Declarations and inductive families are elaborated through the kernel's
// checking functions, whose unfolding makes this file slower than the default.
check {
  slow {
    "src/elaborate.taut" = 30
    "src/program.taut" = 90
  }
}
