package {
  name = "elaborator"
  version = "0.1.0"
  // The kernel's prelude files are read where the kernel reads them, not copied.
  include-from = ["../../crates/tauto-kernel/src", "../../std/builtin"]
}
dependencies {
  kernel { path = "../kernel" }
  surface { path = "../surface" }
  parse { path = "../parse" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}

// Declarations and inductive families are elaborated through the kernel's
// checking functions, whose unfolding makes this file slower than the default.
check {
  slow {
    "src/elaborate.taut" = 120
    "src/program.taut" = 300
    "src/nested.taut" = 60
    "src/mutual.taut" = 60
    "src/noconf.taut" = 60
    "src/prelude.taut" = 120
    "src/effects.taut" = 30
  }
}
