import "program.taut"
import "../../kernel/src/level.taut"
import "../../kernel/src/term.taut"
import "../../text/src/text.taut"
import std::Base
import std::Text

pub fn elab_words(xs: List(Text)): Text { text_join(xs, " ") }
pub fn elab_write_levels(xs: List(Pair(Text, Nat))): List(Text) {
  match xs: List(Text) {
    Nil => Nil
    Cons(p, rest) => Cons(p.fst, Cons(Text::of_nat(p.snd), elab_write_levels(rest)))
  }
}
pub fn elab_write_digits(xs: List(Nat)): List(Text) {
  match xs: List(Text) {
    Nil => Nil
    Cons(n, rest) => Cons(Text::of_nat(n), elab_write_digits(rest))
  }
}
pub fn elab_write_sort(s: KernelSort): Text {
  match s: Text {
    KernelProp => "P"
    KernelType(l) => elab_words(
      Cons(
        "T",
        Cons(
          Text::of_nat(l.constant),
          Cons(Text::of_nat(List::length(l.variables)), elab_write_levels(l.variables))
        )
      )
    )
  }
}
pub fn elab_write_term(t: KernelTerm): Text {
  match t: Text {
    KernelBVar(i) => Text::concat("b ", Text::of_nat(i))
    KernelFVar(i) => Text::concat("f ", Text::of_nat(i))
    KernelSortTerm(s) => Text::concat("s ", elab_write_sort(s))
    KernelConst(n) => Text::concat("c ", n)
    KernelPi(a, b) => elab_words(Cons("p", Cons(elab_write_term(a), Cons(elab_write_term(b), Nil))))
    KernelLam(b) => Text::concat("l ", elab_write_term(b))
    KernelApp(f, a) => elab_words(
      Cons("a", Cons(elab_write_term(f), Cons(elab_write_term(a), Nil)))
    )
    KernelLit(ds) => elab_words(
      Cons("n", Cons(Text::of_nat(List::length(ds)), elab_write_digits(ds)))
    )
    KernelBool(b) => if b { "z 1" } else { "z 0" }
  }
}
pub fn elab_transparent(t: Bool): Text { if t { "1" } else { "0" } }
pub fn elab_write_declarations(ds: List(ElabDeclaration)): Text {
  match ds: Text {
    Nil => ""
    Cons(d, rest) => Text::concat_all(
      Cons(
        elab_words(
          Cons(
            "D",
            Cons(
              d.name,
              Cons(
                elab_write_term(d.ty),
                Cons(
                  "1",
                  Cons(elab_write_term(d.value), Cons(elab_transparent(d.transparent), Nil))
                )
              )
            )
          )
        ),
        Cons(text_newline(), Cons(elab_write_declarations(rest), Nil))
      )
    )
  }
}
