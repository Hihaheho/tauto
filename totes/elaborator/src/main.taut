import "elaborate.taut"
import "program.taut"
import "write.taut"
import "../../kernel/src/data.taut"
import "../../surface/src/surface.taut"
import "../../syntax/src/syntax.taut"
import "../../text/src/text.taut"
import "../../unicode/src/classes.taut"
import std::Text
import std::prelude::Os
pub fn elab_source(k: Nat, source: Text): ElabResult(List(ElabItem)) {
  ⊢ ElabResult(List(ElabItem)) from match syntax_tables() {
    None => ElabErr("invalid syntax tables")
    Some(tables) => ⊢ ElabResult(List(ElabItem)) from match syntax_parse(tables, source) {
      None => ElabErr("cannot parse source")
      Some(Root) => if elab_unsupported(surface_size(Root) + 1, Cons(Root, Nil)) {
        ElabErr("attributes and generated declarations are unsupported")
      } else {
        let stmts := surface_program_of(
          SurfaceCtx {
            source: source,
            base: 0,
            classes: unicode_classes(),
            fuel: surface_size(Root) + 1
          },
          Root
        )
        var core := kernel_new()
        if elab_prelude(k, &mut core) { elab_program(stmts, k, &mut core) } else { ElabErr("cannot declare the library families") }
      }
    }
  }
}

// Each file is an independent source program. Successful output is the kernel
// wire format, suitable for replay by totes/kernel, not a host API result.
pub fn elab_main_files(paths: List(Text)): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      match read_file(path) {
        Err(message) => {
          eprint(Text::concat_all(Cons(path, Cons(": ", Cons(message, Cons(text_newline(), Nil))))))
          perform exit(1)
        }
        Ok(source) => match elab_source(2000, source) {
          ElabErr(message) => {
            eprint(
              Text::concat_all(Cons(path, Cons(": ", Cons(message, Cons(text_newline(), Nil)))))
            )
            perform exit(1)
          }
          ElabOk(ds) => print(elab_write_items(ds))
        }
      }
      elab_main_files(rest)
    }
  }
}
elab_main_files(perform argv())
