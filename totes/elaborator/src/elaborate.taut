import "../../surface/src/surface.taut"
import "../../kernel/src/kernel.taut"
import "../../kernel/src/check.taut"
import "../../kernel/src/data.taut"
import "../../kernel/src/level.taut"
import "../../kernel/src/term.taut"
import "../../text/src/text.taut"
import "nested.taut"
import "vary.taut"
import "../../identity/src/identity.taut"
import std::text
import std::map
import std::base

pub(open) inductive ElabResult(A: Type): Type {
  ElabOk(value: A): ElabResult(A)
  ElabErr(message: Text): ElabResult(A)
}

// A local name denotes a fresh kernel atom, or an already checked let value.
pub(open) inductive ElabBinding: Type {
  Mk(name: Text, value: KernelTerm, ty: KernelTerm): ElabBinding
}
pub(open) inductive ElabDeclaration: Type {
  Mk(name: Text, ty: KernelTerm, value: KernelTerm, transparent: Bool): ElabDeclaration
}
pub(open) inductive ElabTyped: Type {
  Mk(value: KernelTerm, ty: KernelTerm): ElabTyped
}

pub(open) inductive ElabInferChoice: Type {
  InferNoRule: ElabInferChoice
  InferChosen(solutions: Option(List(Nat × KernelTerm))): ElabInferChoice
  InferAmbiguous: ElabInferChoice
}

pub fn elab_lookup(env: List(ElabBinding), name: Text): Option(ElabTyped) {
  match env {
    Nil => None
    Cons(b, rest) => if b.name == name { Some(ElabTyped::Mk(b.value, b.ty)) } else {
      elab_lookup(rest, name)
    }
  }
}

pub fn elab_digits(k: Nat, n: Nat): List(Nat) {
  match k {
    Zero => Nil
    Succ(j) => if n == 0 { Nil } else {
      Cons(
        Nat::rem_nz(n, 65536, Nat::ne_zero(65536, Refl)),
        elab_digits(j, Nat::div_nz(n, 65536, Nat::ne_zero(65536, Refl)))
      )
    }
  }
}

pub fn elab_sort_number(name: Text): Option(Nat) {
  match Text::slice(name, 4, Text::len(name)) {
    None => None
    Some(suffix) => text_parse_u64(suffix)
  }
}

// Whether a borrowing λ's parameters include a `&mut` one: the kernel reads
// a shared borrow as the value it borrows, and a mutable one not at all.
pub fn elab_borrows_mutable(bs: List(Option(Bool))): Bool {
  match bs {
    Nil => false
    Cons(b, rest) => ⊢ Bool from match b {
      Some(m) => m || elab_borrows_mutable(rest)
      None => elab_borrows_mutable(rest)
    }
  }
}

pub fn elab_sort(name: Text): Option(KernelTerm) {
  if name == "Prop" { Some(KernelSortTerm(KernelProp)) } else if name == "Type" {
    Some(KernelSortTerm(KernelType(KernelLevel::Mk(0, Nil))))
  } else if text_starts_with(name, "Type", 0) {
    ⊢ Option(KernelTerm) from match elab_sort_number(name) {
      None => None
      Some(n) => if n <= 1000 { Some(KernelSortTerm(KernelType(KernelLevel::Mk(n, Nil)))) } else {
        None
      }
    }
  } else { None }
}

pub fn elab_dbg_infer(k: Nat, core: &mut KernelCore, v: KernelTerm): Text {
  match kernel_infer(k, &mut core, v) {
    None => "?"
    Some(t) => elab_dbg(t)
  }
}

pub fn elab_dbg(t: KernelTerm): Text {
  match t {
    KernelBVar(i) => Text::concat("b", Text::of_nat(i))
    KernelFVar(i) => Text::concat("f", Text::of_nat(i))
    KernelSortTerm(^s) => "S"
    KernelConst(n) => n
    KernelPi(a, b, ^d) => Text::concat("(Pi ", Text::concat(elab_dbg(a), Text::concat(" . ", Text::concat(elab_dbg(b), ")"))))
    KernelLam(b, ^d) => Text::concat("(\\ ", Text::concat(elab_dbg(b), ")"))
    KernelApp(f, a, ^d) => Text::concat("(", Text::concat(elab_dbg(f), Text::concat(" ", Text::concat(elab_dbg(a), ")"))))
    KernelLit(n) => Text::of_nat(n)
  }
}

pub fn elab_result(
  k: Nat,
  core: &mut KernelCore,
  value: KernelTerm,
  expected: Option(KernelTerm)
): ElabResult(ElabTyped) {
  match expected {
    Some(ty) => if kernel_check(
      k,
      &mut core,
      value,
      ty
    ) { ElabOk(ElabTyped::Mk(value, ty)) } else { ElabErr(Text::concat("type mismatch: expected ", Text::concat(elab_dbg(ty), Text::concat(" got ", elab_dbg_infer(k, &mut core, value))))) }
    None => ⊢ ElabResult(ElabTyped) from match kernel_infer(k, &mut core, value) {
      None => ElabErr("cannot infer type")
      Some(ty) => ElabOk(ElabTyped::Mk(value, ty))
    }
  }
}

// Retain the bidirectional type of annotated lambdas and checked let values.
// The independent kernel rechecks both that type and any outer expectation.
pub fn elab_known(
  k: Nat,
  core: &mut KernelCore,
  typed: ElabTyped,
  expected: Option(KernelTerm)
): ElabResult(ElabTyped) {
  if kernel_check(k, &mut core, typed.value, typed.ty) {
    ⊢ ElabResult(ElabTyped) from match expected {
      None => ElabOk(typed)
      Some(ty) => elab_result(k, &mut core, typed.value, Some(ty))
    }
  } else { ElabErr("invalid elaborated value") }
}

// The declaration being elaborated is a binding named `#self`, which no
// source name can spell: its value names the declaration and its type the
// number of its parameters. The parameters are the bindings made just after it.
pub fn elab_self(env: List(ElabBinding)): Option(Text × Nat) {
  match env {
    Nil => None
    Cons(b, rest) => if b.name == "#self" {
      ⊢ Option(Text × Nat) from match b.value {
        KernelConst(name) => ⊢ Option(Text × Nat) from match b.ty {
          KernelLit(n) => Some(#(name, n))
          _ => None
        }
        _ => None
      }
    } else { elab_self(rest) }
  }
}

pub fn elab_before_self(env: List(ElabBinding)): List(ElabBinding) {
  match env {
    Nil => Nil
    Cons(b, rest) => if b.name == "#self" { Nil } else { Cons(b, elab_before_self(rest)) }
  }
}

pub fn elab_atom_ids(bs: List(ElabBinding)): Option(List(Nat)) {
  match bs {
    Nil => Some(Nil)
    Cons(b, rest) => ⊢ Option(List(Nat)) from match b.value {
      KernelFVar(x) => ⊢ Option(List(Nat)) from match elab_atom_ids(rest) {
        None => None
        Some(xs) => Some(Cons(x, xs))
      }
      _ => None
    }
  }
}

// The atoms of the declaration's parameters, in order.
pub fn elab_self_params(env: List(ElabBinding), n: Nat): Option(List(Nat)) {
  elab_atom_ids(elab_take(elab_rev(elab_before_self(env), Nil), n))
}

pub fn elab_rev(bs: List(ElabBinding), acc: List(ElabBinding)): List(ElabBinding) {
  match bs {
    Nil => acc
    Cons(b, rest) => elab_rev(rest, Cons(b, acc))
  }
}

pub fn elab_take(bs: List(ElabBinding), n: Nat): List(ElabBinding) {
  match n {
    Zero => Nil
    Succ(m) => ⊢ List(ElabBinding) from match bs {
      Nil => Nil
      Cons(b, rest) => Cons(b, elab_take(rest, m))
    }
  }
}

pub fn elab_take_nat(xs: List(Nat), n: Nat): List(Nat) {
  match n {
    Zero => Nil
    Succ(m) => ⊢ List(Nat) from match xs {
      Nil => Nil
      Cons(x, rest) => Cons(x, elab_take_nat(rest, m))
    }
  }
}

// A recursive call leaves the implicit parameters out: they are the
// declaration's own, unchanged.
pub fn elab_self_implicits(env: List(ElabBinding), name: Text): List(Nat) {
  match elab_self(env) {
    None => Nil
    Some(me) => ⊢ List(Nat) from match elab_lookup(env, Text::concat("#implicit ", name)) {
      None => Nil
      Some(b) => ⊢ List(Nat) from match b.value {
        KernelLit(n) => ⊢ List(Nat) from match elab_self_params(env, me.snd) {
          None => Nil
          Some(ids) => elab_take_nat(ids, n)
        }
        _ => Nil
      }
    }
  }
}

pub fn elab_position(xs: List(Nat), x: Nat, at: Nat): Option(Nat) {
  match xs {
    Nil => None
    Cons(y, rest) => if y == x { Some(at) } else { elab_position(rest, x, at + 1) }
  }
}

pub fn elab_ids_text(xs: List(Nat)): Text {
  match xs {
    Nil => ""
    Cons(x, rest) => Text::concat_all(Cons(" ", Cons(Text::of_nat(x), Cons(elab_ids_text(rest), Nil))))
  }
}

// The name of the binding that stands for the recursive call with these
// argument atoms: the induction hypothesis of a smaller field.
pub fn elab_rec_key(name: Text, ids: List(Nat)): Text {
  Text::concat_all(Cons("#rec ", Cons(name, Cons(elab_ids_text(ids), Nil))))
}

pub fn elab_set_nat(xs: List(Nat), at: Nat, x: Nat): List(Nat) {
  match xs {
    Nil => Nil
    Cons(y, rest) => ⊢ List(Nat) from match at {
      Zero => Cons(x, rest)
      Succ(i) => Cons(y, elab_set_nat(rest, i, x))
    }
  }
}

pub fn elab_spine(k: Nat, t: KernelTerm, args: List(KernelTerm)): KernelTerm × List(KernelTerm) {
  ⊢ (KernelTerm × List(KernelTerm)) from match k {
    Zero => #(t, args)
    Succ(j) => ⊢ (KernelTerm × List(KernelTerm)) from match t {
      KernelApp(f, a, ^d) => elab_spine(j, f, Cons(a, args))
      _ => #(t, args)
    }
  }
}

pub fn elab_apps(head: KernelTerm, args: List(KernelTerm)): KernelTerm {
  match args {
    Nil => head
    Cons(a, rest) => elab_apps(kernel_app(head, a), rest)
  }
}

pub fn elab_fvars(xs: List(Nat)): List(KernelTerm) {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(KernelFVar(x), elab_fvars(rest))
  }
}

pub fn elab_lams(t: KernelTerm, atoms: List(Nat)): KernelTerm {
  match atoms {
    Nil => t
    Cons(a, rest) => kernel_lam(kernel_abstract_at(elab_lams(t, rest), 0, a))
  }
}

// The parameters a constructor of `family` is applied to: those the family
// is applied to, or for a nested member the arguments of the type it stands for.
pub fn elab_ctor_params(core: KernelCore, family: Text, params: List(KernelTerm)): List(KernelTerm) {
  match kernel_ind_get(core, family) {
    None => params
    Some(info) => match info.alias {
      Some(al) => al.snd
      None => params
    }
  }
}

// The part of `name` after its last `::`.
pub fn elab_after_last(k: Nat, name: Text, at: Nat, cut: Nat): Text {
  match k {
    Zero => Text::slice_or_empty(name, cut, Text::len(name))
    Succ(j) => ⊢ Text from match text_find(name, "::", at) {
      None => Text::slice_or_empty(name, cut, Text::len(name))
      Some(p) => elab_after_last(j, name, p + 2, p + 2)
    }
  }
}

pub fn elab_short_name(name: Text, family: Text): Text {
  let prefix := Text::concat(family, "::")
  // A nested member has the constructors of the type it stands for.
  if text_find(family, "::nested", 0) != None {
    elab_after_last(Text::len(name) + 1, name, 0, 0)
  } else if text_starts_with(name, prefix, 0) {
    ⊢ Text from match Text::slice(name, Text::len(prefix), Text::len(name)) {
      Some(t) => t
      None => name
    }
  } else { name }
}

// The arm whose pattern is the constructor, by its short or qualified name.
pub fn elab_arm_of(
  arms: List(SurfaceArm),
  ctors: List(KernelCtorInfo),
  ctor: Text,
  family: Text
): Option(SurfaceArm × List(SurfacePattern)) {
  match arms {
    Nil => None
    Cons(a, rest) => ⊢ Option((SurfaceArm × List(SurfacePattern))) from match elab_ctor_pattern(a.pattern, ctors, family) {
      Some(p) => if p.fst == ctor || p.fst == elab_short_name(ctor, family) || p.fst == Text::concat_all(Cons(family, Cons("::", Cons(ctor, Nil)))) { Some(#(a, p.snd)) } else {
        elab_arm_of(rest, ctors, ctor, family)
      }
      None => elab_arm_of(rest, ctors, ctor, family)
    }
  }
}

pub fn elab_arms_known(arms: List(SurfaceArm), ctors: List(KernelCtorInfo), family: Text): Bool {
  match arms {
    Nil => true
    Cons(a, rest) => ⊢ Bool from match elab_ctor_pattern(a.pattern, ctors, family) {
      Some(p) => if elab_unguarded(a.guard) && elab_ctor_named(ctors, p.fst, family) {
        elab_arms_known(rest, ctors, family)
      } else { false }
      None => false
    }
  }
}

// A constructor pattern as its name and fields. A bare name that names a
// constructor of the matched family is that constructor with no fields.
pub fn elab_ctor_pattern(p: SurfacePattern, ctors: List(KernelCtorInfo), family: Text): Option(Text × List(SurfacePattern)) {
  match p {
    PtCtor(name, args) => Some(#(elab_unprelude(surface_name_text(name)), args))
    PtBind(name, _) => if elab_ctor_named(ctors, name, family) { Some(#(name, Nil)) } else { None }
    _ => None
  }
}

pub fn elab_unguarded(g: Option(SurfaceTerm)): Bool {
  match g {
    None => true
    Some(^t) => false
  }
}

pub fn elab_ctor_named(ctors: List(KernelCtorInfo), name: Text, family: Text): Bool {
  match ctors {
    Nil => false
    Cons(c, rest) => c.name == name || elab_short_name(c.name, family) == name || elab_ctor_named(rest, name, family)
  }
}

pub fn elab_bound_names(ps: List(SurfacePattern)): Option(List(Option(Text))) {
  match ps {
    Nil => Some(Nil)
    Cons(p, rest) => ⊢ Option(List(Option(Text))) from match elab_bound_names(rest) {
      None => None
      Some(ns) => ⊢ Option(List(Option(Text))) from match p {
        PtBind(n, _) => Some(Cons(Some(n), ns))
        PtWild => Some(Cons(None, ns))
        _ => None
      }
    }
  }
}

// Whether argument `i` of a constructor is a plain recursive field.
pub fn elab_is_recursive(recs: List(KernelRecArg), i: Nat): Bool {
  match recs {
    Nil => false
    Cons(r, rest) => (r.arg == i && r.ys == 0) || elab_is_recursive(rest, i)
  }
}

pub fn elab_instantiate(k: Nat, t: KernelTerm, args: List(KernelTerm)): Option(KernelTerm) {
  match args {
    Nil => Some(t)
    Cons(a, rest) => ⊢ Option(KernelTerm) from match kernel_as_pi(t) {
      None => None
      Some(p) => elab_instantiate(k, kernel_inst(p.snd, a), rest)
    }
  }
}


pub fn elab_arg_atoms(env: List(ElabBinding), args: List(SurfaceTerm)): Option(List(Nat)) {
  match args {
    Nil => Some(Nil)
    Cons(a, rest) => ⊢ Option(List(Nat)) from match a.kind {
      SkVar(x) => ⊢ Option(List(Nat)) from match elab_lookup(env, surface_name_text(x)) {
        Some(t) => ⊢ Option(List(Nat)) from match t.value {
          KernelFVar(id) => ⊢ Option(List(Nat)) from match elab_arg_atoms(env, rest) {
            None => None
            Some(ids) => Some(Cons(id, ids))
          }
          _ => None
        }
        None => None
      }
      _ => None
    }
  }
}

// The atoms of a recursive call whose one argument applies a variable to
// arguments (`f(y)`, `f` a function-typed field): that variable's atom in its
// place, and the arguments it is applied to. `None` when another argument is
// not a variable, or two are applied.
pub fn elab_fun_arg_atoms(env: List(ElabBinding), args: List(SurfaceTerm)): Option((List(Nat) × List(SurfaceTerm))) {
  match args {
    Nil => None
    Cons(a, rest) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match a.kind {
      SkVar(x) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match elab_lookup(env, surface_name_text(x)) {
        Some(t) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match t.value {
          KernelFVar(id) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match elab_fun_arg_atoms(env, rest) {
            None => None
            Some(r) => Some(#(Cons(id, r.fst), r.snd))
          }
          _ => None
        }
        None => None
      }
      SkApp(h, ys) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match h.kind {
        SkVar(x) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match elab_lookup(env, surface_name_text(x)) {
          Some(t) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match t.value {
            KernelFVar(id) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match elab_arg_atoms(env, rest) {
              None => None
              Some(ids) => Some(#(Cons(id, ids), ys))
            }
            _ => None
          }
          None => None
        }
        _ => None
      }
      _ => None
    }
  }
}

// The number of implicit leading parameters of a global: as declared, or the
// family parameters of a constructor.
pub fn elab_implicit_count(env: List(ElabBinding), core: KernelCore, name: Text): Nat {
  match elab_lookup(env, Text::concat("#implicit ", name)) {
    Some(b) => ⊢ Nat from match b.value {
      KernelLit(n) => n
      _ => 0
    }
    None => ⊢ Nat from match kernel_ctor_get(core, name) {
      Some(c) => ⊢ Nat from match kernel_ind_get(core, c.fst) {
        Some(info) => info.params
        None => 0
      }
      None => elab_recursor_params(core, name)
    }
  }
}

// The class a record family belongs to: `C` of `C::laws`, else the name itself.
pub fn elab_class_of_name(n: Text): Text {
  let len := Text::len(n)
  if len > 6 && Text::slice_or_empty(n, Nat::sub(len, 6), len) == "::laws" { Text::slice_or_empty(n, 0, Nat::sub(len, 6)) } else { n }
}

// The last `::` of a name, as the start of the member after it.
pub fn elab_last_sep_from(name: Text, at: Nat, found: Option(Nat)): Option(Nat) {
  elab_last_sep_in(Text::len(name), name, at, found)
}

pub fn elab_last_sep_in(k: Nat, name: Text, at: Nat, found: Option(Nat)): Option(Nat) {
  match k {
    Zero => found
    Succ(j) => ⊢ Option(Nat) from match text_find(name, "::", at) {
      None => found
      Some(p) => if p + 2 >= Text::len(name) { found } else { elab_last_sep_in(j, name, p + 2, Some(p + 2)) }
    }
  }
}

// The class a method or law belongs to, how many parameters the class has, and
// whether the member is a law: `Ord::compare` is a method of `Ord`.
pub fn elab_member_of(env: List(ElabBinding), name: Text): Option(((Text × Nat) × (Text × Bool))) {
  ⊢ Option(((Text × Nat) × (Text × Bool))) from match elab_last_sep_from(name, 0, None) {
    None => None
    Some(at) => {
      let cls := Text::slice_or_empty(name, 0, Nat::sub(at, 2))
      let member := Text::slice_or_empty(name, at, Text::len(name))
      ⊢ Option(((Text × Nat) × (Text × Bool))) from match elab_lookup(env, Text::concat("#class ", cls)) {
        None => None
        Some(b) => ⊢ Option(((Text × Nat) × (Text × Bool))) from match b.value {
          KernelLit(n) => ⊢ Option(((Text × Nat) × (Text × Bool))) from match b.ty {
            KernelConst(enc) => ⊢ Option(((Text × Nat) × (Text × Bool))) from match text_split(enc, "|") {
              Cons(ms, Cons(ls, Cons(^parameters, Cons(^flags, Nil)))) => if elab_text_member(text_split(ms, ","), member) { Some(#(#(cls, n), #(member, false))) } else {
                if elab_text_member(text_split(ls, ","), member) { Some(#(#(cls, n), #(member, true))) } else { None }
              }
              _ => None
            }
            _ => None
          }
          _ => None
        }
      }
    }
  }
}

// The call of a method or a law whose record is an instance's, as the host
// writes it: the instance's own function for the member, `C::m@H`, applied to
// what the instance is applied to (`C::m(inst@H(…), a)` is `C::m@H(…, a)`).
pub fn elab_direct_member(k: Nat, env: List(ElabBinding), name: Text, vs: List(KernelTerm), done: List(KernelTerm)): Option(KernelTerm) {
  ⊢ Option(KernelTerm) from match elab_member_of(env, name) {
    None => None
    Some(m) => {
      let cls := m.fst.fst
      let n := m.fst.snd
      let total := List::length(vs)
      if m.snd.snd == false {
        // A method: the record is the last of the class's parameters and the method's own.
        if total != n + 1 { None } else {
          ⊢ Option(KernelTerm) from match elab_last_kernel(vs) {
            None => None
            Some(dict) => elab_direct_call(k, Text::concat(cls, "::inst@"), cls, m.snd.fst, dict, Nil, done)
          }
        }
      } else {
        // A law: after the class's parameters and the law's own come the record of the methods and of the laws.
        if total < n + 2 { None } else {
          ⊢ Option(KernelTerm) from match elab_last_kernel(vs) {
            None => None
            Some(laws) => elab_direct_call(k, Text::concat(cls, "::laws@"), cls, m.snd.fst, laws, elab_drop_terms(elab_take_terms(vs, Nat::sub(total, 2)), n), done)
          }
        }
      }
    }
  }
}

// A call of `C::m` that reads as the instance's own function `C::m@H`, which is the one being defined.
pub fn elab_own_call(k: Nat, env: List(ElabBinding), name: Text, value: KernelTerm): Option(Text) {
  ⊢ Option(Text) from match elab_self(env) {
    None => None
    Some(me) => ⊢ Option(Text) from match elab_spine(k, value, Nil).fst {
      KernelConst(g) => if g == me.fst && g != name && text_starts_with(g, Text::concat(name, "@"), 0) { Some(g) } else { None }
      _ => None
    }
  }
}

pub fn elab_unborrow_all(args: List(SurfaceTerm)): List(SurfaceTerm) {
  match args {
    Nil => Nil
    Cons(a, rest) => Cons(
      ⊢ SurfaceTerm from match a.kind {
        SkBorrow(mutable, ^mutable_orig, v) => if mutable { a } else { v }
        _ => a
      },
      elab_unborrow_all(rest)
    )
  }
}

pub fn elab_zip_fields(names: List(Text), args: List(SurfaceTerm)): List(SurfaceField) {
  match names {
    Nil => Nil
    Cons(n, more) => ⊢ List(SurfaceField) from match args {
      Nil => Nil
      Cons(a, rest) => Cons(SurfaceFieldMk(n, a), elab_zip_fields(more, rest))
    }
  }
}

// A law called inside its instance writes the generics of its own first
// (`Ord::equal_iff(xs, ys)`): they are the named implicit arguments of the call.
pub fn elab_law_args(env: List(ElabBinding), core: KernelCore, name: Text, args: List(SurfaceTerm)): List(SurfaceTerm) {
  ⊢ List(SurfaceTerm) from match elab_self(env) {
    None => args
    Some(me) => if text_starts_with(me.fst, Text::concat(name, "@"), 0) && elab_has_named(args) == false {
      ⊢ List(SurfaceTerm) from match elab_member_of(env, name) {
        Some(m) => if m.snd.snd {
          let own := Nat::sub(Nat::sub(elab_implicit_count(env, core, name), m.fst.snd), 2)
          if own == 0 || List::length(args) < own { args } else {
            let names := elab_drop_texts(elab_implicit_names(env, name), m.fst.snd)
            Cons(surface_term_mk(SkRecord("@implicits", elab_zip_fields(names, elab_take_terms_s(args, own))), 0, 0), elab_drop_terms_s(args, own))
          }
        } else { args }
        None => args
      }
    } else { args }
  }
}

pub fn elab_drop_texts(xs: List(Text), n: Nat): List(Text) {
  match n {
    Zero => xs
    Succ(m) => ⊢ List(Text) from match xs {
      Nil => Nil
      Cons(^x, rest) => elab_drop_texts(rest, m)
    }
  }
}

pub fn elab_take_terms_s(xs: List(SurfaceTerm), n: Nat): List(SurfaceTerm) {
  match n {
    Zero => Nil
    Succ(m) => ⊢ List(SurfaceTerm) from match xs {
      Nil => Nil
      Cons(x, rest) => Cons(x, elab_take_terms_s(rest, m))
    }
  }
}

pub fn elab_drop_terms_s(xs: List(SurfaceTerm), n: Nat): List(SurfaceTerm) {
  match n {
    Zero => xs
    Succ(m) => ⊢ List(SurfaceTerm) from match xs {
      Nil => Nil
      Cons(^x, rest) => elab_drop_terms_s(rest, m)
    }
  }
}

pub fn elab_last_kernel(xs: List(KernelTerm)): Option(KernelTerm) {
  match xs {
    Nil => None
    Cons(x, rest) => ⊢ Option(KernelTerm) from match rest {
      Nil => Some(x)
      _ => elab_last_kernel(rest)
    }
  }
}

pub fn elab_direct_call(k: Nat, prefix: Text, cls: Text, member: Text, dict: KernelTerm, own: List(KernelTerm), done: List(KernelTerm)): Option(KernelTerm) {
  let spine := elab_spine(k, dict, Nil)
  ⊢ Option(KernelTerm) from match spine.fst {
    KernelConst(g) => if text_starts_with(g, prefix, 0) {
      ⊢ Option(KernelTerm) from match Text::slice(g, Text::len(prefix), Text::len(g)) {
        None => None
        Some(head) => Some(elab_apps(KernelConst(Text::concat_all([cls, "::", member, "@", head])), List::append(spine.snd, List::append(own, done))))
      }
    } else { None }
    _ => None
  }
}

// Whether `n` is the record of the laws of a class: `C::laws`.
pub fn elab_is_laws_name(env: List(ElabBinding), n: Text): Bool {
  let len := Text::len(n)
  if len <= 6 { false } else {
    ⊢ Bool from match Text::slice(n, Nat::sub(len, 6), len) {
      None => false
      Some(tail) => tail == "::laws" && (⊢ Bool from match elab_lookup(env, Text::concat("#class ", elab_class_of_name(n))) {
        Some(^c) => true
        None => false
      })
    }
  }
}

// Whether `goal` is the type of a class's record: `C(…)` or `C::laws(…)`.
pub fn elab_is_dict_type(k: Nat, env: List(ElabBinding), goal: KernelTerm): Bool {
  ⊢ Bool from match elab_spine(k, goal, Nil).fst {
    KernelConst(n) => ⊢ Bool from match elab_lookup(env, Text::concat("#class ", n)) {
      Some(^c) => true
      None => elab_is_laws_name(env, n)
    }
    _ => false
  }
}


// A record parameter in scope whose type is `goal`.
pub fn elab_local_dict(k: Nat, core: &mut KernelCore, env: List(ElabBinding), left: List(ElabBinding), goal: KernelTerm): Option(KernelTerm) {
  match left {
    Nil => None
    Cons(b, rest) => if text_starts_with(b.name, "inst@", 0) && kernel_conv(k, &mut core, b.ty, goal) { Some(b.value) } else {
      elab_local_dict(k, &mut core, env, rest, goal)
    }
  }
}


// A recursor `F::ind` or `F::rec` takes the parameters of `F` implicitly, as
// its constructors do.
pub fn elab_recursor_family(name: Text): Option(Text) {
  let n := Text::len(name)
  if n <= 5 { None } else {
    ⊢ Option(Text) from match Text::slice(name, Nat::sub(n, 5), n) {
      None => None
      Some(tail) => if tail == "::ind" || tail == "::rec" { Text::slice(name, 0, Nat::sub(n, 5)) } else { None }
    }
  }
}

pub fn elab_recursor_params(core: KernelCore, name: Text): Nat {
  match elab_recursor_family(name) {
    None => 0
    Some(f) => ⊢ Nat from match kernel_ind_get(core, f) {
      Some(info) => ⊢ Nat from match kernel_global_get(core, name) {
        None => 0
        Some(^g) => info.params
      }
      None => 0
    }
  }
}

pub fn elab_wants_implicit(env: List(ElabBinding), core: KernelCore, name: Text): Bool {
  match elab_lookup(env, name) {
    Some(^local) => false
    None => elab_implicit_count(env, core, name) != 0
  }
}

// Whether `t` has no loose bound variable under `depth` binders.
pub fn elab_closed(t: KernelTerm, depth: Nat): Bool {
  match t {
    KernelBVar(i) => i < depth
    KernelPi(a, b, ^d) => elab_closed(a, depth) && elab_closed(b, Succ(depth))
    KernelLam(b, ^d) => elab_closed(b, Succ(depth))
    KernelApp(f, a, ^d) => elab_closed(f, depth) && elab_closed(a, depth)
    _ => true
  }
}

pub fn elab_occurs(t: KernelTerm, x: Nat): Bool {
  match t {
    KernelFVar(y) => x == y
    KernelPi(a, b, ^d) => elab_occurs(a, x) || elab_occurs(b, x)
    KernelLam(b, ^d) => elab_occurs(b, x)
    KernelApp(f, a, ^d) => elab_occurs(f, x) || elab_occurs(a, x)
    _ => false
  }
}

// Whether the term `e` occurs in `t`: a match whose arms write their goals
// generalizes `e` where the result or an assumption shows it.
pub fn elab_term_occurs(t: KernelTerm, e: KernelTerm): Bool {
  if kernel_term_eq(t, e) { true } else {
    match t {
      KernelPi(a, b, ^d) => elab_term_occurs(a, e) || elab_term_occurs(b, e)
      KernelLam(b, ^d) => elab_term_occurs(b, e)
      KernelApp(f, a, ^d) => elab_term_occurs(f, e) || elab_term_occurs(a, e)
      _ => false
    }
  }
}

pub fn elab_env_occurs(env: List(ElabBinding), e: KernelTerm): Bool {
  match env {
    Nil => false
    Cons(b, rest) => elab_term_occurs(b.ty, e) || elab_env_occurs(rest, e)
  }
}

// Each implicit argument written by name is the variable of the
// declaration's own implicit parameter of that name.
pub fn elab_named_are_own(names: List(Text), own: List(Nat), fields: List(SurfaceField), env: List(ElabBinding)): Bool {
  match fields {
    Nil => true
    Cons(f, rest) => ⊢ Bool from match elab_own_nth(own, elab_text_index(names, f.name, 0)) {
      None => false
      Some(id) => ⊢ Bool from match elab_arg_atoms(env, Cons(f.value, Nil)) {
        Some(Cons(a, Nil)) => a == id && elab_named_are_own(names, own, rest, env)
        _ => false
      }
    }
  }
}

pub fn elab_text_index(names: List(Text), n: Text, i: Nat): Nat {
  match names {
    Nil => i
    Cons(m, rest) => if m == n { i } else { elab_text_index(rest, n, Succ(i)) }
  }
}

pub fn elab_own_nth(xs: List(Nat), i: Nat): Option(Nat) {
  match xs {
    Nil => None
    Cons(x, rest) => ⊢ Option(Nat) from match i {
      Zero => Some(x)
      Succ(m) => elab_own_nth(rest, m)
    }
  }
}

// The solutions beyond `known` that do not mention the atom `hole`.
pub fn elab_drop_mentioning(sols: List(Nat × KernelTerm), hole: Nat, known: List(Nat × KernelTerm)): List(Nat × KernelTerm) {
  match sols {
    Nil => Nil
    Cons(s, rest) => ⊢ List(Nat × KernelTerm) from match elab_solution(known, s.fst) {
      Some(^v) => Cons(s, elab_drop_mentioning(rest, hole, known))
      None => if elab_occurs(s.snd, hole) { elab_drop_mentioning(rest, hole, known) } else { Cons(s, elab_drop_mentioning(rest, hole, known)) }
    }
  }
}

pub fn elab_solution(sols: List(Nat × KernelTerm), x: Nat): Option(KernelTerm) {
  match sols {
    Nil => None
    Cons(s, rest) => if s.fst == x { Some(s.snd) } else { elab_solution(rest, x) }
  }
}

pub fn elab_subst(t: KernelTerm, sols: List(Nat × KernelTerm)): KernelTerm {
  match sols {
    Nil => t
    Cons(s, rest) => elab_subst(kernel_inst(kernel_abstract_at(t, 0, s.fst), s.snd), rest)
  }
}

pub fn elab_any_occurs(t: KernelTerm, xs: List(Nat)): Bool {
  match xs {
    Nil => false
    Cons(x, rest) => elab_occurs(t, x) || elab_any_occurs(t, rest)
  }
}

pub fn elab_unsolved(holes: List(Nat), sols: List(Nat × KernelTerm)): List(Nat) {
  match holes {
    Nil => Nil
    Cons(h, rest) => ⊢ List(Nat) from match elab_solution(sols, h) {
      None => Cons(h, elab_unsolved(rest, sols))
      Some(^v) => elab_unsolved(rest, sols)
    }
  }
}

pub fn elab_solutions_of(holes: List(Nat), sols: List(Nat × KernelTerm)): Option(List(KernelTerm)) {
  match holes {
    Nil => Some(Nil)
    Cons(h, rest) => ⊢ Option(List(KernelTerm)) from match elab_solution(sols, h) {
      None => None
      Some(v) => ⊢ Option(List(KernelTerm)) from match elab_solutions_of(rest, sols) {
        None => None
        Some(vs) => Some(Cons(v, vs))
      }
    }
  }
}

pub fn elab_sort_eq(a: KernelSort, b: KernelSort): Bool {
  kernel_term_eq(KernelSortTerm(a), KernelSortTerm(b))
}

// Both are applications of the same constant to the same number of arguments.
pub fn elab_same_head(k: Nat, p: KernelTerm, a: KernelTerm): Bool {
  let sp := elab_spine(k, p, Nil)
  let sa := elab_spine(k, a, Nil)
  ⊢ Bool from match sp.fst {
    KernelConst(n) => ⊢ Bool from match sa.fst {
      KernelConst(m) => n == m && List::length(sp.snd) == List::length(sa.snd)
      _ => false
    }
    _ => false
  }
}

// First-order matching of `p`, whose unsolved holes are atoms of `holes`,
// against the hole-free `a`. A hole is solved by a closed part of `a`. A
// mismatch outside holes is left to the kernel, which checks the result.
pub fn elab_unify(
  k: Nat,
  core: &mut KernelCore,
  holes: List(Nat),
  p: KernelTerm,
  a: KernelTerm,
  sols: List(Nat × KernelTerm)
): Option(List(Nat × KernelTerm)) {
  match k {
    Zero => None
    Succ(j) => {
      let q := elab_subst(p, sols)
      if elab_any_occurs(q, elab_unsolved(holes, sols)) {
        ⊢ Option(List(Nat × KernelTerm)) from match q {
          KernelFVar(h) => if elab_closed(a, 0) { Some(Cons(#(h, a), sols)) } else { None }
          KernelPi(qa, qb, ^qd) => ⊢ Option(List(Nat × KernelTerm)) from match kernel_whnf(j, &mut core, a, true, false) {
            KernelPi(aa, ab, ^ad) => ⊢ Option(List(Nat × KernelTerm)) from match elab_unify(j, &mut core, holes, qa, aa, sols) {
              None => None
              Some(s1) => elab_unify(j, &mut core, holes, qb, ab, s1)
            }
            _ => None
          }
          // An application whose head is the other's is matched as written
          // (`List::append(?xs, ?ys)` against `List::append(xs, ys)`): its
          // unfolding has the arguments of a recursor, not these.
          KernelApp(qf, qx, ^qd) => if elab_same_head(j, q, a) { ⊢ Option(List(Nat × KernelTerm)) from match a {
            KernelApp(af, ax, ^ad) => ⊢ Option(List(Nat × KernelTerm)) from match elab_unify(j, &mut core, holes, qf, af, sols) {
              None => None
              Some(s1) => elab_unify(j, &mut core, holes, qx, ax, s1)
            }
            _ => None
          } } else { ⊢ Option(List(Nat × KernelTerm)) from match kernel_whnf(j, &mut core, a, true, true) {
            KernelApp(af, ax, ^ad) => ⊢ Option(List(Nat × KernelTerm)) from match elab_unify(j, &mut core, holes, qf, af, sols) {
              None => None
              Some(s1) => elab_unify(j, &mut core, holes, qx, ax, s1)
            }
            _ => None
          } }
          KernelLam(qb, ^qd) => ⊢ Option(List(Nat × KernelTerm)) from match a {
            KernelLam(ab, ^ad) => elab_unify(j, &mut core, holes, qb, ab, sols)
            _ => None
          }
          _ => None
        }
      } else { Some(sols) }
    }
  }
}

// The type left after `n` explicit arguments, if it does not depend on them.
pub fn elab_result_after(k: Nat, core: &mut KernelCore, ty: KernelTerm, n: Nat): Option(KernelTerm) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(KernelTerm) from match n {
      Zero => Some(ty)
      Succ(m) => ⊢ Option(KernelTerm) from match kernel_as_pi(kernel_whnf(j, &mut core, ty, true, false)) {
        None => None
        Some(p) => {
          let x := kernel_fresh(&mut core, p.fst)
          ⊢ Option(KernelTerm) from match elab_result_after(j, &mut core, kernel_inst(p.snd, KernelFVar(x)), m) {
            None => None
            Some(r) => if elab_occurs(r, x) { None } else { Some(r) }
          }
        }
      }
    }
  }
}

pub fn elab_holes(k: Nat, core: &mut KernelCore, ty: KernelTerm, n: Nat): Option(List(Nat) × KernelTerm) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(List(Nat) × KernelTerm) from match n {
      Zero => Some(#(Nil, ty))
      Succ(m) => ⊢ Option(List(Nat) × KernelTerm) from match kernel_as_pi(kernel_whnf(j, &mut core, ty, true, false)) {
        None => None
        Some(p) => {
          let h := kernel_fresh(&mut core, p.fst)
          ⊢ Option(List(Nat) × KernelTerm) from match elab_holes(j, &mut core, kernel_inst(p.snd, KernelFVar(h)), m) {
            None => None
            Some(r) => Some(#(Cons(h, r.fst), r.snd))
          }
        }
      }
    }
  }
}


// The recursion of a match on a parameter of the declaration: its name, the
// atoms of its parameters, the place of the matched one, and the atoms of the
// matched value's indices.
pub(open) inductive ElabRecursion: Type {
  Mk(name: Text, ids: List(Nat), at: Nat, indices: List(Nat)): ElabRecursion
}

pub fn elab_take_terms(xs: List(KernelTerm), n: Nat): List(KernelTerm) {
  match n {
    Zero => Nil
    Succ(m) => ⊢ List(KernelTerm) from match xs {
      Nil => Nil
      Cons(x, rest) => Cons(x, elab_take_terms(rest, m))
    }
  }
}

pub fn elab_drop_terms(xs: List(KernelTerm), n: Nat): List(KernelTerm) {
  match n {
    Zero => xs
    Succ(m) => ⊢ List(KernelTerm) from match xs {
      Nil => Nil
      Cons(^x, rest) => elab_drop_terms(rest, m)
    }
  }
}


// The indices as distinct atoms, none of them in `seen`.
pub fn elab_index_atoms(ts: List(KernelTerm), seen: List(Nat)): Option(List(Nat)) {
  match ts {
    Nil => Some(Nil)
    Cons(t, rest) => ⊢ Option(List(Nat)) from match t {
      KernelFVar(a) => if elab_has_nat(seen, a) { None } else {
        ⊢ Option(List(Nat)) from match elab_index_atoms(rest, Cons(a, seen)) {
          None => None
          Some(more) => Some(Cons(a, more))
        }
      }
      _ => None
    }
  }
}

// Whether a local other than `skip` has a type that mentions one of `atoms`:
// the host would move it after the matched value and generalize it.
pub fn elab_dependents(env: List(ElabBinding), atoms: List(Nat), skip: List(Nat)): Bool {
  match env {
    Nil => false
    Cons(b, rest) => ⊢ Bool from match b.value {
      // A `#` binding is the elaborator's own record, not a variable.
      KernelFVar(a) => (text_starts_with(b.name, "#", 0) == false && elab_has_nat(skip, a) == false && elab_any_occurs(b.ty, atoms)) || elab_dependents(rest, atoms, skip)
      _ => elab_dependents(rest, atoms, skip)
    }
  }
}

// Abstracts the atoms, innermost (last index) first, at depths from `depth`.
pub fn elab_abstract_indices(t: KernelTerm, rev: List(Nat), depth: Nat): KernelTerm {
  match rev {
    Nil => t
    Cons(a, rest) => elab_abstract_indices(kernel_abstract_at(t, depth, a), rest, depth + 1)
  }
}

pub fn elab_lam_n(t: KernelTerm, n: Nat): KernelTerm {
  match n {
    Zero => t
    Succ(m) => elab_lam_n(kernel_lam(t), m)
  }
}

// Instantiates the innermost bound variable first.
pub fn elab_inst_all(t: KernelTerm, vs: List(KernelTerm)): KernelTerm {
  match vs {
    Nil => t
    Cons(v, rest) => elab_inst_all(kernel_inst(t, v), rest)
  }
}

// The parameter atoms of a recursive call on a field, with each index of the
// matched value replaced by the field's index there; `None` when one of the
// field's indices is not a variable.
pub fn elab_moved_indices(ids: List(Nat), indices: List(Nat), at: List(KernelTerm)): Option(List(Nat)) {
  match indices {
    Nil => Some(ids)
    Cons(i, rest) => ⊢ Option(List(Nat)) from match at {
      Nil => None
      Cons(t, more) => ⊢ Option(List(Nat)) from match t {
        KernelFVar(a) => ⊢ Option(List(Nat)) from match elab_position(ids, i, 0) {
          None => elab_moved_indices(ids, rest, more)
          Some(p) => elab_moved_indices(elab_set_nat(ids, p, a), rest, more)
        }
        _ => None
      }
    }
  }
}

// The indices of a type of an inductive family, after its `np` parameters.
pub fn elab_type_indices(k: Nat, core: &mut KernelCore, ty: KernelTerm, np: Nat): List(KernelTerm) {
  let spine := elab_spine(k, kernel_whnf(k, &mut core, ty, true, false), Nil)
  elab_drop_terms(spine.snd, np)
}



// The family in the group of a plain recursive field.
pub fn elab_rec_family(recs: List(KernelRecArg), i: Nat): Nat {
  match recs {
    Nil => 0
    Cons(r, rest) => if r.arg == i && r.ys == 0 { r.family } else { elab_rec_family(rest, i) }
  }
}

pub fn elab_plain_recursive(recs: List(KernelRecArg)): Nat {
  match recs {
    Nil => 0
    Cons(r, rest) => if r.ys == 0 { 1 + elab_plain_recursive(rest) } else { elab_plain_recursive(rest) }
  }
}

// A recursive field that is a function (of `ys` arguments) into the group's
// family at `position`.
pub fn elab_fun_rec(recs: List(KernelRecArg), i: Nat, position: Nat): Bool {
  match recs {
    Nil => false
    Cons(r, rest) => (r.arg == i && r.ys != 0 && r.family == position) || elab_fun_rec(rest, i, position)
  }
}

// How many arguments the function-typed recursive field `i` takes.
pub fn elab_fun_ys(recs: List(KernelRecArg), i: Nat): Nat {
  match recs {
    Nil => 0
    Cons(r, rest) => if r.arg == i && r.ys != 0 { r.ys } else { elab_fun_ys(rest, i) }
  }
}

// The type of the induction hypothesis of a function-typed recursive field:
// `∀ y…. motive(f(y…))`, from the field's type `∀ y…. Family(…)`.
pub fn elab_fun_ih(k: Nat, core: &mut KernelCore, ty: KernelTerm, applied: KernelTerm, n: Nat, motive: KernelTerm, np: Nat): KernelTerm {
  match k {
    Zero => KernelSortTerm(KernelProp)
    Succ(j) => ⊢ KernelTerm from match n {
      Zero => {
        let at := elab_type_indices(j, &mut core, ty, np)
        elab_inst_all(motive, Cons(applied, List::reverse(at)))
      }
      Succ(m) => ⊢ KernelTerm from match kernel_as_pi(kernel_whnf(j, &mut core, ty, true, false)) {
        None => KernelSortTerm(KernelProp)
        Some(p) => {
          let y := kernel_fresh(&mut core, p.fst)
          let inner := elab_fun_ih(j, &mut core, kernel_inst(p.snd, KernelFVar(y)), kernel_app(applied, KernelFVar(y)), m, motive, np)
          kernel_pi_over(y, p.fst, inner)
        }
      }
    }
  }
}

// One motive per family of the group: the match's for its own family, and
// `Unit` for the others, as the host makes them.
pub fn elab_group_motives(core: KernelCore, group: List(Text), family: Text, motive: KernelTerm, prop: Bool): List(KernelTerm) {
  match group {
    Nil => Nil
    Cons(g, rest) => {
      let here := if g == family { motive } else {
        ⊢ KernelTerm from match kernel_ind_get(core, g) {
          None => KernelConst(elab_unit_type(prop))
          Some(info) => elab_lam_n(KernelConst(elab_unit_type(prop)), info.indices + 1)
        }
      }
      Cons(here, elab_group_motives(core, rest, family, motive, prop))
    }
  }
}

// What the other members of a group are, in a recursor's motives: `Unit`,
// or `True` for an induction principle.
pub fn elab_unit_type(prop: Bool): Text { if prop { "True" } else { "Unit" } }

pub fn elab_unit_value(prop: Bool): Text { if prop { "True::Trivial" } else { "Unit::Star" } }

pub fn elab_unit_minors(cs: List(KernelCtorInfo), prop: Bool): List(KernelTerm) {
  match cs {
    Nil => Nil
    Cons(c, rest) => Cons(elab_lam_n(KernelConst(elab_unit_value(prop)), c.nargs + elab_plain_recursive(c.recursive)), elab_unit_minors(rest, prop))
  }
}

// The cases of every family of the group, in order: the match's own, and
// `Unit::Star` for each constructor of the others.
pub fn elab_group_minors(core: KernelCore, group: List(Text), family: Text, minors: List(KernelTerm), prop: Bool): List(KernelTerm) {
  match group {
    Nil => Nil
    Cons(g, rest) => {
      let here := if g == family { minors } else {
        ⊢ List(KernelTerm) from match kernel_ind_get(core, g) {
          None => Nil
          Some(info) => elab_unit_minors(info.constructors, prop)
        }
      }
      List::append(here, elab_group_minors(core, rest, family, minors, prop))
    }
  }
}

pub fn elab_inst_marker(t: KernelTerm, n: Nat): KernelTerm {
  match n {
    Zero => t
    Succ(m) => elab_inst_marker(kernel_inst(t, KernelConst("#ih")), m)
  }
}

// A minor `a⃗ ⇒ h⃗ ⇒ v` without its induction hypotheses, when `v` uses none.
pub fn elab_strip_ihs(t: KernelTerm, n: Nat, r: Nat): Option(KernelTerm) {
  match elab_peel_lams(t, n + r) {
    None => None
    Some(body) => {
      let v := elab_inst_marker(body, r)
      if kernel_mentions_const(v, ["#ih"]) { None } else { Some(elab_lam_n(v, n)) }
    }
  }
}

pub fn elab_peel_lams(t: KernelTerm, n: Nat): Option(KernelTerm) {
  match n {
    Zero => Some(t)
    Succ(m) => ⊢ Option(KernelTerm) from match t {
      KernelLam(b, ^d) => elab_peel_lams(b, m)
      _ => None
    }
  }
}

pub fn elab_strip_all(cs: List(KernelCtorInfo), ms: List(KernelTerm)): Option(List(KernelTerm)) {
  match cs {
    Nil => Some(Nil)
    Cons(c, rest) => ⊢ Option(List(KernelTerm)) from match ms {
      Nil => None
      Cons(m, more) => ⊢ Option(List(KernelTerm)) from match elab_strip_ihs(m, c.nargs, List::length(c.recursive)) {
        None => None
        Some(x) => ⊢ Option(List(KernelTerm)) from match elab_strip_all(rest, more) {
          None => None
          Some(xs) => Some(Cons(x, xs))
        }
      }
    }
  }
}

// The minors of the matched family without their induction hypotheses, when
// the match is on a family of a group with others, on the recursor, and
// `family@cases` exists (see `elab_family_cases`).
pub fn elab_cases_pick(core: KernelCore, info: KernelIndInfo, family: Text, eliminator: Text, indices: List(Nat), minors: List(KernelTerm)): Option(List(KernelTerm)) {
  if List::length(info.group) < 2 || List::length(indices) != 0 || eliminator != Text::concat(family, "::rec") { None } else {
    ⊢ Option(List(KernelTerm)) from match kernel_global_get(core, Text::concat(family, "@cases")) {
      None => None
      Some(^g) => elab_strip_all(info.constructors, minors)
    }
  }
}

// A function of the `mutual` block of functions being elaborated.
pub fn elab_in_group(env: List(ElabBinding), name: Text): Bool {
  match elab_lookup(env, Text::concat("#mutual ", name)) {
    None => false
    Some(^b) => true
  }
}


// The half of a pair, by its eliminator, as the host projects it.
pub fn elab_half(a: KernelTerm, b: KernelTerm, p: KernelTerm, first: Bool): KernelTerm {
  let motive := kernel_lam(if first { a } else { b })
  let minor := kernel_lam(kernel_lam(KernelBVar(if first { 1 } else { 0 })))
  elab_apps(KernelConst("BelowPair::rec"), Cons(a, Cons(b, Cons(motive, Cons(minor, Cons(p, Nil))))))
}


// The error of a recursive call that is not on a field of the matched value:
// such a definition is compiled again, as a recursion on deeper parts.
pub fn elab_none_recursion(r: Option(ElabRecursion)): Bool {
  match r {
    None => true
    Some(^x) => false
  }
}

pub fn elab_deep_message(): Text {
  "a recursive call must pass a smaller field of the matched parameter and the other parameters unchanged"
}

// Recursion that changes other parameters, as the host compiles it: the
// parameters some recursive call passes something else for are generalized,
// so the motive is a function of them and each call applies the induction
// hypothesis to what it passes.
pub fn elab_bound_with(env: List(ElabBinding), prefix: Text): Bool {
  match env {
    Nil => false
    Cons(b, rest) => text_starts_with(b.name, prefix, 0) || elab_bound_with(rest, prefix)
  }
}

// `the(T, e)` when the kernel has `the`, for a `let` that writes its type.
pub fn elab_the(core: KernelCore, ty: Option(KernelTerm), value: KernelTerm): KernelTerm {
  match ty {
    None => value
    Some(t) => ⊢ KernelTerm from match kernel_global_get(core, "the") {
      None => value
      Some(^g) => elab_apps(KernelConst("the"), [t, value])
    }
  }
}

// Whether the family is a nested member, standing for a type applied to some.
pub fn elab_has_alias(info: KernelIndInfo): Bool {
  match info.alias {
    Some(^al) => true
    None => false
  }
}

// Whether one of the implicit parameters `ids` is not in the type of the
// value the innermost match is on.
pub fn elab_implicit_movable(core: KernelCore, env: List(ElabBinding), ids: List(Nat)): Bool {
  match elab_self(env) {
    None => false
    Some(me) => ⊢ Bool from match elab_self_params(env, me.snd) {
      None => false
      Some(params) => elab_on_movable(core, env, ids, params)
    }
  }
}

// The innermost match on one of the parameters is the recursion's own.
pub fn elab_on_movable(core: KernelCore, env: List(ElabBinding), ids: List(Nat), params: List(Nat)): Bool {
  match env {
    Nil => false
    Cons(b, rest) => if b.name == "#on" {
      ⊢ Bool from match b.value {
        KernelFVar(x) => if elab_has_nat(params, x) {
          ⊢ Bool from match kernel_local_get(core, x) {
            None => false
            Some(xty) => elab_any_absent(ids, xty)
          }
        } else { elab_on_movable(core, rest, ids, params) }
        _ => elab_on_movable(core, rest, ids, params)
      }
    } else { elab_on_movable(core, rest, ids, params) }
  }
}

pub fn elab_any_absent(ids: List(Nat), ty: KernelTerm): Bool {
  match ids {
    Nil => false
    Cons(i, rest) => elab_term_occurs(ty, KernelFVar(i)) == false || elab_any_absent(rest, ty)
  }
}

// The implicit parameters a recursion generalizes: with calls that write them
// by name, each one the matched value's type does not mention (a call may
// change it); the parameters whose types depend on it follow.
pub fn elab_implicit_varied(core: KernelCore, bs: List(ElabBinding), n: Nat, xty: KernelTerm, named: Bool): List(Bool) {
  match n {
    Zero => Nil
    Succ(m) => ⊢ List(Bool) from match bs {
      Nil => Nil
      Cons(b, rest) => Cons(named && elab_term_occurs(xty, b.value) == false, elab_implicit_varied(core, rest, m, xty, named))
    }
  }
}

pub fn elab_binding_names(bs: List(ElabBinding)): List(Text) {
  match bs {
    Nil => Nil
    Cons(b, rest) => Cons(b.name, elab_binding_names(rest))
  }
}

pub fn elab_drop_bindings(bs: List(ElabBinding), n: Nat): List(ElabBinding) {
  match n {
    Zero => bs
    Succ(m) => ⊢ List(ElabBinding) from match bs {
      Nil => Nil
      Cons(^b, rest) => elab_drop_bindings(rest, m)
    }
  }
}

pub fn elab_pick_bindings(bs: List(ElabBinding), at: List(Nat), p: Nat): List(ElabBinding) {
  match bs {
    Nil => Nil
    Cons(b, rest) => if elab_has_nat(at, p) { Cons(b, elab_pick_bindings(rest, at, p + 1)) } else { elab_pick_bindings(rest, at, p + 1) }
  }
}

// `Π v₁ … vₙ. t` over the generalized parameters.
pub fn elab_gen_pi(vb: List(ElabBinding), t: KernelTerm): KernelTerm {
  match vb {
    Nil => t
    Cons(b, rest) => ⊢ KernelTerm from match b.value {
      KernelFVar(a) => kernel_pi(b.ty, kernel_abstract_at(elab_gen_pi(rest, t), 0, a))
      _ => t
    }
  }
}

pub fn elab_binding_values(bs: List(ElabBinding)): List(KernelTerm) {
  match bs {
    Nil => Nil
    Cons(b, rest) => Cons(b.value, elab_binding_values(rest))
  }
}

// Each arm's body under the generalized parameters' names.
pub fn elab_gen_arms(arms: List(SurfaceArm), names: List(Text)): List(SurfaceArm) {
  match arms {
    Nil => Nil
    Cons(a, rest) => Cons(
      SurfaceArm::SurfaceArmMk(a.pattern, a.guard, None, surface_term_mk(SkLam(names, a.body, Nil, Nil), a.body.start, a.body.end)),
      elab_gen_arms(rest, names)
    )
  }
}

pub fn elab_nat_lits(ns: List(Nat)): List(KernelTerm) {
  match ns {
    Nil => Nil
    Cons(n, rest) => Cons(KernelLit(n), elab_nat_lits(rest))
  }
}

pub fn elab_lits_of(t: KernelTerm): List(Nat) {
  match t {
    KernelApp(f, a, ^d) => ⊢ List(Nat) from match a {
      KernelLit(n) => List::append(elab_lits_of(f), Cons(n, Nil))
      _ => elab_lits_of(f)
    }
    _ => Nil
  }
}

pub fn elab_gen_nth(xs: List(Nat), i: Nat): Option(Nat) {
  match xs {
    Nil => None
    Cons(x, rest) => ⊢ Option(Nat) from match i {
      Zero => Some(x)
      Succ(m) => elab_gen_nth(rest, m)
    }
  }
}

// The key atoms of a call in a generalized recursion, and the arguments it
// applies the induction hypothesis to: a generalized parameter's own atom
// stands in the key.
pub fn elab_gen_split(env: List(ElabBinding), ids: List(Nat), vs: List(Nat), args: List(SurfaceTerm), q: Nat): Option((List(Nat) × List(SurfaceTerm))) {
  match args {
    Nil => Some(#(Nil, Nil))
    Cons(a, rest) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match elab_gen_split(env, ids, vs, rest, q + 1) {
      None => None
      Some(more) => if elab_has_nat(vs, q) {
        ⊢ Option((List(Nat) × List(SurfaceTerm))) from match elab_gen_nth(ids, q) {
          None => None
          Some(id) => Some(#(Cons(id, more.fst), Cons(a, more.snd)))
        }
      } else {
        ⊢ Option((List(Nat) × List(SurfaceTerm))) from match a.kind {
          SkVar(x) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match elab_lookup(env, surface_name_text(x)) {
            Some(t) => ⊢ Option((List(Nat) × List(SurfaceTerm))) from match t.value {
              KernelFVar(id) => Some(#(Cons(id, more.fst), more.snd))
              _ => None
            }
            None => None
          }
          _ => None
        }
      }
    }
  }
}

pub fn elab_below_key(atom: Nat): Text {
  Text::concat("#below ", Text::of_nat(atom))
}

pub fn elab_has_function_field(recs: List(KernelRecArg)): Bool {
  match recs {
    Nil => false
    Cons(r, rest) => r.ys != 0 || elab_has_function_field(rest)
  }
}

// The atoms of the plain recursive fields, in order.
pub fn elab_rec_atoms(fields: List(Nat), c: KernelCtorInfo, i: Nat): List(Nat) {
  match fields {
    Nil => Nil
    Cons(f, rest) => if elab_is_recursive(c.recursive, i) { Cons(f, elab_rec_atoms(rest, c, i + 1)) } else { elab_rec_atoms(rest, c, i + 1) }
  }
}

pub fn elab_walk_fields(k: Nat, core: &mut KernelCore, cty: KernelTerm, n: Nat): Option(List(Nat)) {
  match n {
    Zero => Some(Nil)
    Succ(m) => ⊢ Option(List(Nat)) from match kernel_as_pi(kernel_whnf(k, &mut core, cty, true, false)) {
      None => None
      Some(p) => {
        let atom := kernel_fresh(&mut core, p.fst)
        ⊢ Option(List(Nat)) from match elab_walk_fields(k, &mut core, kernel_inst(p.snd, KernelFVar(atom)), m) {
          None => None
          Some(more) => Some(Cons(atom, more))
        }
      }
    }
  }
}

pub fn elab_fresh_all(core: &mut KernelCore, xs: List(Nat), body: KernelTerm): List(Nat) {
  match xs {
    Nil => Nil
    Cons(x, rest) => {
      let a := kernel_fresh(&mut core, kernel_inst(body, KernelFVar(x)))
      Cons(a, elab_fresh_all(&mut core, rest, body))
    }
  }
}

pub fn elab_type_zero(): KernelTerm {
  KernelSortTerm(KernelType(KernelLevel::Mk(0, Nil)))
}

pub fn elab_fresh_types(core: &mut KernelCore, xs: List(Nat)): List(Nat) {
  match xs {
    Nil => Nil
    Cons(^x, rest) => {
      let a := kernel_fresh(&mut core, elab_type_zero())
      Cons(a, elab_fresh_types(&mut core, rest))
    }
  }
}

pub fn elab_pair_ty(a: KernelTerm, b: KernelTerm): KernelTerm {
  elab_apps(KernelConst("BelowPair"), Cons(a, Cons(b, Nil)))
}

// `(e₁, (e₂, … Unit))` and a value of it.
pub fn elab_chain_ty(es: List(KernelTerm)): KernelTerm {
  match es {
    Nil => KernelConst("Unit")
    Cons(e, rest) => elab_pair_ty(e, elab_chain_ty(rest))
  }
}

pub fn elab_chain_val(es: List(KernelTerm), vs: List(KernelTerm)): KernelTerm {
  match es {
    Nil => KernelConst("Unit::Star")
    Cons(e, rest) => ⊢ KernelTerm from match vs {
      Nil => KernelConst("Unit::Star")
      Cons(v, more) => elab_apps(KernelConst("BelowPair::Mk"), Cons(e, Cons(elab_chain_ty(rest), Cons(v, Cons(elab_chain_val(rest, more), Nil)))))
    }
  }
}

// Entry `at` of a value `p` of `elab_chain_ty(es)`.
pub fn elab_chain_entry(es: List(KernelTerm), at: Nat, p: KernelTerm): KernelTerm {
  match es {
    Nil => p
    Cons(e, rest) => ⊢ KernelTerm from match at {
      Zero => elab_half(e, elab_chain_ty(rest), p, true)
      Succ(m) => elab_chain_entry(rest, m, elab_half(e, elab_chain_ty(rest), p, false))
    }
  }
}

// For each recursive field, `M(f) ∧ below(f)` (as `BelowPair`).
pub fn elab_entries(fs: List(Nat), gtop: KernelTerm, below: KernelTerm): List(KernelTerm) {
  match fs {
    Nil => Nil
    Cons(f, rest) => Cons(elab_pair_ty(kernel_inst(gtop, KernelFVar(f)), kernel_inst(below, KernelFVar(f))), elab_entries(rest, gtop, below))
  }
}

pub fn elab_entries_at(fs: List(Nat), bs: List(Nat), gtop: KernelTerm): List(KernelTerm) {
  match fs {
    Nil => Nil
    Cons(f, rest) => ⊢ List(KernelTerm) from match bs {
      Nil => Nil
      Cons(b, more) => Cons(elab_pair_ty(kernel_inst(gtop, KernelFVar(f)), KernelFVar(b)), elab_entries_at(rest, more, gtop))
    }
  }
}

pub fn elab_below_minors(
  k: Nat,
  core: &mut KernelCore,
  ctors: List(KernelCtorInfo),
  params: List(KernelTerm),
  gtop: KernelTerm
): Option(List(KernelTerm)) {
  match ctors {
    Nil => Some(Nil)
    Cons(c, rest) => if elab_has_function_field(c.recursive) { None } else {
      ⊢ Option(List(KernelTerm)) from match kernel_global_get(core, c.name) {
        None => None
        Some(g) => ⊢ Option(List(KernelTerm)) from match elab_instantiate(k, g.ty, params) {
          None => None
          Some(cty) => ⊢ Option(List(KernelTerm)) from match elab_walk_fields(k, &mut core, cty, c.nargs) {
            None => None
            Some(fields) => {
              let recf := elab_rec_atoms(fields, c, 0)
              let bs := elab_fresh_types(&mut core, recf)
              let minor := elab_lams(elab_chain_ty(elab_entries_at(recf, bs, gtop)), List::append(fields, bs))
              ⊢ Option(List(KernelTerm)) from match elab_below_minors(k, &mut core, rest, params, gtop) {
                None => None
                Some(ms) => Some(Cons(minor, ms))
              }
            }
          }
        }
      }
    }
  }
}

// `below(t)`, with `t` the loose variable: the values at the parts of `t`,
// by the family's eliminator into `Type`.
pub fn elab_below_body(
  k: Nat,
  core: &mut KernelCore,
  info: KernelIndInfo,
  family: Text,
  params: List(KernelTerm),
  gtop: KernelTerm
): Option(KernelTerm) {
  match elab_below_minors(k, &mut core, info.constructors, params, gtop) {
    None => None
    Some(minors) => Some(elab_apps(
      KernelConst(Text::concat(family, "::rec")),
      List::append(params, Cons(kernel_lam(elab_type_zero()), List::append(minors, Cons(KernelBVar(0), Nil))))
    ))
  }
}

// The bindings of the calls on the recursive fields, from each field's
// entry `M(f) ∧ below(f)`: the call is its first half, and the field's own
// `below` its second.
pub fn elab_deep_bindings(
  fs: List(Nat),
  entries: List(KernelTerm),
  gtop: KernelTerm,
  below: KernelTerm,
  r: ElabRecursion,
  env: List(ElabBinding)
): List(ElabBinding) {
  match fs {
    Nil => env
    Cons(f, rest) => ⊢ List(ElabBinding) from match entries {
      Nil => env
      Cons(e, more) => {
        let m := kernel_inst(gtop, KernelFVar(f))
        let b := kernel_inst(below, KernelFVar(f))
        let inner := elab_deep_bindings(rest, more, gtop, below, r, env)
        Cons(
          ElabBinding::Mk(elab_rec_key(r.name, elab_set_nat(r.ids, r.at, f)), elab_half(m, b, e, true), m),
          Cons(ElabBinding::Mk(elab_below_key(f), elab_half(m, b, e, false), b), inner)
        )
      }
    }
  }
}

pub fn elab_chain_entries(es: List(KernelTerm), at: Nat, n: Nat, p: KernelTerm): List(KernelTerm) {
  match n {
    Zero => Nil
    Succ(m) => Cons(elab_chain_entry(es, at, p), elab_chain_entries(es, at + 1, m, p))
  }
}

// The recursion of the declaration, as a match nested in a deeper recursion
// reads it from its environment.
pub fn elab_deep_recursion(env: List(ElabBinding)): Option(ElabRecursion) {
  match elab_lookup(env, "#deep motive") {
    None => None
    Some(d) => ⊢ Option(ElabRecursion) from match d.ty {
      KernelLit(at) => ⊢ Option(ElabRecursion) from match elab_self(env) {
        None => None
        Some(me) => ⊢ Option(ElabRecursion) from match elab_self_params(env, me.snd) {
          None => None
          Some(ids) => Some(ElabRecursion::Mk(me.fst, ids, at, Nil))
        }
      }
      _ => None
    }
  }
}


// A constructor opened at fresh atoms: its fields, their types, and the
// fresh atoms for its induction hypotheses.
pub(open) inductive ElabOpened: Type {
  Mk(fields: List(Nat), types: List(KernelTerm), ihs: List(Nat)): ElabOpened
}

pub fn elab_nc_ty0(): KernelTerm { KernelSortTerm(KernelType(KernelLevel::Mk(0, Nil))) }

pub fn elab_eq(ty: KernelTerm, a: KernelTerm, b: KernelTerm): KernelTerm {
  elab_apps(KernelConst("Eq"), Cons(ty, Cons(a, Cons(b, Nil))))
}

pub fn elab_open_fields(k: Nat, core: &mut KernelCore, cty: KernelTerm, n: Nat): Option(List(Nat) × List(KernelTerm)) {
  match n {
    Zero => Some(#(Nil, Nil))
    Succ(m) => ⊢ Option(List(Nat) × List(KernelTerm)) from match kernel_as_pi(kernel_whnf(k, &mut core, cty, true, false)) {
      None => None
      Some(p) => {
        let atom := kernel_fresh(&mut core, p.fst)
        ⊢ Option(List(Nat) × List(KernelTerm)) from match elab_open_fields(k, &mut core, kernel_inst(p.snd, KernelFVar(atom)), m) {
          None => None
          Some(more) => Some(#(Cons(atom, more.fst), Cons(p.fst, more.snd)))
        }
      }
    }
  }
}

pub fn elab_fresh_units(core: &mut KernelCore, n: Nat): List(Nat) {
  match n {
    Zero => Nil
    Succ(m) => {
      let a := kernel_fresh(&mut core, KernelConst("Unit"))
      Cons(a, elab_fresh_units(&mut core, m))
    }
  }
}

pub fn elab_open_ctor(k: Nat, core: &mut KernelCore, c: KernelCtorInfo, params: List(KernelTerm)): Option(ElabOpened) {
  match kernel_global_get(core, c.name) {
    None => None
    Some(g) => ⊢ Option(ElabOpened) from match elab_instantiate(k, g.ty, params) {
      None => None
      Some(cty) => ⊢ Option(ElabOpened) from match elab_open_fields(k, &mut core, cty, c.nargs) {
        None => None
        Some(fs) => Some(ElabOpened::Mk(fs.fst, fs.snd, elab_fresh_units(&mut core, List::length(c.recursive))))
      }
    }
  }
}

pub fn elab_small_sort(s: KernelSort): Bool {
  match s {
    KernelProp => true
    KernelType(l) => l.constant == 0 && List::length(l.variables) == 0
  }
}

// The fields that get an equation: independent of the earlier fields, and
// of a type in `Type`.
pub fn elab_injective(k: Nat, core: &mut KernelCore, fields: List(Nat), types: List(KernelTerm), earlier: List(Nat), at: Nat): List(Nat) {
  match fields {
    Nil => Nil
    Cons(f, rest) => ⊢ List(Nat) from match types {
      Nil => Nil
      Cons(t, more) => {
        let independent := elab_any_occurs(t, earlier) == false
        let small := ⊢ Bool from match kernel_infer(k, &mut core, t) {
          None => false
          Some(s) => ⊢ Bool from match kernel_as_sort(kernel_whnf(k, &mut core, s, true, false)) {
            None => false
            Some(srt) => elab_small_sort(srt)
          }
        }
        let tail := elab_injective(k, &mut core, rest, more, Cons(f, earlier), at + 1)
        if independent && small { Cons(at, tail) } else { tail }
      }
    }
  }
}

pub fn elab_has_index(xs: List(Nat), x: Nat): Bool {
  match xs {
    Nil => false
    Cons(y, rest) => y == x || elab_has_index(rest, x)
  }
}


// A match on a family whose indices are not distinct variables, as the host
// compiles one: the motive takes an equation `i_k = a_k` for each such index
// `a_k`, the eliminator is applied to `Refl(a_k)`, and each case solves its
// equations. Two different constructors make the case impossible, by the
// no-confusion of their family; the same constructor gives equations between
// its injective fields; a variable is replaced by what it equals, and the arm
// is transported back along the equations by `Eq::rec` (`Eq::ind` for a
// proposition).

// An index the motive generalizes: its position, type and argument.
pub(open) inductive ElabGen: Type {
  Mk(k: Nat, ty: KernelTerm, arg: KernelTerm): ElabGen
}

pub(open) inductive ElabEqn: Type {
  Mk(l: KernelTerm, r: KernelTerm, ty: KernelTerm, proof: KernelTerm): ElabEqn
}

// A variable fixed to a term, with a proof of `f = t`.
pub(open) inductive ElabSol: Type {
  Mk(f: Nat, t: KernelTerm, ty: KernelTerm, proof: KernelTerm): ElabSol
}

pub(open) inductive ElabPlan: Type {
  PlanImpossible(absurd: KernelTerm): ElabPlan
  PlanSolved(sols: List(ElabSol)): ElabPlan
  PlanErr(message: Text): ElabPlan
}

pub fn elab_replace(t: KernelTerm, f: Nat, v: KernelTerm): KernelTerm {
  kernel_inst(kernel_abstract_at(t, 0, f), v)
}

pub fn elab_replace_all(t: KernelTerm, sols: List(ElabSol)): KernelTerm {
  match sols {
    Nil => t
    Cons(s, rest) => elab_replace_all(elab_replace(t, s.f, s.t), rest)
  }
}

pub fn elab_replace_env(env: List(ElabBinding), sols: List(ElabSol)): List(ElabBinding) {
  match env {
    Nil => Nil
    Cons(b, rest) => Cons(
      ElabBinding::Mk(b.name, elab_replace_all(b.value, sols), elab_replace_all(b.ty, sols)),
      elab_replace_env(rest, sols)
    )
  }
}

// From `p: a = b` a proof of `b = a` that computes when `p` is `Refl`.
pub fn elab_sym(core: &mut KernelCore, ty: KernelTerm, a: KernelTerm, b: KernelTerm, p: KernelTerm): KernelTerm {
  let y := kernel_fresh(&mut core, ty)
  let e := kernel_fresh(&mut core, KernelConst("Unit"))
  let motive := elab_lams(elab_eq(ty, KernelFVar(y), a), Cons(y, Cons(e, Nil)))
  elab_apps(KernelConst("Eq::ind"), Cons(ty, Cons(a, Cons(motive, Cons(elab_apps(KernelConst("Eq::Refl"), Cons(ty, Cons(a, Nil))), Cons(b, Cons(p, Nil)))))))
}

pub fn elab_fixed(sols: List(ElabSol), f: Nat): Bool {
  match sols {
    Nil => false
    Cons(s, rest) => s.f == f || elab_fixed(rest, f)
  }
}

// `t` as a variable that may be fixed to `other`.
pub fn elab_fixable(t: KernelTerm, other: KernelTerm, solvable: List(Nat), sols: List(ElabSol)): Option(Nat) {
  match t {
    KernelFVar(f) => if elab_has_nat(solvable, f) && elab_fixed(sols, f) == false && elab_any_occurs(other, Cons(f, Nil)) == false { Some(f) } else { None }
    _ => None
  }
}

pub fn elab_ctor_view(k: Nat, core: KernelCore, t: KernelTerm): Option(Text × List(KernelTerm)) {
  let spine := elab_spine(k, t, Nil)
  ⊢ Option(Text × List(KernelTerm)) from match spine.fst {
    KernelConst(n) => ⊢ Option(Text × List(KernelTerm)) from match kernel_ctor_get(core, n) {
      None => None
      Some(^c) => Some(#(n, spine.snd))
    }
    _ => None
  }
}

pub fn elab_term_at(xs: List(KernelTerm), n: Nat): KernelTerm {
  match xs {
    Nil => KernelConst("Unit")
    Cons(x, rest) => ⊢ KernelTerm from match n {
      Zero => x
      Succ(m) => elab_term_at(rest, m)
    }
  }
}

pub fn elab_find_ctor(cs: List(KernelCtorInfo), name: Text): Option(KernelCtorInfo) {
  match cs {
    Nil => None
    Cons(c, rest) => if c.name == name { Some(c) } else { elab_find_ctor(rest, name) }
  }
}

// The equations between the injective fields of two applications of one
// constructor, pushed in order on the work list (the last on top).
pub fn elab_inj_eqns(
  noconf: Text,
  pargs: List(KernelTerm),
  inj: List(Nat),
  all: List(Nat),
  pos: Nat,
  types: List(KernelTerm),
  al: List(KernelTerm),
  ar: List(KernelTerm),
  l: KernelTerm,
  r: KernelTerm,
  proof: KernelTerm,
  work: List(ElabEqn)
): List(ElabEqn) {
  match inj {
    Nil => work
    Cons(i, rest) => {
      let fty := elab_term_at(types, i)
      let a := elab_term_at(al, i)
      let b := elab_term_at(ar, i)
      let n := List::length(all)
      let pick := elab_lam_n(KernelBVar(n - 1 - pos), n)
      let pr := elab_apps(KernelConst(noconf), List::append(pargs, Cons(elab_eq(fty, a, b), Cons(l, Cons(r, Cons(proof, Cons(pick, Nil)))))))
      elab_inj_eqns(noconf, pargs, rest, all, pos + 1, types, al, ar, l, r, proof, Cons(ElabEqn::Mk(a, b, fty, pr), work))
    }
  }
}

pub fn elab_cyclic(sols: List(ElabSol), all: List(ElabSol)): Bool {
  match sols {
    Nil => false
    Cons(s, rest) => elab_any_occurs(s.t, elab_sol_atoms(all)) || elab_cyclic(rest, all)
  }
}

pub fn elab_sol_atoms(sols: List(ElabSol)): List(Nat) {
  match sols {
    Nil => Nil
    Cons(s, rest) => Cons(s.f, elab_sol_atoms(rest))
  }
}

pub fn elab_unify_indices(
  k: Nat,
  core: &mut KernelCore,
  solvable: List(Nat),
  work: List(ElabEqn),
  sols: List(ElabSol),
  stuck: Bool,
  goal: KernelTerm
): ElabPlan {
  match k {
    Zero => { kernel_set_to(&mut core.exhausted, true)
      PlanErr("elaboration exhausted") }
    Succ(j) => ⊢ ElabPlan from match work {
      Nil => if stuck { PlanErr("an index equation is between a constructor and a term that is not one") } else if elab_cyclic(sols, sols) { PlanErr("the index equations are cyclic") } else { PlanSolved(List::reverse(sols)) }
      Cons(eq0, rest) => {
        let l := kernel_whnf(j, &mut core, eq0.l, true, false)
        let r := kernel_whnf(j, &mut core, eq0.r, true, false)
        if kernel_conv(j, &mut core, l, r) { elab_unify_indices(j, &mut core, solvable, rest, sols, stuck, goal) } else {
          let later_is_r := ⊢ Bool from match l {
            KernelFVar(a) => ⊢ Bool from match r {
              KernelFVar(b) => b > a
              _ => false
            }
            _ => false
          }
          let fl := elab_fixable(l, r, solvable, sols)
          let fr := elab_fixable(r, l, solvable, sols)
          ⊢ ElabPlan from match fl {
            Some(f) => if later_is_r == false {
              elab_unify_indices(j, &mut core, solvable, rest, Cons(ElabSol::Mk(f, r, eq0.ty, eq0.proof), sols), stuck, goal)
            } else { ⊢ ElabPlan from match fr {
              Some(g) => {
                let pr := elab_sym(&mut core, eq0.ty, l, r, eq0.proof)
                elab_unify_indices(j, &mut core, solvable, rest, Cons(ElabSol::Mk(g, l, eq0.ty, pr), sols), stuck, goal)
              }
              None => elab_unify_indices(j, &mut core, solvable, rest, Cons(ElabSol::Mk(f, r, eq0.ty, eq0.proof), sols), stuck, goal)
            } }
            None => ⊢ ElabPlan from match fr {
              Some(g) => {
                let pr := elab_sym(&mut core, eq0.ty, l, r, eq0.proof)
                elab_unify_indices(j, &mut core, solvable, rest, Cons(ElabSol::Mk(g, l, eq0.ty, pr), sols), stuck, goal)
              }
              None => ⊢ ElabPlan from match elab_ctor_view(j, core, l) {
                None => elab_unify_indices(j, &mut core, solvable, rest, sols, true, goal)
                Some(vl) => ⊢ ElabPlan from match elab_ctor_view(j, core, r) {
                  None => elab_unify_indices(j, &mut core, solvable, rest, sols, true, goal)
                  Some(vr) => ⊢ ElabPlan from match kernel_ctor_get(core, vl.fst) {
                    None => PlanErr("unknown constructor")
                    Some(cl) => ⊢ ElabPlan from match kernel_ctor_get(core, vr.fst) {
                      None => PlanErr("unknown constructor")
                      Some(cr) => if cl.fst != cr.fst { PlanErr("an index equation is between constructors of different types") } else {
                        let noconf := Text::concat(cl.fst, "::noconf")
                        ⊢ ElabPlan from match kernel_ind_get(core, cl.fst) {
                          None => PlanErr("unknown family")
                          Some(info) => ⊢ ElabPlan from match kernel_global_get(core, noconf) {
                            None => PlanErr("an index equation is on a family without no-confusion")
                            Some(^nc) => {
                              let pargs := elab_take_terms(vl.snd, info.params)
                              if vl.fst != vr.fst {
                                PlanImpossible(elab_apps(KernelConst(noconf), List::append(pargs, Cons(goal, Cons(l, Cons(r, Cons(eq0.proof, Nil)))))))
                              } else { ⊢ ElabPlan from match elab_find_ctor(info.constructors, vl.fst) {
                                None => PlanErr("unknown constructor")
                                Some(c) => ⊢ ElabPlan from match elab_open_ctor(j, &mut core, c, pargs) {
                                  None => PlanErr("cannot open the constructor")
                                  Some(o) => {
                                    let inj := elab_injective(j, &mut core, o.fields, o.types, Nil, 0)
                                    let more := elab_inj_eqns(noconf, pargs, inj, inj, 0, o.types, elab_drop_terms(vl.snd, info.params), elab_drop_terms(vr.snd, info.params), l, r, eq0.proof, rest)
                                    elab_unify_indices(j, &mut core, solvable, more, sols, stuck, goal)
                                  }
                                }
                              } }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub fn elab_gen_pis_over(atoms: List(Nat), domains: List(KernelTerm), body: KernelTerm): KernelTerm {
  match atoms {
    Nil => body
    Cons(a, rest) => ⊢ KernelTerm from match domains {
      Nil => body
      Cons(d, more) => kernel_pi_over(a, d, elab_gen_pis_over(rest, more, body))
    }
  }
}

pub fn elab_atom_type(core: KernelCore, a: Nat): KernelTerm {
  match kernel_local_get(core, a) {
    Some(t) => t
    None => KernelSortTerm(KernelProp)
  }
}

// What is bound from the first fixed variable on, other than the matched
// one, and has a type that mentions a fixed variable or such a binding.
pub fn elab_dependent_atoms(core: KernelCore, local: List(Nat), started: Bool, x: Nat, changed: List(Nat)): List(Nat) {
  match local {
    Nil => Nil
    Cons(a, rest) => {
      let on := started || elab_has_nat(changed, a)
      if on == false || a == x || elab_has_nat(changed, a) { elab_dependent_atoms(core, rest, on, x, changed) } else {
        if elab_any_occurs(elab_atom_type(core, a), changed) {
          Cons(a, elab_dependent_atoms(core, rest, on, x, Cons(a, changed)))
        } else { elab_dependent_atoms(core, rest, on, x, changed) }
      }
    }
  }
}

// The atoms a later binding of the same name does not shadow: an arm cannot
// refer to a shadowed one, so only the later one is generalized.
pub fn elab_unshadowed_atoms(env: List(ElabBinding), xs: List(Nat)): List(Nat) {
  match xs {
    Nil => Nil
    Cons(a, rest) => if elab_atom_shadowed(env, a, Nil) { elab_unshadowed_atoms(env, rest) } else { Cons(a, elab_unshadowed_atoms(env, rest)) }
  }
}

// `env` lists the newest binding first; `seen` holds the names newer ones bind.
pub fn elab_atom_shadowed(env: List(ElabBinding), a: Nat, seen: List(Text)): Bool {
  match env {
    Nil => false
    Cons(b, rest) => ⊢ Bool from match b.value {
      KernelFVar(c) => if c == a && text_starts_with(b.name, "#", 0) == false { elab_has_text(seen, b.name) } else { elab_atom_shadowed(rest, a, Cons(b.name, seen)) }
      _ => elab_atom_shadowed(rest, a, Cons(b.name, seen))
    }
  }
}

pub fn elab_atom_types(core: KernelCore, xs: List(Nat)): List(KernelTerm) {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(elab_atom_type(core, x), elab_atom_types(core, rest))
  }
}

// The states of the transported goal: each after one more solution.
pub fn elab_states(t: KernelTerm, sols: List(ElabSol)): List(KernelTerm) {
  match sols {
    Nil => Cons(t, Nil)
    Cons(s, rest) => Cons(t, elab_states(elab_replace(t, s.f, s.t), rest))
  }
}

// Transports `cur` back along the solutions, the last one innermost.
pub fn elab_transport(core: &mut KernelCore, elim: Text, sols: List(ElabSol), states: List(KernelTerm), cur: KernelTerm): KernelTerm {
  match sols {
    Nil => cur
    Cons(s, rest) => ⊢ KernelTerm from match states {
      Nil => cur
      Cons(st, more) => {
        let inner := elab_transport(&mut core, elim, rest, more, cur)
        let y := kernel_fresh(&mut core, s.ty)
        let e2 := kernel_fresh(&mut core, KernelConst("Unit"))
        let motive := elab_lams(elab_replace(st, s.f, KernelFVar(y)), Cons(y, Cons(e2, Nil)))
        let sym := elab_sym(&mut core, s.ty, KernelFVar(s.f), s.t, s.proof)
        elab_apps(KernelConst(elim), Cons(s.ty, Cons(s.t, Cons(motive, Cons(inner, Cons(KernelFVar(s.f), Cons(sym, Nil)))))))
      }
    }
  }
}

pub fn elab_env_atoms(env: List(ElabBinding)): List(Nat) {
  match env {
    Nil => Nil
    Cons(b, rest) => ⊢ List(Nat) from match b.value {
      KernelFVar(a) => if elab_has_nat(elab_env_atoms(rest), a) { elab_env_atoms(rest) } else { List::append(elab_env_atoms(rest), Cons(a, Nil)) }
      _ => elab_env_atoms(rest)
    }
  }
}

// Strips one product per equation off the goal, binding each to a fresh atom.
pub fn elab_strip_eqs(k: Nat, core: &mut KernelCore, goal: KernelTerm, n: Nat): Option(List(Nat) × KernelTerm) {
  match n {
    Zero => Some(#(Nil, goal))
    Succ(m) => ⊢ Option(List(Nat) × KernelTerm) from match kernel_as_pi(kernel_whnf(k, &mut core, goal, true, false)) {
      None => None
      Some(p) => {
        let e := kernel_fresh(&mut core, p.fst)
        ⊢ Option(List(Nat) × KernelTerm) from match elab_strip_eqs(k, &mut core, kernel_inst(p.snd, KernelFVar(e)), m) {
          None => None
          Some(more) => Some(#(Cons(e, more.fst), more.snd))
        }
      }
    }
  }
}

// The initial work list: the equation of each generalized index, the last
// on top.
pub fn elab_index_work(gens: List(ElabGen), idx: List(KernelTerm), eqs: List(Nat), work: List(ElabEqn)): List(ElabEqn) {
  match gens {
    Nil => work
    Cons(g, rest) => ⊢ List(ElabEqn) from match eqs {
      Nil => work
      Cons(e, more) => elab_index_work(rest, idx, more, Cons(ElabEqn::Mk(elab_term_at(idx, g.k), g.arg, g.ty, KernelFVar(e)), work))
    }
  }
}

pub fn elab_gen_refls(gens: List(ElabGen)): List(KernelTerm) {
  match gens {
    Nil => Nil
    Cons(g, rest) => Cons(elab_apps(KernelConst("Eq::Refl"), Cons(g.ty, Cons(g.arg, Nil))), elab_gen_refls(rest))
  }
}

// The index types of a family at its parameters; `None` when one depends on
// an earlier index.
pub fn elab_index_types(k: Nat, core: &mut KernelCore, ty: KernelTerm, n: Nat, earlier: List(Nat)): Option(List(KernelTerm)) {
  match n {
    Zero => Some(Nil)
    Succ(m) => ⊢ Option(List(KernelTerm)) from match kernel_as_pi(kernel_whnf(k, &mut core, ty, true, false)) {
      None => None
      Some(p) => if elab_any_occurs(p.fst, earlier) { None } else {
        let a := kernel_fresh(&mut core, p.fst)
        ⊢ Option(List(KernelTerm)) from match elab_index_types(k, &mut core, kernel_inst(p.snd, KernelFVar(a)), m, Cons(a, earlier)) {
          None => None
          Some(more) => Some(Cons(p.fst, more))
        }
      }
    }
  }
}

// Splits the indices: a variable seen for the first time is abstracted by the
// motive (its atom), any other index is generalized with an equation (a fresh
// atom of its type).
pub fn elab_split_indices(core: &mut KernelCore, idx: List(KernelTerm), tys: List(KernelTerm), at: Nat, x: Nat, seen: List(Nat)): List(Nat) × List(ElabGen) {
  ⊢ (List(Nat) × List(ElabGen)) from match idx {
    Nil => #(Nil, Nil)
    Cons(t, rest) => {
      let ty := elab_term_at(tys, at)
      let v0: Option(Nat) := ⊢ Option(Nat) from match t {
        KernelFVar(v) => if v != x && elab_has_nat(seen, v) == false { Some(v) } else { None }
        _ => None
      }
      ⊢ (List(Nat) × List(ElabGen)) from match v0 {
        Some(v) => {
          let more := elab_split_indices(&mut core, rest, tys, at + 1, x, Cons(v, seen))
          #(Cons(v, more.fst), more.snd)
        }
        None => {
          let a := kernel_fresh(&mut core, ty)
          let more := elab_split_indices(&mut core, rest, tys, at + 1, x, seen)
          #(Cons(a, more.fst), Cons(ElabGen::Mk(at, ty, t), more.snd))
        }
      }
    }
  }
}

pub fn elab_gen_eq_pis(core: &mut KernelCore, gens: List(ElabGen), atoms: List(Nat), body: KernelTerm): KernelTerm {
  match gens {
    Nil => body
    Cons(g, rest) => {
      let inner := elab_gen_eq_pis(&mut core, rest, atoms, body)
      let i := elab_gx_nat(atoms, g.k)
      let ety := elab_eq(g.ty, KernelFVar(i), g.arg)
      let e := kernel_fresh(&mut core, ety)
      kernel_pi_over(e, ety, inner)
    }
  }
}

pub fn elab_gen_args_mention(gens: List(ElabGen), atoms: List(Nat)): Bool {
  match gens {
    Nil => false
    Cons(g, rest) => elab_any_occurs(g.arg, atoms) || elab_gen_args_mention(rest, atoms)
  }
}

pub fn elab_arms_distinct(arms: List(SurfaceArm), ctors: List(KernelCtorInfo), family: Text, seen: List(Text)): Bool {
  match arms {
    Nil => true
    Cons(a, rest) => ⊢ Bool from match elab_ctor_pattern(a.pattern, ctors, family) {
      None => false
      Some(p) => elab_has_text(seen, p.fst) == false && elab_arms_distinct(rest, ctors, family, Cons(p.fst, seen))
    }
  }
}

pub fn elab_has_text(xs: List(Text), x: Text): Bool {
  match xs {
    Nil => false
    Cons(y, rest) => y == x || elab_has_text(rest, x)
  }
}

pub fn elab_gx_nat(xs: List(Nat), n: Nat): Nat {
  match xs {
    Nil => 0
    Cons(x, rest) => ⊢ Nat from match n {
      Zero => x
      Succ(m) => elab_gx_nat(rest, m)
    }
  }
}

pub fn elab_vars_of(atoms: List(Nat), idx: List(KernelTerm)): List(Nat) {
  match atoms {
    Nil => Nil
    Cons(a, rest) => ⊢ List(Nat) from match idx {
      Nil => Nil
      Cons(t, more) => {
        let tail := elab_vars_of(rest, more)
        ⊢ List(Nat) from match t {
          KernelFVar(v) => if v == a { Cons(a, tail) } else { tail }
          _ => tail
        }
      }
    }
  }
}

pub fn elab_sols_mention(sols: List(ElabSol), atoms: List(Nat)): Bool {
  match sols {
    Nil => false
    Cons(s, rest) => elab_any_occurs(s.t, atoms) || elab_sols_mention(rest, atoms)
  }
}

pub fn elab_gen_bind_fields(env: List(ElabBinding), names: List(Option(Text)), atoms: List(Nat), types: List(KernelTerm)): List(ElabBinding) {
  match names {
    Nil => env
    Cons(n, rest) => ⊢ List(ElabBinding) from match atoms {
      Nil => env
      Cons(a, more) => ⊢ List(ElabBinding) from match types {
        Nil => env
        Cons(t, ts) => {
          let here := ⊢ List(ElabBinding) from match n {
            None => env
            Some(x) => Cons(ElabBinding::Mk(x, KernelFVar(a), t), env)
          }
          elab_gen_bind_fields(here, rest, more, ts)
        }
      }
    }
  }
}

pub fn elab_plain_rec(recs: List(KernelRecArg), i: Nat): Bool {
  match recs {
    Nil => false
    Cons(r, rest) => (r.arg == i && r.ys == 0) || elab_plain_rec(rest, i)
  }
}

pub fn elab_any_rec(recs: List(KernelRecArg), i: Nat): Bool {
  match recs {
    Nil => false
    Cons(r, rest) => r.arg == i || elab_any_rec(rest, i)
  }
}

// The induction hypotheses of a case of a generalized match, at the motive.
pub fn elab_general_ihs(k: Nat, core: &mut KernelCore, fields: List(Nat), i: Nat, c: KernelCtorInfo, motive: KernelTerm, np: Nat): Option(List(Nat)) {
  match fields {
    Nil => Some(Nil)
    Cons(f, rest) => if elab_plain_rec(c.recursive, i) {
      let at := elab_type_indices(k, &mut core, elab_atom_type(core, f), np)
      let ty := kernel_whnf(k, &mut core, elab_apps(motive, List::append(at, Cons(KernelFVar(f), Nil))), true, false)
      let ih := kernel_fresh(&mut core, ty)
      ⊢ Option(List(Nat)) from match elab_general_ihs(k, &mut core, rest, i + 1, c, motive, np) {
        None => None
        Some(more) => Some(Cons(ih, more))
      }
    } else if elab_any_rec(c.recursive, i) { None } else { elab_general_ihs(k, &mut core, rest, i + 1, c, motive, np) }
  }
}

pub fn elab_without(xs: List(Nat), x: Nat): List(Nat) {
  match xs {
    Nil => Nil
    Cons(y, rest) => if y == x { elab_without(rest, x) } else { Cons(y, elab_without(rest, x)) }
  }
}

pub fn elab_is_prop(k: Nat, core: &mut KernelCore, t: KernelTerm): Bool {
  match kernel_infer(k, &mut core, t) {
    None => false
    Some(s) => ⊢ Bool from match kernel_as_sort(kernel_whnf(k, &mut core, s, true, false)) {
      None => false
      Some(srt) => ⊢ Bool from match srt {
        KernelProp => true
        _ => false
      }
    }
  }
}

// Fresh atoms for the dependent bindings, each at its type with the solved
// variables and the earlier ones replaced; the replacements extended by them.
pub fn elab_prime(core: &mut KernelCore, dep: List(Nat), subs: List(ElabSol)): List(Nat) × List(ElabSol) {
  ⊢ (List(Nat) × List(ElabSol)) from match dep {
    Nil => #(Nil, subs)
    Cons(d, rest) => {
      let ty := elab_replace_all(elab_atom_type(core, d), subs)
      let d2 := kernel_fresh(&mut core, ty)
      let more := elab_prime(&mut core, rest, List::append(subs, Cons(ElabSol::Mk(d, KernelFVar(d2), ty, ty), Nil)))
      #(Cons(d2, more.fst), more.snd)
    }
  }
}

// Universe polymorphism by instantiation: a `def` or
// `theorem` whose leading implicit parameters are typed `Level` is a template.
// A call names its levels first, as numerals, and is read as a call of the
// instance `f@1`, declared the first time it is asked for. Inside the
// template, a level variable stands for its level through a binding of type
// `#Level`, whose value is the sort `Type(u)`.

pub fn elab_unbound(env: List(ElabBinding), name: Text): Bool {
  match elab_lookup(env, name) {
    None => true
    Some(^b) => false
  }
}

pub fn elab_level_marker(): KernelTerm { KernelConst("#Level") }

pub fn elab_level_binding(name: Text, l: KernelLevel): ElabBinding {
  ElabBinding::Mk(name, KernelSortTerm(KernelType(l)), elab_level_marker())
}

pub fn elab_template_key(name: Text): Text { Text::concat("#template ", name) }

pub fn elab_template_count(env: List(ElabBinding), name: Text): Option(Nat) {
  match elab_lookup(env, elab_template_key(name)) {
    None => None
    Some(b) => ⊢ Option(Nat) from match b.value {
      KernelLit(n) => Some(n)
      _ => None
    }
  }
}

// The instance a template name stands for at levels; a constructor of an
// inductive template is the constructor of the family's instance.
pub fn elab_template_target(env: List(ElabBinding), name: Text, ls: List(KernelLevel)): Text {
  match elab_lookup(env, elab_template_key(name)) {
    None => elab_instance_name(name, ls)
    Some(b) => ⊢ Text from match b.ty {
      KernelConst(family) => ⊢ Text from match Text::slice(name, Text::len(family), Text::len(name)) {
        None => elab_instance_name(name, ls)
        Some(suffix) => Text::concat(elab_instance_name(family, ls), suffix)
      }
      _ => elab_instance_name(name, ls)
    }
  }
}

pub fn elab_is_instance(name: Text): Bool {
  match text_find(name, "@", 0) {
    None => false
    // An effect's operations, `e@op`, are a family of their own.
    Some(at) => if text_starts_with(name, "@op", at) { Text::len(name) != at + 3 } else { true }
  }
}

// The modules a declaration is written in, innermost first: what the
// program pushes as `#module M` while it elaborates the module's members.
pub fn elab_modules(env: List(ElabBinding)): List(Text) {
  match env {
    Nil => Nil
    Cons(b, rest) => if b.name == "#module" {
      ⊢ List(Text) from match b.value {
        KernelConst(m) => Cons(m, elab_modules(rest))
        _ => elab_modules(rest)
      }
    } else { elab_modules(rest) }
  }
}

// Whether `q` names something declared or being declared.
pub fn elab_known_name(env: List(ElabBinding), core: KernelCore, q: Text): Bool {
  let declared := ⊢ Bool from match kernel_global_get(core, q) {
    Some(^g) => true
    None => false
  }
  let own := ⊢ Bool from match elab_self(env) {
    Some(me) => me.fst == q
    None => false
  }
  let template := ⊢ Bool from match elab_template_count(env, q) {
    Some(^n) => true
    None => false
  }
  declared || own || template || elab_in_group(env, q)
}

pub fn elab_resolve_in(env: List(ElabBinding), core: KernelCore, ms: List(Text), name: Text): Text {
  match ms {
    Nil => name
    Cons(m, rest) => {
      let q := Text::concat_all(Cons(m, Cons("::", Cons(name, Nil))))
      let private_name := Text::concat_all([m, "::#", name])
      if elab_known_name(env, core, q) { q } else if elab_known_name(env, core, private_name) { private_name } else {
        let aliased := elab_alias_target(env, q)
        if aliased == q { elab_resolve_in(env, core, rest, name) } else { aliased }
      }
    }
  }
}

// A name as a member of the modules it is written in: a binder first, then
// the innermost module's member, then the name as it is.
pub fn elab_aliased_root(env: List(ElabBinding), name: Text): Bool {
  elab_alias_target(env, name) != name
}

pub fn elab_alias_target(env: List(ElabBinding), name: Text): Text {
  match elab_lookup(env, Text::concat("#alias ", name)) {
    Some(b) => ⊢ Text from match b.value {
      KernelConst(full) => full
      _ => name
    }
    None => elab_alias_root_target(env, name)
  }
}

fn elab_alias_root_target(env: List(ElabBinding), name: Text): Text {
  let root := elab_first_name(name)
  ⊢ Text from match elab_lookup(env, Text::concat("#alias ", root)) {
    Some(b) => ⊢ Text from match b.value {
      KernelConst(full) => Text::concat(full, Text::slice_or_empty(name, Text::len(root), Text::len(name)))
      _ => name
    }
    None => name
  }
}

pub fn elab_resolve(env: List(ElabBinding), core: KernelCore, written: Text): Text {
  let name := elab_unprelude(written)
  match elab_lookup(env, name) {
    Some(^local) => name
    None => if elab_aliased_root(env, name) {
      // A type the language has, that an import declares by its file's full name.
      elab_alias_target(env, name)
    } else if text_starts_with(name, "std::prelude::", 0) {
      // The prelude's own names, spelled in full (a product `A × B` is
      // `std::prelude::Pair`), are the names the prelude declares.
      elab_resolve_prelude(env, core, Text::slice_or_empty(name, 14, Text::len(name)))
    } else {
      let r := elab_resolve_in(env, core, elab_modules(env), name)
      if r == name { elab_bare_ctor(core, name) } else { r }
    }
  }
}

// `leaf`, which `std::prelude::leaf` spells, as the prelude declares it: the
// unit's `Star` is `Unit::Star`.
pub fn elab_resolve_prelude(env: List(ElabBinding), core: KernelCore, leaf: Text): Text {
  if leaf == "Star" { "Unit::Star" } else { elab_bare_ctor(core, leaf) }
}

// `Nat::Succ` for the constructor the kernel names `Succ`.
pub fn elab_bare_ctor(core: KernelCore, name: Text): Text {
  match kernel_global_get(core, name) {
    Some(^g) => name
    None => ⊢ Text from match text_find(name, "::", 0) {
      // `Some` for `Option::Some`, when one family has a constructor of
      // that name, as the host selects it. Two families leave it written.
      None => ⊢ Text from match kernel_ctor_get(core, name) {
        Some(^c) => name
        None => {
          let all := elab_ctor_suffixed(Ordmap::entries(core.constructors), Text::concat("::", name))
          ⊢ Text from match all {
            Nil => name
            Cons(only, more) => ⊢ Text from match more {
              Nil => only
              Cons(^second, ^rest) => ⊢ Text from match elab_not_prelude(all) {
                // A program's own family wins over the prelude's, as the host
                // reads a name by the file that declares it first.
                Nil => name
                Cons(own, others) => ⊢ Text from match others {
                  Nil => own
                  Cons(^x, ^xs) => name
                }
              }
            }
          }
        }
      }
      Some(at) => ⊢ Text from match Text::slice(name, at + 2, Text::len(name)) {
        None => name
        Some(leaf) => ⊢ Text from match Text::slice(name, 0, at) {
          None => name
          Some(family) => ⊢ Text from match kernel_ctor_get(core, leaf) {
            Some(c) => if c.fst == family { leaf } else { name }
            None => name
          }
        }
      }
    }
  }
}

// The function an operator is read as, and whether its operands swap: the
// host's sugar, once `Bool` and that function are declared. `+` and `*` stay
// the kernel's; `==` and `!=` are read by the type of their operands.
pub fn elab_operator_table(): List(Text × (Text × Bool)) {
  [#("-", #("Nat::sub", false)), #("<", #("Nat::lt", false)), #("<=", #("Nat::le", false)), #(">", #("Nat::lt", true)), #(">=", #("Nat::le", true)), #("&&", #("Bool::and", false)), #("||", #("Bool::or", false))]
}

pub fn elab_operator_in(core: KernelCore, op: Text, table: List(Text × (Text × Bool))): Option(Text × Bool) {
  match table {
    Nil => None
    Cons(#(o, f), rest) => if o == op {
      ⊢ Option(Text × Bool) from match kernel_global_get(core, f.fst) {
        Some(^g) => Some(f)
        None => None
      }
    } else { elab_operator_in(core, op, rest) }
  }
}

pub fn elab_operator(env: List(ElabBinding), core: KernelCore, op: Text): Option(Text × Bool) {
  if elab_unbound(env, op) {
    ⊢ Option(Text × Bool) from match kernel_ind_get(core, "Bool") {
      None => None
      Some(^b) => elab_operator_in(core, op, elab_operator_table())
    }
  } else { None }
}

// The type written on the next parameter, if any (`?#untyped` is none).
pub fn elab_first_type(types: List(SurfaceTerm)): Option(SurfaceTerm) {
  match types {
    Nil => None
    Cons(t, ^rest) => ⊢ Option(SurfaceTerm) from match t.kind {
      SkHole(n) => if n == "#untyped" { None } else { Some(t) }
      _ => Some(t)
    }
  }
}

pub fn elab_rest_types(types: List(SurfaceTerm)): List(SurfaceTerm) {
  match types {
    Nil => Nil
    Cons(^t, rest) => rest
  }
}

// Whether the arm writes a name bound to the matched variable. An arm that
// does not is elaborated as it was; a form not walked here counts as not.
pub fn elab_mentions_matched(k: Nat, env: List(ElabBinding), body: SurfaceTerm): Bool {
  match elab_lookup(env, "#scrutinee") {
    None => false
    Some(sc) => ⊢ Bool from match sc.value {
      KernelFVar(atom) => elab_mentions_any(k, elab_names_of_atom(env, atom), body)
      _ => false
    }
  }
}

pub fn elab_names_of_atom(env: List(ElabBinding), atom: Nat): List(Text) {
  match env {
    Nil => Nil
    Cons(b, rest) => ⊢ List(Text) from match b.value {
      KernelFVar(a) => if a == atom && b.name != "#scrutinee" { Cons(b.name, elab_names_of_atom(rest, atom)) } else { elab_names_of_atom(rest, atom) }
      _ => elab_names_of_atom(rest, atom)
    }
  }
}

pub fn elab_text_member(xs: List(Text), x: Text): Bool {
  match xs {
    Nil => false
    Cons(y, rest) => y == x || elab_text_member(rest, x)
  }
}

mutual {
  pub fn elab_mentions_any(k: Nat, names: List(Text), t: SurfaceTerm): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match t.kind {
        SkVar(x) => elab_text_member(names, surface_name_text(x))
        SkApp(f, args) => elab_mentions_any(j, names, f) || elab_mentions_list(j, names, args)
        SkAscribe(v, ty) => elab_mentions_any(j, names, v) || elab_mentions_any(j, names, ty)
        SkLam(^ps, b, _, _) => elab_mentions_any(j, names, b)
        SkBlock(stmts) => elab_mentions_stmts(j, names, stmts)
        SkMatch(sc, ^m, arms, ^binder, _) => elab_mentions_any(j, names, sc) || elab_mentions_arms(j, names, arms)
        _ => false
      }
    }
  }

  pub fn elab_mentions_list(k: Nat, names: List(Text), ts: List(SurfaceTerm)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => elab_mentions_any(j, names, t) || elab_mentions_list(j, names, rest)
      }
    }
  }

  pub fn elab_mentions_arms(k: Nat, names: List(Text), arms: List(SurfaceArm)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match arms {
        Nil => false
        Cons(a, rest) => elab_mentions_any(j, names, a.body) || elab_mentions_arms(j, names, rest)
      }
    }
  }

  pub fn elab_mentions_stmts(k: Nat, names: List(Text), stmts: List(SurfaceStmt)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match stmts {
        Nil => false
        Cons(st, rest) => ⊢ Bool from match st {
          StExpr(v) => elab_mentions_any(j, names, v) || elab_mentions_stmts(j, names, rest)
          StLet(^n, ^a, v, ^b, ^m, ^unused, ^st_stack) => elab_mentions_any(j, names, v) || elab_mentions_stmts(j, names, rest)
          _ => elab_mentions_stmts(j, names, rest)
        }
      }
    }
  }
}

// Whether an arm calls the function being defined on a constructor applied to
// something: a call on a constructor rebuilt from the fields of a part.
mutual {
  pub fn elab_ctor_call_in(k: Nat, env: List(ElabBinding), core: KernelCore, name: Text, t: SurfaceTerm): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match t.kind {
        SkApp(f, args) => ⊢ Bool from match f.kind {
          SkVar(x) => ((surface_name_text(x) == name || elab_resolve(env, core, surface_name_text(x)) == name) && elab_any_ctor_app(env, core, args)) || elab_ctor_calls(j, env, core, name, args)
          _ => elab_ctor_call_in(j, env, core, name, f) || elab_ctor_calls(j, env, core, name, args)
        }
        SkAscribe(v, ^ty) => elab_ctor_call_in(j, env, core, name, v)
        SkLam(^ps, b, _, _) => elab_ctor_call_in(j, env, core, name, b)
        SkBlock(stmts) => elab_ctor_stmts(j, env, core, name, stmts)
        SkMatch(sc, ^m, arms, ^binder, _) => elab_ctor_call_in(j, env, core, name, sc) || elab_arms_ctor_call(j, env, core, name, arms)
        _ => false
      }
    }
  }

  pub fn elab_ctor_calls(k: Nat, env: List(ElabBinding), core: KernelCore, name: Text, ts: List(SurfaceTerm)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => elab_ctor_call_in(j, env, core, name, t) || elab_ctor_calls(j, env, core, name, rest)
      }
    }
  }

  pub fn elab_arms_ctor_call(k: Nat, env: List(ElabBinding), core: KernelCore, name: Text, arms: List(SurfaceArm)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match arms {
        Nil => false
        Cons(a, rest) => elab_ctor_call_in(j, env, core, name, a.body) || elab_arms_ctor_call(j, env, core, name, rest)
      }
    }
  }

  pub fn elab_ctor_stmts(k: Nat, env: List(ElabBinding), core: KernelCore, name: Text, stmts: List(SurfaceStmt)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match stmts {
        Nil => false
        Cons(st, rest) => ⊢ Bool from match st {
          StExpr(v) => elab_ctor_call_in(j, env, core, name, v) || elab_ctor_stmts(j, env, core, name, rest)
          StLet(^n, ^a, v, ^b, ^m, ^unused, ^st_stack) => elab_ctor_call_in(j, env, core, name, v) || elab_ctor_stmts(j, env, core, name, rest)
          _ => elab_ctor_stmts(j, env, core, name, rest)
        }
      }
    }
  }
}

pub fn elab_any_ctor_app(env: List(ElabBinding), core: KernelCore, args: List(SurfaceTerm)): Bool {
  match args {
    Nil => false
    Cons(a, rest) => ⊢ Bool from match a.kind {
      SkApp(f, ^inner) => ⊢ Bool from match f.kind {
        SkVar(x) => ⊢ Bool from match kernel_ctor_get(core, elab_resolve(env, core, surface_name_text(x))) {
          Some(^c) => true
          None => elab_any_ctor_app(env, core, rest)
        }
        _ => elab_any_ctor_app(env, core, rest)
      }
      _ => elab_any_ctor_app(env, core, rest)
    }
  }
}

// The bindings with the matched variable (`#scrutinee`) as their value
// given `built`, the constructor of the arm applied to its fields. As the
// host reads a declaration by its outermost match, only that match does so:
// `#scrutinee` becomes `#matched` inside its arms.
pub fn elab_refined(all: List(ElabBinding), env: List(ElabBinding), built: KernelTerm, refine: Bool): List(ElabBinding) {
  match elab_lookup(all, "#scrutinee") {
    None => env
    Some(sc) => ⊢ List(ElabBinding) from match sc.value {
      KernelFVar(atom) => elab_refine_atom(env, atom, built, refine)
      _ => env
    }
  }
}

pub fn elab_refine_atom(env: List(ElabBinding), atom: Nat, built: KernelTerm, refine: Bool): List(ElabBinding) {
  match env {
    Nil => Nil
    Cons(b, rest) => {
      let tail := elab_refine_atom(rest, atom, built, refine)
      if b.name == "#scrutinee" { Cons(ElabBinding::Mk("#matched", b.value, b.ty), tail) } else {
        ⊢ List(ElabBinding) from match b.value {
          KernelFVar(a) => if refine && a == atom { Cons(ElabBinding::Mk(b.name, built, b.ty), tail) } else { Cons(b, tail) }
          _ => Cons(b, tail)
        }
      }
    }
  }
}

pub fn elab_equality_function(ty: KernelTerm): Option(Text) {
  match ty {
    KernelConst(n) => if n == "Nat" { Some("Nat::eq") } else if n == "Bool" { Some("Bool::eq") } else if n == "Text" { Some("Text::eq") } else { None }
    _ => None
  }
}

// Whether `head` is a name a `let` bound to a λ.
pub fn elab_let_lambda(env: List(ElabBinding), head: SurfaceTerm): Bool {
  match head.kind {
    SkVar(n) => ⊢ Bool from match elab_lookup(env, surface_name_text(n)) {
      None => false
      Some(b) => ⊢ Bool from match b.value {
        KernelLam(^body, ^d) => true
        _ => false
      }
    }
    _ => false
  }
}

// The head redex of an application of a λ.
pub fn elab_beta(k: Nat, t: KernelTerm): KernelTerm {
  match k {
    Zero => t
    Succ(j) => ⊢ KernelTerm from match t {
      KernelApp(f, a, ^d) => ⊢ KernelTerm from match elab_beta(j, f) {
        KernelLam(body, ^e) => kernel_inst(body, a)
        g => kernel_app(g, a)
      }
      _ => t
    }
  }
}

pub fn elab_eta_eq(f: KernelTerm): KernelTerm {
  match f {
    KernelApp(^g, ^a, ^d) => kernel_lam(kernel_lam(elab_apps(f, [KernelBVar(1), KernelBVar(0)])))
    _ => f
  }
}

// The equality of a type applied to types: `F::beq` with its arguments and
// their equalities.
mutual {
pub fn elab_eq_fun(k: Nat, core: &mut KernelCore, ty: KernelTerm): Option(KernelTerm) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(KernelTerm) from match elab_equality_function(ty) {
      Some(f) => Some(KernelConst(f))
      None => {
        let sp := elab_spine(j, ty, Nil)
        ⊢ Option(KernelTerm) from match sp.fst {
          KernelConst(fam) => ⊢ Option(KernelTerm) from match kernel_global_get(core, Text::concat(fam, "::beq")) {
            None => None
            Some(^g) => ⊢ Option(KernelTerm) from match elab_eq_funs(j, &mut core, sp.snd) {
              None => None
              Some(eqs) => Some(elab_apps(KernelConst(Text::concat(fam, "::beq")), List::append(sp.snd, eqs)))
            }
          }
          _ => None
        }
      }
    }
  }
}

pub fn elab_eq_funs(k: Nat, core: &mut KernelCore, tys: List(KernelTerm)): Option(List(KernelTerm)) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(List(KernelTerm)) from match tys {
      Nil => Some(Nil)
      Cons(t, rest) => ⊢ Option(List(KernelTerm)) from match elab_eq_fun(j, &mut core, t) {
        None => None
        Some(f0) => ⊢ Option(List(KernelTerm)) from match elab_eq_funs(j, &mut core, rest) {
          None => None
          // As the host: the equality of an applied type, given as an
          // argument, is a function of two values.
          Some(fs) => Some(Cons(elab_eta_eq(f0), fs))
        }
      }
    }
  }
}

}

// The term with its head name resolved in its modules, when that changes it.
// The constructor of a family with one constructor, then its fields' names.
pub fn elab_record_fields(env: List(ElabBinding), core: KernelCore, family: Text): Option(List(Text)) {
  match elab_lookup(env, Text::concat("#fields ", elab_resolve(env, core, family))) {
    None => None
    Some(b) => Some(elab_names_of(b.value))
  }
}

// `match v { C(_, …, f, …, _) => f }`.
pub fn elab_field_match(v: SurfaceTerm, ctor: Text, fields: List(Text), field: Text, start: Nat, end: Nat): SurfaceTerm {
  let names := elab_field_binders(fields, 0)
  let at := elab_text_index(fields, field, 0)
  let pick := ⊢ Text from match elab_nth_text(names, at) {
    Some(n) => n
    None => field
  }
  surface_term_mk(
    SkMatch(v, None, [SurfaceArm::SurfaceArmMk(PtCtor(NameSpelled(ctor), elab_binder_patterns(names)), None, None, surface_term_mk(SkVar(NameSpelled(pick)), start, end))], None, None),
    start,
    end
  )
}

pub fn elab_field_binders(fields: List(Text), i: Nat): List(Text) {
  match fields {
    Nil => Nil
    Cons(^f, rest) => Cons(Text::concat("f@", Text::of_nat(i)), elab_field_binders(rest, i + 1))
  }
}

pub fn elab_binder_patterns(names: List(Text)): List(SurfacePattern) {
  match names {
    Nil => Nil
    Cons(n, rest) => Cons(PtBind(n, None), elab_binder_patterns(rest))
  }
}

pub fn elab_nth_text(xs: List(Text), i: Nat): Option(Text) {
  match xs {
    Nil => None
    Cons(x, rest) => ⊢ Option(Text) from match i {
      Zero => Some(x)
      Succ(m) => elab_nth_text(rest, m)
    }
  }
}

// A record pattern `T { f: p, g }` is the constructor's pattern with each
// field's pattern in the constructor's order, a field not named `_`.
mutual {
  pub fn elab_record_pattern(k: Nat, env: List(ElabBinding), core: KernelCore, p: SurfacePattern): SurfacePattern {
    match k {
      Zero => p
      Succ(j) => ⊢ SurfacePattern from match p {
        PtRecord(name, fields) => ⊢ SurfacePattern from match elab_record_fields(env, core, name) {
          Some(Cons(ctor, names)) => PtCtor(NameSpelled(ctor), elab_field_patterns(j, env, core, names, fields))
          _ => p
        }
        PtCtor(name, args) => PtCtor(name, elab_record_patterns(j, env, core, args))
        _ => p
      }
    }
  }

  pub fn elab_record_patterns(k: Nat, env: List(ElabBinding), core: KernelCore, ps: List(SurfacePattern)): List(SurfacePattern) {
    match k {
      Zero => ps
      Succ(j) => ⊢ List(SurfacePattern) from match ps {
        Nil => Nil
        Cons(q, rest) => Cons(elab_record_pattern(j, env, core, q), elab_record_patterns(j, env, core, rest))
      }
    }
  }

  pub fn elab_field_patterns(k: Nat, env: List(ElabBinding), core: KernelCore, names: List(Text), fields: List(SurfacePatternField)): List(SurfacePattern) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePattern) from match names {
        Nil => Nil
        Cons(n, rest) => Cons(elab_field_pattern(j, env, core, n, fields), elab_field_patterns(j, env, core, rest, fields))
      }
    }
  }

  pub fn elab_field_pattern(k: Nat, env: List(ElabBinding), core: KernelCore, name: Text, fields: List(SurfacePatternField)): SurfacePattern {
    match k {
      Zero => PtWild
      Succ(j) => ⊢ SurfacePattern from match fields {
        Nil => PtWild
        Cons(f, rest) => ⊢ SurfacePattern from match f {
          SurfacePatternFieldMk(n, q) => if n == name { elab_record_pattern(j, env, core, q) } else { elab_field_pattern(j, env, core, name, rest) }
        }
      }
    }
  }
}

pub fn elab_record_arms(env: List(ElabBinding), core: KernelCore, arms: List(SurfaceArm)): List(SurfaceArm) {
  match arms {
    Nil => Nil
    Cons(a, rest) => Cons(SurfaceArm::SurfaceArmMk(elab_record_pattern(64, env, core, a.pattern), a.guard, a.goal, a.body), elab_record_arms(env, core, rest))
  }
}

// `T { f: e, … }` is the constructor of `T` applied to the fields in its order.
pub fn elab_record_term(env: List(ElabBinding), core: KernelCore, family: Text, fields: List(SurfaceField), term: SurfaceTerm): Option(SurfaceTerm) {
  match elab_record_fields(env, core, family) {
    Some(Cons(ctor, names)) => ⊢ Option(SurfaceTerm) from match elab_field_values(names, fields) {
      None => None
      Some(args) => Some(surface_term_mk(SkApp(surface_term_mk(SkVar(NameSpelled(ctor)), term.start, term.start), args), term.start, term.end))
    }
    _ => None
  }
}

pub fn elab_field_values(names: List(Text), fields: List(SurfaceField)): Option(List(SurfaceTerm)) {
  match names {
    Nil => Some(Nil)
    Cons(n, rest) => ⊢ Option(List(SurfaceTerm)) from match elab_field_value(n, fields) {
      None => None
      Some(v) => ⊢ Option(List(SurfaceTerm)) from match elab_field_values(rest, fields) {
        None => None
        Some(vs) => Some(Cons(v, vs))
      }
    }
  }
}

pub fn elab_field_value(name: Text, fields: List(SurfaceField)): Option(SurfaceTerm) {
  match fields {
    Nil => None
    Cons(f, rest) => ⊢ Option(SurfaceTerm) from match f {
      SurfaceFieldMk(n, v) => if n == name { Some(v) } else { elab_field_value(name, rest) }
    }
  }
}

pub fn elab_resolved(env: List(ElabBinding), core: KernelCore, term: SurfaceTerm): Option(SurfaceTerm) {
  match term.kind {
    SkRecord(family, fields) => if text_starts_with(family, "@", 0) { None } else { elab_record_term(env, core, family, fields, term) }
    SkApp(head, args) => ⊢ Option(SurfaceTerm) from match elab_operator_call(env, core, head, args, term) {
      Some(t) => Some(t)
      None => elab_resolved_name(env, core, term)
    }
    _ => elab_resolved_name(env, core, term)
  }
}

// `a < b` as `Nat::lt(a, b)`, `a > b` as `Nat::lt(b, a)`.
pub fn elab_operator_call(env: List(ElabBinding), core: KernelCore, head: SurfaceTerm, args: List(SurfaceTerm), term: SurfaceTerm): Option(SurfaceTerm) {
  match head.kind {
    SkVar(op) => ⊢ Option(SurfaceTerm) from match args {
      Cons(a, Cons(b, Nil)) => ⊢ Option(SurfaceTerm) from match elab_operator(env, core, surface_name_text(op)) {
        None => None
        Some(f) => Some(surface_term_mk(SkApp(surface_term_mk(SkVar(NameSpelled(f.fst)), head.start, head.end), if f.snd { [b, a] } else { [a, b] }), term.start, term.end))
      }
      _ => None
    }
    _ => None
  }
}

pub fn elab_resolved_name(env: List(ElabBinding), core: KernelCore, term: SurfaceTerm): Option(SurfaceTerm) {
  match term.kind {
    SkVar(n) => {
      let r := elab_resolve(env, core, surface_name_text(n))
      if r == surface_name_text(n) { None } else { Some(surface_term_mk(SkVar(NameSpelled(r)), term.start, term.end)) }
    }
    SkApp(head, args) => ⊢ Option(SurfaceTerm) from match head.kind {
      SkVar(n) => {
        let r := elab_resolve(env, core, surface_name_text(n))
        if r == surface_name_text(n) { None } else { Some(surface_term_mk(SkApp(surface_term_mk(SkVar(NameSpelled(r)), head.start, head.end), args), term.start, term.end)) }
      }
      _ => None
    }
    _ => None
  }
}


// The names of a declaration's implicit parameters, recorded as
// `#implicit-names f` with each name a constant of a telescope of `Lit`s.
pub fn elab_implicit_names(env: List(ElabBinding), name: Text): List(Text) {
  match elab_lookup(env, Text::concat("#implicit-names ", name)) {
    None => Nil
    Some(b) => elab_names_of(b.value)
  }
}

pub fn elab_class_field(names: List(Text), arity: Nat, field: Text, i: Nat): Text {
  match names {
    Nil => field
    Cons(n, rest) => ⊢ Text from match arity {
      Zero => field
      Succ(more) => if field == Text::concat("@class", Text::of_nat(i)) { n } else {
        elab_class_field(rest, more, field, i + 1)
      }
    }
  }
}

pub fn elab_class_fields_in(names: List(Text), arity: Nat, fields: List(SurfaceField)): List(SurfaceField) {
  match fields {
    Nil => Nil
    Cons(f, rest) => Cons(
      SurfaceField { name: elab_class_field(names, arity, f.name, 0), value: f.value },
      elab_class_fields_in(names, arity, rest)
    )
  }
}

// `C(T)::m(…)`: the class's arguments, by place (`@class0`, …), lead the
// implicit parameters of its methods and laws, so each is named as the
// parameter at its place. Another name, or a call of anything else, is kept.
pub fn elab_class_fields(env: List(ElabBinding), name: Text, fields: List(SurfaceField)): List(SurfaceField) {
  match elab_member_of(env, name) {
    None => fields
    Some(m) => elab_class_fields_in(elab_implicit_names(env, name), m.fst.snd, fields)
  }
}

pub fn elab_names_of(t: KernelTerm): List(Text) {
  match t {
    KernelApp(f, a, ^d) => ⊢ List(Text) from match a {
      KernelConst(n) => List::append(elab_names_of(f), Cons(n, Nil))
      _ => elab_names_of(f)
    }
    _ => Nil
  }
}

pub fn elab_names_term(ns: List(Text)): KernelTerm {
  elab_apps(KernelLit(0), elab_name_consts(ns))
}

pub fn elab_name_consts(ns: List(Text)): List(KernelTerm) {
  match ns {
    Nil => Nil
    Cons(n, rest) => Cons(KernelConst(n), elab_name_consts(rest))
  }
}

pub fn elab_hole_named(names: List(Text), holes: List(Nat), n: Text): Option(Nat) {
  match names {
    Nil => None
    Cons(m, rest) => ⊢ Option(Nat) from match holes {
      Nil => None
      Cons(h, hs) => if m == n { Some(h) } else { elab_hole_named(rest, hs, n) }
    }
  }
}

pub fn elab_take_surface(xs: List(SurfaceTerm), n: Nat): List(SurfaceTerm) {
  match n {
    Zero => Nil
    Succ(m) => ⊢ List(SurfaceTerm) from match xs {
      Nil => Nil
      Cons(x, rest) => Cons(x, elab_take_surface(rest, m))
    }
  }
}

pub fn elab_drop_surface(xs: List(SurfaceTerm), n: Nat): List(SurfaceTerm) {
  match n {
    Zero => xs
    Succ(m) => ⊢ List(SurfaceTerm) from match xs {
      Nil => Nil
      Cons(^x, rest) => elab_drop_surface(rest, m)
    }
  }
}

// A level written as a numeral, `a + b` or `max(a, b)` of such.
pub fn elab_const_level(k: Nat, t: SurfaceTerm): Option(Nat) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(Nat) from match t.kind {
      SkNat(digits) => text_parse_u64(digits)
      SkApp(head, args) => ⊢ Option(Nat) from match head.kind {
        SkVar(op) => ⊢ Option(Nat) from match args {
          Cons(a, more) => ⊢ Option(Nat) from match more {
            Cons(b, none) => ⊢ Option(Nat) from match elab_const_level(j, a) {
              None => None
              Some(x) => ⊢ Option(Nat) from match elab_const_level(j, b) {
                None => None
                Some(y) => if List::length(none) != 0 { None } else if surface_name_text(op) == "+" { Some(x + y) } else if surface_name_text(op) == "max" { Some(Nat::max(x, y)) } else { None }
              }
            }
            Nil => None
          }
          Nil => None
        }
        _ => None
      }
      _ => None
    }
  }
}

pub fn elab_const_levels(k: Nat, ts: List(SurfaceTerm)): Option(List(Nat)) {
  match ts {
    Nil => Some(Nil)
    Cons(t, rest) => ⊢ Option(List(Nat)) from match elab_const_level(k, t) {
      None => None
      Some(n) => ⊢ Option(List(Nat)) from match elab_const_levels(k, rest) {
        None => None
        Some(ns) => Some(Cons(n, ns))
      }
    }
  }
}

pub fn elab_var_texts(vs: List(Text × Nat)): List(Text) {
  match vs {
    Nil => Nil
    Cons(v, rest) => Cons(",", Cons(v.fst, Cons("+", Cons(Text::of_nat(v.snd), elab_var_texts(rest)))))
  }
}

// A level as it is written in an instance name: a numeral, or, for a level
// over variables (only while a template is checked), its normal form.
pub fn elab_level_text(l: KernelLevel): List(Text) {
  match l.variables {
    Nil => Cons(Text::of_nat(l.constant), Nil)
    _ => Cons("max(", Cons(Text::of_nat(l.constant), List::append(elab_var_texts(l.variables), Cons(")", Nil))))
  }
}

pub fn elab_level_texts(ls: List(KernelLevel)): List(Text) {
  match ls {
    Nil => Nil
    Cons(l, rest) => ⊢ List(Text) from match rest {
      Nil => elab_level_text(l)
      _ => List::append(elab_level_text(l), Cons(",", elab_level_texts(rest)))
    }
  }
}

// The instance of a template at levels: `f@1`, `f@0,1`.
pub fn elab_instance_name(name: Text, ls: List(KernelLevel)): Text {
  Text::concat_all(Cons(name, Cons("@", elab_level_texts(ls))))
}

pub fn elab_level_up(l: KernelLevel, n: Nat): KernelLevel {
  match n {
    Zero => l
    Succ(m) => elab_level_up(kernel_level_next(l), m)
  }
}

// A level over the level variables in scope.
pub fn elab_level(k: Nat, env: List(ElabBinding), t: SurfaceTerm): Option(KernelLevel) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(KernelLevel) from match t.kind {
      SkNat(digits) => ⊢ Option(KernelLevel) from match text_parse_u64(digits) {
        None => None
        Some(n) => Some(KernelLevel::Mk(n, Nil))
      }
      SkVar(x) => ⊢ Option(KernelLevel) from match elab_lookup(env, surface_name_text(x)) {
        None => None
        Some(b) => ⊢ Option(KernelLevel) from match b.ty {
          KernelConst(m) => if m == "#Level" {
            ⊢ Option(KernelLevel) from match b.value {
              KernelSortTerm(s) => ⊢ Option(KernelLevel) from match s {
                KernelType(l) => Some(l)
                KernelProp => None
              }
              _ => None
            }
          } else { None }
          _ => None
        }
      }
      SkApp(head, args) => ⊢ Option(KernelLevel) from match head.kind {
        SkVar(op) => ⊢ Option(KernelLevel) from match args {
          Cons(a, more) => ⊢ Option(KernelLevel) from match more {
            Cons(b, none) => if List::length(none) != 0 { None } else if surface_name_text(op) == "+" {
              ⊢ Option(KernelLevel) from match elab_level(j, env, a) {
                None => None
                Some(l) => ⊢ Option(KernelLevel) from match elab_const_level(j, b) {
                  None => None
                  Some(n) => Some(elab_level_up(l, n))
                }
              }
            } else if surface_name_text(op) == "max" {
              ⊢ Option(KernelLevel) from match elab_level(j, env, a) {
                None => None
                Some(l) => ⊢ Option(KernelLevel) from match elab_level(j, env, b) {
                  None => None
                  Some(r) => Some(kernel_level_join(l, r))
                }
              }
            } else { None }
            Nil => None
          }
          Nil => None
        }
        _ => None
      }
      _ => None
    }
  }
}

pub fn elab_levels(k: Nat, env: List(ElabBinding), ts: List(SurfaceTerm)): Option(List(KernelLevel)) {
  match ts {
    Nil => Some(Nil)
    Cons(t, rest) => ⊢ Option(List(KernelLevel)) from match elab_level(k, env, t) {
      None => None
      Some(l) => ⊢ Option(List(KernelLevel)) from match elab_levels(k, env, rest) {
        None => None
        Some(ls) => Some(Cons(l, ls))
      }
    }
  }
}

mutual {
  pub fn elab_term(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    term: SurfaceTerm,
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match elab_resolved(env, core, term) {
       Some(t) => elab_term(j, &mut core, env, t, expected)
       None => ⊢ ElabResult(ElabTyped) from match term.kind {
        SkVar(name) => ⊢ ElabResult(ElabTyped) from match elab_lookup(env, surface_name_text(name)) {
          Some(local) => elab_known(j, &mut core, local, expected)
          None => ⊢ ElabResult(ElabTyped) from match kernel_global_get(core, surface_name_text(name)) {
            Some(^global) => if elab_implicit_count(env, core, surface_name_text(name)) == 0 {
              elab_result(j, &mut core, KernelConst(surface_name_text(name)), expected)
            } else { elab_implicit_application(j, &mut core, env, surface_name_text(name), Nil, expected) }
            None => ⊢ ElabResult(ElabTyped) from match elab_sort(surface_name_text(name)) {
              Some(sort) => elab_result(j, &mut core, sort, expected)
              None => ⊢ ElabResult(ElabTyped) from match elab_result(j, &mut core, KernelConst(surface_name_text(name)), expected) {
                ElabOk(t) => ElabOk(t)
                ElabErr(^e) => ElabErr(elab_undeclared(env, surface_name_text(name)))
              }
            }
          }
        }
        SkNat(digits) => ⊢ ElabResult(ElabTyped) from match elab_parse_nat(digits) {
          None => ElabErr(Text::concat_all(["`", digits, "` is not a natural literal"]))
          Some(n) => elab_result(j, &mut core, KernelLit(n), expected)
        }
        SkBool(value) => elab_result(
          j,
          &mut core,
          KernelConst(if value { "true" } else { "false" }),
          expected
        )
        SkPi(params, result, effects) => ⊢ ElabResult(ElabTyped) from match effects {
          Some(^es) => ElabErr("effect rows are unsupported")
          None => ⊢ ElabResult(ElabTyped) from match elab_pi(j, &mut core, env, params, result) {
            ElabErr(e) => ElabErr(e)
            ElabOk(p) => elab_result(j, &mut core, p, expected)
          }
        }
        SkLam(params, body, _, _) => ⊢ ElabResult(ElabTyped) from match expected {
          None => ElabErr("lambda requires an expected type")
          Some(ty) => elab_lambda(j, &mut core, env, params, Nil, body, ty)
        }
        // A shared borrow, `&T` in a type and `&x` in a term, is the value it
        // borrows: ownership is checked before the kernel, and a borrow's
        // place in a type or a proof is erased.
        SkBorrow(mutable, ^mutable_orig, value) => if mutable { ElabErr("not a kernel term: `&mut` borrow") } else {
          elab_term(j, &mut core, env, value, expected)
        }
        // `(e: T)`: `e` checked against `T`.
        SkAscribe(value, ty) => elab_annotation(j, &mut core, env, [ty, value], expected)
        SkBorrowLam(r#borrows, lam) => if elab_borrows_mutable(r#borrows) {
          ElabErr("not a kernel term: λ with a `&mut` parameter")
        } else { elab_term(j, &mut core, env, lam, expected) }
        SkApp(head, args) => ⊢ ElabResult(ElabTyped) from match head.kind {
          SkVar(name) => ⊢ ElabResult(ElabTyped) from match elab_template_count(env, surface_name_text(name)) {
           Some(n) => ⊢ ElabResult(ElabTyped) from match elab_levels(j, env, elab_take_surface(args, n)) {
            None => ElabErr("the levels of a call of a level-polymorphic declaration are levels: numerals, level variables, `l + n` or `max(l, l)`")
            Some(ls) => if List::length(ls) != n { ElabErr("a call of a level-polymorphic declaration must write all its levels") } else {
              let callee := surface_term_mk(SkVar(NameSpelled(elab_template_target(env, surface_name_text(name), ls))), head.start, head.end)
              let rest := elab_drop_surface(args, n)
              ⊢ ElabResult(ElabTyped) from match rest {
                Nil => elab_term(j, &mut core, env, callee, expected)
                _ => elab_term(j, &mut core, env, surface_term_mk(SkApp(callee, rest), term.start, term.end), expected)
              }
            }
           }
           None => if surface_name_text(name) == "Type" && elab_unbound(env, surface_name_text(name)) {
            ⊢ ElabResult(ElabTyped) from match args {
              Cons(a, none) => ⊢ ElabResult(ElabTyped) from match elab_level(j, env, a) {
                None => ElabErr("a universe level is a numeral, a level variable, `l + n` or `max(l, l)`")
                Some(l) => if List::length(none) != 0 { ElabErr("`Type` takes one level") } else { elab_result(j, &mut core, KernelSortTerm(KernelType(l)), expected) }
              }
              Nil => ElabErr("`Type` takes one level")
            }
          } else if surface_name_text(name) == "=" && elab_unbound(env, surface_name_text(name)) {
            elab_equation(j, &mut core, env, args, expected)
          } else if surface_name_text(name) == "#typed_lam" {
            elab_typed_lambda(j, &mut core, env, args, expected)
          } else if (surface_name_text(name) == "==" || surface_name_text(name) == "!=") && elab_unbound(env, surface_name_text(name)) {
            elab_equality(j, &mut core, env, surface_name_text(name) == "!=", args, expected)
          } else if surface_name_text(name) == "#the" {
            elab_annotation(j, &mut core, env, args, expected)
          } else if surface_name_text(name) == "the" {
            ⊢ ElabResult(ElabTyped) from match elab_lookup(env, surface_name_text(name)) {
              Some(^local) => elab_application(j, &mut core, env, head, args, expected)
              None => ⊢ ElabResult(ElabTyped) from match kernel_global_get(core, surface_name_text(name)) {
                Some(^global) => elab_application(j, &mut core, env, head, args, expected)
                None => elab_annotation(j, &mut core, env, args, expected)
              }
            }
          } else {
            if elab_in_group(env, surface_name_text(name)) { elab_recursive_call(j, &mut core, env, surface_name_text(name), args, expected) } else { ⊢ ElabResult(ElabTyped) from match elab_self(env) {
              Some(me) => if me.fst == surface_name_text(name) { elab_recursive_call(j, &mut core, env, surface_name_text(name), args, expected) } else {
                if elab_wants_implicit(env, core, surface_name_text(name)) { elab_implicit_application(j, &mut core, env, surface_name_text(name), args, expected) } else { elab_application(j, &mut core, env, head, args, expected) }
              }
              None => if elab_wants_implicit(env, core, surface_name_text(name)) { elab_implicit_application(j, &mut core, env, surface_name_text(name), args, expected) } else { elab_application(j, &mut core, env, head, args, expected) }
            } }
          }
          }
          _ => elab_application(j, &mut core, env, head, args, expected)
        }
        SkBlock(stmts) => elab_block(j, &mut core, env, stmts, expected)
        SkMatch(scrutinee, motive, arms, binder, _) => ⊢ ElabResult(ElabTyped) from match motive {
          // `match x: T { … }`: the result type is written; the motive is
          // `T` with `x` abstracted, and the whole is checked at `expected`.
          Some(m) => ⊢ ElabResult(ElabTyped) from match binder {
            Some(^b) => ElabErr("a match binder is unsupported")
            None => ⊢ ElabResult(ElabTyped) from match elab_type(j, &mut core, env, m) {
              ElabErr(e) => ElabErr(e)
              ElabOk(ty) => ⊢ ElabResult(ElabTyped) from match elab_match(j, &mut core, env, scrutinee, arms, ty) {
                ElabErr(e) => ElabErr(e)
                ElabOk(t) => elab_known(j, &mut core, t, expected)
              }
            }
          }
          None => ⊢ ElabResult(ElabTyped) from match binder {
            Some(^b) => ElabErr("a match binder is unsupported")
            None => ⊢ ElabResult(ElabTyped) from match expected {
              None => ElabErr("a match requires an expected type")
              Some(ty) => elab_match(j, &mut core, env, scrutinee, arms, ty)
            }
          }
        }
        // As the host: a text literal is `Text::Mk` of its bytes, when the
        // kernel has `Text` with that one constructor.
        SkText(value) => ⊢ ElabResult(ElabTyped) from match kernel_ind_get(core, "Text") {
          None => ElabErr("a text literal needs `Text`, which is not declared")
          Some(info) => if List::length(info.constructors) == 1 && elab_has_global(core, "Text::Mk") {
            elab_result(j, &mut core, elab_apps(KernelConst("Text::Mk"), [elab_text_bytes(value, 0, Text::len(value))]), expected)
          } else { ElabErr("a text literal needs `Text` with one constructor `Mk`") }
        }
        // `x.f` of a family with one constructor is the match that takes the
        // field out, as the host reads it.
        SkField(value, field) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, value, None) {
          ElabErr(e) => ElabErr(e)
          ElabOk(t) => ⊢ ElabResult(ElabTyped) from match elab_spine(j, kernel_whnf(j, &mut core, t.ty, true, false), Nil).fst {
            KernelConst(family) => ⊢ ElabResult(ElabTyped) from match elab_record_fields(env, core, family) {
              None => ElabErr("a field is read from a value of a family with one constructor")
              Some(names) => ⊢ ElabResult(ElabTyped) from match names {
                Nil => ElabErr("a field is read from a value of a family with one constructor")
                Cons(ctor, fields) => if elab_text_member(fields, field) == false { ElabErr(Text::concat_all(["`", family, "` has no field `", field, "`"])) } else {
                  elab_term(j, &mut core, env, elab_field_match(value, ctor, fields, field, term.start, term.end), expected)
                }
              }
            }
            _ => ElabErr("a field is read from a value of a family")
          }
        }
        SkHole(^name) => ElabErr("proof hole is not a completed term")
        SkOther(what) => ElabErr(Text::concat_all(["unsupported term form: ", what]))
        SkMacroCall(m, ^a) => ElabErr(Text::concat_all(["the macro `", m, "!` is unsupported"]))
        _ => ElabErr("unsupported term form")
      }
       }
    }
  }

  pub fn elab_type(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    term: SurfaceTerm
  ): ElabResult(KernelTerm) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(KernelTerm) from match elab_term(j, &mut core, env, term, None) {
        ElabErr(e) => ElabErr(e)
        ElabOk(t) => ⊢ ElabResult(KernelTerm) from match kernel_as_sort(
          kernel_whnf(j, &mut core, t.ty, true, false)
        ) {
          None => ElabErr("expected a type")
          Some(^s) => ElabOk(t.value)
        }
      }
    }
  }

  pub fn elab_pi(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    params: List(SurfaceParam),
    result: SurfaceTerm
  ): ElabResult(KernelTerm) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(KernelTerm) from match params {
        Nil => elab_type(j, &mut core, env, result)
        Cons(p, rest) => ⊢ ElabResult(KernelTerm) from match elab_type(j, &mut core, env, p.ty) {
          ElabErr(e) => ElabErr(e)
          ElabOk(domain) => {
            let saved := core.locals
            let atom := kernel_fresh(&mut core, domain)
            let locals := ⊢ List(ElabBinding) from match p.name {
              None => env
              Some(name) => Cons(ElabBinding::Mk(name, KernelFVar(atom), domain), env)
            }
            let body := elab_pi(j, &mut core, locals, rest, result)
            kernel_set_to(&mut core.locals, saved)
            ⊢ ElabResult(KernelTerm) from match body {
              ElabErr(e) => ElabErr(e)
              ElabOk(codomain) => ElabOk(kernel_pi(domain, kernel_abstract_at(codomain, 0, atom)))
            }
          }
        }
      }
    }
  }

  pub fn elab_lambda(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    params: List(Text),
    types: List(SurfaceTerm),
    body: SurfaceTerm,
    expected: KernelTerm
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match params {
        Nil => elab_term(j, &mut core, env, body, Some(expected))
        Cons(name, rest) => ⊢ ElabResult(ElabTyped) from match kernel_as_pi(
          kernel_whnf(j, &mut core, expected, true, false)
        ) {
          None => ElabErr("lambda expected a function type")
          Some(dc) => ⊢ ElabResult(ElabTyped) from match elab_param_type_holds(j, &mut core, env, name, elab_first_type(types), dc.fst) {
           Some(e) => ElabErr(e)
           None => {
            let domain := dc.fst
            let codomain := dc.snd
            let saved := core.locals
            let atom := kernel_fresh(&mut core, domain)
            let tail := elab_lambda(
              j,
              &mut core,
              Cons(ElabBinding::Mk(name, KernelFVar(atom), domain), env),
              rest,
              elab_rest_types(types),
              body,
              kernel_inst(codomain, KernelFVar(atom))
            )
            kernel_set_to(&mut core.locals, saved)
            ⊢ ElabResult(ElabTyped) from match tail {
              ElabErr(e) => ElabErr(e)
              ElabOk(t) => elab_result(
                j,
                &mut core,
                kernel_lam(kernel_abstract_at(t.value, 0, atom)),
                Some(expected)
              )
            }
           }
          }
        }
      }
    }
  }

  // `a = b`: `Eq(A, a, b)` at the type of whichever side gives one, the
  // other checked at it.
  pub fn elab_equation(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    args: List(SurfaceTerm),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match args {
        Cons(l, rest) => ⊢ ElabResult(ElabTyped) from match rest {
          Cons(r, more) => ⊢ ElabResult(ElabTyped) from match more {
            Nil => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, l, None) {
              ElabOk(lt) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, r, Some(lt.ty)) {
                ElabErr(e) => ElabErr(e)
                ElabOk(rt) => elab_result(j, &mut core, elab_eq(lt.ty, lt.value, rt.value), expected)
              }
              ElabErr(e) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, r, None) {
                ElabErr(^e2) => ElabErr(e)
                ElabOk(rt) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, l, Some(rt.ty)) {
                  ElabErr(e3) => ElabErr(e3)
                  ElabOk(lt) => elab_result(j, &mut core, elab_eq(rt.ty, lt.value, rt.value), expected)
                }
              }
            }
            _ => ElabErr("`=` takes two sides")
          }
          _ => ElabErr("`=` takes two sides")
        }
        _ => ElabErr("`=` takes two sides")
      }
    }
  }

  pub fn elab_annotation(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    args: List(SurfaceTerm),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match args {
        Cons(ty, rest) => ⊢ ElabResult(ElabTyped) from match rest {
          Cons(value, more) => ⊢ ElabResult(ElabTyped) from match more {
            Nil => ⊢ ElabResult(ElabTyped) from match elab_type(j, &mut core, env, ty) {
              ElabErr(e) => ElabErr(e)
              ElabOk(written) => ⊢ ElabResult(ElabTyped) from match elab_term(
                j,
                &mut core,
                env,
                value,
                Some(written)
              ) {
                ElabErr(e) => ElabErr(e)
                ElabOk(t) => elab_known(j, &mut core, t, expected)
              }
            }
            _ => ElabErr("the expects a type and a value")
          }
          _ => ElabErr("the expects a type and a value")
        }
        _ => ElabErr("the expects a type and a value")
      }
    }
  }

  pub fn elab_application(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    head: SurfaceTerm,
    args: List(SurfaceTerm),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, head, None) {
        ElabErr(e) => ElabErr(e)
        ElabOk(t) => ⊢ ElabResult(ElabTyped) from match elab_arguments(j, &mut core, env, t, args) {
          ElabErr(e) => ElabErr(e)
          // A name `let` bound to a λ stands for it: the call is the λ's body.
          ElabOk(v) => elab_known(j, &mut core, if elab_let_lambda(env, head) { ElabTyped::Mk(elab_beta(j, v.value), v.ty) } else { v }, expected)
        }
      }
    }
  }

  pub fn elab_arguments(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    head: ElabTyped,
    args: List(SurfaceTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match args {
        Nil => ElabOk(head)
        Cons(arg, rest) => ⊢ ElabResult(ElabTyped) from match kernel_as_pi(
          kernel_whnf(j, &mut core, head.ty, true, false)
        ) {
          None => ElabErr("application expects a function")
          Some(dc) => ⊢ ElabResult(ElabTyped) from match elab_term(
            j,
            &mut core,
            env,
            arg,
            Some(dc.fst)
          ) {
            ElabErr(e) => ElabErr(e)
            ElabOk(v) => elab_arguments(
              j,
              &mut core,
              env,
              ElabTyped::Mk(kernel_app(head.value, v.value), kernel_inst(dc.snd, v.value)),
              rest
            )
          }
        }
      }
    }
  }

  pub fn elab_block(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    stmts: List(SurfaceStmt),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match stmts {
        Nil => ElabErr("empty proof block")
        Cons(stmt, rest) => ⊢ ElabResult(ElabTyped) from match stmt {
          StExpr(value) => ⊢ ElabResult(ElabTyped) from match rest {
            Nil => elab_term(j, &mut core, env, value, expected)
            _ => ElabErr("only the last block expression produces a value")
          }
          StLet(name, annotation, value, r#borrow, mutable, ^unused, ^st_stack) => if r#borrow || mutable {
            ElabErr("borrowed and mutable lets are unsupported")
          } else {
            let want := ⊢ ElabResult(Option(KernelTerm)) from match annotation {
              None => ElabOk(None)
              Some(ty) => ⊢ ElabResult(Option(KernelTerm)) from match elab_type(j, &mut core, env, ty) {
                ElabErr(e) => ElabErr(e)
                ElabOk(t) => ElabOk(Some(t))
              }
            }
            ⊢ ElabResult(ElabTyped) from match want {
              ElabErr(e) => ElabErr(e)
              ElabOk(ty) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, value, ty) {
                ElabErr(e) => ElabErr(e)
                // As the host: `let x: T := e` stands for `the(T, e)`.
                ElabOk(t) => elab_block(
                  j,
                  &mut core,
                  Cons(ElabBinding::Mk(name, elab_the(core, ty, t.value), t.ty), env),
                  rest,
                  expected
                )
              }
            }
          }
          _ => ElabErr("unsupported proof block statement")
        }
      }
    }
  }

  // The type written on a λ's parameter is the domain it is given, as the host
  // holds it: an error names the parameter otherwise.
  pub fn elab_param_type_holds(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    name: Text,
    written: Option(SurfaceTerm),
    domain: KernelTerm
  ): Option(Text) {
    match k {
      Zero => Some("elaboration exhausted")
      Succ(j) => ⊢ Option(Text) from match written {
        None => None
        Some(ty) => ⊢ Option(Text) from match elab_type(j, &mut core, env, ty) {
          ElabErr(e) => Some(e)
          ElabOk(w) => if kernel_conv(j, &mut core, w, domain) { None } else {
            Some(Text::concat_all(["the parameter `", name, "` is written with a type other than the one it is given"]))
          }
        }
      }
    }
  }

  // A λ whose parameters are all typed, without an expected type: the
  // function type is read off the written types and the body.
  pub fn elab_infer_lambda(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    params: List(Text),
    types: List(SurfaceTerm),
    body: SurfaceTerm
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match params {
        Nil => elab_term(j, &mut core, env, body, None)
        Cons(name, rest) => ⊢ ElabResult(ElabTyped) from match types {
          Nil => ElabErr("lambda requires an expected type")
          Cons(written, more) => ⊢ ElabResult(ElabTyped) from match elab_type(j, &mut core, env, written) {
            ElabErr(e) => ElabErr(e)
            ElabOk(domain) => {
              let saved := core.locals
              let atom := kernel_fresh(&mut core, domain)
              let tail := elab_infer_lambda(j, &mut core, Cons(ElabBinding::Mk(name, KernelFVar(atom), domain), env), rest, more, body)
              kernel_set_to(&mut core.locals, saved)
              ⊢ ElabResult(ElabTyped) from match tail {
                ElabErr(e) => ElabErr(e)
                ElabOk(t) => ElabOk(ElabTyped::Mk(
                  kernel_lam(kernel_abstract_at(t.value, 0, atom)),
                  kernel_pi(domain, kernel_abstract_at(t.ty, 0, atom))
                ))
              }
            }
          }
        }
      }
    }
  }

  // `#typed_lam(λ, T…)`: a λ with types written on its parameters.
  pub fn elab_typed_lambda(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    args: List(SurfaceTerm),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => ElabErr("elaboration exhausted")
      Succ(j) => ⊢ ElabResult(ElabTyped) from match args {
        Cons(lam, types) => ⊢ ElabResult(ElabTyped) from match lam.kind {
          SkLam(params, body, _, _) => ⊢ ElabResult(ElabTyped) from match expected {
            // With every parameter typed, the type is the one the body gives.
            None => if List::length(types) == List::length(params) { elab_infer_lambda(j, &mut core, env, params, types, body) } else { ElabErr("lambda requires an expected type") }
            Some(ty) => elab_lambda(j, &mut core, env, params, types, body, ty)
          }
          // A borrowing λ is the λ by value, as the host reads it.
          SkBorrowLam(r#borrows, inner) => if elab_borrows_mutable(r#borrows) {
            ElabErr("not a kernel term: λ with a `&mut` parameter")
          } else { elab_typed_lambda(j, &mut core, env, Cons(inner, types), expected) }
          _ => ElabErr("a typed lambda has no lambda")
        }
        Nil => ElabErr("a typed lambda has no lambda")
      }
    }
  }

  // `a == b` by the type of `a`, as the host reads it: `Nat::eq`, `Bool::eq`
  // or `Text::eq` (under `not` for `!=`). Any other type is an error.
  pub fn elab_equality(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    negated: Bool,
    args: List(SurfaceTerm),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match args {
        Cons(a, Cons(b, Nil)) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, a, None) {
          ElabErr(e) => ElabErr(e)
          ElabOk(ta) => ⊢ ElabResult(ElabTyped) from match elab_equality_function(ta.ty) {
            // A type applied to types, as `List(Nat)`, by its derived `beq`
            // and the equalities of its arguments, as the host reads it.
            None => ⊢ ElabResult(ElabTyped) from match elab_eq_fun(j, &mut core, ta.ty) {
              None => ElabErr("`==` is read only on `Nat`, `Bool`, `Text` and types with an equality here")
              Some(f) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, b, Some(ta.ty)) {
                ElabErr(e) => ElabErr(e)
                ElabOk(tb) => {
                  let call := elab_apps(f, [ta.value, tb.value])
                  elab_result(j, &mut core, if negated { elab_apps(KernelConst("not"), [call]) } else { call }, expected)
                }
              }
            }
            Some(f) => ⊢ ElabResult(ElabTyped) from match kernel_global_get(core, f) {
              None => ElabErr(Text::concat_all(["`==` needs `", f, "`, which is not declared"]))
              Some(^g) => {
                let call := surface_term_mk(SkApp(surface_term_mk(SkVar(NameSpelled(f)), a.start, a.end), [a, b]), a.start, b.end)
                elab_term(j, &mut core, env, if negated { surface_term_mk(SkApp(surface_term_mk(SkVar(NameSpelled("not")), a.start, a.end), [call]), a.start, b.end) } else { call }, expected)
              }
            }
          }
        }
        _ => ElabErr("`==` takes two operands")
      }
    }
  }

  // The arguments of a call with each one that is not a variable replaced by
  // the variable it is the arm's constructor of; none when some is neither.
  pub fn elab_rebuilt_args(k: Nat, core: &mut KernelCore, env: List(ElabBinding), args: List(SurfaceTerm)): Option(List(SurfaceTerm)) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(List(SurfaceTerm)) from match args {
        Nil => Some(Nil)
        Cons(a, rest) => ⊢ Option(List(SurfaceTerm)) from match elab_rebuilt_args(j, &mut core, env, rest) {
          None => None
          Some(more) => ⊢ Option(List(SurfaceTerm)) from match a.kind {
            SkVar(^x) => Some(Cons(a, more))
            _ => ⊢ Option(List(SurfaceTerm)) from match elab_term(j, &mut core, env, a, None) {
              ElabErr(^e) => None
              ElabOk(t) => ⊢ Option(List(SurfaceTerm)) from match elab_built_atom(env, t.value) {
                None => None
                Some(atom) => ⊢ Option(List(SurfaceTerm)) from match elab_name_of(env, elab_names_of_atom(env, atom), atom) {
                  None => None
                  Some(n) => Some(Cons(surface_term_mk(SkVar(NameSpelled(n)), a.start, a.end), more))
                }
              }
            }
          }
        }
      }
    }
  }

  // A call of the declaration itself: each argument is a variable, and the
  // call is an induction hypothesis only when one of them is a recursive field
  // of the matched parameter and the others are the parameters as they are.
  pub fn elab_recursive_call(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    name: Text,
    args: List(SurfaceTerm),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => if elab_has_named(args) {
        // `f(<A: A>, x)`: the implicit arguments written by name must be the
        // declaration's own, as an induction hypothesis has them.
        let split := elab_named_split(args)
        let gen := elab_lookup(env, Text::concat("#gen ", name))
        let generalized := ⊢ Bool from match gen {
          Some(g) => elab_gen_has_below(elab_lits_of(g.value), List::length(elab_self_implicits(env, name)))
          None => false
        }
        // A recursion that generalizes an implicit parameter takes its
        // written argument, so the call passes the implicits too.
        if generalized {
          ⊢ ElabResult(ElabTyped) from match gen {
            Some(g) => elab_gen_call(j, &mut core, env, name, List::append(elab_named_values(elab_implicit_names(env, name), split.fst, List::length(elab_self_implicits(env, name)), args), split.snd), elab_lits_of(g.value), false, expected)
            None => ElabErr("unreachable")
          }
        } else if elab_named_are_own(elab_implicit_names(env, name), elab_self_implicits(env, name), split.fst, env) {
          ⊢ ElabResult(ElabTyped) from match gen {
            Some(^g) => elab_recursive_call(j, &mut core, env, name, split.snd, expected)
            // As the host: an implicit parameter the matched value's type does
            // not mention, written in a call, may change in it.
            None => if elab_implicit_movable(core, env, elab_self_implicits(env, name)) { ElabErr(elab_deep_message()) } else { elab_recursive_call(j, &mut core, env, name, split.snd, expected) }
          }
        } else {
          ElabErr("a recursive call must pass its own implicit arguments")
        }
      } else { ⊢ ElabResult(ElabTyped) from match elab_lookup(env, Text::concat("#gen ", name)) {
       Some(g) => elab_gen_call(j, &mut core, env, name, args, elab_lits_of(g.value), true, expected)
       None => ⊢ ElabResult(ElabTyped) from match elab_arg_atoms(env, args) {
        // A call on the constructor an arm of a match on `x` rebuilds from
        // its fields is a call on `x`, as the host reads it.
        None => {
          let rebuilt: Option(List(SurfaceTerm)) := if elab_bound_with(env, "#deep rebuilt") { elab_rebuilt_args(j, &mut core, env, args) } else { None }
          ⊢ ElabResult(ElabTyped) from match rebuilt {
            Some(more) => elab_recursive_call(j, &mut core, env, name, more, expected)
            None => ⊢ ElabResult(ElabTyped) from match elab_fun_arg_atoms(env, args) {
              None => ElabErr("a recursive call must pass variables")
              // `f(y)` for a function-typed recursive field `f`: its hypothesis at `y`.
              Some(fc) => ⊢ ElabResult(ElabTyped) from match elab_lookup(env, Text::concat("#fun ", elab_rec_key(name, List::append(elab_self_implicits(env, name), fc.fst)))) {
                None => ElabErr(elab_deep_message())
                Some(ih) => elab_gen_apply(j, &mut core, env, ih.value, ih.ty, fc.snd, expected)
              }
            }
          }
        }
        Some(written) => ⊢ ElabResult(ElabTyped) from match elab_lookup(env, elab_rec_key(name, List::append(elab_self_implicits(env, name), written))) {
          None => ElabErr(elab_deep_message())
          Some(ih) => elab_known(j, &mut core, ih, expected)
        }
       }
      }
      }
    }
  }

  pub fn elab_gen_call(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    name: Text,
    args: List(SurfaceTerm),
    vs: List(Nat),
    skip: Bool,
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match elab_self(env) {
        None => ElabErr(elab_deep_message())
        Some(me) => ⊢ ElabResult(ElabTyped) from match elab_self_params(env, me.snd) {
          None => ElabErr(elab_deep_message())
          Some(ids) => {
            let imps := elab_self_implicits(env, name)
            ⊢ ElabResult(ElabTyped) from match elab_gen_split(env, ids, vs, args, if skip { List::length(imps) } else { 0 }) {
              None => ElabErr("a recursive call must pass variables for the parameters it does not change")
              Some(split) => ⊢ ElabResult(ElabTyped) from match elab_lookup(env, elab_rec_key(name, if skip { List::append(imps, split.fst) } else { split.fst })) {
                None => ElabErr(elab_deep_message())
                Some(ih) => elab_gen_apply(j, &mut core, env, ih.value, ih.ty, split.snd, expected)
              }
            }
          }
        }
      }
    }
  }

  pub fn elab_gen_apply(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    f: KernelTerm,
    ty: KernelTerm,
    args: List(SurfaceTerm),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match args {
        Nil => elab_known(j, &mut core, ElabTyped::Mk(f, ty), expected)
        Cons(a, rest) => ⊢ ElabResult(ElabTyped) from match kernel_as_pi(kernel_whnf(j, &mut core, ty, true, false)) {
          None => ElabErr("type mismatch")
          Some(p) => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, a, Some(p.fst)) {
            ElabErr(e) => ElabErr(e)
            ElabOk(v) => elab_gen_apply(j, &mut core, env, elab_apps(f, Cons(v.value, Nil)), kernel_inst(p.snd, v.value), rest, expected)
          }
        }
      }
    }
  }

  // A recursive call passes something else for some parameter: generalize
  // those parameters, or else recurse on deeper parts.
  pub fn elab_gen_or_deep(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    x: Nat,
    info: KernelIndInfo,
    family: Text,
    params: List(KernelTerm),
    arms: List(SurfaceArm),
    expected: KernelTerm,
    r: ElabRecursion
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      // A match under an arm of the recursion's own match is not where it
      // starts: the outer match generalizes.
      Succ(j) => if elab_bound_with(env, Text::concat("#rec ", r.name)) { ElabErr(elab_deep_message()) } else {
        let bs := elab_take(elab_rev(elab_before_self(env), Nil), List::length(r.ids))
        let nimp := List::length(elab_self_implicits(env, r.name))
        let names := elab_binding_names(elab_drop_bindings(bs, nimp))
        let xty := ⊢ KernelTerm from match kernel_local_get(core, x) {
          None => KernelConst("Nat")
          Some(t) => t
        }
        let varied := List::append(elab_implicit_varied(core, bs, nimp, xty, elab_named_arms(j, r.name, arms)), elab_vary_arms(j, r.name, names, arms, elab_falses(List::length(names))))
        // As the host: a later parameter whose type depends on the matched
        // one, or on one generalized before it, is generalized too.
        let mask := elab_mask_dependents(bs, varied, Cons(x, Nil), 0, r.at)
        let vs := elab_mask_ids(mask, 0, r.at)
        ⊢ ElabResult(ElabTyped) from match vs {
          Nil => elab_deep_top(j, &mut core, env, x, info, family, params, arms, expected, r)
          _ => {
            let vb := elab_pick_bindings(bs, vs, 0)
            let motive := kernel_abstract_at(elab_gen_pi(vb, expected), 0, x)
            let outer: List(ElabBinding) := if elab_unbound(env, "#matched") { Cons(ElabBinding::Mk("#scrutinee", KernelFVar(x), KernelLit(0)), env) } else { env }
            let inner := Cons(ElabBinding::Mk(Text::concat("#gen ", r.name), elab_apps(KernelLit(0), elab_nat_lits(vs)), KernelLit(0)), outer)
            ⊢ ElabResult(ElabTyped) from match elab_minors(j, &mut core, Cons(ElabBinding::Mk("#on", KernelFVar(x), KernelLit(0)), inner), info.constructors, info.constructors, elab_gen_arms(arms, elab_binding_names(vb)), family, params, motive, info.position, Some(r)) {
              ElabErr(e) => ElabErr(e)
              ElabOk(minors) => {
                let eliminator := elab_eliminator(j, &mut core, env, family, expected)
                let is_prop := elab_is_prop(j, &mut core, expected)
                elab_result(
                j,
                &mut core,
                elab_apps(
                  elab_apps(
                    KernelConst(eliminator),
                    List::append(params, List::append(elab_group_motives(core, info.group, family, kernel_lam(motive), is_prop), List::append(elab_group_minors(core, info.group, family, minors, is_prop), Cons(KernelFVar(x), Nil))))
                  ),
                  elab_binding_values(vb)
                ),
                Some(expected)
              )
              }
            }
          }
        }
      }
    }
  }

  // `match x { C(a, …) => … }` on a variable of an inductive family without
  // indices: the family's eliminator applied to its parameters, the motive
  // made from the expected type, one case per constructor, and `x`.
  pub fn elab_match(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    scrutinee: SurfaceTerm,
    written: List(SurfaceArm),
    expected: KernelTerm
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match elab_recursive_tuple_tree(j, env, core, scrutinee, written) {
       // As the host: a match on a product of variables, in a function that calls itself, is
       // the case tree of matches on those variables.
       Some(tree) => elab_term(j, &mut core, env, tree, Some(expected))
       None => ⊢ ElabResult(ElabTyped) from match elab_nest_arms(j, core, elab_wrap_goals(elab_record_arms(env, core, written))) {
       NestErr(e) => ElabErr(e)
       NestOk(arms, ^fresh, ^used) => ⊢ ElabResult(ElabTyped) from match scrutinee.kind {
        SkVar(x) => ⊢ ElabResult(ElabTyped) from match elab_lookup(env, surface_name_text(x)) {
          None => ElabErr("a match is on a local variable")
          Some(local) => ⊢ ElabResult(ElabTyped) from match local.value {
            KernelFVar(atom) => {
              let spine0 := elab_spine(j, kernel_whnf(j, &mut core, local.ty, true, false), Nil)
              let spine := ⊢ (KernelTerm × List(KernelTerm)) from match spine0.fst {
                KernelConst(f0) => ⊢ (KernelTerm × List(KernelTerm)) from match elab_nested_member(core, f0, spine0.snd) {
                  // (A match other variables depend on is still compiled on the type itself.)
                  Some(member) => #(KernelConst(member), Nil)
                  None => spine0
                }
                _ => spine0
              }
              ⊢ ElabResult(ElabTyped) from match spine.fst {
                KernelConst(family) => ⊢ ElabResult(ElabTyped) from match kernel_ind_get(core, family) {
                  None => ElabErr("the matched value is not of an inductive type")
                  Some(info) => if elab_is_instance(family) {
                    // As in the host: an instance of a level-polymorphic family is not matched on.
                    ElabErr("a match on an instance of a level-polymorphic family is unsupported")
                  } else { ⊢ ElabResult(ElabTyped) from match elab_index_atoms(elab_drop_terms(spine.snd, info.params), Cons(atom, Nil)) {
                   None => ⊢ ElabResult(ElabTyped) from match elab_lookup(env, elab_below_key(atom)) {
                     Some(^bv) => ElabErr("a match in a recursion on deeper parts must be on an unindexed family")
                     None => elab_general_match(j, &mut core, env, atom, info, family, elab_take_terms(spine.snd, info.params), elab_drop_terms(spine.snd, info.params), arms, expected)
                   }
                   Some(indices) => if elab_dependents(env, Cons(atom, indices), Cons(atom, indices)) {
                    // As in the host: a match nested in a term generalizes the
                    // later variables whose types depend on the matched one;
                    // a recursion generalizes its parameters that do.
                    let recursion := elab_recursion_at(env, atom, indices)
                    if List::length(indices) == 0 && (List::length(info.group) == 1 || elab_has_alias(info)) && elab_none_recursion(recursion) == false && elab_nested_in_gen(j, env, recursion, arms) == false && List::length(arms) == List::length(info.constructors) && elab_arms_known(arms, info.constructors, family) && elab_unbound(env, elab_below_key(atom)) {
                      ⊢ ElabResult(ElabTyped) from match recursion {
                        None => ElabErr("unreachable")
                        Some(r) => elab_gen_or_deep(j, &mut core, env, atom, info, family, elab_take_terms(spine.snd, info.params), arms, expected, r)
                      }
                    } else if List::length(indices) == 0 && (elab_outside_self(j, env, arms) || elab_none_recursion(recursion)) && List::length(arms) == List::length(info.constructors) && elab_arms_known(arms, info.constructors, family) {
                      let vb := elab_by_origin(elab_rev(env, Nil), elab_dependent_bindings(elab_rev(env, Nil), Cons(atom, Nil)))
                      let motive := kernel_abstract_at(elab_gen_pi(vb, expected), 0, atom)
                      let params := elab_take_terms(spine.snd, info.params)
                      ⊢ ElabResult(ElabTyped) from match elab_minors(j, &mut core, Cons(ElabBinding::Mk("#on", KernelFVar(atom), KernelLit(0)), env), info.constructors, info.constructors, elab_gen_arms(arms, elab_binding_names(vb)), family, params, motive, info.position, None) {
                        ElabErr(e) => ElabErr(e)
                        ElabOk(minors) => {
                          let eliminator := elab_eliminator(j, &mut core, env, family, expected)
                          let is_prop := elab_is_prop(j, &mut core, expected)
                          elab_result(
                          j,
                          &mut core,
                          elab_apps(
                            elab_apps(
                              KernelConst(eliminator),
                              List::append(params, List::append(elab_group_motives(core, info.group, family, kernel_lam(motive), is_prop), List::append(elab_group_minors(core, info.group, family, minors, is_prop), Cons(KernelFVar(atom), Nil))))
                            ),
                            elab_binding_values(vb)
                          ),
                          Some(expected)
                        )
                        }
                      }
                    } else {
                    ElabErr("a match whose variable or indices other variables depend on is unsupported")
                    }
                  } else if List::length(arms) != List::length(info.constructors) || elab_arms_known(arms, info.constructors, family) == false {
                    ElabErr("a match needs exactly one plain arm per constructor")
                  } else {
                    let motive := elab_abstract_indices(kernel_abstract_at(expected, 0, atom), List::reverse(indices), 1)
                    let recursion := ⊢ Option(ElabRecursion) from match elab_self(env) {
                      None => None
                      Some(me) => ⊢ Option(ElabRecursion) from match elab_self_params(env, me.snd) {
                        None => None
                        Some(ids) => ⊢ Option(ElabRecursion) from match elab_position(ids, atom, 0) {
                          None => None
                          Some(at) => Some(ElabRecursion::Mk(me.fst, ids, at, indices))
                        }
                      }
                    }
                    let params := elab_take_terms(spine.snd, info.params)
                    let simple := List::length(indices) == 0 && List::length(info.group) == 1
                    ⊢ ElabResult(ElabTyped) from match elab_lookup(env, elab_below_key(atom)) {
                     Some(bv) => if simple && elab_none_recursion(recursion) { elab_deep_inner(j, &mut core, env, atom, info, family, params, arms, expected, bv.value) } else {
                       ElabErr("a match in a recursion on deeper parts must be on an unindexed family")
                     }
                     None => ⊢ ElabResult(ElabTyped) from match elab_minors(j, &mut core, Cons(ElabBinding::Mk("#on", KernelFVar(atom), KernelLit(0)), if List::length(indices) == 0 && elab_unbound(env, "#matched") { Cons(ElabBinding::Mk("#scrutinee", KernelFVar(atom), KernelLit(0)), env) } else { env }), info.constructors, info.constructors, arms, family, params, motive, info.position, recursion) {
                      ElabErr(e) => ⊢ ElabResult(ElabTyped) from match recursion {
                        Some(r) => if simple && (e == elab_deep_message() || e == "a recursive call must pass variables") { elab_gen_or_deep(j, &mut core, env, atom, info, family, params, arms, expected, r) } else { ElabErr(e) }
                        None => ElabErr(e)
                      }
                      ElabOk(minors) => {
                        let eliminator := elab_eliminator(j, &mut core, env, family, expected)
                        let is_prop := elab_is_prop(j, &mut core, expected)
                        elab_result(
                        j,
                        &mut core,
                        ⊢ KernelTerm from match elab_cases_pick(core, info, family, eliminator, indices, minors) {
                          Some(own) => elab_apps(
                            KernelConst(Text::concat(family, "@cases")),
                            List::append(params, Cons(kernel_lam(motive), List::append(own, Cons(KernelFVar(atom), Nil))))
                          )
                          None => elab_apps(
                            KernelConst(eliminator),
                            List::append(params, List::append(elab_group_motives(core, info.group, family, elab_lam_n(motive, List::length(indices) + 1), is_prop), List::append(elab_group_minors(core, info.group, family, minors, is_prop), List::append(elab_fvars(indices), Cons(KernelFVar(atom), Nil)))))
                          )
                        },
                        Some(expected)
                      )
                      }
                     }
                    }
                  }
                  }
                  }
                }
                _ => ElabErr("the matched value is not of an inductive type")
              }
            }
            // A variable `let` bound to a term stands for that term: the match
            // is on the term.
            _ => elab_match(j, &mut core, env, surface_term_mk(SkBlock([StExpr(scrutinee)]), scrutinee.start, scrutinee.end), written, expected)
          }
        }
        // As the host: a match on a term whose arms write no goal is a match
        // on a fresh variable of its type, with the term put for it after.
        _ => ⊢ ElabResult(ElabTyped) from match elab_term(j, &mut core, env, scrutinee, None) {
          ElabErr(e) => ElabErr(e)
          ElabOk(t) => if elab_arms_goal_free(written) == false && (elab_term_occurs(expected, t.value) || elab_env_occurs(env, t.value)) { ElabErr("a match on a term whose arms write their goals is unsupported where the result or an assumption shows the term") } else {
            let x := kernel_fresh(&mut core, t.ty)
            let name := Text::concat("m@", Text::of_nat(x))
            let on_x := surface_term_mk(SkVar(NameSpelled(name)), scrutinee.start, scrutinee.end)
            ⊢ ElabResult(ElabTyped) from match elab_match(j, &mut core, Cons(ElabBinding::Mk(name, KernelFVar(x), t.ty), env), on_x, written, expected) {
              ElabErr(e) => ElabErr(e)
              ElabOk(r) => ElabOk(ElabTyped::Mk(kernel_inst(kernel_abstract_at(r.value, 0, x), t.value), r.ty))
            }
          }
        }
       }
      }
      }
    }
  }

  // A recursion on parts deeper than the fields: the motive pairs each value
  // with `below` of it, the values at its parts, and the declaration's value
  // is the first half.
  pub fn elab_deep_top(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    x: Nat,
    info: KernelIndInfo,
    family: Text,
    params: List(KernelTerm),
    arms: List(SurfaceArm),
    expected: KernelTerm,
    r: ElabRecursion
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => if elab_is_prop(j, &mut core, expected) { ElabErr("a proof by recursion on deeper parts is unsupported: the host builds it with `And` and the family's `ind`") } else {
        let gtop := kernel_abstract_at(expected, 0, x)
        ⊢ ElabResult(ElabTyped) from match elab_below_body(j, &mut core, info, family, params, gtop) {
          None => ElabErr("a recursion on deeper parts of a family with function-typed recursive fields is unsupported")
          Some(below) => {
            let gm := elab_pair_ty(gtop, below)
            let outer: List(ElabBinding) := if elab_unbound(env, "#matched") { Cons(ElabBinding::Mk("#scrutinee", KernelFVar(x), KernelLit(0)), env) } else { env }
            let marked := Cons(
              ElabBinding::Mk("#deep motive", gtop, KernelLit(r.at)),
              Cons(ElabBinding::Mk("#deep below", below, KernelLit(0)), outer)
            )
            // As the host: a call on the constructor an arm rebuilds from the
            // fields of a part is a call on the part, whose value each match
            // on a field then generalizes with its `below`.
            let inner: List(ElabBinding) := if elab_arms_ctor_call(j, env, core, r.name, arms) { Cons(ElabBinding::Mk("#deep rebuilt", KernelLit(1), KernelLit(0)), marked) } else { marked }
            ⊢ ElabResult(ElabTyped) from match elab_deep_minors(j, &mut core, inner, info.constructors, info.constructors, arms, family, params, true, gtop, below, gm, gtop, r) {
              ElabErr(e) => ElabErr(e)
              ElabOk(minors) => {
                let whole := elab_apps(
                  KernelConst(Text::concat(family, "::rec")),
                  List::append(params, Cons(kernel_lam(gm), List::append(minors, Cons(KernelFVar(x), Nil))))
                )
                elab_result(j, &mut core, elab_half(expected, kernel_inst(below, KernelFVar(x)), whole, true), Some(expected))
              }
            }
          }
        }
      }
    }
  }

  // A match, in a recursion on deeper parts, on a part whose `below` is in
  // scope: the match generalizes it, so each arm sees the parts one level
  // further down.
  pub fn elab_deep_inner(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    v: Nat,
    info: KernelIndInfo,
    family: Text,
    params: List(KernelTerm),
    arms: List(SurfaceArm),
    expected: KernelTerm,
    bv: KernelTerm
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match elab_lookup(env, "#deep motive") {
        None => ElabErr("a part's `below` is outside a recursion on deeper parts")
        Some(dm) => ⊢ ElabResult(ElabTyped) from match elab_lookup(env, "#deep below") {
          None => ElabErr("a part's `below` is outside a recursion on deeper parts")
          Some(db) => ⊢ ElabResult(ElabTyped) from match elab_deep_recursion(env) {
            None => ElabErr("a part's `below` is outside a recursion on deeper parts")
            Some(r) => {
              let ggoal := kernel_abstract_at(expected, 0, v)
              // With calls on rebuilt constructors, the value of the call on
              // the part is generalized with its `below`.
              let at_value: Option(ElabTyped) := if elab_bound_with(env, "#deep rebuilt") { elab_lookup(env, elab_rec_key(r.name, elab_set_nat(r.ids, r.at, v))) } else { None }
              let gm := ⊢ KernelTerm from match at_value {
                None => kernel_abstract_at(kernel_pi(kernel_inst(db.value, KernelFVar(v)), expected), 0, v)
                Some(^av) => kernel_abstract_at(kernel_pi(kernel_inst(db.value, KernelFVar(v)), kernel_pi(kernel_inst(dm.value, KernelFVar(v)), expected)), 0, v)
              }
              let inner := Cons(ElabBinding::Mk("#on", KernelFVar(v), KernelLit(0)), Cons(
                ⊢ ElabBinding from match at_value {
                  None => ElabBinding::Mk("#deep at", KernelLit(0), KernelLit(0))
                  Some(av) => ElabBinding::Mk("#deep at", KernelFVar(v), av.value)
                },
                env
              ))
              ⊢ ElabResult(ElabTyped) from match elab_deep_minors(j, &mut core, inner, info.constructors, info.constructors, arms, family, params, false, dm.value, db.value, gm, ggoal, r) {
                ElabErr(e) => ElabErr(e)
                ElabOk(minors) => {
                  let at_args: List(KernelTerm) := match at_value {
                    None => Nil
                    Some(av) => Cons(av.value, Nil)
                  }
                  let whole := elab_apps(
                    KernelConst(Text::concat(family, "::rec")),
                    List::append(params, Cons(kernel_lam(gm), List::append(minors, Cons(KernelFVar(v), Cons(bv, at_args)))))
                  )
                  elab_result(j, &mut core, whole, Some(expected))
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn elab_deep_minors(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    all: List(KernelCtorInfo),
    ctors: List(KernelCtorInfo),
    arms: List(SurfaceArm),
    family: Text,
    params: List(KernelTerm),
    top: Bool,
    gtop: KernelTerm,
    below: KernelTerm,
    gm: KernelTerm,
    ggoal: KernelTerm,
    r: ElabRecursion
  ): ElabResult(List(KernelTerm)) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(List(KernelTerm)) from match ctors {
        Nil => ElabOk(Nil)
        Cons(c, rest) => ⊢ ElabResult(List(KernelTerm)) from match elab_arm_of(arms, all, c.name, family) {
          None => ElabErr("a constructor has no arm")
          Some(found) => ⊢ ElabResult(List(KernelTerm)) from match elab_bound_names(found.snd) {
            None => ElabErr("constructor patterns bind variables or `_`")
            Some(names) => if List::length(names) != c.nargs { ElabErr("a pattern has the wrong number of fields") } else {
              ⊢ ElabResult(List(KernelTerm)) from match kernel_global_get(core, c.name) {
                None => ElabErr("unknown constructor")
                Some(g) => ⊢ ElabResult(List(KernelTerm)) from match elab_instantiate(j, g.ty, params) {
                  None => ElabErr("cannot instantiate the constructor")
                  Some(cty) => {
                    let saved := core.locals
                    let minor := elab_deep_case(j, &mut core, env, names, cty, Nil, c, found.fst.body, params, top, gtop, below, gm, ggoal, r)
                    kernel_set_to(&mut core.locals, saved)
                    ⊢ ElabResult(List(KernelTerm)) from match minor {
                      ElabErr(e) => ElabErr(e)
                      ElabOk(m) => ⊢ ElabResult(List(KernelTerm)) from match elab_deep_minors(j, &mut core, env, all, rest, arms, family, params, top, gtop, below, gm, ggoal, r) {
                        ElabErr(e) => ElabErr(e)
                        ElabOk(ms) => ElabOk(Cons(m, ms))
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn elab_deep_case(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    names: List(Option(Text)),
    cty: KernelTerm,
    fields: List(Nat),
    c: KernelCtorInfo,
    body: SurfaceTerm,
    params: List(KernelTerm),
    top: Bool,
    gtop: KernelTerm,
    below: KernelTerm,
    gm: KernelTerm,
    ggoal: KernelTerm,
    r: ElabRecursion
  ): ElabResult(KernelTerm) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(KernelTerm) from match names {
        Cons(n, rest) => ⊢ ElabResult(KernelTerm) from match kernel_as_pi(kernel_whnf(j, &mut core, cty, true, false)) {
          None => ElabErr("a constructor has fewer fields than its pattern")
          Some(p) => {
            let atom := kernel_fresh(&mut core, p.fst)
            let named := ⊢ List(ElabBinding) from match n {
              None => env
              Some(x) => Cons(ElabBinding::Mk(x, KernelFVar(atom), p.fst), env)
            }
            elab_deep_case(j, &mut core, named, rest, kernel_inst(p.snd, KernelFVar(atom)), List::append(fields, Cons(atom, Nil)), c, body, params, top, gtop, below, gm, ggoal, r)
          }
        }
        Nil => {
          let recf := elab_rec_atoms(fields, c, 0)
          let ihs := elab_fresh_all(&mut core, recf, gm)
          let cv := elab_apps(KernelConst(c.name), List::append(params, elab_fvars(fields)))
          let es := elab_entries(recf, gtop, below)
          let bl: Nat := if top { 0 } else { kernel_fresh(&mut core, kernel_inst(below, cv)) }
          let entries: List(KernelTerm) := if top { elab_fvars(ihs) } else { elab_chain_entries(es, 0, List::length(recf), KernelFVar(bl)) }
          // The value of the call on the matched part, generalized with its `below`.
          let at_part: Option(ElabTyped) := if top { None } else { elab_lookup(env, "#deep at") }
          let al: Nat := ⊢ Nat from match at_part {
            Some(ap) => ⊢ Nat from match ap.value {
              KernelFVar(^v) => kernel_fresh(&mut core, kernel_inst(gtop, cv))
              _ => 0
            }
            None => 0
          }
          let called := ⊢ List(ElabBinding) from match at_part {
            Some(ap) => ⊢ List(ElabBinding) from match ap.value {
              KernelFVar(v) => Cons(ElabBinding::Mk(elab_rec_key(r.name, elab_set_nat(r.ids, r.at, v)), KernelFVar(al), kernel_inst(gtop, cv)), env)
              _ => env
            }
            None => env
          }
          let inner := elab_deep_bindings(recf, entries, gtop, below, r, called)
          ⊢ ElabResult(KernelTerm) from match elab_term(j, &mut core, elab_with_built(inner, cv, if top { elab_refined(inner, inner, cv, elab_mentions_matched(j, inner, body)) } else { inner }), body, Some(kernel_inst(ggoal, cv))) {
            ElabErr(e) => ElabErr(e)
            ElabOk(t) => if top {
              ElabOk(elab_lams(
                elab_apps(KernelConst("BelowPair::Mk"), Cons(kernel_inst(gtop, cv), Cons(kernel_inst(below, cv), Cons(t.value, Cons(elab_chain_val(es, elab_fvars(ihs)), Nil))))),
                List::append(fields, ihs)
              ))
            } else { ElabOk(elab_lams(t.value, List::append(fields, List::append(ihs, Cons(bl, ⊢ List(Nat) from match at_part {
              Some(ap) => ⊢ List(Nat) from match ap.value {
                KernelFVar(^v) => Cons(al, Nil)
                _ => Nil
              }
              None => Nil
            }))))) }
          }
        }
      }
    }
  }

  pub fn elab_minors(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    all: List(KernelCtorInfo),
    ctors: List(KernelCtorInfo),
    arms: List(SurfaceArm),
    family: Text,
    params: List(KernelTerm),
    motive: KernelTerm,
    position: Nat,
    recursion: Option(ElabRecursion)
  ): ElabResult(List(KernelTerm)) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(List(KernelTerm)) from match ctors {
        Nil => ElabOk(Nil)
        Cons(c, rest) => ⊢ ElabResult(List(KernelTerm)) from match elab_arm_of(arms, all, c.name, family) {
          None => ElabErr("a constructor has no arm")
          Some(found) => {
            let arm := found.fst
            ⊢ ElabResult(List(KernelTerm)) from match elab_bound_names(found.snd) {
              None => ElabErr("constructor patterns bind variables or `_`")
              Some(names) => if List::length(names) != c.nargs { ElabErr("a pattern has the wrong number of fields") } else {
                ⊢ ElabResult(List(KernelTerm)) from match kernel_global_get(core, c.name) {
                  None => ElabErr("unknown constructor")
                  Some(g) => ⊢ ElabResult(List(KernelTerm)) from match elab_instantiate(j, g.ty, elab_ctor_params(core, family, params)) {
                    None => ElabErr("cannot instantiate the constructor")
                    Some(cty) => {
                      let saved := core.locals
                      let minor := elab_case(j, &mut core, env, names, cty, 0, Nil, c, arm.body, motive, elab_ctor_params(core, family, params), position, recursion)
                      kernel_set_to(&mut core.locals, saved)
                      ⊢ ElabResult(List(KernelTerm)) from match minor {
                        ElabErr(e) => ElabErr(e)
                        ElabOk(m) => ⊢ ElabResult(List(KernelTerm)) from match elab_minors(j, &mut core, env, all, rest, arms, family, params, motive, position, recursion) {
                          ElabErr(e) => ElabErr(e)
                          ElabOk(ms) => ElabOk(Cons(m, ms))
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Bind the fields of one constructor, then an induction hypothesis for each
  // recursive field, and elaborate the arm at the motive of the constructor.
  pub fn elab_case(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    names: List(Option(Text)),
    cty: KernelTerm,
    at: Nat,
    fields: List(Nat),
    c: KernelCtorInfo,
    body: SurfaceTerm,
    motive: KernelTerm,
    params: List(KernelTerm),
    position: Nat,
    recursion: Option(ElabRecursion)
  ): ElabResult(KernelTerm) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(KernelTerm) from match names {
        Cons(n, rest) => ⊢ ElabResult(KernelTerm) from match kernel_as_pi(kernel_whnf(j, &mut core, cty, true, false)) {
          None => ElabErr("a constructor has fewer fields than its pattern")
          Some(p) => {
            let atom := kernel_fresh(&mut core, p.fst)
            let named := ⊢ List(ElabBinding) from match n {
              None => env
              Some(x) => Cons(ElabBinding::Mk(x, KernelFVar(atom), p.fst), env)
            }
            elab_case(j, &mut core, named, rest, kernel_inst(p.snd, KernelFVar(atom)), at + 1, List::append(fields, Cons(atom, Nil)), c, body, motive, params, position, recursion)
          }
        }
        Nil => {
          let at_indices := elab_type_indices(j, &mut core, cty, List::length(params))
          let built := elab_apps(KernelConst(c.name), List::append(params, elab_fvars(fields)))
          let goal := elab_inst_all(motive, Cons(built, List::reverse(at_indices)))
          let goal_prop := elab_is_prop(j, &mut core, goal)
          let ihs := elab_hypotheses(j, &mut core, env, fields, 0, c, motive, List::length(params), position, recursion, goal_prop)
          // In the arm, the matched variable is the constructor of its
          // fields, as the host reads it: the motive puts it there.
          ⊢ ElabResult(KernelTerm) from match elab_term(j, &mut core, elab_with_built(ihs.snd, built, elab_refined(ihs.snd, ihs.snd, built, elab_mentions_matched(j, ihs.snd, body))), body, Some(goal)) {
            ElabErr(e) => ElabErr(e)
            ElabOk(t) => ElabOk(elab_lams(t.value, List::append(fields, ihs.fst)))
          }
        }
      }
    }
  }

  pub fn elab_hypotheses(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    fields: List(Nat),
    i: Nat,
    c: KernelCtorInfo,
    motive: KernelTerm,
    np: Nat,
    position: Nat,
    recursion: Option(ElabRecursion),
    prop: Bool
  ): List(Nat) × List(ElabBinding) {
    ⊢ (List(Nat) × List(ElabBinding)) from match k {
      Zero => #(Nil, env)
      Succ(j) => ⊢ (List(Nat) × List(ElabBinding)) from match fields {
        Nil => #(Nil, env)
        Cons(f, rest) => if elab_is_recursive(c.recursive, i) && elab_rec_family(c.recursive, i) != position {
          // A field of another family of the group: its motive is `Unit`.
          let ih := kernel_fresh(&mut core, KernelConst(elab_unit_type(prop)))
          let more := elab_hypotheses(j, &mut core, env, rest, i + 1, c, motive, np, position, recursion, prop)
          #(Cons(ih, more.fst), more.snd)
        } else if elab_is_recursive(c.recursive, i) {
          let fty := ⊢ KernelTerm from match kernel_local_get(core, f) {
            Some(t) => t
            None => KernelSortTerm(KernelProp)
          }
          let at_indices := elab_type_indices(j, &mut core, fty, np)
          let ty := elab_inst_all(motive, Cons(KernelFVar(f), List::reverse(at_indices)))
          let ih := kernel_fresh(&mut core, ty)
          let bound := ⊢ List(ElabBinding) from match recursion {
            None => env
            Some(r) => ⊢ List(ElabBinding) from match elab_moved_indices(r.ids, r.indices, at_indices) {
              None => env
              Some(ids) => Cons(
                ElabBinding::Mk(elab_rec_key(r.name, elab_set_nat(ids, r.at, f)), KernelFVar(ih), ty),
                env
              )
            }
          }
          let more := elab_hypotheses(j, &mut core, bound, rest, i + 1, c, motive, np, position, recursion, prop)
          #(Cons(ih, more.fst), more.snd)
        } else if elab_fun_rec(c.recursive, i, position) {
          // A field that is a function into the family: its hypothesis is
          // `∀ y…. motive(f(y…))`, used where a call takes `f(y…)`.
          let fty := ⊢ KernelTerm from match kernel_local_get(core, f) {
            Some(t) => t
            None => KernelSortTerm(KernelProp)
          }
          let ty := elab_fun_ih(j, &mut core, fty, KernelFVar(f), elab_fun_ys(c.recursive, i), motive, np)
          let ih := kernel_fresh(&mut core, ty)
          let bound := ⊢ List(ElabBinding) from match recursion {
            None => env
            Some(r) => Cons(
              ElabBinding::Mk(Text::concat("#fun ", elab_rec_key(r.name, elab_set_nat(r.ids, r.at, f))), KernelFVar(ih), ty),
              env
            )
          }
          let more := elab_hypotheses(j, &mut core, bound, rest, i + 1, c, motive, np, position, recursion, prop)
          #(Cons(ih, more.fst), more.snd)
        } else { elab_hypotheses(j, &mut core, env, rest, i + 1, c, motive, np, position, recursion, prop) }
      }
    }
  }

  // A global with implicit parameters: each becomes a hole, solved by
  // matching the expected result type and then each explicit argument's
  // type against the parameter types. Every hole must be solved; the
  // kernel checks the application with the solutions as arguments.
  // The holes the named implicit arguments fill, in the order written.
  pub fn elab_named_solutions(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    names: List(Text),
    holes: List(Nat),
    fields: List(SurfaceField),
    sols: List((Nat × KernelTerm))
  ): ElabResult(List((Nat × KernelTerm))) {
    match k {
      Zero => ElabErr("elaboration exhausted")
      Succ(j) => ⊢ ElabResult(List((Nat × KernelTerm))) from match fields {
        Nil => ElabOk(sols)
        Cons(f, rest) => ⊢ ElabResult(List((Nat × KernelTerm))) from match elab_hole_named(names, holes, f.name) {
          None => ElabErr(Text::concat("has no implicit parameter named ", f.name))
          Some(h) => ⊢ ElabResult(List((Nat × KernelTerm))) from match kernel_local_get(core, h) {
            None => ElabErr("an implicit parameter without its type")
            Some(ty) => ⊢ ElabResult(List((Nat × KernelTerm))) from match elab_term(j, &mut core, env, f.value, Some(elab_subst(ty, sols))) {
              ElabErr(e) => ElabErr(e)
              ElabOk(t) => elab_named_solutions(j, &mut core, env, names, holes, rest, Cons(#(h, t.value), sols))
            }
          }
        }
      }
    }
  }

  pub fn elab_implicit_application(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    name: Text,
    args: List(SurfaceTerm),
    expected: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match kernel_global_get(core, name) {
        None => ElabErr(elab_undeclared(env, name))
        Some(g) => {
          let saved := core.locals
          let written := args
          let args := elab_law_args(env, core, name, args)
          let result := ⊢ ElabResult(ElabTyped) from match elab_holes(j, &mut core, g.ty, elab_implicit_count(env, core, name)) {
            None => ElabErr("the implicit parameters do not match the type")
            Some(hs) => {
              // `f(<x: v>, a)`: the implicit arguments written by name are
              // elaborated first, each at its parameter's type.
              let split := elab_named_split(args)
              ⊢ ElabResult(ElabTyped) from match elab_named_solutions(j, &mut core, env, elab_implicit_names(env, name), hs.fst, elab_class_fields(env, name, split.fst), Nil) {
               ElabErr(e) => ElabErr(e)
               ElabOk(named) => {
              let explicit := split.snd
              let start := ⊢ Option(List((Nat × KernelTerm))) from match expected {
                None => Some(named)
                Some(want) => ⊢ Option(List((Nat × KernelTerm))) from match elab_result_after(j, &mut core, hs.snd, List::length(explicit)) {
                  None => Some(named)
                  Some(r) => ⊢ Option(List((Nat × KernelTerm))) from {
                    let head := kernel_beta_head(j, &mut core, want)
                    match elab_unify(j, &mut core, hs.fst, r, head, named) {
                    None => Some(named)
                    Some(s) => Some(s)
                    }
                  }
                }
              }
              ⊢ ElabResult(ElabTyped) from match start {
                None => ElabErr("cannot infer the implicit arguments")
                Some(sols) => elab_implicit_arguments(j, &mut core, env, hs.fst, sols, hs.snd, explicit, Nil, name, expected)
              }
               }
              }
            }
          }
          kernel_set_to(&mut core.locals, saved)
          ⊢ ElabResult(ElabTyped) from match result {
            ElabErr(e) => ElabErr(e)
            ElabOk(t) => ⊢ ElabResult(ElabTyped) from match elab_own_call(j, env, name, t.value) {
              // A method or a law of the instance being defined, called on that instance: a recursion.
              Some(me) => elab_recursive_call(j, &mut core, env, me, elab_unborrow_all(written), expected)
              None => elab_result(j, &mut core, t.value, expected)
            }
          }
        }
      }
    }
  }

  pub fn elab_implicit_arguments(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    holes: List(Nat),
    sols: List(Nat × KernelTerm),
    ty: KernelTerm,
    args: List(SurfaceTerm),
    done: List(KernelTerm),
    name: Text,
    want: Option(KernelTerm)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match args {
        Nil => {
          // The records of constraints are found once the rest is solved.
          ⊢ ElabResult(ElabTyped) from match elab_infer_solutions(j, &mut core, env, holes, holes, sols, sols) {
          ElabErr(message) => ElabErr(message)
          ElabOk(selected) => {
          let sols := elab_dict_solutions(j, &mut core, env, holes, holes, selected)
          ⊢ ElabResult(ElabTyped) from match elab_solutions_of(holes, sols) {
            None => ElabErr("cannot infer the implicit arguments")
            Some(vs) => ElabOk(ElabTyped::Mk(
              ⊢ KernelTerm from match elab_direct_member(j, env, name, vs, done) {
                Some(made) => made
                None => elab_apps(KernelConst(name), List::append(vs, done))
              },
              elab_subst(ty, sols)
            ))
          }
          }
          }
        }
        Cons(arg, rest) => ⊢ ElabResult(ElabTyped) from match kernel_as_pi(kernel_whnf(j, &mut core, ty, true, false)) {
          None => ElabErr("application expects a function")
          Some(p) => {
            // A lambda whose parameter type is not known yet waits for the
            // arguments after it to solve the implicit arguments, as the
            // host postpones it.
            let early: List(Nat × KernelTerm) := if elab_is_waiting(arg) && elab_any_occurs(elab_subst(p.fst, sols), elab_unsolved(holes, sols)) {
              let before := kernel_snapshot(core)
              let later := elab_presolve(j, &mut core, env, holes, sols, kernel_inst(p.snd, KernelConst("#postponed")), rest)
              kernel_set_to(&mut core, before)
              // The expected type then fixes what the arguments left, when
              // the result does not depend on the arguments still to come.
              ⊢ List(Nat × KernelTerm) from match want {
                None => later
                Some(w) => ⊢ List(Nat × KernelTerm) from match elab_result_after(j, &mut core, ty, 1 + List::length(rest)) {
                  None => later
                  Some(r) => {
                    let head := kernel_beta_head(j, &mut core, w)
                    ⊢ List(Nat × KernelTerm) from match elab_unify(j, &mut core, holes, r, head, later) {
                      None => later
                      Some(s2) => s2
                    }
                  }
                }
              }
            } else { sols }
            let sols := early
            let domain := elab_subst(p.fst, sols)
            let elaborated: ElabResult(KernelTerm × List(Nat × KernelTerm)) := if elab_any_occurs(domain, elab_unsolved(holes, sols)) {
              ⊢ ElabResult(KernelTerm × List(Nat × KernelTerm)) from match elab_inferred_arg(j, &mut core, env, arg, domain, elab_unsolved(holes, sols)) {
                // An argument that cannot be read before its type is known
                // (a bare `None`) waits for the arguments after it to solve
                // the implicit arguments, as the host postpones it.
                ElabErr(e) => {
                  let hole := kernel_fresh(&mut core, domain)
                  let later := elab_drop_mentioning(elab_presolve(j, &mut core, env, holes, sols, kernel_inst(p.snd, KernelFVar(hole)), rest), hole, sols)
                  let again := elab_subst(p.fst, later)
                  if elab_any_occurs(again, elab_unsolved(holes, later)) { ElabErr(e) } else {
                    ⊢ ElabResult(KernelTerm × List(Nat × KernelTerm)) from match elab_term(j, &mut core, env, arg, Some(again)) {
                      ElabErr(e2) => ElabErr(e2)
                      ElabOk(t) => ElabOk(#(t.value, later))
                    }
                  }
                }
                ElabOk(t) => ⊢ ElabResult(KernelTerm × List(Nat × KernelTerm)) from match elab_unify(j, &mut core, holes, domain, t.ty, sols) {
                  None => ElabErr("an argument's type does not match its parameter")
                  Some(s) => ElabOk(#(t.value, s))
                }
              }
            } else {
              ⊢ ElabResult(KernelTerm × List(Nat × KernelTerm)) from match elab_term(j, &mut core, env, arg, Some(domain)) {
                ElabErr(e) => ElabErr(e)
                ElabOk(t) => ElabOk(#(t.value, sols))
              }
            }
            ⊢ ElabResult(ElabTyped) from match elaborated {
              ElabErr(e) => ElabErr(e)
              ElabOk(v) => elab_implicit_arguments(
                j,
                &mut core,
                env,
                holes,
                v.snd,
                kernel_inst(p.snd, v.fst),
                rest,
                List::append(done, Cons(v.fst, Nil)),
                name,
                want
              )
            }
          }
        }
      }
    }
  }

  // The holes of a class's record type (`Ord(K)`, `Ord::laws(K, d)`) left
  // unsolved, each solved by the record in scope or by an instance.
  pub fn elab_dict_solutions(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    holes: List(Nat),
    all: List(Nat),
    sols: List(Nat × KernelTerm)
  ): List(Nat × KernelTerm) {
    match k {
      Zero => sols
      Succ(j) => ⊢ List(Nat × KernelTerm) from match holes {
        Nil => sols
        Cons(h, rest) => ⊢ List(Nat × KernelTerm) from match elab_solution(sols, h) {
          Some(^v) => elab_dict_solutions(j, &mut core, env, rest, all, sols)
          None => {
            let goal := elab_subst(elab_atom_type(core, h), sols)
            if elab_is_dict_type(j, env, goal) && elab_any_occurs(goal, elab_unsolved(all, sols)) == false {
              ⊢ List(Nat × KernelTerm) from match elab_find_dict(j, &mut core, env, goal) {
                Some(v) => elab_dict_solutions(j, &mut core, env, rest, all, Cons(#(h, v), sols))
                None => elab_dict_solutions(j, &mut core, env, rest, all, sols)
              }
            } else { elab_dict_solutions(j, &mut core, env, rest, all, sols) }
          }
        }
      }
    }
  }

  // Find the unique instance builder whose complete result type matches the
  // requested dictionary. A class may have several instances with the same
  // first argument's head and different later arguments.
  pub fn elab_instance_builder(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    r#class: Text,
    head: Text,
    goal: KernelTerm,
    laws: Bool,
    found: Option(Text),
    ambiguous: Bool
  ): Option(Text) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(Text) from match env {
        Nil => if ambiguous { None } else { found }
        Cons(binding, rest) => {
          let prefix := Text::concat_all(["#instance ", r#class, " ", head])
          let matching := binding.name == prefix || text_starts_with(binding.name, Text::concat(prefix, "@"), 0)
          if matching {
            let pick: KernelTerm := if laws { binding.ty } else { binding.value }
            ⊢ Option(Text) from match pick {
              KernelConst(global) => {
                let before := kernel_snapshot(core)
                let trial := elab_implicit_application(j, &mut core, env, global, Nil, Some(goal))
                kernel_set_to(&mut core, before)
                ⊢ Option(Text) from match trial {
                  ElabOk(^value) => ⊢ Option(Text) from match found {
                    None => elab_instance_builder(j, &mut core, rest, r#class, head, goal, laws, Some(global), ambiguous)
                    Some(previous) => elab_instance_builder(j, &mut core, rest, r#class, head, goal, laws, Some(previous), true)
                  }
                  ElabErr(^message) => elab_instance_builder(j, &mut core, rest, r#class, head, goal, laws, found, ambiguous)
                }
              }
              _ => elab_instance_builder(j, &mut core, rest, r#class, head, goal, laws, found, ambiguous)
            }
          } else { elab_instance_builder(j, &mut core, rest, r#class, head, goal, laws, found, ambiguous) }
        }
      }
    }
  }

  pub fn elab_known_at(k: Nat, known: List(Bool), index: Nat): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match known {
        Nil => false
        Cons(value, rest) => ⊢ Bool from match index {
          Zero => value
          Succ(next) => elab_known_at(j, rest, next)
        }
      }
    }
  }

  pub fn elab_infer_gate(k: Nat, tokens: List(Text), known: List(Bool)): Option(Bool × List(Text)) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(Bool × List(Text)) from match tokens {
        Cons(tag, rest) => if tag == "P" {
          ⊢ Option(Bool × List(Text)) from match rest {
            Cons(index, tail) => ⊢ Option(Bool × List(Text)) from match elab_parse_nat(index) {
              None => None
              Some(at) => Some(#(elab_known_at(j, known, at), tail))
            }
            Nil => None
          }
        } else if tag == "A" || tag == "O" {
          ⊢ Option(Bool × List(Text)) from match elab_infer_gate(j, rest, known) {
            None => None
            Some(left) => ⊢ Option(Bool × List(Text)) from match elab_infer_gate(j, left.snd, known) {
              None => None
              Some(right) => Some(#(if tag == "A" { left.fst && right.fst } else { left.fst || right.fst }, right.snd))
            }
          }
        } else { None }
        Nil => None
      }
    }
  }

  pub fn elab_infer_enabled(k: Nat, env: List(ElabBinding), global: Text, known: List(Bool)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match elab_lookup(env, Text::concat("#infer ", global)) {
        None => false
        Some(binding) => ⊢ Bool from match binding.value {
          KernelConst(encoded) => ⊢ Bool from match elab_infer_gate(j, text_split(encoded, ","), known) {
            Some(result) => result.fst && List::length(result.snd) == 0
            None => false
          }
          _ => false
        }
      }
    }
  }

  pub fn elab_infer_known(k: Nat, args: List(KernelTerm), unsolved: List(Nat)): List(Bool) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(Bool) from match args {
        Nil => Nil
        Cons(arg, rest) => Cons(elab_any_occurs(arg, unsolved) == false, elab_infer_known(j, rest, unsolved))
      }
    }
  }

  pub fn elab_type_flags(k: Nat, words: List(Text)): List(Bool) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(Bool) from match words {
        Nil => Nil
        Cons(word, rest) => Cons(word == "T", elab_type_flags(j, rest))
      }
    }
  }

  pub fn elab_class_type_heads(k: Nat, env: List(ElabBinding), class_name: Text): List(Bool) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(Bool) from match elab_lookup(env, Text::concat("#class ", class_name)) {
        None => Nil
        Some(binding) => ⊢ List(Bool) from match binding.ty {
          KernelConst(encoded) => ⊢ List(Bool) from match text_split(encoded, "|") {
            Cons(^methods, Cons(^laws, Cons(^parameters, Cons(flags, Nil)))) => elab_type_flags(j, text_split(flags, ","))
            _ => Nil
          }
          _ => Nil
        }
      }
    }
  }

  pub fn elab_infer_match_known(
    k: Nat,
    core: &mut KernelCore,
    generic_holes: List(Nat),
    patterns: List(KernelTerm),
    actual: List(KernelTerm),
    known: List(Bool),
    sols: List(Nat × KernelTerm)
  ): Option(List(Nat × KernelTerm)) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(List(Nat × KernelTerm)) from match patterns {
        Nil => ⊢ Option(List(Nat × KernelTerm)) from match actual {
          Nil => Some(sols)
          _ => None
        }
        Cons(pattern, more) => ⊢ Option(List(Nat × KernelTerm)) from match actual {
          Nil => None
          Cons(value, values) => ⊢ Option(List(Nat × KernelTerm)) from match known {
            Nil => None
            Cons(is_known, flags) => if is_known {
              ⊢ Option(List(Nat × KernelTerm)) from match elab_unify(j, &mut core, generic_holes, pattern, value, sols) {
                None => None
                Some(next) => elab_infer_match_known(j, &mut core, generic_holes, more, values, flags, next)
              }
            } else { elab_infer_match_known(j, &mut core, generic_holes, more, values, flags, sols) }
          }
        }
      }
    }
  }

  pub fn elab_infer_fill(
    k: Nat,
    core: &mut KernelCore,
    outer_holes: List(Nat),
    generic_holes: List(Nat),
    patterns: List(KernelTerm),
    actual: List(KernelTerm),
    known: List(Bool),
    type_heads: List(Bool),
    generic_sols: List(Nat × KernelTerm),
    outer_sols: List(Nat × KernelTerm)
  ): Option(List(Nat × KernelTerm)) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(List(Nat × KernelTerm)) from match patterns {
        Nil => ⊢ Option(List(Nat × KernelTerm)) from match actual {
          Nil => Some(outer_sols)
          _ => None
        }
        Cons(pattern, more) => ⊢ Option(List(Nat × KernelTerm)) from match actual {
          Nil => None
          Cons(value, values) => ⊢ Option(List(Nat × KernelTerm)) from match known {
            Nil => None
            Cons(is_known, flags) => ⊢ Option(List(Nat × KernelTerm)) from match type_heads {
              Nil => None
              Cons(type_head, remaining_types) => if is_known {
                elab_infer_fill(j, &mut core, outer_holes, generic_holes, more, values, flags, remaining_types, generic_sols, outer_sols)
              } else if type_head == false { None } else {
                let complete := elab_subst(pattern, generic_sols)
                if elab_any_occurs(complete, generic_holes) { None } else {
                  ⊢ Option(List(Nat × KernelTerm)) from match elab_unify(j, &mut core, outer_holes, value, complete, outer_sols) {
                    None => None
                    Some(next) => elab_infer_fill(j, &mut core, outer_holes, generic_holes, more, values, flags, remaining_types, generic_sols, next)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn elab_infer_candidate(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    global: Text,
    class_name: Text,
    type_heads: List(Bool),
    actual: List(KernelTerm),
    known: List(Bool),
    outer_holes: List(Nat),
    outer_sols: List(Nat × KernelTerm)
  ): Option(Option(List(Nat × KernelTerm))) {
    match k {
      Zero => None
      Succ(j) => if elab_infer_enabled(j, env, global, known) == false { None } else {
        ⊢ Option(Option(List(Nat × KernelTerm))) from match kernel_global_get(core, global) {
          None => None
          Some(decl) => ⊢ Option(Option(List(Nat × KernelTerm))) from match elab_holes(j, &mut core, decl.ty, elab_implicit_count(env, core, global)) {
            None => None
            Some(opened) => {
              let spine := elab_spine(j, opened.snd, Nil)
              ⊢ Option(Option(List(Nat × KernelTerm))) from match spine.fst {
                KernelConst(name) => if name == class_name {
                  ⊢ Option(Option(List(Nat × KernelTerm))) from match elab_infer_match_known(j, &mut core, opened.fst, spine.snd, actual, known, Nil) {
                    None => None
                    Some(generic_sols) => Some(elab_infer_fill(j, &mut core, outer_holes, opened.fst, spine.snd, actual, known, type_heads, generic_sols, outer_sols))
                  }
                } else { None }
                _ => None
              }
            }
          }
        }
      }
    }
  }

  pub fn elab_infer_select(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    candidates: List(ElabBinding),
    class_name: Text,
    type_heads: List(Bool),
    actual: List(KernelTerm),
    known: List(Bool),
    outer_holes: List(Nat),
    outer_sols: List(Nat × KernelTerm),
    found: Option(Option(List(Nat × KernelTerm))),
    ambiguous: Bool
  ): ElabInferChoice {
    match k {
      Zero => InferNoRule
      Succ(j) => ⊢ ElabInferChoice from match candidates {
        Nil => if ambiguous { InferAmbiguous } else { ⊢ ElabInferChoice from match found {
          None => InferNoRule
          Some(choice) => InferChosen(choice)
        } }
        Cons(binding, rest) => if text_starts_with(binding.name, Text::concat_all(["#instance ", class_name, " "]), 0) {
          ⊢ ElabInferChoice from match binding.value {
            KernelConst(global) => {
              let before := kernel_snapshot(core)
              let trial := elab_infer_candidate(j, &mut core, env, global, class_name, type_heads, actual, known, outer_holes, outer_sols)
              kernel_set_to(&mut core, before)
              ⊢ ElabInferChoice from match trial {
                None => elab_infer_select(j, &mut core, env, rest, class_name, type_heads, actual, known, outer_holes, outer_sols, found, ambiguous)
                Some(sols) => ⊢ ElabInferChoice from match found {
                  None => elab_infer_select(j, &mut core, env, rest, class_name, type_heads, actual, known, outer_holes, outer_sols, Some(sols), ambiguous)
                  Some(previous) => elab_infer_select(j, &mut core, env, rest, class_name, type_heads, actual, known, outer_holes, outer_sols, Some(previous), true)
                }
              }
            }
            _ => elab_infer_select(j, &mut core, env, rest, class_name, type_heads, actual, known, outer_holes, outer_sols, found, ambiguous)
          }
        } else { elab_infer_select(j, &mut core, env, rest, class_name, type_heads, actual, known, outer_holes, outer_sols, found, ambiguous) }
      }
    }
  }

  pub fn elab_infer_merge(
    k: Nat,
    core: &mut KernelCore,
    holes: List(Nat),
    candidate: List(Nat × KernelTerm),
    accumulated: List(Nat × KernelTerm)
  ): Option(List(Nat × KernelTerm)) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(List(Nat × KernelTerm)) from match holes {
        Nil => Some(accumulated)
        Cons(h, rest) => ⊢ Option(List(Nat × KernelTerm)) from match elab_solution(candidate, h) {
          None => elab_infer_merge(j, &mut core, rest, candidate, accumulated)
          Some(value) => ⊢ Option(List(Nat × KernelTerm)) from match elab_solution(accumulated, h) {
            None => elab_infer_merge(j, &mut core, rest, candidate, Cons(#(h, value), accumulated))
            Some(existing) => if kernel_conv(j, &mut core, existing, value) {
              elab_infer_merge(j, &mut core, rest, candidate, accumulated)
            } else { None }
          }
        }
      }
    }
  }

  pub fn elab_infer_solutions(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    dict_holes: List(Nat),
    all_holes: List(Nat),
    input_sols: List(Nat × KernelTerm),
    selected_sols: List(Nat × KernelTerm)
  ): ElabResult(List(Nat × KernelTerm)) {
    match k {
      Zero => ElabErr("elaboration exhausted")
      Succ(j) => ⊢ ElabResult(List(Nat × KernelTerm)) from match dict_holes {
        Nil => ElabOk(selected_sols)
        Cons(h, rest) => ⊢ ElabResult(List(Nat × KernelTerm)) from match elab_solution(input_sols, h) {
          Some(^value) => elab_infer_solutions(j, &mut core, env, rest, all_holes, input_sols, selected_sols)
          None => {
            let goal := elab_subst(elab_atom_type(core, h), input_sols)
            let spine := elab_spine(j, goal, Nil)
            ⊢ ElabResult(List(Nat × KernelTerm)) from match spine.fst {
              KernelConst(class_name) => if elab_is_dict_type(j, env, goal) && elab_any_occurs(goal, elab_unsolved(all_holes, input_sols)) {
                let known := elab_infer_known(j, spine.snd, elab_unsolved(all_holes, input_sols))
                ⊢ ElabResult(List(Nat × KernelTerm)) from match elab_infer_select(j, &mut core, env, env, class_name, elab_class_type_heads(j, env, class_name), spine.snd, known, all_holes, input_sols, None, false) {
                  InferNoRule => elab_infer_solutions(j, &mut core, env, rest, all_holes, input_sols, selected_sols)
                  InferAmbiguous => ElabErr("ambiguous class instance")
                  InferChosen(result) => ⊢ ElabResult(List(Nat × KernelTerm)) from match result {
                    None => ElabErr("infer from does not determine all required type arguments")
                    Some(candidate) => ⊢ ElabResult(List(Nat × KernelTerm)) from match elab_infer_merge(j, &mut core, all_holes, candidate, selected_sols) {
                      None => ElabErr("infer from instances disagree on a type argument")
                      Some(merged) => elab_infer_solutions(j, &mut core, env, rest, all_holes, input_sols, merged)
                    }
                  }
                }
              } else { elab_infer_solutions(j, &mut core, env, rest, all_holes, input_sols, selected_sols) }
              _ => elab_infer_solutions(j, &mut core, env, rest, all_holes, input_sols, selected_sols)
            }
          }
        }
      }
    }
  }

  // The record of type `goal`: one in scope (a parameter `inst@C0`), else the
  // unique matching declared instance.
  pub fn elab_find_dict(k: Nat, core: &mut KernelCore, env: List(ElabBinding), goal: KernelTerm): Option(KernelTerm) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(KernelTerm) from match elab_local_dict(j, &mut core, env, env, goal) {
        Some(v) => Some(v)
        None => {
          let spine := elab_spine(j, goal, Nil)
          ⊢ Option(KernelTerm) from match spine.fst {
            KernelConst(n) => ⊢ Option(KernelTerm) from match spine.snd {
              Cons(first, ^more) => ⊢ Option(KernelTerm) from match elab_spine(j, first, Nil).fst {
                KernelConst(h) => {
                  let exact := elab_lookup(env, Text::concat_all(["#instance ", elab_class_of_name(n), " ", h]))
                  let selected := ⊢ Option(Text) from match exact {
                    Some(binding) => {
                      let pick: KernelTerm := if elab_is_laws_name(env, n) { binding.ty } else { binding.value }
                      ⊢ Option(Text) from match pick {
                        KernelConst(global) => Some(global)
                        _ => None
                      }
                    }
                    None => elab_instance_builder(j, &mut core, env, elab_class_of_name(n), h, goal, elab_is_laws_name(env, n), None, false)
                  }
                  ⊢ Option(KernelTerm) from match selected {
                  None => None
                  Some(g) => {
                   ⊢ Option(KernelTerm) from match elab_implicit_application(j, &mut core, env, g, Nil, Some(goal)) {
                      ElabOk(t) => Some(t.value)
                      ElabErr(^e) => None
                    }
                  }
                }
                }
                _ => None
              }
              Nil => None
            }
            _ => None
          }
        }
      }
    }
  }

  // An argument elaborated without its parameter's type. A lambda `x => b`
  // whose parameter's type is known takes it, and its body's type is
  // inferred: `Eq::congr(x => Succ(x), h)` finds the codomain so.
  pub fn elab_inferred_arg(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    arg: SurfaceTerm,
    domain: KernelTerm,
    unsolved: List(Nat)
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(ElabTyped) from match elab_lambda_parts(arg) {
        Some(parts) => ⊢ ElabResult(ElabTyped) from match parts.fst {
          Cons(name, Nil) => {
            let body := parts.snd.fst
            // The type written on the parameter, else the parameter's own.
            let written: Option(KernelTerm) := ⊢ Option(KernelTerm) from match parts.snd.snd {
              Some(w) => ⊢ Option(KernelTerm) from match elab_type(j, &mut core, env, w) {
                ElabOk(wt) => Some(wt)
                ElabErr(^e) => None
              }
              _ => ⊢ Option(KernelTerm) from match kernel_as_pi(kernel_whnf(j, &mut core, domain, true, false)) {
                None => None
                Some(dc) => if elab_any_occurs(dc.fst, unsolved) { None } else { Some(dc.fst) }
              }
            }
            ⊢ ElabResult(ElabTyped) from match written {
              None => elab_term(j, &mut core, env, arg, None)
              Some(pt) => {
                let saved := core.locals
                let atom := kernel_fresh(&mut core, pt)
                let inner := elab_term(j, &mut core, Cons(ElabBinding::Mk(name, KernelFVar(atom), pt), env), body, None)
                kernel_set_to(&mut core.locals, saved)
                ⊢ ElabResult(ElabTyped) from match inner {
                  ElabErr(e) => ElabErr(e)
                  ElabOk(t) => ElabOk(ElabTyped::Mk(kernel_lam(kernel_abstract_at(t.value, 0, atom)), kernel_pi(pt, kernel_abstract_at(t.ty, 0, atom))))
                }
              }
            }
          }
          _ => elab_term(j, &mut core, env, arg, None)
        }
        None => elab_term(j, &mut core, env, arg, None)
      }
    }
  }

  // The implicit arguments the explicit `args` solve, elaborated at their
  // parameters' types; what cannot be read yet is left unsolved.
  pub fn elab_presolve(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    holes: List(Nat),
    sols: List(Nat × KernelTerm),
    ty: KernelTerm,
    args: List(SurfaceTerm)
  ): List(Nat × KernelTerm) {
    match k {
      Zero => sols
      Succ(j) => ⊢ List(Nat × KernelTerm) from match args {
        Nil => sols
        Cons(arg, rest) => ⊢ List(Nat × KernelTerm) from match kernel_as_pi(kernel_whnf(j, &mut core, ty, true, false)) {
          None => sols
          Some(p) => {
            let domain := elab_subst(p.fst, sols)
            if elab_mentions_postponed(domain) || elab_is_lambda(arg) { sols } else {
              ⊢ List(Nat × KernelTerm) from match elab_term(j, &mut core, env, arg, None) {
                // An argument that cannot be read yet (a bare `None`) solves
                // nothing, and the ones after it still do: what they solve
                // may not mention it.
                ElabErr(^e) => {
                  let hole := kernel_fresh(&mut core, domain)
                  elab_drop_mentioning(elab_presolve(j, &mut core, env, holes, sols, kernel_inst(p.snd, KernelFVar(hole)), rest), hole, sols)
                }
                ElabOk(t) => ⊢ List(Nat × KernelTerm) from match elab_unify(j, &mut core, holes, domain, t.ty, sols) {
                  None => sols
                  Some(s2) => elab_presolve(j, &mut core, env, holes, s2, kernel_inst(p.snd, t.value), rest)
                }
              }
            }
          }
        }
      }
    }
  }

  // A match whose indices are not distinct variables (see `ElabGen`).
  pub fn elab_general_match(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    x: Nat,
    info: KernelIndInfo,
    family: Text,
    params: List(KernelTerm),
    idx: List(KernelTerm),
    arms: List(SurfaceArm),
    expected: KernelTerm
  ): ElabResult(ElabTyped) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => if List::length(info.group) != 1 {
        ElabErr("a match on indices that are not distinct variables is supported on a family outside a mutual group")
      } else if elab_any_occurs(expected, Cons(x, Nil)) {
        ElabErr("a match on indices that are not distinct variables, whose type mentions the matched value, is unsupported")
      } else if elab_arms_known(arms, info.constructors, family) == false || elab_arms_distinct(arms, info.constructors, family, Nil) == false {
        ElabErr("a match needs at most one plain arm per constructor")
      } else { ⊢ ElabResult(ElabTyped) from match kernel_global_get(core, family) {
        None => ElabErr("unknown family")
        Some(fg) => ⊢ ElabResult(ElabTyped) from match elab_instantiate(j, fg.ty, params) {
          None => ElabErr("cannot instantiate the family")
          Some(fty) => ⊢ ElabResult(ElabTyped) from match elab_index_types(j, &mut core, fty, info.indices, Nil) {
            None => ElabErr("a match on indices whose types depend on each other is unsupported")
            Some(tys) => {
              let split := elab_split_indices(&mut core, idx, tys, 0, x, Nil)
              let vars := elab_vars_of(split.fst, idx)
              if elab_gen_args_mention(split.snd, vars) {
                ElabErr("a match whose generalized indices mention its variable indices is unsupported")
              } else if elab_dependents(env, Cons(x, vars), Cons(x, vars)) {
                ElabErr("a match whose variable or indices other variables depend on is unsupported")
              } else {
                let body := elab_gen_eq_pis(&mut core, split.snd, split.fst, expected)
                let motive := elab_lams(body, List::append(split.fst, Cons(x, Nil)))
                let is_prop := elab_is_prop(j, &mut core, expected)
                ⊢ ElabResult(ElabTyped) from match elab_general_minors(j, &mut core, env, info, info.constructors, arms, family, params, motive, split.snd, x, is_prop) {
                  ElabErr(e) => ElabErr(e)
                  ElabOk(minors) => {
                    let eliminator := elab_eliminator(j, &mut core, env, family, expected)
                    elab_result(
                    j,
                    &mut core,
                    elab_apps(
                      KernelConst(eliminator),
                      List::append(params, Cons(motive, List::append(minors, List::append(idx, Cons(KernelFVar(x), elab_gen_refls(split.snd))))))
                    ),
                    Some(expected)
                  )
                  }
                }
              }
            }
          }
        }
      } }
    }
  }

  pub fn elab_general_minors(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    info: KernelIndInfo,
    ctors: List(KernelCtorInfo),
    arms: List(SurfaceArm),
    family: Text,
    params: List(KernelTerm),
    motive: KernelTerm,
    gens: List(ElabGen),
    x: Nat,
    is_prop: Bool
  ): ElabResult(List(KernelTerm)) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(List(KernelTerm)) from match ctors {
        Nil => ElabOk(Nil)
        Cons(c, rest) => {
          let found: ElabResult(Option(List(Option(Text)) × SurfaceTerm)) := ⊢ ElabResult(Option(List(Option(Text)) × SurfaceTerm)) from match elab_arm_of(arms, info.constructors, c.name, family) {
            None => ElabOk(None)
            Some(f) => ⊢ ElabResult(Option(List(Option(Text)) × SurfaceTerm)) from match elab_bound_names(f.snd) {
              None => ElabErr("constructor patterns bind variables or `_`")
              Some(ns) => if List::length(ns) != c.nargs { ElabErr("a pattern has the wrong number of fields") } else {
                ElabOk(Some(#(ns, f.fst.body)))
              }
            }
          }
          ⊢ ElabResult(List(KernelTerm)) from match found {
            ElabErr(e) => ElabErr(e)
            ElabOk(arm) => {
              let saved := core.locals
              let minor := elab_general_case(j, &mut core, env, c, arm, params, motive, gens, x, is_prop)
              kernel_set_to(&mut core.locals, saved)
              ⊢ ElabResult(List(KernelTerm)) from match minor {
                ElabErr(e) => ElabErr(e)
                ElabOk(m) => ⊢ ElabResult(List(KernelTerm)) from match elab_general_minors(j, &mut core, env, info, rest, arms, family, params, motive, gens, x, is_prop) {
                  ElabErr(e) => ElabErr(e)
                  ElabOk(ms) => ElabOk(Cons(m, ms))
                }
              }
            }
          }
        }
      }
    }
  }

  // One case: the fields, their induction hypotheses and the equations are
  // bound; the equations are solved, and the arm is elaborated with the
  // solved variables replaced, then transported back.
  pub fn elab_general_case(
    k: Nat,
    core: &mut KernelCore,
    env: List(ElabBinding),
    c: KernelCtorInfo,
    arm: Option(List(Option(Text)) × SurfaceTerm),
    params: List(KernelTerm),
    motive: KernelTerm,
    gens: List(ElabGen),
    x: Nat,
    is_prop: Bool
  ): ElabResult(KernelTerm) {
    match k {
      Zero => { kernel_set_to(&mut core.exhausted, true)
        ElabErr("elaboration exhausted") }
      Succ(j) => ⊢ ElabResult(KernelTerm) from match kernel_global_get(core, c.name) {
        None => ElabErr("unknown constructor")
        Some(g) => ⊢ ElabResult(KernelTerm) from match elab_instantiate(j, g.ty, params) {
          None => ElabErr("cannot instantiate the constructor")
          Some(cty) => ⊢ ElabResult(KernelTerm) from match elab_open_fields(j, &mut core, cty, c.nargs) {
            None => ElabErr("a constructor has fewer fields than its pattern")
            Some(fs) => {
              let fields := fs.fst
              let names: List(Option(Text)) := ⊢ List(Option(Text)) from match arm {
                None => Nil
                Some(a) => a.fst
              }
              let named := elab_gen_bind_fields(env, names, fields, fs.snd)
              let rty := ⊢ KernelTerm from match elab_instantiate(j, cty, elab_fvars(fields)) {
                None => KernelConst("Unit")
                Some(t) => t
              }
              let idx := elab_type_indices(j, &mut core, rty, List::length(params))
              ⊢ ElabResult(KernelTerm) from match elab_general_ihs(j, &mut core, fields, 0, c, motive, List::length(params)) {
                None => ElabErr("a match on indices that are not distinct variables, on a family with function-typed recursive fields, is unsupported")
                Some(ihs) => {
                  let cval := elab_apps(KernelConst(c.name), List::append(params, elab_fvars(fields)))
                  let applied := kernel_whnf(j, &mut core, elab_apps(motive, List::append(idx, Cons(cval, Nil))), true, false)
                  ⊢ ElabResult(KernelTerm) from match elab_strip_eqs(j, &mut core, applied, List::length(gens)) {
                    None => ElabErr("the motive has no equation binder")
                    Some(st) => {
                      let eqs := st.fst
                      let goal := st.snd
                      let binders := List::append(fields, List::append(ihs, eqs))
                      let local := List::append(elab_env_atoms(env), List::append(fields, ihs))
                      let plan := elab_unify_indices(j, &mut core, elab_without(local, x), elab_index_work(gens, idx, eqs, Nil), Nil, false, goal)
                      ⊢ ElabResult(KernelTerm) from match plan {
                        PlanErr(e) => ElabErr(e)
                        PlanImpossible(a) => ElabOk(elab_lams(a, binders))
                        PlanSolved(sols) => ⊢ ElabResult(KernelTerm) from match arm {
                          None => ElabErr("a constructor has no arm")
                          Some(a) => ⊢ ElabResult(KernelTerm) from match sols {
                            Nil => ⊢ ElabResult(KernelTerm) from match elab_term(j, &mut core, named, a.snd, Some(goal)) {
                              ElabErr(e) => ElabErr(e)
                              ElabOk(t) => ElabOk(elab_lams(t.value, binders))
                            }
                            _ => {
                              let dep := elab_unshadowed_atoms(env, elab_dependent_atoms(core, local, false, x, elab_sol_atoms(sols)))
                              if elab_sols_mention(sols, dep) {
                                ElabErr("a solved index mentions a variable whose type depends on a solved one")
                              } else {
                                // The arm sees each dependent binding again, at its type
                                // with the solved variables replaced.
                                let primed := elab_prime(&mut core, dep, sols)
                                ⊢ ElabResult(KernelTerm) from match elab_term(j, &mut core, elab_replace_env(named, primed.snd), a.snd, Some(elab_replace_all(goal, sols))) {
                                  ElabErr(e) => ElabErr(e)
                                  ElabOk(t) => {
                                    let deps := List::append(dep, eqs)
                                    let inner := elab_lams(t.value, List::append(primed.fst, eqs))
                                    let full := elab_gen_pis_over(deps, elab_atom_types(core, deps), goal)
                                    let elim: Text := if is_prop { "Eq::ind" } else { "Eq::rec" }
                                    let cur := elab_transport(&mut core, elim, sols, elab_states(full, sols), inner)
                                    ElabOk(elab_lams(elab_apps(cur, elab_fvars(deps)), binders))
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// Why `name` is not declared: an imported declaration the elaborator could
// not read says why, so that a library gap is never a bare "not declared".
pub fn elab_undeclared(env: List(ElabBinding), name: Text): Text {
  elab_undeclared_in(env, env, name, name)
}

// `name` as written, then as each enclosing module would qualify it.
pub fn elab_undeclared_in(all: List(ElabBinding), env: List(ElabBinding), written: Text, name: Text): Text {
  match env {
    Nil => Text::concat_all(["`", written, "` is not declared"])
    Cons(b, rest) => if b.name == "#unread" {
      ⊢ Text from match b.value {
        KernelConst(n) => if n == name || elab_module_qualifies(all, n, written) {
          ⊢ Text from match b.ty {
            KernelConst(why) => Text::concat_all(["`", n, "` is imported but not declared: ", why])
            _ => elab_undeclared_in(all, rest, written, name)
          }
        } else { elab_undeclared_in(all, rest, written, name) }
        _ => elab_undeclared_in(all, rest, written, name)
      }
    } else { elab_undeclared_in(all, rest, written, name) }
  }
}

// Whether `n` is `M::written` for a module `M` the bindings are inside.
pub fn elab_module_qualifies(env: List(ElabBinding), n: Text, written: Text): Bool {
  match env {
    Nil => false
    Cons(b, rest) => {
      let here := ⊢ Bool from match b.value {
        KernelConst(m) => b.name == "#module" && n == Text::concat_all([m, "::", written])
        _ => false
      }
      here || elab_module_qualifies(rest, n, written)
    }
  }
}


// The value of a natural literal, of any size: `Nat` has no bound.
pub fn elab_parse_nat(t: Text): Option(Nat) {
  if Text::len(t) == 0 { None } else { elab_parse_digits(Text::len(t), t, 0, 0) }
}

pub fn elab_parse_digits(k: Nat, t: Text, at: Nat, acc: Nat): Option(Nat) {
  match k {
    Zero => Some(acc)
    Succ(j) => ⊢ Option(Nat) from match text_digit(Text::byte_value(t, at)) {
      None => if Text::byte_value(t, at) == 95 { elab_parse_digits(j, t, at + 1, acc) } else { None }
      Some(d) => elab_parse_digits(j, t, at + 1, acc * 10 + d)
    }
  }
}

// A `match` or a lambda, which waits for the type it is read at.
pub fn elab_is_waiting(t: SurfaceTerm): Bool {
  match t.kind {
    SkMatch(^s, ^m, ^arms, ^b, _) => true
    _ => elab_is_lambda(t)
  }
}

pub fn elab_is_lambda(t: SurfaceTerm): Bool {
  match elab_lambda_parts(t) {
    Some(^p) => true
    None => false
  }
}

// A lambda's parameters, body, and the type written on its first parameter:
// `x => b`, or `(x: T) => b` as `#typed_lam(λ, T…)` or with its types.
pub fn elab_lambda_parts(t: SurfaceTerm): Option(List(Text) × (SurfaceTerm × Option(SurfaceTerm))) {
  match t.kind {
    SkLam(ps, b, ts, _) => Some(#(ps, #(b, ⊢ Option(SurfaceTerm) from match ts {
      Cons(Some(w), ^more) => Some(w)
      _ => None
    })))
    SkApp(h, args) => ⊢ Option(List(Text) × (SurfaceTerm × Option(SurfaceTerm))) from match h.kind {
      SkVar(n) => if surface_name_text(n) == "#typed_lam" {
        ⊢ Option(List(Text) × (SurfaceTerm × Option(SurfaceTerm))) from match args {
          Cons(lam, types) => ⊢ Option(List(Text) × (SurfaceTerm × Option(SurfaceTerm))) from match lam.kind {
            SkLam(ps, b, ^ts, _) => Some(#(ps, #(b, elab_first_type(types))))
            _ => None
          }
          Nil => None
        }
      } else { None }
      _ => None
    }
    _ => None
  }
}

// Whether a type mentions the placeholder of a postponed argument.
pub fn elab_mentions_postponed(t: KernelTerm): Bool {
  match t {
    KernelConst(n) => n == "#postponed"
    KernelPi(a, b, ^d) => elab_mentions_postponed(a) || elab_mentions_postponed(b)
    KernelLam(b, ^d) => elab_mentions_postponed(b)
    KernelApp(f, a, ^d) => elab_mentions_postponed(f) || elab_mentions_postponed(a)
    _ => false
  }
}

// The eliminator of a match: the family's `ind` when the value is a proof,
// as the host compiles it, else `rec`.
pub fn elab_eliminator(k: Nat, core: &mut KernelCore, env: List(ElabBinding), family: Text, expected: KernelTerm): Text {
  if elab_is_prop(k, &mut core, expected) && elab_has_global(core, Text::concat(family, "::ind")) { Text::concat(family, "::ind") } else { Text::concat(family, "::rec") }
}

pub fn elab_has_global(core: KernelCore, name: Text): Bool {
  match kernel_global_get(core, name) {
    Some(^g) => true
    None => false
  }
}

// The bindings, oldest first, whose types mention one of `deps` or a binding
// before them that does.
// A match inside the arms of a match that generalized the parameters, none
// of whose arms calls the declaration: its generalized parameters are the
// ones the arms bind, so it generalizes by the names in scope.
pub fn elab_nested_in_gen(k: Nat, env: List(ElabBinding), recursion: Option(ElabRecursion), arms: List(SurfaceArm)): Bool {
  match recursion {
    None => false
    Some(r) => elab_bound_with(env, Text::concat("#gen ", r.name)) && elab_outside_self(k, env, arms)
  }
}

// The arm of a match on a variable binds what the matched variable is there:
// the constructor applied to its fields.
pub fn elab_with_built(env: List(ElabBinding), built: KernelTerm, rest: List(ElabBinding)): List(ElabBinding) {
  match elab_lookup(env, "#on") {
    None => rest
    Some(on) => Cons(ElabBinding::Mk("#built", built, on.value), rest)
  }
}

// The variable a term is the arm's constructor of, from the innermost match.
pub fn elab_built_atom(env: List(ElabBinding), t: KernelTerm): Option(Nat) {
  match env {
    Nil => None
    Cons(b, rest) => if b.name == "#built" && kernel_term_eq(b.value, t) {
      ⊢ Option(Nat) from match b.ty {
        KernelFVar(a) => Some(a)
        _ => elab_built_atom(rest, t)
      }
    } else { elab_built_atom(rest, t) }
  }
}

// The name of the newest binding that is the atom.
pub fn elab_name_of(env: List(ElabBinding), names: List(Text), atom: Nat): Option(Text) {
  match names {
    Nil => None
    Cons(n, rest) => ⊢ Option(Text) from match elab_lookup(env, n) {
      Some(b) => ⊢ Option(Text) from match b.value {
        KernelFVar(a) => if a == atom { Some(n) } else { elab_name_of(env, rest, atom) }
        _ => elab_name_of(env, rest, atom)
      }
      None => elab_name_of(env, rest, atom)
    }
  }
}

pub fn elab_shadowed(bs: List(ElabBinding), name: Text): Bool {
  match bs {
    Nil => false
    Cons(b, rest) => (b.name == name && elab_is_atom(b.value)) || elab_shadowed(rest, name)
  }
}

pub fn elab_is_atom(t: KernelTerm): Bool {
  match t {
    KernelFVar(^a) => true
    _ => false
  }
}

// As the host keeps each generalized hypothesis where it was declared, a
// binding an arm rebound is placed at the first binding of its name.
pub fn elab_origin_index(all: List(ElabBinding), name: Text, i: Nat): Nat {
  match all {
    Nil => i
    Cons(b, rest) => if b.name == name { i } else { elab_origin_index(rest, name, i + 1) }
  }
}

pub fn elab_by_origin(all: List(ElabBinding), bs: List(ElabBinding)): List(ElabBinding) {
  match bs {
    Nil => Nil
    Cons(b, rest) => elab_insert_origin(all, b, elab_by_origin(all, rest))
  }
}

pub fn elab_insert_origin(all: List(ElabBinding), b: ElabBinding, sorted: List(ElabBinding)): List(ElabBinding) {
  match sorted {
    Nil => Cons(b, Nil)
    Cons(c, rest) => if elab_origin_index(all, b.name, 0) <= elab_origin_index(all, c.name, 0) { Cons(b, sorted) } else { Cons(c, elab_insert_origin(all, b, rest)) }
  }
}

pub fn elab_dependent_bindings(bs: List(ElabBinding), deps: List(Nat)): List(ElabBinding) {
  match bs {
    Nil => Nil
    Cons(b, rest) => ⊢ List(ElabBinding) from match b.value {
      KernelFVar(a) => if text_starts_with(b.name, "#", 0) == false && elab_has_nat(deps, a) == false && elab_any_occurs(b.ty, deps) {
        // A binding a later one of the same name shadows is not written, so
        // an arm cannot refer to it: only the later one is generalized.
        if elab_shadowed(rest, b.name) { elab_dependent_bindings(rest, Cons(a, deps)) } else { Cons(b, elab_dependent_bindings(rest, Cons(a, deps))) }
      } else { elab_dependent_bindings(rest, deps) }
      _ => elab_dependent_bindings(rest, deps)
    }
  }
}

// No arm calls the function being defined: the match is not a recursion.
pub fn elab_outside_self(k: Nat, env: List(ElabBinding), arms: List(SurfaceArm)): Bool {
  match elab_self(env) {
    None => true
    Some(me) => elab_arms_mention(k, me.fst, arms) == false
  }
}

// The case tree of a `match` on a product of variables, when an arm calls the function being
// defined (`elab_tuple_tree`).
pub fn elab_recursive_tuple_tree(k: Nat, env: List(ElabBinding), core: KernelCore, scrutinee: SurfaceTerm, arms: List(SurfaceArm)): Option(SurfaceTerm) {
  if elab_outside_self(k, env, arms) { None } else { elab_tuple_tree(k, core, scrutinee, arms) }
}

pub fn elab_arms_mention(k: Nat, name: Text, arms: List(SurfaceArm)): Bool {
  match arms {
    Nil => false
    Cons(a, rest) => elab_mentions_any(k, [name], a.body) || elab_arms_mention(k, name, rest)
  }
}

pub fn elab_arms_goal_free(arms: List(SurfaceArm)): Bool {
  match arms {
    Nil => true
    Cons(a, rest) => ⊢ Bool from match a.goal {
      None => elab_arms_goal_free(rest)
      Some(^g) => false
    }
  }
}

// The recursion of a match on `atom`, as `elab_match` finds it.
pub fn elab_recursion_at(env: List(ElabBinding), atom: Nat, indices: List(Nat)): Option(ElabRecursion) {
  match elab_self(env) {
    None => None
    Some(me) => ⊢ Option(ElabRecursion) from match elab_self_params(env, me.snd) {
      None => None
      Some(ids) => ⊢ Option(ElabRecursion) from match elab_position(ids, atom, 0) {
        None => None
        Some(at) => Some(ElabRecursion::Mk(me.fst, ids, at, indices))
      }
    }
  }
}

// `mask` with each parameter whose type mentions one of `deps`
// set, adding it to `deps`.
pub fn elab_mask_dependents(bs: List(ElabBinding), mask: List(Bool), deps: List(Nat), p: Nat, at: Nat): List(Bool) {
  match bs {
    Nil => mask
    Cons(b, rest) => ⊢ List(Bool) from match mask {
      Nil => Nil
      Cons(m, more) => {
        let hit := elab_any_occurs(b.ty, deps)
        let keep := m || hit
        let deps2 := ⊢ List(Nat) from match b.value {
          KernelFVar(a) => if keep { Cons(a, deps) } else { deps }
          _ => deps
        }
        Cons(keep, elab_mask_dependents(rest, more, deps2, p + 1, at))
      }
    }
  }
}

// The bytes of `t` from `i`, as a `List(Nat)`.
pub fn elab_text_bytes(t: Text, i: Nat, n: Nat): KernelTerm {
  match n {
    Zero => elab_apps(KernelConst("List::Nil"), [KernelConst("Nat")])
    Succ(m) => if i >= Text::len(t) { elab_apps(KernelConst("List::Nil"), [KernelConst("Nat")]) } else {
      elab_apps(KernelConst("List::Cons"), [KernelConst("Nat"), KernelLit(Text::byte_value(t, i)), elab_text_bytes(t, i + 1, m)])
    }
  }
}
