import "elaborate.taut"
import "../../surface/src/surface.taut"
import "../../syntax/src/syntax.taut"
import "../../kernel/src/data.taut"
import "../../kernel/src/kernel.taut"
import "../../kernel/src/term.taut"
import std::Base

pub fn elab_params(params: List(SurfaceNamed)): List(SurfaceParam) {
  match params: List(SurfaceParam) {
    Nil => Nil
    Cons(p, rest) => Cons(SurfaceParamMk(Some(p.name), p.ty), elab_params(rest))
  }
}
pub fn elab_names(params: List(SurfaceNamed)): List(Text) {
  match params: List(Text) {
    Nil => Nil
    Cons(p, rest) => Cons(p.name, elab_names(rest))
  }
}

pub(open) inductive ElabDeclaration: Type {
  Mk(name: Text, ty: KernelTerm, value: KernelTerm, transparent: Bool): ElabDeclaration
}

// Check the written signature, elaborate with that expected type, then ask the
// independent kernel to accept the closed declaration. Every failure restores
// the complete environment, including atoms and exhaustion state.
pub fn elab_declaration_inner(
  k: Nat,
  &mut core: KernelCore,
  decl: SurfaceTheorem,
  transparent: Bool
): ElabResult(ElabDeclaration) {
  if decl.implicit != 0 { ElabErr("implicit parameters are unsupported") } else {
    match decl.body: ElabResult(ElabDeclaration) {
      None => ElabErr("a declaration must supply its body; axioms are unsupported")
      Some(body) => {
        let signature := surface_term_mk(
          SkPi(elab_params(decl.params), decl.ty, None),
          decl.start,
          decl.end
        )
        match elab_type(k, &mut core, Nil, signature): ElabResult(ElabDeclaration) {
          ElabErr(e) => ElabErr(e)
          ElabOk(ty) => {
            let value := surface_term_mk(SkLam(elab_names(decl.params), body), decl.start, decl.end)
            match elab_term(k, &mut core, Nil, value, Some(ty)): ElabResult(ElabDeclaration) {
              ElabErr(e) => ElabErr(e)
              ElabOk(t) => match kernel_execute(
                k,
                &mut core,
                KernelDeclare(decl.name, ty, Some(t.value), transparent)
              ): ElabResult(ElabDeclaration) {
                KernelAccepted => ElabOk(ElabDeclaration::Mk(decl.name, ty, t.value, transparent))
                KernelRejected => ElabErr("kernel rejected the elaborated declaration")
                KernelExhausted => ElabErr("kernel exhausted")
              }
            }
          }
        }
      }
    }
  }
}
pub fn elab_declaration_checked(
  k: Nat,
  &mut core: KernelCore,
  decl: SurfaceTheorem,
  transparent: Bool
): ElabResult(ElabDeclaration) {
  let saved := kernel_snapshot(core)
  let result := elab_declaration_inner(k, &mut core, decl, transparent)
  if core.exhausted {
    kernel_set_to(&mut core, saved)
    ElabErr("elaboration exhausted")
  } else {
    match result: ElabResult(ElabDeclaration) {
      ElabErr(e) => { kernel_set_to(&mut core, saved)
        ElabErr(e) }
      ElabOk(d) => ElabOk(d)
    }
  }
}
pub fn elab_program(
  stmts: List(SurfaceStmt),
  k: Nat,
  &mut core: KernelCore
): ElabResult(List(ElabDeclaration)) {
  match stmts: ElabResult(List(ElabDeclaration)) {
    Nil => ElabOk(Nil)
    Cons(stmt, rest) => {
      let first := match stmt: ElabResult(ElabDeclaration) {
        StDef(d) => elab_declaration_checked(k, &mut core, d, true)
        StTheorem(d) => elab_declaration_checked(k, &mut core, d, false)
        _ => ElabErr("only explicit def and theorem declarations are supported")
      }
      match first: ElabResult(List(ElabDeclaration)) {
        ElabErr(e) => ElabErr(e)
        ElabOk(d) => match elab_program(rest, k, &mut core): ElabResult(List(ElabDeclaration)) {
          ElabErr(e) => ElabErr(e)
          ElabOk(ds) => ElabOk(Cons(d, ds))
        }
      }
    }
  }
}

// Attributes and generation clauses are absent from Surface. This scan detects
// them in the concrete tree so that elab_program rejects unsupported declarations.
pub fn elab_unsupported(k: Nat, nodes: List(CstNode)): Bool {
  match k: Bool {
    Zero => true
    Succ(j) => match nodes: Bool {
      Nil => false
      Cons(
        n,
        rest
      ) => n.name == "Attribute" || n.name == "Generates" || n.name == "Generated" || elab_unsupported(
        j,
        List::append(n.flat, rest)
      )
    }
  }
}
