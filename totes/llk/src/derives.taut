import "llk.taut"
import "../../scan/src/scan.taut"
import std::Array
import std::Base
import std::Stack

// A parse that succeeds is a derivation by the tables' productions
// (`docs/design/self-host.md`「llk（`totes/llk/src/derives.taut`）」). `LlkDerives(t, stack, tokens)` reads the parser's
// stack (top first) as what is still to be derived:
//
// * a non-terminal is replaced by the symbols of one of its productions
//   (in the order the parser expands them), then the end of that
//   production;
// * a terminal is the type of the next token;
// * the end of a production derives nothing;
// * an empty stack, or the end of the input (terminal 0) alone, needs the
//   next token to be the end of the input.
//
// `llk_run_sound` and `llk_parse_sound`: when the parser says it parsed,
// the start symbol derives the tokens. Which production the lookahead
// chooses does not matter here; that the parser only takes a production of
// the non-terminal it expands does.

pub fn llk_type_of(token: LlkTok): Nat {
  token.token_type
}

pub fn llk_lhs_of(p: LlkProduction): Nat {
  p.lhs
}

pub fn llk_pushes_of(p: LlkProduction): List(LlkSym) {
  p.pushes
}

pub fn llk_productions_of(t: LlkTables): Array(LlkProduction) {
  t.productions
}

pub fn llk_onto(symbols: List(LlkSym), items: List(LlkSym)): List(LlkSym) {
  ⊢ List(LlkSym) from match symbols {
    Nil => items
    Cons(symbol, rest) => llk_onto(rest, Cons(symbol, items))
  }
}

pub(open) inductive LlkDerives(t: LlkTables): (List(LlkSym), List(LlkTok)) -> Prop {
  LlkDDone(
    token: LlkTok,
    ts: List(LlkTok),
    h: llk_type_of(token) = 0
  ): LlkDerives(t, Nil, Cons(token, ts))
  LlkDEnd(
    token: LlkTok,
    ts: List(LlkTok),
    h: llk_type_of(token) = 0
  ): LlkDerives(t, Cons(LlkT(0), Nil), Cons(token, ts))
  LlkDT(
    a: Nat,
    rest: List(LlkSym),
    token: LlkTok,
    ts: List(LlkTok),
    h: llk_type_of(token) = a,
    d: LlkDerives(t, rest, ts)
  ): LlkDerives(t, Cons(LlkT(a), rest), Cons(token, ts))
  LlkDN(
    a: Nat,
    rest: List(LlkSym),
    ts: List(LlkTok),
    p: Nat,
    prod: LlkProduction,
    hp: Array::get(llk_productions_of(t), p) = Some(prod),
    hl: llk_lhs_of(prod) = a,
    d: LlkDerives(t, llk_onto(llk_pushes_of(prod), Cons(LlkE(p), rest)), ts)
  ): LlkDerives(t, Cons(LlkN(a), rest), ts)
  LlkDE(
    p: Nat,
    rest: List(LlkSym),
    ts: List(LlkTok),
    d: LlkDerives(t, rest, ts)
  ): LlkDerives(t, Cons(LlkE(p), rest), ts)
}

pub theorem llk_option_cases<A: Type>(
  P: (Option(A)) -> Prop,
  o: Option(A),
  a: (o = None) -> P(None),
  b: ∀ x: A. (o = Some(x)) -> P(Some(x))
): P(o) {
  ⊢ P(o) from match o {
    None => a(Refl)
    Some(x) => b(x, Refl)
  }
}

pub fn llk_value(m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))): LlkResult {
  ⊢ LlkResult from match m {
    mut2(v, a, b) => v
  }
}

// What the body of `llk_run_in` makes of a recursive call.
pub fn llk_rewrap(
  m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))
): Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
  ⊢ Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) from match m {
    mut2(v, a, b) => mut2(v, a, b)
  }
}

pub theorem llk_rewrap_value(
  m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))
): llk_value(llk_rewrap(m)) = llk_value(m) {
  ⊢ llk_value(llk_rewrap(m)) = llk_value(m) from match m {
    mut2(v, a, b) => Refl
  }
}

// What the body of `llk_run_in` makes of `llk_finish`.
pub fn llk_wrap1(
  s: Stack(LlkSym),
  m: Mut1(LlkResult, Stack(LlkEvent))
): Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
  ⊢ Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) from match m {
    mut1(v, e) => mut2(v, s, e)
  }
}

pub theorem llk_failed_ne_parsed(x: LlkError, e: LlkFailed(x) = LlkParsed): False {
  ⊢ False from match e {
  }
}

pub theorem llk_failure_ne_parsed(
  tokens: List(LlkTok),
  expected: List(Nat),
  e: llk_failure(tokens, expected) = LlkParsed
): False {
  ⊢ False from match tokens {
    Nil => llk_failed_ne_parsed(LlkError::Mk(None, expected), e)
    Cons(token, rest) => ⊢ False from match token {
      LlkTok::Mk(ty, st, en, tr) => llk_failed_ne_parsed(LlkError::Mk(Some(st), expected), e)
    }
  }
}

pub fn llk_finish_at(
  tokens: List(LlkTok),
  token: LlkTok,
  &mut events: Stack(LlkEvent),
  c: Bool
): LlkResult {
  ⊢ LlkResult from match c {
    true => {
      llk_trivia_onto(token.trivia, &mut events)
      Stack::push(&mut events, LlkClose)
      LlkParsed
    }
    false => llk_failure(tokens, Nil)
  }
}

pub fn llk_at_end(tokens: List(LlkTok)): Prop {
  ⊢ Prop from match tokens {
    Nil => False
    Cons(token, rest) => llk_type_of(token) = 0
  }
}

pub theorem llk_finish_sound(
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  s: Stack(LlkSym),
  h: llk_value(llk_wrap1(s, llk_finish(tokens, ev))) = LlkParsed
): llk_at_end(tokens) {
  ⊢ llk_at_end(tokens) from match tokens {
    Nil => False::elim(llk_failed_ne_parsed(LlkError::Mk(None, Nil), h))
    Cons(token, rest) => ⊢ llk_at_end(Cons(token, rest)) from match token {
      LlkTok::Mk(ty, st, en, tr) => Nat::eq_sound(
        ty,
        0,
        Bool::cases(
          (c: Bool) => c = true,
          Nat::eq(ty, 0),
          (q: Nat::eq(ty, 0) = false) => False::elim(
            llk_failed_ne_parsed(
              LlkError::Mk(Some(st), Nil),
              Eq::subst(
                (c: Bool) => llk_value(
                  llk_wrap1(
                    s,
                    llk_finish_at(
                      Cons(LlkTok::Mk(ty, st, en, tr), rest),
                      LlkTok::Mk(ty, st, en, tr),
                      ev,
                      c
                    )
                  )
                ) = LlkParsed,
                q,
                h
              )
            )
          ),
          (q: Nat::eq(ty, 0) = true) => Refl
        )
      )
    }
  }
}

pub theorem llk_done_of(
  t: LlkTables,
  tokens: List(LlkTok),
  e: llk_at_end(tokens)
): LlkDerives(t, Nil, tokens) {
  ⊢ LlkDerives(t, Nil, tokens) from match tokens {
    Nil => False::elim(e)
    Cons(token, rest) => LlkDDone(token, rest, e)
  }
}

pub theorem llk_end_of(
  t: LlkTables,
  tokens: List(LlkTok),
  e: llk_at_end(tokens)
): LlkDerives(t, Cons(LlkT(0), Nil), tokens) {
  ⊢ LlkDerives(t, Cons(LlkT(0), Nil), tokens) from match tokens {
    Nil => False::elim(e)
    Cons(token, rest) => LlkDEnd(token, rest, e)
  }
}

pub fn llk_events_push(ev: Stack(LlkEvent), x: LlkEvent): Stack(LlkEvent) {
  Stack::Mk(Cons(x, ev.items))
}

// What a call at the end of a body with one `&mut` argument is made into.
pub fn llk_rewrap1<A, S>(m: Mut1(A, S)): Mut1(A, S) {
  ⊢ Mut1(A, S) from match m {
    mut1(v, x) => mut1(v, x)
  }
}

pub theorem llk_rewrap1_id<A: Type, S: Type>(m: Mut1(A, S)): llk_rewrap1(m) = m {
  ⊢ llk_rewrap1(m) = m from match m {
    mut1(v, x) => Refl
  }
}

pub fn llk_trivia_after(trivia: List(ScanToken), ev: Stack(LlkEvent)): Stack(LlkEvent) {
  ⊢ Stack(LlkEvent) from match trivia {
    Nil => ev
    Cons(token, rest) => llk_trivia_after(
      rest,
      llk_events_push(ev, LlkToken(token.token_type, token.start, token.end))
    )
  }
}

pub theorem llk_trivia_onto_is(
  trivia: List(ScanToken),
  ev: Stack(LlkEvent)
): llk_trivia_onto(trivia, ev) = mut1(Star, llk_trivia_after(trivia, ev)) {
  ⊢ llk_trivia_onto(trivia, ev) = mut1(Star, llk_trivia_after(trivia, ev)) from match trivia {
    Nil => Refl
    Cons(token, rest) => Eq::trans(
      llk_rewrap1_id(
        llk_trivia_onto(
          rest,
          llk_events_push(ev, LlkToken(token.token_type, token.start, token.end))
        )
      ),
      llk_trivia_onto_is(
        rest,
        llk_events_push(ev, LlkToken(token.token_type, token.start, token.end))
      )
    )
  }
}

pub theorem llk_push_symbols_is(
  symbols: List(LlkSym),
  items: List(LlkSym)
): llk_push_symbols(symbols, Stack::Mk(items)) = mut1(Star, Stack::Mk(llk_onto(symbols, items))) {
  ⊢ llk_push_symbols(
    symbols,
    Stack::Mk(items)
  ) = mut1(Star, Stack::Mk(llk_onto(symbols, items))) from match symbols {
    Nil => Refl
    Cons(symbol, rest) => Eq::trans(
      llk_rewrap1_id(llk_push_symbols(rest, Stack::Mk(Cons(symbol, items)))),
      llk_push_symbols_is(rest, Cons(symbol, items))
    )
  }
}

// What the recursive call of `llk_run_in` on `f` steps gives.
pub def LlkIh(
  f: Nat,
  t: LlkTables
): Prop := ∀ ts: List(
  LlkTok
). ∀ items: List(
  LlkSym
). ∀ ev: Stack(
  LlkEvent
). (llk_value(llk_run_in(f, t, ts, Stack::Mk(items), ev)) = LlkParsed) -> LlkDerives(t, items, ts)

// A terminal to match, on the tokens and on whether the next one has it.
pub fn llk_tokens_at(
  f: Nat,
  &t: LlkTables,
  terminal: Nat,
  tokens: List(LlkTok),
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent)
): LlkResult {
  ⊢ LlkResult from match tokens {
    Nil => llk_failure(tokens, Cons(terminal, Nil))
    Cons(token, more) => ⊢ LlkResult from match token.token_type == terminal {
      true => {
        llk_trivia_onto(token.trivia, &mut events)
        Stack::push(&mut events, LlkToken(token.token_type, token.start, token.end))
        llk_run_in(f, &t, more, &mut stack, &mut events)
      }
      false => llk_failure(tokens, Cons(terminal, Nil))
    }
  }
}

pub fn llk_term_at(
  f: Nat,
  &t: LlkTables,
  terminal: Nat,
  tokens: List(LlkTok),
  token: LlkTok,
  more: List(LlkTok),
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent),
  c: Bool
): LlkResult {
  ⊢ LlkResult from match c {
    true => {
      llk_trivia_onto(token.trivia, &mut events)
      Stack::push(&mut events, LlkToken(token.token_type, token.start, token.end))
      llk_run_in(f, &t, more, &mut stack, &mut events)
    }
    false => llk_failure(tokens, Cons(terminal, Nil))
  }
}

// The rest of a matched terminal, once the trivia are pushed (`m`).
pub fn llk_k_tok(
  f: Nat,
  t: LlkTables,
  more: List(LlkTok),
  token: LlkTok,
  stack: Stack(LlkSym),
  m: Mut1(Unit, Stack(LlkEvent))
): Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
  ⊢ Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) from match m {
    mut1(v, events) => ⊢ Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) from match Stack::push(
      events,
      LlkToken(token.token_type, token.start, token.end)
    ) {
      mut1(v2, events2) => llk_rewrap(llk_run_in(f, t, more, stack, events2))
    }
  }
}

// A terminal the parser matched is the type of the next token.
pub theorem llk_term_matches(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  ty: Nat,
  st: Nat,
  en: Nat,
  tr: List(ScanToken),
  more: List(LlkTok),
  ev: Stack(LlkEvent),
  h: llk_value(
    llk_tokens_at(f, t, a, Cons(LlkTok::Mk(ty, st, en, tr), more), Stack::Mk(below), ev)
  ) = LlkParsed
): Nat::eq(ty, a) = true {
  Bool::cases(
    (c: Bool) => c = true,
    Nat::eq(ty, a),
    (q: Nat::eq(ty, a) = false) => False::elim(
      llk_failed_ne_parsed(
        LlkError::Mk(Some(st), Cons(a, Nil)),
        Eq::subst(
          (c: Bool) => llk_value(
            llk_term_at(
              f,
              t,
              a,
              Cons(LlkTok::Mk(ty, st, en, tr), more),
              LlkTok::Mk(ty, st, en, tr),
              more,
              Stack::Mk(below),
              ev,
              c
            )
          ) = LlkParsed,
          q,
          h
        )
      )
    ),
    (q: Nat::eq(ty, a) = true) => Refl
  )
}

pub theorem llk_term_case(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  ih: LlkIh(f, t),
  h: llk_value(llk_tokens_at(f, t, a, tokens, Stack::Mk(below), ev)) = LlkParsed
): LlkDerives(t, Cons(LlkT(a), below), tokens) {
  ⊢ LlkDerives(t, Cons(LlkT(a), below), tokens) from match tokens {
    Nil => False::elim(llk_failed_ne_parsed(LlkError::Mk(None, Cons(a, Nil)), h))
    Cons(token, more) => ⊢ LlkDerives(t, Cons(LlkT(a), below), Cons(token, more)) from match token {
      LlkTok::Mk(ty, st, en, tr) => LlkDT(
        a,
        below,
        LlkTok::Mk(ty, st, en, tr),
        more,
        Nat::eq_sound(ty, a, llk_term_matches(f, t, a, below, ty, st, en, tr, more, ev, h)),
        ih(
          more,
          below,
          llk_events_push(llk_trivia_after(tr, ev), LlkToken(ty, st, en)),
          Eq::trans(
            Eq::sym(
              llk_rewrap_value(
                llk_run_in(
                  f,
                  t,
                  more,
                  Stack::Mk(below),
                  llk_events_push(llk_trivia_after(tr, ev), LlkToken(ty, st, en))
                )
              )
            ),
            Eq::subst(
              (m: Mut1(Unit, Stack(LlkEvent))) => llk_value(
                llk_k_tok(f, t, more, LlkTok::Mk(ty, st, en, tr), Stack::Mk(below), m)
              ) = LlkParsed,
              llk_trivia_onto_is(tr, ev),
              Eq::subst(
                (c: Bool) => llk_value(
                  llk_term_at(
                    f,
                    t,
                    a,
                    Cons(LlkTok::Mk(ty, st, en, tr), more),
                    LlkTok::Mk(ty, st, en, tr),
                    more,
                    Stack::Mk(below),
                    ev,
                    c
                  )
                ) = LlkParsed,
                llk_term_matches(f, t, a, below, ty, st, en, tr, more, ev, h),
                h
              )
            )
          )
        )
      )
    }
  }
}

// A non-terminal to expand: on the predicted production, on the production
// the tables have under that number, and on whether it is the non-terminal's.
pub fn llk_nt_at(
  f: Nat,
  &t: LlkTables,
  non_terminal: Nat,
  tokens: List(LlkTok),
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent),
  o: Option(Nat)
): LlkResult {
  ⊢ LlkResult from match o {
    None => llk_failure(tokens, Nil)
    Some(production) => ⊢ LlkResult from match Array::get(t.productions, production) {
      None => LlkFailed(LlkError { at: None, expected: Nil })
      Some(found) => ⊢ LlkResult from match found.lhs == non_terminal {
        false => LlkFailed(LlkError { at: None, expected: Nil })
        true => {
          Stack::push(&mut stack, LlkE(production))
          llk_push_symbols(found.pushes, &mut stack)
          Stack::push(&mut events, LlkOpen(found.lhs))
          llk_run_in(f, &t, tokens, &mut stack, &mut events)
        }
      }
    }
  }
}

pub fn llk_prod_at(
  f: Nat,
  &t: LlkTables,
  non_terminal: Nat,
  tokens: List(LlkTok),
  production: Nat,
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent),
  o: Option(LlkProduction)
): LlkResult {
  ⊢ LlkResult from match o {
    None => LlkFailed(LlkError { at: None, expected: Nil })
    Some(found) => ⊢ LlkResult from match found.lhs == non_terminal {
      false => LlkFailed(LlkError { at: None, expected: Nil })
      true => {
        Stack::push(&mut stack, LlkE(production))
        llk_push_symbols(found.pushes, &mut stack)
        Stack::push(&mut events, LlkOpen(found.lhs))
        llk_run_in(f, &t, tokens, &mut stack, &mut events)
      }
    }
  }
}

pub fn llk_lhs_at(
  f: Nat,
  &t: LlkTables,
  tokens: List(LlkTok),
  production: Nat,
  found: LlkProduction,
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent),
  c: Bool
): LlkResult {
  ⊢ LlkResult from match c {
    false => LlkFailed(LlkError { at: None, expected: Nil })
    true => {
      Stack::push(&mut stack, LlkE(production))
      llk_push_symbols(found.pushes, &mut stack)
      Stack::push(&mut events, LlkOpen(found.lhs))
      llk_run_in(f, &t, tokens, &mut stack, &mut events)
    }
  }
}

pub fn llk_k_sym(
  f: Nat,
  t: LlkTables,
  tokens: List(LlkTok),
  found: LlkProduction,
  events: Stack(LlkEvent),
  m: Mut1(Unit, Stack(LlkSym))
): Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
  ⊢ Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) from match m {
    mut1(v, stack) => ⊢ Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) from match Stack::push(
      events,
      LlkOpen(found.lhs)
    ) {
      mut1(v2, events2) => llk_rewrap(llk_run_in(f, t, tokens, stack, events2))
    }
  }
}

pub theorem llk_lhs_matches(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  p: Nat,
  prod: LlkProduction,
  h: llk_value(llk_prod_at(f, t, a, tokens, p, Stack::Mk(below), ev, Some(prod))) = LlkParsed
): Nat::eq(llk_lhs_of(prod), a) = true {
  Bool::cases(
    (c: Bool) => c = true,
    Nat::eq(llk_lhs_of(prod), a),
    (q: Nat::eq(llk_lhs_of(prod), a) = false) => False::elim(
      llk_failed_ne_parsed(
        LlkError::Mk(None, Nil),
        Eq::subst(
          (c: Bool) => llk_value(
            llk_lhs_at(f, t, tokens, p, prod, Stack::Mk(below), ev, c)
          ) = LlkParsed,
          q,
          h
        )
      )
    ),
    (q: Nat::eq(llk_lhs_of(prod), a) = true) => Refl
  )
}

pub theorem llk_expand_case(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  ih: LlkIh(f, t),
  p: Nat,
  prod: LlkProduction,
  hp: Array::get(llk_productions_of(t), p) = Some(prod),
  h: llk_value(llk_prod_at(f, t, a, tokens, p, Stack::Mk(below), ev, Some(prod))) = LlkParsed
): LlkDerives(t, Cons(LlkN(a), below), tokens) {
  LlkDN(
    a,
    below,
    tokens,
    p,
    prod,
    hp,
    Nat::eq_sound(llk_lhs_of(prod), a, llk_lhs_matches(f, t, a, below, tokens, ev, p, prod, h)),
    ih(
      tokens,
      llk_onto(llk_pushes_of(prod), Cons(LlkE(p), below)),
      llk_events_push(ev, LlkOpen(llk_lhs_of(prod))),
      Eq::trans(
        Eq::sym(
          llk_rewrap_value(
            llk_run_in(
              f,
              t,
              tokens,
              Stack::Mk(llk_onto(llk_pushes_of(prod), Cons(LlkE(p), below))),
              llk_events_push(ev, LlkOpen(llk_lhs_of(prod)))
            )
          )
        ),
        Eq::subst(
          (m: Mut1(Unit, Stack(LlkSym))) => llk_value(
            llk_k_sym(f, t, tokens, prod, ev, m)
          ) = LlkParsed,
          llk_push_symbols_is(llk_pushes_of(prod), Cons(LlkE(p), below)),
          Eq::subst(
            (c: Bool) => llk_value(
              llk_lhs_at(f, t, tokens, p, prod, Stack::Mk(below), ev, c)
            ) = LlkParsed,
            llk_lhs_matches(f, t, a, below, tokens, ev, p, prod, h),
            h
          )
        )
      )
    )
  )
}

pub fn llk_goal_n(t: LlkTables, a: Nat, below: List(LlkSym), tokens: List(LlkTok)): Prop {
  LlkDerives(t, Cons(LlkN(a), below), tokens)
}

pub theorem llk_n_case(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  ih: LlkIh(f, t),
  h: llk_value(
    llk_nt_at(f, t, a, tokens, Stack::Mk(below), ev, llk_predict(t, a, tokens))
  ) = LlkParsed
): LlkDerives(t, Cons(LlkN(a), below), tokens) {
  llk_option_cases(
    (o: Option(Nat)) => llk_goal_n(t, a, below, tokens),
    llk_predict(t, a, tokens),
    (q: llk_predict(t, a, tokens) = None) => False::elim(
      llk_failure_ne_parsed(
        tokens,
        Nil,
        Eq::subst(
          (o: Option(Nat)) => llk_value(
            llk_nt_at(f, t, a, tokens, Stack::Mk(below), ev, o)
          ) = LlkParsed,
          q,
          h
        )
      )
    ),
    (p: Nat) => (q: llk_predict(t, a, tokens) = Some(p)) => llk_option_cases(
      (o: Option(LlkProduction)) => llk_goal_n(t, a, below, tokens),
      Array::get(llk_productions_of(t), p),
      (qp: Array::get(llk_productions_of(t), p) = None) => False::elim(
        llk_failed_ne_parsed(
          LlkError::Mk(None, Nil),
          Eq::subst(
            (o: Option(LlkProduction)) => llk_value(
              llk_prod_at(f, t, a, tokens, p, Stack::Mk(below), ev, o)
            ) = LlkParsed,
            qp,
            Eq::subst(
              (o: Option(Nat)) => llk_value(
                llk_nt_at(f, t, a, tokens, Stack::Mk(below), ev, o)
              ) = LlkParsed,
              q,
              h
            )
          )
        )
      ),
      (prod: LlkProduction) => (qp: Array::get(llk_productions_of(t), p) = Some(prod)) => llk_expand_case(
        f,
        t,
        a,
        below,
        tokens,
        ev,
        ih,
        p,
        prod,
        qp,
        Eq::subst(
          (o: Option(LlkProduction)) => llk_value(
            llk_prod_at(f, t, a, tokens, p, Stack::Mk(below), ev, o)
          ) = LlkParsed,
          qp,
          Eq::subst(
            (o: Option(Nat)) => llk_value(
              llk_nt_at(f, t, a, tokens, Stack::Mk(below), ev, o)
            ) = LlkParsed,
            q,
            h
          )
        )
      )
    )
  )
}

// A run that says it parsed: what was on the stack derives the tokens.
pub theorem llk_run_sound(
  fuel: Nat,
  t: LlkTables,
  tokens: List(LlkTok),
  items: List(LlkSym),
  ev: Stack(LlkEvent),
  h: llk_value(llk_run_in(fuel, t, tokens, Stack::Mk(items), ev)) = LlkParsed
): LlkDerives(t, items, tokens) {
  ⊢ LlkDerives(t, items, tokens) from match fuel {
    Zero => False::elim(llk_failed_ne_parsed(LlkError::Mk(None, Nil), h))
    Succ(f) => ⊢ LlkDerives(t, items, tokens) from match items {
      Nil => llk_done_of(t, tokens, llk_finish_sound(tokens, ev, Stack::Mk(Nil), h))
      Cons(top, below) => ⊢ LlkDerives(t, Cons(top, below), tokens) from match top {
        LlkE(p) => LlkDE(
          p,
          below,
          tokens,
          llk_run_sound(
            f,
            t,
            tokens,
            below,
            llk_events_push(ev, LlkClose),
            Eq::trans(
              Eq::sym(
                llk_rewrap_value(
                  llk_run_in(f, t, tokens, Stack::Mk(below), llk_events_push(ev, LlkClose))
                )
              ),
              h
            )
          )
        )
        LlkT(a) => ⊢ LlkDerives(t, Cons(LlkT(a), below), tokens) from match a {
          Zero => ⊢ LlkDerives(t, Cons(LlkT(Zero), below), tokens) from match below {
            Nil => llk_end_of(t, tokens, llk_finish_sound(tokens, ev, Stack::Mk(Nil), h))
            Cons(b, bs) => llk_term_case(
              f,
              t,
              Zero,
              Cons(b, bs),
              tokens,
              ev,
              (ts: List(LlkTok)) => (its: List(LlkSym)) => (e: Stack(LlkEvent)) => (hh: llk_value(llk_run_in(f, t, ts, Stack::Mk(its), e)) = LlkParsed) => llk_run_sound(
                f,
                t,
                ts,
                its,
                e,
                hh
              ),
              h
            )
          }
          Succ(a2) => llk_term_case(
            f,
            t,
            Succ(a2),
            below,
            tokens,
            ev,
            (ts: List(LlkTok)) => (its: List(LlkSym)) => (e: Stack(LlkEvent)) => (hh: llk_value(llk_run_in(f, t, ts, Stack::Mk(its), e)) = LlkParsed) => llk_run_sound(
              f,
              t,
              ts,
              its,
              e,
              hh
            ),
            h
          )
        }
        LlkN(a) => llk_n_case(
          f,
          t,
          a,
          below,
          tokens,
          ev,
          (ts: List(LlkTok)) => (its: List(LlkSym)) => (e: Stack(LlkEvent)) => (hh: llk_value(llk_run_in(f, t, ts, Stack::Mk(its), e)) = LlkParsed) => llk_run_sound(
            f,
            t,
            ts,
            its,
            e,
            hh
          ),
          h
        )
      }
    }
  }
}

pub fn llk_value1(m: Mut1(LlkResult, Stack(LlkEvent))): LlkResult {
  ⊢ LlkResult from match m {
    mut1(v, e) => v
  }
}

// What the body of `llk_parse` makes of its call of `llk_run_in`.
pub fn llk_drop(
  m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))
): Mut1(LlkResult, Stack(LlkEvent)) {
  ⊢ Mut1(LlkResult, Stack(LlkEvent)) from match m {
    mut2(v, s, e) => mut1(v, e)
  }
}

pub theorem llk_drop_value(
  m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))
): llk_value1(llk_drop(m)) = llk_value(m) {
  ⊢ llk_value1(llk_drop(m)) = llk_value(m) from match m {
    mut2(v, s, e) => Refl
  }
}

pub fn llk_start_of(t: LlkTables): Nat {
  t.start
}

pub fn llk_root_of(t: LlkTables): Nat {
  t.non_terminals
}

// A parse that says it parsed: the start symbol derives the tokens, whatever the fuel (a variable, so
// that the proof does not run the parser).
pub theorem llk_parse_sound(
  fuel: Nat,
  t: LlkTables,
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  h: llk_value1(llk_parse(fuel, t, tokens, ev)) = LlkParsed
): LlkDerives(t, Cons(LlkN(llk_start_of(t)), Nil), tokens) {
  llk_run_sound(
    fuel,
    t,
    tokens,
    Cons(LlkN(llk_start_of(t)), Nil),
    llk_events_push(ev, LlkOpen(llk_root_of(t))),
    Eq::trans(
      Eq::sym(
        llk_drop_value(
          llk_run_in(
            fuel,
            t,
            tokens,
            Stack::Mk(Cons(LlkN(llk_start_of(t)), Nil)),
            llk_events_push(ev, LlkOpen(llk_root_of(t)))
          )
        )
      ),
      h
    )
  )
}
