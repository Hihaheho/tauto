import "llk.taut"

// A parse that succeeds is a derivation by the tables' productions
// (`docs/design/self-host.md`「llk（`totes/llk/src/derives.taut`）」). `LlkDerives(t, stack, tokens)` reads the parser's
// stack (top first) as what is still to be derived:
//
// * a non-terminal is replaced by the symbols of one of its productions
//   (in the order the parser expands them), then the end of that
//   production;
// * a terminal is the type of the next token;
// * the end of a production derives nothing;
// * an empty stack, or the end of the input (terminal 0) alone, needs the
//   next token to be the end of the input.
//
// `llk_run_sound` and `llk_parse_sound`: when the parser says it parsed,
// the start symbol derives the tokens. Which production the lookahead
// chooses does not matter here; that the parser only takes a production of
// the non-terminal it expands does.

// ---- the derivation ---------------------------------------------------------

fn llk_type_of(token: LlkTok) -> Nat {
  token.token_type
}

fn llk_lhs_of(p: LlkProduction) -> Nat {
  p.lhs
}

fn llk_pushes_of(p: LlkProduction) -> List(LlkSym) {
  p.pushes
}

fn llk_productions_of(t: LlkTables) -> Array(LlkProduction) {
  t.productions
}

// `symbols` pushed onto a stack whose items are `items`, as
// `llk_push_symbols` does.
fn llk_onto(symbols: List(LlkSym), items: List(LlkSym)) -> List(LlkSym) {
  match symbols -> List(LlkSym) {
    Nil => items
    Cons(symbol, rest) => llk_onto(rest, Cons(symbol, items))
  }
}

inductive LlkDerives(t: LlkTables): (List(LlkSym), List(LlkTok)) -> Prop {
  llk_d_done(
    token: LlkTok,
    ts: List(LlkTok),
    h: Eq(Nat, llk_type_of(token), 0)
  ): LlkDerives(t, Nil, Cons(token, ts))
  llk_d_end(
    token: LlkTok,
    ts: List(LlkTok),
    h: Eq(Nat, llk_type_of(token), 0)
  ): LlkDerives(t, Cons(llk_t(0), Nil), Cons(token, ts))
  llk_d_t(
    a: Nat,
    rest: List(LlkSym),
    token: LlkTok,
    ts: List(LlkTok),
    h: Eq(Nat, llk_type_of(token), a),
    d: LlkDerives(t, rest, ts)
  ): LlkDerives(t, Cons(llk_t(a), rest), Cons(token, ts))
  llk_d_n(
    a: Nat,
    rest: List(LlkSym),
    ts: List(LlkTok),
    p: Nat,
    prod: LlkProduction,
    hp: Eq(Option(LlkProduction), array_get(llk_productions_of(t), p), Some(prod)),
    hl: Eq(Nat, llk_lhs_of(prod), a),
    d: LlkDerives(t, llk_onto(llk_pushes_of(prod), Cons(llk_e(p), rest)), ts)
  ): LlkDerives(t, Cons(llk_n(a), rest), ts)
  llk_d_e(
    p: Nat,
    rest: List(LlkSym),
    ts: List(LlkTok),
    d: LlkDerives(t, rest, ts)
  ): LlkDerives(t, Cons(llk_e(p), rest), ts)
}

theorem llk_option_cases<A: Type>(
  P: (Option(A)) -> Prop,
  o: Option(A),
  a: (Eq(Option(A), o, None)) -> P(None),
  b: ∀ x: A. (Eq(Option(A), o, Some(x))) -> P(Some(x))
): P(o) {
  match o -> P(o) {
    None => a(refl())
    Some(x) => b(x, refl())
  }
}

// ---- results ----------------------------------------------------------------

fn llk_value(m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))) -> LlkResult {
  match m -> LlkResult {
    mut2(v, a, b) => v
  }
}

// What the body of `llk_run_in` makes of a recursive call.
fn llk_rewrap(
  m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))
) -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
  match m -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
    mut2(v, a, b) => mut2(v, a, b)
  }
}

theorem llk_rewrap_value(
  m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))
): Eq(LlkResult, llk_value(llk_rewrap(m)), llk_value(m)) {
  match m -> Eq(LlkResult, llk_value(llk_rewrap(m)), llk_value(m)) {
    mut2(v, a, b) => refl()
  }
}

// What the body of `llk_run_in` makes of `llk_finish`.
fn llk_wrap1(
  s: Stack(LlkSym),
  m: Mut1(LlkResult, Stack(LlkEvent))
) -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
  match m -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
    mut1(v, e) => mut2(v, s, e)
  }
}

theorem llk_failed_ne_parsed(x: LlkError, e: Eq(LlkResult, llk_failed(x), llk_parsed)): False {
  match e -> False {
  }
}

theorem llk_failure_ne_parsed(
  tokens: List(LlkTok),
  expected: List(Nat),
  e: Eq(LlkResult, llk_failure(tokens, expected), llk_parsed)
): False {
  match tokens -> False {
    Nil => llk_failed_ne_parsed(llk_error(None, expected), e)
    Cons(token, rest) => match token -> False {
      llk_tok(ty, st, en, tr) => llk_failed_ne_parsed(llk_error(Some(st), expected), e)
    }
  }
}

// ---- the end ----------------------------------------------------------------

// The step of `llk_finish` on whether the token is the end of the input.
fn llk_finish_at(
  tokens: List(LlkTok),
  token: LlkTok,
  &mut events: Stack(LlkEvent),
  c: Yn
) -> LlkResult {
  match c -> LlkResult {
    yes => {
      llk_trivia_onto(token.trivia, &mut events)
      stack_push(&mut events, llk_close)
      llk_parsed
    }
    no => llk_failure(tokens, Nil)
  }
}

fn llk_at_end(tokens: List(LlkTok)) -> Prop {
  match tokens -> Prop {
    Nil => False
    Cons(token, rest) => Eq(Nat, llk_type_of(token), 0)
  }
}

// `llk_finish` succeeds only at the end of the input.
theorem llk_finish_sound(
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  s: Stack(LlkSym),
  h: Eq(LlkResult, llk_value(llk_wrap1(s, llk_finish(tokens, ev))), llk_parsed)
): llk_at_end(tokens) {
  match tokens -> llk_at_end(tokens) {
    Nil => False_elim(llk_failed_ne_parsed(llk_error(None, Nil), h))
    Cons(token, rest) => match token -> llk_at_end(Cons(token, rest)) {
      llk_tok(
        ty,
        st,
        en,
        tr
      ) => nat_eq_sound(
        ty,
        0,
        yn_cases(
          (c: Yn) => Eq(Yn, c, yes),
          nat_eq(ty, 0),
          (
            q: Eq(Yn, nat_eq(ty, 0), no)
          ) => False_elim(
            llk_failed_ne_parsed(
              llk_error(Some(st), Nil),
              Eq_subst(
                (
                  c: Yn
                ) => Eq(
                  LlkResult,
                  llk_value(
                    llk_wrap1(
                      s,
                      llk_finish_at(
                        Cons(llk_tok(ty, st, en, tr), rest),
                        llk_tok(ty, st, en, tr),
                        ev,
                        c
                      )
                    )
                  ),
                  llk_parsed
                ),
                q,
                h
              )
            )
          ),
          (q: Eq(Yn, nat_eq(ty, 0), yes)) => refl()
        )
      )
    }
  }
}

theorem llk_done_of(
  t: LlkTables,
  tokens: List(LlkTok),
  e: llk_at_end(tokens)
): LlkDerives(t, Nil, tokens) {
  match tokens -> LlkDerives(t, Nil, tokens) {
    Nil => False_elim(e)
    Cons(token, rest) => llk_d_done(token, rest, e)
  }
}

theorem llk_end_of(
  t: LlkTables,
  tokens: List(LlkTok),
  e: llk_at_end(tokens)
): LlkDerives(t, Cons(llk_t(0), Nil), tokens) {
  match tokens -> LlkDerives(t, Cons(llk_t(0), Nil), tokens) {
    Nil => False_elim(e)
    Cons(token, rest) => llk_d_end(token, rest, e)
  }
}

// ---- pushing ----------------------------------------------------------------

fn llk_events_push(ev: Stack(LlkEvent), x: LlkEvent) -> Stack(LlkEvent) {
  stack_of(Cons(x, ev.items))
}

// What a call at the end of a body with one `&mut` argument is made into.
fn llk_rewrap1<A, S>(m: Mut1(A, S)) -> Mut1(A, S) {
  match m -> Mut1(A, S) {
    mut1(v, x) => mut1(v, x)
  }
}

theorem llk_rewrap1_id<A: Type, S: Type>(m: Mut1(A, S)): Eq(Mut1(A, S), llk_rewrap1(m), m) {
  match m -> Eq(Mut1(A, S), llk_rewrap1(m), m) {
    mut1(v, x) => refl()
  }
}

// The events after the trivia.
fn llk_trivia_after(trivia: List(ScanToken), ev: Stack(LlkEvent)) -> Stack(LlkEvent) {
  match trivia -> Stack(LlkEvent) {
    Nil => ev
    Cons(
      token,
      rest
    ) => llk_trivia_after(
      rest,
      llk_events_push(ev, llk_token(token.token_type, token.start, token.end))
    )
  }
}

theorem llk_trivia_onto_is(
  trivia: List(ScanToken),
  ev: Stack(LlkEvent)
): Eq(
  Mut1(Unit, Stack(LlkEvent)),
  llk_trivia_onto(trivia, ev),
  mut1(star(), llk_trivia_after(trivia, ev))
) {
  match trivia -> Eq(
    Mut1(Unit, Stack(LlkEvent)),
    llk_trivia_onto(trivia, ev),
    mut1(star(), llk_trivia_after(trivia, ev))
  ) {
    Nil => refl()
    Cons(
      token,
      rest
    ) => Eq_trans(
      llk_rewrap1_id(
        llk_trivia_onto(
          rest,
          llk_events_push(ev, llk_token(token.token_type, token.start, token.end))
        )
      ),
      llk_trivia_onto_is(
        rest,
        llk_events_push(ev, llk_token(token.token_type, token.start, token.end))
      )
    )
  }
}

theorem llk_push_symbols_is(
  symbols: List(LlkSym),
  items: List(LlkSym)
): Eq(
  Mut1(Unit, Stack(LlkSym)),
  llk_push_symbols(symbols, stack_of(items)),
  mut1(star(), stack_of(llk_onto(symbols, items)))
) {
  match symbols -> Eq(
    Mut1(Unit, Stack(LlkSym)),
    llk_push_symbols(symbols, stack_of(items)),
    mut1(star(), stack_of(llk_onto(symbols, items)))
  ) {
    Nil => refl()
    Cons(
      symbol,
      rest
    ) => Eq_trans(
      llk_rewrap1_id(llk_push_symbols(rest, stack_of(Cons(symbol, items)))),
      llk_push_symbols_is(rest, Cons(symbol, items))
    )
  }
}

// ---- the steps of `llk_run_in` ----------------------------------------------

// What the recursive call of `llk_run_in` on `f` steps gives.
def LlkIh(
  f: Nat,
  t: LlkTables
): Prop := ∀ ts: List(
  LlkTok
). ∀ items: List(
  LlkSym
). ∀ ev: Stack(
  LlkEvent
). (
  Eq(LlkResult, llk_value(llk_run_in(f, t, ts, stack_of(items), ev)), llk_parsed)
) -> LlkDerives(t, items, ts)

// A terminal to match, on the tokens and on whether the next one has it.
fn llk_tokens_at(
  f: Nat,
  &t: LlkTables,
  terminal: Nat,
  tokens: List(LlkTok),
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent)
) -> LlkResult {
  match tokens -> LlkResult {
    Nil => llk_failure(tokens, Cons(terminal, Nil))
    Cons(token, more) => match token.token_type == terminal -> LlkResult {
      yes => {
        llk_trivia_onto(token.trivia, &mut events)
        stack_push(&mut events, llk_token(token.token_type, token.start, token.end))
        llk_run_in(f, &t, more, &mut stack, &mut events)
      }
      no => llk_failure(tokens, Cons(terminal, Nil))
    }
  }
}

fn llk_term_at(
  f: Nat,
  &t: LlkTables,
  terminal: Nat,
  tokens: List(LlkTok),
  token: LlkTok,
  more: List(LlkTok),
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent),
  c: Yn
) -> LlkResult {
  match c -> LlkResult {
    yes => {
      llk_trivia_onto(token.trivia, &mut events)
      stack_push(&mut events, llk_token(token.token_type, token.start, token.end))
      llk_run_in(f, &t, more, &mut stack, &mut events)
    }
    no => llk_failure(tokens, Cons(terminal, Nil))
  }
}

// The rest of a matched terminal, once the trivia are pushed (`m`).
fn llk_k_tok(
  f: Nat,
  t: LlkTables,
  more: List(LlkTok),
  token: LlkTok,
  stack: Stack(LlkSym),
  m: Mut1(Unit, Stack(LlkEvent))
) -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
  match m -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
    mut1(
      v,
      events
    ) => match stack_push(
      events,
      llk_token(token.token_type, token.start, token.end)
    ) -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
      mut1(v2, events2) => llk_rewrap(llk_run_in(f, t, more, stack, events2))
    }
  }
}

// A terminal the parser matched is the type of the next token.
theorem llk_term_matches(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  ty: Nat,
  st: Nat,
  en: Nat,
  tr: List(ScanToken),
  more: List(LlkTok),
  ev: Stack(LlkEvent),
  h: Eq(
    LlkResult,
    llk_value(llk_tokens_at(f, t, a, Cons(llk_tok(ty, st, en, tr), more), stack_of(below), ev)),
    llk_parsed
  )
): Eq(Yn, nat_eq(ty, a), yes) {
  yn_cases(
    (c: Yn) => Eq(Yn, c, yes),
    nat_eq(ty, a),
    (
      q: Eq(Yn, nat_eq(ty, a), no)
    ) => False_elim(
      llk_failed_ne_parsed(
        llk_error(Some(st), Cons(a, Nil)),
        Eq_subst(
          (
            c: Yn
          ) => Eq(
            LlkResult,
            llk_value(
              llk_term_at(
                f,
                t,
                a,
                Cons(llk_tok(ty, st, en, tr), more),
                llk_tok(ty, st, en, tr),
                more,
                stack_of(below),
                ev,
                c
              )
            ),
            llk_parsed
          ),
          q,
          h
        )
      )
    ),
    (q: Eq(Yn, nat_eq(ty, a), yes)) => refl()
  )
}

theorem llk_term_case(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  ih: LlkIh(f, t),
  h: Eq(LlkResult, llk_value(llk_tokens_at(f, t, a, tokens, stack_of(below), ev)), llk_parsed)
): LlkDerives(t, Cons(llk_t(a), below), tokens) {
  match tokens -> LlkDerives(t, Cons(llk_t(a), below), tokens) {
    Nil => False_elim(llk_failed_ne_parsed(llk_error(None, Cons(a, Nil)), h))
    Cons(token, more) => match token -> LlkDerives(t, Cons(llk_t(a), below), Cons(token, more)) {
      llk_tok(
        ty,
        st,
        en,
        tr
      ) => llk_d_t(
        a,
        below,
        llk_tok(ty, st, en, tr),
        more,
        nat_eq_sound(ty, a, llk_term_matches(f, t, a, below, ty, st, en, tr, more, ev, h)),
        ih(
          more,
          below,
          llk_events_push(llk_trivia_after(tr, ev), llk_token(ty, st, en)),
          Eq_trans(
            Eq_sym(
              llk_rewrap_value(
                llk_run_in(
                  f,
                  t,
                  more,
                  stack_of(below),
                  llk_events_push(llk_trivia_after(tr, ev), llk_token(ty, st, en))
                )
              )
            ),
            Eq_subst(
              (
                m: Mut1(Unit, Stack(LlkEvent))
              ) => Eq(
                LlkResult,
                llk_value(llk_k_tok(f, t, more, llk_tok(ty, st, en, tr), stack_of(below), m)),
                llk_parsed
              ),
              llk_trivia_onto_is(tr, ev),
              Eq_subst(
                (
                  c: Yn
                ) => Eq(
                  LlkResult,
                  llk_value(
                    llk_term_at(
                      f,
                      t,
                      a,
                      Cons(llk_tok(ty, st, en, tr), more),
                      llk_tok(ty, st, en, tr),
                      more,
                      stack_of(below),
                      ev,
                      c
                    )
                  ),
                  llk_parsed
                ),
                llk_term_matches(f, t, a, below, ty, st, en, tr, more, ev, h),
                h
              )
            )
          )
        )
      )
    }
  }
}

// A non-terminal to expand: on the predicted production, on the production
// the tables have under that number, and on whether it is the non-terminal's.
fn llk_nt_at(
  f: Nat,
  &t: LlkTables,
  non_terminal: Nat,
  tokens: List(LlkTok),
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent),
  o: Option(Nat)
) -> LlkResult {
  match o -> LlkResult {
    None => llk_failure(tokens, Nil)
    Some(production) => match array_get(t.productions, production) -> LlkResult {
      None => llk_failed(LlkError { at: None, expected: Nil })
      Some(found) => match found.lhs == non_terminal -> LlkResult {
        no => llk_failed(LlkError { at: None, expected: Nil })
        yes => {
          stack_push(&mut stack, llk_e(production))
          llk_push_symbols(found.pushes, &mut stack)
          stack_push(&mut events, llk_open(found.lhs))
          llk_run_in(f, &t, tokens, &mut stack, &mut events)
        }
      }
    }
  }
}

fn llk_prod_at(
  f: Nat,
  &t: LlkTables,
  non_terminal: Nat,
  tokens: List(LlkTok),
  production: Nat,
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent),
  o: Option(LlkProduction)
) -> LlkResult {
  match o -> LlkResult {
    None => llk_failed(LlkError { at: None, expected: Nil })
    Some(found) => match found.lhs == non_terminal -> LlkResult {
      no => llk_failed(LlkError { at: None, expected: Nil })
      yes => {
        stack_push(&mut stack, llk_e(production))
        llk_push_symbols(found.pushes, &mut stack)
        stack_push(&mut events, llk_open(found.lhs))
        llk_run_in(f, &t, tokens, &mut stack, &mut events)
      }
    }
  }
}

fn llk_lhs_at(
  f: Nat,
  &t: LlkTables,
  tokens: List(LlkTok),
  production: Nat,
  found: LlkProduction,
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent),
  c: Yn
) -> LlkResult {
  match c -> LlkResult {
    no => llk_failed(LlkError { at: None, expected: Nil })
    yes => {
      stack_push(&mut stack, llk_e(production))
      llk_push_symbols(found.pushes, &mut stack)
      stack_push(&mut events, llk_open(found.lhs))
      llk_run_in(f, &t, tokens, &mut stack, &mut events)
    }
  }
}

// The rest of an expansion, once the symbols are pushed (`m`).
fn llk_k_sym(
  f: Nat,
  t: LlkTables,
  tokens: List(LlkTok),
  found: LlkProduction,
  events: Stack(LlkEvent),
  m: Mut1(Unit, Stack(LlkSym))
) -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
  match m -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
    mut1(
      v,
      stack
    ) => match stack_push(
      events,
      llk_open(found.lhs)
    ) -> Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent)) {
      mut1(v2, events2) => llk_rewrap(llk_run_in(f, t, tokens, stack, events2))
    }
  }
}

theorem llk_lhs_matches(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  p: Nat,
  prod: LlkProduction,
  h: Eq(
    LlkResult,
    llk_value(llk_prod_at(f, t, a, tokens, p, stack_of(below), ev, Some(prod))),
    llk_parsed
  )
): Eq(Yn, nat_eq(llk_lhs_of(prod), a), yes) {
  yn_cases(
    (c: Yn) => Eq(Yn, c, yes),
    nat_eq(llk_lhs_of(prod), a),
    (
      q: Eq(Yn, nat_eq(llk_lhs_of(prod), a), no)
    ) => False_elim(
      llk_failed_ne_parsed(
        llk_error(None, Nil),
        Eq_subst(
          (
            c: Yn
          ) => Eq(
            LlkResult,
            llk_value(llk_lhs_at(f, t, tokens, p, prod, stack_of(below), ev, c)),
            llk_parsed
          ),
          q,
          h
        )
      )
    ),
    (q: Eq(Yn, nat_eq(llk_lhs_of(prod), a), yes)) => refl()
  )
}

theorem llk_expand_case(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  ih: LlkIh(f, t),
  p: Nat,
  prod: LlkProduction,
  hp: Eq(Option(LlkProduction), array_get(llk_productions_of(t), p), Some(prod)),
  h: Eq(
    LlkResult,
    llk_value(llk_prod_at(f, t, a, tokens, p, stack_of(below), ev, Some(prod))),
    llk_parsed
  )
): LlkDerives(t, Cons(llk_n(a), below), tokens) {
  llk_d_n(
    a,
    below,
    tokens,
    p,
    prod,
    hp,
    nat_eq_sound(llk_lhs_of(prod), a, llk_lhs_matches(f, t, a, below, tokens, ev, p, prod, h)),
    ih(
      tokens,
      llk_onto(llk_pushes_of(prod), Cons(llk_e(p), below)),
      llk_events_push(ev, llk_open(llk_lhs_of(prod))),
      Eq_trans(
        Eq_sym(
          llk_rewrap_value(
            llk_run_in(
              f,
              t,
              tokens,
              stack_of(llk_onto(llk_pushes_of(prod), Cons(llk_e(p), below))),
              llk_events_push(ev, llk_open(llk_lhs_of(prod)))
            )
          )
        ),
        Eq_subst(
          (
            m: Mut1(Unit, Stack(LlkSym))
          ) => Eq(LlkResult, llk_value(llk_k_sym(f, t, tokens, prod, ev, m)), llk_parsed),
          llk_push_symbols_is(llk_pushes_of(prod), Cons(llk_e(p), below)),
          Eq_subst(
            (
              c: Yn
            ) => Eq(
              LlkResult,
              llk_value(llk_lhs_at(f, t, tokens, p, prod, stack_of(below), ev, c)),
              llk_parsed
            ),
            llk_lhs_matches(f, t, a, below, tokens, ev, p, prod, h),
            h
          )
        )
      )
    )
  )
}

fn llk_goal_n(t: LlkTables, a: Nat, below: List(LlkSym), tokens: List(LlkTok)) -> Prop {
  LlkDerives(t, Cons(llk_n(a), below), tokens)
}

theorem llk_n_case(
  f: Nat,
  t: LlkTables,
  a: Nat,
  below: List(LlkSym),
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  ih: LlkIh(f, t),
  h: Eq(
    LlkResult,
    llk_value(llk_nt_at(f, t, a, tokens, stack_of(below), ev, llk_predict(t, a, tokens))),
    llk_parsed
  )
): LlkDerives(t, Cons(llk_n(a), below), tokens) {
  llk_option_cases(
    (o: Option(Nat)) => llk_goal_n(t, a, below, tokens),
    llk_predict(t, a, tokens),
    (
      q: Eq(Option(Nat), llk_predict(t, a, tokens), None)
    ) => False_elim(
      llk_failure_ne_parsed(
        tokens,
        Nil,
        Eq_subst(
          (
            o: Option(Nat)
          ) => Eq(
            LlkResult,
            llk_value(llk_nt_at(f, t, a, tokens, stack_of(below), ev, o)),
            llk_parsed
          ),
          q,
          h
        )
      )
    ),
    (
      p: Nat
    ) => (
      q: Eq(Option(Nat), llk_predict(t, a, tokens), Some(p))
    ) => llk_option_cases(
      (o: Option(LlkProduction)) => llk_goal_n(t, a, below, tokens),
      array_get(llk_productions_of(t), p),
      (
        qp: Eq(Option(LlkProduction), array_get(llk_productions_of(t), p), None)
      ) => False_elim(
        llk_failed_ne_parsed(
          llk_error(None, Nil),
          Eq_subst(
            (
              o: Option(LlkProduction)
            ) => Eq(
              LlkResult,
              llk_value(llk_prod_at(f, t, a, tokens, p, stack_of(below), ev, o)),
              llk_parsed
            ),
            qp,
            Eq_subst(
              (
                o: Option(Nat)
              ) => Eq(
                LlkResult,
                llk_value(llk_nt_at(f, t, a, tokens, stack_of(below), ev, o)),
                llk_parsed
              ),
              q,
              h
            )
          )
        )
      ),
      (
        prod: LlkProduction
      ) => (
        qp: Eq(Option(LlkProduction), array_get(llk_productions_of(t), p), Some(prod))
      ) => llk_expand_case(
        f,
        t,
        a,
        below,
        tokens,
        ev,
        ih,
        p,
        prod,
        qp,
        Eq_subst(
          (
            o: Option(LlkProduction)
          ) => Eq(
            LlkResult,
            llk_value(llk_prod_at(f, t, a, tokens, p, stack_of(below), ev, o)),
            llk_parsed
          ),
          qp,
          Eq_subst(
            (
              o: Option(Nat)
            ) => Eq(
              LlkResult,
              llk_value(llk_nt_at(f, t, a, tokens, stack_of(below), ev, o)),
              llk_parsed
            ),
            q,
            h
          )
        )
      )
    )
  )
}

// ---- the parse --------------------------------------------------------------

// A run that says it parsed: what was on the stack derives the tokens.
theorem llk_run_sound(
  fuel: Nat,
  t: LlkTables,
  tokens: List(LlkTok),
  items: List(LlkSym),
  ev: Stack(LlkEvent),
  h: Eq(LlkResult, llk_value(llk_run_in(fuel, t, tokens, stack_of(items), ev)), llk_parsed)
): LlkDerives(t, items, tokens) {
  match fuel -> LlkDerives(t, items, tokens) {
    zero => False_elim(llk_failed_ne_parsed(llk_error(None, Nil), h))
    succ(f) => match items -> LlkDerives(t, items, tokens) {
      Nil => llk_done_of(t, tokens, llk_finish_sound(tokens, ev, stack_of(Nil), h))
      Cons(top, below) => match top -> LlkDerives(t, Cons(top, below), tokens) {
        llk_e(
          p
        ) => llk_d_e(
          p,
          below,
          tokens,
          llk_run_sound(
            f,
            t,
            tokens,
            below,
            llk_events_push(ev, llk_close()),
            Eq_trans(
              Eq_sym(
                llk_rewrap_value(
                  llk_run_in(f, t, tokens, stack_of(below), llk_events_push(ev, llk_close()))
                )
              ),
              h
            )
          )
        )
        llk_t(a) => match a -> LlkDerives(t, Cons(llk_t(a), below), tokens) {
          zero => match below -> LlkDerives(t, Cons(llk_t(zero), below), tokens) {
            Nil => llk_end_of(t, tokens, llk_finish_sound(tokens, ev, stack_of(Nil), h))
            Cons(
              b,
              bs
            ) => llk_term_case(
              f,
              t,
              zero,
              Cons(b, bs),
              tokens,
              ev,
              (
                ts: List(LlkTok)
              ) => (
                its: List(LlkSym)
              ) => (
                e: Stack(LlkEvent)
              ) => (
                hh: Eq(LlkResult, llk_value(llk_run_in(f, t, ts, stack_of(its), e)), llk_parsed)
              ) => llk_run_sound(f, t, ts, its, e, hh),
              h
            )
          }
          succ(
            a2
          ) => llk_term_case(
            f,
            t,
            succ(a2),
            below,
            tokens,
            ev,
            (
              ts: List(LlkTok)
            ) => (
              its: List(LlkSym)
            ) => (
              e: Stack(LlkEvent)
            ) => (
              hh: Eq(LlkResult, llk_value(llk_run_in(f, t, ts, stack_of(its), e)), llk_parsed)
            ) => llk_run_sound(f, t, ts, its, e, hh),
            h
          )
        }
        llk_n(
          a
        ) => llk_n_case(
          f,
          t,
          a,
          below,
          tokens,
          ev,
          (
            ts: List(LlkTok)
          ) => (
            its: List(LlkSym)
          ) => (
            e: Stack(LlkEvent)
          ) => (
            hh: Eq(LlkResult, llk_value(llk_run_in(f, t, ts, stack_of(its), e)), llk_parsed)
          ) => llk_run_sound(f, t, ts, its, e, hh),
          h
        )
      }
    }
  }
}

fn llk_value1(m: Mut1(LlkResult, Stack(LlkEvent))) -> LlkResult {
  match m -> LlkResult {
    mut1(v, e) => v
  }
}

// What the body of `llk_parse` makes of its call of `llk_run_in`.
fn llk_drop(m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))) -> Mut1(LlkResult, Stack(LlkEvent)) {
  match m -> Mut1(LlkResult, Stack(LlkEvent)) {
    mut2(v, s, e) => mut1(v, e)
  }
}

theorem llk_drop_value(
  m: Mut2(LlkResult, Stack(LlkSym), Stack(LlkEvent))
): Eq(LlkResult, llk_value1(llk_drop(m)), llk_value(m)) {
  match m -> Eq(LlkResult, llk_value1(llk_drop(m)), llk_value(m)) {
    mut2(v, s, e) => refl()
  }
}

fn llk_start_of(t: LlkTables) -> Nat {
  t.start
}

fn llk_root_of(t: LlkTables) -> Nat {
  t.non_terminals
}

// A parse that says it parsed: the start symbol derives the tokens, whatever the fuel (a variable, so
// that the proof does not run the parser).
theorem llk_parse_sound(
  fuel: Nat,
  t: LlkTables,
  tokens: List(LlkTok),
  ev: Stack(LlkEvent),
  h: Eq(LlkResult, llk_value1(llk_parse(fuel, t, tokens, ev)), llk_parsed)
): LlkDerives(t, Cons(llk_n(llk_start_of(t)), Nil), tokens) {
  llk_run_sound(
    fuel,
    t,
    tokens,
    Cons(llk_n(llk_start_of(t)), Nil),
    llk_events_push(ev, llk_open(llk_root_of(t))),
    Eq_trans(
      Eq_sym(
        llk_drop_value(
          llk_run_in(
            fuel,
            t,
            tokens,
            stack_of(Cons(llk_n(llk_start_of(t)), Nil)),
            llk_events_push(ev, llk_open(llk_root_of(t)))
          )
        )
      ),
      h
    )
  )
}
