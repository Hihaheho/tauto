import std::Stack
import std::Array
import "../../scan/src/scan.taut"
import "../../text/src/text.taut"
import std::Base

// The LL(k) parser that reads the tables of the LL(k) table generator, in the
// proof language (`docs/design/self-host.md`). `README.md` says what it does
// and why.

// A symbol on the parser's stack: a non-terminal to expand, a terminal to
// match, or the end of a production (which closes its non-terminal).
pub(open) inductive LlkSym: Type {
  LlkN(non_terminal: Nat): LlkSym
  LlkT(terminal: Nat): LlkSym
  LlkE(production: Nat): LlkSym
}

// A production: its left side, and its symbols in the order the parser
// pushes them (the one it expands first is pushed last).
pub(open) inductive LlkProduction: Type {
  Mk(lhs: Nat, pushes: List(LlkSym)): LlkProduction
}

// A token the parser reads (one that is not skipped), with the skipped
// tokens before it.
pub(open) inductive LlkTok: Type {
  Mk(token_type: Nat, start: Nat, end: Nat, trivia: List(ScanToken)): LlkTok
}

// What a parse gives: the tree, as the calls that build it, in order. The
// root, the node of the empty name, is non-terminal number `non_terminals`.
pub(open) inductive LlkEvent: Type {
  LlkOpen(non_terminal: Nat): LlkEvent
  LlkClose: LlkEvent
  LlkToken(terminal: Nat, r#from: Nat, to: Nat): LlkEvent
}

// Where the first error is (the start of the token the parser could not
// use, if there is one) and the terminals it would have taken (only when a
// terminal was to be matched).
pub(open) inductive LlkError: Type {
  Mk(at: Option(Nat), expected: List(Nat)): LlkError
}

// A parse that succeeded has left its events on the stack it was given.
pub(open) inductive LlkResult: Type {
  LlkParsed: LlkResult
  LlkFailed(error: LlkError): LlkResult
}

pub(open) inductive LlkTables: Type {
  Mk(
    start: Nat,
    max_k: Nat,
    terminals: Nat,
    non_terminals: Nat,
    skip: Array(List(Nat)),
    // Per non-terminal: its production when no token is read, plus one (0
    // for None); its lookahead depth in tokens; where its states start.
    prod0: Array(Nat),
    depth: Array(Nat),
    first_state: Array(Nat),
    // (state, terminal): the next state * 1024 + the production + 1, or 0.
    cells: Array(Nat),
    productions: Array(LlkProduction)
  ): LlkTables
}

// The `k` numbers from `at`, put before `done` last first.
pub fn llk_numbers_onto(k: Nat, a: Array(Nat), at: Nat, done: List(Nat)): List(Nat) {
  match k: List(Nat) {
    Zero => done
    Succ(k2) => llk_numbers_onto(k2, a, at + 1, Cons(scan_number(a, at), done))
  }
}

// The skipped terminals of `k` modes from `p` (last mode first), and where
// they end.
pub fn llk_skips_in(k: Nat, a: Array(Nat), p: Nat, done: List(List(Nat))): List(List(Nat)) × Nat {
  match k: List(List(Nat)) × Nat {
    Zero => #(done, p)
    Succ(k2) => llk_skips_in(
      k2,
      a,
      p + 1 + scan_number(a, p),
      Cons(llk_numbers_onto(scan_number(a, p), a, p + 1, Nil), done)
    )
  }
}

// Where the states of `k` automata start (last first), from `states`, and
// how many states there are.
pub fn llk_starts_in(
  k: Nat,
  a: Array(Nat),
  at: Nat,
  states: Nat,
  done: List(Nat)
): List(Nat) × Nat {
  match k: List(Nat) × Nat {
    Zero => #(done, states)
    Succ(k2) => llk_starts_in(k2, a, at + 3, states + scan_number(a, at), Cons(states, done))
  }
}

// The cells, run by run, until `total` are (last first), and where the runs
// end. Each run fills one cell at least, so `fuel` is `total`.
pub fn llk_cells_in(
  fuel: Nat,
  total: Nat,
  a: Array(Nat),
  filled: Nat,
  rp: Nat,
  done: List(Nat)
): List(Nat) × Nat {
  match fuel: List(Nat) × Nat {
    Zero => #(done, rp)
    Succ(f) => match filled < total: List(Nat) × Nat {
      false => #(done, rp)
      true => llk_cells_in(
        f,
        total,
        a,
        filled + scan_number(a, rp),
        rp + 2,
        scan_repeat_onto(scan_number(a, rp), scan_number(a, rp + 1), done)
      )
    }
  }
}

// `k` symbols from `at`, put before `done` last first: the symbols as the
// parser expands them, the first at the head.
pub fn llk_symbols_onto(k: Nat, a: Array(Nat), at: Nat, done: List(LlkSym)): List(LlkSym) {
  match k: List(LlkSym) {
    Zero => done
    Succ(k2) => llk_symbols_onto(
      k2,
      a,
      at + 2,
      Cons(
        match scan_number(a, at): LlkSym {
          Zero => LlkN(scan_number(a, at + 1))
          Succ(other) => LlkT(scan_number(a, at + 1))
        },
        done
      )
    )
  }
}

// `k` productions from `pp` (last first), and where they end.
pub fn llk_productions_in(
  k: Nat,
  a: Array(Nat),
  pp: Nat,
  done: List(LlkProduction)
): List(LlkProduction) × Nat {
  match k: List(LlkProduction) × Nat {
    Zero => #(done, pp)
    Succ(k2) => llk_productions_in(
      k2,
      a,
      pp + 2 + scan_number(a, pp + 1) * 2,
      Cons(
        LlkProduction {
          lhs: scan_number(a, pp),
          pushes: List::reverse(llk_symbols_onto(scan_number(a, pp + 1), a, pp + 2, Nil))
        },
        done
      )
    )
  }
}

pub fn llk_tables_from(
  pm: Array(Nat),
  sk: Array(Nat),
  lm: Array(Nat),
  lc: Array(Nat),
  pr: Array(Nat)
): Option(LlkTables) {
  let terminals := scan_number(pm, 2)
  let n_automata := scan_number(lm, 0)
  let skips := llk_skips_in(scan_number(sk, 0), sk, 1, Nil)
  let starts := llk_starts_in(n_automata, lm, 3, 0, Nil)
  let cells := llk_cells_in((starts: Nat) * terminals, (starts: Nat) * terminals, lc, 0, 0, Nil)
  let productions := llk_productions_in(scan_number(pr, 0), pr, 1, Nil)
  match scan_within(
    4,
    pm
  ) && scan_within(
    (skips: Nat),
    sk
  ) && scan_within(
    1 + n_automata * 3,
    lm
  ) && scan_within((cells: Nat), lc) && scan_within((productions: Nat), pr): Option(LlkTables) {
    false => None
    true => Some(
      LlkTables {
        start: scan_number(pm, 1),
        max_k: scan_number(pm, 0),
        terminals: terminals,
        non_terminals: scan_number(pm, 3),
        skip: Array::of_list(List::reverse((skips: List(List(Nat))))),
        prod0: Array::of_list(scan_column(n_automata, lm, 1, 3)),
        depth: Array::of_list(scan_column(n_automata, lm, 2, 3)),
        first_state: scan_array((starts: List(Nat))),
        cells: scan_array((cells: List(Nat))),
        productions: Array::of_list(List::reverse((productions: List(LlkProduction))))
      }
    )
  }
}

// Reads the tables from the texts of `syntax_tables_parser_meta`,
// `syntax_tables_skip`, `syntax_tables_lookahead_meta`,
// `syntax_tables_lookahead_cells` and `syntax_tables_productions`. `None` when they are
// too short for what they say.
pub fn llk_tables_read(
  parser_meta: Text,
  skip: Text,
  lookahead_meta: Text,
  lookahead_cells: Text,
  productions: Text
): Option(LlkTables) {
  llk_tables_from(
    Array::of_list(text_number_list(parser_meta)),
    Array::of_list(text_number_list(skip)),
    Array::of_list(text_number_list(lookahead_meta)),
    Array::of_list(text_number_list(lookahead_cells)),
    Array::of_list(text_number_list(productions))
  )
}

pub fn llk_member(xs: List(Nat), x: Nat): Bool {
  match xs: Bool {
    Nil => false
    Cons(y, rest) => match y == x: Bool {
      true => true
      false => llk_member(rest, x)
    }
  }
}

// Whether the parser does not read this token: whitespace and comments
// (terminals 1 to 4), and what the grammar skips (`skip`, per mode) in the
// mode it was cut in.
pub fn llk_skipped(skip: Array(List(Nat)), token: ScanToken): Bool {
  match 1 <= token.token_type && token.token_type <= 4: Bool {
    true => true
    false => llk_member(Array::get_or(skip, token.mode, Nil), token.token_type)
  }
}

pub fn llk_tokens_in(
  rest: List(ScanToken),
  skip: Array(List(Nat)),
  length: Nat,
  pending: List(ScanToken),
  done: List(LlkTok)
): List(LlkTok) {
  match rest: List(LlkTok) {
    Nil => List::reverse(
      Cons(
        LlkTok { token_type: 0, start: length, end: length, trivia: Nil },
        Cons(
          LlkTok { token_type: 0, start: length, end: length, trivia: List::reverse(pending) },
          done
        )
      )
    )
    Cons(token, more) => match llk_skipped(skip, token): List(LlkTok) {
      true => llk_tokens_in(more, skip, length, Cons(token, pending), done)
      false => llk_tokens_in(
        more,
        skip,
        length,
        Nil,
        Cons(
          LlkTok {
            token_type: token.token_type,
            start: token.start,
            end: token.end,
            trivia: List::reverse(pending)
          },
          done
        )
      )
    }
  }
}

// The tokens the parser reads, each with the skipped ones before it
// (`TokenStream`), and at the end two tokens of the end of the input (the
// skipped ones before the end go with the first). `length` is the length
// of the input.
pub fn llk_tokens(&t: LlkTables, tokens: List(ScanToken), length: Nat): List(LlkTok) {
  llk_tokens_in(tokens, t.skip, length, Nil, Nil)
}

// The type of the next token, 0 (the end) past the end.
pub fn llk_next_type(tokens: List(LlkTok)): Nat {
  match tokens: Nat {
    Nil => 0
    Cons(token, rest) => token.token_type
  }
}

pub fn llk_rest(tokens: List(LlkTok)): List(LlkTok) {
  match tokens: List(LlkTok) {
    Nil => Nil
    Cons(token, rest) => rest
  }
}

pub fn llk_last(production: Nat, last: Nat): Nat {
  match production: Nat {
    Zero => last
    Succ(p) => production
  }
}

pub fn llk_chosen(production: Nat, last: Nat): Option(Nat) {
  match production: Option(Nat) {
    Succ(p) => Some(p)
    Zero => match last: Option(Nat) {
      Succ(l) => Some(l)
      Zero => None
    }
  }
}

// `k` more tokens through the automaton from `state`, whose states start at
// `base`. `production` and `last` are plus one, 0 for None.
pub fn llk_predict_in(
  k: Nat,
  &t: LlkTables,
  base: Nat,
  tokens: List(LlkTok),
  state: Nat,
  production: Nat,
  last: Nat
): Option(Nat) {
  match k: Option(Nat) {
    Zero => llk_chosen(production, last)
    Succ(k2) => match scan_number(
      t.cells,
      (base + state) * t.terminals + llk_next_type(tokens)
    ): Option(Nat) {
      Zero => llk_predict_in(k2, t, base, llk_rest(tokens), state, production, last)
      Succ(c) => llk_predict_in(
        k2,
        t,
        base,
        llk_rest(tokens),
        Nat::div_nz(Succ(c), 1024, Nat::ne_zero(1024, Refl)),
        Nat::rem_nz(Succ(c), 1024, Nat::ne_zero(1024, Refl)),
        llk_last(Nat::rem_nz(Succ(c), 1024, Nat::ne_zero(1024, Refl)), last)
      )
    }
  }
}

// The production of a non-terminal for the tokens ahead: from the first state, each of the `k` tokens takes the transition
// it has, if any; the production is the one of the last state that has one.
pub fn llk_predict(&t: LlkTables, non_terminal: Nat, tokens: List(LlkTok)): Option(Nat) {
  llk_predict_in(
    scan_number(t.depth, non_terminal),
    t,
    scan_number(t.first_state, non_terminal),
    tokens,
    0,
    scan_number(t.prod0, non_terminal),
    0
  )
}

pub fn llk_trivia_onto(trivia: List(ScanToken), &mut events: Stack(LlkEvent)): Unit {
  match trivia: Unit {
    Nil => #()
    Cons(token, rest) => {
      Stack::push(&mut events, LlkToken(token.token_type, token.start, token.end))
      llk_trivia_onto(rest, &mut events)
    }
  }
}

pub fn llk_push_symbols(symbols: List(LlkSym), &mut stack: Stack(LlkSym)): Unit {
  match symbols: Unit {
    Nil => #()
    Cons(symbol, rest) => {
      Stack::push(&mut stack, symbol)
      llk_push_symbols(rest, &mut stack)
    }
  }
}

pub fn llk_failure(tokens: List(LlkTok), expected: List(Nat)): LlkResult {
  match tokens: LlkResult {
    Nil => LlkFailed(LlkError { at: None, expected: expected })
    Cons(token, rest) => LlkFailed(LlkError { at: Some(token.start), expected: expected })
  }
}

// The end of a parse whose stack is done: the input must be at its end.
pub fn llk_finish(tokens: List(LlkTok), &mut events: Stack(LlkEvent)): LlkResult {
  match tokens: LlkResult {
    Nil => llk_failure(tokens, Nil)
    Cons(token, rest) => match token.token_type == 0: LlkResult {
      true => {
        llk_trivia_onto(token.trivia, &mut events)
        Stack::push(&mut events, LlkClose)
        LlkParsed
      }
      false => llk_failure(tokens, Nil)
    }
  }
}

// At most `fuel` steps of the parser. The first error ends it; there is no
// recovery after an error. The parser is done when nothing
// is left on the stack, or only the end of the input.
pub fn llk_run_in(
  fuel: Nat,
  &t: LlkTables,
  tokens: List(LlkTok),
  &mut stack: Stack(LlkSym),
  &mut events: Stack(LlkEvent)
): LlkResult {
  match fuel: LlkResult {
    Zero => LlkFailed(LlkError { at: None, expected: Nil })
    Succ(f) => match Stack::pop(&mut stack): LlkResult {
      None => llk_finish(tokens, &mut events)
      Some(top) => match top: LlkResult {
        LlkT(terminal) => match terminal == 0 && Stack::is_empty(&stack): LlkResult {
          true => llk_finish(tokens, &mut events)
          false => match tokens: LlkResult {
            Nil => llk_failure(tokens, Cons(terminal, Nil))
            Cons(token, more) => match token.token_type == terminal: LlkResult {
              true => {
                llk_trivia_onto(token.trivia, &mut events)
                Stack::push(&mut events, LlkToken(token.token_type, token.start, token.end))
                llk_run_in(f, &t, more, &mut stack, &mut events)
              }
              false => llk_failure(tokens, Cons(terminal, Nil))
            }
          }
        }
        LlkN(non_terminal) => match llk_predict(&t, non_terminal, tokens): LlkResult {
          None => llk_failure(tokens, Nil)
          Some(production) => match Array::get(t.productions, production): LlkResult {
            None => LlkFailed(LlkError { at: None, expected: Nil })
            // A production of another non-terminal: the tables are not a
            // parser (the LL(k) table generator never writes this).
            Some(found) => match found.lhs == non_terminal: LlkResult {
              false => LlkFailed(LlkError { at: None, expected: Nil })
              true => {
                Stack::push(&mut stack, LlkE(production))
                llk_push_symbols(found.pushes, &mut stack)
                Stack::push(&mut events, LlkOpen(found.lhs))
                llk_run_in(f, &t, tokens, &mut stack, &mut events)
              }
            }
          }
        }
        LlkE(production) => {
          Stack::push(&mut events, LlkClose)
          llk_run_in(f, &t, tokens, &mut stack, &mut events)
        }
      }
    }
  }
}

pub fn llk_fuel(t: LlkTables, tokens: List(LlkTok)): Nat {
  (List::length(tokens) + 1) * (t.non_terminals + 1) * 16
}

// Parses the tokens from the start symbol, leaving the events on `events`
// (the last on top). A step reads a token, or opens or closes a node. A parse
// that exhausts its fuel fails. The caller supplies `llk_fuel`; proofs about
// the parser take fuel as a parameter independently of that budget formula.
pub fn llk_parse(
  fuel: Nat,
  &t: LlkTables,
  tokens: List(LlkTok),
  &mut events: Stack(LlkEvent)
): LlkResult {
  var stack: Stack(LlkSym) := Stack::new()
  Stack::push(&mut stack, LlkN(t.start))
  Stack::push(&mut events, LlkOpen(t.non_terminals))
  llk_run_in(fuel, &t, tokens, &mut stack, &mut events)
}
