package {
  name = "surface"
  version = "0.1.0"
}

dependencies {
  ordmap { path = "../ordmap" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}

// The printers of the whole SurfaceTerm group are one mutual block of 60 functions.
// The erasure proofs of the same group are one mutual block of 41 theorems whose arms unfold those functions.
check {
  slow {
    "src/surface.taut" = 60
    "src/dump.taut" = 20
    "src/occurrence_erasure_sound.taut" = 240
  }
}
