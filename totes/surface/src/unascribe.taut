  pub fn surface_unascribe_surfacepattern(
    value: SurfacePattern,
    path: List(Nat),
    keep: Bool
  ): SurfacePattern {
    match value {
      PtWild => PtWild
      PtBind(slot_name, unused) => PtBind(slot_name, unused)
      PtInt(slot_negative, slot_magnitude) => PtInt(slot_negative, slot_magnitude)
      PtBool(slot_value) => PtBool(slot_value)
      PtText(slot_value) => PtText(slot_value)
      PtCtor(slot_name, slot_args) => PtCtor(
        slot_name,
        surface_unascribe_list_surfacepattern_from(slot_args, surface_unascribe_child(path, 1), keep, 0)
      )
      PtRecord(slot_name, slot_fields) => PtRecord(
        slot_name,
        surface_unascribe_list_surfacepatternfield_from(
          slot_fields,
          surface_unascribe_child(path, 1),
          keep,
          0
        )
      )
      PtTyped(slot_name, slot_ty, slot_unused) => PtTyped(
        slot_name,
        surface_unascribe_surfaceterm(slot_ty, surface_unascribe_child(path, 1), keep),
        slot_unused
      )
      PtOther(slot_what) => PtOther(slot_what)
    }
  }

