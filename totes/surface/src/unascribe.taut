import "surface.taut"
import "../../identity/src/identity.taut"
import std::base

// A program with each `(e: T)` read as `#ascribe(T, e)`: for a checker that
// takes an ascription as that application. The walk is the one `occurrence.taut` makes, with
// the occurrences left as they are; `path` is only passed along. `keep` says
// whether the written type is kept: without it, `(e: T)` and `#ascribe(T, e)`
// are read as `e`, for an analysis that reads no types (the rows).
pub fn surface_unascribe_child(path: List(Nat), field: Nat): List(Nat) {
  List::append(path, Cons(field, Nil))
}

mutual {
  pub fn surface_unascribe_list_option_surfaceterm_from(
    value: List(Option(SurfaceTerm)),
    path: List(Nat),
    keep: Bool,
    index: Nat
  ): List(Option(SurfaceTerm)) {
    match value {
      Nil => Nil
      Cons(item, rest) => Cons(
        surface_unascribe_option_surfaceterm(item, surface_unascribe_child(path, index), keep),
        surface_unascribe_list_option_surfaceterm_from(rest, path, keep, index + 1)
      )
    }
  }

  pub fn surface_unascribe_list_surfacearm_from(
