        surface_unascribe_option_surfaceterm(slot_guard, surface_unascribe_child(path, 1), keep),
        surface_unascribe_option_surfaceterm(slot_goal, surface_unascribe_child(path, 2), keep),
        surface_unascribe_surfaceterm(slot_body, surface_unascribe_child(path, 3), keep)
      )
