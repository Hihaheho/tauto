  pub fn surface_unascribe_surfacekind(value: SurfaceKind, path: List(Nat), keep: Bool): SurfaceKind {
    match value {
      SkVar(slot_name) => SkVar(slot_name)
      SkNat(slot_digits) => SkNat(slot_digits)
      SkFloat(slot_digits) => SkFloat(slot_digits)
      SkRow(slot_effects) => SkRow(slot_effects)
      SkText(slot_value) => SkText(slot_value)
      SkBool(slot_value) => SkBool(slot_value)
      SkApp(slot_head, slot_args) => SkApp(
        surface_unascribe_surfaceterm(slot_head, surface_unascribe_child(path, 0), keep),
        surface_unascribe_list_surfaceterm_from(slot_args, surface_unascribe_child(path, 1), keep, 0)
      )
      SkPi(slot_params, slot_result, slot_effects) => SkPi(
        surface_unascribe_list_surfaceparam_from(slot_params, surface_unascribe_child(path, 0), keep, 0),
        surface_unascribe_surfaceterm(slot_result, surface_unascribe_child(path, 1), keep),
        slot_effects
      )
      SkExists(slot_binder, slot_domain, slot_body, unused) => SkExists(slot_binder, surface_unascribe_surfaceterm(slot_domain, surface_unascribe_child(path, 1), keep), surface_unascribe_surfaceterm(slot_body, surface_unascribe_child(path, 2), keep), unused)
      SkLam(slot_params, slot_body, slot_types, unused) => SkLam(
        slot_params,
        surface_unascribe_surfaceterm(slot_body, surface_unascribe_child(path, 1), keep),
        slot_types,
        unused
      )
      SkUnion(slot_parts) => SkUnion(
        surface_unascribe_list_surfaceterm_from(slot_parts, surface_unascribe_child(path, 0), keep, 0)
      )
      SkTagged(slot_tag, slot_value) => SkTagged(
        slot_tag,
        surface_unascribe_surfaceterm(slot_value, surface_unascribe_child(path, 1), keep)
      )
      SkIf(slot_cond, slot_then, slot_otherwise) => SkIf(
        surface_unascribe_surfaceterm(slot_cond, surface_unascribe_child(path, 0), keep),
        surface_unascribe_surfaceterm(slot_then, surface_unascribe_child(path, 1), keep),
        surface_unascribe_option_surfaceterm(slot_otherwise, surface_unascribe_child(path, 2), keep)
      )
      SkField(slot_value, slot_name) => SkField(
        surface_unascribe_surfaceterm(slot_value, surface_unascribe_child(path, 0), keep),
        slot_name
      )
      SkBlock(slot_stmts) => SkBlock(
        surface_unascribe_list_surfacestmt_from(slot_stmts, surface_unascribe_child(path, 0), keep, 0)
      )
      SkPerform(slot_op, slot_args) => SkPerform(
        slot_op,
        surface_unascribe_list_surfaceterm_from(slot_args, surface_unascribe_child(path, 1), keep, 0)
      )
      SkHandle(slot_body, slot_handlers) => SkHandle(
        surface_unascribe_surfaceterm(slot_body, surface_unascribe_child(path, 0), keep),
        surface_unascribe_list_surfacehandler_from(slot_handlers, surface_unascribe_child(path, 1), keep, 0)
      )
      SkBudget(slot_memory, slot_amount, slot_body) => SkBudget(
        slot_memory,
        surface_unascribe_surfaceterm(slot_amount, surface_unascribe_child(path, 1), keep),
        surface_unascribe_surfaceterm(slot_body, surface_unascribe_child(path, 2), keep)
      )
      SkMatch(slot_scrutinee, slot_motive, slot_arms, slot_binder, slot_binder_unused) => SkMatch(
        surface_unascribe_surfaceterm(slot_scrutinee, surface_unascribe_child(path, 0), keep),
        surface_unascribe_option_surfaceterm(slot_motive, surface_unascribe_child(path, 1), keep),
        surface_unascribe_list_surfacearm_from(slot_arms, surface_unascribe_child(path, 2), keep, 0),
        slot_binder,
        slot_binder_unused
      )
      SkHole(slot_name) => SkHole(slot_name)
      SkRecord(slot_name, slot_fields) => SkRecord(
        slot_name,
        surface_unascribe_list_surfacefield_from(slot_fields, surface_unascribe_child(path, 1), keep, 0)
      )
      SkBorrow(slot_mutable, slot_mutable_orig, slot_value) => SkBorrow(
        slot_mutable, slot_mutable_orig,
        surface_unascribe_surfaceterm(slot_value, surface_unascribe_child(path, 1), keep)
      )
      SkFnKind(slot_kind, slot_ty) => SkFnKind(
        slot_kind,
        surface_unascribe_surfaceterm(slot_ty, surface_unascribe_child(path, 1), keep)
      )
      SkBorrowLam(slot_borrows, slot_lam) => SkBorrowLam(
        slot_borrows,
        surface_unascribe_surfaceterm(slot_lam, surface_unascribe_child(path, 1), keep)
      )
      SkOther(slot_what) => SkOther(slot_what)
      SkMacroCall(slot_name, slot_arg) => SkMacroCall(
        slot_name,
        surface_unascribe_surfaceterm(slot_arg, surface_unascribe_child(path, 1), keep)
      )
      SkQuote(slot_stmts_form, slot_stmts) => SkQuote(
        slot_stmts_form,
        surface_unascribe_list_surfacestmt_from(slot_stmts, surface_unascribe_child(path, 1), keep, 0)
      )
      SkSplice(slot_value) => SkSplice(
        surface_unascribe_surfaceterm(slot_value, surface_unascribe_child(path, 0), keep)
      )
      SkSyntaxLit(slot_name, slot_body) => SkSyntaxLit(slot_name, slot_body)
      SkStep(slot_tactic, slot_arg, slot_call_start, slot_call_end, slot_before, slot_arms) => SkStep(
        slot_tactic,
        surface_unascribe_surfaceterm(slot_arg, surface_unascribe_child(path, 1), keep),
        slot_call_start,
        slot_call_end,
        surface_unascribe_option_surfaceterm(slot_before, surface_unascribe_child(path, 4), keep),
        surface_unascribe_list_surfacesteparm_from(slot_arms, surface_unascribe_child(path, 5), keep, 0)
      )
      SkAscribe(slot_value, slot_ty) => SkAscribe(
        surface_unascribe_surfaceterm(slot_value, surface_unascribe_child(path, 0), keep),
        surface_unascribe_surfaceterm(slot_ty, surface_unascribe_child(path, 1), keep)
      )
    }
  }

  pub fn surface_unascribe_surfacelaw(value: SurfaceLaw, path: List(Nat), keep: Bool): SurfaceLaw {
    match value {
      SurfaceLawMk(slot_name, slot_start, slot_end, slot_theorem) => SurfaceLawMk(
        slot_name,
        slot_start,
        slot_end,
        surface_unascribe_surfacetheorem(slot_theorem, surface_unascribe_child(path, 3), keep)
      )
    }
  }

