// A term whose kind's parts are already read: `(e: T)` is `#ascribe(T, e)`,
// or `e` when the type is not kept (and so is `#ascribe(T, e)` read before).
pub fn surface_unascribe_peel(
  kind: SurfaceKind,
  start: Nat,
  end: Nat,
  occurrence: Option(TermOccurrence),
  keep: Bool
): SurfaceTerm {
  match kind {
    SkAscribe(value, ty) => if keep {
      SurfaceTermIndexedMk(
        SkApp(SurfaceTermIndexedMk(SkVar(NameSpelled("#ascribe")), start, end, None), Cons(ty, Cons(value, Nil))),
        start,
        end,
        occurrence
      )
    } else { value }
    SkApp(f, args) => ⊢ SurfaceTerm from match surface_unascribe_erased(f, args, keep) {
      Some(value) => value
      None => SurfaceTermIndexedMk(kind, start, end, occurrence)
    }
    _ => SurfaceTermIndexedMk(kind, start, end, occurrence)
  }
}

// `e` of `#ascribe(T, e)` when the type is not kept.
pub fn surface_unascribe_erased(f: SurfaceTerm, args: List(SurfaceTerm), keep: Bool): Option(SurfaceTerm) {
  if keep { None } else {
    match f.kind {
      SkVar(n) => ⊢ Option(SurfaceTerm) from match n {
        NameSpelled(text) => if text == "#ascribe" {
          ⊢ Option(SurfaceTerm) from match args {
            Cons(^ty, Cons(value, Nil)) => Some(value)
            _ => None
          }
        } else { None }
        _ => None
      }
      _ => None
    }
  }
}

// The statements of a program with every `(e: T)` read as `#ascribe(T, e)`.
pub fn surface_unascribe(stmts: List(SurfaceStmt)): List(SurfaceStmt) {
  surface_unascribe_list_surfacestmt(stmts, Nil, true)
}

// The statements of a program with every `(e: T)` and `#ascribe(T, e)` read as `e`.
pub fn surface_unascribe_erase(stmts: List(SurfaceStmt)): List(SurfaceStmt) {
  surface_unascribe_list_surfacestmt(stmts, Nil, false)
}
