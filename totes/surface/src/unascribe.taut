  ): SurfacePatternField {
    match value {
      SurfacePatternFieldMk(slot_name, slot_pattern) => SurfacePatternFieldMk(
        slot_name,
        surface_unascribe_surfacepattern(slot_pattern, surface_unascribe_child(path, 1), keep)
      )
    }
