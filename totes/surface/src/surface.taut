      PtTyped(slot_name, slot_ty, slot_unused) => PtTyped(
        slot_name,
        surface_lower_surfaceterm(slot_ty, surface_lower_child(path, 1), keep),
        slot_unused
      )
      PtOther(slot_what) => PtOther(slot_what)
    }
