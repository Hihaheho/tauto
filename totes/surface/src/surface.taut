// A term whose kind's parts are already put.
pub fn surface_lower_peel(
  kind: SurfaceKind,
  start: Nat,
  end: Nat,
  occurrence: Option(TermOccurrence)
): SurfaceTerm {
  match kind {
    // `{ loop B }` is not read by the checkers.
    SkBlock(stmts) => ⊢ SurfaceTerm from match stmts {
      Cons(first, ^rest) => ⊢ SurfaceTerm from match first {
        StOther(what, ^s, ^e) => if what == "LoopExpr" {
          SurfaceTermIndexedMk(SkOther("LoopExpr"), start, end, occurrence)
        } else { SurfaceTermIndexedMk(kind, start, end, occurrence) }
        _ => SurfaceTermIndexedMk(kind, start, end, occurrence)
      }
      Nil => SurfaceTermIndexedMk(kind, start, end, occurrence)
    }
    // `match x: T` reads as the scrutinee `(x: T)`; the checkers take `T`
    // as the match's motive.
    SkMatch(scrutinee, motive, arms, binder, binder_unused) => ⊢ SurfaceTerm from match motive {
      Some(^m) => SurfaceTermIndexedMk(kind, start, end, occurrence)
      None => ⊢ SurfaceTerm from match scrutinee {
        SurfaceTermIndexedMk(sk, ^ss, ^se, ^so) => ⊢ SurfaceTerm from match sk {
          SkAscribe(x, t) => SurfaceTermIndexedMk(SkMatch(x, Some(t), arms, binder, binder_unused), start, end, occurrence)
          _ => SurfaceTermIndexedMk(kind, start, end, occurrence)
        }
      }
    }
    _ => SurfaceTermIndexedMk(kind, start, end, occurrence)
  }
}
