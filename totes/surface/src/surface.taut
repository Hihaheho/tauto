import "../../syntax/src/syntax.taut"
import "../../unicode/src/unicode.taut"
import "../../text/src/text.taut"
import std::Text
import std::Base

// The surface syntax of Tauto read from the tree of `totes/syntax`, in the
// proof language (`docs/design/self-host.md`): a port of `crates/tauto-surface/src/surface.rs`
// and `crates/tauto-surface/src/surface/program.rs`. `README.md` says what each
// part does.

// ---- the surface syntax ------------------------------------------------------------
//
// One tree for types and expressions, and the statements and declarations
// around them. A span is two byte positions, the end excluded.

// A term occurrence identifies a lexical position in a prepared tree.
pub(open) inductive TermOccurrence: Type {
  TermOccurrenceMk(path: List(Nat)): TermOccurrence
}

mutual {
  pub(open) inductive SurfaceTerm: Type {
    SurfaceTermIndexedMk(
      kind: SurfaceKind,
      start: Nat,
      end: Nat,
      occurrence: Option(TermOccurrence)
    ): SurfaceTerm
  }
  pub(open) inductive SurfaceKind: Type {
    SkVar(name: Text): SurfaceKind
    SkNat(digits: Text): SurfaceKind
    SkFloat(digits: Text): SurfaceKind
    // `!{a, b} ∪ e` as an argument: the effect names, the row variable last.
    SkRow(effects: List(Text)): SurfaceKind
    SkText(value: Text): SurfaceKind
    SkBool(value: Bool): SurfaceKind
    SkApp(head: SurfaceTerm, args: List(SurfaceTerm)): SurfaceKind
    SkPi(params: List(SurfaceParam), result: SurfaceTerm, effects: Option(List(Text))): SurfaceKind
    SkExists(binder: Text, domain: SurfaceTerm, body: SurfaceTerm): SurfaceKind
    SkLam(params: List(Text), body: SurfaceTerm): SurfaceKind
    SkUnion(parts: List(SurfaceTerm)): SurfaceKind
    // `A × B × C` as a type, `#(a, b, c)` as a value: members told apart by their types.
    SkProduct(members: List(SurfaceTerm)): SurfaceKind
    SkTagged(tag: Text, value: SurfaceTerm): SurfaceKind
    SkIf(cond: SurfaceTerm, then: SurfaceTerm, otherwise: Option(SurfaceTerm)): SurfaceKind
    SkField(value: SurfaceTerm, name: Text): SurfaceKind
    // `x.(T)`: the member of a product at the type `T`.
    SkProject(value: SurfaceTerm, ty: SurfaceTerm): SurfaceKind
    SkBlock(stmts: List(SurfaceStmt)): SurfaceKind
    SkPerform(op: Text, args: List(SurfaceTerm)): SurfaceKind
    SkHandle(body: SurfaceTerm, handlers: List(SurfaceHandler)): SurfaceKind
    // `budget(steps: n) { … }`, or with `memory` a budget of memory.
    SkBudget(memory: Bool, amount: SurfaceTerm, body: SurfaceTerm): SurfaceKind
    SkMatch(
      scrutinee: SurfaceTerm,
      motive: Option(SurfaceTerm),
      arms: List(SurfaceArm),
      binder: Option(Text)
    ): SurfaceKind
    SkHole(name: Text): SurfaceKind
    SkRecord(name: Text, fields: List(SurfaceField)): SurfaceKind
    SkBorrow(mutable: Bool, value: SurfaceTerm): SurfaceKind
    SkFnKind(kind: Text, ty: SurfaceTerm): SurfaceKind
    SkBorrowLam(borrows: List(Option(Bool)), lam: SurfaceTerm): SurfaceKind
    SkOther(what: Text): SurfaceKind
    SkMacroCall(name: Text, arg: SurfaceTerm): SurfaceKind
    SkQuote(stmts_form: Bool, stmts: List(SurfaceStmt)): SurfaceKind
    SkSplice(value: SurfaceTerm): SurfaceKind
    SkSyntaxLit(name: Option(Text), body: Text): SurfaceKind
    SkStep(
      tactic: Text,
      arg: SurfaceTerm,
      call_start: Nat,
      call_end: Nat,
      before: Option(SurfaceTerm),
      arms: List(SurfaceStepArm)
    ): SurfaceKind
  }
  pub(open) inductive SurfaceStepArm: Type {
    SurfaceStepArmMk(
      binders: List(SurfaceField),
      goal: SurfaceTerm,
      body: SurfaceTerm,
      start: Nat,
      end: Nat
    ): SurfaceStepArm
  }
  pub(open) inductive SurfaceParam: Type {
    SurfaceParamMk(name: Option(Text), ty: SurfaceTerm): SurfaceParam
  }
  pub(open) inductive SurfaceField: Type {
    SurfaceFieldMk(name: Text, value: SurfaceTerm): SurfaceField
  }
  pub(open) inductive SurfaceNamed: Type {
    SurfaceNamedMk(name: Text, ty: SurfaceTerm): SurfaceNamed
  }
  pub(open) inductive SurfacePattern: Type {
    PtWild: SurfacePattern
    PtBind(name: Text): SurfacePattern
    PtInt(negative: Bool, magnitude: Nat): SurfacePattern
    PtBool(value: Bool): SurfacePattern
    PtText(value: Text): SurfacePattern
    PtCtor(name: Text, args: List(SurfacePattern)): SurfacePattern
    PtRecord(name: Text, fields: List(SurfacePatternField)): SurfacePattern
    PtOther(what: Text): SurfacePattern
  }
  pub(open) inductive SurfacePatternField: Type {
    SurfacePatternFieldMk(name: Text, pattern: SurfacePattern): SurfacePatternField
  }
  pub(open) inductive SurfaceArm: Type {
    SurfaceArmMk(
      pattern: SurfacePattern,
      guard: Option(SurfaceTerm),
      goal: Option(SurfaceTerm),
      body: SurfaceTerm
    ): SurfaceArm
  }
  pub(open) inductive SurfaceHandler: Type {
    HdReturn(pattern: SurfacePattern, body: SurfaceTerm): SurfaceHandler
    HdOperation(
      op: Text,
      // The instance the arm answers: the names `∀` binds and the type
      // arguments (`∀ A. show<A>(…)`), both empty when none is written.
      Binds: List(Text),
      types: List(SurfaceTerm),
      patterns: List(SurfacePattern),
      r#resume: Option(Text),
      guard: Option(SurfaceTerm),
      body: SurfaceTerm
    ): SurfaceHandler
  }
  pub(open) inductive SurfaceStmt: Type {
    StLet(
      name: Text,
      ty: Option(SurfaceTerm),
      value: SurfaceTerm,
      borrow: Bool,
      mutable: Bool
    ): SurfaceStmt
    StVar(name: Text, ty: Option(SurfaceTerm), value: SurfaceTerm, borrow: Bool): SurfaceStmt
    StModule(name: Text, stmts: List(SurfaceStmt), start: Nat, end: Nat): SurfaceStmt
    // `x.f = v`: `place` is the whole target, written when it is not just `x`.
    StAssign(name: Text, place: Option(SurfaceTerm), value: SurfaceTerm): SurfaceStmt
    // `call => fn a, theorem b`: a macro call and what it makes, `kind name`.
    StCalled(generates: List(Text), call: SurfaceTerm): SurfaceStmt
    StFn(f: SurfaceFn): SurfaceStmt
    StTheorem(t: SurfaceTheorem): SurfaceStmt
    StDef(t: SurfaceTheorem): SurfaceStmt
    StMutual(stmts: List(SurfaceStmt), start: Nat, end: Nat): SurfaceStmt
    StImport(path: Text, start: Nat, end: Nat): SurfaceStmt
    StInductive(i: SurfaceInductive): SurfaceStmt
    StEffect(e: SurfaceEffect): SurfaceStmt
    StStruct(d: SurfaceData): SurfaceStmt
    StEnum(d: SurfaceData): SurfaceStmt
    StExtern(abi: Text, fns: List(SurfaceFn), start: Nat, end: Nat): SurfaceStmt
    StClass(c: SurfaceClass): SurfaceStmt
    StInstance(i: SurfaceInstance): SurfaceStmt
    StWhile(cond: SurfaceTerm, body: SurfaceTerm): SurfaceStmt
    StReturn(value: Option(SurfaceTerm)): SurfaceStmt
    StExpr(value: SurfaceTerm): SurfaceStmt
    StOther(what: Text, start: Nat, end: Nat): SurfaceStmt
    StMacro(name: Text, function: Text, start: Nat, end: Nat): SurfaceStmt
    StSyntax(name: Text, grammar: Text, start: Nat, end: Nat): SurfaceStmt
    // `@name!(arg) stmt`; `generates` as `kind name`, the first after the
    // word written before it (`replace fn f`).
    StAttributed(
      name: Text,
      arg: SurfaceTerm,
      generates: List(Text),
      stmt: SurfaceStmt
    ): SurfaceStmt
  }
  pub(open) inductive SurfaceFn: Type {
    SurfaceFnMk(
      name: Text,
      generics: List(Text),
      bounds: List(Option(Text)),
      params: List(Text),
      borrows: List(Option(Bool)),
      param_types: List(Option(SurfaceTerm)),
      result: Option(SurfaceTerm),
      effects: Option(List(Text)),
      wheres: List(SurfaceConstraint),
      start: Nat,
      end: Nat,
      body: SurfaceTerm
    ): SurfaceFn
  }
  pub(open) inductive SurfaceConstraint: Type {
    SurfaceConstraintMk(r#class: Text, ty: SurfaceTerm, start: Nat, end: Nat): SurfaceConstraint
  }
  // `law name…`: its name and where it is (the proposition is not read).
  pub(open) inductive SurfaceLaw: Type {
    SurfaceLawMk(name: Text, start: Nat, end: Nat): SurfaceLaw
  }
  // `class C(A: bound) { … }`: the methods' signatures (a method has no
  // block, so its body is an `Other` term of kind `ExternFn`) and the laws. `arity` is how many parameters were written.
  pub(open) inductive SurfaceClass: Type {
    SurfaceClassMk(
      name: Text,
      param: Text,
      arity: Nat,
      bound: Option(Text),
      methods: List(SurfaceFn),
      laws: List(SurfaceLaw),
      start: Nat,
      end: Nat
    ): SurfaceClass
  }
  pub(open) inductive SurfaceInstance: Type {
    SurfaceInstanceMk(
      generics: List(Text),
      bounds: List(Option(Text)),
      r#class: Text,
      head: SurfaceTerm,
      wheres: List(SurfaceConstraint),
      methods: List(SurfaceFn),
      laws: List(SurfaceLaw),
      start: Nat,
      end: Nat
    ): SurfaceInstance
  }
  pub(open) inductive SurfaceTheorem: Type {
    SurfaceTheoremMk(
      name: Text,
      implicit: Nat,
      params: List(SurfaceNamed),
      ty: SurfaceTerm,
      body: Option(SurfaceTerm),
      start: Nat,
      end: Nat
    ): SurfaceTheorem
  }
  pub(open) inductive SurfaceCtor: Type {
    SurfaceCtorMk(
      name: Text,
      implicit: Nat,
      params: List(SurfaceNamed),
      result: SurfaceTerm
    ): SurfaceCtor
  }
  pub(open) inductive SurfaceInductive: Type {
    SurfaceInductiveMk(
      name: Text,
      params: List(SurfaceNamed),
      sort: SurfaceTerm,
      constructors: List(SurfaceCtor),
      start: Nat,
      end: Nat
    ): SurfaceInductive
  }
  pub(open) inductive SurfaceEffect: Type {
    SurfaceEffectMk(
      name: Text,
      generics: List(Text),
      params: List(Option(SurfaceTerm)),
      result: Option(SurfaceTerm),
      r#resume: Option(Text),
      start: Nat,
      end: Nat,
      set: Option(List(Text))
    ): SurfaceEffect
  }
  pub(open) inductive SurfaceDataField: Type {
    SurfaceDataFieldMk(name: Option(Text), ty: SurfaceTerm): SurfaceDataField
  }
  pub(open) inductive SurfaceDataCtor: Type {
    SurfaceDataCtorMk(name: Text, fields: List(SurfaceDataField)): SurfaceDataCtor
  }
  pub(open) inductive SurfaceData: Type {
    SurfaceDataMk(
      kind: Option(Text),
      name: Text,
      generics: List(Text),
      constructors: List(SurfaceDataCtor),
      start: Nat,
      end: Nat
    ): SurfaceData
  }
}

// Construction has no lexical identity until the complete tree is prepared.
pub fn surface_term_mk(kind: SurfaceKind, start: Nat, end: Nat): SurfaceTerm {
  SurfaceTermIndexedMk(kind, start, end, None)
}

pub fn surface_append<A>(xs: List(A), ys: List(A)): List(A) {
  List::append(xs, ys)
}

pub fn surface_reverse<A>(xs: List(A)): List(A) {
  List::reverse(xs)
}

// The value of a text literal's token (`unquote_text` of `surface.rs`):
// `"…"` with its escapes resolved (`\\ \" \' \n \r \t \0 \u{X…}`), `'…'` and
// plaintext`…` as written.

pub fn surface_inner(token: Text): Text {
  match Text::len(token) >= 2: Text {
    true => Text::slice_or_empty(token, 1, Text::len(token) - 1)
    false => ""
  }
}

// The value of a hexadecimal digit, or 16.
pub fn surface_hex_digit(b: Nat): Nat {
  match b >= 48 && b <= 57: Nat {
    true => b - 48
    false => match b >= 97 && b <= 102: Nat {
      true => b - 87
      false => match b >= 65 && b <= 70: Nat {
        true => b - 55
        false => 16
      }
    }
  }
}

pub fn surface_hex_in(k: Nat, digits: Text, at: Nat, acc: Nat): Option(Nat) {
  match k: Option(Nat) {
    Zero => None
    Succ(j) => match at >= Text::len(digits): Option(Nat) {
      true => Some(acc)
      false => match surface_hex_digit(Text::byte_value(digits, at)) > 15: Option(Nat) {
        true => None
        false => match acc * 16 + surface_hex_digit(
          Text::byte_value(digits, at)
        ) > 4294967295: Option(Nat) {
          true => None
          false => surface_hex_in(
            j,
            digits,
            at + 1,
            acc * 16 + surface_hex_digit(Text::byte_value(digits, at))
          )
        }
      }
    }
  }
}

// `u32::from_str_radix(digits, 16)`: an optional `+`, then digits, and the
// value must fit in 32 bits.
pub fn surface_hex(digits: Text): Option(Nat) {
  match Text::len(digits) > 0 && Text::byte_value(digits, 0) == 43: Option(Nat) {
    true => match 1 >= Text::len(digits): Option(Nat) {
      true => None
      false => surface_hex_in(Text::len(digits) + 1, digits, 1, 0)
    }
    false => match 0 >= Text::len(digits): Option(Nat) {
      true => None
      false => surface_hex_in(Text::len(digits) + 1, digits, 0, 0)
    }
  }
}

// The character of a code point, U+FFFD when there is None.
pub fn surface_char_of(code: Option(Nat)): Text {
  match code: Text {
    None => text_code_point(65533)
    Some(c) => match c < 1114112 && not(c >= 55296 && c < 57344): Text {
      true => text_code_point(c)
      false => text_code_point(65533)
    }
  }
}

pub fn surface_unicode_read(body: Text, start: Nat, close: Nat): Pair(Text, Nat) {
  Pair { fst: surface_char_of(
    surface_hex(Text::slice_or_empty(body, start, close))
  ), snd: match close < Text::len(body): Nat {
      true => close + 1
      false => close
    } }
}

pub fn surface_unicode_close(body: Text, start: Nat): Pair(Text, Nat) {
  surface_unicode_read(body, start, match text_find(body, "}", start): Nat {
    Some(c) => c
    None => Text::len(body)
  })
}

// After `\u`: the next character is skipped (it is the `{`), the characters
// up to a `}` (which is taken too) are hexadecimal digits of a code point;
// a bad one is U+FFFD. The character and where reading resumes.
pub fn surface_unicode_escape(body: Text, at: Nat): Pair(Text, Nat) {
  surface_unicode_close(body, match text_decode(body, at): Nat {
    Some(#(@code _, @len len)) => at + len
    None => at
  })
}

// The character an escape `\c` (`c` is `escape`) stands for, when it is not
// `\u`.
pub fn surface_escaped(escape: Nat, written: Text): Text {
  match escape == 110: Text {
    true => text_code_point(10)
    false => match escape == 114: Text {
      true => text_code_point(13)
      false => match escape == 116: Text {
        true => text_code_point(9)
        false => match escape == 48: Text {
          true => text_code_point(0)
          false => written
        }
      }
    }
  }
}

pub fn surface_escapes_in(k: Nat, body: Text, at: Nat, done: List(Text)): List(Text) {
  match k: List(Text) {
    Zero => done
    Succ(j) => match text_decode(body, at): List(Text) {
      None => done
      Some(#(@code code, @len len)) => match code != 92: List(Text) {
        true => surface_escapes_in(
          j,
          body,
          at + len,
          Cons(Text::slice_or_empty(body, at, at + len), done)
        )
        false => match text_decode(body, at + 1): List(Text) {
          None => done
          Some(#(@code escape, @len escape_len)) => match escape == 117: List(Text) {
            true => surface_escapes_in(
              j,
              body,
              surface_unicode_escape(body, at + 1 + escape_len).snd,
              Cons(surface_unicode_escape(body, at + 1 + escape_len).fst, done)
            )
            false => surface_escapes_in(
              j,
              body,
              at + 1 + escape_len,
              Cons(surface_escaped(escape, Text::slice_or_empty(body, at + 1, at + 1 + escape_len)), done)
            )
          }
        }
      }
    }
  }
}

pub fn surface_escapes(body: Text): Text {
  Text::concat_all(List::reverse(surface_escapes_in(Text::len(body) + 1, body, 0, Nil)))
}

pub fn surface_unquote_plain(raw: Text): Text {
  match Text::len(raw) > 0 && Text::byte_value(raw, Text::len(raw) - 1) == 96: Text {
    true => Text::slice_or_empty(raw, 0, Text::len(raw) - 1)
    false => raw
  }
}

pub fn surface_unquote(token: Text): Text {
  match text_starts_with(token, "plaintext`", 0): Text {
    true => surface_unquote_plain(Text::slice_or_empty(token, 10, Text::len(token)))
    false => match text_starts_with(token, "'", 0): Text {
      true => surface_inner(token)
      false => surface_escapes(surface_inner(token))
    }
  }
}

// How many nodes the tree has below `flat`, where every walk goes: enough steps
// for any walk through it.
mutual {
  pub fn surface_size(n: CstNode): Nat {
    match n: Nat {
      Mk(kind, name, terminal, trivia, declared, start, end, children, flat) => Succ(
        surface_sizes(flat)
      )
    }
  }
  pub fn surface_sizes(l: List(CstNode)): Nat {
    match l: Nat {
      Nil => 0
      Cons(x, rest) => surface_size(x) + surface_sizes(rest)
    }
  }
}

// What reading the tree of `totes/syntax` needs (`Reader` of `surface.rs`):
// the source, how far the spans are shifted, the character classes, and how
// many steps a walk through the tree may take.
pub(open) inductive SurfaceCtx: Type {
  Mk(source: Text, base: Nat, classes: UnicodeClasses, fuel: Nat): SurfaceCtx
}

pub(open) inductive SurfaceSpan: Type {
  Mk(start: Nat, end: Nat): SurfaceSpan
}

pub fn surface_span(c: SurfaceCtx, n: CstNode): SurfaceSpan {
  SurfaceSpan { start: n.start + c.base, end: n.end + c.base }
}

pub fn surface_term_at(kind: SurfaceKind, span: SurfaceSpan): SurfaceTerm {
  SurfaceTerm { occurrence: None, kind: kind, start: span.start, end: span.end }
}

// The text of a node's span (not shifted).
// The text of a node. A name written `r#name` is `name`: the `r#` is not part of it.
pub fn surface_text(c: SurfaceCtx, n: CstNode): Text {
  match surface_is(n, "Ident") || surface_is(n, "FnName") || surface_is(n, "CondPath") || surface_is(n, "OperationName"): Text {
    true => surface_unraw(Text::slice_or_empty(c.source, n.start, n.end))
    false => Text::slice_or_empty(c.source, n.start, n.end)
  }
}

pub fn surface_unraw(written: Text): Text {
  match Text::len(written) > 2 && Text::slice_or_empty(written, 0, 2) == "r#": Text {
    true => Text::slice_or_empty(written, 2, Text::len(written))
    false => written
  }
}

pub fn surface_is(n: CstNode, name: Text): Bool {
  not(n.terminal) && n.name == name
}

pub fn surface_find_in(nodes: List(CstNode), name: Text): Option(CstNode) {
  match nodes: Option(CstNode) {
    Nil => None
    Cons(n, rest) => match surface_is(n, name): Option(CstNode) {
      true => Some(n)
      false => surface_find_in(rest, name)
    }
  }
}

// The first child (as `Cst::children` has them) of this kind.
// The parenthesized list `n` is, when it is nothing else: `n` or its only
// child, down to a `Paren`.
pub fn surface_sole_paren(k: Nat, n: CstNode): Option(CstNode) {
  match k: Option(CstNode) {
    Zero => None
    Succ(j) => match surface_is(n, "Paren"): Option(CstNode) {
      true => Some(n)
      false => match n.flat: Option(CstNode) {
        Cons(only, rest) => match rest: Option(CstNode) {
          Nil => surface_sole_paren(j, only)
          Cons(x, y) => None
        }
        Nil => None
      }
    }
  }
}

pub fn surface_first(n: CstNode, name: Text): Option(CstNode) {
  surface_find_in(n.flat, name)
}

pub fn surface_filter_in(nodes: List(CstNode), name: Text): List(CstNode) {
  match nodes: List(CstNode) {
    Nil => Nil
    Cons(n, rest) => match surface_is(n, name): List(CstNode) {
      true => Cons(n, surface_filter_in(rest, name))
      false => surface_filter_in(rest, name)
    }
  }
}

pub fn surface_all(n: CstNode, name: Text): List(CstNode) {
  surface_filter_in(n.flat, name)
}

pub fn surface_nth(nodes: List(CstNode), i: Nat): Option(CstNode) {
  match nodes: Option(CstNode) {
    Nil => None
    Cons(n, rest) => match i: Option(CstNode) {
      Zero => Some(n)
      Succ(i2) => surface_nth(rest, i2)
    }
  }
}

pub fn surface_kind_name(n: CstNode): Text {
  match n.terminal: Text {
    true => "token"
    false => n.name
  }
}

pub fn surface_other(c: SurfaceCtx, n: CstNode): SurfaceTerm {
  surface_term_at(SkOther(surface_kind_name(n)), surface_span(c, n))
}

pub fn surface_var(name: Text, span: SurfaceSpan): SurfaceTerm {
  surface_term_at(SkVar(name), span)
}

pub fn surface_app(function: Text, arguments: List(SurfaceTerm), span: SurfaceSpan): SurfaceTerm {
  surface_term_at(SkApp(surface_var(function, span), arguments), span)
}

// `where C(T)` of a theorem is a parameter after the generics, the record
// of the class, named `inst@C` followed by the clause's index (`inst@C0`
// for the first when `index` is 0).
pub fn surface_dictionary_params(wheres: List(SurfaceConstraint), index: Nat): List(SurfaceNamed) {
  match wheres: List(SurfaceNamed) {
    Nil => Nil
    Cons(w, rest) => match w: List(SurfaceNamed) {
      SurfaceConstraintMk(r#class, ty, start, end) => Cons(
        SurfaceNamed {
          name: Text::concat("inst@", Text::concat(r#class, Text::of_nat(index))),
          ty: surface_app(r#class, Cons(ty, Nil), SurfaceSpan { start: start, end: end })
        },
        surface_dictionary_params(rest, index + 1)
      )
    }
  }
}

pub fn surface_one(xs: List(CstNode)): Option(CstNode) {
  match xs: Option(CstNode) {
    Nil => None
    Cons(x, rest) => match rest: Option(CstNode) {
      Nil => Some(x)
      Cons(y, more) => None
    }
  }
}

pub fn surface_has(nodes: List(CstNode), name: Text): Bool {
  match surface_find_in(nodes, name): Bool {
    Some(n) => true
    None => false
  }
}

// The text of the first `Ident` among the node's children, or "".
// The type written in `x.(T)`, when the field is one.
pub fn surface_field_type(n: CstNode): Option(CstNode) {
  match surface_first(n, "FieldGroup"): Option(CstNode) {
    Some(g) => surface_first(g, "Type")
    None => surface_first(n, "Type")
  }
}

pub fn surface_ident(c: SurfaceCtx, n: CstNode): Text {
  match surface_first(n, "Ident"): Text {
    Some(i) => surface_text(c, i)
    None => ""
  }
}

// The node that names a field: a name, or a reserved word where only a name can stand (`t.type`,
// `#{ view: v }`).
pub fn surface_find_label(nodes: List(CstNode)): Option(CstNode) {
  match nodes: Option(CstNode) {
    Nil => None
    Cons(x, rest) => match surface_is(x, "Ident"): Option(CstNode) {
      true => Some(x)
      false => surface_find_label(rest)
    }
  }
}

pub fn surface_label(c: SurfaceCtx, n: CstNode): Text {
  surface_name_of(c, surface_find_label(n.flat))
}

pub fn surface_opt_ident(c: SurfaceCtx, n: CstNode): Option(Text) {
  match surface_first(n, "Ident"): Option(Text) {
    Some(i) => Some(surface_text(c, i))
    None => None
  }
}

pub fn surface_name_of(c: SurfaceCtx, n: Option(CstNode)): Text {
  match n: Text {
    Some(x) => surface_text(c, x)
    None => ""
  }
}

// A macro's name without the `!` its token ends with.
pub fn surface_macro_name(c: SurfaceCtx, n: Option(CstNode)): Text {
  let written := surface_trim(c, surface_name_of(c, n))
  Text::slice_or_empty(written, 0, Text::len(written) - 1)
}

pub fn surface_last_ident(nodes: List(CstNode)): Option(CstNode) {
  surface_find_in(List::reverse(nodes), "Ident")
}

pub fn surface_is_space(c: SurfaceCtx, code: Nat): Bool {
  unicode_is_whitespace(c.classes, code)
}

pub fn surface_skip_space_in(k: Nat, c: SurfaceCtx, t: Text, at: Nat): Nat {
  match k: Nat {
    Zero => at
    Succ(j) => match text_decode(t, at): Nat {
      None => at
      Some(#(@code code, @len len)) => match surface_is_space(c, code): Nat {
        true => surface_skip_space_in(j, c, t, at + len)
        false => at
      }
    }
  }
}

pub fn surface_last_end_in(k: Nat, c: SurfaceCtx, t: Text, at: Nat, last: Nat): Nat {
  match k: Nat {
    Zero => last
    Succ(j) => match text_decode(t, at): Nat {
      None => last
      Some(#(@code code, @len len)) => match surface_is_space(c, code): Nat {
        true => surface_last_end_in(j, c, t, at + len, last)
        false => surface_last_end_in(j, c, t, at + len, at + len)
      }
    }
  }
}

pub fn surface_trim_from(c: SurfaceCtx, t: Text, r#from: Nat): Text {
  match r#from >= Text::len(t): Text {
    true => ""
    false => Text::slice_or_empty(t, r#from, surface_last_end_in(Text::len(t) + 1, c, t, r#from, r#from))
  }
}

pub fn surface_trim(c: SurfaceCtx, t: Text): Text {
  surface_trim_from(c, t, surface_skip_space_in(Text::len(t) + 1, c, t, 0))
}

pub fn surface_strip_in(k: Nat, c: SurfaceCtx, t: Text, at: Nat, done: List(Text)): List(Text) {
  match k: List(Text) {
    Zero => done
    Succ(j) => match text_decode(t, at): List(Text) {
      None => done
      Some(#(@code code, @len len)) => match surface_is_space(c, code): List(Text) {
        true => surface_strip_in(j, c, t, at + len, done)
        false => surface_strip_in(
          j,
          c,
          t,
          at + len,
          Cons(Text::slice_or_empty(t, at, at + len), done)
        )
      }
    }
  }
}

pub fn surface_strip(c: SurfaceCtx, t: Text): Text {
  Text::concat_all(List::reverse(surface_strip_in(Text::len(t) + 1, c, t, 0, Nil)))
}

pub fn surface_trim_marks_in(k: Nat, t: Text, at: Nat): Text {
  match k: Text {
    Zero => Text::slice_or_empty(t, at, Text::len(t))
    Succ(j) => match Text::byte_value(t, at) == 63 && at < Text::len(t): Text {
      true => surface_trim_marks_in(j, t, at + 1)
      false => Text::slice_or_empty(t, at, Text::len(t))
    }
  }
}

pub fn surface_trim_marks(t: Text): Text {
  surface_trim_marks_in(Text::len(t) + 1, t, 0)
}

pub fn surface_text_value(c: SurfaceCtx, n: CstNode): Text {
  surface_unquote(surface_trim(c, surface_text(c, n)))
}

// The nodes of kind `item` in `nodes`, through the tails of kinds `tail` and
// `tail2` (`Stmts: … [ Stmt StmtsTail ]` and the like).
pub fn surface_items_in(
  k: Nat,
  nodes: List(CstNode),
  item: Text,
  tail: Text,
  tail2: Text
): List(CstNode) {
  match k: List(CstNode) {
    Zero => Nil
    Succ(j) => match nodes: List(CstNode) {
      Nil => Nil
      Cons(n, rest) => match surface_is(n, item): List(CstNode) {
        true => Cons(n, surface_items_in(j, rest, item, tail, tail2))
        false => match surface_is(n, tail) || surface_is(n, tail2): List(CstNode) {
          true => List::append(
            surface_items_in(j, n.flat, item, tail, tail2),
            surface_items_in(j, rest, item, tail, tail2)
          )
          false => surface_items_in(j, rest, item, tail, tail2)
        }
      }
    }
  }
}

// Every node of the kind below `nodes`, not looking inside one found.
pub fn surface_descend_in(k: Nat, nodes: List(CstNode), name: Text): List(CstNode) {
  match k: List(CstNode) {
    Zero => Nil
    Succ(j) => match nodes: List(CstNode) {
      Nil => Nil
      Cons(n, rest) => match n.terminal: List(CstNode) {
        true => surface_descend_in(j, rest, name)
        false => match n.name == name: List(CstNode) {
          true => Cons(n, surface_descend_in(j, rest, name))
          false => List::append(
            surface_descend_in(j, n.flat, name),
            surface_descend_in(j, rest, name)
          )
        }
      }
    }
  }
}

pub fn surface_descend(c: SurfaceCtx, n: CstNode, name: Text): List(CstNode) {
  surface_descend_in(c.fuel, n.flat, name)
}

pub fn surface_match_arms(c: SurfaceCtx, arms: Option(CstNode)): List(CstNode) {
  match arms: List(CstNode) {
    Some(body) => surface_descend(c, body, "Arm")
    None => Nil
  }
}

pub fn surface_step_arm_nodes(c: SurfaceCtx, body: Option(CstNode)): List(CstNode) {
  match body: List(CstNode) {
    None => Nil
    Some(b) => surface_descend(c, b, "StepArm")
  }
}

pub fn surface_items(
  c: SurfaceCtx,
  nodes: List(CstNode),
  item: Text,
  tail: Text,
  tail2: Text
): List(CstNode) {
  surface_items_in(c.fuel, nodes, item, tail, tail2)
}

// The first node of the kind, searching the children first and then below each.
pub fn surface_find_deep(k: Nat, nodes: List(CstNode), name: Text): Option(CstNode) {
  match k: Option(CstNode) {
    Zero => None
    Succ(j) => match nodes: Option(CstNode) {
      Nil => None
      Cons(n, rest) => match surface_is(n, name): Option(CstNode) {
        true => Some(n)
        false => match surface_find_deep(j, n.flat, name): Option(CstNode) {
          Some(f) => Some(f)
          None => surface_find_deep(j, rest, name)
        }
      }
    }
  }
}

pub fn surface_except(kids: List(CstNode), name: Text): List(CstNode) {
  match kids: List(CstNode) {
    Nil => Nil
    Cons(n, rest) => match surface_is(n, name): List(CstNode) {
      true => surface_except(rest, name)
      false => Cons(n, surface_except(rest, name))
    }
  }
}

pub(open) inductive SurfaceLit: Type {
  Mk(name: Option(Text), body: Text): SurfaceLit
}

// Which spelling the literal has, by the first children down to one of
// them: 0 for `name`…``, 1 to 3 for `name<…`…`>`, 13 to 16 for the blocks.
pub fn surface_lit_kind(k: Nat, n: CstNode): Nat {
  match k: Nat {
    Zero => 0
    Succ(j) => match n.terminal: Nat {
      true => 0
      false => match n.name == "MacroText": Nat {
        true => 0
        false => match n.name == "MacroDelim1": Nat {
          true => 1
          false => match n.name == "MacroDelim2": Nat {
            true => 2
            false => match n.name == "MacroDelim3": Nat {
              true => 3
              false => match n.name == "MacroBlock3": Nat {
                true => 13
                false => match n.name == "MacroBlock4": Nat {
                  true => 14
                  false => match n.name == "MacroBlock5": Nat {
                    true => 15
                    false => match n.name == "MacroBlock6": Nat {
                      true => 16
                      false => match surface_nth(n.flat, 0): Nat {
                        Some(first) => surface_lit_kind(j, first)
                        None => 0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub fn surface_lit_name(t: Text, end: Nat): Option(Text) {
  match end: Option(Text) {
    Zero => None
    Succ(e) => Some(Text::slice_or_empty(t, 0, end))
  }
}

pub fn surface_find_or(t: Text, needle: Text, default: Nat): Nat {
  match text_find(t, needle, 0): Nat {
    Some(i) => i
    None => default
  }
}

pub fn surface_first_space_in(k: Nat, c: SurfaceCtx, t: Text, at: Nat): Nat {
  match k: Nat {
    Zero => at
    Succ(j) => match text_decode(t, at): Nat {
      None => at
      Some(#(@code code, @len len)) => match surface_is_space(c, code): Nat {
        true => at
        false => surface_first_space_in(j, c, t, at + len)
      }
    }
  }
}

pub fn surface_blank_tail_in(k: Nat, t: Text, at: Nat): Bool {
  match k: Bool {
    Zero => true
    Succ(j) => match at >= Text::len(t): Bool {
      true => true
      false => (
        Text::byte_value(t, at) == 32 || Text::byte_value(t, at) == 9
      ) && surface_blank_tail_in(j, t, at + 1)
    }
  }
}

pub fn surface_blank_tail(t: Text, at: Nat): Bool {
  surface_blank_tail_in(Text::len(t) + 1, t, at)
}

pub fn surface_last_newline(t: Text, at: Nat): Option(Nat) {
  match at: Option(Nat) {
    Zero => match Text::byte_value(t, 0) == 10 && 0 < Text::len(t): Option(Nat) {
      true => Some(0)
      false => None
    }
    Succ(below) => match Text::byte_value(t, at) == 10 && at < Text::len(t): Option(Nat) {
      true => Some(at)
      false => surface_last_newline(t, below)
    }
  }
}

pub fn surface_without_eol(t: Text, n: Nat): Nat {
  match n: Nat {
    Zero => 0
    Succ(m) => match Text::byte_value(t, m) == 10 || Text::byte_value(t, m) == 13: Nat {
      true => surface_without_eol(t, m)
      false => n
    }
  }
}

pub fn surface_lead_in(k: Nat, t: Text, at: Nat): Nat {
  match k: Nat {
    Zero => at
    Succ(j) => match at < Text::len(
      t
    ) && (Text::byte_value(t, at) == 32 || Text::byte_value(t, at) == 9): Nat {
      true => surface_lead_in(j, t, at + 1)
      false => at
    }
  }
}

// How much of a line's white space to take off: all of a blank line, else
// `indent` or as much as there is.
pub fn surface_take(c: SurfaceCtx, bare: Text, indent: Nat): Nat {
  match Text::len(surface_trim(c, bare)) == 0: Nat {
    true => Text::len(bare)
    false => Nat::min(indent, surface_lead_in(Text::len(bare) + 1, bare, 0))
  }
}

pub fn surface_dedent_line(c: SurfaceCtx, line: Text, indent: Nat): List(Text) {
  Cons(
    Text::slice_or_empty(
      line,
      surface_take(
        c,
        Text::slice_or_empty(line, 0, surface_without_eol(line, Text::len(line))),
        indent
      ),
      surface_without_eol(line, Text::len(line))
    ),
    Cons(Text::slice_or_empty(line, surface_without_eol(line, Text::len(line)), Text::len(line)), Nil)
  )
}

pub fn surface_line_end(body: Text, at: Nat): Nat {
  match text_find(body, text_newline(), at): Nat {
    Some(i) => i + 1
    None => Text::len(body)
  }
}

// The lines of `body` with `indent` bytes of white space taken off each; a
// line of white space only becomes an empty line. Last first.
pub fn surface_dedent_in(
  k: Nat,
  c: SurfaceCtx,
  body: Text,
  at: Nat,
  indent: Nat,
  done: List(Text)
): List(Text) {
  match k: List(Text) {
    Zero => done
    Succ(j) => match at < Text::len(body): List(Text) {
      true => surface_dedent_in(
        j,
        c,
        body,
        surface_line_end(body, at),
        indent,
        List::reverse_onto(
          surface_dedent_line(c, Text::slice_or_empty(body, at, surface_line_end(body, at)), indent),
          done
        )
      )
      false => done
    }
  }
}

pub fn surface_dedent(c: SurfaceCtx, body: Text, indent: Nat): Text {
  Text::concat_all(List::reverse(surface_dedent_in(Text::len(body) + 1, c, body, 0, indent, Nil)))
}

// The content of a block literal: its last line dropped when it is blank,
// and the indent of that line taken off every line.
pub fn surface_block_content(c: SurfaceCtx, content: Text): Text {
  match Text::len(content): Text {
    Zero => ""
    Succ(last) => match surface_last_newline(content, last): Text {
      Some(i) => match surface_blank_tail(content, i + 1): Text {
        true => surface_dedent(c, Text::slice_or_empty(content, 0, i + 1), Text::len(content) - i - 1)
        false => surface_dedent(c, content, 0)
      }
      None => match surface_blank_tail(content, 0): Text {
        true => ""
        false => surface_dedent(c, content, 0)
      }
    }
  }
}

pub fn surface_block_lit_at(
  c: SurfaceCtx,
  whole: Text,
  n: Nat,
  after: Text,
  line_end: Nat
): SurfaceLit {
  SurfaceLit {
    name: surface_lit_name(after, surface_first_space_in(Text::len(after) + 1, c, after, 0)),
    body: surface_block_content(
      c,
      Text::slice_or_empty(whole, line_end, Nat::max(Text::len(whole) - n, line_end))
    )
  }
}

pub fn surface_block_lit(c: SurfaceCtx, whole: Text, n: Nat): SurfaceLit {
  surface_block_lit_at(
    c,
    whole,
    n,
    Text::slice_or_empty(whole, Nat::min(n, Text::len(whole)), Text::len(whole)),
    surface_line_end(whole, 0)
  )
}

pub fn surface_lit_with(c: SurfaceCtx, whole: Text, kind: Nat): SurfaceLit {
  match kind == 0: SurfaceLit {
    true => SurfaceLit {
      name: surface_lit_name(whole, surface_find_or(whole, "`", 0)),
      body: Text::slice_or_empty(whole, surface_find_or(whole, "`", 0) + 1, Text::len(whole) - 1)
    }
    false => match kind < 10: SurfaceLit {
      true => SurfaceLit {
        name: surface_lit_name(whole, surface_find_or(whole, "<", 0)),
        body: Text::slice_or_empty(
          whole,
          surface_find_or(whole, "<", 0) + kind + 1,
          Text::len(whole) - (kind + 1)
        )
      }
      false => surface_block_lit(c, whole, kind - 10)
    }
  }
}

pub fn surface_lit(c: SurfaceCtx, n: CstNode): SurfaceLit {
  surface_lit_with(c, surface_text(c, n), surface_lit_kind(Text::len(c.source) + 1, n))
}

pub fn surface_out(name: Text): SurfaceTerm {
  SurfaceTerm { occurrence: None, kind: SkOther(name), start: 0, end: 0 }
}

pub fn surface_fn_kind(
  c: SurfaceCtx,
  kind: CstNode,
  ty: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  surface_term_at(SkFnKind(surface_trim(c, surface_text(c, kind)), ty), span)
}

pub fn surface_borrowed(borrow: CstNode, term: SurfaceTerm, span: SurfaceSpan): SurfaceTerm {
  surface_term_at(SkBorrow(surface_has(borrow.flat, "KwMut"), term), span)
}

pub fn surface_tagged(
  c: SurfaceCtx,
  prefix: CstNode,
  term: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  surface_term_at(SkTagged(surface_ident(c, prefix), term), span)
}





// The sign an ASCII escape stands for: `\times` is `\u{00d7}`.
pub fn surface_sign(op: Text): Text {
  match op == "\\times": Text {
    true => "\u{00d7}"
    false => match op == "\\land": Text {
      true => "\u{2227}"
      false => match op == "\\lor": Text {
        true => "\u{2228}"
        false => match op == "\\iff": Text {
          true => "\u{2194}"
          false => op
        }
      }
    }
  }
}




















pub fn surface_is_tuple(f: SurfaceTerm): Bool {
  match f.kind: Bool {
    SkVar(name) => name == "Tuple"
    _ => false
  }
}

pub fn surface_tuple_args(t: SurfaceTerm): List(SurfaceTerm) {
  match t.kind: List(SurfaceTerm) {
    SkApp(function, arguments) => match surface_is_tuple(function): List(SurfaceTerm) {
      true => arguments
      false => Cons(t, Nil)
    }
    _ => Cons(t, Nil)
  }
}

pub fn surface_param_of(ty: SurfaceTerm): SurfaceParam {
  SurfaceParam { name: None, ty: ty }
}


// `x: A` as a parameter: `A`, named `x`, which the later parameters and the
// result may use. `&x: A` is of type `A`, borrowed as `&x` is (mutably for
// `&mut x`), and the name is not kept.
pub fn surface_typed_param(name: SurfaceTerm, ty: SurfaceTerm): SurfaceParam {
  match name.kind: SurfaceParam {
    SkBorrow(mutable, x) => surface_param_of(
      surface_term_at(SkBorrow(mutable, ty), SurfaceSpan { start: ty.start, end: ty.end })
    )
    SkVar(written) => SurfaceParam { name: Some(written), ty: ty }
    _ => surface_param_of(ty)
  }
}

pub fn surface_idents(c: SurfaceCtx, nodes: List(CstNode)): List(Text) {
  match nodes: List(Text) {
    Nil => Nil
    Cons(n, rest) => Cons(surface_text(c, n), surface_idents(c, rest))
  }
}

// The names `∀ A, B.` binds before an operation.
pub fn surface_forall_names(c: SurfaceCtx, f: Option(CstNode)): List(Text) {
  match f: List(Text) {
    Some(n) => surface_idents(c, surface_all(n, "Ident"))
    None => Nil
  }
}

pub fn surface_join(items: List(Text), sep: Text): Text {
  match items: Text {
    Nil => ""
    Cons(x, rest) => match rest: Text {
      Nil => x
      Cons(y, more) => Text::concat_all(Cons(x, Cons(sep, Cons(surface_join(rest, sep), Nil))))
    }
  }
}

// An entry as written: `res`, `res(Pos)` with the arguments' text, and
// `∀ A. res(A)` with `∀ `, the names and `. ` first.
pub fn surface_effect_entry(c: SurfaceCtx, n: CstNode, name: Text): Text {
  let entry := match surface_first(n, "TypeCall"): Text {
    Some(args) => Text::concat(name, surface_text(c, args))
    None => name
  }
  match surface_first(n, "EffectForall"): Text {
    Some(f) => Text::concat_all(
      Cons(
        "∀ ",
        Cons(surface_join(surface_forall_names(c, Some(f)), ", "), Cons(". ", Cons(entry, Nil)))
      )
    )
    None => entry
  }
}

// What an attribute's list makes, each as `kind name`; the word written
// before the first (`=> replace fn f, …`) goes before it.
pub fn surface_attr_generates(c: SurfaceCtx, list: Option(CstNode)): List(Text) {
  match list: List(Text) {
    None => Nil
    Some(l) => match surface_generated(c, surface_all(l, "Generated")): List(Text) {
      Nil => Nil
      Cons(first, rest) => match surface_first(l, "Ident"): List(Text) {
        None => Cons(first, rest)
        Some(word) => Cons(
          Text::concat_all(Cons(surface_text(c, word), Cons(" ", Cons(first, Nil)))),
          rest
        )
      }
    }
  }
}

pub fn surface_generated(c: SurfaceCtx, nodes: List(CstNode)): List(Text) {
  match nodes: List(Text) {
    Nil => Nil
    Cons(g, rest) => match surface_first(g, "GeneratedKind"): List(Text) {
      None => surface_generated(c, rest)
      Some(kind) => match surface_first(g, "Ident"): List(Text) {
        None => surface_generated(c, rest)
        Some(i) => Cons(
          Text::concat_all(Cons(surface_text(c, kind), Cons(" ", Cons(surface_text(c, i), Nil)))),
          surface_generated(c, rest)
        )
      }
    }
  }
}

pub fn surface_effect_names(c: SurfaceCtx, nodes: List(CstNode)): List(Text) {
  match nodes: List(Text) {
    Nil => Nil
    Cons(n, rest) => match surface_first(n, "Ident"): List(Text) {
      Some(i) => Cons(surface_effect_entry(c, n, surface_text(c, i)), surface_effect_names(c, rest))
      None => surface_effect_names(c, rest)
    }
  }
}

pub fn surface_text_in(x: Text, xs: List(Text)): Bool {
  match xs: Bool {
    Nil => false
    Cons(y, rest) => match x == y: Bool {
      true => true
      false => surface_text_in(x, rest)
    }
  }
}

// `seen`, then the names of `new` it does not have yet, in order.
pub fn surface_append_new(seen: List(Text), new: List(Text)): List(Text) {
  match new: List(Text) {
    Nil => seen
    Cons(x, rest) => match surface_text_in(x, seen): List(Text) {
      true => surface_append_new(seen, rest)
      false => surface_append_new(List::append(seen, Cons(x, Nil)), rest)
    }
  }
}

// The effects of the set literals `{A, B}` of a row's terms, each once.
pub fn surface_row_lits(c: SurfaceCtx, terms: List(CstNode)): List(Text) {
  match terms: List(Text) {
    Nil => Nil
    Cons(t, rest) => match surface_first(t, "EffectLit"): List(Text) {
      Some(lit) => surface_append_new(
        surface_effect_names(c, surface_all(lit, "EffectName")),
        surface_row_lits(c, rest)
      )
      None => surface_row_lits(c, rest)
    }
  }
}

// The row variables of a row's terms, each `e` as `|e`.
pub fn surface_row_vars(c: SurfaceCtx, terms: List(CstNode)): List(Text) {
  match terms: List(Text) {
    Nil => Nil
    Cons(t, rest) => match surface_first(t, "EffectLit"): List(Text) {
      Some(lit) => surface_row_vars(c, rest)
      None => match surface_first(t, "Ident"): List(Text) {
        Some(v) => Cons(Text::concat("|", surface_text(c, v)), surface_row_vars(c, rest))
        None => surface_row_vars(c, rest)
      }
    }
  }
}

// The names in an effect row, a set expression of literals `{A, B}` and row variables united by
// `∪`; a row variable `e` is `|e`. The names of an `effect` declaration's set are its names.
pub fn surface_row_names(c: SurfaceCtx, row: CstNode): List(Text) {
  match surface_is(row, "EffectAlias"): List(Text) {
    true => surface_effect_names(c, surface_all(row, "EffectName"))
    false => match surface_first(row, "EffectSet"): List(Text) {
      Some(set) => List::append(
        surface_row_lits(c, surface_all(set, "EffectTerm")),
        surface_row_vars(c, surface_all(set, "EffectTerm"))
      )
      None => Nil
    }
  }
}

// Whether a `budget` names `steps` and `memory` at most once each, nothing
// else, and has a count for each name.
fn surface_budget_ok(names: List(Text), counts: Nat, steps: Bool, memory: Bool): Bool {
  match names: Bool {
    Nil => counts == 0 && (steps || memory)
    Cons(name, rest) => match counts: Bool {
      Zero => false
      Succ(more) => match name == "steps": Bool {
        true => not(steps) && surface_budget_ok(rest, more, true, memory)
        false => name == "memory" && not(memory) && surface_budget_ok(rest, more, steps, true)
      }
    }
  }
}

// A kind (`copy`, `affine`, …) or `inductive` before `struct` or `enum`, under its `DataKind`;
// the word before an extern `type` is not read, as in the Rust reader.
pub fn surface_data_kind(c: SurfaceCtx, decl: CstNode): Option(Text) {
  match surface_first(decl, "DataKind"): Option(Text) {
    Some(k) => surface_data_kind_word(c, k)
    None => None
  }
}

fn surface_data_kind_word(c: SurfaceCtx, decl: CstNode): Option(Text) {
  match surface_first(decl, "Kind"): Option(Text) {
    Some(k) => Some(surface_trim(c, surface_text(c, k)))
    None => match surface_first(decl, "KwInductive"): Option(Text) {
      Some(k) => Some(surface_trim(c, surface_text(c, k)))
      None => None
    }
  }
}


// `affine type Regex` in an `extern` block: a struct with one constructor
// and no fields.
fn surface_extern_types(c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceStmt) {
  match nodes: List(SurfaceStmt) {
    Nil => Nil
    Cons(t, rest) => Cons(
      StStruct(
        SurfaceData {
          kind: surface_data_kind(c, t),
          name: surface_ident(c, t),
          generics: Nil,
          constructors: Cons(SurfaceDataCtor { name: surface_ident(c, t), fields: Nil }, Nil),
          start: surface_span(c, t).start,
          end: surface_span(c, t).end
        }
      ),
      surface_extern_types(c, rest)
    )
  }
}

pub fn surface_opt_row_names(c: SurfaceCtx, row: Option(CstNode)): Option(List(Text)) {
  match row: Option(List(Text)) {
    Some(r) => Some(surface_row_names(c, r))
    None => None
  }
}


pub fn surface_expr_parts(kids: List(CstNode)): List(CstNode) {
  match kids: List(CstNode) {
    Nil => Nil
    Cons(n, rest) => match not(
      n.terminal
    ) && n.name != "Gap" && n.name != "FatArrow" && n.name != "ThinArrow": List(CstNode) {
      true => Cons(n, surface_expr_parts(rest))
      false => surface_expr_parts(rest)
    }
  }
}

pub(open) inductive SurfaceLamParam: Type {
  Mk(name: Text, borrow: Option(Bool)): SurfaceLamParam
}

// A parameter is a name, or a borrowed name `&x` / `&mut x`.
pub fn surface_lam_param_of(t: SurfaceTerm): Option(SurfaceLamParam) {
  match t.kind: Option(SurfaceLamParam) {
    SkVar(name) => Some(SurfaceLamParam { name: name, borrow: None })
    SkBorrow(mutable, inner) => match inner.kind: Option(SurfaceLamParam) {
      SkVar(name) => Some(SurfaceLamParam { name: name, borrow: Some(mutable) })
      _ => None
    }
    _ => None
  }
}

pub fn surface_params(args: List(SurfaceTerm)): Option(List(SurfaceLamParam)) {
  match args: Option(List(SurfaceLamParam)) {
    Nil => Some(Nil)
    Cons(a, rest) => match surface_lam_param_of(a): Option(List(SurfaceLamParam)) {
      None => None
      Some(p) => match surface_params(rest): Option(List(SurfaceLamParam)) {
        None => None
        Some(ps) => Some(Cons(p, ps))
      }
    }
  }
}

pub fn surface_param_names(ps: List(SurfaceLamParam)): List(Text) {
  match ps: List(Text) {
    Nil => Nil
    Cons(p, rest) => Cons(p.name, surface_param_names(rest))
  }
}

pub fn surface_param_borrows(ps: List(SurfaceLamParam)): List(Option(Bool)) {
  match ps: List(Option(Bool)) {
    Nil => Nil
    Cons(p, rest) => Cons(p.borrow, surface_param_borrows(rest))
  }
}

pub fn surface_no_borrows(bs: List(Option(Bool))): Bool {
  match bs: Bool {
    Nil => true
    Cons(b, rest) => match b: Bool {
      None => surface_no_borrows(rest)
      Some(x) => false
    }
  }
}

// `params => body`, as a lambda that borrows when a parameter does.
pub fn surface_lambda_of(
  ps: List(SurfaceLamParam),
  body: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  match surface_no_borrows(surface_param_borrows(ps)): SurfaceTerm {
    true => surface_term_at(SkLam(surface_param_names(ps), body), span)
    false => surface_term_at(
      SkBorrowLam(
        surface_param_borrows(ps),
        surface_term_at(SkLam(surface_param_names(ps), body), span)
      ),
      span
    )
  }
}








pub fn surface_only_names(kids: List(CstNode)): Bool {
  match kids: Bool {
    Nil => true
    Cons(n, rest) => (surface_is(n, "Ident") || surface_is(n, "PathSep")) && surface_only_names(
      rest
    )
  }
}

pub fn surface_path_parts(c: SurfaceCtx, kids: List(CstNode)): List(Text) {
  match kids: List(Text) {
    Nil => Nil
    Cons(n, rest) => match surface_is(n, "Ident") || surface_is(n, "PathSep"): List(Text) {
      true => Cons(surface_trim(c, surface_text(c, n)), surface_path_parts(c, rest))
      false => surface_path_parts(c, rest)
    }
  }
}

pub fn surface_number(c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
  match surface_one(n.flat): SurfaceTerm {
    Some(only) => match surface_is(only, "Integer"): SurfaceTerm {
      true => surface_term_at(SkNat(surface_text(c, n)), span)
      false => match surface_is(only, "Float") || surface_is(only, "Decimal"): SurfaceTerm {
        true => surface_term_at(SkFloat(surface_text(c, n)), span)
        false => surface_other(c, n)
      }
    }
    None => surface_other(c, n)
  }
}

// A tuple of the items, or the one item without a comma.
pub fn surface_paren_of(items: List(SurfaceTerm), has_comma: Bool, span: SurfaceSpan): SurfaceTerm {
  match items: SurfaceTerm {
    Cons(only, rest) => match rest: SurfaceTerm {
      Nil => match has_comma: SurfaceTerm {
        true => surface_app("Tuple", items, span)
        false => only
      }
      Cons(x, y) => surface_app("Tuple", items, span)
    }
    Nil => surface_app("Tuple", items, span)
  }
}

// `[a, b]`: `Cons(a, Cons(b, Nil))`, as a tuple is `Tuple(…)`. Each cell
// spans from its item to the `]`.
pub fn surface_list_of(items: List(SurfaceTerm), span: SurfaceSpan): SurfaceTerm {
  match items: SurfaceTerm {
    Nil => surface_var("Nil", span)
    Cons(item, rest) => surface_app(
      "Cons",
      Cons(item, Cons(surface_list_of(rest, span), Nil)),
      SurfaceSpan { start: item.start, end: span.end }
    )
  }
}

pub fn surface_stmt_value(s: SurfaceStmt): Option(SurfaceTerm) {
  match s: Option(SurfaceTerm) {
    StExpr(e) => Some(e)
    _ => None
  }
}

// A block holding one expression is that expression.
pub fn surface_block_of(read: List(SurfaceStmt), span: SurfaceSpan): SurfaceTerm {
  match read: SurfaceTerm {
    Cons(only, rest) => match rest: SurfaceTerm {
      Nil => match surface_stmt_value(only): SurfaceTerm {
        Some(e) => e
        None => surface_term_at(SkBlock(read), span)
      }
      Cons(x, y) => surface_term_at(SkBlock(read), span)
    }
    Nil => surface_term_at(SkBlock(read), span)
  }
}

pub fn surface_syntax_lit_term(c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
  surface_term_at(SkSyntaxLit(surface_lit(c, n).name, surface_lit(c, n).body), span)
}

// The kinds of statement, as `surface_stmt_of` tells them apart.
// The declaration in a `mutual` item, after its `pub`.
fn surface_mutual_decl(item: CstNode): Option(CstNode) {
  match surface_first(item, "MutualMember"): Option(CstNode) {
    Some(m) => surface_nth(m.flat, 0)
    None => match surface_nth(item.flat, 0): Option(CstNode) {
      Some(d) => match surface_is(d, "Visibility"): Option(CstNode) {
        true => surface_nth(item.flat, 1)
        false => Some(d)
      }
      None => None
    }
  }
}

// A statement with the `pub` or `pub(open)` written before it: a declaration
// starts at its `pub`, so that what is cut out of the text with it takes the
// word along; a statement that declares no name another file could see takes
// no `pub` and is read as an error there.
fn surface_visible(c: SurfaceCtx, vis: Option(CstNode), stmt: SurfaceStmt): SurfaceStmt {
  match vis: SurfaceStmt {
    None => stmt
    Some(v) => surface_visible_from(
      surface_span(c, v),
      match surface_has(v.flat, "KwPubOpen"): Text {
        true => "pub(open) "
        false => "pub "
      },
      stmt
    )
  }
}

fn surface_visible_from(at: SurfaceSpan, word: Text, stmt: SurfaceStmt): SurfaceStmt {
  match stmt: SurfaceStmt {
    StFn(
      SurfaceFnMk(
        name,
        generics,
        bounds,
        params,
        borrows,
        ParamTypes,
        result,
        effects,
        Wheres,
        start,
        end,
        body
      )
    ) => StFn(
      SurfaceFnMk(
        name,
        generics,
        bounds,
        params,
        borrows,
        ParamTypes,
        result,
        effects,
        Wheres,
        Nat::min(at.start, start),
        end,
        body
      )
    )
    StTheorem(SurfaceTheoremMk(name, Implicit, params, ty, body, start, end)) => StTheorem(
      SurfaceTheoremMk(name, Implicit, params, ty, body, Nat::min(at.start, start), end)
    )
    StDef(SurfaceTheoremMk(name, Implicit, params, ty, body, start, end)) => StDef(
      SurfaceTheoremMk(name, Implicit, params, ty, body, Nat::min(at.start, start), end)
    )
    StInductive(SurfaceInductiveMk(name, params, Sort, constructors, start, end)) => StInductive(
      SurfaceInductiveMk(name, params, Sort, constructors, Nat::min(at.start, start), end)
    )
    StStruct(SurfaceDataMk(kind, name, generics, constructors, start, end)) => StStruct(
      SurfaceDataMk(kind, name, generics, constructors, Nat::min(at.start, start), end)
    )
    StEnum(SurfaceDataMk(kind, name, generics, constructors, start, end)) => StEnum(
      SurfaceDataMk(kind, name, generics, constructors, Nat::min(at.start, start), end)
    )
    StEffect(SurfaceEffectMk(name, generics, params, result, r#resume, start, end, set)) => StEffect(
      SurfaceEffectMk(name, generics, params, result, r#resume, Nat::min(at.start, start), end, set)
    )
    StClass(SurfaceClassMk(name, Param, arity, bound, Methods, Laws, start, end)) => StClass(
      SurfaceClassMk(name, Param, arity, bound, Methods, Laws, Nat::min(at.start, start), end)
    )
    StAttributed(name, arg, Generates, inner) => match surface_visible_from(
      at,
      word,
      inner
    ): SurfaceStmt {
      StOther(what, s, e) => StOther(
        Text::concat(word, "before a statement that declares nothing"),
        at.start,
        at.end
      )
      _ => stmt
    }
    _ => StOther(Text::concat(word, "before a statement that declares nothing"), at.start, at.end)
  }
}
pub fn surface_named_names(xs: List(SurfaceNamed)): List(Text) {
  match xs: List(Text) {
    Nil => Nil
    Cons(x, rest) => Cons(x.name, surface_named_names(rest))
  }
}

pub fn surface_param_idents(c: SurfaceCtx, params: List(CstNode)): List(Text) {
  match params: List(Text) {
    Nil => Nil
    Cons(p, rest) => match surface_first(p, "Ident"): List(Text) {
      Some(i) => Cons(surface_text(c, i), surface_param_idents(c, rest))
      None => surface_param_idents(c, rest)
    }
  }
}

pub fn surface_borrow_flag(found: Option(CstNode)): Option(Bool) {
  match found: Option(Bool) {
    Some(b) => Some(surface_has(b.flat, "KwMut"))
    None => None
  }
}

pub fn surface_param_borrow_flags(params: List(CstNode)): List(Option(Bool)) {
  match params: List(Option(Bool)) {
    Nil => Nil
    Cons(p, rest) => Cons(
      surface_borrow_flag(surface_first(p, "Borrow")),
      surface_param_borrow_flags(rest)
    )
  }
}

pub(open) inductive SurfaceBounds: Type {
  Mk(names: List(Text), bounds: List(Option(Text))): SurfaceBounds
}

// `Type` or `Type(u)` alone is affine, as an unwritten bound is.
pub fn surface_sort_alone(t: Text): Bool {
  t == "Type" || Text::slice_or_empty(t, 0, 5) == "Type("
}

// The checker's bound word for a universe name: `Shared` is `shared`, `Type` is `affine`.
pub fn surface_kind_word(t: Text): Option(Text) {
  match t == "Copy": Option(Text) {
    true => Some("copy")
    false => match t == "Shared": Option(Text) {
      true => Some("shared")
      false => match t == "Linear": Option(Text) {
        true => Some("linear")
        false => match t == "Type": Option(Text) {
          true => Some("affine")
          false => None
        }
      }
    }
  }
}

// A kind as the checker's bound string, the whitespace dropped: `Shared` is `shared`,
// `(Shared) -> Shared` is `(shared)->shared`; any other bound is kept as written.
pub fn surface_kind_bound(s: Text): Text {
  match surface_kind_word(s): Text {
    Some(w) => w
    None => match Text::slice_or_empty(s, 0, 1) == "(": Text {
      false => s
      true => match text_find(s, ")->", 0): Text {
        None => s
        Some(i) => match surface_kind_word(Text::slice_or_empty(s, 1, i)): Text {
          None => s
          Some(a) => match surface_kind_word(Text::slice_or_empty(s, i + 3, Text::len(s))): Text {
            None => s
            Some(r) => Text::concat_all(Cons("(", Cons(a, Cons(")->", Cons(r, Nil)))))
          }
        }
      }
    }
  }
}

// The kernel's reading of a kind, whose universe names are all `Type`: `Shared` is `Type`,
// `(Shared) -> Shared` is `(Type) -> Type`; any other written type is none.
pub fn surface_kind_term(c: SurfaceCtx, n: CstNode, s: Text): Option(SurfaceTerm) {
  match surface_kind_word(s): Option(SurfaceTerm) {
    Some(w) => Some(surface_var("Type", surface_span(c, n)))
    None => match surface_kind_bound(s) == s: Option(SurfaceTerm) {
      true => None
      false => Some(
        surface_term_at(
          SkPi(
            Cons(SurfaceParam { name: None, ty: surface_var("Type", surface_span(c, n)) }, Nil),
            surface_var("Type", surface_span(c, n)),
            None
          ),
          surface_span(c, n)
        )
      )
    }
  }
}

// A row variable's bound is written after its `!`: `<=1`, `direct`. A type
// parameter of kind `Type` has none.
pub fn surface_bound(c: SurfaceCtx, g: CstNode): Option(Text) {
  match surface_first(g, "RowBound"): Option(Text) {
    Some(b) => Some(surface_strip(c, surface_text(c, b)))
    None => match surface_first(g, "GenericKind"): Option(Text) {
      Some(k) => match surface_sort_alone(surface_strip(c, surface_text(c, k))): Option(Text) {
        true => None
        false => Some(surface_kind_bound(surface_strip(c, surface_text(c, k))))
      }
      None => None
    }
  }
}

pub fn surface_bounds_of(c: SurfaceCtx, nodes: List(CstNode)): SurfaceBounds {
  match nodes: SurfaceBounds {
    Nil => SurfaceBounds { names: Nil, bounds: Nil }
    Cons(g, rest) => SurfaceBounds {
      names: Cons(surface_ident(c, g), surface_bounds_of(c, rest).names),
      bounds: Cons(surface_bound(c, g), surface_bounds_of(c, rest).bounds)
    }
  }
}

// The node of a declaration's generics: `<A>` of a function, theorem or
// operation, or `(A: Type)` of a type declaration.
pub fn surface_generic_node(node: CstNode): Option(CstNode) {
  match surface_first(node, "Generics"): Option(CstNode) {
    Some(g) => Some(g)
    None => surface_first(node, "TypeParams")
  }
}

pub fn surface_generic_items(generics: CstNode): List(CstNode) {
  List::append(surface_all(generics, "Generic"), surface_all(generics, "TypeParam"))
}

pub fn surface_generic_bounds(c: SurfaceCtx, node: CstNode): SurfaceBounds {
  match surface_generic_node(node): SurfaceBounds {
    None => SurfaceBounds { names: Nil, bounds: Nil }
    Some(generics) => surface_bounds_of(c, surface_generic_items(generics))
  }
}

pub fn surface_head_or_empty(names: List(Text)): Text {
  match names: Text {
    Nil => ""
    Cons(n, rest) => n
  }
}

pub fn surface_first_bound(bounds: List(Option(Text))): Option(Text) {
  match bounds: Option(Text) {
    Nil => None
    Cons(b, rest) => b
  }
}

pub fn surface_laws(c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceLaw) {
  match nodes: List(SurfaceLaw) {
    Nil => Nil
    Cons(n, rest) => Cons(
      SurfaceLaw {
        name: surface_ident(c, n),
        start: surface_span(c, n).start,
        end: surface_span(c, n).end
      },
      surface_laws(c, rest)
    )
  }
}

// Whether a statement is `macro fn m(…) … { … }`: the function `m` and the registration of `m` as a macro.
pub fn surface_is_macro_fn(n: CstNode): Bool {
  match surface_first(n, "Attribute"): Bool {
    Some(attr) => false
    None => match surface_first(n, "OtherStmt"): Bool {
      None => false
      Some(other) => match surface_nth(other.flat, 0): Bool {
        None => false
        Some(inner) => surface_is(inner, "MacroFnDecl")
      }
    }
  }
}

pub fn surface_digits_in(k: Nat, t: Text, at: Nat, acc: Nat, limit: Nat): Option(Nat) {
  match k: Option(Nat) {
    Zero => Some(acc)
    Succ(j) => match at >= Text::len(t): Option(Nat) {
      true => Some(acc)
      false => match text_digit(Text::byte_value(t, at)): Option(Nat) {
        None => None
        Some(d) => match acc * 10 + d > limit: Option(Nat) {
          true => None
          false => surface_digits_in(j, t, at + 1, acc * 10 + d, limit)
        }
      }
    }
  }
}

// The largest magnitude of an `i64` with the sign `t` starts with.
pub fn surface_int_limit(t: Text): Nat {
  match Text::byte_value(t, 0) == 45: Nat {
    true => 9223372036854775807 + 1
    false => 9223372036854775807
  }
}

// `str::parse::<i64>`: a sign, then digits, as the sign and the magnitude.
pub fn surface_parse_int(t: Text): Option(Pair(Bool, Nat)) {
  match Text::len(t) == 0: Option(Pair(Bool, Nat)) {
    true => None
    false => match Text::byte_value(
      t,
      0
    ) == 45 || Text::byte_value(t, 0) == 43: Option(Pair(Bool, Nat)) {
      true => match Text::len(t) == 1: Option(Pair(Bool, Nat)) {
        true => None
        false => match surface_digits_in(
          Text::len(t),
          t,
          1,
          0,
          surface_int_limit(t)
        ): Option(Pair(Bool, Nat)) {
          Some(m) => Some(Pair { fst: Text::byte_value(t, 0) == 45, snd: m })
          None => None
        }
      }
      false => match surface_digits_in(
        Text::len(t) + 1,
        t,
        0,
        0,
        9223372036854775807
      ): Option(Pair(Bool, Nat)) {
        Some(m) => Some(Pair { fst: false, snd: m })
        None => None
      }
    }
  }
}

pub fn surface_literal_pattern(c: SurfaceCtx, lit: CstNode): SurfacePattern {
  match surface_has(lit.flat, "True"): SurfacePattern {
    true => PtBool(true)
    false => match surface_has(lit.flat, "False"): SurfacePattern {
      true => PtBool(false)
      false => match surface_has(lit.flat, "Text"): SurfacePattern {
        true => PtText(surface_unquote(surface_trim(c, surface_text(c, lit))))
        false => match surface_parse_int(
          text_join(text_split(surface_trim(c, surface_text(c, lit)), " "), "")
        ): SurfacePattern {
          Some(n) => PtInt(n.fst, n.snd)
          None => PtOther("number pattern")
        }
      }
    }
  }
}

pub(open) inductive SurfaceRule: Type {
  RuleType: SurfaceRule
  RuleAngle: SurfaceRule
  RuleRow: SurfaceRule
  RuleExpr: SurfaceRule
  RulePostfix: SurfaceRule
  RulePrimary: SurfaceRule
  RulePathExpr: SurfaceRule
  RuleNumber: SurfaceRule
  RuleHoleExpr: SurfaceRule
  RuleText: SurfaceRule
  RuleTrue: SurfaceRule
  RuleFalse: SurfaceRule
  RuleParen: SurfaceRule
  RuleListLit: SurfaceRule
  RuleBrace: SurfaceRule
  RuleArmBody: SurfaceRule
  RuleStepExpr: SurfaceRule
  RuleBlock: SurfaceRule
  RuleIfExpr: SurfaceRule
  RulePerformExpr: SurfaceRule
  RuleHandleExpr: SurfaceRule
  RuleBudgetExpr: SurfaceRule
  RuleMatchExpr: SurfaceRule
  RuleSyntaxLit: SurfaceRule
  RuleMacroCall: SurfaceRule
  RuleQuoteExpr: SurfaceRule
  RuleSpliceExpr: SurfaceRule
  RuleItem: SurfaceRule
  RuleLetDecl: SurfaceRule
  RuleVarDecl: SurfaceRule
  RuleModuleDecl: SurfaceRule
  RuleFnDecl: SurfaceRule
  RuleTheoremDecl: SurfaceRule
  RuleAxiomDecl: SurfaceRule
  RuleDefDecl: SurfaceRule
  RuleMutualDecl: SurfaceRule
  RuleImportDecl: SurfaceRule
  RuleSyntaxDecl: SurfaceRule
  RuleMacroFnDecl: SurfaceRule
  RuleInductiveDecl: SurfaceRule
  RuleEffectDecl: SurfaceRule
  RuleStructDecl: SurfaceRule
  RuleEnumDecl: SurfaceRule
  RuleExternDecl: SurfaceRule
  RuleClassDecl: SurfaceRule
  RuleInstanceDecl: SurfaceRule
  RuleWhileStmt: SurfaceRule
  RuleReturnStmt: SurfaceRule
  RuleExprStmt: SurfaceRule
  RuleNone: SurfaceRule
}

pub fn surface_is_level(n: CstNode): Bool {
  match n.terminal: Bool {
    true => false
    false => n.name == "Type" || n.name == "BodyType" || n.name == "Seq" || n.name == "Cond" || n.name == "Operand" || n.name == "CondOperand" || n.name == "Postfix" || n.name == "CondPostfix" || n.name == "Primary" || n.name == "CondPrimary" || n.name == "Brace" || n.name == "ArmBody"
  }
}

pub fn surface_rule_plain(name: Text): SurfaceRule {
  match name == "Type" || name == "BodyType" || name == "Seq" || name == "Cond" || name == "Operand" || name == "CondOperand": SurfaceRule {
    true => RuleType
    false => match name == "Expr": SurfaceRule {
      true => RuleExpr
      false => match name == "Postfix" || name == "CondPostfix": SurfaceRule {
        true => RulePostfix
        false => match name == "Primary" || name == "CondPrimary": SurfaceRule {
          true => RulePrimary
          false => match name == "PathExpr" || name == "CondPath": SurfaceRule {
            true => RulePathExpr
            false => match name == "Number": SurfaceRule {
              true => RuleNumber
              false => match name == "HoleExpr": SurfaceRule {
                true => RuleHoleExpr
                false => match name == "Text": SurfaceRule {
                  true => RuleText
                  false => match name == "True": SurfaceRule {
                    true => RuleTrue
                    false => match name == "False": SurfaceRule {
                      true => RuleFalse
                      false => match name == "Paren": SurfaceRule {
                        true => RuleParen
                        false => match name == "Brace": SurfaceRule {
                          true => RuleBrace
                          false => match name == "Block": SurfaceRule {
                            true => RuleBlock
                            false => match name == "IfExpr": SurfaceRule {
                              true => RuleIfExpr
                              false => match name == "PerformExpr": SurfaceRule {
                                true => RulePerformExpr
                                false => match name == "HandleExpr": SurfaceRule {
                                  true => RuleHandleExpr
                                  false => match name == "BudgetExpr": SurfaceRule {
                                    true => RuleBudgetExpr
                                    false => match name == "MatchExpr": SurfaceRule {
                                      true => RuleMatchExpr
                                      false => match name == "SyntaxLit": SurfaceRule {
                                        true => RuleSyntaxLit
                                        false => match name == "MacroCall": SurfaceRule {
                                          true => RuleMacroCall
                                          false => match name == "QuoteExpr": SurfaceRule {
                                            true => RuleQuoteExpr
                                            false => match name == "SpliceExpr": SurfaceRule {
                                              true => RuleSpliceExpr
                                              false => match name == "Item": SurfaceRule {
                                                true => RuleItem
                                                false => match name == "LetDecl": SurfaceRule {
                                                  true => RuleLetDecl
                                                  false => match name == "VarDecl": SurfaceRule {
                                                    true => RuleVarDecl
                                                    false => match name == "ModuleDecl": SurfaceRule {
                                                      true => RuleModuleDecl
                                                      false => match name == "FnDecl": SurfaceRule {
                                                        true => RuleFnDecl
                                                        false => match name == "TheoremDecl": SurfaceRule {
                                                          true => RuleTheoremDecl
                                                          false => match name == "AxiomDecl": SurfaceRule {
                                                            true => RuleAxiomDecl
                                                            false => match name == "DefDecl": SurfaceRule {
                                                              true => RuleDefDecl
                                                              false => match name == "MutualDecl": SurfaceRule {
                                                                true => RuleMutualDecl
                                                                false => match name == "ImportDecl": SurfaceRule {
                                                                  true => RuleImportDecl
                                                                  false => match name == "SyntaxDecl": SurfaceRule {
                                                                    true => RuleSyntaxDecl
                                                                    false => match name == "MacroFnDecl": SurfaceRule {
                                                                      true => RuleMacroFnDecl
                                                                      false => match name == "InductiveDecl": SurfaceRule {
                                                                        true => RuleInductiveDecl
                                                                        false => match name == "EffectDecl": SurfaceRule {
                                                                          true => RuleEffectDecl
                                                                          false => match name == "StructDecl": SurfaceRule {
                                                                            true => RuleStructDecl
                                                                            false => match name == "EnumDecl": SurfaceRule {
                                                                              true => RuleEnumDecl
                                                                              false => match name == "ExternDecl": SurfaceRule {
                                                                                true => RuleExternDecl
                                                                                false => match name == "WhileStmt": SurfaceRule {
                                                                                  true => RuleWhileStmt
                                                                                  false => match name == "ReturnStmt": SurfaceRule {
                                                                                    true => RuleReturnStmt
                                                                                    false => match name == "ExprStmt": SurfaceRule {
                                                                                      true => RuleExprStmt
                                                                                      false => match name == "ListLit": SurfaceRule {
                                                                                        true => RuleListLit
                                                                                        false => match name == "AngleType" || name == "GenericKind": SurfaceRule {
                                                                                          true => RuleAngle
                                                                                          false => match name == "EffectRow": SurfaceRule {
                                                                                            true => RuleRow
                                                                                            false => RuleNone
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub fn surface_rule_special(name: Text): SurfaceRule {
  match name == "ArmBody": SurfaceRule {
    true => RuleArmBody
    false => match name == "ClassDecl": SurfaceRule {
      true => RuleClassDecl
      false => match name == "InstanceDecl": SurfaceRule {
        true => RuleInstanceDecl
        false => match name == "StepExpr": SurfaceRule {
          true => RuleStepExpr
          false => surface_rule_plain(name)
        }
      }
    }
  }
}
pub fn surface_rule(name: Text): SurfaceRule {
  surface_rule_special(name)
}

// ---- the readers ------------------------------------------------------------------
//
// `Reader::term` and what it calls in `crates/tauto-surface/src/surface.rs` and
// `crates/tauto-surface/src/surface/program.rs`. Each function is the one of the same name there; they
// call each other, so they share the steps `k`, one taken by each call.

pub(open) inductive SurfaceReturn: Type {
  SurfaceReturnMk(term: SurfaceTerm, effects: Option(List(Text))): SurfaceReturn
}

pub fn surface_out_stmt(name: Text): SurfaceStmt {
  StOther(name, 0, 0)
}

pub fn surface_out_fn(): SurfaceFn {
  SurfaceFn {
    name: "",
    generics: Nil,
    bounds: Nil,
    params: Nil,
    borrows: Nil,
    param_types: Nil,
    result: None,
    effects: None,
    wheres: Nil,
    start: 0,
    end: 0,
    body: surface_out("fuel")
  }
}

pub fn surface_out_theorem(): SurfaceTheorem {
  SurfaceTheorem {
    name: "",
    implicit: 0,
    params: Nil,
    ty: surface_out("fuel"),
    body: None,
    start: 0,
    end: 0
  }
}

pub fn surface_out_data(): SurfaceData {
  SurfaceData { kind: None, name: "", generics: Nil, constructors: Nil, start: 0, end: 0 }
}

pub fn surface_assign(target: SurfaceTerm, value: SurfaceTerm, span: SurfaceSpan): SurfaceStmt {
  match target.kind: SurfaceStmt {
    SkVar(name) => StAssign(name, None, value)
    _ => match surface_place_root(target): SurfaceStmt {
      Some(name) => StAssign(name, Some(target), value)
      None => StOther("assignment target", span.start, span.end)
    }
  }
}

mutual {
  fn surface_place_root(t: SurfaceTerm): Option(Text) {
    match t: Option(Text) {
      SurfaceTermIndexedMk(kind, start, end, Occurrence) => surface_place_root_kind(kind)
    }
  }

  fn surface_place_root_kind(kind: SurfaceKind): Option(Text) {
    match kind: Option(Text) {
      SkVar(name) => Some(name)
      SkField(base, name) => surface_place_root(base)
      _ => None
    }
  }
}

pub fn surface_def_of(t: SurfaceTheorem, ty: SurfaceTerm, body: SurfaceTerm): SurfaceTheorem {
  SurfaceTheorem {
    name: t.name,
    implicit: t.implicit,
    params: t.params,
    ty: ty,
    body: Some(body),
    start: t.start,
    end: t.end
  }
}

// Whether a path pattern is a lone name: no arguments, one name, no `::`.
pub fn surface_simple_path(path: CstNode): Bool {
  match surface_first(path, "PatternArgs"): Bool {
    Some(a) => false
    None => match surface_one(surface_all(path, "Ident")): Bool {
      Some(i) => List::length(surface_all(path, "PathSep")) == 0
      None => false
    }
  }
}

pub fn surface_bind_pattern(written: Text): SurfacePattern {
  match written == "_": SurfacePattern {
    true => PtWild
    false => PtBind(surface_unraw(written))
  }
}


pub fn surface_block_list(block: Option(CstNode)): Option(CstNode) {
  match block: Option(CstNode) {
    Some(b) => surface_first(b, "Stmts")
    None => None
  }
}


pub fn surface_quantifier(kids: List(CstNode), c: SurfaceCtx): Text {
  match kids: Text {
    Cons(n, rest) => surface_text(c, n)
    Nil => ""
  }
}

pub fn surface_bound_term(
  quantifier: Text,
  binder: Text,
  domain: SurfaceTerm,
  body: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  match quantifier == "\u{2203}" || quantifier == "\\exists": SurfaceTerm {
    true => surface_term_at(SkExists(binder, domain, body), span)
    false => surface_term_at(
      SkPi(Cons(SurfaceParam { name: Some(binder), ty: domain }, Nil), body, None),
      span
    )
  }
}

pub fn surface_span_from(acc: SurfaceTerm, end: Nat): SurfaceSpan {
  SurfaceSpan { start: acc.start, end: end }
}

pub fn surface_else(kids: List(CstNode)): Option(CstNode) {
  match surface_find_in(kids, "ElseBranch"): Option(CstNode) {
    Some(e) => surface_nth(e.flat, 0)
    None => None
  }
}



pub fn surface_opt_text_value(c: SurfaceCtx, t: Option(CstNode)): Text {
  match t: Text {
    Some(x) => surface_text_value(c, x)
    None => ""
  }
}

// What an `import` names: the quoted path, or `std.List` as written.
fn surface_texts(c: SurfaceCtx, nodes: List(CstNode)): List(Text) {
  match nodes: List(Text) {
    Nil => Nil
    Cons(n, rest) => Cons(surface_text(c, n), surface_texts(c, rest))
  }
}

pub fn surface_import_path(c: SurfaceCtx, inner: CstNode): Text {
  match surface_first(inner, "Text"): Text {
    Some(t) => surface_text_value(c, t)
    None => surface_import_idents(c, surface_filter_in(inner.flat, "Ident"))
  }
}

// `import std::List` is kept as the path `std.List`: its names joined by
// `.`, however many there are.
fn surface_import_idents(c: SurfaceCtx, idents: List(CstNode)): Text {
  match idents: Text {
    Nil => ""
    Cons(first, rest) => match rest: Text {
      Nil => surface_text(c, first)
      Cons(next, more) => Text::concat(
        Text::concat(surface_text(c, first), "."),
        surface_import_idents(c, rest)
      )
    }
  }
}

pub fn surface_grammar(c: SurfaceCtx, inner: CstNode): Text {
  match surface_nth(surface_descend(c, inner, "SyntaxLit"), 0): Text {
    Some(b) => surface_lit(c, b).body
    None => surface_lit(c, inner).body
  }
}

// The effects a set names (`effect Host { Div, stdout }`), or `None` for an
// effect with a signature.
pub fn surface_effect_set(c: SurfaceCtx, decl: CstNode): Option(List(Text)) {
  match surface_first(decl, "EffectBody"): Option(List(Text)) {
    Some(b) => surface_opt_row_names(c, surface_first(b, "EffectAlias"))
    None => None
  }
}

pub fn surface_signature(decl: CstNode): Option(CstNode) {
  match surface_first(decl, "EffectBody"): Option(CstNode) {
    Some(b) => surface_first(b, "EffectSignature")
    None => None
  }
}

// The parentheses after an operation's name hold its parameters; after a set
// of effects, its type parameters.
pub fn surface_effect_params(decl: CstNode): Option(CstNode) {
  match surface_signature(decl): Option(CstNode) {
    Some(sig) => surface_first(decl, "EffectParams")
    None => None
  }
}

// The explicit resume mode: a written quantity, or `direct` when the mode has
// no quantity. An absent signature or mode remains `None`.
pub fn surface_resume(c: SurfaceCtx, signature: Option(CstNode)): Option(Text) {
  match signature: Option(Text) {
    None => None
    Some(sig) => match surface_first(sig, "EffectMode"): Option(Text) {
      None => None
      Some(mode) => match surface_first(mode, "Quant"): Option(Text) {
        Some(q) => Some(surface_strip(c, surface_text(c, q)))
        None => Some("direct")
      }
    }
  }
}

pub fn surface_struct_fields(c: SurfaceCtx, body: Option(CstNode)): List(CstNode) {
  match body: List(CstNode) {
    None => Nil
    Some(b) => match surface_first(b, "Fields"): List(CstNode) {
      Some(f) => surface_descend(c, f, "FieldDecl")
      None => Nil
    }
  }
}

pub fn surface_ctor_nodes(c: SurfaceCtx, list: Option(CstNode)): List(CstNode) {
  match list: List(CstNode) {
    Some(l) => surface_items(c, l.flat, "Constructor", "ConstructorsTail", "ConstructorsTail")
    None => Nil
  }
}

pub fn surface_is_mut(found: Option(CstNode)): Bool {
  match found: Bool {
    Some(b) => surface_has(b.flat, "KwMut")
    None => false
  }
}

pub fn surface_cont(c: SurfaceCtx, op: CstNode): Option(Text) {
  match surface_last_ident(op.flat): Option(Text) {
    Some(i) => Some(surface_text(c, i))
    None => None
  }
}
// ---- a sequence of operands and operators --------------------------------------------
//
// `Type`, `BodyType`, `Seq` and `Cond` hold operands and the operators between them, flat; the
// precedences build the tree, as `Reader::sequence` in `crates/tauto-surface/src/surface.rs` does.

// One operand: its term with the prefixes that bind to it alone applied, the parenthesized list it is when
// it is nothing else (the parameters of a `->` it stands before), the prefixes `¬` and a binder that take
// a sequence (the first written first) and the `affine` or `linear` before it.
pub(open) inductive SurfacePiece: Type {
  SurfacePieceMk(
    term: SurfaceTerm,
    paren: Option(CstNode),
    loose: List(CstNode),
    kind: Option(CstNode)
  ): SurfacePiece
}

// An operator of a sequence: its sign (an ASCII escape written as the sign) and where it ends.
pub(open) inductive SurfaceOp: Type {
  SurfaceOpMk(sign: Text, end: Nat): SurfaceOp
}

// A term read from a part of a sequence, with what a later operator needs to know of it: the parenthesized
// list it is, its `affine` or `linear`, and whether it is a union (1) or a product (2) built from a run.
pub(open) inductive SurfaceParsed: Type {
  SurfaceParsedMk(
    term: SurfaceTerm,
    paren: Option(CstNode),
    kind: Option(CstNode),
    flat: Nat
  ): SurfaceParsed
}

pub(open) inductive SurfaceClimb: Type {
  SurfaceClimbMk(parsed: SurfaceParsed, pieces: List(SurfacePiece), ops: List(SurfaceOp)): SurfaceClimb
}

// The type written under a node: a `Type`, or a `BodyType` where a `{` or `=>` follows it.
pub fn surface_find_ty(nodes: List(CstNode)): Option(CstNode) {
  match nodes: Option(CstNode) {
    Nil => None
    Cons(x, rest) => match surface_is(x, "Type") || surface_is(x, "BodyType"): Option(CstNode) {
      true => Some(x)
      false => surface_find_ty(rest)
    }
  }
}

pub fn surface_ty(n: CstNode): Option(CstNode) {
  surface_find_ty(n.flat)
}

// The level a prefix reads its operand at: `\u{00ac}` takes the comparisons and what binds tighter, a binder
// takes all that follows.
pub fn surface_sq_prefix_level(prefix: CstNode): Nat {
  match surface_is(prefix, "Binder"): Nat {
    true => 0
    false => 6
  }
}

pub fn surface_sq_parsed(term: SurfaceTerm): SurfaceParsed {
  SurfaceParsed { term: term, paren: None, kind: None, flat: 0 }
}

// How loosely an operator binds: `\u{2194}` 0, `->` 1, `\u{2228}` and `|` 2, `\u{2227}` and `\u{00d7}` 3, `||` 4,
// `&&` 5, the comparisons 6, `+` and `-` 7, `*` and `/` 8.
pub fn surface_sq_level(op: Text): Nat {
  match op == "\u{2194}": Nat {
    true => 0
    false => match op == "->": Nat {
      true => 1
      false => match op == "\u{2228}" || op == "|": Nat {
        true => 2
        false => match op == "\u{2227}" || op == "\u{00d7}": Nat {
          true => 3
          false => match op == "||": Nat {
            true => 4
            false => match op == "&&": Nat {
              true => 5
              false => match op == "=" || op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=": Nat {
                true => 6
                false => match op == "+" || op == "-": Nat {
                  true => 7
                  false => 8
                }
              }
            }
          }
        }
      }
    }
  }
}

// Whether the operators of a level chain: the comparisons and `\u{2194}` do not.
pub fn surface_sq_chains(level: Nat): Bool {
  not(level == 0 || level == 6)
}

// The level the right side of an operator is read at: the same level for the operators that associate to
// the right, the next one for the others.
pub fn surface_sq_next(op: Text): Nat {
  match surface_sq_level(op) >= 1 && surface_sq_level(op) <= 3: Nat {
    true => surface_sq_level(op)
    false => surface_sq_level(op) + 1
  }
}

pub fn surface_sq_has_arrow(ops: List(SurfaceOp)): Bool {
  match ops: Bool {
    Nil => false
    Cons(op, rest) => op.sign == "->" || surface_sq_has_arrow(rest)
  }
}

pub fn surface_sq_ops(c: SurfaceCtx, kids: List(CstNode)): List(SurfaceOp) {
  match kids: List(SurfaceOp) {
    Nil => Nil
    Cons(n, rest) => match surface_is(n, "Op") || surface_is(n, "CondOp"): List(SurfaceOp) {
      true => Cons(
        SurfaceOp { sign: surface_sign(surface_trim(c, surface_text(c, n))), end: surface_span(c, n).end },
        surface_sq_ops(c, rest)
      )
      false => surface_sq_ops(c, rest)
    }
  }
}

// The operators of a sequence, none for a lone operand.
pub fn surface_sq_ops_of(c: SurfaceCtx, n: CstNode): List(SurfaceOp) {
  match surface_is(n, "Operand") || surface_is(n, "CondOperand"): List(SurfaceOp) {
    true => Nil
    false => surface_sq_ops(c, n.flat)
  }
}

// An operand with `affine` or `linear` written before it, kept as the kind of its type.
pub fn surface_sq_finish(c: SurfaceCtx, p: SurfaceParsed): SurfaceTerm {
  match p.kind: SurfaceTerm {
    Some(kind) => surface_fn_kind(c, kind, p.term, SurfaceSpan { start: p.term.start, end: p.term.end })
    None => p.term
  }
}

// The term a prefix that binds to its operand alone makes: a tag, a borrow, or `-` and `+`.
pub fn surface_prefix_term(
  c: SurfaceCtx,
  p: CstNode,
  head: CstNode,
  acc: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  match surface_is(head, "TagPrefix"): SurfaceTerm {
    true => surface_tagged(c, head, acc, span)
    false => match surface_is(head, "Borrow"): SurfaceTerm {
      true => surface_borrowed(head, acc, span)
      false => surface_app(surface_trim(c, surface_text(c, p)), Cons(acc, Nil), span)
    }
  }
}

pub fn surface_prefixed(c: SurfaceCtx, p: CstNode, head: CstNode, built: SurfacePiece): SurfacePiece {
  match surface_is(head, "NotSign") || surface_is(head, "Binder"): SurfacePiece {
    true => SurfacePiece {
      term: built.term,
      paren: built.paren,
      loose: Cons(head, built.loose),
      kind: built.kind
    }
    false => match surface_is(head, "FnKind"): SurfacePiece {
      true => SurfacePiece { term: built.term, paren: built.paren, loose: built.loose, kind: Some(head) }
      false => SurfacePiece {
        term: surface_prefix_term(
          c,
          p,
          head,
          built.term,
          SurfaceSpan { start: surface_span(c, p).start, end: built.term.end }
        ),
        paren: built.paren,
        loose: built.loose,
        kind: built.kind
      }
    }
  }
}

// The members of a run of `|` or of `\u{00d7}` (`want` 1 or 2) that the right side of an operator is, or the term alone.
pub fn surface_sq_members(r: SurfaceTerm, flat: Nat, want: Nat): List(SurfaceTerm) {
  match flat == want: List(SurfaceTerm) {
    true => match r.kind: List(SurfaceTerm) {
      SkUnion(members) => members
      SkProduct(members) => members
      _ => Cons(r, Nil)
    }
    false => Cons(r, Nil)
  }
}

pub fn surface_sq_op_name(op: Text): Text {
  match op == "\u{2227}": Text {
    true => "And"
    false => match op == "\u{2228}": Text {
      true => "Or"
      false => match op == "\u{2194}": Text {
        true => "Iff"
        false => op
      }
    }
  }
}

pub fn surface_sq_binary(op: Text, l: SurfaceTerm, rhs_flat: Nat, r: SurfaceTerm): SurfaceParsed {
  match op == "|": SurfaceParsed {
    true => SurfaceParsed {
      term: surface_term_at(
        SkUnion(Cons(l, surface_sq_members(r, rhs_flat, 1))),
        SurfaceSpan { start: l.start, end: r.end }
      ),
      paren: None,
      kind: None,
      flat: 1
    }
    false => match op == "\u{00d7}": SurfaceParsed {
      true => SurfaceParsed {
        term: surface_term_at(
          SkProduct(Cons(l, surface_sq_members(r, rhs_flat, 2))),
          SurfaceSpan { start: l.start, end: r.end }
        ),
        paren: None,
        kind: None,
        flat: 2
      }
      false => surface_sq_parsed(
        surface_app(
          surface_sq_op_name(op),
          Cons(l, Cons(r, Nil)),
          SurfaceSpan { start: l.start, end: r.end }
        )
      )
    }
  }
}

// `(params) -> result`, with the effects the row after the sequence gives, and the kind written before it.
pub fn surface_sq_pi(
  c: SurfaceCtx,
  kind: Option(CstNode),
  params: List(SurfaceParam),
  result: SurfaceTerm,
  start: Nat,
  effects: Option(List(Text))
): SurfaceParsed {
  match kind: SurfaceParsed {
    Some(k) => surface_sq_parsed(
      surface_fn_kind(
        c,
        k,
        surface_term_at(SkPi(params, result, effects), SurfaceSpan { start: start, end: result.end }),
        SurfaceSpan { start: start, end: result.end }
      )
    )
    None => surface_sq_parsed(
      surface_term_at(SkPi(params, result, effects), SurfaceSpan { start: start, end: result.end })
    )
  }
}

// The row the last `->` takes; none of the others does.
pub fn surface_sq_row_for(last: Bool, row: Option(List(Text))): Option(List(Text)) {
  match last: Option(List(Text)) {
    true => row
    false => None
  }
}

// A comparison or `\u{2194}` followed by another of its level: `a = b = c`.
pub fn surface_sq_chained(op: SurfaceOp, ops: List(SurfaceOp)): Bool {
  match surface_sq_chains(surface_sq_level(op.sign)): Bool {
    true => false
    false => match ops: Bool {
      Nil => false
      Cons(next, more) => surface_sq_level(next.sign) == surface_sq_level(op.sign)
    }
  }
}

pub fn surface_sq_chain_error(left: SurfaceParsed, ops: List(SurfaceOp)): SurfaceClimb {
  match ops: SurfaceClimb {
    Nil => SurfaceClimb { parsed: left, pieces: Nil, ops: Nil }
    Cons(next, more) => SurfaceClimb {
      parsed: surface_sq_parsed(
        surface_term_at(
          SkOther(Text::concat(Text::concat("`", next.sign), "` after a chain")),
          SurfaceSpan { start: left.term.start, end: next.end }
        )
      ),
      pieces: Nil,
      ops: Nil
    }
  }
}

pub fn surface_sq_row(c: SurfaceCtx, n: CstNode): Option(List(Text)) {
  surface_opt_row_names(c, surface_first(n, "EffectRow"))
}

pub fn surface_sq_arrow_row(arrow: Bool, row: Option(List(Text))): Option(List(Text)) {
  match arrow: Option(List(Text)) {
    true => row
    false => None
  }
}

// The row left for the declaration when no `->` takes it.
pub fn surface_sq_unattached(arrow: Bool, row: Option(List(Text))): Option(List(Text)) {
  match arrow: Option(List(Text)) {
    true => None
    false => row
  }
}

mutual {
  pub fn surface_term(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => surface_term_below(j, c, surface_through_levels(j, n))
    }
  }

  pub fn surface_through_levels(k: Nat, n: CstNode): CstNode {
    match k: CstNode {
      Zero => n
      Succ(j) => match surface_is_level(n): CstNode {
        false => n
        true => match n.flat: CstNode {
          Cons(only, Nil) => surface_through_levels(j, only)
          _ => n
        }
      }
    }
  }

  pub fn surface_term_below(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match n.terminal: SurfaceTerm {
        true => surface_other(c, n)
        false => match surface_rule(n.name): SurfaceTerm {
          RuleType => surface_sequence(j, c, n).term
          RuleAngle => surface_angle(j, c, n)
          RuleRow => surface_term_at(SkRow(surface_row_names(c, n)), surface_span(c, n))
          RuleExpr => surface_expr(j, c, n.flat, surface_span(c, n))
          RulePostfix => surface_postfix(j, c, n.flat, surface_span(c, n))
          RulePrimary => surface_term_of(j, c, surface_one(n.flat), n)
          RulePathExpr => surface_path(j, c, n, surface_span(c, n))
          RuleNumber => surface_number(c, n, surface_span(c, n))
          RuleHoleExpr => surface_term_at(
            SkHole(surface_trim_marks(surface_text(c, n))),
            surface_span(c, n)
          )
          RuleText => surface_term_at(SkText(surface_text_value(c, n)), surface_span(c, n))
          RuleTrue => surface_term_at(SkBool(true), surface_span(c, n))
          RuleFalse => surface_term_at(SkBool(false), surface_span(c, n))
          RuleParen => surface_paren_of(
            surface_map_terms(j, c, surface_filter_in(n.flat, "Item")),
            surface_has(n.flat, "Comma"),
            surface_span(c, n)
          )
          RuleListLit => surface_list_of(
            surface_map_terms(j, c, surface_filter_in(n.flat, "Expr")),
            surface_span(c, n)
          )
          RuleBrace => surface_term_of(j, c, surface_one(n.flat), n)
          RuleArmBody => surface_term_of(j, c, surface_first(n, "Expr"), n)
          RuleBlock => surface_block_of(
            surface_block_stmts(j, c, surface_first(n, "Stmts")),
            surface_span(c, n)
          )
          RuleIfExpr => surface_if(j, c, n.flat, surface_span(c, n))
          RulePerformExpr => surface_term_at(
            SkPerform(
              surface_name_of(c, surface_first(n, "OperationName")),
              surface_call_args(j, c, surface_first(n, "Call"))
            ),
            surface_span(c, n)
          )
          RuleHandleExpr => surface_handle(j, c, n, surface_span(c, n))
          RuleBudgetExpr => surface_budget(j, c, n, surface_span(c, n))
          RuleMatchExpr => surface_match(j, c, n, surface_span(c, n))
          RuleSyntaxLit => surface_syntax_lit_term(c, n, surface_span(c, n))
          RuleMacroCall => surface_term_at(
            SkMacroCall(
              surface_macro_name(c, surface_first(n, "MacroName")),
              surface_macro_arg(j, c, n, surface_span(c, n))
            ),
            surface_span(c, n)
          )
          RuleQuoteExpr => surface_term_at(
            SkQuote(
              surface_name_of(c, surface_first(n, "Ident")) == "stmts",
              surface_block_stmts(j, c, surface_block_list(surface_first(n, "Block")))
            ),
            surface_span(c, n)
          )
          RuleSpliceExpr => surface_splice(j, c, n)
          RuleStepExpr => surface_step(j, c, n, surface_span(c, n))
          RuleItem => surface_term_of(j, c, surface_nth(n.flat, 0), n)
          _ => surface_other(c, n)
        }
      }
    }
  }

  // The term of the node found, or `Other` for the node it was looked for in.
  // The argument of `name!(arg)`; `name!()` passes the unit.
  pub fn surface_macro_arg(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_first(n, "Expr"): SurfaceTerm {
        Some(e) => surface_term(j, c, e)
        None => surface_app("Tuple", Nil, span)
      }
    }
  }

  pub fn surface_term_of(
    k: Nat,
    c: SurfaceCtx,
    found: Option(CstNode),
    fallback: CstNode
  ): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match found: SurfaceTerm {
        Some(n) => surface_term(j, c, n)
        None => surface_other(c, fallback)
      }
    }
  }

  pub fn surface_opt_term(k: Nat, c: SurfaceCtx, found: Option(CstNode)): Option(SurfaceTerm) {
    match k: Option(SurfaceTerm) {
      Zero => None
      Succ(j) => match found: Option(SurfaceTerm) {
        Some(n) => Some(surface_term(j, c, n))
        None => None
      }
    }
  }

  pub fn surface_map_terms(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceTerm) {
    match k: List(SurfaceTerm) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceTerm) {
        Nil => Nil
        Cons(n, rest) => Cons(surface_term(j, c, n), surface_map_terms(j, c, rest))
      }
    }
  }

  pub fn surface_splice(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_first(n, "Expr"): SurfaceTerm {
        Some(e) => surface_term_at(SkSplice(surface_term(j, c, e)), surface_span(c, n))
        None => surface_other(c, n)
      }
    }
  }

  pub fn surface_call_args(k: Nat, c: SurfaceCtx, call: Option(CstNode)): List(SurfaceTerm) {
    match k: List(SurfaceTerm) {
      Zero => Nil
      Succ(j) => match call: List(SurfaceTerm) {
        Some(x) => surface_map_terms(j, c, surface_all(x, "Item"))
        None => Nil
      }
    }
  }

  pub fn surface_piece(k: Nat, c: SurfaceCtx, operand: CstNode): SurfacePiece {
    match k: SurfacePiece {
      Zero => SurfacePiece { term: surface_out("fuel"), paren: None, loose: Nil, kind: None }
      Succ(j) => match List::reverse(operand.flat): SurfacePiece {
        Nil => SurfacePiece { term: surface_other(c, operand), paren: None, loose: Nil, kind: None }
        // `prefixes` is last first, the order they are applied in.
        Cons(postfix, prefixes) => surface_piece_prefixes(
          j,
          c,
          prefixes,
          SurfacePiece {
            term: surface_term(j, c, postfix),
            paren: match prefixes: Option(CstNode) {
              Nil => surface_sole_paren(j, postfix)
              Cons(p, more) => None
            },
            loose: Nil,
            kind: None
          }
        )
      }
    }
  }

  pub fn surface_piece_prefixes(
    k: Nat,
    c: SurfaceCtx,
    prefixes: List(CstNode),
    built: SurfacePiece
  ): SurfacePiece {
    match k: SurfacePiece {
      Zero => built
      Succ(j) => match prefixes: SurfacePiece {
        Nil => built
        Cons(p, rest) => match surface_nth(p.flat, 0): SurfacePiece {
          None => surface_piece_prefixes(j, c, rest, built)
          Some(head) => surface_piece_prefixes(j, c, rest, surface_prefixed(c, p, head, built))
        }
      }
    }
  }

  pub fn surface_pieces(k: Nat, c: SurfaceCtx, kids: List(CstNode)): List(SurfacePiece) {
    match k: List(SurfacePiece) {
      Zero => Nil
      Succ(j) => match kids: List(SurfacePiece) {
        Nil => Nil
        Cons(n, rest) => match surface_is(n, "Operand") || surface_is(n, "CondOperand"): List(SurfacePiece) {
          true => Cons(surface_piece(j, c, n), surface_pieces(j, c, rest))
          false => surface_pieces(j, c, rest)
        }
      }
    }
  }

  pub fn surface_sq_pieces_of(k: Nat, c: SurfaceCtx, n: CstNode): List(SurfacePiece) {
    match k: List(SurfacePiece) {
      Zero => Nil
      Succ(j) => match surface_is(n, "Operand") || surface_is(n, "CondOperand"): List(SurfacePiece) {
        true => Cons(surface_piece(j, c, n), Nil)
        false => surface_pieces(j, c, n.flat)
      }
    }
  }

  // The term of a sequence, and the effect row written after it when no `->` takes it: a declaration's
  // result is `A \u{00d7} B ! {e}`, and the row of `(A) -> B ! {e}` is the arrow's.
  pub fn surface_sequence(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceReturn {
    match k: SurfaceReturn {
      Zero => SurfaceReturn { term: surface_out("fuel"), effects: None }
      Succ(j) => surface_sequence_of(j, c, n, surface_sq_pieces_of(j, c, n), surface_sq_ops_of(c, n))
    }
  }

  pub fn surface_sequence_of(
    k: Nat,
    c: SurfaceCtx,
    n: CstNode,
    pieces: List(SurfacePiece),
    ops: List(SurfaceOp)
  ): SurfaceReturn {
    match k: SurfaceReturn {
      Zero => SurfaceReturn { term: surface_out("fuel"), effects: None }
      Succ(j) => match List::length(ops) + 1 == List::length(pieces): SurfaceReturn {
        false => SurfaceReturn { term: surface_other(c, n), effects: None }
        true => SurfaceReturn {
          term: surface_sq_finish(
            c,
            surface_sq_climb(
              j,
              c,
              surface_sq_arrow_row(surface_sq_has_arrow(ops), surface_sq_row(c, n)),
              0,
              pieces,
              ops
            ).parsed
          ),
          effects: surface_sq_unattached(surface_sq_has_arrow(ops), surface_sq_row(c, n))
        }
      }
    }
  }

  // The operand at the front of `pieces` and the operators of at least `min` after it.
  pub fn surface_sq_climb(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(Text)),
    min: Nat,
    pieces: List(SurfacePiece),
    ops: List(SurfaceOp)
  ): SurfaceClimb {
    match k: SurfaceClimb {
      Zero => SurfaceClimb { parsed: surface_sq_parsed(surface_out("fuel")), pieces: Nil, ops: Nil }
      Succ(j) => surface_sq_loop(j, c, row, min, surface_sq_operand(j, c, row, pieces, ops))
    }
  }

  pub fn surface_sq_operand(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(Text)),
    pieces: List(SurfacePiece),
    ops: List(SurfaceOp)
  ): SurfaceClimb {
    match k: SurfaceClimb {
      Zero => SurfaceClimb { parsed: surface_sq_parsed(surface_out("fuel")), pieces: Nil, ops: Nil }
      Succ(j) => match pieces: SurfaceClimb {
        Nil => SurfaceClimb { parsed: surface_sq_parsed(surface_out("sequence")), pieces: Nil, ops: ops }
        Cons(p, rest) => match p.loose: SurfaceClimb {
          Cons(prefix, more) => surface_sq_prefixed(
            j,
            c,
            prefix,
            surface_sq_climb(
              j,
              c,
              row,
              surface_sq_prefix_level(prefix),
              Cons(SurfacePiece { term: p.term, paren: p.paren, loose: more, kind: p.kind }, rest),
              ops
            )
          )
          Nil => SurfaceClimb {
            parsed: SurfaceParsed { term: p.term, paren: p.paren, kind: p.kind, flat: 0 },
            pieces: rest,
            ops: ops
          }
        }
      }
    }
  }

  pub fn surface_sq_prefixed(k: Nat, c: SurfaceCtx, prefix: CstNode, inner: SurfaceClimb): SurfaceClimb {
    match k: SurfaceClimb {
      Zero => inner
      Succ(j) => SurfaceClimb {
        parsed: surface_sq_parsed(
          match surface_is(prefix, "Binder"): SurfaceTerm {
            true => surface_binder(j, c, prefix, surface_sq_finish(c, inner.parsed))
            false => surface_term_at(
              SkPi(
                Cons(SurfaceParam { name: None, ty: surface_sq_finish(c, inner.parsed) }, Nil),
                surface_var(
                  "False",
                  SurfaceSpan {
                    start: surface_span(c, prefix).start,
                    end: surface_sq_finish(c, inner.parsed).end
                  }
                ),
                None
              ),
              SurfaceSpan {
                start: surface_span(c, prefix).start,
                end: surface_sq_finish(c, inner.parsed).end
              }
            )
          }
        ),
        pieces: inner.pieces,
        ops: inner.ops
      }
    }
  }

  pub fn surface_binder(k: Nat, c: SurfaceCtx, binder: CstNode, body: SurfaceTerm): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_find_in(binder.flat, "Ident"): SurfaceTerm {
        None => surface_term_at(SkOther("Binder"), surface_span(c, binder))
        Some(b) => match surface_find_in(binder.flat, "Type"): SurfaceTerm {
          None => surface_term_at(SkOther("Binder"), surface_span(c, binder))
          Some(d) => surface_bound_term(
            surface_quantifier(binder.flat, c),
            surface_text(c, b),
            surface_term(j, c, d),
            body,
            SurfaceSpan { start: surface_span(c, binder).start, end: body.end }
          )
        }
      }
    }
  }

  pub fn surface_sq_loop(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(Text)),
    min: Nat,
    left: SurfaceClimb
  ): SurfaceClimb {
    match k: SurfaceClimb {
      Zero => left
      Succ(j) => match left.ops: SurfaceClimb {
        Nil => left
        Cons(op, rest) => match surface_sq_level(op.sign) < min: SurfaceClimb {
          true => left
          false => surface_sq_after(
            j,
            c,
            row,
            min,
            left,
            op,
            rest,
            surface_sq_climb(j, c, row, surface_sq_next(op.sign), left.pieces, rest)
          )
        }
      }
    }
  }

  pub fn surface_sq_after(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(Text)),
    min: Nat,
    left: SurfaceClimb,
    op: SurfaceOp,
    rest: List(SurfaceOp),
    right: SurfaceClimb
  ): SurfaceClimb {
    match k: SurfaceClimb {
      Zero => left
      Succ(j) => match surface_sq_chained(op, right.ops): SurfaceClimb {
        true => surface_sq_chain_error(
          surface_sq_combine(j, c, row, left.parsed, op, right.parsed, not(surface_sq_has_arrow(rest))),
          right.ops
        )
        false => surface_sq_loop(
          j,
          c,
          row,
          min,
          SurfaceClimb {
            parsed: surface_sq_combine(
              j,
              c,
              row,
              left.parsed,
              op,
              right.parsed,
              not(surface_sq_has_arrow(rest))
            ),
            pieces: right.pieces,
            ops: right.ops
          }
        )
      }
    }
  }

  // `lhs op rhs`; `last` says no `->` follows, so the row after the sequence is this arrow's.
  pub fn surface_sq_combine(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(Text)),
    lhs: SurfaceParsed,
    op: SurfaceOp,
    rhs: SurfaceParsed,
    last: Bool
  ): SurfaceParsed {
    match k: SurfaceParsed {
      Zero => lhs
      Succ(j) => match op.sign == "->": SurfaceParsed {
        true => surface_sq_pi(
          c,
          lhs.kind,
          surface_sq_arrow_params(j, c, lhs),
          surface_sq_finish(c, rhs),
          lhs.term.start,
          surface_sq_row_for(last, row)
        )
        false => surface_sq_binary(
          op.sign,
          surface_sq_finish(c, lhs),
          rhs.flat,
          surface_sq_finish(c, rhs)
        )
      }
    }
  }

  // The parameters `(x: A, &y: B) -> C` names: a parenthesized left is read as a parameter list, any other
  // left is the one parameter, unnamed.
  pub fn surface_sq_arrow_params(k: Nat, c: SurfaceCtx, lhs: SurfaceParsed): List(SurfaceParam) {
    match k: List(SurfaceParam) {
      Zero => Nil
      Succ(j) => match lhs.paren: List(SurfaceParam) {
        Some(paren) => surface_fn_type_items(j, c, surface_all(paren, "Item"))
        None => Cons(surface_param_of(lhs.term), Nil)
      }
    }
  }

  pub fn surface_angle(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_is(n, "GenericKind"): SurfaceTerm {
        true => match surface_first(n, "AngleType"): SurfaceTerm {
          Some(inner) => surface_angle(j, c, inner)
          None => surface_other(c, n)
        }
        false => match surface_first(n, "Postfix"): SurfaceTerm {
          None => surface_other(c, n)
          Some(head) => match surface_first(n, "AngleType"): SurfaceTerm {
            None => surface_term(j, c, head)
            Some(rest) => surface_term_at(
              SkPi(
                match surface_sole_paren(j, head): List(SurfaceParam) {
                  Some(paren) => surface_fn_type_items(j, c, surface_all(paren, "Item"))
                  None => Cons(surface_param_of(surface_term(j, c, head)), Nil)
                },
                surface_angle(j, c, rest),
                None
              ),
              surface_span(c, n)
            )
          }
        }
      }
    }
  }

  pub fn surface_fn_type_items(k: Nat, c: SurfaceCtx, items: List(CstNode)): List(SurfaceParam) {
    match k: List(SurfaceParam) {
      Zero => Nil
      Succ(j) => match items: List(SurfaceParam) {
        Nil => Nil
        Cons(item, rest) => Cons(
          surface_fn_type_item(j, c, item),
          surface_fn_type_items(j, c, rest)
        )
      }
    }
  }

  pub fn surface_fn_type_item(k: Nat, c: SurfaceCtx, item: CstNode): SurfaceParam {
    match k: SurfaceParam {
      Zero => surface_param_of(surface_out("fuel"))
      Succ(j) => match surface_first(item, "Expr"): SurfaceParam {
        None => surface_param_of(surface_term(j, c, item))
        Some(name) => match surface_ty(item): SurfaceParam {
          None => surface_param_of(surface_term(j, c, item))
          Some(ty) => surface_typed_param(surface_term(j, c, name), surface_term(j, c, ty))
        }
      }
    }
  }

  pub fn surface_expr(k: Nat, c: SurfaceCtx, kids: List(CstNode), span: SurfaceSpan): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_expr_parts(kids): SurfaceTerm {
        Nil => surface_term_at(SkOther("Expr"), span)
        // `=> fn a, theorem b` is read where a macro call statement or `decreasing_by` is.
        Cons(lhs, rest) => match surface_find_in(rest, "Generated"): SurfaceTerm {
          Some(g) => surface_term_at(SkOther("a list of generated declarations"), span)
          None => match rest: SurfaceTerm {
            Nil => surface_term(j, c, lhs)
            Cons(rhs, more) => match more: SurfaceTerm {
              Nil => match surface_params(surface_tuple_args(surface_term(j, c, lhs))): SurfaceTerm {
                None => surface_term_at(SkOther("Expr"), span)
                Some(ps) => surface_lambda_of(ps, surface_term(j, c, rhs), span)
              }
              Cons(x, y) => surface_term_at(SkOther("Expr"), span)
            }
          }
        }
      }
    }
  }

  pub fn surface_postfix(
    k: Nat,
    c: SurfaceCtx,
    kids: List(CstNode),
    span: SurfaceSpan
  ): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match kids: SurfaceTerm {
        Nil => surface_term_at(SkOther("Postfix"), span)
        Cons(primary, ops) => surface_postfix_ops(j, c, ops, surface_term(j, c, primary))
      }
    }
  }

  pub fn surface_postfix_ops(
    k: Nat,
    c: SurfaceCtx,
    ops: List(CstNode),
    acc: SurfaceTerm
  ): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match ops: SurfaceTerm {
        Nil => acc
        Cons(op, rest) => match surface_nth(op.flat, 0): SurfaceTerm {
          None => surface_postfix_ops(j, c, rest, acc)
          Some(inner) => surface_postfix_ops(
            j,
            c,
            rest,
            surface_postfix_op(j, c, inner, acc, surface_span_from(acc, surface_span(c, op).end))
          )
        }
      }
    }
  }

  pub fn surface_postfix_op(
    k: Nat,
    c: SurfaceCtx,
    inner: CstNode,
    acc: SurfaceTerm,
    span: SurfaceSpan
  ): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_is(inner, "Call"): SurfaceTerm {
        true => surface_term_at(
          SkApp(acc, surface_map_terms(j, c, surface_all(inner, "Item"))),
          span
        )
        false => match surface_is(inner, "Field"): SurfaceTerm {
          true => match surface_field_type(inner): SurfaceTerm {
            Some(t) => surface_term_at(SkProject(acc, surface_term(j, c, t)), span)
            None => surface_term_at(SkField(acc, surface_label(c, inner)), span)
          }
          false => surface_term_at(SkOther(surface_kind_name(inner)), span)
        }
      }
    }
  }

  pub fn surface_path(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_only_names(n.flat): SurfaceTerm {
        true => surface_var(surface_strip(c, surface_unraw(surface_text(c, n))), span)
        false => match surface_first(n, "RecordBody"): SurfaceTerm {
          None => surface_other(c, n)
          Some(body) => surface_term_at(
            SkRecord(
              Text::concat_all(surface_path_parts(c, n.flat)),
              List::append(
                surface_fields(
                  j,
                  c,
                  surface_items(c, body.flat, "FieldInit", "RecordTail", "RecordTail")
                ),
                surface_record_base(
                  j,
                  c,
                  surface_items(c, body.flat, "RecordBase", "RecordTail", "RecordTail")
                )
              )
            ),
            span
          )
        }
      }
    }
  }

  // `..b` after a record's fields: a last field named `..`, as the Rust
  // reader prints it.
  pub fn surface_record_base(k: Nat, c: SurfaceCtx, bases: List(CstNode)): List(SurfaceField) {
    match k: List(SurfaceField) {
      Zero => Nil
      Succ(j) => match bases: List(SurfaceField) {
        Nil => Nil
        Cons(b, rest) => Cons(
          SurfaceField { name: "..", value: surface_term_of(j, c, surface_first(b, "Expr"), b) },
          Nil
        )
      }
    }
  }

  pub fn surface_fields(k: Nat, c: SurfaceCtx, inits: List(CstNode)): List(SurfaceField) {
    match k: List(SurfaceField) {
      Zero => Nil
      Succ(j) => match inits: List(SurfaceField) {
        Nil => Nil
        Cons(f, rest) => Cons(
          SurfaceField {
            name: surface_label(c, f),
            value: surface_term_of(j, c, surface_first(f, "Expr"), f)
          },
          surface_fields(j, c, rest)
        )
      }
    }
  }

  pub fn surface_if(k: Nat, c: SurfaceCtx, kids: List(CstNode), span: SurfaceSpan): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_find_in(kids, "Cond"): SurfaceTerm {
        None => surface_term_at(SkOther("IfExpr"), span)
        Some(cond) => match surface_find_in(kids, "Block"): SurfaceTerm {
          None => surface_term_at(SkOther("IfExpr"), span)
          Some(then) => surface_term_at(
            SkIf(
              surface_term(j, c, cond),
              surface_term(j, c, then),
              surface_opt_term(j, c, surface_else(kids))
            ),
            span
          )
        }
      }
    }
  }

  pub fn surface_block_stmts(k: Nat, c: SurfaceCtx, stmts: Option(CstNode)): List(SurfaceStmt) {
    match k: List(SurfaceStmt) {
      Zero => Nil
      Succ(j) => match stmts: List(SurfaceStmt) {
        Some(s) => surface_read_stmts(
          j,
          c,
          surface_items(c, s.flat, "Stmt", "StmtsTail", "StmtsTail")
        )
        None => Nil
      }
    }
  }

  // The statements of a program or a module: before an `extern` block, the
  // structs of the types it declares.
  fn surface_item_stmts(k: Nat, c: SurfaceCtx, stmts: Option(CstNode)): List(SurfaceStmt) {
    match k: List(SurfaceStmt) {
      Zero => Nil
      Succ(j) => match stmts: List(SurfaceStmt) {
        Some(s) => surface_read_items(
          j,
          c,
          surface_items(c, s.flat, "Stmt", "StmtsTail", "StmtsTail")
        )
        None => Nil
      }
    }
  }

  fn surface_read_items(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceStmt) {
    match k: List(SurfaceStmt) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceStmt) {
        Nil => Nil
        Cons(s, rest) => match surface_stmt(j, c, s): List(SurfaceStmt) {
          StExtern(abi, fns, start, end) => List::append(
            surface_extern_types(c, surface_descend(c, s, "ExternType")),
            Cons(StExtern(abi, fns, start, end), surface_read_items(j, c, rest))
          )
          StFn(f) => match surface_is_macro_fn(s): List(SurfaceStmt) {
            true => Cons(
              StFn(f),
              Cons(
                StMacro(f.name, f.name, surface_span(c, s).start, surface_span(c, s).end),
                surface_read_items(j, c, rest)
              )
            )
            false => Cons(StFn(f), surface_read_items(j, c, rest))
          }
          other => Cons(other, surface_read_items(j, c, rest))
        }
      }
    }
  }

  pub fn surface_read_stmts(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceStmt) {
    match k: List(SurfaceStmt) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceStmt) {
        Nil => Nil
        Cons(s, rest) => Cons(surface_stmt(j, c, s), surface_read_stmts(j, c, rest))
      }
    }
  }

  pub fn surface_stmt(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceStmt {
    match k: SurfaceStmt {
      Zero => surface_out_stmt("fuel")
      Succ(j) => match surface_first(n, "Attribute"): SurfaceStmt {
        None => surface_plain_stmt(j, c, n)
        Some(attr) => surface_attributed(j, c, attr, n)
      }
    }
  }

  // `@name!(arg) stmt`, the attribute on its own line, with the list after
  // `=>` of what the macro makes besides the declaration.
  pub fn surface_attributed(k: Nat, c: SurfaceCtx, attr: CstNode, n: CstNode): SurfaceStmt {
    match k: SurfaceStmt {
      Zero => surface_out_stmt("fuel")
      Succ(j) => match surface_first(attr, "MacroCall"): SurfaceStmt {
        None => StOther("Attribute", surface_span(c, n).start, surface_span(c, n).end)
        Some(call) => match surface_term(j, c, call).kind: SurfaceStmt {
          SkMacroCall(name, arg) => StAttributed(
            name,
            arg,
            surface_attr_generates(c, surface_first(attr, "AttrGenerates")),
            surface_plain_stmt(j, c, n)
          )
          _ => StOther("Attribute", surface_span(c, n).start, surface_span(c, n).end)
        }
      }
    }
  }

  pub fn surface_plain_stmt(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceStmt {
    match k: SurfaceStmt {
      Zero => surface_out_stmt("fuel")
      Succ(j) => match surface_first(n, "OtherStmt"): SurfaceStmt {
        None => StOther("Stmt", surface_span(c, n).start, surface_span(c, n).end)
        Some(other) => match surface_nth(other.flat, 0): SurfaceStmt {
          None => StOther("OtherStmt", surface_span(c, n).start, surface_span(c, n).end)
          Some(inner) => surface_visible(
            c,
            surface_first(n, "Visibility"),
            surface_stmt_of(j, c, inner, surface_span(c, n))
          )
        }
      }
    }
  }

  pub fn surface_stmt_of(k: Nat, c: SurfaceCtx, inner: CstNode, span: SurfaceSpan): SurfaceStmt {
    match k: SurfaceStmt {
      Zero => surface_out_stmt("fuel")
      Succ(j) => match inner.terminal: SurfaceStmt {
        true => StOther("token", span.start, span.end)
        false => match surface_rule(inner.name): SurfaceStmt {
          RuleLetDecl => StLet(
            surface_ident(c, inner),
            surface_opt_term(j, c, surface_ty(inner)),
            surface_term_of(j, c, surface_first(inner, "Expr"), inner),
            surface_has(inner.flat, "Borrow"),
            surface_is_mut(surface_first(inner, "Borrow"))
          )
          RuleVarDecl => StVar(
            surface_ident(c, inner),
            surface_opt_term(j, c, surface_ty(inner)),
            surface_term_of(j, c, surface_first(inner, "Expr"), inner),
            surface_has(inner.flat, "Amp")
          )
          RuleModuleDecl => StModule(
            surface_ident(c, inner),
            surface_item_stmts(j, c, surface_block_list(surface_first(inner, "Block"))),
            span.start,
            span.end
          )
          RuleFnDecl => StFn(surface_fn_decl(j, c, inner))
          RuleTheoremDecl => StTheorem(surface_theorem_decl(j, c, inner, span))
          RuleAxiomDecl => StTheorem(surface_theorem_decl(j, c, inner, span))
          RuleDefDecl => StDef(surface_def_decl(j, c, inner, span))
          RuleMutualDecl => StMutual(
            surface_mutual_items(
              j,
              c,
              surface_items(c, inner.flat, "MutualItem", "MutualItems", "MutualTail")
            ),
            span.start,
            span.end
          )
          RuleImportDecl => StImport(surface_import_path(c, inner), span.start, span.end)
          RuleSyntaxDecl => StSyntax(
            surface_name_of(c, surface_nth(surface_descend(c, inner, "Ident"), 0)),
            surface_grammar(c, inner),
            span.start,
            span.end
          )
          RuleMacroFnDecl => match surface_first(inner, "FnDecl"): SurfaceStmt {
            Some(decl) => StFn(surface_fn_decl(j, c, decl))
            None => StOther("macro fn", span.start, span.end)
          }
          RuleInductiveDecl => StInductive(surface_inductive_decl(j, c, inner, span))
          RuleEffectDecl => StEffect(surface_effect_decl(j, c, inner))
          RuleStructDecl => StStruct(surface_struct_decl(j, c, inner))
          RuleEnumDecl => StEnum(surface_enum_decl(j, c, inner))
          RuleExternDecl => StExtern(
            surface_opt_text_value(c, surface_first(inner, "Text")),
            surface_extern_fns(j, c, surface_descend(c, inner, "ExternFn")),
            span.start,
            span.end
          )
          RuleClassDecl => StClass(
            SurfaceClass {
              name: surface_ident(c, inner),
              param: surface_head_or_empty(surface_generic_bounds(c, inner).names),
              arity: List::length(surface_generic_bounds(c, inner).names),
              bound: surface_first_bound(surface_generic_bounds(c, inner).bounds),
              methods: surface_extern_fns(j, c, surface_descend(c, inner, "ExternFn")),
              laws: surface_laws(c, surface_descend(c, inner, "LawDecl")),
              start: span.start,
              end: span.end
            }
          )
          RuleInstanceDecl => StInstance(
            SurfaceInstance {
              generics: surface_generic_bounds(c, inner).names,
              bounds: surface_generic_bounds(c, inner).bounds,
              r#class: surface_ident(c, inner),
              head: surface_term_of(j, c, surface_ty(inner), inner),
              wheres: surface_wheres(j, c, surface_first(inner, "WhereClause")),
              methods: surface_extern_fns(j, c, surface_descend(c, inner, "FnDecl")),
              laws: surface_laws(c, surface_descend(c, inner, "LawDecl")),
              start: span.start,
              end: span.end
            }
          )
          RuleWhileStmt => StWhile(
            surface_term_of(j, c, surface_first(inner, "Cond"), inner),
            surface_term_of(j, c, surface_first(inner, "Block"), inner)
          )
          RuleReturnStmt => StReturn(surface_opt_term(j, c, surface_first(inner, "Expr")))
          RuleExprStmt => surface_expr_stmt(j, c, surface_all(inner, "Expr"), span)
          _ => StOther(inner.name, span.start, span.end)
        }
      }
    }
  }

  pub fn surface_expr_stmt(
    k: Nat,
    c: SurfaceCtx,
    exprs: List(CstNode),
    span: SurfaceSpan
  ): SurfaceStmt {
    match k: SurfaceStmt {
      Zero => surface_out_stmt("fuel")
      Succ(j) => match exprs: SurfaceStmt {
        Nil => StOther("ExprStmt", span.start, span.end)
        Cons(first, rest) => match rest: SurfaceStmt {
          Nil => match surface_first(first, "Generated"): SurfaceStmt {
            None => StExpr(surface_term(j, c, first))
            Some(g) => StCalled(
              surface_generated(c, surface_all(first, "Generated")),
              surface_term_of(j, c, surface_first(first, "Seq"), first)
            )
          }
          Cons(value, more) => match more: SurfaceStmt {
            Cons(x, y) => StOther("ExprStmt", span.start, span.end)
            Nil => surface_assign(surface_term(j, c, first), surface_term(j, c, value), span)
          }
        }
      }
    }
  }

  pub fn surface_extern_fns(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceFn) {
    match k: List(SurfaceFn) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceFn) {
        Nil => Nil
        Cons(f, rest) => Cons(surface_fn_decl(j, c, f), surface_extern_fns(j, c, rest))
      }
    }
  }

  pub fn surface_mutual_items(k: Nat, c: SurfaceCtx, items: List(CstNode)): List(SurfaceStmt) {
    match k: List(SurfaceStmt) {
      Zero => Nil
      Succ(j) => match items: List(SurfaceStmt) {
        Nil => Nil
        Cons(item, rest) => match surface_mutual_decl(item): List(SurfaceStmt) {
          None => surface_mutual_items(j, c, rest)
          Some(decl) => match surface_is(decl, "InductiveDecl"): List(SurfaceStmt) {
            true => Cons(
              surface_visible(
                c,
                surface_first(item, "Visibility"),
                StInductive(surface_inductive_decl(j, c, decl, surface_span(c, decl)))
              ),
              surface_mutual_items(j, c, rest)
            )
            false => match surface_is(decl, "FnDecl"): List(SurfaceStmt) {
              true => Cons(
                surface_visible(
                  c,
                  surface_first(item, "Visibility"),
                  StFn(surface_fn_decl(j, c, decl))
                ),
                surface_mutual_items(j, c, rest)
              )
              false => match surface_is(decl, "TheoremDecl"): List(SurfaceStmt) {
                true => Cons(
                  surface_visible(
                    c,
                    surface_first(item, "Visibility"),
                    StTheorem(surface_theorem_decl(j, c, decl, surface_span(c, decl)))
                  ),
                  surface_mutual_items(j, c, rest)
                )
                false => surface_mutual_items(j, c, rest)
              }
            }
          }
        }
      }
    }
  }

  pub fn surface_param_types(
    k: Nat,
    c: SurfaceCtx,
    params: List(CstNode)
  ): List(Option(SurfaceTerm)) {
    match k: List(Option(SurfaceTerm)) {
      Zero => Nil
      Succ(j) => match params: List(Option(SurfaceTerm)) {
        Nil => Nil
        Cons(p, rest) => Cons(
          surface_opt_term(j, c, surface_ty(p)),
          surface_param_types(j, c, rest)
        )
      }
    }
  }

  pub fn surface_fn_result(k: Nat, c: SurfaceCtx, result: Option(CstNode)): Option(SurfaceTerm) {
    match k: Option(SurfaceTerm) {
      Zero => None
      Succ(j) => match result: Option(SurfaceTerm) {
        None => None
        Some(r) => match surface_first(r, "BodyType"): Option(SurfaceTerm) {
          Some(t) => Some(surface_sequence(j, c, t).term)
          None => None
        }
      }
    }
  }

  // The effect row of a function: after its result, or inside it. A row after a function type
  // is that arrow's.
  pub fn surface_fn_effects(k: Nat, c: SurfaceCtx, result: Option(CstNode)): Option(List(Text)) {
    match k: Option(List(Text)) {
      Zero => None
      Succ(j) => match result: Option(List(Text)) {
        None => None
        Some(r) => match surface_first(r, "EffectRow"): Option(List(Text)) {
          Some(w) => Some(surface_row_names(c, w))
          None => match surface_first(r, "BodyType"): Option(List(Text)) {
            None => None
            Some(t) => surface_sequence(j, c, t).effects
          }
        }
      }
    }
  }

  pub fn surface_fn_decl(k: Nat, c: SurfaceCtx, decl: CstNode): SurfaceFn {
    match k: SurfaceFn {
      Zero => surface_out_fn()
      Succ(j) => SurfaceFn {
        name: surface_name_of(c, surface_first(decl, "FnName")),
        generics: surface_generic_bounds(c, decl).names,
        bounds: surface_generic_bounds(c, decl).bounds,
        params: surface_param_idents(c, surface_all(decl, "Param")),
        borrows: surface_param_borrow_flags(surface_all(decl, "Param")),
        param_types: surface_param_types(j, c, surface_all(decl, "Param")),
        result: surface_fn_result(j, c, surface_first(decl, "FnResult")),
        effects: surface_fn_effects(j, c, surface_first(decl, "FnResult")),
        wheres: surface_wheres(j, c, surface_first(decl, "WhereClause")),
        start: surface_span(c, decl).start,
        end: surface_span(c, decl).end,
        // An `extern` function or a class method has no block: its body is an
        // `Other` term of the declaration's kind (`ExternFn`), never run.
        body: surface_term_of(j, c, surface_first(decl, "Block"), decl)
      }
    }
  }

  pub fn surface_wheres(k: Nat, c: SurfaceCtx, w: Option(CstNode)): List(SurfaceConstraint) {
    match k: List(SurfaceConstraint) {
      Zero => Nil
      Succ(j) => match w: List(SurfaceConstraint) {
        Some(clause) => surface_constraints(j, c, surface_all(clause, "Constraint"))
        None => Nil
      }
    }
  }

  pub fn surface_constraints(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceConstraint) {
    match k: List(SurfaceConstraint) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceConstraint) {
        Nil => Nil
        Cons(n, rest) => Cons(
          SurfaceConstraint {
            r#class: surface_ident(c, n),
            ty: surface_term_of(j, c, surface_ty(n), n),
            start: surface_span(c, n).start,
            end: surface_span(c, n).end
          },
          surface_constraints(j, c, rest)
        )
      }
    }
  }

  pub fn surface_effect_decl(k: Nat, c: SurfaceCtx, decl: CstNode): SurfaceEffect {
    match k: SurfaceEffect {
      Zero => SurfaceEffect {
        name: "",
        generics: Nil,
        params: Nil,
        result: None,
        r#resume: None,
        start: 0,
        end: 0,
        set: None
      }
      Succ(j) => SurfaceEffect {
        name: surface_ident(c, decl),
        generics: surface_effect_generics(j, c, decl),
        params: surface_signature_params(j, c, surface_effect_params(decl)),
        result: surface_signature_result(j, c, surface_signature(decl)),
        r#resume: surface_resume(c, surface_signature(decl)),
        start: surface_span(c, decl).start,
        end: surface_span(c, decl).end,
        set: surface_effect_set(c, decl)
      }
    }
  }

  // An operation's generics are written `<A>`; a set's parameters `(T: Type)`.
  pub fn surface_effect_generics(k: Nat, c: SurfaceCtx, decl: CstNode): List(Text) {
    match k: List(Text) {
      Zero => Nil
      Succ(j) => match surface_signature(decl): List(Text) {
        Some(sig) => surface_named_names(surface_generics(j, c, decl))
        None => match surface_first(decl, "EffectParams"): List(Text) {
          Some(p) => surface_param_idents(c, surface_all(p, "Param"))
          None => Nil
        }
      }
    }
  }

  pub fn surface_signature_params(
    k: Nat,
    c: SurfaceCtx,
    params: Option(CstNode)
  ): List(Option(SurfaceTerm)) {
    match k: List(Option(SurfaceTerm)) {
      Zero => Nil
      Succ(j) => match params: List(Option(SurfaceTerm)) {
        Some(p) => surface_param_types(j, c, surface_all(p, "Param"))
        None => Nil
      }
    }
  }

  pub fn surface_signature_result(
    k: Nat,
    c: SurfaceCtx,
    signature: Option(CstNode)
  ): Option(SurfaceTerm) {
    match k: Option(SurfaceTerm) {
      Zero => None
      Succ(j) => match signature: Option(SurfaceTerm) {
        Some(sig) => surface_opt_term(j, c, surface_ty(sig))
        None => None
      }
    }
  }

  pub fn surface_data_fields_of(
    k: Nat,
    c: SurfaceCtx,
    nodes: List(CstNode)
  ): List(SurfaceDataField) {
    match k: List(SurfaceDataField) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceDataField) {
        Nil => Nil
        Cons(f, rest) => Cons(
          SurfaceDataField {
            name: surface_opt_ident(c, f),
            ty: surface_term_of(j, c, surface_ty(f), f)
          },
          surface_data_fields_of(j, c, rest)
        )
      }
    }
  }

  pub fn surface_struct_decl(k: Nat, c: SurfaceCtx, decl: CstNode): SurfaceData {
    match k: SurfaceData {
      Zero => surface_out_data()
      Succ(j) => SurfaceData {
        kind: surface_data_kind(c, decl),
        name: surface_ident(c, decl),
        generics: surface_named_names(surface_generics(j, c, decl)),
        constructors: Cons(
          SurfaceDataCtor {
            name: surface_ident(c, decl),
            fields: surface_data_fields_of(j, c, surface_struct_fields(c, surface_first(decl, "StructBody")))
          },
          Nil
        ),
        start: surface_span(c, decl).start,
        end: surface_span(c, decl).end
      }
    }
  }

  pub fn surface_variants(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceDataCtor) {
    match k: List(SurfaceDataCtor) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceDataCtor) {
        Nil => Nil
        Cons(v, rest) => Cons(
          SurfaceDataCtor {
            name: surface_ident(c, v),
            fields: surface_variant_fields(j, c, surface_first(v, "VariantBody"))
          },
          surface_variants(j, c, rest)
        )
      }
    }
  }

  pub fn surface_variant_fields(
    k: Nat,
    c: SurfaceCtx,
    body: Option(CstNode)
  ): List(SurfaceDataField) {
    match k: List(SurfaceDataField) {
      Zero => Nil
      Succ(j) => match body: List(SurfaceDataField) {
        None => Nil
        Some(b) => match surface_first(b, "Fields"): List(SurfaceDataField) {
          Some(f) => surface_data_fields_of(j, c, surface_descend(c, f, "FieldDecl"))
          None => surface_unnamed_fields(j, c, surface_all(b, "Type"))
        }
      }
    }
  }

  pub fn surface_unnamed_fields(
    k: Nat,
    c: SurfaceCtx,
    types: List(CstNode)
  ): List(SurfaceDataField) {
    match k: List(SurfaceDataField) {
      Zero => Nil
      Succ(j) => match types: List(SurfaceDataField) {
        Nil => Nil
        Cons(t, rest) => Cons(
          SurfaceDataField { name: None, ty: surface_term(j, c, t) },
          surface_unnamed_fields(j, c, rest)
        )
      }
    }
  }

  pub fn surface_enum_decl(k: Nat, c: SurfaceCtx, decl: CstNode): SurfaceData {
    match k: SurfaceData {
      Zero => surface_out_data()
      Succ(j) => SurfaceData {
        kind: surface_data_kind(c, decl),
        name: surface_ident(c, decl),
        generics: surface_named_names(surface_generics(j, c, decl)),
        constructors: surface_variants(j, c, surface_descend(c, decl, "Variant")),
        start: surface_span(c, decl).start,
        end: surface_span(c, decl).end
      }
    }
  }

  // `<A, n: Nat>` or `(A: Type, n: Nat)`: the generics, typed `Type` unless a kind is written.
  pub fn surface_generics(k: Nat, c: SurfaceCtx, node: CstNode): List(SurfaceNamed) {
    match k: List(SurfaceNamed) {
      Zero => Nil
      Succ(j) => match surface_generic_node(node): List(SurfaceNamed) {
        None => Nil
        Some(generics) => surface_generics_of(j, c, surface_generic_items(generics))
      }
    }
  }

  pub fn surface_generics_of(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceNamed) {
    match k: List(SurfaceNamed) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceNamed) {
        Nil => Nil
        Cons(g, rest) => Cons(
          SurfaceNamed { name: surface_ident(c, g), ty: surface_generic_kind(j, c, g) },
          surface_generics_of(j, c, rest)
        )
      }
    }
  }

  pub fn surface_generic_kind(k: Nat, c: SurfaceCtx, g: CstNode): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_first(g, "RowBound"): SurfaceTerm {
        Some(b) => surface_var(surface_strip(c, surface_text(c, b)), surface_span(c, b))
        None => match surface_first(g, "GenericKind"): SurfaceTerm {
          Some(kind) => match surface_kind_term(
            c,
            kind,
            surface_strip(c, surface_text(c, kind))
          ): SurfaceTerm {
            Some(kernel) => kernel
            None => surface_angle(j, c, kind)
          }
          None => surface_var("Type", surface_span(c, g))
        }
      }
    }
  }

  pub fn surface_typed_params_of(k: Nat, c: SurfaceCtx, params: List(CstNode)): List(SurfaceNamed) {
    match k: List(SurfaceNamed) {
      Zero => Nil
      Succ(j) => match params: List(SurfaceNamed) {
        Nil => Nil
        Cons(p, rest) => Cons(
          SurfaceNamed {
            name: surface_ident(c, p),
            ty: surface_term_of(j, c, surface_ty(p), p)
          },
          surface_typed_params_of(j, c, rest)
        )
      }
    }
  }

  pub fn surface_inductive_decl(
    k: Nat,
    c: SurfaceCtx,
    decl: CstNode,
    span: SurfaceSpan
  ): SurfaceInductive {
    match k: SurfaceInductive {
      Zero => SurfaceInductive {
        name: "",
        params: Nil,
        sort: surface_out("fuel"),
        constructors: Nil,
        start: 0,
        end: 0
      }
      Succ(j) => SurfaceInductive {
        name: surface_ident(c, decl),
        params: surface_typed_params_of(j, c, surface_all(decl, "Param")),
        sort: surface_term_of(j, c, surface_ty(decl), decl),
        constructors: surface_constructors(
          j,
          c,
          surface_ctor_nodes(c, surface_first(decl, "Constructors"))
        ),
        start: span.start,
        end: span.end
      }
    }
  }

  pub fn surface_constructors(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceCtor) {
    match k: List(SurfaceCtor) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceCtor) {
        Nil => Nil
        Cons(n, rest) => Cons(
          SurfaceCtor {
            name: surface_ident(c, n),
            implicit: List::length(surface_generics(j, c, n)),
            params: List::append(surface_generics(j, c, n), surface_typed_params_of(j, c, surface_all(n, "Param"))),
            result: surface_term_of(j, c, surface_ty(n), n)
          },
          surface_constructors(j, c, rest)
        )
      }
    }
  }

  // `Colon Type Assign Gap Type`: the first `Type` is the result, the second
  // the body.
  pub fn surface_def_decl(k: Nat, c: SurfaceCtx, decl: CstNode, span: SurfaceSpan): SurfaceTheorem {
    match k: SurfaceTheorem {
      Zero => surface_out_theorem()
      Succ(j) => match surface_all(decl, "Type"): SurfaceTheorem {
        Nil => surface_theorem_decl(j, c, decl, span)
        Cons(result, rest) => match rest: SurfaceTheorem {
          Nil => surface_theorem_decl(j, c, decl, span)
          Cons(body, more) => match more: SurfaceTheorem {
            Cons(x, y) => surface_theorem_decl(j, c, decl, span)
            Nil => surface_def_of(
              surface_theorem_decl(j, c, decl, span),
              surface_term(j, c, result),
              surface_term(j, c, body)
            )
          }
        }
      }
    }
  }

  pub fn surface_theorem_decl(
    k: Nat,
    c: SurfaceCtx,
    decl: CstNode,
    span: SurfaceSpan
  ): SurfaceTheorem {
    match k: SurfaceTheorem {
      Zero => surface_out_theorem()
      Succ(j) => SurfaceTheorem {
        name: surface_ident(c, decl),
        implicit: List::length(surface_generics(j, c, decl)),
        params: List::append(
          surface_generics(j, c, decl),
          List::append(
            surface_dictionary_params(surface_wheres(j, c, surface_first(decl, "WhereClause")), 0),
            surface_typed_params_of(j, c, surface_all(decl, "Param"))
          )
        ),
        ty: surface_term_of(j, c, surface_ty(decl), decl),
        body: surface_opt_term(j, c, surface_first(decl, "Block")),
        start: span.start,
        end: span.end
      }
    }
  }

  // `name: n` pairs in the order written; the first is outermost.
  pub fn surface_budget(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_first(n, "Block"): SurfaceTerm {
        None => surface_other(c, n)
        Some(body) => match surface_budget_ok(
          surface_texts(c, surface_all(n, "Ident")),
          List::length(surface_all(n, "Expr")),
          false,
          false
        ): SurfaceTerm {
          false => surface_other(c, n)
          true => surface_budget_wrap(
            j,
            c,
            surface_texts(c, surface_all(n, "Ident")),
            surface_all(n, "Expr"),
            surface_term(j, c, body),
            span
          )
        }
      }
    }
  }

  fn surface_budget_wrap(
    k: Nat,
    c: SurfaceCtx,
    names: List(Text),
    counts: List(CstNode),
    body: SurfaceTerm,
    span: SurfaceSpan
  ): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match names: SurfaceTerm {
        Nil => body
        Cons(name, rest) => match counts: SurfaceTerm {
          Nil => body
          Cons(count, more) => surface_term_at(
            SkBudget(
              name == "memory",
              surface_term(j, c, count),
              surface_budget_wrap(j, c, rest, more, body, span)
            ),
            span
          )
        }
      }
    }
  }

  pub fn surface_match(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_first(n, "Cond"): SurfaceTerm {
        None => surface_other(c, n)
        Some(
          Scrutinee
        ) => surface_term_at(
          SkMatch(
            surface_term(j, c, Scrutinee),
            surface_opt_term(j, c, surface_ty(n)),
            // Only under `arms`: a `match` in the scrutinee has arms of its own.
            surface_arms(j, c, surface_match_arms(c, surface_first(n, "Arms"))),
            surface_opt_ident(c, n)
          ),
          span
        )
      }
    }
  }

  pub fn surface_step(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_first(n, "MacroCall"): SurfaceTerm {
        None => surface_other(c, n)
        Some(call) => match surface_term(j, c, call): SurfaceTerm {
          SurfaceTermIndexedMk(kind, cs, ce, ast_occurrence) => match kind: SurfaceTerm {
            SkMacroCall(name, arg) => surface_term_at(
              SkStep(
                name,
                arg,
                cs,
                ce,
                surface_opt_term(j, c, surface_ty(n)),
                surface_step_arms(j, c, surface_step_arm_nodes(c, surface_first(n, "StepBody")))
              ),
              span
            )
            SkVar(x) => surface_other(c, n)
            SkNat(x) => surface_other(c, n)
            SkFloat(x) => surface_other(c, n)
            SkRow(x) => surface_other(c, n)
            SkText(x) => surface_other(c, n)
            SkBool(x) => surface_other(c, n)
            SkApp(x, y) => surface_other(c, n)
            SkPi(x, y, z) => surface_other(c, n)
            SkExists(x, y, z) => surface_other(c, n)
            SkLam(x, y) => surface_other(c, n)
            SkUnion(x) => surface_other(c, n)
            SkProduct(x) => surface_other(c, n)
            SkTagged(x, y) => surface_other(c, n)
            SkIf(x, y, z) => surface_other(c, n)
            SkField(x, y) => surface_other(c, n)
            SkProject(x, y) => surface_other(c, n)
            SkBlock(x) => surface_other(c, n)
            SkPerform(x, y) => surface_other(c, n)
            SkHandle(x, y) => surface_other(c, n)
            SkBudget(x, y, z) => surface_other(c, n)
            SkMatch(x, y, z, w) => surface_other(c, n)
            SkHole(x) => surface_other(c, n)
            SkRecord(x, y) => surface_other(c, n)
            SkBorrow(x, y) => surface_other(c, n)
            SkFnKind(x, y) => surface_other(c, n)
            SkBorrowLam(x, y) => surface_other(c, n)
            SkOther(x) => surface_other(c, n)
            SkQuote(x, y) => surface_other(c, n)
            SkSplice(x) => surface_other(c, n)
            SkSyntaxLit(x, y) => surface_other(c, n)
            SkStep(x, y, z, w, v, u) => surface_other(c, n)
          }
        }
      }
    }
  }

  pub fn surface_step_arms(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceStepArm) {
    match k: List(SurfaceStepArm) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceStepArm) {
        Nil => Nil
        Cons(arm, rest) => Cons(
          SurfaceStepArm {
            binders: surface_step_binders(j, c, surface_all(arm, "StepBinder")),
            goal: surface_term_of(j, c, surface_ty(arm), arm),
            body: surface_term_of(j, c, surface_first(arm, "Expr"), arm),
            start: surface_span(c, arm).start,
            end: surface_span(c, arm).end
          },
          surface_step_arms(j, c, rest)
        )
      }
    }
  }

  pub fn surface_step_binders(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceField) {
    match k: List(SurfaceField) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceField) {
        Nil => Nil
        Cons(b, rest) => Cons(
          SurfaceField {
            name: surface_ident(c, b),
            value: surface_term_of(j, c, surface_ty(b), b)
          },
          surface_step_binders(j, c, rest)
        )
      }
    }
  }

  // `C => ⊢ G from p`: the goal written under the arm's body.
  pub fn surface_arm_goal(k: Nat, c: SurfaceCtx, body: Option(CstNode)): Option(SurfaceTerm) {
    match k: Option(SurfaceTerm) {
      Zero => None
      Succ(j) => match body: Option(SurfaceTerm) {
        None => None
        Some(b) => surface_opt_term(j, c, surface_ty(b))
      }
    }
  }

  pub fn surface_arms(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceArm) {
    match k: List(SurfaceArm) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceArm) {
        Nil => Nil
        Cons(arm, rest) => Cons(
          SurfaceArm {
            pattern: surface_pattern_or(j, c, surface_first(arm, "Pattern"), "Arm"),
            guard: surface_opt_term(j, c, surface_first(arm, "Cond")),
            goal: surface_arm_goal(j, c, surface_first(arm, "ArmBody")),
            body: surface_term_of(j, c, surface_first(arm, "ArmBody"), arm)
          },
          surface_arms(j, c, rest)
        )
      }
    }
  }

  pub fn surface_pattern_or(
    k: Nat,
    c: SurfaceCtx,
    found: Option(CstNode),
    what: Text
  ): SurfacePattern {
    match k: SurfacePattern {
      Zero => PtOther("fuel")
      Succ(j) => match found: SurfacePattern {
        Some(p) => surface_pattern(j, c, p)
        None => PtOther(what)
      }
    }
  }

  pub fn surface_pattern_fields(
    k: Nat,
    c: SurfaceCtx,
    found: List(CstNode)
  ): List(SurfacePatternField) {
    match k: List(SurfacePatternField) {
      Zero => Nil
      Succ(j) => match found: List(SurfacePatternField) {
        Nil => Nil
        Cons(f, rest) => match surface_find_label(f.flat): List(SurfacePatternField) {
          None => surface_pattern_fields(j, c, rest)
          Some(i) => Cons(
            SurfacePatternField {
              name: surface_text(c, i),
              pattern: match surface_first(f, "Pattern"): SurfacePattern {
                Some(inner) => surface_pattern(j, c, inner)
                None => PtBind(surface_text(c, i))
              }
            },
            surface_pattern_fields(j, c, rest)
          )
        }
      }
    }
  }

  pub fn surface_patterns(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfacePattern) {
    match k: List(SurfacePattern) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfacePattern) {
        Nil => Nil
        Cons(p, rest) => Cons(surface_pattern(j, c, p), surface_patterns(j, c, rest))
      }
    }
  }

  pub fn surface_pattern(k: Nat, c: SurfaceCtx, n: CstNode): SurfacePattern {
    match k: SurfacePattern {
      Zero => PtOther("fuel")
      Succ(j) => match surface_one(surface_all(n, "PatternAlt")): SurfacePattern {
        None => PtOther("alternatives")
        Some(alt) => match surface_first(alt, "PathPattern"): SurfacePattern {
          Some(path) => surface_path_pattern(j, c, path)
          None => match surface_first(alt, "LiteralPattern"): SurfacePattern {
            None => PtOther("PatternAlt")
            Some(lit) => surface_literal_pattern(c, lit)
          }
        }
      }
    }
  }

  pub fn surface_path_pattern(k: Nat, c: SurfaceCtx, path: CstNode): SurfacePattern {
    match k: SurfacePattern {
      Zero => PtOther("fuel")
      Succ(j) => match surface_simple_path(path): SurfacePattern {
        true => surface_bind_pattern(surface_trim(c, surface_text(c, path)))
        false => {
          let name := Text::concat_all(surface_path_parts(c, path.flat))
          match surface_first(path, "PatternArgs"): SurfacePattern {
            None => PtCtor(name, Nil)
            Some(a) => match surface_first(a, "FieldPatterns"): SurfacePattern {
              Some(list) => PtRecord(
                name,
                surface_pattern_fields(
                  j,
                  c,
                  surface_items(
                    c,
                    list.flat,
                    "FieldPattern",
                    "FieldPatternsTail",
                    "FieldPatternsTail"
                  )
                )
              )
              None => PtCtor(name, surface_patterns(j, c, surface_all(a, "Pattern")))
            }
          }
        }
      }
    }
  }

  pub fn surface_handle(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match surface_first(n, "HandleSubject"): SurfaceTerm {
        None => surface_other(c, n)
        Some(subject) => match surface_first(subject, "Block"): SurfaceTerm {
          None => surface_other(c, n)
          Some(body) => surface_handle_withs(
            j,
            c,
            // Only the tail: the body block can hold `handle`s of its own,
            // whose `with`s are not this one's.
            match surface_first(subject, "HandleTail"): List(CstNode) {
              Some(tail) => surface_descend(c, tail, "HandleWith")
              None => Nil
            },
            surface_term(j, c, body),
            span
          )
        }
      }
    }
  }

  // Each `with` wraps the ones before it; the evaluator reads the list as
  // written, so the nesting is kept as nested `Handle` terms.
  pub fn surface_handle_withs(
    k: Nat,
    c: SurfaceCtx,
    withs: List(CstNode),
    term: SurfaceTerm,
    span: SurfaceSpan
  ): SurfaceTerm {
    match k: SurfaceTerm {
      Zero => surface_out("fuel")
      Succ(j) => match withs: SurfaceTerm {
        Nil => term
        Cons(w, rest) => surface_handle_withs(
          j,
          c,
          rest,
          surface_term_at(
            SkHandle(term, surface_handlers(j, c, surface_descend(c, w, "Handler"))),
            span
          ),
          span
        )
      }
    }
  }

  pub fn surface_handlers(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceHandler) {
    match k: List(SurfaceHandler) {
      Zero => Nil
      Succ(j) => match nodes: List(SurfaceHandler) {
        Nil => Nil
        Cons(h, rest) => Cons(surface_handler(j, c, h), surface_handlers(j, c, rest))
      }
    }
  }

  pub fn surface_handler(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceHandler {
    match k: SurfaceHandler {
      Zero => HdReturn(PtOther("fuel"), surface_out("fuel"))
      Succ(j) => match surface_first(n, "ReturnHandler"): SurfaceHandler {
        Some(r) => HdReturn(
          surface_pattern_or(j, c, surface_first(r, "Pattern"), "return"),
          surface_term_of(j, c, surface_first(r, "Expr"), r)
        )
        None => match surface_first(n, "OperationHandler"): SurfaceHandler {
          None => HdReturn(PtWild, surface_term_of(j, c, surface_first(n, "Expr"), n))
          Some(op) => HdOperation(
            surface_name_of(c, surface_first(op, "OperationName")),
            surface_forall_names(c, surface_first(op, "EffectForall")),
            match surface_first(op, "OperationTypes"): List(SurfaceTerm) {
              Some(t) => surface_map_terms(j, c, surface_all(t, "AngleType"))
              None => Nil
            },
            surface_patterns(j, c, surface_all(op, "Pattern")),
            // `, k` is the identifier after the closing parenthesis.
            surface_cont(c, op),
            surface_opt_term(j, c, surface_first(op, "Cond")),
            surface_term_of(j, c, surface_first(op, "Expr"), op)
          )
        }
      }
    }
  }
}

pub fn surface_program_of(c: SurfaceCtx, root: CstNode): List(SurfaceStmt) {
  match surface_find_deep(c.fuel, root.flat, "Program"): List(SurfaceStmt) {
    None => Nil
    Some(program) => surface_item_stmts(c.fuel * 16, c, surface_first(program, "Stmts"))
  }
}

// The statements of a program whose spans start at `base`, or `None` when it
// is not one of the grammar.
pub fn surface_parse_program(
  &t: SyntaxTables,
  classes: UnicodeClasses,
  source: Text,
  base: Nat
): Option(List(SurfaceStmt)) {
  match syntax_parse(t, source): Option(List(SurfaceStmt)) {
    None => None
    Some(root) => {
      let c := SurfaceCtx { source: source, base: base, classes: classes, fuel: surface_size(root) + 1 }
      match surface_refused(c, root): Option(List(SurfaceStmt)) {
        true => None
        false => Some(surface_program_of(c, root))
      }
    }
  }
}

// A form the grammar reads but the language refuses (`Reader::refused_form`): the name `r#_`, an
// effect operation written `effect ask: () -> i64`.
pub fn surface_refused(c: SurfaceCtx, root: CstNode): Bool {
  surface_any_text(c.fuel, c, root.flat, "Ident", "r#_") || surface_old_effects(c, surface_descend(c, root, "EffectDecl"))
}

pub fn surface_old_effects(c: SurfaceCtx, effects: List(CstNode)): Bool {
  match effects: Bool {
    Nil => false
    Cons(e, rest) => surface_old_effect(c, e) || surface_old_effects(c, rest)
  }
}

pub fn surface_old_effect(c: SurfaceCtx, e: CstNode): Bool {
  match surface_has(e.flat, "EffectParams"): Bool {
    true => false
    false => match surface_first(e, "EffectBody"): Bool {
      None => false
      Some(b) => match surface_first(b, "EffectSignature"): Bool {
        None => false
        Some(sig) => match surface_ty(sig): Bool {
          None => false
          Some(t) => surface_any_named(c.fuel, t.flat, "ThinArrow") && text_starts_with(
            surface_trim(c, surface_text(c, t)),
            "(",
            0
          )
        }
      }
    }
  }
}

pub fn surface_any_named(k: Nat, nodes: List(CstNode), name: Text): Bool {
  match k: Bool {
    Zero => false
    Succ(j) => match nodes: Bool {
      Nil => false
      Cons(n, rest) => n.name == name || surface_any_named(j, n.flat, name) || surface_any_named(j, rest, name)
    }
  }
}

pub fn surface_any_text(k: Nat, c: SurfaceCtx, nodes: List(CstNode), name: Text, written: Text): Bool {
  match k: Bool {
    Zero => false
    Succ(j) => match nodes: Bool {
      Nil => false
      Cons(n, rest) => (n.name == name && Text::slice_or_empty(c.source, n.start, n.end) == written) || surface_any_text(j, c, n.flat, name, written) || surface_any_text(j, c, rest, name, written)
    }
  }
}
