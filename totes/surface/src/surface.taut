import "../../text/src/text.taut"
import "../../identity/src/identity.taut"
import std::text
import std::base
import std::text_ops

// The surface syntax of Tauto read from the tree of `totes/syntax`, in the
// proof language (`docs/design/self-host.md`): a port of `crates/tauto-surface/src/surface.rs`
// and `crates/tauto-surface/src/surface/program.rs`. `README.md` says what each
// part does.

// ---- the surface syntax ------------------------------------------------------------
//
// One tree for types and expressions, and the statements and declarations
// around them. A span is two byte positions, the end excluded.

// A term occurrence identifies a lexical position in a prepared tree.
pub(open) inductive TermOccurrence: Type {
  TermOccurrenceMk(path: List(Nat)): TermOccurrence
}

// Who may see a declaration: only its file, the files that import it (`pub`), also what is
// inside it (`pub(open)`), or, for an effect, who may handle it but not perform it (`pub(handle)`).
pub(open) inductive SurfaceVis: Type {
  VisPrivate: SurfaceVis
  VisPub: SurfaceVis
  VisOpen: SurfaceVis
  VisHandle: SurfaceVis
}

mutual {
  pub(open) inductive SurfaceTerm: Type {
    SurfaceTermIndexedMk(
      kind: SurfaceKind,
      start: Nat,
      end: Nat,
      occurrence: Option(TermOccurrence)
    ): SurfaceTerm
  }
  pub(open) inductive SurfaceKind: Type {
    SkVar(name: SurfaceName): SurfaceKind
    SkNat(digits: Text): SurfaceKind
    SkFloat(digits: Text): SurfaceKind
    // `!{a, b} ∪ e` as an argument: the effect names, the row variable last.
    SkRow(effects: List(RowEntry)): SurfaceKind
    SkText(value: Text): SurfaceKind
    SkBool(value: Bool): SurfaceKind
    SkApp(head: SurfaceTerm, args: List(SurfaceTerm)): SurfaceKind
    SkPi(params: List(SurfaceParam), result: SurfaceTerm, effects: Option(List(RowEntry))): SurfaceKind
    SkExists(binder: Text, domain: SurfaceTerm, body: SurfaceTerm, unused: Option(SurfaceSpan)): SurfaceKind
    // `types`: the types written on the parameters, empty when none is, else one
    // for each parameter. The checker holds the parameters to them.
    SkLam(params: List(Text), body: SurfaceTerm, types: List(Option(SurfaceTerm)), unused_params: List(Option(SurfaceSpan))): SurfaceKind
    SkUnion(parts: List(SurfaceTerm)): SurfaceKind
    SkTagged(tag: Text, value: SurfaceTerm): SurfaceKind
    SkIf(cond: SurfaceTerm, then: SurfaceTerm, otherwise: Option(SurfaceTerm)): SurfaceKind
    SkField(value: SurfaceTerm, name: Text): SurfaceKind
    SkBlock(stmts: List(SurfaceStmt)): SurfaceKind
    SkPerform(op: Text, args: List(SurfaceTerm)): SurfaceKind
    SkHandle(body: SurfaceTerm, handlers: List(SurfaceHandler)): SurfaceKind
    // `perform budget(n, () => { … })`, or with `memory` `perform budget_memory(n, () => { … })`.
    SkBudget(memory: Bool, amount: SurfaceTerm, body: SurfaceTerm): SurfaceKind
    SkMatch(
      scrutinee: SurfaceTerm,
      motive: Option(SurfaceTerm),
      arms: List(SurfaceArm),
      binder: Option(Text),
      binder_unused: Option(SurfaceSpan)
    ): SurfaceKind
    SkHole(name: Text): SurfaceKind
    SkRecord(name: Text, fields: List(SurfaceField)): SurfaceKind
    SkBorrow(mutable: Bool, r#orig: Bool, value: SurfaceTerm): SurfaceKind
    SkFnKind(kind: Text, ty: SurfaceTerm): SurfaceKind
    SkBorrowLam(r#borrows: List(Option(Bool)), lam: SurfaceTerm): SurfaceKind
    SkOther(what: Text): SurfaceKind
    SkMacroCall(name: Text, arg: SurfaceTerm): SurfaceKind
    SkQuote(stmts_form: Bool, stmts: List(SurfaceStmt)): SurfaceKind
    SkSplice(value: SurfaceTerm): SurfaceKind
    SkSyntaxLit(name: Option(Text), body: Text): SurfaceKind
    SkStep(
      tactic: Text,
      arg: SurfaceTerm,
      call_start: Nat,
      call_end: Nat,
      before: Option(SurfaceTerm),
      arms: List(SurfaceStepArm)
    ): SurfaceKind
    // `(e: T)`: `e` at the written type `T`, as `#(e: T, …)` writes a member.
    SkAscribe(value: SurfaceTerm, ty: SurfaceTerm): SurfaceKind
  }
  pub(open) inductive SurfaceStepArm: Type {
    SurfaceStepArmMk(
      binders: List(SurfaceField),
      // Where `^` is written on each binder, aligned with `binders`.
      unused_binders: List(Option(SurfaceSpan)),
      goal: SurfaceTerm,
      body: SurfaceTerm,
      start: Nat,
      end: Nat
    ): SurfaceStepArm
  }
  pub(open) inductive SurfaceParam: Type {
    SurfaceParamMk(name: Option(Text), ty: SurfaceTerm, unused: Option(SurfaceSpan)): SurfaceParam
  }
  pub(open) inductive SurfaceField: Type {
    SurfaceFieldMk(name: Text, value: SurfaceTerm): SurfaceField
  }
  pub(open) inductive SurfaceNamed: Type {
    SurfaceNamedMk(name: Text, ty: SurfaceTerm): SurfaceNamed
  }
  pub(open) inductive SurfacePattern: Type {
    PtWild: SurfacePattern
    PtBind(name: Text, unused: Option(SurfaceSpan)): SurfacePattern
    PtInt(negative: Bool, magnitude: Nat): SurfacePattern
    PtBool(value: Bool): SurfacePattern
    PtText(value: Text): SurfacePattern
    PtCtor(name: SurfaceName, args: List(SurfacePattern)): SurfacePattern
    PtRecord(name: Text, fields: List(SurfacePatternField)): SurfacePattern
    // `y: T =>`, a `match` arm's whole pattern: on a union, the values whose head is one of the
    // heads of `T`'s members, bound to `name` at `T`. `unused` is where `^` is written.
    PtTyped(name: Text, ty: SurfaceTerm, unused: Option(SurfaceSpan)): SurfacePattern
    PtOther(what: Text): SurfacePattern
  }
  pub(open) inductive SurfacePatternField: Type {
    SurfacePatternFieldMk(name: Text, pattern: SurfacePattern): SurfacePatternField
  }
  pub(open) inductive SurfaceArm: Type {
    SurfaceArmMk(
      pattern: SurfacePattern,
      guard: Option(SurfaceTerm),
      goal: Option(SurfaceTerm),
      body: SurfaceTerm
    ): SurfaceArm
  }
  pub(open) inductive SurfaceHandler: Type {
    HdReturn(pattern: SurfacePattern, body: SurfaceTerm): SurfaceHandler
    HdOperation(
      op: Text,
      // The instance the arm answers: the names `∀` binds and the type
      // arguments (`∀ A. show<A>(…)`), both empty when none is written.
      Binds: List(Text),
      types: List(SurfaceTerm),
      patterns: List(SurfacePattern),
      r#resume: Option(Text),
      // Where `^` is written before the continuation name.
      cont_unused: Option(SurfaceSpan),
      guard: Option(SurfaceTerm),
      body: SurfaceTerm
    ): SurfaceHandler
  }
  pub(open) inductive SurfaceStmt: Type {
    StLet(
      name: Text,
      ty: Option(SurfaceTerm),
      value: SurfaceTerm,
      r#borrow: Bool,
      mutable: Bool,
      unused: Option(SurfaceSpan),
      // The word in `let(stack)`.
      stack: Option(Text)
    ): SurfaceStmt
    StVar(
      name: Text,
      ty: Option(SurfaceTerm),
      value: SurfaceTerm,
      r#borrow: Bool,
      unused: Option(SurfaceSpan),
      stack: Option(Text)
    ): SurfaceStmt
    // `x.f = v`: `place` is the whole target, written when it is not just `x`.
    StAssign(name: Text, place: Option(SurfaceTerm), value: SurfaceTerm): SurfaceStmt
    // `call => fn a, theorem b`: a macro call and what it makes, `kind name`.
    StCalled(generates: List(Text), call: SurfaceTerm): SurfaceStmt
    StFn(f: SurfaceFn): SurfaceStmt
    StTheorem(t: SurfaceTheorem): SurfaceStmt
    StDef(t: SurfaceTheorem): SurfaceStmt
    StMutual(stmts: List(SurfaceStmt), start: Nat, end: Nat): SurfaceStmt
    // `module name { … }` with its items as written, each with its own visibility.
    // `surface_flatten_modules` gives the declarations of a program that has modules.
    StModule(name: Text, visibility: SurfaceVis, items: List(SurfaceStmt), start: Nat, end: Nat): SurfaceStmt
    // `pub import path.{a, b}`: the names of the module `path` declared again where this is
    // written, `name_spans` aligned with `names`; `start` and `end` are those of the `pub`.
    StReexport(path: Text, names: List(Text), name_spans: List(SurfaceSpan), start: Nat, end: Nat): SurfaceStmt
    StImport(path: Text, start: Nat, end: Nat): SurfaceStmt
    StInductive(i: SurfaceInductive): SurfaceStmt
    StEffect(e: SurfaceEffect): SurfaceStmt
    StStruct(d: SurfaceData): SurfaceStmt
    StEnum(d: SurfaceData): SurfaceStmt
    StExtern(fns: List(SurfaceFn), instances: List(SurfaceConstraint), types: List(SurfaceData), structs: List(SurfaceData), enums: List(SurfaceData), start: Nat, end: Nat): SurfaceStmt
    StClass(c: SurfaceClass): SurfaceStmt
    StInstance(i: SurfaceInstance): SurfaceStmt
    StWhile(cond: SurfaceTerm, body: SurfaceTerm): SurfaceStmt
    StReturn(value: Option(SurfaceTerm)): SurfaceStmt
    // `loop { B }`, as the block `{ loop B }`; `break` and `continue`.
    StLoop(body: SurfaceTerm, start: Nat, end: Nat): SurfaceStmt
    // `for p in source { body }`: read as written, and left alone by the passes that leave `loop` alone.
    StFor(pattern: SurfacePattern, source: SurfaceTerm, body: SurfaceTerm, start: Nat, end: Nat): SurfaceStmt
    StBreak(value: Option(SurfaceTerm), start: Nat, end: Nat): SurfaceStmt
    StContinue(start: Nat, end: Nat): SurfaceStmt
    StExpr(value: SurfaceTerm): SurfaceStmt
    StOther(what: Text, start: Nat, end: Nat): SurfaceStmt
    StMacro(name: Text, function: Text, start: Nat, end: Nat): SurfaceStmt
    StSyntax(name: Text, grammar: Text, start: Nat, end: Nat): SurfaceStmt
    // `@name!(arg) stmt`; `generates` as `kind name`, the first after the
    // word written before it (`replace fn f`).
    StAttributed(
      name: Text,
      arg: SurfaceTerm,
      generates: List(Text),
      stmt: SurfaceStmt
    ): SurfaceStmt
  }
  pub(open) inductive SurfaceFn: Type {
    SurfaceFnMk(
      name: Text,
      generics: List(Text),
      bounds: List(Option(Text)),
      params: List(Text),
      r#borrows: List(Option(Bool)),
      param_types: List(Option(SurfaceTerm)),
      result: Option(SurfaceTerm),
      effects: Option(List(RowEntry)),
      wheres: List(SurfaceConstraint),
      start: Nat,
      end: Nat,
      body: SurfaceTerm,
      // `borrows(…)` after the result, each path or operation as written.
      lends: Option(List(Text)),
      generic_types: List(SurfaceTerm),
      // Where each generic's `name: T` starts (it ends where `T` does); `None` for a row variable.
      bound_starts: List(Option(Nat)),
      // `pub` or `pub(open)` written before the function, as the Rust reader keeps it.
      visibility: SurfaceVis,
      // Where the `!?` is, when the row is not written yet.
      row_hole: Option(SurfaceSpan),
      unused: Option(SurfaceSpan),
      // Where `^` marks each type parameter unused, aligned with `generics`.
      unused_generics: List(Option(SurfaceSpan)),
      unused_params: List(Option(SurfaceSpan))
    ): SurfaceFn
  }
  pub(open) inductive SurfaceConstraint: Type {
    SurfaceConstraintMk(
      r#class: Text,
      ty: SurfaceTerm,
      start: Nat,
      end: Nat,
      arguments: List(SurfaceTerm)
    ): SurfaceConstraint
  }
  // `law name…`: its name and where it is (the proposition is not read).
  pub(open) inductive SurfaceLaw: Type {
    SurfaceLawMk(name: Text, start: Nat, end: Nat, decl: SurfaceTheorem): SurfaceLaw
  }
  // `class C(A: bound) { … }`: the methods' signatures (a method has no
  // block, so its body is an `Other` term of kind `ExternFn`) and the laws. `arity` is how many parameters were written.
  pub(open) inductive SurfaceClass: Type {
    SurfaceClassMk(
      name: Text,
      param: Text,
      arity: Nat,
      bound: Option(Text),
      methods: List(SurfaceFn),
      laws: List(SurfaceLaw),
      start: Nat,
      end: Nat,
      parameters: List(SurfaceNamed),
      // Written `inductive class`: the proof side's class.
      proof_side: Bool,
      parents: List(SurfaceConstraint),
      // Where `^` marks each class parameter unused, aligned with `parameters`.
      unused_parameters: List(Option(SurfaceSpan)),
      // `pub` or `pub(open)` written before the declaration.
      visibility: SurfaceVis
    ): SurfaceClass
  }
  pub(open) inductive SurfaceInferCondition: Type {
    InferParameter(name: Text): SurfaceInferCondition
    InferAnd(left: SurfaceInferCondition, right: SurfaceInferCondition): SurfaceInferCondition
    InferOr(left: SurfaceInferCondition, right: SurfaceInferCondition): SurfaceInferCondition
  }
  pub(open) inductive SurfaceInstance: Type {
    SurfaceInstanceMk(
      generics: List(Text),
      bounds: List(Option(Text)),
      r#class: Text,
      head: SurfaceTerm,
      wheres: List(SurfaceConstraint),
      methods: List(SurfaceFn),
      laws: List(SurfaceLaw),
      start: Nat,
      end: Nat,
      generic_types: List(SurfaceTerm),
      arguments: List(SurfaceTerm),
      infer_from: Option(SurfaceInferCondition),
      // Where `^` marks each type parameter unused, aligned with `generics`.
      unused_generics: List(Option(SurfaceSpan))
    ): SurfaceInstance
  }
  pub(open) inductive SurfaceTheorem: Type {
    SurfaceTheoremMk(
      name: Text,
      implicit: Nat,
      params: List(SurfaceNamed),
      ty: SurfaceTerm,
      body: Option(SurfaceTerm),
      start: Nat,
      end: Nat,
      unused: Option(SurfaceSpan),
      unused_params: List(Option(SurfaceSpan)),
      // `pub` or `pub(open)` written before the declaration.
      visibility: SurfaceVis
    ): SurfaceTheorem
  }
  pub(open) inductive SurfaceCtor: Type {
    SurfaceCtorMk(
      name: Text,
      implicit: Nat,
      params: List(SurfaceNamed),
      result: SurfaceTerm
    ): SurfaceCtor
  }
  pub(open) inductive SurfaceInductive: Type {
    SurfaceInductiveMk(
      name: Text,
      params: List(SurfaceNamed),
      sort: SurfaceTerm,
      constructors: List(SurfaceCtor),
      start: Nat,
      end: Nat,
      // `pub` or `pub(open)` written before the declaration.
      visibility: SurfaceVis
    ): SurfaceInductive
  }
  pub(open) inductive SurfaceEffect: Type {
    SurfaceEffectMk(
      name: Text,
      generics: List(Text),
      params: List(Option(SurfaceTerm)),
      result: Option(SurfaceTerm),
      r#resume: Option(Text),
      start: Nat,
      end: Nat,
      set: Option(List(RowEntry)),
      // Where `^` marks each type parameter unused, aligned with `generics`.
      unused_generics: List(Option(SurfaceSpan)),
      // The bound written on each type parameter (`<A: Shared>`), aligned
      // with `generics`; `None` when none is written.
      bounds: List(Option(Text)),
      // `pub`, `pub(open)` or `pub(handle)` written before the declaration.
      visibility: SurfaceVis,
      // Whether each generic is a row variable (`<!e>`), aligned with
      // `generics`; empty when none is.
      rows: List(Bool)
    ): SurfaceEffect
  }
  // An entry of an effect row as written: an effect's name or a row variable
  // `|e`, or an effect applied to its argument terms (`res(Pos)`), for every
  // instance when `universal` (`∀ A. res(A)`, its names `forall`). The name and
  // the terms are kept apart: nothing reads an entry back from its text.
  pub(open) inductive RowEntry: Type {
    // `unused` is where `^` marks the entry as declared but not performed.
    EntryName(name: Text, unused: Option(SurfaceSpan)): RowEntry
    EntryApplied(
      name: Text,
      args: List(SurfaceTerm),
      universal: Bool,
      forall: List(Text),
      unused: Option(SurfaceSpan)
    ): RowEntry
  }
  pub(open) inductive SurfaceDataField: Type {
    SurfaceDataFieldMk(name: Option(Text), ty: SurfaceTerm): SurfaceDataField
  }
  pub(open) inductive SurfaceDataCtor: Type {
    SurfaceDataCtorMk(name: Text, fields: List(SurfaceDataField)): SurfaceDataCtor
  }
  pub(open) inductive SurfaceData: Type {
    SurfaceDataMk(
      kind: Option(Text),
      name: Text,
      generics: List(Text),
      constructors: List(SurfaceDataCtor),
      start: Nat,
      end: Nat,
      // `coerce`, `coerce(mut)` or `coerce(owned)` as written before the field
      // `coerce_field` (its index), when a field has one.
      coerce_level: Option(Text),
      coerce_field: Nat,
      visibility: SurfaceVis,
      // Where `^` marks each type parameter unused, aligned with `generics`.
      unused_generics: List(Option(SurfaceSpan)),
      // Whether each generic is a row variable (`<!e>`), aligned with
      // `generics`; empty when none is.
      rows: List(Bool)
    ): SurfaceData
  }
}


// Construction has no lexical identity until the complete tree is prepared.
pub fn surface_term_mk(kind: SurfaceKind, start: Nat, end: Nat): SurfaceTerm {
  SurfaceTermIndexedMk(kind, start, end, None)
}

pub fn surface_append<A>(xs: List(A), ys: List(A)): List(A) {
  List::append(xs, ys)
}

pub fn surface_reverse<A>(xs: List(A)): List(A) {
  List::reverse(xs)
}

// The value of a text literal's token (`unquote_text` of `surface.rs`):
// `"…"` with its escapes resolved (`\\ \" \' \n \r \t \0 \u{X…}`), `'…'` and
// plaintext`…` as written.

pub fn surface_inner(token: Text): Text {
  match Text::len(token) >= 2 {
    true => Text::slice_or_empty(token, 1, Text::len(token) - 1)
    false => ""
  }
}

// The value of a hexadecimal digit, or 16.
pub fn surface_hex_digit(b: Nat): Nat {
  match b >= 48 && b <= 57 {
    true => b - 48
    false => ⊢ Nat from match b >= 97 && b <= 102 {
      true => b - 87
      false => ⊢ Nat from match b >= 65 && b <= 70 {
        true => b - 55
        false => 16
      }
    }
  }
}

pub fn surface_hex_in(k: Nat, digits: Text, at: Nat, acc: Nat): Option(Nat) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(Nat) from match at >= Text::len(digits) {
      true => Some(acc)
      false => ⊢ Option(Nat) from match surface_hex_digit(Text::byte_value(digits, at)) > 15 {
        true => None
        false => ⊢ Option(Nat) from match acc * 16 + surface_hex_digit(
          Text::byte_value(digits, at)
        ) > 4294967295 {
          true => None
          false => surface_hex_in(
            j,
            digits,
            at + 1,
            acc * 16 + surface_hex_digit(Text::byte_value(digits, at))
          )
        }
      }
    }
  }
}

// `u32::from_str_radix(digits, 16)`: an optional `+`, then digits, and the
// value must fit in 32 bits.
pub fn surface_hex(digits: Text): Option(Nat) {
  match Text::len(digits) > 0 && Text::byte_value(digits, 0) == 43 {
    true => ⊢ Option(Nat) from match 1 >= Text::len(digits) {
      true => None
      false => surface_hex_in(Text::len(digits) + 1, digits, 1, 0)
    }
    false => ⊢ Option(Nat) from match 0 >= Text::len(digits) {
      true => None
      false => surface_hex_in(Text::len(digits) + 1, digits, 0, 0)
    }
  }
}

// The character of a code point, U+FFFD when there is None.
pub fn surface_char_of(code: Option(Nat)): Text {
  match code {
    None => text_code_point(65533)
    Some(c) => ⊢ Text from match c < 1114112 && not(c >= 55296 && c < 57344) {
      true => text_code_point(c)
      false => text_code_point(65533)
    }
  }
}

pub fn surface_unicode_read(body: Text, start: Nat, close: Nat): Text × Nat {
  #(surface_char_of(
    surface_hex(Text::slice_or_empty(body, start, close))
  ), ⊢ Nat from match close < Text::len(body) {
      true => close + 1
      false => close
    })
}

pub fn surface_unicode_close(body: Text, start: Nat): Text × Nat {
  surface_unicode_read(body, start, ⊢ Nat from match text_find(body, "}", start) {
    Some(c) => c
    None => Text::len(body)
  })
}

// After `\u`: the next character is skipped (it is the `{`), the characters
// up to a `}` (which is taken too) are hexadecimal digits of a code point;
// a bad one is U+FFFD. The character and where reading resumes.
pub fn surface_unicode_escape(body: Text, at: Nat): Text × Nat {
  surface_unicode_close(body, ⊢ Nat from match text_decode(body, at) {
    Some(#(@code _, @len len)) => at + len
    None => at
  })
}

// The character an escape `\c` (`c` is `escape`) stands for, when it is not
// `\u`.
pub fn surface_escaped(escape: Nat, written: Text): Text {
  match escape == 110 {
    true => text_code_point(10)
    false => ⊢ Text from match escape == 114 {
      true => text_code_point(13)
      false => ⊢ Text from match escape == 116 {
        true => text_code_point(9)
        false => ⊢ Text from match escape == 48 {
          true => text_code_point(0)
          false => written
        }
      }
    }
  }
}

pub fn surface_escapes_in(k: Nat, body: Text, at: Nat, done: List(Text)): List(Text) {
  match k {
    Zero => done
    Succ(j) => ⊢ List(Text) from match text_decode(body, at) {
      None => done
      Some(#(@code code, @len len)) => ⊢ List(Text) from match code != 92 {
        true => surface_escapes_in(
          j,
          body,
          at + len,
          Cons(Text::slice_or_empty(body, at, at + len), done)
        )
        false => ⊢ List(Text) from match text_decode(body, at + 1) {
          None => done
          Some(#(@code escape, @len escape_len)) => ⊢ List(Text) from match escape == 117 {
            true => surface_escapes_in(
              j,
              body,
              surface_unicode_escape(body, at + 1 + escape_len).snd,
              Cons(surface_unicode_escape(body, at + 1 + escape_len).fst, done)
            )
            false => surface_escapes_in(
              j,
              body,
              at + 1 + escape_len,
              Cons(
                surface_escaped(escape, Text::slice_or_empty(body, at + 1, at + 1 + escape_len)),
                done
              )
            )
          }
        }
      }
    }
  }
}

pub fn surface_escapes(body: Text): Text {
  Text::concat_all(List::reverse(surface_escapes_in(Text::len(body) + 1, body, 0, Nil)))
}

pub fn surface_unquote_plain(raw: Text): Text {
  match Text::len(raw) > 0 && Text::byte_value(raw, Text::len(raw) - 1) == 96 {
    true => Text::slice_or_empty(raw, 0, Text::len(raw) - 1)
    false => raw
  }
}

pub fn surface_unquote(token: Text): Text {
  match text_starts_with(token, "plaintext`", 0) {
    true => surface_unquote_plain(Text::slice_or_empty(token, 10, Text::len(token)))
    false => ⊢ Text from match text_starts_with(token, "'", 0) {
      true => surface_inner(token)
      false => surface_escapes(surface_inner(token))
    }
  }
}

pub(open) inductive SurfaceSpan: Type {
  Mk(start: Nat, end: Nat): SurfaceSpan
}

pub fn surface_term_at(kind: SurfaceKind, span: SurfaceSpan): SurfaceTerm {
  SurfaceTerm { occurrence: None, kind: kind, start: span.start, end: span.end }
}

// `$name` for a quotation hole written `$r#name` or `${name}` (`${r#name}` too);
// `None` for a hole written plainly, or a text that is not a hole.
pub fn surface_unhole(written: Text): Option(Text) {
  match Text::len(written) > 1 && Text::slice_or_empty(written, 0, 1) == "$" {
    false => None
    true => {
      let rest := Text::slice_or_empty(written, 1, Text::len(written))
      let braced := Text::len(rest) > 1 && Text::slice_or_empty(rest, 0, 1) == "{" &&
        Text::slice_or_empty(rest, Text::len(rest) - 1, Text::len(rest)) == "}"
      let inner := ⊢ Text from match braced {
        true => Text::slice_or_empty(rest, 1, Text::len(rest) - 1)
        false => rest
      }
      let name := surface_unraw(inner)
      ⊢ Option(Text) from match braced || not(Text::len(name) == Text::len(inner)) {
        true => Some(Text::concat("$", name))
        false => None
      }
    }
  }
}

// A name written with `r#` on any segment is the name without it: `r#class` is `class`, and
// `Elab::r#class` is `Elab::class`.
pub fn surface_unraw(written: Text): Text {
  surface_unraw_segments(
    Text::len(written) + 1,
    ⊢ Text from match Text::len(written) > 2 && Text::slice_or_empty(written, 0, 2) == "r#" {
      true => Text::slice_or_empty(written, 2, Text::len(written))
      // A name a `quote` splices keeps its `$`: `$r#copy` is `$copy`.
      false => ⊢ Text from match Text::len(written) > 3 && Text::slice_or_empty(written, 0, 3) == "$r#" {
        true => Text::concat("$", Text::slice_or_empty(written, 3, Text::len(written)))
        false => written
      }
    }
  )
}

pub fn surface_unraw_segments(k: Nat, t: Text): Text {
  match k {
    Zero => t
    Succ(j) => ⊢ Text from match text_find(t, "::r#", 0) {
      None => t
      Some(i) => Text::concat(
        Text::slice_or_empty(t, 0, i + 2),
        surface_unraw_segments(j, Text::slice_or_empty(t, i + 4, Text::len(t)))
      )
    }
  }
}

pub fn surface_var(name: Text, span: SurfaceSpan): SurfaceTerm {
  surface_term_at(SkVar(NameSpelled(name)), span)
}

pub fn surface_app(function: Text, arguments: List(SurfaceTerm), span: SurfaceSpan): SurfaceTerm {
  surface_term_at(SkApp(surface_var(function, span), arguments), span)
}

// `where C(T)` of a theorem is a parameter after the generics, the record
// of the class, named `inst@C` followed by the clause's index (`inst@C0`
// for the first when `index` is 0).
pub fn surface_dictionary_params(wheres: List(SurfaceConstraint), index: Nat): List(SurfaceNamed) {
  match wheres {
    Nil => Nil
    Cons(w, rest) => ⊢ List(SurfaceNamed) from match w {
      SurfaceConstraintMk(r#class, ty, start, end, arguments) => Cons(
        SurfaceNamed {
          name: Text::concat("inst@", Text::concat(r#class, Text::of_nat(index))),
          ty: surface_app(r#class, Cons(ty, arguments), SurfaceSpan { start: start, end: end })
        },
        surface_dictionary_params(rest, index + 1)
      )
    }
  }
}

pub fn surface_trim_marks_in(k: Nat, t: Text, at: Nat): Text {
  match k {
    Zero => Text::slice_or_empty(t, at, Text::len(t))
    Succ(j) => ⊢ Text from match Text::byte_value(t, at) == 63 && at < Text::len(t) {
      true => surface_trim_marks_in(j, t, at + 1)
      false => Text::slice_or_empty(t, at, Text::len(t))
    }
  }
}

pub fn surface_trim_marks(t: Text): Text {
  surface_trim_marks_in(Text::len(t) + 1, t, 0)
}

pub(open) inductive SurfaceLit: Type {
  Mk(name: Option(Text), body: Text): SurfaceLit
}

pub fn surface_lit_name(t: Text, end: Nat): Option(Text) {
  match end {
    Zero => None
    Succ(^e) => Some(Text::slice_or_empty(t, 0, end))
  }
}

pub fn surface_find_or(t: Text, needle: Text, default: Nat): Nat {
  match text_find(t, needle, 0) {
    Some(i) => i
    None => default
  }
}

pub fn surface_blank_tail_in(k: Nat, t: Text, at: Nat): Bool {
  match k {
    Zero => true
    Succ(j) => ⊢ Bool from match at >= Text::len(t) {
      true => true
      false => (
        Text::byte_value(t, at) == 32 || Text::byte_value(t, at) == 9
      ) && surface_blank_tail_in(j, t, at + 1)
    }
  }
}

pub fn surface_blank_tail(t: Text, at: Nat): Bool {
  surface_blank_tail_in(Text::len(t) + 1, t, at)
}

pub fn surface_last_newline(t: Text, at: Nat): Option(Nat) {
  match at {
    Zero => ⊢ Option(Nat) from match Text::byte_value(t, 0) == 10 && 0 < Text::len(t) {
      true => Some(0)
      false => None
    }
    Succ(below) => ⊢ Option(Nat) from match Text::byte_value(t, at) == 10 && at < Text::len(t) {
      true => Some(at)
      false => surface_last_newline(t, below)
    }
  }
}

pub fn surface_without_eol(t: Text, n: Nat): Nat {
  match n {
    Zero => 0
    Succ(m) => ⊢ Nat from match Text::byte_value(t, m) == 10 || Text::byte_value(t, m) == 13 {
      true => surface_without_eol(t, m)
      false => n
    }
  }
}

pub fn surface_lead_in(k: Nat, t: Text, at: Nat): Nat {
  match k {
    Zero => at
    Succ(j) => ⊢ Nat from match at < Text::len(
      t
    ) && (Text::byte_value(t, at) == 32 || Text::byte_value(t, at) == 9) {
      true => surface_lead_in(j, t, at + 1)
      false => at
    }
  }
}

pub fn surface_line_end(body: Text, at: Nat): Nat {
  match text_find(body, text_newline(), at) {
    Some(i) => i + 1
    None => Text::len(body)
  }
}

pub fn surface_out(name: Text): SurfaceTerm {
  SurfaceTerm { occurrence: None, kind: SkOther(name), start: 0, end: 0 }
}

// The sign an ASCII escape stands for: `\times` is `\u{00d7}`.
pub fn surface_sign(op: Text): Text {
  match op == "\\times" {
    true => "\u{00d7}"
    false => ⊢ Text from match op == "\\land" {
      true => "\u{2227}"
      false => ⊢ Text from match op == "\\lor" {
        true => "\u{2228}"
        false => ⊢ Text from match op == "\\iff" {
          true => "\u{2194}"
          false => op
        }
      }
    }
  }
}

// The prelude's names a product and the unit are read as, spelled in full so that
// no declaration of a file's own is meant: `A × B` is `Pair(A, B)`, `#(a, b)` is
// `Pair::Mk(a, b)`, `#()` is `Star`, of the type `Unit`.
pub fn surface_pair_name(): Text { "std::prelude::Pair" }
pub fn surface_pair_mk_name(): Text { "std::prelude::Pair::Mk" }
pub fn surface_star_name(): Text { "std::prelude::Star" }
pub fn surface_unit_name(): Text { "std::prelude::Unit" }

// `(a, b)` read as a term: a parenthesized list is no term, a product being `#(a, b)`.
pub fn surface_paren_list(): Text { "parenthesized list" }

// The unit `#()`.
pub fn surface_star(span: SurfaceSpan): SurfaceTerm { surface_var(surface_star_name(), span) }

// `#(a, b, c)`: `Pair::Mk(a, Pair::Mk(b, c))`, each cell spanning from its member to the
// end; no member is the unit. `A × B × C` is the same with `Pair`.
pub fn surface_pairs(head: Text, items: List(SurfaceTerm), end: Nat): SurfaceTerm {
  match items {
    Nil => surface_var(
      if head == surface_pair_name() { surface_unit_name() } else { surface_star_name() },
      SurfaceSpan { start: 0, end: end }
    )
    Cons(first, rest) => ⊢ SurfaceTerm from match rest {
      Nil => first
      Cons(^x, ^y) => {
        let snd := surface_pairs(head, rest, end)
        surface_app(
          head,
          Cons(first, Cons(snd, Nil)),
          SurfaceSpan { start: first.start, end: Nat::max(end, snd.end) }
        )
      }
    }
  }
}

pub fn surface_param_of(ty: SurfaceTerm): SurfaceParam {
  SurfaceParam { name: None, ty: ty, unused: None }
}

// `x: A` as a parameter: `A`, named `x`, which the later parameters and the
// result may use. `&x: A` is of type `A`, borrowed as `&x` is (mutably for
// `&mut x`), and the name is not kept.
pub fn surface_typed_param(name: SurfaceTerm, ty: SurfaceTerm): SurfaceParam {
  match name.kind {
    SkBorrow(mutable, mutable_orig, ^x) => surface_param_of(
      surface_term_at(SkBorrow(mutable, mutable_orig, ty), SurfaceSpan { start: ty.start, end: ty.end })
    )
    SkVar(written) => SurfaceParam { name: Some(surface_name_text(written)), ty: ty, unused: None }
    _ => surface_param_of(ty)
  }
}

pub fn surface_join(items: List(Text), sep: Text): Text {
  match items {
    Nil => ""
    Cons(x, rest) => ⊢ Text from match rest {
      Nil => x
      Cons(^y, ^more) => Text::concat_all(Cons(x, Cons(sep, Cons(surface_join(rest, sep), Nil))))
    }
  }
}

pub fn surface_text_in(x: Text, xs: List(Text)): Bool {
  match xs {
    Nil => false
    Cons(y, rest) => ⊢ Bool from match x == y {
      true => true
      false => surface_text_in(x, rest)
    }
  }
}

// `seen`, then the names of `new` it does not have yet, in order.
pub fn surface_append_new(seen: List(Text), new: List(Text)): List(Text) {
  match new {
    Nil => seen
    Cons(x, rest) => ⊢ List(Text) from match surface_text_in(x, seen) {
      true => surface_append_new(seen, rest)
      false => surface_append_new(List::append(seen, Cons(x, Nil)), rest)
    }
  }
}

// `body` in parentheses when `yes`.
pub fn row_paren_if(yes: Bool, body: Text): Text {
  if yes { Text::concat_all(Cons("(", Cons(body, Cons(")", Nil)))) } else { body }
}

// A written row as it is shown, when one is written.
pub fn row_opt_entries_text(o: Option(List(RowEntry))): Option(List(Text)) {
  match o {
    None => None
    Some(es) => Some(row_entries_text(es))
  }
}

// The effect an entry names: `res` of `res(Pos)` and of `∀ A. res(A)`.
pub fn row_entry_name(e: RowEntry): Text {
  match e {
    EntryName(n, ^unused) => n
    EntryApplied(n, ^args, ^universal, ^forall, ^unused) => n
  }
}

// `{a, b} ∪ e ∪ f`: the labels in braces, then each row variable; `{}` when
// there is neither.
pub fn row_set_text(es: List(Text)): Text {
  let labels := row_set_labels(es)
  let vars := row_set_vars(es)
  let head := if List::length(labels) == 0 && List::length(vars) > 0 { "" } else {
    Text::concat_all(Cons("{", Cons(surface_join(labels, ", "), Cons("}", Nil))))
  }
  row_set_union(head, vars)
}

pub fn row_set_is_var(e: Text): Bool {
  Text::len(e) > 0 && Text::slice_or_empty(e, 0, 1) == "|"
}

pub fn row_set_labels(es: List(Text)): List(Text) {
  match es {
    Nil => Nil
    Cons(e, rest) => if row_set_is_var(e) { row_set_labels(rest) } else { Cons(e, row_set_labels(rest)) }
  }
}

pub fn row_set_vars(es: List(Text)): List(Text) {
  match es {
    Nil => Nil
    Cons(e, rest) => if row_set_is_var(e) {
      Cons(Text::slice_or_empty(e, 1, Text::len(e)), row_set_vars(rest))
    } else { row_set_vars(rest) }
  }
}

pub fn row_set_union(out: Text, vars: List(Text)): Text {
  match vars {
    Nil => out
    Cons(v, rest) => row_set_union(if out == "" { v } else { Text::concat_all(Cons(out, Cons(" ∪ ", Cons(v, Nil)))) }, rest)
  }
}

// Where `^` marks a row entry, when it does.
pub fn row_entry_unused(e: RowEntry): Option(SurfaceSpan) {
  match e {
    EntryName(^n, unused) => unused
    EntryApplied(^n, ^args, ^universal, ^forall, unused) => unused
  }
}

mutual {
  // An entry as it is shown: `res`, `|e`, `res(Pos)`, `∀ A. res(A)`. Only
  // what it is shown as; nothing reads an entry back from it.
  pub fn row_entry_text(e: RowEntry): Text {
    match e {
      EntryName(n, ^unused) => n
      EntryApplied(n, args, universal, forall, ^unused) => {
        let entry := ⊢ Text from match args {
          Nil => n
          Cons(^a, ^more) => Text::concat_all(
            Cons(n, Cons("(", Cons(surface_join(row_args_text(args), ", "), Cons(")", Nil))))
          )
        }
        ⊢ Text from match universal {
          true => Text::concat_all(
            Cons("∀ ", Cons(surface_join(forall, ", "), Cons(". ", Cons(entry, Nil))))
          )
          false => entry
        }
      }
    }
  }

  pub fn row_entries_text(es: List(RowEntry)): List(Text) {
    match es {
      Nil => Nil
      Cons(e, rest) => Cons(row_entry_text(e), row_entries_text(rest))
    }
  }

  // A type argument as it is shown, as the Rust reader prints a term: `outer`
  // is the binding power the place asks of it, and what is looser than that is
  // in parentheses.
  pub fn row_arg_text(t: SurfaceTerm): Text {
    row_arg_at(t, 0)
  }

  pub fn row_arg_at(t: SurfaceTerm, outer: Nat): Text {
    match t {
      SurfaceTermIndexedMk(k, ^start, ^end, ^occurrence) => row_arg_kind_text(k, outer)
    }
  }

  // A name made by a macro carries its scopes after a mark, which is printed as `@`.
  pub fn row_arg_name(name: Text): Text {
    match text_find(name, text_code_point(1), 0) {
      None => name
      Some(i) => Text::concat_all(
        Cons(Text::slice_or_empty(name, 0, i), Cons("@", Cons(Text::slice_or_empty(name, i + 1, Text::len(name)), Nil)))
      )
    }
  }

  pub fn row_arg_kind_text(k: SurfaceKind, outer: Nat): Text {
    match k {
      SkVar(n) => row_arg_name(surface_name_text(n))
      SkNat(d) => d
      SkFloat(d) => d
      SkBool(b) => if b { "true" } else { "false" }
      SkApp(f, args) => if row_arg_text(f) == surface_pair_name() {
        row_paren_if(outer > 0, surface_join(row_product_members(args), " × "))
      } else {
        Text::concat_all(
          Cons(row_arg_at(f, 8), Cons("(", Cons(surface_join(row_args_text(args), ", "), Cons(")", Nil))))
        )
      }
      SkRow(es) => Text::concat("!", row_set_text(row_entries_text(es)))
      // `(x: A, B) -> R ! {e}`: a parameter's name stands unless it is the one
      // the checker gave a `_`.
      SkPi(params, result, effects) => row_paren_if(
        outer > 0,
        Text::concat_all(
          Cons(
            "(",
            Cons(
              surface_join(row_params_text(params), ", "),
              Cons(
                ") -> ",
                Cons(
                  row_arg_at(result, 0),
                  Cons(row_pi_effects_text(effects), Nil)
                )
              )
            )
          )
        )
      )
      SkExists(binder, domain, body, ^unused) => row_paren_if(
        outer > 0,
        Text::concat_all(
          Cons("∃ ", Cons(binder, Cons(": ", Cons(row_arg_at(domain, 0), Cons(". ", Cons(row_arg_at(body, 0), Nil))))))
        )
      )
      SkUnion(parts) => row_paren_if(outer > 0, surface_join(row_union_members(parts), " | "))
      SkTagged(tag, value) => Text::concat_all(Cons("@", Cons(tag, Cons(" ", Cons(row_arg_at(value, 7), Nil)))))
      _ => "?"
    }
  }

  // The members of `A × B × C`, the `Pair`s nested to the right: a member that
  // is itself a product is in parentheses.
  // ` ! {e}` after the result of a function type, when a row is written.
  pub fn row_pi_effects_text(o: Option(List(RowEntry))): Text {
    match o {
      None => ""
      Some(es) => Text::concat(" ! ", row_set_text(row_entries_text(es)))
    }
  }

  pub fn row_product_members(args: List(SurfaceTerm)): List(Text) {
    match args {
      Nil => Nil
      Cons(a, rest) => Cons(row_arg_at(a, 1), row_product_tail(rest))
    }
  }

  // What follows the first member: the second, or the members of the product
  // it is.
  pub fn row_product_tail(rest: List(SurfaceTerm)): List(Text) {
    match rest {
      Nil => Nil
      Cons(b, ^more) => row_product_member(b, row_arg_at(b, 1))
    }
  }

  // The members of `b` when it is a product, else `whole`, `b` as written.
  pub fn row_product_member(b: SurfaceTerm, whole: Text): List(Text) {
    match b {
      SurfaceTermIndexedMk(k, ^start, ^end, ^occurrence) => row_product_kind(k, whole)
    }
  }

  pub fn row_product_kind(k: SurfaceKind, whole: Text): List(Text) {
    match k {
      SkApp(f, inner) => if row_arg_text(f) == surface_pair_name() {
        row_product_members(inner)
      } else {
        Cons(whole, Nil)
      }
      _ => Cons(whole, Nil)
    }
  }

  pub fn row_union_members(ts: List(SurfaceTerm)): List(Text) {
    match ts {
      Nil => Nil
      Cons(t, rest) => Cons(row_arg_at(t, 1), row_union_members(rest))
    }
  }

  pub fn row_params_text(ps: List(SurfaceParam)): List(Text) {
    match ps {
      Nil => Nil
      Cons(p, rest) => Cons(row_param_text(p), row_params_text(rest))
    }
  }

  pub fn row_param_text(p: SurfaceParam): Text {
    match p {
      SurfaceParamMk(name, ty, _) => ⊢ Text from match name {
        None => row_arg_at(ty, 0)
        Some(n) => if Text::starts_with(n, "_'") {
          row_arg_at(ty, 0)
        } else {
          Text::concat_all(Cons(n, Cons(": ", Cons(row_arg_at(ty, 0), Nil))))
        }
      }
    }
  }

  pub fn row_args_text(ts: List(SurfaceTerm)): List(Text) {
    match ts {
      Nil => Nil
      Cons(t, rest) => Cons(row_arg_text(t), row_args_text(rest))
    }
  }
}

pub fn row_entry_in(x: RowEntry, xs: List(RowEntry)): Bool {
  surface_text_in(row_entry_text(x), row_entries_text(xs))
}

// `seen`, then the entries of `new` it does not have yet, in order.
pub fn row_append_new(seen: List(RowEntry), new: List(RowEntry)): List(RowEntry) {
  match new {
    Nil => seen
    Cons(x, rest) => ⊢ List(RowEntry) from match row_entry_in(x, seen) {
      true => row_append_new(seen, rest)
      false => row_append_new(List::append(seen, Cons(x, Nil)), rest)
    }
  }
}

// The host's operation that runs a budget: `budget` counts steps and
// `budget_memory` cells. It is also the effect a row names for it.
pub fn surface_budget_operation(memory: Bool): Text {
  match memory {
    true => "budget_memory"
    false => "budget"
  }
}

// Why a `perform budget(…)` that does not give a count and a function is refused.
pub fn surface_budget_refused(memory: Bool): Text {
  Text::concat_all([
    "`perform ",
    surface_budget_operation(memory),
    "(n, f)` takes the most ",
    ⊢ Text from match memory {
      true => "cells"
      false => "steps"
    },
    " and the function of no parameter to run"
  ])
}

// The body of a `budget` runs where the budget is written, so a written
// `() => e` is read as `e`, and any other function `f` as the call `f()`.
pub fn surface_budget_body(f: SurfaceTerm, span: SurfaceSpan): SurfaceTerm {
  match f.kind {
    SkLam(params, body, ^types, ^unused) => ⊢ SurfaceTerm from match params {
      Nil => body
      Cons(^p, ^ps) => surface_term_at(SkApp(f, Nil), span)
    }
    _ => surface_term_at(SkApp(f, Nil), span)
  }
}

pub(open) inductive SurfaceLamParam: Type {
  Mk(name: Text, r#borrow: Option(Bool), unused: Option(SurfaceSpan)): SurfaceLamParam
}

// A parameter is a name. A borrow is written in its type, `(x: &T) => e`,
// or comes from the type the closure is expected to have; the binder form
// `(&x) => e` is not a parameter.
pub fn surface_lam_param_of(t: SurfaceTerm): Option(SurfaceLamParam) {
  match t.kind {
    SkVar(name) => Some(SurfaceLamParam {
      name: surface_name_text(name),
      r#borrow: None,
      unused: None
    })
    // `(x: T) => body`: the parameter `x`, its type read with the lambda's.
    SkAscribe(value, ^ty) => ⊢ Option(SurfaceLamParam) from match value.kind {
      SkVar(name) => Some(SurfaceLamParam {
        name: surface_name_text(name),
        r#borrow: None,
        unused: None
      })
      _ => None
    }
    // `(x: T) => e`: the one typed item reads as `#ascribe(T, x)`.
    SkApp(f, args) => ⊢ Option(SurfaceLamParam) from match surface_ascribed_name(f, args) {
      Some(name) => Some(SurfaceLamParam { name: name, r#borrow: None, unused: None })
      None => None
    }
    _ => None
  }
}

pub fn surface_param_unused(ps: List(SurfaceLamParam)): List(Option(SurfaceSpan)) {
  match ps {
    Nil => Nil
    Cons(p, rest) => Cons(p.unused, surface_param_unused(rest))
  }
}

pub fn surface_any_unused(us: List(Option(SurfaceSpan))): Bool {
  match us {
    Nil => false
    Cons(u, rest) => ⊢ Bool from match u {
      Some(_) => true
      None => surface_any_unused(rest)
    }
  }
}

pub fn surface_lam_unused_written(us: List(Option(SurfaceSpan))): List(Option(SurfaceSpan)) {
  if surface_any_unused(us) { us } else { Nil }
}

// The head of `#rc(e)`, which stands for `&rc e`: a name no declaration has,
// so a reader of the surface that does not know it refuses it as unbound.
pub fn surface_rc_name(): Text { "#rc" }

// Whether `function(e, rest…)` is `#rc(e)`.
pub fn surface_is_rc(function: SurfaceTerm, rest: List(SurfaceTerm)): Bool {
  match rest {
    Nil => match function.kind {
      SkVar(head) => surface_name_text(head) == surface_rc_name()
      _ => false
    }
    Cons(more, others) => false
  }
}

// `x` of `#ascribe(T, x)`.
pub fn surface_ascribed_name(f: SurfaceTerm, args: List(SurfaceTerm)): Option(Text) {
  match f.kind {
    SkVar(head) => if surface_name_text(head) == "#ascribe" {
      ⊢ Option(Text) from match args {
        Cons(^t, rest) => ⊢ Option(Text) from match rest {
          Cons(x, ^more) => ⊢ Option(Text) from match x.kind {
            SkVar(name) => Some(surface_name_text(name))
            _ => None
          }
          Nil => None
        }
        Nil => None
      }
    } else {
      None
    }
    _ => None
  }
}

// The borrow a written type gives a parameter: `&T` borrows, `&mut T`
// borrows mutably.
pub fn surface_type_borrow(t: SurfaceTerm): Option(Bool) {
  match t.kind {
    SkBorrow(mutable, ^mutable_orig, ^inner) => Some(mutable)
    _ => None
  }
}

// A `&mut` binding writes through to what it borrows and is never rebound, so
// it cannot be a `var`.
pub fn surface_var_type(ty: Option(SurfaceTerm)): Option(SurfaceTerm) {
  match ty {
    None => None
    Some(t) => ⊢ Option(SurfaceTerm) from match surface_type_borrow(t) {
      Some(m) => if m {
        Some(surface_term_mk(SkOther("`var x: &mut T`: a `&mut` binding cannot be `var`"), t.start, t.end))
      } else { Some(t) }
      None => Some(t)
    }
  }
}

// The type a parameter is read with: `T` for `x: &T` and `x: &mut T`.
// `x: &orig T` keeps its type whole: the mark says it borrows.
pub fn surface_unborrowed(t: SurfaceTerm): SurfaceTerm {
  match t.kind {
    SkBorrow(^mutable, original, inner) => if original { t } else { inner }
    _ => t
  }
}

pub fn surface_unborrowed_all(ts: List(SurfaceTerm)): List(SurfaceTerm) {
  match ts {
    Nil => Nil
    Cons(t, rest) => Cons(surface_unborrowed(t), surface_unborrowed_all(rest))
  }
}

// Closure parameters with the borrows their written types give.
pub fn surface_params_typed(
  ps: List(SurfaceLamParam),
  types: List(SurfaceTerm)
): List(SurfaceLamParam) {
  match ps {
    Nil => Nil
    Cons(p, rest) => ⊢ List(SurfaceLamParam) from match types {
      Nil => ps
      Cons(t, more) => Cons(
        SurfaceLamParam {
          name: p.name,
          r#borrow: surface_type_borrow(t),
          unused: p.unused
        },
        surface_params_typed(rest, more)
      )
    }
  }
}

// A function's borrows: each from its parameter's type.
pub fn surface_decl_borrows(
  binders: List(Option(Bool)),
  types: List(Option(SurfaceTerm))
): List(Option(Bool)) {
  match types {
    Nil => Nil
    Cons(t, rest) => ⊢ List(Option(Bool)) from match binders {
      // `&x: T`: the borrow is the binder's, and the type is an error.
      Cons(Some(mutable), more) => Cons(Some(mutable), surface_decl_borrows(more, rest))
      _ => Cons(
        ⊢ Option(Bool) from match t {
          Some(ty) => surface_type_borrow(ty)
          None => None
        },
        surface_decl_borrows(List::drop(1, binders), rest)
      )
    }
  }
}

// A function's parameter types, each without its borrow. A parameter
// written `&x: T` has an error for its type.
pub fn surface_decl_types(
  binders: List(Option(Bool)),
  types: List(Option(SurfaceTerm)),
  spans: List(SurfaceSpan)
): List(Option(SurfaceTerm)) {
  match types {
    Nil => Nil
    Cons(t, rest) => ⊢ List(Option(SurfaceTerm)) from match binders {
      Nil => Cons(surface_decl_type(None, t, surface_head_span(spans)), surface_decl_types(Nil, rest, List::drop(1, spans)))
      Cons(b, more) => Cons(
        surface_decl_type(b, t, surface_head_span(spans)),
        surface_decl_types(more, rest, List::drop(1, spans))
      )
    }
  }
}

pub fn surface_head_span(spans: List(SurfaceSpan)): SurfaceSpan {
  match spans {
    Nil => SurfaceSpan { start: 0, end: 0 }
    Cons(s, ^rest) => s
  }
}

// The binder form `&x: T` has an error for its type, over the parameter.
pub fn surface_decl_type(binder: Option(Bool), t: Option(SurfaceTerm), span: SurfaceSpan): Option(SurfaceTerm) {
  match binder {
    Some(mutable) => Some(surface_term_at(
      SkOther(if mutable {
        "`&mut x: T` is not a parameter: write `x: &mut T`"
      } else {
        "`&x: T` is not a parameter: write `x: &T`"
      }),
      span
    ))
    None => ⊢ Option(SurfaceTerm) from match t {
      Some(ty) => Some(surface_unborrowed(ty))
      None => None
    }
  }
}

pub fn surface_params(args: List(SurfaceTerm)): Option(List(SurfaceLamParam)) {
  match args {
    Nil => Some(Nil)
    Cons(a, rest) => ⊢ Option(List(SurfaceLamParam)) from match surface_lam_param_of(a) {
      None => None
      Some(p) => ⊢ Option(List(SurfaceLamParam)) from match surface_params(rest) {
        None => None
        Some(ps) => Some(Cons(p, ps))
      }
    }
  }
}

pub fn surface_param_names(ps: List(SurfaceLamParam)): List(Text) {
  match ps {
    Nil => Nil
    Cons(p, rest) => Cons(p.name, surface_param_names(rest))
  }
}

pub fn surface_param_borrows(ps: List(SurfaceLamParam)): List(Option(Bool)) {
  match ps {
    Nil => Nil
    Cons(p, rest) => Cons(p.r#borrow, surface_param_borrows(rest))
  }
}

pub fn surface_no_borrows(bs: List(Option(Bool))): Bool {
  match bs {
    Nil => true
    Cons(b, rest) => ⊢ Bool from match b {
      None => surface_no_borrows(rest)
      Some(^x) => false
    }
  }
}

// `params => body`, as a lambda that borrows when a parameter does.
pub fn surface_lambda_of(
  ps: List(SurfaceLamParam),
  types: List(SurfaceTerm),
  body: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  let unused := surface_lam_unused_written(surface_param_unused(ps))
  match surface_no_borrows(surface_param_borrows(ps)) {
    true => surface_term_at(
      SkLam(surface_param_names(ps), body, surface_lam_written(types), unused),
      span
    )
    false => surface_term_at(
      SkBorrowLam(
        surface_param_borrows(ps),
        surface_term_at(
          SkLam(surface_param_names(ps), body, surface_lam_written(types), unused),
          span
        )
      ),
      span
    )
  }
}

pub fn surface_any_typed(types: List(SurfaceTerm)): Bool {
  match types {
    Nil => false
    Cons(t, rest) => ⊢ Bool from match t.kind {
      SkHole(n) => n != "#untyped" || surface_any_typed(rest)
      _ => true
    }
  }
}

// The types written on a lambda's parameters, as `SkLam` keeps them: empty
// when none is, else one for each parameter.
pub fn surface_lam_written(types: List(SurfaceTerm)): List(Option(SurfaceTerm)) {
  if surface_any_typed(types) { surface_lam_written_each(types) } else { Nil }
}

pub fn surface_lam_written_each(types: List(SurfaceTerm)): List(Option(SurfaceTerm)) {
  match types {
    Nil => Nil
    Cons(t, rest) => Cons(
      ⊢ Option(SurfaceTerm) from match t.kind {
        SkHole(n) => if n == "#untyped" { None } else { Some(t) }
        _ => Some(t)
      },
      surface_lam_written_each(rest)
    )
  }
}

// `(a)` is `a`; `()` is the unit, and `(a, b)` no term (`surface_paren_list`).
pub fn surface_paren_of(items: List(SurfaceTerm), has_comma: Bool, span: SurfaceSpan, ty: Option(SurfaceTerm)): SurfaceTerm {
  match items {
    Cons(only, rest) => ⊢ SurfaceTerm from match rest {
      Nil => ⊢ SurfaceTerm from match has_comma {
        true => surface_term_at(SkOther(surface_paren_list()), span)
        false => ⊢ SurfaceTerm from match ty {
          None => only
          Some(t) => surface_term_at(SkApp(surface_term_at(SkVar(NameSpelled("#ascribe")), span), [t, only]), span)
        }
      }
      Cons(^x, ^y) => surface_term_at(SkOther(surface_paren_list()), span)
    }
    Nil => surface_star(span)
  }
}

// `#(p, q, r)` as a pattern: `Pair::Mk` nested to the right, `#(p, #(q, r))`,
// as `[x, ..rest]` is `Cons`. A product needs two members.
pub fn surface_product_ctor(): Text { surface_pair_mk_name() }
// `#(p, q, …)` as written: `#()` is the prelude's `Star`, and one member alone
// is not a product.
pub fn surface_product_written_pattern(members: List(SurfacePattern)): SurfacePattern {
  match members {
    Nil => PtCtor(NameSpelled(surface_star_name()), Nil)
    Cons(^first, rest) => ⊢ SurfacePattern from match rest {
      Nil => PtOther("one-member product")
      Cons(^second, ^more) => surface_product_pattern(members)
    }
  }
}

pub fn surface_product_pattern(members: List(SurfacePattern)): SurfacePattern {
  match members {
    Nil => PtOther("a product of fewer than two members")
    Cons(first, rest) => ⊢ SurfacePattern from match rest {
      Nil => PtOther("a product of fewer than two members")
      Cons(^second, more) => ⊢ SurfacePattern from match more {
        Nil => PtCtor(NameSpelled(surface_product_ctor()), members)
        Cons(^unused0, ^unused1) => PtCtor(
          NameSpelled(surface_product_ctor()),
          Cons(first, Cons(surface_product_pattern(rest), Nil))
        )
      }
    }
  }
}

pub fn surface_stmt_value(s: SurfaceStmt): Option(SurfaceTerm) {
  match s {
    StExpr(e) => Some(e)
    _ => None
  }
}

// A block holding one expression is that expression.
pub fn surface_block_of(read: List(SurfaceStmt), span: SurfaceSpan): SurfaceTerm {
  match read {
    Cons(only, rest) => ⊢ SurfaceTerm from match rest {
      Nil => ⊢ SurfaceTerm from match surface_stmt_value(only) {
        Some(e) => e
        None => surface_term_at(SkBlock(read), span)
      }
      Cons(^x, ^y) => surface_term_at(SkBlock(read), span)
    }
    Nil => surface_term_at(SkBlock(read), span)
  }
}

// `f` starting at `start`: an `extern` block's function takes its `pub` without
// starting at it, as the Rust reader reads it.
pub fn surface_fn_start_at(f: SurfaceFn, start: Nat): SurfaceFn {
  match f {
    SurfaceFnMk(name, generics, bounds, params, r#borrows, ParamTypes, result, effects, Wheres, ^s, end, body, lends, generic_types, bound_starts, visibility, row_hole, unused, unused_generics, unused_params) => SurfaceFnMk(name, generics, bounds, params, r#borrows, ParamTypes, result, effects, Wheres, start, end, body, lends, generic_types, bound_starts, visibility, row_hole, unused, unused_generics, unused_params)
  }
}

pub fn surface_visible_from(at: SurfaceSpan, word: Text, stmt: SurfaceStmt): SurfaceStmt {
  match stmt {
    StFn(SurfaceFnMk(name, generics, bounds, params, r#borrows, ParamTypes, result, effects, Wheres, start, end, body, lends, generic_types, bound_starts, ^visibility, row_hole, unused, unused_generics, unused_params)) => StFn(
      SurfaceFnMk(name, generics, bounds, params, r#borrows, ParamTypes, result, effects, Wheres, Nat::min(at.start, start), end, body, lends, generic_types, bound_starts, if word == "pub(open) " { VisOpen } else { VisPub }, row_hole, unused, unused_generics, unused_params)
    )
    StTheorem(SurfaceTheoremMk(name, Implicit, params, ty, body, start, end, unused, unused_params, ^t_vis)) => StTheorem(
      SurfaceTheoremMk(name, Implicit, params, ty, body, Nat::min(at.start, start), end, unused, unused_params, if word == "pub(open) " { VisOpen } else { VisPub })
    )
    StDef(SurfaceTheoremMk(name, Implicit, params, ty, body, start, end, unused, unused_params, ^t_vis)) => StDef(
      SurfaceTheoremMk(name, Implicit, params, ty, body, Nat::min(at.start, start), end, unused, unused_params, if word == "pub(open) " { VisOpen } else { VisPub })
    )
    StInductive(SurfaceInductiveMk(name, params, Sort, constructors, start, end, ^visibility)) => StInductive(
      SurfaceInductiveMk(name, params, Sort, constructors, Nat::min(at.start, start), end, if word == "pub(open) " { VisOpen } else { VisPub })
    )
    StStruct(SurfaceDataMk(kind, name, generics, constructors, start, end, coerce_level, coerce_field, ^visibility, unused_generics, rows)) => StStruct(
      SurfaceDataMk(kind, name, generics, constructors, Nat::min(at.start, start), end, coerce_level, coerce_field, if word == "pub(open) " { VisOpen } else { VisPub }, unused_generics, rows)
    )
    StEnum(SurfaceDataMk(kind, name, generics, constructors, start, end, coerce_level, coerce_field, ^visibility, unused_generics, rows)) => StEnum(
      SurfaceDataMk(kind, name, generics, constructors, Nat::min(at.start, start), end, coerce_level, coerce_field, if word == "pub(open) " { VisOpen } else { VisPub }, unused_generics, rows)
    )
    StEffect(SurfaceEffectMk(name, generics, params, result, r#resume, start, end, set, unused_generics, bounds, ^e_vis, rows)) => StEffect(
      SurfaceEffectMk(name, generics, params, result, r#resume, Nat::min(at.start, start), end, set, unused_generics, bounds, if word == "pub(open) " { VisOpen } else { VisPub }, rows)
    )
    StClass(SurfaceClassMk(name, Param, arity, bound, Methods, Laws, start, end, parameters, proof, parents, unused_parameters, ^c_vis)) => StClass(
      SurfaceClassMk(name, Param, arity, bound, Methods, Laws, Nat::min(at.start, start), end, parameters, proof, parents, unused_parameters, if word == "pub(open) " { VisOpen } else { VisPub })
    )
    // A module takes `pub`; `pub(open)` before it declares nothing it could open.
    StModule(name, ^visibility, items, start, end) => if word == "pub(open) " {
      StOther(Text::concat(word, "before a statement that declares nothing"), at.start, at.end)
    } else {
      StModule(name, VisPub, items, Nat::min(at.start, start), end)
    }
    StAttributed(^name, ^arg, Generates, inner) => ⊢ SurfaceStmt from match surface_visible_from(
      at,
      word,
      inner
    ) {
      StOther(^what, ^s, ^e) => StOther(
        Text::concat(word, "before a statement that declares nothing"),
        at.start,
        at.end
      )
      StLoop(^st_body, ^s, ^e) => StOther(
        Text::concat(word, "before a statement that declares nothing"),
        at.start,
        at.end
      )
      StFor(^for_pat, ^for_src, ^st_body, ^s, ^e) => StOther(
        Text::concat(word, "before a statement that declares nothing"),
        at.start,
        at.end
      )
      StBreak(^st_value, ^s, ^e) => StOther(
        Text::concat(word, "before a statement that declares nothing"),
        at.start,
        at.end
      )
      StContinue(^s, ^e) => StOther(
        Text::concat(word, "before a statement that declares nothing"),
        at.start,
        at.end
      )
      _ => stmt
    }
    _ => StOther(Text::concat(word, "before a statement that declares nothing"), at.start, at.end)
  }
}
pub fn surface_parameter_vars(
  parameters: List(SurfaceNamed),
  start: Nat,
  end: Nat
): List(SurfaceTerm) {
  match parameters {
    Nil => Nil
    Cons(parameter, rest) => Cons(
      surface_var(parameter.name, SurfaceSpan { start: start, end: end }),
      surface_parameter_vars(rest, start, end)
    )
  }
}

pub fn surface_class_tail_vars(
  parameters: List(SurfaceNamed),
  start: Nat,
  end: Nat
): List(SurfaceTerm) {
  match parameters {
    Nil => Nil
    Cons(^first, rest) => surface_parameter_vars(rest, start, end)
  }
}

pub fn surface_type_generic(): SurfaceTerm {
  surface_var("Type", SurfaceSpan { start: 0, end: 0 })
}

pub fn surface_generic_named(names: List(Text), types: List(SurfaceTerm)): List(SurfaceNamed) {
  match names {
    Nil => Nil
    Cons(name, rest) => ⊢ List(SurfaceNamed) from match types {
      Nil => Cons(
        SurfaceNamed { name: name, ty: surface_type_generic() },
        surface_generic_named(rest, Nil)
      )
      Cons(ty, more) => Cons(SurfaceNamed { name: name, ty: ty }, surface_generic_named(rest, more))
    }
  }
}

pub fn surface_type_generics(names: List(Text)): List(SurfaceTerm) {
  match names {
    Nil => Nil
    Cons(^name, rest) => Cons(surface_type_generic(), surface_type_generics(rest))
  }
}

pub fn surface_named_types(items: List(SurfaceNamed)): List(SurfaceTerm) {
  match items {
    Nil => Nil
    Cons(item, rest) => Cons(item.ty, surface_named_types(rest))
  }
}

pub fn surface_named_names(xs: List(SurfaceNamed)): List(Text) {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(x.name, surface_named_names(rest))
  }
}

pub(open) inductive SurfaceBounds: Type {
  Mk(names: List(Text), bounds: List(Option(Text))): SurfaceBounds
}

// `Type` or `Type(u)` alone is affine, as an unwritten bound is.
pub fn surface_sort_alone(t: Text): Bool {
  t == "Type" || Text::slice_or_empty(t, 0, 5) == "Type("
}

// The checker's bound word for a universe name: `Shared` is `shared`, `Type` is `affine`.
pub fn surface_kind_word(t: Text): Option(Text) {
  match t == "Copy" {
    true => Some("copy")
    false => ⊢ Option(Text) from match t == "Shared" {
      true => Some("shared")
      false => ⊢ Option(Text) from match t == "Linear" {
        true => Some("linear")
        false => ⊢ Option(Text) from match t == "Type" {
          true => Some("affine")
          false => None
        }
      }
    }
  }
}

// A kind as the checker's bound string, the whitespace dropped: `Shared` is `shared`,
// `(Shared) -> Shared` is `(shared)->shared`; any other bound is kept as written.
// A kind word, or one a `quote` splices (`$Shared`), which keeps its `$`.
pub fn surface_spliced_kind_word(t: Text): Option(Text) {
  match Text::slice_or_empty(t, 0, 1) == "$" {
    true => ⊢ Option(Text) from match surface_kind_word(Text::slice_or_empty(t, 1, Text::len(t))) {
      Some(w) => Some(Text::concat("$", w))
      None => None
    }
    false => surface_kind_word(t)
  }
}

pub fn surface_kind_bound(s: Text): Text {
  match surface_kind_word(s) {
    Some(w) => w
    None => ⊢ Text from match Text::slice_or_empty(s, 0, 1) == "(" {
      false => s
      true => ⊢ Text from match text_find(s, ")->", 0) {
        None => s
        Some(i) => ⊢ Text from match surface_spliced_kind_word(Text::slice_or_empty(s, 1, i)) {
          None => s
          Some(a) => ⊢ Text from match surface_spliced_kind_word(Text::slice_or_empty(s, i + 3, Text::len(s))) {
            None => s
            Some(r) => Text::concat_all(Cons("(", Cons(a, Cons(")->", Cons(r, Nil)))))
          }
        }
      }
    }
  }
}

// A word of a bound beside `+`: a universe name, or `NoBorrow` as `noborrow`.
pub fn surface_bound_word(t: Text): Option(Text) {
  match t == "NoBorrow" {
    true => Some("noborrow")
    false => surface_kind_word(t)
  }
}

pub fn surface_bound_words(ws: List(Text)): Option(List(Text)) {
  match ws {
    Nil => Some(Nil)
    Cons(w, rest) => ⊢ Option(List(Text)) from match surface_bound_word(w) {
      None => None
      Some(x) => ⊢ Option(List(Text)) from match surface_bound_words(rest) {
        None => None
        Some(xs) => Some(Cons(x, xs))
      }
    }
  }
}

// A bound as the checker's bound string: `NoBorrow` alone is `noborrow`, and
// universe names joined by `+` are their words (`Shared + NoBorrow` is
// `shared+noborrow`); any other bound is read by `surface_kind_bound`.
pub fn surface_generic_bound(s: Text): Text {
  match Text::slice_or_empty(s, 0, 1) == "$" {
    // `$Shared`, a bound a `quote` splices: the word after the `$` is read as the Rust reader does.
    true => ⊢ Text from match surface_bound_word(Text::slice_or_empty(s, 1, Text::len(s))) {
      Some(w) => Text::concat("$", w)
      None => surface_generic_bound_written(s)
    }
    false => surface_generic_bound_written(s)
  }
}

pub fn surface_generic_bound_written(s: Text): Text {
  match text_find(s, "+", 0) {
    None => ⊢ Text from match s == "NoBorrow" {
      true => "noborrow"
      false => surface_kind_bound(s)
    }
    Some(^i) => ⊢ Text from match surface_bound_words(text_split(s, "+")) {
      Some(ws) => text_join(ws, "+")
      None => s
    }
  }
}

// The kernel's reading of a kind, whose universe names are all `Type`: `Shared` is `Type`,
// `(Shared) -> Shared` is `(Type) -> Type`; any other written type is none.
mutual {
// A written kind as a kind: `Copy`, `Shared`, `Linear` and `NoBorrow` are `Type`, in an
// arrow's parts too, as the Rust reader's `kind_term` reads them.
pub fn surface_kind_read(k: Nat, t: SurfaceTerm): SurfaceTerm {
  match k {
    Zero => t
    Succ(j) => ⊢ SurfaceTerm from match t.kind {
      SkVar(n) => ⊢ SurfaceTerm from match surface_name_text(n) == "Copy" || surface_name_text(n) == "Shared" || surface_name_text(n) == "Linear" || surface_name_text(n) == "NoBorrow" {
        true => surface_term_mk(SkVar(NameSpelled("Type")), t.start, t.end)
        false => t
      }
      SkPi(params, result, effects) => surface_term_mk(
        SkPi(surface_kind_params(j, params), surface_kind_read(j, result), effects),
        t.start,
        t.end
      )
      _ => t
    }
  }
}

pub fn surface_kind_params(k: Nat, ps: List(SurfaceParam)): List(SurfaceParam) {
  match k {
    Zero => ps
    Succ(j) => ⊢ List(SurfaceParam) from match ps {
      Nil => Nil
      Cons(p, rest) => Cons(
        SurfaceParam { name: p.name, ty: surface_kind_read(j, p.ty), unused: p.unused },
        surface_kind_params(j, rest)
      )
    }
  }
}
}

// No start for each of `ts`: generics a declaration takes from around it.
pub fn surface_no_starts(ts: List(SurfaceTerm)): List(Option(Nat)) {
  match ts {
    Nil => Nil
    Cons(^t, rest) => Cons(None, surface_no_starts(rest))
  }
}
pub fn surface_head_or_empty(names: List(Text)): Text {
  match names {
    Nil => ""
    Cons(n, ^rest) => n
  }
}

pub fn surface_first_bound(bounds: List(Option(Text))): Option(Text) {
  match bounds {
    Nil => None
    Cons(b, ^rest) => b
  }
}

pub fn surface_digits_in(k: Nat, t: Text, at: Nat, acc: Nat, limit: Nat): Option(Nat) {
  match k {
    Zero => Some(acc)
    Succ(j) => ⊢ Option(Nat) from match at >= Text::len(t) {
      true => Some(acc)
      false => ⊢ Option(Nat) from match text_digit(Text::byte_value(t, at)) {
        None => None
        Some(d) => ⊢ Option(Nat) from match acc * 10 + d > limit {
          true => None
          false => surface_digits_in(j, t, at + 1, acc * 10 + d, limit)
        }
      }
    }
  }
}

// The largest magnitude of an `i64` with the sign `t` starts with.
pub fn surface_int_limit(t: Text): Nat {
  match Text::byte_value(t, 0) == 45 {
    true => 9223372036854775807 + 1
    false => 9223372036854775807
  }
}

// `str::parse::<i64>`: a sign, then digits, as the sign and the magnitude.
pub fn surface_parse_int(t: Text): Option(Bool × Nat) {
  match Text::len(t) == 0 {
    true => None
    false => ⊢ Option(Bool × Nat) from match Text::byte_value(
      t,
      0
    ) == 45 || Text::byte_value(t, 0) == 43 {
      true => ⊢ Option(Bool × Nat) from match Text::len(t) == 1 {
        true => None
        false => ⊢ Option(Bool × Nat) from match surface_digits_in(
          Text::len(t),
          t,
          1,
          0,
          surface_int_limit(t)
        ) {
          Some(m) => Some(#(Text::byte_value(t, 0) == 45, m))
          None => None
        }
      }
      false => ⊢ Option(Bool × Nat) from match surface_digits_in(
        Text::len(t) + 1,
        t,
        0,
        0,
        9223372036854775807
      ) {
        Some(m) => Some(#(false, m))
        None => None
      }
    }
  }
}

pub(open) inductive SurfaceRule: Type {
  RuleType: SurfaceRule
  RuleAngle: SurfaceRule
  RuleRow: SurfaceRule
  RuleExpr: SurfaceRule
  RulePostfix: SurfaceRule
  RulePrimary: SurfaceRule
  RulePathExpr: SurfaceRule
  RuleNumber: SurfaceRule
  RuleHoleExpr: SurfaceRule
  RuleText: SurfaceRule
  RuleTrue: SurfaceRule
  RuleFalse: SurfaceRule
  RuleParen: SurfaceRule
  RuleListLit: SurfaceRule
  RuleBrace: SurfaceRule
  RuleArmBody: SurfaceRule
  RuleStepExpr: SurfaceRule
  RuleAnonRecord: SurfaceRule
  RuleBlock: SurfaceRule
  RuleIfExpr: SurfaceRule
  RulePerformExpr: SurfaceRule
  RuleHandleExpr: SurfaceRule
  RuleMatchExpr: SurfaceRule
  RuleSyntaxLit: SurfaceRule
  RuleMacroCall: SurfaceRule
  RuleQuoteExpr: SurfaceRule
  RuleSpliceExpr: SurfaceRule
  RuleItem: SurfaceRule
  RuleLetDecl: SurfaceRule
  RuleVarDecl: SurfaceRule
  RuleFnDecl: SurfaceRule
  RuleTheoremDecl: SurfaceRule
  RuleAxiomDecl: SurfaceRule
  RuleDefDecl: SurfaceRule
  RuleMutualDecl: SurfaceRule
  RuleImportDecl: SurfaceRule
  RuleSyntaxDecl: SurfaceRule
  RuleMacroFnDecl: SurfaceRule
  RuleInductiveDecl: SurfaceRule
  RuleEffectDecl: SurfaceRule
  RuleStructDecl: SurfaceRule
  RuleEnumDecl: SurfaceRule
  RuleExternDecl: SurfaceRule
  RuleClassDecl: SurfaceRule
  RuleInstanceDecl: SurfaceRule
  RuleWhileStmt: SurfaceRule
  RuleReturnStmt: SurfaceRule
  RuleExprStmt: SurfaceRule
  RuleNone: SurfaceRule
}

pub fn surface_rule_plain(name: Text): SurfaceRule {
  match name == "Type" || name == "BodyType" || name == "Seq" || name == "Cond" || name == "Operand" || name == "CondOperand" || name == "ArmType" {
    true => RuleType
    false => ⊢ SurfaceRule from match name == "Expr" || name == "AngleExpr" {
      true => RuleExpr
      false => ⊢ SurfaceRule from match name == "Postfix" || name == "CondPostfix" {
        true => RulePostfix
        false => ⊢ SurfaceRule from match name == "Primary" || name == "CondPrimary" {
          true => RulePrimary
          false => ⊢ SurfaceRule from match name == "PathExpr" || name == "CondPath" {
            true => RulePathExpr
            false => ⊢ SurfaceRule from match name == "Number" {
              true => RuleNumber
              false => ⊢ SurfaceRule from match name == "HoleExpr" {
                true => RuleHoleExpr
                false => ⊢ SurfaceRule from match name == "Text" {
                  true => RuleText
                  false => ⊢ SurfaceRule from match name == "True" {
                    true => RuleTrue
                    false => ⊢ SurfaceRule from match name == "False" {
                      true => RuleFalse
                      false => ⊢ SurfaceRule from match name == "Paren" || name == "ProductLit" || name == "CongrExpr" || name == "BoxHole" {
                        true => RuleParen
                        false => ⊢ SurfaceRule from match name == "Brace" {
                          true => RuleBrace
                          false => ⊢ SurfaceRule from match name == "Block" {
                            true => RuleBlock
                            false => ⊢ SurfaceRule from match name == "IfExpr" {
                              true => RuleIfExpr
                              false => ⊢ SurfaceRule from match name == "PerformExpr" {
                                true => RulePerformExpr
                                false => ⊢ SurfaceRule from match name == "HandleExpr" {
                                  true => RuleHandleExpr
                                  false => ⊢ SurfaceRule from match name == "MatchExpr" {
                                    true => RuleMatchExpr
                                    false => ⊢ SurfaceRule from match name == "SyntaxLit" {
                                      true => RuleSyntaxLit
                                      false => ⊢ SurfaceRule from match name == "MacroCall" {
                                        true => RuleMacroCall
                                        false => ⊢ SurfaceRule from match name == "QuoteExpr" {
                                          true => RuleQuoteExpr
                                          false => ⊢ SurfaceRule from match name == "SpliceExpr" {
                                            true => RuleSpliceExpr
                                            false => ⊢ SurfaceRule from match name == "Item" {
                                              true => RuleItem
                                              false => ⊢ SurfaceRule from match name == "LetDecl" {
                                                true => RuleLetDecl
                                                false => ⊢ SurfaceRule from match name == "VarDecl" {
                                                  true => RuleVarDecl
                                                  false => ⊢ SurfaceRule from match name == "FnDecl" {
                                                      true => RuleFnDecl
                                                      false => ⊢ SurfaceRule from match name == "TheoremDecl" {
                                                        true => RuleTheoremDecl
                                                        false => ⊢ SurfaceRule from match name == "AxiomDecl" {
                                                          true => RuleAxiomDecl
                                                          false => ⊢ SurfaceRule from match name == "DefDecl" {
                                                            true => RuleDefDecl
                                                            false => ⊢ SurfaceRule from match name == "MutualDecl" {
                                                              true => RuleMutualDecl
                                                              false => ⊢ SurfaceRule from match name == "ImportDecl" {
                                                                true => RuleImportDecl
                                                                false => ⊢ SurfaceRule from match name == "SyntaxDecl" {
                                                                  true => RuleSyntaxDecl
                                                                  false => ⊢ SurfaceRule from match name == "MacroFnDecl" {
                                                                    true => RuleMacroFnDecl
                                                                    false => ⊢ SurfaceRule from match name == "InductiveDecl" {
                                                                      true => RuleInductiveDecl
                                                                      false => ⊢ SurfaceRule from match name == "EffectDecl" {
                                                                        true => RuleEffectDecl
                                                                        false => ⊢ SurfaceRule from match name == "StructDecl" {
                                                                          true => RuleStructDecl
                                                                          false => ⊢ SurfaceRule from match name == "EnumDecl" {
                                                                            true => RuleEnumDecl
                                                                            false => ⊢ SurfaceRule from match name == "ExternDecl" {
                                                                              true => RuleExternDecl
                                                                              false => ⊢ SurfaceRule from match name == "WhileStmt" {
                                                                                true => RuleWhileStmt
                                                                                false => ⊢ SurfaceRule from match name == "ReturnStmt" {
                                                                                  true => RuleReturnStmt
                                                                                  false => ⊢ SurfaceRule from match name == "ExprStmt" {
                                                                                    true => RuleExprStmt
                                                                                    false => ⊢ SurfaceRule from match name == "ListLit" {
                                                                                      true => RuleListLit
                                                                                      false => ⊢ SurfaceRule from match name == "AngleType" || name == "GenericKind" {
                                                                                        true => RuleAngle
                                                                                        false => ⊢ SurfaceRule from match name == "EffectRow" {
                                                                                          true => RuleRow
                                                                                          false => RuleNone
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub fn surface_rule_special(name: Text): SurfaceRule {
  match name == "ArmBody" {
    true => RuleArmBody
    false => ⊢ SurfaceRule from match name == "ClassDecl" {
      true => RuleClassDecl
      false => ⊢ SurfaceRule from match name == "InstanceDecl" {
        true => RuleInstanceDecl
        false => ⊢ SurfaceRule from match name == "StepExpr" {
          true => RuleStepExpr
          false => ⊢ SurfaceRule from match name == "AnonRecord" {
            true => RuleAnonRecord
            false => surface_rule_plain(name)
          }
        }
      }
    }
  }
}
pub fn surface_rule(name: Text): SurfaceRule {
  surface_rule_special(name)
}

// ---- the readers ------------------------------------------------------------------
//
// `Reader::term` and what it calls in `crates/tauto-surface/src/surface.rs` and
// `crates/tauto-surface/src/surface/program.rs`. Each function is the one of the same name there; they
// call each other, so they share the steps `k`, one taken by each call.

pub(open) inductive SurfaceReturn: Type {
  SurfaceReturnMk(term: SurfaceTerm, effects: Option(List(RowEntry))): SurfaceReturn
}

pub fn surface_out_stmt(name: Text): SurfaceStmt {
  StOther(name, 0, 0)
}

pub fn surface_out_fn(): SurfaceFn {
  SurfaceFn {
    name: "",
    generics: Nil,
    bounds: Nil,
    params: Nil,
    r#borrows: Nil,
    param_types: Nil,
    result: None,
    effects: None,
    wheres: Nil,
    start: 0,
    end: 0,
    body: surface_out("fuel"),
    lends: None,
    generic_types: Nil,
    bound_starts: Nil,
    visibility: VisPrivate,
    row_hole: None,
    unused: None,
    unused_generics: Nil,
    unused_params: Nil
  }
}

pub fn surface_out_theorem(): SurfaceTheorem {
  SurfaceTheorem {
    visibility: VisPrivate,
    name: "",
    implicit: 0,
    params: Nil,
    ty: surface_out("fuel"),
    body: None,
    start: 0,
    end: 0,
    unused: None,
    unused_params: Nil
  }
}

pub fn surface_out_data(): SurfaceData {
  SurfaceData {
    kind: None,
    name: "",
    generics: Nil,
    constructors: Nil,
    start: 0,
    end: 0,
    coerce_level: None,
    coerce_field: 0,
    visibility: VisPrivate,
    unused_generics: Nil,
    rows: Nil
  }
}

// `x := v`, `x.f := v`, and `*x := v` or `*x.f := v`, a write through a borrow: the place is
// then the whole `*…` as written.
pub fn surface_assign(target: SurfaceTerm, value: SurfaceTerm, span: SurfaceSpan): SurfaceStmt {
  match target.kind {
    SkVar(name) => StAssign(surface_name_text(name), None, value)
    SkApp(head, args) => ⊢ SurfaceStmt from match surface_deref_inner(head, args) {
      Some(inner) => surface_assign_at(inner, target, value, span)
      None => StOther("assignment target", span.start, span.end)
    }
    _ => surface_assign_at(target, target, value, span)
  }
}

// The assignment to `place` whose root is the name in `path`.
pub fn surface_assign_at(
  path: SurfaceTerm,
  place: SurfaceTerm,
  value: SurfaceTerm,
  span: SurfaceSpan
): SurfaceStmt {
  match surface_place_root(path) {
    Some(name) => StAssign(name, Some(place), value)
    None => StOther("assignment target", span.start, span.end)
  }
}

// `*a`, the prefix `*` applied to one term: that term.
pub fn surface_deref_inner(head: SurfaceTerm, args: List(SurfaceTerm)): Option(SurfaceTerm) {
  match surface_is_deref(head) {
    true => ⊢ Option(SurfaceTerm) from match args {
      Cons(a, rest) => ⊢ Option(SurfaceTerm) from match rest {
        Nil => Some(a)
        Cons(^b, ^more) => None
      }
      Nil => None
    }
    false => None
  }
}

pub fn surface_is_deref(f: SurfaceTerm): Bool {
  match f.kind {
    SkVar(name) => surface_name_text(name) == "*"
    _ => false
  }
}

mutual {
  fn surface_place_root(t: SurfaceTerm): Option(Text) {
    match t {
      SurfaceTermIndexedMk(kind, ^start, ^end, Occurrence) => surface_place_root_kind(kind)
    }
  }

  fn surface_place_root_kind(kind: SurfaceKind): Option(Text) {
    match kind {
      SkVar(name) => Some(surface_name_text(name))
      SkField(base, ^name) => surface_place_root(base)
      _ => None
    }
  }
}

pub fn surface_def_of(t: SurfaceTheorem, ty: SurfaceTerm, body: SurfaceTerm): SurfaceTheorem {
  SurfaceTheorem {
    visibility: t.visibility,
    name: t.name,
    implicit: t.implicit,
    params: t.params,
    ty: ty,
    body: Some(body),
    start: t.start,
    end: t.end,
    unused: t.unused,
    unused_params: t.unused_params
  }
}

// A binding pattern from a spelled name. Lone `_` as text is only a fallback:
// the Wild token is the dedicated no-bind pattern (not an Ident). Callers must
// pass the Ident spelling without a leading `^`; use
// `surface_bind_pattern_marked` when the unused assertion span is known.
pub fn surface_bind_pattern(written: Text): SurfacePattern {
  match written == "_" {
    true => PtWild
    false => PtBind(surface_unraw(written), None)
  }
}

// Like `surface_bind_pattern`, keeping where `^` was written on `PtBind`.
pub fn surface_bind_pattern_marked(name: Text, unused: Option(SurfaceSpan)): SurfacePattern {
  match name == "_" {
    true => PtWild
    false => PtBind(surface_unraw(name), unused)
  }
}

pub fn surface_bound_term(
  quantifier: Text,
  binder: Text,
  unused: Option(SurfaceSpan),
  domain: SurfaceTerm,
  body: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  match quantifier == "\u{2203}" || quantifier == "\\exists" {
    true => surface_term_at(SkExists(binder, domain, body, unused), span)
    false => surface_term_at(
      SkPi(
        Cons(SurfaceParam { name: Some(binder), ty: domain, unused: unused }, Nil),
        body,
        None
      ),
      span
    )
  }
}

pub fn surface_span_from(acc: SurfaceTerm, end: Nat): SurfaceSpan {
  SurfaceSpan { start: acc.start, end: end }
}

// An operator of a sequence: its sign (an ASCII escape written as the sign) and where it ends.
pub(open) inductive SurfaceOp: Type {
  SurfaceOpMk(sign: Text, end: Nat): SurfaceOp
}

// How loosely an operator binds, as the host reads it: `\u{2194}` 0, `->` 1, `\u{2228}` and `|` 2,
// `\u{2227}` and `\u{00d7}` 3, `=` 4, `||` 5, `&&` 6, the comparisons `== != < <= > >=` 7, `+` and `-` 8,
// `*` and `/` 9.
pub fn surface_sq_level(op: Text): Nat {
  if op == "\u{2194}" { 0 } else {
    if op == "->" { 1 } else {
      if op == "\u{2228}" || op == "|" { 2 } else {
        if op == "\u{2227}" || op == "\u{00d7}" { 3 } else {
          if op == "=" { 4 } else {
            if op == "||" { 5 } else {
              if op == "&&" { 6 } else {
                if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { 7 } else {
                  if op == "+" || op == "-" { 8 } else { 9 }
                }
              }
            }
          }
        }
      }
    }
  }
}

// Whether operators of this level chain: `\u{2194}`, `=` and the comparisons do not.
pub fn surface_sq_chains(level: Nat): Bool {
  not(level == 0 || level == 4 || level == 7)
}

// The level the right side of an operator is read at: the same level for the operators that associate to
// the right, the next one for the others.
pub fn surface_sq_next(op: Text): Nat {
  match surface_sq_level(op) >= 1 && surface_sq_level(op) <= 3 {
    true => surface_sq_level(op)
    false => surface_sq_level(op) + 1
  }
}

pub fn surface_sq_has_arrow(ops: List(SurfaceOp)): Bool {
  match ops {
    Nil => false
    Cons(op, rest) => op.sign == "->" || surface_sq_has_arrow(rest)
  }
}

// The members of a run of `|` or of `\u{00d7}` (`want` 1 or 2) that the right side of an operator is, or the term alone.
pub fn surface_sq_members(r: SurfaceTerm, flat: Nat, want: Nat): List(SurfaceTerm) {
  match flat == want {
    true => ⊢ List(SurfaceTerm) from match r.kind {
      SkUnion(members) => members
      _ => Cons(r, Nil)
    }
    false => Cons(r, Nil)
  }
}

pub fn surface_sq_op_name(op: Text): Text {
  match op == "\u{2227}" {
    true => "And"
    false => ⊢ Text from match op == "\u{2228}" {
      true => "Or"
      false => ⊢ Text from match op == "\u{2194}" {
        true => "Iff"
        false => op
      }
    }
  }
}

// The row the last `->` takes; none of the others does.
pub fn surface_sq_row_for(last: Bool, row: Option(List(RowEntry))): Option(List(RowEntry)) {
  match last {
    true => row
    false => None
  }
}

// A comparison or `\u{2194}` followed by another of its level: `a = b = c`.
pub fn surface_sq_chained(op: SurfaceOp, ops: List(SurfaceOp)): Bool {
  match surface_sq_chains(surface_sq_level(op.sign)) {
    true => false
    false => ⊢ Bool from match ops {
      Nil => false
      Cons(next, ^more) => surface_sq_level(next.sign) == surface_sq_level(op.sign)
    }
  }
}

// `f<T>(x)` reads as `f < T > (x)`: say how a type is passed instead.
pub fn surface_sq_chain_message(op: SurfaceOp, next: SurfaceOp): Text {
  if op.sign == "<" && next.sign == ">" {
    "`f<T>(x)` reads as the comparisons `f < T > (x)`: a call does not take type arguments, as `<…>` declares implicit arguments, which are inferred from the explicit ones; write the call without them (`f(x)`)"
  } else {
    Text::concat(Text::concat("`", next.sign), "` after a chain")
  }
}

pub fn surface_sq_arrow_row(arrow: Bool, row: Option(List(RowEntry))): Option(List(RowEntry)) {
  match arrow {
    true => row
    false => None
  }
}

// The row left for the declaration when no `->` takes it.
pub fn surface_sq_unattached(arrow: Bool, row: Option(List(RowEntry))): Option(List(RowEntry)) {
  match arrow {
    true => None
    false => row
  }
}

// Inserts a field before the first one whose name is not smaller: the order of names is byte by
// byte, and fields of one name keep the order they are written in.
pub fn surface_insert_named(x: SurfaceNamed, xs: List(SurfaceNamed)): List(SurfaceNamed) {
  match xs {
    Nil => Cons(x, Nil)
    Cons(y, rest) => ⊢ List(SurfaceNamed) from match x {
      SurfaceNamedMk(a, ^ta) => ⊢ List(SurfaceNamed) from match y {
        SurfaceNamedMk(b, ^tb) => if Text::compare(a, b) <= 0 {
          Cons(x, xs)
        } else {
          Cons(y, surface_insert_named(x, rest))
        }
      }
    }
  }
}

pub fn surface_sort_named(xs: List(SurfaceNamed)): List(SurfaceNamed) {
  match xs {
    Nil => Nil
    Cons(x, rest) => surface_insert_named(x, surface_sort_named(rest))
  }
}

// The first name of the sorted fields written twice.
pub fn surface_repeated(xs: List(SurfaceNamed)): Option(Text) {
  match xs {
    Nil => None
    Cons(x, rest) => ⊢ Option(Text) from match x {
      SurfaceNamedMk(a, ^ta) => ⊢ Option(Text) from match rest {
        Nil => None
        Cons(y, ^more) => ⊢ Option(Text) from match y {
          SurfaceNamedMk(b, ^tb) => if a == b { Some(a) } else { surface_repeated(rest) }
        }
      }
    }
  }
}

pub fn surface_dotted(xs: List(SurfaceNamed)): Text {
  match xs {
    Nil => ""
    Cons(x, rest) => ⊢ Text from match x {
      SurfaceNamedMk(a, ^ta) => ⊢ Text from match rest {
        Nil => a
        Cons(^y, ^more) => Text::concat_all(Cons(a, Cons(".", Cons(surface_dotted(rest), Nil))))
      }
    }
  }
}

// A record type is the struct `@record.a.b` of its sorted field names, applied to the fields'
// types (`crates/tauto-surface/src/records.rs`).
pub fn surface_record_of(fields: List(SurfaceNamed), span: SurfaceSpan): SurfaceTerm {
  match surface_repeated(surface_sort_named(fields)) {
    Some(twice) => surface_term_at(
      SkOther(Text::concat_all(Cons("`", Cons(twice, Cons("` is written twice in the record", Nil))))),
      span
    )
    None => surface_app(
      Text::concat("@record.", surface_dotted(surface_sort_named(fields))),
      surface_named_types(surface_sort_named(fields)),
      span
    )
  }
}

pub fn surface_named_of_fields(fields: List(SurfaceField)): List(SurfaceNamed) {
  match fields {
    Nil => Nil
    Cons(f, rest) => Cons(SurfaceNamedMk(f.name, f.value), surface_named_of_fields(rest))
  }
}

// A record value is the struct `@record.a.b` of its sorted field names, its fields as written.
pub fn surface_anon_record_of(fields: List(SurfaceField), span: SurfaceSpan): SurfaceTerm {
  match surface_repeated(surface_sort_named(surface_named_of_fields(fields))) {
    Some(twice) => surface_term_at(
      SkOther(Text::concat_all(Cons("`", Cons(twice, Cons("` is written twice in the record", Nil))))),
      span
    )
    None => surface_term_at(
      SkRecord(
        Text::concat(
          "@record.",
          surface_dotted(surface_sort_named(surface_named_of_fields(fields)))
        ),
        fields
      ),
      span
    )
  }
}

// The end of the last of `ts`, or `otherwise` when there are none.
pub fn surface_last_end(ts: List(SurfaceTerm), otherwise: Nat): Nat {
  match ts {
    Nil => otherwise
    Cons(t, rest) => surface_last_end(rest, t.end)
  }
}

// Each of `patterns` as an arm with the same guard, goal and body, before `rest`.
pub fn surface_arms_each(
  patterns: List(SurfacePattern),
  guard: Option(SurfaceTerm),
  goal: Option(SurfaceTerm),
  body: SurfaceTerm,
  rest: List(SurfaceArm)
): List(SurfaceArm) {
  match patterns {
    Nil => rest
    Cons(p, more) => Cons(
      SurfaceArm { pattern: p, guard: guard, goal: goal, body: body },
      surface_arms_each(more, guard, goal, body, rest)
    )
  }
}

pub fn surface_any_wild(ps: List(SurfacePattern)): Bool {
  match ps {
    Nil => false
    Cons(p, rest) => ⊢ Bool from match p {
      PtWild => true
      _ => surface_any_wild(rest)
    }
  }
}

mutual {
// The names a pattern binds below its top, as the Rust reader's `alt_binders`
// gathers them (a name alone at the top is a constructor, not a binder).
pub fn surface_alt_binders(k: Nat, p: SurfacePattern, top: Bool): List(Text) {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(Text) from match p {
      PtBind(n, _) => ⊢ List(Text) from match top {
        true => Nil
        false => Cons(n, Nil)
      }
      PtCtor(^name, args) => surface_alt_binders_all(j, args)
      PtRecord(^name, fields) => surface_alt_binders_fields(j, fields)
      PtTyped(name, ^ty, _) => Cons(name, Nil)
      _ => Nil
    }
  }
}

pub fn surface_alt_binders_all(k: Nat, ps: List(SurfacePattern)): List(Text) {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(Text) from match ps {
      Nil => Nil
      Cons(p, rest) => List::append(surface_alt_binders(j, p, false), surface_alt_binders_all(j, rest))
    }
  }
}

pub fn surface_alt_binders_fields(k: Nat, fs: List(SurfacePatternField)): List(Text) {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(Text) from match fs {
      Nil => Nil
      Cons(f, rest) => List::append(
        surface_alt_binders(j, f.pattern, false),
        surface_alt_binders_fields(j, rest)
      )
    }
  }
}
}

pub fn surface_count_text(x: Text, xs: List(Text)): Nat {
  match xs {
    Nil => 0
    Cons(y, rest) => ⊢ Nat from match x == y {
      true => 1 + surface_count_text(x, rest)
      false => surface_count_text(x, rest)
    }
  }
}

// Whether `a` and `b` hold the same names as many times each.
pub fn surface_same_names(a: List(Text), b: List(Text), all: List(Text)): Bool {
  match all {
    Nil => List::length(a) == List::length(b)
    Cons(x, rest) => surface_count_text(x, a) == surface_count_text(x, b) && surface_same_names(a, b, rest)
  }
}

// Whether every one of `alts` binds the names `first` does.
pub fn surface_same_binders(first: List(Text), alts: List(SurfacePattern), k: Nat): Bool {
  match alts {
    Nil => true
    Cons(p, rest) => surface_same_names(
      first,
      surface_alt_binders(k, p, true),
      List::append(first, surface_alt_binders(k, p, true))
    ) && surface_same_binders(first, rest, k)
  }
}

pub fn surface_box_outside(): Text { "`□` outside `⟦ ⟧`" }

pub fn surface_is_box(t: SurfaceTerm): Bool {
  match t.kind {
    SkOther(what) => what == surface_box_outside()
    _ => false
  }
}

mutual {
  // The `□`s in `t`, those under a binder only when `only_under`.
  pub fn surface_box_count(k: Nat, t: SurfaceTerm, under: Bool, only_under: Bool): Nat {
    match k {
      Zero => 0
      Succ(j) => ⊢ Nat from match surface_is_box(t) {
        true => ⊢ Nat from match under || not(only_under) {
          true => 1
          false => 0
        }
        false => ⊢ Nat from match t.kind {
          SkApp(f, args) => surface_box_count(j, f, under, only_under) +
            surface_box_counts(j, args, under, only_under)
          SkPi(params, result, ^effects) => ⊢ Nat from match params {
            Nil => surface_box_count(j, result, true, only_under)
            Cons(p, rest) => surface_box_count(j, p.ty, under, only_under) +
              surface_box_params(j, rest, true, only_under) +
              surface_box_count(j, result, true, only_under)
          }
          SkExists(^b, domain, body, ^unused) => surface_box_count(j, domain, under, only_under) +
            surface_box_count(j, body, true, only_under)
          SkLam(^params, body, types, _) => surface_box_options(j, types, under, only_under) +
            surface_box_count(j, body, true, only_under)
          SkBorrowLam(^bs, lam) => surface_box_count(j, lam, under, only_under)
          SkUnion(items) => surface_box_counts(j, items, under, only_under)
          SkAscribe(value, ty) => surface_box_count(j, value, under, only_under) +
            surface_box_count(j, ty, under, only_under)
          SkTagged(^tag, value) => surface_box_count(j, value, under, only_under)
          SkBorrow(^m, ^m_orig, value) => surface_box_count(j, value, under, only_under)
          SkSplice(value) => surface_box_count(j, value, under, only_under)
          SkFnKind(^kind, ty) => surface_box_count(j, ty, under, only_under)
          SkIf(cond, then, otherwise) => surface_box_count(j, cond, under, only_under) +
            surface_box_count(j, then, under, only_under) +
            surface_box_option(j, otherwise, under, only_under)
          SkField(value, ^name) => surface_box_count(j, value, under, only_under)
          SkPerform(^op, args) => surface_box_counts(j, args, under, only_under)
          SkRecord(^name, fields) => surface_box_fields(j, fields, under, only_under)
          _ => 0
        }
      }
    }
  }

  pub fn surface_box_counts(k: Nat, ts: List(SurfaceTerm), under: Bool, only_under: Bool): Nat {
    match k {
      Zero => 0
      Succ(j) => ⊢ Nat from match ts {
        Nil => 0
        Cons(t, rest) => surface_box_count(j, t, under, only_under) +
          surface_box_counts(j, rest, under, only_under)
      }
    }
  }

  pub fn surface_box_params(k: Nat, ps: List(SurfaceParam), under: Bool, only_under: Bool): Nat {
    match k {
      Zero => 0
      Succ(j) => ⊢ Nat from match ps {
        Nil => 0
        Cons(p, rest) => surface_box_count(j, p.ty, under, only_under) +
          surface_box_params(j, rest, under, only_under)
      }
    }
  }

  pub fn surface_box_options(
    k: Nat,
    ts: List(Option(SurfaceTerm)),
    under: Bool,
    only_under: Bool
  ): Nat {
    match k {
      Zero => 0
      Succ(j) => ⊢ Nat from match ts {
        Nil => 0
        Cons(t, rest) => surface_box_option(j, t, under, only_under) +
          surface_box_options(j, rest, under, only_under)
      }
    }
  }

  pub fn surface_box_option(k: Nat, t: Option(SurfaceTerm), under: Bool, only_under: Bool): Nat {
    match k {
      Zero => 0
      Succ(j) => ⊢ Nat from match t {
        None => 0
        Some(x) => surface_box_count(j, x, under, only_under)
      }
    }
  }

  pub fn surface_box_fields(k: Nat, fs: List(SurfaceField), under: Bool, only_under: Bool): Nat {
    match k {
      Zero => 0
      Succ(j) => ⊢ Nat from match fs {
        Nil => 0
        Cons(f, rest) => surface_box_count(j, f.value, under, only_under) +
          surface_box_fields(j, rest, under, only_under)
      }
    }
  }
}

mutual {
  // `t` with each `□` the walk reaches put as the variable `name`.
  pub fn surface_box_fill(k: Nat, t: SurfaceTerm, name: Text): SurfaceTerm {
    match k {
      Zero => t
      Succ(j) => ⊢ SurfaceTerm from match surface_is_box(t) {
        true => surface_term_mk(SkVar(NameSpelled(name)), t.start, t.end)
        false => surface_term_mk(
          ⊢ SurfaceKind from match t.kind {
            SkApp(f, args) => SkApp(surface_box_fill(j, f, name), surface_box_fills(j, args, name))
            SkPi(params, result, effects) => SkPi(
              surface_box_fill_params(j, params, name),
              surface_box_fill(j, result, name),
              effects
            )
            SkExists(b, domain, body, unused) => SkExists(b, surface_box_fill(j, domain, name), surface_box_fill(j, body, name), unused)
            SkLam(params, body, types, unused) => SkLam(
              params,
              surface_box_fill(j, body, name),
              surface_box_fill_options(j, types, name),
              unused
            )
            SkBorrowLam(bs, lam) => SkBorrowLam(bs, surface_box_fill(j, lam, name))
            SkUnion(items) => SkUnion(surface_box_fills(j, items, name))
            SkAscribe(value, ty) => SkAscribe(surface_box_fill(j, value, name), surface_box_fill(j, ty, name))
            SkTagged(tag, value) => SkTagged(tag, surface_box_fill(j, value, name))
            SkBorrow(m, m_orig, value) => SkBorrow(m, m_orig, surface_box_fill(j, value, name))
            SkSplice(value) => SkSplice(surface_box_fill(j, value, name))
            SkFnKind(kind, ty) => SkFnKind(kind, surface_box_fill(j, ty, name))
            SkIf(cond, then, otherwise) => SkIf(
              surface_box_fill(j, cond, name),
              surface_box_fill(j, then, name),
              ⊢ Option(SurfaceTerm) from match otherwise {
                None => None
                Some(o) => Some(surface_box_fill(j, o, name))
              }
            )
            SkField(value, field) => SkField(surface_box_fill(j, value, name), field)
            SkPerform(op, args) => SkPerform(op, surface_box_fills(j, args, name))
            SkRecord(record, fields) => SkRecord(record, surface_box_fill_fields(j, fields, name))
            _ => t.kind
          },
          t.start,
          t.end
        )
      }
    }
  }

  pub fn surface_box_fills(k: Nat, ts: List(SurfaceTerm), name: Text): List(SurfaceTerm) {
    match k {
      Zero => ts
      Succ(j) => ⊢ List(SurfaceTerm) from match ts {
        Nil => Nil
        Cons(t, rest) => Cons(surface_box_fill(j, t, name), surface_box_fills(j, rest, name))
      }
    }
  }

  pub fn surface_box_fill_params(k: Nat, ps: List(SurfaceParam), name: Text): List(SurfaceParam) {
    match k {
      Zero => ps
      Succ(j) => ⊢ List(SurfaceParam) from match ps {
        Nil => Nil
        Cons(p, rest) => Cons(
          SurfaceParam { name: p.name, ty: surface_box_fill(j, p.ty, name), unused: p.unused },
          surface_box_fill_params(j, rest, name)
        )
      }
    }
  }

  pub fn surface_box_fill_options(
    k: Nat,
    ts: List(Option(SurfaceTerm)),
    name: Text
  ): List(Option(SurfaceTerm)) {
    match k {
      Zero => ts
      Succ(j) => ⊢ List(Option(SurfaceTerm)) from match ts {
        Nil => Nil
        Cons(t, rest) => Cons(
          ⊢ Option(SurfaceTerm) from match t {
            None => None
            Some(x) => Some(surface_box_fill(j, x, name))
          },
          surface_box_fill_options(j, rest, name)
        )
      }
    }
  }

  pub fn surface_box_fill_fields(k: Nat, fs: List(SurfaceField), name: Text): List(SurfaceField) {
    match k {
      Zero => fs
      Succ(j) => ⊢ List(SurfaceField) from match fs {
        Nil => Nil
        Cons(f, rest) => Cons(
          SurfaceField { name: f.name, value: surface_box_fill(j, f.value, name) },
          surface_box_fill_fields(j, rest, name)
        )
      }
    }
  }
}

// `⟦ body ⟧` once `body` is read: all its boxes receive the same argument.
pub fn surface_congr_of(k: Nat, body: SurfaceTerm, span: SurfaceSpan): SurfaceTerm {
  match surface_box_count(k, body, false, false) {
    Zero => surface_term_at(SkOther("`⟦ ⟧` without a `□`"), span)
    Succ(^more) => ⊢ SurfaceTerm from match surface_box_count(k, body, false, true) {
        Zero => surface_term_at(
          SkLam(Cons("congr@hole", Nil), surface_box_fill(k, body, "congr@hole"), Nil, Nil),
          span
        )
        Succ(^unused) => surface_term_at(SkOther("`□` under a binder inside `⟦ ⟧`"), span)
    }
  }
}

// A program put as the checkers read it. The walk is the one
// `occurrence.taut` makes, with the occurrences left as they are; `path` and
// `keep` are only passed along.
pub fn surface_lower_child(path: List(Nat), field: Nat): List(Nat) {
  List::append(path, Cons(field, Nil))
}

