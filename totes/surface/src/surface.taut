  pub fn surface_lower_surfacestmt(value: SurfaceStmt, path: List(Nat), keep: Bool): SurfaceStmt {
    match value {
      StLet(slot_name, slot_ty, slot_value, slot_borrow, slot_mutable, unused, st_stack) => StLet(slot_name, surface_lower_option_surfaceterm(slot_ty, surface_lower_child(path, 1), keep), surface_lower_surfaceterm(slot_value, surface_lower_child(path, 2), keep), slot_borrow, slot_mutable, unused, st_stack)
      StVar(slot_name, slot_ty, slot_value, slot_borrow, unused, st_stack) => StVar(slot_name, surface_lower_option_surfaceterm(slot_ty, surface_lower_child(path, 1), keep), surface_lower_surfaceterm(slot_value, surface_lower_child(path, 2), keep), slot_borrow, unused, st_stack)
      StAssign(slot_name, slot_place, slot_value) => StAssign(
        slot_name,
        surface_lower_option_surfaceterm(slot_place, surface_lower_child(path, 1), keep),
        surface_lower_surfaceterm(slot_value, surface_lower_child(path, 2), keep)
      )
      StCalled(slot_generates, slot_call) => StCalled(
        slot_generates,
        surface_lower_surfaceterm(slot_call, surface_lower_child(path, 1), keep)
      )
      StAttributed(slot_name, slot_arg, slot_generates, slot_stmt) => StAttributed(
        slot_name,
        surface_lower_surfaceterm(slot_arg, surface_lower_child(path, 1), keep),
        slot_generates,
        surface_lower_surfacestmt(slot_stmt, surface_lower_child(path, 3), keep)
      )
      StFn(slot_f) => StFn(surface_lower_surfacefn(slot_f, surface_lower_child(path, 0), keep))
      StTheorem(slot_t) => StTheorem(
        surface_lower_surfacetheorem(slot_t, surface_lower_child(path, 0), keep)
      )
      StDef(slot_t) => StDef(
        surface_lower_surfacetheorem(slot_t, surface_lower_child(path, 0), keep)
      )
      StMutual(slot_stmts, slot_start, slot_end) => StMutual(
        surface_lower_list_surfacestmt_from(slot_stmts, surface_lower_child(path, 0), keep, 0),
        slot_start,
        slot_end
      )
      StModule(slot_name, slot_visibility, slot_items, slot_start, slot_end) => StModule(
        slot_name,
        slot_visibility,
        surface_lower_list_surfacestmt_from(slot_items, surface_lower_child(path, 2), keep, 0),
        slot_start,
        slot_end
      )
      StReexport(slot_path, slot_names, slot_spans, slot_start, slot_end) => StReexport(slot_path, slot_names, slot_spans, slot_start, slot_end)
      StImport(slot_path, slot_start, slot_end) => StImport(slot_path, slot_start, slot_end)
      StInductive(slot_i) => StInductive(
        surface_lower_surfaceinductive(slot_i, surface_lower_child(path, 0), keep)
      )
      StEffect(slot_e) => StEffect(
        surface_lower_surfaceeffect(slot_e, surface_lower_child(path, 0), keep)
      )
      StStruct(slot_d) => StStruct(
        surface_lower_surfacedata(slot_d, surface_lower_child(path, 0), keep)
      )
      StEnum(slot_d) => StEnum(
        surface_lower_surfacedata(slot_d, surface_lower_child(path, 0), keep)
      )
      // Injected `StStruct`/`StEnum` copies are lowered separately; the block
      // keeps its member lists for membership and only rewrites fn bodies.
      StExtern(slot_fns, slot_instances, slot_types, slot_structs, slot_enums, slot_start, slot_end) => StExtern(
        surface_lower_list_surfacefn_from(slot_fns, surface_lower_child(path, 0), keep, 0),
        slot_instances,
        slot_types,
        slot_structs,
        slot_enums,
        slot_start,
        slot_end
      )
      StClass(slot_c) => StClass(
        surface_lower_surfaceclass(slot_c, surface_lower_child(path, 0), keep)
      )
      StInstance(slot_i) => StInstance(
        surface_lower_surfaceinstance(slot_i, surface_lower_child(path, 0), keep)
      )
      StWhile(slot_cond, slot_body) => StWhile(
        surface_lower_surfaceterm(slot_cond, surface_lower_child(path, 0), keep),
        surface_lower_surfaceterm(slot_body, surface_lower_child(path, 1), keep)
      )
      StReturn(slot_value) => StReturn(
        surface_lower_option_surfaceterm(slot_value, surface_lower_child(path, 0), keep)
      )
      StExpr(slot_value) => StExpr(
        surface_lower_surfaceterm(slot_value, surface_lower_child(path, 0), keep)
      )
      StOther(slot_what, slot_start, slot_end) => StOther(slot_what, slot_start, slot_end)
      StLoop(^st_body, slot_start, slot_end) => StOther("LoopExpr", slot_start, slot_end)
      StFor(^slot_pat, ^slot_src, ^st_body, slot_start, slot_end) => StOther("ForStmt", slot_start, slot_end)
      StBreak(^st_value, slot_start, slot_end) => StOther("BreakStmt", slot_start, slot_end)
      StContinue(slot_start, slot_end) => StOther("ContinueStmt", slot_start, slot_end)
      StMacro(slot_name, slot_function, slot_start, slot_end) => StMacro(
        slot_name,
        slot_function,
        slot_start,
        slot_end
      )
      StSyntax(slot_name, slot_grammar, slot_start, slot_end) => StSyntax(
        slot_name,
        slot_grammar,
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_lower_surfaceterm(value: SurfaceTerm, path: List(Nat), keep: Bool): SurfaceTerm {
    match value {
      SurfaceTermIndexedMk(slot_kind, slot_start, slot_end, slot_old_occurrence) =>
      surface_lower_peel(
        surface_lower_surfacekind(slot_kind, surface_lower_child(path, 0), keep),
        slot_start,
        slot_end,
        slot_old_occurrence
      )
    }
  }

  pub fn surface_lower_surfacetheorem(
    value: SurfaceTheorem,
    path: List(Nat),
    keep: Bool
  ): SurfaceTheorem {
    match value {
      SurfaceTheoremMk(slot_name, slot_implicit, slot_params, slot_ty, slot_body, slot_start, slot_end, slot_unused, slot_unused_params, t_vis) => SurfaceTheoremMk(slot_name, slot_implicit, surface_lower_list_surfacenamed_from(slot_params, surface_lower_child(path, 2), keep, 0), surface_lower_surfaceterm(slot_ty, surface_lower_child(path, 3), keep), surface_lower_option_surfaceterm(slot_body, surface_lower_child(path, 4), keep), slot_start, slot_end, slot_unused, slot_unused_params, t_vis)
    }
    }

}

