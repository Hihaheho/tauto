      SkPi(slot_params, slot_result, slot_effects) => SkPi(
        surface_lower_list_surfaceparam_from(slot_params, surface_lower_child(path, 0), keep, 0),
        surface_lower_surfaceterm(slot_result, surface_lower_child(path, 1), keep),
        slot_effects
      )
      SkExists(slot_binder, slot_domain, slot_body, unused) => SkExists(slot_binder, surface_lower_surfaceterm(slot_domain, surface_lower_child(path, 1), keep), surface_lower_surfaceterm(slot_body, surface_lower_child(path, 2), keep), unused)
      SkLam(slot_params, slot_body, slot_types, unused) => SkLam(
        slot_params,
        surface_lower_surfaceterm(slot_body, surface_lower_child(path, 1), keep),
        slot_types,
        unused
      )
      SkUnion(slot_parts) => SkUnion(
        surface_lower_list_surfaceterm_from(slot_parts, surface_lower_child(path, 0), keep, 0)
      )
      SkTagged(slot_tag, slot_value) => SkTagged(
        slot_tag,
        surface_lower_surfaceterm(slot_value, surface_lower_child(path, 1), keep)
      )
      SkIf(slot_cond, slot_then, slot_otherwise) => SkIf(
        surface_lower_surfaceterm(slot_cond, surface_lower_child(path, 0), keep),
        surface_lower_surfaceterm(slot_then, surface_lower_child(path, 1), keep),
        surface_lower_option_surfaceterm(slot_otherwise, surface_lower_child(path, 2), keep)
      )
      SkField(slot_value, slot_name) => SkField(
        surface_lower_surfaceterm(slot_value, surface_lower_child(path, 0), keep),
        slot_name
      )
      SkBlock(slot_stmts) => SkBlock(
        surface_lower_list_surfacestmt_from(slot_stmts, surface_lower_child(path, 0), keep, 0)
      )
      SkPerform(slot_op, slot_args) => SkPerform(
        slot_op,
        surface_lower_list_surfaceterm_from(slot_args, surface_lower_child(path, 1), keep, 0)
      )
      SkHandle(slot_body, slot_handlers) => SkHandle(
        surface_lower_surfaceterm(slot_body, surface_lower_child(path, 0), keep),
        surface_lower_list_surfacehandler_from(slot_handlers, surface_lower_child(path, 1), keep, 0)
      )
      SkBudget(slot_memory, slot_amount, slot_body) => SkBudget(
        slot_memory,
        surface_lower_surfaceterm(slot_amount, surface_lower_child(path, 1), keep),
        surface_lower_surfaceterm(slot_body, surface_lower_child(path, 2), keep)
      )
      SkMatch(slot_scrutinee, slot_motive, slot_arms, slot_binder, slot_binder_unused) => SkMatch(
        surface_lower_surfaceterm(slot_scrutinee, surface_lower_child(path, 0), keep),
        surface_lower_option_surfaceterm(slot_motive, surface_lower_child(path, 1), keep),
        surface_lower_list_surfacearm_from(slot_arms, surface_lower_child(path, 2), keep, 0),
        slot_binder,
        slot_binder_unused
      )
      SkHole(slot_name) => SkHole(slot_name)
      SkRecord(slot_name, slot_fields) => SkRecord(
        slot_name,
        surface_lower_list_surfacefield_from(slot_fields, surface_lower_child(path, 1), keep, 0)
      )
      SkBorrow(slot_mutable, slot_mutable_orig, slot_value) => SkBorrow(
        slot_mutable, slot_mutable_orig,
        surface_lower_surfaceterm(slot_value, surface_lower_child(path, 1), keep)
      )
      SkFnKind(slot_kind, slot_ty) => SkFnKind(
        slot_kind,
        surface_lower_surfaceterm(slot_ty, surface_lower_child(path, 1), keep)
      )
      SkBorrowLam(slot_borrows, slot_lam) => SkBorrowLam(
        slot_borrows,
        surface_lower_surfaceterm(slot_lam, surface_lower_child(path, 1), keep)
      )
      SkOther(slot_what) => SkOther(slot_what)
      SkMacroCall(slot_name, slot_arg) => SkMacroCall(
        slot_name,
        surface_lower_surfaceterm(slot_arg, surface_lower_child(path, 1), keep)
      )
      SkQuote(slot_stmts_form, slot_stmts) => SkQuote(
