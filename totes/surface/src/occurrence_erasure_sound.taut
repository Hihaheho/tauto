  pub theorem surface_index_surfacearm_erase(
    value: SurfaceArm,
    path: List(Nat),
    keep: Bool,
    erase_path: List(Nat)
  ): surface_index_surfacearm(
    surface_index_surfacearm(value, path, keep),
    erase_path,
    false
  ) = surface_index_surfacearm(value, erase_path, false) {
    ⊢ surface_index_surfacearm(
      surface_index_surfacearm(value, path, keep),
      erase_path,
      false
    ) = surface_index_surfacearm(value, erase_path, false) from match value {
      SurfaceArmMk(slot_pattern, slot_guard, slot_goal, slot_body) => Eq::trans(
        Eq::congr(
          (replacement: SurfacePattern) => SurfaceArmMk(
            replacement,
            surface_index_option_surfaceterm(
              surface_index_option_surfaceterm(slot_guard, surface_index_child(path, 1), keep),
              surface_index_child(erase_path, 1),
              false
            ),
            surface_index_option_surfaceterm(
              surface_index_option_surfaceterm(slot_goal, surface_index_child(path, 2), keep),
              surface_index_child(erase_path, 2),
              false
            ),
            surface_index_surfaceterm(
              surface_index_surfaceterm(slot_body, surface_index_child(path, 3), keep),
              surface_index_child(erase_path, 3),
              false
            )
          ),
          surface_index_surfacepattern_erase(
            slot_pattern,
            surface_index_child(path, 0),
            keep,
            surface_index_child(erase_path, 0)
          )
        ),
        Eq::trans(
          Eq::congr(
            (replacement: Option(SurfaceTerm)) => SurfaceArmMk(
              surface_index_surfacepattern(slot_pattern, surface_index_child(erase_path, 0), false),
              replacement,
              surface_index_option_surfaceterm(
                surface_index_option_surfaceterm(slot_goal, surface_index_child(path, 2), keep),
                surface_index_child(erase_path, 2),
                false
              ),
              surface_index_surfaceterm(
                surface_index_surfaceterm(slot_body, surface_index_child(path, 3), keep),
                surface_index_child(erase_path, 3),
                false
              )
            ),
            surface_index_option_surfaceterm_erase(
              slot_guard,
              surface_index_child(path, 1),
              keep,
              surface_index_child(erase_path, 1)
            )
          ),
          Eq::trans(
            Eq::congr(
              (replacement: Option(SurfaceTerm)) => SurfaceArmMk(
                surface_index_surfacepattern(
                  slot_pattern,
                  surface_index_child(erase_path, 0),
                  false
                ),
                surface_index_option_surfaceterm(
                  slot_guard,
                  surface_index_child(erase_path, 1),
                  false
                ),
                replacement,
                surface_index_surfaceterm(
                  surface_index_surfaceterm(slot_body, surface_index_child(path, 3), keep),
                  surface_index_child(erase_path, 3),
                  false
                )
              ),
              surface_index_option_surfaceterm_erase(
                slot_goal,
                surface_index_child(path, 2),
                keep,
                surface_index_child(erase_path, 2)
              )
            ),
            Eq::congr(
              (replacement: SurfaceTerm) => SurfaceArmMk(
                surface_index_surfacepattern(
                  slot_pattern,
                  surface_index_child(erase_path, 0),
                  false
                ),
                surface_index_option_surfaceterm(
                  slot_guard,
                  surface_index_child(erase_path, 1),
                  false
                ),
                surface_index_option_surfaceterm(
                  slot_goal,
                  surface_index_child(erase_path, 2),
                  false
                ),
                replacement
              ),
              surface_index_surfaceterm_erase(
                slot_body,
                surface_index_child(path, 3),
                keep,
                surface_index_child(erase_path, 3)
              )
            )
          )
        )
      )
    }
  }

