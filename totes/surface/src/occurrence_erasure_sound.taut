      erase_path,
      false,
      erase_index
    ) = surface_index_list_surfacesteparm_from(value, erase_path, false, erase_index) from match value {
      Nil => Refl
      Cons(item, rest) => Eq::trans(
        Eq::congr(
          (replacement: SurfaceStepArm) => Cons(
            replacement,
            surface_index_list_surfacesteparm_from(
              surface_index_list_surfacesteparm_from(rest, path, keep, index + 1),
