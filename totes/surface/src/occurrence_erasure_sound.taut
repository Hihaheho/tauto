  ) = surface_index_surfacekind(value, erase_path, false) {
    ⊢ surface_index_surfacekind(
      surface_index_surfacekind(value, path, keep),
      erase_path,
      false
    ) = surface_index_surfacekind(value, erase_path, false) from match value {
      SkVar(slot_name) => Refl
      SkNat(slot_digits) => Refl
      SkFloat(slot_digits) => Refl
      SkRow(slot_effects) => Refl
      SkText(slot_value) => Refl
      SkBool(slot_value) => Refl
      SkApp(slot_head, slot_args) => Eq::trans(
        Eq::congr(
          (replacement: SurfaceTerm) => SkApp(
            replacement,
            surface_index_list_surfaceterm_from(
              surface_index_list_surfaceterm_from(slot_args, surface_index_child(path, 1), keep, 0),
              surface_index_child(erase_path, 1),
