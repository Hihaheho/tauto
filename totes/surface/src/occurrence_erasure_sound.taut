import "surface.taut"
import "occurrence.taut"

// Indexing followed by erasure preserves the whole tree modulo metadata.
mutual {
  pub theorem surface_index_list_option_surfaceterm_erase_from(
    value: List(Option(SurfaceTerm)),
    path: List(Nat),
    keep: Bool,
    index: Nat,
    erase_path: List(Nat),
    erase_index: Nat
  ): surface_index_list_option_surfaceterm_from(
    surface_index_list_option_surfaceterm_from(value, path, keep, index),
    erase_path,
    false,
    erase_index
  ) = surface_index_list_option_surfaceterm_from(value, erase_path, false, erase_index) {
    ⊢ surface_index_list_option_surfaceterm_from(
      surface_index_list_option_surfaceterm_from(value, path, keep, index),
      erase_path,
      false,
      erase_index
    ) = surface_index_list_option_surfaceterm_from(value, erase_path, false, erase_index) from match value {
      Nil => Refl
      Cons(item, rest) => Eq::trans(
        Eq::congr(
          (replacement: Option(SurfaceTerm)) => Cons(
            replacement,
            surface_index_list_option_surfaceterm_from(
              surface_index_list_option_surfaceterm_from(rest, path, keep, index + 1),
              erase_path,
              false,
              erase_index + 1
            )
          ),
          surface_index_option_surfaceterm_erase(
            item,
            surface_index_child(path, index),
            keep,
            surface_index_child(erase_path, erase_index)
          )
        ),
        Eq::congr(
          (replacement: List(Option(SurfaceTerm))) => Cons(
            surface_index_option_surfaceterm(
              item,
              surface_index_child(erase_path, erase_index),
              false
            ),
            replacement
          ),
          surface_index_list_option_surfaceterm_erase_from(
            rest,
            path,
            keep,
            index + 1,
            erase_path,
            erase_index + 1
          )
        )
      )
    }
  }

