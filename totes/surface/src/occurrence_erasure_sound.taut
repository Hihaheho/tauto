          slot_value,
          surface_index_child(path, 1),
          keep,
          surface_index_child(erase_path, 1)
        )
      )
      SkIf(slot_cond, slot_then, slot_otherwise) => Eq::trans(
        Eq::congr(
          (replacement: SurfaceTerm) => SkIf(
