pub theorem surface_index_list_surfaceterm_erase(
  value: List(SurfaceTerm),
  path: List(Nat),
  keep: Bool,
  erase_path: List(Nat)
): surface_index_list_surfaceterm_from(
  surface_index_list_surfaceterm_from(value, path, keep, 0),
  erase_path,
  false,
  0
) = surface_index_list_surfaceterm_from(value, erase_path, false, 0) {
  surface_index_list_surfaceterm_erase_from(value, path, keep, 0, erase_path, 0)
}
