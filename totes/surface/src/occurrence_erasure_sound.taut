  pub theorem surface_index_list_surfacesteparm_erase_from(
    value: List(SurfaceStepArm),
    path: List(Nat),
    keep: Bool,
    index: Nat,
    erase_path: List(Nat),
    erase_index: Nat
  ): surface_index_list_surfacesteparm_from(
    surface_index_list_surfacesteparm_from(value, path, keep, index),
    erase_path,
    false,
    erase_index
  ) = surface_index_list_surfacesteparm_from(value, erase_path, false, erase_index) {
