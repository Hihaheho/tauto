          Eq::congr(
            (replacement: SurfaceTerm) => SurfaceStepArmMk(
              surface_index_list_surfacefield_from(
                slot_binders,
                surface_index_child(erase_path, 0),
                false,
                0
              ),
              replacement,
              surface_index_surfaceterm(
                surface_index_surfaceterm(slot_body, surface_index_child(path, 2), keep),
                surface_index_child(erase_path, 2),
                false
              ),
              slot_start,
              slot_end
            ),
            surface_index_surfaceterm_erase(
              slot_goal,
              surface_index_child(path, 1),
              keep,
              surface_index_child(erase_path, 1)
            )
          ),
          Eq::congr(
            (replacement: SurfaceTerm) => SurfaceStepArmMk(
              surface_index_list_surfacefield_from(
                slot_binders,
                surface_index_child(erase_path, 0),
                false,
                0
              ),
              surface_index_surfaceterm(slot_goal, surface_index_child(erase_path, 1), false),
              replacement,
              slot_start,
              slot_end
            ),
            surface_index_surfaceterm_erase(
              slot_body,
              surface_index_child(path, 2),
              keep,
              surface_index_child(erase_path, 2)
            )
          )
        )
      )
    }
  }

  pub theorem surface_index_surfacestmt_erase(
    value: SurfaceStmt,
    path: List(Nat),
    keep: Bool,
    erase_path: List(Nat)
  ): surface_index_surfacestmt(
    surface_index_surfacestmt(value, path, keep),
    erase_path,
    false
  ) = surface_index_surfacestmt(value, erase_path, false) {
    ⊢ surface_index_surfacestmt(
      surface_index_surfacestmt(value, path, keep),
      erase_path,
      false
    ) = surface_index_surfacestmt(value, erase_path, false) from match value {
      StLet(slot_name, slot_ty, slot_value, slot_borrow, slot_mutable) => Eq::trans(
        Eq::congr(
          (replacement: Option(SurfaceTerm)) => StLet(
            slot_name,
            replacement,
            surface_index_surfaceterm(
              surface_index_surfaceterm(slot_value, surface_index_child(path, 2), keep),
              surface_index_child(erase_path, 2),
              false
            ),
            slot_borrow,
            slot_mutable
          ),
          surface_index_option_surfaceterm_erase(
            slot_ty,
            surface_index_child(path, 1),
            keep,
            surface_index_child(erase_path, 1)
          )
        ),
        Eq::congr(
          (replacement: SurfaceTerm) => StLet(
            slot_name,
            surface_index_option_surfaceterm(slot_ty, surface_index_child(erase_path, 1), false),
            replacement,
            slot_borrow,
            slot_mutable
          ),
          surface_index_surfaceterm_erase(
            slot_value,
            surface_index_child(path, 2),
            keep,
            surface_index_child(erase_path, 2)
          )
        )
      )
      StVar(slot_name, slot_ty, slot_value, slot_borrow) => Eq::trans(
        Eq::congr(
          (replacement: Option(SurfaceTerm)) => StVar(
            slot_name,
            replacement,
            surface_index_surfaceterm(
              surface_index_surfaceterm(slot_value, surface_index_child(path, 2), keep),
              surface_index_child(erase_path, 2),
              false
            ),
            slot_borrow
          ),
          surface_index_option_surfaceterm_erase(
            slot_ty,
            surface_index_child(path, 1),
            keep,
            surface_index_child(erase_path, 1)
          )
        ),
        Eq::congr(
          (replacement: SurfaceTerm) => StVar(
            slot_name,
            surface_index_option_surfaceterm(slot_ty, surface_index_child(erase_path, 1), false),
            replacement,
            slot_borrow
          ),
          surface_index_surfaceterm_erase(
            slot_value,
            surface_index_child(path, 2),
            keep,
            surface_index_child(erase_path, 2)
          )
        )
      )
      StModule(slot_name, slot_stmts, slot_start, slot_end) => Eq::congr(
        (replacement: List(SurfaceStmt)) => StModule(slot_name, replacement, slot_start, slot_end),
        surface_index_list_surfacestmt_erase_from(
          slot_stmts,
          surface_index_child(path, 1),
          keep,
          0,
          surface_index_child(erase_path, 1),
          0
        )
      )
      StAssign(slot_name, slot_place, slot_value) => Eq::trans(
        Eq::congr(
          (replacement: Option(SurfaceTerm)) => StAssign(
            slot_name,
            replacement,
            surface_index_surfaceterm(
              surface_index_surfaceterm(slot_value, surface_index_child(path, 2), keep),
              surface_index_child(erase_path, 2),
              false
            )
          ),
          surface_index_option_surfaceterm_erase(
            slot_place,
            surface_index_child(path, 1),
            keep,
            surface_index_child(erase_path, 1)
          )
        ),
        Eq::congr(
          (replacement: SurfaceTerm) => StAssign(
            slot_name,
            surface_index_option_surfaceterm(slot_place, surface_index_child(erase_path, 1), false),
            replacement
          ),
          surface_index_surfaceterm_erase(
            slot_value,
            surface_index_child(path, 2),
            keep,
            surface_index_child(erase_path, 2)
          )
        )
      )
      StCalled(slot_generates, slot_call) => Eq::congr(
        (replacement: SurfaceTerm) => StCalled(slot_generates, replacement),
        surface_index_surfaceterm_erase(
          slot_call,
          surface_index_child(path, 1),
          keep,
          surface_index_child(erase_path, 1)
        )
      )
      StAttributed(slot_name, slot_arg, slot_generates, slot_stmt) => Eq::trans(
        Eq::congr(
          (replacement: SurfaceTerm) => StAttributed(
            slot_name,
            replacement,
            slot_generates,
            surface_index_surfacestmt(
              surface_index_surfacestmt(slot_stmt, surface_index_child(path, 3), keep),
              surface_index_child(erase_path, 3),
              false
            )
          ),
          surface_index_surfaceterm_erase(
            slot_arg,
            surface_index_child(path, 1),
            keep,
            surface_index_child(erase_path, 1)
          )
        ),
        Eq::congr(
          (replacement: SurfaceStmt) => StAttributed(
            slot_name,
            surface_index_surfaceterm(slot_arg, surface_index_child(erase_path, 1), false),
            slot_generates,
            replacement
          ),
          surface_index_surfacestmt_erase(
            slot_stmt,
            surface_index_child(path, 3),
            keep,
            surface_index_child(erase_path, 3)
          )
        )
      )
      StFn(slot_f) => Eq::congr(
        (replacement: SurfaceFn) => StFn(replacement),
        surface_index_surfacefn_erase(
          slot_f,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StTheorem(slot_t) => Eq::congr(
        (replacement: SurfaceTheorem) => StTheorem(replacement),
        surface_index_surfacetheorem_erase(
          slot_t,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StDef(slot_t) => Eq::congr(
        (replacement: SurfaceTheorem) => StDef(replacement),
        surface_index_surfacetheorem_erase(
          slot_t,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StMutual(slot_stmts, slot_start, slot_end) => Eq::congr(
        (replacement: List(SurfaceStmt)) => StMutual(replacement, slot_start, slot_end),
        surface_index_list_surfacestmt_erase_from(
          slot_stmts,
          surface_index_child(path, 0),
          keep,
          0,
          surface_index_child(erase_path, 0),
          0
        )
      )
      StImport(slot_path, slot_start, slot_end) => Refl
      StInductive(slot_i) => Eq::congr(
        (replacement: SurfaceInductive) => StInductive(replacement),
        surface_index_surfaceinductive_erase(
          slot_i,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StEffect(slot_e) => Eq::congr(
        (replacement: SurfaceEffect) => StEffect(replacement),
        surface_index_surfaceeffect_erase(
          slot_e,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StStruct(slot_d) => Eq::congr(
        (replacement: SurfaceData) => StStruct(replacement),
        surface_index_surfacedata_erase(
          slot_d,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StEnum(slot_d) => Eq::congr(
        (replacement: SurfaceData) => StEnum(replacement),
        surface_index_surfacedata_erase(
          slot_d,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StExtern(slot_abi, slot_fns, slot_start, slot_end) => Eq::congr(
        (replacement: List(SurfaceFn)) => StExtern(slot_abi, replacement, slot_start, slot_end),
        surface_index_list_surfacefn_erase_from(
          slot_fns,
          surface_index_child(path, 1),
          keep,
          0,
          surface_index_child(erase_path, 1),
          0
        )
      )
      StClass(slot_c) => Eq::congr(
        (replacement: SurfaceClass) => StClass(replacement),
        surface_index_surfaceclass_erase(
          slot_c,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StInstance(slot_i) => Eq::congr(
        (replacement: SurfaceInstance) => StInstance(replacement),
        surface_index_surfaceinstance_erase(
          slot_i,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StWhile(slot_cond, slot_body) => Eq::trans(
        Eq::congr(
          (replacement: SurfaceTerm) => StWhile(
            replacement,
            surface_index_surfaceterm(
              surface_index_surfaceterm(slot_body, surface_index_child(path, 1), keep),
              surface_index_child(erase_path, 1),
              false
            )
          ),
          surface_index_surfaceterm_erase(
            slot_cond,
            surface_index_child(path, 0),
            keep,
            surface_index_child(erase_path, 0)
          )
        ),
        Eq::congr(
          (replacement: SurfaceTerm) => StWhile(
            surface_index_surfaceterm(slot_cond, surface_index_child(erase_path, 0), false),
            replacement
          ),
          surface_index_surfaceterm_erase(
            slot_body,
            surface_index_child(path, 1),
            keep,
            surface_index_child(erase_path, 1)
          )
        )
      )
      StReturn(slot_value) => Eq::congr(
        (replacement: Option(SurfaceTerm)) => StReturn(replacement),
        surface_index_option_surfaceterm_erase(
          slot_value,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StExpr(slot_value) => Eq::congr(
        (replacement: SurfaceTerm) => StExpr(replacement),
        surface_index_surfaceterm_erase(
          slot_value,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
      StOther(slot_what, slot_start, slot_end) => Refl
      StMacro(slot_name, slot_function, slot_start, slot_end) => Refl
      StSyntax(slot_name, slot_grammar, slot_start, slot_end) => Refl
    }
  }

  pub theorem surface_index_surfaceterm_erase(
    value: SurfaceTerm,
    path: List(Nat),
    keep: Bool,
    erase_path: List(Nat)
  ): surface_index_surfaceterm(
    surface_index_surfaceterm(value, path, keep),
    erase_path,
    false
  ) = surface_index_surfaceterm(value, erase_path, false) {
    ⊢ surface_index_surfaceterm(
      surface_index_surfaceterm(value, path, keep),
      erase_path,
      false
    ) = surface_index_surfaceterm(value, erase_path, false) from match value {
      SurfaceTermIndexedMk(slot_kind, slot_start, slot_end, slot_old_occurrence) =>
      Eq::congr(
        (replacement: SurfaceKind) => SurfaceTermIndexedMk(replacement, slot_start, slot_end, None),
        surface_index_surfacekind_erase(
          slot_kind,
          surface_index_child(path, 0),
          keep,
          surface_index_child(erase_path, 0)
        )
      )
    }
  }

  pub theorem surface_index_surfacetheorem_erase(
    value: SurfaceTheorem,
    path: List(Nat),
    keep: Bool,
    erase_path: List(Nat)
  ): surface_index_surfacetheorem(
    surface_index_surfacetheorem(value, path, keep),
    erase_path,
    false
  ) = surface_index_surfacetheorem(value, erase_path, false) {
    ⊢ surface_index_surfacetheorem(
      surface_index_surfacetheorem(value, path, keep),
      erase_path,
      false
    ) = surface_index_surfacetheorem(value, erase_path, false) from match value {
      SurfaceTheoremMk(slot_name, slot_implicit, slot_params, slot_ty, slot_body, slot_start, slot_end) => Eq::trans(
        Eq::congr(
          (replacement: List(SurfaceNamed)) => SurfaceTheoremMk(
            slot_name,
            slot_implicit,
            replacement,
            surface_index_surfaceterm(
              surface_index_surfaceterm(slot_ty, surface_index_child(path, 3), keep),
              surface_index_child(erase_path, 3),
              false
            ),
            surface_index_option_surfaceterm(
              surface_index_option_surfaceterm(slot_body, surface_index_child(path, 4), keep),
              surface_index_child(erase_path, 4),
              false
            ),
            slot_start,
            slot_end
          ),
          surface_index_list_surfacenamed_erase_from(
            slot_params,
            surface_index_child(path, 2),
            keep,
            0,
            surface_index_child(erase_path, 2),
            0
          )
        ),
        Eq::trans(
          Eq::congr(
            (replacement: SurfaceTerm) => SurfaceTheoremMk(
              slot_name,
              slot_implicit,
              surface_index_list_surfacenamed_from(
                slot_params,
                surface_index_child(erase_path, 2),
                false,
                0
              ),
              replacement,
              surface_index_option_surfaceterm(
                surface_index_option_surfaceterm(slot_body, surface_index_child(path, 4), keep),
                surface_index_child(erase_path, 4),
                false
              ),
              slot_start,
              slot_end
            ),
            surface_index_surfaceterm_erase(
              slot_ty,
              surface_index_child(path, 3),
              keep,
              surface_index_child(erase_path, 3)
            )
          ),
          Eq::congr(
            (replacement: Option(SurfaceTerm)) => SurfaceTheoremMk(
              slot_name,
              slot_implicit,
              surface_index_list_surfacenamed_from(
                slot_params,
                surface_index_child(erase_path, 2),
                false,
                0
              ),
              surface_index_surfaceterm(slot_ty, surface_index_child(erase_path, 3), false),
              replacement,
              slot_start,
              slot_end
            ),
            surface_index_option_surfaceterm_erase(
              slot_body,
              surface_index_child(path, 4),
              keep,
              surface_index_child(erase_path, 4)
            )
          )
        )
      )
    }
  }

}

