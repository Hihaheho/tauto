            0
          )
        ),
        Eq::trans(
          Eq::congr(
            (replacement: List(SurfaceLaw)) => SurfaceClassMk(
              slot_name,
              slot_param,
              slot_arity,
              slot_bound,
              surface_index_list_surfacefn_from(
                slot_methods,
