        Eq::congr(
          (replacement: List(SurfaceStepArm)) => Cons(
            surface_index_surfacesteparm(item, surface_index_child(erase_path, erase_index), false),
            replacement
          ),
          surface_index_list_surfacesteparm_erase_from(
            rest,
            path,
            keep,
            index + 1,
            erase_path,
            erase_index + 1
          )
        )
      )
    }
  }

