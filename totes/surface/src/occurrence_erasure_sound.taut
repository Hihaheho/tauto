            ),
            surface_index_list_surfacelaw_erase_from(
              slot_laws,
              surface_index_child(path, 5),
              keep,
              0,
              surface_index_child(erase_path, 5),
              0
            )
          ),
          Eq::congr(
            (replacement: List(SurfaceNamed)) => SurfaceClassMk(
              slot_name,
              slot_param,
              slot_arity,
              slot_bound,
              surface_index_list_surfacefn_from(
                slot_methods,
                surface_index_child(erase_path, 4),
                false,
                0
              ),
              surface_index_list_surfacelaw_from(
                slot_laws,
                surface_index_child(erase_path, 5),
                false,
                0
              ),
              slot_start,
              slot_end,
              replacement
            ),
            surface_index_list_surfacenamed_erase_from(
              slot_parameters,
              surface_index_child(path, 8),
              keep,
              0,
              surface_index_child(erase_path, 8),
