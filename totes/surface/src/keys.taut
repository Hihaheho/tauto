  pub fn surface_key_surfacekind(value: SurfaceKind, uses: SurfaceKeyEnv): SurfaceKind {
    match value {
      SkVar(slot_name) => SkVar(slot_name)
      SkNat(slot_digits) => SkNat(slot_digits)
      SkFloat(slot_digits) => SkFloat(slot_digits)
      SkRow(slot_effects) => SkRow(surface_key_list_rowentry_from(slot_effects, uses))
      SkText(slot_value) => SkText(slot_value)
      SkBool(slot_value) => SkBool(slot_value)
      SkApp(slot_head, slot_args) => SkApp(
        surface_key_surfaceterm(slot_head, uses),
        surface_key_list_surfaceterm_from(slot_args, uses)
