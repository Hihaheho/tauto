  pub fn surface_key_rowentry(value: RowEntry, uses: SurfaceKeyEnv): RowEntry {
    match value {
      EntryName(slot_name, slot_unused) => EntryName(surface_key_text(uses, slot_name), slot_unused)
      EntryApplied(slot_name, slot_args, slot_universal, slot_forall, slot_unused) => EntryApplied(
        surface_key_text(uses, slot_name),
        surface_key_list_surfaceterm_from(slot_args, uses),
        slot_universal,
        slot_forall,
        slot_unused
      )
    }
  }

  pub fn surface_key_list_rowentry_from(value: List(RowEntry), uses: SurfaceKeyEnv): List(RowEntry) {
    match value {
      Nil => Nil
      Cons(item, rest) => Cons(surface_key_rowentry(item, uses), surface_key_list_rowentry_from(rest, uses))
    }
  }

  pub fn surface_key_option_list_rowentry(value: Option(List(RowEntry)), uses: SurfaceKeyEnv): Option(List(RowEntry)) {
    match value {
      None => None
      Some(es) => Some(surface_key_list_rowentry_from(es, uses))
    }
  }

  pub fn surface_key_surfaceterm(value: SurfaceTerm, uses: SurfaceKeyEnv): SurfaceTerm {
    match value {
      SurfaceTermIndexedMk(slot_kind, slot_start, slot_end, slot_old_occurrence) =>
      SurfaceTermIndexedMk(
        surface_key_var(slot_start, slot_end, uses, surface_key_surfacekind(slot_kind, uses)),
        slot_start,
        slot_end,
        slot_old_occurrence
      )
    }
  }

  pub fn surface_key_surfacetheorem(
    value: SurfaceTheorem,
    uses: SurfaceKeyEnv
  ): SurfaceTheorem {
    match value {
      SurfaceTheoremMk(slot_name, slot_implicit, slot_params, slot_ty, slot_body, slot_start, slot_end, slot_unused, slot_unused_params, t_vis) => SurfaceTheoremMk(slot_name, slot_implicit, surface_key_list_surfacenamed_from(slot_params, uses), surface_key_surfaceterm(slot_ty, uses), surface_key_option_surfaceterm(slot_body, uses), slot_start, slot_end, slot_unused, slot_unused_params, t_vis)
    }
    }

}


// The program keyed, with the display text of its declarations.
pub fn surface_key_program(stmts: List(SurfaceStmt), outer: List(SurfaceStmt)): SurfaceResolvedProgram {
  let resolved := surface_resolve(stmts)
  let e := SurfaceKeyEnvMk(resolved.uses, surface_key_names(resolved.decls, stmts, outer))
  SurfaceResolvedProgramMk(
    surface_key_list_surfacestmt_from(stmts, e),
    surface_decl_table(resolved.decls)
  )
}
