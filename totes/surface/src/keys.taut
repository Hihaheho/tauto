      StVar(slot_name, slot_ty, slot_value, slot_borrow, unused, st_stack) => StVar(slot_name, surface_key_option_surfaceterm(slot_ty, uses), surface_key_surfaceterm(slot_value, uses), slot_borrow, unused, st_stack)
      StAssign(slot_name, slot_place, slot_value) => StAssign(
