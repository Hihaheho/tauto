  pub fn surface_key_surfacearm(value: SurfaceArm, uses: SurfaceKeyEnv): SurfaceArm {
    match value {
      SurfaceArmMk(slot_pattern, slot_guard, slot_goal, slot_body) => SurfaceArmMk(
        surface_key_surfacepattern(slot_pattern, uses),
        surface_key_option_surfaceterm(slot_guard, uses),
        surface_key_option_surfaceterm(slot_goal, uses),
        surface_key_surfaceterm(slot_body, uses)
      )
    }
  }

  pub fn surface_key_surfaceclass(
    value: SurfaceClass,
    uses: SurfaceKeyEnv
  ): SurfaceClass {
    match value {
      SurfaceClassMk(slot_name, slot_param, slot_arity, slot_bound, slot_methods, slot_laws, slot_start, slot_end, slot_parameters, slot_inductive, slot_parents, slot_unused_parameters, c_vis) => SurfaceClassMk(surface_key_text(uses, slot_name), slot_param, slot_arity, surface_key_bound(uses, slot_bound), surface_key_list_surfacefn_from(slot_methods, uses), surface_key_list_surfacelaw_from(slot_laws, uses), slot_start, slot_end, surface_key_list_surfacenamed_from(slot_parameters, uses), slot_inductive, surface_key_list_surfaceconstraint_from(slot_parents, uses), slot_unused_parameters, c_vis)
    }
  }

  pub fn surface_key_surfaceconstraint(
    value: SurfaceConstraint,
    uses: SurfaceKeyEnv
  ): SurfaceConstraint {
    match value {
      SurfaceConstraintMk(slot_class, slot_ty, slot_start, slot_end, slot_arguments) => SurfaceConstraintMk(
        surface_key_text(uses, slot_class),
        surface_key_surfaceterm(slot_ty, uses),
        slot_start,
        slot_end,
        surface_key_list_surfaceterm_from(slot_arguments, uses)
      )
    }
  }

  pub fn surface_key_surfacector(value: SurfaceCtor, uses: SurfaceKeyEnv): SurfaceCtor {
    match value {
      SurfaceCtorMk(slot_name, slot_implicit, slot_params, slot_result) => SurfaceCtorMk(
        slot_name,
        slot_implicit,
        surface_key_list_surfacenamed_from(slot_params, uses),
        surface_key_surfaceterm(slot_result, uses)
      )
    }
  }

  pub fn surface_key_surfacedata(value: SurfaceData, uses: SurfaceKeyEnv): SurfaceData {
    match value {
      SurfaceDataMk(slot_kind, slot_name, slot_generics, slot_constructors, slot_start, slot_end, slot_coerce, slot_coerce_field, slot_visibility, slot_unused_generics, slot_rows) => SurfaceDataMk(slot_kind, slot_name, slot_generics, surface_key_list_surfacedatactor_from(
          slot_constructors,
          uses), slot_start, slot_end, slot_coerce, slot_coerce_field, slot_visibility, slot_unused_generics, slot_rows)
    }
  }

  pub fn surface_key_surfacedatactor(
    value: SurfaceDataCtor,
    uses: SurfaceKeyEnv
  ): SurfaceDataCtor {
    match value {
      SurfaceDataCtorMk(slot_name, slot_fields) => SurfaceDataCtorMk(
        slot_name,
        surface_key_list_surfacedatafield_from(slot_fields, uses)
      )
    }
  }

