      StLoop(st_body, slot_start, slot_end) => StLoop(surface_key_surfaceterm(st_body, uses), slot_start, slot_end)
      StBreak(st_value, slot_start, slot_end) => StBreak(surface_key_option_surfaceterm(st_value, uses), slot_start, slot_end)
      StFor(slot_pat, slot_src, st_body, slot_start, slot_end) => StFor(slot_pat, slot_src, st_body, slot_start, slot_end)
      StContinue(slot_start, slot_end) => StContinue(slot_start, slot_end)
