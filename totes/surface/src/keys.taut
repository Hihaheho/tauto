// The program with its declarations named by id (`docs/design/name-identity.md`):
// a stage that still looks names up as text reads the key of a declaration's
// id (`surface_name_text`) where it reads the name, at the declaration and at
// every use of it, so two declarations spelled alike are never taken for one
// another. The words of the names stay in the `DeclTable`, for what is shown
// (`restore_names`).
//
// A type, a function, a theorem and a definition of the program are keyed.
// A member written under its type (`T::C`, `T::f`) is keyed under the key of
// its type (`key(T)::C`), since the stages build such names from the type's
// name; a constructor written bare keeps its spelling, as the stages register
// constructors under their bare names too. The rest keeps its spelling:
// what the program does not declare (the prelude, an import), what it
// declares under one spelling more than once, a local binding, classes and
// their methods, effects, `extern` blocks, and the names the stages read as
// words (`surface_key_words`).

// The names the checker reads as words: a program may declare one of these
// to be the type or function the checker means by it (`enum Int` of a program
// without the prelude), so they keep their spelling.
pub fn surface_key_words(): List(Text) {
  ["Nat", "Int", "Bool", "Unit", "Text", "Float", "Decimal", "Never", "Slice", "Vec",
   "Ref", "Mutex", "Weak", "Signal", "Slots", "Atomic", "Buf",
   "PartialEq", "DecEq", "Div", "DivZero", "Info", "Type", "Task", "Option", "List",
   "Result", "Eq", "Zero", "Succ", "Tauto", "Array", "UHost", "Pair", "Prod", "Sum",
   "Empty", "True", "False", "Ordering", "main", "LoopExpr", "BreakStmt",
   "ContinueStmt", "LabelDecl", "Float32", "i32", "i64", "u8", "u32", "u64", "uhost", "nat", "Sigma", "Exists", "And", "Or", "Not", "Iff"]
}

pub fn surface_key_text_in(t: Text, ts: List(Text)): Bool {
  match ts {
    Nil => false
    Cons(x, rest) => Text::eq(x, t) || surface_key_text_in(t, rest)
  }
}

// The kinds of declaration that are keyed.
pub fn surface_key_kind(kind: Text): Bool {
  surface_key_text_in(kind, ["fn", "theorem", "def", "struct", "enum", "inductive", "effect", "class"])
}

// How many declarations other than constructors are spelled `t`, up to two,
// and whether they are all `id`.
pub fn surface_key_spelled(ds: List(SurfaceDecl), t: Text, id: DeclId): Bool {
  match ds {
    Nil => true
    Cons(d, rest) => if Text::eq(d.name, t) && Text::eq(d.kind, "ctor") == false && decl_id_eq(d.id, id) == false {
      false
    } else {
      surface_key_spelled(rest, t, id)
    }
  }
}

// The spellings of `id` other than `t`, outside constructors.
pub fn surface_key_one_spelling(ds: List(SurfaceDecl), t: Text, id: DeclId): Bool {
  match ds {
    Nil => true
    Cons(d, rest) => if decl_id_eq(d.id, id) && Text::eq(d.name, t) == false {
      false
    } else {
      surface_key_one_spelling(rest, t, id)
    }
  }
}

pub fn surface_key_qualified(t: Text): Bool {
  match text_find(t, "::", 0) {
    None => false
    Some(^at) => true
  }
}

// Each keyed spelling, with its key.
pub fn surface_key_data_names(ds: List(SurfaceData)): List(Text) {
  match ds {
    Nil => Nil
    Cons(d, rest) => Cons(d.name, surface_key_data_names(rest))
  }
}

pub fn surface_key_fn_names(fs: List(SurfaceFn)): List(Text) {
  match fs {
    Nil => Nil
    Cons(f, rest) => Cons(f.name, surface_key_fn_names(rest))
  }
}

// The names an `extern` block declares: the stages read the blocks by these
// words, so they keep their spelling wherever they are written.
pub fn surface_key_extern_names(stmts: List(SurfaceStmt)): List(Text) {
  match stmts {
    Nil => Nil
    Cons(st, rest) => List::append(
      match st {
        StExtern(fns, ^instances, types, structs, enums, ^start, ^end) => List::append(
          surface_key_fn_names(fns),
          List::append(surface_key_data_names(types), List::append(surface_key_data_names(structs), surface_key_data_names(enums)))
        )
        _ => Nil
      },
      surface_key_extern_names(rest)
    )
  }
}

pub fn surface_key_names_from(all: List(SurfaceDecl), ds: List(SurfaceDecl), kept: Ordmap(Text, Bool)): List(Text × Text) {
  match ds {
    Nil => Nil
    Cons(d, rest) => {
      let plain := surface_key_kind(d.kind) && surface_text_is_spelling(d.name) && surface_key_qualified(d.name) == false
      let alone := surface_key_spelled(all, d.name, d.id) && surface_key_one_spelling(all, d.name, d.id)
      if plain && alone && surface_key_text_in(d.name, surface_key_words()) == false && Ordmap::contains(kept, d.name, Ordmap::compare_text) == false {
      Cons(#(d.name, surface_name_text(NameGlobal(d.id))), surface_key_names_from(all, rest, kept))
    } else {
      surface_key_names_from(all, rest, kept)
    }
    }
  }
}

pub fn surface_key_kept(m: Ordmap(Text, Bool), ts: List(Text)): Ordmap(Text, Bool) {
  match ts {
    Nil => m
    Cons(t, rest) => surface_key_kept(Ordmap::insert(m, t, true, Ordmap::compare_text), rest)
  }
}

pub fn surface_key_decl_names(ds: List(SurfaceDecl)): List(Text) {
  match ds {
    Nil => Nil
    Cons(d, rest) => Cons(d.name, surface_key_decl_names(rest))
  }
}

// A method of a keyed class, written bare (`m` of `C::m`), is read under the
// class's key as its qualified spelling is (`key(C)::m`), when no other
// declaration is spelled `m`.
pub fn surface_key_methods(all: List(SurfaceDecl), ds: List(SurfaceDecl), names: List(Text × Text)): List(Text × Text) {
  match ds {
    Nil => Nil
    Cons(d, rest) => {
      let more := surface_key_methods(all, rest, names)
      if Text::eq(d.kind, "method") {
        match text_find(d.name, "::", 0) {
          None => more
          Some(at) => {
            let bare := Text::slice_or_empty(d.name, Nat::add(at, 2), Text::len(d.name))
            let keyed := surface_key_text(SurfaceKeyEnvMk(Nil, names), d.name)
            if Text::eq(keyed, d.name) == false && surface_key_spelled(all, bare, d.id) {
              Cons(#(bare, keyed), more)
            } else {
              more
            }
          }
        }
      } else {
        more
      }
    }
  }
}

// `outer`: what the program is read with (the prelude). A declaration
// spelled as one of its declarations keeps its spelling for now, as the
// stages it is compared with still take the two for one.
pub fn surface_key_names(ds: List(SurfaceDecl), stmts: List(SurfaceStmt), outer: List(SurfaceStmt)): List(Text × Text) {
  let kept := surface_key_kept(Ordmap::empty(), surface_key_extern_names(stmts))
  let names := surface_key_names_from(ds, ds, surface_key_kept(kept, surface_key_decl_names(surface_decls(outer))))
  List::append(surface_key_methods(ds, ds, names), names)
}

pub fn surface_key_lookup(names: List(Text × Text), t: Text): Option(Text) {
  match names {
    Nil => None
    Cons(p, rest) => if Text::eq(p.fst, t) { Some(p.snd) } else { surface_key_lookup(rest, t) }
  }
}

// What the keyed stages read and what the resolver found.
pub(open) inductive SurfaceKeyEnv: Type {
  SurfaceKeyEnvMk(uses: List(SurfaceUse), names: List(Text × Text)): SurfaceKeyEnv
}

// The text a name written `t` is read as: its key when it is keyed, `key(T)`
// in place of `T` when it is written under a keyed `T`, else `t`.
pub fn surface_key_text(e: SurfaceKeyEnv, t: Text): Text {
  match surface_key_lookup(e.names, t) {
    Some(k) => k
    None => match text_find(t, "::", 0) {
      None => t
      Some(at) => match surface_key_lookup(e.names, Text::slice_or_empty(t, 0, at)) {
        None => t
        Some(k) => Text::concat(k, Text::slice_or_empty(t, at, Text::len(t)))
      }
    }
  }
}

// A variable is keyed unless the resolver found it to be a local binding.
pub fn surface_key_is_local(uses: List(SurfaceUse), start: Nat, end: Nat, spelling: Text): Bool {
  match uses {
    Nil => false
    Cons(u, rest) => if u.start == start && u.end == end && Text::eq(u.spelling, spelling) {
      match u.name {
        NameLocal(^l) => true
        _ => false
      }
    } else {
      surface_key_is_local(rest, start, end, spelling)
    }
  }
}

pub fn surface_key_var(start: Nat, end: Nat, e: SurfaceKeyEnv, kind: SurfaceKind): SurfaceKind {
  match kind {
    SkVar(name) => ⊢ SurfaceKind from match name {
      NameSpelled(text) => if surface_key_is_local(e.uses, start, end, text) {
        kind
      } else {
        SkVar(NameSpelled(surface_key_text(e, text)))
      }
      NameGlobal(^d) => kind
      NameLocal(^l) => kind
    }
    _ => kind
  }
}

// A bound written on a type parameter (`<A: C>`): a class of the program is
// keyed.
pub fn surface_key_bound(e: SurfaceKeyEnv, b: Option(Text)): Option(Text) {
  match b {
    None => None
    Some(t) => Some(surface_key_text(e, t))
  }
}

pub fn surface_key_bounds(e: SurfaceKeyEnv, bs: List(Option(Text))): List(Option(Text)) {
  match bs {
    Nil => Nil
    Cons(b, rest) => Cons(surface_key_bound(e, b), surface_key_bounds(e, rest))
  }
}

pub fn surface_key_fn_name(e: SurfaceKeyEnv, f: SurfaceFn): SurfaceFn {
  match f {
    SurfaceFnMk(name, generics, bounds, params, r#borrows, param_types, result, effects, wheres, start, end, body, lends, generic_types, bound_starts, visibility, row_hole, unused, unused_generics, unused_params) => SurfaceFnMk(surface_key_text(e, name), generics, bounds, params, r#borrows, param_types, result, effects, wheres, start, end, body, lends, generic_types, bound_starts, visibility, row_hole, unused, unused_generics, unused_params)
  }
}

pub fn surface_key_theorem_name(e: SurfaceKeyEnv, t: SurfaceTheorem): SurfaceTheorem {
  match t {
    SurfaceTheoremMk(name, implicit, params, ty, body, start, end, unused, unused_params, t_vis) => SurfaceTheoremMk(surface_key_text(e, name), implicit, params, ty, body, start, end, unused, unused_params, t_vis)
  }
}

pub fn surface_key_inductive_name(e: SurfaceKeyEnv, i: SurfaceInductive): SurfaceInductive {
  match i {
    SurfaceInductiveMk(name, params, sort, constructors, start, end, visibility) => SurfaceInductiveMk(surface_key_text(e, name), params, sort, constructors, start, end, visibility)
  }
}

// A constructor spelled as its type (a struct's) is keyed with it.
pub fn surface_key_data_ctors(e: SurfaceKeyEnv, owner: Text, cs: List(SurfaceDataCtor)): List(SurfaceDataCtor) {
  match cs {
    Nil => Nil
    Cons(c, rest) => Cons(
      match c {
        SurfaceDataCtorMk(name, fields) => if Text::eq(name, owner) { SurfaceDataCtorMk(surface_key_text(e, name), fields) } else { c }
      },
      surface_key_data_ctors(e, owner, rest)
    )
  }
}

pub fn surface_key_data_name(e: SurfaceKeyEnv, d: SurfaceData): SurfaceData {
  match d {
    SurfaceDataMk(kind, name, generics, constructors, start, end, coerce_level, coerce_field, visibility, unused_generics, rows) => SurfaceDataMk(kind, surface_key_text(e, name), generics, surface_key_data_ctors(e, name, constructors), start, end, coerce_level, coerce_field, visibility, unused_generics, rows)
  }
}

