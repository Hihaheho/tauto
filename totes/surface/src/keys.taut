          slot_params,
          uses), surface_key_option_surfaceterm(slot_result, uses), slot_resume, slot_start, slot_end, surface_key_option_list_rowentry(slot_set, uses), slot_unused_generics, surface_key_bounds(uses, slot_bounds), e_vis, slot_rows)
    }
