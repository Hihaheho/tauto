  pub fn surface_apply_surfacekind(value: SurfaceKind, uses: List(SurfaceUse)): SurfaceKind {
    match value {
      SkVar(slot_name) => SkVar(slot_name)
      SkNat(slot_digits) => SkNat(slot_digits)
      SkFloat(slot_digits) => SkFloat(slot_digits)
      SkRow(slot_effects) => SkRow(slot_effects)
      SkText(slot_value) => SkText(slot_value)
      SkBool(slot_value) => SkBool(slot_value)
      SkApp(slot_head, slot_args) => SkApp(
        surface_apply_surfaceterm(slot_head, uses),
        surface_apply_list_surfaceterm_from(slot_args, uses)
      )
      SkPi(slot_params, slot_result, slot_effects) => SkPi(
        surface_apply_list_surfaceparam_from(slot_params, uses),
        surface_apply_surfaceterm(slot_result, uses),
        slot_effects
      )
      SkExists(slot_binder, slot_domain, slot_body, unused) => SkExists(slot_binder, surface_apply_surfaceterm(slot_domain, uses), surface_apply_surfaceterm(slot_body, uses), unused)
      SkLam(slot_params, slot_body, slot_types, unused) => SkLam(
        slot_params,
        surface_apply_surfaceterm(slot_body, uses),
        slot_types,
        unused
      )
      SkUnion(slot_parts) => SkUnion(
        surface_apply_list_surfaceterm_from(slot_parts, uses)
      )
      SkTagged(slot_tag, slot_value) => SkTagged(
        slot_tag,
        surface_apply_surfaceterm(slot_value, uses)
      )
      SkIf(slot_cond, slot_then, slot_otherwise) => SkIf(
        surface_apply_surfaceterm(slot_cond, uses),
        surface_apply_surfaceterm(slot_then, uses),
        surface_apply_option_surfaceterm(slot_otherwise, uses)
      )
      SkField(slot_value, slot_name) => SkField(
        surface_apply_surfaceterm(slot_value, uses),
        slot_name
      )
      SkBlock(slot_stmts) => SkBlock(
        surface_apply_list_surfacestmt_from(slot_stmts, uses)
      )
      SkPerform(slot_op, slot_args) => SkPerform(
        slot_op,
        surface_apply_list_surfaceterm_from(slot_args, uses)
      )
      SkHandle(slot_body, slot_handlers) => SkHandle(
        surface_apply_surfaceterm(slot_body, uses),
        surface_apply_list_surfacehandler_from(slot_handlers, uses)
      )
      SkBudget(slot_memory, slot_amount, slot_body) => SkBudget(
        slot_memory,
        surface_apply_surfaceterm(slot_amount, uses),
        surface_apply_surfaceterm(slot_body, uses)
      )
      SkMatch(slot_scrutinee, slot_motive, slot_arms, slot_binder, slot_binder_unused) => SkMatch(
        surface_apply_surfaceterm(slot_scrutinee, uses),
        surface_apply_option_surfaceterm(slot_motive, uses),
        surface_apply_list_surfacearm_from(slot_arms, uses),
        slot_binder,
        slot_binder_unused
      )
      SkHole(slot_name) => SkHole(slot_name)
      SkRecord(slot_name, slot_fields) => SkRecord(
        slot_name,
        surface_apply_list_surfacefield_from(slot_fields, uses)
      )
      SkBorrow(slot_mutable, slot_mutable_orig, slot_value) => SkBorrow(
        slot_mutable, slot_mutable_orig,
        surface_apply_surfaceterm(slot_value, uses)
      )
      SkFnKind(slot_kind, slot_ty) => SkFnKind(
        slot_kind,
        surface_apply_surfaceterm(slot_ty, uses)
      )
      SkBorrowLam(slot_borrows, slot_lam) => SkBorrowLam(
        slot_borrows,
        surface_apply_surfaceterm(slot_lam, uses)
      )
      SkOther(slot_what) => SkOther(slot_what)
      SkMacroCall(slot_name, slot_arg) => SkMacroCall(
        slot_name,
        surface_apply_surfaceterm(slot_arg, uses)
      )
      SkQuote(slot_stmts_form, slot_stmts) => SkQuote(
        slot_stmts_form,
        surface_apply_list_surfacestmt_from(slot_stmts, uses)
      )
      SkSplice(slot_value) => SkSplice(
        surface_apply_surfaceterm(slot_value, uses)
      )
      SkSyntaxLit(slot_name, slot_body) => SkSyntaxLit(slot_name, slot_body)
      SkStep(slot_tactic, slot_arg, slot_call_start, slot_call_end, slot_before, slot_arms) => SkStep(
        slot_tactic,
        surface_apply_surfaceterm(slot_arg, uses),
        slot_call_start,
        slot_call_end,
        surface_apply_option_surfaceterm(slot_before, uses),
        surface_apply_list_surfacesteparm_from(slot_arms, uses)
      )
      SkAscribe(slot_value, slot_ty) => SkAscribe(
        surface_apply_surfaceterm(slot_value, uses),
        surface_apply_surfaceterm(slot_ty, uses)
      )
    }
  }

  pub fn surface_apply_surfacelaw(value: SurfaceLaw, uses: List(SurfaceUse)): SurfaceLaw {
    match value {
      SurfaceLawMk(slot_name, slot_start, slot_end, slot_theorem) => SurfaceLawMk(
        slot_name,
        slot_start,
        slot_end,
        surface_apply_surfacetheorem(slot_theorem, uses)
      )
    }
  }

