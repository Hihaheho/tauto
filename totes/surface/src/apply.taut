          slot_wheres,
          uses), surface_apply_list_surfacefn_from(slot_methods, uses), surface_apply_list_surfacelaw_from(slot_laws, uses), slot_start, slot_end, surface_apply_list_surfaceterm_from(
          slot_generic_types,
          uses), surface_apply_list_surfaceterm_from(slot_arguments, uses), slot_infer_from, slot_unused_generics)
    }
