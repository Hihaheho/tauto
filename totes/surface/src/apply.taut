  pub fn surface_apply_surfacefn(value: SurfaceFn, uses: List(SurfaceUse)): SurfaceFn {
    match value {
      SurfaceFnMk(slot_name, slot_generics, slot_bounds, slot_params, slot_borrows, slot_param_types, slot_result, slot_effects, slot_wheres, slot_start, slot_end, slot_body, slot_lends, slot_generic_types, slot_bound_starts, slot_visibility, slot_row_hole, slot_unused, slot_unused_generics, slot_unused_params) => SurfaceFnMk(slot_name, slot_generics, slot_bounds, slot_params, slot_borrows, surface_apply_list_option_surfaceterm_from(
          slot_param_types,
          uses), surface_apply_option_surfaceterm(slot_result, uses), slot_effects, surface_apply_list_surfaceconstraint_from(
          slot_wheres,
          uses), slot_start, slot_end, surface_apply_surfaceterm(slot_body, uses), slot_lends, surface_apply_list_surfaceterm_from(
          slot_generic_types,
          uses), slot_bound_starts, slot_visibility, slot_row_hole, slot_unused, slot_unused_generics, slot_unused_params)
    }
    }

  pub fn surface_apply_surfacehandler(
    value: SurfaceHandler,
    uses: List(SurfaceUse)
  ): SurfaceHandler {
    match value {
      HdReturn(slot_pattern, slot_body) => HdReturn(
        surface_apply_surfacepattern(slot_pattern, uses),
        surface_apply_surfaceterm(slot_body, uses)
      )
      HdOperation(slot_op, slot_binds, slot_types, slot_patterns, slot_resume, slot_cont_unused, slot_guard, slot_body) => HdOperation(
        slot_op,
        slot_binds,
        surface_apply_list_surfaceterm_from(slot_types, uses),
        surface_apply_list_surfacepattern_from(
          slot_patterns,
          uses),
        slot_resume,
        slot_cont_unused,
        surface_apply_option_surfaceterm(slot_guard, uses),
        surface_apply_surfaceterm(slot_body, uses)
      )
    }
  }

