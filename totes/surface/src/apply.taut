import "../../identity/src/identity.taut"
import "../../text/src/text.taut"
import std::base
import std::text

// Puts what `surface_resolve` found into the syntax it read: a variable that
// resolved to a declaration or a local binding carries that id instead of
// its spelling (`docs/design/name-identity.md`). The uses are matched by
// span; a variable the resolver left spelled (an import, the prelude, an
// ambiguous constructor) stays `NameSpelled`.

// The name the resolver gave the variable at `start..end`, if it did.
pub fn surface_apply_find(uses: List(SurfaceUse), start: Nat, end: Nat, spelling: Text): Option(SurfaceName) {
  match uses {
    Nil => None
    Cons(u, rest) => if u.start == start && u.end == end && Text::eq(u.spelling, spelling) {
      Some(u.name)
    } else {
      surface_apply_find(rest, start, end, spelling)
    }
  }
}

pub fn surface_apply_var(start: Nat, end: Nat, uses: List(SurfaceUse), kind: SurfaceKind): SurfaceKind {
  match kind {
    SkVar(name) => ⊢ SurfaceKind from match name {
      NameSpelled(text) => ⊢ SurfaceKind from match surface_apply_find(uses, start, end, text) {
        Some(found) => SkVar(found)
        None => kind
      }
      NameGlobal(^d) => kind
      NameLocal(^l) => kind
    }
    _ => kind
  }
}

mutual {
  pub fn surface_apply_list_option_surfaceterm_from(
    value: List(Option(SurfaceTerm)),
    uses: List(SurfaceUse)
  ): List(Option(SurfaceTerm)) {
    match value {
      Nil => Nil
      Cons(item, rest) => Cons(
        surface_apply_option_surfaceterm(item, uses),
        surface_apply_list_option_surfaceterm_from(rest, uses)
      )
    }
  }

