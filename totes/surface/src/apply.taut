// The program with the names its resolution found.
pub fn surface_apply_program(stmts: List(SurfaceStmt), uses: List(SurfaceUse)): List(SurfaceStmt) {
  surface_apply_list_surfacestmt(stmts, uses)
}

// The display text of the declarations by id, for what shows a name that has
// been resolved: each id shown as the first spelling it was given. Ids are
// handed out in order, so a declaration whose id is the next one is a new one.
pub fn surface_decl_table_from(ds: List(SurfaceDecl), t: DeclTable): DeclTable {
  match ds {
    Nil => t
    Cons(d, rest) => if decl_id_index(d.id) == decl_table_size(t) {
      surface_decl_table_from(rest, decl_table_add(t, d.name))
    } else {
      surface_decl_table_from(rest, t)
    }
  }
}

// A program read once: its syntax with the resolved names carried as ids, and
// the display text of its declarations.
pub(open) inductive SurfaceResolvedProgram: Type {
  SurfaceResolvedProgramMk(stmts: List(SurfaceStmt), table: DeclTable): SurfaceResolvedProgram
}

pub fn surface_resolve_program(stmts: List(SurfaceStmt)): SurfaceResolvedProgram {
  let resolved := surface_resolve(stmts)
  SurfaceResolvedProgramMk(
    surface_apply_program(stmts, resolved.uses),
    surface_decl_table_from(resolved.decls, decl_table_empty())
  )
}
