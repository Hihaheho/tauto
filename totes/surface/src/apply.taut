    value: SurfaceNamed,
    uses: List(SurfaceUse)
  ): SurfaceNamed {
    match value {
      SurfaceNamedMk(slot_name, slot_ty) => SurfaceNamedMk(
        slot_name,
        surface_apply_surfaceterm(slot_ty, uses)
      )
    }
  }

  pub fn surface_apply_surfaceparam(
    value: SurfaceParam,
    uses: List(SurfaceUse)
  ): SurfaceParam {
    match value {
      SurfaceParamMk(slot_name, slot_ty, unused) => SurfaceParamMk(
        slot_name,
        surface_apply_surfaceterm(slot_ty, uses),
        unused
      )
    }
  }

  pub fn surface_apply_surfacepattern(
    value: SurfacePattern,
    uses: List(SurfaceUse)
  ): SurfacePattern {
    match value {
      PtWild => PtWild
      PtBind(slot_name, unused) => PtBind(slot_name, unused)
      PtInt(slot_negative, slot_magnitude) => PtInt(slot_negative, slot_magnitude)
      PtBool(slot_value) => PtBool(slot_value)
      PtText(slot_value) => PtText(slot_value)
      PtCtor(slot_name, slot_args) => PtCtor(
        slot_name,
        surface_apply_list_surfacepattern_from(slot_args, uses)
      )
      PtRecord(slot_name, slot_fields) => PtRecord(
        slot_name,
        surface_apply_list_surfacepatternfield_from(
          slot_fields,
          uses)
      )
      PtTyped(slot_name, slot_ty, slot_unused) => PtTyped(
        slot_name,
        surface_apply_surfaceterm(slot_ty, uses),
        slot_unused
      )
      PtOther(slot_what) => PtOther(slot_what)
    }
  }

  pub fn surface_apply_surfacepatternfield(
    value: SurfacePatternField,
    uses: List(SurfaceUse)
  ): SurfacePatternField {
    match value {
      SurfacePatternFieldMk(slot_name, slot_pattern) => SurfacePatternFieldMk(
        slot_name,
        surface_apply_surfacepattern(slot_pattern, uses)
      )
    }
  }

  pub fn surface_apply_surfacesteparm(
    value: SurfaceStepArm,
    uses: List(SurfaceUse)
  ): SurfaceStepArm {
    match value {
      SurfaceStepArmMk(slot_binders, slot_unused_binders, slot_goal, slot_body, slot_start, slot_end) => SurfaceStepArmMk(
        surface_apply_list_surfacefield_from(slot_binders, uses),
        slot_unused_binders,
        surface_apply_surfaceterm(slot_goal, uses),
        surface_apply_surfaceterm(slot_body, uses),
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_apply_surfacestmt(value: SurfaceStmt, uses: List(SurfaceUse)): SurfaceStmt {
    match value {
      StLet(slot_name, slot_ty, slot_value, slot_borrow, slot_mutable, unused, st_stack) => StLet(slot_name, surface_apply_option_surfaceterm(slot_ty, uses), surface_apply_surfaceterm(slot_value, uses), slot_borrow, slot_mutable, unused, st_stack)
      StVar(slot_name, slot_ty, slot_value, slot_borrow, unused, st_stack) => StVar(slot_name, surface_apply_option_surfaceterm(slot_ty, uses), surface_apply_surfaceterm(slot_value, uses), slot_borrow, unused, st_stack)
      StAssign(slot_name, slot_place, slot_value) => StAssign(
        slot_name,
        surface_apply_option_surfaceterm(slot_place, uses),
        surface_apply_surfaceterm(slot_value, uses)
      )
      StCalled(slot_generates, slot_call) => StCalled(
        slot_generates,
        surface_apply_surfaceterm(slot_call, uses)
      )
      StAttributed(slot_name, slot_arg, slot_generates, slot_stmt) => StAttributed(
        slot_name,
        surface_apply_surfaceterm(slot_arg, uses),
        slot_generates,
        surface_apply_surfacestmt(slot_stmt, uses)
      )
      StFn(slot_f) => StFn(surface_apply_surfacefn(slot_f, uses))
      StTheorem(slot_t) => StTheorem(
        surface_apply_surfacetheorem(slot_t, uses)
      )
      StDef(slot_t) => StDef(
        surface_apply_surfacetheorem(slot_t, uses)
      )
      StMutual(slot_stmts, slot_start, slot_end) => StMutual(
        surface_apply_list_surfacestmt_from(slot_stmts, uses),
        slot_start,
        slot_end
      )
      StModule(slot_name, slot_visibility, slot_items, slot_start, slot_end) => StModule(
        slot_name,
        slot_visibility,
        surface_apply_list_surfacestmt_from(slot_items, uses),
        slot_start,
        slot_end
      )
      StReexport(slot_path, slot_names, slot_spans, slot_start, slot_end) => StReexport(slot_path, slot_names, slot_spans, slot_start, slot_end)
      StImport(slot_path, slot_start, slot_end) => StImport(slot_path, slot_start, slot_end)
      StInductive(slot_i) => StInductive(
        surface_apply_surfaceinductive(slot_i, uses)
      )
      StEffect(slot_e) => StEffect(
        surface_apply_surfaceeffect(slot_e, uses)
      )
      StStruct(slot_d) => StStruct(
        surface_apply_surfacedata(slot_d, uses)
      )
      StEnum(slot_d) => StEnum(
        surface_apply_surfacedata(slot_d, uses)
      )
      StExtern(slot_fns, slot_instances, slot_types, slot_structs, slot_enums, slot_start, slot_end) => StExtern(
        surface_apply_list_surfacefn_from(slot_fns, uses),
        slot_instances,
        slot_types,
        slot_structs,
        slot_enums,
        slot_start,
        slot_end
      )
      StClass(slot_c) => StClass(
        surface_apply_surfaceclass(slot_c, uses)
      )
      StInstance(slot_i) => StInstance(
        surface_apply_surfaceinstance(slot_i, uses)
      )
      StWhile(slot_cond, slot_body) => StWhile(
        surface_apply_surfaceterm(slot_cond, uses),
        surface_apply_surfaceterm(slot_body, uses)
      )
      StReturn(slot_value) => StReturn(
        surface_apply_option_surfaceterm(slot_value, uses)
      )
      StExpr(slot_value) => StExpr(
        surface_apply_surfaceterm(slot_value, uses)
      )
      StOther(slot_what, slot_start, slot_end) => StOther(slot_what, slot_start, slot_end)
      StLoop(^st_body, slot_start, slot_end) => StOther("LoopExpr", slot_start, slot_end)
      StFor(^for_pat, ^for_src, ^st_body, slot_start, slot_end) => StOther("ForStmt", slot_start, slot_end)
      StBreak(^st_value, slot_start, slot_end) => StOther("BreakStmt", slot_start, slot_end)
      StContinue(slot_start, slot_end) => StOther("ContinueStmt", slot_start, slot_end)
      StMacro(slot_name, slot_function, slot_start, slot_end) => StMacro(
        slot_name,
        slot_function,
        slot_start,
        slot_end
      )
      StSyntax(slot_name, slot_grammar, slot_start, slot_end) => StSyntax(
        slot_name,
        slot_grammar,
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_apply_surfaceterm(value: SurfaceTerm, uses: List(SurfaceUse)): SurfaceTerm {
    match value {
      SurfaceTermIndexedMk(slot_kind, slot_start, slot_end, slot_old_occurrence) =>
      SurfaceTermIndexedMk(
        surface_apply_var(slot_start, slot_end, uses, surface_apply_surfacekind(slot_kind, uses)),
        slot_start,
        slot_end,
        slot_old_occurrence
      )
    }
  }

  pub fn surface_apply_surfacetheorem(
    value: SurfaceTheorem,
    uses: List(SurfaceUse)
  ): SurfaceTheorem {
    match value {
      SurfaceTheoremMk(slot_name, slot_implicit, slot_params, slot_ty, slot_body, slot_start, slot_end, slot_unused, slot_unused_params, t_vis) => SurfaceTheoremMk(slot_name, slot_implicit, surface_apply_list_surfacenamed_from(slot_params, uses), surface_apply_surfaceterm(slot_ty, uses), surface_apply_option_surfaceterm(slot_body, uses), slot_start, slot_end, slot_unused, slot_unused_params, t_vis)
    }
    }

}

pub fn surface_apply_list_option_surfaceterm(
  value: List(Option(SurfaceTerm)),
  uses: List(SurfaceUse)
): List(Option(SurfaceTerm)) {
  surface_apply_list_option_surfaceterm_from(value, uses)
}

