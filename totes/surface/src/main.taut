import "surface.taut"
import "dump.taut"
import "../../syntax/src/syntax.taut"
import "../../text/src/text.taut"
import "../../unicode/src/classes.taut"
import "../../unicode/src/unicode.taut"
import std::Text
import std::prelude::Os

// Prints `== <path>` and the dump of the program read from each file given on
// the command line, or `error` (the differential test's input,
// `docs/design/self-host.md`). With `--base N` first, the spans start at N.

pub fn surface_main_each(
  &t: SyntaxTables,
  classes: UnicodeClasses,
  base: Nat,
  paths: List(Text)
): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match surface_parse_program(t, classes, source, base) {
          Some(stmts) => print(surface_dump(stmts))
          None => print(Text::concat_all(Cons("error", Cons(text_newline(), Nil))))
        }
      }
      surface_main_each(t, classes, base, rest)
    }
  }
}

match syntax_tables() {
  None => eprint("the tables of the syntax are damaged")
  Some(t) => match perform argv() {
    Nil => #()
    Cons(first, rest) => if first == "--base" {
      match rest {
        Nil => #()
        Cons(n, paths) => match text_parse_u64(n) {
          Some(base) => surface_main_each(t, unicode_classes(), base, paths)
          None => eprint("--base takes a number")
        }
      }
    } else {
      surface_main_each(t, unicode_classes(), 0, Cons(first, rest))
    }
  }
}
