// Prints `== <path>` and the dump of the program read from each file given on
// the command line, or `error` (the differential test's input,
// `docs/design/self-host.md`). With `--base N` first, the spans start at N.

fn surface_main_each(&t: SyntaxTables, classes: UnicodeClasses, base: u64, paths: List(Text)) -> () {
  match paths {
    Nil => ()
    Cons(path, rest) => {
      os_print(text_concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match os_read_file(path) {
        Err(
          e
        ) => os_print(text_concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match surface_parse_program(t, classes, source, base) {
          Some(stmts) => os_print(surface_dump(stmts))
          None => os_print(text_concat_all(Cons("error", Cons(text_newline(), Nil))))
        }
      }
      surface_main_each(t, classes, base, rest)
    }
  }
}

match syntax_tables() {
  None => os_eprint("the tables of the syntax are damaged")
  Some(t) => match os_args() {
    Nil => ()
    Cons(first, rest) => if first == "--base" {
      match rest {
        Nil => ()
        Cons(n, paths) => match text_parse_u64(n) {
          Some(base) => surface_main_each(t, unicode_classes(), base, paths)
          None => os_eprint("--base takes a number")
        }
      }
    } else {
      surface_main_each(t, unicode_classes(), 0, Cons(first, rest))
    }
  }
}
