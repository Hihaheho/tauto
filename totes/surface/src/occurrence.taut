// Prelude and program use distinct root namespaces.
pub fn surface_index_program(stmts: List(SurfaceStmt), namespace: Nat): List(SurfaceStmt) {
  surface_index_list_surfacestmt(stmts, Cons(namespace, Nil), true)
}

pub fn surface_erase_occurrences(term: SurfaceTerm): SurfaceTerm {
  surface_index_surfaceterm(term, Nil, false)
}
