  }

  pub fn surface_index_option_surfaceterm(
    value: Option(SurfaceTerm),
    path: List(Nat),
    keep: Bool
  ): Option(SurfaceTerm) {
    match value: Option(SurfaceTerm) {
      None => None
      Some(item) => Some(surface_index_surfaceterm(item, surface_index_child(path, 0), keep))
    }
  }

  pub fn surface_index_surfacearm(value: SurfaceArm, path: List(Nat), keep: Bool): SurfaceArm {
    match value: SurfaceArm {
      SurfaceArmMk(slot_pattern, slot_guard, slot_goal, slot_body) => SurfaceArmMk(
        surface_index_surfacepattern(slot_pattern, surface_index_child(path, 0), keep),
        surface_index_option_surfaceterm(slot_guard, surface_index_child(path, 1), keep),
        surface_index_option_surfaceterm(slot_goal, surface_index_child(path, 2), keep),
        surface_index_surfaceterm(slot_body, surface_index_child(path, 3), keep)
      )
    }
  }

  pub fn surface_index_surfaceclass(value: SurfaceClass, path: List(Nat), keep: Bool): SurfaceClass {
    match value: SurfaceClass {
      SurfaceClassMk(
        slot_name,
        slot_param,
        slot_arity,
        slot_bound,
        slot_methods,
        slot_laws,
        slot_start,
        slot_end
      ) => SurfaceClassMk(
        slot_name,
        slot_param,
        slot_arity,
        slot_bound,
        surface_index_list_surfacefn_from(slot_methods, surface_index_child(path, 4), keep, 0),
        surface_index_list_surfacelaw_from(slot_laws, surface_index_child(path, 5), keep, 0),
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_index_surfaceconstraint(
    value: SurfaceConstraint,
    path: List(Nat),
    keep: Bool
  ): SurfaceConstraint {
    match value: SurfaceConstraint {
      SurfaceConstraintMk(slot_class, slot_ty, slot_start, slot_end) => SurfaceConstraintMk(
        slot_class,
        surface_index_surfaceterm(slot_ty, surface_index_child(path, 1), keep),
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_index_surfacector(value: SurfaceCtor, path: List(Nat), keep: Bool): SurfaceCtor {
    match value: SurfaceCtor {
      SurfaceCtorMk(slot_name, slot_implicit, slot_params, slot_result) => SurfaceCtorMk(
        slot_name,
        slot_implicit,
        surface_index_list_surfacenamed_from(slot_params, surface_index_child(path, 2), keep, 0),
        surface_index_surfaceterm(slot_result, surface_index_child(path, 3), keep)
      )
    }
  }

  pub fn surface_index_surfacedata(value: SurfaceData, path: List(Nat), keep: Bool): SurfaceData {
    match value: SurfaceData {
      SurfaceDataMk(
        slot_kind,
        slot_name,
        slot_generics,
        slot_constructors,
        slot_start,
        slot_end
      ) => SurfaceDataMk(
        slot_kind,
        slot_name,
        slot_generics,
        surface_index_list_surfacedatactor_from(
          slot_constructors,
          surface_index_child(path, 3),
          keep,
          0
        ),
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_index_surfacedatactor(
    value: SurfaceDataCtor,
    path: List(Nat),
    keep: Bool
  ): SurfaceDataCtor {
    match value: SurfaceDataCtor {
      SurfaceDataCtorMk(slot_name, slot_fields) => SurfaceDataCtorMk(
        slot_name,
        surface_index_list_surfacedatafield_from(slot_fields, surface_index_child(path, 1), keep, 0)
      )
    }
  }

  pub fn surface_index_surfacedatafield(
    value: SurfaceDataField,
    path: List(Nat),
    keep: Bool
  ): SurfaceDataField {
    match value: SurfaceDataField {
      SurfaceDataFieldMk(slot_name, slot_ty) => SurfaceDataFieldMk(
        slot_name,
        surface_index_surfaceterm(slot_ty, surface_index_child(path, 1), keep)
      )
    }
  }

  pub fn surface_index_surfaceeffect(
    value: SurfaceEffect,
    path: List(Nat),
    keep: Bool
  ): SurfaceEffect {
    match value: SurfaceEffect {
      SurfaceEffectMk(
        slot_name,
        slot_generics,
        slot_params,
        slot_result,
        slot_resume,
        slot_start,
        slot_end,
        slot_set
      ) => SurfaceEffectMk(
        slot_name,
        slot_generics,
        surface_index_list_option_surfaceterm_from(
          slot_params,
          surface_index_child(path, 2),
          keep,
          0
        ),
        surface_index_option_surfaceterm(slot_result, surface_index_child(path, 3), keep),
        slot_resume,
        slot_start,
        slot_end,
        slot_set
      )
    }
  }

  pub fn surface_index_surfacefield(value: SurfaceField, path: List(Nat), keep: Bool): SurfaceField {
    match value: SurfaceField {
      SurfaceFieldMk(slot_name, slot_value) => SurfaceFieldMk(
        slot_name,
        surface_index_surfaceterm(slot_value, surface_index_child(path, 1), keep)
      )
    }
  }

  pub fn surface_index_surfacefn(value: SurfaceFn, path: List(Nat), keep: Bool): SurfaceFn {
    match value: SurfaceFn {
      SurfaceFnMk(
        slot_name,
        slot_generics,
        slot_bounds,
        slot_params,
        slot_borrows,
        slot_param_types,
        slot_result,
        slot_effects,
        slot_wheres,
        slot_start,
        slot_end,
        slot_body
      ) => SurfaceFnMk(
        slot_name,
        slot_generics,
        slot_bounds,
        slot_params,
        slot_borrows,
        surface_index_list_option_surfaceterm_from(
          slot_param_types,
          surface_index_child(path, 5),
          keep,
          0
        ),
        surface_index_option_surfaceterm(slot_result, surface_index_child(path, 6), keep),
        slot_effects,
        surface_index_list_surfaceconstraint_from(
          slot_wheres,
          surface_index_child(path, 8),
          keep,
          0
        ),
        slot_start,
        slot_end,
        surface_index_surfaceterm(slot_body, surface_index_child(path, 11), keep)
      )
    }
  }

  pub fn surface_index_surfacehandler(
    value: SurfaceHandler,
    path: List(Nat),
    keep: Bool
  ): SurfaceHandler {
    match value: SurfaceHandler {
      HdReturn(slot_pattern, slot_body) => HdReturn(
        surface_index_surfacepattern(slot_pattern, surface_index_child(path, 0), keep),
        surface_index_surfaceterm(slot_body, surface_index_child(path, 1), keep)
      )
      HdOperation(
        slot_op,
        slot_binds,
        slot_types,
        slot_patterns,
        slot_resume,
        slot_guard,
        slot_body
      ) => HdOperation(
        slot_op,
        slot_binds,
        surface_index_list_surfaceterm_from(slot_types, surface_index_child(path, 2), keep, 0),
        surface_index_list_surfacepattern_from(
          slot_patterns,
          surface_index_child(path, 3),
          keep,
          0
        ),
        slot_resume,
        surface_index_option_surfaceterm(slot_guard, surface_index_child(path, 5), keep),
        surface_index_surfaceterm(slot_body, surface_index_child(path, 6), keep)
      )
    }
  }

  pub fn surface_index_surfaceinductive(
    value: SurfaceInductive,
    path: List(Nat),
    keep: Bool
  ): SurfaceInductive {
    match value: SurfaceInductive {
      SurfaceInductiveMk(
        slot_name,
        slot_params,
        slot_sort,
        slot_constructors,
        slot_start,
        slot_end
      ) => SurfaceInductiveMk(
        slot_name,
        surface_index_list_surfacenamed_from(slot_params, surface_index_child(path, 1), keep, 0),
        surface_index_surfaceterm(slot_sort, surface_index_child(path, 2), keep),
        surface_index_list_surfacector_from(
          slot_constructors,
          surface_index_child(path, 3),
          keep,
          0
        ),
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_index_surfaceinstance(
    value: SurfaceInstance,
    path: List(Nat),
    keep: Bool
  ): SurfaceInstance {
    match value: SurfaceInstance {
      SurfaceInstanceMk(
        slot_generics,
        slot_bounds,
        slot_class,
        slot_head,
        slot_wheres,
        slot_methods,
        slot_laws,
        slot_start,
        slot_end
      ) => SurfaceInstanceMk(
        slot_generics,
        slot_bounds,
        slot_class,
        surface_index_surfaceterm(slot_head, surface_index_child(path, 3), keep),
        surface_index_list_surfaceconstraint_from(
          slot_wheres,
          surface_index_child(path, 4),
          keep,
          0
        ),
        surface_index_list_surfacefn_from(slot_methods, surface_index_child(path, 5), keep, 0),
        surface_index_list_surfacelaw_from(slot_laws, surface_index_child(path, 6), keep, 0),
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_index_surfacekind(value: SurfaceKind, path: List(Nat), keep: Bool): SurfaceKind {
    match value: SurfaceKind {
      SkVar(slot_name) => SkVar(slot_name)
      SkNat(slot_digits) => SkNat(slot_digits)
      SkFloat(slot_digits) => SkFloat(slot_digits)
      SkRow(slot_effects) => SkRow(slot_effects)
      SkText(slot_value) => SkText(slot_value)
      SkBool(slot_value) => SkBool(slot_value)
      SkApp(slot_head, slot_args) => SkApp(
        surface_index_surfaceterm(slot_head, surface_index_child(path, 0), keep),
        surface_index_list_surfaceterm_from(slot_args, surface_index_child(path, 1), keep, 0)
      )
      SkPi(slot_params, slot_result, slot_effects) => SkPi(
        surface_index_list_surfaceparam_from(slot_params, surface_index_child(path, 0), keep, 0),
        surface_index_surfaceterm(slot_result, surface_index_child(path, 1), keep),
        slot_effects
      )
      SkExists(slot_binder, slot_domain, slot_body) => SkExists(
        slot_binder,
        surface_index_surfaceterm(slot_domain, surface_index_child(path, 1), keep),
        surface_index_surfaceterm(slot_body, surface_index_child(path, 2), keep)
      )
      SkLam(slot_params, slot_body) => SkLam(
        slot_params,
        surface_index_surfaceterm(slot_body, surface_index_child(path, 1), keep)
      )
      SkUnion(slot_parts) => SkUnion(
        surface_index_list_surfaceterm_from(slot_parts, surface_index_child(path, 0), keep, 0)
      )
      SkProduct(slot_members) => SkProduct(
        surface_index_list_surfaceterm_from(slot_members, surface_index_child(path, 0), keep, 0)
      )
      SkTagged(slot_tag, slot_value) => SkTagged(
        slot_tag,
        surface_index_surfaceterm(slot_value, surface_index_child(path, 1), keep)
      )
      SkIf(slot_cond, slot_then, slot_otherwise) => SkIf(
        surface_index_surfaceterm(slot_cond, surface_index_child(path, 0), keep),
        surface_index_surfaceterm(slot_then, surface_index_child(path, 1), keep),
        surface_index_option_surfaceterm(slot_otherwise, surface_index_child(path, 2), keep)
      )
      SkField(slot_value, slot_name) => SkField(
        surface_index_surfaceterm(slot_value, surface_index_child(path, 0), keep),
        slot_name
      )
      SkProject(slot_value, slot_ty) => SkProject(
        surface_index_surfaceterm(slot_value, surface_index_child(path, 0), keep),
        surface_index_surfaceterm(slot_ty, surface_index_child(path, 1), keep)
      )
      SkBlock(slot_stmts) => SkBlock(
        surface_index_list_surfacestmt_from(slot_stmts, surface_index_child(path, 0), keep, 0)
      )
      SkPerform(slot_op, slot_args) => SkPerform(
        slot_op,
        surface_index_list_surfaceterm_from(slot_args, surface_index_child(path, 1), keep, 0)
      )
      SkHandle(slot_body, slot_handlers) => SkHandle(
        surface_index_surfaceterm(slot_body, surface_index_child(path, 0), keep),
        surface_index_list_surfacehandler_from(slot_handlers, surface_index_child(path, 1), keep, 0)
      )
      SkBudget(slot_memory, slot_amount, slot_body) => SkBudget(
        slot_memory,
        surface_index_surfaceterm(slot_amount, surface_index_child(path, 1), keep),
        surface_index_surfaceterm(slot_body, surface_index_child(path, 2), keep)
      )
      SkMatch(slot_scrutinee, slot_motive, slot_arms, slot_binder) => SkMatch(
        surface_index_surfaceterm(slot_scrutinee, surface_index_child(path, 0), keep),
        surface_index_option_surfaceterm(slot_motive, surface_index_child(path, 1), keep),
        surface_index_list_surfacearm_from(slot_arms, surface_index_child(path, 2), keep, 0),
        slot_binder
      )
      SkHole(slot_name) => SkHole(slot_name)
      SkRecord(slot_name, slot_fields) => SkRecord(
        slot_name,
        surface_index_list_surfacefield_from(slot_fields, surface_index_child(path, 1), keep, 0)
      )
      SkBorrow(slot_mutable, slot_value) => SkBorrow(
        slot_mutable,
        surface_index_surfaceterm(slot_value, surface_index_child(path, 1), keep)
      )
      SkFnKind(slot_kind, slot_ty) => SkFnKind(
        slot_kind,
        surface_index_surfaceterm(slot_ty, surface_index_child(path, 1), keep)
      )
      SkBorrowLam(slot_borrows, slot_lam) => SkBorrowLam(
        slot_borrows,
        surface_index_surfaceterm(slot_lam, surface_index_child(path, 1), keep)
      )
      SkOther(slot_what) => SkOther(slot_what)
      SkMacroCall(slot_name, slot_arg) => SkMacroCall(
        slot_name,
        surface_index_surfaceterm(slot_arg, surface_index_child(path, 1), keep)
      )
      SkQuote(slot_stmts_form, slot_stmts) => SkQuote(
        slot_stmts_form,
        surface_index_list_surfacestmt_from(slot_stmts, surface_index_child(path, 1), keep, 0)
      )
      SkSplice(slot_value) => SkSplice(
        surface_index_surfaceterm(slot_value, surface_index_child(path, 0), keep)
      )
      SkSyntaxLit(slot_name, slot_body) => SkSyntaxLit(slot_name, slot_body)
      SkStep(
        slot_tactic,
        slot_arg,
        slot_call_start,
        slot_call_end,
        slot_before,
        slot_arms
      ) => SkStep(
        slot_tactic,
        surface_index_surfaceterm(slot_arg, surface_index_child(path, 1), keep),
        slot_call_start,
        slot_call_end,
        surface_index_option_surfaceterm(slot_before, surface_index_child(path, 4), keep),
        surface_index_list_surfacesteparm_from(slot_arms, surface_index_child(path, 5), keep, 0)
      )
    }
  }

  pub fn surface_index_surfacelaw(value: SurfaceLaw, path: List(Nat), keep: Bool): SurfaceLaw {
    match value: SurfaceLaw {
      SurfaceLawMk(slot_name, slot_start, slot_end) => SurfaceLawMk(slot_name, slot_start, slot_end)
    }
  }

  pub fn surface_index_surfacenamed(value: SurfaceNamed, path: List(Nat), keep: Bool): SurfaceNamed {
    match value: SurfaceNamed {
      SurfaceNamedMk(slot_name, slot_ty) => SurfaceNamedMk(
        slot_name,
        surface_index_surfaceterm(slot_ty, surface_index_child(path, 1), keep)
      )
    }
  }

  pub fn surface_index_surfaceparam(value: SurfaceParam, path: List(Nat), keep: Bool): SurfaceParam {
    match value: SurfaceParam {
      SurfaceParamMk(slot_name, slot_ty) => SurfaceParamMk(
        slot_name,
        surface_index_surfaceterm(slot_ty, surface_index_child(path, 1), keep)
      )
    }
  }

  pub fn surface_index_surfacepattern(
    value: SurfacePattern,
    path: List(Nat),
    keep: Bool
  ): SurfacePattern {
    match value: SurfacePattern {
      PtWild => PtWild
      PtBind(slot_name) => PtBind(slot_name)
      PtInt(slot_negative, slot_magnitude) => PtInt(slot_negative, slot_magnitude)
      PtBool(slot_value) => PtBool(slot_value)
      PtText(slot_value) => PtText(slot_value)
      PtCtor(slot_name, slot_args) => PtCtor(
        slot_name,
        surface_index_list_surfacepattern_from(slot_args, surface_index_child(path, 1), keep, 0)
      )
      PtRecord(slot_name, slot_fields) => PtRecord(
        slot_name,
        surface_index_list_surfacepatternfield_from(
          slot_fields,
          surface_index_child(path, 1),
          keep,
          0
        )
      )
      PtOther(slot_what) => PtOther(slot_what)
    }
  }

  pub fn surface_index_surfacepatternfield(
    value: SurfacePatternField,
    path: List(Nat),
    keep: Bool
  ): SurfacePatternField {
    match value: SurfacePatternField {
      SurfacePatternFieldMk(slot_name, slot_pattern) => SurfacePatternFieldMk(
        slot_name,
        surface_index_surfacepattern(slot_pattern, surface_index_child(path, 1), keep)
      )
    }
  }

  pub fn surface_index_surfacesteparm(
    value: SurfaceStepArm,
    path: List(Nat),
    keep: Bool
  ): SurfaceStepArm {
    match value: SurfaceStepArm {
      SurfaceStepArmMk(slot_binders, slot_goal, slot_body, slot_start, slot_end) => SurfaceStepArmMk(
        surface_index_list_surfacefield_from(slot_binders, surface_index_child(path, 0), keep, 0),
        surface_index_surfaceterm(slot_goal, surface_index_child(path, 1), keep),
        surface_index_surfaceterm(slot_body, surface_index_child(path, 2), keep),
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_index_surfacestmt(value: SurfaceStmt, path: List(Nat), keep: Bool): SurfaceStmt {
    match value: SurfaceStmt {
      StLet(slot_name, slot_ty, slot_value, slot_borrow, slot_mutable) => StLet(
        slot_name,
        surface_index_option_surfaceterm(slot_ty, surface_index_child(path, 1), keep),
        surface_index_surfaceterm(slot_value, surface_index_child(path, 2), keep),
        slot_borrow,
        slot_mutable
      )
      StVar(slot_name, slot_ty, slot_value, slot_borrow) => StVar(
        slot_name,
        surface_index_option_surfaceterm(slot_ty, surface_index_child(path, 1), keep),
        surface_index_surfaceterm(slot_value, surface_index_child(path, 2), keep),
        slot_borrow
      )
      StModule(slot_name, slot_stmts, slot_start, slot_end) => StModule(
        slot_name,
        surface_index_list_surfacestmt_from(slot_stmts, surface_index_child(path, 1), keep, 0),
        slot_start,
        slot_end
      )
      StAssign(slot_name, slot_place, slot_value) => StAssign(
        slot_name,
        surface_index_option_surfaceterm(slot_place, surface_index_child(path, 1), keep),
        surface_index_surfaceterm(slot_value, surface_index_child(path, 2), keep)
      )
      StCalled(slot_generates, slot_call) => StCalled(
        slot_generates,
        surface_index_surfaceterm(slot_call, surface_index_child(path, 1), keep)
      )
      StAttributed(slot_name, slot_arg, slot_generates, slot_stmt) => StAttributed(
        slot_name,
        surface_index_surfaceterm(slot_arg, surface_index_child(path, 1), keep),
        slot_generates,
        surface_index_surfacestmt(slot_stmt, surface_index_child(path, 3), keep)
      )
      StFn(slot_f) => StFn(surface_index_surfacefn(slot_f, surface_index_child(path, 0), keep))
      StTheorem(slot_t) => StTheorem(
        surface_index_surfacetheorem(slot_t, surface_index_child(path, 0), keep)
      )
      StDef(slot_t) => StDef(
        surface_index_surfacetheorem(slot_t, surface_index_child(path, 0), keep)
      )
      StMutual(slot_stmts, slot_start, slot_end) => StMutual(
        surface_index_list_surfacestmt_from(slot_stmts, surface_index_child(path, 0), keep, 0),
        slot_start,
        slot_end
      )
      StImport(slot_path, slot_start, slot_end) => StImport(slot_path, slot_start, slot_end)
      StInductive(slot_i) => StInductive(
        surface_index_surfaceinductive(slot_i, surface_index_child(path, 0), keep)
      )
      StEffect(slot_e) => StEffect(
        surface_index_surfaceeffect(slot_e, surface_index_child(path, 0), keep)
      )
      StStruct(slot_d) => StStruct(
        surface_index_surfacedata(slot_d, surface_index_child(path, 0), keep)
      )
      StEnum(slot_d) => StEnum(
        surface_index_surfacedata(slot_d, surface_index_child(path, 0), keep)
      )
      StExtern(slot_abi, slot_fns, slot_start, slot_end) => StExtern(
        slot_abi,
        surface_index_list_surfacefn_from(slot_fns, surface_index_child(path, 1), keep, 0),
        slot_start,
        slot_end
      )
      StClass(slot_c) => StClass(
        surface_index_surfaceclass(slot_c, surface_index_child(path, 0), keep)
      )
      StInstance(slot_i) => StInstance(
        surface_index_surfaceinstance(slot_i, surface_index_child(path, 0), keep)
      )
      StWhile(slot_cond, slot_body) => StWhile(
        surface_index_surfaceterm(slot_cond, surface_index_child(path, 0), keep),
        surface_index_surfaceterm(slot_body, surface_index_child(path, 1), keep)
      )
      StReturn(slot_value) => StReturn(
        surface_index_option_surfaceterm(slot_value, surface_index_child(path, 0), keep)
      )
      StExpr(slot_value) => StExpr(
        surface_index_surfaceterm(slot_value, surface_index_child(path, 0), keep)
      )
      StOther(slot_what, slot_start, slot_end) => StOther(slot_what, slot_start, slot_end)
      StMacro(slot_name, slot_function, slot_start, slot_end) => StMacro(
        slot_name,
        slot_function,
        slot_start,
        slot_end
      )
      StSyntax(slot_name, slot_grammar, slot_start, slot_end) => StSyntax(
        slot_name,
        slot_grammar,
        slot_start,
        slot_end
      )
    }
  }

  pub fn surface_index_surfaceterm(value: SurfaceTerm, path: List(Nat), keep: Bool): SurfaceTerm {
    match value: SurfaceTerm {
      SurfaceTermIndexedMk(slot_kind, slot_start, slot_end, slot_old_occurrence) =>
      SurfaceTermIndexedMk(
        surface_index_surfacekind(slot_kind, surface_index_child(path, 0), keep),
        slot_start,
        slot_end,
        if keep { Some(TermOccurrenceMk(path)) } else { None }
      )
    }
  }

  pub fn surface_index_surfacetheorem(
    value: SurfaceTheorem,
    path: List(Nat),
    keep: Bool
  ): SurfaceTheorem {
    match value: SurfaceTheorem {
      SurfaceTheoremMk(
        slot_name,
        slot_implicit,
        slot_params,
        slot_ty,
        slot_body,
        slot_start,
        slot_end
      ) => SurfaceTheoremMk(
        slot_name,
        slot_implicit,
        surface_index_list_surfacenamed_from(slot_params, surface_index_child(path, 2), keep, 0),
        surface_index_surfaceterm(slot_ty, surface_index_child(path, 3), keep),
        surface_index_option_surfaceterm(slot_body, surface_index_child(path, 4), keep),
        slot_start,
        slot_end
      )
    }
  }

}

pub fn surface_index_list_option_surfaceterm(
  value: List(Option(SurfaceTerm)),
  path: List(Nat),
  keep: Bool
): List(Option(SurfaceTerm)) {
  surface_index_list_option_surfaceterm_from(value, path, keep, 0)
}

