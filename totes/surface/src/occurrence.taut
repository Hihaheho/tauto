import "surface.taut"

// Field ordinals and list indices identify positions independently of spans.
// keep selects indexing or complete metadata erasure.
pub fn surface_index_child(path: List(Nat), field: Nat): List(Nat) {
  List::append(path, Cons(field, Nil))
}

mutual {
  pub fn surface_index_list_option_surfaceterm_from(
    value: List(Option(SurfaceTerm)),
    path: List(Nat),
    keep: Bool,
    index: Nat
  ): List(Option(SurfaceTerm)) {
    match value: List(Option(SurfaceTerm)) {
      Nil => Nil
      Cons(item, rest) => Cons(
        surface_index_option_surfaceterm(item, surface_index_child(path, index), keep),
        surface_index_list_option_surfaceterm_from(rest, path, keep, index + 1)
      )
    }
  }

  pub fn surface_index_list_surfacearm_from(
    value: List(SurfaceArm),
    path: List(Nat),
    keep: Bool,
    index: Nat
  ): List(SurfaceArm) {
    match value: List(SurfaceArm) {
      Nil => Nil
      Cons(item, rest) => Cons(
        surface_index_surfacearm(item, surface_index_child(path, index), keep),
        surface_index_list_surfacearm_from(rest, path, keep, index + 1)
      )
    }
  }

  pub fn surface_index_list_surfaceconstraint_from(
    value: List(SurfaceConstraint),
    path: List(Nat),
    keep: Bool,
    index: Nat
  ): List(SurfaceConstraint) {
    match value: List(SurfaceConstraint) {
      Nil => Nil
      Cons(item, rest) => Cons(
        surface_index_surfaceconstraint(item, surface_index_child(path, index), keep),
        surface_index_list_surfaceconstraint_from(rest, path, keep, index + 1)
      )
    }
  }

  pub fn surface_index_list_surfacector_from(
