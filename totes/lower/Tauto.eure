// Lowering: reads a program as Nib source and writes it as NIR text, as
// `crates/tauto-nibcheck/src/lower` and `crates/tauto-nir` do
// (docs/design/self-host.md).
package {
  name = "lower"
  version = "0.1.0"
}

dependencies {
  nibcheck { path = "../nibcheck" }
  nir { path = "../nir" }
  ordmap { path = "../ordmap" }
  surface { path = "../surface" }
  parse { path = "../parse" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}
