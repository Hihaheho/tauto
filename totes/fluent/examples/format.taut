import "../src/bundle.taut"

// Messages formatted by computation: variables, plurals, string selectors, terms with
// arguments, attributes, multiline patterns, and what happens when something is missing.

fn ftl(): Text {
  "# Simple things are simple.
hello = Hello, {$name}!
-brand = Firefox
    .gender = masculine
about = About {-brand}.

# Plurals by the category of the number, and an exact number Before it.
emails = {$count ->
    [0] You have no new email.
    [one] You have one new email.
   *[other] You have {$count} new emails.
}

-thing = {$case ->
   *[nominative] the thing
    [object] the thing's
}
of-thing = Look at {-thing(case: \"object\")} color.

login = Log in
    .placeholder = name@example.com
    .title = Use your account

long =
    First line,
    second line.
"
}

fn en(): Bundle {
  bundle_isolating(with_resource(bundle_new("en-US"), ftl()), false)
}

fn says(b: Bundle, id: Text, args: List(Arg)): Text {
  format_text(b, id, args)
}

theorem hello(): says(en(), "hello", Cons(arg_str("name", "Anne"), Nil)) = "Hello, Anne!" {
  Refl
}

theorem about(): says(en(), "about", Nil) = "About Firefox." {
  Refl
}

theorem emails_zero(): says(en(), "emails", Cons(arg_num("count", 0), Nil)) = "You have no new email." {
  Refl
}

theorem emails_one(): says(en(), "emails", Cons(arg_num("count", 1), Nil)) = "You have one new email." {
  Refl
}

theorem emails_five(): says(en(), "emails", Cons(arg_num("count", 5), Nil)) = "You have 5 new emails." {
  Refl
}

theorem term_with_argument(): says(en(), "of-thing", Nil) = "Look at the thing's color." {
  Refl
}

theorem attribute(): format_attr(en(), "login", "placeholder", Nil) = Formatted::Mk("name@example.com", Nil) {
  Refl
}

theorem multiline(): says(en(), "long", Nil) = "First line,\nsecond line." {
  Refl
}

// Placeables are isolated by default.
theorem isolated(): format_text(with_resource(bundle_new("en"), ftl()), "hello", Cons(arg_str("name", "Anne"), Nil)) = "Hello, \u{2068}Anne\u{2069}!" {
  Refl
}

// A missing variable is written as Fluent writes it, and reported.
theorem missing_variable(): format(en(), "hello", Nil) = Formatted::Mk("Hello, {$name}!", Cons(UnknownVariable(Text::bytes("name")), Nil)) {
  Refl
}

theorem missing_message(): format(en(), "nope", Nil) = Formatted::Mk("{nope}", Cons(UnknownMessage(Text::bytes("nope")), Nil)) {
  Refl
}

// Without its variable, a select expression takes its default variant.
theorem select_default(): format(en(), "emails", Nil) = Formatted::Mk(
    "You have {$count} new emails.",
    Cons(UnknownVariable(Text::bytes("count")), Cons(UnknownVariable(Text::bytes("count")), Nil))
  ) {
  Refl
}
