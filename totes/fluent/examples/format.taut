import "../src/bundle.taut"
import "../src/resolve.taut"
import std::Text

// Messages formatted by computation: variables, plurals, string selectors, terms with
// arguments, attributes, multiline patterns, and what happens when something is missing.

fn ftl(): Text {
  "# A message with a variable, and a term.
hello = Hello, {$name}!
-product = Orchard
    .gender = masculine
about = About {-product}.

# Plurals by the category of the number, and an exact number Before it.
inbox = {$count ->
    [0] The inbox is empty.
    [one] The inbox has one message.
   *[other] The inbox has {$count} messages.
}

-item = {$case ->
   *[nominative] the lamp
    [object] the lamp's
}
of-item = See {-item(case: \"object\")} cable.

account = Account
    .placeholder = user@example.org
    .title = Choose an account

long =
    First line,
    second line.
"
}

fn en(): Bundle {
  bundle_isolating(with_resource(bundle_new("en-US"), ftl()), false)
}

fn says(b: Bundle, id: Text, args: List(Arg)): Text {
  format_text(b, id, args)
}

theorem hello(): says(en(), "hello", Cons(arg_str("name", "Anne"), Nil)) = "Hello, Anne!" {
  Refl
}

theorem about(): says(en(), "about", Nil) = "About Orchard." {
  Refl
}

theorem inbox_zero(): says(en(), "inbox", Cons(arg_num("count", 0), Nil)) = "The inbox is empty." {
  Refl
}

theorem inbox_one(): says(en(), "inbox", Cons(arg_num("count", 1), Nil)) = "The inbox has one message." {
  Refl
}

theorem inbox_five(): says(en(), "inbox", Cons(arg_num("count", 5), Nil)) = "The inbox has 5 messages." {
  Refl
}

theorem term_with_argument(): says(en(), "of-item", Nil) = "See the lamp's cable." {
  Refl
}

theorem attribute(): format_attr(en(), "account", "placeholder", Nil) = Formatted::Mk("user@example.org", Nil) {
  Refl
}

theorem multiline(): says(en(), "long", Nil) = "First line,\nsecond line." {
  Refl
}

theorem isolated(): format_text(with_resource(bundle_new("en"), ftl()), "hello", Cons(arg_str("name", "Anne"), Nil)) = "Hello, \u{2068}Anne\u{2069}!" {
  Refl
}

theorem missing_variable(): format(en(), "hello", Nil) = Formatted::Mk("Hello, {$name}!", Cons(UnknownVariable(Text::bytes("name")), Nil)) {
  Refl
}

theorem missing_message(): format(en(), "nope", Nil) = Formatted::Mk("{nope}", Cons(UnknownMessage(Text::bytes("nope")), Nil)) {
  Refl
}

theorem select_default(): format(en(), "inbox", Nil) = Formatted::Mk(
    "The inbox has {$count} messages.",
    Cons(UnknownVariable(Text::bytes("count")), Cons(UnknownVariable(Text::bytes("count")), Nil))
  ) {
  Refl
}
