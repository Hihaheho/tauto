import std::text { Text }
import std::builtin::macro
import std::std

// The LLVM IR the backend writes, and no more: an instruction the grammar
// does not have cannot be written. `llvm::Module::I` is a module as a tree.
inductive_syntax!(llvm, ```par
%start Module, Frag
%title "LLVM IR"
%grammar_type 'LALR(1)'
%line_comment ';'
%%
Module: { Item };
Frag: Piece;
Piece: Rhs | Store | Term | Ty | Case | Items;
Items: Item { Item };
Item: Declare | TypeDef | Constant | Boxed | Variable | Define;
Declare: 'declare'^ Ty Global '('^ ParamTys ')'^ [ NoReturn ];
ParamTys: [ ParamTy { ','^ ParamTy } ];
ParamTy: Ty | Ellipsis;
TypeDef: Local '='^ 'type'^ Ty;
Constant: Global '='^ 'private'^ 'unnamed_addr'^ 'constant'^ Ty CString;
Boxed: Global '='^ 'private'^ 'unnamed_addr'^ 'constant'^ Ty CString ','^ 'align'^ IntOf;
Variable: Global '='^ Internal 'global'^ Ty Value;
Define: 'define'^ [ Internal ] [ FastCc ] Ty Global '('^ Params ')'^ [ NoReturn ] [ Naked ] '{'^ Block { Block } '}'^;
Params: [ Param { ','^ Param } ];
Param: Ty Local;
Block: LabelDef { Instr } Term;
Instr: Def | Store | Call;
Def: Local '='^ Rhs;
Rhs: Alloca | Load | Gep | Bin | Icmp | Cast | Call | ExtractValue | InsertValue;
Alloca: 'alloca'^ Ty;
Load: 'load'^ Ty ','^ 'ptr'^ Value;
Gep: 'getelementptr'^ Ty ','^ 'ptr'^ Value { ','^ TyValue };
TyValue: Ty Value;
Bin: BinOp Ty Value ','^ Value;
BinOp: OpAdd | OpSub | OpMul | OpShl | OpLshr | OpAnd | OpOr | OpXor | OpSdiv | OpUdiv | OpSrem | OpUrem;
Icmp: 'icmp'^ Pred Ty Value ','^ Value;
Pred: PredEq | PredNe | PredSlt | PredSgt | PredSle | PredSge | PredUlt | PredUgt | PredUle | PredUge;
Cast: CastOp Ty Value 'to'^ Ty;
CastOp: OpTrunc | OpZext | OpSext | OpIntToPtr | OpPtrToInt;
Call: 'call'^ [ FastCc ] Ty [ Sig ] Callee '('^ ArgsOf ')'^;
Callee: Global | Hole | Asm;
Asm: 'asm'^ 'sideeffect'^ Str ','^ Str;
ArgsOf: Args | Hole;
Sig: '('^ ParamTys ')'^;
Args: [ TyValue { ','^ TyValue } ];
ExtractValue: 'extractvalue'^ Ty Value ','^ IntOf;
IntOf: Int | Hole;
InsertValue: 'insertvalue'^ Ty Value ','^ Ty Value ','^ IntOf;
Store: 'store'^ Ty Value ','^ 'ptr'^ Value;
Term: Ret | Br | CondBr | Switch | Unreachable;
Ret: 'ret'^ Ty [ Value ];
Br: 'br'^ 'label'^ LabelRef;
LabelRef: Local | Hole;
CondBr: 'br'^ Ty Value ','^ 'label'^ LabelRef ','^ 'label'^ LabelRef;
Switch: 'switch'^ Ty Value ','^ 'label'^ LabelRef '['^ [ CasesOf ] ']'^;
CasesOf: Cases | Hole;
Cases: Case { Case };
Case: Ty Value ','^ 'label'^ LabelRef;
Ty: Void | IntTy | Ptr | ArrayTy | StructTy | Named | Hole;
ArrayTy: '['^ IntOf 'x'^ Ty ']'^;
StructTy: '{'^ Ty { ','^ Ty } '}'^;
Named: Local;
Value: Local | Global | Int | Null | True | False | Poison | Zero | Hole;
Hole: TautoExpr;
Ellipsis: '...';
NoReturn: 'noreturn';
Naked: 'naked';
Internal: 'internal';
FastCc: 'fastcc';
Unreachable: 'unreachable';
Void: 'void';
Ptr: 'ptr';
Null: 'null';
True: 'true';
False: 'false';
Poison: 'poison';
Zero: 'zeroinitializer';
OpAdd: 'add';
OpSub: 'sub';
OpMul: 'mul';
OpShl: 'shl';
OpLshr: 'lshr';
OpAnd: 'and';
OpOr: 'or';
OpXor: 'xor';
OpSdiv: 'sdiv';
OpUdiv: 'udiv';
OpSrem: 'srem';
OpUrem: 'urem';
PredEq: 'eq';
PredNe: 'ne';
PredSlt: 'slt';
PredSgt: 'sgt';
PredSle: 'sle';
PredSge: 'sge';
PredUlt: 'ult';
PredUgt: 'ugt';
PredUle: 'ule';
PredUge: 'uge';
OpTrunc: 'trunc';
OpZext: 'zext';
OpSext: 'sext';
OpIntToPtr: 'inttoptr';
OpPtrToInt: 'ptrtoint';
LabelDef: /[A-Za-z_][A-Za-z0-9_.]*:/;
Local: /%[A-Za-z0-9_.]+/;
Global: /@[A-Za-z0-9_.]+/;
IntTy: /i[0-9]+/;
Int: /-?[0-9]+/;
CString: /c"[^"]*"/;
Str: /"[^"]*"/;
```) =>
