// The headless core of the distributed index: applying an index's batches,
// and whether a candidate may be adopted. It reads no Eure, Git or hash; its
// inputs are decoded, checked facts.
package {
  name = "index"
  version = "0.1.0"
  additional-sources = ["proof"]
}

// The entry points the Rust side calls (crates/totebag-index).
rust {
  exports = ["ix_rebuild", "ix_step", "ix_ingest_grounded", "ix_evaluate_ledgers", "ix_advance_pin", "ix_pin_allowed"]
}
