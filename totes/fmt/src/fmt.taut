import "../../surface/src/surface.taut"
import "../../syntax/src/syntax.taut"
import "ast_key.taut"
import "../../unicode/src/classes.taut"
import "../../unicode/src/unicode.taut"
import "../../text/src/text.taut"
import std::Text
import std::Base
import std::TextOps

// `tauto fmt` in the proof language (`docs/design/self-host.md`): lays a file out
// again while preserving its normalized surface AST and comments. It follows
// `crates/tauto/src/fmt.rs` function by function; the rules are written
// there.
//
// A line is a run of tokens up to a newline that ends a statement (one outside
// `( )` and `[ ]`). It is indented two spaces for each enclosing `{`, and its
// tokens are spaced one way: a space after `,`, none inside brackets,
// otherwise one space wherever the source had whitespace. A line longer than
// the width is broken at its outermost bracket that does not fit, one argument
// per line, and so on inward. A line that holds a comment inside brackets, or
// a block whose newlines matter inside brackets, is left as written.
// Optional control blocks are unwrapped; a block literal moves with its closing
// fence so its content is preserved. The result is parsed and compared again.

pub fn fmt_width(): Nat {
  100
}

pub(open) inductive FmtOr(A: Type): Type {
  FmtOk(value: A): FmtOr(A)
  FmtErr(message: Text): FmtOr(A)
}

pub(open) inductive FmtKind: Type {
  FmtWord: FmtKind
  FmtOpen: FmtKind
  FmtClose: FmtKind
  FmtComma: FmtKind
  FmtComment: FmtKind
  FmtPunct: FmtKind
}

pub fn fmt_kind_number(k: FmtKind): Nat {
  ⊢ Nat from match k {
    FmtWord => 0
    FmtOpen => 1
    FmtClose => 2
    FmtComma => 3
    FmtComment => 4
    FmtPunct => 5
  }
}

// A token: whitespace came before it (`spaced`), `newlines` newlines came
// before it, and it is the bytes `start` to `end` of the source.
pub(open) inductive FmtToken: Type {
  Mk(lexeme: Text, kind: FmtKind, spaced: Bool, newlines: Nat, start: Nat, end: Nat): FmtToken
}

pub fn fmt_is(t: FmtToken, k: FmtKind): Bool {
  fmt_kind_number(t.kind) == fmt_kind_number(k)
}

pub fn fmt_is_word(classes: UnicodeClasses, c: Nat): Bool {
  c == 95 || unicode_is_alphanumeric(classes, c)
}

// The end of the word that starts at byte `at`, within `k` characters.
pub fn fmt_word_end_in(k: Nat, source: Text, classes: UnicodeClasses, at: Nat): Nat {
  ⊢ Nat from match k {
    Zero => at
    Succ(k2) => ⊢ Nat from match text_decode(source, at) {
      None => at
      Some(#(@code code, @len len)) => ⊢ Nat from match fmt_is_word(classes, code) {
        true => fmt_word_end_in(k2, source, classes, at + len)
        false => at
      }
    }
  }
}

pub fn fmt_word_end(source: Text, classes: UnicodeClasses, at: Nat): Nat {
  fmt_word_end_in(Text::len(source) - at, source, classes, at)
}

// The end of the string whose contents start at byte `at`, within `k`
// characters: just after its closing quote. A backslash takes the
// character after it.
pub fn fmt_string_end_in(k: Nat, source: Text, at: Nat): Option(Nat) {
  ⊢ Option(Nat) from match k {
    Zero => None
    Succ(k2) => ⊢ Option(Nat) from match text_decode(source, at) {
      None => None
      Some(#(@code code, @len len)) => ⊢ Option(Nat) from match code == 34 {
        true => Some(at + 1)
        false => ⊢ Option(Nat) from match code == 92 {
          true => ⊢ Option(Nat) from match text_decode(source, at + 1) {
            None => None
            Some(#(@code _, @len next_len)) => fmt_string_end_in(k2, source, at + 1 + next_len)
          }
          false => fmt_string_end_in(k2, source, at + len)
        }
      }
    }
  }
}

pub fn fmt_string_end(source: Text, at: Nat): Option(Nat) {
  fmt_string_end_in(Text::len(source) - at, source, at)
}

// The end of a `plaintext` string whose contents start at byte `at`: just
// after the backtick, if one comes before the end of the line.
pub fn fmt_plaintext_end(source: Text, at: Nat): Option(Nat) {
  ⊢ Option(Nat) from match text_find(source, "`", at) {
    None => None
    Some(tick) => ⊢ Option(Nat) from match text_find(source, text_newline(), at) {
      None => Some(tick + 1)
      Some(newline) => ⊢ Option(Nat) from match tick < newline {
        true => Some(tick + 1)
        false => None
      }
    }
  }
}

pub fn fmt_byte_is(source: Text, at: Nat, code: Nat): Bool {
  ⊢ Bool from match Text::byte(source, at) {
    None => false
    Some(b) => b == code
  }
}

// The end of a run of one ASCII byte, or of header spaces, within `k` bytes.
pub fn fmt_run_end_in(k: Nat, source: Text, at: Nat, code: Nat, spaces: Bool): Nat {
  ⊢ Nat from match k {
    Zero => at
    Succ(rest) => ⊢ Nat from match fmt_byte_is(
      source,
      at,
      code
    ) || (spaces && fmt_byte_is(source, at, 9)) {
      true => fmt_run_end_in(rest, source, at + 1, code, spaces)
      false => at
    }
  }
}

pub fn fmt_run_end(source: Text, at: Nat, code: Nat, spaces: Bool): Nat {
  fmt_run_end_in(Text::len(source) - at, source, at, code, spaces)
}

// An inline literal closes before either spelling of a line ending.
pub fn fmt_inline_end_in(k: Nat, source: Text, at: Nat): Option(Nat) {
  ⊢ Option(Nat) from match k {
    Zero => None
    Succ(rest) => ⊢ Option(Nat) from match text_decode(source, at) {
      None => None
      Some(#(@code code, @len len)) => ⊢ Option(Nat) from match code == 96 {
        true => Some(at + 1)
        false => ⊢ Option(Nat) from match code == 10 || code == 13 {
          true => None
          false => fmt_inline_end_in(rest, source, at + len)
        }
      }
    }
  }
}

pub fn fmt_literal_close(source: Text, r#from: Nat, close: Text): Option(Nat) {
  ⊢ Option(Nat) from match text_find(source, close, r#from) {
    None => None
    Some(at) => Some(at + Text::len(close))
  }
}

pub fn fmt_fence_body(source: Text, at: Nat, ticks: Nat): Option(Nat) {
  ⊢ Option(Nat) from match fmt_byte_is(source, at, 10) {
    true => fmt_literal_close(source, at + 1, Text::repeat("`", ticks))
    false => None
  }
}

pub fn fmt_fence_end(source: Text, at: Nat, ticks: Nat): Option(Nat) {
  ⊢ Option(Nat) from match fmt_byte_is(source, at, 13) {
    true => fmt_fence_body(source, at + 1, ticks)
    false => fmt_fence_body(source, at, ticks)
  }
}

// Syntax literals are single tokens; their contents have their own grammar.
pub fn fmt_literal_marked(
  source: Text,
  classes: UnicodeClasses,
  at: Nat,
  ticks: Nat,
  angles: Nat
): Option(Nat) {
  ⊢ Option(Nat) from match ticks >= 3 && ticks <= 6 {
    true => fmt_fence_end(
      source,
      fmt_run_end(source, fmt_word_end(source, classes, at + ticks), 32, true),
      ticks
    )
    false => ⊢ Option(Nat) from match angles >= 1 && angles <= 3 && fmt_byte_is(source, at + angles, 96) {
      true => fmt_literal_close(
        source,
        at + angles + 1,
        Text::concat("`", Text::repeat(">", angles))
      )
      false => ⊢ Option(Nat) from match ticks == 1 {
        true => fmt_inline_end_in(Text::len(source) - at - 1, source, at + 1)
        false => None
      }
    }
  }
}

pub fn fmt_literal_at(source: Text, classes: UnicodeClasses, at: Nat): Option(Nat) {
  fmt_literal_marked(
    source,
    classes,
    at,
    fmt_run_end(source, at, 96, false) - at,
    fmt_run_end(source, at, 60, false) - at
  )
}

pub fn fmt_literal_end(source: Text, classes: UnicodeClasses, at: Nat, c: Nat): Option(Nat) {
  ⊢ Option(Nat) from match fmt_is_word(classes, c) && not(c >= 48 && c <= 57) {
    true => fmt_literal_at(source, classes, fmt_word_end(source, classes, at))
    false => fmt_literal_at(source, classes, at)
  }
}

pub fn fmt_kind_of(c: Nat): FmtKind {
  ⊢ FmtKind from match c == 40 || c == 91 || c == 123 {
    true => FmtOpen
    false => ⊢ FmtKind from match c == 41 || c == 93 || c == 125 {
      true => FmtClose
      false => ⊢ FmtKind from match c == 44 {
        true => FmtComma
        false => FmtPunct
      }
    }
  }
}

// What the lexer does at a character: skip it (where it goes on, and the
// whitespace and newlines seen), cut a token up to `end`, or stop.
pub(open) inductive FmtStep: Type {
  FmtSkip(to: Nat, spaced: Bool, newlines: Nat): FmtStep
  FmtCut(kind: FmtKind, end: Nat): FmtStep
  FmtEscape(kind: FmtKind, end: Nat, sign: Text): FmtStep
  FmtStop(message: Text): FmtStep
}

// The sign an ASCII escape (`\times`) stands for, by the word after the backslash.
pub fn fmt_escape_sign(name: Text): Option(Text) {
  ⊢ Option(Text) from match name == "times" {
    true => Some("\u{D7}")
    false => ⊢ Option(Text) from match name == "land" {
      true => Some("\u{2227}")
      false => ⊢ Option(Text) from match name == "lor" {
        true => Some("\u{2228}")
        false => ⊢ Option(Text) from match name == "iff" {
          true => Some("\u{2194}")
          false => ⊢ Option(Text) from match name == "neg" {
            true => Some("\u{AC}")
            false => ⊢ Option(Text) from match name == "vdash" {
              true => Some("\u{22A2}")
              false => ⊢ Option(Text) from match name == "omega" {
                true => Some("\u{3C9}")
                false => ⊢ Option(Text) from match name == "forall" {
                  true => Some("\u{2200}")
                  false => ⊢ Option(Text) from match name == "exists" {
                    true => Some("\u{2203}")
                    false => ⊢ Option(Text) from match name == "cup" {
                      true => Some("\u{222A}")
                      false => ⊢ Option(Text) from match name == "llbracket" {
                        true => Some("\u{27E6}")
                        false => ⊢ Option(Text) from match name == "rrbracket" {
                          true => Some("\u{27E7}")
                          false => ⊢ Option(Text) from match name == "square" {
                            true => Some("\u{25A1}")
                            false => None
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// A sign is a word only when it is a letter: `\u{3C9}`.
pub fn fmt_escape_kind(sign: Text): FmtKind {
  ⊢ FmtKind from match sign == "\u{3C9}" {
    true => FmtWord
    false => FmtPunct
  }
}

// A character that is no word: an escape `\times` is one token, the sign; any other is a punctuation.
pub fn fmt_punct_step(
  source: Text,
  classes: UnicodeClasses,
  at: Nat,
  c: Nat,
  length: Nat
): FmtStep {
  ⊢ FmtStep from match c == 92 {
    true => ⊢ FmtStep from match fmt_escape_sign(
      Text::slice_or_empty(source, at + 1, fmt_word_end(source, classes, at + 1))
    ) {
      Some(sign) => FmtEscape(fmt_escape_kind(sign), fmt_word_end(source, classes, at + 1), sign)
      None => FmtCut(fmt_kind_of(c), at + length)
    }
    false => FmtCut(fmt_kind_of(c), at + length)
  }
}

pub fn fmt_cut_at(kind: FmtKind, end: Option(Nat), message: Text): FmtStep {
  ⊢ FmtStep from match end {
    None => FmtStop(message)
    Some(e) => FmtCut(kind, e)
  }
}

// Whether a raw name `r#name` begins at byte `at`: it is one word, `r#` and the name.
pub fn fmt_raw_name_start(source: Text, classes: UnicodeClasses, at: Nat): Bool {
  ⊢ Bool from match fmt_byte_is(source, at, 114) && fmt_byte_is(source, at + 1, 35) {
    true => ⊢ Bool from match text_decode(source, at + 2) {
      None => false
      Some(#(@code code, @len _)) => fmt_is_word(classes, code) && not(code >= 48 && code <= 57)
    }
    false => false
  }
}

// The words a name cannot be spelled as unless it is written `r#name`.
pub fn fmt_reserved_words(): List(Text) {
  [
    "theorem",
    "def",
    "import",
    "mutual",
    "axiom",
    "inductive",
    "from",
    "decreasing_by",
    "opaque",
    "eqn",
    "by",
    "let",
    "var",
    "fn",
    "return",
    "while",
    "loop",
    "break",
    "continue",
    "if",
    "else",
    "match",
    "struct",
    "enum",
    "effect",
    "handle",
    "with",
    "perform",
    "budget",
    "copy",
    "shared",
    "view",
    "affine",
    "linear",
    "resume",
    "direct",
    "mut",
    "pub",
    "module",
    "where",
    "class",
    "instance",
    "extern",
    "type",
    "true",
    "false",
    "macro",
    "quote"
  ]
}

pub fn fmt_text_in(name: Text, words: List(Text)): Bool {
  ⊢ Bool from match words {
    Nil => false
    Cons(w, rest) => name == w || fmt_text_in(name, rest)
  }
}

// A raw name that is not needed is written without its `r#`: one whose word is not reserved. A reserved
// word is a name only with `r#`, wherever it stands.
pub fn fmt_unraw_token(t: FmtToken): FmtToken {
  ⊢ FmtToken from match text_starts_with(t.lexeme, "r#", 0) && Text::len(t.lexeme) > 2 {
    false => t
    true => ⊢ FmtToken from match fmt_unraw_needed(t) {
      true => t
      false => FmtToken {
        lexeme: Text::slice_or_empty(t.lexeme, 2, Text::len(t.lexeme)),
        kind: t.kind,
        spaced: t.spaced,
        newlines: t.newlines,
        start: t.start,
        end: t.end
      }
    }
  }
}

pub fn fmt_unraw_needed(t: FmtToken): Bool {
  fmt_text_in(Text::slice_or_empty(t.lexeme, 2, Text::len(t.lexeme)), fmt_reserved_words())
}

pub fn fmt_unraw_in(tokens: List(FmtToken)): List(FmtToken) {
  ⊢ List(FmtToken) from match tokens {
    Nil => Nil
    Cons(t, rest) => Cons(fmt_unraw_token(t), fmt_unraw_in(rest))
  }
}

pub fn fmt_step(
  source: Text,
  classes: UnicodeClasses,
  at: Nat,
  c: Nat,
  length: Nat,
  spaced: Bool,
  newlines: Nat
): FmtStep {
  ⊢ FmtStep from match c == 10 {
    true => FmtSkip(at + 1, spaced, newlines + 1)
    false => ⊢ FmtStep from match unicode_is_whitespace(classes, c) {
      true => FmtSkip(at + length, true, newlines)
      false => ⊢ FmtStep from match c == 47 && fmt_byte_is(source, at + 1, 47) {
        true => FmtCut(
          FmtComment,
          ⊢ Nat from match text_find(source, text_newline(), at) {
            None => Text::len(source)
            Some(newline) => newline
          }
        )
        false => ⊢ FmtStep from match c == 47 && fmt_byte_is(source, at + 1, 42) {
          true => ⊢ FmtStep from match text_find(source, "*/", at + 2) {
            None => FmtStop("an unclosed block comment")
            Some(close) => FmtCut(FmtComment, close + 2)
          }
          false => ⊢ FmtStep from match c == 34 {
            true => fmt_cut_at(FmtWord, fmt_string_end(source, at + 1), "an unclosed string")
            false => ⊢ FmtStep from match c == 39 {
              true => ⊢ FmtStep from match text_find(source, "'", at + 1) {
                None => FmtStop("an unclosed string")
                Some(close) => FmtCut(FmtWord, close + 1)
              }
              false => ⊢ FmtStep from match fmt_literal_end(source, classes, at, c) {
                Some(end) => FmtCut(FmtWord, end)
                None => ⊢ FmtStep from match text_starts_with(source, "plaintext`", at) {
                  true => fmt_cut_at(
                    FmtWord,
                    fmt_plaintext_end(source, at + 10),
                    "an unclosed string"
                  )
                  false => ⊢ FmtStep from match fmt_is_word(classes, c) {
                    // `pub(open)` is one word, as the grammar reads it: a layout never breaks it.
                    true => ⊢ FmtStep from match text_starts_with(source, "pub(open)", at) {
                      true => FmtCut(FmtWord, at + 9)
                      false => ⊢ FmtStep from match fmt_raw_name_start(source, classes, at) {
                        true => FmtCut(FmtWord, fmt_word_end(source, classes, at + 2))
                        false => FmtCut(FmtWord, fmt_word_end(source, classes, at))
                      }
                    }
                    false => fmt_punct_step(source, classes, at, c, length)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// The tokens of `source` from byte `at` in reverse, onto `done`. Each step
// moves on a byte at least, so `k` is the bytes left.
pub fn fmt_lex_in(
  k: Nat,
  source: Text,
  classes: UnicodeClasses,
  at: Nat,
  spaced: Bool,
  newlines: Nat,
  done: List(FmtToken)
): FmtOr(List(FmtToken)) {
  ⊢ FmtOr(List(FmtToken)) from match k {
    Zero => FmtOk(done)
    Succ(k2) => ⊢ FmtOr(List(FmtToken)) from match text_decode(source, at) {
      None => FmtOk(done)
      Some(#(@code code, @len len)) => ⊢ FmtOr(List(FmtToken)) from match fmt_step(
        source,
        classes,
        at,
        code,
        len,
        spaced,
        newlines
      ) {
        FmtSkip(to, now_spaced, now_newlines) => fmt_lex_in(
          k2,
          source,
          classes,
          to,
          now_spaced,
          now_newlines,
          done
        )
        FmtCut(kind, end) => fmt_lex_in(
          k2,
          source,
          classes,
          end,
          false,
          0,
          Cons(
            FmtToken {
              lexeme: Text::slice_or_empty(source, at, end),
              kind: kind,
              spaced: spaced || newlines > 0,
              newlines: newlines,
              start: at,
              end: end
            },
            done
          )
        )
        FmtEscape(kind, end, sign) => fmt_lex_in(
          k2,
          source,
          classes,
          end,
          false,
          0,
          Cons(
            FmtToken {
              lexeme: sign,
              kind: kind,
              spaced: spaced || newlines > 0,
              newlines: newlines,
              start: at,
              end: end
            },
            done
          )
        )
        FmtStop(message) => FmtErr(message)
      }
    }
  }
}

pub fn fmt_lex(source: Text, classes: UnicodeClasses): FmtOr(List(FmtToken)) {
  ⊢ FmtOr(List(FmtToken)) from match fmt_lex_in(
    Text::len(source) + 1,
    source,
    classes,
    0,
    false,
    0,
    Nil
  ) {
    FmtOk(reversed) => FmtOk(fmt_unraw_in(List::reverse(reversed)))
    FmtErr(message) => FmtErr(message)
  }
}

// A line as a tree: tokens and bracketed groups of comma-separated items.
mutual {
  pub(open) inductive FmtNode: Type {
    FmtTok(token: FmtToken): FmtNode
    FmtGroup(open: FmtToken, items: FmtItems, close: FmtToken): FmtNode
  }
  pub(open) inductive FmtNodes: Type {
    FmtNoNodes: FmtNodes
    FmtNodesOf(node: FmtNode, rest: FmtNodes): FmtNodes
  }
  pub(open) inductive FmtItems: Type {
    FmtNoItems: FmtItems
    FmtItemsOf(item: FmtNodes, rest: FmtItems): FmtItems
  }
}

pub fn fmt_nodes_reverse_onto(l: FmtNodes, done: FmtNodes): FmtNodes {
  ⊢ FmtNodes from match l {
    FmtNoNodes => done
    FmtNodesOf(n, rest) => fmt_nodes_reverse_onto(rest, FmtNodesOf(n, done))
  }
}

pub fn fmt_items_reverse_onto(l: FmtItems, done: FmtItems): FmtItems {
  ⊢ FmtItems from match l {
    FmtNoItems => done
    FmtItemsOf(i, rest) => fmt_items_reverse_onto(rest, FmtItemsOf(i, done))
  }
}

pub fn fmt_nodes_empty(l: FmtNodes): Bool {
  ⊢ Bool from match l {
    FmtNoNodes => true
    FmtNodesOf(n, rest) => false
  }
}

pub fn fmt_items_empty(l: FmtItems): Bool {
  ⊢ Bool from match l {
    FmtNoItems => true
    FmtItemsOf(i, rest) => false
  }
}

// An open group: its bracket, the items read (last first), the nodes of the
// item being read (last first) and the braces open in it.
pub(open) inductive FmtFrame: Type {
  Mk(open: FmtToken, done: FmtItems, nodes: FmtNodes, braces: Nat): FmtFrame
}

// The items of a group, in order, from the frame that closes. One empty
// item is no item.
pub fn fmt_frame_items(f: FmtFrame): FmtItems {
  ⊢ FmtItems from match fmt_items_reverse_onto(
    FmtItemsOf(fmt_nodes_reverse_onto(f.nodes, FmtNoNodes), f.done),
    FmtNoItems
  ) {
    FmtNoItems => FmtNoItems
    FmtItemsOf(first, more) => ⊢ FmtItems from match fmt_nodes_empty(first) && fmt_items_empty(more) {
      true => FmtNoItems
      false => FmtItemsOf(first, more)
    }
  }
}

pub fn fmt_frame_add(f: FmtFrame, node: FmtNode, braces: Nat): FmtFrame {
  FmtFrame { open: f.open, done: f.done, nodes: FmtNodesOf(node, f.nodes), braces: braces }
}

pub(open) inductive FmtParsed: Type {
  Mk(nodes: FmtNodes, rest: List(FmtToken)): FmtParsed
}

pub fn fmt_frames_add(frames: List(FmtFrame), node: FmtNode): List(FmtFrame) {
  ⊢ List(FmtFrame) from match frames {
    Nil => Nil
    Cons(f, outer) => Cons(fmt_frame_add(f, node, f.braces), outer)
  }
}

pub fn fmt_top_add(frames: List(FmtFrame), top: FmtNodes, node: FmtNode): FmtNodes {
  ⊢ FmtNodes from match frames {
    Nil => FmtNodesOf(node, top)
    Cons(f, outer) => top
  }
}

// The groups still open at the end of the line, closed by their own open
// bracket, innermost first; `pending` is the group closed last.
pub fn fmt_close_all(frames: List(FmtFrame), pending: Option(FmtNode), top: FmtNodes): FmtNodes {
  ⊢ FmtNodes from match frames {
    Nil => ⊢ FmtNodes from match pending {
      None => top
      Some(node) => FmtNodesOf(node, top)
    }
    Cons(f, outer) => fmt_close_all(
      outer,
      Some(
        ⊢ FmtNode from match pending {
          None => FmtGroup(f.open, fmt_frame_items(f), f.open)
          Some(node) => FmtGroup(f.open, fmt_frame_items(fmt_frame_add(f, node, f.braces)), f.open)
        }
      ),
      top
    )
  }
}

pub fn fmt_braces_after(t: FmtToken, braces: Nat): Nat {
  ⊢ Nat from match t.lexeme == "{" {
    true => braces + 1
    false => ⊢ Nat from match t.lexeme == "}" && braces > 0 {
      true => braces - 1
      false => braces
    }
  }
}

// Whether `t` ends a quantifier's binders (`∀ x: A, y: A.`): a `.` with whitespace or the end of
// the line after it, as `after` begins.
pub fn fmt_ends_binders(t: FmtToken, after: List(FmtToken)): Bool {
  t.lexeme == "." && (⊢ Bool from match after {
    Nil => true
    Cons(next, rest) => next.spaced || next.newlines > 0
  })
}

// The braces open after `t`, a quantifier's binders counted like a brace up to the `.` that
// ends them, so that their commas do not split a group's items.
pub fn fmt_depth_after(t: FmtToken, after: List(FmtToken), braces: Nat): Nat {
  ⊢ Nat from match t.lexeme == "\u{2200}" || t.lexeme == "\u{2203}" {
    true => braces + 1
    false => ⊢ Nat from match fmt_ends_binders(t, after) && braces > 0 {
      true => braces - 1
      false => fmt_braces_after(t, braces)
    }
  }
}

// Whether a group's only item has no group in it that can break: breaking the group would only
// move the item to a line of its own (`Option(A)`).
pub fn fmt_unbreakable(items: FmtItems): Bool {
  ⊢ Bool from match items {
    FmtNoItems => false
    FmtItemsOf(first, more) => fmt_items_empty(more) && fmt_nodes_flat(first)
  }
}

pub fn fmt_nodes_flat(nodes: FmtNodes): Bool {
  ⊢ Bool from match nodes {
    FmtNoNodes => true
    FmtNodesOf(node, rest) => ⊢ Bool from match node {
      FmtTok(t) => fmt_nodes_flat(rest)
      FmtGroup(open, items, close) => fmt_items_empty(items) && fmt_nodes_flat(rest)
    }
  }
}

// Whether a `{` closes on the same line among `tokens` (those after it, with `depth` open), as
// a record literal does: then it is a group like `( )`, broken at its commas, and not a block.
pub fn fmt_closes_on_line(tokens: List(FmtToken), depth: Nat): Bool {
  ⊢ Bool from match tokens {
    Nil => false
    Cons(t, after) => ⊢ Bool from match fmt_is(t, FmtOpen) {
      true => fmt_closes_on_line(after, depth + 1)
      false => ⊢ Bool from match fmt_is(t, FmtClose) {
        true => depth == 1 || fmt_closes_on_line(after, depth - 1)
        false => fmt_closes_on_line(after, depth)
      }
    }
  }
}

// Whether the last node read (`nodes` is last first) is a `!`, so that a `{` after it opens an
// effect row, never a group: a newline inside it does not parse.
pub fn fmt_after_bang(nodes: FmtNodes): Bool {
  ⊢ Bool from match nodes {
    FmtNoNodes => false
    FmtNodesOf(node, rest) => ⊢ Bool from match node {
      FmtTok(t) => t.lexeme == "!"
      FmtGroup(open, items, close) => false
    }
  }
}

// Whether an item (its nodes, the latest first) is inside an implicit-argument block `<A: A, R: R>`
// that its first token opens and no `>` has closed yet: its commas do not separate items.
pub fn fmt_in_angle(nodes: FmtNodes, opened: Nat, closed: Nat, starts: Bool): Bool {
  ⊢ Bool from match nodes {
    FmtNoNodes => starts && closed < opened
    FmtNodesOf(node, rest) => ⊢ Bool from match node {
      FmtTok(t) => fmt_in_angle(
        rest,
        ⊢ Nat from match t.lexeme == "<" {
          true => opened + 1
          false => opened
        },
        ⊢ Nat from match t.lexeme == ">" {
          true => closed + 1
          false => closed
        },
        t.lexeme == "<"
      )
      FmtGroup(open, items, close) => fmt_in_angle(rest, opened, closed, false)
    }
  }
}

pub fn fmt_not(b: Bool): Bool {
  ⊢ Bool from match b {
    true => false
    false => true
  }
}

// Whether a `}` closes the innermost open group: a `{ }` one, with no braces open in it.
pub fn fmt_closes_frame(frames: List(FmtFrame)): Bool {
  ⊢ Bool from match frames {
    Nil => false
    Cons(f, outer) => f.open.lexeme == "{" && f.braces == 0
  }
}

// Reads the tree of a line: `top` holds its nodes so far (last first) and
// `frames` the groups open (innermost first). Commas split a group's items
// only outside braces that stay open past the line; a line's own commas
// (`<A, B>`) are plain tokens. A `{ }` closed on the line is a group, and so is any `{ }` inside
// a group, where it closes on the line too; an effect row (`! {Div, stdout}`) never is.
pub fn fmt_tree_in(tokens: List(FmtToken), top: FmtNodes, frames: List(FmtFrame)): FmtParsed {
  ⊢ FmtParsed from match tokens {
    Nil => FmtParsed::Mk(fmt_nodes_reverse_onto(fmt_close_all(frames, None, top), FmtNoNodes), Nil)
    Cons(t, after) => ⊢ FmtParsed from match fmt_is(
      t,
      FmtClose
    ) && (t.lexeme != "}" || fmt_closes_frame(frames)) {
      true => ⊢ FmtParsed from match frames {
        Nil => FmtParsed::Mk(fmt_nodes_reverse_onto(top, FmtNoNodes), tokens)
        Cons(f, outer) => fmt_tree_in(
          after,
          fmt_top_add(outer, top, FmtGroup(f.open, fmt_frame_items(f), t)),
          fmt_frames_add(outer, FmtGroup(f.open, fmt_frame_items(f), t))
        )
      }
      false => ⊢ FmtParsed from match frames {
        Nil => ⊢ FmtParsed from match fmt_is(
          t,
          FmtOpen
        ) && (
          t.lexeme != "{" || (fmt_not(fmt_after_bang(top)) && fmt_closes_on_line(after, 1))
        ) {
          true => fmt_tree_in(
            after,
            top,
            Cons(FmtFrame { open: t, done: FmtNoItems, nodes: FmtNoNodes, braces: 0 }, Nil)
          )
          false => fmt_tree_in(after, FmtNodesOf(FmtTok(t), top), Nil)
        }
        Cons(f, outer) => ⊢ FmtParsed from match fmt_is(t, FmtComma) && f.braces == 0 && fmt_not(
          fmt_in_angle(f.nodes, 0, 0, false)
        ) {
          true => fmt_tree_in(
            after,
            top,
            Cons(
              FmtFrame {
                open: f.open,
                done: FmtItemsOf(fmt_nodes_reverse_onto(f.nodes, FmtNoNodes), f.done),
                nodes: FmtNoNodes,
                braces: 0
              },
              outer
            )
          )
          false => ⊢ FmtParsed from match fmt_is(
            t,
            FmtOpen
          ) && (t.lexeme != "{" || fmt_not(fmt_after_bang(f.nodes))) {
            true => fmt_tree_in(
              after,
              top,
              Cons(FmtFrame { open: t, done: FmtNoItems, nodes: FmtNoNodes, braces: 0 }, frames)
            )
            false => fmt_tree_in(
              after,
              top,
              Cons(fmt_frame_add(f, FmtTok(t), fmt_depth_after(t, after, f.braces)), outer)
            )
          }
        }
      }
    }
  }
}

pub fn fmt_tree(tokens: List(FmtToken)): FmtParsed {
  fmt_tree_in(tokens, FmtNoNodes, Nil)
}

pub fn fmt_gap(prev: Option(Text), t: FmtToken): Text {
  ⊢ Text from match prev {
    None => ""
    Some(before) => ⊢ Text from match before == "(" || before == "[" {
      true => ""
      false => ⊢ Text from match before == "," {
        true => " "
        false => ⊢ Text from match t.lexeme == ")" || t.lexeme == "]" || t.lexeme == "," {
          true => ""
          false => ⊢ Text from match before == "!" && t.lexeme == "(" {
            true => ""
            false => ⊢ Text from match t.spaced {
              true => " "
              false => ""
            }
          }
        }
      }
    }
  }
}

pub(open) inductive FmtFlat: Type {
  Mk(prev: Option(Text), parts: List(Text)): FmtFlat
}

pub fn fmt_push(t: FmtToken, f: FmtFlat): FmtFlat {
  FmtFlat { prev: Some(t.lexeme), parts: Cons(t.lexeme, Cons(fmt_gap(f.prev, t), f.parts)) }
}

pub fn fmt_push_comma(first: Bool, f: FmtFlat): FmtFlat {
  ⊢ FmtFlat from match first {
    true => f
    false => FmtFlat { prev: Some(","), parts: Cons(",", f.parts) }
  }
}

mutual {
  pub fn fmt_flat_node(node: FmtNode, f: FmtFlat): FmtFlat {
    ⊢ FmtFlat from match node {
      FmtTok(t) => fmt_push(t, f)
      FmtGroup(open, items, close) => fmt_push(
        close,
        fmt_flat_items(items, true, fmt_push(open, f))
      )
    }
  }
  pub fn fmt_flat_nodes(nodes: FmtNodes, f: FmtFlat): FmtFlat {
    ⊢ FmtFlat from match nodes {
      FmtNoNodes => f
      FmtNodesOf(node, rest) => fmt_flat_nodes(rest, fmt_flat_node(node, f))
    }
  }
  pub fn fmt_flat_items(items: FmtItems, first: Bool, f: FmtFlat): FmtFlat {
    ⊢ FmtFlat from match items {
      FmtNoItems => f
      FmtItemsOf(item, rest) => fmt_flat_items(
        rest,
        false,
        fmt_flat_nodes(item, fmt_push_comma(first, f))
      )
    }
  }
}

pub fn fmt_parts_text(parts: List(Text)): Text {
  Text::concat_all(List::reverse(parts))
}

pub fn fmt_flat_text(nodes: FmtNodes): Text {
  fmt_parts_text(fmt_flat_nodes(nodes, FmtFlat { prev: None, parts: Nil }).parts)
}

pub fn fmt_node_text(node: FmtNode): Text {
  fmt_parts_text(fmt_flat_node(node, FmtFlat { prev: None, parts: Nil }).parts)
}

pub fn fmt_last_line(lines: List(Text)): Text {
  ⊢ Text from match lines {
    Nil => ""
    Cons(line, rest) => ⊢ Text from match rest {
      Nil => line
      Cons(next, more) => fmt_last_line(rest)
    }
  }
}

// The column after `text` is written at column `col`.
pub fn fmt_advance(col: Nat, text: Text): Nat {
  ⊢ Nat from match text_find(text, text_newline(), 0) {
    None => col + text_char_count(text)
    Some(at) => text_char_count(fmt_last_line(text_lines(text)))
  }
}

pub fn fmt_spaces(n: Nat): Text {
  Text::repeat(" ", n)
}

pub fn fmt_first_token(node: FmtNode): FmtToken {
  ⊢ FmtToken from match node {
    FmtTok(t) => t
    FmtGroup(open, items, close) => open
  }
}

pub fn fmt_rest_width(rest: FmtNodes): Nat {
  text_char_count(fmt_flat_text(rest))
}

// The width of `nodes` with `tail` after them, if the first group among them that can break
// does: up to its opening bracket.
pub fn fmt_least_width(nodes: FmtNodes, f: FmtFlat, tail: Nat): Nat {
  ⊢ Nat from match nodes {
    FmtNoNodes => text_char_count(fmt_parts_text(f.parts)) + tail
    FmtNodesOf(node, rest) => ⊢ Nat from match node {
      FmtTok(t) => fmt_least_width(rest, fmt_push(t, f), tail)
      FmtGroup(open, items, close) => ⊢ Nat from match fmt_items_empty(items) {
        true => fmt_least_width(rest, fmt_flat_node(node, f), tail)
        false => text_char_count(fmt_parts_text(fmt_push(open, f).parts))
      }
    }
  }
}

pub fn fmt_is_arrow_end(t: FmtToken, prev: Option(Text)): Bool {
  ⊢ Bool from match prev {
    None => false
    Some(before) => t.lexeme == ">" && before == "=" && (⊢ Bool from match t.spaced {
      true => false
      false => true
    })
  }
}

// The flat width through the first group's opening bracket after a `=>` in `nodes`.
pub fn fmt_arrow_head(nodes: FmtNodes, arrow: Bool, f: FmtFlat): Option(Nat) {
  ⊢ Option(Nat) from match nodes {
    FmtNoNodes => None
    FmtNodesOf(node, rest) => ⊢ Option(Nat) from match node {
      FmtTok(t) => fmt_arrow_head(rest, arrow || fmt_is_arrow_end(t, f.prev), fmt_push(t, f))
      FmtGroup(open, items, close) => ⊢ Option(Nat) from match arrow && (⊢ Bool from match fmt_items_empty(items) {
        true => false
        false => true
      }) {
        true => Some(text_char_count(fmt_parts_text(fmt_push(open, f).parts)))
        false => fmt_arrow_head(rest, arrow, fmt_flat_node(node, f))
      }
    }
  }
}

// The width of what follows a group on the line, as far as the group must fit: through the
// next group's opening bracket after a `=>`, or all of it with `tail` when there is none. So
// `Cons(y, ys) => f(…)` breaks inside `f(`, not inside the pattern.
pub fn fmt_unbroken_width(rest: FmtNodes, tail: Nat): Nat {
  ⊢ Nat from match fmt_arrow_head(rest, false, FmtFlat { prev: None, parts: Nil }) {
    None => tail + fmt_rest_width(rest)
    Some(w) => w
  }
}

// What follows `node` on its line, for whether it fits. A `{ }` breaks last: only if it does not
// fit with what follows broken.
pub fn fmt_after_width(node: FmtNode, rest: FmtNodes, tail: Nat): Nat {
  ⊢ Nat from match node {
    FmtTok(t) => fmt_unbroken_width(rest, tail)
    FmtGroup(open, items, close) => ⊢ Nat from match open.lexeme == "{" {
      true => fmt_least_width(rest, FmtFlat { prev: None, parts: Nil }, tail)
      false => fmt_unbroken_width(rest, tail)
    }
  }
}

pub(open) inductive FmtOut: Type {
  Mk(col: Nat, prev: Option(Text), parts: List(Text)): FmtOut
}

// Each item but the last ends with a comma; its layout leaves room for it.
pub fn fmt_item_tail(rest: FmtItems): Nat {
  ⊢ Nat from match rest {
    FmtNoItems => 0
    FmtItemsOf(i, more) => 1
  }
}

pub fn fmt_item_end(rest: FmtItems, out: FmtOut): FmtOut {
  ⊢ FmtOut from match rest {
    FmtNoItems => out
    FmtItemsOf(i, more) => FmtOut { col: out.col, prev: out.prev, parts: Cons(",", out.parts) }
  }
}

// Whether a group fits flat from where the layout is, with `after` more
// columns of the line after it.
pub fn fmt_fits(out: FmtOut, node: FmtNode, after: Nat): Bool {
  out.col + text_char_count(
    fmt_gap(out.prev, fmt_first_token(node))
  ) + text_char_count(fmt_node_text(node)) + after <= fmt_width()
}

pub fn fmt_out_parts(out: FmtOut): List(Text) {
  out.parts
}

// Whether a `=>` comes later in `nodes`, at this level. A group before it is a `match` arm's
// pattern (or a parameter) and stays on one line; the line breaks after the `=>`.
pub fn fmt_arrow_follows(nodes: FmtNodes, prev: Option(Text)): Bool {
  ⊢ Bool from match nodes {
    FmtNoNodes => false
    FmtNodesOf(node, rest) => ⊢ Bool from match node {
      FmtTok(t) => fmt_is_arrow_end(t, prev) || fmt_arrow_follows(rest, Some(t.lexeme))
      FmtGroup(open, items, close) => fmt_arrow_follows(rest, Some(close.lexeme))
    }
  }
}

pub fn fmt_place_flat(open: FmtToken, node: FmtNode, close: FmtToken, out: FmtOut): FmtOut {
  FmtOut {
    col: fmt_advance(
      out.col,
      Text::concat_all(Cons(fmt_gap(out.prev, open), Cons(fmt_node_text(node), Nil)))
    ),
    prev: Some(close.lexeme),
    parts: Cons(fmt_node_text(node), Cons(fmt_gap(out.prev, open), out.parts))
  }
}

// Lays out `nodes` on a line indented `indent`, breaking the groups that do
// not fit. `tail` is the width of what follows on the same line.
mutual {
  pub fn fmt_layout_nodes(nodes: FmtNodes, indent: Nat, tail: Nat, out: FmtOut): FmtOut {
    ⊢ FmtOut from match nodes {
      FmtNoNodes => out
      FmtNodesOf(node, rest) => fmt_layout_nodes(
        rest,
        indent,
        tail,
        ⊢ FmtOut from match node {
          FmtTok(t) => fmt_layout_node(node, indent, fmt_after_width(node, rest, tail), out)
          FmtGroup(open, items, close) => ⊢ FmtOut from match fmt_arrow_follows(rest, None) {
            true => fmt_place_flat(open, node, close, out)
            false => fmt_layout_node(node, indent, fmt_after_width(node, rest, tail), out)
          }
        }
      )
    }
  }
  // One node, with `tail` the width of what follows it on the line.
  pub fn fmt_layout_node(node: FmtNode, indent: Nat, tail: Nat, out: FmtOut): FmtOut {
    ⊢ FmtOut from match node {
      FmtGroup(open, FmtItemsOf(FmtNodesOf(FmtTok(lit), FmtNoNodes), FmtNoItems), close) => if open.lexeme == "(" {
        ⊢ FmtOut from match fmt_literal_layout(lit.lexeme, indent + 2) {
          None => fmt_layout_regular(node, indent, tail, out)
          Some(text) => FmtOut {
            col: indent + 2 + text_char_count(close.lexeme) + fmt_run_end(lit.lexeme, 0, 96, true),
            prev: Some(close.lexeme),
            parts: Cons(
              close.lexeme,
              Cons(text, Cons(open.lexeme, Cons(fmt_gap(out.prev, open), out.parts)))
            )
          }
        }
      } else { fmt_layout_regular(node, indent, tail, out) }
      _ => fmt_layout_regular(node, indent, tail, out)
    }
  }
  pub fn fmt_layout_regular(node: FmtNode, indent: Nat, tail: Nat, out: FmtOut): FmtOut {
    ⊢ FmtOut from match node {
      FmtTok(t) => FmtOut {
        col: fmt_advance(fmt_advance(out.col, fmt_gap(out.prev, t)), t.lexeme),
        prev: Some(t.lexeme),
        parts: Cons(t.lexeme, Cons(fmt_gap(out.prev, t), out.parts))
      }
      FmtGroup(open, items, close) => ⊢ FmtOut from match fmt_fits(
        out,
        FmtGroup(open, items, close),
        tail
      ) || fmt_items_empty(items) || fmt_unbreakable(items) {
        true => FmtOut {
          col: fmt_advance(
            out.col,
            Text::concat_all(
              Cons(fmt_gap(out.prev, open), Cons(fmt_node_text(FmtGroup(open, items, close)), Nil))
            )
          ),
          prev: Some(close.lexeme),
          parts: Cons(
            fmt_node_text(FmtGroup(open, items, close)),
            Cons(fmt_gap(out.prev, open), out.parts)
          )
        }
        false => FmtOut {
          col: indent + text_char_count(close.lexeme),
          prev: Some(close.lexeme),
          parts: Cons(
            close.lexeme,
            Cons(
              fmt_spaces(indent),
              Cons(
                text_newline(),
                fmt_out_parts(
                  fmt_layout_items(
                    items,
                    indent + 2,
                    FmtOut {
                      col: out.col,
                      prev: out.prev,
                      parts: Cons(open.lexeme, Cons(fmt_gap(out.prev, open), out.parts))
                    }
                  )
                )
              )
            )
          )
        }
      }
    }
  }
  // The items of a broken group, one a line, indented `inner`.
  pub fn fmt_layout_items(items: FmtItems, inner: Nat, out: FmtOut): FmtOut {
    ⊢ FmtOut from match items {
      FmtNoItems => out
      FmtItemsOf(item, rest) => fmt_layout_items(
        rest,
        inner,
        fmt_item_end(
          rest,
          fmt_layout_nodes(
            item,
            inner,
            fmt_item_tail(rest),
            FmtOut {
              col: inner,
              prev: None,
              parts: Cons(fmt_spaces(inner), Cons(text_newline(), out.parts))
            }
          )
        )
      )
    }
  }
}

// A line cut from the tokens: its tokens, the tokens after it, the brackets
// still open after it (the last opened first) and whether it is left as
// written.
pub(open) inductive FmtLine: Type {
  Mk(line: List(FmtToken), rest: List(FmtToken), stack: List(Text), verbatim: Bool): FmtLine
}

pub fn fmt_count_braces(stack: List(Text), n: Nat): Nat {
  ⊢ Nat from match stack {
    Nil => n
    Cons(open, rest) => fmt_count_braces(
      rest,
      ⊢ Nat from match open == "{" {
        true => n + 1
        false => n
      }
    )
  }
}

// Whether a bracket other than `{` is open.
pub fn fmt_in_brackets(stack: List(Text)): Bool {
  ⊢ Bool from match stack {
    Nil => false
    Cons(open, rest) => open != "{" || fmt_in_brackets(rest)
  }
}

pub fn fmt_last_is_brace(stack: List(Text)): Bool {
  ⊢ Bool from match stack {
    Nil => false
    Cons(open, rest) => open == "{"
  }
}

pub fn fmt_stacked(t: FmtToken, stack: List(Text)): FmtOr(List(Text)) {
  ⊢ FmtOr(List(Text)) from match fmt_is(t, FmtOpen) {
    true => FmtOk(Cons(t.lexeme, stack))
    false => ⊢ FmtOr(List(Text)) from match fmt_is(t, FmtClose) {
      true => ⊢ FmtOr(List(Text)) from match stack {
        Nil => FmtErr(Text::concat_all(Cons("an unmatched `", Cons(t.lexeme, Cons("`", Nil)))))
        Cons(open, below) => FmtOk(below)
      }
      false => FmtOk(stack)
    }
  }
}

// One of the kinds a list of what a declaration makes (`=> fn a, theorem b`) names.
pub fn fmt_is_kind_word(t: FmtToken): Bool {
  fmt_is(
    t,
    FmtWord
  ) && (t.lexeme == "fn" || t.lexeme == "theorem" || t.lexeme == "def" || t.lexeme == "inductive" || t.lexeme == "struct" || t.lexeme == "enum")
}

pub fn fmt_ends_arrow(rev: List(FmtToken)): Bool {
  ⊢ Bool from match rev {
    Nil => false
    Cons(gt, more) => ⊢ Bool from match more {
      Nil => false
      Cons(eq, before) => gt.lexeme == ">" && eq.lexeme == "=" && not(gt.spaced)
    }
  }
}

pub fn fmt_has_list(rev: List(FmtToken)): Bool {
  ⊢ Bool from match rev {
    Nil => false
    Cons(w, r1) => ⊢ Bool from match r1 {
      Nil => false
      Cons(k, r2) => ⊢ Bool from match r2 {
        Nil => false
        Cons(gt, r3) => ⊢ Bool from match r3 {
          Nil => false
          Cons(eq, more) => (
            fmt_is(
              w,
              FmtWord
            ) && fmt_is_kind_word(k) && gt.lexeme == ">" && not(gt.spaced) && eq.lexeme == "="
          ) || fmt_has_list(r1)
        }
      }
    }
  }
}

// Whether a list of what a declaration makes goes on at `next`, on a new line: after its `=>` or
// after one of its commas.
pub fn fmt_continues_list(rev: List(FmtToken), next: FmtToken): Bool {
  ⊢ Bool from match rev {
    Nil => false
    Cons(last, before) => ⊢ Bool from match fmt_ends_arrow(rev) {
      true => fmt_is_kind_word(next)
      false => last.lexeme == "," && fmt_is_kind_word(next) && fmt_has_list(rev)
    }
  }
}

// Reads the token `t` into `stack`, and the tokens after it into the line up
// to a newline where only braces are open.
pub fn fmt_scan_line(
  after: List(FmtToken),
  t: FmtToken,
  stack: List(Text),
  verbatim: Bool,
  line: List(FmtToken)
): FmtOr(FmtLine) {
  ⊢ FmtOr(FmtLine) from match after {
    Nil => ⊢ FmtOr(FmtLine) from match fmt_stacked(t, stack) {
      FmtErr(message) => FmtErr(message)
      FmtOk(now) => FmtOk(
        FmtLine {
          line: List::reverse(Cons(t, line)),
          rest: after,
          stack: now,
          verbatim: verbatim || (fmt_is(t, FmtComment) && fmt_in_brackets(now))
        }
      )
    }
    Cons(next, more) => ⊢ FmtOr(FmtLine) from match fmt_stacked(t, stack) {
      FmtErr(message) => FmtErr(message)
      FmtOk(now) => ⊢ FmtOr(FmtLine) from match next.newlines > 0 && not(
        fmt_in_brackets(now)
      ) && not(fmt_continues_list(Cons(t, line), next)) {
        true => FmtOk(
          FmtLine {
            line: List::reverse(Cons(t, line)),
            rest: after,
            stack: now,
            verbatim: verbatim || (fmt_is(t, FmtComment) && fmt_in_brackets(now))
          }
        )
        false => fmt_scan_line(
          more,
          next,
          now,
          verbatim || (
            fmt_is(t, FmtComment) && fmt_in_brackets(now)
          ) || (
            next.newlines > 0 && fmt_last_is_brace(now)
          ) || (next.newlines > 0 && fmt_continues_list(Cons(t, line), next)),
          Cons(t, line)
        )
      }
    }
  }
}

pub fn fmt_first_text(line: List(FmtToken)): Text {
  ⊢ Text from match line {
    Nil => ""
    Cons(t, rest) => t.lexeme
  }
}

pub fn fmt_first_newlines(line: List(FmtToken)): Nat {
  ⊢ Nat from match line {
    Nil => 0
    Cons(t, rest) => t.newlines
  }
}

pub fn fmt_first_start(line: List(FmtToken)): Nat {
  ⊢ Nat from match line {
    Nil => 0
    Cons(t, rest) => t.start
  }
}

pub fn fmt_last_end(line: List(FmtToken)): Nat {
  ⊢ Nat from match line {
    Nil => 0
    Cons(t, rest) => ⊢ Nat from match rest {
      Nil => t.end
      Cons(next, more) => fmt_last_end(rest)
    }
  }
}

// The end of `t` without the white space at its end, within `k` characters.
pub fn fmt_trim_end_in(k: Nat, classes: UnicodeClasses, t: Text, at: Nat, end: Nat): Nat {
  ⊢ Nat from match k {
    Zero => end
    Succ(k2) => ⊢ Nat from match text_decode(t, at) {
      None => end
      Some(#(@code code, @len len)) => ⊢ Nat from match unicode_is_whitespace(classes, code) {
        true => fmt_trim_end_in(k2, classes, t, at + len, end)
        false => fmt_trim_end_in(k2, classes, t, at + len, at + len)
      }
    }
  }
}

pub fn fmt_trim_end(classes: UnicodeClasses, t: Text): Text {
  Text::slice_or_empty(t, 0, fmt_trim_end_in(Text::len(t), classes, t, 0, 0))
}

pub fn fmt_trim_lines(classes: UnicodeClasses, lines: List(Text)): List(Text) {
  ⊢ List(Text) from match lines {
    Nil => Nil
    Cons(line, rest) => Cons(fmt_trim_end(classes, line), fmt_trim_lines(classes, rest))
  }
}

// The line as written, its first line indented anew and its other lines as
// they were, without white space at their ends.
pub fn fmt_verbatim(classes: UnicodeClasses, source: Text, line: List(FmtToken)): Text {
  text_join(
    fmt_trim_lines(
      classes,
      text_lines(Text::slice_or_empty(source, fmt_first_start(line), fmt_last_end(line)))
    ),
    text_newline()
  )
}

pub fn fmt_unmatched(rest: List(FmtToken)): Text {
  Text::concat_all(Cons("an unmatched `", Cons(fmt_first_text(rest), Cons("`", Nil))))
}

// The newlines before a line: one, or two where the source had a blank line.
pub fn fmt_line_break(first: Bool, line: List(FmtToken), parts: List(Text)): List(Text) {
  ⊢ List(Text) from match first {
    true => parts
    false => ⊢ List(Text) from match fmt_first_newlines(line) > 1 {
      true => Cons(text_newline(), Cons(text_newline(), parts))
      false => Cons(text_newline(), parts)
    }
  }
}

pub fn fmt_indent(line: List(FmtToken), depth: Nat): Nat {
  ⊢ Nat from match fmt_first_text(line) == "}" && depth > 0 {
    true => 2 * (depth - 1)
    false => 2 * depth
  }
}

// One line, laid out or left as written, after `parts` (last first).
pub fn fmt_write_line(
  classes: UnicodeClasses,
  source: Text,
  scanned: FmtLine,
  depth: Nat,
  first: Bool,
  parts: List(Text)
): FmtOr(List(Text)) {
  ⊢ FmtOr(List(Text)) from match scanned.verbatim {
    true => FmtOk(
      Cons(
        fmt_verbatim(classes, source, scanned.line),
        Cons(
          fmt_spaces(fmt_indent(scanned.line, depth)),
          fmt_line_break(first, scanned.line, parts)
        )
      )
    )
    false => ⊢ FmtOr(List(Text)) from match fmt_tree(scanned.line) {
      Mk(nodes, rest) => ⊢ FmtOr(List(Text)) from match rest {
        Nil => FmtOk(
          fmt_layout_nodes(
            nodes,
            fmt_indent(scanned.line, depth),
            0,
            FmtOut {
              col: fmt_indent(scanned.line, depth),
              prev: None,
              parts: Cons(fmt_spaces(fmt_indent(scanned.line, depth)), fmt_line_break(first, scanned.line, parts))
            }
          ).parts
        )
        Cons(t, more) => FmtErr(fmt_unmatched(rest))
      }
    }
  }
}

pub(open) inductive FmtWritten: Type {
  Mk(parts: List(Text), stack: List(Text)): FmtWritten
}

// The lines of `tokens` after `parts`. Each line takes a token at least, so
// `fuel` is the number of tokens.
pub fn fmt_lines_in(
  fuel: Nat,
  classes: UnicodeClasses,
  source: Text,
  tokens: List(FmtToken),
  stack: List(Text),
  first: Bool,
  parts: List(Text)
): FmtOr(FmtWritten) {
  ⊢ FmtOr(FmtWritten) from match fuel {
    Zero => FmtOk(FmtWritten { parts: parts, stack: stack })
    Succ(f) => ⊢ FmtOr(FmtWritten) from match tokens {
      Nil => FmtOk(FmtWritten { parts: parts, stack: stack })
      Cons(t, after) => ⊢ FmtOr(FmtWritten) from match fmt_scan_line(after, t, stack, false, Nil) {
        FmtErr(message) => FmtErr(message)
        FmtOk(scanned) => ⊢ FmtOr(FmtWritten) from match fmt_write_line(
          classes,
          source,
          scanned,
          fmt_count_braces(stack, 0),
          first,
          parts
        ) {
          FmtErr(message) => FmtErr(message)
          FmtOk(written) => fmt_lines_in(
            f,
            classes,
            source,
            scanned.rest,
            scanned.stack,
            false,
            written
          )
        }
      }
    }
  }
}

pub fn fmt_same_normalized_tokens(
  classes: UnicodeClasses,
  a: List(FmtToken),
  b: List(FmtToken)
): Bool {
  ⊢ Bool from match a {
    Nil => ⊢ Bool from match b {
      Nil => true
      Cons(y, more) => false
    }
    Cons(x, rest) => ⊢ Bool from match b {
      Nil => false
      Cons(y, more) => fmt_token_key(
        classes,
        x.lexeme
      ) == fmt_token_key(classes, y.lexeme) && fmt_same_normalized_tokens(classes, rest, more)
    }
  }
}

pub fn fmt_kept(same: Bool, formatted: Text): FmtOr(Text) {
  ⊢ FmtOr(Text) from match same {
    true => FmtOk(formatted)
    false => FmtErr("the layout would change the tokens")
  }
}

pub fn fmt_checked_from(
  classes: UnicodeClasses,
  again: FmtOr(List(FmtToken)),
  tokens: List(FmtToken),
  formatted: Text
): FmtOr(Text) {
  ⊢ FmtOr(Text) from match again {
    FmtErr(message) => FmtErr(message)
    FmtOk(lexed) => fmt_kept(fmt_same_normalized_tokens(classes, tokens, lexed), formatted)
  }
}

pub fn fmt_checked(classes: UnicodeClasses, tokens: List(FmtToken), formatted: Text): FmtOr(Text) {
  fmt_checked_from(classes, fmt_lex(formatted, classes), tokens, formatted)
}

// The source laid out again; an error when its brackets do not match or the
// layout would change its tokens.
pub fn fmt_format_layout(
  classes: UnicodeClasses,
  source: Text,
  tokens: List(FmtToken)
): FmtOr(Text) {
  ⊢ FmtOr(Text) from match fmt_lines_in(
    List::length(tokens) + 1,
    classes,
    source,
    tokens,
    Nil,
    true,
    Nil
  ) {
    FmtErr(message) => FmtErr(message)
    FmtOk(written) => ⊢ FmtOr(Text) from match written.stack {
      Cons(open, more) => FmtErr("an unclosed bracket")
      Nil => fmt_checked(classes, tokens, fmt_parts_text(Cons(text_newline(), written.parts)))
    }
  }
}

pub theorem fmt_err_ne_ok(m: Text, x: Text, e: FmtErr(m) = FmtOk(x)): False {
  ⊢ False from match e {
  }
}

// A check that passes preserves the tokens, with block literals compared at
// a common indentation. The final formatter also compares the surface AST.
pub theorem fmt_checked_keeps_normalized_tokens(
  classes: UnicodeClasses,
  lexed: FmtOr(List(FmtToken)),
  tokens: List(FmtToken),
  formatted: Text,
  again: List(FmtToken),
  out: Text,
  is: lexed = FmtOk(again),
  ok: fmt_checked_from(classes, lexed, tokens, formatted) = FmtOk(out)
): fmt_same_normalized_tokens(classes, tokens, again) = true {
  Bool::cases(
    (b: Bool) => b = true,
    fmt_same_normalized_tokens(classes, tokens, again),
    (e: fmt_same_normalized_tokens(classes, tokens, again) = false) => False::elim(
      fmt_err_ne_ok(
        "the layout would change the tokens",
        out,
        Eq::subst(
          (s: Bool) => fmt_kept(s, formatted) = FmtOk(out),
          e,
          Eq::subst(
            (r: FmtOr(List(FmtToken))) => fmt_checked_from(
              classes,
              r,
              tokens,
              formatted
            ) = FmtOk(out),
            is,
            ok
          )
        )
      )
    ),
    (e: fmt_same_normalized_tokens(classes, tokens, again) = true) => Refl
  )
}

pub fn fmt_ast_key(&tables: SyntaxTables, classes: UnicodeClasses, source: Text): Option(Text) {
  ⊢ Option(Text) from match surface_parse_program(tables, classes, source, 0) {
    None => None
    Some(stmts) => fmt_key_List_SurfaceStmt(Text::len(source) * 16 + 128, stmts)
  }
}

pub fn fmt_same_ast(
  &tables: SyntaxTables,
  classes: UnicodeClasses,
  source: Text,
  formatted: Text
): Bool {
  ⊢ Bool from match fmt_ast_key(tables, classes, source) {
    None => false
    Some(before) => ⊢ Bool from match fmt_ast_key(tables, classes, formatted) {
      None => false
      Some(after) => before == after
    }
  }
}

pub fn fmt_sole_node(k: Nat, node: CstNode, name: Text): Option(CstNode) {
  ⊢ Option(CstNode) from match k {
    Zero => None
    Succ(j) => if surface_is(node, name) { Some(node) } else {
      ⊢ Option(CstNode) from match node.flat {
        Cons(child, Nil) => fmt_sole_node(j, child, name)
        _ => None
      }
    }
  }
}

pub fn fmt_block_stmts(k: Nat, nodes: List(CstNode)): List(CstNode) {
  ⊢ List(CstNode) from match k {
    Zero => Nil
    Succ(j) => ⊢ List(CstNode) from match nodes {
      Nil => Nil
      Cons(node, rest) => if surface_is(node, "Stmt") {
        Cons(node, fmt_block_stmts(j, rest))
      } else if surface_is(node, "Stmts") || surface_is(node, "StmtsTail") {
        List::append(fmt_block_stmts(j, node.flat), fmt_block_stmts(j, rest))
      } else { fmt_block_stmts(j, rest) }
    }
  }
}

pub(open) inductive FmtBlockSpan: Type {
  FmtBlockSpanMk(start: Nat, end: Nat): FmtBlockSpan
}

// The `Block` or `Brace` a chain of single children leads to: a block of statements, or the
// braces of an expression.
pub fn fmt_sole_braced(k: Nat, node: CstNode): Option(CstNode) {
  ⊢ Option(CstNode) from match k {
    Zero => None
    Succ(j) => if surface_is(node, "Block") || surface_is(node, "Brace") { Some(node) } else {
      ⊢ Option(CstNode) from match node.flat {
        Cons(child, Nil) => fmt_sole_braced(j, child)
        _ => None
      }
    }
  }
}

// The innermost `BraceBody`: the newlines after a `{` nest it.
pub fn fmt_inner_body(k: Nat, body: CstNode): CstNode {
  ⊢ CstNode from match k {
    Zero => body
    Succ(j) => ⊢ CstNode from match surface_first(body, "BraceBody") {
      Some(inner) => fmt_inner_body(j, inner)
      None => body
    }
  }
}

// The node that holds the statements of a block: the block itself, or the body of braces that
// are not a record type.
pub fn fmt_block_holder(k: Nat, braced: CstNode): Option(CstNode) {
  ⊢ Option(CstNode) from match surface_is(braced, "Block") {
    true => Some(braced)
    false => ⊢ Option(CstNode) from match surface_first(braced, "BraceBody") {
      None => None
      Some(body) => {
        let inner := fmt_inner_body(k, body)
        ⊢ Option(CstNode) from match surface_has(inner.flat, "RecordType") {
          true => None
          false => Some(inner)
        }
      }
    }
  }
}

pub fn fmt_optional_block(k: Nat, node: CstNode): Option(FmtBlockSpan) {
  let body := ⊢ CstNode from match surface_first(node, "Expr") {
    None => node
    Some(expr) => expr
  }
  ⊢ Option(FmtBlockSpan) from match fmt_sole_braced(k, body) {
    None => None
    Some(block) => ⊢ Option(FmtBlockSpan) from match fmt_block_holder(k, block) {
      None => None
      Some(holder) => ⊢ Option(FmtBlockSpan) from match fmt_block_stmts(k, holder.flat) {
        Cons(stmt, Nil) => ⊢ Option(FmtBlockSpan) from match fmt_sole_node(k, stmt, "IfExpr") {
          Some(inner) => Some(FmtBlockSpan { start: block.start, end: block.end })
          None => if surface_is(node, "ArmBody") {
            ⊢ Option(FmtBlockSpan) from match fmt_sole_node(k, stmt, "MatchExpr") {
              Some(inner) => Some(FmtBlockSpan { start: block.start, end: block.end })
              None => None
            }
          } else { None }
        }
        _ => None
      }
    }
  }
}

pub fn fmt_removable_blocks(k: Nat, nodes: List(CstNode)): List(FmtBlockSpan) {
  ⊢ List(FmtBlockSpan) from match k {
    Zero => Nil
    Succ(j) => ⊢ List(FmtBlockSpan) from match nodes {
      Nil => Nil
      Cons(node, rest) => {
        let later := fmt_removable_blocks(j, rest)
        if surface_is(
          node,
          "QuoteExpr"
        ) || surface_is(node, "MacroCall") || surface_is(node, "SyntaxLit") {
          later
        } else {
          let inside := List::append(fmt_removable_blocks(j, node.flat), later)
          if surface_is(node, "ArmBody") || surface_is(node, "ElseBranch") {
            ⊢ List(FmtBlockSpan) from match fmt_optional_block(j, node) {
              None => inside
              Some(span) => Cons(span, inside)
            }
          } else { inside }
        }
      }
    }
  }
}

// A fence and its content at a requested baseline. Whitespace before the
// closing fence is removed by the surface reader, then restored at the baseline.
pub fn fmt_literal_layout(text: Text, indent: Nat): Option(Text) {
  if text_starts_with(
    text,
    "```",
    0
  ) { fmt_literal_layout_with(unicode_classes(), text, indent) } else { None }
}

pub fn fmt_literal_layout_with(classes: UnicodeClasses, text: Text, indent: Nat): Option(Text) {
  let ticks := fmt_run_end(text, 0, 96, true)
  if ticks < 3 || ticks > 6 { None } else {
    let content := Text::slice_or_empty(text, surface_line_end(text, 0), Text::len(text) - ticks)
    ⊢ Option(Text) from match surface_last_newline(content, Text::len(content) - 1) {
      None => if surface_blank_tail(
        content,
        0
      ) { fmt_literal_rebuild(classes, text, ticks, indent) } else { None }
      Some(last) => if surface_blank_tail(content, last + 1) {
        let c := SurfaceCtx { source: text, base: 0, classes: classes, fuel: 0 }
        if fmt_literal_valid_lines(
          c,
          text_lines(Text::slice_or_empty(content, 0, last + 1)),
          Text::len(content) - last - 1
        ) {
          fmt_literal_rebuild(classes, text, ticks, indent)
        } else { None }
      } else { None }
    }
  }
}

pub fn fmt_literal_valid_lines(c: SurfaceCtx, lines: List(Text), baseline: Nat): Bool {
  ⊢ Bool from match lines {
    Nil => true
    Cons(line, rest) => (
      Text::len(
        surface_trim(c, line)
      ) == 0 || surface_lead_in(Text::len(line) + 1, line, 0) >= baseline
    ) && fmt_literal_valid_lines(c, rest, baseline)
  }
}

pub fn fmt_literal_rebuild(
  classes: UnicodeClasses,
  text: Text,
  ticks: Nat,
  indent: Nat
): Option(Text) {
  let c := SurfaceCtx { source: text, base: 0, classes: classes, fuel: 0 }
  let lit := surface_block_lit(c, text, ticks)
  let fence := Text::repeat("`", ticks)
  let name := ⊢ Text from match lit.name {
    None => ""
    Some(value) => value
  }
  Some(
    Text::concat_all(
      [
        fence,
        name,
        text_newline(),
        fmt_literal_lines(c, text_lines(lit.body), indent),
        fmt_spaces(indent),
        fence
      ]
    )
  )
}

pub fn fmt_literal_lines(c: SurfaceCtx, lines: List(Text), indent: Nat): Text {
  ⊢ Text from match lines {
    Nil => ""
    Cons(line, rest) => ⊢ Text from match rest {
      Nil => line
      Cons(next, more) => Text::concat_all(
        [
          if Text::len(surface_trim(c, line)) == 0 { "" } else { fmt_spaces(indent) },
          line,
          text_newline(),
          fmt_literal_lines(c, rest, indent)
        ]
      )
    }
  }
}

pub fn fmt_token_key(classes: UnicodeClasses, text: Text): Text {
  ⊢ Text from match fmt_literal_layout_with(classes, text, 0) {
    None => text
    Some(value) => value
  }
}

pub fn fmt_block_boundaries(tokens: List(FmtToken), spans: List(FmtBlockSpan)): List(FmtBlockSpan) {
  ⊢ List(FmtBlockSpan) from match spans {
    Nil => Nil
    Cons(FmtBlockSpanMk(start, end), rest) => {
      let inside := fmt_tokens_in(tokens, start, end)
      ⊢ List(FmtBlockSpan) from match inside {
        Cons(open, Cons(first, tail)) => if fmt_is(
          first,
          FmtComment
        ) || first.lexeme == ";" || fmt_last_comment(tail) {
          fmt_block_boundaries(tokens, rest)
        } else { Cons(FmtBlockSpan { start: start, end: end }, fmt_block_boundaries(tokens, rest)) }
        _ => fmt_block_boundaries(tokens, rest)
      }
    }
  }
}

pub fn fmt_tokens_in(tokens: List(FmtToken), start: Nat, end: Nat): List(FmtToken) {
  ⊢ List(FmtToken) from match tokens {
    Nil => Nil
    Cons(t, rest) => if start <= t.start && t.end <= end {
      Cons(t, fmt_tokens_in(rest, start, end))
    } else { fmt_tokens_in(rest, start, end) }
  }
}

pub fn fmt_last_comment(tokens: List(FmtToken)): Bool {
  ⊢ Bool from match tokens {
    Nil => false
    Cons(first, rest) => ⊢ Bool from match rest {
      Nil => false
      Cons(second, after) => ⊢ Bool from match after {
        Nil => fmt_is(first, FmtComment) || first.lexeme == ";"
        Cons(third, more) => fmt_last_comment(rest)
      }
    }
  }
}

pub fn fmt_boundary(t: FmtToken, spans: List(FmtBlockSpan)): Nat {
  ⊢ Nat from match spans {
    Nil => 0
    Cons(FmtBlockSpanMk(start, end), rest) => if t.start == start { 1 } else if t.end == end {
      2
    } else { fmt_boundary(t, rest) }
  }
}

pub fn fmt_remove_blocks(
  tokens: List(FmtToken),
  spans: List(FmtBlockSpan),
  join: Bool
): List(FmtToken) {
  ⊢ List(FmtToken) from match tokens {
    Nil => Nil
    Cons(t, rest) => ⊢ List(FmtToken) from match fmt_boundary(t, spans) {
      1 => fmt_remove_blocks(rest, spans, true)
      2 => fmt_remove_blocks(rest, spans, join)
      _ => Cons(
        FmtToken {
          lexeme: t.lexeme,
          kind: t.kind,
          spaced: join || t.spaced,
          newlines: if join { 0 } else { t.newlines },
          start: t.start,
          end: t.end
        },
        fmt_remove_blocks(rest, spans, false)
      )
    }
  }
}

// The braces of an `inductive`'s constructors or a `match`'s arms, and the span of each member.
pub(open) inductive FmtShort: Type {
  FmtShortMk(start: Nat, end: Nat, members: List(FmtBlockSpan)): FmtShort
}

// The `member`s of a list, through its `tail`s.
pub fn fmt_members(k: Nat, nodes: List(CstNode), member: Text, tail: Text): List(FmtBlockSpan) {
  ⊢ List(FmtBlockSpan) from match k {
    Zero => Nil
    Succ(j) => ⊢ List(FmtBlockSpan) from match nodes {
      Nil => Nil
      Cons(node, rest) => if surface_is(node, member) {
        Cons(FmtBlockSpan { start: node.start, end: node.end }, fmt_members(j, rest, member, tail))
      } else if surface_is(node, tail) || surface_is(node, "Constructors") || surface_is(node, "Arms") {
        List::append(fmt_members(j, node.flat, member, tail), fmt_members(j, rest, member, tail))
      } else { fmt_members(j, rest, member, tail) }
    }
  }
}

// A brace: its own non-terminal (`LBrace: '{'`), or the terminal.
pub fn fmt_terminal(nodes: List(CstNode), name: Text): Option(CstNode) {
  ⊢ Option(CstNode) from match nodes {
    Nil => None
    Cons(n, rest) => if n.name == name { Some(n) } else { fmt_terminal(rest, name) }
  }
}

pub fn fmt_short_of(k: Nat, node: CstNode, member: Text, tail: Text): List(FmtShort) {
  ⊢ List(FmtShort) from match fmt_terminal(node.flat, "LBrace") {
    None => Nil
    Some(open) => ⊢ List(FmtShort) from match fmt_terminal(node.flat, "RBrace") {
      None => Nil
      Some(close) => Cons(
        FmtShort { start: open.start, end: close.end, members: fmt_members(k, node.flat, member, tail) },
        Nil
      )
    }
  }
}

pub fn fmt_short_blocks(k: Nat, nodes: List(CstNode)): List(FmtShort) {
  ⊢ List(FmtShort) from match k {
    Zero => Nil
    Succ(j) => ⊢ List(FmtShort) from match nodes {
      Nil => Nil
      Cons(node, rest) => {
        let later := fmt_short_blocks(j, rest)
        if surface_is(
          node,
          "QuoteExpr"
        ) || surface_is(node, "MacroCall") || surface_is(node, "SyntaxLit") {
          later
        } else {
          let inside := List::append(fmt_short_blocks(j, node.flat), later)
          if surface_is(node, "InductiveDecl") {
            List::append(
              fmt_short_of(node.end - node.start + 2, node, "Constructor", "ConstructorsTail"),
              inside
            )
          } else if surface_is(node, "MatchExpr") {
            List::append(fmt_short_of(node.end - node.start + 2, node, "Arm", "ArmsTail"), inside)
          } else { inside }
        }
      }
    }
  }
}

pub fn fmt_find_short(t: FmtToken, shorts: List(FmtShort)): Option(FmtShort) {
  ⊢ Option(FmtShort) from match shorts {
    Nil => None
    Cons(s, rest) => if s.start == t.start && t.lexeme == "{" { Some(s) } else {
      fmt_find_short(t, rest)
    }
  }
}

pub(open) inductive FmtSplit: Type {
  Mk(inner: List(FmtToken), close: FmtToken, after: List(FmtToken)): FmtSplit
}

// The tokens before the `}` that ends at `end` (`inner` last first), the `}` and those after it.
pub fn fmt_split_at(tokens: List(FmtToken), end: Nat, inner: List(FmtToken)): Option(FmtSplit) {
  ⊢ Option(FmtSplit) from match tokens {
    Nil => None
    Cons(t, rest) => if t.end == end && t.lexeme == "}" {
      Some(FmtSplit { inner: List::reverse(inner), close: t, after: rest })
    } else { fmt_split_at(rest, end, Cons(t, inner)) }
  }
}

pub fn fmt_is_single(t: FmtToken): Bool {
  not(fmt_is(t, FmtOpen) || fmt_is(t, FmtClose) || fmt_is(t, FmtComma) || fmt_is(t, FmtComment))
}

// Each member is one token, a `:` or `=>`, and one token. The lexer reads `=>` as `=` and `>`.
pub fn fmt_members_simple(inner: List(FmtToken), members: List(FmtBlockSpan)): Bool {
  ⊢ Bool from match members {
    Nil => true
    Cons(FmtBlockSpanMk(start, end), rest) => ⊢ Bool from match fmt_tokens_in(inner, start, end) {
      Cons(a, Cons(sign, Cons(b, Nil))) => fmt_is_single(a) && fmt_is_single(b) && (
        sign.lexeme == ":" || sign.lexeme == "=>"
      ) && fmt_members_simple(inner, rest)
      Cons(a, Cons(eq, Cons(gt, Cons(b, Nil)))) => fmt_is_single(a) && fmt_is_single(b) && eq.lexeme == "=" && fmt_is_arrow_end(
        gt,
        Some(eq.lexeme)
      ) && fmt_members_simple(inner, rest)
      _ => false
    }
  }
}

pub fn fmt_in_member(t: FmtToken, members: List(FmtBlockSpan)): Bool {
  ⊢ Bool from match members {
    Nil => false
    Cons(FmtBlockSpanMk(start, end), rest) => (start <= t.start && t.end <= end) || fmt_in_member(t, rest)
  }
}

// Between the members only their separators: commas, or the newlines in the gaps.
pub fn fmt_only_members(inner: List(FmtToken), members: List(FmtBlockSpan)): Bool {
  ⊢ Bool from match inner {
    Nil => true
    Cons(t, rest) => (fmt_is(t, FmtComma) || fmt_in_member(t, members)) && fmt_only_members(rest, members)
  }
}

pub fn fmt_on_line(t: FmtToken, spaced: Bool): FmtToken {
  FmtToken {
    lexeme: t.lexeme,
    kind: t.kind,
    spaced: spaced || t.spaced,
    newlines: 0,
    start: t.start,
    end: t.end
  }
}

pub fn fmt_member_line(tokens: List(FmtToken), first: Bool): List(FmtToken) {
  ⊢ List(FmtToken) from match tokens {
    Nil => Nil
    Cons(t, rest) => Cons(fmt_on_line(t, first), fmt_member_line(rest, false))
  }
}

// The members on one line, a comma between each two.
pub fn fmt_join_members(inner: List(FmtToken), members: List(FmtBlockSpan), first: Bool): List(FmtToken) {
  ⊢ List(FmtToken) from match members {
    Nil => Nil
    Cons(FmtBlockSpanMk(start, end), rest) => {
      let body := List::append(
        fmt_member_line(fmt_tokens_in(inner, start, end), true),
        fmt_join_members(inner, rest, false)
      )
      if first { body } else {
        Cons(
          FmtToken { lexeme: ",", kind: FmtComma, spaced: false, newlines: 0, start: start, end: start },
          body
        )
      }
    }
  }
}

pub fn fmt_line_tail(tokens: List(FmtToken)): List(FmtToken) {
  ⊢ List(FmtToken) from match tokens {
    Nil => Nil
    Cons(t, rest) => if t.newlines == 0 { Cons(t, fmt_line_tail(rest)) } else { Nil }
  }
}

pub fn fmt_has_comment(tokens: List(FmtToken)): Bool {
  ⊢ Bool from match tokens {
    Nil => false
    Cons(t, rest) => fmt_is(t, FmtComment) || fmt_has_comment(rest)
  }
}

// Every bracket of the line closes on it, none closing what it does not open.
pub fn fmt_balanced_line(tokens: List(FmtToken), open: Nat): Bool {
  ⊢ Bool from match tokens {
    Nil => open == 0
    Cons(t, rest) => if fmt_is(t, FmtOpen) { fmt_balanced_line(rest, open + 1) } else if fmt_is(
      t,
      FmtClose
    ) { open > 0 && fmt_balanced_line(rest, open - 1) } else { fmt_balanced_line(rest, open) }
  }
}

pub fn fmt_line_fits(line: List(FmtToken), depth: Nat): Bool {
  ⊢ Bool from match fmt_tree(line) {
    Mk(nodes, rest) => ⊢ Bool from match rest {
      Nil => 2 * depth + text_char_count(fmt_flat_text(nodes)) <= fmt_width()
      Cons(t, more) => false
    }
  }
}

pub(open) inductive FmtJoined: Type {
  Mk(tokens: List(FmtToken), after: List(FmtToken)): FmtJoined
}

// The members of the block that `open` begins, on one line, with its `}`, and the tokens after
// it: when the block is short (`crates/tauto/src/fmt.rs`, `join_short_blocks`). `line` is the
// line before `open` (last first) and `depth` the braces open where it begins.
pub fn fmt_try_join(
  open: FmtToken,
  rest: List(FmtToken),
  shorts: List(FmtShort),
  stack: List(Text),
  line: List(FmtToken),
  depth: Nat
): Option(FmtJoined) {
  ⊢ Option(FmtJoined) from match fmt_find_short(open, shorts) {
    None => None
    Some(short) => if fmt_in_brackets(stack) || List::length(short.members) < 2 { None } else {
      ⊢ Option(FmtJoined) from match fmt_split_at(rest, short.end, Nil) {
        None => None
        Some(split) => if fmt_members_simple(
          split.inner,
          short.members
        ) && fmt_only_members(split.inner, short.members) {
          let joined := List::append(
            fmt_join_members(split.inner, short.members, true),
            Cons(fmt_on_line(split.close, true), Nil)
          )
          let whole := List::append(
            List::reverse(Cons(open, line)),
            List::append(joined, fmt_line_tail(split.after))
          )
          if not(fmt_has_comment(whole)) && fmt_balanced_line(whole, 0) && fmt_line_fits(
            whole,
            depth
          ) { Some(FmtJoined { tokens: joined, after: split.after }) } else { None }
        } else { None }
      }
    }
  }
}

pub fn fmt_stack_step(t: FmtToken, stack: List(Text)): List(Text) {
  if fmt_is(t, FmtOpen) { Cons(t.lexeme, stack) } else if fmt_is(t, FmtClose) {
    ⊢ List(Text) from match stack {
      Nil => Nil
      Cons(top, below) => below
    }
  } else { stack }
}

pub fn fmt_reverse_onto(l: List(FmtToken), done: List(FmtToken)): List(FmtToken) {
  ⊢ List(FmtToken) from match l {
    Nil => done
    Cons(t, rest) => fmt_reverse_onto(rest, Cons(t, done))
  }
}

// The tokens with the short blocks joined, after `done` (last first). `stack` holds the brackets
// open before the next token, `line` the tokens of its line before it (last first) and `depth`
// the braces open where that line begins.
pub fn fmt_join_in(
  fuel: Nat,
  tokens: List(FmtToken),
  shorts: List(FmtShort),
  stack: List(Text),
  line: List(FmtToken),
  depth: Nat,
  done: List(FmtToken)
): List(FmtToken) {
  ⊢ List(FmtToken) from match fuel {
    Zero => fmt_reverse_onto(done, tokens)
    Succ(f) => ⊢ List(FmtToken) from match tokens {
      Nil => List::reverse(done)
      Cons(t, rest) => {
        let fresh := t.newlines > 0 && not(fmt_in_brackets(stack))
        let here := if fresh { Nil } else { line }
        let at := if fresh { fmt_count_braces(stack, 0) } else { depth }
        ⊢ List(FmtToken) from match fmt_try_join(t, rest, shorts, stack, here, at) {
          Some(joined) => fmt_join_in(
            f,
            joined.after,
            shorts,
            stack,
            fmt_reverse_onto(joined.tokens, Cons(t, here)),
            at,
            fmt_reverse_onto(joined.tokens, Cons(t, done))
          )
          None => fmt_join_in(f, rest, shorts, fmt_stack_step(t, stack), Cons(t, here), at, Cons(t, done))
        }
      }
    }
  }
}

pub fn fmt_join_short_blocks(tokens: List(FmtToken), shorts: List(FmtShort)): List(FmtToken) {
  fmt_join_in(List::length(tokens) + 1, tokens, shorts, Nil, Nil, 0, Nil)
}

pub fn fmt_format(&tables: SyntaxTables, classes: UnicodeClasses, source: Text): FmtOr(Text) {
  ⊢ FmtOr(Text) from match fmt_lex(source, classes) {
    FmtErr(message) => FmtErr(message)
    FmtOk(tokens) => ⊢ FmtOr(Text) from match syntax_parse(tables, source) {
      None => FmtErr("cannot parse source")
      Some(root) => {
        let spans := fmt_block_boundaries(
          tokens,
          fmt_removable_blocks(surface_size(root) + 1, Cons(root, Nil))
        )
        ⊢ FmtOr(Text) from match fmt_format_layout(
          classes,
          source,
          fmt_join_short_blocks(
            fmt_remove_blocks(tokens, spans, false),
            fmt_short_blocks(surface_size(root) + 1, Cons(root, Nil))
          )
        ) {
          FmtErr(message) => FmtErr(message)
          FmtOk(formatted) => if fmt_same_ast(
            tables,
            classes,
            source,
            formatted
          ) { FmtOk(formatted) } else { FmtErr("the layout would change the AST") }
        }
      }
    }
  }
}
