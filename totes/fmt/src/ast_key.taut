  pub fn fmt_key_List_Option_Bool(fuel: Nat, values: List(Option(Bool))): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match values {
        Nil => Some("Nil")
        Cons(item, rest) => fmt_key_parts(
          [
            Some("Cons"),
            fmt_key_Option_Bool(remaining, item),
            fmt_key_List_Option_Bool(remaining, rest)
          ]
        )
      }
    }
  }
  pub fn fmt_key_List_Option_SurfaceTerm(
    fuel: Nat,
    values: List(Option(SurfaceTerm))
  ): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match values {
        Nil => Some("Nil")
