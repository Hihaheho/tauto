  pub fn fmt_key_SurfaceData(fuel: Nat, node: SurfaceData): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        SurfaceDataMk(kind, name, generics, constructors, start, end) => fmt_key_parts(
          [
            Some("SurfaceDataMk"),
