            fmt_key_List_Option_Text(remaining, bounds),
            Some(fmt_key_text(r#class)),
            fmt_key_SurfaceTerm(remaining, head),
            fmt_key_List_SurfaceConstraint(remaining, wheres),
            fmt_key_List_SurfaceFn(remaining, methods),
            fmt_key_List_SurfaceLaw(remaining, laws),
            fmt_key_List_SurfaceTerm(remaining, generic_types),
            fmt_key_List_SurfaceTerm(remaining, arguments)
