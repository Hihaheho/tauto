import "../../surface/src/surface.taut"
import "../../text/src/text.taut"
import std::Text
import std::Base

// A structural key of the surface AST. Positions and occurrence identities
// are omitted; the surface reader already unwraps expression-only blocks.
pub fn fmt_key_text(value: Text): Text {
  Text::concat_all([Text::of_nat(Text::len(value)), ":", value])
}

pub fn fmt_key_bool(value: Bool): Text {
  ⊢ Text from match value {
    true => "true"
    false => "false"
  }
}

pub fn fmt_key_parts(parts: List(Option(Text))): Option(Text) {
  ⊢ Option(Text) from match parts {
    Nil => Some("")
    Cons(part, rest) => ⊢ Option(Text) from match part {
      None => None
      Some(text) => ⊢ Option(Text) from match fmt_key_parts(rest) {
        None => None
        Some(tail) => Some(Text::concat(text, tail))
      }
    }
  }
}

mutual {
  pub fn fmt_key_SurfaceTerm(fuel: Nat, node: SurfaceTerm): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        SurfaceTermIndexedMk(kind, start, end, occurrence) => fmt_key_parts(
          [Some("SurfaceTermIndexedMk"), fmt_key_SurfaceKind(remaining, kind)]
        )
      }
    }
  }
  pub fn fmt_key_SurfaceKind(fuel: Nat, node: SurfaceKind): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        SkVar(name) => fmt_key_parts([Some("SkVar"), Some(fmt_key_text(name))])
        SkNat(digits) => fmt_key_parts([Some("SkNat"), Some(fmt_key_text(digits))])
        SkFloat(digits) => fmt_key_parts([Some("SkFloat"), Some(fmt_key_text(digits))])
        SkRow(effects) => fmt_key_parts([Some("SkRow"), fmt_key_List_Text(remaining, effects)])
        SkText(value) => fmt_key_parts([Some("SkText"), Some(fmt_key_text(value))])
        SkBool(value) => fmt_key_parts([Some("SkBool"), Some(fmt_key_bool(value))])
        SkApp(head, args) => fmt_key_parts(
          [
            Some("SkApp"),
            fmt_key_SurfaceTerm(remaining, head),
            fmt_key_List_SurfaceTerm(remaining, args)
          ]
        )
        SkPi(params, result, effects) => fmt_key_parts(
          [
            Some("SkPi"),
            fmt_key_List_SurfaceParam(remaining, params),
            fmt_key_SurfaceTerm(remaining, result),
            fmt_key_Option_List_Text(remaining, effects)
          ]
        )
        SkExists(binder, domain, body) => fmt_key_parts(
          [
            Some("SkExists"),
            Some(fmt_key_text(binder)),
            fmt_key_SurfaceTerm(remaining, domain),
            fmt_key_SurfaceTerm(remaining, body)
          ]
        )
        SkLam(params, body) => fmt_key_parts(
          [
            Some("SkLam"),
            fmt_key_List_Text(remaining, params),
            fmt_key_SurfaceTerm(remaining, body)
          ]
        )
        SkUnion(parts) => fmt_key_parts(
          [Some("SkUnion"), fmt_key_List_SurfaceTerm(remaining, parts)]
        )
        SkProduct(members) => fmt_key_parts(
          [Some("SkProduct"), fmt_key_List_SurfaceTerm(remaining, members)]
        )
        SkTagged(tag, value) => fmt_key_parts(
          [Some("SkTagged"), Some(fmt_key_text(tag)), fmt_key_SurfaceTerm(remaining, value)]
        )
        SkIf(cond, then, otherwise) => fmt_key_parts(
          [
            Some("SkIf"),
            fmt_key_SurfaceTerm(remaining, cond),
            fmt_key_SurfaceTerm(remaining, then),
            fmt_key_Option_SurfaceTerm(remaining, otherwise)
          ]
        )
        SkField(value, name) => fmt_key_parts(
          [Some("SkField"), fmt_key_SurfaceTerm(remaining, value), Some(fmt_key_text(name))]
        )
        SkProject(value, ty) => fmt_key_parts(
          [
            Some("SkProject"),
            fmt_key_SurfaceTerm(remaining, value),
            fmt_key_SurfaceTerm(remaining, ty)
          ]
        )
        SkBlock(stmts) => fmt_key_parts(
          [Some("SkBlock"), fmt_key_List_SurfaceStmt(remaining, stmts)]
        )
        SkPerform(op, args) => fmt_key_parts(
          [Some("SkPerform"), Some(fmt_key_text(op)), fmt_key_List_SurfaceTerm(remaining, args)]
        )
        SkHandle(body, handlers) => fmt_key_parts(
          [
            Some("SkHandle"),
            fmt_key_SurfaceTerm(remaining, body),
            fmt_key_List_SurfaceHandler(remaining, handlers)
          ]
        )
        SkBudget(memory, amount, body) => fmt_key_parts(
          [
            Some("SkBudget"),
            Some(fmt_key_bool(memory)),
            fmt_key_SurfaceTerm(remaining, amount),
            fmt_key_SurfaceTerm(remaining, body)
          ]
        )
        SkMatch(scrutinee, motive, arms, binder) => fmt_key_parts(
          [
            Some("SkMatch"),
            fmt_key_SurfaceTerm(remaining, scrutinee),
            fmt_key_Option_SurfaceTerm(remaining, motive),
            fmt_key_List_SurfaceArm(remaining, arms),
            fmt_key_Option_Text(remaining, binder)
          ]
        )
        SkHole(name) => fmt_key_parts([Some("SkHole"), Some(fmt_key_text(name))])
        SkRecord(name, fields) => fmt_key_parts(
          [Some("SkRecord"), Some(fmt_key_text(name)), fmt_key_List_SurfaceField(remaining, fields)]
        )
        SkBorrow(mutable, value) => fmt_key_parts(
          [Some("SkBorrow"), Some(fmt_key_bool(mutable)), fmt_key_SurfaceTerm(remaining, value)]
        )
        SkFnKind(kind, ty) => fmt_key_parts(
          [Some("SkFnKind"), Some(fmt_key_text(kind)), fmt_key_SurfaceTerm(remaining, ty)]
        )
        SkBorrowLam(borrows, lam) => fmt_key_parts(
          [
            Some("SkBorrowLam"),
            fmt_key_List_Option_Bool(remaining, borrows),
            fmt_key_SurfaceTerm(remaining, lam)
          ]
        )
        SkOther(what) => fmt_key_parts([Some("SkOther"), Some(fmt_key_text(what))])
        SkMacroCall(name, arg) => fmt_key_parts(
          [Some("SkMacroCall"), Some(fmt_key_text(name)), fmt_key_SurfaceTerm(remaining, arg)]
        )
        SkQuote(stmts_form, stmts) => fmt_key_parts(
          [
            Some("SkQuote"),
            Some(fmt_key_bool(stmts_form)),
            fmt_key_List_SurfaceStmt(remaining, stmts)
          ]
        )
        SkSplice(value) => fmt_key_parts([Some("SkSplice"), fmt_key_SurfaceTerm(remaining, value)])
        SkSyntaxLit(name, body) => fmt_key_parts(
          [Some("SkSyntaxLit"), fmt_key_Option_Text(remaining, name), Some(fmt_key_text(body))]
        )
        SkStep(tactic, arg, call_start, call_end, before, arms) => fmt_key_parts(
          [
            Some("SkStep"),
            Some(fmt_key_text(tactic)),
            fmt_key_SurfaceTerm(remaining, arg),
            fmt_key_Option_SurfaceTerm(remaining, before),
            fmt_key_List_SurfaceStepArm(remaining, arms)
          ]
        )
      }
    }
  }
