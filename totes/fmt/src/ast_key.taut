  pub fn fmt_key_SurfacePattern(fuel: Nat, node: SurfacePattern): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        PtWild => fmt_key_parts([Some("PtWild")])
        PtBind(name) => fmt_key_parts([Some("PtBind"), Some(fmt_key_text(name))])
        PtInt(negative, magnitude) => fmt_key_parts(
          [Some("PtInt"), Some(fmt_key_bool(negative)), Some(Text::of_nat(magnitude))]
        )
        PtBool(value) => fmt_key_parts([Some("PtBool"), Some(fmt_key_bool(value))])
        PtText(value) => fmt_key_parts([Some("PtText"), Some(fmt_key_text(value))])
        PtCtor(name, args) => fmt_key_parts(
          [Some("PtCtor"), Some(fmt_key_text(name)), fmt_key_List_SurfacePattern(remaining, args)]
        )
        PtRecord(name, fields) => fmt_key_parts(
          [
            Some("PtRecord"),
            Some(fmt_key_text(name)),
            fmt_key_List_SurfacePatternField(remaining, fields)
          ]
        )
        PtOther(what) => fmt_key_parts([Some("PtOther"), Some(fmt_key_text(what))])
      }
    }
  }
  pub fn fmt_key_SurfacePatternField(fuel: Nat, node: SurfacePatternField): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        SurfacePatternFieldMk(name, pattern) => fmt_key_parts(
          [
            Some("SurfacePatternFieldMk"),
            Some(fmt_key_text(name)),
            fmt_key_SurfacePattern(remaining, pattern)
          ]
        )
      }
    }
  }
  pub fn fmt_key_SurfaceArm(fuel: Nat, node: SurfaceArm): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        SurfaceArmMk(pattern, guard, goal, body) => fmt_key_parts(
          [
            Some("SurfaceArmMk"),
            fmt_key_SurfacePattern(remaining, pattern),
            fmt_key_Option_SurfaceTerm(remaining, guard),
            fmt_key_Option_SurfaceTerm(remaining, goal),
            fmt_key_SurfaceTerm(remaining, body)
          ]
        )
      }
    }
  }
  pub fn fmt_key_SurfaceHandler(fuel: Nat, node: SurfaceHandler): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        HdReturn(pattern, body) => fmt_key_parts(
          [
            Some("HdReturn"),
            fmt_key_SurfacePattern(remaining, pattern),
            fmt_key_SurfaceTerm(remaining, body)
          ]
        )
        HdOperation(op, Binds, types, patterns, r#resume, guard, body) => fmt_key_parts(
          [
            Some("HdOperation"),
            Some(fmt_key_text(op)),
            fmt_key_List_Text(remaining, Binds),
            fmt_key_List_SurfaceTerm(remaining, types),
            fmt_key_List_SurfacePattern(remaining, patterns),
            fmt_key_Option_Text(remaining, r#resume),
            fmt_key_Option_SurfaceTerm(remaining, guard),
            fmt_key_SurfaceTerm(remaining, body)
          ]
        )
      }
    }
  }
  pub fn fmt_key_SurfaceStmt(fuel: Nat, node: SurfaceStmt): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        StLet(name, ty, value, borrow, mutable) => fmt_key_parts(
          [
            Some("StLet"),
            Some(fmt_key_text(name)),
            fmt_key_Option_SurfaceTerm(remaining, ty),
            fmt_key_SurfaceTerm(remaining, value),
            Some(fmt_key_bool(borrow)),
            Some(fmt_key_bool(mutable))
          ]
        )
        StVar(name, ty, value, borrow) => fmt_key_parts(
          [
            Some("StVar"),
            Some(fmt_key_text(name)),
            fmt_key_Option_SurfaceTerm(remaining, ty),
            fmt_key_SurfaceTerm(remaining, value),
            Some(fmt_key_bool(borrow))
          ]
        )
        StModule(name, stmts, start, end) => fmt_key_parts(
          [Some("StModule"), Some(fmt_key_text(name)), fmt_key_List_SurfaceStmt(remaining, stmts)]
        )
        StAssign(name, place, value) => fmt_key_parts(
          [
            Some("StAssign"),
            Some(fmt_key_text(name)),
            fmt_key_Option_SurfaceTerm(remaining, place),
            fmt_key_SurfaceTerm(remaining, value)
          ]
        )
        StCalled(generates, call) => fmt_key_parts(
          [
            Some("StCalled"),
            fmt_key_List_Text(remaining, generates),
            fmt_key_SurfaceTerm(remaining, call)
          ]
        )
        StFn(f) => fmt_key_parts([Some("StFn"), fmt_key_SurfaceFn(remaining, f)])
        StTheorem(t) => fmt_key_parts([Some("StTheorem"), fmt_key_SurfaceTheorem(remaining, t)])
        StDef(t) => fmt_key_parts([Some("StDef"), fmt_key_SurfaceTheorem(remaining, t)])
        StMutual(stmts, start, end) => fmt_key_parts(
          [Some("StMutual"), fmt_key_List_SurfaceStmt(remaining, stmts)]
        )
        StImport(path, start, end) => fmt_key_parts([Some("StImport"), Some(fmt_key_text(path))])
        StInductive(i) => fmt_key_parts(
          [Some("StInductive"), fmt_key_SurfaceInductive(remaining, i)]
        )
        StEffect(e) => fmt_key_parts([Some("StEffect"), fmt_key_SurfaceEffect(remaining, e)])
        StStruct(d) => fmt_key_parts([Some("StStruct"), fmt_key_SurfaceData(remaining, d)])
        StEnum(d) => fmt_key_parts([Some("StEnum"), fmt_key_SurfaceData(remaining, d)])
        StExtern(abi, fns, start, end) => fmt_key_parts(
          [Some("StExtern"), Some(fmt_key_text(abi)), fmt_key_List_SurfaceFn(remaining, fns)]
        )
        StClass(c) => fmt_key_parts([Some("StClass"), fmt_key_SurfaceClass(remaining, c)])
        StInstance(i) => fmt_key_parts([Some("StInstance"), fmt_key_SurfaceInstance(remaining, i)])
        StWhile(cond, body) => fmt_key_parts(
          [
            Some("StWhile"),
            fmt_key_SurfaceTerm(remaining, cond),
            fmt_key_SurfaceTerm(remaining, body)
          ]
        )
        StReturn(value) => fmt_key_parts(
          [Some("StReturn"), fmt_key_Option_SurfaceTerm(remaining, value)]
        )
        StExpr(value) => fmt_key_parts([Some("StExpr"), fmt_key_SurfaceTerm(remaining, value)])
        StOther(what, start, end) => fmt_key_parts([Some("StOther"), Some(fmt_key_text(what))])
        StMacro(name, function, start, end) => fmt_key_parts(
          [Some("StMacro"), Some(fmt_key_text(name)), Some(fmt_key_text(function))]
        )
        StSyntax(name, grammar, start, end) => fmt_key_parts(
          [Some("StSyntax"), Some(fmt_key_text(name)), Some(fmt_key_text(grammar))]
        )
        StAttributed(name, arg, generates, stmt) => fmt_key_parts(
          [
            Some("StAttributed"),
            Some(fmt_key_text(name)),
            fmt_key_SurfaceTerm(remaining, arg),
            fmt_key_List_Text(remaining, generates),
            fmt_key_SurfaceStmt(remaining, stmt)
          ]
        )
      }
    }
  }
  pub fn fmt_key_SurfaceFn(fuel: Nat, node: SurfaceFn): Option(Text) {
    ⊢ Option(Text) from match fuel {
      Zero => None
      Succ(remaining) => ⊢ Option(Text) from match node {
        SurfaceFnMk(name, generics, bounds, params, borrows, param_types, result, effects, wheres, start, end, body, generic_types) => fmt_key_parts(
          [
            Some("SurfaceFnMk"),
            Some(fmt_key_text(name)),
            fmt_key_List_Text(remaining, generics),
            fmt_key_List_Option_Text(remaining, bounds),
            fmt_key_List_Text(remaining, params),
            fmt_key_List_Option_Bool(remaining, borrows),
            fmt_key_List_Option_SurfaceTerm(remaining, param_types),
            fmt_key_Option_SurfaceTerm(remaining, result),
            fmt_key_Option_List_Text(remaining, effects),
            fmt_key_List_SurfaceConstraint(remaining, wheres),
            fmt_key_SurfaceTerm(remaining, body),
            fmt_key_List_SurfaceTerm(remaining, generic_types)
          ]
        )
      }
    }
  }
