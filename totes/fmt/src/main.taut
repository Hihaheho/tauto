import "../../syntax/src/syntax.taut"
// Formats each file given on the command line and prints `== <path>` and the
// result, or `error` (the differential test's input, `docs/design/self-host.md`).
import "fmt.taut"
import "../../text/src/text.taut"
import "../../unicode/src/classes.taut"
import "../../unicode/src/unicode.taut"
import std::Text
import std::prelude::Os

pub fn fmt_main_each(&tables: SyntaxTables, classes: UnicodeClasses, paths: List(Text)): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match fmt_format(tables, classes, source) {
          FmtOk(formatted) => print(formatted)
          FmtErr(e) => print(Text::concat_all(Cons("error", Cons(text_newline(), Nil))))
        }
      }
      fmt_main_each(tables, classes, rest)
    }
  }
}

match syntax_tables() {
  None => eprint("the tables of the syntax are damaged")
  Some(tables) => fmt_main_each(tables, unicode_classes(), perform argv())
}
