// Formats each file given on the command line and prints `== <path>` and the
// result, or `error` (the differential test's input, `docs/design/self-host.md`).
import std::Text

pub fn fmt_main_each(classes: UnicodeClasses, paths: List(Text)): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match fmt_format(classes, source) {
          FmtOk(formatted) => print(formatted)
          FmtErr(e) => print(Text::concat_all(Cons("error", Cons(text_newline(), Nil))))
        }
      }
      fmt_main_each(classes, rest)
    }
  }
}

fmt_main_each(unicode_classes(), perform argv())
