  match x {
    None => acc
    Some(y) => bsv_SurfaceTerm(y, acc)
  }
}

pub fn bsv_SurfaceArm(x: SurfaceArm, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceArmMk(f0, f1, f2, f3) => bsv_SurfaceTerm(f3, bsv_Option_SurfaceTerm(f2, bsv_Option_SurfaceTerm(f1, bsv_SurfacePattern(f0, acc))))
  }
}

pub fn bsv_SurfaceClass(x: SurfaceClass, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceClassMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, slot_unused_parameters, c_vis) => bsv_List_SurfaceConstraint(f10, bsv_List_SurfaceNamed(f8, bsv_List_SurfaceLaw(f5, bsv_List_SurfaceFn(f4, acc))))
  }
}

pub fn bsv_SurfaceConstraint(x: SurfaceConstraint, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceConstraintMk(f0, f1, f2, f3, f4) => bsv_List_SurfaceTerm(f4, bsv_SurfaceTerm(f1, acc))
  }
}

pub fn bsv_SurfaceCtor(x: SurfaceCtor, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceCtorMk(f0, f1, f2, f3) => bsv_SurfaceTerm(f3, bsv_List_SurfaceNamed(f2, acc))
  }
}

pub fn bsv_SurfaceData(x: SurfaceData, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceDataMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, slot_unused_generics, slot_rows) => bsv_List_SurfaceDataCtor(f3, acc)
  }
}

pub fn bsv_SurfaceDataCtor(x: SurfaceDataCtor, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceDataCtorMk(f0, f1) => bsv_List_SurfaceDataField(f1, acc)
  }
}

pub fn bsv_SurfaceDataField(x: SurfaceDataField, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceDataFieldMk(f0, f1) => bsv_SurfaceTerm(f1, acc)
  }
}

pub fn bsv_SurfaceEffect(x: SurfaceEffect, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceEffectMk(f0, f1, f2, f3, f4, f5, f6, f7, slot_unused_generics, slot_bounds, e_vis, slot_rows) => bsv_Option_SurfaceTerm(f3, bsv_List_Option_SurfaceTerm(f2, acc))
  }
}

pub fn bsv_SurfaceField(x: SurfaceField, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceFieldMk(f0, f1) => bsv_SurfaceTerm(f1, acc)
  }
}

pub fn bsv_SurfaceFn(x: SurfaceFn, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceFnMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f13, f12, f14, f15, f16, slot_unused, slot_unused_generics, slot_unused_params) => bsv_List_SurfaceTerm(f12, bsv_SurfaceTerm(f11, bsv_List_SurfaceConstraint(f8, bsv_Option_SurfaceTerm(f6, bsv_List_Option_SurfaceTerm(f5, acc)))))
  }
}

pub fn bsv_SurfaceHandler(x: SurfaceHandler, acc: List(Text)): List(Text) ! {div} {
  match x {
    HdReturn(f0, f1) => bsv_SurfaceTerm(f1, bsv_SurfacePattern(f0, acc))
    HdOperation(f0, f1, f2, f3, f4, _, f5, f6) => bsv_SurfaceTerm(f6, bsv_Option_SurfaceTerm(f5, bsv_List_SurfacePattern(f3, bsv_List_SurfaceTerm(f2, acc))))
  }
}

pub fn bsv_SurfaceInductive(x: SurfaceInductive, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceInductiveMk(f0, f1, f2, f3, f4, f5, f6) => bsv_List_SurfaceCtor(f3, bsv_SurfaceTerm(f2, bsv_List_SurfaceNamed(f1, acc)))
  }
}

pub fn bsv_SurfaceInferCondition(x: SurfaceInferCondition, acc: List(Text)): List(Text) ! {div} {
  match x {
    InferParameter(name) => acc
    InferAnd(left, right) => bsv_SurfaceInferCondition(right, bsv_SurfaceInferCondition(left, acc))
    InferOr(left, right) => bsv_SurfaceInferCondition(right, bsv_SurfaceInferCondition(left, acc))
  }
}

pub fn bsv_Option_SurfaceInferCondition(x: Option(SurfaceInferCondition), acc: List(Text)): List(Text) ! {div} {
  match x {
    None => acc
    Some(value) => bsv_SurfaceInferCondition(value, acc)
  }
}

pub fn bsv_SurfaceInstance(x: SurfaceInstance, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceInstanceMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, slot_unused_generics) => bsv_Option_SurfaceInferCondition(f11, bsv_List_SurfaceTerm(f10, bsv_List_SurfaceTerm(f9, bsv_List_SurfaceLaw(f6, bsv_List_SurfaceFn(f5, bsv_List_SurfaceConstraint(f4, bsv_SurfaceTerm(f3, acc)))))))
  }
}

pub fn bsv_SurfaceKind(x: SurfaceKind, acc: List(Text)): List(Text) ! {div} {
  match x {
    SkVar(f0) => Cons(surface_name_text(f0), acc)
    SkNat(f0) => acc
    SkFloat(f0) => acc
    SkRow(f0) => acc
    SkText(f0) => acc
    SkBool(f0) => acc
    SkApp(f0, f1) => bsv_List_SurfaceTerm(f1, bsv_SurfaceTerm(f0, acc))
    SkPi(f0, f1, f2) => bsv_SurfaceTerm(f1, bsv_List_SurfaceParam(f0, acc))
    SkExists(f0, f1, f2, unused) => bsv_SurfaceTerm(f2, bsv_SurfaceTerm(f1, acc))
    SkLam(f0, f1, f2, _) => bsv_List_Option_SurfaceTerm(f2, bsv_SurfaceTerm(f1, acc))
    SkUnion(f0) => bsv_List_SurfaceTerm(f0, acc)
    SkAscribe(f0, f1) => bsv_SurfaceTerm(f1, bsv_SurfaceTerm(f0, acc))
    SkTagged(f0, f1) => bsv_SurfaceTerm(f1, acc)
    SkIf(f0, f1, f2) => bsv_Option_SurfaceTerm(f2, bsv_SurfaceTerm(f1, bsv_SurfaceTerm(f0, acc)))
    SkField(f0, f1) => bsv_SurfaceTerm(f0, acc)
    SkBlock(f0) => bsv_List_SurfaceStmt(f0, acc)
    SkPerform(f0, f1) => bsv_List_SurfaceTerm(f1, acc)
    SkHandle(f0, f1) => bsv_List_SurfaceHandler(f1, bsv_SurfaceTerm(f0, acc))
    SkBudget(f0, f1, f2) => bsv_SurfaceTerm(f2, bsv_SurfaceTerm(f1, acc))
    SkMatch(f0, f1, f2, f3, _) => bsv_List_SurfaceArm(f2, bsv_Option_SurfaceTerm(f1, bsv_SurfaceTerm(f0, acc)))
    SkHole(f0) => acc
    SkRecord(f0, f1) => bsv_List_SurfaceField(f1, acc)
    SkBorrow(f0, f0_orig, f1) => bsv_SurfaceTerm(f1, acc)
    SkFnKind(f0, f1) => bsv_SurfaceTerm(f1, acc)
    SkBorrowLam(f0, f1) => bsv_SurfaceTerm(f1, acc)
    SkOther(f0) => acc
    SkMacroCall(f0, f1) => bsv_SurfaceTerm(f1, acc)
    SkQuote(f0, f1) => bsv_List_SurfaceStmt(f1, acc)
    SkSplice(f0) => bsv_SurfaceTerm(f0, acc)
    SkSyntaxLit(f0, f1) => acc
    SkStep(f0, f1, f2, f3, f4, f5) => bsv_List_SurfaceStepArm(f5, bsv_Option_SurfaceTerm(f4, bsv_SurfaceTerm(f1, acc)))
  }
}

pub fn bsv_SurfaceLaw(x: SurfaceLaw, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceLawMk(f0, f1, f2, f3) => bsv_SurfaceTheorem(f3, acc)
  }
}

pub fn bsv_SurfaceNamed(x: SurfaceNamed, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceNamedMk(f0, f1) => bsv_SurfaceTerm(f1, acc)
  }
}

pub fn bsv_SurfaceParam(x: SurfaceParam, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceParamMk(f0, f1, _) => bsv_SurfaceTerm(f1, acc)
  }
}

pub fn bsv_SurfacePattern(x: SurfacePattern, acc: List(Text)): List(Text) ! {div} {
  match x {
    PtWild => acc
    PtBind(f0, _) => acc
    PtInt(f0, f1) => acc
    PtBool(f0) => acc
    PtText(f0) => acc
    PtCtor(f0, f1) => bsv_List_SurfacePattern(f1, acc)
    PtRecord(f0, f1) => bsv_List_SurfacePatternField(f1, acc)
    PtTyped(f0, f1, _) => bsv_SurfaceTerm(f1, acc)
    PtOther(f0) => acc
  }
}

pub fn bsv_SurfacePatternField(x: SurfacePatternField, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfacePatternFieldMk(f0, f1) => bsv_SurfacePattern(f1, acc)
  }
}

pub fn bsv_SurfaceStepArm(x: SurfaceStepArm, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceStepArmMk(f0, _, f1, f2, f3, f4) => bsv_SurfaceTerm(f2, bsv_SurfaceTerm(f1, bsv_List_SurfaceField(f0, acc)))
  }
}

pub fn bsv_SurfaceStmt(x: SurfaceStmt, acc: List(Text)): List(Text) ! {div} {
  match x {
    StLet(f0, f1, f2, f3, f4, unused, st_stack) => bsv_SurfaceTerm(f2, bsv_Option_SurfaceTerm(f1, acc))
    StVar(f0, f1, f2, f3, unused, st_stack) => bsv_SurfaceTerm(f2, bsv_Option_SurfaceTerm(f1, acc))
    StAssign(f0, f1, f2) => bsv_SurfaceTerm(f2, bsv_Option_SurfaceTerm(f1, acc))
    StCalled(f0, f1) => bsv_SurfaceTerm(f1, acc)
    StFn(f0) => bsv_SurfaceFn(f0, acc)
    StTheorem(f0) => bsv_SurfaceTheorem(f0, acc)
    StDef(f0) => bsv_SurfaceTheorem(f0, acc)
    StMutual(f0, f1, f2) => bsv_List_SurfaceStmt(f0, acc)
    StImport(f0, f1, f2) => acc
    StInductive(f0) => bsv_SurfaceInductive(f0, acc)
    StEffect(f0) => bsv_SurfaceEffect(f0, acc)
    StStruct(f0) => bsv_SurfaceData(f0, acc)
    StEnum(f0) => bsv_SurfaceData(f0, acc)
    StExtern(f0, f1, f2, f3, f4, f5, f6) => bsv_List_SurfaceData(
      f4,
      bsv_List_SurfaceData(
        f3,
        bsv_List_SurfaceData(
          f2,
          bsv_List_SurfaceConstraint(f1, bsv_List_SurfaceFn(f0, acc))
        )
      )
    )
    StClass(f0) => bsv_SurfaceClass(f0, acc)
    StInstance(f0) => bsv_SurfaceInstance(f0, acc)
    StWhile(f0, f1) => bsv_SurfaceTerm(f1, bsv_SurfaceTerm(f0, acc))
    StReturn(f0) => bsv_Option_SurfaceTerm(f0, acc)
    StExpr(f0) => bsv_SurfaceTerm(f0, acc)
    StOther(f0, f1, f2) => acc
    StLoop(st_body, f1, f2) => acc
    StModule(mod_name, mod_vis, mod_items, f1, f2) => acc
    StReexport(re_path, re_names, re_spans, f1, f2) => acc
    StFor(for_pat, for_src, st_body, f1, f2) => acc
    StBreak(st_value, f1, f2) => acc
    StContinue(f1, f2) => acc
    StMacro(f0, f1, f2, f3) => acc
    StSyntax(f0, f1, f2, f3) => acc
    StAttributed(f0, f1, f2, f3) => bsv_SurfaceStmt(f3, bsv_SurfaceTerm(f1, acc))
  }
}

pub fn bsv_SurfaceTerm(x: SurfaceTerm, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceTermIndexedMk(f0, f1, f2, f3) => bsv_SurfaceKind(f0, acc)
  }
}

pub fn bsv_SurfaceTheorem(x: SurfaceTheorem, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceTheoremMk(f0, f1, f2, f3, f4, f5, f6, slot_unused, slot_unused_params, t_vis) => bsv_Option_SurfaceTerm(f4, bsv_SurfaceTerm(f3, bsv_List_SurfaceNamed(f2, acc)))
  }
}

pub fn bss_w_List_Option_Nat(xs: List(Option(Nat)), acc: List(Text)): List(Text) ! {div} {
  bss_w_List_Option_Nat_items(xs, Cons(field(Text::of_u64(nat_to_u64(List::length(xs)))), acc))
}

fn bss_w_List_Option_Nat_items(xs: List(Option(Nat)), acc: List(Text)): List(Text) ! {div} {
  match xs {
    Nil => acc
    Cons(y, rest) => bss_w_List_Option_Nat_items(rest, bss_w_Option_Nat(y, acc))
  }
}

pub fn bss_w_Option_Nat(x: Option(Nat), acc: List(Text)): List(Text) ! {div} {
  match x {
    None => Cons(field("n"), acc)
    Some(y) => bss_w_Nat(y, Cons(field("s"), acc))
  }
}


pub fn bss_w_Option_SurfaceSpan(x: Option(SurfaceSpan), acc: List(Text)): List(Text) ! {div} {
  match x {
    None => Cons(field("n"), acc)
    Some(y) => match y {
      SurfaceSpan::Mk(a, b) => bss_w_Nat(b, bss_w_Nat(a, Cons(field("s"), acc)))
    }
  }
}

pub fn bss_w_RowEntry(x: RowEntry, acc: List(Text)): List(Text) ! {div} {
  match x {
    EntryName(f0, f1) => bss_w_Option_SurfaceSpan(f1, bss_w_Text(f0, Cons(field("EntryName"), acc)))
    EntryApplied(f0, f1, f2, f3, f4) => bss_w_Option_SurfaceSpan(
      f4,
      bss_w_List_Text(
        f3,
        bss_w_Bool(f2, bss_w_List_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("EntryApplied"), acc))))
      )
    )
  }
}

pub fn bss_w_List_RowEntry(xs: List(RowEntry), acc: List(Text)): List(Text) ! {div} {
  bss_w_List_RowEntry_items(xs, Cons(field(Text::of_u64(nat_to_u64(List::length(xs)))), acc))
}

fn bss_w_List_RowEntry_items(xs: List(RowEntry), acc: List(Text)): List(Text) ! {div} {
  match xs {
    Nil => acc
    Cons(y, rest) => bss_w_List_RowEntry_items(rest, bss_w_RowEntry(y, acc))
  }
}

pub fn bss_w_Option_List_RowEntry(x: Option(List(RowEntry)), acc: List(Text)): List(Text) ! {div} {
  match x {
    None => Cons(field("n"), acc)
    Some(y) => bss_w_List_RowEntry(y, Cons(field("s"), acc))
  }
}
