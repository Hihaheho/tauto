pub fn bss_w_SurfaceFn(x: SurfaceFn, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceFnMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f13, f12, f14, f15, f16, slot_unused, slot_unused_generics, slot_unused_params) => bss_w_Option_SurfaceSpan(f16, bss_w_SurfaceVis(f15, bss_w_List_Option_Nat(f14, bss_w_List_SurfaceTerm(f12, bss_w_Option_List_Text(f13, bss_w_SurfaceTerm(f11, bss_w_List_SurfaceConstraint(f8, bss_w_Option_List_RowEntry(f7, bss_w_Option_SurfaceTerm(f6, bss_w_List_Option_SurfaceTerm(f5, bss_w_List_Option_Bool(f4, bss_w_List_Text(f3, bss_w_List_Option_Text(f2, bss_w_List_Text(f1, bss_w_Text(f0, Cons(field("SurfaceFnMk"), acc))))))))))))))))
  }
}

pub fn bss_w_SurfaceHandler(x: SurfaceHandler, acc: List(Text)): List(Text) ! {div} {
  match x {
    HdReturn(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_SurfacePattern(f0, Cons(field("HdReturn"), acc)))
    HdOperation(f0, f1, f2, f3, f4, _, f5, f6) => bss_w_SurfaceTerm(f6, bss_w_Option_SurfaceTerm(f5, bss_w_Option_Text(f4, bss_w_List_SurfacePattern(f3, bss_w_List_SurfaceTerm(f2, bss_w_List_Text(f1, bss_w_Text(f0, Cons(field("HdOperation"), acc))))))))
  }
}

