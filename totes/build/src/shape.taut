import "../../identity/src/identity.taut"
import std::base
import std::data
import std::text
import std::list
import query_flow::codec
import surface::surface

// What a part of the surface syntax says, without where it is: the writers of
// `statements.taut` leaving out the positions (`start`, `end`, `call_start`,
// `call_end`) and the occurrences. Two parts that differ only in where they
// are written give the same text, so moving a declaration in its file does
// not change its signature (`queries.taut`).

pub fn build_shape_of_stmt(s: SurfaceStmt): Text ! {div} {
  Text::concat_all(List::reverse(bss_w_SurfaceStmt(s, Nil)))
}

pub fn bss_w_Text(x: Text, acc: List(Text)): List(Text) ! {div} { Cons(field(x), acc) }

pub fn bss_w_Nat(x: Nat, acc: List(Text)): List(Text) ! {div} {
  Cons(field(Text::of_u64(nat_to_u64(x))), acc)
}

pub fn bss_w_Bool(x: Bool, acc: List(Text)): List(Text) ! {div} {
  Cons(field(if x { "t" } else { "f" }), acc)
}

pub fn bss_w_SurfaceVis(x: SurfaceVis, acc: List(Text)): List(Text) ! {div} {
  match x {
    VisPrivate => Cons(field("private"), acc)
    VisPub => Cons(field("pub"), acc)
    VisOpen => Cons(field("open"), acc)
    VisHandle => Cons(field("handle"), acc)
  }
}

pub fn bss_w_List_Nat(xs: List(Nat), acc: List(Text)): List(Text) ! {div} {
  bss_w_List_Nat_items(xs, Cons(field(Text::of_u64(nat_to_u64(List::length(xs)))), acc))
}

fn bss_w_List_Nat_items(xs: List(Nat), acc: List(Text)): List(Text) ! {div} {
  match xs {
    Nil => acc
    Cons(y, rest) => bss_w_List_Nat_items(rest, bss_w_Nat(y, acc))
  }
}

