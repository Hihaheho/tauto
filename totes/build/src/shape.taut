pub fn bss_w_SurfaceInferCondition(x: SurfaceInferCondition, acc: List(Text)): List(Text) ! {div} {
  match x {
    InferParameter(name) => bss_w_Text(name, Cons(field("InferParameter"), acc))
    InferAnd(left, right) => bss_w_SurfaceInferCondition(right, bss_w_SurfaceInferCondition(left, Cons(field("InferAnd"), acc)))
    InferOr(left, right) => bss_w_SurfaceInferCondition(right, bss_w_SurfaceInferCondition(left, Cons(field("InferOr"), acc)))
  }
}

pub fn bss_w_Option_SurfaceInferCondition(x: Option(SurfaceInferCondition), acc: List(Text)): List(Text) ! {div} {
