pub fn bss_w_SurfaceArm(x: SurfaceArm, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceArmMk(f0, f1, f2, f3) => bss_w_SurfaceTerm(f3, bss_w_Option_SurfaceTerm(f2, bss_w_Option_SurfaceTerm(f1, bss_w_SurfacePattern(f0, Cons(field("SurfaceArmMk"), acc)))))
  }
}

pub fn bss_w_SurfaceClass(x: SurfaceClass, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceClassMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, slot_unused_parameters, c_vis) => bss_w_List_SurfaceConstraint(f10, bss_w_Bool(f9, bss_w_List_SurfaceNamed(f8, bss_w_List_SurfaceLaw(f5, bss_w_List_SurfaceFn(f4, bss_w_Option_Text(f3, bss_w_Nat(f2, bss_w_Text(f1, bss_w_Text(f0, Cons(field("SurfaceClassMk"), acc))))))))))
  }
}

pub fn bss_w_SurfaceConstraint(x: SurfaceConstraint, acc: List(Text)): List(Text) ! {div} {
