  match x {
    SurfaceInstanceMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, slot_unused_generics) => bss_w_Option_SurfaceInferCondition(f11, bss_w_List_SurfaceTerm(f10, bss_w_List_SurfaceTerm(f9, bss_w_List_SurfaceLaw(f6, bss_w_List_SurfaceFn(f5, bss_w_List_SurfaceConstraint(f4, bss_w_SurfaceTerm(f3, bss_w_Text(f2, bss_w_List_Option_Text(f1, bss_w_List_Text(f0, Cons(field("SurfaceInstanceMk"), acc)))))))))))
  }
}

pub fn bss_w_SurfaceKind(x: SurfaceKind, acc: List(Text)): List(Text) ! {div} {
  match x {
    SkVar(f0) => bss_w_Text(surface_name_text(f0), Cons(field("SkVar"), acc))
    SkNat(f0) => bss_w_Text(f0, Cons(field("SkNat"), acc))
    SkFloat(f0) => bss_w_Text(f0, Cons(field("SkFloat"), acc))
    SkRow(f0) => bss_w_List_RowEntry(f0, Cons(field("SkRow"), acc))
    SkText(f0) => bss_w_Text(f0, Cons(field("SkText"), acc))
    SkBool(f0) => bss_w_Bool(f0, Cons(field("SkBool"), acc))
    SkApp(f0, f1) => bss_w_List_SurfaceTerm(f1, bss_w_SurfaceTerm(f0, Cons(field("SkApp"), acc)))
    SkPi(f0, f1, f2) => bss_w_Option_List_RowEntry(f2, bss_w_SurfaceTerm(f1, bss_w_List_SurfaceParam(f0, Cons(field("SkPi"), acc))))
    SkExists(f0, f1, f2, unused) => bss_w_SurfaceTerm(f2, bss_w_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("SkExists"), acc))))
    SkLam(f0, f1, f2, _) => bss_w_List_Option_SurfaceTerm(f2, bss_w_SurfaceTerm(f1, bss_w_List_Text(f0, Cons(field("SkLam"), acc))))
    SkUnion(f0) => bss_w_List_SurfaceTerm(f0, Cons(field("SkUnion"), acc))
    SkAscribe(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_SurfaceTerm(f0, Cons(field("SkAscribe"), acc)))
    SkTagged(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("SkTagged"), acc)))
    SkIf(f0, f1, f2) => bss_w_Option_SurfaceTerm(f2, bss_w_SurfaceTerm(f1, bss_w_SurfaceTerm(f0, Cons(field("SkIf"), acc))))
    SkField(f0, f1) => bss_w_Text(f1, bss_w_SurfaceTerm(f0, Cons(field("SkField"), acc)))
    SkBlock(f0) => bss_w_List_SurfaceStmt(f0, Cons(field("SkBlock"), acc))
    SkPerform(f0, f1) => bss_w_List_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("SkPerform"), acc)))
    SkHandle(f0, f1) => bss_w_List_SurfaceHandler(f1, bss_w_SurfaceTerm(f0, Cons(field("SkHandle"), acc)))
    SkBudget(f0, f1, f2) => bss_w_SurfaceTerm(f2, bss_w_SurfaceTerm(f1, bss_w_Bool(f0, Cons(field("SkBudget"), acc))))
    SkMatch(f0, f1, f2, f3, _) => bss_w_Option_Text(f3, bss_w_List_SurfaceArm(f2, bss_w_Option_SurfaceTerm(f1, bss_w_SurfaceTerm(f0, Cons(field("SkMatch"), acc)))))
    SkHole(f0) => bss_w_Text(f0, Cons(field("SkHole"), acc))
    SkRecord(f0, f1) => bss_w_List_SurfaceField(f1, bss_w_Text(f0, Cons(field("SkRecord"), acc)))
    SkBorrow(f0, f1, f2) => bss_w_SurfaceTerm(f2, bss_w_Bool(f1, bss_w_Bool(f0, Cons(field("SkBorrow"), acc))))
    SkFnKind(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("SkFnKind"), acc)))
    SkBorrowLam(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_List_Option_Bool(f0, Cons(field("SkBorrowLam"), acc)))
    SkOther(f0) => bss_w_Text(f0, Cons(field("SkOther"), acc))
    SkMacroCall(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("SkMacroCall"), acc)))
    SkQuote(f0, f1) => bss_w_List_SurfaceStmt(f1, bss_w_Bool(f0, Cons(field("SkQuote"), acc)))
    SkSplice(f0) => bss_w_SurfaceTerm(f0, Cons(field("SkSplice"), acc))
    SkSyntaxLit(f0, f1) => bss_w_Text(f1, bss_w_Option_Text(f0, Cons(field("SkSyntaxLit"), acc)))
    SkStep(f0, f1, f2, f3, f4, f5) => bss_w_List_SurfaceStepArm(f5, bss_w_Option_SurfaceTerm(f4, bss_w_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("SkStep"), acc)))))
  }
}

pub fn bss_w_SurfaceLaw(x: SurfaceLaw, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceLawMk(f0, f1, f2, f3) => bss_w_SurfaceTheorem(f3, bss_w_Text(f0, Cons(field("SurfaceLawMk"), acc)))
  }
}

pub fn bss_w_SurfaceNamed(x: SurfaceNamed, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceNamedMk(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("SurfaceNamedMk"), acc)))
  }
}

pub fn bss_w_SurfaceParam(x: SurfaceParam, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceParamMk(f0, f1, _) => bss_w_SurfaceTerm(f1, bss_w_Option_Text(f0, Cons(field("SurfaceParamMk"), acc)))
  }
}

pub fn bss_w_SurfacePattern(x: SurfacePattern, acc: List(Text)): List(Text) ! {div} {
  match x {
    PtWild => Cons(field("PtWild"), acc)
    PtBind(f0, _) => bss_w_Text(f0, Cons(field("PtBind"), acc))
    PtInt(f0, f1) => bss_w_Nat(f1, bss_w_Bool(f0, Cons(field("PtInt"), acc)))
    PtBool(f0) => bss_w_Bool(f0, Cons(field("PtBool"), acc))
    PtText(f0) => bss_w_Text(f0, Cons(field("PtText"), acc))
    PtCtor(f0, f1) => bss_w_List_SurfacePattern(f1, bss_w_Text(surface_name_text(f0), Cons(field("PtCtor"), acc)))
    PtRecord(f0, f1) => bss_w_List_SurfacePatternField(f1, bss_w_Text(f0, Cons(field("PtRecord"), acc)))
    PtTyped(f0, f1, _) => bss_w_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("PtTyped"), acc)))
    PtOther(f0) => bss_w_Text(f0, Cons(field("PtOther"), acc))
  }
}

pub fn bss_w_SurfacePatternField(x: SurfacePatternField, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfacePatternFieldMk(f0, f1) => bss_w_SurfacePattern(f1, bss_w_Text(f0, Cons(field("SurfacePatternFieldMk"), acc)))
  }
}

pub fn bss_w_SurfaceStepArm(x: SurfaceStepArm, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceStepArmMk(f0, _, f1, f2, f3, f4) => bss_w_SurfaceTerm(f2, bss_w_SurfaceTerm(f1, bss_w_List_SurfaceField(f0, Cons(field("SurfaceStepArmMk"), acc))))
  }
}

pub fn bss_w_SurfaceStmt(x: SurfaceStmt, acc: List(Text)): List(Text) ! {div} {
  match x {
    StLet(f0, f1, f2, f3, f4, unused, st_stack) => bss_w_Option_Text(st_stack, bss_w_Bool(f4, bss_w_Bool(f3, bss_w_SurfaceTerm(f2, bss_w_Option_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("StLet"), acc)))))))
    StVar(f0, f1, f2, f3, unused, st_stack) => bss_w_Option_Text(st_stack, bss_w_Bool(f3, bss_w_SurfaceTerm(f2, bss_w_Option_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("StVar"), acc))))))
    StAssign(f0, f1, f2) => bss_w_SurfaceTerm(f2, bss_w_Option_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("StAssign"), acc))))
    StCalled(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_List_Text(f0, Cons(field("StCalled"), acc)))
    StFn(f0) => bss_w_SurfaceFn(f0, Cons(field("StFn"), acc))
    StTheorem(f0) => bss_w_SurfaceTheorem(f0, Cons(field("StTheorem"), acc))
    StDef(f0) => bss_w_SurfaceTheorem(f0, Cons(field("StDef"), acc))
    StMutual(f0, f1, f2) => bss_w_List_SurfaceStmt(f0, Cons(field("StMutual"), acc))
    StImport(f0, f1, f2) => bss_w_Text(f0, Cons(field("StImport"), acc))
    StInductive(f0) => bss_w_SurfaceInductive(f0, Cons(field("StInductive"), acc))
    StEffect(f0) => bss_w_SurfaceEffect(f0, Cons(field("StEffect"), acc))
    StStruct(f0) => bss_w_SurfaceData(f0, Cons(field("StStruct"), acc))
    StEnum(f0) => bss_w_SurfaceData(f0, Cons(field("StEnum"), acc))
    StExtern(f0, f1, f2, f3, f4, f5, f6) => bss_w_List_SurfaceData(
      f4,
      bss_w_List_SurfaceData(
        f3,
        bss_w_List_SurfaceData(
          f2,
          bss_w_List_SurfaceConstraint(
            f1,
            bss_w_List_SurfaceFn(f0, Cons(field("StExtern"), acc))
          )
        )
      )
    )
    StClass(f0) => bss_w_SurfaceClass(f0, Cons(field("StClass"), acc))
    StInstance(f0) => bss_w_SurfaceInstance(f0, Cons(field("StInstance"), acc))
    StWhile(f0, f1) => bss_w_SurfaceTerm(f1, bss_w_SurfaceTerm(f0, Cons(field("StWhile"), acc)))
    StReturn(f0) => bss_w_Option_SurfaceTerm(f0, Cons(field("StReturn"), acc))
    StExpr(f0) => bss_w_SurfaceTerm(f0, Cons(field("StExpr"), acc))
    StOther(f0, f1, f2) => bss_w_Text(f0, Cons(field("StOther"), acc))
    StLoop(st_body, f1, f2) => bss_w_Text("LoopExpr", Cons(field("StOther"), acc))
    StModule(mod_name, mod_vis, mod_items, f1, f2) => bss_w_Text("ModuleDecl", Cons(field("StOther"), acc))
    StReexport(re_path, re_names, re_spans, f1, f2) => bss_w_Text("ReexportDecl", Cons(field("StOther"), acc))
    StFor(for_pat, for_src, st_body, f1, f2) => bss_w_Text("ForStmt", Cons(field("StOther"), acc))
    StBreak(st_value, f1, f2) => bss_w_Text("BreakStmt", Cons(field("StOther"), acc))
    StContinue(f1, f2) => bss_w_Text("ContinueStmt", Cons(field("StOther"), acc))
    StMacro(f0, f1, f2, f3) => bss_w_Text(f1, bss_w_Text(f0, Cons(field("StMacro"), acc)))
    StSyntax(f0, f1, f2, f3) => bss_w_Text(f1, bss_w_Text(f0, Cons(field("StSyntax"), acc)))
    StAttributed(f0, f1, f2, f3) => bss_w_SurfaceStmt(f3, bss_w_List_Text(f2, bss_w_SurfaceTerm(f1, bss_w_Text(f0, Cons(field("StAttributed"), acc)))))
  }
}

pub fn bss_w_SurfaceTerm(x: SurfaceTerm, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceTermIndexedMk(f0, f1, f2, f3) => bss_w_SurfaceKind(f0, Cons(field("SurfaceTermIndexedMk"), acc))
  }
}

pub fn bss_w_SurfaceTheorem(x: SurfaceTheorem, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceTheoremMk(f0, f1, f2, f3, f4, f5, f6, slot_unused, slot_unused_params, t_vis) => bss_w_Option_SurfaceTerm(f4, bss_w_SurfaceTerm(f3, bss_w_List_SurfaceNamed(f2, bss_w_Nat(f1, bss_w_Text(f0, Cons(field("SurfaceTheoremMk"), acc))))))
  }
}

pub fn bss_w_TermOccurrence(x: TermOccurrence, acc: List(Text)): List(Text) ! {div} {
  match x {
    TermOccurrenceMk(f0) => bss_w_List_Nat(f0, Cons(field("TermOccurrenceMk"), acc))
  }
}


// ---- the names a part uses ------------------------------------------------------------------
//
// Every name written as a variable (`SkVar`) in a part, each time it is
// written: what a declaration may refer to.

pub fn build_names_of_stmt(s: SurfaceStmt): List(Text) ! {div} { bsv_SurfaceStmt(s, Nil) }

