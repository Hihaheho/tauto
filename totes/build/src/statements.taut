import "../../identity/src/identity.taut"
import std::base
import std::data
import std::text
import query_flow::codec
import surface::surface

// The statements of `totes/surface` as text and back, for keeping a query's
// output (`Codec`, totes/query-flow). Every part is a field of query-flow's
// codec (`5:hello`): a constructor is its name followed by its fields in order,
// a list its length followed by its items, an option `n`, or `s` followed by the
// value, a `Nat` its digits and a `Bool` `t` or `f`. One writer and one reader
// for each type of the surface syntax, in the order the types are declared.

// The statements of one file: the output of `BuildParse`.
pub(open) struct BuildStatements { stmts: List(SurfaceStmt) }

pub fn BuildStatements::codec(): Codec(BuildStatements) {
  Codec::new(
    (x: BuildStatements) => Text::concat_all(List::reverse(bsc_w_List_SurfaceStmt(x.stmts, Nil))),
    (t: Text) => match bsc_r_List_SurfaceStmt(reader(t)) {
      None => None
      Some(p) => match p {
        #(x, r) => if at_end(r) { Some(BuildStatements { stmts: x }) } else { None }
      }
    }
  )
}

pub fn bsc_w_Text(x: Text, acc: List(Text)): List(Text) ! {div} { Cons(field(x), acc) }

pub fn bsc_r_Text(r: Reader): Option(Text × Reader) ! {div} { next_field(r) }

pub fn bsc_w_Nat(x: Nat, acc: List(Text)): List(Text) ! {div} {
  Cons(field(Text::of_u64(nat_to_u64(x))), acc)
}

pub fn bsc_r_Nat(r: Reader): Option(Nat × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(t, r0) => match parse_u64(t) {
        None => None
        Some(n) => Some(#(u64_to_nat(n), r0))
      }
    }
  }
}

pub fn bsc_w_Bool(x: Bool, acc: List(Text)): List(Text) ! {div} {
  Cons(field(if x { "t" } else { "f" }), acc)
}

pub fn bsc_r_Bool(r: Reader): Option(Bool × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(t, r0) => if t == "t" { Some(#(true, r0)) } else if t == "f" { Some(#(false, r0)) } else { None }
    }
  }
}

pub fn bsc_w_SurfaceVis(x: SurfaceVis, acc: List(Text)): List(Text) ! {div} {
  Cons(
    field(
      match x {
        VisPrivate => "private"
        VisPub => "pub"
        VisOpen => "open"
        VisHandle => "handle"
      }
    ),
    acc
  )
}

pub fn bsc_r_SurfaceVis(r: Reader): Option(SurfaceVis × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(t, r0) => if t == "private" {
        Some(#(VisPrivate, r0))
      } else if t == "pub" {
        Some(#(VisPub, r0))
      } else if t == "open" {
        Some(#(VisOpen, r0))
      } else if t == "handle" {
        Some(#(VisHandle, r0))
      } else { None }
    }
  }
}

pub fn bsc_w_SurfaceArm(x: SurfaceArm, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceArmMk(f0, f1, f2, f3) => bsc_w_SurfaceTerm(
      f3,
      bsc_w_Option_SurfaceTerm(
        f2,
        bsc_w_Option_SurfaceTerm(f1, bsc_w_SurfacePattern(f0, Cons(field("SurfaceArmMk"), acc)))
      )
    )
  }
}

pub fn bsc_r_SurfaceArm(r: Reader): Option(SurfaceArm × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "SurfaceArmMk" {
        match bsc_r_SurfacePattern(r0) {
          None => None
          Some(p1) => match p1 {
            #(f0, r1) => match bsc_r_Option_SurfaceTerm(r1) {
              None => None
              Some(p2) => match p2 {
                #(f1, r2) => match bsc_r_Option_SurfaceTerm(r2) {
                  None => None
                  Some(p3) => match p3 {
                    #(f2, r3) => match bsc_r_SurfaceTerm(r3) {
                      None => None
                      Some(p4) => match p4 {
                        #(f3, r4) => Some(#(SurfaceArmMk(f0, f1, f2, f3), r4))
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_SurfaceData(x: SurfaceData, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceDataMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, slot_unused_generics, slot_rows) => bsc_w_SurfaceVis(f8, bsc_w_Nat(
      f7,
      bsc_w_Option_Text(
        f6,
        bsc_w_Nat(
          f5,
          bsc_w_Nat(
            f4,
            bsc_w_List_SurfaceDataCtor(
              f3,
              bsc_w_List_Text(
                f2,
                bsc_w_Text(f1, bsc_w_Option_Text(f0, Cons(field("SurfaceDataMk"), acc)))
              )
            )
          )
        )
      )
    ))
  }
}

pub fn bsc_r_SurfaceData(r: Reader): Option(SurfaceData × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "SurfaceDataMk" {
        match bsc_r_Option_Text(r0) {
          None => None
          Some(p1) => match p1 {
            #(f0, r1) => match bsc_r_Text(r1) {
              None => None
              Some(p2) => match p2 {
                #(f1, r2) => match bsc_r_List_Text(r2) {
                  None => None
                  Some(p3) => match p3 {
                    #(f2, r3) => match bsc_r_List_SurfaceDataCtor(r3) {
                      None => None
                      Some(p4) => match p4 {
                        #(f3, r4) => match bsc_r_Nat(r4) {
                          None => None
                          Some(p5) => match p5 {
                            #(f4, r5) => match bsc_r_Nat(r5) {
                              None => None
                              Some(p6) => match p6 {
                                #(f5, r6) => match bsc_r_Option_Text(r6) {
                                  None => None
                                  Some(p7) => match p7 {
                                    #(f6, r7) => match bsc_r_Nat(r7) {
                                      None => None
                                      Some(p8) => match p8 {
                                        #(f7, r8) => match bsc_r_SurfaceVis(r8) {
 None => None
 Some(p9) => match p9 {
 #(f8, r9) => Some(#(SurfaceDataMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, Nil, Nil), r9))
 }
 }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_SurfaceInferCondition(x: SurfaceInferCondition, acc: List(Text)): List(Text) ! {div} {
  match x {
    InferParameter(name) => bsc_w_Text(name, Cons(field("InferParameter"), acc))
    InferAnd(left, right) => bsc_w_SurfaceInferCondition(right, bsc_w_SurfaceInferCondition(left, Cons(field("InferAnd"), acc)))
    InferOr(left, right) => bsc_w_SurfaceInferCondition(right, bsc_w_SurfaceInferCondition(left, Cons(field("InferOr"), acc)))
  }
}

pub fn bsc_r_SurfaceInferCondition(r: Reader): Option(SurfaceInferCondition × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "InferParameter" {
        match bsc_r_Text(r0) {
          None => None
          Some(pair) => match pair { #(name, rest) => Some(#(InferParameter(name), rest)) }
        }
      } else if tag == "InferAnd" || tag == "InferOr" {
        match bsc_r_SurfaceInferCondition(r0) {
          None => None
          Some(first) => match first {
            #(left, r1) => ⊢ Option(SurfaceInferCondition × Reader) from match bsc_r_SurfaceInferCondition(r1) {
              None => None
              Some(second) => match second {
                #(right, r2) => if tag == "InferAnd" { Some(#(InferAnd(left, right), r2)) } else { Some(#(InferOr(left, right), r2)) }
              }
            }
          }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_Option_SurfaceInferCondition(x: Option(SurfaceInferCondition), acc: List(Text)): List(Text) ! {div} {
  match x {
    None => Cons(field("n"), acc)
    Some(value) => bsc_w_SurfaceInferCondition(value, Cons(field("s"), acc))
  }
}

pub fn bsc_r_Option_SurfaceInferCondition(r: Reader): Option(Option(SurfaceInferCondition) × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "n" { Some(#(None, r0)) } else if tag == "s" {
        match bsc_r_SurfaceInferCondition(r0) {
          None => None
          Some(pair) => match pair { #(value, rest) => Some(#(Some(value), rest)) }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_SurfaceInstance(x: SurfaceInstance, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceInstanceMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, slot_unused_generics) => bsc_w_Option_SurfaceInferCondition(f11, bsc_w_List_SurfaceTerm(
      f10,
      bsc_w_List_SurfaceTerm(
        f9,
        bsc_w_Nat(
          f8,
          bsc_w_Nat(
            f7,
            bsc_w_List_SurfaceLaw(
              f6,
              bsc_w_List_SurfaceFn(
                f5,
                bsc_w_List_SurfaceConstraint(
                  f4,
                  bsc_w_SurfaceTerm(
                    f3,
                    bsc_w_Text(
                      f2,
                      bsc_w_List_Option_Text(
                        f1,
                        bsc_w_List_Text(f0, Cons(field("SurfaceInstanceMk"), acc))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    ))
  }
}

pub fn bsc_r_SurfaceInstance(r: Reader): Option(SurfaceInstance × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "SurfaceInstanceMk" {
        match bsc_r_List_Text(r0) {
          None => None
          Some(p1) => match p1 {
            #(f0, r1) => match bsc_r_List_Option_Text(r1) {
              None => None
              Some(p2) => match p2 {
                #(f1, r2) => match bsc_r_Text(r2) {
                  None => None
                  Some(p3) => match p3 {
                    #(f2, r3) => match bsc_r_SurfaceTerm(r3) {
                      None => None
                      Some(p4) => match p4 {
                        #(f3, r4) => match bsc_r_List_SurfaceConstraint(r4) {
                          None => None
                          Some(p5) => match p5 {
                            #(f4, r5) => match bsc_r_List_SurfaceFn(r5) {
                              None => None
                              Some(p6) => match p6 {
                                #(f5, r6) => match bsc_r_List_SurfaceLaw(r6) {
                                  None => None
                                  Some(p7) => match p7 {
                                    #(f6, r7) => match bsc_r_Nat(r7) {
                                      None => None
                                      Some(p8) => match p8 {
                                        #(f7, r8) => match bsc_r_Nat(r8) {
                                          None => None
                                          Some(p9) => match p9 {
                                            #(f8, r9) => match bsc_r_List_SurfaceTerm(r9) {
                                              None => None
                                              Some(p10) => match p10 {
                                                #(f9, r10) => match bsc_r_List_SurfaceTerm(r10) {
                                                  None => None
                                                  Some(p11) => match p11 {
                                                    #(f10, r11) => match bsc_r_Option_SurfaceInferCondition(r11) {
                                                      None => None
                                                      Some(p12) => match p12 {
                                                        #(f11, r12) => Some(#(SurfaceInstanceMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, Nil), r12))
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_SurfaceFn(x: SurfaceFn, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceFnMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f13, f12, f14, f15, f16, slot_unused, slot_unused_generics, slot_unused_params) => bsc_w_Option_SurfaceSpan(f16, bsc_w_SurfaceVis(f15, bsc_w_List_Option_Nat(f14, bsc_w_List_SurfaceTerm(
      f12,
      bsc_w_Option_List_Text(
      f13,
      bsc_w_SurfaceTerm(
        f11,
        bsc_w_Nat(
          f10,
          bsc_w_Nat(
            f9,
            bsc_w_List_SurfaceConstraint(
              f8,
              bsc_w_Option_List_RowEntry(
                f7,
                bsc_w_Option_SurfaceTerm(
                  f6,
                  bsc_w_List_Option_SurfaceTerm(
                    f5,
                    bsc_w_List_Option_Bool(
                      f4,
                      bsc_w_List_Text(
                        f3,
                        bsc_w_List_Option_Text(
                          f2,
                          bsc_w_List_Text(f1, bsc_w_Text(f0, Cons(field("SurfaceFnMk"), acc)))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    ))))
  }
}

pub fn bsc_r_SurfaceFn(r: Reader): Option(SurfaceFn × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "SurfaceFnMk" {
        match bsc_r_Text(r0) {
          None => None
          Some(p1) => match p1 {
            #(f0, r1) => match bsc_r_List_Text(r1) {
              None => None
              Some(p2) => match p2 {
                #(f1, r2) => match bsc_r_List_Option_Text(r2) {
                  None => None
                  Some(p3) => match p3 {
                    #(f2, r3) => match bsc_r_List_Text(r3) {
                      None => None
                      Some(p4) => match p4 {
                        #(f3, r4) => match bsc_r_List_Option_Bool(r4) {
                          None => None
                          Some(p5) => match p5 {
                            #(f4, r5) => match bsc_r_List_Option_SurfaceTerm(r5) {
                              None => None
                              Some(p6) => match p6 {
                                #(f5, r6) => match bsc_r_Option_SurfaceTerm(r6) {
                                  None => None
                                  Some(p7) => match p7 {
                                    #(f6, r7) => match bsc_r_Option_List_RowEntry(r7) {
                                      None => None
                                      Some(p8) => match p8 {
                                        #(f7, r8) => match bsc_r_List_SurfaceConstraint(r8) {
                                          None => None
                                          Some(p9) => match p9 {
                                            #(f8, r9) => match bsc_r_Nat(r9) {
                                              None => None
                                              Some(p10) => match p10 {
                                                #(f9, r10) => match bsc_r_Nat(r10) {
                                                  None => None
                                                  Some(p11) => match p11 {
                                                    #(f10, r11) => match bsc_r_SurfaceTerm(r11) {
                                                      None => None
                                                      Some(p12) => match p12 {
                                                        #(f11, r12) => match bsc_r_Option_List_Text(r12) {
                                                        None => None
                                                        Some(pl) => match pl {
                                                        #(f13, r12) => match bsc_r_List_SurfaceTerm(r12) {
                                                          None => None
                                                          Some(p13) => match p13 {
                                                            #(f12, r13) => match bsc_r_List_Option_Nat(r13) {
 None => None
 Some(p14) => match p14 {
 #(f14, r14) => match bsc_r_SurfaceVis(r14) {
 None => None
 Some(p15) => match p15 {
 #(f15, r15) => match bsc_r_Option_SurfaceSpan(r15) {
 None => None
 Some(p16) => match p16 {
 #(f16, r16) => Some(#(SurfaceFnMk(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f13, f12, f14, f15, f16, None, Nil, Nil), r16))
 }
 }
 }
 }
 }
 }
                                                          }
                                                        }
                                                      }
                                                        }
                                                        }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_SurfaceCtor(x: SurfaceCtor, acc: List(Text)): List(Text) ! {div} {
  match x {
    SurfaceCtorMk(f0, f1, f2, f3) => bsc_w_SurfaceTerm(
      f3,
      bsc_w_List_SurfaceNamed(f2, bsc_w_Nat(f1, bsc_w_Text(f0, Cons(field("SurfaceCtorMk"), acc))))
    )
  }
}

pub fn bsc_r_SurfaceCtor(r: Reader): Option(SurfaceCtor × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "SurfaceCtorMk" {
        match bsc_r_Text(r0) {
          None => None
          Some(p1) => match p1 {
            #(f0, r1) => match bsc_r_Nat(r1) {
              None => None
              Some(p2) => match p2 {
                #(f1, r2) => match bsc_r_List_SurfaceNamed(r2) {
                  None => None
                  Some(p3) => match p3 {
                    #(f2, r3) => match bsc_r_SurfaceTerm(r3) {
                      None => None
                      Some(p4) => match p4 {
                        #(f3, r4) => Some(#(SurfaceCtorMk(f0, f1, f2, f3), r4))
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_SurfaceStmt(x: SurfaceStmt, acc: List(Text)): List(Text) ! {div} {
  match x {
    StLet(f0, f1, f2, f3, f4, unused, st_stack) => bsc_w_Option_Text(st_stack, bsc_w_Bool(
      f4,
      bsc_w_Bool(
        f3,
        bsc_w_SurfaceTerm(
          f2,
          bsc_w_Option_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("StLet"), acc)))
        )
      )
    ))
    StVar(f0, f1, f2, f3, unused, st_stack) => bsc_w_Option_Text(st_stack, bsc_w_Bool(
      f3,
      bsc_w_SurfaceTerm(f2, bsc_w_Option_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("StVar"), acc))))
    ))
    StAssign(f0, f1, f2) => bsc_w_SurfaceTerm(
      f2,
      bsc_w_Option_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("StAssign"), acc)))
    )
    StCalled(f0, f1) => bsc_w_SurfaceTerm(f1, bsc_w_List_Text(f0, Cons(field("StCalled"), acc)))
    StFn(f0) => bsc_w_SurfaceFn(f0, Cons(field("StFn"), acc))
    StTheorem(f0) => bsc_w_SurfaceTheorem(f0, Cons(field("StTheorem"), acc))
    StDef(f0) => bsc_w_SurfaceTheorem(f0, Cons(field("StDef"), acc))
    StMutual(f0, f1, f2) => bsc_w_Nat(
      f2,
      bsc_w_Nat(f1, bsc_w_List_SurfaceStmt(f0, Cons(field("StMutual"), acc)))
    )
    StImport(f0, f1, f2) => bsc_w_Nat(
      f2,
      bsc_w_Nat(f1, bsc_w_Text(f0, Cons(field("StImport"), acc)))
    )
    StInductive(f0) => bsc_w_SurfaceInductive(f0, Cons(field("StInductive"), acc))
    StEffect(f0) => bsc_w_SurfaceEffect(f0, Cons(field("StEffect"), acc))
    StStruct(f0) => bsc_w_SurfaceData(f0, Cons(field("StStruct"), acc))
    StEnum(f0) => bsc_w_SurfaceData(f0, Cons(field("StEnum"), acc))
    StExtern(f0, f1, f2, f3, f4, f5, f6) => bsc_w_Nat(
      f6,
      bsc_w_Nat(
        f5,
        bsc_w_List_SurfaceData(
          f4,
          bsc_w_List_SurfaceData(
            f3,
            bsc_w_List_SurfaceData(
              f2,
              bsc_w_List_SurfaceConstraint(
                f1,
                bsc_w_List_SurfaceFn(f0, Cons(field("StExtern"), acc))
              )
            )
          )
        )
      )
    )
    StClass(f0) => bsc_w_SurfaceClass(f0, Cons(field("StClass"), acc))
    StInstance(f0) => bsc_w_SurfaceInstance(f0, Cons(field("StInstance"), acc))
    StWhile(f0, f1) => bsc_w_SurfaceTerm(f1, bsc_w_SurfaceTerm(f0, Cons(field("StWhile"), acc)))
    StReturn(f0) => bsc_w_Option_SurfaceTerm(f0, Cons(field("StReturn"), acc))
    StExpr(f0) => bsc_w_SurfaceTerm(f0, Cons(field("StExpr"), acc))
    StOther(f0, f1, f2) => bsc_w_Nat(f2, bsc_w_Nat(f1, bsc_w_Text(f0, Cons(field("StOther"), acc))))
    StLoop(st_body, f1, f2) => bsc_w_Nat(f2, bsc_w_Nat(f1, bsc_w_Text("LoopExpr", Cons(field("StOther"), acc))))
    StModule(mod_name, mod_vis, mod_items, f1, f2) => bsc_w_Nat(f2, bsc_w_Nat(f1, bsc_w_Text("ModuleDecl", Cons(field("StOther"), acc))))
    StReexport(re_path, re_names, re_spans, f1, f2) => bsc_w_Nat(f2, bsc_w_Nat(f1, bsc_w_Text("ReexportDecl", Cons(field("StOther"), acc))))
    StFor(for_pat, for_src, st_body, f1, f2) => bsc_w_Nat(f2, bsc_w_Nat(f1, bsc_w_Text("ForStmt", Cons(field("StOther"), acc))))
    StBreak(st_value, f1, f2) => bsc_w_Nat(f2, bsc_w_Nat(f1, bsc_w_Text("BreakStmt", Cons(field("StOther"), acc))))
    StContinue(f1, f2) => bsc_w_Nat(f2, bsc_w_Nat(f1, bsc_w_Text("ContinueStmt", Cons(field("StOther"), acc))))
    StMacro(f0, f1, f2, f3) => bsc_w_Nat(
      f3,
      bsc_w_Nat(f2, bsc_w_Text(f1, bsc_w_Text(f0, Cons(field("StMacro"), acc))))
    )
    StSyntax(f0, f1, f2, f3) => bsc_w_Nat(
      f3,
      bsc_w_Nat(f2, bsc_w_Text(f1, bsc_w_Text(f0, Cons(field("StSyntax"), acc))))
    )
    StAttributed(f0, f1, f2, f3) => bsc_w_SurfaceStmt(
      f3,
