      #(tag, r0) => if tag == "n" { Some(#(None, r0)) } else if tag == "s" {
        match bsc_r_Nat(r0) {
          None => None
          Some(q) => match q {
            #(y, r1) => Some(#(Some(y), r1))
          }
        }
      } else { None }
    }
  }
}


pub fn bsc_w_Option_SurfaceSpan(x: Option(SurfaceSpan), acc: List(Text)): List(Text) ! {div} {
  match x {
    None => Cons(field("n"), acc)
    Some(y) => match y {
      SurfaceSpan::Mk(a, b) => bsc_w_Nat(b, bsc_w_Nat(a, Cons(field("s"), acc)))
    }
  }
}

pub fn bsc_r_Option_SurfaceSpan(r: Reader): Option(Option(SurfaceSpan) × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "n" { Some(#(None, r0)) } else if tag == "s" {
        match bsc_r_Nat(r0) {
          None => None
          Some(q) => match q {
            #(a, r1) => match bsc_r_Nat(r1) {
              None => None
              Some(q2) => match q2 {
                #(b, r2) => Some(#(Some(SurfaceSpan::Mk(a, b)), r2))
              }
            }
          }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_RowEntry(x: RowEntry, acc: List(Text)): List(Text) ! {div} {
  match x {
    EntryName(f0, f1) => bsc_w_Option_SurfaceSpan(f1, bsc_w_Text(f0, Cons(field("EntryName"), acc)))
    EntryApplied(f0, f1, f2, f3, f4) => bsc_w_Option_SurfaceSpan(
      f4,
      bsc_w_List_Text(
        f3,
        bsc_w_Bool(f2, bsc_w_List_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("EntryApplied"), acc))))
      )
    )
  }
}

pub fn bsc_r_RowEntry(r: Reader): Option(RowEntry × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "EntryName" {
        match bsc_r_Text(r0) {
          None => None
          Some(p1) => match p1 {
            #(f0, r1) => match bsc_r_Option_SurfaceSpan(r1) {
              None => None
              Some(p2) => match p2 {
                #(f1, r2) => Some(#(EntryName(f0, f1), r2))
              }
            }
          }
        }
      } else if tag == "EntryApplied" {
        match bsc_r_Text(r0) {
          None => None
          Some(p1) => match p1 {
            #(f0, r1) => match bsc_r_List_SurfaceTerm(r1) {
              None => None
              Some(p2) => match p2 {
                #(f1, r2) => match bsc_r_Bool(r2) {
                  None => None
                  Some(p3) => match p3 {
                    #(f2, r3) => match bsc_r_List_Text(r3) {
                      None => None
                      Some(p4) => match p4 {
                        #(f3, r4) => match bsc_r_Option_SurfaceSpan(r4) {
                          None => None
                          Some(p5) => match p5 {
                            #(f4, r5) => Some(#(EntryApplied(f0, f1, f2, f3, f4), r5))
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else { None }
    }
  }
}

pub fn bsc_w_List_RowEntry(xs: List(RowEntry), acc: List(Text)): List(Text) ! {div} {
  bsc_w_List_RowEntry_items(xs, Cons(field(Text::of_u64(nat_to_u64(List::length(xs)))), acc))
}

fn bsc_w_List_RowEntry_items(xs: List(RowEntry), acc: List(Text)): List(Text) ! {div} {
  match xs {
    Nil => acc
    Cons(y, rest) => bsc_w_List_RowEntry_items(rest, bsc_w_RowEntry(y, acc))
  }
}

pub fn bsc_r_List_RowEntry(r: Reader): Option(List(RowEntry) × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(n, r0) => match parse_u64(n) {
        None => None
        Some(k) => handle { bsc_r_List_RowEntry_items(k, r0, Nil) } with { overflow() => None }
      }
    }
  }
}

fn bsc_r_List_RowEntry_items(
  k: u64,
  r: Reader,
  acc: List(RowEntry)
): Option(List(RowEntry) × Reader) ! {div, overflow} {
  if k == 0 { Some(#(List::reverse(acc), r)) } else {
    match bsc_r_RowEntry(r) {
      None => None
      Some(p) => match p {
        #(y, r1) => bsc_r_List_RowEntry_items(k - 1, r1, Cons(y, acc))
      }
    }
  }
}

pub fn bsc_w_Option_List_RowEntry(x: Option(List(RowEntry)), acc: List(Text)): List(Text) ! {div} {
  match x {
    None => Cons(field("n"), acc)
    Some(y) => bsc_w_List_RowEntry(y, Cons(field("s"), acc))
  }
}

pub fn bsc_r_Option_List_RowEntry(r: Reader): Option(Option(List(RowEntry)) × Reader) ! {div} {
  match next_field(r) {
    None => None
    Some(p) => match p {
      #(tag, r0) => if tag == "n" { Some(#(None, r0)) } else if tag == "s" {
        match bsc_r_List_RowEntry(r0) {
          None => None
          Some(q) => match q {
            #(y, r1) => Some(#(Some(y), r1))
          }
        }
      } else { None }
    }
  }
}
