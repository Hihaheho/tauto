pub fn bsc_w_SurfaceKind(x: SurfaceKind, acc: List(Text)): List(Text) ! {div} {
  match x {
    SkVar(f0) => bsc_w_Text(surface_name_text(f0), Cons(field("SkVar"), acc))
    SkNat(f0) => bsc_w_Text(f0, Cons(field("SkNat"), acc))
    SkFloat(f0) => bsc_w_Text(f0, Cons(field("SkFloat"), acc))
    SkRow(f0) => bsc_w_List_RowEntry(f0, Cons(field("SkRow"), acc))
    SkText(f0) => bsc_w_Text(f0, Cons(field("SkText"), acc))
    SkBool(f0) => bsc_w_Bool(f0, Cons(field("SkBool"), acc))
    SkApp(f0, f1) => bsc_w_List_SurfaceTerm(f1, bsc_w_SurfaceTerm(f0, Cons(field("SkApp"), acc)))
    SkPi(f0, f1, f2) => bsc_w_Option_List_RowEntry(
      f2,
      bsc_w_SurfaceTerm(f1, bsc_w_List_SurfaceParam(f0, Cons(field("SkPi"), acc)))
    )
    SkExists(f0, f1, f2, unused) => bsc_w_SurfaceTerm(
      f2,
      bsc_w_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("SkExists"), acc)))
    )
    SkLam(f0, f1, f2, _) => bsc_w_List_Option_SurfaceTerm(f2, bsc_w_SurfaceTerm(f1, bsc_w_List_Text(f0, Cons(field("SkLam"), acc))))
    SkUnion(f0) => bsc_w_List_SurfaceTerm(f0, Cons(field("SkUnion"), acc))
    SkAscribe(f0, f1) => bsc_w_SurfaceTerm(f1, bsc_w_SurfaceTerm(f0, Cons(field("SkAscribe"), acc)))
    SkTagged(f0, f1) => bsc_w_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("SkTagged"), acc)))
    SkIf(f0, f1, f2) => bsc_w_Option_SurfaceTerm(
      f2,
      bsc_w_SurfaceTerm(f1, bsc_w_SurfaceTerm(f0, Cons(field("SkIf"), acc)))
    )
    SkField(f0, f1) => bsc_w_Text(f1, bsc_w_SurfaceTerm(f0, Cons(field("SkField"), acc)))
    SkBlock(f0) => bsc_w_List_SurfaceStmt(f0, Cons(field("SkBlock"), acc))
    SkPerform(f0, f1) => bsc_w_List_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("SkPerform"), acc)))
    SkHandle(f0, f1) => bsc_w_List_SurfaceHandler(
      f1,
      bsc_w_SurfaceTerm(f0, Cons(field("SkHandle"), acc))
    )
    SkBudget(f0, f1, f2) => bsc_w_SurfaceTerm(
      f2,
      bsc_w_SurfaceTerm(f1, bsc_w_Bool(f0, Cons(field("SkBudget"), acc)))
    )
    SkMatch(f0, f1, f2, f3, _) => bsc_w_Option_Text(
      f3,
      bsc_w_List_SurfaceArm(
        f2,
        bsc_w_Option_SurfaceTerm(f1, bsc_w_SurfaceTerm(f0, Cons(field("SkMatch"), acc)))
      )
    )
    SkHole(f0) => bsc_w_Text(f0, Cons(field("SkHole"), acc))
    SkRecord(f0, f1) => bsc_w_List_SurfaceField(f1, bsc_w_Text(f0, Cons(field("SkRecord"), acc)))
    SkBorrow(f0, f1, f2) => bsc_w_SurfaceTerm(f2, bsc_w_Bool(f1, bsc_w_Bool(f0, Cons(field("SkBorrow"), acc))))
    SkFnKind(f0, f1) => bsc_w_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("SkFnKind"), acc)))
    SkBorrowLam(f0, f1) => bsc_w_SurfaceTerm(
      f1,
      bsc_w_List_Option_Bool(f0, Cons(field("SkBorrowLam"), acc))
    )
    SkOther(f0) => bsc_w_Text(f0, Cons(field("SkOther"), acc))
    SkMacroCall(f0, f1) => bsc_w_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("SkMacroCall"), acc)))
    SkQuote(f0, f1) => bsc_w_List_SurfaceStmt(f1, bsc_w_Bool(f0, Cons(field("SkQuote"), acc)))
    SkSplice(f0) => bsc_w_SurfaceTerm(f0, Cons(field("SkSplice"), acc))
    SkSyntaxLit(f0, f1) => bsc_w_Text(f1, bsc_w_Option_Text(f0, Cons(field("SkSyntaxLit"), acc)))
    SkStep(f0, f1, f2, f3, f4, f5) => bsc_w_List_SurfaceStepArm(
      f5,
      bsc_w_Option_SurfaceTerm(
        f4,
        bsc_w_Nat(
          f3,
          bsc_w_Nat(f2, bsc_w_SurfaceTerm(f1, bsc_w_Text(f0, Cons(field("SkStep"), acc))))
        )
      )
    )
  }
}

