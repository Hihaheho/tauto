import std::prelude::Os

pub fn grammar_parse_files(paths: List(Text)): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      match read_file(path) {
        Err(read_error) => eprint(read_error)
        Ok(source) => match tauto.parse(source) {
          Ok(tree) => print("ok")
          Err(diagnostic) => print("error")
        }
      }
      match Text::of_code_point(10) {
        Some(newline) => print(newline)
        None => #()
      }
      grammar_parse_files(rest)
    }
  }
}

grammar_parse_files(perform argv())
