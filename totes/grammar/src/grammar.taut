// The grammar of Tauto, shared by the bootstrap parser and its syntax parser.
syntax tauto => enum tauto_AddOp,
  struct tauto_Additive,
  struct tauto_Additive_Rep1,
  struct tauto_And,
  struct tauto_And_Rep1,
  struct tauto_AndOp,
  struct tauto_Arm,
  struct tauto_Arm_Opt1,
  struct tauto_Arm_Opt2,
  enum tauto_ArmBody,
  struct tauto_Arms,
  struct tauto_Arms_Opt1,
  struct tauto_ArmsTail,
  struct tauto_ArmsTail_Opt1,
  struct tauto_ArmsTail_Opt2,
  struct tauto_Attribute,
  struct tauto_AxiomDecl,
  struct tauto_AxiomDecl_Opt1,
  struct tauto_AxiomDecl_Rep1,
  struct tauto_Block,
  struct tauto_Borrow,
  enum tauto_Brace,
  struct tauto_BraceTerm,
  struct tauto_BrandDecl,
  struct tauto_BreakStmt,
  struct tauto_BudgetExpr,
  struct tauto_Call,
  struct tauto_Call_Opt1,
  struct tauto_Call_Rep1,
  enum tauto_ClassBody,
  struct tauto_ClassDecl,
  enum tauto_ClassItem,
  struct tauto_ClassItems,
  struct tauto_ClassItems_Opt1,
  struct tauto_ClassItemsTail,
  struct tauto_ClassItemsTail_Opt1,
  struct tauto_ClassItemsTail_Opt2,
  struct tauto_Compare,
  struct tauto_Compare_Opt1,
  enum tauto_CompareOp,
  struct tauto_Constraint,
  struct tauto_Constructor,
  struct tauto_Constructor_Opt1,
  struct tauto_Constructor_Rep1,
  struct tauto_Constructors,
  struct tauto_Constructors_Opt1,
  struct tauto_ConstructorsTail,
  struct tauto_ConstructorsTail_Opt1,
  struct tauto_ConstructorsTail_Opt2,
  struct tauto_ContinueStmt,
  struct tauto_DefDecl,
  struct tauto_DefDecl_Opt1,
  struct tauto_DefDecl_Rep1,
  struct tauto_EffectAlias,
  struct tauto_EffectAlias_Opt1,
  struct tauto_EffectAlias_Rep1,
  enum tauto_EffectBody,
  struct tauto_EffectDecl,
  enum tauto_EffectMode,
  struct tauto_EffectName,
  enum tauto_EffectRow,
  struct tauto_EffectRow_Opt1,
  struct tauto_EffectRow_Rep1,
  struct tauto_EffectRow_Opt2,
  struct tauto_EffectSignature,
  struct tauto_EffectSignature_Opt1,
  struct tauto_EffectSignature_Rep1,
  struct tauto_EffectSignature_Opt2,
  enum tauto_ElseBranch,
  struct tauto_EnumDecl,
  struct tauto_Expr,
  struct tauto_Expr_Opt1,
  enum tauto_Expr_Group1,
  struct tauto_Expr_Rep1,
  struct tauto_ExprStmt,
  struct tauto_ExprStmt_Opt1,
  struct tauto_ExternDecl,
  struct tauto_ExternFn,
  struct tauto_ExternFn_Opt1,
  struct tauto_ExternFn_Rep1,
  struct tauto_ExternInstance,
  enum tauto_ExternItem,
  struct tauto_ExternItems,
  struct tauto_ExternItems_Opt1,
  struct tauto_ExternTail,
  struct tauto_ExternTail_Opt1,
  struct tauto_ExternTail_Opt2,
  struct tauto_Field,
  struct tauto_FieldDecl,
  struct tauto_FieldInit,
  struct tauto_FieldPattern,
  struct tauto_FieldPattern_Opt1,
  struct tauto_FieldPatterns,
  struct tauto_FieldPatterns_Opt1,
  struct tauto_FieldPatternsTail,
  struct tauto_FieldPatternsTail_Opt1,
  struct tauto_FieldPatternsTail_Opt2,
  struct tauto_Fields,
  struct tauto_Fields_Opt1,
  struct tauto_FieldsTail,
  struct tauto_FieldsTail_Opt1,
  struct tauto_FieldsTail_Opt2,
  struct tauto_FnDecl,
  struct tauto_FnDecl_Opt1,
  struct tauto_FnDecl_Rep1,
  struct tauto_FnDecl_Opt2,
  struct tauto_FnKind,
  struct tauto_FnName,
  enum tauto_FnResult,
  struct tauto_FnType,
  struct tauto_FnType_Opt1,
  struct tauto_FnType_Rep1,
  enum tauto_FnType_Group1,
  struct tauto_FnTypeParam,
  struct tauto_FnTypeParam_Opt1,
  struct tauto_Gap,
  struct tauto_Generated,
  enum tauto_GeneratedKind,
  struct tauto_Generates,
  struct tauto_Generates_Rep1,
  struct tauto_Generic,
  struct tauto_Generic_Opt1,
  enum tauto_GenericKind,
  struct tauto_Generics,
  struct tauto_Generics_Rep1,
  struct tauto_HandleExpr,
  struct tauto_HandleSubject,
  struct tauto_HandleTail,
  struct tauto_HandleWith,
  enum tauto_Handler,
  struct tauto_Handlers,
  struct tauto_Handlers_Opt1,
  struct tauto_HandlersTail,
  struct tauto_HandlersTail_Opt1,
  struct tauto_HandlersTail_Opt2,
  struct tauto_HoleExpr,
  struct tauto_IfExpr,
  struct tauto_IfExpr_Opt1,
