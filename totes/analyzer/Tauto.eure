// The editor features of `tauto lsp`, in Tauto: the names of a file, where
// each is declared and where it is used (`src/index.taut`).
package {
  name = "analyzer"
  version = "0.1.0"
}

dependencies {
  ordmap { path = "../ordmap" }
  scan { path = "../scan" }
  llk { path = "../llk" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}
