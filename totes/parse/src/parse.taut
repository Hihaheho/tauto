import "../../surface/src/surface.taut"
import "../../surface/src/modules.taut"
import "../../syntax/src/syntax.taut"
import "../../unicode/src/unicode.taut"
import "../../text/src/text.taut"
import "../../identity/src/identity.taut"
import std::text
import std::base

// The reader of the surface syntax from the tree of `totes/syntax`: a port of
// `crates/tauto-parse`. `totes/surface` holds the syntax it reads into and
// depends on no reader, as `tauto-surface` does.

// How many nodes the tree has below `flat`, where every walk goes: enough steps
// for any walk through it.
mutual {
  pub fn surface_size(n: CstNode): Nat {
    match n {
      Mk(^kind, ^name, ^terminal, ^trivia, ^declared, ^start, ^end, ^children, flat) => Succ(
        surface_sizes(flat)
      )
    }
  }
  pub fn surface_sizes(l: List(CstNode)): Nat {
    match l {
      Nil => 0
      Cons(x, rest) => surface_size(x) + surface_sizes(rest)
    }
  }
}

// What reading the tree of `totes/syntax` needs (`Reader` of `surface.rs`):
// the source, how far the spans are shifted, the character classes, and how
// many steps a walk through the tree may take. With `lambda_types`, a lambda
// whose parameters are written with types is `#typed_lam(λ, T…)`, a parameter
// written without one `?#untyped` (the elaborator holds the types to the
// ones the λ is given); without it, the types are not read.
pub(open) inductive SurfaceCtx: Type {
  Mk(source: Text, base: Nat, classes: UnicodeClasses, fuel: Nat, lambda_types: Bool, own_budget: Bool, own_budget_memory: Bool): SurfaceCtx
}

pub fn surface_span(c: SurfaceCtx, n: CstNode): SurfaceSpan {
  SurfaceSpan { start: n.start + c.base, end: n.end + c.base }
}

// The text of a node's span (not shifted).
// The text of a node. A name written `r#name` is `name`: the `r#` is not part of it.
// `BindName` / `FnName` take the Ident child so a leading `^` unused marker is not
// part of the spelling.
pub fn surface_text(c: SurfaceCtx, n: CstNode): Text {
  if surface_is(n, "BindName") || surface_is(n, "FnName") {
    let bind := ⊢ CstNode from match surface_is(n, "FnName") {
      true => ⊢ CstNode from match surface_first(n, "BindName") {
        Some(b) => b
        None => n
      }
      false => n
    }
    // Ident spelling only (no recursive `surface_text`): `^` stays out of the name.
    ⊢ Text from match surface_first(bind, "Ident") {
      Some(i) => ⊢ Text from match surface_unhole(
        surface_trim(c, Text::slice_or_empty(c.source, i.start, i.end))
      ) {
        Some(hole) => hole
        None => surface_unraw(Text::slice_or_empty(c.source, i.start, i.end))
      }
      None => Text::slice_or_empty(c.source, n.start, n.end)
    }
  } else {
    match surface_is(
      n,
      "Ident"
    ) || surface_is(n, "CondPath") || surface_is(
      n,
      "OperationName"
    ) {
      true => ⊢ Text from match surface_unhole(surface_trim(c, Text::slice_or_empty(c.source, n.start, n.end))) {
        Some(hole) => hole
        None => surface_unraw(Text::slice_or_empty(c.source, n.start, n.end))
      }
      false => Text::slice_or_empty(c.source, n.start, n.end)
    }
  }
}

pub fn surface_is(n: CstNode, name: Text): Bool {
  not(n.terminal) && n.name == name
}

pub fn surface_find_in(nodes: List(CstNode), name: Text): Option(CstNode) {
  match nodes {
    Nil => None
    Cons(n, rest) => ⊢ Option(CstNode) from match surface_is(n, name) {
      true => Some(n)
      false => surface_find_in(rest, name)
    }
  }
}

// The first child (as `Cst::children` has them) of this kind.
// The parenthesized list `n` is, when it is nothing else: `n` or its only
// child, down to a `Paren`.
pub fn surface_sole_paren(k: Nat, n: CstNode): Option(CstNode) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(CstNode) from match surface_is(n, "Paren") {
      true => Some(n)
      false => ⊢ Option(CstNode) from match n.flat {
        Cons(only, rest) => ⊢ Option(CstNode) from match rest {
          Nil => surface_sole_paren(j, only)
          Cons(^x, ^y) => None
        }
        Nil => None
      }
    }
  }
}

// Every prefix is a function's kind (`affine`, `linear`); none is.
pub fn surface_only_kinds(prefixes: List(CstNode)): Bool {
  match prefixes {
    Nil => true
    Cons(p, rest) => ⊢ Bool from match surface_nth(p.flat, 0) {
      Some(head) => surface_is(head, "FnKind") && surface_only_kinds(rest)
      None => false
    }
  }
}

pub fn surface_first(n: CstNode, name: Text): Option(CstNode) {
  surface_find_in(n.flat, name)
}

pub fn surface_filter_in(nodes: List(CstNode), name: Text): List(CstNode) {
  match nodes {
    Nil => Nil
    Cons(n, rest) => ⊢ List(CstNode) from match surface_is(n, name) {
      true => Cons(n, surface_filter_in(rest, name))
      false => surface_filter_in(rest, name)
    }
  }
}

pub fn surface_all(n: CstNode, name: Text): List(CstNode) {
  surface_filter_in(n.flat, name)
}

pub fn surface_nth(nodes: List(CstNode), i: Nat): Option(CstNode) {
  match nodes {
    Nil => None
    Cons(n, rest) => ⊢ Option(CstNode) from match i {
      Zero => Some(n)
      Succ(i2) => surface_nth(rest, i2)
    }
  }
}

pub fn surface_kind_name(n: CstNode): Text {
  match n.terminal {
    true => "token"
    false => n.name
  }
}

pub fn surface_other(c: SurfaceCtx, n: CstNode): SurfaceTerm {
  surface_term_at(SkOther(surface_kind_name(n)), surface_span(c, n))
}

pub fn surface_one(xs: List(CstNode)): Option(CstNode) {
  match xs {
    Nil => None
    Cons(x, rest) => ⊢ Option(CstNode) from match rest {
      Nil => Some(x)
      Cons(^y, ^more) => None
    }
  }
}

pub fn surface_has(nodes: List(CstNode), name: Text): Bool {
  match surface_find_in(nodes, name) {
    Some(^n) => true
    None => false
  }
}

// A `let` written with a pattern (`let #(a, b) := p`), not a name alone.
pub fn surface_let_is_pattern(n: CstNode): Bool {
  match surface_has(n.flat, "LetPattern") {
    true => true
    false => match surface_has(n.flat, "PatternArgs") {
      true => true
      false => surface_has(n.flat, "PatternImplicits")
    }
  }
}

// The `LetDecl` of a statement that is a `let` with a pattern, when it has no
// attribute, visibility or properties: the statement a block reads as a `match`.
pub fn surface_pattern_let(n: CstNode): Option(CstNode) {
  match surface_first(n, "Attribute") {
    Some(^a) => None
    None => ⊢ Option(CstNode) from match surface_first(n, "Visibility") {
      Some(^v) => None
      None => ⊢ Option(CstNode) from match surface_first(n, "OtherStmt") {
        None => None
        Some(other) => ⊢ Option(CstNode) from match surface_nth(other.flat, 0) {
          None => None
          Some(inner) => if inner.terminal == false && inner.name == "LetDecl" && surface_has(inner.flat, "LetProps") == false && surface_let_is_pattern(inner) {
            Some(inner)
          } else {
            None
          }
        }
      }
    }
  }
}

// The end of a block's last statement, or of `n` when it is the last.
pub fn surface_last_stmt_end(c: SurfaceCtx, n: CstNode, rest: List(CstNode)): Nat {
  match rest {
    Nil => surface_span(c, n).end
    Cons(x, more) => surface_last_stmt_end(c, x, more)
  }
}

// A binding name `[Caret] Ident`: the spelled name and where `^` is written.
// Rejects nothing here; a name that is only `_` is the Wild token, not BindName.
pub fn surface_bind_name(c: SurfaceCtx, n: CstNode): Text × Option(SurfaceSpan) {
  let bind := ⊢ CstNode from match surface_is(n, "BindName") {
    true => n
    false => ⊢ CstNode from match surface_first(n, "BindName") {
      Some(b) => b
      None => n
    }
  }
  let unused := ⊢ Option(SurfaceSpan) from match surface_first(bind, "Caret") {
    Some(caret) => Some(surface_span(c, caret))
    None => ⊢ Option(SurfaceSpan) from match surface_first(n, "Caret") {
      Some(caret) => Some(surface_span(c, caret))
      None => None
    }
  }
  let spelling := ⊢ Text from match surface_first(bind, "Ident") {
    Some(i) => surface_unraw(surface_trim(c, Text::slice_or_empty(c.source, i.start, i.end)))
    None => ⊢ Text from match surface_first(n, "Ident") {
      Some(i) => surface_unraw(surface_trim(c, Text::slice_or_empty(c.source, i.start, i.end)))
      None => ""
    }
  }
  #(spelling, unused)
}

// `BindName` under `parent` (or `FnName`), or none when absent.
pub fn surface_bind_name_of(c: SurfaceCtx, parent: CstNode): Option(Text × Option(SurfaceSpan)) {
  match surface_first(parent, "BindName") {
    Some(b) => Some(surface_bind_name(c, b))
    None => ⊢ Option(Text × Option(SurfaceSpan)) from match surface_first(parent, "FnName") {
      Some(f) => Some(surface_bind_name(c, f))
      None => None
    }
  }
}

// The text of the binding name under the node (`BindName` / `FnName` / `Ident`), or "".
// `struct &T { … }` is declared under `&T`, beside `T`.
pub fn surface_struct_name(c: SurfaceCtx, decl: CstNode): Text {
  // The `&` is under the declaration itself, or under its `StructDeclOpt`.
  if surface_has(decl.flat, "Amp") || surface_has(decl.flat, "StructDeclOpt") {
    Text::concat("&", surface_ident(c, decl))
  } else {
    surface_ident(c, decl)
  }
}

pub fn surface_ident(c: SurfaceCtx, n: CstNode): Text {
  match surface_bind_name_of(c, n) {
    Some(found) => ⊢ Text from match found {
      #(name, _) => name
    }
    None => ⊢ Text from match surface_first(n, "Ident") {
      Some(i) => surface_text(c, i)
      None => ""
    }
  }
}

// The node that names a field: a name under `BindName`, a bare `Ident`, or a reserved word
// where only a name can stand (`t.type`, `#{ view: v }`).
pub fn surface_find_label(nodes: List(CstNode)): Option(CstNode) {
  match nodes {
    Nil => None
    Cons(x, rest) => ⊢ Option(CstNode) from match surface_is(x, "Ident") {
      true => Some(x)
      false => ⊢ Option(CstNode) from match surface_is(x, "BindName") {
        true => ⊢ Option(CstNode) from match surface_first(x, "Ident") {
          Some(i) => Some(i)
          None => surface_find_label(rest)
        }
        false => surface_find_label(rest)
      }
    }
  }
}

pub fn surface_label(c: SurfaceCtx, n: CstNode): Text {
  surface_name_of(c, surface_find_label(n.flat))
}

// The `⊢ G from e` an arm's body is.
pub fn surface_arm_goal_expr(b: CstNode): Option(CstNode) {
  match surface_first(b, "Expr") {
    None => None
    Some(e) => surface_first(e, "GoalExpr")
  }
}

// A constructor's name: a name, or `false` or `true`, which `Bool` declares.
pub fn surface_ctor_name(c: SurfaceCtx, n: CstNode): Text {
  match surface_first(n, "Ident") {
    Some(i) => surface_text(c, i)
    None => ⊢ Text from match surface_first(n, "True") {
      Some(^t) => "true"
      None => ⊢ Text from match surface_first(n, "False") {
        Some(^f) => "false"
        None => ""
      }
    }
  }
}

pub fn surface_opt_ident(c: SurfaceCtx, n: CstNode): Option(Text) {
  match surface_bind_name_of(c, n) {
    Some(found) => ⊢ Option(Text) from match found {
      #(name, _) => Some(name)
    }
    None => ⊢ Option(Text) from match surface_first(n, "Ident") {
      Some(i) => Some(surface_text(c, i))
      None => None
    }
  }
}

pub fn surface_name_of(c: SurfaceCtx, n: Option(CstNode)): Text {
  match n {
    Some(x) => surface_text(c, x)
    None => ""
  }
}

// A macro's name without the `!` its token ends with.
pub fn surface_macro_name(c: SurfaceCtx, n: Option(CstNode)): Text {
  let written := surface_trim(c, surface_name_of(c, n))
  Text::slice_or_empty(written, 0, Text::len(written) - 1)
}

pub fn surface_last_ident(nodes: List(CstNode)): Option(CstNode) {
  surface_find_in(List::reverse(nodes), "Ident")
}

pub fn surface_is_space(c: SurfaceCtx, code: Nat): Bool {
  unicode_is_whitespace(c.classes, code)
}

pub fn surface_skip_space_in(k: Nat, c: SurfaceCtx, t: Text, at: Nat): Nat {
  match k {
    Zero => at
    Succ(j) => ⊢ Nat from match text_decode(t, at) {
      None => at
      Some(#(@code code, @len len)) => ⊢ Nat from match surface_is_space(c, code) {
        true => surface_skip_space_in(j, c, t, at + len)
        false => at
      }
    }
  }
}

pub fn surface_last_end_in(k: Nat, c: SurfaceCtx, t: Text, at: Nat, last: Nat): Nat {
  match k {
    Zero => last
    Succ(j) => ⊢ Nat from match text_decode(t, at) {
      None => last
      Some(#(@code code, @len len)) => ⊢ Nat from match surface_is_space(c, code) {
        true => surface_last_end_in(j, c, t, at + len, last)
        false => surface_last_end_in(j, c, t, at + len, at + len)
      }
    }
  }
}

pub fn surface_trim_from(c: SurfaceCtx, t: Text, r#from: Nat): Text {
  match r#from >= Text::len(t) {
    true => ""
    false => Text::slice_or_empty(
      t,
      r#from,
      surface_last_end_in(Text::len(t) + 1, c, t, r#from, r#from)
    )
  }
}

pub fn surface_trim(c: SurfaceCtx, t: Text): Text {
  surface_trim_from(c, t, surface_skip_space_in(Text::len(t) + 1, c, t, 0))
}

pub fn surface_strip_in(k: Nat, c: SurfaceCtx, t: Text, at: Nat, done: List(Text)): List(Text) {
  match k {
    Zero => done
    Succ(j) => ⊢ List(Text) from match text_decode(t, at) {
      None => done
      Some(#(@code code, @len len)) => ⊢ List(Text) from match surface_is_space(c, code) {
        true => surface_strip_in(j, c, t, at + len, done)
        false => surface_strip_in(
          j,
          c,
          t,
          at + len,
          Cons(Text::slice_or_empty(t, at, at + len), done)
        )
      }
    }
  }
}

pub fn surface_strip(c: SurfaceCtx, t: Text): Text {
  Text::concat_all(List::reverse(surface_strip_in(Text::len(t) + 1, c, t, 0, Nil)))
}

// `C(T)::m` before its call: the method's name applied to a record of the
// class's arguments, each named by its place (`@class0`, …). The call that
// follows puts them first in its implicit record; the class's parameters lead
// the method's generics.
pub fn surface_class_pending(): Text { "@class-pending" }

pub fn surface_class_member_not_called(): Text {
  "`C(T)::m` names the method `m` of the instance of `C` for `T`, and is called: write `C(T)::m(…)`"
}

pub fn surface_class_member_not_class(): Text {
  "`::m` after `(…)` names the method `m` of a class with its arguments, as in `C(T)::m(…)`"
}

pub fn surface_class_fields(args: List(SurfaceTerm), i: Nat): List(SurfaceField) {
  match args {
    Nil => Nil
    Cons(a, rest) => Cons(
      SurfaceField { name: Text::concat("@class", Text::of_nat(i)), value: a },
      surface_class_fields(rest, i + 1)
    )
  }
}

pub fn surface_has_implicits(args: List(SurfaceTerm)): Bool {
  match args {
    Nil => false
    Cons(a, ^rest) => ⊢ Bool from match a.kind {
      SkRecord(name, ^fields) => name == "@implicits"
      _ => false
    }
  }
}

pub fn surface_member(acc: SurfaceTerm, method: Text, span: SurfaceSpan): SurfaceTerm {
  match acc.kind {
    SkApp(f, args) => ⊢ SurfaceTerm from match f.kind {
      SkVar(cls) => if surface_has_implicits(args) {
        surface_term_at(SkOther(surface_class_member_not_class()), span)
      } else {
        surface_term_at(
          SkApp(
            surface_var(Text::concat_all([surface_name_text(cls), "::", method]), span),
            [surface_term_at(SkRecord(surface_class_pending(), surface_class_fields(args, 0)), span)]
          ),
          span
        )
      }
      _ => surface_term_at(SkOther(surface_class_member_not_class()), span)
    }
    _ => surface_term_at(SkOther(surface_class_member_not_class()), span)
  }
}

pub fn surface_member_pending(acc: SurfaceTerm): Option(List(SurfaceField)) {
  match acc.kind {
    SkApp(^f, args) => ⊢ Option(List(SurfaceField)) from match args {
      Cons(a, Nil) => ⊢ Option(List(SurfaceField)) from match a.kind {
        SkRecord(name, fields) => if name == surface_class_pending() { Some(fields) } else { None }
        _ => None
      }
      _ => None
    }
    _ => None
  }
}

pub fn surface_member_head(acc: SurfaceTerm): SurfaceTerm {
  match acc.kind {
    SkApp(f, ^args) => f
    _ => acc
  }
}

// Where the implicit record of `C(T)::m(…)` is: the written `<…>`, or the
// whole call when there is none.
pub fn surface_implicits_span(c: SurfaceCtx, list: Option(CstNode), whole: SurfaceSpan): SurfaceSpan {
  match list {
    Some(l) => surface_span(c, l)
    None => whole
  }
}

pub fn surface_member_name(t: Text): Text {
  Text::slice_or_empty(t, 2, Text::len(t))
}

pub fn surface_span_of(t: SurfaceTerm): SurfaceSpan {
  SurfaceSpan { start: t.start, end: t.end }
}

pub fn surface_text_value(c: SurfaceCtx, n: CstNode): Text {
  surface_unquote(surface_trim(c, surface_text(c, n)))
}

// The nodes of kind `item` in `nodes`, through the tails of kinds `tail` and
// `tail2` (`Stmts: … [ Stmt StmtsTail ]` and the like).
pub fn surface_items_in(
  k: Nat,
  nodes: List(CstNode),
  item: Text,
  tail: Text,
  tail2: Text
): List(CstNode) {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(CstNode) from match nodes {
      Nil => Nil
      Cons(n, rest) => ⊢ List(CstNode) from match surface_is(n, item) {
        true => Cons(n, surface_items_in(j, rest, item, tail, tail2))
        false => ⊢ List(CstNode) from match surface_is(n, tail) || surface_is(n, tail2) {
          true => List::append(
            surface_items_in(j, n.flat, item, tail, tail2),
            surface_items_in(j, rest, item, tail, tail2)
          )
          false => surface_items_in(j, rest, item, tail, tail2)
        }
      }
    }
  }
}

// Every node of the kind below `nodes`, not looking inside one found.
pub fn surface_descend_in(k: Nat, nodes: List(CstNode), name: Text): List(CstNode) {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(CstNode) from match nodes {
      Nil => Nil
      Cons(n, rest) => ⊢ List(CstNode) from match n.terminal {
        true => surface_descend_in(j, rest, name)
        false => ⊢ List(CstNode) from match n.name == name {
          true => Cons(n, surface_descend_in(j, rest, name))
          false => List::append(
            surface_descend_in(j, n.flat, name),
            surface_descend_in(j, rest, name)
          )
        }
      }
    }
  }
}

pub fn surface_descend(c: SurfaceCtx, n: CstNode, name: Text): List(CstNode) {
  surface_descend_in(c.fuel, n.flat, name)
}

pub fn surface_match_arms(c: SurfaceCtx, arms: Option(CstNode)): List(CstNode) {
  match arms {
    Some(body) => surface_descend(c, body, "Arm")
    None => Nil
  }
}

pub fn surface_step_arm_nodes(c: SurfaceCtx, body: Option(CstNode)): List(CstNode) {
  match body {
    None => Nil
    Some(b) => surface_descend(c, b, "StepArm")
  }
}

// The name `&T` of a `LentPattern` `&T { … }`.
pub fn surface_lent_pattern_name(c: SurfaceCtx, node: CstNode): Text {
  match surface_first(node, "Ident") {
    Some(i) => Text::concat("&", surface_unraw(surface_trim(c, surface_text(c, i))))
    None => "&"
  }
}

pub fn surface_items(
  c: SurfaceCtx,
  nodes: List(CstNode),
  item: Text,
  tail: Text,
  tail2: Text
): List(CstNode) {
  surface_items_in(c.fuel, nodes, item, tail, tail2)
}

// The first node of the kind, searching the children first and then below each.
pub fn surface_find_deep(k: Nat, nodes: List(CstNode), name: Text): Option(CstNode) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(CstNode) from match nodes {
      Nil => None
      Cons(n, rest) => ⊢ Option(CstNode) from match surface_is(n, name) {
        true => Some(n)
        false => ⊢ Option(CstNode) from match surface_find_deep(j, n.flat, name) {
          Some(f) => Some(f)
          None => surface_find_deep(j, rest, name)
        }
      }
    }
  }
}

pub fn surface_except(kids: List(CstNode), name: Text): List(CstNode) {
  match kids {
    Nil => Nil
    Cons(n, rest) => ⊢ List(CstNode) from match surface_is(n, name) {
      true => surface_except(rest, name)
      false => Cons(n, surface_except(rest, name))
    }
  }
}

// Which spelling the literal has, by the first children down to one of
// them: 0 for `name`…``, 1 to 3 for `name<…`…`>`, 13 to 16 for the blocks.
pub fn surface_lit_kind(k: Nat, n: CstNode): Nat {
  match k {
    Zero => 0
    Succ(j) => ⊢ Nat from match n.terminal {
      true => 0
      false => ⊢ Nat from match n.name == "MacroText" {
        true => 0
        false => ⊢ Nat from match n.name == "MacroDelim1" {
          true => 1
          false => ⊢ Nat from match n.name == "MacroDelim2" {
            true => 2
            false => ⊢ Nat from match n.name == "MacroDelim3" {
              true => 3
              false => ⊢ Nat from match n.name == "MacroBlock3" {
                true => 13
                false => ⊢ Nat from match n.name == "MacroBlock4" {
                  true => 14
                  false => ⊢ Nat from match n.name == "MacroBlock5" {
                    true => 15
                    false => ⊢ Nat from match n.name == "MacroBlock6" {
                      true => 16
                      false => ⊢ Nat from match surface_nth(n.flat, 0) {
                        Some(first) => surface_lit_kind(j, first)
                        None => 0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub fn surface_first_space_in(k: Nat, c: SurfaceCtx, t: Text, at: Nat): Nat {
  match k {
    Zero => at
    Succ(j) => ⊢ Nat from match text_decode(t, at) {
      None => at
      Some(#(@code code, @len len)) => ⊢ Nat from match surface_is_space(c, code) {
        true => at
        false => surface_first_space_in(j, c, t, at + len)
      }
    }
  }
}

// How much of a line's white space to take off: all of a blank line, else
// `indent` or as much as there is.
pub fn surface_take(c: SurfaceCtx, bare: Text, indent: Nat): Nat {
  match Text::len(surface_trim(c, bare)) == 0 {
    true => Text::len(bare)
    false => Nat::min(indent, surface_lead_in(Text::len(bare) + 1, bare, 0))
  }
}

pub fn surface_dedent_line(c: SurfaceCtx, line: Text, indent: Nat): List(Text) {
  Cons(
    Text::slice_or_empty(
      line,
      surface_take(
        c,
        Text::slice_or_empty(line, 0, surface_without_eol(line, Text::len(line))),
        indent
      ),
      surface_without_eol(line, Text::len(line))
    ),
    Cons(
      Text::slice_or_empty(line, surface_without_eol(line, Text::len(line)), Text::len(line)),
      Nil
    )
  )
}

// The lines of `body` with `indent` bytes of white space taken off each; a
// line of white space only becomes an empty line. Last first.
pub fn surface_dedent_in(
  k: Nat,
  c: SurfaceCtx,
  body: Text,
  at: Nat,
  indent: Nat,
  done: List(Text)
): List(Text) {
  match k {
    Zero => done
    Succ(j) => ⊢ List(Text) from match at < Text::len(body) {
      true => surface_dedent_in(
        j,
        c,
        body,
        surface_line_end(body, at),
        indent,
        List::reverse_onto(
          surface_dedent_line(
            c,
            Text::slice_or_empty(body, at, surface_line_end(body, at)),
            indent
          ),
          done
        )
      )
      false => done
    }
  }
}

pub fn surface_dedent(c: SurfaceCtx, body: Text, indent: Nat): Text {
  Text::concat_all(List::reverse(surface_dedent_in(Text::len(body) + 1, c, body, 0, indent, Nil)))
}

// The content of a block literal: its last line dropped when it is blank,
// and the indent of that line taken off every line.
pub fn surface_block_content(c: SurfaceCtx, content: Text): Text {
  match Text::len(content) {
    Zero => ""
    Succ(last) => ⊢ Text from match surface_last_newline(content, last) {
      Some(i) => ⊢ Text from match surface_blank_tail(content, i + 1) {
        true => surface_dedent(
          c,
          Text::slice_or_empty(content, 0, i + 1),
          Text::len(content) - i - 1
        )
        false => surface_dedent(c, content, 0)
      }
      None => ⊢ Text from match surface_blank_tail(content, 0) {
        true => ""
        false => surface_dedent(c, content, 0)
      }
    }
  }
}

pub fn surface_block_lit_at(
  c: SurfaceCtx,
  whole: Text,
  n: Nat,
  after: Text,
  line_end: Nat
): SurfaceLit {
  SurfaceLit {
    name: surface_lit_name(after, surface_first_space_in(Text::len(after) + 1, c, after, 0)),
    body: surface_block_content(
      c,
      Text::slice_or_empty(whole, line_end, Nat::max(Text::len(whole) - n, line_end))
    )
  }
}

pub fn surface_block_lit(c: SurfaceCtx, whole: Text, n: Nat): SurfaceLit {
  surface_block_lit_at(
    c,
    whole,
    n,
    Text::slice_or_empty(whole, Nat::min(n, Text::len(whole)), Text::len(whole)),
    surface_line_end(whole, 0)
  )
}

pub fn surface_lit_with(c: SurfaceCtx, whole: Text, kind: Nat): SurfaceLit {
  match kind == 0 {
    true => SurfaceLit {
      name: surface_lit_name(whole, surface_find_or(whole, "`", 0)),
      body: Text::slice_or_empty(whole, surface_find_or(whole, "`", 0) + 1, Text::len(whole) - 1)
    }
    false => ⊢ SurfaceLit from match kind < 10 {
      true => SurfaceLit {
        name: surface_lit_name(whole, surface_find_or(whole, "<", 0)),
        body: Text::slice_or_empty(
          whole,
          surface_find_or(whole, "<", 0) + kind + 1,
          Text::len(whole) - (kind + 1)
        )
      }
      false => surface_block_lit(c, whole, kind - 10)
    }
  }
}

pub fn surface_lit(c: SurfaceCtx, n: CstNode): SurfaceLit {
  surface_lit_with(c, surface_text(c, n), surface_lit_kind(Text::len(c.source) + 1, n))
}

pub fn surface_fn_kind(
  c: SurfaceCtx,
  kind: CstNode,
  ty: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  surface_term_at(SkFnKind(surface_trim(c, surface_text(c, kind)), ty), span)
}

// `mut` and `orig` are in the `BorrowMode` under the borrow.
pub fn surface_borrow_mode(r#borrow: CstNode, keyword: Text): Bool {
  match surface_find_deep(4, r#borrow.flat, keyword) {
    Some(^n) => true
    None => false
  }
}

// `&rc e` and `&rc T` are read as `#rc(e)` (`surface_rc_name`).
pub fn surface_borrowed(r#borrow: CstNode, term: SurfaceTerm, span: SurfaceSpan): SurfaceTerm {
  match surface_borrow_mode(r#borrow, "AmpRc") {
    true => surface_term_at(SkApp(surface_term_at(SkVar(NameSpelled(surface_rc_name())), span), [term]), span)
    false => surface_term_at(
      SkBorrow(
        surface_borrow_mode(r#borrow, "KwMut"),
        surface_borrow_mode(r#borrow, "KwOrig"),
        term
      ),
      span
    )
  }
}

pub fn surface_tagged(
  c: SurfaceCtx,
  prefix: CstNode,
  term: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  surface_term_at(SkTagged(surface_ident(c, prefix), term), span)
}

// The label of `@a p`, from its `LabelPattern`.
pub fn surface_label_tag(c: SurfaceCtx, label: CstNode): Text {
  match surface_first(label, "TagPrefix") {
    Some(prefix) => surface_trim(c, surface_ident(c, prefix))
    None => ""
  }
}

pub fn surface_idents(c: SurfaceCtx, nodes: List(CstNode)): List(Text) {
  match nodes {
    Nil => Nil
    Cons(n, rest) => Cons(surface_text(c, n), surface_idents(c, rest))
  }
}

// The names `∀ A, B.` binds before an operation.
pub fn surface_forall_names(c: SurfaceCtx, f: Option(CstNode)): List(Text) {
  match f {
    Some(n) => surface_idents(c, surface_all(n, "Ident"))
    None => Nil
  }
}

// What an attribute's list makes, each as `kind name`; the word written
// before the first (`=> replace fn f, …`) goes before it.
pub fn surface_attr_generates(c: SurfaceCtx, list: Option(CstNode)): List(Text) {
  match list {
    None => Nil
    Some(l) => ⊢ List(Text) from match surface_generated(c, surface_all(l, "Generated")) {
      Nil => Nil
      Cons(first, rest) => ⊢ List(Text) from match surface_first(l, "Ident") {
        None => Cons(first, rest)
        Some(word) => Cons(
          Text::concat_all(Cons(surface_text(c, word), Cons(" ", Cons(first, Nil)))),
          rest
        )
      }
    }
  }
}

pub fn surface_generated(c: SurfaceCtx, nodes: List(CstNode)): List(Text) {
  match nodes {
    Nil => Nil
    Cons(g, rest) => ⊢ List(Text) from match surface_first(g, "GeneratedKind") {
      None => surface_generated(c, rest)
      Some(kind) => ⊢ List(Text) from match surface_first(g, "Ident") {
        None => surface_generated(c, rest)
        Some(i) => Cons(
          Text::concat_all(Cons(surface_text(c, kind), Cons(" ", Cons(surface_text(c, i), Nil)))),
          surface_generated(c, rest)
        )
      }
    }
  }
}

// The row variables of a row's terms, each `e` as `|e`.
pub fn surface_row_vars(c: SurfaceCtx, terms: List(CstNode)): List(RowEntry) {
  match terms {
    Nil => Nil
    Cons(t, rest) => ⊢ List(RowEntry) from match surface_first(t, "EffectLit") {
      Some(^lit) => surface_row_vars(c, rest)
      None => ⊢ List(RowEntry) from match surface_first(t, "Ident") {
        Some(v) => Cons(EntryName(Text::concat("|", surface_text(c, v)), None), surface_row_vars(c, rest))
        None => surface_row_vars(c, rest)
      }
    }
  }
}

// A kind in parentheses after `struct` or `enum` (`struct(affine)`), or `inductive`
// before it, under its `StructHead` or `EnumHead`. Inside a replaceable `extern`,
// `DeclProps` sits on the item itself (`ExternStructItem` / `ExternEnumItem`). An
// extern `type`'s words are read with `surface_decl_props` / the same `ExternProps`
// fallback as the Rust reader.
pub fn surface_data_kind(c: SurfaceCtx, decl: CstNode): Option(Text) {
  match surface_first(decl, "StructHead") {
    Some(h) => surface_data_head(c, h)
    None => ⊢ Option(Text) from match surface_first(decl, "EnumHead") {
      Some(h) => surface_data_head(c, h)
      None => ⊢ Option(Text) from match surface_first(decl, "DeclProps") {
        Some(p) => ⊢ Option(Text) from match surface_first(p, "Kind") {
          Some(k) => Some(surface_trim(c, surface_text(c, k)))
          None => None
        }
        None => surface_decl_props(c, decl)
      }
    }
  }
}

// `inductive struct(affine)` is `inductive, affine`, as in the Rust reader.
fn surface_data_head(c: SurfaceCtx, head: CstNode): Option(Text) {
  let kind := ⊢ Option(Text) from match surface_first(head, "DeclProps") {
    Some(p) => ⊢ Option(Text) from match surface_first(p, "Kind") {
      Some(k) => Some(surface_trim(c, surface_text(c, k)))
      None => None
    }
    None => None
  }
  match surface_first(head, "KwInductive") {
    Some(i) => ⊢ Option(Text) from match kind {
      Some(k) => Some(Text::concat_all([surface_trim(c, surface_text(c, i)), ", ", k]))
      None => Some(surface_trim(c, surface_text(c, i)))
    }
    None => kind
  }
}

// The words in an extern type's parentheses, joined by `, `, as in the Rust
// reader: `type(affine)` is `affine`, `type(affine, borrow)` is
// `affine, borrow`.
fn surface_decl_props(c: SurfaceCtx, head: CstNode): Option(Text) {
  match surface_first(head, "ExternProps") {
    Some(p) => ⊢ Option(Text) from match surface_first(p, "ExternProp") {
      Some(q) => ⊢ Option(Text) from match surface_first(q, "Kind") {
        Some(k) => ⊢ Option(Text) from match surface_first(q, "KwBorrowKind") {
          Some(^b) => Some(Text::concat(surface_trim(c, surface_text(c, k)), ", borrow"))
          None => Some(surface_trim(c, surface_text(c, k)))
        }
        None => ⊢ Option(Text) from match surface_first(q, "KwBorrowKind") {
          Some(^b) => Some("borrow")
          None => None
        }
      }
      None => None
    }
    None => None
  }
}

// The names of an extern type's parameters: `type(borrow) Iter(A: Type)`.
fn surface_extern_type_params(c: SurfaceCtx, t: CstNode): List(Text) {
  match surface_first(t, "TypeParams") {
    Some(ps) => surface_extern_param_names(c, surface_all(ps, "TypeParam"))
    None => Nil
  }
}

fn surface_extern_param_names(c: SurfaceCtx, nodes: List(CstNode)): List(Text) {
  match nodes {
    Nil => Nil
    Cons(n, rest) => Cons(surface_ident(c, n), surface_extern_param_names(c, rest))
  }
}

// `type(affine) Regex` in an `extern` block: a struct with one constructor
// and no fields (opaque host type).
// No mark for each of `names`: the type parameters an `extern` type declares are never marked.
pub fn surface_nones(names: List(Text)): List(Option(SurfaceSpan)) {
  match names {
    Nil => Nil
    Cons(^n, rest) => Cons(None, surface_nones(rest))
  }
}

fn surface_extern_type_data(c: SurfaceCtx, t: CstNode): SurfaceData {
  let base := SurfaceData {
    kind: surface_decl_props(c, t),
    name: surface_ident(c, t),
    generics: surface_extern_type_params(c, t),
    constructors: Cons(SurfaceDataCtor { name: surface_ident(c, t), fields: Nil }, Nil),
    start: surface_span(c, t).start,
    end: surface_span(c, t).end,
    coerce_level: None,
    coerce_field: 0,
    visibility: VisPrivate,
    unused_generics: surface_nones(surface_extern_type_params(c, t)),
    rows: Nil
  }
  match surface_visible(c, surface_first(t, "Visibility"), StStruct(base)) {
    StStruct(d) => d
    _ => base
  }
}

fn surface_extern_types(c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceData) {
  match nodes {
    Nil => Nil
    Cons(t, rest) => Cons(surface_extern_type_data(c, t), surface_extern_types(c, rest))
  }
}

fn surface_extern_structs_as_stmts(structs: List(SurfaceData)): List(SurfaceStmt) {
  match structs {
    Nil => Nil
    Cons(d, rest) => Cons(StStruct(d), surface_extern_structs_as_stmts(rest))
  }
}

fn surface_extern_enums_as_stmts(enums: List(SurfaceData)): List(SurfaceStmt) {
  match enums {
    Nil => Nil
    Cons(d, rest) => Cons(StEnum(d), surface_extern_enums_as_stmts(rest))
  }
}

fn surface_extern_fn_items(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceFn) ! {div} {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(SurfaceFn) from match nodes {
      Nil => Nil
      Cons(item, rest) => ⊢ List(SurfaceFn) from match surface_first(item, "ExternFn") {
        None => surface_extern_fn_items(j, c, rest)
        Some(f) => ⊢ List(SurfaceFn) from match surface_visible(
          c,
          surface_first(item, "Visibility"),
          StFn(surface_fn_decl(j, c, f))
        ) {
          StFn(decl) => Cons(surface_fn_start_at(decl, surface_span(c, f).start), surface_extern_fn_items(j, c, rest))
          _ => Cons(surface_fn_decl(j, c, f), surface_extern_fn_items(j, c, rest))
        }
      }
    }
  }
}

fn surface_extern_instances(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceConstraint) ! {div} {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(SurfaceConstraint) from match nodes {
      Nil => Nil
      Cons(i, rest) => {
        let span := surface_span(c, i)
        Cons(
          SurfaceConstraintMk(
            surface_name_of(c, surface_nth(surface_descend(c, i, "Ident"), 0)),
            surface_term_of(j, c, surface_ty(i), i),
            span.start,
            span.end,
            Nil
          ),
          surface_extern_instances(j, c, rest)
        )
      }
    }
  }
}

fn surface_extern_struct_items(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceData) ! {div} {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(SurfaceData) from match nodes {
      Nil => Nil
      Cons(item, rest) => {
        let d := surface_struct_decl(j, c, item)
        Cons(
          ⊢ SurfaceData from match surface_visible(
            c,
            surface_first(item, "Visibility"),
            StStruct(d)
          ) {
            StStruct(vis) => vis
            _ => d
          },
          surface_extern_struct_items(j, c, rest)
        )
      }
    }
  }
}

fn surface_extern_enum_items(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceData) ! {div} {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(SurfaceData) from match nodes {
      Nil => Nil
      Cons(item, rest) => {
        let d := surface_enum_decl(j, c, item)
        Cons(
          ⊢ SurfaceData from match surface_visible(
            c,
            surface_first(item, "Visibility"),
            StEnum(d)
          ) {
            StEnum(vis) => vis
            _ => d
          },
          surface_extern_enum_items(j, c, rest)
        )
      }
    }
  }
}

pub fn surface_expr_parts(kids: List(CstNode)): List(CstNode) {
  match kids {
    Nil => Nil
    Cons(n, rest) => ⊢ List(CstNode) from match not(
      n.terminal
    ) && n.name != "Gap" && n.name != "FatArrow" && n.name != "ThinArrow" {
      true => Cons(n, surface_expr_parts(rest))
      false => surface_expr_parts(rest)
    }
  }
}

// The word in `let(stack)` and `var(stack)`.
pub fn surface_let_props(c: SurfaceCtx, n: CstNode): Option(Text) {
  match surface_first(n, "LetProps") {
    None => None
    Some(p) => ⊢ Option(Text) from match surface_first(p, "Ident") {
      None => None
      Some(w) => Some(surface_trim(c, surface_text(c, w)))
    }
  }
}

pub fn surface_spans_of(c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceSpan) {
  match nodes {
    Nil => Nil
    Cons(n, rest) => Cons(surface_span(c, n), surface_spans_of(c, rest))
  }
}

pub fn surface_only_names(kids: List(CstNode)): Bool {
  match kids {
    Nil => true
    Cons(n, rest) => (surface_is(n, "Ident") || surface_is(n, "PathSep")) && surface_only_names(
      rest
    )
  }
}

pub fn surface_path_parts(c: SurfaceCtx, kids: List(CstNode)): List(Text) {
  match kids {
    Nil => Nil
    Cons(n, rest) => ⊢ List(Text) from match surface_is(n, "Ident") || surface_is(n, "PathSep") {
      true => Cons(surface_trim(c, surface_text(c, n)), surface_path_parts(c, rest))
      false => surface_path_parts(c, rest)
    }
  }
}

pub fn surface_number(c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
  match surface_one(n.flat) {
    Some(only) => ⊢ SurfaceTerm from match surface_is(only, "Integer") {
      true => surface_term_at(SkNat(surface_text(c, n)), span)
      false => ⊢ SurfaceTerm from match surface_is(only, "Float") || surface_is(only, "Decimal") {
        true => surface_term_at(SkFloat(surface_text(c, n)), span)
        false => surface_other(c, n)
      }
    }
    None => surface_other(c, n)
  }
}

pub fn surface_typed_lambda(c: SurfaceCtx, types: List(SurfaceTerm), lam: SurfaceTerm, span: SurfaceSpan): SurfaceTerm {
  if c.lambda_types && surface_any_typed(types) {
    surface_term_at(SkApp(surface_term_at(SkVar(NameSpelled("#typed_lam")), span), Cons(lam, types)), span)
  } else { lam }
}

// `#(a, b, …)` as an expression: the `Pair::Mk`s of the items, `#()` the unit;
// `#(a)` stays other.
pub fn surface_product_of(c: SurfaceCtx, n: CstNode, items: List(SurfaceTerm), span: SurfaceSpan): SurfaceTerm {
  match items {
    Cons(^only, rest) => ⊢ SurfaceTerm from match rest {
      Nil => surface_other(c, n)
      Cons(^x, ^y) => surface_pairs(surface_pair_mk_name(), items, span.end)
    }
    Nil => surface_star(span)
  }
}

pub fn surface_syntax_lit_term(c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm {
  surface_term_at(SkSyntaxLit(surface_lit(c, n).name, surface_lit(c, n).body), span)
}

// The kinds of statement, as `surface_stmt_of` tells them apart.
// The declaration in a `mutual` item, after its `pub`.
fn surface_mutual_decl(item: CstNode): Option(CstNode) {
  match surface_first(item, "MutualMember") {
    Some(m) => surface_nth(m.flat, 0)
    None => ⊢ Option(CstNode) from match surface_nth(item.flat, 0) {
      Some(d) => ⊢ Option(CstNode) from match surface_is(d, "Visibility") {
        true => surface_nth(item.flat, 1)
        false => Some(d)
      }
      None => None
    }
  }
}

// A statement with the `pub` or `pub(open)` written before it: a declaration
// starts at its `pub`, so that what is cut out of the text with it takes the
// word along; a statement that declares no name another file could see takes
// no `pub` and is read as an error there.
fn surface_visible(c: SurfaceCtx, vis: Option(CstNode), stmt: SurfaceStmt): SurfaceStmt {
  match vis {
    None => stmt
    Some(v) => {
      let at := surface_span(c, v)
      match surface_has(v.flat, "KwPubHandle") {
        // `pub(handle)` is written only before an effect that is not a set of effects.
        true => ⊢ SurfaceStmt from match stmt {
          StEffect(e) => ⊢ SurfaceStmt from match e.set {
            None => StEffect(SurfaceEffectMk(e.name, e.generics, e.params, e.result, e.r#resume, Nat::min(at.start, e.start), e.end, None, e.unused_generics, e.bounds, VisHandle, e.rows))
            Some(^set) => StOther("pub(handle) before a statement that declares nothing", at.start, at.end)
          }
          _ => StOther("pub(handle) before a statement that declares nothing", at.start, at.end)
        }
        false => surface_visible_from(
          at,
          ⊢ Text from match surface_has(v.flat, "KwPubOpen") {
            true => "pub(open) "
            false => "pub "
          },
          stmt
        )
      }
    }
  }
}

pub fn surface_param_idents(c: SurfaceCtx, params: List(CstNode)): List(Text) {
  match params {
    Nil => Nil
    Cons(p, rest) => ⊢ List(Text) from match surface_bind_name_of(c, p) {
      Some(found) => ⊢ List(Text) from match found {
        #(name, _) => Cons(name, surface_param_idents(c, rest))
      }
      None => ⊢ List(Text) from match surface_first(p, "Ident") {
        Some(i) => Cons(surface_text(c, i), surface_param_idents(c, rest))
        None => surface_param_idents(c, rest)
      }
    }
  }
}

pub fn surface_borrow_flag(found: Option(CstNode)): Option(Bool) {
  match found {
    Some(b) => Some(surface_borrow_mode(b, "KwMut"))
    None => None
  }
}

pub fn surface_param_borrow_flags(params: List(CstNode)): List(Option(Bool)) {
  match params {
    Nil => Nil
    Cons(p, rest) => Cons(
      surface_borrow_flag(surface_first(p, "Borrow")),
      surface_param_borrow_flags(rest)
    )
  }
}

pub fn surface_param_unused_spans(
  c: SurfaceCtx,
  params: List(CstNode)
): List(Option(SurfaceSpan)) {
  match params {
    Nil => Nil
    Cons(p, rest) => Cons(
      ⊢ Option(SurfaceSpan) from match surface_bind_name_of(c, p) {
        None => None
        Some(pair) => pair.snd
      },
      surface_param_unused_spans(c, rest)
    )
  }
}

// Where `^` marks each type parameter of `node` (aligned with its generics).
pub fn surface_none_spans(xs: List(SurfaceNamed)): List(Option(SurfaceSpan)) {
  match xs {
    Nil => Nil
    Cons(^x, rest) => Cons(None, surface_none_spans(rest))
  }
}

pub fn surface_generic_unused_spans(c: SurfaceCtx, node: CstNode): List(Option(SurfaceSpan)) {
  match surface_generic_node(node) {
    None => Nil
    Some(generics) => surface_param_unused_spans(c, surface_generic_items(generics))
  }
}

pub fn surface_kind_term(c: SurfaceCtx, n: CstNode, s: Text): Option(SurfaceTerm) {
  match surface_kind_word(s) {
    Some(^w) => Some(surface_var("Type", surface_span(c, n)))
    None => ⊢ Option(SurfaceTerm) from match surface_kind_bound(s) == s {
      true => None
      false => Some(
        surface_term_at(
          SkPi(
            Cons(SurfaceParam { name: None, ty: surface_var("Type", surface_span(c, n)), unused: None }, Nil),
            surface_var("Type", surface_span(c, n)),
            None
          ),
          surface_span(c, n)
        )
      )
    }
  }
}

// A row variable's bound is written after its `!`: `<=1`, `direct`. A type
// parameter of kind `Type` has none.
pub fn surface_bound(c: SurfaceCtx, g: CstNode): Option(Text) {
  match surface_first(g, "RowBound") {
    Some(b) => Some(surface_strip(c, surface_text(c, b)))
    None => ⊢ Option(Text) from match surface_first(g, "GenericKind") {
      Some(k) => ⊢ Option(Text) from match surface_sort_alone(surface_strip(c, surface_text(c, k))) {
        true => None
        false => Some(surface_generic_bound(surface_strip(c, surface_text(c, k))))
      }
      None => None
    }
  }
}

pub fn surface_bounds_of(c: SurfaceCtx, nodes: List(CstNode)): SurfaceBounds {
  match nodes {
    Nil => SurfaceBounds { names: Nil, bounds: Nil }
    Cons(g, rest) => SurfaceBounds {
      names: Cons(surface_ident(c, g), surface_bounds_of(c, rest).names),
      bounds: Cons(surface_bound(c, g), surface_bounds_of(c, rest).bounds)
    }
  }
}

// The node of a declaration's generics: `<A>` of a function, theorem or
// operation, or `(A: Type)` of a type declaration.
pub fn surface_generic_node(node: CstNode): Option(CstNode) {
  match surface_first(node, "Generics") {
    Some(g) => Some(g)
    None => surface_first(node, "TypeParams")
  }
}

pub fn surface_generic_items(generics: CstNode): List(CstNode) {
  List::append(surface_all(generics, "Generic"), surface_all(generics, "TypeParam"))
}

// Whether each generic of `node` is a row variable (`!e`); empty when none is.
pub fn surface_generic_rows(c: SurfaceCtx, node: CstNode): List(Bool) {
  match surface_generic_node(node) {
    None => Nil
    Some(generics) => {
      let flags := surface_row_flags(surface_generic_items(generics))
      if surface_any_true(flags) { flags } else { Nil }
    }
  }
}

pub fn surface_row_flags(nodes: List(CstNode)): List(Bool) {
  match nodes {
    Nil => Nil
    Cons(n, rest) => Cons(surface_has(n.flat, "Bang"), surface_row_flags(rest))
  }
}

pub fn surface_any_true(xs: List(Bool)): Bool {
  match xs {
    Nil => false
    Cons(x, rest) => x || surface_any_true(rest)
  }
}

// Where each generic of `node` starts, as `surface_generics` lists them.
pub fn surface_generic_starts(c: SurfaceCtx, node: CstNode): List(Option(Nat)) {
  match surface_generic_node(node) {
    None => Nil
    Some(generics) => surface_starts_of(c, surface_generic_items(generics))
  }
}
// A row variable (`!e`) has `None`: it is not a term generic.
pub fn surface_starts_of(c: SurfaceCtx, nodes: List(CstNode)): List(Option(Nat)) {
  match nodes {
    Nil => Nil
    Cons(n, rest) => Cons(
      if surface_has(n.flat, "Bang") { None } else { Some(surface_span(c, n).start) },
      surface_starts_of(c, rest)
    )
  }
}

pub fn surface_generic_bounds(c: SurfaceCtx, node: CstNode): SurfaceBounds {
  match surface_generic_node(node) {
    None => SurfaceBounds { names: Nil, bounds: Nil }
    Some(generics) => surface_bounds_of(c, surface_generic_items(generics))
  }
}

// Whether a statement is `macro fn m(…) … { … }`: the function `m` and the registration of `m` as a macro.
pub fn surface_is_macro_fn(n: CstNode): Bool {
  match surface_first(n, "Attribute") {
    Some(^attr) => false
    None => ⊢ Bool from match surface_first(n, "OtherStmt") {
      None => false
      Some(other) => ⊢ Bool from match surface_nth(other.flat, 0) {
        None => false
        Some(inner) => surface_is(inner, "MacroFnDecl")
      }
    }
  }
}

pub fn surface_literal_pattern(c: SurfaceCtx, lit: CstNode): SurfacePattern {
  match surface_has(lit.flat, "True") {
    true => PtBool(true)
    false => ⊢ SurfacePattern from match surface_has(lit.flat, "False") {
      true => PtBool(false)
      false => ⊢ SurfacePattern from match surface_has(lit.flat, "Text") {
        true => PtText(surface_unquote(surface_trim(c, surface_text(c, lit))))
        false => ⊢ SurfacePattern from match surface_parse_int(
          text_join(text_split(surface_trim(c, surface_text(c, lit)), " "), "")
        ) {
          Some(n) => PtInt(n.fst, n.snd)
          None => PtOther("number pattern")
        }
      }
    }
  }
}

pub fn surface_is_level(n: CstNode): Bool {
  match n.terminal {
    true => false
    false => n.name == "Type" || n.name == "BodyType" || n.name == "Seq" || n.name == "Cond" || n.name == "Operand" || n.name == "CondOperand" || n.name == "ArmType" || n.name == "Postfix" || n.name == "CondPostfix" || n.name == "Primary" || n.name == "CondPrimary" || n.name == "Brace" || n.name == "ArmBody" || n.name == "OperationType"
  }
}

// Whether a path pattern is a lone name or Wild: no arguments, one BindName or Wild, no `::`.
pub fn surface_simple_path(path: CstNode): Bool {
  match surface_first(path, "PatternArgs") {
    Some(^a) => false
    None => ⊢ Bool from match surface_has(path.flat, "PatternImplicits") {
      true => false
      false => ⊢ Bool from match surface_first(path, "Wild") {
        Some(^w) => true
        None => ⊢ Bool from match surface_first(path, "BindName") {
          Some(^b) => List::length(surface_all(path, "PathSep")) == 0
          None => ⊢ Bool from match surface_one(surface_all(path, "Ident")) {
            Some(^i) => List::length(surface_all(path, "PathSep")) == 0
            None => false
          }
        }
      }
    }
  }
}

pub fn surface_block_list(block: Option(CstNode)): Option(CstNode) {
  match block {
    Some(b) => surface_first(b, "Stmts")
    None => None
  }
}

pub fn surface_quantifier(kids: List(CstNode), c: SurfaceCtx): Text {
  match kids {
    Cons(n, ^rest) => surface_text(c, n)
    Nil => ""
  }
}

pub fn surface_else(kids: List(CstNode)): Option(CstNode) {
  match surface_find_in(kids, "ElseBranch") {
    Some(e) => surface_nth(e.flat, 0)
    None => None
  }
}

pub fn surface_opt_text_value(c: SurfaceCtx, t: Option(CstNode)): Text {
  match t {
    Some(x) => surface_text_value(c, x)
    None => ""
  }
}

// What an `import` names: the quoted path, or `std.List` as written.
fn surface_texts(c: SurfaceCtx, nodes: List(CstNode)): List(Text) {
  match nodes {
    Nil => Nil
    Cons(n, rest) => Cons(surface_text(c, n), surface_texts(c, rest))
  }
}

pub fn surface_import_path(c: SurfaceCtx, inner: CstNode): Text {
  match surface_first(inner, "Text") {
    Some(t) => surface_text_value(c, t)
    None => surface_import_idents(c, surface_filter_in(inner.flat, "Ident"))
  }
}

// `import std::list` is kept as the path `std.List`: its names joined by
// `.`, however many there are.
fn surface_import_idents(c: SurfaceCtx, idents: List(CstNode)): Text {
  match idents {
    Nil => ""
    Cons(first, rest) => ⊢ Text from match rest {
      Nil => surface_text(c, first)
      Cons(^next, ^more) => Text::concat(
        Text::concat(surface_text(c, first), "."),
        surface_import_idents(c, rest)
      )
    }
  }
}

pub fn surface_grammar(c: SurfaceCtx, inner: CstNode): Text {
  match surface_nth(surface_descend(c, inner, "SyntaxLit"), 0) {
    Some(b) => surface_lit(c, b).body
    None => surface_lit(c, inner).body
  }
}

pub fn surface_signature(decl: CstNode): Option(CstNode) {
  match surface_first(decl, "EffectBody") {
    Some(b) => surface_first(b, "EffectSignature")
    None => None
  }
}

// The parentheses after an operation's name hold its parameters; after a set
// of effects, its type parameters.
pub fn surface_effect_params(decl: CstNode): Option(CstNode) {
  match surface_signature(decl) {
    Some(^sig) => surface_first(decl, "EffectParams")
    None => None
  }
}

// The explicit resume mode: a written quantity, or `direct` when the mode has
// no quantity. An absent signature or mode remains `None`.
pub fn surface_resume(c: SurfaceCtx, signature: Option(CstNode)): Option(Text) {
  match signature {
    None => None
    Some(sig) => ⊢ Option(Text) from match surface_first(sig, "EffectMode") {
      None => None
      Some(mode) => ⊢ Option(Text) from match surface_first(mode, "Quant") {
        Some(q) => Some(surface_strip(c, surface_text(c, q)))
        None => Some("direct")
      }
    }
  }
}

// The level written before a struct's field, `coerce`, `coerce(mut)` or
// `coerce(owned)`, when one is.
pub fn surface_field_coerce(c: SurfaceCtx, field: CstNode): Option(Text) {
  match surface_first(field, "FieldCoerce") {
    None => None
    Some(fc) => ⊢ Option(Text) from match surface_first(fc, "CoerceLevel") {
      None => Some("coerce")
      Some(l) => Some(Text::concat("coerce(", Text::concat(surface_strip(c, surface_text(c, l)), ")")))
    }
  }
}

// The first of the fields written with `coerce`: its level, or `None`.
pub fn surface_coerce_level(c: SurfaceCtx, fields: List(CstNode)): Option(Text) {
  match fields {
    Nil => None
    Cons(f, rest) => ⊢ Option(Text) from match surface_field_coerce(c, f) {
      Some(l) => Some(l)
      None => surface_coerce_level(c, rest)
    }
  }
}

// The index of the first of the fields written with `coerce`, counted from `at`; `0` when none is.
pub fn surface_coerce_index(c: SurfaceCtx, fields: List(CstNode), at: Nat): Nat {
  match fields {
    Nil => 0
    Cons(f, rest) => ⊢ Nat from match surface_field_coerce(c, f) {
      Some(^l) => at
      None => surface_coerce_index(c, rest, at + 1)
    }
  }
}

pub fn surface_struct_fields(c: SurfaceCtx, body: Option(CstNode)): List(CstNode) {
  match body {
    None => Nil
    Some(b) => ⊢ List(CstNode) from match surface_first(b, "Fields") {
      Some(f) => surface_descend(c, f, "FieldDecl")
      None => Nil
    }
  }
}

pub fn surface_ctor_nodes(c: SurfaceCtx, list: Option(CstNode)): List(CstNode) {
  match list {
    Some(l) => surface_items(c, l.flat, "Constructor", "ConstructorsTail", "ConstructorsTail")
    None => Nil
  }
}

pub fn surface_is_mut(found: Option(CstNode)): Bool {
  match found {
    Some(b) => surface_borrow_mode(b, "KwMut")
    None => false
  }
}

// `, k` / `, ^k` is the BindName after the closing parenthesis.
pub fn surface_cont(c: SurfaceCtx, op: CstNode): Option(Text) {
  match surface_cont_marked(c, op) {
    Some(pair) => Some(pair.fst)
    None => None
  }
}

pub fn surface_cont_unused(c: SurfaceCtx, op: CstNode): Option(SurfaceSpan) {
  match surface_cont_marked(c, op) {
    Some(pair) => pair.snd
    None => None
  }
}

pub fn surface_cont_marked(c: SurfaceCtx, op: CstNode): Option(Text × Option(SurfaceSpan)) {
  match surface_last_bind_name(op.flat) {
    Some(b) => Some(surface_bind_name(c, b))
    None => ⊢ Option(Text × Option(SurfaceSpan)) from match surface_last_ident(op.flat) {
      Some(i) => Some(#(surface_text(c, i), None))
      None => None
    }
  }
}

pub fn surface_last_bind_name(nodes: List(CstNode)): Option(CstNode) {
  surface_find_in(List::reverse(nodes), "BindName")
}
// ---- a sequence of operands and operators --------------------------------------------
//
// `Type`, `BodyType`, `Seq` and `Cond` hold operands and the operators between them, flat; the
// precedences build the tree, as `Reader::sequence` in `crates/tauto-surface/src/surface.rs` does.

// One operand: its term with the prefixes that bind to it alone applied, the parenthesized list it is when
// it is nothing else (the parameters of a `->` it stands before), the prefixes `¬` and a binder that take
// a sequence (the first written first) and the `affine` or `linear` before it.
pub(open) inductive SurfacePiece: Type {
  SurfacePieceMk(
    term: SurfaceTerm,
    paren: Option(CstNode),
    loose: List(CstNode),
    kind: Option(CstNode)
  ): SurfacePiece
}

// A term read from a part of a sequence, with what a later operator needs to know of it: the parenthesized
// list it is, its `affine` or `linear`, and whether it is a union (1) or a product (2) built from a run.
pub(open) inductive SurfaceParsed: Type {
  SurfaceParsedMk(
    term: SurfaceTerm,
    paren: Option(CstNode),
    kind: Option(CstNode),
    flat: Nat
  ): SurfaceParsed
}

pub(open) inductive SurfaceClimb: Type {
  SurfaceClimbMk(
    parsed: SurfaceParsed,
    pieces: List(SurfacePiece),
    ops: List(SurfaceOp)
  ): SurfaceClimb
}

// The type written under a node: a `Type`, or a `BodyType` where a `{` or `=>` follows it.
pub fn surface_find_ty(nodes: List(CstNode)): Option(CstNode) {
  match nodes {
    Nil => None
    Cons(x, rest) => ⊢ Option(CstNode) from match surface_is(x, "Type") || surface_is(x, "BodyType") {
      true => Some(x)
      false => surface_find_ty(rest)
    }
  }
}

// The count and the function of a budget's call: two items, each an
// expression with no type written after it and no `^`, and no implicit
// argument.
pub fn surface_budget_items(call: Option(CstNode)): Option(CstNode × CstNode) {
  match call {
    None => None
    Some(x) => ⊢ Option(CstNode × CstNode) from match surface_first(x, "CallImplicits") {
      Some(^i) => None
      None => ⊢ Option(CstNode × CstNode) from match surface_all(x, "Item") {
        Cons(count, rest) => ⊢ Option(CstNode × CstNode) from match rest {
          Cons(f, more) => ⊢ Option(CstNode × CstNode) from match more {
            Nil => ⊢ Option(CstNode × CstNode) from match surface_plain_item(count) && surface_plain_item(f) {
              true => Some(#(count, f))
              false => None
            }
            Cons(^y, ^ys) => None
          }
          Nil => None
        }
        Nil => None
      }
    }
  }
}

pub fn surface_plain_item(i: CstNode): Bool {
  match surface_ty(i) {
    None => surface_has(i.flat, "Expr") && not(surface_has(i.flat, "Caret"))
    Some(^t) => false
  }
}

pub fn surface_ty(n: CstNode): Option(CstNode) {
  surface_find_ty(n.flat)
}

// The level a prefix reads its operand at: `\u{00ac}` takes `=` and what binds tighter, a binder
// takes all that follows.
pub fn surface_sq_prefix_level(prefix: CstNode): Nat {
  match surface_is(prefix, "Binder") {
    true => 0
    false => 4
  }
}

pub fn surface_sq_parsed(term: SurfaceTerm): SurfaceParsed {
  SurfaceParsed { term: term, paren: None, kind: None, flat: 0 }
}

pub fn surface_sq_ops(c: SurfaceCtx, kids: List(CstNode)): List(SurfaceOp) {
  match kids {
    Nil => Nil
    Cons(n, rest) => ⊢ List(SurfaceOp) from match surface_is(n, "Op") || surface_is(n, "CondOp") || surface_is(n, "ArmTypeOp") {
      true => Cons(
        SurfaceOp {
          sign: surface_sign(surface_trim(c, surface_text(c, n))),
          end: surface_span(c, n).end
        },
        surface_sq_ops(c, rest)
      )
      false => surface_sq_ops(c, rest)
    }
  }
}

// The operators of a sequence, none for a lone operand.
pub fn surface_sq_ops_of(c: SurfaceCtx, n: CstNode): List(SurfaceOp) {
  match surface_is(n, "Operand") || surface_is(n, "CondOperand") {
    true => Nil
    false => surface_sq_ops(c, n.flat)
  }
}

// An operand with `affine` or `linear` written before it, kept as the kind of its type.
pub fn surface_sq_finish(c: SurfaceCtx, p: SurfaceParsed): SurfaceTerm {
  match p.kind {
    Some(kind) => surface_fn_kind(
      c,
      kind,
      p.term,
      SurfaceSpan { start: p.term.start, end: p.term.end }
    )
    None => p.term
  }
}

// The term a prefix that binds to its operand alone makes: a tag, a borrow, or `-` and `+`.
pub fn surface_prefix_term(
  c: SurfaceCtx,
  p: CstNode,
  head: CstNode,
  acc: SurfaceTerm,
  span: SurfaceSpan
): SurfaceTerm {
  match surface_is(head, "TagPrefix") {
    true => surface_tagged(c, head, acc, span)
    false => ⊢ SurfaceTerm from match surface_is(head, "Borrow") {
      true => surface_borrowed(head, acc, span)
      false => surface_app(surface_trim(c, surface_text(c, p)), Cons(acc, Nil), span)
    }
  }
}

pub fn surface_prefixed(
  c: SurfaceCtx,
  p: CstNode,
  head: CstNode,
  built: SurfacePiece
): SurfacePiece {
  match surface_is(head, "NotSign") || surface_is(head, "Binder") {
    true => SurfacePiece {
      term: built.term,
      paren: built.paren,
      loose: Cons(head, built.loose),
      kind: built.kind
    }
    false => ⊢ SurfacePiece from match surface_is(head, "FnKind") {
      true => SurfacePiece {
        term: built.term,
        paren: built.paren,
        loose: built.loose,
        kind: Some(head)
      }
      false => SurfacePiece {
        term: surface_prefix_term(
          c,
          p,
          head,
          built.term,
          SurfaceSpan { start: surface_span(c, p).start, end: built.term.end }
        ),
        paren: built.paren,
        loose: built.loose,
        kind: built.kind
      }
    }
  }
}

pub fn surface_sq_binary(op: Text, l: SurfaceTerm, rhs_flat: Nat, r: SurfaceTerm): SurfaceParsed {
  match op == "|" {
    true => SurfaceParsed {
      term: surface_term_at(
        SkUnion(Cons(l, surface_sq_members(r, rhs_flat, 1))),
        SurfaceSpan { start: l.start, end: r.end }
      ),
      paren: None,
      kind: None,
      flat: 1
    }
    false => ⊢ SurfaceParsed from match op == "\u{00d7}" {
      true => surface_sq_parsed(
        surface_app(
          surface_pair_name(),
          Cons(l, Cons(r, Nil)),
          SurfaceSpan { start: l.start, end: r.end }
        )
      )
      false => surface_sq_parsed(
        surface_app(
          surface_sq_op_name(op),
          Cons(l, Cons(r, Nil)),
          SurfaceSpan { start: l.start, end: r.end }
        )
      )
    }
  }
}

// `(params) -> result`, with the effects the row after the sequence gives, and the kind written before it.
pub fn surface_sq_pi(
  c: SurfaceCtx,
  kind: Option(CstNode),
  params: List(SurfaceParam),
  result: SurfaceTerm,
  start: Nat,
  effects: Option(List(RowEntry))
): SurfaceParsed {
  match kind {
    Some(k) => surface_sq_parsed(
      surface_fn_kind(
        c,
        k,
        surface_term_at(
          SkPi(params, result, effects),
          SurfaceSpan { start: start, end: result.end }
        ),
        SurfaceSpan { start: start, end: result.end }
      )
    )
    None => surface_sq_parsed(
      surface_term_at(SkPi(params, result, effects), SurfaceSpan { start: start, end: result.end })
    )
  }
}

pub fn surface_sq_chain_error(op: SurfaceOp, left: SurfaceParsed, ops: List(SurfaceOp)): SurfaceClimb {
  match ops {
    Nil => SurfaceClimb { parsed: left, pieces: Nil, ops: Nil }
    Cons(next, ^more) => SurfaceClimb {
      parsed: surface_sq_parsed(
        surface_term_at(
          SkOther(surface_sq_chain_message(op, next)),
          SurfaceSpan { start: left.term.start, end: next.end }
        )
      ),
      pieces: Nil,
      ops: Nil
    }
  }
}

// `BraceBody: Nl BraceBody | …`: the body after the newlines that follow the `{`.
pub fn surface_inner_body(k: Nat, body: CstNode): CstNode {
  match k {
    Zero => body
    Succ(j) => ⊢ CstNode from match surface_first(body, "BraceBody") {
      None => body
      Some(inner) => surface_inner_body(j, inner)
    }
  }
}

// `borrows(m, x.f, place(Tree))`: each path its names joined by `.`, and an
// operation's instance with its type arguments as written.
pub fn surface_fn_lends(c: SurfaceCtx, b: Option(CstNode)): Option(List(Text)) {
  match b {
    None => None
    Some(n) => Some(surface_borrow_paths(c, surface_all(n, "BorrowPath")))
  }
}

pub fn surface_borrow_paths(c: SurfaceCtx, ps: List(CstNode)): List(Text) {
  match ps {
    Nil => Nil
    Cons(p, rest) => Cons(surface_borrow_path(c, p), surface_borrow_paths(c, rest))
  }
}

pub fn surface_borrow_path(c: SurfaceCtx, p: CstNode): Text {
  let path: Text := text_join(surface_idents_text(c, surface_all(p, "Ident")), ".")
  ⊢ Text from match surface_first(p, "TypeCall") {
    Some(args) => Text::concat(path, Text::slice_or_empty(c.source, args.start, args.end))
    None => path
  }
}

pub fn surface_idents_text(c: SurfaceCtx, xs: List(CstNode)): List(Text) {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(surface_text(c, x), surface_idents_text(c, rest))
  }
}

// `pub import path.{a, b}`: the names of the module `path` declared again where
// it is written, at the span of its `pub`. Any other import with a word before
// it is read by `surface_visible`.
fn surface_reexport(c: SurfaceCtx, vis: Option(CstNode), inner: CstNode): Option(SurfaceStmt) {
  match vis {
    None => None
    Some(v) => if surface_has(v.flat, "KwPubOpen") || surface_has(v.flat, "KwPubHandle") || inner.name != "ImportDecl" {
      None
    } else {
      match surface_first(inner, "Text") {
        Some(^t) => None
        None => match surface_first(inner, "ImportList") {
          None => None
          Some(list) => {
            let at := surface_span(c, v)
            let names := surface_descend(c, list, "Ident")
            Some(StReexport(surface_import_path(c, inner), surface_idents(c, names), surface_spans_of(c, names), at.start, at.end))
          }
        }
      }
    }
  }
}

// Unused marks on step binders (`^m: T ⊢ …`).
pub fn surface_step_unused_binders(
  k: Nat,
  c: SurfaceCtx,
  nodes: List(CstNode)
): List(Option(SurfaceSpan)) {
  match k {
    Zero => Nil
    Succ(j) => ⊢ List(Option(SurfaceSpan)) from match nodes {
      Nil => Nil
      Cons(b, rest) => Cons(
        ⊢ Option(SurfaceSpan) from match surface_bind_name_of(c, b) {
          Some(pair) => pair.snd
          None => None
        },
        surface_step_unused_binders(j, c, rest)
      )
    }
  }
}

mutual {
  pub fn surface_term(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => surface_term_below(j, c, surface_through_levels(j, n))
    }
  }

  pub fn surface_through_levels(k: Nat, n: CstNode): CstNode {
    match k {
      Zero => n
      Succ(j) => ⊢ CstNode from match surface_is_level(n) {
        false => n
        true => ⊢ CstNode from match n.flat {
          Cons(only, Nil) => surface_through_levels(j, only)
          _ => n
        }
      }
    }
  }

  pub fn surface_term_below(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match n.terminal {
        // Type/term atom `_` (Wild): Nib partial applications such as `Two(_, i64)`.
        true => ⊢ SurfaceTerm from match n.name == "Wild" {
          true => surface_term_at(SkVar(NameSpelled("_")), surface_span(c, n))
          false => surface_other(c, n)
        }
        false => ⊢ SurfaceTerm from match surface_rule(n.name) {
          RuleType => surface_sequence(j, c, n).term
          RuleAngle => surface_angle(j, c, n)
          RuleRow => surface_term_at(SkRow(surface_row_names(j, c, n)), surface_span(c, n))
          RuleExpr => surface_expr(j, c, n.flat, surface_span(c, n))
          RulePostfix => surface_postfix(j, c, n.flat, surface_span(c, n))
          RulePrimary => surface_term_of(j, c, surface_one(n.flat), n)
          RulePathExpr => surface_path(j, c, n, surface_span(c, n))
          RuleNumber => surface_number(c, n, surface_span(c, n))
          RuleHoleExpr => surface_term_at(
            SkHole(surface_trim_marks(surface_text(c, n))),
            surface_span(c, n)
          )
          RuleText => surface_term_at(SkText(surface_text_value(c, n)), surface_span(c, n))
          RuleTrue => surface_term_at(SkBool(true), surface_span(c, n))
          RuleFalse => surface_term_at(SkBool(false), surface_span(c, n))
          RuleParen => ⊢ SurfaceTerm from match surface_is(n, "CongrExpr") {
            true => ⊢ SurfaceTerm from match surface_first(n, "Expr") {
              None => surface_other(c, n)
              Some(e) => surface_congr_of(j, surface_term(j, c, e), surface_span(c, n))
            }
            false => ⊢ SurfaceTerm from match surface_is(n, "BoxHole") {
            true => surface_term_at(SkOther(surface_box_outside()), surface_span(c, n))
            false => ⊢ SurfaceTerm from match surface_is(n, "ProductLit") {
            // `#(a, b)`: the product of the items; `#()` is the unit, and one
            // item alone is not a product.
            true => surface_product_of(
              c,
              n,
              surface_map_items(j, c, surface_filter_in(n.flat, "Item")),
              surface_span(c, n)
            )
            false => surface_paren_written(
              j,
              c,
              surface_filter_in(n.flat, "Item"),
              surface_paren_of(
                surface_map_terms(j, c, surface_filter_in(n.flat, "Item")),
                surface_has(n.flat, "Comma"),
                surface_span(c, n),
                None
              ),
              surface_has(n.flat, "Comma"),
              surface_span(c, n)
            )
          }
          }
          }
          RuleListLit => surface_list_items(
            j,
            c,
            surface_first(n, "ListItems"),
            surface_span(c, n)
          )
          RuleBrace => surface_brace(j, c, n)
          RuleArmBody => surface_term_of(j, c, surface_first(n, "Expr"), n)
          RuleBlock => surface_block_of(
            surface_block_stmts(j, c, surface_first(n, "Stmts")),
            surface_span(c, n)
          )
          RuleIfExpr => surface_if(j, c, n.flat, surface_span(c, n))
          RulePerformExpr => surface_perform(j, c, n, surface_span(c, n))
          RuleHandleExpr => surface_handle(j, c, n, surface_span(c, n))
          RuleMatchExpr => surface_match(j, c, n, surface_span(c, n))
          RuleSyntaxLit => surface_syntax_lit_term(c, n, surface_span(c, n))
          RuleMacroCall => surface_term_at(
            SkMacroCall(
              surface_macro_name(c, surface_first(n, "MacroName")),
              surface_macro_arg(j, c, n, surface_span(c, n))
            ),
            surface_span(c, n)
          )
          RuleQuoteExpr => surface_term_at(
            SkQuote(
              surface_name_of(c, surface_first(n, "Ident")) == "stmts",
              surface_quote_stmts(j, c, surface_block_list(surface_first(n, "Block")))
            ),
            surface_span(c, n)
          )
          RuleSpliceExpr => surface_splice(j, c, n)
          RuleStepExpr => surface_step(j, c, n, surface_span(c, n))
          RuleAnonRecord => surface_anon_record(j, c, n)
          RuleItem => surface_term_of(j, c, surface_nth(n.flat, 0), n)
          _ => if n.name == "GoalExpr" { surface_goal(j, c, n, surface_span(c, n), true) } else { if n.name == "LoopExpr" { surface_loop(j, c, n) } else { surface_other(c, n) } }
        }
      }
    }
  }

  // The written type of a parenthesis's only item, `T` of `(e: T)`.
  pub fn surface_paren_ty(k: Nat, c: SurfaceCtx, items: List(CstNode)): Option(SurfaceTerm) ! {div} {
    match items {
      Cons(only, rest) => ⊢ Option(SurfaceTerm) from match rest {
        Nil => ⊢ Option(SurfaceTerm) from match surface_ty(only) {
          None => None
          Some(t) => Some(surface_term(k, c, t))
        }
        Cons(^x, ^y) => None
      }
      Nil => None
    }
  }

  // `⊢ G from e`: a `match` with no result type gets `G` as its result type;
  // any other `e` is `e` at `G`, `(e: G)`, but under an arm, which states its
  // goal itself.
  pub fn surface_goal(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan, ascribe: Bool): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(n, "Expr") {
        None => surface_other(c, n)
        Some(e) => {
          let body := surface_term(j, c, e)
          ⊢ SurfaceTerm from match body {
            SurfaceTermIndexedMk(kind, s, en, occ) => ⊢ SurfaceTerm from match kind {
              SkMatch(scrutinee, motive, arms, binder, unused) => ⊢ SurfaceTerm from match motive {
                None => SurfaceTermIndexedMk(SkMatch(scrutinee, surface_opt_term(j, c, surface_ty(n)), arms, binder, unused), s, en, occ)
                Some(^m) => body
              }
              _ => if ascribe == false { body } else { ⊢ SurfaceTerm from match surface_ty(n) {
                None => body
                Some(t) => surface_term_at(SkAscribe(body, surface_term(j, c, t)), span)
              } }
            }
          }
        }
      }
    }
  }

  // The argument under `n`: the expression between the parentheses, or the
  // syntax literal written in their place (`m!`x``).
  pub fn surface_macro_arg_in(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(n, "Expr") {
        Some(e) => surface_term(j, c, e)
        None => ⊢ SurfaceTerm from match surface_first(n, "SyntaxLit") {
          Some(l) => surface_term(j, c, l)
          None => surface_star(span)
        }
      }
    }
  }

  // The term of the node found, or `Other` for the node it was looked for in.
  // The argument of `name!(arg)`; `name!()` passes the unit.
  pub fn surface_macro_arg(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(n, "MacroCallGroup") {
        Some(g) => surface_macro_arg_in(j, c, g, span)
        None => surface_macro_arg_in(j, c, n, span)
      }
    }
  }

  // `[a, ..r]`: `Cons(a, r)`, from `at`, a `ListItems`, as a product is
  // `Pair::Mk(…)`; `[a]` ends in `Nil`. Each cell spans from its item to the `]`.
  pub fn surface_list_items(
    k: Nat,
    c: SurfaceCtx,
    at: Option(CstNode),
    span: SurfaceSpan
  ): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match at {
        None => surface_var("Nil", span)
        Some(n) => ⊢ SurfaceTerm from match surface_first(n, "ListRest") {
          Some(r) => surface_term_of(j, c, surface_first(r, "Expr"), r)
          None => ⊢ SurfaceTerm from match surface_first(n, "Expr") {
            None => surface_other(c, n)
            Some(e) => {
              let item := surface_term(j, c, e)
              surface_app(
                "Cons",
                Cons(item, Cons(surface_list_items(j, c, surface_first(n, "ListItems"), span), Nil)),
                SurfaceSpan { start: item.start, end: span.end }
              )
            }
          }
        }
      }
    }
  }

  // `Brace: AnonRecord | LBrace BraceBody`: the one node it holds, or the block of its body.
  pub fn surface_brace(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_one(n.flat) {
        Some(only) => surface_term(j, c, only)
        None => ⊢ SurfaceTerm from match surface_first(n, "BraceBody") {
          None => surface_other(c, n)
          Some(outer) => surface_brace_block(j, c, surface_inner_body(c.fuel, outer), n)
        }
      }
    }
  }

  // `#{ a: 1, b: 2 }`: the literal of the struct `@record.a.b`, its fields in the order they are
  // written. The fields not written cannot be taken from another value with `..`.
  pub fn surface_anon_record(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_items(
        c,
        n.flat,
        "RecordBase",
        "RecordTail",
        "RecordTail"
      ) {
        Cons(^base, ^more) => surface_term_at(
          SkOther(
            "`..` takes the fields from another value only in a struct with a name: write each field of a record"
          ),
          surface_span(c, n)
        )
        Nil => surface_anon_record_of(
          surface_fields(
            j,
            c,
            surface_items(c, n.flat, "FieldInit", "RecordTail", "RecordTail")
          ),
          surface_span(c, n)
        )
      }
    }
  }

  // The fields of a record type `{ a: A, b: B }`, as written: each name and its type.
  pub fn surface_record_fields(k: Nat, c: SurfaceCtx, decls: List(CstNode)): List(SurfaceNamed) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceNamed) from match decls {
        Nil => Nil
        Cons(f, rest) => Cons(
          SurfaceNamedMk(surface_label(c, f), surface_term_of(j, c, surface_ty(f), f)),
          surface_record_fields(j, c, rest)
        )
      }
    }
  }

  // The block of a `BraceBody`: its statements are under `Stmts` after a `;`, else its own `Stmt`
  // and `StmtsTail`. A block holding one expression is that expression.
  pub fn surface_brace_block(k: Nat, c: SurfaceCtx, body: CstNode, n: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(body, "RecordType") {
        Some(record) => surface_record_of(
          surface_record_fields(
            j,
            c,
            surface_items(c, record.flat, "FieldDecl", "RecordTypeTail", "RecordTypeTail")
          ),
          surface_span(c, n)
        )
        None => ⊢ SurfaceTerm from match surface_first(body, "Stmts") {
          Some(stmts) => surface_block_of(
            surface_block_stmts(j, c, Some(stmts)),
            surface_span(c, n)
          )
          None => surface_block_of(
            surface_read_stmts(j, c, surface_items(c, body.flat, "Stmt", "StmtsTail", "StmtsTail")),
            surface_span(c, n)
          )
        }
      }
    }
  }

  pub fn surface_term_of(
    k: Nat,
    c: SurfaceCtx,
    found: Option(CstNode),
    fallback: CstNode
  ): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match found {
        Some(n) => surface_term(j, c, n)
        None => surface_other(c, fallback)
      }
    }
  }

  pub fn surface_opt_term(k: Nat, c: SurfaceCtx, found: Option(CstNode)): Option(SurfaceTerm) ! {div} {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(SurfaceTerm) from match found {
        Some(n) => Some(surface_term(j, c, n))
        None => None
      }
    }
  }

  pub fn surface_map_terms(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceTerm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceTerm) from match nodes {
        Nil => Nil
        Cons(n, rest) => Cons(surface_term(j, c, n), surface_map_terms(j, c, rest))
      }
    }
  }

  // The members of `#(a: A, b)`: a member with a written type is at that type,
  // over the member's span.
  pub fn surface_map_items(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceTerm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceTerm) from match nodes {
        Nil => Nil
        Cons(n, rest) => Cons(
          ⊢ SurfaceTerm from match surface_first(n, "Type") {
            None => surface_term(j, c, n)
            Some(ty) => surface_term_at(
              SkAscribe(surface_term(j, c, n), surface_term(j, c, ty)),
              surface_span(c, n)
            )
          },
          surface_map_items(j, c, rest)
        )
      }
    }
  }

  // `(e: T)`, one item with no comma and a written type: `e` at `T`, over the
  // parentheses; any other parenthesized list is `read` as it is.
  pub fn surface_paren_written(
    k: Nat,
    c: SurfaceCtx,
    items: List(CstNode),
    read: SurfaceTerm,
    has_comma: Bool,
    span: SurfaceSpan
  ): SurfaceTerm ! {div} {
    match k {
      Zero => read
      Succ(j) => ⊢ SurfaceTerm from match has_comma {
        true => read
        false => ⊢ SurfaceTerm from match items {
          Nil => read
          Cons(only, rest) => ⊢ SurfaceTerm from match rest {
            Cons(^x, ^y) => read
            Nil => ⊢ SurfaceTerm from match surface_first(only, "Type") {
              None => read
              Some(ty) => surface_term_at(SkAscribe(read, surface_term(j, c, ty)), span)
            }
          }
        }
      }
    }
  }

  pub fn surface_splice(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(n, "Expr") {
        Some(e) => surface_term_at(SkSplice(surface_term(j, c, e)), surface_span(c, n))
        None => surface_other(c, n)
      }
    }
  }

  pub fn surface_call_args(k: Nat, c: SurfaceCtx, call: Option(CstNode)): List(SurfaceTerm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceTerm) from match call {
        // `perform e(<T: A>, x)`: the named type arguments first, as a call's.
        Some(x) => List::append(
          surface_call_implicits(j, c, surface_first(x, "CallImplicits")),
          surface_map_terms(j, c, surface_all(x, "Item"))
        )
        None => Nil
      }
    }
  }

  pub fn surface_piece(k: Nat, c: SurfaceCtx, operand: CstNode): SurfacePiece ! {div} {
    match k {
      Zero => SurfacePiece { term: surface_out("fuel"), paren: None, loose: Nil, kind: None }
      Succ(j) => ⊢ SurfacePiece from match List::reverse(operand.flat) {
        Nil => SurfacePiece { term: surface_other(c, operand), paren: None, loose: Nil, kind: None }
        // `prefixes` is last first, the order they are applied in.
        Cons(postfix, prefixes) => surface_piece_prefixes(
          j,
          c,
          prefixes,
          SurfacePiece {
            term: surface_term(j, c, postfix),
            // `affine` and `linear` take the whole arrow, so `affine () -> A` still has a
            // parameter list: no parameter, not one `Unit`.
            paren: ⊢ Option(CstNode) from match surface_only_kinds(prefixes) {
              true => surface_sole_paren(j, postfix)
              false => None
            },
            loose: Nil,
            kind: None
          }
        )
      }
    }
  }

  pub fn surface_piece_prefixes(
    k: Nat,
    c: SurfaceCtx,
    prefixes: List(CstNode),
    built: SurfacePiece
  ): SurfacePiece {
    match k {
      Zero => built
      Succ(j) => ⊢ SurfacePiece from match prefixes {
        Nil => built
        Cons(p, rest) => ⊢ SurfacePiece from match surface_nth(p.flat, 0) {
          None => surface_piece_prefixes(j, c, rest, built)
          Some(head) => surface_piece_prefixes(j, c, rest, surface_prefixed(c, p, head, built))
        }
      }
    }
  }

  pub fn surface_pieces(k: Nat, c: SurfaceCtx, kids: List(CstNode)): List(SurfacePiece) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePiece) from match kids {
        Nil => Nil
        Cons(n, rest) => ⊢ List(SurfacePiece) from match surface_is(
          n,
          "Operand"
        ) || surface_is(n, "CondOperand") {
          true => Cons(surface_piece(j, c, n), surface_pieces(j, c, rest))
          false => surface_pieces(j, c, rest)
        }
      }
    }
  }

  pub fn surface_sq_pieces_of(k: Nat, c: SurfaceCtx, n: CstNode): List(SurfacePiece) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePiece) from match surface_is(n, "Operand") || surface_is(
        n,
        "CondOperand"
      ) {
        true => Cons(surface_piece(j, c, n), Nil)
        false => surface_pieces(j, c, n.flat)
      }
    }
  }

  // The term of a sequence, and the effect row written after it when no `->` takes it: a declaration's
  // result is `A \u{00d7} B ! {e}`, and the row of `(A) -> B ! {e}` is the arrow's.
  pub fn surface_sequence(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceReturn ! {div} {
    match k {
      Zero => SurfaceReturn { term: surface_out("fuel"), effects: None }
      Succ(j) => surface_sequence_of(
        j,
        c,
        n,
        surface_sq_pieces_of(j, c, n),
        surface_sq_ops_of(c, n)
      )
    }
  }

  pub fn surface_sequence_of(
    k: Nat,
    c: SurfaceCtx,
    n: CstNode,
    pieces: List(SurfacePiece),
    ops: List(SurfaceOp)
  ): SurfaceReturn ! {div} {
    match k {
      Zero => SurfaceReturn { term: surface_out("fuel"), effects: None }
      Succ(j) => ⊢ SurfaceReturn from match List::length(ops) + 1 == List::length(pieces) {
        false => SurfaceReturn { term: surface_other(c, n), effects: None }
        true => SurfaceReturn {
          term: surface_sq_finish(
            c,
            surface_sq_climb(
              j,
              c,
              surface_sq_arrow_row(surface_sq_has_arrow(ops), surface_sq_row(j, c, n)),
              0,
              pieces,
              ops
            ).parsed
          ),
          effects: surface_sq_unattached(surface_sq_has_arrow(ops), surface_sq_row(j, c, n))
        }
      }
    }
  }

  // The operand at the front of `pieces` and the operators of at least `min` after it.
  pub fn surface_sq_climb(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(RowEntry)),
    min: Nat,
    pieces: List(SurfacePiece),
    ops: List(SurfaceOp)
  ): SurfaceClimb ! {div} {
    match k {
      Zero => SurfaceClimb { parsed: surface_sq_parsed(surface_out("fuel")), pieces: Nil, ops: Nil }
      Succ(j) => surface_sq_loop(j, c, row, min, surface_sq_operand(j, c, row, pieces, ops))
    }
  }

  pub fn surface_sq_operand(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(RowEntry)),
    pieces: List(SurfacePiece),
    ops: List(SurfaceOp)
  ): SurfaceClimb ! {div} {
    match k {
      Zero => SurfaceClimb { parsed: surface_sq_parsed(surface_out("fuel")), pieces: Nil, ops: Nil }
      Succ(j) => ⊢ SurfaceClimb from match pieces {
        Nil => SurfaceClimb {
          parsed: surface_sq_parsed(surface_out("sequence")),
          pieces: Nil,
          ops: ops
        }
        Cons(p, rest) => ⊢ SurfaceClimb from match p.loose {
          Cons(prefix, more) => surface_sq_prefixed(
            j,
            c,
            prefix,
            surface_sq_climb(
              j,
              c,
              row,
              surface_sq_prefix_level(prefix),
              Cons(SurfacePiece { term: p.term, paren: p.paren, loose: more, kind: p.kind }, rest),
              ops
            )
          )
          Nil => SurfaceClimb {
            parsed: SurfaceParsed { term: p.term, paren: p.paren, kind: p.kind, flat: 0 },
            pieces: rest,
            ops: ops
          }
        }
      }
    }
  }

  pub fn surface_sq_prefixed(
    k: Nat,
    c: SurfaceCtx,
    prefix: CstNode,
    inner: SurfaceClimb
  ): SurfaceClimb ! {div} {
    match k {
      Zero => inner
      Succ(j) => SurfaceClimb {
        parsed: surface_sq_parsed(
          ⊢ SurfaceTerm from match surface_is(prefix, "Binder") {
            true => surface_binder(j, c, prefix, surface_sq_finish(c, inner.parsed))
            false => surface_term_at(
              SkPi(
                Cons(SurfaceParam { name: None, ty: surface_sq_finish(c, inner.parsed), unused: None }, Nil),
                surface_var(
                  "False",
                  SurfaceSpan {
                    start: surface_span(c, prefix).start,
                    end: surface_sq_finish(c, inner.parsed).end
                  }
                ),
                None
              ),
              SurfaceSpan {
                start: surface_span(c, prefix).start,
                end: surface_sq_finish(c, inner.parsed).end
              }
            )
          }
        ),
        pieces: inner.pieces,
        ops: inner.ops
      }
    }
  }

  // `∀ x: A, y: B. P` is `∀ x: A. ∀ y: B. P`, one binder per name, the first outermost.
  // Binders are `BindName` (`[Caret] Ident`); the caret is not part of the name.
  pub fn surface_binder(k: Nat, c: SurfaceCtx, binder: CstNode, body: SurfaceTerm): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_binder_each(
        j,
        c,
        surface_quantifier(binder.flat, c),
        surface_span(c, binder).start,
        surface_filter_in(binder.flat, "BindName"),
        surface_filter_in(binder.flat, "Type"),
        body
      ) {
        None => surface_term_at(SkOther("Binder"), surface_span(c, binder))
        Some(t) => t
      }
    }
  }

  // The names bound in turn over `body`; `None` when names and domains do not pair up.
  pub fn surface_binder_each(
    k: Nat,
    c: SurfaceCtx,
    quantifier: Text,
    start: Nat,
    names: List(CstNode),
    domains: List(CstNode),
    body: SurfaceTerm
  ): Option(SurfaceTerm) ! {div} {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(SurfaceTerm) from match names {
        Nil => None
        Cons(b, more) => ⊢ Option(SurfaceTerm) from match domains {
          Nil => None
          Cons(d, rest) => {
            let binder := surface_bind_name(c, b)
            let binder_name := binder.fst
            let binder_unused := binder.snd
            ⊢ Option(SurfaceTerm) from match more {
              Nil => ⊢ Option(SurfaceTerm) from match rest {
                Nil => Some(surface_bound_term(
                  quantifier,
                  binder_name,
                  binder_unused,
                  surface_term(j, c, d),
                  body,
                  SurfaceSpan { start: start, end: body.end }
                ))
                Cons(^x, ^y) => None
              }
              Cons(^x, ^y) => ⊢ Option(SurfaceTerm) from match surface_binder_each(j, c, quantifier, start, more, rest, body) {
                None => None
                Some(inner) => Some(surface_bound_term(
                  quantifier,
                  binder_name,
                  binder_unused,
                  surface_term(j, c, d),
                  inner,
                  SurfaceSpan { start: start, end: body.end }
                ))
              }
            }
          }
        }
      }
    }
  }

  pub fn surface_sq_loop(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(RowEntry)),
    min: Nat,
    left: SurfaceClimb
  ): SurfaceClimb ! {div} {
    match k {
      Zero => left
      Succ(j) => ⊢ SurfaceClimb from match left.ops {
        Nil => left
        Cons(op, rest) => ⊢ SurfaceClimb from match surface_sq_level(op.sign) < min {
          true => left
          false => surface_sq_after(
            j,
            c,
            row,
            min,
            left,
            op,
            rest,
            surface_sq_climb(j, c, row, surface_sq_next(op.sign), left.pieces, rest)
          )
        }
      }
    }
  }

  pub fn surface_sq_after(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(RowEntry)),
    min: Nat,
    left: SurfaceClimb,
    op: SurfaceOp,
    rest: List(SurfaceOp),
    right: SurfaceClimb
  ): SurfaceClimb ! {div} {
    match k {
      Zero => left
      Succ(j) => ⊢ SurfaceClimb from match surface_sq_chained(op, right.ops) {
        true => surface_sq_chain_error(
          op,
          surface_sq_combine(
            j,
            c,
            row,
            left.parsed,
            op,
            right.parsed,
            not(surface_sq_has_arrow(rest))
          ),
          right.ops
        )
        false => surface_sq_loop(
          j,
          c,
          row,
          min,
          SurfaceClimb {
            parsed: surface_sq_combine(
              j,
              c,
              row,
              left.parsed,
              op,
              right.parsed,
              not(surface_sq_has_arrow(rest))
            ),
            pieces: right.pieces,
            ops: right.ops
          }
        )
      }
    }
  }

  // `lhs op rhs`; `last` says no `->` follows, so the row after the sequence is this arrow's.
  pub fn surface_sq_combine(
    k: Nat,
    c: SurfaceCtx,
    row: Option(List(RowEntry)),
    lhs: SurfaceParsed,
    op: SurfaceOp,
    rhs: SurfaceParsed,
    last: Bool
  ): SurfaceParsed ! {div} {
    match k {
      Zero => lhs
      Succ(j) => ⊢ SurfaceParsed from match op.sign == "->" {
        true => surface_sq_pi(
          c,
          lhs.kind,
          surface_sq_arrow_params(j, c, lhs),
          surface_sq_finish(c, rhs),
          lhs.term.start,
          surface_sq_row_for(last, row)
        )
        false => surface_sq_binary(
          op.sign,
          surface_sq_finish(c, lhs),
          rhs.flat,
          surface_sq_finish(c, rhs)
        )
      }
    }
  }

  // The parameters `(x: A, y: &B) -> C` names: a parenthesized left is read as a parameter list, any other
  // left is the one parameter, unnamed.
  pub fn surface_sq_arrow_params(k: Nat, c: SurfaceCtx, lhs: SurfaceParsed): List(SurfaceParam) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceParam) from match lhs.paren {
        Some(paren) => surface_fn_type_items(j, c, surface_all(paren, "Item"))
        None => Cons(surface_param_of(lhs.term), Nil)
      }
    }
  }

  pub fn surface_angle(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_is(n, "GenericKind") {
        true => ⊢ SurfaceTerm from match surface_first(n, "AngleType") {
          Some(inner) => surface_angle(j, c, inner)
          None => surface_other(c, n)
        }
        false => ⊢ SurfaceTerm from match surface_first(n, "Postfix") {
          None => surface_other(c, n)
          Some(head) => {
            // `A × B × C`: the members in the order written.
            let members := surface_map_terms(
              j,
              c,
              List::append(
                ⊢ List(CstNode) from match surface_all(n, "Postfix") {
                  Nil => Nil
                  Cons(^first, after) => after
                },
                surface_angle_list_members(j, surface_first(n, "AngleTypeList"))
              )
            )
            let lhs := ⊢ SurfaceTerm from match members {
              Nil => surface_term(j, c, head)
              Cons(^m, ^ms) => surface_pairs(
                surface_pair_name(),
                Cons(surface_term(j, c, head), members),
                surface_last_end(members, surface_span(c, n).end)
              )
            }
            ⊢ SurfaceTerm from match surface_first(n, "AngleType") {
              None => lhs
              Some(rest) => surface_term_at(
                SkPi(
                  ⊢ List(SurfaceParam) from match members {
                    Cons(^m, ^ms) => Cons(surface_param_of(lhs), Nil)
                    Nil => ⊢ List(SurfaceParam) from match surface_sole_paren(j, head) {
                      Some(paren) => surface_fn_type_items(j, c, surface_all(paren, "Item"))
                      None => Cons(surface_param_of(lhs), Nil)
                    }
                  },
                  surface_angle(j, c, rest),
                  None
                ),
                surface_span(c, n)
              )
            }
          }
        }
      }
    }
  }

  // The `Postfix` members of an `AngleTypeList` and of the lists it holds.
  pub fn surface_angle_list_members(k: Nat, list: Option(CstNode)): List(CstNode) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(CstNode) from match list {
        None => Nil
        Some(l) => List::append(
          surface_all(l, "Postfix"),
          surface_angle_list_members(j, surface_first(l, "AngleTypeList"))
        )
      }
    }
  }

  pub fn surface_fn_type_items(k: Nat, c: SurfaceCtx, items: List(CstNode)): List(SurfaceParam) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceParam) from match items {
        Nil => Nil
        Cons(item, rest) => Cons(
          surface_fn_type_item(j, c, item),
          surface_fn_type_items(j, c, rest)
        )
      }
    }
  }

  pub fn surface_fn_type_item(k: Nat, c: SurfaceCtx, item: CstNode): SurfaceParam ! {div} {
    match k {
      Zero => surface_param_of(surface_out("fuel"))
      Succ(j) => ⊢ SurfaceParam from match surface_first(item, "Caret") {
        Some(caret) => ⊢ SurfaceParam from match surface_first(item, "Ident") {
          None => surface_param_of(surface_term(j, c, item))
          Some(i) => {
            let ty := ⊢ SurfaceTerm from match surface_ty(item) {
              None => surface_out("Type")
              Some(t) => surface_term(j, c, t)
            }
            SurfaceParam {
              name: Some(
                surface_unraw(
                  surface_trim(c, Text::slice_or_empty(c.source, i.start, i.end))
                )
              ),
              ty: ty,
              unused: Some(surface_span(c, caret))
            }
          }
        }
        None => ⊢ SurfaceParam from match surface_first(item, "Expr") {
          None => surface_param_of(surface_term(j, c, item))
          Some(name) => ⊢ SurfaceParam from match surface_ty(item) {
            None => surface_param_of(surface_term(j, c, item))
            Some(ty) => surface_typed_param(surface_term(j, c, name), surface_term(j, c, ty))
          }
        }
      }
    }
  }

  pub fn surface_expr(k: Nat, c: SurfaceCtx, kids: List(CstNode), span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_expr_parts(kids) {
        Nil => surface_term_at(SkOther("Expr"), span)
        // `=> fn a, theorem b` is read where a macro call statement or `decreasing_by` is.
        Cons(lhs, rest) => ⊢ SurfaceTerm from match surface_find_in(rest, "Generated") {
          Some(^g) => surface_term_at(SkOther("a list of generated declarations"), span)
          None => ⊢ SurfaceTerm from match rest {
            Nil => surface_term(j, c, lhs)
            Cons(rhs, more) => ⊢ SurfaceTerm from match more {
              Nil => ⊢ SurfaceTerm from match surface_lambda_params(j, c, lhs) {
                None => surface_term_at(SkOther("Expr"), span)
                Some(ps) => {
                  let written := surface_lambda_types(j, c, lhs)
                  let types := surface_unborrowed_all(written)
                  surface_typed_lambda(
                    c,
                    types,
                    surface_lambda_of(
                      surface_params_typed(ps, written),
                      types,
                      surface_term(j, c, rhs),
                      span
                    ),
                    span
                  )
                }
              }
              Cons(^x, ^y) => surface_term_at(SkOther("Expr"), span)
            }
          }
        }
      }
    }
  }

  // The types written on the parameters of `(a: A, b) => …`, `?#untyped`
  // for one written without.
  // What a closure's parameters are read from: `()` names none, `(x, y)` each item,
  // a parenthesized list being no term of its own, `^x` / `(^x: T)` a marked
  // binder, and any other left the one.
  pub fn surface_lambda_params(k: Nat, c: SurfaceCtx, lhs: CstNode): Option(List(SurfaceLamParam)) ! {div} {
    match surface_sole_paren(c.fuel, lhs) {
      None => surface_params(Cons(surface_term(k, c, lhs), Nil))
      Some(paren) => ⊢ Option(List(SurfaceLamParam)) from match surface_filter_in(
        paren.flat,
        "Item"
      ) {
        Nil => Some(Nil)
        Cons(only, rest) => if surface_has(paren.flat, "Comma") || surface_items_have_caret(k,
          Cons(only, rest)
        ) {
          surface_item_lam_params(k, c, Cons(only, rest))
        } else {
          surface_params(Cons(surface_term(k, c, lhs), Nil))
        }
      }
    }
  }

  pub fn surface_items_have_caret(k: Nat, items: List(CstNode)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match items {
        Nil => false
        Cons(item, rest) => ⊢ Bool from match surface_first(item, "Caret") {
          Some(_) => true
          None => surface_items_have_caret(j, rest)
        }
      }
    }
  }

  pub fn surface_item_lam_params(
    k: Nat,
    c: SurfaceCtx,
    items: List(CstNode)
  ): Option(List(SurfaceLamParam)) ! {div} {
    match items {
      Nil => Some(Nil)
      Cons(item, rest) => ⊢ Option(List(SurfaceLamParam)) from match surface_item_lam_param(
        k,
        c,
        item
      ) {
        None => None
        Some(p) => ⊢ Option(List(SurfaceLamParam)) from match surface_item_lam_params(
          k,
          c,
          rest
        ) {
          None => None
          Some(ps) => Some(Cons(p, ps))
        }
      }
    }
  }

  // `Item`: `^x`, `^x: T`, or an ordinary expression / typed item.
  pub fn surface_item_lam_param(k: Nat, c: SurfaceCtx, item: CstNode): Option(SurfaceLamParam) ! {div} {
    match surface_first(item, "Caret") {
      Some(caret) => ⊢ Option(SurfaceLamParam) from match surface_first(item, "Ident") {
        None => None
        Some(i) => Some(SurfaceLamParam {
          name: surface_unraw(
            surface_trim(c, Text::slice_or_empty(c.source, i.start, i.end))
          ),
          r#borrow: None,
          unused: Some(surface_span(c, caret))
        })
      }
      None => surface_lam_param_of(surface_term(k, c, item))
    }
  }

  pub fn surface_lambda_args(k: Nat, c: SurfaceCtx, lhs: CstNode): List(SurfaceTerm) ! {div} {
    match surface_sole_paren(c.fuel, lhs) {
      None => Cons(surface_term(k, c, lhs), Nil)
      Some(paren) => ⊢ List(SurfaceTerm) from match surface_filter_in(paren.flat, "Item") {
        Nil => Nil
        Cons(only, rest) => if surface_has(paren.flat, "Comma") {
          surface_map_terms(k, c, Cons(only, rest))
        } else {
          Cons(surface_term(k, c, lhs), Nil)
        }
      }
    }
  }

  pub fn surface_lambda_types(k: Nat, c: SurfaceCtx, lhs: CstNode): List(SurfaceTerm) ! {div} {
    match surface_sole_paren(c.fuel, lhs) {
      None => Nil
      Some(paren) => surface_lam_types(k, c, surface_filter_in(paren.flat, "Item"))
    }
  }

  pub fn surface_lam_types(k: Nat, c: SurfaceCtx, items: List(CstNode)): List(SurfaceTerm) ! {div} {
    match items {
      Nil => Nil
      Cons(item, rest) => Cons(
        ⊢ SurfaceTerm from match surface_ty(item) {
          None => surface_term_at(SkHole("#untyped"), surface_span(c, item))
          Some(ty) => surface_term(k, c, ty)
        },
        surface_lam_types(k, c, rest)
      )
    }
  }

  pub fn surface_postfix(
    k: Nat,
    c: SurfaceCtx,
    kids: List(CstNode),
    span: SurfaceSpan
  ): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match kids {
        Nil => surface_term_at(SkOther("Postfix"), span)
        Cons(primary, ops) => surface_postfix_ops(j, c, ops, surface_term(j, c, primary))
      }
    }
  }

  pub fn surface_postfix_ops(
    k: Nat,
    c: SurfaceCtx,
    ops: List(CstNode),
    acc: SurfaceTerm
  ): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match ops {
        Nil => ⊢ SurfaceTerm from match surface_member_pending(acc) {
          Some(^fields) => surface_term_at(SkOther(surface_class_member_not_called()), surface_span_of(acc))
          None => acc
        }
        Cons(op, rest) => ⊢ SurfaceTerm from match surface_nth(op.flat, 0) {
          None => surface_postfix_ops(j, c, rest, acc)
          Some(inner) => surface_postfix_ops(
            j,
            c,
            rest,
            surface_postfix_op(j, c, inner, acc, surface_span_from(acc, surface_span(c, op).end))
          )
        }
      }
    }
  }

  pub fn surface_postfix_op(
    k: Nat,
    c: SurfaceCtx,
    inner: CstNode,
    acc: SurfaceTerm,
    span: SurfaceSpan
  ): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_is(inner, "Call") {
        true => ⊢ SurfaceTerm from match surface_member_pending(acc) {
          None => surface_term_at(
            SkApp(
              acc,
              List::append(
                surface_call_implicits(j, c, surface_first(inner, "CallImplicits")),
                surface_map_terms(j, c, surface_all(inner, "Item"))
              )
            ),
            span
          )
          // `C(T)::m(…)`: the class's arguments lead the implicit record.
          Some(fields) => surface_term_at(
            SkApp(
              surface_member_head(acc),
              Cons(
                surface_term_at(
                  SkRecord(
                    "@implicits",
                    List::append(fields, surface_implicit_fields_of(j, c, surface_first(inner, "CallImplicits")))
                  ),
                  surface_implicits_span(c, surface_first(inner, "CallImplicits"), span)
                ),
                surface_map_terms(j, c, surface_all(inner, "Item"))
              )
            ),
            span
          )
        }
        false => ⊢ SurfaceTerm from match surface_member_pending(acc) {
          Some(^fields) => surface_term_at(SkOther(surface_class_member_not_called()), span)
          None => ⊢ SurfaceTerm from match surface_is(inner, "Member") {
            true => surface_member(acc, surface_member_name(surface_strip(c, surface_text(c, inner))), span)
            false => ⊢ SurfaceTerm from match surface_is(inner, "Field") {
              true => surface_term_at(SkField(acc, surface_label(c, inner)), span)
              false => surface_term_at(SkOther(surface_kind_name(inner)), span)
            }
          }
        }
      }
    }
  }

  pub fn surface_implicit_fields_of(k: Nat, c: SurfaceCtx, list: Option(CstNode)): List(SurfaceField) ! {div} {
    match list {
      None => Nil
      Some(l) => surface_implicit_fields(k, c, surface_all(l, "CallImplicit"))
    }
  }

  pub fn surface_path(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_only_names(n.flat) {
        // A hole `$r#name` or `${name}` is `$name`, as in an `Ident`.
        true => ⊢ SurfaceTerm from match surface_unhole(surface_strip(c, surface_text(c, n))) {
          Some(hole) => surface_var(hole, span)
          None => surface_var(surface_strip(c, surface_unraw(surface_text(c, n))), span)
        }
        false => ⊢ SurfaceTerm from match surface_first(n, "RecordBody") {
          None => surface_other(c, n)
          Some(body) => surface_term_at(
            SkRecord(
              Text::concat_all(surface_path_parts(c, n.flat)),
              List::append(
                surface_fields(
                  j,
                  c,
                  surface_items(c, body.flat, "FieldInit", "RecordTail", "RecordTail")
                ),
                surface_record_base(
                  j,
                  c,
                  surface_items(c, body.flat, "RecordBase", "RecordTail", "RecordTail")
                )
              )
            ),
            span
          )
        }
      }
    }
  }

  // `..b` after a record's fields: a last field named `..`, as the Rust
  // reader prints it.
  pub fn surface_record_base(k: Nat, c: SurfaceCtx, bases: List(CstNode)): List(SurfaceField) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceField) from match bases {
        Nil => Nil
        Cons(b, ^rest) => Cons(
          SurfaceField { name: "..", value: surface_term_of(j, c, surface_first(b, "Expr"), b) },
          Nil
        )
      }
    }
  }

  // `f(<x: v>, h)`: the implicit arguments named, carried first as a record of the
  // internal name `@implicits` that the elaborator places by the generics' names.
  pub fn surface_call_implicits(k: Nat, c: SurfaceCtx, list: Option(CstNode)): List(SurfaceTerm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceTerm) from match list {
        None => Nil
        Some(l) => [
          surface_term_at(
            SkRecord("@implicits", surface_implicit_fields(j, c, surface_all(l, "CallImplicit"))),
            surface_span(c, l)
          )
        ]
      }
    }
  }

  pub fn surface_implicit_fields(k: Nat, c: SurfaceCtx, items: List(CstNode)): List(SurfaceField) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceField) from match items {
        Nil => Nil
        Cons(f, rest) => Cons(
          SurfaceField {
            name: surface_label(c, f),
            value: surface_term_of(j, c, surface_first(f, "AngleExpr"), f)
          },
          surface_implicit_fields(j, c, rest)
        )
      }
    }
  }

  pub fn surface_fields(k: Nat, c: SurfaceCtx, inits: List(CstNode)): List(SurfaceField) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceField) from match inits {
        Nil => Nil
        Cons(f, rest) => Cons(
          SurfaceField {
            name: surface_label(c, f),
            value: surface_term_of(j, c, surface_first(f, "Expr"), f)
          },
          surface_fields(j, c, rest)
        )
      }
    }
  }

  pub fn surface_if(k: Nat, c: SurfaceCtx, kids: List(CstNode), span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_find_in(kids, "Cond") {
        None => surface_term_at(SkOther("IfExpr"), span)
        Some(cond) => ⊢ SurfaceTerm from match surface_find_in(kids, "Block") {
          None => surface_term_at(SkOther("IfExpr"), span)
          Some(then) => surface_term_at(
            SkIf(
              surface_term(j, c, cond),
              surface_term(j, c, then),
              surface_opt_term(j, c, surface_else(kids))
            ),
            span
          )
        }
      }
    }
  }

  pub fn surface_block_stmts(k: Nat, c: SurfaceCtx, stmts: Option(CstNode)): List(SurfaceStmt) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceStmt) from match stmts {
        Some(s) => surface_read_stmts(
          j,
          c,
          surface_items(c, s.flat, "Stmt", "StmtsTail", "StmtsTail")
        )
        None => Nil
      }
    }
  }

  // The statements of a program or a module: before an `extern` block, the
  // structs of the types it declares.
  fn surface_item_stmts(k: Nat, c: SurfaceCtx, stmts: Option(CstNode)): List(SurfaceStmt) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceStmt) from match stmts {
        Some(s) => surface_read_items(
          j,
          c,
          surface_items(c, s.flat, "Stmt", "StmtsTail", "StmtsTail")
        )
        None => Nil
      }
    }
  }

  fn surface_read_items(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceStmt) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceStmt) from match nodes {
        Nil => Nil
        Cons(s, rest) => ⊢ List(SurfaceStmt) from match surface_stmt(j, c, s) {
          StExtern(fns, instances, types, structs, enums, start, end) => List::append(
            surface_extern_structs_as_stmts(types),
            List::append(
              surface_extern_structs_as_stmts(structs),
              List::append(
                surface_extern_enums_as_stmts(enums),
                Cons(
                  StExtern(fns, instances, types, structs, enums, start, end),
                  surface_read_items(j, c, rest)
                )
              )
            )
          )
          StFn(f) => ⊢ List(SurfaceStmt) from match surface_is_macro_fn(s) {
            true => Cons(
              StFn(f),
              Cons(
                StMacro(f.name, f.name, surface_span(c, s).start, surface_span(c, s).end),
                surface_read_items(j, c, rest)
              )
            )
            false => Cons(StFn(f), surface_read_items(j, c, rest))
          }
          other => Cons(other, surface_read_items(j, c, rest))
        }
      }
    }
  }

  // The statements of a block. A `let` with a pattern is the `match` of its
  // value with that one arm, whose body is the statements after it, so the
  // elaborator sees the `match` written by hand.
  pub fn surface_read_stmts(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceStmt) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceStmt) from match nodes {
        Nil => Nil
        Cons(s, rest) => ⊢ List(SurfaceStmt) from match surface_pattern_let(s) {
          None => Cons(surface_stmt(j, c, s), surface_read_stmts(j, c, rest))
          Some(decl) => Cons(StExpr(surface_let_match(j, c, decl, surface_last_stmt_end(c, s, rest), rest)), Nil)
        }
      }
    }
  }

  // `let P := e` followed by `rest`: `match e { P => rest }`, spanning to `end`.
  pub fn surface_let_match(k: Nat, c: SurfaceCtx, decl: CstNode, end: Nat, rest: List(CstNode)): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => {
        let span := SurfaceSpan { start: surface_span(c, decl).start, end: end }
        let value := surface_term_of(j, c, surface_first(decl, "Expr"), decl)
        // `let P: T := e`: the scrutinee's type, as `match e: T` writes it.
        let scrutinee := ⊢ SurfaceTerm from match surface_ty(decl) {
          None => value
          Some(t) => surface_term_at(SkAscribe(value, surface_term(j, c, t)), surface_span(c, decl))
        }
        let pattern := ⊢ SurfacePattern from match surface_first(decl, "LetPattern") {
          Some(p) => surface_pattern_alt(j, c, p)
          None => surface_path_pattern(j, c, decl)
        }
        surface_term_at(
          SkMatch(
            scrutinee,
            None,
            Cons(
              SurfaceArm {
                pattern: pattern,
                guard: None,
                goal: None,
                body: surface_block_of(surface_read_stmts(j, c, rest), span)
              },
              Nil
            ),
            None,
            None
          ),
          span
        )
      }
    }
  }

  // Statements read one by one, as a quotation holds them.
  pub fn surface_read_plain_stmts(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceStmt) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceStmt) from match nodes {
        Nil => Nil
        Cons(s, rest) => Cons(surface_stmt(j, c, s), surface_read_plain_stmts(j, c, rest))
      }
    }
  }

  pub fn surface_quote_stmts(k: Nat, c: SurfaceCtx, stmts: Option(CstNode)): List(SurfaceStmt) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceStmt) from match stmts {
        Some(s) => surface_read_plain_stmts(
          j,
          c,
          surface_items(c, s.flat, "Stmt", "StmtsTail", "StmtsTail")
        )
        None => Nil
      }
    }
  }

  pub fn surface_stmt(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceStmt ! {div} {
    match k {
      Zero => surface_out_stmt("fuel")
      Succ(j) => surface_attributed(j, c, surface_all(n, "Attribute"), n)
    }
  }

  // `@name!(arg) stmt`, each attribute on its own line, with the list after
  // `=>` of what the macro makes besides the declaration. Attributes written one
  // after another nest, the first written outermost, around the declaration as written.
  pub fn surface_attributed(k: Nat, c: SurfaceCtx, attrs: List(CstNode), n: CstNode): SurfaceStmt ! {div} {
    match k {
      Zero => surface_out_stmt("fuel")
      Succ(j) => ⊢ SurfaceStmt from match attrs {
        Nil => surface_plain_stmt(j, c, n)
        Cons(attr, rest) => ⊢ SurfaceStmt from match surface_first(attr, "MacroCall") {
          None => StOther("Attribute", surface_span(c, n).start, surface_span(c, n).end)
          Some(call) => ⊢ SurfaceStmt from match surface_term(j, c, call).kind {
            SkMacroCall(name, arg) => StAttributed(
              name,
              arg,
              surface_attr_generates(c, surface_first(attr, "AttrGenerates")),
              surface_attributed(j, c, rest, n)
            )
            _ => StOther("Attribute", surface_span(c, n).start, surface_span(c, n).end)
          }
        }
      }
    }
  }

  pub fn surface_plain_stmt(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceStmt ! {div} {
    match k {
      Zero => surface_out_stmt("fuel")
      Succ(j) => ⊢ SurfaceStmt from match surface_first(n, "OtherStmt") {
        None => StOther("Stmt", surface_span(c, n).start, surface_span(c, n).end)
        Some(other) => ⊢ SurfaceStmt from match surface_nth(other.flat, 0) {
          None => StOther("OtherStmt", surface_span(c, n).start, surface_span(c, n).end)
          Some(inner) => ⊢ SurfaceStmt from match surface_reexport(c, surface_first(n, "Visibility"), inner) {
            Some(reexport) => reexport
            None => surface_visible(
              c,
              surface_first(n, "Visibility"),
              surface_stmt_of(j, c, inner, surface_span(c, n))
            )
          }
        }
      }
    }
  }

  // `loop { B }` is the block `{ loop { B } }` over the whole expression.
  pub fn surface_loop(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(n, "Block") {
        None => surface_other(c, n)
        Some(b) => surface_term_at(
          SkBlock(Cons(StLoop(surface_term(j, c, b), surface_span(c, n).start, surface_span(c, n).end), Nil)),
          surface_span(c, n)
        )
      }
    }
  }

  pub fn surface_stmt_of(k: Nat, c: SurfaceCtx, inner: CstNode, span: SurfaceSpan): SurfaceStmt ! {div} {
    match k {
      Zero => surface_out_stmt("fuel")
      Succ(j) => ⊢ SurfaceStmt from match inner.terminal {
        true => StOther("token", span.start, span.end)
        false => ⊢ SurfaceStmt from match surface_rule(inner.name) {
          RuleLetDecl => ⊢ SurfaceStmt from match surface_let_is_pattern(inner) {
            true => StOther("let pattern", span.start, span.end)
            false => {
              let bind := surface_bind_name_of(c, inner)
              let name := ⊢ Text from match bind {
                Some(pair) => pair.fst
                None => surface_ident(c, inner)
              }
              let unused := ⊢ Option(SurfaceSpan) from match bind {
                Some(pair) => pair.snd
                None => None
              }
              StLet(
                name,
                surface_opt_term(j, c, surface_ty(inner)),
                surface_term_of(j, c, surface_first(inner, "Expr"), inner),
                surface_has(inner.flat, "Borrow"),
                surface_is_mut(surface_first(inner, "Borrow")),
                unused,
                surface_let_props(c, inner)
              )
            }
          }
          RuleVarDecl => {
            let bind := surface_bind_name_of(c, inner)
            let name := ⊢ Text from match bind {
              Some(pair) => pair.fst
              None => surface_ident(c, inner)
            }
            let unused := ⊢ Option(SurfaceSpan) from match bind {
              Some(pair) => pair.snd
              None => None
            }
            StVar(
              name,
              surface_var_type(surface_opt_term(j, c, surface_ty(inner))),
              surface_term_of(j, c, surface_first(inner, "Expr"), inner),
              surface_has(inner.flat, "Amp"),
              unused,
              surface_let_props(c, inner)
            )
          }
          RuleFnDecl => StFn(surface_fn_decl(j, c, inner))
          RuleTheoremDecl => StTheorem(surface_theorem_decl(j, c, inner, span))
          RuleAxiomDecl => StTheorem(surface_theorem_decl(j, c, inner, span))
          RuleDefDecl => StDef(surface_def_decl(j, c, inner, span))
          RuleMutualDecl => StMutual(
            surface_mutual_items(
              j,
              c,
              surface_items(c, inner.flat, "MutualItem", "MutualItems", "MutualTail")
            ),
            span.start,
            span.end
          )
          RuleImportDecl => StImport(surface_import_path(c, inner), span.start, span.end)
          RuleSyntaxDecl => StSyntax(
            surface_name_of(c, surface_nth(surface_descend(c, inner, "Ident"), 0)),
            surface_grammar(c, inner),
            span.start,
            span.end
          )
          RuleMacroFnDecl => ⊢ SurfaceStmt from match surface_first(inner, "FnDecl") {
            Some(decl) => StFn(surface_fn_decl(j, c, decl))
            None => StOther("macro fn", span.start, span.end)
          }
          RuleInductiveDecl => StInductive(surface_inductive_decl(j, c, inner, span))
          RuleEffectDecl => StEffect(surface_effect_decl(j, c, inner))
          RuleStructDecl => StStruct(surface_struct_decl(j, c, inner))
          RuleEnumDecl => StEnum(surface_enum_decl(j, c, inner))
          RuleExternDecl => StExtern(
            surface_extern_fn_items(j, c, surface_descend(c, inner, "ExternFnItem")),
            surface_extern_instances(j, c, surface_descend(c, inner, "ExternInstance")),
            surface_extern_types(c, surface_descend(c, inner, "ExternType")),
            surface_extern_struct_items(j, c, surface_descend(c, inner, "ExternStructItem")),
            surface_extern_enum_items(j, c, surface_descend(c, inner, "ExternEnumItem")),
            span.start,
            span.end
          )
          RuleClassDecl => StClass(
            SurfaceClass {
              visibility: VisPrivate,
              name: surface_ident(c, inner),
              param: surface_head_or_empty(surface_generic_bounds(c, inner).names),
              arity: List::length(surface_generic_bounds(c, inner).names),
              bound: surface_first_bound(surface_generic_bounds(c, inner).bounds),
              methods: surface_extern_fns(j, c, surface_descend(c, inner, "ExternFn")),
              laws: surface_laws(j, c, surface_descend(c, inner, "LawDecl")),
              start: span.start,
              end: span.end,
              parameters: surface_generics(j, c, inner),
              proof_side: surface_has(inner.flat, "KwInductive"),
              parents: surface_wheres(j, c, surface_first(inner, "WhereClause")),
              unused_parameters: surface_generic_unused_spans(c, inner)
            }
          )
          RuleInstanceDecl => StInstance(
            SurfaceInstance {
              generics: surface_generic_bounds(c, inner).names,
              bounds: surface_generic_bounds(c, inner).bounds,
              r#class: surface_ident(c, inner),
              head: surface_term_of(j, c, surface_ty(inner), inner),
              wheres: surface_wheres(j, c, surface_first(inner, "WhereClause")),
              methods: surface_extern_fns(j, c, surface_descend(c, inner, "FnDecl")),
              laws: surface_laws(j, c, surface_descend(c, inner, "LawDecl")),
              start: span.start,
              end: span.end,
              generic_types: surface_named_types(surface_generics(j, c, inner)),
              arguments: surface_tail_types(j, c, inner),
              infer_from: surface_infer_from(j, c, surface_first(inner, "InferFrom")),
              unused_generics: surface_generic_unused_spans(c, inner)
            }
          )
          RuleWhileStmt => StWhile(
            surface_term_of(j, c, surface_first(inner, "Cond"), inner),
            surface_term_of(j, c, surface_first(inner, "Block"), inner)
          )
          RuleReturnStmt => StReturn(surface_opt_term(j, c, surface_first(inner, "Expr")))
          RuleExprStmt => surface_expr_stmt(j, c, surface_all(inner, "Expr"), span)
          _ => if inner.name == "ModuleDecl" {
            StModule(
              surface_ident(c, inner),
              VisPrivate,
              ⊢ List(SurfaceStmt) from match surface_block_list(surface_first(inner, "Block")) {
                None => Nil
                Some(stmts) => surface_read_items(j, c, surface_items(c, stmts.flat, "Stmt", "StmtsTail", "StmtsTail"))
              },
              span.start,
              span.end
            )
          } else { if inner.name == "ForStmt" {
            StFor(
              ⊢ SurfacePattern from match surface_first(inner, "PatternAlt") {
                Some(p) => surface_pattern_alt(j, c, p)
                None => PtOther("for")
              },
              surface_term_of(j, c, surface_first(inner, "Cond"), inner),
              surface_term_of(j, c, surface_first(inner, "Block"), inner),
              span.start,
              span.end
            )
          } else { if inner.name == "BreakStmt" {
            StBreak(surface_opt_term(j, c, surface_first(inner, "Expr")), span.start, span.end)
          } else {
            if inner.name == "ContinueStmt" { StContinue(span.start, span.end) } else { StOther(inner.name, span.start, span.end) }
          }
          }
          }
        }
      }
    }
  }

  pub fn surface_expr_stmt(
    k: Nat,
    c: SurfaceCtx,
    exprs: List(CstNode),
    span: SurfaceSpan
  ): SurfaceStmt ! {div} {
    match k {
      Zero => surface_out_stmt("fuel")
      Succ(j) => ⊢ SurfaceStmt from match exprs {
        Nil => StOther("ExprStmt", span.start, span.end)
        Cons(first, rest) => ⊢ SurfaceStmt from match rest {
          Nil => ⊢ SurfaceStmt from match surface_first(first, "Generated") {
            None => StExpr(surface_term(j, c, first))
            Some(^g) => StCalled(
              surface_generated(c, surface_all(first, "Generated")),
              surface_term_of(j, c, surface_first(first, "Seq"), first)
            )
          }
          Cons(value, more) => ⊢ SurfaceStmt from match more {
            Cons(^x, ^y) => StOther("ExprStmt", span.start, span.end)
            Nil => surface_assign(surface_term(j, c, first), surface_term(j, c, value), span)
          }
        }
      }
    }
  }

  pub fn surface_extern_fns(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceFn) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceFn) from match nodes {
        Nil => Nil
        Cons(f, rest) => Cons(surface_fn_decl(j, c, f), surface_extern_fns(j, c, rest))
      }
    }
  }

  pub fn surface_mutual_items(k: Nat, c: SurfaceCtx, items: List(CstNode)): List(SurfaceStmt) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceStmt) from match items {
        Nil => Nil
        Cons(item, rest) => ⊢ List(SurfaceStmt) from match surface_mutual_decl(item) {
          None => surface_mutual_items(j, c, rest)
          Some(decl) => ⊢ List(SurfaceStmt) from match surface_is(decl, "InductiveDecl") {
            true => Cons(
              surface_visible(
                c,
                surface_first(item, "Visibility"),
                StInductive(surface_inductive_decl(j, c, decl, surface_span(c, decl)))
              ),
              surface_mutual_items(j, c, rest)
            )
            false => ⊢ List(SurfaceStmt) from match surface_is(decl, "FnDecl") {
              true => Cons(
                surface_visible(
                  c,
                  surface_first(item, "Visibility"),
                  StFn(surface_fn_decl(j, c, decl))
                ),
                surface_mutual_items(j, c, rest)
              )
              false => ⊢ List(SurfaceStmt) from match surface_is(decl, "TheoremDecl") {
                true => Cons(
                  surface_visible(
                    c,
                    surface_first(item, "Visibility"),
                    StTheorem(surface_theorem_decl(j, c, decl, surface_span(c, decl)))
                  ),
                  surface_mutual_items(j, c, rest)
                )
                false => surface_mutual_items(j, c, rest)
              }
            }
          }
        }
      }
    }
  }

  pub fn surface_param_types(
    k: Nat,
    c: SurfaceCtx,
    params: List(CstNode)
  ): List(Option(SurfaceTerm)) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(Option(SurfaceTerm)) from match params {
        Nil => Nil
        Cons(p, rest) => Cons(
          surface_opt_term(j, c, surface_ty(p)),
          surface_param_types(j, c, rest)
        )
      }
    }
  }

  pub fn surface_fn_result(k: Nat, c: SurfaceCtx, result: Option(CstNode)): Option(SurfaceTerm) ! {div} {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(SurfaceTerm) from match result {
        None => None
        Some(r) => ⊢ Option(SurfaceTerm) from match surface_first(r, "BodyType") {
          Some(t) => Some(surface_sequence(j, c, t).term)
          None => None
        }
      }
    }
  }

  // An entry of a row or of a set's members: the effect's name, applied to
  // the terms of its type arguments when it has them.
  pub fn surface_row_entry(k: Nat, c: SurfaceCtx, n: CstNode): Option(RowEntry) ! {div} {
    match surface_first(n, "Ident") {
      None => None
      Some(i) => {
        let name := surface_text(c, i)
        let unused := ⊢ Option(SurfaceSpan) from match surface_first(n, "Caret") {
          Some(caret) => Some(surface_span(c, caret))
          None => None
        }
        let forall := surface_first(n, "EffectForall")
        let universal := ⊢ Bool from match forall {
          Some(^f) => true
          None => false
        }
        ⊢ Option(RowEntry) from match surface_first(n, "TypeCall") {
          Some(args) => Some(
            EntryApplied(
              name,
              surface_row_args(k, c, surface_all(args, "TypeCallArg")),
              universal,
              surface_forall_names(c, forall),
              unused
            )
          )
          None => ⊢ Option(RowEntry) from match universal {
            true => Some(EntryApplied(name, Nil, true, surface_forall_names(c, forall), unused))
            false => Some(EntryName(name, unused))
          }
        }
      }
    }
  }

  // The terms of an entry's type arguments.
  pub fn surface_row_args(k: Nat, c: SurfaceCtx, args: List(CstNode)): List(SurfaceTerm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceTerm) from match args {
        Nil => Nil
        Cons(a, rest) => ⊢ List(SurfaceTerm) from match surface_first(a, "Expr") {
          Some(e) => Cons(surface_term_below(j, c, e), surface_row_args(j, c, rest))
          None => ⊢ List(SurfaceTerm) from match surface_first(a, "EffectRow") {
            Some(r) => Cons(surface_term_below(j, c, r), surface_row_args(j, c, rest))
            None => surface_row_args(j, c, rest)
          }
        }
      }
    }
  }

  pub fn surface_effect_names(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(RowEntry) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(RowEntry) from match nodes {
        Nil => Nil
        Cons(n, rest) => ⊢ List(RowEntry) from match surface_row_entry(j, c, n) {
          Some(e) => Cons(e, surface_effect_names(j, c, rest))
          None => surface_effect_names(j, c, rest)
        }
      }
    }
  }

  // The effects of the set literals `{A, B}` of a row's terms, each once.
  pub fn surface_row_lits(k: Nat, c: SurfaceCtx, terms: List(CstNode)): List(RowEntry) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(RowEntry) from match terms {
        Nil => Nil
        Cons(t, rest) => ⊢ List(RowEntry) from match surface_first(t, "EffectLit") {
          Some(lit) => row_append_new(
            surface_effect_names(j, c, surface_descend(c, lit, "EffectName")),
            surface_row_lits(j, c, rest)
          )
          None => surface_row_lits(j, c, rest)
        }
      }
    }
  }

  // The entries of an effect row, a set expression of literals `{A, B}` and row variables united
  // by `∪`; a row variable `e` is `|e`. The entries of an `effect` declaration's set are its names.
  pub fn surface_row_names(k: Nat, c: SurfaceCtx, row: CstNode): List(RowEntry) ! {div} {
    match surface_is(row, "EffectAlias") {
      true => surface_effect_names(k, c, surface_all(row, "EffectName"))
      false => ⊢ List(RowEntry) from match surface_first(row, "EffectSet") {
        Some(set) => List::append(
          surface_row_lits(k, c, surface_all(set, "EffectTerm")),
          surface_row_vars(c, surface_all(set, "EffectTerm"))
        )
        None => Nil
      }
    }
  }

  pub fn surface_opt_row_names(k: Nat, c: SurfaceCtx, row: Option(CstNode)): Option(List(RowEntry)) ! {div} {
    match row {
      Some(r) => Some(surface_row_names(k, c, r))
      None => None
    }
  }

  // The effects a set names (`effect Host { div, stdout }`), or `None` for an
  // effect with a signature.
  pub fn surface_effect_set(k: Nat, c: SurfaceCtx, decl: CstNode): Option(List(RowEntry)) ! {div} {
    match surface_first(decl, "EffectBody") {
      Some(b) => surface_opt_row_names(k, c, surface_first(b, "EffectAlias"))
      None => None
    }
  }

  pub fn surface_sq_row(k: Nat, c: SurfaceCtx, n: CstNode): Option(List(RowEntry)) ! {div} {
    surface_opt_row_names(k, c, surface_first(n, "EffectRow"))
  }

  // The effect row of a function: after its result, or inside it. A row after a function type
  // is that arrow's.
  pub fn surface_fn_effects(k: Nat, c: SurfaceCtx, result: Option(CstNode)): Option(List(RowEntry)) ! {div} {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(List(RowEntry)) from match result {
        None => None
        Some(r) => ⊢ Option(List(RowEntry)) from match surface_find_deep(j, r.flat, "Question") {
          // `!?`: a row not written yet is no written row.
          Some(^q) => None
          None => ⊢ Option(List(RowEntry)) from match surface_first(r, "EffectRow") {
            Some(w) => Some(surface_row_names(j, c, w))
            None => ⊢ Option(List(RowEntry)) from match surface_first(r, "BodyType") {
              None => None
              Some(t) => surface_sequence(j, c, t).effects
            }
          }
        }
      }
    }
  }

  // Where the `!?` is, when the function's row is not written yet.
  pub fn surface_fn_row_hole(k: Nat, c: SurfaceCtx, result: Option(CstNode)): Option(SurfaceSpan) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(SurfaceSpan) from match result {
        None => None
        Some(r) => ⊢ Option(SurfaceSpan) from match surface_find_deep(j, r.flat, "Question") {
          // The row is the `!` and the `?`: the `EffectRow` that holds the `?`.
          Some(q) => ⊢ Option(SurfaceSpan) from match surface_find_deep(j, r.flat, "EffectRow") {
            Some(w) => Some(surface_span(c, w))
            None => Some(surface_span(c, q))
          }
          None => None
        }
      }
    }
  }

  pub fn surface_infer_or_tail(k: Nat, c: SurfaceCtx, acc: SurfaceInferCondition, nodes: List(CstNode)): SurfaceInferCondition {
    match k {
      Zero => acc
      Succ(j) => ⊢ SurfaceInferCondition from match nodes {
        Nil => acc
        Cons(node, rest) => surface_infer_or_tail(j, c, InferOr(acc, surface_infer_condition(j, c, node)), rest)
      }
    }
  }

  pub fn surface_infer_and_tail(k: Nat, c: SurfaceCtx, acc: SurfaceInferCondition, nodes: List(CstNode)): SurfaceInferCondition {
    match k {
      Zero => acc
      Succ(j) => ⊢ SurfaceInferCondition from match nodes {
        Nil => acc
        Cons(node, rest) => surface_infer_and_tail(j, c, InferAnd(acc, surface_infer_condition(j, c, node)), rest)
      }
    }
  }

  pub fn surface_infer_condition(k: Nat, c: SurfaceCtx, node: CstNode): SurfaceInferCondition {
    match k {
      Zero => InferParameter("")
      Succ(j) => if surface_is(node, "InferOr") {
        match surface_descend(c, node, "InferAnd") {
          Nil => InferParameter("")
          Cons(first, rest) => surface_infer_or_tail(j, c, surface_infer_condition(j, c, first), rest)
        }
      } else if surface_is(node, "InferAnd") {
        match surface_descend(c, node, "InferAtom") {
          Nil => InferParameter("")
          Cons(first, rest) => surface_infer_and_tail(j, c, surface_infer_condition(j, c, first), rest)
        }
      } else {
        match surface_first(node, "Ident") {
          Some(name) => InferParameter(surface_text(c, name))
          None => ⊢ SurfaceInferCondition from match surface_first(node, "InferOr") {
            Some(inner) => surface_infer_condition(j, c, inner)
            None => InferParameter("")
          }
        }
      }
    }
  }

  pub fn surface_infer_from(k: Nat, c: SurfaceCtx, node: Option(CstNode)): Option(SurfaceInferCondition) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(SurfaceInferCondition) from match node {
        None => None
        Some(clause) => ⊢ Option(SurfaceInferCondition) from match surface_first(clause, "InferOr") {
          None => None
          Some(condition) => Some(surface_infer_condition(j, c, condition))
        }
      }
    }
  }

  pub fn surface_fn_decl(k: Nat, c: SurfaceCtx, decl: CstNode): SurfaceFn ! {div} {
    match k {
      Zero => surface_out_fn()
      Succ(j) => SurfaceFn {
        name: surface_name_of(c, surface_first(decl, "FnName")),
        generics: surface_generic_bounds(c, decl).names,
        bounds: surface_generic_bounds(c, decl).bounds,
        params: surface_param_idents(c, surface_all(decl, "Param")),
        r#borrows: surface_decl_borrows(
          surface_param_borrow_flags(surface_all(decl, "Param")),
          surface_param_types(j, c, surface_all(decl, "Param"))
        ),
        param_types: surface_decl_types(
          surface_param_borrow_flags(surface_all(decl, "Param")),
          surface_param_types(j, c, surface_all(decl, "Param")),
          surface_spans_of(c, surface_all(decl, "Param"))
        ),
        result: surface_fn_result(j, c, surface_first(decl, "FnResult")),
        effects: surface_fn_effects(j, c, surface_first(decl, "FnResult")),
        wheres: surface_wheres(j, c, surface_first(decl, "WhereClause")),
        start: surface_span(c, decl).start,
        end: surface_span(c, decl).end,
        // An `extern` function or a class method has no block: its body is an
        // `Other` term of the declaration's kind (`ExternFn`), never run.
        body: surface_term_of(j, c, surface_first(decl, "Block"), decl),
        lends: surface_fn_lends(c, surface_first(decl, "FnBorrows")),
        generic_types: surface_named_types(surface_generics(j, c, decl)),
        bound_starts: surface_generic_starts(c, decl),
        visibility: VisPrivate,
        row_hole: surface_fn_row_hole(j, c, surface_first(decl, "FnResult")),
        unused: ⊢ Option(SurfaceSpan) from match surface_bind_name_of(c, decl) {
          None => None
          Some(pair) => pair.snd
        },
        unused_generics: surface_generic_unused_spans(c, decl),
        unused_params: surface_param_unused_spans(c, surface_all(decl, "Param"))
      }
    }
  }

  pub fn surface_wheres(k: Nat, c: SurfaceCtx, w: Option(CstNode)): List(SurfaceConstraint) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceConstraint) from match w {
        Some(clause) => surface_constraints(j, c, surface_all(clause, "Constraint"))
        None => Nil
      }
    }
  }

  pub fn surface_tail_types(k: Nat, c: SurfaceCtx, node: CstNode): List(SurfaceTerm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceTerm) from match surface_all(node, "Type") {
        Nil => Nil
        Cons(^first, rest) => surface_map_terms(j, c, rest)
      }
    }
  }

  pub fn surface_constraints(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceConstraint) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceConstraint) from match nodes {
        Nil => Nil
        Cons(n, rest) => Cons(
          SurfaceConstraint {
            r#class: surface_ident(c, n),
            ty: surface_term_of(j, c, surface_ty(n), n),
            start: surface_span(c, n).start,
            end: surface_span(c, n).end,
            arguments: surface_tail_types(j, c, n)
          },
          surface_constraints(j, c, rest)
        )
      }
    }
  }

  pub fn surface_effect_decl(k: Nat, c: SurfaceCtx, decl: CstNode): SurfaceEffect ! {div} {
    match k {
      Zero => SurfaceEffect {
        visibility: VisPrivate,
        name: "",
        generics: Nil,
        params: Nil,
        result: None,
        r#resume: None,
        start: 0,
        end: 0,
        set: None,
      unused_generics: Nil,
        bounds: Nil,
        rows: Nil
      }
      Succ(j) => SurfaceEffect {
        visibility: VisPrivate,
        name: surface_ident(c, decl),
        generics: surface_effect_generics(j, c, decl),
        params: surface_signature_params(j, c, surface_effect_params(decl)),
        result: surface_signature_result(j, c, surface_signature(decl)),
        r#resume: surface_resume(c, surface_signature(decl)),
        start: surface_span(c, decl).start,
        end: surface_span(c, decl).end,
        set: surface_effect_set(j, c, decl),
        unused_generics: ⊢ List(Option(SurfaceSpan)) from match surface_signature(decl) {
          Some(^sig) => surface_generic_unused_spans(c, decl)
          None => surface_nones(surface_effect_generics(j, c, decl))
        },
        bounds: ⊢ List(Option(Text)) from match surface_signature(decl) {
          Some(^sig) => surface_generic_bounds(c, decl).bounds
          None => Nil
        },
        // The Rust reader keeps no row flag on an effect it reads.
        rows: Nil
      }
    }
  }

  // An operation's generics are written `<A>`; a set's parameters `(T: Type)`.
  pub fn surface_effect_generics(k: Nat, c: SurfaceCtx, decl: CstNode): List(Text) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(Text) from match surface_signature(decl) {
        Some(^sig) => surface_named_names(surface_generics(j, c, decl))
        None => ⊢ List(Text) from match surface_first(decl, "EffectParams") {
          Some(p) => surface_param_idents(c, surface_all(p, "Param"))
          None => Nil
        }
      }
    }
  }

  pub fn surface_signature_params(
    k: Nat,
    c: SurfaceCtx,
    params: Option(CstNode)
  ): List(Option(SurfaceTerm)) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(Option(SurfaceTerm)) from match params {
        Some(p) => surface_param_types(j, c, surface_all(p, "Param"))
        None => Nil
      }
    }
  }

  pub fn surface_signature_result(
    k: Nat,
    c: SurfaceCtx,
    signature: Option(CstNode)
  ): Option(SurfaceTerm) ! {div} {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(SurfaceTerm) from match signature {
        Some(sig) => surface_opt_term(j, c, surface_ty(sig))
        None => None
      }
    }
  }

  pub fn surface_data_fields_of(
    k: Nat,
    c: SurfaceCtx,
    nodes: List(CstNode)
  ): List(SurfaceDataField) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceDataField) from match nodes {
        Nil => Nil
        Cons(f, rest) => Cons(
          SurfaceDataField {
            name: surface_opt_ident(c, f),
            ty: surface_term_of(j, c, surface_ty(f), f)
          },
          surface_data_fields_of(j, c, rest)
        )
      }
    }
  }

  pub fn surface_struct_decl(k: Nat, c: SurfaceCtx, decl: CstNode): SurfaceData ! {div} {
    match k {
      Zero => surface_out_data()
      Succ(j) => SurfaceData {
        kind: surface_data_kind(c, decl),
        name: surface_struct_name(c, decl),
        generics: surface_named_names(surface_generics(j, c, decl)),
        constructors: Cons(
          SurfaceDataCtor {
            name: surface_struct_name(c, decl),
            fields: surface_data_fields_of(j, c, surface_struct_fields(c, surface_first(decl, "StructBody")))
          },
          Nil
        ),
        start: surface_span(c, decl).start,
        end: surface_span(c, decl).end,
        coerce_level: surface_coerce_level(c, surface_struct_fields(c, surface_first(decl, "StructBody"))),
        coerce_field: surface_coerce_index(c, surface_struct_fields(c, surface_first(decl, "StructBody")), 0),
        visibility: VisPrivate,
        unused_generics: surface_generic_unused_spans(c, decl),
        rows: surface_generic_rows(c, decl)
      }
    }
  }

  pub fn surface_variants(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceDataCtor) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceDataCtor) from match nodes {
        Nil => Nil
        Cons(v, rest) => Cons(
          SurfaceDataCtor {
            name: surface_ident(c, v),
            fields: surface_variant_fields(j, c, surface_first(v, "VariantBody"))
          },
          surface_variants(j, c, rest)
        )
      }
    }
  }

  pub fn surface_variant_fields(
    k: Nat,
    c: SurfaceCtx,
    body: Option(CstNode)
  ): List(SurfaceDataField) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceDataField) from match body {
        None => Nil
        Some(b) => ⊢ List(SurfaceDataField) from match surface_first(b, "Fields") {
          Some(f) => surface_data_fields_of(j, c, surface_descend(c, f, "FieldDecl"))
          None => surface_unnamed_fields(j, c, surface_all(b, "Type"))
        }
      }
    }
  }

  pub fn surface_unnamed_fields(
    k: Nat,
    c: SurfaceCtx,
    types: List(CstNode)
  ): List(SurfaceDataField) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceDataField) from match types {
        Nil => Nil
        Cons(t, rest) => Cons(
          SurfaceDataField { name: None, ty: surface_term(j, c, t) },
          surface_unnamed_fields(j, c, rest)
        )
      }
    }
  }

  pub fn surface_enum_decl(k: Nat, c: SurfaceCtx, decl: CstNode): SurfaceData ! {div} {
    match k {
      Zero => surface_out_data()
      Succ(j) => SurfaceData {
        kind: surface_data_kind(c, decl),
        name: surface_ident(c, decl),
        generics: surface_named_names(surface_generics(j, c, decl)),
        constructors: surface_variants(j, c, surface_descend(c, decl, "Variant")),
        start: surface_span(c, decl).start,
        end: surface_span(c, decl).end,
        coerce_level: None,
        coerce_field: 0,
        visibility: VisPrivate,
        unused_generics: surface_generic_unused_spans(c, decl),
        rows: surface_generic_rows(c, decl)
      }
    }
  }

  // `<A, n: Nat>` or `(A: Type, n: Nat)`: the generics, typed `Type` unless a kind is written.
  pub fn surface_generics(k: Nat, c: SurfaceCtx, node: CstNode): List(SurfaceNamed) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceNamed) from match surface_generic_node(node) {
        None => Nil
        Some(generics) => surface_generics_of(j, c, surface_generic_items(generics))
      }
    }
  }

  pub fn surface_generics_of(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceNamed) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceNamed) from match nodes {
        Nil => Nil
        Cons(g, rest) => Cons(
          SurfaceNamed {
            // BindName (`^A`) or Ident (row `!e`); `surface_ident` strips `^`.
            name: surface_ident(c, g),
            ty: surface_generic_kind(j, c, g)
          },
          surface_generics_of(j, c, rest)
        )
      }
    }
  }

  pub fn surface_generic_kind(k: Nat, c: SurfaceCtx, g: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(g, "RowBound") {
        Some(b) => surface_var(surface_strip(c, surface_text(c, b)), surface_span(c, b))
        None => ⊢ SurfaceTerm from match surface_first(g, "GenericKind") {
          // `Copy`, `Shared` and `Linear` are `Type`, in an arrow's parts too,
          // each where it is written.
          Some(kind) => surface_kind_read(j, surface_angle(j, c, kind))
          None => surface_var("Type", surface_span(c, g))
        }
      }
    }
  }

  pub fn surface_typed_params_of(k: Nat, c: SurfaceCtx, params: List(CstNode)): List(SurfaceNamed) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceNamed) from match params {
        Nil => Nil
        Cons(p, rest) => Cons(
          SurfaceNamed {
            name: surface_ident(c, p),
            ty: surface_term_of(j, c, surface_ty(p), p)
          },
          surface_typed_params_of(j, c, rest)
        )
      }
    }
  }

  pub fn surface_inductive_decl(
    k: Nat,
    c: SurfaceCtx,
    decl: CstNode,
    span: SurfaceSpan
  ): SurfaceInductive ! {div} {
    match k {
      Zero => SurfaceInductive {
        name: "",
        params: Nil,
        sort: surface_out("fuel"),
        constructors: Nil,
        start: 0,
        end: 0,
        visibility: VisPrivate
      }
      Succ(j) => SurfaceInductive {
        name: surface_ident(c, decl),
        params: surface_typed_params_of(j, c, surface_all(decl, "Param")),
        sort: surface_term_of(j, c, surface_ty(decl), decl),
        constructors: surface_constructors(
          j,
          c,
          surface_ctor_nodes(c, surface_first(decl, "Constructors"))
        ),
        start: span.start,
        end: span.end,
        visibility: VisPrivate
      }
    }
  }

  pub fn surface_constructors(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceCtor) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceCtor) from match nodes {
        Nil => Nil
        Cons(n, rest) => Cons(
          SurfaceCtor {
            name: surface_ctor_name(c, n),
            implicit: List::length(surface_generics(j, c, n)),
            params: List::append(surface_generics(j, c, n), surface_typed_params_of(j, c, surface_all(n, "Param"))),
            result: surface_term_of(j, c, surface_ty(n), n)
          },
          surface_constructors(j, c, rest)
        )
      }
    }
  }

  // `Colon Type Assign Gap Type`: the first `Type` is the result, the second
  // the body.
  pub fn surface_def_decl(k: Nat, c: SurfaceCtx, decl: CstNode, span: SurfaceSpan): SurfaceTheorem ! {div} {
    match k {
      Zero => surface_out_theorem()
      Succ(j) => ⊢ SurfaceTheorem from match surface_all(decl, "Type") {
        Nil => surface_theorem_decl(j, c, decl, span)
        Cons(result, rest) => ⊢ SurfaceTheorem from match rest {
          Nil => surface_theorem_decl(j, c, decl, span)
          Cons(body, more) => ⊢ SurfaceTheorem from match more {
            Cons(^x, ^y) => surface_theorem_decl(j, c, decl, span)
            Nil => surface_def_of(
              surface_theorem_decl(j, c, decl, span),
              surface_term(j, c, result),
              surface_term(j, c, body)
            )
          }
        }
      }
    }
  }

  // The laws of a class or an instance, each as the theorem it is written as.
  pub fn surface_laws(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceLaw) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceLaw) from match nodes {
        Nil => Nil
        Cons(n, rest) => Cons(
          SurfaceLaw {
            name: surface_ident(c, n),
            start: surface_span(c, n).start,
            end: surface_span(c, n).end,
            decl: surface_theorem_decl(j, c, n, surface_span(c, n))
          },
          surface_laws(j, c, rest)
        )
      }
    }
  }

  pub fn surface_theorem_decl(
    k: Nat,
    c: SurfaceCtx,
    decl: CstNode,
    span: SurfaceSpan
  ): SurfaceTheorem ! {div} {
    match k {
      Zero => surface_out_theorem()
      Succ(j) => SurfaceTheorem {
        visibility: VisPrivate,
        name: surface_ident(c, decl),
        implicit: List::length(surface_generics(j, c, decl)),
        params: List::append(
          surface_generics(j, c, decl),
          List::append(
            surface_dictionary_params(surface_wheres(j, c, surface_first(decl, "WhereClause")), 0),
            surface_typed_params_of(j, c, surface_all(decl, "Param"))
          )
        ),
        ty: surface_term_of(j, c, surface_ty(decl), decl),
        body: surface_opt_term(j, c, surface_first(decl, "Block")),
        start: span.start,
        end: span.end,
        unused: ⊢ Option(SurfaceSpan) from match surface_bind_name_of(c, decl) {
          None => None
          Some(pair) => pair.snd
        },
        // Aligned with `params`: the generics (marked with `^`), then the
        // dictionaries of the `where` clause (never marked), then the parameters.
        unused_params: List::append(
          surface_generic_unused_spans(c, decl),
          List::append(
            surface_none_spans(surface_dictionary_params(surface_wheres(j, c, surface_first(decl, "WhereClause")), 0)),
            surface_param_unused_spans(c, surface_all(decl, "Param"))
          )
        )
      }
    }
  }

  // `perform e(<T: A>, x)`: the named type arguments first, as a call's.
  // `perform budget(n, f)` and `perform budget_memory(n, f)` are the host's
  // budgets when the name resolves to the library's operation: when the
  // program declares no effect of that name (`surface_host_budget`).
  pub fn surface_perform(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => {
        let name := surface_name_of(c, surface_first(n, "OperationName"))
        ⊢ SurfaceTerm from match surface_host_budget(c, name) {
          true => surface_budget(j, c, name == "budget_memory", surface_first(n, "Call"), span)
          false => ⊢ SurfaceTerm from match name == "budget" || name == "budget_memory" {
            // The program's own `budget`: an argument written at a type
            // stays one, as Rust's reader keeps it.
            true => surface_term_at(SkPerform(name, surface_budget_spelled_args(j, c, surface_first(n, "Call"))), span)
            false => surface_term_at(SkPerform(name, surface_call_args(j, c, surface_first(n, "Call"))), span)
          }
        }
      }
    }
  }

  // A budget takes two plain arguments: the count, and the function of no
  // parameter to run, whose body runs where the budget is written.
  pub fn surface_budget(
    k: Nat,
    c: SurfaceCtx,
    memory: Bool,
    call: Option(CstNode),
    span: SurfaceSpan
  ): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_budget_items(call) {
        None => surface_term_at(SkOther(surface_budget_refused(memory)), span)
        Some(#(count, f)) => surface_term_at(
          SkBudget(memory, surface_term(j, c, count), surface_budget_body(surface_term(j, c, f), span)),
          span
        )
      }
    }
  }

  // The arguments of a `perform` of a program's own `budget`: as a call's,
  // with an argument written at a type (`n: T`) kept as the ascription.
  pub fn surface_budget_spelled_args(k: Nat, c: SurfaceCtx, call: Option(CstNode)): List(SurfaceTerm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceTerm) from match call {
        Some(x) => List::append(
          surface_call_implicits(j, c, surface_first(x, "CallImplicits")),
          surface_ascribed_items(j, c, surface_all(x, "Item"))
        )
        None => Nil
      }
    }
  }

  pub fn surface_ascribed_items(k: Nat, c: SurfaceCtx, items: List(CstNode)): List(SurfaceTerm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceTerm) from match items {
        Nil => Nil
        Cons(i, rest) => Cons(
          ⊢ SurfaceTerm from match surface_ty(i) {
            None => surface_term(j, c, i)
            Some(t) => surface_term_at(SkAscribe(surface_term(j, c, i), surface_term(j, c, t)), surface_span(c, i))
          },
          surface_ascribed_items(j, c, rest)
        )
      }
    }
  }

  pub fn surface_match(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(n, "Cond") {
        None => surface_other(c, n)
        Some(
          Scrutinee
        ) => surface_term_at(
          SkMatch(
            // `match x: T`: the scrutinee's type, as `(x: T)`.
            ⊢ SurfaceTerm from match surface_ty(n) {
              None => surface_term(j, c, Scrutinee)
              Some(t) => surface_term_at(
                SkAscribe(surface_term(j, c, Scrutinee), surface_term(j, c, t)),
                surface_span(c, Scrutinee)
              )
            },
            None,
            // Only under `arms`: a `match` in the scrutinee has arms of its own.
            surface_arms(j, c, surface_match_arms(c, surface_first(n, "Arms"))),
            ⊢ Option(Text) from match surface_bind_name_of(c, n) {
              Some(pair) => Some(pair.fst)
              None => surface_opt_ident(c, n)
            },
            ⊢ Option(SurfaceSpan) from match surface_bind_name_of(c, n) {
              Some(pair) => pair.snd
              None => None
            }
          ),
          span
        )
      }
    }
  }

  pub fn surface_step(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(n, "MacroCall") {
        None => surface_other(c, n)
        Some(call) => ⊢ SurfaceTerm from match surface_term(j, c, call) {
          SurfaceTermIndexedMk(kind, cs, ce, ^ast_occurrence) => ⊢ SurfaceTerm from match kind {
            SkMacroCall(name, arg) => surface_term_at(
              SkStep(
                name,
                arg,
                cs,
                ce,
                surface_opt_term(j, c, surface_ty(n)),
                surface_step_arms(j, c, surface_step_arm_nodes(c, surface_first(n, "StepBody")))
              ),
              span
            )
            SkVar(^x) => surface_other(c, n)
            SkNat(^x) => surface_other(c, n)
            SkFloat(^x) => surface_other(c, n)
            SkRow(^x) => surface_other(c, n)
            SkText(^x) => surface_other(c, n)
            SkBool(^x) => surface_other(c, n)
            SkApp(^x, ^y) => surface_other(c, n)
            SkPi(^x, ^y, ^z) => surface_other(c, n)
            SkExists(^x, ^y, ^z, ^unused) => surface_other(c, n)
            SkLam(^x, ^y, _, _) => surface_other(c, n)
            SkUnion(^x) => surface_other(c, n)
            SkTagged(^x, ^y) => surface_other(c, n)
            SkIf(^x, ^y, ^z) => surface_other(c, n)
            SkField(^x, ^y) => surface_other(c, n)
            SkBlock(^x) => surface_other(c, n)
            SkPerform(^x, ^y) => surface_other(c, n)
            SkHandle(^x, ^y) => surface_other(c, n)
            SkBudget(^x, ^y, ^z) => surface_other(c, n)
            SkMatch(^x, ^y, ^z, ^w, _) => surface_other(c, n)
            SkHole(^x) => surface_other(c, n)
            SkRecord(^x, ^y) => surface_other(c, n)
            SkBorrow(^x, ^x_orig, ^y) => surface_other(c, n)
            SkFnKind(^x, ^y) => surface_other(c, n)
            SkBorrowLam(^x, ^y) => surface_other(c, n)
            SkOther(^x) => surface_other(c, n)
            SkQuote(^x, ^y) => surface_other(c, n)
            SkSplice(^x) => surface_other(c, n)
            SkSyntaxLit(^x, ^y) => surface_other(c, n)
            SkStep(^x, ^y, ^z, ^w, ^v, ^u) => surface_other(c, n)
            SkAscribe(^x, ^y) => surface_other(c, n)
          }
        }
      }
    }
  }

  pub fn surface_step_arms(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceStepArm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceStepArm) from match nodes {
        Nil => Nil
        Cons(arm, rest) => Cons(
          SurfaceStepArm {
            binders: surface_step_binders(j, c, surface_all(arm, "StepBinder")),
            unused_binders: surface_step_unused_binders(j, c, surface_all(arm, "StepBinder")),
            goal: surface_term_of(j, c, surface_ty(arm), arm),
            body: surface_term_of(j, c, surface_first(arm, "Expr"), arm),
            start: surface_span(c, arm).start,
            end: surface_span(c, arm).end
          },
          surface_step_arms(j, c, rest)
        )
      }
    }
  }

  pub fn surface_step_binders(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceField) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceField) from match nodes {
        Nil => Nil
        Cons(b, rest) => Cons(
          SurfaceField {
            name: surface_ident(c, b),
            value: surface_term_of(j, c, surface_ty(b), b)
          },
          surface_step_binders(j, c, rest)
        )
      }
    }
  }

  // `C => ⊢ G from p`: the goal written under the arm's body.
  pub fn surface_arm_goal(k: Nat, c: SurfaceCtx, body: Option(CstNode)): Option(SurfaceTerm) ! {div} {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(SurfaceTerm) from match body {
        None => None
        Some(b) => ⊢ Option(SurfaceTerm) from match surface_arm_goal_expr(b) {
          None => None
          Some(g) => surface_opt_term(j, c, surface_ty(g))
        }
      }
    }
  }

  // The arm's body: the `p` of `C => ⊢ G from p`.
  pub fn surface_arm_body(k: Nat, c: SurfaceCtx, arm: CstNode): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(arm, "ArmBody") {
        None => surface_term_of(j, c, None, arm)
        Some(b) => ⊢ SurfaceTerm from match surface_arm_goal_expr(b) {
          None => surface_term_of(j, c, Some(b), arm)
          Some(g) => surface_goal(j, c, g, surface_span(c, g), false)
        }
      }
    }
  }

  // `y: T =>`: only a name takes a type.
  pub fn surface_arm_typed(
    k: Nat,
    c: SurfaceCtx,
    ty: Option(CstNode),
    patterns: List(SurfacePattern)
  ): List(SurfacePattern) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePattern) from match ty {
        None => patterns
        Some(t) => ⊢ List(SurfacePattern) from match patterns {
          Cons(only, more) => ⊢ List(SurfacePattern) from match more {
            Nil => ⊢ List(SurfacePattern) from match only {
              PtBind(name, unused) => Cons(PtTyped(name, surface_term(j, c, t), unused), Nil)
              _ => Cons(PtOther("a type after a pattern that is not a name"), Nil)
            }
            Cons(^x, ^y) => Cons(PtOther("a type after a pattern that is not a name"), Nil)
          }
          Nil => Cons(PtOther("a type after a pattern that is not a name"), Nil)
        }
      }
    }
  }

  pub fn surface_arms(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceArm) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceArm) from match nodes {
        Nil => Nil
        // `A | B => e` is the arms `A => e` and `B => e`, side by side.
        Cons(arm, rest) => surface_arms_each(
          surface_arm_typed(
            j,
            c,
            surface_first(arm, "ArmType"),
            ⊢ List(SurfacePattern) from match surface_first(arm, "Pattern") {
              None => Cons(PtOther("Arm"), Nil)
              Some(p) => surface_pattern_alternatives(j, c, p)
            }
          ),
          surface_opt_term(j, c, surface_first(arm, "Cond")),
          surface_arm_goal(j, c, surface_first(arm, "ArmBody")),
          surface_arm_body(j, c, arm),
          surface_arms(j, c, rest)
        )
      }
    }
  }

  // The patterns of `p | q | …`, one for each arm. Every alternative binds the
  // same names, and none is `_`; a pattern without `|` is itself.
  pub fn surface_pattern_alternatives(k: Nat, c: SurfaceCtx, n: CstNode): List(SurfacePattern) {
    match k {
      Zero => Nil
      Succ(j) => {
        let alts := surface_pattern_alt_all(j, c, surface_all(n, "PatternAlt"))
        ⊢ List(SurfacePattern) from match alts {
          Nil => Nil
          Cons(first, more) => ⊢ List(SurfacePattern) from match more {
            Nil => alts
            Cons(^x, ^y) => ⊢ List(SurfacePattern) from match surface_any_wild(alts) {
              true => Cons(PtOther("`_` in alternatives"), Nil)
              false => ⊢ List(SurfacePattern) from match surface_same_binders(
                surface_alt_binders(j, first, true),
                more,
                j
              ) {
                true => alts
                false => Cons(PtOther("alternatives binding different names"), Nil)
              }
            }
          }
        }
      }
    }
  }

  pub fn surface_pattern_alt_all(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfacePattern) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePattern) from match nodes {
        Nil => Nil
        Cons(a, rest) => Cons(surface_pattern_alt(j, c, a), surface_pattern_alt_all(j, c, rest))
      }
    }
  }

  pub fn surface_pattern_or(
    k: Nat,
    c: SurfaceCtx,
    found: Option(CstNode),
    what: Text
  ): SurfacePattern {
    match k {
      Zero => PtOther("fuel")
      Succ(j) => ⊢ SurfacePattern from match found {
        Some(p) => surface_pattern(j, c, p)
        None => PtOther(what)
      }
    }
  }

  pub fn surface_pattern_fields(
    k: Nat,
    c: SurfaceCtx,
    found: List(CstNode)
  ): List(SurfacePatternField) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePatternField) from match found {
        Nil => Nil
        Cons(f, rest) => ⊢ List(SurfacePatternField) from match surface_find_label(f.flat) {
          None => surface_pattern_fields(j, c, rest)
          Some(i) => Cons(
            SurfacePatternField {
              name: surface_text(c, i),
              pattern: ⊢ SurfacePattern from match surface_first(f, "Pattern") {
                Some(inner) => surface_pattern(j, c, inner)
                // `Point { x }` / `Point { ^x }`: field name and binding from BindName.
                None => ⊢ SurfacePattern from match surface_first(f, "BindName") {
                  Some(b) => ⊢ SurfacePattern from match surface_bind_name(c, b) {
                    #(name, unused) => surface_bind_pattern_marked(name, unused)
                  }
                  None => PtBind(surface_text(c, i), None)
                }
              }
            },
            surface_pattern_fields(j, c, rest)
          )
        }
      }
    }
  }

  pub fn surface_patterns(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfacePattern) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePattern) from match nodes {
        Nil => Nil
        Cons(p, rest) => Cons(surface_pattern(j, c, p), surface_patterns(j, c, rest))
      }
    }
  }

  pub fn surface_pattern(k: Nat, c: SurfaceCtx, n: CstNode): SurfacePattern {
    match k {
      Zero => PtOther("fuel")
      Succ(j) => ⊢ SurfacePattern from match surface_one(surface_all(n, "PatternAlt")) {
        None => PtOther("alternatives")
        Some(alt) => surface_pattern_alt(j, c, alt)
      }
    }
  }

  // One alternative of a pattern. `@a p` is `p` on the member labelled `a`: a
  // constructor `@a` with `p` its one argument, as in the Rust reader.
  pub fn surface_pattern_alt(k: Nat, c: SurfaceCtx, alt: CstNode): SurfacePattern {
    match k {
      Zero => PtOther("fuel")
      Succ(j) => ⊢ SurfacePattern from match surface_first(alt, "LabelPattern") {
        Some(label) => ⊢ SurfacePattern from match surface_first(label, "PatternAlt") {
          Some(inner) => PtCtor(
            NameSpelled(Text::concat("@", surface_label_tag(c, label))),
            Cons(surface_pattern_alt(j, c, inner), Nil)
          )
          None => PtOther("LabelPattern")
        }
        None => ⊢ SurfacePattern from match surface_first(alt, "PathPattern") {
          Some(path) => surface_path_pattern(j, c, path)
          None => ⊢ SurfacePattern from match surface_first(alt, "LentPattern") {
          Some(lent) => surface_lent_pattern(j, c, lent)
          None => ⊢ SurfacePattern from match surface_first(alt, "ListPattern") {
            Some(list) => surface_list_patterns(j, c, surface_first(list, "ListPatternItems"))
            None => ⊢ SurfacePattern from match surface_first(alt, "ProductPattern") {
              Some(tuple) => surface_product_written_pattern(
                surface_patterns(j, c, surface_all(tuple, "Pattern"))
              )
              None => ⊢ SurfacePattern from match surface_first(alt, "LiteralPattern") {
                None => PtOther("PatternAlt")
                Some(lit) => surface_literal_pattern(c, lit)
              }
            }
          }
          }
        }
      }
    }
  }

  // `[x, ..rest]` / `[x, .._]`: `Cons(x, rest)`, from `at`, a `ListPatternItems`; `[]` is `Nil`.
  pub fn surface_list_patterns(k: Nat, c: SurfaceCtx, at: Option(CstNode)): SurfacePattern {
    match k {
      Zero => PtOther("fuel")
      Succ(j) => ⊢ SurfacePattern from match at {
        None => PtCtor(NameSpelled("Nil"), Nil)
        Some(n) => ⊢ SurfacePattern from match surface_first(n, "ListPatternRest") {
          Some(r) => ⊢ SurfacePattern from match surface_first(r, "Wild") {
            Some(^w) => PtWild
            None => ⊢ SurfacePattern from match surface_bind_name_of(c, r) {
              Some(found) => ⊢ SurfacePattern from match found {
                #(name, unused) => surface_bind_pattern_marked(name, unused)
              }
              None => ⊢ SurfacePattern from match surface_first(r, "Ident") {
                Some(i) => surface_bind_pattern(surface_trim(c, surface_text(c, i)))
                None => PtOther("ListPatternRest")
              }
            }
          }
          None => ⊢ SurfacePattern from match surface_first(n, "Pattern") {
            None => PtOther("ListPatternItems")
            Some(p) => PtCtor(
              NameSpelled("Cons"),
              Cons(
                surface_pattern(j, c, p),
                Cons(surface_list_patterns(j, c, surface_first(n, "ListPatternItems")), Nil)
              )
            )
          }
        }
      }
    }
  }

  // `&T { f, … }`: the record of the `struct &T` of `T`, declared under `&T`, as
  // in the Rust reader.
  pub fn surface_lent_pattern(k: Nat, c: SurfaceCtx, node: CstNode): SurfacePattern {
    match k {
      Zero => PtOther("fuel")
      Succ(j) => PtRecord(
        surface_lent_pattern_name(c, node),
        surface_pattern_fields(
          j,
          c,
          ⊢ List(CstNode) from match surface_first(node, "FieldPatterns") {
            Some(list) => surface_items(c, list.flat, "FieldPattern", "FieldPatternsTail", "FieldPatternsTail")
            None => Nil
          }
        )
      )
    }
  }

  // `x`, `_`, `^x`, `C(p, …)`, `C { f, … }`, `C<n: p>(…)`: a `PathPattern`.
  pub fn surface_path_pattern(k: Nat, c: SurfaceCtx, path: CstNode): SurfacePattern {
    match k {
      Zero => PtOther("fuel")
      Succ(j) => ⊢ SurfacePattern from match surface_simple_path(path) {
        true => ⊢ SurfacePattern from match surface_first(path, "Wild") {
          Some(^w) => PtWild
          None => ⊢ SurfacePattern from match surface_bind_name_of(c, path) {
            Some(found) => ⊢ SurfacePattern from match found {
              #(name, unused) => surface_bind_pattern_marked(name, unused)
            }
            None => surface_bind_pattern(surface_trim(c, surface_text(c, path)))
          }
        }
        false => {
          let name := ⊢ Text from match surface_bind_name_of(c, path) {
            Some(found) => ⊢ Text from match found {
              #(n, _) => n
            }
            None => Text::concat_all(surface_path_parts(c, path.flat))
          }
          // `C<n: m>(…)`: the implicit arguments named, carried first as the
          // record `@implicits` that the elaborator places by the generics' names.
          let implicits := surface_pattern_implicits(j, c, surface_first(path, "PatternImplicits"))
          ⊢ SurfacePattern from match surface_first(path, "PatternArgs") {
            None => PtCtor(NameSpelled(name), implicits)
            Some(a) => ⊢ SurfacePattern from match surface_first(a, "FieldPatterns") {
              Some(list) => PtRecord(
                name,
                surface_pattern_fields(
                  j,
                  c,
                  surface_items(
                    c,
                    list.flat,
                    "FieldPattern",
                    "FieldPatternsTail",
                    "FieldPatternsTail"
                  )
                )
              )
              None => PtCtor(
                NameSpelled(name),
                List::append(implicits, surface_patterns(j, c, surface_all(a, "Pattern")))
              )
            }
          }
        }
      }
    }
  }

  pub fn surface_pattern_implicits(k: Nat, c: SurfaceCtx, list: Option(CstNode)): List(SurfacePattern) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePattern) from match list {
        None => Nil
        Some(l) => Cons(
          PtRecord("@implicits", surface_pattern_implicit_fields(j, c, surface_all(l, "PatternImplicit"))),
          Nil
        )
      }
    }
  }

  pub fn surface_pattern_implicit_fields(
    k: Nat,
    c: SurfaceCtx,
    items: List(CstNode)
  ): List(SurfacePatternField) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfacePatternField) from match items {
        Nil => Nil
        Cons(i, rest) => ⊢ List(SurfacePatternField) from match surface_first(i, "Ident") {
          None => surface_pattern_implicit_fields(j, c, rest)
          Some(n) => ⊢ List(SurfacePatternField) from match surface_first(i, "Pattern") {
            None => surface_pattern_implicit_fields(j, c, rest)
            Some(p) => Cons(
              SurfacePatternField {
                name: surface_unraw(surface_trim(c, surface_text(c, n))),
                pattern: surface_pattern(j, c, p)
              },
              surface_pattern_implicit_fields(j, c, rest)
            )
          }
        }
      }
    }
  }

  pub fn surface_handle(k: Nat, c: SurfaceCtx, n: CstNode, span: SurfaceSpan): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match surface_first(n, "HandleSubject") {
        None => surface_other(c, n)
        Some(subject) => ⊢ SurfaceTerm from match surface_first(subject, "Block") {
          None => surface_other(c, n)
          Some(body) => surface_handle_withs(
            j,
            c,
            // Only the tail: the body block can hold `handle`s of its own,
            // whose `with`s are not this one's.
            ⊢ List(CstNode) from match surface_first(subject, "HandleTail") {
              Some(tail) => surface_descend(c, tail, "HandleWith")
              None => Nil
            },
            surface_term(j, c, body),
            span
          )
        }
      }
    }
  }

  // Each `with` wraps the ones before it; the evaluator reads the list as
  // written, so the nesting is kept as nested `Handle` terms.
  pub fn surface_handle_withs(
    k: Nat,
    c: SurfaceCtx,
    withs: List(CstNode),
    term: SurfaceTerm,
    span: SurfaceSpan
  ): SurfaceTerm ! {div} {
    match k {
      Zero => surface_out("fuel")
      Succ(j) => ⊢ SurfaceTerm from match withs {
        Nil => term
        Cons(w, rest) => surface_handle_withs(
          j,
          c,
          rest,
          surface_term_at(
            SkHandle(term, surface_handlers(j, c, surface_descend(c, w, "Handler"))),
            span
          ),
          span
        )
      }
    }
  }

  pub fn surface_handlers(k: Nat, c: SurfaceCtx, nodes: List(CstNode)): List(SurfaceHandler) ! {div} {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(SurfaceHandler) from match nodes {
        Nil => Nil
        Cons(h, rest) => Cons(surface_handler(j, c, h), surface_handlers(j, c, rest))
      }
    }
  }

  pub fn surface_handler(k: Nat, c: SurfaceCtx, n: CstNode): SurfaceHandler ! {div} {
    match k {
      Zero => HdReturn(PtOther("fuel"), surface_out("fuel"))
      Succ(j) => ⊢ SurfaceHandler from match surface_first(n, "ReturnHandler") {
        Some(r) => HdReturn(
          surface_pattern_or(j, c, surface_first(r, "Pattern"), "return"),
          surface_term_of(j, c, surface_first(r, "Expr"), r)
        )
        None => ⊢ SurfaceHandler from match surface_first(n, "OperationHandler") {
          None => HdReturn(PtWild, surface_term_of(j, c, surface_first(n, "Expr"), n))
          Some(op) => HdOperation(
            surface_name_of(c, surface_first(op, "OperationName")),
            surface_forall_names(c, surface_first(op, "EffectForall")),
            ⊢ List(SurfaceTerm) from match surface_first(op, "OperationTypes") {
              Some(t) => surface_map_terms(j, c, surface_all(t, "OperationType"))
              None => Nil
            },
            surface_patterns(j, c, surface_all(op, "Pattern")),
            // `, k` / `, ^k` is the identifier after the closing parenthesis.
            surface_cont(c, op),
            surface_cont_unused(c, op),
            surface_opt_term(j, c, surface_first(op, "Cond")),
            surface_term_of(j, c, surface_first(op, "Expr"), op)
          )
        }
      }
    }
  }
}

// The program under `root` with its products put as the checkers read them
// (`surface_lower_list_surfacestmt`); `surface_program_as_written` gives it
// as the Rust reader does.
pub fn surface_program_of(c: SurfaceCtx, root: CstNode): List(SurfaceStmt) ! {div} {
  surface_lower_list_surfacestmt(surface_program_as_written(c, root), Nil, false)
}

// Whether `perform name(…)` is the host's budget: `name` is `budget` or
// `budget_memory` and resolves to the library's operation, as it does when
// the program declares no effect of that name. A program's own
// `effect budget` is the program's, though spelled as the host's.
pub fn surface_host_budget(c: SurfaceCtx, name: Text): Bool {
  (name == "budget" && not(c.own_budget)) || (name == "budget_memory" && not(c.own_budget_memory))
}

// Whether the program declares an effect spelled `name` among its own
// declarations (an effect of a module is already written with its path).
pub fn surface_declares_effect(stmts: List(SurfaceStmt), name: Text): Bool {
  match stmts {
    Nil => false
    Cons(s, rest) => match s {
      StEffect(e) => e.name == name || surface_declares_effect(rest, name)
      _ => surface_declares_effect(rest, name)
    }
  }
}

// The statements of the program under `root` as written: its modules as
// `StModule`s and each `pub import m.{…}` as an `StReexport`.
pub fn surface_program_read(c: SurfaceCtx, root: CstNode): List(SurfaceStmt) ! {div} {
  match surface_find_deep(c.fuel, root.flat, "Program") {
    None => Nil
    Some(program) => surface_item_stmts(c.fuel * 16, c, surface_first(program, "Stmts"))
  }
}

// The statements of the program under `root` as its checkers read them, with
// the modules flattened (`surface_flatten_modules`).
pub fn surface_program_as_written(c: SurfaceCtx, root: CstNode): List(SurfaceStmt) ! {div} {
  match surface_find_deep(c.fuel, root.flat, "Program") {
    None => Nil
    Some(program) => {
      let stmts := surface_flatten_modules(surface_item_stmts(c.fuel * 16, c, surface_first(program, "Stmts")))
      let own := surface_declares_effect(stmts, "budget")
      let own_memory := surface_declares_effect(stmts, "budget_memory")
      // A program that declares its own `budget` is read again, its
      // `perform budget(…)`s its own.
      match own || own_memory {
        false => stmts
        true => surface_flatten_modules(surface_item_stmts(
          c.fuel * 16,
          SurfaceCtx {
            source: c.source,
            base: c.base,
            classes: c.classes,
            fuel: c.fuel,
            lambda_types: c.lambda_types,
            own_budget: own,
            own_budget_memory: own_memory
          },
          surface_first(program, "Stmts")
        ))
      }
    }
  }
}

// The statements of a program whose spans start at `base` as they are
// written, or `None` when it is not one of the grammar: the modules kept, and
// every `perform` a `perform`, the host's `budget` among them, since no name
// is resolved yet.
pub fn surface_read_program_unresolved(
  t: &SyntaxTables,
  classes: UnicodeClasses,
  source: Text,
  base: Nat
): Option(List(SurfaceStmt)) ! {div} {
  match syntax_parse(t, source) {
    None => None
    Some(root) => {
      let c := SurfaceCtx {
        source: source,
        base: base,
        classes: classes,
        fuel: surface_size(root) + 1,
        lambda_types: false,
        own_budget: true, own_budget_memory: true
      }
      ⊢ Option(List(SurfaceStmt)) from match surface_refused(c, root) {
        true => None
        false => Some(surface_program_read(c, root))
      }
    }
  }
}

// The statements of a program whose spans start at `base`, or `None` when it
// is not one of the grammar.
pub fn surface_read_program(
  t: &SyntaxTables,
  classes: UnicodeClasses,
  source: Text,
  base: Nat
): Option(List(SurfaceStmt)) ! {div} {
  match syntax_parse(t, source) {
    None => None
    Some(root) => {
      let c := SurfaceCtx {
        source: source,
        base: base,
        classes: classes,
        fuel: surface_size(root) + 1,
        lambda_types: false,
        own_budget: false, own_budget_memory: false
      }
      ⊢ Option(List(SurfaceStmt)) from match surface_refused(c, root) {
        true => None
        false => Some(surface_program_as_written(c, root))
      }
    }
  }
}

// A form the grammar reads but the language refuses (`Reader::refused_form`): the name `r#_`,
// an Ident that is only `_` (Wild is the dedicated token), an effect operation written
// `effect ask: () -> i64`, and `^` on a constructor name with arguments or a field label
// (`^Some(x)`, `Point { ^x: y }`). `^_` and `^` on a pub declaration name are refused on
// the Rust reader; nullary constructors (`^None`) are refused after name resolution.
pub fn surface_refused(c: SurfaceCtx, root: CstNode): Bool {
  surface_any_text(
    c.fuel,
    c,
    root.flat,
    "Ident",
    "r#_"
  ) || surface_any_text(
    c.fuel,
    c,
    root.flat,
    "Ident",
    "_"
  ) || surface_old_effects(c, surface_descend(c, root, "EffectDecl")) || surface_coerce_refused(
    c,
    root
  ) || surface_row_hole_refused(c, root) || surface_row_variable_in_literal(
    c,
    surface_descend(c, root, "FnDecl")
  ) || surface_row_variable_in_literal(c, surface_descend(c, root, "ExternFn")) || surface_pub_name_marker(c, surface_descend(c, root, "Stmt")) || surface_effect_marker_refused(
    c,
    root
  ) || surface_field_marker_refused(c, root) || surface_unused_marker_not_binding(c, root) || surface_class_method_body(
    c,
    surface_descend(c, root, "ClassDecl")
  )
}

// `^` on the name of a `pub` declaration: the name is meant to be used from
// outside, so it is not asserted unused. Its parameters and body may use `^`.
pub fn surface_pub_name_marker(c: SurfaceCtx, stmts: List(CstNode)): Bool {
  match stmts {
    Nil => false
    Cons(stmt, rest) => (
      surface_has(stmt.flat, "Visibility") && (
        match surface_first(stmt, "OtherStmt") {
          None => false
          Some(other) => match surface_declared_name(other) {
            None => false
            Some(name) => surface_has_caret(c, name)
          }
        }
      )
    ) || surface_pub_name_marker(c, rest)
  }
}

pub fn surface_has_caret(c: SurfaceCtx, n: CstNode): Bool {
  match surface_descend(c, n, "Caret") {
    Nil => false
    Cons(^x, ^rest) => true
  }
}

// The name a declaration statement writes: a `fn`'s (a macro `fn`'s among
// them) or the bound name of a `theorem`, `def`, `axiom`, `let` or `var`.
pub fn surface_declared_name(other: CstNode): Option(CstNode) {
  match surface_fn_name_of(surface_first(other, "FnDecl")) {
    Some(name) => Some(name)
    None => match surface_first(other, "MacroFnDecl") {
      Some(m) => surface_fn_name_of(surface_first(m, "FnDecl"))
      None => surface_bind_name_in(other, ["TheoremDecl", "DefDecl", "AxiomDecl", "LetDecl", "VarDecl"])
    }
  }
}

pub fn surface_fn_name_of(decl: Option(CstNode)): Option(CstNode) {
  match decl {
    None => None
    Some(d) => surface_first(d, "FnName")
  }
}

pub fn surface_bind_name_in(other: CstNode, kinds: List(Text)): Option(CstNode) {
  match kinds {
    Nil => None
    Cons(kind, rest) => match surface_first(other, kind) {
      Some(d) => match surface_first(d, "BindName") {
        Some(name) => Some(name)
        None => surface_bind_name_in(other, rest)
      }
      None => surface_bind_name_in(other, rest)
    }
  }
}

// `^` on a field is for the fields of a struct that is not `pub`: the fields of a `pub` struct
// may be read in other files, and the members of an enum's variant or a record type are not
// declared as a struct's are. The marked fields in the program outnumber those of the structs
// that are not `pub`, so more of them than that is a refusal.
pub fn surface_field_marker_refused(c: SurfaceCtx, root: CstNode): Bool {
  surface_marked_fields(surface_descend(c, root, "FieldDecl")) > surface_private_struct_markers(
    c,
    surface_descend(c, root, "Stmt")
  )
}

pub fn surface_marked_fields(fields: List(CstNode)): Nat {
  match fields {
    Nil => 0
    Cons(f, rest) => if surface_has(f.flat, "Caret") {
      1 + surface_marked_fields(rest)
    } else {
      surface_marked_fields(rest)
    }
  }
}

pub fn surface_private_struct_markers(c: SurfaceCtx, stmts: List(CstNode)): Nat {
  match stmts {
    Nil => 0
    Cons(stmt, rest) => (
      if surface_has(stmt.flat, "Visibility") {
        0
      } else {
        match surface_first(stmt, "OtherStmt") {
          None => 0
          Some(other) => match surface_first(other, "StructDecl") {
            None => 0
            Some(decl) => match surface_first(decl, "StructBody") {
              None => 0
              Some(body) => surface_marked_fields(surface_descend(c, body, "FieldDecl"))
            }
          }
        }
      }
    ) + surface_private_struct_markers(c, rest)
  }
}

// `^` on an effect name is only on a function's written row: a function type's
// row, a row argument or an effect set's member drops the marker, so it is
// refused there. The marked names in the program outnumber those of the rows
// the functions write.
pub fn surface_effect_marker_refused(c: SurfaceCtx, root: CstNode): Bool {
  surface_marked_effect_names(surface_descend(c, root, "EffectName")) > surface_written_row_markers(
    c,
    surface_descend(c, root, "FnDecl")
  ) + surface_written_row_markers(c, surface_descend(c, root, "ExternFn"))
}

pub fn surface_marked_effect_names(names: List(CstNode)): Nat {
  match names {
    Nil => 0
    Cons(n, rest) => if surface_has(n.flat, "Caret") {
      1 + surface_marked_effect_names(rest)
    } else {
      surface_marked_effect_names(rest)
    }
  }
}

pub fn surface_written_row_markers(c: SurfaceCtx, decls: List(CstNode)): Nat {
  match decls {
    Nil => 0
    Cons(d, rest) => (
      match surface_fn_written_row(c, d) {
        None => 0
        Some(row) => surface_marked_effect_names(surface_descend(c, row, "EffectName"))
      }
    ) + surface_written_row_markers(c, rest)
  }
}

// The row a function writes after its result: after the result type or
// alone, never one that an arrow of the result type takes.
pub fn surface_fn_written_row(c: SurfaceCtx, decl: CstNode): Option(CstNode) {
  match surface_first(decl, "FnResult") {
    None => None
    Some(result) => match surface_first(result, "EffectRow") {
      Some(row) => Some(row)
      None => match surface_first(result, "BodyType") {
        None => None
        Some(body) => if surface_arrow_or_cond_in(c, body.flat) { None } else { surface_first(body, "EffectRow") }
      }
    }
  }
}

pub fn surface_arrow_or_cond_in(c: SurfaceCtx, kids: List(CstNode)): Bool {
  match kids {
    Nil => false
    Cons(k, rest) => (
      (surface_is(k, "Op") || surface_is(k, "CondOp")) && surface_trim(c, surface_text(c, k)) == "->"
    ) || surface_arrow_or_cond_in(c, rest)
  }
}

// A class method is a signature only: a body is written on an `instance`.
pub fn surface_class_method_body(c: SurfaceCtx, classes: List(CstNode)): Bool {
  match classes {
    Nil => false
    Cons(decl, rest) => surface_methods_have_body(surface_descend(c, decl, "ExternFn")) || surface_class_method_body(c, rest)
  }
}

pub fn surface_methods_have_body(methods: List(CstNode)): Bool {
  match methods {
    Nil => false
    Cons(m, rest) => ⊢ Bool from match surface_first(m, "Block") {
      Some(^b) => true
      None => surface_methods_have_body(rest)
    }
  }
}

// `^` asserts a binding is unused. Constructor names with structure (`^Some(x)`,
// `^C<n: m>(…)`) and field labels (`Point { ^x: y }`) are not bindings. Binding
// sites are the arguments and field values (`Some(^x)`, `Point { x: ^y }`, and
// shorthand `Point { ^x }`).
pub fn surface_unused_marker_not_binding(c: SurfaceCtx, root: CstNode): Bool {
  surface_path_ctor_marker(c, surface_descend(c, root, "PathPattern")) || surface_field_label_marker(
    c,
    surface_descend(c, root, "FieldPattern")
  )
}

pub fn surface_path_ctor_marker(c: SurfaceCtx, paths: List(CstNode)): Bool {
  match paths {
    Nil => false
    Cons(path, rest) => ⊢ Bool from match surface_bind_name_of(c, path) {
      Some(found) => ⊢ Bool from match found {
        #(_, Some(^mark)) => (
          surface_has(path.flat, "PatternArgs") || surface_has(path.flat, "PatternImplicits")
        ) || surface_path_ctor_marker(c, rest)
        #(_, None) => surface_path_ctor_marker(c, rest)
      }
      None => surface_path_ctor_marker(c, rest)
    }
  }
}

pub fn surface_field_label_marker(c: SurfaceCtx, fields: List(CstNode)): Bool {
  match fields {
    Nil => false
    Cons(field, rest) => ⊢ Bool from match surface_bind_name_of(c, field) {
      Some(found) => ⊢ Bool from match found {
        #(_, Some(^mark)) => surface_has(field.flat, "Pattern") || surface_field_label_marker(
          c,
          rest
        )
        #(_, None) => surface_field_label_marker(c, rest)
      }
      None => surface_field_label_marker(c, rest)
    }
  }
}

// `!?` only ends the result of a `fn`: a row with one anywhere else is refused. The rows of the
// outermost `fn`s' results that end with one are the ones allowed, and every row with one is
// counted, so more of them than that is a refusal (`Reader::refused_form`).
// A row variable joins a row with `∪`, `! {trace} ∪ e`; inside a literal's braces a name is an
// effect, so a declared row variable (`<!e>`) written there is refused.
pub fn surface_row_variable_in_literal(c: SurfaceCtx, decls: List(CstNode)): Bool {
  match decls {
    Nil => false
    Cons(d, rest) => (
      match surface_generic_node(d) {
        None => false
        Some(generics) => surface_names_row_variable(
          c,
          surface_row_variable_names(c, surface_generic_items(generics)),
          surface_descend(c, d, "EffectName")
        )
      }
    ) || surface_row_variable_in_literal(c, rest)
  }
}

pub fn surface_row_variable_names(c: SurfaceCtx, generics: List(CstNode)): List(Text) {
  match generics {
    Nil => Nil
    Cons(g, rest) => if surface_has(g.flat, "Bang") {
      match surface_first(g, "Ident") {
        Some(i) => Cons(surface_trim(c, surface_text(c, i)), surface_row_variable_names(c, rest))
        None => surface_row_variable_names(c, rest)
      }
    } else {
      surface_row_variable_names(c, rest)
    }
  }
}

// Whether an effect name is one of the row variables, written bare.
pub fn surface_names_row_variable(c: SurfaceCtx, variables: List(Text), names: List(CstNode)): Bool {
  match names {
    Nil => false
    Cons(n, rest) => (
      match surface_first(n, "Ident") {
        Some(i) => surface_is_row_variable(surface_trim(c, surface_text(c, i)), variables) && not(surface_has(n.flat, "TypeCall")) && not(surface_has(n.flat, "EffectForall"))
        None => false
      }
    ) || surface_names_row_variable(c, variables, rest)
  }
}

pub fn surface_is_row_variable(t: Text, variables: List(Text)): Bool {
  match variables {
    Nil => false
    Cons(x, rest) => x == t || surface_is_row_variable(t, rest)
  }
}

pub fn surface_row_hole_refused(c: SurfaceCtx, root: CstNode): Bool {
  surface_row_hole_count(surface_descend(c, root, "EffectRow")) > surface_row_hole_fns(
    c,
    surface_descend(c, root, "FnDecl")
  )
}

pub fn surface_row_hole_count(rows: List(CstNode)): Nat {
  match rows {
    Nil => 0
    Cons(r, rest) => if surface_has(r.flat, "Question") {
      1 + surface_row_hole_count(rest)
    } else {
      surface_row_hole_count(rest)
    }
  }
}

pub fn surface_row_hole_fns(c: SurfaceCtx, fns: List(CstNode)): Nat {
  match fns {
    Nil => 0
    Cons(f, rest) => if surface_row_hole_of(c, f) {
      1 + surface_row_hole_fns(c, rest)
    } else {
      surface_row_hole_fns(c, rest)
    }
  }
}

// Whether the result of the `fn` ends with `!?`: after the result type or alone, never one that
// binds to an arrow of the result type.
pub fn surface_row_hole_of(c: SurfaceCtx, decl: CstNode): Bool {
  match surface_first(decl, "FnResult") {
    None => false
    Some(result) => surface_row_hole_in(surface_first(result, "EffectRow")) || (
      match surface_first(result, "BodyType") {
        None => false
        Some(ty) => not(surface_has_arrow(c, ty)) && surface_row_hole_in(surface_first(ty, "EffectRow"))
      }
    )
  }
}

pub fn surface_row_hole_in(row: Option(CstNode)): Bool {
  match row {
    None => false
    Some(r) => surface_has(r.flat, "Question")
  }
}

// Whether a child of the node is the operator `->`.
pub fn surface_has_arrow(c: SurfaceCtx, ty: CstNode): Bool {
  surface_arrow_in(c, ty.flat)
}

pub fn surface_arrow_in(c: SurfaceCtx, kids: List(CstNode)): Bool {
  match kids {
    Nil => false
    Cons(k, rest) => (
      surface_is(k, "Op") && surface_trim(c, surface_text(c, k)) == "->"
    ) || surface_arrow_in(c, rest)
  }
}

// `coerce` stands before a field of a struct, and once in it: a struct with two of them, or a
// `coerce` before a field of anything else (an enum's variant, a record type), is refused.
pub fn surface_coerce_refused(c: SurfaceCtx, root: CstNode): Bool {
  surface_coerce_bad_level(c, surface_descend(c, root, "FieldDecl")) || surface_coerce_twice(c, surface_descend(c, root, "StructDecl")) || surface_coerce_in_structs(
    c,
    surface_descend(c, root, "StructDecl")
  ) < surface_coerce_count(c, surface_descend(c, root, "FieldDecl"))
}

// A `coerce` level other than `mut` and `owned`.
pub fn surface_coerce_bad_level(c: SurfaceCtx, fields: List(CstNode)): Bool {
  match fields {
    Nil => false
    Cons(f, rest) => ⊢ Bool from match surface_field_coerce(c, f) {
      Some(l) => (l != "coerce" && l != "coerce(mut)" && l != "coerce(owned)") || surface_coerce_bad_level(c, rest)
      None => surface_coerce_bad_level(c, rest)
    }
  }
}

// The fields written with `coerce`.
pub fn surface_coerce_count(c: SurfaceCtx, fields: List(CstNode)): Nat {
  match fields {
    Nil => 0
    Cons(f, rest) => ⊢ Nat from match surface_field_coerce(c, f) {
      Some(^l) => 1 + surface_coerce_count(c, rest)
      None => surface_coerce_count(c, rest)
    }
  }
}

// The fields written with `coerce`, over the structs' own fields.
pub fn surface_coerce_in_structs(c: SurfaceCtx, structs: List(CstNode)): Nat {
  match structs {
    Nil => 0
    Cons(d, rest) => surface_coerce_count(
      c,
      surface_struct_fields(c, surface_first(d, "StructBody"))
    ) + surface_coerce_in_structs(c, rest)
  }
}

// A struct with more than one field written with `coerce`.
pub fn surface_coerce_twice(c: SurfaceCtx, structs: List(CstNode)): Bool {
  match structs {
    Nil => false
    Cons(d, rest) => 2 <= surface_coerce_count(
      c,
      surface_struct_fields(c, surface_first(d, "StructBody"))
    ) || surface_coerce_twice(c, rest)
  }
}

pub fn surface_old_effects(c: SurfaceCtx, effects: List(CstNode)): Bool {
  match effects {
    Nil => false
    Cons(e, rest) => surface_old_effect(c, e) || surface_old_effects(c, rest)
  }
}

pub fn surface_old_effect(c: SurfaceCtx, e: CstNode): Bool {
  match surface_has(e.flat, "EffectParams") {
    true => false
    false => ⊢ Bool from match surface_first(e, "EffectBody") {
      None => false
      Some(b) => ⊢ Bool from match surface_first(b, "EffectSignature") {
        None => false
        Some(sig) => ⊢ Bool from match surface_ty(sig) {
          None => false
          Some(t) => surface_any_named(
            c.fuel,
            t.flat,
            "ThinArrow"
          ) && text_starts_with(surface_trim(c, surface_text(c, t)), "(", 0)
        }
      }
    }
  }
}

pub fn surface_any_named(k: Nat, nodes: List(CstNode), name: Text): Bool {
  match k {
    Zero => false
    Succ(j) => ⊢ Bool from match nodes {
      Nil => false
      Cons(n, rest) => n.name == name || surface_any_named(
        j,
        n.flat,
        name
      ) || surface_any_named(j, rest, name)
    }
  }
}

pub fn surface_any_text(
  k: Nat,
  c: SurfaceCtx,
  nodes: List(CstNode),
  name: Text,
  written: Text
): Bool {
  match k {
    Zero => false
    Succ(j) => ⊢ Bool from match nodes {
      Nil => false
      Cons(n, rest) => (
        n.name == name && Text::slice_or_empty(c.source, n.start, n.end) == written
      ) || surface_any_text(
        j,
        c,
        n.flat,
        name,
        written
      ) || surface_any_text(j, c, rest, name, written)
    }
  }
}

// ---- `⟦ … □ … ⟧` -------------------------------------------------------------------
//
// `⟦ e ⟧` is `(congr@hole) => e`, with each `□` replaced by `congr@hole`. A `□`
// is counted where the Rust reader's walk over a term's children reaches it;
// a binder's own domains (the first parameter type of a `Pi`, a `Lam`'s
// written types, an `∃`'s domain) are outside the binder, the rest under it.

// The program `source` reads as, with its products put as the checkers read
// them; `surface_read_program` gives it as written.
pub fn surface_parse_program(
  t: &SyntaxTables,
  classes: UnicodeClasses,
  source: Text,
  base: Nat
): Option(List(SurfaceStmt)) ! {div} {
  match surface_read_program(t, classes, source, base) {
    None => None
    Some(stmts) => Some(surface_lower_list_surfacestmt(stmts, Nil, false))
  }
}

pub fn surface_parse_quote_body(t: &SyntaxTables, classes: UnicodeClasses, source: Text): Option(List(SurfaceStmt)) ! {div} {
  match syntax_parse(t, source) {
    None => None
    Some(root) => {
      let c := SurfaceCtx {
        source: source, base: 0, classes: classes, fuel: surface_size(root) + 1, lambda_types: false,
        own_budget: false, own_budget_memory: false
      }
      match surface_find_deep(c.fuel, root.flat, "Program") {
        None => None
        Some(program) => if surface_refused(c, root) { None } else {
          let stmts := surface_quote_stmts(c.fuel * 16, c, surface_first(program, "Stmts"))
          let own := surface_declares_effect(stmts, "budget")
          let own_memory := surface_declares_effect(stmts, "budget_memory")
          // A body that declares its own `budget` is read again, its `perform budget(…)`s its own.
          Some(match own || own_memory {
            false => stmts
            true => surface_quote_stmts(
              c.fuel * 16,
              SurfaceCtx {
                source: c.source,
                base: c.base,
                classes: c.classes,
                fuel: c.fuel,
                lambda_types: c.lambda_types,
                own_budget: own,
                own_budget_memory: own_memory
              },
              surface_first(program, "Stmts")
            )
          })
        }
      }
    }
  }
}
