import "compile.taut"
import "../../scan/src/scan.taut"
import "cps.taut"
import "mval.taut"
import "syntab.taut"
import std::Int
import std::prelude::Shared
import std::Base
import std::Float
import std::Array

// The continuation-passing form of a program as Rust writes it
// (`crates/tauto-vm/src/wire.rs`): numbers in decimal separated by spaces, each node a tag
// and then its parts in order, each list its length and then its items. A text is its
// length in bytes, one space, and the bytes. A malformed input reads as `None`, never as a
// program.

pub(open) inductive WTok: Type {
  WtNum(n: Nat): WTok
  WtText(t: Text): WTok
}

pub fn w_space(b: Nat): Bool {
  Bool::or(Nat::eq(b, 32), Nat::eq(b, 10))
}

pub fn w_digit(b: Nat): Bool {
  Bool::and(Nat::le(48, b), Nat::lt(b, 58))
}

// The tokens of the bytes: `fuel` bounds their count; `t` marks a text, whose length
// follows. `None` when the bytes are malformed.
pub fn w_tokens(fuel: Nat, bs: List(Nat)): Option(List(WTok)) {
  match fuel {
    Zero => None
    Succ(f) => match bs {
      Nil => Some(Nil)
      Cons(b, rest) => if w_space(b) {
        w_tokens(f, rest)
      } else if Nat::eq(b, 116) {
        match w_number(rest, 0, false) {
          None => None
          Some(r) => match r {
            Pair { fst: n, snd: after } => if Nat::le(n, List::length(after)) {
              match w_tokens(f, List::drop(n, after)) {
                None => None
                Some(ts) => Some(Cons(WtText(Text::Mk(List::take(n, after))), ts))
              }
            } else {
              None
            }
          }
        }
      } else {
        match w_number(bs, 0, false) {
          None => None
          Some(r) => match r {
            Pair { fst: n, snd: after } => match w_tokens(f, after) {
              None => None
              Some(ts) => Some(Cons(WtNum(n), ts))
            }
          }
        }
      }
    }
  }
}

// The digits at the start, read onto `acc`, and the bytes after the space that ends them.
pub fn w_number(bs: List(Nat), acc: Nat, seen: Bool): Option(Pair(Nat, List(Nat))) {
  match bs {
    Nil => if seen { Some(Pair { fst: acc, snd: Nil }) } else { None }
    Cons(b, rest) => if w_digit(b) {
      w_number(rest, Nat::add(Nat::mul(acc, 10), Nat::sub(b, 48)), true)
    } else if Bool::and(seen, w_space(b)) { Some(Pair { fst: acc, snd: rest }) } else { None }
  }
}

pub(open) inductive WS: Type {
  Ws(tokens: List(WTok), ok: Bool): WS
}

pub fn w_bad(s: WS): WS {
  match s {
    Ws(tokens, ok) => Ws(Nil, false)
  }
}

pub fn w_nat(s: WS): Pair(Nat, WS) {
  match s {
    Ws(tokens, ok) => match tokens {
      Cons(t, rest) => match t {
        WtNum(n) => Pair { fst: n, snd: Ws(rest, ok) }
        _ => Pair { fst: 0, snd: w_bad(s) }
      }
      Nil => Pair { fst: 0, snd: w_bad(s) }
    }
  }
}

pub fn w_text(s: WS): Pair(Text, WS) {
  match s {
    Ws(tokens, ok) => match tokens {
      Cons(t, rest) => match t {
        WtText(x) => Pair { fst: x, snd: Ws(rest, ok) }
        _ => Pair { fst: "", snd: w_bad(s) }
      }
      Nil => Pair { fst: "", snd: w_bad(s) }
    }
  }
}

pub fn w_bool(s: WS): Pair(Bool, WS) {
  match w_nat(s) {
    Pair { fst: n, snd: s2 } => Pair { fst: not(Nat::eq(n, 0)), snd: s2 }
  }
}

pub fn w_nats(n: Nat, s: WS): Pair(List(Nat), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_nat(s) {
      Pair { fst: x, snd: s2 } => match w_nats(m, s2) {
        Pair { fst: xs, snd: s3 } => Pair { fst: Cons(x, xs), snd: s3 }
      }
    }
  }
}

pub fn w_texts(n: Nat, s: WS): Pair(List(Text), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_text(s) {
      Pair { fst: x, snd: s2 } => match w_texts(m, s2) {
        Pair { fst: xs, snd: s3 } => Pair { fst: Cons(x, xs), snd: s3 }
      }
    }
  }
}

pub fn w_count_nats(s: WS): Pair(List(Nat), WS) {
  match w_nat(s) {
    Pair { fst: n, snd: s2 } => w_nats(n, s2)
  }
}

pub fn w_int(s: WS): Pair(Int, WS) {
  match w_bool(s) {
    Pair { fst: neg, snd: s2 } => match w_nat(s2) {
      Pair { fst: n, snd: s3 } => Pair { fst: m_int_signed(neg, n), snd: s3 }
    }
  }
}

pub fn w_val(s: WS): Pair(CVal, WS) {
  match w_nat(s) {
    Pair { fst: tag, snd: s2 } => if Nat::eq(tag, 0) {
      Pair { fst: CvUnit, snd: s2 }
    } else if Nat::eq(tag, 1) {
      match w_int(s2) {
        Pair { fst: i, snd: s3 } => Pair { fst: CvInt(i), snd: s3 }
      }
    } else if Nat::eq(tag, 2) {
      match w_nat(s2) {
        Pair { fst: bits, snd: s3 } => Pair { fst: CvFloat(Float::of_raw(bits)), snd: s3 }
      }
    } else if Nat::eq(tag, 3) {
      match w_bool(s2) {
        Pair { fst: b, snd: s3 } => Pair { fst: CvBool(b), snd: s3 }
      }
    } else if Nat::eq(tag, 4) {
      match w_text(s2) {
        Pair { fst: t, snd: s3 } => Pair { fst: CvText(t), snd: s3 }
      }
    } else if Nat::eq(tag, 5) {
      match w_nat(s2) {
        Pair { fst: f, snd: s3 } => Pair { fst: CvFn(f), snd: s3 }
      }
    } else if Nat::eq(tag, 6) {
      match w_nat(s2) {
        Pair { fst: slot, snd: s3 } => Pair { fst: CvDeclaration(slot), snd: s3 }
      }
    } else {
      Pair { fst: CvUnit, snd: w_bad(s2) }
    }
  }
}

pub fn w_step(s: WS): Pair(MPath, WS) {
  match w_nat(s) {
    Pair { fst: tag, snd: s2 } => if Nat::eq(tag, 1) {
      match w_text(s2) {
        Pair { fst: t, snd: s3 } => Pair { fst: MpathName(t), snd: s3 }
      }
    } else {
      match w_nat(s2) {
        Pair { fst: i, snd: s3 } => Pair {
          fst: if Nat::eq(
            tag,
            0
          ) { MpathIndex(i) } else if Nat::eq(tag, 2) { MpathItem(i) } else { MpathEntry(i) },
          snd: s3
        }
      }
    }
  }
}

pub fn w_steps(n: Nat, s: WS): Pair(List(MPath), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_step(s) {
      Pair { fst: x, snd: s2 } => match w_steps(m, s2) {
        Pair { fst: xs, snd: s3 } => Pair { fst: Cons(x, xs), snd: s3 }
      }
    }
  }
}

pub fn w_path(s: WS): Pair(List(MPath), WS) {
  match w_nat(s) {
    Pair { fst: n, snd: s2 } => w_steps(n, s2)
  }
}

mutual {
  pub fn w_pat(fuel: Nat, s: WS): Pair(CPat, WS) {
    match fuel {
      Zero => Pair { fst: CpWild, snd: w_bad(s) }
      Succ(f) => match w_nat(s) {
        Pair { fst: tag, snd: s2 } => if Nat::eq(tag, 0) {
          Pair { fst: CpWild, snd: s2 }
        } else if Nat::eq(tag, 1) {
          match w_nat(s2) {
            Pair { fst: id, snd: s3 } => match w_bool(s3) {
              Pair { fst: borrow, snd: s4 } => Pair { fst: CpBind(id, borrow), snd: s4 }
            }
          }
        } else if Nat::eq(tag, 2) {
          match w_val(s2) {
            Pair { fst: v, snd: s3 } => Pair { fst: CpLit(v), snd: s3 }
          }
        } else if Nat::eq(tag, 3) { match w_nat(s2) {
            Pair { fst: c, snd: s3 } => match w_nat(s3) {
              Pair { fst: n, snd: s4 } => match w_pats(f, n, s4) {
                Pair { fst: ps, snd: s5 } => Pair { fst: CpCtor(c, ps), snd: s5 }
              }
            }
          } } else if Nat::eq(tag, 4) {
          match w_nat(s2) {
            Pair { fst: n, snd: s3 } => match w_pats(f, n, s3) {
              Pair { fst: ps, snd: s4 } => Pair { fst: CpProduct(ps), snd: s4 }
            }
          }
        } else { Pair { fst: CpWild, snd: w_bad(s2) } }
      }
    }
  }

  pub fn w_pats(fuel: Nat, n: Nat, s: WS): Pair(List(CPat), WS) {
    match fuel {
      Zero => Pair { fst: Nil, snd: w_bad(s) }
      Succ(f) => match n {
        Zero => Pair { fst: Nil, snd: s }
        Succ(m) => match w_pat(f, s) {
          Pair { fst: p, snd: s2 } => match w_pats(f, m, s2) {
            Pair { fst: ps, snd: s3 } => Pair { fst: Cons(p, ps), snd: s3 }
          }
        }
      }
    }
  }
}

pub fn w_picks(n: Nat, s: WS): Pair(List(Pair(Nat, Option(Nat))), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_nat(s) {
      Pair { fst: i, snd: s2 } => match w_bool(s2) {
        Pair { fst: has, snd: s3 } => {
          let jr := ⊢ Pair(Option(Nat), WS) from match has {
            false => Pair { fst: None, snd: s3 }
            true => match w_nat(s3) {
              Pair { fst: j, snd: s4 } => Pair { fst: Some(j), snd: s4 }
            }
          }
          match jr {
            Pair { fst: j, snd: s4 } => match w_picks(m, s4) {
              Pair { fst: rest, snd: s5 } => Pair {
                fst: Cons(Pair { fst: i, snd: j }, rest),
                snd: s5
              }
            }
          }
        }
      }
    }
  }
}

pub fn w_options(n: Nat, s: WS): Pair(List(Option(Nat)), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_bool(s) {
      Pair { fst: has, snd: s2 } => {
        let jr := ⊢ Pair(Option(Nat), WS) from match has {
          false => Pair { fst: None, snd: s2 }
          true => match w_nat(s2) {
            Pair { fst: j, snd: s3 } => Pair { fst: Some(j), snd: s3 }
          }
        }
        match jr {
          Pair { fst: j, snd: s3 } => match w_options(m, s3) {
            Pair { fst: rest, snd: s4 } => Pair { fst: Cons(j, rest), snd: s4 }
          }
        }
      }
    }
  }
}

pub fn w_bools(n: Nat, s: WS): Pair(List(Bool), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_bool(s) {
      Pair { fst: x, snd: s2 } => match w_bools(m, s2) {
        Pair { fst: xs, snd: s3 } => Pair { fst: Cons(x, xs), snd: s3 }
      }
    }
  }
}

pub fn w_count_bools(s: WS): Pair(List(Bool), WS) {
  match w_nat(s) {
    Pair { fst: n, snd: s2 } => w_bools(n, s2)
  }
}

pub fn w_syn_syms(n: Nat, s: WS): Pair(List(SynSym), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_bool(s) {
      Pair { fst: term, snd: s2 } => match w_nat(s2) {
        Pair { fst: x, snd: s3 } => match w_syn_syms(m, s3) {
          Pair { fst: xs, snd: s4 } => Pair {
            fst: Cons(if term { SynT(x) } else { SynN(x) }, xs),
            snd: s4
          }
        }
      }
    }
  }
}

pub fn w_syn_node(s: WS): Pair(SynElem, WS) {
  match w_nat(s) {
    Pair { fst: c, snd: s2 } => match w_bool(s2) {
      Pair { fst: spanned, snd: s3 } => match w_count_bools(s3) {
        Pair { fst: keep, snd: s4 } => Pair { fst: SeNode(c, spanned, keep), snd: s4 }
      }
    }
  }
}

pub fn w_syn_elem(s: WS): Pair(SynElem, WS) {
  match w_nat(s) {
    Pair { fst: tag, snd: s2 } => if Nat::eq(tag, 0) {
      Pair { fst: SeItem, snd: s2 }
    } else if Nat::eq(tag, 1) { w_syn_node(s2) } else { Pair { fst: SeItem, snd: w_bad(s2) } }
  }
}

pub fn w_syn_shape(s: WS): Pair(SynShape, WS) {
  match w_nat(s) {
    Pair { fst: tag, snd: s2 } => if Nat::eq(tag, 0) {
      match w_syn_node(s2) {
        Pair { fst: e, snd: s3 } => match e {
          SeNode(c, spanned, keep) => Pair { fst: ShNode(c, spanned, keep), snd: s3 }
          SeItem => Pair { fst: ShPass, snd: w_bad(s3) }
        }
      }
    } else if Nat::eq(tag, 1) {
      Pair { fst: ShPass, snd: s2 }
    } else if Nat::eq(tag, 2) {
      match w_syn_elem(s2) {
        Pair { fst: e, snd: s3 } => Pair { fst: ShSome(e), snd: s3 }
      }
    } else if Nat::eq(tag, 3) {
      Pair { fst: ShNone, snd: s2 }
    } else if Nat::eq(tag, 4) {
      Pair { fst: ShEmpty, snd: s2 }
    } else if Nat::eq(tag, 5) {
      match w_syn_elem(s2) {
        Pair { fst: e, snd: s3 } => Pair { fst: ShMore(e), snd: s3 }
      }
    } else if Nat::eq(tag, 6) {
      match w_text(s2) {
        Pair { fst: m, snd: s3 } => Pair { fst: ShBad(m), snd: s3 }
      }
    } else {
      Pair { fst: ShPass, snd: w_bad(s2) }
    }
  }
}

pub fn w_syn_prods(n: Nat, s: WS): Pair(List(SynProd), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_nat(s) {
      Pair { fst: lhs, snd: s2 } => match w_nat(s2) {
        Pair { fst: width, snd: s3 } => match w_syn_syms(width, s3) {
          Pair { fst: rhs, snd: s4 } => match w_syn_shape(s4) {
            Pair { fst: shape, snd: s5 } => match w_syn_prods(m, s5) {
              Pair { fst: rest, snd: s6 } => Pair {
                fst: Cons(SynProd { lhs: lhs, rhs: rhs, shape: shape }, rest),
                snd: s6
              }
            }
          }
        }
      }
    }
  }
}

pub fn m_nth_nat(xs: List(Nat), i: Nat): Nat {
  match List::nth(xs, i) {
    None => 0
    Some(x) => x
  }
}

pub fn w_syn_transitions(n: Nat, s: WS): Pair(List(SynTrans), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_nats(4, s) {
      Pair { fst: xs, snd: s2 } => match w_syn_transitions(m, s2) {
        Pair { fst: rest, snd: s3 } => Pair {
          fst: Cons(
            SynTrans {
              state: m_nth_nat(xs, 0),
              terminal: m_nth_nat(xs, 1),
              to: m_nth_nat(xs, 2),
              production: m_nth_nat(xs, 3)
            },
            rest
          ),
          snd: s3
        }
      }
    }
  }
}

pub fn w_syn_looks(n: Nat, s: WS): Pair(List(Option(SynLook)), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_bool(s) {
      Pair { fst: has, snd: s2 } => if has {
        match w_nats(3, s2) {
          Pair { fst: xs, snd: s3 } => match w_syn_transitions(m_nth_nat(xs, 2), s3) {
            Pair { fst: ts, snd: s4 } => match w_syn_looks(m, s4) {
              Pair { fst: rest, snd: s5 } => Pair {
                fst: Cons(
                  Some(SynLook { prod0: m_nth_nat(xs, 0), k: m_nth_nat(xs, 1), transitions: ts }),
                  rest
                ),
                snd: s5
              }
            }
          }
        }
      } else {
        match w_syn_looks(m, s2) {
          Pair { fst: rest, snd: s3 } => Pair { fst: Cons(None, rest), snd: s3 }
        }
      }
    }
  }
}

pub fn w_syn_actions(n: Nat, s: WS): Pair(List(SynAction), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_nats(3, s) {
      Pair { fst: xs, snd: s2 } => match w_syn_actions(m, s2) {
        Pair { fst: rest, snd: s3 } => Pair {
          fst: Cons(
            SynAction { terminal: m_nth_nat(xs, 0), kind: m_nth_nat(xs, 1), arg: m_nth_nat(xs, 2) },
            rest
          ),
          snd: s3
        }
      }
    }
  }
}

pub fn w_syn_gotos(n: Nat, s: WS): Pair(List(SynGoto), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_nats(2, s) {
      Pair { fst: xs, snd: s2 } => match w_syn_gotos(m, s2) {
        Pair { fst: rest, snd: s3 } => Pair {
          fst: Cons(SynGoto { non_terminal: m_nth_nat(xs, 0), state: m_nth_nat(xs, 1) }, rest),
          snd: s3
        }
      }
    }
  }
}

pub fn w_syn_states(n: Nat, s: WS): Pair(List(SynState), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_nat(s) {
      Pair { fst: na, snd: s2 } => match w_syn_actions(na, s2) {
        Pair { fst: actions, snd: s3 } => match w_nat(s3) {
          Pair { fst: ng, snd: s4 } => match w_syn_gotos(ng, s4) {
            Pair { fst: gotos, snd: s5 } => match w_syn_states(m, s5) {
              Pair { fst: rest, snd: s6 } => Pair {
                fst: Cons(SynState { actions: actions, gotos: gotos }, rest),
                snd: s6
              }
            }
          }
        }
      }
    }
  }
}

// The parse tables: LL(k) lookahead automata per non-terminal, or LALR(1) states, and the
// tokens after them.
pub(open) inductive WSynTables: Type {
  Mk(looks: List(Option(SynLook)), states: List(SynState), rest: WS): WSynTables
}

pub fn w_syn_tables(lr: Bool, s: WS): WSynTables {
  match w_nat(s) {
    Pair { fst: n, snd: s2 } => if lr {
      match w_syn_states(n, s2) {
        Pair { fst: states, snd: s3 } => WSynTables {
          looks: Nil(<A: Option(SynLook)>),
          states: states,
          rest: s3
        }
      }
    } else {
      match w_syn_looks(n, s2) {
        Pair { fst: looks, snd: s3 } => WSynTables { looks: looks, states: Nil(<A: SynState>), rest: s3 }
      }
    }
  }
}

// The scanner's tables are read as `totes/scan` reads them; tables it cannot read make the
// program malformed.
pub fn w_syn_parser(s: WS): Pair(CPrim, WS) {
  match w_text(s) {
    Pair { fst: name, snd: s2 } => match w_texts(5, s2) {
      Pair { fst: scans, snd: s3 } => match w_nat(s3) {
        Pair { fst: nt, snd: s4 } => match w_texts(nt, s4) {
          Pair { fst: terminals, snd: s5 } => match w_count_bools(s5) {
            Pair { fst: skipped, snd: s6 } => match w_nat(s6) {
              Pair { fst: start, snd: s7 } => match w_bool(s7) {
                Pair { fst: lr, snd: s8 } => match w_syn_tables(lr, s8) {
                  WSynTables { looks: looks, states: states, rest: s9 } => match w_nat(s9) {
                    Pair { fst: np, snd: s10 } => match w_syn_prods(np, s10) {
                      Pair { fst: prods, snd: s11 } => match w_nats(5, s11) {
                        Pair { fst: ids, snd: s12 } => match scan_tables_read_dynamic(
                          w_syn_text_at(scans, 0),
                          w_syn_text_at(scans, 1),
                          w_syn_text_at(scans, 2),
                          w_syn_text_at(scans, 3),
                          w_syn_text_at(scans, 4)
                        ) {
                          None => Pair { fst: CprConcat, snd: w_bad(s12) }
                          Some(scan) => Pair {
                            fst: CprSynParse(
                              SynParser {
                                name: name,
                                scan: scan,
                                terminals: Array::of_list(terminals),
                                skipped: Array::of_list(skipped),
                                start: start,
                                lr: lr,
                                lookahead: Array::of_list(looks),
                                states: Array::of_list(states),
                                productions: Array::of_list(prods),
                                span: m_nth_nat(ids, 0),
                                ctx: m_nth_nat(ids, 1),
                                token: m_nth_nat(ids, 2),
                                diag: m_nth_nat(ids, 3),
                                arg: m_nth_nat(ids, 4)
                              }
                            ),
                            snd: s12
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub fn w_syn_text_at(ts: List(Text), i: Nat): Text {
  match List::nth(ts, i) {
    None => ""
    Some(t) => t
  }
}

pub fn w_prim(s: WS): Pair(CPrim, WS) {
  match w_nat(s) {
    Pair { fst: tag, snd: s2 } => if Nat::eq(tag, 0) {
      match w_nats(2, s2) {
        Pair { fst: aw, snd: s3 } => Pair {
          fst: CprArith(m_nth_nat(aw, 0), m_nth_nat(aw, 1)),
          snd: s3
        }
      }
    } else if Nat::eq(tag, 1) {
      match w_nat(s2) {
        Pair { fst: a, snd: s3 } => Pair { fst: CprFloat(a), snd: s3 }
      }
    } else if Nat::eq(tag, 2) {
      match w_nat(s2) {
        Pair { fst: c, snd: s3 } => Pair { fst: CprCmp(c), snd: s3 }
      }
    } else if Nat::eq(tag, 3) {
      match w_bool(s2) {
        Pair { fst: n, snd: s3 } => Pair { fst: CprEq(n), snd: s3 }
      }
    } else if Nat::eq(tag, 4) {
      match w_nat(s2) {
        Pair { fst: c, snd: s3 } => match w_count_nats(s3) {
          Pair { fst: order, snd: s4 } => Pair { fst: CprConstruct(c, order), snd: s4 }
        }
      }
    } else if Nat::eq(tag, 5) {
      match w_nat(s2) {
        Pair { fst: n, snd: s3 } => match w_picks(n, s3) {
          Pair { fst: picks, snd: s4 } => Pair { fst: CprProduct(picks), snd: s4 }
        }
      }
    } else if Nat::eq(tag, 6) {
      Pair { fst: CprConcat, snd: s2 }
    } else if Nat::eq(tag, 7) {
      Pair { fst: CprTextOfInt, snd: s2 }
    } else if Nat::eq(tag, 8) {
      Pair { fst: CprTextLen, snd: s2 }
    } else if Nat::eq(tag, 9) {
      Pair { fst: CprTextCompare, snd: s2 }
    } else if Nat::eq(tag, 10) {
      match w_bool(s2) {
        Pair { fst: m, snd: s3 } => match w_nat(s3) {
          Pair { fst: w, snd: s4 } => Pair { fst: CprDivide(m, w), snd: s4 }
        }
      }
    } else if Nat::eq(tag, 11) {
      match w_nat(s2) {
        Pair { fst: a, snd: s3 } => Pair { fst: CprFloat32(a), snd: s3 }
      }
    } else if Nat::eq(tag, 12) {
      w_syn_parser(s2)
    } else {
      Pair { fst: CprConcat, snd: w_bad(s2) }
    }
  }
}

pub fn w_unary(s: WS): Pair(CUnary, WS) {
  match w_nat(s) {
    Pair { fst: tag, snd: s2 } => if Nat::eq(tag, 0) {
      Pair { fst: CuNot, snd: s2 }
    } else if Nat::eq(tag, 1) {
      match w_nat(s2) {
        Pair { fst: i, snd: s3 } => Pair { fst: CuMember(i), snd: s3 }
      }
    } else if Nat::eq(tag, 2) {
      match w_step(s2) {
        Pair { fst: st, snd: s3 } => Pair { fst: CuField(st), snd: s3 }
      }
    } else if Nat::eq(tag, 3) {
      Pair { fst: CuShown, snd: s2 }
    } else if Nat::eq(tag, 4) {
      Pair { fst: CuTempRef, snd: s2 }
    } else if Nat::eq(tag, 5) {
      Pair { fst: CuDeref, snd: s2 }
    } else if Nat::eq(tag, 6) {
      match w_nats(2, s2) {
        Pair { fst: ui, snd: s3 } => Pair {
          fst: CuInject(m_nth_nat(ui, 0), m_nth_nat(ui, 1)),
          snd: s3
        }
      }
    } else if Nat::eq(tag, 7) {
      match w_options(1, s2) {
        Pair { fst: to, snd: s3 } => match w_nat(s3) {
          Pair { fst: n, snd: s4 } => match w_options(n, s4) {
            Pair { fst: table, snd: s5 } => Pair {
              fst: CuRemap(match List::nth(to, 0) {
                None => None
                Some(t) => t
              }, table),
              snd: s5
            }
          }
        }
      }
    } else {
      Pair { fst: CuNot, snd: w_bad(s2) }
    }
  }
}

pub fn w_ref_pairs(n: Nat, s: WS): Pair(List(Pair(Nat, Nat)), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_nats(2, s) {
      Pair { fst: io, snd: s2 } => match w_ref_pairs(m, s2) {
        Pair { fst: rest, snd: s3 } => Pair {
          fst: Cons(Pair { fst: m_nth_nat(io, 0), snd: m_nth_nat(io, 1) }, rest),
          snd: s3
        }
      }
    }
  }
}

// A node: its tag, then its parts (see `crates/tauto-vm/src/wire.rs`). `fuel` bounds
// the depth.
mutual {
  pub fn w_cps(fuel: Nat, s: WS): Pair(Cps, WS) {
    match fuel {
      Zero => Pair { fst: CPure(CvUnit), snd: w_bad(s) }
      Succ(f) => match w_nat(s) {
        Pair { fst: tag, snd: s2 } => if Nat::lt(
          tag,
          10
        ) { w_cps_0(f, tag, s2) } else { w_cps_10(f, tag, s2) }
      }
    }
  }

  pub fn w_cps_0(fuel: Nat, tag: Nat, s2: WS): Pair(Cps, WS) {
    match fuel {
      Zero => Pair { fst: CPure(CvUnit), snd: w_bad(s2) }
      Succ(f) => if Nat::eq(tag, 0) {
        match w_val(s2) {
          Pair { fst: v, snd: s3 } => Pair { fst: CPure(v), snd: s3 }
        }
      } else if Nat::eq(tag, 1) {
        match w_nat(s2) {
          Pair { fst: id, snd: s3 } => match w_bool(s3) {
            Pair { fst: d, snd: s4 } => Pair { fst: CRead(id, d), snd: s4 }
          }
        }
      } else if Nat::eq(tag, 2) {
        match w_cps(f, s2) {
          Pair { fst: callee, snd: s3 } => match w_list(f, s3) {
            Pair { fst: args, snd: s4 } => match w_bool(s4) {
              Pair { fst: t, snd: s5 } => Pair { fst: CCall(callee, args, t), snd: s5 }
            }
          }
        }
      } else if Nat::eq(tag, 3) {
        match w_nat(s2) {
          Pair { fst: inst, snd: s3 } => match w_list(f, s3) {
            Pair { fst: args, snd: s4 } => Pair { fst: CTail(inst, args), snd: s4 }
          }
        }
      } else if Nat::eq(tag, 4) {
        match w_text(s2) {
          Pair { fst: name, snd: s3 } => match w_list(f, s3) {
            Pair { fst: args, snd: s4 } => Pair { fst: CBuiltin(name, args), snd: s4 }
          }
        }
      } else if Nat::eq(tag, 5) {
        match w_prim(s2) {
          Pair { fst: op, snd: s3 } => match w_list(f, s3) {
            Pair { fst: args, snd: s4 } => Pair { fst: MkCPrim(op, args), snd: s4 }
          }
        }
      } else if Nat::eq(tag, 6) {
        match w_cps(f, s2) {
          Pair { fst: v, snd: s3 } => match w_unary(s3) {
            Pair { fst: op, snd: s4 } => Pair { fst: CMap(v, op), snd: s4 }
          }
        }
      } else if Nat::eq(tag, 7) {
        match w_cps(f, s2) {
          Pair { fst: c, snd: s3 } => match w_cps(f, s3) {
            Pair { fst: t, snd: s4 } => match w_cps(f, s4) {
              Pair { fst: o, snd: s5 } => Pair { fst: CBranch(c, t, o), snd: s5 }
            }
          }
        }
      } else if Nat::eq(tag, 8) {
        match w_list(f, s2) {
          Pair { fst: items, snd: s3 } => Pair { fst: CSeq(items), snd: s3 }
        }
      } else {
        match w_nat(s2) {
          Pair { fst: id, snd: s3 } => match w_bool(s3) {
            Pair { fst: r#shared, snd: s4 } => match w_bool(s4) {
              Pair { fst: drop, snd: s5 } => match w_cps(f, s5) {
                Pair { fst: init, snd: s6 } => Pair {
                  fst: CDefine(id, r#shared, drop, init),
                  snd: s6
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn w_cps_10(fuel: Nat, tag: Nat, s2: WS): Pair(Cps, WS) {
    match fuel {
      Zero => Pair { fst: CPure(CvUnit), snd: w_bad(s2) }
      Succ(f) => if Nat::eq(tag, 10) {
        match w_nat(s2) {
          Pair { fst: id, snd: s3 } => match w_path(s3) {
            Pair { fst: path, snd: s4 } => match w_bool(s4) {
              Pair { fst: through, snd: s5 } => match w_cps(f, s5) {
                Pair { fst: v, snd: s6 } => Pair { fst: CAssign(id, path, through, v), snd: s6 }
              }
            }
          }
        }
      } else if Nat::eq(tag, 11) {
        match w_cps(f, s2) {
          Pair { fst: c, snd: s3 } => match w_cps(f, s3) {
            Pair { fst: b, snd: s4 } => match w_bool(s4) {
              Pair { fst: t, snd: s5 } => Pair { fst: CWhile(c, b, t), snd: s5 }
            }
          }
        }
      } else if Nat::eq(tag, 12) {
        match w_cps(f, s2) {
          Pair { fst: v, snd: s3 } => Pair { fst: CReturn(v), snd: s3 }
        }
      } else if Nat::eq(tag, 13) {
        match w_cps(f, s2) {
          Pair { fst: scrut, snd: s3 } => match w_nat(s3) {
            Pair { fst: n, snd: s4 } => match w_arms(f, n, s4) {
              Pair { fst: arms, snd: s5 } => match arms {
                Pair { fst: ps, snd: gb } => match gb {
                  Pair { fst: gs, snd: bs } => Pair {
                    fst: CMatch(scrut, ps, gs, bs),
                    snd: s5
                  }
                }
              }
            }
          }
        }
      } else if Nat::eq(tag, 14) {
        match w_cps(f, s2) {
          Pair { fst: body, snd: s3 } => match w_count_nats(s3) {
            Pair { fst: params, snd: s4 } => match w_count_nats(s4) {
              Pair { fst: caps, snd: s5 } => match w_bool(s5) {
                Pair { fst: borrowed, snd: s6 } => match w_nat(s6) {
                  Pair { fst: nrefs, snd: s7 } => match w_ref_pairs(nrefs, s7) {
                    Pair { fst: refs, snd: s8 } => Pair {
                      fst: CClosure(body, params, caps, borrowed, refs),
                      snd: s8
                    }
                  }
                }
              }
            }
          }
        }
      } else if Nat::eq(tag, 15) {
        match w_text(s2) {
          Pair { fst: op, snd: s3 } => match w_nat(s3) {
            Pair { fst: q, snd: s4 } => match w_list(f, s4) {
              Pair { fst: args, snd: s5 } => Pair { fst: CPerform(op, q, args), snd: s5 }
            }
          }
        }
      } else if Nat::eq(tag, 16) {
        match w_cps(f, s2) {
          Pair { fst: body, snd: s3 } => match w_nat(s3) {
            Pair { fst: n, snd: s4 } => match w_handler_arms(f, n, s4) {
              Pair { fst: arms, snd: s5 } => match arms {
                Pair { fst: ops, snd: r } => match r {
                  Pair { fst: pss, snd: kb } => match kb {
                    Pair { fst: ks, snd: bs } => match w_nat(s5) {
                      Pair { fst: hasret, snd: s6 } => match w_arms(f, hasret, s6) {
                        Pair { fst: rarms, snd: s7 } => match rarms {
                          Pair { fst: rps, snd: rgb } => match rgb {
                            Pair { fst: rgs, snd: rbs } => Pair {
                              fst: CHandle(body, ops, pss, ks, bs, rps, rgs, rbs),
                              snd: s7
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else if Nat::eq(tag, 17) {
        match w_nat(s2) {
          Pair { fst: id, snd: s3 } => match w_path(s3) {
            Pair { fst: path, snd: s4 } => match w_bool(s4) {
              Pair { fst: through, snd: s5 } => Pair {
                fst: CBorrow(id, path, through),
                snd: s5
              }
            }
          }
        }
      } else if Nat::eq(tag, 18) {
        match w_bool(s2) {
          Pair { fst: memory, snd: s3 } => match w_cps(f, s3) {
            Pair { fst: steps, snd: s4 } => match w_cps(f, s4) {
              Pair { fst: body, snd: s5 } => Pair {
                fst: CBudget(memory, steps, body),
                snd: s5
              }
            }
          }
        }
      } else {
        Pair { fst: CPure(CvUnit), snd: w_bad(s2) }
      }
    }
  }

  pub fn w_list(fuel: Nat, s: WS): Pair(List(Cps), WS) {
    match fuel {
      Zero => Pair { fst: Nil, snd: w_bad(s) }
      Succ(f) => match w_nat(s) {
        Pair { fst: n, snd: s2 } => w_items(f, n, s2)
      }
    }
  }

  pub fn w_items(fuel: Nat, n: Nat, s: WS): Pair(List(Cps), WS) {
    match fuel {
      Zero => Pair { fst: Nil, snd: w_bad(s) }
      Succ(f) => match n {
        Zero => Pair { fst: Nil, snd: s }
        Succ(m) => match w_cps(f, s) {
          Pair { fst: e, snd: s2 } => match w_items(f, m, s2) {
            Pair { fst: es, snd: s3 } => Pair { fst: Cons(e, es), snd: s3 }
          }
        }
      }
    }
  }

  pub fn w_arms(fuel: Nat, n: Nat, s: WS): Pair(Pair(List(CPat), Pair(List(Cps), List(Cps))), WS) {
    match fuel {
      Zero => Pair {
        fst: Pair { fst: Nil(<A: CPat>), snd: Pair { fst: Nil(<A: Cps>), snd: Nil(<A: Cps>) } },
        snd: w_bad(s)
      }
      Succ(f) => match n {
        Zero => Pair {
          fst: Pair { fst: Nil(<A: CPat>), snd: Pair { fst: Nil(<A: Cps>), snd: Nil(<A: Cps>) } },
          snd: s
        }
        Succ(m) => match w_pat(f, s) {
          Pair { fst: p, snd: s2 } => match w_cps(f, s2) {
            Pair { fst: g, snd: s3 } => match w_cps(f, s3) {
              Pair { fst: b, snd: s4 } => match w_arms(f, m, s4) {
                Pair { fst: rest, snd: s5 } => match rest {
                  Pair { fst: ps, snd: gb } => match gb {
                    Pair { fst: gs, snd: bs } => Pair {
                      fst: Pair {
                        fst: Cons(p, ps),
                        snd: Pair { fst: Cons(g, gs), snd: Cons(b, bs) }
                      },
                      snd: s5
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // `n` arms of a `handle`: each an operation, its patterns, the local of its
  // continuation (plus one; 0 for none) and a body.
  pub fn w_handler_arms(
    fuel: Nat,
    n: Nat,
    s: WS
  ): Pair(Pair(List(Text), Pair(List(List(CPat)), Pair(List(Nat), List(Cps)))), WS) {
    match fuel {
      Zero => Pair {
        fst: Pair { fst: Nil, snd: Pair { fst: Nil, snd: Pair { fst: Nil, snd: Nil } } },
        snd: w_bad(s)
      }
      Succ(f) => match n {
        Zero => Pair {
          fst: Pair { fst: Nil, snd: Pair { fst: Nil, snd: Pair { fst: Nil, snd: Nil } } },
          snd: s
        }
        Succ(m) => match w_text(s) {
          Pair { fst: op, snd: s2 } => match w_nat(s2) {
            Pair { fst: np, snd: s3 } => match w_pats(f, np, s3) {
              Pair { fst: ps, snd: s4 } => match w_nat(s4) {
                Pair { fst: k, snd: s5 } => match w_cps(f, s5) {
                  Pair { fst: b, snd: s6 } => match w_handler_arms(f, m, s6) {
                    Pair { fst: rest, snd: s7 } => match rest {
                      Pair { fst: ops, snd: r } => match r {
                        Pair { fst: pss, snd: kb } => match kb {
                          Pair { fst: ks, snd: bs } => Pair {
                            fst: Pair {
                              fst: Cons(op, ops),
                              snd: Pair {
                                fst: Cons(ps, pss),
                                snd: Pair { fst: Cons(k, ks), snd: Cons(b, bs) }
                              }
                            },
                            snd: s7
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub fn w_fns(fuel: Nat, n: Nat, s: WS): Pair(List(CFn), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_count_nats(s) {
      Pair { fst: params, snd: s2 } => match w_cps(fuel, s2) {
        Pair { fst: body, snd: s3 } => match w_fns(fuel, m, s3) {
          Pair { fst: fs, snd: s4 } => Pair { fst: Cons(Cfn(params, body), fs), snd: s4 }
        }
      }
    }
  }
}

pub fn w_ctors(n: Nat, s: WS): Pair(List(MCtor), WS) {
  match n {
    Zero => Pair { fst: Nil, snd: s }
    Succ(m) => match w_text(s) {
      Pair { fst: name, snd: s2 } => match w_bool(s2) {
        Pair { fst: named, snd: s3 } => match w_nat(s3) {
          Pair { fst: count, snd: s4 } => match w_texts(count, s4) {
            Pair { fst: names, snd: s5 } => match w_ctors(m, s5) {
              Pair { fst: cs, snd: s6 } => Pair {
                fst: Cons(Mctor(name, named, names), cs),
                snd: s6
              }
            }
          }
        }
      }
    }
  }
}

// A program: the count of functions and each (its parameters, its body); the count of
// constructors and each (name, named, count of field names, the names); the main function.
// Nothing may follow.
pub fn read_program(bs: List(Nat)): Option(CProgram) {
  match w_tokens(Succ(List::length(bs)), bs) {
    None => None
    Some(tokens) => {
      let fuel := Succ(List::length(tokens))
      let s := Ws(tokens, true)
      match w_nat(s) {
        Pair { fst: nfns, snd: s2 } => match w_fns(fuel, nfns, s2) {
          Pair { fst: fns, snd: s3 } => match w_nat(s3) {
            Pair { fst: nctors, snd: s4 } => match w_ctors(nctors, s4) {
              Pair { fst: ctors, snd: s5 } => match w_nat(s5) {
                Pair { fst: main, snd: s6 } => match s6 {
                  Ws(rest, ok) => match rest {
                    Nil => if ok { Some(Cprogram(fns, ctors, main)) } else { None }
                    _ => None
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
