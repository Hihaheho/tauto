import "compile.taut"
import "../../scan/src/scan.taut"
import "cps.taut"
import "mval.taut"
import "../../synrun/src/syntab.taut"
import "../../synrun/src/read.taut"
import std::int
import std::base
import std::float
import std::array
import std::text

// The continuation-passing form of a program, as `INPUT.md` defines it (this reader and
// `cps.taut` are that definition; a producer follows them): numbers in decimal separated by
// spaces, each node a tag and then its parts in order, each list its length and then its
// items. A text is `t`, its length in bytes, one space, and the bytes. A malformed input
// reads as `None`, never as a program.

pub fn w_int(s: WS): Int × WS {
  match w_bool(s) {
    #(neg, s2) => match w_nat(s2) {
      #(n, s3) => #(m_int_signed(neg, n), s3)
    }
  }
}

pub fn w_val(s: WS): CVal × WS {
  match w_nat(s) {
    #(tag, s2) => if Nat::eq(tag, 0) {
      #(CvUnit, s2)
    } else if Nat::eq(tag, 1) {
      match w_int(s2) {
        #(i, s3) => #(CvInt(i), s3)
      }
    } else if Nat::eq(tag, 2) {
      match w_nat(s2) {
        #(bits, s3) => #(CvFloat(Float::of_raw(bits)), s3)
      }
    } else if Nat::eq(tag, 3) {
      match w_bool(s2) {
        #(b, s3) => #(CvBool(b), s3)
      }
    } else if Nat::eq(tag, 4) {
      match w_text(s2) {
        #(t, s3) => #(CvText(t), s3)
      }
    } else if Nat::eq(tag, 5) {
      match w_nat(s2) {
        #(f, s3) => #(CvFn(f), s3)
      }
    } else if Nat::eq(tag, 6) {
      match w_nat(s2) {
        #(slot, s3) => #(CvDeclaration(slot), s3)
      }
    } else {
      #(CvUnit, w_bad(s2))
    }
  }
}

pub fn w_step(s: WS): MPath × WS {
  match w_nat(s) {
    #(tag, s2) => if Nat::eq(tag, 1) {
      match w_text(s2) {
        #(t, s3) => #(MpathName(t), s3)
      }
    } else {
      match w_nat(s2) {
        #(i, s3) => if Nat::eq(tag, 0) {
          #(MpathIndex(i), s3)
        } else if Nat::eq(tag, 2) {
          #(MpathItem(i), s3)
        } else {
          #(MpathIndex(i), w_bad(s3))
        }
      }
    }
  }
}

pub fn w_steps(n: Nat, s: WS): List(MPath) × WS {
  match n {
    Zero => #(Nil, s)
    Succ(m) => match w_step(s) {
      #(x, s2) => match w_steps(m, s2) {
        #(xs, s3) => #(Cons(x, xs), s3)
      }
    }
  }
}

pub fn w_path(s: WS): List(MPath) × WS {
  match w_nat(s) {
    #(n, s2) => w_steps(n, s2)
  }
}

mutual {
  pub fn w_pat(fuel: Nat, s: WS): CPat × WS {
    match fuel {
      Zero => #(CpWild, w_bad(s))
      Succ(f) => match w_nat(s) {
        #(tag, s2) => if Nat::eq(tag, 0) {
          #(CpWild, s2)
        } else if Nat::eq(tag, 1) {
          match w_nat(s2) {
            #(id, s3) => match w_bool(s3) {
              #(r#borrow, s4) => #(CpBind(id, r#borrow), s4)
            }
          }
        } else if Nat::eq(tag, 2) {
          match w_val(s2) {
            #(v, s3) => #(CpLit(v), s3)
          }
        } else if Nat::eq(tag, 3) { match w_nat(s2) {
            #(c, s3) => match w_nat(s3) {
              #(n, s4) => match w_pats(f, n, s4) {
                #(ps, s5) => #(CpCtor(c, ps), s5)
              }
            }
          } } else if Nat::eq(tag, 4) {
          match w_nat(s2) {
            #(n, s3) => match w_pats(f, n, s3) {
              #(ps, s4) => #(CpProduct(ps), s4)
            }
          }
        } else if Nat::eq(tag, 5) {
          match w_nat(s2) {
            #(v, s3) => match w_pat(f, s3) {
              #(p, s4) => #(CpVariant(v, p), s4)
            }
          }
        } else { #(CpWild, w_bad(s2)) }
      }
    }
  }

  pub fn w_pats(fuel: Nat, n: Nat, s: WS): List(CPat) × WS {
    match fuel {
      Zero => #(Nil, w_bad(s))
      Succ(f) => match n {
        Zero => #(Nil, s)
        Succ(m) => match w_pat(f, s) {
          #(p, s2) => match w_pats(f, m, s2) {
            #(ps, s3) => #(Cons(p, ps), s3)
          }
        }
      }
    }
  }
}

pub fn w_picks(n: Nat, s: WS): List(Nat × Option(Nat)) × WS {
  match n {
    Zero => #(Nil, s)
    Succ(m) => match w_nat(s) {
      #(i, s2) => match w_bool(s2) {
        #(has, s3) => {
          let jr := ⊢ (Option(Nat) × WS) from match has {
            false => #(None, s3)
            true => match w_nat(s3) {
              #(j, s4) => #(Some(j), s4)
            }
          }
          match jr {
            #(j, s4) => match w_picks(m, s4) {
              #(rest, s5) => #(Cons(#(i, j), rest), s5)
            }
          }
        }
      }
    }
  }
}

pub fn w_options(n: Nat, s: WS): List(Option(Nat)) × WS {
  match n {
    Zero => #(Nil, s)
    Succ(m) => match w_bool(s) {
      #(has, s2) => {
        let jr := ⊢ (Option(Nat) × WS) from match has {
          false => #(None, s2)
          true => match w_nat(s2) {
            #(j, s3) => #(Some(j), s3)
          }
        }
        match jr {
          #(j, s3) => match w_options(m, s3) {
            #(rest, s4) => #(Cons(j, rest), s4)
          }
        }
      }
    }
  }
}


pub fn w_prim(s: WS): CPrim × WS {
  match w_nat(s) {
    #(tag, s2) => if Nat::eq(tag, 0) {
      match w_nats(2, s2) {
        #(aw, s3) => #(CprArith(m_nth_nat(aw, 0), m_nth_nat(aw, 1)), s3)
      }
    } else if Nat::eq(tag, 1) {
      match w_nat(s2) {
        #(a, s3) => #(CprFloat(a), s3)
      }
    } else if Nat::eq(tag, 2) {
      match w_nat(s2) {
        #(c, s3) => #(CprCmp(c), s3)
      }
    } else if Nat::eq(tag, 3) {
      match w_bool(s2) {
        #(n, s3) => #(CprEq(n), s3)
      }
    } else if Nat::eq(tag, 4) {
      match w_nat(s2) {
        #(c, s3) => match w_count_nats(s3) {
          #(order, s4) => #(CprConstruct(c, order), s4)
        }
      }
    } else if Nat::eq(tag, 5) {
      match w_nat(s2) {
        #(n, s3) => match w_picks(n, s3) {
          #(picks, s4) => #(CprProduct(picks), s4)
        }
      }
    } else if Nat::eq(tag, 6) {
      #(CprConcat, s2)
    } else if Nat::eq(tag, 7) {
      #(CprTextOfInt, s2)
    } else if Nat::eq(tag, 8) {
      #(CprTextLen, s2)
    } else if Nat::eq(tag, 9) {
      #(CprTextCompare, s2)
    } else if Nat::eq(tag, 10) {
      match w_bool(s2) {
        #(m, s3) => match w_nat(s3) {
          #(w, s4) => #(CprDivide(m, w), s4)
        }
      }
    } else if Nat::eq(tag, 11) {
      match w_nat(s2) {
        #(a, s3) => #(CprFloat32(a), s3)
      }
    } else if Nat::eq(tag, 12) {
      match w_syn_parser(s2) {
        #(p, s3) => match p {
          None => #(CprConcat, w_bad(s3))
          Some(x) => #(CprSynParse(x), s3)
        }
      }
    } else {
      #(CprConcat, w_bad(s2))
    }
  }
}

pub fn w_unary(s: WS): CUnary × WS {
  match w_nat(s) {
    #(tag, s2) => if Nat::eq(tag, 0) {
      #(CuNot, s2)
    } else if Nat::eq(tag, 1) {
      match w_nat(s2) {
        #(i, s3) => #(CuMember(i), s3)
      }
    } else if Nat::eq(tag, 2) {
      match w_step(s2) {
        #(st, s3) => #(CuField(st), s3)
      }
    } else if Nat::eq(tag, 3) {
      #(CuShown, s2)
    } else if Nat::eq(tag, 4) {
      #(CuTempRef, s2)
    } else if Nat::eq(tag, 5) {
      #(CuDeref, s2)
    } else if Nat::eq(tag, 6) {
      match w_nats(2, s2) {
        #(ui, s3) => #(CuInject(m_nth_nat(ui, 0), m_nth_nat(ui, 1)), s3)
      }
    } else if Nat::eq(tag, 7) {
      match w_options(1, s2) {
        #(to, s3) => match w_nat(s3) {
          #(n, s4) => match w_options(n, s4) {
            #(table, s5) => #(CuRemap(match List::nth(to, 0) {
                None => None
                Some(t) => t
              }, table), s5)
          }
        }
      }
    } else {
      #(CuNot, w_bad(s2))
    }
  }
}

pub fn w_ref_pairs(n: Nat, s: WS): List(Nat × Nat) × WS {
  match n {
    Zero => #(Nil, s)
    Succ(m) => match w_nats(2, s) {
      #(io, s2) => match w_ref_pairs(m, s2) {
        #(rest, s3) => #(Cons(#(m_nth_nat(io, 0), m_nth_nat(io, 1)), rest), s3)
      }
    }
  }
}

// A node: its tag, then its parts (the table of `INPUT.md`). `fuel` bounds
// the depth.
mutual {
  pub fn w_cps(fuel: Nat, s: WS): Cps × WS {
    match fuel {
      Zero => #(CPure(CvUnit), w_bad(s))
      Succ(f) => match w_nat(s) {
        #(tag, s2) => if Nat::lt(
          tag,
          10
        ) { w_cps_0(f, tag, s2) } else { w_cps_10(f, tag, s2) }
      }
    }
  }

  pub fn w_cps_0(fuel: Nat, tag: Nat, s2: WS): Cps × WS {
    match fuel {
      Zero => #(CPure(CvUnit), w_bad(s2))
      Succ(f) => if Nat::eq(tag, 0) {
        match w_val(s2) {
          #(v, s3) => #(CPure(v), s3)
        }
      } else if Nat::eq(tag, 1) {
        match w_nat(s2) {
          #(id, s3) => match w_bool(s3) {
            #(d, s4) => #(CRead(id, d), s4)
          }
        }
      } else if Nat::eq(tag, 2) {
        match w_cps(f, s2) {
          #(callee, s3) => match w_list(f, s3) {
            #(args, s4) => match w_bool(s4) {
              #(t, s5) => #(CCall(callee, args, t), s5)
            }
          }
        }
      } else if Nat::eq(tag, 3) {
        match w_nat(s2) {
          #(inst, s3) => match w_list(f, s3) {
            #(args, s4) => match w_bool(s4) {
              #(t, s5) => #(CTail(inst, args, t), s5)
            }
          }
        }
      } else if Nat::eq(tag, 4) {
        match w_text(s2) {
          #(name, s3) => match w_list(f, s3) {
            #(args, s4) => #(CBuiltin(name, args), s4)
          }
        }
      } else if Nat::eq(tag, 5) {
        match w_prim(s2) {
          #(op, s3) => match w_list(f, s3) {
            #(args, s4) => #(MkCPrim(op, args), s4)
          }
        }
      } else if Nat::eq(tag, 6) {
        match w_cps(f, s2) {
          #(v, s3) => match w_unary(s3) {
            #(op, s4) => #(CMap(v, op), s4)
          }
        }
      } else if Nat::eq(tag, 7) {
        match w_cps(f, s2) {
          #(c, s3) => match w_cps(f, s3) {
            #(t, s4) => match w_cps(f, s4) {
              #(o, s5) => #(CBranch(c, t, o), s5)
            }
          }
        }
      } else if Nat::eq(tag, 8) {
        match w_list(f, s2) {
          #(items, s3) => #(CSeq(items), s3)
        }
      } else {
        match w_nat(s2) {
          #(id, s3) => match w_bool(s3) {
            #(r#shared, s4) => match w_bool(s4) {
              #(drop, s5) => match w_cps(f, s5) {
                #(init, s6) => #(CDefine(id, r#shared, drop, init), s6)
              }
            }
          }
        }
      }
    }
  }

  pub fn w_cps_10(fuel: Nat, tag: Nat, s2: WS): Cps × WS {
    match fuel {
      Zero => #(CPure(CvUnit), w_bad(s2))
      Succ(f) => if Nat::eq(tag, 10) {
        match w_nat(s2) {
          #(id, s3) => match w_path(s3) {
            #(path, s4) => match w_bool(s4) {
              #(through, s5) => match w_cps(f, s5) {
                #(v, s6) => #(CAssign(id, path, through, v), s6)
              }
            }
          }
        }
      } else if Nat::eq(tag, 11) {
        match w_cps(f, s2) {
          #(c, s3) => match w_cps(f, s3) {
            #(b, s4) => match w_bool(s4) {
              #(t, s5) => #(CWhile(c, b, t), s5)
            }
          }
        }
      } else if Nat::eq(tag, 12) {
        match w_cps(f, s2) {
          #(v, s3) => #(CReturn(v), s3)
        }
      } else if Nat::eq(tag, 13) {
        match w_cps(f, s2) {
          #(scrut, s3) => match w_nat(s3) {
            #(n, s4) => match w_arms(f, n, s4) {
              #(arms, s5) => match arms {
                #(ps, gb) => match gb {
                  #(gs, bs) => #(CMatch(scrut, ps, gs, bs), s5)
                }
              }
            }
          }
        }
      } else if Nat::eq(tag, 14) {
        match w_cps(f, s2) {
          #(body, s3) => match w_count_nats(s3) {
            #(params, s4) => match w_count_nats(s4) {
              #(caps, s5) => match w_bool(s5) {
                #(borrowed, s6) => match w_nat(s6) {
                  #(nrefs, s7) => match w_ref_pairs(nrefs, s7) {
                    #(refs, s8) => #(CClosure(body, params, caps, borrowed, refs), s8)
                  }
                }
              }
            }
          }
        }
      } else if Nat::eq(tag, 15) {
        match w_text(s2) {
          #(op, s3) => match w_nat(s3) {
            #(q, s4) => match w_list(f, s4) {
              #(args, s5) => #(CPerform(op, q, args), s5)
            }
          }
        }
      } else if Nat::eq(tag, 16) {
        match w_cps(f, s2) {
          #(body, s3) => match w_nat(s3) {
            #(n, s4) => match w_handler_arms(f, n, s4) {
              #(arms, s5) => match arms {
                #(ops, r) => match r {
                  #(pss, kb) => match kb {
                    #(ks, bs) => match w_nat(s5) {
                      #(hasret, s6) => match w_arms(f, hasret, s6) {
                        #(rarms, s7) => match rarms {
                          #(rps, rgb) => match rgb {
                            #(rgs, rbs) => #(CHandle(body, ops, pss, ks, bs, rps, rgs, rbs), s7)
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else if Nat::eq(tag, 17) {
        match w_nat(s2) {
          #(id, s3) => match w_path(s3) {
            #(path, s4) => match w_bool(s4) {
              #(through, s5) => #(CBorrow(id, path, through), s5)
            }
          }
        }
      } else if Nat::eq(tag, 18) {
        match w_bool(s2) {
          #(memory, s3) => match w_cps(f, s3) {
            #(steps, s4) => match w_cps(f, s4) {
              #(body, s5) => #(CBudget(memory, steps, body), s5)
            }
          }
        }
      } else if Nat::eq(tag, 19) {
        match w_nat(s2) {
          #(id, s3) => #(CTake(id), s3)
        }
      } else if Nat::eq(tag, 20) {
        #(CSweep, s2)
      } else if Nat::eq(tag, 21) {
        match w_text(s2) {
          #(name, s3) => match w_list(f, s3) {
            #(args, s4) => #(CExtern(name, args), s4)
          }
        }
      } else {
        #(CPure(CvUnit), w_bad(s2))
      }
    }
  }

  pub fn w_list(fuel: Nat, s: WS): List(Cps) × WS {
    match fuel {
      Zero => #(Nil, w_bad(s))
      Succ(f) => match w_nat(s) {
        #(n, s2) => w_items(f, n, s2)
      }
    }
  }

  pub fn w_items(fuel: Nat, n: Nat, s: WS): List(Cps) × WS {
    match fuel {
      Zero => #(Nil, w_bad(s))
      Succ(f) => match n {
        Zero => #(Nil, s)
        Succ(m) => match w_cps(f, s) {
          #(e, s2) => match w_items(f, m, s2) {
            #(es, s3) => #(Cons(e, es), s3)
          }
        }
      }
    }
  }

  pub fn w_arms(fuel: Nat, n: Nat, s: WS): (List(CPat) × List(Cps) × List(Cps)) × WS {
    match fuel {
      Zero => #(#(Nil(<A: CPat>), Nil(<A: Cps>), Nil(<A: Cps>)), w_bad(s))
      Succ(f) => match n {
        Zero => #(#(Nil(<A: CPat>), Nil(<A: Cps>), Nil(<A: Cps>)), s)
        Succ(m) => match w_pat(f, s) {
          #(p, s2) => match w_cps(f, s2) {
            #(g, s3) => match w_cps(f, s3) {
              #(b, s4) => match w_arms(f, m, s4) {
                #(rest, s5) => match rest {
                  #(ps, gb) => match gb {
                    #(gs, bs) => #(#(Cons(p, ps), Cons(g, gs), Cons(b, bs)), s5)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // `n` arms of a `handle`: each an operation, its patterns, the local of its
  // continuation (plus one; 0 for none) and a body.
  pub fn w_handler_arms(
    fuel: Nat,
    n: Nat,
    s: WS
  ): (List(Text) × List(List(CPat)) × List(Nat) × List(Cps)) × WS {
    match fuel {
      Zero => #(#(Nil, Nil, Nil, Nil), w_bad(s))
      Succ(f) => match n {
        Zero => #(#(Nil, Nil, Nil, Nil), s)
        Succ(m) => match w_text(s) {
          #(op, s2) => match w_nat(s2) {
            #(np, s3) => match w_pats(f, np, s3) {
              #(ps, s4) => match w_nat(s4) {
                #(k, s5) => match w_cps(f, s5) {
                  #(b, s6) => match w_handler_arms(f, m, s6) {
                    #(rest, s7) => match rest {
                      #(ops, r) => match r {
                        #(pss, kb) => match kb {
                          #(ks, bs) => #(#(Cons(op, ops), Cons(ps, pss), Cons(k, ks), Cons(b, bs)), s7)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub fn w_fns(fuel: Nat, n: Nat, s: WS): List(CFn) × WS {
  match n {
    Zero => #(Nil, s)
    Succ(m) => match w_count_nats(s) {
      #(params, s2) => match w_cps(fuel, s2) {
        #(body, s3) => match w_fns(fuel, m, s3) {
          #(fs, s4) => #(Cons(Cfn(params, body), fs), s4)
        }
      }
    }
  }
}

pub fn w_ctors(n: Nat, s: WS): List(MCtor) × WS {
  match n {
    Zero => #(Nil, s)
    Succ(m) => match w_text(s) {
      #(name, s2) => match w_bool(s2) {
        #(named, s3) => match w_nat(s3) {
          #(count, s4) => match w_texts(count, s4) {
            #(names, s5) => match w_ctors(m, s5) {
              #(cs, s6) => #(Cons(Mctor(name, named, names), cs), s6)
            }
          }
        }
      }
    }
  }
}

// A program: the count of functions and each (its parameters, its body); the count of
// constructors and each (name, named, count of field names, the names); the main function.
// Nothing may follow.
pub fn read_program(source: Text): Option(CProgram) {
  match w_tokens(Succ(Text::len(source)), source, 0) {
    None => None
    Some(tokens) => {
      let fuel := Succ(List::length(tokens))
      let s := Ws(tokens, true)
      match w_nat(s) {
        #(nfns, s2) => match w_fns(fuel, nfns, s2) {
          #(fns, s3) => match w_nat(s3) {
            #(nctors, s4) => match w_ctors(nctors, s4) {
              #(ctors, s5) => match w_nat(s5) {
                #(main, s6) => match s6 {
                  Ws(rest, ok) => match rest {
                    Nil => if ok { Some(Cprogram(fns, ctors, main)) } else { None }
                    _ => None
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
