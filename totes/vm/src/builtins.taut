// The runtime library's functions (`Cps::Builtin`), as the other backends' runtimes define
// them. A builtin is called by its number in `m_builtin_names`. What only the host can do
// it asks of the shell (`mout_ask`); the tasks' functions are the scheduler's
// (`machine.taut`).

pub(open) inductive MOut: Type {
  MoutVal(v: MVal, cx: MCx): MOut
  MoutErr(message: Text): MOut
  // It performs `op` with no arguments and no resumption (`out_of_bounds`, `missing`).
  MoutPerform(op: Text): MOut
  MoutAsk(name: Text, args: List(MVal), cx: MCx): MOut
  MoutExit(code: Int): MOut
  // Starts a task that runs `f`, whose result goes to the pending `p`.
  MoutSpawn(f: MVal, p: Nat, cx: MCx): MOut
  // Lets the other tasks run first, then answers whether the pending is ready.
  MoutYield(p: Nat, cx: MCx): MOut
}

