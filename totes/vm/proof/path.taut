import std::array
import "../src/mval.taut"
import "../src/seq.taut"
import std::list
import std::base

pub fn m_at_reference(ctors: Array(MCtor), v: MVal, s: MPath): MVal {
  match s {
    MpathPayload => match v {
      MvInject(^u, ^j, x) => x
      _ => v
    }
    _ => m_at_step_reference(ctors, v, s)
  }
}

// A step into a part of the value, through the unions around it.
pub fn m_at_step_reference(ctors: Array(MCtor), v: MVal, s: MPath): MVal {
  match v {
    MvInject(^u, ^j, x) => m_at_step_reference(ctors, x, s)
    _ => match m_step_index(ctors, v, s) {
      None => MvUnit
      Some(i) => match v {
        MvData(^c, fs) => m_nth_or_unit(fs, i)
        MvProduct(ms) => m_nth_or_unit(ms, i)
        MvVec(xs) => ms_get_or(MvUnit, xs, i)
        MvArray(xs) => ms_get_or(MvUnit, xs, i)
        MvSlots(^st, ^vac, ^ms, xs) => ms_get_or(MvMoved, xs, i)
        _ => MvUnit
      }
    }
  }
}

pub theorem m_at_correct(
  ctors: Array(MCtor),
  v: MVal,
  s: MPath
): Eq(MVal, m_at(ctors, v, s), m_at_reference(ctors, v, s)) {
  match v {
    MvInject(u, j, x) => match s {
      MpathIndex(i) => m_at_correct(ctors, x, MpathIndex(i))
      MpathItem(i) => m_at_correct(ctors, x, MpathItem(i))
      MpathName(n) => m_at_correct(ctors, x, MpathName(n))
      MpathPayload => Refl
    }
    _ => match s {
      MpathIndex(i) => Refl
      MpathItem(i) => Refl
      MpathName(n) => Refl
      MpathPayload => Refl
    }
  }
}

pub fn m_at_path_reference(ctors: Array(MCtor), v: MVal, path: List(MPath)): MVal {
  match path {
    Nil => v
    Cons(s, rest) => m_at_path_reference(ctors, m_at_reference(ctors, v, s), rest)
  }
}

pub theorem m_at_path_correct(
  ctors: Array(MCtor),
  v: MVal,
  path: List(MPath)
): Eq(MVal, m_at_path(ctors, v, path), m_at_path_reference(ctors, v, path)) {
  match path {
    Nil => Refl
    Cons(s, rest) => Eq::trans(
      m_at_path_correct(ctors, m_at(ctors, v, s), rest),
      Eq::congr((part: MVal) => m_at_path_reference(ctors, part, rest), m_at_correct(ctors, v, s))
    )
  }
}

pub theorem mr_root_correct(): Eq(List(MPath), mr_steps(MrPath(Nil)), Nil) { Refl }

pub theorem mr_from_steps_correct(
  path: List(MPath)
): Eq(List(MPath), mr_steps(MrPath(List::reverse(path))), path) {
  List::reverse_reverse(path)
}

pub theorem mr_child_correct(
  path: MRefPath,
  s: MPath
): Eq(List(MPath), mr_steps(mr_child(path, s)), List::append(mr_steps(path), Cons(s, Nil))) {
  List::reverse_cons(s, mr_reversed(path))
}

pub theorem mr_extend_correct(
  path: MRefPath,
  suffix: List(MPath)
): Eq(List(MPath), mr_steps(mr_extend(path, suffix)), List::append(mr_steps(path), suffix)) {
  match suffix {
    Nil => Eq::sym(List::append_nil(mr_steps(path)))
    Cons(x, more) => Eq::trans(
      Eq::congr(
        (steps: List(MPath)) => List::reverse(steps),
        List::reverse_onto_append(Cons(x, more), mr_reversed(path))
      ),
      Eq::trans(
        List::reverse_append(List::reverse(Cons(x, more)), mr_reversed(path)),
        Eq::congr(
          (steps: List(MPath)) => List::append(List::reverse(mr_reversed(path)), steps),
          List::reverse_reverse(Cons(x, more))
        )
      )
    )
  }
}

pub theorem m_at_path_append(
  ctors: Array(MCtor),
  v: MVal,
  prefix: List(MPath),
  suffix: List(MPath)
): Eq(
  MVal,
  m_at_path(ctors, v, List::append(prefix, suffix)),
  m_at_path(ctors, m_at_path(ctors, v, prefix), suffix)
) {
  match prefix {
    Nil => Refl
    Cons(s, rest) => m_at_path_append(ctors, m_at(ctors, v, s), rest, suffix)
  }
}

pub theorem m_at_reversed_cons(
  ctors: Array(MCtor),
  v: MVal,
  s: MPath,
  rest: List(MPath)
): Eq(MVal, m_at_reversed(ctors, v, Cons(s, rest)), m_at(ctors, m_at_reversed(ctors, v, rest), s)) {
  match s {
    MpathIndex(i) => Refl
    MpathItem(i) => Refl
    MpathName(n) => Refl
    MpathPayload => Refl
  }
}

pub theorem m_at_reversed_correct(
  ctors: Array(MCtor),
  v: MVal,
  reversed: List(MPath)
): Eq(MVal, m_at_reversed(ctors, v, reversed), m_at_path(ctors, v, List::reverse(reversed))) {
  match reversed {
    Nil => Refl
    Cons(s, rest) => Eq::trans(
      m_at_reversed_cons(ctors, v, s, rest),
      Eq::trans(
        Eq::congr((part: MVal) => m_at(ctors, part, s), m_at_reversed_correct(ctors, v, rest)),
        Eq::trans(
          Eq::sym(m_at_path_append(ctors, v, List::reverse(rest), Cons(s, Nil))),
          Eq::congr(
            (steps: List(MPath)) => m_at_path(ctors, v, steps),
            Eq::sym(List::reverse_cons(s, rest))
          )
        )
      )
    )
  }
}

pub theorem m_at_ref_correct(
  ctors: Array(MCtor),
  v: MVal,
  path: MRefPath
): Eq(MVal, m_at_ref(ctors, v, path), m_at_path_reference(ctors, v, mr_steps(path))) {
  Eq::trans(
    m_at_reversed_correct(ctors, v, mr_reversed(path)),
    m_at_path_correct(ctors, v, List::reverse(mr_reversed(path)))
  )
}

pub theorem m_put_correct(
  ctors: Array(MCtor),
  cx: MCx,
  cell: Nat,
  path: MRefPath,
  x: MVal
): Eq(
  MCx,
  m_put(ctors, cx, cell, path, x),
  cx_put(cx, cell, MoCell(m_with_path(ctors, cx_cell(cx, cell), mr_steps(path), x)))
) {
  Refl
}

// What a borrow names, decoding the path before the heap lookup unless `MrSeen` keeps the
// value and no cell has been written since.
pub fn m_ref_at_reference(ctors: Array(MCtor), cx: MCx, cell: Nat, path: MRefPath): MVal {
  match path {
    MrPath(reversed) => m_at_path_reference(ctors, cx_cell(cx, cell), List::reverse(reversed))
    MrSeen(reversed, at, writes) => if Nat::eq(writes, cx_writes(cx)) {
      at
    } else {
      m_at_path_reference(ctors, cx_cell(cx, cell), List::reverse(reversed))
    }
  }
}

pub theorem m_ref_at_correct(
  ctors: Array(MCtor),
  cx: MCx,
  cell: Nat,
  path: MRefPath
): Eq(MVal, m_ref_at(ctors, cx, cell, path), m_ref_at_reference(ctors, cx, cell, path)) {
  match path {
    MrPath(reversed) => m_at_ref_correct(ctors, cx_cell(cx, cell), MrPath(reversed))
    MrSeen(reversed, at, writes) => Eq::congr(
      (walked: MVal) => if Nat::eq(writes, cx_writes(cx)) { at } else { walked },
      m_at_ref_correct(ctors, cx_cell(cx, cell), MrPath(reversed))
    )
  }
}

// A path one step further down keeps the value at its end, when the path it extends kept
// the value at its own end (or kept nothing).
pub theorem mr_child_seen_correct(
  ctors: Array(MCtor),
  cx: MCx,
  cell: Nat,
  path: MRefPath,
  s: MPath,
  kept: Eq(MVal, m_ref_at(ctors, cx, cell, path), m_at_ref(ctors, cx_cell(cx, cell), path))
): Eq(
  MVal,
  m_ref_at(ctors, cx, cell, mr_child_seen(ctors, cx, cell, path, s)),
  m_at_ref(ctors, cx_cell(cx, cell), mr_child(path, s))
) {
  Eq::trans(
    Eq::congr(
      (b: Bool) => if b {
        m_at(ctors, m_ref_at(ctors, cx, cell, path), s)
      } else {
        m_at_reversed(ctors, cx_cell(cx, cell), Cons(s, mr_reversed(path)))
      },
      Nat::eq_refl(cx_writes(cx))
    ),
    Eq::trans(
      Eq::congr((part: MVal) => m_at(ctors, part, s), kept),
      Eq::sym(m_at_reversed_cons(ctors, cx_cell(cx, cell), s, mr_reversed(path)))
    )
  )
}

// Reference dereferencing decodes the path before each heap lookup. Its fuel
// bounds chains of references, including cycles, independently of path length.
pub fn m_get_fuel_reference(fuel: Nat, ctors: Array(MCtor), cx: MCx, v: MVal): MVal {
  match fuel {
    Zero => v
    Succ(f) => match v {
      MvRef(cell, path) => m_get_fuel_reference(
        f,
        ctors,
        cx,
        m_ref_at_reference(ctors, cx, cell, path)
      )
      _ => v
    }
  }
}

pub theorem m_get_fuel_correct(
  fuel: Nat,
  ctors: Array(MCtor),
  cx: MCx,
  v: MVal
): Eq(MVal, m_get_fuel(fuel, ctors, cx, v), m_get_fuel_reference(fuel, ctors, cx, v)) {
  match fuel {
    Zero => Refl
    Succ(f) => match v {
      MvRef(cell, path) => Eq::trans(
        m_get_fuel_correct(f, ctors, cx, m_ref_at(ctors, cx, cell, path)),
        Eq::congr(
          (part: MVal) => m_get_fuel_reference(f, ctors, cx, part),
          m_ref_at_correct(ctors, cx, cell, path)
        )
      )
      _ => Refl
    }
  }
}
