      a,
      comp(b, CMul(k)),
      env,
      st,
      fr,
      s3,
      n,
      hb,
      h,
      fin
    ): Back(prog, n, env, XMul(a, b), k, st, fr, s3) {
      BackMk(va, m1, lt1, eva, r1) => match back_e(
        prog,
        B,
        ih,
        b,
        CMul(k),
        env,
        Cons(va, st),
        fr,
        s3,
        m1,
        le_of_lt(m1, n, B, lt1, hb),
        r1,
        fin
      ): Back(prog, n, env, XMul(a, b), k, st, fr, s3) {
        BackMk(vb, m2, lt2, evb, r2) => match starn_next(
          r2,
          fin,
          not_final(CMul(k), env, Cons(vb, Cons(va, st)), fr, Refl)
        ): Back(prog, n, env, XMul(a, b), k, st, fr, s3) {
          NextMk(s2, m3, lt3, stp, r3) => match nat2_inv(
            Nat::mul,
            k,
            env,
            vb,
            va,
            st,
            fr,
            s2,
            stp
          ): Back(prog, n, env, XMul(a, b), k, st, fr, s3) {
            Nat2Mk(n1, n2, ea, eb, es) => BackMk(
              VNat(Nat::mul(n1, n2)),
              m3,
              lt_lt(m3, m2, n, lt3, lt_lt(m2, m1, n, lt2, lt1)),
              EvMul(
                Eq::subst(Val, va, VNat(n1), (x: Val) => Eval(prog, env, a, x), ea, eva),
                Eq::subst(Val, vb, VNat(n2), (x: Val) => Eval(prog, env, b, x), eb, evb)
              ),
              Eq::subst(
                State,
                s2,
                StateMk(k, env, Cons(VNat(Nat::mul(n1, n2)), st), fr),
                (x: State) => StarN(compile(prog), m3, x, s3),
                es,
                r3
              )
            )
          }
        }
      }
    }
    XLt(a, b) => (
      h: StarN(compile(prog), n, StateMk(comp(XLt(a, b), k), env, st, fr), s3)
    ) => match back_e(
      prog,
      B,
      ih,
      a,
      comp(b, CLt(k)),
      env,
      st,
      fr,
      s3,
      n,
      hb,
      h,
      fin
    ): Back(prog, n, env, XLt(a, b), k, st, fr, s3) {
      BackMk(va, m1, lt1, eva, r1) => match back_e(
        prog,
        B,
        ih,
        b,
        CLt(k),
        env,
        Cons(va, st),
        fr,
        s3,
        m1,
        le_of_lt(m1, n, B, lt1, hb),
        r1,
        fin
      ): Back(prog, n, env, XLt(a, b), k, st, fr, s3) {
        BackMk(vb, m2, lt2, evb, r2) => match starn_next(
          r2,
          fin,
          not_final(CLt(k), env, Cons(vb, Cons(va, st)), fr, Refl)
        ): Back(prog, n, env, XLt(a, b), k, st, fr, s3) {
          NextMk(s2, m3, lt3, stp, r3) => match nat2_inv(
            (p: Nat, q: Nat) => bool_nat(Nat::lt(p, q)),
            k,
            env,
            vb,
            va,
            st,
            fr,
            s2,
            stp
          ): Back(prog, n, env, XLt(a, b), k, st, fr, s3) {
            Nat2Mk(n1, n2, ea, eb, es) => BackMk(
              VNat(bool_nat(Nat::lt(n1, n2))),
              m3,
              lt_lt(m3, m2, n, lt3, lt_lt(m2, m1, n, lt2, lt1)),
              EvLt(
                Eq::subst(Val, va, VNat(n1), (x: Val) => Eval(prog, env, a, x), ea, eva),
                Eq::subst(Val, vb, VNat(n2), (x: Val) => Eval(prog, env, b, x), eb, evb)
              ),
              Eq::subst(
                State,
                s2,
                StateMk(k, env, Cons(VNat(bool_nat(Nat::lt(n1, n2))), st), fr),
                (x: State) => StarN(compile(prog), m3, x, s3),
                es,
                r3
              )
            )
          }
        }
      }
    }
    XLet(a, body) => (
      h: StarN(compile(prog), n, StateMk(comp(XLet(a, body), k), env, st, fr), s3)
    ) => match back_e(
      prog,
      B,
      ih,
      a,
      CBind(comp(body, CUnbind(k))),
      env,
      st,
      fr,
      s3,
      n,
      hb,
      h,
      fin
    ): Back(prog, n, env, XLet(a, body), k, st, fr, s3) {
      BackMk(va, m1, lt1, eva, r1) => match starn_inv(
        StateMk(comp(body, CUnbind(k)), Cons(va, env), st, fr),
        r1,
        fin,
        Refl
      ): Back(prog, n, env, XLet(a, body), k, st, fr, s3) {
        AfterMk(m2, lt2, r2) => match back_e(
          prog,
          B,
          ih,
          body,
          CUnbind(k),
          Cons(va, env),
          st,
          fr,
          s3,
          m2,
          le_of_lt(m2, n, B, lt_lt(m2, m1, n, lt2, lt1), hb),
          r2,
          fin
        ): Back(prog, n, env, XLet(a, body), k, st, fr, s3) {
          BackMk(v, m3, lt3, evb, r3) => match starn_inv(
            StateMk(k, env, Cons(v, st), fr),
            r3,
            fin,
            Refl
          ): Back(prog, n, env, XLet(a, body), k, st, fr, s3) {
            AfterMk(m4, lt4, r4) => BackMk(
              v,
              m4,
              lt_lt(m4, m3, n, lt4, lt_lt(m3, m2, n, lt3, lt_lt(m2, m1, n, lt2, lt1))),
              EvLet(eva, evb),
              r4
            )
          }
        }
      }
    }
    XIf(c, t, e2) => (
      h: StarN(compile(prog), n, StateMk(comp(XIf(c, t, e2), k), env, st, fr), s3)
    ) => match back_e(
      prog,
      B,
      ih,
      c,
      CBranch(comp(t, CRet), comp(e2, CRet), k),
      env,
      st,
      fr,
      s3,
      n,
      hb,
      h,
      fin
    ): Back(prog, n, env, XIf(c, t, e2), k, st, fr, s3) {
      BackMk(vc, m1, lt1, evc, r1) => match starn_next(
        r1,
        fin,
        not_final(CBranch(comp(t, CRet), comp(e2, CRet), k), env, Cons(vc, st), fr, Refl)
      ): Back(prog, n, env, XIf(c, t, e2), k, st, fr, s3) {
        NextMk(s2, m2, lt2, stp, r2) => match branch_inv(
          comp(t, CRet),
          comp(e2, CRet),
          k,
          env,
          vc,
          st,
          fr,
          s2,
          stp
        ): Back(prog, n, env, XIf(c, t, e2), k, st, fr, s3) {
          BrThen(n0, ec, es) => match back_e(
            prog,
            B,
            ih,
            t,
            CRet,
            env,
            Nil,
            Cons(FrameMk(k, env, st), fr),
            s3,
            m2,
            le_of_lt(m2, n, B, lt_lt(m2, m1, n, lt2, lt1), hb),
            Eq::subst(
              State,
              s2,
              StateMk(comp(t, CRet), env, Nil, Cons(FrameMk(k, env, st), fr)),
              (x: State) => StarN(compile(prog), m2, x, s3),
              es,
              r2
            ),
            fin
          ): Back(prog, n, env, XIf(c, t, e2), k, st, fr, s3) {
            BackMk(v, m3, lt3, evt, r3) => match starn_inv(
              StateMk(k, env, Cons(v, st), fr),
              r3,
              fin,
              Refl
            ): Back(prog, n, env, XIf(c, t, e2), k, st, fr, s3) {
              AfterMk(m4, lt4, r4) => BackMk(
                v,
                m4,
                lt_lt(m4, m3, n, lt4, lt_lt(m3, m2, n, lt3, lt_lt(m2, m1, n, lt2, lt1))),
                EvIfThen(
                  Eq::subst(Val, vc, VNat(Succ(n0)), (x: Val) => Eval(prog, env, c, x), ec, evc),
                  evt
                ),
                r4
              )
            }
          }
          BrElse(ec, es) => match back_e(
            prog,
            B,
            ih,
            e2,
            CRet,
            env,
            Nil,
            Cons(FrameMk(k, env, st), fr),
            s3,
            m2,
            le_of_lt(m2, n, B, lt_lt(m2, m1, n, lt2, lt1), hb),
            Eq::subst(
              State,
              s2,
              StateMk(comp(e2, CRet), env, Nil, Cons(FrameMk(k, env, st), fr)),
              (x: State) => StarN(compile(prog), m2, x, s3),
              es,
              r2
            ),
            fin
          ): Back(prog, n, env, XIf(c, t, e2), k, st, fr, s3) {
            BackMk(v, m3, lt3, evt, r3) => match starn_inv(
              StateMk(k, env, Cons(v, st), fr),
              r3,
              fin,
              Refl
            ): Back(prog, n, env, XIf(c, t, e2), k, st, fr, s3) {
              AfterMk(m4, lt4, r4) => BackMk(
                v,
                m4,
                lt_lt(m4, m3, n, lt4, lt_lt(m3, m2, n, lt3, lt_lt(m2, m1, n, lt2, lt1))),
                EvIfElse(
                  Eq::subst(Val, vc, VNat(Zero), (x: Val) => Eval(prog, env, c, x), ec, evc),
                  evt
                ),
                r4
              )
            }
          }
        }
      }
    }
    XPair(a, b) => (
      h: StarN(compile(prog), n, StateMk(comp(XPair(a, b), k), env, st, fr), s3)
    ) => match back_e(
      prog,
      B,
      ih,
      a,
      comp(b, CMkpair(k)),
      env,
      st,
      fr,
      s3,
      n,
      hb,
      h,
      fin
    ): Back(prog, n, env, XPair(a, b), k, st, fr, s3) {
      BackMk(va, m1, lt1, eva, r1) => match back_e(
        prog,
        B,
        ih,
        b,
        CMkpair(k),
        env,
        Cons(va, st),
        fr,
        s3,
        m1,
        le_of_lt(m1, n, B, lt1, hb),
        r1,
        fin
      ): Back(prog, n, env, XPair(a, b), k, st, fr, s3) {
        BackMk(vb, m2, lt2, evb, r2) => match starn_inv(
          StateMk(k, env, Cons(VPair(va, vb), st), fr),
          r2,
          fin,
          Refl
        ): Back(prog, n, env, XPair(a, b), k, st, fr, s3) {
          AfterMk(m3, lt3, r3) => BackMk(
            VPair(va, vb),
            m3,
            lt_lt(m3, m2, n, lt3, lt_lt(m2, m1, n, lt2, lt1)),
            EvPair(eva, evb),
            r3
          )
        }
      }
    }
    XFst(a) => (
      h: StarN(compile(prog), n, StateMk(comp(XFst(a), k), env, st, fr), s3)
    ) => match back_e(
      prog,
      B,
      ih,
      a,
      CFst(k),
      env,
      st,
      fr,
      s3,
      n,
      hb,
      h,
      fin
    ): Back(prog, n, env, XFst(a), k, st, fr, s3) {
      BackMk(va, m1, lt1, eva, r1) => match starn_next(
        r1,
        fin,
        not_final(CFst(k), env, Cons(va, st), fr, Refl)
      ): Back(prog, n, env, XFst(a), k, st, fr, s3) {
        NextMk(s2, m2, lt2, stp, r2) => match proj_inv(
          true,
          k,
          env,
          va,
          st,
          fr,
          s2,
          stp
        ): Back(prog, n, env, XFst(a), k, st, fr, s3) {
          ProjMk(pa, pb, ep, es) => BackMk(
            pa,
            m2,
            lt_lt(m2, m1, n, lt2, lt1),
            EvFst(Eq::subst(Val, va, VPair(pa, pb), (x: Val) => Eval(prog, env, a, x), ep, eva)),
            Eq::subst(
              State,
              s2,
              StateMk(k, env, Cons(pa, st), fr),
              (x: State) => StarN(compile(prog), m2, x, s3),
              es,
              r2
            )
          )
        }
      }
    }
    XSnd(a) => (
      h: StarN(compile(prog), n, StateMk(comp(XSnd(a), k), env, st, fr), s3)
    ) => match back_e(
      prog,
      B,
      ih,
      a,
      CSnd(k),
      env,
      st,
      fr,
      s3,
      n,
      hb,
      h,
      fin
    ): Back(prog, n, env, XSnd(a), k, st, fr, s3) {
      BackMk(va, m1, lt1, eva, r1) => match starn_next(
        r1,
        fin,
        not_final(CSnd(k), env, Cons(va, st), fr, Refl)
      ): Back(prog, n, env, XSnd(a), k, st, fr, s3) {
        NextMk(s2, m2, lt2, stp, r2) => match proj_inv(
          false,
          k,
          env,
          va,
          st,
          fr,
          s2,
          stp
        ): Back(prog, n, env, XSnd(a), k, st, fr, s3) {
          ProjMk(pa, pb, ep, es) => BackMk(
            pb,
            m2,
            lt_lt(m2, m1, n, lt2, lt1),
            EvSnd(Eq::subst(Val, va, VPair(pa, pb), (x: Val) => Eval(prog, env, a, x), ep, eva)),
            Eq::subst(
              State,
              s2,
              StateMk(k, env, Cons(pb, st), fr),
              (x: State) => StarN(compile(prog), m2, x, s3),
              es,
              r2
            )
          )
        }
      }
    }
    XCall(f, a) => (
      h: StarN(compile(prog), n, StateMk(comp(XCall(f, a), k), env, st, fr), s3)
    ) => match back_e(
      prog,
      B,
      ih,
      a,
      CCall(f, k),
      env,
      st,
      fr,
      s3,
      n,
      hb,
      h,
      fin
    ): Back(prog, n, env, XCall(f, a), k, st, fr, s3) {
      BackMk(va, m1, lt1, eva, r1) => match starn_next(
        r1,
        fin,
        not_final(CCall(f, k), env, Cons(va, st), fr, Refl)
      ): Back(prog, n, env, XCall(f, a), k, st, fr, s3) {
        NextMk(s2, m2, lt2, stp, r2) => match call_inv(
          List::nth(compile(prog), f),
          va,
          k,
          env,
          st,
          fr,
          s2,
          stp
        ): Back(prog, n, env, XCall(f, a), k, st, fr, s3) {
          CallMk(c, eo, es) => match nth_compile_inv(
            prog,
            f,
            c,
            eo
          ): Back(prog, n, env, XCall(f, a), k, st, fr, s3) {
            NthMk(body, found, ec) => match ih(
              body,
              CRet,
              Cons(va, Nil),
              Nil,
              Cons(FrameMk(k, env, st), fr),
              s3,
              m2,
              Nat::le_trans(Succ(m2), n, B, lt_lt(m2, m1, n, lt2, lt1), hb),
              Eq::subst(
                Bytecode,
                c,
                comp_body(body),
                (x: Bytecode) => StarN(
                  compile(prog),
                  m2,
                  StateMk(x, Cons(va, Nil), Nil, Cons(FrameMk(k, env, st), fr)),
                  s3
                ),
                ec,
                Eq::subst(
                  State,
                  s2,
                  StateMk(c, Cons(va, Nil), Nil, Cons(FrameMk(k, env, st), fr)),
                  (x: State) => StarN(compile(prog), m2, x, s3),
                  es,
                  r2
                )
              ),
              fin
            ): Back(prog, n, env, XCall(f, a), k, st, fr, s3) {
              BackMk(v, m3, lt3, evb, r3) => match starn_inv(
                StateMk(k, env, Cons(v, st), fr),
                r3,
                fin,
                Refl
              ): Back(prog, n, env, XCall(f, a), k, st, fr, s3) {
                AfterMk(m4, lt4, r4) => BackMk(
                  v,
                  m4,
                  lt_lt(m4, m3, n, lt4, lt_lt(m3, m2, n, lt3, lt_lt(m2, m1, n, lt2, lt1))),
                  EvCall(eva, found, evb),
                  r4
                )
              }
            }
          }
        }
      }
    }
  }(h)
}

pub theorem back(prog: List(Expr), B: Nat): BackUpTo(prog, B) {
  match B: BackUpTo(prog, B) {
    Zero => (e: Expr) => (k: Bytecode) => (env: List(Val)) => (st: List(Val)) => (
      fr: List(Frame)
    ) => (s3: State) => (n: Nat) => (hb: Nat::le(n, Zero) = true) => back_e(
      prog,
      Zero,
      (e1: Expr) => (k1: Bytecode) => (env1: List(Val)) => (st1: List(Val)) => (
        fr1: List(Frame)
      ) => (s4: State) => (n1: Nat) => (lt: Nat::le(Succ(n1), Zero) = true) => (
        h1: StarN(compile(prog), n1, StateMk(comp(e1, k1), env1, st1, fr1), s4)
      ) => (f1: IsFinal(s4)) => False::elim(false_ne_true(lt)),
      e,
      k,
      env,
      st,
      fr,
      s3,
      n,
      hb
    )
    Succ(B1) => (e: Expr) => (k: Bytecode) => (env: List(Val)) => (st: List(Val)) => (
      fr: List(Frame)
    ) => (s3: State) => (n: Nat) => (hb: Nat::le(n, Succ(B1)) = true) => back_e(
      prog,
      Succ(B1),
      (e1: Expr) => (k1: Bytecode) => (env1: List(Val)) => (st1: List(Val)) => (
        fr1: List(Frame)
      ) => (s4: State) => (n1: Nat) => (lt: Nat::le(Succ(n1), Succ(B1)) = true) => back(
        prog,
        B1
      )(e1, k1, env1, st1, fr1, s4, n1, lt),
      e,
      k,
      env,
      st,
      fr,
      s3,
      n,
      hb
    )
  }
}

pub theorem final_inv(s: State, w: Val, e: final_answer(s) = Some(w)): IsFinal(s) {
  match s: (final_answer(s) = Some(w)) -> IsFinal(s) {
    StateMk(c, env, st, fr) => match c: (
      final_answer(StateMk(c, env, st, fr)) = Some(w)
    ) -> IsFinal(StateMk(c, env, st, fr)) {
      CRet => match fr: (
        final_answer(StateMk(CRet, env, st, fr)) = Some(w)
      ) -> IsFinal(StateMk(CRet, env, st, fr)) {
        Nil => match st: (
          final_answer(StateMk(CRet, env, st, Nil)) = Some(w)
        ) -> IsFinal(StateMk(CRet, env, st, Nil)) {
          Nil => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
          Cons(v, rest) => match rest: (
            final_answer(StateMk(CRet, env, Cons(v, rest), Nil)) = Some(w)
          ) -> IsFinal(StateMk(CRet, env, Cons(v, rest), Nil)) {
            Nil => (e1: Some(v) = Some(w)) => IsFinal::Mk(env, v)
            Cons(x, rest2) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
          }
        }
        Cons(f1, frs) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      }
      CLoad(i, k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CPush(n, k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CAdd(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CSub(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CMul(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CLt(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CBind(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CUnbind(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CBranch(t, e2, k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CMkpair(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CFst(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CSnd(k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
      CCall(f, k) => (e0: None = Some(w)) => False::elim(Option::none_ne_some(w, e0))
    }
  }(e)
}

pub(open) inductive HaltN(prog: List(Bytecode), s1: State, s2: State): Prop {
  HaltMk(n: Nat, h: StarN(prog, n, s1, s2)): HaltN(prog, s1, s2)
}

pub theorem run_from_halt(
  prog: List(Bytecode),
  g: Nat,
  s: State,
  s2: State,
  o: Option(State),
  eo: step(prog, s) = o,
  e: run_from(prog, g, s, o) = Some(s2),
  ih: ∀ x: State. (run(prog, g, x) = Some(s2)) -> HaltN(prog, x, s2)
): HaltN(prog, s, s2) {
  match o: (step(prog, s) = o) -> (run_from(prog, g, s, o) = Some(s2)) -> HaltN(prog, s, s2) {
    None => (eo0: step(prog, s) = None) => (e0: Some(s) = Some(s2)) => HaltMk(
      Zero,
      Eq::subst(
        State,
        s,
        s2,
        (x: State) => StarN(prog, Zero, s, x),
        Option::some_inj(s, s2, e0),
        StarnRefl(s)
      )
    )
    Some(x) => (eo1: step(prog, s) = Some(x)) => (e1: run(prog, g, x) = Some(s2)) => match ih(
      x,
      e1
    ): HaltN(prog, s, s2) {
      HaltMk(n, h) => HaltMk(Succ(n), StarnStep(eo1, h))
    }
  }(eo, e)
}

// A run that stops is a counted run.
pub theorem run_halt(
  prog: List(Bytecode),
  fuel: Nat,
  s: State,
  s2: State,
  e: run(prog, fuel, s) = Some(s2)
): HaltN(prog, s, s2) {
  match fuel: (run(prog, fuel, s) = Some(s2)) -> HaltN(prog, s, s2) {
    Zero => (e0: None = Some(s2)) => False::elim(Option::none_ne_some(s2, e0))
    Succ(g) => (e1: run(prog, Succ(g), s) = Some(s2)) => run_from_halt(
      prog,
      g,
      s,
      s2,
      step(prog, s),
      Refl,
      e1,
      (x: State) => (ex: run(prog, g, x) = Some(s2)) => run_halt(prog, g, x, s2, ex)
    )
  }(e)
}

// What the machine's answer says: `f` is a function of `prog` whose body has the value `w`.
pub(open) inductive Sound(prog: List(Expr), f: Nat, arg: Val, w: Val): Prop {
  SoundMk(
    body: Expr,
    found: List::nth(prog, f) = Some(body),
    ev: Eval(prog, Cons(arg, Nil), body, w)
  ): Sound(prog, f, arg, w)
}

pub theorem sound_from_final(
  prog: List(Expr),
  f: Nat,
  arg: Val,
  w: Val,
  s2: State,
  n: Nat,
  h: StarN(compile(prog), n, start(f, arg), s2),
  e: final_answer(s2) = Some(w)
): Sound(prog, f, arg, w) {
  match starn_next(
    h,
    final_inv(s2, w, e),
    not_final(CCall(f, CRet), Nil, Cons(arg, Nil), Nil, Refl)
  ): Sound(prog, f, arg, w) {
    NextMk(s1, m1, lt1, stp, r1) => match call_inv(
      List::nth(compile(prog), f),
      arg,
      CRet,
      Nil,
      Nil,
      Nil,
      s1,
      stp
    ): Sound(prog, f, arg, w) {
      CallMk(c, eo, es) => match nth_compile_inv(prog, f, c, eo): Sound(prog, f, arg, w) {
        NthMk(body, found, ec) => match back(
          prog,
          m1
        )(
          body,
          CRet,
          Cons(arg, Nil),
          Nil,
          Cons(FrameMk(CRet, Nil, Nil), Nil),
          s2,
          m1,
          Nat::le_refl(m1),
          Eq::subst(
            Bytecode,
            c,
            comp_body(body),
            (x: Bytecode) => StarN(
              compile(prog),
              m1,
              StateMk(x, Cons(arg, Nil), Nil, Cons(FrameMk(CRet, Nil, Nil), Nil)),
              s2
            ),
            ec,
            Eq::subst(
              State,
              s1,
              StateMk(c, Cons(arg, Nil), Nil, Cons(FrameMk(CRet, Nil, Nil), Nil)),
              (x: State) => StarN(compile(prog), m1, x, s2),
              es,
              r1
            )
          ),
          final_inv(s2, w, e)
        ): Sound(prog, f, arg, w) {
          BackMk(v, m2, lt2, ev, r2) => match starn_inv(
            StateMk(CRet, Nil, Cons(v, Nil), Nil),
            r2,
            final_inv(s2, w, e),
            Refl
          ): Sound(prog, f, arg, w) {
            AfterMk(m3, lt3, r3) => SoundMk(
              body,
              found,
              Eq::subst(
                Val,
                v,
                w,
                (x: Val) => Eval(prog, Cons(arg, Nil), body, x),
                Option::some_inj(
                  v,
                  w,
                  Eq::subst(
                    State,
                    s2,
                    StateMk(CRet, Nil, Cons(v, Nil), Nil),
                    (x: State) => final_answer(x) = Some(w),
                    Eq::sym(stop_path(r3, Refl)),
                    e
                  )
                ),
                ev
              )
            )
          }
        }
      }
    }
  }
}

pub theorem machine_sound_at(
  prog: List(Expr),
  fuel: Nat,
  f: Nat,
  arg: Val,
  w: Val,
  o: Option(State),
  eo: run(compile(prog), fuel, start(f, arg)) = o,
  e: answer(o) = Some(w)
): Sound(prog, f, arg, w) {
  match o: (
    run(compile(prog), fuel, start(f, arg)) = o
  ) -> (answer(o) = Some(w)) -> Sound(prog, f, arg, w) {
    None => (eo0: run(compile(prog), fuel, start(f, arg)) = None) => (
      e0: None = Some(w)
    ) => False::elim(Option::none_ne_some(w, e0))
    Some(s2) => (eo1: run(compile(prog), fuel, start(f, arg)) = Some(s2)) => (
      e1: final_answer(s2) = Some(w)
    ) => match run_halt(compile(prog), fuel, start(f, arg), s2, eo1): Sound(prog, f, arg, w) {
      HaltMk(n, h) => sound_from_final(prog, f, arg, w, s2, n, h, e1)
    }
  }(eo, e)
}

// The theorem: when the machine running the compiled program answers `w` for calling `f`
// with `arg`, `f` is a function of `prog` and the reference semantics gives its body the
// value `w`.
pub theorem machine_sound(
  prog: List(Expr),
  fuel: Nat,
  f: Nat,
  arg: Val,
  w: Val,
  e: run_program(prog, fuel, f, arg) = Some(w)
): Sound(prog, f, arg, w) {
  machine_sound_at(prog, fuel, f, arg, w, run(compile(prog), fuel, start(f, arg)), Refl, e)
}
