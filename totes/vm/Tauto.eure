package {
  name = "vm"
  version = "0.1.0"
  sources = ["src", "proof"]
}

dependencies {
  scan { path = "../scan" }
  text { path = "../text" }
}

// The Rust side runs the tote only through `generated::run`, so it calls no
// function by name; the others stay internal to the tote.
rust {
  exports = []
}
