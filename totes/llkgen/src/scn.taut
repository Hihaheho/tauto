// The scanner of a grammar: the patterns of each of its modes, and the
// scanner tables made of them (the `classes`, `modes` and `lookahead_dfas`
// lines), checked against the reference tables.

// ---------------------------------------------------------------- the patterns of a mode

fn sc_snoc(xs: List(Text), x: Text) -> List(Text) {
  match xs {
    Nil => Cons(x, Nil)
    Cons(y, rest) => Cons(y, sc_snoc(rest, x))
  }
}

fn sc_is_escaped_in_class(c: u64) -> Bool {
  c == 45 || c == 93 || c == 94 || c == 92
}

// A character escaped: `\t`, `\r`, `\n`, `\'`, `\"` and `\\`, the other
// printable ASCII as it is, any other as `\u{…}` in hex.
fn sc_escape_default(c: u64) -> Text {
  if c == 9 {
    "\\t"
  } else if c == 13 {
    "\\r"
  } else if c == 10 {
    "\\n"
  } else if c == 39 {
    "\\'"
  } else if c == 34 {
    "\\\""
  } else if c == 92 {
    "\\\\"
  } else if c >= 32 && c <= 126 {
    rx_text_of(Cons(c, Nil))
  } else {
    text_concat_all(Cons("\\u{", Cons(sd_hex(c), Cons("}", Nil))))
  }
}

// The characters of a text, a backslash and the next one as one atom.
fn sc_atoms(p: Text) -> List(Text) {
  var out: List(Text) = Nil
  var at: u64 = 0
  while at < text_len(p) {
    match text_decode(p, at) {
      Some(d) => {
        if d.fst == 92 {
          match text_decode(p, at + d.snd) {
            Some(e) => {
              out := sc_snoc(out, text_slice_or_empty(p, at, at + d.snd + e.snd))
              at := at + d.snd + e.snd
            }
            None => par_die("a block comment end has a dangling escape")
          }
        } else {
          out := sc_snoc(out, text_slice_or_empty(p, at, at + d.snd))
          at := at + d.snd
        }
      }
      None => par_die("not UTF-8")
    }
  }
  out
}

fn sc_class_safe(atom: Text) -> Text {
  match text_decode(atom, 0) {
    Some(first) => {
      let ch = if first.fst == 92 {
        match text_decode(atom, first.snd) {
          Some(e) => e.fst
          None => 92
        }
      } else {
        first.fst
      }
      if sc_is_escaped_in_class(ch) {
        text_concat_all(Cons("\\", Cons(rx_text_of(Cons(ch, Nil)), Nil)))
      } else {
        sc_escape_default(ch)
      }
    }
    None => ""
  }
}

fn sc_atom_at(xs: List(Text), i: u64) -> Text {
  match xs {
    Nil => ""
    Cons(x, rest) => if i == 0 { x } else { sc_atom_at(rest, i - 1) }
  }
}

fn sc_len(xs: List(Text)) -> u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + sc_len(rest)
  }
}

fn sc_push_all(&mut b: Buf, xs: List(Text)) -> () {
  var rest = xs
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        buf_push(&mut b, &x)
        rest := more
      }
    }
  }
}

// The pattern of a block comment from its start and end.
fn sc_block_comment(s: Text, e: Text) -> Text {
  if s == "/\\*" && e == "\\*/" {
    "/\\*/?([^/]|[^*]/)*\\*/"
  } else {
    let atoms = sc_atoms(e)
    let n = sc_len(atoms)
    var b = buf_new()
    if n == 0 {
      par_die("a block comment end is empty")
    } else if n > 3 {
      par_die("a block comment end is too long")
    } else if n == 2 {
      let a0 = sc_atom_at(atoms, 0)
      let a1 = sc_atom_at(atoms, 1)
      let c0 = sc_class_safe(a0)
      let c1 = sc_class_safe(a1)
      if a0 == a1 {
        sc_push_all(&mut b, Cons(s, Cons("([^", Cons(c0, Cons("]|", Nil)))))
        sc_push_all(&mut b, Cons(a0, Cons("[^", Cons(c1, Cons("])*", Cons(e, Nil))))))
      } else {
        sc_push_all(&mut b, Cons(s, Cons("[^", Cons(c0, Cons("]*(", Nil)))))
        sc_push_all(&mut b, Cons(a0, Cons("+[^", Cons(c0, Cons(c1, Cons("][^", Nil))))))
        sc_push_all(&mut b, Cons(c0, Cons("]*)*", Cons(a0, Cons("+", Cons(a1, Nil))))))
      }
    } else {
      var alts: List(Text) = Nil
      var i: u64 = 0
      while i < n {
        var prefix = ""
        var k: u64 = 0
        while k < i {
          prefix := text_concat_all(Cons(prefix, Cons(sc_atom_at(atoms, k), Nil)))
          k := k + 1
        }
        alts := sc_snoc(
          alts,
          text_concat_all(
            Cons(prefix, Cons("[^", Cons(sc_class_safe(sc_atom_at(atoms, i)), Cons("]", Nil))))
          )
        )
        i := i + 1
      }
      sc_push_all(&mut b, Cons(s, Cons("(", Cons(text_join(alts, "|"), Cons(")*", Cons(e, Nil))))))
    }
    text_of(b)
  }
}

fn sc_pat(pattern: Text, terminal: u64) -> SPat {
  SPat { pattern: pattern, terminal: terminal, priority: 0, la_kind: 0, la: "" }
}

fn sc_has_state(xs: List(u64), s: u64) -> Bool {
  match xs {
    Nil => false
    Cons(x, rest) => x == s || sc_has_state(rest, s)
  }
}

fn sc_snoc_pat(xs: List(SPat), x: SPat) -> List(SPat) {
  match xs {
    Nil => Cons(x, Nil)
    Cons(y, rest) => Cons(y, sc_snoc_pat(rest, x))
  }
}

// The patterns of the scanner
// number `state`, in order, with their terminals.
fn sc_patterns(m: MModel, state: u64, sc: PScanner) -> List(SPat) {
  var out: List(SPat) = Nil
  if !sc.auto_newline_off {
    out := sc_snoc_pat(out, sc_pat("\\r\\n|\\r|\\n", 1))
  }
  if !sc.auto_ws_off {
    out := sc_snoc_pat(out, sc_pat("[\\s--\\r\\n]+", 2))
  }
  match sc.line_comments {
    Nil => ()
    others => {
      var alts: List(Text) = Nil
      var rest = sc.line_comments
      var running = true
      while running {
        match rest {
          Nil => {
            running := false
          }
          Cons(s, more) => {
            alts := sc_snoc(alts, text_concat_all(Cons(s, Cons(".*(\\r\\n|\\r|\\n)?", Nil))))
            rest := more
          }
        }
      }
      out := sc_snoc_pat(out, sc_pat(text_join(alts, "|"), 3))
    }
  }
  match sc.block_comments {
    Nil => ()
    others => {
      var alts: List(Text) = Nil
      var rest = sc.block_comments
      var running = true
      while running {
        match rest {
          Nil => {
            running := false
          }
          Cons(p, more) => {
            alts := sc_snoc(alts, sc_block_comment(p.fst, p.snd))
            rest := more
          }
        }
      }
      out := sc_snoc_pat(out, sc_pat(text_join(alts, "|"), 4))
    }
  }
  var i: u64 = 0
  var terms = m.terms
  var running2 = true
  while running2 {
    match terms {
      Nil => {
        running2 := false
      }
      Cons(t, more) => {
        if sc_has_state(t.states, state) {
          out := sc_snoc_pat(out, match t.la {
            None => SPat { pattern: md_expand(t), terminal: 5 + i, priority: 0, la_kind: 0, la: "" }
            Some(l) => SPat {
              pattern: md_expand(t)
              terminal: 5 + i
              priority: 0
              la_kind: if l.positive { 1 } else { 2 }
              la: md_expand(PTerm { text: l.text, kind: l.kind, states: Nil, clipped: false, la: None })
            }
          })
        }
        i := i + 1
        terms := more
      }
    }
  }
  if !sc.allow_unmatched {
    out := sc_snoc_pat(out, sc_pat(".", md_count_texts(m.terminal_names) - 1))
  }
  out
}

fn md_count_texts(xs: List(Text)) -> u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + md_count_texts(rest)
  }
}

// ---------------------------------------------------------------- the tables

fn sc_words_u(xs: List(u64)) -> List(Text) {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(text_of_u64(x), sc_words_u(rest))
  }
}

fn sc_la_dfa(p: SPat, cc: CcOut) -> List(SdSt) {
  sd_minimize(sd_subset(sd_convert(nf_lookahead(p), cc)))
}

fn sc_push_words(&mut out: Vec(Text), w: Text) -> () {
  vec_push(&mut out, w)
}

// The words of a state of a mode: the words of the states, the lookahead
// automata of the patterns pushed on `look` as they are met.
fn sc_state_words(st: SdSt, cc: CcOut, &mut look: Vec(Text), &mut b: Buf) -> () {
  buf_push(&mut b, &text_of_u64(sc_len_pats(st.acc)))
  buf_push(&mut b, &" ")
  var rest = st.acc
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(p, more) => {
        var la_dfa: u64 = 0
        if p.la_kind > 0 {
          let dfa = sc_la_dfa(p, cc)
          var lb = buf_new()
          sc_states_words(dfa, cc, &mut look, &mut lb)
          la_dfa := vec_len(&look)
          vec_push(&mut look, text_of(lb))
        }
        buf_push(&mut b, &text_of_u64(p.terminal))
        buf_push(&mut b, &" ")
        buf_push(&mut b, &text_of_u64(p.priority))
        buf_push(&mut b, &" ")
        buf_push(&mut b, &text_of_u64(p.la_kind))
        buf_push(&mut b, &" ")
        buf_push(&mut b, &text_of_u64(la_dfa))
        buf_push(&mut b, &" ")
        rest := more
      }
    }
  }
  buf_push(&mut b, &text_of_u64(sc_len_trs(st.trans)))
  var ts = st.trans
  var running2 = true
  while running2 {
    match ts {
      Nil => {
        running2 := false
      }
      Cons(t, more) => {
        buf_push(&mut b, &" ")
        buf_push(&mut b, &text_of_u64(t.cc))
        buf_push(&mut b, &" ")
        buf_push(&mut b, &text_of_u64(t.to))
        ts := more
      }
    }
  }
}

fn sc_len_pats(xs: List(SPat)) -> u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + sc_len_pats(rest)
  }
}

fn sc_len_trs(xs: List(SdTr)) -> u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + sc_len_trs(rest)
  }
}

fn sc_len_sts(xs: List(SdSt)) -> u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + sc_len_sts(rest)
  }
}

// `states(…)`: the count and each state.
fn sc_states_words(states: List(SdSt), cc: CcOut, &mut look: Vec(Text), &mut b: Buf) -> () {
  buf_push(&mut b, &text_of_u64(sc_len_sts(states)))
  var rest = states
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(s, more) => {
        buf_push(&mut b, &" ")
        sc_state_words(s, cc, &mut look, &mut b)
        rest := more
      }
    }
  }
}

fn sc_class_line(cc: CcOut) -> Text {
  var keys: List(u64) = Nil
  var g: u64 = 0
  var gs = cc.groups
  var running = true
  while running {
    match gs {
      Nil => {
        running := false
      }
      Cons(rs, more) => {
        var rest = rs
        var walking = true
        while walking {
          match rest {
            Nil => {
              walking := false
            }
            Cons(r, others) => {
              keys := Cons(r.lo * 4398046511104 + r.hi * 2097152 + g, keys)
              rest := others
            }
          }
        }
        g := g + 1
        gs := more
      }
    }
  }
  let sorted = lg_sort_keep(keys)
  var words: List(Text) = Nil
  var rest2 = sorted
  var running2 = true
  var count: u64 = 0
  while running2 {
    match rest2 {
      Nil => {
        running2 := false
      }
      Cons(k, more) => {
        words := Cons(
          text_of_u64(mod(k, 2097152)),
          Cons(
            text_of_u64(mod(div(k, 2097152), 2097152)),
            Cons(text_of_u64(div(k, 4398046511104)), words)
          )
        )
        count := count + 1
        rest2 := more
      }
    }
  }
  em_line("classes", count, text_list_reverse(words))
}

fn sc_nfa_leaves(nfas: List(Nfa)) -> List(RHir) {
  var leaves: List(RHir) = Nil
  var rest = nfas
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(a, more) => {
        leaves := sd_leaves(a, leaves)
        rest := more
      }
    }
  }
  leaves
}

fn sc_patterns_each(m: MModel, state: u64, scanners: List(PScanner)) -> List(List(SPat)) {
  match scanners {
    Nil => Nil
    Cons(sc, rest) => Cons(sc_patterns(m, state, sc), sc_patterns_each(m, state + 1, rest))
  }
}

fn sc_nfas(ps: List(List(SPat))) -> List(Nfa) {
  match ps {
    Nil => Nil
    Cons(p, rest) => Cons(nf_of_patterns(p), sc_nfas(rest))
  }
}

fn sc_trans_words(ts: List(MTrans)) -> List(Text) {
  match ts {
    Nil => Nil
    Cons(
      t,
      rest
    ) => Cons(
      text_of_u64(t.tok),
      Cons(text_of_u64(t.kind), Cons(text_of_u64(t.target), sc_trans_words(rest)))
    )
  }
}

fn sc_len_ts(xs: List(MTrans)) -> u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + sc_len_ts(rest)
  }
}

// The lines `classes`, `modes` and `lookahead_dfas` of the table file.
fn sc_lines(m: MModel) -> List(Text) {
  let pats = sc_patterns_each(m, 0, m.scanners)
  let nfas = sc_nfas(pats)
  let cc = cc_make(sc_nfa_leaves(nfas))
  var look: Vec(Text) = vec_new()
  var b = buf_new()
  var n_modes: u64 = 0
  var scs = m.scanners
  var nf = nfas
  var tr = m.ttrans
  var running = true
  while running {
    match scs {
      Nil => {
        running := false
      }
      Cons(sc, more) => match nf {
        Nil => {
          running := false
        }
        Cons(a, nfa_rest) => match tr {
          Nil => {
            running := false
          }
          Cons(ts, tr_rest) => {
            if n_modes > 0 {
              buf_push(&mut b, &" ")
            }
            buf_push(&mut b, &sc.name)
            buf_push(&mut b, &" ")
            buf_push(&mut b, &text_of_u64(sc_len_ts(ts)))
            buf_push(&mut b, &" ")
            let tw = text_join(sc_trans_words(ts), " ")
            if text_len(tw) > 0 {
              buf_push(&mut b, &tw)
              buf_push(&mut b, &" ")
            }
            let dfa = sd_minimize(sd_subset(sd_convert(a, cc)))
            sc_states_words(dfa, cc, &mut look, &mut b)
            n_modes := n_modes + 1
            scs := more
            nf := nfa_rest
            tr := tr_rest
          }
        }
      }
    }
  }
  var las = buf_new()
  var i: u64 = 0
  while i < vec_len(&look) {
    if i > 0 {
      buf_push(&mut las, &" ")
    }
    buf_push(&mut las, &sd_keys_get(&look, i))
    i := i + 1
  }
  Cons(
    sc_class_line(cc),
    Cons(
      text_concat_all(
        Cons("modes ", Cons(text_of_u64(n_modes), Cons(" ", Cons(text_of_buf(b), Nil))))
      ),
      Cons(
        text_concat_all(
          Cons(
            "lookahead_dfas ",
            Cons(
              text_of_u64(vec_len(&look)),
              Cons(if vec_len(&look) > 0 { " " } else { "" }, Cons(text_of_buf(las), Nil))
            )
          )
        ),
        Nil
      )
    )
  )
}

fn text_of_buf(b: Buf) -> Text {
  text_of(b)
}
