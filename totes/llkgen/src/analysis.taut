// The lookahead analysis: the grammar it reads and FIRST(k). FOLLOW(k) and
// the deciding of k are in `follow.taut`.

enum LgSym {
  LgN(u64)
  LgT(u64)
}

struct LgProd { lhs: u64, rhs: List(LgSym) }

// The grammar the analysis reads: its productions (after the EBNF is gone),
// for each non-terminal the numbers of its productions, the start symbol.
struct LgGrammar { prods: Array(LgProd), nt_prods: Array(List(u64)), start: u64 }

// A production's right side in parts: a string of terminals, or one
// non-terminal, with the position (from 1) of its first symbol.
enum LgRaw {
  LgRawT(List(u64))
  LgRawN(u64)
}

struct LgRawAt { at: u64, raw: LgRaw }

fn lg_raw_parts(rhs: List(LgSym)) -> List(LgRawAt) {
  var parts: List(LgRawAt) = Nil
  var run: List(u64) = Nil
  var run_at: u64 = 0
  var rest = rhs
  var i: u64 = 0
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(s, more) => {
        match s {
          LgN(n) => {
            match run {
              Nil => ()
              Cons(t, before) => {
                parts := Cons(LgRawAt { at: run_at, raw: LgRawT(lg_rev(run)) }, parts)
                run := Nil
              }
            }
            parts := Cons(LgRawAt { at: i + 1, raw: LgRawN(n) }, parts)
          }
          LgT(t) => {
            match run {
              Nil => {
                run_at := i + 1
              }
              Cons(u, before) => ()
            }
            run := Cons(t, run)
          }
        }
        i := i + 1
        rest := more
      }
    }
  }
  match run {
    Nil => ()
    Cons(t, before) => {
      parts := Cons(LgRawAt { at: run_at, raw: LgRawT(lg_rev(run)) }, parts)
    }
  }
  lg_rev_parts(parts)
}

fn lg_rev_parts(xs: List(LgRawAt)) -> List(LgRawAt) {
  var out: List(LgRawAt) = Nil
  var rest = xs
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        out := Cons(x, out)
        rest := more
      }
    }
  }
  out
}

fn lg_aget(a: Array(LgSet), i: u64) -> LgSet {
  match array_get(a, i) {
    Some(x) => x
    None => lg_set_empty(0)
  }
}

fn lg_prod_at(g: LgGrammar, p: u64) -> LgProd {
  match array_get(g.prods, p) {
    Some(x) => x
    None => LgProd { lhs: 0, rhs: Nil }
  }
}

fn lg_nt_prods_at(g: LgGrammar, n: u64) -> List(u64) {
  match array_get(g.nt_prods, n) {
    Some(x) => x
    None => Nil
  }
}

// ---------------------------------------------------------------- FIRST

enum LgPart {
  LgTerms(LgSet)
  LgNt(u64)
}

struct LgFirst { prods: List(LgSet), nts: List(LgSet) }

fn lg_first_parts(raw: List(LgRawAt), k: u64) -> List(LgPart) {
  var out: List(LgPart) = Nil
  var rest = raw
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(p, more) => {
        out := Cons(match p.raw {
          LgRawT(run) => LgTerms(lg_set_of(run, k))
          LgRawN(n) => LgNt(n)
        }, out)
        rest := more
      }
    }
  }
  lg_rev_part(out)
}

fn lg_rev_part(xs: List(LgPart)) -> List(LgPart) {
  var out: List(LgPart) = Nil
  var rest = xs
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        out := Cons(x, out)
        rest := more
      }
    }
  }
  out
}

fn lg_n_prods(g: LgGrammar) -> u64 {
  array_len(g.prods)
}

fn lg_n_nts(g: LgGrammar) -> u64 {
  array_len(g.nt_prods)
}

fn lg_set_eq_list(a: List(LgSet), b: List(LgSet)) -> Bool {
  var x = a
  var y = b
  var same = true
  var running = true
  while running {
    match x {
      Nil => {
        same := match y {
          Nil => true
          Cons(q, more) => false
        }
        running := false
      }
      Cons(p, rest) => match y {
        Nil => {
          same := false
          running := false
        }
        Cons(q, more) => if lg_set_eq(p, q) {
          x := rest
          y := more
        } else {
          same := false
          running := false
        }
      }
    }
  }
  same
}

fn lg_rev_set(xs: List(LgSet)) -> List(LgSet) {
  var out: List(LgSet) = Nil
  var rest = xs
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        out := Cons(x, out)
        rest := more
      }
    }
  }
  out
}

fn lg_set_k_all(xs: List(LgSet), k: u64) -> List(LgSet) {
  var out: List(LgSet) = Nil
  var rest = xs
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        out := Cons(lg_set_k(x, k), out)
        rest := more
      }
    }
  }
  lg_rev_set(out)
}

// FIRST(k): the fixpoint, from what FIRST(k - 1) gave (or from nothing).
fn lg_first(g: LgGrammar, k: u64, prev: Option(LgFirst)) -> LgFirst {
  let n_prods = lg_n_prods(g)
  let n_nts = lg_n_nts(g)
  var eqs: List(List(LgPart)) = Nil
  var p: u64 = 0
  while p < n_prods {
    eqs := Cons(lg_first_parts(lg_raw_parts(lg_prod_at(g, p).rhs), k), eqs)
    p := p + 1
  }
  let equations = lg_rev_eqs(eqs)
  var cur: LgFirst = match prev {
    None => LgFirst { prods: lg_repeat_set(
      lg_set_empty(k),
      n_prods
    ), nts: lg_repeat_set(lg_set_eps(k), n_nts) }
    Some(f) => LgFirst { prods: lg_set_k_all(f.prods, k), nts: lg_set_k_all(f.nts, k) }
  }
  var running = true
  while running {
    let old_nts = array_of_list(cur.nts)
    var made: List(LgSet) = Nil
    var rest = equations
    var inner = true
    while inner {
      match rest {
        Nil => {
          inner := false
        }
        Cons(eq, more) => {
          var r = lg_set_eps(k)
          var parts = eq
          var walking = true
          while walking {
            match parts {
              Nil => {
                walking := false
              }
              Cons(part, others) => {
                r := match part {
                  LgTerms(s) => lg_set_concat(r, s, k)
                  LgNt(n) => lg_set_concat(r, lg_aget(old_nts, n), k)
                }
                parts := others
              }
            }
          }
          made := Cons(r, made)
          rest := more
        }
      }
    }
    let new_prods = lg_rev_set(made)
    let by_prod = array_of_list(new_prods)
    var nts: List(LgSet) = Nil
    var n: u64 = 0
    while n < n_nts {
      var acc = lg_set_empty(k)
      var ps = lg_nt_prods_at(g, n)
      var walking = true
      while walking {
        match ps {
          Nil => {
            walking := false
          }
          Cons(q, others) => {
            acc := lg_set_append(acc, lg_aget(by_prod, q))
            ps := others
          }
        }
      }
      nts := Cons(acc, nts)
      n := n + 1
    }
    let next = LgFirst { prods: new_prods, nts: lg_rev_set(nts) }
    if lg_set_eq_list(next.prods, cur.prods) && lg_set_eq_list(next.nts, cur.nts) {
      running := false
    } else {
      cur := next
    }
  }
  cur
}

fn lg_rev_eqs(xs: List(List(LgPart))) -> List(List(LgPart)) {
  var out: List(List(LgPart)) = Nil
  var rest = xs
  var running = true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        out := Cons(x, out)
        rest := more
      }
    }
  }
  out
}

fn lg_repeat_set(s: LgSet, n: u64) -> List(LgSet) {
  var out: List(LgSet) = Nil
  var i: u64 = 0
  while i < n {
    out := Cons(s, out)
    i := i + 1
  }
  out
}
