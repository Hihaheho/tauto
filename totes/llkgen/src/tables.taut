// The table file of a grammar, from the grammar read by `totes/pargen` and the
// lookahead analysis of `analysis.taut` and `follow.taut`. The functions
// `llkgen_*` near the end are what the tote gives; each takes a text and
// gives a text, or why there is none.
//
// Derived from parol and scnr2 by Jörg Singer (MIT OR Apache-2.0); see NOTICE.
import std::Text

// The words of the line that starts with `name`.
pub fn lg_find_line(lines: List(Text), name: Text): List(Text) {
  match lines {
    Nil => Nil
    Cons(line, rest) => {
      let words := text_split(line, " ")
      match words {
        Nil => lg_find_line(rest, name)
        Cons(first, more) => if first == name { more } else { lg_find_line(rest, name) }
      }
    }
  }
}

pub fn lg_invalid(context: Text, message: Text): Never {
  perform fail(Text::concat_all(Cons(context, Cons(": ", Cons(message, Nil)))))
}

pub fn lg_int(t: Text, context: Text): i64 {
  match text_parse_i64(t) {
    Some(n) => n
    None => lg_invalid(context, Text::concat_all(Cons("invalid integer: ", Cons(t, Nil))))
  }
}

pub fn lg_unsigned(n: i64, context: Text): u64 {
  if n < 0 { lg_invalid(context, "expected a nonnegative integer") } else { U64::of_i64(n) }
}

pub fn lg_nat(t: Text, context: Text): u64 {
  lg_unsigned(lg_int(t, context), context)
}

pub fn lg_word_array(words: List(Text), context: Text): Array(i64) {
  Array::of_list(lg_ints(words, context))
}

pub fn lg_ints(words: List(Text), context: Text): List(i64) {
  match words {
    Nil => Nil
    Cons(w, rest) => Cons(lg_int(w, context), lg_ints(rest, context))
  }
}

pub fn lg_at(a: Array(i64), i: u64, context: Text): i64 {
  match Array::get(a, i) {
    Some(x) => x
    None => lg_invalid(
      context,
      Text::concat_all(Cons("truncated productions at word ", Cons(Text::of_u64(i), Nil)))
    )
  }
}

// The grammar from the words after `productions`: the count, then for each
// production its left side, its attribute and its symbols (a number from 0 is
// a non-terminal, below 0 the terminal `-n - 1`).
pub fn lg_grammar_of(
  words: List(Text),
  n_nts: u64,
  n_terms: u64,
  start: u64,
  context: Text
): LgGrammar {
  if n_nts == 0 || start >= n_nts { lg_invalid(context, "start is not a non-terminal") }
  let a := lg_word_array(words, context)
  let n_prods := lg_unsigned(lg_at(a, 0, context), context)
  if n_prods > div(Array::len(a) - 1, 3) { lg_invalid(context, "truncated production headers") }
  var prods: List(LgProd) := Nil
  var by_nt: Vec(List(u64)) := Vec::new()
  var i: u64 := 0
  while i < n_nts {
    Vec::push(&mut by_nt, Nil)
    i := i + 1
  }
  var p: u64 := 0
  var at: u64 := 1
  while p < n_prods {
    let lhs := lg_unsigned(lg_at(a, at, context), context)
    if lhs >= n_nts { lg_invalid(context, "production left side is not a non-terminal") }
    let n := lg_unsigned(lg_at(a, at + 2, context), context)
    if n > Array::len(a) - at - 3 { lg_invalid(context, "truncated production symbols") }
    var syms: List(LgSym) := Nil
    var j: u64 := 0
    while j < n {
      let s := lg_at(a, at + 3 + j, context)
      if s >= 0 {
        let nt := U64::of_i64(s)
        if nt >= n_nts { lg_invalid(context, "production symbol is not a non-terminal") }
        syms := Cons(LgN(nt), syms)
      } else {
        let terminal := U64::of_i64(0 - (s + 1))
        if terminal >= n_terms { lg_invalid(context, "production symbol is not a terminal") }
        syms := Cons(LgT(terminal), syms)
      }
      j := j + 1
    }
    prods := Cons(LgProd { lhs: lhs, rhs: lg_rev_sym(syms) }, prods)
    lg_push_prod(&mut by_nt, lhs, p)
    at := at + 3 + n
    p := p + 1
  }
  if at != Array::len(a) { lg_invalid(context, "extra production data") }
  var nt_prods: List(List(u64)) := Nil
  var q: u64 := n_nts
  while q > 0 {
    q := q - 1
    nt_prods := Cons(lg_rev(lg_vec_list(&by_nt, q)), nt_prods)
  }
  LgGrammar {
    prods: Array::of_list(lg_rev_prod(prods)),
    nt_prods: Array::of_list(nt_prods),
    start: start
  }
}

pub fn lg_vec_list(&v: Vec(List(u64)), i: u64): List(u64) {
  let &x := Vec::index(&v, i)
  x
}

pub fn lg_push_prod(&mut v: Vec(List(u64)), nt: u64, p: u64): Unit {
  match Vec::get_mut(&mut v, nt) {
    Some(slot) => {
      slot := Cons(p, slot)
    }
    None => lg_invalid("productions", "left side is not a non-terminal")
  }
}

pub fn lg_rev_sym(xs: List(LgSym)): List(LgSym) {
  var out: List(LgSym) := Nil
  var rest := xs
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        out := Cons(x, out)
        rest := more
      }
    }
  }
  out
}

pub fn lg_rev_prod(xs: List(LgProd)): List(LgProd) {
  var out: List(LgProd) := Nil
  var rest := xs
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        out := Cons(x, out)
        rest := more
      }
    }
  }
  out
}

pub fn lg_push_num(&mut b: Buf, n: u64): Unit {
  Buf::push(&mut b, &" ")
  Buf::push(&mut b, &Text::of_u64(n))
}

pub fn lg_push_prod_num(&mut b: Buf, p: u64): Unit {
  Buf::push(&mut b, &" ")
  if p == 0 {
    Buf::push(&mut b, &"-1")
  } else {
    Buf::push(&mut b, &Text::of_u64(p - 1))
  }
}

// One automaton as `lookahead` writes it: the non-terminal, the production
// with no token read, `k`, the number of transitions and each transition.
pub fn lg_push_automaton(&mut b: Buf, nt: u64, nodes: List(LgNode), k: u64): Unit {
  var count: u64 := 0
  var rest := nodes
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(n, more) => {
        count := count + lg_len(n.nb)
        rest := more
      }
    }
  }
  lg_push_num(&mut b, nt)
  lg_push_prod_num(&mut b, lg_node_get(nodes, 0).prod)
  lg_push_num(&mut b, k)
  lg_push_num(&mut b, count)
  rest := nodes
  running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(n, more) => {
        var ts := lg_sort_by_term(n.nb)
        var walking := true
        while walking {
          match ts {
            Nil => {
              walking := false
            }
            Cons(x, others) => {
              lg_push_num(&mut b, n.id)
              lg_push_num(&mut b, mod(x, 65536))
              lg_push_num(&mut b, div(x, 65536))
              lg_push_prod_num(&mut b, lg_node_get(nodes, div(x, 65536)).prod)
              ts := others
            }
          }
        }
        rest := more
      }
    }
  }
}

// Neighbours (`state * 65536 + terminal`) in the order of their terminals.
pub fn lg_sort_by_term(nb: List(u64)): List(u64) {
  lg_unswap(lg_sort_keep(lg_swap(nb)))
}

pub fn lg_swap(nb: List(u64)): List(u64) {
  match nb {
    Nil => Nil
    Cons(x, rest) => Cons(mod(x, 65536) * 65536 + div(x, 65536), lg_swap(rest))
  }
}

pub fn lg_unswap(nb: List(u64)): List(u64) {
  lg_swap(nb)
}

// The first overlapping pair and tuple, in production and tuple order.
// Alternative numbers are one-based production indices for the whole grammar.
// LgSet keeps its tuples sorted, so intersection uses a merge walk.
pub(open) struct LgConflict { left: u64, right: u64, tuple: u64 }

pub fn lg_common(xs: List(u64), ys: List(u64)): Option(u64) {
  match xs {
    Nil => None
    Cons(x, rest) => match ys {
      Nil => None
      Cons(y, more) => if x == y { Some(x) } else if x < y { lg_common(rest, ys) } else {
        lg_common(xs, more)
      }
    }
  }
}

pub fn lg_conflict_with(x: Pair(u64, LgSet), ys: List(Pair(u64, LgSet))): Option(LgConflict) {
  match ys {
    Nil => None
    Cons(y, rest) => match lg_common(x.snd.tuples, y.snd.tuples) {
      Some(t) => Some(LgConflict { left: x.fst, right: y.fst, tuple: t })
      None => lg_conflict_with(x, rest)
    }
  }
}

pub fn lg_conflict(xs: List(Pair(u64, LgSet))): Option(LgConflict) {
  match xs {
    Nil => None
    Cons(x, rest) => match lg_conflict_with(x, rest) {
      Some(c) => Some(c)
      None => lg_conflict(rest)
    }
  }
}

pub fn lg_name(names: List(Text), at: u64): Text {
  match names {
    Nil => Text::concat_all(Cons("#", Cons(Text::of_u64(at), Nil)))
    Cons(n, rest) => if at == 0 { n } else { lg_name(rest, at - 1) }
  }
}

pub fn lg_symbol_names(syms: List(LgSym), nts: List(Text), terms: List(Text)): List(Text) {
  match syms {
    Nil => Nil
    Cons(sym, rest) => Cons(match sym {
      LgN(n) => lg_name(nts, n)
      LgT(t) => lg_name(terms, t)
    }, lg_symbol_names(rest, nts, terms))
  }
}

pub fn lg_terminal_names(ts: List(u64), terms: List(Text)): List(Text) {
  match ts {
    Nil => Nil
    Cons(t, rest) => Cons(
      if t == 255 { "epsilon" } else { lg_name(terms, t) },
      lg_terminal_names(rest, terms)
    )
  }
}

pub fn lg_conflict_text(
  g: LgGrammar,
  cache: LgCache,
  nt: u64,
  k: u64,
  nts: List(Text),
  terms: List(Text)
): Text {
  let ready := lg_cache_upto(g, cache, k)
  let prefix := Text::concat_all(
    Cons("LL(", Cons(Text::of_u64(k), Cons(") conflict in rule ", Cons(lg_name(nts, nt), Nil))))
  )
  match lg_conflict(lg_tuples_of(g, ready, nt, k)) {
    None => Text::concat_all(Cons(prefix, Cons(": unable to distinguish alternatives", Nil)))
    Some(c) => Text::concat_all(
      Cons(
        prefix,
        Cons(
          text_newline(),
          Cons(
            "  alternative #",
            Cons(
              Text::of_u64(c.left + 1),
              Cons(
                ": ",
                Cons(
                  text_join(lg_symbol_names(lg_prod_at(g, c.left).rhs, nts, terms), " "),
                  Cons(
                    text_newline(),
                    Cons(
                      "  alternative #",
                      Cons(
                        Text::of_u64(c.right + 1),
                        Cons(
                          ": ",
                          Cons(
                            text_join(lg_symbol_names(lg_prod_at(g, c.right).rhs, nts, terms), " "),
                            Cons(
                              text_newline(),
                              Cons(
                                "  common lookahead: ",
                                Cons(
                                  text_join(lg_terminal_names(kt_terms(c.tuple), terms), " "),
                                  Nil
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  }
}

pub(open) struct LgRun { text: Text, max_k: u64, failed: Option(Text) }

// The lookahead automata of all non-terminals.
pub fn lg_lookahead(g: LgGrammar, max_k: u64, nts: List(Text), terms: List(Text)): LgRun {
  var b := Buf::new()
  var cache := LgCache { firsts: Nil, follows: Nil }
  var most: u64 := 0
  var failed: Option(Text) := None
  var nt: u64 := 0
  let n_nts := lg_n_nts(g)
  let c0 := lg_cache_upto(g, cache, 0)
  cache := c0
  while nt < n_nts && lg_is_none_text(failed) {
    match lg_decide(g, cache, nt, max_k) {
      None => {
        failed := Some(lg_conflict_text(g, cache, nt, max_k, nts, terms))
      }
      Some(d) => {
        cache := d.cache
        var tuples := lg_tuples_of(g, cache, nt, d.k)
        var dfa: Vec(LgState) := Vec::new()
        var first := true
        var rest := tuples
        var running := true
        while running {
          match rest {
            Nil => {
              running := false
            }
            Cons(pair, more) => {
              let one := lg_dfa_of(pair.snd.tuples, pair.fst)
              if first {
                dfa := one
                first := false
              } else if lg_dfa_unite(&mut dfa, &one) {
                failed := Some(lg_conflict_text(g, cache, nt, d.k, nts, terms))
              }
              rest := more
            }
          }
        }
        let k_dfa := lg_state_get(&dfa, 0).k
        if k_dfa > most {
          most := k_dfa
        }
        let nodes := lg_minimize(lg_nodes_of(&dfa))
        lg_push_automaton(&mut b, nt, nodes, k_dfa)
        nt := nt + 1
      }
    }
  }
  LgRun { text: Text::of(b), max_k: most, failed: failed }
}

pub fn lg_is_none_text(o: Option(Text)): Bool {
  match o {
    None => true
    Some(x) => false
  }
}

// The `max_k` and `lookahead` lines of the grammar in a table file (its
// productions after the EBNF is gone), or why there are none.
pub fn lg_lookahead_lines(table: Text): Text {
  let lines := text_lines(table)
  let start := match lg_find_line(lines, "start") {
    Cons(w, Nil) => lg_nat(w, "start")
    _ => perform fail("expected one start value")
  }
  let nts := lg_line_names(lines, "non_terminals")
  let terms := lg_line_names(lines, "terminals")
  let n_nts := md_len_text(nts)
  let g := lg_grammar_of(
    lg_find_line(lines, "productions"),
    n_nts,
    md_len_text(terms),
    start,
    "productions"
  )
  let run := lg_lookahead(g, 3, nts, terms)
  match run.failed {
    Some(why) => Text::concat_all(Cons(why, Cons(text_newline(), Nil)))
    None => Text::concat_all(
      Cons(
        "max_k ",
        Cons(
          Text::of_u64(run.max_k),
          Cons(
            text_newline(),
            Cons("lookahead ", Cons(Text::of_u64(n_nts), Cons(run.text, Cons(text_newline(), Nil))))
          )
        )
      )
    )
  }
}

// The trees of the regular expressions that the lines are, one a line.
pub fn lg_rx_trees(lines: List(Text)): Text {
  match lines {
    Nil => ""
    Cons(line, rest) => if std::prelude::Text::len(line) > 0 {
      Text::concat_all(
        Cons(rx_show(rx_parse(line)), Cons(text_newline(), Cons(lg_rx_trees(rest), Nil)))
      )
    } else {
      lg_rx_trees(rest)
    }
  }
}

// The lines of a table file in the order they are written, from the grammar.
pub fn lg_tables(source: Text): Text {
  let m := md_build(par_read(source))
  if m.lalr {
    par_die("the grammar is LALR(1); totes/lalrgen makes its tables")
  }
  let base := text_lines(em_model(m))
  // title, max_k, terminals, non_terminals, nt_kinds, start, productions,
  // symbol_attrs, lookahead, skip.
  if lg_count(base) != 10 {
    par_die(text_join(base, text_newline()))
  } else {
    let schema := sg_build(m)
    let scan := sc_lines(m)
    let head := lg_take_lines(base, 8)
    let tail := lg_drop_lines(base, 8)
    let lines := lg_cat(
      Cons(
        "tauto-syntax-tables 1",
        Cons(
          Text::concat_all(Cons("grammar_sha256 ", Cons(sha256_hex(source), Nil))),
          Cons("generator llkgen 0.1.0", Nil)
        )
      ),
      lg_cat(
        head,
        Cons(
          sg_prod_types_line(&schema),
          lg_cat(tail, lg_cat(scan, Cons(sg_schema_line(&schema), Nil)))
        )
      )
    )
    Text::concat_all(Cons(text_join(lines, text_newline()), Cons(text_newline(), Nil)))
  }
}

pub fn lg_count(xs: List(Text)): u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + lg_count(rest)
  }
}

pub fn lg_take_lines(xs: List(Text), n: u64): List(Text) {
  match xs {
    Nil => Nil
    Cons(x, rest) => if n == 0 { Nil } else { Cons(x, lg_take_lines(rest, n - 1)) }
  }
}

pub fn lg_drop_lines(xs: List(Text), n: u64): List(Text) {
  match xs {
    Nil => Nil
    Cons(x, rest) => if n == 0 { xs } else { lg_drop_lines(rest, n - 1) }
  }
}

pub fn lg_cat(a: List(Text), b: List(Text)): List(Text) {
  match a {
    Nil => b
    Cons(x, rest) => Cons(x, lg_cat(rest, b))
  }
}

// What the tote gives, each from a text: a value, or why there is none (an
// index past the end of a vector is a bug here, and says so).

// The table file of a grammar.
pub fn llkgen_tables(grammar: Text): Result(Text, Text) {
  handle { Ok(lg_tables(grammar)) } with {
    fail<Text>(why) => Err(why)
    out_of_bounds() => Err("llkgen: an index is out of bounds")
  }
}

// The lines of the table file of a grammar that the reading of the grammar
// and the lookahead analysis decide (`title` to `skip`, without
// `prod_types`).
pub fn llkgen_model_lines(grammar: Text): Result(Text, Text) {
  handle {
    Ok(Text::concat_all(Cons(em_model(md_build(par_read(grammar))), Cons(text_newline(), Nil))))
  } with {
    fail<Text>(why) => Err(why)
    out_of_bounds() => Err("llkgen: an index is out of bounds")
  }
}

// The lines of the table file of a grammar that its scanner decides
// (`classes` to `dynamic_dfas`).
pub fn llkgen_scan_lines(grammar: Text): Result(Text, Text) {
  handle {
    Ok(
      Text::concat_all(
        Cons(
          text_join(sc_lines(md_build(par_read(grammar))), text_newline()),
          Cons(text_newline(), Nil)
        )
      )
    )
  } with {
    fail<Text>(why) => Err(why)
    out_of_bounds() => Err("llkgen: an index is out of bounds")
  }
}

// The tree that each line of `lines` read as a regular expression is.
pub fn llkgen_rx_trees(lines: Text): Result(Text, Text) {
  handle { Ok(lg_rx_trees(text_lines(lines))) } with {
    fail<Text>(why) => Err(why)
    out_of_bounds() => Err("llkgen: an index is out of bounds")
  }
}

// From the grammar in a table file, the `max_k` and `lookahead` lines that
// the file holds, made again by the lookahead analysis (or why it fails).
pub fn llkgen_lookahead_lines(table: Text): Result(Text, Text) {
  handle { Ok(lg_lookahead_lines(table)) } with {
    fail<Text>(why) => Err(why)
    out_of_bounds() => Err("llkgen: an index is out of bounds")
  }
}

pub fn lg_line_names(lines: List(Text), name: Text): List(Text) {
  let context := name
  match lg_find_line(lines, name) {
    Nil => lg_invalid(context, "missing count and names")
    Cons(count, names) => {
      if lg_nat(count, context) != md_len_text(names) {
        lg_invalid(context, "name count does not match the names")
      }
      names
    }
  }
}

pub fn em_model(m: MModel): Text {
  let production_words := em_prod_words(m.prods)
  let n_prods := em_len_prods(m.prods)
  let n_nts := md_len_text(m.nts)
  let g := lg_grammar_of(
    production_words_with_count(n_prods, production_words),
    n_nts,
    md_len_text(m.terminal_names),
    m.start,
    "generated productions"
  )
  let run := lg_lookahead(g, 3, m.nts, m.terminal_names)
  let clipped := em_clipped(m.prods, 0)
  let lines := Cons(
    em_title(m),
    Cons(
      Text::concat_all(Cons("max_k ", Cons(Text::of_u64(run.max_k), Nil))),
      Cons(
        em_line("terminals", md_len_text(m.terminal_names), m.terminal_names),
        Cons(
          em_line("non_terminals", n_nts, m.nts),
          Cons(
            em_line("nt_kinds", n_nts, em_nums(m.nt_kinds)),
            Cons(
              Text::concat_all(Cons("start ", Cons(Text::of_u64(m.start), Nil))),
              Cons(
                em_line("productions", n_prods, production_words),
                Cons(
                  em_line("symbol_attrs", u64_div3(md_len_text(clipped)), clipped),
                  Cons(
                    Text::concat_all(
                      Cons("lookahead ", Cons(Text::of_u64(n_nts), Cons(run.text, Nil)))
                    ),
                    Cons(em_line("skip", md_len_scanners(m.skips), em_skip_words(m.skips)), Nil)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  match run.failed {
    Some(why) => why
    None => text_join(lines, text_newline())
  }
}
