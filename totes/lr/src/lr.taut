// Derived from the LR parser of parol_runtime (Jörg Singer; MIT OR Apache-2.0); see NOTICE.
import std::Stack
import std::Array
import "../../scan/src/scan.taut"
import "../../llk/src/llk.taut"

// The LALR(1) parser that reads the tables of the LALR(1) table generator,
// in the proof language (`docs/design/self-host.md`). `README.md` says what
// it does and why. The tokens, the events it gives and its errors are those
// of `totes/llk`.

// A symbol on the parser's stack: a terminal it shifted or a non-terminal a
// reduce made.
pub(open) inductive LrSym: Type {
  LrT(terminal: Nat): LrSym
  LrN(non_terminal: Nat): LrSym
}

// A production: its left side, and its right side last first (the order a
// reduce pops it in).
pub(open) inductive LrProduction: Type {
  Mk(lhs: Nat, pops: List(LrSym)): LrProduction
}

// A node of the tree a parse builds: a token, or a production with the
// numbers of its children's nodes, in order.
pub(open) inductive LrNode: Type {
  LrLeaf(token: LlkTok): LrNode
  MkLrNode(production: Nat, lhs: Nat, kids: List(Nat)): LrNode
}

// What the run of the parser gives: the nodes, the first numbered 0, and the
// root's number.
pub(open) inductive LrRun: Type {
  LrBuilt(nodes: Array(LrNode), root: Nat): LrRun
  LrStuck(error: LlkError): LrRun
}

pub(open) inductive LrTables: Type {
  Mk(
    start: Nat,
    terminals: Nat,
    non_terminals: Nat,
    // The terminals that are skipped in each scanner mode.
    skip: Array(List(Nat)),
    // (state, terminal): 0 none, `s * 4 + 1` shift to `s`, `p * 4 + 2`
    // reduce by `p`, `p * 4 + 3` accept by `p`.
    actions: Array(Nat),
    // (state, non-terminal): the state + 1, or 0.
    gotos: Array(Nat),
    productions: Array(LrProduction)
  ): LrTables
}

// ---- reading the tables ------------------------------------------------------

// The cells, run by run, until `total` are (last first), and where the runs
// end. Each run fills one cell at least, so `fuel` is `total`.
pub fn lr_cells_in(
  fuel: Nat,
  total: Nat,
  a: Array(Nat),
  filled: Nat,
  rp: Nat,
  done: List(Nat)
): Pair(List(Nat), Nat) {
  match fuel: Pair(List(Nat), Nat) {
    Zero => Pair { fst: done, snd: rp }
    Succ(f) => match filled < total: Pair(List(Nat), Nat) {
      false => Pair { fst: done, snd: rp }
      true => lr_cells_in(
        f,
        total,
        a,
        filled + scan_number(a, rp),
        rp + 2,
        scan_repeat_onto(scan_number(a, rp), scan_number(a, rp + 1), done)
      )
    }
  }
}

// `k` symbols from `at`, put before `done` last first.
pub fn lr_symbols_onto(k: Nat, a: Array(Nat), at: Nat, done: List(LrSym)): List(LrSym) {
  match k: List(LrSym) {
    Zero => done
    Succ(k2) => lr_symbols_onto(
      k2,
      a,
      at + 2,
      Cons(
        match scan_number(a, at): LrSym {
          Zero => LrN(scan_number(a, at + 1))
          Succ(other) => LrT(scan_number(a, at + 1))
        },
        done
      )
    )
  }
}

// `k` productions from `pp` (last first), and where they end.
pub fn lr_productions_in(
  k: Nat,
  a: Array(Nat),
  pp: Nat,
  done: List(LrProduction)
): Pair(List(LrProduction), Nat) {
  match k: Pair(List(LrProduction), Nat) {
    Zero => Pair { fst: done, snd: pp }
    Succ(k2) => lr_productions_in(
      k2,
      a,
      pp + 2 + scan_number(a, pp + 1) * 2,
      Cons(
        LrProduction {
          lhs: scan_number(a, pp),
          pops: List::reverse(lr_symbols_onto(scan_number(a, pp + 1), a, pp + 2, Nil))
        },
        done
      )
    )
  }
}

pub fn lr_tables_from(
  m: Array(Nat),
  sk: Array(Nat),
  ac: Array(Nat),
  go: Array(Nat),
  pr: Array(Nat)
): Option(LrTables) {
  let terminals := scan_number(m, 1)
  let non_terminals := scan_number(m, 2)
  let states := scan_number(m, 3)
  let skips := llk_skips_in(scan_number(sk, 0), sk, 1, Nil)
  let actions := lr_cells_in(states * terminals, states * terminals, ac, 0, 0, Nil)
  let gotos := lr_cells_in(states * non_terminals, states * non_terminals, go, 0, 0, Nil)
  let productions := lr_productions_in(scan_number(pr, 0), pr, 1, Nil)
  match scan_within(
    4,
    m
  ) && scan_within(
    (skips: Nat),
    sk
  ) && scan_within(
    (actions: Nat),
    ac
  ) && scan_within((gotos: Nat), go) && scan_within((productions: Nat), pr): Option(LrTables) {
    false => None
    true => Some(
      LrTables {
        start: scan_number(m, 0),
        terminals: terminals,
        non_terminals: non_terminals,
        skip: Array::of_list(List::reverse((skips: List(List(Nat))))),
        actions: scan_array((actions: List(Nat))),
        gotos: scan_array((gotos: List(Nat))),
        productions: Array::of_list(List::reverse((productions: List(LrProduction))))
      }
    )
  }
}

// Reads the tables from the texts `meta`, `skip`, `actions`, `gotos` and
// `productions` (`Tables::lr_texts` in `crates/tauto-syntax` writes them).
// `None` when they are too short for what they say.
pub fn lr_tables_read(
  meta: Text,
  skip: Text,
  actions: Text,
  gotos: Text,
  productions: Text
): Option(LrTables) {
  lr_tables_from(
    Array::of_list(text_number_list(meta)),
    Array::of_list(text_number_list(skip)),
    Array::of_list(text_number_list(actions)),
    Array::of_list(text_number_list(gotos)),
    Array::of_list(text_number_list(productions))
  )
}

// The tokens the parser reads, each with the skipped ones before it, as
// `llk_tokens` gives them.
pub fn lr_tokens(&t: LrTables, tokens: List(ScanToken), length: Nat): List(LlkTok) {
  llk_tokens_in(tokens, t.skip, length, Nil, Nil)
}

// ---- the stack ---------------------------------------------------------------

pub fn lr_top(states: List(Nat)): Nat {
  match states: Nat {
    Nil => 0
    Cons(s, rest) => s
  }
}

pub fn lr_sym_eq(a: LrSym, b: LrSym): Bool {
  match a: Bool {
    LrT(x) => match b: Bool {
      LrT(y) => x == y
      LrN(y) => false
    }
    LrN(x) => match b: Bool {
      LrT(y) => false
      LrN(y) => x == y
    }
  }
}

// What is left of the stack `syms` (top first) when a production's right
// side (`pops`, last first) is on top of it; `None` when it is not.
pub fn lr_pop(pops: List(LrSym), syms: List(LrSym)): Option(List(LrSym)) {
  match pops: Option(List(LrSym)) {
    Nil => Some(syms)
    Cons(p, more) => match syms: Option(List(LrSym)) {
      Nil => None
      Cons(s, rest) => match lr_sym_eq(p, s): Option(List(LrSym)) {
        true => lr_pop(more, rest)
        false => None
      }
    }
  }
}

pub fn lr_drop<A>(k: Nat, xs: List(A)): List(A) {
  match k: List(A) {
    Zero => xs
    Succ(k2) => match xs: List(A) {
      Nil => Nil
      Cons(x, rest) => lr_drop(k2, rest)
    }
  }
}

// The first `k` of `xs` before `done`, last first: the children of a reduce,
// in order, from the node numbers on the stack.
pub fn lr_take_onto(k: Nat, xs: List(Nat), done: List(Nat)): List(Nat) {
  match k: List(Nat) {
    Zero => done
    Succ(k2) => match xs: List(Nat) {
      Nil => done
      Cons(x, rest) => lr_take_onto(k2, rest, Cons(x, done))
    }
  }
}

pub fn lr_action(&t: LrTables, state: Nat, terminal: Nat): Nat {
  scan_number(t.actions, state * t.terminals + terminal)
}

// The terminals the state has an action for, from `k - 1` down, before `done`.
pub fn lr_expected_in(k: Nat, &t: LrTables, state: Nat, done: List(Nat)): List(Nat) {
  match k: List(Nat) {
    Zero => done
    Succ(k2) => match lr_action(t, state, k2) == 0: List(Nat) {
      true => lr_expected_in(k2, t, state, done)
      false => lr_expected_in(k2, t, state, Cons(k2, done))
    }
  }
}

// ---- parsing -----------------------------------------------------------------

// Where a parse is: the tokens ahead, and the stack as three lists, top
// first: the states (the first state at the bottom), the symbols and the
// numbers of their nodes. `nodes` holds the nodes made so far, last first,
// and `count` how many.
pub(open) inductive LrConf: Type {
  Mk(
    tokens: List(LlkTok),
    states: List(Nat),
    syms: List(LrSym),
    kids: List(Nat),
    nodes: List(LrNode),
    count: Nat
  ): LrConf
}

// What a step gives: where the parse goes on from, or how it ends.
pub(open) inductive LrNext: Type {
  LrGo(conf: LrConf): LrNext
  LrEnd(run: LrRun): LrNext
}

pub fn lr_stuck_at(tokens: List(LlkTok), expected: List(Nat)): LrNext {
  match tokens: LrNext {
    Nil => LrEnd(LrStuck(LlkError { at: None, expected: expected }))
    Cons(token, rest) => LrEnd(LrStuck(LlkError { at: Some(token.start), expected: expected }))
  }
}

// A step that the tables cannot have asked for (the LALR(1) table generator
// never writes it).
pub fn lr_broken(): LrNext {
  LrEnd(LrStuck(LlkError { at: None, expected: Nil }))
}

// One step: the action of the state on top for the next token.
pub fn lr_step(&t: LrTables, c: LrConf): LrNext {
  match c: LrNext {
    Mk(tokens, states, syms, kids, nodes, count) => lr_act(
      t,
      tokens,
      states,
      syms,
      kids,
      nodes,
      count,
      Nat::div_nz(lr_action(t, lr_top(states), llk_next_type(tokens)), 4, Nat::ne_zero(4, Refl)),
      Nat::rem_nz(lr_action(t, lr_top(states), llk_next_type(tokens)), 4, Nat::ne_zero(4, Refl))
    )
  }
}

// The action `kind` (0 none, 1 shift, 2 reduce, 3 accept) with its state or
// production `arg`.
pub fn lr_act(
  &t: LrTables,
  tokens: List(LlkTok),
  states: List(Nat),
  syms: List(LrSym),
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  arg: Nat,
  kind: Nat
): LrNext {
  match kind: LrNext {
    Zero => lr_stuck_at(tokens, lr_expected_in(t.terminals, t, lr_top(states), Nil))
    Succ(k) => match k: LrNext {
      Zero => lr_shift(tokens, states, syms, kids, nodes, count, arg)
      Succ(k2) => match k2: LrNext {
        Zero => lr_reduce(
          t,
          tokens,
          states,
          syms,
          kids,
          nodes,
          count,
          arg,
          Array::get(t.productions, arg)
        )
        Succ(k3) => lr_accept(
          t,
          tokens,
          syms,
          kids,
          nodes,
          count,
          arg,
          Array::get(t.productions, arg)
        )
      }
    }
  }
}

// Shifting the next token, which is not the end of the input.
pub fn lr_shift(
  tokens: List(LlkTok),
  states: List(Nat),
  syms: List(LrSym),
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  to: Nat
): LrNext {
  match tokens: LrNext {
    Nil => lr_broken()
    Cons(token, more) => lr_shift_at(
      token,
      more,
      states,
      syms,
      kids,
      nodes,
      count,
      to,
      token.token_type == 0
    )
  }
}

pub fn lr_shift_at(
  token: LlkTok,
  more: List(LlkTok),
  states: List(Nat),
  syms: List(LrSym),
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  to: Nat,
  at_end: Bool
): LrNext {
  match at_end: LrNext {
    true => lr_broken()
    false => LrGo(
      LrConf {
        tokens: more,
        states: Cons(to, states),
        syms: Cons(LrT(token.token_type), syms),
        kids: Cons(count, kids),
        nodes: Cons(LrLeaf(token), nodes),
        count: count + 1
      }
    )
  }
}

// Reducing by the production `p` (`found`): its right side must be on top
// of the stack.
pub fn lr_reduce(
  &t: LrTables,
  tokens: List(LlkTok),
  states: List(Nat),
  syms: List(LrSym),
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  p: Nat,
  found: Option(LrProduction)
): LrNext {
  match found: LrNext {
    None => lr_broken()
    Some(prod) => lr_reduce_pop(
      t,
      tokens,
      states,
      kids,
      nodes,
      count,
      p,
      prod,
      lr_pop(prod.pops, syms)
    )
  }
}

pub fn lr_reduce_pop(
  &t: LrTables,
  tokens: List(LlkTok),
  states: List(Nat),
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  p: Nat,
  prod: LrProduction,
  left: Option(List(LrSym))
): LrNext {
  match left: LrNext {
    None => lr_broken()
    Some(rest) => lr_goto(
      tokens,
      lr_drop(List::length(prod.pops), states),
      rest,
      lr_drop(List::length(prod.pops), kids),
      nodes,
      count,
      MkLrNode(p, prod.lhs, lr_take_onto(List::length(prod.pops), kids, Nil)),
      prod.lhs,
      scan_number(
        t.gotos,
        lr_top(lr_drop(List::length(prod.pops), states)) * t.non_terminals + prod.lhs
      )
    )
  }
}

// The left side `lhs` of a reduce goes on the stack, in the state the goto
// (`go`, plus one) of the state under it names.
pub fn lr_goto(
  tokens: List(LlkTok),
  states: List(Nat),
  rest: List(LrSym),
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  node: LrNode,
  lhs: Nat,
  go: Nat
): LrNext {
  match go: LrNext {
    Zero => lr_broken()
    Succ(to) => LrGo(
      LrConf {
        tokens: tokens,
        states: Cons(to, states),
        syms: Cons(LrN(lhs), rest),
        kids: Cons(count, kids),
        nodes: Cons(node, nodes),
        count: count + 1
      }
    )
  }
}

// Accepting by the production `p` (`found`): it is of the start symbol, its
// right side is all of the stack, and the input is at its end.
pub fn lr_accept(
  &t: LrTables,
  tokens: List(LlkTok),
  syms: List(LrSym),
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  p: Nat,
  found: Option(LrProduction)
): LrNext {
  match found: LrNext {
    None => lr_broken()
    Some(prod) => lr_accept_pop(t, tokens, kids, nodes, count, p, prod, lr_pop(prod.pops, syms))
  }
}

pub fn lr_accept_pop(
  &t: LrTables,
  tokens: List(LlkTok),
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  p: Nat,
  prod: LrProduction,
  left: Option(List(LrSym))
): LrNext {
  match left: LrNext {
    None => lr_broken()
    Some(rest) => match rest: LrNext {
      Cons(s, more) => lr_broken()
      Nil => lr_accept_at(
        kids,
        nodes,
        count,
        p,
        prod,
        prod.lhs == t.start && llk_next_type(tokens) == 0
      )
    }
  }
}

pub fn lr_accept_at(
  kids: List(Nat),
  nodes: List(LrNode),
  count: Nat,
  p: Nat,
  prod: LrProduction,
  ok: Bool
): LrNext {
  match ok: LrNext {
    false => lr_broken()
    true => LrEnd(
      LrBuilt(
        Array::of_list(
          List::reverse(
            Cons(MkLrNode(p, prod.lhs, lr_take_onto(List::length(prod.pops), kids, Nil)), nodes)
          )
        ),
        count
      )
    )
  }
}

// At most `fuel` steps of the parser. The first error ends it.
pub fn lr_run(fuel: Nat, &t: LrTables, c: LrConf): LrRun {
  match fuel: LrRun {
    Zero => LrStuck(LlkError { at: None, expected: Nil })
    Succ(f) => match lr_step(t, c): LrRun {
      LrGo(next) => lr_run(f, t, next)
      LrEnd(r) => r
    }
  }
}

// A budget of steps from the number of tokens and of non-terminals.
pub fn lr_fuel(t: LrTables, tokens: List(LlkTok)): Nat {
  (List::length(tokens) + 1) * (t.non_terminals + 1) * 16
}

// The run of the parser over the tokens, from state 0 with nothing on the
// stack.
pub fn lr_run_all(fuel: Nat, &t: LrTables, tokens: List(LlkTok)): LrRun {
  lr_run(
    fuel,
    t,
    LrConf { tokens: tokens, states: Cons(0, Nil), syms: Nil, kids: Nil, nodes: Nil, count: 0 }
  )
}

// ---- the events --------------------------------------------------------------

// What is left to walk: a node, or the close of one.
pub(open) inductive LrWork: Type {
  LrWNode(index: Nat): LrWork
  LrWClose: LrWork
}

pub fn lr_works_onto(kids: List(Nat), rest: List(LrWork)): List(LrWork) {
  match kids: List(LrWork) {
    Nil => rest
    Cons(k, more) => Cons(LrWNode(k), lr_works_onto(more, rest))
  }
}

// The events of the nodes in `work`, pushed in order: a node opens its left
// side, then its children, then closes; a token comes after the skipped
// tokens before it. Each node is walked once, so `fuel` is twice the nodes.
pub fn lr_walk(
  fuel: Nat,
  nodes: Array(LrNode),
  work: List(LrWork),
  &mut events: Stack(LlkEvent)
): Unit {
  match fuel: Unit {
    Zero => #()
    Succ(f) => match work: Unit {
      Nil => #()
      Cons(w, rest) => match w: Unit {
        LrWClose => {
          Stack::push(&mut events, LlkClose)
          lr_walk(f, nodes, rest, &mut events)
        }
        LrWNode(i) => match Array::get(nodes, i): Unit {
          None => lr_walk(f, nodes, rest, &mut events)
          Some(node) => match node: Unit {
            LrLeaf(token) => {
              llk_trivia_onto(token.trivia, &mut events)
              Stack::push(&mut events, LlkToken(token.token_type, token.start, token.end))
              lr_walk(f, nodes, rest, &mut events)
            }
            MkLrNode(p, lhs, kids) => {
              Stack::push(&mut events, LlkOpen(lhs))
              lr_walk(f, nodes, lr_works_onto(kids, Cons(LrWClose, rest)), &mut events)
            }
          }
        }
      }
    }
  }
}

// The skipped tokens before the end of the input.
pub fn lr_end_trivia(tokens: List(LlkTok)): List(ScanToken) {
  match tokens: List(ScanToken) {
    Nil => Nil
    Cons(token, rest) => match token.token_type == 0: List(ScanToken) {
      true => token.trivia
      false => lr_end_trivia(rest)
    }
  }
}

// The events of a run that built its tree, as `llk_parse` gives them: the
// root (the node of the empty name, number `non_terminals`) around the tree
// and the skipped tokens at the end.
pub fn lr_events_of(
  &t: LrTables,
  tokens: List(LlkTok),
  r: LrRun,
  &mut events: Stack(LlkEvent)
): LlkResult {
  match r: LlkResult {
    LrStuck(e) => LlkFailed(e)
    LrBuilt(nodes, Root) => {
      Stack::push(&mut events, LlkOpen(t.non_terminals))
      lr_walk(Array::len(nodes) * 2 + 1, nodes, Cons(LrWNode(Root), Nil), &mut events)
      llk_trivia_onto(lr_end_trivia(tokens), &mut events)
      Stack::push(&mut events, LlkClose)
      LlkParsed
    }
  }
}

// Parses the tokens from the start symbol, leaving the events on `events`
// (the last on top), as `llk_parse` does. A parse that exhausts its fuel
// fails. The caller supplies `lr_fuel`; the proofs take any fuel.
pub fn lr_parse(
  fuel: Nat,
  &t: LrTables,
  tokens: List(LlkTok),
  &mut events: Stack(LlkEvent)
): LlkResult {
  lr_events_of(t, tokens, lr_run_all(fuel, t, tokens), &mut events)
}
