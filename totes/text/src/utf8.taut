import "nat.taut"
import "text.taut"
import std::Text

// Decoding undoes encoding (`docs/design/self-host.md`「text と unicode（`totes/text`、`totes/unicode`）」): for every character `c`
// (below 0x110000 and not a surrogate), `text_decode` reads `c` back from
// the first byte of `Text::utf8_of_code_point(c)`, with the whole encoding as its
// length.
//
// This file is not part of the tote's program: `tauto check` checks it.

// `c` is a character: below 0x110000 and not a surrogate.
pub fn text_is_char(c: Nat): Bool {
  Bool::and(Nat::lt(c, 1114112), not(Bool::and(Nat::le(55296, c), Nat::lt(c, 57344))))
}

// `t` decodes, from its first byte, to `c` and all of `t`.
pub fn utf8_round(t: Text, c: Nat): Prop {
  text_decode(t, 0) = Some(#(@code c, @len Text::len(t)))
}

// ---- the steps of `Text::utf8_of_code_point` ------------------------------------
//
// `Text::utf8_of_code_point` (`std/Text.taut`) in pieces, one function a step:
// each is what the encoder computes once the tests before it have failed, so
// `Text::utf8_of_code_point(c)` is `Text::Mk(Cons(c, Nil))` or `text_utf8_from_128(c)`
// by computation alone.

// The UTF-8 encoding of a number from 65536 on: four bytes below 0x110000.
pub fn text_utf8_from_65536(c: Nat): Text {
  match Nat::lt(c, 1114112): Text {
    true => Text::Mk(
      Cons(
        Nat::add(Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)), 240),
        Cons(
          Nat::add(Nat::rem_nz(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 64, Nat::ne_zero(64, Refl)), 128),
          Cons(Nat::add(Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)), 128), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))
        )
      )
    )
    false => Text::Mk(Nil)
  }
}

// From 2048 on, past the surrogates: three bytes below 65536.
pub fn text_utf8_past_surrogates(c: Nat): Text {
  match Nat::lt(c, 65536): Text {
    true => Text::Mk(
      Cons(
        Nat::add(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 224),
        Cons(Nat::add(Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)), 128), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))
      )
    )
    false => text_utf8_from_65536(c)
  }
}

// From 2048 on: nothing for a surrogate.
pub fn text_utf8_from_2048(c: Nat): Text {
  match Bool::and(Nat::le(55296, c), Nat::lt(c, 57344)): Text {
    true => Text::Mk(Nil)
    false => text_utf8_past_surrogates(c)
  }
}

// From 128 on: two bytes below 2048.
pub fn text_utf8_from_128(c: Nat): Text {
  match Nat::lt(c, 2048): Text {
    true => Text::Mk(Cons(Nat::add(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 192), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil)))
    false => text_utf8_from_2048(c)
  }
}

// The last digit in base 64 and the digits before it make `n` again, when
// `m` is the digits before it.
pub theorem utf8_digits(
  n: Nat,
  m: Nat,
  e: Nat::div_nz(n, 64, Nat::ne_zero(64, Refl)) = m
): Nat::add(Nat::mul(64, m), Nat::rem_nz(n, 64, Nat::ne_zero(64, Refl))) = n {
  Eq::subst(
    (z: Nat) => Nat::add(Nat::mul(64, z), Nat::rem_nz(n, 64, Nat::ne_zero(64, Refl))) = n,
    e,
    Eq::trans(
      Eq::congr((z: Nat) => Nat::add(z, Nat::rem_nz(n, 64, Nat::ne_zero(64, Refl))), Nat::mul_comm(64, Nat::div_nz(n, 64, Nat::ne_zero(64, Refl)))),
      nat_div_mod_r(n, 64, Refl)
    )
  )
}

pub theorem utf8_div_64_64(c: Nat): Nat::div_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)) = Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)) {
  nat_div_div(c, 64, 64, Refl, Refl, Refl)
}

pub theorem utf8_div_4096_64(c: Nat): Nat::div_nz(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 64, Nat::ne_zero(64, Refl)) = Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)) {
  nat_div_div(c, 4096, 64, Refl, Refl, Refl)
}

// ---- one length at a time ---------------------------------------------------

pub theorem utf8_round_1(
  c: Nat,
  h: Nat::lt(c, 128) = true
): utf8_round(Text::Mk(Cons(c, Nil)), c) {
  bool_rewrite(
    (z: Bool) => (match z: Option(@code Nat × @len Nat) {
        true => Some(#(@code c, @len 1))
        false => text_decode_from_128(Text::Mk(Cons(c, Nil)), 0, c)
      }) = Some(#(@code c, @len 1)),
    true,
    Nat::lt(c, 128),
    Eq::sym(h),
    Refl
  )
}

pub theorem utf8_round_2(
  c: Nat,
  h: Nat::lt(c, 2048) = true
): utf8_round(Text::Mk(Cons(Nat::add(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 192), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))), c) {
  bool_rewrite(
    (z: Bool) => (match z: Option(@code Nat × @len Nat) {
        true => None
        false => text_decode_from_192(
          Text::Mk(Cons(Nat::add(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 192), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))),
          0,
          Nat::add(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 192)
        )
      }) = Some(#(@code c, @len 2)),
    false,
    Nat::lt(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 0),
    Eq::sym(nat_lt_zero_right(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)))),
    bool_rewrite(
      (z: Bool) => (match z: Option(@code Nat × @len Nat) {
          true => text_decode_with(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 2, Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 0, 0)
          false => text_decode_from_224(
            Text::Mk(Cons(Nat::add(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 192), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))),
            0,
            Nat::add(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 192)
          )
        }) = Some(#(@code c, @len 2)),
      true,
      Nat::lt(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 32),
      Eq::sym(nat_div_lt(c, 64, 32, Refl, h)),
      Eq::congr((z: Nat) => Some(#(@code z, @len 2)), utf8_digits(c, Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), Refl))
    )
  )
}

pub theorem utf8_round_3(
  c: Nat,
  h: Nat::lt(c, 65536) = true
): utf8_round(
  Text::Mk(
    Cons(
      Nat::add(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 224),
      Cons(Nat::add(Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)), 128), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))
    )
  ),
  c
) {
  bool_rewrite(
    (z: Bool) => (match z: Option(@code Nat × @len Nat) {
        true => text_decode_with(
          Nat::sub(Nat::add(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 224), 192),
          2,
          Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)),
          0,
          0
        )
        false => text_decode_from_224(
          Text::Mk(
            Cons(
              Nat::add(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 224),
              Cons(Nat::add(Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)), 128), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))
            )
          ),
          0,
          Nat::add(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 224)
        )
      }) = Some(#(@code c, @len 3)),
    false,
    Nat::lt(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 0),
    Eq::sym(nat_lt_zero_right(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)))),
    bool_rewrite(
      (z: Bool) => (match z: Option(@code Nat × @len Nat) {
          true => text_decode_with(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 3, Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)), Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 0)
          false => text_decode_with(
            Nat::sub(Nat::add(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 224), 240),
            4,
            Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)),
            Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)),
            0
          )
        }) = Some(#(@code c, @len 3)),
      true,
      Nat::lt(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 16),
      Eq::sym(nat_div_lt(c, 4096, 16, Refl, h)),
      Eq::congr(
        (z: Nat) => Some(#(@code z, @len 3)),
        Eq::trans(
          Eq::congr(
            (z: Nat) => Nat::add(Nat::mul(64, z), Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl))),
            utf8_digits(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), utf8_div_64_64(c))
          ),
          utf8_digits(c, Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), Refl)
        )
      )
    )
  )
}

pub theorem utf8_round_4(
  c: Nat
): utf8_round(
  Text::Mk(
    Cons(
      Nat::add(Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)), 240),
      Cons(
        Nat::add(Nat::rem_nz(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 64, Nat::ne_zero(64, Refl)), 128),
        Cons(Nat::add(Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)), 128), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))
      )
    )
  ),
  c
) {
  bool_rewrite(
    (z: Bool) => (match z: Option(@code Nat × @len Nat) {
        true => text_decode_with(
          Nat::sub(Nat::add(Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)), 240), 224),
          3,
          Nat::rem_nz(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 64, Nat::ne_zero(64, Refl)),
          Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)),
          0
        )
        false => text_decode_with(
          Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)),
          4,
          Nat::rem_nz(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 64, Nat::ne_zero(64, Refl)),
          Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)),
          Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl))
        )
      }) = Some(#(@code c, @len 4)),
    false,
    Nat::lt(Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)), 0),
    Eq::sym(nat_lt_zero_right(Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)))),
    Eq::congr(
      (z: Nat) => Some(#(@code z, @len 4)),
      Eq::trans(
        Eq::congr(
          (z: Nat) => Nat::add(Nat::mul(64, Nat::add(Nat::mul(64, z), Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)))), Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl))),
          utf8_digits(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)), utf8_div_4096_64(c))
        ),
        Eq::trans(
          Eq::congr(
            (z: Nat) => Nat::add(Nat::mul(64, z), Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl))),
            utf8_digits(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), utf8_div_64_64(c))
          ),
          utf8_digits(c, Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), Refl)
        )
      )
    )
  )
}

// ---- the encoder's steps ----------------------------------------------------

pub theorem utf8_round_from_65536(
  c: Nat,
  hmax: Nat::lt(c, 1114112) = true
): utf8_round(text_utf8_from_65536(c), c) {
  bool_rewrite(
    (z: Bool) => utf8_round(
      match z: Text {
        true => Text::Mk(
          Cons(
            Nat::add(Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)), 240),
            Cons(
              Nat::add(Nat::rem_nz(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 64, Nat::ne_zero(64, Refl)), 128),
              Cons(Nat::add(Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)), 128), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))
            )
          )
        )
        false => Text::Mk(Nil)
      },
      c
    ),
    true,
    Nat::lt(c, 1114112),
    Eq::sym(hmax),
    utf8_round_4(c)
  )
}

pub theorem utf8_round_past_surrogates(
  c: Nat,
  hmax: Nat::lt(c, 1114112) = true
): utf8_round(text_utf8_past_surrogates(c), c) {
  Bool::cases(
    (z: Bool) => utf8_round(
      match z: Text {
        true => Text::Mk(
          Cons(
            Nat::add(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 224),
            Cons(Nat::add(Nat::rem_nz(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 64, Nat::ne_zero(64, Refl)), 128), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil))
          )
        )
        false => text_utf8_from_65536(c)
      },
      c
    ),
    Nat::lt(c, 65536),
    (hn: Nat::lt(c, 65536) = false) => utf8_round_from_65536(c, hmax),
    (hy: Nat::lt(c, 65536) = true) => utf8_round_3(c, hy)
  )
}

pub theorem utf8_round_from_2048(
  c: Nat,
  hmax: Nat::lt(c, 1114112) = true,
  hs: Bool::and(Nat::le(55296, c), Nat::lt(c, 57344)) = false
): utf8_round(text_utf8_from_2048(c), c) {
  bool_rewrite(
    (z: Bool) => utf8_round(
      match z: Text {
        true => Text::Mk(Nil)
        false => text_utf8_past_surrogates(c)
      },
      c
    ),
    false,
    Bool::and(Nat::le(55296, c), Nat::lt(c, 57344)),
    Eq::sym(hs),
    utf8_round_past_surrogates(c, hmax)
  )
}

pub theorem utf8_round_from_128(
  c: Nat,
  hmax: Nat::lt(c, 1114112) = true,
  hs: Bool::and(Nat::le(55296, c), Nat::lt(c, 57344)) = false
): utf8_round(text_utf8_from_128(c), c) {
  Bool::cases(
    (z: Bool) => utf8_round(
      match z: Text {
        true => Text::Mk(Cons(Nat::add(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 192), Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil)))
        false => text_utf8_from_2048(c)
      },
      c
    ),
    Nat::lt(c, 2048),
    (hn: Nat::lt(c, 2048) = false) => utf8_round_from_2048(c, hmax, hs),
    (hy: Nat::lt(c, 2048) = true) => utf8_round_2(c, hy)
  )
}

pub theorem bool_and_left(a: Bool, b: Bool, h: Bool::and(a, b) = true): a = true {
  match a: a = true {
    false => False::elim(false_ne_true(h))
    true => Refl
  }
}

pub theorem bool_and_right(a: Bool, b: Bool, h: Bool::and(a, b) = true): b = true {
  match a: b = true {
    false => False::elim(false_ne_true(h))
    true => h
  }
}

pub theorem bool_not_true(a: Bool, h: not(a) = true): a = false {
  match a: a = false {
    false => Refl
    true => False::elim(false_ne_true(h))
  }
}

// ---- the theorem ------------------------------------------------------------

// Every character's encoding decodes to it, and is read whole.
pub theorem text_decode_of_code_point(
  c: Nat,
  h: text_is_char(c) = true
): text_decode(Text::utf8_of_code_point(c), 0) = Some(#(@code c, @len Text::len(Text::utf8_of_code_point(c)))) {
  Bool::cases(
    (z: Bool) => utf8_round(
      match z: Text {
        true => Text::Mk(Cons(c, Nil))
        false => text_utf8_from_128(c)
      },
      c
    ),
    Nat::lt(c, 128),
    (hn: Nat::lt(c, 128) = false) => utf8_round_from_128(
      c,
      bool_and_left(Nat::lt(c, 1114112), not(Bool::and(Nat::le(55296, c), Nat::lt(c, 57344))), h),
      bool_not_true(
        Bool::and(Nat::le(55296, c), Nat::lt(c, 57344)),
        bool_and_right(Nat::lt(c, 1114112), not(Bool::and(Nat::le(55296, c), Nat::lt(c, 57344))), h)
      )
    ),
    (hy: Nat::lt(c, 128) = true) => utf8_round_1(c, hy)
  )
}

pub theorem utf8_round_example(): text_decode(Text::utf8_of_code_point(233), 0) = Some(#(@code 233, @len 2)) {
  text_decode_of_code_point(233, Refl)
}
