import std::Nat
import std::Base

// The arithmetic the UTF-8 proofs (`utf8.taut`) stand on: the laws of
// `Nat::add` and `Nat::mul` beyond those of `std/Nat.taut`, an order with a witness (`NatLe`), and what
// `Nat::div_nz` and `Nat::rem_nz` are: the one quotient and remainder, and a
// quotient of a quotient is a quotient by the product.
//
// This file is not part of the tote's program: `tauto check` checks it.

// `Eq::subst` for a property of a `Bool` that matches on it.
pub theorem bool_rewrite(P: (Bool) -> Prop, a: Bool, b: Bool, e: a = b, h: P(a)): P(b) {
  Eq::subst(P, e, h)
}

pub theorem nat_add_right_swap(
  a: Nat,
  b: Nat,
  c: Nat
): Nat::add(Nat::add(a, b), c) = Nat::add(Nat::add(a, c), b) {
  Eq::trans(
    Nat::add_assoc(a, b, c),
    Eq::trans(
      Eq::congr((z: Nat) => Nat::add(a, z), Nat::add_comm(b, c)),
      Eq::sym(Nat::add_assoc(a, c, b))
    )
  )
}

pub theorem nat_add_swap4(
  a: Nat,
  b: Nat,
  c: Nat,
  d: Nat
): Nat::add(Nat::add(a, b), Nat::add(c, d)) = Nat::add(Nat::add(a, c), Nat::add(b, d)) {
  Eq::trans(
    Eq::sym(Nat::add_assoc(Nat::add(a, b), c, d)),
    Eq::trans(
      Eq::congr((z: Nat) => Nat::add(z, d), nat_add_right_swap(a, b, c)),
      Nat::add_assoc(Nat::add(a, c), b, d)
    )
  )
}

pub theorem nat_mul_distr(
  a: Nat,
  b: Nat,
  c: Nat
): Nat::mul(a, Nat::add(b, c)) = Nat::add(Nat::mul(a, b), Nat::mul(a, c)) {
  Nat::mul_add_distrib(a, b, c)
}

// `a` is at most `b` when `b = a + d` for some natural number `d`.
pub(open) inductive NatLe(a: Nat, b: Nat): Prop {
  NatLeBy(d: Nat, e: b = Nat::add(a, d)): NatLe(a, b)
}

pub theorem natle_refl(a: Nat): NatLe(a, a) {
  NatLeBy(0, Refl)
}

pub theorem natle_trans(a: Nat, b: Nat, c: Nat, h1: NatLe(a, b), h2: NatLe(b, c)): NatLe(a, c) {
  ⊢ NatLe(a, c) from match h1 {
    NatLeBy(d1, e1) => ⊢ NatLe(a, c) from match h2 {
      NatLeBy(d2, e2) => NatLeBy(
        Nat::add(d1, d2),
        Eq::trans(
          e2,
          Eq::trans(Eq::congr((z: Nat) => Nat::add(z, d2), e1), Nat::add_assoc(a, d1, d2))
        )
      )
    }
  }
}

pub theorem nat_le_add_left(a: Nat, d: Nat): NatLe(a, Nat::add(d, a)) {
  NatLeBy(d, Nat::add_comm(d, a))
}

pub theorem nat_le_add_mono(
  a: Nat,
  b: Nat,
  c: Nat,
  d: Nat,
  h1: NatLe(a, b),
  h2: NatLe(c, d)
): NatLe(Nat::add(a, c), Nat::add(b, d)) {
  ⊢ NatLe(Nat::add(a, c), Nat::add(b, d)) from match h1 {
    NatLeBy(x, e1) => ⊢ NatLe(Nat::add(a, c), Nat::add(b, d)) from match h2 {
      NatLeBy(y, e2) => NatLeBy(
        Nat::add(x, y),
        Eq::trans(
          Eq::trans(
            Eq::congr((z: Nat) => Nat::add(z, d), e1),
            Eq::congr((z: Nat) => Nat::add(Nat::add(a, x), z), e2)
          ),
          nat_add_swap4(a, x, c, y)
        )
      )
    }
  }
}

pub theorem nat_le_mul_mono(
  b: Nat,
  x: Nat,
  y: Nat,
  h: NatLe(x, y)
): NatLe(Nat::mul(b, x), Nat::mul(b, y)) {
  ⊢ NatLe(Nat::mul(b, x), Nat::mul(b, y)) from match h {
    NatLeBy(d, e) => NatLeBy(
      Nat::mul(b, d),
      Eq::trans(Eq::congr((z: Nat) => Nat::mul(b, z), e), nat_mul_distr(b, x, d))
    )
  }
}

pub theorem nat_lt_zero_right(n: Nat): Nat::lt(n, 0) = false {
  ⊢ Nat::lt(n, 0) = false from match n {
    Zero => Refl
    Succ(k) => Refl
  }
}

pub theorem nat_le_of_lt_step(a: Nat, b: Nat, h: NatLe(Succ(a), b)): NatLe(Succ(Succ(a)), Succ(b)) {
  ⊢ NatLe(Succ(Succ(a)), Succ(b)) from match h {
    NatLeBy(d, e) => NatLeBy(
      d,
      Eq::trans(Eq::congr(Succ, e), Eq::sym(Nat::add_succ_left(Succ(a), d)))
    )
  }
}

pub theorem nat_le_of_lt(a: Nat, b: Nat, h: Nat::lt(a, b) = true): NatLe(Succ(a), b) {
  ⊢ NatLe(Succ(a), b) from match a {
    Zero => ⊢ NatLe(Succ(Zero), b) from match b {
      Zero => False::elim(false_ne_true(h))
      Succ(b2) => NatLeBy(
        b2,
        Eq::sym(Eq::trans(Nat::add_succ_left(Zero, b2), Eq::congr(Succ, Nat::add_zero_left(b2))))
      )
    }
    Succ(a2) => ⊢ NatLe(Succ(Succ(a2)), b) from match b {
      Zero => False::elim(false_ne_true(h))
      Succ(b2) => nat_le_of_lt_step(a2, b2, nat_le_of_lt(a2, b2, h))
    }
  }
}

pub theorem nat_lt_add_succ(a: Nat, d: Nat): Nat::lt(a, Nat::add(Succ(a), d)) = true {
  ⊢ Nat::lt(a, Nat::add(Succ(a), d)) = true from match a {
    Zero => Eq::subst(
      (z: Nat) => Nat::lt(Zero, z) = true,
      Eq::sym(Nat::add_succ_left(Zero, d)),
      Refl
    )
    Succ(a2) => Eq::subst(
      (z: Nat) => Nat::lt(Succ(a2), z) = true,
      Eq::sym(Nat::add_succ_left(Succ(a2), d)),
      nat_lt_add_succ(a2, d)
    )
  }
}

pub theorem nat_lt_of_le(a: Nat, b: Nat, h: NatLe(Succ(a), b)): Nat::lt(a, b) = true {
  ⊢ Nat::lt(a, b) = true from match h {
    NatLeBy(d, e) => Eq::subst((z: Nat) => Nat::lt(a, z) = true, Eq::sym(e), nat_lt_add_succ(a, d))
  }
}

pub theorem nat_lt_add_no(a: Nat, d: Nat): Nat::lt(Nat::add(a, d), a) = false {
  ⊢ Nat::lt(Nat::add(a, d), a) = false from match a {
    Zero => nat_lt_zero_right(Nat::add(Zero, d))
    Succ(a2) => Eq::subst(
      (z: Nat) => Nat::lt(z, Succ(a2)) = false,
      Eq::sym(Nat::add_succ_left(a2, d)),
      nat_lt_add_no(a2, d)
    )
  }
}

pub theorem nat_le_not_lt(a: Nat, b: Nat, h: NatLe(a, b)): Nat::lt(b, a) = false {
  ⊢ Nat::lt(b, a) = false from match h {
    NatLeBy(d, e) => Eq::subst((z: Nat) => Nat::lt(z, a) = false, Eq::sym(e), nat_lt_add_no(a, d))
  }
}

pub theorem nat_not_lt_le_step(b: Nat, a: Nat, h: NatLe(b, a)): NatLe(Succ(b), Succ(a)) {
  ⊢ NatLe(Succ(b), Succ(a)) from match h {
    NatLeBy(d, e) => NatLeBy(d, Eq::trans(Eq::congr(Succ, e), Eq::sym(Nat::add_succ_left(b, d))))
  }
}

pub theorem nat_not_lt_le(a: Nat, b: Nat, h: Nat::lt(a, b) = false): NatLe(b, a) {
  ⊢ NatLe(b, a) from match a {
    Zero => ⊢ NatLe(b, Zero) from match b {
      Zero => natle_refl(Zero)
      Succ(b2) => False::elim(true_ne_false(h))
    }
    Succ(a2) => ⊢ NatLe(b, Succ(a2)) from match b {
      Zero => NatLeBy(Succ(a2), Eq::sym(Nat::add_zero_left(Succ(a2))))
      Succ(b2) => nat_not_lt_le_step(b2, a2, nat_not_lt_le(a2, b2, h))
    }
  }
}

pub theorem nat_lt_ne(x: Nat, b: Nat, h: Nat::lt(x, b) = true): Nat::eq(x, b) = false {
  ⊢ Nat::eq(x, b) = false from match x {
    Zero => ⊢ Nat::eq(Zero, b) = false from match b {
      Zero => False::elim(false_ne_true(h))
      Succ(b2) => Refl
    }
    Succ(x2) => ⊢ Nat::eq(Succ(x2), b) = false from match b {
      Zero => Refl
      Succ(b2) => nat_lt_ne(x2, b2, h)
    }
  }
}

pub theorem nat_lt_succ_of_ne(
  r: Nat,
  b: Nat,
  h: Nat::lt(r, b) = true,
  hn: Nat::eq(Succ(r), b) = false
): Nat::lt(Succ(r), b) = true {
  ⊢ Nat::lt(Succ(r), b) = true from match r {
    Zero => ⊢ Nat::lt(Succ(Zero), b) = true from match b {
      Zero => False::elim(false_ne_true(h))
      Succ(b2) => ⊢ Nat::lt(Succ(Zero), Succ(b2)) = true from match b2 {
        Zero => False::elim(true_ne_false(hn))
        Succ(b3) => Refl
      }
    }
    Succ(r2) => ⊢ Nat::lt(Succ(Succ(r2)), b) = true from match b {
      Zero => False::elim(false_ne_true(h))
      Succ(b2) => nat_lt_succ_of_ne(r2, b2, h, hn)
    }
  }
}

pub theorem nat_lt_add_weaken(
  a: Nat,
  c: Nat,
  b: Nat,
  h: Nat::lt(Nat::add(a, c), b) = true
): Nat::lt(a, b) = true {
  nat_lt_of_le(
    a,
    b,
    natle_trans(
      Succ(a),
      Succ(Nat::add(a, c)),
      b,
      NatLeBy(c, Eq::sym(Nat::add_succ_left(a, c))),
      nat_le_of_lt(Nat::add(a, c), b, h)
    )
  )
}

pub theorem nat_eq_add_succ(x: Nat, d: Nat): Nat::eq(x, Nat::add(x, Succ(d))) = false {
  ⊢ Nat::eq(x, Nat::add(x, Succ(d))) = false from match x {
    Zero => Refl
    Succ(x2) => Eq::subst(
      (z: Nat) => Nat::eq(x2, z) = false,
      Eq::sym(Nat::add_succ_left(x2, d)),
      nat_eq_add_succ(x2, d)
    )
  }
}

pub fn nat_pair_fst(p: Pair(Nat, Nat)): Nat {
  ⊢ Nat from match p {
    Pair { fst: q, snd: r } => q
  }
}

pub fn nat_pair_snd(p: Pair(Nat, Nat)): Nat {
  ⊢ Nat from match p {
    Pair { fst: q, snd: r } => r
  }
}

// `p` is a quotient and remainder of `n` by `b`.
pub fn nat_qr_ok(p: Pair(Nat, Nat), b: Nat, n: Nat): Prop {
  ⊢ Prop from match p {
    Pair { fst: q, snd: r } => And(Nat::add(r, Nat::mul(b, q)) = n, Nat::lt(r, b) = true)
  }
}

pub theorem nat_qr_ok_eq(
  p: Pair(Nat, Nat),
  b: Nat,
  n: Nat,
  h: nat_qr_ok(p, b, n)
): Nat::add(nat_pair_snd(p), Nat::mul(b, nat_pair_fst(p))) = n {
  ⊢ Nat::add(nat_pair_snd(p), Nat::mul(b, nat_pair_fst(p))) = n from match p {
    Pair { fst: q, snd: r } => And::left(h)
  }
}

pub theorem nat_qr_ok_lt(
  p: Pair(Nat, Nat),
  b: Nat,
  n: Nat,
  h: nat_qr_ok(p, b, n)
): Nat::lt(nat_pair_snd(p), b) = true {
  ⊢ Nat::lt(nat_pair_snd(p), b) = true from match p {
    Pair { fst: q, snd: r } => And::right(h)
  }
}

// The remainder reaches `b`: one more in the quotient.
pub theorem nat_divmod_ok_carry(
  a2: Nat,
  b: Nat,
  q: Nat,
  r: Nat,
  eb: Succ(r) = b,
  ih: nat_qr_ok(
    Nat::divmod(a2, b, Succ(q), Zero),
    b,
    Nat::add(a2, Nat::add(Zero, Nat::mul(b, Succ(q))))
  )
): nat_qr_ok(Nat::divmod(a2, b, Succ(q), Zero), b, Nat::add(Succ(a2), Nat::add(r, Nat::mul(b, q)))) {
  Eq::subst(
    (z: Nat) => nat_qr_ok(Nat::divmod(a2, b, Succ(q), Zero), b, z),
    Eq::trans(
      Eq::congr(
        (z: Nat) => Nat::add(a2, z),
        Eq::trans(
          Eq::trans(Nat::add_zero_left(Nat::mul(b, Succ(q))), Nat::mul_succ_right(b, q)),
          Eq::trans(
            Eq::congr((z: Nat) => Nat::add(Nat::mul(b, q), z), Eq::sym(eb)),
            Eq::congr(Succ, Nat::add_comm(Nat::mul(b, q), r))
          )
        )
      ),
      Eq::sym(Nat::add_succ_left(a2, Nat::add(r, Nat::mul(b, q))))
    ),
    ih
  )
}

// One more step of the running quotient `q` and remainder `r` keeps
// `n` = `r` + `b` * `q`.
pub theorem nat_divmod_ok(
  a: Nat,
  b: Nat,
  q: Nat,
  r: Nat,
  h: Nat::lt(r, b) = true
): nat_qr_ok(Nat::divmod(a, b, q, r), b, Nat::add(a, Nat::add(r, Nat::mul(b, q)))) {
  ⊢ nat_qr_ok(Nat::divmod(a, b, q, r), b, Nat::add(a, Nat::add(r, Nat::mul(b, q)))) from match a {
    Zero => AndIntro(Eq::sym(Nat::add_zero_left(Nat::add(r, Nat::mul(b, q)))), h)
    Succ(a2) => Bool::cases(
      (p: Bool) => nat_qr_ok(
        ⊢ Pair(Nat, Nat) from match p {
          false => Nat::divmod(a2, b, q, Succ(r))
          true => Nat::divmod(a2, b, Succ(q), Zero)
        },
        b,
        Nat::add(Succ(a2), Nat::add(r, Nat::mul(b, q)))
      ),
      Nat::eq(Succ(r), b),
      (hn: Nat::eq(Succ(r), b) = false) => Eq::subst(
        (z: Nat) => nat_qr_ok(Nat::divmod(a2, b, q, Succ(r)), b, z),
        Eq::trans(
          Eq::congr((z: Nat) => Nat::add(a2, z), Nat::add_succ_left(r, Nat::mul(b, q))),
          Eq::sym(Nat::add_succ_left(a2, Nat::add(r, Nat::mul(b, q))))
        ),
        nat_divmod_ok(a2, b, q, Succ(r), nat_lt_succ_of_ne(r, b, h, hn))
      ),
      (hy: Nat::eq(Succ(r), b) = true) => nat_divmod_ok_carry(
        a2,
        b,
        q,
        r,
        Nat::eq_sound(Succ(r), b, hy),
        nat_divmod_ok(
          a2,
          b,
          Succ(q),
          Zero,
          Eq::subst((z: Nat) => Nat::lt(Zero, z) = true, Nat::eq_sound(Succ(r), b, hy), Refl)
        )
      )
    )
  }
}

// The running sum of a division from zero is the dividend.
pub theorem nat_divmod_start(a: Nat, b: Nat): Nat::add(a, Nat::add(0, Nat::mul(b, 0))) = a {
  Eq::congr((z: Nat) => Nat::add(a, z), Nat::mul_zero_right(b))
}

pub theorem nat_div_mod(
  a: Nat,
  b: Nat,
  hb: Nat::lt(0, b) = true
): Nat::add(
  Nat::rem_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
  Nat::mul(b, Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)))
) = a {
  nat_qr_ok_eq(
    Nat::divmod(a, b, 0, 0),
    b,
    a,
    Eq::subst(
      (z: Nat) => nat_qr_ok(Nat::divmod(a, b, 0, 0), b, z),
      nat_divmod_start(a, b),
      nat_divmod_ok(a, b, 0, 0, hb)
    )
  )
}

// `n` = `div` * `b` + `mod`, the other way round.
pub theorem nat_div_mod_r(
  n: Nat,
  b: Nat,
  hb: Nat::lt(0, b) = true
): Nat::add(
  Nat::mul(Nat::div_nz(n, b, Nat::ne_zero_of_pos(b, hb)), b),
  Nat::rem_nz(n, b, Nat::ne_zero_of_pos(b, hb))
) = n {
  Eq::trans(
    Eq::congr(
      (z: Nat) => Nat::add(z, Nat::rem_nz(n, b, Nat::ne_zero_of_pos(b, hb))),
      Nat::mul_comm(Nat::div_nz(n, b, Nat::ne_zero_of_pos(b, hb)), b)
    ),
    Eq::trans(
      Nat::add_comm(
        Nat::mul(b, Nat::div_nz(n, b, Nat::ne_zero_of_pos(b, hb))),
        Nat::rem_nz(n, b, Nat::ne_zero_of_pos(b, hb))
      ),
      nat_div_mod(n, b, hb)
    )
  )
}

pub fn nat_divmod_then(p: Pair(Nat, Nat), x: Nat, b: Nat): Pair(Nat, Nat) {
  ⊢ Pair(Nat, Nat) from match p {
    Pair { fst: q, snd: r } => Nat::divmod(x, b, q, r)
  }
}

// Dividing `x + y` takes the `y` steps, then the `x` steps.
pub theorem nat_divmod_add(
  x: Nat,
  y: Nat,
  b: Nat,
  q: Nat,
  r: Nat
): Nat::divmod(Nat::add(x, y), b, q, r) = nat_divmod_then(Nat::divmod(y, b, q, r), x, b) {
  ⊢ Nat::divmod(Nat::add(x, y), b, q, r) = nat_divmod_then(Nat::divmod(y, b, q, r), x, b) from match y {
    Zero => Refl
    Succ(y2) => Bool::cases(
      (p: Bool) => (⊢ Pair(Nat, Nat) from match p {
          false => Nat::divmod(Nat::add(x, y2), b, q, Succ(r))
          true => Nat::divmod(Nat::add(x, y2), b, Succ(q), Zero)
        }) = nat_divmod_then(
          ⊢ Pair(Nat, Nat) from match p {
            false => Nat::divmod(y2, b, q, Succ(r))
            true => Nat::divmod(y2, b, Succ(q), Zero)
          },
          x,
          b
        ),
      Nat::eq(Succ(r), b),
      (hn: Nat::eq(Succ(r), b) = false) => nat_divmod_add(x, y2, b, q, Succ(r)),
      (hy: Nat::eq(Succ(r), b) = true) => nat_divmod_add(x, y2, b, Succ(q), Zero)
    )
  }
}

pub theorem nat_divmod_small_step(
  k2: Nat,
  b: Nat,
  q: Nat,
  r: Nat,
  h: Nat::lt(Nat::add(Succ(r), k2), b) = true,
  ih: Nat::divmod(k2, b, q, Succ(r)) = (Pair { fst: q, snd: Nat::add(Succ(r), k2) })
): Nat::divmod(Succ(k2), b, q, r) = (Pair { fst: q, snd: Succ(Nat::add(r, k2)) }) {
  bool_rewrite(
    (z: Bool) => (⊢ Pair(Nat, Nat) from match z {
        false => Nat::divmod(k2, b, q, Succ(r))
        true => Nat::divmod(k2, b, Succ(q), Zero)
      }) = Pair { fst: q, snd: Succ(Nat::add(r, k2)) },
    false,
    Nat::eq(Succ(r), b),
    Eq::sym(nat_lt_ne(Succ(r), b, nat_lt_add_weaken(Succ(r), k2, b, h))),
    Eq::trans(
      ih,
      Eq::congr((z: Nat) => Pair { fst: q, snd: z }, Nat::add_succ_left(r, k2))
    )
  )
}

// Steps that leave the remainder below `b` only add to it.
pub theorem nat_divmod_small(
  k: Nat,
  b: Nat,
  q: Nat,
  r: Nat,
  h: Nat::lt(Nat::add(r, k), b) = true
): Nat::divmod(k, b, q, r) = (Pair { fst: q, snd: Nat::add(r, k) }) {
  ⊢ Nat::divmod(k, b, q, r) = (Pair { fst: q, snd: Nat::add(r, k) }) from match k {
    Zero => Refl
    Succ(k2) => nat_divmod_small_step(
      k2,
      b,
      q,
      r,
      Eq::subst((z: Nat) => Nat::lt(z, b) = true, Eq::sym(Nat::add_succ_left(r, k2)), h),
      nat_divmod_small(
        k2,
        b,
        q,
        Succ(r),
        Eq::subst((z: Nat) => Nat::lt(z, b) = true, Eq::sym(Nat::add_succ_left(r, k2)), h)
      )
    )
  }
}

pub theorem nat_divmod_full_step(
  k2: Nat,
  b: Nat,
  q: Nat,
  r: Nat,
  e: Nat::add(Succ(r), Succ(k2)) = b,
  ih: Nat::divmod(Succ(k2), b, q, Succ(r)) = (Pair { fst: Succ(q), snd: Zero })
): Nat::divmod(Succ(Succ(k2)), b, q, r) = (Pair { fst: Succ(q), snd: Zero }) {
  bool_rewrite(
    (z: Bool) => (⊢ Pair(Nat, Nat) from match z {
        false => Nat::divmod(Succ(k2), b, q, Succ(r))
        true => Nat::divmod(Succ(k2), b, Succ(q), Zero)
      }) = Pair { fst: Succ(q), snd: Zero },
    false,
    Nat::eq(Succ(r), b),
    Eq::sym(Eq::subst((z: Nat) => Nat::eq(Succ(r), z) = false, e, nat_eq_add_succ(Succ(r), k2))),
    ih
  )
}

// Steps that bring the remainder to `b`: one more in the quotient.
pub theorem nat_divmod_full(
  k: Nat,
  b: Nat,
  q: Nat,
  r: Nat,
  e: Nat::add(r, Succ(k)) = b
): Nat::divmod(Succ(k), b, q, r) = (Pair { fst: Succ(q), snd: Zero }) {
  ⊢ Nat::divmod(Succ(k), b, q, r) = (Pair { fst: Succ(q), snd: Zero }) from match k {
    Zero => bool_rewrite(
      (z: Bool) => (⊢ Pair(Nat, Nat) from match z {
          false => Nat::divmod(Zero, b, q, Succ(r))
          true => Nat::divmod(Zero, b, Succ(q), Zero)
        }) = Pair { fst: Succ(q), snd: Zero },
      true,
      Nat::eq(Succ(r), b),
      Eq::sym(Eq::subst((z: Nat) => Nat::eq(Succ(r), z) = true, e, Nat::eq_refl(Succ(r)))),
      Refl
    )
    Succ(k2) => nat_divmod_full_step(
      k2,
      b,
      q,
      r,
      Eq::trans(Eq::congr(Succ, Nat::add_succ_left(r, k2)), e),
      nat_divmod_full(k2, b, q, Succ(r), Eq::trans(Eq::congr(Succ, Nat::add_succ_left(r, k2)), e))
    )
  }
}

// `Nat::divmod` of `b` * `k` by `b` (`b` = `Succ(b2)`), from the quotient `q`,
// gives the quotient `q + k` and nothing remains.
pub theorem nat_divmod_mul(
  k: Nat,
  b2: Nat,
  q: Nat
): Nat::divmod(
  Nat::mul(Succ(b2), k),
  Succ(b2),
  q,
  Zero
) = (Pair { fst: Nat::add(q, k), snd: Zero }) {
  ⊢ Nat::divmod(
    Nat::mul(Succ(b2), k),
    Succ(b2),
    q,
    Zero
  ) = (Pair { fst: Nat::add(q, k), snd: Zero }) from match k {
    Zero => Eq::subst(
      (z: Nat) => Nat::divmod(z, Succ(b2), q, Zero) = (Pair { fst: Nat::add(q, Zero), snd: Zero }),
      Eq::sym(Nat::mul_zero_right(Succ(b2))),
      Refl
    )
    Succ(k2) => Eq::trans(
      Eq::congr((z: Nat) => Nat::divmod(z, Succ(b2), q, Zero), Nat::mul_succ_right(Succ(b2), k2)),
      Eq::trans(
        nat_divmod_add(Nat::mul(Succ(b2), k2), Succ(b2), Succ(b2), q, Zero),
        Eq::trans(
          Eq::congr(
            (p: Pair(Nat, Nat)) => nat_divmod_then(p, Nat::mul(Succ(b2), k2), Succ(b2)),
            nat_divmod_full(b2, Succ(b2), q, Zero, Nat::add_zero_left(Succ(b2)))
          ),
          Eq::trans(
            nat_divmod_mul(k2, b2, Succ(q)),
            Eq::congr((z: Nat) => Pair { fst: z, snd: Zero }, Nat::add_succ_left(q, k2))
          )
        )
      )
    )
  }
}

pub theorem nat_divmod_unique(
  q: Nat,
  r: Nat,
  b2: Nat,
  h: Nat::lt(r, Succ(b2)) = true
): Nat::divmod(Nat::add(r, Nat::mul(Succ(b2), q)), Succ(b2), 0, 0) = (Pair { fst: q, snd: r }) {
  Eq::trans(
    nat_divmod_add(r, Nat::mul(Succ(b2), q), Succ(b2), 0, 0),
    Eq::trans(
      Eq::congr((p: Pair(Nat, Nat)) => nat_divmod_then(p, r, Succ(b2)), nat_divmod_mul(q, b2, 0)),
      Eq::trans(
        nat_divmod_small(
          r,
          Succ(b2),
          Nat::add(0, q),
          0,
          Eq::subst((z: Nat) => Nat::lt(z, Succ(b2)) = true, Eq::sym(Nat::add_zero_left(r)), h)
        ),
        Eq::trans(
          Eq::congr((z: Nat) => Pair { fst: z, snd: Nat::add(0, r) }, Nat::add_zero_left(q)),
          Eq::congr((z: Nat) => Pair { fst: q, snd: z }, Nat::add_zero_left(r))
        )
      )
    )
  )
}

// The quotient is the one `q` with `a` = `r` + `b` * `q` and `r` < `b`.
pub theorem nat_div_unique(
  a: Nat,
  b: Nat,
  q: Nat,
  r: Nat,
  e: a = Nat::add(r, Nat::mul(b, q)),
  h: Nat::lt(r, b) = true,
  hb: ¬(b = 0)
): Nat::div_nz(a, b, hb) = q {
  ⊢ Nat::div_nz(a, b, hb) = q from match b {
    Zero => False::elim(false_ne_true(Eq::trans(Eq::sym(nat_lt_zero_right(r)), h)))
    Succ(b2) => Eq::congr(
      nat_pair_fst,
      Eq::trans(
        Eq::congr((z: Nat) => Nat::divmod(z, Succ(b2), 0, 0), e),
        nat_divmod_unique(q, r, b2, h)
      )
    )
  }
}

// Below `b` * `k`, the quotient by `b` is below `k`.
pub theorem nat_div_lt(
  a: Nat,
  b: Nat,
  k: Nat,
  hb: Nat::lt(0, b) = true,
  h: Nat::lt(a, Nat::mul(b, k)) = true
): Nat::lt(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k) = true {
  Bool::cases(
    (p: Bool) => p = true,
    Nat::lt(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k),
    (hn: Nat::lt(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k) = false) => False::elim(
      false_ne_true(
        Eq::trans(
          Eq::sym(
            nat_le_not_lt(
              Nat::mul(b, k),
              a,
              natle_trans(
                Nat::mul(b, k),
                Nat::mul(b, Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb))),
                a,
                nat_le_mul_mono(
                  b,
                  k,
                  Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
                  nat_not_lt_le(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k, hn)
                ),
                Eq::subst(
                  (z: Nat) => NatLe(Nat::mul(b, Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb))), z),
                  nat_div_mod(a, b, hb),
                  nat_le_add_left(
                    Nat::mul(b, Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb))),
                    Nat::rem_nz(a, b, Nat::ne_zero_of_pos(b, hb))
                  )
                )
              )
            )
          ),
          h
        )
      )
    ),
    (hy: Nat::lt(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k) = true) => Refl
  )
}

// A remainder by `b` and `b` times a remainder by `k` stay below `b` * `k`.
pub theorem nat_pack_lt(
  r0: Nat,
  r1: Nat,
  b: Nat,
  k: Nat,
  h0: Nat::lt(r0, b) = true,
  h1: Nat::lt(r1, k) = true
): Nat::lt(Nat::add(r0, Nat::mul(b, r1)), Nat::mul(b, k)) = true {
  nat_lt_of_le(
    Nat::add(r0, Nat::mul(b, r1)),
    Nat::mul(b, k),
    natle_trans(
      Succ(Nat::add(r0, Nat::mul(b, r1))),
      Nat::mul(b, Succ(r1)),
      Nat::mul(b, k),
      Eq::subst(
        (z: Nat) => NatLe(Succ(Nat::add(r0, Nat::mul(b, r1))), z),
        Eq::sym(Nat::mul_succ_right(b, r1)),
        Eq::subst(
          (z: Nat) => NatLe(Succ(Nat::add(r0, Nat::mul(b, r1))), z),
          Nat::add_comm(b, Nat::mul(b, r1)),
          Eq::subst(
            (z: Nat) => NatLe(z, Nat::add(b, Nat::mul(b, r1))),
            Nat::add_succ_left(r0, Nat::mul(b, r1)),
            nat_le_add_mono(
              Succ(r0),
              b,
              Nat::mul(b, r1),
              Nat::mul(b, r1),
              nat_le_of_lt(r0, b, h0),
              natle_refl(Nat::mul(b, r1))
            )
          )
        )
      ),
      nat_le_mul_mono(b, Succ(r1), k, nat_le_of_lt(r1, k, h1))
    )
  )
}

// A quotient of a quotient is the quotient by the product.
pub theorem nat_div_div(
  a: Nat,
  b: Nat,
  k: Nat,
  hb: Nat::lt(0, b) = true,
  hk: Nat::lt(0, k) = true,
  hbk: Nat::lt(0, Nat::mul(b, k)) = true
): Nat::div_nz(
  Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
  k,
  Nat::ne_zero_of_pos(k, hk)
) = Nat::div_nz(a, Nat::mul(b, k), Nat::ne_zero_of_pos(Nat::mul(b, k), hbk)) {
  Eq::sym(
    nat_div_unique(
      a,
      Nat::mul(b, k),
      Nat::div_nz(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k, Nat::ne_zero_of_pos(k, hk)),
      Nat::add(
        Nat::rem_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
        Nat::mul(
          b,
          Nat::rem_nz(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k, Nat::ne_zero_of_pos(k, hk))
        )
      ),
      Eq::trans(
        Eq::sym(nat_div_mod(a, b, hb)),
        Eq::trans(
          Eq::congr(
            (z: Nat) => Nat::add(Nat::rem_nz(a, b, Nat::ne_zero_of_pos(b, hb)), z),
            Eq::trans(
              Eq::congr(
                (z: Nat) => Nat::mul(b, z),
                Eq::sym(nat_div_mod(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k, hk))
              ),
              Eq::trans(
                nat_mul_distr(
                  b,
                  Nat::rem_nz(
                    Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
                    k,
                    Nat::ne_zero_of_pos(k, hk)
                  ),
                  Nat::mul(
                    k,
                    Nat::div_nz(
                      Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
                      k,
                      Nat::ne_zero_of_pos(k, hk)
                    )
                  )
                ),
                Eq::congr(
                  (z: Nat) => Nat::add(
                    Nat::mul(
                      b,
                      Nat::rem_nz(
                        Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
                        k,
                        Nat::ne_zero_of_pos(k, hk)
                      )
                    ),
                    z
                  ),
                  Eq::sym(
                    Nat::mul_assoc(
                      b,
                      k,
                      Nat::div_nz(
                        Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
                        k,
                        Nat::ne_zero_of_pos(k, hk)
                      )
                    )
                  )
                )
              )
            )
          ),
          Eq::sym(
            Nat::add_assoc(
              Nat::rem_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
              Nat::mul(
                b,
                Nat::rem_nz(
                  Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
                  k,
                  Nat::ne_zero_of_pos(k, hk)
                )
              ),
              Nat::mul(
                Nat::mul(b, k),
                Nat::div_nz(
                  Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
                  k,
                  Nat::ne_zero_of_pos(k, hk)
                )
              )
            )
          )
        )
      ),
      nat_pack_lt(
        Nat::rem_nz(a, b, Nat::ne_zero_of_pos(b, hb)),
        Nat::rem_nz(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k, Nat::ne_zero_of_pos(k, hk)),
        b,
        k,
        Nat::mod_lt(a, b, hb),
        Nat::mod_lt(Nat::div_nz(a, b, Nat::ne_zero_of_pos(b, hb)), k, hk)
      ),
      Nat::ne_zero_of_pos(Nat::mul(b, k), hbk)
    )
  )
}
