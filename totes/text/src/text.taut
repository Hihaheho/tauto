import std::Text
import std::Base
import std::prelude::Affine

// Text tools (`docs/design/self-host.md`) in the proof language
// (`docs/design/self-host.md`「text と unicode（`totes/text`、`totes/unicode`）」). Positions are UTF-8 bytes, as in `std/Text.taut`.
// A loop over positions recurses on the number of positions left, so it is
// structural.

pub fn text_newline(): Text {
  "\n"
}

pub fn text_quote(): Text {
  "\""
}

pub fn text_backslash(): Text {
  "\\"
}

pub fn text_code_point(c: Nat): Text {
  Text::utf8_of_code_point(c)
}

pub fn text_list_reverse_onto<A>(xs: List(A), done: List(A)): List(A) {
  List::reverse_onto(xs, done)
}

pub fn text_list_reverse<A>(xs: List(A)): List(A) {
  List::reverse(xs)
}

pub fn text_join_parts(parts: List(Text), sep: Text): List(Text) {
  ⊢ List(Text) from match parts {
    Nil => Nil
    Cons(part, rest) => ⊢ List(Text) from match rest {
      Nil => Cons(part, Nil)
      Cons(next, more) => Cons(part, Cons(sep, text_join_parts(rest, sep)))
    }
  }
}

pub fn text_join(parts: List(Text), sep: Text): Text {
  Text::concat_all(text_join_parts(parts, sep))
}

pub fn text_starts_with(t: Text, prefix: Text, at: Nat): Bool {
  ⊢ Bool from match Text::slice(t, at, Nat::add(at, Text::len(prefix))) {
    None => false
    Some(part) => Text::eq(part, prefix)
  }
}

// The first of the `k` positions from `at` where `needle` is.
pub fn text_find_in(k: Nat, t: Text, needle: Text, at: Nat): Option(Nat) {
  ⊢ Option(Nat) from match k {
    Zero => None
    Succ(k2) => ⊢ Option(Nat) from match text_starts_with(t, needle, at) {
      true => Some(at)
      false => text_find_in(k2, t, needle, Succ(at))
    }
  }
}

pub fn text_find_from(t: Text, needle: Text, at: Nat, last: Nat): Option(Nat) {
  text_find_in(Nat::sub(Succ(last), at), t, needle, at)
}

pub fn text_find(t: Text, needle: Text, r#from: Nat): Option(Nat) {
  ⊢ Option(Nat) from match Bool::or(
    Nat::lt(Text::len(t), Text::len(needle)),
    Nat::lt(Nat::sub(Text::len(t), Text::len(needle)), r#from)
  ) {
    true => None
    false => text_find_from(t, needle, r#from, Nat::sub(Text::len(t), Text::len(needle)))
  }
}

// The parts from byte `start`, last first, onto `done`; at most `k` more
// cuts.
pub fn text_split_in(k: Nat, t: Text, sep: Text, start: Nat, done: List(Text)): List(Text) {
  ⊢ List(Text) from match k {
    Zero => Cons(Text::slice_or_empty(t, start, Text::len(t)), done)
    Succ(k2) => ⊢ List(Text) from match text_find(t, sep, start) {
      None => Cons(Text::slice_or_empty(t, start, Text::len(t)), done)
      Some(at) => text_split_in(
        k2,
        t,
        sep,
        Nat::add(at, Text::len(sep)),
        Cons(Text::slice_or_empty(t, start, at), done)
      )
    }
  }
}

// The parts from byte `start`, last first, onto `done`. Every cut moves
// past a non-empty `sep`, so there are at most as many as bytes.
pub fn text_split_from(t: Text, sep: Text, start: Nat, done: List(Text)): List(Text) {
  text_split_in(Text::len(t), t, sep, start, done)
}

// The parts of `t` between the occurrences of `sep`, which is not empty (an
// empty `sep` leaves `t` whole).
pub fn text_split(t: Text, sep: Text): List(Text) {
  ⊢ List(Text) from match Nat::eq(Text::len(sep), 0) {
    true => Cons(t, Nil)
    false => List::reverse(text_split_from(t, sep, 0, Nil))
  }
}

// The lines of `t`, cut at "\n"; a "\r" stays on its line.
pub fn text_lines(t: Text): List(Text) {
  text_split(t, "\n")
}

pub fn text_repeat_parts(t: Text, n: Nat): List(Text) {
  ⊢ List(Text) from match n {
    Zero => Nil
    Succ(k) => Cons(t, text_repeat_parts(t, k))
  }
}

pub fn text_repeat(t: Text, n: Nat): Text {
  Text::concat_all(text_repeat_parts(t, n))
}

// A code point from the payload bits of its bytes, the first one's `lead`.
// The 64 comes first in each product: `Nat::mul` recurses on its second
// argument, so a proof over an unknown `lead` does not unfold it.
pub fn text_decode_with(
  lead: Nat,
  length: Nat,
  b1: Nat,
  b2: Nat,
  b3: Nat
): Option(@code Nat × @len Nat) {
  ⊢ Option(@code Nat × @len Nat) from match Nat::eq(length, 2) {
    true => Some(#(@code Nat::add(Nat::mul(64, lead), b1), @len length))
    false => ⊢ Option(@code Nat × @len Nat) from match Nat::eq(length, 3) {
      true => Some(
        #(@code Nat::add(Nat::mul(64, Nat::add(Nat::mul(64, lead), b1)), b2), @len length)
      )
      false => Some(
        #(
          @code Nat::add(
            Nat::mul(64, Nat::add(Nat::mul(64, Nat::add(Nat::mul(64, lead), b1)), b2)),
            b3
          ),
          @len length
        )
      )
    }
  }
}

// A first byte from 224 on: three bytes below 240, four from 240.
pub fn text_decode_from_224(t: Text, i: Nat, first: Nat): Option(@code Nat × @len Nat) {
  ⊢ Option(@code Nat × @len Nat) from match Nat::lt(first, 240) {
    true => text_decode_with(
      Nat::sub(first, 224),
      3,
      Nat::sub(Text::byte_value(t, Succ(i)), 128),
      Nat::sub(Text::byte_value(t, Nat::add(i, 2)), 128),
      0
    )
    false => text_decode_with(
      Nat::sub(first, 240),
      4,
      Nat::sub(Text::byte_value(t, Succ(i)), 128),
      Nat::sub(Text::byte_value(t, Nat::add(i, 2)), 128),
      Nat::sub(Text::byte_value(t, Nat::add(i, 3)), 128)
    )
  }
}

// A first byte from 192 on: two bytes below 224.
pub fn text_decode_from_192(t: Text, i: Nat, first: Nat): Option(@code Nat × @len Nat) {
  ⊢ Option(@code Nat × @len Nat) from match Nat::lt(first, 224) {
    true => text_decode_with(
      Nat::sub(first, 192),
      2,
      Nat::sub(Text::byte_value(t, Succ(i)), 128),
      0,
      0
    )
    false => text_decode_from_224(t, i, first)
  }
}

// A first byte from 128 on: below 192 it continues a character.
pub fn text_decode_from_128(t: Text, i: Nat, first: Nat): Option(@code Nat × @len Nat) {
  ⊢ Option(@code Nat × @len Nat) from match Nat::lt(first, 192) {
    true => None
    false => text_decode_from_192(t, i, first)
  }
}

// The character whose first byte, at `i`, is `first`. Each step is a
// function of its own, so a proof can take the steps one at a time
// (`totes/text/src/utf8.taut`).
pub fn text_decode_first(t: Text, i: Nat, first: Nat): Option(@code Nat × @len Nat) {
  ⊢ Option(@code Nat × @len Nat) from match Nat::lt(first, 128) {
    true => Some(#(@code first, @len 1))
    false => text_decode_from_128(t, i, first)
  }
}

// The character at byte `i`: its code point and its length in bytes. `None`
// when `i` is past the end or inside a character.
pub fn text_decode(t: Text, i: Nat): Option(@code Nat × @len Nat) {
  ⊢ Option(@code Nat × @len Nat) from match Text::byte(t, i) {
    None => None
    Some(first) => text_decode_first(t, i, first)
  }
}

// The characters among the `k` bytes from `i`, added to `count`.
pub fn text_char_count_in(k: Nat, t: Text, i: Nat, count: Nat): Nat {
  ⊢ Nat from match k {
    Zero => count
    Succ(k2) => ⊢ Nat from match Bool::and(
      Nat::le(128, Text::byte_value(t, i)),
      Nat::lt(Text::byte_value(t, i), 192)
    ) {
      // A byte `10xxxxxx` continues a character; the others start one.
      true => text_char_count_in(k2, t, Succ(i), count)
      false => text_char_count_in(k2, t, Succ(i), Succ(count))
    }
  }
}

pub fn text_char_count_from(t: Text, i: Nat, n: Nat, count: Nat): Nat {
  text_char_count_in(Nat::sub(n, i), t, i, count)
}

pub fn text_char_count(t: Text): Nat {
  text_char_count_in(Text::len(t), t, 0, 0)
}

pub fn text_digit(b: Nat): Option(Nat) {
  ⊢ Option(Nat) from match Bool::and(Nat::le(48, b), Nat::le(b, 57)) {
    true => Some(Nat::sub(b, 48))
    false => None
  }
}

// The digits among the `k` bytes from `at`, added onto `acc`, while `acc`
// stays within 2^63 - 1 (the evaluator keeps a `u64` in an `i64`).
pub fn text_parse_nat_in(k: Nat, t: Text, at: Nat, acc: Nat): Option(Nat) {
  ⊢ Option(Nat) from match k {
    Zero => Some(acc)
    Succ(k2) => ⊢ Option(Nat) from match text_digit(Text::byte_value(t, at)) {
      None => None
      Some(d) => ⊢ Option(Nat) from match Nat::lt(
        Nat::div_nz(Nat::sub(9223372036854775807, d), 10, Nat::ne_zero(10, Refl)),
        acc
      ) {
        true => None
        false => text_parse_nat_in(k2, t, Succ(at), Nat::add(Nat::mul(acc, 10), d))
      }
    }
  }
}

// Digits with an optional `+`. A number from 2^63 on is `None`.
pub fn text_parse_u64(t: Text): Option(Nat) {
  ⊢ Option(Nat) from match Nat::eq(Text::len(t), 0) {
    true => None
    false => ⊢ Option(Nat) from match Nat::eq(Text::byte_value(t, 0), 45) {
      true => None
      false => ⊢ Option(Nat) from match Nat::eq(Text::byte_value(t, 0), 43) {
        true => ⊢ Option(Nat) from match Nat::eq(Text::len(t), 1) {
          true => None
          false => text_parse_nat_in(Nat::sub(Text::len(t), 1), t, 1, 0)
        }
        false => text_parse_nat_in(Text::len(t), t, 0, 0)
      }
    }
  }
}

// The numbers among the `k` bytes from `at`: runs of digits, in order.
// `current` is the run being read when `inside` is `true`.
pub fn text_numbers_in(
  k: Nat,
  t: Text,
  at: Nat,
  current: Nat,
  inside: Bool,
  done: List(Nat)
): List(Nat) {
  ⊢ List(Nat) from match k {
    Zero => ⊢ List(Nat) from match inside {
      true => List::reverse(Cons(current, done))
      false => List::reverse(done)
    }
    Succ(k2) => ⊢ List(Nat) from match text_digit(Text::byte_value(t, at)) {
      Some(d) => text_numbers_in(k2, t, Succ(at), current * 10 + d, true, done)
      None => ⊢ List(Nat) from match inside {
        true => text_numbers_in(k2, t, Succ(at), 0, false, Cons(current, done))
        false => text_numbers_in(k2, t, Succ(at), 0, false, done)
      }
    }
  }
}

// Every number written in decimal in `t`, in order: `"3 14,15"` holds 3,
// 14 and 15.
pub fn text_number_list(t: Text): List(Nat) {
  text_numbers_in(Text::len(t), t, 0, 0, false, Nil)
}

pub theorem text_split_example(): text_split("a,b", ",") = Cons("a", Cons("b", Nil)) {
  Refl
}

pub theorem text_find_example(): text_find("abcab", "ab", 1) = Some(3) {
  Refl
}

pub theorem text_number_list_example(): text_number_list(
  "3 14,15"
) = Cons(3, Cons(14, Cons(15, Nil))) {
  Refl
}

// The rest of the file: writing into a `Buf`, numbers with a sign (`i64`),
// and a `Vec` of numbers. Nothing is proved about them
// (`docs/design/self-host.md`「text と unicode（`totes/text`、`totes/unicode`）」 says what is).

pub fn text_push_all(&mut b: Buf, parts: List(Text)): Unit {
  match parts {
    Nil => #()
    Cons(part, rest) => {
      Buf::push(&mut b, &part)
      text_push_all(&mut b, rest)
    }
  }
}

pub fn text_push_joined(&mut b: Buf, parts: List(Text), sep: Text): Unit {
  match parts {
    Nil => #()
    Cons(part, rest) => {
      Buf::push(&mut b, &part)
      match rest {
        Nil => #()
        Cons(next, more) => {
          Buf::push(&mut b, &sep)
          text_push_joined(&mut b, rest, sep)
        }
      }
    }
  }
}

pub fn text_parse_up(t: Text, at: u64, n: u64, acc: i64): Option(i64) {
  if at >= n {
    Some(acc)
  } else {
    match text_digit(Text::byte_value(t, Nat::of_u64(at))) {
      None => None
      Some(digit) => {
        let d := I64::of_u64(U64::of_nat(digit))
        if acc > div(9223372036854775807 - d, 10) {
          None
        } else {
          text_parse_up(t, at + 1, n, acc * 10 + d)
        }
      }
    }
  }
}

pub fn text_parse_down(t: Text, at: u64, n: u64, acc: i64): Option(i64) {
  if at >= n {
    Some(acc)
  } else {
    match text_digit(Text::byte_value(t, Nat::of_u64(at))) {
      None => None
      Some(digit) => {
        let d := I64::of_u64(U64::of_nat(digit))
        if acc < div(0 - 9223372036854775807 - 1 + d, 10) {
          None
        } else {
          text_parse_down(t, at + 1, n, acc * 10 - d)
        }
      }
    }
  }
}

pub fn text_parse_i64(t: Text): Option(i64) {
  let n := std::prelude::Text::len(t)
  let first := Text::byte_value(t, 0)
  if n == 0 {
    None
  } else if first == 45 {
    if n == 1 { None } else { text_parse_down(t, 1, n, 0) }
  } else if first == 43 {
    if n == 1 { None } else { text_parse_up(t, 1, n, 0) }
  } else {
    text_parse_up(t, 0, n, 0)
  }
}

pub fn text_numbers(t: Text): Vec(u64) {
  var out := Vec::new()
  let n := std::prelude::Text::len(t)
  var i: u64 := 0
  var current: u64 := 0
  var inside := false
  while i < n {
    let b := U64::of_nat(Text::byte_value(t, Nat::of_u64(i)))
    if b >= 48 && b <= 57 {
      current := current * 10 + (b - 48)
      inside := true
    } else if inside {
      Vec::push(&mut out, current)
      current := 0
      inside := false
    }
    i := i + 1
  }
  if inside {
    Vec::push(&mut out, current)
  }
  out
}
