import "../../surface/src/surface.taut"
import "../../surface/src/resolve.taut"
import "../../identity/src/identity.taut"
import "../../text/src/text.taut"
import std::base
import std::text

// The names a file declares and the places it uses a name, read from its
// surface program without types. Which declaration or binding a name is is
// decided once, by `surface_resolve` (`totes/surface/src/resolve.taut`); this
// file only lists what it found.
//
// A declaration is listed under each of its spellings (`name`, `M::name`,
// `Type::Ctor`, `Class::method`), all with its id. A use is a variable whose
// span is exactly its written name and that is not a local binding.

pub(open) inductive NamesDecl: Type {
  Mk(id: DeclId, name: Text, kind: Text, start: Nat, end: Nat): NamesDecl
}

// `scope` is the module path the use is written in (`M::` or empty);
// `target` the declaration of the file it is, or `NameSpelled` for one the
// file does not declare (or declares more than once under that spelling).
pub(open) inductive NamesUse: Type {
  Mk(name: Text, scope: Text, target: SurfaceName, start: Nat, end: Nat): NamesUse
}

pub fn names_decls_from(ds: List(SurfaceDecl)): List(NamesDecl) {
  match ds {
    Nil => Nil
    Cons(d, rest) => Cons(
      NamesDecl { id: d.id, name: d.name, kind: d.kind, start: d.start, end: d.end },
      names_decls_from(rest)
    )
  }
}

// The declarations of a program, in the order they are written.
pub fn names_decls(stmts: List(SurfaceStmt)): List(NamesDecl) {
  names_decls_from(surface_decls(stmts))
}

pub fn names_has(names: List(Text), name: Text): Bool {
  match names {
    Nil => false
    Cons(n, rest) => if Text::eq(n, name) { true } else { names_has(rest, name) }
  }
}

pub fn names_is_local(n: SurfaceName): Bool {
  match n {
    NameSpelled(^t) => false
    NameGlobal(^d) => false
    NameLocal(^l) => true
  }
}

// The uses among `us` that are not locals and whose span is the name as
// written, put before `out`.
pub fn names_kept(source: Text, us: List(SurfaceUse), out: List(NamesUse)): List(NamesUse) {
  match us {
    Nil => out
    Cons(u, rest) => if Text::eq(Text::slice_or_empty(source, u.start, u.end), u.spelling) && not(names_is_local(u.name)) {
      names_kept(
        source,
        rest,
        Cons(NamesUse { name: u.spelling, scope: u.scope, target: u.name, start: u.start, end: u.end }, out)
      )
    } else {
      names_kept(source, rest, out)
    }
  }
}

// The uses of names in a program, in no particular order.
pub fn names_uses(source: Text, stmts: List(SurfaceStmt)): List(NamesUse) {
  names_kept(source, surface_resolve(stmts).uses, Nil)
}

// The files a program imports by path (`import "a.taut"`), as written.
pub fn names_imports(stmts: List(SurfaceStmt)): List(Text) {
  match stmts {
    Nil => Nil
    Cons(st, rest) => ⊢ List(Text) from match st {
      StImport(path, ^start, ^end) => if names_ends_with(path, ".taut") || names_ends_with(path, ".tauto") {
        Cons(path, names_imports(rest))
      } else {
        names_imports(rest)
      }
      _ => names_imports(rest)
    }
  }
}

pub fn names_ends_with(t: Text, suffix: Text): Bool {
  Text::len(suffix) <= Text::len(t) && text_starts_with(t, suffix, Text::len(t) - Text::len(suffix))
}
