package {
  name = "names"
  version = "0.1.0"
}

dependencies {
  surface { path = "../surface" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}

// The walk over the surface program is one mutual block of a function for
// each type of the group.
check {
  slow {
    "src/names.taut" = 120
  }
}
