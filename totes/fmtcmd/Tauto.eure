// `tauto fmt [--check] FILE…`: the command that lays files out with
// `totes/fmt`. The reading and writing of files, the flags and the exit
// status are here; what the Rust side still does is the layout of the bodies
// of syntax literals and the text of its messages (bridge/).
package {
  name = "fmtcmd"
  version = "0.1.0"
}

dependencies {
  fmt { path = "../fmt" }
  surface { path = "../surface" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}

rust {
  bridge = "bridge"
  exports = []
}
