import std::Array
import std::Text
import "../../text/src/text.taut"
import "dynamic.taut"

// The scanner of Tauto's syntax, reading the scanner tables, in the proof
// language (`docs/design/self-host.md`). `README.md` says what it does and
// why. Every loop is a recursion on what is left: the bytes of the text, or
// the numbers of a table.

// A token the scanner cut: its terminal, where it is (bytes, end excluded)
// and the mode the scanner was in when it cut it.
pub(open) inductive ScanToken: Type {
  Mk(token_type: Nat, start: Nat, end: Nat, mode: Nat): ScanToken
}

// What happens to the mode after a token: kind 0 sets it to `target`, 1
// pushes the current one and sets `target`, 2 pops one.
pub(open) inductive ScanModeChange: Type {
  Mk(kind: Nat, token: Nat, target: Nat): ScanModeChange
}

// The scanner's tables, read from the numbers of `syntax_tables_scan_*`.
// A "class" is stored plus one: 0 means the character has none.
pub(open) inductive ScanTables: Type {
  Mk(
    classes: Nat,
    ascii: Array(Nat),
    run_start: Array(Nat),
    run_end: Array(Nat),
    run_class: Array(Nat),
    // The first state of each automaton (all states are numbered together).
    dfa_first: Array(Nat),
    // For each state its first entry in `accept_*`; one more at the end.
    accept_first: Array(Nat),
    accept_token: Array(Nat),
    accept_kind: Array(Nat),
    accept_dfa: Array(Nat),
    // State * classes + class: the next state plus one, 0 for none.
    rows: Array(Nat),
    mode_changes: Array(List(ScanModeChange)),
    // The states of the scanner and the terminals that use them
    // (`dynamic.taut`); none when the grammar declares no state.
    dyn_states: List(ScanDynState),
    dyns: List(ScanDyn),
    // While a token is looked for: the values the states hold, and where
    // the token starts.
    held: List(ScanHeld),
    start: Nat
  ): ScanTables
}

// The number at `i`; 0 past the end (`scan_tables_read` checks that no
// read is past the end).
pub fn scan_number(a: Array(Nat), i: Nat): Nat {
  Array::get_or(a, i, 0)
}

// ---- classes of characters ---------------------------------------------------

// The first run in `lo` to `hi` that starts after `code` (a binary search).
// The range halves each time, so `fuel` is its length.
pub fn scan_search(fuel: Nat, starts: Array(Nat), code: Nat, lo: Nat, hi: Nat): Nat {
  match fuel: Nat {
    Zero => lo
    Succ(f) => match lo < hi: Nat {
      false => lo
      true => match scan_number(starts, Nat::div_nz(lo + hi, 2, Nat::ne_zero(2, Refl))) <= code: Nat {
        true => scan_search(f, starts, code, Nat::div_nz(lo + hi, 2, Nat::ne_zero(2, Refl)) + 1, hi)
        false => scan_search(f, starts, code, lo, Nat::div_nz(lo + hi, 2, Nat::ne_zero(2, Refl)))
      }
    }
  }
}

// The class + 1 of a code point by the runs: the last run that starts at or
// before it, if it ends at or after it.
pub fn scan_run_class(starts: Array(Nat), ends: Array(Nat), classes: Array(Nat), code: Nat): Nat {
  match scan_search(Array::len(starts), starts, code, 0, Array::len(starts)): Nat {
    Zero => 0
    Succ(j) => match code <= scan_number(ends, j): Nat {
      true => scan_number(classes, j) + 1
      false => 0
    }
  }
}

// The length in bytes of the character that starts with this byte.
pub fn scan_char_length(first: Nat): Nat {
  match first < 128: Nat {
    true => 1
    false => match first < 224: Nat {
      true => 2
      false => match first < 240: Nat {
        true => 3
        false => 4
      }
    }
  }
}

// ---- reading the tables ------------------------------------------------------

// `k` numbers of `a`, from `at`, `step` apart.
pub fn scan_column(k: Nat, a: Array(Nat), at: Nat, step: Nat): List(Nat) {
  match k: List(Nat) {
    Zero => Nil
    Succ(k2) => Cons(scan_number(a, at), scan_column(k2, a, at + step, step))
  }
}

// The class + 1 of the `k` code points from `code`.
pub fn scan_classes_from(
  k: Nat,
  starts: Array(Nat),
  ends: Array(Nat),
  classes: Array(Nat),
  code: Nat
): List(Nat) {
  match k: List(Nat) {
    Zero => Nil
    Succ(k2) => Cons(
      scan_run_class(starts, ends, classes, code),
      scan_classes_from(k2, starts, ends, classes, Succ(code))
    )
  }
}

// The `k` changes from `p`, put before `done` last first.
pub fn scan_changes_in(
  k: Nat,
  m: Array(Nat),
  p: Nat,
  done: List(ScanModeChange)
): List(ScanModeChange) {
  match k: List(ScanModeChange) {
    Zero => done
    Succ(k2) => scan_changes_in(
      k2,
      m,
      p + 3,
      Cons(
        ScanModeChange {
          kind: scan_number(m, p),
          token: scan_number(m, p + 1),
          target: scan_number(m, p + 2)
        },
        done
      )
    )
  }
}

// The changes of `k` modes from `p` (last mode first), and where they end.
pub fn scan_modes_in(
  k: Nat,
  m: Array(Nat),
  p: Nat,
  done: List(List(ScanModeChange))
): Pair(List(List(ScanModeChange)), Nat) {
  match k: Pair(List(List(ScanModeChange)), Nat) {
    Zero => Pair { fst: done, snd: p }
    Succ(k2) => scan_modes_in(
      k2,
      m,
      p + 1 + scan_number(m, p) * 3,
      Cons(scan_changes_in(scan_number(m, p), m, p + 1, Nil), done)
    )
  }
}

// Where the automata are read: the next number of `states` and of `rows`,
// the states and accept entries so far, and the tables built so far (each
// last entry first).
pub(open) inductive ScanBuild: Type {
  Mk(
    sp: Nat,
    rp: Nat,
    total: Nat,
    accepts: Nat,
    built_dfa_first: List(Nat),
    built_accept_first: List(Nat),
    built_accept_token: List(Nat),
    built_accept_kind: List(Nat),
    built_accept_dfa: List(Nat),
    built_rows: List(Nat)
  ): ScanBuild
}

// `n` copies of `x` before `l`.
pub fn scan_repeat_onto(n: Nat, x: Nat, l: List(Nat)): List(Nat) {
  match n: List(Nat) {
    Zero => l
    Succ(n2) => scan_repeat_onto(n2, x, Cons(x, l))
  }
}

// `k` accept entries.
pub fn scan_accepts_in(k: Nat, s: Array(Nat), b: ScanBuild): ScanBuild {
  match k: ScanBuild {
    Zero => b
    Succ(k2) => scan_accepts_in(
      k2,
      s,
      ScanBuild {
        sp: b.sp + 3,
        rp: b.rp,
        total: b.total,
        accepts: Succ(b.accepts),
        built_dfa_first: b.built_dfa_first,
        built_accept_first: b.built_accept_first,
        built_accept_token: Cons(scan_number(s, b.sp), b.built_accept_token),
        built_accept_kind: Cons(scan_number(s, b.sp + 1), b.built_accept_kind),
        built_accept_dfa: Cons(scan_number(s, b.sp + 2), b.built_accept_dfa),
        built_rows: b.built_rows
      }
    )
  }
}

// A state's row, run by run, once `filled` classes are: each run is a count
// and a next state (0 for none). Each run fills one class at least, so
// `fuel` is the number of classes.
pub fn scan_row_in(
  fuel: Nat,
  n_classes: Nat,
  r: Array(Nat),
  filled: Nat,
  b: ScanBuild
): ScanBuild {
  match fuel: ScanBuild {
    Zero => b
    Succ(f) => match filled < n_classes: ScanBuild {
      false => b
      true => scan_row_in(
        f,
        n_classes,
        r,
        filled + scan_number(r, b.rp),
        ScanBuild {
          sp: b.sp,
          rp: b.rp + 2,
          total: b.total,
          accepts: b.accepts,
          built_dfa_first: b.built_dfa_first,
          built_accept_first: b.built_accept_first,
          built_accept_token: b.built_accept_token,
          built_accept_kind: b.built_accept_kind,
          built_accept_dfa: b.built_accept_dfa,
          built_rows: scan_repeat_onto(
            scan_number(r, b.rp),
            match scan_number(r, b.rp + 1): Nat {
              Zero => 0
              Succ(v) => b.total + Succ(v)
            },
            b.built_rows
          )
        }
      )
    }
  }
}

// `k` states of an automaton: each one's accept entries and row.
pub fn scan_states_in(
  k: Nat,
  n_classes: Nat,
  s: Array(Nat),
  r: Array(Nat),
  b: ScanBuild
): ScanBuild {
  match k: ScanBuild {
    Zero => b
    Succ(k2) => scan_states_in(
      k2,
      n_classes,
      s,
      r,
      scan_row_in(
        n_classes,
        n_classes,
        r,
        0,
        scan_accepts_in(
          scan_number(s, b.sp),
          s,
          ScanBuild {
            sp: b.sp + 1,
            rp: b.rp,
            total: b.total,
            accepts: b.accepts,
            built_dfa_first: b.built_dfa_first,
            built_accept_first: Cons(b.accepts, b.built_accept_first),
            built_accept_token: b.built_accept_token,
            built_accept_kind: b.built_accept_kind,
            built_accept_dfa: b.built_accept_dfa,
            built_rows: b.built_rows
          }
        )
      )
    )
  }
}

// After an automaton's states: its states count in `total`.
pub fn scan_add_states(n: Nat, b: ScanBuild): ScanBuild {
  ScanBuild {
    sp: b.sp,
    rp: b.rp,
    total: b.total + n,
    accepts: b.accepts,
    built_dfa_first: b.built_dfa_first,
    built_accept_first: b.built_accept_first,
    built_accept_token: b.built_accept_token,
    built_accept_kind: b.built_accept_kind,
    built_accept_dfa: b.built_accept_dfa,
    built_rows: b.built_rows
  }
}

// `k` automata.
pub fn scan_dfas_in(
  k: Nat,
  n_classes: Nat,
  s: Array(Nat),
  r: Array(Nat),
  b: ScanBuild
): ScanBuild {
  match k: ScanBuild {
    Zero => b
    Succ(k2) => scan_dfas_in(
      k2,
      n_classes,
      s,
      r,
      scan_add_states(
        scan_number(s, b.sp),
        scan_states_in(
          scan_number(s, b.sp),
          n_classes,
          s,
          r,
          ScanBuild {
            sp: b.sp + 1,
            rp: b.rp,
            total: b.total,
            accepts: b.accepts,
            built_dfa_first: Cons(b.total, b.built_dfa_first),
            built_accept_first: b.built_accept_first,
            built_accept_token: b.built_accept_token,
            built_accept_kind: b.built_accept_kind,
            built_accept_dfa: b.built_accept_dfa,
            built_rows: b.built_rows
          }
        )
      )
    )
  }
}

pub fn scan_array(l: List(Nat)): Array(Nat) {
  Array::of_list(List::reverse(l))
}

// Whether the exclusive read end fits within the array.
pub fn scan_within(end: Nat, a: Array(Nat)): Bool {
  end <= Array::len(a)
}

pub fn scan_tables_from(
  m: Array(Nat),
  c: Array(Nat),
  s: Array(Nat),
  r: Array(Nat),
  d: Array(Nat)
): Option(ScanTables) {
  let n_classes := scan_number(m, 0)
  let n_runs := scan_number(c, 0)
  let run_start := Array::of_list(scan_column(n_runs, c, 1, 3))
  let run_end := Array::of_list(scan_column(n_runs, c, 2, 3))
  let run_class := Array::of_list(scan_column(n_runs, c, 3, 3))
  let modes := scan_modes_in(scan_number(m, 1), m, 3, Nil)
  let b := scan_dfas_in(
    scan_number(m, 2),
    n_classes,
    s,
    r,
    ScanBuild {
      sp: 0,
      rp: 0,
      total: 0,
      accepts: 0,
      built_dfa_first: Nil,
      built_accept_first: Nil,
      built_accept_token: Nil,
      built_accept_kind: Nil,
      built_accept_dfa: Nil,
      built_rows: Nil
    }
  )
  let n_states := scan_number(d, 0)
  let dyn_states := scan_dyn_states_in(n_states, d, 1, Nil)
  let dyns := scan_dyns_in(scan_number(d, 1 + n_states * 3), d, 2 + n_states * 3, Nil)
  let dyn_end := match Array::len(d): Nat {
    Zero => 0
    Succ(x) => dyns.snd
  }
  match scan_within(
    modes.snd,
    m
  ) && scan_within(
    1 + n_runs * 3,
    c
  ) && scan_within(
    b.sp,
    s
  ) && scan_within(b.rp, r) && scan_within(dyn_end, d): Option(ScanTables) {
    false => None
    true => Some(
      ScanTables {
        classes: n_classes,
        ascii: Array::of_list(scan_classes_from(128, run_start, run_end, run_class, 0)),
        run_start: run_start,
        run_end: run_end,
        run_class: run_class,
        dfa_first: scan_array(b.built_dfa_first),
        accept_first: scan_array(Cons(b.accepts, b.built_accept_first)),
        accept_token: scan_array(b.built_accept_token),
        accept_kind: scan_array(b.built_accept_kind),
        accept_dfa: scan_array(b.built_accept_dfa),
        rows: scan_array(b.built_rows),
        mode_changes: Array::of_list(List::reverse(modes.fst)),
        dyn_states: dyn_states,
        dyns: dyns.fst,
        held: Nil,
        start: 0
      }
    )
  }
}

// Reads the tables from the four texts (`meta`, `classes`, `states`, `rows`).
// A table too short for what it says is not a scanner: `None`.
pub fn scan_tables_read(meta: Text, classes: Text, states: Text, rows: Text): Option(ScanTables) {
  scan_tables_read_dynamic(meta, classes, states, rows, "")
}

// Reads the tables with the states of the scanner (`dynamic`, see
// `README.md`); an empty `dynamic` is a scanner without states.
pub fn scan_tables_read_dynamic(
  meta: Text,
  classes: Text,
  states: Text,
  rows: Text,
  dynamic: Text
): Option(ScanTables) {
  scan_tables_from(
    Array::of_list(text_number_list(meta)),
    Array::of_list(text_number_list(classes)),
    Array::of_list(text_number_list(states)),
    Array::of_list(text_number_list(rows)),
    Array::of_list(text_number_list(dynamic))
  )
}

// The code point at byte `i` of a text that has a character there.
pub fn scan_code_point(text: Text, i: Nat, first: Nat): Nat {
  match text_decode(text, i): Nat {
    None => first
    Some(#(@code code, @len _)) => code
  }
}

// The class + 1 of the character at byte `i` (the first byte is `first`).
pub fn scan_class(&t: ScanTables, text: Text, i: Nat, first: Nat): Nat {
  match first < 128: Nat {
    true => scan_number(t.ascii, first)
    false => scan_run_class(t.run_start, t.run_end, t.run_class, scan_code_point(text, i, first))
  }
}

// The state after the character at `i` in `state`, plus one; 0 for none.
pub fn scan_next(&t: ScanTables, text: Text, state: Nat, i: Nat): Nat {
  match scan_class(t, text, i, Text::byte_value(text, i)): Nat {
    Zero => 0
    Succ(c) => scan_number(t.rows, state * t.classes + c)
  }
}

// ---- tokens ------------------------------------------------------------------

// Whether the automaton reaches a state that accepts, from `state` at byte
// `i`, within `k` characters. This is the lookahead of an accept entry: it
// says true at the first one, so how much longer it could read does not
// matter.
pub fn scan_probe_in(k: Nat, &t: ScanTables, text: Text, state: Nat, i: Nat, n: Nat): Bool {
  match k: Bool {
    Zero => false
    Succ(k2) => match i < n: Bool {
      false => false
      true => match scan_next(t, text, state, i): Bool {
        Zero => false
        Succ(s2) => match scan_number(
          t.accept_first,
          s2
        ) < scan_number(t.accept_first, Succ(s2)): Bool {
          true => true
          false => scan_probe_in(k2, t, text, s2, i + scan_char_length(Text::byte_value(text, i)), n)
        }
      }
    }
  }
}

// Whether the automaton `dfa`, run from byte `from`, reaches a state that
// accepts. Each character is a byte at least, so `n - from` of them do.
pub fn scan_probe(&t: ScanTables, text: Text, dfa: Nat, r#from: Nat, n: Nat): Bool {
  scan_probe_in(n - r#from, t, text, scan_number(t.dfa_first, dfa), r#from, n)
}

// Whether the accept entry `j` holds at byte `i`: its lookahead, and what
// its terminal asks of the states of the scanner.
pub fn scan_holds(&t: ScanTables, text: Text, j: Nat, i: Nat, n: Nat): Bool {
  match scan_number(t.accept_kind, j): Bool {
    Zero => scan_dyn_ok(t, text, scan_number(t.accept_token, j), i)
    Succ(kind) => match kind: Bool {
      Zero => scan_probe(
        t,
        text,
        scan_number(t.accept_dfa, j),
        i,
        n
      ) && scan_dyn_ok(t, text, scan_number(t.accept_token, j), i)
      Succ(other) => not(scan_probe(
        t,
        text,
        scan_number(t.accept_dfa, j),
        i,
        n
      )) && scan_dyn_ok(t, text, scan_number(t.accept_token, j), i)
    }
  }
}

// ---- the states of the scanner -------------------------------------------------

pub fn scan_accepting(&t: ScanTables, state: Nat): Bool {
  scan_number(t.accept_first, state) < scan_number(t.accept_first, Succ(state))
}

// The ends up to `to` where a run from `state` at `i` reaches a state that
// accepts, within `k` characters, the last first.
pub fn scan_ends_in(
  k: Nat,
  &t: ScanTables,
  text: Text,
  state: Nat,
  i: Nat,
  to: Nat,
  done: List(Nat)
): List(Nat) {
  match k: List(Nat) {
    Zero => done
    Succ(k2) => match i < to: List(Nat) {
      false => done
      true => match scan_next(t, text, state, i): List(Nat) {
        Zero => done
        Succ(s2) => scan_ends_in(
          k2,
          t,
          text,
          s2,
          i + scan_char_length(Text::byte_value(text, i)),
          to,
          match scan_accepting(t, s2): List(Nat) {
            true => Cons(i + scan_char_length(Text::byte_value(text, i)), done)
            false => done
          }
        )
      }
    }
  }
}

// The ends, in order, where the automaton `dfa` run from `from` accepts
// before `to` (`from` itself if its first state accepts).
pub fn scan_ends(&t: ScanTables, text: Text, dfa: Nat, r#from: Nat, to: Nat): List(Nat) {
  List::reverse(
    scan_ends_in(
      to - r#from,
      t,
      text,
      scan_number(t.dfa_first, dfa),
      r#from,
      to,
      match scan_accepting(t, scan_number(t.dfa_first, dfa)): List(Nat) {
        true => Cons(r#from, Nil)
        false => Nil
      }
    )
  )
}

pub fn scan_has(l: List(Nat), x: Nat): Bool {
  match l: Bool {
    Nil => false
    Cons(y, rest) => match y == x: Bool {
      true => true
      false => scan_has(rest, x)
    }
  }
}

// Whether the automaton `dfa` matches the text from `from` to `to` exactly.
pub fn scan_exact(&t: ScanTables, text: Text, dfa: Nat, r#from: Nat, to: Nat): Bool {
  scan_has(scan_ends(t, text, dfa, r#from, to), to)
}

// How many units follow one another from `at` before `to`, `max` at most.
pub fn scan_units(k: Nat, text: Text, unit: Text, at: Nat, to: Nat, count: Nat): Nat {
  match k: Nat {
    Zero => count
    Succ(k2) => match at + Text::len(unit) <= to && text_starts_with(text, unit, at): Nat {
      false => count
      true => scan_units(k2, text, unit, at + Text::len(unit), to, Succ(count))
    }
  }
}

// The most units, from `c` down to `min`, after which the part after the
// operator matches up to `to`.
pub fn scan_count_down(
  k: Nat,
  &t: ScanTables,
  text: Text,
  d: ScanDyn,
  p: Nat,
  to: Nat,
  min: Nat,
  c: Nat
): Option(Nat) {
  match k: Option(Nat) {
    Zero => None
    Succ(k2) => match c < min: Option(Nat) {
      true => None
      false => match scan_exact(t, text, d.suffix, p + c * Text::len(d.unit), to): Option(Nat) {
        true => Some(c)
        false => match c: Option(Nat) {
          Zero => None
          Succ(c2) => scan_count_down(k2, t, text, d, p, to, min, c2)
        }
      }
    }
  }
}

pub fn scan_max_option(a: Option(Nat), b: Option(Nat)): Option(Nat) {
  match a: Option(Nat) {
    None => b
    Some(x) => match b: Option(Nat) {
      None => a
      Some(y) => match x < y: Option(Nat) {
        true => b
        false => a
      }
    }
  }
}

// The count of a token from `ends`, the places the part before the operator
// may end: the most units that the part after it can follow.
pub fn scan_count_best(
  &t: ScanTables,
  text: Text,
  d: ScanDyn,
  st: ScanDynState,
  ends: List(Nat),
  to: Nat,
  best: Option(Nat)
): Option(Nat) {
  match ends: Option(Nat) {
    Nil => best
    Cons(p, rest) => {
      let fit := scan_units(st.max, text, d.unit, p, to, 0)
      scan_count_best(
        t,
        text,
        d,
        st,
        rest,
        to,
        scan_max_option(best, scan_count_down(Succ(fit), t, text, d, p, to, st.min, fit))
      )
    }
  }
}

pub fn scan_wider(best: Option(@start Nat × @end Nat), p: Nat, e: Nat): Bool {
  match best: Bool {
    None => true
    Some(#(@start start, @end end)) => end - start < e - p
  }
}

pub fn scan_capture_from(
  &t: ScanTables,
  text: Text,
  d: ScanDyn,
  p: Nat,
  es: List(Nat),
  to: Nat,
  best: Option(@start Nat × @end Nat)
): Option(@start Nat × @end Nat) {
  match es: Option(@start Nat × @end Nat) {
    Nil => best
    Cons(e, rest) => scan_capture_from(
      t,
      text,
      d,
      p,
      rest,
      to,
      match scan_wider(best, p, e) && scan_exact(t, text, d.suffix, e, to): Option(@start Nat × @end Nat) {
        true => Some(#(@start p, @end e))
        false => best
      }
    )
  }
}

// The captured text of a token: the widest that the capture automaton
// matches between the part before and the part after, the earliest of the
// widest.
pub fn scan_capture_best(
  &t: ScanTables,
  text: Text,
  d: ScanDyn,
  ends: List(Nat),
  to: Nat,
  best: Option(@start Nat × @end Nat)
): Option(@start Nat × @end Nat) {
  match ends: Option(@start Nat × @end Nat) {
    Nil => best
    Cons(p, rest) => scan_capture_best(
      t,
      text,
      d,
      rest,
      to,
      scan_capture_from(t, text, d, p, scan_ends(t, text, d.capture - 1, p, to), to, best)
    )
  }
}

// Whether the text the state holds is between a part before and a part after.
pub fn scan_text_between(
  &t: ScanTables,
  text: Text,
  d: ScanDyn,
  stored: Text,
  ends: List(Nat),
  to: Nat
): Bool {
  match ends: Bool {
    Nil => false
    Cons(p, rest) => match p + Text::len(
      stored
    ) <= to && text_starts_with(
      text,
      stored,
      p
    ) && scan_exact(t, text, d.suffix, p + Text::len(stored), to): Bool {
      true => true
      false => scan_text_between(t, text, d, stored, rest, to)
    }
  }
}

pub fn scan_is_some<A>(o: Option(A)): Bool {
  match o: Bool {
    None => false
    Some(x) => true
  }
}

// Whether the token from `from` to `to` of a terminal with `%capture` or
// `%validate` may be cut, with what the states hold.
pub fn scan_dyn_holds(&t: ScanTables, text: Text, d: ScanDyn, r#from: Nat, to: Nat): Bool {
  let st := scan_dyn_state_at(t.dyn_states, d.state)
  let ends := scan_ends(t, text, d.prefix, r#from, to)
  match d.op: Bool {
    Zero => scan_is_some(scan_count_best(t, text, d, st, ends, to, None))
    Succ(op1) => match op1: Bool {
      Zero => match scan_held_at(t.held, d.state): Bool {
        ScanHeldCount(stored) => match scan_count_best(t, text, d, st, ends, to, None): Bool {
          None => false
          Some(c) => scan_count_fits(d, c, stored)
        }
        ScanHeldText(x) => false
        ScanHeldNone => false
      }
      Succ(op2) => match op2: Bool {
        Zero => scan_is_some(scan_capture_best(t, text, d, ends, to, None))
        Succ(op3) => match scan_held_at(t.held, d.state): Bool {
          ScanHeldText(stored) => scan_text_between(t, text, d, stored, ends, to)
          ScanHeldCount(x) => false
          ScanHeldNone => false
        }
      }
    }
  }
}

// Whether what the terminal `token` asks of the states holds for the token
// that ends at `i` (it starts at `t.start`).
pub fn scan_dyn_ok(&t: ScanTables, text: Text, token: Nat, i: Nat): Bool {
  match scan_dyn_of(t.dyns, token): Bool {
    None => true
    Some(d) => scan_dyn_holds(t, text, d, t.start, i)
  }
}

// What the states hold after the token `token` from `from` to `to`: a
// `%capture` stores its count or text.
pub fn scan_commit(&t: ScanTables, text: Text, token: Nat, r#from: Nat, to: Nat): List(ScanHeld) {
  match scan_dyn_of(t.dyns, token): List(ScanHeld) {
    None => t.held
    Some(d) => {
      let st := scan_dyn_state_at(t.dyn_states, d.state)
      let ends := scan_ends(t, text, d.prefix, r#from, to)
      match d.op: List(ScanHeld) {
        Zero => match scan_count_best(t, text, d, st, ends, to, None): List(ScanHeld) {
          None => scan_held_set(t.held, d.state, ScanHeldNone)
          Some(c) => scan_held_set(t.held, d.state, ScanHeldCount(c))
        }
        Succ(op1) => match op1: List(ScanHeld) {
          Zero => t.held
          Succ(op2) => match op2: List(ScanHeld) {
            Zero => match scan_capture_best(t, text, d, ends, to, None): List(ScanHeld) {
              None => scan_held_set(t.held, d.state, ScanHeldNone)
              Some(#(@start start, @end end)) => scan_held_set(
                t.held,
                d.state,
                ScanHeldText(Text::slice_or_empty(text, start, end))
              )
            }
            Succ(op3) => t.held
          }
        }
      }
    }
  }
}

// The tables while a token from `start` is looked for, the states holding `held`.
pub fn scan_at(&t: ScanTables, held: List(ScanHeld), start: Nat): ScanTables {
  ScanTables {
    classes: t.classes,
    ascii: t.ascii,
    run_start: t.run_start,
    run_end: t.run_end,
    run_class: t.run_class,
    dfa_first: t.dfa_first,
    accept_first: t.accept_first,
    accept_token: t.accept_token,
    accept_kind: t.accept_kind,
    accept_dfa: t.accept_dfa,
    rows: t.rows,
    mode_changes: t.mode_changes,
    dyn_states: t.dyn_states,
    dyns: t.dyns,
    held: held,
    start: start
  }
}

// The terminal of the first of the `k` accept entries from `j` that holds.
pub fn scan_accept_in(k: Nat, &t: ScanTables, text: Text, j: Nat, i: Nat, n: Nat): Option(Nat) {
  match k: Option(Nat) {
    Zero => None
    Succ(k2) => match scan_holds(t, text, j, i, n): Option(Nat) {
      true => Some(scan_number(t.accept_token, j))
      false => scan_accept_in(k2, t, text, Succ(j), i, n)
    }
  }
}

// The terminal of the first entry of `state` that holds at byte `i`.
pub fn scan_accept(&t: ScanTables, text: Text, state: Nat, i: Nat, n: Nat): Option(Nat) {
  scan_accept_in(
    scan_number(t.accept_first, Succ(state)) - scan_number(t.accept_first, state),
    t,
    text,
    scan_number(t.accept_first, state),
    i,
    n
  )
}

// The longest token from `state` at byte `i` within `k` characters, or
// `best` (its end and terminal).
pub fn scan_find_in(
  k: Nat,
  &t: ScanTables,
  text: Text,
  state: Nat,
  i: Nat,
  n: Nat,
  best: Option(Pair(Nat, Nat))
): Option(Pair(Nat, Nat)) {
  match k: Option(Pair(Nat, Nat)) {
    Zero => best
    Succ(k2) => match i < n: Option(Pair(Nat, Nat)) {
      false => best
      true => match scan_next(t, text, state, i): Option(Pair(Nat, Nat)) {
        Zero => best
        Succ(s2) => scan_find_in(
          k2,
          t,
          text,
          s2,
          i + scan_char_length(Text::byte_value(text, i)),
          n,
          match scan_accept(t, text, s2, i + scan_char_length(Text::byte_value(text, i)), n): Option(Pair(Nat, Nat)) {
            None => best
            Some(token) => Some(Pair { fst: i + scan_char_length(Text::byte_value(text, i)), snd: token })
          }
        )
      }
    }
  }
}

// The longest token of the automaton `dfa` at byte `pos`, if there is one:
// it reads as long as there is a transition, and
// remembers the last state that accepts, an entry with a lookahead only if
// the lookahead holds.
pub fn scan_find(&t: ScanTables, text: Text, dfa: Nat, pos: Nat, n: Nat): Option(Pair(Nat, Nat)) {
  scan_find_in(n - pos, t, text, scan_number(t.dfa_first, dfa), pos, n, None)
}

// ---- modes -------------------------------------------------------------------

// The mode after a token, and the modes pushed before it.
pub(open) inductive ScanMode: Type {
  Mk(current: Nat, pushed: List(Nat)): ScanMode
}

pub fn scan_pop(mode: ScanMode): ScanMode {
  match mode.pushed: ScanMode {
    Nil => mode
    Cons(Before, more) => ScanMode { current: Before, pushed: more }
  }
}

pub fn scan_change_with(changes: List(ScanModeChange), mode: ScanMode, token: Nat): ScanMode {
  match changes: ScanMode {
    Nil => mode
    Cons(change, rest) => match change.token == token: ScanMode {
      false => scan_change_with(rest, mode, token)
      true => match change.kind: ScanMode {
        Zero => ScanMode { current: change.target, pushed: mode.pushed }
        Succ(kind) => match kind: ScanMode {
          Zero => ScanMode { current: change.target, pushed: Cons(mode.current, mode.pushed) }
          Succ(other) => scan_pop(mode)
        }
      }
    }
  }
}

pub fn scan_change(&t: ScanTables, mode: ScanMode, token: Nat): ScanMode {
  scan_change_with(Array::get_or(t.mode_changes, mode.current, Nil), mode, token)
}

// ---- the scanner -------------------------------------------------------------

// The tokens from byte `pos` within `k` steps, after `done` (last first).
// Each step moves on a byte at least.
pub fn scan_all_in(
  k: Nat,
  &t: ScanTables,
  text: Text,
  n: Nat,
  pos: Nat,
  mode: ScanMode,
  held: List(ScanHeld),
  done: List(ScanToken)
): List(ScanToken) {
  match k: List(ScanToken) {
    Zero => List::reverse(done)
    Succ(k2) => match pos < n: List(ScanToken) {
      false => List::reverse(done)
      true => match scan_find(
        scan_at(t, held, pos),
        text,
        mode.current,
        pos,
        n
      ): List(ScanToken) {
        None => scan_all_in(
          k2,
          t,
          text,
          n,
          pos + scan_char_length(Text::byte_value(text, pos)),
          mode,
          held,
          done
        )
        Some(found) => scan_all_in(
          k2,
          t,
          text,
          n,
          found.fst,
          scan_change(t, mode, found.snd),
          scan_commit(scan_at(t, held, pos), text, found.snd, pos, found.fst),
          Cons(
            ScanToken { token_type: found.snd, start: pos, end: found.fst, mode: mode.current },
            done
          )
        )
      }
    }
  }
}

// Every token of `text`, in order. A character that no token starts with is
// skipped; whether such characters occur depends on the scanner tables.
pub fn scan_all(&t: ScanTables, text: Text): List(ScanToken) {
  scan_all_in(
    Text::len(text),
    t,
    text,
    Text::len(text),
    0,
    ScanMode { current: 0, pushed: Nil },
    scan_held_start(List::length(t.dyn_states)),
    Nil
  )
}
