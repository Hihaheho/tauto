import "scan.taut"
import std::Nat

// The scanner cuts the longest token the automaton accepts (`docs/design/self-host.md`「scan（`totes/scan/src/longest.taut`）」).
// An automaton run is `scan_walk`: `m` characters from a state, one
// transition (`scan_next`, the tables' row) each. A token of the run is a
// state it reaches after a character at least, where an accept entry holds
// (`scan_accept`).
//
// * Every token `scan_find` gives is one (`scan_find_sound`).
// * Every one is no longer than what `scan_find` gives
//   (`scan_find_longest`).

// ---- runs of the automaton --------------------------------------------------

// The byte after the character at `i`.
pub fn scan_after(text: Text, i: Nat): Nat {
  i + scan_char_length(Text::byte_value(text, i))
}

// The state and byte after `m` characters from `state` at byte `i`, or
// `None` if the automaton stops before.
pub fn scan_walk(
  m: Nat,
  t: ScanTables,
  text: Text,
  state: Nat,
  i: Nat,
  n: Nat
): Option(Pair(Nat, Nat)) {
  match m: Option(Pair(Nat, Nat)) {
    Zero => Some(Pair { fst: state, snd: i })
    Succ(m2) => match i < n: Option(Pair(Nat, Nat)) {
      false => None
      true => match scan_next(t, text, state, i): Option(Pair(Nat, Nat)) {
        Zero => None
        Succ(s2) => scan_walk(m2, t, text, s2, scan_after(text, i), n)
      }
    }
  }
}

// The steps of `scan_walk`, on the comparison and on the next state.
pub fn scan_walk_in(
  m: Nat,
  t: ScanTables,
  text: Text,
  state: Nat,
  i: Nat,
  n: Nat,
  c: Bool
): Option(Pair(Nat, Nat)) {
  match c: Option(Pair(Nat, Nat)) {
    false => None
    true => match scan_next(t, text, state, i): Option(Pair(Nat, Nat)) {
      Zero => None
      Succ(s2) => scan_walk(m, t, text, s2, scan_after(text, i), n)
    }
  }
}

pub fn scan_walk_next(
  m: Nat,
  t: ScanTables,
  text: Text,
  i: Nat,
  n: Nat,
  x: Nat
): Option(Pair(Nat, Nat)) {
  match x: Option(Pair(Nat, Nat)) {
    Zero => None
    Succ(s2) => scan_walk(m, t, text, s2, scan_after(text, i), n)
  }
}

// What the accept entries of the state say at the byte.
pub fn scan_accept_at(t: ScanTables, text: Text, n: Nat, p: Pair(Nat, Nat)): Option(Nat) {
  match p: Option(Nat) {
    Pair { fst: s, snd: e } => scan_accept(t, text, s, e, n)
  }
}

pub fn scan_pair_snd(p: Pair(Nat, Nat)): Nat {
  match p: Nat {
    Pair { fst: a, snd: b } => b
  }
}

// ---- small facts ------------------------------------------------------------

pub theorem scan_none_ne_some<A: Type>(x: A, e: None = Some(x)): False {
  match e: False {
  }
}

pub fn scan_option_or<A>(o: Option(A), d: A): A {
  match o: A {
    None => d
    Some(x) => x
  }
}

pub theorem scan_some_inj<A: Type>(a: A, b: A, e: Some(a) = Some(b)): a = b {
  Eq::congr((z: Option(A)) => scan_option_or(z, a), e)
}

pub theorem scan_nat_cases(
  P: (Nat) -> Prop,
  o: Nat,
  a: (o = Zero) -> P(Zero),
  b: ∀ x: Nat. (o = Succ(x)) -> P(Succ(x))
): P(o) {
  match o: P(o) {
    Zero => a(Refl)
    Succ(x) => b(x, Refl)
  }
}

pub theorem scan_option_cases<A: Type>(
  P: (Option(A)) -> Prop,
  o: Option(A),
  a: (o = None) -> P(None),
  b: ∀ x: A. (o = Some(x)) -> P(Some(x))
): P(o) {
  match o: P(o) {
    None => a(Refl)
    Some(x) => b(x, Refl)
  }
}

pub theorem scan_le_add(a: Nat, d: Nat): Nat::le(a, Nat::add(a, d)) = true {
  match d: Nat::le(a, Nat::add(a, d)) = true {
    Zero => Nat::le_refl(a)
    Succ(d2) => Nat::le_trans(
      a,
      Nat::add(a, d2),
      Succ(Nat::add(a, d2)),
      scan_le_add(a, d2),
      Nat::le_succ(Nat::add(a, d2))
    )
  }
}

pub theorem scan_le_after(text: Text, i: Nat): Nat::le(i, scan_after(text, i)) = true {
  scan_le_add(i, scan_char_length(Text::byte_value(text, i)))
}

// ---- the steps of `scan_find_in` --------------------------------------------

pub fn scan_find_upd(
  best: Option(Pair(Nat, Nat)),
  e: Nat,
  o: Option(Nat)
): Option(Pair(Nat, Nat)) {
  match o: Option(Pair(Nat, Nat)) {
    None => best
    Some(token) => Some(Pair { fst: e, snd: token })
  }
}

pub fn scan_find_next(
  k: Nat,
  t: ScanTables,
  text: Text,
  i: Nat,
  n: Nat,
  best: Option(Pair(Nat, Nat)),
  x: Nat
): Option(Pair(Nat, Nat)) {
  match x: Option(Pair(Nat, Nat)) {
    Zero => best
    Succ(s2) => scan_find_in(
      k,
      t,
      text,
      s2,
      scan_after(text, i),
      n,
      scan_find_upd(best, scan_after(text, i), scan_accept(t, text, s2, scan_after(text, i), n))
    )
  }
}

pub fn scan_find_cmp(
  k: Nat,
  t: ScanTables,
  text: Text,
  state: Nat,
  i: Nat,
  n: Nat,
  best: Option(Pair(Nat, Nat)),
  c: Bool
): Option(Pair(Nat, Nat)) {
  match c: Option(Pair(Nat, Nat)) {
    false => best
    true => scan_find_next(k, t, text, i, n, best, scan_next(t, text, state, i))
  }
}

// A result ends at `j` or later.
pub fn scan_at_least(j: Nat, r: Option(Pair(Nat, Nat))): Prop {
  match r: Prop {
    None => False
    Some(p) => match p: Prop {
      Pair { fst: e, snd: token } => Nat::le(j, e) = true
    }
  }
}

// `scan_find_in` gives `best` or a token that ends later.
pub theorem scan_find_in_mono(
  k: Nat,
  t: ScanTables,
  text: Text,
  state: Nat,
  i: Nat,
  n: Nat,
  best: Option(Pair(Nat, Nat)),
  e0: Nat,
  hb: scan_at_least(e0, best),
  hi: Nat::le(e0, i) = true
): scan_at_least(e0, scan_find_in(k, t, text, state, i, n, best)) {
  match k: scan_at_least(e0, scan_find_in(k, t, text, state, i, n, best)) {
    Zero => hb
    Succ(k2) => Bool::cases(
      (c: Bool) => scan_at_least(e0, scan_find_cmp(k2, t, text, state, i, n, best, c)),
      i < n,
      (q: (i < n) = false) => hb,
      (q: (i < n) = true) => scan_nat_cases(
        (x: Nat) => scan_at_least(e0, scan_find_next(k2, t, text, i, n, best, x)),
        scan_next(t, text, state, i),
        (qz: scan_next(t, text, state, i) = Zero) => hb,
        (s2: Nat) => (qs: scan_next(t, text, state, i) = Succ(s2)) => scan_option_cases(
          (o: Option(Nat)) => scan_at_least(
            e0,
            scan_find_in(
              k2,
              t,
              text,
              s2,
              scan_after(text, i),
              n,
              scan_find_upd(best, scan_after(text, i), o)
            )
          ),
          scan_accept(t, text, s2, scan_after(text, i), n),
          (
            qa: scan_accept(t, text, s2, scan_after(text, i), n) = None
          ) => scan_find_in_mono(
            k2,
            t,
            text,
            s2,
            scan_after(text, i),
            n,
            best,
            e0,
            hb,
            Nat::le_trans(e0, i, scan_after(text, i), hi, scan_le_after(text, i))
          ),
          (tok: Nat) => (
            qa: scan_accept(t, text, s2, scan_after(text, i), n) = Some(tok)
          ) => scan_find_in_mono(
            k2,
            t,
            text,
            s2,
            scan_after(text, i),
            n,
            Some(Pair { fst: scan_after(text, i), snd: tok }),
            e0,
            Nat::le_trans(e0, i, scan_after(text, i), hi, scan_le_after(text, i)),
            Nat::le_trans(e0, i, scan_after(text, i), hi, scan_le_after(text, i))
          )
        )
      )
    )
  }
}

// A run of no character ends where it starts.
pub theorem scan_le_at(
  t: ScanTables,
  text: Text,
  i: Nat,
  n: Nat,
  m: Nat,
  s3: Nat,
  s2: Nat,
  j: Nat,
  qm: m = Zero,
  w: scan_walk(m, t, text, s3, scan_after(text, i), n) = Some(Pair { fst: s2, snd: j })
): Nat::le(j, scan_after(text, i)) = true {
  Eq::subst(
    (z: Nat) => Nat::le(z, scan_after(text, i)) = true,
    Eq::congr(
      scan_pair_snd,
      scan_some_inj(
        Pair { fst: s3, snd: scan_after(text, i) },
        Pair { fst: s2, snd: j },
        Eq::subst(
          (z: Nat) => scan_walk(z, t, text, s3, scan_after(text, i), n) = Some(Pair { fst: s2, snd: j }),
          qm,
          w
        )
      )
    ),
    Nat::le_refl(scan_after(text, i))
  )
}

// A run of `m + 1` characters (fewer than `k`) to a state that accepts is
// no longer than what `scan_find_in` gives.
pub theorem scan_find_in_longest(
  k: Nat,
  t: ScanTables,
  text: Text,
  state: Nat,
  i: Nat,
  n: Nat,
  best: Option(Pair(Nat, Nat)),
  m: Nat,
  s2: Nat,
  j: Nat,
  tok: Nat,
  lt: (m < k) = true,
  w: scan_walk(Succ(m), t, text, state, i, n) = Some(Pair { fst: s2, snd: j }),
  a: scan_accept(t, text, s2, j, n) = Some(tok)
): scan_at_least(j, scan_find_in(k, t, text, state, i, n, best)) {
  match k: scan_at_least(j, scan_find_in(k, t, text, state, i, n, best)) {
    Zero => False::elim(false_ne_true(Eq::trans(Eq::sym(Nat::lt_zero_false(m)), lt)))
    Succ(k2) => Bool::cases(
      (c: Bool) => scan_at_least(j, scan_find_cmp(k2, t, text, state, i, n, best, c)),
      i < n,
      (q: (i < n) = false) => False::elim(
        scan_none_ne_some(
          Pair { fst: s2, snd: j },
          Eq::subst(
            (c: Bool) => scan_walk_in(m, t, text, state, i, n, c) = Some(Pair { fst: s2, snd: j }),
            q,
            w
          )
        )
      ),
      (q: (i < n) = true) => scan_nat_cases(
        (x: Nat) => scan_at_least(j, scan_find_next(k2, t, text, i, n, best, x)),
        scan_next(t, text, state, i),
        (qz: scan_next(t, text, state, i) = Zero) => False::elim(
          scan_none_ne_some(
            Pair { fst: s2, snd: j },
            Eq::subst(
              (x: Nat) => scan_walk_next(m, t, text, i, n, x) = Some(Pair { fst: s2, snd: j }),
              qz,
              Eq::subst(
                (c: Bool) => scan_walk_in(m, t, text, state, i, n, c) = Some(Pair { fst: s2, snd: j }),
                q,
                w
              )
            )
          )
        ),
        (s3: Nat) => (qs: scan_next(t, text, state, i) = Succ(s3)) => scan_nat_cases(
          (z: Nat) => scan_at_least(
            j,
            scan_find_in(
              k2,
              t,
              text,
              s3,
              scan_after(text, i),
              n,
              scan_find_upd(
                best,
                scan_after(text, i),
                scan_accept(t, text, s3, scan_after(text, i), n)
              )
            )
          ),
          m,
          (qm: m = Zero) => Eq::subst(
            (o: Option(Nat)) => scan_at_least(
              j,
              scan_find_in(
                k2,
                t,
                text,
                s3,
                scan_after(text, i),
                n,
                scan_find_upd(best, scan_after(text, i), o)
              )
            ),
            Eq::sym(
              Eq::subst(
                (p: Pair(Nat, Nat)) => scan_accept_at(t, text, n, p) = Some(tok),
                Eq::sym(
                  scan_some_inj(
                    Pair { fst: s3, snd: scan_after(text, i) },
                    Pair { fst: s2, snd: j },
                    Eq::subst(
                      (z: Nat) => scan_walk(z, t, text, s3, scan_after(text, i), n) = Some(Pair { fst: s2, snd: j }),
                      qm,
                      Eq::subst(
                        (x: Nat) => scan_walk_next(m, t, text, i, n, x) = Some(Pair { fst: s2, snd: j }),
                        qs,
                        Eq::subst(
                          (c: Bool) => scan_walk_in(m, t, text, state, i, n, c) = Some(Pair { fst: s2, snd: j }),
                          q,
                          w
                        )
                      )
                    )
                  )
                ),
                a
              )
            ),
            scan_find_in_mono(
              k2,
              t,
              text,
              s3,
              scan_after(text, i),
              n,
              Some(Pair { fst: scan_after(text, i), snd: tok }),
              j,
              scan_le_at(
                t,
                text,
                i,
                n,
                m,
                s3,
                s2,
                j,
                qm,
                Eq::subst(
                  (x: Nat) => scan_walk_next(m, t, text, i, n, x) = Some(Pair { fst: s2, snd: j }),
                  qs,
                  Eq::subst(
                    (c: Bool) => scan_walk_in(m, t, text, state, i, n, c) = Some(Pair { fst: s2, snd: j }),
                    q,
                    w
                  )
                )
              ),
              scan_le_at(
                t,
                text,
                i,
                n,
                m,
                s3,
                s2,
                j,
                qm,
                Eq::subst(
                  (x: Nat) => scan_walk_next(m, t, text, i, n, x) = Some(Pair { fst: s2, snd: j }),
                  qs,
                  Eq::subst(
                    (c: Bool) => scan_walk_in(m, t, text, state, i, n, c) = Some(Pair { fst: s2, snd: j }),
                    q,
                    w
                  )
                )
              )
            )
          ),
          (m2: Nat) => (qm: m = Succ(m2)) => scan_find_in_longest(
            k2,
            t,
            text,
            s3,
            scan_after(text, i),
            n,
            scan_find_upd(
              best,
              scan_after(text, i),
              scan_accept(t, text, s3, scan_after(text, i), n)
            ),
            m2,
            s2,
            j,
            tok,
            Eq::subst((z: Nat) => (z < Succ(k2)) = true, qm, lt),
            Eq::subst(
              (z: Nat) => scan_walk(z, t, text, s3, scan_after(text, i), n) = Some(Pair { fst: s2, snd: j }),
              qm,
              Eq::subst(
                (x: Nat) => scan_walk_next(m, t, text, i, n, x) = Some(Pair { fst: s2, snd: j }),
                qs,
                Eq::subst(
                  (c: Bool) => scan_walk_in(m, t, text, state, i, n, c) = Some(Pair { fst: s2, snd: j }),
                  q,
                  w
                )
              )
            ),
            a
          )
        )
      )
    )
  }
}

// ---- what `scan_find_in` gives is a token of a run --------------------------

// From `s` at byte `i`, a run of a character at least reaches the state
// `s2` at byte `e`, and an accept entry of `s2` for `tok` holds there.
pub(open) inductive ScanHit(
  t: ScanTables,
  tx: Text,
  n: Nat,
  s: Nat,
  i: Nat,
  e: Nat,
  tok: Nat
): Prop {
  Mk(
    m: Nat,
    s2: Nat,
    w: scan_walk(Succ(m), t, tx, s, i, n) = Some(Pair { fst: s2, snd: e }),
    a: scan_accept(t, tx, s2, e, n) = Some(tok)
  ): ScanHit(t, tx, n, s, i, e, tok)
}

// No result, or a token of a run from `s0` at `i0`.
pub fn scan_ok(
  t: ScanTables,
  text: Text,
  n: Nat,
  s0: Nat,
  i0: Nat,
  r: Option(Pair(Nat, Nat))
): Prop {
  match r: Prop {
    None => True
    Some(p) => match p: Prop {
      Pair { fst: e, snd: tok } => ScanHit(t, text, n, s0, i0, e, tok)
    }
  }
}

pub fn scan_walk_at(
  m: Nat,
  t: ScanTables,
  text: Text,
  n: Nat,
  p: Pair(Nat, Nat)
): Option(Pair(Nat, Nat)) {
  match p: Option(Pair(Nat, Nat)) {
    Pair { fst: s, snd: i } => scan_walk(m, t, text, s, i, n)
  }
}

pub theorem scan_walk_one(
  t: ScanTables,
  text: Text,
  s: Nat,
  i: Nat,
  n: Nat,
  s2: Nat,
  q: (i < n) = true,
  qs: scan_next(t, text, s, i) = Succ(s2)
): scan_walk(1, t, text, s, i, n) = Some(Pair { fst: s2, snd: scan_after(text, i) }) {
  Eq::subst(
    (c: Bool) => scan_walk_in(0, t, text, s, i, n, c) = Some(Pair { fst: s2, snd: scan_after(text, i) }),
    Eq::sym(q),
    Eq::subst(
      (x: Nat) => scan_walk_next(0, t, text, i, n, x) = Some(Pair { fst: s2, snd: scan_after(text, i) }),
      Eq::sym(qs),
      Refl
    )
  )
}

// A run one character longer.
pub theorem scan_walk_snoc(
  m: Nat,
  t: ScanTables,
  text: Text,
  s0: Nat,
  i0: Nat,
  n: Nat,
  s: Nat,
  i: Nat,
  s2: Nat,
  wm: scan_walk(m, t, text, s0, i0, n) = Some(Pair { fst: s, snd: i }),
  q: (i < n) = true,
  qs: scan_next(t, text, s, i) = Succ(s2)
): scan_walk(Succ(m), t, text, s0, i0, n) = Some(Pair { fst: s2, snd: scan_after(text, i) }) {
  match m: scan_walk(Succ(m), t, text, s0, i0, n) = Some(Pair { fst: s2, snd: scan_after(text, i) }) {
    Zero => Eq::subst(
      (p: Pair(Nat, Nat)) => scan_walk_at(1, t, text, n, p) = Some(Pair { fst: s2, snd: scan_after(text, i) }),
      Eq::sym(scan_some_inj(Pair { fst: s0, snd: i0 }, Pair { fst: s, snd: i }, wm)),
      scan_walk_one(t, text, s, i, n, s2, q, qs)
    )
    Succ(m2) => Bool::cases(
      (c: Bool) => scan_walk_in(Succ(m2), t, text, s0, i0, n, c) = Some(Pair { fst: s2, snd: scan_after(text, i) }),
      i0 < n,
      (q0: (i0 < n) = false) => False::elim(
        scan_none_ne_some(
          Pair { fst: s, snd: i },
          Eq::subst(
            (c: Bool) => scan_walk_in(m2, t, text, s0, i0, n, c) = Some(Pair { fst: s, snd: i }),
            q0,
            wm
          )
        )
      ),
      (q0: (i0 < n) = true) => scan_nat_cases(
        (x: Nat) => scan_walk_next(Succ(m2), t, text, i0, n, x) = Some(Pair { fst: s2, snd: scan_after(text, i) }),
        scan_next(t, text, s0, i0),
        (qz: scan_next(t, text, s0, i0) = Zero) => False::elim(
          scan_none_ne_some(
            Pair { fst: s, snd: i },
            Eq::subst(
              (x: Nat) => scan_walk_next(m2, t, text, i0, n, x) = Some(Pair { fst: s, snd: i }),
              qz,
              Eq::subst(
                (c: Bool) => scan_walk_in(m2, t, text, s0, i0, n, c) = Some(Pair { fst: s, snd: i }),
                q0,
                wm
              )
            )
          )
        ),
        (s1: Nat) => (q1: scan_next(t, text, s0, i0) = Succ(s1)) => scan_walk_snoc(
          m2,
          t,
          text,
          s1,
          scan_after(text, i0),
          n,
          s,
          i,
          s2,
          Eq::subst(
            (x: Nat) => scan_walk_next(m2, t, text, i0, n, x) = Some(Pair { fst: s, snd: i }),
            q1,
            Eq::subst(
              (c: Bool) => scan_walk_in(m2, t, text, s0, i0, n, c) = Some(Pair { fst: s, snd: i }),
              q0,
              wm
            )
          ),
          q,
          qs
        )
      )
    )
  }
}

// Started after a run of `m0` characters from `s0` at `i0`, `scan_find_in`
// gives no token or a token of a run from there.
pub theorem scan_find_in_sound(
  k: Nat,
  t: ScanTables,
  text: Text,
  state: Nat,
  i: Nat,
  n: Nat,
  best: Option(Pair(Nat, Nat)),
  s0: Nat,
  i0: Nat,
  m0: Nat,
  wm: scan_walk(m0, t, text, s0, i0, n) = Some(Pair { fst: state, snd: i }),
  hb: scan_ok(t, text, n, s0, i0, best)
): scan_ok(t, text, n, s0, i0, scan_find_in(k, t, text, state, i, n, best)) {
  match k: scan_ok(t, text, n, s0, i0, scan_find_in(k, t, text, state, i, n, best)) {
    Zero => hb
    Succ(k2) => Bool::cases(
      (c: Bool) => scan_ok(t, text, n, s0, i0, scan_find_cmp(k2, t, text, state, i, n, best, c)),
      i < n,
      (q: (i < n) = false) => hb,
      (q: (i < n) = true) => scan_nat_cases(
        (x: Nat) => scan_ok(t, text, n, s0, i0, scan_find_next(k2, t, text, i, n, best, x)),
        scan_next(t, text, state, i),
        (qz: scan_next(t, text, state, i) = Zero) => hb,
        (s2: Nat) => (qs: scan_next(t, text, state, i) = Succ(s2)) => scan_option_cases(
          (o: Option(Nat)) => scan_ok(
            t,
            text,
            n,
            s0,
            i0,
            scan_find_in(
              k2,
              t,
              text,
              s2,
              scan_after(text, i),
              n,
              scan_find_upd(best, scan_after(text, i), o)
            )
          ),
          scan_accept(t, text, s2, scan_after(text, i), n),
          (
            qa: scan_accept(t, text, s2, scan_after(text, i), n) = None
          ) => scan_find_in_sound(
            k2,
            t,
            text,
            s2,
            scan_after(text, i),
            n,
            best,
            s0,
            i0,
            Succ(m0),
            scan_walk_snoc(m0, t, text, s0, i0, n, state, i, s2, wm, q, qs),
            hb
          ),
          (tok: Nat) => (
            qa: scan_accept(t, text, s2, scan_after(text, i), n) = Some(tok)
          ) => scan_find_in_sound(
            k2,
            t,
            text,
            s2,
            scan_after(text, i),
            n,
            Some(Pair { fst: scan_after(text, i), snd: tok }),
            s0,
            i0,
            Succ(m0),
            scan_walk_snoc(m0, t, text, s0, i0, n, state, i, s2, wm, q, qs),
            ScanHit::Mk(m0, s2, scan_walk_snoc(m0, t, text, s0, i0, n, state, i, s2, wm, q, qs), qa)
          )
        )
      )
    )
  }
}

// ---- a run fits in the text -------------------------------------------------

pub theorem scan_lt_pred(
  a: Nat,
  x: Nat,
  h: Nat::lt(Succ(a), x) = true
): Nat::lt(a, Nat::pred(x)) = true {
  match x: Nat::lt(a, Nat::pred(x)) = true {
    Zero => False::elim(false_ne_true(Eq::trans(Eq::sym(Nat::lt_zero_false(Succ(a))), h)))
    Succ(x2) => h
  }
}

// `a + i < n` is `a < n - i`.
pub theorem scan_lt_sub(
  i: Nat,
  a: Nat,
  n: Nat,
  h: Nat::lt(Nat::add(a, i), n) = true
): Nat::lt(a, Nat::sub(n, i)) = true {
  match i: Nat::lt(a, Nat::sub(n, i)) = true {
    Zero => h
    Succ(i2) => scan_lt_pred(
      a,
      Nat::sub(n, i2),
      scan_lt_sub(
        i2,
        Succ(a),
        n,
        Eq::subst((z: Nat) => Nat::lt(z, n) = true, Eq::sym(Nat::add_succ_left(a, i2)), h)
      )
    )
  }
}

pub theorem scan_le_add_mono(
  a: Nat,
  b: Nat,
  c: Nat,
  h: Nat::le(a, b) = true
): Nat::le(Nat::add(a, c), Nat::add(b, c)) = true {
  match c: Nat::le(Nat::add(a, c), Nat::add(b, c)) = true {
    Zero => h
    Succ(c2) => scan_le_add_mono(a, b, c2, h)
  }
}

// A character is a byte at least.
pub fn scan_len_3(c: Bool): Nat {
  match c: Nat {
    true => 3
    false => 4
  }
}

pub fn scan_len_2(first: Nat, c: Bool): Nat {
  match c: Nat {
    true => 2
    false => scan_len_3(first < 240)
  }
}

pub fn scan_len_1(first: Nat, c: Bool): Nat {
  match c: Nat {
    true => 1
    false => scan_len_2(first, first < 224)
  }
}

pub theorem scan_len_3_pos(c: Bool): Nat::lt(0, scan_len_3(c)) = true {
  match c: Nat::lt(0, scan_len_3(c)) = true {
    true => Refl
    false => Refl
  }
}

pub theorem scan_len_2_pos(first: Nat, c: Bool): Nat::lt(0, scan_len_2(first, c)) = true {
  match c: Nat::lt(0, scan_len_2(first, c)) = true {
    true => Refl
    false => scan_len_3_pos(first < 240)
  }
}

pub theorem scan_len_1_pos(first: Nat, c: Bool): Nat::lt(0, scan_len_1(first, c)) = true {
  match c: Nat::lt(0, scan_len_1(first, c)) = true {
    true => Refl
    false => scan_len_2_pos(first, first < 224)
  }
}

pub theorem scan_le_add_pos(
  i: Nat,
  x: Nat,
  h: Nat::lt(0, x) = true
): Nat::le(Succ(i), Nat::add(i, x)) = true {
  match x: Nat::le(Succ(i), Nat::add(i, x)) = true {
    Zero => False::elim(false_ne_true(h))
    Succ(p) => scan_le_add(i, p)
  }
}

pub theorem scan_lt_after(text: Text, i: Nat): Nat::le(Succ(i), scan_after(text, i)) = true {
  scan_le_add_pos(
    i,
    scan_char_length(Text::byte_value(text, i)),
    scan_len_1_pos(Text::byte_value(text, i), Text::byte_value(text, i) < 128)
  )
}

pub theorem scan_walk_lt(
  m: Nat,
  t: ScanTables,
  text: Text,
  s: Nat,
  i: Nat,
  n: Nat,
  r: Pair(Nat, Nat),
  w: scan_walk(Succ(m), t, text, s, i, n) = Some(r)
): (i < n) = true {
  Bool::cases(
    (c: Bool) => c = true,
    i < n,
    (q: (i < n) = false) => False::elim(
      scan_none_ne_some(
        r,
        Eq::subst(
          (c: Bool) => scan_walk_in(m, t, text, s, i, n, c) = Some(r),
          q,
          w
        )
      )
    ),
    (q: (i < n) = true) => Refl
  )
}

// A run of `m + 1` characters from byte `i` has `i + m < n`.
pub theorem scan_walk_bound(
  m: Nat,
  t: ScanTables,
  text: Text,
  s: Nat,
  i: Nat,
  n: Nat,
  r: Pair(Nat, Nat),
  w: scan_walk(Succ(m), t, text, s, i, n) = Some(r)
): Nat::lt(Nat::add(i, m), n) = true {
  match m: Nat::lt(Nat::add(i, m), n) = true {
    Zero => scan_walk_lt(Zero, t, text, s, i, n, r, w)
    Succ(m2) => scan_nat_cases(
      (x: Nat) => Nat::lt(Nat::add(i, Succ(m2)), n) = true,
      scan_next(t, text, s, i),
      (qz: scan_next(t, text, s, i) = Zero) => False::elim(
        scan_none_ne_some(
          r,
          Eq::subst(
            (x: Nat) => scan_walk_next(Succ(m2), t, text, i, n, x) = Some(r),
            qz,
            Eq::subst(
              (c: Bool) => scan_walk_in(Succ(m2), t, text, s, i, n, c) = Some(r),
              scan_walk_lt(Succ(m2), t, text, s, i, n, r, w),
              w
            )
          )
        )
      ),
      (s1: Nat) => (q1: scan_next(t, text, s, i) = Succ(s1)) => Nat::le_trans(
        Succ(Succ(Nat::add(i, m2))),
        Succ(Nat::add(scan_after(text, i), m2)),
        n,
        Eq::subst(
          (z: Nat) => Nat::le(z, Nat::add(scan_after(text, i), m2)) = true,
          Nat::add_succ_left(i, m2),
          scan_le_add_mono(Succ(i), scan_after(text, i), m2, scan_lt_after(text, i))
        ),
        scan_walk_bound(
          m2,
          t,
          text,
          s1,
          scan_after(text, i),
          n,
          r,
          Eq::subst(
            (x: Nat) => scan_walk_next(Succ(m2), t, text, i, n, x) = Some(r),
            q1,
            Eq::subst(
              (c: Bool) => scan_walk_in(Succ(m2), t, text, s, i, n, c) = Some(r),
              scan_walk_lt(Succ(m2), t, text, s, i, n, r, w),
              w
            )
          )
        )
      )
    )
  }
}

// ---- the theorems -----------------------------------------------------------

// The first state of the automaton `dfa`.
pub fn scan_start(t: ScanTables, dfa: Nat): Nat {
  scan_number(t.dfa_first, dfa)
}

// A token `scan_find` gives is a token of a run of the automaton `dfa` from
// `pos`.
pub theorem scan_find_sound(
  t: ScanTables,
  text: Text,
  dfa: Nat,
  pos: Nat,
  n: Nat,
  e: Nat,
  tok: Nat,
  h: scan_find(t, text, dfa, pos, n) = Some(Pair { fst: e, snd: tok })
): ScanHit(t, text, n, scan_start(t, dfa), pos, e, tok) {
  Eq::subst(
    (r: Option(Pair(Nat, Nat))) => scan_ok(t, text, n, scan_start(t, dfa), pos, r),
    h,
    scan_find_in_sound(
      Nat::sub(n, pos),
      t,
      text,
      scan_start(t, dfa),
      pos,
      n,
      None,
      scan_start(t, dfa),
      pos,
      0,
      Refl,
      Trivial
    )
  )
}

// A run of `Succ(m)` characters from `pos` stays below `n`, and so `m` is below the fuel `n - pos`.
pub theorem scan_walk_bound_comm(
  t: ScanTables,
  text: Text,
  s: Nat,
  pos: Nat,
  n: Nat,
  m: Nat,
  r: Pair(Nat, Nat),
  w: scan_walk(Succ(m), t, text, s, pos, n) = Some(r)
): Nat::lt(Nat::add(m, pos), n) = true {
  Eq::subst(
    (z: Nat) => Nat::lt(z, n) = true,
    Nat::add_comm(pos, m),
    scan_walk_bound(m, t, text, s, pos, n, r, w)
  )
}

// Every token of a run of the automaton `dfa` from `pos` ends no later than
// what `scan_find` gives (so it gives one).
pub theorem scan_find_longest(
  t: ScanTables,
  text: Text,
  dfa: Nat,
  pos: Nat,
  n: Nat,
  m: Nat,
  s2: Nat,
  j: Nat,
  tok: Nat,
  w: scan_walk(Succ(m), t, text, scan_start(t, dfa), pos, n) = Some(Pair { fst: s2, snd: j }),
  a: scan_accept(t, text, s2, j, n) = Some(tok)
): scan_at_least(j, scan_find(t, text, dfa, pos, n)) {
  scan_find_in_longest(
    Nat::sub(n, pos),
    t,
    text,
    scan_start(t, dfa),
    pos,
    n,
    None,
    m,
    s2,
    j,
    tok,
    scan_lt_sub(
      pos,
      m,
      n,
      scan_walk_bound_comm(t, text, scan_start(t, dfa), pos, n, m, Pair { fst: s2, snd: j }, w)
    ),
    w,
    a
  )
}
