// `tauto doc`: a highlighted page for each source file, its uses of names
// linked to the declarations, and an index of the files and their
// declarations.
package {
  name = "doc"
  version = "0.1.0"
}

dependencies {
  highlight { path = "../highlight" }
  names { path = "../names" }
  surface { path = "../surface" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}
