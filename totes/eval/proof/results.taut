import "../src/eval.taut"
import "../src/value.taut"
import "../../vm/src/builtins.taut"
import "../../vm/src/cps.taut"
import "../../vm/src/mval.taut"
import "../../vm/src/operations.taut"

pub(open) inductive EBindValue(
  A: Type,
  B: Type,
  r: EResult(A),
  next: (A, MCx) -> EResult(B),
  w: B,
  final: MCx
): Prop {
  Ebv(
    v: A,
    heap: MCx,
    first: r = ErValue(v, heap),
    second: next(v, heap) = ErValue(w, final)
  ): EBindValue(A, B, r, next, w, final)
}

pub theorem e_bind_value<A, B>(
  r: EResult(A),
  next: (A, MCx) -> EResult(B),
  w: B,
  final: MCx,
  done: e_bind(r, next) = ErValue(w, final)
): EBindValue(A, B, r, next, w, final) {
  match r {
    ErValue(v, heap) => Ebv(v, heap, Refl, done)
    ErError(message) => ⊢ EBindValue(A, B, ErError(message), next, w, final) from match done {}
    ErFuel => ⊢ EBindValue(A, B, ErFuel, next, w, final) from match done {}
    ErUnsupported(construct) => ⊢ EBindValue(
      A,
      B,
      ErUnsupported(construct),
      next,
      w,
      final
    ) from match done {}
  }
}

pub theorem e_primitive_value(
  out: MOut,
  v: MVal,
  cx: MCx,
  done: e_primitive_out(out) = ErValue(v, cx)
): out = MoutVal(v, cx) {
  match out {
    MoutVal(w, heap) => ⊢ Eq(MOut, MoutVal(w, heap), MoutVal(v, cx)) from match done {
      Refl => ⊢ Eq(MOut, MoutVal(w, heap), MoutVal(w, heap)) from Refl
    }
    MoutErr(message) => ⊢ Eq(MOut, MoutErr(message), MoutVal(v, cx)) from match done {}
    MoutExit(code) => ⊢ Eq(MOut, MoutExit(code), MoutVal(v, cx)) from match done {}
    MoutAsk(name, args, heap) => ⊢ Eq(MOut, MoutAsk(name, args, heap), MoutVal(v, cx)) from match done {}
    MoutPerform(op) => ⊢ Eq(MOut, MoutPerform(op), MoutVal(v, cx)) from match done {}
    MoutSpawn(fnval, pid, heap) => ⊢ Eq(
      MOut,
      MoutSpawn(fnval, pid, heap),
      MoutVal(v, cx)
    ) from match done {}
    MoutYield(pid, heap) => ⊢ Eq(MOut, MoutYield(pid, heap), MoutVal(v, cx)) from match done {}
  }
}

pub theorem e_unary_arity(op: CUnary): m_op_arity(e_unary(op)) = 1 {
  match op {
    CuNot => Refl
    CuMember(i) => Refl
    CuField(path) => Refl
    CuShown => Refl
    CuTempRef => Refl
    CuDeref => Refl
    CuInject(union, variant) => Refl
    CuRemap(to, table) => Refl
  }
}
