package {
  name = "syntaxgen"
  version = "0.1.0"
}

dependencies {
  text { path = "../text" }
  parlex { path = "../parlex" }
  pargen { path = "../pargen" }
  llkgen { path = "../llkgen" }
  lalrgen { path = "../lalrgen" }
}

// The Rust side runs the tote only through `generated::run`, so it calls no
// function by name; the others stay internal to the tote.
rust {
  exports = []
}
