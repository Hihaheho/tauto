import "core.taut" { RsAddress, RsBorrow, RsLiteral, RsPattern, RsStore, RsUse, RsValue }
import "store.taut" { rs_alloc, rs_can_copy, rs_load, rs_peek, rs_reference_kind, rs_save }
import "../../../std/Base.taut" { List }
import "../../../std/Int.taut" { Int }
import "../../../std/Text.taut" { Text }

pub fn rs_literal_eq(a: RsLiteral, b: RsLiteral): Bool {
  ⊢ Bool from match a {
    RsStr(x) => ⊢ Bool from match b {
      RsStr(y) => Text::eq(x, y)
      RsNatural(y) => false
      RsUnit => false
      RsBool(y) => false
      RsInteger(y, s, w) => false
      RsText(y) => false
      RsFloat(y, s) => false
    }
    RsNatural(x) => false
    RsUnit => ⊢ Bool from match b {
      RsStr(y) => false
      RsNatural(y) => false
      RsUnit => true
      RsBool(y) => false
      RsInteger(y, s, w) => false
      RsText(y) => false
      RsFloat(y, s) => false
    }
    RsBool(x) => ⊢ Bool from match b {
      RsStr(y) => false
      RsNatural(y) => false
      RsUnit => false
      RsBool(y) => Bool::eq(x, y)
      RsInteger(y, s, w) => false
      RsText(y) => false
      RsFloat(y, s) => false
    }
    RsInteger(x, sx, wx) => ⊢ Bool from match b {
      RsStr(y) => false
      RsNatural(y) => false
      RsUnit => false
      RsBool(y) => false
      RsInteger(y, sy, wy) => Int::eq(x, y) && Bool::eq(sx, sy) && Nat::eq(wx, wy)
      RsText(y) => false
      RsFloat(y, s) => false
    }
    RsText(x) => ⊢ Bool from match b {
      RsStr(y) => false
      RsNatural(y) => false
      RsUnit => false
      RsBool(y) => false
      RsInteger(y, s, w) => false
      RsText(y) => Text::eq(x, y)
      RsFloat(y, s) => false
    }
    RsFloat(x, sx) => ⊢ Bool from match b {
      RsStr(y) => false
      RsNatural(y) => false
      RsUnit => false
      RsBool(y) => false
      RsInteger(y, s, w) => false
      RsText(y) => false
      RsFloat(y, sy) => Nat::eq(x, y) && Bool::eq(sx, sy)
    }
  }
}

pub fn rs_scalar_eq(lit: RsLiteral, value: RsValue): Bool {
  ⊢ Bool from match value {
    RsScalar(other) => rs_literal_eq(lit, other)
    RsData(tag, is_copy, fields) => false
    RsReference(kind, address) => false
    RsGlobal(index) => false
    RsClosure(kind, arity, captures, body) => false
    RsSuspended(captures, body) => false
    RsHandle(index) => false
    RsUninitialized => false
  }
}

pub(open) inductive RsMatchMode: Type {
  RsPreview: RsMatchMode
  RsCommit: RsMatchMode
}

pub fn rs_pattern_move(mode: RsMatchMode, heap: RsStore, addr: RsAddress): Option(RsStore) {
  ⊢ Option(RsStore) from match mode {
    RsPreview => Some(heap)
    RsCommit => rs_save(heap, addr, RsUninitialized)
  }
}

pub fn rs_child_address(addr: RsAddress, field: Nat): RsAddress {
  ⊢ RsAddress from match addr {
    RsAddr(root, fields) => RsAddr(root, List::append(fields, Cons(field, Nil)))
  }
}

pub fn rs_match_leaf(
  mode: RsMatchMode,
  heap: RsStore,
  pattern: RsPattern,
  addr: RsAddress
): Option(List(RsValue) × RsStore) {
  ⊢ Option(List(RsValue) × RsStore) from match pattern {
    RsIgnore => ⊢ Option(List(RsValue) × RsStore) from match rs_peek(heap, addr) {
      None => None
      Some(value) => Some(#(Nil, heap))
    }
    RsBind(kind) => ⊢ Option(List(RsValue) × RsStore) from match rs_load(heap, addr) {
      None => None
      Some(value) => ⊢ Option(List(RsValue) × RsStore) from match kind {
        RsCopy => if rs_can_copy(value) { Some(#(Cons(value, Nil), heap)) } else { None }
        RsMove => ⊢ Option(List(RsValue) × RsStore) from match rs_pattern_move(mode, heap, addr) {
          None => None
          Some(next) => Some(#(Cons(value, Nil), next))
        }
      }
    }
    RsBindReference(kind) => ⊢ Option(List(RsValue) × RsStore) from match rs_load(heap, addr) {
      None => None
      Some(value) => Some(#(Cons(RsReference(kind, addr), Nil), heap))
    }
    RsConstant(lit) => ⊢ Option(List(RsValue) × RsStore) from match rs_load(heap, addr) {
      None => None
      Some(value) => if rs_scalar_eq(lit, value) { Some(#(Nil, heap)) } else { None }
    }
    RsConstructor(tag, pats) => None
    RsDerefPattern(kind, body) => None
  }
}

// Preview bindings are loans used only by the guard. Commit records each
// move at its source, leaving ignored fields for the scrutinee's destruction.
mutual {
  pub fn rs_match_at(
    mode: RsMatchMode,
    heap: RsStore,
    pattern: RsPattern,
    addr: RsAddress
  ): Option(List(RsValue) × RsStore) {
    ⊢ Option(List(RsValue) × RsStore) from match pattern {
      RsDerefPattern(kind, body) => ⊢ Option(List(RsValue) × RsStore) from match rs_load(heap, addr) {
        None => None
        Some(value) => ⊢ Option(List(RsValue) × RsStore) from match rs_reference_kind(kind, value) {
          None => None
          Some(target) => rs_match_at(mode, heap, body, target)
        }
      }
      RsIgnore => rs_match_leaf(mode, heap, RsIgnore, addr)
      RsBind(kind) => rs_match_leaf(mode, heap, RsBind(kind), addr)
      RsBindReference(kind) => rs_match_leaf(mode, heap, RsBindReference(kind), addr)
      RsConstant(lit) => rs_match_leaf(mode, heap, RsConstant(lit), addr)
      RsConstructor(tag, pats) => ⊢ Option(List(RsValue) × RsStore) from match rs_peek(heap, addr) {
        None => None
        Some(value) => ⊢ Option(List(RsValue) × RsStore) from match value {
          RsData(other, is_copy, fields) => if Nat::eq(
            tag,
            other
          ) && Nat::eq(List::length(pats), List::length(fields)) {
            rs_match_fields_at(mode, heap, pats, addr, 0)
          } else { None }
          RsScalar(lit) => None
          RsReference(kind, target) => None
          RsGlobal(index) => None
          RsClosure(kind, arity, captures, body) => None
          RsSuspended(captures, body) => None
          RsHandle(index) => None
          RsUninitialized => None
        }
      }
    }
  }
  pub fn rs_match_fields_at(
    mode: RsMatchMode,
    heap: RsStore,
    pats: List(RsPattern),
    addr: RsAddress,
    index: Nat
  ): Option(List(RsValue) × RsStore) {
    ⊢ Option(List(RsValue) × RsStore) from match pats {
      Nil => Some(#(Nil, heap))
      Cons(pat, rest) => ⊢ Option(List(RsValue) × RsStore) from match rs_match_at(
        mode,
        heap,
        pat,
        rs_child_address(addr, index)
      ) {
        None => None
        Some(#(bindings, h1)) => ⊢ Option(List(RsValue) × RsStore) from match rs_match_fields_at(
          mode,
          h1,
          rest,
          addr,
          Succ(index)
        ) {
          None => None
          Some(#(trailing, h2)) => Some(#(List::append(bindings, trailing), h2))
        }
      }
    }
  }
}

pub(open) inductive RsGuardBinding: Type {
  RsGuardView(address: RsAddress): RsGuardBinding
  RsGuardReference(kind: RsBorrow, address: RsAddress): RsGuardBinding
}

pub(open) inductive RsGuardScope: Type {
  RsGuardScopeOf(bindings: List(RsAddress), temporaries: List(Nat), store: RsStore): RsGuardScope
}

pub fn rs_guard_leaf(
  heap: RsStore,
  pattern: RsPattern,
  addr: RsAddress
): Option(List(RsGuardBinding)) {
  ⊢ Option(List(RsGuardBinding)) from match rs_match_leaf(RsPreview, heap, pattern, addr) {
    None => None
    Some(ignored) => ⊢ Option(List(RsGuardBinding)) from match pattern {
      RsIgnore => Some(Nil)
      RsConstant(lit) => Some(Nil)
      RsBind(mode) => Some(Cons(RsGuardView(addr), Nil))
      RsBindReference(kind) => Some(Cons(RsGuardReference(kind, addr), Nil))
      RsConstructor(tag, fields) => None
      RsDerefPattern(kind, body) => None
    }
  }
}

mutual {
  pub fn rs_guard_plan(
    heap: RsStore,
    pattern: RsPattern,
    addr: RsAddress
  ): Option(List(RsGuardBinding)) {
    ⊢ Option(List(RsGuardBinding)) from match pattern {
      RsIgnore => rs_guard_leaf(heap, RsIgnore, addr)
      RsConstant(lit) => rs_guard_leaf(heap, RsConstant(lit), addr)
      RsBind(mode) => rs_guard_leaf(heap, RsBind(mode), addr)
      RsBindReference(kind) => rs_guard_leaf(heap, RsBindReference(kind), addr)
      RsDerefPattern(kind, body) => ⊢ Option(List(RsGuardBinding)) from match rs_load(heap, addr) {
        None => None
        Some(value) => ⊢ Option(List(RsGuardBinding)) from match rs_reference_kind(kind, value) {
          None => None
          Some(target) => rs_guard_plan(heap, body, target)
        }
      }
      RsConstructor(tag, patterns) => ⊢ Option(List(RsGuardBinding)) from match rs_peek(heap, addr) {
        None => None
        Some(value) => ⊢ Option(List(RsGuardBinding)) from match value {
          RsData(other, is_copy, fields) => if Nat::eq(
            tag,
            other
          ) && Nat::eq(List::length(patterns), List::length(fields)) {
            rs_guard_fields(heap, patterns, addr, 0)
          } else { None }
          RsScalar(lit) => None
          RsReference(kind, target) => None
          RsGlobal(index) => None
          RsClosure(kind, arity, captures, body) => None
          RsSuspended(captures, body) => None
          RsHandle(index) => None
          RsUninitialized => None
        }
      }
    }
  }
  pub fn rs_guard_fields(
    heap: RsStore,
    patterns: List(RsPattern),
    addr: RsAddress,
    index: Nat
  ): Option(List(RsGuardBinding)) {
    ⊢ Option(List(RsGuardBinding)) from match patterns {
      Nil => Some(Nil)
      Cons(pattern, rest) => ⊢ Option(List(RsGuardBinding)) from match rs_guard_plan(
        heap,
        pattern,
        rs_child_address(addr, index)
      ) {
        None => None
        Some(first) => ⊢ Option(List(RsGuardBinding)) from match rs_guard_fields(
          heap,
          rest,
          addr,
          Succ(index)
        ) {
          None => None
          Some(following) => Some(List::append(first, following))
        }
      }
    }
  }
}

pub fn rs_guard_install(heap: RsStore, bindings: List(RsGuardBinding)): RsGuardScope {
  ⊢ RsGuardScope from match bindings {
    Nil => RsGuardScopeOf(Nil, Nil, heap)
    Cons(binding, rest) => ⊢ RsGuardScope from match binding {
      RsGuardView(addr) => ⊢ RsGuardScope from match rs_guard_install(heap, rest) {
        RsGuardScopeOf(remaining, scratch, next) => RsGuardScopeOf(
          Cons(addr, remaining),
          scratch,
          next
        )
      }
      RsGuardReference(kind, addr) => ⊢ RsGuardScope from match rs_alloc(heap, RsReference(kind, addr)) {
        #(slot, h1) => ⊢ RsGuardScope from match rs_guard_install(h1, rest) {
          RsGuardScopeOf(remaining, scratch, next) => RsGuardScopeOf(
            Cons(RsAddr(slot, Nil), remaining),
            Cons(slot, scratch),
            next
          )
        }
      }
    }
  }
}

pub fn rs_guard_prepare(heap: RsStore, pattern: RsPattern, addr: RsAddress): Option(RsGuardScope) {
  ⊢ Option(RsGuardScope) from match rs_guard_plan(heap, pattern, addr) {
    None => None
    Some(bindings) => Some(rs_guard_install(heap, bindings))
  }
}
