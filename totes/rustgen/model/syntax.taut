import "../../../std/Text.taut" { Text }
import std::prelude::Macro { Syn, SynDiag, SynSpan, SynToken }

inductive_syntax!(rs, ```par
%start Program
%title "Rust generation model"
%grammar_type 'LALR(1)'
%%
Program: { Item };
Item: [ Derive ] [ KwPub ] Definition;
Definition: Function | Data | Alias;
Function: KwFn Name Generics '(' Params ')' '->' Ty Block;
Generics: [ '<' Generic { ',' Generic } [ ',' ] '>' ];
Generic: TypeGeneric | Life;
TypeGeneric: Name [ ':' Bound { '+' Bound } ];
Bound: TypePath | Life | CallableBound;
Params: [ Param { ',' Param } [ ',' ] ];
Param: [ KwMut ] Name ':' Ty;
Data: Struct | Enum | TupleStruct;
Struct: KwStruct Name Generics '{' NamedFields '}';
Enum: KwEnum Name Generics '{' Fields '}';
TupleStruct: KwStruct Name Generics '(' Types ')' ';';
NamedFields: [ NamedField { ',' NamedField } [ ',' ] ];
NamedField: [ KwPub ] Name ':' Ty;
Derive: '#[derive(Clone)]';
Fields: [ Variant { ',' Variant } [ ',' ] ];
Variant: Name [ '(' Types ')' ];
Alias: KwType Name Generics '=' Ty ';';
Ty: RefTy | TupleTy | CallableTy | TypePath | ArrayTy | SliceTy | NeverTy | FunctionTy | ForFunctionTy;
ArrayTy: '[' Ty ';' Number ']';
SliceTy: '[' Ty ']';
NeverTy: '!';
RefTy: '&' [ Life ] [ KwMut ] Ty;
TupleTy: '(' Types ')';
CallableTy: KwDyn [ ForBinder ] Callable '(' Types ')' '->' TupleTy { '+' Bound };
FunctionTy: KwFn '(' Types ')' '->' TupleTy;
ForFunctionTy: ForBinder FunctionTy;
ForBinder: KwFor '<' Life { ',' Life } [ ',' ] '>';
CallableBound: [ ForBinder ] Callable '(' Types ')' '->' TupleTy;
Callable: TraitFn | KwFnMut | KwFnOnce;
TypePath: Name { '::' Name } [ '<' TypeArgs '>' ];
TypeArgs: TypeArg { ',' TypeArg } [ ',' ];
TypeArg: Life | Ty;
Types: [ Ty { ',' Ty } [ ',' ] ];
Expr: Atom { Suffix };
Atom: Number | KwTrue | KwFalse | StringLit | Path | Group | Unit | Tuple | Binary | Unary | Borrow | Block | Conditional | Selection | Closure | Repetition | AsyncBlock | Cast | Record;
Path: Name { '::' Name } [ '::<' Types '>' ];
Group: '(' Expr ')';
Unit: '(' ')';
Tuple: '(' Expr ',' [ Expr { ',' Expr } [ ',' ] ] ')';
Binary: '(' Expr Op Expr ')';
Op: '+' | '-' | '*' | '/' | '%' | '==' | '!=' | '<' | '<=' | '>' | '>=' | '&&' | '||';
Unary: '(' UnaryOp Expr ')';
UnaryOp: '!' | '-' | '*';
Borrow: '(' '&' [ KwMut ] Expr ')';
Suffix: Arguments | Member | Await;
Arguments: '(' [ Expr { ',' Expr } [ ',' ] ] ')';
Member: '.' Field;
Field: Name | Number;
Await: '.' KwAwait;
Cast: '(' Expr KwAs Ty ')';
Block: '{' { Statement } [ Expr ] '}';
Statement: Binding | Write | Discard | Return | Break | Continue | While;
Binding: KwLet [ KwMut ] Name [ ':' Ty ] '=' Expr ';';
Write: Expr '=' Expr ';';
Discard: Expr ';';
Return: KwReturn Expr ';';
Break: KwBreak [ Life ] '(' Expr ')' ';';
Continue: KwContinue [ Life ] ';';
While: KwWhile '(' Expr ')' Block;
Record: '(' Path '{' Initializers '}' ')';
Initializers: [ Initializer { ',' Initializer } [ ',' ] ];
Initializer: Name ':' Expr;
Conditional: KwIf '(' Expr ')' Block KwElse Block;
Selection: KwMatch '(' Expr ')' '{' { Arm } '}';
Arm: Pattern [ KwIf Expr ] '=>' Expr ',';
Pattern: Wild | BindingPat | ConstructorPat | LiteralPat | ReferencePat | TuplePattern | UnitPattern | GroupPattern;
ReferencePat: '&' [ KwMut ] GroupPattern;
GroupPattern: '(' Pattern ')';
TuplePattern: '(' Pattern ',' [ Pattern { ',' Pattern } [ ',' ] ] ')';
UnitPattern: '(' ')';
Wild: '_';
BindingPat: Name | RefPat | MutPat;
RefPat: KwRef [ KwMut ] Name;
MutPat: KwMut Name;
ConstructorPat: Name CtorPatternTail;
CtorPatternTail: ConstructorArgs | QualifiedCtorPattern | RecordPatternArgs;
QualifiedCtorPattern: '::' Name { '::' Name } [ CtorPatternFields ];
CtorPatternFields: ConstructorArgs | RecordPatternArgs;
ConstructorArgs: '(' [ Pattern { ',' Pattern } [ ',' ] ] ')';
RecordPatternArgs: '{' [ RecordPatternField { ',' RecordPatternField } [ ',' ] ] '}';
RecordPatternField: Name ':' Pattern;
LiteralPat: Number | KwTrue | KwFalse | StringLit | NegativePattern;
NegativePattern: '-' Number;
Closure: '(' [ KwMove ] '|' ClosureParams '|' [ '->' Ty ] Block ')';
ClosureParams: [ ClosureParam { ',' ClosureParam } [ ',' ] ];
ClosureParam: [ KwMut ] Name [ ':' Ty ];
Repetition: [ Life ':' ] KwLoop Block;
AsyncBlock: KwAsync [ KwMove ] Block;
TraitFn: 'Fn';
KwFnMut: 'FnMut';
KwFnOnce: 'FnOnce';
KwAs: 'as';
KwAsync: 'async';
KwAwait: 'await';
KwBreak: 'break';
KwContinue: 'continue';
KwDyn: 'dyn';
KwElse: 'else';
KwEnum: 'enum';
KwFalse: 'false';
KwFn: 'fn';
KwIf: 'if';
KwLet: 'let';
KwLoop: 'loop';
KwMatch: 'match';
KwMove: 'move';
KwMut: 'mut';
KwRef: 'ref';
KwReturn: 'return';
KwStruct: 'struct';
KwTrue: 'true';
KwType: 'type';
KwPub: 'pub';
KwWhile: 'while';
KwFor: 'for';
Name: /(?:r#)?[A-Za-z_][A-Za-z0-9_]*/;
Life: /'[A-Za-z_][A-Za-z0-9_]*/;
Number: /[0-9][0-9_]*(?:u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize)?/;
StringLit: /"([^"\\]|\\.)*"/;
