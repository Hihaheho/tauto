import "core.taut" { RsAddress, RsBorrow, RsLiteral, RsPlace, RsStore, RsValue }
import "../../../std/Base.taut" { List }

pub fn rs_set<A>(xs: List(A), index: Nat, value: A): List(A) {
  match xs: List(A) {
    Nil => Nil
    Cons(x, rest) => match index: List(A) {
      Zero => Cons(value, rest)
      Succ(i) => Cons(x, rs_set(rest, i, value))
    }
  }
}

pub fn rs_cell(heap: RsStore, index: Nat): Option(RsValue) {
  match heap: Option(RsValue) {
    RsHeap(cells) => match List::nth(cells, index): Option(RsValue) {
      None => None
      Some(cell) => cell
    }
  }
}

pub fn rs_store_cell(heap: RsStore, index: Nat, value: Option(RsValue)): RsStore {
  match heap: RsStore {
    RsHeap(cells) => RsHeap(rs_set(cells, index, value))
  }
}

pub fn rs_alloc(heap: RsStore, value: RsValue): Nat × RsStore {
  match heap: Nat × RsStore {
    RsHeap(cells) => #(List::length(cells), RsHeap(List::append(cells, Cons(Some(value), Nil))))
  }
}

pub fn rs_alloc_values(heap: RsStore, values: List(RsValue)): List(Nat) × RsStore {
  match values: List(Nat) × RsStore {
    Nil => #(Nil, heap)
    Cons(v, rest) => match rs_alloc(heap, v): List(Nat) × RsStore {
      #(index, next) => match rs_alloc_values(next, rest): List(Nat) × RsStore {
        #(indices, final_heap) => #(Cons(index, indices), final_heap)
      }
    }
  }
}

pub fn rs_initialized(value: RsValue): Bool {
  match value: Bool {
    RsUninitialized => false
    RsScalar(v) => true
    RsData(tag, is_copy, fields) => true
    RsReference(kind, address) => true
    RsGlobal(index) => true
    RsClosure(kind, arity, captures, body) => true
    RsSuspended(captures, body) => true
    RsHandle(index) => true
  }
}

pub fn rs_fields(value: RsValue): Option(List(RsValue)) {
  match value: Option(List(RsValue)) {
    RsData(tag, is_copy, fields) => Some(fields)
    RsUninitialized => None
    RsScalar(v) => None
    RsReference(kind, address) => None
    RsGlobal(index) => None
    RsClosure(kind, arity, captures, body) => None
    RsSuspended(captures, body) => None
    RsHandle(index) => None
  }
}

pub fn rs_rebuild(value: RsValue, fields: List(RsValue)): Option(RsValue) {
  match value: Option(RsValue) {
    RsData(tag, is_copy, old) => Some(RsData(tag, is_copy, fields))
    RsUninitialized => None
    RsScalar(v) => None
    RsReference(kind, address) => None
    RsGlobal(index) => None
    RsClosure(kind, arity, captures, body) => None
    RsSuspended(captures, body) => None
    RsHandle(index) => None
  }
}

pub fn rs_project(value: RsValue, path: List(Nat)): Option(RsValue) {
  match path: Option(RsValue) {
    Nil => Some(value)
    Cons(index, rest) => match rs_fields(value): Option(RsValue) {
      None => None
      Some(fields) => match List::nth(fields, index): Option(RsValue) {
        None => None
        Some(field) => rs_project(field, rest)
      }
    }
  }
}

mutual {
  pub fn rs_complete(value: RsValue): Bool {
    match value: Bool {
      RsData(tag, is_copy, fields) => rs_fields_complete(fields)
      RsUninitialized => false
      RsScalar(lit) => true
      RsReference(kind, address) => true
      RsGlobal(index) => true
      RsClosure(kind, arity, captures, body) => true
      RsSuspended(captures, body) => true
      RsHandle(index) => true
    }
  }
  pub fn rs_fields_complete(fields: List(RsValue)): Bool {
    match fields: Bool {
      Nil => true
      Cons(value, rest) => rs_complete(value) && rs_fields_complete(rest)
    }
  }
}

pub fn rs_replace(value: RsValue, path: List(Nat), replacement: RsValue): Option(RsValue) {
  match path: Option(RsValue) {
    Nil => Some(replacement)
    Cons(index, rest) => match rs_fields(value): Option(RsValue) {
      None => None
      Some(fields) => match List::nth(fields, index): Option(RsValue) {
        None => None
        Some(field) => match rs_replace(field, rest, replacement): Option(RsValue) {
          None => None
          Some(next) => rs_rebuild(value, rs_set(fields, index, next))
        }
      }
    }
  }
}

pub fn rs_peek(heap: RsStore, address: RsAddress): Option(RsValue) {
  match address: Option(RsValue) {
    RsAddr(root, fields) => match rs_cell(heap, root): Option(RsValue) {
      None => None
      Some(value) => rs_project(value, fields)
    }
  }
}

pub fn rs_load(heap: RsStore, address: RsAddress): Option(RsValue) {
  match rs_peek(heap, address): Option(RsValue) {
    None => None
    Some(value) => if rs_complete(value) { Some(value) } else { None }
  }
}

pub fn rs_save(heap: RsStore, address: RsAddress, value: RsValue): Option(RsStore) {
  match address: Option(RsStore) {
    RsAddr(root, fields) => match List::nth(match heap: List(Option(RsValue)) {
      RsHeap(cells) => cells
    }, root): Option(RsStore) {
      None => None
      Some(old) => match fields: Option(RsStore) {
        Nil => match old: Option(RsStore) {
          None => None
          Some(previous) => Some(rs_store_cell(heap, root, Some(value)))
        }
        Cons(index, rest) => match old: Option(RsStore) {
          None => None
          Some(previous) => match rs_replace(previous, fields, value): Option(RsStore) {
            None => None
            Some(next) => Some(rs_store_cell(heap, root, Some(next)))
          }
        }
      }
    }
  }
}

pub fn rs_reference(value: RsValue): Option(RsAddress) {
  match value: Option(RsAddress) {
    RsReference(kind, address) => Some(address)
    RsUninitialized => None
    RsScalar(v) => None
    RsData(tag, is_copy, fields) => None
    RsGlobal(index) => None
    RsClosure(kind, arity, captures, body) => None
    RsSuspended(captures, body) => None
    RsHandle(index) => Some(RsAddr(index, Nil))
  }
}

pub fn rs_address(env: List(RsAddress), heap: RsStore, place: RsPlace): Option(RsAddress) {
  match place: Option(RsAddress) {
    RsLocal(index) => match List::nth(env, index): Option(RsAddress) {
      None => None
      Some(root) => Some(root)
    }
    RsField(base, field) => match rs_address(env, heap, base): Option(RsAddress) {
      None => None
      Some(RsAddr(root, fields)) => Some(RsAddr(root, List::append(fields, Cons(field, Nil))))
    }
    RsDeref(base) => match rs_address(env, heap, base): Option(RsAddress) {
      None => None
      Some(address) => match rs_load(heap, address): Option(RsAddress) {
        None => None
        Some(value) => rs_reference(value)
      }
    }
  }
}

mutual {
  pub fn rs_can_copy(value: RsValue): Bool {
    match value: Bool {
      RsScalar(lit) => match lit: Bool {
        RsNatural(n) => false
        RsUnit => true
        RsBool(b) => true
        RsInteger(i, signed, bits) => true
        RsStr(t) => true
        RsText(t) => false
        RsFloat(bits, single) => true
      }
      RsData(tag, is_copy, fields) => is_copy && rs_fields_copy(fields)
      RsReference(kind, address) => match kind: Bool {
        RsShared => true
        RsUnique => false
      }
      RsGlobal(index) => true
      RsClosure(kind, arity, captures, body) => false
      RsSuspended(captures, body) => false
      RsHandle(index) => false
      RsUninitialized => false
    }
  }
  pub fn rs_fields_copy(fields: List(RsValue)): Bool {
    match fields: Bool {
      Nil => true
      Cons(value, rest) => rs_can_copy(value) && rs_fields_copy(rest)
    }
  }
}

pub fn rs_reference_kind(kind: RsBorrow, value: RsValue): Option(RsAddress) {
  match value: Option(RsAddress) {
    RsReference(actual, address) => match kind: Option(RsAddress) {
      RsShared => match actual: Option(RsAddress) {
        RsShared => Some(address)
        RsUnique => None
      }
      RsUnique => match actual: Option(RsAddress) {
        RsShared => None
        RsUnique => Some(address)
      }
    }
    RsScalar(lit) => None
    RsData(tag, is_copy, fields) => None
    RsGlobal(index) => None
    RsClosure(call_kind, arity, captures, body) => None
    RsSuspended(captures, body) => None
    RsHandle(index) => None
    RsUninitialized => None
  }
}

pub fn rs_roots(slots: List(Nat)): List(RsAddress) {
  match slots: List(RsAddress) {
    Nil => Nil
    Cons(slot, rest) => Cons(RsAddr(slot, Nil), rs_roots(rest))
  }
}
