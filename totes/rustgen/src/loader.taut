import "declare.taut"
import "bindings.taut"
import "data.taut"
import "../../surface/src/surface.taut"
import "../../syntax/src/syntax.taut"
import "../../text/src/text.taut"
import "../../unicode/src/classes.taut"
import std::Text
import std::TextOps
import std::Base

pub(open) inductive RustgenSource: Type {
  Mk(id: Text, contents: Text): RustgenSource
}
pub(open) inductive RustgenSourceRange: Type {
  Mk(id: Text, start: Nat, end: Nat): RustgenSourceRange
}
pub(open) inductive RustgenGraph: Type {
  Mk(
    source: Text,
    stmts: List(SurfaceStmt),
    files: List(RustgenSourceRange),
    generated_files: List(Text)
  ): RustgenGraph
}
pub(open) inductive RustgenWire: Type {
  Mk(contents: Text, at: Nat): RustgenWire
}

pub fn rustgen_has_text(wanted: Text, names: List(Text)): Bool {
  match names: Bool {
    Nil => false
    Cons(name, more) => wanted == name || rustgen_has_text(wanted, more)
  }
}
pub fn rustgen_path_parts(parts: List(Text), reverse: List(Text)): RustgenResult(Text) {
  match parts: RustgenResult(Text) {
    Nil => if List::length(reverse) == 0 { RustgenErr("empty module path") } else {
      RustgenOk(text_join(List::reverse(reverse), "/"))
    }
    Cons(part, rest) => if part == "" || part == "." {
      rustgen_path_parts(rest, reverse)
    } else if part == ".." {
      match reverse: RustgenResult(Text) {
        Nil => RustgenErr("module path escapes bundle")
        Cons(last, Before) => rustgen_path_parts(rest, Before)
      }
    } else { rustgen_path_parts(rest, Cons(part, reverse)) }
  }
}
pub fn rustgen_path_valid(path: Text): Bool {
  Text::len(path) != 0 && Text::slice_or_empty(path, 0, 1) != "/" &&
  List::length(text_split(path, "\\")) == 1 && List::length(text_split(path, ":")) == 1 &&
  List::length(text_split(path, "\n")) == 1 && List::length(text_split(path, "\r")) == 1 &&
  List::length(text_split(path, "\t")) == 1 &&
  List::length(text_split(path, Text::utf8_of_code_point(0))) == 1
}
pub fn rustgen_path(path: Text): RustgenResult(Text) {
  if rustgen_path_valid(
    path
  ) { rustgen_path_parts(text_split(path, "/"), Nil) } else { RustgenErr("invalid module path") }
}
pub fn rustgen_parent_parts(parts: List(Text)): List(Text) {
  match parts: List(Text) {
    Nil => Nil
    Cons(part, rest) => match rest: List(Text) {
      Nil => Nil
      Cons(next, more) => Cons(part, rustgen_parent_parts(rest))
    }
  }
}
// `import std::Name` names `std/Name.taut` of the bundle, wherever the
// importing file is, as the host reads the standard library.
fn rustgen_std_module(path: Text): Option(Text) {
  if Text::slice_or_empty(path, 0, 4) == "std." {
    let r#module := Text::slice_or_empty(path, 4, Nat::of_u64(std::prelude::Text::len(path)))
    if rustgen_path_valid(r#module) && List::length(text_split(r#module, "/")) == 1 {
      Some(Text::concat_all(Cons("std/", Cons(r#module, Cons(".taut", Nil)))))
    } else { None }
  } else { None }
}
pub fn rustgen_relative(own: Text, path: Text): RustgenResult(Text) {
  match rustgen_std_module(path): RustgenResult(Text) {
    Some(target) => RustgenOk(target)
    None => rustgen_relative_file(own, path)
  }
}
fn rustgen_relative_file(own: Text, path: Text): RustgenResult(Text) {
  if rustgen_path_valid(path) {
    rustgen_path(
      text_join(List::append(rustgen_parent_parts(text_split(own, "/")), Cons(path, Nil)), "/")
    )
  } else { RustgenErr("invalid module path") }
}
pub fn rustgen_source_find(id: Text, files: List(RustgenSource)): Option(Text) {
  match files: Option(Text) {
    Nil => None
    Cons(file, more) => if file.id == id { Some(file.contents) } else {
      rustgen_source_find(id, more)
    }
  }
}
pub fn rustgen_range_has(id: Text, files: List(RustgenSourceRange)): Bool {
  match files: Bool {
    Nil => false
    Cons(file, more) => file.id == id || rustgen_range_has(id, more)
  }
}
pub fn rustgen_wire_line(w: RustgenWire): RustgenResult(Pair(Text, RustgenWire)) {
  match text_find(w.contents, "\n", w.at): RustgenResult(Pair(Text, RustgenWire)) {
    None => RustgenErr("truncated source bundle header")
    Some(end) => RustgenOk(Pair {
      fst: Text::slice_or_empty(w.contents, w.at, end),
      snd: RustgenWire::Mk(w.contents, end + 1)
    })
  }
}
pub fn rustgen_wire_number(w: RustgenWire): RustgenResult(Pair(Nat, RustgenWire)) {
  match rustgen_wire_line(w): RustgenResult(Pair(Nat, RustgenWire)) {
    RustgenErr(Message) => RustgenErr(Message)
    RustgenOk(line) => match text_parse_u64(line.fst): RustgenResult(Pair(Nat, RustgenWire)) {
      None => RustgenErr("invalid source bundle length")
      Some(n) => if n > 16777216 { RustgenErr("source bundle length exceeds limit") } else {
        RustgenOk(Pair { fst: n, snd: line.snd })
      }
    }
  }
}
pub fn rustgen_wire_files(
  n: Nat,
  w: RustgenWire,
  done: List(RustgenSource)
): RustgenResult(List(RustgenSource)) {
  match n: RustgenResult(List(RustgenSource)) {
    Zero => if w.at != Text::len(
      w.contents
    ) { RustgenErr("trailing source bundle bytes") } else { RustgenOk(List::reverse(done)) }
    Succ(left) => match rustgen_wire_number(w): RustgenResult(List(RustgenSource)) {
      RustgenErr(Message) => RustgenErr(Message)
      RustgenOk(id_length) => match rustgen_wire_number(
        id_length.snd
      ): RustgenResult(List(RustgenSource)) {
        RustgenErr(Message) => RustgenErr(Message)
        RustgenOk(source_length) => {
          let start := source_length.snd.at
          let middle := start + id_length.fst
          let end := middle + source_length.fst
          match Text::slice(w.contents, start, middle): RustgenResult(List(RustgenSource)) {
            None => RustgenErr("invalid source bundle path boundary")
            Some(Id) => match rustgen_path(Id): RustgenResult(List(RustgenSource)) {
              RustgenErr(Message) => RustgenErr(Message)
              RustgenOk(normal) => if normal != Id { RustgenErr("noncanonical bundle path") } else {
                match rustgen_source_find(Id, done): RustgenResult(List(RustgenSource)) {
                  Some(old) => RustgenErr("duplicate bundle path")
                  None => match Text::slice(
                    w.contents,
                    middle,
                    end
                  ): RustgenResult(List(RustgenSource)) {
                    None => RustgenErr("invalid source bundle contents boundary")
                    Some(source) => if Text::slice_or_empty(w.contents, end, end + 1) != "\n" {
                      RustgenErr("truncated source bundle record")
                    } else {
                      rustgen_wire_files(
                        left,
                        RustgenWire::Mk(w.contents, end + 1),
                        Cons(RustgenSource::Mk(Id, source), done)
                      )
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
pub fn rustgen_bundle(contents: Text): RustgenResult(List(RustgenSource)) {
  if std::prelude::Text::len(contents) > 16777216 { RustgenErr("source bundle exceeds limit") } else {
    match rustgen_wire_line(RustgenWire::Mk(contents, 0)): RustgenResult(List(RustgenSource)) {
      RustgenErr(Message) => RustgenErr(Message)
      RustgenOk(header) => if header.fst != "TAUTO-SOURCES-1" {
        RustgenErr("unknown source bundle format")
      } else {
        match rustgen_wire_number(header.snd): RustgenResult(List(RustgenSource)) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(count) => if count.fst > 4096 {
            RustgenErr("too many source bundle files")
          } else { rustgen_wire_files(count.fst, count.snd, Nil) }
        }
      }
    }
  }
}
pub fn rustgen_nonimports(stmts: List(SurfaceStmt)): List(SurfaceStmt) {
  match stmts: List(SurfaceStmt) {
    Nil => Nil
    Cons(stmt, rest) => match stmt: List(SurfaceStmt) {
      StImport(path, start, end) => rustgen_nonimports(rest)
      _ => Cons(stmt, rustgen_nonimports(rest))
    }
  }
}
mutual {
  pub fn rustgen_visit(
    k: u64,
    tables: SyntaxTables,
    files: List(RustgenSource),
    id: Text,
    stack: List(Text),
    graph: RustgenGraph
  ): RustgenResult(RustgenGraph) {
    if k == 0 { RustgenErr("module import depth exceeds limit") } else {
      let fuel := k - 1
      if rustgen_range_has(
        id,
        graph.files
      ) { RustgenOk(graph) } else if rustgen_has_text(id, stack) {
        RustgenErr(Text::concat_all(Cons("import cycle: ", Cons(id, Nil))))
      } else { match rustgen_source_find(id, files): RustgenResult(RustgenGraph) {
          None => RustgenErr(Text::concat_all(Cons("missing bundle module: ", Cons(id, Nil))))
          Some(source) => match syntax_parse(tables, source): RustgenResult(RustgenGraph) {
            None => RustgenErr(Text::concat_all(Cons("cannot parse module: ", Cons(id, Nil))))
            Some(Root) => {
              let stmts := surface_program_of(
                SurfaceCtx {
                  source: source,
                  base: 0,
                  classes: unicode_classes(),
                  fuel: surface_size(Root) + 1
                },
                Root
              )
              match rustgen_imports(
                fuel,
                tables,
                files,
                id,
                Cons(id, stack),
                stmts,
                graph
              ): RustgenResult(RustgenGraph) {
                RustgenErr(Message) => RustgenErr(Message)
                RustgenOk(next) => {
                  let base := Nat::of_u64(std::prelude::Text::len(next.source))
                  let parsed := surface_program_of(
                    SurfaceCtx {
                      source: source,
                      base: base,
                      classes: unicode_classes(),
                      fuel: surface_size(Root) + 1
                    },
                    Root
                  )
                  RustgenOk(RustgenGraph {
                  source: Text::concat_all(Cons(next.source, Cons(source, Cons("\n", Nil)))),
                  stmts: List::append(next.stmts, rustgen_nonimports(parsed)),
                  files: List::append(next.files, Cons(RustgenSourceRange { id: id, start: base, end: base + Nat::of_u64(std::prelude::Text::len(source)) }, Nil)),
                  generated_files: if rustgen_generated(surface_size(Root) + 1, Cons(Root, Nil)) { List::append(next.generated_files, Cons(id, Nil)) } else { next.generated_files } })
                }
              }
            }
          }
        } }
    }
  }
  pub fn rustgen_imports(
    k: u64,
    tables: SyntaxTables,
    files: List(RustgenSource),
    id: Text,
    stack: List(Text),
    stmts: List(SurfaceStmt),
    graph: RustgenGraph
  ): RustgenResult(RustgenGraph) {
    if k == 0 { RustgenErr("module import traversal exceeds limit") } else {
      let fuel := k - 1
      match stmts: RustgenResult(RustgenGraph) {
        Nil => RustgenOk(graph)
        Cons(stmt, rest) => match stmt: RustgenResult(RustgenGraph) {
          StImport(path, start, end) => match rustgen_relative(
            id,
            path
          ): RustgenResult(RustgenGraph) {
            RustgenErr(Message) => RustgenErr(
              Text::concat_all(Cons(id, Cons(": ", Cons(Message, Nil))))
            )
            RustgenOk(target) => match rustgen_visit(
              fuel,
              tables,
              files,
              target,
              stack,
              graph
            ): RustgenResult(RustgenGraph) {
              RustgenErr(Message) => RustgenErr(Message)
              RustgenOk(next) => rustgen_imports(fuel, tables, files, id, stack, rest, next)
            }
          }
          _ => rustgen_imports(fuel, tables, files, id, stack, rest, graph)
        }
      }
    }
  }
}
pub fn rustgen_load_bundle(contents: Text, entry: Text): RustgenResult(RustgenGraph) {
  match rustgen_path(entry): RustgenResult(RustgenGraph) {
    RustgenErr(Message) => RustgenErr(Message)
    RustgenOk(Id) => match rustgen_bundle(contents): RustgenResult(RustgenGraph) {
      RustgenErr(Message) => RustgenErr(Message)
      RustgenOk(files) => match syntax_tables(): RustgenResult(RustgenGraph) {
        None => RustgenErr("damaged syntax tables")
        // Each step of the traversal enters a module or passes a statement,
        // and both take bytes of the bundle: its length bounds the walk.
        Some(tables) => rustgen_visit(
          Text::len(contents) + 1,
          tables,
          files,
          Id,
          Nil,
          RustgenGraph { source: "", stmts: Nil, files: Nil, generated_files: Nil }
        )
      }
    }
  }
}
pub fn rustgen_graph_lines(files: List(RustgenSourceRange)): List(Text) {
  match files: List(Text) {
    Nil => Nil
    Cons(file, rest) => Cons(
      Text::concat_all(
        Cons(
          file.id,
          Cons(
            "\t",
            Cons(
              Text::of_u64(U64::of_nat(file.start)),
              Cons("\t", Cons(Text::of_u64(U64::of_nat(file.end)), Cons("\n", Nil)))
            )
          )
        )
      ),
      rustgen_graph_lines(rest)
    )
  }
}
