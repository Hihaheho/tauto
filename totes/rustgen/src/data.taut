import "generic.taut"
import "record_core.taut"
import "closure_core.taut"
import "../../surface/src/surface.taut"
import "../../syntax/src/syntax.taut"

pub fn rustgen_printable(ty: RustgenType): Bool {
  match ty: Bool {
    RustgenCallable(params, result) => false
    RustgenNumber(id, value) => true
    RustgenInt => true
    RustgenBool => true
    RustgenText => true
    RustgenNat => true
    RustgenNamed(name) => false
    RustgenApply(name, args) => false
    RustgenVar(name) => false
    RustgenMeta(name) => false
  }
}
pub fn rustgen_reserved(name: Text): Bool {
  name == "Text.concat" || name == "Zero" || name == "Succ" || name == "Nat" || name == "i64" || name == "Bool" || name == "Text" || name == "true" || name == "false"
}
pub fn rustgen_parameters_known(params: List(RustgenBinding), all: List(RustgenFunction)): Bool {
  match params: Bool {
    Nil => true
    Cons(p, rest) => rustgen_known_type(p.ty, all) && rustgen_parameters_known(rest, all)
  }
}
pub fn rustgen_signature_known(f: RustgenFunction, all: List(RustgenFunction)): Bool {
  rustgen_known_type(f.result, all) && rustgen_parameters_known(f.params, all)
}
pub fn rustgen_names_unique(names: List(Text), seen: List(Text)): Bool {
  match names: Bool {
    Nil => true
    Cons(n, rest) => not(
      rustgen_reserved(n)
    ) && not(rustgen_generic_member(n, seen)) && rustgen_names_unique(rest, Cons(n, seen))
  }
}
pub fn rustgen_formals(params: List(SurfaceNamed)): RustgenResult(List(Text)) {
  match params: RustgenResult(List(Text)) {
    Nil => RustgenOk(Nil)
    Cons(p, rest) => match rustgen_call_name(p.ty): RustgenResult(List(Text)) {
      None => RustgenErr("data parameters must be types")
      Some(name) => if name != "Type" {
        RustgenErr("indexed and higher-universe data are unsupported")
      } else {
        match rustgen_formals(rest): RustgenResult(List(Text)) {
          RustgenErr(message) => RustgenErr(message)
          RustgenOk(names) => if rustgen_generic_member(
            p.name,
            names
          ) || rustgen_reserved(p.name) { RustgenErr("duplicate or reserved type parameter") } else {
            RustgenOk(Cons(p.name, names))
          }
        }
      }
    }
  }
}
pub fn rustgen_formal_types(names: List(Text)): List(RustgenType) {
  match names: List(RustgenType) {
    Nil => Nil
    Cons(n, rest) => Cons(RustgenVar(n), rustgen_formal_types(rest))
  }
}
pub fn rustgen_family(name: Text, args: List(RustgenType)): RustgenType {
  match args: RustgenType {
    Nil => RustgenNamed(name)
    Cons(t, rest) => RustgenApply(name, args)
  }
}
pub fn rustgen_data_fields(
  params: List(SurfaceNamed),
  done: List(RustgenBinding)
): RustgenResult(List(RustgenBinding)) {
  match params: RustgenResult(List(RustgenBinding)) {
    Nil => RustgenOk(List::reverse(done))
    Cons(p, rest) => match rustgen_find(p.name, done): RustgenResult(List(RustgenBinding)) {
      Some(ty) => RustgenErr("duplicate constructor field")
      None => match rustgen_written(p.ty): RustgenResult(List(RustgenBinding)) {
        RustgenErr(message) => RustgenErr(message)
        RustgenOk(ty) => if rustgen_contains_callable(
          10000,
          ty
        ) { RustgenErr("callable datatype fields are unsupported") } else {
          rustgen_data_fields(rest, Cons(RustgenBinding::Mk(p.name, ty), done))
        }
      }
    }
  }
}
pub fn rustgen_constructors(
  owner: Text,
  generics: List(Text),
  cs: List(SurfaceCtor),
  done: List(RustgenFunction)
): RustgenResult(List(RustgenFunction)) {
  match cs: RustgenResult(List(RustgenFunction)) {
    Nil => RustgenOk(done)
    Cons(c, rest) => if c.implicit != 0 || rustgen_reserved(
      c.name
    ) { RustgenErr("implicit or reserved constructor") } else {
      match rustgen_find_function(c.name, done): RustgenResult(List(RustgenFunction)) {
        Some(old) => RustgenErr("duplicate declaration name")
        None => match rustgen_written(c.result): RustgenResult(List(RustgenFunction)) {
          RustgenErr(message) => RustgenErr(message)
          RustgenOk(raw) => match rustgen_vars(
            10000,
            raw,
            generics
          ): RustgenResult(List(RustgenFunction)) {
            RustgenErr(message) => RustgenErr(message)
            RustgenOk(result) => if not(
              rustgen_same(result, rustgen_family(owner, rustgen_formal_types(generics)))
            ) { RustgenErr("constructor must return its family with unchanged parameters") } else {
              match rustgen_data_fields(c.params, Nil): RustgenResult(List(RustgenFunction)) {
                RustgenErr(message) => RustgenErr(message)
                RustgenOk(raw_fields) => match rustgen_vars_bindings(
                  10000,
                  raw_fields,
                  generics
                ): RustgenResult(List(RustgenFunction)) {
                  RustgenErr(message) => RustgenErr(message)
                  RustgenOk(fields) => rustgen_constructors(
                    owner,
                    generics,
                    rest,
                    Cons(RustgenFunction::Mk(c.name, fields, result, c.result, 1, generics), done)
                  )
                }
              }
            }
          }
        }
      }
    }
  }
}
pub fn rustgen_inductive(
  d: SurfaceInductive,
  done: List(RustgenFunction)
): RustgenResult(List(RustgenFunction)) {
  if rustgen_reserved(
    d.name
  ) || List::length(d.constructors) == 0 { RustgenErr("reserved or empty datatype") } else {
    match rustgen_call_name(d.sort): RustgenResult(List(RustgenFunction)) {
      None => RustgenErr("data must live in Type")
      Some(sort) => if sort != "Type" { RustgenErr("data must live in Type") } else {
        match rustgen_find_function(d.name, done): RustgenResult(List(RustgenFunction)) {
          Some(old) => RustgenErr("duplicate declaration name")
          None => match rustgen_formals(d.params): RustgenResult(List(RustgenFunction)) {
            RustgenErr(message) => RustgenErr(message)
            RustgenOk(generics) => rustgen_constructors(
              d.name,
              generics,
              d.constructors,
              Cons(
                RustgenFunction::Mk(
                  d.name,
                  Nil,
                  rustgen_family(d.name, rustgen_formal_types(generics)),
                  d.sort,
                  2,
                  generics
                ),
                done
              )
            )
          }
        }
      }
    }
  }
}
pub fn rustgen_ctor_list(ty: RustgenType, all: List(RustgenFunction)): List(RustgenFunction) {
  match all: List(RustgenFunction) {
    Nil => Nil
    Cons(f, rest) => if f.kind == 1 && rustgen_type_label(
      f.result
    ) == rustgen_type_label(
      ty
    ) { Cons(f, rustgen_ctor_list(ty, rest)) } else { rustgen_ctor_list(ty, rest) }
  }
}
pub fn rustgen_type_codes(params: List(RustgenBinding)): List(Text) {
  match params: List(Text) {
    Nil => Nil
    Cons(p, rest) => Cons(rustgen_type_name(p.ty), rustgen_type_codes(rest))
  }
}
pub fn rustgen_name_codes(params: List(RustgenBinding)): List(Text) {
  match params: List(Text) {
    Nil => Nil
    Cons(p, rest) => Cons(rustgen_ident(p.name), rustgen_name_codes(rest))
  }
}
pub fn rustgen_generic_codes(names: List(Text), bounds: Bool): List(Text) {
  match names: List(Text) {
    Nil => Nil
    Cons(n, rest) => {
      let code: Text := if bounds { Text::concat(rustgen_ident(n), ": Clone") } else {
        rustgen_ident(n)
      }
      Cons(code, rustgen_generic_codes(rest, bounds))
    }
  }
}
pub fn rustgen_generics(names: List(Text), bounds: Bool): Text {
  match names: Text {
    Nil => ""
    Cons(n, rest) => rustgen_wrapped("<", text_join(rustgen_generic_codes(names, bounds), ","), ">")
  }
}
pub fn rustgen_phantom_types(names: List(Text), fields: List(Text)): List(Text) {
  match names: List(Text) {
    Nil => fields
    Cons(n, rest) => List::append(
      fields,
      Cons(
        rustgen_wrapped(
          "std::marker::PhantomData<(",
          text_join(rustgen_generic_codes(names, false), ","),
          ")>"
        ),
        Nil
      )
    )
  }
}
pub fn rustgen_phantom_values(names: List(Text), values: List(Text), pattern: Bool): List(Text) {
  match names: List(Text) {
    Nil => values
    Cons(n, rest) => {
      let code: Text := if pattern { "_" } else { "std::marker::PhantomData" }
      List::append(values, Cons(code, Nil))
    }
  }
}
pub fn rustgen_param_codes(params: List(RustgenBinding)): List(Text) {
  match params: List(Text) {
    Nil => Nil
    Cons(p, rest) => Cons(
      Text::concat_all(Cons(rustgen_ident(p.name), Cons(": ", Cons(rustgen_type_name(p.ty), Nil)))),
      rustgen_param_codes(rest)
    )
  }
}
pub fn rustgen_variants(cs: List(RustgenFunction)): List(Text) {
  match cs: List(Text) {
    Nil => Nil
    Cons(c, rest) => Cons(
      Text::concat(
        rustgen_ident(c.name),
        rustgen_wrapped(
          "(",
          text_join(rustgen_phantom_types(c.generics, rustgen_type_codes(c.params)), ","),
          ")"
        )
      ),
      rustgen_variants(rest)
    )
  }
}
pub fn rustgen_data_code(f: RustgenFunction, all: List(RustgenFunction)): Text {
  let signature := Text::concat(rustgen_ident(f.name), rustgen_generics(f.generics, true))
  if f.kind == 2 {
    Text::concat_all(
      Cons(
        "#[derive(Clone)] enum ",
        Cons(
          signature,
          Cons(
            " { ",
            Cons(
              text_join(rustgen_variants(rustgen_ctor_list(f.result, all)), ","),
              Cons(" }\n", Nil)
            )
          )
        )
      )
    )
  } else {
    let body := Text::concat_all(
      Cons(
        rustgen_ident(rustgen_type_label(f.result)),
        Cons(
          "::",
          Cons(
            rustgen_ident(f.name),
            Cons(
              "(",
              Cons(
                text_join(
                  rustgen_phantom_values(f.generics, rustgen_name_codes(f.params), false),
                  ","
                ),
                Cons(")", Nil)
              )
            )
          )
        )
      )
    )
    Text::concat_all(
      Cons(
        "fn ",
        Cons(
          signature,
          Cons(
            "(",
            Cons(
              text_join(rustgen_param_codes(f.params), ","),
              Cons(
                ") -> ",
                Cons(
                  rustgen_type_name(f.result),
                  Cons(" { std::rc::Rc::new(", Cons(body, Cons(") }\n", Nil)))
                )
              )
            )
          )
        )
      )
    )
  }
}

pub fn rustgen_pattern_name(pattern: SurfacePattern): Option(Text) {
  match pattern: Option(Text) {

    PtBind(name) => Some(name)

    PtCtor(name, args) => Some(name)

    PtWild => None
    PtInt(n, m) => None
    PtBool(v) => None
    PtText(v) => None
    PtRecord(n, f) => None
    PtOther(w) => None
  }
}

pub fn rustgen_pattern_args(pattern: SurfacePattern): List(SurfacePattern) {
  match pattern: List(SurfacePattern) {

    PtCtor(name, args) => args

    PtBind(name) => Nil

    PtWild => Nil
    PtInt(n, m) => Nil
    PtBool(v) => Nil
    PtText(v) => Nil
    PtRecord(n, f) => Nil
    PtOther(w) => Nil
  }
}

pub fn rustgen_constructor_name(name: Text, functions: List(RustgenFunction)): Bool {
  if name == "true" || name == "false" || name == "Zero" || name == "Succ" { true } else {
    match rustgen_find_function(name, functions): Bool {
      None => false
      Some(f) => f.kind == 1
    }
  }
}

pub fn rustgen_pattern_bindings_in(
  patterns: List(SurfacePattern),
  functions: List(RustgenFunction),
  fields: List(RustgenBinding),
  locals: List(RustgenBinding)
): RustgenResult(List(RustgenBinding)) {
  match patterns: RustgenResult(List(RustgenBinding)) {
    Nil => match fields: RustgenResult(List(RustgenBinding)) { Nil => RustgenOk(Nil)
      Cons(f, rest) => RustgenErr("missing pattern fields") }

    Cons(p, rest) => match fields: RustgenResult(List(RustgenBinding)) {
      Nil => RustgenErr("too many pattern fields")

      Cons(f, more) => match p: RustgenResult(List(RustgenBinding)) {

        PtBind(name) => if rustgen_constructor_name(
          name,
          functions
        ) { RustgenErr("nested constructor patterns are unsupported") } else { match rustgen_find(
          name,
          locals
        ): RustgenResult(List(RustgenBinding)) {

            Some(old) => RustgenErr("duplicate field binder in pattern")
            None => match rustgen_pattern_bindings_in(
              rest,
              functions,
              more,
              Cons(RustgenBinding::Mk(name, f.ty), locals)
            ): RustgenResult(List(RustgenBinding)) {
              RustgenErr(message) => RustgenErr(message)
              RustgenOk(tail) => RustgenOk(Cons(RustgenBinding::Mk(name, f.ty), tail))
            }
          }

        }
        PtWild => RustgenErr("pattern fields require names")

        PtCtor(n, a) => RustgenErr("nested patterns are unsupported")

        PtInt(n, m) => RustgenErr("literal patterns are unsupported")

        PtBool(v) => RustgenErr("literal patterns are unsupported")

        PtText(v) => RustgenErr("literal patterns are unsupported")

        PtRecord(n, fs) => RustgenErr("record patterns are unsupported")

        PtOther(w) => RustgenErr("unsupported pattern")
      }
    }
  }
}

pub fn rustgen_pattern_bindings(
  patterns: List(SurfacePattern),
  functions: List(RustgenFunction),
  fields: List(RustgenBinding),
  locals: List(RustgenBinding)
): RustgenResult(List(RustgenBinding)) {
  rustgen_pattern_bindings_in(patterns, functions, fields, Nil)
}

pub fn rustgen_bound_clones(bindings: List(RustgenBinding)): Text {
  match bindings: Text {
    Nil => ""

    Cons(b, rest) => Text::concat_all(
      Cons(
        "let ",
        Cons(
          rustgen_ident(b.name),
          Cons(
            " = ",
            Cons(
              rustgen_clone(rustgen_ident(b.name)),
              Cons("; ", Cons(rustgen_bound_clones(rest), Nil))
            )
          )
        )
      )
    )
  }
}

pub fn rustgen_member(name: Text, names: List(Text)): Bool {
  match names: Bool { Nil => false
    Cons(n, rest) => name == n || rustgen_member(name, rest) }
}

pub fn rustgen_expected(
  expected: Option(RustgenType),
  actual: RustgenType
): RustgenResult(RustgenType) {
  match expected: RustgenResult(RustgenType) {
    None => RustgenOk(actual)
    Some(ty) => match rustgen_unify(10000, ty, actual, Nil): RustgenResult(RustgenType) {
      RustgenErr(message) => RustgenErr(message)
      RustgenOk(subst) => rustgen_resolve(10000, ty, subst)
    }
  }
}

pub fn rustgen_is_some<A>(value: Option(A)): Bool {
  match value: Bool {
    None => false
    Some(item) => true
  }
}

// Detects generation clauses in the concrete tree, before lowering to
// SurfaceInductive, which does not retain them.
pub fn rustgen_generated(k: Nat, nodes: List(CstNode)): Bool {
  match k: Bool {
    Zero => true
    Succ(j) => match nodes: Bool {
      Nil => false
      Cons(n, rest) => n.name == "Generates" || n.name == "Generated" || rustgen_generated(
        j,
        List::append(n.flat, rest)
      )
    }
  }
}

pub fn rustgen_binding_types(bindings: List(RustgenBinding)): List(RustgenType) {
  match bindings: List(RustgenType) {
    Nil => Nil
    Cons(b, rest) => Cons(b.ty, rustgen_binding_types(rest))
  }
}
pub fn rustgen_value_types(values: List(RustgenValue)): List(RustgenType) {
  match values: List(RustgenType) {
    Nil => Nil
    Cons(v, rest) => Cons(v.ty, rustgen_value_types(rest))
  }
}
pub fn rustgen_value_codes(values: List(RustgenValue)): List(Text) {
  match values: List(Text) {
    Nil => Nil
    Cons(v, rest) => Cons(v.code, rustgen_value_codes(rest))
  }
}
pub fn rustgen_zip_types(
  names: List(Text),
  types: List(RustgenType)
): RustgenResult(List(RustgenBinding)) {
  match names: RustgenResult(List(RustgenBinding)) {
    Nil => match types: RustgenResult(List(RustgenBinding)) {
      Nil => RustgenOk(Nil)
      Cons(t, rest) => RustgenErr("too many type arguments")
    }
    Cons(n, rest) => match types: RustgenResult(List(RustgenBinding)) {
      Nil => RustgenErr("missing type argument")
      Cons(t, more) => match rustgen_zip_types(rest, more): RustgenResult(List(RustgenBinding)) {
        RustgenErr(message) => RustgenErr(message)
        RustgenOk(bindings) => RustgenOk(Cons(RustgenBinding::Mk(n, t), bindings))
      }
    }
  }
}
pub fn rustgen_specialize(f: RustgenFunction, ty: RustgenType): RustgenResult(RustgenFunction) {
  match rustgen_zip_types(f.generics, rustgen_type_args(ty)): RustgenResult(RustgenFunction) {
    RustgenErr(message) => RustgenErr(message)
    RustgenOk(bindings) => match rustgen_substitute_bindings(
      10000,
      f.params,
      bindings
    ): RustgenResult(RustgenFunction) {
      RustgenErr(message) => RustgenErr(message)
      RustgenOk(params) => RustgenOk(
        RustgenFunction::Mk(f.name, params, ty, f.body, f.kind, f.generics)
      )
    }
  }
}
mutual {
  pub fn rustgen_pending_in_result(k: Nat, ty: RustgenType, result: RustgenType): Bool {
    match k: Bool {
      Zero => false
      Succ(j) => match ty: Bool {
        RustgenCallable(params, output) => rustgen_pending_list(j, Cons(output, params), result)
        RustgenMeta(name) => rustgen_occurs(j, name, result)
        RustgenApply(name, args) => rustgen_pending_list(j, args, result)
        RustgenInt => true
        RustgenNat => true
        RustgenNumber(id, value) => true
        RustgenBool => true
        RustgenText => true
        RustgenNamed(name) => true
        RustgenVar(name) => true
      }
    }
  }
  pub fn rustgen_pending_list(k: Nat, types: List(RustgenType), result: RustgenType): Bool {
    match k: Bool {
      Zero => false
      Succ(j) => match types: Bool {
        Nil => true
        Cons(t, rest) => rustgen_pending_in_result(
          j,
          t,
          result
        ) && rustgen_pending_list(j, rest, result)
      }
    }
  }
}
mutual {
  pub fn rustgen_default_numbers(k: Nat, ty: RustgenType): RustgenResult(RustgenType) {
    match k: RustgenResult(RustgenType) {
      Zero => RustgenErr("type depth exceeded")
      Succ(j) => match ty: RustgenResult(RustgenType) {
        RustgenNumber(id, value) => if value <= 9223372036854775807 { RustgenOk(RustgenInt) } else {
          RustgenErr("unannotated integer literal exceeds i64")
        }
        RustgenApply(name, args) => match rustgen_default_many(
          j,
          args
        ): RustgenResult(RustgenType) {
          RustgenErr(message) => RustgenErr(message)
          RustgenOk(types) => RustgenOk(RustgenApply(name, types))
        }
        RustgenCallable(params, result) => match rustgen_default_many(
          j,
          params
        ): RustgenResult(RustgenType) {
          RustgenErr(message) => RustgenErr(message)
          RustgenOk(types) => match rustgen_default_numbers(
            j,
            result
          ): RustgenResult(RustgenType) {
            RustgenErr(message) => RustgenErr(message)
            RustgenOk(value) => RustgenOk(RustgenCallable(types, value))
          }
        }
        RustgenMeta(name) => RustgenErr("unresolved type requires an annotation")
        RustgenInt => RustgenOk(ty)
        RustgenNat => RustgenOk(ty)
        RustgenBool => RustgenOk(ty)
        RustgenText => RustgenOk(ty)
        RustgenNamed(name) => RustgenOk(ty)
        RustgenVar(name) => RustgenOk(ty)
      }
    }
  }
  pub fn rustgen_default_many(k: Nat, types: List(RustgenType)): RustgenResult(List(RustgenType)) {
    match k: RustgenResult(List(RustgenType)) {
      Zero => RustgenErr("type depth exceeded")
      Succ(j) => match types: RustgenResult(List(RustgenType)) {
        Nil => RustgenOk(Nil)
        Cons(t, rest) => match rustgen_default_numbers(j, t): RustgenResult(List(RustgenType)) {
          RustgenErr(message) => RustgenErr(message)
          RustgenOk(ty) => match rustgen_default_many(j, rest): RustgenResult(List(RustgenType)) {
            RustgenErr(message) => RustgenErr(message)
            RustgenOk(more) => RustgenOk(Cons(ty, more))
          }
        }
      }
    }
  }
}

mutual {
  pub fn rustgen_number_in_type(k: Nat, id: Text, ty: RustgenType): Bool {
    match k: Bool {
      Zero => true
      Succ(j) => match ty: Bool {
        RustgenCallable(params, result) => rustgen_number_in_list(j, id, Cons(result, params))
        RustgenNumber(other, value) => id == other
        RustgenApply(name, args) => rustgen_number_in_list(j, id, args)
        RustgenInt => false
        RustgenNat => false
        RustgenBool => false
        RustgenText => false
        RustgenNamed(name) => false
        RustgenVar(name) => false
        RustgenMeta(name) => false
      }
    }
  }
  pub fn rustgen_number_in_list(k: Nat, id: Text, types: List(RustgenType)): Bool {
    match k: Bool {
      Zero => true
      Succ(j) => match types: Bool {
        Nil => false
        Cons(t, rest) => rustgen_number_in_type(j, id, t) || rustgen_number_in_list(j, id, rest)
      }
    }
  }
  pub fn rustgen_numbers_shared(k: Nat, ty: RustgenType, result: RustgenType): Bool {
    match k: Bool {
      Zero => true
      Succ(j) => match ty: Bool {
        RustgenCallable(params, output) => rustgen_numbers_shared_list(
          j,
          Cons(output, params),
          result
        )
        RustgenNumber(id, value) => rustgen_number_in_type(j, id, result)
        RustgenApply(name, args) => rustgen_numbers_shared_list(j, args, result)
        RustgenInt => false
        RustgenNat => false
        RustgenBool => false
        RustgenText => false
        RustgenNamed(name) => false
        RustgenVar(name) => false
        RustgenMeta(name) => false
      }
    }
  }
  pub fn rustgen_numbers_shared_list(k: Nat, types: List(RustgenType), result: RustgenType): Bool {
    match k: Bool {
      Zero => true
      Succ(j) => match types: Bool {
        Nil => false
        Cons(t, rest) => rustgen_numbers_shared(
          j,
          t,
          result
        ) || rustgen_numbers_shared_list(j, rest, result)
      }
    }
  }
}
pub fn rustgen_call_generics(
  types: List(RustgenType),
  result: RustgenType
): RustgenResult(List(RustgenType)) {
  match types: RustgenResult(List(RustgenType)) {
    Nil => RustgenOk(Nil)
    Cons(t, rest) => {
      let adjusted: RustgenResult(
        RustgenType
      ) := if rustgen_closed(
        t
      ) && not(
        rustgen_numbers_shared(10000, t, result)
      ) { rustgen_default_numbers(10000, t) } else { RustgenOk(t) }
      match adjusted: RustgenResult(List(RustgenType)) {
        RustgenErr(message) => RustgenErr(message)
        RustgenOk(ty) => match rustgen_call_generics(
          rest,
          result
        ): RustgenResult(List(RustgenType)) {
          RustgenErr(message) => RustgenErr(message)
          RustgenOk(more) => RustgenOk(Cons(ty, more))
        }
      }
    }
  }
}
pub fn rustgen_emit_call(
  f: RustgenFunction,
  values: List(RustgenValue),
  result: RustgenType,
  instances: List(RustgenType)
): RustgenResult(RustgenValue) {
  match rustgen_call_generics(instances, result): RustgenResult(RustgenValue) {
    RustgenErr(message) => RustgenErr(message)
    RustgenOk(types) => {
      let type_args: Text := if List::length(types) == 0 { "" } else {
        rustgen_wrapped("::<", text_join(rustgen_type_names_in(10000, types), ","), ">")
      }
      RustgenOk(
        RustgenValue::Mk(
          result,
          Text::concat_all(
            Cons(
              rustgen_ident(f.name),
              Cons(
                type_args,
                Cons("(", Cons(text_join(rustgen_value_codes(values), ","), Cons(")", Nil)))
              )
            )
          )
        )
      )
    }
  }
}

pub fn rustgen_infer_call(
  f: RustgenFunction,
  values: List(RustgenValue),
  at: Nat
): RustgenResult(RustgenValue) {
  let fresh := rustgen_instantiate(Text::of_nat(at), f.generics)
  match rustgen_substitute_many(
    10000,
    rustgen_binding_types(f.params),
    fresh
  ): RustgenResult(RustgenValue) {
    RustgenErr(message) => RustgenErr(message)
    RustgenOk(params) => match rustgen_unify_many(
      10000,
      params,
      rustgen_value_types(values),
      Nil
    ): RustgenResult(RustgenValue) {
      RustgenErr(message) => RustgenErr(message)
      RustgenOk(subst) => match rustgen_substitute(
        10000,
        f.result,
        fresh
      ): RustgenResult(RustgenValue) {
        RustgenErr(message) => RustgenErr(message)
        RustgenOk(raw_result) => match rustgen_resolve(
          10000,
          raw_result,
          subst
        ): RustgenResult(RustgenValue) {
          RustgenErr(message) => RustgenErr(message)
          RustgenOk(result) => match rustgen_resolve_many(
            10000,
            rustgen_binding_types(fresh),
            subst
          ): RustgenResult(RustgenValue) {
            RustgenErr(message) => RustgenErr(message)
            RustgenOk(instances) => if not(
              rustgen_pending_list(10000, instances, result)
            ) { RustgenErr("cannot infer a result-erased type parameter") } else {
              rustgen_emit_call(f, values, result, instances)
            }
          }
        }
      }
    }
  }
}
pub fn rustgen_with_scope(names: List(Text), all: List(RustgenFunction)): List(RustgenFunction) {
  match names: List(RustgenFunction) {
    Nil => all
    Cons(n, rest) => Cons(
      RustgenFunction::Mk(n, Nil, RustgenVar(n), surface_out("type parameter"), 3, Nil),
      rustgen_with_scope(rest, all)
    )
  }
}
pub fn rustgen_scope_names(functions: List(RustgenFunction)): List(Text) {
  match functions: List(Text) {
    Nil => Nil
    Cons(f, rest) => if f.kind == 3 { Cons(f.name, rustgen_scope_names(rest)) } else {
      rustgen_scope_names(rest)
    }
  }
}

pub fn rustgen_fits(actual: RustgenType, expected: RustgenType): Bool {
  match rustgen_unify(10000, actual, expected, Nil): Bool {
    RustgenErr(message) => false
    RustgenOk(subst) => true
  }
}

pub fn rustgen_constructor_for(
  name: Text,
  ty: RustgenType,
  functions: List(RustgenFunction)
): RustgenResult(RustgenFunction) {
  match rustgen_find_function(name, functions): RustgenResult(RustgenFunction) {
    None => RustgenErr("unknown match constructor")
    Some(f) => if f.kind != 1 || rustgen_type_label(
      f.result
    ) != rustgen_type_label(
      ty
    ) { RustgenErr("constructor belongs to another type") } else { rustgen_specialize(f, ty) }
  }
}

pub fn rustgen_builtin_declarations(): List(RustgenFunction) {
  let a := RustgenVar("A")
  let names := Cons("A", Nil)
  let list := RustgenApply("List", Cons(a, Nil))
  let option := RustgenApply("Option", Cons(a, Nil))
  let dummy := surface_out("builtin")
  Cons(
    RustgenFunction::Mk("List", Nil, list, dummy, 2, names),
    Cons(
      RustgenFunction::Mk("Nil", Nil, list, dummy, 1, names),
      Cons(
        RustgenFunction::Mk(
          "Cons",
          Cons(RustgenBinding::Mk("head", a), Cons(RustgenBinding::Mk("tail", list), Nil)),
          list,
          dummy,
          1,
          names
        ),
        Cons(
          RustgenFunction::Mk("Option", Nil, option, dummy, 2, names),
          Cons(
            RustgenFunction::Mk("None", Nil, option, dummy, 1, names),
            Cons(
              RustgenFunction::Mk(
                "Some",
                Cons(RustgenBinding::Mk("value", a), Nil),
                option,
                dummy,
                1,
                names
              ),
              Nil
            )
          )
        )
      )
    )
  )
}
// Pair is the runtime prelude record when the source does not declare that name.
// Its constructor is internal: record syntax is the public construction form.
pub fn rustgen_builtin_pair(functions: List(RustgenFunction)): List(RustgenFunction) {
  match rustgen_find_function("Pair", functions): List(RustgenFunction) {
    Some(existing) => functions
    None => {
      let a := RustgenVar("A")
      let b := RustgenVar("B")
      let names := Cons("A", Cons("B", Nil))
      let pair := RustgenApply("Pair", Cons(a, Cons(b, Nil)))
      let dummy := surface_out("builtin")
      Cons(
        RustgenFunction::Mk("Pair", Nil, pair, dummy, 2, names),
        Cons(
          RustgenFunction::Mk(
            "Pair@record",
            Cons(RustgenBinding::Mk("fst", a), Cons(RustgenBinding::Mk("snd", b), Nil)),
            pair,
            dummy,
            1,
            names
          ),
          functions
        )
      )
    }
  }
}

pub fn rustgen_named_arm(name: Text, arms: List(SurfaceArm)): Option(SurfaceArm) {
  match arms: Option(SurfaceArm) {
    Nil => None
    Cons(arm, rest) => match rustgen_pattern_name(arm.pattern): Option(SurfaceArm) {
      None => rustgen_named_arm(name, rest)
      Some(found) => if found == name { Some(arm) } else { rustgen_named_arm(name, rest) }
    }
  }
}

pub fn rustgen_context_code(code: Text, ty: RustgenType): Text {
  Text::concat_all(
    Cons(
      "{ let __rg_value: ",
      Cons(rustgen_type_name(ty), Cons(" = ", Cons(code, Cons("; __rg_value }", Nil))))
    )
  )
}

// A projection can erase the argument that is the only numeric context of a
// literal. Resolve those literals without changing arguments shared by its result.
pub fn rustgen_field_receiver(value: RustgenValue, result: RustgenType): RustgenResult(Text) {
  if not(rustgen_pending_in_result(10000, value.ty, result)) {
    RustgenErr("cannot infer a projected-away type parameter")
  } else {
    match rustgen_call_generics(rustgen_type_args(value.ty), result): RustgenResult(Text) {
      RustgenErr(message) => RustgenErr(message)
      RustgenOk(args) => RustgenOk(
        rustgen_context_code(value.code, rustgen_family(rustgen_type_label(value.ty), args))
      )
    }
  }
}
