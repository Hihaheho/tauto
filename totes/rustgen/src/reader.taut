  pub fn rustgen_reader_opt_terms(
    k: Nat,
    &mut state: RustgenReaderState,
    items: List(Option(SurfaceTerm))
  ): List(Option(SurfaceTerm)) {
    ⊢ List(Option(SurfaceTerm)) from match k {
