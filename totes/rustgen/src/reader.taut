import "inputs.taut"
import "../../surface/src/surface.taut"
import "loader.taut"
import "../../text/src/text.taut"
import std::Base
import std::Text
import std::TextOps
import surface::dump

// A source reader, not a macro evaluator. Only an original written call whose
// parsed argument is Text can read a supplied resource. No source text is edited.
pub(open) inductive RustgenReaderDiagnostic: Type {
  Mk(
    stage: Text,
    code: Text,
    origin: Text,
    start: Nat,
    end: Nat,
    message: Text
  ): RustgenReaderDiagnostic
}
pub(open) inductive RustgenReaderState: Type {
  Mk(
    origin: Text,
    base: Nat,
    supplied: List(RustgenSource),
    resources: List(RustgenResource),
    error: Option(RustgenReaderDiagnostic)
  ): RustgenReaderState
}

pub fn rustgen_reader_set_to<A>(&mut slot: A, value: A): Unit {
  slot := value
}

pub fn rustgen_reader_error(
  &mut state: RustgenReaderState,
  stage: Text,
  code: Text,
  start: Nat,
  end: Nat,
  message: Text
): Unit {
  match state.error: Unit {
    Some(previous) => #()
    None => rustgen_reader_set_to(
      &mut state.error,
      Some(
        RustgenReaderDiagnostic::Mk(
          stage,
          code,
          state.origin,
          start - state.base,
          end - state.base,
          message
        )
      )
    )
  }
}
pub fn rustgen_reader_exhausted(&mut state: RustgenReaderState): Unit {
  rustgen_reader_error(
    &mut state,
    "reader-unsupported",
    "reader.limit",
    state.base,
    state.base,
    "reader traversal exhausted"
  )
}
pub fn rustgen_reader_ready(state: RustgenReaderState): Bool {
  match state.error: Bool {
    None => true
    Some(problem) => false
  }
}
pub fn rustgen_reader_diagnostic_text(d: RustgenReaderDiagnostic): Text {
  Text::concat_all(
    Cons(
      d.origin,
      Cons(
        ":",
        Cons(
          Text::of_nat(d.start),
          Cons(
            ":",
            Cons(Text::of_nat(d.end), Cons(": ", Cons(d.code, Cons(": ", Cons(d.message, Nil)))))
          )
        )
      )
    )
  )
}

pub fn rustgen_reader_include(
  &mut state: RustgenReaderState,
  term: SurfaceTerm,
  arg: SurfaceTerm
): SurfaceTerm {
  match arg.kind: SurfaceTerm {
    SkText(path) => if not(rustgen_input_path_bound(path)) {
      rustgen_reader_error(
        &mut state,
        "reader-unsupported",
        "reader.path",
        term.start,
        term.end,
        "resource path exceeds the input limit"
      )
      term
    } else if Text::len(path) == 0 {
      rustgen_reader_error(
        &mut state,
        "reader-rejected",
        "include.path",
        term.start,
        term.end,
        "the path is empty"
      )
      term
    } else if text_starts_with(path, "/", 0) {
      rustgen_reader_error(
        &mut state,
        "reader-rejected",
        "include.absolute",
        term.start,
        term.end,
        "the path must be relative to its source file"
      )
      term
    } else if not(rustgen_path_valid(path)) {
      rustgen_reader_error(
        &mut state,
        "reader-unsupported",
        "reader.path",
        term.start,
        term.end,
        "resource path is outside the portable input contract"
      )
      term
    } else {
      match rustgen_input_resource_path(state.origin, path, state.supplied): SurfaceTerm {
        RustgenErr(message) => {
          rustgen_reader_error(
            &mut state,
            "reader-rejected",
            "include.outside",
            term.start,
            term.end,
            "resource leaves its tote or source directory"
          )
          term
        }
        RustgenOk(Id) => if not(rustgen_input_path_bound(Id)) {
          rustgen_reader_error(
            &mut state,
            "reader-unsupported",
            "reader.path",
            term.start,
            term.end,
            "resolved resource path exceeds the input limit"
          )
          term
        } else {
          match rustgen_source_find(Id, state.supplied): SurfaceTerm {
            None => {
              rustgen_reader_error(
                &mut state,
                "reader-rejected",
                "include.read",
                term.start,
                term.end,
                "resource is not supplied"
              )
              term
            }
            Some(contents) => {
              let found := RustgenResource::Mk(
                Id,
                state.origin,
                term.start - state.base,
                term.end - state.base,
                Text::len(contents)
              )
              rustgen_reader_set_to(&mut state.resources, Cons(found, state.resources))
              surface_term_mk(SkText(contents), term.start, term.end)
            }
          }
        }
      }
    }
    _ => {
      rustgen_reader_error(
        &mut state,
        "reader-rejected",
        "include.argument",
        term.start,
        term.end,
        "include_text! takes one text literal"
      )
      term
    }
  }
}

mutual {
  pub fn rustgen_reader_terms(
    k: Nat,
    &mut state: RustgenReaderState,
    items: List(SurfaceTerm)
  ): List(SurfaceTerm) {
    match k: List(SurfaceTerm) {
      Zero => { rustgen_reader_exhausted(&mut state)
        items }
      Succ(j) => {
        match items: List(SurfaceTerm) {
          Nil => Nil
          Cons(item, rest) => {
            let first := rustgen_reader_term(j, &mut state, item)
            let more := rustgen_reader_terms(j, &mut state, rest)
            Cons(first, more)
          }
        }
      }
    }
  }

