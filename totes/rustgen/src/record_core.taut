import "bindings.taut"
import std::Text
pub(open) inductive RustgenRecordField: Type {
  Mk(name: Text, value: RustgenValue, local: Text): RustgenRecordField
}

pub fn rustgen_record_has_name(name: Text, fields: List(RustgenRecordField)): Bool {
  ⊢ Bool from match fields {
    Nil => false
    Cons(field, rest) => name == field.name || rustgen_record_has_name(name, rest)
  }
}
pub fn rustgen_record_unique(fields: List(RustgenRecordField)): Bool {
  ⊢ Bool from match fields {
    Nil => true
    Cons(field, rest) => not(
      rustgen_record_has_name(field.name, rest)
    ) && rustgen_record_unique(rest)
  }
}
// Bind written expressions once in their source order before field reordering.
pub fn rustgen_record_bindings(fields: List(RustgenRecordField)): Text {
  ⊢ Text from match fields {
    Nil => ""
    Cons(field, rest) => Text::concat(
      "let ",
      Text::concat(
        field.local,
        Text::concat(
          " = ",
          Text::concat(field.value.code, Text::concat("; ", rustgen_record_bindings(rest)))
        )
      )
    )
  }
}
pub fn rustgen_record_value(
  name: Text,
  fields: List(RustgenRecordField)
): RustgenResult(RustgenValue) {
  ⊢ RustgenResult(RustgenValue) from match fields {
    Nil => RustgenErr("missing record field")
    Cons(field, rest) => if name == field.name {
      RustgenOk(RustgenValue { ty: field.value.ty, code: field.local })
    } else { rustgen_record_value(name, rest) }
  }
}
pub fn rustgen_record_arguments(
  params: List(RustgenBinding),
  fields: List(RustgenRecordField)
): RustgenResult(List(RustgenValue)) {
  ⊢ RustgenResult(List(RustgenValue)) from match params {
    Nil => RustgenOk(Nil)
    Cons(param, rest) => ⊢ RustgenResult(List(RustgenValue)) from match rustgen_record_value(
      param.name,
      fields
    ) {
      RustgenErr(Message) => RustgenErr(Message)
      RustgenOk(value) => ⊢ RustgenResult(List(RustgenValue)) from match rustgen_record_arguments(
        rest,
        fields
      ) {
        RustgenErr(Message) => RustgenErr(Message)
        RustgenOk(more) => RustgenOk(Cons(value, more))
      }
    }
  }
}
