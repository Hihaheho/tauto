// Declaration variables are rigid. Substitution replaces them simultaneously;
// an inserted type is not substituted again in the same operation.
import "bindings.taut"
import "types.taut"
import std::Text
mutual {
  pub fn rustgen_substitute(
    k: Nat,
    ty: RustgenType,
    bindings: List(RustgenBinding)
  ): RustgenResult(RustgenType) {
    ⊢ RustgenResult(RustgenType) from match k {
      Zero => RustgenErr("generic substitution fuel exhausted")
      Succ(j) => ⊢ RustgenResult(RustgenType) from match ty {
        RustgenVar(name) => ⊢ RustgenResult(RustgenType) from match rustgen_find(name, bindings) {
          None => RustgenOk(ty)
          Some(value) => RustgenOk(value)
        }
        RustgenApply(name, args) => ⊢ RustgenResult(RustgenType) from match rustgen_substitute_many(
          j,
          args,
          bindings
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(values) => RustgenOk(RustgenApply(name, values))
        }
        RustgenCallable(params, result) => ⊢ RustgenResult(RustgenType) from match rustgen_substitute_many(
          j,
          params,
          bindings
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(types) => ⊢ RustgenResult(RustgenType) from match rustgen_substitute(
            j,
            result,
            bindings
          ) {
            RustgenErr(Message) => RustgenErr(Message)
            RustgenOk(value) => RustgenOk(RustgenCallable(types, value))
          }
        }
        RustgenNumber(Id, value) => RustgenOk(ty)
        RustgenInt => RustgenOk(ty)
        RustgenBool => RustgenOk(ty)
        RustgenText => RustgenOk(ty)
        RustgenNat => RustgenOk(ty)
        RustgenNamed(name) => RustgenOk(ty)
        RustgenMeta(name) => RustgenOk(ty)
      }
    }
  }
  pub fn rustgen_substitute_many(
    k: Nat,
    types: List(RustgenType),
    bindings: List(RustgenBinding)
  ): RustgenResult(List(RustgenType)) {
    ⊢ RustgenResult(List(RustgenType)) from match k {
      Zero => RustgenErr("generic substitution fuel exhausted")
      Succ(j) => ⊢ RustgenResult(List(RustgenType)) from match types {
        Nil => RustgenOk(Nil)
        Cons(ty, rest) => ⊢ RustgenResult(List(RustgenType)) from match rustgen_substitute(
          j,
          ty,
          bindings
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(value) => ⊢ RustgenResult(List(RustgenType)) from match rustgen_substitute_many(
            j,
            rest,
            bindings
          ) {
            RustgenErr(Message) => RustgenErr(Message)
            RustgenOk(values) => RustgenOk(Cons(value, values))
          }
        }
      }
    }
  }
}

// A substitution maps inference variables and numeric literals, never rigid type
// variables. Cycles and insufficient fuel
// are errors, rather than partially resolved types.
mutual {
  pub fn rustgen_resolve(
    k: Nat,
    ty: RustgenType,
    subst: List(RustgenBinding)
  ): RustgenResult(RustgenType) {
    ⊢ RustgenResult(RustgenType) from match k {
      Zero => RustgenErr("generic resolution fuel exhausted")
      Succ(j) => ⊢ RustgenResult(RustgenType) from match ty {
        RustgenMeta(name) => ⊢ RustgenResult(RustgenType) from match rustgen_find(name, subst) {
          None => RustgenOk(ty)
          Some(value) => rustgen_resolve(j, value, subst)
        }
        RustgenApply(name, args) => ⊢ RustgenResult(RustgenType) from match rustgen_resolve_many(
          j,
          args,
          subst
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(values) => RustgenOk(RustgenApply(name, values))
        }
        RustgenCallable(params, result) => ⊢ RustgenResult(RustgenType) from match rustgen_resolve_many(
          j,
          params,
          subst
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(types) => ⊢ RustgenResult(RustgenType) from match rustgen_resolve(j, result, subst) {
            RustgenErr(Message) => RustgenErr(Message)
            RustgenOk(value) => RustgenOk(RustgenCallable(types, value))
          }
        }
        RustgenNumber(Id, value) => ⊢ RustgenResult(RustgenType) from match rustgen_find(Id, subst) {
          None => RustgenOk(ty)
          Some(value) => rustgen_resolve(j, value, subst)
        }
        RustgenInt => RustgenOk(ty)
        RustgenBool => RustgenOk(ty)
        RustgenText => RustgenOk(ty)
        RustgenNat => RustgenOk(ty)
        RustgenNamed(name) => RustgenOk(ty)
        RustgenVar(name) => RustgenOk(ty)
      }
    }
  }
  pub fn rustgen_resolve_many(
    k: Nat,
    types: List(RustgenType),
    subst: List(RustgenBinding)
  ): RustgenResult(List(RustgenType)) {
    ⊢ RustgenResult(List(RustgenType)) from match k {
      Zero => RustgenErr("generic resolution fuel exhausted")
      Succ(j) => ⊢ RustgenResult(List(RustgenType)) from match types {
        Nil => RustgenOk(Nil)
        Cons(ty, rest) => ⊢ RustgenResult(List(RustgenType)) from match rustgen_resolve(j, ty, subst) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(value) => ⊢ RustgenResult(List(RustgenType)) from match rustgen_resolve_many(
            j,
            rest,
            subst
          ) {
            RustgenErr(Message) => RustgenErr(Message)
            RustgenOk(values) => RustgenOk(Cons(value, values))
          }
        }
      }
    }
  }
}

pub fn rustgen_meta_name(ty: RustgenType): Option(Text) {
  ⊢ Option(Text) from match ty {
    RustgenCallable(params, result) => None
    RustgenMeta(name) => Some(name)
    RustgenNumber(Id, value) => None
    RustgenInt => None
    RustgenBool => None
    RustgenText => None
    RustgenNat => None
    RustgenNamed(name) => None
    RustgenVar(name) => None
    RustgenApply(name, args) => None
  }
}

// Exhausting the traversal conservatively reports occurrence.
mutual {
  pub fn rustgen_occurs(k: Nat, name: Text, ty: RustgenType): Bool {
    ⊢ Bool from match k {
      Zero => true
      Succ(j) => ⊢ Bool from match ty {
        RustgenCallable(params, result) => rustgen_occurs_many(j, name, Cons(result, params))
        RustgenMeta(found) => name == found
        RustgenApply(owner, args) => rustgen_occurs_many(j, name, args)
        RustgenNumber(Id, value) => false
        RustgenInt => false
        RustgenBool => false
        RustgenText => false
        RustgenNat => false
        RustgenNamed(owner) => false
        RustgenVar(owner) => false
      }
    }
  }
  pub fn rustgen_occurs_many(k: Nat, name: Text, types: List(RustgenType)): Bool {
    ⊢ Bool from match k {
      Zero => true
      Succ(j) => ⊢ Bool from match types {
        Nil => false
        Cons(ty, rest) => rustgen_occurs(j, name, ty) || rustgen_occurs_many(j, name, rest)
      }
    }
  }
}

pub fn rustgen_bind_meta(
  k: Nat,
  name: Text,
  ty: RustgenType,
  subst: List(RustgenBinding)
): RustgenResult(List(RustgenBinding)) {
  ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_meta_name(ty) {
    Some(other) => if name == other { RustgenOk(subst) } else {
      RustgenOk(Cons(RustgenBinding::Mk(name, ty), subst))
    }
    None => if rustgen_occurs(k, name, ty) { RustgenErr("recursive generic type") } else {
      RustgenOk(Cons(RustgenBinding::Mk(name, ty), subst))
    }
  }
}

pub fn rustgen_unify_number(
  a: RustgenType,
  b: RustgenType,
  subst: List(RustgenBinding)
): RustgenResult(List(RustgenBinding)) {
  ⊢ RustgenResult(List(RustgenBinding)) from match a {
    RustgenNumber(Id, value) => ⊢ RustgenResult(List(RustgenBinding)) from match b {
      RustgenInt => if value <= 9223372036854775807 {
        RustgenOk(Cons(RustgenBinding::Mk(Id, b), subst))
      } else { RustgenErr("literal exceeds i64") }
      RustgenNat => RustgenOk(Cons(RustgenBinding::Mk(Id, b), subst))
      RustgenNumber(other, magnitude) => if Id == other { RustgenOk(subst) } else {
        RustgenOk(Cons(RustgenBinding::Mk(Id, b), subst))
      }
      RustgenCallable(params, result) => RustgenErr("numeric literal requires integer type")
      RustgenBool => RustgenErr("numeric literal requires integer type")
      RustgenText => RustgenErr("numeric literal requires integer type")
      RustgenNamed(name) => RustgenErr("numeric literal requires integer type")
      RustgenApply(name, args) => RustgenErr("numeric literal requires integer type")
      RustgenVar(name) => RustgenErr("numeric literal cannot specialize a rigid type")
      RustgenMeta(name) => RustgenErr("unresolved numeric constraint")
    }
    RustgenInt => ⊢ RustgenResult(List(RustgenBinding)) from match b {
      RustgenNumber(Id, value) => if value <= 9223372036854775807 {
        RustgenOk(Cons(RustgenBinding::Mk(Id, a), subst))
      } else { RustgenErr("literal exceeds i64") }
      RustgenInt => RustgenErr("expected numeric literal")
      RustgenNat => RustgenErr("expected numeric literal")
      RustgenCallable(params, result) => RustgenErr("numeric literal requires integer type")
      RustgenBool => RustgenErr("expected numeric literal")
      RustgenText => RustgenErr("expected numeric literal")
      RustgenNamed(name) => RustgenErr("expected numeric literal")
      RustgenApply(name, args) => RustgenErr("expected numeric literal")
      RustgenVar(name) => RustgenErr("expected numeric literal")
      RustgenMeta(name) => RustgenErr("expected numeric literal")
    }
    RustgenNat => ⊢ RustgenResult(List(RustgenBinding)) from match b {
      RustgenNumber(Id, value) => RustgenOk(Cons(RustgenBinding::Mk(Id, a), subst))
      RustgenInt => RustgenErr("expected numeric literal")
      RustgenNat => RustgenErr("expected numeric literal")
      RustgenCallable(params, result) => RustgenErr("numeric literal requires integer type")
      RustgenBool => RustgenErr("expected numeric literal")
      RustgenText => RustgenErr("expected numeric literal")
      RustgenNamed(name) => RustgenErr("expected numeric literal")
      RustgenApply(name, args) => RustgenErr("expected numeric literal")
      RustgenVar(name) => RustgenErr("expected numeric literal")
      RustgenMeta(name) => RustgenErr("expected numeric literal")
    }
    RustgenCallable(params, result) => RustgenErr("numeric literal requires integer type")
    RustgenBool => RustgenErr("numeric literal requires integer type")
    RustgenText => RustgenErr("numeric literal requires integer type")
    RustgenNamed(name) => RustgenErr("numeric literal requires integer type")
    RustgenApply(name, args) => RustgenErr("numeric literal requires integer type")
    RustgenVar(name) => RustgenErr("numeric literal cannot specialize a rigid type")
    RustgenMeta(name) => RustgenErr("unresolved numeric constraint")
  }
}

mutual {
  pub fn rustgen_unify(
    k: Nat,
    a: RustgenType,
    b: RustgenType,
    subst: List(RustgenBinding)
  ): RustgenResult(List(RustgenBinding)) {
    ⊢ RustgenResult(List(RustgenBinding)) from match k {
      Zero => RustgenErr("generic unification fuel exhausted")
      Succ(j) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_resolve(j, a, subst) {
        RustgenErr(Message) => RustgenErr(Message)
        RustgenOk(left) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_resolve(j, b, subst) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(right) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_meta_name(left) {
            Some(name) => rustgen_bind_meta(j, name, right, subst)
            None => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_meta_name(right) {
              Some(name) => rustgen_bind_meta(j, name, left, subst)
              None => if rustgen_type_tag(
                left
              ) == 8 || rustgen_type_tag(
                right
              ) == 8 { rustgen_unify_number(left, right, subst) } else if rustgen_type_tag(
                left
              ) != rustgen_type_tag(
                right
              ) || rustgen_type_label(
                left
              ) != rustgen_type_label(right) { RustgenErr("generic type mismatch") } else {
                rustgen_unify_many(j, rustgen_type_args(left), rustgen_type_args(right), subst)
              }
            }
          }
        }
      }
    }
  }
  pub fn rustgen_unify_many(
    k: Nat,
    xs: List(RustgenType),
    ys: List(RustgenType),
    subst: List(RustgenBinding)
  ): RustgenResult(List(RustgenBinding)) {
    ⊢ RustgenResult(List(RustgenBinding)) from match k {
      Zero => RustgenErr("generic unification fuel exhausted")
      Succ(j) => ⊢ RustgenResult(List(RustgenBinding)) from match xs {
        Nil => ⊢ RustgenResult(List(RustgenBinding)) from match ys {
          Nil => RustgenOk(subst)
          Cons(y, more) => RustgenErr("generic type arity mismatch")
        }
        Cons(x, rest) => ⊢ RustgenResult(List(RustgenBinding)) from match ys {
          Nil => RustgenErr("generic type arity mismatch")
          Cons(y, more) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_unify(
            j,
            x,
            y,
            subst
          ) {
            RustgenErr(Message) => RustgenErr(Message)
            RustgenOk(next) => rustgen_unify_many(j, rest, more, next)
          }
        }
      }
    }
  }
}

mutual {
  pub fn rustgen_closed_in(k: Nat, ty: RustgenType): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ty {
        RustgenCallable(params, result) => rustgen_closed_many(j, Cons(result, params))
        RustgenMeta(name) => false
        RustgenApply(name, args) => rustgen_closed_many(j, args)
        RustgenNumber(Id, value) => true
        RustgenInt => true
        RustgenBool => true
        RustgenText => true
        RustgenNat => true
        RustgenNamed(name) => true
        RustgenVar(name) => true
      }
    }
  }
  pub fn rustgen_closed_many(k: Nat, types: List(RustgenType)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match types {
        Nil => true
        Cons(ty, rest) => rustgen_closed_in(j, ty) && rustgen_closed_many(j, rest)
      }
    }
  }
}

pub fn rustgen_closed(ty: RustgenType): Bool { rustgen_closed_in(10000, ty) }

pub fn rustgen_generic_member(name: Text, names: List(Text)): Bool {
  ⊢ Bool from match names {
    Nil => false
    Cons(first, rest) => name == first || rustgen_generic_member(name, rest)
  }
}

mutual {
  pub fn rustgen_vars(k: Nat, ty: RustgenType, names: List(Text)): RustgenResult(RustgenType) {
    ⊢ RustgenResult(RustgenType) from match k {
      Zero => RustgenErr("generic declaration fuel exhausted")
      Succ(j) => ⊢ RustgenResult(RustgenType) from match ty {
        RustgenNamed(name) => if rustgen_generic_member(
          name,
          names
        ) { RustgenOk(RustgenVar(name)) } else { RustgenOk(ty) }
        RustgenApply(name, args) => if rustgen_generic_member(
          name,
          names
        ) { RustgenErr("higher-kinded generic parameters are unsupported") } else {
          ⊢ RustgenResult(RustgenType) from match rustgen_vars_many(j, args, names) {
            RustgenErr(Message) => RustgenErr(Message)
            RustgenOk(values) => RustgenOk(RustgenApply(name, values))
          }
        }
        RustgenCallable(params, result) => ⊢ RustgenResult(RustgenType) from match rustgen_vars_many(
          j,
          params,
          names
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(types) => ⊢ RustgenResult(RustgenType) from match rustgen_vars(j, result, names) {
            RustgenErr(Message) => RustgenErr(Message)
            RustgenOk(value) => RustgenOk(RustgenCallable(types, value))
          }
        }
        RustgenNumber(Id, value) => RustgenOk(ty)
        RustgenInt => RustgenOk(ty)
        RustgenBool => RustgenOk(ty)
        RustgenText => RustgenOk(ty)
        RustgenNat => RustgenOk(ty)
        RustgenVar(name) => RustgenOk(ty)
        RustgenMeta(name) => RustgenErr("inference variable in declaration")
      }
    }
  }
  pub fn rustgen_vars_many(
    k: Nat,
    types: List(RustgenType),
    names: List(Text)
  ): RustgenResult(List(RustgenType)) {
    ⊢ RustgenResult(List(RustgenType)) from match k {
      Zero => RustgenErr("generic declaration fuel exhausted")
      Succ(j) => ⊢ RustgenResult(List(RustgenType)) from match types {
        Nil => RustgenOk(Nil)
        Cons(ty, rest) => ⊢ RustgenResult(List(RustgenType)) from match rustgen_vars(j, ty, names) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(value) => ⊢ RustgenResult(List(RustgenType)) from match rustgen_vars_many(
            j,
            rest,
            names
          ) {
            RustgenErr(Message) => RustgenErr(Message)
            RustgenOk(values) => RustgenOk(Cons(value, values))
          }
        }
      }
    }
  }
}

pub fn rustgen_instantiate(prefix: Text, names: List(Text)): List(RustgenBinding) {
  ⊢ List(RustgenBinding) from match names {
    Nil => Nil
    Cons(name, rest) => Cons(
      RustgenBinding::Mk(name, RustgenMeta(Text::concat(prefix, Text::concat(":", name)))),
      rustgen_instantiate(prefix, rest)
    )
  }
}

pub fn rustgen_substitute_bindings(
  k: Nat,
  params: List(RustgenBinding),
  subst: List(RustgenBinding)
): RustgenResult(List(RustgenBinding)) {
  ⊢ RustgenResult(List(RustgenBinding)) from match k {
    Zero => RustgenErr("generic binding substitution fuel exhausted")
    Succ(j) => ⊢ RustgenResult(List(RustgenBinding)) from match params {
      Nil => RustgenOk(Nil)
      Cons(param, rest) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_substitute(
        j,
        param.ty,
        subst
      ) {
        RustgenErr(Message) => RustgenErr(Message)
        RustgenOk(ty) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_substitute_bindings(
          j,
          rest,
          subst
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(more) => RustgenOk(Cons(RustgenBinding::Mk(param.name, ty), more))
        }
      }
    }
  }
}

pub fn rustgen_vars_bindings(
  k: Nat,
  params: List(RustgenBinding),
  names: List(Text)
): RustgenResult(List(RustgenBinding)) {
  ⊢ RustgenResult(List(RustgenBinding)) from match k {
    Zero => RustgenErr("generic binding declaration fuel exhausted")
    Succ(j) => ⊢ RustgenResult(List(RustgenBinding)) from match params {
      Nil => RustgenOk(Nil)
      Cons(param, rest) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_vars(
        j,
        param.ty,
        names
      ) {
        RustgenErr(Message) => RustgenErr(Message)
        RustgenOk(ty) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_vars_bindings(
          j,
          rest,
          names
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(more) => RustgenOk(Cons(RustgenBinding::Mk(param.name, ty), more))
        }
      }
    }
  }
}

pub fn rustgen_resolve_bindings(
  k: Nat,
  params: List(RustgenBinding),
  subst: List(RustgenBinding)
): RustgenResult(List(RustgenBinding)) {
  ⊢ RustgenResult(List(RustgenBinding)) from match k {
    Zero => RustgenErr("generic binding resolution fuel exhausted")
    Succ(j) => ⊢ RustgenResult(List(RustgenBinding)) from match params {
      Nil => RustgenOk(Nil)
      Cons(param, rest) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_resolve(
        j,
        param.ty,
        subst
      ) {
        RustgenErr(Message) => RustgenErr(Message)
        RustgenOk(ty) => ⊢ RustgenResult(List(RustgenBinding)) from match rustgen_resolve_bindings(
          j,
          rest,
          subst
        ) {
          RustgenErr(Message) => RustgenErr(Message)
          RustgenOk(more) => RustgenOk(Cons(RustgenBinding::Mk(param.name, ty), more))
        }
      }
    }
  }
}
