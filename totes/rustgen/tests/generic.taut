import "../src/generic.taut"
import "../src/generic_core.taut"
import "../src/types.taut"
pub fn rg_test_reject(a: RustgenType, b: RustgenType): Bool {
  match rustgen_unify(100, a, b, Nil): Bool {
    RustgenErr(message) => true
    RustgenOk(subst) => false
  }
}
pub fn rg_test_resolution(a: RustgenType, b: RustgenType, wanted: RustgenType): Bool {
  match rustgen_unify(100, a, b, Nil): Bool {
    RustgenErr(message) => false
    RustgenOk(subst) => match rustgen_resolve(100, a, subst): Bool {
      RustgenErr(message) => false
      RustgenOk(result) => rustgen_same(result, wanted)
    }
  }
}
pub fn rg_test_simultaneous(): Bool {
  let bindings := Cons(
    RustgenBinding::Mk("A", RustgenVar("B")),
    Cons(RustgenBinding::Mk("B", RustgenInt), Nil)
  )
  match rustgen_substitute(100, RustgenVar("A"), bindings): Bool {
    RustgenErr(message) => false
    RustgenOk(result) => rustgen_same(result, RustgenVar("B"))
  }
}
pub fn rg_test_cycle_resolution(): Bool {
  let subst := Cons(
    RustgenBinding::Mk("x", RustgenMeta("y")),
    Cons(RustgenBinding::Mk("y", RustgenMeta("x")), Nil)
  )
  match rustgen_resolve(10, RustgenMeta("x"), subst): Bool {
    RustgenErr(message) => true
    RustgenOk(value) => false
  }
}
pub theorem rg_meta_binds(): rg_test_resolution(RustgenMeta("x"), RustgenInt, RustgenInt) = true { Refl }
pub theorem rg_nested_binds(): rg_test_resolution(
    RustgenApply("List", Cons(RustgenMeta("x"), Nil)),
    RustgenApply("List", Cons(RustgenText, Nil)),
    RustgenApply("List", Cons(RustgenText, Nil))
  ) = true { Refl }
pub theorem rg_occurs_reject(): rg_test_reject(RustgenMeta("x"), RustgenApply("List", Cons(RustgenMeta("x"), Nil))) = true { Refl }
pub theorem rg_rigid_reject(): rg_test_reject(RustgenVar("A"), RustgenInt) = true { Refl }
pub theorem rg_arity_reject(): rg_test_reject(
    RustgenApply("Pair", Cons(RustgenInt, Nil)),
    RustgenApply("Pair", Cons(RustgenInt, Cons(RustgenInt, Nil)))
  ) = true { Refl }
pub theorem rg_simultaneous(): rg_test_simultaneous() = true { Refl }
pub theorem rg_cycle(): rg_test_cycle_resolution() = true { Refl }
pub fn rg_test_indirect_occurs(): Bool {
  match rustgen_unify(100, RustgenMeta("x"), RustgenMeta("y"), Nil): Bool {
    RustgenErr(message) => false
    RustgenOk(subst) => match rustgen_unify(
      100,
      RustgenMeta("y"),
      RustgenApply("List", Cons(RustgenMeta("x"), Nil)),
      subst
    ): Bool {
      RustgenErr(message) => true
      RustgenOk(next) => false
    }
  }
}
pub fn rg_test_shared_constraint(): Bool {
  let left := Cons(RustgenMeta("x"), Cons(RustgenMeta("x"), Nil))
  let right := Cons(RustgenInt, Cons(RustgenText, Nil))
  match rustgen_unify_many(100, left, right, Nil): Bool {
    RustgenErr(message) => true
    RustgenOk(next) => false
  }
}
pub theorem rg_indirect_occurs(): rg_test_indirect_occurs() = true { Refl }
pub theorem rg_shared_constraint(): rg_test_shared_constraint() = true { Refl }

pub fn rg_test_numeric_refinement(): Bool {
  let xs := Cons(RustgenMeta("A"), Cons(RustgenMeta("A"), Nil))
  let ys := Cons(RustgenNumber("literal:1", 1), Cons(RustgenNat, Nil))
  match rustgen_unify_many(100, xs, ys, Nil): Bool {
    RustgenErr(message) => false
    RustgenOk(subst) => match rustgen_resolve(100, RustgenMeta("A"), subst): Bool {
      RustgenErr(message) => false
      RustgenOk(ty) => rustgen_same(ty, RustgenNat)
    }
  }
}
pub theorem rg_numeric_refinement(): rg_test_numeric_refinement() = true { Refl }
pub theorem rg_numeric_bool_reject(): rg_test_reject(RustgenNumber("literal:2", 1), RustgenBool) = true { Refl }

pub theorem rg_literal_identity(): rustgen_same(RustgenNumber("a", 1), RustgenNumber("a", 1)) = true { Refl }
pub theorem rg_literal_distinct_ids(): rustgen_same(RustgenNumber("a", 1), RustgenNumber("b", 1)) = false { Refl }
pub theorem rg_literal_distinct_values(): rustgen_same(RustgenNumber("a", 1), RustgenNumber("a", 2)) = false { Refl }
pub theorem rg_literal_compatibility(): rg_test_resolution(RustgenNumber("a", 1), RustgenNumber("b", 2), RustgenNumber("b", 2)) = true { Refl }
