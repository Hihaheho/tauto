import "kernel.taut"
import "check.taut"
import "data.taut"
import "inductive.taut"
import "level.taut"
import "term.taut"
import std::List

// These are computations of the implementation, checked with no axioms.
pub fn kernel_result_verdict(result: Mut1(KernelVerdict, KernelCore)): KernelVerdict {
  ⊢ KernelVerdict from match result {
    mut1(verdict, state) => verdict
  }
}

pub theorem kernel_inst_identity(value: KernelTerm): kernel_inst(KernelBVar(0), value) = value {
  Refl
}

pub theorem kernel_inst_under_binder(
  value: KernelTerm
): kernel_inst(kernel_lam(KernelBVar(1)), KernelLit(7)) = kernel_lam(KernelLit(7)) {
  Refl
}

pub theorem kernel_inst_keeps_closed_part(
  value: KernelTerm
): kernel_inst(kernel_lam(KernelBVar(0)), value) = kernel_lam(KernelBVar(0)) {
  Refl
}

pub theorem kernel_exhaustion_restores_state(): kernel_execute(
  0,
  kernel_new(),
  KernelDeclare("unfinished", KernelSortTerm(KernelProp), None, false)
) = mut1(KernelExhausted, kernel_new()) {
  Refl
}

pub theorem kernel_quotient_computes(): kernel_divmod(130, 17, 5).fst = 3 {
  Refl
}

pub theorem kernel_remainder_computes(): kernel_divmod(130, 17, 5).snd = 2 {
  Refl
}

pub theorem kernel_rejection_restores_state(): kernel_execute(
  10,
  kernel_new(),
  KernelDeclare("invalid", KernelBVar(0), None, false)
) = mut1(KernelRejected, kernel_new()) {
  Refl
}

pub theorem kernel_recursor_unknown_restores_state(): kernel_execute(
  10,
  kernel_new(),
  KernelRecursor("missing", 2)
) = mut1(KernelRejected, kernel_new()) {
  Refl
}

pub theorem kernel_recursor_motive_keeps_domain(): kernel_motive_at(
  10,
  kernel_new(),
  kernel_pi(
    KernelSortTerm(KernelType(KernelLevel::Mk(3, Nil))),
    KernelSortTerm(KernelType(KernelLevel::Mk(1, Nil)))
  ),
  2
) = mut1(
  Some(
    kernel_pi(
      KernelSortTerm(KernelType(KernelLevel::Mk(3, Nil))),
      KernelSortTerm(KernelType(KernelLevel::Mk(2, Nil)))
    )
  ),
  kernel_new()
) {
  Refl
}
