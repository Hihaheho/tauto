import "kernel.taut"

// These are computations of the implementation, checked with no axioms.
pub fn kernel_result_verdict(result: Mut1(KernelVerdict, KernelCore)): KernelVerdict {
  match result: KernelVerdict {
    mut1(verdict, state) => verdict
  }
}

pub theorem kernel_inst_identity(
  value: KernelTerm
): kernel_inst(KernelBVar(0), value) = value {
  Refl
}

pub theorem kernel_inst_under_binder(
  value: KernelTerm
): kernel_inst(KernelLam(KernelBVar(1)), value) = KernelLam(value) {
  Refl
}

pub theorem kernel_exhaustion_restores_state(): kernel_execute(
    0,
    kernel_new(),
    KernelDeclare("unfinished", KernelSortTerm(KernelProp), None, false)
  ) = mut1(KernelExhausted, kernel_new()) {
  Refl
}

pub theorem kernel_wide_checked_rejects_overflow(): kernel_digits_checked(List::replicate(9, 1)) = None {
  Refl
}

pub theorem kernel_wide_carry_zero(): kernel_digits_carry(Nil, 1) = Cons(1, Nil) {
  Refl
}

pub theorem kernel_rejection_restores_state(): kernel_execute(10, kernel_new(), KernelDeclare("invalid", KernelBVar(0), None, false)) = mut1(KernelRejected, kernel_new()) {
  Refl
}

pub theorem kernel_recursor_unknown_restores_state(): kernel_execute(10, kernel_new(), KernelRecursor("missing", 2)) = mut1(KernelRejected, kernel_new()) {
  Refl
}

pub theorem kernel_recursor_motive_keeps_domain(): kernel_motive_at(
    10,
    kernel_new(),
    KernelPi(
      KernelSortTerm(KernelType(KernelLevel::Mk(3, Nil))),
      KernelSortTerm(KernelType(KernelLevel::Mk(1, Nil)))
    ),
    2
  ) = mut1(
    Some(
      KernelPi(
        KernelSortTerm(KernelType(KernelLevel::Mk(3, Nil))),
        KernelSortTerm(KernelType(KernelLevel::Mk(2, Nil)))
      )
    ),
    kernel_new()
  ) {
  Refl
}
