import "term.taut"
import "level.taut"
import "wide.taut"
import std::List
import std::Base

pub(open) inductive KernelGlobal: Type {
  Mk(name: Text, ty: KernelTerm, value: Option(KernelTerm)): KernelGlobal
}

pub(open) inductive KernelRecArg: Type {
  Mk(arg: Nat, ys: Nat, family: Nat, indices: List(KernelTerm)): KernelRecArg
}

pub(open) inductive KernelCtorInfo: Type {
  Mk(name: Text, nargs: Nat, recursive: List(KernelRecArg)): KernelCtorInfo
}

pub(open) inductive KernelIndInfo: Type {
  Mk(
    name: Text,
    params: Nat,
    indices: Nat,
    group: List(Text),
    position: Nat,
    constructors: List(KernelCtorInfo),
    alias: Option(Pair(Text, List(KernelTerm))),
    k_like: Option(List(KernelTerm))
  ): KernelIndInfo
}

pub(open) inductive KernelCore: Type {
  Mk(
    globals: List(KernelGlobal),
    inductives: List(KernelIndInfo),
    constructors: List(Pair(Text, Pair(Text, Nat))),
    eliminators: List(Pair(Text, Text)),
    locals: List(Pair(Nat, KernelTerm)),
    next: Nat,
    exhausted: Bool,
    quotient: List(Text)
  ): KernelCore
}

pub(open) inductive KernelFamily: Type {
  Mk(
    name: Text,
    ty: KernelTerm,
    constructors: List(Pair(Text, KernelTerm))
  ): KernelFamily
}

pub(open) inductive KernelCommand: Type {
  KernelForget(name: Text): KernelCommand
  KernelDeclare(
    name: Text,
    ty: KernelTerm,
    value: Option(KernelTerm),
    transparent: Bool
  ): KernelCommand
  KernelConstant(name: Text, value: KernelTerm): KernelCommand
  KernelSetValue(name: Text, value: KernelTerm): KernelCommand
  KernelInductive(families: List(KernelFamily), params: Nat, sort: KernelSort): KernelCommand
  KernelRecursor(family: Text, level: Nat): KernelCommand
  KernelCheck(value: KernelTerm, ty: KernelTerm): KernelCommand
  KernelConvert(left: KernelTerm, right: KernelTerm): KernelCommand
}

pub(open) inductive KernelVerdict: Type {
  KernelAccepted: KernelVerdict
  KernelRejected: KernelVerdict
  KernelExhausted: KernelVerdict
}

pub fn kernel_list_find_KernelGlobal_Bool(
  f: (KernelGlobal) -> Bool,
  xs: List(KernelGlobal)
): Option(KernelGlobal) { List::find(f, xs) }

pub fn kernel_list_find_KernelIndInfo_Bool(
  f: (KernelIndInfo) -> Bool,
  xs: List(KernelIndInfo)
): Option(KernelIndInfo) { List::find(f, xs) }

pub fn kernel_list_filter_KernelGlobal_Bool(
  f: (KernelGlobal) -> Bool,
  xs: List(KernelGlobal)
): List(KernelGlobal) { List::filter(f, xs) }

pub fn kernel_list_map_Text_KernelGlobal(
  f: (Text) -> KernelGlobal,
  xs: List(Text)
): List(KernelGlobal) { List::map(f, xs) }

pub fn kernel_list_all_Nat_Bool(f: (Nat) -> Bool, xs: List(Nat)): Bool { List::all(f, xs) }

pub fn kernel_lookup<A>(entries: List(Pair(Text, A)), key: Text): Option(A) {
  match entries: Option(A) {
    Nil => None
    Cons(entry, rest) => if entry.fst == key { Some(entry.snd) } else { kernel_lookup(rest, key) }
  }
}

pub fn kernel_global_named(g: KernelGlobal, name: Text): Bool { g.name == name }
pub fn kernel_ind_named(i: KernelIndInfo, name: Text): Bool { i.name == name }

pub fn kernel_global_get(gs: List(KernelGlobal), name: Text): Option(KernelGlobal) {
  kernel_list_find_KernelGlobal_Bool((g: KernelGlobal) => kernel_global_named(g, name), gs)
}

pub fn kernel_ind_get(is: List(KernelIndInfo), name: Text): Option(KernelIndInfo) {
  kernel_list_find_KernelIndInfo_Bool((i: KernelIndInfo) => kernel_ind_named(i, name), is)
}

pub fn kernel_local_get(ls: List(Pair(Nat, KernelTerm)), atom: Nat): Option(KernelTerm) {
  match ls: Option(KernelTerm) {
    Nil => None

    Cons(entry, rest) => if entry.fst == atom { Some(entry.snd) } else {
      kernel_local_get(rest, atom)
    }
  }
}

pub fn kernel_set_to<A>(&mut slot: A, value: A): Unit {
  slot := value
}

pub fn kernel_fresh(&mut c: KernelCore, ty: KernelTerm): Nat {
  kernel_set_to(&mut c.next, Succ(c.next))
  kernel_set_to(&mut c.locals, Cons(Pair { fst: c.next, snd: ty }, c.locals))
  c.next
}

pub fn kernel_put_global(
  &mut c: KernelCore,
  name: Text,
  ty: KernelTerm,
  value: Option(KernelTerm)
): Unit {
  kernel_set_to(
    &mut c.globals,
    Cons(
      KernelGlobal::Mk(name, ty, value),
      kernel_list_filter_KernelGlobal_Bool(
        (g: KernelGlobal) => not(kernel_global_named(g, name)),
        c.globals
      )
    )
  )
}

pub fn kernel_fresh_name(c: KernelCore, name: Text): Bool {
  match kernel_global_get(c.globals, name): Bool {
    None => true
    Some(g) => false }
}

pub fn kernel_new(): KernelCore {
  let nat := KernelConst("Nat")
  let binary := KernelPi(nat, KernelPi(nat, nat))
  KernelCore::Mk(
    Cons(
      KernelGlobal::Mk("Bool", KernelSortTerm(KernelType(KernelLevel::Mk(0, Nil))), None),
      kernel_list_map_Text_KernelGlobal(
        (op: Text) => KernelGlobal::Mk(op, binary, None),
        Cons("+", Cons("*", Cons("-", Nil)))
      )
    ),
    Nil,
    Nil,
    Nil,
    Nil,
    0,
    false,
    Nil
  )
}

pub fn kernel_text_in(xs: List(Text), name: Text): Bool {
  match xs: Bool {
    Nil => false
    Cons(x, rest) => if x == name { true } else { kernel_text_in(rest, name) }
  }
}

fn kernel_quot_sort_type(): KernelTerm { KernelSortTerm(KernelType(KernelLevel::Mk(0, Nil))) }

// `(A, A) -> Prop`, where `A` is the bound variable `a`.
fn kernel_quot_rel(a: Nat): KernelTerm {
  KernelPi(KernelBVar(a), KernelPi(KernelBVar(Succ(a)), KernelSortTerm(KernelProp)))
}

fn kernel_quot_of(a: Nat, r: Nat): KernelTerm {
  KernelApp(KernelApp(KernelConst("Quot"), KernelBVar(a)), KernelBVar(r))
}

fn kernel_quot_over(rest: KernelTerm): KernelTerm {
  KernelPi(kernel_quot_sort_type(), KernelPi(kernel_quot_rel(0), rest))
}

// The type each of the quotient's constants must be declared with, the
// same as `quot_type` of `crates/tauto-kernel/src/check/core.rs`; `None`
// for every other name.
pub fn kernel_quot_type(name: Text): Option(KernelTerm) {
  if name == "Quot" {
    Some(kernel_quot_over(kernel_quot_sort_type()))
  } else {
    if name == "Quot::mk" {
      Some(kernel_quot_over(KernelPi(KernelBVar(1), kernel_quot_of(2, 1))))
    } else {
      if name == "Quot::lift" {
        let respects := KernelPi(
          KernelBVar(3),
          KernelPi(
            KernelBVar(4),
            KernelPi(
              KernelApp(KernelApp(KernelBVar(4), KernelBVar(1)), KernelBVar(0)),
              KernelApp(
                KernelApp(
                  KernelApp(KernelConst("Eq"), KernelBVar(4)),
                  KernelApp(KernelBVar(3), KernelBVar(2))
                ),
                KernelApp(KernelBVar(3), KernelBVar(1))
              )
            )
          )
        )
        Some(
          kernel_quot_over(
            KernelPi(
              kernel_quot_sort_type(),
              KernelPi(
                KernelPi(KernelBVar(2), KernelBVar(1)),
                KernelPi(respects, KernelPi(kernel_quot_of(4, 3), KernelBVar(3)))
              )
            )
          )
        )
      } else {
        if name == "Quot::ind" {
          let mk := KernelApp(
            KernelApp(KernelApp(KernelConst("Quot::mk"), KernelBVar(3)), KernelBVar(2)),
            KernelBVar(0)
          )
          Some(
            kernel_quot_over(
              KernelPi(
                KernelPi(kernel_quot_of(1, 0), KernelSortTerm(KernelProp)),
                KernelPi(
                  KernelPi(KernelBVar(2), KernelApp(KernelBVar(1), mk)),
                  KernelPi(kernel_quot_of(3, 2), KernelApp(KernelBVar(2), KernelBVar(0)))
                )
              )
            )
          )
        } else { None }
      }
    }
  }
}

// The constants a quotient constant mentions, which must be declared first.
pub fn kernel_quot_needs(name: Text): List(Text) {
  if name == "Quot" { Nil } else {
    if name == "Quot::ind" { Cons("Quot", Cons("Quot::mk", Nil)) } else { Cons("Quot", Nil) }
  }
}

pub fn kernel_all_in(names: List(Text), xs: List(Text)): Bool {
  match names: Bool {
    Nil => true
    Cons(n, rest) => if kernel_text_in(xs, n) { kernel_all_in(rest, xs) } else { false }
  }
}

pub fn kernel_closed(t: KernelTerm): Bool {
  not(kernel_has_loose(t, 0)) && not(kernel_mentions_fvar(t))
}

pub fn kernel_valid_digits(ds: List(Nat)): Bool {
  List::length(
    ds
  ) <= 8 && kernel_list_all_Nat_Bool(
    (d: Nat) => d < 65536,
    ds
  ) && kernel_digits_eq(ds, kernel_digits_normal(ds))
}

pub fn kernel_term_valid(t: KernelTerm, depth: Nat): Bool {
  match t: Bool {
    KernelBVar(i) => i < depth
    KernelFVar(x) => false
    KernelSortTerm(s) => true
    KernelConst(n) => true
    KernelPi(a, b) => kernel_term_valid(a, depth) && kernel_term_valid(b, Succ(depth))
    KernelLam(b) => kernel_term_valid(b, Succ(depth))
    KernelApp(f, a) => kernel_term_valid(f, depth) && kernel_term_valid(a, depth)
    KernelLit(ds) => kernel_valid_digits(ds)
    KernelBool(v) => true
  }
}

pub fn kernel_as_pi(t: KernelTerm): Option(@domain KernelTerm × @codomain KernelTerm) {
  match t: Option(@domain KernelTerm × @codomain KernelTerm) {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => None
    KernelPi(a, b) => Some(#(@domain a, @codomain b))
    KernelLam(b) => None
    KernelApp(f, a) => None
    KernelLit(ds) => None
    KernelBool(v) => None
  }
}

pub fn kernel_as_lam(t: KernelTerm): Option(KernelTerm) {
  match t: Option(KernelTerm) {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => None
    KernelPi(a, b) => None
    KernelLam(b) => Some(b)
    KernelApp(f, a) => None
    KernelLit(ds) => None
    KernelBool(v) => None
  }
}

pub fn kernel_as_const(t: KernelTerm): Option(Text) {
  match t: Option(Text) {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => Some(n)
    KernelPi(a, b) => None
    KernelLam(b) => None
    KernelApp(f, a) => None
    KernelLit(ds) => None
    KernelBool(v) => None
  }
}

pub fn kernel_as_sort(t: KernelTerm): Option(KernelSort) {
  match t: Option(KernelSort) {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => Some(s)
    KernelConst(n) => None
    KernelPi(a, b) => None
    KernelLam(b) => None
    KernelApp(f, a) => None
    KernelLit(ds) => None
    KernelBool(v) => None
  }
}

pub fn kernel_as_lit(t: KernelTerm): Option(List(Nat)) {
  match t: Option(List(Nat)) {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => None
    KernelPi(a, b) => None
    KernelLam(b) => None
    KernelApp(f, a) => None
    KernelLit(ds) => Some(ds)
    KernelBool(v) => None
  }
}

pub fn kernel_nat_view(t: KernelTerm): Option(Option(KernelTerm)) {
  match kernel_as_lit(t): Option(Option(KernelTerm)) {
    Some(ds) => if kernel_digits_eq(ds, Nil) { Some(None) } else {
      Some(Some(KernelLit(kernel_digits_normal(kernel_digits_sub(ds, Cons(1, Nil), 0)))))
    }
    None => match kernel_as_const(t): Option(Option(KernelTerm)) {
      Some(n) => if n == "Zero" { Some(None) } else { None }
      None => { let sp := kernel_spine(t)
        match kernel_as_const(sp.fst): Option(Option(KernelTerm)) {
          None => None

          Some(n) => if n == "Succ" && List::length(
            sp.snd
          ) == 1 { Some(List::head(sp.snd)) } else { None }
        }
      }
    }
  }
}

pub fn kernel_expand_lit(t: KernelTerm): KernelTerm {
  match kernel_as_lit(t): KernelTerm {
    None => t
    Some(ds) => if kernel_digits_eq(ds, Nil) { KernelConst("Zero") } else {
      KernelApp(
        KernelConst("Succ"),
        KernelLit(kernel_digits_normal(kernel_digits_sub(ds, Cons(1, Nil), 0)))
      )
    }
  }
}

pub fn kernel_unfold_head(c: KernelCore, t: KernelTerm): Option(KernelTerm) {
  let sp := kernel_spine(t)
  match kernel_as_const(sp.fst): Option(KernelTerm) {
    None => None
    Some(n) => match kernel_global_get(c.globals, n): Option(KernelTerm) {
      None => None
      Some(g) => match g.value: Option(KernelTerm) {
        None => None
        Some(v) => Some(kernel_apps(v, sp.snd))
      }
    }
  }
}

pub fn kernel_bind_pis(xs: List(Pair(Nat, KernelTerm)), body: KernelTerm): KernelTerm {
  match xs: KernelTerm {
    Nil => body
    Cons(x, rest) => kernel_pi_over(x.fst, x.snd, kernel_bind_pis(rest, body))
  }
}

pub fn kernel_bind_lams(xs: List(Nat), body: KernelTerm): KernelTerm {
  match xs: KernelTerm {
    Nil => body
    Cons(x, rest) => kernel_lam_over(x, kernel_bind_lams(rest, body)) }
}
