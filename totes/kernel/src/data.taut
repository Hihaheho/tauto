import "term.taut"
import "level.taut"
import std::List
import std::Map
import std::Text
import std::Base

pub(open) inductive KernelGlobal: Type {
  Mk(ty: KernelTerm, value: Option(KernelTerm)): KernelGlobal
}

pub(open) inductive KernelRecArg: Type {
  Mk(arg: Nat, ys: Nat, family: Nat, indices: List(KernelTerm)): KernelRecArg
}

pub(open) inductive KernelCtorInfo: Type {
  Mk(name: Text, nargs: Nat, recursive: List(KernelRecArg)): KernelCtorInfo
}

pub(open) inductive KernelIndInfo: Type {
  Mk(
    name: Text,
    params: Nat,
    indices: Nat,
    group: List(Text),
    position: Nat,
    constructors: List(KernelCtorInfo),
    alias: Option(Pair(Text, List(KernelTerm))),
    k_like: Option(List(KernelTerm))
  ): KernelIndInfo
}

// What lazy unfolding knows of a name with a value: one more than the
// highest name its value uses, and whether its value uses it again.
pub(open) inductive KernelDef: Type {
  Mk(height: Nat, recursive: Bool): KernelDef
}

// The declarations, by name. `eliminators` maps an eliminator to its family
// and `targets` to the eliminators of the group it was made with, in the
// order of the group. `defs` keeps what `kernel_def` found, and is emptied
// whenever a value changes. `locals` are the types of the atoms. A
// conversion keeps the recursive names it unfolded (`unfolded`, with the
// number of binders it had gone under then) and the binders it is under.
// `whnfs` keeps the weak head normal forms found while a command is checked,
// and `conv_fail` the pairs found different during the outermost conversion
// (`conv_depth` deep).
pub(open) inductive KernelCore: Type {
  Mk(
    globals: Ordmap(Text, KernelGlobal),
    inductives: Ordmap(Text, KernelIndInfo),
    constructors: Ordmap(Text, Pair(Text, Nat)),
    eliminators: Ordmap(Text, Text),
    targets: Ordmap(Text, List(Text)),
    defs: Ordmap(Text, KernelDef),
    locals: Ordmap(Nat, KernelTerm),
    next: Nat,
    exhausted: Bool,
    quotient: List(Text),
    unfolded: List(Pair(Text, Nat)),
    binders: Nat,
    whnfs: Ordmap(KernelTerm, KernelTerm),
    conv_fail: Ordmap(Pair(KernelTerm, KernelTerm), Unit),
    conv_depth: Nat
  ): KernelCore
}

pub(open) inductive KernelFamily: Type {
  Mk(name: Text, ty: KernelTerm, constructors: List(Pair(Text, KernelTerm))): KernelFamily
}

pub(open) inductive KernelCommand: Type {
  KernelForget(name: Text): KernelCommand
  KernelDeclare(
    name: Text,
    ty: KernelTerm,
    value: Option(KernelTerm),
    transparent: Bool
  ): KernelCommand
  KernelConstant(name: Text, value: KernelTerm): KernelCommand
  KernelSetValue(name: Text, value: KernelTerm): KernelCommand
  KernelInductive(families: List(KernelFamily), params: Nat, sort: KernelSort): KernelCommand
  KernelRecursor(family: Text, level: Nat): KernelCommand
  KernelCheck(value: KernelTerm, ty: KernelTerm): KernelCommand
  KernelConvert(left: KernelTerm, right: KernelTerm): KernelCommand
}

pub(open) inductive KernelVerdict: Type {
  KernelAccepted: KernelVerdict
  KernelRejected: KernelVerdict
  KernelExhausted: KernelVerdict
}

pub fn kernel_text_cmp(a: Text, b: Text): Ordering { Ordmap::compare_text(a, b) }
pub fn kernel_nat_cmp(a: Nat, b: Nat): Ordering { Ordmap::compare_nat(a, b) }

pub fn kernel_global_get(c: KernelCore, name: Text): Option(KernelGlobal) {
  Ordmap::get(c.globals, name, kernel_text_cmp)
}

pub fn kernel_value_of(c: KernelCore, name: Text): Option(KernelTerm) {
  match kernel_global_get(c, name) {
    None => None
    Some(g) => g.value
  }
}

pub fn kernel_ind_get(c: KernelCore, name: Text): Option(KernelIndInfo) {
  Ordmap::get(c.inductives, name, kernel_text_cmp)
}

pub fn kernel_ctor_get(c: KernelCore, name: Text): Option(Pair(Text, Nat)) {
  Ordmap::get(c.constructors, name, kernel_text_cmp)
}

pub fn kernel_elim_get(c: KernelCore, name: Text): Option(Text) {
  Ordmap::get(c.eliminators, name, kernel_text_cmp)
}

pub fn kernel_local_get(c: KernelCore, atom: Nat): Option(KernelTerm) {
  Ordmap::get(c.locals, atom, kernel_nat_cmp)
}

pub fn kernel_set_to<A>(&mut slot: A, value: A): Unit {
  slot := value
}

pub fn kernel_fresh(&mut c: KernelCore, ty: KernelTerm): Nat {
  let x := Succ(c.next)
  kernel_set_to(&mut c.next, x)
  kernel_set_to(&mut c.locals, Ordmap::insert(c.locals, x, ty, kernel_nat_cmp))
  x
}

pub fn kernel_put_global(
  &mut c: KernelCore,
  name: Text,
  ty: KernelTerm,
  value: Option(KernelTerm)
): Unit {
  kernel_set_to(
    &mut c.globals,
    Ordmap::insert(c.globals, name, KernelGlobal::Mk(ty, value), kernel_text_cmp)
  )
  kernel_set_to(&mut c.whnfs, Ordmap::empty())
}

pub fn kernel_fresh_name(c: KernelCore, name: Text): Bool {
  not(Ordmap::contains(c.globals, name, kernel_text_cmp))
}

pub fn kernel_new(): KernelCore {
  let nat := KernelConst("Nat")
  let binary := kernel_pi(nat, kernel_pi(nat, nat))
  let none: Option(KernelTerm) := None
  let g := KernelGlobal::Mk(binary, none)
  let globals := Ordmap::insert(
    Ordmap::insert(
      Ordmap::insert(Ordmap::empty(), "+", g, kernel_text_cmp),
      "*",
      g,
      kernel_text_cmp
    ),
    "-",
    g,
    kernel_text_cmp
  )
  KernelCore::Mk(
    globals,
    Ordmap::empty(),
    Ordmap::empty(),
    Ordmap::empty(),
    Ordmap::empty(),
    Ordmap::empty(),
    Ordmap::empty(),
    0,
    false,
    Nil,
    Nil,
    0,
    Ordmap::empty(),
    Ordmap::empty(),
    0
  )
}

pub fn kernel_text_in(xs: List(Text), name: Text): Bool {
  match xs {
    Nil => false
    Cons(x, rest) => if x == name { true } else { kernel_text_in(rest, name) }
  }
}

fn kernel_quot_sort_type(): KernelTerm { KernelSortTerm(KernelType(KernelLevel::Mk(0, Nil))) }

// `(A, A) -> Prop`, where `A` is the bound variable `a`.
fn kernel_quot_rel(a: Nat): KernelTerm {
  kernel_pi(KernelBVar(a), kernel_pi(KernelBVar(Succ(a)), KernelSortTerm(KernelProp)))
}

fn kernel_quot_of(a: Nat, r: Nat): KernelTerm {
  kernel_app(kernel_app(KernelConst("Quot"), KernelBVar(a)), KernelBVar(r))
}

fn kernel_quot_over(rest: KernelTerm): KernelTerm {
  kernel_pi(kernel_quot_sort_type(), kernel_pi(kernel_quot_rel(0), rest))
}

// The type each of the quotient's constants must be declared with, the
// same as `quot_type` of `crates/tauto-kernel/src/check/core.rs`; `None`
// for every other name.
pub fn kernel_quot_type(name: Text): Option(KernelTerm) {
  if name == "Quot" {
    Some(kernel_quot_over(kernel_quot_sort_type()))
  } else if name == "Quot::mk" {
    Some(kernel_quot_over(kernel_pi(KernelBVar(1), kernel_quot_of(2, 1))))
  } else if name == "Quot::lift" {
    let respects := kernel_pi(
      KernelBVar(3),
      kernel_pi(
        KernelBVar(4),
        kernel_pi(
          kernel_app(kernel_app(KernelBVar(4), KernelBVar(1)), KernelBVar(0)),
          kernel_app(
            kernel_app(
              kernel_app(KernelConst("Eq"), KernelBVar(4)),
              kernel_app(KernelBVar(3), KernelBVar(2))
            ),
            kernel_app(KernelBVar(3), KernelBVar(1))
          )
        )
      )
    )
    Some(
      kernel_quot_over(
        kernel_pi(
          kernel_quot_sort_type(),
          kernel_pi(
            kernel_pi(KernelBVar(2), KernelBVar(1)),
            kernel_pi(respects, kernel_pi(kernel_quot_of(4, 3), KernelBVar(3)))
          )
        )
      )
    )
  } else if name == "Quot::ind" {
    let mk := kernel_app(
      kernel_app(kernel_app(KernelConst("Quot::mk"), KernelBVar(3)), KernelBVar(2)),
      KernelBVar(0)
    )
    Some(
      kernel_quot_over(
        kernel_pi(
          kernel_pi(kernel_quot_of(1, 0), KernelSortTerm(KernelProp)),
          kernel_pi(
            kernel_pi(KernelBVar(2), kernel_app(KernelBVar(1), mk)),
            kernel_pi(kernel_quot_of(3, 2), kernel_app(KernelBVar(2), KernelBVar(0)))
          )
        )
      )
    )
  } else { None }
}

// The constants a quotient constant mentions, which must be declared first.
pub fn kernel_quot_needs(name: Text): List(Text) {
  if name == "Quot" { Nil } else if name == "Quot::ind" {
    Cons("Quot", Cons("Quot::mk", Nil))
  } else { Cons("Quot", Nil) }
}

pub fn kernel_all_in(names: List(Text), xs: List(Text)): Bool {
  match names {
    Nil => true
    Cons(n, rest) => if kernel_text_in(xs, n) { kernel_all_in(rest, xs) } else { false }
  }
}

pub fn kernel_closed(t: KernelTerm): Bool {
  kernel_loose(t) == 0 && not(kernel_mentions_fvar(t))
}

// The largest numeral, `u128::MAX` of the Rust core.
pub fn kernel_lit_max(): Nat {
  // (2^64 - 1)^2 + 2 * (2^64 - 1) = 2^128 - 1
  let h := 18446744073709551615
  h * h + h + h
}

pub fn kernel_term_valid(t: KernelTerm, depth: Nat): Bool {
  match t {
    KernelBVar(i) => i < depth
    KernelFVar(x) => false
    KernelSortTerm(s) => true
    KernelConst(n) => true
    KernelPi(a, b, n) => kernel_term_valid(a, depth) && kernel_term_valid(b, Succ(depth))
    KernelLam(b, n) => kernel_term_valid(b, Succ(depth))
    KernelApp(f, a, n) => kernel_term_valid(f, depth) && kernel_term_valid(a, depth)
    KernelLit(v) => v <= 18446744073709551615 || v <= kernel_lit_max()
  }
}

pub fn kernel_as_pi(t: KernelTerm): Option(Pair(KernelTerm, KernelTerm)) {
  match t {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => None
    KernelPi(a, b, n) => Some(Pair { fst: a, snd: b })
    KernelLam(b, n) => None
    KernelApp(f, a, n) => None
    KernelLit(v) => None
  }
}

pub fn kernel_as_pi_named(t: KernelTerm): Option(@domain KernelTerm × @codomain KernelTerm) {
  match kernel_as_pi(t) {
    None => None
    Some(p) => Some(#(@domain p.fst, @codomain p.snd))
  }
}

pub fn kernel_as_lam(t: KernelTerm): Option(KernelTerm) {
  match t {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => None
    KernelPi(a, b, n) => None
    KernelLam(b, n) => Some(b)
    KernelApp(f, a, n) => None
    KernelLit(v) => None
  }
}

pub fn kernel_as_const(t: KernelTerm): Option(Text) {
  match t {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => Some(n)
    KernelPi(a, b, n) => None
    KernelLam(b, n) => None
    KernelApp(f, a, n) => None
    KernelLit(v) => None
  }
}

pub fn kernel_as_sort(t: KernelTerm): Option(KernelSort) {
  match t {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => Some(s)
    KernelConst(n) => None
    KernelPi(a, b, n) => None
    KernelLam(b, n) => None
    KernelApp(f, a, n) => None
    KernelLit(v) => None
  }
}

pub fn kernel_as_lit(t: KernelTerm): Option(Nat) {
  match t {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => None
    KernelPi(a, b, n) => None
    KernelLam(b, n) => None
    KernelApp(f, a, n) => None
    KernelLit(v) => Some(v)
  }
}

pub fn kernel_is_lit(t: KernelTerm): Bool {
  match kernel_as_lit(t) {
    None => false
    Some(v) => true
  }
}

pub fn kernel_is_app(t: KernelTerm): Bool {
  match t {
    KernelBVar(i) => false
    KernelFVar(x) => false
    KernelSortTerm(s) => false
    KernelConst(n) => false
    KernelPi(a, b, n) => false
    KernelLam(b, n) => false
    KernelApp(f, a, n) => true
    KernelLit(v) => false
  }
}

pub fn kernel_is_lam(t: KernelTerm): Bool {
  match kernel_as_lam(t) {
    None => false
    Some(b) => true
  }
}

// The argument of `Succ(x)`.
pub fn kernel_as_succ(t: KernelTerm): Option(KernelTerm) {
  match t {
    KernelBVar(i) => None
    KernelFVar(x) => None
    KernelSortTerm(s) => None
    KernelConst(n) => None
    KernelPi(a, b, n) => None
    KernelLam(b, n) => None
    KernelApp(f, a, n) => match kernel_as_const(f) {
      None => None
      Some(h) => if h == "Succ" { Some(a) } else { None }
    }
    KernelLit(v) => None
  }
}

pub fn kernel_is_const(t: KernelTerm, name: Text): Bool {
  match kernel_as_const(t) {
    None => false
    Some(n) => n == name
  }
}

// `Some(None)` for a weak head normal `t` that is zero, `Some(Some(k))` for
// one that is `Succ(k)`; a numeral reads as `Zero` or `Succ`.
pub fn kernel_nat_view(t: KernelTerm): Option(Option(KernelTerm)) {
  match kernel_as_lit(t) {
    Some(v) => if v == 0 { Some(None) } else { Some(Some(KernelLit(v - 1))) }
    None => if kernel_is_const(t, "Zero") { Some(None) } else {
      match kernel_as_succ(t) {
        None => None
        Some(k) => Some(Some(k))
      }
    }
  }
}

pub fn kernel_expand_lit(t: KernelTerm): KernelTerm {
  match kernel_as_lit(t) {
    None => t
    Some(v) => if v == 0 { KernelConst("Zero") } else {
      kernel_app(KernelConst("Succ"), KernelLit(v - 1))
    }
  }
}

pub fn kernel_bind_pis(xs: List(Pair(Nat, KernelTerm)), body: KernelTerm): KernelTerm {
  match xs {
    Nil => body
    Cons(x, rest) => kernel_pi_over(x.fst, x.snd, kernel_bind_pis(rest, body))
  }
}

pub fn kernel_bind_lams(xs: List(Nat), body: KernelTerm): KernelTerm {
  match xs {
    Nil => body
    Cons(x, rest) => kernel_lam_over(x, kernel_bind_lams(rest, body))
  }
}
