import "check.taut"
import "data.taut"
import "level.taut"
import "term.taut"
import std::List
import std::Map
import std::Text
import std::Base

pub(open) inductive KernelRec: Type {
  Mk(arg: Nat, ys: List(Pair(Nat, KernelTerm)), family: Nat, indices: List(KernelTerm)): KernelRec
}

pub(open) inductive KernelCtor: Type {
  Mk(
    name: Text,
    arguments: List(Pair(Nat, KernelTerm)),
    result_indices: List(KernelTerm),
    recursive: List(KernelRec)
  ): KernelCtor
}

pub(open) inductive KernelMember: Type {
  Mk(
    name: Text,
    index_tel: KernelTerm,
    indices: Nat,
    alias: Option(Pair(Text, List(KernelTerm))),
    constructors: List(KernelCtor)
  ): KernelMember
}

pub fn kernel_list_map_Pair_Nat_KernelTerm_KernelTerm(
  f: (Pair(Nat, KernelTerm)) -> KernelTerm,
  xs: List(Pair(Nat, KernelTerm))
): List(KernelTerm) { List::map(f, xs) }

pub fn kernel_list_map_Pair_Nat_KernelTerm_Nat(
  f: (Pair(Nat, KernelTerm)) -> Nat,
  xs: List(Pair(Nat, KernelTerm))
): List(Nat) { List::map(f, xs) }

pub fn kernel_list_any_KernelTerm_Bool(
  f: (KernelTerm) -> Bool,
  xs: List(KernelTerm)
): Bool { List::any(f, xs) }

pub fn kernel_list_all_KernelFamily_Bool(
  f: (KernelFamily) -> Bool,
  xs: List(KernelFamily)
): Bool { List::all(f, xs) }

pub fn kernel_list_map_KernelFamily_Text(
  f: (KernelFamily) -> Text,
  xs: List(KernelFamily)
): List(Text) { List::map(f, xs) }

pub fn kernel_list_map_KernelRec_KernelRecArg(
  f: (KernelRec) -> KernelRecArg,
  xs: List(KernelRec)
): List(KernelRecArg) { List::map(f, xs) }

pub fn kernel_list_map_KernelCtor_KernelCtorInfo(
  f: (KernelCtor) -> KernelCtorInfo,
  xs: List(KernelCtor)
): List(KernelCtorInfo) { List::map(f, xs) }

pub fn kernel_atoms(xs: List(Pair(Nat, KernelTerm))): List(KernelTerm) {
  kernel_list_map_Pair_Nat_KernelTerm_KernelTerm(
    (x: Pair(Nat, KernelTerm)) => KernelFVar(x.fst),
    xs
  )
}

pub fn kernel_atom_ids(xs: List(Pair(Nat, KernelTerm))): List(Nat) {
  kernel_list_map_Pair_Nat_KernelTerm_Nat((x: Pair(Nat, KernelTerm)) => x.fst, xs)
}

pub fn kernel_set_at<A>(xs: List(A), index: Nat, value: A): List(A) {
  ⊢ List(A) from match xs {
    Nil => Nil
    Cons(x, rest) => ⊢ List(A) from match index {
      Zero => Cons(value, rest)
      Succ(i) => Cons(x, kernel_set_at(rest, i, value))
    }
  }
}

pub fn kernel_index_of(names: List(Text), name: Text): Option(Nat) {
  ⊢ Option(Nat) from match names {
    Nil => None
    Cons(n, rest) => if n == name { Some(0) } else {
      ⊢ Option(Nat) from match kernel_index_of(rest, name) {
        None => None
        Some(i) => Some(Succ(i)) }
    }
  }
}

pub fn kernel_mentions_any(ts: List(KernelTerm), names: List(Text)): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(t, rest) => kernel_mentions_const(t, names) || kernel_mentions_any(rest, names)
  }
}

pub fn kernel_positive(group: List(Text), d: KernelTerm): Bool {
  ⊢ Bool from match d {
    KernelPi(a, b, n) => not(kernel_mentions_const(a, group)) && kernel_positive(group, b)
    KernelBVar(i) => true
    KernelFVar(x) => true
    KernelSortTerm(s) => true
    KernelConst(n) => true
    KernelLam(body, n) => not(kernel_mentions_const(body, group))
    KernelLit(v) => true
    KernelApp(f, a, n) => if not(kernel_mentions_const(d, group)) { true } else {
      let sp := kernel_spine(d)
      ⊢ Bool from match kernel_as_const(sp.fst) {
        None => false
        Some(n) => List::contains(
          Text::eq,
          n,
          group
        ) && not(
          kernel_list_any_KernelTerm_Bool(
            (t: KernelTerm) => kernel_mentions_const(t, group),
            sp.snd
          )
        )
      }
    }
  }
}

pub fn kernel_shared_params(n: Nat, a: KernelTerm, b: KernelTerm): Bool {
  ⊢ Bool from match n {
    Zero => true
    Succ(j) => ⊢ Bool from match kernel_as_pi_named(a) {
      None => false
      Some(#(@domain pa_domain, @codomain pa_codomain)) => ⊢ Bool from match kernel_as_pi_named(b) {
        None => false
        Some(#(@domain pb_domain, @codomain pb_codomain)) => kernel_term_eq(
          pa_domain,
          pb_domain
        ) && kernel_shared_params(j, pa_codomain, pb_codomain)
      }
    }
  }
}

pub fn kernel_instantiate_params_in(params: List(KernelTerm), t: KernelTerm): Option(KernelTerm) {
  ⊢ Option(KernelTerm) from match params {
    Nil => Some(t)
    Cons(p, rest) => ⊢ Option(KernelTerm) from match kernel_as_pi_named(t) {
      None => None
      Some(#(@domain _, @codomain pi_codomain)) => kernel_instantiate_params_in(
        rest,
        kernel_inst(pi_codomain, p)
      )
    }
  }
}

pub fn kernel_instantiate_params(
  t: KernelTerm,
  params: List(KernelTerm)
): Option(KernelTerm) { kernel_instantiate_params_in(params, t) }

pub fn kernel_finish_ctor(ci: KernelCtor, params: List(Nat)): KernelCtorInfo {
  let env := List::append(params, kernel_atom_ids(ci.arguments))
  KernelCtorInfo::Mk(
    ci.name,
    List::length(ci.arguments),
    kernel_list_map_KernelRec_KernelRecArg(
      (r: KernelRec) => KernelRecArg::Mk(
        r.arg,
        List::length(r.ys),
        r.family,
        kernel_list_map_KernelTerm_KernelTerm(
          (t: KernelTerm) => kernel_abstract_many(t, List::append(env, kernel_atom_ids(r.ys))),
          r.indices
        )
      ),
      ci.recursive
    )
  )
}

pub fn kernel_finish_members(
  members: List(KernelMember),
  group: List(Text),
  params: List(Pair(Nat, KernelTerm)),
  out: KernelSort,
  pos: Nat
): List(KernelIndInfo) {
  ⊢ List(KernelIndInfo) from match members {
    Nil => Nil
    Cons(m, rest) => {
      let k_like: Option(
        List(KernelTerm)
      ) := if kernel_sort_eq(out, KernelProp) && List::length(group) == 1 {
        ⊢ Option(List(KernelTerm)) from match m.constructors {
          Nil => None
          Cons(ci, tail) => if List::length(tail) == 0 && List::length(ci.arguments) == 0 {
            Some(
              kernel_list_map_KernelTerm_KernelTerm(
                (t: KernelTerm) => kernel_abstract_many(t, kernel_atom_ids(params)),
                ci.result_indices
              )
            )
          } else { None }
        }
      } else { None }
      Cons(
        KernelIndInfo::Mk(
          m.name,
          List::length(params),
          m.indices,
          group,
          pos,
          kernel_list_map_KernelCtor_KernelCtorInfo(
            (ci: KernelCtor) => kernel_finish_ctor(ci, kernel_atom_ids(params)),
            m.constructors
          ),
          m.alias,
          k_like
        ),
        kernel_finish_members(rest, group, params, out, Succ(pos))
      )
    }
  }
}

mutual {
  pub fn kernel_open_n(
    k: Nat,
    &mut c: KernelCore,
    n: Nat,
    t: KernelTerm
  ): Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) {
    ⊢ Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) from match n {
        Zero => Some(Pair { fst: Nil, snd: t })
        Succ(m) => ⊢ Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) from match kernel_as_pi_named(t) {
          None => None
          Some(#(@domain domain, @codomain codomain)) => {
            let atom := kernel_fresh(&mut c, domain)
            ⊢ Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) from match kernel_open_n(
              j,
              &mut c,
              m,
              kernel_inst(codomain, KernelFVar(atom))
            ) {
              None => None

              Some(tail) => Some(
                Pair { fst: Cons(Pair { fst: atom, snd: domain }, tail.fst), snd: tail.snd }
              )
            }
          }
        }
      }
    }
  }

  pub fn kernel_open_all(
    k: Nat,
    &mut c: KernelCore,
    t: KernelTerm
  ): Pair(List(Pair(Nat, KernelTerm)), KernelTerm) {
    ⊢ Pair(List(Pair(Nat, KernelTerm)), KernelTerm) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Pair { fst: Nil, snd: t } }
      Succ(j) => ⊢ Pair(List(Pair(Nat, KernelTerm)), KernelTerm) from match kernel_as_pi_named(t) {
        None => Pair { fst: Nil, snd: t }
        Some(#(@domain domain, @codomain codomain)) => {
          let atom := kernel_fresh(&mut c, domain)
          let tail := kernel_open_all(j, &mut c, kernel_inst(codomain, KernelFVar(atom)))
          Pair { fst: Cons(Pair { fst: atom, snd: domain }, tail.fst), snd: tail.snd }
        }
      }
    }
  }

  pub fn kernel_add_families(k: Nat, &mut c: KernelCore, specs: List(KernelFamily)): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => ⊢ Bool from match specs {
        Nil => true
        Cons(f, rest) => if kernel_fresh_name(c, f.name) && kernel_term_valid(f.ty, 0) {
          ⊢ Bool from match kernel_infer_sort(j, &mut c, f.ty) {
            None => false
            Some(s) => {
              kernel_put_global(&mut c, f.name, f.ty, None)
              kernel_add_families(j, &mut c, rest)
            }
          }
        } else { false }
      }
    }
  }

  pub fn kernel_read_members(
    k: Nat,
    &mut c: KernelCore,
    specs: List(KernelFamily),
    params: List(KernelTerm),
    out: KernelSort
  ): Option(List(KernelMember)) {
    ⊢ Option(List(KernelMember)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(List(KernelMember)) from match specs {
        Nil => Some(Nil)

        Cons(f, rest) => ⊢ Option(List(KernelMember)) from match kernel_instantiate_params(f.ty, params) {
          None => None
          Some(tel) => {
            let opened := kernel_open_all(j, &mut c, tel)
            if kernel_term_eq(kernel_whnf(j, &mut c, opened.snd, true, false), KernelSortTerm(out)) {
              ⊢ Option(List(KernelMember)) from match kernel_read_members(j, &mut c, rest, params, out) {
                None => None

                Some(ms) => Some(
                  Cons(KernelMember::Mk(f.name, tel, List::length(opened.fst), None, Nil), ms)
                )
              }
            } else { None }
          }
        }
      }
    }
  }

  pub fn kernel_ctor_params(
    k: Nat,
    &mut c: KernelCore,
    t: KernelTerm,
    params: List(Pair(Nat, KernelTerm))
  ): Option(KernelTerm) {
    ⊢ Option(KernelTerm) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(KernelTerm) from match params {
        Nil => Some(t)
        Cons(param, rest) => ⊢ Option(KernelTerm) from match kernel_as_pi_named(t) {
          None => None
          Some(#(@domain domain, @codomain codomain)) => if kernel_conv(
            j,
            &mut c,
            domain,
            param.snd
          ) {
            kernel_ctor_params(j, &mut c, kernel_inst(codomain, KernelFVar(param.fst)), rest)
          } else { None }
        }
      }
    }
  }

  pub fn kernel_ctor_universes(
    k: Nat,
    &mut c: KernelCore,
    args: List(Pair(Nat, KernelTerm)),
    out: KernelSort
  ): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => ⊢ Bool from match args {
        Nil => true
        Cons(arg, rest) => ⊢ Bool from match kernel_infer_sort(j, &mut c, arg.snd) {
          None => false

          Some(s) => (
            kernel_sort_eq(out, KernelProp) || kernel_sort_le(s, out)
          ) && kernel_ctor_universes(j, &mut c, rest, out)
        }
      }
    }
  }

  pub fn kernel_read_ctors(
    k: Nat,
    &mut c: KernelCore,
    specs: List(Pair(Text, KernelTerm)),
    &mut taken: List(Text),
    params: List(Pair(Nat, KernelTerm)),
    member: KernelMember,
    group: List(Text),
    out: KernelSort
  ): Option(List(KernelCtor)) {
    ⊢ Option(List(KernelCtor)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(List(KernelCtor)) from match specs {
        Nil => Some(Nil)

        Cons(spec, rest) => if kernel_fresh_name(
          c,
          spec.fst
        ) && not(List::contains(Text::eq, spec.fst, taken)) && kernel_term_valid(spec.snd, 0) {
          taken := Cons(spec.fst, taken)
          ⊢ Option(List(KernelCtor)) from match kernel_infer_sort(j, &mut c, spec.snd) {
            None => None

            Some(s) => ⊢ Option(List(KernelCtor)) from match kernel_ctor_params(
              j,
              &mut c,
              spec.snd,
              params
            ) {
              None => None
              Some(tel) => {
                let opened := kernel_open_all(j, &mut c, tel)
                let result := kernel_spine(opened.snd)
                let np := List::length(params)
                if kernel_ctor_universes(
                  j,
                  &mut c,
                  opened.fst,
                  out
                ) && kernel_term_eq(
                  result.fst,
                  KernelConst(member.name)
                ) && List::length(
                  result.snd
                ) == np + member.indices && kernel_terms_eq(
                  List::take(np, result.snd),
                  kernel_atoms(params)
                ) {
                  let idx := List::drop(np, result.snd)
                  if kernel_list_any_KernelTerm_Bool(
                    (t: KernelTerm) => kernel_mentions_const(t, group),
                    idx
                  ) { None } else {
                    ⊢ Option(List(KernelCtor)) from match kernel_read_ctors(
                      j,
                      &mut c,
                      rest,
                      &mut taken,
                      params,
                      member,
                      group,
                      out
                    ) {
                      None => None
                      Some(cs) => Some(Cons(KernelCtor::Mk(spec.fst, opened.fst, idx, Nil), cs))
                    }
                  }
                } else { None }
              }
            }
          }
        } else { None }
      }
    }
  }

  pub fn kernel_read_all_ctors(
    k: Nat,
    &mut c: KernelCore,
    specs: List(KernelFamily),
    members: List(KernelMember),
    &mut taken: List(Text),
    params: List(Pair(Nat, KernelTerm)),
    group: List(Text),
    out: KernelSort
  ): Option(List(KernelMember)) {
    ⊢ Option(List(KernelMember)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(List(KernelMember)) from match specs {
        Nil => Some(Nil)
        Cons(f, rest) => ⊢ Option(List(KernelMember)) from match members {
          Nil => None

          Cons(m, tail) => ⊢ Option(List(KernelMember)) from match kernel_read_ctors(
            j,
            &mut c,
            f.constructors,
            &mut taken,
            params,
            m,
            group,
            out
          ) {
            None => None

            Some(cs) => ⊢ Option(List(KernelMember)) from match kernel_read_all_ctors(
              j,
              &mut c,
              rest,
              tail,
              &mut taken,
              params,
              group,
              out
            ) {
              None => None
              Some(ms) => Some(
                Cons(KernelMember::Mk(m.name, m.index_tel, m.indices, m.alias, cs), ms)
              )
            }
          }
        }
      }
    }
  }

  pub fn kernel_nest(
    k: Nat,
    &mut c: KernelCore,
    d: KernelTerm,
    np: Nat,
    &mut group: List(Text),
    &mut aliases: List(Pair(Text, List(KernelTerm)))
  ): Option(KernelTerm) {
    ⊢ Option(KernelTerm) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(KernelTerm) from match kernel_as_pi_named(d) {
        Some(#(@domain domain, @codomain codomain)) => ⊢ Option(KernelTerm) from match kernel_nest(
          j,
          &mut c,
          codomain,
          np,
          &mut group,
          &mut aliases
        ) {
          None => None
          Some(b) => Some(kernel_pi(domain, b))
        }
        None => {
          let sp := kernel_spine(d)
          ⊢ Option(KernelTerm) from match kernel_as_const(sp.fst) {
            None => Some(d)
            Some(name) => ⊢ Option(KernelTerm) from match kernel_ind_get(c, name) {
              None => Some(d)

              Some(ind) => if List::contains(
                Text::eq,
                name,
                group
              ) || not(
                kernel_mentions_any(sp.snd, List::append(group, Nil))
              ) { Some(d) } else if np != 0 || ind.indices != 0 || List::length(
                ind.group
              ) != 1 || List::length(
                sp.snd
              ) != ind.params || not(List::all(kernel_closed, sp.snd)) { None } else {
                ⊢ Option(KernelTerm) from match kernel_alias_index(j, aliases, name, sp.snd) {
                  Some(i) => ⊢ Option(KernelTerm) from match List::nth(
                    group,
                    List::length(group) - List::length(aliases) + i
                  ) {
                    None => None
                    Some(n) => Some(KernelConst(n))
                  }
                  None => {
                    let first := ⊢ Text from match List::head(group) {
                      None => ""
                      Some(n) => n }
                    let member := Text::concat_all(
                      Cons(
                        first,
                        Cons("::nested", Cons(Text::of_nat(List::length(aliases)), Nil))
                      )
                    )
                    if kernel_fresh_name(c, member) {
                      group := List::append(group, Cons(member, Nil))
                      aliases := List::append(aliases, Cons(Pair { fst: name, snd: sp.snd }, Nil))
                      Some(KernelConst(member))
                    } else { None }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_alias_index(
    k: Nat,
    aliases: List(Pair(Text, List(KernelTerm))),
    name: Text,
    args: List(KernelTerm)
  ): Option(Nat) {
    ⊢ Option(Nat) from match k {
      Zero => None
      Succ(j) => ⊢ Option(Nat) from match aliases {
        Nil => None
        Cons(a, rest) => if a.fst == name && kernel_terms_eq(a.snd, args) { Some(0) } else {
          ⊢ Option(Nat) from match kernel_alias_index(j, rest, name, args) {
            None => None
            Some(i) => Some(Succ(i)) }
        }
      }
    }
  }

  pub fn kernel_recursive(
    k: Nat,
    &mut c: KernelCore,
    group: List(Text),
    members: List(KernelMember),
    pvars: List(KernelTerm),
    arg: Nat,
    d: KernelTerm
  ): Option(Option(KernelRec)) {
    ⊢ Option(Option(KernelRec)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => {
        let opened := kernel_open_all(j, &mut c, d)
        let sp := kernel_spine(opened.snd)
        ⊢ Option(Option(KernelRec)) from match kernel_as_const(sp.fst) {
          None => Some(None)
          Some(name) => ⊢ Option(Option(KernelRec)) from match kernel_index_of(group, name) {
            None => Some(None)
            Some(fi) => {
              let member := List::nth(members, fi)
              let np := ⊢ Nat from match member {
                None => 0
                Some(m) => ⊢ Nat from match m.alias {
                  None => List::length(pvars)
                  Some(a) => 0 }
              }
              let ni := ⊢ Nat from match member {
                None => 0
                Some(m) => m.indices }
              if List::length(
                sp.snd
              ) == np + ni && kernel_terms_eq(List::take(np, sp.snd), List::take(np, pvars)) {
                Some(Some(KernelRec::Mk(arg, opened.fst, fi, List::drop(np, sp.snd))))
              } else { None }
            }
          }
        }
      }
    }
  }

  pub fn kernel_process_args(
    k: Nat,
    &mut c: KernelCore,
    args: List(Pair(Nat, KernelTerm)),
    at: Nat,
    np: Nat,
    members: List(KernelMember),
    pvars: List(KernelTerm),
    &mut group: List(Text),
    &mut aliases: List(Pair(Text, List(KernelTerm)))
  ): Option(List(KernelRec)) {
    ⊢ Option(List(KernelRec)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(List(KernelRec)) from match args {
        Nil => Some(Nil)

        Cons(a, rest) => ⊢ Option(List(KernelRec)) from match kernel_nest(
          j,
          &mut c,
          a.snd,
          np,
          &mut group,
          &mut aliases
        ) {
          None => None
          Some(internal) => if kernel_positive(group, internal) {
            ⊢ Option(List(KernelRec)) from match kernel_recursive(
              j,
              &mut c,
              group,
              members,
              pvars,
              at,
              internal
            ) {
              None => None

              Some(r) => ⊢ Option(List(KernelRec)) from match kernel_process_args(
                j,
                &mut c,
                rest,
                Succ(at),
                np,
                members,
                pvars,
                &mut group,
                &mut aliases
              ) {
                None => None
                Some(rs) => Some(⊢ List(KernelRec) from match r {
None => rs
Some(rec) => Cons(rec, rs) })
              }
            }
          } else { None }
        }
      }
    }
  }

  pub fn kernel_process_ctors(
    k: Nat,
    &mut c: KernelCore,
    ctors: List(KernelCtor),
    np: Nat,
    members: List(KernelMember),
    pvars: List(KernelTerm),
    &mut group: List(Text),
    &mut aliases: List(Pair(Text, List(KernelTerm)))
  ): Option(List(KernelCtor)) {
    ⊢ Option(List(KernelCtor)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(List(KernelCtor)) from match ctors {
        Nil => Some(Nil)

        Cons(ci, rest) => ⊢ Option(List(KernelCtor)) from match kernel_process_args(
          j,
          &mut c,
          ci.arguments,
          0,
          np,
          members,
          pvars,
          &mut group,
          &mut aliases
        ) {
          None => None

          Some(rs) => ⊢ Option(List(KernelCtor)) from match kernel_process_ctors(
            j,
            &mut c,
            rest,
            np,
            members,
            pvars,
            &mut group,
            &mut aliases
          ) {
            None => None
            Some(cs) => Some(Cons(KernelCtor::Mk(ci.name, ci.arguments, ci.result_indices, rs), cs))
          }
        }
      }
    }
  }

  pub fn kernel_nested_ctors(
    k: Nat,
    &mut c: KernelCore,
    cs: List(KernelCtorInfo),
    args: List(KernelTerm)
  ): Option(List(KernelCtor)) {
    ⊢ Option(List(KernelCtor)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(List(KernelCtor)) from match cs {
        Nil => Some(Nil)
        Cons(ci, rest) => ⊢ Option(List(KernelCtor)) from match kernel_global_get(c, ci.name) {
          None => None
          Some(g) => ⊢ Option(List(KernelCtor)) from match kernel_instantiate_params(g.ty, args) {
            None => None
            Some(tel) => {
              let opened := kernel_open_all(j, &mut c, tel)
              ⊢ Option(List(KernelCtor)) from match kernel_nested_ctors(j, &mut c, rest, args) {
                None => None
                Some(tail) => Some(Cons(KernelCtor::Mk(ci.name, opened.fst, Nil, Nil), tail))
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_grow_members(
    k: Nat,
    &mut c: KernelCore,
    &mut members: List(KernelMember),
    group: List(Text),
    aliases: List(Pair(Text, List(KernelTerm))),
    original: Nat,
    out: KernelSort
  ): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => if List::length(members) < List::length(group) {
        ⊢ Bool from match List::nth(aliases, List::length(members) - original) {
          None => false
          Some(alias) => ⊢ Bool from match kernel_ind_get(c, alias.fst) {
            None => false
            Some(ind) => ⊢ Bool from match kernel_nested_ctors(j, &mut c, ind.constructors, alias.snd) {
              None => false
              Some(cs) => ⊢ Bool from match List::nth(group, List::length(members)) {
                None => false
                Some(name) => {
                  members := List::append(
                    members,
                    Cons(KernelMember::Mk(name, KernelSortTerm(out), 0, Some(alias), cs), Nil)
                  )
                  kernel_grow_members(j, &mut c, &mut members, group, aliases, original, out)
                }
              }
            }
          }
        }
      } else { true }
    }
  }

  pub fn kernel_process_members(
    k: Nat,
    &mut c: KernelCore,
    &mut members: List(KernelMember),
    &mut group: List(Text),
    &mut aliases: List(Pair(Text, List(KernelTerm))),
    at: Nat,
    original: Nat,
    np: Nat,
    pvars: List(KernelTerm),
    out: KernelSort
  ): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => ⊢ Bool from match List::nth(members, at) {
        None => true

        Some(m) => ⊢ Bool from match kernel_process_ctors(
          j,
          &mut c,
          m.constructors,
          np,
          members,
          pvars,
          &mut group,
          &mut aliases
        ) {
          None => false
          Some(cs) => {
            members := kernel_set_at(
              members,
              at,
              KernelMember::Mk(m.name, m.index_tel, m.indices, m.alias, cs)
            )
            if kernel_grow_members(j, &mut c, &mut members, group, aliases, original, out) {
              kernel_process_members(
                j,
                &mut c,
                &mut members,
                &mut group,
                &mut aliases,
                Succ(at),
                original,
                np,
                pvars,
                out
              )
            } else { false }
          }
        }
      }
    }
  }

  pub fn kernel_large_args(
    k: Nat,
    &mut c: KernelCore,
    args: List(Pair(Nat, KernelTerm)),
    indices: List(KernelTerm)
  ): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => ⊢ Bool from match args {
        Nil => true
        Cons(a, rest) => ⊢ Bool from match kernel_infer_sort(j, &mut c, a.snd) {
          None => false

          Some(s) => (
            kernel_sort_eq(
              s,
              KernelProp
            ) || List::contains(kernel_term_eq, KernelFVar(a.fst), indices)
          ) && kernel_large_args(j, &mut c, rest, indices)
        }
      }
    }
  }

  pub fn kernel_large(k: Nat, &mut c: KernelCore, ms: List(KernelMember), out: KernelSort): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => if not(kernel_sort_eq(out, KernelProp)) { true } else {
        ⊢ Bool from match ms {
          Nil => false
          Cons(m, rest) => if List::length(rest) != 0 { false } else {
            ⊢ Bool from match m.constructors {
              Nil => true

              Cons(ci, tail) => if List::length(
                tail
              ) != 0 { false } else {
                kernel_large_args(j, &mut c, ci.arguments, ci.result_indices)
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_register_ctors(
    k: Nat,
    &mut c: KernelCore,
    cs: List(KernelCtor),
    family: Text,
    pos: Nat,
    params: List(Pair(Nat, KernelTerm))
  ): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => ⊢ Bool from match cs {
        Nil => true
        Cons(ci, rest) => {
          let result := kernel_apps(
            KernelConst(family),
            List::append(kernel_atoms(params), ci.result_indices)
          )
          let ty := kernel_bind_pis(params, kernel_bind_pis(ci.arguments, result))
          kernel_put_global(&mut c, ci.name, ty, None)
          kernel_set_to(
            &mut c.constructors,
            Ordmap::insert(c.constructors, ci.name, Pair { fst: family, snd: pos }, kernel_text_cmp)
          )
          kernel_register_ctors(j, &mut c, rest, family, Succ(pos), params)
        }
      }
    }
  }

  pub fn kernel_register_members(
    k: Nat,
    &mut c: KernelCore,
    ms: List(KernelMember),
    params: List(Pair(Nat, KernelTerm))
  ): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => ⊢ Bool from match ms {
        Nil => true

        Cons(m, rest) => kernel_register_ctors(
          j,
          &mut c,
          m.constructors,
          m.name,
          0,
          params
        ) && kernel_register_members(j, &mut c, rest, params)
      }
    }
  }

  pub fn kernel_over_major(
    k: Nat,
    &mut c: KernelCore,
    m: KernelMember,
    pvars: List(KernelTerm),
    motive: Option(KernelTerm),
    ms: KernelSort
  ): KernelTerm {
    ⊢ KernelTerm from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        KernelBVar(0) }
      Succ(j) => {
        let opened := kernel_open_all(j, &mut c, m.index_tel)
        let ivars := kernel_atoms(opened.fst)
        let major_ty := ⊢ KernelTerm from match m.alias {
          None => kernel_apps(KernelConst(m.name), List::append(pvars, ivars))
          Some(alias) => kernel_apps(KernelConst(alias.fst), alias.snd)
        }
        let atom := kernel_fresh(&mut c, major_ty)
        let body := ⊢ KernelTerm from match motive {
          None => KernelSortTerm(ms)
          Some(mv) => kernel_apps(mv, List::append(ivars, Cons(KernelFVar(atom), Nil)))
        }
        kernel_bind_pis(opened.fst, kernel_pi_over(atom, major_ty, body))
      }
    }
  }

  pub fn kernel_motives(
    k: Nat,
    &mut c: KernelCore,
    members: List(KernelMember),
    pvars: List(KernelTerm),
    ms: KernelSort
  ): List(Pair(Nat, KernelTerm)) {
    ⊢ List(Pair(Nat, KernelTerm)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => ⊢ List(Pair(Nat, KernelTerm)) from match members {
        Nil => Nil
        Cons(m, rest) => {
          let ty := kernel_over_major(j, &mut c, m, pvars, None, ms)
          let atom := kernel_fresh(&mut c, ty)
          Cons(Pair { fst: atom, snd: ty }, kernel_motives(j, &mut c, rest, pvars, ms))
        }
      }
    }
  }

  pub fn kernel_minor_ihs(
    k: Nat,
    &mut c: KernelCore,
    rs: List(KernelRec),
    ci: KernelCtor,
    mvars: List(KernelTerm)
  ): List(Pair(Nat, KernelTerm)) {
    ⊢ List(Pair(Nat, KernelTerm)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => ⊢ List(Pair(Nat, KernelTerm)) from match rs {
        Nil => Nil
        Cons(r, rest) => {
          let arg := ⊢ KernelTerm from match List::nth(ci.arguments, r.arg) {
            None => KernelBVar(0)
            Some(a) => KernelFVar(a.fst) }
          let field := kernel_apps(arg, kernel_atoms(r.ys))
          let ih := kernel_bind_pis(
            r.ys,
            kernel_apps(
              kernel_nth(mvars, r.family),
              List::append(r.indices, Cons(field, Nil))
            )
          )
          let atom := kernel_fresh(&mut c, ih)
          Cons(Pair { fst: atom, snd: ih }, kernel_minor_ihs(j, &mut c, rest, ci, mvars))
        }
      }
    }
  }

  pub fn kernel_minors_ctors(
    k: Nat,
    &mut c: KernelCore,
    cs: List(KernelCtor),
    m: KernelMember,
    fi: Nat,
    pvars: List(KernelTerm),
    mvars: List(KernelTerm)
  ): List(Pair(Nat, KernelTerm)) {
    ⊢ List(Pair(Nat, KernelTerm)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => ⊢ List(Pair(Nat, KernelTerm)) from match cs {
        Nil => Nil
        Cons(ci, rest) => {
          let cparams := ⊢ List(KernelTerm) from match m.alias {
            None => pvars
            Some(a) => a.snd }
          let built := kernel_apps(
            KernelConst(ci.name),
            List::append(cparams, kernel_atoms(ci.arguments))
          )
          let ihs := kernel_minor_ihs(j, &mut c, ci.recursive, ci, mvars)
          let result := kernel_apps(
            kernel_nth(mvars, fi),
            List::append(ci.result_indices, Cons(built, Nil))
          )
          let ty := kernel_bind_pis(ci.arguments, kernel_bind_pis(ihs, result))
          let atom := kernel_fresh(&mut c, ty)
          Cons(
            Pair { fst: atom, snd: ty },
            kernel_minors_ctors(j, &mut c, rest, m, fi, pvars, mvars)
          )
        }
      }
    }
  }

  pub fn kernel_minors(
    k: Nat,
    &mut c: KernelCore,
    members: List(KernelMember),
    fi: Nat,
    pvars: List(KernelTerm),
    mvars: List(KernelTerm)
  ): List(Pair(Nat, KernelTerm)) {
    ⊢ List(Pair(Nat, KernelTerm)) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => ⊢ List(Pair(Nat, KernelTerm)) from match members {
        Nil => Nil
        Cons(m, rest) => {
          let cs := kernel_minors_ctors(j, &mut c, m.constructors, m, fi, pvars, mvars)
          List::append(cs, kernel_minors(j, &mut c, rest, Succ(fi), pvars, mvars))
        }
      }
    }
  }

  pub fn kernel_eliminator(
    k: Nat,
    &mut c: KernelCore,
    members: List(KernelMember),
    params: List(Pair(Nat, KernelTerm)),
    index: Nat,
    ms: KernelSort
  ): Option(KernelTerm) {
    ⊢ Option(KernelTerm) from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => ⊢ Option(KernelTerm) from match List::nth(members, index) {
        None => None
        Some(m) => {
          let pvars := kernel_atoms(params)
          let motives := kernel_motives(j, &mut c, members, pvars, ms)
          let mvars := kernel_atoms(motives)
          let minors := kernel_minors(j, &mut c, members, 0, pvars, mvars)
          let result := kernel_over_major(j, &mut c, m, pvars, List::nth(mvars, index), ms)
          Some(kernel_bind_pis(params, kernel_bind_pis(motives, kernel_bind_pis(minors, result))))
        }
      }
    }
  }

  pub fn kernel_register_elims(
    k: Nat,
    &mut c: KernelCore,
    all: List(KernelMember),
    todo: List(KernelMember),
    params: List(Pair(Nat, KernelTerm)),
    at: Nat,
    ms: KernelSort,
    &mut pending: List(Pair(Text, KernelTerm))
  ): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => ⊢ Bool from match todo {
        Nil => true
        Cons(m, rest) => {
          let suffix: Text := if kernel_sort_eq(ms, KernelProp) { "::ind" } else { "::rec" }
          let name := Text::concat(m.name, suffix)
          if kernel_fresh_name(c, name) {
            ⊢ Bool from match kernel_eliminator(j, &mut c, all, params, at, ms) {
              None => false
              Some(ty) => if kernel_closed(ty) {
                ⊢ Bool from match kernel_infer_sort(j, &mut c, ty) {
                  None => false
                  Some(s) => {
                    pending := Cons(Pair { fst: name, snd: ty }, pending)
                    kernel_set_to(
                      &mut c.eliminators,
                      Ordmap::insert(c.eliminators, name, m.name, kernel_text_cmp)
                    )
                    kernel_register_elims(j, &mut c, all, rest, params, Succ(at), ms, &mut pending)
                  }
                }
              } else { false }
            }
          } else { false }
        }
      }
    }
  }

  pub fn kernel_inductive_inner(
    k: Nat,
    &mut c: KernelCore,
    specs: List(KernelFamily),
    np: Nat,
    out: KernelSort
  ): Bool {
    ⊢ Bool from match k {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => ⊢ Bool from match specs {
        Nil => false

        Cons(first, rest) => if kernel_add_families(
          j,
          &mut c,
          specs
        ) && kernel_list_all_KernelFamily_Bool(
          (f: KernelFamily) => kernel_shared_params(np, first.ty, f.ty),
          rest
        ) {
          ⊢ Bool from match kernel_open_n(j, &mut c, np, first.ty) {
            None => false

            Some(opened) => ⊢ Bool from match kernel_read_members(
              j,
              &mut c,
              specs,
              kernel_atoms(opened.fst),
              out
            ) {
              None => false
              Some(ms) => {
                let names := kernel_list_map_KernelFamily_Text((f: KernelFamily) => f.name, specs)
                var taken: List(Text) := names
                ⊢ Bool from match kernel_read_all_ctors(
                  j,
                  &mut c,
                  specs,
                  ms,
                  &mut taken,
                  opened.fst,
                  names,
                  out
                ) {
                  None => false
                  Some(with_ctors) => {
                    var members: List(KernelMember) := with_ctors
                    var group: List(Text) := names
                    var aliases: List(Pair(Text, List(KernelTerm))) := Nil
                    if kernel_process_members(
                      j,
                      &mut c,
                      &mut members,
                      &mut group,
                      &mut aliases,
                      0,
                      List::length(specs),
                      np,
                      kernel_atoms(opened.fst),
                      out
                    ) && not(
                      List::length(specs) < List::length(members) && kernel_sort_eq(out, KernelProp)
                    ) {
                      let large := kernel_large(j, &mut c, members, out)
                      if kernel_register_members(
                        j,
                        &mut c,
                        List::take(List::length(specs), members),
                        opened.fst
                      ) {
                        var pending: List(Pair(Text, KernelTerm)) := Nil
                        let small_ok := kernel_register_elims(
                          j,
                          &mut c,
                          members,
                          members,
                          opened.fst,
                          0,
                          KernelProp,
                          &mut pending
                        )
                        let big_ok: Bool := if large {
                          kernel_register_elims(
                            j,
                            &mut c,
                            members,
                            members,
                            opened.fst,
                            0,
                            KernelType(KernelLevel::Mk(1, Nil)),
                            &mut pending
                          )
                        } else { true }
                        if small_ok && big_ok {
                          kernel_put_pending(&mut c, pending)
                          kernel_put_targets(&mut c, members, "::ind")
                          if large { kernel_put_targets(&mut c, members, "::rec") }
                          kernel_put_inductives(
                            &mut c,
                            kernel_finish_members(members, group, opened.fst, out, 0)
                          )
                          true
                        } else { false }
                      } else { false }
                    } else { false }
                  }
                }
              }
            }
          }
        } else { false }
      }
    }
  }
}

// Only the terminal universe of a motive changes; its dependent telescope is preserved.
pub fn kernel_motive_at(k: Nat, &mut c: KernelCore, t: KernelTerm, level: Nat): Option(KernelTerm) {
  ⊢ Option(KernelTerm) from match k {
    Zero => {
      kernel_set_to(&mut c.exhausted, true)
      None
    }
    Succ(j) => ⊢ Option(KernelTerm) from match t {
      KernelPi(a, b, n) => ⊢ Option(KernelTerm) from match kernel_motive_at(j, &mut c, b, level) {
        None => None
        Some(body) => Some(kernel_pi(a, body))
      }
      KernelSortTerm(s) => ⊢ Option(KernelTerm) from match s {
        KernelProp => None
        KernelType(old) => Some(KernelSortTerm(KernelType(KernelLevel::Mk(level, Nil))))
      }
      _ => None
    }
  }
}

pub fn kernel_recursor_type_at(
  k: Nat,
  &mut c: KernelCore,
  t: KernelTerm,
  skip: Nat,
  motives: Nat,
  level: Nat
): Option(KernelTerm) {
  ⊢ Option(KernelTerm) from match k {
    Zero => {
      kernel_set_to(&mut c.exhausted, true)
      None
    }
    Succ(j) => if skip == 0 && motives == 0 { Some(t) } else {
      ⊢ Option(KernelTerm) from match t {
        KernelPi(a, b, n) => if skip == 0 {
          ⊢ Option(KernelTerm) from match kernel_motive_at(j, &mut c, a, level) {
            None => None
            Some(domain) => ⊢ Option(KernelTerm) from match kernel_recursor_type_at(
              j,
              &mut c,
              b,
              0,
              motives - 1,
              level
            ) {
              None => None
              Some(body) => Some(kernel_pi(domain, body))
            }
          }
        } else {
          ⊢ Option(KernelTerm) from match kernel_recursor_type_at(
            j,
            &mut c,
            b,
            skip - 1,
            motives,
            level
          ) {
            None => None
            Some(body) => Some(kernel_pi(a, body))
          }
        }
        _ => None
      }
    }
  }
}

pub fn kernel_recursor_members(
  k: Nat,
  &mut c: KernelCore,
  members: List(Text),
  params: Nat,
  motives: Nat,
  level: Nat
): Bool {
  ⊢ Bool from match k {
    Zero => { kernel_set_to(&mut c.exhausted, true)
      false }
    Succ(j) => ⊢ Bool from match members {
      Nil => true
      Cons(member, rest) => {
        let original := Text::concat(member, "::rec")
        let name := Text::concat(Text::concat(original, "@"), Text::of_nat(level))
        ⊢ Bool from match kernel_elim_get(c, original) {
          None => false
          Some(owner) => if owner == member {
            ⊢ Bool from match kernel_elim_get(c, name) {
              Some(existing) => existing == member && kernel_recursor_members(
                j,
                &mut c,
                rest,
                params,
                motives,
                level
              )
              None => if kernel_fresh_name(c, name) {
                ⊢ Bool from match kernel_global_get(c, original) {
                  None => false
                  Some(g) => ⊢ Bool from match kernel_recursor_type_at(
                    j,
                    &mut c,
                    g.ty,
                    params,
                    motives,
                    level
                  ) {
                    None => false
                    Some(ty) => ⊢ Bool from match kernel_infer_sort(j, &mut c, ty) {
                      None => false
                      Some(s) => {
                        kernel_put_global(&mut c, name, ty, None)
                        kernel_set_to(
                          &mut c.eliminators,
                          Ordmap::insert(c.eliminators, name, member, kernel_text_cmp)
                        )
                        kernel_recursor_members(j, &mut c, rest, params, motives, level)
                      }
                    }
                  }
                }
              } else { false }
            }
          } else { false }
        }
      }
    }
  }
}

pub fn kernel_recursor_at(k: Nat, &mut c: KernelCore, family: Text, level: Nat): Bool {
  if level <= 65535 {
    ⊢ Bool from match kernel_ind_get(c, family) {
      None => false
      Some(ind) => if kernel_recursor_members(
        k,
        &mut c,
        ind.group,
        ind.params,
        List::length(ind.group),
        level
      ) {
        let names := kernel_rec_at_names(ind.group, level)
        kernel_put_targets_of(&mut c, names, names)
        true
      } else { false }
    }
  } else { false }
}

pub fn kernel_put_pending(&mut c: KernelCore, pending: List(Pair(Text, KernelTerm))): Unit {
  match pending {
    Nil => #()
    Cons(p, rest) => {
      kernel_put_global(&mut c, p.fst, p.snd, None)
      kernel_put_pending(&mut c, rest)
    }
  }
}

pub fn kernel_put_inductives(&mut c: KernelCore, infos: List(KernelIndInfo)): Unit {
  match infos {
    Nil => #()
    Cons(i, rest) => {
      kernel_set_to(&mut c.inductives, Ordmap::insert(c.inductives, i.name, i, kernel_text_cmp))
      kernel_put_inductives(&mut c, rest)
    }
  }
}

pub fn kernel_member_names(ms: List(KernelMember), suffix: Text): List(Text) {
  match ms {
    Nil => Nil
    Cons(m, rest) => Cons(Text::concat(m.name, suffix), kernel_member_names(rest, suffix))
  }
}

// Each eliminator of the group made with `suffix` goes on with the
// eliminators of the group in order (`kernel_iota_ihs`).
pub fn kernel_put_targets(&mut c: KernelCore, ms: List(KernelMember), suffix: Text): Unit {
  let names := kernel_member_names(ms, suffix)
  kernel_put_targets_of(&mut c, names, names)
}

pub fn kernel_put_targets_of(&mut c: KernelCore, todo: List(Text), names: List(Text)): Unit {
  match todo {
    Nil => #()
    Cons(n, rest) => {
      kernel_set_to(&mut c.targets, Ordmap::insert(c.targets, n, names, kernel_text_cmp))
      kernel_put_targets_of(&mut c, rest, names)
    }
  }
}

pub fn kernel_rec_at_names(members: List(Text), level: Nat): List(Text) {
  match members {
    Nil => Nil
    Cons(m, rest) => Cons(
      Text::concat(Text::concat(m, "::rec@"), Text::of_nat(level)),
      kernel_rec_at_names(rest, level)
    )
  }
}
