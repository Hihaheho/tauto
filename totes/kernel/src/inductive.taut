import "check.taut"

pub(open) inductive KernelRec: Type {
  Mk(
    arg: Nat,
    ys: List(Pair(Nat, KernelTerm)),
    family: Nat,
    indices: List(KernelTerm)
  ): KernelRec
}

pub(open) inductive KernelCtor: Type {
  Mk(
    name: Text,
    arguments: List(Pair(Nat, KernelTerm)),
    result_indices: List(KernelTerm),
    recursive: List(KernelRec)
  ): KernelCtor
}

pub(open) inductive KernelMember: Type {
  Mk(
    name: Text,
    index_tel: KernelTerm,
    indices: Nat,
    alias: Option(Pair(Text, List(KernelTerm))),
    constructors: List(KernelCtor)
  ): KernelMember
}

pub fn kernel_list_map_Pair_Nat_KernelTerm_KernelTerm(
  f: (Pair(Nat, KernelTerm)) -> KernelTerm,
  xs: List(Pair(Nat, KernelTerm))
): List(KernelTerm) { List::map(f, xs) }

pub fn kernel_list_map_Pair_Nat_KernelTerm_Nat(
  f: (Pair(Nat, KernelTerm)) -> Nat,
  xs: List(Pair(Nat, KernelTerm))
): List(Nat) { List::map(f, xs) }

pub fn kernel_list_any_KernelTerm_Bool(
  f: (KernelTerm) -> Bool,
  xs: List(KernelTerm)
): Bool { List::any(f, xs) }

pub fn kernel_list_all_KernelFamily_Bool(
  f: (KernelFamily) -> Bool,
  xs: List(KernelFamily)
): Bool { List::all(f, xs) }

pub fn kernel_list_map_KernelFamily_Text(
  f: (KernelFamily) -> Text,
  xs: List(KernelFamily)
): List(Text) { List::map(f, xs) }

pub fn kernel_list_map_KernelRec_KernelRecArg(
  f: (KernelRec) -> KernelRecArg,
  xs: List(KernelRec)
): List(KernelRecArg) { List::map(f, xs) }

pub fn kernel_list_map_KernelCtor_KernelCtorInfo(
  f: (KernelCtor) -> KernelCtorInfo,
  xs: List(KernelCtor)
): List(KernelCtorInfo) { List::map(f, xs) }

pub fn kernel_atoms(xs: List(Pair(Nat, KernelTerm))): List(KernelTerm) {
  kernel_list_map_Pair_Nat_KernelTerm_KernelTerm(
    (x: Pair(Nat, KernelTerm)) => KernelFVar(x.fst),
    xs
  )
}

pub fn kernel_atom_ids(xs: List(Pair(Nat, KernelTerm))): List(Nat) {
  kernel_list_map_Pair_Nat_KernelTerm_Nat((x: Pair(Nat, KernelTerm)) => x.fst, xs)
}

pub fn kernel_set_at<A>(xs: List(A), index: Nat, value: A): List(A) {
  match xs: List(A) {
    Nil => Nil
    Cons(x, rest) => match index: List(A) {
      Zero => Cons(value, rest)
      Succ(i) => Cons(x, kernel_set_at(rest, i, value))
    }
  }
}

pub fn kernel_index_of(names: List(Text), name: Text): Option(Nat) {
  match names: Option(Nat) {
    Nil => None
    Cons(n, rest) => if n == name { Some(0) } else {
      match kernel_index_of(rest, name): Option(Nat) {
        None => None
        Some(i) => Some(Succ(i)) }
    }
  }
}

pub fn kernel_mentions_any(ts: List(KernelTerm), names: List(Text)): Bool {
  match ts: Bool {
    Nil => false
    Cons(t, rest) => kernel_mentions_const(t, names) || kernel_mentions_any(rest, names)
  }
}

pub fn kernel_positive(group: List(Text), d: KernelTerm): Bool {
  match d: Bool {
    KernelPi(a, b) => not(kernel_mentions_const(a, group)) && kernel_positive(group, b)
    KernelBVar(i) => true
    KernelFVar(x) => true
    KernelSortTerm(s) => true
    KernelConst(n) => true
    KernelLam(body) => not(kernel_mentions_const(body, group))
    KernelLit(ds) => true
    KernelBool(v) => true
    KernelApp(f, a) => if not(kernel_mentions_const(d, group)) { true } else {
      let sp := kernel_spine(d)
      match kernel_as_const(sp.fst): Bool {
        None => false
        Some(n) => List::contains(
          Text::eq,
          n,
          group
        ) && not(kernel_list_any_KernelTerm_Bool(
          (t: KernelTerm) => kernel_mentions_const(t, group),
          sp.snd
        ))
      }
    }
  }
}

pub fn kernel_shared_params(n: Nat, a: KernelTerm, b: KernelTerm): Bool {
  match n: Bool {
    Zero => true
    Succ(j) => match kernel_as_pi(a): Bool {
      None => false
      Some(#(@domain pa_domain, @codomain pa_codomain)) => match kernel_as_pi(b): Bool {
        None => false
        Some(#(@domain pb_domain, @codomain pb_codomain)) => kernel_term_eq(pa_domain, pb_domain) && kernel_shared_params(j, pa_codomain, pb_codomain)
      }
    }
  }
}

pub fn kernel_instantiate_params_in(params: List(KernelTerm), t: KernelTerm): Option(KernelTerm) {
  match params: Option(KernelTerm) {
    Nil => Some(t)
    Cons(p, rest) => match kernel_as_pi(t): Option(KernelTerm) {
      None => None
      Some(#(@domain _, @codomain pi_codomain)) => kernel_instantiate_params_in(rest, kernel_inst(pi_codomain, p))
    }
  }
}

pub fn kernel_instantiate_params(
  t: KernelTerm,
  params: List(KernelTerm)
): Option(KernelTerm) { kernel_instantiate_params_in(params, t) }

pub fn kernel_finish_ctor(ci: KernelCtor, params: List(Nat)): KernelCtorInfo {
  let env := List::append(params, kernel_atom_ids(ci.arguments))
  KernelCtorInfo::Mk(
    ci.name,
    List::length(ci.arguments),
    kernel_list_map_KernelRec_KernelRecArg(
      (r: KernelRec) => KernelRecArg::Mk(
        r.arg,
        List::length(r.ys),
        r.family,
        kernel_list_map_KernelTerm_KernelTerm(
          (t: KernelTerm) => kernel_abstract_many(t, List::append(env, kernel_atom_ids(r.ys))),
          r.indices
        )
      ),
      ci.recursive
    )
  )
}

pub fn kernel_finish_members(
  members: List(KernelMember),
  group: List(Text),
  params: List(Pair(Nat, KernelTerm)),
  out: KernelSort,
  pos: Nat
): List(KernelIndInfo) {
  match members: List(KernelIndInfo) {
    Nil => Nil
    Cons(m, rest) => {
      let k_like: Option(
        List(KernelTerm)
      ) := if kernel_sort_eq(out, KernelProp) && List::length(group) == 1 {
        match m.constructors: Option(List(KernelTerm)) {
          Nil => None
          Cons(ci, tail) => if List::length(tail) == 0 && List::length(ci.arguments) == 0 {
            Some(
              kernel_list_map_KernelTerm_KernelTerm(
                (t: KernelTerm) => kernel_abstract_many(t, kernel_atom_ids(params)),
                ci.result_indices
              )
            )
          } else { None }
        }
      } else { None }
      Cons(
        KernelIndInfo::Mk(
          m.name,
          List::length(params),
          m.indices,
          group,
          pos,
          kernel_list_map_KernelCtor_KernelCtorInfo(
            (ci: KernelCtor) => kernel_finish_ctor(ci, kernel_atom_ids(params)),
            m.constructors
          ),
          m.alias,
          k_like
        ),
        kernel_finish_members(rest, group, params, out, Succ(pos))
      )
    }
  }
}

mutual {
  pub fn kernel_open_n(
    k: Nat,
    &mut c: KernelCore,
    n: Nat,
    t: KernelTerm
  ): Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) {
    match k: Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match n: Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) {
        Zero => Some(Pair { fst: Nil, snd: t })
        Succ(m) => match kernel_as_pi(t): Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) {
          None => None
          Some(#(@domain domain, @codomain codomain)) => {
            let atom := kernel_fresh(&mut c, domain)
            match kernel_open_n(
              j,
              &mut c,
              m,
              kernel_inst(codomain, KernelFVar(atom))
            ): Option(Pair(List(Pair(Nat, KernelTerm)), KernelTerm)) {
              None => None

              Some(tail) => Some(
                Pair { fst: Cons(Pair { fst: atom, snd: domain }, tail.fst), snd: tail.snd }
              )
            }
          }
        }
      }
    }
  }

  pub fn kernel_open_all(
    k: Nat,
    &mut c: KernelCore,
    t: KernelTerm
  ): Pair(List(Pair(Nat, KernelTerm)), KernelTerm) {
    match k: Pair(List(Pair(Nat, KernelTerm)), KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Pair { fst: Nil, snd: t } }
      Succ(j) => match kernel_as_pi(t): Pair(List(Pair(Nat, KernelTerm)), KernelTerm) {
        None => Pair { fst: Nil, snd: t }
        Some(#(@domain domain, @codomain codomain)) => {
          let atom := kernel_fresh(&mut c, domain)
          let tail := kernel_open_all(j, &mut c, kernel_inst(codomain, KernelFVar(atom)))
          Pair { fst: Cons(Pair { fst: atom, snd: domain }, tail.fst), snd: tail.snd }
        }
      }
    }
  }

  pub fn kernel_add_families(k: Nat, &mut c: KernelCore, specs: List(KernelFamily)): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match specs: Bool {
        Nil => true
        Cons(f, rest) => if kernel_fresh_name(c, f.name) && kernel_term_valid(f.ty, 0) {
          match kernel_infer_sort(j, &mut c, f.ty): Bool {
            None => false
            Some(s) => {
              kernel_put_global(&mut c, f.name, f.ty, None)
              kernel_add_families(j, &mut c, rest)
            }
          }
        } else { false }
      }
    }
  }

  pub fn kernel_read_members(
    k: Nat,
    &mut c: KernelCore,
    specs: List(KernelFamily),
    params: List(KernelTerm),
    out: KernelSort
  ): Option(List(KernelMember)) {
    match k: Option(List(KernelMember)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match specs: Option(List(KernelMember)) {
        Nil => Some(Nil)

        Cons(f, rest) => match kernel_instantiate_params(
          f.ty,
          params
        ): Option(List(KernelMember)) {
          None => None
          Some(tel) => {
            let opened := kernel_open_all(j, &mut c, tel)
            if kernel_term_eq(kernel_whnf(j, &mut c, opened.snd, true), KernelSortTerm(out)) {
              match kernel_read_members(j, &mut c, rest, params, out): Option(List(KernelMember)) {
                None => None

                Some(ms) => Some(
                  Cons(KernelMember::Mk(f.name, tel, List::length(opened.fst), None, Nil), ms)
                )
              }
            } else { None }
          }
        }
      }
    }
  }

  pub fn kernel_ctor_params(
    k: Nat,
    &mut c: KernelCore,
    t: KernelTerm,
    params: List(Pair(Nat, KernelTerm))
  ): Option(KernelTerm) {
    match k: Option(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match params: Option(KernelTerm) {
        Nil => Some(t)
        Cons(param, rest) => match kernel_as_pi(t): Option(KernelTerm) {
          None => None
          Some(#(@domain domain, @codomain codomain)) => if kernel_conv(j, &mut c, domain, param.snd) {
            kernel_ctor_params(j, &mut c, kernel_inst(codomain, KernelFVar(param.fst)), rest)
          } else { None }
        }
      }
    }
  }

  pub fn kernel_ctor_universes(
    k: Nat,
    &mut c: KernelCore,
    args: List(Pair(Nat, KernelTerm)),
    out: KernelSort
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match args: Bool {
        Nil => true
        Cons(arg, rest) => match kernel_infer_sort(j, &mut c, arg.snd): Bool {
          None => false

          Some(s) => (
            kernel_sort_eq(out, KernelProp) || kernel_sort_le(s, out)
          ) && kernel_ctor_universes(j, &mut c, rest, out)
        }
      }
    }
  }

  pub fn kernel_read_ctors(
    k: Nat,
    &mut c: KernelCore,
    specs: List(Pair(Text, KernelTerm)),
    &mut taken: List(Text),
    params: List(Pair(Nat, KernelTerm)),
    member: KernelMember,
    group: List(Text),
    out: KernelSort
  ): Option(List(KernelCtor)) {
    match k: Option(List(KernelCtor)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match specs: Option(List(KernelCtor)) {
        Nil => Some(Nil)

        Cons(spec, rest) => if kernel_fresh_name(
          c,
          spec.fst
        ) && not(List::contains(Text::eq, spec.fst, taken)) && kernel_term_valid(spec.snd, 0) {
          taken := Cons(spec.fst, taken)
          match kernel_infer_sort(j, &mut c, spec.snd): Option(List(KernelCtor)) {
            None => None

            Some(s) => match kernel_ctor_params(
              j,
              &mut c,
              spec.snd,
              params
            ): Option(List(KernelCtor)) {
              None => None
              Some(tel) => {
                let opened := kernel_open_all(j, &mut c, tel)
                let result := kernel_spine(opened.snd)
                let np := List::length(params)
                if kernel_ctor_universes(
                  j,
                  &mut c,
                  opened.fst,
                  out
                ) && kernel_term_eq(
                  result.fst,
                  KernelConst(member.name)
                ) && List::length(
                  result.snd
                ) == np + member.indices && kernel_terms_eq(
                  List::take(np, result.snd),
                  kernel_atoms(params)
                ) {
                  let idx := List::drop(np, result.snd)
                  if kernel_list_any_KernelTerm_Bool(
                    (t: KernelTerm) => kernel_mentions_const(t, group),
                    idx
                  ) { None } else {
                    match kernel_read_ctors(
                      j,
                      &mut c,
                      rest,
                      &mut taken,
                      params,
                      member,
                      group,
                      out
                    ): Option(List(KernelCtor)) {
                      None => None
                      Some(cs) => Some(Cons(KernelCtor::Mk(spec.fst, opened.fst, idx, Nil), cs))
                    }
                  }
                } else { None }
              }
            }
          }
        } else { None }
      }
    }
  }

  pub fn kernel_read_all_ctors(
    k: Nat,
    &mut c: KernelCore,
    specs: List(KernelFamily),
    members: List(KernelMember),
    &mut taken: List(Text),
    params: List(Pair(Nat, KernelTerm)),
    group: List(Text),
    out: KernelSort
  ): Option(List(KernelMember)) {
    match k: Option(List(KernelMember)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match specs: Option(List(KernelMember)) {
        Nil => Some(Nil)
        Cons(f, rest) => match members: Option(List(KernelMember)) {
          Nil => None

          Cons(m, tail) => match kernel_read_ctors(
            j,
            &mut c,
            f.constructors,
            &mut taken,
            params,
            m,
            group,
            out
          ): Option(List(KernelMember)) {
            None => None

            Some(cs) => match kernel_read_all_ctors(
              j,
              &mut c,
              rest,
              tail,
              &mut taken,
              params,
              group,
              out
            ): Option(List(KernelMember)) {
              None => None
              Some(ms) => Some(
                Cons(KernelMember::Mk(m.name, m.index_tel, m.indices, m.alias, cs), ms)
              )
            }
          }
        }
      }
    }
  }

  pub fn kernel_nest(
    k: Nat,
    &mut c: KernelCore,
    d: KernelTerm,
    np: Nat,
    &mut group: List(Text),
    &mut aliases: List(Pair(Text, List(KernelTerm)))
  ): Option(KernelTerm) {
    match k: Option(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match kernel_as_pi(d): Option(KernelTerm) {
        Some(#(@domain domain, @codomain codomain)) => match kernel_nest(
          j,
          &mut c,
          codomain,
          np,
          &mut group,
          &mut aliases
        ): Option(KernelTerm) {
          None => None
          Some(b) => Some(KernelPi(domain, b))
        }
        None => {
          let sp := kernel_spine(d)
          match kernel_as_const(sp.fst): Option(KernelTerm) {
            None => Some(d)
            Some(name) => match kernel_ind_get(c.inductives, name): Option(KernelTerm) {
              None => Some(d)

              Some(ind) => if List::contains(
                Text::eq,
                name,
                group
              ) || not(kernel_mentions_any(sp.snd, List::append(group, Nil))) { Some(d) } else {
                if np != 0 || ind.indices != 0 || List::length(
                  ind.group
                ) != 1 || List::length(
                  sp.snd
                ) != ind.params || not(List::all(kernel_closed, sp.snd)) { None } else {
                  match kernel_alias_index(j, aliases, name, sp.snd): Option(KernelTerm) {
                    Some(i) => match List::nth(
                      group,
                      List::length(group) - List::length(aliases) + i
                    ): Option(KernelTerm) {
                      None => None
                      Some(n) => Some(KernelConst(n))
                    }
                    None => {
                      let first := match List::head(group): Text {
                        None => ""
                        Some(n) => n }
                      let member := Text::concat_all(
                        Cons(
                          first,
                          Cons("_", Cons(name, Cons(Text::of_nat(Succ(List::length(aliases))), Nil)))
                        )
                      )
                      if kernel_fresh_name(c, member) {
                        group := List::append(group, Cons(member, Nil))
                        aliases := List::append(aliases, Cons(Pair { fst: name, snd: sp.snd }, Nil))
                        Some(KernelConst(member))
                      } else { None }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_alias_index(
    k: Nat,
    aliases: List(Pair(Text, List(KernelTerm))),
    name: Text,
    args: List(KernelTerm)
  ): Option(Nat) {
    match k: Option(Nat) {
      Zero => None
      Succ(j) => match aliases: Option(Nat) {
        Nil => None
        Cons(a, rest) => if a.fst == name && kernel_terms_eq(a.snd, args) { Some(0) } else {
          match kernel_alias_index(j, rest, name, args): Option(Nat) {
            None => None
            Some(i) => Some(Succ(i)) }
        }
      }
    }
  }

  pub fn kernel_recursive(
    k: Nat,
    &mut c: KernelCore,
    group: List(Text),
    members: List(KernelMember),
    pvars: List(KernelTerm),
    arg: Nat,
    d: KernelTerm
  ): Option(Option(KernelRec)) {
    match k: Option(Option(KernelRec)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => {
        let opened := kernel_open_all(j, &mut c, d)
        let sp := kernel_spine(opened.snd)
        match kernel_as_const(sp.fst): Option(Option(KernelRec)) {
          None => Some(None)
          Some(name) => match kernel_index_of(group, name): Option(Option(KernelRec)) {
            None => Some(None)
            Some(fi) => {
              let member := List::nth(members, fi)
              let np := match member: Nat {
                None => 0
                Some(m) => match m.alias: Nat {
                  None => List::length(pvars)
                  Some(a) => 0 }
              }
              let ni := match member: Nat {
                None => 0
                Some(m) => m.indices }
              if List::length(
                sp.snd
              ) == np + ni && kernel_terms_eq(List::take(np, sp.snd), List::take(np, pvars)) {
                Some(Some(KernelRec::Mk(arg, opened.fst, fi, List::drop(np, sp.snd))))
              } else { None }
            }
          }
        }
      }
    }
  }

  pub fn kernel_process_args(
    k: Nat,
    &mut c: KernelCore,
    args: List(Pair(Nat, KernelTerm)),
    at: Nat,
    np: Nat,
    members: List(KernelMember),
    pvars: List(KernelTerm),
    &mut group: List(Text),
    &mut aliases: List(Pair(Text, List(KernelTerm)))
  ): Option(List(KernelRec)) {
    match k: Option(List(KernelRec)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match args: Option(List(KernelRec)) {
        Nil => Some(Nil)

        Cons(a, rest) => match kernel_nest(
          j,
          &mut c,
          a.snd,
          np,
          &mut group,
          &mut aliases
        ): Option(List(KernelRec)) {
          None => None
          Some(internal) => if kernel_positive(group, internal) {
            match kernel_recursive(
              j,
              &mut c,
              group,
              members,
              pvars,
              at,
              internal
            ): Option(List(KernelRec)) {
              None => None

              Some(r) => match kernel_process_args(
                j,
                &mut c,
                rest,
                Succ(at),
                np,
                members,
                pvars,
                &mut group,
                &mut aliases
              ): Option(List(KernelRec)) {
                None => None
                Some(rs) => Some(match r: List(KernelRec) {
None => rs
Some(rec) => Cons(rec, rs) })
              }
            }
          } else { None }
        }
      }
    }
  }

  pub fn kernel_process_ctors(
    k: Nat,
    &mut c: KernelCore,
    ctors: List(KernelCtor),
    np: Nat,
    members: List(KernelMember),
    pvars: List(KernelTerm),
    &mut group: List(Text),
    &mut aliases: List(Pair(Text, List(KernelTerm)))
  ): Option(List(KernelCtor)) {
    match k: Option(List(KernelCtor)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match ctors: Option(List(KernelCtor)) {
        Nil => Some(Nil)

        Cons(ci, rest) => match kernel_process_args(
          j,
          &mut c,
          ci.arguments,
          0,
          np,
          members,
          pvars,
          &mut group,
          &mut aliases
        ): Option(List(KernelCtor)) {
          None => None

          Some(rs) => match kernel_process_ctors(
            j,
            &mut c,
            rest,
            np,
            members,
            pvars,
            &mut group,
            &mut aliases
          ): Option(List(KernelCtor)) {
            None => None
            Some(cs) => Some(Cons(KernelCtor::Mk(ci.name, ci.arguments, ci.result_indices, rs), cs))
          }
        }
      }
    }
  }

  pub fn kernel_nested_ctors(
    k: Nat,
    &mut c: KernelCore,
    cs: List(KernelCtorInfo),
    args: List(KernelTerm)
  ): Option(List(KernelCtor)) {
    match k: Option(List(KernelCtor)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match cs: Option(List(KernelCtor)) {
        Nil => Some(Nil)
        Cons(ci, rest) => match kernel_global_get(c.globals, ci.name): Option(List(KernelCtor)) {
          None => None
          Some(g) => match kernel_instantiate_params(g.ty, args): Option(List(KernelCtor)) {
            None => None
            Some(tel) => {
              let opened := kernel_open_all(j, &mut c, tel)
              match kernel_nested_ctors(j, &mut c, rest, args): Option(List(KernelCtor)) {
                None => None
                Some(tail) => Some(Cons(KernelCtor::Mk(ci.name, opened.fst, Nil, Nil), tail))
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_grow_members(
    k: Nat,
    &mut c: KernelCore,
    &mut members: List(KernelMember),
    group: List(Text),
    aliases: List(Pair(Text, List(KernelTerm))),
    original: Nat,
    out: KernelSort
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => if List::length(members) < List::length(group) {
        match List::nth(aliases, List::length(members) - original): Bool {
          None => false
          Some(alias) => match kernel_ind_get(c.inductives, alias.fst): Bool {
            None => false
            Some(ind) => match kernel_nested_ctors(j, &mut c, ind.constructors, alias.snd): Bool {
              None => false
              Some(cs) => match List::nth(group, List::length(members)): Bool {
                None => false
                Some(name) => {
                  members := List::append(
                    members,
                    Cons(KernelMember::Mk(name, KernelSortTerm(out), 0, Some(alias), cs), Nil)
                  )
                  kernel_grow_members(j, &mut c, &mut members, group, aliases, original, out)
                }
              }
            }
          }
        }
      } else { true }
    }
  }

  pub fn kernel_process_members(
    k: Nat,
    &mut c: KernelCore,
    &mut members: List(KernelMember),
    &mut group: List(Text),
    &mut aliases: List(Pair(Text, List(KernelTerm))),
    at: Nat,
    original: Nat,
    np: Nat,
    pvars: List(KernelTerm),
    out: KernelSort
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match List::nth(members, at): Bool {
        None => true

        Some(m) => match kernel_process_ctors(
          j,
          &mut c,
          m.constructors,
          np,
          members,
          pvars,
          &mut group,
          &mut aliases
        ): Bool {
          None => false
          Some(cs) => {
            members := kernel_set_at(
              members,
              at,
              KernelMember::Mk(m.name, m.index_tel, m.indices, m.alias, cs)
            )
            if kernel_grow_members(j, &mut c, &mut members, group, aliases, original, out) {
              kernel_process_members(
                j,
                &mut c,
                &mut members,
                &mut group,
                &mut aliases,
                Succ(at),
                original,
                np,
                pvars,
                out
              )
            } else { false }
          }
        }
      }
    }
  }

  pub fn kernel_large_args(
    k: Nat,
    &mut c: KernelCore,
    args: List(Pair(Nat, KernelTerm)),
    indices: List(KernelTerm)
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match args: Bool {
        Nil => true
        Cons(a, rest) => match kernel_infer_sort(j, &mut c, a.snd): Bool {
          None => false

          Some(s) => (
            kernel_sort_eq(
              s,
              KernelProp
            ) || List::contains(kernel_term_eq, KernelFVar(a.fst), indices)
          ) && kernel_large_args(j, &mut c, rest, indices)
        }
      }
    }
  }

  pub fn kernel_large(k: Nat, &mut c: KernelCore, ms: List(KernelMember), out: KernelSort): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => if not(kernel_sort_eq(out, KernelProp)) { true } else {
        match ms: Bool {
          Nil => false
          Cons(m, rest) => if List::length(rest) != 0 { false } else {
            match m.constructors: Bool {
              Nil => true

              Cons(ci, tail) => if List::length(
                tail
              ) != 0 { false } else { kernel_large_args(j, &mut c, ci.arguments, ci.result_indices) }
            }
          }
        }
      }
    }
  }

  pub fn kernel_register_ctors(
    k: Nat,
    &mut c: KernelCore,
    cs: List(KernelCtor),
    family: Text,
    pos: Nat,
    params: List(Pair(Nat, KernelTerm))
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match cs: Bool {
        Nil => true
        Cons(ci, rest) => {
          let result := kernel_apps(
            KernelConst(family),
            List::append(kernel_atoms(params), ci.result_indices)
          )
          let ty := kernel_bind_pis(params, kernel_bind_pis(ci.arguments, result))
          kernel_put_global(&mut c, ci.name, ty, None)
          kernel_set_to(
            &mut c.constructors,
            Cons(Pair { fst: ci.name, snd: Pair { fst: family, snd: pos } }, c.constructors)
          )
          kernel_register_ctors(j, &mut c, rest, family, Succ(pos), params)
        }
      }
    }
  }

  pub fn kernel_register_members(
    k: Nat,
    &mut c: KernelCore,
    ms: List(KernelMember),
    params: List(Pair(Nat, KernelTerm))
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match ms: Bool {
        Nil => true

        Cons(m, rest) => kernel_register_ctors(
          j,
          &mut c,
          m.constructors,
          m.name,
          0,
          params
        ) && kernel_register_members(j, &mut c, rest, params)
      }
    }
  }

  pub fn kernel_over_major(
    k: Nat,
    &mut c: KernelCore,
    m: KernelMember,
    pvars: List(KernelTerm),
    motive: Option(KernelTerm),
    ms: KernelSort
  ): KernelTerm {
    match k: KernelTerm {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        KernelBVar(0) }
      Succ(j) => {
        let opened := kernel_open_all(j, &mut c, m.index_tel)
        let ivars := kernel_atoms(opened.fst)
        let major_ty := match m.alias: KernelTerm {
          None => kernel_apps(KernelConst(m.name), List::append(pvars, ivars))
          Some(alias) => kernel_apps(KernelConst(alias.fst), alias.snd)
        }
        let atom := kernel_fresh(&mut c, major_ty)
        let body := match motive: KernelTerm {
          None => KernelSortTerm(ms)
          Some(mv) => kernel_apps(mv, List::append(ivars, Cons(KernelFVar(atom), Nil)))
        }
        kernel_bind_pis(opened.fst, kernel_pi_over(atom, major_ty, body))
      }
    }
  }

  pub fn kernel_motives(
    k: Nat,
    &mut c: KernelCore,
    members: List(KernelMember),
    pvars: List(KernelTerm),
    ms: KernelSort
  ): List(Pair(Nat, KernelTerm)) {
    match k: List(Pair(Nat, KernelTerm)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => match members: List(Pair(Nat, KernelTerm)) {
        Nil => Nil
        Cons(m, rest) => {
          let ty := kernel_over_major(j, &mut c, m, pvars, None, ms)
          let atom := kernel_fresh(&mut c, ty)
          Cons(Pair { fst: atom, snd: ty }, kernel_motives(j, &mut c, rest, pvars, ms))
        }
      }
    }
  }

  pub fn kernel_minor_ihs(
    k: Nat,
    &mut c: KernelCore,
    rs: List(KernelRec),
    ci: KernelCtor,
    mvars: List(KernelTerm)
  ): List(Pair(Nat, KernelTerm)) {
    match k: List(Pair(Nat, KernelTerm)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => match rs: List(Pair(Nat, KernelTerm)) {
        Nil => Nil
        Cons(r, rest) => {
          let arg := match List::nth(ci.arguments, r.arg): KernelTerm {
            None => KernelBVar(0)
            Some(a) => KernelFVar(a.fst) }
          let field := kernel_apps(arg, kernel_atoms(r.ys))
          let ih := kernel_bind_pis(
            r.ys,
            kernel_apps(
              kernel_term_or(List::nth(mvars, r.family)),
              List::append(r.indices, Cons(field, Nil))
            )
          )
          let atom := kernel_fresh(&mut c, ih)
          Cons(Pair { fst: atom, snd: ih }, kernel_minor_ihs(j, &mut c, rest, ci, mvars))
        }
      }
    }
  }

  pub fn kernel_minors_ctors(
    k: Nat,
    &mut c: KernelCore,
    cs: List(KernelCtor),
    m: KernelMember,
    fi: Nat,
    pvars: List(KernelTerm),
    mvars: List(KernelTerm)
  ): List(Pair(Nat, KernelTerm)) {
    match k: List(Pair(Nat, KernelTerm)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => match cs: List(Pair(Nat, KernelTerm)) {
        Nil => Nil
        Cons(ci, rest) => {
          let cparams := match m.alias: List(KernelTerm) {
            None => pvars
            Some(a) => a.snd }
          let built := kernel_apps(
            KernelConst(ci.name),
            List::append(cparams, kernel_atoms(ci.arguments))
          )
          let ihs := kernel_minor_ihs(j, &mut c, ci.recursive, ci, mvars)
          let result := kernel_apps(
            kernel_term_or(List::nth(mvars, fi)),
            List::append(ci.result_indices, Cons(built, Nil))
          )
          let ty := kernel_bind_pis(ci.arguments, kernel_bind_pis(ihs, result))
          let atom := kernel_fresh(&mut c, ty)
          Cons(
            Pair { fst: atom, snd: ty },
            kernel_minors_ctors(j, &mut c, rest, m, fi, pvars, mvars)
          )
        }
      }
    }
  }

  pub fn kernel_minors(
    k: Nat,
    &mut c: KernelCore,
    members: List(KernelMember),
    fi: Nat,
    pvars: List(KernelTerm),
    mvars: List(KernelTerm)
  ): List(Pair(Nat, KernelTerm)) {
    match k: List(Pair(Nat, KernelTerm)) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => match members: List(Pair(Nat, KernelTerm)) {
        Nil => Nil
        Cons(m, rest) => {
          let cs := kernel_minors_ctors(j, &mut c, m.constructors, m, fi, pvars, mvars)
          List::append(cs, kernel_minors(j, &mut c, rest, Succ(fi), pvars, mvars))
        }
      }
    }
  }

  pub fn kernel_eliminator(
    k: Nat,
    &mut c: KernelCore,
    members: List(KernelMember),
    params: List(Pair(Nat, KernelTerm)),
    index: Nat,
    ms: KernelSort
  ): Option(KernelTerm) {
    match k: Option(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match List::nth(members, index): Option(KernelTerm) {
        None => None
        Some(m) => {
          let pvars := kernel_atoms(params)
          let motives := kernel_motives(j, &mut c, members, pvars, ms)
          let mvars := kernel_atoms(motives)
          let minors := kernel_minors(j, &mut c, members, 0, pvars, mvars)
          let result := kernel_over_major(j, &mut c, m, pvars, List::nth(mvars, index), ms)
          Some(kernel_bind_pis(params, kernel_bind_pis(motives, kernel_bind_pis(minors, result))))
        }
      }
    }
  }

  pub fn kernel_register_elims(
    k: Nat,
    &mut c: KernelCore,
    all: List(KernelMember),
    todo: List(KernelMember),
    params: List(Pair(Nat, KernelTerm)),
    at: Nat,
    ms: KernelSort,
    &mut pending: List(KernelGlobal)
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match todo: Bool {
        Nil => true
        Cons(m, rest) => {
          let suffix: Text := if kernel_sort_eq(ms, KernelProp) { "_ind" } else { "_rec" }
          let name := Text::concat(m.name, suffix)
          if kernel_fresh_name(c, name) {
            match kernel_eliminator(j, &mut c, all, params, at, ms): Bool {
              None => false
              Some(ty) => if kernel_closed(ty) {
                match kernel_infer_sort(j, &mut c, ty): Bool {
                  None => false
                  Some(s) => {
                    pending := Cons(KernelGlobal::Mk(name, ty, None), pending)
                    kernel_set_to(
                      &mut c.eliminators,
                      Cons(Pair { fst: name, snd: m.name }, c.eliminators)
                    )
                    kernel_register_elims(j, &mut c, all, rest, params, Succ(at), ms, &mut pending)
                  }
                }
              } else { false }
            }
          } else { false }
        }
      }
    }
  }

  pub fn kernel_inductive_inner(
    k: Nat,
    &mut c: KernelCore,
    specs: List(KernelFamily),
    np: Nat,
    out: KernelSort
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match specs: Bool {
        Nil => false

        Cons(first, rest) => if kernel_add_families(
          j,
          &mut c,
          specs
        ) && kernel_list_all_KernelFamily_Bool(
          (f: KernelFamily) => kernel_shared_params(np, first.ty, f.ty),
          rest
        ) {
          match kernel_open_n(j, &mut c, np, first.ty): Bool {
            None => false

            Some(opened) => match kernel_read_members(
              j,
              &mut c,
              specs,
              kernel_atoms(opened.fst),
              out
            ): Bool {
              None => false
              Some(ms) => {
                let names := kernel_list_map_KernelFamily_Text((f: KernelFamily) => f.name, specs)
                var taken: List(Text) := names
                match kernel_read_all_ctors(
                  j,
                  &mut c,
                  specs,
                  ms,
                  &mut taken,
                  opened.fst,
                  names,
                  out
                ): Bool {
                  None => false
                  Some(with_ctors) => {
                    var members: List(KernelMember) := with_ctors
                    var group: List(Text) := names
                    var aliases: List(Pair(Text, List(KernelTerm))) := Nil
                    if kernel_process_members(
                      j,
                      &mut c,
                      &mut members,
                      &mut group,
                      &mut aliases,
                      0,
                      List::length(specs),
                      np,
                      kernel_atoms(opened.fst),
                      out
                    ) && not(
                      List::length(specs) < List::length(members) && kernel_sort_eq(out, KernelProp)
                    ) {
                      let large := kernel_large(j, &mut c, members, out)
                      if kernel_register_members(
                        j,
                        &mut c,
                        List::take(List::length(specs), members),
                        opened.fst
                      ) {
                        var pending: List(KernelGlobal) := Nil
                        let small_ok := kernel_register_elims(
                          j,
                          &mut c,
                          members,
                          members,
                          opened.fst,
                          0,
                          KernelProp,
                          &mut pending
                        )
                        let big_ok: Bool := if large {
                          kernel_register_elims(
                            j,
                            &mut c,
                            members,
                            members,
                            opened.fst,
                            0,
                            KernelType(KernelLevel::Mk(1, Nil)),
                            &mut pending
                          )
                        } else { true }
                        if small_ok && big_ok {
                          kernel_set_to(&mut c.globals, List::append(pending, c.globals))
                          kernel_set_to(
                            &mut c.inductives,
                            List::append(
                              kernel_finish_members(members, group, opened.fst, out, 0),
                              c.inductives
                            )
                          )
                          true
                        } else { false }
                      } else { false }
                    } else { false }
                  }
                }
              }
            }
          }
        } else { false }
      }
    }
  }
}

// Only the terminal universe of a motive changes; its dependent telescope is preserved.
pub fn kernel_motive_at(
  k: Nat,
  &mut c: KernelCore,
  t: KernelTerm,
  level: Nat
): Option(KernelTerm) {
  match k: Option(KernelTerm) {
    Zero => {
      kernel_set_to(&mut c.exhausted, true)
      None
    }
    Succ(j) => match t: Option(KernelTerm) {
      KernelPi(a, b) => match kernel_motive_at(j, &mut c, b, level): Option(KernelTerm) {
        None => None
        Some(body) => Some(KernelPi(a, body))
      }
      KernelSortTerm(s) => match s: Option(KernelTerm) {
        KernelProp => None
        KernelType(old) => Some(KernelSortTerm(KernelType(KernelLevel::Mk(level, Nil))))
      }
      _ => None
    }
  }
}

pub fn kernel_recursor_type_at(
  k: Nat,
  &mut c: KernelCore,
  t: KernelTerm,
  skip: Nat,
  motives: Nat,
  level: Nat
): Option(KernelTerm) {
  match k: Option(KernelTerm) {
    Zero => {
      kernel_set_to(&mut c.exhausted, true)
      None
    }
    Succ(j) => if skip == 0 && motives == 0 { Some(t) } else {
      match t: Option(KernelTerm) {
        KernelPi(a, b) => if skip == 0 {
          match kernel_motive_at(j, &mut c, a, level): Option(KernelTerm) {
            None => None
            Some(domain) => match kernel_recursor_type_at(
              j,
              &mut c,
              b,
              0,
              motives - 1,
              level
            ): Option(KernelTerm) {
              None => None
              Some(body) => Some(KernelPi(domain, body))
            }
          }
        } else {
          match kernel_recursor_type_at(
            j,
            &mut c,
            b,
            skip - 1,
            motives,
            level
          ): Option(KernelTerm) {
            None => None
            Some(body) => Some(KernelPi(a, body))
          }
        }
        _ => None
      }
    }
  }
}

pub fn kernel_recursor_members(
  k: Nat,
  &mut c: KernelCore,
  members: List(Text),
  params: Nat,
  motives: Nat,
  level: Nat
): Bool {
  match k: Bool {
    Zero => { kernel_set_to(&mut c.exhausted, true)
      false }
    Succ(j) => match members: Bool {
      Nil => true
      Cons(member, rest) => {
        let original := Text::concat(member, "_rec")
        let name := Text::concat(Text::concat(original, "@"), Text::of_nat(level))
        match kernel_lookup(c.eliminators, original): Bool {
          None => false
          Some(owner) => if owner == member {
            match kernel_lookup(c.eliminators, name): Bool {
              Some(existing) => existing == member && kernel_recursor_members(
                j,
                &mut c,
                rest,
                params,
                motives,
                level
              )
              None => if kernel_fresh_name(c, name) {
                match kernel_global_get(c.globals, original): Bool {
                  None => false
                  Some(g) => match kernel_recursor_type_at(
                    j,
                    &mut c,
                    g.ty,
                    params,
                    motives,
                    level
                  ): Bool {
                    None => false
                    Some(ty) => match kernel_infer_sort(j, &mut c, ty): Bool {
                      None => false
                      Some(s) => {
                        kernel_put_global(&mut c, name, ty, None)
                        kernel_set_to(
                          &mut c.eliminators,
                          Cons(Pair { fst: name, snd: member }, c.eliminators)
                        )
                        kernel_recursor_members(j, &mut c, rest, params, motives, level)
                      }
                    }
                  }
                }
              } else { false }
            }
          } else { false }
        }
      }
    }
  }
}

pub fn kernel_recursor_at(k: Nat, &mut c: KernelCore, family: Text, level: Nat): Bool {
  if level <= 65535 {
    match kernel_ind_get(c.inductives, family): Bool {
      None => false
      Some(ind) => kernel_recursor_members(
        k,
        &mut c,
        ind.group,
        ind.params,
        List::length(ind.group),
        level
      )
    }
  } else { false }
}
