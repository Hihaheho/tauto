import "level.taut"

// A natural literal is at most eight little-endian base-65536 digits, without
// high zeroes. Intermediate digit arithmetic fits in the extraction's u64.

pub fn kernel_digits_normal(ds: List(Nat)): List(Nat) {
  List::reverse(List::drop_while((d: Nat) => Nat::eq(d, 0), List::reverse(ds)))
}

pub fn kernel_digits_carry(ds: List(Nat), carry: Nat): List(Nat) {
  match ds: List(Nat) {
    Nil => if carry == 0 { Nil } else { Cons(carry, Nil) }

    Cons(x, xs) => Cons(
      Nat::rem_nz(x + carry, 65536, Nat::ne_zero(65536, Refl)),
      kernel_digits_carry(xs, Nat::div_nz(x + carry, 65536, Nat::ne_zero(65536, Refl)))
    )
  }
}

pub fn kernel_digits_add(a: List(Nat), b: List(Nat), carry: Nat): List(Nat) {
  match a: List(Nat) {
    Nil => kernel_digits_carry(b, carry)
    Cons(x, xs) => match b: List(Nat) {
      Nil => Cons(Nat::rem_nz(x + carry, 65536, Nat::ne_zero(65536, Refl)), kernel_digits_add(xs, Nil, Nat::div_nz(x + carry, 65536, Nat::ne_zero(65536, Refl))))

      Cons(y, ys) => Cons(
        Nat::rem_nz(x + y + carry, 65536, Nat::ne_zero(65536, Refl)),
        kernel_digits_add(xs, ys, Nat::div_nz(x + y + carry, 65536, Nat::ne_zero(65536, Refl)))
      )
    }
  }
}

pub fn kernel_digits_scale(a: List(Nat), x: Nat, carry: Nat): List(Nat) {
  match a: List(Nat) {
    Nil => if carry == 0 { Nil } else { Cons(carry, Nil) }

    Cons(y, ys) => Cons(
      Nat::rem_nz(x * y + carry, 65536, Nat::ne_zero(65536, Refl)),
      kernel_digits_scale(ys, x, Nat::div_nz(x * y + carry, 65536, Nat::ne_zero(65536, Refl)))
    )
  }
}

pub fn kernel_digits_mul(a: List(Nat), b: List(Nat)): List(Nat) {
  match a: List(Nat) {
    Nil => Nil

    Cons(x, xs) => kernel_digits_add(
      kernel_digits_scale(b, x, 0),
      Cons(0, kernel_digits_mul(xs, b)),
      0
    )
  }
}

pub fn kernel_borrow(x: Nat, y: Nat): Nat { if x < y { 1 } else { 0 } }

pub fn kernel_digits_sub(a: List(Nat), b: List(Nat), borrow: Nat): List(Nat) {
  match a: List(Nat) {
    Nil => Nil
    Cons(x, xs) => match b: List(Nat) {
      Nil => Cons(
        Nat::rem_nz(65536 + x - borrow, 65536, Nat::ne_zero(65536, Refl)),
        kernel_digits_sub(xs, Nil, kernel_borrow(x, borrow))
      )

      Cons(y, ys) => Cons(
        Nat::rem_nz(65536 + x - (y + borrow), 65536, Nat::ne_zero(65536, Refl)),
        kernel_digits_sub(xs, ys, kernel_borrow(x, y + borrow))
      )
    }
  }
}

pub fn kernel_digits_cmp(a: List(Nat), b: List(Nat)): Ordering {
  match a: Ordering {
    Nil => match b: Ordering {
      Nil => Equal
      Cons(y, ys) => Less }
    Cons(x, xs) => match b: Ordering {
      Nil => Greater

      Cons(y, ys) => if x < y { Less } else {
        if y < x { Greater } else { kernel_digits_cmp(xs, ys) }
      }
    }
  }
}

pub fn kernel_digits_le(a: List(Nat), b: List(Nat)): Bool {
  let na := List::length(a)
  let nb := List::length(b)
  if na < nb { true } else { if nb < na { false } else {
      match kernel_digits_cmp(List::reverse(a), List::reverse(b)): Bool {
        Less => true
        Equal => true
        Greater => false
      }
    } }
}

pub fn kernel_digits_eq(a: List(Nat), b: List(Nat)): Bool {
  match a: Bool {
    Nil => match b: Bool {
      Nil => true
      Cons(y, ys) => false }
    Cons(x, xs) => match b: Bool {
      Nil => false
      Cons(y, ys) => x == y && kernel_digits_eq(xs, ys) }
  }
}

pub fn kernel_digits_checked(ds: List(Nat)): Option(List(Nat)) {
  let ns := kernel_digits_normal(ds)
  if List::length(ns) <= 8 { Some(ns) } else { None }
}

pub fn kernel_digits_arith(op: Text, a: List(Nat), b: List(Nat)): Option(List(Nat)) {
  if op == "+" { kernel_digits_checked(kernel_digits_add(a, b, 0)) } else {
    if op == "*" { kernel_digits_checked(kernel_digits_mul(a, b)) } else {
      if kernel_digits_le(
        b,
        a
      ) { Some(kernel_digits_normal(kernel_digits_sub(a, b, 0))) } else { Some(Nil) }
    }
  }
}
