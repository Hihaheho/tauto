import std::List
import std::Text

// Universe levels of crates/tauto-kernel/src/check/level.rs. Variable offsets
// are compared by name; their list order does not affect the level.
pub(open) inductive KernelLevel: Type {
  Mk(constant: Nat, variables: List(Pair(Text, Nat))): KernelLevel
}

pub(open) inductive KernelSort: Type {
  KernelProp: KernelSort
  KernelType(level: KernelLevel): KernelSort
}

pub fn kernel_list_foldl_Pair_Text_Nat_Nat(
  f: (Nat, Pair(Text, Nat)) -> Nat,
  z: Nat,
  xs: List(Pair(Text, Nat))
): Nat { List::foldl(f, z, xs) }

pub fn kernel_list_all_Pair_Text_Nat_Bool(
  f: (Pair(Text, Nat)) -> Bool,
  xs: List(Pair(Text, Nat))
): Bool { List::all(f, xs) }

pub fn kernel_list_map_Pair_Text_Nat_Pair_Text_Nat(
  f: (Pair(Text, Nat)) -> Pair(Text, Nat),
  xs: List(Pair(Text, Nat))
): List(Pair(Text, Nat)) { List::map(f, xs) }

pub fn kernel_list_filter_Pair_Text_Nat_Bool(
  f: (Pair(Text, Nat)) -> Bool,
  xs: List(Pair(Text, Nat))
): List(Pair(Text, Nat)) { List::filter(f, xs) }

pub fn kernel_level_var_name(v: Pair(Text, Nat)): Text { v.fst }
pub fn kernel_level_var_offset(v: Pair(Text, Nat)): Nat { v.snd }

pub fn kernel_level_offset(name: Text, vs: List(Pair(Text, Nat))): Option(Nat) {
  match vs: Option(Nat) {
    Nil => None

    Cons(v, rest) => if name == kernel_level_var_name(
      v
    ) { Some(kernel_level_var_offset(v)) } else { kernel_level_offset(name, rest) }
  }
}

pub fn kernel_level_floor(l: KernelLevel): Nat {
  kernel_list_foldl_Pair_Text_Nat_Nat(
    (n: Nat, v: Pair(Text, Nat)) => Nat::max(n, kernel_level_var_offset(v)),
    l.constant,
    l.variables
  )
}

pub fn kernel_level_le(a: KernelLevel, b: KernelLevel): Bool {
  a.constant <= kernel_level_floor(b) && kernel_list_all_Pair_Text_Nat_Bool((v: Pair(Text, Nat)) => match kernel_level_offset(kernel_level_var_name(v), b.variables): Bool {
None => false
Some(n) => kernel_level_var_offset(v) <= n
    },
    a.variables
  )
}

pub fn kernel_level_next(l: KernelLevel): KernelLevel {
  KernelLevel::Mk(
    Succ(l.constant),
    kernel_list_map_Pair_Text_Nat_Pair_Text_Nat(
      (v: Pair(Text, Nat)) => Pair {
        fst: kernel_level_var_name(v),
        snd: Succ(kernel_level_var_offset(v))
      },
      l.variables
    )
  )
}

pub fn kernel_level_join(a: KernelLevel, b: KernelLevel): KernelLevel {
  KernelLevel::Mk(
    Nat::max(a.constant, b.constant),
    List::append(
      kernel_list_map_Pair_Text_Nat_Pair_Text_Nat((v: Pair(Text, Nat)) => Pair {
        fst: kernel_level_var_name(v),
        snd: match kernel_level_offset(kernel_level_var_name(v), b.variables): Nat {
None => kernel_level_var_offset(v)
Some(n) => Nat::max(kernel_level_var_offset(v), n)
        }
      }, a.variables),
      kernel_list_filter_Pair_Text_Nat_Bool((v: Pair(Text, Nat)) => match kernel_level_offset(kernel_level_var_name(v), a.variables): Bool {
None => true
Some(n) => false
      }, b.variables)
    )
  )
}

pub fn kernel_sort_next(s: KernelSort): KernelSort {
  match s: KernelSort {
    KernelProp => KernelType(KernelLevel::Mk(0, Nil))
    KernelType(l) => KernelType(kernel_level_next(l))
  }
}

pub fn kernel_sort_le(a: KernelSort, b: KernelSort): Bool {
  match a: Bool {
    KernelProp => true
    KernelType(l) => match b: Bool {
      KernelProp => false
      KernelType(m) => kernel_level_le(l, m)
    }
  }
}

pub fn kernel_sort_eq(a: KernelSort, b: KernelSort): Bool {
  kernel_sort_le(a, b) && kernel_sort_le(b, a)
}

pub fn kernel_sort_pi(a: KernelSort, b: KernelSort): KernelSort {
  match b: KernelSort {
    KernelProp => KernelProp
    KernelType(m) => match a: KernelSort {
      KernelProp => b
      KernelType(l) => KernelType(kernel_level_join(l, m))
    }
  }
}
