import "inductive.taut"

fn kernel_declare(
  k: Nat,
  &mut c: KernelCore,
  name: Text,
  ty: KernelTerm,
  value: Option(KernelTerm),
  transparent: Yn
) -> Yn {
  if kernel_fresh_name(c, name) && kernel_term_valid(ty, 0) {
    match kernel_infer_sort(k, &mut c, ty) -> Yn {
      None => no
      Some(s) => {
        let good = match value -> Yn {
          None => yes
          Some(v) => kernel_term_valid(v, 0) && kernel_check(k, &mut c, v, ty)
        }
        if good {
          let body: Option(KernelTerm) = if transparent { value } else { None }
          kernel_put_global(&mut c, name, ty, body)
          yes
        } else { no }
      }
    }
  } else { no }
}

fn kernel_command(k: Nat, &mut c: KernelCore, command: KernelCommand) -> Yn {
  match command -> Yn {
    KernelDeclare(
      name,
      ty,
      value,
      transparent
    ) => kernel_declare(k, &mut c, name, ty, value, transparent)
    KernelConstant(name, value) => if kernel_fresh_name(c, name) && kernel_term_valid(value, 0) {
      match kernel_infer(k, &mut c, value) -> Yn {
        None => no
        Some(ty) => {
          kernel_put_global(&mut c, name, ty, Some(value))
          yes
        }
      }
    } else { no }
    KernelSetValue(name, value) => match kernel_global_get(c.globals, name) -> Yn {
      None => no
      Some(g) => if kernel_term_valid(value, 0) && kernel_check(k, &mut c, value, g.ty) {
        kernel_put_global(&mut c, name, g.ty, Some(value))
        yes
      } else { no }
    }
    KernelInductive(
      families,
      params,
      sort
    ) => kernel_inductive_inner(k, &mut c, families, params, sort)
    KernelCheck(
      value,
      ty
    ) => kernel_term_valid(
      value,
      0
    ) && kernel_term_valid(ty, 0) && kernel_check(k, &mut c, value, ty)
    KernelConvert(left, right) => kernel_conv(k, &mut c, left, right)
    KernelForget(name) => {
      kernel_set_to(
        &mut c.globals,
        kernel_list_filter_KernelGlobal_Yn(
          (g: KernelGlobal) => !kernel_global_named(g, name),
          c.globals
        )
      )
      yes
    }
  }
}

// Failed registration is transactional, including all inductive metadata.
fn kernel_snapshot(&c: KernelCore) -> KernelCore {
  kernel_core(c.globals, c.inductives, c.constructors, c.eliminators, c.locals, c.next, c.exhausted)
}

fn kernel_execute(k: Nat, &mut c: KernelCore, command: KernelCommand) -> KernelVerdict {
  let saved = kernel_snapshot(&c)
  kernel_set_to(&mut c.exhausted, no)
  let good = kernel_command(k, &mut c, command)
  let exhausted = c.exhausted
  if exhausted {
    c := saved
    KernelExhausted
  } else {
    if good {
      kernel_set_to(&mut c.locals, Nil)
      KernelAccepted
    } else {
      c := saved
      KernelRejected
    }
  }
}
