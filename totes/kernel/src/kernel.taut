import "inductive.taut"
import "check.taut"
import "data.taut"
import "term.taut"

pub fn kernel_declare(
  k: Nat,
  &mut c: KernelCore,
  name: Text,
  ty: KernelTerm,
  value: Option(KernelTerm),
  transparent: Bool
): Bool {
  if kernel_fresh_name(c, name) && kernel_term_valid(ty, 0) {
    match kernel_infer_sort(k, &mut c, ty): Bool {
      None => false
      Some(s) => {
        // A constant of the quotient has no value, the type the kernel
        // gives it, and comes after the constants it mentions.
        let quotient := match kernel_quot_type(name): Bool {
          None => false
          Some(want) => true
        }
        let fits := match kernel_quot_type(name): Bool {
          None => true
          Some(want) => match value: Bool {
            None => kernel_term_eq(ty, want) && kernel_all_in(kernel_quot_needs(name), c.quotient)
            Some(v) => false
          }
        }
        let good := match value: Bool {
          None => true
          Some(v) => kernel_term_valid(v, 0) && kernel_check(k, &mut c, v, ty)
        }
        if good && fits {
          let body: Option(KernelTerm) := if transparent { value } else { None }
          kernel_put_global(&mut c, name, ty, body)
          if quotient { kernel_set_to(&mut c.quotient, Cons(name, c.quotient)) }
          true
        } else { false }
      }
    }
  } else { false }
}

pub fn kernel_command(k: Nat, &mut c: KernelCore, command: KernelCommand): Bool {
  match command: Bool {
    KernelDeclare(name, ty, value, transparent) => kernel_declare(
      k,
      &mut c,
      name,
      ty,
      value,
      transparent
    )
    KernelConstant(name, value) => if kernel_fresh_name(c, name) && kernel_term_valid(value, 0) {
      match kernel_infer(k, &mut c, value): Bool {
        None => false
        Some(ty) => {
          kernel_put_global(&mut c, name, ty, Some(value))
          true
        }
      }
    } else { false }
    KernelSetValue(name, value) => match kernel_global_get(c.globals, name): Bool {
      None => false
      Some(g) => if not(
        kernel_text_in(c.quotient, name)
      ) && kernel_term_valid(value, 0) && kernel_check(k, &mut c, value, g.ty) {
        kernel_put_global(&mut c, name, g.ty, Some(value))
        true
      } else { false }
    }
    KernelInductive(families, params, sort) => kernel_inductive_inner(
      k,
      &mut c,
      families,
      params,
      sort
    )
    KernelRecursor(family, level) => kernel_recursor_at(k, &mut c, family, level)
    KernelCheck(value, ty) => kernel_term_valid(
      value,
      0
    ) && kernel_term_valid(ty, 0) && kernel_check(k, &mut c, value, ty)
    KernelConvert(left, right) => kernel_conv(k, &mut c, left, right)
    KernelForget(name) => {
      kernel_set_to(
        &mut c.globals,
        kernel_list_filter_KernelGlobal_Bool(
          (g: KernelGlobal) => not(kernel_global_named(g, name)),
          c.globals
        )
      )
      kernel_set_to(&mut c.quotient, kernel_text_without(c.quotient, name))
      true
    }
  }
}

fn kernel_text_without(xs: List(Text), name: Text): List(Text) {
  match xs: List(Text) {
    Nil => Nil
    Cons(x, rest) => if x == name { kernel_text_without(rest, name) } else {
      Cons(x, kernel_text_without(rest, name))
    }
  }
}

// Failed registration is transactional, including all inductive metadata.
pub fn kernel_snapshot(&c: KernelCore): KernelCore {
  KernelCore::Mk(
    c.globals,
    c.inductives,
    c.constructors,
    c.eliminators,
    c.locals,
    c.next,
    c.exhausted,
    c.quotient
  )
}

pub fn kernel_execute(k: Nat, &mut c: KernelCore, command: KernelCommand): KernelVerdict {
  let saved := kernel_snapshot(&c)
  kernel_set_to(&mut c.exhausted, false)
  let good := kernel_command(k, &mut c, command)
  let exhausted := c.exhausted
  if exhausted {
    c := saved
    KernelExhausted
  } else {
    if good {
      kernel_set_to(&mut c.locals, Nil)
      KernelAccepted
    } else {
      c := saved
      KernelRejected
    }
  }
}
