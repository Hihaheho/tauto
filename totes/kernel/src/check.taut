import "data.taut"
import "level.taut"
import "term.taut"
import "wide.taut"
import std::Text
import std::List
import std::Base

pub fn kernel_list_map_Text_Nat(f: (Text) -> Nat, xs: List(Text)): List(Nat) { List::map(f, xs) }

pub fn kernel_list_foldl_Nat_Nat(
  f: (Nat, Nat) -> Nat,
  z: Nat,
  xs: List(Nat)
): Nat { List::foldl(f, z, xs) }

pub fn kernel_list_map_KernelTerm_KernelTerm(
  f: (KernelTerm) -> KernelTerm,
  xs: List(KernelTerm)
): List(KernelTerm) { List::map(f, xs) }

pub fn kernel_term_or(o: Option(KernelTerm)): KernelTerm {
  match o: KernelTerm {
    None => KernelBVar(0)
    Some(t) => t }
}

pub fn kernel_ctor_count(c: KernelCore, name: Text): Nat {
  match kernel_ind_get(c.inductives, name): Nat {
    None => 0
    Some(i) => List::length(i.constructors)
  }
}

pub fn kernel_count_ctors(c: KernelCore, group: List(Text)): List(Nat) {
  kernel_list_map_Text_Nat((name: Text) => kernel_ctor_count(c, name), group)
}

pub fn kernel_sum(ns: List(Nat)): Nat {
  kernel_list_foldl_Nat_Nat((a: Nat, b: Nat) => a + b, 0, ns)
}

pub fn kernel_as_ctor(
  c: KernelCore,
  t: KernelTerm,
  family: Text
): Option(Pair(Text, List(KernelTerm))) {
  match kernel_as_lit(t): Option(Pair(Text, List(KernelTerm))) {
    Some(ds) => if family == "Nat" {
      match kernel_lookup(c.constructors, "Zero"): Option(Pair(Text, List(KernelTerm))) {
        None => None
        Some(z) => if kernel_digits_eq(ds, Nil) { Some(Pair { fst: "Zero", snd: Nil }) } else {
          Some(
            Pair {
              fst: "Succ",
              snd: Cons(
                KernelLit(kernel_digits_normal(kernel_digits_sub(ds, Cons(1, Nil), 0))),
                Nil
              )
            }
          )
        }
      }
    } else { None }
    None => { let sp := kernel_spine(t)
      match kernel_as_const(sp.fst): Option(Pair(Text, List(KernelTerm))) {
        None => None
        Some(n) => match kernel_lookup(c.constructors, n): Option(Pair(Text, List(KernelTerm))) {
          None => None
          Some(ci) => if ci.fst == family { Some(Pair { fst: n, snd: sp.snd }) } else { None }
        }
      }
    }
  }
}

// Every recursive call in this group consumes one level of fuel. Exhaustion
// is sticky, and a public operation reports it separately from rejection.
mutual {
  pub fn kernel_whnf(k: Nat, &mut c: KernelCore, t: KernelTerm, delta: Bool): KernelTerm {
    match k: KernelTerm {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        t }
      Succ(j) => {
        let sp := kernel_spine(t)
        match kernel_as_lam(sp.fst): KernelTerm {
          Some(body) => match sp.snd: KernelTerm {
            Nil => t

            Cons(arg, rest) => kernel_whnf(
              j,
              &mut c,
              kernel_apps(kernel_inst(body, arg), rest),
              delta
            )
          }
          None => match kernel_as_const(sp.fst): KernelTerm {
            None => t
            Some(name) => match kernel_unfold_head(c, t): KernelTerm {
              Some(v) => if delta { kernel_whnf(j, &mut c, v, delta) } else { t }
              None => match kernel_arith(j, &mut c, name, sp.snd): KernelTerm {
                Some(v) => kernel_whnf(j, &mut c, v, delta)
                None => match kernel_iota(j, &mut c, name, sp.snd): KernelTerm {
                  Some(v) => kernel_whnf(j, &mut c, v, delta)
                  None => match kernel_quot_iota(j, &mut c, name, sp.snd): KernelTerm {
                    Some(v) => kernel_whnf(j, &mut c, v, delta)
                    None => t
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_arith(
    k: Nat,
    &mut c: KernelCore,
    op: Text,
    args: List(KernelTerm)
  ): Option(KernelTerm) {
    match k: Option(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => if (op == "+" || op == "*" || op == "-") && 2 <= List::length(args) {
        let b := kernel_whnf(j, &mut c, kernel_term_or(List::nth(args, 1)), true)
        // `a` is reduced only when `b` is a numeral, and then `+`, `*` and `-` in it
        // only on numerals (`kernel_literal_or_whnf`).
        let a := match kernel_as_lit(b): KernelTerm {
          Some(ys) => kernel_literal_or_whnf(j, &mut c, kernel_term_or(List::nth(args, 0)))
          None => kernel_term_or(List::nth(args, 0))
        }
        let rest := List::drop(2, args)
        match kernel_as_lit(a): Option(KernelTerm) {
          Some(xs) => match kernel_as_lit(b): Option(KernelTerm) {
            Some(ys) => match kernel_digits_arith(op, xs, ys): Option(KernelTerm) {
              None => None
              Some(ds) => Some(kernel_apps(KernelLit(ds), rest))
            }
            None => kernel_arith_symbolic(j, &mut c, op, a, b, rest)
          }
          None => kernel_arith_symbolic(j, &mut c, op, a, b, rest)
        }
      } else { None }
    }
  }

  // `t` reduced, except that `+`, `*` and `-` are only computed on numerals.
  pub fn kernel_literal_or_whnf(k: Nat, &mut c: KernelCore, t: KernelTerm): KernelTerm {
    match k: KernelTerm {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        t }
      Succ(j) => {
        let sp := kernel_spine(t)
        match sp.fst: KernelTerm {
          KernelBVar(i) => kernel_whnf(j, &mut c, t, true)
          KernelFVar(x) => kernel_whnf(j, &mut c, t, true)
          KernelSortTerm(s) => kernel_whnf(j, &mut c, t, true)
          KernelPi(d, e) => kernel_whnf(j, &mut c, t, true)
          KernelLam(e) => kernel_whnf(j, &mut c, t, true)
          KernelApp(f, x) => kernel_whnf(j, &mut c, t, true)
          KernelLit(ds) => t
          KernelBool(v) => t
          KernelConst(n) => if n == "+" || n == "*" || n == "-" {
            if List::length(sp.snd) == 2 {
              let x := kernel_literal_or_whnf(j, &mut c, kernel_term_or(List::nth(sp.snd, 0)))
              let y := kernel_literal_or_whnf(j, &mut c, kernel_term_or(List::nth(sp.snd, 1)))
              match kernel_as_lit(x): KernelTerm {
                None => t
                Some(xs) => match kernel_as_lit(y): KernelTerm {
                  None => t
                  Some(ys) => match kernel_digits_arith(n, xs, ys): KernelTerm {
                    None => t
                    Some(ds) => KernelLit(ds)
                  }
                }
              }
            } else { t }
          } else { kernel_whnf(j, &mut c, t, true) }
        }
      }
    }
  }

  pub fn kernel_arith_symbolic(
    k: Nat,
    &mut c: KernelCore,
    op: Text,
    a: KernelTerm,
    b: KernelTerm,
    rest: List(KernelTerm)
  ): Option(KernelTerm) {
    match k: Option(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match kernel_nat_view(b): Option(KernelTerm) {
        None => None
        Some(None) => {
          let out: KernelTerm := if op == "*" { KernelLit(Nil) } else { a }
          Some(kernel_apps(out, rest))
        }
        Some(Some(pred)) => if op == "+" {
          Some(
            kernel_apps(
              KernelApp(
                KernelConst("Succ"),
                kernel_apps(KernelConst("+"), Cons(a, Cons(pred, Nil)))
              ),
              rest
            )
          )
        } else {
          if op == "*" {
            Some(
              kernel_apps(
                kernel_apps(
                  KernelConst("+"),
                  Cons(kernel_apps(KernelConst("*"), Cons(a, Cons(pred, Nil))), Cons(a, Nil))
                ),
                rest
              )
            )
          } else {
            let d := kernel_whnf(
              j,
              &mut c,
              kernel_apps(KernelConst("-"), Cons(a, Cons(pred, Nil))),
              true
            )
            match kernel_nat_view(d): Option(KernelTerm) {
              None => None
              Some(None) => Some(kernel_apps(KernelLit(Nil), rest))
              Some(Some(p)) => Some(kernel_apps(p, rest))
            }
          }
        }
      }
    }
  }

  // `Quot::lift(A, r, B, f, h, Quot::mk(A', r', a))` is `f(a)` and
  // `Quot::ind(A, r, P, m, Quot::mk(A', r', a))` is `m(a)`.
  fn kernel_quot_iota(
    k: Nat,
    &mut c: KernelCore,
    name: Text,
    args: List(KernelTerm)
  ): Option(KernelTerm) {
    match k: Option(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => {
        let major_at: Option(Nat) := if kernel_text_in(c.quotient, name) {
          if name == "Quot::lift" { Some(5) } else {
            if name == "Quot::ind" { Some(4) } else { None }
          }
        } else { None }
        match major_at: Option(KernelTerm) {
          None => None
          Some(at) => match List::nth(args, at): Option(KernelTerm) {
            None => None
            Some(major) => {
              let inner := kernel_spine(kernel_whnf(j, &mut c, major, true))
              let mk := match kernel_as_const(inner.fst): Bool {
                None => false
                Some(n) => n == "Quot::mk" && kernel_text_in(
                  c.quotient,
                  n
                ) && List::length(inner.snd) == 3
              }
              if mk {
                match List::nth(args, 3): Option(KernelTerm) {
                  None => None
                  Some(f) => match List::nth(inner.snd, 2): Option(KernelTerm) {
                    None => None
                    Some(a) => Some(kernel_apps(KernelApp(f, a), List::drop(Succ(at), args)))
                  }
                }
              } else { None }
            }
          }
        }
      }
    }
  }

  pub fn kernel_iota(
    k: Nat,
    &mut c: KernelCore,
    rec: Text,
    args: List(KernelTerm)
  ): Option(KernelTerm) {
    match k: Option(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match kernel_lookup(c.eliminators, rec): Option(KernelTerm) {
        None => None
        Some(family) => match kernel_ind_get(c.inductives, family): Option(KernelTerm) {
          None => None
          Some(ind) => {
            let counts := kernel_count_ctors(c, ind.group)
            let prefix := ind.params + List::length(ind.group) + kernel_sum(counts)
            let major_at := prefix + ind.indices
            match List::nth(args, major_at): Option(KernelTerm) {
              None => None
              Some(major) => {
                let reduced := kernel_whnf(j, &mut c, major, true)
                let of := match ind.alias: Text {
                  None => family
                  Some(alias) => alias.fst }
                let found := kernel_as_ctor(c, reduced, of)
                let chosen := match found: Option(Pair(Text, List(KernelTerm))) {
                  Some(pair) => Some(pair)
                  None => match ind.k_like: Option(Pair(Text, List(KernelTerm))) {
                    None => None

                    Some(want) => if kernel_conv_indices(
                      j,
                      &mut c,
                      kernel_list_map_KernelTerm_KernelTerm(
                        (w: KernelTerm) => kernel_inst_many(w, List::take(ind.params, args)),
                        want
                      ),
                      List::take(ind.indices, List::drop(prefix, args))
                    ) {
                      match List::head(ind.constructors): Option(Pair(Text, List(KernelTerm))) {
                        None => None
                        Some(ci) => Some(Pair { fst: ci.name, snd: List::take(ind.params, args) })
                      }
                    } else { None }
                  }
                }
                match chosen: Option(KernelTerm) {
                  None => None
                  Some(pair) => match kernel_lookup(c.constructors, pair.fst): Option(KernelTerm) {
                    None => None

                    Some(owner) => match List::nth(
                      ind.constructors,
                      owner.snd
                    ): Option(KernelTerm) {
                      None => None
                      Some(ci) => {
                        let cnp := match ind.alias: Nat {
                          None => ind.params
                          Some(alias) => List::length(alias.snd) }
                        if ci.name == pair.fst && List::length(pair.snd) == cnp + ci.nargs {
                          let actual := List::drop(cnp, pair.snd)
                          let minor_at := ind.params + List::length(
                            ind.group
                          ) + kernel_sum(List::take(ind.position, counts)) + owner.snd
                          match List::nth(args, minor_at): Option(KernelTerm) {
                            None => None
                            Some(minor) => {
                              let ihs := kernel_iota_ihs(
                                j,
                                &mut c,
                                ci.recursive,
                                ind,
                                rec,
                                args,
                                prefix,
                                actual
                              )
                              Some(
                                kernel_apps(
                                  kernel_apps(minor, List::append(actual, ihs)),
                                  List::drop(Succ(major_at), args)
                                )
                              )
                            }
                          }
                        } else { None }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_iota_ihs(
    k: Nat,
    &mut c: KernelCore,
    rs: List(KernelRecArg),
    ind: KernelIndInfo,
    rec: Text,
    args: List(KernelTerm),
    prefix: Nat,
    actual: List(KernelTerm)
  ): List(KernelTerm) {
    match k: List(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => match rs: List(KernelTerm) {
        Nil => Nil
        Cons(r, rest) => {
          let ys := kernel_fresh_many(j, &mut c, r.ys)
          let yvars := List::map(KernelFVar, ys)
          let env := List::append(List::take(ind.params, args), List::append(actual, yvars))
          let indices := kernel_list_map_KernelTerm_KernelTerm(
            (t: KernelTerm) => kernel_inst_many(t, env),
            r.indices
          )
          let field := kernel_apps(kernel_term_or(List::nth(actual, r.arg)), yvars)
          let suffix := Text::slice_or_empty(rec, Text::len(ind.name), Text::len(rec))
          let target := match List::nth(ind.group, r.family): Text {
            None => ""
            Some(n) => Text::concat(n, suffix) }
          let ih := kernel_bind_lams(
            ys,
            kernel_apps(
              KernelConst(target),
              List::append(List::take(prefix, args), List::append(indices, Cons(field, Nil)))
            )
          )
          Cons(ih, kernel_iota_ihs(j, &mut c, rest, ind, rec, args, prefix, actual))
        }
      }
    }
  }

  pub fn kernel_fresh_many(k: Nat, &mut c: KernelCore, n: Nat): List(Nat) {
    match k: List(Nat) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        Nil }
      Succ(j) => match n: List(Nat) {
        Zero => Nil
        Succ(m) => {
          let x := kernel_fresh(&mut c, KernelSortTerm(KernelProp))
          Cons(x, kernel_fresh_many(j, &mut c, m))
        }
      }
    }
  }

  pub fn kernel_conv(k: Nat, &mut c: KernelCore, a: KernelTerm, b: KernelTerm): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }

      Succ(j) => if kernel_conv_plain(
        j,
        &mut c,
        a,
        b
      ) { true } else { kernel_conv_typed(j, &mut c, a, b, None) }
    }
  }

  pub fn kernel_conv_plain(k: Nat, &mut c: KernelCore, a: KernelTerm, b: KernelTerm): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => if kernel_term_eq(a, b) { true } else {
        let x := kernel_whnf(j, &mut c, a, false)
        let y := kernel_whnf(j, &mut c, b, false)
        if kernel_term_eq(x, y) { true } else {
          let sx := kernel_spine(x)
          let sy := kernel_spine(y)
          let same := match kernel_as_const(sx.fst): Bool {
            None => false
            Some(nx) => match kernel_as_const(sy.fst): Bool {
              None => false

              Some(ny) => if nx == ny { kernel_conv_lists(j, &mut c, sx.snd, sy.snd, None) } else {
                false
              }
            }
          }
          if same { true } else {
            let ux := kernel_unfold_head(c, x)
            let uy := kernel_unfold_head(c, y)
            match ux: Bool {
              Some(vx) => kernel_conv_plain(j, &mut c, vx, match uy: KernelTerm {
None => y
Some(vy) => vy })
              None => match uy: Bool {
                Some(vy) => kernel_conv_plain(j, &mut c, x, vy)
                None => kernel_conv_shapes(j, &mut c, x, y, None, false)
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_is_prop(k: Nat, &mut c: KernelCore, ty: KernelTerm): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match kernel_infer(j, &mut c, ty): Bool {
        None => false
        Some(s) => kernel_term_eq(kernel_whnf(j, &mut c, s, true), KernelSortTerm(KernelProp))
      }
    }
  }

  pub fn kernel_conv_typed(
    k: Nat,
    &mut c: KernelCore,
    a: KernelTerm,
    b: KernelTerm,
    ty: Option(KernelTerm)
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => if kernel_conv_plain(j, &mut c, a, b) { true } else {
        let proof := match ty: Bool {
          None => false
          Some(t) => kernel_is_prop(j, &mut c, t) }
        if proof { true } else {
          let x := kernel_whnf(j, &mut c, a, true)
          let y := kernel_whnf(j, &mut c, b, true)
          kernel_conv_shapes(j, &mut c, x, y, ty, true)
        }
      }
    }
  }

  pub fn kernel_conv_shapes(
    k: Nat,
    &mut c: KernelCore,
    a: KernelTerm,
    b: KernelTerm,
    ty: Option(KernelTerm),
    typed: Bool
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => {
        let al := match kernel_as_lit(a): Bool {
          None => false
          Some(ds) => true }
        let bl := match kernel_as_lit(b): Bool {
          None => false
          Some(ds) => true }
        let x: KernelTerm := if Bool::eq(al, bl) { a } else { kernel_expand_lit(a) }
        let y: KernelTerm := if Bool::eq(al, bl) { b } else { kernel_expand_lit(b) }
        match kernel_as_pi(x): Bool {
          Some(#(@domain px_domain, @codomain px_codomain)) => match kernel_as_pi(y): Bool {
            None => false
            Some(#(@domain py_domain, @codomain py_codomain)) => if kernel_conv_part(j, &mut c, px_domain, py_domain, None, typed) {
              let atom := kernel_fresh(&mut c, px_domain)
              kernel_conv_part(
                j,
                &mut c,
                kernel_inst(px_codomain, KernelFVar(atom)),
                kernel_inst(py_codomain, KernelFVar(atom)),
                None,
                typed
              )
            } else { false }
          }
          None => {
            let lx := kernel_as_lam(x)
            let ly := kernel_as_lam(y)
            match lx: Bool {
              Some(body) => kernel_conv_lambda(j, &mut c, body, y, ly, ty, typed)
              None => match ly: Bool {
                Some(body) => kernel_conv_lambda(j, &mut c, body, x, None, ty, typed)
                None => if typed {
                  let sx := kernel_spine(x)
                  let sy := kernel_spine(y)
                  if 0 < List::length(
                    sx.snd
                  ) && List::length(
                    sx.snd
                  ) == List::length(sy.snd) && kernel_conv_plain(j, &mut c, sx.fst, sy.fst) {
                    match kernel_infer(j, &mut c, sx.fst): Bool {
                      None => false
                      Some(ht) => kernel_conv_lists(j, &mut c, sx.snd, sy.snd, Some(ht))
                    }
                  } else { false }
                } else { kernel_conv_atomic(j, &mut c, x, y) }
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_conv_part(
    k: Nat,
    &mut c: KernelCore,
    a: KernelTerm,
    b: KernelTerm,
    ty: Option(KernelTerm),
    typed: Bool
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }

      Succ(j) => if typed { kernel_conv_typed(j, &mut c, a, b, ty) } else {
        kernel_conv_plain(j, &mut c, a, b)
      }
    }
  }

  pub fn kernel_conv_lambda(
    k: Nat,
    &mut c: KernelCore,
    body: KernelTerm,
    other: KernelTerm,
    other_body: Option(KernelTerm),
    ty: Option(KernelTerm),
    typed: Bool
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => {
        let pi := match ty: Option(@domain KernelTerm × @codomain KernelTerm) {
          None => None
          Some(t) => kernel_as_pi(kernel_whnf(j, &mut c, t, true))
        }
        if typed {
          match pi: Bool {
            None => false
            Some(#(@domain domain, @codomain codomain)) => {
              let atom := kernel_fresh(&mut c, domain)
              let arg := KernelFVar(atom)
              let rhs := match other_body: KernelTerm {
                None => KernelApp(other, arg)
                Some(b) => kernel_inst(b, arg)
              }
              kernel_conv_typed(
                j,
                &mut c,
                kernel_inst(body, arg),
                rhs,
                Some(kernel_inst(codomain, arg))
              )
            }
          }
        } else {
          let atom := kernel_fresh(&mut c, KernelSortTerm(KernelProp))
          let arg := KernelFVar(atom)
          let rhs := match other_body: KernelTerm {
            None => KernelApp(other, arg)
            Some(b) => kernel_inst(b, arg) }
          kernel_conv_plain(j, &mut c, kernel_inst(body, arg), rhs)
        }
      }
    }
  }

  pub fn kernel_conv_atomic(k: Nat, &mut c: KernelCore, x: KernelTerm, y: KernelTerm): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => {
        let sx := kernel_spine(x)
        let sy := kernel_spine(y)
        if 0 < List::length(sx.snd) && List::length(sx.snd) == List::length(sy.snd) {
          kernel_conv_plain(
            j,
            &mut c,
            sx.fst,
            sy.fst
          ) && kernel_conv_lists(j, &mut c, sx.snd, sy.snd, None)
        } else { kernel_term_eq(x, y) }
      }
    }
  }

  pub fn kernel_conv_indices(
    k: Nat,
    &mut c: KernelCore,
    xs: List(KernelTerm),
    ys: List(KernelTerm)
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match xs: Bool {
        Nil => match ys: Bool { Nil => true
          Cons(y, tail) => false }
        Cons(x, rest) => match ys: Bool {
          Nil => false
          Cons(y, tail) => kernel_conv(j, &mut c, x, y) && kernel_conv_indices(
            j,
            &mut c,
            rest,
            tail
          )
        }
      }
    }
  }

  pub fn kernel_conv_lists(
    k: Nat,
    &mut c: KernelCore,
    xs: List(KernelTerm),
    ys: List(KernelTerm),
    ty: Option(KernelTerm)
  ): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match xs: Bool {
        Nil => match ys: Bool {
          Nil => true
          Cons(y, tail) => false }
        Cons(x, rest) => match ys: Bool {
          Nil => false
          Cons(y, tail) => match ty: Bool {
            None => kernel_conv_plain(
              j,
              &mut c,
              x,
              y
            ) && kernel_conv_lists(j, &mut c, rest, tail, None)
            Some(ht) => match kernel_as_pi(kernel_whnf(j, &mut c, ht, true)): Bool {
              None => false

              Some(#(@domain domain, @codomain codomain)) => kernel_conv_typed(
                j,
                &mut c,
                x,
                y,
                Some(domain)
              ) && kernel_conv_lists(j, &mut c, rest, tail, Some(kernel_inst(codomain, x)))
            }
          }
        }
      }
    }
  }

  pub fn kernel_subtype(k: Nat, &mut c: KernelCore, a: KernelTerm, b: KernelTerm): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => {
        let x := kernel_whnf(j, &mut c, a, true)
        let y := kernel_whnf(j, &mut c, b, true)
        match kernel_as_sort(x): Bool {
          Some(s) => match kernel_as_sort(y): Bool {
            None => kernel_conv(j, &mut c, x, y)
            Some(t) => kernel_sort_le(s, t) }
          None => match kernel_as_pi(x): Bool {
            Some(#(@domain px_domain, @codomain px_codomain)) => match kernel_as_pi(y): Bool {
              None => kernel_conv(j, &mut c, x, y)
              Some(#(@domain py_domain, @codomain py_codomain)) => if kernel_conv(j, &mut c, px_domain, py_domain) {
                let atom := kernel_fresh(&mut c, px_domain)
                kernel_subtype(
                  j,
                  &mut c,
                  kernel_inst(px_codomain, KernelFVar(atom)),
                  kernel_inst(py_codomain, KernelFVar(atom))
                )
              } else { false }
            }
            None => kernel_conv(j, &mut c, x, y)
          }
        }
      }
    }
  }

  pub fn kernel_infer(k: Nat, &mut c: KernelCore, t: KernelTerm): Option(KernelTerm) {
    match k: Option(KernelTerm) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match t: Option(KernelTerm) {
        KernelBVar(i) => None
        KernelFVar(x) => kernel_local_get(c.locals, x)
        KernelSortTerm(s) => Some(KernelSortTerm(kernel_sort_next(s)))
        KernelConst(n) => match kernel_global_get(c.globals, n): Option(KernelTerm) {
          None => None
          Some(g) => Some(g.ty) }
        KernelLit(ds) => Some(KernelConst("Nat"))
        KernelBool(v) => Some(KernelConst("Bool"))
        KernelLam(body) => None
        KernelPi(a, b) => match kernel_infer_sort(j, &mut c, a): Option(KernelTerm) {
          None => None
          Some(s) => {
            let atom := kernel_fresh(&mut c, a)
            match kernel_infer_sort(
              j,
              &mut c,
              kernel_inst(b, KernelFVar(atom))
            ): Option(KernelTerm) {
              None => None
              Some(u) => Some(KernelSortTerm(kernel_sort_pi(s, u)))
            }
          }
        }
        KernelApp(f, a) => {
          let sp := kernel_spine(t)
          match kernel_as_lam(sp.fst): Option(KernelTerm) {
            Some(body) => if kernel_infer_args(j, &mut c, sp.snd) {
              let reduced := kernel_whnf(j, &mut c, t, true)
              if kernel_term_eq(t, reduced) { None } else { kernel_infer(j, &mut c, reduced) }
            } else { None }
            None => match kernel_infer(j, &mut c, f): Option(KernelTerm) {
              None => None
              Some(ft) => match kernel_as_pi(kernel_whnf(j, &mut c, ft, true)): Option(KernelTerm) {
                None => None

                Some(#(@domain domain, @codomain codomain)) => if kernel_check(
                  j,
                  &mut c,
                  a,
                  domain
                ) { Some(kernel_inst(codomain, a)) } else { None }
              }
            }
          }
        }
      }
    }
  }

  pub fn kernel_infer_args(k: Nat, &mut c: KernelCore, args: List(KernelTerm)): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match args: Bool {
        Nil => true
        Cons(a, rest) => match kernel_infer(j, &mut c, a): Bool {
          None => false
          Some(t) => kernel_infer_args(j, &mut c, rest)
        }
      }
    }
  }

  pub fn kernel_infer_sort(k: Nat, &mut c: KernelCore, t: KernelTerm): Option(KernelSort) {
    match k: Option(KernelSort) {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        None }
      Succ(j) => match kernel_infer(j, &mut c, t): Option(KernelSort) {
        None => None
        Some(ty) => kernel_as_sort(kernel_whnf(j, &mut c, ty, true))
      }
    }
  }

  pub fn kernel_check(k: Nat, &mut c: KernelCore, t: KernelTerm, expected: KernelTerm): Bool {
    match k: Bool {
      Zero => { kernel_set_to(&mut c.exhausted, true)
        false }
      Succ(j) => match kernel_as_lam(t): Bool {
        Some(body) => match kernel_as_pi(kernel_whnf(j, &mut c, expected, true)): Bool {
          None => false
          Some(#(@domain domain, @codomain codomain)) => {
            let atom := kernel_fresh(&mut c, domain)
            kernel_check(
              j,
              &mut c,
              kernel_inst(body, KernelFVar(atom)),
              kernel_inst(codomain, KernelFVar(atom))
            )
          }
        }
        None => match kernel_infer(j, &mut c, t): Bool {
          None => false
          Some(actual) => kernel_subtype(j, &mut c, actual, expected)
        }
      }
    }
  }
}
