import "wide.taut"
import "level.taut"
import std::List
import std::Text
import std::Base

// Locally nameless terms. Binder hints carry no semantic information.
pub(open) inductive KernelTerm: Type {
  KernelBVar(i: Nat): KernelTerm
  KernelFVar(x: Nat): KernelTerm
  KernelSortTerm(s: KernelSort): KernelTerm
  KernelConst(name: Text): KernelTerm
  KernelPi(domain: KernelTerm, codomain: KernelTerm): KernelTerm
  KernelLam(body: KernelTerm): KernelTerm
  KernelApp(function: KernelTerm, argument: KernelTerm): KernelTerm
  KernelLit(digits: List(Nat)): KernelTerm
  KernelBool(value: Bool): KernelTerm
}

pub fn kernel_list_foldl_KernelTerm_KernelTerm(
  f: (KernelTerm, KernelTerm) -> KernelTerm,
  z: KernelTerm,
  xs: List(KernelTerm)
): KernelTerm { List::foldl(f, z, xs) }

pub fn kernel_inst_at(t: KernelTerm, depth: Nat, value: KernelTerm): KernelTerm {
  match t: KernelTerm {
    KernelBVar(i) => if i == depth { value } else {
      if depth < i { KernelBVar(i - 1) } else { KernelBVar(i) }
    }
    KernelFVar(x) => KernelFVar(x)
    KernelSortTerm(s) => KernelSortTerm(s)
    KernelConst(n) => KernelConst(n)
    KernelPi(a, b) => KernelPi(
      kernel_inst_at(a, depth, value),
      kernel_inst_at(b, Succ(depth), value)
    )
    KernelLam(b) => KernelLam(kernel_inst_at(b, Succ(depth), value))
    KernelApp(f, a) => KernelApp(kernel_inst_at(f, depth, value), kernel_inst_at(a, depth, value))
    KernelLit(ds) => KernelLit(ds)
    KernelBool(v) => KernelBool(v)
  }
}

pub fn kernel_abstract_at(t: KernelTerm, depth: Nat, atom: Nat): KernelTerm {
  match t: KernelTerm {
    KernelBVar(i) => KernelBVar(i)
    KernelFVar(x) => if x == atom { KernelBVar(depth) } else { KernelFVar(x) }
    KernelSortTerm(s) => KernelSortTerm(s)
    KernelConst(n) => KernelConst(n)
    KernelPi(a, b) => KernelPi(
      kernel_abstract_at(a, depth, atom),
      kernel_abstract_at(b, Succ(depth), atom)
    )
    KernelLam(b) => KernelLam(kernel_abstract_at(b, Succ(depth), atom))
    KernelApp(f, a) => KernelApp(
      kernel_abstract_at(f, depth, atom),
      kernel_abstract_at(a, depth, atom)
    )
    KernelLit(ds) => KernelLit(ds)
    KernelBool(v) => KernelBool(v)
  }
}

pub fn kernel_has_loose(t: KernelTerm, depth: Nat): Bool {
  match t: Bool {
    KernelBVar(i) => depth <= i
    KernelFVar(x) => false
    KernelSortTerm(s) => false
    KernelConst(n) => false
    KernelPi(a, b) => kernel_has_loose(a, depth) || kernel_has_loose(b, Succ(depth))
    KernelLam(b) => kernel_has_loose(b, Succ(depth))
    KernelApp(f, a) => kernel_has_loose(f, depth) || kernel_has_loose(a, depth)
    KernelLit(ds) => false
    KernelBool(v) => false
  }
}

pub fn kernel_mentions_fvar(t: KernelTerm): Bool {
  match t: Bool {
    KernelBVar(i) => false
    KernelFVar(x) => true
    KernelSortTerm(s) => false
    KernelConst(n) => false
    KernelPi(a, b) => kernel_mentions_fvar(a) || kernel_mentions_fvar(b)
    KernelLam(b) => kernel_mentions_fvar(b)
    KernelApp(f, a) => kernel_mentions_fvar(f) || kernel_mentions_fvar(a)
    KernelLit(ds) => false
    KernelBool(v) => false
  }
}

pub fn kernel_mentions_const(t: KernelTerm, names: List(Text)): Bool {
  match t: Bool {
    KernelBVar(i) => false
    KernelFVar(x) => false
    KernelSortTerm(s) => false
    KernelConst(n) => List::contains(Text::eq, n, names)
    KernelPi(a, b) => kernel_mentions_const(a, names) || kernel_mentions_const(b, names)
    KernelLam(b) => kernel_mentions_const(b, names)
    KernelApp(f, a) => kernel_mentions_const(f, names) || kernel_mentions_const(a, names)
    KernelLit(ds) => false
    KernelBool(v) => false
  }
}

pub fn kernel_term_eq(t: KernelTerm, u: KernelTerm): Bool {
  match t: Bool {
    KernelBVar(i) => match u: Bool {
      KernelBVar(ii) => i == ii
      KernelFVar(xx) => false
      KernelSortTerm(ss) => false
      KernelConst(nn) => false
      KernelPi(aa, bb) => false
      KernelLam(bb) => false
      KernelApp(ff, aa) => false
      KernelLit(dds) => false
      KernelBool(vv) => false
    }
    KernelFVar(x) => match u: Bool {
      KernelBVar(ii) => false
      KernelFVar(xx) => x == xx
      KernelSortTerm(ss) => false
      KernelConst(nn) => false
      KernelPi(aa, bb) => false
      KernelLam(bb) => false
      KernelApp(ff, aa) => false
      KernelLit(dds) => false
      KernelBool(vv) => false
    }
    KernelSortTerm(s) => match u: Bool {
      KernelBVar(ii) => false
      KernelFVar(xx) => false
      KernelSortTerm(ss) => kernel_sort_eq(s, ss)
      KernelConst(nn) => false
      KernelPi(aa, bb) => false
      KernelLam(bb) => false
      KernelApp(ff, aa) => false
      KernelLit(dds) => false
      KernelBool(vv) => false
    }
    KernelConst(n) => match u: Bool {
      KernelBVar(ii) => false
      KernelFVar(xx) => false
      KernelSortTerm(ss) => false
      KernelConst(nn) => n == nn
      KernelPi(aa, bb) => false
      KernelLam(bb) => false
      KernelApp(ff, aa) => false
      KernelLit(dds) => false
      KernelBool(vv) => false
    }
    KernelPi(a, b) => match u: Bool {
      KernelBVar(ii) => false
      KernelFVar(xx) => false
      KernelSortTerm(ss) => false
      KernelConst(nn) => false
      KernelPi(aa, bb) => kernel_term_eq(a, aa) && kernel_term_eq(b, bb)
      KernelLam(bb) => false
      KernelApp(ff, aa) => false
      KernelLit(dds) => false
      KernelBool(vv) => false
    }
    KernelLam(b) => match u: Bool {
      KernelBVar(ii) => false
      KernelFVar(xx) => false
      KernelSortTerm(ss) => false
      KernelConst(nn) => false
      KernelPi(aa, bb) => false
      KernelLam(bb) => kernel_term_eq(b, bb)
      KernelApp(ff, aa) => false
      KernelLit(dds) => false
      KernelBool(vv) => false
    }
    KernelApp(f, a) => match u: Bool {
      KernelBVar(ii) => false
      KernelFVar(xx) => false
      KernelSortTerm(ss) => false
      KernelConst(nn) => false
      KernelPi(aa, bb) => false
      KernelLam(bb) => false
      KernelApp(ff, aa) => kernel_term_eq(f, ff) && kernel_term_eq(a, aa)
      KernelLit(dds) => false
      KernelBool(vv) => false
    }
    KernelLit(ds) => match u: Bool {
      KernelBVar(ii) => false
      KernelFVar(xx) => false
      KernelSortTerm(ss) => false
      KernelConst(nn) => false
      KernelPi(aa, bb) => false
      KernelLam(bb) => false
      KernelApp(ff, aa) => false
      KernelLit(dds) => kernel_digits_eq(ds, dds)
      KernelBool(vv) => false
    }
    KernelBool(v) => match u: Bool {
      KernelBVar(ii) => false
      KernelFVar(xx) => false
      KernelSortTerm(ss) => false
      KernelConst(nn) => false
      KernelPi(aa, bb) => false
      KernelLam(bb) => false
      KernelApp(ff, aa) => false
      KernelLit(dds) => false
      KernelBool(vv) => Bool::eq(v, vv)
    }
  }
}

pub fn kernel_terms_eq(ts: List(KernelTerm), us: List(KernelTerm)): Bool {
  match ts: Bool {
    Nil => match us: Bool {
      Nil => true
      Cons(u, rest) => false }
    Cons(t, tail) => match us: Bool {
      Nil => false
      Cons(u, rest) => kernel_term_eq(t, u) && kernel_terms_eq(tail, rest) }
  }
}

pub fn kernel_apps(head: KernelTerm, args: List(KernelTerm)): KernelTerm {
  kernel_list_foldl_KernelTerm_KernelTerm(
    (f: KernelTerm, a: KernelTerm) => KernelApp(f, a),
    head,
    args
  )
}

pub fn kernel_spine_in(t: KernelTerm, args: List(KernelTerm)): Pair(KernelTerm, List(KernelTerm)) {
  match t: Pair(KernelTerm, List(KernelTerm)) {
    KernelBVar(i) => Pair { fst: t, snd: args }
    KernelFVar(x) => Pair { fst: t, snd: args }
    KernelSortTerm(s) => Pair { fst: t, snd: args }
    KernelConst(n) => Pair { fst: t, snd: args }
    KernelPi(a, b) => Pair { fst: t, snd: args }
    KernelLam(b) => Pair { fst: t, snd: args }
    KernelApp(f, a) => kernel_spine_in(f, Cons(a, args))
    KernelLit(ds) => Pair { fst: t, snd: args }
    KernelBool(v) => Pair { fst: t, snd: args }
  }
}

pub fn kernel_spine(t: KernelTerm): Pair(KernelTerm, List(KernelTerm)) {
  kernel_spine_in(t, Nil)
}

pub fn kernel_inst(body: KernelTerm, value: KernelTerm): KernelTerm {
  kernel_inst_at(body, 0, value)
}

pub fn kernel_pi_over(atom: Nat, domain: KernelTerm, body: KernelTerm): KernelTerm {
  KernelPi(domain, kernel_abstract_at(body, 0, atom))
}

pub fn kernel_lam_over(atom: Nat, body: KernelTerm): KernelTerm {
  KernelLam(kernel_abstract_at(body, 0, atom))
}

pub fn kernel_abstract_many_in(xs: List(Nat), t: KernelTerm, depth: Nat): KernelTerm {
  match xs: KernelTerm {
    Nil => t
    Cons(x, rest) => kernel_abstract_many_in(rest, kernel_abstract_at(t, depth, x), Succ(depth))
  }
}

pub fn kernel_abstract_many(t: KernelTerm, xs: List(Nat)): KernelTerm {
  kernel_abstract_many_in(List::reverse(xs), t, 0)
}

pub fn kernel_inst_many_in(values: List(KernelTerm), t: KernelTerm): KernelTerm {
  match values: KernelTerm {
    Nil => t
    Cons(v, rest) => kernel_inst_many_in(rest, kernel_inst_at(t, List::length(rest), v))
  }
}

pub fn kernel_term_at(ts: List(KernelTerm), i: Nat): Option(KernelTerm) {
  List::nth(ts, i)
}

pub fn kernel_inst_many(
  t: KernelTerm,
  values: List(KernelTerm)
): KernelTerm { kernel_inst_many_in(values, t) }
