// Each input file is a fresh kernel. Each line is one replay command.
import "data.taut"
import "kernel.taut"
import "wire.taut"
import "../../text/src/text.taut"
import std::Text
import std::Base
import std::prelude::Os
pub fn kernel_main_lines(&mut c: KernelCore, lines: List(Text)): Unit {
  match lines {
    Nil => #()
    Cons(line, rest) => {
      if std::prelude::Text::len(line) != 0 {
        var input: KernelInput := KernelInput { tokens: text_split(line, " "), valid: true }
        let command := kernel_read_command(2000, &mut input)
        if input.valid && List::length(input.tokens) == 0 {
          match kernel_execute(2000, &mut c, command) {
            KernelAccepted => print(Text::concat("accepted", text_newline()))
            KernelRejected => print(Text::concat("rejected", text_newline()))
            KernelExhausted => print(Text::concat("exhausted", text_newline()))
          }
        } else {
          print(Text::concat("malformed", text_newline()))
        }
      }
      kernel_main_lines(&mut c, rest)
    }
  }
}

pub fn kernel_main_files(paths: List(Text)): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      match read_file(path) {
        Err(e) => print(Text::concat("unreadable", text_newline()))
        Ok(source) => {
          var c: KernelCore := kernel_new()
          kernel_main_lines(&mut c, text_split(source, text_newline()))
        }
      }
      kernel_main_files(rest)
    }
  }
}

kernel_main_files(perform argv())
