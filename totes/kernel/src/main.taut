// Each input file is a fresh kernel. Each line is one replay command.
import "data.taut"
import "kernel.taut"
import "wire.taut"
import "../../text/src/text.taut"
import std::Text
import std::Base
import std::prelude::Os
// The parts of `t` between the bytes `sep`, scanned from the end so the
// list comes out in order without a reverse. `i` counts down to the start,
// and `end` is where the part being scanned stops.
pub fn kernel_cut(t: Text, sep: Nat, i: Nat, end: Nat, done: List(Text)): List(Text) {
  ⊢ List(Text) from match i {
    Zero => Cons(Text::slice_or_empty(t, 0, end), done)
    Succ(j) => ⊢ List(Text) from match Nat::eq(Text::byte_value(t, j), sep) {
      true => kernel_cut(t, sep, j, j, Cons(Text::slice_or_empty(t, Nat::add(j, 1), end), done))
      false => kernel_cut(t, sep, j, end, done)
    }
  }
}

pub fn kernel_split(t: Text, sep: Nat): List(Text) {
  kernel_cut(t, sep, Text::len(t), Text::len(t), Nil)
}

pub fn kernel_main_lines(&mut c: KernelCore, lines: List(Text)): Unit {
  match lines {
    Nil => #()
    Cons(line, rest) => {
      if std::prelude::Text::len(line) != 0 {
        var input: KernelInput := KernelInput { tokens: kernel_split(line, 32), valid: true }
        let command := kernel_read_command(1048576, &mut input)
        if input.valid && List::length(input.tokens) == 0 {
          match kernel_execute(1073741824, &mut c, command) {
            KernelAccepted => print(Text::concat("accepted", text_newline()))
            KernelRejected => print(Text::concat("rejected", text_newline()))
            KernelExhausted => print(Text::concat("exhausted", text_newline()))
          }
        } else {
          print(Text::concat("malformed", text_newline()))
        }
      }
      kernel_main_lines(&mut c, rest)
    }
  }
}

pub fn kernel_main_files(paths: List(Text)): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      match read_file(path) {
        Err(e) => print(Text::concat("unreadable", text_newline()))
        Ok(source) => {
          var c: KernelCore := kernel_new()
          kernel_main_lines(&mut c, kernel_split(source, 10))
        }
      }
      kernel_main_files(rest)
    }
  }
}

kernel_main_files(perform argv())
