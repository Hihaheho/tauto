// What Totebag reads and writes: source trees and their IDs,
// Tauto.lock, the cache, Git and the distributed index. It asks
// totes/totebag what it takes; crates/totebag/src/core.rs stays that
// tote's checks alone.
package {
  name = "totebag-io"
  version = "0.1.0"
}

dependencies {
  index { path = "../index" }
  eure { path = "../eure" }
  sha256 { path = "../sha256" }
  totebag { path = "../totebag" }
  unicode { path = "../unicode" }
}
