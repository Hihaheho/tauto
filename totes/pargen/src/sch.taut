// Derives syntax types from the written grammar: a struct, enum or token for
// each non-terminal, and a result type and constructor for each production.
import std::Text

pub(open) enum FTy {
  FTok
  // A tauto expression written in the text.
  FExpr
  FNamed(Text)
  FList(FTy)
  FOpt(FTy)
}

pub(open) struct SField { name: Text, ty: FTy }

pub(open) enum SPay {
  PayRecord(List(SField))
  PaySingle(FTy)
}

pub(open) struct SCtor { name: Text, prod: u64, pay: SPay }

pub(open) enum STy {
  TyStruct(Text, u64, List(SField))
  TyEnum(Text, List(SCtor))
}

// The type a production builds (-1 for none) and its constructor in it.
pub(open) struct SPt { ty: i64, ctor: u64 }

// A generated non-terminal's type, once made.
pub(open) struct SMade { nt: u64, ty: FTy }

// The numbers handed out for an owner and a kind.
pub(open) struct SCnt { owner: u64, kind: Text, n: u64 }

pub(open) struct SGr {
  prods: Array(MProd)
  nts: Array(Text)
  kinds: Array(u64)
  terms: Array(Text)
  start: u64
  // An LALR(1) grammar: a repetition's list comes first in its production.
  lalr: Bool
}

pub(open) struct SCx {
  types: Vec(STy)
  ptype: Vec(SPt)
  made: Vec(SMade)
  counters: Vec(SCnt)
}

pub fn sg_prod(g: SGr, p: u64): MProd {
  match Array::get(g.prods, p) {
    Some(x) => x
    None => par_die("a production is lost")
  }
}

pub fn sg_nt(g: SGr, n: u64): Text {
  match Array::get(g.nts, n) {
    Some(x) => x
    None => par_die("a non-terminal is lost")
  }
}

pub fn sg_kind(g: SGr, n: u64): u64 {
  match Array::get(g.kinds, n) {
    Some(x) => x
    None => par_die("a non-terminal is lost")
  }
}

pub fn sg_term(g: SGr, t: u64): Text {
  match Array::get(g.terms, t) {
    Some(x) => x
    None => par_die("a terminal is lost")
  }
}

pub fn sg_prods_of(g: SGr, n: u64): List(u64) {
  var out: List(u64) := Nil
  var p := Array::len(g.prods)
  while p > 0 {
    p := p - 1
    if sg_prod(g, p).lhs == n {
      out := Cons(p, out)
    }
  }
  out
}

pub fn sg_snake(name: Text): Text {
  var b := Buf::new()
  var at: u64 := 0
  var i: u64 := 0
  var last_underscore := false
  while at < std::prelude::Text::len(name) {
    let c := lk_byte(name, at)
    if c >= 65 && c <= 90 {
      if i > 0 && not(last_underscore) {
        Buf::push(&mut b, &"_")
      }
      Buf::push(&mut b, &lk_slice(name, at, at + 1))
      last_underscore := false
    } else {
      Buf::push(&mut b, &lk_slice(name, at, at + 1))
      last_underscore := c == 95
    }
    at := at + 1
    i := i + 1
  }
  text_lower_ascii(Text::of(b))
}

// The upper-case letters of `name` made lower case.
pub fn text_lower_ascii(t: Text): Text {
  var b := Buf::new()
  var at: u64 := 0
  while at < std::prelude::Text::len(t) {
    let c := lk_byte(t, at)
    if c >= 65 && c <= 90 {
      match std::prelude::Text::of_code_point(U32::of_u64(c + 32)) {
        Some(x) => {
          Buf::push(&mut b, &x)
        }
        None => #()
      }
    } else {
      Buf::push(&mut b, &lk_slice(t, at, at + 1))
    }
    at := at + 1
  }
  Text::of(b)
}

pub fn sg_types_get(&v: Vec(STy), i: u64): STy {
  let &x := Vec::index(&v, i)
  x
}

pub fn sg_set_type(&mut v: Vec(STy), i: u64, x: STy): Unit {
  match Vec::get_mut(&mut v, i) {
    Some(slot) => {
      slot := x
    }
    None => #()
  }
}

pub fn sg_set_pt(&mut v: Vec(SPt), p: u64, ty: i64, ctor: u64): Unit {
  match Vec::get_mut(&mut v, p) {
    Some(slot) => {
      slot := SPt { ty: ty, ctor: ctor }
    }
    None => #()
  }
}

pub fn sg_made_find(&v: Vec(SMade), nt: u64): Option(FTy) {
  var i: u64 := 0
  var found: Option(FTy) := None
  while i < Vec::len(&v) {
    let &e := Vec::index(&v, i)
    if e.nt == nt {
      found := Some(e.ty)
    }
    i := i + 1
  }
  found
}

// A fresh name for a type made inside `owner`: the owner's name, `_`, `kind`
// and the next number for that owner and kind.
pub fn sg_numbered(g: SGr, &mut cx: SCx, owner: u64, kind: Text): Text {
  var n: u64 := 1
  var i: u64 := 0
  var seen := false
  while i < Vec::len(&cx.counters) {
    let &e := Vec::index(&cx.counters, i)
    if e.owner == owner && e.kind == kind {
      n := e.n + 1
      seen := true
      match Vec::get_mut(&mut cx.counters, i) {
        Some(slot) => {
          slot := SCnt { owner: owner, kind: kind, n: n }
        }
        None => #()
      }
    }
    i := i + 1
  }
  if not(seen) {
    Vec::push(&mut cx.counters, SCnt { owner: owner, kind: kind, n: 1 })
  }
  Text::concat_all(Cons(sg_nt(g, owner), Cons("_", Cons(kind, Cons(Text::of_u64(n), Nil)))))
}

pub fn sg_is_expr(g: SGr, m: u64): Bool {
  sg_nt(g, m) == "TautoExpr"
}

// The type of a token non-terminal is an expression for `TautoExpr` itself or
// a direct alias whose first production contains only `TautoExpr`; otherwise a token.
pub fn sg_token_ty(g: SGr, n: u64): FTy {
  var alias := false
  match sg_prods_of(g, n) {
    Cons(p, rest) => match sg_prod(g, p).rhs {
      Cons(s, Nil) => match s {
        MN(k) => {
          alias := sg_is_expr(g, k)
        }
        MT(t, c) => #()
      }
      other => #()
    }
    Nil => #()
  }
  if sg_is_expr(g, n) || alias { FExpr } else { FTok }
}

pub fn sg_sym_name(g: SGr, s: MSym): Text {
  match s {
    MT(t, clipped) => sg_term(g, t)
    MN(m) => {
      let k := sg_kind(g, m)
      if k == 2 {
        "Rep"
      } else if k == 3 {
        "Opt"
      } else if k == 4 {
        "Group"
      } else {
        sg_nt(g, m)
      }
    }
  }
}

pub fn sg_snoc_field(xs: List(SField), x: SField): List(SField) {
  match xs {
    Nil => Cons(x, Nil)
    Cons(y, rest) => Cons(y, sg_snoc_field(rest, x))
  }
}

// A field must be usable in declarations, projections and record patterns.
// Contextual keywords are reserved too, so surrounding syntax cannot change it.
pub fn sg_field_base(base: Text): Text {
  if base == "" || base == "_" {
    "field"
  } else if base == "span" || base == "theorem" || base == "def" || base == "import" || base == "mutual" || base == "axiom" || base == "inductive" || base == "forall" || base == "exists" || base == "decreasing_by" || base == "as" || base == "by" || base == "let" || base == "var" || base == "fn" || base == "return" || base == "while" || base == "loop" || base == "break" || base == "continue" || base == "if" || base == "else" || base == "match" || base == "struct" || base == "enum" || base == "effect" || base == "handle" || base == "with" || base == "perform" || base == "budget" || base == "copy" || base == "shared" || base == "affine" || base == "linear" || base == "view" || base == "resume" || base == "direct" || base == "mut" || base == "module" || base == "where" || base == "class" || base == "instance" || base == "law" || base == "extern" || base == "true" || base == "false" || base == "syntax" || base == "macro" || base == "quote" {
    Text::concat_all(Cons(base, Cons("_field", Nil)))
  } else {
    base
  }
}

pub fn sg_field_used(xs: List(SField), name: Text): Bool {
  match xs {
    Nil => false
    Cons(x, rest) => x.name == name || sg_field_used(rest, name)
  }
}

// Choose the first unused spelling, not the count of matching prefixes:
// grammar symbols can themselves end in numeric suffixes.
pub fn sg_fresh_field(xs: List(SField), base: Text): Text {
  var name := base
  var n: u64 := 2
  while sg_field_used(xs, name) {
    name := Text::concat_all(Cons(base, Cons("_", Cons(Text::of_u64(n), Nil))))
    n := n + 1
  }
  name
}

// The production of a repetition or option that has the items, and its right side without the repetition's own tail.
pub(open) struct SItems { prod: u64, rhs: List(MSym) }

pub fn sg_drop_last(xs: List(MSym)): List(MSym) {
  match xs {
    Nil => Nil
    Cons(x, rest) => match rest {
      Nil => Nil
      more => Cons(x, sg_drop_last(rest))
    }
  }
}

pub fn sg_drop_first(xs: List(MSym)): List(MSym) {
  match xs {
    Nil => Nil
    Cons(x, rest) => rest
  }
}

pub fn sg_items(g: SGr, m: u64): SItems {
  var found: Option(u64) := None
  var ps := sg_prods_of(g, m)
  var running := true
  while running {
    match ps {
      Nil => {
        running := false
      }
      Cons(p, rest) => {
        let a := sg_prod(g, p).attr
        if a == 2 || a == 3 {
          found := Some(p)
          running := false
        }
        ps := rest
      }
    }
  }
  match found {
    Some(p) => {
      let prod := sg_prod(g, p)
      SItems { prod: p, rhs: if prod.attr != 2 {
          prod.rhs
        } else if g.lalr {
          sg_drop_first(prod.rhs)
        } else {
          sg_drop_last(prod.rhs)
        } }
    }
    None => par_die("a repetition or option has no production with items")
  }
}

// The name of a field of a repetition or option: the snake-case name of the
// one terminal or struct or token non-terminal it holds, else `fallback`.
pub fn sg_inner_name(g: SGr, m: u64, fallback: Text): Text {
  let items := sg_items(g, m)
  match items.rhs {
    Cons(s, Nil) => match s {
      MT(t, c) => sg_snake(sg_term(g, t))
      MN(k) => if sg_kind(g, k) == 0 || sg_kind(g, k) == 1 {
        sg_snake(sg_nt(g, k))
      } else {
        fallback
      }
    }
    other => fallback
  }
}

pub fn sg_ctor_named(xs: List(SCtor), name: Text): Bool {
  match xs {
    Nil => false
    Cons(c, rest) => c.name == name || sg_ctor_named(rest, name)
  }
}

pub fn sg_snoc_ctor(xs: List(SCtor), x: SCtor): List(SCtor) {
  match xs {
    Nil => Cons(x, Nil)
    Cons(y, rest) => Cons(y, sg_snoc_ctor(rest, x))
  }
}

// The fields of a right side: a clipped terminal has none; a name used twice
// gets `_2`, `_3`, ….
pub fn sg_fields(g: SGr, &mut cx: SCx, owner: u64, rhs: List(MSym)): List(SField) {
  var out: List(SField) := Nil
  var rest := rhs
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(s, more) => {
        var skip := false
        var base := ""
        var ty := FTok
        match s {
          MT(t, clipped) => if clipped {
            skip := true
          } else {
            base := sg_snake(sg_term(g, t))
          }
          MN(m) => {
            let k := sg_kind(g, m)
            if k == 1 {
              base := sg_snake(sg_nt(g, m))
              ty := sg_token_ty(g, m)
            } else if k == 0 {
              base := sg_snake(sg_nt(g, m))
              ty := FNamed(sg_nt(g, m))
            } else if k == 4 {
              base := "group"
              ty := sg_generated(g, &mut cx, owner, m)
            } else if k == 2 {
              base := sg_inner_name(g, m, "rep")
              ty := FList(sg_generated(g, &mut cx, owner, m))
            } else {
              base := sg_inner_name(g, m, "opt")
              ty := FOpt(sg_generated(g, &mut cx, owner, m))
            }
          }
        }
        if not(skip) {
          let name := sg_fresh_field(out, sg_field_base(base))
          out := sg_snoc_field(out, SField { name: name, ty: ty })
        }
        rest := more
      }
    }
  }
  out
}

// The type of the element of a repetition or option, or of a group.
pub fn sg_generated(g: SGr, &mut cx: SCx, owner: u64, m: u64): FTy {
  match sg_made_find(&cx.made, m) {
    Some(t) => t
    None => {
      let t := if sg_kind(g, m) == 4 {
        let name := sg_numbered(g, &mut cx, owner, "Group")
        let idx := sg_alternatives(g, &mut cx, owner, name, sg_prods_of(g, m))
        FNamed(name)
      } else {
        let items := sg_items(g, m)
        match items.rhs {
          Cons(s, Nil) => match s {
            MT(t, clipped) => if clipped {
              sg_generated_struct(g, &mut cx, owner, m, items)
            } else {
              FTok
            }
            MN(k) => {
              let kk := sg_kind(g, k)
              if kk == 1 {
                sg_token_ty(g, k)
              } else if kk == 0 {
                FNamed(sg_nt(g, k))
              } else if kk == 2 {
                FList(sg_generated(g, &mut cx, owner, k))
              } else if kk == 3 {
                FOpt(sg_generated(g, &mut cx, owner, k))
              } else {
                sg_generated(g, &mut cx, owner, k)
              }
            }
          }
          other => sg_generated_struct(g, &mut cx, owner, m, items)
        }
      }
      Vec::push(&mut cx.made, SMade { nt: m, ty: t })
      t
    }
  }
}

pub fn sg_generated_struct(g: SGr, &mut cx: SCx, owner: u64, m: u64, items: SItems): FTy {
  let name := sg_numbered(g, &mut cx, owner, if sg_kind(g, m) == 2 { "Rep" } else { "Opt" })
  let idx := Vec::len(&cx.types)
  Vec::push(&mut cx.types, TyStruct(name, items.prod, Nil))
  let fields := sg_fields(g, &mut cx, owner, items.rhs)
  sg_set_type(&mut cx.types, idx, TyStruct(name, items.prod, fields))
  sg_set_pt(&mut cx.ptype, items.prod, I64::of_u64(idx), 0)
  FNamed(name)
}

// The type of a non-terminal: a struct for one production, an enum for several.
pub fn sg_alternatives(g: SGr, &mut cx: SCx, owner: u64, name: Text, prods: List(u64)): u64 {
  let idx := Vec::len(&cx.types)
  match prods {
    Cons(p0, Nil) => {
      Vec::push(&mut cx.types, TyStruct(name, p0, Nil))
      let fields := sg_fields(g, &mut cx, owner, sg_prod(g, p0).rhs)
      sg_set_type(&mut cx.types, idx, TyStruct(name, p0, fields))
      sg_set_pt(&mut cx.ptype, p0, I64::of_u64(idx), 0)
    }
    other => {
      Vec::push(&mut cx.types, TyEnum(name, Nil))
      var ctors: List(SCtor) := Nil
      var i: u64 := 0
      var rest := prods
      var running := true
      while running {
        match rest {
          Nil => {
            running := false
          }
          Cons(p, more) => {
            let rhs := sg_prod(g, p).rhs
            var cname := ""
            var pay := PaySingle(FTok)
            var single := false
            match rhs {
              Cons(s, Nil) => match s {
                MN(m) => if sg_kind(g, m) == 0 || sg_kind(g, m) == 1 {
                  single := true
                  cname := sg_nt(g, m)
                  pay := PaySingle(
                    if sg_kind(g, m) == 1 { sg_token_ty(g, m) } else { FNamed(sg_nt(g, m)) }
                  )
                }
                MT(t, c) => #()
              }
              others => #()
            }
            if not(single) {
              var joined := ""
              var syms := rhs
              var walking := true
              while walking {
                match syms {
                  Nil => {
                    walking := false
                  }
                  Cons(s, tail) => {
                    joined := Text::concat_all(Cons(joined, Cons(sg_sym_name(g, s), Nil)))
                    syms := tail
                  }
                }
              }
              cname := if std::prelude::Text::len(joined) == 0 { "Empty" } else { joined }
              pay := PayRecord(sg_fields(g, &mut cx, owner, rhs))
            }
            let base := cname
            var suffix := i + 1
            while sg_ctor_named(ctors, cname) {
              cname := Text::concat_all(Cons(base, Cons(Text::of_u64(suffix), Nil)))
              suffix := suffix + 1
            }
            ctors := sg_snoc_ctor(ctors, SCtor { name: cname, prod: p, pay: pay })
            sg_set_pt(&mut cx.ptype, p, I64::of_u64(idx), i)
            i := i + 1
            rest := more
          }
        }
      }
      sg_set_type(&mut cx.types, idx, TyEnum(name, ctors))
    }
  }
  idx
}

// The type of a non-terminal that has one of its own (a struct non-terminal,
// or a start symbol that is a token).
pub fn sg_declared(g: SGr, &mut cx: SCx, n: u64): Unit {
  let name := sg_nt(g, n)
  let prods := sg_prods_of(g, n)
  if sg_kind(g, n) == 1 {
    // The start symbol is a token: the input type needs a struct (token).
    match prods {
      Cons(p0, rest) => {
        let idx := Vec::len(&cx.types)
        Vec::push(&mut cx.types, TyStruct(name, p0, Cons(SField { name: "token", ty: FTok }, Nil)))
        sg_set_pt(&mut cx.ptype, p0, I64::of_u64(idx), 0)
      }
      Nil => par_die("a token has no production")
    }
  } else {
    let idx := sg_alternatives(g, &mut cx, n, name, prods)
    #()
  }
}

// What `sg_build` makes: the types and, for each production, its type
// and constructor.
pub(open) struct SSchema { types: Vec(STy), ptype: Vec(SPt) }

pub fn sg_build(m: MModel): SSchema {
  let g := SGr {
    prods: Array::of_list(m.prods)
    nts: Array::of_list(m.nts)
    kinds: Array::of_list(m.nt_kinds)
    terms: Array::of_list(m.terminal_names)
    start: m.start
    lalr: m.lalr
  }
  var cx := SCx { types: Vec::new(), ptype: Vec::new(), made: Vec::new(), counters: Vec::new() }
  var p: u64 := 0
  while p < Array::len(g.prods) {
    Vec::push(&mut cx.ptype, SPt { ty: -1, ctor: 0 })
    p := p + 1
  }
  var n: u64 := 0
  while n < Array::len(g.nts) {
    let k := sg_kind(g, n)
    if k == 0 || (k == 1 && n == g.start) {
      sg_declared(g, &mut cx, n)
    }
    n := n + 1
  }
  match cx {
    SCx { types: ts, ptype: pt, made: md, counters: cn } => SSchema { types: ts, ptype: pt }
  }
}

// ---------------------------------------------------------------- the lines

pub fn sg_pt_get(&v: Vec(SPt), i: u64): SPt {
  let &x := Vec::index(&v, i)
  x
}

pub fn sg_prod_types_line(&s: SSchema): Text {
  var words: List(Text) := Nil
  var i := Vec::len(&s.ptype)
  while i > 0 {
    i := i - 1
    let e := sg_pt_get(&s.ptype, i)
    words := Cons(Text::of_i64(e.ty), Cons(Text::of_u64(e.ctor), words))
  }
  em_line("prod_types", Vec::len(&s.ptype), words)
}

pub fn sg_push_fty(&mut b: Buf, t: FTy): Unit {
  match t {
    FTok => Buf::push(&mut b, &" K")
    FExpr => Buf::push(&mut b, &" E")
    FNamed(n) => {
      Buf::push(&mut b, &" N ")
      Buf::push(&mut b, &n)
    }
    FList(x) => {
      Buf::push(&mut b, &" L")
      sg_push_fty(&mut b, x)
    }
    FOpt(x) => {
      Buf::push(&mut b, &" O")
      sg_push_fty(&mut b, x)
    }
  }
}

pub fn sg_len_fields(xs: List(SField)): u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + sg_len_fields(rest)
  }
}

pub fn sg_len_ctors(xs: List(SCtor)): u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + sg_len_ctors(rest)
  }
}

pub fn sg_push_record(&mut b: Buf, fields: List(SField)): Unit {
  Buf::push(&mut b, &" ")
  Buf::push(&mut b, &Text::of_u64(sg_len_fields(fields)))
  var rest := fields
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(f, more) => {
        Buf::push(&mut b, &" ")
        Buf::push(&mut b, &f.name)
        sg_push_fty(&mut b, f.ty)
        rest := more
      }
    }
  }
}

pub fn sg_schema_line(&s: SSchema): Text {
  var b := Buf::new()
  var i: u64 := 0
  while i < Vec::len(&s.types) {
    match sg_types_get(&s.types, i) {
      TyStruct(name, prod, fields) => {
        Buf::push(&mut b, &" S ")
        Buf::push(&mut b, &name)
        Buf::push(&mut b, &" ")
        Buf::push(&mut b, &Text::of_u64(prod))
        sg_push_record(&mut b, fields)
      }
      TyEnum(name, ctors) => {
        Buf::push(&mut b, &" E ")
        Buf::push(&mut b, &name)
        Buf::push(&mut b, &" ")
        Buf::push(&mut b, &Text::of_u64(sg_len_ctors(ctors)))
        var rest := ctors
        var running := true
        while running {
          match rest {
            Nil => {
              running := false
            }
            Cons(c, more) => {
              Buf::push(&mut b, &" ")
              Buf::push(&mut b, &c.name)
              Buf::push(&mut b, &" ")
              Buf::push(&mut b, &Text::of_u64(c.prod))
              match c.pay {
                PayRecord(fields) => {
                  Buf::push(&mut b, &" R")
                  sg_push_record(&mut b, fields)
                }
                PaySingle(t) => {
                  Buf::push(&mut b, &" P")
                  sg_push_fty(&mut b, t)
                }
              }
              rest := more
            }
          }
        }
      }
    }
    i := i + 1
  }
  Text::concat_all(Cons("schema ", Cons(Text::of_u64(Vec::len(&s.types)), Cons(text_of_buf(b), Nil))))
}
