// The lines of a table file that the model of a grammar decides, in the
// format `crates/tauto-syntax/src/tables.rs` reads.
import "model.taut"
import std::Text
import std::TextOps

pub fn em_words(xs: List(Text)): Text {
  Text::join(" ", xs)
}

pub fn em_nums(xs: List(u64)): List(Text) {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(Text::of_u64(x), em_nums(rest))
  }
}

// `name count words…`.
pub fn em_line(name: Text, count: u64, words: List(Text)): Text {
  match words {
    Nil => Text::concat_all(Cons(name, Cons(" ", Cons(Text::of_u64(count), Nil))))
    Cons(w, rest) => Text::concat_all(
      Cons(name, Cons(" ", Cons(Text::of_u64(count), Cons(" ", Cons(em_words(words), Nil)))))
    )
  }
}

pub fn em_sym_word(s: MSym): Text {
  match s {
    MN(n) => Text::of_u64(n)
    MT(t, clipped) => Text::concat_all(Cons("-", Cons(Text::of_u64(t + 1), Nil)))
  }
}

pub fn em_syms(xs: List(MSym)): List(Text) {
  match xs {
    Nil => Nil
    Cons(s, rest) => Cons(em_sym_word(s), em_syms(rest))
  }
}

pub fn em_prod_words(ps: List(MProd)): List(Text) {
  match ps {
    Nil => Nil
    Cons(p, rest) => Cons(
      Text::of_u64(p.lhs),
      Cons(
        Text::of_u64(p.attr),
        Cons(Text::of_u64(md_len_syms(p.rhs)), em_cat(em_syms(p.rhs), em_prod_words(rest)))
      )
    )
  }
}

pub fn md_len_syms(xs: List(MSym)): u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + md_len_syms(rest)
  }
}

pub fn em_len_prods(xs: List(MProd)): u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + em_len_prods(rest)
  }
}

pub fn em_cat(a: List(Text), b: List(Text)): List(Text) {
  match a {
    Nil => b
    Cons(x, rest) => Cons(x, em_cat(rest, b))
  }
}

// Production, position and `1` of each terminal that is clipped.
pub fn em_clipped(ps: List(MProd), pi: u64): List(Text) {
  match ps {
    Nil => Nil
    Cons(p, rest) => em_cat(em_clipped_syms(p.rhs, pi, 0), em_clipped(rest, pi + 1))
  }
}

pub fn em_clipped_syms(xs: List(MSym), pi: u64, pos: u64): List(Text) {
  match xs {
    Nil => Nil
    Cons(s, rest) => match s {
      MT(t, clipped) => if clipped {
        Cons(
          Text::of_u64(pi),
          Cons(Text::of_u64(pos), Cons("1", em_clipped_syms(rest, pi, pos + 1)))
        )
      } else {
        em_clipped_syms(rest, pi, pos + 1)
      }
      MN(n) => em_clipped_syms(rest, pi, pos + 1)
    }
  }
}

pub fn em_skip_words(xs: List(List(u64))): List(Text) {
  match xs {
    Nil => Nil
    Cons(s, rest) => Cons(Text::of_u64(md_len_u64(s)), em_cat(em_nums(s), em_skip_words(rest)))
  }
}

pub fn md_len_u64(xs: List(u64)): u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + md_len_u64(rest)
  }
}

pub fn em_title(m: MModel): Text {
  match m.title {
    Some(t) => Text::concat_all(Cons("title ", Cons(t, Nil)))
    None => "title -"
  }
}

// One line per `%describe`: `describe <terminal> <what it means, to the end of the line>`.
pub fn em_describes(m: MModel): List(Text) {
  em_describe_lines(m.describes)
}

pub fn em_describe_lines(xs: List(Pair(Text, Text))): List(Text) {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(
      Text::concat_all(Cons("describe ", Cons(x.fst, Cons(" ", Cons(x.snd, Nil))))),
      em_describe_lines(rest)
    )
  }
}

pub fn u64_div3(n: u64): u64 {
  div(n, 3)
}

pub fn md_len_scanners(xs: List(List(u64))): u64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + md_len_scanners(rest)
  }
}

pub fn production_words_with_count(n: u64, words: List(Text)): List(Text) {
  Cons(Text::of_u64(n), words)
}
