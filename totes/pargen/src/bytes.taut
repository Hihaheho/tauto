// The text tote's byte and slice at the positions this tote counts in: a
// position is a `u64`, as `Text::len` gives it, and a byte too.
import std::Text

pub fn lk_byte(t: Text, i: u64): u64 {
  U64::of_nat(Text::byte_value(t, Nat::of_u64(i)))
}

pub fn lk_slice(t: Text, start: u64, end: u64): Text {
  Text::slice_or_empty(t, Nat::of_u64(start), Nat::of_u64(end))
}

// The character at `i` and its length in bytes.
pub fn lk_decode(t: Text, i: u64): Option(@code u64 × @len u64) {
  match text_decode(t, Nat::of_u64(i)) {
    None => None
    Some(#(@code code, @len len)) => Some(#(@code U64::of_nat(code), @len U64::of_nat(len)))
  }
}
