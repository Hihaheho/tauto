// The disjoint character classes of a scanner: the leaves of all the
// expressions (a character or a class) cut the code points into elementary
// intervals, and the intervals that the same leaves hold are one class. The
// cuts use exclusive integer bounds, including 1114112 after the greatest
// Unicode scalar. Surrogates are left out of the resulting intervals.
//
// Derived from parol and scnr2 by Jörg Singer (MIT OR Apache-2.0); see NOTICE.

// The ranges that a leaf holds.
pub fn cc_ranges(h: RHir): List(RRange) {
  match h {
    RhLit(cs) => match cs {
      Cons(c, rest) => Cons(RRange { lo: c, hi: c }, Nil)
      Nil => Nil
    }
    RhClass(rs) => rs
    other => Nil
  }
}

// The exclusive integer bound after a range's last code point.
pub fn cc_next(c: u64): u64 {
  c + 1
}

pub fn cc_boundaries_of(leaves: List(RHir)): List(u64) {
  var out: List(u64) := Nil
  var rest := leaves
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(h, more) => {
        var rs := cc_ranges(h)
        var walking := true
        while walking {
          match rs {
            Nil => {
              walking := false
            }
            Cons(r, others) => {
              out := Cons(cc_next(r.hi), Cons(r.lo, out))
              rs := others
            }
          }
        }
        rest := more
      }
    }
  }
  out
}

// Sorted, once each.
pub fn cc_unique(xs: List(u64)): List(u64) {
  var out: List(u64) := Nil
  var rest := lg_sort_keep(xs)
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        match out {
          Cons(y, Before) => if y != x {
            out := Cons(x, out)
          }
          Nil => {
            out := Cons(x, Nil)
          }
        }
        rest := more
      }
    }
  }
  text_u64_reverse(out)
}

// The elementary intervals between the boundaries that some leaf holds, before
// the ones that no leaf holds are dropped.
pub fn cc_cut(bs: List(u64)): List(RRange) {
  var out: List(RRange) := Nil
  var rest := bs
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(start, more) => match more {
        Nil => {
          running := false
        }
        Cons(next, others) => {
          let e := next - 1
          if start <= e {
            if start <= 55295 {
              out := Cons(RRange { lo: start, hi: if e < 55295 { e } else { 55295 } }, out)
            }
            if e >= 57344 {
              out := Cons(RRange { lo: if start > 57344 { start } else { 57344 }, hi: e }, out)
            }
          }
          rest := more
        }
      }
    }
  }
  rx_rev_ranges(out)
}

pub fn cc_members_get(&v: Vec(List(u64)), i: u64): List(u64) {
  let &x := Vec::index(&v, i)
  x
}

pub fn cc_members_add(&mut v: Vec(List(u64)), i: u64, c: u64): Unit {
  let cur := cc_members_get(&v, i)
  match Vec::get_mut(&mut v, i) {
    Some(slot) => {
      slot := Cons(c, cur)
    }
    None => #()
  }
}

pub fn cc_range_get(&v: Vec(RRange), i: u64): RRange {
  let &x := Vec::index(&v, i)
  x
}

pub fn cc_groups_get(&v: Vec(List(RRange)), i: u64): List(RRange) {
  let &x := Vec::index(&v, i)
  x
}

// What the classes come to: the leaves in the order given, for each the
// disjoint classes it is made of, and for each class its intervals.
pub(open) struct CcOut { leaves: List(RHir), ids: List(List(u64)), groups: List(List(RRange)) }

pub fn cc_key(ms: List(u64)): Text {
  var b := Buf::new()
  var rest := ms
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(m, more) => {
        Buf::push(&mut b, &Text::of_u64(m))
        Buf::push(&mut b, &",")
        rest := more
      }
    }
  }
  Text::of(b)
}

// The disjoint classes of the leaves.
pub fn cc_make(leaves: List(RHir)): CcOut {
  let cuts := cc_cut(cc_unique(cc_boundaries_of(leaves)))
  var intervals: Vec(RRange) := Vec::new()
  var members: Vec(List(u64)) := Vec::new()
  var walk := cuts
  var going := true
  while going {
    match walk {
      Nil => {
        going := false
      }
      Cons(r, more) => {
        Vec::push(&mut intervals, r)
        Vec::push(&mut members, Nil)
        walk := more
      }
    }
  }
  let m := Vec::len(&intervals)
  var c: u64 := 0
  var ls := leaves
  var running := true
  while running {
    match ls {
      Nil => {
        running := false
      }
      Cons(leaf, more) => {
        var rs := cc_ranges(leaf)
        var i: u64 := 0
        while i < m {
          let iv := cc_range_get(&intervals, i)
          var skipping := true
          while skipping {
            match rs {
              Cons(r, others) => if r.hi < iv.lo {
                rs := others
              } else {
                skipping := false
              }
              Nil => {
                skipping := false
              }
            }
          }
          match rs {
            Cons(r, others) => if r.lo <= iv.lo && iv.hi <= r.hi {
              cc_members_add(&mut members, i, c)
            }
            Nil => #()
          }
          i := i + 1
        }
        c := c + 1
        ls := more
      }
    }
  }
  // The groups, in the order their first interval comes.
  var group_of := HashMap::new()
  var groups: Vec(List(RRange)) := Vec::new()
  var group_members: Vec(List(u64)) := Vec::new()
  var i: u64 := 0
  while i < m {
    let ms := text_u64_reverse(cc_members_get(&members, i))
    match ms {
      Nil => #()
      Cons(first, rest) => {
        let key := cc_key(ms)
        let iv := cc_range_get(&intervals, i)
        var found: Option(u64) := None
        match HashMap::get(&group_of, key) {
          Some(g) => {
            found := Some(g + 0)
          }
          None => #()
        }
        match found {
          Some(g) => {
            let old := cc_groups_get(&groups, g)
            match Vec::get_mut(&mut groups, g) {
              Some(slot) => {
                slot := Cons(iv, old)
              }
              None => #()
            }
          }
          None => {
            let g := Vec::len(&groups)
            HashMap::insert(&mut group_of, key, g)
            Vec::push(&mut groups, Cons(iv, Nil))
            Vec::push(&mut group_members, ms)
          }
        }
      }
    }
    i := i + 1
  }
  // For each leaf, the groups it is in.
  let ng := Vec::len(&groups)
  var ids_rev: List(List(u64)) := Nil
  var c2: u64 := 0
  var ls2 := leaves
  var running2 := true
  while running2 {
    match ls2 {
      Nil => {
        running2 := false
      }
      Cons(leaf, more) => {
        var mine: List(u64) := Nil
        var g: u64 := 0
        while g < ng {
          if cc_has(cc_members_get(&group_members, g), c2) {
            mine := Cons(g, mine)
          }
          g := g + 1
        }
        ids_rev := Cons(text_u64_reverse(mine), ids_rev)
        c2 := c2 + 1
        ls2 := more
      }
    }
  }
  var out_groups: List(List(RRange)) := Nil
  var g2: u64 := ng
  while g2 > 0 {
    g2 := g2 - 1
    out_groups := Cons(rx_rev_ranges(cc_groups_get(&groups, g2)), out_groups)
  }
  CcOut { leaves: leaves, ids: cc_rev_lists(ids_rev), groups: out_groups }
}

pub fn cc_has(xs: List(u64), x: u64): Bool {
  match xs {
    Nil => false
    Cons(y, rest) => y == x || cc_has(rest, x)
  }
}

pub fn cc_rev_lists(xs: List(List(u64))): List(List(u64)) {
  var out: List(List(u64)) := Nil
  var rest := xs
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        out := Cons(x, out)
        rest := more
      }
    }
  }
  out
}
