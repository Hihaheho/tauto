import "percent.taut"
import "bytes.taut"
import std::Text
import std::Base

pub(open) inductive Authority: Type {
  // `user:pass@host:port`; the empty user and password are left out, and so is
  // a port that is the scheme's default.
  Auth(user: List(Nat), pass: List(Nat), host: List(Nat), port: Option(Nat)): Authority
}

pub(open) inductive UrlPath: Type {
  // `mailto:a@b`: the path of a URL without authority that does not start
  // with `/`.
  Opaque(p: List(Nat)): UrlPath
  // `/a/b/` is `["a", "b", ""]`.
  Segments(ss: List(List(Nat))): UrlPath
}

pub(open) inductive Url: Type {
  MkUrl(
    scheme: List(Nat),
    auth: Option(Authority),
    path: UrlPath,
    query: Option(List(Nat)),
    fragment: Option(List(Nat))
  ): Url
}

pub(open) inductive SchemeKind: Type {
  Special(default_port: Nat): SchemeKind
  File: SchemeKind
  NotSpecial: SchemeKind
}

pub fn scheme_kind(s: List(Nat)): SchemeKind {
  ⊢ SchemeKind from match bytes_eq(s, Text::bytes("http")) {
    true => Special(80)
    false => ⊢ SchemeKind from match bytes_eq(s, Text::bytes("https")) {
      true => Special(443)
      false => ⊢ SchemeKind from match bytes_eq(s, Text::bytes("ws")) {
        true => Special(80)
        false => ⊢ SchemeKind from match bytes_eq(s, Text::bytes("wss")) {
          true => Special(443)
          false => ⊢ SchemeKind from match bytes_eq(s, Text::bytes("ftp")) {
            true => Special(21)
            false => ⊢ SchemeKind from match bytes_eq(s, Text::bytes("file")) {
              true => File
              false => NotSpecial
            }
          }
        }
      }
    }
  }
}

pub fn is_special(s: List(Nat)): Bool {
  ⊢ Bool from match scheme_kind(s) {
    Special(d) => true
    File => true
    NotSpecial => false
  }
}

pub fn scheme_byte(b: Nat): Bool {
  Bool::or(
    is_lower(b),
    Bool::or(is_digit(b), Bool::or(Nat::eq(b, 43), Bool::or(Nat::eq(b, 45), Nat::eq(b, 46))))
  )
}

// A scheme as the parser leaves it: a lower-case letter, then scheme bytes.
pub fn scheme_ok(s: List(Nat)): Bool {
  ⊢ Bool from match s {
    Nil => false
    Cons(b, t) => Bool::and(is_lower(b), all_bytes(scheme_byte, t))
  }
}

pub fn query_set_of(s: List(Nat)): (Nat) -> Bool {
  ⊢ (Nat) -> Bool from match is_special(s) {
    true => special_query_set
    false => query_set
  }
}

// The decimal digits of `n`, with `fuel` digits at most.
pub fn decimal(fuel: Nat, n: Nat): List(Nat) {
  ⊢ List(Nat) from match fuel {
    Zero => Nil
    Succ(k) => ⊢ List(Nat) from match Nat::lt(n, 10) {
      true => Cons(Nat::add(n, 48), Nil)
      false => List::append(
        decimal(k, Nat::div_nz(n, 10, Nat::ne_zero(10, Refl))),
        Cons(Nat::add(Nat::rem_nz(n, 10, Nat::ne_zero(10, Refl)), 48), Nil)
      )
    }
  }
}

// A port is below 65536: five digits.
pub fn port_text(n: Nat): List(Nat) {
  decimal(5, n)
}

pub fn digits_value(acc: Nat, l: List(Nat)): Option(Nat) {
  ⊢ Option(Nat) from match l {
    Nil => Some(acc)
    Cons(b, t) => ⊢ Option(Nat) from match is_digit(b) {
      true => digits_value(Nat::add(Nat::mul(acc, 10), Nat::sub(b, 48)), t)
      false => None
    }
  }
}

pub fn opt_bytes(c: Nat, o: Option(List(Nat))): List(Nat) {
  ⊢ List(Nat) from match o {
    None => Nil
    Some(x) => Cons(c, x)
  }
}

pub fn port_part(o: Option(Nat)): List(Nat) {
  ⊢ List(Nat) from match o {
    None => Nil
    Some(n) => Cons(58, port_text(n))
  }
}

pub fn pass_part(pass: List(Nat)): List(Nat) {
  ⊢ List(Nat) from match pass {
    Nil => Nil
    Cons(b, t) => Cons(58, pass)
  }
}

// `user:pass@`, or nothing when both are empty.
pub fn cred_part(user: List(Nat), pass: List(Nat)): List(Nat) {
  ⊢ List(Nat) from match Bool::and(is_empty(user), is_empty(pass)) {
    true => Nil
    false => List::append(user, List::append(pass_part(pass), Cons(64, Nil)))
  }
}

pub fn auth_part(a: Authority): List(Nat) {
  ⊢ List(Nat) from match a {
    Auth(user, pass, host, port) => List::append(
      cred_part(user, pass),
      List::append(host, port_part(port))
    )
  }
}

pub fn segments_part(ss: List(List(Nat))): List(Nat) {
  ⊢ List(Nat) from match ss {
    Nil => Nil
    Cons(s, rest) => Cons(47, join(47, ss))
  }
}

// Without an authority, a path whose first segment is empty would read as
// one: `/.` goes before it.
pub fn dot_prefix(ss: List(List(Nat))): List(Nat) {
  ⊢ List(Nat) from match ss {
    Nil => Nil
    Cons(s, rest) => ⊢ List(Nat) from match is_empty(s) {
      false => Nil
      true => ⊢ List(Nat) from match rest {
        Nil => Nil
        Cons(s2, more) => Cons(47, Cons(46, Nil))
      }
    }
  }
}

pub fn path_part(has_auth: Bool, p: UrlPath): List(Nat) {
  ⊢ List(Nat) from match p {
    Opaque(o) => o
    Segments(ss) => ⊢ List(Nat) from match has_auth {
      true => segments_part(ss)
      false => List::append(dot_prefix(ss), segments_part(ss))
    }
  }
}

pub fn hier_part(a: Option(Authority), p: UrlPath): List(Nat) {
  ⊢ List(Nat) from match a {
    None => path_part(false, p)
    Some(x) => Cons(47, Cons(47, List::append(auth_part(x), path_part(true, p))))
  }
}

pub fn serialize(u: Url): List(Nat) {
  ⊢ List(Nat) from match u {
    MkUrl(scheme, auth, path, query, fragment) => List::append(
      scheme,
      Cons(
        58,
        List::append(
          hier_part(auth, path),
          List::append(opt_bytes(63, query), opt_bytes(35, fragment))
        )
      )
    )
  }
}

pub fn url_text(u: Url): Text {
  Text::Mk(serialize(u))
}
