import std::List
import "url.taut"
import "bytes.taut"
import "percent.taut"
import std::Base
import std::Text

// Parsing (URL Standard, "URL parsing") for the URLs this library handles.
// Each part of the input is cut out, then brought to its normal form by a
// function that changes nothing when given its own output; an input whose
// normal form this library cannot compute is refused (`None`), never given
// another meaning.

pub fn is_tab_or_newline(b: Nat): Bool {
  Bool::or(Nat::eq(b, 9), Bool::or(Nat::eq(b, 10), Nat::eq(b, 13)))
}

pub fn is_c0_or_space(b: Nat): Bool {
  Nat::lt(b, 33)
}

pub fn drop_c0_space(l: List(Nat)): List(Nat) {
  match l: List(Nat) {
    Nil => Nil
    Cons(b, t) => match is_c0_or_space(b): List(Nat) {
      true => drop_c0_space(t)
      false => l
    }
  }
}

// Leading and trailing C0 controls and spaces go, and so do tabs and newlines
// everywhere.
pub fn preprocess(l: List(Nat)): List(Nat) {
  List::filter(
    (b: Nat) => not(is_tab_or_newline(b)),
    List::reverse(drop_c0_space(List::reverse(drop_c0_space(l))))
  )
}

// U+0000, tab, newline, carriage return, space, `#`, `/`, `:`, `<`, `>`, `?`,
// `@`, `[`, `\`, `]`, `^`, `|`.
pub fn forbidden_host(b: Nat): Bool {
  Bool::or(
    Nat::eq(b, 0),
    Bool::or(
      is_tab_or_newline(b),
      Bool::or(
        Nat::eq(b, 32),
        Bool::or(
          Nat::eq(b, 35),
          Bool::or(
            Nat::eq(b, 47),
            Bool::or(
              Nat::eq(b, 58),
              Bool::or(
                Nat::eq(b, 60),
                Bool::or(
                  Nat::eq(b, 62),
                  Bool::or(
                    Nat::eq(b, 63),
                    Bool::or(
                      Nat::eq(b, 64),
                      Bool::or(Bool::and(Nat::le(91, b), Nat::le(b, 94)), Nat::eq(b, 124))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

// A byte of a domain this library reads: printable ASCII, not a forbidden
// domain code point. Bytes from 0x80 on would need IDNA, and are refused.
pub fn domain_byte(b: Nat): Bool {
  Bool::and(Nat::lt(32, b), Bool::and(Nat::lt(b, 127), Bool::and(not(forbidden_host(b)), not(Nat::eq(b, 37)))))
}

// Whether a label starts with `xn--`, which would need IDNA.
pub fn is_ace(l: List(Nat)): Bool {
  match l: Bool {
    Nil => false
    Cons(a, t) => match t: Bool {
      Nil => false
      Cons(b, t2) => match t2: Bool {
        Nil => false
        Cons(c, t3) => match t3: Bool {
          Nil => false
          Cons(d, t4) => Bool::and(
            Nat::eq(a, 120),
            Bool::and(Nat::eq(b, 110), Bool::and(Nat::eq(c, 45), Nat::eq(d, 45)))
          )
        }
      }
    }
  }
}

pub fn last_piece(ps: List(List(Nat))): List(Nat) {
  match ps: List(Nat) {
    Nil => Nil
    Cons(p, rest) => match rest: List(Nat) {
      Nil => p
      Cons(q, more) => last_piece(rest)
    }
  }
}

// The last label, without an empty label after the last dot.
pub fn last_label(ps: List(List(Nat))): List(Nat) {
  match ps: List(Nat) {
    Nil => Nil
    Cons(p, rest) => match rest: List(Nat) {
      Nil => p
      Cons(q, more) => match more: List(Nat) {
        Nil => match is_empty(q): List(Nat) {
          true => p
          false => q
        }
        Cons(r, more2) => last_label(rest)
      }
    }
  }
}

// A number as the IPv4 parser reads one: decimal, or `0x` and hex digits.
pub fn is_number(l: List(Nat)): Bool {
  match l: Bool {
    Nil => false
    Cons(a, t) => match t: Bool {
      Nil => is_digit(a)
      Cons(b, t2) => match Bool::and(Nat::eq(a, 48), Bool::or(Nat::eq(b, 120), Nat::eq(b, 88))): Bool {
        true => all_bytes(is_hex, t2)
        false => all_bytes(is_digit, l)
      }
    }
  }
}

// A part of an IPv4 address as the serializer writes it: 0 to 255, no
// leading zero.
pub fn ipv4_part(l: List(Nat)): Bool {
  match l: Bool {
    Nil => false
    Cons(a, t) => Bool::and(
      all_bytes(is_digit, l),
      Bool::and(
        Bool::or(is_empty(t), not(Nat::eq(a, 48))),
        Bool::and(
          Nat::lt(List::length(l), 4),
          match digits_value(0, l): Bool {
            None => false
            Some(v) => Nat::lt(v, 256)
          }
        )
      )
    )
  }
}

pub fn ipv4_canonical(ps: List(List(Nat))): Bool {
  Bool::and(Nat::eq(List::length(ps), 4), List::all(ipv4_part, ps))
}

// A lower-cased domain this library can return as it is. One that ends in a
// number is an IPv4 address and must be written as the serializer writes
// one.
pub fn domain_ok(l: List(Nat)): Bool {
  Bool::and(
    not(is_empty(l)),
    Bool::and(
      all_bytes(domain_byte, l),
      Bool::and(
        not(List::any(is_ace, split_all(46, l))),
        Bool::or(not(is_number(last_label(split_all(46, l)))), ipv4_canonical(split_all(46, l)))
      )
    )
  )
}

pub fn host_special(h: List(Nat)): Option(List(Nat)) {
  match domain_ok(lower(h)): Option(List(Nat)) {
    true => Some(lower(h))
    false => None
  }
}

// The host of a URL that is not special: anything but a forbidden host code
// point, C0 controls percent-encoded. An IPv6 address (`[`) is refused.
pub fn host_opaque(h: List(Nat)): Option(List(Nat)) {
  match all_bytes((b: Nat) => not(forbidden_host(b)), h): Option(List(Nat)) {
    true => Some(pct_encode(c0_control_set, h))
    false => None
  }
}

pub fn host_of(special: Bool, h: List(Nat)): Option(List(Nat)) {
  match special: Option(List(Nat)) {
    true => host_special(h)
    false => host_opaque(h)
  }
}

pub fn port_value(default: Option(Nat), v: Nat): Option(Option(Nat)) {
  match Nat::lt(v, 65536): Option(Option(Nat)) {
    false => None
    true => port_value_after(default, v)
  }
}

pub fn port_value_after(default: Option(Nat), v: Nat): Option(Option(Nat)) {
  match default: Option(Option(Nat)) {
    None => Some(Some(v))
    Some(d) => match Nat::eq(v, d): Option(Option(Nat)) {
      true => Some(None)
      false => Some(Some(v))
    }
  }
}

// The port after `:`: none when empty or the default, refused when not a
// number below 65536.
pub fn port_of(default: Option(Nat), l: List(Nat)): Option(Option(Nat)) {
  match l: Option(Option(Nat)) {
    Nil => Some(None)
    Cons(b, t) => port_digits(default, digits_value(0, l))
  }
}

pub fn port_digits(default: Option(Nat), o: Option(Nat)): Option(Option(Nat)) {
  match o: Option(Option(Nat)) {
    None => None
    Some(v) => port_value(default, v)
  }
}

pub fn default_port(s: List(Nat)): Option(Nat) {
  match scheme_kind(s): Option(Nat) {
    Special(d) => Some(d)
    File => None
    NotSpecial => None
  }
}

pub fn is_dot_byte(l: List(Nat)): Option(List(Nat)) {
  // `.` or `%2e`, and what follows it.
  match l: Option(List(Nat)) {
    Nil => None
    Cons(a, t) => match Nat::eq(a, 46): Option(List(Nat)) {
      true => Some(t)
      false => match Nat::eq(a, 37): Option(List(Nat)) {
        false => None
        true => match t: Option(List(Nat)) {
          Nil => None
          Cons(b, t2) => match t2: Option(List(Nat)) {
            Nil => None
            Cons(c, t3) => match Bool::and(Nat::eq(b, 50), Bool::or(Nat::eq(c, 101), Nat::eq(c, 69))): Option(List(Nat)) {
              true => Some(t3)
              false => None
            }
          }
        }
      }
    }
  }
}

// `.` and `..`, also written with `%2e`: 1 and 2; any other segment: 0.
pub fn dots(s: List(Nat)): Nat {
  match is_dot_byte(s): Nat {
    None => 0
    Some(t) => match t: Nat {
      Nil => 1
      Cons(b, u) => match is_dot_byte(t): Nat {
        None => 0
        Some(t2) => match t2: Nat {
          Nil => 2
          Cons(c, v) => 0
        }
      }
    }
  }
}

pub fn pop(stack: List(List(Nat))): List(List(Nat)) {
  match stack: List(List(Nat)) {
    Nil => Nil
    Cons(s, rest) => rest
  }
}

// The segments of a path, in reverse, after reading `segs` onto `stack`
// (URL Standard, "path state"): `..` removes the last segment, `.` stays out,
// and either leaves an empty segment when it is the last one.
pub fn walk(stack: List(List(Nat)), segs: List(List(Nat))): List(List(Nat)) {
  match segs: List(List(Nat)) {
    Nil => stack
    Cons(s, rest) => walk(walk_step(stack, pct_encode(path_set, s), is_empty_list(rest)), rest)
  }
}

pub fn walk_step(stack: List(List(Nat)), e: List(Nat), last: Bool): List(List(Nat)) {
  match dots(e): List(List(Nat)) {
    Zero => Cons(e, stack)
    Succ(k) => walk_dots(k, stack, last)
  }
}

pub fn walk_dots(k: Nat, stack: List(List(Nat)), last: Bool): List(List(Nat)) {
  match k: List(List(Nat)) {
    Zero => push_last(stack, last)
    Succ(k2) => push_last(pop(stack), last)
  }
}

pub fn push_last(stack: List(List(Nat)), last: Bool): List(List(Nat)) {
  match last: List(List(Nat)) {
    true => Cons(Nil, stack)
    false => stack
  }
}

// The segments of the bytes after a `/`, read onto `base` (in order).
pub fn path_of(base: List(List(Nat)), l: List(Nat)): List(List(Nat)) {
  List::reverse(walk(List::reverse(base), split_all(47, l)))
}

pub(open) inductive Tail: Type {
  MkTail(hier: List(Nat), query: Option(List(Nat)), fragment: Option(List(Nat))): Tail
}

pub fn tail_of(qset: (Nat) -> Bool, l: List(Nat)): Tail {
  tail_cut(qset, l, cut(35, l))
}

pub fn tail_cut(qset: (Nat) -> Bool, l: List(Nat), o: Option(Pair(List(Nat), List(Nat)))): Tail {
  match o: Tail {
    None => tail_query(qset, l, None)
    Some(p) => tail_query(qset, p.fst, Some(pct_encode(fragment_set, p.snd)))
  }
}

pub fn tail_query(qset: (Nat) -> Bool, l: List(Nat), f: Option(List(Nat))): Tail {
  tail_query_cut(qset, l, f, cut(63, l))
}

pub fn tail_query_cut(
  qset: (Nat) -> Bool,
  l: List(Nat),
  f: Option(List(Nat)),
  o: Option(Pair(List(Nat), List(Nat)))
): Tail {
  match o: Tail {
    None => MkTail(l, None, f)
    Some(p) => MkTail(p.fst, Some(pct_encode(qset, p.snd)), f)
  }
}

pub fn backslash_to_slash(b: Nat): Nat {
  match Nat::eq(b, 92): Nat {
    true => 47
    false => b
  }
}

pub fn drop_slashes(l: List(Nat)): List(Nat) {
  match l: List(Nat) {
    Nil => Nil
    Cons(b, t) => match Nat::eq(b, 47): List(Nat) {
      true => drop_slashes(t)
      false => l
    }
  }
}

pub fn user_pass(c: List(Nat)): Pair(List(Nat), List(Nat)) {
  user_pass_cut(c, cut(58, c))
}

pub fn user_pass_cut(c: List(Nat), o: Option(Pair(List(Nat), List(Nat)))): Pair(List(Nat), List(Nat)) {
  match o: Pair(List(Nat), List(Nat)) {
    None => Pair { fst: pct_encode(userinfo_set, c), snd: Nil }
    Some(p) => Pair { fst: pct_encode(userinfo_set, p.fst), snd: pct_encode(userinfo_set, p.snd) }
  }
}

// `host:port`, after the credentials. A port needs a host before it.
pub fn host_port(
  special: Bool,
  default: Option(Nat),
  user: List(Nat),
  pass: List(Nat),
  hp: List(Nat)
): Option(Authority) {
  host_port_cut(special, default, user, pass, hp, cut(58, hp))
}

pub fn host_port_cut(
  special: Bool,
  default: Option(Nat),
  user: List(Nat),
  pass: List(Nat),
  hp: List(Nat),
  o: Option(Pair(List(Nat), List(Nat)))
): Option(Authority) {
  match o: Option(Authority) {
    None => host_with_port(special, user, pass, hp, Some(None))
    Some(p) => match is_empty(p.fst): Option(Authority) {
      true => None
      false => host_with_port(special, user, pass, p.fst, port_of(default, p.snd))
    }
  }
}

pub fn host_with_port(
  special: Bool,
  user: List(Nat),
  pass: List(Nat),
  h: List(Nat),
  port: Option(Option(Nat))
): Option(Authority) {
  match port: Option(Authority) {
    None => None
    Some(pt) => with_host(user, pass, pt, host_of(special, h))
  }
}

pub fn with_host(user: List(Nat), pass: List(Nat), pt: Option(Nat), o: Option(List(Nat))): Option(Authority) {
  match o: Option(Authority) {
    None => None
    Some(host) => Some(Auth(user, pass, host, pt))
  }
}

pub fn authority_of(special: Bool, default: Option(Nat), a: List(Nat)): Option(Authority) {
  authority_cut(special, default, a, rcut(64, a))
}

pub fn authority_cut(
  special: Bool,
  default: Option(Nat),
  a: List(Nat),
  o: Option(Pair(List(Nat), List(Nat)))
): Option(Authority) {
  match o: Option(Authority) {
    None => host_port(special, default, Nil, Nil, a)
    Some(p) => match is_empty(p.snd): Option(Authority) {
      true => None
      false => host_port(special, default, user_pass(p.fst).fst, user_pass(p.fst).snd, p.snd)
    }
  }
}

// The path after an authority with nothing after it: `/` in a special URL.
pub fn empty_path(special: Bool): List(List(Nat)) {
  match special: List(List(Nat)) {
    true => Cons(Nil, Nil)
    false => Nil
  }
}

// The authority and path after `//`. A path is empty only in a URL that is
// not special.
pub fn auth_path(
  special: Bool,
  default: Option(Nat),
  l: List(Nat)
): Option(Pair(Authority, List(List(Nat)))) {
  auth_path_cut(special, default, l, cut(47, l))
}

pub fn auth_path_cut(
  special: Bool,
  default: Option(Nat),
  l: List(Nat),
  o: Option(Pair(List(Nat), List(Nat)))
): Option(Pair(Authority, List(List(Nat)))) {
  match o: Option(Pair(Authority, List(List(Nat)))) {
    None => with_path(authority_of(special, default, l), empty_path(special))
    Some(p) => with_path(authority_of(special, default, p.fst), path_of(Nil, p.snd))
  }
}

pub fn with_path(
  a: Option(Authority),
  ss: List(List(Nat))
): Option(Pair(Authority, List(List(Nat)))) {
  match a: Option(Pair(Authority, List(List(Nat)))) {
    None => None
    Some(x) => Some(Pair { fst: x, snd: ss })
  }
}

pub fn ends_with_space(l: List(Nat)): Bool {
  first_is_space(List::reverse(l))
}

pub fn first_is_space(l: List(Nat)): Bool {
  match l: Bool {
    Nil => false
    Cons(b, t) => Nat::eq(b, 32)
  }
}

pub fn mk(
  scheme: List(Nat),
  ap: Option(Pair(Authority, List(List(Nat)))),
  t: Tail
): Option(Url) {
  match ap: Option(Url) {
    None => None
    Some(p) => Some(MkUrl(scheme, Some(p.fst), Segments(p.snd), t.query, t.fragment))
  }
}

// A special URL: slashes (and backslashes) after the scheme are skipped and
// an authority follows.
pub fn parse_special(scheme: List(Nat), d: Nat, t: Tail): Option(Url) {
  mk(scheme, auth_path(true, Some(d), drop_slashes(List::map(backslash_to_slash, t.hier))), t)
}

pub fn parse_plain(scheme: List(Nat), t: Tail): Option(Url) {
  match t.hier: Option(Url) {
    Nil => Some(MkUrl(scheme, None, Opaque(Nil), t.query, t.fragment))
    Cons(b, rest) => match Nat::eq(b, 47): Option(Url) {
      false => parse_opaque(scheme, t)
      true => plain_slash(scheme, rest, t)
    }
  }
}

// After the first `/`: an authority after a second, else a path.
pub fn plain_slash(scheme: List(Nat), rest: List(Nat), t: Tail): Option(Url) {
  match rest: Option(Url) {
    Nil => Some(MkUrl(scheme, None, Segments(path_of(Nil, Nil)), t.query, t.fragment))
    Cons(b2, rest2) => match Nat::eq(b2, 47): Option(Url) {
      true => mk(scheme, auth_path(false, None, rest2), t)
      false => Some(MkUrl(scheme, None, Segments(path_of(Nil, rest)), t.query, t.fragment))
    }
  }
}

pub fn parse_opaque(scheme: List(Nat), t: Tail): Option(Url) {
  opaque_path(scheme, pct_encode(c0_control_set, t.hier), t)
}

// An opaque path that ends with a space is refused.
pub fn opaque_path(scheme: List(Nat), o: List(Nat), t: Tail): Option(Url) {
  match ends_with_space(o): Option(Url) {
    true => None
    false => Some(MkUrl(scheme, None, Opaque(o), t.query, t.fragment))
  }
}

// After `scheme:`. `file` URLs are refused.
pub fn parse_after_scheme(s: List(Nat), rest: List(Nat)): Option(Url) {
  match scheme_kind(s): Option(Url) {
    Special(d) => parse_special(s, d, tail_of(special_query_set, rest))
    File => None
    NotSpecial => parse_plain(s, tail_of(query_set, rest))
  }
}

pub fn scheme_of(l: List(Nat)): Option(Pair(List(Nat), List(Nat))) {
  scheme_cut(cut(58, l))
}

pub fn scheme_cut(o: Option(Pair(List(Nat), List(Nat)))): Option(Pair(List(Nat), List(Nat))) {
  match o: Option(Pair(List(Nat), List(Nat))) {
    None => None
    Some(p) => match scheme_ok(lower(p.fst)): Option(Pair(List(Nat), List(Nat))) {
      true => Some(Pair { fst: lower(p.fst), snd: p.snd })
      false => None
    }
  }
}

// An absolute URL from bytes that have been preprocessed.
pub fn parse_bytes(l: List(Nat)): Option(Url) {
  parse_scheme(scheme_of(l))
}

pub fn parse_scheme(o: Option(Pair(List(Nat), List(Nat)))): Option(Url) {
  match o: Option(Url) {
    None => None
    Some(p) => parse_after_scheme(p.fst, p.snd)
  }
}

pub fn url_parse(t: Text): Option(Url) {
  parse_bytes(preprocess(Text::bytes(t)))
}
