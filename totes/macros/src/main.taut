// `macro FILE…`: prints `== FILE` and the dump of each program after
// `rs_resolve`, with `__m` as the separator between a name and its scopes
// (the differential test's input, `tools/selfhost-harness/tests/macros.rs`), or
// `error` when the file is not a program.
import std::text
import std::base
import std::builtin::os

import "../../surface/src/surface.taut"
import "../../surface/src/modules.taut"
import "../../parse/src/parse.taut"
import "lift.taut"
import "lower.taut"
import "expand.taut"
import "node.taut"
import "scope.taut"
import "../../syntax/src/syntax.taut"
import "../../text/src/text.taut"
import "../../unicode/src/classes.taut"
import "../../unicode/src/unicode.taut"
import surface::dump

pub fn mc_ctors(xs: List(SurfaceStmt)): List(Text) ! {div} {
  match xs {
    Nil => Nil
    Cons(s, rest) => mc_append(mc_ctors_of(s), mc_ctors(rest))
  }
}

pub fn mc_append(a: List(Text), b: List(Text)): List(Text) {
  match a {
    Nil => b
    Cons(x, rest) => Cons(x, mc_append(rest, b))
  }
}

pub fn mc_data_names(cs: List(SurfaceDataCtor)): List(Text) {
  match cs {
    Nil => Nil
    Cons(c, rest) => Cons(c.name, mc_data_names(rest))
  }
}

pub fn mc_ind_names(cs: List(SurfaceCtor)): List(Text) {
  match cs {
    Nil => Nil
    Cons(c, rest) => Cons(c.name, mc_ind_names(rest))
  }
}

pub fn mc_ctors_of(s: SurfaceStmt): List(Text) ! {div} {
  match s {
    StStruct(d) => mc_data_names(d.constructors)
    StEnum(d) => mc_data_names(d.constructors)
    StInductive(d) => mc_ind_names(d.constructors)
    StMutual(items, ^a, ^b) => mc_ctors(items)
    StModule(^name, ^vis, items, ^a, ^b) => mc_ctors(items)
    ^other => Nil
  }
}

pub fn mc_each(t: &SyntaxTables, classes: UnicodeClasses, paths: List(Text)): Unit ! {div, fs_read, out_of_bounds, overflow, stdout} {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match mc_read_program(t, classes, source) {
          Some(stmts) => print(mc_dump(rs_resolve(stmts, mc_ctors(stmts), "__m")))
          None => print(Text::concat_all(Cons("error", Cons(text_newline(), Nil))))
        }
      }
      mc_each(t, classes, rest)
    }
  }
}

// The spans given out, `id:start:end` each.
pub fn mc_issued(xs: &Vec(LfIss)): Text ! {div, out_of_bounds, overflow} {
  var out := "spans"
  var i: u64 := 0
  while i < Vec::len(&xs) {
    let x := Vec::index(&xs, i)
    out := Text::concat_all(
      Cons(
        out,
        Cons(
          " ",
          Cons(
            Text::of_u64(x.id),
            Cons(":", Cons(Text::of_nat(x.start), Cons(":", Cons(Text::of_nat(x.end), Nil))))
          )
        )
      )
    )
    i := i + 1
  }
  Text::concat_all(Cons(out, Cons(text_newline(), Nil)))
}

// For each statement of the program: `ok` and the value `Lift` makes of it
// with the scopes 3 and 7, `skip` when it holds a macro call on a literal, or
// `err`.
pub fn mc_lift_stmts(xs: List(SurfaceStmt), lower: Bool, atoms: List(LfAtom), tabled: Bool): Unit ! {div, out_of_bounds, overflow, stdout} {
  match xs {
    Nil => #()
    Cons(s, rest) => {
      var errs: LfSt := lf_st_new(tabled)
      let node := lf_stmt(
        LfCtx { scopes: Cons(3, Cons(7, Nil)), in_quote: false, atoms: atoms, reflip: None },
        &mut errs,
        s
      )
      var bad := false
      var lit := false
      var i: u64 := 0
      while i < Vec::len(&errs.errs) {
        let e := Vec::index(&errs.errs, i)
        if e == "lit" {
          lit := true
        } else {
          bad := true
        }
        i := i + 1
      }
      if bad {
        print("err\n")
      } else if lit {
        print("skip\n")
      } else if lower {
        var lw := lw_new()
        let out := lw_stmt(LwCtx { scope: 5, atoms: Nil }, &mut lw, node)
        if Vec::len(&lw.errs) > 0 {
          print("err\n")
        } else {
          print(
            Text::concat_all(
              Cons("ok", Cons(text_newline(), Cons(mc_dump(Cons(out, Nil)), Nil)))
            )
          )
        }
      } else {
        print(Text::concat_all(Cons("ok ", Cons(nd_show(node), Cons(text_newline(), Nil)))))
        if tabled {
          print(mc_issued(&errs.issued))
        }
      }
      mc_lift_stmts(rest, lower, atoms, tabled)
    }
  }
}

pub fn mc_lift_each(
  t: &SyntaxTables,
  classes: UnicodeClasses,
  paths: List(Text),
  lower: Bool,
  atoms: List(LfAtom),
  tabled: Bool
): Unit ! {div, fs_read, out_of_bounds, overflow, stdout} {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match mc_read_program(t, classes, source) {
          Some(stmts) => mc_lift_stmts(stmts, lower, atoms, tabled)
          None => print("error\n")
        }
      }
      mc_lift_each(t, classes, rest, lower, atoms, tabled)
    }
  }
}

fn mc_has_module(stmts: List(SurfaceStmt)): Bool {
  match stmts {
    Nil => false
    Cons(statement, rest) => match statement {
      StOther(what, ^start, ^end) => text_starts_with(what, "#enter ", 0) || mc_has_module(rest)
      _ => mc_has_module(rest)
    }
  }
}

fn mc_read_program(t: &SyntaxTables, classes: UnicodeClasses, source: Text): Option(List(SurfaceStmt)) ! {div} {
  match surface_parse_program(t, classes, source, 0) {
    None => None
    Some(stmts) => if mc_has_module(stmts) {
      surface_parse_quote_body(t, classes, source)
    } else { Some(stmts) }
  }
}

fn mc_dump(stmts: List(SurfaceStmt)): Text ! {div} {
  let heading := sdump_counted(0, "Program", List::length(stmts), Nil)
  Text::concat_all(List::reverse(mc_dump_stmts(stmts, 1, heading)))
}

fn mc_dump_stmts(stmts: List(SurfaceStmt), depth: Nat, out: List(Text)): List(Text) ! {div} {
  match stmts {
    Nil => out
    Cons(statement, rest) => mc_dump_stmts(rest, depth, sdump_stmt(statement, depth, out))
  }
}

pub fn mc_quote_each(
  t: &SyntaxTables,
  classes: UnicodeClasses,
  stmts: Bool,
  paths: List(Text)
): Unit ! {div, fs_read, out_of_bounds, overflow, stdout} {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match surface_parse_quote_body(t, classes, source) {
          Some(body) => {
            var errs: LfSt := lf_st_new(false)
            let term := lf_desugar(
              &mut errs,
              stmts,
              body,
              LfSp { start: 0, end: Nat::of_u64(std::prelude::Text::len(source)) }
            )
            if Vec::len(&errs.errs) > 0 {
              print("err\n")
            } else {
              print(surface_dump(Cons(SurfaceStmt::StExpr(term), Nil)))
            }
          }
          None => print("error\n")
        }
      }
      mc_quote_each(t, classes, stmts, rest)
    }
  }
}

// Each statement lifted with the scopes 3 and 7, lowered with the scope 5, and
// read again with that scope flipped back (`Syn::expand`): the value of that.
pub fn mc_reflip_stmts(xs: List(SurfaceStmt)): Unit ! {div, out_of_bounds, overflow, stdout} {
  match xs {
    Nil => #()
    Cons(s, rest) => {
      var errs: LfSt := lf_st_new(false)
      let node := lf_stmt(
        LfCtx { scopes: Cons(3, Cons(7, Nil)), in_quote: false, atoms: Nil, reflip: None },
        &mut errs,
        s
      )
      var bad := false
      var lit := false
      var i: u64 := 0
      while i < Vec::len(&errs.errs) {
        let e := Vec::index(&errs.errs, i)
        if e == "lit" {
          lit := true
        } else {
          bad := true
        }
        i := i + 1
      }
      if bad {
        print("err\n")
      } else if lit {
        print("skip\n")
      } else {
        var lw := lw_new()
        let out := lw_stmt(LwCtx { scope: 5, atoms: Nil }, &mut lw, node)
        if Vec::len(&lw.errs) > 0 {
          print("err\n")
        } else {
          var errs2: LfSt := lf_st_new(false)
          let again := lf_stmt(
            LfCtx { scopes: Nil, in_quote: false, atoms: Nil, reflip: Some(5) },
            &mut errs2,
            out
          )
          if Vec::len(&errs2.errs) > 0 {
            print("err\n")
          } else {
            print(Text::concat_all(Cons("ok ", Cons(nd_show(again), Cons(text_newline(), Nil)))))
          }
        }
      }
      mc_reflip_stmts(rest)
    }
  }
}

pub fn mc_reflip_each(t: &SyntaxTables, classes: UnicodeClasses, paths: List(Text), quoted: Bool): Unit ! {div, fs_read, out_of_bounds, overflow, stdout} {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match (if quoted {
          surface_parse_quote_body(t, classes, source)
        } else { mc_read_program(t, classes, source) }) {
          Some(stmts) => mc_reflip_stmts(stmts)
          None => print("error\n")
        }
      }
      mc_reflip_each(t, classes, rest, quoted)
    }
  }
}

pub fn mc_atoms(): List(LfAtom) {
  Cons(
    LfAtom { name: "x", id: 11 },
    Cons(
      LfAtom { name: "a", id: 12 },
      Cons(LfAtom { name: "n", id: 13 }, Cons(LfAtom { name: "f", id: 14 }, Nil))
    )
  )
}

// `--expand FILE…`: the files in order, as one program, each with its macros
// expanded (`expand.taut`): `== FILE`, the dump of the file after expansion,
// then `error CODE START END` for each error, in the order they were found.
pub fn mc_expand_files(t: &SyntaxTables, classes: UnicodeClasses, st: &mut ExState, done: List(SurfaceStmt), paths: List(Text), modules: Bool): Unit ! {div, fs_read, out_of_bounds, overflow, stdout} {
  match paths {
    Nil => {
      var value_index: u64 := 0
      while value_index < Vec::len(&st.values) {
        print(nd_wire(Vec::index(&st.values, value_index)))
        value_index := value_index + 1
      }
      var i: u64 := 0
      while i < Vec::len(&st.errs) {
        print(Text::concat_all(["error ", Vec::index(&st.errs, i), text_newline()]))
        i := i + 1
      }
    }
    Cons(path, rest) => {
      if not(st.capture_values) { print(Text::concat_all(["== ", path, text_newline()])) } else { #() }
      match read_file(path) {
        Err(e) => print(Text::concat_all(["cannot read: ", e, text_newline()]))
        Ok(source) => match surface_parse_program(t, classes, source, 0) {
          Some(stmts) => {
            let out := if modules { ex_module_file(&mut st, stmts) } else { ex_file(&mut st, done, stmts) }
            if not(st.capture_values) { print(surface_dump(out)) } else { #() }
            mc_expand_files(t, classes, &mut st, List::append(done, out), rest, modules)
          }
          None => print(Text::concat_all(Cons("error", Cons(text_newline(), Nil))))
        }
      }
    }
  }
}

// Every index is below the length it was read with; a slip there says so
// and stops rather than reading past the end.
perform main(() => {
  handle {
    match syntax_tables() {
      None => eprint("the tables of the syntax are damaged")
      Some(t) => match perform argv() {
        Cons("--lift", paths) => mc_lift_each(t, unicode_classes(), paths, false, Nil, false)
        Cons("--lower", paths) => mc_lift_each(t, unicode_classes(), paths, true, Nil, false)
        Cons("--lift-atoms", paths) => mc_lift_each(
          t,
          unicode_classes(),
          paths,
          false,
          mc_atoms(),
          false
        )
        Cons("--expand", paths) => {
          var st := ex_state()
          mc_expand_files(t, unicode_classes(), &mut st, Nil, paths, false)
        }
        Cons("--expand-modules", paths) => {
          var st := ex_state()
          mc_expand_files(t, unicode_classes(), &mut st, Nil, paths, true)
        }
        Cons("--statement-values", paths) => {
          var st := ex_state()
          st.capture_values := true
          mc_expand_files(t, unicode_classes(), &mut st, Nil, paths, true)
        }
        Cons("--reflip", paths) => mc_reflip_each(t, unicode_classes(), paths, false)
        Cons("--reflip-module-stmts", paths) => mc_reflip_each(t, unicode_classes(), paths, true)
        Cons("--lift-spans", paths) => mc_lift_each(t, unicode_classes(), paths, false, Nil, true)
        Cons("--quote", paths) => mc_quote_each(t, unicode_classes(), false, paths)
        Cons("--quote-stmts", paths) => mc_quote_each(t, unicode_classes(), true, paths)
        paths => mc_each(t, unicode_classes(), paths)
      }
    }
  } with {
    out_of_bounds() => eprint("an index went past the end of a vector")
  }
})
