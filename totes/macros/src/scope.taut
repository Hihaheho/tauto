// Hygiene: the names an expansion made, each tied to its binder
// (`crates/tauto-surface/src/macros/scope.rs`, `docs/design/macro.md`).
//
// A name a macro made carries the expansions that made it after a separator
// (`tmp` and `1,3` with the separator between). `rs_resolve` gives each such
// binder a name of its own (`tmp#3`) and ties each such name to the binder
// that matches; what no binder of the expansion matches is a global and keeps
// its name, and a local of the caller with that name is renamed so that it
// does not take it. The order in which numbers are handed out is the order of
// the Rust walk, step for step.
import "../../surface/src/surface.taut"
import "../../surface/src/modules.taut"
import "../../text/src/text.taut"
import "../../identity/src/identity.taut"
import std::text

pub(open) struct RsBinder { plain: Text, marks: Text, unique: Text, id: u64 }

pub(open) struct RsGlobal { plain: Text, marks: Text, unique: Text }

pub(open) struct RsState {
  env: Vec(RsBinder)
  globals: Vec(RsGlobal)
  // The numbers of the binders a name of an expansion would have taken.
  captured: Vec(u64)
  rename: Vec(u64)
  // The number of binders met, the number of names given.
  nums: Vec(u64)
  ctors: List(Text)
  sep: Text
}

pub(open) struct RsSplit { plain: Text, marks: Text }

pub fn rs_split(sep: Text, name: Text): RsSplit {
  match text_find(name, sep, 0) {
    Some(i) => RsSplit {
      plain: Text::slice_or_empty(name, 0, i),
      marks: Text::slice_or_empty(
        name,
        i + Nat::of_u64(std::prelude::Text::len(sep)),
        Nat::of_u64(std::prelude::Text::len(name))
      )
    }
    None => RsSplit { plain: name, marks: "" }
  }
}

pub fn rs_cat3(a: Text, b: Text, c: Text): Text {
  Text::concat_all(Cons(a, Cons(b, Cons(c, Nil))))
}

pub fn rs_next(st: &mut RsState, which: u64): u64 ! {overflow} {
  var out: u64 := 0
  match Vec::get_mut(&mut st.nums, which) {
    Some(slot) => {
      out := slot
      *slot := slot + 1
    }
    None => #()
  }
  out
}

pub fn rs_has_num(v: &Vec(u64), x: u64): Bool ! {div, out_of_bounds, overflow} {
  var i: u64 := 0
  var found := false
  while i < Vec::len(&v) && not(found) {
    let y := Vec::index(&v, i)
    if y == x {
      found := true
    }
    i := i + 1
  }
  found
}

pub fn rs_has_text(xs: List(Text), x: Text): Bool {
  match xs {
    Nil => false
    Cons(y, rest) => y == x || rs_has_text(rest, x)
  }
}

pub fn rs_bind(st: &mut RsState, name: Text): Text ! {div, out_of_bounds, overflow} {
  let s := rs_split(st.sep, name)
  let id := rs_next(&mut st, 0)
  var unique := s.plain
  if std::prelude::Text::len(s.marks) > 0 {
    let n := rs_next(&mut st, 1) + 1
    unique := rs_cat3(s.plain, "#", Text::of_u64(n))
  } else if rs_has_num(&st.rename, id) {
    let n := rs_next(&mut st, 1) + 1
    unique := rs_cat3(s.plain, "#r", Text::of_u64(n))
  }
  Vec::push(&mut st.env, RsBinder { plain: s.plain, marks: s.marks, unique: unique, id: id })
  unique
}

pub fn rs_env_find(env: &Vec(RsBinder), plain: Text, marks: Text): Option(Text) ! {div, out_of_bounds, overflow} {
  var i := Vec::len(&env)
  var out: Option(Text) := None
  while i > 0 && rs_is_none(out) {
    i := i - 1
    let b := Vec::index(&env, i)
    if b.plain == plain && b.marks == marks {
      out := Some(b.unique)
    }
  }
  out
}

pub fn rs_is_none(o: Option(Text)): Bool {
  match o {
    None => true
    Some(^x) => false
  }
}

pub fn rs_global_find(gs: &Vec(RsGlobal), plain: Text, marks: Text): Option(Text) ! {div, out_of_bounds, overflow} {
  var i: u64 := 0
  var out: Option(Text) := None
  while i < Vec::len(&gs) {
    let g := Vec::index(&gs, i)
    if g.plain == plain && g.marks == marks {
      out := Some(g.unique)
    }
    i := i + 1
  }
  out
}

pub fn rs_capture(st: &mut RsState, plain: Text): Unit ! {div, out_of_bounds, overflow} {
  var i: u64 := 0
  while i < Vec::len(&st.env) {
    let b := Vec::index(&st.env, i)
    let id := b.id
    let take := b.plain == plain && std::prelude::Text::len(b.marks) == 0
    if take {
      if not(rs_has_num(&st.captured, id)) {
        Vec::push(&mut st.captured, id)
      }
    }
    i := i + 1
  }
}

pub fn rs_reference_one(st: &mut RsState, plain: Text, marks: Text): Text ! {div, out_of_bounds, overflow} {
  match rs_env_find(&st.env, plain, marks) {
    Some(u) => u
    None => if std::prelude::Text::len(marks) > 0 {
      match rs_global_find(&st.globals, plain, marks) {
        Some(u) => u
        None => {
          rs_capture(&mut st, plain)
          plain
        }
      }
    } else {
      plain
    }
  }
}

pub fn rs_reference(st: &mut RsState, name: Text): Text ! {div, out_of_bounds, overflow} {
  let s := rs_split(st.sep, name)
  match text_find(s.plain, "::", 0) {
    Some(i) => {
      let head := rs_reference_one(&mut st, Text::slice_or_empty(s.plain, 0, i), s.marks)
      rs_cat3(
        head,
        "::",
        Text::slice_or_empty(s.plain, i + 2, Nat::of_u64(std::prelude::Text::len(s.plain)))
      )
    }
    None => rs_reference_one(&mut st, s.plain, s.marks)
  }
}

pub fn rs_mark(st: &RsState): u64 {
  Vec::len(&st.env)
}

pub fn rs_pop(st: &mut RsState, mark: u64): Unit {
  Vec::truncate(&mut st.env, mark)
}

// A declaration an expansion made takes a name of its own.
pub fn rs_declare(st: &mut RsState, name: Text): Text ! {overflow} {
  let s := rs_split(st.sep, name)
  if std::prelude::Text::len(s.marks) > 0 {
    let n := rs_next(&mut st, 1) + 1
    let unique := rs_cat3(s.plain, "#", Text::of_u64(n))
    Vec::push(&mut st.globals, RsGlobal { plain: s.plain, marks: s.marks, unique: unique })
    unique
  } else {
    name
  }
}

pub fn rs_declare_ctors(st: &mut RsState, cs: List(SurfaceDataCtor)): List(SurfaceDataCtor) ! {overflow} {
  match cs {
    Nil => Nil
    Cons(c, rest) => {
      let name := rs_declare(&mut st, c.name)
      Cons(SurfaceDataCtor { name: name, fields: c.fields }, rs_declare_ctors(&mut st, rest))
    }
  }
}

pub fn rs_declare_data(st: &mut RsState, d: SurfaceData): SurfaceData ! {overflow} {
  let name := rs_declare(&mut st, d.name)
  let cs := rs_declare_ctors(&mut st, d.constructors)
  SurfaceData {
    kind: d.kind,
    name: name,
    generics: d.generics,
    constructors: cs,
    start: d.start,
    end: d.end,
    coerce_level: d.coerce_level,
    coerce_field: d.coerce_field,
    visibility: d.visibility,
    unused_generics: d.unused_generics,
    rows: d.rows
  }
}

// Declarations an expansion made at the top, and in `mutual` and `module`.
pub fn rs_collect(st: &mut RsState, xs: List(SurfaceStmt)): List(SurfaceStmt) ! {div, overflow} {
  match xs {
    Nil => Nil
    Cons(s, rest) => {
      let out := rs_collect_one(&mut st, s)
      Cons(out, rs_collect(&mut st, rest))
    }
  }
}

pub fn rs_collect_one(st: &mut RsState, s: SurfaceStmt): SurfaceStmt ! {div, overflow} {
  match s {
    StFn(f) => {
      let name := rs_declare(&mut st, f.name)
      StFn(SurfaceFn {
        name: name,
        generics: f.generics,
        bounds: f.bounds,
        params: f.params,
        r#borrows: f.r#borrows,
        param_types: f.param_types,
        result: f.result,
        effects: f.effects,
        wheres: f.wheres,
        start: f.start,
        end: f.end,
        body: f.body,
        lends: f.lends,
        generic_types: f.generic_types,
        bound_starts: f.bound_starts,
        visibility: f.visibility,
        row_hole: f.row_hole,
    unused: f.unused,
    unused_generics: f.unused_generics,
    unused_params: f.unused_params
  })
    }
    StTheorem(d) => StTheorem(rs_declare_theorem(&mut st, d))
    StDef(d) => StDef(rs_declare_theorem(&mut st, d))
    StStruct(d) => StStruct(rs_declare_data(&mut st, d))
    StEnum(d) => StEnum(rs_declare_data(&mut st, d))
    StEffect(e) => {
      let name := rs_declare(&mut st, e.name)
      StEffect(SurfaceEffect {
        visibility: e.visibility,
        name: name,
        generics: e.generics,
        params: e.params,
        result: e.result,
        r#resume: e.r#resume,
        start: e.start,
        end: e.end,
        set: e.set,
        unused_generics: e.unused_generics,
        bounds: e.bounds,
        rows: e.rows
      })
    }
    StInductive(d) => {
      let name := rs_declare(&mut st, d.name)
      StInductive(SurfaceInductive {
        name: name,
        params: d.params,
        sort: d.sort,
        constructors: d.constructors,
        start: d.start,
        end: d.end,
        visibility: d.visibility
      })
    }
    StMutual(items, a, b) => StMutual(rs_collect(&mut st, items), a, b)
    StModule(name, vis, items, a, b) => {
      let qualified := rs_module_name(&mut st, name)
      StModule(qualified, vis, rs_collect(&mut st, items), a, b)
    }
    other => other
  }
}

fn rs_module_name(st: &mut RsState, written: Text): Text {
  let name := rs_split(st.sep, written)
  if name.marks == "" { name.plain } else {
    let unique := rs_cat3(name.plain, "#", name.marks)
    Vec::push(&mut st.globals, RsGlobal { plain: name.plain, marks: name.marks, unique: unique })
    unique
  }
}

pub fn rs_declare_theorem(st: &mut RsState, d: SurfaceTheorem): SurfaceTheorem ! {overflow} {
  let name := rs_declare(&mut st, d.name)
  SurfaceTheorem {
    visibility: d.visibility,
    name: name,
    implicit: d.implicit,
    params: d.params,
    ty: d.ty,
    body: d.body,
    start: d.start,
    end: d.end,
    unused: d.unused,
    unused_params: d.unused_params
  }
}

pub fn rs_top(st: &mut RsState, xs: List(SurfaceStmt)): List(SurfaceStmt) ! {div, out_of_bounds, overflow} {
  let declared := rs_collect(&mut st, xs)
  rs_stmt_list(&mut st, declared)
}

pub fn rs_stmt_list(st: &mut RsState, xs: List(SurfaceStmt)): List(SurfaceStmt) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(s, rest) => {
      let out := rs_stmt(&mut st, s)
      Cons(out, rs_stmt_list(&mut st, rest))
    }
  }
}

// The statements of a block: its binders end with it.
pub fn rs_block(st: &mut RsState, xs: List(SurfaceStmt)): List(SurfaceStmt) ! {div, out_of_bounds, overflow} {
  let mark := rs_mark(&st)
  let out := rs_stmt_list(&mut st, xs)
  rs_pop(&mut st, mark)
  out
}

pub fn rs_opt(st: &mut RsState, t: Option(SurfaceTerm)): Option(SurfaceTerm) ! {div, out_of_bounds, overflow} {
  match t {
    None => None
    Some(x) => Some(rs_term(&mut st, x))
  }
}

pub fn rs_terms(st: &mut RsState, xs: List(SurfaceTerm)): List(SurfaceTerm) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(x, rest) => {
      let y := rs_term(&mut st, x)
      Cons(y, rs_terms(&mut st, rest))
    }
  }
}

fn rs_assignment_place(place: SurfaceTerm, name: Text): SurfaceTerm {
  match place.kind {
    SkApp(head, args) => match surface_deref_inner(head, args) {
      Some(inner) => match inner.kind {
        SkVar(^written) => {
          let start := place.end - Nat::of_u64(std::prelude::Text::len(name))
          let target := surface_term_mk(SkVar(NameSpelled(name)), start, place.end)
          surface_term_mk(SkApp(head, [target]), place.start, place.end)
        }
        _ => place
      }
      None => place
    }
    _ => place
  }
}

pub fn rs_stmt(st: &mut RsState, s: SurfaceStmt): SurfaceStmt ! {div, out_of_bounds, overflow} {
  match s {
    StLet(name, ty, value, a, b, unused, st_stack) => {
      let ty2 := rs_opt(&mut st, ty)
      let value2 := rs_term(&mut st, value)
      let name2 := rs_bind(&mut st, name)
      StLet(name2, ty2, value2, a, b, unused, st_stack)
    }
    StVar(name, ty, value, a, unused, st_stack) => {
      let ty2 := rs_opt(&mut st, ty)
      let value2 := rs_term(&mut st, value)
      let name2 := rs_bind(&mut st, name)
      StVar(name2, ty2, value2, a, unused, st_stack)
    }
    StAssign(name, place, value) => {
      let value2 := rs_term(&mut st, value)
      let name2 := rs_reference(&mut st, name)
      let target := match place {
        None => None
        Some(written) => Some(rs_assignment_place(written, name2))
      }
      StAssign(name2, target, value2)
    }
    StCalled(generates, call) => StCalled(generates, rs_term(&mut st, call))
    StAttributed(name, arg, generates, inner) => {
      let arg2 := rs_term(&mut st, arg)
      StAttributed(name, arg2, generates, rs_stmt(&mut st, inner))
    }
    StFn(f) => StFn(rs_fn(&mut st, f))
    StTheorem(d) => StTheorem(rs_theorem(&mut st, d))
    StDef(d) => StDef(rs_theorem(&mut st, d))
    StWhile(c, body) => {
      let c2 := rs_term(&mut st, c)
      let body2 := rs_term(&mut st, body)
      StWhile(c2, body2)
    }
    StReturn(e) => StReturn(rs_opt(&mut st, e))
    StExpr(e) => StExpr(rs_term(&mut st, e))
    StStruct(d) => StStruct(rs_data(&mut st, d))
    StEnum(d) => StEnum(rs_data(&mut st, d))
    StEffect(e) => StEffect(rs_effect(&mut st, e))
    StMutual(items, a, b) => StMutual(rs_stmt_list(&mut st, items), a, b)
    StModule(name, vis, items, a, b) => StModule(name, vis, rs_stmt_list(&mut st, items), a, b)
    StReexport(path, names, spans, a, b) => {
      let module_name := rs_reference(&mut st, path)
      StReexport(module_name, rs_reexport_names(&mut st, names), spans, a, b)
    }
    StInductive(d) => StInductive(rs_inductive(&mut st, d))
    other => other
  }
}

fn rs_reexport_names(st: &mut RsState, names: List(Text)): List(Text) ! {div, out_of_bounds, overflow} {
  match names {
    Nil => Nil
    Cons(name, rest) => {
      let qualified := rs_reference(&mut st, name)
      Cons(qualified, rs_reexport_names(&mut st, rest))
    }
  }
}

// Each parameter's type (when it has one) is read before the parameter binds.
pub fn rs_params(
  st: &mut RsState,
  names: List(Text),
  types: List(Option(SurfaceTerm))
): List(Text) × List(Option(SurfaceTerm)) ! {div, out_of_bounds, overflow} {
  match names {
    Nil => #(Nil, types)
    Cons(n, rest) => {
      var ty: Option(Option(SurfaceTerm)) := None
      var more: List(Option(SurfaceTerm)) := Nil
      match types {
        Nil => #()
        Cons(t, others) => {
          ty := Some(rs_opt(&mut st, t))
          more := others
        }
      }
      let bound := rs_bind(&mut st, n)
      let tail := rs_params(&mut st, rest, more)
      #(Cons(bound, tail.fst), match ty {
          None => tail.snd
          Some(t) => Cons(t, tail.snd)
        })
    }
  }
}

pub fn rs_fn(st: &mut RsState, f: SurfaceFn): SurfaceFn ! {div, out_of_bounds, overflow} {
  let name := rs_reference(&mut st, f.name)
  let mark := rs_mark(&st)
  let ps := rs_params(&mut st, f.params, f.param_types)
  let result := rs_opt(&mut st, f.result)
  let wheres := rs_constraints(&mut st, f.wheres)
  let body := rs_term(&mut st, f.body)
  rs_pop(&mut st, mark)
  SurfaceFn {
    name: name,
    generics: f.generics,
    bounds: f.bounds,
    params: ps.fst,
    r#borrows: f.r#borrows,
    param_types: ps.snd,
    result: result,
    effects: f.effects,
    wheres: wheres,
    start: f.start,
    end: f.end,
    body: body,
    lends: f.lends,
    generic_types: f.generic_types,
    bound_starts: f.bound_starts,
    visibility: f.visibility,
    row_hole: f.row_hole,
    unused: f.unused,
    unused_generics: f.unused_generics,
    unused_params: f.unused_params
  }
}

// The `where` constraints of a fn read its generics, as its parameter types do.
pub fn rs_constraints(st: &mut RsState, xs: List(SurfaceConstraint)): List(SurfaceConstraint) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(c, rest) => {
      let ty := rs_term(&mut st, c.ty)
      let arguments := rs_terms(&mut st, c.arguments)
      let head := SurfaceConstraint {
        r#class: c.r#class,
        ty: ty,
        start: c.start,
        end: c.end,
        arguments: arguments
      }
      Cons(head, rs_constraints(&mut st, rest))
    }
  }
}

// Types of parameters that bind in turn: each is read, then its name binds.
pub fn rs_named(st: &mut RsState, xs: List(SurfaceNamed)): List(SurfaceNamed) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(p, rest) => {
      let ty := rs_term(&mut st, p.ty)
      let name := rs_bind(&mut st, p.name)
      Cons(SurfaceNamed { name: name, ty: ty }, rs_named(&mut st, rest))
    }
  }
}

pub fn rs_theorem(st: &mut RsState, d: SurfaceTheorem): SurfaceTheorem ! {div, out_of_bounds, overflow} {
  let name := rs_reference(&mut st, d.name)
  let mark := rs_mark(&st)
  let params := rs_named(&mut st, d.params)
  let ty := rs_term(&mut st, d.ty)
  let body := rs_opt(&mut st, d.body)
  rs_pop(&mut st, mark)
  SurfaceTheorem {
    visibility: d.visibility,
    name: name,
    implicit: d.implicit,
    params: params,
    ty: ty,
    body: body,
    start: d.start,
    end: d.end,
    unused: d.unused,
    unused_params: d.unused_params
  }
}

pub fn rs_data_fields(st: &mut RsState, xs: List(SurfaceDataField)): List(SurfaceDataField) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(f, rest) => {
      let ty := rs_term(&mut st, f.ty)
      Cons(SurfaceDataField { name: f.name, ty: ty }, rs_data_fields(&mut st, rest))
    }
  }
}

pub fn rs_data_ctors(st: &mut RsState, xs: List(SurfaceDataCtor)): List(SurfaceDataCtor) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(c, rest) => {
      let name := rs_reference(&mut st, c.name)
      let fields := rs_data_fields(&mut st, c.fields)
      Cons(SurfaceDataCtor { name: name, fields: fields }, rs_data_ctors(&mut st, rest))
    }
  }
}

pub fn rs_data(st: &mut RsState, d: SurfaceData): SurfaceData ! {div, out_of_bounds, overflow} {
  let name := rs_reference(&mut st, d.name)
  let cs := rs_data_ctors(&mut st, d.constructors)
  SurfaceData {
    kind: d.kind,
    name: name,
    generics: d.generics,
    constructors: cs,
    start: d.start,
    end: d.end,
    coerce_level: d.coerce_level,
    coerce_field: d.coerce_field,
    visibility: d.visibility,
    unused_generics: d.unused_generics,
    rows: d.rows
  }
}

pub fn rs_opts(st: &mut RsState, xs: List(Option(SurfaceTerm))): List(Option(SurfaceTerm)) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(x, rest) => {
      let y := rs_opt(&mut st, x)
      Cons(y, rs_opts(&mut st, rest))
    }
  }
}

pub fn rs_effect(st: &mut RsState, e: SurfaceEffect): SurfaceEffect ! {div, out_of_bounds, overflow} {
  let name := rs_reference(&mut st, e.name)
  let params := rs_opts(&mut st, e.params)
  let result := rs_opt(&mut st, e.result)
  SurfaceEffect {
    visibility: e.visibility,
    name: name,
    generics: e.generics,
    params: params,
    result: result,
    r#resume: e.r#resume,
    start: e.start,
    end: e.end,
    set: e.set,
    unused_generics: e.unused_generics,
    bounds: e.bounds,
    rows: e.rows
  }
}

pub fn rs_ind_ctors(st: &mut RsState, xs: List(SurfaceCtor)): List(SurfaceCtor) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(c, rest) => {
      let name := rs_reference(&mut st, c.name)
      let inner := rs_mark(&st)
      let params := rs_named(&mut st, c.params)
      let result := rs_term(&mut st, c.result)
      rs_pop(&mut st, inner)
      Cons(
        SurfaceCtor { name: name, implicit: c.implicit, params: params, result: result },
        rs_ind_ctors(&mut st, rest)
      )
    }
  }
}

pub fn rs_inductive(st: &mut RsState, d: SurfaceInductive): SurfaceInductive ! {div, out_of_bounds, overflow} {
  let name := rs_reference(&mut st, d.name)
  let mark := rs_mark(&st)
  let params := rs_named(&mut st, d.params)
  let sort := rs_term(&mut st, d.sort)
  let cs := rs_ind_ctors(&mut st, d.constructors)
  rs_pop(&mut st, mark)
  SurfaceInductive {
    name: name,
    params: params,
    sort: sort,
    constructors: cs,
    start: d.start,
    end: d.end,
    visibility: d.visibility
  }
}

pub fn rs_patterns(st: &mut RsState, xs: List(SurfacePattern)): List(SurfacePattern) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(p, rest) => {
      let q := rs_pattern(&mut st, p)
      Cons(q, rs_patterns(&mut st, rest))
    }
  }
}

pub fn rs_pattern_fields(
  st: &mut RsState,
  xs: List(SurfacePatternField)
): List(SurfacePatternField) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(f, rest) => {
      let p := rs_pattern(&mut st, f.pattern)
      Cons(SurfacePatternField { name: f.name, pattern: p }, rs_pattern_fields(&mut st, rest))
    }
  }
}

pub fn rs_pattern(st: &mut RsState, p: SurfacePattern): SurfacePattern ! {div, out_of_bounds, overflow} {
  match p {
    PtBind(n, unused) => {
      let s := rs_split(st.sep, n)
      if rs_has_text(st.ctors, s.plain) {
        PtBind(rs_reference(&mut st, n), unused)
      } else {
        PtBind(rs_bind(&mut st, n), unused)
      }
    }
    PtCtor(name, args) => {
      let written := surface_name_text(name)
      // `@a p`: a label, which names no declaration.
      let name2 := if Text::slice_or_empty(written, 0, 1) == "@" { written } else { rs_reference(&mut st, written) }
      PtCtor(NameSpelled(name2), rs_patterns(&mut st, args))
    }
    PtRecord(name, fields) => {
      let name2 := rs_reference(&mut st, name)
      PtRecord(name2, rs_pattern_fields(&mut st, fields))
    }
    PtTyped(name, ty, unused) => {
      let ty2 := rs_term(&mut st, ty)
      PtTyped(rs_bind(&mut st, name), ty2, unused)
    }
    other => other
  }
}

pub fn rs_binder(st: &mut RsState, b: Option(Text)): Option(Text) ! {div, out_of_bounds, overflow} {
  match b {
    None => None
    Some(h) => Some(rs_bind(&mut st, h))
  }
}

pub fn rs_arms(st: &mut RsState, xs: List(SurfaceArm)): List(SurfaceArm) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(a, rest) => {
      let mark := rs_mark(&st)
      let pattern := rs_pattern(&mut st, a.pattern)
      let guard := rs_opt(&mut st, a.guard)
      let goal := rs_opt(&mut st, a.goal)
      let body := rs_term(&mut st, a.body)
      rs_pop(&mut st, mark)
      Cons(
        SurfaceArm { pattern: pattern, guard: guard, goal: goal, body: body },
        rs_arms(&mut st, rest)
      )
    }
  }
}

pub fn rs_step_binders(st: &mut RsState, xs: List(SurfaceField)): List(SurfaceField) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(f, rest) => {
      let ty := rs_term(&mut st, f.value)
      let name := rs_bind(&mut st, f.name)
      Cons(SurfaceField { name: name, value: ty }, rs_step_binders(&mut st, rest))
    }
  }
}

pub fn rs_step_arms(st: &mut RsState, xs: List(SurfaceStepArm)): List(SurfaceStepArm) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(a, rest) => {
      let mark := rs_mark(&st)
      let binders := rs_step_binders(&mut st, a.binders)
      let goal := rs_term(&mut st, a.goal)
      let body := rs_term(&mut st, a.body)
      rs_pop(&mut st, mark)
      let arm := SurfaceStepArm {
        binders: binders,
        unused_binders: a.unused_binders,
        goal: goal,
        body: body,
        start: a.start,
        end: a.end
      }
      Cons(arm, rs_step_arms(&mut st, rest))
    }
  }
}

pub fn rs_handler(st: &mut RsState, h: SurfaceHandler): SurfaceHandler ! {div, out_of_bounds, overflow} {
  let mark := rs_mark(&st)
  let out := match h {
    HdReturn(p, body) => {
      let p2 := rs_pattern(&mut st, p)
      let body2 := rs_term(&mut st, body)
      HdReturn(p2, body2)
    }
    HdOperation(eff, hfa, hty, patterns, cont, cont_unused, guard, body) => {
      let eff2 := rs_reference(&mut st, eff)
      let patterns2 := rs_patterns(&mut st, patterns)
      let cont2 := match cont {
        None => None
        Some(k) => Some(rs_bind(&mut st, k))
      }
      let guard2 := rs_opt(&mut st, guard)
      let body2 := rs_term(&mut st, body)
      HdOperation(eff2, hfa, hty, patterns2, cont2, cont_unused, guard2, body2)
    }
  }
  rs_pop(&mut st, mark)
  out
}

pub fn rs_handlers(st: &mut RsState, xs: List(SurfaceHandler)): List(SurfaceHandler) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(h, rest) => {
      let h2 := rs_handler(&mut st, h)
      Cons(h2, rs_handlers(&mut st, rest))
    }
  }
}

pub fn rs_pi_params(st: &mut RsState, xs: List(SurfaceParam)): List(SurfaceParam) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(p, rest) => {
      let ty := rs_term(&mut st, p.ty)
      let name := match p.name {
        None => None
        Some(n) => Some(rs_bind(&mut st, n))
      }
      Cons(SurfaceParam { name: name, ty: ty, unused: p.unused }, rs_pi_params(&mut st, rest))
    }
  }
}

pub fn rs_binds(st: &mut RsState, xs: List(Text)): List(Text) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(x, rest) => {
      let y := rs_bind(&mut st, x)
      Cons(y, rs_binds(&mut st, rest))
    }
  }
}

pub fn rs_fields(st: &mut RsState, xs: List(SurfaceField)): List(SurfaceField) ! {div, out_of_bounds, overflow} {
  match xs {
    Nil => Nil
    Cons(f, rest) => {
      let v := rs_term(&mut st, f.value)
      Cons(SurfaceField { name: f.name, value: v }, rs_fields(&mut st, rest))
    }
  }
}

pub fn rs_term(st: &mut RsState, t: SurfaceTerm): SurfaceTerm ! {div, out_of_bounds, overflow} {
  SurfaceTerm { occurrence: None, kind: rs_kind(&mut st, t.kind), start: t.start, end: t.end }
}

pub fn rs_kind(st: &mut RsState, k: SurfaceKind): SurfaceKind ! {div, out_of_bounds, overflow} {
  match k {
    SkVar(n) => SkVar(NameSpelled(rs_reference(&mut st, surface_name_text(n))))
    SkMacroCall(name, arg) => SkMacroCall(name, rs_term(&mut st, arg))
    SkSplice(arg) => SkSplice(rs_term(&mut st, arg))
    SkApp(f, args) => {
      let f2 := rs_term(&mut st, f)
      SkApp(f2, rs_terms(&mut st, args))
    }
    SkPi(params, result, effects) => {
      let mark := rs_mark(&st)
      let params2 := rs_pi_params(&mut st, params)
      let result2 := rs_term(&mut st, result)
      rs_pop(&mut st, mark)
      SkPi(params2, result2, effects)
    }
    SkExists(binder, domain, body, unused) => {
      let domain2 := rs_term(&mut st, domain)
      let mark := rs_mark(&st)
      let binder2 := rs_bind(&mut st, binder)
      let body2 := rs_term(&mut st, body)
      rs_pop(&mut st, mark)
      SkExists(binder2, domain2, body2, unused)
    }
    SkLam(params, body, types, unused) => {
      let types2 := rs_opts(&mut st, types)
      let mark := rs_mark(&st)
      let params2 := rs_binds(&mut st, params)
      let body2 := rs_term(&mut st, body)
      rs_pop(&mut st, mark)
      SkLam(params2, body2, types2, unused)
    }
    SkBorrowLam(modes, lam) => SkBorrowLam(modes, rs_term(&mut st, lam))
    SkUnion(items) => SkUnion(rs_terms(&mut st, items))
    SkTagged(tag, term) => SkTagged(tag, rs_term(&mut st, term))
    SkAscribe(value, ty) => {
      let value2 := rs_term(&mut st, value)
      SkAscribe(value2, rs_term(&mut st, ty))
    }
    SkBorrow(m, m_orig, term) => SkBorrow(m, m_orig, rs_term(&mut st, term))
    SkFnKind(kind, ty) => SkFnKind(kind, rs_term(&mut st, ty))
    SkIf(c, a, b) => {
      let c2 := rs_term(&mut st, c)
      let a2 := rs_term(&mut st, a)
      SkIf(c2, a2, rs_opt(&mut st, b))
    }
    SkField(base, name) => SkField(rs_term(&mut st, base), name)
    SkBlock(stmts) => SkBlock(rs_block(&mut st, stmts))
    SkPerform(eff, args) => {
      let eff2 := rs_reference(&mut st, eff)
      SkPerform(eff2, rs_terms(&mut st, args))
    }
    SkHandle(body, handlers) => {
      let body2 := rs_term(&mut st, body)
      SkHandle(body2, rs_handlers(&mut st, handlers))
    }
    SkBudget(memory, steps, body) => {
      let steps2 := rs_term(&mut st, steps)
      SkBudget(memory, steps2, rs_term(&mut st, body))
    }
    SkMatch(scrutinee, result, arms, binder, binder_unused) => {
      let s2 := rs_term(&mut st, scrutinee)
      let r2 := rs_opt(&mut st, result)
      let mark := rs_mark(&st)
      let b2 := rs_binder(&mut st, binder)
      let arms2 := rs_arms(&mut st, arms)
      rs_pop(&mut st, mark)
      SkMatch(s2, r2, arms2, b2, binder_unused)
    }
    SkRecord(name, fields) => {
      let name2 := rs_reference(&mut st, name)
      SkRecord(name2, rs_fields(&mut st, fields))
    }
    // The variables an arm adds are bound in its goal and its proof.
    SkStep(tactic, arg, cs, ce, Before, arms) => {
      let arg2 := rs_term(&mut st, arg)
      let before2 := rs_opt(&mut st, Before)
      SkStep(tactic, arg2, cs, ce, before2, rs_step_arms(&mut st, arms))
    }
    other => other
  }
}

pub fn rs_state(ctors: List(Text), sep: Text, rename: Vec(u64)): RsState {
  var nums: Vec(u64) := Vec::new()
  Vec::push(&mut nums, 0)
  Vec::push(&mut nums, 0)
  RsState {
    env: Vec::new(),
    globals: Vec::new(),
    captured: Vec::new(),
    rename: rename,
    nums: nums,
    ctors: ctors,
    sep: sep
  }
}

// The constructors `ctors` may be named bare in a pattern; `sep` is what
// stands between a name and its scopes.
pub fn rs_resolve(stmts: List(SurfaceStmt), ctors: List(Text), sep: Text): List(SurfaceStmt) ! {div, out_of_bounds, overflow} {
  var first := rs_state(ctors, sep, Vec::new())
  let probe := rs_top(&mut first, stmts)
  if Vec::len(&first.captured) == 0 {
    probe
  } else {
    var rename: Vec(u64) := Vec::new()
    var i: u64 := 0
    while i < Vec::len(&first.captured) {
      let x := Vec::index(&first.captured, i)
      Vec::push(&mut rename, x)
      i := i + 1
    }
    var again := rs_state(ctors, sep, rename)
    rs_top(&mut again, stmts)
  }
}
