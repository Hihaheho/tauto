// What Totebag decides without the network, Git or the file system: which
// names, URLs, refs, directories, commit IDs and tree paths it takes. The
// Rust side (crates/totebag) reads and writes; this tote says yes or no.
package {
  name = "totebag"
  version = "0.1.0"
  sources = ["src", "proof"]
}

dependencies {
  url { path = "../url" }
}

// The entry points the Rust side calls (crates/totebag).
rust {
  exports = ["tb_valid_name", "tb_check_url", "tb_check_ref", "tb_check_dir", "tb_check_rev", "tb_check_source_id", "tb_check_path", "tb_put", "tb_render", "tb_changes", "tb_plan", "tb_check_tree", "tb_independent", "tb_twice"]
}
