// Continued from `indices_head.taut`.

pub fn ix_find_fn(fs: List(SurfaceFn), name: Text): Option(SurfaceFn) {
  match fs {
    Nil => None
    Cons(f, rest) => if f.name == name { Some(f) } else { ix_find_fn(rest, name) }
  }
}

pub fn ix_find_effect(es: List(SurfaceEffect), name: Text): Option(SurfaceEffect) {
  match es {
    Nil => None
    Cons(e, rest) => if e.name == name { Some(e) } else { ix_find_effect(rest, name) }
  }
}

mutual {
  pub fn ix_fns_in(ss: List(SurfaceStmt), out: List(SurfaceFn)): List(SurfaceFn) {
    match ss {
      Nil => out
      Cons(s, rest) => ix_fns_in(rest, ix_fns_of(s, out))
    }
  }

  pub fn ix_fns_of(s: SurfaceStmt, out: List(SurfaceFn)): List(SurfaceFn) {
    match s {
      StFn(f) => Cons(f, out)
      StMutual(items, ^start, ^end) => ix_fns_in(items, out)
      _ => out
    }
  }
}

// The top-level functions, the last written first.
pub fn ix_functions(ss: List(SurfaceStmt)): List(SurfaceFn) {
  ix_fns_in(ss, Nil)
}

pub fn ix_effect_of(s: SurfaceStmt, out: List(SurfaceEffect)): List(SurfaceEffect) {
  match s {
    StEffect(e) => Cons(e, out)
    _ => out
  }
}

pub fn ix_effects_in(ss: List(SurfaceStmt), out: List(SurfaceEffect)): List(SurfaceEffect) {
  match ss {
    Nil => out
    Cons(s, rest) => ix_effects_in(rest, ix_effect_of(s, out))
  }
}

pub fn ix_effect_names(es: List(SurfaceEffect)): List(Text) {
  match es {
    Nil => Nil
    Cons(e, rest) => Cons(e.name, ix_effect_names(rest))
  }
}

pub fn ix_fn_names(fs: List(SurfaceFn)): List(Text) {
  match fs {
    Nil => Nil
    Cons(f, rest) => Cons(f.name, ix_fn_names(rest))
  }
}

// What the expansion reads: the functions and effects it may see (the
// program's first), the types the check found, and which generics of each
// function are effect indices.
pub(open) inductive IxCx: Type {
  IxCxMk(
    fns: List(SurfaceFn),
    effects: List(SurfaceEffect),
    terms: Ordmap(TermAt, Ty),
    // The prelude's, for a program's copies of its functions.
    prelude_terms: Ordmap(TermAt, Ty),
    indexed: List(Text),
    typed: List(Text × List(Text)),
    relevant: List(Text × List(Text)),
    // The functions the prelude has, its copies too.
    in_prelude: List(Text),
    is_prelude: Bool
  ): IxCx
}

pub fn ix_type_at(cx: IxCx, start: Nat, end: Nat, occ: Option(TermOccurrence)): Option(Ty) {
  match ix_term_type(cx.terms, start, end, occ) {
    Some(t) => Some(t)
    None => ix_term_type(cx.prelude_terms, start, end, occ)
  }
}

pub fn ix_types_at(cx: IxCx, ts: List(SurfaceTerm)): List(Ty) {
  match ts {
    Nil => Nil
    Cons(t, rest) => Cons(
      ⊢ Ty from match ix_type_at(cx, t.start, t.end, t.occurrence) {
        Some(x) => x
        None => TyVar(0)
      },
      ix_types_at(cx, rest)
    )
  }
}

pub fn ix_tys_of(gs: List(Text), bound: List(Text × Ty)): List(Ty) {
  match gs {
    Nil => Nil
    Cons(g, rest) => Cons(
      ⊢ Ty from match ix_lookup_ty(bound, g) {
        Some(t) => t
        None => TyVar(0)
      },
      ix_tys_of(rest, bound)
    )
  }
}

// The type arguments a `perform` of `op` was checked with: its effect's
// written types read against the types of its arguments and of its result.
pub fn ix_perform_tys(
  cx: IxCx,
  op: Text,
  start: Nat,
  end: Nat,
  occ: Option(TermOccurrence),
  args: List(SurfaceTerm)
): Option(List(Ty)) {
  match ix_find_effect(cx.effects, op) {
    None => None
    Some(e) => ⊢ Option(List(Ty)) from match ix_type_at(cx, start, end, occ) {
      None => None
      Some(result) => {
        let bound := ix_bind_opts(e.params, ix_types_at(cx, args), e.generics, Nil)
        let all := ⊢ List(Text × Ty) from match e.result {
          None => bound
          Some(r) => ix_bind(r, result, e.generics, bound)
        }
        Some(ix_tys_of(e.generics, all))
      }
    }
  }
}

pub(open) inductive IxArgs: Type {
  IxArgsOk(args: List(SurfaceTerm)): IxArgs
  IxArgsBad(why: Text): IxArgs
}

pub fn ix_argument(t: Ty, given: List(Text × SurfaceTerm)): IxArgs {
  match t {
    TyParam(p, ^k) => ⊢ IxArgs from match ix_lookup_term(given, p) {
      Some(a) => IxArgsOk(Cons(a, Nil))
      None => IxArgsBad(index_generic_not_given_message(p))
    }
    TyVar(^v) => IxArgsBad(index_arguments_unknown_message())
    _ => ⊢ IxArgs from match ix_surface_of(t) {
      Some(a) => IxArgsOk(Cons(ix_replace(a, given), Nil))
      None => IxArgsBad(type_cannot_index_effect_message(ty_show(t)))
    }
  }
}

pub fn ix_arguments(ts: List(Ty), given: List(Text × SurfaceTerm)): IxArgs {
  match ts {
    Nil => IxArgsOk(Nil)
    Cons(t, rest) => ⊢ IxArgs from match ix_argument(t, given) {
      IxArgsBad(why) => IxArgsBad(why)
      IxArgsOk(one) => ⊢ IxArgs from match ix_arguments(rest, given) {
        IxArgsBad(why) => IxArgsBad(why)
        IxArgsOk(more) => IxArgsOk(List::append(one, more))
      }
    }
  }
}

pub fn ix_lookup_written(
  typed: List(Text),
  types: List(SurfaceTerm),
  g: Text
): Option(SurfaceTerm) {
  match typed {
    Nil => None
    Cons(x, rest) => ⊢ Option(SurfaceTerm) from match types {
      Nil => None
      Cons(t, more) => if x == g { Some(t) } else { ix_lookup_written(rest, more, g) }
    }
  }
}

// The type arguments an arm writes, in the order of the effect's generics:
// a generic of the function is the one `given`, one not written is not known.
pub fn ix_arm_arguments(
  gs: List(Text),
  typed: List(Text),
  types: List(SurfaceTerm),
  own: List(Text),
  given: List(Text × SurfaceTerm)
): IxArgs {
  match gs {
    Nil => IxArgsOk(Nil)
    Cons(g, rest) => ⊢ IxArgs from match ix_lookup_written(typed, types, g) {
      None => IxArgsBad(index_arguments_unknown_message())
      Some(t) => {
        let one := ⊢ IxArgs from match t.kind {
          SkVar(n) => if text_list_has(own, surface_name_text(n)) {
            ⊢ IxArgs from match ix_lookup_term(given, surface_name_text(n)) {
              Some(a) => IxArgsOk(Cons(a, Nil))
              None => IxArgsBad(index_generic_not_given_message(surface_name_text(n)))
            }
          } else {
            IxArgsOk(Cons(ix_replace(t, given), Nil))
          }
          _ => IxArgsOk(Cons(ix_replace(t, given), Nil))
        }
        ⊢ IxArgs from match one {
          IxArgsBad(why) => IxArgsBad(why)
          IxArgsOk(a) => ⊢ IxArgs from match ix_arm_arguments(rest, typed, types, own, given) {
            IxArgsBad(why) => IxArgsBad(why)
            IxArgsOk(more) => IxArgsOk(List::append(a, more))
          }
        }
      }
    }
  }
}

pub(open) inductive IxLabel: Type {
  IxLabelMk(name: Text, source: Text, stmt: SurfaceStmt): IxLabel
}

pub(open) inductive IxCopy: Type {
  IxCopyMk(name: Text, f: Text, args: List(SurfaceTerm)): IxCopy
}

pub(open) inductive IxState: Type {
  IxStateMk(
    labels: List(IxLabel),
    // Each copy's original.
    copies: List(Text × Text),
    queue: List(IxCopy),
    made: List(Text × SurfaceStmt),
    errors: List(TypeError)
  ): IxState
}

pub fn ix_state_empty(): IxState {
  IxState { labels: Nil, copies: Nil, queue: Nil, made: Nil, errors: Nil }
}

pub fn ix_error(st: IxState, message: Text, start: Nat, end: Nat): IxState {
  IxState {
    labels: st.labels,
    copies: st.copies,
    queue: st.queue,
    made: st.made,
    errors: Cons(TypeError { message: message, start: start, end: end }, st.errors)
  }
}

pub fn ix_has_label(ls: List(IxLabel), name: Text): Bool {
  match ls {
    Nil => false
    Cons(l, rest) => l.name == name || ix_has_label(rest, name)
  }
}

pub fn ix_has_key<A>(xs: List(Text × A), name: Text): Bool {
  match xs {
    Nil => false
    Cons(x, rest) => x.fst == name || ix_has_key(rest, name)
  }
}

pub fn ix_zip_terms(gs: List(Text), ts: List(SurfaceTerm)): List(Text × SurfaceTerm) {
  match gs {
    Nil => Nil
    Cons(g, rest) => ⊢ List(Text × SurfaceTerm) from match ts {
      Nil => Nil
      Cons(t, more) => Cons(#(g, t), ix_zip_terms(rest, more))
    }
  }
}

pub fn ix_given_rw(given: List(Text × SurfaceTerm)): IxRw {
  IxRw {
    performs: Nil,
    arms: Nil,
    calls: Nil,
    given: given,
    indexed: Nil,
    typed: Nil,
    reading: false
  }
}

// The name of the effect's instance at `args`, declared once.
pub fn ix_instance_label(
  st: IxState,
  cx: IxCx,
  eff: Text,
  args: List(SurfaceTerm)
): Text × IxState {
  let name := ix_label(eff, args)
  if ix_has_label(st.labels, name) {
    #(name, st)
  } else {
    ⊢ (Text × IxState) from match ix_find_effect(cx.effects, eff) {
      None => #(name, st)
      Some(e) => {
        let rw := ix_given_rw(ix_zip_terms(e.generics, args))
        let decl := StEffect(
          SurfaceEffect {
            visibility: e.visibility,
            name: name,
            generics: Nil,
            params: ix_rw_opts(e.params, rw),
            result: ix_rw_opt(e.result, rw),
            r#resume: e.r#resume,
            start: e.start,
            end: e.end,
            set: e.set,
          unused_generics: Nil,
          bounds: Nil,
          rows: Nil
          }
        )
        #(name, IxState {
            labels: Cons(IxLabel { name: name, source: eff, stmt: decl }, st.labels),
            copies: st.copies,
            queue: st.queue,
            made: st.made,
            errors: st.errors
          })
      }
    }
  }
}

pub fn ix_copy_name(st: IxState, cx: IxCx, f: Text, args: List(SurfaceTerm)): Text × IxState {
  let name := ix_label(f, args)
  if ix_has_key(st.copies, name) || text_list_has(cx.in_prelude, name) {
    #(name, st)
  } else {
    #(name, IxState {
        labels: st.labels,
        copies: Cons(#(name, f), st.copies),
        queue: Cons(IxCopy { name: name, f: f, args: args }, st.queue),
        made: st.made,
        errors: st.errors
      })
  }
}

pub fn ix_relevant_of(cx: IxCx, name: Text): List(Text) {
  match ix_lookup_names(cx.relevant, name) {
    Some(r) => r
    None => Nil
  }
}

pub(open) inductive IxFound: Type {
  IxFoundMk(performs: List(IxName), arms: List(IxName), calls: List(IxName), st: IxState): IxFound
}

pub fn ix_call_args(sites: List(IxSite), start: Nat, end: Nat): List(SurfaceTerm) {
  match sites {
    Nil => Nil
    Cons(s, rest) => ⊢ List(SurfaceTerm) from match s {
      IxCallAt(fs, fe, args) => if fs == start && fe == end { args } else {
        ix_call_args(rest, start, end)
      }
      _ => ix_call_args(rest, start, end)
    }
  }
}

// The index generics' types a call of `g` gives, as terms: `wanted` are
// still to read.
pub fn ix_call_index(
  cx: IxCx,
  g: Text,
  wanted: List(Text),
  inst: List(Text × Ty),
  given: List(Text × SurfaceTerm)
): IxArgs {
  match wanted {
    Nil => IxArgsOk(Nil)
    Cons(w, rest) => {
      let arg := ⊢ Option(SurfaceTerm) from match ix_lookup_ty(inst, w) {
        Some(t) => ⊢ Option(SurfaceTerm) from match t {
          TyParam(p, ^k) => ix_lookup_term(given, p)
          _ => ⊢ Option(SurfaceTerm) from match ix_surface_of(t) {
            Some(a) => Some(ix_replace(a, given))
            None => None
          }
        }
        None => None
      }
      ⊢ IxArgs from match arg {
        None => IxArgsBad(
          Text::concat_all(
            Cons(
              "`",
              Cons(
                g,
                Cons("` indexes an effect by `", Cons(w, Cons("`, which is not known here", Nil)))
              )
            )
          )
        )
        Some(a) => ⊢ IxArgs from match ix_call_index(cx, g, rest, inst, given) {
          IxArgsBad(why) => IxArgsBad(why)
          IxArgsOk(more) => IxArgsOk(Cons(a, more))
        }
      }
    }
  }
}

pub fn ix_find_sites(
  sites: List(IxSite),
  all: List(IxSite),
  cx: IxCx,
  own: List(Text),
  given: List(Text × SurfaceTerm),
  acc: IxFound
): IxFound {
  match sites {
    Nil => acc
    Cons(s, rest) => ix_find_sites(
      rest,
      all,
      cx,
      own,
      given,
      ix_find_site(s, all, cx, own, given, acc)
    )
  }
}

pub fn ix_named(acc: IxFound, which: Nat, start: Nat, end: Nat, p: Text × IxState): IxFound {
  let n := IxName { start: start, end: end, name: p.fst }
  IxFound {
    performs: if which == 0 { Cons(n, acc.performs) } else { acc.performs },
    arms: if which == 1 { Cons(n, acc.arms) } else { acc.arms },
    calls: if which == 2 { Cons(n, acc.calls) } else { acc.calls },
    st: p.snd
  }
}

pub fn ix_found_error(acc: IxFound, message: Text, start: Nat, end: Nat): IxFound {
  IxFound {
    performs: acc.performs,
    arms: acc.arms,
    calls: acc.calls,
    st: ix_error(acc.st, message, start, end)
  }
}

pub fn ix_find_site(
  s: IxSite,
  all: List(IxSite),
  cx: IxCx,
  own: List(Text),
  given: List(Text × SurfaceTerm),
  acc: IxFound
): IxFound {
  match s {
    IxPerformAt(op, start, end, occ, args) => if text_list_has(cx.indexed, op) {
      ⊢ IxFound from match ix_perform_tys(cx, op, start, end, occ, args) {
        None => ix_found_error(
          acc,
          which_effect_this_is_message(op, index_no_type_found_message()),
          start,
          end
        )
        Some(tys) => ⊢ IxFound from match ix_arguments(tys, given) {
          IxArgsBad(why) => ix_found_error(
            acc,
            which_effect_this_is_message(op, why),
            start,
            end
          )
          IxArgsOk(xs) => ix_named(acc, 0, start, end, ix_instance_label(acc.st, cx, op, xs))
        }
      }
    } else {
      acc
    }
    IxArmAt(op, binds, types, start, end) => if text_list_has(cx.indexed, op) {
      ⊢ IxFound from match ix_find_effect(cx.effects, op) {
        None => acc
        Some(e) => ⊢ IxFound from match binds {
          Cons(^b, ^more) => ix_found_error(
            acc,
            which_effect_this_is_message(op, index_no_type_found_message()),
            start,
            end
          )
          Nil => ⊢ IxFound from match ix_arm_arguments(
            e.generics,
            ix_effect_typed(e),
            types,
            own,
            given
          ) {
            IxArgsBad(why) => ix_found_error(
              acc,
              which_effect_this_is_message(op, why),
              start,
              end
            )
            IxArgsOk(xs) => ix_named(acc, 1, start, end, ix_instance_label(acc.st, cx, op, xs))
          }
        }
      }
    } else {
      acc
    }
    IxVarAt(g, start, end, occ) => ⊢ IxFound from match ix_relevant_of(cx, g) {
      Nil => acc
      Cons(w, more) => ⊢ IxFound from match ix_find_fn(cx.fns, g) {
        None => acc
        Some(f) => ⊢ IxFound from match ix_type_at(cx, start, end, occ) {
          None => acc
          Some(t) => ⊢ IxFound from match ix_call_index(
            cx,
            g,
            Cons(w, more),
            ix_instantiation(f, t),
            given
          ) {
            IxArgsBad(why) => ix_found_error(acc, why, start, end)
            IxArgsOk(xs) => ix_named(acc, 2, start, end, ix_copy_name(acc.st, cx, g, xs))
          }
        }
      }
    }
    IxRowAt(row) => ix_row_labels(row, cx, given, acc)
    _ => acc
  }
}

// Each instance a row writes is declared.
pub fn ix_row_labels(
  row: List(RowEntry),
  cx: IxCx,
  given: List(Text × SurfaceTerm),
  acc: IxFound
): IxFound {
  match row {
    Nil => acc
    Cons(entry, rest) => ix_row_labels(
      rest,
      cx,
      given,
      ⊢ IxFound from match ix_head(entry) {
        None => acc
        Some(head) => if text_list_has(cx.indexed, head) && not(ix_is_body_labelled(entry)) {
          {
            let p := ix_instance_label(acc.st, cx, head, ix_replace_each(ix_entry_args(entry), given))
            IxFound { performs: acc.performs, arms: acc.arms, calls: acc.calls, st: p.snd }
          }
        } else {
          acc
        }
      }
    )
  }
}

// Renames the performs, arms, rows and calls of `s`, with the generics in
// `given` (a copy's) and `own` those of the function it is in.
pub fn ix_rewrite(
  st: IxState,
  cx: IxCx,
  s: SurfaceStmt,
  own: List(Text),
  given: List(Text × SurfaceTerm)
): SurfaceStmt × IxState {
  let sites := ix_stmt_sites(s)
  let found := ix_find_sites(
    sites,
    sites,
    cx,
    own,
    given,
    IxFound { performs: Nil, arms: Nil, calls: Nil, st: st }
  )
  let rw := IxRw {
    performs: found.performs,
    arms: found.arms,
    calls: found.calls,
    given: given,
    indexed: cx.indexed,
    typed: cx.typed,
    reading: false
  }
  #(ix_rw_stmt(s, rw), found.st)
}

pub fn ix_stmt_own(s: SurfaceStmt): List(Text) {
  match s {
    StFn(f) => f.generics
    _ => Nil
  }
}

pub fn ix_is_relevant_fn(cx: IxCx, s: SurfaceStmt): Bool {
  match s {
    StFn(f) => ⊢ Bool from match ix_relevant_of(cx, f.name) {
      Nil => false
      Cons(^g, ^rest) => true
    }
    _ => false
  }
}

// The statements with the expansion done where they stand, and the
// functions to be copied left out (kept in the prelude).
pub fn ix_stmts(st: IxState, cx: IxCx, ss: List(SurfaceStmt)): List(SurfaceStmt) × IxState {
  ⊢ (List(SurfaceStmt) × IxState) from match ss {
    Nil => #(Nil, st)
    Cons(s, rest) => if ix_is_relevant_fn(cx, s) {
      let more := ix_stmts(st, cx, rest)
      if cx.is_prelude { #(Cons(s, more.fst), more.snd) } else { more }
    } else {
      let one := ix_rewrite(st, cx, s, ix_stmt_own(s), Nil)
      let more := ix_stmts(one.snd, cx, rest)
      #(Cons(one.fst, more.fst), more.snd)
    }
  }
}

pub fn ix_keep_generics(
  gs: List(Text),
  bounds: List(Option(Text)),
  given: List(Text × SurfaceTerm)
): List(Text) × List(Option(Text)) {
  ⊢ (List(Text) × List(Option(Text))) from match gs {
    Nil => #(Nil, bounds)
    Cons(g, rest) => {
      let b := ⊢ Option(Text) from match bounds {
        Nil => None
        Cons(x, ^more) => x
      }
      let bs := ⊢ List(Option(Text)) from match bounds {
        Nil => Nil
        Cons(^x, more) => more
      }
      let tail := ix_keep_generics(rest, bs, given)
      if ix_has_key(given, g) {
        tail
      } else {
        #(Cons(g, tail.fst), ⊢ List(Option(Text)) from match bounds {
            Nil => tail.snd
            Cons(^x, ^more) => Cons(b, tail.snd)
          })
      }
    }
  }
}

pub fn ix_keep_generic_types(
  gs: List(Text),
  types: List(SurfaceTerm),
  given: List(Text × SurfaceTerm)
): List(SurfaceTerm) {
  match gs {
    Nil => Nil
    Cons(g, rest) => ⊢ List(SurfaceTerm) from match types {
      Nil => Nil
      Cons(ty, more) => {
        let tail := ix_keep_generic_types(rest, more, given)
        if ix_has_key(given, g) { tail } else { Cons(ty, tail) }
      }
    }
  }
}

pub fn ix_instance(st: IxState, cx: IxCx, inst: IxCopy): SurfaceStmt × IxState {
  ⊢ (SurfaceStmt × IxState) from match ix_find_fn(cx.fns, inst.f) {
    None => #(StOther("copy", 0, 0), st)
    Some(f) => {
      let given := ix_zip_terms(ix_relevant_of(cx, inst.f), inst.args)
      let one := ix_rewrite(st, cx, StFn(f), f.generics, given)
      ⊢ (SurfaceStmt × IxState) from match one.fst {
        StFn(g) => {
          let kept := ix_keep_generics(g.generics, g.bounds, given)
          #(StFn(
              SurfaceFn {
                name: inst.name,
                generics: kept.fst,
                bounds: kept.snd,
                params: g.params,
                r#borrows: g.r#borrows,
                param_types: g.param_types,
                result: g.result,
                effects: g.effects,
                wheres: g.wheres,
                start: g.start,
                end: g.end,
                body: g.body,
                lends: g.lends,
                generic_types: ix_keep_generic_types(g.generics, g.generic_types, given),
                bound_starts: Nil,
                visibility: g.visibility,
                row_hole: g.row_hole,
    unused: None,
    unused_generics: Nil,
    unused_params: Nil
  }
            ), one.snd)
        }
        _ => one
      }
    }
  }
}

pub fn ix_drain(k: Nat, st: IxState, cx: IxCx): IxState {
  match k {
    Zero => ix_error(st, "the copies of the indexed functions did not settle", 0, 0)
    Succ(j) => ⊢ IxState from match st.queue {
      Nil => st
      Cons(inst, rest) => {
        let popped := IxState {
          labels: st.labels,
          copies: st.copies,
          queue: rest,
          made: st.made,
          errors: st.errors
        }
        if ix_has_key(st.made, inst.name) {
          ix_drain(j, popped, cx)
        } else if list_len(st.made) > 4096 {
          ix_error(popped, copied_for_too_many_indices_message(inst.f), 0, 0)
        } else {
          let one := ix_instance(popped, cx, inst)
          ix_drain(
            j,
            IxState {
              labels: one.snd.labels,
              copies: one.snd.copies,
              queue: one.snd.queue,
              made: Cons(#(inst.name, one.fst), one.snd.made),
              errors: one.snd.errors
            },
            cx
          )
        }
      }
    }
  }
}

pub fn ix_keep_own(xs: List(Text), own: List(Text), out: List(Text)): List(Text) {
  match xs {
    Nil => out
    Cons(x, rest) => if text_list_has(own, x) && not(text_list_has(out, x)) {
      ix_keep_own(rest, own, Cons(x, out))
    } else {
      ix_keep_own(rest, own, out)
    }
  }
}

pub fn ix_written_vars(sites: List(IxSite)): List(Text) {
  match sites {
    Nil => Nil
    Cons(s, rest) => ⊢ List(Text) from match s {
      IxVarAt(n, ^start, ^end, ^occ) => Cons(n, ix_written_vars(rest))
      _ => ix_written_vars(rest)
    }
  }
}

pub fn ix_row_indices(row: List(RowEntry), indexed: List(Text)): List(Text) {
  match row {
    Nil => Nil
    Cons(entry, rest) => ⊢ List(Text) from match ix_head(entry) {
      Some(head) => if text_list_has(indexed, head) {
        List::append(
          List::reverse(ix_terms_names(ix_entry_args(entry), Nil)),
          ix_row_indices(rest, indexed)
        )
      } else {
        ix_row_indices(rest, indexed)
      }
      None => ix_row_indices(rest, indexed)
    }
  }
}

// The names an index of the function's own performs, arms and rows mentions.
pub fn ix_direct(cx: IxCx, sites: List(IxSite)): List(Text) {
  match sites {
    Nil => Nil
    Cons(s, rest) => List::append(
      ⊢ List(Text) from match s {
        IxPerformAt(op, start, end, occ, args) => if text_list_has(cx.indexed, op) {
          ⊢ List(Text) from match ix_perform_tys(cx, op, start, end, occ, args) {
            Some(tys) => ix_params_each(tys, Nil)
            None => Nil
          }
        } else {
          Nil
        }
        IxArmAt(op, ^binds, types, ^start, ^end) => if text_list_has(cx.indexed, op) {
          ix_written_vars(ix_sites_each(types))
        } else {
          Nil
        }
        IxRowAt(row) => ix_row_indices(row, cx.indexed)
        _ => Nil
      },
      ix_direct(cx, rest)
    )
  }
}

// The names the index generics of the functions `sites` calls are given.
pub fn ix_through_calls(cx: IxCx, sites: List(IxSite)): List(Text) {
  match sites {
    Nil => Nil
    Cons(s, rest) => List::append(
      ⊢ List(Text) from match s {
        IxVarAt(g, start, end, occ) => ⊢ List(Text) from match ix_relevant_of(cx, g) {
          Nil => Nil
          Cons(w, more) => ⊢ List(Text) from match ix_find_fn(cx.fns, g) {
            None => Nil
            Some(f) => ⊢ List(Text) from match ix_type_at(cx, start, end, occ) {
              None => Nil
              Some(t) => ix_params_each(ix_tys_of(Cons(w, more), ix_instantiation(f, t)), Nil)
            }
          }
        }
        _ => Nil
      },
      ix_through_calls(cx, rest)
    )
  }
}

pub fn ix_in_order(gs: List(Text), found: List(Text)): List(Text) {
  match gs {
    Nil => Nil
    Cons(g, rest) => if text_list_has(
      found,
      g
    ) { Cons(g, ix_in_order(rest, found)) } else { ix_in_order(rest, found) }
  }
}

pub fn ix_relevance_round(cx: IxCx, fs: List(SurfaceFn)): List(Text × List(Text)) {
  match fs {
    Nil => Nil
    Cons(f, rest) => {
      let sites := ix_fn_sites(f)
      let found := ix_keep_own(
        List::append(
          ix_relevant_of(cx, f.name),
          List::append(ix_direct(cx, sites), ix_through_calls(cx, sites))
        ),
        f.generics,
        Nil
      )
      Cons(#(f.name, ix_in_order(f.generics, found)), ix_relevance_round(cx, rest))
    }
  }
}

pub fn ix_count_relevant(xs: List(Text × List(Text))): Nat {
  match xs {
    Nil => 0
    Cons(x, rest) => list_len(x.snd) + ix_count_relevant(rest)
  }
}

pub fn ix_with_relevant(cx: IxCx, relevant: List(Text × List(Text))): IxCx {
  IxCx {
    fns: cx.fns,
    effects: cx.effects,
    terms: cx.terms,
    prelude_terms: cx.prelude_terms,
    indexed: cx.indexed,
    typed: cx.typed,
    relevant: relevant,
    in_prelude: cx.in_prelude,
    is_prelude: cx.is_prelude
  }
}

// The generics of each function that an index depends on, to a fixpoint
// through the calls.
pub fn ix_relevance(k: Nat, cx: IxCx): IxCx {
  match k {
    Zero => cx
    Succ(j) => {
      let next := ix_relevance_round(cx, cx.fns)
      if ix_count_relevant(next) == ix_count_relevant(cx.relevant) {
        ix_with_relevant(cx, next)
      } else {
        ix_relevance(j, ix_with_relevant(cx, next))
      }
    }
  }
}

pub fn ix_stmt_name(s: SurfaceStmt): Text {
  match s {
    StFn(f) => f.name
    StEffect(e) => e.name
    _ => ""
  }
}

pub fn ix_insert_sorted(
  x: Text × SurfaceStmt,
  xs: List(Text × SurfaceStmt)
): List(Text × SurfaceStmt) {
  match xs {
    Nil => Cons(x, Nil)
    Cons(y, rest) => ⊢ List(Text × SurfaceStmt) from match Text::ordering(
      ix_stmt_name(x.snd),
      ix_stmt_name(y.snd)
    ) {
      Greater => Cons(y, ix_insert_sorted(x, rest))
      _ => Cons(x, xs)
    }
  }
}

pub fn ix_sort(
  xs: List(Text × SurfaceStmt),
  out: List(Text × SurfaceStmt)
): List(Text × SurfaceStmt) {
  match xs {
    Nil => out
    Cons(x, rest) => ix_sort(rest, ix_insert_sorted(x, out))
  }
}

pub fn ix_insert_after(
  ss: List(SurfaceStmt),
  after_name: Text,
  s: SurfaceStmt
): Option(List(SurfaceStmt)) {
  match ss {
    Nil => None
    Cons(x, rest) => if ix_stmt_name(x) == after_name && (ix_is_fn_or_effect(x)) {
      Some(Cons(x, Cons(s, rest)))
    } else {
      ⊢ Option(List(SurfaceStmt)) from match ix_insert_after(rest, after_name, s) {
        None => None
        Some(r) => Some(Cons(x, r))
      }
    }
  }
}

pub fn ix_is_fn_or_effect(s: SurfaceStmt): Bool {
  match s {
    StFn(^f) => true
    StEffect(^e) => true
    _ => false
  }
}

// Each statement after the declaration it was made from, or first when that
// is not here and `first`.
pub fn ix_place(
  ss: List(SurfaceStmt),
  sorted: List(Text × SurfaceStmt),
  first: Bool,
  front: List(SurfaceStmt)
): List(SurfaceStmt) {
  match sorted {
    Nil => List::append(List::reverse(front), ss)
    Cons(x, rest) => ⊢ List(SurfaceStmt) from match ix_insert_after(ss, x.fst, x.snd) {
      Some(placed) => ix_place(placed, rest, first, front)
      None => if first { ix_place(ss, rest, first, Cons(x.snd, front)) } else {
        ix_place(ss, rest, first, front)
      }
    }
  }
}

pub fn ix_lookup_text(xs: List(Text × Text), name: Text): Option(Text) {
  match xs {
    Nil => None
    Cons(x, rest) => if x.fst == name { Some(x.snd) } else { ix_lookup_text(rest, name) }
  }
}

pub fn ix_made_from(
  st: IxState,
  made: List(Text × SurfaceStmt)
): List(Text × SurfaceStmt) {
  match made {
    Nil => Nil
    Cons(m, rest) => Cons(
      #(⊢ Text from match ix_lookup_text(st.copies, m.fst) {
          Some(f) => f
          None => m.fst
        }, m.snd),
      ix_made_from(st, rest)
    )
  }
}

pub fn ix_label_decls(ls: List(IxLabel)): List(Text × SurfaceStmt) {
  match ls {
    Nil => Nil
    Cons(l, rest) => Cons(#(l.source, l.stmt), ix_label_decls(rest))
  }
}

pub fn ix_read_errors(
  row: List(RowEntry),
  typed: List(Text × List(Text)),
  start: Nat,
  end: Nat
): List(TypeError) {
  match row {
    Nil => Nil
    Cons(entry, rest) => ⊢ List(TypeError) from match ix_read_entry(entry, typed) {
      IxReadBad(why) => Cons(
        TypeError { message: why, start: start, end: end },
        ix_read_errors(rest, typed, start, end)
      )
      IxReadAs(^e) => ix_read_errors(rest, typed, start, end)
    }
  }
}

pub fn ix_rows_errors(
  sites: List(IxSite),
  typed: List(Text × List(Text)),
  start: Nat,
  end: Nat
): List(TypeError) {
  match sites {
    Nil => Nil
    Cons(s, rest) => List::append(
      ⊢ List(TypeError) from match s {
        IxRowAt(row) => ix_read_errors(row, typed, start, end)
        _ => Nil
      },
      ix_rows_errors(rest, typed, start, end)
    )
  }
}

pub fn ix_stmt_span(s: SurfaceStmt): Nat × Nat {
  ⊢ (Nat × Nat) from match s {
    StFn(f) => #(f.start, f.end)
    StEffect(e) => #(e.start, e.end)
    StStruct(d) => #(d.start, d.end)
    StEnum(d) => #(d.start, d.end)
    _ => #(0, 0)
  }
}

pub fn ix_every_errors(
  ss: List(SurfaceStmt),
  typed: List(Text × List(Text))
): List(TypeError) {
  match ss {
    Nil => Nil
    Cons(s, rest) => {
      let span := ix_stmt_span(s)
      List::append(
        ix_rows_errors(ix_stmt_sites(s), typed, span.fst, span.snd),
        ix_every_errors(rest, typed)
      )
    }
  }
}

// The rows read as the checks after the expansion do (`every_instance`):
// `∀ A. res(A)` is `res`; and what a row cannot mean.
pub fn ix_every_instance(
  ss: List(SurfaceStmt),
  typed: List(Text × List(Text))
): List(SurfaceStmt) × List(TypeError) {
  let rw := IxRw {
    performs: Nil,
    arms: Nil,
    calls: Nil,
    given: Nil,
    indexed: Nil,
    typed: typed,
    reading: true
  }
  #(ix_rw_stmts(ss, rw), ix_every_errors(ss, typed))
}

pub fn ix_not_in(xs: List(Text), ys: List(Text)): List(Text) {
  match xs {
    Nil => Nil
    Cons(x, rest) => if text_list_has(
      ys,
      x
    ) { ix_not_in(rest, ys) } else { Cons(x, ix_not_in(rest, ys)) }
  }
}

pub fn ix_union(xs: List(Text), ys: List(Text)): List(Text) {
  List::append(xs, ix_not_in(ys, xs))
}

// `stmts` with their indexed effects expanded, checked as `terms` say (and
// a prelude function copied into them as `prelude_terms` say), and what the
// expansion could not do.
pub fn ix_expand(
  stmts: List(SurfaceStmt),
  prelude: List(SurfaceStmt),
  terms: Ordmap(TermAt, Ty),
  prelude_terms: Ordmap(TermAt, Ty),
  is_prelude: Bool
): List(SurfaceStmt) × List(TypeError) {
  let own_fns := ix_functions(stmts)
  let lib_fns := if is_prelude { Nil } else { ix_functions(prelude) }
  let lib_effects := if is_prelude { Nil } else { ix_effects_in(prelude, Nil) }
  let indexed := if is_prelude { ix_indexed(stmts) } else {
    // An effect the program declares hides the prelude's of that name.
    ix_union(ix_indexed(stmts), ix_not_in(ix_indexed(prelude), ix_effect_names(ix_effects_in(stmts, Nil))))
  }
  let base := IxCx {
    fns: List::append(own_fns, lib_fns),
    effects: List::append(ix_effects_in(stmts, Nil), lib_effects),
    terms: terms,
    prelude_terms: prelude_terms,
    indexed: indexed,
    typed: ix_typed_generics(List::append(prelude, stmts)),
    relevant: Nil,
    in_prelude: ix_not_in(ix_fn_names(lib_fns), ix_fn_names(own_fns)),
    is_prelude: is_prelude
  }
  let cx := ix_relevance(list_len(base.fns) + 2, base)
  let done := ix_stmts(ix_state_empty(), cx, stmts)
  let st := ix_drain(5000, done.snd, cx)
  let sorted := ix_sort(List::append(ix_label_decls(st.labels), ix_made_from(st, st.made)), Nil)
  #(ix_place(done.fst, sorted, true, Nil), List::reverse(st.errors))
}

// The prelude, its rows read and its indexed effects expanded against
// itself, and the types its check found before the expansion. The check of
// the whole prelude still finds errors in parts the expansion does not read
// (classes the self-hosted checker does not resolve yet), so it expands on
// the types that check found rather than stopping as `types/indices.rs` does.
pub(open) inductive IxPrelude: Type {
  IxPreludeMk(stmts: List(SurfaceStmt), terms: Ordmap(TermAt, Ty)): IxPrelude
}

pub fn ix_prelude(prelude: List(SurfaceStmt)): IxPrelude {
  let read := ix_every_instance(prelude, ix_typed_generics(prelude))
  ⊢ IxPrelude from match ix_indexed(read.fst) {
    Nil => IxPrelude { stmts: read.fst, terms: Ordmap::empty() }
    Cons(^e, ^more) => {
      let report := types_check(Nil, read.fst, Nil)
      IxPrelude {
        stmts: ix_expand(read.fst, read.fst, report.terms, report.terms, true).fst,
        terms: report.terms
      }
    }
  }
}

// For each top-level function, its generics that a row it writes uses as an
// index (`catch`'s `E`): the expansion, not the types, determines them
// (`index_generics` of `types/indices.rs`).
pub fn ix_row_index_names(row: List(RowEntry), indexed: List(Text), gs: List(Text), out: List(Text)): List(Text) {
  match row {
    Nil => out
    Cons(entry, rest) => ⊢ List(Text) from match ix_head(entry) {
      Some(head) => if text_list_has(indexed, head) {
        ix_row_index_names(
          rest,
          indexed,
          gs,
          ix_generic_names(List::reverse(ix_terms_names(ix_entry_args(entry), Nil)), gs, out)
        )
      } else {
        ix_row_index_names(rest, indexed, gs, out)
      }
      None => ix_row_index_names(rest, indexed, gs, out)
    }
  }
}

pub fn ix_generic_names(names: List(Text), gs: List(Text), out: List(Text)): List(Text) {
  match names {
    Nil => out
    Cons(n, rest) => if text_list_has(gs, n) && not(text_list_has(out, n)) {
      ix_generic_names(rest, gs, Cons(n, out))
    } else {
      ix_generic_names(rest, gs, out)
    }
  }
}

pub fn ix_sites_index_names(sites: List(IxSite), indexed: List(Text), gs: List(Text), out: List(Text)): List(Text) {
  match sites {
    Nil => out
    Cons(site, rest) => ⊢ List(Text) from match site {
      IxRowAt(row) => ix_sites_index_names(rest, indexed, gs, ix_row_index_names(row, indexed, gs, out))
      _ => ix_sites_index_names(rest, indexed, gs, out)
    }
  }
}

// The names of the variables a term mentions.
pub fn ix_site_vars(sites: List(IxSite), out: List(Text)): List(Text) {
  match sites {
    Nil => out
    Cons(site, rest) => ⊢ List(Text) from match site {
      IxVarAt(name, ^start, ^end, ^occ) => ix_site_vars(rest, Cons(name, out))
      _ => ix_site_vars(rest, out)
    }
  }
}

pub fn ix_find_data(ds: List(SurfaceData), name: Text): Option(SurfaceData) {
  match ds {
    Nil => None
    Cons(d, rest) => if d.name == name { Some(d) } else { ix_find_data(rest, name) }
  }
}

pub fn ix_datas_in(ss: List(SurfaceStmt), out: List(SurfaceData)): List(SurfaceData) {
  match ss {
    Nil => out
    Cons(s, rest) => ⊢ List(SurfaceData) from match s {
      StStruct(d) => ix_datas_in(rest, Cons(d, out))
      _ => ix_datas_in(rest, out)
    }
  }
}

// The function's generics that the arguments of a data type give to the
// data's generics its fields' rows use as indices.
pub fn ix_data_args_index_names(
  dgs: List(Text),
  args: List(SurfaceTerm),
  index: List(Text),
  gs: List(Text),
  out: List(Text)
): List(Text) {
  match dgs {
    Nil => out
    Cons(g, grest) => ⊢ List(Text) from match args {
      Nil => out
      Cons(a, arest) => ix_data_args_index_names(
        grest,
        arest,
        index,
        gs,
        if text_list_has(index, g) { ix_generic_names(ix_site_vars(ix_sites(a), Nil), gs, out) } else { out }
      )
    }
  }
}

// A parameter whose type is a data type with a field whose row writes an
// index (`options: ActionOptions(A, B, E, I, R)`, whose `run` performs
// `resource_wait(R, E)`) writes that row too (`field_rows` of `types/indices.rs`).
pub fn ix_param_index_names(
  ty: SurfaceTerm,
  datas: List(SurfaceData),
  indexed: List(Text),
  gs: List(Text),
  out: List(Text)
): List(Text) {
  match ty {
    SurfaceTermIndexedMk(k, ^start, ^end, ^occurrence) => ⊢ List(Text) from match k {
      SkApp(f, args) => ⊢ List(Text) from match f {
        SurfaceTermIndexedMk(fk, ^fs, ^fe, ^fo) => ⊢ List(Text) from match fk {
          SkVar(name) => ⊢ List(Text) from match ix_find_data(datas, surface_name_text(name)) {
            None => out
            Some(d) => if List::length(d.generics) == List::length(args) {
              ix_data_args_index_names(
                d.generics,
                args,
                ix_sites_index_names(ix_ctors_sites(d.constructors), indexed, d.generics, Nil),
                gs,
                out
              )
            } else {
              out
            }
          }
          _ => out
        }
      }
      _ => out
    }
  }
}

pub fn ix_params_index_names(
  ts: List(Option(SurfaceTerm)),
  datas: List(SurfaceData),
  indexed: List(Text),
  gs: List(Text),
  out: List(Text)
): List(Text) {
  match ts {
    Nil => out
    Cons(t, rest) => ix_params_index_names(
      rest,
      datas,
      indexed,
      gs,
      ⊢ List(Text) from match t {
        None => out
        Some(ty) => ix_param_index_names(ty, datas, indexed, gs, out)
      }
    )
  }
}

mutual {
  pub fn ix_index_generics_in(
    ss: List(SurfaceStmt),
    datas: List(SurfaceData),
    indexed: List(Text),
    out: List(Text × List(Text))
  ): List(Text × List(Text)) {
    match ss {
      Nil => out
      Cons(s, rest) => ix_index_generics_in(rest, datas, indexed, ix_index_generics_stmt(s, datas, indexed, out))
    }
  }

  pub fn ix_index_generics_stmt(
    s: SurfaceStmt,
    datas: List(SurfaceData),
    indexed: List(Text),
    out: List(Text × List(Text))
  ): List(Text × List(Text)) {
    match s {
      StFn(f) => ⊢ List(Text × List(Text)) from match ix_params_index_names(
        f.param_types,
        datas,
        indexed,
        f.generics,
        ix_sites_index_names(ix_fn_sites(f), indexed, f.generics, Nil)
      ) {
        Nil => out
        Cons(g, more) => Cons(#(f.name, Cons(g, more)), out)
      }
      StMutual(items, ^start, ^end) => ix_index_generics_in(items, datas, indexed, out)
      _ => out
    }
  }
}

// The program's functions first: they stand over the prelude's of the same name.
pub fn ix_index_generics(prelude: List(SurfaceStmt), program: List(SurfaceStmt)): List(Text × List(Text)) {
  List::append(
    ix_index_generics_in(program, ix_datas_in(program, Nil), ix_indexed(program), Nil),
    ix_index_generics_in(prelude, ix_datas_in(prelude, Nil), ix_indexed(prelude), Nil)
  )
}

pub fn ix_drop_names(gs: List(Text), fs: List(Text)): List(Text) {
  match gs {
    Nil => Nil
    Cons(g, rest) => if text_list_has(fs, g) {
      ix_drop_names(rest, fs)
    } else {
      Cons(g, ix_drop_names(rest, fs))
    }
  }
}

pub fn ix_determined_open(gs: List(Text), fixed: Option(List(Text))): List(Text) {
  match fixed {
    None => gs
    Some(fs) => ix_drop_names(gs, fs)
  }
}

mutual {
  // The variables a resolved type still holds.
  pub fn ix_vars_in(t: Ty, out: List(Nat)): List(Nat) {
    match t {
      TyVar(v) => Cons(v, out)
      TyFn(ps, r, ^k) => ix_vars_in(r, ix_vars_each(ps, out))
      TyUnion(ts) => ix_vars_each(ts, out)
      TyProduct(ts) => ix_vars_each(ts, out)
      TyNamed(^n, ts) => ix_vars_each(ts, out)
      TyTagged(^tags, x) => ix_vars_in(x, out)
      TyInfo(x) => ix_vars_in(x, out)
      TyBorrow(x, ^m) => ix_vars_in(x, out)
      TyPoly(^gs, x) => ix_vars_in(x, out)
      TyApp(h, x) => ix_vars_in(x, ix_vars_in(h, out))
      _ => out
    }
  }

  pub fn ix_vars_each(ts: List(Ty), out: List(Nat)): List(Nat) {
    match ts {
      Nil => out
      Cons(t, rest) => ix_vars_each(rest, ix_vars_in(t, out))
    }
  }
}

pub fn ix_has_var(vs: List(Nat), v: Nat): Bool {
  match vs {
    Nil => false
    Cons(w, rest) => w == v || ix_has_var(rest, v)
  }
}

// Whether a variable of `vs` is not among `fixed`.
pub fn ix_any_open(vs: List(Nat), fixed: List(Nat)): Bool {
  match vs {
    Nil => false
    Cons(v, rest) => if ix_has_var(fixed, v) { ix_any_open(rest, fixed) } else { true }
  }
}

pub fn ix_index_var(t: Ty, out: List(Nat)): List(Nat) {
  match t {
    TyVar(v) => Cons(v, out)
    _ => out
  }
}

// The variables the index generics `fs` of one use stand for.
pub fn ix_use_index_vars(gs: List(Text × Ty), fs: List(Text), out: List(Nat)): List(Nat) {
  match gs {
    Nil => out
    Cons(g, rest) => if text_list_has(fs, g.fst) {
      ix_use_index_vars(rest, fs, ix_index_var(g.snd, out))
    } else {
      ix_use_index_vars(rest, fs, out)
    }
  }
}

// A generic that indexes an effect (`catch`'s `E`) is given by the expansion
// from what the argument performs, so a type that waits only for it (the
// `Result(T, E)` such a call returns, passed on to another generic function)
// is determined there too.
pub fn ix_index_vars(us: List(TyUse), index: List(Text × List(Text)), out: List(Nat)): List(Nat) {
  match us {
    Nil => out
    Cons(u, rest) => ⊢ List(Nat) from match ix_lookup_names(index, u.name) {
      None => ix_index_vars(rest, index, out)
      Some(fs) => ix_index_vars(rest, index, ix_use_index_vars(u.generics, fs, out))
    }
  }
}

// The generics of a use whose types still have variables the expansion does
// not give.
pub fn ix_open_generics(gs: List(Text × Ty), fixed: List(Nat)): List(Text) {
  match gs {
    Nil => Nil
    Cons(g, rest) => if ix_any_open(ix_vars_in(g.snd, Nil), fixed) {
      Cons(g.fst, ix_open_generics(rest, fixed))
    } else {
      ix_open_generics(rest, fixed)
    }
  }
}

pub fn ix_undetermined_errors(us: List(TyUse), index: List(Text × List(Text)), fixed: List(Nat)): List(TypeError) {
  match us {
    Nil => Nil
    Cons(u, rest) => ⊢ List(TypeError) from match ix_determined_open(ix_open_generics(u.generics, fixed), ix_lookup_names(index, u.name)) {
      Nil => ix_undetermined_errors(rest, index, fixed)
      Cons(g, more) => Cons(
        TypeError {
          message: type_not_determined_message(Cons(g, more), u.name),
          start: u.start,
          end: u.end
        },
        ix_undetermined_errors(rest, index, fixed)
      )
    }
  }
}

// The report with the uses whose type arguments nothing determines reported,
// after everything else the checker found (`finish` of `types.rs`).
pub fn ix_report_determined(r: TypeReport, prelude: List(SurfaceStmt), program: List(SurfaceStmt)): TypeReport {
  let index := ix_index_generics(prelude, program)
  TypeReport {
    errors: List::append(r.errors, ix_undetermined_errors(r.uses, index, ix_index_vars(r.uses, index, Nil))),
    widths: r.widths,
    lets: r.lets,
    locals: r.locals,
    terms: r.terms,
    datas: r.datas,
    quants: r.quants,
    undetermined: r.undetermined,
    uses: r.uses,
    lending: r.lending,
    lending_mut: r.lending_mut,
    op_sigs: r.op_sigs
  }
}
