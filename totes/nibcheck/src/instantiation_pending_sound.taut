import "instantiation_frame.taut"
import "inference_base.taut"
import "finish_frame.taut"
import std::Map
import std::Row
import std::Text
import "checker.taut"
import "datas_frame.taut"
import "ty.taut"
import "types_decl.taut"
import "unify_sound.taut"

pub fn instantiated_pending(
  r#class: Text,
  ty: Ty,
  what: Text,
  span: TySpan,
  assume: List(Pair(Text, Text))
): TyPending {
  TyPending {r#class: r#class, ty: ty, what: what, assume: assume, start: span.start, end: span.end}
}
pub def PendingState(
  c: Checker,
  next: Checker
): Prop := And(
  Sub(TyPending, finish_pending_items(c), finish_pending_items(next)),
  inference_assume(next) = inference_assume(c)
)
pub def PendingFrame<A: Type>(c: Checker, m: Mut1(A, Checker)): Prop := PendingState(c, ck_st(m))
pub theorem pending_state_refl(
  c: Checker
): PendingState(c, c) { AndIntro(item => member => member, Refl) }
pub theorem pending_state_trans(
  c: Checker,
  next: Checker,
  last: Checker,
  first: PendingState(c, next),
  tail: PendingState(next, last)
): PendingState(c, last) {
  AndIntro(
    item => member => And::left(tail)(item, And::left(first)(item, member)),
    Eq::trans(And::right(tail), And::right(first))
  )
}
pub theorem pending_frame_bind<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  first: PendingFrame(c, m),
  tail: ∀ value: A. ∀ next: Checker. PendingFrame(next, k(value, next))
): PendingFrame(c, frame_bind(A, B, k, m)) {
  match m: PendingFrame(c, frame_bind(A, B, k, m)) {
    mut1(value, next) => pending_state_trans(
      c,
      next,
      ck_st(k(value, next)),
      first,
      tail(value, next)
    )
  }
}
pub theorem pending_frame_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  h: PendingFrame(c, m)
): PendingFrame(c, ck_rewrap1(m)) {
  Eq::subst((result: Mut1(A, Checker)) => PendingFrame(c, result), Eq::sym(ck_rewrap1_id(m)), h)
}
pub theorem ck_pend_retains(
  c: Checker,
  r#class: Text,
  ty: Ty,
  what: Text,
  span: TySpan
): PendingFrame(c, ck_pend(c, r#class, ty, what, span)) {
  AndIntro(
    item => member => MemThere(
      instantiated_pending(r#class, ty, what, span, inference_assume(c)),
      finish_pending_items(c),
      member
    ),
    Refl
  )
}
pub theorem ck_pend_records(
  c: Checker,
  r#class: Text,
  ty: Ty,
  what: Text,
  span: TySpan
): Mem(
  TyPending,
  instantiated_pending(r#class, ty, what, span, inference_assume(c)),
  finish_pending_items(ck_st(ck_pend(c, r#class, ty, what, span)))
) {
  MemHere(
    TyPending,
    instantiated_pending(r#class, ty, what, span, inference_assume(c)),
    finish_pending_items(c)
  )
}

pub theorem instantiation_pred_retains(
  c: Checker,
  p: Pair(Text, Text),
  what: Text,
  span: TySpan,
  found: Option(Ty)
): PendingFrame(c, instantiation_pred(c, p, what, span, found)) {
  match found: PendingFrame(c, instantiation_pred(c, p, what, span, found)) {
    None => pending_state_refl(c)
    Some(t) => pending_frame_rewrap(
      c,
      ck_pend(c, instantiation_constraint(p), t, what, span),
      ck_pend_retains(c, instantiation_constraint(p), t, what, span)
    )
  }
}

pub theorem instantiation_preds_cons_retains(
  p: Pair(Text, Text),
  rest: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  ih: ∀ next: Checker. PendingFrame(next, ck_pend_preds(rest, next, map, what, span))
): PendingFrame(c, instantiation_preds_cons(p, rest, c, map, what, span)) {
  pending_frame_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_pend_preds(rest, c1, map, what, span)),
    instantiation_pred(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    instantiation_pred_retains(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    ignored => c1 => pending_frame_rewrap(c1, ck_pend_preds(rest, c1, map, what, span), ih(c1))
  )
}

pub theorem ck_pend_preds_retains(
  ps: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): PendingFrame(c, ck_pend_preds(ps, c, map, what, span)) {
  match ps: PendingFrame(c, ck_pend_preds(ps, c, map, what, span)) {
    Nil => pending_state_refl(c)
    Cons(p, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => PendingFrame(c, z),
      Eq::sym(instantiation_preds_cons_unf(p, rest, c, map, what, span)),
      instantiation_preds_cons_retains(
        p,
        rest,
        c,
        map,
        what,
        span,
        next => ck_pend_preds_retains(rest, next, map, what, span)
      )
    )
  }
}

pub def PredicatesPresent(
  c: Checker,
  ps: List(Pair(Text, Text)),
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  m: Mut1(Unit, Checker)
): Prop :=
∀ p: Pair(
  Text,
  Text
). ∀ ty: Ty. ∀ member: Mem(
  Pair(Text, Text),
  p,
  ps
). ∀ found: Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text) = Some(ty). Mem(
  TyPending,
  instantiated_pending(instantiation_constraint(p), ty, what, span, inference_assume(c)),
  finish_pending_items(ck_st(m))
)

pub theorem instantiation_pred_records(
  c: Checker,
  p: Pair(Text, Text),
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  ty: Ty,
  found: Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text) = Some(ty)
): Mem(
  TyPending,
  instantiated_pending(instantiation_constraint(p), ty, what, span, inference_assume(c)),
  finish_pending_items(
    ck_st(
      instantiation_pred(
        c,
        p,
        what,
        span,
        Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
      )
    )
  )
) {
  Eq::subst(
    (choice: Option(Ty)) => Mem(
      TyPending,
      instantiated_pending(instantiation_constraint(p), ty, what, span, inference_assume(c)),
      finish_pending_items(ck_st(instantiation_pred(c, p, what, span, choice)))
    ),
    Eq::sym(found),
    Eq::subst(
      (m: Mut1(Unit, Checker)) => Mem(
        TyPending,
        instantiated_pending(instantiation_constraint(p), ty, what, span, inference_assume(c)),
        finish_pending_items(ck_st(m))
      ),
      Eq::sym(ck_rewrap1_id(ck_pend(c, instantiation_constraint(p), ty, what, span))),
      ck_pend_records(c, instantiation_constraint(p), ty, what, span)
    )
  )
}
pub def PredicateHeadPresent(
  c: Checker,
  p: Pair(Text, Text),
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  m: Mut1(Unit, Checker)
): Prop := ∀ ty: Ty. ∀ found: Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text) = Some(ty). Mem(
  TyPending,
  instantiated_pending(instantiation_constraint(p), ty, what, span, inference_assume(c)),
  finish_pending_items(ck_st(m))
)
pub def PredicatesTailIH(
  rest: List(Pair(Text, Text)),
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): Prop := ∀ next: Checker. PredicatesPresent(
  next,
  rest,
  map,
  what,
  span,
  ck_pend_preds(rest, next, map, what, span)
)
pub fn pending_after_preds(
  rest: List(Pair(Text, Text)),
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  m: Mut1(Unit, Checker)
): Mut1(Unit, Checker) {
  match m: Mut1(
    Unit,
    Checker
  ) { mut1(ignored, next) => ck_rewrap1(ck_pend_preds(rest, next, map, what, span)) }
}
pub theorem pending_after_pred_member(
  c: Checker,
  p: Pair(Text, Text),
  rest: List(Pair(Text, Text)),
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  m: Mut1(Unit, Checker),
  retained: PendingFrame(c, m),
  head: PredicateHeadPresent(c, p, map, what, span, m),
  ih: PredicatesTailIH(rest, map, what, span),
  entry: Pair(Text, Text),
  ty: Ty,
  member: Mem(Pair(Text, Text), entry, Cons(p, rest)),
  found: Ordmap::get(map, instantiation_parameter(entry), Ordmap::compare_text) = Some(ty)
): Mem(
  TyPending,
  instantiated_pending(instantiation_constraint(entry), ty, what, span, inference_assume(c)),
  finish_pending_items(ck_st(pending_after_preds(rest, map, what, span, m)))
) {
  match m: Mem(
    TyPending,
    instantiated_pending(instantiation_constraint(entry), ty, what, span, inference_assume(c)),
    finish_pending_items(ck_st(pending_after_preds(rest, map, what, span, m)))
  ) {
    mut1(ignored, next) => {
      let h: Mem(
        TyPending,
        instantiated_pending(instantiation_constraint(entry), ty, what, span, inference_assume(c)),
        finish_pending_items(ck_st(ck_pend_preds(rest, next, map, what, span)))
      ) := match member: Mem(
        TyPending,
        instantiated_pending(instantiation_constraint(entry), ty, what, span, inference_assume(c)),
        finish_pending_items(ck_st(ck_pend_preds(rest, next, map, what, span)))
      ) {
        MemHere(more) => And::left(
          ck_pend_preds_retains(rest, next, map, what, span)
        )(
          instantiated_pending(
            instantiation_constraint(entry),
            ty,
            what,
            span,
            inference_assume(c)
          ),
          head(ty, found)
        )
        MemThere(first, more, inside) => Eq::subst(
          (assume: List(Pair(Text, Text))) => Mem(
            TyPending,
            instantiated_pending(instantiation_constraint(entry), ty, what, span, assume),
            finish_pending_items(ck_st(ck_pend_preds(rest, next, map, what, span)))
          ),
          And::right(retained),
          ih(next, entry, ty, inside, found)
        )
      }
      Eq::subst(
        (result: Mut1(Unit, Checker)) => Mem(
          TyPending,
          instantiated_pending(
            instantiation_constraint(entry),
            ty,
            what,
            span,
            inference_assume(c)
          ),
          finish_pending_items(ck_st(result))
        ),
        Eq::sym(ck_rewrap1_id(ck_pend_preds(rest, next, map, what, span))),
        h
      )
    }
  }
}
pub theorem ck_pend_preds_records(
  ps: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): PredicatesPresent(c, ps, map, what, span, ck_pend_preds(ps, c, map, what, span)) {
  match ps: PredicatesPresent(c, ps, map, what, span, ck_pend_preds(ps, c, map, what, span)) {
    Nil => entry => ty => member => found => match member: Mem(
      TyPending,
      instantiated_pending(instantiation_constraint(entry), ty, what, span, inference_assume(c)),
      finish_pending_items(ck_st(ck_pend_preds(Nil, c, map, what, span)))
    ) {
    }
    Cons(p, rest) => entry => ty => member => found => Eq::subst(
      (m: Mut1(Unit, Checker)) => Mem(
        TyPending,
        instantiated_pending(instantiation_constraint(entry), ty, what, span, inference_assume(c)),
        finish_pending_items(ck_st(m))
      ),
      Eq::sym(instantiation_preds_cons_unf(p, rest, c, map, what, span)),
      pending_after_pred_member(
        c,
        p,
        rest,
        map,
        what,
        span,
        instantiation_pred(
          c,
          p,
          what,
          span,
          Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
        ),
        instantiation_pred_retains(
          c,
          p,
          what,
          span,
          Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
        ),
        value => present => instantiation_pred_records(c, p, map, what, span, value, present),
        next => ck_pend_preds_records(rest, next, map, what, span),
        entry,
        ty,
        member,
        found
      )
    )
  }
}
