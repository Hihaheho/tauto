    SkPerform(eff, args) => tracked_run_bind(
      List(Ty),
      Ty,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_perform_of(c1, eff, types, args, span)),
      ck_infer_each_in(j, c, args, env),
      inference_use_ck_infer_each_in_tracked(j, c, args, env, ordered, ih),
      types => c1 => o_c1 => tracked_run_rewrap(
