      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBorrow(pat_mutable, pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
