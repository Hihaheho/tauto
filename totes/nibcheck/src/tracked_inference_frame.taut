  )
}
pub theorem access_join_frame_tracked(
  c: Checker,
  b: Ty,
  result: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_join(c, b, result)) {
  match result: TrackedRunFrame(c, access_join(c, b, result)) {
    None => tracked_run_return(c, b, ordered)
    Some(r) => tracked_run_rewrap(c, ck_join(c, r, b), ck_join_run_frame_tracked(c, r, b, ordered))
  }
}

pub theorem ck_join_opt_run_frame_tracked(
  c: Checker,
  result: Option(Ty),
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  ck_join_opt(c, result, b)
) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_join_unf(c, result, b)),
    access_join_frame_tracked(c, b, result, ordered)
  )
}

pub theorem inference_use_ck_match_arms_in_tracked(
  k: Nat,
  c: Checker,
  arms: List(SurfaceArm),
  s: Ty,
  env: List(Local),
  result: Option(Ty),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_match_arms_in(k, c, arms, s, env, result)
) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, arms, s, env, result, ordered)
}

pub theorem inference_match_arms_frame_tracked(
  j: Nat,
  c: Checker,
  s: Ty,
  env: List(Local),
  result: Option(Ty),
  arms: List(SurfaceArm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_match_arms(j, c, s, env, result, arms)) {
  match arms: TrackedRunFrame(c, inference_match_arms(j, c, s, env, result, arms)) {
    Nil => tracked_run_return(c, result, ordered)
    Cons(arm, rest) => inference_bind_scope_frame_tracked(
      Unit,
      Option(Ty),
      c,
      (matched: Unit, c1: Checker, inner: Scope) => frame_bind(
        Unit,
        Option(Ty),
        (guarded: Unit, c2: Checker) => frame_bind(
          Ty,
          Option(Ty),
          (b: Ty, c3: Checker) => frame_bind(
            Ty,
            Option(Ty),
            (joined: Ty, c4: Checker) => ck_rewrap1(
              ck_match_arms_in(j, c4, rest, s, env, Some(joined))
            ),
            ck_join_opt(c3, result, b)
          ),
          ck_infer_in(j, c2, inference_arm_body(arm), inference_scope_items(inner))
        ),
        ck_guard_in(j, c1, inference_arm_guard(arm), inference_scope_items(inner))
      ),
      ck_pattern(
        c,
        inference_arm_pattern(arm),
        s,
        ScopeMk(env),
        span_of(inference_arm_body(arm)),
        handle_body_start(inference_arm_body(arm))
      ),
      ck_pattern_frame_tracked(
        c,
        inference_arm_pattern(arm),
        s,
        ScopeMk(env),
        span_of(inference_arm_body(arm)),
        handle_body_start(inference_arm_body(arm)),
        ordered
      ),
      matched => c1 => inner => o_c1 => tracked_run_bind(
        Unit,
        Option(Ty),
        c1,
        (guarded: Unit, c2: Checker) => frame_bind(
          Ty,
          Option(Ty),
          (b: Ty, c3: Checker) => frame_bind(
            Ty,
            Option(Ty),
            (joined: Ty, c4: Checker) => ck_rewrap1(
              ck_match_arms_in(j, c4, rest, s, env, Some(joined))
            ),
            ck_join_opt(c3, result, b)
          ),
          ck_infer_in(j, c2, inference_arm_body(arm), inference_scope_items(inner))
        ),
        ck_guard_in(j, c1, inference_arm_guard(arm), inference_scope_items(inner)),
        inference_use_ck_guard_in_tracked(
          j,
          c1,
          inference_arm_guard(arm),
          inference_scope_items(inner),
          o_c1,
          ih
        ),
        guarded => c2 => o_c2 => tracked_run_bind(
          Ty,
          Option(Ty),
          c2,
          (b: Ty, c3: Checker) => frame_bind(
            Ty,
            Option(Ty),
            (joined: Ty, c4: Checker) => ck_rewrap1(
              ck_match_arms_in(j, c4, rest, s, env, Some(joined))
            ),
            ck_join_opt(c3, result, b)
          ),
          ck_infer_in(j, c2, inference_arm_body(arm), inference_scope_items(inner)),
          inference_use_ck_infer_in_tracked(
            j,
            c2,
            inference_arm_body(arm),
            inference_scope_items(inner),
            o_c2,
            ih
          ),
          b => c3 => o_c3 => tracked_run_bind(
            Ty,
            Option(Ty),
            c3,
            (joined: Ty, c4: Checker) => ck_rewrap1(
              ck_match_arms_in(j, c4, rest, s, env, Some(joined))
            ),
            ck_join_opt(c3, result, b),
            ck_join_opt_run_frame_tracked(c3, result, b, o_c3),
            joined => c4 => o_c4 => tracked_run_rewrap(
              c4,
              ck_match_arms_in(j, c4, rest, s, env, Some(joined)),
              inference_use_ck_match_arms_in_tracked(j, c4, rest, s, env, Some(joined), o_c4, ih)
            )
          )
        )
      )
    )
  }
}

pub theorem inference_step_ck_match_arms_in_frame_tracked(
  j: Nat,
  c: Checker,
  arms: List(SurfaceArm),
  s: Ty,
  env: List(Local),
  result: Option(Ty),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_match_arms_in(j, c, arms, s, env, result)
) { inference_match_arms_frame_tracked(j, c, s, env, result, arms, ih, ordered) }

pub theorem inference_successor_ck_match_arms_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_match_arms_in_tracked(
  Succ(j)
) {
  c => arms => s => env => result => ordered => Eq::subst(
    (z: Mut1(Option(Ty), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_match_arms_in(j, c, arms, s, env, result)),
    inference_step_ck_match_arms_in_frame_tracked(j, c, arms, s, env, result, ih, ordered)
  )
}
pub theorem inference_match_answer_frame_tracked(
  j: Nat,
  c: Checker,
  result: Option(Ty),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_match_answer(j, c, result)) {
  match result: TrackedRunFrame(c, inference_match_answer(j, c, result)) {
    None => tracked_run_return(c, TyNever, ordered)
    Some(t) => tracked_run_return(c, t, ordered)
  }
}

pub theorem inference_step_ck_match_expr_in_frame_tracked(
  j: Nat,
  c: Checker,
  scrutinee: SurfaceTerm,
  arms: List(SurfaceArm),
  env: List(Local),
  span: TySpan,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_match_expr_in(j, c, scrutinee, arms, env, span)
) {
  tracked_run_bind(
    Ty,
    Ty,
    c,
    (s: Ty, c1: Checker) => frame_bind(
      Option(Ty),
      Ty,
      (result: Option(Ty), c2: Checker) => frame_bind(
        Unit,
        Ty,
        (checked: Unit, c3: Checker) => inference_match_answer(j, c3, result),
        ck_check_covers(c2, s, arms, span)
      ),
      ck_match_arms_in(j, c1, arms, s, env, None)
    ),
    ck_infer_in(j, c, scrutinee, env),
    inference_use_ck_infer_in_tracked(j, c, scrutinee, env, ordered, ih),
    s => c1 => o_c1 => tracked_run_bind(
      Option(Ty),
      Ty,
      c1,
      (result: Option(Ty), c2: Checker) => frame_bind(
        Unit,
        Ty,
        (checked: Unit, c3: Checker) => inference_match_answer(j, c3, result),
        ck_check_covers(c2, s, arms, span)
      ),
      ck_match_arms_in(j, c1, arms, s, env, None),
      inference_use_ck_match_arms_in_tracked(j, c1, arms, s, env, None, o_c1, ih),
      result => c2 => o_c2 => tracked_run_bind(
        Unit,
        Ty,
        c2,
        (checked: Unit, c3: Checker) => inference_match_answer(j, c3, result),
        ck_check_covers(c2, s, arms, span),
        tracked_run_read(
          c2,
          ck_check_covers(c2, s, arms, span),
          ck_check_covers_frame(c2, s, arms, span),
          ck_check_covers_frame_tracked(c2, s, arms, span),
          o_c2
        ),
        checked => c3 => o_c3 => inference_match_answer_frame_tracked(j, c3, result, ih, o_c3)
      )
    )
  )
}

pub theorem inference_successor_ck_match_expr_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_match_expr_in_tracked(
  Succ(j)
) {
  c => scrutinee => arms => env => span => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_match_expr_in(j, c, scrutinee, arms, env, span)),
