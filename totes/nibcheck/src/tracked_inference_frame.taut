      inference_use_ck_infer_in_tracked(j, c, g, env, ordered, ih),
      gt => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_expect(c1, gt, TyBool, span_of(g), "a guard"),
        ck_expect_run_frame_tracked(c1, gt, TyBool, span_of(g), "a guard", o_c1)
      )
    )
  }
}

