pub theorem leaf_stmt_ty_frame_tracked(
  c: Checker,
  v: Ty,
  value: SurfaceTerm,
  name: Text,
  ty: Option(SurfaceTerm),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, leaf_stmt_ty(c, v, value, name, ty)) {
  match ty: TrackedRunFrame(c, leaf_stmt_ty(c, v, value, name, ty)) {
    None => tracked_run_return(c, v, ordered)
    Some(tt) => tracked_run_bind(
      Ty,
      Ty,
      c,
      (w: Ty, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (ignored: Unit, c2: Checker) => mut1(w, c2),
        ck_expect(c1, v, w, span_of(value), cat3("`", name, "`"))
      ),
      ck_written_here(c, tt),
      tracked_run_read(
        c,
        ck_written_here(c, tt),
        ck_written_here_frame(c, tt),
        ck_written_here_frame_tracked(c, tt),
        ordered
      ),
      w => c1 => o_c1 => tracked_run_bind(
        Unit,
        Ty,
        c1,
        (ignored: Unit, c2: Checker) => mut1(w, c2),
        ck_expect(c1, v, w, span_of(value), cat3("`", name, "`")),
        ck_expect_run_frame_tracked(c1, v, w, span_of(value), cat3("`", name, "`"), o_c1),
        ignored => c2 => o_c2 => tracked_run_return(c2, w, o_c2)
      )
    )
  }
}

pub theorem ck_stmt_ty_run_frame_tracked(
  c: Checker,
  ty: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  name: Text,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_stmt_ty(c, ty, v, value, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(leaf_stmt_ty_unf(c, ty, v, value, name)),
    leaf_stmt_ty_frame_tracked(c, v, value, name, ty, ordered)
  )
}
pub theorem binding_let_if_frame_tracked(
  c: Checker,
  env: Scope,
  name: Text,
  r#view: Bool,
  bm: Bool,
  resolved: Ty,
  value: SurfaceTerm,
  borrow: Bool,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, binding_let_if(c, env, name, r#view, bm, resolved, value, borrow)) {
  match borrow: TrackedScopeFrame(
    c,
    binding_let_if(c, env, name, r#view, bm, resolved, value, borrow)
  ) {
    true => pattern_lift_frame_tracked(
      c,
      env,
      ck_let_borrow(c, name, r#view, bm, resolved, value),
      tracked_run_read(
        c,
        ck_let_borrow(c, name, r#view, bm, resolved, value),
        ck_let_borrow_frame(c, name, r#view, bm, resolved, value),
        ck_let_borrow_frame_tracked(c, name, r#view, bm, resolved, value),
        ordered
      )
    )
    false => pattern_return_frame_tracked(c, env, Star, ordered)
  }
}

pub theorem binding_let_after_frame_tracked(
  c: Checker,
  env: Scope,
  name: Text,
  t0: Ty,
  resolved: Ty,
  r#view: Bool,
  value: SurfaceTerm,
  borrow: Bool,
  bm: Bool,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  binding_let_after(c, env, name, t0, resolved, r#view, value, borrow, bm)
) {
  tracked_pattern_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker, env1: Scope) => pattern_bind_one(
      Ty,
      Unit,
      (t: Ty, c2: Checker) => pattern_rewrap(
        ck_bind_local(c2, env1, name, t, false, handle_body_start(value))
      ),
      ck_let_stored(c1, name, t0, resolved, value, Bool::and(not(borrow), r#view))
    ),
    binding_let_if(c, env, name, r#view, bm, resolved, value, borrow),
    binding_let_if_frame_tracked(c, env, name, r#view, bm, resolved, value, borrow, ordered),
    ignored => c1 => env1 => o_c1 => pattern_bind_one_frame_tracked(
      Ty,
      Unit,
      c1,
      (t: Ty, c2: Checker) => pattern_rewrap(
        ck_bind_local(c2, env1, name, t, false, handle_body_start(value))
      ),
      ck_let_stored(c1, name, t0, resolved, value, Bool::and(not(borrow), r#view)),
      tracked_run_read(
        c1,
        ck_let_stored(c1, name, t0, resolved, value, Bool::and(not(borrow), r#view)),
        ck_let_stored_frame(c1, name, t0, resolved, value, Bool::and(not(borrow), r#view)),
        ck_let_stored_frame_tracked(c1, name, t0, resolved, value, Bool::and(not(borrow), r#view)),
        o_c1
      ),
      t => c2 => o_c2 => pattern_rewrap_frame_tracked(
        c2,
        ck_bind_local(c2, env1, name, t, false, handle_body_start(value)),
        ck_bind_local_scope_frame_tracked(c2, env1, name, t, false, handle_body_start(value), o_c2)
      )
    )
  )
}

pub theorem binding_let_frame_tracked(
  c: Checker,
  env: Scope,
  name: Text,
  ty: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  borrow: Bool,
  bm: Bool,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  binding_let(c, env, name, ty, v, value, borrow, bm)
) {
  pattern_bind_one_frame_tracked(
    Ty,
    Unit,
    c,
    (t0: Ty, c1: Checker) => binding_let_after(
      c1,
      env,
      name,
      t0,
      ck_resolve(c1, t0),
      ck_is_view(c1, ck_resolve(c1, t0)),
      value,
      borrow,
      bm
    ),
    ck_stmt_ty(c, ty, v, value, name),
    ck_stmt_ty_run_frame_tracked(c, ty, v, value, name, ordered),
    t0 => c1 => o_c1 => binding_let_after_frame_tracked(
      c1,
      env,
      name,
      t0,
      ck_resolve(c1, t0),
      ck_is_view(c1, ck_resolve(c1, t0)),
      value,
      borrow,
      bm,
      o_c1
    )
  )
}

pub theorem ck_let_scope_frame_tracked(
  c: Checker,
  env: Scope,
  name: Text,
  ty: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  borrow: Bool,
  bm: Bool,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  ck_let(c, env, name, ty, v, value, borrow, bm)
) {
  Eq::subst(
    (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
    Eq::sym(binding_let_unf(c, env, name, ty, v, value, borrow, bm)),
    binding_let_frame_tracked(c, env, name, ty, v, value, borrow, bm, ordered)
  )
}

pub theorem binding_scope_only_frame_tracked<A: Type>(
  c: Checker,
  m: Mut1(A, Scope),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, binding_scope_only(c, m)) {
  match m: TrackedScopeFrame(
    c,
    binding_scope_only(c, m)
  ) {
    mut1(v, env) => AndIntro(
      ordered,
      AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    )
  }
}

pub theorem binding_mark_frame_tracked(
  c: Checker,
  env: Scope,
  vb: Bool,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, binding_mark(c, env, vb)) {
  match vb: TrackedScopeFrame(c, binding_mark(c, env, vb)) {
    true => binding_scope_only_frame_tracked(c, ck_mark_view(env), ordered)
    false => pattern_return_frame_tracked(c, env, Star, ordered)
  }
}

pub theorem binding_var_after_frame_tracked(
  c: Checker,
  env: Scope,
  name: Text,
  value: SurfaceTerm,
  vb: Bool,
  t: Ty,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  binding_var_after(c, env, name, value, vb, t)
) {
  pattern_bind_one_frame_tracked(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => pattern_bind(
      Unit,
      Unit,
      (ignored2: Unit, c2: Checker, env2: Scope) => binding_mark(c2, env2, vb),
      ck_bind_local(c1, env, name, t, true, handle_body_start(value))
    ),
    ck_var_check(c, name, vb, ck_resolve(c, t), value),
    tracked_run_read(
      c,
      ck_var_check(c, name, vb, ck_resolve(c, t), value),
      ck_var_check_frame(c, name, vb, ck_resolve(c, t), value),
      ck_var_check_frame_tracked(c, name, vb, ck_resolve(c, t), value),
      ordered
    ),
    ignored => c1 => o_c1 => tracked_pattern_bind(
      Unit,
      Unit,
      c1,
      (ignored2: Unit, c2: Checker, env2: Scope) => binding_mark(c2, env2, vb),
      ck_bind_local(c1, env, name, t, true, handle_body_start(value)),
      ck_bind_local_scope_frame_tracked(c1, env, name, t, true, handle_body_start(value), o_c1),
      ignored2 => c2 => env2 => o_c2 => binding_mark_frame_tracked(c2, env2, vb, o_c2)
    )
  )
}

pub theorem binding_var_frame_tracked(
  c: Checker,
  env: Scope,
  name: Text,
  ty: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  vb: Bool,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  binding_var(c, env, name, ty, v, value, vb)
) {
  pattern_bind_one_frame_tracked(
    Ty,
    Unit,
    c,
    (t: Ty, c1: Checker) => binding_var_after(c1, env, name, value, vb, t),
    ck_stmt_ty(c, ty, v, value, name),
    ck_stmt_ty_run_frame_tracked(c, ty, v, value, name, ordered),
    t => c1 => o_c1 => binding_var_after_frame_tracked(c1, env, name, value, vb, t, o_c1)
  )
}

