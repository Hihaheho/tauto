): TrackedRunFrame(
  c,
  ck_match_expr_in(k, c, scrutinee, arms, env, span)
) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(
                            And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, scrutinee, arms, env, span, ordered)
}

pub theorem inference_use_ck_record_in_tracked(
  k: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
