    true => tracked_run_rewrap(
      c,
      ck_set_subst(c, rv, ty_union(Cons(current, Cons(ck_resolve(c, a), Nil)))),
      ck_set_subst_run_frame_tracked(
        c,
        rv,
        ty_union(Cons(current, Cons(ck_resolve(c, a), Nil))),
        ordered
      )
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem widen_after_arm_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_after_arm(c, a, current, rv, failed)) {
  match failed: TrackedRunFrame(c, widen_after_arm(c, a, current, rv, failed)) {
    true => tracked_run_bind(
      Bool,
      Unit,
      c,
      (success: Bool, c1: Checker) => widen_final_fits(c1, a, current, rv, not(success)),
      ck_attempt_fits(c, a, current),
      ck_attempt_fits_run_frame_tracked(c, a, current, ordered),
      success => c1 => o_c1 => widen_final_fits_frame_tracked(
        c1,
        a,
        current,
        rv,
        not(success),
        o_c1
      )
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

