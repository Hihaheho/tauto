) {
  c => name => fields => declared => env => seen => ordered => Eq::subst(
    (z: Mut1(List(Text), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_record_fields_in(j, c, name, fields, declared, env, seen)),
    inference_step_ck_record_fields_in_frame_tracked(
      j,
      c,
      name,
      fields,
      declared,
      env,
      seen,
      ih,
      ordered
    )
  )
}
pub theorem inference_record_values_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  d: Text,
  args: List(Ty),
  declared: List(DataField),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_record_values(j, c, name, fields, env, span, d, args, declared)) {
  tracked_run_bind(
    List(Text),
    Ty,
    c,
    (seen: List(Text), c1: Checker) => frame_bind(
      Unit,
      Ty,
      (checked: Unit, c2: Checker) => mut1(TyNamed(d, args), c2),
      ck_record_missing(declared, c1, name, seen, span)
    ),
    ck_record_fields_in(j, c, name, fields, declared, env, Nil),
    inference_use_ck_record_fields_in_tracked(j, c, name, fields, declared, env, Nil, ordered, ih),
    seen => c1 => o_c1 => tracked_run_bind(
      Unit,
      Ty,
      c1,
      (checked: Unit, c2: Checker) => mut1(TyNamed(d, args), c2),
      ck_record_missing(declared, c1, name, seen, span),
      tracked_run_read(
        c1,
        ck_record_missing(declared, c1, name, seen, span),
        ck_record_missing_frame(declared, c1, name, seen, span),
        ck_record_missing_frame_tracked(declared, c1, name, seen, span),
        o_c1
      ),
      checked => c2 => o_c2 => tracked_run_return(c2, TyNamed(d, args), o_c2)
    )
  )
}

pub theorem inference_record_ctor_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  ctor: Option(Pair(Text, Nat)),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_record_ctor(j, c, name, fields, env, span, ctor)) {
  match ctor: TrackedRunFrame(c, inference_record_ctor(j, c, name, fields, env, span, ctor)) {
    None => tracked_run_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2(name, " is not a struct"), span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, cat2(name, " is not a struct"), span)),
        frame_rewrap(
          c,
          ck_error(c, cat2(name, " is not a struct"), span),
          ck_error_frame(c, cat2(name, " is not a struct"), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, cat2(name, " is not a struct"), span),
          ck_error_frame_tracked(c, cat2(name, " is not a struct"), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    Some(dc) => tracked_run_bind(
      List(Ty),
      Ty,
      c,
      (args: List(Ty), c1: Checker) => inference_record_values(
        j,
        c1,
        name,
        fields,
        env,
        span,
        pattern_ctor_name(dc),
        args,
        datas_fields(ck_datas_of(c1), pattern_ctor_name(dc), pattern_ctor_index(dc), args)
      ),
      ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
      tracked_run_read(
        c,
        ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame_tracked(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ordered
      ),
      args => c1 => o_c1 => inference_record_values_frame_tracked(
        j,
        c1,
        name,
        fields,
        env,
        span,
        pattern_ctor_name(dc),
        args,
        datas_fields(ck_datas_of(c1), pattern_ctor_name(dc), pattern_ctor_index(dc), args),
        ih,
        o_c1
      )
    )
  }
}

pub theorem inference_step_ck_record_in_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
