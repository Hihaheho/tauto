pub theorem ck_app_result_run_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  f: Ty,
  known: Option(List(Ty)),
  args: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_app_result(c, term, function, arguments, f, known, args)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(application_fn_unf(c, term, function, arguments, f, known, args)),
    application_fn_frame_tracked(
      c,
      term,
      function,
      arguments,
      f,
      known,
      args,
      ty_unborrowed(ck_resolve(c, f)),
      ty_unborrowed(ck_resolve(c, f)),
      ordered
    )
  )
}
pub theorem inference_call_args_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  f: Ty,
  known: Option(List(Ty)),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_call_args(j, c, term, function, arguments, env, f, known)) {
  tracked_run_bind(
    List(Ty),
    Ty,
    c,
    (args: List(Ty), c1: Checker) => ck_rewrap1(
      ck_app_result(c1, term, function, arguments, f, known, args)
    ),
    ck_app_args_in(j, c, arguments, known, env, 0),
    inference_use_ck_app_args_in_tracked(j, c, arguments, known, env, 0, ordered, ih),
    args => c1 => o_c1 => tracked_run_rewrap(
      c1,
      ck_app_result(c1, term, function, arguments, f, known, args),
      ck_app_result_run_frame_tracked(c1, term, function, arguments, f, known, args, o_c1)
    )
  )
}

pub theorem inference_step_ck_app_call_in_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_app_call_in(j, c, term, function, arguments, env)
) {
  tracked_run_bind(
    Ty,
    Ty,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      Ty,
      Ty,
      (f: Ty, c2: Checker) => inference_call_args(
        j,
        c2,
        term,
        function,
        arguments,
        env,
        f,
        ck_known_params(c2, f, list_len(arguments))
      ),
      ck_poly_instance(c1, function, t)
    ),
    ck_infer_in(j, c, function, env),
    inference_use_ck_infer_in_tracked(j, c, function, env, ordered, ih),
    t => c1 => o_c1 => tracked_run_bind(
      Ty,
      Ty,
      c1,
      (f: Ty, c2: Checker) => inference_call_args(
        j,
        c2,
        term,
        function,
        arguments,
        env,
        f,
        ck_known_params(c2, f, list_len(arguments))
      ),
      ck_poly_instance(c1, function, t),
      ck_poly_instance_run_frame_tracked(c1, function, t, o_c1),
      f => c2 => o_c2 => inference_call_args_frame_tracked(
        j,
        c2,
        term,
        function,
        arguments,
        env,
        f,
        ck_known_params(c2, f, list_len(arguments)),
        ih,
        o_c2
      )
    )
  )
}

pub theorem inference_successor_ck_app_call_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_app_call_in_tracked(
  Succ(j)
) {
  c => term => function => arguments => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_app_call_in(j, c, term, function, arguments, env)),
    inference_step_ck_app_call_in_frame_tracked(j, c, term, function, arguments, env, ih, ordered)
  )
}
pub theorem inference_successor_ck_operands_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_operands_in_tracked(
  Succ(j)
) {
  c => arguments => env => ordered => Eq::subst(
    (z: Mut1(List(Ty), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_operands_in(j, c, arguments, env)),
    inference_step_ck_operands_in_frame_tracked(j, c, arguments, env, ih, ordered)
  )
}
pub theorem inference_clone_rest_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  span: TySpan,
  arg: SurfaceTerm,
  rest: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_clone_rest(j, c, env, span, arg, rest)) {
  match rest: TrackedRunFrame(c, inference_clone_rest(j, c, env, span, arg, rest)) {
    Nil => tracked_run_bind(
      Ty,
      Ty,
      c,
      (t0: Ty, c1: Checker) => ck_rewrap1(ck_clone_value(c1, t0, arg, span)),
      ck_infer_in(j, c, arg, env),
      inference_use_ck_infer_in_tracked(j, c, arg, env, ordered, ih),
      t0 => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_clone_value(c1, t0, arg, span)),
        frame_rewrap(
          c1,
          ck_clone_value(c1, t0, arg, span),
          ck_clone_value_frame(c1, t0, arg, span)
        ),
        tracked_rewrap(
          c1,
          ck_clone_value(c1, t0, arg, span),
          ck_clone_value_frame_tracked(c1, t0, arg, span)
        ),
        o_c1
      )
    )
    Cons(x, more) => tracked_run_read(
      c,
      ck_rewrap1(ck_clone_bad(c, span)),
      frame_rewrap(c, ck_clone_bad(c, span), ck_clone_bad_frame(c, span)),
      tracked_rewrap(c, ck_clone_bad(c, span), ck_clone_bad_frame_tracked(c, span)),
      ordered
    )
  }
}

pub theorem inference_clone_args_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  span: TySpan,
  arguments: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_clone_args(j, c, env, span, arguments)) {
  match arguments: TrackedRunFrame(c, inference_clone_args(j, c, env, span, arguments)) {
    Nil => tracked_run_read(
      c,
      ck_rewrap1(ck_clone_bad(c, span)),
      frame_rewrap(c, ck_clone_bad(c, span), ck_clone_bad_frame(c, span)),
      tracked_rewrap(c, ck_clone_bad(c, span), ck_clone_bad_frame_tracked(c, span)),
      ordered
    )
    Cons(arg, rest) => inference_clone_rest_frame_tracked(j, c, env, span, arg, rest, ih, ordered)
  }
}

pub theorem inference_step_ck_clone_of_in_frame_tracked(
  j: Nat,
  c: Checker,
  arguments: List(SurfaceTerm),
  env: List(Local),
  span: TySpan,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_clone_of_in(j, c, arguments, env, span)
) { inference_clone_args_frame_tracked(j, c, env, span, arguments, ih, ordered) }

pub theorem inference_successor_ck_clone_of_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_clone_of_in_tracked(
  Succ(j)
) {
  c => arguments => env => span => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_clone_of_in(j, c, arguments, env, span)),
    inference_step_ck_clone_of_in_frame_tracked(j, c, arguments, env, span, ih, ordered)
  )
}
pub theorem argument_hint_cons_frame_tracked(
  p: Ty,
  rest: List(Ty),
  c: Checker,
  hs: List(Ty),
  ih: ∀ next: Checker. ∀ hs: List(
    Ty
  ). ∀ ordered: CkOrdered(next). TrackedRunFrame(next, ck_lambda_hint(rest, next, hs)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_hint_cons(p, rest, c, hs)) {
  match hs: TrackedRunFrame(c, argument_hint_cons(p, rest, c, hs)) {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(h, more) => tracked_run_bind(
      Bool,
      Unit,
      c,
      (ignored: Bool, c1: Checker) => ck_rewrap1(ck_lambda_hint(rest, c1, more)),
      ck_attempt_unify(c, p, h),
      ck_attempt_unify_run_frame_tracked(c, p, h, ordered),
      ignored => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_lambda_hint(rest, c1, more),
        ih(c1, more, o_c1)
      )
    )
  }
}

pub theorem ck_lambda_hint_run_frame_tracked(
  ps: List(Ty),
  c: Checker,
  hs: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_lambda_hint(ps, c, hs)) {
  match ps: TrackedRunFrame(c, ck_lambda_hint(ps, c, hs)) {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(p, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
      Eq::sym(argument_hint_cons_unf(p, rest, c, hs)),
      argument_hint_cons_frame_tracked(
        p,
        rest,
        c,
        hs,
        next => more => onext => ck_lambda_hint_run_frame_tracked(rest, next, more, onext),
        ordered
      )
    )
  }
}

pub theorem access_hint_arity_frame_tracked(
  c: Checker,
  ps: List(Ty),
  hs: List(Ty),
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_hint_arity(c, ps, hs, same)) {
  match same: TrackedRunFrame(c, access_hint_arity(c, ps, hs, same)) {
    true => tracked_run_rewrap(
      c,
      ck_lambda_hint(ps, c, hs),
      ck_lambda_hint_run_frame_tracked(ps, c, hs, ordered)
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem access_hint_type_frame_tracked(
  c: Checker,
  ps: List(Ty),
  t: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_hint_type(c, ps, t)) {
  match t: TrackedRunFrame(c, access_hint_type(c, ps, t)) {
    TyInt(pat_w) => tracked_run_return(c, Star, ordered)
    TyBool => tracked_run_return(c, Star, ordered)
    TyText => tracked_run_return(c, Star, ordered)
    TyUnit => tracked_run_return(c, Star, ordered)
    TyNever => tracked_run_return(c, Star, ordered)
    TyDecimal => tracked_run_return(c, Star, ordered)
    TyFloat => tracked_run_return(c, Star, ordered)
    TyFn(hs, r, fk) => access_hint_arity_frame_tracked(
      c,
      ps,
      hs,
      Nat::eq(list_len(hs), list_len(ps)),
      ordered
    )
    TyUnion(pat_members) => tracked_run_return(c, Star, ordered)
    TyProduct(pat_members) => tracked_run_return(c, Star, ordered)
    TyTagged(pat_tags, pat_inner) => tracked_run_return(c, Star, ordered)
    TyNamed(pat_name, pat_args) => tracked_run_return(c, Star, ordered)
    TyParam(pat_name, pat_bound) => tracked_run_return(c, Star, ordered)
    TyInfo(pat_inner) => tracked_run_return(c, Star, ordered)
    TyBorrow(pat_inner, pat_mutable) => tracked_run_return(c, Star, ordered)
    TyVar(pat_v) => tracked_run_return(c, Star, ordered)
    TyPoly(pat_generics, pat_inner) => tracked_run_return(c, Star, ordered)
    TyApp(pat_head, pat_arg) => tracked_run_return(c, Star, ordered)
  }
}

pub theorem access_hint_frame_tracked(
  c: Checker,
  ps: List(Ty),
  hint: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_hint(c, ps, hint)) {
  match hint: TrackedRunFrame(c, access_hint(c, ps, hint)) {
    None => tracked_run_return(c, Star, ordered)
    Some(h) => access_hint_type_frame_tracked(c, ps, ty_unborrowed(ck_resolve(c, h)), ordered)
  }
}

pub theorem ck_lambda_hint_of_run_frame_tracked(
  c: Checker,
  hint: Option(Ty),
  ps: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  ck_lambda_hint_of(c, hint, ps)
) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_hint_unf(c, hint, ps)),
    access_hint_frame_tracked(c, ps, hint, ordered)
  )
}

pub theorem inference_lambda_body_frame_tracked(
  j: Nat,
  c: Checker,
  params: List(Text),
  body: SurfaceTerm,
  env: List(Local),
  ps: List(Ty),
  kind: Kind,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_lambda_body(j, c, params, body, env, ps, kind)) {
  inference_bind_scope_frame_tracked(
    Unit,
    Ty,
    c,
    (bound: Unit, c1: Checker, inner: Scope) => frame_bind(
      Ty,
      Ty,
      (r: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (pushed: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (b: Ty, c4: Checker) => frame_bind(
            Unit,
            Ty,
            (popped: Unit, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (checked: Unit, c6: Checker) => frame_bind(
                Unit,
                Ty,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, kind), c7),
                inference_record_closure(c6, r, body)
              ),
              ck_expect(c5, b, r, span_of(body), "the result of a function")
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4)))
          ),
          ck_infer_in(j, c3, body, inference_scope_items(inner))
        ),
        inference_set_returns(c2, Cons(r, inference_returns(c2)))
      ),
      ck_fresh(c1)
    ),
    ck_bind_params(params, c, ScopeMk(env), ps, handle_body_start(body)),
    ck_bind_params_scope_frame_tracked(
      params,
      c,
      ScopeMk(env),
      ps,
      handle_body_start(body),
      ordered
    ),
    bound => c1 => inner => o_c1 => tracked_run_bind(
      Ty,
      Ty,
      c1,
      (r: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (pushed: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (b: Ty, c4: Checker) => frame_bind(
            Unit,
            Ty,
            (popped: Unit, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (checked: Unit, c6: Checker) => frame_bind(
                Unit,
                Ty,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, kind), c7),
                inference_record_closure(c6, r, body)
              ),
              ck_expect(c5, b, r, span_of(body), "the result of a function")
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4)))
          ),
          ck_infer_in(j, c3, body, inference_scope_items(inner))
        ),
        inference_set_returns(c2, Cons(r, inference_returns(c2)))
      ),
      ck_fresh(c1),
      tracked_run_read(c1, ck_fresh(c1), ck_fresh_frame(c1), ck_fresh_frame_tracked(c1), o_c1),
      r => c2 => o_c2 => tracked_run_bind(
        Unit,
        Ty,
        c2,
        (pushed: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (b: Ty, c4: Checker) => frame_bind(
            Unit,
            Ty,
            (popped: Unit, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (checked: Unit, c6: Checker) => frame_bind(
                Unit,
                Ty,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, kind), c7),
                inference_record_closure(c6, r, body)
              ),
              ck_expect(c5, b, r, span_of(body), "the result of a function")
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4)))
          ),
          ck_infer_in(j, c3, body, inference_scope_items(inner))
        ),
        inference_set_returns(c2, Cons(r, inference_returns(c2))),
        tracked_run_read(
          c2,
          inference_set_returns(c2, Cons(r, inference_returns(c2))),
          inference_set_returns_frame(c2, Cons(r, inference_returns(c2))),
          inference_set_returns_frame_tracked(c2, Cons(r, inference_returns(c2))),
          o_c2
        ),
        pushed => c3 => o_c3 => tracked_run_bind(
          Ty,
          Ty,
          c3,
          (b: Ty, c4: Checker) => frame_bind(
            Unit,
            Ty,
            (popped: Unit, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (checked: Unit, c6: Checker) => frame_bind(
                Unit,
                Ty,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, kind), c7),
                inference_record_closure(c6, r, body)
              ),
              ck_expect(c5, b, r, span_of(body), "the result of a function")
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4)))
          ),
          ck_infer_in(j, c3, body, inference_scope_items(inner)),
          inference_use_ck_infer_in_tracked(j, c3, body, inference_scope_items(inner), o_c3, ih),
          b => c4 => o_c4 => tracked_run_bind(
            Unit,
            Ty,
            c4,
            (popped: Unit, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (checked: Unit, c6: Checker) => frame_bind(
                Unit,
                Ty,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, kind), c7),
                inference_record_closure(c6, r, body)
              ),
              ck_expect(c5, b, r, span_of(body), "the result of a function")
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4))),
            tracked_run_read(
              c4,
              inference_set_returns(c4, List::tail(inference_returns(c4))),
              inference_set_returns_frame(c4, List::tail(inference_returns(c4))),
              inference_set_returns_frame_tracked(c4, List::tail(inference_returns(c4))),
              o_c4
            ),
            popped => c5 => o_c5 => tracked_run_bind(
              Unit,
              Ty,
              c5,
              (checked: Unit, c6: Checker) => frame_bind(
                Unit,
                Ty,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, kind), c7),
                inference_record_closure(c6, r, body)
              ),
              ck_expect(c5, b, r, span_of(body), "the result of a function"),
              ck_expect_run_frame_tracked(
                c5,
                b,
                r,
                span_of(body),
                "the result of a function",
                o_c5
              ),
              checked => c6 => o_c6 => tracked_run_bind(
                Unit,
                Ty,
                c6,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, kind), c7),
                inference_record_closure(c6, r, body),
                tracked_run_read(
                  c6,
                  inference_record_closure(c6, r, body),
                  inference_record_closure_frame(c6, r, body),
                  inference_record_closure_frame_tracked(c6, r, body),
                  o_c6
                ),
                recorded => c7 => o_c7 => tracked_run_return(c7, TyFn(ps, r, kind), o_c7)
              )
            )
          )
        )
      )
    )
  )
}

pub theorem inference_lambda_kind_frame_tracked(
  j: Nat,
  c: Checker,
  lam: SurfaceTerm,
  borrows: List(Option(Bool)),
  env: List(Local),
  hint: Option(Ty),
  sk: SurfaceKind,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_lambda_kind(j, c, lam, borrows, env, hint, sk)) {
  match sk: TrackedRunFrame(c, inference_lambda_kind(j, c, lam, borrows, env, hint, sk)) {
    SkVar(pat_name) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkNat(pat_digits) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkText(pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBool(pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkApp(pat_head, pat_args) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkPi(pat_params, pat_result, pat_effects) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkExists(pat_binder, pat_domain, pat_body) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkLam(params, body) => tracked_run_bind(
      List(Ty),
      Ty,
      c,
      (ps: List(Ty), c1: Checker) => frame_bind(
        Unit,
        Ty,
        (hinted: Unit, c2: Checker) => inference_lambda_body(
          j,
          c2,
          params,
          body,
          env,
          ps,
          ck_lambda_kind(free_vars(lam), c2, env, KindCopy)
        ),
        ck_lambda_hint_of(c1, hint, ps)
      ),
      ck_lambda_params(params, c, borrows),
      tracked_run_read(
        c,
        ck_lambda_params(params, c, borrows),
        ck_lambda_params_frame(params, c, borrows),
        ck_lambda_params_frame_tracked(params, c, borrows),
        ordered
      ),
      ps => c1 => o_c1 => tracked_run_bind(
        Unit,
        Ty,
        c1,
        (hinted: Unit, c2: Checker) => inference_lambda_body(
          j,
          c2,
          params,
          body,
          env,
          ps,
          ck_lambda_kind(free_vars(lam), c2, env, KindCopy)
        ),
        ck_lambda_hint_of(c1, hint, ps),
        ck_lambda_hint_of_run_frame_tracked(c1, hint, ps, o_c1),
        hinted => c2 => o_c2 => inference_lambda_body_frame_tracked(
          j,
          c2,
          params,
          body,
          env,
          ps,
          ck_lambda_kind(free_vars(lam), c2, env, KindCopy),
          ih,
          o_c2
        )
      )
    )
    SkUnion(pat_parts) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkTagged(pat_tag, pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkIf(pat_cond, pat_then, pat_otherwise) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkField(pat_value, pat_name) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBlock(pat_stmts) => tracked_run_read(
