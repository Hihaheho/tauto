pub def Inference_ck_infer_in_tracked(
  k: Nat
): Prop := ∀ c: Checker. ∀ term: SurfaceTerm. ∀ env: List(
  Local
). ∀ ordered: CkOrdered(c). TrackedRunFrame(c, ck_infer_in(k, c, term, env))

