pub theorem inference_handle_result_frame_tracked(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  first: Ty,
  budget_ty: Ty,
  variable: Option(Nat),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_handle_result(j, c, handlers, env, result, first, budget_ty, variable)
) {
  match variable: TrackedRunFrame(
    c,
    inference_handle_result(j, c, handlers, env, result, first, budget_ty, variable)
  ) {
    None => tracked_run_return(c, Star, ordered)
    Some(rv) => tracked_run_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        Unit,
        Unit,
        (gathered: Unit, c2: Checker) => ck_rewrap1(
          ck_handle_arms_in(j, c2, handlers, env, ck_resolve(c2, result), None, budget_ty)
        ),
        ck_handle_arms_in(j, c1, handlers, env, result, Some(rv), budget_ty)
      ),
      ck_set_subst(c, rv, first),
      ck_set_subst_run_frame_tracked(c, rv, first, ordered),
      ignored => c1 => o_c1 => tracked_run_bind(
        Unit,
        Unit,
        c1,
        (gathered: Unit, c2: Checker) => ck_rewrap1(
          ck_handle_arms_in(j, c2, handlers, env, ck_resolve(c2, result), None, budget_ty)
        ),
        ck_handle_arms_in(j, c1, handlers, env, result, Some(rv), budget_ty),
        inference_use_ck_handle_arms_in_tracked(
          j,
          c1,
          handlers,
          env,
          result,
          Some(rv),
          budget_ty,
          o_c1,
          ih
        ),
        gathered => c2 => o_c2 => tracked_run_rewrap(
          c2,
          ck_handle_arms_in(j, c2, handlers, env, ck_resolve(c2, result), None, budget_ty),
          inference_use_ck_handle_arms_in_tracked(
            j,
            c2,
            handlers,
            env,
            ck_resolve(c2, result),
            None,
            budget_ty,
            o_c2,
            ih
          )
        )
      )
    )
  }
}

pub theorem inference_step_ck_handle_result_in_frame_tracked(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
