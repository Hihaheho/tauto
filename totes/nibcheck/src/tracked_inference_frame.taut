) { inference_list_ck_operands_in_frame_tracked(j, c, env, arguments, ih, ordered) }

pub theorem record_field_found_frame_tracked(
  c: Checker,
  name: Text,
  f: SurfaceField,
  v: Ty,
  found: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, record_field_found(c, name, f, v, found)) {
  match found: TrackedRunFrame(c, record_field_found(c, name, f, v, found)) {
    Some(t) => tracked_run_rewrap(
      c,
      ck_expect(
        c,
        v,
        t,
        span_of(record_field_value(f)),
        cat3("field `", record_field_name(f), "`")
      ),
      ck_expect_run_frame_tracked(
        c,
        v,
        t,
        span_of(record_field_value(f)),
        cat3("field `", record_field_name(f), "`"),
        ordered
      )
    )
    None => tracked_run_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat4(name, " has no field `", record_field_name(f), "`"),
          span_of(record_field_value(f))
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat4(name, " has no field `", record_field_name(f), "`"),
          span_of(record_field_value(f))
        ),
        ck_error_frame(
          c,
          cat4(name, " has no field `", record_field_name(f), "`"),
          span_of(record_field_value(f))
        )
      ),
      tracked_rewrap(
        c,
        ck_error(
          c,
          cat4(name, " has no field `", record_field_name(f), "`"),
          span_of(record_field_value(f))
        ),
        ck_error_frame_tracked(
          c,
          cat4(name, " has no field `", record_field_name(f), "`"),
          span_of(record_field_value(f))
        )
      ),
      ordered
    )
  }
}

pub theorem record_field_after_frame_tracked(
  c: Checker,
  name: Text,
  f: SurfaceField,
  v: Ty,
  declared: List(DataField),
  again: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, record_field_after(c, name, f, v, declared, again)) {
  tracked_run_bind(
    Unit,
    Bool,
    c,
    (ignored: Unit, c1: Checker) => frame_bind(
      Unit,
      Bool,
      (ignored2: Unit, c2: Checker) => mut1(again, c2),
      record_field_found(c1, name, f, v, ck_field_find(declared, record_field_name(f)))
    ),
    frame_error_if(
      c,
      cat3("field `", record_field_name(f), "` is given twice"),
      span_of(record_field_value(f)),
      again
    ),
    tracked_run_read(
      c,
      frame_error_if(
        c,
        cat3("field `", record_field_name(f), "` is given twice"),
        span_of(record_field_value(f)),
        again
      ),
      frame_error_if_ok(
        c,
        cat3("field `", record_field_name(f), "` is given twice"),
        span_of(record_field_value(f)),
        again
      ),
      frame_error_if_ok_tracked(
        c,
        cat3("field `", record_field_name(f), "` is given twice"),
        span_of(record_field_value(f)),
        again
      ),
      ordered
    ),
    ignored => c1 => o_c1 => tracked_run_bind(
      Unit,
      Bool,
      c1,
      (ignored2: Unit, c2: Checker) => mut1(again, c2),
      record_field_found(c1, name, f, v, ck_field_find(declared, record_field_name(f))),
      record_field_found_frame_tracked(
        c1,
        name,
        f,
        v,
        ck_field_find(declared, record_field_name(f)),
        o_c1
      ),
      ignored2 => c2 => o_c2 => tracked_run_return(c2, again, o_c2)
    )
  )
}

pub theorem record_field_frame_tracked(
  c: Checker,
  name: Text,
  f: SurfaceField,
  v: Ty,
  declared: List(DataField),
  seen: List(Text),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, record_field(c, name, f, v, declared, seen)) {
  tracked_run_bind(
    Unit,
    Bool,
    c,
    (ignored: Unit, c1: Checker) => record_field_after(
      c1,
      name,
      f,
      v,
      declared,
      list_has_text(seen, record_field_name(f))
    ),
    frame_error_if(
      c,
      "a borrow cannot be a field",
      span_of(record_field_value(f)),
      term_is_borrow(record_field_value(f))
    ),
    tracked_run_read(
      c,
      frame_error_if(
        c,
        "a borrow cannot be a field",
        span_of(record_field_value(f)),
        term_is_borrow(record_field_value(f))
      ),
      frame_error_if_ok(
        c,
        "a borrow cannot be a field",
        span_of(record_field_value(f)),
        term_is_borrow(record_field_value(f))
      ),
      frame_error_if_ok_tracked(
        c,
        "a borrow cannot be a field",
        span_of(record_field_value(f)),
        term_is_borrow(record_field_value(f))
      ),
      ordered
    ),
    ignored => c1 => o_c1 => record_field_after_frame_tracked(
      c1,
      name,
      f,
      v,
      declared,
      list_has_text(seen, record_field_name(f)),
      o_c1
    )
  )
}

pub theorem ck_record_field_check_run_frame_tracked(
  c: Checker,
  name: Text,
  f: SurfaceField,
  v: Ty,
  declared: List(DataField),
  seen: List(Text),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  ck_record_field_check(c, name, f, v, declared, seen)
) {
  Eq::subst(
    (z: Mut1(Bool, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(record_field_unf(c, name, f, v, declared, seen)),
    record_field_frame_tracked(c, name, f, v, declared, seen, ordered)
  )
}

pub theorem inference_use_ck_record_fields_in_tracked(
  k: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  declared: List(DataField),
  env: List(Local),
  seen: List(Text),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_record_fields_in(k, c, name, fields, declared, env, seen)
) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih)))))))
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, name, fields, declared, env, seen, ordered)
}

pub theorem inference_record_fields_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  declared: List(DataField),
  env: List(Local),
  seen: List(Text),
  fields: List(SurfaceField),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_record_fields(j, c, name, declared, env, seen, fields)) {
  match fields: TrackedRunFrame(
    c,
    inference_record_fields(j, c, name, declared, env, seen, fields)
  ) {
    Nil => tracked_run_return(c, seen, ordered)
    Cons(f, rest) => tracked_run_bind(
      Ty,
      List(Text),
      c,
      (v: Ty, c1: Checker) => frame_bind(
        Bool,
        List(Text),
        (again: Bool, c2: Checker) => ck_rewrap1(
          ck_record_fields_in(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f))
          )
        ),
        ck_record_field_check(c1, name, f, v, declared, seen)
      ),
      ck_infer_in(j, c, record_field_value(f), env),
      inference_use_ck_infer_in_tracked(j, c, record_field_value(f), env, ordered, ih),
      v => c1 => o_c1 => tracked_run_bind(
        Bool,
        List(Text),
        c1,
        (again: Bool, c2: Checker) => ck_rewrap1(
          ck_record_fields_in(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f))
          )
        ),
        ck_record_field_check(c1, name, f, v, declared, seen),
        ck_record_field_check_run_frame_tracked(c1, name, f, v, declared, seen, o_c1),
        again => c2 => o_c2 => tracked_run_rewrap(
          c2,
          ck_record_fields_in(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f))
          ),
          inference_use_ck_record_fields_in_tracked(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f)),
            o_c2,
            ih
          )
        )
      )
    )
  }
}

pub theorem inference_step_ck_record_fields_in_frame_tracked(
  j: Nat,
