pub theorem inference_first_handler_frame_tracked(
  j: Nat,
  c: Checker,
  b: Ty,
  env: List(Local),
  returned: Option(Pair(SurfacePattern, SurfaceTerm)),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_first_handler(j, c, b, env, returned)) {
  match returned: TrackedRunFrame(c, inference_first_handler(j, c, b, env, returned)) {
    None => tracked_run_return(c, b, ordered)
    Some(r) => inference_bind_scope_frame_tracked(
      Unit,
      Ty,
      c,
      (matched: Unit, c1: Checker, inner: Scope) => ck_rewrap1(
        ck_infer_in(j, c1, inference_handler_body(r), inference_scope_items(inner))
      ),
      ck_pattern(
        c,
        inference_handler_pattern(r),
        b,
        ScopeMk(env),
        span_of(inference_handler_body(r)),
        handle_body_start(inference_handler_body(r))
      ),
      ck_pattern_frame_tracked(
        c,
        inference_handler_pattern(r),
        b,
        ScopeMk(env),
        span_of(inference_handler_body(r)),
        handle_body_start(inference_handler_body(r)),
        ordered
      ),
      matched => c1 => inner => o_c1 => tracked_run_rewrap(
        c1,
        ck_infer_in(j, c1, inference_handler_body(r), inference_scope_items(inner)),
        inference_use_ck_infer_in_tracked(
          j,
          c1,
          inference_handler_body(r),
          inference_scope_items(inner),
          o_c1,
          ih
        )
      )
    )
  }
}

pub theorem inference_step_ck_handle_first_in_frame_tracked(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  b: Ty,
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_handle_first_in(j, c, handlers, b, env)
) { inference_first_handler_frame_tracked(j, c, b, env, handlers_return(handlers), ih, ordered) }

pub theorem inference_successor_ck_handle_first_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_handle_first_in_tracked(
  Succ(j)
) {
  c => handlers => b => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_handle_first_in(j, c, handlers, b, env)),
    inference_step_ck_handle_first_in_frame_tracked(j, c, handlers, b, env, ih, ordered)
  )
}
