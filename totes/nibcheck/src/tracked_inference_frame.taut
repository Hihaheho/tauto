) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, name, fields, env, span, ordered)
}

pub theorem inference_term_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  sk: SurfaceKind,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_term(j, c, term, env, span, sk)) {
  match sk: TrackedRunFrame(c, inference_term(j, c, term, env, span, sk)) {
    SkVar(name) => tracked_run_read(
      c,
      ck_rewrap1(ck_lookup(c, name, env, span)),
      frame_rewrap(c, ck_lookup(c, name, env, span), ck_lookup_frame(c, name, env, span)),
      tracked_rewrap(c, ck_lookup(c, name, env, span), ck_lookup_frame_tracked(c, name, env, span)),
      ordered
    )
    SkNat(n) => tracked_run_read(
      c,
      ck_rewrap1(ck_nat_literal(c, n, span)),
      frame_rewrap(c, ck_nat_literal(c, n, span), ck_nat_literal_frame(c, n, span)),
      tracked_rewrap(c, ck_nat_literal(c, n, span), ck_nat_literal_frame_tracked(c, n, span)),
      ordered
    )
    SkText(s) => tracked_run_return(c, TyText, ordered)
    SkBool(b) => tracked_run_return(c, TyBool, ordered)
    SkApp(function, arguments) => tracked_run_rewrap(
      c,
      ck_app_in(j, c, term, function, arguments, env),
      inference_use_ck_app_in_tracked(j, c, term, function, arguments, env, ordered, ih)
    )
    SkPi(pat_params, pat_result, pat_effects) => tracked_run_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            cat2("not supported yet: ", sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkExists(pat_binder, pat_domain, pat_body) => tracked_run_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            cat2("not supported yet: ", sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkLam(params, body) => tracked_run_rewrap(
      c,
      ck_lambda_in(j, c, term, Nil, env),
      inference_use_ck_lambda_in_tracked(j, c, term, Nil, env, ordered, ih)
    )
    SkUnion(pat_parts) => tracked_run_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            cat2("not supported yet: ", sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkTagged(tag, x) => tracked_run_bind(
      Ty,
      Ty,
      c,
      (t: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), c1),
      ck_infer_in(j, c, x, env),
      inference_use_ck_infer_in_tracked(j, c, x, env, ordered, ih),
      t => c1 => o_c1 => tracked_run_return(c1, ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), o_c1)
    )
    SkIf(condition, th, el) => tracked_run_bind(
      Ty,
      Ty,
      c,
      (ct: Ty, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (checked: Unit, c2: Checker) => frame_bind(
          Ty,
          Ty,
          (t: Ty, c3: Checker) => ck_rewrap1(ck_else_in(j, c3, t, el, env)),
          ck_infer_in(j, c2, th, env)
        ),
        ck_expect(c1, ct, TyBool, span_of(condition), "an `if` condition")
      ),
      ck_infer_in(j, c, condition, env),
      inference_use_ck_infer_in_tracked(j, c, condition, env, ordered, ih),
      ct => c1 => o_c1 => tracked_run_bind(
        Unit,
        Ty,
        c1,
        (checked: Unit, c2: Checker) => frame_bind(
          Ty,
          Ty,
          (t: Ty, c3: Checker) => ck_rewrap1(ck_else_in(j, c3, t, el, env)),
          ck_infer_in(j, c2, th, env)
        ),
        ck_expect(c1, ct, TyBool, span_of(condition), "an `if` condition"),
        ck_expect_run_frame_tracked(c1, ct, TyBool, span_of(condition), "an `if` condition", o_c1),
        checked => c2 => o_c2 => tracked_run_bind(
          Ty,
          Ty,
          c2,
          (t: Ty, c3: Checker) => ck_rewrap1(ck_else_in(j, c3, t, el, env)),
          ck_infer_in(j, c2, th, env),
          inference_use_ck_infer_in_tracked(j, c2, th, env, o_c2, ih),
          t => c3 => o_c3 => tracked_run_rewrap(
            c3,
            ck_else_in(j, c3, t, el, env),
            inference_use_ck_else_in_tracked(j, c3, t, el, env, o_c3, ih)
          )
        )
      )
    )
    SkField(base, name) => inference_field_base_frame_tracked(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      class_of_base(c, base, env),
      ih,
      ordered
    )
    SkBlock(stmts) => inference_bind_scope_frame_tracked(
      Ty,
      Ty,
      c,
      (t: Ty, c1: Checker, inner: Scope) => mut1(t, c1),
