pub def InferenceFrames_tracked(
  k: Nat
): Prop := And(
  Inference_ck_infer_in_tracked(k),
  And(
    Inference_ck_infer_term_in_tracked(k),
    And(
      Inference_ck_else_in_tracked(k),
      And(
        Inference_ck_infer_each_in_tracked(k),
        And(
          Inference_ck_guard_in_tracked(k),
          And(
            Inference_ck_stmt_in_tracked(k),
            And(
              Inference_ck_returned_in_tracked(k),
              And(
                Inference_ck_check_fn_in_tracked(k),
                And(
                  Inference_ck_block_in_tracked(k),
                  And(
                    Inference_ck_app_args_in_tracked(k),
                    And(
                      Inference_ck_app_in_tracked(k),
                      And(
                        Inference_ck_app_call_in_tracked(k),
                        And(
                          Inference_ck_operands_in_tracked(k),
                          And(
                            Inference_ck_clone_of_in_tracked(k),
                            And(
                              Inference_ck_lambda_in_tracked(k),
                              And(
                                Inference_ck_record_fields_in_tracked(k),
                                And(
                                  Inference_ck_record_in_tracked(k),
                                  And(
                                    Inference_ck_match_arms_in_tracked(k),
                                    And(
                                      Inference_ck_match_expr_in_tracked(k),
                                      And(
                                        Inference_ck_handle_in_tracked(k),
                                        And(
                                          Inference_ck_handle_first_in_tracked(k),
                                          And(
                                            Inference_ck_handle_result_in_tracked(k),
                                            And(
                                              Inference_ck_handle_arms_in_tracked(k),
                                              And(
                                                Inference_ck_handle_one_in_tracked(k),
                                                And(
                                                  Inference_ck_handle_arm_in_tracked(k),
                                                  And(Inference_ck_handle_body_in_tracked(k), True)
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

pub theorem inference_class_method_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  cn: Text,
  found: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_class_method(j, c, term, env, span, base, name, cn, found)) {
  match found: TrackedRunFrame(
    c,
    inference_class_method(j, c, term, env, span, base, name, cn, found)
  ) {
    true => tracked_run_read(
      c,
      ck_rewrap1(ck_lookup(c, cat3(cn, ".", name), env, span)),
      frame_rewrap(
        c,
        ck_lookup(c, cat3(cn, ".", name), env, span),
        ck_lookup_frame(c, cat3(cn, ".", name), env, span)
      ),
      tracked_rewrap(
        c,
        ck_lookup(c, cat3(cn, ".", name), env, span),
        ck_lookup_frame_tracked(c, cat3(cn, ".", name), env, span)
      ),
      ordered
    )
    false => tracked_run_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat3(cn, " has no method ", name), span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, cat3(cn, " has no method ", name), span)),
        frame_rewrap(
          c,
          ck_error(c, cat3(cn, " has no method ", name), span),
          ck_error_frame(c, cat3(cn, " has no method ", name), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, cat3(cn, " has no method ", name), span),
          ck_error_frame_tracked(c, cat3(cn, " has no method ", name), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
  }
}

pub theorem inference_use_ck_infer_in_tracked(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_infer_in(k, c, term, env)) { And::left(ih)(c, term, env, ordered) }

pub theorem inference_field_base_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  r#class: Option(Text),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_field_base(j, c, term, env, span, base, name, r#class)) {
  match r#class: TrackedRunFrame(c, inference_field_base(j, c, term, env, span, base, name, r#class)) {
    None => tracked_run_bind(
      Ty,
      Ty,
      c,
      (b: Ty, c1: Checker) => ck_rewrap1(ck_field_of(c1, term, b, name)),
      ck_infer_in(j, c, base, env),
      inference_use_ck_infer_in_tracked(j, c, base, env, ordered, ih),
      b => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_field_of(c1, term, b, name)),
        frame_rewrap(c1, ck_field_of(c1, term, b, name), ck_field_of_frame(c1, term, b, name)),
        tracked_rewrap(
          c1,
          ck_field_of(c1, term, b, name),
          ck_field_of_frame_tracked(c1, term, b, name)
        ),
        o_c1
      )
    )
    Some(cn) => inference_class_method_frame_tracked(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      cn,
      Ordmap::contains(inference_fns(c), cat3(cn, ".", name), Ordmap::compare_text),
      ih,
      ordered
    )
  }
}

pub theorem inference_use_ck_app_in_tracked(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_app_in(k, c, term, function, arguments, env)
) {
  And::left(
    And::right(
      And::right(
        And::right(And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih))))))))
      )
    )
  )(c, term, function, arguments, env, ordered)
}

pub theorem inference_use_ck_lambda_in_tracked(
  k: Nat,
  c: Checker,
  lam: SurfaceTerm,
  borrows: List(Option(Bool)),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_lambda_in(k, c, lam, borrows, env)
) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih)))))))
                )
              )
            )
          )
        )
      )
    )
  )(c, lam, borrows, env, ordered)
}

pub theorem ck_fits_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_fits(c, a, b)) {
  tracked_run_grows(c, ck_fits(c, a, b), And::left(ck_fits_ok(c, a, b)(ordered)))
}
pub theorem ck_fits_wide_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_fits_wide(c, a, b)) {
  tracked_run_grows(c, ck_fits_wide(c, a, b), And::left(ck_fits_wide_ok(c, a, b)(ordered)))
}
pub theorem run_expect_after_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  fits: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, run_expect_after(c, a, b, span, what, fits)) {
  tracked_run_read(
    c,
    run_expect_after(c, a, b, span, what, fits),
    frame_error_if_ok(
      c,
      ck_expect_message(ck_shown(c, a), ck_shown(c, b), what),
      span,
      not(fits)
    ),
    frame_error_if_ok_tracked(
      c,
      ck_expect_message(ck_shown(c, a), ck_shown(c, b), what),
      span,
      not(fits)
    ),
    ordered
  )
}
pub theorem ck_expect_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_expect(c, a, b, span, what)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(run_expect_unf(c, a, b, span, what)),
    tracked_run_bind(
      Bool,
      Unit,
      c,
      (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits),
      ck_fits_wide(c, a, b),
      ck_fits_wide_run_frame_tracked(c, a, b, ordered),
      fits => next => onext => run_expect_after_frame_tracked(next, a, b, span, what, fits, onext)
    )
  )
}

pub theorem inference_use_ck_else_in_tracked(
  k: Nat,
  c: Checker,
  t: Ty,
  el: Option(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_else_in(k, c, t, el, env)
) { And::left(And::right(And::right(ih)))(c, t, el, env, ordered) }

pub theorem inference_bind_scope_frame_tracked<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker, Scope) -> Mut1(B, Checker),
  m: Mut2(A, Checker, Scope),
  hm: TrackedScopeFrame(c, m),
  hk: ∀ v: A. ∀ next: Checker. ∀ env: Scope. ∀ ordered: CkOrdered(
    next
  ). TrackedRunFrame(next, k(v, next, env))
): TrackedRunFrame(c, inference_bind_scope(k, m)) {
  match m: TrackedRunFrame(c, inference_bind_scope(k, m)) {
    mut2(v, next, env) => {
      let h: TrackedRunFrame(next, k(v, next, env)) := hk(v, next, env, And::left(hm))
      AndIntro(
        And::left(h),
        tracked_state_trans(c, next, ck_st(k(v, next, env)), And::right(hm), And::right(h))
      )
    }
  }
}
pub theorem inference_use_ck_block_in_tracked(
  k: Nat,
  c: Checker,
  stmts: List(SurfaceStmt),
  env: Scope,
  stopped: Bool,
  last: Ty,
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedScopeFrame(
  c,
  ck_block_in(k, c, stmts, env, stopped, last)
) {
  And::left(
    And::right(And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih))))))))
  )(c, stmts, env, stopped, last, ordered)
}

pub theorem inference_use_ck_infer_each_in_tracked(
  k: Nat,
