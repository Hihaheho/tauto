pub theorem inference_handle_budget_frame_tracked(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_handle_budget(j, c, body, handlers, env, budget_ty, answers)) {
  tracked_run_bind(
    Unit,
    Ty,
    c,
    (pushed: Unit, c1: Checker) => frame_bind(
      Ty,
      Ty,
      (b: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env)
    ),
    inference_budget_push(j, c, body, handlers, env, budget_ty, answers),
    inference_budget_push_frame_tracked(j, c, body, handlers, env, budget_ty, answers, ih, ordered),
    pushed => c1 => o_c1 => tracked_run_bind(
      Ty,
      Ty,
      c1,
      (b: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env),
      inference_use_ck_infer_in_tracked(j, c1, body, env, o_c1, ih),
      b => c2 => o_c2 => tracked_run_bind(
        Unit,
        Ty,
        c2,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers),
        inference_budget_pop_frame_tracked(j, c2, answers, ih, o_c2),
        popped => c3 => o_c3 => tracked_run_bind(
          Ty,
          Ty,
          c3,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3),
          tracked_run_read(c3, ck_fresh(c3), ck_fresh_frame(c3), ck_fresh_frame_tracked(c3), o_c3),
          result => c4 => o_c4 => tracked_run_bind(
            Ty,
            Ty,
            c4,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env),
            inference_use_ck_handle_first_in_tracked(j, c4, handlers, b, env, o_c4, ih),
            first => c5 => o_c5 => tracked_run_bind(
              Unit,
              Ty,
              c5,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty),
              inference_use_ck_handle_result_in_tracked(
                j,
                c5,
                handlers,
                env,
                result,
                first,
                budget_ty,
                o_c5,
                ih
              ),
              finished => c6 => o_c6 => tracked_run_return(c6, result, o_c6)
            )
          )
        )
      )
    )
  )
}

pub theorem inference_step_ck_handle_in_frame_tracked(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_handle_in(j, c, body, handlers, env)
) {
  tracked_run_bind(
    Ty,
    Ty,
    c,
    (budget_ty: Ty, c1: Checker) => inference_handle_budget(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers)
    ),
    ck_fresh(c),
    tracked_run_read(c, ck_fresh(c), ck_fresh_frame(c), ck_fresh_frame_tracked(c), ordered),
    budget_ty => c1 => o_c1 => inference_handle_budget_frame_tracked(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers),
      ih,
      o_c1
    )
  )
}

