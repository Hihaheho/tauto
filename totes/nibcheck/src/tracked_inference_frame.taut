  )
}
pub theorem access_join_frame_tracked(
  c: Checker,
  b: Ty,
  result: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_join(c, b, result)) {
  match result {
    None => tracked_run_return(c, b, ordered)
    Some(r) => tracked_run_rewrap(c, ck_join(c, r, b), ck_join_run_frame_tracked(c, r, b, ordered))
  }
}

pub theorem ck_join_opt_run_frame_tracked(
  c: Checker,
  result: Option(Ty),
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_join_opt(c, result, b)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_join_unf(c, result, b)),
    access_join_frame_tracked(c, b, result, ordered)
  )
}

pub theorem inference_use_ck_match_arms_in_tracked(
  k: Nat,
  c: Checker,
  arms: List(SurfaceArm),
  s: Ty,
  env: List(Local),
  result: Option(Ty),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_match_arms_in(k, c, arms, s, env, result)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, arms, s, env, result, ordered)
}

pub theorem inference_match_arms_frame_tracked(
  j: Nat,
  c: Checker,
  s: Ty,
  env: List(Local),
  result: Option(Ty),
  arms: List(SurfaceArm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_match_arms(j, c, s, env, result, arms)) {
  match arms {
    Nil => tracked_run_return(c, result, ordered)
    Cons(arm, rest) => inference_bind_scope_frame_tracked(
      <A: Unit, B: Option(Ty)>,
      c,
      (matched: Unit, c1: Checker, inner: Scope) => frame_bind(
        <A: Unit, B: Option(Ty)>,
        (guarded: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Option(Ty)>,
          (armed: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Option(Ty)>,
            (b: Ty, c4: Checker) => frame_bind(
              <A: Ty, B: Option(Ty)>,
              (joined: Ty, c5: Checker) => ck_rewrap1(ck_match_arms_in(j, c5, rest, s, env, Some(joined))),
              ck_join_opt(c4, result, b)
            ),
            ck_infer_in(j, c3, inference_arm_body(arm), inference_scope_items(inner))
          ),
          inference_set_result_hint(c2, ck_result_hint_for(inference_arm_body(arm), inference_arm_hint(c2)))
        ),
        ck_guard_in(j, c1, inference_arm_guard(arm), inference_scope_items(inner))
      ),
      ck_pattern(
        c,
        inference_arm_pattern(arm),
        s,
        ScopeMk(env),
        span_of(inference_arm_body(arm)),
        handle_body_start(inference_arm_body(arm))
      ),
      ck_pattern_frame_tracked(
        c,
        inference_arm_pattern(arm),
        s,
        ScopeMk(env),
        span_of(inference_arm_body(arm)),
        handle_body_start(inference_arm_body(arm)),
        ordered
      ),
      matched => c1 => inner => o_c1 => tracked_run_bind(
        <A: Unit, B: Option(Ty)>,
        c1,
        (guarded: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Option(Ty)>,
          (armed: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Option(Ty)>,
            (b: Ty, c4: Checker) => frame_bind(
              <A: Ty, B: Option(Ty)>,
              (joined: Ty, c5: Checker) => ck_rewrap1(ck_match_arms_in(j, c5, rest, s, env, Some(joined))),
              ck_join_opt(c4, result, b)
            ),
            ck_infer_in(j, c3, inference_arm_body(arm), inference_scope_items(inner))
          ),
          inference_set_result_hint(c2, ck_result_hint_for(inference_arm_body(arm), inference_arm_hint(c2)))
        ),
        ck_guard_in(j, c1, inference_arm_guard(arm), inference_scope_items(inner)),
        inference_use_ck_guard_in_tracked(j, c1, inference_arm_guard(arm), inference_scope_items(inner), o_c1, ih),
        guarded => c2 => o_c2 => tracked_run_bind(
          <A: Unit, B: Option(Ty)>,
          c2,
          (armed: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Option(Ty)>,
            (b: Ty, c4: Checker) => frame_bind(
              <A: Ty, B: Option(Ty)>,
              (joined: Ty, c5: Checker) => ck_rewrap1(ck_match_arms_in(j, c5, rest, s, env, Some(joined))),
              ck_join_opt(c4, result, b)
            ),
            ck_infer_in(j, c3, inference_arm_body(arm), inference_scope_items(inner))
          ),
          inference_set_result_hint(c2, ck_result_hint_for(inference_arm_body(arm), inference_arm_hint(c2))),
          tracked_run_read(
            c2,
            inference_set_result_hint(c2, ck_result_hint_for(inference_arm_body(arm), inference_arm_hint(c2))),
            inference_set_result_hint_frame(c2, ck_result_hint_for(inference_arm_body(arm), inference_arm_hint(c2))),
            inference_set_result_hint_frame_tracked(c2, ck_result_hint_for(inference_arm_body(arm), inference_arm_hint(c2))),
            o_c2
          ),
          armed => c3 => o_c3 => tracked_run_bind(
            <A: Ty, B: Option(Ty)>,
            c3,
            (b: Ty, c4: Checker) => frame_bind(
              <A: Ty, B: Option(Ty)>,
              (joined: Ty, c5: Checker) => ck_rewrap1(ck_match_arms_in(j, c5, rest, s, env, Some(joined))),
              ck_join_opt(c4, result, b)
            ),
            ck_infer_in(j, c3, inference_arm_body(arm), inference_scope_items(inner)),
            inference_use_ck_infer_in_tracked(j, c3, inference_arm_body(arm), inference_scope_items(inner), o_c3, ih),
            b => c4 => o_c4 => tracked_run_bind(
              <A: Ty, B: Option(Ty)>,
              c4,
              (joined: Ty, c5: Checker) => ck_rewrap1(ck_match_arms_in(j, c5, rest, s, env, Some(joined))),
              ck_join_opt(c4, result, b),
              ck_join_opt_run_frame_tracked(c4, result, b, o_c4),
              joined => c5 => o_c5 => tracked_run_rewrap(
                c5,
                ck_match_arms_in(j, c5, rest, s, env, Some(joined)),
                inference_use_ck_match_arms_in_tracked(j, c5, rest, s, env, Some(joined), o_c5, ih)
              )
            )
          )
        )
      )
    )
  }
}

pub theorem inference_step_ck_match_arms_in_frame_tracked(
  j: Nat,
  c: Checker,
  arms: List(SurfaceArm),
  s: Ty,
  env: List(Local),
  result: Option(Ty),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_match_arms_in(j, c, arms, s, env, result)
) { inference_match_arms_frame_tracked(j, c, s, env, result, arms, ih, ordered) }

pub theorem inference_successor_ck_match_arms_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_match_arms_in_tracked(Succ(j)) {
  c => arms => s => env => result => ordered => Eq::subst(
    (z: Mut1(Option(Ty), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_match_arms_in(j, c, arms, s, env, result)),
    inference_step_ck_match_arms_in_frame_tracked(j, c, arms, s, env, result, ih, ordered)
  )
}
pub theorem inference_match_answer_frame_tracked(
  j: Nat,
  c: Checker,
  result: Option(Ty),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_match_answer(j, c, result)) {
  match result {
    None => tracked_run_return(c, TyNever, ordered)
    Some(t) => tracked_run_return(c, t, ordered)
  }
}

pub theorem inference_step_ck_match_expr_in_frame_tracked(
  j: Nat,
  c: Checker,
  scrutinee: SurfaceTerm,
  arms: List(SurfaceArm),
  env: List(Local),
  span: TySpan,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_step_ck_match_expr_in(j, c, scrutinee, arms, env, span)) {
  tracked_run_bind(
    <A: Ty, B: Ty>,
    c,
    (read: Ty, c0: Checker) => frame_bind(
      <A: Ty, B: Ty>,
      (s: Ty, c1: Checker) => frame_bind(
      <A: Option(Ty), B: Ty>,
      (result: Option(Ty), c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (checked: Unit, c3: Checker) => inference_match_answer(j, c3, result),
        ck_check_covers(c2, s, arms, span)
      ),
      ck_match_arms_in(j, c1, arms, s, env, None)
    ),
      ck_coerce_scrutinee(c0, read, arms, span_of(scrutinee))
    ),
    ck_infer_in(j, c, scrutinee, env),
    inference_use_ck_infer_in_tracked(j, c, scrutinee, env, ordered, ih),
    read => c0 => o_c0 => tracked_run_bind(
      <A: Ty, B: Ty>,
      c0,
      (s: Ty, c1: Checker) => frame_bind(
      <A: Option(Ty), B: Ty>,
      (result: Option(Ty), c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (checked: Unit, c3: Checker) => inference_match_answer(j, c3, result),
        ck_check_covers(c2, s, arms, span)
      ),
      ck_match_arms_in(j, c1, arms, s, env, None)
    ),
      ck_coerce_scrutinee(c0, read, arms, span_of(scrutinee)),
      ck_coerce_scrutinee_frame_tracked(c0, read, arms, span_of(scrutinee), o_c0),
      s => c1 => o_c1 => tracked_run_bind(
      <A: Option(Ty), B: Ty>,
      c1,
      (result: Option(Ty), c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (checked: Unit, c3: Checker) => inference_match_answer(j, c3, result),
        ck_check_covers(c2, s, arms, span)
      ),
      ck_match_arms_in(j, c1, arms, s, env, None),
      inference_use_ck_match_arms_in_tracked(j, c1, arms, s, env, None, o_c1, ih),
      result => c2 => o_c2 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c2,
        (checked: Unit, c3: Checker) => inference_match_answer(j, c3, result),
        ck_check_covers(c2, s, arms, span),
        tracked_run_read(
          c2,
          ck_check_covers(c2, s, arms, span),
          ck_check_covers_frame(c2, s, arms, span),
          ck_check_covers_frame_tracked(c2, s, arms, span),
          o_c2
        ),
        checked => c3 => o_c3 => inference_match_answer_frame_tracked(j, c3, result, ih, o_c3)
      )
    )
    )
  )
}

pub theorem inference_successor_ck_match_expr_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_match_expr_in_tracked(Succ(j)) {
  c => scrutinee => arms => env => span => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_match_expr_in(j, c, scrutinee, arms, env, span)),
    inference_step_ck_match_expr_in_frame_tracked(j, c, scrutinee, arms, env, span, ih, ordered)
  )
}
pub theorem inference_successor_ck_handle_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_handle_in_tracked(Succ(j)) {
  c => body => handlers => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_handle_in(j, c, body, handlers, env)),
    inference_step_ck_handle_in_frame_tracked(j, c, body, handlers, env, ih, ordered)
  )
}
pub theorem inference_first_handler_frame_tracked(
  j: Nat,
  c: Checker,
  b: Ty,
  env: List(Local),
  returned: Option(SurfacePattern × SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_first_handler(j, c, b, env, returned)) {
  match returned {
    None => tracked_run_return(c, b, ordered)
    Some(r) => inference_bind_scope_frame_tracked(
      <A: Unit, B: Ty>,
      c,
      (matched: Unit, c1: Checker, inner: Scope) => ck_rewrap1(
        ck_infer_in(j, c1, inference_handler_body(r), inference_scope_items(inner))
      ),
      ck_pattern(
        c,
        inference_handler_pattern(r),
        b,
        ScopeMk(env),
        span_of(inference_handler_body(r)),
        handle_body_start(inference_handler_body(r))
      ),
      ck_pattern_frame_tracked(
        c,
        inference_handler_pattern(r),
        b,
        ScopeMk(env),
        span_of(inference_handler_body(r)),
        handle_body_start(inference_handler_body(r)),
        ordered
      ),
      matched => c1 => inner => o_c1 => tracked_run_rewrap(
        c1,
        ck_infer_in(j, c1, inference_handler_body(r), inference_scope_items(inner)),
        inference_use_ck_infer_in_tracked(
          j,
          c1,
          inference_handler_body(r),
          inference_scope_items(inner),
          o_c1,
          ih
        )
      )
    )
  }
}

pub theorem inference_step_ck_handle_first_in_frame_tracked(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  b: Ty,
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_handle_first_in(j, c, handlers, b, env)
) { inference_first_handler_frame_tracked(j, c, b, env, handlers_return(handlers), ih, ordered) }

