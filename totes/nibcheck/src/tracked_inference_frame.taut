  ck_infer_each_in(k, c, ts, env)
) { And::left(And::right(And::right(And::right(ih))))(c, ts, env, ordered) }

pub theorem argument_terms_frame_tracked(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  p: Ty,
  more: List(Ty),
  args: List(SurfaceTerm),
  ih: ∀ next: Checker. ∀ ps: List(
    Ty
  ). ∀ args: List(
    SurfaceTerm
  ). ∀ ordered: CkOrdered(next). TrackedRunFrame(next, ck_expect_args(rest, next, ps, args)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_terms(a, rest, c, p, more, args)) {
  match args: TrackedRunFrame(c, argument_terms(a, rest, c, p, more, args)) {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(at, atail) => tracked_run_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_expect_args(rest, c1, more, atail)),
      ck_expect(c, a, p, span_of(at), "an argument"),
      ck_expect_run_frame_tracked(c, a, p, span_of(at), "an argument", ordered),
      ignored => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_expect_args(rest, c1, more, atail),
        ih(c1, more, atail, o_c1)
      )
    )
  }
}

pub theorem argument_params_frame_tracked(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  args: List(SurfaceTerm),
  ps: List(Ty),
  ih: ∀ next: Checker. ∀ ps: List(
    Ty
  ). ∀ args: List(
    SurfaceTerm
  ). ∀ ordered: CkOrdered(next). TrackedRunFrame(next, ck_expect_args(rest, next, ps, args)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_params(a, rest, c, args, ps)) {
  match ps: TrackedRunFrame(c, argument_params(a, rest, c, args, ps)) {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(p, more) => argument_terms_frame_tracked(a, rest, c, p, more, args, ih, ordered)
  }
}

pub theorem ck_expect_args_run_frame_tracked(
  tys: List(Ty),
  c: Checker,
  ps: List(Ty),
  args: List(SurfaceTerm),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_expect_args(tys, c, ps, args)) {
  match tys: TrackedRunFrame(c, ck_expect_args(tys, c, ps, args)) {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(a, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
      Eq::sym(argument_cons_unf(a, rest, c, ps, args)),
      argument_params_frame_tracked(
        a,
        rest,
        c,
        args,
        ps,
        next => more => terms => onext => ck_expect_args_run_frame_tracked(
          rest,
          next,
          more,
          terms,
          onext
        ),
        ordered
      )
    )
  }
}

pub theorem application_effect_arity_frame_tracked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ps: List(Ty),
  bad: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_effect_arity(c, eff, types, args, span, ps, bad)) {
  match bad: TrackedRunFrame(c, application_effect_arity(c, eff, types, args, span, ps, bad)) {
    true => tracked_run_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        ),
        ck_error_frame(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      tracked_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        ),
        ck_error_frame_tracked(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      ordered
    )
    false => tracked_run_rewrap(
      c,
      ck_expect_args(types, c, ps, args),
      ck_expect_args_run_frame_tracked(types, c, ps, args, ordered)
    )
  }
}

pub theorem application_effect_inst_frame_tracked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  original: Ty,
  inst: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_effect_inst(c, eff, types, args, span, original, inst)) {
  match inst: TrackedRunFrame(
    c,
    application_effect_inst(c, eff, types, args, span, original, inst)
  ) {
    TyInt(pat_w) => tracked_run_return(c, original, ordered)
    TyBool => tracked_run_return(c, original, ordered)
    TyText => tracked_run_return(c, original, ordered)
    TyUnit => tracked_run_return(c, original, ordered)
    TyNever => tracked_run_return(c, original, ordered)
    TyDecimal => tracked_run_return(c, original, ordered)
    TyFloat => tracked_run_return(c, original, ordered)
    TyFn(ps, r, fk) => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(r, c1),
      application_effect_arity(
        c,
        eff,
        types,
        args,
        span,
        ps,
        not(Nat::eq(list_len(ps), list_len(types)))
      ),
      application_effect_arity_frame_tracked(
        c,
        eff,
        types,
        args,
        span,
        ps,
        not(Nat::eq(list_len(ps), list_len(types))),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, r, o_c1)
    )
    TyUnion(pat_members) => tracked_run_return(c, original, ordered)
    TyProduct(pat_members) => tracked_run_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => tracked_run_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => tracked_run_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => tracked_run_return(c, original, ordered)
    TyInfo(pat_inner) => tracked_run_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => tracked_run_return(c, original, ordered)
    TyVar(pat_v) => tracked_run_return(c, original, ordered)
    TyPoly(pat_generics, pat_inner) => tracked_run_return(c, original, ordered)
    TyApp(pat_head, pat_arg) => tracked_run_return(c, original, ordered)
  }
}

pub theorem application_effect_found_frame_tracked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  found: Option(EffectSig),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_effect_found(c, eff, types, args, span, found)) {
  match found: TrackedRunFrame(c, application_effect_found(c, eff, types, args, span, found)) {
    None => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat3("no effect `", eff, "` is declared"), span),
      tracked_run_read(
        c,
        ck_error(c, cat3("no effect `", eff, "` is declared"), span),
        ck_error_frame(c, cat3("no effect `", eff, "` is declared"), span),
        ck_error_frame_tracked(c, cat3("no effect `", eff, "` is declared"), span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    Some(sig) => tracked_run_bind(
      Ty,
      Ty,
      c,
      (inst: Ty, c1: Checker) => application_effect_inst(c1, eff, types, args, span, inst, inst),
      ck_instantiate_named(c, handle_effect_generics(sig), handle_effect_type(sig)),
      tracked_run_read(
        c,
        ck_instantiate_named(c, handle_effect_generics(sig), handle_effect_type(sig)),
        ck_instantiate_named_frame(c, handle_effect_generics(sig), handle_effect_type(sig)),
        ck_instantiate_named_frame_tracked(c, handle_effect_generics(sig), handle_effect_type(sig)),
        ordered
      ),
      inst => c1 => o_c1 => application_effect_inst_frame_tracked(
        c1,
        eff,
        types,
        args,
        span,
        inst,
        inst,
        o_c1
      )
    )
  }
}

pub theorem ck_perform_of_run_frame_tracked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_perform_of(c, eff, types, args, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(application_effect_unf(c, eff, types, args, span)),
    application_effect_found_frame_tracked(
      c,
      eff,
      types,
      args,
      span,
      Ordmap::get(handle_effects(c), eff, Ordmap::compare_text),
      ordered
    )
  )
}

pub theorem inference_use_ck_handle_in_tracked(
  k: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_handle_in(k, c, body, handlers, env)
) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(
                            And::right(
                              And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, body, handlers, env, ordered)
}

pub theorem ck_unify_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_unify(c, a, b)) {
  tracked_run_grows(c, ck_unify(c, a, b), And::left(ck_unify_ok(c, a, b)(ordered)))
}
pub theorem argument_budget_after_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_budget_after(c, t, span, same)) {
  tracked_run_read(
    c,
    frame_error_if(
      c,
      "budgets answered by one `exceeded` arm give different types",
      span,
      not(same)
    ),
    frame_error_if_ok(
      c,
      "budgets answered by one `exceeded` arm give different types",
      span,
      not(same)
    ),
    frame_error_if_ok_tracked(
      c,
      "budgets answered by one `exceeded` arm give different types",
      span,
      not(same)
    ),
    ordered
  )
}

pub theorem argument_budget_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  exceeded: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_budget(c, t, span, exceeded)) {
  match exceeded: TrackedRunFrame(c, argument_budget(c, t, span, exceeded)) {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(x, rest) => tracked_run_bind(
      Bool,
      Unit,
      c,
      (same: Bool, c1: Checker) => argument_budget_after(c1, t, span, same),
      ck_unify(c, x, t),
      ck_unify_run_frame_tracked(c, x, t, ordered),
      same => c1 => o_c1 => argument_budget_after_frame_tracked(c1, t, span, same, o_c1)
    )
  }
}

pub theorem ck_budget_answer_run_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_budget_answer(c, t, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(argument_budget_unf(c, t, span)),
    argument_budget_frame_tracked(c, t, span, argument_exceeded(c), ordered)
  )
}
pub theorem inference_use_ck_match_expr_in_tracked(
