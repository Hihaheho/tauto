    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body
  )
) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(
                            And::right(
                              And::right(
                                And::right(
                                  And::right(
                                    And::right(
                                      And::right(
                                        And::right(
                                          And::right(
                                            And::right(
                                              And::right(And::right(And::right(And::right(ih))))
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
