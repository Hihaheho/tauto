pub def PatternParamsIH_tracked(
  rest: List(Text)
): Prop := ∀ c: Checker. ∀ env: Scope. ∀ tys: List(
  Ty
). ∀ site: Nat. ∀ ordered: CkOrdered(
  c
). TrackedScopeFrame(c, ck_bind_params(rest, c, env, tys, site))
pub theorem pattern_params_cons_frame_tracked(
  n: Text,
  rest: List(Text),
  c: Checker,
  env: Scope,
  site: Nat,
  tys: List(Ty),
  ih: PatternParamsIH_tracked(rest),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_params_cons(n, rest, c, env, site, tys)) {
  match tys: TrackedScopeFrame(c, pattern_params_cons(n, rest, c, env, site, tys)) {
    Nil => AndIntro(
      ordered,
      AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    )
    Cons(t, more) => tracked_pattern_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, next: Checker, nextenv: Scope) => pattern_rewrap(
        ck_bind_params(rest, next, nextenv, more, site)
      ),
      ck_bind_local(c, env, n, t, false, site),
      ck_bind_local_scope_frame_tracked(c, env, n, t, false, site, ordered),
      ignored => next => nextenv => onext => pattern_rewrap_frame_tracked(
        next,
        ck_bind_params(rest, next, nextenv, more, site),
        ih(next, nextenv, more, site, onext)
      )
    )
  }
}
pub theorem ck_bind_params_scope_frame_tracked(
  names: List(Text),
  c: Checker,
  env: Scope,
  tys: List(Ty),
  site: Nat,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, ck_bind_params(names, c, env, tys, site)) {
  match names: TrackedScopeFrame(c, ck_bind_params(names, c, env, tys, site)) {
    Nil => AndIntro(
      ordered,
      AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    )
    Cons(n, rest) => Eq::subst(
      (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
      Eq::sym(pattern_params_cons_unf(n, rest, c, env, site, tys)),
      pattern_params_cons_frame_tracked(
        n,
        rest,
        c,
        env,
        site,
        tys,
        next => nextenv => more => at => onext => ck_bind_params_scope_frame_tracked(
          rest,
          next,
          nextenv,
          more,
          at,
          onext
        ),
        ordered
      )
    )
  }
}

pub theorem inference_function_assumptions_frame_tracked(
  j: Nat,
  c: Checker,
  f: SurfaceFn,
  scheme: Scheme,
  inner: Scope,
  result: Ty,
  outer: List(Pair(Text, Text)),
  outer_types: List(TypeName),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_function_assumptions(j, c, f, scheme, inner, result, outer, outer_types)
) {
  tracked_run_bind(
    Unit,
    Unit,
    c,
    (assumed: Unit, c1: Checker) => frame_bind(
      Ty,
      Unit,
      (body: Ty, c2: Checker) => frame_bind(
        Unit,
        Unit,
        (restored: Unit, c3: Checker) => frame_bind(
          Unit,
          Unit,
          (popped: Unit, c4: Checker) => ck_rewrap1(
            ck_expect(
              c4,
              body,
              result,
              span_of(inference_fn_body(f)),
              cat3("the result of `", inference_fn_name(f), "`")
            )
          ),
          inference_set_returns(c3, List::tail(inference_returns(c3)))
        ),
        ck_leave_fn(c2, outer, outer_types)
      ),
      ck_infer_in(j, c1, inference_fn_body(f), inference_scope_items(inner))
    ),
    ck_enter_fn(c, scheme),
    tracked_run_read(
      c,
      ck_enter_fn(c, scheme),
      ck_enter_fn_frame(c, scheme),
      ck_enter_fn_frame_tracked(c, scheme),
      ordered
    ),
    assumed => c1 => o_c1 => tracked_run_bind(
      Ty,
      Unit,
      c1,
      (body: Ty, c2: Checker) => frame_bind(
        Unit,
        Unit,
        (restored: Unit, c3: Checker) => frame_bind(
          Unit,
          Unit,
          (popped: Unit, c4: Checker) => ck_rewrap1(
            ck_expect(
              c4,
              body,
              result,
              span_of(inference_fn_body(f)),
              cat3("the result of `", inference_fn_name(f), "`")
            )
          ),
          inference_set_returns(c3, List::tail(inference_returns(c3)))
        ),
        ck_leave_fn(c2, outer, outer_types)
      ),
      ck_infer_in(j, c1, inference_fn_body(f), inference_scope_items(inner)),
      inference_use_ck_infer_in_tracked(
        j,
        c1,
        inference_fn_body(f),
        inference_scope_items(inner),
        o_c1,
        ih
      ),
      body => c2 => o_c2 => tracked_run_bind(
        Unit,
        Unit,
        c2,
        (restored: Unit, c3: Checker) => frame_bind(
          Unit,
          Unit,
          (popped: Unit, c4: Checker) => ck_rewrap1(
            ck_expect(
              c4,
              body,
              result,
              span_of(inference_fn_body(f)),
              cat3("the result of `", inference_fn_name(f), "`")
            )
          ),
          inference_set_returns(c3, List::tail(inference_returns(c3)))
        ),
        ck_leave_fn(c2, outer, outer_types),
        tracked_run_read(
          c2,
          ck_leave_fn(c2, outer, outer_types),
          ck_leave_fn_frame(c2, outer, outer_types),
          ck_leave_fn_frame_tracked(c2, outer, outer_types),
          o_c2
        ),
        restored => c3 => o_c3 => tracked_run_bind(
          Unit,
          Unit,
          c3,
          (popped: Unit, c4: Checker) => ck_rewrap1(
            ck_expect(
              c4,
              body,
              result,
              span_of(inference_fn_body(f)),
              cat3("the result of `", inference_fn_name(f), "`")
            )
          ),
          inference_set_returns(c3, List::tail(inference_returns(c3))),
          tracked_run_read(
            c3,
            inference_set_returns(c3, List::tail(inference_returns(c3))),
            inference_set_returns_frame(c3, List::tail(inference_returns(c3))),
            inference_set_returns_frame_tracked(c3, List::tail(inference_returns(c3))),
            o_c3
          ),
          popped => c4 => o_c4 => tracked_run_rewrap(
            c4,
            ck_expect(
              c4,
              body,
              result,
              span_of(inference_fn_body(f)),
              cat3("the result of `", inference_fn_name(f), "`")
            ),
            ck_expect_run_frame_tracked(
              c4,
              body,
              result,
              span_of(inference_fn_body(f)),
              cat3("the result of `", inference_fn_name(f), "`"),
              o_c4
            )
          )
        )
      )
    )
  )
}

pub theorem inference_function_type_frame_tracked(
  j: Nat,
  c: Checker,
  f: SurfaceFn,
  scheme: Scheme,
  env: List(Local),
  ty: Ty,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_function_type(j, c, f, scheme, env, ty)) {
  match ty: TrackedRunFrame(c, inference_function_type(j, c, f, scheme, env, ty)) {
    TyInt(pat_w) => tracked_run_return(c, Star, ordered)
    TyBool => tracked_run_return(c, Star, ordered)
    TyText => tracked_run_return(c, Star, ordered)
    TyUnit => tracked_run_return(c, Star, ordered)
    TyNever => tracked_run_return(c, Star, ordered)
    TyDecimal => tracked_run_return(c, Star, ordered)
    TyFloat => tracked_run_return(c, Star, ordered)
    TyFn(params, result, fk) => inference_bind_scope_frame_tracked(
      Unit,
      Unit,
      c,
      (bound: Unit, c1: Checker, inner: Scope) => frame_bind(
        Unit,
        Unit,
        (pushed: Unit, c2: Checker) => inference_function_assumptions(
          j,
          c2,
          f,
          scheme,
          inner,
          result,
          inference_assume(c2),
          ck_type_params_of(c2)
        ),
        inference_set_returns(c1, Cons(result, inference_returns(c1)))
      ),
      ck_bind_params(
        inference_fn_params(f),
        c,
        ScopeMk(env),
        params,
        handle_body_start(inference_fn_body(f))
      ),
      ck_bind_params_scope_frame_tracked(
        inference_fn_params(f),
        c,
        ScopeMk(env),
        params,
        handle_body_start(inference_fn_body(f)),
        ordered
      ),
      bound => c1 => inner => o_c1 => tracked_run_bind(
        Unit,
        Unit,
        c1,
        (pushed: Unit, c2: Checker) => inference_function_assumptions(
          j,
          c2,
          f,
          scheme,
          inner,
          result,
          inference_assume(c2),
          ck_type_params_of(c2)
        ),
        inference_set_returns(c1, Cons(result, inference_returns(c1))),
        tracked_run_read(
          c1,
          inference_set_returns(c1, Cons(result, inference_returns(c1))),
          inference_set_returns_frame(c1, Cons(result, inference_returns(c1))),
          inference_set_returns_frame_tracked(c1, Cons(result, inference_returns(c1))),
          o_c1
        ),
        pushed => c2 => o_c2 => inference_function_assumptions_frame_tracked(
          j,
          c2,
          f,
          scheme,
          inner,
          result,
          inference_assume(c2),
          ck_type_params_of(c2),
          ih,
          o_c2
        )
      )
    )
    TyUnion(pat_members) => tracked_run_return(c, Star, ordered)
    TyProduct(pat_members) => tracked_run_return(c, Star, ordered)
    TyTagged(pat_tags, pat_inner) => tracked_run_return(c, Star, ordered)
    TyNamed(pat_name, pat_args) => tracked_run_return(c, Star, ordered)
    TyParam(pat_name, pat_bound) => tracked_run_return(c, Star, ordered)
    TyInfo(pat_inner) => tracked_run_return(c, Star, ordered)
    TyBorrow(pat_inner, pat_mutable) => tracked_run_return(c, Star, ordered)
    TyVar(pat_v) => tracked_run_return(c, Star, ordered)
    TyPoly(pat_generics, pat_inner) => tracked_run_return(c, Star, ordered)
    TyApp(pat_head, pat_arg) => tracked_run_return(c, Star, ordered)
  }
}

pub theorem inference_step_ck_check_fn_in_frame_tracked(
  j: Nat,
  c: Checker,
  f: SurfaceFn,
  scheme: Scheme,
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_check_fn_in(j, c, f, scheme, env)
) {
  inference_function_type_frame_tracked(
    j,
    c,
    f,
    scheme,
    env,
    inference_scheme_type(scheme),
    ih,
    ordered
  )
}

pub theorem inference_successor_ck_check_fn_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_check_fn_in_tracked(
  Succ(j)
) {
  c => f => scheme => env => ordered => Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_check_fn_in(j, c, f, scheme, env)),
    inference_step_ck_check_fn_in_frame_tracked(j, c, f, scheme, env, ih, ordered)
  )
}
pub theorem inference_argument_hint_frame_tracked(
  j: Nat,
  c: Checker,
  a: SurfaceTerm,
  rest: List(SurfaceTerm),
  known: Option(List(Ty)),
  env: List(Local),
  i: Nat,
  expected: Option(Ty),
  lambda: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_argument_hint(j, c, a, rest, known, env, i, expected, lambda)) {
  match lambda: TrackedRunFrame(
    c,
    inference_argument_hint(j, c, a, rest, known, env, i, expected, lambda)
  ) {
    true => tracked_run_read(
      c,
      inference_set_hint(c, expected),
      inference_set_hint_frame(c, expected),
      inference_set_hint_frame_tracked(c, expected),
      ordered
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem argument_expected_frame_tracked(
  c: Checker,
  t: Ty,
  a: SurfaceTerm,
  expected: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_expected(c, t, a, expected)) {
  match expected: TrackedRunFrame(c, argument_expected(c, t, a, expected)) {
    None => tracked_run_return(c, Star, ordered)
    Some(p) => tracked_run_rewrap(
      c,
      ck_expect(c, t, p, span_of(a), "an argument"),
      ck_expect_run_frame_tracked(c, t, p, span_of(a), "an argument", ordered)
    )
  }
}

pub theorem ck_expect_opt_run_frame_tracked(
  c: Checker,
  t: Ty,
  expected: Option(Ty),
  a: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_expect_opt(c, t, expected, a)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(argument_expected_unf(c, t, expected, a)),
    argument_expected_frame_tracked(c, t, a, expected, ordered)
  )
}
pub theorem inference_use_ck_app_args_in_tracked(
  k: Nat,
  c: Checker,
  arguments: List(SurfaceTerm),
  known: Option(List(Ty)),
  env: List(Local),
  i: Nat,
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_app_args_in(k, c, arguments, known, env, i)
) {
  And::left(
    And::right(
      And::right(And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih))))))))
    )
  )(c, arguments, known, env, i, ordered)
}

pub theorem inference_argument_frame_tracked(
  j: Nat,
  c: Checker,
  a: SurfaceTerm,
  rest: List(SurfaceTerm),
  known: Option(List(Ty)),
  env: List(Local),
  i: Nat,
  expected: Option(Ty),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_argument(j, c, a, rest, known, env, i, expected)) {
  tracked_run_bind(
    Unit,
    List(Ty),
    c,
    (ignored: Unit, c1: Checker) => frame_bind(
      Ty,
      List(Ty),
      (t: Ty, c2: Checker) => frame_bind(
        Unit,
        List(Ty),
        (cleared: Unit, c3: Checker) => frame_bind(
          Unit,
          List(Ty),
          (checked: Unit, c4: Checker) => frame_bind(
            List(Ty),
            List(Ty),
            (tl: List(Ty), c5: Checker) => mut1(Cons(t, tl), c5),
            ck_app_args_in(j, c4, rest, known, env, Nat::add(i, 1))
          ),
          ck_expect_opt(c3, t, expected, a)
        ),
        inference_set_hint(c2, None)
      ),
      ck_infer_in(j, c1, a, env)
    ),
    inference_argument_hint(j, c, a, rest, known, env, i, expected, ck_is_lambda(a)),
    inference_argument_hint_frame_tracked(
      j,
      c,
      a,
      rest,
      known,
      env,
      i,
      expected,
      ck_is_lambda(a),
      ih,
      ordered
    ),
    ignored => c1 => o_c1 => tracked_run_bind(
      Ty,
      List(Ty),
      c1,
      (t: Ty, c2: Checker) => frame_bind(
        Unit,
        List(Ty),
        (cleared: Unit, c3: Checker) => frame_bind(
          Unit,
          List(Ty),
          (checked: Unit, c4: Checker) => frame_bind(
            List(Ty),
            List(Ty),
            (tl: List(Ty), c5: Checker) => mut1(Cons(t, tl), c5),
            ck_app_args_in(j, c4, rest, known, env, Nat::add(i, 1))
          ),
          ck_expect_opt(c3, t, expected, a)
        ),
        inference_set_hint(c2, None)
      ),
      ck_infer_in(j, c1, a, env),
      inference_use_ck_infer_in_tracked(j, c1, a, env, o_c1, ih),
      t => c2 => o_c2 => tracked_run_bind(
        Unit,
        List(Ty),
        c2,
        (cleared: Unit, c3: Checker) => frame_bind(
          Unit,
          List(Ty),
          (checked: Unit, c4: Checker) => frame_bind(
            List(Ty),
            List(Ty),
            (tl: List(Ty), c5: Checker) => mut1(Cons(t, tl), c5),
            ck_app_args_in(j, c4, rest, known, env, Nat::add(i, 1))
          ),
          ck_expect_opt(c3, t, expected, a)
        ),
        inference_set_hint(c2, None),
        tracked_run_read(
          c2,
          inference_set_hint(c2, None),
          inference_set_hint_frame(c2, None),
          inference_set_hint_frame_tracked(c2, None),
          o_c2
        ),
        cleared => c3 => o_c3 => tracked_run_bind(
          Unit,
          List(Ty),
          c3,
          (checked: Unit, c4: Checker) => frame_bind(
            List(Ty),
            List(Ty),
            (tl: List(Ty), c5: Checker) => mut1(Cons(t, tl), c5),
            ck_app_args_in(j, c4, rest, known, env, Nat::add(i, 1))
          ),
          ck_expect_opt(c3, t, expected, a),
          ck_expect_opt_run_frame_tracked(c3, t, expected, a, o_c3),
          checked => c4 => o_c4 => tracked_run_bind(
            List(Ty),
            List(Ty),
            c4,
            (tl: List(Ty), c5: Checker) => mut1(Cons(t, tl), c5),
            ck_app_args_in(j, c4, rest, known, env, Nat::add(i, 1)),
            inference_use_ck_app_args_in_tracked(j, c4, rest, known, env, Nat::add(i, 1), o_c4, ih),
            tl => c5 => o_c5 => tracked_run_return(c5, Cons(t, tl), o_c5)
          )
        )
      )
    )
  )
}

pub theorem inference_arguments_frame_tracked(
  j: Nat,
  c: Checker,
  known: Option(List(Ty)),
  env: List(Local),
  i: Nat,
  arguments: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_arguments(j, c, known, env, i, arguments)) {
  match arguments: TrackedRunFrame(c, inference_arguments(j, c, known, env, i, arguments)) {
    Nil => tracked_run_return(c, Nil, ordered)
    Cons(a, rest) => inference_argument_frame_tracked(
      j,
      c,
      a,
      rest,
      known,
      env,
      i,
      ck_expected(known, i),
      ih,
      ordered
    )
  }
}

pub theorem inference_step_ck_app_args_in_frame_tracked(
  j: Nat,
  c: Checker,
  arguments: List(SurfaceTerm),
  known: Option(List(Ty)),
  env: List(Local),
  i: Nat,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_app_args_in(j, c, arguments, known, env, i)
) { inference_arguments_frame_tracked(j, c, known, env, i, arguments, ih, ordered) }

pub theorem inference_successor_ck_app_args_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_app_args_in_tracked(
  Succ(j)
) {
  c => arguments => known => env => i => ordered => Eq::subst(
    (z: Mut1(List(Ty), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_app_args_in(j, c, arguments, known, env, i)),
    inference_step_ck_app_args_in_frame_tracked(j, c, arguments, known, env, i, ih, ordered)
  )
}
pub theorem inference_use_ck_app_call_in_tracked(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_app_call_in(k, c, term, function, arguments, env)
) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih))))))))
        )
      )
    )
  )(c, term, function, arguments, env, ordered)
}

pub theorem operator_unary_number_frame_tracked(
  c: Checker,
  op: Text,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  a: Ty,
  number: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_unary_number(c, op, arguments, span, occurrence, a, number)) {
  match number: TrackedRunFrame(
    c,
    operator_unary_number(c, op, arguments, span, occurrence, a, number)
  ) {
    true => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (ignored2: Unit, c2: Checker) => mut1(a, c2),
        ck_record_op(c1, a, span, occurrence)
      ),
      ck_number(c, a, span, op),
      tracked_run_read(
        c,
        ck_number(c, a, span, op),
        ck_number_frame(c, a, span, op),
        ck_number_frame_tracked(c, a, span, op),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_bind(
        Unit,
        Ty,
        c1,
        (ignored2: Unit, c2: Checker) => mut1(a, c2),
        ck_record_op(c1, a, span, occurrence),
        tracked_run_read(
          c1,
          ck_record_op(c1, a, span, occurrence),
          ck_record_op_frame(c1, a, span, occurrence),
          ck_record_op_frame_tracked(c1, a, span, occurrence),
          o_c1
        ),
        ignored2 => c2 => o_c2 => tracked_run_return(c2, a, o_c2)
      )
    )
    false => tracked_run_read(
      c,
      ck_rewrap1(ck_operator_bad(c, op, span)),
      frame_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame(c, op, span)),
      tracked_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame_tracked(c, op, span)),
      ordered
    )
  }
}

pub theorem operator_unary_frame_tracked(
  c: Checker,
  op: Text,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  a: Ty,
  negate: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_unary(c, op, arguments, span, occurrence, a, negate)) {
  match negate: TrackedRunFrame(c, operator_unary(c, op, arguments, span, occurrence, a, negate)) {
    true => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(TyBool, c1),
      ck_expect(c, a, TyBool, span, "`not`"),
      ck_expect_run_frame_tracked(c, a, TyBool, span, "`not`", ordered),
      ignored => c1 => o_c1 => tracked_run_return(c1, TyBool, o_c1)
    )
    false => operator_unary_number_frame_tracked(
      c,
      op,
      arguments,
      span,
      occurrence,
      a,
      Bool::or(Text::eq(op, "-"), Text::eq(op, "+")),
      ordered
    )
  }
}

pub theorem operator_failed_result_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  arithmetic: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_failed_result(c, op, a, b, arguments, span, arithmetic)) {
  match arithmetic: TrackedRunFrame(
    c,
    operator_failed_result(c, op, a, b, arguments, span, arithmetic)
  ) {
    true => tracked_run_return(c, ck_shown(c, a), ordered)
    false => tracked_run_return(c, TyBool, ordered)
  }
}

pub theorem operator_div_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  div: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_div(c, op, a, b, arguments, span, occurrence, div)) {
  match div: TrackedRunFrame(c, operator_div(c, op, a, b, arguments, span, occurrence, div)) {
    true => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(a, c1),
      ck_divide(c, a, span),
      tracked_run_read(
        c,
        ck_divide(c, a, span),
        ck_divide_frame(c, a, span),
        ck_divide_frame_tracked(c, a, span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, a, o_c1)
    )
    false => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (ignored2: Unit, c2: Checker) => mut1(a, c2),
        ck_record_op(c1, a, span, occurrence)
      ),
      ck_number(c, a, span, op),
      tracked_run_read(
        c,
        ck_number(c, a, span, op),
        ck_number_frame(c, a, span, op),
        ck_number_frame_tracked(c, a, span, op),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_bind(
        Unit,
        Ty,
        c1,
        (ignored2: Unit, c2: Checker) => mut1(a, c2),
        ck_record_op(c1, a, span, occurrence),
        tracked_run_read(
          c1,
          ck_record_op(c1, a, span, occurrence),
          ck_record_op_frame(c1, a, span, occurrence),
          ck_record_op_frame_tracked(c1, a, span, occurrence),
          o_c1
        ),
        ignored2 => c2 => o_c2 => tracked_run_return(c2, a, o_c2)
      )
    )
  }
}

pub theorem operator_compare_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  cmp: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_compare(c, op, a, b, arguments, span, occurrence, cmp)) {
  match cmp: TrackedRunFrame(c, operator_compare(c, op, a, b, arguments, span, occurrence, cmp)) {
    true => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(TyBool, c1),
      ck_number(c, a, span, op),
      tracked_run_read(
        c,
        ck_number(c, a, span, op),
        ck_number_frame(c, a, span, op),
        ck_number_frame_tracked(c, a, span, op),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, TyBool, o_c1)
    )
    false => operator_div_frame_tracked(
      c,
      op,
      a,
      b,
      arguments,
      span,
      occurrence,
      Text::eq(op, "/"),
      ordered
    )
  }
}

pub theorem operator_eq_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  eq: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_eq(c, op, a, b, arguments, span, occurrence, eq)) {
  match eq: TrackedRunFrame(c, operator_eq(c, op, a, b, arguments, span, occurrence, eq)) {
    true => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(TyBool, c1),
      ck_pend(c, "PartialEq", a, op, span),
      tracked_run_read(
        c,
        ck_pend(c, "PartialEq", a, op, span),
        ck_pend_frame(c, "PartialEq", a, op, span),
        ck_pend_frame_tracked(c, "PartialEq", a, op, span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, TyBool, o_c1)
    )
    false => operator_compare_frame_tracked(
      c,
      op,
      a,
      b,
      arguments,
      span,
      occurrence,
      Bool::or(Bool::or(Bool::or(Text::eq(op, "<"), Text::eq(op, ">")), Text::eq(op, "<=")), Text::eq(op, ">=")),
      ordered
    )
  }
}

pub theorem operator_unified_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  failed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_unified(c, op, a, b, arguments, span, occurrence, failed)) {
  match failed: TrackedRunFrame(
    c,
    operator_unified(c, op, a, b, arguments, span, occurrence, failed)
  ) {
    true => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => operator_failed_result(
        c1,
        op,
        a,
        b,
        arguments,
        span,
        op_is_arithmetic(op)
      ),
      ck_error(
        c,
        ck_operands_differ(c, op, a, b, arguments),
        span
      ),
      tracked_run_read(
        c,
        ck_error(
          c,
          ck_operands_differ(c, op, a, b, arguments),
          span
        ),
        ck_error_frame(
          c,
          ck_operands_differ(c, op, a, b, arguments),
          span
        ),
        ck_error_frame_tracked(
          c,
          ck_operands_differ(c, op, a, b, arguments),
          span
        ),
        ordered
      ),
      ignored => c1 => o_c1 => operator_failed_result_frame_tracked(
        c1,
        op,
        a,
        b,
        arguments,
        span,
        op_is_arithmetic(op),
        o_c1
      )
    )
    false => operator_eq_frame_tracked(
      c,
      op,
      a,
      b,
      arguments,
      span,
      occurrence,
      Bool::or(Text::eq(op, "=="), Text::eq(op, "!=")),
      ordered
    )
  }
}

pub theorem operator_binary_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  boolean: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_binary(c, op, a, b, arguments, span, occurrence, boolean)) {
  match boolean: TrackedRunFrame(
    c,
    operator_binary(c, op, a, b, arguments, span, occurrence, boolean)
  ) {
    true => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (ignored2: Unit, c2: Checker) => mut1(TyBool, c2),
        ck_expect(c1, b, TyBool, second_span(arguments, span), cat3("`", op, "`"))
      ),
      ck_expect(c, a, TyBool, first_span(arguments, span), cat3("`", op, "`")),
      ck_expect_run_frame_tracked(
        c,
        a,
        TyBool,
        first_span(arguments, span),
        cat3("`", op, "`"),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_bind(
        Unit,
        Ty,
        c1,
        (ignored2: Unit, c2: Checker) => mut1(TyBool, c2),
        ck_expect(c1, b, TyBool, second_span(arguments, span), cat3("`", op, "`")),
        ck_expect_run_frame_tracked(
          c1,
          b,
          TyBool,
          second_span(arguments, span),
          cat3("`", op, "`"),
          o_c1
        ),
        ignored2 => c2 => o_c2 => tracked_run_return(c2, TyBool, o_c2)
      )
    )
    false => tracked_run_bind(
      Bool,
      Ty,
      c,
      (unified: Bool, c1: Checker) => operator_unified(
        c1,
        op,
        a,
        b,
        arguments,
        span,
        occurrence,
        not(unified)
      ),
      ck_unify(c, a, b),
      ck_unify_run_frame_tracked(c, a, b, ordered),
      unified => c1 => o_c1 => operator_unified_frame_tracked(
        c1,
        op,
        a,
        b,
        arguments,
        span,
        occurrence,
        not(unified),
        o_c1
      )
    )
  }
}

pub theorem ck_binary_run_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  ck_binary(c, op, a, b, arguments, span, occurrence)
) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(operator_binary_unf(c, op, a, b, arguments, span, occurrence)),
    operator_binary_frame_tracked(
      c,
      op,
      a,
      b,
      arguments,
      span,
      occurrence,
      Bool::or(Text::eq(op, "&&"), Text::eq(op, "||")),
      ordered
    )
  )
}

pub theorem operator_more_frame_tracked(
  c: Checker,
  op: Text,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  a: Ty,
  b: Ty,
  more: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_more(c, op, arguments, span, occurrence, a, b, more)) {
  match more: TrackedRunFrame(c, operator_more(c, op, arguments, span, occurrence, a, b, more)) {
    Nil => tracked_run_rewrap(
      c,
      ck_binary(c, op, a, b, arguments, span, occurrence),
      ck_binary_run_frame_tracked(c, op, a, b, arguments, span, occurrence, ordered)
    )
    Cons(x, y) => tracked_run_read(
      c,
      ck_rewrap1(ck_operator_bad(c, op, span)),
      frame_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame(c, op, span)),
      tracked_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame_tracked(c, op, span)),
      ordered
    )
  }
}

pub theorem operator_rest_frame_tracked(
  c: Checker,
  op: Text,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  a: Ty,
  rest: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_rest(c, op, arguments, span, occurrence, a, rest)) {
  match rest: TrackedRunFrame(c, operator_rest(c, op, arguments, span, occurrence, a, rest)) {
    Nil => operator_unary_frame_tracked(
      c,
      op,
      arguments,
      span,
      occurrence,
      a,
      Text::eq(op, "not"),
      ordered
    )
    Cons(b, more) => operator_more_frame_tracked(
      c,
      op,
      arguments,
      span,
      occurrence,
      a,
      b,
      more,
      ordered
    )
  }
}

pub theorem operator_operands_frame_tracked(
  c: Checker,
  op: Text,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  args: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_operands(c, op, arguments, span, occurrence, args)) {
  match args: TrackedRunFrame(c, operator_operands(c, op, arguments, span, occurrence, args)) {
    Nil => tracked_run_read(
      c,
      ck_rewrap1(ck_operator_bad(c, op, span)),
      frame_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame(c, op, span)),
      tracked_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame_tracked(c, op, span)),
      ordered
    )
    Cons(a, rest) => operator_rest_frame_tracked(
      c,
      op,
      arguments,
      span,
      occurrence,
      a,
      rest,
      ordered
    )
  }
}

pub theorem ck_operator_of_run_frame_tracked(
  c: Checker,
  op: Text,
  args: List(Ty),
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  ck_operator_of(c, op, args, arguments, span, occurrence)
) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(operator_operands_unf(c, op, args, arguments, span, occurrence)),
    operator_operands_frame_tracked(c, op, arguments, span, occurrence, args, ordered)
  )
}
pub theorem inference_use_ck_clone_of_in_tracked(
  k: Nat,
  c: Checker,
  arguments: List(SurfaceTerm),
  env: List(Local),
  span: TySpan,
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_clone_of_in(k, c, arguments, env, span)
) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih)))))))
              )
            )
          )
        )
      )
    )
  )(c, arguments, env, span, ordered)
}

pub theorem inference_app_clone_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  clone: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_clone(j, c, term, function, arguments, env, name, clone)) {
  match clone: TrackedRunFrame(
    c,
    inference_app_clone(j, c, term, function, arguments, env, name, clone)
  ) {
    true => tracked_run_rewrap(
      c,
      ck_clone_of_in(j, c, arguments, env, span_of(term)),
      inference_use_ck_clone_of_in_tracked(j, c, arguments, env, span_of(term), ordered, ih)
    )
    false => tracked_run_rewrap(
      c,
      ck_app_call_in(j, c, term, function, arguments, env),
      inference_use_ck_app_call_in_tracked(j, c, term, function, arguments, env, ordered, ih)
    )
  }
}

pub theorem inference_app_operator_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  operator: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_operator(j, c, term, function, arguments, env, name, operator)) {
  match operator: TrackedRunFrame(
    c,
    inference_app_operator(j, c, term, function, arguments, env, name, operator)
  ) {
    true => tracked_run_bind(
      List(Ty),
      Ty,
      c,
      (args: List(Ty), c1: Checker) => ck_rewrap1(
        ck_operator_of(c1, name, args, arguments, span_of(term), term.occurrence)
      ),
      ck_operands_in(j, c, arguments, env),
      inference_use_ck_operands_in_tracked(j, c, arguments, env, ordered, ih),
      args => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_operator_of(c1, name, args, arguments, span_of(term), term.occurrence),
        ck_operator_of_run_frame_tracked(
          c1,
          name,
          args,
          arguments,
          span_of(term),
          term.occurrence,
          o_c1
        )
      )
    )
    false => inference_app_clone_frame_tracked(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Bool::and(
        Text::eq(name, "clone"),
        not(Ordmap::contains(inference_fns(c), name, Ordmap::compare_text))
      ),
      ih,
      ordered
    )
  }
}

pub theorem inference_app_tuple_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  tuple: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_tuple(j, c, term, function, arguments, env, name, tuple)) {
  match tuple: TrackedRunFrame(
    c,
    inference_app_tuple(j, c, term, function, arguments, env, name, tuple)
  ) {
    true => tracked_run_return(c, TyUnit, ordered)
    false => inference_app_operator_frame_tracked(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      ck_is_operator(name),
      ih,
      ordered
    )
  }
}

pub theorem inference_app_name_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  r#direct: Option(Text),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_name(j, c, term, function, arguments, env, r#direct)) {
  match r#direct: TrackedRunFrame(
    c,
    inference_app_name(j, c, term, function, arguments, env, r#direct)
  ) {
    None => tracked_run_rewrap(
      c,
      ck_app_call_in(j, c, term, function, arguments, env),
      inference_use_ck_app_call_in_tracked(j, c, term, function, arguments, env, ordered, ih)
    )
    Some(name) => inference_app_tuple_frame_tracked(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Bool::and(Text::eq(name, "Tuple"), Nat::eq(list_len(arguments), 0)),
      ih,
      ordered
    )
  }
}

pub theorem inference_step_ck_app_in_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_app_in(j, c, term, function, arguments, env)
) {
  inference_app_name_frame_tracked(
    j,
    c,
    term,
    function,
    arguments,
    env,
    ck_direct_name(function, env),
    ih,
    ordered
  )
}

pub theorem inference_successor_ck_app_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_app_in_tracked(
  Succ(j)
) {
  c => term => function => arguments => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_app_in(j, c, term, function, arguments, env)),
    inference_step_ck_app_in_frame_tracked(j, c, term, function, arguments, env, ih, ordered)
  )
}
pub theorem ck_instance_of_run_frame_tracked(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_instance_of(gs, c)) {
  tracked_run_grows(c, ck_instance_of(gs, c), And::left(inst_ok(gs, c))(ordered))
}
pub theorem access_poly_frame_tracked(
  c: Checker,
  function: SurfaceTerm,
  original: Ty,
  f: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_poly(c, function, original, f)) {
  match f: TrackedRunFrame(c, access_poly(c, function, original, f)) {
    TyInt(pat_w) => tracked_run_return(c, original, ordered)
    TyBool => tracked_run_return(c, original, ordered)
    TyText => tracked_run_return(c, original, ordered)
    TyUnit => tracked_run_return(c, original, ordered)
    TyNever => tracked_run_return(c, original, ordered)
    TyDecimal => tracked_run_return(c, original, ordered)
    TyFloat => tracked_run_return(c, original, ordered)
    TyFn(pat_params, pat_result, pat_kind) => tracked_run_return(c, original, ordered)
    TyUnion(pat_members) => tracked_run_return(c, original, ordered)
    TyProduct(pat_members) => tracked_run_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => tracked_run_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => tracked_run_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => tracked_run_return(c, original, ordered)
    TyInfo(pat_inner) => tracked_run_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => tracked_run_return(c, original, ordered)
    TyVar(pat_v) => tracked_run_return(c, original, ordered)
    TyPoly(gs, t) => tracked_run_bind(
      Ordmap(Text, Ty),
      Ty,
      c,
      (fresh: Ordmap(Text, Ty), c1: Checker) => frame_bind(
        Unit,
        Ty,
        (ignored: Unit, c2: Checker) => mut1(ty_substitute(t, fresh), c2),
        access_record_term(c1, function, ty_substitute(t, fresh))
      ),
      ck_instance_of(gs, c),
      ck_instance_of_run_frame_tracked(gs, c, ordered),
      fresh => c1 => o_c1 => tracked_run_bind(
        Unit,
        Ty,
        c1,
        (ignored: Unit, c2: Checker) => mut1(ty_substitute(t, fresh), c2),
        access_record_term(c1, function, ty_substitute(t, fresh)),
        tracked_run_read(
          c1,
          access_record_term(c1, function, ty_substitute(t, fresh)),
          access_record_term_frame(c1, function, ty_substitute(t, fresh)),
          access_record_term_frame_tracked(c1, function, ty_substitute(t, fresh)),
          o_c1
        ),
        ignored => c2 => o_c2 => tracked_run_return(c2, ty_substitute(t, fresh), o_c2)
      )
    )
    TyApp(pat_head, pat_arg) => tracked_run_return(c, original, ordered)
  }
}

pub theorem ck_poly_instance_run_frame_tracked(
  c: Checker,
  function: SurfaceTerm,
  f: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  ck_poly_instance(c, function, f)
) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_poly_unf(c, function, f)),
    access_poly_frame_tracked(c, function, f, ck_resolve(c, f), ordered)
  )
}
pub theorem application_fn_arity_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  arguments: List(SurfaceTerm),
  args: List(Ty),
  ps: List(Ty),
  bad: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_fn_arity(c, term, arguments, args, ps, bad)) {
  match bad: TrackedRunFrame(c, application_fn_arity(c, term, arguments, args, ps, bad)) {
    true => tracked_run_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        ),
        ck_error_frame(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        )
      ),
      tracked_rewrap(
        c,
        ck_error(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        ),
        ck_error_frame_tracked(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        )
      ),
      ordered
    )
    false => tracked_run_rewrap(
      c,
      ck_expect_args(args, c, ps, arguments),
      ck_expect_args_run_frame_tracked(args, c, ps, arguments, ordered)
    )
  }
}

pub theorem application_fn_known_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  arguments: List(SurfaceTerm),
  args: List(Ty),
  ps: List(Ty),
  r: Ty,
  known: Option(List(Ty)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_fn_known(c, term, arguments, args, ps, r, known)) {
  match known: TrackedRunFrame(c, application_fn_known(c, term, arguments, args, ps, r, known)) {
    Some(kp) => tracked_run_return(c, r, ordered)
    None => tracked_run_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(r, c1),
      application_fn_arity(
        c,
        term,
        arguments,
        args,
        ps,
        not(Nat::eq(list_len(ps), list_len(args)))
      ),
      application_fn_arity_frame_tracked(
        c,
        term,
        arguments,
        args,
        ps,
        not(Nat::eq(list_len(ps), list_len(args))),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, r, o_c1)
    )
  }
}

pub theorem application_fn_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  f: Ty,
  known: Option(List(Ty)),
  args: List(Ty),
  original: Ty,
  fr: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_fn(c, term, function, arguments, f, known, args, original, fr)) {
  match fr: TrackedRunFrame(
    c,
    application_fn(c, term, function, arguments, f, known, args, original, fr)
  ) {
