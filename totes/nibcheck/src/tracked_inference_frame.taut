pub theorem ck_infer_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_infer(c, term, env)) {
  tracked_run_rewrap(
    c,
    ck_infer_in(ck_steps_of(c), c, term, env),
    ck_infer_in_frame_tracked(ck_steps_of(c), c, term, env, ordered)
  )
}

