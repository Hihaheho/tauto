    ck_check_fn_in_frame_tracked(ck_steps_of(c), c, f, scheme, env, ordered)
  )
}

pub theorem leaf_ascribed_at_frame_tracked(
  c: Checker,
  b: Ty,
  want: Ty,
  span: TySpan,
  under: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_ascribed_at(c, b, want, span, under)) {
  match under {
    Some(inner) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(ascribe_member(c1, want), c1),
      ck_expect(c, inner, want, span, what_ascription_message()),
      ck_expect_run_frame_tracked(c, inner, want, span, what_ascription_message(), ordered),
      ignored => c1 => o_c1 => tracked_run_return(c1, ascribe_member(c1, want), o_c1)
    )
    None => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(ascribe_plain(c1, want), c1),
      ck_expect(c, b, want, span, what_ascription_message()),
      ck_expect_run_frame_tracked(c, b, want, span, what_ascription_message(), ordered),
      ignored => c1 => o_c1 => tracked_run_return(c1, ascribe_plain(c1, want), o_c1)
    )
  }
}

pub theorem ck_ascribe_of_run_frame_tracked(
  c: Checker,
  types: List(Ty),
  term: SurfaceTerm,
  arguments: List(SurfaceTerm),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_ascribe_of(c, types, term, arguments)) {
  tracked_run_rewrap(c, ck_ascribed(c, ascribe_found(types), ascribe_type(arguments, term), span_of(ascribe_term(arguments, term))),
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(ck_ascribed_unf(c, ascribe_found(types), ascribe_type(arguments, term), span_of(ascribe_term(arguments, term)))),
    tracked_run_bind(
      <A: Ty, B: Ty>,
      c,
      (want: Ty, c1: Checker) => ck_rewrap1(ck_ascribed_at(
        c1,
        ascribe_found(types),
        want,
        span_of(ascribe_term(arguments, term)),
        ascribe_under(c1, ascribe_found(types), want)
      )),
      ck_written_here(c, ascribe_type(arguments, term)),
      tracked_run_read(
        c,
        ck_written_here(c, ascribe_type(arguments, term)),
        ck_written_here_frame(c, ascribe_type(arguments, term)),
        ck_written_here_frame_tracked(c, ascribe_type(arguments, term)),
        ordered
      ),
      want => c1 => o_c1 => tracked_run_rewrap(c1, ck_ascribed_at(c1, ascribe_found(types), want, span_of(ascribe_term(arguments, term)), ascribe_under(c1, ascribe_found(types), want)), leaf_ascribed_at_frame_tracked(
        c1,
        ascribe_found(types),
        want,
        span_of(ascribe_term(arguments, term)),
        ascribe_under(c1, ascribe_found(types), want),
        o_c1
      ))
    )
  ))

}
