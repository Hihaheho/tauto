      inference_use_ck_handle_one_in_tracked(j, c, h, env, result, rv, budget_ty, ordered, ih),
      ignored => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_handle_arms_in(j, c1, rest, env, result, rv, budget_ty),
        inference_use_ck_handle_arms_in_tracked(j, c1, rest, env, result, rv, budget_ty, o_c1, ih)
