  )
}

pub theorem binding_assign_borrow_frame_tracked(
  c: Checker,
  name: Text,
  deref: Bool,
  v: Ty,
  value: SurfaceTerm,
  inner: Ty,
  mutable: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign_borrow(c, name, deref, v, value, inner, mutable)) {
  match mutable {
    true => ⊢ TrackedRunFrame(c, binding_assign_borrow(c, name, deref, v, value, inner, true)) from match deref {
      true => tracked_run_rewrap(
        c,
        ck_expect(c, v, inner, span_of(value), cat3("`", name, "`")),
        ck_expect_run_frame_tracked(c, v, inner, span_of(value), cat3("`", name, "`"), ordered)
      )
      false => tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, assign_through_borrow_message(name), span_of(value))),
        frame_rewrap(
          c,
          ck_error(c, assign_through_borrow_message(name), span_of(value)),
          ck_error_frame(c, assign_through_borrow_message(name), span_of(value))
        ),
        tracked_rewrap(
          c,
          ck_error(c, assign_through_borrow_message(name), span_of(value)),
          ck_error_frame_tracked(c, assign_through_borrow_message(name), span_of(value))
        ),
        ordered
      )
    }
    false => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
  }
}

pub theorem binding_assign_type_frame_tracked(
  c: Checker,
  name: Text,
  deref: Bool,
  v: Ty,
  value: SurfaceTerm,
  t: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign_type(c, name, deref, v, value, t)) {
  match t {
    TyInt(pat_w) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyBool => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyText => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyUnit => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyNever => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyDecimal => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyFloat => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyFloat32 => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyFn(pat_params, pat_result, pat_kind) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyUnion(pat_members) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyProduct(pat_members) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyTagged(pat_tags, pat_inner) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyNamed(pat_name, pat_args) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyParam(pat_name, pat_bound) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyInfo(pat_inner) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyBorrow(inner, m) => binding_assign_borrow_frame_tracked(c, name, deref, v, value, inner, m, ordered)
    TyVar(pat_v) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyPoly(pat_generics, pat_inner) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
    TyApp(pat_head, pat_arg) => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, binding_refused_message(name, deref), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame(c, binding_refused_message(name, deref), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, binding_refused_message(name, deref), span_of(value)),
        ck_error_frame_tracked(c, binding_refused_message(name, deref), span_of(value))
      ),
      ordered
    )
  }
}

pub theorem binding_assign_mutable_frame_tracked(
  c: Checker,
  name: Text,
  deref: Bool,
  v: Ty,
  value: SurfaceTerm,
  l: Local,
  mutable: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign_mutable(c, name, deref, v, value, l, mutable)) {
  match mutable {
    true => ⊢ TrackedRunFrame(c, binding_assign_mutable(c, name, deref, v, value, l, true)) from match deref {
      true => tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, deref_needs_mut_borrow_message(name), span_of(value))),
        frame_rewrap(
          c,
          ck_error(c, deref_needs_mut_borrow_message(name), span_of(value)),
          ck_error_frame(c, deref_needs_mut_borrow_message(name), span_of(value))
        ),
        tracked_rewrap(
          c,
          ck_error(c, deref_needs_mut_borrow_message(name), span_of(value)),
          ck_error_frame_tracked(c, deref_needs_mut_borrow_message(name), span_of(value))
        ),
        ordered
      )
      false => tracked_run_rewrap(
        c,
        ck_expect(c, v, leaf_local_ty(l), span_of(value), cat3("`", name, "`")),
        ck_expect_run_frame_tracked(
          c,
          v,
          leaf_local_ty(l),
          span_of(value),
          cat3("`", name, "`"),
          ordered
        )
      )
    }
    false => binding_assign_type_frame_tracked(
      c,
      name,
      deref,
      v,
      value,
      ck_resolve(c, leaf_local_ty(l)),
      ordered
    )
  }
}

pub theorem binding_assign_frame_tracked(
  c: Checker,
  name: Text,
  deref: Bool,
  v: Ty,
  value: SurfaceTerm,
  found: Option(Local),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign(c, name, deref, v, value, found)) {
  match found {
    None => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, not_defined_message(name), span_of(value))),
      frame_rewrap(
        c,
        ck_error(c, not_defined_message(name), span_of(value)),
        ck_error_frame(c, not_defined_message(name), span_of(value))
      ),
      tracked_rewrap(
        c,
        ck_error(c, not_defined_message(name), span_of(value)),
        ck_error_frame_tracked(c, not_defined_message(name), span_of(value))
      ),
      ordered
    )
    Some(l) => binding_assign_mutable_frame_tracked(
      c,
      name,
      deref,
      v,
      value,
      l,
      binding_local_mutable(l),
      ordered
    )
  }
}

pub theorem ck_assign_run_frame_tracked(
  c: Checker,
  env: List(Local),
  name: Text,
  deref: Bool,
  v: Ty,
  value: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_assign(c, env, name, deref, v, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(binding_assign_unf(c, env, name, deref, v, value)),
    binding_assign_frame_tracked(c, name, deref, v, value, env_find(env, name), ordered)
  )
}

pub theorem binding_assign_place_deref_frame_tracked(
  c: Checker,
  inner: Option(Ty),
  v: Ty,
  place: SurfaceTerm,
  value: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign_place_deref(c, inner, v, place, value)) {
  match inner {
    Some(t) => tracked_run_rewrap(
      c,
      ck_expect(c, v, t, span_of(value), cat3("`", place_label(place), "`")),
      ck_expect_run_frame_tracked(c, v, t, span_of(value), cat3("`", place_label(place), "`"), ordered)
    )
    None => tracked_run_read(
    c,
    ck_rewrap1(ck_error(c, deref_needs_mut_borrow_message(place_label(place)), span_of(place))),
    frame_rewrap(
      c,
      ck_error(c, deref_needs_mut_borrow_message(place_label(place)), span_of(place)),
      ck_error_frame(c, deref_needs_mut_borrow_message(place_label(place)), span_of(place))
    ),
    tracked_rewrap(c, ck_error(c, deref_needs_mut_borrow_message(place_label(place)), span_of(place)), ck_error_frame_tracked(c, deref_needs_mut_borrow_message(place_label(place)), span_of(place))),
    ordered
  )
  }
}

pub theorem binding_assign_place_plain_frame_tracked(
  c: Checker,
  through: Bool,
  v: Ty,
  pt: Ty,
  place: SurfaceTerm,
  value: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign_place_plain(c, through, v, pt, place, value)) {
  match through {
    true => tracked_run_read(
    c,
    ck_rewrap1(ck_error(c, assign_through_borrow_message(place_label(place)), span_of(place))),
    frame_rewrap(
      c,
      ck_error(c, assign_through_borrow_message(place_label(place)), span_of(place)),
      ck_error_frame(c, assign_through_borrow_message(place_label(place)), span_of(place))
    ),
    tracked_rewrap(c, ck_error(c, assign_through_borrow_message(place_label(place)), span_of(place)), ck_error_frame_tracked(c, assign_through_borrow_message(place_label(place)), span_of(place))),
    ordered
  )
    false => tracked_run_rewrap(
      c,
      ck_expect(c, v, ty_unborrowed(ck_resolve(c, pt)), span_of(value), cat3("`", place_label(place), "`")),
      ck_expect_run_frame_tracked(c, v, ty_unborrowed(ck_resolve(c, pt)), span_of(value), cat3("`", place_label(place), "`"), ordered)
    )
  }
}

pub theorem binding_assign_place_frame_tracked(
  c: Checker,
  borrowed: Bool,
  deref: Bool,
  v: Ty,
  pt: Ty,
  place: SurfaceTerm,
  value: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign_place(c, borrowed, deref, v, pt, place, value)) {
  match deref {
    true => binding_assign_place_deref_frame_tracked(c, ty_mut_inner(ck_declared_place(c, borrowed, pt)), v, place, value, ordered)
    false => binding_assign_place_plain_frame_tracked(c, ty_is_borrow(ck_declared_place(c, borrowed, pt)), v, pt, place, value, ordered)
  }
}

pub theorem binding_assign_refuse_local_frame_tracked(
  c: Checker,
  place: SurfaceTerm,
  value: SurfaceTerm,
  view: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign_refuse_local(c, place, value, view)) {
  match view {
    true => tracked_run_read(
    c,
    ck_rewrap1(ck_error(c, view_var_field_assigned_message(), span_of(value))),
    frame_rewrap(
      c,
      ck_error(c, view_var_field_assigned_message(), span_of(value)),
      ck_error_frame(c, view_var_field_assigned_message(), span_of(value))
    ),
    tracked_rewrap(c, ck_error(c, view_var_field_assigned_message(), span_of(value)), ck_error_frame_tracked(c, view_var_field_assigned_message(), span_of(value))),
    ordered
  )
    false => tracked_run_read(
    c,
    ck_rewrap1(ck_error(c, assigns_field_of_var_message(cat3("`", place_label(place), "`")), span_of(place))),
    frame_rewrap(
      c,
      ck_error(c, assigns_field_of_var_message(cat3("`", place_label(place), "`")), span_of(place)),
      ck_error_frame(c, assigns_field_of_var_message(cat3("`", place_label(place), "`")), span_of(place))
    ),
    tracked_rewrap(c, ck_error(c, assigns_field_of_var_message(cat3("`", place_label(place), "`")), span_of(place)), ck_error_frame_tracked(c, assigns_field_of_var_message(cat3("`", place_label(place), "`")), span_of(place))),
    ordered
  )
  }
}

pub theorem binding_assign_refuse_frame_tracked(
  c: Checker,
  name: Text,
  place: SurfaceTerm,
  value: SurfaceTerm,
  found: Option(Local),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, binding_assign_refuse(c, name, place, value, found)) {
  match found {
    None => tracked_run_read(
    c,
    ck_rewrap1(ck_error(c, not_defined_message(name), span_of(place))),
    frame_rewrap(
      c,
      ck_error(c, not_defined_message(name), span_of(place)),
      ck_error_frame(c, not_defined_message(name), span_of(place))
    ),
    tracked_rewrap(c, ck_error(c, not_defined_message(name), span_of(place)), ck_error_frame_tracked(c, not_defined_message(name), span_of(place))),
    ordered
  )
    Some(l) => binding_assign_refuse_local_frame_tracked(c, place, value, binding_local_view(l), ordered)
  }
}

pub theorem ck_assign_place_run_frame_tracked(
  c: Checker,
  env: List(Local),
  name: Text,
  deref: Bool,
  v: Ty,
  pt: Ty,
  place: SurfaceTerm,
  value: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_assign_place(c, env, name, deref, v, pt, place, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(binding_assign_place_unf(c, env, name, deref, v, pt, place, value)),
    binding_assign_place_frame_tracked(c, ck_root_borrowed(c, env, name), deref, v, pt, place, value, ordered)
  )
}

pub theorem ck_assign_refuse_run_frame_tracked(
  c: Checker,
  env: List(Local),
  name: Text,
  place: SurfaceTerm,
  value: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_assign_refuse(c, env, name, place, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(binding_assign_refuse_unf(c, env, name, place, value)),
    binding_assign_refuse_frame_tracked(c, name, place, value, env_find(env, name), ordered)
  )
}
pub theorem inference_use_ck_check_fn_in_tracked(
  k: Nat,
  c: Checker,
  f: SurfaceFn,
  scheme: Scheme,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_check_fn_in(k, c, f, scheme, env)) {
  And::left(
    And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih)))))))
  )(c, f, scheme, env, ordered)
}

pub theorem inference_use_ck_returned_in_tracked(
  k: Nat,
  c: Checker,
  e: Option(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_returned_in(k, c, e, env)) {
  And::left(
    And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
  )(c, e, env, ordered)
}

pub theorem argument_return_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  returns: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_return(c, t, span, returns)) {
  match returns {
    Nil => tracked_run_read(
      c,
      ck_rewrap1(ck_error(c, return_outside_function_message(), span)),
      frame_rewrap(
        c,
        ck_error(c, return_outside_function_message(), span),
        ck_error_frame(c, return_outside_function_message(), span)
      ),
      tracked_rewrap(
        c,
        ck_error(c, return_outside_function_message(), span),
        ck_error_frame_tracked(c, return_outside_function_message(), span)
      ),
      ordered
    )
    Cons(r, rest) => tracked_run_rewrap(
      c,
      ck_expect(c, t, r, span, what_returned_value_message()),
      ck_expect_run_frame_tracked(c, t, r, span, what_returned_value_message(), ordered)
    )
  }
}

pub theorem ck_return_check_run_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_return_check(c, t, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(argument_return_unf(c, t, span)),
    argument_return_frame_tracked(c, t, span, argument_returns(c), ordered)
  )
}

pub theorem inference_assign_place_frame_tracked(
  j: Nat,
  c: Checker,
  env: Scope,
  name: Text,
  deref: Bool,
  p: SurfaceTerm,
  v: Ty,
  value: SurfaceTerm,
  ok: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, inference_assign_place(j, c, env, name, deref, p, v, value, ok)) {
  match ok {
    true => pattern_bind_one_frame_tracked(
      <A: Ty, B: Ty>,
      c,
      (pt: Ty, c2: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (assigned: Unit, c3: Checker) => mut2(TyUnit, c3, env),
        ck_assign_place(c2, inference_scope_items(env), name, deref, v, pt, p, value)
      ),
      ck_infer_in(j, c, p, inference_scope_items(env)),
      inference_use_ck_infer_in_tracked(j, c, p, inference_scope_items(env), ordered, ih),
      pt => c2 => o_c2 => pattern_bind_one_frame_tracked(
        <A: Unit, B: Ty>,
        c2,
        (assigned: Unit, c3: Checker) => mut2(TyUnit, c3, env),
        ck_assign_place(c2, inference_scope_items(env), name, deref, v, pt, p, value),
        ck_assign_place_run_frame_tracked(c2, inference_scope_items(env), name, deref, v, pt, p, value, o_c2),
        assigned => c3 => o_c3 => pattern_return_frame_tracked(c3, env, TyUnit, o_c3)
      )
    )
    false => pattern_bind_one_frame_tracked(
      <A: Unit, B: Ty>,
      c,
      (refused: Unit, c2: Checker) => mut2(TyUnit, c2, env),
      ck_assign_refuse(c, inference_scope_items(env), name, p, value),
      ck_assign_refuse_run_frame_tracked(c, inference_scope_items(env), name, p, value, ordered),
      refused => c2 => o_c2 => pattern_return_frame_tracked(c2, env, TyUnit, o_c2)
    )
  }
}

pub theorem inference_assign_rest_frame_tracked(
  j: Nat,
  c: Checker,
  env: Scope,
  name: Text,
  place: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  field: Option(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, inference_assign_rest(j, c, env, name, place, v, value, field)) {
  match field {
    None => pattern_bind_one_frame_tracked(
      <A: Unit, B: Ty>,
      c,
      (assigned: Unit, c2: Checker) => mut2(TyUnit, c2, env),
      ck_assign(c, inference_scope_items(env), name, ck_place_deref(place), v, value),
      ck_assign_run_frame_tracked(c, inference_scope_items(env), name, ck_place_deref(place), v, value, ordered),
      assigned => c2 => o_c2 => pattern_return_frame_tracked(c2, env, TyUnit, o_c2)
    )
    Some(p) => inference_assign_place_frame_tracked(
      j,
      c,
      env,
      name,
      ck_place_deref(place),
      p,
      v,
      value,
      ck_place_ok(c, inference_scope_items(env), name, p),
      ih,
      ordered
    )
  }
}

pub theorem inference_statement_frame_tracked(
  j: Nat,
  c: Checker,
  env: Scope,
  s: SurfaceStmt,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, inference_statement(j, c, env, s)) {
  match s {
    StLet(name, ty, value, r#borrow, bm, unused, st_stack) => pattern_bind_one_frame_tracked(
      <A: Unit, B: Ty>,
      c,
      (hinted: Unit, c0: Checker) => pattern_bind_one(
        <A: Ty, B: Ty>,
        (v: Ty, c1: Checker) => pattern_bind(
          <A: Unit, B: Ty>,
          (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
          ck_let(c1, env, name, ty, v, value, r#borrow, bm)
        ),
        ck_infer_in(j, c0, value, inference_scope_items(env))
      ),
      inference_set_result_hint(c, ck_let_hint(ty, value)),
      tracked_run_read(
        c,
        inference_set_result_hint(c, ck_let_hint(ty, value)),
        inference_set_result_hint_frame(c, ck_let_hint(ty, value)),
        inference_set_result_hint_frame_tracked(c, ck_let_hint(ty, value)),
        ordered
      ),
      hinted => c0 => o_c0 => pattern_bind_one_frame_tracked(
        <A: Ty, B: Ty>,
        c0,
        (v: Ty, c1: Checker) => pattern_bind(
          <A: Unit, B: Ty>,
          (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
          ck_let(c1, env, name, ty, v, value, r#borrow, bm)
        ),
        ck_infer_in(j, c0, value, inference_scope_items(env)),
        inference_use_ck_infer_in_tracked(j, c0, value, inference_scope_items(env), o_c0, ih),
        v => c1 => o_c1 => tracked_pattern_bind(
          <A: Unit, B: Ty>,
          c1,
          (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
          ck_let(c1, env, name, ty, v, value, r#borrow, bm),
          ck_let_scope_frame_tracked(c1, env, name, ty, v, value, r#borrow, bm, o_c1),
          bound => c2 => env2 => o_c2 => pattern_return_frame_tracked(c2, env2, TyUnit, o_c2)
        )
      )
    )
    StVar(name, ty, value, vb, unused, st_stack) => pattern_bind_one_frame_tracked(
      <A: Ty, B: Ty>,
      c,
      (v: Ty, c1: Checker) => pattern_bind(
        <A: Unit, B: Ty>,
        (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
        ck_var(c1, env, name, ty, v, value, vb)
      ),
      ck_infer_in(j, c, value, inference_scope_items(env)),
      inference_use_ck_infer_in_tracked(j, c, value, inference_scope_items(env), ordered, ih),
      v => c1 => o_c1 => tracked_pattern_bind(
        <A: Unit, B: Ty>,
        c1,
        (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
        ck_var(c1, env, name, ty, v, value, vb),
        ck_var_scope_frame_tracked(c1, env, name, ty, v, value, vb, o_c1),
        bound => c2 => env2 => o_c2 => pattern_return_frame_tracked(c2, env2, TyUnit, o_c2)
      )
    )
    StAssign(name, name_place, value) => pattern_bind_one_frame_tracked(
      <A: Ty, B: Ty>,
      c,
      (v: Ty, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (placed: Unit, c4: Checker) => inference_assign_rest(j, c4, env, name, name_place, v, value, ck_assign_field_place(name_place)),
        ck_coerce_assign_place(c1, inference_scope_items(env), name_place)
      ),
      ck_infer_in(j, c, value, inference_scope_items(env)),
      inference_use_ck_infer_in_tracked(j, c, value, inference_scope_items(env), ordered, ih),
      v => c1 => o_c1 => pattern_bind_one_frame_tracked(
        <A: Unit, B: Ty>,
        c1,
        (placed: Unit, c4: Checker) => inference_assign_rest(j, c4, env, name, name_place, v, value, ck_assign_field_place(name_place)),
        ck_coerce_assign_place(c1, inference_scope_items(env), name_place),
        ck_coerce_assign_place_frame_tracked(c1, inference_scope_items(env), name_place, o_c1),
        placed => c4 => o_c4 => inference_assign_rest_frame_tracked(j, c4, env, name, name_place, v, value, ck_assign_field_place(name_place), ih, o_c4)
      )
    )
    StCalled(name_generates, value) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StCalled(name_generates, value)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StCalled(name_generates, value)),
        ck_stmt_other_frame(c, StCalled(name_generates, value)),
        ck_stmt_other_frame_tracked(c, StCalled(name_generates, value)),
        ordered
      )
    )
    StFn(f) => pattern_bind_one_frame_tracked(
      <A: Scheme, B: Ty>,
      c,
      (scheme: Scheme, c1: Checker) => pattern_bind(
        <A: Unit, B: Ty>,
        (bound: Unit, c2: Checker, env2: Scope) => pattern_bind_one(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => mut2(TyUnit, c3, env2),
          ck_check_fn_in(j, c2, f, scheme, inference_scope_items(env2))
        ),
        ck_bind_local(
          c1,
          env,
          inference_fn_name(f),
          scheme_local_type(scheme),
          false,
          handle_body_start(inference_fn_body(f))
        )
      ),
      ck_signature(c, f),
      tracked_run_read(
        c,
        ck_signature(c, f),
        ck_signature_frame(c, f),
        ck_signature_frame_tracked(c, f),
        ordered
      ),
      scheme => c1 => o_c1 => tracked_pattern_bind(
        <A: Unit, B: Ty>,
        c1,
        (bound: Unit, c2: Checker, env2: Scope) => pattern_bind_one(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => mut2(TyUnit, c3, env2),
          ck_check_fn_in(j, c2, f, scheme, inference_scope_items(env2))
        ),
        ck_bind_local(
          c1,
          env,
          inference_fn_name(f),
          scheme_local_type(scheme),
          false,
          handle_body_start(inference_fn_body(f))
        ),
        ck_bind_local_scope_frame_tracked(
          c1,
          env,
          inference_fn_name(f),
          scheme_local_type(scheme),
          false,
          handle_body_start(inference_fn_body(f)),
          o_c1
        ),
        bound => c2 => env2 => o_c2 => pattern_bind_one_frame_tracked(
          <A: Unit, B: Ty>,
          c2,
          (checked: Unit, c3: Checker) => mut2(TyUnit, c3, env2),
          ck_check_fn_in(j, c2, f, scheme, inference_scope_items(env2)),
          inference_use_ck_check_fn_in_tracked(
            j,
            c2,
            f,
            scheme,
            inference_scope_items(env2),
            o_c2,
            ih
          ),
          checked => c3 => o_c3 => pattern_return_frame_tracked(c3, env2, TyUnit, o_c3)
        )
      )
    )
    StEffect(e) => pattern_bind_one_frame_tracked(
      <A: Unit, B: Ty>,
      c,
      (declared: Unit, c1: Checker) => mut2(TyUnit, c1, env),
      ck_declare_effect(c, e),
      tracked_run_read(
        c,
        ck_declare_effect(c, e),
        ck_declare_effect_frame(c, e),
        ck_declare_effect_frame_tracked(c, e),
        ordered
      ),
      declared => c1 => o_c1 => pattern_return_frame_tracked(c1, env, TyUnit, o_c1)
    )
    StWhile(condition, body) => pattern_bind_one_frame_tracked(
      <A: Ty, B: Ty>,
      c,
      (t: Ty, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => pattern_bind_one(
          <A: Ty, B: Ty>,
          (ignored: Ty, c3: Checker) => mut2(TyUnit, c3, env),
          ck_infer_in(j, c2, body, inference_scope_items(env))
        ),
        ck_expect(c1, t, TyBool, span_of(condition), what_while_condition_message())
      ),
      ck_infer_in(j, c, condition, inference_scope_items(env)),
      inference_use_ck_infer_in_tracked(j, c, condition, inference_scope_items(env), ordered, ih),
      t => c1 => o_c1 => pattern_bind_one_frame_tracked(
        <A: Unit, B: Ty>,
        c1,
        (checked: Unit, c2: Checker) => pattern_bind_one(
          <A: Ty, B: Ty>,
          (ignored: Ty, c3: Checker) => mut2(TyUnit, c3, env),
          ck_infer_in(j, c2, body, inference_scope_items(env))
        ),
        ck_expect(c1, t, TyBool, span_of(condition), what_while_condition_message()),
        ck_expect_run_frame_tracked(c1, t, TyBool, span_of(condition), what_while_condition_message(), o_c1),
        checked => c2 => o_c2 => pattern_bind_one_frame_tracked(
          <A: Ty, B: Ty>,
          c2,
          (ignored: Ty, c3: Checker) => mut2(TyUnit, c3, env),
          ck_infer_in(j, c2, body, inference_scope_items(env)),
          inference_use_ck_infer_in_tracked(j, c2, body, inference_scope_items(env), o_c2, ih),
          ignored => c3 => o_c3 => pattern_return_frame_tracked(c3, env, TyUnit, o_c3)
        )
      )
    )
    StReturn(e) => pattern_bind_one_frame_tracked(
      <A: (Ty × TySpan), B: Ty>,
      c,
      (returned: Ty × TySpan, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => mut2(TyNever, c2, env),
        ck_return_check(c1, inference_pair_ty(returned), inference_pair_span(returned))
      ),
      ck_returned_in(j, c, e, inference_scope_items(env)),
      inference_use_ck_returned_in_tracked(j, c, e, inference_scope_items(env), ordered, ih),
      returned => c1 => o_c1 => pattern_bind_one_frame_tracked(
        <A: Unit, B: Ty>,
        c1,
        (checked: Unit, c2: Checker) => mut2(TyNever, c2, env),
        ck_return_check(c1, inference_pair_ty(returned), inference_pair_span(returned)),
        ck_return_check_run_frame_tracked(
          c1,
          inference_pair_ty(returned),
          inference_pair_span(returned),
          o_c1
        ),
        checked => c2 => o_c2 => pattern_return_frame_tracked(c2, env, TyNever, o_c2)
      )
    )
    StExpr(e) => pattern_lift_frame_tracked(
      c,
      env,
      ck_infer_in(j, c, e, inference_scope_items(env)),
      inference_use_ck_infer_in_tracked(j, c, e, inference_scope_items(env), ordered, ih)
    )
    StTheorem(pat_t) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StTheorem(pat_t)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StTheorem(pat_t)),
        ck_stmt_other_frame(c, StTheorem(pat_t)),
        ck_stmt_other_frame_tracked(c, StTheorem(pat_t)),
        ordered
      )
    )
    StDef(pat_t) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StDef(pat_t)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StDef(pat_t)),
        ck_stmt_other_frame(c, StDef(pat_t)),
        ck_stmt_other_frame_tracked(c, StDef(pat_t)),
        ordered
      )
    )
    StMutual(pat_stmts, pat_start, pat_end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StMutual(pat_stmts, pat_start, pat_end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StMutual(pat_stmts, pat_start, pat_end)),
        ck_stmt_other_frame(c, StMutual(pat_stmts, pat_start, pat_end)),
        ck_stmt_other_frame_tracked(c, StMutual(pat_stmts, pat_start, pat_end)),
        ordered
      )
    )
    StImport(pat_path, pat_start, pat_end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StImport(pat_path, pat_start, pat_end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StImport(pat_path, pat_start, pat_end)),
        ck_stmt_other_frame(c, StImport(pat_path, pat_start, pat_end)),
        ck_stmt_other_frame_tracked(c, StImport(pat_path, pat_start, pat_end)),
        ordered
      )
    )
    StInductive(pat_i) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StInductive(pat_i)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StInductive(pat_i)),
        ck_stmt_other_frame(c, StInductive(pat_i)),
        ck_stmt_other_frame_tracked(c, StInductive(pat_i)),
        ordered
      )
    )
    StStruct(pat_d) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StStruct(pat_d)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StStruct(pat_d)),
        ck_stmt_other_frame(c, StStruct(pat_d)),
        ck_stmt_other_frame_tracked(c, StStruct(pat_d)),
        ordered
      )
    )
    StEnum(pat_d) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StEnum(pat_d)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StEnum(pat_d)),
        ck_stmt_other_frame(c, StEnum(pat_d)),
        ck_stmt_other_frame_tracked(c, StEnum(pat_d)),
        ordered
      )
    )
    StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end)),
        ck_stmt_other_frame(c, StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end)),
        ck_stmt_other_frame_tracked(c, StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end)),
        ordered
      )
    )
    StClass(pat_c) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StClass(pat_c)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StClass(pat_c)),
        ck_stmt_other_frame(c, StClass(pat_c)),
        ck_stmt_other_frame_tracked(c, StClass(pat_c)),
        ordered
      )
    )
    StInstance(pat_i) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StInstance(pat_i)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StInstance(pat_i)),
        ck_stmt_other_frame(c, StInstance(pat_i)),
        ck_stmt_other_frame_tracked(c, StInstance(pat_i)),
        ordered
      )
    )
    StMacro(pat_name, pat_function, pat_start, pat_end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StMacro(pat_name, pat_function, pat_start, pat_end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StMacro(pat_name, pat_function, pat_start, pat_end)),
        ck_stmt_other_frame(c, StMacro(pat_name, pat_function, pat_start, pat_end)),
        ck_stmt_other_frame_tracked(c, StMacro(pat_name, pat_function, pat_start, pat_end)),
        ordered
      )
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StAttributed(attr_name, attr_arg, attr_generates, attr_stmt)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StAttributed(attr_name, attr_arg, attr_generates, attr_stmt)),
        ck_stmt_other_frame(c, StAttributed(attr_name, attr_arg, attr_generates, attr_stmt)),
        ck_stmt_other_frame_tracked(
          c,
          StAttributed(attr_name, attr_arg, attr_generates, attr_stmt)
        ),
        ordered
      )
    )
    StSyntax(pat_name, pat_grammar, pat_start, pat_end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StSyntax(pat_name, pat_grammar, pat_start, pat_end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StSyntax(pat_name, pat_grammar, pat_start, pat_end)),
        ck_stmt_other_frame(c, StSyntax(pat_name, pat_grammar, pat_start, pat_end)),
        ck_stmt_other_frame_tracked(c, StSyntax(pat_name, pat_grammar, pat_start, pat_end)),
        ordered
      )
    )
    StOther(what, start, end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StOther(what, start, end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StOther(what, start, end)),
        ck_stmt_other_frame(c, StOther(what, start, end)),
        ck_stmt_other_frame_tracked(c, StOther(what, start, end)),
        ordered
      )
    )
    StLoop(st_body, start, end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StOther("LoopExpr", start, end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StOther("LoopExpr", start, end)),
        ck_stmt_other_frame(c, StOther("LoopExpr", start, end)),
        ck_stmt_other_frame_tracked(c, StOther("LoopExpr", start, end)),
        ordered
      )
    )
    StModule(mod_name, mod_vis, mod_items, start, end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StOther("ModuleDecl", start, end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StOther("ModuleDecl", start, end)),
        ck_stmt_other_frame(c, StOther("ModuleDecl", start, end)),
        ck_stmt_other_frame_tracked(c, StOther("ModuleDecl", start, end)),
        ordered
      )
    )
    StReexport(re_path, re_names, re_spans, start, end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StOther("ReexportDecl", start, end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StOther("ReexportDecl", start, end)),
        ck_stmt_other_frame(c, StOther("ReexportDecl", start, end)),
        ck_stmt_other_frame_tracked(c, StOther("ReexportDecl", start, end)),
        ordered
      )
    )
    StFor(for_pat, for_src, st_body, start, end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StOther("ForStmt", start, end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StOther("ForStmt", start, end)),
        ck_stmt_other_frame(c, StOther("ForStmt", start, end)),
        ck_stmt_other_frame_tracked(c, StOther("ForStmt", start, end)),
        ordered
      )
    )
    StBreak(st_value, start, end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StOther("BreakStmt", start, end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StOther("BreakStmt", start, end)),
        ck_stmt_other_frame(c, StOther("BreakStmt", start, end)),
        ck_stmt_other_frame_tracked(c, StOther("BreakStmt", start, end)),
        ordered
      )
    )
    StContinue(start, end) => pattern_lift_frame_tracked(
      c,
      env,
      ck_stmt_other(c, StOther("ContinueStmt", start, end)),
      tracked_run_read(
        c,
        ck_stmt_other(c, StOther("ContinueStmt", start, end)),
        ck_stmt_other_frame(c, StOther("ContinueStmt", start, end)),
        ck_stmt_other_frame_tracked(c, StOther("ContinueStmt", start, end)),
        ordered
      )
    )
  }
}

pub theorem inference_step_ck_stmt_in_frame_tracked(
  j: Nat,
  c: Checker,
  s: SurfaceStmt,
  env: Scope,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  inference_step_ck_stmt_in(j, c, s, env)
) { inference_statement_frame_tracked(j, c, env, s, ih, ordered) }

pub theorem inference_successor_ck_stmt_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_stmt_in_tracked(Succ(j)) {
  c => s => env => ordered => Eq::subst(
    (z: Mut2(Ty, Checker, Scope)) => TrackedScopeFrame(c, z),
    Eq::sym(inference_unf_ck_stmt_in(j, c, s, env)),
    inference_step_ck_stmt_in_frame_tracked(j, c, s, env, ih, ordered)
  )
}
pub theorem inference_block_end_frame_tracked(
  j: Nat,
  c: Checker,
  env: Scope,
  last: Ty,
  stopped: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, inference_block_end(j, c, env, last, stopped)) {
  match stopped {
    true => pattern_return_frame_tracked(c, env, TyNever, ordered)
    false => pattern_return_frame_tracked(c, env, last, ordered)
  }
}

pub theorem inference_use_ck_stmt_in_tracked(
  k: Nat,
  c: Checker,
  s: SurfaceStmt,
  env: Scope,
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedScopeFrame(
  c,
  ck_stmt_in(k, c, s, env)
) { And::left(And::right(And::right(And::right(And::right(And::right(ih))))))(c, s, env, ordered) }

pub theorem inference_block_frame_tracked(
  j: Nat,
  c: Checker,
  env: Scope,
  stopped: Bool,
  last: Ty,
  stmts: List(SurfaceStmt),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, inference_block(j, c, env, stopped, last, stmts)) {
  match stmts {
    Nil => inference_block_end_frame_tracked(j, c, env, last, stopped, ih, ordered)
    Cons(s, rest) => pattern_bind_one_frame_tracked(
      <A: Unit, B: Ty>,
      c,
      (hinted: Unit, c0: Checker) => pattern_bind(
        <A: Ty, B: Ty>,
        (t: Ty, c1: Checker, env1: Scope) => pattern_rewrap(
          ck_block_in(j, c1, rest, env1, Bool::or(stopped, ty_is_never(t)), block_value(s, rest, t))
        ),
        ck_stmt_in(j, c0, s, env)
      ),
      inference_set_result_hint(c, ck_block_hint_for(s, rest, inference_arm_hint(c))),
      tracked_run_read(
        c,
        inference_set_result_hint(c, ck_block_hint_for(s, rest, inference_arm_hint(c))),
        inference_set_result_hint_frame(c, ck_block_hint_for(s, rest, inference_arm_hint(c))),
        inference_set_result_hint_frame_tracked(c, ck_block_hint_for(s, rest, inference_arm_hint(c))),
        ordered
      ),
      hinted => c0 => o_c0 => tracked_pattern_bind(
        <A: Ty, B: Ty>,
        c0,
        (t: Ty, c1: Checker, env1: Scope) => pattern_rewrap(
          ck_block_in(j, c1, rest, env1, Bool::or(stopped, ty_is_never(t)), block_value(s, rest, t))
        ),
        ck_stmt_in(j, c0, s, env),
        inference_use_ck_stmt_in_tracked(j, c0, s, env, o_c0, ih),
        t => c1 => env1 => o_c1 => pattern_rewrap_frame_tracked(
          c1,
          ck_block_in(j, c1, rest, env1, Bool::or(stopped, ty_is_never(t)), block_value(s, rest, t)),
          inference_use_ck_block_in_tracked(
            j,
            c1,
            rest,
            env1,
            Bool::or(stopped, ty_is_never(t)),
            block_value(s, rest, t),
            o_c1,
            ih
          )
        )
      )
    )
  }
}

pub theorem inference_step_ck_block_in_frame_tracked(
  j: Nat,
  c: Checker,
  stmts: List(SurfaceStmt),
  env: Scope,
  stopped: Bool,
  last: Ty,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  inference_step_ck_block_in(j, c, stmts, env, stopped, last)
) { inference_block_frame_tracked(j, c, env, stopped, last, stmts, ih, ordered) }

pub theorem inference_successor_ck_block_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_block_in_tracked(Succ(j)) {
  c => stmts => env => stopped => last => ordered => Eq::subst(
    (z: Mut2(Ty, Checker, Scope)) => TrackedScopeFrame(c, z),
    Eq::sym(inference_unf_ck_block_in(j, c, stmts, env, stopped, last)),
    inference_step_ck_block_in_frame_tracked(j, c, stmts, env, stopped, last, ih, ordered)
  )
}
pub theorem inference_frames_tracked(k: Nat): InferenceFrames_tracked(k) {
  match k {
    Zero => AndIntro(
      inference_zero_ck_infer_in_tracked(),
      AndIntro(
        inference_zero_ck_infer_term_in_tracked(),
        AndIntro(
          inference_zero_ck_else_in_tracked(),
          AndIntro(
            inference_zero_ck_infer_each_in_tracked(),
            AndIntro(
              inference_zero_ck_guard_in_tracked(),
              AndIntro(
                inference_zero_ck_stmt_in_tracked(),
                AndIntro(
                  inference_zero_ck_returned_in_tracked(),
                  AndIntro(
                    inference_zero_ck_check_fn_in_tracked(),
                    AndIntro(
                      inference_zero_ck_block_in_tracked(),
                      AndIntro(
                        inference_zero_ck_app_args_in_tracked(),
                        AndIntro(
                          inference_zero_ck_app_in_tracked(),
                          AndIntro(
                            inference_zero_ck_app_call_in_tracked(),
                            AndIntro(
                              inference_zero_ck_operands_in_tracked(),
                              AndIntro(
                                inference_zero_ck_clone_of_in_tracked(),
                                AndIntro(
                                  inference_zero_ck_lambda_in_tracked(),
                                  AndIntro(
                                    inference_zero_ck_record_fields_in_tracked(),
                                    AndIntro(
                                      inference_zero_ck_record_in_tracked(),
                                      AndIntro(
                                        inference_zero_ck_match_arms_in_tracked(),
                                        AndIntro(
                                          inference_zero_ck_match_expr_in_tracked(),
                                          AndIntro(
                                            inference_zero_ck_handle_in_tracked(),
                                            AndIntro(
                                              inference_zero_ck_handle_first_in_tracked(),
                                              AndIntro(
                                                inference_zero_ck_handle_result_in_tracked(),
                                                AndIntro(
                                                  inference_zero_ck_handle_arms_in_tracked(),
                                                  AndIntro(
                                                    inference_zero_ck_handle_one_in_tracked(),
                                                    AndIntro(
                                                      inference_zero_ck_handle_arm_in_tracked(),
                                                      AndIntro(
                                                        inference_zero_ck_handle_body_in_tracked(),
                                                        Trivial
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    Succ(j) => {
      let ih: InferenceFrames_tracked(j) := inference_frames_tracked(j)
      AndIntro(
        inference_successor_ck_infer_in_tracked(j, ih),
        AndIntro(
          inference_successor_ck_infer_term_in_tracked(j, ih),
          AndIntro(
            inference_successor_ck_else_in_tracked(j, ih),
            AndIntro(
              inference_successor_ck_infer_each_in_tracked(j, ih),
              AndIntro(
                inference_successor_ck_guard_in_tracked(j, ih),
                AndIntro(
                  inference_successor_ck_stmt_in_tracked(j, ih),
                  AndIntro(
                    inference_successor_ck_returned_in_tracked(j, ih),
                    AndIntro(
                      inference_successor_ck_check_fn_in_tracked(j, ih),
                      AndIntro(
                        inference_successor_ck_block_in_tracked(j, ih),
                        AndIntro(
                          inference_successor_ck_app_args_in_tracked(j, ih),
                          AndIntro(
                            inference_successor_ck_app_in_tracked(j, ih),
                            AndIntro(
                              inference_successor_ck_app_call_in_tracked(j, ih),
                              AndIntro(
                                inference_successor_ck_operands_in_tracked(j, ih),
                                AndIntro(
                                  inference_successor_ck_clone_of_in_tracked(j, ih),
                                  AndIntro(
                                    inference_successor_ck_lambda_in_tracked(j, ih),
                                    AndIntro(
                                      inference_successor_ck_record_fields_in_tracked(j, ih),
                                      AndIntro(
                                        inference_successor_ck_record_in_tracked(j, ih),
                                        AndIntro(
                                          inference_successor_ck_match_arms_in_tracked(j, ih),
                                          AndIntro(
                                            inference_successor_ck_match_expr_in_tracked(j, ih),
                                            AndIntro(
                                              inference_successor_ck_handle_in_tracked(j, ih),
                                              AndIntro(
                                                inference_successor_ck_handle_first_in_tracked(
                                                  j,
                                                  ih
                                                ),
                                                AndIntro(
                                                  inference_successor_ck_handle_result_in_tracked(
                                                    j,
                                                    ih
                                                  ),
                                                  AndIntro(
                                                    inference_successor_ck_handle_arms_in_tracked(
                                                      j,
                                                      ih
                                                    ),
                                                    AndIntro(
                                                      inference_successor_ck_handle_one_in_tracked(
                                                        j,
                                                        ih
                                                      ),
                                                      AndIntro(
                                                        inference_successor_ck_handle_arm_in_tracked(
                                                          j,
                                                          ih
                                                        ),
                                                        AndIntro(
                                                          inference_successor_ck_handle_body_in_tracked(
                                                            j,
                                                            ih
                                                          ),
                                                          Trivial
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    }
  }
}

