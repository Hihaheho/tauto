pub theorem inference_handler_arity_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  pa: ArmSig,
  wrong: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_handler_arity(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body,
    pa,
    wrong
  )
) {
  match wrong: TrackedRunFrame(
    c,
    inference_handler_arity(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      pa,
      wrong
    )
  ) {
    true => tracked_run_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        ),
        ck_error_frame(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        )
      ),
      tracked_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        ),
        ck_error_frame_tracked(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        )
      ),
      ordered
    )
    false => tracked_run_rewrap(
      c,
      ck_handle_body_in(
        j,
        c,
        env,
        result,
        rv,
        eff,
        inference_handler_params(pa),
        inference_handler_answer(pa),
        inference_handler_rigid(pa),
        inference_handler_names(pa),
        patterns,
        cont,
        guard,
        body
      ),
      inference_use_ck_handle_body_in_tracked(
        j,
        c,
        env,
        result,
        rv,
        eff,
        inference_handler_params(pa),
        inference_handler_answer(pa),
        inference_handler_rigid(pa),
        inference_handler_names(pa),
        patterns,
        cont,
        guard,
        body,
        ordered,
        ih
      )
    )
  }
}

pub theorem inference_handler_signature_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  signature: Option(ArmSig),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_handler_signature(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body,
    signature
  )
) {
  match signature: TrackedRunFrame(
    c,
    inference_handler_signature(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature
    )
  ) {
    None => tracked_run_return(c, Star, ordered)
    Some(pa) => inference_handler_arity_frame_tracked(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      pa,
      not(Nat::eq(list_len(inference_handler_params(pa)), list_len(patterns))),
      ih,
      ordered
    )
  }
}

