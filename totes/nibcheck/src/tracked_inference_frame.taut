pub theorem inference_else_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  env: List(Local),
  el: Option(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_else(j, c, t, env, el)) {
  match el: TrackedRunFrame(c, inference_else(j, c, t, env, el)) {
    None => tracked_run_return(c, TyUnit, ordered)
    Some(o) => tracked_run_bind(
      Ty,
      Ty,
      c,
      (ot: Ty, c1: Checker) => ck_rewrap1(ck_join(c1, t, ot)),
      ck_infer_in(j, c, o, env),
      inference_use_ck_infer_in_tracked(j, c, o, env, ordered, ih),
      ot => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_join(c1, t, ot),
        ck_join_run_frame_tracked(c1, t, ot, o_c1)
      )
    )
  }
}

