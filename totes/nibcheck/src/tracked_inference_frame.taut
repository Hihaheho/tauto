    )
  }
}

pub theorem handler_validate_unfolded_frame_tracked(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, handler_validate_unfolded(c, arm, result, span)) {
  tracked_run_bind(
    Bool,
    Unit,
    c,
    (fits: Bool, c1: Checker) => handler_validate_after(c1, arm, result, span, fits),
    ck_fits_any_in(ck_steps_of(c), c, arm, ck_handle_result_choices(ck_resolve(c, result))),
    handler_fits_any_frame_tracked(
      ck_steps_of(c),
      c,
      arm,
      ck_handle_result_choices(ck_resolve(c, result)),
      ordered
    ),
    fits => c1 => o_c1 => handler_validate_after_frame_tracked(c1, arm, result, span, fits, o_c1)
  )
}

pub theorem ck_handle_validate_frame_tracked(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_handle_validate(c, arm, result, span)) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => TrackedRunFrame(c, m),
    Eq::sym(handler_validate_unf(c, arm, result, span)),
    handler_validate_unfolded_frame_tracked(c, arm, result, span, ordered)
  )
}
pub theorem ck_handle_arm_result_run_frame_tracked(
  c: Checker,
  arm: Ty,
  result: Ty,
  variable: Option(Nat),
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_handle_arm_result(c, arm, result, variable, span)) {
  match variable: TrackedRunFrame(c, ck_handle_arm_result(c, arm, result, variable, span)) {
    Some(rv) => tracked_run_rewrap(
      c,
      ck_handle_widen(c, arm, result, rv),
      ck_handle_widen_run_frame_tracked(c, arm, result, rv, ordered)
    )
    None => tracked_run_rewrap(
      c,
      ck_handle_validate(c, arm, result, span),
      ck_handle_validate_frame_tracked(c, arm, result, span, ordered)
    )
  }
}
pub theorem arm_finish_after_run_frame_tracked(
  c: Checker,
  eff: Text,
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  out: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, arm_finish_after(c, eff, a, result, rv, span, out)) {
  match out: TrackedRunFrame(c, arm_finish_after(c, eff, a, result, rv, span, out)) {
    true => tracked_run_read(
      c,
      arm_finish_after(c, eff, a, result, rv, span, true),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        ),
        ck_error_frame(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        )
      ),
      tracked_rewrap(
        c,
        ck_error(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        ),
        ck_error_frame_tracked(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        )
      ),
      ordered
    )
    false => tracked_run_rewrap(
      c,
      ck_handle_arm_result(c, a, result, rv, span),
      ck_handle_arm_result_run_frame_tracked(c, a, result, rv, span, ordered)
    )
  }
}
pub theorem ck_handle_arm_finish_run_frame_tracked(
  c: Checker,
  eff: Text,
  rigid: List(Text),
  env: List(Local),
  types: List(TypeName),
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_handle_arm_finish(c, eff, rigid, env, types, a, result, rv, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(arm_finish_unf(c, eff, rigid, env, types, a, result, rv, span)),
    tracked_run_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => arm_finish_after(
        c1,
        eff,
        a,
        result,
        rv,
        span,
        ck_arm_lets_rigid_out(c1, rigid, a, result, env)
      ),
      arm_set_types(c, types),
      tracked_run_read(c, arm_set_types(c, types), Refl, tracked_state_refl(c), ordered),
      ignored => c1 => o_c1 => arm_finish_after_run_frame_tracked(
        c1,
        eff,
        a,
        result,
        rv,
        span,
        ck_arm_lets_rigid_out(c1, rigid, a, result, env),
        o_c1
      )
    )
  )
}
pub theorem inference_arm_tail_frame_tracked(
  j: Nat,
  c: Checker,
  inner: Scope,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  rigid: List(Text),
  names: List(TypeName),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_arm_tail(j, c, inner, env, result, rv, eff, rigid, names, guard, body)
) {
  tracked_run_bind(
    Unit,
    Unit,
    c,
    (entered: Unit, c1: Checker) => frame_bind(
      Unit,
      Unit,
      (guarded: Unit, c2: Checker) => frame_bind(
        Ty,
        Unit,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner))
    ),
    ck_arm_enter(c, names),
    tracked_run_read(
      c,
      ck_arm_enter(c, names),
      ck_arm_enter_frame(c, names),
      ck_arm_enter_frame_tracked(c, names),
      ordered
    ),
    entered => c1 => o_c1 => tracked_run_bind(
      Unit,
      Unit,
      c1,
      (guarded: Unit, c2: Checker) => frame_bind(
        Ty,
        Unit,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner)),
      inference_use_ck_guard_in_tracked(j, c1, guard, inference_scope_items(inner), o_c1, ih),
      guarded => c2 => o_c2 => tracked_run_bind(
        Ty,
        Unit,
        c2,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner)),
        inference_use_ck_infer_in_tracked(j, c2, body, inference_scope_items(inner), o_c2, ih),
        a => c3 => o_c3 => tracked_run_rewrap(
          c3,
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          ),
          ck_handle_arm_finish_run_frame_tracked(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body),
            o_c3
          )
        )
      )
    )
  )
}

pub theorem inference_handle_body_step_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  params: List(Ty),
  answer: Ty,
  rigid: List(Text),
  names: List(TypeName),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  quant: Quant,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_handle_body_step(
    j,
    c,
    env,
    result,
    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body,
    quant
  )
) {
  tracked_run_bind(
    Unit,
    Unit,
    c,
    (r#direct: Unit, c1: Checker) => inference_bind_scope(
      Unit,
      Unit,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        Unit,
        Unit,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body)
    ),
    ck_handle_direct(c, quant, eff, cont, guard, body),
    tracked_run_read(
      c,
      ck_handle_direct(c, quant, eff, cont, guard, body),
      ck_handle_direct_frame(c, quant, eff, cont, guard, body),
      ck_handle_direct_frame_tracked(c, quant, eff, cont, guard, body),
      ordered
    ),
    r#direct => c1 => o_c1 => inference_bind_scope_frame_tracked(
      Unit,
      Unit,
      c1,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        Unit,
        Unit,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body),
      ck_handle_patterns_frame_tracked(patterns, c1, params, ScopeMk(env), body, o_c1),
      matched => c2 => inner => o_c2 => inference_bind_scope_frame_tracked(
        Unit,
        Unit,
        c2,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body),
        ck_handle_cont_frame_tracked(c2, inner, quant, eff, cont, answer, result, body, o_c2),
        bound => c3 => inner2 => o_c3 => inference_arm_tail_frame_tracked(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body,
          ih,
          o_c3
        )
      )
    )
  )
}

