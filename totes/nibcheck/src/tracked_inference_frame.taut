pub theorem inference_handle_one_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  h: SurfaceHandler,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_handle_one(j, c, env, result, rv, budget_ty, h)) {
  match h: TrackedRunFrame(c, inference_handle_one(j, c, env, result, rv, budget_ty, h)) {
    HdReturn(p, b) => tracked_run_return(c, Star, ordered)
    HdOperation(eff, binds, types, patterns, cont, guard, body) => tracked_run_rewrap(
      c,
      ck_handle_arm_in(
        j,
        c,
        env,
        result,
        rv,
        budget_ty,
        eff,
        binds,
        types,
        patterns,
        cont,
        guard,
        body
      ),
      inference_use_ck_handle_arm_in_tracked(
        j,
        c,
        env,
        result,
        rv,
        budget_ty,
        eff,
        binds,
        types,
        patterns,
        cont,
        guard,
        body,
        ordered,
        ih
      )
    )
  }
}

