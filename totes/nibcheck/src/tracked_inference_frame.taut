pub theorem operator_eq_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  eq: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_eq(c, op, a, b, arguments, span, occurrence, eq)) {
  match eq {
    true => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(TyBool, c1),
      ck_pend(c, "PartialEq", a, op, span),
      tracked_run_read(
        c,
        ck_pend(c, "PartialEq", a, op, span),
        ck_pend_frame(c, "PartialEq", a, op, span),
        ck_pend_frame_tracked(c, "PartialEq", a, op, span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, TyBool, o_c1)
    )
    false => operator_compare_frame_tracked(
      c,
      op,
      a,
      b,
      arguments,
      span,
      occurrence,
      Bool::or(
        Bool::or(Bool::or(Text::eq(op, "<"), Text::eq(op, ">")), Text::eq(op, "<=")),
        Text::eq(op, ">=")
      ),
      ordered
    )
  }
}

pub theorem operator_unified_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  failed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_unified(c, op, a, b, arguments, span, occurrence, failed)) {
  ⊢ TrackedRunFrame(
    c,
    operator_unified(c, op, a, b, arguments, span, occurrence, failed)
  ) from match failed {
    true => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => operator_failed_result(
        c1,
        op,
        a,
        b,
        arguments,
        span,
        op_is_arithmetic(op)
      ),
      ck_error(c, ck_operands_differ(c, op, a, b, arguments), span),
      tracked_run_read(
        c,
        ck_error(c, ck_operands_differ(c, op, a, b, arguments), span),
        ck_error_frame(c, ck_operands_differ(c, op, a, b, arguments), span),
        ck_error_frame_tracked(c, ck_operands_differ(c, op, a, b, arguments), span),
        ordered
      ),
      ignored => c1 => o_c1 => operator_failed_result_frame_tracked(
        c1,
        op,
        a,
        b,
        arguments,
        span,
        op_is_arithmetic(op),
        o_c1
      )
    )
    false => operator_eq_frame_tracked(
      c,
      op,
      a,
      b,
      arguments,
      span,
      occurrence,
      Bool::or(Text::eq(op, "=="), Text::eq(op, "!=")),
      ordered
    )
  }
}

pub theorem operator_binary_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  boolean: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_binary(c, op, a, b, arguments, span, occurrence, boolean)) {
  ⊢ TrackedRunFrame(
    c,
    operator_binary(c, op, a, b, arguments, span, occurrence, boolean)
  ) from match boolean {
    true => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (ignored2: Unit, c2: Checker) => mut1(TyBool, c2),
        ck_expect(c1, b, TyBool, second_span(arguments, span), cat3("`", op, "`"))
      ),
      ck_expect(c, a, TyBool, first_span(arguments, span), cat3("`", op, "`")),
      ck_expect_run_frame_tracked(
        c,
        a,
        TyBool,
        first_span(arguments, span),
        cat3("`", op, "`"),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c1,
        (ignored2: Unit, c2: Checker) => mut1(TyBool, c2),
        ck_expect(c1, b, TyBool, second_span(arguments, span), cat3("`", op, "`")),
        ck_expect_run_frame_tracked(
          c1,
          b,
          TyBool,
          second_span(arguments, span),
          cat3("`", op, "`"),
          o_c1
        ),
        ignored2 => c2 => o_c2 => tracked_run_return(c2, TyBool, o_c2)
      )
    )
    false => tracked_run_bind(
      <A: Bool, B: Ty>,
      c,
      (unified: Bool, c1: Checker) => operator_unified(
        c1,
        op,
        a,
        b,
        arguments,
        span,
        occurrence,
        not(unified)
      ),
      ck_unify(c, a, b),
      ck_unify_run_frame_tracked(c, a, b, ordered),
      unified => c1 => o_c1 => operator_unified_frame_tracked(
        c1,
        op,
        a,
        b,
        arguments,
        span,
        occurrence,
        not(unified),
        o_c1
      )
    )
  }
}

pub theorem ck_binary_run_frame_tracked(
  c: Checker,
  op: Text,
  a: Ty,
  b: Ty,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_binary(c, op, a, b, arguments, span, occurrence)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(operator_binary_unf(c, op, a, b, arguments, span, occurrence)),
    operator_binary_frame_tracked(
      c,
      op,
      a,
      b,
      arguments,
      span,
      occurrence,
      Bool::or(Text::eq(op, "&&"), Text::eq(op, "||")),
      ordered
    )
  )
}

pub theorem operator_more_frame_tracked(
  c: Checker,
  op: Text,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  a: Ty,
  b: Ty,
  more: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_more(c, op, arguments, span, occurrence, a, b, more)) {
  match more {
    Nil => tracked_run_rewrap(
      c,
      ck_binary(c, op, a, b, arguments, span, occurrence),
      ck_binary_run_frame_tracked(c, op, a, b, arguments, span, occurrence, ordered)
    )
    Cons(x, y) => tracked_run_read(
      c,
      ck_rewrap1(ck_operator_bad(c, op, span)),
      frame_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame(c, op, span)),
      tracked_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame_tracked(c, op, span)),
      ordered
    )
  }
}

pub theorem operator_rest_frame_tracked(
  c: Checker,
  op: Text,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  a: Ty,
  rest: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_rest(c, op, arguments, span, occurrence, a, rest)) {
  match rest {
    Nil => operator_unary_number_frame_tracked(
      c,
      op,
      arguments,
      span,
      occurrence,
      a,
      Bool::or(Text::eq(op, "-"), Text::eq(op, "+")),
      ordered
    )
    Cons(b, more) => operator_more_frame_tracked(
      c,
      op,
      arguments,
      span,
      occurrence,
      a,
      b,
      more,
      ordered
    )
  }
}

pub theorem operator_operands_frame_tracked(
  c: Checker,
  op: Text,
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  args: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, operator_operands(c, op, arguments, span, occurrence, args)) {
  match args {
    Nil => tracked_run_read(
      c,
      ck_rewrap1(ck_operator_bad(c, op, span)),
      frame_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame(c, op, span)),
      tracked_rewrap(c, ck_operator_bad(c, op, span), ck_operator_bad_frame_tracked(c, op, span)),
      ordered
    )
    Cons(a, rest) => operator_rest_frame_tracked(
      c,
      op,
      arguments,
      span,
      occurrence,
      a,
      rest,
      ordered
    )
  }
}

pub theorem ck_operator_of_run_frame_tracked(
  c: Checker,
  op: Text,
  args: List(Ty),
  arguments: List(SurfaceTerm),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_operator_of(c, op, args, arguments, span, occurrence)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(operator_operands_unf(c, op, args, arguments, span, occurrence)),
    operator_operands_frame_tracked(c, op, arguments, span, occurrence, args, ordered)
  )
}
pub theorem inference_use_ck_clone_of_in_tracked(
  k: Nat,
  c: Checker,
  arguments: List(SurfaceTerm),
  env: List(Local),
  span: TySpan,
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_clone_of_in(k, c, arguments, env, span)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                )
              )
            )
          )
        )
      )
    )
  )(c, arguments, env, span, ordered)
}

pub theorem inference_app_clone_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  clone: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_clone(j, c, term, function, arguments, env, name, clone)) {
  ⊢ TrackedRunFrame(
    c,
    inference_app_clone(j, c, term, function, arguments, env, name, clone)
  ) from match clone {
    true => tracked_run_rewrap(
      c,
      ck_clone_of_in(j, c, arguments, env, span_of(term)),
      inference_use_ck_clone_of_in_tracked(j, c, arguments, env, span_of(term), ordered, ih)
    )
    false => inference_app_nullary_frame_tracked(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      ck_nullary_call(c, name, arguments),
      ih,
      ordered
    )
  }
}

pub theorem inference_app_nullary_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  nullary: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_nullary(j, c, term, function, arguments, env, name, nullary)) {
  ⊢ TrackedRunFrame(
    c,
    inference_app_nullary(j, c, term, function, arguments, env, name, nullary)
  ) from match nullary {
    true => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_infer_in(j, c1, function, env)),
      ck_rewrap1(ck_error(c, constructor_without_fields_message(name), span_of(term))),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, constructor_without_fields_message(name), span_of(term))),
        frame_rewrap(
          c,
          ck_error(c, constructor_without_fields_message(name), span_of(term)),
          ck_error_frame(c, constructor_without_fields_message(name), span_of(term))
        ),
        tracked_rewrap(
          c,
          ck_error(c, constructor_without_fields_message(name), span_of(term)),
          ck_error_frame_tracked(c, constructor_without_fields_message(name), span_of(term))
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_infer_in(j, c1, function, env),
        inference_use_ck_infer_in_tracked(j, c1, function, env, o_c1, ih)
      )
    )
    false => tracked_run_rewrap(
      c,
      ck_app_call_in(j, c, term, function, arguments, env),
      inference_use_ck_app_call_in_tracked(j, c, term, function, arguments, env, ordered, ih)
    )
  }
}

pub theorem inference_app_operator_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  operator: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_operator(j, c, term, function, arguments, env, name, operator)) {
  ⊢ TrackedRunFrame(
    c,
    inference_app_operator(j, c, term, function, arguments, env, name, operator)
  ) from match operator {
    true => tracked_run_bind(
      <A: List(Ty), B: Ty>,
      c,
      (args: List(Ty), c1: Checker) => ck_rewrap1(
        ck_operator_of(c1, name, args, arguments, span_of(term), term.occurrence)
      ),
      ck_operands_in(j, c, arguments, env),
      inference_use_ck_operands_in_tracked(j, c, arguments, env, ordered, ih),
      args => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_operator_of(c1, name, args, arguments, span_of(term), term.occurrence),
        ck_operator_of_run_frame_tracked(
          c1,
          name,
          args,
          arguments,
          span_of(term),
          term.occurrence,
          o_c1
        )
      )
    )
    false => inference_app_clone_frame_tracked(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Bool::and(
        Text::eq(name, "clone"),
        not(Ordmap::contains(inference_fns(c), name, Ordmap::compare_text))
      ),
      ih,
      ordered
    )
  }
}

pub theorem inference_app_ascribe_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  ascribe: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_ascribe(j, c, term, function, arguments, env, name, ascribe)) {
  ⊢ TrackedRunFrame(
    c,
    inference_app_ascribe(j, c, term, function, arguments, env, name, ascribe)
  ) from match ascribe {
    true => tracked_run_bind(
      <A: List(Ty), B: Ty>,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_ascribe_of(c1, types, term, arguments)),
      ck_infer_each_in(j, c, ascribe_body(arguments), env),
      inference_use_ck_infer_each_in_tracked(j, c, ascribe_body(arguments), env, ordered, ih),
      types => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_ascribe_of(c1, types, term, arguments),
        ck_ascribe_of_run_frame_tracked(c1, types, term, arguments, o_c1)
      )
    )
    false => inference_app_operator_frame_tracked(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      ck_is_operator(name),
      ih,
      ordered
    )
  }
}

pub theorem inference_app_product_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  product: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_product(j, c, term, function, arguments, env, name, product)) {
  ⊢ TrackedRunFrame(
    c,
    inference_app_product(j, c, term, function, arguments, env, name, product)
  ) from match product {
    true => tracked_run_bind(
      <A: List(Ty), B: Ty>,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(
        ck_product_of(c1, types, arguments, span_of(term))
      ),
      ck_infer_each_in(j, c, arguments, env),
      inference_use_ck_infer_each_in_tracked(j, c, arguments, env, ordered, ih),
      types => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_product_of(c1, types, arguments, span_of(term)),
        ck_product_of_run_frame_tracked(c1, types, arguments, span_of(term), o_c1)
      )
    )
    false => inference_app_ascribe_frame_tracked(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Text::eq(name, "#ascribe"),
      ih,
      ordered
    )
  }
}

pub theorem inference_app_name_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  r#direct: Option(Text),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_app_name(j, c, term, function, arguments, env, r#direct)) {
  ⊢ TrackedRunFrame(
    c,
    inference_app_name(j, c, term, function, arguments, env, r#direct)
  ) from match r#direct {
    None => tracked_run_rewrap(
      c,
      ck_app_call_in(j, c, term, function, arguments, env),
      inference_use_ck_app_call_in_tracked(j, c, term, function, arguments, env, ordered, ih)
    )
    Some(name) => inference_app_product_frame_tracked(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Text::eq(name, "std::prelude::Pair::Mk"),
      ih,
      ordered
    )
  }
}

pub theorem inference_step_ck_app_in_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_step_ck_app_in(j, c, term, function, arguments, env)) {
  inference_app_name_frame_tracked(
    j,
    c,
    term,
    function,
    arguments,
    env,
    ck_direct_name(function, env),
    ih,
    ordered
  )
}

pub theorem inference_successor_ck_app_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_app_in_tracked(Succ(j)) {
  c => term => function => arguments => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_app_in(j, c, term, function, arguments, env)),
    inference_step_ck_app_in_frame_tracked(j, c, term, function, arguments, env, ih, ordered)
  )
}
pub theorem ck_instance_of_run_frame_tracked(
  gs: List(Text × Kind),
  c: Checker,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_instance_of(gs, c)) {
  tracked_run_grows(c, ck_instance_of(gs, c), And::left(inst_ok(gs, c))(ordered))
}
pub theorem access_poly_frame_tracked(
  c: Checker,
  function: SurfaceTerm,
  original: Ty,
  f: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_poly(c, function, original, f)) {
  match f {
    TyInt(pat_w) => tracked_run_return(c, original, ordered)
    TyBool => tracked_run_return(c, original, ordered)
    TyText => tracked_run_return(c, original, ordered)
    TyUnit => tracked_run_return(c, original, ordered)
    TyNever => tracked_run_return(c, original, ordered)
    TyDecimal => tracked_run_return(c, original, ordered)
    TyFloat => tracked_run_return(c, original, ordered)
    TyFloat32 => tracked_run_return(c, original, ordered)
    TyFn(pat_params, pat_result, pat_kind) => tracked_run_return(c, original, ordered)
    TyUnion(pat_members) => tracked_run_return(c, original, ordered)
    TyProduct(pat_members) => tracked_run_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => tracked_run_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => tracked_run_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => tracked_run_return(c, original, ordered)
    TyInfo(pat_inner) => tracked_run_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => tracked_run_return(c, original, ordered)
    TyVar(pat_v) => tracked_run_return(c, original, ordered)
    TyPoly(gs, t) => tracked_run_bind(
      <A: Ordmap(Text, Ty), B: Ty>,
      c,
      (fresh: Ordmap(Text, Ty), c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (ignored: Unit, c2: Checker) => mut1(ty_substitute(t, fresh), c2),
        access_record_term(c1, function, ty_substitute(t, fresh))
      ),
      ck_instance_of(gs, c),
      ck_instance_of_run_frame_tracked(gs, c, ordered),
      fresh => c1 => o_c1 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c1,
        (ignored: Unit, c2: Checker) => mut1(ty_substitute(t, fresh), c2),
        access_record_term(c1, function, ty_substitute(t, fresh)),
        tracked_run_read(
          c1,
          access_record_term(c1, function, ty_substitute(t, fresh)),
          access_record_term_frame(c1, function, ty_substitute(t, fresh)),
          access_record_term_frame_tracked(c1, function, ty_substitute(t, fresh)),
          o_c1
        ),
        ignored => c2 => o_c2 => tracked_run_return(c2, ty_substitute(t, fresh), o_c2)
      )
    )
    TyApp(pat_head, pat_arg) => tracked_run_return(c, original, ordered)
  }
}

pub theorem ck_poly_instance_run_frame_tracked(
  c: Checker,
  function: SurfaceTerm,
  f: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_poly_instance(c, function, f)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_poly_unf(c, function, f)),
    access_poly_frame_tracked(c, function, f, ck_resolve(c, f), ordered)
  )
}

pub theorem access_named_implicit_frame_tracked(
  c: Checker,
  fresh: Ordmap(Text, Ty),
  named: SurfaceField,
  found: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_named_implicit(c, fresh, named, found)) {
  match found {
    Some(v) => tracked_run_bind(
      <A: Ty, B: Unit>,
      c,
      (want: Ty, c1: Checker) => ck_rewrap1(
        ck_expect(c1, want, v, span_of(named.value), what_argument_message())
      ),
      ck_written_here(c, named.value),
      tracked_run_read(c, ck_written_here(c, named.value), ck_written_here_frame(c, named.value), ck_written_here_frame_tracked(c, named.value), ordered),
      want => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_expect(c1, want, v, span_of(named.value), what_argument_message()),
        ck_expect_run_frame_tracked(c1, want, v, span_of(named.value), what_argument_message(), o_c1)
      )
    )
    None => tracked_run_read(
      c,
      ck_error(c, no_type_argument_named_message(named.name), span_of(named.value)),
      ck_error_frame(c, no_type_argument_named_message(named.name), span_of(named.value)),
      ck_error_frame_tracked(c, no_type_argument_named_message(named.name), span_of(named.value)),
      ordered
    )
  }
}

pub theorem ck_named_implicit_run_frame_tracked(
  c: Checker,
  fresh: Ordmap(Text, Ty),
  named: SurfaceField,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_named_implicit(c, fresh, named)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_named_implicit_unf(c, fresh, named)),
    access_named_implicit_frame_tracked(
      c,
      fresh,
      named,
      Ordmap::get(fresh, named.name, Ordmap::compare_text),
      ordered
    )
  )
}

pub theorem ck_named_implicits_run_frame_tracked(
  c: Checker,
  fresh: Ordmap(Text, Ty),
  named: List(SurfaceField),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_named_implicits(c, fresh, named)) {
  match named {
    Nil => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
      Eq::sym(access_named_implicits_unf(c, fresh, Nil)),
      tracked_run_return(c, (), ordered)
    )
    Cons(f, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
      Eq::sym(access_named_implicits_unf(c, fresh, Cons(f, rest))),
      tracked_run_bind(
        <A: Unit, B: Unit>,
        c,
        (ignored: Unit, c1: Checker) => ck_rewrap1(ck_named_implicits(c1, fresh, rest)),
        ck_named_implicit(c, fresh, f),
        ck_named_implicit_run_frame_tracked(c, fresh, f, ordered),
        ignored => c1 => o_c1 => tracked_run_rewrap(
          c1,
          ck_named_implicits(c1, fresh, rest),
          ck_named_implicits_run_frame_tracked(c1, fresh, rest, o_c1)
        )
      )
    )
  }
}

pub theorem access_poly_named_frame_tracked(
  c: Checker,
  function: SurfaceTerm,
  original: Ty,
  named: List(SurfaceField),
  f: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_poly_named(c, function, original, named, f)) {
  match f {
    TyInt(pat_w) => tracked_run_return(c, original, ordered)
    TyBool => tracked_run_return(c, original, ordered)
    TyText => tracked_run_return(c, original, ordered)
    TyUnit => tracked_run_return(c, original, ordered)
    TyNever => tracked_run_return(c, original, ordered)
    TyDecimal => tracked_run_return(c, original, ordered)
    TyFloat => tracked_run_return(c, original, ordered)
    TyFloat32 => tracked_run_return(c, original, ordered)
    TyFn(pat_params, pat_result, pat_kind) => tracked_run_return(c, original, ordered)
    TyUnion(pat_members) => tracked_run_return(c, original, ordered)
    TyProduct(pat_members) => tracked_run_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => tracked_run_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => tracked_run_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => tracked_run_return(c, original, ordered)
    TyInfo(pat_inner) => tracked_run_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => tracked_run_return(c, original, ordered)
    TyVar(pat_v) => tracked_run_return(c, original, ordered)
    TyPoly(gs, t) => tracked_run_bind(
      <A: Ordmap(Text, Ty), B: Ty>,
      c,
      (fresh: Ordmap(Text, Ty), c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (ignored: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (done: Unit, c3: Checker) => mut1(ty_substitute(t, fresh), c3),
          ck_named_implicits(c2, fresh, named)
        ),
        access_record_term(c1, function, ty_substitute(t, fresh))
      ),
      ck_instance_of(gs, c),
      ck_instance_of_run_frame_tracked(gs, c, ordered),
      fresh => c1 => o_c1 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c1,
        (ignored: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (done: Unit, c3: Checker) => mut1(ty_substitute(t, fresh), c3),
          ck_named_implicits(c2, fresh, named)
        ),
        access_record_term(c1, function, ty_substitute(t, fresh)),
        tracked_run_read(c1, access_record_term(c1, function, ty_substitute(t, fresh)), access_record_term_frame(c1, function, ty_substitute(t, fresh)), access_record_term_frame_tracked(c1, function, ty_substitute(t, fresh)), o_c1),
        ignored => c2 => o_c2 => tracked_run_bind(
          <A: Unit, B: Ty>,
          c2,
          (done: Unit, c3: Checker) => mut1(ty_substitute(t, fresh), c3),
          ck_named_implicits(c2, fresh, named),
          ck_named_implicits_run_frame_tracked(c2, fresh, named, o_c2),
          done => c3 => o_c3 => tracked_run_return(c3, ty_substitute(t, fresh), o_c3)
        )
      )
    )
    TyApp(pat_head, pat_arg) => tracked_run_return(c, original, ordered)
  }
}

pub theorem ck_poly_instance_named_run_frame_tracked(
  c: Checker,
  function: SurfaceTerm,
  f: Ty,
  named: List(SurfaceField),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_poly_instance_named(c, function, f, named)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_poly_named_unf(c, function, f, named)),
    access_poly_named_frame_tracked(c, function, f, named, ck_resolve(c, f), ordered)
  )
}

pub theorem access_top_level_frame_tracked(
  c: Checker,
  plan: Option(Ordmap(Text, Ty) × List(SurfaceField)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_top_level(c, plan)) {
  match plan {
    None => tracked_run_return(c, (), ordered)
    Some(p) => tracked_run_rewrap(
      c,
      ck_named_implicits(c, p.fst, p.snd),
      ck_named_implicits_run_frame_tracked(c, p.fst, p.snd, ordered)
    )
  }
}

pub theorem ck_named_top_level_run_frame_tracked(
  c: Checker,
  function: SurfaceTerm,
  inferred: Ty,
  named: List(SurfaceField),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_named_top_level(c, function, inferred, named)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_top_level_unf(c, function, inferred, named)),
    access_top_level_frame_tracked(c, ck_named_top_plan(c, function, inferred, named), ordered)
  )
}

pub theorem ck_call_instance_run_frame_tracked(
  c: Checker,
  function: SurfaceTerm,
  inferred: Ty,
  named: List(SurfaceField),
  hint: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_call_instance(c, function, inferred, named, hint)) {
  tracked_run_bind(
    <A: Ty, B: Ty>,
    c,
    (f: Ty, c1: Checker) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c2: Checker) => frame_bind(
        <A: Bool, B: Ty>,
        (fixed: Bool, c3: Checker) => mut1(ck_named_constructor(ty_unborrowed(ck_resolve(c3, f)), f, named), c3),
        ck_attempt_unify(c2, ck_hint_left(c2, f, hint), ck_hint_right(c2, f, hint))
      ),
      ck_named_top_level(c1, function, inferred, named)
    ),
    ck_poly_instance_named(c, function, inferred, named),
    ck_poly_instance_named_run_frame_tracked(c, function, inferred, named, ordered),
    f => c1 => o_c1 => tracked_run_bind(
      <A: Unit, B: Ty>,
      c1,
      (ignored: Unit, c2: Checker) => frame_bind(
        <A: Bool, B: Ty>,
        (fixed: Bool, c3: Checker) => mut1(ck_named_constructor(ty_unborrowed(ck_resolve(c3, f)), f, named), c3),
        ck_attempt_unify(c2, ck_hint_left(c2, f, hint), ck_hint_right(c2, f, hint))
      ),
      ck_named_top_level(c1, function, inferred, named),
      ck_named_top_level_run_frame_tracked(c1, function, inferred, named, o_c1),
      ignored => c2 => o_c2 => tracked_run_bind(
        <A: Bool, B: Ty>,
        c2,
        (fixed: Bool, c3: Checker) => mut1(ck_named_constructor(ty_unborrowed(ck_resolve(c3, f)), f, named), c3),
        ck_attempt_unify(c2, ck_hint_left(c2, f, hint), ck_hint_right(c2, f, hint)),
        ck_attempt_unify_run_frame_tracked(c2, ck_hint_left(c2, f, hint), ck_hint_right(c2, f, hint), o_c2),
        fixed => c3 => o_c3 => tracked_run_return(c3, ck_named_constructor(ty_unborrowed(ck_resolve(c3, f)), f, named), o_c3)
      )
    )
  )
}
pub theorem application_fn_arity_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  arguments: List(SurfaceTerm),
  args: List(Ty),
  ps: List(Ty),
  bad: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_fn_arity(c, term, arguments, args, ps, bad)) {
  match bad {
    true => tracked_run_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          function_argument_count_message(Text::of_nat(list_len(ps)), Text::of_nat(list_len(args))),
          span_of(term)
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          function_argument_count_message(Text::of_nat(list_len(ps)), Text::of_nat(list_len(args))),
          span_of(term)
        ),
        ck_error_frame(
          c,
          function_argument_count_message(Text::of_nat(list_len(ps)), Text::of_nat(list_len(args))),
          span_of(term)
        )
      ),
      tracked_rewrap(
        c,
        ck_error(
          c,
          function_argument_count_message(Text::of_nat(list_len(ps)), Text::of_nat(list_len(args))),
          span_of(term)
        ),
        ck_error_frame_tracked(
          c,
          function_argument_count_message(Text::of_nat(list_len(ps)), Text::of_nat(list_len(args))),
          span_of(term)
        )
      ),
      ordered
    )
    false => tracked_run_rewrap(
      c,
      ck_expect_args(args, c, ps, arguments),
      ck_expect_args_run_frame_tracked(args, c, ps, arguments, ordered)
    )
  }
}

pub theorem application_fn_known_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  arguments: List(SurfaceTerm),
  args: List(Ty),
  ps: List(Ty),
  r: Ty,
  known: Option(List(Ty)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_fn_known(c, term, arguments, args, ps, r, known)) {
  match known {
    Some(kp) => tracked_run_return(c, r, ordered)
    None => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(r, c1),
      application_fn_arity(
        c,
        term,
        arguments,
        args,
        ps,
        not(Nat::eq(list_len(ps), list_len(args)))
      ),
      application_fn_arity_frame_tracked(
        c,
        term,
        arguments,
        args,
        ps,
        not(Nat::eq(list_len(ps), list_len(args))),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, r, o_c1)
    )
  }
}

pub theorem application_fn_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  f: Ty,
  known: Option(List(Ty)),
  args: List(Ty),
  original: Ty,
  fr: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_fn(c, term, function, arguments, f, known, args, original, fr)) {
  ⊢ TrackedRunFrame(
    c,
    application_fn(c, term, function, arguments, f, known, args, original, fr)
  ) from match fr {
    TyInt(pat_w) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyBool => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyText => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyUnit => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyNever => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyDecimal => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyFloat => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyFloat32 => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyFn(ps, r, fk) => application_fn_known_frame_tracked(
      c,
      term,
      arguments,
      args,
      ps,
      r,
      known,
      ordered
    )
    TyUnion(pat_members) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyProduct(pat_members) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyTagged(pat_tags, pat_inner) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyNamed(pat_name, pat_args) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyParam(pat_name, pat_bound) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyInfo(pat_inner) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyBorrow(pat_inner, pat_mutable) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyVar(v) => tracked_run_bind(
      <A: Ty, B: Ty>,
      c,
      (r: Ty, c1: Checker) => frame_bind(
        <A: Bool, B: Ty>,
        (unified: Bool, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (ignored: Unit, c3: Checker) => mut1(r, c3),
          frame_error_if(
            c2,
            cannot_infer_function_type_message(),
            span_of(function),
            not(unified)
          )
        ),
        ck_unify(c1, f, TyFn(args, r, KindShared))
      ),
      ck_fresh(c),
      tracked_run_read(c, ck_fresh(c), ck_fresh_frame(c), ck_fresh_frame_tracked(c), ordered),
      r => c1 => o_c1 => tracked_run_bind(
        <A: Bool, B: Ty>,
        c1,
        (unified: Bool, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (ignored: Unit, c3: Checker) => mut1(r, c3),
          frame_error_if(
            c2,
            cannot_infer_function_type_message(),
            span_of(function),
            not(unified)
          )
        ),
        ck_unify(c1, f, TyFn(args, r, KindShared)),
        ck_unify_run_frame_tracked(c1, f, TyFn(args, r, KindShared), o_c1),
        unified => c2 => o_c2 => tracked_run_bind(
          <A: Unit, B: Ty>,
          c2,
          (ignored: Unit, c3: Checker) => mut1(r, c3),
          frame_error_if(
            c2,
            cannot_infer_function_type_message(),
            span_of(function),
            not(unified)
          ),
          tracked_run_read(
            c2,
            frame_error_if(
              c2,
              cannot_infer_function_type_message(),
              span_of(function),
              not(unified)
            ),
            frame_error_if_ok(
              c2,
              cannot_infer_function_type_message(),
              span_of(function),
              not(unified)
            ),
            frame_error_if_ok_tracked(
              c2,
              cannot_infer_function_type_message(),
              span_of(function),
              not(unified)
            ),
            o_c2
          ),
          ignored => c3 => o_c3 => tracked_run_return(c3, r, o_c3)
        )
      )
    )
    TyPoly(pat_generics, pat_inner) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    TyApp(pat_head, pat_arg) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
      tracked_run_read(
        c,
        ck_error(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame(c, not_a_function_message(ty_show(original)), span_of(function)),
        ck_error_frame_tracked(c, not_a_function_message(ty_show(original)), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
  }
}

pub theorem ck_app_result_run_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  f: Ty,
  known: Option(List(Ty)),
  args: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_app_result(c, term, function, arguments, f, known, args)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(application_fn_unf(c, term, function, arguments, f, known, args)),
    application_fn_frame_tracked(
      c,
      term,
      function,
      arguments,
      f,
      known,
      args,
      ty_unborrowed(ck_resolve(c, f)),
      ty_unborrowed(ck_resolve(c, f)),
      ordered
    )
  )
}
pub theorem inference_call_args_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  f: Ty,
  known: Option(List(Ty)),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_call_args(j, c, term, function, arguments, env, f, known)) {
  tracked_run_bind(
    <A: List(Ty), B: Ty>,
    c,
    (args: List(Ty), c1: Checker) => ck_rewrap1(
      ck_app_result(c1, term, function, arguments, f, known, args)
    ),
    ck_app_args_in(j, c, arguments, known, env, 0),
    inference_use_ck_app_args_in_tracked(j, c, arguments, known, env, 0, ordered, ih),
    args => c1 => o_c1 => tracked_run_rewrap(
      c1,
      ck_app_result(c1, term, function, arguments, f, known, args),
      ck_app_result_run_frame_tracked(c1, term, function, arguments, f, known, args, o_c1)
    )
  )
}

pub theorem inference_step_ck_app_call_in_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_step_ck_app_call_in(j, c, term, function, arguments, env)) {
  tracked_run_bind(
    <A: Unit, B: Ty>,
    c,
    (cleared: Unit, c0: Checker) => frame_bind(
      <A: Ty, B: Ty>,
      (t: Ty, c1: Checker) => frame_bind(
        <A: Ty, B: Ty>,
        (f: Ty, c2: Checker) => inference_call_args(
          j,
          c2,
          term,
          function,
          ck_call_arguments(arguments),
          env,
          f,
          ck_known_params(c2, f, list_len(ck_call_arguments(arguments)))
        ),
        ck_call_instance(c1, function, t, ck_call_implicits(arguments), inference_result_hint(c))
      ),
      ck_infer_in(j, c0, function, env)
    ),
    inference_set_result_hint(c, None),
    tracked_run_read(c, inference_set_result_hint(c, None), inference_set_result_hint_frame(c, None), inference_set_result_hint_frame_tracked(c, None), ordered),
    cleared => c0 => o_c0 => tracked_run_bind(
      <A: Ty, B: Ty>,
      c0,
      (t: Ty, c1: Checker) => frame_bind(
        <A: Ty, B: Ty>,
        (f: Ty, c2: Checker) => inference_call_args(
          j,
          c2,
          term,
          function,
          ck_call_arguments(arguments),
          env,
          f,
          ck_known_params(c2, f, list_len(ck_call_arguments(arguments)))
        ),
        ck_call_instance(c1, function, t, ck_call_implicits(arguments), inference_result_hint(c))
      ),
      ck_infer_in(j, c0, function, env),
      inference_use_ck_infer_in_tracked(j, c0, function, env, o_c0, ih),
      t => c1 => o_c1 => tracked_run_bind(
        <A: Ty, B: Ty>,
        c1,
        (f: Ty, c2: Checker) => inference_call_args(
          j,
          c2,
          term,
          function,
          ck_call_arguments(arguments),
          env,
          f,
          ck_known_params(c2, f, list_len(ck_call_arguments(arguments)))
        ),
        ck_call_instance(c1, function, t, ck_call_implicits(arguments), inference_result_hint(c)),
        ck_call_instance_run_frame_tracked(c1, function, t, ck_call_implicits(arguments), inference_result_hint(c), o_c1),
        f => c2 => o_c2 => inference_call_args_frame_tracked(
          j,
          c2,
          term,
          function,
          ck_call_arguments(arguments),
          env,
          f,
          ck_known_params(c2, f, list_len(ck_call_arguments(arguments))),
          ih,
          o_c2
        )
      )
    )
  )
}

pub theorem inference_successor_ck_app_call_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_app_call_in_tracked(Succ(j)) {
  c => term => function => arguments => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_app_call_in(j, c, term, function, arguments, env)),
    inference_step_ck_app_call_in_frame_tracked(j, c, term, function, arguments, env, ih, ordered)
  )
}
pub theorem inference_successor_ck_operands_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_operands_in_tracked(Succ(j)) {
  c => arguments => env => ordered => Eq::subst(
    (z: Mut1(List(Ty), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_operands_in(j, c, arguments, env)),
    inference_step_ck_operands_in_frame_tracked(j, c, arguments, env, ih, ordered)
  )
}
pub theorem inference_clone_rest_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  span: TySpan,
  arg: SurfaceTerm,
  rest: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_clone_rest(j, c, env, span, arg, rest)) {
  match rest {
    Nil => tracked_run_bind(
      <A: Ty, B: Ty>,
      c,
      (t0: Ty, c1: Checker) => ck_rewrap1(ck_clone_value(c1, t0, arg, span)),
      ck_infer_in(j, c, arg, env),
      inference_use_ck_infer_in_tracked(j, c, arg, env, ordered, ih),
      t0 => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_clone_value(c1, t0, arg, span)),
        frame_rewrap(
          c1,
          ck_clone_value(c1, t0, arg, span),
          ck_clone_value_frame(c1, t0, arg, span)
        ),
        tracked_rewrap(
          c1,
          ck_clone_value(c1, t0, arg, span),
          ck_clone_value_frame_tracked(c1, t0, arg, span)
        ),
        o_c1
      )
    )
    Cons(x, more) => tracked_run_read(
      c,
      ck_rewrap1(ck_clone_bad(c, span)),
      frame_rewrap(c, ck_clone_bad(c, span), ck_clone_bad_frame(c, span)),
      tracked_rewrap(c, ck_clone_bad(c, span), ck_clone_bad_frame_tracked(c, span)),
      ordered
    )
  }
}

pub theorem inference_clone_args_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  span: TySpan,
  arguments: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_clone_args(j, c, env, span, arguments)) {
  match arguments {
    Nil => tracked_run_read(
      c,
      ck_rewrap1(ck_clone_bad(c, span)),
      frame_rewrap(c, ck_clone_bad(c, span), ck_clone_bad_frame(c, span)),
      tracked_rewrap(c, ck_clone_bad(c, span), ck_clone_bad_frame_tracked(c, span)),
      ordered
    )
    Cons(arg, rest) => inference_clone_rest_frame_tracked(j, c, env, span, arg, rest, ih, ordered)
  }
}

pub theorem inference_step_ck_clone_of_in_frame_tracked(
  j: Nat,
  c: Checker,
  arguments: List(SurfaceTerm),
  env: List(Local),
  span: TySpan,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_clone_of_in(j, c, arguments, env, span)
) { inference_clone_args_frame_tracked(j, c, env, span, arguments, ih, ordered) }

pub theorem inference_successor_ck_clone_of_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_clone_of_in_tracked(Succ(j)) {
  c => arguments => env => span => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_clone_of_in(j, c, arguments, env, span)),
    inference_step_ck_clone_of_in_frame_tracked(j, c, arguments, env, span, ih, ordered)
  )
}
pub theorem argument_hint_cons_frame_tracked(
  p: Ty,
  rest: List(Ty),
  c: Checker,
  hs: List(Ty),
  ih: ∀ next: Checker. ∀ hs: List(
    Ty
  ). ∀ ordered: CkOrdered(next). TrackedRunFrame(next, ck_lambda_hint(rest, next, hs)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_hint_cons(p, rest, c, hs)) {
  match hs {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(h, more) => tracked_run_bind(
      <A: Bool, B: Unit>,
      c,
      (ignored: Bool, c1: Checker) => ck_rewrap1(ck_lambda_hint(rest, c1, more)),
      ck_attempt_unify(c, p, h),
      ck_attempt_unify_run_frame_tracked(c, p, h, ordered),
      ignored => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_lambda_hint(rest, c1, more),
        ih(c1, more, o_c1)
      )
    )
  }
}

pub theorem ck_lambda_hint_run_frame_tracked(
  ps: List(Ty),
  c: Checker,
  hs: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_lambda_hint(ps, c, hs)) {
  match ps {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(p, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
      Eq::sym(argument_hint_cons_unf(p, rest, c, hs)),
      argument_hint_cons_frame_tracked(
        p,
        rest,
        c,
        hs,
        next => more => onext => ck_lambda_hint_run_frame_tracked(rest, next, more, onext),
        ordered
      )
    )
  }
}

pub theorem access_hint_arity_frame_tracked(
  c: Checker,
  ps: List(Ty),
  hs: List(Ty),
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_hint_arity(c, ps, hs, same)) {
  match same {
    true => tracked_run_rewrap(
      c,
      ck_lambda_hint(ps, c, hs),
      ck_lambda_hint_run_frame_tracked(ps, c, hs, ordered)
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem access_hint_type_frame_tracked(
  c: Checker,
  ps: List(Ty),
  t: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_hint_type(c, ps, t)) {
  match t {
    TyInt(pat_w) => tracked_run_return(c, Star, ordered)
    TyBool => tracked_run_return(c, Star, ordered)
    TyText => tracked_run_return(c, Star, ordered)
    TyUnit => tracked_run_return(c, Star, ordered)
    TyNever => tracked_run_return(c, Star, ordered)
    TyDecimal => tracked_run_return(c, Star, ordered)
    TyFloat => tracked_run_return(c, Star, ordered)
    TyFloat32 => tracked_run_return(c, Star, ordered)
    TyFn(hs, r, fk) => access_hint_arity_frame_tracked(
      c,
      ps,
      hs,
      Nat::eq(list_len(hs), list_len(ps)),
      ordered
    )
    TyUnion(pat_members) => tracked_run_return(c, Star, ordered)
    TyProduct(pat_members) => tracked_run_return(c, Star, ordered)
    TyTagged(pat_tags, pat_inner) => tracked_run_return(c, Star, ordered)
    TyNamed(pat_name, pat_args) => tracked_run_return(c, Star, ordered)
    TyParam(pat_name, pat_bound) => tracked_run_return(c, Star, ordered)
    TyInfo(pat_inner) => tracked_run_return(c, Star, ordered)
    TyBorrow(pat_inner, pat_mutable) => tracked_run_return(c, Star, ordered)
    TyVar(pat_v) => tracked_run_return(c, Star, ordered)
    TyPoly(pat_generics, pat_inner) => tracked_run_return(c, Star, ordered)
    TyApp(pat_head, pat_arg) => tracked_run_return(c, Star, ordered)
  }
}

pub theorem access_hint_frame_tracked(
  c: Checker,
  ps: List(Ty),
  hint: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, access_hint(c, ps, hint)) {
  match hint {
    None => tracked_run_return(c, Star, ordered)
    Some(h) => access_hint_type_frame_tracked(c, ps, ty_unborrowed(ck_resolve(c, h)), ordered)
  }
}

pub theorem ck_lambda_hint_of_run_frame_tracked(
  c: Checker,
  hint: Option(Ty),
  ps: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_lambda_hint_of(c, hint, ps)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(access_hint_unf(c, hint, ps)),
    access_hint_frame_tracked(c, ps, hint, ordered)
  )
}

pub theorem lw_keep_run_frame_tracked(
  c: Checker,
  p: Ty,
  t: Ty,
  before: List(TypeError),
  read: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_lambda_written_keep(c, p, t, before, read)) {
  match read {
    true => tracked_run_bind(
      <A: Bool, B: Unit>,
      c,
      (ignored: Bool, c1: Checker) => mut1(Star, c1),
      ck_attempt_unify(c, ty_unborrowed(p), t),
      ck_attempt_unify_run_frame_tracked(c, ty_unborrowed(p), t, ordered),
      ignored => c1 => o_c1 => tracked_run_return(c1, Star, o_c1)
    )
    false => AndIntro(ordered, tracked_state_refl(c))
  }
}

pub theorem lw_at_run_frame_tracked(
  c: Checker,
  p: Ty,
  o: Option(SurfaceTerm),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_lambda_written_at(c, p, o)) {
  match o {
    None => tracked_run_return(c, Star, ordered)
    Some(w) => tracked_run_rewrap(
      c,
      ck_lambda_written_one(c, p, w, ck_errors_of(c)),
      tracked_run_bind(
      <A: Ty, B: Unit>,
      c,
      lw_keep_rest(p, ck_errors_of(c)),
      ck_written_here(c, w),
      tracked_run_read(
        c,
        ck_written_here(c, w),
        ck_written_here_frame(c, w),
        ck_written_here_frame_tracked(c, w),
        ordered
      ),
      t1 => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_lambda_written_keep(
          c1,
          p,
          t1,
          ck_errors_of(c),
          list_len(ck_errors_of(c1)) == list_len(ck_errors_of(c))
        ),
        lw_keep_run_frame_tracked(
          c1,
          p,
          t1,
          ck_errors_of(c),
          list_len(ck_errors_of(c1)) == list_len(ck_errors_of(c)),
          o_c1
        )
      )
    )
    )
  }
}

pub theorem ck_lambda_written_run_frame_tracked(
  c: Checker,
  ps: List(Ty),
  types: List(Option(SurfaceTerm)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_lambda_written(c, ps, types)) {
  match ps {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(p, rest) => ⊢ TrackedRunFrame(c, ck_lambda_written(c, Cons(p, rest), types)) from match types {
      Nil => tracked_run_return(c, Star, ordered)
      Cons(o, more) => tracked_run_bind(
        <A: Unit, B: Unit>,
        c,
        (u: Unit, c1: Checker) => ck_rewrap1(ck_lambda_written(c1, rest, more)),
        ck_lambda_written_at(c, p, o),
        lw_at_run_frame_tracked(c, p, o, ordered),
        u => c1 => o_c1 => tracked_run_rewrap(
          c1,
          ck_lambda_written(c1, rest, more),
          ck_lambda_written_run_frame_tracked(c1, rest, more, o_c1)
        )
      )
    }
  }
}

pub theorem ck_lambda_hints_run_frame_tracked(
  c: Checker,
  hint: Option(Ty),
  ps: List(Ty),
  types: List(Option(SurfaceTerm)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_lambda_hints(c, hint, ps, types)) {
  tracked_run_bind(
    <A: Unit, B: Unit>,
    c,
    (u: Unit, c1: Checker) => ck_rewrap1(ck_lambda_hint_of(c1, hint, ps)),
    ck_lambda_written(c, ps, types),
    ck_lambda_written_run_frame_tracked(c, ps, types, ordered),
    u => c1 => o_c1 => tracked_run_rewrap(
      c1,
      ck_lambda_hint_of(c1, hint, ps),
      ck_lambda_hint_of_run_frame_tracked(c1, hint, ps, o_c1)
    )
  )
}

pub theorem inference_lambda_body_frame_tracked(
  j: Nat,
  c: Checker,
  params: List(Text),
  body: SurfaceTerm,
  env: List(Local),
  ps: List(Ty),
  cap: TyCaptures,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_lambda_body(j, c, params, body, env, ps, cap)) {
  inference_bind_scope_frame_tracked(
    <A: Unit, B: Ty>,
    c,
    (bound: Unit, c1: Checker, inner: Scope) => frame_bind(
      <A: Ty, B: Ty>,
      (r: Ty, c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (pushed: Unit, c3: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (b: Ty, c4: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (popped: Unit, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (checked: Unit, c6: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, captures_kind(cap)), c7),
                inference_record_closure(c6, r, body, cap)
              ),
              ck_expect(c5, b, r, span_of(body), what_function_result_message())
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4)))
          ),
          ck_infer_in(j, c3, body, inference_scope_items(inner))
        ),
        inference_set_returns(c2, Cons(r, inference_returns(c2)))
      ),
      ck_fresh(c1)
    ),
    ck_bind_params(params, c, ScopeMk(env), ps, handle_body_start(body)),
    ck_bind_params_scope_frame_tracked(
      params,
      c,
      ScopeMk(env),
      ps,
      handle_body_start(body),
      ordered
    ),
    bound => c1 => inner => o_c1 => tracked_run_bind(
      <A: Ty, B: Ty>,
      c1,
      (r: Ty, c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (pushed: Unit, c3: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (b: Ty, c4: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (popped: Unit, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (checked: Unit, c6: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, captures_kind(cap)), c7),
                inference_record_closure(c6, r, body, cap)
              ),
              ck_expect(c5, b, r, span_of(body), what_function_result_message())
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4)))
          ),
          ck_infer_in(j, c3, body, inference_scope_items(inner))
        ),
        inference_set_returns(c2, Cons(r, inference_returns(c2)))
      ),
      ck_fresh(c1),
      tracked_run_read(c1, ck_fresh(c1), ck_fresh_frame(c1), ck_fresh_frame_tracked(c1), o_c1),
      r => c2 => o_c2 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c2,
        (pushed: Unit, c3: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (b: Ty, c4: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (popped: Unit, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (checked: Unit, c6: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, captures_kind(cap)), c7),
                inference_record_closure(c6, r, body, cap)
              ),
              ck_expect(c5, b, r, span_of(body), what_function_result_message())
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4)))
          ),
          ck_infer_in(j, c3, body, inference_scope_items(inner))
        ),
        inference_set_returns(c2, Cons(r, inference_returns(c2))),
        tracked_run_read(
          c2,
          inference_set_returns(c2, Cons(r, inference_returns(c2))),
          inference_set_returns_frame(c2, Cons(r, inference_returns(c2))),
          inference_set_returns_frame_tracked(c2, Cons(r, inference_returns(c2))),
          o_c2
        ),
        pushed => c3 => o_c3 => tracked_run_bind(
          <A: Ty, B: Ty>,
          c3,
          (b: Ty, c4: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (popped: Unit, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (checked: Unit, c6: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, captures_kind(cap)), c7),
                inference_record_closure(c6, r, body, cap)
              ),
              ck_expect(c5, b, r, span_of(body), what_function_result_message())
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4)))
          ),
          ck_infer_in(j, c3, body, inference_scope_items(inner)),
          inference_use_ck_infer_in_tracked(j, c3, body, inference_scope_items(inner), o_c3, ih),
          b => c4 => o_c4 => tracked_run_bind(
            <A: Unit, B: Ty>,
            c4,
            (popped: Unit, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (checked: Unit, c6: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, captures_kind(cap)), c7),
                inference_record_closure(c6, r, body, cap)
              ),
              ck_expect(c5, b, r, span_of(body), what_function_result_message())
            ),
            inference_set_returns(c4, List::tail(inference_returns(c4))),
            tracked_run_read(
              c4,
              inference_set_returns(c4, List::tail(inference_returns(c4))),
              inference_set_returns_frame(c4, List::tail(inference_returns(c4))),
              inference_set_returns_frame_tracked(c4, List::tail(inference_returns(c4))),
              o_c4
            ),
            popped => c5 => o_c5 => tracked_run_bind(
              <A: Unit, B: Ty>,
              c5,
              (checked: Unit, c6: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, captures_kind(cap)), c7),
                inference_record_closure(c6, r, body, cap)
              ),
              ck_expect(c5, b, r, span_of(body), what_function_result_message()),
              ck_expect_run_frame_tracked(
                c5,
                b,
                r,
                span_of(body),
                what_function_result_message(),
                o_c5
              ),
              checked => c6 => o_c6 => tracked_run_bind(
                <A: Unit, B: Ty>,
                c6,
                (recorded: Unit, c7: Checker) => mut1(TyFn(ps, r, captures_kind(cap)), c7),
                inference_record_closure(c6, r, body, cap),
                tracked_run_read(
                  c6,
                  inference_record_closure(c6, r, body, cap),
                  inference_record_closure_frame(c6, r, body, cap),
                  inference_record_closure_frame_tracked(c6, r, body, cap),
                  o_c6
                ),
                recorded => c7 => o_c7 => tracked_run_return(c7, TyFn(ps, r, captures_kind(cap)), o_c7)
              )
            )
          )
        )
      )
    )
  )
}

pub theorem inference_lambda_kind_frame_tracked(
  j: Nat,
  c: Checker,
  lam: SurfaceTerm,
  r#borrows: List(Option(Bool)),
  env: List(Local),
  hint: Option(Ty),
  sk: SurfaceKind,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_lambda_kind(j, c, lam, r#borrows, env, hint, sk)) {
  match sk {
    SkVar(pat_name) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkNat(pat_digits) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkText(pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBool(pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkApp(pat_head, pat_args) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkPi(pat_params, pat_result, pat_effects) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkExists(pat_binder, pat_domain, pat_body, unused) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkLam(params, body, types, _) => tracked_run_bind(
      <A: List(Ty), B: Ty>,
      c,
      (ps: List(Ty), c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (hinted: Unit, c2: Checker) => inference_lambda_body(
          j,
          c2,
          params,
          body,
          env,
          ps,
          ck_lambda_captures(lam, c2, env)
        ),
        ck_lambda_hints(c1, hint, ps, types)
      ),
      ck_lambda_params(params, c, r#borrows),
      tracked_run_read(
        c,
        ck_lambda_params(params, c, r#borrows),
        ck_lambda_params_frame(params, c, r#borrows),
        ck_lambda_params_frame_tracked(params, c, r#borrows),
        ordered
      ),
      ps => c1 => o_c1 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c1,
        (hinted: Unit, c2: Checker) => inference_lambda_body(
          j,
          c2,
          params,
          body,
          env,
          ps,
          ck_lambda_captures(lam, c2, env)
        ),
        ck_lambda_hints(c1, hint, ps, types),
        ck_lambda_hints_run_frame_tracked(c1, hint, ps, types, o_c1),
        hinted => c2 => o_c2 => inference_lambda_body_frame_tracked(
          j,
          c2,
          params,
          body,
          env,
          ps,
          ck_lambda_captures(lam, c2, env),
          ih,
          o_c2
        )
      )
    )
    SkUnion(pat_parts) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkTagged(pat_tag, pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkIf(pat_cond, pat_then, pat_otherwise) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkField(pat_value, pat_name) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBlock(pat_stmts) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkPerform(pat_op, pat_args) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkHandle(pat_body, pat_handlers) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBudget(pat_amount_memory, pat_amount, pat_body) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkMatch(pat_scrutinee, pat_motive, pat_arms, pat_binder, _) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkHole(pat_name) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkRecord(pat_name, pat_fields) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBorrow(pat_mutable, pat_mutable_orig, pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkFnKind(pat_kind, pat_ty) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBorrowLam(pat_borrows, pat_lam) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkOther(pat_what) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkAscribe(pat_what, pat_what_ty) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkRow(pat_what_effects) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkFloat(pat_what) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkMacroCall(pat_name, pat_arg) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkQuote(pat_stmts_form, pat_stmts) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkSplice(pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkSyntaxLit(pat_name, pat_body) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkStep(pat_tactic, pat_arg, pat_call_start, pat_call_end, pat_before, pat_arms) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
  }
}

pub theorem inference_lambda_hint_frame_tracked(
  j: Nat,
  c: Checker,
  lam: SurfaceTerm,
  r#borrows: List(Option(Bool)),
  env: List(Local),
  hint: Option(Ty),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_lambda_hint(j, c, lam, r#borrows, env, hint)) {
  tracked_run_bind(
    <A: Unit, B: Ty>,
    c,
    (cleared: Unit, c1: Checker) => inference_lambda_kind(
      j,
      c1,
      lam,
      r#borrows,
      env,
      hint,
      inference_term_kind(lam)
    ),
    inference_set_hint(c, None),
    tracked_run_read(
      c,
      inference_set_hint(c, None),
      inference_set_hint_frame(c, None),
      inference_set_hint_frame_tracked(c, None),
      ordered
    ),
    cleared => c1 => o_c1 => inference_lambda_kind_frame_tracked(
      j,
      c1,
      lam,
      r#borrows,
      env,
      hint,
      inference_term_kind(lam),
      ih,
      o_c1
    )
  )
}

pub theorem inference_step_ck_lambda_in_frame_tracked(
  j: Nat,
  c: Checker,
  lam: SurfaceTerm,
  r#borrows: List(Option(Bool)),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_lambda_in(j, c, lam, r#borrows, env)
) { inference_lambda_hint_frame_tracked(j, c, lam, r#borrows, env, inference_hint(c), ih, ordered) }

pub theorem inference_successor_ck_lambda_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_lambda_in_tracked(Succ(j)) {
  c => lam => r#borrows => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_lambda_in(j, c, lam, r#borrows, env)),
    inference_step_ck_lambda_in_frame_tracked(j, c, lam, r#borrows, env, ih, ordered)
  )
}
pub theorem inference_successor_ck_record_fields_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_record_fields_in_tracked(Succ(j)) {
  c => name => fields => declared => env => seen => ordered => Eq::subst(
    (z: Mut1(List(Text), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_record_fields_in(j, c, name, fields, declared, env, seen)),
    inference_step_ck_record_fields_in_frame_tracked(
      j,
      c,
      name,
      fields,
      declared,
      env,
      seen,
      ih,
      ordered
    )
  )
}
pub theorem inference_record_values_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  d: Text,
  args: List(Ty),
  declared: List(DataField),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_record_values(j, c, name, fields, env, span, d, args, declared)) {
  tracked_run_bind(
    <A: List(Text), B: Ty>,
    c,
    (seen: List(Text), c1: Checker) => frame_bind(
      <A: Unit, B: Ty>,
      (checked: Unit, c2: Checker) => mut1(TyNamed(NameSpelled(d), args), c2),
      ck_record_missing(declared, c1, name, seen, span)
    ),
    ck_record_fields_in(j, c, name, fields, declared, env, Nil),
    inference_use_ck_record_fields_in_tracked(j, c, name, fields, declared, env, Nil, ordered, ih),
    seen => c1 => o_c1 => tracked_run_bind(
      <A: Unit, B: Ty>,
      c1,
      (checked: Unit, c2: Checker) => mut1(TyNamed(NameSpelled(d), args), c2),
      ck_record_missing(declared, c1, name, seen, span),
      tracked_run_read(
        c1,
        ck_record_missing(declared, c1, name, seen, span),
        ck_record_missing_frame(declared, c1, name, seen, span),
        ck_record_missing_frame_tracked(declared, c1, name, seen, span),
        o_c1
      ),
      checked => c2 => o_c2 => tracked_run_return(c2, TyNamed(NameSpelled(d), args), o_c2)
    )
  )
}

pub theorem inference_record_ctor_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  ctor: Option(Text × Nat),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_record_ctor(j, c, name, fields, env, span, ctor)) {
  match ctor {
    None => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_a_struct_message(name), span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, not_a_struct_message(name), span)),
        frame_rewrap(
          c,
          ck_error(c, not_a_struct_message(name), span),
          ck_error_frame(c, not_a_struct_message(name), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_a_struct_message(name), span),
          ck_error_frame_tracked(c, not_a_struct_message(name), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    Some(dc) => tracked_run_bind(
      <A: List(Ty), B: Ty>,
      c,
      (args: List(Ty), c1: Checker) => inference_record_values(
        j,
        c1,
        name,
        fields,
        env,
        span,
        pattern_ctor_name(dc),
        args,
        datas_fields(ck_datas_of(c1), pattern_ctor_name(dc), pattern_ctor_index(dc), args)
      ),
      ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
      tracked_run_read(
        c,
        ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame_tracked(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ordered
      ),
      args => c1 => o_c1 => inference_record_values_frame_tracked(
        j,
        c1,
        name,
        fields,
        env,
        span,
        pattern_ctor_name(dc),
        args,
        datas_fields(ck_datas_of(c1), pattern_ctor_name(dc), pattern_ctor_index(dc), args),
        ih,
        o_c1
      )
    )
  }
}

pub theorem inference_step_ck_record_in_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_step_ck_record_in(j, c, name, fields, env, span)) {
  inference_record_ctor_frame_tracked(
    j,
    c,
    name,
    fields,
    env,
    span,
    datas_ctor(ck_datas_of(c), name),
    ih,
    ordered
  )
}

pub theorem inference_successor_ck_record_in_tracked(
