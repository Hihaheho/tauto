pub theorem inference_step_ck_infer_term_in_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_infer_term_in(j, c, term, env)
) {
  inference_term_frame_tracked(
    j,
    c,
    term,
    env,
    span_of(term),
    inference_term_kind(term),
    ih,
    ordered
  )
}

pub theorem pattern_return_frame_tracked<A: Type>(
  c: Checker,
  env: Scope,
  v: A,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  mut2(v, c, env)
) {
  AndIntro(
    ordered,
    AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  )
}
pub theorem pattern_rewrap_frame_tracked<A: Type>(
  c: Checker,
  m: Mut2(A, Checker, Scope),
  h: TrackedScopeFrame(c, m)
): TrackedScopeFrame(c, pattern_rewrap(m)) {
  Eq::subst((z: Mut2(A, Checker, Scope)) => TrackedScopeFrame(c, z), Eq::sym(pattern_rewrap_id(m)), h)
}
pub def PatternIH_pattern_tracked(
  k: Nat
): Prop := ∀ c: Checker. ∀ p: SurfacePattern. ∀ t: Ty. ∀ env: Scope. ∀ span: TySpan. ∀ at: Nat. ∀ ordered: CkOrdered(
  c
). TrackedScopeFrame(c, ck_pattern_in(k, c, p, t, env, span, at))

pub def PatternIH_ctor_pattern_tracked(
  k: Nat
): Prop := ∀ c: Checker. ∀ name: Text. ∀ args: List(
  SurfacePattern
). ∀ t: Ty. ∀ env: Scope. ∀ span: TySpan. ∀ at: Nat. ∀ ordered: CkOrdered(
  c
). TrackedScopeFrame(c, ck_ctor_pattern_in(k, c, name, args, t, env, span, at))

pub def PatternIH_ctor_args_tracked(
  k: Nat
): Prop := ∀ c: Checker. ∀ args: List(
  SurfacePattern
). ∀ fields: List(
  DataField
). ∀ borrowed: Option(
  Bool
). ∀ env: Scope. ∀ span: TySpan. ∀ at: Nat. ∀ ordered: CkOrdered(
  c
). TrackedScopeFrame(c, ck_ctor_args_in(k, c, args, fields, borrowed, env, span, at))

pub def PatternAll_tracked(
  k: Nat
): Prop := And(
  PatternIH_pattern_tracked(k),
  And(PatternIH_ctor_pattern_tracked(k), PatternIH_ctor_args_tracked(k))
)
pub theorem ck_bind_local_scope_frame_tracked(
  c: Checker,
  env: Scope,
  name: Text,
  ty: Ty,
  mutable: Bool,
  site: Nat,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  ck_bind_local(c, env, name, ty, mutable, site)
) {
  AndIntro(
    ordered,
    AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  )
}

pub theorem pattern_bind_name_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  name: Text,
  nullary: Bool,
  ih_ctor_pattern: PatternIH_ctor_pattern_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_bind_name(j, c, t, env, span, at, name, nullary)) {
  match nullary: TrackedScopeFrame(c, pattern_bind_name(j, c, t, env, span, at, name, nullary)) {
    true => pattern_rewrap_frame_tracked(
      c,
      ck_ctor_pattern_in(j, c, name, Nil, t, env, span, at),
      ih_ctor_pattern(c, name, Nil, t, env, span, at, ordered)
    )
    false => pattern_rewrap_frame_tracked(
      c,
      ck_bind_local(c, env, name, t, false, at),
      ck_bind_local_scope_frame_tracked(c, env, name, t, false, at, ordered)
    )
  }
}

pub theorem pattern_bind_one_frame_tracked<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut2(B, Checker, Scope),
  m: Mut1(A, Checker),
  hm: TrackedRunFrame(c, m),
  hk: ∀ v: A. ∀ next: Checker. ∀ ordered: CkOrdered(next). TrackedScopeFrame(next, k(v, next))
): TrackedScopeFrame(c, pattern_bind_one(k, m)) {
  match m: TrackedScopeFrame(c, pattern_bind_one(k, m)) {
    mut1(v, next) => {
      let h: TrackedScopeFrame(next, k(v, next)) := hk(v, next, And::left(hm))
      AndIntro(
        And::left(h),
        tracked_state_trans(
          c,
          next,
          ck_st(pattern_checker(k(v, next))),
          And::right(hm),
          And::right(h)
        )
      )
    }
  }
}
pub theorem pattern_lift_frame_tracked<A: Type>(
  c: Checker,
  env: Scope,
  m: Mut1(A, Checker),
  h: TrackedRunFrame(c, m)
): TrackedScopeFrame(c, pattern_lift(env, m)) {
  match m: TrackedScopeFrame(c, pattern_lift(env, m)) { mut1(v, next) => h }
}
pub theorem pattern_literal_after_frame_tracked(
  c: Checker,
  l: Ty,
  target: Ty,
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_literal_after(c, l, target, span, same)) {
  tracked_run_read(
    c,
    frame_error_if(
      c,
      cat4(
        "a pattern of ",
        ty_show(ck_resolve(c, l)),
        " cannot match ",
        ty_show(ck_resolve(c, target))
      ),
      span,
      not(same)
    ),
    frame_error_if_ok(
      c,
      cat4(
        "a pattern of ",
        ty_show(ck_resolve(c, l)),
        " cannot match ",
        ty_show(ck_resolve(c, target))
      ),
      span,
      not(same)
    ),
    frame_error_if_ok_tracked(
      c,
      cat4(
        "a pattern of ",
        ty_show(ck_resolve(c, l)),
        " cannot match ",
        ty_show(ck_resolve(c, target))
      ),
      span,
      not(same)
    ),
    ordered
  )
}

pub theorem pattern_literal_frame_tracked(
  c: Checker,
  l: Ty,
  target: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_literal(c, l, target, span)) {
  tracked_run_bind(
    Bool,
    Unit,
    c,
    (same: Bool, c1: Checker) => pattern_literal_after(c1, l, target, span, same),
    ck_unify(c, l, target),
    ck_unify_run_frame_tracked(c, l, target, ordered),
    same => c1 => o_c1 => pattern_literal_after_frame_tracked(c1, l, target, span, same, o_c1)
  )
}

pub theorem ck_pattern_literal_run_frame_tracked(
  c: Checker,
  l: Ty,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_pattern_literal(c, l, t, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(pattern_literal_unf(c, l, t, span)),
    pattern_literal_frame_tracked(c, l, ty_unborrowed(ck_resolve(c, t)), span, ordered)
  )
}

pub theorem pattern_record_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  name: Text,
  pos: Positional,
  ih_ctor_pattern: PatternIH_ctor_pattern_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_record(j, c, t, env, span, at, name, pos)) {
  match pos: TrackedScopeFrame(c, pattern_record(j, c, t, env, span, at, name, pos)) {
    PositionalOk(args) => pattern_rewrap_frame_tracked(
      c,
      ck_ctor_pattern_in(j, c, name, args, t, env, span, at),
      ih_ctor_pattern(c, name, args, t, env, span, at, ordered)
    )
    PositionalErr(e) => pattern_lift_frame_tracked(
      c,
      env,
      ck_rewrap1(ck_error(c, e, span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, e, span)),
        frame_rewrap(c, ck_error(c, e, span), ck_error_frame(c, e, span)),
        tracked_rewrap(c, ck_error(c, e, span), ck_error_frame_tracked(c, e, span)),
        ordered
      )
    )
  }
}

pub theorem pattern_step_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  p: SurfacePattern,
  ih_ctor_pattern: PatternIH_ctor_pattern_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_step(j, c, t, env, span, at, p)) {
  match p: TrackedScopeFrame(c, pattern_step(j, c, t, env, span, at, p)) {
    PtWild => pattern_return_frame_tracked(c, env, Star, ordered)
    PtBind(name) => pattern_bind_name_frame_tracked(
      j,
      c,
      t,
      env,
      span,
      at,
      name,
      datas_nullary_expected(ck_datas_of(c), name, ck_resolve(c, t)),
      ih_ctor_pattern,
      ordered
    )
    PtInt(negative, magnitude) => pattern_bind_one_frame_tracked(
      Ty,
      Unit,
      c,
      (i: Ty, c1: Checker) => pattern_bind_one(
        Unit,
        Unit,
        (ignored: Unit, c2: Checker) => pattern_lift(env, ck_pattern_literal(c2, i, t, span)),
        pattern_literal_record(c1, negative, magnitude, i, span)
      ),
      ck_fresh_int(c),
      tracked_run_read(
        c,
        ck_fresh_int(c),
        ck_fresh_int_read_frame(c),
        ck_fresh_int_read_frame_tracked(c),
        ordered
      ),
      i => c1 => o_c1 => pattern_bind_one_frame_tracked(
        Unit,
        Unit,
        c1,
        (ignored: Unit, c2: Checker) => pattern_lift(env, ck_pattern_literal(c2, i, t, span)),
        pattern_literal_record(c1, negative, magnitude, i, span),
        tracked_run_read(
          c1,
          pattern_literal_record(c1, negative, magnitude, i, span),
          pattern_literal_record_frame(c1, negative, magnitude, i, span),
          pattern_literal_record_frame_tracked(c1, negative, magnitude, i, span),
          o_c1
        ),
        ignored => c2 => o_c2 => pattern_lift_frame_tracked(
          c2,
          env,
          ck_pattern_literal(c2, i, t, span),
          ck_pattern_literal_run_frame_tracked(c2, i, t, span, o_c2)
        )
      )
    )
    PtBool(b) => pattern_lift_frame_tracked(
      c,
      env,
      ck_pattern_literal(c, TyBool, t, span),
      ck_pattern_literal_run_frame_tracked(c, TyBool, t, span, ordered)
    )
    PtText(s) => pattern_lift_frame_tracked(
      c,
      env,
      ck_pattern_literal(c, TyText, t, span),
      ck_pattern_literal_run_frame_tracked(c, TyText, t, span, ordered)
    )
    PtCtor(name, args) => pattern_rewrap_frame_tracked(
      c,
      ck_ctor_pattern_in(j, c, name, args, t, env, span, at),
      ih_ctor_pattern(c, name, args, t, env, span, at, ordered)
    )
    PtRecord(name, fields) => pattern_record_frame_tracked(
      j,
      c,
      t,
      env,
      span,
      at,
      name,
      datas_positional_expected(ck_datas_of(c), name, fields, ck_resolve(c, t)),
      ih_ctor_pattern,
      ordered
    )
    PtOther(what) => pattern_lift_frame_tracked(
      c,
      env,
      ck_rewrap1(ck_error(c, cat2("this pattern is not supported yet: ", what), span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, cat2("this pattern is not supported yet: ", what), span)),
        frame_rewrap(
          c,
          ck_error(c, cat2("this pattern is not supported yet: ", what), span),
          ck_error_frame(c, cat2("this pattern is not supported yet: ", what), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, cat2("this pattern is not supported yet: ", what), span),
          ck_error_frame_tracked(c, cat2("this pattern is not supported yet: ", what), span)
        ),
        ordered
      )
    )
  }
}

pub theorem pattern_ctor_arity_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  fields: List(DataField),
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_arity(c, name, args, fields, span, same)) {
  match same: TrackedRunFrame(c, pattern_ctor_arity(c, name, args, fields, span, same)) {
    false => tracked_run_return(c, Some(fields), ordered)
    true => tracked_run_bind(
      Unit,
      Option(List(DataField)),
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(
        c,
        cat5(
          name,
          " has ",
          Text::of_nat(list_len(fields)),
          " fields, the pattern ",
          Text::of_nat(list_len(args))
        ),
        span
      ),
      tracked_run_read(
        c,
        ck_error(
          c,
          cat5(
            name,
            " has ",
            Text::of_nat(list_len(fields)),
            " fields, the pattern ",
            Text::of_nat(list_len(args))
          ),
          span
        ),
        ck_error_frame(
          c,
          cat5(
            name,
            " has ",
            Text::of_nat(list_len(fields)),
            " fields, the pattern ",
            Text::of_nat(list_len(args))
          ),
          span
        ),
        ck_error_frame_tracked(
          c,
          cat5(
            name,
            " has ",
            Text::of_nat(list_len(fields)),
            " fields, the pattern ",
            Text::of_nat(list_len(args))
          ),
          span
        ),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, None, o_c1)
    )
  }
}

pub theorem pattern_ctor_same_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  dc: Pair(Text, Nat),
  targs: List(Ty),
  target: Ty,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_same(c, name, args, t, span, dc, targs, target, same)) {
  match same: TrackedRunFrame(
    c,
    pattern_ctor_same(c, name, args, t, span, dc, targs, target, same)
  ) {
    false => pattern_ctor_arity_frame_tracked(
      c,
      name,
      args,
      datas_fields(ck_datas_of(c), pattern_ctor_name(dc), pattern_ctor_index(dc), targs),
      span,
      not(
        Nat::eq(
          list_len(
            datas_fields(ck_datas_of(c), pattern_ctor_name(dc), pattern_ctor_index(dc), targs)
          ),
          list_len(args)
        )
      ),
      ordered
    )
    true => tracked_run_bind(
      Unit,
      Option(List(DataField)),
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(
        c,
        cat4(
          "a pattern of ",
          pattern_ctor_name(dc),
          " cannot match ",
          ty_show(ck_shown(c, target))
        ),
        span
      ),
      tracked_run_read(
        c,
        ck_error(
          c,
          cat4(
            "a pattern of ",
            pattern_ctor_name(dc),
            " cannot match ",
            ty_show(ck_shown(c, target))
          ),
          span
        ),
        ck_error_frame(
          c,
          cat4(
            "a pattern of ",
            pattern_ctor_name(dc),
            " cannot match ",
            ty_show(ck_shown(c, target))
          ),
          span
        ),
        ck_error_frame_tracked(
          c,
          cat4(
            "a pattern of ",
            pattern_ctor_name(dc),
            " cannot match ",
            ty_show(ck_shown(c, target))
          ),
          span
        ),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, None, o_c1)
    )
  }
}

pub theorem pattern_ctor_unify_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  dc: Pair(Text, Nat),
  targs: List(Ty),
  target: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_unify(c, name, args, t, span, dc, targs, target)) {
  tracked_run_bind(
    Bool,
    Option(List(DataField)),
    c,
    (same: Bool, c1: Checker) => pattern_ctor_same(
      c1,
      name,
      args,
      t,
      span,
      dc,
      targs,
      target,
      not(same)
    ),
    ck_unify(c, target, TyNamed(pattern_ctor_name(dc), targs)),
    ck_unify_run_frame_tracked(c, target, TyNamed(pattern_ctor_name(dc), targs), ordered),
    same => c1 => o_c1 => pattern_ctor_same_frame_tracked(
      c1,
      name,
      args,
      t,
      span,
      dc,
      targs,
      target,
      not(same),
      o_c1
    )
  )
}

pub theorem pattern_ctor_lookup_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  found: Option(Pair(Text, Nat)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_lookup(c, name, args, t, span, found)) {
  match found: TrackedRunFrame(c, pattern_ctor_lookup(c, name, args, t, span, found)) {
    None => tracked_run_bind(
      Unit,
      Option(List(DataField)),
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, datas_ctor_error(ck_datas_of(c), name), span),
      tracked_run_read(
        c,
        ck_error(c, datas_ctor_error(ck_datas_of(c), name), span),
        ck_error_frame(c, datas_ctor_error(ck_datas_of(c), name), span),
        ck_error_frame_tracked(c, datas_ctor_error(ck_datas_of(c), name), span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, None, o_c1)
    )
    Some(dc) => tracked_run_bind(
      List(Ty),
      Option(List(DataField)),
      c,
      (targs: List(Ty), c1: Checker) => pattern_ctor_unify(
        c1,
        name,
        args,
        t,
        span,
        dc,
        targs,
        ty_unborrowed(ck_resolve(c1, t))
      ),
      ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
      tracked_run_read(
        c,
        ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame_tracked(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ordered
      ),
      targs => c1 => o_c1 => pattern_ctor_unify_frame_tracked(
        c1,
        name,
        args,
        t,
        span,
        dc,
        targs,
        ty_unborrowed(ck_resolve(c1, t)),
        o_c1
      )
    )
  }
}

pub theorem ck_ctor_fields_run_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_ctor_fields(c, name, args, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(pattern_ctor_fields_unf(c, name, args, t, span)),
    pattern_ctor_lookup_frame_tracked(
      c,
      name,
      args,
      t,
      span,
      datas_ctor_expected(ck_datas_of(c), name, ck_resolve(c, t)),
      ordered
    )
  )
}
pub theorem pattern_fields_next_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  borrowed: Option(Bool),
  found: Option(List(DataField)),
  ih_ctor_args: PatternIH_ctor_args_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_fields_next(j, c, name, args, t, env, span, at, borrowed, found)) {
  match found: TrackedScopeFrame(
    c,
    pattern_fields_next(j, c, name, args, t, env, span, at, borrowed, found)
  ) {
    None => pattern_return_frame_tracked(c, env, Star, ordered)
    Some(fields) => pattern_rewrap_frame_tracked(
      c,
      ck_ctor_args_in(j, c, args, fields, borrowed, env, span, at),
      ih_ctor_args(c, args, fields, borrowed, env, span, at, ordered)
    )
  }
}

pub theorem pattern_ctor_step_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  borrowed: Option(Bool),
  ih_ctor_args: PatternIH_ctor_args_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  pattern_ctor_step(j, c, name, args, t, env, span, at, borrowed)
) {
  pattern_bind_one_frame_tracked(
    Option(List(DataField)),
    Unit,
    c,
    (found: Option(List(DataField)), c1: Checker) => pattern_fields_next(
      j,
      c1,
      name,
      args,
      t,
      env,
      span,
      at,
      borrowed,
      found
    ),
    ck_ctor_fields(c, name, args, t, span),
    ck_ctor_fields_run_frame_tracked(c, name, args, t, span, ordered),
    found => c1 => o_c1 => pattern_fields_next_frame_tracked(
      j,
      c1,
      name,
      args,
      t,
      env,
      span,
      at,
      borrowed,
      found,
      ih_ctor_args,
      o_c1
    )
  )
}

pub theorem pattern_args_fields_frame_tracked(
  j: Nat,
  c: Checker,
  p: SurfacePattern,
  rest: List(SurfacePattern),
  borrowed: Option(Bool),
  env: Scope,
  span: TySpan,
  at: Nat,
  fields: List(DataField),
  ih_pattern: PatternIH_pattern_tracked(j),
  ih_ctor_args: PatternIH_ctor_args_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_args_fields(j, c, p, rest, borrowed, env, span, at, fields)) {
  match fields: TrackedScopeFrame(
    c,
    pattern_args_fields(j, c, p, rest, borrowed, env, span, at, fields)
  ) {
    Nil => pattern_return_frame_tracked(c, env, Star, ordered)
    Cons(field, more) => tracked_pattern_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker, env1: Scope) => pattern_rewrap(
        ck_ctor_args_in(j, c1, rest, more, borrowed, env1, span, at)
      ),
      ck_pattern_in(j, c, p, field_under(pattern_field_ty(field), borrowed), env, span, at),
      ih_pattern(c, p, field_under(pattern_field_ty(field), borrowed), env, span, at, ordered),
      ignored => c1 => env1 => o_c1 => pattern_rewrap_frame_tracked(
        c1,
        ck_ctor_args_in(j, c1, rest, more, borrowed, env1, span, at),
        ih_ctor_args(c1, rest, more, borrowed, env1, span, at, o_c1)
      )
    )
  }
}

pub theorem pattern_args_step_frame_tracked(
  j: Nat,
  c: Checker,
  fields: List(DataField),
  borrowed: Option(Bool),
  env: Scope,
  span: TySpan,
  at: Nat,
  args: List(SurfacePattern),
  ih_pattern: PatternIH_pattern_tracked(j),
  ih_ctor_args: PatternIH_ctor_args_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_args_step(j, c, fields, borrowed, env, span, at, args)) {
  match args: TrackedScopeFrame(
    c,
    pattern_args_step(j, c, fields, borrowed, env, span, at, args)
  ) {
    Nil => pattern_return_frame_tracked(c, env, Star, ordered)
    Cons(p, rest) => pattern_args_fields_frame_tracked(
      j,
      c,
      p,
      rest,
      borrowed,
      env,
      span,
      at,
      fields,
      ih_pattern,
      ih_ctor_args,
      ordered
    )
  }
}

pub theorem pattern_all_tracked(k: Nat): PatternAll_tracked(k) {
  match k: PatternAll_tracked(k) {
    Zero => AndIntro(
      c => p => t => env => span => at => ordered => AndIntro(
        ordered,
        AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
      ),
      AndIntro(
        c => name => args => t => env => span => at => ordered => AndIntro(
          ordered,
          AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
        ),
        c => args => fields => borrowed => env => span => at => ordered => AndIntro(
          ordered,
          AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
        )
      )
    )
    Succ(j) => {
      let ih: PatternAll_tracked(j) := pattern_all_tracked(j)
      AndIntro(
        c => p => t => env => span => at => ordered => Eq::subst(
          (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
          Eq::sym(pattern_pattern_succ_unf(j, c, p, t, env, span, at)),
          pattern_step_frame_tracked(j, c, t, env, span, at, p, And::left(And::right(ih)), ordered)
        ),
        AndIntro(
          c => name => args => t => env => span => at => ordered => Eq::subst(
            (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
            Eq::sym(pattern_ctor_pattern_succ_unf(j, c, name, args, t, env, span, at)),
            pattern_ctor_step_frame_tracked(
              j,
              c,
              name,
              args,
              t,
              env,
              span,
              at,
              ty_borrow_mode(ck_resolve(c, t)),
              And::right(And::right(ih)),
              ordered
            )
          ),
          c => args => fields => borrowed => env => span => at => ordered => Eq::subst(
            (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
            Eq::sym(pattern_ctor_args_succ_unf(j, c, args, fields, borrowed, env, span, at)),
            pattern_args_step_frame_tracked(
              j,
              c,
              fields,
              borrowed,
              env,
              span,
              at,
              args,
              And::left(ih),
              And::right(And::right(ih)),
              ordered
            )
          )
        )
      )
    }
  }
}

pub theorem ck_pattern_scope_frame_tracked(
  k: Nat,
  c: Checker,
  p: SurfacePattern,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  ck_pattern_in(k, c, p, t, env, span, at)
) { And::left(pattern_all_tracked(k))(c, p, t, env, span, at, ordered) }

pub theorem ck_pattern_frame_tracked(
  c: Checker,
  p: SurfacePattern,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, ck_pattern(c, p, t, env, span, at)) {
  pattern_rewrap_frame_tracked(
    c,
    ck_pattern_in(ck_steps_of(c), c, p, t, env, span, at),
    ck_pattern_scope_frame_tracked(ck_steps_of(c), c, p, t, env, span, at, ordered)
  )
}
pub theorem handle_patterns_cons_frame_tracked(
  p: SurfacePattern,
  rest: List(SurfacePattern),
  c: Checker,
  inner: Scope,
  body: SurfaceTerm,
  tys: List(Ty),
  ih: ∀ next: Checker. ∀ more: List(
    Ty
  ). ∀ env: Scope. ∀ ordered: CkOrdered(
    next
  ). TrackedScopeFrame(next, ck_handle_patterns(rest, next, more, env, body)),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, handle_patterns_cons(p, rest, c, inner, body, tys)) {
  match tys: TrackedScopeFrame(c, handle_patterns_cons(p, rest, c, inner, body, tys)) {
    Nil => pattern_return_frame_tracked(c, inner, Star, ordered)
    Cons(t, more) => tracked_pattern_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker, inner1: Scope) => pattern_rewrap(
        ck_handle_patterns(rest, c1, more, inner1, body)
      ),
      ck_pattern(c, p, t, inner, span_of(body), handle_body_start(body)),
      ck_pattern_frame_tracked(c, p, t, inner, span_of(body), handle_body_start(body), ordered),
      ignored => c1 => inner1 => o_c1 => pattern_rewrap_frame_tracked(
        c1,
        ck_handle_patterns(rest, c1, more, inner1, body),
        ih(c1, more, inner1, o_c1)
      )
    )
  }
}

pub theorem ck_handle_patterns_frame_tracked(
  ps: List(SurfacePattern),
  c: Checker,
  tys: List(Ty),
  inner: Scope,
  body: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, ck_handle_patterns(ps, c, tys, inner, body)) {
  match ps: TrackedScopeFrame(c, ck_handle_patterns(ps, c, tys, inner, body)) {
    Nil => AndIntro(
      ordered,
      AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    )
    Cons(p, rest) => Eq::subst(
      (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
      Eq::sym(handle_patterns_unf(p, rest, c, tys, inner, body)),
      handle_patterns_cons_frame_tracked(
        p,
        rest,
        c,
        inner,
        body,
        tys,
        next => more => env => onext => ck_handle_patterns_frame_tracked(
          rest,
          next,
          more,
          env,
          body,
          onext
        ),
        ordered
      )
    )
  }
}

pub theorem handle_cont_frame_tracked(
  c: Checker,
  inner: Scope,
  quant: Quant,
  eff: Text,
  answer: Ty,
  result: Ty,
  body: SurfaceTerm,
  cont: Option(Text),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, handle_cont(c, inner, quant, eff, answer, result, body, cont)) {
  match cont: TrackedScopeFrame(c, handle_cont(c, inner, quant, eff, answer, result, body, cont)) {
    None => pattern_return_frame_tracked(c, inner, Star, ordered)
    Some(k) => pattern_bind_one_frame_tracked(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => pattern_rewrap(
        ck_bind_local(
          c1,
          inner,
          k,
          TyFn(Cons(answer, Nil), result, quant_continuation_kind(quant)),
          false,
          handle_body_start(body)
        )
      ),
      frame_error_if(
        c,
        cat5(eff, " does not resume (`resume 0`): its arm has no `", k, "`", ""),
        span_of(body),
        quant_is_zero(quant)
      ),
      tracked_run_read(
        c,
        frame_error_if(
          c,
          cat5(eff, " does not resume (`resume 0`): its arm has no `", k, "`", ""),
          span_of(body),
          quant_is_zero(quant)
        ),
        frame_error_if_ok(
          c,
          cat5(eff, " does not resume (`resume 0`): its arm has no `", k, "`", ""),
          span_of(body),
          quant_is_zero(quant)
        ),
        frame_error_if_ok_tracked(
          c,
          cat5(eff, " does not resume (`resume 0`): its arm has no `", k, "`", ""),
          span_of(body),
          quant_is_zero(quant)
        ),
        ordered
      ),
      ignored => c1 => o_c1 => pattern_rewrap_frame_tracked(
        c1,
        ck_bind_local(
          c1,
          inner,
          k,
          TyFn(Cons(answer, Nil), result, quant_continuation_kind(quant)),
          false,
          handle_body_start(body)
        ),
        ck_bind_local_scope_frame_tracked(
          c1,
          inner,
          k,
          TyFn(Cons(answer, Nil), result, quant_continuation_kind(quant)),
          false,
          handle_body_start(body),
          o_c1
        )
      )
    )
  }
}

pub theorem ck_handle_cont_frame_tracked(
  c: Checker,
  inner: Scope,
  quant: Quant,
  eff: Text,
  cont: Option(Text),
  answer: Ty,
  result: Ty,
  body: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, ck_handle_cont(c, inner, quant, eff, cont, answer, result, body)) {
  Eq::subst(
    (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
    Eq::sym(handle_cont_unf(c, inner, quant, eff, cont, answer, result, body)),
    handle_cont_frame_tracked(c, inner, quant, eff, answer, result, body, cont, ordered)
  )
}
pub theorem inference_use_ck_guard_in_tracked(
  k: Nat,
  c: Checker,
  guard: Option(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_guard_in(k, c, guard, env)
) { And::left(And::right(And::right(And::right(And::right(ih)))))(c, guard, env, ordered) }

pub theorem ck_attempt_unify_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_attempt_unify(c, a, b)) {
  tracked_run_grows(c, ck_attempt_unify(c, a, b), And::left(attempt_unify_sub(c, a, b)(ordered)))
}
pub theorem ck_set_subst_run_frame_tracked(
  c: Checker,
  v: Nat,
  t: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_set_subst(c, v, t)) {
  AndIntro(
    Ordmap::insert_ordered(
      Ordmap::compare_nat,
      Ordmap::compare_nat_law(),
      ck_subst_of(c),
      v,
      t,
      ordered
    ),
    AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  )
}
pub theorem widen_store_frame_tracked(
  c: Checker,
  rv: Nat,
  value: Ty,
  occurs: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_store(c, rv, value, occurs)) {
  match occurs: TrackedRunFrame(c, widen_store(c, rv, value, occurs)) {
    false => tracked_run_return(c, Star, ordered)
    true => tracked_run_rewrap(
      c,
      ck_set_subst(c, rv, value),
      ck_set_subst_run_frame_tracked(c, rv, value, ordered)
    )
  }
}

pub theorem widen_store_true_frame_tracked(
  c: Checker,
  rv: Nat,
  value: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_store_true(c, rv, value)) {
  tracked_run_bind(
    Unit,
    Bool,
    c,
    (ignored: Unit, c1: Checker) => mut1(true, c1),
    widen_store(c, rv, value, not(ck_occurs(c, rv, value))),
    widen_store_frame_tracked(c, rv, value, not(ck_occurs(c, rv, value)), ordered),
    ignored => c1 => o_c1 => tracked_run_return(c1, true, o_c1)
  )
}

pub theorem widen_attempt_frame_tracked(
  c: Checker,
  rv: Nat,
  wide: Ty,
  success: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_attempt(c, rv, wide, success)) {
  match success: TrackedRunFrame(c, widen_attempt(c, rv, wide, success)) {
    true => widen_store_true_frame_tracked(c, rv, ck_resolve(c, wide), ordered)
    false => tracked_run_return(c, false, ordered)
  }
}

pub theorem widen_fn_allowed_frame_tracked(
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  rv: Nat,
  allowed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_fn_allowed(c, pa, ra, ka, pb, rb, kb, rv, allowed)) {
  match allowed: TrackedRunFrame(c, widen_fn_allowed(c, pa, ra, ka, pb, rb, kb, rv, allowed)) {
    true => tracked_run_bind(
      Bool,
      Bool,
      c,
      (success: Bool, c1: Checker) => widen_attempt(c1, rv, TyFn(pb, rb, kind_join(ka, kb)), success),
      ck_attempt_unify(c, TyFn(pa, ra, kind_join(ka, kb)), TyFn(pb, rb, kind_join(ka, kb))),
      ck_attempt_unify_run_frame_tracked(
        c,
        TyFn(pa, ra, kind_join(ka, kb)),
        TyFn(pb, rb, kind_join(ka, kb)),
        ordered
      ),
      success => c1 => o_c1 => widen_attempt_frame_tracked(
        c1,
        rv,
        TyFn(pb, rb, kind_join(ka, kb)),
        success,
        o_c1
      )
    )
    false => tracked_run_return(c, false, ordered)
  }
}

pub theorem widen_fn_current_frame_tracked(
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  rv: Nat,
  current: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_fn_current(c, pa, ra, ka, rv, current)) {
  match current: TrackedRunFrame(c, widen_fn_current(c, pa, ra, ka, rv, current)) {
    TyInt(w) => tracked_run_return(c, false, ordered)
    TyBool => tracked_run_return(c, false, ordered)
    TyText => tracked_run_return(c, false, ordered)
    TyUnit => tracked_run_return(c, false, ordered)
    TyNever => tracked_run_return(c, false, ordered)
    TyDecimal => tracked_run_return(c, false, ordered)
    TyFloat => tracked_run_return(c, false, ordered)
    TyFn(pb, rb, kb) => widen_fn_allowed_frame_tracked(
      c,
      pa,
      ra,
      ka,
      pb,
      rb,
      kb,
      rv,
      Bool::and(Nat::eq(list_len(pa), list_len(pb)), not(kind_eq(ka, kb))),
      ordered
    )
    TyUnion(members) => tracked_run_return(c, false, ordered)
    TyProduct(members) => tracked_run_return(c, false, ordered)
    TyTagged(tags, inner) => tracked_run_return(c, false, ordered)
    TyNamed(name, args) => tracked_run_return(c, false, ordered)
    TyParam(name, bound) => tracked_run_return(c, false, ordered)
    TyInfo(inner) => tracked_run_return(c, false, ordered)
    TyBorrow(inner, mutable) => tracked_run_return(c, false, ordered)
    TyVar(v) => tracked_run_return(c, false, ordered)
    TyPoly(generics, inner) => tracked_run_return(c, false, ordered)
    TyApp(head, arg) => tracked_run_return(c, false, ordered)
  }
}

