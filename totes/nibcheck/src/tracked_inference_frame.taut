) {
  inference_handle_result_frame_tracked(
    j,
    c,
    handlers,
    env,
    result,
    first,
    budget_ty,
    ty_var_of(result),
    ih,
    ordered
  )
}

pub theorem inference_successor_ck_infer_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
