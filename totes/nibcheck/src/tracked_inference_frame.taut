  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_handle_one_in(k, c, h, env, result, rv, budget_ty)) {
  inference_use_ck_handle_one_in_tracked(
    k,
    c,
    h,
    env,
    result,
    rv,
    budget_ty,
    ordered,
    inference_frames_tracked(k)
  )
}

