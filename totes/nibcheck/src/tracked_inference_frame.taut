    SkFnKind(pat_kind, pat_ty) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkBorrowLam(pat_borrows, pat_lam) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkOther(pat_what) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkRow(pat_what_effects) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkFloat(pat_what) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkProduct(pat_what) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkProject(pat_what, pat_what_ty) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkMacroCall(pat_name, pat_arg) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkQuote(pat_stmts_form, pat_stmts) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkSplice(pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkSyntaxLit(pat_name, pat_body) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkStep(
      pat_tactic,
      pat_arg,
      pat_call_start,
      pat_call_end,
      pat_before,
      pat_arms
    ) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
  }
}

pub theorem inference_lambda_hint_frame_tracked(
  j: Nat,
  c: Checker,
  lam: SurfaceTerm,
  borrows: List(Option(Bool)),
  env: List(Local),
  hint: Option(Ty),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_lambda_hint(j, c, lam, borrows, env, hint)) {
  tracked_run_bind(
    Unit,
    Ty,
    c,
    (cleared: Unit, c1: Checker) => inference_lambda_kind(
      j,
      c1,
      lam,
      borrows,
      env,
      hint,
      inference_term_kind(lam)
    ),
    inference_set_hint(c, None),
    tracked_run_read(
      c,
      inference_set_hint(c, None),
      inference_set_hint_frame(c, None),
      inference_set_hint_frame_tracked(c, None),
      ordered
    ),
    cleared => c1 => o_c1 => inference_lambda_kind_frame_tracked(
      j,
      c1,
      lam,
      borrows,
      env,
      hint,
      inference_term_kind(lam),
      ih,
      o_c1
    )
  )
}

pub theorem inference_step_ck_lambda_in_frame_tracked(
  j: Nat,
  c: Checker,
  lam: SurfaceTerm,
  borrows: List(Option(Bool)),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_lambda_in(j, c, lam, borrows, env)
) { inference_lambda_hint_frame_tracked(j, c, lam, borrows, env, inference_hint(c), ih, ordered) }

pub theorem inference_successor_ck_lambda_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_lambda_in_tracked(
  Succ(j)
) {
  c => lam => borrows => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_lambda_in(j, c, lam, borrows, env)),
    inference_step_ck_lambda_in_frame_tracked(j, c, lam, borrows, env, ih, ordered)
  )
}
pub theorem inference_successor_ck_record_fields_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_record_fields_in_tracked(
