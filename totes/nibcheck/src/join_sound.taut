import "fits_sound.taut"
import std::Base
import "checker.taut"
import "rules_ty.taut"
import "ty.taut"
import "ty_eq.taut"
import "unify.taut"
import "unify_sound.taut"

// `ck_join` is sound (`docs/design/self-host.md`
// 「層 2：`ck_join`（`src/join_sound.taut`）」): the type it gives two
// branches is one each of them fits (`TySub`) at the state it leaves.

// ----- the steps of `ck_join`, as the `&mut` desugaring writes them -----

pub fn ck_join_my(c: Checker, a0: Ty, b0: Ty, y: Bool): Mut1(Bool, Checker) {
  match y: Mut1(Bool, Checker) {
    true => ck_rewrap1(ck_attempt_unify(c, a0, b0))
    false => mut1(false, c)
  }
}

pub fn ck_join_e2(a: Ty, b: Ty, m: Mut1(Option(Ty), Checker)): Mut1(Ty, Checker) {
  match m: Mut1(Ty, Checker) {
    mut1(o, c2) => match o: Mut1(Ty, Checker) {
      Some(t) => mut1(t, c2)
      None => mut1(ty_union(Cons(a, Cons(b, Nil))), c2)
    }
  }
}

pub fn ck_join_e1z(c: Checker, a: Ty, b: Ty, z: Bool): Mut1(Ty, Checker) {
  match z: Mut1(Ty, Checker) {
    true => mut1(b, c)
    false => ck_join_e2(a, b, ck_join_borrowed(c, a, b))
  }
}

pub fn ck_join_e1y(c: Checker, a: Ty, b: Ty, y: Bool): Mut1(Ty, Checker) {
  match y: Mut1(Ty, Checker) {
    true => mut1(a, c)
    false => ck_join_e1z(c, a, b, ty_is_never(a))
  }
}

pub fn ck_join_e(c: Checker, a0: Ty, b0: Ty): Mut1(Ty, Checker) {
  ck_join_e1y(
    c,
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0),
    Bool::or(
      ty_eq(
        ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
        ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0)
      ),
      ty_is_never(ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0))
    )
  )
}

pub fn ck_join_k(a0: Ty, b0: Ty, m: Mut1(Bool, Checker)): Mut1(Ty, Checker) {
  match m: Mut1(Ty, Checker) {
    mut1(v, c2) => match v: Mut1(Ty, Checker) {
      true => mut1(ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), a0), c2)
      false => ck_join_e(c2, a0, b0)
    }
  }
}

pub theorem join_unf(
  c: Checker,
  a0: Ty,
  b0: Ty
): ck_join(c, a0, b0) = ck_join_k(a0, b0, ck_join_my(c, a0, b0, Bool::or(ck_has_vars(c, a0), ck_has_vars(c, b0)))) {
  Refl
}

pub fn ck_jb_k(x: Ty, m: Mut1(Bool, Checker)): Mut1(Option(Ty), Checker) {
  match m: Mut1(Option(Ty), Checker) {
    mut1(v, c2) => match v: Mut1(Option(Ty), Checker) {
      true => mut1(Some(ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), x)), c2)
      false => mut1(None, c2)
    }
  }
}

pub fn ck_jb2y(c: Checker, a: Ty, x: Ty, y: Bool): Mut1(Option(Ty), Checker) {
  match y: Mut1(Option(Ty), Checker) {
    true => ck_jb_k(x, ck_attempt_unify(c, x, a))
    false => mut1(None, c)
  }
}

pub fn ck_jb2(c: Checker, a: Ty, b: Ty): Mut1(Option(Ty), Checker) {
  match b: Mut1(Option(Ty), Checker) {
    TyBorrow(x, m) => ck_jb2y(c, a, x, Bool::and(not(ty_is_borrow(a)), kind_dup(ck_kind(c, x))))
    _ => mut1(None, c)
  }
}

pub theorem jb2_unf(
  c: Checker,
  a: Ty,
  b: Ty
): ck_join_borrowed_second(c, a, b) = ck_jb2(c, a, b) {
  Refl
}

pub fn ck_jb1y(c: Checker, x: Ty, m: Bool, b: Ty, y: Bool): Mut1(Option(Ty), Checker) {
  match y: Mut1(Option(Ty), Checker) {
    true => ck_jb_k(x, ck_attempt_unify(c, x, b))
    false => ck_rewrap1(ck_join_borrowed_second(c, TyBorrow(x, m), b))
  }
}

pub theorem jb1_borrow(
  c: Checker,
  x: Ty,
  m: Bool,
  b: Ty
): ck_join_borrowed(c, TyBorrow(x, m), b) = ck_jb1y(c, x, m, b, Bool::and(not(ty_is_borrow(b)), kind_dup(ck_kind(c, x)))) {
  Refl
}

pub def JoinOk(
  c: Checker,
  m: Mut1(Ty, Checker),
  a0: Ty,
  b0: Ty
): Prop := (
  CkOrdered(c)
) -> And(Grows(c, ck_st(m)), And(SubAt(ck_st(m), a0, ck_val(m)), SubAt(ck_st(m), b0, ck_val(m))))

// The type found for two, if any, and that both fit it.
pub def OptOk(
  c: Checker,
  m: Mut1(Option(Ty), Checker),
  a: Ty,
  b: Ty
): Prop := (
  CkOrdered(c)
) -> And(
  Grows(c, ck_st(m)),
  ∀ t: Ty. (ck_val(m) = Some(t)) -> And(SubAt(ck_st(m), a, t), SubAt(ck_st(m), b, t))
)

// The same, with both the same type as it.
pub def OptEq(
  c: Checker,
  m: Mut1(Option(Ty), Checker),
  a: Ty,
  b: Ty
): Prop := (
  CkOrdered(c)
) -> And(
  Grows(c, ck_st(m)),
  ∀ t: Ty. (
    ck_val(m) = Some(t)
  ) -> And(TyEqAt(ck_st(m), a, t), TyEqAt(ck_st(m), b, t))
)

pub fn jn_is_some(o: Option(Ty)): Bool {
  match o: Bool {
    Some(t) => true
    None => false
  }
}

pub theorem jn_none_ne_some(t: Ty, e: None = Some(t)): False {
  false_ne_true(Eq::subst((z: Option(Ty)) => false = jn_is_some(z), e, Refl))
}

pub theorem jn_or_true(
  x: Bool,
  y: Bool,
  p: Prop,
  e: Bool::or(x, y) = true,
  f1: (x = true) -> p,
  f2: (y = true) -> p
): p {
  match x: (Bool::or(x, y) = true) -> ((x = true) -> p) -> p {
    true => (e2: true = true) => (g: (true = true) -> p) => g(Refl)
    false => (e2: y = true) => (g: (false = true) -> p) => f2(e2)
  }(e, f1)
}

pub theorem attempt_unify_eq(
  c: Checker,
  a: Ty,
  b: Ty
): Post(c, ck_attempt_unify(c, a, b), (c2: Checker) => TyEqAt(c2, a, b)) {
  post_unf(
    c,
    ck_attempt_unify(c, a, b),
    ck_attempt_k(c, ck_unify(c, a, b)),
    (c2: Checker) => TyEqAt(c2, a, b),
    Refl,
    post_attempt(c, ck_unify(c, a, b), (c2: Checker) => TyEqAt(c2, a, b), ck_unify_ok(c, a, b))
  )
}

pub theorem join_my_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  y: Bool
): Post(c, ck_join_my(c, a0, b0, y), (c2: Checker) => TyEqAt(c2, a0, b0)) {
  match y: Post(c, ck_join_my(c, a0, b0, y), (c2: Checker) => TyEqAt(c2, a0, b0)) {
    true => post_map(
      c,
      ck_attempt_unify(c, a0, b0),
      (c2: Checker) => TyEqAt(c2, a0, b0),
      (c2: Checker) => TyEqAt(c2, a0, b0),
      (c2: Checker, h: TyEqAt(c2, a0, b0)) => h,
      attempt_unify_eq(c, a0, b0)
    )
    false => post_false(c, (c2: Checker) => TyEqAt(c2, a0, b0))
  }
}

pub theorem join_after(
  c: Checker,
  c2: Checker,
  m: Mut1(Ty, Checker),
  a0: Ty,
  b0: Ty,
  g: (CkOrdered(c)) -> Grows(c, c2),
  h: JoinOk(c2, m, a0, b0)
): JoinOk(c, m, a0, b0) {
  (o: CkOrdered(c)) => AndIntro(
    grows_trans(c, c2, ck_st(m), g(o), And::left(h(And::left(g(o))))),
    And::right(h(And::left(g(o))))
  )
}

pub theorem jn_never_sub(
  c: Checker,
  x0: Ty,
  x: Ty,
  d: Ty,
  hx: TyEqAt(c, x0, x),
  e: ty_is_never(x) = true
): SubAt(c, x0, d) {
  sub_trans_at(
    c,
    x0,
    x,
    d,
    sub_of_eq(c, x0, x, hx),
    Eq::subst((z: Ty) => SubAt(c, z, d), Eq::sym(ck_never_of(x, e)), sub_never_at(c, d))
  )
}

pub theorem opt_none(c: Checker, a: Ty, b: Ty): OptOk(c, mut1(None, c), a, b) {
  (o: CkOrdered(c)) => AndIntro(
    grows_refl(c, o),
    (t: Ty, e: None = Some(t)) => False::elim(jn_none_ne_some(t, e))
  )
}

pub theorem jbk_ok(
  c: Checker,
  x: Ty,
  y: Ty,
  m: Mut1(Bool, Checker),
  h: Post(c, m, (c2: Checker) => TyEqAt(c2, x, y))
): OptEq(c, ck_jb_k(x, m), x, y) {
  match m: (Post(c, m, (c2: Checker) => TyEqAt(c2, x, y))) -> OptEq(c, ck_jb_k(x, m), x, y) {
    mut1(v, c2) => match v: (
      Post(c, mut1(v, c2), (c3: Checker) => TyEqAt(c3, x, y))
    ) -> OptEq(c, ck_jb_k(x, mut1(v, c2)), x, y) {
      true => (h1: Post(c, mut1(true, c2), (c3: Checker) => TyEqAt(c3, x, y))) => (
        o: CkOrdered(c)
      ) => AndIntro(
        And::left(h1(o)),
        (
          t: Ty,
          e: Some(ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), x)) = Some(t)
        ) => Eq::subst(
          (z: Ty) => And(TyEqAt(c2, x, z), TyEqAt(c2, y, z)),
          ck_some_inj(ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), x), t, e),
          AndIntro(
            ty_resolve_eq(ck_steps_of(c2), ck_subst_of(c2), KeptOk(ck_kept_of(c2)), x),
            TyeqTrans(
              TyeqSym(And::right(h1(o))(Refl)),
              ty_resolve_eq(ck_steps_of(c2), ck_subst_of(c2), KeptOk(ck_kept_of(c2)), x)
            )
          )
        )
      )
      false => (h1: Post(c, mut1(false, c2), (c3: Checker) => TyEqAt(c3, x, y))) => (
        o: CkOrdered(c)
      ) => AndIntro(
        And::left(h1(o)),
        (t: Ty, e: None = Some(t)) => False::elim(jn_none_ne_some(t, e))
      )
    }
  }(h)
}

// From the same type to fitting it: a borrow fits what its value is.
pub theorem opt_of_eq(
  c: Checker,
  m: Mut1(Option(Ty), Checker),
  x: Ty,
  y: Ty,
  a: Ty,
  b: Ty,
  fa: ∀ c2: Checker. ∀ t: Ty. (TyEqAt(c2, x, t)) -> (TyEqAt(c2, y, t)) -> SubAt(c2, a, t),
  fb: ∀ c2: Checker. ∀ t: Ty. (TyEqAt(c2, x, t)) -> (TyEqAt(c2, y, t)) -> SubAt(c2, b, t),
  h: OptEq(c, m, x, y)
): OptOk(c, m, a, b) {
  (o: CkOrdered(c)) => AndIntro(
    And::left(h(o)),
    (t: Ty, e: ck_val(m) = Some(t)) => AndIntro(
      fa(ck_st(m), t, And::left(And::right(h(o))(t, e)), And::right(And::right(h(o))(t, e))),
      fb(ck_st(m), t, And::left(And::right(h(o))(t, e)), And::right(And::right(h(o))(t, e)))
    )
  )
}

pub theorem jb2y_ok(
  c: Checker,
  a: Ty,
  x: Ty,
  mm: Bool,
  y: Bool
): OptOk(c, ck_jb2y(c, a, x, y), a, TyBorrow(x, mm)) {
  match y: OptOk(c, ck_jb2y(c, a, x, y), a, TyBorrow(x, mm)) {
    true => opt_of_eq(
      c,
      ck_jb_k(x, ck_attempt_unify(c, x, a)),
      x,
      a,
      a,
      TyBorrow(x, mm),
      (c2: Checker, t: Ty, hx: TyEqAt(c2, x, t), hy: TyEqAt(c2, a, t)) => sub_of_eq(c2, a, t, hy),
      (c2: Checker, t: Ty, hx: TyEqAt(c2, x, t), hy: TyEqAt(c2, a, t)) => sub_unborrow_at(
        c2,
        x,
        t,
        mm,
        sub_of_eq(c2, x, t, hx)
      ),
      jbk_ok(c, x, a, ck_attempt_unify(c, x, a), attempt_unify_eq(c, x, a))
    )
    false => opt_none(c, a, TyBorrow(x, mm))
  }
}

pub theorem jb2_cases(
  c: Checker,
  a: Ty,
  b1: Ty,
  b: Ty,
  eb: b1 = b
): OptOk(c, ck_jb2(c, a, b), a, b1) {
  match b: OptOk(c, ck_jb2(c, a, b), a, b1) {
    TyBorrow(x, mm) => Eq::subst(
      (z: Ty) => OptOk(c, ck_jb2(c, a, TyBorrow(x, mm)), a, z),
      Eq::sym(eb),
      jb2y_ok(c, a, x, mm, Bool::and(not(ty_is_borrow(a)), kind_dup(ck_kind(c, x))))
    )
    _ => opt_none(c, a, b1)
  }
}

pub theorem second_ok(c: Checker, a: Ty, b: Ty): OptOk(c, ck_join_borrowed_second(c, a, b), a, b) {
  Eq::subst(
    (z: Mut1(Option(Ty), Checker)) => OptOk(c, z, a, b),
    Eq::sym(jb2_unf(c, a, b)),
    jb2_cases(c, a, b, b, Refl)
  )
}

pub theorem opt_rewrap(
  c: Checker,
  m: Mut1(Option(Ty), Checker),
  a: Ty,
  b: Ty,
  h: OptOk(c, m, a, b)
): OptOk(c, ck_rewrap1(m), a, b) {
  Eq::subst((z: Mut1(Option(Ty), Checker)) => OptOk(c, z, a, b), Eq::sym(ck_rewrap1_id(m)), h)
}

pub theorem jb1y_ok(
  c: Checker,
  x: Ty,
  mm: Bool,
  b: Ty,
  y: Bool
): OptOk(c, ck_jb1y(c, x, mm, b, y), TyBorrow(x, mm), b) {
  match y: OptOk(c, ck_jb1y(c, x, mm, b, y), TyBorrow(x, mm), b) {
    true => opt_of_eq(
      c,
      ck_jb_k(x, ck_attempt_unify(c, x, b)),
      x,
      b,
      TyBorrow(x, mm),
      b,
      (c2: Checker, t: Ty, hx: TyEqAt(c2, x, t), hy: TyEqAt(c2, b, t)) => sub_unborrow_at(
        c2,
        x,
        t,
        mm,
        sub_of_eq(c2, x, t, hx)
      ),
      (c2: Checker, t: Ty, hx: TyEqAt(c2, x, t), hy: TyEqAt(c2, b, t)) => sub_of_eq(c2, b, t, hy),
      jbk_ok(c, x, b, ck_attempt_unify(c, x, b), attempt_unify_eq(c, x, b))
    )
    false => opt_rewrap(
      c,
      ck_join_borrowed_second(c, TyBorrow(x, mm), b),
      TyBorrow(x, mm),
      b,
      second_ok(c, TyBorrow(x, mm), b)
    )
  }
}

// A step at a type a wildcard arm cannot name: `x` is found from `ex`.
pub theorem opt_cases<x: Ty>(
  c: Checker,
  f: (Ty) -> Mut1(Option(Ty), Checker),
  g: (Ty) -> Mut1(Option(Ty), Checker),
  a1: Ty,
  b: Ty,
  ex: a1 = x,
  e: f(x) = g(x),
  h: OptOk(c, g(a1), a1, b)
): OptOk(c, f(x), a1, b) {
  Eq::subst(
    (z: Mut1(Option(Ty), Checker)) => OptOk(c, z, a1, b),
    Eq::sym(e),
    Eq::subst((w: Ty) => OptOk(c, g(w), a1, b), ex, h)
  )
}

pub theorem jb1_cases(
  c: Checker,
  a1: Ty,
  a: Ty,
  b: Ty,
  ea: a1 = a
): OptOk(c, ck_join_borrowed(c, a, b), a1, b) {
  match a: OptOk(c, ck_join_borrowed(c, a, b), a1, b) {
    TyBorrow(x, mm) => Eq::subst(
      (z: Ty) => OptOk(c, ck_join_borrowed(c, TyBorrow(x, mm), b), z, b),
      Eq::sym(ea),
      Eq::subst(
        (z: Mut1(Option(Ty), Checker)) => OptOk(c, z, TyBorrow(x, mm), b),
        Eq::sym(jb1_borrow(c, x, mm, b)),
        jb1y_ok(c, x, mm, b, Bool::and(not(ty_is_borrow(b)), kind_dup(ck_kind(c, x))))
      )
    )
    _ => opt_cases(
      c,
      (z: Ty) => ck_join_borrowed(c, z, b),
      (z: Ty) => ck_rewrap1(ck_join_borrowed_second(c, z, b)),
      a1,
      b,
      ea,
      Refl,
      opt_rewrap(c, ck_join_borrowed_second(c, a1, b), a1, b, second_ok(c, a1, b))
    )
  }
}

pub theorem borrowed_ok(c: Checker, a: Ty, b: Ty): OptOk(c, ck_join_borrowed(c, a, b), a, b) {
  jb1_cases(c, a, a, b, Refl)
}

pub theorem join_e2_some(
  c: Checker,
  c2: Checker,
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  t: Ty,
  g: Grows(c, c2),
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  h: And(SubAt(c2, a, t), SubAt(c2, b, t))
): And(SubAt(c2, a0, t), SubAt(c2, b0, t)) {
  AndIntro(
    sub_trans_at(
      c2,
      a0,
      a,
      t,
      sub_of_eq(c2, a0, a, tyeq_at_move(c, c2, g, a0, a, ha)),
      And::left(h)
    ),
    sub_trans_at(
      c2,
      b0,
      b,
      t,
      sub_of_eq(c2, b0, b, tyeq_at_move(c, c2, g, b0, b, hb)),
      And::right(h)
    )
  )
}

pub theorem join_union(
  c: Checker,
  x0: Ty,
  x: Ty,
  u: Ty,
  ys: List(Ty),
  hx: TyEqAt(c, x0, x),
  hy: SubAnyAt(c, x, ys),
  e: TyEqAt(c, TyUnion(ys), u)
): SubAt(c, x0, u) {
  sub_trans_at(
    c,
    x0,
    x,
    u,
    sub_of_eq(c, x0, x, hx),
    sub_trans_at(
      c,
      x,
      TyUnion(ys),
      u,
      sub_union_r_at(c, x, ys, hy),
      sub_of_eq(c, TyUnion(ys), u, e)
    )
  )
}

pub theorem join_e2_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  m: Mut1(Option(Ty), Checker),
  h: OptOk(c, m, a, b)
): JoinOk(c, ck_join_e2(a, b, m), a0, b0) {
  match m: (OptOk(c, m, a, b)) -> JoinOk(c, ck_join_e2(a, b, m), a0, b0) {
    mut1(o2, c2) => match o2: (
      OptOk(c, mut1(o2, c2), a, b)
    ) -> JoinOk(c, ck_join_e2(a, b, mut1(o2, c2)), a0, b0) {
      Some(t) => (h1: OptOk(c, mut1(Some(t), c2), a, b)) => (o: CkOrdered(c)) => AndIntro(
        And::left(h1(o)),
        join_e2_some(c, c2, a0, b0, a, b, t, And::left(h1(o)), ha, hb, And::right(h1(o))(t, Refl))
      )
      None => (h1: OptOk(c, mut1(None, c2), a, b)) => (o: CkOrdered(c)) => AndIntro(
        And::left(h1(o)),
        AndIntro(
          join_union(
            c2,
            a0,
            a,
            ty_union(Cons(a, Cons(b, Nil))),
            Cons(a, Cons(b, Nil)),
            tyeq_at_move(c, c2, And::left(h1(o)), a0, a, ha),
            TysubAnyHere(Cons(b, Nil), sub_of_eq(c2, a, a, TyeqRefl(a))),
            TyeqUnionNorm(Cons(a, Cons(b, Nil)))
          ),
          join_union(
            c2,
            b0,
            b,
            ty_union(Cons(a, Cons(b, Nil))),
            Cons(a, Cons(b, Nil)),
            tyeq_at_move(c, c2, And::left(h1(o)), b0, b, hb),
            TysubAnyThere(a, TysubAnyHere(Nil, sub_of_eq(c2, b, b, TyeqRefl(b)))),
            TyeqUnionNorm(Cons(a, Cons(b, Nil)))
          )
        )
      )
    }
  }(h)
}

pub theorem join_e1z_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  z: Bool,
  ez: ty_is_never(a) = z
): JoinOk(c, ck_join_e1z(c, a, b, z), a0, b0) {
  match z: (ty_is_never(a) = z) -> JoinOk(c, ck_join_e1z(c, a, b, z), a0, b0) {
    true => (e: ty_is_never(a) = true) => (o: CkOrdered(c)) => AndIntro(
      grows_refl(c, o),
      AndIntro(jn_never_sub(c, a0, a, b, ha, e), sub_of_eq(c, b0, b, hb))
    )
    false => (e: ty_is_never(a) = false) => join_e2_ok(
      c,
      a0,
      b0,
      a,
      b,
      ha,
      hb,
      ck_join_borrowed(c, a, b),
      borrowed_ok(c, a, b)
    )
  }(ez)
}

pub theorem join_e1y_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  y: Bool,
  ey: Bool::or(ty_eq(a, b), ty_is_never(b)) = y
): JoinOk(c, ck_join_e1y(c, a, b, y), a0, b0) {
  match y: (
    Bool::or(ty_eq(a, b), ty_is_never(b)) = y
  ) -> JoinOk(c, ck_join_e1y(c, a, b, y), a0, b0) {
    true => (e: Bool::or(ty_eq(a, b), ty_is_never(b)) = true) => (o: CkOrdered(c)) => AndIntro(
      grows_refl(c, o),
      AndIntro(
        sub_of_eq(c, a0, a, ha),
        jn_or_true(
          ty_eq(a, b),
          ty_is_never(b),
          SubAt(c, b0, a),
          e,
          (q: ty_eq(a, b) = true) => sub_of_eq(
            c,
            b0,
            a,
            Eq::subst((w: Ty) => TyEqAt(c, b0, w), Eq::sym(ty_eq_sound(a, b, q)), hb)
          ),
          (q: ty_is_never(b) = true) => jn_never_sub(c, b0, b, a, hb, q)
        )
      )
    )
    false => (e: Bool::or(ty_eq(a, b), ty_is_never(b)) = false) => join_e1z_ok(
      c,
      a0,
      b0,
      a,
      b,
      ha,
      hb,
      ty_is_never(a),
      Refl
    )
  }(ey)
}

pub theorem join_e_ok(c: Checker, a0: Ty, b0: Ty): JoinOk(c, ck_join_e(c, a0, b0), a0, b0) {
  join_e1y_ok(
    c,
    a0,
    b0,
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0),
    ty_resolve_eq(ck_steps_of(c), ck_subst_of(c), KeptOk(ck_kept_of(c)), a0),
    ty_resolve_eq(ck_steps_of(c), ck_subst_of(c), KeptOk(ck_kept_of(c)), b0),
    Bool::or(
      ty_eq(
        ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
        ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0)
      ),
      ty_is_never(ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0))
    ),
    Refl
  )
}

pub theorem join_k_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  m: Mut1(Bool, Checker),
  h: Post(c, m, (c2: Checker) => TyEqAt(c2, a0, b0))
): JoinOk(c, ck_join_k(a0, b0, m), a0, b0) {
  match m: (
    Post(c, m, (c2: Checker) => TyEqAt(c2, a0, b0))
  ) -> JoinOk(c, ck_join_k(a0, b0, m), a0, b0) {
    mut1(v, c2) => match v: (
      Post(c, mut1(v, c2), (c3: Checker) => TyEqAt(c3, a0, b0))
    ) -> JoinOk(c, ck_join_k(a0, b0, mut1(v, c2)), a0, b0) {
      true => (h1: Post(c, mut1(true, c2), (c3: Checker) => TyEqAt(c3, a0, b0))) => (
        o: CkOrdered(c)
      ) => AndIntro(
        And::left(h1(o)),
        AndIntro(
          sub_of_eq(
            c2,
            a0,
            ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), a0),
            ty_resolve_eq(ck_steps_of(c2), ck_subst_of(c2), KeptOk(ck_kept_of(c2)), a0)
          ),
          sub_of_eq(
            c2,
            b0,
            ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), a0),
            TyeqTrans(
              TyeqSym(And::right(h1(o))(Refl)),
              ty_resolve_eq(ck_steps_of(c2), ck_subst_of(c2), KeptOk(ck_kept_of(c2)), a0)
            )
          )
        )
      )
      false => (h1: Post(c, mut1(false, c2), (c3: Checker) => TyEqAt(c3, a0, b0))) => join_after(
        c,
        c2,
        ck_join_e(c2, a0, b0),
        a0,
        b0,
        (o: CkOrdered(c)) => And::left(h1(o)),
        join_e_ok(c2, a0, b0)
      )
    }
  }(h)
}

pub theorem ck_join_ok(c: Checker, a0: Ty, b0: Ty): JoinOk(c, ck_join(c, a0, b0), a0, b0) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => JoinOk(c, z, a0, b0),
    Eq::sym(join_unf(c, a0, b0)),
    join_k_ok(
      c,
      a0,
      b0,
      ck_join_my(c, a0, b0, Bool::or(ck_has_vars(c, a0), ck_has_vars(c, b0))),
      join_my_ok(c, a0, b0, Bool::or(ck_has_vars(c, a0), ck_has_vars(c, b0)))
    )
  )
}
