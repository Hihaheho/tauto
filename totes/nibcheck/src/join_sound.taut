import "fits_sound.taut"

// `ck_join` is sound (`docs/design/self-host.md`
// 「層 2：`ck_join`（`src/join_sound.taut`）」): the type it gives two
// branches is one each of them fits (`TySub`) at the state it leaves.

// ----- the steps of `ck_join`, as the `&mut` desugaring writes them -----

fn ck_join_my(c: Checker, a0: Ty, b0: Ty, y: Yn) -> Mut1(Yn, Checker) {
  match y -> Mut1(Yn, Checker) {
    yes => ck_rewrap1(ck_attempt_unify(c, a0, b0))
    no => mut1(no, c)
  }
}

fn ck_join_e2(a: Ty, b: Ty, m: Mut1(Option(Ty), Checker)) -> Mut1(Ty, Checker) {
  match m -> Mut1(Ty, Checker) {
    mut1(o, c2) => match o -> Mut1(Ty, Checker) {
      Some(t) => mut1(t, c2)
      None => mut1(ty_union(Cons(a, Cons(b, Nil))), c2)
    }
  }
}

fn ck_join_e1z(c: Checker, a: Ty, b: Ty, z: Yn) -> Mut1(Ty, Checker) {
  match z -> Mut1(Ty, Checker) {
    yes => mut1(b, c)
    no => ck_join_e2(a, b, ck_join_borrowed(c, a, b))
  }
}

fn ck_join_e1y(c: Checker, a: Ty, b: Ty, y: Yn) -> Mut1(Ty, Checker) {
  match y -> Mut1(Ty, Checker) {
    yes => mut1(a, c)
    no => ck_join_e1z(c, a, b, ty_is_never(a))
  }
}

fn ck_join_e(c: Checker, a0: Ty, b0: Ty) -> Mut1(Ty, Checker) {
  ck_join_e1y(
    c,
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0),
    yn_or(
      ty_eq(
        ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
        ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0)
      ),
      ty_is_never(ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0))
    )
  )
}

fn ck_join_k(a0: Ty, b0: Ty, m: Mut1(Yn, Checker)) -> Mut1(Ty, Checker) {
  match m -> Mut1(Ty, Checker) {
    mut1(v, c2) => match v -> Mut1(Ty, Checker) {
      yes => mut1(ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), a0), c2)
      no => ck_join_e(c2, a0, b0)
    }
  }
}

theorem join_unf(
  c: Checker,
  a0: Ty,
  b0: Ty
): Eq(
  Mut1(Ty, Checker),
  ck_join(c, a0, b0),
  ck_join_k(a0, b0, ck_join_my(c, a0, b0, yn_or(ck_has_vars(c, a0), ck_has_vars(c, b0))))
) {
  refl()
}

fn ck_jb_k(x: Ty, m: Mut1(Yn, Checker)) -> Mut1(Option(Ty), Checker) {
  match m -> Mut1(Option(Ty), Checker) {
    mut1(v, c2) => match v -> Mut1(Option(Ty), Checker) {
      yes => mut1(Some(ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), x)), c2)
      no => mut1(None(), c2)
    }
  }
}

fn ck_jb2y(c: Checker, a: Ty, x: Ty, y: Yn) -> Mut1(Option(Ty), Checker) {
  match y -> Mut1(Option(Ty), Checker) {
    yes => ck_jb_k(x, ck_attempt_unify(c, x, a))
    no => mut1(None(), c)
  }
}

fn ck_jb2(c: Checker, a: Ty, b: Ty) -> Mut1(Option(Ty), Checker) {
  match b -> Mut1(Option(Ty), Checker) {
    TyBorrow(x, m) => ck_jb2y(c, a, x, yn_and(yn_not(ty_is_borrow(a)), kind_dup(ck_kind(c, x))))
    _ => mut1(None(), c)
  }
}

theorem jb2_unf(
  c: Checker,
  a: Ty,
  b: Ty
): Eq(Mut1(Option(Ty), Checker), ck_join_borrowed_second(c, a, b), ck_jb2(c, a, b)) {
  refl()
}

fn ck_jb1y(c: Checker, x: Ty, m: Yn, b: Ty, y: Yn) -> Mut1(Option(Ty), Checker) {
  match y -> Mut1(Option(Ty), Checker) {
    yes => ck_jb_k(x, ck_attempt_unify(c, x, b))
    no => ck_rewrap1(ck_join_borrowed_second(c, TyBorrow(x, m), b))
  }
}

theorem jb1_borrow(
  c: Checker,
  x: Ty,
  m: Yn,
  b: Ty
): Eq(
  Mut1(Option(Ty), Checker),
  ck_join_borrowed(c, TyBorrow(x, m), b),
  ck_jb1y(c, x, m, b, yn_and(yn_not(ty_is_borrow(b)), kind_dup(ck_kind(c, x))))
) {
  refl()
}

// ----- what each step gives -----

def JoinOk(
  c: Checker,
  m: Mut1(Ty, Checker),
  a0: Ty,
  b0: Ty
): Prop := (
  CkOrdered(c)
) -> And(Grows(c, ck_st(m)), And(SubAt(ck_st(m), a0, ck_val(m)), SubAt(ck_st(m), b0, ck_val(m))))

// The type found for two, if any, and that both fit it.
def OptOk(
  c: Checker,
  m: Mut1(Option(Ty), Checker),
  a: Ty,
  b: Ty
): Prop := (
  CkOrdered(c)
) -> And(
  Grows(c, ck_st(m)),
  ∀ t: Ty. (Eq(Option(Ty), ck_val(m), Some(t))) -> And(SubAt(ck_st(m), a, t), SubAt(ck_st(m), b, t))
)

// The same, with both the same type as it.
def OptEq(
  c: Checker,
  m: Mut1(Option(Ty), Checker),
  a: Ty,
  b: Ty
): Prop := (
  CkOrdered(c)
) -> And(
  Grows(c, ck_st(m)),
  ∀ t: Ty. (
    Eq(Option(Ty), ck_val(m), Some(t))
  ) -> And(TyEqAt(ck_st(m), a, t), TyEqAt(ck_st(m), b, t))
)

fn jn_is_some(o: Option(Ty)) -> Yn {
  match o -> Yn {
    Some(t) => yes
    None => no
  }
}

theorem jn_none_ne_some(t: Ty, e: Eq(Option(Ty), None(), Some(t))): False {
  no_ne_yes(Eq_subst((z: Option(Ty)) => Eq(Yn, no, jn_is_some(z)), e, refl()))
}

theorem jn_or_yes(
  x: Yn,
  y: Yn,
  p: Prop,
  e: Eq(Yn, yn_or(x, y), yes),
  f1: (Eq(Yn, x, yes)) -> p,
  f2: (Eq(Yn, y, yes)) -> p
): p {
  match x -> (Eq(Yn, yn_or(x, y), yes)) -> ((Eq(Yn, x, yes)) -> p) -> p {
    yes => (e2: Eq(Yn, yes, yes)) => (g: (Eq(Yn, yes, yes)) -> p) => g(refl())
    no => (e2: Eq(Yn, y, yes)) => (g: (Eq(Yn, no, yes)) -> p) => f2(e2)
  }(e, f1)
}

theorem attempt_unify_eq(
  c: Checker,
  a: Ty,
  b: Ty
): Post(c, ck_attempt_unify(c, a, b), (c2: Checker) => TyEqAt(c2, a, b)) {
  post_unf(
    c,
    ck_attempt_unify(c, a, b),
    ck_attempt_k(c, ck_unify(c, a, b)),
    (c2: Checker) => TyEqAt(c2, a, b),
    refl(),
    post_attempt(c, ck_unify(c, a, b), (c2: Checker) => TyEqAt(c2, a, b), ck_unify_ok(c, a, b))
  )
}

theorem join_my_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  y: Yn
): Post(c, ck_join_my(c, a0, b0, y), (c2: Checker) => TyEqAt(c2, a0, b0)) {
  match y -> Post(c, ck_join_my(c, a0, b0, y), (c2: Checker) => TyEqAt(c2, a0, b0)) {
    yes => post_map(
      c,
      ck_attempt_unify(c, a0, b0),
      (c2: Checker) => TyEqAt(c2, a0, b0),
      (c2: Checker) => TyEqAt(c2, a0, b0),
      (c2: Checker, h: TyEqAt(c2, a0, b0)) => h,
      attempt_unify_eq(c, a0, b0)
    )
    no => post_no(c, (c2: Checker) => TyEqAt(c2, a0, b0))
  }
}

theorem join_after(
  c: Checker,
  c2: Checker,
  m: Mut1(Ty, Checker),
  a0: Ty,
  b0: Ty,
  g: (CkOrdered(c)) -> Grows(c, c2),
  h: JoinOk(c2, m, a0, b0)
): JoinOk(c, m, a0, b0) {
  (
    o: CkOrdered(c)
  ) => and_intro(
    grows_trans(c, c2, ck_st(m), g(o), and_left(h(and_left(g(o))))),
    and_right(h(and_left(g(o))))
  )
}

theorem jn_never_sub(
  c: Checker,
  x0: Ty,
  x: Ty,
  d: Ty,
  hx: TyEqAt(c, x0, x),
  e: Eq(Yn, ty_is_never(x), yes)
): SubAt(c, x0, d) {
  sub_trans_at(
    c,
    x0,
    x,
    d,
    sub_of_eq(c, x0, x, hx),
    Eq_subst((z: Ty) => SubAt(c, z, d), Eq_sym(ck_never_of(x, e)), sub_never_at(c, d))
  )
}

// ----- the type found for a borrow and a value -----

theorem opt_none(c: Checker, a: Ty, b: Ty): OptOk(c, mut1(None(), c), a, b) {
  (
    o: CkOrdered(c)
  ) => and_intro(
    grows_refl(c, o),
    (t: Ty, e: Eq(Option(Ty), None(), Some(t))) => False_elim(jn_none_ne_some(t, e))
  )
}

theorem jbk_ok(
  c: Checker,
  x: Ty,
  y: Ty,
  m: Mut1(Yn, Checker),
  h: Post(c, m, (c2: Checker) => TyEqAt(c2, x, y))
): OptEq(c, ck_jb_k(x, m), x, y) {
  match m -> (Post(c, m, (c2: Checker) => TyEqAt(c2, x, y))) -> OptEq(c, ck_jb_k(x, m), x, y) {
    mut1(
      v,
      c2
    ) => match v -> (
      Post(c, mut1(v, c2), (c3: Checker) => TyEqAt(c3, x, y))
    ) -> OptEq(c, ck_jb_k(x, mut1(v, c2)), x, y) {
      yes => (
        h1: Post(c, mut1(yes, c2), (c3: Checker) => TyEqAt(c3, x, y))
      ) => (
        o: CkOrdered(c)
      ) => and_intro(
        and_left(h1(o)),
        (
          t: Ty,
          e: Eq(Option(Ty), Some(ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), x)), Some(t))
        ) => Eq_subst(
          (z: Ty) => And(TyEqAt(c2, x, z), TyEqAt(c2, y, z)),
          ck_some_inj(ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), x), t, e),
          and_intro(
            ty_resolve_eq(ck_steps_of(c2), ck_subst_of(c2), KeptOk(ck_kept_of(c2)), x),
            tyeq_trans(
              tyeq_sym(and_right(h1(o))(refl())),
              ty_resolve_eq(ck_steps_of(c2), ck_subst_of(c2), KeptOk(ck_kept_of(c2)), x)
            )
          )
        )
      )
      no => (
        h1: Post(c, mut1(no, c2), (c3: Checker) => TyEqAt(c3, x, y))
      ) => (
        o: CkOrdered(c)
      ) => and_intro(
        and_left(h1(o)),
        (t: Ty, e: Eq(Option(Ty), None(), Some(t))) => False_elim(jn_none_ne_some(t, e))
      )
    }
  }(h)
}

// From the same type to fitting it: a borrow fits what its value is.
theorem opt_of_eq(
  c: Checker,
  m: Mut1(Option(Ty), Checker),
  x: Ty,
  y: Ty,
  a: Ty,
  b: Ty,
  fa: ∀ c2: Checker. ∀ t: Ty. (TyEqAt(c2, x, t)) -> (TyEqAt(c2, y, t)) -> SubAt(c2, a, t),
  fb: ∀ c2: Checker. ∀ t: Ty. (TyEqAt(c2, x, t)) -> (TyEqAt(c2, y, t)) -> SubAt(c2, b, t),
  h: OptEq(c, m, x, y)
): OptOk(c, m, a, b) {
  (
    o: CkOrdered(c)
  ) => and_intro(
    and_left(h(o)),
    (
      t: Ty,
      e: Eq(Option(Ty), ck_val(m), Some(t))
    ) => and_intro(
      fa(ck_st(m), t, and_left(and_right(h(o))(t, e)), and_right(and_right(h(o))(t, e))),
      fb(ck_st(m), t, and_left(and_right(h(o))(t, e)), and_right(and_right(h(o))(t, e)))
    )
  )
}

theorem jb2y_ok(
  c: Checker,
  a: Ty,
  x: Ty,
  mm: Yn,
  y: Yn
): OptOk(c, ck_jb2y(c, a, x, y), a, TyBorrow(x, mm)) {
  match y -> OptOk(c, ck_jb2y(c, a, x, y), a, TyBorrow(x, mm)) {
    yes => opt_of_eq(
      c,
      ck_jb_k(x, ck_attempt_unify(c, x, a)),
      x,
      a,
      a,
      TyBorrow(x, mm),
      (c2: Checker, t: Ty, hx: TyEqAt(c2, x, t), hy: TyEqAt(c2, a, t)) => sub_of_eq(c2, a, t, hy),
      (
        c2: Checker,
        t: Ty,
        hx: TyEqAt(c2, x, t),
        hy: TyEqAt(c2, a, t)
      ) => sub_unborrow_at(c2, x, t, mm, sub_of_eq(c2, x, t, hx)),
      jbk_ok(c, x, a, ck_attempt_unify(c, x, a), attempt_unify_eq(c, x, a))
    )
    no => opt_none(c, a, TyBorrow(x, mm))
  }
}

theorem jb2_cases(
  c: Checker,
  a: Ty,
  b1: Ty,
  b: Ty,
  eb: Eq(Ty, b1, b)
): OptOk(c, ck_jb2(c, a, b), a, b1) {
  match b -> OptOk(c, ck_jb2(c, a, b), a, b1) {
    TyBorrow(
      x,
      mm
    ) => Eq_subst(
      (z: Ty) => OptOk(c, ck_jb2(c, a, TyBorrow(x, mm)), a, z),
      Eq_sym(eb),
      jb2y_ok(c, a, x, mm, yn_and(yn_not(ty_is_borrow(a)), kind_dup(ck_kind(c, x))))
    )
    _ => opt_none(c, a, b1)
  }
}

theorem second_ok(c: Checker, a: Ty, b: Ty): OptOk(c, ck_join_borrowed_second(c, a, b), a, b) {
  Eq_subst(
    (z: Mut1(Option(Ty), Checker)) => OptOk(c, z, a, b),
    Eq_sym(jb2_unf(c, a, b)),
    jb2_cases(c, a, b, b, refl())
  )
}

theorem opt_rewrap(
  c: Checker,
  m: Mut1(Option(Ty), Checker),
  a: Ty,
  b: Ty,
  h: OptOk(c, m, a, b)
): OptOk(c, ck_rewrap1(m), a, b) {
  Eq_subst((z: Mut1(Option(Ty), Checker)) => OptOk(c, z, a, b), Eq_sym(ck_rewrap1_id(m)), h)
}

theorem jb1y_ok(
  c: Checker,
  x: Ty,
  mm: Yn,
  b: Ty,
  y: Yn
): OptOk(c, ck_jb1y(c, x, mm, b, y), TyBorrow(x, mm), b) {
  match y -> OptOk(c, ck_jb1y(c, x, mm, b, y), TyBorrow(x, mm), b) {
    yes => opt_of_eq(
      c,
      ck_jb_k(x, ck_attempt_unify(c, x, b)),
      x,
      b,
      TyBorrow(x, mm),
      b,
      (
        c2: Checker,
        t: Ty,
        hx: TyEqAt(c2, x, t),
        hy: TyEqAt(c2, b, t)
      ) => sub_unborrow_at(c2, x, t, mm, sub_of_eq(c2, x, t, hx)),
      (c2: Checker, t: Ty, hx: TyEqAt(c2, x, t), hy: TyEqAt(c2, b, t)) => sub_of_eq(c2, b, t, hy),
      jbk_ok(c, x, b, ck_attempt_unify(c, x, b), attempt_unify_eq(c, x, b))
    )
    no => opt_rewrap(
      c,
      ck_join_borrowed_second(c, TyBorrow(x, mm), b),
      TyBorrow(x, mm),
      b,
      second_ok(c, TyBorrow(x, mm), b)
    )
  }
}

// A step at a type a wildcard arm cannot name: `x` is found from `ex`.
theorem opt_cases<x: Ty>(
  c: Checker,
  f: (Ty) -> Mut1(Option(Ty), Checker),
  g: (Ty) -> Mut1(Option(Ty), Checker),
  a1: Ty,
  b: Ty,
  ex: Eq(Ty, a1, x),
  e: Eq(Mut1(Option(Ty), Checker), f(x), g(x)),
  h: OptOk(c, g(a1), a1, b)
): OptOk(c, f(x), a1, b) {
  Eq_subst(
    (z: Mut1(Option(Ty), Checker)) => OptOk(c, z, a1, b),
    Eq_sym(e),
    Eq_subst((w: Ty) => OptOk(c, g(w), a1, b), ex, h)
  )
}

theorem jb1_cases(
  c: Checker,
  a1: Ty,
  a: Ty,
  b: Ty,
  ea: Eq(Ty, a1, a)
): OptOk(c, ck_join_borrowed(c, a, b), a1, b) {
  match a -> OptOk(c, ck_join_borrowed(c, a, b), a1, b) {
    TyBorrow(
      x,
      mm
    ) => Eq_subst(
      (z: Ty) => OptOk(c, ck_join_borrowed(c, TyBorrow(x, mm), b), z, b),
      Eq_sym(ea),
      Eq_subst(
        (z: Mut1(Option(Ty), Checker)) => OptOk(c, z, TyBorrow(x, mm), b),
        Eq_sym(jb1_borrow(c, x, mm, b)),
        jb1y_ok(c, x, mm, b, yn_and(yn_not(ty_is_borrow(b)), kind_dup(ck_kind(c, x))))
      )
    )
    _ => opt_cases(
      c,
      (z: Ty) => ck_join_borrowed(c, z, b),
      (z: Ty) => ck_rewrap1(ck_join_borrowed_second(c, z, b)),
      a1,
      b,
      ea,
      refl(),
      opt_rewrap(c, ck_join_borrowed_second(c, a1, b), a1, b, second_ok(c, a1, b))
    )
  }
}

theorem borrowed_ok(c: Checker, a: Ty, b: Ty): OptOk(c, ck_join_borrowed(c, a, b), a, b) {
  jb1_cases(c, a, a, b, refl())
}

// ----- the join -----

theorem join_e2_some(
  c: Checker,
  c2: Checker,
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  t: Ty,
  g: Grows(c, c2),
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  h: And(SubAt(c2, a, t), SubAt(c2, b, t))
): And(SubAt(c2, a0, t), SubAt(c2, b0, t)) {
  and_intro(
    sub_trans_at(
      c2,
      a0,
      a,
      t,
      sub_of_eq(c2, a0, a, tyeq_at_move(c, c2, g, a0, a, ha)),
      and_left(h)
    ),
    sub_trans_at(
      c2,
      b0,
      b,
      t,
      sub_of_eq(c2, b0, b, tyeq_at_move(c, c2, g, b0, b, hb)),
      and_right(h)
    )
  )
}

theorem join_union(
  c: Checker,
  x0: Ty,
  x: Ty,
  u: Ty,
  ys: List(Ty),
  hx: TyEqAt(c, x0, x),
  hy: SubAnyAt(c, x, ys),
  e: TyEqAt(c, TyUnion(ys), u)
): SubAt(c, x0, u) {
  sub_trans_at(
    c,
    x0,
    x,
    u,
    sub_of_eq(c, x0, x, hx),
    sub_trans_at(
      c,
      x,
      TyUnion(ys),
      u,
      sub_union_r_at(c, x, ys, hy),
      sub_of_eq(c, TyUnion(ys), u, e)
    )
  )
}

theorem join_e2_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  m: Mut1(Option(Ty), Checker),
  h: OptOk(c, m, a, b)
): JoinOk(c, ck_join_e2(a, b, m), a0, b0) {
  match m -> (OptOk(c, m, a, b)) -> JoinOk(c, ck_join_e2(a, b, m), a0, b0) {
    mut1(
      o2,
      c2
    ) => match o2 -> (
      OptOk(c, mut1(o2, c2), a, b)
    ) -> JoinOk(c, ck_join_e2(a, b, mut1(o2, c2)), a0, b0) {
      Some(
        t
      ) => (
        h1: OptOk(c, mut1(Some(t), c2), a, b)
      ) => (
        o: CkOrdered(c)
      ) => and_intro(
        and_left(h1(o)),
        join_e2_some(c, c2, a0, b0, a, b, t, and_left(h1(o)), ha, hb, and_right(h1(o))(t, refl()))
      )
      None => (
        h1: OptOk(c, mut1(None(), c2), a, b)
      ) => (
        o: CkOrdered(c)
      ) => and_intro(
        and_left(h1(o)),
        and_intro(
          join_union(
            c2,
            a0,
            a,
            ty_union(Cons(a, Cons(b, Nil))),
            Cons(a, Cons(b, Nil)),
            tyeq_at_move(c, c2, and_left(h1(o)), a0, a, ha),
            tysub_any_here(Cons(b, Nil), sub_of_eq(c2, a, a, tyeq_refl(a))),
            tyeq_union_norm(Cons(a, Cons(b, Nil)))
          ),
          join_union(
            c2,
            b0,
            b,
            ty_union(Cons(a, Cons(b, Nil))),
            Cons(a, Cons(b, Nil)),
            tyeq_at_move(c, c2, and_left(h1(o)), b0, b, hb),
            tysub_any_there(a, tysub_any_here(Nil, sub_of_eq(c2, b, b, tyeq_refl(b)))),
            tyeq_union_norm(Cons(a, Cons(b, Nil)))
          )
        )
      )
    }
  }(h)
}

theorem join_e1z_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  z: Yn,
  ez: Eq(Yn, ty_is_never(a), z)
): JoinOk(c, ck_join_e1z(c, a, b, z), a0, b0) {
  match z -> (Eq(Yn, ty_is_never(a), z)) -> JoinOk(c, ck_join_e1z(c, a, b, z), a0, b0) {
    yes => (
      e: Eq(Yn, ty_is_never(a), yes)
    ) => (
      o: CkOrdered(c)
    ) => and_intro(
      grows_refl(c, o),
      and_intro(jn_never_sub(c, a0, a, b, ha, e), sub_of_eq(c, b0, b, hb))
    )
    no => (
      e: Eq(Yn, ty_is_never(a), no)
    ) => join_e2_ok(c, a0, b0, a, b, ha, hb, ck_join_borrowed(c, a, b), borrowed_ok(c, a, b))
  }(ez)
}

theorem join_e1y_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  y: Yn,
  ey: Eq(Yn, yn_or(ty_eq(a, b), ty_is_never(b)), y)
): JoinOk(c, ck_join_e1y(c, a, b, y), a0, b0) {
  match y -> (
    Eq(Yn, yn_or(ty_eq(a, b), ty_is_never(b)), y)
  ) -> JoinOk(c, ck_join_e1y(c, a, b, y), a0, b0) {
    yes => (
      e: Eq(Yn, yn_or(ty_eq(a, b), ty_is_never(b)), yes)
    ) => (
      o: CkOrdered(c)
    ) => and_intro(
      grows_refl(c, o),
      and_intro(
        sub_of_eq(c, a0, a, ha),
        jn_or_yes(
          ty_eq(a, b),
          ty_is_never(b),
          SubAt(c, b0, a),
          e,
          (
            q: Eq(Yn, ty_eq(a, b), yes)
          ) => sub_of_eq(
            c,
            b0,
            a,
            Eq_subst((w: Ty) => TyEqAt(c, b0, w), Eq_sym(ty_eq_sound(a, b, q)), hb)
          ),
          (q: Eq(Yn, ty_is_never(b), yes)) => jn_never_sub(c, b0, b, a, hb, q)
        )
      )
    )
    no => (
      e: Eq(Yn, yn_or(ty_eq(a, b), ty_is_never(b)), no)
    ) => join_e1z_ok(c, a0, b0, a, b, ha, hb, ty_is_never(a), refl())
  }(ey)
}

theorem join_e_ok(c: Checker, a0: Ty, b0: Ty): JoinOk(c, ck_join_e(c, a0, b0), a0, b0) {
  join_e1y_ok(
    c,
    a0,
    b0,
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0),
    ty_resolve_eq(ck_steps_of(c), ck_subst_of(c), KeptOk(ck_kept_of(c)), a0),
    ty_resolve_eq(ck_steps_of(c), ck_subst_of(c), KeptOk(ck_kept_of(c)), b0),
    yn_or(
      ty_eq(
        ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
        ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0)
      ),
      ty_is_never(ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0))
    ),
    refl()
  )
}

theorem join_k_ok(
  c: Checker,
  a0: Ty,
  b0: Ty,
  m: Mut1(Yn, Checker),
  h: Post(c, m, (c2: Checker) => TyEqAt(c2, a0, b0))
): JoinOk(c, ck_join_k(a0, b0, m), a0, b0) {
  match m -> (
    Post(c, m, (c2: Checker) => TyEqAt(c2, a0, b0))
  ) -> JoinOk(c, ck_join_k(a0, b0, m), a0, b0) {
    mut1(
      v,
      c2
    ) => match v -> (
      Post(c, mut1(v, c2), (c3: Checker) => TyEqAt(c3, a0, b0))
    ) -> JoinOk(c, ck_join_k(a0, b0, mut1(v, c2)), a0, b0) {
      yes => (
        h1: Post(c, mut1(yes, c2), (c3: Checker) => TyEqAt(c3, a0, b0))
      ) => (
        o: CkOrdered(c)
      ) => and_intro(
        and_left(h1(o)),
        and_intro(
          sub_of_eq(
            c2,
            a0,
            ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), a0),
            ty_resolve_eq(ck_steps_of(c2), ck_subst_of(c2), KeptOk(ck_kept_of(c2)), a0)
          ),
          sub_of_eq(
            c2,
            b0,
            ty_resolve_in(ck_steps_of(c2), ck_subst_of(c2), a0),
            tyeq_trans(
              tyeq_sym(and_right(h1(o))(refl())),
              ty_resolve_eq(ck_steps_of(c2), ck_subst_of(c2), KeptOk(ck_kept_of(c2)), a0)
            )
          )
        )
      )
      no => (
        h1: Post(c, mut1(no, c2), (c3: Checker) => TyEqAt(c3, a0, b0))
      ) => join_after(
        c,
        c2,
        ck_join_e(c2, a0, b0),
        a0,
        b0,
        (o: CkOrdered(c)) => and_left(h1(o)),
        join_e_ok(c2, a0, b0)
      )
    }
  }(h)
}

theorem ck_join_ok(c: Checker, a0: Ty, b0: Ty): JoinOk(c, ck_join(c, a0, b0), a0, b0) {
  Eq_subst(
    (z: Mut1(Ty, Checker)) => JoinOk(c, z, a0, b0),
    Eq_sym(join_unf(c, a0, b0)),
    join_k_ok(
      c,
      a0,
      b0,
      ck_join_my(c, a0, b0, yn_or(ck_has_vars(c, a0), ck_has_vars(c, b0))),
      join_my_ok(c, a0, b0, yn_or(ck_has_vars(c, a0), ck_has_vars(c, b0)))
    )
  )
}
