import "fits_allocation_steps.taut"
import std::Nat
import "allocation_advance.taut"
import "allocation_state.taut"
import "checker.taut"
import "fits_allocation_defs.taut"
import "fits_allocation_product.taut"
import "fits_sound.taut"
import "ty.taut"
import "type_allocation.taut"
import "unify_sound.taut"

pub theorem fits_allocation_at(fuel: Nat): FitsAllocationAt(fuel) {
  match fuel: FitsAllocationAt(fuel) {
    Zero => AndIntro(
      c => a => b => ordered => state => a_bound => b_bound => AndIntro(
        Nat::le_refl(ck_next_of(c)),
        state
      ),
      AndIntro(
        c => a => b => ordered => state => a_bound => b_bound => AndIntro(
          Nat::le_refl(ck_next_of(c)),
          state
        ),
        AndIntro(
          c => a => b => ordered => state => a_bound => b_bound => AndIntro(
            Nat::le_refl(ck_next_of(c)),
            state
          ),
          AndIntro(
            c => a => b => ordered => state => a_bound => b_bound => AndIntro(
              Nat::le_refl(ck_next_of(c)),
              state
            ),
            AndIntro(
              c => a => b => ordered => state => a_bound => b_bound => AndIntro(
                Nat::le_refl(ck_next_of(c)),
                state
              ),
              AndIntro(
                c => x => ma => b => ordered => state => x_bound => b_bound => AndIntro(
                  Nat::le_refl(ck_next_of(c)),
                  state
                ),
                AndIntro(
                  c => a => b => ordered => state => a_bound => b_bound => AndIntro(
                    Nat::le_refl(ck_next_of(c)),
                    state
                  ),
                  AndIntro(
                    c => a => b => ordered => state => a_bound => b_bound => AndIntro(
                      Nat::le_refl(ck_next_of(c)),
                      state
                    ),
                    AndIntro(
                      c => a => b => ordered => state => a_bound => b_bound => AndIntro(
                        Nat::le_refl(ck_next_of(c)),
                        state
                      ),
                      AndIntro(
                        c => a => b => ordered => state => a_bound => b_bound => AndIntro(
                          Nat::le_refl(ck_next_of(c)),
                          state
                        ),
                        AndIntro(
                          c => ta => x => b => ordered => state => x_bound => b_bound => AndIntro(
                            Nat::le_refl(ck_next_of(c)),
                            state
                          ),
                          AndIntro(
                            c => pa => ra => ka => b => ordered => state => pa_bound => ra_bound => b_bound => AndIntro(
                              Nat::le_refl(ck_next_of(c)),
                              state
                            ),
                            AndIntro(
                              c => xs => b => ordered => state => xs_bound => b_bound => AndIntro(
                                Nat::le_refl(ck_next_of(c)),
                                state
                              ),
                              AndIntro(
                                c => a => ys => ordered => state => a_bound => ys_bound => AndIntro(
                                  Nat::le_refl(ck_next_of(c)),
                                  state
                                ),
                                c => pa => pb => ordered => state => pa_bound => pb_bound => AndIntro(
                                  Nat::le_refl(ck_next_of(c)),
                                  state
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    Succ(rest) => {
      let ih: FitsAllocationAt(rest) := fits_allocation_at(rest)
      AndIntro(
        c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_U(
          rest,
          ih,
          c,
          a,
          b,
          ordered,
          state,
          a_bound,
          b_bound
        ),
        AndIntro(
          c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_A(
            rest,
            ih,
            c,
            a,
            b,
            ordered,
            state,
            a_bound,
            b_bound
          ),
          AndIntro(
            c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_Po(
              rest,
              ih,
              c,
              a,
              b,
              ordered,
              state,
              a_bound,
              b_bound
            ),
            AndIntro(
              c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_L(
                rest,
                ih,
                c,
                a,
                b,
                ordered,
                state,
                a_bound,
                b_bound
              ),
              AndIntro(
                c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_B(
                  rest,
                  ih,
                  c,
                  a,
                  b,
                  ordered,
                  state,
                  a_bound,
                  b_bound
                ),
                AndIntro(
                  c => x => ma => b => ordered => state => x_bound => b_bound => fits_alloc_step_Le(
                    rest,
                    ih,
                    c,
                    x,
                    ma,
                    b,
                    ordered,
                    state,
                    x_bound,
                    b_bound
                  ),
                  AndIntro(
                    c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_V(
                      rest,
                      ih,
                      c,
                      a,
                      b,
                      ordered,
                      state,
                      a_bound,
                      b_bound
                    ),
                    AndIntro(
                      c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_S(
                        rest,
                        ih,
                        c,
                        a,
                        b,
                        ordered,
                        state,
                        a_bound,
                        b_bound
                      ),
                      AndIntro(
                        c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_I(
                          rest,
                          ih,
                          c,
                          a,
                          b,
                          ordered,
                          state,
                          a_bound,
                          b_bound
                        ),
                        AndIntro(
                          c => a => b => ordered => state => a_bound => b_bound => fits_alloc_step_T(
                            rest,
                            ih,
                            c,
                            a,
                            b,
                            ordered,
                            state,
                            a_bound,
                            b_bound
                          ),
                          AndIntro(
                            c => ta => x => b => ordered => state => x_bound => b_bound => fits_alloc_step_Ut(
                              rest,
                              ih,
                              c,
                              ta,
                              x,
                              b,
                              ordered,
                              state,
                              x_bound,
                              b_bound
                            ),
                            AndIntro(
                              c => pa => ra => ka => b => ordered => state => pa_bound => ra_bound => b_bound => fits_alloc_step_F(
                                rest,
                                ih,
                                c,
                                pa,
                                ra,
                                ka,
                                b,
                                ordered,
                                state,
                                pa_bound,
                                ra_bound,
                                b_bound
                              ),
                              AndIntro(
                                c => xs => b => ordered => state => xs_bound => b_bound => fits_alloc_step_E(
                                  rest,
                                  ih,
                                  c,
                                  xs,
                                  b,
                                  ordered,
                                  state,
                                  xs_bound,
                                  b_bound
                                ),
                                AndIntro(
                                  c => a => ys => ordered => state => a_bound => ys_bound => fits_alloc_step_Y(
                                    rest,
                                    ih,
                                    c,
                                    a,
                                    ys,
                                    ordered,
                                    state,
                                    a_bound,
                                    ys_bound
                                  ),
                                  c => pa => pb => ordered => state => pa_bound => pb_bound => fits_alloc_step_P(
                                    rest,
                                    ih,
                                    c,
                                    pa,
                                    pb,
                                    ordered,
                                    state,
                                    pa_bound,
                                    pb_bound
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    }
  }
}
pub theorem ck_fits_allocation(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  left: TypeAllocated(ck_next_of(c), a),
  right: TypeAllocated(ck_next_of(c), b)
): AllocationAdvance(c, ck_fits(c, a, b)) {
  allocation_advance_rewrap(
    c,
    ck_fits_in(ck_steps_of(c), c, a, b),
    And::left(fits_allocation_at(ck_steps_of(c)))(c, a, b, ordered, state, left, right)
  )
}
pub theorem ck_attempt_fits_allocation(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  left: TypeAllocated(ck_next_of(c), a),
  right: TypeAllocated(ck_next_of(c), b)
): AllocationAdvance(c, ck_attempt_fits(c, a, b)) {
  allocation_advance_rewrap(
    c,
    ck_attempt_fits_in(ck_steps_of(c), c, a, b),
    And::left(And::right(fits_allocation_at(ck_steps_of(c))))(c, a, b, ordered, state, left, right)
  )
}
pub theorem ck_fits_wide_allocation(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  left: TypeAllocated(ck_next_of(c), a),
  right: TypeAllocated(ck_next_of(c), b)
): AllocationAdvance(c, ck_fits_wide(c, a, b)) {
  allocation_advance_unwiden_on(
    c,
    ck_widen_of(c),
    ck_fits(ck_on(c), a, b),
    ck_fits_allocation(ck_on(c), a, b, ordered, state, left, right)
  )
}
