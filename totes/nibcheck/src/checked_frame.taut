import "operation_error_sound.taut"

// Ordering is needed by unification; success also preserves earlier failures.
pub def CkCheckedFrame<A: Type>(
  c: Checker,
  m: Mut1(A, Checker)
): Prop := And(CkOrdered(ck_st(m)), CkErrorFrame(c, m))
pub theorem checked_frame_read<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  same: CkReadFrame(c, m),
  errors: CkErrorFrame(c, m),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, m) {
  AndIntro(frame_subst_ordered(c, m, same, ordered), errors)
}
pub theorem checked_frame_grows<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  grows: Grows(c, ck_st(m))
): CkCheckedFrame(c, m) {
  AndIntro(And::left(grows), error_frame_grows(c, m, grows))
}
pub theorem checked_frame_return<A: Type>(
  c: Checker,
  v: A,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, mut1(v, c)) {
  AndIntro(ordered, error_frame_return(c, v))
}
pub theorem checked_frame_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  h: CkCheckedFrame(c, m)
): CkCheckedFrame(c, ck_rewrap1(m)) {
  Eq::subst((result: Mut1(A, Checker)) => CkCheckedFrame(c, result), Eq::sym(ck_rewrap1_id(m)), h)
}
pub theorem checked_frame_bind<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  hm: CkCheckedFrame(c, m),
  hk: ∀ v: A. ∀ next: Checker. ∀ ordered: CkOrdered(next). CkCheckedFrame(next, k(v, next))
): CkCheckedFrame(c, frame_bind(k, m)) {
  match m: CkCheckedFrame(c, frame_bind(k, m)) {
    mut1(v, next) => {
      let after: CkCheckedFrame(next, k(v, next)) := hk(v, next, And::left(hm))
      AndIntro(And::left(after), clean => And::right(hm)(And::right(after)(clean)))
    }
  }
}
pub theorem checked_frame_changed<A: Type>(
  c: Checker,
  next: Checker,
  m: Mut1(A, Checker),
  same: decl_names_errors(next) = decl_names_errors(c),
  h: CkCheckedFrame(next, m)
): CkCheckedFrame(c, m) {
  AndIntro(And::left(h), clean => Eq::trans(Eq::sym(same), And::right(h)(clean)))
}
