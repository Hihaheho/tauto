      Cons(f, rest) => vs_field(c, locals, f, rest, r, (rs: List(Text)) => (e: vr_fields(c, locals, rest) = Some(rs)) => vs_fields(c, locals, rest, rs, e), h)
    }
  }

  pub theorem vs_field(c: VrCtx, locals: List(RowName), f: SurfaceField, rest: List(SurfaceField), r: List(Text), more: ∀ rs: List(Text). (vr_fields(c, locals, rest) = Some(rs)) -> PerformsFields(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, rest, rs), h: vr_both(vr_field(c, locals, f), vr_fields(c, locals, rest)) = Some(r)): PerformsFields(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(f, rest), r) {
