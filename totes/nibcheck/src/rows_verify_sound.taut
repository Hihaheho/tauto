      Cons(arm, rest) => vs_arm(c, locals, arm, rest, r, (rs: List(Text)) => (e: vr_arms(c, locals, rest) = Some(rs)) => vs_arms(c, locals, rest, rs, e), h)
    }
  }

  pub theorem vs_arm(c: VrCtx, locals: List(RowName), arm: SurfaceArm, rest: List(SurfaceArm), r: List(Text), more: ∀ rs: List(Text). (vr_arms(c, locals, rest) = Some(rs)) -> PerformsArms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, rest, rs), h: vr_both(vr_arm(c, locals, arm), vr_arms(c, locals, rest)) = Some(r)): PerformsArms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(arm, rest), r) {
    match arm {
      SurfaceArmMk(pattern, guard, goal, body) => vs_both_split(vr_both(vr_opt(c, vr_bind(pattern, locals), guard), vr_term(c, vr_bind(pattern, locals), body)), vr_arms(c, locals, rest), r, h, x => y => ex => ey => er => vs_both_split(vr_opt(c, vr_bind(pattern, locals), guard), vr_term(c, vr_bind(pattern, locals), body), x, ex, rg => rb => eg => eb => ex2 => Eq::subst((z: List(Text)) => PerformsArms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(SurfaceArmMk(pattern, guard, goal, body), rest), z), Eq::trans(Eq::sym(List::append_assoc(rg, rb, y)), Eq::trans(Eq::congr(⟦List::append(□, y)⟧, ex2), er)), PerformsArmsCons(pattern, guard, goal, body, rest, vs_bind(pattern, locals), vs_opt(c, vr_bind(pattern, locals), guard, rg, eg), vs_term(c, vr_bind(pattern, locals), body, rb, eb), more(y, ey)))))
    }
  }

  pub theorem vs_handlers(c: VrCtx, locals: List(RowName), hs: List(SurfaceHandler), ra: List(Text), h: vr_handlers(c, locals, hs) = Some(ra), R: List(Text), sub: Sub(Text, ra, R)): HandlersPerform(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, hs, R) {
    match hs {
      Nil => HandlersPerformNil(locals, R)
      Cons(hd, rest) => vs_both_split(vr_handler(c, locals, hd), vr_handlers(c, locals, rest), ra, h, r1 => r2 => e1 => e2 => er => vs_handler(c, locals, hd, rest, R, r1, e1, Sub::trans(vs_sub_append_left(r1, r2), Eq::subst((z: List(Text)) => Sub(Text, z, R), Eq::sym(er), sub)), vs_handlers(c, locals, rest, r2, e2, R, Sub::trans(vs_sub_append_right(r1, r2), Eq::subst((z: List(Text)) => Sub(Text, z, R), Eq::sym(er), sub)))))
    }
  }

  pub theorem vs_handler(c: VrCtx, locals: List(RowName), hd: SurfaceHandler, rest: List(SurfaceHandler), R: List(Text), r1: List(Text), h1: vr_handler(c, locals, hd) = Some(r1), sub1: Sub(Text, r1, R), more: HandlersPerform(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, rest, R)): HandlersPerform(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(hd, rest), R) {
    match hd {
      HdReturn(pattern, body) => HandlersPerformReturn(pattern, body, rest, vs_bind(pattern, locals), PerformsWider(vs_term(c, vr_bind(pattern, locals), body, r1, h1), sub1), more)
      HdOperation(op, binds, types, patterns, k, cont_unused, guard, body) => vs_direct_arm_split(c, op, vr_both(vr_opt(c, vr_cont(k, vr_bind_op(op, patterns, locals)), guard), vr_term(c, vr_cont(k, vr_bind_op(op, patterns, locals)), body)), r1, h1, x => ex => xr => dir => vs_both_split(vr_opt(c, vr_cont(k, vr_bind_op(op, patterns, locals)), guard), vr_term(c, vr_cont(k, vr_bind_op(op, patterns, locals)), body), x, ex, rg => rb => eg => eb => ex2 => HandlersPerformOperation(
        op, binds, types, patterns, k, cont_unused, guard, body, rest,
        vs_bind_op(op, patterns, locals),
        vs_cont(k, vr_bind_op(op, patterns, locals)),
        vs_opt(c, vr_cont(k, vr_bind_op(op, patterns, locals)), guard, rg, eg),
        vs_term(c, vr_cont(k, vr_bind_op(op, patterns, locals)), body, rb, eb),
        Eq::subst((z: List(Text)) => Sub(Text, z, R), Eq::sym(Eq::trans(ex2, xr)), sub1),
        e => d => m => vs_all_direct(vr_env(c), vr_dvars(c), List::append(rg, rb), Eq::subst((z: List(Text)) => vr_all_direct(vr_env(c), vr_dvars(c), z) = true, Eq::sym(ex2), dir(vs_direct_quant(vr_env(c), op, d))), e, m),
        more
      )))
    }
  }

  pub theorem vs_call(c: VrCtx, locals: List(RowName), f: SurfaceTerm, args: List(SurfaceTerm), ls: List(Option(List(Text))), lat: VsLatents(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, args, ls), r: List(Text), h: vr_call(c, locals, f, args, ls) = Some(r)): CallPerforms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, f, args, r) {
    match f {
      SurfaceTermIndexedMk(kind, start, end, occ) => vs_call_kind(c, locals, kind, start, end, occ, args, ls, lat, r, h)
    }
  }

  pub theorem vs_call_kind(c: VrCtx, locals: List(RowName), kind: SurfaceKind, start: Nat, end: Nat, occ: Option(TermOccurrence), args: List(SurfaceTerm), ls: List(Option(List(Text))), lat: VsLatents(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, args, ls), r: List(Text), h: vr_call_kind(c, locals, kind, args, ls) = Some(r)): CallPerforms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, SurfaceTermIndexedMk(kind, start, end, occ), args, r) {
    match kind {
      SkVar(n) => vs_call_name(c, locals, n, start, end, occ, args, ls, lat, r, h)
      SkField(base, name) => vs_info_call(c, locals, base, name, start, end, occ, args, r, h)
      SkLam(ps, body, types, unused) => CallLambda(
        SurfaceTermIndexedMk(SkLam(ps, body, types, unused), start, end, occ),
        args,
        LambdaPlain(occ, ps, body, types, unused, start, end, vs_unknown(ps, locals), vs_term(c, vr_unknown(ps, locals), body, r, h))
      )
      SkBorrowLam(bs, lam) => CallLambda(SurfaceTermIndexedMk(SkBorrowLam(bs, lam), start, end, occ), args, LambdaBorrows(occ, bs, lam, start, end, vs_lambda(c, locals, lam, r, h)))
      _ => vs_no_some(r, h)
    }
  }

  pub theorem vs_lambda(c: VrCtx, locals: List(RowName), t: SurfaceTerm, r: List(Text), h: vr_lambda(c, locals, t) = Some(r)): LambdaPerforms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, t, r) {
    match t {
      SurfaceTermIndexedMk(kind, start, end, occ) => vs_lambda_kind(c, locals, kind, start, end, occ, r, h)
    }
  }

  pub theorem vs_lambda_kind(c: VrCtx, locals: List(RowName), kind: SurfaceKind, start: Nat, end: Nat, occ: Option(TermOccurrence), r: List(Text), h: vr_lambda_kind(c, locals, kind) = Some(r)): LambdaPerforms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, SurfaceTermIndexedMk(kind, start, end, occ), r) {
    match kind {
      SkLam(ps, body, types, unused) => LambdaPlain(occ, ps, body, types, unused, start, end, vs_unknown(ps, locals), vs_term(c, vr_unknown(ps, locals), body, r, h))
      SkBorrowLam(bs, lam) => LambdaBorrows(occ, bs, lam, start, end, vs_lambda(c, locals, lam, r, h))
      _ => vs_no_some(r, h)
    }
  }

  pub theorem vs_latent(c: VrCtx, locals: List(RowName), t: SurfaceTerm, r: List(Text), h: vr_latent(c, locals, t) = Some(r)): LatentPerforms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, t, r) {
