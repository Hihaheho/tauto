    }
  }

  pub theorem vs_arms(c: VrCtx, locals: List(RowName), arms: List(SurfaceArm), r: List(Text), h: vr_arms(c, locals, arms) = Some(r)): PerformsArms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, arms, r) {
