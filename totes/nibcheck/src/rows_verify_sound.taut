      Cons(a, rest) => VsLatentsCons(a, vr_latent(c, locals, a), (r: List(Text)) => (e: vr_latent(c, locals, a) = Some(r)) => vs_latent(c, locals, a, r, e), vs_latents(c, locals, rest))
    }
  }

  pub theorem vs_stmts(c: VrCtx, locals: List(RowName), ss: List(SurfaceStmt), r: List(Text), h: vr_stmts(c, locals, ss) = Some(r)): PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, ss, r) {
    match ss {
      Nil => Eq::subst((z: List(Text)) => PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Nil, z), vs_some_rows(Nil, r, h), PerformsStmtsNil(locals))
      Cons(st, rest) => vs_stmt(c, locals, st, rest, r, (l: List(RowName)) => (rs: List(Text)) => (e: vr_stmts(c, l, rest) = Some(rs)) => vs_stmts(c, l, rest, rs, e), h)
    }
  }

  pub theorem vs_stmt(c: VrCtx, locals: List(RowName), st: SurfaceStmt, rest: List(SurfaceStmt), r: List(Text), more: ∀ l: List(RowName). ∀ rs: List(Text). (vr_stmts(c, l, rest) = Some(rs)) -> PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), l, rest, rs), h: vr_both(vr_stmt(c, locals, st), vr_stmts(c, vr_stmt_bind(c, locals, st), rest)) = Some(r)): PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(st, rest), r) {
    match st {
      StLet(name, ty, value, b, m, unused, st_stack) => vs_both_split(vr_term(c, locals, value), vr_stmts(c, Cons(RowName::Mk(name, vr_bound_latent(value, vr_lambda(c, locals, value))), locals), rest), r, h, rv => rs => ev => es => er => Eq::subst((z: List(Text)) => PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(StLet(name, ty, value, b, m, unused, st_stack), rest), z), er, PerformsLet(name, ty, value, b, m, unused, st_stack, rest, vs_term(c, locals, value, rv, ev), vs_bl(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, value, vr_lambda(c, locals, value), (lr: List(Text)) => (le: vr_lambda(c, locals, value) = Some(lr)) => vs_lambda(c, locals, value, lr, le)), more(Cons(RowName::Mk(name, vr_bound_latent(value, vr_lambda(c, locals, value))), locals), rs, es))))
      StVar(name, ty, value, b, unused, st_stack) => vs_both_split(vr_term(c, locals, value), vr_stmts(c, Cons(RowName::Mk(name, vr_bound_latent(value, vr_lambda(c, locals, value))), locals), rest), r, h, rv => rs => ev => es => er => Eq::subst((z: List(Text)) => PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(StVar(name, ty, value, b, unused, st_stack), rest), z), er, PerformsVar(name, ty, value, b, unused, st_stack, rest, vs_term(c, locals, value, rv, ev), vs_bl(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, value, vr_lambda(c, locals, value), (lr: List(Text)) => (le: vr_lambda(c, locals, value) = Some(lr)) => vs_lambda(c, locals, value, lr, le)), more(Cons(RowName::Mk(name, vr_bound_latent(value, vr_lambda(c, locals, value))), locals), rs, es))))
      StAssign(name, place, value) => vs_both_split(vr_term(c, locals, value), vr_stmts(c, locals, rest), r, h, rv => rs => ev => es => er => Eq::subst((z: List(Text)) => PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(StAssign(name, place, value), rest), z), er, PerformsAssign(name, place, value, rest, vs_term(c, locals, value, rv, ev), more(locals, rs, es))))
      StExpr(e) => vs_both_split(vr_term(c, locals, e), vr_stmts(c, locals, rest), r, h, rv => rs => ev => es => er => Eq::subst((z: List(Text)) => PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(StExpr(e), rest), z), er, PerformsExpr(e, rest, vs_term(c, locals, e, rv, ev), more(locals, rs, es))))
      StReturn(v) => vs_both_split(vr_opt(c, locals, v), vr_stmts(c, locals, rest), r, h, rv => rs => ev => es => er => Eq::subst((z: List(Text)) => PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(StReturn(v), rest), z), er, PerformsReturn(v, rest, vs_opt(c, locals, v, rv, ev), more(locals, rs, es))))
      StWhile(cond, body) => vs_both_split(vr_cons("div", vr_both(vr_term(c, locals, cond), vr_term(c, locals, body))), vr_stmts(c, locals, rest), r, h, x => rs => ex => es => er => vs_cons_split("div", vr_both(vr_term(c, locals, cond), vr_term(c, locals, body)), x, ex, y => ey => ex2 => vs_both_split(vr_term(c, locals, cond), vr_term(c, locals, body), y, ey, rc => rb => ec => eb => ey2 => Eq::subst((z: List(Text)) => PerformsStmts(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, Cons(StWhile(cond, body), rest), z), Eq::trans(Eq::congr(⟦Cons("div", □)⟧, Eq::sym(List::append_assoc(rc, rb, rs))), Eq::trans(Eq::congr(⟦Cons("div", List::append(□, rs))⟧, ey2), Eq::trans(Eq::congr(⟦List::append(□, rs)⟧, ex2), er))), PerformsWhile(cond, body, rest, vs_term(c, locals, cond, rc, ec), vs_term(c, locals, body, rb, eb), more(locals, rs, es))))))
      StCalled(g, cc) => vs_decl(c, locals, StCalled(g, cc), rest, r, InertCalled(g, cc), more, h)
      StFn(f) => vs_decl(c, locals, StFn(f), rest, r, InertFn(f), more, h)
      StTheorem(tt) => vs_decl(c, locals, StTheorem(tt), rest, r, InertTheorem(tt), more, h)
      StDef(tt) => vs_decl(c, locals, StDef(tt), rest, r, InertDef(tt), more, h)
      StMutual(ss, a, bb) => vs_decl(c, locals, StMutual(ss, a, bb), rest, r, InertMutual(ss, a, bb), more, h)
      StImport(p, a, bb) => vs_decl(c, locals, StImport(p, a, bb), rest, r, InertImport(p, a, bb), more, h)
      StInductive(i) => vs_decl(c, locals, StInductive(i), rest, r, InertInductive(i), more, h)
      StEffect(e) => vs_decl(c, locals, StEffect(e), rest, r, InertEffect(e), more, h)
      StStruct(d) => vs_decl(c, locals, StStruct(d), rest, r, InertStruct(d), more, h)
      StEnum(d) => vs_decl(c, locals, StEnum(d), rest, r, InertEnum(d), more, h)
      StExtern(fs, instances, types, structs, enums, a, bb) => vs_decl(c, locals, StExtern(fs, instances, types, structs, enums, a, bb), rest, r, InertExtern(fs, instances, types, structs, enums, a, bb), more, h)
      StClass(cc) => vs_decl(c, locals, StClass(cc), rest, r, InertClass(cc), more, h)
      StInstance(i) => vs_decl(c, locals, StInstance(i), rest, r, InertInstance(i), more, h)
      StOther(w, a, bb) => vs_decl(c, locals, StOther(w, a, bb), rest, r, InertStmtOther(w, a, bb), more, h)
      StLoop(st_body, a, bb) => vs_decl(c, locals, StLoop(st_body, a, bb), rest, r, InertStmtLoop(st_body, a, bb), more, h)
      StModule(mod_name, mod_vis, mod_items, a, bb) => vs_decl(c, locals, StModule(mod_name, mod_vis, mod_items, a, bb), rest, r, InertStmtModule(mod_name, mod_vis, mod_items, a, bb), more, h)
      StReexport(re_path, re_names, re_spans, a, bb) => vs_decl(c, locals, StReexport(re_path, re_names, re_spans, a, bb), rest, r, InertStmtReexport(re_path, re_names, re_spans, a, bb), more, h)
      StFor(for_pat, for_src, st_body, a, bb) => vs_decl(c, locals, StFor(for_pat, for_src, st_body, a, bb), rest, r, InertStmtFor(for_pat, for_src, st_body, a, bb), more, h)
      StBreak(st_value, a, bb) => vs_decl(c, locals, StBreak(st_value, a, bb), rest, r, InertStmtBreak(st_value, a, bb), more, h)
      StContinue(a, bb) => vs_decl(c, locals, StContinue(a, bb), rest, r, InertStmtContinue(a, bb), more, h)
      StMacro(n, f, a, bb) => vs_decl(c, locals, StMacro(n, f, a, bb), rest, r, InertMacro(n, f, a, bb), more, h)
      StSyntax(n, g, a, bb) => vs_decl(c, locals, StSyntax(n, g, a, bb), rest, r, InertSyntax(n, g, a, bb), more, h)
      StAttributed(n, arg, g, inner) => vs_decl(c, locals, StAttributed(n, arg, g, inner), rest, r, InertAttributed(n, arg, g, inner), more, h)
    }
  }
}

// ---- functions -------------------------------------------------------------------

pub theorem vs_some_inj<A: Type>(x: A, y: A, e: Some(x) = Some(y)): x = y {
  match e {
    Refl => Refl
  }
}

pub theorem vs_written(w: Option(List(Text)), row: List(Text), h: vr_written_ok(w, row) = true): WrittenRowIs(w, row) {
  match w {
    None => WrittenNone(row)
    Some(x) => Eq::subst((z: List(Text)) => WrittenRowIs(Some(z), row), Eq::sym(vs_same(x, row, h)), WrittenSome(row))
  }
}

pub theorem vs_group_limit(env: RowEnv, ranks: List(Text × Nat), name: Text, row: List(Text), r: Nat, group: List(Text), rk: RankOf(ranks, name, r)): FunctionLimit(env, ranks, name, row, vr_group_limit(env, ranks, name, r, group)) {
  (⊢ (vr_has(group, name) && rows_decreases(rr_group_fns(env, group)) = vr_has(group, name) && rows_decreases(rr_group_fns(env, group))) -> FunctionLimit(env, ranks, name, row, vr_group_limit(env, ranks, name, r, group)) from match vr_has(group, name) && rows_decreases(rr_group_fns(env, group)) eqn g {
    true => q => FunctionLimitStructural(r, group, rk, vs_has_sound(group, name, Bool::and_true_left(vr_has(group, name), rows_decreases(rr_group_fns(env, group)), g)), Bool::and_true_right(vr_has(group, name), rows_decreases(rr_group_fns(env, group)), g))
    false => q => FunctionLimitRank(r, rk)
  })(Refl)
}

pub theorem vs_limit(env: RowEnv, ranks: List(Text × Nat), name: Text, row: List(Text), lim: RankLimit, h: vr_limit(env, ranks, name, row) = Some(lim)): FunctionLimit(env, ranks, name, row, lim) {
  (⊢ (vr_limit(env, ranks, name, row) = Some(lim)) -> FunctionLimit(env, ranks, name, row, lim) from match vr_has(row, "div") eqn d {
    true => h2 => Eq::subst((z: RankLimit) => FunctionLimit(env, ranks, name, row, z), vs_some_inj(RankLimit::Mk(ranks, None, Nil), lim, h2), FunctionLimitDiv(vs_has_sound(row, "div", d)))
    false => h2 => (⊢ ((⊢ Option(RankLimit) from match vr_rank(ranks, name) {
      None => None
      Some(r) => Some(vr_group_limit(env, ranks, name, r, vr_group(env, name)))
    }) = Some(lim)) -> FunctionLimit(env, ranks, name, row, lim) from match vr_rank(ranks, name) eqn rk {
      None => h3 => vs_no_some(lim, h3)
      Some(r) => h3 => Eq::subst((z: RankLimit) => FunctionLimit(env, ranks, name, row, z), vs_some_inj(vr_group_limit(env, ranks, name, r, vr_group(env, name)), lim, h3), vs_group_limit(env, ranks, name, row, r, vr_group(env, name), vs_rank(ranks, name, r, rk)))
    })(h2)
  })(h)
}

pub theorem vs_function_body(
  env: RowEnv,
  sig: List(Text × List(Text)),
  ranks: List(Text × Nat),
  name: Text,
  f: SurfaceFn,
  row: List(Text),
  lim: RankLimit,
  lk: vr_lookup(sig, name) = Some(row),
  wo: vr_written_ok(rr_effects(f), row) = true,
  vl: vr_limit(env, ranks, name, row) = Some(lim),
  h: (⊢ Bool from match vr_term(VrCtx::Mk(env, sig, vr_direct_generics(rr_generics(f), rr_bounds(f)), lim), vr_params(rr_params(f), rr_param_types(f), Nil), rr_body(f)) {
    None => false
    Some(r) => vr_sub(r, row)
  }) = true
): FunctionRowOk(env, sig, ranks, name, f) {
  match vr_term(VrCtx::Mk(env, sig, vr_direct_generics(rr_generics(f), rr_bounds(f)), lim), vr_params(rr_params(f), rr_param_types(f), Nil), rr_body(f)) eqn vt {
    None => vs_absurd(false, h, Refl)
    Some(r) => FunctionRowOkMk(
      row,
      vr_params(rr_params(f), rr_param_types(f), Nil),
      vr_direct_generics(rr_generics(f), rr_bounds(f)),
      lim,
      vs_lookup(sig, name, row, lk),
      vs_written(rr_effects(f), row, wo),
      vs_params(rr_params(f), rr_param_types(f), Nil),
      vs_direct_generics(rr_generics(f), rr_bounds(f)),
      vs_limit(env, ranks, name, row, lim, vl),
      PerformsWider(
        vs_term(VrCtx::Mk(env, sig, vr_direct_generics(rr_generics(f), rr_bounds(f)), lim), vr_params(rr_params(f), rr_param_types(f), Nil), rr_body(f), r, vt),
        vs_sub_sound(r, row, h)
      )
    )
  }
}

pub theorem vs_function_limit(env: RowEnv, sig: List(Text × List(Text)), ranks: List(Text × Nat), name: Text, f: SurfaceFn, row: List(Text), lk: vr_lookup(sig, name) = Some(row), wo: vr_written_ok(rr_effects(f), row) = true, h: (⊢ Bool from match vr_limit(env, ranks, name, row) {
      None => false
      Some(lim) => ⊢ Bool from match vr_term(VrCtx::Mk(env, sig, vr_direct_generics(rr_generics(f), rr_bounds(f)), lim), vr_params(rr_params(f), rr_param_types(f), Nil), rr_body(f)) {
        None => false
        Some(r) => vr_sub(r, row)
      }
    }) = true): FunctionRowOk(env, sig, ranks, name, f) {
  match vr_limit(env, ranks, name, row) eqn vl {
    None => vs_absurd(false, h, Refl)
    Some(lim) => vs_function_body(env, sig, ranks, name, f, row, lim, lk, wo, vl, h)
  }
}

pub theorem vs_function(env: RowEnv, sig: List(Text × List(Text)), ranks: List(Text × Nat), name: Text, f: SurfaceFn, h: vr_function(env, sig, ranks, name, f) = true): FunctionRowOk(env, sig, ranks, name, f) {
  (⊢ (vr_function(env, sig, ranks, name, f) = true) -> FunctionRowOk(env, sig, ranks, name, f) from match vr_lookup(sig, name) eqn lk {
    None => h2 => vs_absurd(false, h2, Refl)
    Some(row) => h2 => vs_function_limit(env, sig, ranks, name, f, row, lk, Bool::and_true_left(vr_written_ok(rr_effects(f), row), ⊢ Bool from match vr_limit(env, ranks, name, row) {
      None => false
      Some(lim) => ⊢ Bool from match vr_term(VrCtx::Mk(env, sig, vr_direct_generics(rr_generics(f), rr_bounds(f)), lim), vr_params(rr_params(f), rr_param_types(f), Nil), rr_body(f)) {
        None => false
        Some(r) => vr_sub(r, row)
      }
    }, h2), Bool::and_true_right(vr_written_ok(rr_effects(f), row), ⊢ Bool from match vr_limit(env, ranks, name, row) {
      None => false
      Some(lim) => ⊢ Bool from match vr_term(VrCtx::Mk(env, sig, vr_direct_generics(rr_generics(f), rr_bounds(f)), lim), vr_params(rr_params(f), rr_param_types(f), Nil), rr_body(f)) {
        None => false
        Some(r) => vr_sub(r, row)
      }
    }, h2))
  })(h)
}

// ---- the declarations of the program -----------------------------------------------

pub theorem vs_entries_keep(t: OrdmapTree(Text, SurfaceFn), done: List(Text × SurfaceFn), x: Text × SurfaceFn, m: Mem(Text × SurfaceFn, x, done)): Mem(Text × SurfaceFn, x, Ordmap::tree_entries(t, done)) {
  match t {
    OrdmapLeaf => m
    OrdmapNode(l, k, v, r, h) => vs_entries_keep(l, Cons(#(k, v), Ordmap::tree_entries(r, done)), x, MemThere(#(k, v), Ordmap::tree_entries(r, done), vs_entries_keep(r, done, x, m)))
  }
}

pub theorem vs_tree_get(t: OrdmapTree(Text, SurfaceFn), n: Text, f: SurfaceFn, done: List(Text × SurfaceFn), h: Ordmap::tree_get(t, n, Ordmap::compare_text) = Some(f)): Mem(Text × SurfaceFn, #(n, f), Ordmap::tree_entries(t, done)) {
  match t {
    OrdmapLeaf => vs_no_some(f, h)
    OrdmapNode(l, nk, nv, r, hh) => (⊢ (Ordmap::tree_get(OrdmapNode(l, nk, nv, r, hh), n, Ordmap::compare_text) = Some(f)) -> Mem(Text × SurfaceFn, #(n, f), Ordmap::tree_entries(OrdmapNode(l, nk, nv, r, hh), done)) from match Ordmap::compare_text(n, nk) eqn q {
      Less => h2 => vs_tree_get(l, n, f, Cons(#(nk, nv), Ordmap::tree_entries(r, done)), h2)
      Equal => h2 => vs_entries_keep(
        l,
        Cons(#(nk, nv), Ordmap::tree_entries(r, done)),
        #(n, f),
        Eq::subst(
          (z: Text) => Mem(Text × SurfaceFn, #(z, f), Cons(#(nk, nv), Ordmap::tree_entries(r, done))),
          Eq::sym(Ordmap::compare_text_eq(n, nk, q)),
          Eq::subst(
            (g: SurfaceFn) => Mem(Text × SurfaceFn, #(nk, g), Cons(#(nk, nv), Ordmap::tree_entries(r, done))),
            vs_some_inj(nv, f, h2),
            MemHere(Ordmap::tree_entries(r, done))
          )
        )
      )
      Greater => h2 => vs_entries_keep(l, Cons(#(nk, nv), Ordmap::tree_entries(r, done)), #(n, f), MemThere(#(nk, nv), Ordmap::tree_entries(r, done), vs_tree_get(r, n, f, done, h2)))
    })(h)
  }
}

pub theorem vs_failing_step(
  env: RowEnv,
  sig: List(Text × List(Text)),
  ranks: List(Text × Nat),
  e: Text × SurfaceFn,
  rest: List(Text × SurfaceFn),
  b: Bool,
  h: (⊢ List(SurfaceFn) from match b {
    true => vr_failing(env, sig, ranks, rest)
    false => Cons(e.snd, vr_failing(env, sig, ranks, rest))
  }) = Nil,
  ok: rr_unchecked(e.snd) || vr_function(env, sig, ranks, e.fst, e.snd) = b,
  ih: (vr_failing(env, sig, ranks, rest) = Nil) -> ∀ name: Text. ∀ f: SurfaceFn. (Mem(Text × SurfaceFn, #(name, f), rest)) -> (rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f)
): ∀ name: Text. ∀ f: SurfaceFn. (Mem(Text × SurfaceFn, #(name, f), Cons(e, rest))) -> (rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f) {
  match b {
    true => vs_failing_cons(env, sig, ranks, e, rest, nt => vs_or_split(
      rr_unchecked(e.snd),
      vr_function(env, sig, ranks, e.fst, e.snd),
      ok,
      t => vs_absurd(rr_unchecked(e.snd), t, nt),
      w => vs_function(env, sig, ranks, e.fst, e.snd, w)
    ), ih(h))
    false => ⊢ ∀ name: Text. ∀ f: SurfaceFn. (Mem(Text × SurfaceFn, #(name, f), Cons(e, rest))) -> (rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f) from match h {
    }
  }
}

pub theorem vs_failing(env: RowEnv, sig: List(Text × List(Text)), ranks: List(Text × Nat), fns: List(Text × SurfaceFn), h: vr_failing(env, sig, ranks, fns) = Nil): ∀ name: Text. ∀ f: SurfaceFn. (Mem(Text × SurfaceFn, #(name, f), fns)) -> (rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f) {
  match fns {
    Nil => name => f => m => Mem::nil((rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f), m)
    Cons(e, rest) => vs_failing_step(env, sig, ranks, e, rest, rr_unchecked(e.snd) || vr_function(env, sig, ranks, e.fst, e.snd), h, Refl, h2 => vs_failing(env, sig, ranks, rest, h2))
  }
}

pub theorem vs_failing_cons(
  env: RowEnv,
  sig: List(Text × List(Text)),
  ranks: List(Text × Nat),
  e: Text × SurfaceFn,
  rest: List(Text × SurfaceFn),
  here: (rr_unchecked(e.snd) = false) -> FunctionRowOk(env, sig, ranks, e.fst, e.snd),
  later: ∀ name: Text. ∀ f: SurfaceFn. (Mem(Text × SurfaceFn, #(name, f), rest)) -> (rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f)
): ∀ name: Text. ∀ f: SurfaceFn. (Mem(Text × SurfaceFn, #(name, f), Cons(e, rest))) -> (rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f) {
  name => f => m => ⊢ (rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f) from match m {
    MemHere(t) => here
    MemThere(b, t, m2) => later(name, f, m2)
  }
}

pub theorem vs_functions(env: RowEnv, sig: List(Text × List(Text)), ranks: List(Text × Nat), h: vr_failing(env, sig, ranks, Ordmap::entries(rr_fns(env))) = Nil): FunctionRowsOk(env, sig, ranks) {
  FunctionRowsOkMk(name => f => d => ⊢ (rr_unchecked(f) = false) -> FunctionRowOk(env, sig, ranks, name, f) from match d {
    FunctionDeclMk(found) => vs_failing(env, sig, ranks, Ordmap::entries(rr_fns(env)), h, name, f, vs_tree_get(Ordmap::tree(rr_fns(env)), name, f, Nil, found))
  })
}

// ---- the top level -------------------------------------------------------------------

pub theorem vs_top_effect(e: Text, h: Text::eq(e, "div") || Text::eq(e, "budget") || Text::eq(e, "budget_memory") || Text::eq(e, "test") || Text::eq(e, "spawn") || vr_has(rows_host_effects(), e) = true): TopEffect(e) {
  vs_or_split(
    Text::eq(e, "div") || Text::eq(e, "budget") || Text::eq(e, "budget_memory") || Text::eq(e, "test") || Text::eq(e, "spawn"),
    vr_has(rows_host_effects(), e),
    h,
    l5 => vs_or_split(
      Text::eq(e, "div") || Text::eq(e, "budget") || Text::eq(e, "budget_memory") || Text::eq(e, "test"),
      Text::eq(e, "spawn"),
      l5,
      l4 => vs_or_split(
        Text::eq(e, "div") || Text::eq(e, "budget") || Text::eq(e, "budget_memory"),
        Text::eq(e, "test"),
        l4,
        l3 => vs_or_split(
          Text::eq(e, "div") || Text::eq(e, "budget"),
          Text::eq(e, "budget_memory"),
          l3,
          l2 => vs_or_split(
            Text::eq(e, "div"),
            Text::eq(e, "budget"),
            l2,
            d => Eq::subst((z: Text) => TopEffect(z), Eq::sym(text_eq_sound(e, "div", d)), TopDiv),
            bu => Eq::subst((z: Text) => TopEffect(z), Eq::sym(text_eq_sound(e, "budget", bu)), TopBudget)
          ),
          bm => Eq::subst((z: Text) => TopEffect(z), Eq::sym(text_eq_sound(e, "budget_memory", bm)), TopBudgetMemory)
        ),
        t => Eq::subst((z: Text) => TopEffect(z), Eq::sym(text_eq_sound(e, "test", t)), TopTest)
      ),
      sp => Eq::subst((z: Text) => TopEffect(z), Eq::sym(text_eq_sound(e, "spawn", sp)), TopSpawn)
    ),
    hh => TopHost(e, vs_has_sound(rows_host_effects(), e, hh))
  )
}

pub theorem vs_top_effects(es: List(Text), h: vr_top_effects(es) = true): ∀ e: Text. (Mem(Text, e, es)) -> TopEffect(e) {
  match es {
    Nil => e => m => Mem::nil(TopEffect(e), m)
    Cons(x, rest) => e => m => ⊢ TopEffect(e) from match m {
      MemHere(t) => vs_top_effect(x, Bool::and_true_left(Text::eq(x, "div") || Text::eq(x, "budget") || Text::eq(x, "budget_memory") || Text::eq(x, "test") || Text::eq(x, "spawn") || vr_has(rows_host_effects(), x), vr_top_effects(rest), h))
      MemThere(b, t, m2) => vs_top_effects(rest, Bool::and_true_right(Text::eq(x, "div") || Text::eq(x, "budget") || Text::eq(x, "budget_memory") || Text::eq(x, "test") || Text::eq(x, "spawn") || vr_has(rows_host_effects(), x), vr_top_effects(rest), h), e, m2)
    }
  }
}

pub theorem vs_only_wait(es: List(Text), h: vr_only_wait(es) = true): ∀ e: Text. (Mem(Text, e, es)) -> e = "wait" {
  match es {
    Nil => e => m => Mem::nil(e = "wait", m)
    Cons(x, rest) => e => m => ⊢ e = "wait" from match m {
      MemHere(t) => text_eq_sound(x, "wait", Bool::and_true_left(Text::eq(x, "wait"), vr_only_wait(rest), h))
      MemThere(b, t, m2) => vs_only_wait(rest, Bool::and_true_right(Text::eq(x, "wait"), vr_only_wait(rest), h), e, m2)
    }
  }
}

pub theorem vs_extern_row(es: Option(List(Text)), h: vr_extern_row(es) = true): ExternRowOk(es) {
  match es {
    None => ExternRowNone
    Some(row) => ExternRowWait(row, vs_only_wait(row, h))
  }
}

pub theorem vs_extern_rows(fs: List(SurfaceFn), h: vr_extern_rows(fs) = true): ∀ f: SurfaceFn. (Mem(SurfaceFn, f, fs)) -> ExternRowOk(rr_effects(f)) {
  match fs {
    Nil => f => m => Mem::nil(ExternRowOk(rr_effects(f)), m)
    Cons(x, rest) => f => m => ⊢ ExternRowOk(rr_effects(f)) from match m {
      MemHere(t) => vs_extern_row(rr_effects(x), Bool::and_true_left(vr_extern_row(rr_effects(x)), vr_extern_rows(rest), h))
      MemThere(b, t, m2) => vs_extern_rows(rest, Bool::and_true_right(vr_extern_row(rr_effects(x)), vr_extern_rows(rest), h), f, m2)
    }
  }
}

pub theorem vs_top_value_step(
  env: RowEnv,
  sig: List(Text × List(Text)),
  locals: List(RowName),
  st: SurfaceStmt,
  t: SurfaceTerm,
  rest: List(SurfaceStmt),
  next: List(RowName),
  tvo: TopValueOf(st, t),
  binds: TopBinds(env, sig, locals, st, next),
  o: Option(List(Text)),
  h: (⊢ Bool from match o {
    None => false
    Some(r) => vr_top_effects(r)
  }) = true,
  vt: vr_term(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, t) = o,
  more: TopRowsOk(env, sig, next, rest)
): TopRowsOk(env, sig, locals, Cons(st, rest)) {
  match o {
    None => vs_absurd(false, h, Refl)
    Some(r) => TopValue(st, t, tvo, vs_term(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, t, r, vt), vs_top_effects(r, h), binds, more)
  }
}

pub theorem vs_top_keep_step(
  env: RowEnv,
  sig: List(Text × List(Text)),
  locals: List(RowName),
  st: SurfaceStmt,
  t: SurfaceTerm,
  tvo: TopValueOf(st, t),
  rest: List(SurfaceStmt),
  next: List(RowName),
  binds: TopBinds(env, sig, locals, st, next),
  b: Bool,
  h: vr_top_keep(b, t, vr_top_failing(env, sig, next, rest)) = Nil,
  ok: vr_top_value(env, sig, locals, t) = b,
  ih: (vr_top_failing(env, sig, next, rest) = Nil) -> TopRowsOk(env, sig, next, rest)
): TopRowsOk(env, sig, locals, Cons(st, rest)) {
  match b {
    true => vs_top_value_step(env, sig, locals, st, t, rest, next, tvo, binds, vr_term(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, t), ok, Refl, ih(h))
    false => ⊢ TopRowsOk(env, sig, locals, Cons(st, rest)) from match h {
    }
  }
}

pub theorem vs_top_extern_step(
  env: RowEnv,
  sig: List(Text × List(Text)),
  locals: List(RowName),
  fs: List(SurfaceFn),
  instances: List(SurfaceConstraint),
  types: List(SurfaceData),
  structs: List(SurfaceData),
  enums: List(SurfaceData),
  a: Nat,
  bb: Nat,
  rest: List(SurfaceStmt),
  b: Bool,
  h: (⊢ List(SurfaceTerm) from match b {
    true => vr_top_failing(env, sig, locals, rest)
    false => Cons(surface_term_mk(SkOther("extern"), a, bb), vr_top_failing(env, sig, locals, rest))
  }) = Nil,
  ok: vr_extern_rows(fs) = b,
  ih: (vr_top_failing(env, sig, locals, rest) = Nil) -> TopRowsOk(env, sig, locals, rest)
): TopRowsOk(env, sig, locals, Cons(StExtern(fs, instances, types, structs, enums, a, bb), rest)) {
  match b {
    true => TopExtern(fs, instances, types, structs, enums, a, bb, vs_extern_rows(fs, ok), ih(h))
    false => ⊢ TopRowsOk(env, sig, locals, Cons(StExtern(fs, instances, types, structs, enums, a, bb), rest)) from match h {
    }
  }
}

pub theorem vs_top_other(
  env: RowEnv,
  sig: List(Text × List(Text)),
  locals: List(RowName),
  st: SurfaceStmt,
  rest: List(SurfaceStmt),
  not_value: ∀ t: SurfaceTerm. (TopValueOf(st, t)) -> False,
  not_extern: ∀ fs: List(SurfaceFn). ∀ instances: List(SurfaceConstraint). ∀ types: List(SurfaceData). ∀ structs: List(SurfaceData). ∀ enums: List(SurfaceData). ∀ a: Nat. ∀ b: Nat. (st = StExtern(fs, instances, types, structs, enums, a, b)) -> False,
  more: TopRowsOk(env, sig, locals, rest)
): TopRowsOk(env, sig, locals, Cons(st, rest)) {
  TopOther(st, TopRunsNothingMk(not_value, not_extern), more)
}

pub theorem vs_top(env: RowEnv, sig: List(Text × List(Text)), locals: List(RowName), program: List(SurfaceStmt), h: vr_top_failing(env, sig, locals, program) = Nil): TopRowsOk(env, sig, locals, program) {
  match program {
    Nil => TopNil(locals)
    Cons(st, rest) => ⊢ TopRowsOk(env, sig, locals, Cons(st, rest)) from match st {
      StLet(name, ty, value, b, m, unused, st_stack) => vs_top_keep_step(env, sig, locals, StLet(name, ty, value, b, m, unused, st_stack), value, TopLet(name, ty, value, b, m, unused, st_stack), rest, Cons(RowName::Mk(name, vr_bound_latent(value, vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value))), locals), TopBindsLet(locals, name, ty, value, b, m, unused, st_stack, vr_bound_latent(value, vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value)), vs_bl(env, sig, Nil, RankLimit::Mk(Nil, None, Nil), locals, value, vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value), (lr: List(Text)) => (le: vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value) = Some(lr)) => vs_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value, lr, le))), vr_top_value(env, sig, locals, value), h, Refl, h2 => vs_top(env, sig, Cons(RowName::Mk(name, vr_bound_latent(value, vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value))), locals), rest, h2))
      StVar(name, ty, value, b, unused, st_stack) => vs_top_keep_step(env, sig, locals, StVar(name, ty, value, b, unused, st_stack), value, TopVar(name, ty, value, b, unused, st_stack), rest, Cons(RowName::Mk(name, vr_bound_latent(value, vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value))), locals), TopBindsVar(locals, name, ty, value, b, unused, st_stack, vr_bound_latent(value, vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value)), vs_bl(env, sig, Nil, RankLimit::Mk(Nil, None, Nil), locals, value, vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value), (lr: List(Text)) => (le: vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value) = Some(lr)) => vs_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value, lr, le))), vr_top_value(env, sig, locals, value), h, Refl, h2 => vs_top(env, sig, Cons(RowName::Mk(name, vr_bound_latent(value, vr_lambda(VrCtx::Mk(env, sig, Nil, RankLimit::Mk(Nil, None, Nil)), locals, value))), locals), rest, h2))
      StExpr(e) => vs_top_keep_step(env, sig, locals, StExpr(e), e, TopExpr(e), rest, locals, TopBindsExpr(locals, e), vr_top_value(env, sig, locals, e), h, Refl, h2 => vs_top(env, sig, locals, rest, h2))
      StExtern(fs, instances, types, structs, enums, a, bb) => vs_top_extern_step(
        env,
        sig,
        locals,
        fs,
        instances,
        types,
        structs,
        enums,
        a,
        bb,
        rest,
        vr_extern_rows(fs),
        h,
        Refl,
        h2 => vs_top(env, sig, locals, rest, h2)
      )
      StAssign(n, place, value) => vs_top_other(env, sig, locals, StAssign(n, place, value), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StCalled(g, cc) => vs_top_other(env, sig, locals, StCalled(g, cc), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StFn(f) => vs_top_other(env, sig, locals, StFn(f), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StTheorem(tt) => vs_top_other(env, sig, locals, StTheorem(tt), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StDef(tt) => vs_top_other(env, sig, locals, StDef(tt), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StMutual(ss, a, bb) => vs_top_other(env, sig, locals, StMutual(ss, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StImport(p, a, bb) => vs_top_other(env, sig, locals, StImport(p, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StInductive(i) => vs_top_other(env, sig, locals, StInductive(i), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StEffect(e) => vs_top_other(env, sig, locals, StEffect(e), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StStruct(d) => vs_top_other(env, sig, locals, StStruct(d), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StEnum(d) => vs_top_other(env, sig, locals, StEnum(d), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StClass(cc) => vs_top_other(env, sig, locals, StClass(cc), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StInstance(i) => vs_top_other(env, sig, locals, StInstance(i), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StWhile(cond, body) => vs_top_other(env, sig, locals, StWhile(cond, body), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StReturn(v) => vs_top_other(env, sig, locals, StReturn(v), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StOther(w, a, bb) => vs_top_other(env, sig, locals, StOther(w, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StLoop(st_body, a, bb) => vs_top_other(env, sig, locals, StLoop(st_body, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StModule(mod_name, mod_vis, mod_items, a, bb) => vs_top_other(env, sig, locals, StModule(mod_name, mod_vis, mod_items, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StReexport(re_path, re_names, re_spans, a, bb) => vs_top_other(env, sig, locals, StReexport(re_path, re_names, re_spans, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StFor(for_pat, for_src, st_body, a, bb) => vs_top_other(env, sig, locals, StFor(for_pat, for_src, st_body, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StBreak(st_value, a, bb) => vs_top_other(env, sig, locals, StBreak(st_value, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StContinue(a, bb) => vs_top_other(env, sig, locals, StContinue(a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StMacro(n, f, a, bb) => vs_top_other(env, sig, locals, StMacro(n, f, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StSyntax(n, g, a, bb) => vs_top_other(env, sig, locals, StSyntax(n, g, a, bb), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
      StAttributed(n, arg, g, inner) => vs_top_other(env, sig, locals, StAttributed(n, arg, g, inner), rest, t => tv => ⊢ False from match tv {
      }, fs => instances => types => structs => enums => a1 => b1 => e1 => ⊢ False from match e1 {
      }, vs_top(env, sig, locals, rest, h))
    }
  }
}

// ---- the program -----------------------------------------------------------------------

pub theorem vs_append_nil<A: Type>(a: List(A), b: List(A), h: List::append(a, b) = Nil): a = Nil ∧ b = Nil {
  match a {
    Nil => AndIntro(Refl, h)
    Cons(x, t) => ⊢ Cons(x, t) = Nil ∧ b = Nil from match h {
    }
  }
}

pub theorem vs_fn_errors_nil(fs: List(SurfaceFn), h: vr_fn_errors(fs) = Nil): fs = Nil {
  match fs {
    Nil => Refl
    Cons(f, rest) => ⊢ Cons(f, rest) = Nil from match h {
    }
  }
}

pub theorem vs_top_errors_nil(ts: List(SurfaceTerm), h: vr_top_errors(ts) = Nil): ts = Nil {
  match ts {
    Nil => Refl
    Cons(t, rest) => ⊢ Cons(t, rest) = Nil from match h {
    }
  }
}

// When the prelude's functions pass the check, their rows are derivable in
// the prelude's environment.
pub theorem vs_prelude(prelude: List(SurfaceStmt), h: vr_fn_errors(rp_failing(rows_prelude(prelude))) = Nil): FunctionRowsOk(vr_env_sets(rp_env(rows_prelude(prelude))), rp_sig(rows_prelude(prelude)), rp_ranks(rows_prelude(prelude))) {
  vs_functions(
    vr_env_sets(rp_env(rows_prelude(prelude))),
    rp_sig(rows_prelude(prelude)),
    rp_ranks(rows_prelude(prelude)),
    vs_fn_errors_nil(rp_failing(rows_prelude(prelude)), h)
  )
}

// When the program's own functions pass the check, their rows are derivable.
pub theorem vs_own(env: RowEnv, sig: List(Text × List(Text)), ranks: List(Text × Nat), own: Ordmap(Text, SurfaceFn), h: vr_failing(env, sig, ranks, Ordmap::entries(own)) = Nil): OwnRowsOk(own, env, sig, ranks) {
  OwnRowsOkMk(name => f => found => vs_failing(env, sig, ranks, Ordmap::entries(own), h, name, f, vs_tree_get(Ordmap::tree(own), name, f, Nil, found)))
}

pub theorem vs_own_and_tops(env: RowEnv, sig: List(Text × List(Text)), ranks: List(Text × Nat), own: Ordmap(Text, SurfaceFn), program: List(SurfaceStmt), h: vr_errors_own(env, sig, ranks, own, program) = Nil): OwnRowsOk(own, env, sig, ranks) ∧ TopRowsOk(env, sig, Nil, program) {
  let both: vr_fn_errors(vr_failing(env, sig, ranks, Ordmap::entries(own))) = Nil ∧ vr_top_errors(vr_top_failing(env, sig, Nil, program)) = Nil := vs_append_nil(
    vr_fn_errors(vr_failing(env, sig, ranks, Ordmap::entries(own))),
    vr_top_errors(vr_top_failing(env, sig, Nil, program)),
    h
  )
  AndIntro(
    vs_own(env, sig, ranks, own, vs_fn_errors_nil(vr_failing(env, sig, ranks, Ordmap::entries(own)), And::left(both))),
    vs_top(env, sig, Nil, program, vs_top_errors_nil(vr_top_failing(env, sig, Nil, program), And::right(both)))
  )
}

// When the check after the prelude finds no error, the program's rows are
// derivable.
pub theorem vs_after(prelude: List(SurfaceStmt), env: RowEnv, sig: List(Text × List(Text)), own: Ordmap(Text, SurfaceFn), program: List(SurfaceStmt), h: vr_errors_after(rows_prelude(prelude), env, sig, own, program) = Nil): ProgramRows(vr_env_sets(rp_env(rows_prelude(prelude))), own, env, program) {
  let both: vr_fn_errors(rp_failing(rows_prelude(prelude))) = Nil ∧ vr_errors_own(env, List::append(sig, rp_sig(rows_prelude(prelude))), vr_own_ranks(env, List::append(sig, rp_sig(rows_prelude(prelude))), rp_ranks(rows_prelude(prelude)), own), own, program) = Nil := vs_append_nil(
    vr_fn_errors(rp_failing(rows_prelude(prelude))),
    vr_errors_own(env, List::append(sig, rp_sig(rows_prelude(prelude))), vr_own_ranks(env, List::append(sig, rp_sig(rows_prelude(prelude))), rp_ranks(rows_prelude(prelude)), own), own, program),
    h
  )
  ProgramRowsMk(
    rp_sig(rows_prelude(prelude)),
    rp_ranks(rows_prelude(prelude)),
    vs_prelude(prelude, And::left(both)),
    sig,
    vr_own_ranks(env, List::append(sig, rp_sig(rows_prelude(prelude))), rp_ranks(rows_prelude(prelude)), own),
    And::left(vs_own_and_tops(env, List::append(sig, rp_sig(rows_prelude(prelude))), vr_own_ranks(env, List::append(sig, rp_sig(rows_prelude(prelude))), rp_ranks(rows_prelude(prelude)), own), own, program, And::right(both))),
    And::right(vs_own_and_tops(env, List::append(sig, rp_sig(rows_prelude(prelude))), vr_own_ranks(env, List::append(sig, rp_sig(rows_prelude(prelude))), rp_ranks(rows_prelude(prelude)), own), own, program, And::right(both)))
  )
}

pub fn vs_errors_of(report: RowReport): List(RowDiagnostic) {
  report.errors
}

pub theorem vs_verified(prelude: List(SurfaceStmt), env: RowEnv, program: List(SurfaceStmt), report: RowReport, h: vs_errors_of(rows_verified(rows_prelude(prelude), env, program, report)) = Nil): ProgramRows(vr_env_sets(rp_env(rows_prelude(prelude))), vr_own_sets(env, rows_own_fns(program)), vr_env_sets(env), program) {
  match report {
    Mk(functions, errors, calls, quants) => ⊢ ProgramRows(vr_env_sets(rp_env(rows_prelude(prelude))), vr_own_sets(env, rows_own_fns(program)), vr_env_sets(env), program) from match errors {
      Nil => vs_after(prelude, vr_env_sets(env), vr_sig_sets(env, vr_sig_of(env, functions)), vr_own_sets(env, rows_own_fns(program)), program, h)
      Cons(e, rest) => ⊢ ProgramRows(vr_env_sets(rp_env(rows_prelude(prelude))), vr_own_sets(env, rows_own_fns(program)), vr_env_sets(env), program) from match h {
      }
    }
  }
}

// The report of the effect layer: when it holds no error, the rows of the
// program are derivable by the rules of `rules_rows.taut`, each set of
// effects a written row names read as the effects in it. The prelude's
// functions are checked once, in the prelude's environment
// (`rows_prelude`); the program's own, in the program's.
pub theorem rows_check_sound(prelude: List(SurfaceStmt), program: List(SurfaceStmt), h: vs_errors_of(rows_check(prelude, program)) = Nil): ProgramRows(vr_env_sets(rows_env(prelude, Nil)), vr_own_sets(rows_env(prelude, program), rows_own_fns(program)), vr_env_sets(rows_env(prelude, program)), program) {
  vs_verified(prelude, rows_env(prelude, program), program, rows_check_env(rows_env(prelude, program), program), h)
}

// The same for a program whose operators are known, with its prelude checked
// by `rows_prelude`.
pub theorem rows_check_with_sound(prelude: List(SurfaceStmt), ops: Ordmap(RowSpan, Text), program: List(SurfaceStmt), h: vs_errors_of(rows_check_with(rows_prelude(prelude), ops, prelude, program)) = Nil): ProgramRows(vr_env_sets(rows_env(prelude, Nil)), vr_own_sets(rows_env_with_ops(rows_env(prelude, program), ops), rows_own_fns(program)), vr_env_sets(rows_env_with_ops(rows_env(prelude, program), ops)), program) {
  vs_verified(prelude, rows_env_with_ops(rows_env(prelude, program), ops), program, rows_check_env(rows_env_with_ops(rows_env(prelude, program), ops), program), h)
}
