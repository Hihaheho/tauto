      SurfaceTermIndexedMk(kind, start, end, occ) => vs_latent_kind(c, locals, kind, start, end, occ, r, h)
    }
  }

  pub theorem vs_latent_kind(c: VrCtx, locals: List(RowName), kind: SurfaceKind, start: Nat, end: Nat, occ: Option(TermOccurrence), r: List(Text), h: vr_latent_kind(c, locals, kind) = Some(r)): LatentPerforms(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, SurfaceTermIndexedMk(kind, start, end, occ), r) {
    match kind {
      SkLam(ps, body, types, unused) => LatentLambda(
        SurfaceTermIndexedMk(SkLam(ps, body, types, unused), start, end, occ),
        LambdaPlain(occ, ps, body, types, unused, start, end, vs_unknown(ps, locals), vs_term(c, vr_unknown(ps, locals), body, r, h))
      )
      SkBorrowLam(bs, lam) => LatentLambda(SurfaceTermIndexedMk(SkBorrowLam(bs, lam), start, end, occ), LambdaBorrows(occ, bs, lam, start, end, vs_lambda(c, locals, lam, r, h)))
      SkBorrow(m, m_orig, x) => LatentBorrow(occ, m, m_orig, x, start, end, vs_latent(c, locals, x, r, h))
      SkVar(n) => vs_latent_name(c, locals, n, start, end, occ, r, h)
      _ => vs_no_some(r, h)
    }
  }

  pub theorem vs_latents(c: VrCtx, locals: List(RowName), args: List(SurfaceTerm)): VsLatents(vr_env(c), vr_sig(c), vr_dvars(c), vr_lim(c), locals, args, vr_latents(c, locals, args)) {
