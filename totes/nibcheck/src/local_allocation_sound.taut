import "instantiation_allocation_sound.taut"
import "local_lookup_sound.taut"
import std::Base
import std::Nat
import std::Text
import "allocation_advance.taut"
import "allocation_result.taut"
import "allocation_state.taut"
import "checker.taut"
import "fits_sound.taut"
import "pattern_scope.taut"
import "rules_local.taut"
import "ty.taut"
