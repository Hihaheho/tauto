pub theorem access_hint_arity_frame_checked(
  c: Checker,
  ps: List(Ty),
  hs: List(Ty),
  same: Bool,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_hint_arity(c, ps, hs, same)) {
  match same: CkCheckedFrame(c, access_hint_arity(c, ps, hs, same)) {
    true => checked_frame_rewrap(
      c,
      ck_lambda_hint(ps, c, hs),
      ck_lambda_hint_run_frame_checked(ps, c, hs, ordered)
    )
    false => checked_frame_return(c, Star, ordered)
  }
}

pub theorem access_hint_type_frame_checked(
  c: Checker,
  ps: List(Ty),
  t: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_hint_type(c, ps, t)) {
  match t: CkCheckedFrame(c, access_hint_type(c, ps, t)) {
    TyInt(pat_w) => checked_frame_return(c, Star, ordered)
    TyBool => checked_frame_return(c, Star, ordered)
    TyText => checked_frame_return(c, Star, ordered)
    TyUnit => checked_frame_return(c, Star, ordered)
    TyNever => checked_frame_return(c, Star, ordered)
    TyDecimal => checked_frame_return(c, Star, ordered)
    TyFloat => checked_frame_return(c, Star, ordered)
    TyFn(hs, r, fk) => access_hint_arity_frame_checked(
      c,
      ps,
      hs,
      Nat::eq(list_len(hs), list_len(ps)),
      ordered
    )
    TyUnion(pat_members) => checked_frame_return(c, Star, ordered)
    TyProduct(pat_members) => checked_frame_return(c, Star, ordered)
    TyTagged(pat_tags, pat_inner) => checked_frame_return(c, Star, ordered)
    TyNamed(pat_name, pat_args) => checked_frame_return(c, Star, ordered)
    TyParam(pat_name, pat_bound) => checked_frame_return(c, Star, ordered)
    TyInfo(pat_inner) => checked_frame_return(c, Star, ordered)
    TyBorrow(pat_inner, pat_mutable) => checked_frame_return(c, Star, ordered)
    TyVar(pat_v) => checked_frame_return(c, Star, ordered)
    TyPoly(pat_generics, pat_inner) => checked_frame_return(c, Star, ordered)
    TyApp(pat_head, pat_arg) => checked_frame_return(c, Star, ordered)
  }
}

pub theorem access_hint_frame_checked(
  c: Checker,
  ps: List(Ty),
  hint: Option(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_hint(c, ps, hint)) {
  match hint: CkCheckedFrame(c, access_hint(c, ps, hint)) {
    None => checked_frame_return(c, Star, ordered)
    Some(h) => access_hint_type_frame_checked(c, ps, ty_unborrowed(ck_resolve(c, h)), ordered)
  }
}

pub theorem ck_lambda_hint_of_run_frame_checked(
  c: Checker,
  hint: Option(Ty),
  ps: List(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_lambda_hint_of(c, hint, ps)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_hint_unf(c, hint, ps)),
    access_hint_frame_checked(c, ps, hint, ordered)
  )
}

pub theorem access_join_frame_checked(
  c: Checker,
  b: Ty,
  result: Option(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_join(c, b, result)) {
  match result: CkCheckedFrame(c, access_join(c, b, result)) {
    None => checked_frame_return(c, b, ordered)
    Some(r) => checked_frame_rewrap(
      c,
      ck_join(c, r, b),
      ck_join_run_frame_checked(c, r, b, ordered)
    )
  }
}

pub theorem ck_join_opt_run_frame_checked(
  c: Checker,
  result: Option(Ty),
  b: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_join_opt(c, result, b)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_join_unf(c, result, b)),
    access_join_frame_checked(c, b, result, ordered)
  )
}

pub theorem ck_instance_of_run_frame_checked(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_instance_of(gs, c)) {
  checked_frame_grows(c, ck_instance_of(gs, c), And::left(inst_ok(gs, c))(ordered))
}
pub theorem access_poly_frame_checked(
  c: Checker,
  function: SurfaceTerm,
  original: Ty,
  f: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_poly(c, function, original, f)) {
  match f: CkCheckedFrame(c, access_poly(c, function, original, f)) {
    TyInt(pat_w) => checked_frame_return(c, original, ordered)
    TyBool => checked_frame_return(c, original, ordered)
    TyText => checked_frame_return(c, original, ordered)
    TyUnit => checked_frame_return(c, original, ordered)
    TyNever => checked_frame_return(c, original, ordered)
    TyDecimal => checked_frame_return(c, original, ordered)
    TyFloat => checked_frame_return(c, original, ordered)
    TyFn(pat_params, pat_result, pat_kind) => checked_frame_return(c, original, ordered)
    TyUnion(pat_members) => checked_frame_return(c, original, ordered)
    TyProduct(pat_members) => checked_frame_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => checked_frame_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => checked_frame_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => checked_frame_return(c, original, ordered)
    TyInfo(pat_inner) => checked_frame_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => checked_frame_return(c, original, ordered)
    TyVar(pat_v) => checked_frame_return(c, original, ordered)
    TyPoly(gs, t) => checked_frame_bind(
      Ordmap(Text, Ty),
      Ty,
      c,
      (fresh: Ordmap(Text, Ty), c1: Checker) => frame_bind(
        Unit,
        Ty,
        (ignored: Unit, c2: Checker) => mut1(ty_substitute(t, fresh), c2),
        access_record_term(c1, function, ty_substitute(t, fresh))
      ),
      ck_instance_of(gs, c),
      ck_instance_of_run_frame_checked(gs, c, ordered),
      fresh => c1 => o_c1 => checked_frame_bind(
        Unit,
        Ty,
        c1,
        (ignored: Unit, c2: Checker) => mut1(ty_substitute(t, fresh), c2),
        access_record_term(c1, function, ty_substitute(t, fresh)),
        checked_frame_read(
          c1,
          access_record_term(c1, function, ty_substitute(t, fresh)),
          access_record_term_frame(c1, function, ty_substitute(t, fresh)),
          access_record_term_frame_errors(c1, function, ty_substitute(t, fresh)),
          o_c1
        ),
        ignored => c2 => o_c2 => checked_frame_return(c2, ty_substitute(t, fresh), o_c2)
      )
    )
    TyApp(pat_head, pat_arg) => checked_frame_return(c, original, ordered)
  }
}

pub theorem ck_poly_instance_run_frame_checked(
  c: Checker,
  function: SurfaceTerm,
  f: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_poly_instance(c, function, f)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_poly_unf(c, function, f)),
    access_poly_frame_checked(c, function, f, ck_resolve(c, f), ordered)
  )
}
