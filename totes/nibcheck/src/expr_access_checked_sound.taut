pub theorem access_hint_arity_frame_checked(
  c: Checker,
  ps: List(Ty),
  hs: List(Ty),
  same: Bool,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_hint_arity(c, ps, hs, same)) {
  match same {
    true => checked_frame_rewrap(
      c,
      ck_lambda_hint(ps, c, hs),
      ck_lambda_hint_run_frame_checked(ps, c, hs, ordered)
    )
    false => checked_frame_return(c, Star, ordered)
  }
}

pub theorem access_hint_type_frame_checked(
  c: Checker,
  ps: List(Ty),
  t: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_hint_type(c, ps, t)) {
  match t {
    TyInt(pat_w) => checked_frame_return(c, Star, ordered)
    TyBool => checked_frame_return(c, Star, ordered)
    TyText => checked_frame_return(c, Star, ordered)
    TyUnit => checked_frame_return(c, Star, ordered)
    TyNever => checked_frame_return(c, Star, ordered)
    TyDecimal => checked_frame_return(c, Star, ordered)
    TyFloat => checked_frame_return(c, Star, ordered)
    TyFloat32 => checked_frame_return(c, Star, ordered)
    TyFn(hs, r, fk) => access_hint_arity_frame_checked(
      c,
      ps,
      hs,
      Nat::eq(list_len(hs), list_len(ps)),
      ordered
    )
    TyUnion(pat_members) => checked_frame_return(c, Star, ordered)
    TyProduct(pat_members) => checked_frame_return(c, Star, ordered)
    TyTagged(pat_tags, pat_inner) => checked_frame_return(c, Star, ordered)
    TyNamed(pat_name, pat_args) => checked_frame_return(c, Star, ordered)
    TyParam(pat_name, pat_bound) => checked_frame_return(c, Star, ordered)
    TyInfo(pat_inner) => checked_frame_return(c, Star, ordered)
    TyBorrow(pat_inner, pat_mutable) => checked_frame_return(c, Star, ordered)
    TyVar(pat_v) => checked_frame_return(c, Star, ordered)
    TyPoly(pat_generics, pat_inner) => checked_frame_return(c, Star, ordered)
    TyApp(pat_head, pat_arg) => checked_frame_return(c, Star, ordered)
  }
}

pub theorem access_hint_frame_checked(
  c: Checker,
  ps: List(Ty),
  hint: Option(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_hint(c, ps, hint)) {
  match hint {
    None => checked_frame_return(c, Star, ordered)
    Some(h) => access_hint_type_frame_checked(c, ps, ty_unborrowed(ck_resolve(c, h)), ordered)
  }
}

pub theorem ck_lambda_hint_of_run_frame_checked(
  c: Checker,
  hint: Option(Ty),
  ps: List(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_lambda_hint_of(c, hint, ps)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_hint_unf(c, hint, ps)),
    access_hint_frame_checked(c, ps, hint, ordered)
  )
}

pub theorem access_join_frame_checked(
  c: Checker,
  b: Ty,
  result: Option(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_join(c, b, result)) {
  match result {
    None => checked_frame_return(c, b, ordered)
    Some(r) => checked_frame_rewrap(
      c,
      ck_join(c, r, b),
      ck_join_run_frame_checked(c, r, b, ordered)
    )
  }
}

pub theorem ck_join_opt_run_frame_checked(
  c: Checker,
  result: Option(Ty),
  b: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_join_opt(c, result, b)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_join_unf(c, result, b)),
    access_join_frame_checked(c, b, result, ordered)
  )
}

pub theorem ck_instance_of_run_frame_checked(
  gs: List(Text × Kind),
  c: Checker,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_instance_of(gs, c)) {
  checked_frame_grows(c, ck_instance_of(gs, c), And::left(inst_ok(gs, c))(ordered))
}
pub theorem access_poly_frame_checked(
  c: Checker,
  function: SurfaceTerm,
  original: Ty,
  f: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_poly(c, function, original, f)) {
  match f {
    TyInt(pat_w) => checked_frame_return(c, original, ordered)
    TyBool => checked_frame_return(c, original, ordered)
    TyText => checked_frame_return(c, original, ordered)
    TyUnit => checked_frame_return(c, original, ordered)
    TyNever => checked_frame_return(c, original, ordered)
    TyDecimal => checked_frame_return(c, original, ordered)
    TyFloat => checked_frame_return(c, original, ordered)
    TyFloat32 => checked_frame_return(c, original, ordered)
    TyFn(pat_params, pat_result, pat_kind) => checked_frame_return(c, original, ordered)
    TyUnion(pat_members) => checked_frame_return(c, original, ordered)
    TyProduct(pat_members) => checked_frame_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => checked_frame_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => checked_frame_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => checked_frame_return(c, original, ordered)
    TyInfo(pat_inner) => checked_frame_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => checked_frame_return(c, original, ordered)
    TyVar(pat_v) => checked_frame_return(c, original, ordered)
    TyPoly(gs, t) => checked_frame_bind(
      <A: Ordmap(Text, Ty), B: Ty>,
      c,
      (fresh: Ordmap(Text, Ty), c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (ignored: Unit, c2: Checker) => mut1(ty_substitute(t, fresh), c2),
        access_record_term(c1, function, ty_substitute(t, fresh))
      ),
      ck_instance_of(gs, c),
      ck_instance_of_run_frame_checked(gs, c, ordered),
      fresh => c1 => o_c1 => checked_frame_bind(
        <A: Unit, B: Ty>,
        c1,
        (ignored: Unit, c2: Checker) => mut1(ty_substitute(t, fresh), c2),
        access_record_term(c1, function, ty_substitute(t, fresh)),
        checked_frame_read(
          c1,
          access_record_term(c1, function, ty_substitute(t, fresh)),
          access_record_term_frame(c1, function, ty_substitute(t, fresh)),
          access_record_term_frame_errors(c1, function, ty_substitute(t, fresh)),
          o_c1
        ),
        ignored => c2 => o_c2 => checked_frame_return(c2, ty_substitute(t, fresh), o_c2)
      )
    )
    TyApp(pat_head, pat_arg) => checked_frame_return(c, original, ordered)
  }
}

pub theorem ck_poly_instance_run_frame_checked(
  c: Checker,
  function: SurfaceTerm,
  f: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_poly_instance(c, function, f)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_poly_unf(c, function, f)),
    access_poly_frame_checked(c, function, f, ck_resolve(c, f), ordered)
  )
}

pub theorem access_named_implicit_frame_checked(
  c: Checker,
  fresh: Ordmap(Text, Ty),
  named: SurfaceField,
  found: Option(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_named_implicit(c, fresh, named, found)) {
  match found {
    Some(v) => checked_frame_bind(
      <A: Ty, B: Unit>,
      c,
      (want: Ty, c1: Checker) => ck_rewrap1(
        ck_expect(c1, want, v, span_of(named.value), what_argument_message())
      ),
      ck_written_here(c, named.value),
      checked_frame_read(c, ck_written_here(c, named.value), ck_written_here_frame(c, named.value), ck_written_here_frame_errors(c, named.value), ordered),
      want => c1 => o_c1 => checked_frame_rewrap(
        c1,
        ck_expect(c1, want, v, span_of(named.value), what_argument_message()),
        ck_expect_run_frame_checked(c1, want, v, span_of(named.value), what_argument_message(), o_c1)
      )
    )
    None => checked_frame_read(
      c,
      ck_error(c, no_type_argument_named_message(named.name), span_of(named.value)),
      ck_error_frame(c, no_type_argument_named_message(named.name), span_of(named.value)),
      ck_error_frame_errors(c, no_type_argument_named_message(named.name), span_of(named.value)),
      ordered
    )
  }
}

pub theorem ck_named_implicit_run_frame_checked(
  c: Checker,
  fresh: Ordmap(Text, Ty),
  named: SurfaceField,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_named_implicit(c, fresh, named)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_named_implicit_unf(c, fresh, named)),
    access_named_implicit_frame_checked(
      c,
      fresh,
      named,
      Ordmap::get(fresh, named.name, Ordmap::compare_text),
      ordered
    )
  )
}

pub theorem ck_named_implicits_run_frame_checked(
  c: Checker,
  fresh: Ordmap(Text, Ty),
  named: List(SurfaceField),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_named_implicits(c, fresh, named)) {
  match named {
    Nil => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkCheckedFrame(c, z),
      Eq::sym(access_named_implicits_unf(c, fresh, Nil)),
      checked_frame_return(c, (), ordered)
    )
    Cons(f, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkCheckedFrame(c, z),
      Eq::sym(access_named_implicits_unf(c, fresh, Cons(f, rest))),
      checked_frame_bind(
        <A: Unit, B: Unit>,
        c,
        (ignored: Unit, c1: Checker) => ck_rewrap1(ck_named_implicits(c1, fresh, rest)),
        ck_named_implicit(c, fresh, f),
        ck_named_implicit_run_frame_checked(c, fresh, f, ordered),
        ignored => c1 => o_c1 => checked_frame_rewrap(
          c1,
          ck_named_implicits(c1, fresh, rest),
          ck_named_implicits_run_frame_checked(c1, fresh, rest, o_c1)
        )
      )
    )
  }
}

pub theorem access_poly_named_frame_checked(
  c: Checker,
  function: SurfaceTerm,
  original: Ty,
  named: List(SurfaceField),
  f: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_poly_named(c, function, original, named, f)) {
  match f {
    TyInt(pat_w) => checked_frame_return(c, original, ordered)
    TyBool => checked_frame_return(c, original, ordered)
    TyText => checked_frame_return(c, original, ordered)
    TyUnit => checked_frame_return(c, original, ordered)
    TyNever => checked_frame_return(c, original, ordered)
    TyDecimal => checked_frame_return(c, original, ordered)
    TyFloat => checked_frame_return(c, original, ordered)
    TyFloat32 => checked_frame_return(c, original, ordered)
    TyFn(pat_params, pat_result, pat_kind) => checked_frame_return(c, original, ordered)
    TyUnion(pat_members) => checked_frame_return(c, original, ordered)
    TyProduct(pat_members) => checked_frame_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => checked_frame_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => checked_frame_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => checked_frame_return(c, original, ordered)
    TyInfo(pat_inner) => checked_frame_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => checked_frame_return(c, original, ordered)
    TyVar(pat_v) => checked_frame_return(c, original, ordered)
    TyPoly(gs, t) => checked_frame_bind(
      <A: Ordmap(Text, Ty), B: Ty>,
      c,
      (fresh: Ordmap(Text, Ty), c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (ignored: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (done: Unit, c3: Checker) => mut1(ty_substitute(t, fresh), c3),
          ck_named_implicits(c2, fresh, named)
        ),
        access_record_term(c1, function, ty_substitute(t, fresh))
      ),
      ck_instance_of(gs, c),
      ck_instance_of_run_frame_checked(gs, c, ordered),
      fresh => c1 => o_c1 => checked_frame_bind(
        <A: Unit, B: Ty>,
        c1,
        (ignored: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (done: Unit, c3: Checker) => mut1(ty_substitute(t, fresh), c3),
          ck_named_implicits(c2, fresh, named)
        ),
        access_record_term(c1, function, ty_substitute(t, fresh)),
        checked_frame_read(c1, access_record_term(c1, function, ty_substitute(t, fresh)), access_record_term_frame(c1, function, ty_substitute(t, fresh)), access_record_term_frame_errors(c1, function, ty_substitute(t, fresh)), o_c1),
        ignored => c2 => o_c2 => checked_frame_bind(
          <A: Unit, B: Ty>,
          c2,
          (done: Unit, c3: Checker) => mut1(ty_substitute(t, fresh), c3),
          ck_named_implicits(c2, fresh, named),
          ck_named_implicits_run_frame_checked(c2, fresh, named, o_c2),
          done => c3 => o_c3 => checked_frame_return(c3, ty_substitute(t, fresh), o_c3)
        )
      )
    )
    TyApp(pat_head, pat_arg) => checked_frame_return(c, original, ordered)
  }
}

pub theorem ck_poly_instance_named_run_frame_checked(
  c: Checker,
  function: SurfaceTerm,
  f: Ty,
  named: List(SurfaceField),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_poly_instance_named(c, function, f, named)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_poly_named_unf(c, function, f, named)),
    access_poly_named_frame_checked(c, function, f, named, ck_resolve(c, f), ordered)
  )
}

pub theorem access_top_level_frame_checked(
  c: Checker,
  plan: Option(Ordmap(Text, Ty) × List(SurfaceField)),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, access_top_level(c, plan)) {
  match plan {
    None => checked_frame_return(c, (), ordered)
    Some(p) => checked_frame_rewrap(
      c,
      ck_named_implicits(c, p.fst, p.snd),
      ck_named_implicits_run_frame_checked(c, p.fst, p.snd, ordered)
    )
  }
}

pub theorem ck_named_top_level_run_frame_checked(
  c: Checker,
  function: SurfaceTerm,
  inferred: Ty,
  named: List(SurfaceField),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_named_top_level(c, function, inferred, named)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(access_top_level_unf(c, function, inferred, named)),
    access_top_level_frame_checked(c, ck_named_top_plan(c, function, inferred, named), ordered)
  )
}

pub theorem ck_call_instance_run_frame_checked(
  c: Checker,
  function: SurfaceTerm,
  inferred: Ty,
  named: List(SurfaceField),
  hint: Option(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_call_instance(c, function, inferred, named, hint)) {
  checked_frame_bind(
    <A: Ty, B: Ty>,
    c,
    (f: Ty, c1: Checker) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c2: Checker) => frame_bind(
        <A: Bool, B: Ty>,
        (fixed: Bool, c3: Checker) => mut1(ck_named_constructor(ty_unborrowed(ck_resolve(c3, f)), f, named), c3),
        ck_attempt_unify(c2, ck_hint_left(c2, f, hint), ck_hint_right(c2, f, hint))
      ),
      ck_named_top_level(c1, function, inferred, named)
    ),
    ck_poly_instance_named(c, function, inferred, named),
    ck_poly_instance_named_run_frame_checked(c, function, inferred, named, ordered),
    f => c1 => o_c1 => checked_frame_bind(
      <A: Unit, B: Ty>,
      c1,
      (ignored: Unit, c2: Checker) => frame_bind(
        <A: Bool, B: Ty>,
        (fixed: Bool, c3: Checker) => mut1(ck_named_constructor(ty_unborrowed(ck_resolve(c3, f)), f, named), c3),
        ck_attempt_unify(c2, ck_hint_left(c2, f, hint), ck_hint_right(c2, f, hint))
      ),
      ck_named_top_level(c1, function, inferred, named),
      ck_named_top_level_run_frame_checked(c1, function, inferred, named, o_c1),
      ignored => c2 => o_c2 => checked_frame_bind(
        <A: Bool, B: Ty>,
        c2,
        (fixed: Bool, c3: Checker) => mut1(ck_named_constructor(ty_unborrowed(ck_resolve(c3, f)), f, named), c3),
        ck_attempt_unify(c2, ck_hint_left(c2, f, hint), ck_hint_right(c2, f, hint)),
        ck_attempt_unify_run_frame_checked(c2, ck_hint_left(c2, f, hint), ck_hint_right(c2, f, hint), o_c2),
        fixed => c3 => o_c3 => checked_frame_return(c3, ck_named_constructor(ty_unborrowed(ck_resolve(c3, f)), f, named), o_c3)
      )
    )
  )
}
