pub def Inference_ck_handle_arm_in(
  k: Nat
): Prop := ∀ c: Checker. ∀ env: List(
  Local
). ∀ result: Ty. ∀ rv: Option(
  Nat
). ∀ budget_ty: Ty. ∀ eff: Text. ∀ binds: List(
  Text
). ∀ types: List(
  SurfaceTerm
). ∀ patterns: List(
  SurfacePattern
). ∀ cont: Option(
  Text
). ∀ guard: Option(
  SurfaceTerm
). ∀ body: SurfaceTerm. ∀ ordered: CkOrdered(
