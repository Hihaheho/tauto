pub theorem inference_use_ck_handle_first_in(
  k: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  b: Ty,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames(k)
): CkRunFrame(c, ck_handle_first_in(k, c, handlers, b, env)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(
                            And::right(
                              And::right(
                                And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, handlers, b, env, ordered)
}

