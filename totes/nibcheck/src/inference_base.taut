pub fn inference_hint(c: Checker): Option(Ty) { c.hint }
pub fn inference_set_hint(&mut c: Checker, value: Option(Ty)): Unit { set_to(&mut c.hint, value) }
pub theorem inference_set_hint_frame(
  c: Checker,
  value: Option(Ty)
): CkReadFrame(c, inference_set_hint(c, value)) { Refl }

pub fn inference_returns(c: Checker): List(Ty) { c.returns }
pub fn inference_set_returns(
  &mut c: Checker,
  value: List(Ty)
): Unit { set_to(&mut c.returns, value) }
pub theorem inference_set_returns_frame(
  c: Checker,
  value: List(Ty)
): CkReadFrame(c, inference_set_returns(c, value)) { Refl }

pub fn inference_assume(c: Checker): List(Pair(Text, Text)) { c.assume }
pub fn inference_set_assume(
  &mut c: Checker,
  value: List(Pair(Text, Text))
): Unit { set_to(&mut c.assume, value) }
pub theorem inference_set_assume_frame(
  c: Checker,
  value: List(Pair(Text, Text))
): CkReadFrame(c, inference_set_assume(c, value)) { Refl }

pub fn inference_exceeded(c: Checker): List(Ty) { c.exceeded }
pub fn inference_set_exceeded(
  &mut c: Checker,
  value: List(Ty)
): Unit { set_to(&mut c.exceeded, value) }
pub theorem inference_set_exceeded_frame(
  c: Checker,
  value: List(Ty)
): CkReadFrame(c, inference_set_exceeded(c, value)) { Refl }

pub fn inference_scope_items(env: Scope): List(Local) { env.items }
pub fn inference_term_kind(term: SurfaceTerm): SurfaceKind { term.kind }
pub fn inference_fn_body(f: SurfaceFn): SurfaceTerm { f.body }
pub fn inference_fn_params(f: SurfaceFn): List(Text) { f.params }
pub fn inference_arm_body(a: SurfaceArm): SurfaceTerm { a.body }
pub fn inference_arm_pattern(a: SurfaceArm): SurfacePattern { a.pattern }
pub fn inference_arm_guard(a: SurfaceArm): Option(SurfaceTerm) { a.guard }
pub fn inference_pair_ty(p: Pair(Ty, TySpan)): Ty { p.fst }
pub fn inference_pair_span(p: Pair(Ty, TySpan)): TySpan { p.snd }
pub fn inference_handler_pattern(p: Pair(SurfacePattern, SurfaceTerm)): SurfacePattern { p.fst }
pub fn inference_handler_body(p: Pair(SurfacePattern, SurfaceTerm)): SurfaceTerm { p.snd }
pub fn inference_handler_params(p: ArmSig): List(Ty) { p.params }
pub fn inference_handler_answer(p: ArmSig): Ty { p.answer }
pub fn inference_handler_rigid(p: ArmSig): List(Text) { p.rigid }
pub fn inference_handler_names(p: ArmSig): List(TypeName) { p.bound }
pub fn inference_record_closure(&mut c: Checker, t: Ty, body: SurfaceTerm): Unit {
  set_to(
    &mut c.closure_results,
    Cons(TyClosure { ty: t, start: body.start, end: body.end }, c.closure_results)
  )
}
pub theorem inference_record_closure_frame(
  c: Checker,
  t: Ty,
  body: SurfaceTerm
): CkReadFrame(c, inference_record_closure(c, t, body)) { Refl }
pub fn inference_bind_scope<A, B>(
  k: (A, Checker, Scope) -> Mut1(B, Checker),
  m: Mut2(A, Checker, Scope)
): Mut1(B, Checker) {
  match m: Mut1(B, Checker) { mut2(v, c, env) => k(v, c, env) }
}
pub theorem inference_bind_scope_frame<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker, Scope) -> Mut1(B, Checker),
  m: Mut2(A, Checker, Scope),
  hm: CkScopeFrame(c, m),
  hk: ∀ v: A. ∀ next: Checker. ∀ env: Scope. ∀ ordered: CkOrdered(
    next
  ). CkRunFrame(next, k(v, next, env))
): CkRunFrame(c, inference_bind_scope(k, m)) {
  match m: CkRunFrame(c, inference_bind_scope(k, m)) {
    mut2(v, next, env) => {
      let h: CkRunFrame(next, k(v, next, env)) := hk(v, next, env, And::left(hm))
      AndIntro(And::left(h), Eq::trans(And::right(h), And::right(hm)))
    }
  }
}
