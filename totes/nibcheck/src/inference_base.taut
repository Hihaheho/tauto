pub def Inference_ck_infer_in(
  k: Nat
): Prop := ∀ c: Checker. ∀ term: SurfaceTerm. ∀ env: List(
  Local
). ∀ ordered: CkOrdered(c). CkRunFrame(c, ck_infer_in(k, c, term, env))

