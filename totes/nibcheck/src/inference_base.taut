). ∀ eff: Text. ∀ params: List(
  Ty
). ∀ answer: Ty. ∀ rigid: List(
  Text
). ∀ names: List(
  TypeName
). ∀ patterns: List(
  SurfacePattern
). ∀ cont: Option(
  Text
). ∀ guard: Option(
  SurfaceTerm
). ∀ body: SurfaceTerm. ∀ ordered: CkOrdered(
  c
). CkRunFrame(
  c,
  ck_handle_body_in(
    k,
    c,
    env,
    result,
    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body
  )
)

pub def InferenceFrames(
  k: Nat
): Prop := And(
  Inference_ck_infer_in(k),
  And(
    Inference_ck_infer_term_in(k),
    And(
      Inference_ck_else_in(k),
      And(
        Inference_ck_infer_each_in(k),
        And(
          Inference_ck_guard_in(k),
          And(
            Inference_ck_stmt_in(k),
            And(
              Inference_ck_returned_in(k),
              And(
                Inference_ck_check_fn_in(k),
                And(
                  Inference_ck_block_in(k),
                  And(
                    Inference_ck_app_args_in(k),
                    And(
                      Inference_ck_app_in(k),
                      And(
                        Inference_ck_app_call_in(k),
                        And(
                          Inference_ck_operands_in(k),
                          And(
                            Inference_ck_clone_of_in(k),
                            And(
                              Inference_ck_lambda_in(k),
                              And(
                                Inference_ck_record_fields_in(k),
                                And(
                                  Inference_ck_record_in(k),
                                  And(
                                    Inference_ck_match_arms_in(k),
                                    And(
                                      Inference_ck_match_expr_in(k),
                                      And(
                                        Inference_ck_handle_in(k),
                                        And(
                                          Inference_ck_handle_first_in(k),
                                          And(
                                            Inference_ck_handle_result_in(k),
                                            And(
                                              Inference_ck_handle_arms_in(k),
                                              And(
                                                Inference_ck_handle_one_in(k),
                                                And(
                                                  Inference_ck_handle_arm_in(k),
                                                  And(Inference_ck_handle_body_in(k), True)
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

pub theorem inference_use_ck_infer_in(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames(k)
): CkRunFrame(c, ck_infer_in(k, c, term, env)) { And::left(ih)(c, term, env, ordered) }

pub theorem inference_use_ck_infer_term_in(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames(k)
): CkRunFrame(
  c,
  ck_infer_term_in(k, c, term, env)
) { And::left(And::right(ih))(c, term, env, ordered) }

pub theorem inference_use_ck_else_in(
  k: Nat,
  c: Checker,
  t: Ty,
  el: Option(SurfaceTerm),
  env: List(Local),
