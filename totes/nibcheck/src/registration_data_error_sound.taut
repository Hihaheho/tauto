import "registration_error_sound.taut"
import std::Base
import std::Map
import std::Text
import "checker.taut"
import "datas.taut"
import "datas_frame.taut"
import "datas_registration.taut"
import "decl_names_sound.taut"
import "error_frame.taut"
import "ty.taut"
import "types_decl.taut"
import "unify_sound.taut"
import "written_error_sound.taut"
import "../../surface/src/surface.taut"

pub theorem registration_ctor_state_errors(
  c: Checker,
  ctor: DataCtor,
  dname: Text,
  i: Nat
): decl_names_errors(registration_ctor_state(c, ctor, dname, i)) = decl_names_errors(c) { Refl }
pub theorem ck_register_ctors_errors(
  ctors: List(DataCtor),
  c: Checker,
  dname: Text,
  is_struct: Bool,
  i: Nat
): CkErrorFrame(c, ck_register_ctors(ctors, c, dname, i)) {
  ⊢ CkErrorFrame(c, ck_register_ctors(ctors, c, dname, i)) from match ctors {
    Nil => clean => clean
    Cons(ctor, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
      Eq::sym(registration_register_unf(ctor, rest, c, dname, i)),
      written_error_changed(
        c,
        registration_ctor_state(c, ctor, dname, i),
        ck_rewrap1(
          ck_register_ctors(rest, registration_ctor_state(c, ctor, dname, i), dname, i + 1)
        ),
        registration_ctor_state_errors(c, ctor, dname, i),
        error_frame_rewrap(
          registration_ctor_state(c, ctor, dname, i),
          ck_register_ctors(rest, registration_ctor_state(c, ctor, dname, i), dname, i + 1),
          ck_register_ctors_errors(
            rest,
            registration_ctor_state(c, ctor, dname, i),
            dname,
            is_struct,
            i + 1
          )
        )
      )
    )
  }
}
pub theorem registration_insert_errors(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool,
  constructors: List(DataCtor)
): CkErrorFrame(c, registration_insert(c, d, is_struct, builtin, constructors)) { clean => clean }
pub theorem registration_declare_errors(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool
): CkErrorFrame(c, registration_declare(c, d, is_struct, builtin)) {
  error_frame_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => frame_bind(
      List(DataCtor),
      Unit,
      (constructors: List(DataCtor), c2: Checker) => frame_bind(
        Unit,
        Unit,
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0)
      ),
      ck_data_ctors(
        registration_ctors(d),
        c1,
        ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
      )
    ),
    frame_error_if(
      c,
      "a view struct has no fields: it is an opaque type",
      registration_span(d),
      Bool::and(
        surface_data_is_view(d),
        Bool::or(not(is_struct), ctors_have_fields(registration_ctors(d)))
      )
    ),
    frame_error_if_ok_errors(
      c,
      "a view struct has no fields: it is an opaque type",
      registration_span(d),
      Bool::and(
        surface_data_is_view(d),
        Bool::or(not(is_struct), ctors_have_fields(registration_ctors(d)))
      )
    ),
    ignored => c1 => error_frame_bind(
      List(DataCtor),
      Unit,
      c1,
      (constructors: List(DataCtor), c2: Checker) => frame_bind(
        Unit,
        Unit,
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0)
      ),
      ck_data_ctors(
        registration_ctors(d),
        c1,
        ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
      ),
      ck_data_ctors_frame_errors(
        registration_ctors(d),
        c1,
        ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
      ),
      constructors => c2 => error_frame_bind(
        Unit,
        Unit,
        c2,
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0),
        ck_register_ctors_errors(constructors, c2, registration_name(d), is_struct, 0),
        ignored2 => c3 => registration_insert_errors(c3, d, is_struct, builtin, constructors)
      )
    )
  )
}
pub theorem ck_declare_data_errors(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool
): CkErrorFrame(c, ck_declare_data(c, d, is_struct, builtin)) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
    Eq::sym(registration_declare_unf(c, d, is_struct, builtin)),
    registration_declare_errors(c, d, is_struct, builtin)
  )
}
