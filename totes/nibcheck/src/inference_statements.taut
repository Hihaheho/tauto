pub fn inference_fn_name(f: SurfaceFn): Text { f.name }

pub fn inference_scheme_type(s: Scheme): Ty { s.ty }

pub fn inference_scheme_preds(s: Scheme): List(Text × Text) { s.preds }

pub fn inference_fns(c: Checker): Ordmap(Text, Scheme) { c.fns }

pub fn inference_block_end(
  j: Nat,
  c: Checker,
  env: Scope,
  last: Ty,
  stopped: Bool
): Mut2(Ty, Checker, Scope) {
  match stopped {
    true => mut2(TyNever, c, env)
    false => mut2(last, c, env)
  }
}

pub theorem inference_block_end_frame(
  j: Nat,
  c: Checker,
  env: Scope,
  last: Ty,
  stopped: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkScopeFrame(c, inference_block_end(j, c, env, last, stopped)) {
  match stopped {
    true => pattern_return_frame(c, env, TyNever, ordered)
    false => pattern_return_frame(c, env, last, ordered)
  }
}

pub fn inference_block(
  j: Nat,
  c: Checker,
  env: Scope,
  stopped: Bool,
  last: Ty,
  stmts: List(SurfaceStmt)
): Mut2(Ty, Checker, Scope) {
  match stmts {
    Nil => inference_block_end(j, c, env, last, stopped)
    Cons(s, rest) => pattern_bind_one(
      <A: Unit, B: Ty>,
      (hinted: Unit, c0: Checker) => pattern_bind(
        <A: Ty, B: Ty>,
        (t: Ty, c1: Checker, env1: Scope) => pattern_rewrap(
          ck_block_in(j, c1, rest, env1, Bool::or(stopped, ty_is_never(t)), block_value(s, rest, t))
        ),
        ck_stmt_in(j, c0, s, env)
      ),
      inference_set_result_hint(c, ck_block_hint_for(s, rest, inference_arm_hint(c)))
    )
  }
}

pub theorem inference_block_frame(
  j: Nat,
  c: Checker,
  env: Scope,
  stopped: Bool,
  last: Ty,
  stmts: List(SurfaceStmt),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkScopeFrame(c, inference_block(j, c, env, stopped, last, stmts)) {
  match stmts {
    Nil => inference_block_end_frame(j, c, env, last, stopped, ih, ordered)
    Cons(s, rest) => pattern_bind_one_frame(
      <A: Unit, B: Ty>,
      c,
      (hinted: Unit, c0: Checker) => pattern_bind(
        <A: Ty, B: Ty>,
        (t: Ty, c1: Checker, env1: Scope) => pattern_rewrap(
          ck_block_in(j, c1, rest, env1, Bool::or(stopped, ty_is_never(t)), block_value(s, rest, t))
        ),
        ck_stmt_in(j, c0, s, env)
      ),
      inference_set_result_hint(c, ck_block_hint_for(s, rest, inference_arm_hint(c))),
      run_frame_read(
        c,
        inference_set_result_hint(c, ck_block_hint_for(s, rest, inference_arm_hint(c))),
        inference_set_result_hint_frame(c, ck_block_hint_for(s, rest, inference_arm_hint(c))),
        ordered
      ),
      hinted => c0 => o_c0 => pattern_bind_frame(
        <A: Ty, B: Ty>,
        c0,
        (t: Ty, c1: Checker, env1: Scope) => pattern_rewrap(
          ck_block_in(j, c1, rest, env1, Bool::or(stopped, ty_is_never(t)), block_value(s, rest, t))
        ),
        ck_stmt_in(j, c0, s, env),
        inference_use_ck_stmt_in(j, c0, s, env, o_c0, ih),
        t => c1 => env1 => o_c1 => pattern_rewrap_frame(
          c1,
          ck_block_in(j, c1, rest, env1, Bool::or(stopped, ty_is_never(t)), block_value(s, rest, t)),
          inference_use_ck_block_in(
            j,
            c1,
            rest,
            env1,
            Bool::or(stopped, ty_is_never(t)),
            block_value(s, rest, t),
            o_c1,
            ih
          )
        )
      )
    )
  }
}

pub fn inference_step_ck_block_in(
  j: Nat,
  c: Checker,
  stmts: List(SurfaceStmt),
  env: Scope,
  stopped: Bool,
  last: Ty
): Mut2(Ty, Checker, Scope) { inference_block(j, c, env, stopped, last, stmts) }

pub theorem inference_step_ck_block_in_frame(
  j: Nat,
  c: Checker,
  stmts: List(SurfaceStmt),
  env: Scope,
  stopped: Bool,
  last: Ty,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkScopeFrame(
  c,
  inference_step_ck_block_in(j, c, stmts, env, stopped, last)
) { inference_block_frame(j, c, env, stopped, last, stmts, ih, ordered) }

pub theorem inference_unf_ck_block_in(
  j: Nat,
  c: Checker,
  stmts: List(SurfaceStmt),
  env: Scope,
  stopped: Bool,
  last: Ty
): ck_block_in(
  Succ(j),
  c,
  stmts,
  env,
  stopped,
  last
) = inference_step_ck_block_in(
  j,
  c,
  stmts,
  env,
  stopped,
  last
) { ⊢ ck_block_in(
  Succ(j),
  c,
  stmts,
  env,
  stopped,
  last
) = inference_step_ck_block_in(j, c, stmts, env, stopped, last) from match stmts {
    Nil => Refl
    Cons(s, rest) => Refl
  } }

pub fn inference_app_clone(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  clone: Bool
): Mut1(Ty, Checker) {
  match clone {
    true => ck_rewrap1(ck_clone_of_in(j, c, arguments, env, span_of(term)))
    false => inference_app_nullary(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      ck_nullary_call(c, name, arguments)
    )
  }
}

pub fn inference_app_nullary(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  nullary: Bool
): Mut1(Ty, Checker) {
  match nullary {
    true => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_infer_in(j, c1, function, env)),
      ck_rewrap1(ck_error(c, constructor_without_fields_message(name), span_of(term)))
    )
    false => ck_rewrap1(ck_app_call_in(j, c, term, function, arguments, env))
  }
}

pub theorem inference_app_nullary_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  nullary: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_app_nullary(j, c, term, function, arguments, env, name, nullary)) {
  ⊢ CkRunFrame(
    c,
    inference_app_nullary(j, c, term, function, arguments, env, name, nullary)
  ) from match nullary {
    true => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_infer_in(j, c1, function, env)),
      ck_rewrap1(ck_error(c, constructor_without_fields_message(name), span_of(term))),
      run_frame_read(
        c,
        ck_rewrap1(ck_error(c, constructor_without_fields_message(name), span_of(term))),
        frame_rewrap(
          c,
          ck_error(c, constructor_without_fields_message(name), span_of(term)),
          ck_error_frame(c, constructor_without_fields_message(name), span_of(term))
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_infer_in(j, c1, function, env),
        inference_use_ck_infer_in(j, c1, function, env, o_c1, ih)
      )
    )
    false => run_frame_rewrap(
      c,
      ck_app_call_in(j, c, term, function, arguments, env),
      inference_use_ck_app_call_in(j, c, term, function, arguments, env, ordered, ih)
    )
  }
}

pub theorem inference_app_clone_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  clone: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_app_clone(j, c, term, function, arguments, env, name, clone)) {
  ⊢ CkRunFrame(
    c,
    inference_app_clone(j, c, term, function, arguments, env, name, clone)
  ) from match clone {
    true => run_frame_rewrap(
      c,
      ck_clone_of_in(j, c, arguments, env, span_of(term)),
      inference_use_ck_clone_of_in(j, c, arguments, env, span_of(term), ordered, ih)
    )
    false => inference_app_nullary_frame(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      ck_nullary_call(c, name, arguments),
      ih,
      ordered
    )
  }
}

pub fn inference_app_operator(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  operator: Bool
): Mut1(Ty, Checker) {
  match operator {
    true => frame_bind(
      <A: List(Ty), B: Ty>,
      (args: List(Ty), c1: Checker) => ck_rewrap1(
        ck_operator_of(c1, name, args, arguments, span_of(term), term.occurrence)
      ),
      ck_operands_in(j, c, arguments, env)
    )
    false => inference_app_clone(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Bool::and(
        Text::eq(name, "clone"),
        not(Ordmap::contains(inference_fns(c), name, Ordmap::compare_text))
      )
    )
  }
}

pub theorem inference_app_operator_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  operator: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_app_operator(j, c, term, function, arguments, env, name, operator)) {
  ⊢ CkRunFrame(
    c,
    inference_app_operator(j, c, term, function, arguments, env, name, operator)
  ) from match operator {
    true => run_frame_bind(
      <A: List(Ty), B: Ty>,
      c,
      (args: List(Ty), c1: Checker) => ck_rewrap1(
        ck_operator_of(c1, name, args, arguments, span_of(term), term.occurrence)
      ),
      ck_operands_in(j, c, arguments, env),
      inference_use_ck_operands_in(j, c, arguments, env, ordered, ih),
      args => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_operator_of(c1, name, args, arguments, span_of(term), term.occurrence),
        ck_operator_of_run_frame(c1, name, args, arguments, span_of(term), term.occurrence, o_c1)
      )
    )
    false => inference_app_clone_frame(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Bool::and(
        Text::eq(name, "clone"),
        not(Ordmap::contains(inference_fns(c), name, Ordmap::compare_text))
      ),
      ih,
      ordered
    )
  }
}

pub fn inference_app_ascribe(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  ascribe: Bool
): Mut1(Ty, Checker) {
  match ascribe {
    true => frame_bind(
      <A: List(Ty), B: Ty>,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_ascribe_of(c1, types, term, arguments)),
      ck_infer_each_in(j, c, ascribe_body(arguments), env)
    )
    false => inference_app_operator(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      ck_is_operator(name)
    )
  }
}

pub theorem inference_app_ascribe_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  ascribe: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_app_ascribe(j, c, term, function, arguments, env, name, ascribe)) {
  ⊢ CkRunFrame(
    c,
    inference_app_ascribe(j, c, term, function, arguments, env, name, ascribe)
  ) from match ascribe {
    true => run_frame_bind(
      <A: List(Ty), B: Ty>,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_ascribe_of(c1, types, term, arguments)),
      ck_infer_each_in(j, c, ascribe_body(arguments), env),
      inference_use_ck_infer_each_in(j, c, ascribe_body(arguments), env, ordered, ih),
      types => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_ascribe_of(c1, types, term, arguments),
        ck_ascribe_of_run_frame(c1, types, term, arguments, o_c1)
      )
    )
    false => inference_app_operator_frame(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      ck_is_operator(name),
      ih,
      ordered
    )
  }
}

pub fn inference_app_product(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  product: Bool
): Mut1(Ty, Checker) {
  match product {
    true => frame_bind(
      <A: List(Ty), B: Ty>,
      (types: List(Ty), c1: Checker) => ck_rewrap1(
        ck_product_of(c1, types, arguments, span_of(term))
      ),
      ck_infer_each_in(j, c, arguments, env)
    )
    false => inference_app_ascribe(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Text::eq(name, "#ascribe")
    )
  }
}

pub theorem inference_app_product_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  name: Text,
  product: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_app_product(j, c, term, function, arguments, env, name, product)) {
  ⊢ CkRunFrame(
    c,
    inference_app_product(j, c, term, function, arguments, env, name, product)
  ) from match product {
    true => run_frame_bind(
      <A: List(Ty), B: Ty>,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(
        ck_product_of(c1, types, arguments, span_of(term))
      ),
      ck_infer_each_in(j, c, arguments, env),
      inference_use_ck_infer_each_in(j, c, arguments, env, ordered, ih),
      types => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_product_of(c1, types, arguments, span_of(term)),
        ck_product_of_run_frame(c1, types, arguments, span_of(term), o_c1)
      )
    )
    false => inference_app_ascribe_frame(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Text::eq(name, "#ascribe"),
      ih,
      ordered
    )
  }
}

pub fn inference_app_name(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  r#direct: Option(Text)
): Mut1(Ty, Checker) {
  match r#direct {
    None => ck_rewrap1(ck_app_call_in(j, c, term, function, arguments, env))
    Some(name) => inference_app_product(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Text::eq(name, "std::prelude::Pair::Mk")
    )
  }
}

pub theorem inference_app_name_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  r#direct: Option(Text),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_app_name(j, c, term, function, arguments, env, r#direct)) {
  match r#direct {
    None => run_frame_rewrap(
      c,
      ck_app_call_in(j, c, term, function, arguments, env),
      inference_use_ck_app_call_in(j, c, term, function, arguments, env, ordered, ih)
    )
    Some(name) => inference_app_product_frame(
      j,
      c,
      term,
      function,
      arguments,
      env,
      name,
      Text::eq(name, "std::prelude::Pair::Mk"),
      ih,
      ordered
    )
  }
}

pub fn inference_step_ck_app_in(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local)
): Mut1(
  Ty,
  Checker
) { inference_app_name(j, c, term, function, arguments, env, ck_direct_name(function, env)) }

pub theorem inference_step_ck_app_in_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_step_ck_app_in(j, c, term, function, arguments, env)) {
  inference_app_name_frame(
    j,
    c,
    term,
    function,
    arguments,
    env,
    ck_direct_name(function, env),
    ih,
    ordered
  )
}

pub theorem inference_unf_ck_app_in(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local)
): ck_app_in(
  Succ(j),
  c,
  term,
  function,
  arguments,
  env
) = inference_step_ck_app_in(j, c, term, function, arguments, env) { Refl }

pub fn inference_assign_place(
  j: Nat,
  c: Checker,
  env: Scope,
  name: Text,
  deref: Bool,
  p: SurfaceTerm,
  v: Ty,
  value: SurfaceTerm,
  ok: Bool
): Mut2(Ty, Checker, Scope) {
  match ok {
    true => pattern_bind_one(
      <A: Ty, B: Ty>,
      (pt: Ty, c2: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (assigned: Unit, c3: Checker) => mut2(TyUnit, c3, env),
        ck_assign_place(c2, inference_scope_items(env), name, deref, v, pt, p, value)
      ),
      ck_infer_in(j, c, p, inference_scope_items(env))
    )
    false => pattern_bind_one(
      <A: Unit, B: Ty>,
      (refused: Unit, c2: Checker) => mut2(TyUnit, c2, env),
      ck_assign_refuse(c, inference_scope_items(env), name, p, value)
    )
  }
}

pub fn inference_assign_rest(
  j: Nat,
  c: Checker,
  env: Scope,
  name: Text,
  place: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  field: Option(SurfaceTerm)
): Mut2(Ty, Checker, Scope) {
  match field {
    None => pattern_bind_one(
      <A: Unit, B: Ty>,
      (assigned: Unit, c2: Checker) => mut2(TyUnit, c2, env),
      ck_assign(c, inference_scope_items(env), name, ck_place_deref(place), v, value)
    )
    Some(p) => inference_assign_place(j, c, env, name, ck_place_deref(place), p, v, value, ck_place_ok(c, inference_scope_items(env), name, p))
  }
}

pub fn inference_statement(
  j: Nat,
  c: Checker,
  env: Scope,
  s: SurfaceStmt
): Mut2(Ty, Checker, Scope) {
  match s {
    StLet(name, ty, value, r#borrow, bm, ^unused, ^st_stack) => pattern_bind_one(
      <A: Unit, B: Ty>,
      (hinted: Unit, c0: Checker) => pattern_bind_one(
        <A: Ty, B: Ty>,
        (v: Ty, c1: Checker) => pattern_bind(
          <A: Unit, B: Ty>,
          (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
          ck_let(c1, env, name, ty, v, value, r#borrow, bm)
        ),
        ck_infer_in(j, c0, value, inference_scope_items(env))
      ),
      inference_set_result_hint(c, ck_let_hint(ty, value))
    )
    StVar(name, ty, value, vb, ^unused, ^st_stack) => pattern_bind_one(
      <A: Ty, B: Ty>,
      (v: Ty, c1: Checker) => pattern_bind(
        <A: Unit, B: Ty>,
        (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
        ck_var(c1, env, name, ty, v, value, vb)
      ),
      ck_infer_in(j, c, value, inference_scope_items(env))
    )
    StAssign(name, name_place, value) => pattern_bind_one(
      <A: Ty, B: Ty>,
      (v: Ty, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (placed: Unit, c4: Checker) => inference_assign_rest(j, c4, env, name, name_place, v, value, ck_assign_field_place(name_place)),
        ck_coerce_assign_place(c1, inference_scope_items(env), name_place)
      ),
      ck_infer_in(j, c, value, inference_scope_items(env))
    )
    StCalled(name_generates, value) => pattern_lift(
      env,
      ck_stmt_other(c, StCalled(name_generates, value))
    )
    StFn(f) => pattern_bind_one(
      <A: Scheme, B: Ty>,
      (scheme: Scheme, c1: Checker) => pattern_bind(
        <A: Unit, B: Ty>,
        (bound: Unit, c2: Checker, env2: Scope) => pattern_bind_one(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => mut2(TyUnit, c3, env2),
          ck_check_fn_in(j, c2, f, scheme, inference_scope_items(env2))
        ),
        ck_bind_local(
          c1,
          env,
          inference_fn_name(f),
          scheme_local_type(scheme),
          false,
          handle_body_start(inference_fn_body(f))
        )
      ),
      ck_signature(c, f)
    )
    StEffect(e) => pattern_bind_one(
      <A: Unit, B: Ty>,
      (declared: Unit, c1: Checker) => mut2(TyUnit, c1, env),
      ck_declare_effect(c, e)
    )
    StWhile(condition, body) => pattern_bind_one(
      <A: Ty, B: Ty>,
      (t: Ty, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => pattern_bind_one(
          <A: Ty, B: Ty>,
          (ignored: Ty, c3: Checker) => mut2(TyUnit, c3, env),
          ck_infer_in(j, c2, body, inference_scope_items(env))
        ),
        ck_expect(c1, t, TyBool, span_of(condition), what_while_condition_message())
      ),
      ck_infer_in(j, c, condition, inference_scope_items(env))
    )
    StReturn(e) => pattern_bind_one(
      <A: (Ty × TySpan), B: Ty>,
      (returned: Ty × TySpan, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => mut2(TyNever, c2, env),
        ck_return_check(c1, inference_pair_ty(returned), inference_pair_span(returned))
      ),
      ck_returned_in(j, c, e, inference_scope_items(env))
    )
    StExpr(e) => pattern_lift(env, ck_infer_in(j, c, e, inference_scope_items(env)))
    StTheorem(pat_t) => pattern_lift(env, ck_stmt_other(c, StTheorem(pat_t)))
    StDef(pat_t) => pattern_lift(env, ck_stmt_other(c, StDef(pat_t)))
    StMutual(pat_stmts, pat_start, pat_end) => pattern_lift(
      env,
      ck_stmt_other(c, StMutual(pat_stmts, pat_start, pat_end))
    )
    StImport(pat_path, pat_start, pat_end) => pattern_lift(
      env,
      ck_stmt_other(c, StImport(pat_path, pat_start, pat_end))
    )
    StInductive(pat_i) => pattern_lift(env, ck_stmt_other(c, StInductive(pat_i)))
    StStruct(pat_d) => pattern_lift(env, ck_stmt_other(c, StStruct(pat_d)))
    StEnum(pat_d) => pattern_lift(env, ck_stmt_other(c, StEnum(pat_d)))
    StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end) => pattern_lift(
      env,
      ck_stmt_other(c, StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end))
    )
    StClass(pat_c) => pattern_lift(env, ck_stmt_other(c, StClass(pat_c)))
    StInstance(pat_i) => pattern_lift(env, ck_stmt_other(c, StInstance(pat_i)))
    StMacro(pat_name, pat_function, pat_start, pat_end) => pattern_lift(
      env,
      ck_stmt_other(c, StMacro(pat_name, pat_function, pat_start, pat_end))
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => pattern_lift(
      env,
      ck_stmt_other(c, StAttributed(attr_name, attr_arg, attr_generates, attr_stmt))
    )
    StSyntax(pat_name, pat_grammar, pat_start, pat_end) => pattern_lift(
      env,
      ck_stmt_other(c, StSyntax(pat_name, pat_grammar, pat_start, pat_end))
    )
    StOther(what, start, end) => pattern_lift(env, ck_stmt_other(c, StOther(what, start, end)))
    StLoop(^st_body, start, end) => pattern_lift(env, ck_stmt_other(c, StOther("LoopExpr", start, end)))
    StModule(^mod_name, ^mod_vis, ^mod_items, start, end) => pattern_lift(env, ck_stmt_other(c, StOther("ModuleDecl", start, end)))
    StReexport(^re_path, ^re_names, ^re_spans, start, end) => pattern_lift(env, ck_stmt_other(c, StOther("ReexportDecl", start, end)))
    StFor(^for_pat, ^for_src, ^st_body, start, end) => pattern_lift(env, ck_stmt_other(c, StOther("ForStmt", start, end)))
    StBreak(^st_value, start, end) => pattern_lift(env, ck_stmt_other(c, StOther("BreakStmt", start, end)))
    StContinue(start, end) => pattern_lift(env, ck_stmt_other(c, StOther("ContinueStmt", start, end)))
  }
}

pub theorem inference_assign_place_frame(
  j: Nat,
  c: Checker,
  env: Scope,
  name: Text,
  deref: Bool,
  p: SurfaceTerm,
  v: Ty,
  value: SurfaceTerm,
  ok: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkScopeFrame(c, inference_assign_place(j, c, env, name, deref, p, v, value, ok)) {
  match ok {
    true => pattern_bind_one_frame(
      <A: Ty, B: Ty>,
      c,
      (pt: Ty, c2: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (assigned: Unit, c3: Checker) => mut2(TyUnit, c3, env),
        ck_assign_place(c2, inference_scope_items(env), name, deref, v, pt, p, value)
      ),
      ck_infer_in(j, c, p, inference_scope_items(env)),
      inference_use_ck_infer_in(j, c, p, inference_scope_items(env), ordered, ih),
      pt => c2 => o_c2 => pattern_bind_one_frame(
        <A: Unit, B: Ty>,
        c2,
        (assigned: Unit, c3: Checker) => mut2(TyUnit, c3, env),
        ck_assign_place(c2, inference_scope_items(env), name, deref, v, pt, p, value),
        ck_assign_place_run_frame(c2, inference_scope_items(env), name, deref, v, pt, p, value, o_c2),
        assigned => c3 => o_c3 => pattern_return_frame(c3, env, TyUnit, o_c3)
      )
    )
    false => pattern_bind_one_frame(
      <A: Unit, B: Ty>,
      c,
      (refused: Unit, c2: Checker) => mut2(TyUnit, c2, env),
      ck_assign_refuse(c, inference_scope_items(env), name, p, value),
      ck_assign_refuse_run_frame(c, inference_scope_items(env), name, p, value, ordered),
      refused => c2 => o_c2 => pattern_return_frame(c2, env, TyUnit, o_c2)
    )
  }
}

pub theorem inference_assign_rest_frame(
  j: Nat,
  c: Checker,
  env: Scope,
  name: Text,
  place: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  field: Option(SurfaceTerm),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkScopeFrame(c, inference_assign_rest(j, c, env, name, place, v, value, field)) {
  match field {
    None => pattern_bind_one_frame(
      <A: Unit, B: Ty>,
      c,
      (assigned: Unit, c2: Checker) => mut2(TyUnit, c2, env),
      ck_assign(c, inference_scope_items(env), name, ck_place_deref(place), v, value),
      ck_assign_run_frame(c, inference_scope_items(env), name, ck_place_deref(place), v, value, ordered),
      assigned => c2 => o_c2 => pattern_return_frame(c2, env, TyUnit, o_c2)
    )
    Some(p) => inference_assign_place_frame(
      j,
      c,
      env,
      name,
      ck_place_deref(place),
      p,
      v,
      value,
      ck_place_ok(c, inference_scope_items(env), name, p),
      ih,
      ordered
    )
  }
}

pub theorem inference_statement_frame(
  j: Nat,
  c: Checker,
  env: Scope,
  s: SurfaceStmt,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkScopeFrame(c, inference_statement(j, c, env, s)) {
  match s {
    StLet(name, ty, value, r#borrow, bm, unused, st_stack) => pattern_bind_one_frame(
      <A: Unit, B: Ty>,
      c,
      (hinted: Unit, c0: Checker) => pattern_bind_one(
        <A: Ty, B: Ty>,
        (v: Ty, c1: Checker) => pattern_bind(
          <A: Unit, B: Ty>,
          (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
          ck_let(c1, env, name, ty, v, value, r#borrow, bm)
        ),
        ck_infer_in(j, c0, value, inference_scope_items(env))
      ),
      inference_set_result_hint(c, ck_let_hint(ty, value)),
      run_frame_read(
        c,
        inference_set_result_hint(c, ck_let_hint(ty, value)),
        inference_set_result_hint_frame(c, ck_let_hint(ty, value)),
        ordered
      ),
      hinted => c0 => o_c0 => pattern_bind_one_frame(
        <A: Ty, B: Ty>,
        c0,
        (v: Ty, c1: Checker) => pattern_bind(
          <A: Unit, B: Ty>,
          (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
          ck_let(c1, env, name, ty, v, value, r#borrow, bm)
        ),
        ck_infer_in(j, c0, value, inference_scope_items(env)),
        inference_use_ck_infer_in(j, c0, value, inference_scope_items(env), o_c0, ih),
        v => c1 => o_c1 => pattern_bind_frame(
          <A: Unit, B: Ty>,
          c1,
          (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
          ck_let(c1, env, name, ty, v, value, r#borrow, bm),
          ck_let_scope_frame(c1, env, name, ty, v, value, r#borrow, bm, o_c1),
          bound => c2 => env2 => o_c2 => pattern_return_frame(c2, env2, TyUnit, o_c2)
        )
      )
    )
    StVar(name, ty, value, vb, unused, st_stack) => pattern_bind_one_frame(
      <A: Ty, B: Ty>,
      c,
      (v: Ty, c1: Checker) => pattern_bind(
        <A: Unit, B: Ty>,
        (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
        ck_var(c1, env, name, ty, v, value, vb)
      ),
      ck_infer_in(j, c, value, inference_scope_items(env)),
      inference_use_ck_infer_in(j, c, value, inference_scope_items(env), ordered, ih),
      v => c1 => o_c1 => pattern_bind_frame(
        <A: Unit, B: Ty>,
        c1,
        (bound: Unit, c2: Checker, env2: Scope) => mut2(TyUnit, c2, env2),
        ck_var(c1, env, name, ty, v, value, vb),
        ck_var_scope_frame(c1, env, name, ty, v, value, vb, o_c1),
        bound => c2 => env2 => o_c2 => pattern_return_frame(c2, env2, TyUnit, o_c2)
      )
    )
    StAssign(name, name_place, value) => pattern_bind_one_frame(
      <A: Ty, B: Ty>,
      c,
      (v: Ty, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (placed: Unit, c4: Checker) => inference_assign_rest(j, c4, env, name, name_place, v, value, ck_assign_field_place(name_place)),
        ck_coerce_assign_place(c1, inference_scope_items(env), name_place)
      ),
      ck_infer_in(j, c, value, inference_scope_items(env)),
      inference_use_ck_infer_in(j, c, value, inference_scope_items(env), ordered, ih),
      v => c1 => o_c1 => pattern_bind_one_frame(
        <A: Unit, B: Ty>,
        c1,
        (placed: Unit, c4: Checker) => inference_assign_rest(j, c4, env, name, name_place, v, value, ck_assign_field_place(name_place)),
        ck_coerce_assign_place(c1, inference_scope_items(env), name_place),
        ck_coerce_assign_place_frame_run(c1, inference_scope_items(env), name_place, o_c1),
        placed => c4 => o_c4 => inference_assign_rest_frame(j, c4, env, name, name_place, v, value, ck_assign_field_place(name_place), ih, o_c4)
      )
    )
    StCalled(name_generates, value) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StCalled(name_generates, value)),
      run_frame_read(
        c,
        ck_stmt_other(c, StCalled(name_generates, value)),
        ck_stmt_other_frame(c, StCalled(name_generates, value)),
        ordered
      )
    )
    StFn(f) => pattern_bind_one_frame(
      <A: Scheme, B: Ty>,
      c,
      (scheme: Scheme, c1: Checker) => pattern_bind(
        <A: Unit, B: Ty>,
        (bound: Unit, c2: Checker, env2: Scope) => pattern_bind_one(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => mut2(TyUnit, c3, env2),
          ck_check_fn_in(j, c2, f, scheme, inference_scope_items(env2))
        ),
        ck_bind_local(
          c1,
          env,
          inference_fn_name(f),
          scheme_local_type(scheme),
          false,
          handle_body_start(inference_fn_body(f))
        )
      ),
      ck_signature(c, f),
      run_frame_read(c, ck_signature(c, f), ck_signature_frame(c, f), ordered),
      scheme => c1 => o_c1 => pattern_bind_frame(
        <A: Unit, B: Ty>,
        c1,
        (bound: Unit, c2: Checker, env2: Scope) => pattern_bind_one(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => mut2(TyUnit, c3, env2),
          ck_check_fn_in(j, c2, f, scheme, inference_scope_items(env2))
        ),
        ck_bind_local(
          c1,
          env,
          inference_fn_name(f),
          scheme_local_type(scheme),
          false,
          handle_body_start(inference_fn_body(f))
        ),
        ck_bind_local_scope_frame(
          c1,
          env,
          inference_fn_name(f),
          scheme_local_type(scheme),
          false,
          handle_body_start(inference_fn_body(f)),
          o_c1
        ),
        bound => c2 => env2 => o_c2 => pattern_bind_one_frame(
          <A: Unit, B: Ty>,
          c2,
          (checked: Unit, c3: Checker) => mut2(TyUnit, c3, env2),
          ck_check_fn_in(j, c2, f, scheme, inference_scope_items(env2)),
          inference_use_ck_check_fn_in(j, c2, f, scheme, inference_scope_items(env2), o_c2, ih),
          checked => c3 => o_c3 => pattern_return_frame(c3, env2, TyUnit, o_c3)
        )
      )
    )
    StEffect(e) => pattern_bind_one_frame(
      <A: Unit, B: Ty>,
      c,
      (declared: Unit, c1: Checker) => mut2(TyUnit, c1, env),
      ck_declare_effect(c, e),
      run_frame_read(c, ck_declare_effect(c, e), ck_declare_effect_frame(c, e), ordered),
      declared => c1 => o_c1 => pattern_return_frame(c1, env, TyUnit, o_c1)
    )
    StWhile(condition, body) => pattern_bind_one_frame(
      <A: Ty, B: Ty>,
      c,
      (t: Ty, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => pattern_bind_one(
          <A: Ty, B: Ty>,
          (ignored: Ty, c3: Checker) => mut2(TyUnit, c3, env),
          ck_infer_in(j, c2, body, inference_scope_items(env))
        ),
        ck_expect(c1, t, TyBool, span_of(condition), what_while_condition_message())
      ),
      ck_infer_in(j, c, condition, inference_scope_items(env)),
      inference_use_ck_infer_in(j, c, condition, inference_scope_items(env), ordered, ih),
      t => c1 => o_c1 => pattern_bind_one_frame(
        <A: Unit, B: Ty>,
        c1,
        (checked: Unit, c2: Checker) => pattern_bind_one(
          <A: Ty, B: Ty>,
          (ignored: Ty, c3: Checker) => mut2(TyUnit, c3, env),
          ck_infer_in(j, c2, body, inference_scope_items(env))
        ),
        ck_expect(c1, t, TyBool, span_of(condition), what_while_condition_message()),
        ck_expect_run_frame(c1, t, TyBool, span_of(condition), what_while_condition_message(), o_c1),
        checked => c2 => o_c2 => pattern_bind_one_frame(
          <A: Ty, B: Ty>,
          c2,
          (ignored: Ty, c3: Checker) => mut2(TyUnit, c3, env),
          ck_infer_in(j, c2, body, inference_scope_items(env)),
          inference_use_ck_infer_in(j, c2, body, inference_scope_items(env), o_c2, ih),
          ignored => c3 => o_c3 => pattern_return_frame(c3, env, TyUnit, o_c3)
        )
      )
    )
    StReturn(e) => pattern_bind_one_frame(
      <A: (Ty × TySpan), B: Ty>,
      c,
      (returned: Ty × TySpan, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => mut2(TyNever, c2, env),
        ck_return_check(c1, inference_pair_ty(returned), inference_pair_span(returned))
      ),
      ck_returned_in(j, c, e, inference_scope_items(env)),
      inference_use_ck_returned_in(j, c, e, inference_scope_items(env), ordered, ih),
      returned => c1 => o_c1 => pattern_bind_one_frame(
        <A: Unit, B: Ty>,
        c1,
        (checked: Unit, c2: Checker) => mut2(TyNever, c2, env),
        ck_return_check(c1, inference_pair_ty(returned), inference_pair_span(returned)),
        ck_return_check_run_frame(
          c1,
          inference_pair_ty(returned),
          inference_pair_span(returned),
          o_c1
        ),
        checked => c2 => o_c2 => pattern_return_frame(c2, env, TyNever, o_c2)
      )
    )
    StExpr(e) => pattern_lift_frame(
      c,
      env,
      ck_infer_in(j, c, e, inference_scope_items(env)),
      inference_use_ck_infer_in(j, c, e, inference_scope_items(env), ordered, ih)
    )
    StTheorem(pat_t) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StTheorem(pat_t)),
      run_frame_read(
        c,
        ck_stmt_other(c, StTheorem(pat_t)),
        ck_stmt_other_frame(c, StTheorem(pat_t)),
        ordered
      )
    )
    StDef(pat_t) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StDef(pat_t)),
      run_frame_read(
        c,
        ck_stmt_other(c, StDef(pat_t)),
        ck_stmt_other_frame(c, StDef(pat_t)),
        ordered
      )
    )
    StMutual(pat_stmts, pat_start, pat_end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StMutual(pat_stmts, pat_start, pat_end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StMutual(pat_stmts, pat_start, pat_end)),
        ck_stmt_other_frame(c, StMutual(pat_stmts, pat_start, pat_end)),
        ordered
      )
    )
    StImport(pat_path, pat_start, pat_end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StImport(pat_path, pat_start, pat_end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StImport(pat_path, pat_start, pat_end)),
        ck_stmt_other_frame(c, StImport(pat_path, pat_start, pat_end)),
        ordered
      )
    )
    StInductive(pat_i) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StInductive(pat_i)),
      run_frame_read(
        c,
        ck_stmt_other(c, StInductive(pat_i)),
        ck_stmt_other_frame(c, StInductive(pat_i)),
        ordered
      )
    )
    StStruct(pat_d) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StStruct(pat_d)),
      run_frame_read(
        c,
        ck_stmt_other(c, StStruct(pat_d)),
        ck_stmt_other_frame(c, StStruct(pat_d)),
        ordered
      )
    )
    StEnum(pat_d) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StEnum(pat_d)),
      run_frame_read(
        c,
        ck_stmt_other(c, StEnum(pat_d)),
        ck_stmt_other_frame(c, StEnum(pat_d)),
        ordered
      )
    )
    StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end)),
        ck_stmt_other_frame(c, StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end)),
        ordered
      )
    )
    StClass(pat_c) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StClass(pat_c)),
      run_frame_read(
        c,
        ck_stmt_other(c, StClass(pat_c)),
        ck_stmt_other_frame(c, StClass(pat_c)),
        ordered
      )
    )
    StInstance(pat_i) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StInstance(pat_i)),
      run_frame_read(
        c,
        ck_stmt_other(c, StInstance(pat_i)),
        ck_stmt_other_frame(c, StInstance(pat_i)),
        ordered
      )
    )
    StMacro(pat_name, pat_function, pat_start, pat_end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StMacro(pat_name, pat_function, pat_start, pat_end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StMacro(pat_name, pat_function, pat_start, pat_end)),
        ck_stmt_other_frame(c, StMacro(pat_name, pat_function, pat_start, pat_end)),
        ordered
      )
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StAttributed(attr_name, attr_arg, attr_generates, attr_stmt)),
      run_frame_read(
        c,
        ck_stmt_other(c, StAttributed(attr_name, attr_arg, attr_generates, attr_stmt)),
        ck_stmt_other_frame(c, StAttributed(attr_name, attr_arg, attr_generates, attr_stmt)),
        ordered
      )
    )
    StSyntax(pat_name, pat_grammar, pat_start, pat_end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StSyntax(pat_name, pat_grammar, pat_start, pat_end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StSyntax(pat_name, pat_grammar, pat_start, pat_end)),
        ck_stmt_other_frame(c, StSyntax(pat_name, pat_grammar, pat_start, pat_end)),
        ordered
      )
    )
    StOther(what, start, end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StOther(what, start, end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StOther(what, start, end)),
        ck_stmt_other_frame(c, StOther(what, start, end)),
        ordered
      )
    )
    StLoop(st_body, start, end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StOther("LoopExpr", start, end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StOther("LoopExpr", start, end)),
        ck_stmt_other_frame(c, StOther("LoopExpr", start, end)),
        ordered
      )
    )
    StModule(mod_name, mod_vis, mod_items, start, end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StOther("ModuleDecl", start, end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StOther("ModuleDecl", start, end)),
        ck_stmt_other_frame(c, StOther("ModuleDecl", start, end)),
        ordered
      )
    )
    StReexport(re_path, re_names, re_spans, start, end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StOther("ReexportDecl", start, end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StOther("ReexportDecl", start, end)),
        ck_stmt_other_frame(c, StOther("ReexportDecl", start, end)),
        ordered
      )
    )
    StFor(for_pat, for_src, st_body, start, end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StOther("ForStmt", start, end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StOther("ForStmt", start, end)),
        ck_stmt_other_frame(c, StOther("ForStmt", start, end)),
        ordered
      )
    )
    StBreak(st_value, start, end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StOther("BreakStmt", start, end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StOther("BreakStmt", start, end)),
        ck_stmt_other_frame(c, StOther("BreakStmt", start, end)),
        ordered
      )
    )
    StContinue(start, end) => pattern_lift_frame(
      c,
      env,
      ck_stmt_other(c, StOther("ContinueStmt", start, end)),
      run_frame_read(
        c,
        ck_stmt_other(c, StOther("ContinueStmt", start, end)),
        ck_stmt_other_frame(c, StOther("ContinueStmt", start, end)),
        ordered
      )
    )
  }
}

pub fn inference_step_ck_stmt_in(
  j: Nat,
  c: Checker,
  s: SurfaceStmt,
  env: Scope
): Mut2(Ty, Checker, Scope) { inference_statement(j, c, env, s) }

pub theorem inference_step_ck_stmt_in_frame(
  j: Nat,
  c: Checker,
  s: SurfaceStmt,
  env: Scope,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkScopeFrame(
  c,
  inference_step_ck_stmt_in(j, c, s, env)
) { inference_statement_frame(j, c, env, s, ih, ordered) }

pub theorem inference_unf_ck_stmt_in(
  j: Nat,
  c: Checker,
  s: SurfaceStmt,
  env: Scope
): ck_stmt_in(
  Succ(j),
  c,
  s,
  env
) = inference_step_ck_stmt_in(
  j,
  c,
  s,
  env
) { ⊢ ck_stmt_in(Succ(j), c, s, env) = inference_step_ck_stmt_in(j, c, s, env) from match s {
    StLet(name, ty, value, r#borrow, bm, unused, st_stack) => Refl
    StVar(name, ty, value, vb, unused, st_stack) => Refl
    StAssign(name, name_place, value) => Refl
    StCalled(name_generates, value) => Refl
    StFn(f) => Refl
    StEffect(e) => Refl
    StWhile(condition, body) => Refl
    StReturn(e) => Refl
    StExpr(e) => Refl
    StTheorem(pat_t) => Refl
    StDef(pat_t) => Refl
    StMutual(pat_stmts, pat_start, pat_end) => Refl
    StImport(pat_path, pat_start, pat_end) => Refl
    StInductive(pat_i) => Refl
    StStruct(pat_d) => Refl
    StEnum(pat_d) => Refl
    StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end) => Refl
    StClass(pat_c) => Refl
    StInstance(pat_i) => Refl
    StMacro(pat_name, pat_function, pat_start, pat_end) => Refl
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => Refl
    StSyntax(pat_name, pat_grammar, pat_start, pat_end) => Refl
    StOther(what, start, end) => Refl
    StLoop(st_body, start, end) => Refl
    StModule(mod_name, mod_vis, mod_items, start, end) => Refl
    StReexport(re_path, re_names, re_spans, start, end) => Refl
    StFor(for_pat, for_src, st_body, start, end) => Refl
    StBreak(st_value, start, end) => Refl
    StContinue(start, end) => Refl
  } }
