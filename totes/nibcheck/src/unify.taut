import "rules_ty.taut"
import std::Map
import std::Text
import "checker.taut"
import "ty.taut"

// The unifier of `src/checker.taut` against the rules of `rules_ty.taut`
// (`docs/design/self-host.md`「層 2：`ck_unify`（`src/unify_sound.taut`）」).

pub fn ty_resolve_var(j: Nat, s: Ordmap(Nat, Ty), i: Nat, o: Option(Ty)): Ty {
  match o: Ty {
    Some(x) => ty_resolve_in(j, s, x)
    None => TyVar(i)
  }
}

pub theorem ty_option_cases<A: Type>(
  P: (Option(A)) -> Prop,
  o: Option(A),
  a: (o = None) -> P(None),
  b: ∀ x: A. (o = Some(x)) -> P(Some(x))
): P(o) {
  match o: P(o) {
    None => a(Refl)
    Some(x) => b(x, Refl)
  }
}

pub theorem tyeq_list_refl(
  s: Ordmap(Nat, Ty),
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
  ts: List(Ty)
): TyEqList(s, ok, ts, ts) {
  match ts: TyEqList(s, ok, ts, ts) {
    Nil => TyeqNil
    Cons(t, rest) => TyeqCons(TyeqRefl(t), tyeq_list_refl(s, ok, rest))
  }
}

// A type is the same type as itself resolved.
pub def ResolveEqAt(
  k: Nat,
  s: Ordmap(Nat, Ty),
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop
): Prop := ∀ t: Ty. TyEq(s, ok, t, ty_resolve_in(k, s, t))

pub def ResolveListEqAt(
  k: Nat,
  s: Ordmap(Nat, Ty),
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop
): Prop := ∀ ts: List(Ty). TyEqList(s, ok, ts, ty_resolve_list_in(k, s, ts))

pub theorem ty_resolve_list_step(
  j: Nat,
  s: Ordmap(Nat, Ty),
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
  ht: ResolveEqAt(j, s, ok),
  hl: ResolveListEqAt(j, s, ok),
  ts: List(Ty)
): TyEqList(s, ok, ts, ty_resolve_list_in(Succ(j), s, ts)) {
  match ts: TyEqList(s, ok, ts, ty_resolve_list_in(Succ(j), s, ts)) {
    Nil => TyeqNil
    Cons(t, rest) => TyeqCons(ht(t), hl(rest))
  }
}

pub theorem ty_resolve_step(
  j: Nat,
  s: Ordmap(Nat, Ty),
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
  ht: ResolveEqAt(j, s, ok),
  hl: ResolveListEqAt(j, s, ok),
  t: Ty
): TyEq(s, ok, t, ty_resolve_in(Succ(j), s, t)) {
  match t: TyEq(s, ok, t, ty_resolve_in(Succ(j), s, t)) {
    TyVar(i) => ty_option_cases(
      (o: Option(Ty)) => TyEq(s, ok, TyVar(i), ty_resolve_var(j, s, i, o)),
      Ordmap::get(s, i, Ordmap::compare_nat),
      (e: Ordmap::get(s, i, Ordmap::compare_nat) = None) => TyeqRefl(TyVar(i)),
      (x: Ty, e: Ordmap::get(s, i, Ordmap::compare_nat) = Some(x)) => TyeqTrans(
        TyeqVar(i, e),
        ht(x)
      )
    )
    TyFn(ps, r, fk) => TyeqFn(hl(ps), ht(r), KindSameRefl(fk))
    TyUnion(ts) => TyeqTrans(TyeqUnion(hl(ts)), TyeqUnionNorm(ty_resolve_list_in(j, s, ts)))
    TyProduct(ts) => TyeqTrans(TyeqProduct(hl(ts)), TyeqProductNorm(ty_resolve_list_in(j, s, ts)))
    TyTagged(tags, x) => TyeqTrans(
      TyeqTagged(tags, ht(x)),
      TyeqTaggedNorm(tags, ty_resolve_in(j, s, x))
    )
    TyNamed(n, args) => TyeqNamed(n, hl(args))
    TyInfo(x) => TyeqInfo(ht(x))
    TyBorrow(x, m) => TyeqBorrow(m, ht(x))
    TyInt(w) => TyeqRefl(TyInt(w))
    TyBool => TyeqRefl(TyBool)
    TyText => TyeqRefl(TyText)
    TyUnit => TyeqRefl(TyUnit)
    TyNever => TyeqRefl(TyNever)
    TyDecimal => TyeqRefl(TyDecimal)
    TyFloat => TyeqRefl(TyFloat)
    TyParam(n, pk) => TyeqRefl(TyParam(n, pk))
    TyPoly(gs, x) => TyeqPolyBody(gs, ht(x))
    TyApp(h, x) => TyeqTrans(
      TyeqApp(ht(h), ht(x)),
      TyeqAppNorm(ty_resolve_in(j, s, h), ty_resolve_in(j, s, x))
    )
  }
}

pub theorem ty_resolve_at(
  k: Nat,
  s: Ordmap(Nat, Ty),
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop
): And(ResolveEqAt(k, s, ok), ResolveListEqAt(k, s, ok)) {
  match k: And(ResolveEqAt(k, s, ok), ResolveListEqAt(k, s, ok)) {
    Zero => AndIntro((t: Ty) => TyeqRefl(t), (ts: List(Ty)) => tyeq_list_refl(s, ok, ts))
    Succ(j) => AndIntro(
      (t: Ty) => ty_resolve_step(
        j,
        s,
        ok,
        And::left(ty_resolve_at(j, s, ok)),
        And::right(ty_resolve_at(j, s, ok)),
        t
      ),
      (ts: List(Ty)) => ty_resolve_list_step(
        j,
        s,
        ok,
        And::left(ty_resolve_at(j, s, ok)),
        And::right(ty_resolve_at(j, s, ok)),
        ts
      )
    )
  }
}

pub theorem ty_resolve_eq(
  k: Nat,
  s: Ordmap(Nat, Ty),
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
  t: Ty
): TyEq(s, ok, t, ty_resolve_in(k, s, t)) {
  And::left(ty_resolve_at(k, s, ok))(t)
}

pub theorem ty_resolve_list_eq(
  k: Nat,
  s: Ordmap(Nat, Ty),
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
  ts: List(Ty)
): TyEqList(s, ok, ts, ty_resolve_list_in(k, s, ts)) {
  And::right(ty_resolve_at(k, s, ok))(ts)
}

// What is the same type under `s` is under a substitution that binds more,
// and with more uses of rigid types allowed.
pub def OkExt(
  ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
  ok2: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop
): Prop := ∀ gs: List(
  Pair(Text, Kind)
). ∀ r: Ordmap(Text, Ty). ∀ a: Ty. ∀ b: Ty. (ok(gs, r, a, b)) -> ok2(gs, r, a, b)

mutual {
  pub theorem tyeq_list_move(
    s: Ordmap(Nat, Ty),
    ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
    s2: Ordmap(Nat, Ty),
    ok2: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
    hs: SubstExt(s, s2),
    hk: OkExt(ok, ok2),
    xs: List(Ty),
    ys: List(Ty),
    h: TyEqList(s, ok, xs, ys)
  ): TyEqList(s2, ok2, xs, ys) {
    match h: TyEqList(s2, ok2, xs, ys) {
      TyeqNil => TyeqNil
      TyeqCons(x, y, xs1, ys1, h1, h2) => TyeqCons(
        tyeq_move(s, ok, s2, ok2, hs, hk, x, y, h1),
        tyeq_list_move(s, ok, s2, ok2, hs, hk, xs1, ys1, h2)
      )
    }
  }

  pub theorem tyeq_move(
    s: Ordmap(Nat, Ty),
    ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
    s2: Ordmap(Nat, Ty),
    ok2: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
    hs: SubstExt(s, s2),
    hk: OkExt(ok, ok2),
    a: Ty,
    b: Ty,
    h: TyEq(s, ok, a, b)
  ): TyEq(s2, ok2, a, b) {
    match h: TyEq(s2, ok2, a, b) {
      TyeqRefl(a1) => TyeqRefl(a1)
      TyeqSym(a1, b1, h1) => TyeqSym(tyeq_move(s, ok, s2, ok2, hs, hk, a1, b1, h1))
      TyeqTrans(a1, b1, c1, h1, h2) => TyeqTrans(
        tyeq_move(s, ok, s2, ok2, hs, hk, a1, b1, h1),
        tyeq_move(s, ok, s2, ok2, hs, hk, b1, c1, h2)
      )
      TyeqVar(t1, i, e) => TyeqVar(i, hs(i, t1, e))
      TyeqFn(ps, qs, r, r2, k, k2, hp, hr, hks) => TyeqFn(
        tyeq_list_move(s, ok, s2, ok2, hs, hk, ps, qs, hp),
        tyeq_move(s, ok, s2, ok2, hs, hk, r, r2, hr),
        hks
      )
      TyeqUnion(xs, ys, h1) => TyeqUnion(tyeq_list_move(s, ok, s2, ok2, hs, hk, xs, ys, h1))
      TyeqUnionNorm(xs) => TyeqUnionNorm(xs)
      TyeqProduct(xs, ys, h1) => TyeqProduct(tyeq_list_move(s, ok, s2, ok2, hs, hk, xs, ys, h1))
      TyeqProductNorm(xs) => TyeqProductNorm(xs)
      TyeqTagged(x, y, tags, h1) => TyeqTagged(tags, tyeq_move(s, ok, s2, ok2, hs, hk, x, y, h1))
      TyeqTaggedNorm(tags, x) => TyeqTaggedNorm(tags, x)
      TyeqNamed(xs, ys, n, h1) => TyeqNamed(n, tyeq_list_move(s, ok, s2, ok2, hs, hk, xs, ys, h1))
      TyeqInfo(x, y, h1) => TyeqInfo(tyeq_move(s, ok, s2, ok2, hs, hk, x, y, h1))
      TyeqBorrow(x, y, m, h1) => TyeqBorrow(m, tyeq_move(s, ok, s2, ok2, hs, hk, x, y, h1))
      TyeqApp(h1, h2, x1, x2, hh, hx) => TyeqApp(
        tyeq_move(s, ok, s2, ok2, hs, hk, h1, h2, hh),
        tyeq_move(s, ok, s2, ok2, hs, hk, x1, x2, hx)
      )
      TyeqAppNorm(f, x) => TyeqAppNorm(f, x)
      TyeqPolyBody(x, y, gs, h1) => TyeqPolyBody(
        gs,
        tyeq_move(s, ok, s2, ok2, hs, hk, x, y, h1)
      )
      TyeqPoly(ta, tb, ga, gb, rigid, hq, hr, h1) => TyeqPoly(
        ga,
        gb,
        rigid,
        hq,
        hk(ga, rigid, TyPoly(ga, ta), TyPoly(gb, tb), hr),
        tyeq_move(
          s,
          ok,
          s2,
          ok2,
          hs,
          hk,
          ty_substitute(ta, rigid),
          ty_substitute(tb, ty_poly_map(gb, ga, rigid)),
          h1
        )
      )
    }
  }
}
