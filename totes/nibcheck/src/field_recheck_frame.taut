import "datas_registration.taut"
import std::Map
import std::Text
import "checker.taut"
import "datas_frame.taut"
import "ty.taut"
import "types_decl.taut"
import "types_run.taut"
import "unify_sound.taut"
import "../../surface/src/surface.taut"

pub fn recheck_fields_cons(
  f: SurfaceDataField,
  rest: List(SurfaceDataField),
  c: Checker,
  generics: Ordmap(Text, Ty)
): Mut1(Unit, Checker) {
  frame_bind(
    Ty,
    Unit,
    (ignored: Ty, next: Checker) => ck_rewrap1(ck_recheck_fields(rest, next, generics)),
    ck_written(c, registration_field_ty(f), generics)
  )
}
pub theorem recheck_fields_cons_unf(
  f: SurfaceDataField,
  rest: List(SurfaceDataField),
  c: Checker,
  generics: Ordmap(Text, Ty)
): ck_recheck_fields(Cons(f, rest), c, generics) = recheck_fields_cons(f, rest, c, generics) {
  Refl
}
pub theorem recheck_fields_cons_frame(
  f: SurfaceDataField,
  rest: List(SurfaceDataField),
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkReadFrame(next, ck_recheck_fields(rest, next, generics))
): CkReadFrame(c, recheck_fields_cons(f, rest, c, generics)) {
  frame_bind_ok(
    Ty,
    Unit,
    c,
    (ignored: Ty, next: Checker) => ck_rewrap1(ck_recheck_fields(rest, next, generics)),
    ck_written(c, registration_field_ty(f), generics),
    ck_written_frame(c, registration_field_ty(f), generics),
    ignored => next => frame_rewrap(next, ck_recheck_fields(rest, next, generics), ih(next))
  )
}
pub theorem ck_recheck_fields_frame(
  xs: List(SurfaceDataField),
  c: Checker,
  generics: Ordmap(Text, Ty)
): CkReadFrame(c, ck_recheck_fields(xs, c, generics)) {
  ⊢ CkReadFrame(c, ck_recheck_fields(xs, c, generics)) from match xs {
    Nil => Refl
    Cons(f, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkReadFrame(c, m),
      Eq::sym(recheck_fields_cons_unf(f, rest, c, generics)),
      recheck_fields_cons_frame(
        f,
        rest,
        c,
        generics,
        next => ck_recheck_fields_frame(rest, next, generics)
      )
    )
  }
}

pub fn recheck_ctors_cons(
  k: SurfaceDataCtor,
  rest: List(SurfaceDataCtor),
  c: Checker,
  generics: Ordmap(Text, Ty)
): Mut1(Unit, Checker) {
  frame_bind(
    Unit,
    Unit,
    (ignored: Unit, next: Checker) => ck_rewrap1(ck_recheck_ctors(rest, next, generics)),
    ck_recheck_fields(registration_ctor_fields(k), c, generics)
  )
}
pub theorem recheck_ctors_cons_unf(
  k: SurfaceDataCtor,
  rest: List(SurfaceDataCtor),
  c: Checker,
  generics: Ordmap(Text, Ty)
): ck_recheck_ctors(Cons(k, rest), c, generics) = recheck_ctors_cons(k, rest, c, generics) { Refl }
pub theorem recheck_ctors_cons_frame(
  k: SurfaceDataCtor,
  rest: List(SurfaceDataCtor),
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkReadFrame(next, ck_recheck_ctors(rest, next, generics))
): CkReadFrame(c, recheck_ctors_cons(k, rest, c, generics)) {
  frame_bind_ok(
    Unit,
    Unit,
    c,
    (ignored: Unit, next: Checker) => ck_rewrap1(ck_recheck_ctors(rest, next, generics)),
    ck_recheck_fields(registration_ctor_fields(k), c, generics),
    ck_recheck_fields_frame(registration_ctor_fields(k), c, generics),
    ignored => next => frame_rewrap(next, ck_recheck_ctors(rest, next, generics), ih(next))
  )
}
pub theorem ck_recheck_ctors_frame(
  xs: List(SurfaceDataCtor),
  c: Checker,
  generics: Ordmap(Text, Ty)
): CkReadFrame(c, ck_recheck_ctors(xs, c, generics)) {
  ⊢ CkReadFrame(c, ck_recheck_ctors(xs, c, generics)) from match xs {
    Nil => Refl
    Cons(k, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkReadFrame(c, m),
      Eq::sym(recheck_ctors_cons_unf(k, rest, c, generics)),
      recheck_ctors_cons_frame(
        k,
        rest,
        c,
        generics,
        next => ck_recheck_ctors_frame(rest, next, generics)
      )
    )
  }
}

pub fn recheck_datas_cons(
  d: SurfaceData,
  rest: List(SurfaceData),
  c: Checker
): Mut1(Unit, Checker) {
  frame_bind(
    Unit,
    Unit,
    (ignored: Unit, next: Checker) => ck_rewrap1(ck_recheck_datas(rest, next)),
    ck_recheck_ctors(
      registration_ctors(d),
      c,
      ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
    )
  )
}
pub theorem recheck_datas_cons_unf(
  d: SurfaceData,
  rest: List(SurfaceData),
  c: Checker
): ck_recheck_datas(Cons(d, rest), c) = recheck_datas_cons(d, rest, c) { Refl }
pub theorem recheck_datas_cons_frame(
  d: SurfaceData,
  rest: List(SurfaceData),
  c: Checker,
  ih: ∀ next: Checker. CkReadFrame(next, ck_recheck_datas(rest, next))
): CkReadFrame(c, recheck_datas_cons(d, rest, c)) {
  frame_bind_ok(
    Unit,
    Unit,
    c,
    (ignored: Unit, next: Checker) => ck_rewrap1(ck_recheck_datas(rest, next)),
    ck_recheck_ctors(
      registration_ctors(d),
      c,
      ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
    ),
    ck_recheck_ctors_frame(
      registration_ctors(d),
      c,
      ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
    ),
    ignored => next => frame_rewrap(next, ck_recheck_datas(rest, next), ih(next))
  )
}
pub theorem ck_recheck_datas_frame(
  xs: List(SurfaceData),
  c: Checker
): CkReadFrame(c, ck_recheck_datas(xs, c)) {
  ⊢ CkReadFrame(c, ck_recheck_datas(xs, c)) from match xs {
    Nil => Refl
    Cons(d, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkReadFrame(c, m),
      Eq::sym(recheck_datas_cons_unf(d, rest, c)),
      recheck_datas_cons_frame(d, rest, c, next => ck_recheck_datas_frame(rest, next))
    )
  }
}
