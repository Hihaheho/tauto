pub theorem inference_arm_tail_frame_checked(
  j: Nat,
  c: Checker,
  inner: Scope,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  rigid: List(Text),
  names: List(TypeName),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(
  c,
  inference_arm_tail(j, c, inner, env, result, rv, eff, rigid, names, guard, body)
) {
  checked_frame_bind(
    Unit,
    Unit,
    c,
    (entered: Unit, c1: Checker) => frame_bind(
      Unit,
      Unit,
      (guarded: Unit, c2: Checker) => frame_bind(
        Ty,
        Unit,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner))
    ),
    ck_arm_enter(c, names),
    checked_frame_read(
      c,
      ck_arm_enter(c, names),
      ck_arm_enter_frame(c, names),
      ck_arm_enter_frame_errors(c, names),
      ordered
    ),
    entered => c1 => o_c1 => checked_frame_bind(
      Unit,
      Unit,
      c1,
      (guarded: Unit, c2: Checker) => frame_bind(
        Ty,
        Unit,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner)),
      inference_use_ck_guard_in_checked(j, c1, guard, inference_scope_items(inner), o_c1, ih),
      guarded => c2 => o_c2 => checked_frame_bind(
        Ty,
        Unit,
        c2,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner)),
        inference_use_ck_infer_in_checked(j, c2, body, inference_scope_items(inner), o_c2, ih),
        a => c3 => o_c3 => checked_frame_rewrap(
          c3,
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          ),
          ck_handle_arm_finish_run_frame_checked(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body),
            o_c3
          )
        )
      )
    )
  )
}

pub theorem inference_handle_body_step_frame_checked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  params: List(Ty),
  answer: Ty,
  rigid: List(Text),
  names: List(TypeName),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  quant: Quant,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(
  c,
  inference_handle_body_step(
    j,
    c,
    env,
    result,
    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body,
    quant
  )
) {
  checked_frame_bind(
    Unit,
    Unit,
    c,
    (r#direct: Unit, c1: Checker) => inference_bind_scope(
      Unit,
      Unit,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        Unit,
        Unit,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body)
    ),
    ck_handle_direct(c, quant, eff, cont, guard, body),
    checked_frame_read(
      c,
      ck_handle_direct(c, quant, eff, cont, guard, body),
      ck_handle_direct_frame(c, quant, eff, cont, guard, body),
      ck_handle_direct_frame_errors(c, quant, eff, cont, guard, body),
      ordered
    ),
    r#direct => c1 => o_c1 => inference_bind_scope_frame_checked(
      Unit,
      Unit,
      c1,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        Unit,
        Unit,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body),
      ck_handle_patterns_frame_checked(patterns, c1, params, ScopeMk(env), body, o_c1),
      matched => c2 => inner => o_c2 => inference_bind_scope_frame_checked(
        Unit,
        Unit,
        c2,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body),
        ck_handle_cont_frame_checked(c2, inner, quant, eff, cont, answer, result, body, o_c2),
        bound => c3 => inner2 => o_c3 => inference_arm_tail_frame_checked(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body,
          ih,
          o_c3
        )
      )
    )
  )
}

pub theorem inference_step_ck_handle_body_in_frame_checked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  params: List(Ty),
  answer: Ty,
  rigid: List(Text),
  names: List(TypeName),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(
  c,
  inference_step_ck_handle_body_in(
    j,
    c,
    env,
    result,
    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body
  )
) {
  inference_handle_body_step_frame_checked(
    j,
    c,
    env,
    result,
    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body,
    ck_quant_of(c, eff),
    ih,
    ordered
  )
}

pub theorem inference_handler_arity_frame_checked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  pa: ArmSig,
  wrong: Bool,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(
  c,
  inference_handler_arity(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body,
    pa,
    wrong
  )
) {
  ⊢ CkCheckedFrame(
    c,
    inference_handler_arity(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      pa,
      wrong
    )
  ) from match wrong {
    true => checked_frame_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        ),
        ck_error_frame(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        )
      ),
      error_frame_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        ),
        ck_error_frame_errors(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        )
      ),
      ordered
    )
    false => checked_frame_rewrap(
      c,
      ck_handle_body_in(
        j,
        c,
        env,
        result,
        rv,
        eff,
        inference_handler_params(pa),
        inference_handler_answer(pa),
        inference_handler_rigid(pa),
        inference_handler_names(pa),
        patterns,
        cont,
        guard,
        body
      ),
      inference_use_ck_handle_body_in_checked(
        j,
        c,
        env,
        result,
        rv,
        eff,
        inference_handler_params(pa),
        inference_handler_answer(pa),
        inference_handler_rigid(pa),
        inference_handler_names(pa),
        patterns,
        cont,
        guard,
        body,
        ordered,
        ih
      )
    )
  }
}

pub theorem inference_handler_signature_frame_checked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  signature: Option(ArmSig),
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(
  c,
  inference_handler_signature(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body,
    signature
  )
) {
  ⊢ CkCheckedFrame(
    c,
    inference_handler_signature(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature
    )
  ) from match signature {
    None => checked_frame_return(c, Star, ordered)
    Some(pa) => inference_handler_arity_frame_checked(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      pa,
      not(Nat::eq(list_len(inference_handler_params(pa)), list_len(patterns))),
      ih,
      ordered
    )
  }
}

pub theorem inference_step_ck_handle_arm_in_frame_checked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(
  c,
  inference_step_ck_handle_arm_in(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body
  )
) {
  checked_frame_bind(
    Option(ArmSig),
    Unit,
    c,
    (signature: Option(ArmSig), c1: Checker) => inference_handler_signature(
      j,
      c1,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature
    ),
    ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body),
    checked_frame_read(
      c,
      ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body),
      ck_handle_arm_sig_frame(c, eff, binds, types, result, rv, budget_ty, body),
      ck_handle_arm_sig_frame_errors(c, eff, binds, types, result, rv, budget_ty, body),
      ordered
    ),
    signature => c1 => o_c1 => inference_handler_signature_frame_checked(
      j,
      c1,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature,
      ih,
      o_c1
    )
  )
}

pub theorem inference_budget_push_frame_checked(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_budget_push(j, c, body, handlers, env, budget_ty, answers)) {
  ⊢ CkCheckedFrame(
    c,
    inference_budget_push(j, c, body, handlers, env, budget_ty, answers)
  ) from match answers {
    true => checked_frame_read(
      c,
      inference_set_exceeded(c, Cons(budget_ty, inference_exceeded(c))),
      inference_set_exceeded_frame(c, Cons(budget_ty, inference_exceeded(c))),
      inference_set_exceeded_frame_errors(c, Cons(budget_ty, inference_exceeded(c))),
      ordered
    )
    false => checked_frame_return(c, Star, ordered)
  }
}

pub theorem inference_budget_pop_frame_checked(
  j: Nat,
  c: Checker,
  answers: Bool,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_budget_pop(j, c, answers)) {
  ⊢ CkCheckedFrame(c, inference_budget_pop(j, c, answers)) from match answers {
    true => checked_frame_read(
      c,
      inference_set_exceeded(c, List::tail(inference_exceeded(c))),
      inference_set_exceeded_frame(c, List::tail(inference_exceeded(c))),
      inference_set_exceeded_frame_errors(c, List::tail(inference_exceeded(c))),
      ordered
    )
    false => checked_frame_return(c, Star, ordered)
  }
}

pub theorem inference_handle_budget_frame_checked(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_handle_budget(j, c, body, handlers, env, budget_ty, answers)) {
  checked_frame_bind(
    Unit,
    Ty,
    c,
    (pushed: Unit, c1: Checker) => frame_bind(
      Ty,
      Ty,
      (b: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env)
    ),
    inference_budget_push(j, c, body, handlers, env, budget_ty, answers),
    inference_budget_push_frame_checked(j, c, body, handlers, env, budget_ty, answers, ih, ordered),
    pushed => c1 => o_c1 => checked_frame_bind(
      Ty,
      Ty,
      c1,
      (b: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env),
      inference_use_ck_infer_in_checked(j, c1, body, env, o_c1, ih),
      b => c2 => o_c2 => checked_frame_bind(
        Unit,
        Ty,
        c2,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers),
        inference_budget_pop_frame_checked(j, c2, answers, ih, o_c2),
        popped => c3 => o_c3 => checked_frame_bind(
          Ty,
          Ty,
          c3,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3),
          checked_frame_read(c3, ck_fresh(c3), ck_fresh_frame(c3), ck_fresh_frame_errors(c3), o_c3),
          result => c4 => o_c4 => checked_frame_bind(
            Ty,
            Ty,
            c4,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env),
            inference_use_ck_handle_first_in_checked(j, c4, handlers, b, env, o_c4, ih),
            first => c5 => o_c5 => checked_frame_bind(
              Unit,
              Ty,
              c5,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty),
              inference_use_ck_handle_result_in_checked(
                j,
                c5,
                handlers,
                env,
                result,
                first,
                budget_ty,
                o_c5,
                ih
              ),
              finished => c6 => o_c6 => checked_frame_return(c6, result, o_c6)
            )
          )
        )
      )
    )
  )
}

pub theorem inference_step_ck_handle_in_frame_checked(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_step_ck_handle_in(j, c, body, handlers, env)) {
  checked_frame_bind(
    Ty,
    Ty,
    c,
    (budget_ty: Ty, c1: Checker) => inference_handle_budget(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers)
    ),
    ck_fresh(c),
    checked_frame_read(c, ck_fresh(c), ck_fresh_frame(c), ck_fresh_frame_errors(c), ordered),
    budget_ty => c1 => o_c1 => inference_handle_budget_frame_checked(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers),
      ih,
      o_c1
    )
  )
}
