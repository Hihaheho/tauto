import "../../identity/src/identity.taut"
import "messages.taut"
import "checker_frame.taut"
import std::text
import "checker.taut"
import "datas.taut"
import "datas_frame.taut"
import "ty.taut"
import "types_match.taut"
import "unify_sound.taut"
import "../../surface/src/surface.taut"

pub fn pattern_fresh_cons(g: Text, rest: List(Text), c: Checker): Mut1(List(Ty), Checker) {
  frame_bind(
    <A: Ty, B: List(Ty)>,
    (h: Ty, c1: Checker) => frame_bind(
      <A: List(Ty), B: List(Ty)>,
      (tl: List(Ty), c2: Checker) => mut1(Cons(h, tl), c2),
      ck_fresh_each(rest, c1)
    ),
    ck_fresh(c)
  )
}

pub theorem pattern_fresh_cons_frame(
  g: Text,
  rest: List(Text),
  c: Checker,
  ih: ∀ next: Checker. CkReadFrame(next, ck_fresh_each(rest, next))
): CkReadFrame(c, pattern_fresh_cons(g, rest, c)) {
  frame_bind_ok(
    <A: Ty, B: List(Ty)>,
    c,
    (h: Ty, c1: Checker) => frame_bind(
      <A: List(Ty), B: List(Ty)>,
      (tl: List(Ty), c2: Checker) => mut1(Cons(h, tl), c2),
      ck_fresh_each(rest, c1)
    ),
    ck_fresh(c),
    ck_fresh_frame(c),
    h => c1 => frame_bind_ok(
      <A: List(Ty), B: List(Ty)>,
      c1,
      (tl: List(Ty), c2: Checker) => mut1(Cons(h, tl), c2),
      ck_fresh_each(rest, c1),
      ih(c1),
      tl => c2 => Refl
    )
  )
}

pub theorem pattern_fresh_unf(
  g: Text,
  rest: List(Text),
  c: Checker
): ck_fresh_each(Cons(g, rest), c) = pattern_fresh_cons(g, rest, c) { Refl }

pub theorem ck_fresh_each_frame(gs: List(Text), c: Checker): CkReadFrame(c, ck_fresh_each(gs, c)) {
  match gs {
    Nil => Refl
    Cons(g, rest) => Eq::subst(
      (z: Mut1(List(Ty), Checker)) => CkReadFrame(c, z),
      Eq::sym(pattern_fresh_unf(g, rest, c)),
      pattern_fresh_cons_frame(g, rest, c, next => ck_fresh_each_frame(rest, next))
    )
  }
}

pub fn pattern_literal_after(
  c: Checker,
  l: Ty,
  target: Ty,
  span: TySpan,
  same: Bool
): Mut1(Unit, Checker) {
  frame_error_if(
    c,
    pattern_cannot_match_message(ty_show(ck_resolve(c, l)), ty_show(ck_resolve(c, target))),
    span,
    not(same)
  )
}

pub theorem pattern_literal_after_frame(
  c: Checker,
  l: Ty,
  target: Ty,
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_literal_after(c, l, target, span, same)) {
  run_frame_read(
    c,
    frame_error_if(
      c,
      pattern_cannot_match_message(ty_show(ck_resolve(c, l)), ty_show(ck_resolve(c, target))),
      span,
      not(same)
    ),
    frame_error_if_ok(
      c,
      pattern_cannot_match_message(ty_show(ck_resolve(c, l)), ty_show(ck_resolve(c, target))),
      span,
      not(same)
    ),
    ordered
  )
}

pub fn pattern_literal(c: Checker, l: Ty, target: Ty, span: TySpan): Mut1(Unit, Checker) {
  frame_bind(
    <A: Bool, B: Unit>,
    (same: Bool, c1: Checker) => pattern_literal_after(c1, l, target, span, same),
    ck_unify(c, l, target)
  )
}

pub theorem pattern_literal_frame(
  c: Checker,
  l: Ty,
  target: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_literal(c, l, target, span)) {
  run_frame_bind(
    <A: Bool, B: Unit>,
    c,
    (same: Bool, c1: Checker) => pattern_literal_after(c1, l, target, span, same),
    ck_unify(c, l, target),
    ck_unify_run_frame(c, l, target, ordered),
    same => c1 => o_c1 => pattern_literal_after_frame(c1, l, target, span, same, o_c1)
  )
}

pub theorem pattern_literal_unf(
  c: Checker,
  l: Ty,
  t: Ty,
  span: TySpan
): ck_pattern_literal(
  c,
  l,
  t,
  span
) = pattern_literal(c, l, ty_unborrowed(ck_resolve(c, t)), span) { Refl }

pub theorem ck_pattern_literal_run_frame(
  c: Checker,
  l: Ty,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_pattern_literal(c, l, t, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
    Eq::sym(pattern_literal_unf(c, l, t, span)),
    pattern_literal_frame(c, l, ty_unborrowed(ck_resolve(c, t)), span, ordered)
  )
}

pub fn pattern_ctor_name(dc: Text × Nat): Text { dc.fst }
pub fn pattern_ctor_index(dc: Text × Nat): Nat { dc.snd }

pub fn pattern_ctor_arity(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  fields: List(DataField),
  span: TySpan,
  same: Bool
): Mut1(Option(List(DataField)), Checker) {
  match same {
    false => mut1(Some(fields), c)
    true => frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(
        c,
        pattern_field_count_message(name, Text::of_nat(list_len(fields)), Text::of_nat(list_len(args))),
        span
      )
    )
  }
}

pub theorem pattern_ctor_arity_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  fields: List(DataField),
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_ctor_arity(c, name, args, fields, span, same)) {
  match same {
    false => run_frame_return(c, Some(fields), ordered)
    true => run_frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(
        c,
        pattern_field_count_message(name, Text::of_nat(list_len(fields)), Text::of_nat(list_len(args))),
        span
      ),
      run_frame_read(
        c,
        ck_error(
          c,
          pattern_field_count_message(name, Text::of_nat(list_len(fields)), Text::of_nat(list_len(args))),
          span
        ),
        ck_error_frame(
          c,
          pattern_field_count_message(name, Text::of_nat(list_len(fields)), Text::of_nat(list_len(args))),
          span
        ),
        ordered
      ),
      ignored => c1 => o_c1 => run_frame_return(c1, None, o_c1)
    )
  }
}

pub fn pattern_ctor_same(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  dc: Text × Nat,
  targs: List(Ty),
  target: Ty,
  same: Bool
): Mut1(Option(List(DataField)), Checker) {
  match same {
    false => pattern_ctor_arity(
      c,
      name,
      args,
      datas_fields(ck_datas_of(c), pattern_ctor_name(dc), pattern_ctor_index(dc), targs),
      span,
      not(
        Nat::eq(
          list_len(
            datas_fields(ck_datas_of(c), pattern_ctor_name(dc), pattern_ctor_index(dc), targs)
          ),
          list_len(args)
        )
      )
    )
    true => frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(
        c,
        pattern_cannot_match_message(pattern_ctor_name(dc), ty_show(ck_shown(c, target))),
        span
      )
    )
  }
}

pub theorem pattern_ctor_same_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  dc: Text × Nat,
  targs: List(Ty),
  target: Ty,
  same: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_ctor_same(c, name, args, t, span, dc, targs, target, same)) {
  match same {
    false => pattern_ctor_arity_frame(
      c,
      name,
      args,
      datas_fields(ck_datas_of(c), pattern_ctor_name(dc), pattern_ctor_index(dc), targs),
      span,
      not(
        Nat::eq(
          list_len(
            datas_fields(ck_datas_of(c), pattern_ctor_name(dc), pattern_ctor_index(dc), targs)
          ),
          list_len(args)
        )
      ),
      ordered
    )
    true => run_frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(
        c,
        pattern_cannot_match_message(pattern_ctor_name(dc), ty_show(ck_shown(c, target))),
        span
      ),
      run_frame_read(
        c,
        ck_error(
          c,
          pattern_cannot_match_message(pattern_ctor_name(dc), ty_show(ck_shown(c, target))),
          span
        ),
        ck_error_frame(
          c,
          pattern_cannot_match_message(pattern_ctor_name(dc), ty_show(ck_shown(c, target))),
          span
        ),
        ordered
      ),
      ignored => c1 => o_c1 => run_frame_return(c1, None, o_c1)
    )
  }
}

pub fn pattern_ctor_unify(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  dc: Text × Nat,
  targs: List(Ty),
  target: Ty
): Mut1(Option(List(DataField)), Checker) {
  frame_bind(
    <A: Bool, B: Option(List(DataField))>,
    (same: Bool, c1: Checker) => pattern_ctor_same(
      c1,
      name,
      args,
      t,
      span,
      dc,
      targs,
      target,
      not(same)
    ),
    ck_unify(c, target, TyNamed(NameSpelled(pattern_ctor_name(dc)), targs))
  )
}

pub theorem pattern_ctor_unify_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  dc: Text × Nat,
  targs: List(Ty),
  target: Ty,
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_ctor_unify(c, name, args, t, span, dc, targs, target)) {
  run_frame_bind(
    <A: Bool, B: Option(List(DataField))>,
    c,
    (same: Bool, c1: Checker) => pattern_ctor_same(
      c1,
      name,
      args,
      t,
      span,
      dc,
      targs,
      target,
      not(same)
    ),
    ck_unify(c, target, TyNamed(NameSpelled(pattern_ctor_name(dc)), targs)),
    ck_unify_run_frame(c, target, TyNamed(NameSpelled(pattern_ctor_name(dc)), targs), ordered),
    same => c1 => o_c1 => pattern_ctor_same_frame(
      c1,
      name,
      args,
      t,
      span,
      dc,
      targs,
      target,
      not(same),
      o_c1
    )
  )
}

// The constructor `name` is not of a data: the fields of `Zero` or `Succ` on
// `Nat`, or else reported.
pub fn pattern_ctor_missing(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  nat: Option(List(DataField))
): Mut1(Option(List(DataField)), Checker) {
  match nat {
    Some(fields) => mut1(Some(fields), c)
    None => frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, datas_pattern_ctor_error(ck_datas_of(c), name, ty_unborrowed(ck_resolve(c, t))), span)
    )
  }
}

pub fn pattern_ctor_lookup(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  found: Option(Text × Nat)
): Mut1(Option(List(DataField)), Checker) {
  match found {
    None => pattern_ctor_missing(
      c,
      name,
      args,
      t,
      span,
      nat_pattern_fields(ck_datas_of(c), name, args, ty_unborrowed(ck_resolve(c, t)))
    )
    Some(dc) => frame_bind(
      <A: List(Ty), B: Option(List(DataField))>,
      (targs: List(Ty), c1: Checker) => pattern_ctor_unify(
        c1,
        name,
        args,
        t,
        span,
        dc,
        targs,
        ty_unborrowed(ck_resolve(c1, t))
      ),
      ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c)
    )
  }
}

pub theorem pattern_ctor_missing_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  nat: Option(List(DataField)),
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_ctor_missing(c, name, args, t, span, nat)) {
  match nat {
    Some(fields) => run_frame_return(c, Some(fields), ordered)
    None => run_frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, datas_pattern_ctor_error(ck_datas_of(c), name, ty_unborrowed(ck_resolve(c, t))), span),
      run_frame_read(
        c,
        ck_error(c, datas_pattern_ctor_error(ck_datas_of(c), name, ty_unborrowed(ck_resolve(c, t))), span),
        ck_error_frame(c, datas_pattern_ctor_error(ck_datas_of(c), name, ty_unborrowed(ck_resolve(c, t))), span),
        ordered
      ),
      ignored => c1 => o_c1 => run_frame_return(c1, None, o_c1)
    )
  }
}

pub theorem pattern_ctor_lookup_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  found: Option(Text × Nat),
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_ctor_lookup(c, name, args, t, span, found)) {
  match found {
    None => pattern_ctor_missing_frame(
      c,
      name,
      args,
      t,
      span,
      nat_pattern_fields(ck_datas_of(c), name, args, ty_unborrowed(ck_resolve(c, t))),
      ordered
    )
    Some(dc) => run_frame_bind(
      <A: List(Ty), B: Option(List(DataField))>,
      c,
      (targs: List(Ty), c1: Checker) => pattern_ctor_unify(
        c1,
        name,
        args,
        t,
        span,
        dc,
        targs,
        ty_unborrowed(ck_resolve(c1, t))
      ),
      ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
      run_frame_read(
        c,
        ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ordered
      ),
      targs => c1 => o_c1 => pattern_ctor_unify_frame(
        c1,
        name,
        args,
        t,
        span,
        dc,
        targs,
        ty_unborrowed(ck_resolve(c1, t)),
        o_c1
      )
    )
  }
}

pub theorem pattern_ctor_fields_unf(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan
): ck_data_ctor_fields(
  c,
  name,
  args,
  t,
  span
) = pattern_ctor_lookup(
  c,
  name,
  args,
  t,
  span,
  datas_ctor_expected(ck_datas_of(c), name, ck_resolve(c, t))
) { Refl }

pub theorem ck_data_ctor_fields_run_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_data_ctor_fields(c, name, args, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => CkRunFrame(c, z),
    Eq::sym(pattern_ctor_fields_unf(c, name, args, t, span)),
    pattern_ctor_lookup_frame(
      c,
      name,
      args,
      t,
      span,
      datas_ctor_expected(ck_datas_of(c), name, ck_resolve(c, t)),
      ordered
    )
  )
}

pub fn pattern_product_same(
  c: Checker,
  t: Ty,
  span: TySpan,
  parts: List(Ty),
  target: Ty,
  same: Bool
): Mut1(Option(List(DataField)), Checker) {
  match same {
    false => mut1(Some(product_pattern_fields(parts)), c)
    true => frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, product_pattern_cannot_match_message(ty_show(ck_shown(c, target))), span)
    )
  }
}

pub fn pattern_product_unify(
  c: Checker,
  t: Ty,
  span: TySpan,
  parts: List(Ty),
  target: Ty
): Mut1(Option(List(DataField)), Checker) {
  frame_bind(
    <A: Bool, B: Option(List(DataField))>,
    (same: Bool, c1: Checker) => pattern_product_same(c1, t, span, parts, target, not(same)),
    ck_unify(c, target, ty_product_of(parts))
  )
}

pub fn pattern_product_fresh(c: Checker, t: Ty, span: TySpan): Mut1(Option(List(DataField)), Checker) {
  frame_bind(
    <A: List(Ty), B: Option(List(DataField))>,
    (parts: List(Ty), c1: Checker) => pattern_product_unify(
      c1,
      t,
      span,
      parts,
      ty_unborrowed(ck_resolve(c1, t))
    ),
    ck_fresh_each(product_pattern_names(), c)
  )
}

pub theorem pattern_product_unf(
  c: Checker,
  t: Ty,
  span: TySpan
): ck_product_fields(c, t, span) = pattern_product_fresh(c, t, span) { Refl }

pub fn pattern_fields_pick(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  product: Bool
): Mut1(Option(List(DataField)), Checker) {
  match product {
    true => ck_rewrap1(ck_product_fields(c, t, span))
    false => ck_rewrap1(ck_data_ctor_fields(c, name, args, t, span))
  }
}

pub theorem pattern_fields_pick_unf(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan
): ck_unlabelled_fields(
  c,
  name,
  args,
  t,
  span
) = pattern_fields_pick(c, name, args, t, span, Text::eq(name, surface_product_ctor())) { Refl }

pub theorem pattern_product_same_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  parts: List(Ty),
  target: Ty,
  same: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_product_same(c, t, span, parts, target, same)) {
  match same {
    false => run_frame_return(c, Some(product_pattern_fields(parts)), ordered)
    true => run_frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, product_pattern_cannot_match_message(ty_show(ck_shown(c, target))), span),
      run_frame_read(
        c,
        ck_error(c, product_pattern_cannot_match_message(ty_show(ck_shown(c, target))), span),
        ck_error_frame(c, product_pattern_cannot_match_message(ty_show(ck_shown(c, target))), span),
        ordered
      ),
      ignored => c1 => o_c1 => run_frame_return(c1, None, o_c1)
    )
  }
}

pub theorem pattern_product_unify_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  parts: List(Ty),
  target: Ty,
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_product_unify(c, t, span, parts, target)) {
  run_frame_bind(
    <A: Bool, B: Option(List(DataField))>,
    c,
    (same: Bool, c1: Checker) => pattern_product_same(c1, t, span, parts, target, not(same)),
    ck_unify(c, target, ty_product_of(parts)),
    ck_unify_run_frame(c, target, ty_product_of(parts), ordered),
    same => c1 => o_c1 => pattern_product_same_frame(c1, t, span, parts, target, not(same), o_c1)
  )
}

pub theorem ck_product_fields_run_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_product_fields(c, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => CkRunFrame(c, z),
    Eq::sym(pattern_product_unf(c, t, span)),
    run_frame_bind(
      <A: List(Ty), B: Option(List(DataField))>,
      c,
      (parts: List(Ty), c1: Checker) => pattern_product_unify(
        c1,
        t,
        span,
        parts,
        ty_unborrowed(ck_resolve(c1, t))
      ),
      ck_fresh_each(product_pattern_names(), c),
      run_frame_read(
        c,
        ck_fresh_each(product_pattern_names(), c),
        ck_fresh_each_frame(product_pattern_names(), c),
        ordered
      ),
      parts => c1 => o_c1 => pattern_product_unify_frame(
        c1,
        t,
        span,
        parts,
        ty_unborrowed(ck_resolve(c1, t)),
        o_c1
      )
    )
  )
}

pub theorem pattern_fields_pick_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  product: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, pattern_fields_pick(c, name, args, t, span, product)) {
  match product {
    true => run_frame_rewrap(
      c,
      ck_product_fields(c, t, span),
      ck_product_fields_run_frame(c, t, span, ordered)
    )
    false => run_frame_rewrap(
      c,
      ck_data_ctor_fields(c, name, args, t, span),
      ck_data_ctor_fields_run_frame(c, name, args, t, span, ordered)
    )
  }
}

pub theorem ck_unlabelled_fields_run_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_unlabelled_fields(c, name, args, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => CkRunFrame(c, z),
    Eq::sym(pattern_fields_pick_unf(c, name, args, t, span)),
    pattern_fields_pick_frame(
      c,
      name,
      args,
      t,
      span,
      Text::eq(name, surface_product_ctor()),
      ordered
    )
  )
}


pub theorem ck_label_fields_frame(
  c: Checker,
  tag: Text,
  target: Ty,
  span: TySpan,
  found: Option(Ty),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_label_fields(c, tag, target, span, found)) {
  match found {
    Some(under) => run_frame_return(c, Some(Cons(DataFieldMk(None, under), Nil)), ordered)
    None => run_frame_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, label_not_on_message(tag, ty_show(target)), span),
      run_frame_read(
        c,
        ck_error(c, label_not_on_message(tag, ty_show(target)), span),
        ck_error_frame(c, label_not_on_message(tag, ty_show(target)), span),
        ordered
      ),
      ignored => c1 => o_c1 => run_frame_return(c1, None, o_c1)
    )
  }
}

pub theorem ck_label_var_frame(c: Checker, tag: Text, target: Ty, o: CkOrdered(c)): CkRunFrame(c, ck_label_var(c, tag, target)) {
  run_frame_bind(
    <A: Ty, B: Option(Ty)>,
    c,
    (under: Ty, c1: Checker) => frame_bind(
      <A: Bool, B: Option(Ty)>,
      (ok: Bool, c2: Checker) => mut1(label_unified(ok, under), c2),
      ck_unify(c1, target, ty_tagged_with(Cons(tag, Nil), under))
    ),
    ck_fresh(c),
    run_frame_read(c, ck_fresh(c), ck_fresh_frame(c), o),
    under => c1 => o1 => run_frame_bind(
      <A: Bool, B: Option(Ty)>,
      c1,
      (ok: Bool, c2: Checker) => mut1(label_unified(ok, under), c2),
      ck_unify(c1, target, ty_tagged_with(Cons(tag, Nil), under)),
      ck_unify_run_frame(c1, target, ty_tagged_with(Cons(tag, Nil), under), o1),
      ok => c2 => o2 => run_frame_return(c2, label_unified(ok, under), o2)
    )
  )
}
pub theorem ck_label_found_frame(c: Checker, tag: Text, target: Ty, unsolved: Bool, o: CkOrdered(c)): CkRunFrame(c, ck_label_found(c, tag, target, unsolved)) {
  match unsolved {
    true => run_frame_rewrap(c, ck_label_var(c, tag, target), ck_label_var_frame(c, tag, target, o))
    false => run_frame_return(c, label_under(target, tag), o)
  }
}
pub theorem ck_label_at_frame(c: Checker, tag: Text, target: Ty, span: TySpan, o: CkOrdered(c)): CkRunFrame(c, ck_label_at(c, tag, target, span)) {
  run_frame_bind(
    <A: Option(Ty), B: Option(List(DataField))>,
    c,
    (found: Option(Ty), c1: Checker) => ck_rewrap1(ck_label_fields(c1, tag, target, span, found)),
    ck_label_found(c, tag, target, ty_is_var(target)),
    ck_label_found_frame(c, tag, target, ty_is_var(target), o),
    found => c1 => o1 => run_frame_rewrap(c1, ck_label_fields(c1, tag, target, span, found), ck_label_fields_frame(c1, tag, target, span, found, o1))
  )
}

pub theorem ck_ctor_fields_by_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  label: Option(Text),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_ctor_fields_by(c, name, args, t, span, label)) {
  match label {
    Some(tag) => run_frame_rewrap(
      c,
      ck_label_at(c, tag, ty_unborrowed(ck_resolve(c, t)), span),
      ck_label_at_frame(c, tag, ty_unborrowed(ck_resolve(c, t)), span, ordered)
    )
    None => Eq::subst(
      (z: Mut1(Option(List(DataField)), Checker)) => CkRunFrame(c, z),
      Eq::sym(ck_rewrap1_id(ck_unlabelled_fields(c, name, args, t, span))),
      ck_unlabelled_fields_run_frame(c, name, args, t, span, ordered)
    )
  }
}

pub theorem ck_ctor_fields_run_frame(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_ctor_fields(c, name, args, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => CkRunFrame(c, z),
    Eq::sym(ck_rewrap1_id(ck_ctor_fields_by(c, name, args, t, span, label_of_ctor(name)))),
    ck_ctor_fields_by_frame(c, name, args, t, span, label_of_ctor(name), ordered)
  )
}
