import "registration_data_error_sound.taut"
import "../../surface/src/surface.taut"

pub theorem registration_if_errors(
  c: Checker,
  m: Mut1(Unit, Checker),
  take: Bool,
  h: CkErrorFrame(c, m)
): CkErrorFrame(c, registration_if(c, m, take)) {
  match take: CkErrorFrame(c, registration_if(c, m, take)) {
    true => error_frame_rewrap(c, m, h)
    false => clean => clean
  }
}
pub theorem ck_program_data_one_errors(
  c: Checker,
  s: SurfaceStmt
): CkErrorFrame(c, ck_program_data_one(c, s)) {
  match s: CkErrorFrame(c, ck_program_data_one(c, s)) {
    StLet(name, ty, value, borrow, mutable) => clean => clean
    StVar(name, ty, value, borrow) => clean => clean
    StModule(name, stmts, start, end) => clean => clean
    StAssign(name, name_place, value) => clean => clean
    StCalled(name_generates, value) => clean => clean
    StFn(f) => clean => clean
    StTheorem(t) => clean => clean
    StDef(t) => clean => clean
    StMutual(stmts, start, end) => clean => clean
    StImport(path, start, end) => clean => clean
    StInductive(i) => clean => clean
    StEffect(e) => clean => clean
    StExtern(abi, fns, start, end) => clean => clean
    StClass(klass) => clean => clean
    StInstance(i) => clean => clean
    StWhile(cond, body) => clean => clean
    StReturn(value) => clean => clean
    StExpr(value) => clean => clean
    StOther(what, start, end) => clean => clean
    StMacro(name, function, start, end) => clean => clean
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => clean => clean
    StSyntax(name, grammar, start, end) => clean => clean
    StStruct(d) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
      Eq::sym(registration_program_StStruct_unf(d, c)),
      error_frame_rewrap(c, ck_declare_data(c, d, true, false), ck_declare_data_errors(c, d, true, false))
    )
    StEnum(d) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
      Eq::sym(registration_program_StEnum_unf(d, c)),
      error_frame_rewrap(c, ck_declare_data(c, d, false, false), ck_declare_data_errors(c, d, false, false))
    )
  }
}
pub theorem ck_program_data_errors(
  stmts: List(SurfaceStmt),
  c: Checker
): CkErrorFrame(c, ck_program_data(stmts, c)) {
  match stmts: CkErrorFrame(c, ck_program_data(stmts, c)) {
    Nil => clean => clean
    Cons(s, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
      Eq::sym(registration_program_unf(s, rest, c)),
      error_frame_bind(
        Unit,
        Unit,
        c,
        (ignored: Unit, next: Checker) => ck_rewrap1(ck_program_data(rest, next)),
        ck_program_data_one(c, s),
        ck_program_data_one_errors(c, s),
        ignored => next => error_frame_rewrap(
          next,
          ck_program_data(rest, next),
          ck_program_data_errors(rest, next)
        )
      )
    )
  }
}
pub theorem ck_prelude_data_one_errors(
  c: Checker,
  s: SurfaceStmt,
  own: Ordmap(Text, Bool)
): CkErrorFrame(c, ck_prelude_data_one(c, s, own)) {
  match s: CkErrorFrame(c, ck_prelude_data_one(c, s, own)) {
    StLet(name, ty, value, borrow, mutable) => clean => clean
    StVar(name, ty, value, borrow) => clean => clean
    StModule(name, stmts, start, end) => clean => clean
    StAssign(name, name_place, value) => clean => clean
    StCalled(name_generates, value) => clean => clean
    StFn(f) => clean => clean
    StTheorem(t) => clean => clean
    StDef(t) => clean => clean
    StMutual(stmts, start, end) => clean => clean
    StImport(path, start, end) => clean => clean
    StInductive(i) => clean => clean
    StExtern(abi, fns, start, end) => clean => clean
    StClass(klass) => clean => clean
    StInstance(i) => clean => clean
    StWhile(cond, body) => clean => clean
    StReturn(value) => clean => clean
    StExpr(value) => clean => clean
    StOther(what, start, end) => clean => clean
    StMacro(name, function, start, end) => clean => clean
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => clean => clean
    StSyntax(name, grammar, start, end) => clean => clean
    StEffect(e) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
      Eq::sym(registration_prelude_StEffect_unf(e, c, own)),
      registration_if_errors(
        c,
        ck_declare_effect(c, e),
        not(types_is_own(own, registration_effect_name(e))),
        ck_declare_effect_frame_errors(c, e)
      )
    )
    StStruct(d) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
      Eq::sym(registration_prelude_StStruct_unf(d, c, own)),
      registration_if_errors(
        c,
        ck_declare_data(c, d, true, data_is_opaque(registration_ctors(d))),
        not(types_is_own(own, registration_name(d))),
        ck_declare_data_errors(c, d, true, data_is_opaque(registration_ctors(d)))
      )
    )
    StEnum(d) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
      Eq::sym(registration_prelude_StEnum_unf(d, c, own)),
      registration_if_errors(
        c,
        ck_declare_data(c, d, false, false),
        not(types_is_own(own, registration_name(d))),
        ck_declare_data_errors(c, d, false, false)
      )
    )
  }
}
pub theorem ck_prelude_data_errors(
  stmts: List(SurfaceStmt),
  c: Checker,
  own: Ordmap(Text, Bool)
): CkErrorFrame(c, ck_prelude_data(stmts, c, own)) {
  match stmts: CkErrorFrame(c, ck_prelude_data(stmts, c, own)) {
    Nil => clean => clean
    Cons(s, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkErrorFrame(c, m),
      Eq::sym(registration_prelude_unf(s, rest, c, own)),
      error_frame_bind(
        Unit,
        Unit,
        c,
        (ignored: Unit, next: Checker) => ck_rewrap1(ck_prelude_data(rest, next, own)),
        ck_prelude_data_one(c, s, own),
        ck_prelude_data_one_errors(c, s, own),
        ignored => next => error_frame_rewrap(
          next,
          ck_prelude_data(rest, next, own),
          ck_prelude_data_errors(rest, next, own)
        )
      )
    )
  }
}
