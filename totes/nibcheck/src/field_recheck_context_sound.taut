import "field_recheck_frame.taut"
import "written_context_sound.taut"
import std::Map
import std::Text
import "checker.taut"
import "datas_registration.taut"
import "ty.taut"
import "types_decl.taut"
import "types_run.taut"
import "unify_sound.taut"
import "../../surface/src/surface.taut"

pub theorem recheck_fields_cons_frame_context(
  f: SurfaceDataField,
  rest: List(SurfaceDataField),
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkContextFrame(next, ck_recheck_fields(rest, next, generics))
): CkContextFrame(c, recheck_fields_cons(f, rest, c, generics)) {
  context_bind(
    Ty,
    Unit,
    c,
    (ignored: Ty, next: Checker) => ck_rewrap1(ck_recheck_fields(rest, next, generics)),
    ck_written(c, registration_field_ty(f), generics),
    ck_written_frame_context(c, registration_field_ty(f), generics),
    ignored => next => context_rewrap(next, ck_recheck_fields(rest, next, generics), ih(next))
  )
}

pub theorem ck_recheck_fields_frame_context(
  xs: List(SurfaceDataField),
  c: Checker,
  generics: Ordmap(Text, Ty)
): CkContextFrame(c, ck_recheck_fields(xs, c, generics)) {
  match xs: CkContextFrame(c, ck_recheck_fields(xs, c, generics)) {
    Nil => (ordinary => Refl)
    Cons(f, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkContextFrame(c, m),
      Eq::sym(recheck_fields_cons_unf(f, rest, c, generics)),
      recheck_fields_cons_frame_context(
        f,
        rest,
        c,
        generics,
        next => ck_recheck_fields_frame_context(rest, next, generics)
      )
    )
  }
}

pub theorem recheck_ctors_cons_frame_context(
  k: SurfaceDataCtor,
  rest: List(SurfaceDataCtor),
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkContextFrame(next, ck_recheck_ctors(rest, next, generics))
): CkContextFrame(c, recheck_ctors_cons(k, rest, c, generics)) {
  context_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, next: Checker) => ck_rewrap1(ck_recheck_ctors(rest, next, generics)),
    ck_recheck_fields(registration_ctor_fields(k), c, generics),
    ck_recheck_fields_frame_context(registration_ctor_fields(k), c, generics),
    ignored => next => context_rewrap(next, ck_recheck_ctors(rest, next, generics), ih(next))
  )
}

pub theorem ck_recheck_ctors_frame_context(
  xs: List(SurfaceDataCtor),
  c: Checker,
  generics: Ordmap(Text, Ty)
): CkContextFrame(c, ck_recheck_ctors(xs, c, generics)) {
  match xs: CkContextFrame(c, ck_recheck_ctors(xs, c, generics)) {
    Nil => (ordinary => Refl)
    Cons(k, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkContextFrame(c, m),
      Eq::sym(recheck_ctors_cons_unf(k, rest, c, generics)),
      recheck_ctors_cons_frame_context(
        k,
        rest,
        c,
        generics,
        next => ck_recheck_ctors_frame_context(rest, next, generics)
      )
    )
  }
}

pub theorem recheck_datas_cons_frame_context(
  d: SurfaceData,
  rest: List(SurfaceData),
  c: Checker,
  ih: ∀ next: Checker. CkContextFrame(next, ck_recheck_datas(rest, next))
): CkContextFrame(c, recheck_datas_cons(d, rest, c)) {
  context_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, next: Checker) => ck_rewrap1(ck_recheck_datas(rest, next)),
    ck_recheck_ctors(
      registration_ctors(d),
      c,
      ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
    ),
    ck_recheck_ctors_frame_context(
      registration_ctors(d),
      c,
      ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
    ),
    ignored => next => context_rewrap(next, ck_recheck_datas(rest, next), ih(next))
  )
}

pub theorem ck_recheck_datas_frame_context(
  xs: List(SurfaceData),
  c: Checker
): CkContextFrame(c, ck_recheck_datas(xs, c)) {
  match xs: CkContextFrame(c, ck_recheck_datas(xs, c)) {
    Nil => (ordinary => Refl)
    Cons(d, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkContextFrame(c, m),
      Eq::sym(recheck_datas_cons_unf(d, rest, c)),
      recheck_datas_cons_frame_context(
        d,
        rest,
        c,
        next => ck_recheck_datas_frame_context(rest, next)
      )
    )
  }
}
