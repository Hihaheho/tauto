pub fn inference_class_method(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  cn: Text,
  found: Bool
): Mut1(Ty, Checker) {
  match found {
    true => ck_rewrap1(ck_lookup(c, cat3(cn, "::", name), env, span, term.occurrence))
    false => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, no_method_message(cn, name), span))
    )
  }
}

pub theorem inference_class_method_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  cn: Text,
  found: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_class_method(j, c, term, env, span, base, name, cn, found)) {
  match found {
    true => run_frame_read(
      c,
      ck_rewrap1(ck_lookup(c, cat3(cn, "::", name), env, span, term.occurrence)),
      frame_rewrap(
        c,
        ck_lookup(c, cat3(cn, "::", name), env, span, term.occurrence),
        ck_lookup_frame(c, cat3(cn, "::", name), env, span, term.occurrence)
      ),
      ordered
    )
    false => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, no_method_message(cn, name), span)),
      run_frame_read(
        c,
        ck_rewrap1(ck_error(c, no_method_message(cn, name), span)),
        frame_rewrap(
          c,
          ck_error(c, no_method_message(cn, name), span),
          ck_error_frame(c, no_method_message(cn, name), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
  }
}

pub fn inference_field_base(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  r#class: Option(Text)
): Mut1(Ty, Checker) {
  match r#class {
    None => frame_bind(
      <A: Ty, B: Ty>,
      (b: Ty, c1: Checker) => ck_rewrap1(ck_field_through(c1, term, coerce_place(base), b, name)),
      ck_infer_in(j, c, base, env)
    )
    Some(cn) => inference_class_method(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      cn,
      Ordmap::contains(inference_fns(c), cat3(cn, "::", name), Ordmap::compare_text)
    )
  }
}

pub theorem inference_field_base_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  r#class: Option(Text),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_field_base(j, c, term, env, span, base, name, r#class)) {
  match r#class {
    None => run_frame_bind(
      <A: Ty, B: Ty>,
      c,
      (b: Ty, c1: Checker) => ck_rewrap1(ck_field_through(c1, term, coerce_place(base), b, name)),
      ck_infer_in(j, c, base, env),
      inference_use_ck_infer_in(j, c, base, env, ordered, ih),
      b => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_field_through(c1, term, coerce_place(base), b, name)),
        frame_rewrap(c1, ck_field_through(c1, term, coerce_place(base), b, name), ck_field_through_frame(c1, term, coerce_place(base), b, name)),
        o_c1
      )
    )
    Some(cn) => inference_class_method_frame(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      cn,
      Ordmap::contains(inference_fns(c), cat3(cn, "::", name), Ordmap::compare_text),
      ih,
      ordered
    )
  }
}

pub fn inference_term(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  sk: SurfaceKind
): Mut1(Ty, Checker) {
  match sk {
    SkVar(name) => ck_rewrap1(ck_lookup(c, surface_name_text(name), env, span, term.occurrence))
    SkNat(n) => ck_rewrap1(ck_nat_literal(c, n, span))
    SkText(^s) => mut1(TyText, c)
    SkBool(^b) => mut1(TyBool, c)
    SkApp(function, arguments) => ck_rewrap1(ck_app_in(j, c, term, function, arguments, env))
    SkPi(^pat_params, ^pat_result, ^pat_effects) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
    SkExists(^pat_binder, ^pat_domain, ^pat_body, ^unused) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
    SkLam(^params, ^body, _, _) => ck_rewrap1(ck_lambda_in(j, c, term, Nil, env))
    SkUnion(^pat_parts) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
    SkTagged(tag, x) => frame_bind(
      <A: Ty, B: Ty>,
      (t: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), c1),
      ck_infer_in(j, c, x, env)
    )
    SkIf(condition, th, el) => frame_bind(
      <A: Unit, B: Ty>,
      (cleared: Unit, c1: Checker) => frame_bind(
        <A: Ty, B: Ty>,
        (ct: Ty, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c)))
          ),
          ck_expect(c2, ct, TyBool, span_of(condition), what_if_condition_message())
        ),
        ck_infer_in(j, c1, condition, env)
      ),
      inference_set_result_hint(c, None)
    )
    SkField(base, name) => inference_field_base(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      class_of_base(c, base, env)
    )
    SkBlock(stmts) => frame_bind(
      <A: Unit, B: Ty>,
      (armed: Unit, c1: Checker) => inference_bind_scope(
        <A: Ty, B: Ty>,
        (t: Ty, c2: Checker, inner: Scope) => frame_bind(
          <A: Unit, B: Ty>,
          (restored: Unit, c3: Checker) => mut1(t, c3),
          inference_set_arm_hint(c2, inference_arm_hint(c))
        ),
        ck_block_in(j, c1, stmts, ScopeMk(env), false, TyUnit)
      ),
      inference_set_arm_hint(c, inference_result_hint(c))
    )
    SkPerform(eff, args) => frame_bind(
      <A: List(Ty), B: Ty>,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_perform_of(c1, eff, types, args, span)),
      ck_infer_each_in(j, c, args, env)
    )
    SkHandle(body, handlers) => ck_rewrap1(ck_handle_in(j, c, body, handlers, env))
    SkBudget(^steps_memory, steps, body) => frame_bind(
      <A: Ty, B: Ty>,
      (s: Ty, c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (t: Ty, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env)
        ),
        ck_expect(c1, s, TyInt(WidthU64), span_of(steps), what_budget_steps_message())
      ),
      ck_infer_in(j, c, steps, env)
    )
    SkMatch(scrutinee, motive, arms, ^binder, _) => frame_bind(
      <A: Option(Ty) × List(Option(Ty)), B: Ty>,
      (before: Option(Ty) × List(Option(Ty)), c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (armed: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (cleared: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span)
          ),
          inference_set_result_hint(c2, None)
        ),
        inference_set_arm_hint(c1, ck_hint_or_before(before, inference_result_hint(c)))
      ),
      ck_match_before(c, motive, arms, env)
    )
    SkHole(^pat_name) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
    SkRecord(name, fields) => ck_rewrap1(ck_record_in(j, c, name, fields, env, span))
    SkBorrow(mutable, ^mutable_orig, inner) => frame_bind(
      <A: Unit, B: Ty>,
      (checked: Unit, c1: Checker) => frame_bind(
        <A: Ty, B: Ty>,
        (t: Ty, c2: Checker) => mut1(ck_borrow_of(c2, t, mutable), c2),
        ck_infer_in(j, c1, inner, env)
      ),
      ck_check_lend(c, mutable, inner, env, span)
    )
    SkFnKind(^pat_kind, ^pat_ty) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
    SkBorrowLam(r#borrows, lam) => ck_rewrap1(ck_lambda_in(j, c, lam, r#borrows, env))
    SkOther(^pat_what) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
    SkAscribe(^pat_what, ^pat_what_ty) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
    SkRow(^pat_what_effects) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
    SkFloat(pat_what) => ck_rewrap1(ck_float_literal(c, pat_what, span))
    SkMacroCall(^pat_name, ^pat_arg) => ck_rewrap1(ck_fresh(c))
    SkQuote(^pat_stmts_form, ^pat_stmts) => ck_rewrap1(ck_fresh(c))
    SkSplice(^pat_value) => ck_rewrap1(ck_fresh(c))
    SkSyntaxLit(^pat_name, ^pat_body) => ck_rewrap1(ck_fresh(c))
    SkStep(^pat_tactic, ^pat_arg, ^pat_call_start, ^pat_call_end, ^pat_before, ^pat_arms) => frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span))
    )
  }
}

pub theorem inference_term_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  sk: SurfaceKind,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_term(j, c, term, env, span, sk)) {
  match sk {
    SkVar(name) => run_frame_read(
      c,
      ck_rewrap1(ck_lookup(c, surface_name_text(name), env, span, term.occurrence)),
      frame_rewrap(c, ck_lookup(c, surface_name_text(name), env, span, term.occurrence), ck_lookup_frame(c, surface_name_text(name), env, span, term.occurrence)),
      ordered
    )
    SkNat(n) => run_frame_read(
      c,
      ck_rewrap1(ck_nat_literal(c, n, span)),
      frame_rewrap(c, ck_nat_literal(c, n, span), ck_nat_literal_frame(c, n, span)),
      ordered
    )
    SkText(s) => run_frame_return(c, TyText, ordered)
    SkBool(b) => run_frame_return(c, TyBool, ordered)
    SkApp(function, arguments) => run_frame_rewrap(
      c,
      ck_app_in(j, c, term, function, arguments, env),
      inference_use_ck_app_in(j, c, term, function, arguments, env, ordered, ih)
    )
    SkPi(pat_params, pat_result, pat_effects) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkExists(pat_binder, pat_domain, pat_body, unused) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkLam(params, body, _, _) => run_frame_rewrap(
      c,
      ck_lambda_in(j, c, term, Nil, env),
      inference_use_ck_lambda_in(j, c, term, Nil, env, ordered, ih)
    )
    SkUnion(pat_parts) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkTagged(tag, x) => run_frame_bind(
      <A: Ty, B: Ty>,
      c,
      (t: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), c1),
      ck_infer_in(j, c, x, env),
      inference_use_ck_infer_in(j, c, x, env, ordered, ih),
      t => c1 => o_c1 => run_frame_return(c1, ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), o_c1)
    )
    SkIf(condition, th, el) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (cleared: Unit, c1: Checker) => frame_bind(
        <A: Ty, B: Ty>,
        (ct: Ty, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c)))
          ),
          ck_expect(c2, ct, TyBool, span_of(condition), what_if_condition_message())
        ),
        ck_infer_in(j, c1, condition, env)
      ),
      inference_set_result_hint(c, None),
      run_frame_read(
        c,
        inference_set_result_hint(c, None),
        inference_set_result_hint_frame(c, None),
        ordered
      ),
      cleared => c1 => o_c1 => run_frame_bind(
        <A: Ty, B: Ty>,
        c1,
        (ct: Ty, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c)))
          ),
          ck_expect(c2, ct, TyBool, span_of(condition), what_if_condition_message())
        ),
        ck_infer_in(j, c1, condition, env),
        inference_use_ck_infer_in(j, c1, condition, env, o_c1, ih),
        ct => c2 => o_c2 => run_frame_bind(
          <A: Unit, B: Ty>,
          c2,
          (checked: Unit, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c)))
          ),
          ck_expect(c2, ct, TyBool, span_of(condition), what_if_condition_message()),
          ck_expect_run_frame(c2, ct, TyBool, span_of(condition), what_if_condition_message(), o_c2),
          checked => c3 => o_c3 => run_frame_bind(
            <A: Unit, B: Ty>,
            c3,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c))),
            run_frame_read(
              c3,
              inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c))),
              inference_set_result_hint_frame(c3, ck_result_hint_for(th, inference_result_hint(c))),
              o_c3
            ),
            set1 => c4 => o_c4 => run_frame_bind(
              <A: Ty, B: Ty>,
              c4,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env),
              inference_use_ck_infer_in(j, c4, th, env, o_c4, ih),
              t => c5 => o_c5 => run_frame_bind(
                <A: Unit, B: Ty>,
                c5,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c))),
                run_frame_read(
                  c5,
                  inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c))),
                  inference_set_result_hint_frame(c5, ck_else_hint(el, inference_result_hint(c))),
                  o_c5
                ),
                set2 => c6 => o_c6 => run_frame_rewrap(
                  c6,
                  ck_else_in(j, c6, t, el, env),
                  inference_use_ck_else_in(j, c6, t, el, env, o_c6, ih)
                )
              )
            )
          )
        )
      )
    )
    SkField(base, name) => inference_field_base_frame(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      class_of_base(c, base, env),
      ih,
      ordered
    )
    SkBlock(stmts) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (armed: Unit, c1: Checker) => inference_bind_scope(
        <A: Ty, B: Ty>,
        (t: Ty, c2: Checker, inner: Scope) => frame_bind(
          <A: Unit, B: Ty>,
          (restored: Unit, c3: Checker) => mut1(t, c3),
          inference_set_arm_hint(c2, inference_arm_hint(c))
        ),
        ck_block_in(j, c1, stmts, ScopeMk(env), false, TyUnit)
      ),
      inference_set_arm_hint(c, inference_result_hint(c)),
      run_frame_read(
        c,
        inference_set_arm_hint(c, inference_result_hint(c)),
        inference_set_arm_hint_frame(c, inference_result_hint(c)),
        ordered
      ),
      armed => c1 => o_c1 => inference_bind_scope_frame(
        <A: Ty, B: Ty>,
        c1,
        (t: Ty, c2: Checker, inner: Scope) => frame_bind(
          <A: Unit, B: Ty>,
          (restored: Unit, c3: Checker) => mut1(t, c3),
          inference_set_arm_hint(c2, inference_arm_hint(c))
        ),
        ck_block_in(j, c1, stmts, ScopeMk(env), false, TyUnit),
        inference_use_ck_block_in(j, c1, stmts, ScopeMk(env), false, TyUnit, o_c1, ih),
        t => c2 => inner => o_c2 => run_frame_bind(
          <A: Unit, B: Ty>,
          c2,
          (restored: Unit, c3: Checker) => mut1(t, c3),
          inference_set_arm_hint(c2, inference_arm_hint(c)),
          run_frame_read(
            c2,
            inference_set_arm_hint(c2, inference_arm_hint(c)),
            inference_set_arm_hint_frame(c2, inference_arm_hint(c)),
            o_c2
          ),
          restored => c3 => o_c3 => run_frame_return(c3, t, o_c3)
        )
      )
    )
    SkPerform(eff, args) => run_frame_bind(
      <A: List(Ty), B: Ty>,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_perform_of(c1, eff, types, args, span)),
      ck_infer_each_in(j, c, args, env),
      inference_use_ck_infer_each_in(j, c, args, env, ordered, ih),
      types => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_perform_of(c1, eff, types, args, span),
        ck_perform_of_run_frame(c1, eff, types, args, span, o_c1)
      )
    )
    SkHandle(body, handlers) => run_frame_rewrap(
      c,
      ck_handle_in(j, c, body, handlers, env),
      inference_use_ck_handle_in(j, c, body, handlers, env, ordered, ih)
    )
    SkBudget(steps_memory, steps, body) => run_frame_bind(
      <A: Ty, B: Ty>,
      c,
      (s: Ty, c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (t: Ty, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env)
        ),
        ck_expect(c1, s, TyInt(WidthU64), span_of(steps), what_budget_steps_message())
      ),
      ck_infer_in(j, c, steps, env),
      inference_use_ck_infer_in(j, c, steps, env, ordered, ih),
      s => c1 => o_c1 => run_frame_bind(
        <A: Unit, B: Ty>,
        c1,
        (checked: Unit, c2: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (t: Ty, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env)
        ),
        ck_expect(c1, s, TyInt(WidthU64), span_of(steps), what_budget_steps_message()),
        ck_expect_run_frame(c1, s, TyInt(WidthU64), span_of(steps), what_budget_steps_message(), o_c1),
        checked => c2 => o_c2 => run_frame_bind(
          <A: Ty, B: Ty>,
          c2,
          (t: Ty, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env),
          inference_use_ck_infer_in(j, c2, body, env, o_c2, ih),
          t => c3 => o_c3 => run_frame_bind(
            <A: Unit, B: Ty>,
            c3,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span),
            ck_budget_answer_run_frame(c3, t, span, o_c3),
            answered => c4 => o_c4 => run_frame_return(c4, t, o_c4)
          )
        )
      )
    )
    SkMatch(scrutinee, motive, arms, binder, _) => run_frame_bind(
      <A: Option(Ty) × List(Option(Ty)), B: Ty>,
      c,
      (before: Option(Ty) × List(Option(Ty)), c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (armed: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (cleared: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span)
          ),
          inference_set_result_hint(c2, None)
        ),
        inference_set_arm_hint(c1, ck_hint_or_before(before, inference_result_hint(c)))
      ),
      ck_match_before(c, motive, arms, env),
      ck_match_before_run_frame(c, motive, arms, env, ordered),
      before => c1 => o_c1 => run_frame_bind(
        <A: Unit, B: Ty>,
        c1,
        (armed: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (cleared: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span)
          ),
          inference_set_result_hint(c2, None)
        ),
        inference_set_arm_hint(c1, ck_hint_or_before(before, inference_result_hint(c))),
        run_frame_read(
          c1,
          inference_set_arm_hint(c1, ck_hint_or_before(before, inference_result_hint(c))),
          inference_set_arm_hint_frame(c1, ck_hint_or_before(before, inference_result_hint(c))),
          o_c1
        ),
        armed => c2 => o_c2 => run_frame_bind(
          <A: Unit, B: Ty>,
          c2,
          (cleared: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span)
          ),
          inference_set_result_hint(c2, None),
          run_frame_read(
            c2,
            inference_set_result_hint(c2, None),
            inference_set_result_hint_frame(c2, None),
            o_c2
          ),
          cleared => c3 => o_c3 => run_frame_bind(
            <A: Ty, B: Ty>,
            c3,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span),
            inference_use_ck_match_expr_in(j, c3, scrutinee, arms, env, span, o_c3, ih),
            got => c4 => o_c4 => run_frame_bind(
              <A: Unit, B: Ty>,
              c4,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c)),
              run_frame_read(
                c4,
                inference_set_arm_hint(c4, inference_arm_hint(c)),
                inference_set_arm_hint_frame(c4, inference_arm_hint(c)),
                o_c4
              ),
              restored => c5 => o_c5 => run_frame_rewrap(
                c5,
                ck_match_after(c5, before, arms, got, span),
                ck_match_after_run_frame(c5, before, arms, got, span, o_c5)
              )
            )
          )
        )
      )
    )
    SkHole(pat_name) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkRecord(name, fields) => run_frame_rewrap(
      c,
      ck_record_in(j, c, name, fields, env, span),
      inference_use_ck_record_in(j, c, name, fields, env, span, ordered, ih)
    )
    SkBorrow(mutable, mutable_orig, inner) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (checked: Unit, c1: Checker) => frame_bind(
        <A: Ty, B: Ty>,
        (t: Ty, c2: Checker) => mut1(ck_borrow_of(c2, t, mutable), c2),
        ck_infer_in(j, c1, inner, env)
      ),
      ck_check_lend(c, mutable, inner, env, span),
      run_frame_read(
        c,
        ck_check_lend(c, mutable, inner, env, span),
        ck_check_lend_frame(c, mutable, inner, env, span),
        ordered
      ),
      checked => c1 => o_c1 => run_frame_bind(
        <A: Ty, B: Ty>,
        c1,
        (t: Ty, c2: Checker) => mut1(ck_borrow_of(c2, t, mutable), c2),
        ck_infer_in(j, c1, inner, env),
        inference_use_ck_infer_in(j, c1, inner, env, o_c1, ih),
        t => c2 => o_c2 => run_frame_return(c2, ck_borrow_of(c2, t, mutable), o_c2)
      )
    )
    SkFnKind(pat_kind, pat_ty) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkBorrowLam(r#borrows, lam) => run_frame_rewrap(
      c,
      ck_lambda_in(j, c, lam, r#borrows, env),
      inference_use_ck_lambda_in(j, c, lam, r#borrows, env, ordered, ih)
    )
    SkOther(pat_what) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkAscribe(pat_what, pat_what_ty) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkRow(pat_what_effects) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkFloat(pat_what) => run_frame_read(
      c,
      ck_rewrap1(ck_float_literal(c, pat_what, span)),
      frame_rewrap(c, ck_float_literal(c, pat_what, span), ck_float_literal_frame(c, pat_what, span)),
      ordered
    )
    SkMacroCall(pat_name, pat_arg) => run_frame_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      ordered
    )
    SkQuote(pat_stmts_form, pat_stmts) => run_frame_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      ordered
    )
    SkSplice(pat_value) => run_frame_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      ordered
    )
    SkSyntaxLit(pat_name, pat_body) => run_frame_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      ordered
    )
    SkStep(pat_tactic, pat_arg, pat_call_start, pat_call_end, pat_before, pat_arms) => run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
  }
}

pub fn inference_step_ck_infer_term_in(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local)
): Mut1(Ty, Checker) { inference_term(j, c, term, env, span_of(term), inference_term_kind(term)) }

pub theorem inference_step_ck_infer_term_in_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
  inference_step_ck_infer_term_in(j, c, term, env)
) { inference_term_frame(j, c, term, env, span_of(term), inference_term_kind(term), ih, ordered) }

pub theorem inference_unf_ck_infer_term_in(j: Nat, c: Checker, term: SurfaceTerm, env: List(Local)): ck_infer_term_in(Succ(j), c, term, env) = inference_step_ck_infer_term_in(j, c, term, env) { match term { SurfaceTermIndexedMk(sk, start, end, ast_occurrence) => ⊢ ck_infer_term_in(
  Succ(j),
  c,
  SurfaceTermIndexedMk(sk, start, end, ast_occurrence),
  env
) = inference_step_ck_infer_term_in(
  j,
  c,
  SurfaceTermIndexedMk(sk, start, end, ast_occurrence),
  env
) from match sk {
      SkVar(pat_name) => Refl
      SkNat(pat_digits) => Refl
      SkText(pat_value) => Refl
      SkBool(pat_value) => Refl
      SkApp(pat_head, pat_args) => Refl
      SkPi(pat_params, pat_result, pat_effects) => Refl
      SkExists(pat_binder, pat_domain, pat_body, unused) => Refl
      SkLam(pat_params, pat_body, _, _) => Refl
      SkUnion(pat_parts) => Refl
      SkTagged(pat_tag, pat_value) => Refl
      SkIf(pat_cond, pat_then, pat_otherwise) => Refl
      SkField(pat_value, pat_name) => Refl
      SkBlock(pat_stmts) => Refl
      SkPerform(pat_op, pat_args) => Refl
      SkHandle(pat_body, pat_handlers) => Refl
      SkBudget(pat_amount_memory, pat_amount, pat_body) => Refl
      SkMatch(pat_scrutinee, pat_motive, pat_arms, pat_binder, _) => Refl
      SkHole(pat_name) => Refl
      SkRecord(pat_name, pat_fields) => Refl
      SkBorrow(pat_mutable, pat_mutable_orig, pat_value) => Refl
      SkFnKind(pat_kind, pat_ty) => Refl
      SkBorrowLam(pat_borrows, pat_lam) => Refl
      SkOther(pat_what) => Refl
      SkAscribe(pat_what, pat_what_ty) => Refl
      SkRow(pat_what_effects) => Refl
      SkFloat(pat_what) => Refl
      SkMacroCall(pat_name, pat_arg) => Refl
      SkQuote(pat_stmts_form, pat_stmts) => Refl
      SkSplice(pat_value) => Refl
      SkSyntaxLit(pat_name, pat_body) => Refl
      SkStep(pat_tactic, pat_arg, pat_call_start, pat_call_end, pat_before, pat_arms) => Refl
    }
  } }
