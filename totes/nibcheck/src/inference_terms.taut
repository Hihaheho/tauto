import "inference_functions.taut"
import "product_frame.taut"

pub fn inference_class_method(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  cn: Text,
  found: Bool
): Mut1(Ty, Checker) {
  match found: Mut1(Ty, Checker) {
    true => ck_rewrap1(ck_lookup(c, cat3(cn, ".", name), env, span))
    false => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat3(cn, " has no method ", name), span))
    )
  }
}

pub theorem inference_class_method_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  cn: Text,
  found: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_class_method(j, c, term, env, span, base, name, cn, found)) {
  match found: CkRunFrame(
    c,
    inference_class_method(j, c, term, env, span, base, name, cn, found)
  ) {
    true => run_frame_read(
      c,
      ck_rewrap1(ck_lookup(c, cat3(cn, ".", name), env, span)),
      frame_rewrap(
        c,
        ck_lookup(c, cat3(cn, ".", name), env, span),
        ck_lookup_frame(c, cat3(cn, ".", name), env, span)
      ),
      ordered
    )
    false => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat3(cn, " has no method ", name), span)),
      run_frame_read(
        c,
        ck_rewrap1(ck_error(c, cat3(cn, " has no method ", name), span)),
        frame_rewrap(
          c,
          ck_error(c, cat3(cn, " has no method ", name), span),
          ck_error_frame(c, cat3(cn, " has no method ", name), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
  }
}

pub fn inference_field_base(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  r#class: Option(Text)
): Mut1(Ty, Checker) {
  match r#class: Mut1(Ty, Checker) {
    None => frame_bind(
      Ty,
      Ty,
      (b: Ty, c1: Checker) => ck_rewrap1(ck_field_of(c1, term, b, name)),
      ck_infer_in(j, c, base, env)
    )
    Some(cn) => inference_class_method(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      cn,
      Ordmap::contains(inference_fns(c), cat3(cn, ".", name), Ordmap::compare_text)
    )
  }
}

pub theorem inference_field_base_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  r#class: Option(Text),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_field_base(j, c, term, env, span, base, name, r#class)) {
  match r#class: CkRunFrame(c, inference_field_base(j, c, term, env, span, base, name, r#class)) {
    None => run_frame_bind(
      Ty,
      Ty,
      c,
      (b: Ty, c1: Checker) => ck_rewrap1(ck_field_of(c1, term, b, name)),
      ck_infer_in(j, c, base, env),
      inference_use_ck_infer_in(j, c, base, env, ordered, ih),
      b => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_field_of(c1, term, b, name)),
        frame_rewrap(c1, ck_field_of(c1, term, b, name), ck_field_of_frame(c1, term, b, name)),
        o_c1
      )
    )
    Some(cn) => inference_class_method_frame(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      cn,
      Ordmap::contains(inference_fns(c), cat3(cn, ".", name), Ordmap::compare_text),
      ih,
      ordered
    )
  }
}

pub fn inference_term(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  sk: SurfaceKind
): Mut1(Ty, Checker) {
  match sk: Mut1(Ty, Checker) {
    SkVar(name) => ck_rewrap1(ck_lookup(c, name, env, span))
    SkNat(n) => ck_rewrap1(ck_nat_literal(c, n, span))
    SkText(s) => mut1(TyText, c)
    SkBool(b) => mut1(TyBool, c)
    SkApp(function, arguments) => ck_rewrap1(ck_app_in(j, c, term, function, arguments, env))
    SkPi(pat_params, pat_result, pat_effects) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
    SkExists(pat_binder, pat_domain, pat_body) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
    SkLam(params, body) => ck_rewrap1(ck_lambda_in(j, c, term, Nil, env))
    SkUnion(pat_parts) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
    SkTagged(tag, x) => frame_bind(
      Ty,
      Ty,
      (t: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), c1),
      ck_infer_in(j, c, x, env)
    )
    SkIf(condition, th, el) => frame_bind(
      Ty,
      Ty,
      (ct: Ty, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (checked: Unit, c2: Checker) => frame_bind(
          Ty,
          Ty,
          (t: Ty, c3: Checker) => ck_rewrap1(ck_else_in(j, c3, t, el, env)),
          ck_infer_in(j, c2, th, env)
        ),
        ck_expect(c1, ct, TyBool, span_of(condition), "an `if` condition")
      ),
      ck_infer_in(j, c, condition, env)
    )
    SkField(base, name) => inference_field_base(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      class_of_base(c, base, env)
    )
    SkBlock(stmts) => inference_bind_scope(
      Ty,
      Ty,
      (t: Ty, c1: Checker, inner: Scope) => mut1(t, c1),
      ck_block_in(j, c, stmts, ScopeMk(env), false, TyUnit)
    )
    SkPerform(eff, args) => frame_bind(
      List(Ty),
      Ty,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_perform_of(c1, eff, types, args, span)),
      ck_infer_each_in(j, c, args, env)
    )
    SkHandle(body, handlers) => ck_rewrap1(ck_handle_in(j, c, body, handlers, env))
    SkBudget(steps_memory, steps, body) => frame_bind(
      Ty,
      Ty,
      (s: Ty, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (checked: Unit, c2: Checker) => frame_bind(
          Ty,
          Ty,
          (t: Ty, c3: Checker) => frame_bind(
            Unit,
            Ty,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env)
        ),
        ck_expect(c1, s, TyInt(Width64), span_of(steps), "a budget's steps")
      ),
      ck_infer_in(j, c, steps, env)
    )
    SkMatch(scrutinee, motive, arms, binder) => ck_rewrap1(
      ck_match_expr_in(j, c, scrutinee, arms, env, span)
    )
    SkHole(pat_name) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
    SkRecord(name, fields) => ck_rewrap1(ck_record_in(j, c, name, fields, env, span))
    SkBorrow(mutable, inner) => frame_bind(
      Unit,
      Ty,
      (checked: Unit, c1: Checker) => frame_bind(
        Ty,
        Ty,
        (t: Ty, c2: Checker) => mut1(ck_borrow_of(c2, t, mutable), c2),
        ck_infer_in(j, c1, inner, env)
      ),
      ck_check_lend(c, mutable, inner, env, span)
    )
    SkFnKind(pat_kind, pat_ty) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
    SkBorrowLam(borrows, lam) => ck_rewrap1(ck_lambda_in(j, c, lam, borrows, env))
    SkOther(pat_what) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
    SkRow(pat_what_effects) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
    SkFloat(pat_what) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
    SkProduct(members) => frame_bind(
      List(Ty),
      Ty,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_product_of(c1, types, members, span)),
      ck_infer_each_in(j, c, members, env)
    )
    SkProject(base, ty) => frame_bind(
      Ty,
      Ty,
      (b: Ty, c1: Checker) => frame_bind(
        Ty,
        Ty,
        (want: Ty, c2: Checker) => ck_rewrap1(ck_project_of(c2, b, want, span)),
        ck_written_here(c1, ty)
      ),
      ck_infer_in(j, c, base, env)
    )
    SkMacroCall(pat_name, pat_arg) => ck_rewrap1(ck_fresh(c))
    SkQuote(pat_stmts_form, pat_stmts) => ck_rewrap1(ck_fresh(c))
    SkSplice(pat_value) => ck_rewrap1(ck_fresh(c))
    SkSyntaxLit(pat_name, pat_body) => ck_rewrap1(ck_fresh(c))
    SkStep(pat_tactic, pat_arg, pat_call_start, pat_call_end, pat_before, pat_arms) => frame_bind(
      Unit,
      Ty,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span))
    )
  }
}

pub theorem inference_term_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  sk: SurfaceKind,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_term(j, c, term, env, span, sk)) {
  match sk: CkRunFrame(c, inference_term(j, c, term, env, span, sk)) {
    SkVar(name) => run_frame_read(
      c,
      ck_rewrap1(ck_lookup(c, name, env, span)),
      frame_rewrap(c, ck_lookup(c, name, env, span), ck_lookup_frame(c, name, env, span)),
      ordered
    )
    SkNat(n) => run_frame_read(
      c,
      ck_rewrap1(ck_nat_literal(c, n, span)),
      frame_rewrap(c, ck_nat_literal(c, n, span), ck_nat_literal_frame(c, n, span)),
      ordered
    )
    SkText(s) => run_frame_return(c, TyText, ordered)
    SkBool(b) => run_frame_return(c, TyBool, ordered)
    SkApp(function, arguments) => run_frame_rewrap(
      c,
      ck_app_in(j, c, term, function, arguments, env),
      inference_use_ck_app_in(j, c, term, function, arguments, env, ordered, ih)
    )
    SkPi(pat_params, pat_result, pat_effects) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkExists(pat_binder, pat_domain, pat_body) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkLam(params, body) => run_frame_rewrap(
      c,
      ck_lambda_in(j, c, term, Nil, env),
      inference_use_ck_lambda_in(j, c, term, Nil, env, ordered, ih)
    )
    SkUnion(pat_parts) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkTagged(tag, x) => run_frame_bind(
      Ty,
      Ty,
      c,
      (t: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), c1),
      ck_infer_in(j, c, x, env),
      inference_use_ck_infer_in(j, c, x, env, ordered, ih),
      t => c1 => o_c1 => run_frame_return(c1, ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), o_c1)
    )
    SkIf(condition, th, el) => run_frame_bind(
      Ty,
      Ty,
      c,
      (ct: Ty, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (checked: Unit, c2: Checker) => frame_bind(
          Ty,
          Ty,
          (t: Ty, c3: Checker) => ck_rewrap1(ck_else_in(j, c3, t, el, env)),
          ck_infer_in(j, c2, th, env)
        ),
        ck_expect(c1, ct, TyBool, span_of(condition), "an `if` condition")
      ),
      ck_infer_in(j, c, condition, env),
      inference_use_ck_infer_in(j, c, condition, env, ordered, ih),
      ct => c1 => o_c1 => run_frame_bind(
        Unit,
        Ty,
        c1,
        (checked: Unit, c2: Checker) => frame_bind(
          Ty,
          Ty,
          (t: Ty, c3: Checker) => ck_rewrap1(ck_else_in(j, c3, t, el, env)),
          ck_infer_in(j, c2, th, env)
        ),
        ck_expect(c1, ct, TyBool, span_of(condition), "an `if` condition"),
        ck_expect_run_frame(c1, ct, TyBool, span_of(condition), "an `if` condition", o_c1),
        checked => c2 => o_c2 => run_frame_bind(
          Ty,
          Ty,
          c2,
          (t: Ty, c3: Checker) => ck_rewrap1(ck_else_in(j, c3, t, el, env)),
          ck_infer_in(j, c2, th, env),
          inference_use_ck_infer_in(j, c2, th, env, o_c2, ih),
          t => c3 => o_c3 => run_frame_rewrap(
            c3,
            ck_else_in(j, c3, t, el, env),
            inference_use_ck_else_in(j, c3, t, el, env, o_c3, ih)
          )
        )
      )
    )
    SkField(base, name) => inference_field_base_frame(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      class_of_base(c, base, env),
      ih,
      ordered
    )
    SkBlock(stmts) => inference_bind_scope_frame(
      Ty,
      Ty,
      c,
      (t: Ty, c1: Checker, inner: Scope) => mut1(t, c1),
      ck_block_in(j, c, stmts, ScopeMk(env), false, TyUnit),
      inference_use_ck_block_in(j, c, stmts, ScopeMk(env), false, TyUnit, ordered, ih),
      t => c1 => inner => o_c1 => run_frame_return(c1, t, o_c1)
    )
    SkPerform(eff, args) => run_frame_bind(
      List(Ty),
      Ty,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_perform_of(c1, eff, types, args, span)),
      ck_infer_each_in(j, c, args, env),
      inference_use_ck_infer_each_in(j, c, args, env, ordered, ih),
      types => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_perform_of(c1, eff, types, args, span),
        ck_perform_of_run_frame(c1, eff, types, args, span, o_c1)
      )
    )
    SkHandle(body, handlers) => run_frame_rewrap(
      c,
      ck_handle_in(j, c, body, handlers, env),
      inference_use_ck_handle_in(j, c, body, handlers, env, ordered, ih)
    )
    SkBudget(steps_memory, steps, body) => run_frame_bind(
      Ty,
      Ty,
      c,
      (s: Ty, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (checked: Unit, c2: Checker) => frame_bind(
          Ty,
          Ty,
          (t: Ty, c3: Checker) => frame_bind(
            Unit,
            Ty,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env)
        ),
        ck_expect(c1, s, TyInt(Width64), span_of(steps), "a budget's steps")
      ),
      ck_infer_in(j, c, steps, env),
      inference_use_ck_infer_in(j, c, steps, env, ordered, ih),
      s => c1 => o_c1 => run_frame_bind(
        Unit,
        Ty,
        c1,
        (checked: Unit, c2: Checker) => frame_bind(
          Ty,
          Ty,
          (t: Ty, c3: Checker) => frame_bind(
            Unit,
            Ty,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env)
        ),
        ck_expect(c1, s, TyInt(Width64), span_of(steps), "a budget's steps"),
        ck_expect_run_frame(c1, s, TyInt(Width64), span_of(steps), "a budget's steps", o_c1),
        checked => c2 => o_c2 => run_frame_bind(
          Ty,
          Ty,
          c2,
          (t: Ty, c3: Checker) => frame_bind(
            Unit,
            Ty,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env),
          inference_use_ck_infer_in(j, c2, body, env, o_c2, ih),
          t => c3 => o_c3 => run_frame_bind(
            Unit,
            Ty,
            c3,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span),
            ck_budget_answer_run_frame(c3, t, span, o_c3),
            answered => c4 => o_c4 => run_frame_return(c4, t, o_c4)
          )
        )
      )
    )
    SkMatch(scrutinee, motive, arms, binder) => run_frame_rewrap(
      c,
      ck_match_expr_in(j, c, scrutinee, arms, env, span),
      inference_use_ck_match_expr_in(j, c, scrutinee, arms, env, span, ordered, ih)
    )
    SkHole(pat_name) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkRecord(name, fields) => run_frame_rewrap(
      c,
      ck_record_in(j, c, name, fields, env, span),
      inference_use_ck_record_in(j, c, name, fields, env, span, ordered, ih)
    )
    SkBorrow(mutable, inner) => run_frame_bind(
      Unit,
      Ty,
      c,
      (checked: Unit, c1: Checker) => frame_bind(
        Ty,
        Ty,
        (t: Ty, c2: Checker) => mut1(ck_borrow_of(c2, t, mutable), c2),
        ck_infer_in(j, c1, inner, env)
      ),
      ck_check_lend(c, mutable, inner, env, span),
      run_frame_read(
        c,
        ck_check_lend(c, mutable, inner, env, span),
        ck_check_lend_frame(c, mutable, inner, env, span),
        ordered
      ),
      checked => c1 => o_c1 => run_frame_bind(
        Ty,
        Ty,
        c1,
        (t: Ty, c2: Checker) => mut1(ck_borrow_of(c2, t, mutable), c2),
        ck_infer_in(j, c1, inner, env),
        inference_use_ck_infer_in(j, c1, inner, env, o_c1, ih),
        t => c2 => o_c2 => run_frame_return(c2, ck_borrow_of(c2, t, mutable), o_c2)
      )
    )
    SkFnKind(pat_kind, pat_ty) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkBorrowLam(borrows, lam) => run_frame_rewrap(
      c,
      ck_lambda_in(j, c, lam, borrows, env),
      inference_use_ck_lambda_in(j, c, lam, borrows, env, ordered, ih)
    )
    SkOther(pat_what) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkRow(pat_what_effects) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkFloat(pat_what) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
    SkProduct(members) => run_frame_bind(
      List(Ty),
      Ty,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_product_of(c1, types, members, span)),
      ck_infer_each_in(j, c, members, env),
      inference_use_ck_infer_each_in(j, c, members, env, ordered, ih),
      types => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_product_of(c1, types, members, span),
        ck_product_of_run_frame(c1, types, members, span, o_c1)
      )
    )
    SkProject(base, ty) => run_frame_bind(
      Ty,
      Ty,
      c,
      (b: Ty, c1: Checker) => frame_bind(
        Ty,
        Ty,
        (want: Ty, c2: Checker) => ck_rewrap1(ck_project_of(c2, b, want, span)),
        ck_written_here(c1, ty)
      ),
      ck_infer_in(j, c, base, env),
      inference_use_ck_infer_in(j, c, base, env, ordered, ih),
      b => c1 => o_c1 => run_frame_bind(
        Ty,
        Ty,
        c1,
        (want: Ty, c2: Checker) => ck_rewrap1(ck_project_of(c2, b, want, span)),
        ck_written_here(c1, ty),
        ck_written_here_run_frame(c1, ty, o_c1),
        want => c2 => o_c2 => run_frame_rewrap(
          c2,
          ck_project_of(c2, b, want, span),
          ck_project_of_run_frame(c2, b, want, span, o_c2)
        )
      )
    )
    SkMacroCall(pat_name, pat_arg) => run_frame_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      ordered
    )
    SkQuote(pat_stmts_form, pat_stmts) => run_frame_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      ordered
    )
    SkSplice(pat_value) => run_frame_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      ordered
    )
    SkSyntaxLit(pat_name, pat_body) => run_frame_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      ordered
    )
    SkStep(
      pat_tactic,
      pat_arg,
      pat_call_start,
      pat_call_end,
      pat_before,
      pat_arms
    ) => run_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
      ),
      run_frame_read(
        c,
        ck_rewrap1(
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, cat2("not supported yet: ", sk_name(inference_term_kind(term))), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => run_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        o_c1
      )
    )
  }
}

pub fn inference_step_ck_infer_term_in(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local)
): Mut1(Ty, Checker) { inference_term(j, c, term, env, span_of(term), inference_term_kind(term)) }

pub theorem inference_step_ck_infer_term_in_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
  inference_step_ck_infer_term_in(j, c, term, env)
) { inference_term_frame(j, c, term, env, span_of(term), inference_term_kind(term), ih, ordered) }

pub theorem inference_unf_ck_infer_term_in(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local)
): ck_infer_term_in(Succ(j), c, term, env) = inference_step_ck_infer_term_in(j, c, term, env) { match term: ck_infer_term_in(Succ(j), c, term, env) = inference_step_ck_infer_term_in(j, c, term, env) { SurfaceTermIndexedMk(sk, start, end, ast_occurrence) => match sk: ck_infer_term_in(Succ(j), c, SurfaceTermIndexedMk(sk, start, end, ast_occurrence), env) = inference_step_ck_infer_term_in(j, c, SurfaceTermIndexedMk(sk, start, end, ast_occurrence), env) {
      SkVar(pat_name) => Refl
      SkNat(pat_digits) => Refl
      SkText(pat_value) => Refl
      SkBool(pat_value) => Refl
      SkApp(pat_head, pat_args) => Refl
      SkPi(pat_params, pat_result, pat_effects) => Refl
      SkExists(pat_binder, pat_domain, pat_body) => Refl
      SkLam(pat_params, pat_body) => Refl
      SkUnion(pat_parts) => Refl
      SkTagged(pat_tag, pat_value) => Refl
      SkIf(pat_cond, pat_then, pat_otherwise) => Refl
      SkField(pat_value, pat_name) => Refl
      SkBlock(pat_stmts) => Refl
      SkPerform(pat_op, pat_args) => Refl
      SkHandle(pat_body, pat_handlers) => Refl
      SkBudget(pat_amount_memory, pat_amount, pat_body) => Refl
      SkMatch(pat_scrutinee, pat_motive, pat_arms, pat_binder) => Refl
      SkHole(pat_name) => Refl
      SkRecord(pat_name, pat_fields) => Refl
      SkBorrow(pat_mutable, pat_value) => Refl
      SkFnKind(pat_kind, pat_ty) => Refl
      SkBorrowLam(pat_borrows, pat_lam) => Refl
      SkOther(pat_what) => Refl
      SkRow(pat_what_effects) => Refl
      SkFloat(pat_what) => Refl
      SkProduct(pat_what) => Refl
      SkProject(pat_what, pat_what_ty) => Refl
      SkMacroCall(pat_name, pat_arg) => Refl
      SkQuote(pat_stmts_form, pat_stmts) => Refl
      SkSplice(pat_value) => Refl
      SkSyntaxLit(pat_name, pat_body) => Refl
      SkStep(pat_tactic, pat_arg, pat_call_start, pat_call_end, pat_before, pat_arms) => Refl
    }
  } }
