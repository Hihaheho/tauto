pub fn registered_decls<A>(
  m: Mut1(A, Checker)
): Ordmap(Text, Data) { summary_decls(ck_datas_of(ck_st(m))) }

pub theorem registration_bind_present<A: Type, B: Type, n: Text>(
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  hm: CkDatasOrdered(ck_st(m)),
  hk: ∀ v: A. ∀ next: Checker. (CkDatasOrdered(next)) -> DataPresent(
    registered_decls(k(v, next)),
    n
  )
): DataPresent(registered_decls(frame_bind(k, m)), n) {
  ⊢ DataPresent(registered_decls(frame_bind(k, m)), n) from match m {
    mut1(v, next) => hk(v, next, hm)
  }
}

pub theorem registration_insert_present(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool,
  constructors: List(DataCtor),
  ordered: CkDatasOrdered(c)
): DataPresent(
  registered_decls(registration_insert(c, d, is_struct, builtin, constructors)),
  registration_name(d)
) {
  DataPresent::Mk(
    registration_data(d, is_struct, builtin, constructors),
    Ordmap::text_get_insert_same(
      summary_decls(ck_datas_of(c)),
      registration_name(d),
      registration_data(d, is_struct, builtin, constructors),
      ordered
    )
  )
}

pub theorem registration_declare_present(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool,
  ordered: CkDatasOrdered(c)
): DataPresent(
  registered_decls(registration_declare(c, d, is_struct, builtin)),
  registration_name(d)
) {
  registration_bind_present(
    Unit,
    Unit,
    registration_name(d),
    (ignored: Unit, c1: Checker) => frame_bind(
      List(DataCtor),
      Unit,
      (constructors: List(DataCtor), c2: Checker) => frame_bind(
        Unit,
        Unit,
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0)
      ),
      ck_data_ctors(
        registration_ctors(d),
        c1,
        ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
      )
    ),
    frame_error_if(
      c,
      "a view struct has no fields: it is an opaque type",
      registration_span(d),
      Bool::and(
        surface_data_is_view(d),
        Bool::or(not(is_struct), ctors_have_fields(registration_ctors(d)))
      )
    ),
    frame_ordered(
      c,
      frame_error_if(
        c,
        "a view struct has no fields: it is an opaque type",
        registration_span(d),
        Bool::and(
          surface_data_is_view(d),
          Bool::or(not(is_struct), ctors_have_fields(registration_ctors(d)))
        )
      ),
      frame_error_if_ok(
        c,
        "a view struct has no fields: it is an opaque type",
        registration_span(d),
        Bool::and(
          surface_data_is_view(d),
          Bool::or(not(is_struct), ctors_have_fields(registration_ctors(d)))
        )
      ),
      ordered
    ),
    ignored => c1 => o1 => registration_bind_present(
      List(DataCtor),
      Unit,
      registration_name(d),
      (constructors: List(DataCtor), c2: Checker) => frame_bind(
        Unit,
        Unit,
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0)
      ),
      ck_data_ctors(
        registration_ctors(d),
        c1,
        ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
      ),
      frame_ordered(
        c1,
        ck_data_ctors(
          registration_ctors(d),
          c1,
          ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
        ),
        ck_data_ctors_frame(
          registration_ctors(d),
          c1,
          ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
        ),
        o1
      ),
      constructors => c2 => o2 => registration_bind_present(
        Unit,
        Unit,
        registration_name(d),
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0),
        ck_register_ctors_ordered(constructors, c2, registration_name(d), 0, o2),
        ignored2 => c3 => o3 => registration_insert_present(
          c3,
          d,
          is_struct,
          builtin,
          constructors,
          o3
        )
      )
    )
  )
}

pub theorem ck_declare_data_present(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool,
  ordered: CkDatasOrdered(c)
): DataPresent(registered_decls(ck_declare_data(c, d, is_struct, builtin)), registration_name(d)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => DataPresent(registered_decls(z), registration_name(d)),
    Eq::sym(registration_declare_unf(c, d, is_struct, builtin)),
    registration_declare_present(c, d, is_struct, builtin, ordered)
  )
}
