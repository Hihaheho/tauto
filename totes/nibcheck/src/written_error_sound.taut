import "error_frame.taut"
import std::Base
import std::Map
import std::Text
import "checker.taut"
import "datas.taut"
import "datas_frame.taut"
import "decl_names_sound.taut"
import "kind_sound.taut"
import "ty.taut"
import "types_decl.taut"
import "unify_sound.taut"
import "../../surface/src/surface.taut"

pub theorem written_error_changed<A: Type>(
  c: Checker,
  next: Checker,
  m: Mut1(A, Checker),
  same: decl_names_errors(next) = decl_names_errors(c),
  h: CkErrorFrame(next, m)
): CkErrorFrame(c, m) {
  clean_errors => Eq::trans(Eq::sym(same), h(clean_errors))
}
pub theorem written_error_return<A: Type, B: Type>(
  c: Checker,
  v: B,
  m: Mut1(A, Checker),
  h: CkErrorFrame(c, m)
): CkErrorFrame(c, frame_return(v, m)) {
  ⊢ CkErrorFrame(c, frame_return(v, m)) from match m { mut1(value, next) => h }
}
pub theorem ck_error_frame_errors(
  c: Checker,
  message: Text,
  span: TySpan
): CkErrorFrame(
  c,
  ck_error(c, message, span)
) { (clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))) }
pub theorem ck_fresh_frame_errors(
  c: Checker
): CkErrorFrame(c, ck_fresh(c)) { (clean_errors => clean_errors) }
pub theorem ck_written_bad_frame_errors(
  c: Checker,
  span: TySpan
): CkErrorFrame(
  c,
  ck_written_bad(c, span)
) { (clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))) }
pub theorem ck_written_ctor_arity_frame_errors(
  c: Checker,
  n: Text,
  span: TySpan
): CkErrorFrame(
  c,
  ck_written_ctor_arity(c, n, span)
) { (clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))) }

pub theorem frame_arity_small_ok_errors(
  c: Checker,
  n: Text,
  span: TySpan,
  data: Data,
  small: Bool
): CkErrorFrame(c, frame_arity_small(c, n, span, data, small)) {
  ⊢ CkErrorFrame(c, frame_arity_small(c, n, span, data, small)) from match small {
    true => (clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors))))
    false => (clean_errors => clean_errors)
  }
}

pub theorem frame_arity_decl_ok_errors(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan,
  o: Option(Data)
): CkErrorFrame(c, frame_arity_decl(c, n, given, span, o)) {
  ⊢ CkErrorFrame(c, frame_arity_decl(c, n, given, span, o)) from match o {
    None => (clean_errors => clean_errors)
    Some(data) => frame_arity_small_ok_errors(
      c,
      n,
      span,
      data,
      not(Nat::eq(given, list_len(dgen(data))))
    )
  }
}

pub theorem frame_arity_k_ok_errors(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan,
  constructor: Bool
): CkErrorFrame(c, frame_arity_k(c, n, given, span, constructor)) {
  ⊢ CkErrorFrame(c, frame_arity_k(c, n, given, span, constructor)) from match constructor {
    true => frame_arity_decl_ok_errors(c, n, given, span, datas_decl(ck_datas_of(c), n))
    false => (clean_errors => clean_errors)
  }
}

pub theorem ck_arity_frame_errors(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan
): CkErrorFrame(c, ck_arity(c, n, given, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(frame_arity_unf(c, n, given, span)),
    frame_arity_k_ok_errors(c, n, given, span, not(frame_constructor_position(c)))
  )
}

pub theorem frame_written_var_named_ok_errors(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty,
  found: Bool
): CkErrorFrame(c, frame_written_var_named(c, n, span, t, found)) {
  ⊢ CkErrorFrame(c, frame_written_var_named(c, n, span, t, found)) from match found {
    true => (clean_errors => clean_errors)
    false => written_error_return(
      c,
      t,
      ck_arity(c, n, 0, span),
      ck_arity_frame_errors(c, n, 0, span)
    )
  }
}

pub theorem frame_written_var_k_ok_errors(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  original: Ty,
  t: Ty
): CkErrorFrame(c, frame_written_var_k(c, n, generics, span, original, t)) {
  ⊢ CkErrorFrame(c, frame_written_var_k(c, n, generics, span, original, t)) from match t {
    TyNamed(name, args) => frame_written_var_named_ok_errors(
      c,
      n,
      span,
      original,
      Ordmap::contains(generics, n, Ordmap::compare_text)
    )
    TyInt(width) => (clean_errors => clean_errors)
    TyBool => (clean_errors => clean_errors)
    TyText => (clean_errors => clean_errors)
    TyUnit => (clean_errors => clean_errors)
    TyNever => (clean_errors => clean_errors)
    TyDecimal => (clean_errors => clean_errors)
    TyFloat => (clean_errors => clean_errors)
    TyFn(params, result, kind) => (clean_errors => clean_errors)
    TyUnion(members) => (clean_errors => clean_errors)
    TyProduct(members) => (clean_errors => clean_errors)
    TyTagged(tags, inner) => (clean_errors => clean_errors)
    TyParam(name, bound) => (clean_errors => clean_errors)
    TyInfo(inner) => (clean_errors => clean_errors)
    TyBorrow(inner, mutable) => (clean_errors => clean_errors)
    TyVar(index) => (clean_errors => clean_errors)
    TyPoly(generics0, inner) => (clean_errors => clean_errors)
    TyApp(head, arg) => (clean_errors => clean_errors)
  }
}

pub theorem ck_written_var_frame_errors(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan
): CkErrorFrame(c, ck_written_var(c, n, generics, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
    Eq::sym(frame_written_var_unf(c, n, generics, span)),
    frame_written_var_k_ok_errors(
      c,
      n,
      generics,
      span,
      ck_written_name(n, generics),
      ck_written_name(n, generics)
    )
  )
}

