    )
    TyText => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyUnit => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyNever => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyDecimal => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyFloat => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyFn(params, result, kind) => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyUnion(members) => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyProduct(members) => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyTagged(tags, inner) => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyNamed(name, args) => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyParam(name, bound) => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => Refl
    )
    TyInfo(inner) => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
