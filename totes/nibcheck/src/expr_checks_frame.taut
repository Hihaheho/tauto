  }
}

pub theorem leaf_clone_target_unf(
  c: Checker,
  t: Ty,
  arg: SurfaceTerm
): ck_clone_target(
  c,
  t,
  arg
) = leaf_clone_target(c, ck_resolve(c, t), arg, ck_resolve(c, t)) { Refl }

pub theorem ck_clone_target_frame(
  c: Checker,
  t: Ty,
  arg: SurfaceTerm
): CkReadFrame(c, ck_clone_target(c, t, arg)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_clone_target_unf(c, t, arg)),
    leaf_clone_target_frame(c, ck_resolve(c, t), arg, ck_resolve(c, t))
  )
}

pub fn leaf_clone_why(c: Checker, span: TySpan, why: Option(Text)): Mut1(Unit, Checker) {
  ⊢ Mut1(Unit, Checker) from match why {
    None => mut1(Star, c)
    Some(message) => ck_rewrap1(ck_error(c, message, span))
  }
}

pub theorem leaf_clone_why_frame(
  c: Checker,
  span: TySpan,
  why: Option(Text)
): CkReadFrame(c, leaf_clone_why(c, span, why)) {
  ⊢ CkReadFrame(c, leaf_clone_why(c, span, why)) from match why {
    None => Refl
    Some(message) => frame_rewrap(c, ck_error(c, message, span), ck_error_frame(c, message, span))
  }
}

pub fn leaf_clone(c: Checker, t0: Ty, arg: SurfaceTerm, span: TySpan): Mut1(Ty, Checker) {
  frame_bind(
    Ty,
    Ty,
    (t: Ty, c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t))
    ),
    ck_clone_target(c, t0, arg)
  )
}

pub theorem leaf_clone_frame(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): CkReadFrame(c, leaf_clone(c, t0, arg, span)) {
  frame_bind_ok(
    Ty,
    Ty,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t))
    ),
    ck_clone_target(c, t0, arg),
    ck_clone_target_frame(c, t0, arg),
    t => c1 => frame_bind_ok(
      Unit,
      Ty,
      c1,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      leaf_clone_why_frame(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      ignored => c2 => Refl
    )
  )
}

pub theorem leaf_clone_unf(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): ck_clone_value(c, t0, arg, span) = leaf_clone(c, t0, arg, span) { Refl }

pub theorem ck_clone_value_frame(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): CkReadFrame(c, ck_clone_value(c, t0, arg, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_clone_unf(c, t0, arg, span)),
    leaf_clone_frame(c, t0, arg, span)
  )
}
