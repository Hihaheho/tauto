pub fn leaf_number(c: Checker, original: Ty, span: TySpan, op: Text, r: Ty): Mut1(Unit, Checker) {
  match r {
    TyInt(^w) => mut1(Star, c)
    TyBool => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyText => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyUnit => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyNever => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyDecimal => mut1(Star, c)
    TyFloat => mut1(Star, c)
    TyFloat32 => mut1(Star, c)
    TyFn(^params, ^result, ^kind) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyUnion(^members) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyProduct(^members) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyTagged(^tags, ^inner) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyNamed(^name, ^args) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyParam(^name, ^bound) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyInfo(^inner) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyBorrow(^inner, ^mutable) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyVar(v) => ck_rewrap1(ck_add_int(c, v))
    TyPoly(^generics, ^inner) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyApp(^typehead, ^typearg) => ck_rewrap1(
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
  }
}

pub theorem leaf_number_frame(
  c: Checker,
  original: Ty,
  span: TySpan,
  op: Text,
  r: Ty
): CkReadFrame(c, leaf_number(c, original, span, op, r)) {
  match r {
    TyInt(w) => Refl
    TyBool => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyText => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyUnit => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyNever => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyDecimal => Refl
    TyFloat => Refl
    TyFloat32 => Refl
    TyFn(params, result, kind) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyUnion(members) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyProduct(members) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyTagged(tags, inner) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyNamed(name, args) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyParam(name, bound) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyInfo(inner) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyBorrow(inner, mutable) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyVar(v) => frame_rewrap(c, ck_add_int(c, v), ck_add_int_frame(c, v))
    TyPoly(generics, inner) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyApp(typehead, typearg) => frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
  }
}

pub theorem leaf_number_unf(
  c: Checker,
  t: Ty,
  span: TySpan,
  op: Text
): ck_number(c, t, span, op) = leaf_number(c, ck_resolve(c, t), span, op, ck_resolve(c, t)) { Refl }

pub theorem ck_number_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  op: Text
): CkReadFrame(c, ck_number(c, t, span, op)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_number_unf(c, t, span, op)),
    leaf_number_frame(c, ck_resolve(c, t), span, op, ck_resolve(c, t))
  )
}

pub fn leaf_div_var(c: Checker, span: TySpan, v: Nat, unknown: Bool): Mut1(Unit, Checker) {
  match unknown {
    true => ck_rewrap1(ck_error(c, division_operands_unknown_message(), span))
    false => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
  }
}

pub theorem leaf_div_var_frame(
  c: Checker,
  span: TySpan,
  v: Nat,
  unknown: Bool
): CkReadFrame(c, leaf_div_var(c, span, v, unknown)) {
  match unknown {
    true => frame_rewrap(
      c,
      ck_error(c, division_operands_unknown_message(), span),
      ck_error_frame(c, division_operands_unknown_message(), span)
    )
    false => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
  }
}

pub fn leaf_divide(c: Checker, span: TySpan, t: Ty): Mut1(Unit, Checker) {
  match t {
    TyInt(^w) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyBool => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyText => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyUnit => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyNever => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyDecimal => mut1(Star, c)
    TyFloat => mut1(Star, c)
    TyFloat32 => mut1(Star, c)
    TyFn(^params, ^result, ^kind) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyUnion(^members) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyProduct(^members) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyTagged(^tags, ^inner) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyNamed(^name, ^args) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyParam(^name, ^bound) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyInfo(^inner) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyBorrow(^inner, ^mutable) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyVar(v) => leaf_div_var(c, span, v, not(ck_is_int(c, v)))
    TyPoly(^generics, ^inner) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
    TyApp(^typehead, ^typearg) => ck_rewrap1(
      ck_error(
        c,
        integer_division_message(),
        span
      )
    )
  }
}

pub theorem leaf_divide_frame(
  c: Checker,
  span: TySpan,
  t: Ty
): CkReadFrame(c, leaf_divide(c, span, t)) {
  match t {
    TyInt(w) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyBool => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyText => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyUnit => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyNever => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyDecimal => Refl
    TyFloat => Refl
    TyFloat32 => Refl
    TyFn(params, result, kind) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyUnion(members) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyProduct(members) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyTagged(tags, inner) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyNamed(name, args) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyParam(name, bound) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyInfo(inner) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyBorrow(inner, mutable) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyVar(v) => leaf_div_var_frame(c, span, v, not(ck_is_int(c, v)))
    TyPoly(generics, inner) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
    TyApp(typehead, typearg) => frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame(
        c,
        integer_division_message(),
        span
      )
    )
  }
}

pub theorem leaf_divide_unf(
  c: Checker,
  a: Ty,
  span: TySpan
): ck_divide(c, a, span) = leaf_divide(c, span, ck_resolve(c, a)) { Refl }

pub theorem ck_divide_frame(
  c: Checker,
  a: Ty,
  span: TySpan
): CkReadFrame(c, ck_divide(c, a, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_divide_unf(c, a, span)),
    leaf_divide_frame(c, span, ck_resolve(c, a))
  )
}

pub fn leaf_clone_target(c: Checker, original: Ty, arg: SurfaceTerm, t: Ty): Mut1(Ty, Checker) {
  match t {
    TyInt(^w) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyBool => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyText => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyUnit => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyNever => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyDecimal => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyFloat => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyFloat32 => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyFn(^params, ^result, ^kind) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyUnion(^members) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyProduct(^members) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyTagged(^tags, ^inner) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyNamed(^name, ^args) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyParam(^name, ^bound) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyInfo(^inner) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyBorrow(x, ^m) => mut1(x, c)
    TyVar(^v) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyPoly(^generics, ^inner) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
    TyApp(^typehead, ^typearg) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg))
    )
  }
}

