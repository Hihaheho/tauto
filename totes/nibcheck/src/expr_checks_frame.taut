    c,
    ck_error(
      c,
      borrow_cannot_be_stored_message(name, ty_show(ck_shown(c, resolved))),
      span_of(value)
    ),
    ck_error_frame(
      c,
      borrow_cannot_be_stored_message(name, ty_show(ck_shown(c, resolved))),
      span_of(value)
    )
  )
}

pub theorem leaf_ck_stored_borrow_unf(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm
): ck_stored_borrow(
  c,
  name,
