pub theorem ck_record_op_frame(
  c: Checker,
  a: Ty,
  span: TySpan,
  occurrence: Option(TermOccurrence)
): CkReadFrame(c, ck_record_op(c, a, span, occurrence)) { Refl }

pub theorem ck_add_int_frame(c: Checker, v: Nat): CkReadFrame(c, ck_add_int(c, v)) { Refl }

pub fn leaf_ck_field_missing(c: Checker, term: SurfaceTerm, t: Ty, name: Text): Mut1(Ty, Checker) {
  frame_bind(
    <A: Unit, B: Ty>,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, no_field_message(ty_show(t), name), span_of(term))
  )
}

pub theorem leaf_ck_field_missing_frame(
  c: Checker,
  term: SurfaceTerm,
  t: Ty,
  name: Text
): CkReadFrame(c, leaf_ck_field_missing(c, term, t, name)) {
  frame_bind_ok(
    <A: Unit, B: Ty>,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, no_field_message(ty_show(t), name), span_of(term)),
    ck_error_frame(c, no_field_message(ty_show(t), name), span_of(term)),
    ignored => c1 => frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1))
  )
}

pub theorem leaf_ck_field_missing_unf(
  c: Checker,
  term: SurfaceTerm,
  t: Ty,
  name: Text
): ck_field_missing(c, term, t, name) = leaf_ck_field_missing(c, term, t, name) { Refl }

pub theorem ck_field_missing_frame(
  c: Checker,
  term: SurfaceTerm,
  t: Ty,
  name: Text
): CkReadFrame(c, ck_field_missing(c, term, t, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_ck_field_missing_unf(c, term, t, name)),
    leaf_ck_field_missing_frame(c, term, t, name)
  )
}

pub fn leaf_ck_operator_bad(c: Checker, op: Text, span: TySpan): Mut1(Ty, Checker) {
  frame_bind(
    <A: Unit, B: Ty>,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, operator_other_operands_message(op), span)
  )
}

pub theorem leaf_ck_operator_bad_frame(
  c: Checker,
  op: Text,
  span: TySpan
): CkReadFrame(c, leaf_ck_operator_bad(c, op, span)) {
  frame_bind_ok(
    <A: Unit, B: Ty>,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, operator_other_operands_message(op), span),
    ck_error_frame(c, operator_other_operands_message(op), span),
    ignored => c1 => frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1))
  )
}

pub theorem leaf_ck_operator_bad_unf(
  c: Checker,
  op: Text,
  span: TySpan
): ck_operator_bad(c, op, span) = leaf_ck_operator_bad(c, op, span) { Refl }

pub theorem ck_operator_bad_frame(
  c: Checker,
  op: Text,
  span: TySpan
): CkReadFrame(c, ck_operator_bad(c, op, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_ck_operator_bad_unf(c, op, span)),
    leaf_ck_operator_bad_frame(c, op, span)
  )
}

pub fn leaf_ck_clone_bad(c: Checker, span: TySpan): Mut1(Ty, Checker) {
  frame_bind(
    <A: Unit, B: Ty>,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, "`clone` takes one borrow, `clone(&x)`", span)
  )
}

pub theorem leaf_ck_clone_bad_frame(
  c: Checker,
  span: TySpan
): CkReadFrame(c, leaf_ck_clone_bad(c, span)) {
  frame_bind_ok(
    <A: Unit, B: Ty>,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, "`clone` takes one borrow, `clone(&x)`", span),
    ck_error_frame(c, "`clone` takes one borrow, `clone(&x)`", span),
    ignored => c1 => frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1))
  )
}

pub theorem leaf_ck_clone_bad_unf(
  c: Checker,
  span: TySpan
): ck_clone_bad(c, span) = leaf_ck_clone_bad(c, span) { Refl }

pub theorem ck_clone_bad_frame(c: Checker, span: TySpan): CkReadFrame(c, ck_clone_bad(c, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_ck_clone_bad_unf(c, span)),
    leaf_ck_clone_bad_frame(c, span)
  )
}

pub fn leaf_lend_name(inner: SurfaceTerm): Text { match place_name(inner) { Some(w) => w
    None => "this" } }

pub fn leaf_ck_check_lend(
  c: Checker,
  mutable: Bool,
  inner: SurfaceTerm,
  env: List(Local),
  span: TySpan
): Mut1(Unit, Checker) {
  frame_error_if(
    c,
    not_a_var_for_lend_message(leaf_lend_name(inner)),
    span,
    Bool::and(mutable, not(ck_mutable_place(inner, c, env)))
  )
}

pub theorem leaf_ck_check_lend_frame(
  c: Checker,
  mutable: Bool,
  inner: SurfaceTerm,
  env: List(Local),
  span: TySpan
): CkReadFrame(c, leaf_ck_check_lend(c, mutable, inner, env, span)) {
  frame_error_if_ok(
    c,
    not_a_var_for_lend_message(leaf_lend_name(inner)),
    span,
    Bool::and(mutable, not(ck_mutable_place(inner, c, env)))
  )
}

pub theorem leaf_ck_check_lend_unf(
  c: Checker,
  mutable: Bool,
  inner: SurfaceTerm,
  env: List(Local),
  span: TySpan
): ck_check_lend(
  c,
  mutable,
  inner,
  env,
  span
) = leaf_ck_check_lend(c, mutable, inner, env, span) { Refl }

pub theorem ck_check_lend_frame(
  c: Checker,
  mutable: Bool,
  inner: SurfaceTerm,
  env: List(Local),
  span: TySpan
): CkReadFrame(c, ck_check_lend(c, mutable, inner, env, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_ck_check_lend_unf(c, mutable, inner, env, span)),
    leaf_ck_check_lend_frame(c, mutable, inner, env, span)
  )
}

pub fn leaf_ck_check_covers(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): Mut1(Unit, Checker) {
  frame_bind(
    <A: Unit, B: Unit>,
    (reported: Unit, c1: Checker) => ck_rewrap1(ck_check_default_arm(c1, s, arms, span)),
    frame_error_if(
      c,
      match_not_exhaustive_message(),
      span,
      not(covers(ck_datas_of(c), ck_resolve(c, s), open_patterns(arms)))
    )
  )
}

pub fn leaf_ck_float_literal(c: Checker, x: Text, span: TySpan): Mut1(Ty, Checker) {
  frame_bind(
    <A: Unit, B: Ty>,
    (reported: Unit, c1: Checker) => mut1(TyFloat, c1),
    frame_error_if(c, float_too_large_message(x), span, not(float_literal_fits(x)))
  )
}

pub theorem ck_float_literal_unf(
  c: Checker,
  x: Text,
  span: TySpan
): ck_float_literal(c, x, span) = leaf_ck_float_literal(c, x, span) { Refl }

pub theorem ck_float_literal_frame(c: Checker, x: Text, span: TySpan): CkReadFrame(c, ck_float_literal(c, x, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(ck_float_literal_unf(c, x, span)),
    frame_bind_ok(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => mut1(TyFloat, c1),
      frame_error_if(c, float_too_large_message(x), span, not(float_literal_fits(x))),
      frame_error_if_ok(c, float_too_large_message(x), span, not(float_literal_fits(x))),
      reported => c1 => Refl
    )
  )
}

// Whatever it reports, a `Float` literal is a `Float`.
pub theorem float_literal_val_on(c: Checker, x: Text, span: TySpan, b: Bool): ck_val(
  frame_bind(
    <A: Unit, B: Ty>,
    (reported: Unit, c1: Checker) => mut1(TyFloat, c1),
    frame_error_if(c, float_too_large_message(x), span, b)
  )
) = TyFloat {
  ⊢ ck_val(
    frame_bind(
      <A: Unit, B: Ty>,
      (reported: Unit, c1: Checker) => mut1(TyFloat, c1),
      frame_error_if(c, float_too_large_message(x), span, b)
    )
  ) = TyFloat from match b {
    true => Refl
    false => Refl
  }
}

pub theorem ck_float_literal_val(c: Checker, x: Text, span: TySpan): ck_val(ck_float_literal(c, x, span)) = TyFloat {
  Eq::trans(
    Eq::congr((m: Mut1(Ty, Checker)) => ck_val(m), ck_float_literal_unf(c, x, span)),
    float_literal_val_on(c, x, span, not(float_literal_fits(x)))
  )
}

pub fn leaf_ck_check_default_arm(c: Checker, s: Ty, arms: List(SurfaceArm), span: TySpan): Mut1(Unit, Checker) {
  frame_error_if(
    c,
    problem_message(arm_problem(ck_datas_of(c), ck_resolve(c, s), arms, span)),
    problem_span(arm_problem(ck_datas_of(c), ck_resolve(c, s), arms, span)),
    problem_found(arm_problem(ck_datas_of(c), ck_resolve(c, s), arms, span))
  )
}

pub theorem leaf_ck_check_default_arm_unf(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): ck_check_default_arm(c, s, arms, span) = leaf_ck_check_default_arm(c, s, arms, span) { Refl }

pub theorem leaf_ck_check_default_arm_frame(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): CkReadFrame(c, leaf_ck_check_default_arm(c, s, arms, span)) {
  frame_error_if_ok(
    c,
    problem_message(arm_problem(ck_datas_of(c), ck_resolve(c, s), arms, span)),
    problem_span(arm_problem(ck_datas_of(c), ck_resolve(c, s), arms, span)),
    problem_found(arm_problem(ck_datas_of(c), ck_resolve(c, s), arms, span))
  )
}

pub theorem leaf_ck_check_covers_frame(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): CkReadFrame(c, leaf_ck_check_covers(c, s, arms, span)) {
  frame_bind_ok(
    <A: Unit, B: Unit>,
    c,
    (reported: Unit, c1: Checker) => ck_rewrap1(ck_check_default_arm(c1, s, arms, span)),
    frame_error_if(c, match_not_exhaustive_message(), span, not(covers(ck_datas_of(c), ck_resolve(c, s), open_patterns(arms)))),
    frame_error_if_ok(c, match_not_exhaustive_message(), span, not(covers(ck_datas_of(c), ck_resolve(c, s), open_patterns(arms)))),
    reported => c1 => frame_rewrap(
      c1,
      ck_check_default_arm(c1, s, arms, span),
      Eq::subst(
        (z: Mut1(Unit, Checker)) => CkReadFrame(c1, z),
        Eq::sym(leaf_ck_check_default_arm_unf(c1, s, arms, span)),
        leaf_ck_check_default_arm_frame(c1, s, arms, span)
      )
    )
  )
}

pub theorem leaf_ck_check_covers_unf(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): ck_check_covers(c, s, arms, span) = leaf_ck_check_covers(c, s, arms, span) { Refl }

pub theorem ck_check_covers_frame(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): CkReadFrame(c, ck_check_covers(c, s, arms, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_ck_check_covers_unf(c, s, arms, span)),
    leaf_ck_check_covers_frame(c, s, arms, span)
  )
}

pub fn leaf_ck_stored_borrow(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm
): Mut1(Unit, Checker) {
  ck_rewrap1(
    ck_error(
      c,
      borrow_cannot_be_stored_message(name, ty_show(ck_shown(c, resolved))),
      span_of(value)
    )
  )
}

