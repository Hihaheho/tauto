      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => Refl
    )
    TyFn(params, result, kind) => frame_bind_ok(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => Refl
    )
    TyUnion(members) => frame_bind_ok(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => Refl
    )
    TyProduct(members) => frame_bind_ok(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => Refl
    )
    TyTagged(tags, inner) => frame_bind_ok(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => Refl
    )
    TyNamed(name, args) => frame_bind_ok(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => Refl
