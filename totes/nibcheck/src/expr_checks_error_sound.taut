  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_ck_check_covers_unf(c, s, arms, span)),
    leaf_ck_check_covers_frame_errors(c, s, arms, span)
  )
}

pub theorem leaf_ck_stored_borrow_frame_errors(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm
): CkErrorFrame(c, leaf_ck_stored_borrow(c, name, resolved, value)) {
  error_frame_rewrap(
    c,
    ck_error(
      c,
      borrow_cannot_be_stored_message(name, ty_show(ck_shown(c, resolved))),
      span_of(value)
    ),
    ck_error_frame_errors(
      c,
      borrow_cannot_be_stored_message(name, ty_show(ck_shown(c, resolved))),
      span_of(value)
    )
  )
}

pub theorem ck_stored_borrow_frame_errors(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm
): CkErrorFrame(c, ck_stored_borrow(c, name, resolved, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_ck_stored_borrow_unf(c, name, resolved, value)),
    leaf_ck_stored_borrow_frame_errors(c, name, resolved, value)
  )
}

pub theorem leaf_number_frame_errors(
  c: Checker,
  original: Ty,
  span: TySpan,
  op: Text,
  r: Ty
): CkErrorFrame(c, leaf_number(c, original, span, op, r)) {
  match r {
    TyInt(w) => (clean_errors => clean_errors)
    TyBool => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyText => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyUnit => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyNever => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyDecimal => (clean_errors => clean_errors)
    TyFloat => (clean_errors => clean_errors)
    TyFloat32 => (clean_errors => clean_errors)
    TyFn(params, result, kind) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyUnion(members) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyProduct(members) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyTagged(tags, inner) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyNamed(name, args) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyParam(name, bound) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyInfo(inner) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyBorrow(inner, mutable) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyVar(v) => error_frame_rewrap(c, ck_add_int(c, v), ck_add_int_frame_errors(c, v))
    TyPoly(generics, inner) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
    TyApp(typehead, typearg) => error_frame_rewrap(
      c,
      ck_error(c, operator_not_a_number_message(op, ty_show(original)), span),
      ck_error_frame_errors(c, operator_not_a_number_message(op, ty_show(original)), span)
    )
  }
}

pub theorem ck_number_frame_errors(
  c: Checker,
  t: Ty,
  span: TySpan,
  op: Text
): CkErrorFrame(c, ck_number(c, t, span, op)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_number_unf(c, t, span, op)),
    leaf_number_frame_errors(c, ck_resolve(c, t), span, op, ck_resolve(c, t))
  )
}

pub theorem leaf_div_var_frame_errors(
  c: Checker,
  span: TySpan,
  v: Nat,
  unknown: Bool
): CkErrorFrame(c, leaf_div_var(c, span, v, unknown)) {
  match unknown {
    true => error_frame_rewrap(
      c,
      ck_error(c, division_operands_unknown_message(), span),
      ck_error_frame_errors(c, division_operands_unknown_message(), span)
    )
    false => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
  }
}

pub theorem leaf_divide_frame_errors(
  c: Checker,
  span: TySpan,
  t: Ty
): CkErrorFrame(c, leaf_divide(c, span, t)) {
  match t {
    TyInt(w) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyBool => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyText => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyUnit => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyNever => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyDecimal => (clean_errors => clean_errors)
    TyFloat => (clean_errors => clean_errors)
    TyFloat32 => (clean_errors => clean_errors)
    TyFn(params, result, kind) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyUnion(members) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyProduct(members) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyTagged(tags, inner) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyNamed(name, args) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyParam(name, bound) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyInfo(inner) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyBorrow(inner, mutable) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyVar(v) => leaf_div_var_frame_errors(c, span, v, not(ck_is_int(c, v)))
    TyPoly(generics, inner) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
    TyApp(typehead, typearg) => error_frame_rewrap(
      c,
      ck_error(
        c,
        integer_division_message(),
        span
      ),
      ck_error_frame_errors(
        c,
        integer_division_message(),
        span
      )
    )
  }
}

pub theorem ck_divide_frame_errors(
  c: Checker,
  a: Ty,
  span: TySpan
): CkErrorFrame(c, ck_divide(c, a, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_divide_unf(c, a, span)),
    leaf_divide_frame_errors(c, span, ck_resolve(c, a))
  )
}

pub theorem leaf_clone_target_frame_errors(
  c: Checker,
  original: Ty,
  arg: SurfaceTerm,
  t: Ty
): CkErrorFrame(c, leaf_clone_target(c, original, arg, t)) {
  match t {
    TyInt(w) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyBool => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyText => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyUnit => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyNever => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyDecimal => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyFloat => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyFloat32 => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyFn(params, result, kind) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyUnion(members) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyProduct(members) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyTagged(tags, inner) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyNamed(name, args) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyParam(name, bound) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyInfo(inner) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyBorrow(x, m) => (clean_errors => clean_errors)
    TyVar(v) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyPoly(generics, inner) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyApp(typehead, typearg) => error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_errors(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
  }
}

pub theorem ck_clone_target_frame_errors(
  c: Checker,
  t: Ty,
  arg: SurfaceTerm
): CkErrorFrame(c, ck_clone_target(c, t, arg)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_clone_target_unf(c, t, arg)),
    leaf_clone_target_frame_errors(c, ck_resolve(c, t), arg, ck_resolve(c, t))
  )
}

pub theorem leaf_clone_why_frame_errors(
  c: Checker,
  span: TySpan,
  why: Option(Text)
): CkErrorFrame(c, leaf_clone_why(c, span, why)) {
  match why {
    None => (clean_errors => clean_errors)
    Some(message) => error_frame_rewrap(
      c,
      ck_error(c, message, span),
      ck_error_frame_errors(c, message, span)
    )
  }
}

pub theorem leaf_clone_frame_errors(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): CkErrorFrame(c, leaf_clone(c, t0, arg, span)) {
  error_frame_bind(
    <A: Ty, B: Ty>,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t))
    ),
    ck_clone_target(c, t0, arg),
    ck_clone_target_frame_errors(c, t0, arg),
    t => c1 => error_frame_bind(
      <A: Unit, B: Ty>,
      c1,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      leaf_clone_why_frame_errors(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      ignored => c2 => (clean_errors => clean_errors)
    )
  )
}

pub theorem ck_clone_value_frame_errors(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): CkErrorFrame(c, ck_clone_value(c, t0, arg, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_clone_unf(c, t0, arg, span)),
    leaf_clone_frame_errors(c, t0, arg, span)
  )
}
