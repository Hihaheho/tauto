        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyText => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyUnit => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyNever => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyDecimal => (clean_errors => clean_errors)
    TyFloat => (clean_errors => clean_errors)
    TyFn(params, result, kind) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyUnion(members) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyProduct(members) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyTagged(tags, inner) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyNamed(name, args) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyParam(name, bound) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyInfo(inner) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyBorrow(inner, mutable) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyVar(v) => leaf_div_var_frame_errors(c, span, v, not(ck_is_int(c, v)))
    TyPoly(generics, inner) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
    TyApp(typehead, typearg) => error_frame_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_errors(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
  }
}

pub theorem ck_divide_frame_errors(
  c: Checker,
  a: Ty,
  span: TySpan
): CkErrorFrame(c, ck_divide(c, a, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_divide_unf(c, a, span)),
    leaf_divide_frame_errors(c, span, ck_resolve(c, a))
  )
}

pub theorem leaf_clone_target_frame_errors(
  c: Checker,
  original: Ty,
  arg: SurfaceTerm,
  t: Ty
): CkErrorFrame(c, leaf_clone_target(c, original, arg, t)) {
  match t: CkErrorFrame(c, leaf_clone_target(c, original, arg, t)) {
    TyInt(w) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyBool => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyText => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyUnit => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyNever => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyDecimal => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyFloat => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyFn(params, result, kind) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyUnion(members) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyProduct(members) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyTagged(tags, inner) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyNamed(name, args) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyParam(name, bound) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyInfo(inner) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyBorrow(x, m) => (clean_errors => clean_errors)
    TyVar(v) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyPoly(generics, inner) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    TyApp(typehead, typearg) => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_errors(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => (clean_errors => clean_errors)
    )
  }
}

pub theorem ck_clone_target_frame_errors(
  c: Checker,
  t: Ty,
  arg: SurfaceTerm
): CkErrorFrame(c, ck_clone_target(c, t, arg)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_clone_target_unf(c, t, arg)),
    leaf_clone_target_frame_errors(c, ck_resolve(c, t), arg, ck_resolve(c, t))
  )
}

pub theorem leaf_clone_why_frame_errors(
  c: Checker,
  span: TySpan,
  why: Option(Text)
): CkErrorFrame(c, leaf_clone_why(c, span, why)) {
  match why: CkErrorFrame(c, leaf_clone_why(c, span, why)) {
    None => (clean_errors => clean_errors)
    Some(message) => error_frame_rewrap(
      c,
      ck_error(c, message, span),
      ck_error_frame_errors(c, message, span)
    )
  }
}

pub theorem leaf_clone_frame_errors(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): CkErrorFrame(c, leaf_clone(c, t0, arg, span)) {
  error_frame_bind(
    Ty,
    Ty,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t))
    ),
    ck_clone_target(c, t0, arg),
    ck_clone_target_frame_errors(c, t0, arg),
    t => c1 => error_frame_bind(
      Unit,
      Ty,
      c1,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      leaf_clone_why_frame_errors(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      ignored => c2 => (clean_errors => clean_errors)
    )
  )
}

pub theorem ck_clone_value_frame_errors(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): CkErrorFrame(c, ck_clone_value(c, t0, arg, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_clone_unf(c, t0, arg, span)),
    leaf_clone_frame_errors(c, t0, arg, span)
  )
}
