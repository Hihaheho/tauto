pub theorem leaf_ck_check_lend_frame_errors(
  c: Checker,
  mutable: Bool,
  inner: SurfaceTerm,
  env: List(Local),
  span: TySpan
): CkErrorFrame(c, leaf_ck_check_lend(c, mutable, inner, env, span)) {
  frame_error_if_ok_errors(
    c,
    not_a_var_for_lend_message(leaf_lend_name(inner)),
    span,
    Bool::and(mutable, not(ck_mutable_place(inner, c, env)))
  )
}

pub theorem ck_check_lend_frame_errors(
  c: Checker,
  mutable: Bool,
  inner: SurfaceTerm,
  env: List(Local),
  span: TySpan
): CkErrorFrame(c, ck_check_lend(c, mutable, inner, env, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(leaf_ck_check_lend_unf(c, mutable, inner, env, span)),
    leaf_ck_check_lend_frame_errors(c, mutable, inner, env, span)
  )
}

pub theorem leaf_ck_check_covers_frame_errors(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): CkErrorFrame(c, leaf_ck_check_covers(c, s, arms, span)) {
  error_frame_bind(
    <A: Unit, B: Unit>,
    c,
    (reported: Unit, c1: Checker) => ck_rewrap1(ck_check_default_arm(c1, s, arms, span)),
    frame_error_if(c, match_not_exhaustive_message(), span, not(covers(ck_datas_of(c), ck_resolve(c, s), open_patterns(arms)))),
    frame_error_if_ok_errors(c, match_not_exhaustive_message(), span, not(covers(ck_datas_of(c), ck_resolve(c, s), open_patterns(arms)))),
    reported => c1 => error_frame_rewrap(
      c1,
      ck_check_default_arm(c1, s, arms, span),
      Eq::subst(
        (z: Mut1(Unit, Checker)) => CkErrorFrame(c1, z),
        Eq::sym(leaf_ck_check_default_arm_unf(c1, s, arms, span)),
        frame_error_if_ok_errors(
        c1,
        problem_message(arm_problem(ck_datas_of(c1), ck_resolve(c1, s), arms, span)),
        problem_span(arm_problem(ck_datas_of(c1), ck_resolve(c1, s), arms, span)),
        problem_found(arm_problem(ck_datas_of(c1), ck_resolve(c1, s), arms, span))
      )
    )
      )
    )
}

pub theorem ck_float_literal_frame_errors(
  c: Checker,
  x: Text,
  span: TySpan
): CkErrorFrame(c, ck_float_literal(c, x, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
    Eq::sym(ck_float_literal_unf(c, x, span)),
    error_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => mut1(TyFloat, c1),
      frame_error_if(c, float_too_large_message(x), span, not(float_literal_fits(x))),
      frame_error_if_ok_errors(c, float_too_large_message(x), span, not(float_literal_fits(x))),
      reported => c1 => clean => clean
    )
  )
}

pub theorem ck_check_covers_frame_errors(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
