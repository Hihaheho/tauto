import "instances_function_table_ordered.taut"
import "field_recheck_function_table.taut"
import "prepare_sound.taut"
import "prepare_signature_sources.taut"

pub theorem fnt_recheck_step(
  ds: List(SurfaceData),
  c: Checker
): CkFnsStep(c, ck_recheck_datas(ds, c)) {
  fnt_step_read(c, ck_recheck_datas(ds, c), fnt_ck_recheck_datas_frame(ds, c))
}

pub theorem fnt_data_names_at_step(
  c: Checker,
  duplicate: Option(SurfaceData)
): CkFnsStep(c, data_names_check(c, duplicate)) {
  match duplicate: CkFnsStep(c, data_names_check(c, duplicate)) {
    None => ordered => ordered
    Some(source) => ordered => ordered
  }
}
pub theorem fnt_data_names_step(
  c: Checker,
  sources: List(SurfaceData)
): CkFnsStep(c, ck_check_data_names(c, sources)) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => CkFnsStep(c, m),
    Eq::sym(data_names_check_unf(c, sources)),
    fnt_data_names_at_step(c, types_duplicate_data(sources, Ordmap::empty()))
  )
}
pub theorem fnt_fn_names_at_step(
  c: Checker,
  duplicate: Option(SurfaceFn)
): CkFnsStep(c, decl_names_check(c, duplicate)) {
  match duplicate: CkFnsStep(c, decl_names_check(c, duplicate)) {
    None => ordered => ordered
    Some(source) => ordered => ordered
  }
}
pub theorem fnt_fn_names_step(
  c: Checker,
  sources: List(SurfaceFn)
): CkFnsStep(c, ck_check_fn_names(c, sources)) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => CkFnsStep(c, m),
    Eq::sym(decl_names_check_unf(c, sources)),
    fnt_fn_names_at_step(c, types_duplicate_fn(sources, Ordmap::empty()))
  )
}
pub theorem registration_fns_after_fields_fns_ordered(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkFnsStep(c, registration_fns_after_fields(c, prelude, program, own)) {
  fnt_step_bind(
    List(SurfaceFn),
    List(Pair(SurfaceFn, Scheme)),
    c,
    (synthesized: List(SurfaceFn), c1: Checker) => frame_bind(
      Unit,
      List(Pair(SurfaceFn, Scheme)),
      (ignored: Unit, c2: Checker) => frame_bind(
        List(Pair(SurfaceFn, Scheme)),
        List(Pair(SurfaceFn, Scheme)),
        (fns: List(Pair(SurfaceFn, Scheme)), c3: Checker) => mut1(
          List::append(fns, ck_synthesized_schemes(synthesized, c3)),
          c3
        ),
        ck_program_decls(program, c2)
      ),
      ck_prelude_fns(prelude, c1, own)
    ),
    ck_declare_classes(c, program),
    ck_declare_classes_fns_ordered(c, program),
    synthesized => c1 => fnt_step_bind(
      Unit,
      List(Pair(SurfaceFn, Scheme)),
      c1,
      (ignored: Unit, c2: Checker) => frame_bind(
        List(Pair(SurfaceFn, Scheme)),
        List(Pair(SurfaceFn, Scheme)),
        (fns: List(Pair(SurfaceFn, Scheme)), c3: Checker) => mut1(
          List::append(fns, ck_synthesized_schemes(synthesized, c3)),
          c3
        ),
        ck_program_decls(program, c2)
      ),
      ck_prelude_fns(prelude, c1, own),
      ck_prelude_fns_ordered(prelude, c1, own),
      ignored => c2 => fnt_step_bind(
        List(Pair(SurfaceFn, Scheme)),
        List(Pair(SurfaceFn, Scheme)),
        c2,
        (fns: List(Pair(SurfaceFn, Scheme)), c3: Checker) => mut1(
          List::append(fns, ck_synthesized_schemes(synthesized, c3)),
          c3
        ),
        ck_program_decls(program, c2),
        ck_program_decls_ordered(program, c2),
        fns => c3 => ordered => ordered
      )
    )
  )
}

pub theorem registration_fns_after_names_fns_ordered(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkFnsStep(c, registration_fns_after_names(c, prelude, program, own)) {
  fnt_step_bind(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    c,
    (ignored: Unit, next: Checker) => registration_fns_after_fields(next, prelude, program, own),
    ck_recheck_datas(types_data_decls(program), c),
    fnt_recheck_step(types_data_decls(program), c),
    ignored => next => registration_fns_after_fields_fns_ordered(next, prelude, program, own)
  )
}

pub theorem registration_fns_after_data_names_fns_ordered(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkFnsStep(c, registration_fns_after_data_names(c, prelude, program, own)) {
  fnt_step_bind(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    c,
    (ignored: Unit, next: Checker) => registration_fns_after_names(next, prelude, program, own),
    ck_check_fn_names(c, types_function_decls(program)),
    fnt_fn_names_step(c, types_function_decls(program)),
    ignored => next => registration_fns_after_names_fns_ordered(next, prelude, program, own)
  )
}

pub theorem registration_fns_fns_ordered(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkFnsStep(c, registration_fns(c, prelude, program, own)) {
  fnt_step_bind(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    c,
    (ignored: Unit, next: Checker) => registration_fns_after_data_names(
      next,
      prelude,
      program,
      own
    ),
    ck_check_data_names(c, types_data_decls(program)),
    fnt_data_names_step(c, types_data_decls(program)),
    ignored => next => registration_fns_after_data_names_fns_ordered(next, prelude, program, own)
  )
}
pub theorem ck_prepare_fns_fns_ordered(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkFnsStep(c, ck_prepare_fns(c, prelude, program, own)) {
  Eq::subst(
    (z: Mut1(List(Pair(SurfaceFn, Scheme)), Checker)) => CkFnsStep(c, z),
    Eq::sym(registration_fns_unf(c, prelude, program, own)),
    registration_fns_fns_ordered(c, prelude, program, own)
  )
}
