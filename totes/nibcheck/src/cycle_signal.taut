import std::TextOps
import std::Base

pub fn cy_is_signal_primitive(name: Text): Bool {
  name == "Signal::fresh" || name == "Signal::raise" || name == "Signal::is_raised" || name == "Signal::either" || name == "Signal::listen"
}

pub theorem cy_signal_fresh_flatten(): cy_is_signal_primitive("Signal::fresh") = true { Refl }
pub theorem cy_signal_raise_flatten(): cy_is_signal_primitive("Signal::raise") = true { Refl }
pub theorem cy_signal_is_raised_flatten(): cy_is_signal_primitive(
  "Signal::is_raised"
) = true { Refl }
pub theorem cy_signal_either_flatten(): cy_is_signal_primitive("Signal::either") = true { Refl }
pub theorem cy_signal_listen_flatten(): cy_is_signal_primitive("Signal::listen") = true { Refl }
