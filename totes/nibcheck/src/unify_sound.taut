import "unify.taut"
import "ty_eq.taut"
import std::MapLaws

// The unifier of `src/checker.taut` is sound
// (`docs/design/self-host.md`「層 2：`ck_unify`（`src/unify_sound.taut`）」):
// when it says two types are the same, they are, under the substitution it leaves
// (`TyEq`, with the rigid types it recorded); and whatever it says,
// it only binds variables that were not bound and only records more.

// ----- the checker's state -----

pub fn ck_val<A>(m: Mut1(A, Checker)): A {
  match m: A {
    mut1(v, c) => v
  }
}

pub fn ck_st<A>(m: Mut1(A, Checker)): Checker {
  match m: Checker {
    mut1(v, c) => c
  }
}

pub fn ck_subst_of(c: Checker): Ordmap(Nat, Ty) {
  c.subst
}

pub fn ck_type_params_of(c: Checker): List(TypeName) {
  c.type_params
}

pub fn ck_kept_of(c: Checker): List(TyKept) {
  c.kept
}

pub fn ck_datas_of(c: Checker): Datas {
  c.datas
}

pub fn ck_bounds_of(c: Checker): List(TyBound) {
  c.bounds
}

pub fn ck_rewrap1<A, S>(m: Mut1(A, S)): Mut1(A, S) {
  match m: Mut1(A, S) {
    mut1(v, x) => mut1(v, x)
  }
}

pub theorem ck_rewrap1_id<A: Type, S: Type>(m: Mut1(A, S)): (ck_rewrap1(m) = m) {
  match m: (ck_rewrap1(m) = m) {
    mut1(v, x) => Refl
  }
}

pub theorem ck_none_ne_some<A: Type>(x: A, e: None = Some(x)): False {
  match e: False {
  }
}

// A use of rigid types the checker recorded.
pub(open) inductive KeptIn: (
  List(TyKept),
  List(Pair(Text, Kind)),
  Ordmap(Text, Ty),
  Ty,
  Ty
) -> Prop {
  KeptHere(
    gs: List(Pair(Text, Kind)),
    rigid: Ordmap(Text, Ty),
    a: Ty,
    b: Ty,
    rest: List(TyKept)
  ): KeptIn(Cons(TyKeptMk(gs, rigid, a, b), rest), gs, rigid, a, b)
  KeptThere<ks: List(
    TyKept
  ), gs: List(
    Pair(Text, Kind)
  ), rigid: Ordmap(
    Text,
    Ty
  ), a: Ty, b: Ty>(k: TyKept, h: KeptIn(ks, gs, rigid, a, b)): KeptIn(Cons(k, ks), gs, rigid, a, b)
}

pub fn KeptOk(ks: List(TyKept)): (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop {
  (gs: List(Pair(Text, Kind)), rigid: Ordmap(Text, Ty), a: Ty, b: Ty) => KeptIn(ks, gs, rigid, a, b)
}

pub def CkOrdered(c: Checker): Prop := Ordmap::ordered(ck_subst_of(c), Ordmap::compare_nat)

// A kind bound the checker recorded.
pub(open) inductive BoundIn: (List(TyBound), TyBound) -> Prop {
  BoundHere(b: TyBound, rest: List(TyBound)): BoundIn(Cons(b, rest), b)
  BoundThere<bs: List(TyBound), b: TyBound>(x: TyBound, h: BoundIn(bs, b)): BoundIn(Cons(x, bs), b)
}

pub def BoundsExt(
  bs: List(TyBound),
  bs2: List(TyBound)
): Prop := ∀ b: TyBound. (BoundIn(bs, b)) -> BoundIn(bs2, b)

pub fn ck_errors_of(c: Checker): List(TypeError) { c.errors }

// What unifying and fitting keep: the declared data, and the kind bounds
// recorded, which only grow.
// Unification and compatibility checks neither remove literal obligations nor
// replace the function table used by expression lookup.
pub fn ck_stable_view(c: Checker): Pair(List(TyLiteral), Ordmap(Text, Scheme)) {
  Pair { fst: c.literals, snd: c.fns }
}

// Primitive type operations preserve deferred class and constructor-kind
// obligations as well as literal records and the function environment.
pub fn ck_deferred_view(
  c: Checker
): Pair(Pair(List(TyLiteral), Ordmap(Text, Scheme)), Pair(List(TyPending), List(TyCtorBound))) {
  Pair {fst: ck_stable_view(c), snd: Pair {fst: c.pending, snd: c.ctor_bounds}}
}
pub fn ck_deferred_stable(
  r#view: Pair(Pair(List(TyLiteral), Ordmap(Text, Scheme)), Pair(List(TyPending), List(TyCtorBound)))
): Pair(List(TyLiteral), Ordmap(Text, Scheme)) { (r#view: Pair(List(TyLiteral), Ordmap(Text, Scheme))) }
pub fn ck_deferred_pending(
  r#view: Pair(Pair(List(TyLiteral), Ordmap(Text, Scheme)), Pair(List(TyPending), List(TyCtorBound)))
): List(TyPending) { (r#view: Pair(List(TyPending), List(TyCtorBound))).fst }
pub fn ck_deferred_ctors(
  r#view: Pair(Pair(List(TyLiteral), Ordmap(Text, Scheme)), Pair(List(TyPending), List(TyCtorBound)))
): List(TyCtorBound) { (r#view: Pair(List(TyPending), List(TyCtorBound))).snd }

pub def CkFixed(
  c: Checker,
  c2: Checker
): Prop := And(
  ck_datas_of(c) = ck_datas_of(c2),
  And(
    BoundsExt(ck_bounds_of(c), ck_bounds_of(c2)),
    And(
      ck_errors_of(c) = ck_errors_of(c2),
      ck_deferred_view(c) = ck_deferred_view(c2)
    )
  )
)

// `c2` comes after `c`: its substitution is still ordered and extends `c`'s,
// and it has recorded at least what `c` had.
pub def Grows(
  c: Checker,
  c2: Checker
): Prop := And(
  CkOrdered(c2),
  And(
    SubstExt(ck_subst_of(c), ck_subst_of(c2)),
    And(OkExt(KeptOk(ck_kept_of(c)), KeptOk(ck_kept_of(c2))), CkFixed(c, c2))
  )
)

pub def TyEqAt(c: Checker, a: Ty, b: Ty): Prop := TyEq(ck_subst_of(c), KeptOk(ck_kept_of(c)), a, b)

pub def TyEqListAt(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty)
): Prop := TyEqList(ck_subst_of(c), KeptOk(ck_kept_of(c)), xs, ys)

// What a unifying step gives: from an ordered substitution, a state after it,
// and when it says true, `a` and `b` the same there.
pub def UOk(
  c: Checker,
  m: Mut1(Bool, Checker),
  a: Ty,
  b: Ty
): Prop := (
  CkOrdered(c)
) -> And(Grows(c, ck_st(m)), (ck_val(m) = true) -> TyEqAt(ck_st(m), a, b))

pub theorem fixed_refl(c: Checker): CkFixed(c, c) {
  AndIntro(
    Refl,
    AndIntro((x: TyBound, h: BoundIn(ck_bounds_of(c), x)) => h, AndIntro(Refl, Refl))
  )
}

pub theorem fixed_trans(
  c1: Checker,
  c2: Checker,
  c3: Checker,
  h1: CkFixed(c1, c2),
  h2: CkFixed(c2, c3)
): CkFixed(c1, c3) {
  AndIntro(
    Eq::trans(And::left(h1), And::left(h2)),
    AndIntro(
      (x: TyBound, h: BoundIn(ck_bounds_of(c1), x)) => And::left(
        And::right(h2)
      )(x, And::left(And::right(h1))(x, h)),
      AndIntro(
        Eq::trans(And::left(And::right(And::right(h1))), And::left(And::right(And::right(h2)))),
        Eq::trans(And::right(And::right(And::right(h1))), And::right(And::right(And::right(h2))))
      )
    )
  )
}

pub theorem grows_refl(c: Checker, o: CkOrdered(c)): Grows(c, c) {
  AndIntro(
    o,
    AndIntro(
      (
        i: Nat,
        t: Ty,
        e: Ordmap::get(ck_subst_of(c), i, Ordmap::compare_nat) = Some(t)
      ) => e,
      AndIntro(
        (
          gs: List(Pair(Text, Kind)),
          r: Ordmap(Text, Ty),
          a: Ty,
          b: Ty,
          h: KeptIn(ck_kept_of(c), gs, r, a, b)
        ) => h,
        fixed_refl(c)
      )
    )
  )
}

pub theorem grows_trans(
  c1: Checker,
  c2: Checker,
  c3: Checker,
  g1: Grows(c1, c2),
  g2: Grows(c2, c3)
): Grows(c1, c3) {
  AndIntro(
    And::left(g2),
    AndIntro(
      (
        i: Nat,
        t: Ty,
        e: Ordmap::get(ck_subst_of(c1), i, Ordmap::compare_nat) = Some(t)
      ) => And::left(And::right(g2))(i, t, And::left(And::right(g1))(i, t, e)),
      AndIntro(
        (
          gs: List(Pair(Text, Kind)),
          r: Ordmap(Text, Ty),
          a: Ty,
          b: Ty,
          h: KeptIn(ck_kept_of(c1), gs, r, a, b)
        ) => And::left(
          And::right(And::right(g2))
        )(gs, r, a, b, And::left(And::right(And::right(g1)))(gs, r, a, b, h)),
        fixed_trans(
          c1,
          c2,
          c3,
          And::right(And::right(And::right(g1))),
          And::right(And::right(And::right(g2)))
        )
      )
    )
  )
}

pub theorem tyeq_at_move(
  c: Checker,
  c2: Checker,
  g: Grows(c, c2),
  a: Ty,
  b: Ty,
  h: TyEqAt(c, a, b)
): TyEqAt(c2, a, b) {
  tyeq_move(
    ck_subst_of(c),
    KeptOk(ck_kept_of(c)),
    ck_subst_of(c2),
    KeptOk(ck_kept_of(c2)),
    And::left(And::right(g)),
    And::left(And::right(And::right(g))),
    a,
    b,
    h
  )
}

pub theorem tyeq_list_at_move(
  c: Checker,
  c2: Checker,
  g: Grows(c, c2),
  xs: List(Ty),
  ys: List(Ty),
  h: TyEqListAt(c, xs, ys)
): TyEqListAt(c2, xs, ys) {
  tyeq_list_move(
    ck_subst_of(c),
    KeptOk(ck_kept_of(c)),
    ck_subst_of(c2),
    KeptOk(ck_kept_of(c2)),
    And::left(And::right(g)),
    And::left(And::right(And::right(g))),
    xs,
    ys,
    h
  )
}

// `c2` has the substitution, the records, the data and the bounds of `c`.
pub def CkSame(
  c: Checker,
  c2: Checker
): Prop := And(
  ck_subst_of(c) = ck_subst_of(c2),
  And(
    ck_kept_of(c) = ck_kept_of(c2),
    And(
      ck_datas_of(c) = ck_datas_of(c2),
      And(
        ck_bounds_of(c) = ck_bounds_of(c2),
        And(
          ck_errors_of(c) = ck_errors_of(c2),
          ck_deferred_view(c) = ck_deferred_view(c2)
        )
      )
    )
  )
)

pub theorem ck_same_refl(c: Checker): CkSame(c, c) {
  AndIntro(
    Refl,
    AndIntro(Refl, AndIntro(Refl, AndIntro(Refl, AndIntro(Refl, Refl))))
  )
}

pub theorem ck_same_trans(
  c1: Checker,
  c2: Checker,
  c3: Checker,
  h1: CkSame(c1, c2),
  h2: CkSame(c2, c3)
): CkSame(c1, c3) {
  AndIntro(
    Eq::trans(And::left(h1), And::left(h2)),
    AndIntro(
      Eq::trans(And::left(And::right(h1)), And::left(And::right(h2))),
      AndIntro(
        Eq::trans(And::left(And::right(And::right(h1))), And::left(And::right(And::right(h2)))),
        AndIntro(
          Eq::trans(
            And::left(And::right(And::right(And::right(h1)))),
            And::left(And::right(And::right(And::right(h2))))
          ),
          AndIntro(
            Eq::trans(
              And::left(And::right(And::right(And::right(And::right(h1))))),
              And::left(And::right(And::right(And::right(And::right(h2)))))
            ),
            Eq::trans(
              And::right(And::right(And::right(And::right(And::right(h1))))),
              And::right(And::right(And::right(And::right(And::right(h2)))))
            )
          )
        )
      )
    )
  )
}

// A step that leaves the substitution and the records as they were.
pub theorem grows_same(c: Checker, c2: Checker, o: CkOrdered(c), hs: CkSame(c, c2)): Grows(c, c2) {
  AndIntro(
    Eq::subst((z: Ordmap(Nat, Ty)) => Ordmap::ordered(z, Ordmap::compare_nat), And::left(hs), o),
    AndIntro(
      (
        i: Nat,
        t: Ty,
        e: Ordmap::get(ck_subst_of(c), i, Ordmap::compare_nat) = Some(t)
      ) => Eq::subst(
        (z: Ordmap(Nat, Ty)) => Ordmap::get(z, i, Ordmap::compare_nat) = Some(t),
        And::left(hs),
        e
      ),
      AndIntro(
        (
          gs: List(Pair(Text, Kind)),
          r: Ordmap(Text, Ty),
          a: Ty,
          b: Ty,
          h: KeptIn(ck_kept_of(c), gs, r, a, b)
        ) => Eq::subst((z: List(TyKept)) => KeptIn(z, gs, r, a, b), And::left(And::right(hs)), h),
        AndIntro(
          And::left(And::right(And::right(hs))),
          AndIntro(
            (x: TyBound, h: BoundIn(ck_bounds_of(c), x)) => Eq::subst(
              (z: List(TyBound)) => BoundIn(z, x),
              And::left(And::right(And::right(And::right(hs)))),
              h
            ),
            And::right(And::right(And::right(And::right(hs))))
          )
        )
      )
    )
  )
}

pub theorem grows_of_same(
  c: Checker,
  c2: Checker,
  o: CkOrdered(c),
  h: CkSame(c, c2)
): Grows(c, c2) {
  grows_same(c, c2, o, h)
}

// ----- binding -----

pub theorem subst_ext_insert(
  s: Ordmap(Nat, Ty),
  v: Nat,
  t: Ty,
  o: Ordmap::ordered(s, Ordmap::compare_nat),
  hn: Ordmap::get(s, v, Ordmap::compare_nat) = None
): SubstExt(s, Ordmap::insert(s, v, t, Ordmap::compare_nat)) {
  (
    i: Nat,
    t2: Ty,
    e: Ordmap::get(s, i, Ordmap::compare_nat) = Some(t2)
  ) => Ordering::cases(
    (x: Ordering) => Ordmap::get(Ordmap::insert(s, v, t, Ordmap::compare_nat), i, Ordmap::compare_nat) = Some(t2),
    Ordmap::compare_nat(i, v),
    (ej: Ordmap::compare_nat(i, v) = Less) => Eq::trans(
      Ordmap::get_insert_other(
        Ordmap::compare_nat,
        Ordmap::compare_nat_law(),
        s,
        v,
        t,
        i,
        Less,
        less_ne_equal,
        ej,
        o
      ),
      e
    ),
    (ej: Ordmap::compare_nat(i, v) = Equal) => False::elim(
      ck_none_ne_some(
        t2,
        Eq::trans(
          Eq::sym(hn),
          Eq::subst(
            (z: Nat) => Ordmap::get(s, z, Ordmap::compare_nat) = Some(t2),
            Ordmap::compare_nat_eq(i, v, ej),
            e
          )
        )
      )
    ),
    (ej: Ordmap::compare_nat(i, v) = Greater) => Eq::trans(
      Ordmap::get_insert_other(
        Ordmap::compare_nat,
        Ordmap::compare_nat_law(),
        s,
        v,
        t,
        i,
        Greater,
        greater_ne_equal,
        ej,
        o
      ),
      e
    )
  )
}

pub theorem grows_set(
  c: Checker,
  v: Nat,
  t: Ty,
  o: CkOrdered(c),
  hn: Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat) = None
): Grows(c, ck_st(ck_set_subst(c, v, t))) {
  AndIntro(
    Ordmap::insert_ordered(Ordmap::compare_nat, Ordmap::compare_nat_law(), ck_subst_of(c), v, t, o),
    AndIntro(
      subst_ext_insert(ck_subst_of(c), v, t, o, hn),
      AndIntro(
        (
          gs: List(Pair(Text, Kind)),
          r: Ordmap(Text, Ty),
          a: Ty,
          b: Ty,
          h: KeptIn(ck_kept_of(c), gs, r, a, b)
        ) => h,
        fixed_refl(c)
      )
    )
  )
}

pub theorem set_binds(
  c: Checker,
  v: Nat,
  t: Ty,
  o: CkOrdered(c)
): TyEqAt(ck_st(ck_set_subst(c, v, t)), TyVar(v), t) {
  TyeqVar(v, Ordmap::nat_get_insert_same(ck_subst_of(c), v, t, o))
}

pub theorem uok_rewrap(
  c: Checker,
  m: Mut1(Bool, Checker),
  a: Ty,
  b: Ty,
  h: UOk(c, m, a, b)
): UOk(c, ck_rewrap1(m), a, b) {
  Eq::subst((z: Mut1(Bool, Checker)) => UOk(c, z, a, b), Eq::sym(ck_rewrap1_id(m)), h)
}

pub theorem uok_no(c: Checker, a: Ty, b: Ty): UOk(c, mut1(false, c), a, b) {
  (o: CkOrdered(c)) => AndIntro(
    grows_refl(c, o),
    (y: false = true) => False::elim(true_ne_false(Eq::sym(y)))
  )
}

pub fn ck_k_true(m: Mut1(Unit, Checker)): Mut1(Bool, Checker) {
  match m: Mut1(Bool, Checker) {
    mut1(x, c2) => mut1(true, c2)
  }
}

pub fn ck_bind_value_k(c: Checker, v: Nat, t: Ty, x: Bool): Mut1(Bool, Checker) {
  match x: Mut1(Bool, Checker) {
    true => mut1(false, c)
    false => ck_k_true(ck_set_subst(c, v, t))
  }
}

pub theorem ck_bind_value_ok(
  c: Checker,
  v: Nat,
  t: Ty,
  hn: Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat) = None
): UOk(c, ck_bind_value(c, v, t), TyVar(v), t) {
  Bool::cases(
    (x: Bool) => UOk(c, ck_bind_value_k(c, v, t, x), TyVar(v), t),
    ck_occurs(c, v, t),
    (e: ck_occurs(c, v, t) = false) => (o: CkOrdered(c)) => AndIntro(
      grows_set(c, v, t, o, hn),
      (y: true = true) => set_binds(c, v, t, o)
    ),
    (e: ck_occurs(c, v, t) = true) => uok_no(c, TyVar(v), t)
  )
}

pub fn ck_bind_other_k(c: Checker, v: Nat, t: Ty, x: Bool): Mut1(Bool, Checker) {
  match x: Mut1(Bool, Checker) {
    true => mut1(false, c)
    false => ck_rewrap1(ck_bind_value(c, v, t))
  }
}

pub theorem ck_bind_other_ok(
  c: Checker,
  v: Nat,
  t: Ty,
  hn: Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat) = None
): UOk(c, ck_bind_other(c, v, t), TyVar(v), t) {
  Bool::cases(
    (x: Bool) => UOk(c, ck_bind_other_k(c, v, t, x), TyVar(v), t),
    ck_is_int(c, v),
    (e: ck_is_int(c, v) = false) => uok_rewrap(
      c,
      ck_bind_value(c, v, t),
      TyVar(v),
      t,
      ck_bind_value_ok(c, v, t, hn)
    ),
    (e: ck_is_int(c, v) = true) => uok_no(c, TyVar(v), t)
  )
}

pub fn ck_int_k(c: Checker, w: Nat, x: Bool): Mut1(Unit, Checker) {
  match x: Mut1(Unit, Checker) {
    true => ck_rewrap1(ck_add_int(c, w))
    false => mut1(Star, c)
  }
}

pub fn ck_var_set(v: Nat, w: Nat, m: Mut1(Unit, Checker)): Mut1(Bool, Checker) {
  match m: Mut1(Bool, Checker) {
    mut1(x, c2) => ck_k_true(ck_set_subst(c2, v, TyVar(w)))
  }
}

pub fn ck_bind_var_k(c: Checker, v: Nat, w: Nat, x: Bool): Mut1(Bool, Checker) {
  match x: Mut1(Bool, Checker) {
    true => mut1(true, c)
    false => ck_var_set(v, w, ck_int_k(c, w, ck_is_int(c, v)))
  }
}

// Marking a variable an integer leaves the substitution and the records.
pub theorem ck_int_k_same(c: Checker, w: Nat, x: Bool): CkSame(c, ck_st(ck_int_k(c, w, x))) {
  match x: CkSame(c, ck_st(ck_int_k(c, w, x))) {
    true => ck_same_refl(c)
    false => ck_same_refl(c)
  }
}

pub theorem ck_var_set_ok(
  c: Checker,
  v: Nat,
  w: Nat,
  m: Mut1(Unit, Checker),
  hs: CkSame(c, ck_st(m)),
  hn: Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat) = None
): UOk(c, ck_var_set(v, w, m), TyVar(v), TyVar(w)) {
  match m: UOk(c, ck_var_set(v, w, m), TyVar(v), TyVar(w)) {
    mut1(x, c2) => (o: CkOrdered(c)) => AndIntro(
      grows_trans(
        c,
        c2,
        ck_st(ck_set_subst(c2, v, TyVar(w))),
        grows_same(c, c2, o, hs),
        grows_set(
          c2,
          v,
          TyVar(w),
          And::left(grows_same(c, c2, o, hs)),
          Eq::subst(
            (z: Ordmap(Nat, Ty)) => Ordmap::get(z, v, Ordmap::compare_nat) = None,
            And::left(hs),
            hn
          )
        )
      ),
      (y: true = true) => set_binds(c2, v, TyVar(w), And::left(grows_same(c, c2, o, hs)))
    )
  }
}

pub theorem ck_bind_var_ok(
  c: Checker,
  v: Nat,
  w: Nat,
  hn: Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat) = None
): UOk(c, ck_bind_var(c, v, w), TyVar(v), TyVar(w)) {
  Bool::cases(
    (x: Bool) => UOk(c, ck_bind_var_k(c, v, w, x), TyVar(v), TyVar(w)),
    Nat::eq(w, v),
    (e: Nat::eq(w, v) = false) => ck_var_set_ok(
      c,
      v,
      w,
      ck_int_k(c, w, ck_is_int(c, v)),
      ck_int_k_same(c, w, ck_is_int(c, v)),
      hn
    ),
    (e: Nat::eq(w, v) = true) => (o: CkOrdered(c)) => AndIntro(
      grows_refl(c, o),
      (y: true = true) => Eq::subst(
        (z: Nat) => TyEqAt(c, TyVar(v), TyVar(z)),
        Eq::sym(Nat::eq_sound(w, v, e)),
        TyeqRefl(TyVar(v))
      )
    )
  )
}

pub theorem ck_bind_unbound_ok(
  c: Checker,
  v: Nat,
  t: Ty,
  hn: Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat) = None
): UOk(c, ck_bind_unbound(c, v, t), TyVar(v), t) {
  match t: UOk(c, ck_bind_unbound(c, v, t), TyVar(v), t) {
    TyVar(i) => uok_rewrap(c, ck_bind_var(c, v, i), TyVar(v), TyVar(i), ck_bind_var_ok(c, v, i, hn))
    TyFn(ps, r, fk) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyFn(ps, r, fk)),
      TyVar(v),
      TyFn(ps, r, fk),
      ck_bind_other_ok(c, v, TyFn(ps, r, fk), hn)
    )
    TyUnion(ts) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyUnion(ts)),
      TyVar(v),
      TyUnion(ts),
      ck_bind_other_ok(c, v, TyUnion(ts), hn)
    )
    TyProduct(ts) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyProduct(ts)),
      TyVar(v),
      TyProduct(ts),
      ck_bind_other_ok(c, v, TyProduct(ts), hn)
    )
    TyTagged(tags, x) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyTagged(tags, x)),
      TyVar(v),
      TyTagged(tags, x),
      ck_bind_other_ok(c, v, TyTagged(tags, x), hn)
    )
    TyNamed(n, args) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyNamed(n, args)),
      TyVar(v),
      TyNamed(n, args),
      ck_bind_other_ok(c, v, TyNamed(n, args), hn)
    )
    TyInfo(x) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyInfo(x)),
      TyVar(v),
      TyInfo(x),
      ck_bind_other_ok(c, v, TyInfo(x), hn)
    )
    TyBorrow(x, m) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyBorrow(x, m)),
      TyVar(v),
      TyBorrow(x, m),
      ck_bind_other_ok(c, v, TyBorrow(x, m), hn)
    )
    TyInt(w) => uok_rewrap(
      c,
      ck_bind_value(c, v, TyInt(w)),
      TyVar(v),
      TyInt(w),
      ck_bind_value_ok(c, v, TyInt(w), hn)
    )
    TyBool => uok_rewrap(
      c,
      ck_bind_other(c, v, TyBool),
      TyVar(v),
      TyBool,
      ck_bind_other_ok(c, v, TyBool, hn)
    )
    TyText => uok_rewrap(
      c,
      ck_bind_other(c, v, TyText),
      TyVar(v),
      TyText,
      ck_bind_other_ok(c, v, TyText, hn)
    )
    TyUnit => uok_rewrap(
      c,
      ck_bind_other(c, v, TyUnit),
      TyVar(v),
      TyUnit,
      ck_bind_other_ok(c, v, TyUnit, hn)
    )
    TyNever => uok_rewrap(
      c,
      ck_bind_other(c, v, TyNever),
      TyVar(v),
      TyNever,
      ck_bind_other_ok(c, v, TyNever, hn)
    )
    TyDecimal => uok_rewrap(
      c,
      ck_bind_other(c, v, TyDecimal),
      TyVar(v),
      TyDecimal,
      ck_bind_other_ok(c, v, TyDecimal, hn)
    )
    TyFloat => uok_rewrap(
      c,
      ck_bind_other(c, v, TyFloat),
      TyVar(v),
      TyFloat,
      ck_bind_other_ok(c, v, TyFloat, hn)
    )
    TyParam(n, pk) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyParam(n, pk)),
      TyVar(v),
      TyParam(n, pk),
      ck_bind_other_ok(c, v, TyParam(n, pk), hn)
    )
    TyPoly(gs, x) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyPoly(gs, x)),
      TyVar(v),
      TyPoly(gs, x),
      ck_bind_other_ok(c, v, TyPoly(gs, x), hn)
    )
    TyApp(h, x) => uok_rewrap(
      c,
      ck_bind_other(c, v, TyApp(h, x)),
      TyVar(v),
      TyApp(h, x),
      ck_bind_other_ok(c, v, TyApp(h, x), hn)
    )
  }
}

pub fn ck_bind_k(c: Checker, v: Nat, t: Ty, x: Bool): Mut1(Bool, Checker) {
  match x: Mut1(Bool, Checker) {
    true => mut1(false, c)
    false => ck_rewrap1(ck_bind_unbound(c, v, t))
  }
}

pub fn ck_bound_bool(o: Option(Ty)): Bool {
  match o: Bool {
    None => false
    Some(x) => true
  }
}

pub theorem ck_option_cases<A: Type>(
  P: (Option(A)) -> Prop,
  o: Option(A),
  a: (o = None) -> P(None),
  b: ∀ x: A. (o = Some(x)) -> P(Some(x))
): P(o) {
  match o: P(o) {
    None => a(Refl)
    Some(x) => b(x, Refl)
  }
}

// Binding `v` to `t`: `v` is `t` after it.
pub theorem ck_bind_ok(c: Checker, v: Nat, t: Ty): UOk(c, ck_bind(c, v, t), TyVar(v), t) {
  ck_option_cases(
    (o: Option(Ty)) => UOk(c, ck_bind_k(c, v, t, ck_bound_bool(o)), TyVar(v), t),
    Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat),
    (hn: Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat) = None) => uok_rewrap(
      c,
      ck_bind_unbound(c, v, t),
      TyVar(v),
      t,
      ck_bind_unbound_ok(c, v, t, hn)
    ),
    (
      x: Ty,
      hs: Ordmap::get(ck_subst_of(c), v, Ordmap::compare_nat) = Some(x)
    ) => uok_no(c, TyVar(v), t)
  )
}

// ----- rigid types -----

pub fn tk_first(g: Pair(Text, Kind)): Text {
  match g: Text {
    Pair { fst: a, snd: b } => a
  }
}

pub fn tk_second(g: Pair(Text, Kind)): Kind {
  match g: Kind {
    Pair { fst: a, snd: b } => b
  }
}

pub fn ck_rigids_of(c: Checker): Nat {
  c.rigids
}

pub fn ck_bump_rigids(&mut c: Checker): Unit {
  bump(&mut c.rigids)
}

pub fn ck_rigid_k(
  g: Pair(Text, Kind),
  t: Ty,
  m: Mut1(Ordmap(Text, Ty), Checker)
): Mut1(Ordmap(Text, Ty), Checker) {
  match m: Mut1(Ordmap(Text, Ty), Checker) {
    mut1(x, c2) => mut1(Ordmap::insert(x, tk_first(g), t, Ordmap::compare_text), c2)
  }
}

pub theorem ck_rigid_k_same(
  c: Checker,
  g: Pair(Text, Kind),
  t: Ty,
  m: Mut1(Ordmap(Text, Ty), Checker),
  h: CkSame(c, ck_st(m))
): CkSame(c, ck_st(ck_rigid_k(g, t, m))) {
  match m: CkSame(c, ck_st(ck_rigid_k(g, t, m))) {
    mut1(x, c2) => h
  }
}

// Making rigid types only counts them.
pub theorem ck_rigid_same(
  gs: List(Pair(Text, Kind)),
  c: Checker
): CkSame(c, ck_st(ck_rigid(gs, c))) {
  match gs: CkSame(c, ck_st(ck_rigid(gs, c))) {
    Nil => ck_same_refl(c)
    Cons(g, rest) => ck_rigid_k_same(
      c,
      g,
      TyParam(cat3(tk_first(g), "#", Text::of_nat(Nat::add(ck_rigids_of(c), 1))), tk_second(g)),
      ck_rigid(rest, ck_st(ck_bump_rigids(c))),
      ck_rigid_same(rest, ck_st(ck_bump_rigids(c)))
    )
  }
}

pub fn ck_set_kept(&mut c: Checker, ks: List(TyKept)): Unit {
  set_to(&mut c.kept, ks)
}

pub fn ck_keep_k(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  rigid: Ordmap(Text, Ty),
  a: Ty,
  b: Ty,
  x: Bool
): Mut1(Bool, Checker) {
  match x: Mut1(Bool, Checker) {
    true => ck_k_true(ck_set_kept(c, Cons(TyKeptMk(gs, rigid, a, b), ck_kept_of(c))))
    false => mut1(false, c)
  }
}

pub def KeepOk(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  rigid: Ordmap(Text, Ty),
  a: Ty,
  b: Ty,
  m: Mut1(Bool, Checker)
): Prop := And(
  Grows(c, ck_st(m)),
  (ck_val(m) = true) -> KeptIn(ck_kept_of(ck_st(m)), gs, rigid, a, b)
)

// Recording a use of rigid types.
pub theorem ck_keep_ok(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  rigid: Ordmap(Text, Ty),
  a: Ty,
  b: Ty,
  o: CkOrdered(c)
): KeepOk(c, gs, rigid, a, b, ck_keep(c, gs, rigid, a, b)) {
  Bool::cases(
    (x: Bool) => KeepOk(c, gs, rigid, a, b, ck_keep_k(c, gs, rigid, a, b, x)),
    ck_rigid_kept(c, gs, rigid, a, b),
    (e: ck_rigid_kept(c, gs, rigid, a, b) = false) => AndIntro(
      grows_refl(c, o),
      (y: false = true) => False::elim(true_ne_false(Eq::sym(y)))
    ),
    (e: ck_rigid_kept(c, gs, rigid, a, b) = true) => AndIntro(
      AndIntro(
        o,
        AndIntro(
          (
            i: Nat,
            t: Ty,
            e2: Ordmap::get(ck_subst_of(c), i, Ordmap::compare_nat) = Some(t)
          ) => e2,
          AndIntro(
            (
              gs2: List(Pair(Text, Kind)),
              r: Ordmap(Text, Ty),
              a2: Ty,
              b2: Ty,
              h: KeptIn(ck_kept_of(c), gs2, r, a2, b2)
            ) => KeptThere(TyKeptMk(gs, rigid, a, b), h),
            fixed_refl(c)
          )
        )
      ),
      (y: true = true) => KeptHere(gs, rigid, a, b, ck_kept_of(c))
    )
  )
}

// ----- steps in sequence -----

// What a step gives, for a property `q` of the state it leaves when it says
// true.
pub def Post(
  c: Checker,
  m: Mut1(Bool, Checker),
  q: (Checker) -> Prop
): Prop := (CkOrdered(c)) -> And(Grows(c, ck_st(m)), (ck_val(m) = true) -> q(ck_st(m)))

// `q` still holds of a state that comes after.
pub def Mono(
  q: (Checker) -> Prop
): Prop := ∀ c1: Checker. ∀ c2: Checker. (Grows(c1, c2)) -> (q(c1)) -> q(c2)

pub fn ck_and_k(k: (Checker) -> Mut1(Bool, Checker), c2: Checker, v: Bool): Mut1(Bool, Checker) {
  match v: Mut1(Bool, Checker) {
    true => ck_rewrap1(k(c2))
    false => mut1(false, c2)
  }
}

// `if m { k } else { false }`, `m` a step that changes the state.
pub fn ck_and(k: (Checker) -> Mut1(Bool, Checker), m: Mut1(Bool, Checker)): Mut1(Bool, Checker) {
  match m: Mut1(Bool, Checker) {
    mut1(v, c2) => ck_and_k(k, c2, v)
  }
}

pub def PostAnd(
  c: Checker,
  m: Mut1(Bool, Checker),
  q1: (Checker) -> Prop,
  q2: (Checker) -> Prop
): Prop := And(Grows(c, ck_st(m)), (ck_val(m) = true) -> And(q1(ck_st(m)), q2(ck_st(m))))

pub theorem post_and_k(
  c: Checker,
  c2: Checker,
  v: Bool,
  q1: (Checker) -> Prop,
  k: (Checker) -> Mut1(Bool, Checker),
  q2: (Checker) -> Prop,
  mono1: Mono(q1),
  g: Grows(c, c2),
  h1: (v = true) -> q1(c2),
  h2: Post(c2, k(c2), q2)
): PostAnd(c, ck_and_k(k, c2, v), q1, q2) {
  match v: PostAnd(c, ck_and_k(k, c2, v), q1, q2) {
    false => AndIntro(g, (y: false = true) => False::elim(true_ne_false(Eq::sym(y))))
    true => Eq::subst(
      (z: Mut1(Bool, Checker)) => PostAnd(c, z, q1, q2),
      Eq::sym(ck_rewrap1_id(k(c2))),
      AndIntro(
        grows_trans(c, c2, ck_st(k(c2)), g, And::left(h2(And::left(g)))),
        (y: ck_val(k(c2)) = true) => AndIntro(
          mono1(c2, ck_st(k(c2)), And::left(h2(And::left(g))), h1(Refl)),
          And::right(h2(And::left(g)))(y)
        )
      )
    )
  }
}

// One step and, when it says true, another.
pub theorem post_and(
  c: Checker,
  m: Mut1(Bool, Checker),
  q1: (Checker) -> Prop,
  k: (Checker) -> Mut1(Bool, Checker),
  q2: (Checker) -> Prop,
  mono1: Mono(q1),
  h1: Post(c, m, q1),
  h2: ∀ c2: Checker. Post(c2, k(c2), q2),
  o: CkOrdered(c)
): PostAnd(c, ck_and(k, m), q1, q2) {
  match m: PostAnd(c, ck_and(k, m), q1, q2) {
    mut1(v, c2) => post_and_k(c, c2, v, q1, k, q2, mono1, And::left(h1(o)), And::right(h1(o)), h2(c2))
  }
}

// ----- unifying -----

pub theorem uok_tyeq(c: Checker, a: Ty, b: Ty): UOk(c, mut1(ty_eq(a, b), c), a, b) {
  (o: CkOrdered(c)) => AndIntro(
    grows_refl(c, o),
    (y: ty_eq(a, b) = true) => Eq::subst(
      (z: Ty) => TyEqAt(c, a, z),
      ty_eq_sound(a, b, y),
      TyeqRefl(a)
    )
  )
}

pub theorem uok_sym(
  c: Checker,
  m: Mut1(Bool, Checker),
  a: Ty,
  b: Ty,
  h: UOk(c, m, a, b)
): UOk(c, m, b, a) {
  (o: CkOrdered(c)) => AndIntro(
    And::left(h(o)),
    (y: ck_val(m) = true) => TyeqSym(And::right(h(o))(y))
  )
}

// From `a0 ~ a` and `b0 ~ b` before a step that makes `a` and `b` the same.
pub theorem uok_resolve(
  c: Checker,
  m: Mut1(Bool, Checker),
  a0: Ty,
  b0: Ty,
  a: Ty,
  b: Ty,
  ha: TyEqAt(c, a0, a),
  hb: TyEqAt(c, b0, b),
  h: UOk(c, m, a, b)
): UOk(c, m, a0, b0) {
  (o: CkOrdered(c)) => AndIntro(
    And::left(h(o)),
    (y: ck_val(m) = true) => TyeqTrans(
      tyeq_at_move(c, ck_st(m), And::left(h(o)), a0, a, ha),
      TyeqTrans(And::right(h(o))(y), TyeqSym(tyeq_at_move(c, ck_st(m), And::left(h(o)), b0, b, hb)))
    )
  )
}

pub theorem mono_eq(a: Ty, b: Ty): Mono((c: Checker) => TyEqAt(c, a, b)) {
  (c1: Checker, c2: Checker, g: Grows(c1, c2), h: TyEqAt(c1, a, b)) => tyeq_at_move(
    c1,
    c2,
    g,
    a,
    b,
    h
  )
}

pub def TyEqLenAt(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty)
): Prop := (Nat::eq(list_len(xs), list_len(ys)) = true) -> TyEqListAt(c, xs, ys)

pub theorem mono_len(xs: List(Ty), ys: List(Ty)): Mono((c: Checker) => TyEqLenAt(c, xs, ys)) {
  (c1: Checker, c2: Checker, g: Grows(c1, c2), h: TyEqLenAt(c1, xs, ys)) => (
    e: Nat::eq(list_len(xs), list_len(ys)) = true
  ) => tyeq_list_at_move(c1, c2, g, xs, ys, h(e))
}

// Both steps said true: what they give, together.
pub theorem post_of_and(
  c: Checker,
  m: Mut1(Bool, Checker),
  q1: (Checker) -> Prop,
  q2: (Checker) -> Prop,
  q: (Checker) -> Prop,
  f: ∀ c2: Checker. (q1(c2)) -> (q2(c2)) -> q(c2),
  h: (CkOrdered(c)) -> PostAnd(c, m, q1, q2)
): Post(c, m, q) {
  (o: CkOrdered(c)) => AndIntro(
    And::left(h(o)),
    (y: ck_val(m) = true) => f(
      ck_st(m),
      And::left(And::right(h(o))(y)),
      And::right(And::right(h(o))(y))
    )
  )
}

// The first of two unifying steps and, when it says true, the second.
pub theorem uok_and(
  c: Checker,
  m: Mut1(Bool, Checker),
  a1: Ty,
  b1: Ty,
  k: (Checker) -> Mut1(Bool, Checker),
  q2: (Checker) -> Prop,
  q: (Checker) -> Prop,
  h1: UOk(c, m, a1, b1),
  h2: ∀ c2: Checker. Post(c2, k(c2), q2),
  f: ∀ c2: Checker. (TyEqAt(c2, a1, b1)) -> (q2(c2)) -> q(c2)
): Post(c, ck_and(k, m), q) {
  post_of_and(
    c,
    ck_and(k, m),
    (c2: Checker) => TyEqAt(c2, a1, b1),
    q2,
    q,
    f,
    (o: CkOrdered(c)) => post_and(
      c,
      m,
      (c2: Checker) => TyEqAt(c2, a1, b1),
      k,
      q2,
      mono_eq(a1, b1),
      h1,
      h2,
      o
    )
  )
}

pub def UnifyU(
  k: Nat
): Prop := ∀ c: Checker. ∀ a: Ty. ∀ b: Ty. UOk(c, ck_unify_in(k, c, a, b), a, b)

pub def UnifyR(
  k: Nat
): Prop := ∀ c: Checker. ∀ a: Ty. ∀ b: Ty. UOk(c, ck_unify_rest_in(k, c, a, b), a, b)

pub def UnifyP(
  k: Nat
): Prop := ∀ c: Checker. ∀ xs: List(
  Ty
). ∀ ys: List(Ty). Post(c, ck_unify_pairs_in(k, c, xs, ys), (c2: Checker) => TyEqLenAt(c2, xs, ys))

pub def UnifyA(
  k: Nat
): Prop := ∀ c: Checker. ∀ h: Ty. ∀ x: Ty. ∀ n: Text. ∀ args: List(
  Ty
). UOk(c, ck_unify_app_in(k, c, h, x, n, args), TyApp(h, x), TyNamed(n, args))

// ----- pairs -----

pub theorem post_true_len(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty),
  e: Nat::eq(list_len(xs), list_len(ys)) = false
): Post(c, mut1(true, c), (c2: Checker) => TyEqLenAt(c2, xs, ys)) {
  (o: CkOrdered(c)) => AndIntro(
    grows_refl(c, o),
    (y: true = true) => (e2: Nat::eq(list_len(xs), list_len(ys)) = true) => False::elim(
      true_ne_false(Eq::trans(Eq::sym(e2), e))
    )
  )
}

pub theorem pairs_step(
  j: Nat,
  hu: UnifyU(j),
  hp: UnifyP(j),
  c: Checker,
  xs: List(Ty),
  ys: List(Ty)
): Post(c, ck_unify_pairs_in(Succ(j), c, xs, ys), (c2: Checker) => TyEqLenAt(c2, xs, ys)) {
  match xs: Post(
    c,
    ck_unify_pairs_in(Succ(j), c, xs, ys),
    (c2: Checker) => TyEqLenAt(c2, xs, ys)
  ) {
    Nil => match ys: Post(
      c,
      ck_unify_pairs_in(Succ(j), c, Nil, ys),
      (c2: Checker) => TyEqLenAt(c2, Nil, ys)
    ) {
      Nil => (o: CkOrdered(c)) => AndIntro(
        grows_refl(c, o),
        (y: true = true) => (e: true = true) => TyeqNil
      )
      Cons(y, yr) => post_true_len(c, Nil, Cons(y, yr), Refl)
    }
    Cons(x, xr) => match ys: Post(
      c,
      ck_unify_pairs_in(Succ(j), c, Cons(x, xr), ys),
      (c2: Checker) => TyEqLenAt(c2, Cons(x, xr), ys)
    ) {
      Nil => post_true_len(c, Cons(x, xr), Nil, Refl)
      Cons(y, yr) => uok_and(
        c,
        ck_unify_in(j, c, x, y),
        x,
        y,
        (c2: Checker) => ck_unify_pairs_in(j, c2, xr, yr),
        (c2: Checker) => TyEqLenAt(c2, xr, yr),
        (c2: Checker) => TyEqLenAt(c2, Cons(x, xr), Cons(y, yr)),
        hu(c, x, y),
        (c2: Checker) => hp(c2, xr, yr),
        (c2: Checker, h1: TyEqAt(c2, x, y), h2: TyEqLenAt(c2, xr, yr)) => (
          e: Nat::eq(list_len(xr), list_len(yr)) = true
        ) => TyeqCons(h1, h2(e))
      )
    }
  }
}

// ----- `h(x) ~ n(args)` -----

pub fn ck_opt_or<A>(d: A, o: Option(A)): A {
  match o: A {
    None => d
    Some(x) => x
  }
}

pub theorem ck_some_inj<A: Type>(x: A, y: A, e: Some(x) = Some(y)): (x = y) {
  Eq::subst((z: Option(A)) => x = ck_opt_or(x, z), e, Refl)
}

pub fn pair_fst_lt(p: Pair(List(Ty), Ty)): List(Ty) {
  match p: List(Ty) {
    Pair { fst: a, snd: b } => a
  }
}

pub fn pair_snd_lt(p: Pair(List(Ty), Ty)): Ty {
  match p: Ty {
    Pair { fst: a, snd: b } => b
  }
}

pub fn ck_split_k(a: Ty, o: Option(Pair(List(Ty), Ty))): Option(Pair(List(Ty), Ty)) {
  match o: Option(Pair(List(Ty), Ty)) {
    None => Some(Pair { fst: Nil, snd: a })
    Some(q) => Some(Pair { fst: Cons(a, pair_fst_lt(q)), snd: pair_snd_lt(q) })
  }
}

pub theorem ck_split_k_some(
  a: Ty,
  o: Option(Pair(List(Ty), Ty)),
  e: ck_split_k(a, o) = None
): False {
  match o: (ck_split_k(a, o) = None) -> False {
    None => (
      e2: Some(Pair { fst: Nil, snd: a }) = None
    ) => ck_none_ne_some(Pair { fst: Nil, snd: a }, Eq::sym(e2))
    Some(q) => (
      e2: Some(Pair { fst: Cons(a, pair_fst_lt(q)), snd: pair_snd_lt(q) }) = None
    ) => ck_none_ne_some(Pair { fst: Cons(a, pair_fst_lt(q)), snd: pair_snd_lt(q) }, Eq::sym(e2))
  }(e)
}

pub theorem ck_split_none(
  args: List(Ty),
  e: ty_split_last(args) = None
): (args = Nil) {
  match args: (
    ty_split_last(args) = None
  ) -> (args = Nil) {
    Nil => (e2: Eq(Option(Pair(List(Ty), Ty)), None, None)) => Refl
    Cons(a, rest) => (
      e2: ck_split_k(a, ty_split_last(rest)) = None
    ) => False::elim(ck_split_k_some(a, ty_split_last(rest), e2))
  }(e)
}

pub def SplitOk(
  args: List(Ty)
): Prop := ∀ p: Pair(
  List(Ty),
  Ty
). (
  ty_split_last(args) = Some(p)
) -> (List::append(pair_fst_lt(p), Cons(pair_snd_lt(p), Nil)) = args)

pub def SplitKOk(
  a: Ty,
  rest: List(Ty),
  o: Option(Pair(List(Ty), Ty))
): Prop := (ty_split_last(rest) = o) -> SplitOk(Cons(a, rest))

pub theorem ck_split_cons(
  a: Ty,
  rest: List(Ty),
  ih: SplitOk(rest),
  o: Option(Pair(List(Ty), Ty))
): SplitKOk(a, rest, o) {
  match o: SplitKOk(a, rest, o) {
    None => (eo: ty_split_last(rest) = None) => (
      p: Pair(List(Ty), Ty),
      e: ck_split_k(a, ty_split_last(rest)) = Some(p)
    ) => Eq::subst(
      (z: Pair(List(Ty), Ty)) => List::append(pair_fst_lt(z), Cons(pair_snd_lt(z), Nil)) = Cons(a, rest),
      ck_some_inj(
        Pair { fst: Nil, snd: a },
        p,
        Eq::subst(
          (w: Option(Pair(List(Ty), Ty))) => ck_split_k(a, w) = Some(p),
          eo,
          e
        )
      ),
      Eq::subst(
        (r: List(Ty)) => Cons(Ty, a, Nil(Ty)) = Cons(Ty, a, r),
        Eq::sym(ck_split_none(rest, eo)),
        Refl
      )
    )
    Some(q) => (eo: ty_split_last(rest) = Some(q)) => (
      p: Pair(List(Ty), Ty),
      e: ck_split_k(a, ty_split_last(rest)) = Some(p)
    ) => Eq::subst(
      (z: Pair(List(Ty), Ty)) => List::append(pair_fst_lt(z), Cons(pair_snd_lt(z), Nil)) = Cons(a, rest),
      ck_some_inj(
        Pair { fst: Cons(a, pair_fst_lt(q)), snd: pair_snd_lt(q) },
        p,
        Eq::subst(
          (w: Option(Pair(List(Ty), Ty))) => ck_split_k(a, w) = Some(p),
          eo,
          e
        )
      ),
      Eq::subst(
        (r: List(Ty)) => Cons(Ty, a, List::append(Ty, pair_fst_lt(q), Cons(Ty, pair_snd_lt(q), Nil(Ty)))) = Cons(Ty, a, r),
        ih(q, eo),
        Refl
      )
    )
  }
}

pub theorem ck_split_last_ok(args: List(Ty)): SplitOk(args) {
  match args: SplitOk(args) {
    Nil => (p: Pair(List(Ty), Ty), e: None = Some(p)) => False::elim(
      ck_none_ne_some(p, e)
    )
    Cons(a, rest) => ck_split_cons(a, rest, ck_split_last_ok(rest), ty_split_last(rest))(Refl)
  }
}

pub fn ck_app_k(
  j: Nat,
  c: Checker,
  h: Ty,
  x: Ty,
  n: Text,
  o: Option(Pair(List(Ty), Ty))
): Mut1(Bool, Checker) {
  match o: Mut1(Bool, Checker) {
    None => mut1(false, c)
    Some(p) => ck_and(
      (c2: Checker) => ck_unify_in(j, c2, x, pair_snd_lt(p)),
      ck_unify_in(j, c, h, TyNamed(n, pair_fst_lt(p)))
    )
  }
}

pub def AppKOk(
  j: Nat,
  c: Checker,
  h: Ty,
  x: Ty,
  n: Text,
  args: List(Ty),
  o: Option(Pair(List(Ty), Ty))
): Prop := (
  ty_split_last(args) = o
) -> UOk(c, ck_app_k(j, c, h, x, n, o), TyApp(h, x), TyNamed(n, args))

pub theorem ck_app_k_ok(
  j: Nat,
  hu: UnifyU(j),
  c: Checker,
  h: Ty,
  x: Ty,
  n: Text,
  args: List(Ty),
  o: Option(Pair(List(Ty), Ty))
): AppKOk(j, c, h, x, n, args, o) {
  match o: AppKOk(j, c, h, x, n, args, o) {
    None => (e: ty_split_last(args) = None) => uok_no(
      c,
      TyApp(h, x),
      TyNamed(n, args)
    )
    Some(p) => (e: ty_split_last(args) = Some(p)) => uok_and(
      c,
      ck_unify_in(j, c, h, TyNamed(n, pair_fst_lt(p))),
      h,
      TyNamed(n, pair_fst_lt(p)),
      (c2: Checker) => ck_unify_in(j, c2, x, pair_snd_lt(p)),
      (c2: Checker) => TyEqAt(c2, x, pair_snd_lt(p)),
      (c2: Checker) => TyEqAt(c2, TyApp(h, x), TyNamed(n, args)),
      hu(c, h, TyNamed(n, pair_fst_lt(p))),
      (c2: Checker) => hu(c2, x, pair_snd_lt(p)),
      (
        c2: Checker,
        h1: TyEqAt(c2, h, TyNamed(n, pair_fst_lt(p))),
        h2: TyEqAt(c2, x, pair_snd_lt(p))
      ) => TyeqTrans(
        TyeqApp(h1, h2),
        TyeqTrans(
          TyeqAppNorm(TyNamed(n, pair_fst_lt(p)), pair_snd_lt(p)),
          Eq::subst(
            (z: List(Ty)) => TyEqAt(
              c2,
              TyNamed(n, List::append(Ty, pair_fst_lt(p), Cons(Ty, pair_snd_lt(p), Nil(Ty)))),
              TyNamed(n, z)
            ),
            ck_split_last_ok(args, p, e),
            TyeqRefl(
              TyNamed(n, List::append(Ty, pair_fst_lt(p), Cons(Ty, pair_snd_lt(p), Nil(Ty))))
            )
          )
        )
      )
    )
  }
}

pub theorem app_step(
  j: Nat,
  hu: UnifyU(j),
  c: Checker,
  h: Ty,
  x: Ty,
  n: Text,
  args: List(Ty)
): UOk(c, ck_unify_app_in(Succ(j), c, h, x, n, args), TyApp(h, x), TyNamed(n, args)) {
  ck_app_k_ok(j, hu, c, h, x, n, args, ty_split_last(args))(Refl)
}

// ----- one step of `ck_unify_in` -----

pub fn ck_steps_of(c: Checker): Nat {
  c.steps
}

pub fn ck_unify_k(j: Nat, c: Checker, b: Ty, a1: Ty, a: Ty): Mut1(Bool, Checker) {
  match a: Mut1(Bool, Checker) {
    TyVar(v) => ck_rewrap1(ck_bind(c, v, b))
    _ => ck_rewrap1(ck_unify_rest_in(j, c, a1, b))
  }
}

pub def UnifyKOk(
  j: Nat,
  c: Checker,
  b: Ty,
  a1: Ty,
  a: Ty
): Prop := (a1 = a) -> UOk(c, ck_unify_k(j, c, b, a1, a), a1, b)

pub theorem ck_unify_k_ok(
  j: Nat,
  hr: UnifyR(j),
  c: Checker,
  b: Ty,
  a1: Ty,
  a: Ty
): UnifyKOk(j, c, b, a1, a) {
  match a: UnifyKOk(j, c, b, a1, a) {
    TyVar(v) => (e: a1 = TyVar(v)) => Eq::subst(
      (z: Ty) => UOk(c, ck_rewrap1(ck_bind(c, v, b)), z, b),
      Eq::sym(e),
      uok_rewrap(c, ck_bind(c, v, b), TyVar(v), b, ck_bind_ok(c, v, b))
    )
    _ => (e: a1 = a) => uok_rewrap(c, ck_unify_rest_in(j, c, a1, b), a1, b, hr(c, a1, b))
  }
}

pub theorem unify_step(
  j: Nat,
  hr: UnifyR(j),
  c: Checker,
  a0: Ty,
  b0: Ty
): UOk(c, ck_unify_in(Succ(j), c, a0, b0), a0, b0) {
  uok_resolve(
    c,
    ck_unify_in(Succ(j), c, a0, b0),
    a0,
    b0,
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
    ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0),
    ty_resolve_eq(ck_steps_of(c), ck_subst_of(c), KeptOk(ck_kept_of(c)), a0),
    ty_resolve_eq(ck_steps_of(c), ck_subst_of(c), KeptOk(ck_kept_of(c)), b0),
    ck_unify_k_ok(
      j,
      hr,
      c,
      ty_resolve_in(ck_steps_of(c), ck_subst_of(c), b0),
      ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0),
      ty_resolve_in(ck_steps_of(c), ck_subst_of(c), a0)
    )(Refl)
  )
}

// ----- what the conditions say -----

pub theorem ck_bool_and_left(a: Bool, b: Bool, e: Bool::and(a, b) = true): (a = true) {
  match a: (Bool::and(a, b) = true) -> (a = true) {
    false => (e2: false = true) => e2
    true => (e2: b = true) => Refl
  }(e)
}

pub theorem ck_bool_and_right(a: Bool, b: Bool, e: Bool::and(a, b) = true): (b = true) {
  match a: (Bool::and(a, b) = true) -> (b = true) {
    false => (e2: false = true) => False::elim(false_ne_true(e2))
    true => (e2: b = true) => e2
  }(e)
}

pub theorem ck_step_equal(o: Ordering, e: ty_eq_step(o) = true): (o = Equal) {
  Ordering::cases(
    (x: Ordering) => x = Equal,
    o,
    (q: o = Less) => False::elim(
      false_ne_true(Eq::subst((x: Ordering) => ty_eq_step(x) = true, q, e))
    ),
    (q: o = Equal) => Refl,
    (q: o = Greater) => False::elim(
      false_ne_true(Eq::subst((x: Ordering) => ty_eq_step(x) = true, q, e))
    )
  )
}

pub theorem text_eq_sound(a: Text, b: Text, e: Text::eq(a, b) = true): (a = b) {
  Ordmap::compare_text_eq(a, b, ck_step_equal(Text::ordering(a, b), e))
}

pub theorem text_list_eq_sound(
  a: List(Text),
  b: List(Text),
  e: text_list_eq(a, b) = true
): (a = b) {
  cmp_text_list_eq(a, b, ck_step_equal(cmp_text_list(a, b), e))
}

pub theorem kind_eq_sound(a: Kind, b: Kind, e: kind_eq(a, b) = true): (a = b) {
  kind_rank_inj(a, b, Nat::eq_sound(kind_rank(a), kind_rank(b), e))
}

pub def KindSameIf(
  a: Kind,
  b: Kind,
  x: Bool
): Prop := (Bool::or(x, Bool::and(kind_dup(a), kind_dup(b))) = true) -> KindSame(a, b)

pub theorem kind_same_of(
  a: Kind,
  b: Kind,
  e: Bool::or(kind_eq(a, b), Bool::and(kind_dup(a), kind_dup(b))) = true
): KindSame(a, b) {
  Bool::cases(
    (x: Bool) => KindSameIf(a, b, x),
    kind_eq(a, b),
    (q: kind_eq(a, b) = false) => (
      e2: Bool::and(kind_dup(a), kind_dup(b)) = true
    ) => KindSameDup(
      ck_bool_and_left(kind_dup(a), kind_dup(b), e2),
      ck_bool_and_right(kind_dup(a), kind_dup(b), e2)
    ),
    (q: kind_eq(a, b) = true) => (e2: true = true) => Eq::subst(
      (z: Kind) => KindSame(a, z),
      kind_eq_sound(a, b, q),
      KindSameRefl(a)
    )
  )(e)
}

// ----- one step of `ck_unify_rest_in` -----

pub theorem post_seq(
  c: Checker,
  m: Mut1(Bool, Checker),
  q1: (Checker) -> Prop,
  k: (Checker) -> Mut1(Bool, Checker),
  q2: (Checker) -> Prop,
  q: (Checker) -> Prop,
  mono1: Mono(q1),
  h1: Post(c, m, q1),
  h2: ∀ c2: Checker. Post(c2, k(c2), q2),
  f: ∀ c2: Checker. (q1(c2)) -> (q2(c2)) -> q(c2)
): Post(c, ck_and(k, m), q) {
  post_of_and(
    c,
    ck_and(k, m),
    q1,
    q2,
    q,
    f,
    (o: CkOrdered(c)) => post_and(c, m, q1, k, q2, mono1, h1, h2, o)
  )
}

pub theorem post_map(
  c: Checker,
  m: Mut1(Bool, Checker),
  q1: (Checker) -> Prop,
  q: (Checker) -> Prop,
  f: ∀ c2: Checker. (q1(c2)) -> q(c2),
  h: Post(c, m, q1)
): Post(c, ck_rewrap1(m), q) {
  Eq::subst(
    (z: Mut1(Bool, Checker)) => Post(c, z, q),
    Eq::sym(ck_rewrap1_id(m)),
    (o: CkOrdered(c)) => AndIntro(
      And::left(h(o)),
      (y: ck_val(m) = true) => f(ck_st(m), And::right(h(o))(y))
    )
  )
}

// A step from a state that differs from `c` only in what unifying does not
// look at.
pub theorem post_pre(
  c: Checker,
  c2: Checker,
  m: Mut1(Bool, Checker),
  q: (Checker) -> Prop,
  hs: CkSame(c, c2),
  h: Post(c2, m, q)
): Post(c, m, q) {
  (o: CkOrdered(c)) => AndIntro(
    grows_trans(
      c,
      c2,
      ck_st(m),
      grows_of_same(c, c2, o, hs),
      And::left(h(And::left(grows_of_same(c, c2, o, hs))))
    ),
    And::right(h(And::left(grows_of_same(c, c2, o, hs))))
  )
}

pub fn ck_poly_k(
  j: Nat,
  ga: List(Pair(Text, Kind)),
  ta: Ty,
  gb: List(Pair(Text, Kind)),
  tb: Ty,
  m: Mut1(Ordmap(Text, Ty), Checker)
): Mut1(Bool, Checker) {
  match m: Mut1(Bool, Checker) {
    mut1(rigid, c2) => ck_and(
      (c3: Checker) => ck_keep(c3, ga, rigid, TyPoly(ga, ta), TyPoly(gb, tb)),
      ck_unify_in(j, c2, ty_substitute(ta, rigid), ty_substitute(tb, ty_poly_map(gb, ga, rigid)))
    )
  }
}

pub fn ck_poly_c(
  j: Nat,
  c: Checker,
  ga: List(Pair(Text, Kind)),
  ta: Ty,
  gb: List(Pair(Text, Kind)),
  tb: Ty,
  x: Bool
): Mut1(Bool, Checker) {
  match x: Mut1(Bool, Checker) {
    true => ck_poly_k(j, ga, ta, gb, tb, ck_rigid(ga, c))
    false => mut1(ty_eq(TyPoly(ga, ta), TyPoly(gb, tb)), c)
  }
}

pub def PolyKOk(
  j: Nat,
  c: Checker,
  ga: List(Pair(Text, Kind)),
  ta: Ty,
  gb: List(Pair(Text, Kind)),
  tb: Ty,
  m: Mut1(Ordmap(Text, Ty), Checker)
): Prop := (
  CkSame(c, ck_st(m))
) -> UOk(c, ck_poly_k(j, ga, ta, gb, tb, m), TyPoly(ga, ta), TyPoly(gb, tb))

pub theorem ck_poly_k_ok(
  j: Nat,
  hu: UnifyU(j),
  c: Checker,
  ga: List(Pair(Text, Kind)),
  ta: Ty,
  gb: List(Pair(Text, Kind)),
  tb: Ty,
  hk: ty_kinds_match(ga, gb) = true,
  m: Mut1(Ordmap(Text, Ty), Checker)
): PolyKOk(j, c, ga, ta, gb, tb, m) {
  match m: PolyKOk(j, c, ga, ta, gb, tb, m) {
    mut1(rigid, c2) => (hs: CkSame(c, c2)) => post_pre(
      c,
      c2,
      ck_poly_k(j, ga, ta, gb, tb, mut1(rigid, c2)),
      (c4: Checker) => TyEqAt(c4, TyPoly(ga, ta), TyPoly(gb, tb)),
      hs,
      post_seq(
        c2,
        ck_unify_in(j, c2, ty_substitute(ta, rigid), ty_substitute(tb, ty_poly_map(gb, ga, rigid))),
        (c4: Checker) => TyEqAt(
          c4,
          ty_substitute(ta, rigid),
          ty_substitute(tb, ty_poly_map(gb, ga, rigid))
        ),
        (c3: Checker) => ck_keep(c3, ga, rigid, TyPoly(ga, ta), TyPoly(gb, tb)),
        (c4: Checker) => KeptIn(ck_kept_of(c4), ga, rigid, TyPoly(ga, ta), TyPoly(gb, tb)),
        (c4: Checker) => TyEqAt(c4, TyPoly(ga, ta), TyPoly(gb, tb)),
        mono_eq(ty_substitute(ta, rigid), ty_substitute(tb, ty_poly_map(gb, ga, rigid))),
        hu(c2, ty_substitute(ta, rigid), ty_substitute(tb, ty_poly_map(gb, ga, rigid))),
        (c3: Checker) => (o3: CkOrdered(c3)) => ck_keep_ok(
          c3,
          ga,
          rigid,
          TyPoly(ga, ta),
          TyPoly(gb, tb),
          o3
        ),
        (
          c4: Checker,
          h1: TyEqAt(c4, ty_substitute(ta, rigid), ty_substitute(tb, ty_poly_map(gb, ga, rigid))),
          h2: KeptIn(ck_kept_of(c4), ga, rigid, TyPoly(ga, ta), TyPoly(gb, tb))
        ) => TyeqPoly(ga, gb, rigid, hk, h2, h1)
      )
    )
  }
}

pub theorem poly_ok(
  j: Nat,
  hu: UnifyU(j),
  c: Checker,
  ga: List(Pair(Text, Kind)),
  ta: Ty,
  gb: List(Pair(Text, Kind)),
  tb: Ty
): UOk(c, ck_poly_c(j, c, ga, ta, gb, tb, ty_kinds_match(ga, gb)), TyPoly(ga, ta), TyPoly(gb, tb)) {
  Bool::cases(
    (x: Bool) => UOk(c, ck_poly_c(j, c, ga, ta, gb, tb, x), TyPoly(ga, ta), TyPoly(gb, tb)),
    ty_kinds_match(ga, gb),
    (q: ty_kinds_match(ga, gb) = false) => uok_tyeq(c, TyPoly(ga, ta), TyPoly(gb, tb)),
    (q: ty_kinds_match(ga, gb) = true) => ck_poly_k_ok(
      j,
      hu,
      c,
      ga,
      ta,
      gb,
      tb,
      q,
      ck_rigid(ga, c)
    )(ck_rigid_same(ga, c))
  )
}

pub fn ck_fn_c(
  j: Nat,
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  x: Bool
): Mut1(Bool, Checker) {
  match x: Mut1(Bool, Checker) {
    true => ck_and((c2: Checker) => ck_unify_in(j, c2, ra, rb), ck_unify_pairs_in(j, c, pa, pb))
    false => mut1(ty_eq(TyFn(pa, ra, ka), TyFn(pb, rb, kb)), c)
  }
}

pub theorem fn_ok(
  j: Nat,
  hu: UnifyU(j),
  hp: UnifyP(j),
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  pb: List(Ty),
  rb: Ty,
  kb: Kind
): UOk(
  c,
  ck_fn_c(
    j,
    c,
    pa,
    ra,
    ka,
    pb,
    rb,
    kb,
    Bool::and(
      Nat::eq(list_len(pa), list_len(pb)),
      Bool::or(kind_eq(ka, kb), Bool::and(kind_dup(ka), kind_dup(kb)))
    )
  ),
  TyFn(pa, ra, ka),
  TyFn(pb, rb, kb)
) {
  Bool::cases(
    (x: Bool) => UOk(c, ck_fn_c(j, c, pa, ra, ka, pb, rb, kb, x), TyFn(pa, ra, ka), TyFn(pb, rb, kb)),
    Bool::and(
      Nat::eq(list_len(pa), list_len(pb)),
      Bool::or(kind_eq(ka, kb), Bool::and(kind_dup(ka), kind_dup(kb)))
    ),
    (
      q: Bool::and(
          Nat::eq(list_len(pa), list_len(pb)),
          Bool::or(kind_eq(ka, kb), Bool::and(kind_dup(ka), kind_dup(kb)))
        ) = false
    ) => uok_tyeq(c, TyFn(pa, ra, ka), TyFn(pb, rb, kb)),
    (
      q: Bool::and(
          Nat::eq(list_len(pa), list_len(pb)),
          Bool::or(kind_eq(ka, kb), Bool::and(kind_dup(ka), kind_dup(kb)))
        ) = true
    ) => post_seq(
      c,
      ck_unify_pairs_in(j, c, pa, pb),
      (c2: Checker) => TyEqLenAt(c2, pa, pb),
      (c2: Checker) => ck_unify_in(j, c2, ra, rb),
      (c2: Checker) => TyEqAt(c2, ra, rb),
      (c2: Checker) => TyEqAt(c2, TyFn(pa, ra, ka), TyFn(pb, rb, kb)),
      mono_len(pa, pb),
      hp(c, pa, pb),
      (c2: Checker) => hu(c2, ra, rb),
      (c2: Checker, h1: TyEqLenAt(c2, pa, pb), h2: TyEqAt(c2, ra, rb)) => TyeqFn(
        h1(
          ck_bool_and_left(
            Nat::eq(list_len(pa), list_len(pb)),
            Bool::or(kind_eq(ka, kb), Bool::and(kind_dup(ka), kind_dup(kb))),
            q
          )
        ),
        h2,
        kind_same_of(
          ka,
          kb,
          ck_bool_and_right(
            Nat::eq(list_len(pa), list_len(pb)),
            Bool::or(kind_eq(ka, kb), Bool::and(kind_dup(ka), kind_dup(kb))),
            q
          )
        )
      )
    )
  )
}

pub fn ck_named_c(
  j: Nat,
  c: Checker,
  na: Text,
  xa: List(Ty),
  nb: Text,
  xb: List(Ty),
  x: Bool
): Mut1(Bool, Checker) {
  match x: Mut1(Bool, Checker) {
    true => ck_rewrap1(ck_unify_pairs_in(j, c, xa, xb))
    false => mut1(ty_eq(TyNamed(na, xa), TyNamed(nb, xb)), c)
  }
}

pub theorem named_ok(
  j: Nat,
  hp: UnifyP(j),
  c: Checker,
  na: Text,
  xa: List(Ty),
  nb: Text,
  xb: List(Ty)
): UOk(
  c,
  ck_named_c(j, c, na, xa, nb, xb, Bool::and(Text::eq(na, nb), Nat::eq(list_len(xa), list_len(xb)))),
  TyNamed(na, xa),
  TyNamed(nb, xb)
) {
  Bool::cases(
    (x: Bool) => UOk(c, ck_named_c(j, c, na, xa, nb, xb, x), TyNamed(na, xa), TyNamed(nb, xb)),
    Bool::and(Text::eq(na, nb), Nat::eq(list_len(xa), list_len(xb))),
    (q: Bool::and(Text::eq(na, nb), Nat::eq(list_len(xa), list_len(xb))) = false) => uok_tyeq(
      c,
      TyNamed(na, xa),
      TyNamed(nb, xb)
    ),
    (q: Bool::and(Text::eq(na, nb), Nat::eq(list_len(xa), list_len(xb))) = true) => post_map(
      c,
      ck_unify_pairs_in(j, c, xa, xb),
      (c2: Checker) => TyEqLenAt(c2, xa, xb),
      (c2: Checker) => TyEqAt(c2, TyNamed(na, xa), TyNamed(nb, xb)),
      (c2: Checker, h: TyEqLenAt(c2, xa, xb)) => Eq::subst(
        (z: Text) => TyEqAt(c2, TyNamed(na, xa), TyNamed(z, xb)),
        text_eq_sound(
          na,
          nb,
          ck_bool_and_left(Text::eq(na, nb), Nat::eq(list_len(xa), list_len(xb)), q)
        ),
        TyeqNamed(na, h(ck_bool_and_right(Text::eq(na, nb), Nat::eq(list_len(xa), list_len(xb)), q)))
      ),
      hp(c, xa, xb)
    )
  )
}

pub fn ck_borrow_c(j: Nat, c: Checker, x: Ty, ma: Bool, y: Ty, mb: Bool, e: Bool): Mut1(Bool, Checker) {
  match e: Mut1(Bool, Checker) {
    true => ck_rewrap1(ck_unify_in(j, c, x, y))
    false => mut1(ty_eq(TyBorrow(x, ma), TyBorrow(y, mb)), c)
  }
}

pub theorem borrow_ok(
  j: Nat,
  hu: UnifyU(j),
  c: Checker,
  x: Ty,
  ma: Bool,
  y: Ty,
  mb: Bool
): UOk(c, ck_borrow_c(j, c, x, ma, y, mb, Bool::eq(ma, mb)), TyBorrow(x, ma), TyBorrow(y, mb)) {
  Bool::cases(
    (v: Bool) => UOk(c, ck_borrow_c(j, c, x, ma, y, mb, v), TyBorrow(x, ma), TyBorrow(y, mb)),
    Bool::eq(ma, mb),
    (q: Bool::eq(ma, mb) = false) => uok_tyeq(c, TyBorrow(x, ma), TyBorrow(y, mb)),
    (q: Bool::eq(ma, mb) = true) => post_map(
      c,
      ck_unify_in(j, c, x, y),
      (c2: Checker) => TyEqAt(c2, x, y),
      (c2: Checker) => TyEqAt(c2, TyBorrow(x, ma), TyBorrow(y, mb)),
      (c2: Checker, h: TyEqAt(c2, x, y)) => Eq::subst(
        (z: Bool) => TyEqAt(c2, TyBorrow(x, ma), TyBorrow(y, z)),
        Bool::eq_sound(ma, mb, q),
        TyeqBorrow(ma, h)
      ),
      hu(c, x, y)
    )
  )
}

pub fn ck_tagged_c(
  j: Nat,
  c: Checker,
  ta: List(Text),
  x: Ty,
  tb: List(Text),
  y: Ty,
  e: Bool
): Mut1(Bool, Checker) {
  match e: Mut1(Bool, Checker) {
    true => ck_rewrap1(ck_unify_in(j, c, x, y))
    false => mut1(ty_eq(TyTagged(ta, x), TyTagged(tb, y)), c)
  }
}

pub theorem tagged_ok(
  j: Nat,
  hu: UnifyU(j),
  c: Checker,
  ta: List(Text),
  x: Ty,
  tb: List(Text),
  y: Ty
): UOk(c, ck_tagged_c(j, c, ta, x, tb, y, text_list_eq(ta, tb)), TyTagged(ta, x), TyTagged(tb, y)) {
  Bool::cases(
    (v: Bool) => UOk(c, ck_tagged_c(j, c, ta, x, tb, y, v), TyTagged(ta, x), TyTagged(tb, y)),
    text_list_eq(ta, tb),
    (q: text_list_eq(ta, tb) = false) => uok_tyeq(c, TyTagged(ta, x), TyTagged(tb, y)),
    (q: text_list_eq(ta, tb) = true) => post_map(
      c,
      ck_unify_in(j, c, x, y),
      (c2: Checker) => TyEqAt(c2, x, y),
      (c2: Checker) => TyEqAt(c2, TyTagged(ta, x), TyTagged(tb, y)),
      (c2: Checker, h: TyEqAt(c2, x, y)) => Eq::subst(
        (z: List(Text)) => TyEqAt(c2, TyTagged(ta, x), TyTagged(z, y)),
        text_list_eq_sound(ta, tb, q),
        TyeqTagged(ta, h)
      ),
      hu(c, x, y)
    )
  )
}

pub fn ck_union_c(j: Nat, c: Checker, xa: List(Ty), xb: List(Ty), e: Bool): Mut1(Bool, Checker) {
  match e: Mut1(Bool, Checker) {
    true => ck_rewrap1(ck_unify_pairs_in(j, c, xa, xb))
    false => mut1(ty_eq(TyUnion(xa), TyUnion(xb)), c)
  }
}

pub theorem union_ok(
  j: Nat,
  hp: UnifyP(j),
  c: Checker,
  xa: List(Ty),
  xb: List(Ty)
): UOk(c, ck_union_c(j, c, xa, xb, Nat::eq(list_len(xa), list_len(xb))), TyUnion(xa), TyUnion(xb)) {
  Bool::cases(
    (v: Bool) => UOk(c, ck_union_c(j, c, xa, xb, v), TyUnion(xa), TyUnion(xb)),
    Nat::eq(list_len(xa), list_len(xb)),
    (q: Nat::eq(list_len(xa), list_len(xb)) = false) => uok_tyeq(c, TyUnion(xa), TyUnion(xb)),
    (q: Nat::eq(list_len(xa), list_len(xb)) = true) => post_map(
      c,
      ck_unify_pairs_in(j, c, xa, xb),
      (c2: Checker) => TyEqLenAt(c2, xa, xb),
      (c2: Checker) => TyEqAt(c2, TyUnion(xa), TyUnion(xb)),
      (c2: Checker, h: TyEqLenAt(c2, xa, xb)) => TyeqUnion(h(q)),
      hp(c, xa, xb)
    )
  )
}

pub fn ck_product_c(j: Nat, c: Checker, xa: List(Ty), xb: List(Ty), e: Bool): Mut1(Bool, Checker) {
  match e: Mut1(Bool, Checker) {
    true => ck_rewrap1(ck_unify_pairs_in(j, c, xa, xb))
    false => mut1(ty_eq(TyProduct(xa), TyProduct(xb)), c)
  }
}

pub theorem product_ok(
  j: Nat,
  hp: UnifyP(j),
  c: Checker,
  xa: List(Ty),
  xb: List(Ty)
): UOk(
  c,
  ck_product_c(j, c, xa, xb, Nat::eq(list_len(xa), list_len(xb))),
  TyProduct(xa),
  TyProduct(xb)
) {
  Bool::cases(
    (v: Bool) => UOk(c, ck_product_c(j, c, xa, xb, v), TyProduct(xa), TyProduct(xb)),
    Nat::eq(list_len(xa), list_len(xb)),
    (q: Nat::eq(list_len(xa), list_len(xb)) = false) => uok_tyeq(
      c,
      TyProduct(xa),
      TyProduct(xb)
    ),
    (q: Nat::eq(list_len(xa), list_len(xb)) = true) => post_map(
      c,
      ck_unify_pairs_in(j, c, xa, xb),
      (c2: Checker) => TyEqLenAt(c2, xa, xb),
      (c2: Checker) => TyEqAt(c2, TyProduct(xa), TyProduct(xb)),
      (c2: Checker, h: TyEqLenAt(c2, xa, xb)) => TyeqProduct(h(q)),
      hp(c, xa, xb)
    )
  )
}

pub theorem uok_eqs<a: Ty, b: Ty>(
  c: Checker,
  m: Mut1(Bool, Checker),
  a1: Ty,
  b1: Ty,
  ea: a1 = a,
  eb: b1 = b,
  h: UOk(c, m, a, b)
): UOk(c, m, a1, b1) {
  Eq::subst(
    (z: Ty) => UOk(c, m, a1, z),
    Eq::sym(eb),
    Eq::subst((z: Ty) => UOk(c, m, z, b), Eq::sym(ea), h)
  )
}

pub theorem uok_tyeq_eqs<a: Ty, b: Ty>(
  c: Checker,
  a1: Ty,
  b1: Ty,
  ea: a1 = a,
  eb: b1 = b
): UOk(c, mut1(ty_eq(a, b), c), a1, b1) {
  uok_eqs(c, mut1(ty_eq(a, b), c), a1, b1, ea, eb, uok_tyeq(c, a, b))
}

// A wildcard arm does not name the constructor it stands for, so the step is
// stated of `a1` and `b1`, equal to `a` and `b`.
pub theorem rest_step_eqs(
  j: Nat,
  hu: UnifyU(j),
  hp: UnifyP(j),
  happ: UnifyA(j),
  c: Checker,
  a1: Ty,
  b1: Ty,
  a: Ty,
  b: Ty,
  ea: a1 = a,
  eb: b1 = b
): UOk(c, ck_unify_rest_in(Succ(j), c, a, b), a1, b1) {
  match b: UOk(c, ck_unify_rest_in(Succ(j), c, a, b), a1, b1) {
    TyVar(v) => uok_eqs(
      c,
      ck_rewrap1(ck_bind(c, v, a)),
      a1,
      b1,
      ea,
      eb,
      uok_rewrap(
        c,
        ck_bind(c, v, a),
        a,
        TyVar(v),
        uok_sym(c, ck_bind(c, v, a), TyVar(v), a, ck_bind_ok(c, v, a))
      )
    )
    TyApp(hb, xb) => match a: UOk(c, ck_unify_rest_in(Succ(j), c, a, TyApp(hb, xb)), a1, b1) {
      TyApp(ha, xa) => uok_eqs(
        c,
        ck_and((c2: Checker) => ck_unify_in(j, c2, xa, xb), ck_unify_in(j, c, ha, hb)),
        a1,
        b1,
        ea,
        eb,
        uok_and(
          c,
          ck_unify_in(j, c, ha, hb),
          ha,
          hb,
          (c2: Checker) => ck_unify_in(j, c2, xa, xb),
          (c2: Checker) => TyEqAt(c2, xa, xb),
          (c2: Checker) => TyEqAt(c2, TyApp(ha, xa), TyApp(hb, xb)),
          hu(c, ha, hb),
          (c2: Checker) => hu(c2, xa, xb),
          (c2: Checker, h1: TyEqAt(c2, ha, hb), h2: TyEqAt(c2, xa, xb)) => TyeqApp(h1, h2)
        )
      )
      TyNamed(na, xa) => uok_eqs(
        c,
        ck_rewrap1(ck_unify_app_in(j, c, hb, xb, na, xa)),
        a1,
        b1,
        ea,
        eb,
        uok_rewrap(
          c,
          ck_unify_app_in(j, c, hb, xb, na, xa),
          TyNamed(na, xa),
          TyApp(hb, xb),
          uok_sym(
            c,
            ck_unify_app_in(j, c, hb, xb, na, xa),
            TyApp(hb, xb),
            TyNamed(na, xa),
            happ(c, hb, xb, na, xa)
          )
        )
      )
      _ => uok_no(c, a1, b1)
    }
    TyPoly(gb, tb) => match a: UOk(c, ck_unify_rest_in(Succ(j), c, a, TyPoly(gb, tb)), a1, b1) {
      TyPoly(ga, ta) => uok_eqs(
        c,
        ck_poly_c(j, c, ga, ta, gb, tb, ty_kinds_match(ga, gb)),
        a1,
        b1,
        ea,
        eb,
        poly_ok(j, hu, c, ga, ta, gb, tb)
      )
      _ => uok_no(c, a1, b1)
    }
    TyFn(pb, rb, kb) => match a: UOk(
      c,
      ck_unify_rest_in(Succ(j), c, a, TyFn(pb, rb, kb)),
      a1,
      b1
    ) {
      TyFn(pa, ra, ka) => uok_eqs(
        c,
        ck_fn_c(
          j,
          c,
          pa,
          ra,
          ka,
          pb,
          rb,
          kb,
          Bool::and(
            Nat::eq(list_len(pa), list_len(pb)),
            Bool::or(kind_eq(ka, kb), Bool::and(kind_dup(ka), kind_dup(kb)))
          )
        ),
        a1,
        b1,
        ea,
        eb,
        fn_ok(j, hu, hp, c, pa, ra, ka, pb, rb, kb)
      )
      _ => uok_no(c, a1, b1)
    }
    TyNamed(nb, xb) => match a: UOk(c, ck_unify_rest_in(Succ(j), c, a, TyNamed(nb, xb)), a1, b1) {
      TyNamed(na, xa) => uok_eqs(
        c,
        ck_named_c(
          j,
          c,
          na,
          xa,
          nb,
          xb,
          Bool::and(Text::eq(na, nb), Nat::eq(list_len(xa), list_len(xb)))
        ),
        a1,
        b1,
        ea,
        eb,
        named_ok(j, hp, c, na, xa, nb, xb)
      )
      TyApp(ha, xa) => uok_eqs(
        c,
        ck_rewrap1(ck_unify_app_in(j, c, ha, xa, nb, xb)),
        a1,
        b1,
        ea,
        eb,
        uok_rewrap(
          c,
          ck_unify_app_in(j, c, ha, xa, nb, xb),
          TyApp(ha, xa),
          TyNamed(nb, xb),
          happ(c, ha, xa, nb, xb)
        )
      )
      _ => uok_no(c, a1, b1)
    }
    TyInfo(y) => match a: UOk(c, ck_unify_rest_in(Succ(j), c, a, TyInfo(y)), a1, b1) {
      TyInfo(x) => uok_eqs(
        c,
        ck_rewrap1(ck_unify_in(j, c, x, y)),
        a1,
        b1,
        ea,
        eb,
        post_map(
          c,
          ck_unify_in(j, c, x, y),
          (c2: Checker) => TyEqAt(c2, x, y),
          (c2: Checker) => TyEqAt(c2, TyInfo(x), TyInfo(y)),
          (c2: Checker, h: TyEqAt(c2, x, y)) => TyeqInfo(h),
          hu(c, x, y)
        )
      )
      _ => uok_no(c, a1, b1)
    }
    TyBorrow(y, mb) => match a: UOk(c, ck_unify_rest_in(Succ(j), c, a, TyBorrow(y, mb)), a1, b1) {
      TyBorrow(x, ma) => uok_eqs(
        c,
        ck_borrow_c(j, c, x, ma, y, mb, Bool::eq(ma, mb)),
        a1,
        b1,
        ea,
        eb,
        borrow_ok(j, hu, c, x, ma, y, mb)
      )
      _ => uok_no(c, a1, b1)
    }
    TyTagged(tb, y) => match a: UOk(c, ck_unify_rest_in(Succ(j), c, a, TyTagged(tb, y)), a1, b1) {
      TyTagged(ta, x) => uok_eqs(
        c,
        ck_tagged_c(j, c, ta, x, tb, y, text_list_eq(ta, tb)),
        a1,
        b1,
        ea,
        eb,
        tagged_ok(j, hu, c, ta, x, tb, y)
      )
      _ => uok_no(c, a1, b1)
    }
    TyUnion(xb) => match a: UOk(c, ck_unify_rest_in(Succ(j), c, a, TyUnion(xb)), a1, b1) {
      TyUnion(xa) => uok_eqs(
        c,
        ck_union_c(j, c, xa, xb, Nat::eq(list_len(xa), list_len(xb))),
        a1,
        b1,
        ea,
        eb,
        union_ok(j, hp, c, xa, xb)
      )
      _ => uok_no(c, a1, b1)
    }
    TyProduct(xb) => match a: UOk(c, ck_unify_rest_in(Succ(j), c, a, TyProduct(xb)), a1, b1) {
      TyProduct(xa) => uok_eqs(
        c,
        ck_product_c(j, c, xa, xb, Nat::eq(list_len(xa), list_len(xb))),
        a1,
        b1,
        ea,
        eb,
        product_ok(j, hp, c, xa, xb)
      )
      _ => uok_no(c, a1, b1)
    }
    _ => uok_tyeq_eqs(c, a1, b1, ea, eb)
  }
}

pub theorem rest_step(
  j: Nat,
  hu: UnifyU(j),
  hp: UnifyP(j),
  happ: UnifyA(j),
  c: Checker,
  a: Ty,
  b: Ty
): UOk(c, ck_unify_rest_in(Succ(j), c, a, b), a, b) {
  rest_step_eqs(j, hu, hp, happ, c, a, b, a, b, Refl, Refl)
}

// ----- by fuel -----

pub def UnifyAt(k: Nat): Prop := And(UnifyU(k), And(UnifyR(k), And(UnifyP(k), UnifyA(k))))

pub theorem unify_at(k: Nat): UnifyAt(k) {
  match k: UnifyAt(k) {
    Zero => AndIntro(
      (c: Checker, a: Ty, b: Ty) => uok_no(c, a, b),
      AndIntro(
        (c: Checker, a: Ty, b: Ty) => uok_no(c, a, b),
        AndIntro(
          (c: Checker, xs: List(Ty), ys: List(Ty)) => (o: CkOrdered(c)) => AndIntro(
            grows_refl(c, o),
            (y: false = true) => False::elim(false_ne_true(y))
          ),
          (c: Checker, h: Ty, x: Ty, n: Text, args: List(Ty)) => uok_no(
            c,
            TyApp(h, x),
            TyNamed(n, args)
          )
        )
      )
    )
    Succ(j) => AndIntro(
      (c: Checker, a: Ty, b: Ty) => unify_step(j, And::left(And::right(unify_at(j))), c, a, b),
      AndIntro(
        (c: Checker, a: Ty, b: Ty) => rest_step(
          j,
          And::left(unify_at(j)),
          And::left(And::right(And::right(unify_at(j)))),
          And::right(And::right(And::right(unify_at(j)))),
          c,
          a,
          b
        ),
        AndIntro(
          (c: Checker, xs: List(Ty), ys: List(Ty)) => pairs_step(
            j,
            And::left(unify_at(j)),
            And::left(And::right(And::right(unify_at(j)))),
            c,
            xs,
            ys
          ),
          (c: Checker, h: Ty, x: Ty, n: Text, args: List(Ty)) => app_step(
            j,
            And::left(unify_at(j)),
            c,
            h,
            x,
            n,
            args
          )
        )
      )
    )
  }
}

// `ck_unify` is sound: from an ordered substitution, the state after it
// extends the one before, and when it says true, `a` and `b` are the same
// type there.
pub theorem ck_unify_ok(c: Checker, a: Ty, b: Ty): UOk(c, ck_unify(c, a, b), a, b) {
  uok_rewrap(
    c,
    ck_unify_in(ck_steps_of(c), c, a, b),
    a,
    b,
    And::left(unify_at(ck_steps_of(c)))(c, a, b)
  )
}
