pub theorem ck_join_run_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_join(c, a, b)) {
  run_frame_grows(c, ck_join(c, a, b), And::left(ck_join_ok(c, a, b)(ordered)))
}
pub fn run_expect_after(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  fits: Bool
): Mut1(Unit, Checker) {
  match not(fits) {
    true => frame_bind(
      <A: Option(CoerceFound), B: Unit>,
      (found: Option(CoerceFound), next: Checker) => run_expect_refused(next, a, b, span, what, found),
      ck_coerce_fit(c, a, b)
    )
    false => mut1(Star, c)
  }
}
// What `ck_expect` reports after reading `a` through `coerce` fields.
pub fn run_expect_refused(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  found: Option(CoerceFound)
): Mut1(Unit, Checker) {
  frame_error_if(c, coerce_refusal(c, a, b, what, found), span, coerce_refused(c, found))
}
pub theorem run_expect_after_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  fits: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, run_expect_after(c, a, b, span, what, fits)) {
  match fits {
    true => run_frame_return(c, Star, ordered)
    false => run_frame_bind(
      <A: Option(CoerceFound), B: Unit>,
      c,
      (found: Option(CoerceFound), next: Checker) => run_expect_refused(next, a, b, span, what, found),
      ck_coerce_fit(c, a, b),
      run_frame_grows(c, ck_coerce_fit(c, a, b), ck_coerce_fit_grows(c, a, b, ordered)),
      found => next => onext => run_frame_read(
        next,
        run_expect_refused(next, a, b, span, what, found),
        frame_error_if_ok(next, coerce_refusal(next, a, b, what, found), span, coerce_refused(next, found)),
        onext
      )
    )
  }
}
pub fn run_expect(c: Checker, a: Ty, b: Ty, span: TySpan, what: Text): Mut1(Unit, Checker) {
  frame_bind(
    <A: Bool, B: Unit>,
    (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits),
    ck_fits_wide(c, a, b)
  )
}
pub theorem run_expect_unf(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text
): ck_expect(c, a, b, span, what) = run_expect(c, a, b, span, what) { Refl }
pub theorem ck_expect_run_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_expect(c, a, b, span, what)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
    Eq::sym(run_expect_unf(c, a, b, span, what)),
    run_frame_bind(
      <A: Bool, B: Unit>,
      c,
      (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits),
      ck_fits_wide(c, a, b),
      ck_fits_wide_run_frame(c, a, b, ordered),
      fits => next => onext => run_expect_after_frame(next, a, b, span, what, fits, onext)
    )
  )
}

pub theorem ck_attempt_unify_run_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_attempt_unify(c, a, b)) {
  run_frame_grows(c, ck_attempt_unify(c, a, b), And::left(attempt_unify_sub(c, a, b)(ordered)))
}
