import std::prelude::Ord
import "allocation_state.taut"
import std::MapRemoveFloor
import std::Base
import std::Map
import std::MapLaws
import std::MapText
import std::Text
import "ty.taut"
import "type_allocation.taut"
import "unify_sound.taut"

pub def GenericMapAllocated(
  limit: Nat,
  map: Ordmap(Text, Ty)
): Prop := ∀ name: Text. ∀ value: Ty. ∀ found: Ordmap::get(
  map,
  name,
  Ordmap::compare_text
) = Some(value). TypeAllocated(limit, value)
pub theorem generic_map_remove_allocated(
  limit: Nat,
  map: Ordmap(Text, Ty),
  removed: Text,
  ordered: Ordmap::ordered(map, Ordmap::compare_text),
  values: GenericMapAllocated(limit, map)
): GenericMapAllocated(limit, Ordmap::remove(map, removed, Ordmap::compare_text)) {
  name => value => found => Ordering::cases(
    (order: Ordering) => TypeAllocated(limit, value),
    Ordmap::compare_text(name, removed),
    less => values(
      name,
      value,
      Eq::trans(
        Eq::sym(
          Ordmap::get_remove_other(
            Ordmap::compare_text,
            Ordmap::compare_text_law(),
            map,
            removed,
            name,
            Less,
            less_ne_equal,
            less,
            ordered
          )
        ),
        found
      )
    ),
    equal => False::elim(
      ck_none_ne_some(
        value,
        Eq::trans(
          Eq::sym(
            Ordmap::get_remove_same(
              Ordmap::compare_text,
              Ordmap::compare_text_law(),
              map,
              removed,
              ordered
            )
          ),
          Eq::subst(
            (key: Text) => Ordmap::get(
              Ordmap::remove(map, removed, Ordmap::compare_text),
              key,
              Ordmap::compare_text
            ) = Some(value),
            Ordmap::compare_text_eq(name, removed, equal),
            found
          )
        )
      )
    ),
    greater => values(
      name,
      value,
      Eq::trans(
        Eq::sym(
          Ordmap::get_remove_other(
            Ordmap::compare_text,
            Ordmap::compare_text_law(),
            map,
            removed,
            name,
            Greater,
            greater_ne_equal,
            greater,
            ordered
          )
        ),
        found
      )
    )
  )
}
pub theorem generic_map_without_allocated(
  gs: List(Pair(Text, Kind)),
  limit: Nat,
  map: Ordmap(Text, Ty),
  ordered: Ordmap::ordered(map, Ordmap::compare_text),
  values: GenericMapAllocated(limit, map)
): And(
  Ordmap::ordered(ty_map_without(gs, map), Ordmap::compare_text),
  GenericMapAllocated(limit, ty_map_without(gs, map))
) {
  ⊢ And(
    Ordmap::ordered(ty_map_without(gs, map), Ordmap::compare_text),
    GenericMapAllocated(limit, ty_map_without(gs, map))
  ) from match gs {
    Nil => AndIntro(ordered, values)
    Cons(generic, rest) => ⊢ And(
      Ordmap::ordered(ty_map_without(Cons(generic, rest), map), Ordmap::compare_text),
      GenericMapAllocated(limit, ty_map_without(Cons(generic, rest), map))
    ) from match generic {
      Pair { fst: name, snd: kind } => generic_map_without_allocated(
        rest,
        limit,
        Ordmap::remove(map, name, Ordmap::compare_text),
        Ordmap::remove_ordered(
          Ordmap::compare_text,
          Ordmap::compare_text_law(),
          map,
          name,
          ordered
        ),
        generic_map_remove_allocated(limit, map, name, ordered, values)
      )
    }
  }
}
pub fn allocation_substitute_choice(fallback: Ty, found: Option(Ty)): Ty {
  ⊢ Ty from match found { None => fallback
    Some(value) => value }
}
pub theorem allocation_substitute_choice_ok(
  limit: Nat,
  map: Ordmap(Text, Ty),
  name: Text,
  fallback: Ty,
  allocated: TypeAllocated(limit, fallback),
  values: GenericMapAllocated(limit, map),
  found: Option(Ty),
  equal: Ordmap::get(map, name, Ordmap::compare_text) = found
): TypeAllocated(limit, allocation_substitute_choice(fallback, found)) {
  ⊢ TypeAllocated(limit, allocation_substitute_choice(fallback, found)) from match found {
    None => allocated
    Some(value) => values(name, value, equal)
  }
}
pub theorem allocated_substitute_name(
  limit: Nat,
  map: Ordmap(Text, Ty),
  name: Text,
  fallback: Ty,
  allocated: TypeAllocated(limit, fallback),
  values: GenericMapAllocated(limit, map)
): TypeAllocated(limit, ty_substitute_name(name, map, fallback)) {
  allocation_substitute_choice_ok(
    limit,
    map,
    name,
    fallback,
    allocated,
    values,
    Ordmap::get(map, name, Ordmap::compare_text),
    Refl
  )
}

pub theorem generic_map_insert_allocated(
  limit: Nat,
  subst: Ordmap(Text, Ty),
  key: Text,
  value: Ty,
  ordered: Ordmap::ordered(subst, Ordmap::compare_text),
  item: TypeAllocated(limit, value),
  values: GenericMapAllocated(limit, subst)
): GenericMapAllocated(limit, Ordmap::insert(subst, key, value, Ordmap::compare_text)) {
  index => result => found => Ordering::cases(
    (order: Ordering) => TypeAllocated(limit, result),
    Ordmap::compare_text(index, key),
    less => values(
      index,
      result,
      Eq::trans(
        Eq::sym(
          Ordmap::get_insert_other(
            Ordmap::compare_text,
            Ordmap::compare_text_law(),
            subst,
            key,
            value,
            index,
            Less,
            less_ne_equal,
            less,
            ordered
          )
        ),
        found
      )
    ),
    equal => Eq::subst(
      (ty: Ty) => TypeAllocated(limit, ty),
      ck_some_inj(
        value,
        result,
        Eq::trans(
          Eq::sym(
            Ordmap::get_insert_same(
              Ordmap::compare_text,
              Ordmap::compare_text_law(),
              subst,
              key,
              value,
              ordered
            )
          ),
          Eq::subst(
            (at: Text) => Ordmap::get(
              Ordmap::insert(subst, key, value, Ordmap::compare_text),
              at,
              Ordmap::compare_text
            ) = Some(result),
            Ordmap::compare_text_eq(index, key, equal),
            found
          )
        )
      ),
      item
    ),
    greater => values(
      index,
      result,
      Eq::trans(
        Eq::sym(
          Ordmap::get_insert_other(
            Ordmap::compare_text,
            Ordmap::compare_text_law(),
            subst,
            key,
            value,
            index,
            Greater,
            greater_ne_equal,
            greater,
            ordered
          )
        ),
        found
      )
    )
  )
}
