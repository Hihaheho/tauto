import "ty.taut"
import std::MapText
import std::Base
import std::Map
import std::MapLaws
import std::Text
import std::prelude::Ord

// `ty_eq` says two types are the same only when they are (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」, the types
// layer): `ty_compare` is `Equal` only on equal types.

pub theorem ty_then_equal(
  a: Ordering,
  b: Ordering,
  e: ty_then(a, b) = Equal
): And(a = Equal, b = Equal) {
  ⊢ And(a = Equal, b = Equal) from match a {
    Less => False::elim(less_ne_equal(e))
    Equal => AndIntro(Refl, e)
    Greater => False::elim(greater_ne_equal(e))
  }
}

pub theorem ty_nat_ne(x: Nat, y: Nat, e: x = y, h: Nat::eq(x, y) = false): False {
  false_ne_true(
    Eq::trans(Eq::sym(Eq::subst((z: Nat) => Nat::eq(x, z) = false, Eq::sym(e), h)), Nat::eq_refl(x))
  )
}

pub theorem width_rank_inj(a: Width, b: Width, e: width_rank(a) = width_rank(b)): a = b {
  ⊢ a = b from match a {
    Width32 => ⊢ Width32 = b from match b {
      Width32 => Refl
      Width64 => False::elim(ty_nat_ne(0, 1, e, Refl))
      WidthU8 => False::elim(ty_nat_ne(0, 2, e, Refl))
      WidthU32 => False::elim(ty_nat_ne(0, 3, e, Refl))
      WidthU64 => False::elim(ty_nat_ne(0, 4, e, Refl))
    }
    Width64 => ⊢ Width64 = b from match b {
      Width32 => False::elim(ty_nat_ne(1, 0, e, Refl))
      Width64 => Refl
      WidthU8 => False::elim(ty_nat_ne(1, 2, e, Refl))
      WidthU32 => False::elim(ty_nat_ne(1, 3, e, Refl))
      WidthU64 => False::elim(ty_nat_ne(1, 4, e, Refl))
    }
    WidthU8 => ⊢ WidthU8 = b from match b {
      Width32 => False::elim(ty_nat_ne(2, 0, e, Refl))
      Width64 => False::elim(ty_nat_ne(2, 1, e, Refl))
      WidthU8 => Refl
      WidthU32 => False::elim(ty_nat_ne(2, 3, e, Refl))
      WidthU64 => False::elim(ty_nat_ne(2, 4, e, Refl))
    }
    WidthU32 => ⊢ WidthU32 = b from match b {
      Width32 => False::elim(ty_nat_ne(3, 0, e, Refl))
      Width64 => False::elim(ty_nat_ne(3, 1, e, Refl))
      WidthU8 => False::elim(ty_nat_ne(3, 2, e, Refl))
      WidthU32 => Refl
      WidthU64 => False::elim(ty_nat_ne(3, 4, e, Refl))
    }
    WidthU64 => ⊢ WidthU64 = b from match b {
      Width32 => False::elim(ty_nat_ne(4, 0, e, Refl))
      Width64 => False::elim(ty_nat_ne(4, 1, e, Refl))
      WidthU8 => False::elim(ty_nat_ne(4, 2, e, Refl))
      WidthU32 => False::elim(ty_nat_ne(4, 3, e, Refl))
      WidthU64 => Refl
    }
  }
}
pub theorem kind_rank_inj(a: Kind, b: Kind, e: kind_rank(a) = kind_rank(b)): a = b {
  ⊢ a = b from match a {
    KindCopy => ⊢ KindCopy = b from match b {
      KindCopy => Refl
      KindShared => False::elim(ty_nat_ne(0, 1, e, Refl))
      KindAffine => False::elim(ty_nat_ne(0, 2, e, Refl))
      KindLinear => False::elim(ty_nat_ne(0, 3, e, Refl))
    }
    KindShared => ⊢ KindShared = b from match b {
      KindCopy => False::elim(ty_nat_ne(1, 0, e, Refl))
      KindShared => Refl
      KindAffine => False::elim(ty_nat_ne(1, 2, e, Refl))
      KindLinear => False::elim(ty_nat_ne(1, 3, e, Refl))
    }
    KindAffine => ⊢ KindAffine = b from match b {
      KindCopy => False::elim(ty_nat_ne(2, 0, e, Refl))
      KindShared => False::elim(ty_nat_ne(2, 1, e, Refl))
      KindAffine => Refl
      KindLinear => False::elim(ty_nat_ne(2, 3, e, Refl))
    }
    KindLinear => ⊢ KindLinear = b from match b {
      KindCopy => False::elim(ty_nat_ne(3, 0, e, Refl))
      KindShared => False::elim(ty_nat_ne(3, 1, e, Refl))
      KindAffine => False::elim(ty_nat_ne(3, 2, e, Refl))
      KindLinear => Refl
    }
  }
}
pub theorem bool_rank_inj(a: Bool, b: Bool, e: bool_rank(a) = bool_rank(b)): a = b {
  ⊢ a = b from match a {
    false => ⊢ false = b from match b {
      false => Refl
      true => False::elim(ty_nat_ne(0, 1, e, Refl))
    }
    true => ⊢ true = b from match b {
      false => False::elim(ty_nat_ne(1, 0, e, Refl))
      true => Refl
    }
  }
}
pub theorem cmp_text_list_eq(a: List(Text), b: List(Text), e: cmp_text_list(a, b) = Equal): a = b {
  ⊢ a = b from match a {
    Nil => ⊢ Nil = b from match b {
      Nil => Refl
      Cons(y, ys) => False::elim(less_ne_equal(e))
    }
    Cons(x, xs) => ⊢ Cons(x, xs) = b from match b {
      Nil => False::elim(greater_ne_equal(e))
      Cons(y, ys) => Eq::trans(
        Eq::congr(
          (z: Text) => Cons(z, xs),
          Ordmap::compare_text_eq(
            x,
            y,
            And::left(ty_then_equal(Ordmap::compare_text(x, y), cmp_text_list(xs, ys), e))
          )
        ),
        Eq::congr(
          (z: List(Text)) => Cons(y, z),
          cmp_text_list_eq(
            xs,
            ys,
            And::right(ty_then_equal(Ordmap::compare_text(x, y), cmp_text_list(xs, ys), e))
          )
        )
      )
    }
  }
}

pub theorem cmp_generics_eq(
  a: List(Pair(Text, Kind)),
  b: List(Pair(Text, Kind)),
  e: cmp_generics(a, b) = Equal
): a = b {
  ⊢ a = b from match a {
    Nil => ⊢ Nil = b from match b {
      Nil => Refl
      Cons(y, ys) => False::elim(less_ne_equal(e))
    }
    Cons(x, xs) => ⊢ Cons(x, xs) = b from match b {
      Nil => False::elim(greater_ne_equal(e))
      Cons(y, ys) => ⊢ Cons(x, xs) = Cons(y, ys) from match x {
        Pair { fst: xn, snd: xk } => ⊢ Cons(Pair { fst: xn, snd: xk }, xs) = Cons(y, ys) from match y {
          Pair { fst: yn, snd: yk } => Eq::trans(
            Eq::congr(
              (z: Text) => Cons(Pair { fst: z, snd: xk }, xs),
              Ordmap::compare_text_eq(
                xn,
                yn,
                And::left(
                  ty_then_equal(
                    Ordmap::compare_text(xn, yn),
                    Ordmap::compare_nat(kind_rank(xk), kind_rank(yk)),
                    And::left(
                      ty_then_equal(
                        ty_then(
                          Ordmap::compare_text(xn, yn),
                          Ordmap::compare_nat(kind_rank(xk), kind_rank(yk))
                        ),
                        cmp_generics(xs, ys),
                        e
                      )
                    )
                  )
                )
              )
            ),
            Eq::trans(
              Eq::congr(
                (z: Kind) => Cons(Pair { fst: yn, snd: z }, xs),
                kind_rank_inj(
                  xk,
                  yk,
                  Ordmap::compare_nat_eq(
                    kind_rank(xk),
                    kind_rank(yk),
                    And::right(
                      ty_then_equal(
                        Ordmap::compare_text(xn, yn),
                        Ordmap::compare_nat(kind_rank(xk), kind_rank(yk)),
                        And::left(
                          ty_then_equal(
                            ty_then(
                              Ordmap::compare_text(xn, yn),
                              Ordmap::compare_nat(kind_rank(xk), kind_rank(yk))
                            ),
                            cmp_generics(xs, ys),
                            e
                          )
                        )
                      )
                    )
                  )
                )
              ),
              Eq::congr(
                (z: List(Pair(Text, Kind))) => Cons(Pair { fst: yn, snd: yk }, z),
                cmp_generics_eq(
                  xs,
                  ys,
                  And::right(
                    ty_then_equal(
                      ty_then(
                        Ordmap::compare_text(xn, yn),
                        Ordmap::compare_nat(kind_rank(xk), kind_rank(yk))
                      ),
                      cmp_generics(xs, ys),
                      e
                    )
                  )
                )
              )
            )
          )
        }
      }
    }
  }
}

mutual {
  pub theorem ty_compare_list_eq(
    a: List(Ty),
    b: List(Ty),
    e: ty_compare_list(a, b) = Equal
  ): a = b {
    ⊢ a = b from match a {
      Nil => ⊢ Nil = b from match b {
        Nil => Refl
        Cons(y, ys) => False::elim(less_ne_equal(e))
      }
      Cons(x, xs) => ⊢ Cons(x, xs) = b from match b {
        Nil => False::elim(greater_ne_equal(e))
        Cons(y, ys) => Eq::trans(
          Eq::congr(
            (z: Ty) => Cons(z, xs),
            ty_compare_eq(
              x,
              y,
              And::left(ty_then_equal(ty_compare(x, y), ty_compare_list(xs, ys), e))
            )
          ),
          Eq::congr(
            (z: List(Ty)) => Cons(y, z),
            ty_compare_list_eq(
              xs,
              ys,
              And::right(ty_then_equal(ty_compare(x, y), ty_compare_list(xs, ys), e))
            )
          )
        )
      }
    }
  }

  pub theorem ty_compare_eq(a: Ty, b: Ty, e: ty_compare(a, b) = Equal): a = b {
    ⊢ a = b from match a {
      TyInt(wa) => ⊢ TyInt(wa) = b from match b {
        TyInt(wb) => Eq::congr(
          (z: Width) => TyInt(z),
          width_rank_inj(wa, wb, Ordmap::compare_nat_eq(width_rank(wa), width_rank(wb), e))
        )
        TyBool => False::elim(less_ne_equal(e))
        TyText => False::elim(less_ne_equal(e))
        TyUnit => False::elim(less_ne_equal(e))
        TyNever => False::elim(less_ne_equal(e))
        TyDecimal => False::elim(less_ne_equal(e))
        TyFloat => False::elim(less_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(less_ne_equal(e))
        TyUnion(xb) => False::elim(less_ne_equal(e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyBool => ⊢ TyBool = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => Refl
        TyText => False::elim(less_ne_equal(e))
        TyUnit => False::elim(less_ne_equal(e))
        TyNever => False::elim(less_ne_equal(e))
        TyDecimal => False::elim(less_ne_equal(e))
        TyFloat => False::elim(less_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(less_ne_equal(e))
        TyUnion(xb) => False::elim(less_ne_equal(e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyText => ⊢ TyText = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => Refl
        TyUnit => False::elim(less_ne_equal(e))
        TyNever => False::elim(less_ne_equal(e))
        TyDecimal => False::elim(less_ne_equal(e))
        TyFloat => False::elim(less_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(less_ne_equal(e))
        TyUnion(xb) => False::elim(less_ne_equal(e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyUnit => ⊢ TyUnit = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => Refl
        TyNever => False::elim(less_ne_equal(e))
        TyDecimal => False::elim(less_ne_equal(e))
        TyFloat => False::elim(less_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(less_ne_equal(e))
        TyUnion(xb) => False::elim(less_ne_equal(e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyNever => ⊢ TyNever = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => Refl
        TyDecimal => False::elim(less_ne_equal(e))
        TyFloat => False::elim(less_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(less_ne_equal(e))
        TyUnion(xb) => False::elim(less_ne_equal(e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyDecimal => ⊢ TyDecimal = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => Refl
        TyFloat => False::elim(less_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(less_ne_equal(e))
        TyUnion(xb) => False::elim(less_ne_equal(e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyFloat => ⊢ TyFloat = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => Refl
        TyFn(pb, rb, kb) => False::elim(less_ne_equal(e))
        TyUnion(xb) => False::elim(less_ne_equal(e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyFn(pa, ra, ka) => ⊢ TyFn(pa, ra, ka) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => Eq::trans(
          Eq::congr(
            (z: List(Ty)) => TyFn(z, ra, ka),
            ty_compare_list_eq(
              pa,
              pb,
              And::left(
                ty_then_equal(
                  ty_compare_list(pa, pb),
                  ty_then(ty_compare(ra, rb), Ordmap::compare_nat(kind_rank(ka), kind_rank(kb))),
                  e
                )
              )
            )
          ),
          Eq::trans(
            Eq::congr(
              (z: Ty) => TyFn(pb, z, ka),
              ty_compare_eq(
                ra,
                rb,
                And::left(
                  ty_then_equal(
                    ty_compare(ra, rb),
                    Ordmap::compare_nat(kind_rank(ka), kind_rank(kb)),
                    And::right(
                      ty_then_equal(
                        ty_compare_list(pa, pb),
                        ty_then(
                          ty_compare(ra, rb),
                          Ordmap::compare_nat(kind_rank(ka), kind_rank(kb))
                        ),
                        e
                      )
                    )
                  )
                )
              )
            ),
            Eq::congr(
              (z: Kind) => TyFn(pb, rb, z),
              kind_rank_inj(
                ka,
                kb,
                Ordmap::compare_nat_eq(
                  kind_rank(ka),
                  kind_rank(kb),
                  And::right(
                    ty_then_equal(
                      ty_compare(ra, rb),
                      Ordmap::compare_nat(kind_rank(ka), kind_rank(kb)),
                      And::right(
                        ty_then_equal(
                          ty_compare_list(pa, pb),
                          ty_then(
                            ty_compare(ra, rb),
                            Ordmap::compare_nat(kind_rank(ka), kind_rank(kb))
                          ),
                          e
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
        TyUnion(xb) => False::elim(less_ne_equal(e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyUnion(xa) => ⊢ TyUnion(xa) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => Eq::congr((z: List(Ty)) => TyUnion(z), ty_compare_list_eq(xa, xb, e))
        TyProduct(xb) => False::elim(less_ne_equal(e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyProduct(xa) => ⊢ TyProduct(xa) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => Eq::congr((z: List(Ty)) => TyProduct(z), ty_compare_list_eq(xa, xb, e))
        TyTagged(tb, xb) => False::elim(less_ne_equal(e))
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyTagged(ta, xa) => ⊢ TyTagged(ta, xa) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => False::elim(greater_ne_equal(e))
        TyTagged(tb, xb) => Eq::trans(
          Eq::congr(
            (z: List(Text)) => TyTagged(z, xa),
            cmp_text_list_eq(
              ta,
              tb,
              And::left(ty_then_equal(cmp_text_list(ta, tb), ty_compare(xa, xb), e))
            )
          ),
          Eq::congr(
            (z: Ty) => TyTagged(tb, z),
            ty_compare_eq(
              xa,
              xb,
              And::right(ty_then_equal(cmp_text_list(ta, tb), ty_compare(xa, xb), e))
            )
          )
        )
        TyNamed(nb, xb) => False::elim(less_ne_equal(e))
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyNamed(na, xa) => ⊢ TyNamed(na, xa) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => False::elim(greater_ne_equal(e))
        TyTagged(tb, xb) => False::elim(greater_ne_equal(e))
        TyNamed(nb, xb) => Eq::trans(
          Eq::congr(
            (z: Text) => TyNamed(z, xa),
            Ordmap::compare_text_eq(
              na,
              nb,
              And::left(ty_then_equal(Ordmap::compare_text(na, nb), ty_compare_list(xa, xb), e))
            )
          ),
          Eq::congr(
            (z: List(Ty)) => TyNamed(nb, z),
            ty_compare_list_eq(
              xa,
              xb,
              And::right(ty_then_equal(Ordmap::compare_text(na, nb), ty_compare_list(xa, xb), e))
            )
          )
        )
        TyParam(nb, kb) => False::elim(less_ne_equal(e))
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyParam(na, ka) => ⊢ TyParam(na, ka) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => False::elim(greater_ne_equal(e))
        TyTagged(tb, xb) => False::elim(greater_ne_equal(e))
        TyNamed(nb, xb) => False::elim(greater_ne_equal(e))
        TyParam(nb, kb) => Eq::trans(
          Eq::congr(
            (z: Text) => TyParam(z, ka),
            Ordmap::compare_text_eq(
              na,
              nb,
              And::left(
                ty_then_equal(
                  Ordmap::compare_text(na, nb),
                  Ordmap::compare_nat(kind_rank(ka), kind_rank(kb)),
                  e
                )
              )
            )
          ),
          Eq::congr(
            (z: Kind) => TyParam(nb, z),
            kind_rank_inj(
              ka,
              kb,
              Ordmap::compare_nat_eq(
                kind_rank(ka),
                kind_rank(kb),
                And::right(
                  ty_then_equal(
                    Ordmap::compare_text(na, nb),
                    Ordmap::compare_nat(kind_rank(ka), kind_rank(kb)),
                    e
                  )
                )
              )
            )
          )
        )
        TyInfo(xb) => False::elim(less_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyInfo(xa) => ⊢ TyInfo(xa) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => False::elim(greater_ne_equal(e))
        TyTagged(tb, xb) => False::elim(greater_ne_equal(e))
        TyNamed(nb, xb) => False::elim(greater_ne_equal(e))
        TyParam(nb, kb) => False::elim(greater_ne_equal(e))
        TyInfo(xb) => Eq::congr((z: Ty) => TyInfo(z), ty_compare_eq(xa, xb, e))
        TyBorrow(xb, mb) => False::elim(less_ne_equal(e))
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyBorrow(xa, ma) => ⊢ TyBorrow(xa, ma) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => False::elim(greater_ne_equal(e))
        TyTagged(tb, xb) => False::elim(greater_ne_equal(e))
        TyNamed(nb, xb) => False::elim(greater_ne_equal(e))
        TyParam(nb, kb) => False::elim(greater_ne_equal(e))
        TyInfo(xb) => False::elim(greater_ne_equal(e))
        TyBorrow(xb, mb) => Eq::trans(
          Eq::congr(
            (z: Ty) => TyBorrow(z, ma),
            ty_compare_eq(
              xa,
              xb,
              And::left(
                ty_then_equal(
                  ty_compare(xa, xb),
                  Ordmap::compare_nat(bool_rank(ma), bool_rank(mb)),
                  e
                )
              )
            )
          ),
          Eq::congr(
            (z: Bool) => TyBorrow(xb, z),
            bool_rank_inj(
              ma,
              mb,
              Ordmap::compare_nat_eq(
                bool_rank(ma),
                bool_rank(mb),
                And::right(
                  ty_then_equal(
                    ty_compare(xa, xb),
                    Ordmap::compare_nat(bool_rank(ma), bool_rank(mb)),
                    e
                  )
                )
              )
            )
          )
        )
        TyVar(vb) => False::elim(less_ne_equal(e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyVar(va) => ⊢ TyVar(va) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => False::elim(greater_ne_equal(e))
        TyTagged(tb, xb) => False::elim(greater_ne_equal(e))
        TyNamed(nb, xb) => False::elim(greater_ne_equal(e))
        TyParam(nb, kb) => False::elim(greater_ne_equal(e))
        TyInfo(xb) => False::elim(greater_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(greater_ne_equal(e))
        TyVar(vb) => Eq::congr((z: Nat) => TyVar(z), Ordmap::compare_nat_eq(va, vb, e))
        TyPoly(gb, xb) => False::elim(less_ne_equal(e))
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyPoly(ga, xa) => ⊢ TyPoly(ga, xa) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => False::elim(greater_ne_equal(e))
        TyTagged(tb, xb) => False::elim(greater_ne_equal(e))
        TyNamed(nb, xb) => False::elim(greater_ne_equal(e))
        TyParam(nb, kb) => False::elim(greater_ne_equal(e))
        TyInfo(xb) => False::elim(greater_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(greater_ne_equal(e))
        TyVar(vb) => False::elim(greater_ne_equal(e))
        TyPoly(gb, xb) => Eq::trans(
          Eq::congr(
            (z: List(Pair(Text, Kind))) => TyPoly(z, xa),
            cmp_generics_eq(
              ga,
              gb,
              And::left(ty_then_equal(cmp_generics(ga, gb), ty_compare(xa, xb), e))
            )
          ),
          Eq::congr(
            (z: Ty) => TyPoly(gb, z),
            ty_compare_eq(
              xa,
              xb,
              And::right(ty_then_equal(cmp_generics(ga, gb), ty_compare(xa, xb), e))
            )
          )
        )
        TyApp(hb, xb) => False::elim(less_ne_equal(e))
      }
      TyApp(ha, xa) => ⊢ TyApp(ha, xa) = b from match b {
        TyInt(wb) => False::elim(greater_ne_equal(e))
        TyBool => False::elim(greater_ne_equal(e))
        TyText => False::elim(greater_ne_equal(e))
        TyUnit => False::elim(greater_ne_equal(e))
        TyNever => False::elim(greater_ne_equal(e))
        TyDecimal => False::elim(greater_ne_equal(e))
        TyFloat => False::elim(greater_ne_equal(e))
        TyFn(pb, rb, kb) => False::elim(greater_ne_equal(e))
        TyUnion(xb) => False::elim(greater_ne_equal(e))
        TyProduct(xb) => False::elim(greater_ne_equal(e))
        TyTagged(tb, xb) => False::elim(greater_ne_equal(e))
        TyNamed(nb, xb) => False::elim(greater_ne_equal(e))
        TyParam(nb, kb) => False::elim(greater_ne_equal(e))
        TyInfo(xb) => False::elim(greater_ne_equal(e))
        TyBorrow(xb, mb) => False::elim(greater_ne_equal(e))
        TyVar(vb) => False::elim(greater_ne_equal(e))
        TyPoly(gb, xb) => False::elim(greater_ne_equal(e))
        TyApp(hb, xb) => Eq::trans(
          Eq::congr(
            (z: Ty) => TyApp(z, xa),
            ty_compare_eq(
              ha,
              hb,
              And::left(ty_then_equal(ty_compare(ha, hb), ty_compare(xa, xb), e))
            )
          ),
          Eq::congr(
            (z: Ty) => TyApp(hb, z),
            ty_compare_eq(
              xa,
              xb,
              And::right(ty_then_equal(ty_compare(ha, hb), ty_compare(xa, xb), e))
            )
          )
        )
      }
    }
  }
}

pub fn ty_eq_step(o: Ordering): Bool {
  ⊢ Bool from match o {
    Equal => true
    _ => false
  }
}

pub theorem ty_eq_sound(a: Ty, b: Ty, e: ty_eq(a, b) = true): a = b {
  ty_compare_eq(
    a,
    b,
    Ordering::cases(
      (o: Ordering) => o = Equal,
      ty_compare(a, b),
      (q: ty_compare(a, b) = Less) => False::elim(
        false_ne_true(Eq::subst((o: Ordering) => ty_eq_step(o) = true, q, e))
      ),
      (q: ty_compare(a, b) = Equal) => Refl,
      (q: ty_compare(a, b) = Greater) => False::elim(
        false_ne_true(Eq::subst((o: Ordering) => ty_eq_step(o) = true, q, e))
      )
    )
  )
}
