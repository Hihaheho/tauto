import "record_frame.taut"
import "expr_access_error_sound.taut"
import "../../surface/src/surface.taut"

pub theorem record_missing_name_frame_errors(
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan,
  fieldname: Option(Text)
): CkErrorFrame(c, record_missing_name(c, name, seen, span, fieldname)) {
  match fieldname: CkErrorFrame(c, record_missing_name(c, name, seen, span, fieldname)) {
    None => (clean_errors => clean_errors)
    Some(n) => frame_error_if_ok_errors(
      c,
      cat4("field `", n, "` of ", cat2(name, " is missing")),
      span,
      not(list_has_text(seen, n))
    )
  }
}

pub theorem ck_record_missing_one_frame_errors(
  c: Checker,
  name: Text,
  f: DataField,
  seen: List(Text),
  span: TySpan
): CkErrorFrame(c, ck_record_missing_one(c, name, f, seen, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(record_missing_one_unf(c, name, f, seen, span)),
    record_missing_name_frame_errors(c, name, seen, span, record_data_name(f))
  )
}

pub theorem record_missing_cons_frame_errors(
  f: DataField,
  rest: List(DataField),
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan,
  ih: ∀ next: Checker. CkErrorFrame(next, ck_record_missing(rest, next, name, seen, span))
): CkErrorFrame(c, record_missing_cons(f, rest, c, name, seen, span)) {
  error_frame_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_record_missing(rest, c1, name, seen, span)),
    ck_record_missing_one(c, name, f, seen, span),
    ck_record_missing_one_frame_errors(c, name, f, seen, span),
    ignored => c1 => error_frame_rewrap(c1, ck_record_missing(rest, c1, name, seen, span), ih(c1))
  )
}

pub theorem ck_record_missing_frame_errors(
  fs: List(DataField),
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan
): CkErrorFrame(c, ck_record_missing(fs, c, name, seen, span)) {
  match fs: CkErrorFrame(c, ck_record_missing(fs, c, name, seen, span)) {
    Nil => (clean_errors => clean_errors)
    Cons(f, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
      Eq::sym(record_missing_cons_unf(f, rest, c, name, seen, span)),
      record_missing_cons_frame_errors(
        f,
        rest,
        c,
        name,
        seen,
        span,
        next => ck_record_missing_frame_errors(rest, next, name, seen, span)
      )
    )
  }
}
pub theorem ck_top_level_only_frame_errors(
  c: Checker,
  message: Text,
  start: Nat,
  end: Nat
): CkErrorFrame(
  c,
  ck_top_level_only(c, message, start, end)
) { (clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))) }

pub theorem record_stmt_label_frame_errors(
  c: Checker,
  what: Text,
  start: Nat,
  end: Nat,
  label: Bool
): CkErrorFrame(c, record_stmt_label(c, what, start, end, label)) {
  match label: CkErrorFrame(c, record_stmt_label(c, what, start, end, label)) {
    true => (clean_errors => clean_errors)
    false => error_frame_rewrap(
      c,
      ck_top_level_only(c, cat2("not supported yet: ", what), start, end),
      ck_top_level_only_frame_errors(c, cat2("not supported yet: ", what), start, end)
    )
  }
}

pub theorem ck_stmt_other_frame_errors(
  c: Checker,
  s: SurfaceStmt
): CkErrorFrame(c, ck_stmt_other(c, s)) {
  match s: CkErrorFrame(c, ck_stmt_other(c, s)) {
    StLet(pat_name, pat_ty, pat_value, pat_borrow, pat_mutable) => (clean_errors => clean_errors)
    StVar(pat_name, pat_ty, pat_value, pat_borrow) => (clean_errors => clean_errors)
    StModule(pat_name, pat_stmts, pat_start, pat_end) => (clean_errors => clean_errors)
    StAssign(pat_name, pat_name_place, pat_value) => (clean_errors => clean_errors)
    StCalled(pat_name_generates, pat_value) => (clean_errors => clean_errors)
    StFn(pat_f) => (clean_errors => clean_errors)
    StTheorem(pat_t) => (clean_errors => clean_errors)
    StDef(pat_t) => (clean_errors => clean_errors)
    StMutual(pat_stmts, pat_start, pat_end) => (clean_errors => clean_errors)
    StImport(pat_path, pat_start, pat_end) => (clean_errors => clean_errors)
    StInductive(pat_i) => (clean_errors => clean_errors)
    StEffect(pat_e) => (clean_errors => clean_errors)
    StStruct(pat_d) => (
      clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))
    )
    StEnum(pat_d) => (
      clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))
    )
    StExtern(pat_abi, pat_fns, pat_start, pat_end) => (
      clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))
    )
    StClass(pat_c) => (clean_errors => clean_errors)
    StInstance(pat_i) => (clean_errors => clean_errors)
    StWhile(pat_cond, pat_body) => (clean_errors => clean_errors)
    StReturn(pat_value) => (clean_errors => clean_errors)
    StExpr(pat_value) => (clean_errors => clean_errors)
    StOther(what, start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, what, start, end)),
      record_stmt_label_frame_errors(c, what, start, end, Text::eq(what, "LabelDecl"))
    )
    StMacro(pat_name, pat_function, pat_start, pat_end) => (
      clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => (
      clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))
    )
    StSyntax(pat_name, pat_grammar, pat_start, pat_end) => (
      clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors)))
    )
  }
}
