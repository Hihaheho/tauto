import "coerce_sound.taut"
import "expect_sound.taut"
import std::text
import "checker.taut"
import "checker_frame.taut"
import "datas_frame.taut"
import "diagnostic_sound.taut"
import "fits_sound.taut"
import "fits_sound_head.taut"
import "ty.taut"
import "unify_sound.taut"

pub theorem expect_refused_grows(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  m: Mut1(Option(CoerceFound), Checker),
  grows: Grows(c, ck_st(m)),
  clean: DiagnosticClean(
    ck_st(
      frame_bind(
        <A: Option(CoerceFound), B: Unit>,
        (found: Option(CoerceFound), next: Checker) => run_expect_refused(next, a, b, span, what, found),
        m
      )
    )
  )
): Grows(
  c,
  ck_st(
    frame_bind(
      <A: Option(CoerceFound), B: Unit>,
      (found: Option(CoerceFound), next: Checker) => run_expect_refused(next, a, b, span, what, found),
      m
    )
  )
) {
  ⊢ Grows(
    c,
    ck_st(
      frame_bind(
        <A: Option(CoerceFound), B: Unit>,
        (found: Option(CoerceFound), next: Checker) => run_expect_refused(next, a, b, span, what, found),
        m
      )
    )
  ) from match m {
    mut1(found, next) => Eq::subst(
      (after: Checker) => Grows(c, after),
      Eq::sym(
        Eq::congr(
          (result: Mut1(Unit, Checker)) => ck_st(result),
          error_if_clean_identity(
            next,
            coerce_refusal(next, a, b, what, found),
            span,
            coerce_refused(next, found),
            clean
          )
        )
      ),
      grows
    )
  }
}
pub theorem expect_after_grows(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  fits: Bool,
  ordered: CkOrdered(c),
  clean: DiagnosticClean(ck_st(run_expect_after(c, a, b, span, what, fits)))
): Grows(c, ck_st(run_expect_after(c, a, b, span, what, fits))) {
  match fits {
    true => grows_refl(c, ordered)
    false => expect_refused_grows(
      c,
      a,
      b,
      span,
      what,
      ck_coerce_fit(c, a, b),
      ck_coerce_fit_grows(c, a, b, ordered),
      clean
    )
  }
}
pub theorem expect_bind_grows(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  m: Mut1(Bool, Checker),
  grows: Grows(c, ck_st(m)),
  clean: DiagnosticClean(
    ck_st(
      frame_bind(
        <A: Bool, B: Unit>,
        (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits),
        m
      )
    )
  )
): Grows(
  c,
  ck_st(
    frame_bind(
      <A: Bool, B: Unit>,
      (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits),
      m
    )
  )
) {
  ⊢ Grows(
    c,
    ck_st(
      frame_bind(
        <A: Bool, B: Unit>,
        (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits),
        m
      )
    )
  ) from match m {
    mut1(value, state) => grows_trans(
      c,
      state,
      ck_st(run_expect_after(state, a, b, span, what, value)),
      grows,
      expect_after_grows(state, a, b, span, what, value, And::left(grows), clean)
    )
  }
}
pub theorem ck_expect_grows(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  ordered: CkOrdered(c),
  clean: DiagnosticClean(ck_st(ck_expect(c, a, b, span, what)))
): Grows(c, ck_st(ck_expect(c, a, b, span, what))) {
  let expanded: DiagnosticClean(
    ck_st(run_expect(c, a, b, span, what))
  ) := Eq::subst(
    (m: Mut1(Unit, Checker)) => DiagnosticClean(ck_st(m)),
    run_expect_unf(c, a, b, span, what),
    clean
  )
  Eq::subst(
    (m: Mut1(Unit, Checker)) => Grows(c, ck_st(m)),
    Eq::sym(run_expect_unf(c, a, b, span, what)),
    expect_bind_grows(
      c,
      a,
      b,
      span,
      what,
      ck_fits_wide(c, a, b),
      And::left(ck_fits_wide_ok(c, a, b)(ordered)),
      expanded
    )
  )
}
