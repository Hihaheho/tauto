pub theorem written_fn_kind_equal<params: List(
  Ty
), result: Ty, original: Kind, other_params: List(
  Ty
), other_result: Ty, other_original: Kind>(
  equal: TyFn(params, result, original) = TyFn(other_params, other_result, other_original),
  kind: Kind,
  other_kind: Kind,
  annotation: kind = other_kind
): TyFn(params, result, kind) = TyFn(other_params, other_result, other_kind) {
  match equal {
    Refl => Eq::congr((k: Kind) => TyFn(params, result, k), annotation)
  }
}
pub theorem written_unique_fn_kind<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, spelling: Text, body: SurfaceTerm, other: Ty>(
  meaning: WrittenKind(env, generics, partial, r#borrow, SkFnKind(spelling, body), other),
  params: List(Ty),
  result: Ty,
  original: Kind,
  kind: Kind,
  ih: WrittenTermUnique(generics, partial, false, body, TyFn(params, result, original)),
  annotation: WrittenFunctionKind(spelling, kind)
): TyFn(params, result, kind) = other {
  match meaning {
    WrittenKindFunctionKind(gs, mode, borrowing, label, term, other_params, other_result, other_original, other_kind, function, other_annotation) => written_fn_kind_equal(
      ih(env, TyFn(other_params, other_result, other_original), function),
      kind,
      other_kind,
      Eq::trans(
        Eq::sym(written_function_kind_determined(annotation)),
        written_function_kind_determined(other_annotation)
      )
    )
  }
}
pub theorem written_unique_function<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, params: List(
  SurfaceParam
), result: SurfaceTerm, effects: Option(
  List(RowEntry)
), other: Ty>(
  meaning: WrittenKind(env, generics, partial, r#borrow, SkPi(params, result, effects), other),
  binders: List(Text × Kind),
  suffix: List(SurfaceParam),
  inner: Ordmap(Text, Ty),
  arguments: List(Ty),
  returns: Ty,
  t: Ty,
  split: WrittenBindersPrefix(params, binders, suffix),
  scope: WrittenBinderMap(binders, generics, inner),
  polymorphic: WrittenPolymorphicType(binders, TyFn(arguments, returns, KindShared), t),
  ihparams: WrittenParametersUnique(inner, partial, suffix, arguments),
  ihresult: WrittenTermUnique(inner, partial, false, result, returns)
): t = other {
  match meaning {
    WrittenKindFunction(gs, mode, borrowing, source_params, source_result, source_effects, other_binders, other_suffix, other_inner, other_arguments, other_returns, value, other_split, other_scope, parameter_types, result_type, other_polymorphic) => {
      let prefixes: Eq(
        List(Text × Kind) × List(SurfaceParam),
        #(binders, suffix),
        #(other_binders, other_suffix)
      ) := Eq::trans(
        Eq::sym(written_prefix_determined(<params: source_params, binders: binders, suffix: suffix>, split)),
        written_prefix_determined(<params: source_params, binders: other_binders, suffix: other_suffix>, other_split)
      )
      let scopes: inner = other_inner := Eq::trans(
        Eq::sym(written_binder_map_value(<binders: binders, initial: gs, final: inner>, scope)),
        Eq::trans(
          Eq::congr(
            (bs: List(Text × Kind)) => binders_map(bs, gs),
            Eq::congr(written_binders_prefix, prefixes)
          ),
          written_binder_map_value(<binders: other_binders, initial: gs, final: other_inner>, other_scope)
        )
      )
      let parameter_values: arguments = other_arguments := ihparams(
        env,
        other_arguments,
        Eq::subst(
          (map: Ordmap(Text, Ty)) => WrittenParameters(env, map, mode, suffix, other_arguments),
          Eq::sym(scopes),
          Eq::subst(
            (remaining: List(SurfaceParam)) => WrittenParameters(
              env,
              other_inner,
              mode,
              remaining,
              other_arguments
            ),
            Eq::sym(Eq::congr(written_binders_suffix, prefixes)),
            parameter_types
          )
        )
      )
      let result_value: returns = other_returns := ihresult(
        env,
        other_returns,
        Eq::subst(
          (map: Ordmap(Text, Ty)) => WrittenTerm(
            env,
            map,
            mode,
            false,
            source_result,
            other_returns
          ),
          Eq::sym(scopes),
          result_type
        )
      )
      let functions: TyFn(
        arguments,
        returns,
        KindShared
      ) = TyFn(
        other_arguments,
        other_returns,
        KindShared
      ) := Eq::trans(
        Eq::congr(
          (ps: List(Ty)) => TyFn(ps, returns, KindShared),
          parameter_values
        ),
        Eq::congr(
          (r: Ty) => TyFn(other_arguments, r, KindShared),
          result_value
        )
      )
      Eq::trans(
        Eq::sym(written_poly_value(polymorphic)),
        Eq::trans(
          Eq::congr((body_type: Ty) => ty_poly_of(binders, body_type), functions),
          Eq::trans(
            Eq::congr(
              (bs: List(Text × Kind)) => ty_poly_of(
                bs,
                TyFn(other_arguments, other_returns, KindShared)
              ),
              Eq::congr(written_binders_prefix, prefixes)
            ),
            written_poly_value(other_polymorphic)
          )
        )
      )
    }
  }
}
