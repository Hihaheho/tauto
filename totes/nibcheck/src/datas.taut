import "ty.taut"
import std::Base
import std::Map
import std::Text
import "../../surface/src/surface.taut"
import "../../text/src/text.taut"

// The declared `struct`s and `enum`s, and the kinds of types over them
// (`Datas` and `Data` of `types.rs`), in the proof language
// (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」).

pub(open) inductive DataField: Type {
  DataFieldMk(name: Option(Text), ty: Ty): DataField
}

pub(open) inductive DataCtor: Type {
  DataCtorMk(name: Text, fields: List(DataField)): DataCtor
}

// A declared `struct` (one constructor, named as the type) or `enum`.
pub(open) inductive Data: Type {
  DataMk(
    name: Text,
    declared: Option(Kind),
    generics: List(Text),
    constructors: List(DataCtor),
    is_struct: Bool,
    // It holds itself, directly or through other declarations.
    recursive: Bool,
    // `kind(D(args))` is `base` joined with the kinds of the arguments for
    // the generics in `holds` (`datas_summarize`).
    base: Kind,
    holds: List(Text),
    // Declared by the prelude and implemented by the evaluator.
    builtin: Bool,
    // A `view struct`: an extern type that holds a borrow.
    r#view: Bool
  ): Data
}

pub(open) inductive Datas: Type {
  DatasMk(
    decls: Ordmap(Text, Data),
    // A constructor's name (`Some`, `Shape::Circle`) to its type and index.
    ctors: Ordmap(Text, Pair(Text, Nat)),
    // Enough steps for the kinds of the types of the program.
    steps: Nat
  ): Datas
}

pub fn datas_empty(steps: Nat): Datas {
  Datas { decls: Ordmap::empty(), ctors: Ordmap::empty(), steps: steps }
}

pub fn datas_decl(d: Datas, name: Text): Option(Data) {
  Ordmap::get(d.decls, name, Ordmap::compare_text)
}

pub fn datas_ctor(d: Datas, name: Text): Option(Pair(Text, Nat)) {
  Ordmap::get(d.ctors, name, Ordmap::compare_text)
}

pub fn datas_named_ctor(cs: List(DataCtor), name: Text, index: Nat): Option(Nat) {
  ⊢ Option(Nat) from match cs {
    Nil => None
    Cons(c, rest) => ⊢ Option(Nat) from match c.name == name {
      true => Some(index)
      false => datas_named_ctor(rest, name, index + 1)
    }
  }
}

pub fn datas_ctor_candidates_in(ds: List(Pair(Text, Data)), name: Text): List(Pair(Text, Nat)) {
  ⊢ List(Pair(Text, Nat)) from match ds {
    Nil => Nil
    Cons(d, rest) => ⊢ List(Pair(Text, Nat)) from match datas_named_ctor(d.snd.constructors, name, 0) {
      None => datas_ctor_candidates_in(rest, name)
      Some(index) => Cons(Pair { fst: d.fst, snd: index }, datas_ctor_candidates_in(rest, name))
    }
  }
}

pub fn datas_ctor_candidates(d: Datas, name: Text): List(Pair(Text, Nat)) {
  datas_ctor_candidates_in(Ordmap::entries(d.decls), name)
}

pub fn datas_ctor_ambiguous(d: Datas, name: Text): Bool {
  ⊢ Bool from match datas_ctor_candidates(d, name) {
    Nil => false
    Cons(first, rest) => ⊢ Bool from match rest {
      Nil => false
      Cons(second, more) => true
    }
  }
}

pub fn constructor_result_owner(ty: Ty): Option(Text) {
  ⊢ Option(Text) from match ty {
    TyNamed(name, args) => Some(name)
    TyFn(params, result, kind) => constructor_result_owner(result)
    TyBorrow(inner, mutable) => constructor_result_owner(inner)
    _ => None
  }
}

pub fn constructor_candidate(cs: List(Pair(Text, Nat)), owner: Text): Option(Pair(Text, Nat)) {
  ⊢ Option(Pair(Text, Nat)) from match cs {
    Nil => None
    Cons(c, rest) => ⊢ Option(Pair(Text, Nat)) from match c.fst == owner {
      true => Some(c)
      false => constructor_candidate(rest, owner)
    }
  }
}

pub fn constructor_resolve(d: Datas, name: Text, expected: Ty): Option(Pair(Text, Nat)) {
  ⊢ Option(Pair(Text, Nat)) from match constructor_result_owner(expected) {
    None => None
    Some(owner) => constructor_candidate(datas_ctor_candidates(d, name), owner)
  }
}

pub fn constructor_names(cs: List(Pair(Text, Nat)), name: Text): List(Text) {
  ⊢ List(Text) from match cs {
    Nil => Nil
    Cons(c, rest) => Cons(cat3(c.fst, ".", name), constructor_names(rest, name))
  }
}

pub fn constructor_ambiguity_message(d: Datas, name: Text): Text {
  cat4(
    "ambiguous constructor `",
    name,
    "`: use a type annotation or ",
    text_join(constructor_names(datas_ctor_candidates(d, name), name), " or ")
  )
}

// Resolve an ambiguous name only from its expected result owner.
pub fn datas_ctor_expected(d: Datas, name: Text, expected: Ty): Option(Pair(Text, Nat)) {
  if datas_ctor_ambiguous(d, name) {
    constructor_resolve(d, name, expected)
  } else {
    datas_ctor(d, name)
  }
}

pub fn datas_ctor_error(d: Datas, name: Text): Text {
  if datas_ctor_ambiguous(d, name) {
    constructor_ambiguity_message(d, name)
  } else {
    cat2(name, " is not a constructor")
  }
}

pub fn nth_item<A>(xs: List(A), i: Nat): Option(A) {
  List::nth(xs, i)
}

pub fn list_len<A>(xs: List(A)): Nat {
  List::length(xs)
}

pub fn list_has_text(xs: List(Text), x: Text): Bool {
  ⊢ Bool from match xs {
    Nil => false
    Cons(y, rest) => y == x || list_has_text(rest, x)
  }
}

pub fn datas_constructor(d: Datas, name: Text, c: Nat): Option(DataCtor) {
  ⊢ Option(DataCtor) from match datas_decl(d, name) {
    None => None
    Some(data) => nth_item(data.constructors, c)
  }
}

pub fn data_instance_from(gs: List(Text), args: List(Ty), map: Ordmap(Text, Ty)): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match gs {
    Nil => map
    Cons(g, rest) => ⊢ Ordmap(Text, Ty) from match args {
      Nil => map
      Cons(a, more) => data_instance_from(
        rest,
        more,
        Ordmap::insert(map, g, a, Ordmap::compare_text)
      )
    }
  }
}

pub fn data_instance(d: Data, args: List(Ty)): Ordmap(Text, Ty) {
  data_instance_from(d.generics, args, Ordmap::empty())
}

pub fn fields_mention(fs: List(DataField), generic: Text): Bool {
  ⊢ Bool from match fs {
    Nil => false
    Cons(f, rest) => ty_param_in(f.ty, generic) || fields_mention(rest, generic)
  }
}

pub fn ctors_mention(cs: List(DataCtor), generic: Text): Bool {
  ⊢ Bool from match cs {
    Nil => false
    Cons(c, rest) => fields_mention(c.fields, generic) || ctors_mention(rest, generic)
  }
}

pub fn data_mentions(d: Data, generic: Text): Bool {
  ctors_mention(d.constructors, generic)
}

pub fn data_declared_kind(data: Data): Kind {
  ⊢ Kind from match data.declared {
    Some(k) => k
    None => KindCopy
  }
}

pub fn generics_picked(gs: List(Text), holds: List(Text)): List(Bool) {
  ⊢ List(Bool) from match gs {
    Nil => Nil
    Cons(g, rest) => Cons(list_has_text(holds, g), generics_picked(rest, holds))
  }
}

pub fn picks_head(every: Bool, picks: List(Bool)): Bool {
  ⊢ Bool from match picks {
    Nil => every
    Cons(p, rest) => every || p
  }
}

pub fn picks_tail(picks: List(Bool)): List(Bool) {
  ⊢ List(Bool) from match picks {
    Nil => Nil
    Cons(p, rest) => rest
  }
}

// `kind(T)` of `docs/design/ownership.md`, for a resolved type.
mutual {
  // `acc` joined with the kinds of `ts`: every one, or those `picks` picks
  // (a list of arguments stops with the generics).
  pub fn datas_kind_list(d: Datas, ts: List(Ty), every: Bool, picks: List(Bool), acc: Kind): Kind {
    ⊢ Kind from match ts {
      Nil => acc
      Cons(t, rest) => ⊢ Kind from match every || list_len(picks) != 0 {
        false => acc
        true => datas_kind_list(
          d,
          rest,
          every,
          picks_tail(picks),
          ⊢ Kind from match picks_head(every, picks) {
            true => kind_join(acc, datas_kind(d, t))
            false => acc
          }
        )
      }
    }
  }

  pub fn datas_kind(d: Datas, t: Ty): Kind {
    ⊢ Kind from match t {
      TyInt(w) => KindCopy
      TyBool => KindCopy
      TyUnit => KindCopy
      TyNever => KindCopy
      TyDecimal => KindCopy
      TyFloat => KindCopy
      TyText => KindShared
      TyFn(ps, r, fk) => fk
      TyUnion(ts) => datas_kind_list(d, ts, true, Nil, KindCopy)
      TyProduct(ts) => datas_kind_list(d, ts, true, Nil, KindCopy)
      TyTagged(tags, x) => datas_kind(d, x)
      TyBorrow(x, m) => datas_kind(d, x)
      TyParam(n, pk) => pk
      TyInfo(x) => KindAffine
      TyPoly(gs, x) => KindShared
      // What `F` makes is bounded by the kind `F` is declared with.
      TyApp(h, x) => ⊢ Kind from match h {
        TyParam(n, pk) => pk
        _ => KindCopy
      }
      // Not known yet: nothing is said of it.
      TyVar(v) => KindCopy
      TyNamed(n, args) => ⊢ Kind from match datas_decl(d, n) {
        None => KindShared
        Some(data) => datas_kind_list(
          d,
          args,
          false,
          generics_picked(data.generics, data.holds),
          data.base
        )
      }
    }
  }
}

pub fn texts_within(xs: List(Text), ys: List(Text)): Bool {
  ⊢ Bool from match xs {
    Nil => true
    Cons(x, rest) => list_has_text(ys, x) && texts_within(rest, ys)
  }
}

pub fn holds_add(holds: List(Text), n: Text): List(Text) {
  if list_has_text(holds, n) { holds } else { Cons(n, holds) }
}

pub fn kind_pair_join(
  acc: Pair(Kind, List(Text)),
  r: Pair(Kind, List(Text))
): Pair(Kind, List(Text)) {
  Pair { fst: kind_join(acc.fst, r.fst), snd: r.snd }
}

// The kind of field type `t` over `gs`, but for the arguments: the generics
// whose arguments count go into `holds` (`fst` the kind, `snd` the holds).
mutual {
  pub fn field_kind_list(
    d: Datas,
    ts: List(Ty),
    every: Bool,
    picks: List(Bool),
    gs: List(Text),
    acc: Pair(Kind, List(Text))
  ): Pair(Kind, List(Text)) {
    ⊢ Pair(Kind, List(Text)) from match ts {
      Nil => acc
      Cons(t, rest) => ⊢ Pair(Kind, List(Text)) from match every || list_len(picks) != 0 {
        false => acc
        true => field_kind_list(
          d,
          rest,
          every,
          picks_tail(picks),
          gs,
          ⊢ Pair(Kind, List(Text)) from match picks_head(every, picks) {
            true => kind_pair_join(acc, field_kind(d, t, gs, acc.snd))
            false => acc
          }
        )
      }
    }
  }

  pub fn field_kind(d: Datas, t: Ty, gs: List(Text), holds: List(Text)): Pair(Kind, List(Text)) {
    ⊢ Pair(Kind, List(Text)) from match t {
      TyParam(n, pk) => ⊢ Pair(Kind, List(Text)) from match list_has_text(gs, n) {
        true => Pair { fst: KindCopy, snd: holds_add(holds, n) }
        false => Pair { fst: pk, snd: holds }
      }
      // `F(X)`: what `F` makes holds at most what `F` and `X` do.
      TyApp(h, x) => kind_pair_join(
        field_kind(d, h, gs, holds),
        field_kind(d, x, gs, field_kind(d, h, gs, holds).snd)
      )
      TyUnion(ts) => field_kind_list(d, ts, true, Nil, gs, Pair { fst: KindCopy, snd: holds })
      TyProduct(ts) => field_kind_list(d, ts, true, Nil, gs, Pair { fst: KindCopy, snd: holds })
      TyTagged(tags, x) => field_kind(d, x, gs, holds)
      TyBorrow(x, m) => field_kind(d, x, gs, holds)
      // A generic written as a name, as `ty_substitute` reads it.
      TyNamed(n, args) => ⊢ Pair(Kind, List(Text)) from match ty_no_args(args) && list_has_text(gs, n) {
        true => Pair { fst: KindCopy, snd: holds_add(holds, n) }
        false => ⊢ Pair(Kind, List(Text)) from match datas_decl(d, n) {
          None => Pair { fst: KindShared, snd: holds }
          Some(data) => field_kind_list(
            d,
            args,
            false,
            generics_picked(data.generics, data.holds),
            gs,
            Pair { fst: data.base, snd: holds }
          )
        }
      }
      _ => Pair { fst: datas_kind(d, t), snd: holds }
    }
  }
}

pub fn fields_kind(
  d: Datas,
  fs: List(DataField),
  gs: List(Text),
  acc: Pair(Kind, List(Text))
): Pair(Kind, List(Text)) {
  ⊢ Pair(Kind, List(Text)) from match fs {
    Nil => acc
    Cons(f, rest) => fields_kind(d, rest, gs, kind_pair_join(acc, field_kind(d, f.ty, gs, acc.snd)))
  }
}

pub fn ctors_kind(
  d: Datas,
  cs: List(DataCtor),
  gs: List(Text),
  acc: Pair(Kind, List(Text))
): Pair(Kind, List(Text)) {
  ⊢ Pair(Kind, List(Text)) from match cs {
    Nil => acc
    Cons(c, rest) => ctors_kind(d, rest, gs, fields_kind(d, c.fields, gs, acc))
  }
}

pub fn data_with_summary(data: Data, base: Kind, holds: List(Text)): Data {
  Data {
    name: data.name,
    declared: data.declared,
    generics: data.generics,
    constructors: data.constructors,
    is_struct: data.is_struct,
    recursive: data.recursive,
    base: base,
    holds: holds,
    builtin: data.builtin,
    r#view: data.r#view
  }
}

pub fn datas_with_decls(d: Datas, decls: Ordmap(Text, Data)): Datas {
  Datas { decls: decls, ctors: d.ctors, steps: d.steps }
}

pub fn generics_unmentioned(data: Data, gs: List(Text)): List(Text) {
  ⊢ List(Text) from match gs {
    Nil => Nil
    Cons(g, rest) => ⊢ List(Text) from match data_mentions(data, g) {
      true => generics_unmentioned(data, rest)
      false => Cons(g, generics_unmentioned(data, rest))
    }
  }
}

// The least summary to start from: the declared kind, `shared` if recursive,
// and the generics no field mentions (`Vec(A)` holds its `A`s).
pub fn data_least(data: Data): Data {
  let declared := data_declared_kind(data)
  let own: Kind := if data.recursive { kind_join(declared, KindShared) } else { declared }
  data_with_summary(data, own, generics_unmentioned(data, data.generics))
}

// Out of steps: the safe summary, `linear` and holding every argument.
pub fn data_top(data: Data): Data {
  data_with_summary(data, KindLinear, data.generics)
}

pub fn datas_map_decls(
  es: List(Pair(Text, Data)),
  f: (Data) -> Data,
  acc: Ordmap(Text, Data)
): Ordmap(Text, Data) {
  ⊢ Ordmap(Text, Data) from match es {
    Nil => acc
    Cons(e, rest) => datas_map_decls(
      rest,
      f,
      Ordmap::insert(acc, e.fst, f(e.snd), Ordmap::compare_text)
    )
  }
}

pub fn datas_round(es: List(Pair(Text, Data)), d: Datas, grew: Bool): Pair(Datas, Bool) {
  ⊢ Pair(Datas, Bool) from match es {
    Nil => Pair { fst: d, snd: grew }
    Cons(e, rest) => ⊢ Pair(Datas, Bool) from match datas_decl(d, e.fst) {
      None => datas_round(rest, d, grew)
      Some(data) => {
        let r := ctors_kind(
          d,
          data.constructors,
          data.generics,
          Pair { fst: data.base, snd: data.holds }
        )
        let base := kind_join(data.base, r.fst)
        if kind_eq(base, data.base) && texts_within(r.snd, data.holds) {
          datas_round(rest, d, grew)
        } else {
          datas_round(
            rest,
            datas_with_decls(
              d,
              Ordmap::insert(
                d.decls,
                e.fst,
                data_with_summary(data, base, r.snd),
                Ordmap::compare_text
              )
            ),
            true
          )
        }
      }
    }
  }
}

pub fn datas_rounds(k: Nat, d: Datas): Datas {
  ⊢ Datas from match k {
    Zero => datas_with_decls(d, datas_map_decls(Ordmap::entries(d.decls), data_top, d.decls))
    Succ(j) => {
      let r := datas_round(Ordmap::entries(d.decls), d, false)
      if r.snd { datas_rounds(j, r.fst) } else { r.fst }
    }
  }
}

// Each declaration's `base` and `holds`: the least solution of
// `kind(D(args)) = join(declared(D), floor(D), kind(each field at args))` of
// `docs/design/ownership.md`, as a kind and the generics whose arguments count.
// A recursive declaration may meet itself at other arguments
// (`enum W(A) { Leaf(A), Node(W(F)) }`), which the least solution counts.
pub fn datas_summarize(d: Datas): Datas {
  datas_rounds(
    d.steps,
    datas_with_decls(d, datas_map_decls(Ordmap::entries(d.decls), data_least, d.decls))
  )
}

pub fn ty_in_list(xs: List(Ty), t: Ty): Bool {
  ⊢ Bool from match xs {
    Nil => false
    Cons(x, rest) => ty_eq(x, t) || ty_in_list(rest, t)
  }
}

pub fn class_is_structural(r#class: Text): Bool {
  r#class == "PartialEq" || r#class == "DecEq" || r#class == "Hash"
}

// `class` is assumed of the generic `n`: `DecEq` gives `PartialEq`.
pub fn class_assumed(assume: List(Pair(Text, Text)), r#class: Text, n: Text): Bool {
  ⊢ Bool from match assume {
    Nil => false
    Cons(a, rest) => if a.snd == n && (
      a.fst == r#class || (r#class == "PartialEq" && a.fst == "DecEq")
    ) {
      true
    } else {
      class_assumed(rest, r#class, n)
    }
  }
}

pub fn kind_is_affine_or_linear(k: Option(Kind)): Bool {
  ⊢ Bool from match k {
    Some(x) => ⊢ Bool from match x {
      KindAffine => true
      KindLinear => true
      _ => false
    }
    None => false
  }
}

pub fn ctors_all_empty(cs: List(DataCtor)): Bool {
  ⊢ Bool from match cs {
    Nil => true
    Cons(c, rest) => ⊢ Bool from match c.fields {
      Nil => ctors_all_empty(rest)
      Cons(f, more) => false
    }
  }
}

// A builtin type, or an affine or linear one without fields: what it holds is
// not seen.
pub fn data_hides_ctors(data: Data): Bool {
  data.builtin || (kind_is_affine_or_linear(data.declared) && ctors_all_empty(data.constructors))
}

// Whether `class` (`PartialEq`, `DecEq`, `Hash`) holds of `t`, given the
// `(class, generic)` pairs assumed. A type that holds
// itself is taken to have the class while its fields are checked.
// Exhaustion rejects the obligation: it is not evidence that fields were checked.
mutual {
  pub fn datas_structural_in(
    k: Nat,
    d: Datas,
    r#class: Text,
    t: Ty,
    assume: List(Pair(Text, Text)),
    visiting: List(Ty)
  ): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match t {
        TyInt(w) => true
        TyBool => true
        TyText => true
        TyUnit => true
        TyNever => true
        // NaN is not equal to itself, and a decimal's representation is not
        // settled.
        TyDecimal => r#class == "PartialEq"
        TyFloat => r#class == "PartialEq"
        TyFn(ps, r, fk) => false
        TyInfo(x) => false
        TyPoly(gs, x) => false
        // `F(X)`: nothing is known of what `F` makes.
        TyApp(h, x) => false
        TyUnion(ts) => datas_structural_all_in(j, d, r#class, ts, assume, visiting)
        TyProduct(ts) => datas_structural_all_in(j, d, r#class, ts, assume, visiting)
        TyTagged(tags, x) => datas_structural_in(j, d, r#class, x, assume, visiting)
        TyBorrow(x, m) => datas_structural_in(j, d, r#class, x, assume, visiting)
        TyParam(n, pk) => class_assumed(assume, r#class, n)
        // Not known yet: checked when it is.
        TyVar(v) => true
        TyNamed(n, args) => if n == "Buf" {
          true
        } else {
          ⊢ Bool from match datas_decl(d, n) {
            None => false
            Some(data) => if data.r#view || data_hides_ctors(data) {
              false
            } else if ty_in_list(visiting, TyNamed(n, args)) {
              true
            } else {
              datas_structural_ctors_in(
                j,
                d,
                r#class,
                data.constructors,
                data_instance(data, args),
                assume,
                Cons(TyNamed(n, args), visiting)
              )
            }
          }
        }
      }
    }
  }

  pub fn datas_structural_all_in(
    k: Nat,
    d: Datas,
    r#class: Text,
    ts: List(Ty),
    assume: List(Pair(Text, Text)),
    visiting: List(Ty)
  ): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => true
        Cons(t, rest) => datas_structural_in(
          j,
          d,
          r#class,
          t,
          assume,
          visiting
        ) && datas_structural_all_in(j, d, r#class, rest, assume, visiting)
      }
    }
  }

  pub fn datas_structural_ctors_in(
    k: Nat,
    d: Datas,
    r#class: Text,
    cs: List(DataCtor),
    map: Ordmap(Text, Ty),
    assume: List(Pair(Text, Text)),
    visiting: List(Ty)
  ): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match cs {
        Nil => true
        Cons(c, rest) => datas_structural_fields_in(
          j,
          d,
          r#class,
          c.fields,
          map,
          assume,
          visiting
        ) && datas_structural_ctors_in(j, d, r#class, rest, map, assume, visiting)
      }
    }
  }

  pub fn datas_structural_fields_in(
    k: Nat,
    d: Datas,
    r#class: Text,
    fs: List(DataField),
    map: Ordmap(Text, Ty),
    assume: List(Pair(Text, Text)),
    visiting: List(Ty)
  ): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match fs {
        Nil => true
        Cons(f, rest) => datas_structural_in(
          j,
          d,
          r#class,
          ty_substitute(f.ty, map),
          assume,
          visiting
        ) && datas_structural_fields_in(j, d, r#class, rest, map, assume, visiting)
      }
    }
  }
}

pub fn datas_structural(d: Datas, r#class: Text, t: Ty, assume: List(Pair(Text, Text))): Bool {
  datas_structural_in(d.steps, d, r#class, t, assume, Nil)
}

pub fn field_types(fs: List(DataField), map: Ordmap(Text, Ty)): List(Ty) {
  ⊢ List(Ty) from match fs {
    Nil => Nil
    Cons(f, rest) => Cons(ty_substitute(f.ty, map), field_types(rest, map))
  }
}

pub fn data_field_types(cs: List(DataCtor), map: Ordmap(Text, Ty)): List(Ty) {
  ⊢ List(Ty) from match cs {
    Nil => Nil
    Cons(c, rest) => List::append(field_types(c.fields, map), data_field_types(rest, map))
  }
}

pub fn datas_all_dup(d: Datas, ts: List(Ty)): Bool {
  ⊢ Bool from match ts {
    Nil => true
    Cons(t, rest) => kind_dup(datas_kind(d, t)) && datas_all_dup(d, rest)
  }
}

pub fn kind_is_affine_opt(k: Option(Kind)): Bool {
  ⊢ Bool from match k {
    Some(x) => kind_eq(x, KindAffine)
    None => false
  }
}

pub fn no_clone_of(t: Ty): Option(Text) {
  Some(ty_cat(Cons(ty_show(t), Cons(" has no clone", Nil))))
}

// Why `t` has no `clone`, when it has none: a `linear` type, an opaque one
// (declared `affine` and holding nothing affine of its own), or a function or
// `Info` that is not duplicable.
mutual {
  pub fn datas_no_clone_find(k: Nat, d: Datas, ts: List(Ty), visiting: List(Ty)): Option(Text) {
    ⊢ Option(Text) from match k {
      Zero => None
      Succ(j) => ⊢ Option(Text) from match ts {
        Nil => None
        Cons(t, rest) => ⊢ Option(Text) from match datas_no_clone_in(j, d, t, visiting) {
          Some(why) => Some(why)
          None => datas_no_clone_find(j, d, rest, visiting)
        }
      }
    }
  }

  pub fn datas_no_clone_named(
    k: Nat,
    d: Datas,
    t: Ty,
    data: Data,
    args: List(Ty),
    visiting: List(Ty)
  ): Option(Text) {
    ⊢ Option(Text) from match k {
      Zero => None
      Succ(j) => if data.builtin {
        datas_no_clone_find(j, d, args, Cons(t, visiting))
      } else {
        let fields := data_field_types(data.constructors, data_instance(data, args))
        if kind_is_affine_opt(data.declared) && datas_all_dup(d, fields) {
          no_clone_of(t)
        } else {
          datas_no_clone_find(j, d, fields, Cons(t, visiting))
        }
      }
    }
  }

  pub fn datas_no_clone_shape(
    k: Nat,
    d: Datas,
    t: Ty,
    whole: Ty,
    visiting: List(Ty)
  ): Option(Text) {
    ⊢ Option(Text) from match k {
      Zero => None
      Succ(j) => ⊢ Option(Text) from match t {
        TyNamed(n, args) => ⊢ Option(Text) from match datas_decl(d, n) {
          None => None
          Some(data) => datas_no_clone_named(j, d, whole, data, args, visiting)
        }
        TyUnion(ts) => datas_no_clone_find(j, d, ts, visiting)
        TyProduct(ts) => datas_no_clone_find(j, d, ts, visiting)
        TyTagged(tags, x) => datas_no_clone_in(j, d, x, visiting)
        _ => no_clone_of(whole)
      }
    }
  }

  pub fn datas_no_clone_in(k: Nat, d: Datas, t: Ty, visiting: List(Ty)): Option(Text) {
    ⊢ Option(Text) from match k {
      Zero => None
      Succ(j) => if ty_in_list(visiting, t) {
        None
      } else {
        let kind := datas_kind(d, t)
        if kind_eq(kind, KindLinear) {
          Some(ty_cat(Cons(ty_show(t), Cons(" is linear", Nil))))
        } else if kind_dup(kind) {
          None
        } else {
          datas_no_clone_shape(j, d, t, t, visiting)
        }
      }
    }
  }
}

pub fn datas_no_clone(d: Datas, t: Ty): Option(Text) {
  datas_no_clone_in(d.steps, d, t, Nil)
}

pub(open) inductive Positional: Type {
  PositionalOk(patterns: List(SurfacePattern)): Positional
  PositionalErr(message: Text): Positional
}

pub fn field_name_is(f: DataField, name: Text): Bool {
  ⊢ Bool from match f.name {
    Some(n) => n == name
    None => false
  }
}

pub fn field_declared(fs: List(DataField), name: Text): Bool {
  ⊢ Bool from match fs {
    Nil => false
    Cons(f, rest) => field_name_is(f, name) || field_declared(rest, name)
  }
}

pub fn pattern_field_find(fields: List(SurfacePatternField), name: Text): Option(SurfacePattern) {
  ⊢ Option(SurfacePattern) from match fields {
    Nil => None
    Cons(f, rest) => if f.name == name { Some(f.pattern) } else { pattern_field_find(rest, name) }
  }
}

pub fn positional_check(
  name: Text,
  declared: List(DataField),
  fields: List(SurfacePatternField)
): Option(Text) {
  ⊢ Option(Text) from match fields {
    Nil => None
    Cons(f, rest) => if field_declared(declared, f.name) {
      positional_check(name, declared, rest)
    } else {
      Some(ty_cat(Cons(name, Cons(" has no field `", Cons(f.name, Cons("`", Nil))))))
    }
  }
}

pub fn field_name_or_empty(f: DataField): Text {
  ⊢ Text from match f.name {
    Some(x) => x
    None => ""
  }
}

pub fn positional_cons(p: SurfacePattern, rest: Positional): Positional {
  ⊢ Positional from match rest {
    PositionalErr(e) => PositionalErr(e)
    PositionalOk(ps) => PositionalOk(Cons(p, ps))
  }
}

pub fn positional_collect(
  declared: List(DataField),
  fields: List(SurfacePatternField)
): Positional {
  ⊢ Positional from match declared {
    Nil => PositionalOk(Nil)
    Cons(f, rest) => ⊢ Positional from match pattern_field_find(fields, field_name_or_empty(f)) {
      None => PositionalErr(
        ty_cat(
          Cons("field `", Cons(field_name_or_empty(f), Cons("` is missing from the pattern", Nil)))
        )
      )
      Some(p) => positional_cons(p, positional_collect(rest, fields))
    }
  }
}

pub fn not_a_constructor(name: Text): Positional {
  PositionalErr(ty_cat(Cons(name, Cons(" is not a constructor", Nil))))
}

// A record pattern's patterns in the order of the struct's fields.
pub fn datas_positional(d: Datas, name: Text, fields: List(SurfacePatternField)): Positional {
  ⊢ Positional from match datas_ctor(d, name) {
    None => not_a_constructor(name)
    Some(dc) => ⊢ Positional from match datas_constructor(d, dc.fst, dc.snd) {
      None => not_a_constructor(name)
      Some(ctor) => ⊢ Positional from match positional_check(name, ctor.fields, fields) {
        Some(e) => PositionalErr(e)
        None => positional_collect(ctor.fields, fields)
      }
    }
  }
}

// A record pattern's patterns in the order of the struct's fields.
pub fn datas_positional_expected(
  d: Datas,
  name: Text,
  fields: List(SurfacePatternField),
  expected: Ty
): Positional {
  ⊢ Positional from match datas_ctor_expected(d, name, expected) {
    None => PositionalErr(datas_ctor_error(d, name))
    Some(dc) => ⊢ Positional from match datas_constructor(d, dc.fst, dc.snd) {
      None => PositionalErr(datas_ctor_error(d, name))
      Some(ctor) => ⊢ Positional from match positional_check(name, ctor.fields, fields) {
        Some(e) => PositionalErr(e)
        None => positional_collect(ctor.fields, fields)
      }
    }
  }
}

pub fn substituted_fields(fs: List(DataField), map: Ordmap(Text, Ty)): List(DataField) {
  ⊢ List(DataField) from match fs {
    Nil => Nil
    Cons(f, rest) => Cons(
      DataField { name: f.name, ty: ty_substitute(f.ty, map) },
      substituted_fields(rest, map)
    )
  }
}

pub fn datas_fields(d: Datas, dname: Text, c: Nat, args: List(Ty)): List(DataField) {
  ⊢ List(DataField) from match datas_decl(d, dname) {
    None => Nil
    Some(data) => ⊢ List(DataField) from match nth_item(data.constructors, c) {
      None => Nil
      Some(ctor) => substituted_fields(ctor.fields, data_instance(data, args))
    }
  }
}

pub(open) inductive Reach: Type {
  ReachMk(found: Bool, seen: Ordmap(Text, Bool)): Reach
}

pub fn fields_named(fs: List(DataField), out: List(Text)): List(Text) {
  ⊢ List(Text) from match fs {
    Nil => out
    Cons(f, rest) => fields_named(rest, ty_named_in(f.ty, out))
  }
}

pub fn data_named(cs: List(DataCtor), out: List(Text)): List(Text) {
  ⊢ List(Text) from match cs {
    Nil => out
    Cons(c, rest) => data_named(rest, fields_named(c.fields, out))
  }
}

// Whether declaration `from` holds `target` through its fields; a step for
// each declaration and each name.
mutual {
  pub fn datas_reaches(
    k: Nat,
    d: Datas,
    r#from: Text,
    target: Text,
    seen: Ordmap(Text, Bool)
  ): Reach {
    ⊢ Reach from match k {
      Zero => Reach { found: false, seen: seen }
      Succ(j) => ⊢ Reach from match datas_decl(d, r#from) {
        None => Reach { found: false, seen: seen }
        Some(data) => if Ordmap::contains(seen, r#from, Ordmap::compare_text) {
          Reach { found: false, seen: seen }
        } else {
          reach_any(
            j,
            d,
            data_named(data.constructors, Nil),
            target,
            Ordmap::insert(seen, r#from, true, Ordmap::compare_text)
          )
        }
      }
    }
  }

  pub fn reach_next(k: Nat, d: Datas, r: Reach, rest: List(Text), target: Text): Reach {
    ⊢ Reach from match k {
      Zero => r
      Succ(j) => if r.found { r } else { reach_any(j, d, rest, target, r.seen) }
    }
  }

  pub fn reach_any(
    k: Nat,
    d: Datas,
    names: List(Text),
    target: Text,
    seen: Ordmap(Text, Bool)
  ): Reach {
    ⊢ Reach from match k {
      Zero => Reach { found: false, seen: seen }
      Succ(j) => ⊢ Reach from match names {
        Nil => Reach { found: false, seen: seen }
        Cons(n, rest) => if n == target {
          Reach { found: true, seen: seen }
        } else {
          reach_next(j, d, datas_reaches(j, d, n, target, seen), rest, target)
        }
      }
    }
  }
}

pub fn datas_reaches_from(d: Datas, r#from: Text, target: Text): Bool {
  datas_reaches(d.steps, d, r#from, target, Ordmap::empty()).found
}

pub fn bool_or_opt(found: Option(Bool), m: Bool): Option(Bool) {
  ⊢ Option(Bool) from match found {
    Some(f) => Some(f || m)
    None => Some(m)
  }
}

pub fn data_is_view(d: Datas, n: Text): Bool {
  ⊢ Bool from match datas_decl(d, n) {
    Some(data) => data.r#view
    None => false
  }
}

// Whether a type holds a borrow of something that is not duplicable (a shared
// borrow of a duplicable value is the value): `some(true)` when the borrow is
// `&mut`.
mutual {
  pub fn datas_view_borrow_each(d: Datas, ts: List(Ty), found: Option(Bool)): Option(Bool) {
    ⊢ Option(Bool) from match ts {
      Nil => found
      Cons(t, rest) => ⊢ Option(Bool) from match datas_view_borrow(d, t) {
        None => datas_view_borrow_each(d, rest, found)
        Some(m) => datas_view_borrow_each(d, rest, bool_or_opt(found, m))
      }
    }
  }

  pub fn datas_view_borrow(d: Datas, t: Ty): Option(Bool) {
    ⊢ Option(Bool) from match t {
      TyBorrow(inner, m) => if m || not(kind_dup(datas_kind(d, inner))) { Some(m) } else { None }
      TyNamed(n, args) => if data_is_view(d, n) {
        Some(true)
      } else if n == "Option" || n == "Result" || n == "Pair" {
        datas_view_borrow_each(d, args, None)
      } else {
        None
      }
      _ => None
    }
  }
}
