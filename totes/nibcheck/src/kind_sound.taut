import "union_sound.taut"
import "product_sound.taut"
import "datas.taut"
import std::Text

// The kinds `datas_kind` gives are sound (`docs/design/self-host.md`
// 「層 3：種（`src/kind_sound.taut`）」): once the declarations are summarized,
// the kind of `D(args)` is at least the kind of each of its fields at `args`,
// of `declared(D)`, of `floor(D)` and of each argument no field mentions. These are the equations
// of `kind(T)` in `docs/design/ownership.md` as inequalities, so the kinds are
// above their least solution, the kinds the document means.

// ----- the order of kinds -----

pub def KLe(a: Kind, b: Kind): Prop := kind_join(a, b) = b

pub theorem kind_ne(
  a: Kind,
  b: Kind,
  e: a = b,
  h: Nat::eq(kind_rank(a), kind_rank(b)) = false
): False {
  ty_nat_ne(kind_rank(a), kind_rank(b), Eq::congr(kind_rank, e), h)
}

pub theorem kle_trans(a: Kind, b: Kind, c: Kind, h1: KLe(a, b), h2: KLe(b, c)): KLe(a, c) {
  match a: (KLe(a, b)) -> (KLe(b, c)) -> KLe(a, c) {
    KindCopy => match b: (KLe(KindCopy, b)) -> (KLe(b, c)) -> KLe(KindCopy, c) {
      KindCopy => match c: (KLe(KindCopy, KindCopy)) -> (KLe(KindCopy, c)) -> KLe(KindCopy, c) {
        KindCopy => (x: KLe(KindCopy, KindCopy)) => (y: KLe(KindCopy, KindCopy)) => Refl
        KindShared => (x: KLe(KindCopy, KindCopy)) => (y: KLe(KindCopy, KindShared)) => Refl
        KindAffine => (x: KLe(KindCopy, KindCopy)) => (y: KLe(KindCopy, KindAffine)) => Refl
        KindLinear => (x: KLe(KindCopy, KindCopy)) => (y: KLe(KindCopy, KindLinear)) => Refl
      }
      KindShared => match c: (
        KLe(KindCopy, KindShared)
      ) -> (KLe(KindShared, c)) -> KLe(KindCopy, c) {
        KindCopy => (x: KLe(KindCopy, KindShared)) => (y: KLe(KindShared, KindCopy)) => False::elim(
          kind_ne(KindShared, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindCopy, KindShared)) => (y: KLe(KindShared, KindShared)) => Refl
        KindAffine => (x: KLe(KindCopy, KindShared)) => (y: KLe(KindShared, KindAffine)) => Refl
        KindLinear => (x: KLe(KindCopy, KindShared)) => (y: KLe(KindShared, KindLinear)) => Refl
      }
      KindAffine => match c: (
        KLe(KindCopy, KindAffine)
      ) -> (KLe(KindAffine, c)) -> KLe(KindCopy, c) {
        KindCopy => (x: KLe(KindCopy, KindAffine)) => (y: KLe(KindAffine, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindCopy, KindAffine)) => (
          y: KLe(KindAffine, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, y, Refl))
        KindAffine => (x: KLe(KindCopy, KindAffine)) => (y: KLe(KindAffine, KindAffine)) => Refl
        KindLinear => (x: KLe(KindCopy, KindAffine)) => (y: KLe(KindAffine, KindLinear)) => Refl
      }
      KindLinear => match c: (
        KLe(KindCopy, KindLinear)
      ) -> (KLe(KindLinear, c)) -> KLe(KindCopy, c) {
        KindCopy => (x: KLe(KindCopy, KindLinear)) => (y: KLe(KindLinear, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindCopy, KindLinear)) => (
          y: KLe(KindLinear, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, y, Refl))
        KindAffine => (x: KLe(KindCopy, KindLinear)) => (
          y: KLe(KindLinear, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, y, Refl))
        KindLinear => (x: KLe(KindCopy, KindLinear)) => (y: KLe(KindLinear, KindLinear)) => Refl
      }
    }
    KindShared => match b: (KLe(KindShared, b)) -> (KLe(b, c)) -> KLe(KindShared, c) {
      KindCopy => match c: (
        KLe(KindShared, KindCopy)
      ) -> (KLe(KindCopy, c)) -> KLe(KindShared, c) {
        KindCopy => (x: KLe(KindShared, KindCopy)) => (y: KLe(KindCopy, KindCopy)) => False::elim(
          kind_ne(KindShared, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindShared, KindCopy)) => (y: KLe(KindCopy, KindShared)) => False::elim(
          kind_ne(KindShared, KindCopy, x, Refl)
        )
        KindAffine => (x: KLe(KindShared, KindCopy)) => (y: KLe(KindCopy, KindAffine)) => False::elim(
          kind_ne(KindShared, KindCopy, x, Refl)
        )
        KindLinear => (x: KLe(KindShared, KindCopy)) => (y: KLe(KindCopy, KindLinear)) => False::elim(
          kind_ne(KindShared, KindCopy, x, Refl)
        )
      }
      KindShared => match c: (
        KLe(KindShared, KindShared)
      ) -> (KLe(KindShared, c)) -> KLe(KindShared, c) {
        KindCopy => (x: KLe(KindShared, KindShared)) => (y: KLe(KindShared, KindCopy)) => False::elim(
          kind_ne(KindShared, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindShared, KindShared)) => (y: KLe(KindShared, KindShared)) => Refl
        KindAffine => (x: KLe(KindShared, KindShared)) => (y: KLe(KindShared, KindAffine)) => Refl
        KindLinear => (x: KLe(KindShared, KindShared)) => (y: KLe(KindShared, KindLinear)) => Refl
      }
      KindAffine => match c: (
        KLe(KindShared, KindAffine)
      ) -> (KLe(KindAffine, c)) -> KLe(KindShared, c) {
        KindCopy => (x: KLe(KindShared, KindAffine)) => (y: KLe(KindAffine, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindShared, KindAffine)) => (
          y: KLe(KindAffine, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, y, Refl))
        KindAffine => (x: KLe(KindShared, KindAffine)) => (y: KLe(KindAffine, KindAffine)) => Refl
        KindLinear => (x: KLe(KindShared, KindAffine)) => (y: KLe(KindAffine, KindLinear)) => Refl
      }
      KindLinear => match c: (
        KLe(KindShared, KindLinear)
      ) -> (KLe(KindLinear, c)) -> KLe(KindShared, c) {
        KindCopy => (x: KLe(KindShared, KindLinear)) => (y: KLe(KindLinear, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindShared, KindLinear)) => (
          y: KLe(KindLinear, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, y, Refl))
        KindAffine => (x: KLe(KindShared, KindLinear)) => (
          y: KLe(KindLinear, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, y, Refl))
        KindLinear => (x: KLe(KindShared, KindLinear)) => (y: KLe(KindLinear, KindLinear)) => Refl
      }
    }
    KindAffine => match b: (KLe(KindAffine, b)) -> (KLe(b, c)) -> KLe(KindAffine, c) {
      KindCopy => match c: (
        KLe(KindAffine, KindCopy)
      ) -> (KLe(KindCopy, c)) -> KLe(KindAffine, c) {
        KindCopy => (x: KLe(KindAffine, KindCopy)) => (y: KLe(KindCopy, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindAffine, KindCopy)) => (y: KLe(KindCopy, KindShared)) => False::elim(
          kind_ne(KindAffine, KindCopy, x, Refl)
        )
        KindAffine => (x: KLe(KindAffine, KindCopy)) => (y: KLe(KindCopy, KindAffine)) => False::elim(
          kind_ne(KindAffine, KindCopy, x, Refl)
        )
        KindLinear => (x: KLe(KindAffine, KindCopy)) => (y: KLe(KindCopy, KindLinear)) => False::elim(
          kind_ne(KindAffine, KindCopy, x, Refl)
        )
      }
      KindShared => match c: (
        KLe(KindAffine, KindShared)
      ) -> (KLe(KindShared, c)) -> KLe(KindAffine, c) {
        KindCopy => (x: KLe(KindAffine, KindShared)) => (y: KLe(KindShared, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindShared, x, Refl)
        )
        KindShared => (x: KLe(KindAffine, KindShared)) => (
          y: KLe(KindShared, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, x, Refl))
        KindAffine => (x: KLe(KindAffine, KindShared)) => (
          y: KLe(KindShared, KindAffine)
        ) => False::elim(kind_ne(KindAffine, KindShared, x, Refl))
        KindLinear => (x: KLe(KindAffine, KindShared)) => (
          y: KLe(KindShared, KindLinear)
        ) => False::elim(kind_ne(KindAffine, KindShared, x, Refl))
      }
      KindAffine => match c: (
        KLe(KindAffine, KindAffine)
      ) -> (KLe(KindAffine, c)) -> KLe(KindAffine, c) {
        KindCopy => (x: KLe(KindAffine, KindAffine)) => (y: KLe(KindAffine, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindAffine, KindAffine)) => (
          y: KLe(KindAffine, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, y, Refl))
        KindAffine => (x: KLe(KindAffine, KindAffine)) => (y: KLe(KindAffine, KindAffine)) => Refl
        KindLinear => (x: KLe(KindAffine, KindAffine)) => (y: KLe(KindAffine, KindLinear)) => Refl
      }
      KindLinear => match c: (
        KLe(KindAffine, KindLinear)
      ) -> (KLe(KindLinear, c)) -> KLe(KindAffine, c) {
        KindCopy => (x: KLe(KindAffine, KindLinear)) => (y: KLe(KindLinear, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindAffine, KindLinear)) => (
          y: KLe(KindLinear, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, y, Refl))
        KindAffine => (x: KLe(KindAffine, KindLinear)) => (
          y: KLe(KindLinear, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, y, Refl))
        KindLinear => (x: KLe(KindAffine, KindLinear)) => (y: KLe(KindLinear, KindLinear)) => Refl
      }
    }
    KindLinear => match b: (KLe(KindLinear, b)) -> (KLe(b, c)) -> KLe(KindLinear, c) {
      KindCopy => match c: (
        KLe(KindLinear, KindCopy)
      ) -> (KLe(KindCopy, c)) -> KLe(KindLinear, c) {
        KindCopy => (x: KLe(KindLinear, KindCopy)) => (y: KLe(KindCopy, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindLinear, KindCopy)) => (y: KLe(KindCopy, KindShared)) => False::elim(
          kind_ne(KindLinear, KindCopy, x, Refl)
        )
        KindAffine => (x: KLe(KindLinear, KindCopy)) => (y: KLe(KindCopy, KindAffine)) => False::elim(
          kind_ne(KindLinear, KindCopy, x, Refl)
        )
        KindLinear => (x: KLe(KindLinear, KindCopy)) => (y: KLe(KindCopy, KindLinear)) => False::elim(
          kind_ne(KindLinear, KindCopy, x, Refl)
        )
      }
      KindShared => match c: (
        KLe(KindLinear, KindShared)
      ) -> (KLe(KindShared, c)) -> KLe(KindLinear, c) {
        KindCopy => (x: KLe(KindLinear, KindShared)) => (y: KLe(KindShared, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindShared, x, Refl)
        )
        KindShared => (x: KLe(KindLinear, KindShared)) => (
          y: KLe(KindShared, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, x, Refl))
        KindAffine => (x: KLe(KindLinear, KindShared)) => (
          y: KLe(KindShared, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindShared, x, Refl))
        KindLinear => (x: KLe(KindLinear, KindShared)) => (
          y: KLe(KindShared, KindLinear)
        ) => False::elim(kind_ne(KindLinear, KindShared, x, Refl))
      }
      KindAffine => match c: (
        KLe(KindLinear, KindAffine)
      ) -> (KLe(KindAffine, c)) -> KLe(KindLinear, c) {
        KindCopy => (x: KLe(KindLinear, KindAffine)) => (y: KLe(KindAffine, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindAffine, x, Refl)
        )
        KindShared => (x: KLe(KindLinear, KindAffine)) => (
          y: KLe(KindAffine, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindAffine, x, Refl))
        KindAffine => (x: KLe(KindLinear, KindAffine)) => (
          y: KLe(KindAffine, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, x, Refl))
        KindLinear => (x: KLe(KindLinear, KindAffine)) => (
          y: KLe(KindAffine, KindLinear)
        ) => False::elim(kind_ne(KindLinear, KindAffine, x, Refl))
      }
      KindLinear => match c: (
        KLe(KindLinear, KindLinear)
      ) -> (KLe(KindLinear, c)) -> KLe(KindLinear, c) {
        KindCopy => (x: KLe(KindLinear, KindLinear)) => (y: KLe(KindLinear, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindLinear, KindLinear)) => (
          y: KLe(KindLinear, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, y, Refl))
        KindAffine => (x: KLe(KindLinear, KindLinear)) => (
          y: KLe(KindLinear, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, y, Refl))
        KindLinear => (x: KLe(KindLinear, KindLinear)) => (y: KLe(KindLinear, KindLinear)) => Refl
      }
    }
  }(h1, h2)
}

pub theorem kle_lub(
  a: Kind,
  b: Kind,
  c: Kind,
  h1: KLe(a, c),
  h2: KLe(b, c)
): KLe(kind_join(a, b), c) {
  match a: (KLe(a, c)) -> (KLe(b, c)) -> KLe(kind_join(a, b), c) {
    KindCopy => match b: (KLe(KindCopy, c)) -> (KLe(b, c)) -> KLe(kind_join(KindCopy, b), c) {
      KindCopy => match c: (
        KLe(KindCopy, c)
      ) -> (KLe(KindCopy, c)) -> KLe(kind_join(KindCopy, KindCopy), c) {
        KindCopy => (x: KLe(KindCopy, KindCopy)) => (y: KLe(KindCopy, KindCopy)) => Refl
        KindShared => (x: KLe(KindCopy, KindShared)) => (y: KLe(KindCopy, KindShared)) => Refl
        KindAffine => (x: KLe(KindCopy, KindAffine)) => (y: KLe(KindCopy, KindAffine)) => Refl
        KindLinear => (x: KLe(KindCopy, KindLinear)) => (y: KLe(KindCopy, KindLinear)) => Refl
      }
      KindShared => match c: (
        KLe(KindCopy, c)
      ) -> (KLe(KindShared, c)) -> KLe(kind_join(KindCopy, KindShared), c) {
        KindCopy => (x: KLe(KindCopy, KindCopy)) => (y: KLe(KindShared, KindCopy)) => False::elim(
          kind_ne(KindShared, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindCopy, KindShared)) => (y: KLe(KindShared, KindShared)) => Refl
        KindAffine => (x: KLe(KindCopy, KindAffine)) => (y: KLe(KindShared, KindAffine)) => Refl
        KindLinear => (x: KLe(KindCopy, KindLinear)) => (y: KLe(KindShared, KindLinear)) => Refl
      }
      KindAffine => match c: (
        KLe(KindCopy, c)
      ) -> (KLe(KindAffine, c)) -> KLe(kind_join(KindCopy, KindAffine), c) {
        KindCopy => (x: KLe(KindCopy, KindCopy)) => (y: KLe(KindAffine, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindCopy, KindShared)) => (
          y: KLe(KindAffine, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, y, Refl))
        KindAffine => (x: KLe(KindCopy, KindAffine)) => (y: KLe(KindAffine, KindAffine)) => Refl
        KindLinear => (x: KLe(KindCopy, KindLinear)) => (y: KLe(KindAffine, KindLinear)) => Refl
      }
      KindLinear => match c: (
        KLe(KindCopy, c)
      ) -> (KLe(KindLinear, c)) -> KLe(kind_join(KindCopy, KindLinear), c) {
        KindCopy => (x: KLe(KindCopy, KindCopy)) => (y: KLe(KindLinear, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, y, Refl)
        )
        KindShared => (x: KLe(KindCopy, KindShared)) => (
          y: KLe(KindLinear, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, y, Refl))
        KindAffine => (x: KLe(KindCopy, KindAffine)) => (
          y: KLe(KindLinear, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, y, Refl))
        KindLinear => (x: KLe(KindCopy, KindLinear)) => (y: KLe(KindLinear, KindLinear)) => Refl
      }
    }
    KindShared => match b: (
      KLe(KindShared, c)
    ) -> (KLe(b, c)) -> KLe(kind_join(KindShared, b), c) {
      KindCopy => match c: (
        KLe(KindShared, c)
      ) -> (KLe(KindCopy, c)) -> KLe(kind_join(KindShared, KindCopy), c) {
        KindCopy => (x: KLe(KindShared, KindCopy)) => (y: KLe(KindCopy, KindCopy)) => False::elim(
          kind_ne(KindShared, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindShared, KindShared)) => (y: KLe(KindCopy, KindShared)) => Refl
        KindAffine => (x: KLe(KindShared, KindAffine)) => (y: KLe(KindCopy, KindAffine)) => Refl
        KindLinear => (x: KLe(KindShared, KindLinear)) => (y: KLe(KindCopy, KindLinear)) => Refl
      }
      KindShared => match c: (
        KLe(KindShared, c)
      ) -> (KLe(KindShared, c)) -> KLe(kind_join(KindShared, KindShared), c) {
        KindCopy => (x: KLe(KindShared, KindCopy)) => (y: KLe(KindShared, KindCopy)) => False::elim(
          kind_ne(KindShared, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindShared, KindShared)) => (y: KLe(KindShared, KindShared)) => Refl
        KindAffine => (x: KLe(KindShared, KindAffine)) => (y: KLe(KindShared, KindAffine)) => Refl
        KindLinear => (x: KLe(KindShared, KindLinear)) => (y: KLe(KindShared, KindLinear)) => Refl
      }
      KindAffine => match c: (
        KLe(KindShared, c)
      ) -> (KLe(KindAffine, c)) -> KLe(kind_join(KindShared, KindAffine), c) {
        KindCopy => (x: KLe(KindShared, KindCopy)) => (y: KLe(KindAffine, KindCopy)) => False::elim(
          kind_ne(KindShared, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindShared, KindShared)) => (
          y: KLe(KindAffine, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, y, Refl))
        KindAffine => (x: KLe(KindShared, KindAffine)) => (y: KLe(KindAffine, KindAffine)) => Refl
        KindLinear => (x: KLe(KindShared, KindLinear)) => (y: KLe(KindAffine, KindLinear)) => Refl
      }
      KindLinear => match c: (
        KLe(KindShared, c)
      ) -> (KLe(KindLinear, c)) -> KLe(kind_join(KindShared, KindLinear), c) {
        KindCopy => (x: KLe(KindShared, KindCopy)) => (y: KLe(KindLinear, KindCopy)) => False::elim(
          kind_ne(KindShared, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindShared, KindShared)) => (
          y: KLe(KindLinear, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, y, Refl))
        KindAffine => (x: KLe(KindShared, KindAffine)) => (
          y: KLe(KindLinear, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, y, Refl))
        KindLinear => (x: KLe(KindShared, KindLinear)) => (y: KLe(KindLinear, KindLinear)) => Refl
      }
    }
    KindAffine => match b: (
      KLe(KindAffine, c)
    ) -> (KLe(b, c)) -> KLe(kind_join(KindAffine, b), c) {
      KindCopy => match c: (
        KLe(KindAffine, c)
      ) -> (KLe(KindCopy, c)) -> KLe(kind_join(KindAffine, KindCopy), c) {
        KindCopy => (x: KLe(KindAffine, KindCopy)) => (y: KLe(KindCopy, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindAffine, KindShared)) => (
          y: KLe(KindCopy, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, x, Refl))
        KindAffine => (x: KLe(KindAffine, KindAffine)) => (y: KLe(KindCopy, KindAffine)) => Refl
        KindLinear => (x: KLe(KindAffine, KindLinear)) => (y: KLe(KindCopy, KindLinear)) => Refl
      }
      KindShared => match c: (
        KLe(KindAffine, c)
      ) -> (KLe(KindShared, c)) -> KLe(kind_join(KindAffine, KindShared), c) {
        KindCopy => (x: KLe(KindAffine, KindCopy)) => (y: KLe(KindShared, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindAffine, KindShared)) => (
          y: KLe(KindShared, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, x, Refl))
        KindAffine => (x: KLe(KindAffine, KindAffine)) => (y: KLe(KindShared, KindAffine)) => Refl
        KindLinear => (x: KLe(KindAffine, KindLinear)) => (y: KLe(KindShared, KindLinear)) => Refl
      }
      KindAffine => match c: (
        KLe(KindAffine, c)
      ) -> (KLe(KindAffine, c)) -> KLe(kind_join(KindAffine, KindAffine), c) {
        KindCopy => (x: KLe(KindAffine, KindCopy)) => (y: KLe(KindAffine, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindAffine, KindShared)) => (
          y: KLe(KindAffine, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, x, Refl))
        KindAffine => (x: KLe(KindAffine, KindAffine)) => (y: KLe(KindAffine, KindAffine)) => Refl
        KindLinear => (x: KLe(KindAffine, KindLinear)) => (y: KLe(KindAffine, KindLinear)) => Refl
      }
      KindLinear => match c: (
        KLe(KindAffine, c)
      ) -> (KLe(KindLinear, c)) -> KLe(kind_join(KindAffine, KindLinear), c) {
        KindCopy => (x: KLe(KindAffine, KindCopy)) => (y: KLe(KindLinear, KindCopy)) => False::elim(
          kind_ne(KindAffine, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindAffine, KindShared)) => (
          y: KLe(KindLinear, KindShared)
        ) => False::elim(kind_ne(KindAffine, KindShared, x, Refl))
        KindAffine => (x: KLe(KindAffine, KindAffine)) => (
          y: KLe(KindLinear, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, y, Refl))
        KindLinear => (x: KLe(KindAffine, KindLinear)) => (y: KLe(KindLinear, KindLinear)) => Refl
      }
    }
    KindLinear => match b: (
      KLe(KindLinear, c)
    ) -> (KLe(b, c)) -> KLe(kind_join(KindLinear, b), c) {
      KindCopy => match c: (
        KLe(KindLinear, c)
      ) -> (KLe(KindCopy, c)) -> KLe(kind_join(KindLinear, KindCopy), c) {
        KindCopy => (x: KLe(KindLinear, KindCopy)) => (y: KLe(KindCopy, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindLinear, KindShared)) => (
          y: KLe(KindCopy, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, x, Refl))
        KindAffine => (x: KLe(KindLinear, KindAffine)) => (
          y: KLe(KindCopy, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, x, Refl))
        KindLinear => (x: KLe(KindLinear, KindLinear)) => (y: KLe(KindCopy, KindLinear)) => Refl
      }
      KindShared => match c: (
        KLe(KindLinear, c)
      ) -> (KLe(KindShared, c)) -> KLe(kind_join(KindLinear, KindShared), c) {
        KindCopy => (x: KLe(KindLinear, KindCopy)) => (y: KLe(KindShared, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindLinear, KindShared)) => (
          y: KLe(KindShared, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, x, Refl))
        KindAffine => (x: KLe(KindLinear, KindAffine)) => (
          y: KLe(KindShared, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, x, Refl))
        KindLinear => (x: KLe(KindLinear, KindLinear)) => (y: KLe(KindShared, KindLinear)) => Refl
      }
      KindAffine => match c: (
        KLe(KindLinear, c)
      ) -> (KLe(KindAffine, c)) -> KLe(kind_join(KindLinear, KindAffine), c) {
        KindCopy => (x: KLe(KindLinear, KindCopy)) => (y: KLe(KindAffine, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindLinear, KindShared)) => (
          y: KLe(KindAffine, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, x, Refl))
        KindAffine => (x: KLe(KindLinear, KindAffine)) => (
          y: KLe(KindAffine, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, x, Refl))
        KindLinear => (x: KLe(KindLinear, KindLinear)) => (y: KLe(KindAffine, KindLinear)) => Refl
      }
      KindLinear => match c: (
        KLe(KindLinear, c)
      ) -> (KLe(KindLinear, c)) -> KLe(kind_join(KindLinear, KindLinear), c) {
        KindCopy => (x: KLe(KindLinear, KindCopy)) => (y: KLe(KindLinear, KindCopy)) => False::elim(
          kind_ne(KindLinear, KindCopy, x, Refl)
        )
        KindShared => (x: KLe(KindLinear, KindShared)) => (
          y: KLe(KindLinear, KindShared)
        ) => False::elim(kind_ne(KindLinear, KindShared, x, Refl))
        KindAffine => (x: KLe(KindLinear, KindAffine)) => (
          y: KLe(KindLinear, KindAffine)
        ) => False::elim(kind_ne(KindLinear, KindAffine, x, Refl))
        KindLinear => (x: KLe(KindLinear, KindLinear)) => (y: KLe(KindLinear, KindLinear)) => Refl
      }
    }
  }(h1, h2)
}

pub theorem kle_join_l(a: Kind, b: Kind): KLe(a, kind_join(a, b)) {
  match a: KLe(a, kind_join(a, b)) {
    KindCopy => match b: KLe(KindCopy, kind_join(KindCopy, b)) {
      KindCopy => Refl
      KindShared => Refl
      KindAffine => Refl
      KindLinear => Refl
    }
    KindShared => match b: KLe(KindShared, kind_join(KindShared, b)) {
      KindCopy => Refl
      KindShared => Refl
      KindAffine => Refl
      KindLinear => Refl
    }
    KindAffine => match b: KLe(KindAffine, kind_join(KindAffine, b)) {
      KindCopy => Refl
      KindShared => Refl
      KindAffine => Refl
      KindLinear => Refl
    }
    KindLinear => match b: KLe(KindLinear, kind_join(KindLinear, b)) {
      KindCopy => Refl
      KindShared => Refl
      KindAffine => Refl
      KindLinear => Refl
    }
  }
}

pub theorem kle_join_r(a: Kind, b: Kind): KLe(b, kind_join(a, b)) {
  match a: KLe(b, kind_join(a, b)) {
    KindCopy => match b: KLe(b, kind_join(KindCopy, b)) {
      KindCopy => Refl
      KindShared => Refl
      KindAffine => Refl
      KindLinear => Refl
    }
    KindShared => match b: KLe(b, kind_join(KindShared, b)) {
      KindCopy => Refl
      KindShared => Refl
      KindAffine => Refl
      KindLinear => Refl
    }
    KindAffine => match b: KLe(b, kind_join(KindAffine, b)) {
      KindCopy => Refl
      KindShared => Refl
      KindAffine => Refl
      KindLinear => Refl
    }
    KindLinear => match b: KLe(b, kind_join(KindLinear, b)) {
      KindCopy => Refl
      KindShared => Refl
      KindAffine => Refl
      KindLinear => Refl
    }
  }
}

pub theorem kle_refl(a: Kind): KLe(a, a) {
  match a: KLe(a, a) {
    KindCopy => Refl
    KindShared => Refl
    KindAffine => Refl
    KindLinear => Refl
  }
}

pub theorem kle_linear(a: Kind): KLe(a, KindLinear) {
  match a: KLe(a, KindLinear) {
    KindCopy => Refl
    KindShared => Refl
    KindAffine => Refl
    KindLinear => Refl
  }
}

pub theorem kle_copy(a: Kind): KLe(KindCopy, a) {
  match a: KLe(KindCopy, a) {
    KindCopy => Refl
    KindShared => Refl
    KindAffine => Refl
    KindLinear => Refl
  }
}

// ----- the kind of a list -----

pub fn dkl_pick(d: Datas, t: Ty, acc: Kind, p: Bool): Kind {
  match p: Kind {
    true => kind_join(acc, datas_kind(d, t))
    false => acc
  }
}

pub fn dkl_k(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  acc: Kind,
  go: Bool
): Kind {
  match go: Kind {
    false => acc
    true => datas_kind_list(
      d,
      rest,
      every,
      picks_tail(picks),
      dkl_pick(d, t, acc, picks_head(every, picks))
    )
  }
}

pub theorem dkl_unf(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  acc: Kind
): datas_kind_list(d, Cons(t, rest), every, picks, acc) = dkl_k(d, t, rest, every, picks, acc, Bool::or(every, not(Nat::eq(list_len(picks), 0)))) {
  Refl
}

pub fn kn_k(d: Datas, n: Text, args: List(Ty), o: Option(Data)): Kind {
  match o: Kind {
    None => KindShared
    Some(data) => datas_kind_list(
      d,
      args,
      false,
      generics_picked(data.generics, data.holds),
      data.base
    )
  }
}

pub theorem kind_named_unf(
  d: Datas,
  n: Text,
  args: List(Ty)
): datas_kind(d, TyNamed(n, args)) = kn_k(d, n, args, datas_decl(d, n)) {
  Refl
}

pub fn lht_k(y: Text, x: Text, rest: List(Text), b: Bool): Bool {
  Bool::or(b, list_has_text(rest, x))
}

pub theorem lht_unf(
  y: Text,
  x: Text,
  rest: List(Text)
): list_has_text(Cons(y, rest), x) = lht_k(y, x, rest, Text::eq(y, x)) {
  Refl
}

pub theorem pick_ge(d: Datas, t: Ty, acc: Kind, p: Bool): KLe(acc, dkl_pick(d, t, acc, p)) {
  match p: KLe(acc, dkl_pick(d, t, acc, p)) {
    true => kle_join_l(acc, datas_kind(d, t))
    false => kle_refl(acc)
  }
}

pub theorem pick_le(
  d: Datas,
  t: Ty,
  acc: Kind,
  p: Bool,
  k: Kind,
  ha: KLe(acc, k),
  ht: KLe(datas_kind(d, t), k)
): KLe(dkl_pick(d, t, acc, p), k) {
  match p: KLe(dkl_pick(d, t, acc, p), k) {
    true => kle_lub(acc, datas_kind(d, t), k, ha, ht)
    false => ha
  }
}

pub theorem dklk_ge(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  acc: Kind,
  go: Bool,
  ih: ∀ a: Kind. KLe(a, datas_kind_list(d, rest, every, picks_tail(picks), a))
): KLe(acc, dkl_k(d, t, rest, every, picks, acc, go)) {
  match go: KLe(acc, dkl_k(d, t, rest, every, picks, acc, go)) {
    false => kle_refl(acc)
    true => kle_trans(
      acc,
      dkl_pick(d, t, acc, picks_head(every, picks)),
      datas_kind_list(
        d,
        rest,
        every,
        picks_tail(picks),
        dkl_pick(d, t, acc, picks_head(every, picks))
      ),
      pick_ge(d, t, acc, picks_head(every, picks)),
      ih(dkl_pick(d, t, acc, picks_head(every, picks)))
    )
  }
}

// The kind of a list is at least where it starts.
pub theorem dkl_ge_acc(
  d: Datas,
  ts: List(Ty),
  every: Bool,
  picks: List(Bool),
  acc: Kind
): KLe(acc, datas_kind_list(d, ts, every, picks, acc)) {
  match ts: KLe(acc, datas_kind_list(d, ts, every, picks, acc)) {
    Nil => kle_refl(acc)
    Cons(t, rest) => Eq::subst(
      (z: Kind) => KLe(acc, z),
      Eq::sym(dkl_unf(d, t, rest, every, picks, acc)),
      dklk_ge(
        d,
        t,
        rest,
        every,
        picks,
        acc,
        Bool::or(every, not(Nat::eq(list_len(picks), 0))),
        a => dkl_ge_acc(d, rest, every, picks_tail(picks), a)
      )
    )
  }
}

pub theorem dklk_append(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  b: Ty,
  picks: List(Bool),
  acc: Kind,
  k: Kind,
  go: Bool,
  h1: KLe(dkl_k(d, t, rest, false, picks, acc, go), k),
  ih: ∀ a: Kind. (
    KLe(datas_kind_list(d, rest, false, picks_tail(picks), a), k)
  ) -> KLe(datas_kind_list(d, List::append(rest, Cons(b, Nil(Ty))), false, picks_tail(picks), a), k)
): KLe(dkl_k(d, t, List::append(rest, Cons(b, Nil(Ty))), false, picks, acc, go), k) {
  match go: (
    KLe(dkl_k(d, t, rest, false, picks, acc, go), k)
  ) -> KLe(dkl_k(d, t, List::append(rest, Cons(b, Nil(Ty))), false, picks, acc, go), k) {
    false => (h: KLe(acc, k)) => h
    true => (
      h: KLe(
        datas_kind_list(d, rest, false, picks_tail(picks), dkl_pick(d, t, acc, picks_head(false, picks))),
        k
      )
    ) => ih(dkl_pick(d, t, acc, picks_head(false, picks)), h)
  }(h1)
}

pub theorem dklk_one(
  d: Datas,
  b: Ty,
  picks: List(Bool),
  acc: Kind,
  k: Kind,
  go: Bool,
  ha: KLe(acc, k),
  hb: KLe(datas_kind(d, b), k)
): KLe(dkl_k(d, b, Nil(Ty), false, picks, acc, go), k) {
  match go: KLe(dkl_k(d, b, Nil(Ty), false, picks, acc, go), k) {
    false => ha
    true => pick_le(d, b, acc, picks_head(false, picks), k, ha, hb)
  }
}

// One more argument at the end adds at most its kind.
pub theorem dkl_append(
  d: Datas,
  xs: List(Ty),
  b: Ty,
  picks: List(Bool),
  acc: Kind,
  k: Kind,
  h1: KLe(datas_kind_list(d, xs, false, picks, acc), k),
  hb: KLe(datas_kind(d, b), k)
): KLe(datas_kind_list(d, List::append(xs, Cons(b, Nil(Ty))), false, picks, acc), k) {
  match xs: KLe(datas_kind_list(d, List::append(xs, Cons(b, Nil(Ty))), false, picks, acc), k) {
    Nil => Eq::subst(
      (z: Kind) => KLe(z, k),
      Eq::sym(dkl_unf(d, b, Nil(Ty), false, picks, acc)),
      dklk_one(d, b, picks, acc, k, Bool::or(false, not(Nat::eq(list_len(picks), 0))), h1, hb)
    )
    Cons(t, rest) => Eq::subst(
      (z: Kind) => KLe(z, k),
      Eq::sym(dkl_unf(d, t, List::append(rest, Cons(b, Nil(Ty))), false, picks, acc)),
      dklk_append(
        d,
        t,
        rest,
        b,
        picks,
        acc,
        k,
        Bool::or(false, not(Nat::eq(list_len(picks), 0))),
        Eq::subst((z: Kind) => KLe(z, k), dkl_unf(d, t, rest, false, picks, acc), h1),
        a => ha => dkl_append(d, rest, b, picks_tail(picks), a, k, ha, hb)
      )
    )
  }
}

// Every one counted and the start below `j`: the kind of the list is too.
pub theorem dkl_le_all(
  d: Datas,
  ts: List(Ty),
  acc: Kind,
  j: Kind,
  ha: KLe(acc, j),
  h: ∀ m: Ty. (Mem(Ty, m, ts)) -> KLe(datas_kind(d, m), j)
): KLe(datas_kind_list(d, ts, true, Nil(Bool), acc), j) {
  match ts: KLe(datas_kind_list(d, ts, true, Nil(Bool), acc), j) {
    Nil => ha
    Cons(t, rest) => dkl_le_all(
      d,
      rest,
      kind_join(acc, datas_kind(d, t)),
      j,
      kle_lub(acc, datas_kind(d, t), j, ha, h(t, MemHere(Ty, t, rest))),
      m => mm => h(m, MemThere(Ty, m, t, rest, mm))
    )
  }
}

// A leaf of the list is below the kind of the list.
pub theorem leaf_le<e: Ty, ys: List(
  Ty
)>(
  l: Leaves(e, ys),
  d: Datas,
  acc: Kind
): KLe(datas_kind(d, e), datas_kind_list(d, ys, true, Nil(Bool), acc)) {
  match l: KLe(datas_kind(d, e), datas_kind_list(d, ys, true, Nil(Bool), acc)) {
    LvHere(rest, p) => kle_trans(
      datas_kind(d, e),
      kind_join(acc, datas_kind(d, e)),
      datas_kind_list(d, rest, true, Nil(Bool), kind_join(acc, datas_kind(d, e))),
      kle_join_r(acc, datas_kind(d, e)),
      dkl_ge_acc(d, rest, true, Nil(Bool), kind_join(acc, datas_kind(d, e)))
    )
    LvIn(ys2, rest, l2) => kle_trans(
      datas_kind(d, e),
      datas_kind_list(d, ys2, true, Nil(Bool), KindCopy),
      datas_kind_list(
        d,
        rest,
        true,
        Nil(Bool),
        kind_join(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy))
      ),
      leaf_le(l2, d, KindCopy),
      kle_trans(
        datas_kind_list(d, ys2, true, Nil(Bool), KindCopy),
        kind_join(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy)),
        datas_kind_list(
          d,
          rest,
          true,
          Nil(Bool),
          kind_join(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy))
        ),
        kle_join_r(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy)),
        dkl_ge_acc(
          d,
          rest,
          true,
          Nil(Bool),
          kind_join(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy))
        )
      )
    )
    LvThere(y, rest, l2) => leaf_le(l2, d, kind_join(acc, datas_kind(d, y)))
  }
}

pub theorem kind_members_at(
  d: Datas,
  u1: Ty,
  u: Ty,
  eu: u1 = u,
  j: Kind,
  h: ∀ m: Ty. (Mem(Ty, m, ty_members(u))) -> KLe(datas_kind(d, m), j)
): KLe(datas_kind(d, u), j) {
  match u: KLe(datas_kind(d, u), j) {
    TyUnion(zs) => dkl_le_all(d, zs, KindCopy, j, kle_copy(j), h)
    TyNever => kle_copy(j)
    _ => Eq::subst(
      (z: Ty) => KLe(datas_kind(d, z), j),
      eu,
      h(u1, Eq::subst((z: Ty) => Mem(Ty, u1, Cons(z, Nil(Ty))), eu, MemHere(Ty, u1, Nil(Ty))))
    )
  }
}

// The union of `ys` is below what each of `ys` is below.
pub theorem union_le(
  d: Datas,
  ys: List(Ty),
  k: Kind,
  hk: KLe(datas_kind_list(d, ys, true, Nil(Bool), KindCopy), k)
): KLe(datas_kind(d, ty_union(ys)), k) {
  kind_members_at(
    d,
    ty_union(ys),
    ty_union(ys),
    Refl,
    k,
    m => mm => kle_trans(
      datas_kind(d, m),
      datas_kind_list(d, ys, true, Nil(Bool), KindCopy),
      k,
      leaf_le(And::left(union_mem(m, ys, mm)), d, KindCopy),
      hk
    )
  )
}

// The same for a product, whose kind is also the join of its members.
pub theorem pleaf_le<e: Ty, ys: List(
  Ty
)>(
  l: PLeaves(e, ys),
  d: Datas,
  acc: Kind
): KLe(datas_kind(d, e), datas_kind_list(d, ys, true, Nil(Bool), acc)) {
  match l: KLe(datas_kind(d, e), datas_kind_list(d, ys, true, Nil(Bool), acc)) {
    PlvHere(rest, p) => kle_trans(
      datas_kind(d, e),
      kind_join(acc, datas_kind(d, e)),
      datas_kind_list(d, rest, true, Nil(Bool), kind_join(acc, datas_kind(d, e))),
      kle_join_r(acc, datas_kind(d, e)),
      dkl_ge_acc(d, rest, true, Nil(Bool), kind_join(acc, datas_kind(d, e)))
    )
    PlvIn(ys2, rest, l2) => kle_trans(
      datas_kind(d, e),
      datas_kind_list(d, ys2, true, Nil(Bool), KindCopy),
      datas_kind_list(
        d,
        rest,
        true,
        Nil(Bool),
        kind_join(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy))
      ),
      pleaf_le(l2, d, KindCopy),
      kle_trans(
        datas_kind_list(d, ys2, true, Nil(Bool), KindCopy),
        kind_join(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy)),
        datas_kind_list(
          d,
          rest,
          true,
          Nil(Bool),
          kind_join(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy))
        ),
        kle_join_r(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy)),
        dkl_ge_acc(
          d,
          rest,
          true,
          Nil(Bool),
          kind_join(acc, datas_kind_list(d, ys2, true, Nil(Bool), KindCopy))
        )
      )
    )
    PlvThere(y, rest, l2) => pleaf_le(l2, d, kind_join(acc, datas_kind(d, y)))
  }
}

pub theorem pkind_members_at(
  d: Datas,
  u1: Ty,
  u: Ty,
  eu: u1 = u,
  j: Kind,
  h: ∀ m: Ty. (Mem(Ty, m, ty_pmembers(u))) -> KLe(datas_kind(d, m), j)
): KLe(datas_kind(d, u), j) {
  match u: KLe(datas_kind(d, u), j) {
    TyProduct(zs) => dkl_le_all(d, zs, KindCopy, j, kle_copy(j), h)
    TyUnit => kle_copy(j)
    _ => Eq::subst(
      (z: Ty) => KLe(datas_kind(d, z), j),
      eu,
      h(u1, Eq::subst((z: Ty) => Mem(Ty, u1, Cons(z, Nil(Ty))), eu, MemHere(Ty, u1, Nil(Ty))))
    )
  }
}

pub theorem product_le(
  d: Datas,
  ys: List(Ty),
  k: Kind,
  hk: KLe(datas_kind_list(d, ys, true, Nil(Bool), KindCopy), k)
): KLe(datas_kind(d, ty_product(ys)), k) {
  pkind_members_at(
    d,
    ty_product(ys),
    ty_product(ys),
    Refl,
    k,
    m => mm => kle_trans(
      datas_kind(d, m),
      datas_kind_list(d, ys, true, Nil(Bool), KindCopy),
      k,
      pleaf_le(And::left(product_mem(m, ys, mm)), d, KindCopy),
      hk
    )
  )
}

pub theorem kind_tagged_with(
  d: Datas,
  l: List(Text),
  z: Ty
): datas_kind(d, ty_tagged_with(l, z)) = datas_kind(d, z) {
  match l: datas_kind(d, ty_tagged_with(l, z)) = datas_kind(d, z) {
    Nil => Refl
    Cons(tg, rest) => Refl
  }
}

pub theorem kind_untagged(
  d: Datas,
  y: Ty
): datas_kind(d, ty_untagged(y)) = datas_kind(d, y) {
  match y: datas_kind(d, ty_untagged(y)) = datas_kind(d, y) {
    TyTagged(tags, x) => Refl
    _ => Refl
  }
}

// Tags do not change a kind.
pub theorem kind_tagged(
  d: Datas,
  tags: List(Text),
  y: Ty
): datas_kind(d, ty_tagged(tags, y)) = datas_kind(d, y) {
  Eq::trans(
    Eq::congr((z: Ty) => datas_kind(d, z), tagged_shape(tags, y)),
    Eq::trans(kind_tagged_with(d, tags_union(tags, ty_tags(y)), ty_untagged(y)), kind_untagged(d, y))
  )
}

pub theorem apply_named(
  d: Datas,
  n: Text,
  args: List(Ty),
  b: Ty,
  o: Option(Data),
  k: Kind,
  ha: KLe(kn_k(d, n, args, o), k),
  hb: KLe(datas_kind(d, b), k)
): KLe(kn_k(d, n, List::append(args, Cons(b, Nil(Ty))), o), k) {
  match o: (
    KLe(kn_k(d, n, args, o), k)
  ) -> KLe(kn_k(d, n, List::append(args, Cons(b, Nil(Ty))), o), k) {
    None => (h: KLe(KindShared, k)) => h
    Some(data) => (
      h: KLe(datas_kind_list(d, args, false, generics_picked(data.generics, data.holds), data.base), k)
    ) => dkl_append(d, args, b, generics_picked(data.generics, data.holds), data.base, k, h, hb)
  }(ha)
}

// `F(X)` is below what `F` and `X` are below.
pub theorem apply_le(
  d: Datas,
  a: Ty,
  b: Ty,
  k: Kind,
  ha: KLe(datas_kind(d, a), k),
  hb: KLe(datas_kind(d, b), k)
): KLe(datas_kind(d, ty_apply(a, b)), k) {
  match a: (KLe(datas_kind(d, a), k)) -> KLe(datas_kind(d, ty_apply(a, b)), k) {
    TyNamed(n, args) => (h: KLe(datas_kind(d, TyNamed(n, args)), k)) => Eq::subst(
      (z: Kind) => KLe(z, k),
      Eq::sym(kind_named_unf(d, n, List::append(args, Cons(b, Nil(Ty))))),
      apply_named(
        d,
        n,
        args,
        b,
        datas_decl(d, n),
        k,
        Eq::subst((z: Kind) => KLe(z, k), kind_named_unf(d, n, args), h),
        hb
      )
    )
    TyParam(n, pk) => (h: KLe(pk, k)) => h
    _ => (h: KLe(datas_kind(d, a), k)) => kle_copy(k)
  }(ha)
}

// ----- text membership -----

pub fn te_k(o: Ordering): Bool {
  match o: Bool {
    Less => false
    Equal => true
    Greater => false
  }
}

pub theorem te_unf(a: Text, b: Text): Text::eq(a, b) = te_k(Text::ordering(a, b)) {
  Refl
}

pub theorem text_eq_refl(x: Text): Text::eq(x, x) = true {
  Eq::subst((z: Ordering) => te_k(z) = true, Eq::sym(Ordmap::compare_text_same(x)), Refl)
}

pub theorem te_sound(
  a: Text,
  b: Text,
  o: Ordering,
  eo: Text::ordering(a, b) = o,
  e: te_k(o) = true
): a = b {
  match o: (Text::ordering(a, b) = o) -> (te_k(o) = true) -> (a = b) {
    Less => (x: Text::ordering(a, b) = Less) => (y: false = true) => False::elim(
      false_ne_true(y)
    )
    Equal => (x: Text::ordering(a, b) = Equal) => (
      y: true = true
    ) => Ordmap::compare_text_eq(a, b, x)
    Greater => (x: Text::ordering(a, b) = Greater) => (y: false = true) => False::elim(
      false_ne_true(y)
    )
  }(eo, e)
}

pub theorem text_eq_true(a: Text, b: Text, e: Text::eq(a, b) = true): a = b {
  te_sound(a, b, Text::ordering(a, b), Refl, e)
}

pub theorem kyn_or_true(
  x: Bool,
  y: Bool,
  p: Prop,
  e: Bool::or(x, y) = true,
  f1: (x = true) -> p,
  f2: (y = true) -> p
): p {
  match x: (Bool::or(x, y) = true) -> ((x = true) -> p) -> p {
    true => (e2: true = true) => (g: (true = true) -> p) => g(Refl)
    false => (e2: y = true) => (g: (false = true) -> p) => f2(e2)
  }(e, f1)
}

pub theorem bool_or_right(x: Bool, y: Bool, e: y = true): Bool::or(x, y) = true {
  match x: Bool::or(x, y) = true {
    true => Refl
    false => e
  }
}

pub theorem lht_sound(
  xs: List(Text),
  x: Text,
  e: list_has_text(xs, x) = true
): Mem(Text, x, xs) {
  match xs: Mem(Text, x, xs) {
    Nil => False::elim(false_ne_true(e))
    Cons(y, rest) => kyn_or_true(
      Text::eq(y, x),
      list_has_text(rest, x),
      Mem(Text, x, Cons(y, rest)),
      Eq::subst((z: Bool) => z = true, lht_unf(y, x, rest), e),
      q => mem_of_eq(x, y, rest, Eq::sym(text_eq_true(y, x, q))),
      q => MemThere(Text, x, y, rest, lht_sound(rest, x, q))
    )
  }
}

pub theorem lht_complete<x: Text, xs: List(
  Text
)>(m: Mem(Text, x, xs)): list_has_text(xs, x) = true {
  match m: list_has_text(xs, x) = true {
    MemHere(t) => Eq::subst(
      (z: Bool) => Bool::or(z, list_has_text(t, x)) = true,
      Eq::sym(text_eq_refl(x)),
      Refl
    )
    MemThere(b, t, m2) => bool_or_right(Text::eq(b, x), list_has_text(t, x), lht_complete(m2))
  }
}

// ----- the kind of a field, at arguments -----

pub fn ha_k(holds: List(Text), n: Text, b: Bool): List(Text) {
  match b: List(Text) {
    true => holds
    false => Cons(n, holds)
  }
}

pub theorem ha_unf(
  holds: List(Text),
  n: Text
): holds_add(holds, n) = ha_k(holds, n, list_has_text(holds, n)) {
  Refl
}

pub theorem hak_has(
  holds: List(Text),
  n: Text,
  b: Bool,
  eb: list_has_text(holds, n) = b
): Mem(Text, n, ha_k(holds, n, b)) {
  match b: Mem(Text, n, ha_k(holds, n, b)) {
    true => lht_sound(holds, n, eb)
    false => MemHere(Text, n, holds)
  }
}

pub theorem ha_has(holds: List(Text), n: Text): Mem(Text, n, holds_add(holds, n)) {
  Eq::subst(
    (z: List(Text)) => Mem(Text, n, z),
    Eq::sym(ha_unf(holds, n)),
    hak_has(holds, n, list_has_text(holds, n), Refl)
  )
}

pub theorem hak_keep(
  holds: List(Text),
  n: Text,
  b: Bool,
  g: Text,
  m: Mem(Text, g, holds)
): Mem(Text, g, ha_k(holds, n, b)) {
  match b: Mem(Text, g, ha_k(holds, n, b)) {
    true => m
    false => MemThere(Text, g, n, holds, m)
  }
}

pub theorem ha_keep(
  holds: List(Text),
  n: Text,
  g: Text,
  m: Mem(Text, g, holds)
): Mem(Text, g, holds_add(holds, n)) {
  Eq::subst(
    (z: List(Text)) => Mem(Text, g, z),
    Eq::sym(ha_unf(holds, n)),
    hak_keep(holds, n, list_has_text(holds, n), g, m)
  )
}

pub fn fkp_k(n: Text, pk: Kind, holds: List(Text), b: Bool): Pair(Kind, List(Text)) {
  match b: Pair(Kind, List(Text)) {
    true => Pair { fst: KindCopy, snd: holds_add(holds, n) }
    false => Pair { fst: pk, snd: holds }
  }
}

pub theorem fk_param_unf(
  d: Datas,
  n: Text,
  pk: Kind,
  gs: List(Text),
  holds: List(Text)
): field_kind(d, TyParam(n, pk), gs, holds) = fkp_k(n, pk, holds, list_has_text(gs, n)) {
  Refl
}

pub fn fkd_k(
  d: Datas,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text),
  o: Option(Data)
): Pair(Kind, List(Text)) {
  match o: Pair(Kind, List(Text)) {
    None => Pair { fst: KindShared, snd: holds }
    Some(data) => field_kind_list(
      d,
      args,
      false,
      generics_picked(data.generics, data.holds),
      gs,
      Pair { fst: data.base, snd: holds }
    )
  }
}

pub fn fkn_k(
  d: Datas,
  n: Text,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text),
  b: Bool
): Pair(Kind, List(Text)) {
  match b: Pair(Kind, List(Text)) {
    true => Pair { fst: KindCopy, snd: holds_add(holds, n) }
    false => fkd_k(d, args, gs, holds, datas_decl(d, n))
  }
}

pub theorem fk_named_unf(
  d: Datas,
  n: Text,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text)
): field_kind(d, TyNamed(n, args), gs, holds) = fkn_k(d, n, args, gs, holds, Bool::and(ty_no_args(args), list_has_text(gs, n))) {
  Refl
}

pub fn fkl_pick(
  d: Datas,
  t: Ty,
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  p: Bool
): Pair(Kind, List(Text)) {
  match p: Pair(Kind, List(Text)) {
    true => kind_pair_join(acc, field_kind(d, t, gs, (acc: List(Text))))
    false => acc
  }
}

pub fn fkl_k(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  go: Bool
): Pair(Kind, List(Text)) {
  match go: Pair(Kind, List(Text)) {
    false => acc
    true => field_kind_list(
      d,
      rest,
      every,
      picks_tail(picks),
      gs,
      fkl_pick(d, t, gs, acc, picks_head(every, picks))
    )
  }
}

pub theorem fkl_unf(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  gs: List(Text),
  acc: Pair(Kind, List(Text))
): field_kind_list(d, Cons(t, rest), every, picks, gs, acc) = fkl_k(d, t, rest, every, picks, gs, acc, Bool::or(every, not(Nat::eq(list_len(picks), 0)))) {
  Refl
}

pub fn pfst(p: Pair(Kind, List(Text))): Kind {
  (p: Kind)
}

pub fn psnd(p: Pair(Kind, List(Text))): List(Text) {
  (p: List(Text))
}

pub fn dgen(data: Data): List(Text) {
  data.generics
}

pub fn dholds(data: Data): List(Text) {
  data.holds
}

pub fn dbase(data: Data): Kind {
  data.base
}

// ----- what a field holds only grows -----

pub theorem fkp_grow(
  n: Text,
  pk: Kind,
  holds: List(Text),
  b: Bool,
  g: Text,
  m: Mem(Text, g, holds)
): Mem(Text, g, psnd(fkp_k(n, pk, holds, b))) {
  match b: Mem(Text, g, psnd(fkp_k(n, pk, holds, b))) {
    true => ha_keep(holds, n, g, m)
    false => m
  }
}

pub theorem fkd_grow(
  d: Datas,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text),
  o: Option(Data),
  g: Text,
  m: Mem(Text, g, holds),
  ih: ∀ data: Data. Mem(
    Text,
    g,
    psnd(
      field_kind_list(
        d,
        args,
        false,
        generics_picked(dgen(data), dholds(data)),
        gs,
        Pair { fst: dbase(data), snd: holds }
      )
    )
  )
): Mem(Text, g, psnd(fkd_k(d, args, gs, holds, o))) {
  match o: Mem(Text, g, psnd(fkd_k(d, args, gs, holds, o))) {
    None => m
    Some(data) => ih(data)
  }
}

pub theorem fkn_grow(
  d: Datas,
  n: Text,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text),
  b: Bool,
  g: Text,
  m: Mem(Text, g, holds),
  ih: Mem(Text, g, psnd(fkd_k(d, args, gs, holds, datas_decl(d, n))))
): Mem(Text, g, psnd(fkn_k(d, n, args, gs, holds, b))) {
  match b: Mem(Text, g, psnd(fkn_k(d, n, args, gs, holds, b))) {
    true => ha_keep(holds, n, g, m)
    false => ih
  }
}

pub theorem fklp_grow(
  d: Datas,
  t: Ty,
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  p: Bool,
  g: Text,
  m: Mem(Text, g, psnd(acc)),
  iht: Mem(Text, g, psnd(field_kind(d, t, gs, psnd(acc))))
): Mem(Text, g, psnd(fkl_pick(d, t, gs, acc, p))) {
  match p: Mem(Text, g, psnd(fkl_pick(d, t, gs, acc, p))) {
    true => iht
    false => m
  }
}

pub theorem fklk_grow(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  go: Bool,
  g: Text,
  m: Mem(Text, g, psnd(acc)),
  iht: Mem(Text, g, psnd(field_kind(d, t, gs, psnd(acc)))),
  ihr: ∀ a: Pair(
    Kind,
    List(Text)
  ). (
    Mem(Text, g, psnd(a))
  ) -> Mem(Text, g, psnd(field_kind_list(d, rest, every, picks_tail(picks), gs, a)))
): Mem(Text, g, psnd(fkl_k(d, t, rest, every, picks, gs, acc, go))) {
  match go: Mem(Text, g, psnd(fkl_k(d, t, rest, every, picks, gs, acc, go))) {
    false => m
    true => ihr(
      fkl_pick(d, t, gs, acc, picks_head(every, picks)),
      fklp_grow(d, t, gs, acc, picks_head(every, picks), g, m, iht)
    )
  }
}

mutual {
  pub theorem fkl_grow(
    d: Datas,
    ts: List(Ty),
    every: Bool,
    picks: List(Bool),
    gs: List(Text),
    acc: Pair(Kind, List(Text)),
    g: Text,
    m: Mem(Text, g, psnd(acc))
  ): Mem(Text, g, psnd(field_kind_list(d, ts, every, picks, gs, acc))) {
    match ts: Mem(Text, g, psnd(field_kind_list(d, ts, every, picks, gs, acc))) {
      Nil => m
      Cons(t, rest) => Eq::subst(
        (z: Pair(Kind, List(Text))) => Mem(Text, g, psnd(z)),
        Eq::sym(fkl_unf(d, t, rest, every, picks, gs, acc)),
        fklk_grow(
          d,
          t,
          rest,
          every,
          picks,
          gs,
          acc,
          Bool::or(every, not(Nat::eq(list_len(picks), 0))),
          g,
          m,
          fk_grow(d, t, gs, psnd(acc), g, m),
          a => ma => fkl_grow(d, rest, every, picks_tail(picks), gs, a, g, ma)
        )
      )
    }
  }

  // What a field holds only grows.
  pub theorem fk_grow(
    d: Datas,
    t: Ty,
    gs: List(Text),
    holds: List(Text),
    g: Text,
    m: Mem(Text, g, holds)
  ): Mem(Text, g, psnd(field_kind(d, t, gs, holds))) {
    match t: Mem(Text, g, psnd(field_kind(d, t, gs, holds))) {
      TyInt(w) => m
      TyBool => m
      TyText => m
      TyUnit => m
      TyNever => m
      TyDecimal => m
      TyFloat => m
      TyFn(ps, r, k) => m
      TyUnion(ts) => fkl_grow(d, ts, true, Nil(Bool), gs, Pair { fst: KindCopy, snd: holds }, g, m)
      TyProduct(ts) => fkl_grow(
        d,
        ts,
        true,
        Nil(Bool),
        gs,
        Pair { fst: KindCopy, snd: holds },
        g,
        m
      )
      TyTagged(tags, x) => fk_grow(d, x, gs, holds, g, m)
      TyNamed(n, args) => Eq::subst(
        (z: Pair(Kind, List(Text))) => Mem(Text, g, psnd(z)),
        Eq::sym(fk_named_unf(d, n, args, gs, holds)),
        fkn_grow(
          d,
          n,
          args,
          gs,
          holds,
          Bool::and(ty_no_args(args), list_has_text(gs, n)),
          g,
          m,
          fkd_grow(
            d,
            args,
            gs,
            holds,
            datas_decl(d, n),
            g,
            m,
            data => fkl_grow(
              d,
              args,
              false,
              generics_picked(dgen(data), dholds(data)),
              gs,
              Pair { fst: dbase(data), snd: holds },
              g,
              m
            )
          )
        )
      )
      TyParam(n, pk) => Eq::subst(
        (z: Pair(Kind, List(Text))) => Mem(Text, g, psnd(z)),
        Eq::sym(fk_param_unf(d, n, pk, gs, holds)),
        fkp_grow(n, pk, holds, list_has_text(gs, n), g, m)
      )
      TyInfo(x) => m
      TyBorrow(x, mu) => fk_grow(d, x, gs, holds, g, m)
      TyVar(v) => m
      TyApp(h, x) => fk_grow(
        d,
        x,
        gs,
        psnd(field_kind(d, h, gs, holds)),
        g,
        fk_grow(d, h, gs, holds, g, m)
      )
      TyPoly(ps, x) => m
    }
  }
}

pub theorem fklp_fst(
  d: Datas,
  t: Ty,
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  p: Bool
): KLe(pfst(acc), pfst(fkl_pick(d, t, gs, acc, p))) {
  match p: KLe(pfst(acc), pfst(fkl_pick(d, t, gs, acc, p))) {
    true => kle_join_l(pfst(acc), pfst(field_kind(d, t, gs, psnd(acc))))
    false => kle_refl(pfst(acc))
  }
}

pub theorem fklk_fst(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  go: Bool,
  ihr: ∀ a: Pair(
    Kind,
    List(Text)
  ). KLe(pfst(a), pfst(field_kind_list(d, rest, every, picks_tail(picks), gs, a)))
): KLe(pfst(acc), pfst(fkl_k(d, t, rest, every, picks, gs, acc, go))) {
  match go: KLe(pfst(acc), pfst(fkl_k(d, t, rest, every, picks, gs, acc, go))) {
    false => kle_refl(pfst(acc))
    true => kle_trans(
      pfst(acc),
      pfst(fkl_pick(d, t, gs, acc, picks_head(every, picks))),
      pfst(
        field_kind_list(
          d,
          rest,
          every,
          picks_tail(picks),
          gs,
          fkl_pick(d, t, gs, acc, picks_head(every, picks))
        )
      ),
      fklp_fst(d, t, gs, acc, picks_head(every, picks)),
      ihr(fkl_pick(d, t, gs, acc, picks_head(every, picks)))
    )
  }
}

// The kind of a list of fields is at least where it starts.
pub theorem fkl_fst(
  d: Datas,
  ts: List(Ty),
  every: Bool,
  picks: List(Bool),
  gs: List(Text),
  acc: Pair(Kind, List(Text))
): KLe(pfst(acc), pfst(field_kind_list(d, ts, every, picks, gs, acc))) {
  match ts: KLe(pfst(acc), pfst(field_kind_list(d, ts, every, picks, gs, acc))) {
    Nil => kle_refl(pfst(acc))
    Cons(t, rest) => Eq::subst(
      (z: Pair(Kind, List(Text))) => KLe(pfst(acc), pfst(z)),
      Eq::sym(fkl_unf(d, t, rest, every, picks, gs, acc)),
      fklk_fst(
        d,
        t,
        rest,
        every,
        picks,
        gs,
        acc,
        Bool::or(every, not(Nat::eq(list_len(picks), 0))),
        a => fkl_fst(d, rest, every, picks_tail(picks), gs, a)
      )
    )
  }
}

// ----- the kind of a field at arguments is below what `field_kind` says -----

// `map` gives a type for each generic in `gs`, and only for those.
pub def MapKeys(
  map: Ordmap(Text, Ty),
  gs: List(Text)
): Prop := ∀ n: Text. ∀ x: Ty. (
  Ordmap::get(map, n, Ordmap::compare_text) = Some(x)
) -> Mem(Text, n, gs)

pub def MapCover(
  map: Ordmap(Text, Ty),
  gs: List(Text)
): Prop := ∀ n: Text. (
  Mem(Text, n, gs)
) -> (Ordmap::get(map, n, Ordmap::compare_text) = None(Ty)) -> False

// The arguments for the generics in `hs` are below `k`.
pub def Env(
  d: Datas,
  map: Ordmap(Text, Ty),
  hs: List(Text),
  k: Kind
): Prop := ∀ n: Text. ∀ x: Ty. (
  Mem(Text, n, hs)
) -> (Ordmap::get(map, n, Ordmap::compare_text) = Some(x)) -> KLe(datas_kind(d, x), k)

pub theorem env_sub(
  d: Datas,
  map: Ordmap(Text, Ty),
  hs: List(Text),
  hs2: List(Text),
  k: Kind,
  he: Env(d, map, hs2, k),
  sub: ∀ g: Text. (Mem(Text, g, hs)) -> Mem(Text, g, hs2)
): Env(d, map, hs, k) {
  n => x => m => e => he(n, x, sub(n, m), e)
}

pub theorem split_l(a: Kind, b: Kind, k: Kind, h: KLe(kind_join(a, b), k)): KLe(a, k) {
  kle_trans(a, kind_join(a, b), k, kle_join_l(a, b), h)
}

pub theorem split_r(a: Kind, b: Kind, k: Kind, h: KLe(kind_join(a, b), k)): KLe(b, k) {
  kle_trans(b, kind_join(a, b), k, kle_join_r(a, b), h)
}

pub fn sn_k(t: Ty, o: Option(Ty)): Ty {
  match o: Ty {
    Some(x) => x
    None => t
  }
}

pub theorem sn_unf(
  n: Text,
  map: Ordmap(Text, Ty),
  t: Ty
): ty_substitute_name(n, map, t) = sn_k(t, Ordmap::get(map, n, Ordmap::compare_text)) {
  Refl
}

pub theorem fk_param_ok(
  d: Datas,
  n: Text,
  pk: Kind,
  gs: List(Text),
  holds: List(Text),
  map: Ordmap(Text, Ty),
  k: Kind,
  mk: MapKeys(map, gs),
  mc: MapCover(map, gs),
  b: Bool,
  eb: list_has_text(gs, n) = b,
  o: Option(Ty),
  eo: Ordmap::get(map, n, Ordmap::compare_text) = o,
  hk: KLe(pfst(fkp_k(n, pk, holds, b)), k),
  he: Env(d, map, psnd(fkp_k(n, pk, holds, b)), k)
): KLe(datas_kind(d, sn_k(TyParam(n, pk), o)), k) {
  match b: KLe(datas_kind(d, sn_k(TyParam(n, pk), o)), k) {
    true => match o: KLe(datas_kind(d, sn_k(TyParam(n, pk), o)), k) {
      Some(x) => he(n, x, ha_has(holds, n), eo)
      None => False::elim(mc(n, lht_sound(gs, n, eb), eo))
    }
    false => match o: KLe(datas_kind(d, sn_k(TyParam(n, pk), o)), k) {
      None => hk
      Some(x) => False::elim(false_ne_true(Eq::trans(Eq::sym(eb), lht_complete(mk(n, x, eo)))))
    }
  }
}

pub theorem fk_nil_decl(
  d: Datas,
  n: Text,
  gs: List(Text),
  holds: List(Text),
  o: Option(Data),
  k: Kind,
  hk: KLe(pfst(fkd_k(d, Nil(Ty), gs, holds, o)), k)
): KLe(kn_k(d, n, Nil(Ty), o), k) {
  match o: KLe(kn_k(d, n, Nil(Ty), o), k) {
    None => hk
    Some(data) => hk
  }
}

pub theorem fk_name_ok(
  d: Datas,
  n: Text,
  gs: List(Text),
  holds: List(Text),
  map: Ordmap(Text, Ty),
  k: Kind,
  mk: MapKeys(map, gs),
  mc: MapCover(map, gs),
  c: Bool,
  ec: list_has_text(gs, n) = c,
  o: Option(Ty),
  eo: Ordmap::get(map, n, Ordmap::compare_text) = o,
  hk: KLe(pfst(fkn_k(d, n, Nil(Ty), gs, holds, c)), k),
  he: Env(d, map, psnd(fkn_k(d, n, Nil(Ty), gs, holds, c)), k)
): KLe(datas_kind(d, sn_k(TyNamed(n, Nil(Ty)), o)), k) {
  match c: KLe(datas_kind(d, sn_k(TyNamed(n, Nil(Ty)), o)), k) {
    true => match o: KLe(datas_kind(d, sn_k(TyNamed(n, Nil(Ty)), o)), k) {
      Some(x) => he(n, x, ha_has(holds, n), eo)
      None => False::elim(mc(n, lht_sound(gs, n, ec), eo))
    }
    false => match o: KLe(datas_kind(d, sn_k(TyNamed(n, Nil(Ty)), o)), k) {
      None => Eq::subst(
        (z: Kind) => KLe(z, k),
        Eq::sym(kind_named_unf(d, n, Nil(Ty))),
        fk_nil_decl(d, n, gs, holds, datas_decl(d, n), k, hk)
      )
      Some(x) => False::elim(false_ne_true(Eq::trans(Eq::sym(ec), lht_complete(mk(n, x, eo)))))
    }
  }
}

pub theorem fk_cons_ok(
  d: Datas,
  n: Text,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text),
  map: Ordmap(Text, Ty),
  k: Kind,
  o: Option(Data),
  hk: KLe(pfst(fkd_k(d, args, gs, holds, o)), k),
  he: Env(d, map, psnd(fkd_k(d, args, gs, holds, o)), k),
  ih: ∀ data: Data. (
    KLe(dbase(data), k)
  ) -> (
    KLe(
      pfst(
        field_kind_list(
          d,
          args,
          false,
          generics_picked(dgen(data), dholds(data)),
          gs,
          Pair { fst: dbase(data), snd: holds }
        )
      ),
      k
    )
  ) -> (
    Env(
      d,
      map,
      psnd(
        field_kind_list(
          d,
          args,
          false,
          generics_picked(dgen(data), dholds(data)),
          gs,
          Pair { fst: dbase(data), snd: holds }
        )
      ),
      k
    )
  ) -> KLe(
    datas_kind_list(
      d,
      ty_map_list(args, map),
      false,
      generics_picked(dgen(data), dholds(data)),
      dbase(data)
    ),
    k
  )
): KLe(kn_k(d, n, ty_map_list(args, map), o), k) {
  match o: KLe(kn_k(d, n, ty_map_list(args, map), o), k) {
    None => hk
    Some(data) => ih(
      data,
      kle_trans(
        dbase(data),
        pfst(
          field_kind_list(
            d,
            args,
            false,
            generics_picked(dgen(data), dholds(data)),
            gs,
            Pair { fst: dbase(data), snd: holds }
          )
        ),
        k,
        fkl_fst(
          d,
          args,
          false,
          generics_picked(dgen(data), dholds(data)),
          gs,
          Pair { fst: dbase(data), snd: holds }
        ),
        hk
      ),
      hk,
      he
    )
  }
}

pub fn sub_named_k(n: Text, args: List(Ty), map: Ordmap(Text, Ty), b: Bool): Ty {
  match b: Ty {
    true => ty_substitute_name(n, map, TyNamed(n, Nil(Ty)))
    false => TyNamed(n, ty_map_list(args, map))
  }
}

pub theorem sub_named_unf(
  n: Text,
  args: List(Ty),
  map: Ordmap(Text, Ty)
): ty_substitute(TyNamed(n, args), map) = sub_named_k(n, args, map, ty_no_args(args)) {
  Refl
}

pub theorem no_args_nil(
  args: List(Ty),
  e: ty_no_args(args) = true
): args = Nil(Ty) {
  match args: args = Nil(Ty) {
    Nil => Refl
    Cons(a, more) => False::elim(false_ne_true(e))
  }
}

pub theorem fk_named_ok(
  d: Datas,
  n: Text,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text),
  map: Ordmap(Text, Ty),
  k: Kind,
  mk: MapKeys(map, gs),
  mc: MapCover(map, gs),
  na: Bool,
  ena: ty_no_args(args) = na,
  hk: KLe(pfst(fkn_k(d, n, args, gs, holds, Bool::and(na, list_has_text(gs, n)))), k),
  he: Env(d, map, psnd(fkn_k(d, n, args, gs, holds, Bool::and(na, list_has_text(gs, n)))), k),
  ih: ∀ data: Data. (
    KLe(dbase(data), k)
  ) -> (
    KLe(
      pfst(
        field_kind_list(
          d,
          args,
          false,
          generics_picked(dgen(data), dholds(data)),
          gs,
          Pair { fst: dbase(data), snd: holds }
        )
      ),
      k
    )
  ) -> (
    Env(
      d,
      map,
      psnd(
        field_kind_list(
          d,
          args,
          false,
          generics_picked(dgen(data), dholds(data)),
          gs,
          Pair { fst: dbase(data), snd: holds }
        )
      ),
      k
    )
  ) -> KLe(
    datas_kind_list(
      d,
      ty_map_list(args, map),
      false,
      generics_picked(dgen(data), dholds(data)),
      dbase(data)
    ),
    k
  )
): KLe(datas_kind(d, sub_named_k(n, args, map, na)), k) {
  match na: KLe(datas_kind(d, sub_named_k(n, args, map, na)), k) {
    true => Eq::subst(
      (z: Ty) => KLe(datas_kind(d, z), k),
      Eq::sym(sn_unf(n, map, TyNamed(n, Nil(Ty)))),
      fk_name_ok(
        d,
        n,
        gs,
        holds,
        map,
        k,
        mk,
        mc,
        list_has_text(gs, n),
        Refl,
        Ordmap::get(map, n, Ordmap::compare_text),
        Refl,
        Eq::subst(
          (z: List(Ty)) => KLe(pfst(fkn_k(d, n, z, gs, holds, list_has_text(gs, n))), k),
          no_args_nil(args, ena),
          hk
        ),
        Eq::subst(
          (z: List(Ty)) => Env(d, map, psnd(fkn_k(d, n, z, gs, holds, list_has_text(gs, n))), k),
          no_args_nil(args, ena),
          he
        )
      )
    )
    false => Eq::subst(
      (z: Kind) => KLe(z, k),
      Eq::sym(kind_named_unf(d, n, ty_map_list(args, map))),
      fk_cons_ok(d, n, args, gs, holds, map, k, datas_decl(d, n), hk, he, ih)
    )
  }
}

pub theorem fklp_ok(
  d: Datas,
  t: Ty,
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  kacc: Kind,
  map: Ordmap(Text, Ty),
  k: Kind,
  p: Bool,
  sigt: Ty,
  hacc: KLe(kacc, k),
  iht: (
    KLe(pfst(field_kind(d, t, gs, psnd(acc))), k)
  ) -> (Env(d, map, psnd(field_kind(d, t, gs, psnd(acc))), k)) -> KLe(datas_kind(d, sigt), k),
  hk: KLe(pfst(fkl_pick(d, t, gs, acc, p)), k),
  he: Env(d, map, psnd(fkl_pick(d, t, gs, acc, p)), k)
): KLe(dkl_pick(d, sigt, kacc, p), k) {
  match p: KLe(dkl_pick(d, sigt, kacc, p), k) {
    true => kle_lub(
      kacc,
      datas_kind(d, sigt),
      k,
      hacc,
      iht(split_r(pfst(acc), pfst(field_kind(d, t, gs, psnd(acc))), k, hk), he)
    )
    false => hacc
  }
}

pub theorem fklk_ok(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  kacc: Kind,
  map: Ordmap(Text, Ty),
  k: Kind,
  go: Bool,
  sigt: Ty,
  sigrest: List(Ty),
  hacc: KLe(kacc, k),
  iht: (
    KLe(pfst(field_kind(d, t, gs, psnd(acc))), k)
  ) -> (Env(d, map, psnd(field_kind(d, t, gs, psnd(acc))), k)) -> KLe(datas_kind(d, sigt), k),
  ihr: ∀ a: Pair(
    Kind,
    List(Text)
  ). ∀ ka: Kind. (
    KLe(ka, k)
  ) -> (
    KLe(pfst(field_kind_list(d, rest, every, picks_tail(picks), gs, a)), k)
  ) -> (
    Env(d, map, psnd(field_kind_list(d, rest, every, picks_tail(picks), gs, a)), k)
  ) -> KLe(datas_kind_list(d, sigrest, every, picks_tail(picks), ka), k),
  hk: KLe(pfst(fkl_k(d, t, rest, every, picks, gs, acc, go)), k),
  he: Env(d, map, psnd(fkl_k(d, t, rest, every, picks, gs, acc, go)), k)
): KLe(dkl_k(d, sigt, sigrest, every, picks, kacc, go), k) {
  match go: KLe(dkl_k(d, sigt, sigrest, every, picks, kacc, go), k) {
    false => hacc
    true => ihr(
      fkl_pick(d, t, gs, acc, picks_head(every, picks)),
      dkl_pick(d, sigt, kacc, picks_head(every, picks)),
      fklp_ok(
        d,
        t,
        gs,
        acc,
        kacc,
        map,
        k,
        picks_head(every, picks),
        sigt,
        hacc,
        iht,
        kle_trans(
          pfst(fkl_pick(d, t, gs, acc, picks_head(every, picks))),
          pfst(
            field_kind_list(
              d,
              rest,
              every,
              picks_tail(picks),
              gs,
              fkl_pick(d, t, gs, acc, picks_head(every, picks))
            )
          ),
          k,
          fkl_fst(
            d,
            rest,
            every,
            picks_tail(picks),
            gs,
            fkl_pick(d, t, gs, acc, picks_head(every, picks))
          ),
          hk
        ),
        env_sub(
          d,
          map,
          psnd(fkl_pick(d, t, gs, acc, picks_head(every, picks))),
          psnd(
            field_kind_list(
              d,
              rest,
              every,
              picks_tail(picks),
              gs,
              fkl_pick(d, t, gs, acc, picks_head(every, picks))
            )
          ),
          k,
          he,
          g => mg => fkl_grow(
            d,
            rest,
            every,
            picks_tail(picks),
            gs,
            fkl_pick(d, t, gs, acc, picks_head(every, picks)),
            g,
            mg
          )
        )
      ),
      hk,
      he
    )
  }
}

mutual {
  pub theorem fkl_sound(
    d: Datas,
    ts: List(Ty),
    every: Bool,
    picks: List(Bool),
    gs: List(Text),
    acc: Pair(Kind, List(Text)),
    kacc: Kind,
    map: Ordmap(Text, Ty),
    k: Kind,
    mk: MapKeys(map, gs),
    mc: MapCover(map, gs),
    hacc: KLe(kacc, k),
    hk: KLe(pfst(field_kind_list(d, ts, every, picks, gs, acc)), k),
    he: Env(d, map, psnd(field_kind_list(d, ts, every, picks, gs, acc)), k)
  ): KLe(datas_kind_list(d, ty_map_list(ts, map), every, picks, kacc), k) {
    match ts: KLe(datas_kind_list(d, ty_map_list(ts, map), every, picks, kacc), k) {
      Nil => hacc
      Cons(t, rest) => Eq::subst(
        (z: Kind) => KLe(z, k),
        Eq::sym(dkl_unf(d, ty_substitute(t, map), ty_map_list(rest, map), every, picks, kacc)),
        fklk_ok(
          d,
          t,
          rest,
          every,
          picks,
          gs,
          acc,
          kacc,
          map,
          k,
          Bool::or(every, not(Nat::eq(list_len(picks), 0))),
          ty_substitute(t, map),
          ty_map_list(rest, map),
          hacc,
          h1 => h2 => fk_sound(d, t, gs, psnd(acc), map, k, mk, mc, h1, h2),
          a => ka => h1 => h2 => h3 => fkl_sound(
            d,
            rest,
            every,
            picks_tail(picks),
            gs,
            a,
            ka,
            map,
            k,
            mk,
            mc,
            h1,
            h2,
            h3
          ),
          Eq::subst(
            (z: Pair(Kind, List(Text))) => KLe(pfst(z), k),
            fkl_unf(d, t, rest, every, picks, gs, acc),
            hk
          ),
          Eq::subst(
            (z: Pair(Kind, List(Text))) => Env(d, map, psnd(z), k),
            fkl_unf(d, t, rest, every, picks, gs, acc),
            he
          )
        )
      )
    }
  }

  // The kind of `t` at the arguments `map` gives is below `k` when what
  // `field_kind` says of `t` is: its kind and each argument it holds.
  pub theorem fk_sound(
    d: Datas,
    t: Ty,
    gs: List(Text),
    holds: List(Text),
    map: Ordmap(Text, Ty),
    k: Kind,
    mk: MapKeys(map, gs),
    mc: MapCover(map, gs),
    hk: KLe(pfst(field_kind(d, t, gs, holds)), k),
    he: Env(d, map, psnd(field_kind(d, t, gs, holds)), k)
  ): KLe(datas_kind(d, ty_substitute(t, map)), k) {
    match t: KLe(datas_kind(d, ty_substitute(t, map)), k) {
      TyInt(w) => hk
      TyBool => hk
      TyText => hk
      TyUnit => hk
      TyNever => hk
      TyDecimal => hk
      TyFloat => hk
      TyFn(ps, r, fk) => hk
      TyUnion(ts) => union_le(
        d,
        ty_map_list(ts, map),
        k,
        fkl_sound(
          d,
          ts,
          true,
          Nil(Bool),
          gs,
          Pair { fst: KindCopy, snd: holds },
          KindCopy,
          map,
          k,
          mk,
          mc,
          kle_copy(k),
          hk,
          he
        )
      )
      TyProduct(ts) => product_le(
        d,
        ty_map_list(ts, map),
        k,
        fkl_sound(
          d,
          ts,
          true,
          Nil(Bool),
          gs,
          Pair { fst: KindCopy, snd: holds },
          KindCopy,
          map,
          k,
          mk,
          mc,
          kle_copy(k),
          hk,
          he
        )
      )
      TyTagged(tags, x) => Eq::subst(
        (z: Kind) => KLe(z, k),
        Eq::sym(kind_tagged(d, tags, ty_substitute(x, map))),
        fk_sound(d, x, gs, holds, map, k, mk, mc, hk, he)
      )
      TyNamed(n, args) => Eq::subst(
        (z: Ty) => KLe(datas_kind(d, z), k),
        Eq::sym(sub_named_unf(n, args, map)),
        fk_named_ok(
          d,
          n,
          args,
          gs,
          holds,
          map,
          k,
          mk,
          mc,
          ty_no_args(args),
          Refl,
          Eq::subst(
            (z: Pair(Kind, List(Text))) => KLe(pfst(z), k),
            fk_named_unf(d, n, args, gs, holds),
            hk
          ),
          Eq::subst(
            (z: Pair(Kind, List(Text))) => Env(d, map, psnd(z), k),
            fk_named_unf(d, n, args, gs, holds),
            he
          ),
          data => hb => h2 => h3 => fkl_sound(
            d,
            args,
            false,
            generics_picked(dgen(data), dholds(data)),
            gs,
            Pair { fst: dbase(data), snd: holds },
            dbase(data),
            map,
            k,
            mk,
            mc,
            hb,
            h2,
            h3
          )
        )
      )
      TyParam(n, pk) => Eq::subst(
        (z: Ty) => KLe(datas_kind(d, z), k),
        Eq::sym(sn_unf(n, map, TyParam(n, pk))),
        fk_param_ok(
          d,
          n,
          pk,
          gs,
          holds,
          map,
          k,
          mk,
          mc,
          list_has_text(gs, n),
          Refl,
          Ordmap::get(map, n, Ordmap::compare_text),
          Refl,
          Eq::subst(
            (z: Pair(Kind, List(Text))) => KLe(pfst(z), k),
            fk_param_unf(d, n, pk, gs, holds),
            hk
          ),
          Eq::subst(
            (z: Pair(Kind, List(Text))) => Env(d, map, psnd(z), k),
            fk_param_unf(d, n, pk, gs, holds),
            he
          )
        )
      )
      TyInfo(x) => hk
      TyBorrow(x, mu) => fk_sound(d, x, gs, holds, map, k, mk, mc, hk, he)
      TyVar(v) => hk
      TyApp(h, x) => apply_le(
        d,
        ty_substitute(h, map),
        ty_substitute(x, map),
        k,
        fk_sound(
          d,
          h,
          gs,
          holds,
          map,
          k,
          mk,
          mc,
          split_l(
            pfst(field_kind(d, h, gs, holds)),
            pfst(field_kind(d, x, gs, psnd(field_kind(d, h, gs, holds)))),
            k,
            hk
          ),
          env_sub(
            d,
            map,
            psnd(field_kind(d, h, gs, holds)),
            psnd(field_kind(d, x, gs, psnd(field_kind(d, h, gs, holds)))),
            k,
            he,
            g => mg => fk_grow(d, x, gs, psnd(field_kind(d, h, gs, holds)), g, mg)
          )
        ),
        fk_sound(
          d,
          x,
          gs,
          psnd(field_kind(d, h, gs, holds)),
          map,
          k,
          mk,
          mc,
          split_r(
            pfst(field_kind(d, h, gs, holds)),
            pfst(field_kind(d, x, gs, psnd(field_kind(d, h, gs, holds)))),
            k,
            hk
          ),
          he
        )
      )
      TyPoly(ps, x) => hk
    }
  }
}

// ----- the fields of a declaration -----

pub fn fty(f: DataField): Ty {
  f.ty
}

pub fn cfields(c: DataCtor): List(DataField) {
  c.fields
}

pub fn dctors(data: Data): List(DataCtor) {
  data.constructors
}

pub theorem fields_fst(
  d: Datas,
  fs: List(DataField),
  gs: List(Text),
  acc: Pair(Kind, List(Text))
): KLe(pfst(acc), pfst(fields_kind(d, fs, gs, acc))) {
  match fs: KLe(pfst(acc), pfst(fields_kind(d, fs, gs, acc))) {
    Nil => kle_refl(pfst(acc))
    Cons(f, rest) => kle_trans(
      pfst(acc),
      pfst(kind_pair_join(acc, field_kind(d, fty(f), gs, psnd(acc)))),
      pfst(fields_kind(d, rest, gs, kind_pair_join(acc, field_kind(d, fty(f), gs, psnd(acc))))),
      kle_join_l(pfst(acc), pfst(field_kind(d, fty(f), gs, psnd(acc)))),
      fields_fst(d, rest, gs, kind_pair_join(acc, field_kind(d, fty(f), gs, psnd(acc))))
    )
  }
}

pub theorem fields_grow(
  d: Datas,
  fs: List(DataField),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  g: Text,
  m: Mem(Text, g, psnd(acc))
): Mem(Text, g, psnd(fields_kind(d, fs, gs, acc))) {
  match fs: Mem(Text, g, psnd(fields_kind(d, fs, gs, acc))) {
    Nil => m
    Cons(f, rest) => fields_grow(
      d,
      rest,
      gs,
      kind_pair_join(acc, field_kind(d, fty(f), gs, psnd(acc))),
      g,
      fk_grow(d, fty(f), gs, psnd(acc), g, m)
    )
  }
}

pub theorem ctors_fst(
  d: Datas,
  cs: List(DataCtor),
  gs: List(Text),
  acc: Pair(Kind, List(Text))
): KLe(pfst(acc), pfst(ctors_kind(d, cs, gs, acc))) {
  match cs: KLe(pfst(acc), pfst(ctors_kind(d, cs, gs, acc))) {
    Nil => kle_refl(pfst(acc))
    Cons(c, rest) => kle_trans(
      pfst(acc),
      pfst(fields_kind(d, cfields(c), gs, acc)),
      pfst(ctors_kind(d, rest, gs, fields_kind(d, cfields(c), gs, acc))),
      fields_fst(d, cfields(c), gs, acc),
      ctors_fst(d, rest, gs, fields_kind(d, cfields(c), gs, acc))
    )
  }
}

pub theorem ctors_grow(
  d: Datas,
  cs: List(DataCtor),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  g: Text,
  m: Mem(Text, g, psnd(acc))
): Mem(Text, g, psnd(ctors_kind(d, cs, gs, acc))) {
  match cs: Mem(Text, g, psnd(ctors_kind(d, cs, gs, acc))) {
    Nil => m
    Cons(c, rest) => ctors_grow(
      d,
      rest,
      gs,
      fields_kind(d, cfields(c), gs, acc),
      g,
      fields_grow(d, cfields(c), gs, acc, g, m)
    )
  }
}

// Each field of `fs` at the arguments is below `k` when what `fields_kind`
// says is.
pub theorem fields_ok(
  d: Datas,
  fs: List(DataField),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  map: Ordmap(Text, Ty),
  k: Kind,
  mk: MapKeys(map, gs),
  mc: MapCover(map, gs),
  hk: KLe(pfst(fields_kind(d, fs, gs, acc)), k),
  he: Env(d, map, psnd(fields_kind(d, fs, gs, acc)), k),
  f: DataField,
  mf: Mem(DataField, f, fs)
): KLe(datas_kind(d, ty_substitute(fty(f), map)), k) {
  match fs: KLe(datas_kind(d, ty_substitute(fty(f), map)), k) {
    Nil => Mem::nil(KLe(datas_kind(d, ty_substitute(fty(f), map)), k), mf)
    Cons(f0, rest) => Or::elim(
      mem_cons_inv(f0, rest, mf),
      q => Eq::subst(
        (z: DataField) => KLe(datas_kind(d, ty_substitute(fty(z), map)), k),
        Eq::sym(q),
        fk_sound(
          d,
          fty(f0),
          gs,
          psnd(acc),
          map,
          k,
          mk,
          mc,
          split_r(
            pfst(acc),
            pfst(field_kind(d, fty(f0), gs, psnd(acc))),
            k,
            kle_trans(
              pfst(kind_pair_join(acc, field_kind(d, fty(f0), gs, psnd(acc)))),
              pfst(
                fields_kind(d, rest, gs, kind_pair_join(acc, field_kind(d, fty(f0), gs, psnd(acc))))
              ),
              k,
              fields_fst(d, rest, gs, kind_pair_join(acc, field_kind(d, fty(f0), gs, psnd(acc)))),
              hk
            )
          ),
          env_sub(
            d,
            map,
            psnd(field_kind(d, fty(f0), gs, psnd(acc))),
            psnd(
              fields_kind(d, rest, gs, kind_pair_join(acc, field_kind(d, fty(f0), gs, psnd(acc))))
            ),
            k,
            he,
            g => mg => fields_grow(
              d,
              rest,
              gs,
              kind_pair_join(acc, field_kind(d, fty(f0), gs, psnd(acc))),
              g,
              mg
            )
          )
        )
      ),
      r => fields_ok(
        d,
        rest,
        gs,
        kind_pair_join(acc, field_kind(d, fty(f0), gs, psnd(acc))),
        map,
        k,
        mk,
        mc,
        hk,
        he,
        f,
        r
      )
    )
  }
}

pub theorem ctors_ok(
  d: Datas,
  cs: List(DataCtor),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  map: Ordmap(Text, Ty),
  k: Kind,
  mk: MapKeys(map, gs),
  mc: MapCover(map, gs),
  hk: KLe(pfst(ctors_kind(d, cs, gs, acc)), k),
  he: Env(d, map, psnd(ctors_kind(d, cs, gs, acc)), k),
  c: DataCtor,
  mcs: Mem(DataCtor, c, cs),
  f: DataField,
  mf: Mem(DataField, f, cfields(c))
): KLe(datas_kind(d, ty_substitute(fty(f), map)), k) {
  match cs: KLe(datas_kind(d, ty_substitute(fty(f), map)), k) {
    Nil => Mem::nil(KLe(datas_kind(d, ty_substitute(fty(f), map)), k), mcs)
    Cons(c0, rest) => Or::elim(
      mem_cons_inv(c0, rest, mcs),
      q => fields_ok(
        d,
        cfields(c0),
        gs,
        acc,
        map,
        k,
        mk,
        mc,
        kle_trans(
          pfst(fields_kind(d, cfields(c0), gs, acc)),
          pfst(ctors_kind(d, rest, gs, fields_kind(d, cfields(c0), gs, acc))),
          k,
          ctors_fst(d, rest, gs, fields_kind(d, cfields(c0), gs, acc)),
          hk
        ),
        env_sub(
          d,
          map,
          psnd(fields_kind(d, cfields(c0), gs, acc)),
          psnd(ctors_kind(d, rest, gs, fields_kind(d, cfields(c0), gs, acc))),
          k,
          he,
          g => mg => ctors_grow(d, rest, gs, fields_kind(d, cfields(c0), gs, acc), g, mg)
        ),
        f,
        Eq::subst((z: DataCtor) => Mem(DataField, f, cfields(z)), q, mf)
      ),
      r => ctors_ok(
        d,
        rest,
        gs,
        fields_kind(d, cfields(c0), gs, acc),
        map,
        k,
        mk,
        mc,
        hk,
        he,
        c,
        r,
        f,
        mf
      )
    )
  }
}

// ----- the arguments of an instance -----

pub fn opt_is_some(o: Option(Ty)): Bool {
  match o: Bool {
    Some(x) => true
    None => false
  }
}

pub theorem some_inj(x: Ty, y: Ty, e: Some(x) = Some(y)): x = y {
  Eq::congr((z: Option(Ty)) => sn_k(x, z), e)
}

pub theorem none_ne_some(x: Ty, e: None(Ty) = Some(x)): False {
  false_ne_true(Eq::congr(opt_is_some, e))
}

// Looking up `n` after inserting `g`: what was inserted, at `g`, or what was
// there before.
pub theorem get_insert_k(
  m: Ordmap(Text, Ty),
  g: Text,
  a: Ty,
  n: Text,
  om: Ordmap::ordered(m, Ordmap::compare_text),
  o: Ordering,
  eo: Ordmap::compare_text(n, g) = o
): Or(
  And(
    n = g,
    Ordmap::get(Ordmap::insert(m, g, a, Ordmap::compare_text), n, Ordmap::compare_text) = Some(a)
  ),
  Ordmap::get(Ordmap::insert(m, g, a, Ordmap::compare_text), n, Ordmap::compare_text) = Ordmap::get(m, n, Ordmap::compare_text)
) {
  match o: (
    Ordmap::compare_text(n, g) = o
  ) -> Or(
    And(
      n = g,
      Ordmap::get(Ordmap::insert(m, g, a, Ordmap::compare_text), n, Ordmap::compare_text) = Some(a)
    ),
    Ordmap::get(Ordmap::insert(m, g, a, Ordmap::compare_text), n, Ordmap::compare_text) = Ordmap::get(m, n, Ordmap::compare_text)
  ) {
    Equal => (e: Ordmap::compare_text(n, g) = Equal) => OrInl(
      AndIntro(
        Ordmap::compare_text_eq(n, g, e),
        Eq::subst(
          (z: Text) => Ordmap::get(Ordmap::insert(m, g, a, Ordmap::compare_text), z, Ordmap::compare_text) = Some(a),
          Eq::sym(Ordmap::compare_text_eq(n, g, e)),
          Ordmap::text_get_insert_same(m, g, a, om)
        )
      )
    )
    Less => (e: Ordmap::compare_text(n, g) = Less) => OrInr(
      Ordmap::get_insert_other(
        Ordmap::compare_text,
        Ordmap::compare_text_law(),
        m,
        g,
        a,
        n,
        Less,
        (q: Less = Equal) => less_ne_equal(q),
        e,
        om
      )
    )
    Greater => (e: Ordmap::compare_text(n, g) = Greater) => OrInr(
      Ordmap::get_insert_other(
        Ordmap::compare_text,
        Ordmap::compare_text_law(),
        m,
        g,
        a,
        n,
        Greater,
        (q: Greater = Equal) => greater_ne_equal(q),
        e,
        om
      )
    )
  }(eo)
}

pub theorem get_insert(
  m: Ordmap(Text, Ty),
  g: Text,
  a: Ty,
  n: Text,
  om: Ordmap::ordered(m, Ordmap::compare_text)
): Or(
  And(
    n = g,
    Ordmap::get(Ordmap::insert(m, g, a, Ordmap::compare_text), n, Ordmap::compare_text) = Some(a)
  ),
  Ordmap::get(Ordmap::insert(m, g, a, Ordmap::compare_text), n, Ordmap::compare_text) = Ordmap::get(m, n, Ordmap::compare_text)
) {
  get_insert_k(m, g, a, n, om, Ordmap::compare_text(n, g), Refl)
}

// The keys of an instance are generics.
pub theorem inst_keys(
  gs: List(Text),
  args: List(Ty),
  m: Ordmap(Text, Ty),
  all: List(Text),
  om: Ordmap::ordered(m, Ordmap::compare_text),
  hm: MapKeys(m, all),
  sub: ∀ g: Text. (Mem(Text, g, gs)) -> Mem(Text, g, all)
): MapKeys(data_instance_from(gs, args, m), all) {
  match gs: MapKeys(data_instance_from(gs, args, m), all) {
    Nil => hm
    Cons(g, rest) => match args: MapKeys(data_instance_from(Cons(g, rest), args, m), all) {
      Nil => hm
      Cons(a, more) => inst_keys(
        rest,
        more,
        Ordmap::insert(m, g, a, Ordmap::compare_text),
        all,
        Ordmap::insert_ordered(Ordmap::compare_text, Ordmap::compare_text_law(), m, g, a, om),
        n => x => e => Or::elim(
          get_insert(m, g, a, n, om),
          q => Eq::subst(
            (z: Text) => Mem(Text, z, all),
            Eq::sym(And::left(q)),
            sub(g, MemHere(Text, g, rest))
          ),
          q => hm(n, x, Eq::trans(Eq::sym(q), e))
        ),
        h => mh => sub(h, MemThere(Text, h, g, rest, mh))
      )
    }
  }
}

// Every generic has an argument.
pub fn args_cover(gs: List(Text), args: List(Ty)): Bool {
  match gs: Bool {
    Nil => true
    Cons(g, rest) => match args: Bool {
      Nil => false
      Cons(a, more) => args_cover(rest, more)
    }
  }
}

pub def CoverOr(
  map: Ordmap(Text, Ty),
  gs: List(Text),
  cov: List(Text)
): Prop := ∀ n: Text. (
  Or(Mem(Text, n, gs), Mem(Text, n, cov))
) -> (Ordmap::get(map, n, Ordmap::compare_text) = None(Ty)) -> False

pub theorem inst_cover_at(
  gs: List(Text),
  args: List(Ty),
  m: Ordmap(Text, Ty),
  cov: List(Text),
  om: Ordmap::ordered(m, Ordmap::compare_text),
  hm: MapCover(m, cov),
  ha: args_cover(gs, args) = true,
  n: Text,
  o: Or(Mem(Text, n, gs), Mem(Text, n, cov)),
  e: Ordmap::get(data_instance_from(gs, args, m), n, Ordmap::compare_text) = None(Ty)
): False {
  match gs: False {
    Nil => Or::elim(o, mn => Mem::nil(False, mn), mn => hm(n, mn, e))
    Cons(g, rest) => match args: False {
      Nil => false_ne_true(ha)
      Cons(a, more) => inst_cover_at(
        rest,
        more,
        Ordmap::insert(m, g, a, Ordmap::compare_text),
        Cons(g, cov),
        Ordmap::insert_ordered(Ordmap::compare_text, Ordmap::compare_text_law(), m, g, a, om),
        n2 => mn => e2 => Or::elim(
          get_insert(m, g, a, n2, om),
          q => none_ne_some(a, Eq::trans(Eq::sym(e2), And::right(q))),
          q => Or::elim(
            mem_cons_inv(g, cov, mn),
            q2 => none_ne_some(
              a,
              Eq::trans(
                Eq::sym(e2),
                Eq::subst(
                  (z: Text) => Ordmap::get(Ordmap::insert(m, g, a, Ordmap::compare_text), z, Ordmap::compare_text) = Some(a),
                  Eq::sym(q2),
                  Ordmap::text_get_insert_same(m, g, a, om)
                )
              )
            ),
            q2 => hm(n2, q2, Eq::trans(Eq::sym(q), e2))
          )
        ),
        ha,
        n,
        Or::elim(
          o,
          mn => Or::elim(
            mem_cons_inv(g, rest, mn),
            q => OrInr(mem_of_eq(n, g, cov, q)),
            q => OrInl(q)
          ),
          mn => OrInr(MemThere(Text, n, g, cov, mn))
        ),
        e
      )
    }
  }
}

// The argument an instance gives a held generic is below the kind of the
// instance.
pub theorem inst_env_at(
  d: Datas,
  gs: List(Text),
  args: List(Ty),
  m: Ordmap(Text, Ty),
  hs: List(Text),
  acc: Kind,
  om: Ordmap::ordered(m, Ordmap::compare_text),
  hm: ∀ n: Text. ∀ x: Ty. (
    Mem(Text, n, hs)
  ) -> (
    Ordmap::get(m, n, Ordmap::compare_text) = Some(x)
  ) -> KLe(datas_kind(d, x), datas_kind_list(d, args, false, generics_picked(gs, hs), acc)),
  n: Text,
  x: Ty,
  mn: Mem(Text, n, hs),
  e: Ordmap::get(data_instance_from(gs, args, m), n, Ordmap::compare_text) = Some(x)
): KLe(datas_kind(d, x), datas_kind_list(d, args, false, generics_picked(gs, hs), acc)) {
  match gs: KLe(datas_kind(d, x), datas_kind_list(d, args, false, generics_picked(gs, hs), acc)) {
    Nil => hm(n, x, mn, e)
    Cons(g, rest) => match args: KLe(
      datas_kind(d, x),
      datas_kind_list(d, args, false, generics_picked(Cons(g, rest), hs), acc)
    ) {
      Nil => hm(n, x, mn, e)
      Cons(a, more) => inst_env_at(
        d,
        rest,
        more,
        Ordmap::insert(m, g, a, Ordmap::compare_text),
        hs,
        dkl_pick(d, a, acc, list_has_text(hs, g)),
        Ordmap::insert_ordered(Ordmap::compare_text, Ordmap::compare_text_law(), m, g, a, om),
        n2 => x2 => mn2 => e2 => Or::elim(
          get_insert(m, g, a, n2, om),
          q => Eq::subst(
            (z: Ty) => KLe(
              datas_kind(d, z),
              datas_kind_list(
                d,
                more,
                false,
                generics_picked(rest, hs),
                dkl_pick(d, a, acc, list_has_text(hs, g))
              )
            ),
            Eq::sym(some_inj(x2, a, Eq::trans(Eq::sym(e2), And::right(q)))),
            Eq::subst(
              (z: Bool) => KLe(
                datas_kind(d, a),
                datas_kind_list(d, more, false, generics_picked(rest, hs), dkl_pick(d, a, acc, z))
              ),
              Eq::sym(lht_complete(Eq::subst((z: Text) => Mem(Text, z, hs), And::left(q), mn2))),
              kle_trans(
                datas_kind(d, a),
                kind_join(acc, datas_kind(d, a)),
                datas_kind_list(
                  d,
                  more,
                  false,
                  generics_picked(rest, hs),
                  kind_join(acc, datas_kind(d, a))
                ),
                kle_join_r(acc, datas_kind(d, a)),
                dkl_ge_acc(d, more, false, generics_picked(rest, hs), kind_join(acc, datas_kind(d, a)))
              )
            )
          ),
          q => hm(n2, x2, mn2, Eq::trans(Eq::sym(q), e2))
        ),
        n,
        x,
        mn,
        e
      )
    }
  }
}

// ----- the kind of a declared type -----

pub fn drec(data: Data): Bool {
  data.recursive
}

pub def HoldsOk(
  d: Datas,
  data: Data
): Prop := ∀ g: Text. (
  Mem(
    Text,
    g,
    psnd(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) }))
  )
) -> Mem(Text, g, dholds(data))

pub def RecOk(data: Data): Prop := (drec(data) = true) -> KLe(KindShared, dbase(data))

pub def UnmentionedOk(
  data: Data
): Prop := ∀ g: Text. (
  Mem(Text, g, dgen(data))
) -> (data_mentions(data, g) = false) -> Mem(Text, g, dholds(data))

// The summary of `data` is a solution: its fields add nothing, and it starts
// from the least summary.
pub def DataOk(
  d: Datas,
  data: Data
): Prop := And(
  KLe(
    pfst(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) })),
    dbase(data)
  ),
  And(
    HoldsOk(d, data),
    And(KLe(data_declared_kind(data), dbase(data)), And(RecOk(data), UnmentionedOk(data)))
  )
)

pub def SummaryOk(
  d: Datas
): Prop := ∀ n: Text. ∀ data: Data. (
  datas_decl(d, n) = Some(data)
) -> DataOk(d, data)

pub fn inst_bound(d: Datas, data: Data, args: List(Ty)): Kind {
  datas_kind_list(d, args, false, generics_picked(dgen(data), dholds(data)), dbase(data))
}

pub theorem kind_inst_eq(
  d: Datas,
  n: Text,
  data: Data,
  args: List(Ty),
  ed: datas_decl(d, n) = Some(data)
): datas_kind(d, TyNamed(n, args)) = inst_bound(d, data, args) {
  Eq::trans(kind_named_unf(d, n, args), Eq::congr((o: Option(Data)) => kn_k(d, n, args, o), ed))
}

pub theorem empty_keys(all: List(Text)): MapKeys(Ordmap::empty(), all) {
  n => x => e => False::elim(none_ne_some(x, e))
}

pub theorem inst_map_keys(
  data: Data,
  args: List(Ty)
): MapKeys(data_instance(data, args), dgen(data)) {
  inst_keys(
    dgen(data),
    args,
    Ordmap::empty(),
    dgen(data),
    Ordmap::empty_ordered(Ordmap::compare_text),
    empty_keys(dgen(data)),
    g => m => m
  )
}

pub theorem inst_map_cover(
  data: Data,
  args: List(Ty),
  ha: args_cover(dgen(data), args) = true
): MapCover(data_instance(data, args), dgen(data)) {
  n => mn => e => inst_cover_at(
    dgen(data),
    args,
    Ordmap::empty(),
    Nil(Text),
    Ordmap::empty_ordered(Ordmap::compare_text),
    n2 => m2 => e2 => Mem::nil(False, m2),
    ha,
    n,
    OrInl(mn),
    e
  )
}

pub theorem inst_map_env(
  d: Datas,
  data: Data,
  args: List(Ty)
): Env(d, data_instance(data, args), dholds(data), inst_bound(d, data, args)) {
  n => x => mn => e => inst_env_at(
    d,
    dgen(data),
    args,
    Ordmap::empty(),
    dholds(data),
    dbase(data),
    Ordmap::empty_ordered(Ordmap::compare_text),
    n2 => x2 => mn2 => e2 => False::elim(none_ne_some(x2, e2)),
    n,
    x,
    mn,
    e
  )
}

// Each field of `D` at `args` is below the kind of `D(args)`.
pub theorem kind_field_le(
  d: Datas,
  ok: SummaryOk(d),
  n: Text,
  data: Data,
  args: List(Ty),
  ed: datas_decl(d, n) = Some(data),
  ha: args_cover(dgen(data), args) = true,
  c: DataCtor,
  mcs: Mem(DataCtor, c, dctors(data)),
  f: DataField,
  mf: Mem(DataField, f, cfields(c))
): KLe(
  datas_kind(d, ty_substitute(fty(f), data_instance(data, args))),
  datas_kind(d, TyNamed(n, args))
) {
  Eq::subst(
    (z: Kind) => KLe(datas_kind(d, ty_substitute(fty(f), data_instance(data, args))), z),
    Eq::sym(kind_inst_eq(d, n, data, args, ed)),
    ctors_ok(
      d,
      dctors(data),
      dgen(data),
      Pair { fst: dbase(data), snd: dholds(data) },
      data_instance(data, args),
      inst_bound(d, data, args),
      inst_map_keys(data, args),
      inst_map_cover(data, args, ha),
      kle_trans(
        pfst(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) })),
        dbase(data),
        inst_bound(d, data, args),
        And::left(ok(n, data, ed)),
        dkl_ge_acc(d, args, false, generics_picked(dgen(data), dholds(data)), dbase(data))
      ),
      env_sub(
        d,
        data_instance(data, args),
        psnd(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) })),
        dholds(data),
        inst_bound(d, data, args),
        inst_map_env(d, data, args),
        And::left(And::right(ok(n, data, ed)))
      ),
      c,
      mcs,
      f,
      mf
    )
  )
}

// The declared kind is below the kind of `D(args)`.
pub theorem kind_declared_le(
  d: Datas,
  ok: SummaryOk(d),
  n: Text,
  data: Data,
  args: List(Ty),
  ed: datas_decl(d, n) = Some(data)
): KLe(data_declared_kind(data), datas_kind(d, TyNamed(n, args))) {
  Eq::subst(
    (z: Kind) => KLe(data_declared_kind(data), z),
    Eq::sym(kind_inst_eq(d, n, data, args, ed)),
    kle_trans(
      data_declared_kind(data),
      dbase(data),
      inst_bound(d, data, args),
      And::left(And::right(And::right(ok(n, data, ed)))),
      dkl_ge_acc(d, args, false, generics_picked(dgen(data), dholds(data)), dbase(data))
    )
  )
}

// A recursive type is at least shared.
pub theorem kind_recursive_le(
  d: Datas,
  ok: SummaryOk(d),
  n: Text,
  data: Data,
  args: List(Ty),
  ed: datas_decl(d, n) = Some(data),
  er: drec(data) = true
): KLe(KindShared, datas_kind(d, TyNamed(n, args))) {
  Eq::subst(
    (z: Kind) => KLe(KindShared, z),
    Eq::sym(kind_inst_eq(d, n, data, args, ed)),
    kle_trans(
      KindShared,
      dbase(data),
      inst_bound(d, data, args),
      And::left(And::right(And::right(And::right(ok(n, data, ed)))))(er),
      dkl_ge_acc(d, args, false, generics_picked(dgen(data), dholds(data)), dbase(data))
    )
  )
}

// The argument for a generic no field mentions is below the kind of
// `D(args)`: `Vec(A)` holds its `A`s.
pub theorem kind_unmentioned_le(
  d: Datas,
  ok: SummaryOk(d),
  n: Text,
  data: Data,
  args: List(Ty),
  ed: datas_decl(d, n) = Some(data),
  g: Text,
  mg: Mem(Text, g, dgen(data)),
  un: data_mentions(data, g) = false,
  x: Ty,
  e: Ordmap::get(data_instance(data, args), g, Ordmap::compare_text) = Some(x)
): KLe(datas_kind(d, x), datas_kind(d, TyNamed(n, args))) {
  Eq::subst(
    (z: Kind) => KLe(datas_kind(d, x), z),
    Eq::sym(kind_inst_eq(d, n, data, args, ed)),
    inst_map_env(
      d,
      data,
      args
    )(g, x, And::right(And::right(And::right(And::right(ok(n, data, ed)))))(g, mg, un), e)
  )
}
