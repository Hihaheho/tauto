import "../../identity/src/identity.taut"
import "rules_written_name.taut"
import "types_decl.taut"
import "types_decl_head.taut"
import std::map
import std::text
import "ty.taut"

pub fn written_name_lookup(name: Text, o: Option(Ty)): Ty {
  match o {
    None => TyNamed(NameSpelled(name), Nil)
    Some(t) => t
  }
}
pub fn written_name_primitive_lookup(name: Text, generics: Ordmap(Text, Ty), o: Option(Ty)): Ty {
  match o {
    None => written_name_lookup(name, Ordmap::get(generics, name, Ordmap::compare_text))
    Some(t) => t
  }
}

pub theorem written_name_lookup_sound(
  name: Text,
  generics: Ordmap(Text, Ty),
  o: Option(Ty),
  ordinary: primitive_type_name(name) = None,
  found: Ordmap::get(generics, name, Ordmap::compare_text) = o
): WrittenTypeName(generics, name, written_name_lookup(name, o)) {
  match o {
    None => WrittenNameNominal(ordinary, found)
    Some(t) => WrittenNameParameter(t, ordinary, found)
  }
}

pub theorem written_name_primitive_lookup_sound(
  name: Text,
  generics: Ordmap(Text, Ty),
  o: Option(Ty),
  builtin: primitive_type_name(name) = o
): WrittenTypeName(generics, name, written_name_primitive_lookup(name, generics, o)) {
  match o {
    None => written_name_lookup_sound(
      name,
      generics,
      Ordmap::get(generics, name, Ordmap::compare_text),
      builtin,
      Refl
    )
    Some(t) => WrittenNamePrimitive(t, builtin)
  }
}

pub fn written_name_choose(t: Ty, rest: Ty, b: Bool): Ty { match b {
    true => t
    false => rest
  } }
pub fn written_name_choose_option(
  t: Ty,
  rest: Option(Ty),
  b: Bool
): Option(Ty) { match b {
    true => Some(t)
    false => rest
  } }
pub theorem written_name_choose_sound(
  name: Text,
  generics: Ordmap(Text, Ty),
  t: Ty,
  rest: Ty,
  option: Option(Ty),
  b: Bool,
  tail: rest = written_name_primitive_lookup(name, generics, option)
): written_name_choose(
  t,
  rest,
  b
) = written_name_primitive_lookup(name, generics, written_name_choose_option(t, option, b)) {
  ⊢ written_name_choose(
    t,
    rest,
    b
  ) = written_name_primitive_lookup(name, generics, written_name_choose_option(t, option, b)) from match b {
    true => Refl
    false => tail
  }
}
pub theorem written_name_primitive_unf(
  name: Text,
  generics: Ordmap(Text, Ty)
): ck_written_name(
  name,
  generics
) = written_name_primitive_lookup(name, generics, primitive_type_name(name)) {
  let value0: Ty := written_name_lookup(name, Ordmap::get(generics, name, Ordmap::compare_text))
  let option0: Option(Ty) := None
  let equal0: value0 = written_name_primitive_lookup(name, generics, option0) := Refl
  let value00: Ty := written_name_choose(TyFloat32, value0, Text::eq(name, "Float32"))
  let option00: Option(Ty) := written_name_choose_option(TyFloat32, option0, Text::eq(name, "Float32"))
  let equal00: value00 = written_name_primitive_lookup(
    name,
    generics,
    option00
  ) := written_name_choose_sound(
    name,
    generics,
    TyFloat32,
    value0,
    option0,
    Text::eq(name, "Float32"),
    equal0
  )
  let value1: Ty := written_name_choose(TyFloat, value00, Text::eq(name, "Float"))
  let option1: Option(Ty) := written_name_choose_option(TyFloat, option00, Text::eq(name, "Float"))
  let equal1: value1 = written_name_primitive_lookup(
    name,
    generics,
    option1
  ) := written_name_choose_sound(
    name,
    generics,
    TyFloat,
    value00,
    option00,
    Text::eq(name, "Float"),
    equal00
  )
  let value2: Ty := written_name_choose(TyDecimal, value1, Text::eq(name, "Decimal"))
  let option2: Option(
    Ty
  ) := written_name_choose_option(TyDecimal, option1, Text::eq(name, "Decimal"))
  let equal2: value2 = written_name_primitive_lookup(
    name,
    generics,
    option2
  ) := written_name_choose_sound(
    name,
    generics,
    TyDecimal,
    value1,
    option1,
    Text::eq(name, "Decimal"),
    equal1
  )
  let value3: Ty := written_name_choose(TyNever, value2, Text::eq(name, "Never"))
  let option3: Option(Ty) := written_name_choose_option(TyNever, option2, Text::eq(name, "Never"))
  let equal3: value3 = written_name_primitive_lookup(
    name,
    generics,
    option3
  ) := written_name_choose_sound(
    name,
    generics,
    TyNever,
    value2,
    option2,
    Text::eq(name, "Never"),
    equal2
  )
  let value4: Ty := written_name_choose(TyText, value3, Text::eq(name, "Text"))
  let option4: Option(Ty) := written_name_choose_option(TyText, option3, Text::eq(name, "Text"))
  let equal4: value4 = written_name_primitive_lookup(
    name,
    generics,
    option4
  ) := written_name_choose_sound(
    name,
    generics,
    TyText,
    value3,
    option3,
    Text::eq(name, "Text"),
    equal3
  )
  let value5: Ty := written_name_choose(TyBool, value4, Text::eq(name, "Bool"))
  let option5: Option(Ty) := written_name_choose_option(TyBool, option4, Text::eq(name, "Bool"))
  let equal5: value5 = written_name_primitive_lookup(
    name,
    generics,
    option5
  ) := written_name_choose_sound(
    name,
    generics,
    TyBool,
    value4,
    option4,
    Text::eq(name, "Bool"),
    equal4
  )
  let value5h: Ty := written_name_choose(TyInt(WidthHost), value5, Text::eq(name, "uhost"))
  let option5h: Option(
    Ty
  ) := written_name_choose_option(TyInt(WidthHost), option5, Text::eq(name, "uhost"))
  let equal5h: value5h = written_name_primitive_lookup(
    name,
    generics,
    option5h
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(WidthHost),
    value5,
    option5,
    Text::eq(name, "uhost"),
    equal5
  )
  let value5u16: Ty := written_name_choose(TyInt(WidthU16), value5h, Text::eq(name, "u16"))
  let option5u16: Option(
    Ty
  ) := written_name_choose_option(TyInt(WidthU16), option5h, Text::eq(name, "u16"))
  let equal5u16: value5u16 = written_name_primitive_lookup(
    name,
    generics,
    option5u16
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(WidthU16),
    value5h,
    option5h,
    Text::eq(name, "u16"),
    equal5h
  )
  let value5i16: Ty := written_name_choose(TyInt(Width16), value5u16, Text::eq(name, "i16"))
  let option5i16: Option(
    Ty
  ) := written_name_choose_option(TyInt(Width16), option5u16, Text::eq(name, "i16"))
  let equal5i16: value5i16 = written_name_primitive_lookup(
    name,
    generics,
    option5i16
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(Width16),
    value5u16,
    option5u16,
    Text::eq(name, "i16"),
    equal5u16
  )
  let value5i8: Ty := written_name_choose(TyInt(Width8), value5i16, Text::eq(name, "i8"))
  let option5i8: Option(
    Ty
  ) := written_name_choose_option(TyInt(Width8), option5i16, Text::eq(name, "i8"))
  let equal5i8: value5i8 = written_name_primitive_lookup(
    name,
    generics,
    option5i8
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(Width8),
    value5i16,
    option5i16,
    Text::eq(name, "i8"),
    equal5i16
  )
  let value6: Ty := written_name_choose(TyInt(WidthU64), value5i8, Text::eq(name, "u64"))
  let option6: Option(
    Ty
  ) := written_name_choose_option(TyInt(WidthU64), option5i8, Text::eq(name, "u64"))
  let equal6: value6 = written_name_primitive_lookup(
    name,
    generics,
    option6
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(WidthU64),
    value5i8,
    option5i8,
    Text::eq(name, "u64"),
    equal5i8
  )
  let value7: Ty := written_name_choose(TyInt(WidthU32), value6, Text::eq(name, "u32"))
  let option7: Option(
    Ty
  ) := written_name_choose_option(TyInt(WidthU32), option6, Text::eq(name, "u32"))
  let equal7: value7 = written_name_primitive_lookup(
    name,
    generics,
    option7
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(WidthU32),
    value6,
    option6,
    Text::eq(name, "u32"),
    equal6
  )
  let value8: Ty := written_name_choose(TyInt(WidthU8), value7, Text::eq(name, "u8"))
  let option8: Option(
    Ty
  ) := written_name_choose_option(TyInt(WidthU8), option7, Text::eq(name, "u8"))
  let equal8: value8 = written_name_primitive_lookup(
    name,
    generics,
    option8
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(WidthU8),
    value7,
    option7,
    Text::eq(name, "u8"),
    equal7
  )
  let value9: Ty := written_name_choose(TyInt(Width64), value8, Text::eq(name, "i64"))
  let option9: Option(
    Ty
  ) := written_name_choose_option(TyInt(Width64), option8, Text::eq(name, "i64"))
  let equal9: value9 = written_name_primitive_lookup(
    name,
    generics,
    option9
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(Width64),
    value8,
    option8,
    Text::eq(name, "i64"),
    equal8
  )
  let value10: Ty := written_name_choose(TyInt(Width32), value9, Text::eq(name, "i32"))
  let option10: Option(
    Ty
  ) := written_name_choose_option(TyInt(Width32), option9, Text::eq(name, "i32"))
  let equal10: value10 = written_name_primitive_lookup(
    name,
    generics,
    option10
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(Width32),
    value9,
    option9,
    Text::eq(name, "i32"),
    equal9
  )
  let value11: Ty := written_name_choose(TyInt(WidthNat), value10, Text::eq(name, "nat"))
  let option11: Option(
    Ty
  ) := written_name_choose_option(TyInt(WidthNat), option10, Text::eq(name, "nat"))
  let equal11: value11 = written_name_primitive_lookup(
    name,
    generics,
    option11
  ) := written_name_choose_sound(
    name,
    generics,
    TyInt(WidthNat),
    value10,
    option10,
    Text::eq(name, "nat"),
    equal10
  )
  let value12: Ty := written_name_choose(TyUnit, value11, Text::eq(name, "Unit"))
  let option12: Option(Ty) := written_name_choose_option(TyUnit, option11, Text::eq(name, "Unit"))
  let equal12: value12 = written_name_primitive_lookup(
    name,
    generics,
    option12
  ) := written_name_choose_sound(
    name,
    generics,
    TyUnit,
    value11,
    option11,
    Text::eq(name, "Unit"),
    equal11
  )
  equal12
}

pub theorem ck_written_name_sound(
  name: Text,
  generics: Ordmap(Text, Ty)
): WrittenTypeName(generics, name, ck_written_name(name, generics)) {
  Eq::subst(
    (t: Ty) => WrittenTypeName(generics, name, t),
    Eq::sym(written_name_primitive_unf(name, generics)),
    written_name_primitive_lookup_sound(name, generics, primitive_type_name(name), Refl)
  )
}

pub theorem written_name_nominal_value(
  name: Text,
  generics: Ordmap(Text, Ty),
  ordinary: primitive_type_name(name) = None,
  unbound: Ordmap::get(generics, name, Ordmap::compare_text) = None
): ck_written_name(name, generics) = TyNamed(NameSpelled(name), Nil) {
  Eq::trans(
    written_name_primitive_unf(name, generics),
    Eq::trans(
      Eq::congr((o: Option(Ty)) => written_name_primitive_lookup(name, generics, o), ordinary),
      Eq::congr((o: Option(Ty)) => written_name_lookup(name, o), unbound)
    )
  )
}
