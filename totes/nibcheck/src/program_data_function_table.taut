import "registration_data_function_table.taut"
import "program_data_context_sound.taut"
import "../../surface/src/surface.taut"

pub theorem fnt_registration_if_context(
  c: Checker,
  m: Mut1(Unit, Checker),
  take: Bool,
  h: CkFnsFrame(c, m)
): CkFnsFrame(c, registration_if(c, m, take)) {
  match take: CkFnsFrame(c, registration_if(c, m, take)) {
    true => fnt_frame_rewrap(c, m, h)
    false => Refl
  }
}
pub theorem fnt_ck_program_data_one_context(
  c: Checker,
  s: SurfaceStmt
): CkFnsFrame(c, ck_program_data_one(c, s)) {
  match s: CkFnsFrame(c, ck_program_data_one(c, s)) {
    StLet(name, ty, value, borrow, mutable) => Refl
    StVar(name, ty, value, borrow) => Refl
    StModule(name, stmts, start, end) => Refl
    StAssign(name, name_place, value) => Refl
    StCalled(name_generates, value) => Refl
    StFn(f) => Refl
    StTheorem(t) => Refl
    StDef(t) => Refl
    StMutual(stmts, start, end) => Refl
    StImport(path, start, end) => Refl
    StInductive(i) => Refl
    StEffect(e) => Refl
    StExtern(abi, fns, start, end) => Refl
    StClass(klass) => Refl
    StInstance(i) => Refl
    StWhile(cond, body) => Refl
    StReturn(value) => Refl
    StExpr(value) => Refl
    StOther(what, start, end) => Refl
    StMacro(name, function, start, end) => Refl
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => Refl
    StSyntax(name, grammar, start, end) => Refl
    StStruct(d) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkFnsFrame(c, m),
      Eq::sym(registration_program_StStruct_unf(d, c)),
      fnt_frame_rewrap(
        c,
        ck_declare_data(c, d, true, false),
        fnt_ck_declare_data_context(c, d, true, false)
      )
    )
    StEnum(d) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkFnsFrame(c, m),
      Eq::sym(registration_program_StEnum_unf(d, c)),
      fnt_frame_rewrap(c, ck_declare_data(c, d, false, false), fnt_ck_declare_data_context(c, d, false, false))
    )
  }
}
pub theorem fnt_ck_program_data_context(
  stmts: List(SurfaceStmt),
  c: Checker
): CkFnsFrame(c, ck_program_data(stmts, c)) {
  match stmts: CkFnsFrame(c, ck_program_data(stmts, c)) {
    Nil => Refl
    Cons(s, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkFnsFrame(c, m),
      Eq::sym(registration_program_unf(s, rest, c)),
      fnt_frame_bind_ok(
        Unit,
        Unit,
        c,
        (ignored: Unit, next: Checker) => ck_rewrap1(ck_program_data(rest, next)),
        ck_program_data_one(c, s),
        fnt_ck_program_data_one_context(c, s),
        ignored => next => fnt_frame_rewrap(
          next,
          ck_program_data(rest, next),
          fnt_ck_program_data_context(rest, next)
        )
      )
    )
  }
}
pub theorem fnt_ck_prelude_data_one_context(
  c: Checker,
  s: SurfaceStmt,
  own: Ordmap(Text, Bool)
): CkFnsFrame(c, ck_prelude_data_one(c, s, own)) {
  match s: CkFnsFrame(c, ck_prelude_data_one(c, s, own)) {
    StLet(name, ty, value, borrow, mutable) => Refl
    StVar(name, ty, value, borrow) => Refl
    StModule(name, stmts, start, end) => Refl
    StAssign(name, name_place, value) => Refl
    StCalled(name_generates, value) => Refl
    StFn(f) => Refl
    StTheorem(t) => Refl
    StDef(t) => Refl
    StMutual(stmts, start, end) => Refl
    StImport(path, start, end) => Refl
    StInductive(i) => Refl
    StExtern(abi, fns, start, end) => Refl
    StClass(klass) => Refl
    StInstance(i) => Refl
    StWhile(cond, body) => Refl
    StReturn(value) => Refl
    StExpr(value) => Refl
    StOther(what, start, end) => Refl
    StMacro(name, function, start, end) => Refl
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => Refl
    StSyntax(name, grammar, start, end) => Refl
    StEffect(e) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkFnsFrame(c, m),
      Eq::sym(registration_prelude_StEffect_unf(e, c, own)),
      fnt_registration_if_context(
        c,
        ck_declare_effect(c, e),
        not(types_is_own(own, registration_effect_name(e))),
        fnt_ck_declare_effect_frame(c, e)
      )
    )
    StStruct(d) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkFnsFrame(c, m),
      Eq::sym(registration_prelude_StStruct_unf(d, c, own)),
      fnt_registration_if_context(
        c,
        ck_declare_data(c, d, true, data_is_opaque(registration_ctors(d))),
        not(types_is_own(own, registration_name(d))),
        fnt_ck_declare_data_context(c, d, true, data_is_opaque(registration_ctors(d)))
      )
    )
    StEnum(d) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkFnsFrame(c, m),
      Eq::sym(registration_prelude_StEnum_unf(d, c, own)),
      fnt_registration_if_context(
        c,
        ck_declare_data(c, d, false, false),
        not(types_is_own(own, registration_name(d))),
        fnt_ck_declare_data_context(c, d, false, false)
      )
    )
  }
}
pub theorem fnt_ck_prelude_data_context(
  stmts: List(SurfaceStmt),
  c: Checker,
  own: Ordmap(Text, Bool)
): CkFnsFrame(c, ck_prelude_data(stmts, c, own)) {
  match stmts: CkFnsFrame(c, ck_prelude_data(stmts, c, own)) {
    Nil => Refl
    Cons(s, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkFnsFrame(c, m),
      Eq::sym(registration_prelude_unf(s, rest, c, own)),
      fnt_frame_bind_ok(
        Unit,
        Unit,
        c,
        (ignored: Unit, next: Checker) => ck_rewrap1(ck_prelude_data(rest, next, own)),
        ck_prelude_data_one(c, s, own),
        fnt_ck_prelude_data_one_context(c, s, own),
        ignored => next => fnt_frame_rewrap(
          next,
          ck_prelude_data(rest, next, own),
          fnt_ck_prelude_data_context(rest, next, own)
        )
      )
    )
  }
}
