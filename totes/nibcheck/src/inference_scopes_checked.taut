pub theorem inference_first_handler_frame_checked(
  j: Nat,
  c: Checker,
  b: Ty,
  env: List(Local),
  returned: Option(Pair(SurfacePattern, SurfaceTerm)),
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_first_handler(j, c, b, env, returned)) {
  match returned: CkCheckedFrame(c, inference_first_handler(j, c, b, env, returned)) {
    None => checked_frame_return(c, b, ordered)
    Some(r) => inference_bind_scope_frame_checked(
      Unit,
      Ty,
      c,
      (matched: Unit, c1: Checker, inner: Scope) => ck_rewrap1(
        ck_infer_in(j, c1, inference_handler_body(r), inference_scope_items(inner))
      ),
      ck_pattern(
        c,
        inference_handler_pattern(r),
        b,
        ScopeMk(env),
        span_of(inference_handler_body(r)),
        handle_body_start(inference_handler_body(r))
      ),
      ck_pattern_frame_checked(
        c,
        inference_handler_pattern(r),
        b,
        ScopeMk(env),
        span_of(inference_handler_body(r)),
        handle_body_start(inference_handler_body(r)),
        ordered
      ),
      matched => c1 => inner => o_c1 => checked_frame_rewrap(
        c1,
        ck_infer_in(j, c1, inference_handler_body(r), inference_scope_items(inner)),
        inference_use_ck_infer_in_checked(
          j,
          c1,
          inference_handler_body(r),
          inference_scope_items(inner),
          o_c1,
          ih
        )
      )
    )
  }
}

pub theorem inference_step_ck_handle_first_in_frame_checked(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  b: Ty,
  env: List(Local),
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(
  c,
  inference_step_ck_handle_first_in(j, c, handlers, b, env)
) { inference_first_handler_frame_checked(j, c, b, env, handlers_return(handlers), ih, ordered) }

pub theorem inference_match_arms_frame_checked(
  j: Nat,
  c: Checker,
  s: Ty,
  env: List(Local),
  result: Option(Ty),
  arms: List(SurfaceArm),
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_match_arms(j, c, s, env, result, arms)) {
  match arms: CkCheckedFrame(c, inference_match_arms(j, c, s, env, result, arms)) {
    Nil => checked_frame_return(c, result, ordered)
    Cons(arm, rest) => inference_bind_scope_frame_checked(
      Unit,
      Option(Ty),
      c,
      (matched: Unit, c1: Checker, inner: Scope) => frame_bind(
        Unit,
        Option(Ty),
        (guarded: Unit, c2: Checker) => frame_bind(
          Ty,
          Option(Ty),
          (b: Ty, c3: Checker) => frame_bind(
            Ty,
            Option(Ty),
            (joined: Ty, c4: Checker) => ck_rewrap1(
              ck_match_arms_in(j, c4, rest, s, env, Some(joined))
            ),
            ck_join_opt(c3, result, b)
          ),
          ck_infer_in(j, c2, inference_arm_body(arm), inference_scope_items(inner))
        ),
        ck_guard_in(j, c1, inference_arm_guard(arm), inference_scope_items(inner))
      ),
      ck_pattern(
        c,
        inference_arm_pattern(arm),
        s,
        ScopeMk(env),
        span_of(inference_arm_body(arm)),
        handle_body_start(inference_arm_body(arm))
      ),
      ck_pattern_frame_checked(
        c,
        inference_arm_pattern(arm),
        s,
        ScopeMk(env),
        span_of(inference_arm_body(arm)),
        handle_body_start(inference_arm_body(arm)),
        ordered
      ),
      matched => c1 => inner => o_c1 => checked_frame_bind(
        Unit,
        Option(Ty),
        c1,
        (guarded: Unit, c2: Checker) => frame_bind(
          Ty,
          Option(Ty),
          (b: Ty, c3: Checker) => frame_bind(
            Ty,
            Option(Ty),
            (joined: Ty, c4: Checker) => ck_rewrap1(
              ck_match_arms_in(j, c4, rest, s, env, Some(joined))
            ),
            ck_join_opt(c3, result, b)
          ),
          ck_infer_in(j, c2, inference_arm_body(arm), inference_scope_items(inner))
        ),
        ck_guard_in(j, c1, inference_arm_guard(arm), inference_scope_items(inner)),
        inference_use_ck_guard_in_checked(
          j,
          c1,
          inference_arm_guard(arm),
          inference_scope_items(inner),
          o_c1,
          ih
        ),
        guarded => c2 => o_c2 => checked_frame_bind(
          Ty,
          Option(Ty),
          c2,
          (b: Ty, c3: Checker) => frame_bind(
            Ty,
            Option(Ty),
            (joined: Ty, c4: Checker) => ck_rewrap1(
              ck_match_arms_in(j, c4, rest, s, env, Some(joined))
            ),
            ck_join_opt(c3, result, b)
          ),
          ck_infer_in(j, c2, inference_arm_body(arm), inference_scope_items(inner)),
          inference_use_ck_infer_in_checked(
            j,
            c2,
            inference_arm_body(arm),
            inference_scope_items(inner),
            o_c2,
            ih
          ),
          b => c3 => o_c3 => checked_frame_bind(
            Ty,
            Option(Ty),
            c3,
            (joined: Ty, c4: Checker) => ck_rewrap1(
              ck_match_arms_in(j, c4, rest, s, env, Some(joined))
            ),
            ck_join_opt(c3, result, b),
            ck_join_opt_run_frame_checked(c3, result, b, o_c3),
            joined => c4 => o_c4 => checked_frame_rewrap(
              c4,
              ck_match_arms_in(j, c4, rest, s, env, Some(joined)),
              inference_use_ck_match_arms_in_checked(j, c4, rest, s, env, Some(joined), o_c4, ih)
            )
          )
        )
      )
    )
  }
}

pub theorem inference_step_ck_match_arms_in_frame_checked(
  j: Nat,
  c: Checker,
  arms: List(SurfaceArm),
  s: Ty,
  env: List(Local),
  result: Option(Ty),
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(
  c,
  inference_step_ck_match_arms_in(j, c, arms, s, env, result)
) { inference_match_arms_frame_checked(j, c, s, env, result, arms, ih, ordered) }

pub theorem inference_record_values_frame_checked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  d: Text,
  args: List(Ty),
  declared: List(DataField),
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_record_values(j, c, name, fields, env, span, d, args, declared)) {
  checked_frame_bind(
    List(Text),
    Ty,
    c,
    (seen: List(Text), c1: Checker) => frame_bind(
      Unit,
      Ty,
      (checked: Unit, c2: Checker) => mut1(TyNamed(d, args), c2),
      ck_record_missing(declared, c1, name, seen, span)
    ),
    ck_record_fields_in(j, c, name, fields, declared, env, Nil),
    inference_use_ck_record_fields_in_checked(j, c, name, fields, declared, env, Nil, ordered, ih),
    seen => c1 => o_c1 => checked_frame_bind(
      Unit,
      Ty,
      c1,
      (checked: Unit, c2: Checker) => mut1(TyNamed(d, args), c2),
      ck_record_missing(declared, c1, name, seen, span),
      checked_frame_read(
        c1,
        ck_record_missing(declared, c1, name, seen, span),
        ck_record_missing_frame(declared, c1, name, seen, span),
        ck_record_missing_frame_errors(declared, c1, name, seen, span),
        o_c1
      ),
      checked => c2 => o_c2 => checked_frame_return(c2, TyNamed(d, args), o_c2)
    )
  )
}

pub theorem inference_record_ctor_frame_checked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  ctor: Option(Pair(Text, Nat)),
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_record_ctor(j, c, name, fields, env, span, ctor)) {
  match ctor: CkCheckedFrame(c, inference_record_ctor(j, c, name, fields, env, span, ctor)) {
    None => checked_frame_bind(
      Unit,
      Ty,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, cat2(name, " is not a struct"), span)),
      checked_frame_read(
        c,
        ck_rewrap1(ck_error(c, cat2(name, " is not a struct"), span)),
        frame_rewrap(
          c,
          ck_error(c, cat2(name, " is not a struct"), span),
          ck_error_frame(c, cat2(name, " is not a struct"), span)
        ),
        error_frame_rewrap(
          c,
          ck_error(c, cat2(name, " is not a struct"), span),
          ck_error_frame_errors(c, cat2(name, " is not a struct"), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    Some(dc) => checked_frame_bind(
      List(Ty),
      Ty,
      c,
      (args: List(Ty), c1: Checker) => inference_record_values(
        j,
        c1,
        name,
        fields,
        env,
        span,
        pattern_ctor_name(dc),
        args,
        datas_fields(ck_datas_of(c1), pattern_ctor_name(dc), pattern_ctor_index(dc), args)
      ),
      ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
      checked_frame_read(
        c,
        ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame_errors(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ordered
      ),
      args => c1 => o_c1 => inference_record_values_frame_checked(
        j,
        c1,
        name,
        fields,
        env,
        span,
        pattern_ctor_name(dc),
        args,
        datas_fields(ck_datas_of(c1), pattern_ctor_name(dc), pattern_ctor_index(dc), args),
        ih,
        o_c1
      )
    )
  }
}

pub theorem inference_step_ck_record_in_frame_checked(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  ih: InferenceFrames_checked(j),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, inference_step_ck_record_in(j, c, name, fields, env, span)) {
  inference_record_ctor_frame_checked(
    j,
    c,
    name,
    fields,
    env,
    span,
    datas_ctor(ck_datas_of(c), name),
    ih,
    ordered
  )
}
