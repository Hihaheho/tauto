import "instantiation_frame.taut"
import "stable_state_frame.taut"
import std::Map
import std::Text
import "checker.taut"
import "datas_frame.taut"
import "ty.taut"
import "types_decl.taut"
import "unify_sound.taut"

pub theorem stable_ck_fresh_frame(c: Checker): StableStateFrame(c, ck_fresh(c)) { Refl }
pub theorem stable_ck_error_frame(
  c: Checker,
  message: Text,
  span: TySpan
): StableStateFrame(c, ck_error(c, message, span)) { Refl }

pub theorem instantiation_bound_frame_stable(
  c: Checker,
  g: Pair(Text, Kind),
  v: Ty,
  name: Text,
  span: TySpan,
  arg: Option(Kind)
): StableStateFrame(c, instantiation_bound(c, g, v, name, span, arg)) {
  ⊢ StableStateFrame(c, instantiation_bound(c, g, v, name, span, arg)) from match arg { Some(k) => Refl
    None => Refl }
}

pub theorem instantiation_cons_frame_stable(
  g: Pair(Text, Kind),
  rest: List(Pair(Text, Kind)),
  c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ more: Ordmap(
    Text,
    Ty
  ). StableStateFrame(next, ck_instantiate_map_ctors(rest, next, ctors, name, span, more))
): StableStateFrame(c, instantiation_cons(g, rest, c, ctors, name, span, map)) {
  stable_frame_bind(
    Ty,
    Ordmap(Text, Ty),
    c,
    (v: Ty, c1: Checker) => frame_bind(
      Unit,
      Ordmap(Text, Ty),
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        )
      ),
      instantiation_bound(c1, g, v, name, span, ctor_arg_of(ctors, instantiation_name(g)))
    ),
    ck_fresh(c),
    stable_ck_fresh_frame(c),
    v => c1 => stable_frame_bind(
      Unit,
      Ordmap(Text, Ty),
      c1,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        )
      ),
      instantiation_bound(c1, g, v, name, span, ctor_arg_of(ctors, instantiation_name(g))),
      instantiation_bound_frame_stable(
        c1,
        g,
        v,
        name,
        span,
        ctor_arg_of(ctors, instantiation_name(g))
      ),
      ignored => c2 => stable_frame_rewrap(
        c2,
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        ),
        ih(c2, Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text))
      )
    )
  )
}

pub theorem ck_instantiate_map_ctors_frame_stable(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty)
): StableStateFrame(c, ck_instantiate_map_ctors(gs, c, ctors, name, span, map)) {
  ⊢ StableStateFrame(c, ck_instantiate_map_ctors(gs, c, ctors, name, span, map)) from match gs {
    Nil => Refl
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => StableStateFrame(c, z),
      Eq::sym(instantiation_cons_unf(g, rest, c, ctors, name, span, map)),
      instantiation_cons_frame_stable(
        g,
        rest,
        c,
        ctors,
        name,
        span,
        map,
        next => more => ck_instantiate_map_ctors_frame_stable(rest, next, ctors, name, span, more)
      )
    )
  }
}
pub theorem ck_instantiate_map_frame_stable(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  span: TySpan,
  map: Ordmap(Text, Ty)
): StableStateFrame(c, ck_instantiate_map(gs, c, span, map)) {
  stable_frame_rewrap(
    c,
    ck_instantiate_map_ctors(gs, c, Nil, "", span, map),
    ck_instantiate_map_ctors_frame_stable(gs, c, Nil, "", span, map)
  )
}
pub theorem ck_pend_frame_stable(
  c: Checker,
  r#class: Text,
  t: Ty,
  what: Text,
  span: TySpan
): StableStateFrame(c, ck_pend(c, r#class, t, what, span)) { Refl }

pub theorem instantiation_pred_frame_stable(
  c: Checker,
  p: Pair(Text, Text),
  what: Text,
  span: TySpan,
  found: Option(Ty)
): StableStateFrame(c, instantiation_pred(c, p, what, span, found)) {
  ⊢ StableStateFrame(c, instantiation_pred(c, p, what, span, found)) from match found {
    None => Refl
    Some(t) => stable_frame_rewrap(
      c,
      ck_pend(c, instantiation_constraint(p), t, what, span),
      ck_pend_frame_stable(c, instantiation_constraint(p), t, what, span)
    )
  }
}

pub theorem instantiation_preds_cons_frame_stable(
  p: Pair(Text, Text),
  rest: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  ih: ∀ next: Checker. StableStateFrame(next, ck_pend_preds(rest, next, map, what, span))
): StableStateFrame(c, instantiation_preds_cons(p, rest, c, map, what, span)) {
  stable_frame_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_pend_preds(rest, c1, map, what, span)),
    instantiation_pred(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    instantiation_pred_frame_stable(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    ignored => c1 => stable_frame_rewrap(c1, ck_pend_preds(rest, c1, map, what, span), ih(c1))
  )
}

pub theorem ck_pend_preds_frame_stable(
  ps: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): StableStateFrame(c, ck_pend_preds(ps, c, map, what, span)) {
  ⊢ StableStateFrame(c, ck_pend_preds(ps, c, map, what, span)) from match ps {
    Nil => Refl
    Cons(p, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => StableStateFrame(c, z),
      Eq::sym(instantiation_preds_cons_unf(p, rest, c, map, what, span)),
      instantiation_preds_cons_frame_stable(
        p,
        rest,
        c,
        map,
        what,
        span,
        next => ck_pend_preds_frame_stable(rest, next, map, what, span)
      )
    )
  }
}

pub theorem instantiation_named_cons_frame_stable(
  g: Text,
  rest: List(Text),
  c: Checker,
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ more: Ordmap(
    Text,
    Ty
  ). StableStateFrame(next, ck_instantiate_named_map(rest, next, more))
): StableStateFrame(c, instantiation_named_cons(g, rest, c, map)) {
  stable_frame_bind(
    Ty,
    Ordmap(Text, Ty),
    c,
    (v: Ty, c1: Checker) => ck_rewrap1(
      ck_instantiate_named_map(rest, c1, Ordmap::insert(map, g, v, Ordmap::compare_text))
    ),
    ck_fresh(c),
    stable_ck_fresh_frame(c),
    v => c1 => stable_frame_rewrap(
      c1,
      ck_instantiate_named_map(rest, c1, Ordmap::insert(map, g, v, Ordmap::compare_text)),
      ih(c1, Ordmap::insert(map, g, v, Ordmap::compare_text))
    )
  )
}

pub theorem ck_instantiate_named_map_frame_stable(
  gs: List(Text),
  c: Checker,
  map: Ordmap(Text, Ty)
): StableStateFrame(c, ck_instantiate_named_map(gs, c, map)) {
  ⊢ StableStateFrame(c, ck_instantiate_named_map(gs, c, map)) from match gs {
    Nil => Refl
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => StableStateFrame(c, z),
      Eq::sym(instantiation_named_cons_unf(g, rest, c, map)),
      instantiation_named_cons_frame_stable(
        g,
        rest,
        c,
        map,
        next => more => ck_instantiate_named_map_frame_stable(rest, next, more)
      )
    )
  }
}

pub theorem instantiation_ck_instantiate_frame_stable(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  t: Ty,
  span: TySpan
): StableStateFrame(c, instantiation_ck_instantiate(c, gs, t, span)) {
  stable_frame_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => mut1(ty_substitute(t, map), c1),
    ck_instantiate_map(gs, c, span, Ordmap::empty()),
    ck_instantiate_map_frame_stable(gs, c, span, Ordmap::empty()),
    map => c1 => Refl
  )
}

pub theorem ck_instantiate_frame_stable(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  t: Ty,
  span: TySpan
): StableStateFrame(c, ck_instantiate(c, gs, t, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => StableStateFrame(c, z),
    Eq::sym(instantiation_ck_instantiate_unf(c, gs, t, span)),
    instantiation_ck_instantiate_frame_stable(c, gs, t, span)
  )
}

pub theorem instantiation_ck_instantiate_named_frame_stable(
  c: Checker,
  gs: List(Text),
  t: Ty
): StableStateFrame(c, instantiation_ck_instantiate_named(c, gs, t)) {
  stable_frame_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => mut1(ty_substitute(t, map), c1),
    ck_instantiate_named_map(gs, c, Ordmap::empty()),
    ck_instantiate_named_map_frame_stable(gs, c, Ordmap::empty()),
    map => c1 => Refl
  )
}

pub theorem ck_instantiate_named_frame_stable(
  c: Checker,
  gs: List(Text),
  t: Ty
): StableStateFrame(c, ck_instantiate_named(c, gs, t)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => StableStateFrame(c, z),
    Eq::sym(instantiation_ck_instantiate_named_unf(c, gs, t)),
    instantiation_ck_instantiate_named_frame_stable(c, gs, t)
  )
}

pub theorem instantiation_scheme_frame_stable(
  c: Checker,
  name: Text,
  s: Scheme,
  span: TySpan
): StableStateFrame(c, instantiation_scheme(c, name, s, span)) {
  stable_frame_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(ty_substitute(instantiation_scheme_ty(s), map), c2),
      ck_pend_preds(instantiation_scheme_preds(s), c1, map, name, span)
    ),
    ck_instantiate_map_ctors(
      instantiation_scheme_generics(s),
      c,
      instantiation_scheme_ctors(s),
      name,
      span,
      Ordmap::empty()
    ),
    ck_instantiate_map_ctors_frame_stable(
      instantiation_scheme_generics(s),
      c,
      instantiation_scheme_ctors(s),
      name,
      span,
      Ordmap::empty()
    ),
    map => c1 => stable_frame_bind(
      Unit,
      Ty,
      c1,
      (ignored: Unit, c2: Checker) => mut1(ty_substitute(instantiation_scheme_ty(s), map), c2),
      ck_pend_preds(instantiation_scheme_preds(s), c1, map, name, span),
      ck_pend_preds_frame_stable(instantiation_scheme_preds(s), c1, map, name, span),
      ignored => c2 => Refl
    )
  )
}

pub theorem ck_instantiate_scheme_frame_stable(
  c: Checker,
  name: Text,
  s: Scheme,
  span: TySpan
): StableStateFrame(c, ck_instantiate_scheme(c, name, s, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => StableStateFrame(c, z),
    Eq::sym(instantiation_scheme_unf(c, name, s, span)),
    instantiation_scheme_frame_stable(c, name, s, span)
  )
}
