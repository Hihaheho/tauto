pub fn written_function_after(
  params: List(SurfaceParam),
  result: SurfaceTerm,
  generics: Ordmap(Text, Ty),
  m: Mut1(List(Ty), Checker)
): Mut1(Ty, Checker) {
  frame_bind(
    List(Ty),
    Ty,
    (arguments: List(Ty), state: Checker) => written_map(
      Ty,
      Ty,
      (returns: Ty) => ty_poly_of(frame_pi_binders(params), TyFn(arguments, returns, KindShared)),
      ck_written_in(result, state, frame_pi_generics(params, generics))
    ),
    m
  )
}
pub theorem written_term_state(
  c: Checker,
  next: Checker,
  generics: Ordmap(Text, Ty),
  borrow: Bool,
  term: SurfaceTerm,
  t: Ty,
  env: ck_datas_of(next) = ck_datas_of(c),
  position: frame_constructor_position(next) = frame_constructor_position(c),
  meaning: WrittenTerm(
    ck_datas_of(next),
    generics,
    frame_constructor_position(next),
    borrow,
    term,
    t
  )
): WrittenTerm(ck_datas_of(c), generics, frame_constructor_position(c), borrow, term, t) {
  Eq::subst(
    (partial: Bool) => WrittenTerm(ck_datas_of(c), generics, partial, borrow, term, t),
    position,
    Eq::subst(
      (datas: Datas) => WrittenTerm(
        datas,
        generics,
        frame_constructor_position(next),
        borrow,
        term,
        t
      ),
      env,
      meaning
    )
  )
}
pub theorem written_function_after_sound(
  params: List(SurfaceParam),
  result: SurfaceTerm,
  effects: Option(List(Text)),
  c: Checker,
  generics: Ordmap(Text, Ty),
  under_borrow: Bool,
  m: Mut1(List(Ty), Checker),
  read: CkReadFrame(c, m),
  context: written_context(ck_st(m)) = written_context(c),
  ordinary: frame_under_borrow(c) = false,
  ihparams: ∀ clean: DiagnosticClean(
    ck_st(m)
  ). WrittenParameters(
    ck_datas_of(c),
    frame_pi_generics(params, generics),
    frame_constructor_position(c),
    written_binders_suffix(pi_binders(params)),
    ck_val(m)
  ),
  ihresult: ∀ next: Checker. ∀ ordinary_next: frame_under_borrow(next) = false. ∀ clean: DiagnosticClean(
    ck_st(ck_written_in(result, next, frame_pi_generics(params, generics)))
  ). WrittenTerm(
    ck_datas_of(next),
    frame_pi_generics(params, generics),
    frame_constructor_position(next),
    false,
    result,
    ck_val(ck_written_in(result, next, frame_pi_generics(params, generics)))
  ),
  clean: DiagnosticClean(ck_st(written_function_after(params, result, generics, m)))
): WrittenKind(
  ck_datas_of(c),
  generics,
  frame_constructor_position(c),
  under_borrow,
  SkPi(params, result, effects),
  ck_val(written_function_after(params, result, generics, m))
) {
  match m: WrittenKind(
    ck_datas_of(c),
    generics,
    frame_constructor_position(c),
    under_borrow,
    SkPi(params, result, effects),
    ck_val(written_function_after(params, result, generics, m))
  ) {
    mut1(arguments, state) => {
      let result_clean: DiagnosticClean(
        ck_st(ck_written_in(result, state, frame_pi_generics(params, generics)))
      ) := written_map_clean(
        Ty,
        Ty,
        (returns: Ty) => ty_poly_of(frame_pi_binders(params), TyFn(arguments, returns, KindShared)),
        ck_written_in(result, state, frame_pi_generics(params, generics)),
        clean
      )
      Eq::subst(
        (t: Ty) => WrittenKind(
          ck_datas_of(c),
          generics,
          frame_constructor_position(c),
          under_borrow,
          SkPi(params, result, effects),
          t
        ),
        Eq::sym(
          written_map_value(
            Ty,
            Ty,
            (returns: Ty) => ty_poly_of(
              frame_pi_binders(params),
              TyFn(arguments, returns, KindShared)
            ),
            ck_written_in(result, state, frame_pi_generics(params, generics))
          )
        ),
        WrittenKindFunction(
          params,
          result,
          effects,
          frame_pi_binders(params),
          written_binders_suffix(pi_binders(params)),
          frame_pi_generics(params, generics),
          arguments,
          ck_val(ck_written_in(result, state, frame_pi_generics(params, generics))),
          ty_poly_of(
            frame_pi_binders(params),
            TyFn(
              arguments,
              ck_val(ck_written_in(result, state, frame_pi_generics(params, generics))),
              KindShared
            )
          ),
          pi_binders_sound(params),
          binders_map_sound(frame_pi_binders(params), generics),
          ihparams(
            ck_written_in_frame_errors(
              result,
              state,
              frame_pi_generics(params, generics),
              result_clean
            )
          ),
          written_term_state(
            c,
            state,
            frame_pi_generics(params, generics),
            false,
            result,
            ck_val(ck_written_in(result, state, frame_pi_generics(params, generics))),
            Eq::congr(frame_read_datas, read),
            Eq::congr(written_context_position, context),
            ihresult(
              state,
              Eq::trans(Eq::congr(written_context_borrow, context), ordinary),
              result_clean
            )
          ),
          ty_poly_of_sound(
            frame_pi_binders(params),
            TyFn(
              arguments,
              ck_val(ck_written_in(result, state, frame_pi_generics(params, generics))),
              KindShared
            )
          )
        )
      )
    }
  }
}

pub theorem written_function_sound(
  params: List(SurfaceParam),
  result: SurfaceTerm,
  effects: Option(List(Text)),
  c: Checker,
  generics: Ordmap(Text, Ty),
  under_borrow: Bool,
  ordinary: frame_under_borrow(c) = false,
  ihparams: ∀ clean: DiagnosticClean(
    ck_st(
      ck_written_params(
        written_binders_suffix(pi_binders(params)),
        c,
        frame_pi_generics(params, generics),
        0
      )
    )
  ). WrittenParameters(
    ck_datas_of(c),
    frame_pi_generics(params, generics),
    frame_constructor_position(c),
    written_binders_suffix(pi_binders(params)),
    ck_val(
      ck_written_params(
        written_binders_suffix(pi_binders(params)),
        c,
        frame_pi_generics(params, generics),
        0
      )
    )
  ),
  ihresult: ∀ next: Checker. ∀ ordinary_next: frame_under_borrow(next) = false. ∀ clean: DiagnosticClean(
    ck_st(ck_written_in(result, next, frame_pi_generics(params, generics)))
  ). WrittenTerm(
    ck_datas_of(next),
    frame_pi_generics(params, generics),
    frame_constructor_position(next),
    false,
    result,
    ck_val(ck_written_in(result, next, frame_pi_generics(params, generics)))
  ),
  clean: DiagnosticClean(ck_st(frame_written_pi(params, result, c, generics)))
): WrittenKind(
  ck_datas_of(c),
  generics,
  frame_constructor_position(c),
  under_borrow,
  SkPi(params, result, effects),
  ck_val(frame_written_pi(params, result, c, generics))
) {
  written_function_after_sound(
    params,
    result,
    effects,
    c,
    generics,
    under_borrow,
    ck_written_params(
      params,
      c,
      frame_pi_generics(params, generics),
      list_len(frame_pi_binders(params))
    ),
    ck_written_params_frame(
      params,
      c,
      frame_pi_generics(params, generics),
      list_len(frame_pi_binders(params))
    ),
    ck_written_params_frame_context(
      params,
      c,
      frame_pi_generics(params, generics),
      list_len(frame_pi_binders(params)),
      ordinary
    ),
    ordinary,
    params_clean => Eq::subst(
      (m: Mut1(List(Ty), Checker)) => WrittenParameters(
        ck_datas_of(c),
        frame_pi_generics(params, generics),
        frame_constructor_position(c),
        written_binders_suffix(pi_binders(params)),
        ck_val(m)
      ),
      Eq::sym(pi_binders_skipped_parameters(params, c, frame_pi_generics(params, generics))),
      ihparams(
        Eq::subst(
          (m: Mut1(List(Ty), Checker)) => DiagnosticClean(ck_st(m)),
          pi_binders_skipped_parameters(params, c, frame_pi_generics(params, generics)),
          params_clean
        )
      )
    ),
    ihresult,
    clean
  )
}
