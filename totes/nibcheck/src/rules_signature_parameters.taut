import "rules_signature_types.taut"
import std::map
import std::text
import "datas.taut"
import "ty.taut"
import "../../surface/src/surface.taut"

pub fn signature_parameter_borrow(r#borrows: List(Option(Bool))): Option(Bool) {
  match r#borrows {
    Nil => None
    Cons(first, ^rest) => first
  }
}
pub fn signature_remaining_borrows(r#borrows: List(Option(Bool))): List(Option(Bool)) {
  match r#borrows {
    Nil => Nil
    Cons(^first, rest) => rest
  }
}
pub(open) inductive SignatureParameters(
  env: Datas,
  generics: Ordmap(Text, Ty),
  partial: Bool
): (List(Option(SurfaceTerm)), List(Option(Bool)), List(Ty)) -> Prop {
  SignatureParametersNil(
    r#borrows: List(Option(Bool))
  ): SignatureParameters(env, generics, partial, Nil, r#borrows, Nil)
  SignatureParametersCons(
    source: Option(SurfaceTerm),
    rest: List(Option(SurfaceTerm)),
    r#borrows: List(Option(Bool)),
    t: Ty,
    types: List(Ty),
    head: SignatureParameter(
      env,
      generics,
      partial,
      source,
      signature_parameter_borrow(r#borrows),
      t
    ),
    tail: SignatureParameters(
      env,
      generics,
      partial,
      rest,
      signature_remaining_borrows(r#borrows),
      types
    )
  ): SignatureParameters(env, generics, partial, Cons(source, rest), r#borrows, Cons(t, types))
}
