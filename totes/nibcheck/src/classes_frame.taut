theorem cf_class_list_StWhile_unf(
  cond: SurfaceTerm,
  body: SurfaceTerm,
  rest: List(SurfaceStmt),
  c: Checker,
  own_types: List(Text)
): Eq(
  Mut1(List(SurfaceClass), Checker),
  ck_declare_class_list(Cons(StWhile(cond, body), rest), c, own_types),
  ck_rewrap1(ck_declare_class_list(rest, c, own_types))
) { refl() }

theorem cf_class_list_StReturn_unf(
  value: Option(SurfaceTerm),
  rest: List(SurfaceStmt),
  c: Checker,
  own_types: List(Text)
): Eq(
  Mut1(List(SurfaceClass), Checker),
  ck_declare_class_list(Cons(StReturn(value), rest), c, own_types),
  ck_rewrap1(ck_declare_class_list(rest, c, own_types))
) { refl() }

