pub theorem cf_class_list_StMacro_unf(
  name: Text,
  function: Text,
  start: Nat,
  end: Nat,
  rest: List(SurfaceStmt),
  c: Checker,
  own_types: List(Text)
): ck_declare_class_list(Cons(StMacro(name, function, start, end), rest), c, own_types) = ck_rewrap1(ck_declare_class_list(rest, c, own_types)) { Refl }

pub theorem cf_class_list_StAttributed_unf(
  attr_name: Text,
  attr_arg: SurfaceTerm,
  attr_generates: List(Text),
  attr_stmt: SurfaceStmt,
  rest: List(SurfaceStmt),
  c: Checker,
  own_types: List(Text)
): ck_declare_class_list(
    Cons(StAttributed(attr_name, attr_arg, attr_generates, attr_stmt), rest),
    c,
    own_types
  ) = ck_rewrap1(ck_declare_class_list(rest, c, own_types)) { Refl }

pub theorem cf_class_list_StSyntax_unf(
  name: Text,
  grammar: Text,
  start: Nat,
  end: Nat,
  rest: List(SurfaceStmt),
  c: Checker,
  own_types: List(Text)
): ck_declare_class_list(Cons(StSyntax(name, grammar, start, end), rest), c, own_types) = ck_rewrap1(ck_declare_class_list(rest, c, own_types)) { Refl }

pub theorem cf_class_list_step(
  s: SurfaceStmt,
  rest: List(SurfaceStmt),
  c: Checker,
  own_types: List(Text),
  ih: ∀ next: Checker. CkReadFrame(next, ck_declare_class_list(rest, next, own_types))
): CkReadFrame(c, ck_declare_class_list(Cons(s, rest), c, own_types)) {
  match s: CkReadFrame(c, ck_declare_class_list(Cons(s, rest), c, own_types)) {
    StLet(name, ty, value, borrow, mutable) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StLet_unf(name, ty, value, borrow, mutable, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StVar(name, ty, value, borrow) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StVar_unf(name, ty, value, borrow, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StModule(name, stmts, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StModule_unf(name, stmts, start, end, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StAssign(name, name_place, value) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StAssign_unf(name, name_place, value, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StCalled(name_generates, value) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StCalled_unf(name_generates, value, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StFn(f) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StFn_unf(f, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StTheorem(t) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StTheorem_unf(t, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StDef(t) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StDef_unf(t, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StMutual(stmts, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StMutual_unf(stmts, start, end, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StImport(path, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StImport_unf(path, start, end, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StInductive(i) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StInductive_unf(i, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StEffect(e) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StEffect_unf(e, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StStruct(d) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StStruct_unf(d, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StEnum(d) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StEnum_unf(d, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StExtern(abi, fns, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StExtern_unf(abi, fns, start, end, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StClass(cl) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StClass_unf(cl, rest, c, own_types)),
      cf_class_list_cons_frame(cl, rest, c, own_types, ih)
    )
    StInstance(i) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StInstance_unf(i, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StWhile(cond, body) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StWhile_unf(cond, body, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StReturn(value) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StReturn_unf(value, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StExpr(value) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StExpr_unf(value, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StOther(what, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StOther_unf(what, start, end, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StMacro(name, function, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StMacro_unf(name, function, start, end, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(
        cf_class_list_StAttributed_unf(
          attr_name,
          attr_arg,
          attr_generates,
          attr_stmt,
          rest,
          c,
          own_types
        )
      ),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
    StSyntax(name, grammar, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceClass), Checker)) => CkReadFrame(c, z),
      Eq::sym(cf_class_list_StSyntax_unf(name, grammar, start, end, rest, c, own_types)),
      frame_rewrap(c, ck_declare_class_list(rest, c, own_types), ih(c))
    )
  }
}

pub theorem ck_declare_class_list_frame(
  ss: List(SurfaceStmt),
  c: Checker,
  own_types: List(Text)
): CkReadFrame(c, ck_declare_class_list(ss, c, own_types)) {
  match ss: CkReadFrame(c, ck_declare_class_list(ss, c, own_types)) {
    Nil => Refl
    Cons(s, rest) => cf_class_list_step(
      s,
      rest,
      c,
      own_types,
      next => ck_declare_class_list_frame(rest, next, own_types)
    )
  }
}
