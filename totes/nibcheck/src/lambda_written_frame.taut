// The types written on a lambda's parameters (`ck_lambda_written`) keep the
// checker's frame: holding a parameter to its type unifies, and a written type
// that does not read leaves the errors as they were before it.

pub fn lw_keep_rest(p: Ty, before: List(TypeError)): (Ty, Checker) -> Mut1(Unit, Checker) {
  (t1: Ty, c1: Checker) => ck_rewrap1(
    ck_lambda_written_keep(c1, p, t1, before, list_len(ck_errors_of(c1)) == list_len(before))
  )
}

pub theorem lw_keep_run_frame(
  c: Checker,
  p: Ty,
  t: Ty,
  before: List(TypeError),
  read: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_lambda_written_keep(c, p, t, before, read)) {
  match read {
    true => run_frame_bind(
      <A: Bool, B: Unit>,
      c,
      (ignored: Bool, c1: Checker) => mut1(Star, c1),
      ck_attempt_unify(c, ty_unborrowed(p), t),
      ck_attempt_unify_run_frame(c, ty_unborrowed(p), t, ordered),
      ignored => c1 => o_c1 => run_frame_return(c1, Star, o_c1)
    )
    false => AndIntro(ordered, Refl)
  }
}

pub theorem lw_at_run_frame(
  c: Checker,
  p: Ty,
  o: Option(SurfaceTerm),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_lambda_written_at(c, p, o)) {
  match o {
    None => run_frame_return(c, Star, ordered)
    Some(w) => run_frame_rewrap(
      c,
      ck_lambda_written_one(c, p, w, ck_errors_of(c)),
      run_frame_bind(
      <A: Ty, B: Unit>,
      c,
      lw_keep_rest(p, ck_errors_of(c)),
      ck_written_here(c, w),
      run_frame_read(c, ck_written_here(c, w), ck_written_here_frame(c, w), ordered),
      t1 => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_lambda_written_keep(
          c1,
          p,
          t1,
          ck_errors_of(c),
          list_len(ck_errors_of(c1)) == list_len(ck_errors_of(c))
        ),
        lw_keep_run_frame(
          c1,
          p,
          t1,
          ck_errors_of(c),
          list_len(ck_errors_of(c1)) == list_len(ck_errors_of(c)),
          o_c1
        )
      )
    )
    )
  }
}

pub theorem ck_lambda_written_run_frame(
  c: Checker,
  ps: List(Ty),
  types: List(Option(SurfaceTerm)),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_lambda_written(c, ps, types)) {
  match ps {
    Nil => run_frame_return(c, Star, ordered)
    Cons(p, rest) => ⊢ CkRunFrame(c, ck_lambda_written(c, Cons(p, rest), types)) from match types {
      Nil => run_frame_return(c, Star, ordered)
      Cons(o, more) => run_frame_bind(
        <A: Unit, B: Unit>,
        c,
        (u: Unit, c1: Checker) => ck_rewrap1(ck_lambda_written(c1, rest, more)),
        ck_lambda_written_at(c, p, o),
        lw_at_run_frame(c, p, o, ordered),
        u => c1 => o_c1 => run_frame_rewrap(
          c1,
          ck_lambda_written(c1, rest, more),
          ck_lambda_written_run_frame(c1, rest, more, o_c1)
        )
      )
    }
  }
}

pub theorem ck_lambda_hints_run_frame(
  c: Checker,
  hint: Option(Ty),
  ps: List(Ty),
  types: List(Option(SurfaceTerm)),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_lambda_hints(c, hint, ps, types)) {
  run_frame_bind(
    <A: Unit, B: Unit>,
    c,
    (u: Unit, c1: Checker) => ck_rewrap1(ck_lambda_hint_of(c1, hint, ps)),
    ck_lambda_written(c, ps, types),
    ck_lambda_written_run_frame(c, ps, types, ordered),
    u => c1 => o_c1 => run_frame_rewrap(
      c1,
      ck_lambda_hint_of(c1, hint, ps),
      ck_lambda_hint_of_run_frame(c1, hint, ps, o_c1)
    )
  )
}

// ----- checked -----

pub theorem lw_keep_checked_frame(
  c0: Checker,
  c: Checker,
  p: Ty,
  t: Ty,
  read: Bool,
  ordered: CkOrdered(c),
  errors: CkErrorFrame(c0, mut1(t, c))
): CkCheckedFrame(c0, ck_lambda_written_keep(c, p, t, ck_errors_of(c0), read)) {
  match read {
    true => {
      let h: CkCheckedFrame(
        c,
        frame_bind(
          <A: Bool, B: Unit>,
          (ignored: Bool, c1: Checker) => mut1(Star, c1),
          ck_attempt_unify(c, ty_unborrowed(p), t)
        )
      ) := checked_frame_bind(
        <A: Bool, B: Unit>,
        c,
        (ignored: Bool, c1: Checker) => mut1(Star, c1),
        ck_attempt_unify(c, ty_unborrowed(p), t),
        ck_attempt_unify_run_frame_checked(c, ty_unborrowed(p), t, ordered),
        ignored => c1 => o_c1 => checked_frame_return(c1, Star, o_c1)
      )
      AndIntro(And::left(h), clean => errors(And::right(h)(clean)))
    }
    false => AndIntro(ordered, clean => clean)
  }
}

pub theorem lw_at_checked_on(
  c: Checker,
  p: Ty,
  m: Mut1(Ty, Checker),
  read: CkReadFrame(c, m),
  errors: CkErrorFrame(c, m),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, frame_bind(<A: Ty, B: Unit>, lw_keep_rest(p, ck_errors_of(c)), m)) {
  match m {
    mut1(t, c1) => checked_frame_rewrap(
      c,
      ck_lambda_written_keep(
        c1,
        p,
        t,
        ck_errors_of(c),
        list_len(ck_errors_of(c1)) == list_len(ck_errors_of(c))
      ),
      lw_keep_checked_frame(
        c,
        c1,
        p,
        t,
        list_len(ck_errors_of(c1)) == list_len(ck_errors_of(c)),
        frame_subst_ordered(c, mut1(t, c1), read, ordered),
        errors
      )
    )
  }
}

pub theorem lw_at_checked_frame(
  c: Checker,
  p: Ty,
  o: Option(SurfaceTerm),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_lambda_written_at(c, p, o)) {
  match o {
    None => checked_frame_return(c, Star, ordered)
    Some(w) => checked_frame_rewrap(
      c,
      ck_lambda_written_one(c, p, w, ck_errors_of(c)),
      lw_at_checked_on(
      c,
      p,
      ck_written_here(c, w),
      ck_written_here_frame(c, w),
      ck_written_here_frame_errors(c, w),
      ordered
    )
    )
  }
}

pub theorem ck_lambda_written_run_frame_checked(
  c: Checker,
  ps: List(Ty),
  types: List(Option(SurfaceTerm)),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_lambda_written(c, ps, types)) {
  match ps {
    Nil => checked_frame_return(c, Star, ordered)
    Cons(p, rest) => ⊢ CkCheckedFrame(c, ck_lambda_written(c, Cons(p, rest), types)) from match types {
      Nil => checked_frame_return(c, Star, ordered)
      Cons(o, more) => checked_frame_bind(
        <A: Unit, B: Unit>,
        c,
        (u: Unit, c1: Checker) => ck_rewrap1(ck_lambda_written(c1, rest, more)),
        ck_lambda_written_at(c, p, o),
        lw_at_checked_frame(c, p, o, ordered),
        u => c1 => o_c1 => checked_frame_rewrap(
          c1,
          ck_lambda_written(c1, rest, more),
          ck_lambda_written_run_frame_checked(c1, rest, more, o_c1)
        )
      )
    }
  }
}

pub theorem ck_lambda_hints_run_frame_checked(
  c: Checker,
  hint: Option(Ty),
  ps: List(Ty),
  types: List(Option(SurfaceTerm)),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_lambda_hints(c, hint, ps, types)) {
  checked_frame_bind(
    <A: Unit, B: Unit>,
    c,
    (u: Unit, c1: Checker) => ck_rewrap1(ck_lambda_hint_of(c1, hint, ps)),
    ck_lambda_written(c, ps, types),
    ck_lambda_written_run_frame_checked(c, ps, types, ordered),
    u => c1 => o_c1 => checked_frame_rewrap(
      c1,
      ck_lambda_hint_of(c1, hint, ps),
      ck_lambda_hint_of_run_frame_checked(c1, hint, ps, o_c1)
    )
  )
}
