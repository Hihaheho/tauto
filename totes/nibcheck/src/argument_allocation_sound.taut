pub theorem run_expect_after_allocation(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  fits: Bool,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  declarations: DatasAllocated(ck_next_of(c), ck_datas_of(c)),
  left: TypeAllocated(ck_next_of(c), a),
  right: TypeAllocated(ck_next_of(c), b)
): AllocationAdvance(c, run_expect_after(c, a, b, span, what, fits)) {
  match fits {
    true => allocation_advance_return(c, Star, state)
    false => allocation_advance_bind(
      <A: Option(CoerceFound), B: Unit>,
      c,
      (found: Option(CoerceFound), next: Checker) => run_expect_refused(next, a, b, span, what, found),
      ck_coerce_fit(c, a, b),
      ck_coerce_fit_allocation(c, a, b, ordered, state, declarations, left, right),
      And::left(ck_coerce_fit_grows(c, a, b, ordered)),
      found => next => advanced => current => order => allocation_error_if(
        next,
        coerce_refusal(next, a, b, what, found),
        span,
        current,
        coerce_refused(next, found)
      )
    )
  }
}
pub theorem expect_allocation_bind(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  m: Mut1(Bool, Checker),
  first: AllocationAdvance(c, m),
  grows: Grows(c, ck_st(m)),
  declarations: DatasAllocated(ck_next_of(c), ck_datas_of(c)),
  left: TypeAllocated(ck_next_of(c), a),
  right: TypeAllocated(ck_next_of(c), b)
): AllocationAdvance(
  c,
  frame_bind(<A: Bool, B: Unit>, (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits), m)
) {
  ⊢ AllocationAdvance(
    c,
    frame_bind(<A: Bool, B: Unit>, (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits), m)
  ) from match m {
    mut1(fits, next) => allocation_advance_start(
      c,
      next,
      run_expect_after(next, a, b, span, what, fits),
      And::left(first),
      run_expect_after_allocation(
        next,
        a,
        b,
        span,
        what,
        fits,
        And::left(grows),
        And::right(first),
        Eq::subst(
          (d: Datas) => DatasAllocated(ck_next_of(next), d),
          And::left(And::right(And::right(And::right(grows)))),
          datas_allocated_weaken(ck_datas_of(c), ck_next_of(c), ck_next_of(next), And::left(first), declarations)
        ),
        type_allocated_weaken(a, ck_next_of(c), ck_next_of(next), And::left(first), left),
        type_allocated_weaken(b, ck_next_of(c), ck_next_of(next), And::left(first), right)
      )
    )
  }
}
pub theorem ck_expect_allocation(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  declarations: DatasAllocated(ck_next_of(c), ck_datas_of(c)),
  left: TypeAllocated(ck_next_of(c), a),
  right: TypeAllocated(ck_next_of(c), b)
): AllocationAdvance(c, ck_expect(c, a, b, span, what)) {
  Eq::subst(
    (result: Mut1(Unit, Checker)) => AllocationAdvance(c, result),
    Eq::sym(run_expect_unf(c, a, b, span, what)),
    expect_allocation_bind(
      c,
      a,
      b,
      span,
      what,
      ck_fits_wide(c, a, b),
      ck_fits_wide_allocation(c, a, b, ordered, state, left, right),
      And::left(ck_fits_wide_ok(c, a, b)(ordered)),
      declarations,
      left,
      right
    )
  )
}
pub theorem allocation_advance_bind_run<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  first: AllocationAdvance(c, m),
  frame: CkRunFrame(c, m),
  tail: ∀ value: A. ∀ next: Checker. ∀ advanced: Nat::le(
    ck_next_of(c),
    ck_next_of(next)
  ) = true. ∀ state: CheckerAllocation(
    next
  ). ∀ order: CkOrdered(next). ∀ same: ck_datas_of(next) = ck_datas_of(c). AllocationAdvance(next, k(value, next))
): AllocationAdvance(c, frame_bind(<A: A, B: B>, k, m)) {
  match m {
    mut1(value, next) => allocation_advance_start(
      c,
      next,
      k(value, next),
      And::left(first),
      tail(value, next, And::left(first), And::right(first), And::left(frame), And::right(frame))
    )
  }
}
pub def ArgumentsAllocationIH(
  rest: List(Ty)
): Prop := ∀ c: Checker. ∀ ps: List(
  Ty
). ∀ args: List(
  SurfaceTerm
). ∀ ordered: CkOrdered(
  c
). ∀ state: CheckerAllocation(
  c
). ∀ actual: TypeListAllocated(
  ck_next_of(c),
  rest
). ∀ expected: TypeListAllocated(
  ck_next_of(c),
  ps
). ∀ declarations: DatasAllocated(
  ck_next_of(c),
  ck_datas_of(c)
). AllocationAdvance(c, ck_expect_args(rest, c, ps, args))
pub theorem argument_terms_allocation(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  p: Ty,
  more: List(Ty),
  ih: ArgumentsAllocationIH(rest),
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  actual: TypeListAllocated(ck_next_of(c), Cons(a, rest)),
  expected: TypeListAllocated(ck_next_of(c), Cons(p, more)),
  args: List(SurfaceTerm),
  declarations: DatasAllocated(ck_next_of(c), ck_datas_of(c))
): AllocationAdvance(c, argument_terms(a, rest, c, p, more, args)) {
  match args {
    Nil => allocation_advance_return(c, Star, state)
    Cons(at, tail) => allocation_advance_bind_run(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, next: Checker) => ck_rewrap1(ck_expect_args(rest, next, more, tail)),
      ck_expect(c, a, p, span_of(at), what_argument_message()),
      ck_expect_allocation(
        c,
        a,
        p,
        span_of(at),
        what_argument_message(),
        ordered,
        state,
        declarations,
        And::left(actual),
        And::left(expected)
      ),
      ck_expect_run_frame(c, a, p, span_of(at), what_argument_message(), ordered),
      ignored => next => advanced => current => order => same => allocation_advance_rewrap(
        next,
        ck_expect_args(rest, next, more, tail),
        ih(
          next,
          more,
          tail,
          order,
          current,
          type_list_allocated_weaken(
            rest,
            ck_next_of(c),
            ck_next_of(next),
            advanced,
            And::right(actual)
          ),
          type_list_allocated_weaken(
            more,
            ck_next_of(c),
            ck_next_of(next),
            advanced,
            And::right(expected)
          ),
          Eq::subst(
            (datas: Datas) => DatasAllocated(ck_next_of(next), datas),
            Eq::sym(same),
            datas_allocated_weaken(ck_datas_of(c), ck_next_of(c), ck_next_of(next), advanced, declarations)
          )
        )
      )
    )
  }
}
pub theorem argument_params_allocation(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  args: List(SurfaceTerm),
  ih: ArgumentsAllocationIH(rest),
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  actual: TypeListAllocated(ck_next_of(c), Cons(a, rest)),
  ps: List(Ty),
  expected: TypeListAllocated(ck_next_of(c), ps),
  declarations: DatasAllocated(ck_next_of(c), ck_datas_of(c))
): AllocationAdvance(c, argument_params(a, rest, c, args, ps)) {
  match ps {
    Nil => allocation_advance_return(c, Star, state)
    Cons(p, more) => argument_terms_allocation(
      a,
      rest,
      c,
      p,
      more,
      ih,
      ordered,
      state,
      actual,
      expected,
      args,
      declarations
    )
  }
}
pub theorem ck_expect_args_allocation(
  tys: List(Ty),
  c: Checker,
  ps: List(Ty),
  args: List(SurfaceTerm),
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  actual: TypeListAllocated(ck_next_of(c), tys),
  expected: TypeListAllocated(ck_next_of(c), ps),
  declarations: DatasAllocated(ck_next_of(c), ck_datas_of(c))
): AllocationAdvance(c, ck_expect_args(tys, c, ps, args)) {
  match tys {
    Nil => allocation_advance_return(c, Star, state)
    Cons(a, rest) => Eq::subst(
      (result: Mut1(Unit, Checker)) => AllocationAdvance(c, result),
      Eq::sym(argument_cons_unf(a, rest, c, ps, args)),
      argument_params_allocation(
        a,
        rest,
        c,
        args,
        next => more => terms => order => current => left => right => known => ck_expect_args_allocation(
          rest,
          next,
          more,
          terms,
          order,
          current,
          left,
          right,
          known
        ),
        ordered,
        state,
        actual,
        ps,
        expected,
        declarations
      )
    )
  }
}
