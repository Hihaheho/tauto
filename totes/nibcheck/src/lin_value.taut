// Continued from `lin_value_head.taut`.

pub fn lin_check_all(c: &mut Lin, program: List(SurfaceStmt)): List(LinError) {
  set_to(&mut c.lends, lin_lends_of(program, c.lends))
  set_to(&mut c.lends_effects, lin_lends_named(program, c.lends_effects))
  set_to(&mut c.generic_borrows, lin_generic_borrows_of(program, c.generic_borrows))
  set_to(&mut c.parametric, lin_parametric_of(program, c.parametric))
  lin_check_fns_in(c.steps, &mut c, program)
  lin_push_frame(&mut c, frame_default())
  set_to(&mut c.live, Cons(live_of_program(c.steps, program), c.live))
  lin_block_in(c.steps, &mut c, program, true)
  lin_pop_frame(&mut c)
  List::reverse(c.errors)
}

// The effect each integer or float operator of `terms` performs when its
// result does not exist (`operator_effect` of `rows.rs`), by where the operator
// is: fixed-width `+`, `-`, `*` perform `overflow`; unbounded `nat` does not.
pub fn lin_ops_of(types: TypeReport, terms: List(SurfaceTerm), acc: Ordmap(RowSpan, Text)): Ordmap(RowSpan, Text) {
  match terms {
    Nil => acc
    Cons(t, rest) => lin_ops_of(types, rest, ⊢ Ordmap(RowSpan, Text) from match t.kind {
      SkApp(function, arguments) => ⊢ Ordmap(RowSpan, Text) from match function.kind {
        SkVar(n) => ⊢ Ordmap(RowSpan, Text) from match lin_operator_effect(types, t, surface_name_text(n), arguments) {
          Some(op_effect) => Ordmap::insert(acc, RowSpan { start: t.start, end: t.end }, op_effect, rows_compare_span)
          None => acc
        }
        _ => acc
      }
      _ => acc
    })
  }
}

pub fn lin_operator_effect(types: TypeReport, t: SurfaceTerm, op: Text, arguments: List(SurfaceTerm)): Option(Text) {
  let width: Option(Width) := Ordmap::get(types.widths, term_at_of(t), term_at_compare)
  let fits: Bool := match width {
    Some(w) => lin_literal_fits(w, op, arguments)
    None => false
  }
  if fits {
    None
  } else if op == "div" || op == "mod" {
    if lin_nonzero_divisor(arguments) { None } else { Some("divzero") }
  } else if op == "-" || op == "+" || op == "*" {
    match width {
      Some(w) => if lin_width_is_nat(w) { None } else { Some("overflow") }
      None => None
    }
  } else if op == "/" {
    match Ordmap::get(types.terms, term_at_of(t), term_at_compare) {
      Some(TyFloat) => Some("divzero")
      Some(TyFloat32) => Some("divzero")
      _ => None
    }
  } else {
    None
  }
}

// The use check of a program whose types check.
pub fn lin_check(types: TypeReport, rows: RowReport, program: List(SurfaceStmt)): List(LinError) {
  var c: Lin := lin_new(types, rows, 16 * (program_extent(program) + 1))
  lin_check_all(&mut c, program)
}

// The use check, then the cycle check when it passes.
pub fn lin_and_cycles(
  pre: RowsPrelude,
  types: TypeReport,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt)
): List(LinError) {
  let ops := lin_ops_of(types, subterms_stmts(program, Nil), Ordmap::empty())
  let rows := rows_check_with(pre, ops, prelude, program)
  ⊢ List(LinError) from match lin_check(types, rows, program) {
    // Which calls are settled is read from the rows the analysis gives: a
    // function of the prelude that the verifier does not cover leaves them as
    // they are (`settled_calls` of the Rust check reads the same).
    Nil => cycle_check(types, rows_check_env(rows_env_with_ops(rows_env(prelude, program), ops), program), prelude, program)
    Cons(e, rest) => Cons(e, rest)
  }
}

// The dump of the use check, or nothing when the program has type errors.
pub fn lin_run(
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  module_errors: List(TypeError)
): Option(Text) {
  lin_run_report(rows_prelude(prelude), types_check(prelude, program, module_errors), prelude, program)
}

pub fn lin_run_report(
  pre: RowsPrelude,
  types: TypeReport,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt)
): Option(Text) {
  match types.errors {
    Cons(^e, ^rest) => None
    Nil => Some(Text::concat_all(lin_dump_errors(lin_and_cycles(pre, types, prelude, program))))
  }
}

// The functions declared with no `where`, by name.
pub fn lin_parametric_of(
  stmts: List(SurfaceStmt),
  acc: Ordmap(Text, LinParametric)
): Ordmap(Text, LinParametric) {
  match stmts {
    Nil => acc
    Cons(st, rest) => lin_parametric_of(rest, ⊢ Ordmap(Text, LinParametric) from match st {
      StFn(f) => lin_parametric_fn(f, acc)
      StExtern(fns, ^instances, ^types, ^structs, ^enums, ^start, ^end) => lin_parametric_fns(fns, acc)
      _ => acc
    })
  }
}

pub fn lin_parametric_fns(
  fns: List(SurfaceFn),
  acc: Ordmap(Text, LinParametric)
): Ordmap(Text, LinParametric) {
  match fns {
    Nil => acc
    Cons(f, rest) => lin_parametric_fns(rest, lin_parametric_fn(f, acc))
  }
}

pub fn lin_parametric_fn(f: SurfaceFn, acc: Ordmap(Text, LinParametric)): Ordmap(Text, LinParametric) {
  match f.wheres {
    Nil => Ordmap::insert(
      acc,
      f.name,
      LinParametric { generics: f.generics, effects: f.effects, r#borrows: f.r#borrows, types: f.param_types },
      Ordmap::compare_text
    )
    Cons(^w, ^more) => acc
  }
}

// For each function, whether each parameter is a borrow of one of its type
// parameters (`x: &A`).
pub fn lin_generic_borrows_of(
  stmts: List(SurfaceStmt),
  acc: Ordmap(Text, List(Bool))
): Ordmap(Text, List(Bool)) {
  match stmts {
    Nil => acc
    Cons(st, rest) => lin_generic_borrows_of(rest, ⊢ Ordmap(Text, List(Bool)) from match st {
      StFn(f) => lin_generic_borrows_fn(f, acc)
      StExtern(fns, ^instances, ^types, ^structs, ^enums, ^start, ^end) => lin_generic_borrows_fns(fns, acc)
      _ => acc
    })
  }
}

pub fn lin_generic_borrows_fns(
  fns: List(SurfaceFn),
  acc: Ordmap(Text, List(Bool))
): Ordmap(Text, List(Bool)) {
  match fns {
    Nil => acc
    Cons(f, rest) => lin_generic_borrows_fns(rest, lin_generic_borrows_fn(f, acc))
  }
}

pub fn lin_generic_borrows_fn(f: SurfaceFn, acc: Ordmap(Text, List(Bool))): Ordmap(Text, List(Bool)) {
  match f.generics {
    Nil => acc
    Cons(^g, ^more) => Ordmap::insert(
      acc,
      f.name,
      generic_borrow_flags(f.r#borrows, f.param_types, f.generics),
      Ordmap::compare_text
    )
  }
}

pub fn generic_borrow_flags(
  r#borrows: List(Option(Bool)),
  types: List(Option(SurfaceTerm)),
  generics: List(Text)
): List(Bool) {
  match types {
    Nil => Nil
    Cons(t, rest) => Cons(
      generic_borrow_flag(borrow_head(r#borrows), t, generics),
      generic_borrow_flags(List::tail(r#borrows), rest, generics)
    )
  }
}

pub fn generic_borrow_flag(r#borrow: Option(Bool), t: Option(SurfaceTerm), generics: List(Text)): Bool {
  match t {
    None => false
    Some(ty) => ⊢ Bool from match ty.kind {
      SkBorrow(^m, ^m_orig, inner) => ⊢ Bool from match inner.kind {
        SkVar(n) => text_list_has(generics, surface_name_text(n))
        _ => false
      }
      SkVar(n) => ⊢ Bool from match r#borrow {
        Some(^m) => text_list_has(generics, surface_name_text(n))
        None => false
      }
      _ => false
    }
  }
}

// `borrows(…)`: for each function that writes it, whether its result may
// borrow each parameter (`borrows(p.a)` names `p`).
pub fn lin_lends_of(stmts: List(SurfaceStmt), acc: Ordmap(Text, List(Option(List(List(Text)))))): Ordmap(Text, List(Option(List(List(Text))))) {
  match stmts {
    Nil => acc
    Cons(st, rest) => lin_lends_of(rest, ⊢ Ordmap(Text, List(Option(List(List(Text))))) from match st {
      StFn(f) => lin_lends_fn(f, acc)
      StExtern(fns, ^instances, ^types, ^structs, ^enums, ^start, ^end) => lin_lends_fns(fns, acc)
      _ => acc
    })
  }
}

pub fn lin_lends_fns(fns: List(SurfaceFn), acc: Ordmap(Text, List(Option(List(List(Text)))))): Ordmap(Text, List(Option(List(List(Text))))) {
  match fns {
    Nil => acc
    Cons(f, rest) => lin_lends_fns(rest, lin_lends_fn(f, acc))
  }
}

pub fn lin_lends_fn(f: SurfaceFn, acc: Ordmap(Text, List(Option(List(List(Text)))))): Ordmap(Text, List(Option(List(List(Text))))) {
  match f.lends {
    Some(ls) => Ordmap::insert(acc, f.name, lends_paths(f.params, ls), Ordmap::compare_text)
    None => acc
  }
}

pub fn lends_paths(params: List(Text), ls: List(Text)): List(Option(List(List(Text)))) {
  match params {
    Nil => Nil
    Cons(p, rest) => Cons(
      ⊢ Option(List(List(Text))) from match lends_param_paths(ls, p) {
        Nil => None
        Cons(first, more) => Some(Cons(first, more))
      },
      lends_paths(rest, ls)
    )
  }
}

// The fields after `p` of each entry of `borrows(…)` rooted at `p`.
pub fn lends_param_paths(ls: List(Text), p: Text): List(List(Text)) {
  match ls {
    Nil => Nil
    Cons(l, rest) => ⊢ List(List(Text)) from match text_split(l, ".") {
      Cons(r, fields) => if r == p {
        Cons(fields, lends_param_paths(rest, p))
      } else {
        lends_param_paths(rest, p)
      }
      Nil => lends_param_paths(rest, p)
    }
  }
}

pub fn lends_root(l: Text): Text {
  match text_split(l, ".") {
    Cons(r, ^rest) => r
    Nil => l
  }
}

// `borrows(…)`: for each function that writes it, what it names (an operation
// of the row among them).
pub fn lin_lends_named(stmts: List(SurfaceStmt), acc: Ordmap(Text, List(Text))): Ordmap(Text, List(Text)) {
  match stmts {
    Nil => acc
    Cons(st, rest) => lin_lends_named(rest, ⊢ Ordmap(Text, List(Text)) from match st {
      StFn(f) => lin_lends_named_fn(f, acc)
      StExtern(fns, ^instances, ^types, ^structs, ^enums, ^start, ^end) => lin_lends_named_fns(fns, acc)
      _ => acc
    })
  }
}

pub fn lin_lends_named_fns(fns: List(SurfaceFn), acc: Ordmap(Text, List(Text))): Ordmap(Text, List(Text)) {
  match fns {
    Nil => acc
    Cons(f, rest) => lin_lends_named_fns(rest, lin_lends_named_fn(f, acc))
  }
}

pub fn lin_lends_named_fn(f: SurfaceFn, acc: Ordmap(Text, List(Text))): Ordmap(Text, List(Text)) {
  match f.lends {
    Some(ls) => Ordmap::insert(acc, f.name, ls, Ordmap::compare_text)
    None => acc
  }
}
