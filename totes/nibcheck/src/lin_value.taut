import "lin_arms.taut"

// Expressions and statements (`value`, `field`, `app`, `lend`, `access`,
// `closure`, `block`, `stmt`, `match_expr`, `handle`, `function` of `lin.rs`):
// one group, which walks the program on fuel enough for its extent.

fn lin_is_lambda(t: SurfaceTerm) -> Yn {
  match t.kind -> Yn {
    SkLam(ps, b) => yes
    SkBorrowLam(bs, l) => yes
    _ => no
  }
}

fn lin_is_var(t: SurfaceTerm) -> Yn {
  match t.kind -> Yn {
    SkVar(n) => yes
    _ => no
  }
}

// Whether `t` has a type of a duplicable value.
fn lin_term_is_dup(c: Lin, t: SurfaceTerm) -> Yn {
  match lin_term_type(c, t) -> Yn {
    Some(ty) => class_is_dup(lin_class_of(c, Some(ty)).fst)
    None => no
  }
}

// `x` is a borrow here: `&p`, or a name bound to a borrow that is not of a
// duplicable value.
fn lin_is_borrow(c: Lin, t: SurfaceTerm) -> Yn {
  match t.kind -> Yn {
    SkBorrow(m, term) => !lin_term_is_dup(c, term)
    SkVar(n) => match lin_find(c, n) -> Yn {
      Some(i) => mode_is_borrow(lin_get(c, i).mode) && !class_is_dup(lin_get(c, i).class)
      None => no
    }
    _ => no
  }
}

// ----- names -----

// A `let` of a closure that borrows keeps what it borrows.
fn lin_let_closure(b: Binding, pos: LinPos) -> Option(Pair(List(Text), Yn)) {
  if pos_is_let(pos) {
    match b.mode -> Option(Pair(List(Text), Yn)) {
      ModeBorrowClosure(names, m) => Some(Pair { fst: names, snd: m })
      _ => None()
    }
  } else {
    None()
  }
}

fn lin_value_at(
  &mut c: Lin,
  t: SurfaceTerm,
  i: Nat,
  b: Binding,
  pos: LinPos
) -> Option(Pair(List(Text), Yn)) {
  match lin_let_closure(b, pos) -> Option(Pair(List(Text), Yn)) {
    Some(nm) => {
      lin_read(&mut c, i, span_of(t))
      Some(nm)
    }
    None => {
      if (
        pos_is_result(pos) && lin_frame(c).returns_borrow && mode_is_borrow(b.mode)
      ) || (pos_is_drop(pos) && class_is_dup(b.class)) {
        lin_read(&mut c, i, span_of(t))
      } else {
        lin_take(&mut c, i, span_of(t))
      }
      None()
    }
  }
}

fn lin_value_var(
  &mut c: Lin,
  t: SurfaceTerm,
  name: Text,
  pos: LinPos
) -> Option(Pair(List(Text), Yn)) {
  match lin_find(c, name) -> Option(Pair(List(Text), Yn)) {
    None => None()
    Some(i) => lin_value_at(&mut c, t, i, lin_get(c, i), pos)
  }
}

// Stopped, a budget's body goes to the `exceeded` arm as `info`, a value that
// may outlive what the body borrows.
fn lin_budget_lent(&mut c: Lin, body: SurfaceTerm) -> () {
  match lin_lent_outside(c, body, Nil) -> () {
    Some(
      lent
    ) => lin_error(
      &mut c,
      cat2(lent, " is borrowed in a budget, whose stopped body may outlive it"),
      span_of(body)
    )
    None => ()
  }
}

// ----- fields -----

fn lin_base_is_info(c: Lin, base: SurfaceTerm) -> Yn {
  match lin_term_type(c, base) -> Yn {
    Some(ty) => match ty_unborrowed(ty) -> Yn {
      TyInfo(x) => yes
      _ => no
    }
    None => no
  }
}

// `x.f.g` whose root is bound: a duplicable field is copied; an affine one
// cannot be taken out of an owned value, and one of a borrow is a borrow.
fn lin_field_place(
  &mut c: Lin,
  t: SurfaceTerm,
  p: Pair(Text, List(Text)),
  class: LinClass,
  pos: LinPos
) -> () {
  match lin_find(c, p.fst) -> () {
    None => ()
    Some(i) => {
      lin_read(&mut c, i, span_of(t))
      let borrowed: Yn = mode_is_borrow(lin_get(c, i).mode)
      if !class_is_dup(class) && !c.dead {
        if borrowed {
          if !(pos_is_result(pos) && lin_frame(c).returns_borrow) {
            lin_error(
              &mut c,
              cat2(text_join(p.snd, "."), " is borrowed and cannot be moved"),
              span_of(t)
            )
          }
        } else {
          lin_error(
            &mut c,
            cat4(text_join(p.snd, "."), " is ", class_word(class), cat2("; destructure ", p.fst)),
            span_of(t)
          )
        }
      }
    }
  }
}

// ----- calls -----

// A name bound to a closure that borrows: lent to a `&f` parameter all the same.
fn lin_is_borrow_closure_var(c: Lin, t: SurfaceTerm) -> Yn {
  match t.kind -> Yn {
    SkVar(n) => match lin_find(c, n) -> Yn {
      Some(i) => match lin_get(c, i).mode -> Yn {
        ModeBorrowClosure(names, m) => yes
        _ => no
      }
      None => no
    }
    _ => no
  }
}

fn lin_borrow_mode(c: Lin, p: Ty, a: SurfaceTerm, b: Option(Yn)) -> Option(Yn) {
  match p -> Option(Yn) {
    TyBorrow(
      inner,
      m
    ) => if lin_is_lambda(
      a
    ) || lin_is_borrow_closure_var(c, a) || !class_is_dup(lin_kind(c, inner)) {
      Some(m)
    } else {
      b
    }
    _ => b
  }
}

// For each argument `none` (a value) or `some(mutable)` (the parameter borrows).
fn lin_borrows_of(
  borrows: List(Option(Yn)),
  c: Lin,
  ps: List(Ty),
  arguments: List(SurfaceTerm)
) -> List(Option(Yn)) {
  match borrows -> List(Option(Yn)) {
    Nil => Nil
    Cons(b, rest) => match ps -> List(Option(Yn)) {
      Nil => Cons(b, rest)
      Cons(p, more) => match arguments -> List(Option(Yn)) {
        Nil => Cons(b, rest)
        Cons(a, atail) => Cons(lin_borrow_mode(c, p, a, b), lin_borrows_of(rest, c, more, atail))
      }
    }
  }
}

fn none_list(n: Nat) -> List(Option(Yn)) {
  match n -> List(Option(Yn)) {
    zero => Nil
    succ(m) => Cons(None(), none_list(m))
  }
}

fn some_false_list(n: Nat) -> List(Option(Yn)) {
  match n -> List(Option(Yn)) {
    zero => Nil
    succ(m) => Cons(Some(no), some_false_list(m))
  }
}

fn lin_local_callee(c: Lin, function: SurfaceTerm) -> Option(Nat) {
  match function.kind -> Option(Nat) {
    SkVar(name) => lin_find(c, name)
    _ => None()
  }
}

fn option_nat_is_none(o: Option(Nat)) -> Yn {
  match o -> Yn {
    Some(i) => no
    None => yes
  }
}

// `clone(x)` of the prelude borrows its operand, and `==` and `!=` read
// theirs.
fn lin_is_clone(c: Lin, function: SurfaceTerm) -> Yn {
  match function.kind -> Yn {
    SkVar(name) => if name == "clone" || name == "==" || name == "!=" {
      option_nat_is_none(lin_find(c, name))
    } else {
      no
    }
    _ => no
  }
}

fn lin_call_borrows(
  c: Lin,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm)
) -> List(Option(Yn)) {
  let n: Nat = list_len(arguments)
  let base: List(
    Option(Yn)
  ) = if lin_is_clone(c, function) { some_false_list(n) } else { none_list(n) }
  match lin_term_type(c, function) -> List(Option(Yn)) {
    Some(ft) => match ty_unborrowed(ft) -> List(Option(Yn)) {
      TyFn(ps, r, kind) => lin_borrows_of(base, c, ps, arguments)
      _ => base
    }
    None => base
  }
}

// Calling a bound callee: an affine function is used; a borrowed one or a
// closure that borrows is read.
fn lin_use_callee(&mut c: Lin, i: Nat, span: TySpan) -> () {
  let b: Binding = lin_get(c, i)
  if class_is_dup(b.class) || mode_borrows(b.mode) {
    lin_read(&mut c, i, span)
  } else {
    lin_take(&mut c, i, span)
  }
}

fn borrow_head(bs: List(Option(Yn))) -> Option(Yn) {
  match bs -> Option(Yn) {
    Nil => None()
    Cons(o, rest) => o
  }
}

fn use_is_move(u: LinUse) -> Yn {
  match u -> Yn {
    UseMove => yes
    _ => no
  }
}

fn lin_use_of(mutable: Yn) -> LinUse {
  if mutable { UseMut } else { UseShared }
}

fn path_has_prefix(prefix: List(Text), path: List(Text)) -> Yn {
  match prefix -> Yn {
    Nil => yes
    Cons(p, prest) => match path -> Yn {
      Nil => no
      Cons(q, qrest) => if p == q { path_has_prefix(prest, qrest) } else { no }
    }
  }
}

// What a place one call lent or moved before says about using it `how` now:
// `rest` when the two may go together.
fn access_clash(prev: LinUse, how: LinUse, name: Text, rest: Option(Text)) -> Option(Text) {
  match prev -> Option(Text) {
    UseMove => match how -> Option(Text) {
      UseMove => rest
      UseShared => Some(cat2(name, " is borrowed after move"))
      UseMut => Some(cat2(name, " is borrowed after move"))
    }
    UseShared => match how -> Option(Text) {
      UseMove => Some(cat2(name, " is moved while it is borrowed in the same call"))
      UseShared => rest
      UseMut => Some(cat2(name, " is borrowed twice in one call"))
    }
    UseMut => match how -> Option(Text) {
      UseMove => Some(cat2(name, " is moved while it is borrowed in the same call"))
      UseShared => Some(cat2(name, " is borrowed twice in one call"))
      UseMut => Some(cat2(name, " is borrowed twice in one call"))
    }
  }
}

// The message of an overlap with a place one call lent or moved before, if any.
fn access_overlap(
  prevs: List(Access),
  root: Nat,
  path: List(Text),
  how: LinUse,
  name: Text
) -> Option(Text) {
  match prevs -> Option(Text) {
    Nil => None()
    Cons(
      prev,
      rest
    ) => if nat_eq(
      prev.root,
      root
    ) && (path_has_prefix(path, prev.path) || path_has_prefix(prev.path, path)) {
      access_clash(prev.how, how, name, access_overlap(rest, root, path, how, name))
    } else {
      access_overlap(rest, root, path, how, name)
    }
  }
}

// Records a place one call lends or moves, and reports an overlap with what it
// lent or moved before.
fn lin_access(
  &mut c: Lin,
  accesses: List(Access),
  root: Nat,
  path: List(Text),
  how: LinUse,
  span: TySpan
) -> List(Access) {
  let b: Binding = lin_get(c, root)
  if class_is_dup(b.class) && use_is_move(how) {
    accesses
  } else {
    match access_overlap(accesses, root, path, how, b.name) -> List(Access) {
      Some(message) => {
        lin_error(&mut c, message, span)
        accesses
      }
      None => list_append(accesses, Cons(access_mk(root, path, how), Nil))
    }
  }
}

fn lin_move_access(&mut c: Lin, accesses: List(Access), a: SurfaceTerm) -> List(Access) {
  match lin_place(a) -> List(Access) {
    Some(p) => match lin_find(c, p.fst) -> List(Access) {
      Some(i) => lin_access(&mut c, accesses, i, p.snd, UseMove, span_of(a))
      None => accesses
    }
    None => accesses
  }
}

fn lin_ty_class(c: Lin, ty: Ty) -> LinClass {
  match ty -> LinClass {
    TyBorrow(x, m) => ClassDup
    _ => lin_kind(c, ty)
  }
}

fn lin_arg_class(c: Lin, a: SurfaceTerm) -> LinClass {
  match lin_term_type(c, a) -> LinClass {
    None => ClassDup
    Some(ty) => lin_ty_class(c, ty)
  }
}

fn lin_arg_name(a: SurfaceTerm) -> Text {
  match a.kind -> Text {
    SkVar(nm) => nm
    _ => "an argument before it"
  }
}

// A value moved into a call waits there while the later arguments run.
fn lin_hold_arg(&mut c: Lin, a: SurfaceTerm) -> () {
  let class: LinClass = lin_arg_class(c, a)
  if !class_is_dup(class) {
    let i: Nat = lin_push_binding(&mut c, lin_arg_name(a), class, ModeOwned)
    lin_put(&mut c, i, binding_with_held(lin_get(c, i), yes))
  }
}

// Lending a name bound to a borrow lends what it borrows.
fn lin_lend_mutable(mode: LinMode, a: SurfaceTerm, mutable0: Yn) -> Yn {
  match mode -> Yn {
    ModeBorrow(m) => if lin_is_var(a) { m } else { mutable0 }
    _ => mutable0
  }
}

fn lin_lend_binding(
  &mut c: Lin,
  a: SurfaceTerm,
  p: Pair(Text, List(Text)),
  i: Nat,
  mutable0: Yn,
  accesses: List(Access),
  collect: Yn
) -> List(Access) {
  let captured: Yn = lin_captured_by_arm(&mut c, i, span_of(a))
  let b: Binding = lin_get(c, i)
  let mutable: Yn = lin_lend_mutable(b.mode, a, mutable0)
  if captured {
    accesses
  } else {
    if binding_owns(b) && !state_is_owned(b.state) {
      lin_error(&mut c, cat2(p.fst, " is borrowed after move"), span_of(a))
      accesses
    } else {
      match lin_frozen_by(c, i, mutable) -> List(Access) {
        Some(by) => {
          lin_error(&mut c, lin_frozen_text(p.fst, by), span_of(a))
          accesses
        }
        None => {
          let acc: List(
            Access
          ) = lin_access(&mut c, accesses, i, p.snd, lin_use_of(mutable), span_of(a))
          if collect {
            set_to(&mut c.lent, list_append(c.lent, Cons(Pair { fst: i, snd: mutable }, Nil)))
          }
          acc
        }
      }
    }
  }
}

// ----- closures -----

fn text_without(xs: List(Text), x: Text) -> List(Text) {
  match xs -> List(Text) {
    Nil => Nil
    Cons(y, rest) => if y == x { text_without(rest, x) } else { Cons(y, text_without(rest, x)) }
  }
}

inductive Captured(): Type {
  captured_mk(name: Text, class: LinClass, mode: LinMode): Captured
}

inductive Capture(): Type {
  capture_mk(borrowed: List(Text), any_mut: Yn, captured: List(Captured)): Capture
}

fn capture_add(cap: Capture, borrowed: List(Text), m: Yn, x: Captured) -> Capture {
  capture_mk(
    list_append(cap.borrowed, borrowed),
    cap.any_mut || m,
    list_append(cap.captured, Cons(x, Nil))
  )
}

// A `var` a closure captures is borrowed, unless an arm may not capture it.
fn lin_capture_var(&mut c: Lin, i: Nat, b: Binding, body: SurfaceTerm, cap: Capture) -> Capture {
  let captured: Yn = lin_captured_by_arm(&mut c, i, span_of(body))
  if captured {
    cap
  } else {
    capture_add(cap, Cons(b.name, Nil), yes, captured_mk(b.name, b.class, ModeVarInClosure))
  }
}

fn lin_capture_binding(&mut c: Lin, i: Nat, b: Binding, body: SurfaceTerm, cap: Capture) -> Capture {
  if class_is_dup(b.class) {
    // A `var`'s cell is shared with the closure whatever its content: the
    // closure borrows it.
    match b.mode -> Capture {
      ModeVar => lin_capture_var(&mut c, i, b, body, cap)
      ModeVarInClosure => lin_capture_var(&mut c, i, b, body, cap)
      ModeOwned => capture_add(cap, Nil, no, captured_mk(b.name, ClassDup, b.mode))
      ModeBorrow(m) => capture_add(cap, Nil, no, captured_mk(b.name, ClassDup, b.mode))
      ModeBorrowClosure(names, m) => capture_add(
        cap,
        Nil,
        no,
        captured_mk(b.name, ClassDup, b.mode)
      )
    }
  } else {
    match b.mode -> Capture {
      ModeOwned => {
        lin_take(&mut c, i, span_of(body))
        capture_add(cap, Nil, no, captured_mk(b.name, b.class, ModeOwned))
      }
      ModeVar => lin_capture_var(&mut c, i, b, body, cap)
      ModeVarInClosure => lin_capture_var(&mut c, i, b, body, cap)
      ModeBorrow(m) => {
        let captured: Yn = lin_captured_by_arm(&mut c, i, span_of(body))
        if captured {
          cap
        } else {
          capture_add(cap, Cons(b.name, Nil), m, captured_mk(b.name, b.class, ModeBorrow(m)))
        }
      }
      ModeBorrowClosure(names, m) => capture_add(
        cap,
        names,
        m,
        captured_mk(b.name, b.class, b.mode)
      )
    }
  }
}

fn lin_capture_one(&mut c: Lin, name: Text, body: SurfaceTerm, cap: Capture) -> Capture {
  match lin_find(c, name) -> Capture {
    None => cap
    Some(i) => lin_capture_binding(&mut c, i, lin_get(c, i), body, cap)
  }
}

// What a closure captures: it moves the owned bindings, and borrows the
// borrowed ones and the `var`s.
fn lin_capture_scan(free: List(Text), &mut c: Lin, body: SurfaceTerm, cap: Capture) -> Capture {
  match free -> Capture {
    Nil => cap
    Cons(name, rest) => {
      let next: Capture = lin_capture_one(&mut c, name, body, cap)
      lin_capture_scan(rest, &mut c, body, next)
    }
  }
}

fn lin_push_captured(ts: List(Captured), &mut c: Lin) -> () {
  match ts -> () {
    Nil => ()
    Cons(x, rest) => {
      let i: Nat = lin_push_binding(&mut c, x.name, x.class, x.mode)
      lin_push_captured(rest, &mut c)
    }
  }
}

fn capture_result(cap: Capture) -> Option(Pair(List(Text), Yn)) {
  match cap.borrowed -> Option(Pair(List(Text), Yn)) {
    Nil => None()
    Cons(x, rest) => Some(Pair { fst: cap.borrowed, snd: cap.any_mut })
  }
}

// ----- bodies -----

// What a function's or a closure's body sets aside of the walk around it.
inductive LinSaved(): Type {
  lin_saved_mk(dead: Yn, arm_floor: Option(Nat), arm_direct: Option(Pair(Nat, Text))): LinSaved
}

fn lin_enter_body(&mut c: Lin, f: Frame) -> LinSaved {
  lin_push_frame(&mut c, f)
  let saved: LinSaved = lin_saved_mk(c.dead, c.arm_floor, c.arm_direct)
  set_to(&mut c.dead, no)
  set_to(&mut c.arm_floor, None())
  set_to(&mut c.arm_direct, None())
  saved
}

// A captured owned value the body does not use is dropped with the closure; a
// linear one must be used.
fn lin_leave_body(&mut c: Lin, saved: LinSaved, mark: Nat, span: TySpan) -> () {
  lin_pop_to(&mut c, mark, span)
  lin_pop_frame(&mut c)
  set_to(&mut c.dead, saved.dead)
  set_to(&mut c.arm_floor, saved.arm_floor)
  set_to(&mut c.arm_direct, saved.arm_direct)
}

// ----- statements -----

fn rest_is_nil(ss: List(SurfaceStmt)) -> Yn {
  match ss -> Yn {
    Nil => yes
    Cons(s, rest) => no
  }
}

fn pos_last(last: Yn) -> LinPos {
  if last { PosResult } else { PosDrop }
}

fn lin_let_borrows(&mut c: Lin, name: Text, value: SurfaceTerm, lent: List(Pair(Nat, Yn))) -> () {
  let i: Nat = lin_push(&mut c, name, value.start, no)
  if !class_is_dup(lin_get(c, i).class) {
    lin_freeze_all(lent, &mut c, i)
  }
}

fn closure_binding(b: Binding) -> Binding {
  if class_is_dup(b.class) { binding_with_class(b, ClassAffine) } else { b }
}

fn lin_let_value(
  &mut c: Lin,
  name: Text,
  value: SurfaceTerm,
  borrows: Option(Pair(List(Text), Yn))
) -> () {
  let i: Nat = lin_push(&mut c, name, value.start, no)
  match borrows -> () {
    Some(
      nm
    ) => lin_put(
      &mut c,
      i,
      closure_binding(binding_with_mode(lin_get(c, i), ModeBorrowClosure(nm.fst, nm.snd)))
    )
    None => ()
  }
}

fn lin_fn_borrows(&mut c: Lin, f: SurfaceFn, borrows: Option(Pair(List(Text), Yn))) -> () {
  let i: Nat = lin_push(&mut c, f.name, f.body.start, no)
  match borrows -> () {
    Some(
      nm
    ) => lin_put(
      &mut c,
      i,
      closure_binding(binding_with_mode(lin_get(c, i), ModeBorrowClosure(nm.fst, nm.snd)))
    )
    None => ()
  }
}

fn lin_assign_state(&mut c: Lin, i: Nat) -> () {
  match lin_get(c, i).mode -> () {
    ModeVar => lin_set_state(&mut c, i, BsOwned)
    ModeVarInClosure => lin_set_state(&mut c, i, BsOwned)
    _ => ()
  }
}

fn lin_assign(&mut c: Lin, name: Text, value: SurfaceTerm) -> () {
  match lin_find(c, name) -> () {
    None => ()
    Some(i) => {
      let captured: Yn = lin_captured_by_arm(&mut c, i, span_of(value))
      if !captured {
        match lin_frozen_by(c, i, yes) -> () {
          Some(by) => lin_error(&mut c, lin_frozen_text(name, by), span_of(value))
          None => ()
        }
        lin_assign_state(&mut c, i)
      }
    }
  }
}

// ----- the walk -----

mutual {
  // Walks `t`, whose value is taken as `pos` says. A closure that borrows
  // returns what it borrows, for a `let` to record.
  fn lin_value_in(k: Nat, &mut c: Lin, t: SurfaceTerm, pos: LinPos) -> Option(Pair(List(Text), Yn)) {
    match k -> Option(Pair(List(Text), Yn)) {
      zero => None()
      succ(j) => if c.dead {
        None()
      } else {
        if 0 < lin_frame(c).budgets {
          lin_event(&mut c, rowset_one("Exceeded"), span_of(t))
        }
        lin_value_kind_in(j, &mut c, t, pos)
      }
    }
  }

  fn lin_drop_in(k: Nat, &mut c: Lin, t: SurfaceTerm, pos: LinPos) -> () {
    match k -> () {
      zero => ()
      succ(j) => match lin_value_in(j, &mut c, t, pos) -> () {
        Some(nm) => ()
        None => ()
      }
    }
  }

  fn lin_opt_drop_in(k: Nat, &mut c: Lin, t: Option(SurfaceTerm), pos: LinPos) -> () {
    match k -> () {
      zero => ()
      succ(j) => match t -> () {
        Some(x) => lin_drop_in(j, &mut c, x, pos)
        None => ()
      }
    }
  }

  fn lin_value_kind_in(
    k: Nat,
    &mut c: Lin,
    t: SurfaceTerm,
    pos: LinPos
  ) -> Option(Pair(List(Text), Yn)) {
    match k -> Option(Pair(List(Text), Yn)) {
      zero => None()
      succ(j) => match t.kind -> Option(Pair(List(Text), Yn)) {
        SkVar(name) => lin_value_var(&mut c, t, name, pos)
        SkField(base, name) => {
          lin_field_in(j, &mut c, t, base, pos)
          None()
        }
        SkBorrow(m, term) => {
          if lin_term_is_dup(c, term) {
            lin_drop_in(j, &mut c, term, PosDrop)
          } else {
            lin_error(&mut c, "a borrow can only be lent to a borrowed parameter", span_of(t))
          }
          None()
        }
        SkLam(ps, body) => lin_value_closure_in(j, &mut c, t, pos)
        SkBorrowLam(bs, lam) => lin_value_closure_in(j, &mut c, t, pos)
        SkApp(function, arguments) => {
          lin_app_in(j, &mut c, t, function, arguments, no)
          None()
        }
        SkPerform(eff, args) => {
          lin_perform_args_in(j, &mut c, args)
          lin_call_event(&mut c, t)
          None()
        }
        SkRecord(name, fields) => {
          lin_record_fields_in(j, &mut c, fields)
          None()
        }
        SkIf(condition, th, el) => {
          lin_drop_in(j, &mut c, condition, PosDrop)
          let start: Option(List(LinState)) = lin_snapshot(c)
          lin_drop_in(j, &mut c, th, pos)
          let a: Option(List(LinState)) = lin_snapshot(c)
          lin_restore(&mut c, start)
          lin_opt_drop_in(j, &mut c, el, pos)
          let b: Option(List(LinState)) = lin_snapshot(c)
          lin_merge(&mut c, Cons(a, Cons(b, Nil)), span_of(t))
          None()
        }
        SkBlock(stmts) => {
          lin_block_in(j, &mut c, stmts, no)
          None()
        }
        SkMatch(scrutinee, mk, arms, hb) => {
          lin_match_expr_in(j, &mut c, t, scrutinee, arms, pos)
          None()
        }
        SkHandle(body, handlers) => {
          lin_handle_in(j, &mut c, body, handlers, pos)
          None()
        }
        SkBudget(steps, body) => {
          lin_drop_in(j, &mut c, steps, PosDrop)
          lin_budget_lent(&mut c, body)
          lin_frame_budgets_add(&mut c)
          lin_drop_in(j, &mut c, body, pos)
          lin_frame_budgets_sub(&mut c)
          None()
        }
        SkTagged(tag, term) => {
          lin_drop_in(j, &mut c, term, pos)
          None()
        }
        _ => None()
      }
    }
  }

  fn lin_value_closure_in(
    k: Nat,
    &mut c: Lin,
    t: SurfaceTerm,
    pos: LinPos
  ) -> Option(Pair(List(Text), Yn)) {
    match k -> Option(Pair(List(Text), Yn)) {
      zero => None()
      succ(j) => match lin_closure_in(j, &mut c, t) -> Option(Pair(List(Text), Yn)) {
        None => None()
        Some(nm) => if pos_is_let(pos) {
          Some(nm)
        } else {
          lin_error(
            &mut c,
            cat3("this closure borrows ", text_join(nm.fst, ", "), " and cannot be stored"),
            span_of(t)
          )
          None()
        }
      }
    }
  }

  fn lin_perform_args_in(k: Nat, &mut c: Lin, args: List(SurfaceTerm)) -> () {
    match k -> () {
      zero => ()
      succ(j) => match args -> () {
        Nil => ()
        Cons(a, rest) => {
          if lin_is_borrow(c, a) {
            lin_error(&mut c, "a borrow cannot be an effect argument", span_of(a))
          } else {
            lin_drop_in(j, &mut c, a, PosMove)
          }
          lin_perform_args_in(j, &mut c, rest)
        }
      }
    }
  }

  fn lin_record_fields_in(k: Nat, &mut c: Lin, fs: List(SurfaceField)) -> () {
    match k -> () {
      zero => ()
      succ(j) => match fs -> () {
        Nil => ()
        Cons(f, rest) => {
          lin_drop_in(j, &mut c, f.value, PosMove)
          lin_record_fields_in(j, &mut c, rest)
        }
      }
    }
  }

  // `base.name`: `info.more`, `info.unbounded` use `info`; a place is checked
  // as one; anything else is walked.
  fn lin_field_in(k: Nat, &mut c: Lin, t: SurfaceTerm, base: SurfaceTerm, pos: LinPos) -> () {
    match k -> () {
      zero => ()
      succ(j) => if lin_base_is_info(c, base) {
        lin_drop_in(j, &mut c, base, PosMove)
      } else {
        match lin_place(t) -> () {
          Some(p) => lin_field_place(&mut c, t, p, lin_class_of(c, lin_term_type(c, t)).fst, pos)
          None => lin_drop_in(j, &mut c, base, PosMove)
        }
      }
    }
  }

  // A call. When `collect` is set (a `let &x = f(…)`), the roots of what the
  // call borrows are added to `lent`.
  fn lin_app_in(
    k: Nat,
    &mut c: Lin,
    t: SurfaceTerm,
    function: SurfaceTerm,
    arguments: List(SurfaceTerm),
    collect: Yn
  ) -> () {
    match k -> () {
      zero => ()
      succ(j) => {
        let borrows: List(Option(Yn)) = lin_call_borrows(c, function, arguments)
        lin_callee_in(j, &mut c, function)
        let held: Nat = c.count
        let accesses: List(Access) = lin_app_args_in(j, &mut c, arguments, borrows, Nil, collect)
        lin_truncate(&mut c, held)
        lin_call_event(&mut c, t)
      }
    }
  }

  // The callee: calling an affine function uses it; a closure written in
  // place may borrow.
  fn lin_callee_in(k: Nat, &mut c: Lin, function: SurfaceTerm) -> () {
    match k -> () {
      zero => ()
      succ(j) => match lin_local_callee(c, function) -> () {
        Some(i) => lin_use_callee(&mut c, i, span_of(function))
        None => match function.kind -> () {
          SkVar(name) => ()
          SkLam(ps, body) => lin_closure_drop_in(j, &mut c, function)
          SkBorrowLam(bs, lam) => lin_closure_drop_in(j, &mut c, function)
          _ => lin_drop_in(j, &mut c, function, PosMove)
        }
      }
    }
  }

  fn lin_closure_drop_in(k: Nat, &mut c: Lin, t: SurfaceTerm) -> () {
    match k -> () {
      zero => ()
      succ(j) => match lin_closure_in(j, &mut c, t) -> () {
        Some(nm) => ()
        None => ()
      }
    }
  }

  fn lin_app_args_in(
    k: Nat,
    &mut c: Lin,
    arguments: List(SurfaceTerm),
    borrows: List(Option(Yn)),
    accesses: List(Access),
    collect: Yn
  ) -> List(Access) {
    match k -> List(Access) {
      zero => accesses
      succ(j) => match arguments -> List(Access) {
        Nil => accesses
        Cons(a, rest) => match borrow_head(borrows) -> List(Access) {
          Some(m) => {
            let acc: List(Access) = lin_lend_in(j, &mut c, a, accesses, collect)
            lin_app_args_in(j, &mut c, rest, list_tail(borrows), acc, collect)
          }
          None => if lin_is_borrow(c, a) && !lin_is_var(a) {
            lin_error(&mut c, "a borrow can only be lent to a borrowed parameter", span_of(a))
            lin_app_args_in(j, &mut c, rest, list_tail(borrows), accesses, collect)
          } else {
            let acc: List(Access) = lin_move_access(&mut c, accesses, a)
            lin_drop_in(j, &mut c, a, PosMove)
            lin_hold_arg(&mut c, a)
            lin_app_args_in(j, &mut c, rest, list_tail(borrows), acc, collect)
          }
        }
      }
    }
  }

  // An argument for a borrowed parameter: `&p`, `&mut p`, a borrowed name, a
  // closure written in place, or a temporary.
  fn lin_lend_in(
    k: Nat,
    &mut c: Lin,
    a: SurfaceTerm,
    accesses: List(Access),
    collect: Yn
  ) -> List(Access) {
    match k -> List(Access) {
      zero => accesses
      succ(j) => match a.kind -> List(Access) {
        SkBorrow(mutable, term) => lin_lend_place_in(j, &mut c, a, term, mutable, accesses, collect)
        SkVar(n) => lin_lend_place_in(j, &mut c, a, a, no, accesses, collect)
        SkLam(ps, body) => {
          lin_closure_drop_in(j, &mut c, a)
          accesses
        }
        SkBorrowLam(bs, lam) => {
          lin_closure_drop_in(j, &mut c, a)
          accesses
        }
        _ => {
          lin_drop_in(j, &mut c, a, PosDrop)
          accesses
        }
      }
    }
  }

  fn lin_lend_place_in(
    k: Nat,
    &mut c: Lin,
    a: SurfaceTerm,
    target: SurfaceTerm,
    mutable0: Yn,
    accesses: List(Access),
    collect: Yn
  ) -> List(Access) {
    match k -> List(Access) {
      zero => accesses
      succ(j) => match lin_place(target) -> List(Access) {
        None => {
          lin_drop_in(j, &mut c, target, PosDrop)
          accesses
        }
        Some(p) => match lin_find(c, p.fst) -> List(Access) {
          None => accesses
          Some(i) => lin_lend_binding(&mut c, a, p, i, mutable0, accesses, collect)
        }
      }
    }
  }

  // The call a `let &x` binds; returns what it borrows.
  fn lin_call_lending_in(k: Nat, &mut c: Lin, value: SurfaceTerm) -> List(Pair(Nat, Yn)) {
    match k -> List(Pair(Nat, Yn)) {
      zero => Nil
      succ(j) => {
        let saved: List(Pair(Nat, Yn)) = c.lent
        set_to(&mut c.lent, Nil)
        lin_lending_call_in(j, &mut c, value)
        let lent: List(Pair(Nat, Yn)) = c.lent
        set_to(&mut c.lent, saved)
        lent
      }
    }
  }

  fn lin_lending_call_in(k: Nat, &mut c: Lin, value: SurfaceTerm) -> () {
    match k -> () {
      zero => ()
      succ(j) => match value.kind -> () {
        SkApp(function, arguments) => lin_app_in(j, &mut c, value, function, arguments, yes)
        _ => lin_drop_in(j, &mut c, value, PosMove)
      }
    }
  }

  // A closure: of the bindings it captures, it copies the duplicable ones,
  // moves the other owned ones, and borrows the other borrowed ones and every
  // `var` whatever its content (`lin_capture_binding`), which makes it a
  // closure that borrows. Its body is checked as a function's. Returns what it
  // borrows, when it does.
  fn lin_closure_in(k: Nat, &mut c: Lin, t: SurfaceTerm) -> Option(Pair(List(Text), Yn)) {
    match k -> Option(Pair(List(Text), Yn)) {
      zero => None()
      succ(j) => match t.kind -> Option(Pair(List(Text), Yn)) {
        SkBorrowLam(borrows, l) => lin_closure_lam_in(j, &mut c, l)
        _ => lin_closure_lam_in(j, &mut c, t)
      }
    }
  }

  fn lin_closure_lam_in(k: Nat, &mut c: Lin, lam: SurfaceTerm) -> Option(Pair(List(Text), Yn)) {
    match k -> Option(Pair(List(Text), Yn)) {
      zero => None()
      succ(j) => match lam.kind -> Option(Pair(List(Text), Yn)) {
        SkLam(params, body) => lin_capture_and_check_in(j, &mut c, free_vars(lam), params, body)
        _ => None()
      }
    }
  }

  fn lin_closure_fn_in(k: Nat, &mut c: Lin, f: SurfaceFn) -> Option(Pair(List(Text), Yn)) {
    match k -> Option(Pair(List(Text), Yn)) {
      zero => None()
      succ(
        j
      ) => lin_capture_and_check_in(
        j,
        &mut c,
        text_without(free_vars(surface_term_mk(SkLam(f.params, f.body), f.start, f.end)), f.name),
        f.params,
        f.body
      )
    }
  }

  fn lin_capture_and_check_in(
    k: Nat,
    &mut c: Lin,
    free: List(Text),
    params: List(Text),
    body: SurfaceTerm
  ) -> Option(Pair(List(Text), Yn)) {
    match k -> Option(Pair(List(Text), Yn)) {
      zero => None()
      succ(j) => {
        let cap: Capture = lin_capture_scan(free, &mut c, body, capture_mk(Nil, no, Nil))
        // The body, as a function's: what it captured is its own.
        let mark: Nat = c.count
        let frame: Frame = frame_mk(
          mark,
          Nil,
          0,
          0,
          lin_frame(c).bounded,
          lin_frame(c).direct_bounded,
          no
        )
        let saved: LinSaved = lin_enter_body(&mut c, frame)
        lin_push_captured(cap.captured, &mut c)
        lin_push_params(params, &mut c, body.start)
        lin_drop_in(j, &mut c, body, PosResult)
        lin_leave_body(&mut c, saved, mark, span_of(body))
        capture_result(cap)
      }
    }
  }

  fn lin_function_in(k: Nat, &mut c: Lin, f: SurfaceFn) -> () {
    match k -> () {
      zero => ()
      succ(j) => {
        let mark: Nat = c.count
        let frame: Frame = frame_mk(
          mark,
          Nil,
          0,
          0,
          lin_bounded(f.generics, f.bounds),
          rows_direct_generics(f.generics, f.bounds),
          fn_returns_borrow(f)
        )
        let saved: LinSaved = lin_enter_body(&mut c, frame)
        lin_push_params(f.params, &mut c, f.body.start)
        lin_drop_in(j, &mut c, f.body, PosResult)
        lin_leave_body(&mut c, saved, mark, span_of(f.body))
      }
    }
  }

  // The statements of a block, in a scope of their own.
  fn lin_block_in(k: Nat, &mut c: Lin, stmts: List(SurfaceStmt), root: Yn) -> () {
    match k -> () {
      zero => ()
      succ(j) => {
        let mark: Nat = c.count
        lin_block_stmts_in(j, &mut c, stmts, root)
        lin_pop_to(&mut c, mark, last_stmt_span(stmts))
      }
    }
  }

  fn lin_block_stmts_in(k: Nat, &mut c: Lin, ss: List(SurfaceStmt), root: Yn) -> () {
    match k -> () {
      zero => ()
      succ(j) => match ss -> () {
        Nil => ()
        Cons(s, rest) => if !c.dead {
          lin_stmt_in(j, &mut c, s, root, rest_is_nil(rest))
          lin_block_stmts_in(j, &mut c, rest, root)
        }
      }
    }
  }

  fn lin_stmt_in(k: Nat, &mut c: Lin, s: SurfaceStmt, root: Yn, last: Yn) -> () {
    match k -> () {
      zero => ()
      succ(j) => match s -> () {
        StLet(name, ty, value, borrow, bm) => if borrow {
          let lent: List(Pair(Nat, Yn)) = lin_call_lending_in(j, &mut c, value)
          lin_let_borrows(&mut c, name, value, lent)
        } else {
          let borrows: Option(Pair(List(Text), Yn)) = lin_value_in(j, &mut c, value, PosLet)
          lin_let_value(&mut c, name, value, borrows)
        }
        StVar(name, ty, value, vb) => {
          lin_drop_in(j, &mut c, value, PosMove)
          lin_push_unit(&mut c, name, value.start, yes)
        }
        StAssign(name, value) => {
          lin_drop_in(j, &mut c, value, PosMove)
          lin_assign(&mut c, name, value)
        }
        StFn(f) => if !root {
          let borrows: Option(Pair(List(Text), Yn)) = lin_closure_fn_in(j, &mut c, f)
          lin_fn_borrows(&mut c, f, borrows)
        }
        StWhile(condition, body) => {
          lin_event(&mut c, rowset_one("Div"), span_of(condition))
          lin_frame_loops_add(&mut c)
          lin_drop_in(j, &mut c, condition, PosDrop)
          let before: Option(List(LinState)) = lin_snapshot(c)
          lin_drop_in(j, &mut c, body, PosDrop)
          lin_frame_loops_sub(&mut c)
          let after: Option(List(LinState)) = lin_snapshot(c)
          lin_merge(&mut c, Cons(before, Cons(after, Nil)), span_of(condition))
        }
        StReturn(e) => {
          lin_opt_drop_in(j, &mut c, e, PosResult)
          lin_leave_function(&mut c, opt_span(e))
        }
        StExpr(e) => lin_drop_in(j, &mut c, e, pos_last(last))
        _ => ()
      }
    }
  }

  fn lin_match_expr_in(
    k: Nat,
    &mut c: Lin,
    t: SurfaceTerm,
    scrutinee: SurfaceTerm,
    arms: List(SurfaceArm),
    pos: LinPos
  ) -> () {
    match k -> () {
      zero => ()
      succ(j) => {
        let lent: List(Pair(Nat, Yn)) = lin_scrutinee_in(j, &mut c, scrutinee)
        let start: Option(List(LinState)) = lin_snapshot(c)
        let ty: Option(Ty) = lin_term_type(c, scrutinee)
        let paths: List(
          Option(List(LinState))
        ) = lin_match_arms_in(j, &mut c, arms, start, ty, pos, lent)
        lin_merge(&mut c, paths, span_of(t))
      }
    }
  }

  // `match &v`, or a borrowed name: the arms' names borrow.
  fn lin_scrutinee_in(k: Nat, &mut c: Lin, scrutinee: SurfaceTerm) -> List(Pair(Nat, Yn)) {
    match k -> List(Pair(Nat, Yn)) {
      zero => Nil
      succ(j) => match lin_borrowed_place(c, scrutinee) -> List(Pair(Nat, Yn)) {
        Some(i) => {
          lin_read(&mut c, i, span_of(scrutinee))
          Nil
        }
        None => match scrutinee.kind -> List(Pair(Nat, Yn)) {
          SkBorrow(m, term) => {
            match lin_place_found(c, term) -> () {
              Some(i) => lin_read(&mut c, i, span_of(scrutinee))
              None => lin_drop_in(j, &mut c, term, PosDrop)
            }
            Nil
          }
          SkApp(f, args) => if lin_is_view_call(c, scrutinee) {
            lin_call_lending_in(j, &mut c, scrutinee)
          } else {
            lin_drop_in(j, &mut c, scrutinee, PosMove)
            Nil
          }
          _ => {
            lin_drop_in(j, &mut c, scrutinee, PosMove)
            Nil
          }
        }
      }
    }
  }

  fn lin_match_arms_in(
    k: Nat,
    &mut c: Lin,
    arms: List(SurfaceArm),
    start: Option(List(LinState)),
    ty: Option(Ty),
    pos: LinPos,
    lent: List(Pair(Nat, Yn))
  ) -> List(Option(List(LinState))) {
    match k -> List(Option(List(LinState))) {
      zero => Nil
      succ(j) => match arms -> List(Option(List(LinState))) {
        Nil => Nil
        Cons(arm, rest) => {
          lin_restore(&mut c, start)
          let mark: Nat = c.count
          lin_dropped(&mut c, arm.pattern, ty, span_of(arm.body))
          lin_push_arm_names(pattern_names_ordered(arm.pattern), &mut c, arm.body.start, lent)
          lin_opt_drop_in(j, &mut c, arm.guard, PosDrop)
          lin_drop_in(j, &mut c, arm.body, pos)
          lin_pop_to(&mut c, mark, span_of(arm.body))
          let snap: Option(List(LinState)) = lin_snapshot(c)
          let tl: List(
            Option(List(LinState))
          ) = lin_match_arms_in(j, &mut c, rest, start, ty, pos, lent)
          Cons(snap, tl)
        }
      }
    }
  }

  fn lin_handle_in(
    k: Nat,
    &mut c: Lin,
    body: SurfaceTerm,
    handlers: List(SurfaceHandler),
    pos: LinPos
  ) -> () {
    match k -> () {
      zero => ()
      succ(j) => {
        let start: Nat = c.count
        // The bindings from outside that the body uses (not only borrows) live
        // across it too: a continuation captures the rest of the body, uses of
        // them included.
        let body_uses: List(Nat) = indexes_below(lin_find_each(used_vars(body), c, Nil), start)
        let scan: HandleScan = lin_handle_scan(
          handlers,
          c,
          handle_scan_mk(ordmap_empty(), body_uses)
        )
        // A continuation runs the rest of the body and then the `return` arm:
        // a borrow from outside that either takes, or a `var` in them, pins
        // the continuations (`lin_pin`).
        lin_pin(&mut c, body, handlers)
        let before: Option(List(LinState)) = lin_snapshot(c)
        let handles: List(
          HandleCtx
        ) = Cons(handle_ctx_mk(start, scan.answers, scan.return_uses), lin_frame(c).handles)
        lin_frame_handles(&mut c, handles)
        // A direct arm borrows what it uses from outside, for as long as the
        // handle runs.
        let outer_len: Nat = c.count
        lin_lend_to_direct_arms(handlers, &mut c)
        lin_drop_in(j, &mut c, body, PosMove)
        lin_pop_to(&mut c, outer_len, span_of(body))
        let outer: List(HandleCtx) = list_tail(lin_frame(c).handles)
        lin_frame_handles(&mut c, outer)
        // The `return` arm runs after the body, outside the handle.
        lin_return_arms_in(j, &mut c, handlers, pos)
        let after: Option(List(LinState)) = lin_snapshot(c)
        // The operation arms run outside the handle, any number of times: they
        // may capture only duplicable bindings.
        lin_operation_arms_in(j, &mut c, handlers, before, start, pos)
        lin_restore(&mut c, after)
      }
    }
  }

  fn lin_return_arms_in(k: Nat, &mut c: Lin, hs: List(SurfaceHandler), pos: LinPos) -> () {
    match k -> () {
      zero => ()
      succ(j) => match hs -> () {
        Nil => ()
        Cons(h, rest) => {
          lin_return_arm_in(j, &mut c, h, pos)
          lin_return_arms_in(j, &mut c, rest, pos)
        }
      }
    }
  }

  fn lin_return_arm_in(k: Nat, &mut c: Lin, h: SurfaceHandler, pos: LinPos) -> () {
    match k -> () {
      zero => ()
      succ(j) => match h -> () {
        HdReturn(pattern, body) => {
          let mark: Nat = c.count
          lin_push_names(pattern_names_ordered(pattern), &mut c, body.start)
          lin_drop_in(j, &mut c, body, pos)
          lin_pop_to(&mut c, mark, span_of(body))
        }
        HdOperation(eff, patterns, cont, guard, body) => ()
      }
    }
  }

  fn lin_operation_arms_in(
    k: Nat,
    &mut c: Lin,
    hs: List(SurfaceHandler),
    before: Option(List(LinState)),
    start: Nat,
    pos: LinPos
  ) -> () {
    match k -> () {
      zero => ()
      succ(j) => match hs -> () {
        Nil => ()
        Cons(h, rest) => {
          lin_operation_arm_in(j, &mut c, h, before, start, pos)
          lin_operation_arms_in(j, &mut c, rest, before, start, pos)
        }
      }
    }
  }

  fn lin_operation_arm_in(
    k: Nat,
    &mut c: Lin,
    h: SurfaceHandler,
    before: Option(List(LinState)),
    start: Nat,
    pos: LinPos
  ) -> () {
    match k -> () {
      zero => ()
      succ(j) => match h -> () {
        HdReturn(pattern, body) => ()
        HdOperation(eff, patterns, cont, guard, body) => {
          lin_restore(&mut c, before)
          let outer_floor: Option(Nat) = c.arm_floor
          lin_enter_arm(&mut c, eff, start)
          let mark: Nat = c.count
          lin_push_names(
            list_append(patterns_names_ordered(patterns), cont_names(cont)),
            &mut c,
            body.start
          )
          lin_opt_drop_in(j, &mut c, guard, PosDrop)
          lin_drop_in(j, &mut c, body, pos)
          lin_pop_to(&mut c, mark, span_of(body))
          set_to(&mut c.arm_floor, outer_floor)
          set_to(&mut c.arm_direct, None())
        }
      }
    }
  }

  fn lin_check_fns_in(k: Nat, &mut c: Lin, ss: List(SurfaceStmt)) -> () {
    match k -> () {
      zero => ()
      succ(j) => match ss -> () {
        Nil => ()
        Cons(s, rest) => {
          lin_check_fn_in(j, &mut c, s)
          lin_check_fns_in(j, &mut c, rest)
        }
      }
    }
  }

  fn lin_check_fn_in(k: Nat, &mut c: Lin, s: SurfaceStmt) -> () {
    match k -> () {
      zero => ()
      succ(j) => match s -> () {
        StFn(f) => lin_function_in(j, &mut c, f)
        _ => ()
      }
    }
  }
}

// ----- the check -----

fn lin_check_all(&mut c: Lin, program: List(SurfaceStmt)) -> List(LinError) {
  lin_check_fns_in(c.steps, &mut c, program)
  lin_push_frame(&mut c, frame_default())
  lin_block_in(c.steps, &mut c, program, yes)
  lin_pop_frame(&mut c)
  list_reverse(c.errors)
}

// The use check of a program whose types check.
fn lin_check(types: TypeReport, rows: RowReport, program: List(SurfaceStmt)) -> List(LinError) {
  var c: Lin = lin_new(types, rows, 16 * (program_extent(program) + 1))
  lin_check_all(&mut c, program)
}

// The dump of the use check, or nothing when the program has type errors.
fn lin_run(
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  module_errors: List(TypeError)
) -> Option(Text) {
  let types: TypeReport = types_check(prelude, program, module_errors)
  match types.errors -> Option(Text) {
    Cons(e, rest) => None()
    Nil => Some(
      text_concat_all(lin_dump_errors(lin_check(types, rows_check(prelude, program), program)))
    )
  }
}
