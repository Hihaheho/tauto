pub theorem inference_unf_ck_record_fields_in(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  declared: List(DataField),
  env: List(Local),
  seen: List(Text)
): ck_record_fields_in(Succ(j), c, name, fields, declared, env, seen) = inference_step_ck_record_fields_in(j, c, name, fields, declared, env, seen) { match fields: ck_record_fields_in(Succ(j), c, name, fields, declared, env, seen) = inference_step_ck_record_fields_in(j, c, name, fields, declared, env, seen) {
    Nil => Refl
    Cons(f, rest) => Refl
  } }

pub fn inference_handle_arms(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  hs: List(SurfaceHandler)
): Mut1(Unit, Checker) {
  match hs: Mut1(Unit, Checker) {
    Nil => mut1(Star, c)
    Cons(h, rest) => frame_bind(
      Unit,
      Unit,
      (ignored: Unit, c1: Checker) => ck_rewrap1(
        ck_handle_arms_in(j, c1, rest, env, result, rv, budget_ty)
      ),
      ck_handle_one_in(j, c, h, env, result, rv, budget_ty)
    )
  }
}

pub theorem inference_handle_arms_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  hs: List(SurfaceHandler),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_handle_arms(j, c, env, result, rv, budget_ty, hs)) {
  match hs: CkRunFrame(c, inference_handle_arms(j, c, env, result, rv, budget_ty, hs)) {
    Nil => run_frame_return(c, Star, ordered)
    Cons(h, rest) => run_frame_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(
        ck_handle_arms_in(j, c1, rest, env, result, rv, budget_ty)
      ),
      ck_handle_one_in(j, c, h, env, result, rv, budget_ty),
      inference_use_ck_handle_one_in(j, c, h, env, result, rv, budget_ty, ordered, ih),
      ignored => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_handle_arms_in(j, c1, rest, env, result, rv, budget_ty),
        inference_use_ck_handle_arms_in(j, c1, rest, env, result, rv, budget_ty, o_c1, ih)
      )
    )
  }
}

pub fn inference_step_ck_handle_arms_in(
  j: Nat,
  c: Checker,
  hs: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty
): Mut1(Unit, Checker) { inference_handle_arms(j, c, env, result, rv, budget_ty, hs) }

pub theorem inference_step_ck_handle_arms_in_frame(
  j: Nat,
  c: Checker,
  hs: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
  inference_step_ck_handle_arms_in(j, c, hs, env, result, rv, budget_ty)
) { inference_handle_arms_frame(j, c, env, result, rv, budget_ty, hs, ih, ordered) }

pub theorem inference_unf_ck_handle_arms_in(
  j: Nat,
  c: Checker,
  hs: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty
): ck_handle_arms_in(Succ(j), c, hs, env, result, rv, budget_ty) = inference_step_ck_handle_arms_in(j, c, hs, env, result, rv, budget_ty) { match hs: ck_handle_arms_in(Succ(j), c, hs, env, result, rv, budget_ty) = inference_step_ck_handle_arms_in(j, c, hs, env, result, rv, budget_ty) {
    Nil => Refl
    Cons(h, rest) => Refl
  } }

pub fn inference_handle_one(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  h: SurfaceHandler
): Mut1(Unit, Checker) {
  match h: Mut1(Unit, Checker) {
    HdReturn(p, b) => mut1(Star, c)
    HdOperation(eff, binds, types, patterns, cont, guard, body) => ck_rewrap1(
      ck_handle_arm_in(
        j,
        c,
        env,
        result,
        rv,
        budget_ty,
        eff,
        binds,
        types,
        patterns,
        cont,
        guard,
        body
      )
    )
  }
}

pub theorem inference_handle_one_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  h: SurfaceHandler,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_handle_one(j, c, env, result, rv, budget_ty, h)) {
  match h: CkRunFrame(c, inference_handle_one(j, c, env, result, rv, budget_ty, h)) {
    HdReturn(p, b) => run_frame_return(c, Star, ordered)
    HdOperation(eff, binds, types, patterns, cont, guard, body) => run_frame_rewrap(
      c,
      ck_handle_arm_in(
        j,
        c,
        env,
        result,
        rv,
        budget_ty,
        eff,
        binds,
        types,
        patterns,
        cont,
        guard,
        body
      ),
      inference_use_ck_handle_arm_in(
        j,
        c,
        env,
        result,
        rv,
        budget_ty,
        eff,
        binds,
        types,
        patterns,
        cont,
        guard,
        body,
        ordered,
        ih
      )
    )
  }
}

pub fn inference_step_ck_handle_one_in(
  j: Nat,
  c: Checker,
  h: SurfaceHandler,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty
): Mut1(Unit, Checker) { inference_handle_one(j, c, env, result, rv, budget_ty, h) }

pub theorem inference_step_ck_handle_one_in_frame(
  j: Nat,
  c: Checker,
  h: SurfaceHandler,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
  inference_step_ck_handle_one_in(j, c, h, env, result, rv, budget_ty)
) { inference_handle_one_frame(j, c, env, result, rv, budget_ty, h, ih, ordered) }

pub theorem inference_unf_ck_handle_one_in(
  j: Nat,
  c: Checker,
  h: SurfaceHandler,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty
): ck_handle_one_in(Succ(j), c, h, env, result, rv, budget_ty) = inference_step_ck_handle_one_in(j, c, h, env, result, rv, budget_ty) { match h: ck_handle_one_in(Succ(j), c, h, env, result, rv, budget_ty) = inference_step_ck_handle_one_in(j, c, h, env, result, rv, budget_ty) {
    HdReturn(p, b) => Refl
    HdOperation(eff, binds, types, patterns, cont, guard, body) => Refl
  } }

pub fn inference_handle_result(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  first: Ty,
  budget_ty: Ty,
  variable: Option(Nat)
): Mut1(Unit, Checker) {
  match variable: Mut1(Unit, Checker) {
    None => mut1(Star, c)
    Some(rv) => frame_bind(
      Unit,
      Unit,
      (ignored: Unit, c1: Checker) => frame_bind(
        Unit,
        Unit,
        (gathered: Unit, c2: Checker) => ck_rewrap1(
          ck_handle_arms_in(j, c2, handlers, env, ck_resolve(c2, result), None, budget_ty)
        ),
        ck_handle_arms_in(j, c1, handlers, env, result, Some(rv), budget_ty)
      ),
      ck_set_subst(c, rv, first)
    )
  }
}

pub theorem inference_handle_result_frame(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  first: Ty,
  budget_ty: Ty,
  variable: Option(Nat),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_handle_result(j, c, handlers, env, result, first, budget_ty, variable)) {
  match variable: CkRunFrame(
    c,
    inference_handle_result(j, c, handlers, env, result, first, budget_ty, variable)
  ) {
    None => run_frame_return(c, Star, ordered)
    Some(rv) => run_frame_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        Unit,
        Unit,
        (gathered: Unit, c2: Checker) => ck_rewrap1(
          ck_handle_arms_in(j, c2, handlers, env, ck_resolve(c2, result), None, budget_ty)
        ),
        ck_handle_arms_in(j, c1, handlers, env, result, Some(rv), budget_ty)
      ),
      ck_set_subst(c, rv, first),
      ck_set_subst_run_frame(c, rv, first, ordered),
      ignored => c1 => o_c1 => run_frame_bind(
        Unit,
        Unit,
        c1,
        (gathered: Unit, c2: Checker) => ck_rewrap1(
          ck_handle_arms_in(j, c2, handlers, env, ck_resolve(c2, result), None, budget_ty)
        ),
        ck_handle_arms_in(j, c1, handlers, env, result, Some(rv), budget_ty),
        inference_use_ck_handle_arms_in(
          j,
          c1,
          handlers,
          env,
          result,
          Some(rv),
          budget_ty,
          o_c1,
          ih
        ),
        gathered => c2 => o_c2 => run_frame_rewrap(
          c2,
          ck_handle_arms_in(j, c2, handlers, env, ck_resolve(c2, result), None, budget_ty),
          inference_use_ck_handle_arms_in(
            j,
            c2,
            handlers,
            env,
            ck_resolve(c2, result),
            None,
            budget_ty,
            o_c2,
            ih
          )
        )
      )
    )
  }
}

pub fn inference_step_ck_handle_result_in(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  first: Ty,
  budget_ty: Ty
): Mut1(
  Unit,
  Checker
) { inference_handle_result(j, c, handlers, env, result, first, budget_ty, ty_var_of(result)) }

pub theorem inference_step_ck_handle_result_in_frame(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  first: Ty,
  budget_ty: Ty,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_step_ck_handle_result_in(j, c, handlers, env, result, first, budget_ty)) {
  inference_handle_result_frame(
    j,
    c,
    handlers,
    env,
    result,
    first,
    budget_ty,
    ty_var_of(result),
    ih,
    ordered
  )
}

pub theorem inference_unf_ck_handle_result_in(
  j: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  env: List(Local),
  result: Ty,
  first: Ty,
  budget_ty: Ty
): ck_handle_result_in(Succ(j), c, handlers, env, result, first, budget_ty) = inference_step_ck_handle_result_in(j, c, handlers, env, result, first, budget_ty) { Refl }
