): ck_operands_in(Succ(j), c, arguments, env) = inference_step_ck_operands_in(j, c, arguments, env) { match arguments: ck_operands_in(Succ(j), c, arguments, env) = inference_step_ck_operands_in(j, c, arguments, env) {
