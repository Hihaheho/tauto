    None => Refl
    Some(x) => Refl
  } }

pub fn inference_tail_ck_infer_each_in(
  j: Nat,
  c: Checker,
  env: List(Local),
  first: Ty,
  rest: List(SurfaceTerm)
): Mut1(List(Ty), Checker) {
  frame_bind(
    List(Ty),
    List(Ty),
    (tl: List(Ty), c1: Checker) => mut1(Cons(first, tl), c1),
    ck_infer_each_in(j, c, rest, env)
  )
}

pub theorem inference_tail_ck_infer_each_in_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  first: Ty,
  rest: List(SurfaceTerm),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_tail_ck_infer_each_in(j, c, env, first, rest)) {
  run_frame_bind(
    List(Ty),
    List(Ty),
    c,
    (tl: List(Ty), c1: Checker) => mut1(Cons(first, tl), c1),
    ck_infer_each_in(j, c, rest, env),
    inference_use_ck_infer_each_in(j, c, rest, env, ordered, ih),
    tl => c1 => o_c1 => run_frame_return(c1, Cons(first, tl), o_c1)
  )
}

pub fn inference_list_ck_infer_each_in(
  j: Nat,
  c: Checker,
  env: List(Local),
  ts: List(SurfaceTerm)
): Mut1(List(Ty), Checker) {
  match ts: Mut1(List(Ty), Checker) {
    Nil => mut1(Nil, c)
    Cons(t, rest) => frame_bind(
      Ty,
      List(Ty),
      (h: Ty, c1: Checker) => inference_tail_ck_infer_each_in(j, c1, env, h, rest),
      ck_infer_in(j, c, t, env)
    )
  }
}

pub theorem inference_list_ck_infer_each_in_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  ts: List(SurfaceTerm),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_list_ck_infer_each_in(j, c, env, ts)) {
  match ts: CkRunFrame(c, inference_list_ck_infer_each_in(j, c, env, ts)) {
    Nil => run_frame_return(c, Nil, ordered)
    Cons(t, rest) => run_frame_bind(
      Ty,
      List(Ty),
      c,
      (h: Ty, c1: Checker) => inference_tail_ck_infer_each_in(j, c1, env, h, rest),
      ck_infer_in(j, c, t, env),
      inference_use_ck_infer_in(j, c, t, env, ordered, ih),
      h => c1 => o_c1 => inference_tail_ck_infer_each_in_frame(j, c1, env, h, rest, ih, o_c1)
    )
  }
}

