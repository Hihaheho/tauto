pub fn inference_list_ck_operands_in(
  j: Nat,
  c: Checker,
  env: List(Local),
  arguments: List(SurfaceTerm)
): Mut1(List(Ty), Checker) {
  match arguments: Mut1(List(Ty), Checker) {
    Nil => mut1(Nil, c)
    Cons(a, rest) => frame_bind(
      Ty,
      List(Ty),
      (h: Ty, c1: Checker) => inference_tail_ck_operands_in(
        j,
        c1,
        env,
        ty_operand(ck_resolve(c1, h)),
        rest
      ),
      ck_infer_in(j, c, a, env)
    )
  }
}

pub theorem inference_list_ck_operands_in_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  arguments: List(SurfaceTerm),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_list_ck_operands_in(j, c, env, arguments)) {
  match arguments: CkRunFrame(c, inference_list_ck_operands_in(j, c, env, arguments)) {
    Nil => run_frame_return(c, Nil, ordered)
    Cons(a, rest) => run_frame_bind(
      Ty,
      List(Ty),
      c,
      (h: Ty, c1: Checker) => inference_tail_ck_operands_in(
        j,
        c1,
        env,
        ty_operand(ck_resolve(c1, h)),
        rest
      ),
      ck_infer_in(j, c, a, env),
      inference_use_ck_infer_in(j, c, a, env, ordered, ih),
      h => c1 => o_c1 => inference_tail_ck_operands_in_frame(
        j,
        c1,
        env,
        ty_operand(ck_resolve(c1, h)),
        rest,
        ih,
        o_c1
      )
    )
  }
}

