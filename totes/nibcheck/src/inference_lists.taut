pub theorem inference_unf_ck_guard_in(
  j: Nat,
  c: Checker,
  guard: Option(SurfaceTerm),
  env: List(Local)
): ck_guard_in(Succ(j), c, guard, env) = inference_step_ck_guard_in(j, c, guard, env) { match guard: ck_guard_in(Succ(j), c, guard, env) = inference_step_ck_guard_in(j, c, guard, env) {
    None => Refl
    Some(g) => Refl
  } }

pub fn inference_returned(
  j: Nat,
  c: Checker,
  env: List(Local),
  e: Option(SurfaceTerm)
): Mut1(Pair(Ty, TySpan), Checker) {
  match e: Mut1(Pair(Ty, TySpan), Checker) {
    None => mut1(Pair { fst: TyUnit, snd: TySpan { start: 0, end: 0 } }, c)
    Some(x) => frame_bind(
      Ty,
      Pair(Ty, TySpan),
      (t: Ty, c1: Checker) => mut1(Pair { fst: t, snd: span_of(x) }, c1),
      ck_infer_in(j, c, x, env)
    )
  }
}

pub theorem inference_returned_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  e: Option(SurfaceTerm),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_returned(j, c, env, e)) {
  match e: CkRunFrame(c, inference_returned(j, c, env, e)) {
    None => run_frame_return(c, Pair { fst: TyUnit, snd: TySpan { start: 0, end: 0 } }, ordered)
    Some(x) => run_frame_bind(
      Ty,
      Pair(Ty, TySpan),
      c,
      (t: Ty, c1: Checker) => mut1(Pair { fst: t, snd: span_of(x) }, c1),
      ck_infer_in(j, c, x, env),
      inference_use_ck_infer_in(j, c, x, env, ordered, ih),
      t => c1 => o_c1 => run_frame_return(c1, Pair { fst: t, snd: span_of(x) }, o_c1)
    )
  }
}

pub fn inference_step_ck_returned_in(
  j: Nat,
  c: Checker,
  e: Option(SurfaceTerm),
  env: List(Local)
): Mut1(Pair(Ty, TySpan), Checker) { inference_returned(j, c, env, e) }

