pub fn inference_record_fields(
  j: Nat,
  c: Checker,
  name: Text,
  declared: List(DataField),
  env: List(Local),
  seen: List(Text),
  fields: List(SurfaceField)
): Mut1(List(Text), Checker) {
  match fields: Mut1(List(Text), Checker) {
    Nil => mut1(seen, c)
    Cons(f, rest) => frame_bind(
      Ty,
      List(Text),
      (v: Ty, c1: Checker) => frame_bind(
        Bool,
        List(Text),
        (again: Bool, c2: Checker) => ck_rewrap1(
          ck_record_fields_in(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f))
          )
        ),
        ck_record_field_check(c1, name, f, v, declared, seen)
      ),
      ck_infer_in(j, c, record_field_value(f), env)
    )
  }
}

pub theorem inference_record_fields_frame(
  j: Nat,
  c: Checker,
  name: Text,
  declared: List(DataField),
  env: List(Local),
  seen: List(Text),
  fields: List(SurfaceField),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_record_fields(j, c, name, declared, env, seen, fields)) {
  match fields: CkRunFrame(c, inference_record_fields(j, c, name, declared, env, seen, fields)) {
    Nil => run_frame_return(c, seen, ordered)
    Cons(f, rest) => run_frame_bind(
      Ty,
      List(Text),
      c,
      (v: Ty, c1: Checker) => frame_bind(
        Bool,
        List(Text),
        (again: Bool, c2: Checker) => ck_rewrap1(
          ck_record_fields_in(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f))
          )
        ),
        ck_record_field_check(c1, name, f, v, declared, seen)
      ),
      ck_infer_in(j, c, record_field_value(f), env),
      inference_use_ck_infer_in(j, c, record_field_value(f), env, ordered, ih),
      v => c1 => o_c1 => run_frame_bind(
        Bool,
        List(Text),
        c1,
        (again: Bool, c2: Checker) => ck_rewrap1(
          ck_record_fields_in(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f))
          )
        ),
        ck_record_field_check(c1, name, f, v, declared, seen),
        ck_record_field_check_run_frame(c1, name, f, v, declared, seen, o_c1),
        again => c2 => o_c2 => run_frame_rewrap(
          c2,
          ck_record_fields_in(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f))
          ),
          inference_use_ck_record_fields_in(
            j,
            c2,
            name,
            rest,
            declared,
            env,
            seen_with(again, seen, record_field_name(f)),
            o_c2,
            ih
          )
        )
      )
    )
  }
}

pub fn inference_step_ck_record_fields_in(
  j: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  declared: List(DataField),
  env: List(Local),
  seen: List(Text)
