  c,
  inference_step_ck_else_in(j, c, t, el, env)
) { inference_else_frame(j, c, t, env, el, ih, ordered) }

pub theorem inference_unf_ck_else_in(
  j: Nat,
  c: Checker,
  t: Ty,
  el: Option(SurfaceTerm),
  env: List(Local)
): ck_else_in(Succ(j), c, t, el, env) = inference_step_ck_else_in(j, c, t, el, env) { match el: ck_else_in(Succ(j), c, t, el, env) = inference_step_ck_else_in(j, c, t, el, env) {
    None => Refl
    Some(o) => Refl
  } }

pub fn inference_guard(
  j: Nat,
  c: Checker,
  env: List(Local),
  guard: Option(SurfaceTerm)
): Mut1(Unit, Checker) {
  match guard: Mut1(Unit, Checker) {
    None => mut1(Star, c)
    Some(g) => frame_bind(
      Ty,
      Unit,
      (gt: Ty, c1: Checker) => ck_rewrap1(ck_expect(c1, gt, TyBool, span_of(g), "a guard")),
      ck_infer_in(j, c, g, env)
    )
  }
}

pub theorem inference_guard_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  guard: Option(SurfaceTerm),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_guard(j, c, env, guard)) {
  match guard: CkRunFrame(c, inference_guard(j, c, env, guard)) {
    None => run_frame_return(c, Star, ordered)
    Some(g) => run_frame_bind(
      Ty,
      Unit,
      c,
      (gt: Ty, c1: Checker) => ck_rewrap1(ck_expect(c1, gt, TyBool, span_of(g), "a guard")),
      ck_infer_in(j, c, g, env),
      inference_use_ck_infer_in(j, c, g, env, ordered, ih),
      gt => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_expect(c1, gt, TyBool, span_of(g), "a guard"),
        ck_expect_run_frame(c1, gt, TyBool, span_of(g), "a guard", o_c1)
      )
    )
  }
}

pub fn inference_step_ck_guard_in(
  j: Nat,
  c: Checker,
  guard: Option(SurfaceTerm),
  env: List(Local)
): Mut1(Unit, Checker) { inference_guard(j, c, env, guard) }

