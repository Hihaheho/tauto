pub fn inference_step_ck_infer_in(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local)
): Mut1(Ty, Checker) {
  frame_bind(
    Ty,
    Ty,
    (t: Ty, c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      access_record_term(c1, term, t)
    ),
    ck_infer_term_in(j, c, term, env)
  )
}

pub theorem inference_step_ck_infer_in_frame(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_step_ck_infer_in(j, c, term, env)) {
  run_frame_bind(
    Ty,
    Ty,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      access_record_term(c1, term, t)
    ),
    ck_infer_term_in(j, c, term, env),
    inference_use_ck_infer_term_in(j, c, term, env, ordered, ih),
    t => c1 => o_c1 => run_frame_bind(
      Unit,
      Ty,
      c1,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      access_record_term(c1, term, t),
      run_frame_read(
        c1,
        access_record_term(c1, term, t),
        access_record_term_frame(c1, term, t),
        o_c1
      ),
      ignored => c2 => o_c2 => run_frame_return(c2, t, o_c2)
    )
  )
}

pub theorem inference_unf_ck_infer_in(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local)
): ck_infer_in(Succ(j), c, term, env) = inference_step_ck_infer_in(j, c, term, env) { Refl }

pub fn inference_else(
  j: Nat,
  c: Checker,
  t: Ty,
  env: List(Local),
  el: Option(SurfaceTerm)
): Mut1(Ty, Checker) {
  match el: Mut1(Ty, Checker) {
    None => mut1(TyUnit, c)
    Some(o) => frame_bind(
      Ty,
      Ty,
      (ot: Ty, c1: Checker) => ck_rewrap1(ck_join(c1, t, ot)),
      ck_infer_in(j, c, o, env)
    )
  }
}

pub theorem inference_else_frame(
  j: Nat,
  c: Checker,
  t: Ty,
  env: List(Local),
  el: Option(SurfaceTerm),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_else(j, c, t, env, el)) {
  match el: CkRunFrame(c, inference_else(j, c, t, env, el)) {
    None => run_frame_return(c, TyUnit, ordered)
    Some(o) => run_frame_bind(
      Ty,
      Ty,
      c,
      (ot: Ty, c1: Checker) => ck_rewrap1(ck_join(c1, t, ot)),
      ck_infer_in(j, c, o, env),
      inference_use_ck_infer_in(j, c, o, env, ordered, ih),
      ot => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_join(c1, t, ot),
        ck_join_run_frame(c1, t, ot, o_c1)
      )
    )
  }
}

pub fn inference_step_ck_else_in(
  j: Nat,
  c: Checker,
  t: Ty,
  el: Option(SurfaceTerm),
  env: List(Local)
): Mut1(Ty, Checker) { inference_else(j, c, t, env, el) }

pub theorem inference_step_ck_else_in_frame(
  j: Nat,
  c: Checker,
