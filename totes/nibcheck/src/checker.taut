import std::List
import "datas.taut"
import std::Map
import std::Text
import "rows.taut"
import "ty.taut"
import "../../surface/src/surface.taut"

// The checker of `types.rs`: its state, fresh variables, unification, what
// fits where, and the join of two types, in the proof language
// (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」). Resolving, unifying and `fits` follow the
// substitution, so they take a number of steps, the checker's `steps`.

pub(open) inductive TySpan: Type {
  TySpanMk(start: Nat, end: Nat): TySpan
}

pub(open) inductive TypeError: Type {
  TypeErrorMk(message: Text, start: Nat, end: Nat): TypeError
}

// A function's type with its type parameters and their bounds, instantiated
// at each use, and its `where` constraints: the class and the generic it
// constrains. The generics that are type constructors are in `ctors` too, with
// the kind each takes; the kind in `generics` is the one it makes.
pub(open) inductive Scheme: Type {
  SchemeMk(
    generics: List(Pair(Text, Kind)),
    ty: Ty,
    preds: List(Pair(Text, Text)),
    ctors: List(Pair(Text, Kind))
  ): Scheme
}

// A constraint to check once the types are known: `ty` has the `class` the
// use of `what` asks for, given what the enclosing function assumes.
pub(open) inductive TyPending: Type {
  TyPendingMk(
    r#class: Text,
    ty: Ty,
    what: Text,
    assume: List(Pair(Text, Text)),
    start: Nat,
    end: Nat
  ): TyPending
}

// A constructor whose owner is determined after the surrounding types are known.
pub(open) inductive TyConstructorUse: Type {
  TyConstructorUseMk(name: Text, ty: Ty, start: Nat, end: Nat): TyConstructorUse
}

pub(open) inductive EffectSig: Type {
  EffectSigMk(generics: List(Text), params: List(Ty), result: Ty): EffectSig
}

// `view`: a `var &x`, advanced through `&mut x`, never assigned.
pub(open) inductive Local: Type {
  LocalMk(name: Text, ty: Ty, mutable: Bool, r#view: Bool): Local
}

pub(open) inductive LocalKey: Type {
  LocalKeyMk(name: Text, site: Nat): LocalKey
}

pub(open) inductive TyOp: Type {
  TyOpMk(start: Nat, end: Nat, occurrence: Option(TermOccurrence), ty: Ty): TyOp
}

// Where a term's type or an operator's width was observed: its span, and the
// node itself. Two nodes may share a span; one node checked again keeps its
// occurrence.
pub(open) inductive TermAt: Type {
  TermAtMk(start: Nat, end: Nat, occurrence: Option(TermOccurrence)): TermAt
}

pub fn term_at_of(t: SurfaceTerm): TermAt {
  TermAt { start: t.start, end: t.end, occurrence: t.occurrence }
}

pub fn term_at_compare_path(a: List(Nat), b: List(Nat)): Ordering {
  ⊢ Ordering from match a {
    Nil => ⊢ Ordering from match b {
      Nil => Equal
      Cons(y, ys) => Less
    }
    Cons(x, xs) => ⊢ Ordering from match b {
      Nil => Greater
      Cons(y, ys) => ⊢ Ordering from match Ordmap::compare_nat(x, y) {
        Equal => term_at_compare_path(xs, ys)
        Less => Less
        Greater => Greater
      }
    }
  }
}

pub fn term_at_compare_occurrence(a: Option(TermOccurrence), b: Option(TermOccurrence)): Ordering {
  ⊢ Ordering from match a {
    None => ⊢ Ordering from match b {
      None => Equal
      Some(y) => Less
    }
    Some(x) => ⊢ Ordering from match b {
      None => Greater
      Some(y) => ⊢ Ordering from match x {
        TermOccurrenceMk(xp) => ⊢ Ordering from match y {
          TermOccurrenceMk(yp) => term_at_compare_path(xp, yp)
        }
      }
    }
  }
}

// By span first, so that the report reads in source order.
pub fn term_at_compare(a: TermAt, b: TermAt): Ordering {
  ⊢ Ordering from match Ordmap::compare_nat(a.start, b.start) {
    Equal => ⊢ Ordering from match Ordmap::compare_nat(a.end, b.end) {
      Equal => term_at_compare_occurrence(a.occurrence, b.occurrence)
      Less => Less
      Greater => Greater
    }
    Less => Less
    Greater => Greater
  }
}

// An integer literal, `-magnitude` when `negative` (never `-0`).
pub(open) inductive TyLiteral: Type {
  TyLiteralMk(start: Nat, end: Nat, negative: Bool, magnitude: Nat, ty: Ty): TyLiteral
}

pub(open) inductive TyLet: Type {
  TyLetMk(name: Text, ty: Ty): TyLet
}

pub(open) inductive TyBound: Type {
  TyBoundMk(ty: Ty, kind: Kind, start: Nat, end: Nat): TyBound
}

// A type constructor variable at a use: what it takes and makes, and the
// function it was for.
pub(open) inductive TyCtorBound: Type {
  TyCtorBoundMk(ty: Ty, arg: Kind, result: Kind, what: Text, start: Nat, end: Nat): TyCtorBound
}

// Two types made the same, or one fitted to the other, with the generics
// `gs` read as `rigid`: the rigid types are checked again to be in neither at
// the end (`ck_rigid_kept`).
pub(open) inductive TyKept: Type {
  TyKeptMk(
    kept_generics: List(Pair(Text, Kind)),
    kept_rigid: Ordmap(Text, Ty),
    kept_a: Ty,
    kept_b: Ty
  ): TyKept
}

pub(open) inductive TyClosure: Type {
  TyClosureMk(ty: Ty, start: Nat, end: Nat): TyClosure
}

pub fn local_key_compare(a: LocalKey, b: LocalKey): Ordering {
  ty_then(Ordmap::compare_text(a.name, b.name), Ordmap::compare_nat(a.site, b.site))
}

pub fn width_fits(w: Width, negative: Bool, magnitude: Nat): Bool {
  ⊢ Bool from match negative {
    true => ⊢ Bool from match w {
      Width32 => magnitude <= 2147483648
      Width64 => true
      _ => false
    }
    false => ⊢ Bool from match w {
      Width32 => magnitude <= 2147483647
      Width64 => true
      WidthU8 => magnitude <= 255
      WidthU32 => magnitude <= 4294967295
      WidthU64 => true
    }
  }
}

pub fn literal_text(l: TyLiteral): Text {
  ⊢ Text from match l.negative {
    true => cat2("-", Text::of_nat(l.magnitude))
    false => Text::of_nat(l.magnitude)
  }
}

// A class the program declares, and the kind its parameter is bounded by. For
// a class of type constructors, `arg` is the kind its parameter takes; the
// `bound` is what it makes.
pub(open) inductive ClassInfo: Type {
  ClassInfoMk(decl: SurfaceClass, bound: Kind, arg: Option(Kind)): ClassInfo
}

// An instance: its generics with their bounds, the type it is for over
// them, and its `where` (a class and the generic it constrains).
pub(open) inductive InstanceInfo: Type {
  InstanceInfoMk(
    generics: List(Pair(Text, Kind)),
    head: Ty,
    preds: List(Pair(Text, Text))
  ): InstanceInfo
}

// A name a type written in a body may use: a generic of the function being
// checked (`A` for its `A`), or the name an arm for every instance gives a
// type argument (`T` for the rigid type of `∀ T. res<T>(…)`).
pub(open) inductive TypeName: Type {
  TypeNameMk(name: Text, param: Text, kind: Kind): TypeName
}

// What a type written in a body reads each name as, the first of the names
// standing.
pub fn type_scope(xs: List(TypeName)): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match xs {
    Nil => Ordmap::empty()
    Cons(x, rest) => Ordmap::insert(
      type_scope(rest),
      x.name,
      TyParam(x.param, x.kind),
      Ordmap::compare_text
    )
  }
}

pub(open) inductive Checker: Type {
  CheckerMk(
    classes: Ordmap(Text, ClassInfo),
    // Keyed by `instance_key`: the class's name and the constructor at the
    // head of the instance, joined by a space.
    instances: Ordmap(Text, InstanceInfo),
    subst: Ordmap(Nat, Ty),
    next: Nat,
    ints: Ordmap(Nat, Bool),
    fns: Ordmap(Text, Scheme),
    effects: Ordmap(Text, EffectSig),
    quants: Ordmap(Text, Quant),
    datas: Datas,
    errors: List(TypeError),
    ops: List(TyOp),
    literals: List(TyLiteral),
    // The result type a `return` gives, innermost function first.
    returns: List(Ty),
    // The body type of the budgets the nearest `exceeded` arm answers.
    exceeded: List(Ty),
    lets: List(TyLet),
    bounds: List(TyBound),
    // Type constructor variables at their uses, newest first.
    ctor_bounds: List(TyCtorBound),
    // Writing a type where a constructor is wanted: an instance's head.
    constructor_position: Bool,
    // How many rigid generics `fits` has made, for their names.
    rigids: Nat,
    // The uses of rigid generics, newest first.
    kept: List(TyKept),
    // What the function being checked may assume: its `where`.
    assume: List(Pair(Text, Text)),
    // Constraints of the uses, checked in `ck_finish`.
    pending: List(TyPending),
    constructor_uses: List(TyConstructorUse),
    locals: Ordmap(LocalKey, Ty),
    // The type of each term as it was inferred, newest first: a term inferred
    // again is in it again, and the newest is the one that stands.
    terms: List(Pair(TermAt, Ty)),
    // Each closure's result type, which may not be a borrow: checked once the
    // types are known.
    closure_results: List(TyClosure),
    hint: Option(Ty),
    // The type being written is the one directly under a `&`: `Slice(A)` may be
    // written there only.
    under_borrow: Bool,
    // The generics of the function being checked, and the names an arm for
    // every instance (`∀ A. res<A>(…)`) gives its type arguments: what a
    // type written in a body reads a name as.
    type_params: List(TypeName),
    // Where a type is expected (`ck_expect`), a product is fitted to a type by the types of its
    // members; in a union and in a function's type it is not.
    widen_products: Bool,
    // Enough steps to follow the substitution through the program's types.
    steps: Nat
  ): Checker
}

pub fn checker_new(steps: Nat): Checker {
  Checker {
    classes: Ordmap::empty(),
    instances: Ordmap::empty(),
    subst: Ordmap::empty(),
    next: 0,
    ints: Ordmap::empty(),
    fns: Ordmap::empty(),
    effects: Ordmap::empty(),
    quants: Ordmap::empty(),
    datas: datas_empty(steps),
    errors: Nil,
    ops: Nil,
    literals: Nil,
    returns: Nil,
    exceeded: Nil,
    lets: Nil,
    bounds: Nil,
    ctor_bounds: Nil,
    constructor_position: false,
    rigids: 0,
    kept: Nil,
    assume: Nil,
    pending: Nil,
    constructor_uses: Nil,
    locals: Ordmap::empty(),
    terms: Nil,
    closure_results: Nil,
    hint: None,
    under_borrow: false,
    type_params: Nil,
    widen_products: false,
    steps: steps
  }
}

// ----- setters, for the fields that are borrowed whole -----

pub fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}

pub fn bump(&mut n: Nat): Unit {
  n := n + 1
}

pub fn ck_error(&mut c: Checker, message: Text, span: TySpan): Unit {
  set_to(
    &mut c.errors,
    Cons(TypeError { message: message, start: span.start, end: span.end }, c.errors)
  )
}

pub fn span_of(t: SurfaceTerm): TySpan {
  TySpan { start: t.start, end: t.end }
}

pub fn ck_add_int(&mut c: Checker, v: Nat): Unit {
  set_to(&mut c.ints, Ordmap::insert(c.ints, v, true, Ordmap::compare_nat))
}

pub fn ck_fresh(&mut c: Checker): Ty {
  let v := c.next
  bump(&mut c.next)
  TyVar(v)
}

pub fn ck_fresh_int(&mut c: Checker): Ty {
  let v := c.next
  bump(&mut c.next)
  ck_add_int(&mut c, v)
  TyVar(v)
}

pub fn ck_is_int(&c: Checker, v: Nat): Bool {
  Ordmap::contains(c.ints, v, Ordmap::compare_nat)
}

mutual {
  pub fn ty_resolve_list_in(k: Nat, subst: Ordmap(Nat, Ty), ts: List(Ty)): List(Ty) {
    ⊢ List(Ty) from match k {
      Zero => ts
      Succ(j) => ⊢ List(Ty) from match ts {
        Nil => Nil
        Cons(t, rest) => Cons(ty_resolve_in(j, subst, t), ty_resolve_list_in(j, subst, rest))
      }
    }
  }

  pub fn ty_resolve_in(k: Nat, subst: Ordmap(Nat, Ty), t: Ty): Ty {
    ⊢ Ty from match k {
      Zero => t
      Succ(j) => ⊢ Ty from match t {
        TyVar(i) => ⊢ Ty from match Ordmap::get(subst, i, Ordmap::compare_nat) {
          Some(x) => ty_resolve_in(j, subst, x)
          None => TyVar(i)
        }
        TyFn(ps, r, fk) => TyFn(ty_resolve_list_in(j, subst, ps), ty_resolve_in(j, subst, r), fk)
        TyUnion(ts) => ty_union(ty_resolve_list_in(j, subst, ts))
        TyProduct(ts) => ty_product(ty_resolve_list_in(j, subst, ts))
        TyTagged(tags, x) => ty_tagged(tags, ty_resolve_in(j, subst, x))
        TyNamed(n, args) => TyNamed(n, ty_resolve_list_in(j, subst, args))
        TyInfo(x) => TyInfo(ty_resolve_in(j, subst, x))
        TyBorrow(x, m) => TyBorrow(ty_resolve_in(j, subst, x), m)
        TyInt(w) => TyInt(w)
        TyBool => TyBool
        TyText => TyText
        TyUnit => TyUnit
        TyNever => TyNever
        TyDecimal => TyDecimal
        TyFloat => TyFloat
        TyParam(n, pk) => TyParam(n, pk)
        TyPoly(gs, x) => TyPoly(gs, ty_resolve_in(j, subst, x))
        TyApp(h, x) => ty_apply(ty_resolve_in(j, subst, h), ty_resolve_in(j, subst, x))
      }
    }
  }
}

pub fn ck_resolve(&c: Checker, t: Ty): Ty {
  ty_resolve_in(c.steps, c.subst, t)
}

pub fn ck_kind(&c: Checker, t: Ty): Kind {
  datas_kind(c.datas, ck_resolve(&c, t))
}

mutual {
  pub fn ck_occurs_any_in(k: Nat, &c: Checker, v: Nat, ts: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => ck_occurs_in(j, &c, v, t) || ck_occurs_any_in(j, &c, v, rest)
      }
    }
  }

  pub fn ck_occurs_in(k: Nat, &c: Checker, v: Nat, t: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ck_resolve(&c, t) {
        TyVar(i) => i == v
        TyFn(ps, r, fk) => ck_occurs_any_in(j, &c, v, ps) || ck_occurs_in(j, &c, v, r)
        TyUnion(ts) => ck_occurs_any_in(j, &c, v, ts)
        TyProduct(ts) => ck_occurs_any_in(j, &c, v, ts)
        TyTagged(tags, x) => ck_occurs_in(j, &c, v, x)
        TyInfo(x) => ck_occurs_in(j, &c, v, x)
        TyBorrow(x, m) => ck_occurs_in(j, &c, v, x)
        TyPoly(gs, x) => ck_occurs_in(j, &c, v, x)
        TyApp(h, x) => ck_occurs_in(j, &c, v, h) || ck_occurs_in(j, &c, v, x)
        TyNamed(n, args) => ck_occurs_any_in(j, &c, v, args)
        _ => false
      }
    }
  }
}

pub fn ck_occurs(&c: Checker, v: Nat, t: Ty): Bool {
  ck_occurs_in(c.steps, &c, v, t)
}

mutual {
  pub fn ck_has_vars_any_in(k: Nat, &c: Checker, ts: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => ck_has_vars_in(j, &c, t) || ck_has_vars_any_in(j, &c, rest)
      }
    }
  }

  pub fn ck_has_vars_in(k: Nat, &c: Checker, t: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ck_resolve(&c, t) {
        TyVar(i) => true
        TyFn(ps, r, fk) => ck_has_vars_any_in(j, &c, ps) || ck_has_vars_in(j, &c, r)
        TyUnion(ts) => ck_has_vars_any_in(j, &c, ts)
        TyProduct(ts) => ck_has_vars_any_in(j, &c, ts)
        TyTagged(tags, x) => ck_has_vars_in(j, &c, x)
        TyInfo(x) => ck_has_vars_in(j, &c, x)
        TyBorrow(x, m) => ck_has_vars_in(j, &c, x)
        TyPoly(gs, x) => ck_has_vars_in(j, &c, x)
        TyApp(h, x) => ck_has_vars_in(j, &c, h) || ck_has_vars_in(j, &c, x)
        TyNamed(n, args) => ck_has_vars_any_in(j, &c, args)
        _ => false
      }
    }
  }
}

pub fn ck_has_vars(&c: Checker, t: Ty): Bool {
  ck_has_vars_in(c.steps, &c, t)
}

pub fn ck_set_subst(&mut c: Checker, v: Nat, t: Ty): Unit {
  set_to(&mut c.subst, Ordmap::insert(c.subst, v, t, Ordmap::compare_nat))
}

pub fn ck_bind_value(&mut c: Checker, v: Nat, t: Ty): Bool {
  if ck_occurs(&c, v, t) {
    false
  } else {
    ck_set_subst(&mut c, v, t)
    true
  }
}

// `t` is not a variable or an integer type: a variable that must be an
// integer (`ck_is_int`) is not bound to it.
pub fn ck_bind_other(&mut c: Checker, v: Nat, t: Ty): Bool {
  if ck_is_int(&c, v) {
    false
  } else {
    ck_bind_value(&mut c, v, t)
  }
}

pub fn ck_bind_var(&mut c: Checker, v: Nat, w: Nat): Bool {
  if w == v {
    true
  } else {
    if ck_is_int(&c, v) {
      ck_add_int(&mut c, w)
    }
    ck_set_subst(&mut c, v, TyVar(w))
    true
  }
}

pub fn ck_is_bound(&c: Checker, v: Nat): Bool {
  Ordmap::contains(c.subst, v, Ordmap::compare_nat)
}

pub fn ck_bind_unbound(&mut c: Checker, v: Nat, t: Ty): Bool {
  ⊢ Bool from match t {
    TyVar(w) => ck_bind_var(&mut c, v, w)
    TyInt(w) => ck_bind_value(&mut c, v, TyInt(w))
    _ => ck_bind_other(&mut c, v, t)
  }
}

// A variable already bound (resolving ran out of steps) is not bound again.
pub fn ck_bind(&mut c: Checker, v: Nat, t: Ty): Bool {
  if ck_is_bound(&c, v) {
    false
  } else {
    ck_bind_unbound(&mut c, v, t)
  }
}

pub fn ty_is_var(t: Ty): Bool {
  ⊢ Bool from match t {
    TyVar(v) => true
    _ => false
  }
}

// The generics of a `TyPoly` as types no other is equal to.
pub fn ck_rigid(gs: List(Pair(Text, Kind)), &mut c: Checker): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match gs {
    Nil => Ordmap::empty()
    Cons(g, rest) => {
      bump(&mut c.rigids)
      let t := TyParam(cat3(g.fst, "#", Text::of_nat(c.rigids)), g.snd)
      Ordmap::insert(ck_rigid(rest, &mut c), g.fst, t, Ordmap::compare_text)
    }
  }
}

pub fn ty_rigid_names(gs: List(Pair(Text, Kind)), rigid: Ordmap(Text, Ty)): Option(List(Text)) {
  ⊢ Option(List(Text)) from match gs {
    Nil => Some(Nil)
    Cons(g, rest) => ⊢ Option(List(Text)) from match Ordmap::get(rigid, g.fst, Ordmap::compare_text) {
      Some(t) => ⊢ Option(List(Text)) from match t {
        TyParam(n, k) => ⊢ Option(List(Text)) from match ty_rigid_names(rest, rigid) {
          Some(ns) => Some(Cons(n, ns))
          None => None
        }
        _ => None
      }
      None => None
    }
  }
}

pub fn text_list_distinct(xs: List(Text)): Bool {
  ⊢ Bool from match xs {
    Nil => true
    Cons(x, rest) => not(list_has_text(rest, x)) && text_list_distinct(rest)
  }
}

// Whether a parameter named in `ns` is in `t` resolved. A variable left
// bound (resolving ran out of steps) or running out of steps here counts as
// one.
mutual {
  pub fn ck_mentions_any_in(k: Nat, &c: Checker, ns: List(Text), ts: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => true
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => ck_mentions_in(j, &c, ns, t) || ck_mentions_any_in(j, &c, ns, rest)
      }
    }
  }

  pub fn ck_mentions_in(k: Nat, &c: Checker, ns: List(Text), t: Ty): Bool {
    ⊢ Bool from match k {
      Zero => true
      Succ(j) => ⊢ Bool from match ck_resolve(&c, t) {
        TyVar(i) => ck_is_bound(&c, i)
        TyParam(n, pk) => list_has_text(ns, n)
        TyFn(ps, r, fk) => ck_mentions_any_in(j, &c, ns, ps) || ck_mentions_in(j, &c, ns, r)
        TyUnion(ts) => ck_mentions_any_in(j, &c, ns, ts)
        TyProduct(ts) => ck_mentions_any_in(j, &c, ns, ts)
        TyTagged(tags, x) => ck_mentions_in(j, &c, ns, x)
        TyInfo(x) => ck_mentions_in(j, &c, ns, x)
        TyBorrow(x, m) => ck_mentions_in(j, &c, ns, x)
        TyPoly(gs, x) => ck_mentions_in(j, &c, ns, x)
        TyApp(h, x) => ck_mentions_in(j, &c, ns, h) || ck_mentions_in(j, &c, ns, x)
        TyNamed(n, args) => ck_mentions_any_in(j, &c, ns, args)
        _ => false
      }
    }
  }
}

// After `a` and `b` were made the same with `gs` read as `rigid`: the rigid
// types are distinct and none of them got into `a` or `b` (through a variable
// bound to one).
pub fn ck_rigid_kept(
  &c: Checker,
  gs: List(Pair(Text, Kind)),
  rigid: Ordmap(Text, Ty),
  a: Ty,
  b: Ty
): Bool {
  ⊢ Bool from match ty_rigid_names(gs, rigid) {
    None => false
    Some(ns) => text_list_distinct(
      ns
    ) && not(ck_mentions_in(c.steps, &c, ns, a)) && not(ck_mentions_in(c.steps, &c, ns, b))
  }
}

pub fn ck_keep(
  &mut c: Checker,
  gs: List(Pair(Text, Kind)),
  rigid: Ordmap(Text, Ty),
  a: Ty,
  b: Ty
): Bool {
  if ck_rigid_kept(&c, gs, rigid, a, b) {
    set_to(
      &mut c.kept,
      Cons(TyKept { kept_generics: gs, kept_rigid: rigid, kept_a: a, kept_b: b }, c.kept)
    )
    true
  } else {
    false
  }
}

pub fn ty_kinds_match(ga: List(Pair(Text, Kind)), gb: List(Pair(Text, Kind))): Bool {
  ⊢ Bool from match ga {
    Nil => ⊢ Bool from match gb {
      Nil => true
      Cons(b, brest) => false
    }
    Cons(a, arest) => ⊢ Bool from match gb {
      Nil => false
      Cons(b, brest) => kind_eq(a.snd, b.snd) && ty_kinds_match(arest, brest)
    }
  }
}

// The generics of a `TyPoly` as fresh variables, at a use.
pub fn ck_instance_of(gs: List(Pair(Text, Kind)), &mut c: Checker): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match gs {
    Nil => Ordmap::empty()
    Cons(g, rest) => {
      let v := ck_fresh(&mut c)
      set_to(&mut c.bounds, Cons(TyBound { ty: v, kind: g.snd, start: 0, end: 0 }, c.bounds))
      Ordmap::insert(ck_instance_of(rest, &mut c), g.fst, v, Ordmap::compare_text)
    }
  }
}

// `gb`'s generics, named as `ga`'s are in `rigid`.
pub fn ty_poly_map(
  gb: List(Pair(Text, Kind)),
  ga: List(Pair(Text, Kind)),
  rigid: Ordmap(Text, Ty)
): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match gb {
    Nil => Ordmap::empty()
    Cons(b, brest) => ⊢ Ordmap(Text, Ty) from match ga {
      Nil => Ordmap::empty()
      Cons(a, arest) => Ordmap::insert(
        ty_poly_map(brest, arest, rigid),
        b.fst,
        ty_substitute_name(a.fst, rigid, TyVar(0)),
        Ordmap::compare_text
      )
    }
  }
}

pub fn ty_split_last(args: List(Ty)): Option(Pair(List(Ty), Ty)) {
  ⊢ Option(Pair(List(Ty), Ty)) from match args {
    Nil => None
    Cons(a, rest) => ⊢ Option(Pair(List(Ty), Ty)) from match ty_split_last(rest) {
      None => Some(Pair { fst: Nil, snd: a })
      Some(p) => Some(Pair { fst: Cons(a, p.fst), snd: p.snd })
    }
  }
}

// Makes `a` and `b` the same type. The two duplicable kinds of a function are
// the same here: they differ only at run time.
mutual {
  pub fn ck_unify_pairs_in(k: Nat, &mut c: Checker, xs: List(Ty), ys: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match xs {
        Nil => true
        Cons(x, xrest) => ⊢ Bool from match ys {
          Nil => true
          Cons(y, yrest) => if ck_unify_in(j, &mut c, x, y) {
            ck_unify_pairs_in(j, &mut c, xrest, yrest)
          } else {
            false
          }
        }
      }
    }
  }

  pub fn ck_unify_in(k: Nat, &mut c: Checker, a0: Ty, b0: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => {
        let a := ck_resolve(&c, a0)
        let b := ck_resolve(&c, b0)
        ⊢ Bool from match a {
          TyVar(v) => ck_bind(&mut c, v, b)
          _ => ck_unify_rest_in(j, &mut c, a, b)
        }
      }
    }
  }

  pub fn ck_unify_rest_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match b {
        TyVar(v) => ck_bind(&mut c, v, a)
        // `F(X) ~ H(U₁, …, Uₙ)`: `F := H(U₁, …, Uₙ₋₁)` and `X ~ Uₙ`. The
        // solution is the only one.
        TyApp(hb, xb) => ⊢ Bool from match a {
          TyApp(ha, xa) => if ck_unify_in(
            j,
            &mut c,
            ha,
            hb
          ) { ck_unify_in(j, &mut c, xa, xb) } else { false }
          TyNamed(na, xa) => ck_unify_app_in(j, &mut c, hb, xb, na, xa)
          _ => false
        }
        TyPoly(gb, tb) => ⊢ Bool from match a {
          TyPoly(ga, ta) => if ty_kinds_match(ga, gb) {
            let rigid := ck_rigid(ga, &mut c)
            if ck_unify_in(
              j,
              &mut c,
              ty_substitute(ta, rigid),
              ty_substitute(tb, ty_poly_map(gb, ga, rigid))
            ) {
              ck_keep(&mut c, ga, rigid, a, b)
            } else {
              false
            }
          } else {
            ty_eq(a, b)
          }
          _ => false
        }
        TyFn(pb, rb, kb) => ⊢ Bool from match a {
          TyFn(pa, ra, ka) => if list_len(
            pa
          ) == list_len(pb) && (kind_eq(ka, kb) || (kind_dup(ka) && kind_dup(kb))) {
            if ck_unify_pairs_in(j, &mut c, pa, pb) { ck_unify_in(j, &mut c, ra, rb) } else {
              false
            }
          } else {
            ty_eq(a, b)
          }
          _ => false
        }
        TyNamed(nb, xb) => ⊢ Bool from match a {
          TyNamed(na, xa) => if na == nb && list_len(xa) == list_len(xb) {
            ck_unify_pairs_in(j, &mut c, xa, xb)
          } else {
            ty_eq(a, b)
          }
          TyApp(ha, xa) => ck_unify_app_in(j, &mut c, ha, xa, nb, xb)
          _ => false
        }
        TyInfo(y) => ⊢ Bool from match a {
          TyInfo(x) => ck_unify_in(j, &mut c, x, y)
          _ => false
        }
        TyBorrow(y, mb) => ⊢ Bool from match a {
          TyBorrow(x, ma) => if ma == mb { ck_unify_in(j, &mut c, x, y) } else { ty_eq(a, b) }
          _ => false
        }
        TyTagged(tb, y) => ⊢ Bool from match a {
          TyTagged(ta, x) => if text_list_eq(
            ta,
            tb
          ) { ck_unify_in(j, &mut c, x, y) } else { ty_eq(a, b) }
          _ => false
        }
        TyUnion(xb) => ⊢ Bool from match a {
          TyUnion(xa) => if list_len(xa) == list_len(xb) {
            ck_unify_pairs_in(j, &mut c, xa, xb)
          } else {
            ty_eq(a, b)
          }
          _ => false
        }
        TyProduct(xb) => ⊢ Bool from match a {
          TyProduct(xa) => if list_len(xa) == list_len(xb) {
            ck_unify_pairs_in(j, &mut c, xa, xb)
          } else {
            ty_eq(a, b)
          }
          _ => false
        }
        _ => ty_eq(a, b)
      }
    }
  }

  pub fn ck_unify_app_in(k: Nat, &mut c: Checker, h: Ty, x: Ty, n: Text, args: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ty_split_last(args) {
        None => false
        Some(p) => if ck_unify_in(j, &mut c, h, TyNamed(n, p.fst)) {
          ck_unify_in(j, &mut c, x, p.snd)
        } else {
          false
        }
      }
    }
  }
}

pub fn ck_unify(&mut c: Checker, a: Ty, b: Ty): Bool {
  ck_unify_in(c.steps, &mut c, a, b)
}

pub fn ck_attempt_unify(&mut c: Checker, a: Ty, b: Ty): Bool {
  let subst := c.subst
  let ints := c.ints
  let next := c.next
  let kept := c.kept
  if ck_unify(&mut c, a, b) {
    true
  } else {
    set_to(&mut c.subst, subst)
    set_to(&mut c.ints, ints)
    set_to(&mut c.next, next)
    set_to(&mut c.kept, kept)
    false
  }
}

// ----- products fitted by the types of their members -----

// A product is written by position. Where a type is expected (`ck_expect`), its members are
// matched to those of the type wanted by their types (`A × B <: A`, `A × B <: B × A`), but
// only where both sides are closed and the members of each side differ. An integer literal
// of unknown width is closed: it stands for some integer type, so it is matched to the one
// integer member on the other side, and two integer members of which one is a literal are
// not told apart.

pub fn ck_member_literal(&c: Checker, t: Ty): Bool {
  ⊢ Bool from match ck_resolve(&c, t) {
    TyVar(v) => ck_is_int(&c, v)
    _ => false
  }
}

pub fn ck_member_integer(&c: Checker, t: Ty): Bool {
  ⊢ Bool from match ck_resolve(&c, t) {
    TyInt(w) => true
    _ => ck_member_literal(&c, t)
  }
}

pub fn ck_member_same(&c: Checker, x: Ty, y: Ty): Bool {
  ty_eq(
    ck_resolve(&c, x),
    ck_resolve(&c, y)
  ) || (
    ck_member_integer(
      &c,
      x
    ) && ck_member_integer(&c, y) && (ck_member_literal(&c, x) || ck_member_literal(&c, y))
  )
}

// A member that a type parameter or an unknown type could make equal to another.
pub fn ck_member_open(&c: Checker, t: Ty): Bool {
  not(ck_member_literal(&c, t)) && (ck_has_vars(&c, t) || ty_has_param(ck_resolve(&c, t)))
}

pub fn ck_members_open(&c: Checker, ts: List(Ty)): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(t, rest) => ck_member_open(&c, t) || ck_members_open(&c, rest)
  }
}

pub fn ck_members_has(&c: Checker, ts: List(Ty), t: Ty): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(u, rest) => ck_member_same(&c, u, t) || ck_members_has(&c, rest, t)
  }
}

// Two members of the side have the same type.
pub fn ck_members_repeat(&c: Checker, ts: List(Ty)): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(t, rest) => ck_members_has(&c, rest, t) || ck_members_repeat(&c, rest)
  }
}

pub fn ck_find_cons(x: Ty, same: Bool, rest: Option(Ty)): Option(Ty) {
  ⊢ Option(Ty) from match same {
    true => Some(x)
    false => rest
  }
}

// The first member of `xs` that has the type of `y`.
pub fn ck_members_find(&c: Checker, xs: List(Ty), y: Ty): Option(Ty) {
  ⊢ Option(Ty) from match xs {
    Nil => None
    Cons(x, rest) => ck_find_cons(x, ck_member_same(&c, x, y), ck_members_find(&c, rest, y))
  }
}

pub fn ck_pairs_cons(
  y: Ty,
  found: Option(Ty),
  rest: Option(List(Pair(Ty, Ty)))
): Option(List(Pair(Ty, Ty))) {
  ⊢ Option(List(Pair(Ty, Ty))) from match found {
    None => None
    Some(x) => ⊢ Option(List(Pair(Ty, Ty))) from match rest {
      None => None
      Some(pairs) => Some(Cons(Pair { fst: x, snd: y }, pairs))
    }
  }
}

// Each of `ys` with the member of `xs` that has its type.
pub fn ck_members_pairs(&c: Checker, xs: List(Ty), ys: List(Ty)): Option(List(Pair(Ty, Ty))) {
  ⊢ Option(List(Pair(Ty, Ty))) from match ys {
    Nil => Some(Nil)
    Cons(y, yrest) => ck_pairs_cons(y, ck_members_find(&c, xs, y), ck_members_pairs(&c, xs, yrest))
  }
}

pub fn ck_pairs_firsts(pairs: List(Pair(Ty, Ty))): List(Ty) {
  ⊢ List(Ty) from match pairs {
    Nil => Nil
    Cons(p, rest) => Cons(p.fst, ck_pairs_firsts(rest))
  }
}

pub fn ck_unify_found(&mut c: Checker, found: List(Pair(Ty, Ty))): Bool {
  ⊢ Bool from match found {
    Nil => true
    Cons(p, rest) => if ck_unify(&mut c, p.fst, p.snd) {
      ck_unify_found(&mut c, rest)
    } else {
      false
    }
  }
}

// Each member of `xs` is taken once: when two of `ys` found the same member, `ck_members_repeat`
// finds it twice among the members taken.
pub fn ck_fit_found(&mut c: Checker, found: Option(List(Pair(Ty, Ty)))): Bool {
  ⊢ Bool from match found {
    None => false
    Some(f) => if ck_members_repeat(&c, ck_pairs_firsts(f)) {
      false
    } else {
      ck_unify_found(&mut c, f)
    }
  }
}

// The members `xs` of a product fitted to `ys` by their types: each of `ys` is exactly one of
// `xs`. A side that is not closed or repeats a type is not matched this way (`ck_expect`
// says why).
pub fn ck_fit_by_types(&mut c: Checker, xs: List(Ty), ys: List(Ty)): Bool {
  if ck_members_open(&c, xs) || ck_members_open(&c, ys) {
    false
  } else if ck_members_repeat(&c, xs) || ck_members_repeat(&c, ys) {
    false
  } else {
    ck_fit_found(&mut c, ck_members_pairs(&c, xs, ys))
  }
}

// What a product is fitted to: the members of a product, or the type itself.
pub fn ty_wanted_members(b: Ty): List(Ty) {
  ⊢ List(Ty) from match b {
    TyProduct(ys) => ys
    _ => Cons(b, Nil)
  }
}

// `a`, the product of `xs`, where `b` is expected: made the same by position, or, where a
// type is expected (`widen_products`), fitted by the types of its members.
pub fn ck_fits_product(&mut c: Checker, a: Ty, xs: List(Ty), b: Ty): Bool {
  if c.widen_products {
    if ck_attempt_unify(&mut c, a, b) { true } else {
      ck_fit_by_types(&mut c, xs, ty_wanted_members(b))
    }
  } else {
    ck_unify(&mut c, a, b)
  }
}

pub fn ck_widen_to(&mut c: Checker, widen: Bool): Unit {
  set_to(&mut c.widen_products, widen)
}

mutual {
  pub fn ck_attempt_fits_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => {
        let subst := c.subst
        let ints := c.ints
        let next := c.next
        let kept := c.kept
        if ck_fits_in(j, &mut c, a, b) {
          true
        } else {
          set_to(&mut c.subst, subst)
          set_to(&mut c.ints, ints)
          set_to(&mut c.next, next)
          set_to(&mut c.kept, kept)
          false
        }
      }
    }
  }

  pub fn ck_fits_each_in(k: Nat, &mut c: Checker, xs: List(Ty), b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match xs {
        Nil => true
        Cons(x, rest) => if ck_fits_in(
          j,
          &mut c,
          x,
          b
        ) { ck_fits_each_in(j, &mut c, rest, b) } else { false }
      }
    }
  }

  pub fn ck_fits_any_in(k: Nat, &mut c: Checker, a: Ty, ys: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ys {
        Nil => false
        Cons(y, rest) => if ck_attempt_fits_in(
          j,
          &mut c,
          a,
          y
        ) { true } else { ck_fits_any_in(j, &mut c, a, rest) }
      }
    }
  }

  // Contravariant in the parameters.
  pub fn ck_fits_params_in(k: Nat, &mut c: Checker, pa: List(Ty), pb: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match pa {
        Nil => true
        Cons(x, xrest) => ⊢ Bool from match pb {
          Nil => true
          Cons(y, yrest) => if ck_fits_in(
            j,
            &mut c,
            y,
            x
          ) { ck_fits_params_in(j, &mut c, xrest, yrest) } else { false }
        }
      }
    }
  }

  pub fn ck_fits_in(k: Nat, &mut c: Checker, a0: Ty, b0: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => {
        let a := ck_resolve(&c, a0)
        let b := ck_resolve(&c, b0)
        if ty_is_never(a) {
          true
        } else if ty_is_var(a) || ty_is_var(b) {
          ck_unify(&mut c, a, b)
        } else {
          ck_fits_poly_in(j, &mut c, a, b)
        }
      }
    }
  }

  // What is wanted is general: `a` has to be as general. What is given is
  // general: some instance of it will do.
  pub fn ck_fits_poly_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match b {
        TyPoly(gs, t) => {
          let rigid := ck_rigid(gs, &mut c)
          if ck_fits_in(j, &mut c, a, ty_substitute(t, rigid)) {
            ck_keep(&mut c, gs, rigid, a, b)
          } else {
            false
          }
        }
        _ => ck_fits_inst_in(j, &mut c, a, b)
      }
    }
  }

  pub fn ck_fits_inst_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match a {
        TyPoly(gs, t) => {
          let fresh := ck_instance_of(gs, &mut c)
          ck_fits_in(j, &mut c, ty_substitute(t, fresh), b)
        }
        _ => ck_fits_borrow_in(j, &mut c, a, b)
      }
    }
  }

  pub fn ck_fits_borrow_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match a {
        TyBorrow(x, ma) => ck_fits_lend_in(j, &mut c, x, ma, b)
        _ => ck_fits_value_in(j, &mut c, a, b)
      }
    }
  }

  // A `&mut` borrow may be lent as a `&` one; a borrow used as a value:
  // `lin.rs` says whether it may be.
  pub fn ck_fits_lend_in(k: Nat, &mut c: Checker, x: Ty, ma: Bool, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match b {
        TyBorrow(y, mb) => if ma == mb || not(mb) { ck_fits_in(j, &mut c, x, y) } else {
          ck_fits_in(j, &mut c, x, b)
        }
        _ => ck_fits_in(j, &mut c, x, b)
      }
    }
  }

  pub fn ck_fits_value_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match b {
        // `&A ≡ A` when `A` is duplicable.
        TyBorrow(y, m) => if kind_dup(
          ck_kind(&c, a)
        ) { ck_fits_in(j, &mut c, a, y) } else { ck_fits_shape_in(j, &mut c, a, b) }
        _ => ck_fits_shape_in(j, &mut c, a, b)
      }
    }
  }

  pub fn ck_fits_shape_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match a {
        // Inside a union a product keeps its members. Nothing is fitted after this, so
        // `ck_fits_wide` puts the setting back.
        TyUnion(xs) => {
          ck_widen_to(&mut c, false)
          ck_fits_each_in(j, &mut c, xs, b)
        }
        _ => ck_fits_into_in(j, &mut c, a, b)
      }
    }
  }

  pub fn ck_fits_into_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match b {
        TyUnion(ys) => {
          ck_widen_to(&mut c, false)
          if ck_attempt_unify(&mut c, a, b) { true } else { ck_fits_any_in(j, &mut c, a, ys) }
        }
        _ => ck_fits_tagged_in(j, &mut c, a, b)
      }
    }
  }

  // Tags are forgotten, never added.
  pub fn ck_fits_tagged_in(k: Nat, &mut c: Checker, a: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match a {
        TyTagged(ta, x) => ck_fits_untag_in(j, &mut c, ta, x, b)
        TyProduct(xs) => ck_fits_product(&mut c, a, xs, b)
        TyFn(pa, ra, ka) => ck_fits_fn_in(j, &mut c, pa, ra, ka, b)
        _ => ck_unify(&mut c, a, b)
      }
    }
  }

  pub fn ck_fits_untag_in(k: Nat, &mut c: Checker, ta: List(Text), x: Ty, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match b {
        TyTagged(tb, y) => if tags_subset(
          tb,
          ta
        ) { ck_fits_in(j, &mut c, x, y) } else { ck_unify(&mut c, TyTagged(ta, x), b) }
        _ => ck_fits_in(j, &mut c, x, b)
      }
    }
  }

  pub fn ck_fits_fn_in(k: Nat, &mut c: Checker, pa: List(Ty), ra: Ty, ka: Kind, b: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match b {
        TyFn(pb, rb, kb) => if list_len(pa) == list_len(pb) && kind_fits(ka, kb) {
          // Inside a function's type a product keeps its members: nothing would take them
          // out where the function is called. Nothing is fitted after this, so
          // `ck_fits_wide` puts the setting back.
          ck_widen_to(&mut c, false)
          if ck_fits_params_in(j, &mut c, pa, pb) { ck_fits_in(j, &mut c, ra, rb) } else { false }
        } else {
          ck_unify(&mut c, TyFn(pa, ra, ka), b)
        }
        _ => ck_unify(&mut c, TyFn(pa, ra, ka), b)
      }
    }
  }
}

pub fn ck_fits(&mut c: Checker, a: Ty, b: Ty): Bool {
  ck_fits_in(c.steps, &mut c, a, b)
}

pub fn ck_attempt_fits(&mut c: Checker, a: Ty, b: Ty): Bool {
  ck_attempt_fits_in(c.steps, &mut c, a, b)
}

pub fn ty_shown_var(ints: Ordmap(Nat, Bool), v: Nat): Ty {
  if Ordmap::contains(ints, v, Ordmap::compare_nat) { TyInt(Width64) } else { TyVar(v) }
}

// `t` for a message: an integer of unknown width reads as `i64`.
mutual {
  pub fn ty_shown_list_in(k: Nat, &c: Checker, ts: List(Ty)): List(Ty) {
    ⊢ List(Ty) from match k {
      Zero => ts
      Succ(j) => ⊢ List(Ty) from match ts {
        Nil => Nil
        Cons(t, rest) => Cons(ty_shown_in(j, &c, t), ty_shown_list_in(j, &c, rest))
      }
    }
  }

  pub fn ty_shown_in(k: Nat, &c: Checker, t0: Ty): Ty {
    ⊢ Ty from match k {
      Zero => t0
      Succ(j) => ⊢ Ty from match ck_resolve(&c, t0) {
        TyVar(v) => ty_shown_var(c.ints, v)
        TyFn(ps, r, fk) => TyFn(ty_shown_list_in(j, &c, ps), ty_shown_in(j, &c, r), fk)
        TyUnion(ts) => ty_union(ty_shown_list_in(j, &c, ts))
        TyProduct(ts) => ty_product(ty_shown_list_in(j, &c, ts))
        TyTagged(tags, x) => ty_tagged(tags, ty_shown_in(j, &c, x))
        TyNamed(n, args) => TyNamed(n, ty_shown_list_in(j, &c, args))
        TyInfo(x) => TyInfo(ty_shown_in(j, &c, x))
        TyBorrow(x, m) => TyBorrow(ty_shown_in(j, &c, x), m)
        TyInt(w) => TyInt(w)
        TyBool => TyBool
        TyText => TyText
        TyUnit => TyUnit
        TyNever => TyNever
        TyDecimal => TyDecimal
        TyFloat => TyFloat
        TyParam(n, pk) => TyParam(n, pk)
        TyPoly(gs, x) => TyPoly(gs, x)
        TyApp(h, x) => TyApp(h, x)
      }
    }
  }
}

pub fn ck_shown(&c: Checker, t: Ty): Ty {
  ty_shown_in(c.steps, &c, t)
}

pub fn expect_closure_kinds_fn(
  pa: List(Ty),
  ka: Kind,
  b: Ty
): Option(@found Kind × @expected Kind) {
  ⊢ Option(@found Kind × @expected Kind) from match ty_unborrowed(b) {
    TyFn(pb, rb, kb) => if list_len(pa) == list_len(pb) && not(kind_fits(ka, kb)) {
      Some(#(@found ka, @expected kb))
    } else {
      None
    }
    _ => None
  }
}

// The functions' kinds when both types are functions of one arity and the
// first does not fit the second.
pub fn expect_closure_kinds(a: Ty, b: Ty): Option(@found Kind × @expected Kind) {
  ⊢ Option(@found Kind × @expected Kind) from match ty_unborrowed(a) {
    TyFn(pa, ra, ka) => expect_closure_kinds_fn(pa, ka, b)
    _ => None
  }
}

pub fn expect_not_app(a: Ty, b: Ty): Option(Ty) {
  ⊢ Option(Ty) from match a {
    TyApp(h, x) => ⊢ Option(Ty) from match b {
      TyApp(h2, x2) => None
      TyVar(v) => None
      TyNamed(n, args) => None
      _ => Some(b)
    }
    TyVar(v) => None
    TyNamed(n, args) => None
    _ => ⊢ Option(Ty) from match b {
      TyApp(h, x) => Some(a)
      _ => None
    }
  }
}

// Why a product was not fitted by the types of its members, read from the types shown in the
// message: a member mentions a type parameter or an unknown type, or two members have the
// same type.
pub(open) inductive ProductNote: Type {
  NoteNone: ProductNote
  NoteOpen: ProductNote
  NoteClash(member: Ty): ProductNote
}

mutual {
  pub fn ty_has_var_each(ts: List(Ty)): Bool {
    ⊢ Bool from match ts {
      Nil => false
      Cons(t, rest) => ty_has_var(t) || ty_has_var_each(rest)
    }
  }

  pub fn ty_has_var(t: Ty): Bool {
    ⊢ Bool from match t {
      TyVar(i) => true
      TyNamed(name, args) => ty_has_var_each(args)
      TyFn(ps, r, k) => ty_has_var_each(ps) || ty_has_var(r)
      TyUnion(ts) => ty_has_var_each(ts)
      TyProduct(ts) => ty_has_var_each(ts)
      TyTagged(tags, x) => ty_has_var(x)
      TyInfo(x) => ty_has_var(x)
      TyBorrow(x, m) => ty_has_var(x)
      TyPoly(gs, x) => ty_has_var(x)
      TyApp(h, x) => ty_has_var(h) || ty_has_var(x)
      _ => false
    }
  }
}

pub fn ty_members_open(ts: List(Ty)): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(t, rest) => ty_has_var(t) || ty_has_param(t) || ty_members_open(rest)
  }
}

pub fn list_has_ty(ts: List(Ty), t: Ty): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(u, rest) => ty_eq(u, t) || list_has_ty(rest, t)
  }
}

// The first member of `ts` that is the type of one before it (`seen`).
pub fn ty_members_repeated(seen: List(Ty), ts: List(Ty)): Option(Ty) {
  ⊢ Option(Ty) from match ts {
    Nil => None
    Cons(t, rest) => if list_has_ty(seen, t) {
      Some(t)
    } else {
      ty_members_repeated(Cons(t, seen), rest)
    }
  }
}

pub fn ty_members_note(xs: List(Ty), ys: List(Ty)): ProductNote {
  if ty_members_open(xs) || ty_members_open(ys) {
    NoteOpen
  } else {
    ⊢ ProductNote from match ty_members_repeated(Nil, xs) {
      Some(t) => NoteClash(t)
      None => ⊢ ProductNote from match ty_members_repeated(Nil, ys) {
        Some(t) => NoteClash(t)
        None => NoteNone
      }
    }
  }
}

// The product `xs` where `b` is wanted. A variable, a union and a generic type are not fitted
// by the types of the members.
pub fn expect_product_note_to(xs: List(Ty), b: Ty): ProductNote {
  ⊢ ProductNote from match b {
    TyVar(v) => NoteNone
    TyUnion(ts) => NoteNone
    TyPoly(gs, x) => NoteNone
    _ => ty_members_note(xs, ty_wanted_members(b))
  }
}

pub fn expect_product_note(a: Ty, b: Ty): ProductNote {
  ⊢ ProductNote from match ty_unborrowed(a) {
    TyProduct(xs) => expect_product_note_to(xs, ty_unborrowed(b))
    _ => NoteNone
  }
}

pub fn expect_product_open_message(a: Ty, b: Ty, what: Text): Text {
  cat5(
    what,
    ": ",
    ty_show(a),
    " and ",
    cat2(
      ty_show(b),
      " are matched by the types of their members only where neither mentions a type parameter or an unknown type; write the members in the same order, or tell them apart with tags"
    )
  )
}

pub fn expect_product_clash_message(member: Ty, what: Text): Text {
  cat5(
    what,
    ": two members of a product have the type ",
    ty_show(member),
    ", so the members cannot be matched by their types; ",
    "write the members by position, or tell them apart with tags"
  )
}

pub fn ck_expect_message(a: Ty, b: Ty, what: Text): Text {
  ⊢ Text from match expect_product_note(a, b) {
    NoteOpen => expect_product_open_message(a, b, what)
    NoteClash(member) => expect_product_clash_message(member, what)
    NoteNone => ck_expect_plain_message(a, b, what)
  }
}

pub fn ck_expect_plain_message(a: Ty, b: Ty, what: Text): Text {
  ⊢ Text from match expect_closure_kinds(a, b) {
    Some(#(@found found, @expected expected)) => cat5(
      what,
      ": an ",
      kind_name(found),
      " closure where ",
      cat2(kind_name(expected), " is expected")
    )
    None => ⊢ Text from match expect_not_app(ty_unborrowed(a), ty_unborrowed(b)) {
      Some(other) => cat2(ty_show(other), " is not an application of a type constructor")
      None => if ty_is_borrow(b) && not(ty_is_borrow(a)) {
        cat5(what, ": ", ty_show(a), " does not fit ", cat2(ty_show(b), ": lend it with `&`"))
      } else {
        cat5(what, ": ", ty_show(a), " does not fit ", ty_show(b))
      }
    }
  }
}

// `ck_fits` where a type is expected: a product is fitted to it by the types of its members.
pub fn ck_fits_wide(&mut c: Checker, a: Ty, b: Ty): Bool {
  let widen := c.widen_products
  ck_widen_to(&mut c, true)
  let fitted := ck_fits(&mut c, a, b)
  ck_widen_to(&mut c, widen)
  fitted
}

pub fn ck_expect(&mut c: Checker, a0: Ty, b0: Ty, span: TySpan, what: Text): Unit {
  if not(ck_fits_wide(&mut c, a0, b0)) {
    let message := ck_expect_message(ck_shown(&c, a0), ck_shown(&c, b0), what)
    ck_error(&mut c, message, span)
  }
}

pub fn ck_join_borrowed_second(&mut c: Checker, a: Ty, b: Ty): Option(Ty) {
  ⊢ Option(Ty) from match b {
    TyBorrow(x, m) => if not(ty_is_borrow(a)) && kind_dup(ck_kind(&c, x)) {
      if ck_attempt_unify(&mut c, x, a) { Some(ck_resolve(&c, x)) } else { None }
    } else {
      None
    }
    _ => None
  }
}

pub fn ck_join_borrowed(&mut c: Checker, a: Ty, b: Ty): Option(Ty) {
  ⊢ Option(Ty) from match a {
    TyBorrow(x, m) => if not(ty_is_borrow(b)) && kind_dup(ck_kind(&c, x)) {
      if ck_attempt_unify(&mut c, x, b) { Some(ck_resolve(&c, x)) } else { None }
    } else {
      ck_join_borrowed_second(&mut c, a, b)
    }
    _ => ck_join_borrowed_second(&mut c, a, b)
  }
}

pub fn ck_join(&mut c: Checker, a0: Ty, b0: Ty): Ty {
  if (ck_has_vars(&c, a0) || ck_has_vars(&c, b0)) && ck_attempt_unify(&mut c, a0, b0) {
    ck_resolve(&c, a0)
  } else {
    let a := ck_resolve(&c, a0)
    let b := ck_resolve(&c, b0)
    if ty_eq(a, b) || ty_is_never(b) {
      a
    } else if ty_is_never(a) {
      b
    } else {
      // A borrow of a duplicable value is the value (`&A ≡ A`).
      ⊢ Ty from match ck_join_borrowed(&mut c, a, b) {
        Some(t) => t
        None => ty_union(Cons(a, Cons(b, Nil)))
      }
    }
  }
}
