import "types_infer.taut"
import "../../surface/src/surface.taut"
import std::Base
import std::List
import std::Map
import std::Text
import "checker.taut"
import "datas.taut"
import "ty.taut"
import "types_decl.taut"
import "../../text/src/text.taut"

// Classes and instances (`types/classes.rs`): their declarations are checked,
// each method becomes a function that carries the class as a `where`, and a
// constraint of a class is resolved to an assumption or an instance; and the
// prelude's classes expanded the way `types/expand.rs` gives the signatures,
// in the proof language (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」).

mutual {
  pub fn term_mentions(t: SurfaceTerm, name: Text): Bool {
    ⊢ Bool from match t {
      SurfaceTermIndexedMk(k, start, end, ast_occurrence) => kind_mentions(k, name)
    }
  }

  pub fn kind_mentions(k: SurfaceKind, name: Text): Bool {
    ⊢ Bool from match k {
      SkVar(v) => v == name
      SkApp(f, args) => term_mentions(f, name) || terms_mention(args, name)
      SkPi(params, result, effects) => params_mention(params, name) || term_mentions(result, name)
      SkBorrow(m, x) => term_mentions(x, name)
      SkFnKind(fk, x) => term_mentions(x, name)
      SkTagged(tag, x) => term_mentions(x, name)
      SkUnion(parts) => terms_mention(parts, name)
      SkProduct(parts) => terms_mention(parts, name)
      SkField(x, field) => term_mentions(x, name)
      SkExists(binder, domain, body) => term_mentions(domain, name) || term_mentions(body, name)
      _ => false
    }
  }

  pub fn terms_mention(ts: List(SurfaceTerm), name: Text): Bool {
    ⊢ Bool from match ts {
      Nil => false
      Cons(t, rest) => term_mentions(t, name) || terms_mention(rest, name)
    }
  }

  pub fn params_mention(ps: List(SurfaceParam), name: Text): Bool {
    ⊢ Bool from match ps {
      Nil => false
      Cons(p, rest) => param_mentions(p, name) || params_mention(rest, name)
    }
  }

  pub fn param_mentions(p: SurfaceParam, name: Text): Bool {
    ⊢ Bool from match p {
      SurfaceParamMk(n, ty) => term_mentions(ty, name)
    }
  }
}

pub fn opt_terms_mention(ts: List(Option(SurfaceTerm)), name: Text): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(t, rest) => ⊢ Bool from match t {
      Some(x) => term_mentions(x, name) || opt_terms_mention(rest, name)
      None => opt_terms_mention(rest, name)
    }
  }
}

pub fn opt_term_mentions(t: Option(SurfaceTerm), name: Text): Bool {
  ⊢ Bool from match t {
    Some(x) => term_mentions(x, name)
    None => false
  }
}

// `t` with `by` in the place of each `name`; what is put in is not searched
// again.
mutual {
  pub fn term_replace(t: SurfaceTerm, name: Text, r#by: SurfaceTerm): SurfaceTerm {
    ⊢ SurfaceTerm from match t {
      SurfaceTermIndexedMk(k, start, end, ast_occurrence) => ⊢ SurfaceTerm from match k {
        SkVar(v) => if v == name { r#by } else { surface_term_mk(k, start, end) }
        _ => surface_term_mk(kind_replace(k, name, r#by), start, end)
      }
    }
  }

  pub fn kind_replace(k: SurfaceKind, name: Text, r#by: SurfaceTerm): SurfaceKind {
    ⊢ SurfaceKind from match k {
      SkApp(f, args) => SkApp(term_replace(f, name, r#by), terms_replace(args, name, r#by))
      SkPi(params, result, effects) => SkPi(
        params_replace(params, name, r#by),
        term_replace(result, name, r#by),
        effects
      )
      SkBorrow(m, x) => SkBorrow(m, term_replace(x, name, r#by))
      SkFnKind(fk, x) => SkFnKind(fk, term_replace(x, name, r#by))
      SkTagged(tag, x) => SkTagged(tag, term_replace(x, name, r#by))
      SkUnion(parts) => SkUnion(terms_replace(parts, name, r#by))
      SkProduct(parts) => SkProduct(terms_replace(parts, name, r#by))
      SkField(x, field) => SkField(term_replace(x, name, r#by), field)
      SkExists(binder, domain, body) => SkExists(
        binder,
        term_replace(domain, name, r#by),
        term_replace(body, name, r#by)
      )
      _ => k
    }
  }

  pub fn terms_replace(ts: List(SurfaceTerm), name: Text, r#by: SurfaceTerm): List(SurfaceTerm) {
    ⊢ List(SurfaceTerm) from match ts {
      Nil => Nil
      Cons(t, rest) => Cons(term_replace(t, name, r#by), terms_replace(rest, name, r#by))
    }
  }

  pub fn params_replace(ps: List(SurfaceParam), name: Text, r#by: SurfaceTerm): List(SurfaceParam) {
    ⊢ List(SurfaceParam) from match ps {
      Nil => Nil
      Cons(p, rest) => Cons(param_replace(p, name, r#by), params_replace(rest, name, r#by))
    }
  }

  pub fn param_replace(p: SurfaceParam, name: Text, r#by: SurfaceTerm): SurfaceParam {
    ⊢ SurfaceParam from match p {
      SurfaceParamMk(n, ty) => SurfaceParamMk(n, term_replace(ty, name, r#by))
    }
  }
}

pub fn opt_terms_replace(
  ts: List(Option(SurfaceTerm)),
  name: Text,
  r#by: SurfaceTerm
): List(Option(SurfaceTerm)) {
  ⊢ List(Option(SurfaceTerm)) from match ts {
    Nil => Nil
    Cons(t, rest) => Cons(⊢ Option(SurfaceTerm) from match t {
      Some(x) => Some(term_replace(x, name, r#by))
      None => None
    }, opt_terms_replace(rest, name, r#by))
  }
}

pub fn opt_term_replace(
  t: Option(SurfaceTerm),
  name: Text,
  r#by: SurfaceTerm
): Option(SurfaceTerm) {
  ⊢ Option(SurfaceTerm) from match t {
    Some(x) => Some(term_replace(x, name, r#by))
    None => None
  }
}

pub fn surface_at(k: SurfaceKind, start: Nat, end: Nat): SurfaceTerm {
  surface_term_mk(k, start, end)
}

pub fn surface_unit_type(): SurfaceTerm {
  surface_at(SkApp(surface_at(SkVar("Tuple"), 0, 0), Nil), 0, 0)
}

pub fn opts_resize<A>(n: Nat, xs: List(Option(A))): List(Option(A)) {
  ⊢ List(Option(A)) from match n {
    Zero => Nil
    Succ(m) => ⊢ List(Option(A)) from match xs {
      Nil => Cons(None, opts_resize(m, Nil))
      Cons(x, rest) => Cons(x, opts_resize(m, rest))
    }
  }
}

pub fn text_list_has(xs: List(Text), x: Text): Bool {
  ⊢ Bool from match xs {
    Nil => false
    Cons(y, rest) => y == x || text_list_has(rest, x)
  }
}

pub fn opt_bool_eq(a: Option(Bool), b: Option(Bool)): Bool {
  ⊢ Bool from match a {
    None => ⊢ Bool from match b {
      None => true
      Some(y) => false
    }
    Some(x) => ⊢ Bool from match b {
      None => false
      Some(y) => x == y
    }
  }
}

pub fn borrows_eq(a: List(Option(Bool)), b: List(Option(Bool))): Bool {
  ⊢ Bool from match a {
    Nil => ⊢ Bool from match b {
      Nil => true
      Cons(y, more) => false
    }
    Cons(x, rest) => ⊢ Bool from match b {
      Nil => false
      Cons(y, more) => opt_bool_eq(x, y) && borrows_eq(rest, more)
    }
  }
}

// `C.m@H`: the function an instance of `C` for `H` gives `m`.
pub fn instance_fn(r#class: Text, method: Text, head: Text): Text {
  cat5(r#class, ".", method, "@", head)
}

pub fn instance_key(r#class: Text, ctor: Text): Text {
  cat3(r#class, " ", ctor)
}

// The type constructor at the head of a type, as the instance table keys it.
pub fn ty_constructor(t: Ty): Option(Text) {
  ⊢ Option(Text) from match t {
    TyNamed(n, args) => Some(n)
    TyInt(w) => Some(ty_show(t))
    TyBool => Some(ty_show(t))
    TyText => Some(ty_show(t))
    TyFloat => Some(ty_show(t))
    TyDecimal => Some(ty_show(t))
    TyUnit => Some(ty_show(t))
    _ => None
  }
}

// The name an instance's head gives its functions (`expand.rs`).
pub fn head_name(t: SurfaceTerm): Text {
  ⊢ Text from match t.kind {
    SkVar(n) => n
    SkApp(f, args) => ⊢ Text from match f.kind {
      SkVar(n) => n
      _ => ""
    }
    _ => ""
  }
}

pub fn span_at(start: Nat, end: Nat): TySpan {
  TySpan { start: start, end: end }
}

pub fn class_named(cs: List(SurfaceClass), name: Text): Option(SurfaceClass) {
  ⊢ Option(SurfaceClass) from match cs {
    Nil => None
    Cons(c, rest) => if c.name == name { Some(c) } else { class_named(rest, name) }
  }
}

pub fn stmts_classes(ss: List(SurfaceStmt)): List(SurfaceClass) {
  ⊢ List(SurfaceClass) from match ss {
    Nil => Nil
    Cons(s, rest) => ⊢ List(SurfaceClass) from match s {
      StClass(c) => Cons(c, stmts_classes(rest))
      _ => stmts_classes(rest)
    }
  }
}

// A method's parameter types with `by` for the class's parameter, each
// borrowed as the method borrows it.
pub fn method_params(
  ts: List(Option(SurfaceTerm)),
  borrows: List(Option(Bool)),
  param: Text,
  r#by: SurfaceTerm
): List(SurfaceParam) {
  ⊢ List(SurfaceParam) from match ts {
    Nil => Nil
    Cons(t, rest) => {
      let written: SurfaceTerm := ⊢ SurfaceTerm from match t {
        Some(x) => term_replace(x, param, r#by)
        None => surface_unit_type()
      }
      let ty: SurfaceTerm := ⊢ SurfaceTerm from match list_head_or_none(borrows) {
        Some(m) => surface_at(SkBorrow(m, written), 0, 0)
        None => written
      }
      Cons(SurfaceParamMk(None, ty), method_params(rest, List::tail(borrows), param, r#by))
    }
  }
}

// The method's own type generics make the dictionary polymorphic: the
// binders `(A: Shared, B: Type, …)` lead.
pub fn method_binders(gs: List(Text), bounds: List(Option(Text))): List(SurfaceParam) {
  ⊢ List(SurfaceParam) from match gs {
    Nil => Nil
    Cons(g, rest) => {
      let more := method_binders(rest, List::tail(bounds))
      ⊢ List(SurfaceParam) from match list_head_or_none(bounds) {
        None => Cons(SurfaceParamMk(Some(g), surface_at(SkVar("affine"), 0, 0)), more)
        Some(b) => ⊢ List(SurfaceParam) from match kind_parse(b) {
          Some(k) => Cons(SurfaceParamMk(Some(g), surface_at(SkVar(b), 0, 0)), more)
          None => more
        }
      }
    }
  }
}

pub fn method_type(r#class: SurfaceClass, m: SurfaceFn, r#by: SurfaceTerm): SurfaceTerm {
  let result: SurfaceTerm := ⊢ SurfaceTerm from match m.result {
    Some(r) => term_replace(r, r#class.param, r#by)
    None => surface_unit_type()
  }
  surface_at(
    SkPi(
      List::append(
        method_binders(m.generics, m.bounds),
        method_params(m.param_types, m.borrows, r#class.param, r#by)
      ),
      result,
      m.effects
    ),
    0,
    0
  )
}

// The parameters that stand for one constraint: one for each method.
pub(open) inductive Added: Type {
  AddedMk(
    params: List(Text),
    param_types: List(Option(SurfaceTerm)),
    borrows: List(Option(Bool))
  ): Added
}

pub fn added_methods(
  ms: List(SurfaceFn),
  r#class: SurfaceClass,
  g: Text,
  r#by: SurfaceTerm,
  acc: Added
): Added {
  ⊢ Added from match ms {
    Nil => acc
    Cons(m, rest) => added_methods(
      rest,
      r#class,
      g,
      r#by,
      Added {
        params: List::append(acc.params, Cons(cat5(r#class.name, ".", m.name, "@", g), Nil)),
        param_types: List::append(acc.param_types, Cons(Some(method_type(r#class, m, r#by)), Nil)),
        borrows: List::append(acc.borrows, Cons(None, Nil))
      }
    )
  }
}

pub fn added_constraints(ws: List(SurfaceConstraint), cs: List(SurfaceClass), acc: Added): Added {
  ⊢ Added from match ws {
    Nil => acc
    Cons(w, rest) => ⊢ Added from match w.ty.kind {
      SkVar(g) => ⊢ Added from match class_named(cs, w.r#class) {
        Some(r#class) => added_constraints(
          rest,
          cs,
          added_methods(r#class.methods, r#class, g, w.ty, acc)
        )
        None => added_constraints(rest, cs, acc)
      }
      _ => added_constraints(rest, cs, acc)
    }
  }
}

pub fn structural_constraints(ws: List(SurfaceConstraint)): List(SurfaceConstraint) {
  ⊢ List(SurfaceConstraint) from match ws {
    Nil => Nil
    Cons(w, rest) => if class_is_structural(w.r#class) {
      Cons(w, structural_constraints(rest))
    } else {
      structural_constraints(rest)
    }
  }
}

// A call `C.m(…)` of a class's method made a call of a name: for the use
// check (`rows.rs`) the expansion's call of the method's argument or of the
// instance's function performs what the method's type says, which for the
// prelude's classes is nothing.
pub fn method_callee(f: SurfaceTerm, classes: List(Text)): SurfaceTerm {
  ⊢ SurfaceTerm from match f.kind {
    SkField(base, name) => ⊢ SurfaceTerm from match base.kind {
      SkVar(cn) => if text_list_has(classes, cn) {
        surface_at(SkVar(cat3(cn, ".", name)), f.start, f.end)
      } else {
        f
      }
      _ => f
    }
    _ => f
  }
}

mutual {
  pub fn cls_term(t: SurfaceTerm, classes: List(Text)): SurfaceTerm {
    ⊢ SurfaceTerm from match t {
      SurfaceTermIndexedMk(k, start, end, ast_occurrence) => surface_term_mk(
        cls_kind(k, classes),
        start,
        end
      )
    }
  }

  pub fn cls_kind(k: SurfaceKind, classes: List(Text)): SurfaceKind {
    ⊢ SurfaceKind from match k {
      SkApp(f, args) => SkApp(
        method_callee(cls_term(f, classes), classes),
        cls_terms(args, classes)
      )
      SkLam(params, body) => SkLam(params, cls_term(body, classes))
      SkBorrowLam(borrows, lam) => SkBorrowLam(borrows, cls_term(lam, classes))
      SkBorrow(m, x) => SkBorrow(m, cls_term(x, classes))
      SkTagged(tag, x) => SkTagged(tag, cls_term(x, classes))
      SkRecord(name, fields) => SkRecord(name, cls_fields(fields, classes))
      SkIf(c, th, el) => SkIf(cls_term(c, classes), cls_term(th, classes), cls_opt(el, classes))
      SkField(base, name) => SkField(cls_term(base, classes), name)
      SkPerform(eff, args) => SkPerform(eff, cls_terms(args, classes))
      SkBudget(steps_memory, steps, body) => SkBudget(
        steps_memory,
        cls_term(steps, classes),
        cls_term(body, classes)
      )
      SkBlock(stmts) => SkBlock(cls_stmts(stmts, classes))
      SkHandle(body, handlers) => SkHandle(cls_term(body, classes), cls_handlers(handlers, classes))
      SkMatch(scrutinee, r, arms, binder) => SkMatch(
        cls_term(scrutinee, classes),
        r,
        cls_arms(arms, classes),
        binder
      )
      _ => k
    }
  }

  pub fn cls_terms(ts: List(SurfaceTerm), classes: List(Text)): List(SurfaceTerm) {
    ⊢ List(SurfaceTerm) from match ts {
      Nil => Nil
      Cons(t, rest) => Cons(cls_term(t, classes), cls_terms(rest, classes))
    }
  }

  pub fn cls_opt(t: Option(SurfaceTerm), classes: List(Text)): Option(SurfaceTerm) {
    ⊢ Option(SurfaceTerm) from match t {
      None => None
      Some(x) => Some(cls_term(x, classes))
    }
  }

  pub fn cls_fields(fs: List(SurfaceField), classes: List(Text)): List(SurfaceField) {
    ⊢ List(SurfaceField) from match fs {
      Nil => Nil
      Cons(f, rest) => Cons(cls_field(f, classes), cls_fields(rest, classes))
    }
  }

  pub fn cls_field(f: SurfaceField, classes: List(Text)): SurfaceField {
    ⊢ SurfaceField from match f {
      SurfaceFieldMk(name, value) => SurfaceFieldMk(name, cls_term(value, classes))
    }
  }

  pub fn cls_handlers(hs: List(SurfaceHandler), classes: List(Text)): List(SurfaceHandler) {
    ⊢ List(SurfaceHandler) from match hs {
      Nil => Nil
      Cons(h, rest) => Cons(cls_handler(h, classes), cls_handlers(rest, classes))
    }
  }

  pub fn cls_handler(h: SurfaceHandler, classes: List(Text)): SurfaceHandler {
    ⊢ SurfaceHandler from match h {
      HdReturn(p, body) => HdReturn(p, cls_term(body, classes))
      HdOperation(eff, hfa, hty, ps, cont, guard, body) => HdOperation(
        eff,
        hfa,
        hty,
        ps,
        cont,
        cls_opt(guard, classes),
        cls_term(body, classes)
      )
    }
  }

  pub fn cls_arms(arms: List(SurfaceArm), classes: List(Text)): List(SurfaceArm) {
    ⊢ List(SurfaceArm) from match arms {
      Nil => Nil
      Cons(a, rest) => Cons(cls_arm(a, classes), cls_arms(rest, classes))
    }
  }

  pub fn cls_arm(a: SurfaceArm, classes: List(Text)): SurfaceArm {
    ⊢ SurfaceArm from match a {
      SurfaceArmMk(pattern, guard, goal, body) => SurfaceArmMk(
        pattern,
        cls_opt(guard, classes),
        goal,
        cls_term(body, classes)
      )
    }
  }

  pub fn cls_stmts(ss: List(SurfaceStmt), classes: List(Text)): List(SurfaceStmt) {
    ⊢ List(SurfaceStmt) from match ss {
      Nil => Nil
      Cons(st, rest) => Cons(cls_stmt(st, classes), cls_stmts(rest, classes))
    }
  }

  pub fn cls_stmt(st: SurfaceStmt, classes: List(Text)): SurfaceStmt {
    ⊢ SurfaceStmt from match st {
      StLet(name, ty, value, b, bm) => StLet(name, ty, cls_term(value, classes), b, bm)
      StVar(name, ty, value, vb) => StVar(name, ty, cls_term(value, classes), vb)
      StAssign(name, name_place, value) => StAssign(
        name,
        cls_opt(name_place, classes),
        cls_term(value, classes)
      )
      StWhile(c, body) => StWhile(cls_term(c, classes), cls_term(body, classes))
      StReturn(e) => StReturn(cls_opt(e, classes))
      StExpr(e) => StExpr(cls_term(e, classes))
      _ => st
    }
  }
}

pub fn class_names(cs: List(SurfaceClass)): List(Text) {
  ⊢ List(Text) from match cs {
    Nil => Nil
    Cons(c, rest) => Cons(c.name, class_names(rest))
  }
}

// A function that asks for a class takes the class's methods, after its own
// parameters.
pub fn expand_fn(f: SurfaceFn, cs: List(SurfaceClass)): SurfaceFn {
  let a: Added := added_constraints(
    f.wheres,
    cs,
    Added { params: Nil, param_types: Nil, borrows: Nil }
  )
  SurfaceFn {
    name: f.name,
    generics: f.generics,
    bounds: f.bounds,
    params: List::append(f.params, a.params),
    borrows: List::append(f.borrows, a.borrows),
    param_types: List::append(f.param_types, a.param_types),
    result: f.result,
    effects: f.effects,
    wheres: structural_constraints(f.wheres),
    start: f.start,
    end: f.end,
    body: cls_term(f.body, class_names(cs)),
    generic_types: f.generic_types
  }
}

// The function an instance gives a method, over the instance's generics,
// asking for what the instance's `where` asks.
pub fn instance_method(i: SurfaceInstance, m: SurfaceFn, head: Text): SurfaceFn {
  SurfaceFn {
    name: instance_fn(i.r#class, m.name, head),
    generics: List::append(i.generics, m.generics),
    bounds: List::append(
      opts_resize(list_len(i.generics), i.bounds),
      opts_resize(list_len(m.generics), m.bounds)
    ),
    params: m.params,
    borrows: m.borrows,
    param_types: m.param_types,
    result: m.result,
    effects: m.effects,
    wheres: i.wheres,
    start: m.start,
    end: m.end,
    body: m.body,
    generic_types: List::append(surface_type_generics(i.generics), m.generic_types)
  }
}

pub fn expand_instance(
  i: SurfaceInstance,
  ms: List(SurfaceFn),
  cs: List(SurfaceClass),
  rest: List(SurfaceStmt)
): List(SurfaceStmt) {
  ⊢ List(SurfaceStmt) from match ms {
    Nil => rest
    Cons(m, more) => Cons(
      StFn(expand_fn(instance_method(i, m, head_name(i.head)), cs)),
      expand_instance(i, more, cs, rest)
    )
  }
}

pub fn expand_stmts(ss: List(SurfaceStmt), cs: List(SurfaceClass)): List(SurfaceStmt) {
  ⊢ List(SurfaceStmt) from match ss {
    Nil => Nil
    Cons(s, rest) => ⊢ List(SurfaceStmt) from match s {
      StClass(c) => expand_stmts(rest, cs)
      StInstance(i) => expand_instance(i, i.methods, cs, expand_stmts(rest, cs))
      StFn(f) => Cons(StFn(expand_fn(f, cs)), expand_stmts(rest, cs))
      _ => Cons(s, expand_stmts(rest, cs))
    }
  }
}

pub fn classes_expand_prelude(ss: List(SurfaceStmt)): List(SurfaceStmt) {
  ⊢ List(SurfaceStmt) from match stmts_classes(ss) {
    Nil => ss
    Cons(c, rest) => expand_stmts(ss, Cons(c, rest))
  }
}

pub fn stmts_class_names(ss: List(SurfaceStmt)): List(Text) {
  ⊢ List(Text) from match ss {
    Nil => Nil
    Cons(s, rest) => ⊢ List(Text) from match s {
      StClass(c) => Cons(c.name, stmts_class_names(rest))
      _ => stmts_class_names(rest)
    }
  }
}

pub fn stmts_type_names(ss: List(SurfaceStmt)): List(Text) {
  ⊢ List(Text) from match ss {
    Nil => Nil
    Cons(s, rest) => ⊢ List(Text) from match s {
      StStruct(d) => Cons(d.name, stmts_type_names(rest))
      StEnum(d) => Cons(d.name, stmts_type_names(rest))
      _ => stmts_type_names(rest)
    }
  }
}

pub fn method_names_have(ms: List(SurfaceFn), name: Text): Bool {
  ⊢ Bool from match ms {
    Nil => false
    Cons(m, rest) => m.name == name || method_names_have(rest, name)
  }
}

pub fn method_named(ms: List(SurfaceFn), name: Text): Option(SurfaceFn) {
  ⊢ Option(SurfaceFn) from match ms {
    Nil => None
    Cons(m, rest) => if m.name == name { Some(m) } else { method_named(rest, name) }
  }
}

pub fn law_named(ls: List(SurfaceLaw), name: Text): Bool {
  ⊢ Bool from match ls {
    Nil => false
    Cons(l, rest) => l.name == name || law_named(rest, name)
  }
}

// A law is a statement about the methods, and a method that performs effects
// has none.
pub fn ck_law_methods(ms: List(SurfaceFn), &mut c: Checker, cl: SurfaceClass): Unit {
  ⊢ Unit from match ms {
    Nil => #()
    Cons(m, rest) => {
      ⊢ Unit from match m.effects {
        Some(es) => ⊢ Unit from match es {
          Cons(e, more) => ck_error(
            &mut c,
            cat5(
              cl.name,
              ".",
              m.name,
              " performs effects, so ",
              cat2(cl.name, " cannot have laws")
            ),
            span_at(m.start, m.end)
          )
          Nil => #()
        }
        None => #()
      }
      ck_law_methods(rest, &mut c, cl)
    }
  }
}

pub fn ck_class_laws_each(
  ls: List(SurfaceLaw),
  seen: List(Text),
  &mut c: Checker,
  cl: SurfaceClass
): Unit {
  ⊢ Unit from match ls {
    Nil => #()
    Cons(l, rest) => if text_list_has(seen, l.name) {
      ck_error(&mut c, cat4(cl.name, ".", l.name, " is declared twice"), span_at(l.start, l.end))
      ck_class_laws_each(rest, seen, &mut c, cl)
    } else {
      ck_class_laws_each(rest, Cons(l.name, seen), &mut c, cl)
    }
  }
}

pub fn ck_class_laws(&mut c: Checker, cl: SurfaceClass): Unit {
  ⊢ Unit from match cl.laws {
    Nil => #()
    Cons(l, rest) => ck_law_methods(cl.methods, &mut c, cl)
  }
  ck_class_laws_each(cl.laws, Nil, &mut c, cl)
}

// Each law of an instance is one of the class's, written once.
pub fn ck_instance_laws(
  ls: List(SurfaceLaw),
  seen: List(Text),
  &mut c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): Unit {
  ⊢ Unit from match ls {
    Nil => #()
    Cons(l, rest) => if not(law_named(decl.laws, l.name)) {
      ck_error(&mut c, cat3(i.r#class, " has no law ", l.name), span_at(l.start, l.end))
      ck_instance_laws(rest, seen, &mut c, i, decl)
    } else if text_list_has(seen, l.name) {
      ck_error(
        &mut c,
        cat3("the law ", l.name, " of the instance is written twice"),
        span_at(l.start, l.end)
      )
      ck_instance_laws(rest, seen, &mut c, i, decl)
    } else {
      ck_instance_laws(rest, Cons(l.name, seen), &mut c, i, decl)
    }
  }
}

// Each method: declared once, with no `where`, mentioning the parameter.
pub fn ck_class_methods(
  ms: List(SurfaceFn),
  seen: List(Text),
  &mut c: Checker,
  cl: SurfaceClass
): Unit {
  ⊢ Unit from match ms {
    Nil => #()
    Cons(m, rest) => {
      let span := span_at(m.start, m.end)
      if text_list_has(seen, m.name) {
        ck_error(&mut c, cat4(cl.name, ".", m.name, " is declared twice"), span)
      }
      ⊢ Unit from match m.wheres {
        Nil => #()
        Cons(w, more) => ck_error(
          &mut c,
          cat4(cl.name, ".", m.name, " has no where: write it outside the class"),
          span
        )
      }
      if not(opt_terms_mention(m.param_types, cl.param) || opt_term_mentions(m.result, cl.param)) {
        ck_error(&mut c, cat5(cl.name, ".", m.name, " does not mention ", cl.param), span)
      }
      ck_class_methods(rest, Cons(m.name, seen), &mut c, cl)
    }
  }
}

// The kind the class's parameter makes, and for a class of type
// constructors, the kind it takes.
pub fn ck_class_bound(&mut c: Checker, cl: SurfaceClass): Option(Pair(Kind, Option(Kind))) {
  ⊢ Option(Pair(Kind, Option(Kind))) from match cl.bound {
    None => Some(Pair { fst: KindAffine, snd: None })
    Some(b) => ⊢ Option(Pair(Kind, Option(Kind))) from match kind_parse(b) {
      Some(k) => Some(Pair { fst: k, snd: None })
      None => ⊢ Option(Pair(Kind, Option(Kind))) from match kind_parse_ctor(b) {
        Some(ak) => Some(Pair { fst: ak.snd, snd: Some(ak.fst) })
        None => {
          ck_error(&mut c, cat2(b, " is not a kind"), span_at(cl.start, cl.end))
          None
        }
      }
    }
  }
}

pub fn ck_declare_class(&mut c: Checker, cl: SurfaceClass, own_types: List(Text)): Bool {
  let span := span_at(cl.start, cl.end)
  if class_is_structural(cl.name) {
    ck_error(&mut c, cat2(cl.name, " is built in"), span)
    false
  } else if Ordmap::contains(c.classes, cl.name, Ordmap::compare_text) {
    ck_error(&mut c, cat3("class ", cl.name, " is declared twice"), span)
    false
  } else if text_list_has(own_types, cl.name) {
    ck_error(&mut c, cat2(cl.name, " is already a type"), span)
    false
  } else if not(cl.arity == 1) {
    ck_error(
      &mut c,
      cat4("class ", cl.name, " takes one parameter, not ", Text::of_nat(cl.arity)),
      span
    )
    false
  } else {
    ⊢ Bool from match ck_class_bound(&mut c, cl) {
      None => false
      Some(bound) => {
        ck_class_methods(cl.methods, Nil, &mut c, cl)
        ck_class_laws(&mut c, cl)
        set_to(
          &mut c.classes,
          Ordmap::insert(
            c.classes,
            cl.name,
            ClassInfo { decl: cl, bound: bound.fst, arg: bound.snd },
            Ordmap::compare_text
          )
        )
        true
      }
    }
  }
}

// The bound of the class's parameter as written: `(arg)->bound` for a class
// of type constructors.
pub fn class_param_bound(info: ClassInfo): Text {
  ⊢ Text from match info.arg {
    None => kind_name(info.bound)
    Some(arg) => Text::concat_all(
      Cons("(", Cons(kind_name(arg), Cons(")->", Cons(kind_name(info.bound), Nil))))
    )
  }
}

// `C.m`: a function over the class's parameter that asks for the class.
pub fn ck_declare_methods_each(
  ms: List(SurfaceFn),
  &mut c: Checker,
  cl: SurfaceClass,
  info: ClassInfo
): Unit {
  ⊢ Unit from match ms {
    Nil => #()
    Cons(m, rest) => {
      let f := SurfaceFn {
        name: cat3(cl.name, ".", m.name),
        generics: Cons(cl.param, m.generics),
        bounds: Cons(Some(class_param_bound(info)), opts_resize(list_len(m.generics), m.bounds)),
        params: m.params,
        borrows: m.borrows,
        param_types: m.param_types,
        result: m.result,
        effects: m.effects,
        wheres: Cons(
          SurfaceConstraint {
            r#class: cl.name,
            ty: surface_at(SkVar(cl.param), m.start, m.end),
            start: m.start,
            end: m.end,
            arguments: surface_class_tail_vars(cl.parameters, m.start, m.end)
          },
          Nil
        ),
        start: m.start,
        end: m.end,
        body: m.body,
        generic_types: Cons(surface_type_generic(), m.generic_types)
      }
      let scheme := ck_signature(&mut c, f)
      set_to(&mut c.fns, Ordmap::insert(c.fns, f.name, scheme, Ordmap::compare_text))
      ck_declare_methods_each(rest, &mut c, cl, info)
    }
  }
}

pub fn ck_declare_methods(cls: List(SurfaceClass), &mut c: Checker): Unit {
  ⊢ Unit from match cls {
    Nil => #()
    Cons(cl, rest) => {
      ⊢ Unit from match Ordmap::get(c.classes, cl.name, Ordmap::compare_text) {
        Some(info) => ck_declare_methods_each(cl.methods, &mut c, cl, info)
        None => #()
      }
      ck_declare_methods(rest, &mut c)
    }
  }
}

pub fn ck_declare_class_list(
  ss: List(SurfaceStmt),
  &mut c: Checker,
  own_types: List(Text)
): List(SurfaceClass) {
  ⊢ List(SurfaceClass) from match ss {
    Nil => Nil
    Cons(s, rest) => ⊢ List(SurfaceClass) from match s {
      StClass(cl) => {
        let ok := ck_declare_class(&mut c, cl, own_types)
        let tl := ck_declare_class_list(rest, &mut c, own_types)
        if ok { Cons(cl, tl) } else { tl }
      }
      _ => ck_declare_class_list(rest, &mut c, own_types)
    }
  }
}

// The generics of an instance with their kinds, in order, and the map from
// their names to type parameters.
pub fn instance_generics(
  gs: List(Text),
  bounds: List(Option(Text)),
  acc: SigGenerics
): SigGenerics {
  ⊢ SigGenerics from match gs {
    Nil => SigGenerics { generics: List::reverse(acc.generics), map: acc.map, ctors: acc.ctors }
    Cons(g, rest) => {
      let k: Kind := ⊢ Kind from match list_head_or_none(bounds) {
        Some(b) => ⊢ Kind from match kind_parse(b) {
          Some(x) => x
          None => KindAffine
        }
        None => KindAffine
      }
      instance_generics(
        rest,
        List::tail(bounds),
        SigGenerics {
          generics: Cons(Pair { fst: g, snd: k }, acc.generics),
          map: Ordmap::insert(acc.map, g, TyParam(g, k), Ordmap::compare_text),
          ctors: acc.ctors
        }
      )
    }
  }
}

// Each argument is a generic of the instance, and no generic is written twice.
pub fn head_args_ok(args: List(SurfaceTerm), gs: List(Text), before: List(Text)): Bool {
  ⊢ Bool from match args {
    Nil => true
    Cons(a, rest) => ⊢ Bool from match a.kind {
      SkVar(g) => text_list_has(
        gs,
        g
      ) && not(text_list_has(before, g)) && head_args_ok(rest, gs, Cons(g, before))
      _ => false
    }
  }
}

// The head: a type with no arguments, or a type constructor applied to
// distinct generics.
pub fn head_shape_ok(head: SurfaceTerm, gs: List(Text)): Bool {
  ⊢ Bool from match head.kind {
    SkVar(v) => not(text_list_has(gs, v))
    SkApp(f, args) => ⊢ Bool from match f.kind {
      SkVar(n) => head_args_ok(args, gs, Nil)
      _ => false
    }
    _ => false
  }
}

pub fn generic_not_in_head(gs: List(Text), head: SurfaceTerm): Option(Text) {
  ⊢ Option(Text) from match gs {
    Nil => None
    Cons(g, rest) => if term_mentions(head, g) { generic_not_in_head(rest, head) } else { Some(g) }
  }
}

pub fn ck_instance_preds(
  ws: List(SurfaceConstraint),
  &mut c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text))
): List(Pair(Text, Text)) {
  ⊢ List(Pair(Text, Text)) from match ws {
    Nil => List::reverse(preds)
    Cons(w, rest) => {
      let span := span_at(w.start, w.end)
      if not(
        class_is_structural(w.r#class)
      ) && not(Ordmap::contains(c.classes, w.r#class, Ordmap::compare_text)) {
        ck_error(&mut c, cat2(w.r#class, " is not a class"), span)
        ck_instance_preds(rest, &mut c, gs, preds)
      } else {
        ⊢ List(Pair(Text, Text)) from match constraint_single_type(w).kind {
          SkVar(g) => if text_list_has(gs, g) {
            if preds_have(preds, w.r#class, g) {
              ck_error(&mut c, cat5(w.r#class, "(", g, ") is written twice", ""), span)
              ck_instance_preds(rest, &mut c, gs, preds)
            } else {
              ck_instance_preds(rest, &mut c, gs, Cons(Pair { fst: w.r#class, snd: g }, preds))
            }
          } else {
            ck_error(&mut c, "where constrains only generics of the instance", span)
            ck_instance_preds(rest, &mut c, gs, preds)
          }
          _ => {
            ck_error(&mut c, "where constrains only generics of the instance", span)
            ck_instance_preds(rest, &mut c, gs, preds)
          }
        }
      }
    }
  }
}

pub fn borrow_prefix(b: Option(Bool)): Text {
  ⊢ Text from match b {
    Some(m) => if m { "&mut " } else { "&" }
    None => ""
  }
}

pub fn list_head_or_none_ty(ts: List(Ty)): Option(Ty) {
  ⊢ Option(Ty) from match ts {
    Nil => None
    Cons(t, rest) => Some(t)
  }
}

// `p: T` for each parameter the class's signature gives the method.
pub fn shown_params(
  ps: List(Text),
  borrows: List(Option(Bool)),
  tys: List(Ty),
  c: Checker
): List(Text) {
  ⊢ List(Text) from match ps {
    Nil => Nil
    Cons(p, rest) => {
      let ty: Text := ⊢ Text from match list_head_or_none_ty(tys) {
        Some(t) => ty_show(ck_shown(&c, ty_unborrowed(t)))
        None => ""
      }
      Cons(
        cat4(borrow_prefix(list_head_or_none(borrows)), p, ": ", ty),
        shown_params(rest, List::tail(borrows), List::tail(tys), c)
      )
    }
  }
}

// The instance's method has the class's signature, the head in the place of
// the parameter.
pub fn ck_same_signature(
  &mut c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  param: Text,
  head: Text
): Unit {
  let want := SurfaceFn {
    name: got.name,
    generics: List::append(i.generics, expected.generics),
    bounds: List::append(
      opts_resize(list_len(i.generics), i.bounds),
      opts_resize(list_len(expected.generics), expected.bounds)
    ),
    params: expected.params,
    borrows: expected.borrows,
    param_types: opt_terms_replace(expected.param_types, param, i.head),
    result: opt_term_replace(expected.result, param, i.head),
    effects: expected.effects,
    wheres: i.wheres,
    start: expected.start,
    end: expected.end,
    body: expected.body,
    generic_types: List::append(surface_type_generics(i.generics), expected.generic_types)
  }
  let wanted := ck_signature(&mut c, want)
  if not(ty_eq(wanted.ty, scheme.ty)) || not(borrows_eq(got.borrows, want.borrows)) {
    let tys: List(Ty) := ⊢ List(Ty) from match wanted.ty {
      TyFn(ps, r, k) => ps
      _ => Nil
    }
    ck_error(
      &mut c,
      cat5(
        i.r#class,
        ".",
        expected.name,
        cat3(" of ", head, " takes "),
        text_join(shown_params(want.params, want.borrows, tys, c), ", ")
      ),
      span_at(got.start, got.end)
    )
  }
}

pub fn ck_instance_methods(
  expected: List(SurfaceFn),
  &mut c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn)
): List(SurfaceFn) {
  ⊢ List(SurfaceFn) from match expected {
    Nil => out
    Cons(e, rest) => ⊢ List(SurfaceFn) from match method_named(i.methods, e.name) {
      None => {
        ck_error(
          &mut c,
          cat5("the instance ", i.r#class, cat3("(", shown, ")"), " does not define ", e.name),
          span_at(i.start, i.end)
        )
        ck_instance_methods(rest, &mut c, i, decl, ctor, shown, out)
      }
      Some(m) => {
        let f := SurfaceFn {
          name: instance_fn(i.r#class, m.name, ctor),
          generics: List::append(i.generics, m.generics),
          bounds: List::append(
            opts_resize(list_len(i.generics), i.bounds),
            opts_resize(list_len(m.generics), m.bounds)
          ),
          params: m.params,
          borrows: m.borrows,
          param_types: m.param_types,
          result: m.result,
          effects: m.effects,
          wheres: i.wheres,
          start: m.start,
          end: m.end,
          body: m.body,
          generic_types: List::append(surface_type_generics(i.generics), m.generic_types)
        }
        let scheme := ck_signature(&mut c, f)
        ck_same_signature(&mut c, i, f, scheme, e, decl.param, shown)
        set_to(&mut c.fns, Ordmap::insert(c.fns, f.name, scheme, Ordmap::compare_text))
        ck_instance_methods(rest, &mut c, i, decl, ctor, shown, Cons(f, out))
      }
    }
  }
}

pub fn ck_instance_extra(
  ms: List(SurfaceFn),
  &mut c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): Unit {
  ⊢ Unit from match ms {
    Nil => #()
    Cons(m, rest) => {
      if not(method_names_have(decl.methods, m.name)) {
        ck_error(&mut c, cat3(i.r#class, " has no method ", m.name), span_at(m.start, m.end))
      }
      ck_instance_extra(rest, &mut c, i, decl)
    }
  }
}

// How many arguments a declared type is written without, when it is
// declared.
pub fn ty_missing_args(&c: Checker, head: Ty): Option(Nat) {
  ⊢ Option(Nat) from match head {
    TyNamed(n, args) => ⊢ Option(Nat) from match datas_decl(c.datas, n) {
      None => None
      Some(d) => Some(list_len(d.generics) - list_len(args))
    }
    _ => Some(0)
  }
}

pub fn ck_decl_arity(&c: Checker, n: Text): Nat {
  ⊢ Nat from match datas_decl(c.datas, n) {
    None => 0
    Some(d) => list_len(d.generics)
  }
}

pub fn ck_not_a_ctor_message(&c: Checker, i: SurfaceInstance, head: Ty): Pair(Text, TySpan) {
  Pair {
    fst: cat4(
      i.r#class,
      " takes a type constructor with one argument missing, and ",
      ty_show(ck_shown(&c, head)),
      " is not one"
    ),
    snd: span_at(i.start, i.end)
  }
}

pub fn ck_instance_kind_message(
  &c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  head: Ty
): Option(Pair(Text, TySpan)) {
  let k := datas_kind(c.datas, head)
  if kind_fits(k, info.bound) {
    None
  } else {
    Some(Pair {
      fst: cat5(
        i.r#class,
        " takes types up to ",
        kind_name(info.bound),
        cat3(", and ", ty_show(ck_shown(&c, head)), " is "),
        kind_name(k)
      ),
      snd: span_at(i.start, i.end)
    })
  }
}

pub fn ck_instance_head_message(
  &c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  head: Ty,
  ctor: Text
): Option(Pair(Text, TySpan)) {
  let span := span_at(i.start, i.end)
  ⊢ Option(Pair(Text, TySpan)) from match info.arg {
    Some(arg) => ⊢ Option(Pair(Text, TySpan)) from match ty_missing_args(&c, head) {
      Some(m) => if m == 1 {
        let made := ty_apply(head, TyParam(kind_name(arg), arg))
        let k := datas_kind(c.datas, made)
        if kind_fits(k, info.bound) {
          None
        } else {
          Some(Pair {
            fst: cat5(
              i.r#class,
              cat4(" takes constructors from ", kind_name(arg), " to ", kind_name(info.bound)),
              ", and ",
              ty_show(ck_shown(&c, made)),
              cat2(" is ", kind_name(k))
            ),
            snd: span
          })
        }
      } else {
        Some(ck_not_a_ctor_message(&c, i, head))
      }
      None => Some(ck_not_a_ctor_message(&c, i, head))
    }
    None => ⊢ Option(Pair(Text, TySpan)) from match ty_missing_args(&c, head) {
      Some(m) => if m > 0 {
        Some(Pair {
          fst: cat4(ctor, " takes ", Text::of_nat(ck_decl_arity(&c, ctor)), " arguments"),
          snd: span_at(i.head.start, i.head.end)
        })
      } else {
        ck_instance_kind_message(&c, i, info, head)
      }
      None => ck_instance_kind_message(&c, i, info, head)
    }
  }
}

pub fn ck_declare_instance_rest(
  &mut c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text
): List(SurfaceFn) {
  let span := span_at(i.start, i.end)
  if not(text_list_has(own_classes, i.r#class)) && not(text_list_has(own_types, ctor)) {
    ck_error(
      &mut c,
      cat5(
        i.r#class,
        cat3("(", ctor, ")"),
        " must be in the tote of ",
        i.r#class,
        cat2(" or of ", ctor)
      ),
      span
    )
    out
  } else if Ordmap::contains(c.instances, instance_key(i.r#class, ctor), Ordmap::compare_text) {
    ck_error(&mut c, cat3(i.r#class, " already has an instance for ", ctor), span)
    out
  } else {
    let preds := ck_instance_preds(i.wheres, &mut c, i.generics, Nil)
    ck_instance_laws(i.laws, Nil, &mut c, i, info.decl)
    let made := ck_instance_methods(info.decl.methods, &mut c, i, info.decl, ctor, shown, out)
    ck_instance_extra(i.methods, &mut c, i, info.decl)
    set_to(
      &mut c.instances,
      Ordmap::insert(
        c.instances,
        instance_key(i.r#class, ctor),
        InstanceInfo { generics: g.generics, head: head, preds: preds },
        Ordmap::compare_text
      )
    )
    made
  }
}

pub fn instance_type_generics(types: List(SurfaceTerm), bounds: List(Option(Text))): Bool {
  ⊢ Bool from match types {
    Nil => true
    Cons(ty, rest) => {
      let type_only := ⊢ Bool from match ty.kind {
        SkVar(name) => name == "Type"
        SkPi(params, result, effects) => ⊢ Bool from match bounds {
          Cons(Some(bound), more) => ⊢ Bool from match kind_parse_ctor(bound) {
            Some(kind) => true
            None => false
          }
          _ => false
        }
        _ => false
      }
      let more_bounds := ⊢ List(Option(Text)) from match bounds {
        Nil => Nil
        Cons(bound, more) => more
      }
      type_only && instance_type_generics(rest, more_bounds)
    }
  }
}

pub fn instance_legacy_shape(i: SurfaceInstance): Bool {
  ⊢ Bool from match i.arguments {
    Nil => instance_type_generics(i.generic_types, i.bounds) && head_shape_ok(i.head, i.generics)
    Cons(index, rest) => false
  }
}

pub fn ck_declare_instance_at(
  &mut c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): List(SurfaceFn) {
  let span := span_at(i.start, i.end)
  let hspan := span_at(i.head.start, i.head.end)
  let g := instance_generics(
    i.generics,
    i.bounds,
    SigGenerics { generics: Nil, map: Ordmap::empty(), ctors: Nil }
  )
  if not(instance_legacy_shape(i)) {
    ck_error(&mut c, "an instance head applies a type to distinct generics", hspan)
    out
  } else {
    ⊢ List(SurfaceFn) from match generic_not_in_head(i.generics, i.head) {
      Some(missing) => {
        ck_error(&mut c, cat2(missing, " does not appear in the head"), hspan)
        out
      }
      None => {
        set_to(&mut c.constructor_position, true)
        let head := ck_written(&mut c, i.head, g.map)
        set_to(&mut c.constructor_position, false)
        ⊢ List(SurfaceFn) from match ty_constructor(head) {
          None => {
            ck_error(&mut c, "an instance head applies a type to distinct generics", hspan)
            out
          }
          Some(ctor) => {
            let shown := ty_show(ck_shown(&c, head))
            ⊢ List(SurfaceFn) from match ck_instance_head_message(&c, i, info, head, ctor) {
              Some(m) => {
                ck_error(&mut c, m.fst, m.snd)
                out
              }
              None => ck_declare_instance_rest(
                &mut c,
                i,
                info,
                own_classes,
                own_types,
                out,
                g,
                head,
                ctor,
                shown
              )
            }
          }
        }
      }
    }
  }
}

pub fn ck_declare_instance(
  &mut c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): List(SurfaceFn) {
  let span := span_at(i.start, i.end)
  if class_is_structural(i.r#class) {
    ck_error(&mut c, cat2(i.r#class, " is structural and has no instances to write"), span)
    out
  } else {
    ⊢ List(SurfaceFn) from match Ordmap::get(c.classes, i.r#class, Ordmap::compare_text) {
      None => {
        ck_error(&mut c, cat2(i.r#class, " is not a class"), span)
        out
      }
      Some(info) => ck_declare_instance_at(&mut c, i, info, own_classes, own_types, out)
    }
  }
}

pub fn ck_declare_instances(
  ss: List(SurfaceStmt),
  &mut c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): List(SurfaceFn) {
  ⊢ List(SurfaceFn) from match ss {
    Nil => out
    Cons(s, rest) => ⊢ List(SurfaceFn) from match s {
      StInstance(i) => {
        let next := ck_declare_instance(&mut c, i, own_classes, own_types, out)
        ck_declare_instances(rest, &mut c, own_classes, own_types, next)
      }
      _ => ck_declare_instances(rest, &mut c, own_classes, own_types, out)
    }
  }
}

// The program's classes and instances (the prelude's are expanded): the
// functions its instances define, in the order they are written, to be
// checked like its own.
pub fn ck_declare_classes(&mut c: Checker, program: List(SurfaceStmt)): List(SurfaceFn) {
  let own_classes := stmts_class_names(program)
  let own_types := stmts_type_names(program)
  let declared := ck_declare_class_list(program, &mut c, own_types)
  ck_declare_methods(declared, &mut c)
  List::reverse(ck_declare_instances(program, &mut c, own_classes, own_types, Nil))
}

pub(open) inductive Unresolved: Type {
  UnresolvedUndetermined: Unresolved
  UnresolvedAssumption(shown: Text): Unresolved
  UnresolvedNoInstance(shown: Text): Unresolved
  UnresolvedNone: Unresolved
}

pub fn ty_strip_one(t: Ty): Ty {
  ⊢ Ty from match t {
    TyTagged(tags, x) => x
    TyBorrow(x, m) => x
    _ => t
  }
}

pub fn head_found(params: List(Ty), args: List(Ty), found: Ordmap(Text, Ty)): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match params {
    Nil => found
    Cons(p, prest) => ⊢ Ordmap(Text, Ty) from match args {
      Nil => found
      Cons(a, arest) => ⊢ Ordmap(Text, Ty) from match p {
        TyParam(g, k) => head_found(prest, arest, Ordmap::insert(found, g, a, Ordmap::compare_text))
        _ => head_found(prest, arest, found)
      }
    }
  }
}

pub fn ty_named_args(t: Ty): List(Ty) {
  ⊢ List(Ty) from match t {
    TyNamed(n, args) => args
    _ => Nil
  }
}

pub fn found_or_unit(found: Ordmap(Text, Ty), g: Text): Ty {
  ⊢ Ty from match Ordmap::get(found, g, Ordmap::compare_text) {
    Some(x) => x
    None => TyUnit
  }
}

// Whether `class(t)` holds (`resolve_class`): an assumption for a type
// parameter, otherwise the instance for the head of the type, and its
// `where` at the types the head was matched to. `unresolved_none` is
// success. `t` is resolved, one tag or borrow taken off.
mutual {
  pub fn ck_resolve_class_in(
    k: Nat,
    &c: Checker,
    r#class: Text,
    t: Ty,
    assume: List(Pair(Text, Text))
  ): Unresolved {
    ⊢ Unresolved from match k {
      Zero => UnresolvedUndetermined
      Succ(j) => ⊢ Unresolved from match t {
        TyParam(n, kind) => if preds_have(assume, r#class, n) {
          UnresolvedNone
        } else {
          UnresolvedAssumption(ty_show(ck_shown(&c, t)))
        }
        TyVar(v) => UnresolvedUndetermined
        _ => if class_is_structural(r#class) {
          if datas_structural(c.datas, r#class, t, assume) {
            UnresolvedNone
          } else {
            UnresolvedNoInstance(ty_show(ck_shown(&c, t)))
          }
        } else {
          ⊢ Unresolved from match ty_constructor(t) {
            None => UnresolvedNoInstance(ty_show(ck_shown(&c, t)))
            Some(ctor) => ⊢ Unresolved from match Ordmap::get(
              c.instances,
              instance_key(r#class, ctor),
              Ordmap::compare_text
            ) {
              None => if ck_has_vars(&c, t) {
                UnresolvedUndetermined
              } else {
                UnresolvedNoInstance(ty_show(ck_shown(&c, t)))
              }
              Some(inst) => ck_resolve_preds_in(
                j,
                &c,
                inst.preds,
                head_found(ty_named_args(inst.head), ty_named_args(t), Ordmap::empty()),
                assume
              )
            }
          }
        }
      }
    }
  }

  pub fn ck_resolve_preds_in(
    k: Nat,
    &c: Checker,
    preds: List(Pair(Text, Text)),
    found: Ordmap(Text, Ty),
    assume: List(Pair(Text, Text))
  ): Unresolved {
    ⊢ Unresolved from match k {
      Zero => UnresolvedUndetermined
      Succ(j) => ⊢ Unresolved from match preds {
        Nil => UnresolvedNone
        Cons(p, rest) => ⊢ Unresolved from match ck_resolve_class_in(
          j,
          &c,
          p.fst,
          ty_strip_one(ck_resolve(&c, found_or_unit(found, p.snd))),
          assume
        ) {
          UnresolvedNone => ck_resolve_preds_in(j, &c, rest, found, assume)
          UnresolvedUndetermined => UnresolvedUndetermined
          UnresolvedAssumption(x) => UnresolvedAssumption(x)
          UnresolvedNoInstance(x) => UnresolvedNoInstance(x)
        }
      }
    }
  }
}

pub fn ck_resolve_class(
  &c: Checker,
  r#class: Text,
  t: Ty,
  assume: List(Pair(Text, Text))
): Unresolved {
  ck_resolve_class_in(c.steps, &c, r#class, ty_strip_one(ck_resolve(&c, t)), assume)
}

pub fn ck_check_class_pending(&mut c: Checker, p: TyPending): Unit {
  let span := span_at(p.start, p.end)
  ⊢ Unit from match ck_resolve_class(&c, p.r#class, p.ty, p.assume) {
    UnresolvedNone => #()
    UnresolvedUndetermined => ck_error(
      &mut c,
      cat3("the type in ", p.r#class, "(?) is not determined"),
      span
    )
    UnresolvedAssumption(shown) => ck_error(
      &mut c,
      cat5(
        p.what,
        " needs ",
        p.r#class,
        cat3("(", shown, ")"),
        cat4(": add where ", p.r#class, cat3("(", shown, ")"), "")
      ),
      span
    )
    UnresolvedNoInstance(shown) => ck_error(
      &mut c,
      cat4("no instance ", p.r#class, cat3("(", shown, ")"), ""),
      span
    )
  }
}
