import "classes_frame.taut"

// Instance declaration checks preserve the data environment.

fn inf_class(i: SurfaceInstance) -> Text { i.class }

fn inf_generics(i: SurfaceInstance) -> List(Text) { i.generics }

fn inf_wheres(i: SurfaceInstance) -> List(SurfaceConstraint) { i.wheres }

fn inf_laws(i: SurfaceInstance) -> List(SurfaceLaw) { i.laws }

fn inf_methods(i: SurfaceInstance) -> List(SurfaceFn) { i.methods }

fn inf_head(i: SurfaceInstance) -> SurfaceTerm { i.head }

fn inf_span(i: SurfaceInstance) -> TySpan { span_at(i.start, i.end) }

fn inf_law_duplicate(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Yn
) -> Mut1(Unit, Checker) {
  match bad -> Mut1(Unit, Checker) {
    yes => frame_bind(
      Unit,
      Unit,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(
        c,
        cat3("the law ", cf_law_name(l), " of the instance is written twice"),
        cf_law_span(l)
      )
    )
    no => ck_rewrap1(ck_instance_laws(rest, Cons(cf_law_name(l), seen), c, i, decl))
  }
}

theorem inf_law_duplicate_frame(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Yn,
  ih: ∀ ns: List(
    Text
  ). ∀ next: Checker. CkReadFrame(next, ck_instance_laws(rest, ns, next, i, decl))
): CkReadFrame(c, inf_law_duplicate(l, rest, seen, c, i, decl, bad)) {
  match bad -> CkReadFrame(c, inf_law_duplicate(l, rest, seen, c, i, decl, bad)) {
    yes => frame_bind_ok(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(
        c,
        cat3("the law ", cf_law_name(l), " of the instance is written twice"),
        cf_law_span(l)
      ),
      ck_error_frame(
        c,
        cat3("the law ", cf_law_name(l), " of the instance is written twice"),
        cf_law_span(l)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_laws(rest, seen, c1, i, decl), ih(seen, c1))
    )
    no => frame_rewrap(
      c,
      ck_instance_laws(rest, Cons(cf_law_name(l), seen), c, i, decl),
      ih(Cons(cf_law_name(l), seen), c)
    )
  }
}

fn inf_law_missing(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Yn
) -> Mut1(Unit, Checker) {
  match bad -> Mut1(Unit, Checker) {
    yes => frame_bind(
      Unit,
      Unit,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(c, cat3(inf_class(i), " has no law ", cf_law_name(l)), cf_law_span(l))
    )
    no => inf_law_duplicate(l, rest, seen, c, i, decl, text_list_has(seen, cf_law_name(l)))
  }
}

theorem inf_law_missing_frame(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Yn,
  ih: ∀ ns: List(
    Text
  ). ∀ next: Checker. CkReadFrame(next, ck_instance_laws(rest, ns, next, i, decl))
): CkReadFrame(c, inf_law_missing(l, rest, seen, c, i, decl, bad)) {
  match bad -> CkReadFrame(c, inf_law_missing(l, rest, seen, c, i, decl, bad)) {
    yes => frame_bind_ok(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(c, cat3(inf_class(i), " has no law ", cf_law_name(l)), cf_law_span(l)),
      ck_error_frame(c, cat3(inf_class(i), " has no law ", cf_law_name(l)), cf_law_span(l)),
      ignored => c1 => frame_rewrap(c1, ck_instance_laws(rest, seen, c1, i, decl), ih(seen, c1))
    )
    no => inf_law_duplicate_frame(
      l,
      rest,
      seen,
      c,
      i,
      decl,
      text_list_has(seen, cf_law_name(l)),
      ih
    )
  }
}

theorem inf_laws_unf(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): Eq(
  Mut1(Unit, Checker),
  ck_instance_laws(Cons(l, rest), seen, c, i, decl),
  inf_law_missing(l, rest, seen, c, i, decl, yn_not(law_named(cf_class_laws(decl), cf_law_name(l))))
) { refl() }

theorem ck_instance_laws_frame(
  ls: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): CkReadFrame(c, ck_instance_laws(ls, seen, c, i, decl)) {
  match ls -> CkReadFrame(c, ck_instance_laws(ls, seen, c, i, decl)) {
    Nil => refl()
    Cons(
      l,
      rest
    ) => Eq_subst(
      (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_laws_unf(l, rest, seen, c, i, decl)),
      inf_law_missing_frame(
        l,
        rest,
        seen,
        c,
        i,
        decl,
        yn_not(law_named(cf_class_laws(decl), cf_law_name(l))),
        ns => next => ck_instance_laws_frame(rest, ns, next, i, decl)
      )
    )
  }
}

fn inf_extra_cons(
  m: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
) -> Mut1(Unit, Checker) {
  frame_bind(
    Unit,
    Unit,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_extra(rest, c1, i, decl)),
    frame_error_if(
      c,
      cat3(inf_class(i), " has no method ", signature_name(m)),
      cf_method_span(m),
      yn_not(method_names_have(cf_class_methods(decl), signature_name(m)))
    )
  )
}

theorem inf_extra_cons_frame(
  m: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ih: ∀ next: Checker. CkReadFrame(next, ck_instance_extra(rest, next, i, decl))
): CkReadFrame(c, inf_extra_cons(m, rest, c, i, decl)) {
  frame_bind_ok(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_extra(rest, c1, i, decl)),
    frame_error_if(
      c,
      cat3(inf_class(i), " has no method ", signature_name(m)),
      cf_method_span(m),
      yn_not(method_names_have(cf_class_methods(decl), signature_name(m)))
    ),
    frame_error_if_ok(
      c,
      cat3(inf_class(i), " has no method ", signature_name(m)),
      cf_method_span(m),
      yn_not(method_names_have(cf_class_methods(decl), signature_name(m)))
    ),
    ignored => c1 => frame_rewrap(c1, ck_instance_extra(rest, c1, i, decl), ih(c1))
  )
}

theorem inf_extra_unf(
  m: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): Eq(
  Mut1(Unit, Checker),
  ck_instance_extra(Cons(m, rest), c, i, decl),
  inf_extra_cons(m, rest, c, i, decl)
) { refl() }

theorem ck_instance_extra_frame(
  ms: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): CkReadFrame(c, ck_instance_extra(ms, c, i, decl)) {
  match ms -> CkReadFrame(c, ck_instance_extra(ms, c, i, decl)) {
    Nil => refl()
    Cons(
      m,
      rest
    ) => Eq_subst(
      (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_extra_unf(m, rest, c, i, decl)),
      inf_extra_cons_frame(
        m,
        rest,
        c,
        i,
        decl,
        next => ck_instance_extra_frame(rest, next, i, decl)
      )
    )
  }
}

fn inf_want(
  i: SurfaceInstance,
  got: SurfaceFn,
  expected: SurfaceFn,
  param: Text
) -> SurfaceFn { SurfaceFn {
    name: got.name,
    generics: list_append(i.generics, expected.generics),
    bounds: list_append(
      opts_resize(list_len(i.generics), i.bounds),
      opts_resize(list_len(expected.generics), expected.bounds)
    ),
    params: expected.params,
    borrows: expected.borrows,
    param_types: opt_terms_replace(expected.param_types, param, i.head),
    result: opt_term_replace(expected.result, param, i.head),
    effects: expected.effects,
    wheres: i.wheres,
    start: expected.start,
    end: expected.end,
    body: expected.body
  } }

fn inf_wanted_params(wanted: Scheme) -> List(Ty) { match wanted.ty -> List(Ty) {
    TyFn(ps, r, k) => ps
    TyInt(w) => Nil
    TyBool => Nil
    TyText => Nil
    TyUnit => Nil
    TyNever => Nil
    TyDecimal => Nil
    TyFloat => Nil
    TyUnion(members) => Nil
    TyTagged(tags, inner) => Nil
    TyNamed(name, args) => Nil
    TyParam(name, bound) => Nil
    TyInfo(inner) => Nil
    TyBorrow(inner, mutable) => Nil
    TyVar(v) => Nil
    TyPoly(generics, inner) => Nil
    TyApp(head, arg) => Nil
  } }

fn inf_signature_diff(
  wanted: Scheme,
  scheme: Scheme,
  got: SurfaceFn,
  want: SurfaceFn
) -> Yn { yn_or(yn_not(ty_eq(wanted.ty, scheme.ty)), yn_not(borrows_eq(got.borrows, want.borrows))) }
fn inf_signature_message(
  c: Checker,
  i: SurfaceInstance,
  expected: SurfaceFn,
  head: Text,
  want: SurfaceFn,
  wanted: Scheme
) -> Text {
  cat5(
    i.class,
    ".",
    expected.name,
    cat3(" of ", head, " takes "),
    text_join(shown_params(want.params, want.borrows, inf_wanted_params(wanted), c), ", ")
  )
}

fn inf_same(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  head: Text,
  want: SurfaceFn
) -> Mut1(Unit, Checker) {
  frame_bind(
    Scheme,
    Unit,
    (
      wanted: Scheme,
      c1: Checker
    ) => frame_error_if(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    ),
    ck_signature(c, want)
  )
}

theorem inf_same_frame(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  head: Text,
  want: SurfaceFn
): CkReadFrame(c, inf_same(c, i, got, scheme, expected, head, want)) {
  frame_bind_ok(
    Scheme,
    Unit,
    c,
    (
      wanted: Scheme,
      c1: Checker
    ) => frame_error_if(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    ),
    ck_signature(c, want),
    ck_signature_frame(c, want),
    wanted => c1 => frame_error_if_ok(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    )
  )
}

theorem inf_same_unf(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  param: Text,
  head: Text
): Eq(
  Mut1(Unit, Checker),
  ck_same_signature(c, i, got, scheme, expected, param, head),
  inf_same(c, i, got, scheme, expected, head, inf_want(i, got, expected, param))
) { refl() }

theorem ck_same_signature_frame(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  param: Text,
  head: Text
): CkReadFrame(
  c,
  ck_same_signature(c, i, got, scheme, expected, param, head)
) { Eq_subst(
  (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
  Eq_sym(inf_same_unf(c, i, got, scheme, expected, param, head)),
  inf_same_frame(c, i, got, scheme, expected, head, inf_want(i, got, expected, param))
) }

fn inf_method_fn(i: SurfaceInstance, ctor: Text, m: SurfaceFn) -> SurfaceFn { SurfaceFn {
    name: instance_fn(i.class, m.name, ctor),
    generics: list_append(i.generics, m.generics),
    bounds: list_append(
      opts_resize(list_len(i.generics), i.bounds),
      opts_resize(list_len(m.generics), m.bounds)
    ),
    params: m.params,
    borrows: m.borrows,
    param_types: m.param_types,
    result: m.result,
    effects: m.effects,
    wheres: i.wheres,
    start: m.start,
    end: m.end,
    body: m.body
  } }

fn inf_method_found(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  made: SurfaceFn
) -> Mut1(List(SurfaceFn), Checker) {
  frame_bind(
    Scheme,
    List(SurfaceFn),
    (
      scheme: Scheme,
      c1: Checker
    ) => frame_bind(
      Unit,
      List(SurfaceFn),
      (
        ignored: Unit,
        c2: Checker
      ) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown)
    ),
    ck_signature(c, made)
  )
}

theorem inf_method_found_frame(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  made: SurfaceFn,
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkReadFrame(next, ck_instance_methods(rest, next, i, decl, ctor, shown, fs))
): CkReadFrame(c, inf_method_found(e, rest, c, i, decl, ctor, shown, out, made)) {
  frame_bind_ok(
    Scheme,
    List(SurfaceFn),
    c,
    (
      scheme: Scheme,
      c1: Checker
    ) => frame_bind(
      Unit,
      List(SurfaceFn),
      (
        ignored: Unit,
        c2: Checker
      ) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown)
    ),
    ck_signature(c, made),
    ck_signature_frame(c, made),
    scheme => c1 => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c1,
      (
        ignored: Unit,
        c2: Checker
      ) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown),
      ck_same_signature_frame(c1, i, made, scheme, e, cf_class_param(decl), shown),
      ignored => c2 => frame_changed(
        c2,
        cf_store_state(c2, made, scheme),
        ck_rewrap1(
          ck_instance_methods(
            rest,
            cf_store_state(c2, made, scheme),
            i,
            decl,
            ctor,
            shown,
            Cons(made, out)
          )
        ),
        cf_store_state_same(c2, made, scheme),
        frame_rewrap(
          cf_store_state(c2, made, scheme),
          ck_instance_methods(
            rest,
            cf_store_state(c2, made, scheme),
            i,
            decl,
            ctor,
            shown,
            Cons(made, out)
          ),
          ih(cf_store_state(c2, made, scheme), Cons(made, out))
        )
      )
    )
  )
}

fn inf_method_get(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  o: Option(SurfaceFn)
) -> Mut1(List(SurfaceFn), Checker) {
  match o -> Mut1(List(SurfaceFn), Checker) {
    None => frame_bind(
      Unit,
      List(SurfaceFn),
      (
        ignored: Unit,
        c1: Checker
      ) => ck_rewrap1(ck_instance_methods(rest, c1, i, decl, ctor, shown, out)),
      ck_error(
        c,
        cat5(
          "the instance ",
          inf_class(i),
          cat3("(", shown, ")"),
          " does not define ",
          signature_name(e)
        ),
        inf_span(i)
      )
    )
    Some(m) => inf_method_found(e, rest, c, i, decl, ctor, shown, out, inf_method_fn(i, ctor, m))
  }
}

theorem inf_method_get_frame(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  o: Option(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkReadFrame(next, ck_instance_methods(rest, next, i, decl, ctor, shown, fs))
): CkReadFrame(c, inf_method_get(e, rest, c, i, decl, ctor, shown, out, o)) {
  match o -> CkReadFrame(c, inf_method_get(e, rest, c, i, decl, ctor, shown, out, o)) {
    None => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (
        ignored: Unit,
        c1: Checker
      ) => ck_rewrap1(ck_instance_methods(rest, c1, i, decl, ctor, shown, out)),
      ck_error(
        c,
        cat5(
          "the instance ",
          inf_class(i),
          cat3("(", shown, ")"),
          " does not define ",
          signature_name(e)
        ),
        inf_span(i)
      ),
      ck_error_frame(
        c,
        cat5(
          "the instance ",
          inf_class(i),
          cat3("(", shown, ")"),
          " does not define ",
          signature_name(e)
        ),
        inf_span(i)
      ),
      ignored => c1 => frame_rewrap(
        c1,
        ck_instance_methods(rest, c1, i, decl, ctor, shown, out),
        ih(c1, out)
      )
    )
    Some(
      m
    ) => inf_method_found_frame(
      e,
      rest,
      c,
      i,
      decl,
      ctor,
      shown,
      out,
      inf_method_fn(i, ctor, m),
      ih
    )
  }
}

theorem inf_methods_unf(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn)
): Eq(
  Mut1(List(SurfaceFn), Checker),
  ck_instance_methods(Cons(e, rest), c, i, decl, ctor, shown, out),
  inf_method_get(
    e,
    rest,
    c,
    i,
    decl,
    ctor,
    shown,
    out,
    method_named(inf_methods(i), signature_name(e))
  )
) { refl() }

theorem ck_instance_methods_frame(
  expected: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn)
): CkReadFrame(c, ck_instance_methods(expected, c, i, decl, ctor, shown, out)) {
  match expected -> CkReadFrame(c, ck_instance_methods(expected, c, i, decl, ctor, shown, out)) {
    Nil => refl()
    Cons(
      e,
      rest
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_methods_unf(e, rest, c, i, decl, ctor, shown, out)),
      inf_method_get_frame(
        e,
        rest,
        c,
        i,
        decl,
        ctor,
        shown,
        out,
        method_named(inf_methods(i), signature_name(e)),
        next => fs => ck_instance_methods_frame(rest, next, i, decl, ctor, shown, fs)
      )
    )
  }
}

fn inf_preds_dup(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  g: Text,
  dup: Yn
) -> Mut1(List(Pair(Text, Text)), Checker) {
  match dup -> Mut1(List(Pair(Text, Text)), Checker) {
    yes => frame_bind(
      Unit,
      List(Pair(Text, Text)),
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        cat5(signature_constraint_class(w), "(", g, ") is written twice", ""),
        signature_constraint_span(w)
      )
    )
    no => ck_rewrap1(
      ck_instance_preds(
        rest,
        c,
        gs,
        Cons(Pair { fst: signature_constraint_class(w), snd: g }, preds)
      )
    )
  }
}

theorem inf_preds_dup_frame(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  g: Text,
  dup: Yn,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkReadFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkReadFrame(c, inf_preds_dup(w, rest, c, gs, preds, g, dup)) {
  match dup -> CkReadFrame(c, inf_preds_dup(w, rest, c, gs, preds, g, dup)) {
    yes => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        cat5(signature_constraint_class(w), "(", g, ") is written twice", ""),
        signature_constraint_span(w)
      ),
      ck_error_frame(
        c,
        cat5(signature_constraint_class(w), "(", g, ") is written twice", ""),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    no => frame_rewrap(
      c,
      ck_instance_preds(
        rest,
        c,
        gs,
        Cons(Pair { fst: signature_constraint_class(w), snd: g }, preds)
      ),
      ih(c, Cons(Pair { fst: signature_constraint_class(w), snd: g }, preds))
    )
  }
}

fn inf_preds_has(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  g: Text,
  has: Yn
) -> Mut1(List(Pair(Text, Text)), Checker) {
  match has -> Mut1(List(Pair(Text, Text)), Checker) {
    yes => inf_preds_dup(
      w,
      rest,
      c,
      gs,
      preds,
      g,
      preds_have(preds, signature_constraint_class(w), g)
    )
    no => frame_bind(
      Unit,
      List(Pair(Text, Text)),
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w))
    )
  }
}

theorem inf_preds_has_frame(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  g: Text,
  has: Yn,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkReadFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkReadFrame(c, inf_preds_has(w, rest, c, gs, preds, g, has)) {
  match has -> CkReadFrame(c, inf_preds_has(w, rest, c, gs, preds, g, has)) {
    yes => inf_preds_dup_frame(
      w,
      rest,
      c,
      gs,
      preds,
      g,
      preds_have(preds, signature_constraint_class(w), g),
      ih
    )
    no => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
  }
}

