pub theorem inf_preds_kind_frame(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text),
  k: SurfaceKind,
  ih: ∀ next: Checker. ∀ ps: List(
    (Text × Text)
  ). CkReadFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkReadFrame(c, inf_preds_kind(w, rest, c, gs, preds, k)) {
  match k {
    SkVar(g) => inf_preds_has_frame(w, rest, c, gs, preds, surface_name_text(g), text_list_has(gs, surface_name_text(g)), ih)
    SkNat(digits) => frame_bind_ok(
