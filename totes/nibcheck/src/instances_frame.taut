pub theorem inf_list_step(
  s: SurfaceStmt,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkReadFrame(next, ck_declare_instances(rest, next, own_classes, own_types, fs))
): CkReadFrame(c, ck_declare_instances(Cons(s, rest), c, own_classes, own_types, out)) {
  match s {
    StLet(name, ty, value, r#borrow, mutable, unused, st_stack) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(
        inf_list_StLet_unf(name, ty, value, r#borrow, mutable, unused, st_stack, rest, c, own_classes, own_types, out)
      ),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StVar(name, ty, value, r#borrow, unused, st_stack) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StVar_unf(name, ty, value, r#borrow, unused, st_stack, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StAssign(name, name_place, value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StAssign_unf(name, name_place, value, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StCalled(name_generates, value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StCalled_unf(name_generates, value, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StFn(f) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StFn_unf(f, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StTheorem(t) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StTheorem_unf(t, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StDef(t) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StDef_unf(t, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StMutual(stmts, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StMutual_unf(stmts, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StImport(path, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StImport_unf(path, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StInductive(i) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StInductive_unf(i, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StEffect(e) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StEffect_unf(e, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StStruct(d) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StStruct_unf(d, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StEnum(d) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StEnum_unf(d, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StExtern(fns, instances, types, structs, enums, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StExtern_unf(fns, instances, types, structs, enums, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StClass(cl) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StClass_unf(cl, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StInstance(i) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StInstance_unf(i, rest, c, own_classes, own_types, out)),
      inf_list_cons_frame(i, rest, c, own_classes, own_types, out, ih)
    )
    StWhile(cond, body) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StWhile_unf(cond, body, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StReturn(value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StReturn_unf(value, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StExpr(value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StExpr_unf(value, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StOther(what, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StOther_unf(what, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StLoop(st_body, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StOther_unf("LoopExpr", start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StModule(mod_name, mod_vis, mod_items, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StOther_unf("ModuleDecl", start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StReexport(re_path, re_names, re_spans, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StOther_unf("ReexportDecl", start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StFor(for_pat, for_src, st_body, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StOther_unf("ForStmt", start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StBreak(st_value, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StOther_unf("BreakStmt", start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StContinue(start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_list_StOther_unf("ContinueStmt", start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StMacro(name, function, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(
        inf_list_StMacro_unf(name, function, start, end, rest, c, own_classes, own_types, out)
      ),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(
        inf_list_StAttributed_unf(
          attr_name,
          attr_arg,
          attr_generates,
          attr_stmt,
          rest,
          c,
          own_classes,
          own_types,
          out
        )
      ),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StSyntax(name, grammar, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(
        inf_list_StSyntax_unf(name, grammar, start, end, rest, c, own_classes, own_types, out)
      ),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
  }
}

pub theorem ck_declare_instances_frame(
  ss: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkReadFrame(c, ck_declare_instances(ss, c, own_classes, own_types, out)) {
  match ss {
    Nil => Refl
    Cons(s, rest) => inf_list_step(
      s,
      rest,
      c,
      own_classes,
      own_types,
      out,
      next => fs => ck_declare_instances_frame(rest, next, own_classes, own_types, fs)
    )
  }
}

pub fn inf_declare_classes(c: Checker, program: List(SurfaceStmt)): Mut1(List(SurfaceFn), Checker) {
  frame_bind(
    <A: List(SurfaceClass), B: List(SurfaceFn)>,
    (declared: List(SurfaceClass), c1: Checker) => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c2: Checker) => frame_bind(
        <A: List(SurfaceFn), B: List(SurfaceFn)>,
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1)
    ),
    ck_declare_class_list(program, c, stmts_type_names(program))
  )
}

pub theorem inf_declare_classes_frame(
  c: Checker,
  program: List(SurfaceStmt)
): CkReadFrame(c, inf_declare_classes(c, program)) {
  frame_bind_ok(
    <A: List(SurfaceClass), B: List(SurfaceFn)>,
    c,
    (declared: List(SurfaceClass), c1: Checker) => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c2: Checker) => frame_bind(
        <A: List(SurfaceFn), B: List(SurfaceFn)>,
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1)
    ),
    ck_declare_class_list(program, c, stmts_type_names(program)),
    ck_declare_class_list_frame(program, c, stmts_type_names(program)),
    declared => c1 => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c1,
      (ignored: Unit, c2: Checker) => frame_bind(
        <A: List(SurfaceFn), B: List(SurfaceFn)>,
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1),
      ck_declare_methods_frame(declared, c1),
      ignored => c2 => frame_bind_ok(
        <A: List(SurfaceFn), B: List(SurfaceFn)>,
        c2,
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        ),
        ck_declare_instances_frame(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        ),
        fs => c3 => Refl
      )
    )
  )
}

pub theorem inf_classes_unf(
  c: Checker,
  program: List(SurfaceStmt)
): ck_declare_classes(c, program) = inf_declare_classes(c, program) { Refl }

pub theorem ck_declare_classes_frame(
  c: Checker,
  program: List(SurfaceStmt)
): CkReadFrame(c, ck_declare_classes(c, program)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
    Eq::sym(inf_classes_unf(c, program)),
    inf_declare_classes_frame(c, program)
  )
}

pub fn inf_declare_all_classes(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt)
): Mut1(List(SurfaceFn), Checker) {
  frame_bind(
    <A: List(SurfaceFn), B: List(SurfaceFn)>,
    (pre: List(SurfaceFn), c1: Checker) => frame_bind(
      <A: List(SurfaceFn), B: List(SurfaceFn)>,
      (made: List(SurfaceFn), c2: Checker) => mut1(List::append(pre, made), c2),
      ck_declare_classes(c1, program)
    ),
    ck_declare_classes(c, prelude_class_stmts(prelude, stmts_class_names(program)))
  )
}

pub theorem inf_all_classes_unf(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt)
): ck_declare_all_classes(c, prelude, program) = inf_declare_all_classes(c, prelude, program) { Refl }

pub theorem ck_declare_all_classes_frame(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt)
): CkReadFrame(c, ck_declare_all_classes(c, prelude, program)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
    Eq::sym(inf_all_classes_unf(c, prelude, program)),
    frame_bind_ok(
      <A: List(SurfaceFn), B: List(SurfaceFn)>,
      c,
      (pre: List(SurfaceFn), c1: Checker) => frame_bind(
        <A: List(SurfaceFn), B: List(SurfaceFn)>,
        (made: List(SurfaceFn), c2: Checker) => mut1(List::append(pre, made), c2),
        ck_declare_classes(c1, program)
      ),
      ck_declare_classes(c, prelude_class_stmts(prelude, stmts_class_names(program))),
      ck_declare_classes_frame(c, prelude_class_stmts(prelude, stmts_class_names(program))),
      pre => c1 => frame_bind_ok(
        <A: List(SurfaceFn), B: List(SurfaceFn)>,
        c1,
        (made: List(SurfaceFn), c2: Checker) => mut1(List::append(pre, made), c2),
        ck_declare_classes(c1, program),
        ck_declare_classes_frame(c1, program),
        made => c2 => Refl
      )
    )
  )
}
