theorem inf_list_StReturn_unf(
  value: Option(SurfaceTerm),
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): Eq(
  Mut1(List(SurfaceFn), Checker),
  ck_declare_instances(Cons(StReturn(value), rest), c, own_classes, own_types, out),
  ck_rewrap1(ck_declare_instances(rest, c, own_classes, own_types, out))
) { refl() }

