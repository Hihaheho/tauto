theorem inf_list_step(
  s: SurfaceStmt,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkReadFrame(next, ck_declare_instances(rest, next, own_classes, own_types, fs))
): CkReadFrame(c, ck_declare_instances(Cons(s, rest), c, own_classes, own_types, out)) {
  match s -> CkReadFrame(c, ck_declare_instances(Cons(s, rest), c, own_classes, own_types, out)) {
    StLet(
      name,
      ty,
      value,
      borrow,
      mutable
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(
        inf_list_StLet_unf(name, ty, value, borrow, mutable, rest, c, own_classes, own_types, out)
      ),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StVar(
      name,
      ty,
      value,
      borrow
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StVar_unf(name, ty, value, borrow, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StModule(
      name,
      stmts,
      start,
      end
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StModule_unf(name, stmts, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StAssign(
      name,
      value
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StAssign_unf(name, value, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StFn(
      f
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StFn_unf(f, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StTheorem(
      t
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StTheorem_unf(t, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StDef(
      t
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StDef_unf(t, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StMutual(
      stmts,
      start,
      end
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StMutual_unf(stmts, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StImport(
      path,
      start,
      end
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StImport_unf(path, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StInductive(
      i
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StInductive_unf(i, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StEffect(
      e
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StEffect_unf(e, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StStruct(
      d
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StStruct_unf(d, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StEnum(
      d
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StEnum_unf(d, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StExtern(
      abi,
      fns,
      start,
      end
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StExtern_unf(abi, fns, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StClass(
      cl
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StClass_unf(cl, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StInstance(
      i
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StInstance_unf(i, rest, c, own_classes, own_types, out)),
      inf_list_cons_frame(i, rest, c, own_classes, own_types, out, ih)
    )
    StWhile(
      cond,
      body
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StWhile_unf(cond, body, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StReturn(
      value
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StReturn_unf(value, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StExpr(
      value
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StExpr_unf(value, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StOther(
      what,
      start,
      end
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_list_StOther_unf(what, start, end, rest, c, own_classes, own_types, out)),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StMacro(
      name,
      function,
      start,
      end
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(
        inf_list_StMacro_unf(name, function, start, end, rest, c, own_classes, own_types, out)
      ),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StSyntax(
      name,
      grammar,
      start,
      end
    ) => Eq_subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq_sym(
        inf_list_StSyntax_unf(name, grammar, start, end, rest, c, own_classes, own_types, out)
      ),
      frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
  }
}

theorem ck_declare_instances_frame(
  ss: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkReadFrame(c, ck_declare_instances(ss, c, own_classes, own_types, out)) {
  match ss -> CkReadFrame(c, ck_declare_instances(ss, c, own_classes, own_types, out)) {
    Nil => refl()
    Cons(
      s,
      rest
    ) => inf_list_step(
      s,
      rest,
      c,
      own_classes,
      own_types,
      out,
      next => fs => ck_declare_instances_frame(rest, next, own_classes, own_types, fs)
    )
  }
}

fn inf_declare_classes(c: Checker, program: List(SurfaceStmt)) -> Mut1(List(SurfaceFn), Checker) {
  frame_bind(
    List(SurfaceClass),
    List(SurfaceFn),
    (
      declared: List(SurfaceClass),
      c1: Checker
    ) => frame_bind(
      Unit,
      List(SurfaceFn),
      (
        ignored: Unit,
        c2: Checker
      ) => frame_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        (fs: List(SurfaceFn), c3: Checker) => mut1(list_reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1)
    ),
    ck_declare_class_list(program, c, stmts_type_names(program))
  )
}

theorem inf_declare_classes_frame(
  c: Checker,
  program: List(SurfaceStmt)
): CkReadFrame(c, inf_declare_classes(c, program)) {
  frame_bind_ok(
    List(SurfaceClass),
    List(SurfaceFn),
    c,
    (
      declared: List(SurfaceClass),
      c1: Checker
    ) => frame_bind(
      Unit,
      List(SurfaceFn),
      (
        ignored: Unit,
        c2: Checker
      ) => frame_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        (fs: List(SurfaceFn), c3: Checker) => mut1(list_reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1)
    ),
    ck_declare_class_list(program, c, stmts_type_names(program)),
    ck_declare_class_list_frame(program, c, stmts_type_names(program)),
    declared => c1 => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c1,
      (
        ignored: Unit,
        c2: Checker
      ) => frame_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        (fs: List(SurfaceFn), c3: Checker) => mut1(list_reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1),
      ck_declare_methods_frame(declared, c1),
      ignored => c2 => frame_bind_ok(
        List(SurfaceFn),
        List(SurfaceFn),
        c2,
        (fs: List(SurfaceFn), c3: Checker) => mut1(list_reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        ),
        ck_declare_instances_frame(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        ),
        fs => c3 => refl()
      )
    )
  )
}

theorem inf_classes_unf(
  c: Checker,
  program: List(SurfaceStmt)
): Eq(
  Mut1(List(SurfaceFn), Checker),
  ck_declare_classes(c, program),
  inf_declare_classes(c, program)
) { refl() }

theorem ck_declare_classes_frame(
  c: Checker,
  program: List(SurfaceStmt)
): CkReadFrame(
  c,
  ck_declare_classes(c, program)
) { Eq_subst(
  (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
  Eq_sym(inf_classes_unf(c, program)),
  inf_declare_classes_frame(c, program)
) }
