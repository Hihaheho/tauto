// Instance declaration checks preserve the data environment.

pub fn inf_class(i: SurfaceInstance): Text { i.r#class }

pub fn inf_generics(i: SurfaceInstance): List(Text) { i.generics }

pub fn inf_wheres(i: SurfaceInstance): List(SurfaceConstraint) { i.wheres }

pub fn inf_laws(i: SurfaceInstance): List(SurfaceLaw) { i.laws }

pub fn inf_methods(i: SurfaceInstance): List(SurfaceFn) { i.methods }

pub fn inf_head(i: SurfaceInstance): SurfaceTerm { i.head }

pub fn inf_span(i: SurfaceInstance): TySpan { span_at(i.start, i.end) }

pub fn inf_law_duplicate(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Bool
): Mut1(Unit, Checker) {
  match bad {
    true => frame_bind(
      <A: Unit, B: Unit>,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(
        c,
        instance_law_twice_message(cf_law_name(l)),
        cf_law_span(l)
      )
    )
    false => ck_rewrap1(ck_instance_laws(rest, Cons(cf_law_name(l), seen), c, i, decl))
  }
}

pub theorem inf_law_duplicate_frame(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Bool,
  ih: ∀ ns: List(
    Text
  ). ∀ next: Checker. CkReadFrame(next, ck_instance_laws(rest, ns, next, i, decl))
): CkReadFrame(c, inf_law_duplicate(l, rest, seen, c, i, decl, bad)) {
  match bad {
    true => frame_bind_ok(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(
        c,
        instance_law_twice_message(cf_law_name(l)),
        cf_law_span(l)
      ),
      ck_error_frame(
        c,
        instance_law_twice_message(cf_law_name(l)),
        cf_law_span(l)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_laws(rest, seen, c1, i, decl), ih(seen, c1))
    )
    false => frame_rewrap(
      c,
      ck_instance_laws(rest, Cons(cf_law_name(l), seen), c, i, decl),
      ih(Cons(cf_law_name(l), seen), c)
    )
  }
}

pub fn inf_law_missing(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Bool
): Mut1(Unit, Checker) {
  match bad {
    true => frame_bind(
      <A: Unit, B: Unit>,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(c, instance_no_law_message(inf_class(i), cf_law_name(l)), cf_law_span(l))
    )
    false => inf_law_duplicate(l, rest, seen, c, i, decl, text_list_has(seen, cf_law_name(l)))
  }
}

pub theorem inf_law_missing_frame(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Bool,
  ih: ∀ ns: List(
    Text
  ). ∀ next: Checker. CkReadFrame(next, ck_instance_laws(rest, ns, next, i, decl))
): CkReadFrame(c, inf_law_missing(l, rest, seen, c, i, decl, bad)) {
  match bad {
    true => frame_bind_ok(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(c, instance_no_law_message(inf_class(i), cf_law_name(l)), cf_law_span(l)),
      ck_error_frame(c, instance_no_law_message(inf_class(i), cf_law_name(l)), cf_law_span(l)),
      ignored => c1 => frame_rewrap(c1, ck_instance_laws(rest, seen, c1, i, decl), ih(seen, c1))
    )
    false => inf_law_duplicate_frame(
      l,
      rest,
      seen,
      c,
      i,
      decl,
      text_list_has(seen, cf_law_name(l)),
      ih
    )
  }
}

pub theorem inf_laws_unf(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): ck_instance_laws(
  Cons(l, rest),
  seen,
  c,
  i,
  decl
) = inf_law_missing(
  l,
  rest,
  seen,
  c,
  i,
  decl,
  not(law_named(cf_class_laws(decl), cf_law_name(l)))
) { Refl }

pub theorem ck_instance_laws_frame(
  ls: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): CkReadFrame(c, ck_instance_laws(ls, seen, c, i, decl)) {
  match ls {
    Nil => Refl
    Cons(l, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_laws_unf(l, rest, seen, c, i, decl)),
      inf_law_missing_frame(
        l,
        rest,
        seen,
        c,
        i,
        decl,
        not(law_named(cf_class_laws(decl), cf_law_name(l))),
        ns => next => ck_instance_laws_frame(rest, ns, next, i, decl)
      )
    )
  }
}

pub fn inf_extra_cons(
  m: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): Mut1(Unit, Checker) {
  frame_bind(
    <A: Unit, B: Unit>,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_extra(rest, c1, i, decl)),
    frame_error_if(
      c,
      no_method_message(inf_class(i), signature_name(m)),
      cf_method_span(m),
      not(method_names_have(cf_class_methods(decl), signature_name(m)))
    )
  )
}

pub theorem inf_extra_cons_frame(
  m: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ih: ∀ next: Checker. CkReadFrame(next, ck_instance_extra(rest, next, i, decl))
): CkReadFrame(c, inf_extra_cons(m, rest, c, i, decl)) {
  frame_bind_ok(
    <A: Unit, B: Unit>,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_extra(rest, c1, i, decl)),
    frame_error_if(
      c,
      no_method_message(inf_class(i), signature_name(m)),
      cf_method_span(m),
      not(method_names_have(cf_class_methods(decl), signature_name(m)))
    ),
    frame_error_if_ok(
      c,
      no_method_message(inf_class(i), signature_name(m)),
      cf_method_span(m),
      not(method_names_have(cf_class_methods(decl), signature_name(m)))
    ),
    ignored => c1 => frame_rewrap(c1, ck_instance_extra(rest, c1, i, decl), ih(c1))
  )
}

pub theorem inf_extra_unf(
  m: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): ck_instance_extra(Cons(m, rest), c, i, decl) = inf_extra_cons(m, rest, c, i, decl) { Refl }

pub theorem ck_instance_extra_frame(
  ms: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): CkReadFrame(c, ck_instance_extra(ms, c, i, decl)) {
  match ms {
    Nil => Refl
    Cons(m, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_extra_unf(m, rest, c, i, decl)),
      inf_extra_cons_frame(
        m,
        rest,
        c,
        i,
        decl,
        next => ck_instance_extra_frame(rest, next, i, decl)
      )
    )
  }
}

pub fn inf_want(
  i: SurfaceInstance,
  got: SurfaceFn,
  expected: SurfaceFn,
  param: Text
): SurfaceFn { SurfaceFn {
    name: got.name,
    generics: List::append(i.generics, expected.generics),
    bounds: List::append(
      opts_resize(list_len(i.generics), i.bounds),
      opts_resize(list_len(expected.generics), expected.bounds)
    ),
    params: expected.params,
    r#borrows: expected.r#borrows,
    param_types: opt_terms_replace(expected.param_types, param, i.head),
    result: opt_term_replace(expected.result, param, i.head),
    effects: expected.effects,
    wheres: i.wheres,
    start: expected.start,
    end: expected.end,
    body: expected.body,
    lends: expected.lends,
    generic_types: List::append(surface_type_generics(i.generics), expected.generic_types),
    bound_starts: Nil,
    visibility: got.visibility,
    row_hole: got.row_hole,
    unused: None,
    unused_generics: Nil,
    unused_params: Nil
  } }

pub fn inf_wanted_params(wanted: Scheme): List(Ty) { match wanted.ty {
    TyFn(ps, ^r, ^k) => ps
    TyInt(^w) => Nil
    TyBool => Nil
    TyText => Nil
    TyUnit => Nil
    TyNever => Nil
    TyDecimal => Nil
    TyFloat => Nil
    TyFloat32 => Nil
    TyUnion(^members) => Nil
    TyProduct(^members) => Nil
    TyTagged(^tags, ^inner) => Nil
    TyNamed(^name, ^args) => Nil
    TyParam(^name, ^bound) => Nil
    TyInfo(^inner) => Nil
    TyBorrow(^inner, ^mutable) => Nil
    TyVar(^v) => Nil
    TyPoly(^generics, ^inner) => Nil
    TyApp(^head, ^arg) => Nil
  } }

pub fn inf_signature_diff(wanted: Scheme, scheme: Scheme, got: SurfaceFn, want: SurfaceFn): Bool {
  Bool::or(not(ty_eq(wanted.ty, scheme.ty)), not(borrows_eq(got.r#borrows, want.r#borrows)))
}
pub fn inf_signature_message(
  c: Checker,
  i: SurfaceInstance,
  expected: SurfaceFn,
  head: Text,
  want: SurfaceFn,
  wanted: Scheme
): Text {
  cat5(
    i.r#class,
    ".",
    expected.name,
    cat3(" of ", head, " takes "),
    text_join(shown_params(want.params, want.r#borrows, inf_wanted_params(wanted), c), ", ")
  )
}

pub fn inf_same(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  head: Text,
  want: SurfaceFn
): Mut1(Unit, Checker) {
  frame_bind(
    <A: Scheme, B: Unit>,
    (wanted: Scheme, c1: Checker) => frame_error_if(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    ),
    ck_signature(c, want)
  )
}

pub theorem inf_same_frame(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  head: Text,
  want: SurfaceFn
): CkReadFrame(c, inf_same(c, i, got, scheme, expected, head, want)) {
  frame_bind_ok(
    <A: Scheme, B: Unit>,
    c,
    (wanted: Scheme, c1: Checker) => frame_error_if(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    ),
    ck_signature(c, want),
    ck_signature_frame(c, want),
    wanted => c1 => frame_error_if_ok(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    )
  )
}

pub theorem inf_same_unf(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  param: Text,
  head: Text
): ck_same_signature(
  c,
  i,
  got,
  scheme,
  expected,
  param,
  head
) = inf_same(c, i, got, scheme, expected, head, inf_want(i, got, expected, param)) { Refl }

pub theorem ck_same_signature_frame(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  param: Text,
  head: Text
): CkReadFrame(c, ck_same_signature(c, i, got, scheme, expected, param, head)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
    Eq::sym(inf_same_unf(c, i, got, scheme, expected, param, head)),
    inf_same_frame(c, i, got, scheme, expected, head, inf_want(i, got, expected, param))
  )
}

pub fn inf_method_fn(i: SurfaceInstance, ctor: Text, m: SurfaceFn): SurfaceFn { SurfaceFn {
    name: instance_fn(i.r#class, m.name, ctor),
    generics: List::append(i.generics, m.generics),
    bounds: List::append(
      opts_resize(list_len(i.generics), i.bounds),
      opts_resize(list_len(m.generics), m.bounds)
    ),
    params: m.params,
    r#borrows: m.r#borrows,
    param_types: m.param_types,
    result: m.result,
    effects: m.effects,
    wheres: i.wheres,
    start: m.start,
    end: m.end,
    body: m.body,
    lends: m.lends,
    generic_types: List::append(surface_type_generics(i.generics), m.generic_types),
    bound_starts: List::append(surface_no_starts(surface_type_generics(i.generics)), m.bound_starts),
    visibility: m.visibility,
    row_hole: m.row_hole,
    unused: None,
    unused_generics: Nil,
    unused_params: Nil
  } }

pub fn inf_method_found(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  made: SurfaceFn
): Mut1(List(SurfaceFn), Checker) {
  frame_bind(
    <A: Scheme, B: List(SurfaceFn)>,
    (scheme: Scheme, c1: Checker) => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown)
    ),
    ck_signature(c, made)
  )
}

pub theorem inf_method_found_frame(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  made: SurfaceFn,
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkReadFrame(next, ck_instance_methods(rest, next, i, decl, ctor, shown, fs))
): CkReadFrame(c, inf_method_found(e, rest, c, i, decl, ctor, shown, out, made)) {
  frame_bind_ok(
    <A: Scheme, B: List(SurfaceFn)>,
    c,
    (scheme: Scheme, c1: Checker) => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown)
    ),
    ck_signature(c, made),
    ck_signature_frame(c, made),
    scheme => c1 => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c1,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown),
      ck_same_signature_frame(c1, i, made, scheme, e, cf_class_param(decl), shown),
      ignored => c2 => frame_changed(
        c2,
        cf_store_state(c2, made, scheme),
        ck_rewrap1(
          ck_instance_methods(
            rest,
            cf_store_state(c2, made, scheme),
            i,
            decl,
            ctor,
            shown,
            Cons(made, out)
          )
        ),
        cf_store_state_same(c2, made, scheme),
        frame_rewrap(
          cf_store_state(c2, made, scheme),
          ck_instance_methods(
            rest,
            cf_store_state(c2, made, scheme),
            i,
            decl,
            ctor,
            shown,
            Cons(made, out)
          ),
          ih(cf_store_state(c2, made, scheme), Cons(made, out))
        )
      )
    )
  )
}

pub fn inf_method_get(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  o: Option(SurfaceFn)
): Mut1(List(SurfaceFn), Checker) {
  match o {
    None => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => ck_rewrap1(
        ck_instance_methods(rest, c1, i, decl, ctor, shown, out)
      ),
      ck_error(
        c,
        instance_missing_method_message(inf_class(i), shown, signature_name(e)),
        inf_span(i)
      )
    )
    Some(m) => inf_method_found(e, rest, c, i, decl, ctor, shown, out, inf_method_fn(i, ctor, m))
  }
}

pub theorem inf_method_get_frame(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  o: Option(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkReadFrame(next, ck_instance_methods(rest, next, i, decl, ctor, shown, fs))
): CkReadFrame(c, inf_method_get(e, rest, c, i, decl, ctor, shown, out, o)) {
  match o {
    None => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(
        ck_instance_methods(rest, c1, i, decl, ctor, shown, out)
      ),
      ck_error(
        c,
        instance_missing_method_message(inf_class(i), shown, signature_name(e)),
        inf_span(i)
      ),
      ck_error_frame(
        c,
        instance_missing_method_message(inf_class(i), shown, signature_name(e)),
        inf_span(i)
      ),
      ignored => c1 => frame_rewrap(
        c1,
        ck_instance_methods(rest, c1, i, decl, ctor, shown, out),
        ih(c1, out)
      )
    )
    Some(m) => inf_method_found_frame(
      e,
      rest,
      c,
      i,
      decl,
      ctor,
      shown,
      out,
      inf_method_fn(i, ctor, m),
      ih
    )
  }
}

pub theorem inf_methods_unf(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn)
): ck_instance_methods(
  Cons(e, rest),
  c,
  i,
  decl,
  ctor,
  shown,
  out
) = inf_method_get(
  e,
  rest,
  c,
  i,
  decl,
  ctor,
  shown,
  out,
  method_named(inf_methods(i), signature_name(e))
) { Refl }

pub theorem ck_instance_methods_frame(
  expected: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn)
): CkReadFrame(c, ck_instance_methods(expected, c, i, decl, ctor, shown, out)) {
  match expected {
    Nil => Refl
    Cons(e, rest) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_methods_unf(e, rest, c, i, decl, ctor, shown, out)),
      inf_method_get_frame(
        e,
        rest,
        c,
        i,
        decl,
        ctor,
        shown,
        out,
        method_named(inf_methods(i), signature_name(e)),
        next => fs => ck_instance_methods_frame(rest, next, i, decl, ctor, shown, fs)
      )
    )
  }
}

pub fn inf_preds_dup(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text),
  g: Text,
  dup: Bool
): Mut1(List(Text × Text), Checker) {
  match dup {
    true => frame_bind(
      <A: Unit, B: List(Text × Text)>,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        predicate_written_twice_message(signature_constraint_class(w), g),
        signature_constraint_span(w)
      )
    )
    false => ck_rewrap1(
      ck_instance_preds(
        rest,
        c,
        gs,
        Cons(#(signature_constraint_class(w), g), preds)
      )
    )
  }
}

pub theorem inf_preds_dup_frame(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text),
  g: Text,
  dup: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    (Text × Text)
  ). CkReadFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkReadFrame(c, inf_preds_dup(w, rest, c, gs, preds, g, dup)) {
  match dup {
    true => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        predicate_written_twice_message(signature_constraint_class(w), g),
        signature_constraint_span(w)
      ),
      ck_error_frame(
        c,
        predicate_written_twice_message(signature_constraint_class(w), g),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    false => frame_rewrap(
      c,
      ck_instance_preds(
        rest,
        c,
        gs,
        Cons(#(signature_constraint_class(w), g), preds)
      ),
      ih(c, Cons(#(signature_constraint_class(w), g), preds))
    )
  }
}

pub fn inf_preds_has(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text),
  g: Text,
  has: Bool
): Mut1(List(Text × Text), Checker) {
  match has {
    true => inf_preds_dup(
      w,
      rest,
      c,
      gs,
      preds,
      g,
      preds_have(preds, signature_constraint_class(w), g)
    )
    false => frame_bind(
      <A: Unit, B: List(Text × Text)>,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w))
    )
  }
}

pub theorem inf_preds_has_frame(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text),
  g: Text,
  has: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    (Text × Text)
  ). CkReadFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkReadFrame(c, inf_preds_has(w, rest, c, gs, preds, g, has)) {
  match has {
    true => inf_preds_dup_frame(
      w,
      rest,
      c,
      gs,
      preds,
      g,
      preds_have(preds, signature_constraint_class(w), g),
      ih
    )
    false => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
  }
}

