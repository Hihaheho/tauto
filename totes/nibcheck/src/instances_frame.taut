        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkBorrow(mutable, mutable_orig, value) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkFnKind(kind, ty) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkBorrowLam(r#borrows, lam) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkOther(what) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkAscribe(what, what_ty) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkRow(what_effects) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkFloat(what) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkMacroCall(name, arg) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkQuote(stmts_form, stmts) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkSplice(value) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkSyntaxLit(name, body) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkStep(tactic, arg, call_start, call_end, before, arms) => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, where_only_generics_of_instance_message(), signature_constraint_span(w)),
      ck_error_frame(
        c,
        where_only_generics_of_instance_message(),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
  }
}

pub fn inf_pred_kind(w: SurfaceConstraint): SurfaceKind { constraint_single_type(w).kind }

pub fn inf_preds_missing(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text),
  missing: Bool
): Mut1(List(Text × Text), Checker) {
  match missing {
    true => frame_bind(
      <A: Unit, B: List(Text × Text)>,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        not_a_class_message(signature_constraint_class(w)),
        signature_constraint_span(w)
      )
    )
    false => inf_preds_kind(w, rest, c, gs, preds, inf_pred_kind(w))
  }
}

pub theorem inf_preds_missing_frame(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text),
  missing: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    (Text × Text)
  ). CkReadFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkReadFrame(c, inf_preds_missing(w, rest, c, gs, preds, missing)) {
  match missing {
    true => frame_bind_ok(
      <A: Unit, B: List(Text × Text)>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        not_a_class_message(signature_constraint_class(w)),
        signature_constraint_span(w)
      ),
      ck_error_frame(
        c,
        not_a_class_message(signature_constraint_class(w)),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    false => inf_preds_kind_frame(w, rest, c, gs, preds, inf_pred_kind(w), ih)
  }
}

pub theorem inf_preds_unf(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text)
): ck_instance_preds(
  Cons(w, rest),
  c,
  gs,
  preds
) = inf_preds_missing(w, rest, c, gs, preds, signature_class_missing(c, w)) { Refl }

pub theorem ck_instance_preds_frame(
  ws: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Text × Text)
): CkReadFrame(c, ck_instance_preds(ws, c, gs, preds)) {
  match ws {
    Nil => Refl
    Cons(w, rest) => Eq::subst(
      (z: Mut1(List(Text × Text), Checker)) => CkReadFrame(c, z),
      Eq::sym(inf_preds_unf(w, rest, c, gs, preds)),
      inf_preds_missing_frame(
        w,
        rest,
        c,
        gs,
        preds,
        signature_class_missing(c, w),
        next => ps => ck_instance_preds_frame(rest, next, gs, ps)
      )
    )
  }
}

pub fn inf_info_decl(info: ClassInfo): SurfaceClass { info.decl }
pub fn inf_duplicate(
  c: Checker,
  i: SurfaceInstance,
  ctor: Text
): Bool { Ordmap::contains(c.instances, instance_key(i.r#class, ctor), Ordmap::compare_text) }
pub fn inf_store(
  c: &mut Checker,
  i: SurfaceInstance,
  ctor: Text,
  g: SigGenerics,
  head: Ty,
  preds: List(Text × Text),
  made: List(SurfaceFn)
): List(SurfaceFn) {
  set_to(
    &mut c.instances,
    Ordmap::insert(
      c.instances,
      instance_key(i.r#class, ctor),
      InstanceInfo { generics: g.generics, head: head, preds: preds },
      Ordmap::compare_text
    )
  )
  made
}
pub theorem inf_store_frame(
  c: Checker,
  i: SurfaceInstance,
  ctor: Text,
  g: SigGenerics,
  head: Ty,
  preds: List(Text × Text),
  made: List(SurfaceFn)
): CkReadFrame(c, inf_store(c, i, ctor, g, head, preds, made)) { Refl }

pub fn inf_rest_duplicate(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Bool
): Mut1(List(SurfaceFn), Checker) {
  match bad {
    true => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, instance_duplicate_message(inf_class(i), ctor), inf_span(i))
    )
    false => frame_bind(
      <A: List(Text × Text), B: List(SurfaceFn)>,
      (preds: List(Text × Text), c1: Checker) => frame_bind(
        <A: Unit, B: List(SurfaceFn)>,
        (ignored1: Unit, c2: Checker) => frame_bind(
          <A: List(SurfaceFn), B: List(SurfaceFn)>,
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            <A: Unit, B: List(SurfaceFn)>,
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info))
      ),
      ck_instance_preds(inf_wheres(i), c, inf_generics(i), Nil)
    )
  }
}

pub theorem inf_rest_duplicate_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Bool
): CkReadFrame(
  c,
  inf_rest_duplicate(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
) {
  ⊢ CkReadFrame(
    c,
    inf_rest_duplicate(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
  ) from match bad {
    true => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, instance_duplicate_message(inf_class(i), ctor), inf_span(i)),
      ck_error_frame(c, instance_duplicate_message(inf_class(i), ctor), inf_span(i)),
      ignored => c1 => Refl
    )
    false => frame_bind_ok(
      <A: List(Text × Text), B: List(SurfaceFn)>,
      c,
      (preds: List(Text × Text), c1: Checker) => frame_bind(
        <A: Unit, B: List(SurfaceFn)>,
        (ignored1: Unit, c2: Checker) => frame_bind(
          <A: List(SurfaceFn), B: List(SurfaceFn)>,
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            <A: Unit, B: List(SurfaceFn)>,
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info))
      ),
      ck_instance_preds(inf_wheres(i), c, inf_generics(i), Nil),
      ck_instance_preds_frame(inf_wheres(i), c, inf_generics(i), Nil),
      preds => c1 => frame_bind_ok(
        <A: Unit, B: List(SurfaceFn)>,
        c1,
        (ignored1: Unit, c2: Checker) => frame_bind(
          <A: List(SurfaceFn), B: List(SurfaceFn)>,
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            <A: Unit, B: List(SurfaceFn)>,
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info)),
        ck_instance_laws_frame(inf_laws(i), Nil, c1, i, inf_info_decl(info)),
        ignored1 => c2 => frame_bind_ok(
          <A: List(SurfaceFn), B: List(SurfaceFn)>,
          c2,
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            <A: Unit, B: List(SurfaceFn)>,
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          ),
          ck_instance_methods_frame(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          ),
          made => c3 => frame_bind_ok(
            <A: Unit, B: List(SurfaceFn)>,
            c3,
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info)),
            ck_instance_extra_frame(inf_methods(i), c3, i, inf_info_decl(info)),
            ignored2 => c4 => inf_store_frame(c4, i, ctor, g, head, preds, made)
          )
        )
      )
    )
  }
}

pub fn inf_rest_orphan(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Bool
): Mut1(List(SurfaceFn), Checker) {
  match bad {
    true => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(
        c,
        instance_orphan_message(inf_class(i), ctor),
        inf_span(i)
      )
    )
    false => inf_rest_duplicate(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      inf_duplicate(c, i, ctor)
    )
  }
}

pub theorem inf_rest_orphan_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Bool
): CkReadFrame(
  c,
  inf_rest_orphan(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
) {
  ⊢ CkReadFrame(
    c,
    inf_rest_orphan(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
  ) from match bad {
    true => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(
        c,
        instance_orphan_message(inf_class(i), ctor),
        inf_span(i)
      ),
      ck_error_frame(
        c,
        instance_orphan_message(inf_class(i), ctor),
        inf_span(i)
      ),
      ignored => c1 => Refl
    )
    false => inf_rest_duplicate_frame(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      inf_duplicate(c, i, ctor)
    )
  }
}

pub theorem inf_rest_unf(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text
): ck_declare_instance_rest(
  c,
  i,
  info,
  own_classes,
  own_types,
  out,
  g,
  head,
  ctor,
  shown
) = inf_rest_orphan(
  c,
  i,
  info,
  own_classes,
  own_types,
  out,
  g,
  head,
  ctor,
  shown,
  Bool::and(not(text_list_has(own_classes, inf_class(i))), not(text_list_has(own_types, ctor)))
) { Refl }

pub theorem ck_declare_instance_rest_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text
): CkReadFrame(
  c,
  ck_declare_instance_rest(c, i, info, own_classes, own_types, out, g, head, ctor, shown)
) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
    Eq::sym(inf_rest_unf(c, i, info, own_classes, own_types, out, g, head, ctor, shown)),
    inf_rest_orphan_frame(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      Bool::and(not(text_list_has(own_classes, inf_class(i))), not(text_list_has(own_types, ctor)))
    )
  )
}

pub fn inf_head_span(i: SurfaceInstance): TySpan { span_at(i.head.start, i.head.end) }
pub fn inf_gens(i: SurfaceInstance): SigGenerics {
  instance_generics(
    i.generics,
    i.bounds,
    SigGenerics { generics: Nil, map: Ordmap::empty(), ctors: Nil }
  )
}
pub fn inf_message_text(m: Text × TySpan): Text { m.fst }
pub fn inf_message_span(m: Text × TySpan): TySpan { m.snd }

pub fn inf_head_message(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  ctor: Text,
  message: Option(Text × TySpan)
): Mut1(List(SurfaceFn), Checker) {
  match message {
    None => ck_rewrap1(
      ck_declare_instance_rest(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      )
    )
    Some(m) => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, inf_message_text(m), inf_message_span(m))
    )
  }
}

pub theorem inf_head_message_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  ctor: Text,
  message: Option(Text × TySpan)
): CkReadFrame(c, inf_head_message(c, i, info, own_classes, own_types, out, head, ctor, message)) {
  ⊢ CkReadFrame(
    c,
    inf_head_message(c, i, info, own_classes, own_types, out, head, ctor, message)
  ) from match message {
    None => frame_rewrap(
      c,
      ck_declare_instance_rest(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      ),
      ck_declare_instance_rest_frame(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      )
    )
    Some(m) => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, inf_message_text(m), inf_message_span(m)),
      ck_error_frame(c, inf_message_text(m), inf_message_span(m)),
      ignored => c1 => Refl
    )
  }
}

pub fn inf_head_ctor(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  found: Option(Text)
): Mut1(List(SurfaceFn), Checker) {
  match found {
    None => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, instance_head_distinct_generics_message(), inf_head_span(i))
    )
    Some(ctor) => inf_head_message(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      head,
      ctor,
      ck_instance_head_message(c, i, info, head, ctor)
    )
  }
}

pub theorem inf_head_ctor_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  found: Option(Text)
): CkReadFrame(c, inf_head_ctor(c, i, info, own_classes, own_types, out, head, found)) {
  match found {
    None => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, instance_head_distinct_generics_message(), inf_head_span(i)),
      ck_error_frame(c, instance_head_distinct_generics_message(), inf_head_span(i)),
      ignored => c1 => Refl
    )
    Some(ctor) => inf_head_message_frame(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      head,
      ctor,
      ck_instance_head_message(c, i, info, head, ctor)
    )
  }
}

pub fn inf_head_missing(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  missing: Option(Text)
): Mut1(List(SurfaceFn), Checker) {
  match missing {
    Some(name) => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, generic_not_in_head_message(name), inf_head_span(i))
    )
    None => frame_bind(
      <A: Ty, B: List(SurfaceFn)>,
      (head: Ty, c1: Checker) => inf_head_ctor(
        frame_set_constructor_position(c1, false),
        i,
        info,
        own_classes,
        own_types,
        out,
        head,
        ty_constructor(head)
      ),
      ck_written(frame_set_constructor_position(c, true), inf_head(i), signature_map(inf_gens(i)))
    )
  }
}

pub theorem inf_head_missing_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  missing: Option(Text)
): CkReadFrame(c, inf_head_missing(c, i, info, own_classes, own_types, out, missing)) {
  match missing {
    Some(name) => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, generic_not_in_head_message(name), inf_head_span(i)),
      ck_error_frame(c, generic_not_in_head_message(name), inf_head_span(i)),
      ignored => c1 => Refl
    )
    None => frame_changed(
      c,
      frame_set_constructor_position(c, true),
      frame_bind(
        <A: Ty, B: List(SurfaceFn)>,
        (head: Ty, c1: Checker) => inf_head_ctor(
          frame_set_constructor_position(c1, false),
          i,
          info,
          own_classes,
          own_types,
          out,
          head,
          ty_constructor(head)
        ),
        ck_written(frame_set_constructor_position(c, true), inf_head(i), signature_map(inf_gens(i)))
      ),
      frame_set_constructor_position_same(c, true),
      frame_bind_ok(
        <A: Ty, B: List(SurfaceFn)>,
        frame_set_constructor_position(c, true),
        (head: Ty, c1: Checker) => inf_head_ctor(
          frame_set_constructor_position(c1, false),
          i,
          info,
          own_classes,
          own_types,
          out,
          head,
          ty_constructor(head)
        ),
        ck_written(
          frame_set_constructor_position(c, true),
          inf_head(i),
          signature_map(inf_gens(i))
        ),
        ck_written_frame(
          frame_set_constructor_position(c, true),
          inf_head(i),
          signature_map(inf_gens(i))
        ),
        head => c1 => frame_changed(
          c1,
          frame_set_constructor_position(c1, false),
          inf_head_ctor(
            frame_set_constructor_position(c1, false),
            i,
            info,
            own_classes,
            own_types,
            out,
            head,
            ty_constructor(head)
          ),
          frame_set_constructor_position_same(c1, false),
          inf_head_ctor_frame(
            frame_set_constructor_position(c1, false),
            i,
            info,
            own_classes,
            own_types,
            out,
            head,
            ty_constructor(head)
          )
        )
      )
    )
  }
}

pub fn inf_head_shape(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  bad: Bool
): Mut1(List(SurfaceFn), Checker) {
  match bad {
    true => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, instance_head_distinct_generics_message(), inf_head_span(i))
    )
    false => inf_head_missing(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      generic_not_in_head(inf_generics(i), inf_head(i))
    )
  }
}

pub theorem inf_head_shape_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  bad: Bool
): CkReadFrame(c, inf_head_shape(c, i, info, own_classes, own_types, out, bad)) {
  match bad {
    true => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, instance_head_distinct_generics_message(), inf_head_span(i)),
      ck_error_frame(c, instance_head_distinct_generics_message(), inf_head_span(i)),
      ignored => c1 => Refl
    )
    false => inf_head_missing_frame(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      generic_not_in_head(inf_generics(i), inf_head(i))
    )
  }
}

pub theorem inf_at_unf(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): ck_declare_instance_at(
  c,
  i,
  info,
  own_classes,
  own_types,
  out
) = inf_head_shape(c, i, info, own_classes, own_types, out, not(instance_legacy_shape(i))) { Refl }

pub theorem ck_declare_instance_at_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkReadFrame(c, ck_declare_instance_at(c, i, info, own_classes, own_types, out)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
    Eq::sym(inf_at_unf(c, i, info, own_classes, own_types, out)),
    inf_head_shape_frame(c, i, info, own_classes, own_types, out, not(instance_legacy_shape(i)))
  )
}

pub fn inf_class_get(
  c: Checker,
  i: SurfaceInstance
): Option(ClassInfo) { Ordmap::get(c.classes, i.r#class, Ordmap::compare_text) }

pub fn inf_class_lookup(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  o: Option(ClassInfo)
): Mut1(List(SurfaceFn), Checker) {
  match o {
    None => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, not_a_class_message(inf_class(i)), inf_span(i))
    )
    Some(info) => ck_rewrap1(ck_declare_instance_at(c, i, info, own_classes, own_types, out))
  }
}

pub theorem inf_class_lookup_frame(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  o: Option(ClassInfo)
): CkReadFrame(c, inf_class_lookup(c, i, own_classes, own_types, out, o)) {
  match o {
    None => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, not_a_class_message(inf_class(i)), inf_span(i)),
      ck_error_frame(c, not_a_class_message(inf_class(i)), inf_span(i)),
      ignored => c1 => Refl
    )
    Some(info) => frame_rewrap(
      c,
      ck_declare_instance_at(c, i, info, own_classes, own_types, out),
      ck_declare_instance_at_frame(c, i, info, own_classes, own_types, out)
    )
  }
}

pub fn inf_class_structural(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  structural: Bool
): Mut1(List(SurfaceFn), Checker) {
  match structural {
    true => frame_bind(
      <A: Unit, B: List(SurfaceFn)>,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, class_structural_no_instances_message(inf_class(i)), inf_span(i))
    )
    false => inf_class_lookup(c, i, own_classes, own_types, out, inf_class_get(c, i))
  }
}

pub theorem inf_class_structural_frame(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  structural: Bool
): CkReadFrame(c, inf_class_structural(c, i, own_classes, own_types, out, structural)) {
  ⊢ CkReadFrame(
    c,
    inf_class_structural(c, i, own_classes, own_types, out, structural)
  ) from match structural {
    true => frame_bind_ok(
      <A: Unit, B: List(SurfaceFn)>,
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, class_structural_no_instances_message(inf_class(i)), inf_span(i)),
      ck_error_frame(
        c,
        class_structural_no_instances_message(inf_class(i)),
        inf_span(i)
      ),
      ignored => c1 => Refl
    )
    false => inf_class_lookup_frame(c, i, own_classes, own_types, out, inf_class_get(c, i))
  }
}

pub theorem inf_declare_unf(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): ck_declare_instance(
  c,
  i,
  own_classes,
  own_types,
  out
) = inf_class_structural(
  c,
  i,
  own_classes,
  own_types,
  out,
  class_is_structural(inf_class(i))
) { Refl }

pub theorem ck_declare_instance_frame(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkReadFrame(c, ck_declare_instance(c, i, own_classes, own_types, out)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
    Eq::sym(inf_declare_unf(c, i, own_classes, own_types, out)),
    inf_class_structural_frame(c, i, own_classes, own_types, out, class_is_structural(inf_class(i)))
  )
}

pub fn inf_list_cons(
  i: SurfaceInstance,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): Mut1(List(SurfaceFn), Checker) {
  frame_bind(
    <A: List(SurfaceFn), B: List(SurfaceFn)>,
    (made: List(SurfaceFn), c1: Checker) => ck_rewrap1(
      ck_declare_instances(rest, c1, own_classes, own_types, made)
    ),
    ck_declare_instance(c, i, own_classes, own_types, out)
  )
}

pub theorem inf_list_cons_frame(
  i: SurfaceInstance,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkReadFrame(next, ck_declare_instances(rest, next, own_classes, own_types, fs))
): CkReadFrame(c, inf_list_cons(i, rest, c, own_classes, own_types, out)) {
  frame_bind_ok(
    <A: List(SurfaceFn), B: List(SurfaceFn)>,
    c,
    (made: List(SurfaceFn), c1: Checker) => ck_rewrap1(
      ck_declare_instances(rest, c1, own_classes, own_types, made)
    ),
    ck_declare_instance(c, i, own_classes, own_types, out),
    ck_declare_instance_frame(c, i, own_classes, own_types, out),
    made => c1 => frame_rewrap(
      c1,
      ck_declare_instances(rest, c1, own_classes, own_types, made),
      ih(c1, made)
    )
  )
}

