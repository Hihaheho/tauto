      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkFnKind(
      kind,
      ty
    ) => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkBorrowLam(
      borrows,
      lam
    ) => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkOther(
      what
    ) => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkMacroCall(
      name,
      arg
    ) => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkQuote(
      stmts_form,
      stmts
    ) => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkSplice(
      value
    ) => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkSyntaxLit(
      name,
      body
    ) => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkStep(
      tactic,
      arg,
      call_start,
      call_end,
      before,
      arms
    ) => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
  }
}

fn inf_pred_kind(w: SurfaceConstraint) -> SurfaceKind { w.ty.kind }

fn inf_preds_missing(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  missing: Yn
) -> Mut1(List(Pair(Text, Text)), Checker) {
  match missing -> Mut1(List(Pair(Text, Text)), Checker) {
    yes => frame_bind(
      Unit,
      List(Pair(Text, Text)),
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        cat2(signature_constraint_class(w), " is not a class"),
        signature_constraint_span(w)
      )
    )
    no => inf_preds_kind(w, rest, c, gs, preds, inf_pred_kind(w))
  }
}

theorem inf_preds_missing_frame(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  missing: Yn,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkReadFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkReadFrame(c, inf_preds_missing(w, rest, c, gs, preds, missing)) {
  match missing -> CkReadFrame(c, inf_preds_missing(w, rest, c, gs, preds, missing)) {
    yes => frame_bind_ok(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        cat2(signature_constraint_class(w), " is not a class"),
        signature_constraint_span(w)
      ),
      ck_error_frame(
        c,
        cat2(signature_constraint_class(w), " is not a class"),
        signature_constraint_span(w)
      ),
      ignored => c1 => frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    no => inf_preds_kind_frame(w, rest, c, gs, preds, inf_pred_kind(w), ih)
  }
}

theorem inf_preds_unf(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text))
): Eq(
  Mut1(List(Pair(Text, Text)), Checker),
  ck_instance_preds(Cons(w, rest), c, gs, preds),
  inf_preds_missing(w, rest, c, gs, preds, signature_class_missing(c, w))
) { refl() }

theorem ck_instance_preds_frame(
  ws: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text))
): CkReadFrame(c, ck_instance_preds(ws, c, gs, preds)) {
  match ws -> CkReadFrame(c, ck_instance_preds(ws, c, gs, preds)) {
    Nil => refl()
    Cons(
      w,
      rest
    ) => Eq_subst(
      (z: Mut1(List(Pair(Text, Text)), Checker)) => CkReadFrame(c, z),
      Eq_sym(inf_preds_unf(w, rest, c, gs, preds)),
      inf_preds_missing_frame(
        w,
        rest,
        c,
        gs,
        preds,
        signature_class_missing(c, w),
        next => ps => ck_instance_preds_frame(rest, next, gs, ps)
      )
    )
  }
}

fn inf_info_decl(info: ClassInfo) -> SurfaceClass { info.decl }
fn inf_duplicate(
  c: Checker,
  i: SurfaceInstance,
  ctor: Text
) -> Yn { ordmap_contains(c.instances, instance_key(i.class, ctor), ordmap_compare_text) }
fn inf_store(
  &mut c: Checker,
  i: SurfaceInstance,
  ctor: Text,
  g: SigGenerics,
  head: Ty,
  preds: List(Pair(Text, Text)),
  made: List(SurfaceFn)
) -> List(SurfaceFn) {
  set_to(
    &mut c.instances,
    ordmap_insert(
      c.instances,
      instance_key(i.class, ctor),
      InstanceInfo { generics: g.generics, head: head, preds: preds },
      ordmap_compare_text
    )
  )
  made
}
theorem inf_store_frame(
  c: Checker,
  i: SurfaceInstance,
  ctor: Text,
  g: SigGenerics,
  head: Ty,
  preds: List(Pair(Text, Text)),
  made: List(SurfaceFn)
): CkReadFrame(c, inf_store(c, i, ctor, g, head, preds, made)) { refl() }

fn inf_rest_duplicate(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Yn
) -> Mut1(List(SurfaceFn), Checker) {
  match bad -> Mut1(List(SurfaceFn), Checker) {
    yes => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat3(inf_class(i), " already has an instance for ", ctor), inf_span(i))
    )
    no => frame_bind(
      List(Pair(Text, Text)),
      List(SurfaceFn),
      (
        preds: List(Pair(Text, Text)),
        c1: Checker
      ) => frame_bind(
        Unit,
        List(SurfaceFn),
        (
          ignored1: Unit,
          c2: Checker
        ) => frame_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          (
            made: List(SurfaceFn),
            c3: Checker
          ) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info))
      ),
      ck_instance_preds(inf_wheres(i), c, inf_generics(i), Nil)
    )
  }
}

theorem inf_rest_duplicate_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Yn
): CkReadFrame(
  c,
  inf_rest_duplicate(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
) {
  match bad -> CkReadFrame(
    c,
    inf_rest_duplicate(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
  ) {
    yes => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat3(inf_class(i), " already has an instance for ", ctor), inf_span(i)),
      ck_error_frame(c, cat3(inf_class(i), " already has an instance for ", ctor), inf_span(i)),
      ignored => c1 => refl()
    )
    no => frame_bind_ok(
      List(Pair(Text, Text)),
      List(SurfaceFn),
      c,
      (
        preds: List(Pair(Text, Text)),
        c1: Checker
      ) => frame_bind(
        Unit,
        List(SurfaceFn),
        (
          ignored1: Unit,
          c2: Checker
        ) => frame_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          (
            made: List(SurfaceFn),
            c3: Checker
          ) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info))
      ),
      ck_instance_preds(inf_wheres(i), c, inf_generics(i), Nil),
      ck_instance_preds_frame(inf_wheres(i), c, inf_generics(i), Nil),
      preds => c1 => frame_bind_ok(
        Unit,
        List(SurfaceFn),
        c1,
        (
          ignored1: Unit,
          c2: Checker
        ) => frame_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          (
            made: List(SurfaceFn),
            c3: Checker
          ) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info)),
        ck_instance_laws_frame(inf_laws(i), Nil, c1, i, inf_info_decl(info)),
        ignored1 => c2 => frame_bind_ok(
          List(SurfaceFn),
          List(SurfaceFn),
          c2,
          (
            made: List(SurfaceFn),
            c3: Checker
          ) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          ),
          ck_instance_methods_frame(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          ),
          made => c3 => frame_bind_ok(
            Unit,
            List(SurfaceFn),
            c3,
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info)),
            ck_instance_extra_frame(inf_methods(i), c3, i, inf_info_decl(info)),
            ignored2 => c4 => inf_store_frame(c4, i, ctor, g, head, preds, made)
          )
        )
      )
    )
  }
}

fn inf_rest_orphan(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Yn
) -> Mut1(List(SurfaceFn), Checker) {
  match bad -> Mut1(List(SurfaceFn), Checker) {
    yes => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(
        c,
        cat5(
          inf_class(i),
          cat3("(", ctor, ")"),
          " must be in the tote of ",
          inf_class(i),
          cat2(" or of ", ctor)
        ),
        inf_span(i)
      )
    )
    no => inf_rest_duplicate(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      inf_duplicate(c, i, ctor)
    )
  }
}

theorem inf_rest_orphan_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Yn
): CkReadFrame(
  c,
  inf_rest_orphan(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
) {
  match bad -> CkReadFrame(
    c,
    inf_rest_orphan(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
  ) {
    yes => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(
        c,
        cat5(
          inf_class(i),
          cat3("(", ctor, ")"),
          " must be in the tote of ",
          inf_class(i),
          cat2(" or of ", ctor)
        ),
        inf_span(i)
      ),
      ck_error_frame(
        c,
        cat5(
          inf_class(i),
          cat3("(", ctor, ")"),
          " must be in the tote of ",
          inf_class(i),
          cat2(" or of ", ctor)
        ),
        inf_span(i)
      ),
      ignored => c1 => refl()
    )
    no => inf_rest_duplicate_frame(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      inf_duplicate(c, i, ctor)
    )
  }
}

theorem inf_rest_unf(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text
): Eq(
  Mut1(List(SurfaceFn), Checker),
  ck_declare_instance_rest(c, i, info, own_classes, own_types, out, g, head, ctor, shown),
  inf_rest_orphan(
    c,
    i,
    info,
    own_classes,
    own_types,
    out,
    g,
    head,
    ctor,
    shown,
    yn_and(yn_not(text_list_has(own_classes, inf_class(i))), yn_not(text_list_has(own_types, ctor)))
  )
) { refl() }

theorem ck_declare_instance_rest_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text
): CkReadFrame(
  c,
  ck_declare_instance_rest(c, i, info, own_classes, own_types, out, g, head, ctor, shown)
) { Eq_subst(
  (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
  Eq_sym(inf_rest_unf(c, i, info, own_classes, own_types, out, g, head, ctor, shown)),
  inf_rest_orphan_frame(
    c,
    i,
    info,
    own_classes,
    own_types,
    out,
    g,
    head,
    ctor,
    shown,
    yn_and(yn_not(text_list_has(own_classes, inf_class(i))), yn_not(text_list_has(own_types, ctor)))
  )
) }

fn inf_head_span(i: SurfaceInstance) -> TySpan { span_at(i.head.start, i.head.end) }
fn inf_gens(
  i: SurfaceInstance
) -> SigGenerics { instance_generics(
  i.generics,
  i.bounds,
  SigGenerics { generics: Nil, map: ordmap_empty(), ctors: Nil }
) }
fn inf_message_text(m: Pair(Text, TySpan)) -> Text { m.fst }
fn inf_message_span(m: Pair(Text, TySpan)) -> TySpan { m.snd }

fn inf_head_message(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  ctor: Text,
  message: Option(Pair(Text, TySpan))
) -> Mut1(List(SurfaceFn), Checker) {
  match message -> Mut1(List(SurfaceFn), Checker) {
    None => ck_rewrap1(
      ck_declare_instance_rest(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      )
    )
    Some(
      m
    ) => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, inf_message_text(m), inf_message_span(m))
    )
  }
}

theorem inf_head_message_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  ctor: Text,
  message: Option(Pair(Text, TySpan))
): CkReadFrame(c, inf_head_message(c, i, info, own_classes, own_types, out, head, ctor, message)) {
  match message -> CkReadFrame(
    c,
    inf_head_message(c, i, info, own_classes, own_types, out, head, ctor, message)
  ) {
    None => frame_rewrap(
      c,
      ck_declare_instance_rest(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      ),
      ck_declare_instance_rest_frame(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      )
    )
    Some(
      m
    ) => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, inf_message_text(m), inf_message_span(m)),
      ck_error_frame(c, inf_message_text(m), inf_message_span(m)),
      ignored => c1 => refl()
    )
  }
}

fn inf_head_ctor(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  found: Option(Text)
) -> Mut1(List(SurfaceFn), Checker) {
  match found -> Mut1(List(SurfaceFn), Checker) {
    None => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, "an instance head applies a type to distinct generics", inf_head_span(i))
    )
    Some(
      ctor
    ) => inf_head_message(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      head,
      ctor,
      ck_instance_head_message(c, i, info, head, ctor)
    )
  }
}

theorem inf_head_ctor_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  found: Option(Text)
): CkReadFrame(c, inf_head_ctor(c, i, info, own_classes, own_types, out, head, found)) {
  match found -> CkReadFrame(
    c,
    inf_head_ctor(c, i, info, own_classes, own_types, out, head, found)
  ) {
    None => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ck_error_frame(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ignored => c1 => refl()
    )
    Some(
      ctor
    ) => inf_head_message_frame(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      head,
      ctor,
      ck_instance_head_message(c, i, info, head, ctor)
    )
  }
}

fn inf_head_missing(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  missing: Option(Text)
) -> Mut1(List(SurfaceFn), Checker) {
  match missing -> Mut1(List(SurfaceFn), Checker) {
    Some(
      name
    ) => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(name, " does not appear in the head"), inf_head_span(i))
    )
    None => frame_bind(
      Ty,
      List(SurfaceFn),
      (
        head: Ty,
        c1: Checker
      ) => inf_head_ctor(
        frame_set_constructor_position(c1, no),
        i,
        info,
        own_classes,
        own_types,
        out,
        head,
        ty_constructor(head)
      ),
      ck_written(frame_set_constructor_position(c, yes), inf_head(i), signature_map(inf_gens(i)))
    )
  }
}

theorem inf_head_missing_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  missing: Option(Text)
): CkReadFrame(c, inf_head_missing(c, i, info, own_classes, own_types, out, missing)) {
  match missing -> CkReadFrame(
    c,
    inf_head_missing(c, i, info, own_classes, own_types, out, missing)
  ) {
    Some(
      name
    ) => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(name, " does not appear in the head"), inf_head_span(i)),
      ck_error_frame(c, cat2(name, " does not appear in the head"), inf_head_span(i)),
      ignored => c1 => refl()
    )
    None => frame_changed(
      c,
      frame_set_constructor_position(c, yes),
      frame_bind(
        Ty,
        List(SurfaceFn),
        (
          head: Ty,
          c1: Checker
        ) => inf_head_ctor(
          frame_set_constructor_position(c1, no),
          i,
          info,
          own_classes,
          own_types,
          out,
          head,
          ty_constructor(head)
        ),
        ck_written(frame_set_constructor_position(c, yes), inf_head(i), signature_map(inf_gens(i)))
      ),
      frame_set_constructor_position_same(c, yes),
      frame_bind_ok(
        Ty,
        List(SurfaceFn),
        frame_set_constructor_position(c, yes),
        (
          head: Ty,
          c1: Checker
        ) => inf_head_ctor(
          frame_set_constructor_position(c1, no),
          i,
          info,
          own_classes,
          own_types,
          out,
          head,
          ty_constructor(head)
        ),
        ck_written(frame_set_constructor_position(c, yes), inf_head(i), signature_map(inf_gens(i))),
        ck_written_frame(
          frame_set_constructor_position(c, yes),
          inf_head(i),
          signature_map(inf_gens(i))
        ),
        head => c1 => frame_changed(
          c1,
          frame_set_constructor_position(c1, no),
          inf_head_ctor(
            frame_set_constructor_position(c1, no),
            i,
            info,
            own_classes,
            own_types,
            out,
            head,
            ty_constructor(head)
          ),
          frame_set_constructor_position_same(c1, no),
          inf_head_ctor_frame(
            frame_set_constructor_position(c1, no),
            i,
            info,
            own_classes,
            own_types,
            out,
            head,
            ty_constructor(head)
          )
        )
      )
    )
  }
}

fn inf_head_shape(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  bad: Yn
) -> Mut1(List(SurfaceFn), Checker) {
  match bad -> Mut1(List(SurfaceFn), Checker) {
    yes => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, "an instance head applies a type to distinct generics", inf_head_span(i))
    )
    no => inf_head_missing(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      generic_not_in_head(inf_generics(i), inf_head(i))
    )
  }
}

theorem inf_head_shape_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  bad: Yn
): CkReadFrame(c, inf_head_shape(c, i, info, own_classes, own_types, out, bad)) {
  match bad -> CkReadFrame(c, inf_head_shape(c, i, info, own_classes, own_types, out, bad)) {
    yes => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ck_error_frame(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ignored => c1 => refl()
    )
    no => inf_head_missing_frame(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      generic_not_in_head(inf_generics(i), inf_head(i))
    )
  }
}

theorem inf_at_unf(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): Eq(
  Mut1(List(SurfaceFn), Checker),
  ck_declare_instance_at(c, i, info, own_classes, own_types, out),
  inf_head_shape(
    c,
    i,
    info,
    own_classes,
    own_types,
    out,
    yn_not(head_shape_ok(inf_head(i), inf_generics(i)))
  )
) { refl() }

theorem ck_declare_instance_at_frame(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkReadFrame(
  c,
  ck_declare_instance_at(c, i, info, own_classes, own_types, out)
) { Eq_subst(
  (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
  Eq_sym(inf_at_unf(c, i, info, own_classes, own_types, out)),
  inf_head_shape_frame(
    c,
    i,
    info,
    own_classes,
    own_types,
    out,
    yn_not(head_shape_ok(inf_head(i), inf_generics(i)))
  )
) }

fn inf_class_get(
  c: Checker,
  i: SurfaceInstance
) -> Option(ClassInfo) { ordmap_get(c.classes, i.class, ordmap_compare_text) }

fn inf_class_lookup(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  o: Option(ClassInfo)
) -> Mut1(List(SurfaceFn), Checker) {
  match o -> Mut1(List(SurfaceFn), Checker) {
    None => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(inf_class(i), " is not a class"), inf_span(i))
    )
    Some(info) => ck_rewrap1(ck_declare_instance_at(c, i, info, own_classes, own_types, out))
  }
}

theorem inf_class_lookup_frame(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  o: Option(ClassInfo)
): CkReadFrame(c, inf_class_lookup(c, i, own_classes, own_types, out, o)) {
  match o -> CkReadFrame(c, inf_class_lookup(c, i, own_classes, own_types, out, o)) {
    None => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(inf_class(i), " is not a class"), inf_span(i)),
      ck_error_frame(c, cat2(inf_class(i), " is not a class"), inf_span(i)),
      ignored => c1 => refl()
    )
    Some(
      info
    ) => frame_rewrap(
      c,
      ck_declare_instance_at(c, i, info, own_classes, own_types, out),
      ck_declare_instance_at_frame(c, i, info, own_classes, own_types, out)
    )
  }
}

fn inf_class_structural(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  structural: Yn
) -> Mut1(List(SurfaceFn), Checker) {
  match structural -> Mut1(List(SurfaceFn), Checker) {
    yes => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(inf_class(i), " is structural and has no instances to write"), inf_span(i))
    )
    no => inf_class_lookup(c, i, own_classes, own_types, out, inf_class_get(c, i))
  }
}

theorem inf_class_structural_frame(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  structural: Yn
): CkReadFrame(c, inf_class_structural(c, i, own_classes, own_types, out, structural)) {
  match structural -> CkReadFrame(
    c,
    inf_class_structural(c, i, own_classes, own_types, out, structural)
  ) {
    yes => frame_bind_ok(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(inf_class(i), " is structural and has no instances to write"), inf_span(i)),
      ck_error_frame(
        c,
        cat2(inf_class(i), " is structural and has no instances to write"),
        inf_span(i)
      ),
      ignored => c1 => refl()
    )
    no => inf_class_lookup_frame(c, i, own_classes, own_types, out, inf_class_get(c, i))
  }
}

theorem inf_declare_unf(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): Eq(
  Mut1(List(SurfaceFn), Checker),
  ck_declare_instance(c, i, own_classes, own_types, out),
  inf_class_structural(c, i, own_classes, own_types, out, class_is_structural(inf_class(i)))
) { refl() }

theorem ck_declare_instance_frame(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkReadFrame(
  c,
  ck_declare_instance(c, i, own_classes, own_types, out)
) { Eq_subst(
  (z: Mut1(List(SurfaceFn), Checker)) => CkReadFrame(c, z),
  Eq_sym(inf_declare_unf(c, i, own_classes, own_types, out)),
  inf_class_structural_frame(c, i, own_classes, own_types, out, class_is_structural(inf_class(i)))
) }

fn inf_list_cons(
  i: SurfaceInstance,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
) -> Mut1(List(SurfaceFn), Checker) {
  frame_bind(
    List(SurfaceFn),
    List(SurfaceFn),
    (
      made: List(SurfaceFn),
      c1: Checker
    ) => ck_rewrap1(ck_declare_instances(rest, c1, own_classes, own_types, made)),
    ck_declare_instance(c, i, own_classes, own_types, out)
  )
}

theorem inf_list_cons_frame(
  i: SurfaceInstance,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkReadFrame(next, ck_declare_instances(rest, next, own_classes, own_types, fs))
): CkReadFrame(c, inf_list_cons(i, rest, c, own_classes, own_types, out)) {
  frame_bind_ok(
    List(SurfaceFn),
    List(SurfaceFn),
    c,
    (
      made: List(SurfaceFn),
      c1: Checker
    ) => ck_rewrap1(ck_declare_instances(rest, c1, own_classes, own_types, made)),
    ck_declare_instance(c, i, own_classes, own_types, out),
    ck_declare_instance_frame(c, i, own_classes, own_types, out),
    made => c1 => frame_rewrap(
      c1,
      ck_declare_instances(rest, c1, own_classes, own_types, made),
      ih(c1, made)
    )
  )
}

