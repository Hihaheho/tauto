import "summary_sound.taut"
import std::map
import std::map_laws
import std::map_text
import std::row
import std::text
import "datas.taut"
import std::builtin::ord

pub fn data_entry_value(e: Text × Data): Data { e.snd }
pub theorem data_keys_head(
  e: Text × Data,
  rest: List(Text × Data),
  n: Text,
  keys: Ordmap::keys(Cons(e, rest), n, Less, Ordmap::compare_text)
): Ordmap::compare_text(n, summary_key(e)) = Less {
  match e {
    #(name, value) => And::left(keys)
  }
}
pub theorem data_keys_tail(
  e: Text × Data,
  rest: List(Text × Data),
  n: Text,
  keys: Ordmap::keys(Cons(e, rest), n, Less, Ordmap::compare_text)
): Ordmap::keys(rest, n, Less, Ordmap::compare_text) {
  match e {
    #(name, value) => And::right(keys)
  }
}
// Entries enumerate the actual bindings of an ordered declaration map.
pub theorem data_keys_member<e: Text × Data, es: List(
  (Text × Data)
)>(
  member: Mem(Text × Data, e, es),
  n: Text,
  keys: Ordmap::keys(es, n, Less, Ordmap::compare_text)
): Ordmap::compare_text(n, summary_key(e)) = Less {
  match member {
    MemHere(rest) => data_keys_head(e, rest, n, keys)
    MemThere(first, rest, tail) => data_keys_member(tail, n, data_keys_tail(first, rest, n, keys))
  }
}

pub theorem data_list_head_lookup(
  e: Text × Data,
  rest: List(Text × Data)
): Ordmap::list_get(
  Cons(e, rest),
  summary_key(e),
  Ordmap::compare_text
) = Some(data_entry_value(e)) {
  ⊢ Ordmap::list_get(
    Cons(e, rest),
    summary_key(e),
    Ordmap::compare_text
  ) = Some(data_entry_value(e)) from match e {
    #(name, value) => Ordmap::list_get_equal(
      name,
      value,
      rest,
      name,
      Ordmap::compare_text,
      Ordmap::law_same(Ordmap::compare_text, Ordmap::compare_text_law(), name)
    )
  }
}
pub theorem data_sorted_tail(
  e: Text × Data,
  rest: List(Text × Data),
  ordered: Ordmap::sorted(Cons(e, rest), Ordmap::compare_text)
): Ordmap::sorted(rest, Ordmap::compare_text) {
  match e {
    #(name, value) => And::right(ordered)
  }
}
pub theorem data_list_skip_member(
  first: Text × Data,
  rest: List(Text × Data),
  e: Text × Data,
  member: Mem(Text × Data, e, rest),
  ordered: Ordmap::sorted(Cons(first, rest), Ordmap::compare_text)
): Ordmap::list_get(
  Cons(first, rest),
  summary_key(e),
  Ordmap::compare_text
) = Ordmap::list_get(rest, summary_key(e), Ordmap::compare_text) {
  ⊢ Ordmap::list_get(
    Cons(first, rest),
    summary_key(e),
    Ordmap::compare_text
  ) = Ordmap::list_get(rest, summary_key(e), Ordmap::compare_text) from match first {
    #(name, value) => Ordmap::list_get_skip(
      Greater,
      q => greater_ne_equal(q),
      name,
      value,
      rest,
      summary_key(e),
      Ordmap::compare_text,
      Ordmap::law_flip_less(
        Ordmap::compare_text,
        Ordmap::compare_text_law(),
        name,
        summary_key(e),
        data_keys_member(member, name, And::left(ordered))
      )
    )
  }
}

pub theorem data_list_member_lookup<e: Text × Data, es: List(
  (Text × Data)
)>(
  member: Mem(Text × Data, e, es),
  ordered: Ordmap::sorted(es, Ordmap::compare_text)
): Ordmap::list_get(es, summary_key(e), Ordmap::compare_text) = Some(data_entry_value(e)) {
  ⊢ Ordmap::list_get(
    es,
    summary_key(e),
    Ordmap::compare_text
  ) = Some(data_entry_value(e)) from match member {
    MemHere(rest) => data_list_head_lookup(e, rest)
    MemThere(first, rest, tail) => Eq::trans(
      data_list_skip_member(first, rest, e, tail, ordered),
      data_list_member_lookup(tail, data_sorted_tail(first, rest, ordered))
    )
  }
}

pub theorem data_entries_lookup(
  m: Ordmap(Text, Data),
  e: Text × Data,
  ordered: Ordmap::ordered(m, Ordmap::compare_text),
  member: Mem(Text × Data, e, Ordmap::entries(m))
): Ordmap::get(m, summary_key(e), Ordmap::compare_text) = Some(data_entry_value(e)) {
  Eq::trans(
    Ordmap::tree_get_entries(
      Ordmap::compare_text,
      Ordmap::compare_text_law(),
      Ordmap::tree(m),
      summary_key(e),
      ordered
    ),
    data_list_member_lookup(member, ordered)
  )
}
