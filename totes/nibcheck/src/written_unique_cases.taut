import "written_value_base.taut"
import std::map
import std::text
import "datas.taut"
import "rules_written.taut"
import "ty.taut"
import "../../surface/src/surface.taut"
import "written_unique_base.taut"
import "written_unique_info.taut"
import "../../identity/src/identity.taut"

// Uniqueness of the elaborated value, continued: unions, products and tagged types.

pub theorem written_unique_union<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, parts: List(
  SurfaceTerm
), other: Ty>(
  meaning: WrittenKind(env, generics, partial, r#borrow, SkUnion(parts), other),
  types: List(Ty),
  ih: WrittenTermsUnique(generics, partial, parts, types)
): ty_union(types) = other {
  match meaning {
    WrittenKindUnion(gs, Mode, borrowing, terms, values, inner) => Eq::congr(
      ty_union,
      ih(env, values, inner)
    )
  }
}

pub theorem written_unique_product<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, parts: List(
  SurfaceTerm
), start: Nat, end: Nat, other: Ty>(
  ast_occurrence: Option(TermOccurrence),
  meaning: WrittenKind(
    env,
    generics,
    partial,
    r#borrow,
    SkApp(SurfaceTermIndexedMk(SkVar(NameSpelled("std::prelude::Pair")), start, end, ast_occurrence), parts),
    other
  ),
  types: List(Ty),
  two: list_len(parts) = 2,
  ih: WrittenTermsUnique(generics, partial, parts, types)
): Eq(Ty, ty_product(types), other) {
  match meaning {
    WrittenKindProduct(ctor_ast_occurrence, gs, mode, borrowing, terms, values, begin, finish, Two, inner) => Eq::congr(
      ty_product,
      ih(env, values, inner)
    )
    WrittenKindNamed(ctor_ast_occurrence, gs, Mode, borrowing, name, args, values, begin, finish, NotPair, not_info, unbound, SliceBorrowed, arguments, arity) => False::elim(
      NotPair(Refl)
    )
    WrittenKindGeneric(ctor_ast_occurrence, gs, Mode, borrowing, spelling, first, head, value, bound, begin, finish, not_info, Parameter, constructor, argument) => False::elim(
      false_ne_true(Eq::sym(Eq::congr((n: Nat) => Nat::eq(n, 1), two)))
    )
  }
}
pub theorem written_unique_tagged<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, tag: Text, body: SurfaceTerm, other: Ty>(
  meaning: WrittenKind(env, generics, partial, r#borrow, SkTagged(tag, body), other),
  t: Ty,
  ih: WrittenTermUnique(generics, partial, false, body, t)
): ty_tagged(Cons(tag, Nil), t) = other {
  match meaning {
    WrittenKindTagged(gs, Mode, borrowing, label, term, value, inner) => Eq::congr(
      (x: Ty) => ty_tagged(Cons(label, Nil), x),
      ih(env, value, inner)
    )
  }
}
