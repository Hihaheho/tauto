pub theorem local_find_choice_absent(
  head: Local,
  rest: List(Local),
  name: Text,
  same: Bool,
  comparison: Text::eq(expr_local_name(head), name) = same,
  missing: local_find_choice(head, rest, name, same) = None,
  ih: ∀ absent: env_find(rest, name) = None. LocalAbsent(name, rest)
): LocalAbsent(name, Cons(head, rest)) {
  match same {
    true => False::elim(ck_none_ne_some(head, Eq::sym(missing)))
    false => LocalAbsentCons(
      head,
      equal => local_text_different(expr_local_name(head), name, comparison, equal),
      ih(missing)
    )
  }
}
pub theorem env_find_absent(
  env: List(Local),
  name: Text,
  missing: env_find(env, name) = None
): LocalAbsent(name, env) {
  match env {
    Nil => LocalAbsentNil
    Cons(head, rest) => local_find_choice_absent(
      head,
      rest,
      name,
      Text::eq(expr_local_name(head), name),
      Refl,
      Eq::trans(Eq::sym(local_find_unf(head, rest, name)), missing),
      absent => env_find_absent(rest, name, absent)
    )
  }
}
pub theorem ck_lookup_function_value(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  scheme: Scheme,
  missing: env_find(env, name) = None,
  found: Ordmap::get(leaf_functions(c), name, Ordmap::compare_text) = Some(scheme)
): ck_lookup(c, name, env, span, occurrence) = ck_instantiate_scheme(c, name, scheme, span) {
  Eq::trans(
    leaf_lookup_unf(c, name, env, span, occurrence),
    Eq::trans(
      Eq::congr((local: Option(Local)) => leaf_lookup(c, name, env, span, occurrence, local), missing),
      Eq::trans(
        Eq::congr(
          (stored: Option(Scheme)) => leaf_lookup_function(c, name, env, span, occurrence, stored),
          found
        ),
        ck_rewrap1_id(ck_instantiate_scheme(c, name, scheme, span))
      )
    )
  )
}
// Recording a use that gives no generic a type leaves the checker as it was.
pub theorem ck_record_no_use(
  c: Checker,
  name: Text,
  span: TySpan
): ck_st(ck_record_use(c, name, Nil, span)) = c {
  match c {
    CheckerMk(x_classes, x_instances, x_subst, x_next, x_ints, x_fns, x_effects, x_quants, x_datas, x_errors, x_ops, x_literals, x_returns, x_exceeded, x_lets, x_bounds, x_ctor_bounds, x_constructor_position, x_rigids, x_kept, x_assume, x_pending, x_constructor_uses, x_uses, x_locals, x_terms, x_closure_results, x_hint, x_result_hint, x_arm_hint, x_under_borrow, x_type_params, x_widen_products, x_steps, x_table) => Refl
  }
}
pub theorem ck_instantiate_monomorphic(
  c: Checker,
  name: Text,
  declared: Ty,
  ctors: List(Text × Kind),
  span: TySpan
): ck_instantiate_scheme(
  c,
  name,
  SchemeMk(Nil, declared, Nil, ctors),
  span
) = mut1(ty_substitute(declared, Ordmap::empty()), c) {
  Eq::subst(
    (z: Checker) => ck_instantiate_scheme(
      c,
      name,
      SchemeMk(Nil, declared, Nil, ctors),
      span
    ) = mut1(ty_substitute(declared, Ordmap::empty()), z),
    ck_record_no_use(c, name, span),
    Refl
  )
}
pub theorem ck_lookup_monomorphic_value(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  occurrence: Option(TermOccurrence),
  declared: Ty,
  ctors: List(Text × Kind),
  missing: env_find(env, name) = None,
  found: Ordmap::get(
    leaf_functions(c),
    name,
    Ordmap::compare_text
  ) = Some(SchemeMk(Nil, declared, Nil, ctors))
): ck_lookup(c, name, env, span, occurrence) = mut1(ty_substitute(declared, Ordmap::empty()), c) {
  Eq::trans(
    ck_lookup_function_value(
      c,
      name,
      env,
      span,
      occurrence,
      SchemeMk(Nil, declared, Nil, ctors),
      missing,
      found
    ),
    ck_instantiate_monomorphic(c, name, declared, ctors, span)
  )
}
pub theorem ck_lookup_monomorphic_sound(
  c: Checker,
  name: SurfaceName,
  env: List(Local),
  start: Nat,
  end: Nat,
  declared: Ty,
  ctors: List(Text × Kind),
  missing: env_find(env, surface_name_text(name)) = None,
  found: Ordmap::get(
    leaf_functions(c),
    surface_name_text(name),
    Ordmap::compare_text
  ) = Some(SchemeMk(Nil, declared, Nil, ctors))
): MonomorphicFunctionTyping(
  ck_subst_of(c),
  env,
  leaf_functions(c),
  surface_term_mk(SkVar(name), start, end),
  ck_val(ck_lookup(c, surface_name_text(name), env, TySpan {start: start, end: end}, None))
) {
  Eq::subst(
    (m: Mut1(Ty, Checker)) => MonomorphicFunctionTyping(
      ck_subst_of(c),
      env,
      leaf_functions(c),
      surface_term_mk(SkVar(name), start, end),
      ck_val(m)
    ),
    Eq::sym(
      ck_lookup_monomorphic_value(
        c,
        surface_name_text(name),
        env,
        TySpan {start: start, end: end},
        None,
        declared,
        ctors,
        missing,
        found
      )
    ),
    MonomorphicFunction(
      name,
      declared,
      ctors,
      start,
      end,
      FunctionReference::Mk(env_find_absent(env, surface_name_text(name), missing), found),
      ty_substitute_empty_equal(
        declared,
        ck_subst_of(c),
        (gs: List(Text × Kind), rigid: Ordmap(Text, Ty), a: Ty, b: Ty) => RigidFor(
          ck_subst_of(c),
          gs,
          rigid,
          a,
          b
        )
      )
    )
  )
}
