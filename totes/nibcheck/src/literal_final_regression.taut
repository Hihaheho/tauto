import "fuel_sound.taut"

pub theorem literal_unresolved_final_is_error(): fuel_has_errors(
    fuel_errors(ck_st(ck_check_literal(checker_new(0), TyLiteralMk(0, 1, false, 1, TyVar(0)))))
  ) = true { Refl }
pub theorem literal_noninteger_final_is_error(): fuel_has_errors(
    fuel_errors(ck_st(ck_check_literal(checker_new(1), TyLiteralMk(0, 1, false, 1, TyBool))))
  ) = true { Refl }
