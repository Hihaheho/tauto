import "rules_data_body.taut"
import "data_metadata_sound.taut"
import std::Map
import std::Text
import "datas.taut"
import "summary_sound.taut"
import "../../surface/src/surface.taut"

pub theorem body_metadata_ignores(
  o: Option(Data)
): body_ctors_option(data_metadata_option(o)) = body_ctors_option(o) {
  ⊢ body_ctors_option(data_metadata_option(o)) = body_ctors_option(o) from match o {
    None => Refl
    Some(data) => Refl
  }
}
pub theorem body_lookup_metadata(
  a: Ordmap(Text, Data),
  b: Ordmap(Text, Data),
  name: Text,
  same: data_metadata_lookup(a, name) = data_metadata_lookup(b, name)
): body_ctors_option(
  Ordmap::get(a, name, Ordmap::compare_text)
) = body_ctors_option(Ordmap::get(b, name, Ordmap::compare_text)) {
  Eq::trans(
    Eq::sym(body_metadata_ignores(Ordmap::get(a, name, Ordmap::compare_text))),
    Eq::trans(
      Eq::congr(body_ctors_option, same),
      body_metadata_ignores(Ordmap::get(b, name, Ordmap::compare_text))
    )
  )
}
pub theorem body_registered_lookup<env: Datas, source: SurfaceData>(
  registered: DataBodyRegistered(env, source),
  next: Datas,
  same: body_lookup(next, body_source_name(source)) = body_lookup(env, body_source_name(source))
): DataBodyRegistered(next, source) {
  ⊢ DataBodyRegistered(next, source) from match registered {
    Mk(constructors, found, known) => DataBodyRegistered::Mk(
      constructors,
      Eq::trans(same, found),
      known
    )
  }
}
pub theorem body_registered_metadata<env: Datas, source: SurfaceData>(
  registered: DataBodyRegistered(env, source),
  next: Datas,
  same: DataMetadataSame(summary_decls(next), summary_decls(env))
): DataBodyRegistered(next, source) {
  body_registered_lookup(
    registered,
    next,
    body_lookup_metadata(
      summary_decls(next),
      summary_decls(env),
      body_source_name(source),
      same(body_source_name(source))
    )
  )
}
