import std::text_ops
import "messages.taut"
import "../../surface/src/surface.taut"
import "../../surface/src/extern_blocks.taut"
import "../../ordmap/src/ordmap.taut"
import "../../text/src/text.taut"
import std::text
import std::base
import std::map
import "rows_base.taut"
import "rows_structural.taut"
import "../../identity/src/identity.taut"

// Effect rows of executable code: the analysis itself. The quantities, row
// sets and state it reads and writes are in `rows_base.taut`.


// ---- the analysis ----------------------------------------------------------------
//
// The analysis follows calls to the bodies of other functions, so its
// readers share a number of steps; each gives one
// fewer to what it calls. When the steps run out a reader finds nothing.

mutual {
  // The row callers see: the written one, else the inferred one.
  pub fn rows_fn_row(k: Nat, env: RowEnv, s: RowState, name: Text): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match rows_env_fn(env, name) {
        None => RowsOut::Mk(rowset_empty(), s)
        Some(f) => ⊢ RowsOut from match rows_has_prefix(name, "extract_unreachable") {
          // The stand-in extraction writes for a match with no arms never runs.
          true => RowsOut::Mk(rowset_empty(), s)
          false => ⊢ RowsOut from match rows_written_of(f) {
            Some(written) => RowsOut::Mk(rowset_of(row_entries_text(written)), s)
            None => rows_inferred_row(j, env, s, name)
          }
        }
      }
    }
  }

  // What the body performs, whatever the written row says.
  pub fn rows_inferred_row(k: Nat, env: RowEnv, s: RowState, name: Text): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match rows_env_fn(env, name) {
        None => RowsOut::Mk(rowset_empty(), s)
        Some(f) => ⊢ RowsOut from match Ordmap::get(s.memo, name, Ordmap::compare_text) {
          Some(row) => RowsOut::Mk(row, s)
          None => ⊢ RowsOut from match Ordmap::get(s.pass_rows, name, Ordmap::compare_text) {
            Some(row) => RowsOut::Mk(
              row,
              rows_set_leaned(
                s,
                rowset_add_all(
                  rowset_list(rows_row_or_empty(Ordmap::get(s.pass_leaned, name, Ordmap::compare_text))),
                  s.leaned
                )
              )
            )
            None => ⊢ RowsOut from match Ordmap::contains(s.in_progress, name, Ordmap::compare_text) {
              // Its row is not known yet: the last pass's, with `div` unless
              // its recursion is structural.
              true => RowsOut::Mk(
                rows_set_add_div(
                  rows_row_or_empty(Ordmap::get(s.seeds, name, Ordmap::compare_text)),
                  rows_recursion_diverges(j, env, f)
                ),
                rows_set_leaned(s, rowset_add(s.leaned, name))
              )
              false => rows_settle(j, env, name, f, s.leaned, s.pass_log, rows_follow(j, env, s, name, f))
            }
          }
        }
      }
    }
  }

  // One pass over the body of `name`.
  pub fn rows_follow(k: Nat, env: RowEnv, s: RowState, name: Text, f: SurfaceFn): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => rows_followed(
        name,
        f,
        rows_recursion_diverges(j, env, f),
        s.direct_vars,
        rows_term_row(
          j,
          env,
          rows_set_direct(
            rows_set_in_progress(
              rows_set_pass_log(rows_set_leaned(s, rowset_empty()), Nil),
              Ordmap::insert(s.in_progress, name, true, Ordmap::compare_text)
            ),
            rows_direct_generics(f.generics, f.bounds)
          ),
          f.body,
          rows_params_locals(f.params, f.param_types)
        )
      )
    }
  }

  // A body that reads a function still being followed is in a recursive
  // group, whose rows are found together: each pass reads the rows the last
  // one found where it reaches a member being followed, until a pass finds
  // them again. Only then are they kept in `memo`; a row found from a guess
  // would miss what the guessed member performs.
  pub fn rows_settle(
    k: Nat,
    env: RowEnv,
    name: Text,
    f: SurfaceFn,
    outer_leaned: RowSet,
    outer_log: List(Text),
    r: RowsOut
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(r.s)
      Succ(j) => ⊢ RowsOut from match rowset_list(rowset_drop(r.s.leaned, name)) {
        Nil => ⊢ RowsOut from match (
          not(rowset_has(r.s.leaned, name)) && rows_names_same(r.s.pass_log, Nil)
        ) || (
          rows_seeded(r.s, name, r.row) && rows_members_seeded(r.s, r.s.pass_log)
        ) {
          true => RowsOut::Mk(
            r.row,
            rows_set_pass_log(
              rows_set_leaned(
                rows_set_seed(rows_close_members(r.s, r.s.pass_log, true), name, r.row, true),
                outer_leaned
              ),
              outer_log
            )
          )
          false => rows_settle(
            j,
            env,
            name,
            f,
            outer_leaned,
            outer_log,
            rows_follow(
              j,
              env,
              rows_set_seed(rows_close_members(r.s, r.s.pass_log, false), name, r.row, false),
              name,
              f
            )
          )
        }
        _ => rows_member(
          name,
          r.row,
          rowset_drop(r.s.leaned, name),
          r.s,
          outer_leaned,
          outer_log
        )
      }
    }
  }

  // What a call to the value `t` performs, when it can be told.
  pub fn rows_latent_of(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: SurfaceTerm,
    locals: List(RowLocal)
  ): LatentOut {
    match k {
      Zero => LatentOut::Mk(LatentUnknown, s)
      Succ(j) => ⊢ LatentOut from match t.kind {
        SkLam(params, body, _, _) => rows_known(
          rows_term_row(j, env, s, body, rows_unknown_all(params, locals))
        )
        SkBorrowLam(^r#borrows, lam) => rows_latent_of(j, env, s, lam, locals)
        SkBorrow(^mutable, ^mutable_orig, term) => rows_latent_of(j, env, s, term, locals)
        SkVar(n) => ⊢ LatentOut from match rows_local_find(locals, surface_name_text(n)) {
          Some(l) => LatentOut::Mk(l.latent, s)
          None => ⊢ LatentOut from match rows_env_has(env, surface_name_text(n)) {
            true => rows_known(rows_fn_row(j, env, s, surface_name_text(n)))
            false => LatentOut::Mk(LatentUnknown, s)
          }
        }
        _ => LatentOut::Mk(LatentUnknown, s)
      }
    }
  }

  pub fn rows_terms_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    terms: List(SurfaceTerm),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match terms {
        Nil => RowsOut::Mk(row, s)
        Cons(a, rest) => {
          let r := rows_term_row(j, env, s, a, locals)
          rows_terms_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
        }
      }
    }
  }

  pub fn rows_fields_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    fields: List(SurfaceField),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match fields {
        Nil => RowsOut::Mk(row, s)
        Cons(f, rest) => {
          let r := rows_term_row(j, env, s, f.value, locals)
          rows_fields_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
        }
      }
    }
  }

  pub fn rows_term_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: SurfaceTerm,
    locals: List(RowLocal)
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match t.kind {
        SkPerform(eff, args) => rows_performed(
          t,
          rowset_one(rows_effect_of_op(eff)),
          rows_terms_row(j, env, s, args, locals, rowset_empty())
        )
        SkRecord(^name, fields) => rows_fields_row(j, env, s, fields, locals, rowset_empty())
        SkBorrow(^mutable, ^mutable_orig, term) => rows_term_row(j, env, s, term, locals)
        SkApp(function, arguments) => {
          // The arguments' rows apart, so that `r.row`, recorded for the call,
          // is what the call itself performs.
          let args := rows_terms_row(j, env, s, rows_checked_args(env, function, arguments, locals), locals, rowset_empty())
          let r := rows_callee_row(j, env, args.s, t, function, arguments, locals)
          let own := rows_with_operator(env, t, function, locals, r.row)
          RowsOut::Mk(rowset_union(own, args.row), rows_record_app(r.s, t, function, arguments, own))
        }
        SkBudget(steps_memory, steps, body) => {
          let a := rows_term_row(j, env, s, steps, locals)
          let b := rows_term_row(j, env, a.s, body, locals)
          // Only steps stop a body that does not: a memory budget leaves
          // `div` in the row.
          // The host counts, so running a budget is an effect, its
          // operation's: `budget` or `budget_memory`.
          RowsOut::Mk(rowset_add(rowset_add(rowset_union(a.row, rows_budget_inner(steps_memory, b.row)), "exceeded"), surface_budget_operation(steps_memory)), b.s)
        }
        SkHandle(body, handlers) => {
          let inner := rows_term_row(j, env, s, body, locals)
          // The arms read once with continuations that perform nothing, for
          // what each performs of its own; then again with each `k`
          // performing what resuming performs (`resumed_row` of `rows.rs`).
          let own := rows_handlers_own(j, env, inner.s, handlers, locals)
          rows_handlers_row(
            j,
            env,
            inner.s,
            handlers,
            rows_resumed_all(body, inner.row, handlers, handlers, own),
            own,
            locals,
            rows_answered(handlers, inner.row)
          )
        }
        // Making a function performs nothing; its row is latent.
        // Its body is still followed, so that the calls in it are recorded,
        // as `value_of` of `rows.rs` follows it.
        SkLam(params, body, _, _) => RowsOut::Mk(
          rowset_empty(),
          rows_term_row(j, env, s, body, rows_unknown_all(params, locals)).s
        )
        SkBlock(stmts) => rows_stmts_row(j, env, s, stmts, locals, rowset_empty())
        SkIf(condition, then, otherwise) => {
          let a := rows_term_row(j, env, s, condition, locals)
          let b := rows_term_row(j, env, a.s, then, locals)
          rows_union3(a.row, b.row, rows_opt_row(j, env, b.s, otherwise, locals))
        }
        SkField(base, ^name) => rows_term_row(j, env, s, base, locals)
        SkTagged(^tag, term) => rows_term_row(j, env, s, term, locals)
        SkMatch(scrutinee, ^result, arms, ^binder, _) => {
          let a := rows_term_row(j, env, s, scrutinee, locals)
          rows_arms_row(j, env, a.s, arms, locals, a.row)
        }
        _ => RowsOut::Mk(rowset_empty(), s)
      }
    }
  }

  pub fn rows_opt_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: Option(SurfaceTerm),
    locals: List(RowLocal)
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match t {
        Some(x) => rows_term_row(j, env, s, x, locals)
        None => RowsOut::Mk(rowset_empty(), s)
      }
    }
  }

  pub fn rows_arms_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    arms: List(SurfaceArm),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match arms {
        Nil => RowsOut::Mk(row, s)
        Cons(arm, rest) => {
          let g := rows_opt_row(j, env, s, arm.guard, rows_bind_pattern(arm.pattern, locals))
          let b := rows_term_row(j, env, g.s, arm.body, rows_bind_pattern(arm.pattern, locals))
          rows_arms_row(j, env, b.s, rest, locals, rowset_union(rowset_union(row, g.row), b.row))
        }
      }
    }
  }

  pub fn rows_handlers_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    handlers: List(SurfaceHandler),
    resumed: List(RowSet),
    own: List(RowSet),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match handlers {
        Nil => RowsOut::Mk(row, s)
        Cons(h, rest) => {
          let r := rows_handler_row(j, env, s, h, rows_first_row(resumed), rows_first_row(own), locals)
          rows_handlers_row(j, env, r.s, rest, rows_rest_rows(resumed), rows_rest_rows(own), locals, rowset_union(row, r.row))
        }
      }
    }
  }

  // What each arm performs of its own, its continuation performing nothing.
  pub fn rows_handlers_own(
    k: Nat,
    env: RowEnv,
    s: RowState,
    handlers: List(SurfaceHandler),
    locals: List(RowLocal)
  ): List(RowSet) {
    match k {
      Zero => Nil
      Succ(j) => ⊢ List(RowSet) from match handlers {
        Nil => Nil
        Cons(h, rest) => Cons(
          rows_handler_row(j, env, s, h, rowset_empty(), rowset_empty(), locals).row,
          rows_handlers_own(j, env, s, rest, locals)
        )
      }
    }
  }

  pub fn rows_handler_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    h: SurfaceHandler,
    resumed: RowSet,
    own: RowSet,
    locals: List(RowLocal)
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match h {
        HdReturn(pattern, body) => rows_term_row(
          j,
          env,
          s,
          body,
          rows_bind_pattern(pattern, locals)
        )
        HdOperation(eff, ^hfa, ^hty, patterns, cont, _, guard, body) => {
          let g := rows_opt_row(
            j,
            env,
            s,
            guard,
            rows_with_cont(rows_bind_operation(patterns, eff, locals), cont, resumed)
          )
          let b := rows_term_row(
            j,
            env,
            g.s,
            body,
            rows_with_cont(rows_bind_operation(patterns, eff, locals), cont, resumed)
          )
          RowsOut::Mk(
            rowset_union(g.row, b.row),
            rows_after_arm(env, b.s, eff, rowset_union(g.row, b.row), own, cont, body)
          )
        }
      }
    }
  }

  pub fn rows_stmts_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    stmts: List(SurfaceStmt),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match stmts {
        Nil => RowsOut::Mk(row, s)
        Cons(st, rest) => ⊢ RowsOut from match st {
          StLet(name, ^ty, value, ^r#borrow, ^bm, ^unused, ^st_stack) => rows_bind_stmt(
            j,
            env,
            s,
            rest,
            locals,
            row,
            name,
            value
          )
          StVar(name, ^ty, value, ^vb, ^unused, ^st_stack) => rows_bind_stmt(j, env, s, rest, locals, row, name, value)
          StAssign(^name, ^name_place, value) => {
            let r := rows_term_row(j, env, s, value, locals)
            rows_stmts_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
          }
          StExpr(e) => {
            let r := rows_term_row(j, env, s, e, locals)
            rows_stmts_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
          }
          StReturn(v) => {
            let r := rows_opt_row(j, env, s, v, locals)
            rows_stmts_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
          }
          StWhile(condition, body) => {
            let a := rows_term_row(j, env, s, condition, locals)
            let b := rows_term_row(j, env, a.s, body, locals)
            rows_stmts_row(
              j,
              env,
              b.s,
              rest,
              locals,
              rowset_add(rowset_union(rowset_union(row, a.row), b.row), "div")
            )
          }
          // A local function's body is read once, with its own parameters
          // and the row variables it declares, so that its calls have rows
          // (`local_function` of `rows.rs`).
          StFn(f) => {
            let r := rows_term_row(
              j,
              env,
              rows_set_direct(s, rows_direct_generics(f.generics, f.bounds)),
              f.body,
              rows_params_locals_from(f.params, f.param_types, locals)
            )
            rows_stmts_row(j, env, rows_set_direct(r.s, s.direct_vars), rest, locals, row)
          }
          _ => rows_stmts_row(j, env, s, rest, locals, row)
        }
      }
    }
  }

  pub fn rows_bind_stmt(
    k: Nat,
    env: RowEnv,
    s: RowState,
    rest: List(SurfaceStmt),
    locals: List(RowLocal),
    row: RowSet,
    name: Text,
    value: SurfaceTerm
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => {
        let r := rows_term_row(j, env, s, value, locals)
        let l := rows_bound_latent(j, env, r.s, value, locals)
        rows_stmts_row(
          j,
          env,
          l.s,
          rest,
          rows_push(locals, name, l.latent),
          rowset_union(row, r.row)
        )
      }
    }
  }

  pub fn rows_bound_latent(
    k: Nat,
    env: RowEnv,
    s: RowState,
    value: SurfaceTerm,
    locals: List(RowLocal)
  ): LatentOut {
    match k {
      Zero => LatentOut::Mk(LatentUnknown, s)
      Succ(j) => ⊢ LatentOut from match rows_is_lambda(value) {
        true => rows_latent_of(j, env, s, value, locals)
        false => LatentOut::Mk(LatentUnknown, s)
      }
    }
  }

  pub fn rows_callee_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: SurfaceTerm,
    function: SurfaceTerm,
    arguments: List(SurfaceTerm),
    locals: List(RowLocal)
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match function.kind {
        SkVar(n) => ⊢ RowsOut from match rows_local_has(locals, surface_name_text(n)) {
          true => {
            let l := rows_latent_of(j, env, s, function, locals)
            RowsOut::Mk(rows_callee_known(l.latent, surface_name_text(n)), l.s)
          }
          false => ⊢ RowsOut from match rows_env_fn(env, surface_name_text(n)) {
            None => ⊢ RowsOut from match rows_env_is_data(env, surface_name_text(n)) || rows_pure_builtin(surface_name_text(n), rows_no_terms(arguments)) {
              true => RowsOut::Mk(rowset_empty(), s)
              false => RowsOut::Mk(rows_unresolved(surface_name_text(n)), s)
            }
            Some(callee) => {
              let c := rows_values_checked(
                j,
                env,
                rows_externs_checked(j, env, s, surface_name_text(n), arguments, locals, t),
                callee.param_types,
                arguments,
                locals,
                t
              )
              let r := rows_fn_row(j, env, c, surface_name_text(n))
              rows_callee_effects(
                j,
                env,
                r.s,
                t,
                callee,
                arguments,
                locals,
                rowset_list(r.row),
                rowset_empty()
              )
            }
          }
        }
        SkField(base, name) => RowsOut::Mk(rows_field_call(env, base, name, locals), s)
        SkLam(^ps, ^b, _, _) => {
          let l := rows_latent_of(j, env, s, function, locals)
          RowsOut::Mk(rows_applied_known(l.latent), l.s)
        }
        SkBorrowLam(^bs, ^b) => {
          let l := rows_latent_of(j, env, s, function, locals)
          RowsOut::Mk(rows_applied_known(l.latent), l.s)
        }
        // The function expression is evaluated before it is applied, as
        // `evaluated` of `rows.rs`.
        _ => {
          let e := rows_term_row(j, env, s, function, locals)
          RowsOut::Mk(rows_applied_expression(), e.s)
        }
      }
    }
  }

  // A closure passed to an extern runs inside a Rust frame, which cannot be
  // suspended: its row has direct operations only.
  pub fn rows_externs_checked(
    k: Nat,
    env: RowEnv,
    s: RowState,
    n: Text,
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    t: SurfaceTerm
  ): RowState {
    match k {
      Zero => rows_report(s, msg0("rows-out-of-steps"), t.start, t.end)
      Succ(j) => ⊢ RowState from match Ordmap::contains(env.externs, n, Ordmap::compare_text) {
        true => rows_extern_closures(j, env, s, arguments, locals, t)
        false => s
      }
    }
  }

  pub fn rows_extern_closures(
    k: Nat,
    env: RowEnv,
    s: RowState,
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    t: SurfaceTerm
  ): RowState {
    match k {
      Zero => rows_report(s, msg0("rows-out-of-steps"), t.start, t.end)
      Succ(j) => ⊢ RowState from match arguments {
        Nil => s
        Cons(a, rest) => {
          let l := rows_latent_of(j, env, s, a, locals)
          rows_extern_closures(j, env, rows_extern_latent(l.latent, env, l.s, t), rest, locals, t)
        }
      }
    }
  }

  // A function value given for a parameter of a function type whose row has no
  // row variable performs only what that row names (`check_value` of
  // `rows.rs`): each effect it may perform beyond it is an error at the value.
  // A name the program does not have is said so.
  pub fn rows_values_checked(
    k: Nat,
    env: RowEnv,
    s: RowState,
    types: List(Option(SurfaceTerm)),
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    t: SurfaceTerm
  ): RowState {
    match k {
      Zero => rows_report(s, msg0("rows-out-of-steps"), t.start, t.end)
      Succ(j) => ⊢ RowState from match types {
        Nil => s
        Cons(ty, more) => ⊢ RowState from match arguments {
          Nil => s
          Cons(a, rest) => rows_values_checked(
            j,
            env,
            rows_value_checked(j, env, s, ty, a, locals, t),
            more,
            rest,
            locals,
            t
          )
        }
      }
    }
  }

  pub fn rows_value_checked(
    k: Nat,
    env: RowEnv,
    s: RowState,
    ty: Option(SurfaceTerm),
    a: SurfaceTerm,
    locals: List(RowLocal),
    t: SurfaceTerm
  ): RowState {
    match k {
      Zero => rows_report(s, msg0("rows-out-of-steps"), t.start, t.end)
      Succ(j) => ⊢ RowState from match rows_latent_of_type(ty) {
        LatentKnown(expected) => ⊢ RowState from match rows_has_row_variable(rowset_list(expected)) {
          true => s
          false => ⊢ RowState from match rows_unresolved_value(env, a, locals) {
            Some(name) => rows_report(s, rows_unfollowed(rows_unresolved_tag(name)), a.start, a.end)
            None => {
              let l := rows_latent_of(j, env, s, a, locals)
              ⊢ RowState from match l.latent {
                LatentKnown(actual) => rows_value_performs(rowset_list(actual), expected, l.s, a)
                _ => l.s
              }
            }
          }
        }
        _ => s
      }
    }
  }

  // The effects of the callee's row: a row variable is instantiated, the
  // others stay.
  pub fn rows_callee_effects(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: SurfaceTerm,
    callee: SurfaceFn,
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    effects: List(Text),
    row: RowSet
  ): RowsOut {
    match k {
      Zero => rows_out_of_steps(s)
      Succ(j) => ⊢ RowsOut from match effects {
        Nil => RowsOut::Mk(row, s)
        Cons(eff, rest) => ⊢ RowsOut from match rows_has_prefix(eff, "|") {
          true => {
            let r := rows_instantiated(
              rows_instantiate(
                j,
                env,
                s,
                rows_after_first(eff),
                callee.param_types,
                arguments,
                locals,
                rowset_empty(),
                false
              ),
              rows_after_first(eff)
            )
            rows_callee_effects(
              j,
              env,
              rows_bounded(env, r.s, rows_after_first(eff), callee, r.row, t),
              t,
              callee,
              arguments,
              locals,
              rest,
              rowset_union(row, r.row)
            )
          }
          false => rows_callee_effects(
            j,
            env,
            s,
            t,
            callee,
            arguments,
            locals,
            rest,
            rowset_add(row, eff)
          )
        }
      }
    }
  }

  // The callee's row variable `rvar`, as the rows of the arguments passed
  // for the parameters whose type mentions it.
  pub fn rows_instantiate(
    k: Nat,
    env: RowEnv,
    s: RowState,
    rvar: Text,
    types: List(Option(SurfaceTerm)),
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    row: RowSet,
    found: Bool
  ): FoundOut {
    match k {
      Zero => FoundOut::Mk(rowset_one(rows_unchecked("steps", "")), true, s)
      Succ(j) => ⊢ FoundOut from match types {
        Nil => FoundOut::Mk(row, found, s)
        Cons(ty, more) => ⊢ FoundOut from match arguments {
          Nil => FoundOut::Mk(row, found, s)
          Cons(arg, others) => ⊢ FoundOut from match rows_named(ty, rvar) {
            None => rows_instantiate(j, env, s, rvar, more, others, locals, row, found)
            Some(Named) => {
              let l := rows_latent_of(j, env, s, arg, locals)
              rows_instantiate(
                j,
                env,
                l.s,
                rvar,
                more,
                others,
                locals,
                rowset_union(row, rows_passed(l.latent, Named, rvar)),
                true
              )
            }
          }
        }
      }
    }
  }
}

// ---- the report ------------------------------------------------------------------
//
// `check_program_rows` of `rows.rs`: the rows of a program's functions and
// the errors, and the dump of the report the differential test compares.

pub(open) inductive RowFn: Type {
  Mk(name: Text, row: RowSet): RowFn
}

pub(open) inductive RowReport: Type {
  Mk(
    functions: List(RowFn),
    errors: List(RowDiagnostic),
    calls: Ordmap(RowSpan, RowSet),
    quants: Ordmap(Text, Quant)
  ): RowReport
}

fn rows_program_names_fns(fns: List(SurfaceFn), done: Ordmap(Text, Bool)): Ordmap(Text, Bool) {
  match fns {
    Nil => done
    Cons(f, rest) => rows_program_names_fns(
      rest,
      Ordmap::insert(done, f.name, true, Ordmap::compare_text)
    )
  }
}

pub fn rows_program_names(stmts: List(SurfaceStmt), done: Ordmap(Text, Bool)): Ordmap(Text, Bool) {
  match stmts {
    Nil => done
    Cons(s, rest) => ⊢ Ordmap(Text, Bool) from match s {
      StFn(f) => rows_program_names(rest, Ordmap::insert(done, f.name, true, Ordmap::compare_text))
      StExtern(fns, instances, types, structs, enums, ^start, ^end) => rows_program_names(
        rest,
        if extern_is_replaceable(fns, instances, types, structs, enums) {
          rows_program_names_fns(fns, done)
        } else {
          done
        }
      )
      _ => rows_program_names(rest, done)
    }
  }
}

pub(open) inductive RowNamed: Type {
  Mk(start: Nat, name: Text): RowNamed
}

pub fn rows_start_of(env: RowEnv, name: Text): Nat {
  match rows_env_fn(env, name) {
    Some(f) => f.start
    None => 0
  }
}

pub fn rows_insert_sorted(xs: List(RowNamed), x: RowNamed): List(RowNamed) {
  match xs {
    Nil => Cons(x, Nil)
    Cons(y, rest) => ⊢ List(RowNamed) from match x.start <= y.start {
      true => Cons(x, xs)
      false => Cons(y, rows_insert_sorted(rest, x))
    }
  }
}

// The names, by where their functions start.
pub fn rows_sort_names(names: List(Text), env: RowEnv, done: List(RowNamed)): List(RowNamed) {
  match names {
    Nil => done
    Cons(n, rest) => rows_sort_names(
      rest,
      env,
      rows_insert_sorted(done, RowNamed::Mk(rows_start_of(env, n), n))
    )
  }
}

pub fn rows_show(names: List(Text)): Text {
  text_join(names, ", ")
}

pub fn rows_error(message: Text, f: SurfaceFn): RowDiagnostic {
  RowDiagnostic::Mk(message, f.start, f.end)
}

pub fn rows_unwritten(
  name: Text,
  f: SurfaceFn,
  eff: Text,
  more: List(RowDiagnostic)
): List(RowDiagnostic) {
  match rows_written_of(f) {
    None => more
    Some(written) => ⊢ List(RowDiagnostic) from match rows_has_text(row_entries_text(written), eff) {
      true => more
      false => Cons(
        rows_error(
          msg3(
            "rows-may-perform",
            marg("name", name),
            marg("effect", rows_shown(eff)),
            marg("row", rows_show(rows_all_shown(rowset_list(rowset_of(row_entries_text(written))))))
          ),
          f
        ),
        more
      )
    }
  }
}

// The row written on `f`. A `fn` with no row written is `! {}`; only `!?` (a row not
// written yet) has none. The helpers extraction writes (`Tauto…`, `extract_…`) are the
// compiler's own text and keep the row their body performs.
pub fn rows_written_of(f: SurfaceFn): Option(List(RowEntry)) {
  match f.effects {
    Some(written) => Some(written)
    None => ⊢ Option(List(RowEntry)) from match f.row_hole {
      Some(_) => None
      None => ⊢ Option(List(RowEntry)) from match rows_has_prefix(f.name, "Tauto") || rows_has_prefix(f.name, "extract_") {
        true => None
        false => Some(Nil)
      }
    }
  }
}

// The errors of one function's inferred row, in the row's order.
pub fn rows_fn_errors(inferred: List(Text), name: Text, f: SurfaceFn): List(RowDiagnostic) {
  match inferred {
    Nil => Nil
    Cons(eff, rest) => ⊢ List(RowDiagnostic) from match rows_has_prefix(eff, "?") {
      true => Cons(
        rows_error(rows_unfollowed_in(rows_after_first(eff), name),
          f
        ),
        rows_fn_errors(rest, name, f)
      )
      false => rows_unwritten(name, f, eff, rows_fn_errors(rest, name, f))
    }
  }
}

pub fn rows_errors_of(env: RowEnv, name: Text, inferred: RowSet): List(RowDiagnostic) {
  match rows_env_fn(env, name) {
    Some(f) => List::append(
      rows_written_args(env, row_opt_entries_text(f.effects), name, f),
      List::append(
        rows_undefined_effects(env, rows_written_rows(f), name, f),
        rows_fn_errors(rowset_list(inferred), name, f)
      )
    )
    None => Nil
  }
}

pub(open) inductive RowChecked: Type {
  Mk(functions: List(RowFn), errors: List(RowDiagnostic), s: RowState): RowChecked
}

pub fn rows_check_fns(
  names: List(RowNamed),
  k: Nat,
  env: RowEnv,
  s: RowState,
  functions: List(RowFn),
  errors: List(RowDiagnostic)
): RowChecked {
  match names {
    Nil => RowChecked::Mk(List::reverse(functions), errors, s)
    Cons(n, rest) => {
      let r := rows_inferred_row(k, env, s, n.name)
      rows_check_fns(
        rest,
        k,
        env,
        r.s,
        Cons(RowFn::Mk(n.name, r.row), functions),
        List::append(errors, rows_errors_of(env, n.name, r.row))
      )
    }
  }
}

// An extern is the host's: a call may wait on the host (a JavaScript
// Promise, a Rust Future), and names no other effects of its own.
pub fn rows_extern_errors(fns: List(SurfaceFn)): List(RowDiagnostic) {
  match fns {
    Nil => Nil
    Cons(f, rest) => ⊢ List(RowDiagnostic) from match f.effects {
      Some(effects) => ⊢ List(RowDiagnostic) from match rows_only_wait(row_entries_text(effects)) {
        true => rows_extern_errors(rest)
        false => Cons(rows_error(msg0("rows-extern-effects"), f), rows_extern_errors(rest))
      }
      None => rows_extern_errors(rest)
    }
  }
}

pub fn rows_only_wait(effects: List(Text)): Bool {
  match effects {
    Nil => true
    Cons(e, rest) => e == "wait" && rows_only_wait(rest)
  }
}

pub fn rows_top_effects(effects: List(Text), t: SurfaceTerm): List(RowDiagnostic) {
  match effects {
    Nil => Nil
    Cons(eff, rest) => ⊢ List(RowDiagnostic) from match eff == "div" || eff == "budget" || eff == "budget_memory" || eff == "test" || eff == "spawn" || rows_names_has(rows_host_effects(), eff) {
      // `div` is allowed at the top level, and the host answers `show`,
      // `test`, `spawn`, `budget`, `budget_memory` and the standard effects.
      true => rows_top_effects(rest, t)
      false => ⊢ List(RowDiagnostic) from match rows_has_prefix(eff, "?") {
        true => Cons(
          RowDiagnostic::Mk(
            rows_unfollowed(rows_after_first(eff)),
            t.start,
            t.end
          ),
          rows_top_effects(rest, t)
        )
        false => Cons(
          RowDiagnostic::Mk(
            msg1("rows-unhandled-top-level", marg("effect", rows_shown(eff))),
            t.start,
            t.end
          ),
          rows_top_effects(rest, t)
        )
      }
    }
  }
}

pub(open) inductive RowTop: Type {
  Mk(errors: List(RowDiagnostic), s: RowState): RowTop
}

pub fn rows_top_prepend(errors: List(RowDiagnostic), r: RowTop): RowTop {
  RowTop::Mk(List::append(errors, r.errors), r.s)
}

pub fn rows_top_errors(stmts: List(SurfaceStmt), k: Nat, env: RowEnv, s: RowState): RowTop {
  rows_top_errors_in(stmts, k, env, s, Nil)
}

// The top-level statements in order: what a `let` binds is a local of the
// statements after it, as `top_locals` of `rows.rs`.
pub fn rows_top_errors_in(stmts: List(SurfaceStmt), k: Nat, env: RowEnv, s: RowState, locals: List(RowLocal)): RowTop {
  match stmts {
    Nil => RowTop::Mk(Nil, s)
    Cons(st, rest) => ⊢ RowTop from match st {
      StLet(name, ^ty, value, ^r#borrow, ^bm, ^unused, ^st_stack) => {
        let r := rows_term_row(k, env, s, value, locals)
        let l := rows_bound_latent(k, env, r.s, value, locals)
        rows_top_prepend(
          rows_top_effects(rowset_list(r.row), value),
          rows_top_errors_in(rest, k, env, l.s, rows_push(locals, name, l.latent))
        )
      }
      StVar(name, ^ty, value, ^vb, ^unused, ^st_stack) => {
        let r := rows_term_row(k, env, s, value, locals)
        let l := rows_bound_latent(k, env, r.s, value, locals)
        rows_top_prepend(
          rows_top_effects(rowset_list(r.row), value),
          rows_top_errors_in(rest, k, env, l.s, rows_push(locals, name, l.latent))
        )
      }
      StExpr(e) => {
        let r := rows_term_row(k, env, s, e, locals)
        rows_top_prepend(
          rows_top_effects(rowset_list(r.row), e),
          rows_top_errors_in(rest, k, env, r.s, locals)
        )
      }
      StExtern(fs, instances, types, structs, enums, ^a, ^b) => rows_top_prepend(
        if extern_is_replaceable(fs, instances, types, structs, enums) {
          Nil
        } else {
          rows_extern_errors(fs)
        },
        rows_top_errors_in(rest, k, env, s, locals)
      )
      _ => rows_top_errors_in(rest, k, env, s, locals)
    }
  }
}

// Budget inputs: the absolute end position plus one for each function and each
// top-level value expression. rows_steps scales their sum, plus one, by sixteen.
pub fn rows_fns_extent(fns: List(Text × SurfaceFn)): Nat {
  match fns {
    Nil => 0
    Cons(e, rest) => e.snd.end + 1 + rows_fns_extent(rest)
  }
}

pub fn rows_stmt_extent(st: SurfaceStmt): Nat {
  match st {
    StLet(^name, ^ty, value, ^r#borrow, ^bm, ^unused, ^st_stack) => value.end + 1
    StVar(^name, ^ty, value, ^vb, ^unused, ^st_stack) => value.end + 1
    StExpr(e) => e.end + 1
    _ => 0
  }
}

pub fn rows_stmts_extent(stmts: List(SurfaceStmt)): Nat {
  match stmts {
    Nil => 0
    Cons(st, rest) => rows_stmt_extent(st) + rows_stmts_extent(rest)
  }
}

pub fn rows_steps(env: RowEnv, program: List(SurfaceStmt)): Nat {
  16 * (rows_fns_extent(Ordmap::entries(env.fns)) + rows_stmts_extent(program) + 1)
}

// What was found while following a function's body and the errors of the
// functions' rows, in the order of the program: `rows.rs` finds them function
// by function, in the order of the functions.
pub fn rows_merge_errors(found: List(RowDiagnostic), errors: List(RowDiagnostic)): List(RowDiagnostic) {
  match found {
    Nil => errors
    Cons(f, more) => rows_merge_errors(more, rows_insert_error(f, errors))
  }
}

pub fn rows_insert_error(f: RowDiagnostic, errors: List(RowDiagnostic)): List(RowDiagnostic) {
  match errors {
    Nil => Cons(f, Nil)
    Cons(g, rest) => ⊢ List(RowDiagnostic) from match g.start <= f.start {
      true => Cons(g, rows_insert_error(f, rest))
      false => Cons(f, errors)
    }
  }
}

// The errors of the functions whose row is `!?`, in the order of the functions: the row is not
// written yet.
pub fn rows_hole_errors(fs: List(Text × SurfaceFn)): List(RowDiagnostic) {
  match fs {
    Nil => Nil
    Cons(e, rest) => ⊢ List(RowDiagnostic) from match e.snd.row_hole {
      None => rows_hole_errors(rest)
      Some(at) => rows_insert_error(
        RowDiagnostic::Mk(msg1("rows-row-hole", marg("name", e.snd.name)), at.start, at.end),
        rows_hole_errors(rest)
      )
    }
  }
}

pub fn rows_report_of(env: RowEnv, checked: RowChecked, tops: RowTop): RowReport {
  RowReport::Mk(
    checked.functions,
    List::append(
      rows_hole_errors(Ordmap::entries(env.fns)),
      List::append(rows_merge_errors(tops.s.found, checked.errors), tops.errors)
    ),
    tops.s.calls,
    env.quants
  )
}

pub fn rows_check_in(env: RowEnv, program: List(SurfaceStmt), checked: RowChecked): RowReport {
  rows_report_of(env, checked, rows_top_errors(program, rows_steps(env, program), env, checked.s))
}

pub fn rows_check_env(env: RowEnv, program: List(SurfaceStmt)): RowReport {
  rows_check_in(
    env,
    program,
    rows_check_fns(
      rows_sort_names(
        rowset_list(RowSet::Mk(rows_program_names(program, Ordmap::empty()))),
        env,
        Nil
      ),
      rows_steps(env, program),
      env,
      rows_empty_state(),
      Nil,
      Nil
    )
  )
}

// The environment of the program, with the prelude's declarations before its own.
pub fn rows_env(prelude: List(SurfaceStmt), program: List(SurfaceStmt)): RowEnv {
  rows_env_with_refs(rows_env_of(
    program,
    rows_env_of(
      prelude,
      RowEnv::Mk(
        Ordmap::empty(),
        rows_initial_quants(),
        rows_user_externs(program, Ordmap::empty()),
        Ordmap::empty(),
        Ordmap::empty(),
        Ordmap::empty(),
        Ordmap::empty(),
        Ordmap::empty()
      )
    )
  ))
}

// `env` with the references of each of its functions: finding a recursive
// group reaches the same functions from every member, and each reach walked
// every body it passed again.
pub fn rows_env_with_refs(env: RowEnv): RowEnv {
  RowEnv::Mk(env.fns, env.quants, env.externs, env.data, env.structs, env.ops, rows_refs_of(env, Ordmap::entries(env.fns), Ordmap::empty()), env.sets)
}

pub fn rows_refs_of(env: RowEnv, fs: List(Text × SurfaceFn), out: Ordmap(Text, List(Text))): Ordmap(Text, List(Text)) {
  match fs {
    Nil => out
    Cons(e, rest) => rows_refs_of(env, rest, Ordmap::insert(out, e.fst, rows_refs(env, e.snd), Ordmap::compare_text))
  }
}

// The environment of the program with the effects its operators perform when
// their result does not exist.
pub fn rows_env_with_ops(env: RowEnv, ops: Ordmap(RowSpan, Text)): RowEnv {
  RowEnv::Mk(env.fns, env.quants, env.externs, env.data, env.structs, ops, env.refs, env.sets)
}

// The rows the analysis finds for every function of `env`.
pub fn rows_all_rows(env: RowEnv, program: List(SurfaceStmt)): List(RowFn) {
  rows_check_fns(
    rows_sort_names(rowset_list(RowSet::Mk(rows_fn_name_set(Ordmap::entries(env.fns), Ordmap::empty()))), env, Nil),
    rows_steps(env, program),
    env,
    rows_empty_state(),
    Nil,
    Nil
  ).functions
}

pub fn rows_fn_name_set(fs: List(Text × SurfaceFn), done: Ordmap(Text, Bool)): Ordmap(Text, Bool) {
  match fs {
    Nil => done
    Cons(f, rest) => rows_fn_name_set(rest, Ordmap::insert(done, f.fst, true, Ordmap::compare_text))
  }
}

pub fn rows_dump_row(r: RowSet): Text {
  Text::concat_all(Cons("{", Cons(rows_show(rowset_list(r)), Cons("}", Nil))))
}

pub fn rows_dump_functions(fns: List(RowFn)): List(Text) {
  match fns {
    Nil => Nil
    Cons(f, rest) => Cons(
      Text::concat_all(
        Cons(
          "function ",
          Cons(f.name, Cons(" ", Cons(rows_dump_row(f.row), Cons(text_newline(), Nil))))
        )
      ),
      rows_dump_functions(rest)
    )
  }
}

pub fn rows_dump_errors(errors: List(RowDiagnostic)): List(Text) {
  match errors {
    Nil => Nil
    Cons(e, rest) => Cons(
      Text::concat_all(
        Cons(
          "error ",
          Cons(
            Text::of_nat(e.start),
            Cons(
              " ",
              Cons(Text::of_nat(e.end), Cons(" ", Cons(e.message, Cons(text_newline(), Nil))))
            )
          )
        )
      ),
      rows_dump_errors(rest)
    )
  }
}

pub fn rows_dump_calls(calls: List(RowSpan × RowSet)): List(Text) {
  match calls {
    Nil => Nil
    Cons(c, rest) => Cons(
      Text::concat_all(
        Cons(
          "call ",
          Cons(
            Text::of_nat(c.fst.start),
            Cons(
              " ",
              Cons(
                Text::of_nat(c.fst.end),
                Cons(" ", Cons(rows_dump_row(c.snd), Cons(text_newline(), Nil)))
              )
            )
          )
        )
      ),
      rows_dump_calls(rest)
    )
  }
}

pub fn rows_dump_quants(quants: List(Text × Quant)): List(Text) {
  match quants {
    Nil => Nil
    Cons(q, rest) => Cons(
      Text::concat_all(
        Cons("quant ", Cons(q.fst, Cons(" ", Cons(quant_name(q.snd), Cons(text_newline(), Nil)))))
      ),
      rows_dump_quants(rest)
    )
  }
}

pub fn rows_dump(report: RowReport): Text {
  Text::concat_all(
    List::append(
      rows_dump_functions(report.functions),
      List::append(
        rows_dump_errors(report.errors),
        List::append(
          rows_dump_calls(Ordmap::entries(report.calls)),
          rows_dump_quants(Ordmap::entries(report.quants))
        )
      )
    )
  )
}

// The arguments whose bodies are followed: a local or unresolved callee
// checks no argument, so a function given to it is not read.
pub fn rows_checked_args(env: RowEnv, function: SurfaceTerm, arguments: List(SurfaceTerm), locals: List(RowLocal)): List(SurfaceTerm) {
  match rows_callee_unresolved(env, function, arguments, locals) {
    true => rows_drop_lams(arguments)
    false => arguments
  }
}

pub fn rows_callee_unresolved(env: RowEnv, function: SurfaceTerm, arguments: List(SurfaceTerm), locals: List(RowLocal)): Bool {
  match function.kind {
    SkVar(n) => ⊢ Bool from match rows_local_has(locals, surface_name_text(n)) {
      true => true
      false => ⊢ Bool from match rows_env_fn(env, surface_name_text(n)) {
        Some(_) => false
        None => not(rows_env_is_data(env, surface_name_text(n)) || rows_pure_builtin(surface_name_text(n), rows_no_terms(arguments)))
      }
    }
    _ => false
  }
}

pub fn rows_drop_lams(arguments: List(SurfaceTerm)): List(SurfaceTerm) {
  match arguments {
    Nil => Nil
    Cons(a, rest) => ⊢ List(SurfaceTerm) from match a.kind {
      SkLam(_, _, _, _) => rows_drop_lams(rest)
      _ => Cons(a, rows_drop_lams(rest))
    }
  }
}

// A row does not say which type arguments an effect is performed with; an
// entry that writes them would be read as another effect.
pub fn rows_written_args(env: RowEnv, effects: Option(List(Text)), name: Text, f: SurfaceFn): List(RowDiagnostic) {
  match effects {
    None => Nil
    Some(written) => rows_written_args_in(env, written, name, f)
  }
}

// The name an entry applies: `foo` of `foo(A)` and of `∀ A. foo(A)`.
pub fn rows_entry_head(w: Text): Text {
  rows_entry_head_of(match rows_has_prefix(w, "∀") {
    true => match rows_index_of(Text::len(w), w, ".", 0) {
      Some(i) => rows_trim(Text::slice_or_empty(w, Succ(i), Text::len(w)))
      None => w
    }
    false => w
  })
}

pub fn rows_entry_head_of(body: Text): Text {
  match rows_index_of(Text::len(body), body, "(", 0) {
    Some(i) => rows_trim(Text::slice_or_empty(body, 0, i))
    None => rows_trim(body)
  }
}

pub fn rows_written_args_in(env: RowEnv, written: List(Text), name: Text, f: SurfaceFn): List(RowDiagnostic) {
  match written {
    Nil => Nil
    Cons(w, rest) => ⊢ List(RowDiagnostic) from match rows_index_of(Text::len(w), w, "(", 0) {
      None => rows_written_args_in(env, rest, name, f)
      Some(i) => ⊢ List(RowDiagnostic) from match rows_index_of(Text::len(w), w, "@", 0) {
        Some(_) => rows_written_args_in(env, rest, name, f)
        None => match rows_env_fn(env, rows_entry_head(w)) {
          // A function is not an effect: that its name is in a row is what
          // `rows_undefined_in` says.
          Some(_) => rows_written_args_in(env, rest, name, f)
          None => Cons(
            rows_error(rows_writes_args_message(name, w, rows_trim(Text::slice_or_empty(w, 0, i))), f),
            rows_written_args_in(env, rest, name, f)
          )
        }
      }
    }
  }
}

// The rows a signature writes: the function's own, then those of its
// parameters' and result's types (a callback's `() -> A ! {…}`).
pub fn rows_written_rows(f: SurfaceFn): Option(List(Text)) {
  Some(
    List::append(
      match f.effects {
        None => Nil
        Some(es) => row_entries_text(es)
      },
      List::append(rows_opt_terms_rows(f.param_types), rows_opt_term_rows(f.result))
    )
  )
}

pub fn rows_opt_term_rows(t: Option(SurfaceTerm)): List(Text) {
  match t {
    None => Nil
    Some(x) => rows_term_rows(x)
  }
}

pub fn rows_opt_terms_rows(ts: List(Option(SurfaceTerm))): List(Text) {
  match ts {
    Nil => Nil
    Cons(t, rest) => List::append(rows_opt_term_rows(t), rows_opt_terms_rows(rest))
  }
}

mutual {
  pub fn rows_term_rows(t: SurfaceTerm): List(Text) {
    match t {
      SurfaceTermIndexedMk(k, ^start, ^end, ^occurrence) => rows_kind_rows(k)
    }
  }

  pub fn rows_kind_rows(k: SurfaceKind): List(Text) {
    match k {
      SkPi(params, result, effects) => List::append(
        match effects {
          None => Nil
          Some(es) => row_entries_text(es)
        },
        List::append(rows_params_rows(params), rows_term_rows(result))
      )
      SkRow(es) => row_entries_text(es)
      SkApp(f, args) => List::append(rows_term_rows(f), rows_terms_rows(args))
      SkBorrow(^m, ^m_orig, x) => rows_term_rows(x)
      SkFnKind(^fk, x) => rows_term_rows(x)
      SkTagged(^tag, x) => rows_term_rows(x)
      SkUnion(parts) => rows_terms_rows(parts)
      _ => Nil
    }
  }

  pub fn rows_terms_rows(ts: List(SurfaceTerm)): List(Text) {
    match ts {
      Nil => Nil
      Cons(t, rest) => List::append(rows_term_rows(t), rows_terms_rows(rest))
    }
  }

  pub fn rows_params_rows(ps: List(SurfaceParam)): List(Text) {
    match ps {
      Nil => Nil
      Cons(p, rest) => List::append(rows_param_rows(p), rows_params_rows(rest))
    }
  }

  pub fn rows_param_rows(p: SurfaceParam): List(Text) {
    match p {
      SurfaceParamMk(^n, ty, ^unused) => rows_term_rows(ty)
    }
  }
}

// An entry of the written row that names no declared effect: a misspelling
// or a missing import, not an unused effect.
pub fn rows_undefined_effects(env: RowEnv, written: Option(List(Text)), name: Text, f: SurfaceFn): List(RowDiagnostic) {
  match written {
    None => Nil
    Some(entries) => rows_undefined_in(env, entries, name, f)
  }
}

pub fn rows_undefined_in(env: RowEnv, entries: List(Text), name: Text, f: SurfaceFn): List(RowDiagnostic) {
  match entries {
    Nil => Nil
    Cons(w, rest) => match rows_undefined_head(env, w) {
      None => match rows_has_prefix(w, "∀") {
        true => match rows_env_fn(env, rows_entry_head(w)) {
          Some(_) => Cons(
            rows_error(
              msg2("rows-function-in-row", marg("name", name), marg("effect", w)),
              f
            ),
            rows_undefined_in(env, rest, name, f)
          )
          None => rows_undefined_in(env, rest, name, f)
        }
        false => rows_undefined_in(env, rest, name, f)
      }
      Some(head) => Cons(
        rows_error(
          msg2(
            match rows_env_fn(env, head) {
              Some(_) => "rows-function-in-row"
              None => "rows-undefined-effect"
            },
            marg("name", name),
            marg("effect", head)
          ),
          f
        ),
        rows_undefined_in(env, rest, name, f)
      )
    }
  }
}

pub fn rows_undefined_head(env: RowEnv, w: Text): Option(Text) {
  match rows_has_prefix(w, "|") || rows_has_prefix(w, "?") || rows_has_prefix(w, "∀") {
    true => None
    false => match rows_index_of(Text::len(w), w, "@", 0) {
      Some(_) => None
      None => rows_undefined_named(env, w, match rows_index_of(Text::len(w), w, "(", 0) {
        Some(i) => rows_trim(Text::slice_or_empty(w, 0, i))
        None => rows_trim(w)
      })
    }
  }
}

pub fn rows_undefined_named(env: RowEnv, w: Text, head: Text): Option(Text) {
  match head == "" || Ordmap::contains(env.quants, head, Ordmap::compare_text) || rows_names_has(rows_host_effects(), head) || head == "test" || head == "spawn" {
    true => None
    false => Some(w)
  }
}

pub fn rows_writes_args_message(name: Text, written: Text, head: Text): Text {
  if head == "exceeded" {
    msg3("rows-writes-type-arguments-instances", marg("name", name), marg("written", written), marg("head", head))
  } else {
    msg2("rows-writes-type-arguments", marg("name", name), marg("written", written))
  }
}

pub fn rows_index_of(k: Nat, t: Text, c: Text, i: Nat): Option(Nat) {
  match k {
    Zero => None
    Succ(j) => ⊢ Option(Nat) from match Text::slice_or_empty(t, i, Succ(i)) == c {
      true => Some(i)
      false => rows_index_of(j, t, c, Succ(i))
    }
  }
}

// `t` without the spaces at its ends.
pub fn rows_trim(t: Text): Text {
  rows_trim_end(Text::len(t), rows_trim_start(Text::len(t), t))
}

pub fn rows_trim_start(k: Nat, t: Text): Text {
  match k {
    Zero => t
    Succ(j) => ⊢ Text from match Text::starts_with(t, " ") {
      true => rows_trim_start(j, Text::slice_or_empty(t, 1, Text::len(t)))
      false => t
    }
  }
}

pub fn rows_trim_end(k: Nat, t: Text): Text {
  match k {
    Zero => t
    Succ(j) => ⊢ Text from match Text::slice_or_empty(t, Nat::sub(Text::len(t), 1), Text::len(t)) == " " {
      true => rows_trim_end(j, Text::slice_or_empty(t, 0, Nat::sub(Text::len(t), 1)))
      false => t
    }
  }
}

pub fn rows_first_row(rs: List(RowSet)): RowSet {
  match rs {
    Nil => rowset_empty()
    Cons(r, ^rest) => r
  }
}

pub fn rows_rest_rows(rs: List(RowSet)): List(RowSet) {
  match rs {
    Nil => Nil
    Cons(^r, rest) => rest
  }
}

// What resuming each arm's operation performs, in the order of `hs`. What
// the body performs after the operation is read as the body's whole row,
// which is what `after` of `rows.rs` gives for a body that performs it
// through a call.
pub fn rows_resumed_all(body_term: SurfaceTerm, body: RowSet, handlers: List(SurfaceHandler), hs: List(SurfaceHandler), own: List(RowSet)): List(RowSet) {
  match hs {
    Nil => Nil
    Cons(h, rest) => Cons(
      ⊢ RowSet from match h {
        HdOperation(eff, ^hfa, ^hty, ^patterns, ^cont, _, ^guard, ^arm) => rows_resumed(
          body_term,
          body,
          rows_effect_of_op(eff),
          handlers,
          own
        )
        HdReturn(^pattern, ^arm) => rowset_empty()
      },
      rows_resumed_all(body_term, body, handlers, rest, own)
    )
  }
}

pub fn rows_resumed(body_term: SurfaceTerm, body: RowSet, op: Text, handlers: List(SurfaceHandler), own: List(RowSet)): RowSet {
  match rowset_has(body, op) {
    false => rows_returned(handlers, own)
    true => ⊢ RowSet from match rows_performs_last(body_term, op) {
      true => rows_returned(handlers, own)
      false => rowset_union(
        rowset_union(rows_answered(handlers, body), rows_reached_arms(handlers, own, body)),
        rows_returned(handlers, own)
      )
    }
  }
}

// Whether the body is the performing of `op` and nothing after it: resuming
// performs nothing of the body (`after` of `rows.rs`).
pub fn rows_performs_last(body: SurfaceTerm, op: Text): Bool {
  match body.kind {
    SkPerform(eff, ^args) => rows_effect_of_op(eff) == op
    SkBlock(stmts) => match stmts {
      Cons(s, Nil) => match s {
        StExpr(e) => match e.kind {
          SkPerform(eff, ^args) => rows_effect_of_op(eff) == op
          _ => false
        }
        _ => false
      }
      _ => false
    }
    _ => false
  }
}

// What the arms of the operations `rest` performs do of their own.
pub fn rows_reached_arms(handlers: List(SurfaceHandler), own: List(RowSet), rest: RowSet): RowSet {
  match handlers {
    Nil => rowset_empty()
    Cons(h, more) => ⊢ RowSet from match h {
      HdOperation(eff, ^hfa, ^hty, ^patterns, ^cont, _, ^guard, ^arm) => ⊢ RowSet from match rowset_has(rest, rows_effect_of_op(eff)) {
        true => rowset_union(rows_first_row(own), rows_reached_arms(more, rows_rest_rows(own), rest))
        false => rows_reached_arms(more, rows_rest_rows(own), rest)
      }
      HdReturn(^pattern, ^arm) => rows_reached_arms(more, rows_rest_rows(own), rest)
    }
  }
}

// What the return arm performs.
pub fn rows_returned(handlers: List(SurfaceHandler), own: List(RowSet)): RowSet {
  match handlers {
    Nil => rowset_empty()
    Cons(h, more) => ⊢ RowSet from match h {
      HdReturn(^pattern, ^arm) => rowset_union(rows_first_row(own), rows_returned(more, rows_rest_rows(own)))
      HdOperation(^eff, ^hfa, ^hty, ^patterns, ^cont, _, ^guard, ^arm) => rows_returned(more, rows_rest_rows(own))
    }
  }
}
