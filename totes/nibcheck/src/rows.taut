import std::TextOps
import "../../surface/src/surface.taut"
import "../../ordmap/src/ordmap.taut"
import "../../text/src/text.taut"
import std::Text
import std::Base
import std::Map

// Effect rows of executable code: which effects a function may perform
// (`crates/tauto-nibcheck/src/rows.rs`), in the proof language (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」).
// A row is a set of eff names; a name that starts with `|` is a row
// variable, one that starts with `?` an eff that cannot be followed.

// ---- quantities ------------------------------------------------------------------
//
// The quantity of an operation's resume: `Quant`
// of `crates/tauto-nibcheck/src/types.rs`.

pub(open) inductive Quant: Type {
  // `resume 0`: the arm has no `k`.
  QuantZero: Quant
  // `resume <=1`, the default.
  QuantAtMostOne: Quant
  QuantOne: Quant
  QuantMany: Quant
  // `direct`: the arm continues with `k(e)` at the end of every path.
  QuantDirect: Quant
}

pub fn quant_parse(written: Text): Option(Quant) {
  match written == "0": Option(Quant) {
    true => Some(QuantZero)
    false => match written == "<=1": Option(Quant) {
      true => Some(QuantAtMostOne)
      false => match written == "1": Option(Quant) {
        true => Some(QuantOne)
        false => match written == "\u{3c9}": Option(Quant) {
          true => Some(QuantMany)
          false => match written == "direct": Option(Quant) {
            true => Some(QuantDirect)
            false => None
          }
        }
      }
    }
  }
}

pub fn quant_is_direct(q: Quant): Bool {
  match q: Bool {
    QuantDirect => true
    _ => false
  }
}

pub fn quant_is_many(q: Quant): Bool {
  match q: Bool {
    QuantMany => true
    _ => false
  }
}

pub fn quant_name(q: Quant): Text {
  match q: Text {
    QuantZero => "Zero"
    QuantAtMostOne => "AtMostOne"
    QuantOne => "one"
    QuantMany => "Many"
    QuantDirect => "Direct"
  }
}

pub(open) inductive RowSet: Type {
  Mk(names: Ordmap(Text, Bool)): RowSet
}

pub fn rowset_empty(): RowSet {
  RowSet::Mk(Ordmap::empty())
}

pub fn rowset_add(r: RowSet, name: Text): RowSet {
  RowSet::Mk(Ordmap::insert(r.names, name, true, Ordmap::compare_text))
}

pub fn rowset_one(name: Text): RowSet {
  rowset_add(rowset_empty(), name)
}

pub fn rowset_has(r: RowSet, name: Text): Bool {
  Ordmap::contains(r.names, name, Ordmap::compare_text)
}

pub fn rowset_drop(r: RowSet, name: Text): RowSet {
  RowSet::Mk(Ordmap::remove(r.names, name, Ordmap::compare_text))
}

pub fn rowset_keys(entries: List(Pair(Text, Bool))): List(Text) {
  match entries: List(Text) {
    Nil => Nil
    Cons(e, rest) => Cons(e.fst, rowset_keys(rest))
  }
}

pub fn rowset_list(r: RowSet): List(Text) {
  rowset_keys(Ordmap::entries(r.names))
}

pub fn rowset_add_all(names: List(Text), r: RowSet): RowSet {
  match names: RowSet {
    Nil => r
    Cons(n, rest) => rowset_add_all(rest, rowset_add(r, n))
  }
}

pub fn rowset_union(a: RowSet, b: RowSet): RowSet {
  rowset_add_all(rowset_list(b), a)
}

pub fn rowset_of(names: List(Text)): RowSet {
  rowset_add_all(names, rowset_empty())
}

pub(open) inductive RowLatent: Type {
  LatentKnown(row: RowSet): RowLatent
  LatentUnknown: RowLatent
  // The `info` of an `exceeded` arm: `info.more(m)` performs what `k` does,
  // `info.unbounded()` that and `Div`.
  LatentInfo: RowLatent
}

pub(open) inductive RowLocal: Type {
  Mk(name: Text, latent: RowLatent): RowLocal
}

pub(open) inductive RowSpan: Type {
  Mk(start: Nat, end: Nat): RowSpan
}

pub fn rows_compare_span(a: RowSpan, b: RowSpan): Ordering {
  match Ordmap::compare_nat(a.start, b.start): Ordering {
    Equal => Ordmap::compare_nat(a.end, b.end)
    Less => Less
    Greater => Greater
  }
}

pub(open) inductive RowDiagnostic: Type {
  Mk(message: Text, start: Nat, end: Nat): RowDiagnostic
}

// The functions and the quantities, which the analysis only reads.
// `externs`: the extern functions the program declares, not the prelude.
pub(open) inductive RowEnv: Type {
  Mk(
    fns: Ordmap(Text, SurfaceFn),
    quants: Ordmap(Text, Quant),
    externs: Ordmap(Text, Bool)
  ): RowEnv
}

// What it finds as it goes: the rows inferred, the functions being
// followed, the row of each call, the row variables bounded `direct` of the
// function being followed, and the errors found while following calls, once
// each.
pub(open) inductive RowState: Type {
  Mk(
    memo: Ordmap(Text, RowSet),
    in_progress: Ordmap(Text, Bool),
    calls: Ordmap(RowSpan, RowSet),
    direct_vars: List(Text),
    found: List(RowDiagnostic)
  ): RowState
}

pub fn rows_empty_state(): RowState {
  RowState::Mk(Ordmap::empty(), Ordmap::empty(), Ordmap::empty(), Nil, Nil)
}

pub fn rows_set_memo(s: RowState, memo: Ordmap(Text, RowSet)): RowState {
  RowState::Mk(memo, s.in_progress, s.calls, s.direct_vars, s.found)
}

pub fn rows_set_in_progress(s: RowState, in_progress: Ordmap(Text, Bool)): RowState {
  RowState::Mk(s.memo, in_progress, s.calls, s.direct_vars, s.found)
}

pub fn rows_set_calls(s: RowState, calls: Ordmap(RowSpan, RowSet)): RowState {
  RowState::Mk(s.memo, s.in_progress, calls, s.direct_vars, s.found)
}

pub fn rows_set_direct(s: RowState, direct_vars: List(Text)): RowState {
  RowState::Mk(s.memo, s.in_progress, s.calls, direct_vars, s.found)
}

pub fn rows_set_found(s: RowState, found: List(RowDiagnostic)): RowState {
  RowState::Mk(s.memo, s.in_progress, s.calls, s.direct_vars, found)
}

pub(open) inductive RowsOut: Type {
  Mk(row: RowSet, s: RowState): RowsOut
}

pub(open) inductive LatentOut: Type {
  Mk(latent: RowLatent, s: RowState): LatentOut
}

pub(open) inductive FoundOut: Type {
  Mk(row: RowSet, found: Bool, s: RowState): FoundOut
}

pub fn rows_effect_of_op(op: Text): Text {
  match op == "exceeded": Text {
    true => "exceeded"
    false => op
  }
}

pub fn rows_unchecked(what: Text): Text {
  Text::concat("?", what)
}

pub fn rows_quoted(name: Text): Text {
  Text::concat_all(Cons("`", Cons(name, Cons("`", Nil))))
}

pub fn rows_has_prefix(t: Text, p: Text): Bool {
  Text::starts_with(t, p)
}

pub fn rows_after_first(t: Text): Text {
  Text::slice_or_empty(t, 1, Text::len(t))
}

pub fn rows_has_text(xs: List(Text), x: Text): Bool {
  match xs: Bool {
    Nil => false
    Cons(y, rest) => match y == x: Bool {
      true => true
      false => rows_has_text(rest, x)
    }
  }
}

pub fn rows_env_fn(env: RowEnv, name: Text): Option(SurfaceFn) {
  Ordmap::get(env.fns, name, Ordmap::compare_text)
}

pub fn rows_env_has(env: RowEnv, name: Text): Bool {
  Ordmap::contains(env.fns, name, Ordmap::compare_text)
}

pub fn rows_quant_of(env: RowEnv, eff: Text): Option(Quant) {
  Ordmap::get(env.quants, eff, Ordmap::compare_text)
}

pub fn rows_initial_quants(): Ordmap(Text, Quant) {
  Ordmap::insert(
    Ordmap::insert(
      Ordmap::insert(Ordmap::empty(), "show", QuantDirect, Ordmap::compare_text),
      "exceeded",
      QuantAtMostOne,
      Ordmap::compare_text
    ),
    "Div",
    QuantZero,
    Ordmap::compare_text
  )
}

pub fn rows_extern_names(fns: List(SurfaceFn), out: Ordmap(Text, Bool)): Ordmap(Text, Bool) {
  match fns: Ordmap(Text, Bool) {
    Nil => out
    Cons(f, rest) => rows_extern_names(rest, Ordmap::insert(out, f.name, true, Ordmap::compare_text))
  }
}

pub fn rows_user_externs(stmts: List(SurfaceStmt), out: Ordmap(Text, Bool)): Ordmap(Text, Bool) {
  match stmts: Ordmap(Text, Bool) {
    Nil => out
    Cons(st, rest) => match st: Ordmap(Text, Bool) {
      StExtern(l, fns, a, b) => rows_user_externs(rest, rows_extern_names(fns, out))
      _ => rows_user_externs(rest, out)
    }
  }
}

pub fn rows_env_add_fn(env: RowEnv, f: SurfaceFn): RowEnv {
  RowEnv::Mk(Ordmap::insert(env.fns, f.name, f, Ordmap::compare_text), env.quants, env.externs)
}

pub fn rows_env_externs(fns: List(SurfaceFn), env: RowEnv): RowEnv {
  match fns: RowEnv {
    Nil => env
    Cons(f, rest) => rows_env_externs(rest, rows_env_add_fn(env, f))
  }
}

pub fn rows_written_quant(r#resume: Option(Text)): Quant {
  match r#resume: Quant {
    None => QuantAtMostOne
    Some(written) => match quant_parse(written): Quant {
      Some(q) => q
      None => QuantAtMostOne
    }
  }
}

pub fn rows_env_stmt(s: SurfaceStmt, env: RowEnv): RowEnv {
  match s: RowEnv {
    StFn(f) => rows_env_add_fn(env, f)
    StExtern(language, fns, start, end) => rows_env_externs(fns, env)
    StEffect(e) => RowEnv::Mk(
      env.fns,
      Ordmap::insert(env.quants, e.name, rows_written_quant(e.r#resume), Ordmap::compare_text),
      env.externs
    )
    _ => env
  }
}

// The prelude's functions and effects, then the program's: a later
// declaration of a name hides the earlier one.
pub fn rows_env_of(stmts: List(SurfaceStmt), env: RowEnv): RowEnv {
  match stmts: RowEnv {
    Nil => env
    Cons(s, rest) => rows_env_of(rest, rows_env_stmt(s, env))
  }
}

pub fn rows_local_find(locals: List(RowLocal), name: Text): Option(RowLocal) {
  match locals: Option(RowLocal) {
    Nil => None
    Cons(l, rest) => match l.name == name: Option(RowLocal) {
      true => Some(l)
      false => rows_local_find(rest, name)
    }
  }
}

pub fn rows_local_has(locals: List(RowLocal), name: Text): Bool {
  match rows_local_find(locals, name): Bool {
    Some(l) => true
    None => false
  }
}

pub fn rows_push(locals: List(RowLocal), name: Text, latent: RowLatent): List(RowLocal) {
  Cons(RowLocal::Mk(name, latent), locals)
}

mutual {
  pub fn rows_bind_pattern(p: SurfacePattern, locals: List(RowLocal)): List(RowLocal) {
    match p: List(RowLocal) {
      PtBind(n) => rows_push(locals, n, LatentUnknown)
      PtCtor(name, args) => rows_bind_all(args, locals)
      PtRecord(name, fields) => rows_bind_fields(fields, locals)
      PtWild => locals
      PtInt(negative, n) => locals
      PtBool(b) => locals
      PtText(t) => locals
      PtOther(n) => locals
    }
  }
  pub fn rows_bind_all(patterns: List(SurfacePattern), locals: List(RowLocal)): List(RowLocal) {
    match patterns: List(RowLocal) {
      Nil => locals
      Cons(p, rest) => rows_bind_all(rest, rows_bind_pattern(p, locals))
    }
  }
  pub fn rows_bind_fields(
    fields: List(SurfacePatternField),
    locals: List(RowLocal)
  ): List(RowLocal) {
    match fields: List(RowLocal) {
      Nil => locals
      Cons(f, rest) => rows_bind_fields(rest, rows_bind_field(f, locals))
    }
  }
  pub fn rows_bind_field(f: SurfacePatternField, locals: List(RowLocal)): List(RowLocal) {
    match f: List(RowLocal) {
      SurfacePatternFieldMk(name, p) => rows_bind_pattern(p, locals)
    }
  }
}

pub fn rows_irrefutable(p: SurfacePattern): Bool {
  match p: Bool {
    PtWild => true
    PtBind(n) => true
    _ => false
  }
}

pub fn rows_all_irrefutable(ps: List(SurfacePattern)): Bool {
  match ps: Bool {
    Nil => true
    Cons(p, rest) => rows_irrefutable(p) && rows_all_irrefutable(rest)
  }
}

mutual {
  pub fn rows_function_kind(t: SurfaceTerm): SurfaceKind {
    match t: SurfaceKind {
      SurfaceTermIndexedMk(kind, start, end, ast_occurrence) => rows_function_kind_of(kind, kind)
    }
  }
  pub fn rows_function_kind_of(kind: SurfaceKind, whole: SurfaceKind): SurfaceKind {
    match kind: SurfaceKind {
      SkFnKind(fk, ty) => rows_function_kind(ty)
      SkBorrow(mutable, ty) => rows_function_kind(ty)
      _ => whole
    }
  }
}

pub fn rows_latent_of_type(ty: Option(SurfaceTerm)): RowLatent {
  match ty: RowLatent {
    None => LatentUnknown
    Some(t) => match rows_function_kind(t): RowLatent {
      SkPi(ps, r, effects) => match effects: RowLatent {
        Some(names) => LatentKnown(rowset_of(names))
        None => LatentKnown(rowset_empty())
      }
      _ => LatentUnknown
    }
  }
}

pub fn rows_params_locals_from(
  params: List(Text),
  types: List(Option(SurfaceTerm)),
  locals: List(RowLocal)
): List(RowLocal) {
  match params: List(RowLocal) {
    Nil => locals
    Cons(p, rest) => match types: List(RowLocal) {
      Nil => locals
      Cons(t, more) => rows_params_locals_from(
        rest,
        more,
        rows_push(locals, p, rows_latent_of_type(t))
      )
    }
  }
}

pub fn rows_params_locals(params: List(Text), types: List(Option(SurfaceTerm))): List(RowLocal) {
  rows_params_locals_from(params, types, Nil)
}

pub fn rows_unknown_all(names: List(Text), locals: List(RowLocal)): List(RowLocal) {
  match names: List(RowLocal) {
    Nil => locals
    Cons(n, rest) => rows_unknown_all(rest, rows_push(locals, n, LatentUnknown))
  }
}

// Whether the most recent local of the name is the `info` of an `exceeded` arm.
pub fn rows_is_info(locals: List(RowLocal), name: Text): Bool {
  match rows_local_find(locals, name): Bool {
    None => false
    Some(l) => match l.latent: Bool {
      LatentInfo => true
      _ => false
    }
  }
}

pub fn rows_base_is_info(base: SurfaceTerm, locals: List(RowLocal)): Bool {
  match base.kind: Bool {
    SkVar(n) => rows_is_info(locals, n)
    _ => false
  }
}

pub fn rows_is_lambda(t: SurfaceTerm): Bool {
  match t.kind: Bool {
    SkLam(ps, b) => true
    SkBorrowLam(bs, l) => true
    _ => false
  }
}

pub fn rows_bind_operation_one(
  p: SurfacePattern,
  eff: Text,
  locals: List(RowLocal)
): List(RowLocal) {
  match p: List(RowLocal) {
    PtBind(n) => match eff == "exceeded": List(RowLocal) {
      true => rows_push(locals, n, LatentInfo)
      false => match eff == "spawn": List(RowLocal) {
        // A spawned body may diverge without using its caller's handler stack.
        true => rows_push(locals, n, LatentKnown(rowset_one("Div")))
        false => rows_bind_pattern(p, locals)
      }
    }
    PtCtor(name, args) => rows_bind_pattern(p, locals)
    PtRecord(name, fields) => rows_bind_pattern(p, locals)
    _ => locals
  }
}

pub fn rows_bind_operation(
  patterns: List(SurfacePattern),
  eff: Text,
  locals: List(RowLocal)
): List(RowLocal) {
  match patterns: List(RowLocal) {
    Nil => locals
    Cons(p, rest) => rows_bind_operation(rest, eff, rows_bind_operation_one(p, eff, locals))
  }
}

// What the body performs, less the effects the handlers answer completely
// (an irrefutable arm without a guard).
pub fn rows_answered(handlers: List(SurfaceHandler), inner: RowSet): RowSet {
  match handlers: RowSet {
    Nil => inner
    Cons(h, rest) => match h: RowSet {
      HdOperation(eff, hfa, hty, patterns, cont, guard, body) => match guard: RowSet {
        None => match rows_all_irrefutable(patterns): RowSet {
          true => rows_answered(rest, rowset_drop(inner, rows_effect_of_op(eff)))
          false => rows_answered(rest, inner)
        }
        Some(g) => rows_answered(rest, inner)
      }
      HdReturn(pattern, body) => rows_answered(rest, inner)
    }
  }
}

pub fn rows_not_bars(es: List(Text)): List(Text) {
  match es: List(Text) {
    Nil => Nil
    Cons(e, rest) => match rows_has_prefix(e, "|"): List(Text) {
      true => rows_not_bars(rest)
      false => Cons(e, rows_not_bars(rest))
    }
  }
}

// The effects written beside `|rvar` in a function type's row, or `None`
// when there is no type or it is not a function type whose row holds the
// variable.
pub fn rows_named(ty: Option(SurfaceTerm), rvar: Text): Option(List(Text)) {
  match ty: Option(List(Text)) {
    None => None
    Some(t) => match rows_function_kind(t): Option(List(Text)) {
      SkPi(ps, r, effects) => match effects: Option(List(Text)) {
        Some(es) => match rows_has_text(es, Text::concat("|", rvar)): Option(List(Text)) {
          true => Some(rows_not_bars(es))
          false => None
        }
        None => None
      }
      _ => None
    }
  }
}

pub fn rows_without(names: List(Text), r: RowSet): RowSet {
  match names: RowSet {
    Nil => r
    Cons(n, rest) => rows_without(rest, rowset_drop(r, n))
  }
}

pub fn rows_found_at(found: List(RowDiagnostic), message: Text, start: Nat, end: Nat): Bool {
  match found: Bool {
    Nil => false
    Cons(d, rest) => match d.message == message && d.start == start && d.end == end: Bool {
      true => true
      false => rows_found_at(rest, message, start, end)
    }
  }
}

pub fn rows_report(s: RowState, message: Text, start: Nat, end: Nat): RowState {
  match rows_found_at(s.found, message, start, end): RowState {
    true => s
    false => rows_set_found(s, List::append(s.found, Cons(RowDiagnostic::Mk(message, start, end), Nil)))
  }
}

pub fn rows_record_call(s: RowState, t: SurfaceTerm, row: RowSet): RowState {
  rows_set_calls(s, Ordmap::insert(s.calls, RowSpan::Mk(t.start, t.end), row, rows_compare_span))
}

pub fn rows_tail_bounds(bounds: List(Option(Text))): List(Option(Text)) {
  match bounds: List(Option(Text)) {
    Nil => Nil
    Cons(b, rest) => rest
  }
}

pub fn rows_first_is_direct(bounds: List(Option(Text))): Bool {
  match bounds: Bool {
    Nil => false
    Cons(b, bs) => match b: Bool {
      Some(x) => x == "direct"
      None => false
    }
  }
}

pub fn rows_direct_generics(generics: List(Text), bounds: List(Option(Text))): List(Text) {
  match generics: List(Text) {
    Nil => Nil
    Cons(g, rest) => match rows_first_is_direct(bounds): List(Text) {
      true => Cons(g, rows_direct_generics(rest, rows_tail_bounds(bounds)))
      false => rows_direct_generics(rest, rows_tail_bounds(bounds))
    }
  }
}

// Whether `effect` is a direct operation (or a row variable bounded
// `direct`, or one that cannot be followed, which is reported already).
pub fn rows_is_direct(env: RowEnv, s: RowState, eff: Text): Bool {
  match rows_has_prefix(eff, "|"): Bool {
    true => rows_has_text(s.direct_vars, rows_after_first(eff))
    false => match rows_has_prefix(eff, "?"): Bool {
      true => true
      false => match rows_quant_of(env, eff): Bool {
        Some(q) => quant_is_direct(q)
        None => false
      }
    }
  }
}

// The first effect of the row that may suspend.
pub fn rows_extern_closure(
  effects: List(Text),
  env: RowEnv,
  s: RowState,
  t: SurfaceTerm
): RowState {
  match effects: RowState {
    Nil => s
    Cons(eff, rest) => match not(rows_is_direct(
      env,
      s,
      eff
    )) && not(rows_has_prefix(eff, "|")) && not(eff == "Div"): RowState {
      true => rows_report(
        s,
        Text::concat_all(
          Cons(
            "a closure passed to an extern cannot perform ",
            Cons(eff, Cons(", which may suspend", Nil))
          )
        ),
        t.start,
        t.end
      )
      false => rows_extern_closure(rest, env, s, t)
    }
  }
}

pub fn rows_shown(eff: Text): Text {
  match rows_has_prefix(eff, "|"): Text {
    true => rows_after_first(eff)
    false => eff
  }
}

pub fn rows_direct_arm_one(
  env: RowEnv,
  s: RowState,
  op: Text,
  eff: Text,
  body: SurfaceTerm
): RowState {
  match rows_is_direct(env, s, eff): RowState {
    true => s
    false => rows_report(
      s,
      Text::concat_all(
        Cons(
          "the arm of ",
          Cons(op, Cons(" performs ", Cons(rows_shown(eff), Cons(", which is not direct", Nil))))
        )
      ),
      body.start,
      body.end
    )
  }
}

// The arm of a direct operation performs direct operations only.
pub fn rows_direct_arm(
  effects: List(Text),
  env: RowEnv,
  s: RowState,
  op: Text,
  body: SurfaceTerm
): RowState {
  match effects: RowState {
    Nil => s
    Cons(eff, rest) => rows_direct_arm(
      rest,
      env,
      rows_direct_arm_one(env, s, op, eff, body),
      op,
      body
    )
  }
}

pub fn rows_bounded_direct_one(
  env: RowEnv,
  s: RowState,
  rvar: Text,
  eff: Text,
  t: SurfaceTerm
): RowState {
  match rows_is_direct(env, s, eff): RowState {
    true => s
    false => rows_report(
      s,
      Text::concat_all(Cons(eff, Cons(" is not direct but ", Cons(rvar, Cons(" is direct", Nil))))),
      t.start,
      t.end
    )
  }
}

// `<e: direct>`: what is passed for `e` may only be direct.
pub fn rows_bounded_direct(
  effects: List(Text),
  env: RowEnv,
  s: RowState,
  rvar: Text,
  t: SurfaceTerm
): RowState {
  match effects: RowState {
    Nil => s
    Cons(eff, rest) => rows_bounded_direct(
      rest,
      env,
      rows_bounded_direct_one(env, s, rvar, eff, t),
      rvar,
      t
    )
  }
}

pub fn rows_is_many(env: RowEnv, eff: Text): Bool {
  match rows_quant_of(env, eff): Bool {
    Some(q) => quant_is_many(q)
    None => false
  }
}

pub fn rows_bounded_effect(
  env: RowEnv,
  s: RowState,
  rvar: Text,
  eff: Text,
  t: SurfaceTerm
): RowState {
  match rows_is_many(env, eff): RowState {
    false => s
    true => rows_report(
      s,
      Text::concat_all(Cons(eff, Cons(" resumes \u{3c9} but ", Cons(rvar, Cons(" is <=1", Nil))))),
      t.start,
      t.end
    )
  }
}

// `<!e: <=1>`: what is passed for `e` may not resume more than once.
pub fn rows_bounded_effects(
  effects: List(Text),
  env: RowEnv,
  s: RowState,
  rvar: Text,
  t: SurfaceTerm
): RowState {
  match effects: RowState {
    Nil => s
    Cons(eff, rest) => rows_bounded_effects(
      rest,
      env,
      rows_bounded_effect(env, s, rvar, eff, t),
      rvar,
      t
    )
  }
}

pub fn rows_position(xs: List(Text), x: Text, at: Nat): Option(Nat) {
  match xs: Option(Nat) {
    Nil => None
    Cons(y, rest) => match y == x: Option(Nat) {
      true => Some(at)
      false => rows_position(rest, x, at + 1)
    }
  }
}

pub fn rows_nth_bound(bounds: List(Option(Text)), i: Nat): Option(Text) {
  match bounds: Option(Text) {
    Nil => None
    Cons(b, rest) => match i: Option(Text) {
      Zero => b
      Succ(j) => rows_nth_bound(rest, j)
    }
  }
}

pub fn rows_bound_of(callee: SurfaceFn, rvar: Text): Option(Text) {
  match rows_position(callee.generics, rvar, 0): Option(Text) {
    None => None
    Some(i) => rows_nth_bound(callee.bounds, i)
  }
}

pub fn rows_bound_is(bound: Option(Text), what: Text): Bool {
  match bound: Bool {
    Some(b) => b == what
    None => false
  }
}

pub fn rows_bounded_limited(
  bound: Option(Text),
  env: RowEnv,
  s: RowState,
  rvar: Text,
  row: RowSet,
  t: SurfaceTerm
): RowState {
  match rows_bound_is(bound, "<=1"): RowState {
    true => rows_bounded_effects(rowset_list(row), env, s, rvar, t)
    false => s
  }
}

pub fn rows_bounded(
  env: RowEnv,
  s: RowState,
  rvar: Text,
  callee: SurfaceFn,
  row: RowSet,
  t: SurfaceTerm
): RowState {
  match rows_bound_is(rows_bound_of(callee, rvar), "direct"): RowState {
    true => rows_bounded_limited(
      rows_bound_of(callee, rvar),
      env,
      rows_bounded_direct(rowset_list(row), env, s, rvar, t),
      rvar,
      row,
      t
    )
    false => rows_bounded_limited(rows_bound_of(callee, rvar), env, s, rvar, row, t)
  }
}

pub fn rows_instantiated(r: FoundOut, rvar: Text): RowsOut {
  match r.found: RowsOut {
    true => RowsOut::Mk(r.row, r.s)
    false => RowsOut::Mk(
      rowset_add(r.row, rows_unchecked(Text::concat("the row variable ", rows_quoted(rvar)))),
      r.s
    )
  }
}

pub fn rows_passed(latent: RowLatent, named: List(Text), rvar: Text): RowSet {
  match latent: RowSet {
    LatentKnown(r) => rows_without(named, r)
    _ => rowset_one(rows_unchecked(Text::concat("the function passed for ", rows_quoted(rvar))))
  }
}

pub fn rows_callee_known(latent: RowLatent, n: Text): RowSet {
  match latent: RowSet {
    LatentKnown(r) => r
    _ => rowset_one(rows_unchecked(Text::concat("calling ", rows_quoted(n))))
  }
}

pub fn rows_applied_known(latent: RowLatent): RowSet {
  match latent: RowSet {
    LatentKnown(r) => r
    _ => rowset_one(rows_unchecked("an applied function"))
  }
}

pub fn rows_applied_expression(): RowSet {
  rowset_one(rows_unchecked("an applied expression"))
}

pub fn rows_field_call(base: SurfaceTerm, name: Text, locals: List(RowLocal)): RowSet {
  match rows_base_is_info(base, locals): RowSet {
    true => match name == "unbounded": RowSet {
      true => rowset_one("Div")
      false => rowset_empty()
    }
    false => rows_applied_expression()
  }
}

pub fn rows_is_direct_op(env: RowEnv, eff: Text): Bool {
  match rows_quant_of(env, rows_effect_of_op(eff)): Bool {
    Some(q) => quant_is_direct(q)
    None => false
  }
}

pub fn rows_after_arm(
  env: RowEnv,
  s: RowState,
  eff: Text,
  arm: RowSet,
  body: SurfaceTerm
): RowState {
  match rows_is_direct_op(env, eff): RowState {
    true => rows_direct_arm(rowset_list(arm), env, s, eff, body)
    false => s
  }
}

pub fn rows_with_cont(bound: List(RowLocal), cont: Option(Text)): List(RowLocal) {
  match cont: List(RowLocal) {
    // `k` performs what the handle performs, which is accounted for by the
    // handle's own row.
    Some(k) => rows_push(bound, k, LatentKnown(rowset_empty()))
    None => bound
  }
}

pub fn rows_set_add_div(row: RowSet, calls: Bool): RowSet {
  match calls: RowSet {
    true => rowset_add(row, "Div")
    false => row
  }
}

pub fn rows_is_var(t: SurfaceTerm, name: Text): Bool {
  match t.kind: Bool {
    SkVar(n) => n == name
    _ => false
  }
}

mutual {
  pub fn rows_term_calls(t: SurfaceTerm, name: Text): Bool {
    match t: Bool {
      SurfaceTermIndexedMk(kind, start, end, ast_occurrence) => rows_kind_calls(kind, name)
    }
  }
  pub fn rows_kind_calls(k: SurfaceKind, name: Text): Bool {
    match k: Bool {
      SkApp(function, arguments) => rows_is_var(
        function,
        name
      ) || rows_term_calls(function, name) || rows_terms_call(arguments, name)
      SkLam(params, body) => rows_term_calls(body, name)
      SkBorrowLam(borrows, lam) => rows_term_calls(lam, name)
      SkBorrow(mutable, term) => rows_term_calls(term, name)
      SkRecord(n, fields) => rows_fields_call(fields, name)
      SkIf(condition, then, otherwise) => rows_term_calls(
        condition,
        name
      ) || rows_term_calls(then, name) || rows_opt_calls(otherwise, name)
      SkField(base, n) => rows_term_calls(base, name)
      SkTagged(tag, term) => rows_term_calls(term, name)
      SkPerform(eff, args) => rows_terms_call(args, name)
      SkBudget(steps_memory, steps, body) => rows_term_calls(
        steps,
        name
      ) || rows_term_calls(body, name)
      SkBlock(stmts) => rows_stmts_call(stmts, name)
      SkHandle(body, handlers) => rows_term_calls(body, name) || rows_handlers_call(handlers, name)
      SkMatch(scrutinee, result, arms, binder) => rows_term_calls(
        scrutinee,
        name
      ) || rows_arms_call(arms, name)
      _ => false
    }
  }
  pub fn rows_terms_call(terms: List(SurfaceTerm), name: Text): Bool {
    match terms: Bool {
      Nil => false
      Cons(t, rest) => rows_term_calls(t, name) || rows_terms_call(rest, name)
    }
  }
  pub fn rows_opt_calls(t: Option(SurfaceTerm), name: Text): Bool {
    match t: Bool {
      Some(x) => rows_term_calls(x, name)
      None => false
    }
  }
  pub fn rows_fields_call(fields: List(SurfaceField), name: Text): Bool {
    match fields: Bool {
      Nil => false
      Cons(f, rest) => rows_field_calls(f, name) || rows_fields_call(rest, name)
    }
  }
  pub fn rows_field_calls(f: SurfaceField, name: Text): Bool {
    match f: Bool {
      SurfaceFieldMk(n, value) => rows_term_calls(value, name)
    }
  }
  pub fn rows_arms_call(arms: List(SurfaceArm), name: Text): Bool {
    match arms: Bool {
      Nil => false
      Cons(a, rest) => rows_arm_calls(a, name) || rows_arms_call(rest, name)
    }
  }
  pub fn rows_arm_calls(a: SurfaceArm, name: Text): Bool {
    match a: Bool {
      SurfaceArmMk(pattern, guard, goal, body) => rows_term_calls(body, name)
    }
  }
  pub fn rows_handlers_call(handlers: List(SurfaceHandler), name: Text): Bool {
    match handlers: Bool {
      Nil => false
      Cons(h, rest) => rows_handler_calls(h, name) || rows_handlers_call(rest, name)
    }
  }
  pub fn rows_handler_calls(h: SurfaceHandler, name: Text): Bool {
    match h: Bool {
      HdReturn(pattern, body) => rows_term_calls(body, name)
      HdOperation(eff, hfa, hty, patterns, cont, guard, body) => rows_term_calls(
        body,
        name
      ) || rows_opt_calls(guard, name)
    }
  }
  pub fn rows_stmts_call(stmts: List(SurfaceStmt), name: Text): Bool {
    match stmts: Bool {
      Nil => false
      Cons(st, rest) => rows_stmt_calls(st, name) || rows_stmts_call(rest, name)
    }
  }
  pub fn rows_stmt_calls(st: SurfaceStmt, name: Text): Bool {
    match st: Bool {
      StLet(n, ty, value, borrow, bm) => rows_term_calls(value, name)
      StVar(n, ty, value, vb) => rows_term_calls(value, name)
      StAssign(n, n_place, value) => rows_term_calls(value, name)
      StExpr(e) => rows_term_calls(e, name)
      StReturn(v) => rows_opt_calls(v, name)
      StWhile(condition, body) => rows_term_calls(condition, name) || rows_term_calls(body, name)
      _ => false
    }
  }
}

pub fn rows_known(r: RowsOut): LatentOut {
  LatentOut::Mk(LatentKnown(r.row), r.s)
}

pub fn rows_union3(a: RowSet, b: RowSet, c: RowsOut): RowsOut {
  RowsOut::Mk(rowset_union(rowset_union(a, b), c.row), c.s)
}

pub fn rows_performed(t: SurfaceTerm, own: RowSet, args: RowsOut): RowsOut {
  RowsOut::Mk(rowset_union(args.row, own), rows_record_call(args.s, t, own))
}

pub fn rows_remember(name: Text, row: RowSet, s: RowState): RowsOut {
  RowsOut::Mk(row, rows_set_memo(s, Ordmap::insert(s.memo, name, row, Ordmap::compare_text)))
}

// The row of a followed body: `Div` when it calls itself, kept in `memo`.
pub fn rows_followed(name: Text, f: SurfaceFn, outer_direct: List(Text), r: RowsOut): RowsOut {
  rows_remember(
    name,
    rows_set_add_div(r.row, rows_term_calls(f.body, name)),
    rows_set_direct(
      rows_set_in_progress(r.s, Ordmap::remove(r.s.in_progress, name, Ordmap::compare_text)),
      outer_direct
    )
  )
}

pub fn rows_extern_latent(latent: RowLatent, env: RowEnv, s: RowState, t: SurfaceTerm): RowState {
  match latent: RowState {
    LatentKnown(row) => rows_extern_closure(rowset_list(row), env, s, t)
    _ => s
  }
}

// ---- the analysis ----------------------------------------------------------------
//
// The analysis follows calls to the bodies of other functions, so its
// readers share a number of steps; each gives one
// fewer to what it calls. When the steps run out a reader finds nothing.

mutual {
  // The row callers see: the written one, else the inferred one.
  pub fn rows_fn_row(k: Nat, env: RowEnv, s: RowState, name: Text): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), rows_empty_state())
      Succ(j) => match rows_env_fn(env, name): RowsOut {
        None => RowsOut::Mk(rowset_empty(), s)
        Some(f) => match f.effects: RowsOut {
          Some(written) => RowsOut::Mk(rowset_of(written), s)
          None => rows_inferred_row(j, env, s, name)
        }
      }
    }
  }

  // What the body performs, whatever the written row says.
  pub fn rows_inferred_row(k: Nat, env: RowEnv, s: RowState, name: Text): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match rows_env_fn(env, name): RowsOut {
        None => RowsOut::Mk(rowset_empty(), s)
        Some(f) => match Ordmap::get(s.memo, name, Ordmap::compare_text): RowsOut {
          Some(row) => RowsOut::Mk(row, s)
          None => match Ordmap::contains(s.in_progress, name, Ordmap::compare_text): RowsOut {
            true => RowsOut::Mk(rowset_one("Div"), s)
            false => rows_follow(j, env, s, name, f)
          }
        }
      }
    }
  }

  pub fn rows_follow(k: Nat, env: RowEnv, s: RowState, name: Text, f: SurfaceFn): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => rows_followed(
        name,
        f,
        s.direct_vars,
        rows_term_row(
          j,
          env,
          rows_set_direct(
            rows_set_in_progress(s, Ordmap::insert(s.in_progress, name, true, Ordmap::compare_text)),
            rows_direct_generics(f.generics, f.bounds)
          ),
          f.body,
          rows_params_locals(f.params, f.param_types)
        )
      )
    }
  }

  // What a call to the value `t` performs, when it can be told.
  pub fn rows_latent_of(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: SurfaceTerm,
    locals: List(RowLocal)
  ): LatentOut {
    match k: LatentOut {
      Zero => LatentOut::Mk(LatentUnknown, rows_empty_state())
      Succ(j) => match t.kind: LatentOut {
        SkLam(params, body) => rows_known(
          rows_term_row(j, env, s, body, rows_unknown_all(params, locals))
        )
        SkBorrowLam(borrows, lam) => rows_latent_of(j, env, s, lam, locals)
        SkBorrow(mutable, term) => rows_latent_of(j, env, s, term, locals)
        SkVar(n) => match rows_local_find(locals, n): LatentOut {
          Some(l) => LatentOut::Mk(l.latent, s)
          None => match rows_env_has(env, n): LatentOut {
            true => rows_known(rows_fn_row(j, env, s, n))
            false => LatentOut::Mk(LatentUnknown, s)
          }
        }
        _ => LatentOut::Mk(LatentUnknown, s)
      }
    }
  }

  pub fn rows_terms_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    terms: List(SurfaceTerm),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match terms: RowsOut {
        Nil => RowsOut::Mk(row, s)
        Cons(a, rest) => {
          let r := rows_term_row(j, env, s, a, locals)
          rows_terms_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
        }
      }
    }
  }

  pub fn rows_fields_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    fields: List(SurfaceField),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match fields: RowsOut {
        Nil => RowsOut::Mk(row, s)
        Cons(f, rest) => {
          let r := rows_term_row(j, env, s, f.value, locals)
          rows_fields_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
        }
      }
    }
  }

  pub fn rows_term_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: SurfaceTerm,
    locals: List(RowLocal)
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match t.kind: RowsOut {
        SkPerform(eff, args) => rows_performed(
          t,
          rowset_one(rows_effect_of_op(eff)),
          rows_terms_row(j, env, s, args, locals, rowset_empty())
        )
        SkRecord(name, fields) => rows_fields_row(j, env, s, fields, locals, rowset_empty())
        SkBorrow(mutable, term) => rows_term_row(j, env, s, term, locals)
        SkApp(function, arguments) => {
          // The arguments' rows apart, so that `r.row`, recorded for the call,
          // is what the call itself performs.
          let args := rows_terms_row(j, env, s, arguments, locals, rowset_empty())
          let r := rows_callee_row(j, env, args.s, t, function, arguments, locals)
          RowsOut::Mk(rowset_union(r.row, args.row), rows_record_call(r.s, t, r.row))
        }
        SkBudget(steps_memory, steps, body) => {
          let a := rows_term_row(j, env, s, steps, locals)
          let b := rows_term_row(j, env, a.s, body, locals)
          RowsOut::Mk(rowset_add(rowset_union(a.row, rowset_drop(b.row, "Div")), "exceeded"), b.s)
        }
        SkHandle(body, handlers) => {
          let inner := rows_term_row(j, env, s, body, locals)
          rows_handlers_row(j, env, inner.s, handlers, locals, rows_answered(handlers, inner.row))
        }
        // Making a function performs nothing; its row is latent.
        SkLam(params, body) => RowsOut::Mk(rowset_empty(), s)
        SkBlock(stmts) => rows_stmts_row(j, env, s, stmts, locals, rowset_empty())
        SkIf(condition, then, otherwise) => {
          let a := rows_term_row(j, env, s, condition, locals)
          let b := rows_term_row(j, env, a.s, then, locals)
          rows_union3(a.row, b.row, rows_opt_row(j, env, b.s, otherwise, locals))
        }
        SkField(base, name) => rows_term_row(j, env, s, base, locals)
        SkTagged(tag, term) => rows_term_row(j, env, s, term, locals)
        SkMatch(scrutinee, result, arms, binder) => {
          let a := rows_term_row(j, env, s, scrutinee, locals)
          rows_arms_row(j, env, a.s, arms, locals, a.row)
        }
        _ => RowsOut::Mk(rowset_empty(), s)
      }
    }
  }

  pub fn rows_opt_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: Option(SurfaceTerm),
    locals: List(RowLocal)
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match t: RowsOut {
        Some(x) => rows_term_row(j, env, s, x, locals)
        None => RowsOut::Mk(rowset_empty(), s)
      }
    }
  }

  pub fn rows_arms_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    arms: List(SurfaceArm),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match arms: RowsOut {
        Nil => RowsOut::Mk(row, s)
        Cons(arm, rest) => {
          let g := rows_opt_row(j, env, s, arm.guard, rows_bind_pattern(arm.pattern, locals))
          let b := rows_term_row(j, env, g.s, arm.body, rows_bind_pattern(arm.pattern, locals))
          rows_arms_row(j, env, b.s, rest, locals, rowset_union(rowset_union(row, g.row), b.row))
        }
      }
    }
  }

  pub fn rows_handlers_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    handlers: List(SurfaceHandler),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match handlers: RowsOut {
        Nil => RowsOut::Mk(row, s)
        Cons(h, rest) => {
          let r := rows_handler_row(j, env, s, h, locals)
          rows_handlers_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
        }
      }
    }
  }

  pub fn rows_handler_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    h: SurfaceHandler,
    locals: List(RowLocal)
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match h: RowsOut {
        HdReturn(pattern, body) => rows_term_row(
          j,
          env,
          s,
          body,
          rows_bind_pattern(pattern, locals)
        )
        HdOperation(eff, hfa, hty, patterns, cont, guard, body) => {
          let g := rows_opt_row(
            j,
            env,
            s,
            guard,
            rows_with_cont(rows_bind_operation(patterns, eff, locals), cont)
          )
          let b := rows_term_row(
            j,
            env,
            g.s,
            body,
            rows_with_cont(rows_bind_operation(patterns, eff, locals), cont)
          )
          RowsOut::Mk(
            rowset_union(g.row, b.row),
            rows_after_arm(env, b.s, eff, rowset_union(g.row, b.row), body)
          )
        }
      }
    }
  }

  pub fn rows_stmts_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    stmts: List(SurfaceStmt),
    locals: List(RowLocal),
    row: RowSet
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match stmts: RowsOut {
        Nil => RowsOut::Mk(row, s)
        Cons(st, rest) => match st: RowsOut {
          StLet(name, ty, value, borrow, bm) => rows_bind_stmt(
            j,
            env,
            s,
            rest,
            locals,
            row,
            name,
            value
          )
          StVar(name, ty, value, vb) => rows_bind_stmt(j, env, s, rest, locals, row, name, value)
          StAssign(name, name_place, value) => {
            let r := rows_term_row(j, env, s, value, locals)
            rows_stmts_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
          }
          StExpr(e) => {
            let r := rows_term_row(j, env, s, e, locals)
            rows_stmts_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
          }
          StReturn(v) => {
            let r := rows_opt_row(j, env, s, v, locals)
            rows_stmts_row(j, env, r.s, rest, locals, rowset_union(row, r.row))
          }
          StWhile(condition, body) => {
            let a := rows_term_row(j, env, s, condition, locals)
            let b := rows_term_row(j, env, a.s, body, locals)
            rows_stmts_row(
              j,
              env,
              b.s,
              rest,
              locals,
              rowset_add(rowset_union(rowset_union(row, a.row), b.row), "Div")
            )
          }
          _ => rows_stmts_row(j, env, s, rest, locals, row)
        }
      }
    }
  }

  pub fn rows_bind_stmt(
    k: Nat,
    env: RowEnv,
    s: RowState,
    rest: List(SurfaceStmt),
    locals: List(RowLocal),
    row: RowSet,
    name: Text,
    value: SurfaceTerm
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => {
        let r := rows_term_row(j, env, s, value, locals)
        let l := rows_bound_latent(j, env, r.s, value, locals)
        rows_stmts_row(
          j,
          env,
          l.s,
          rest,
          rows_push(locals, name, l.latent),
          rowset_union(row, r.row)
        )
      }
    }
  }

  pub fn rows_bound_latent(
    k: Nat,
    env: RowEnv,
    s: RowState,
    value: SurfaceTerm,
    locals: List(RowLocal)
  ): LatentOut {
    match k: LatentOut {
      Zero => LatentOut::Mk(LatentUnknown, s)
      Succ(j) => match rows_is_lambda(value): LatentOut {
        true => rows_latent_of(j, env, s, value, locals)
        false => LatentOut::Mk(LatentUnknown, s)
      }
    }
  }

  pub fn rows_callee_row(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: SurfaceTerm,
    function: SurfaceTerm,
    arguments: List(SurfaceTerm),
    locals: List(RowLocal)
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match function.kind: RowsOut {
        SkVar(n) => match rows_local_has(locals, n): RowsOut {
          true => {
            let l := rows_latent_of(j, env, s, function, locals)
            RowsOut::Mk(rows_callee_known(l.latent, n), l.s)
          }
          false => match rows_env_fn(env, n): RowsOut {
            None => RowsOut::Mk(rowset_empty(), s)
            Some(callee) => {
              let c := rows_externs_checked(j, env, s, n, arguments, locals, t)
              let r := rows_fn_row(j, env, c, n)
              rows_callee_effects(
                j,
                env,
                r.s,
                t,
                callee,
                arguments,
                locals,
                rowset_list(r.row),
                rowset_empty()
              )
            }
          }
        }
        SkField(base, name) => RowsOut::Mk(rows_field_call(base, name, locals), s)
        SkLam(ps, b) => {
          let l := rows_latent_of(j, env, s, function, locals)
          RowsOut::Mk(rows_applied_known(l.latent), l.s)
        }
        SkBorrowLam(bs, b) => {
          let l := rows_latent_of(j, env, s, function, locals)
          RowsOut::Mk(rows_applied_known(l.latent), l.s)
        }
        _ => RowsOut::Mk(rows_applied_expression(), s)
      }
    }
  }

  // A closure passed to an extern runs inside a Rust frame, which cannot be
  // suspended: its row has direct operations only.
  pub fn rows_externs_checked(
    k: Nat,
    env: RowEnv,
    s: RowState,
    n: Text,
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    t: SurfaceTerm
  ): RowState {
    match k: RowState {
      Zero => rows_empty_state()
      Succ(j) => match Ordmap::contains(env.externs, n, Ordmap::compare_text): RowState {
        true => rows_extern_closures(j, env, s, arguments, locals, t)
        false => s
      }
    }
  }

  pub fn rows_extern_closures(
    k: Nat,
    env: RowEnv,
    s: RowState,
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    t: SurfaceTerm
  ): RowState {
    match k: RowState {
      Zero => s
      Succ(j) => match arguments: RowState {
        Nil => s
        Cons(a, rest) => {
          let l := rows_latent_of(j, env, s, a, locals)
          rows_extern_closures(j, env, rows_extern_latent(l.latent, env, l.s, t), rest, locals, t)
        }
      }
    }
  }

  // The effects of the callee's row: a row variable is instantiated, the
  // others stay.
  pub fn rows_callee_effects(
    k: Nat,
    env: RowEnv,
    s: RowState,
    t: SurfaceTerm,
    callee: SurfaceFn,
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    effects: List(Text),
    row: RowSet
  ): RowsOut {
    match k: RowsOut {
      Zero => RowsOut::Mk(rowset_empty(), s)
      Succ(j) => match effects: RowsOut {
        Nil => RowsOut::Mk(row, s)
        Cons(eff, rest) => match rows_has_prefix(eff, "|"): RowsOut {
          true => {
            let r := rows_instantiated(
              rows_instantiate(
                j,
                env,
                s,
                rows_after_first(eff),
                callee.param_types,
                arguments,
                locals,
                rowset_empty(),
                false
              ),
              rows_after_first(eff)
            )
            rows_callee_effects(
              j,
              env,
              rows_bounded(env, r.s, rows_after_first(eff), callee, r.row, t),
              t,
              callee,
              arguments,
              locals,
              rest,
              rowset_union(row, r.row)
            )
          }
          false => rows_callee_effects(
            j,
            env,
            s,
            t,
            callee,
            arguments,
            locals,
            rest,
            rowset_add(row, eff)
          )
        }
      }
    }
  }

  // The callee's row variable `rvar`, as the rows of the arguments passed
  // for the parameters whose type mentions it.
  pub fn rows_instantiate(
    k: Nat,
    env: RowEnv,
    s: RowState,
    rvar: Text,
    types: List(Option(SurfaceTerm)),
    arguments: List(SurfaceTerm),
    locals: List(RowLocal),
    row: RowSet,
    found: Bool
  ): FoundOut {
    match k: FoundOut {
      Zero => FoundOut::Mk(rowset_empty(), false, rows_empty_state())
      Succ(j) => match types: FoundOut {
        Nil => FoundOut::Mk(row, found, s)
        Cons(ty, more) => match arguments: FoundOut {
          Nil => FoundOut::Mk(row, found, s)
          Cons(arg, others) => match rows_named(ty, rvar): FoundOut {
            None => rows_instantiate(j, env, s, rvar, more, others, locals, row, found)
            Some(Named) => {
              let l := rows_latent_of(j, env, s, arg, locals)
              rows_instantiate(
                j,
                env,
                l.s,
                rvar,
                more,
                others,
                locals,
                rowset_union(row, rows_passed(l.latent, Named, rvar)),
                true
              )
            }
          }
        }
      }
    }
  }
}

// ---- the report ------------------------------------------------------------------
//
// `check_program_rows` of `rows.rs`: the rows of a program's functions and
// the errors, and the dump of the report the differential test compares.

pub(open) inductive RowFn: Type {
  Mk(name: Text, row: RowSet): RowFn
}

pub(open) inductive RowReport: Type {
  Mk(
    functions: List(RowFn),
    errors: List(RowDiagnostic),
    calls: Ordmap(RowSpan, RowSet),
    quants: Ordmap(Text, Quant)
  ): RowReport
}

pub fn rows_program_names(stmts: List(SurfaceStmt), done: Ordmap(Text, Bool)): Ordmap(Text, Bool) {
  match stmts: Ordmap(Text, Bool) {
    Nil => done
    Cons(s, rest) => match s: Ordmap(Text, Bool) {
      StFn(f) => rows_program_names(rest, Ordmap::insert(done, f.name, true, Ordmap::compare_text))
      _ => rows_program_names(rest, done)
    }
  }
}

pub(open) inductive RowNamed: Type {
  Mk(start: Nat, name: Text): RowNamed
}

pub fn rows_start_of(env: RowEnv, name: Text): Nat {
  match rows_env_fn(env, name): Nat {
    Some(f) => f.start
    None => 0
  }
}

pub fn rows_insert_sorted(xs: List(RowNamed), x: RowNamed): List(RowNamed) {
  match xs: List(RowNamed) {
    Nil => Cons(x, Nil)
    Cons(y, rest) => match x.start <= y.start: List(RowNamed) {
      true => Cons(x, xs)
      false => Cons(y, rows_insert_sorted(rest, x))
    }
  }
}

// The names, by where their functions start.
pub fn rows_sort_names(names: List(Text), env: RowEnv, done: List(RowNamed)): List(RowNamed) {
  match names: List(RowNamed) {
    Nil => done
    Cons(n, rest) => rows_sort_names(
      rest,
      env,
      rows_insert_sorted(done, RowNamed::Mk(rows_start_of(env, n), n))
    )
  }
}

pub fn rows_show(names: List(Text)): Text {
  text_join(names, ", ")
}

pub fn rows_error(message: Text, f: SurfaceFn): RowDiagnostic {
  RowDiagnostic::Mk(message, f.start, f.end)
}

pub fn rows_unwritten(
  name: Text,
  f: SurfaceFn,
  eff: Text,
  more: List(RowDiagnostic)
): List(RowDiagnostic) {
  match f.effects: List(RowDiagnostic) {
    None => more
    Some(written) => match rows_has_text(written, eff): List(RowDiagnostic) {
      true => more
      false => Cons(
        rows_error(
          Text::concat_all(
            Cons(
              rows_quoted(name),
              Cons(
                " may perform ",
                Cons(
                  eff,
                  Cons(
                    " but its row is {",
                    Cons(rows_show(rowset_list(rowset_of(written))), Cons("}", Nil))
                  )
                )
              )
            )
          ),
          f
        ),
        more
      )
    }
  }
}

// The errors of one function's inferred row, in the row's order.
pub fn rows_fn_errors(inferred: List(Text), name: Text, f: SurfaceFn): List(RowDiagnostic) {
  match inferred: List(RowDiagnostic) {
    Nil => Nil
    Cons(eff, rest) => match rows_has_prefix(eff, "?"): List(RowDiagnostic) {
      true => Cons(
        rows_error(
          Text::concat_all(
            Cons(
              "cannot follow the effects of ",
              Cons(rows_after_first(eff), Cons(" in ", Cons(rows_quoted(name), Nil)))
            )
          ),
          f
        ),
        rows_fn_errors(rest, name, f)
      )
      false => rows_unwritten(name, f, eff, rows_fn_errors(rest, name, f))
    }
  }
}

pub fn rows_errors_of(env: RowEnv, name: Text, inferred: RowSet): List(RowDiagnostic) {
  match rows_env_fn(env, name): List(RowDiagnostic) {
    Some(f) => rows_fn_errors(rowset_list(inferred), name, f)
    None => Nil
  }
}

pub(open) inductive RowChecked: Type {
  Mk(functions: List(RowFn), errors: List(RowDiagnostic), s: RowState): RowChecked
}

pub fn rows_check_fns(
  names: List(RowNamed),
  k: Nat,
  env: RowEnv,
  s: RowState,
  functions: List(RowFn),
  errors: List(RowDiagnostic)
): RowChecked {
  match names: RowChecked {
    Nil => RowChecked::Mk(List::reverse(functions), errors, s)
    Cons(n, rest) => {
      let r := rows_inferred_row(k, env, s, n.name)
      rows_check_fns(
        rest,
        k,
        env,
        r.s,
        Cons(RowFn::Mk(n.name, r.row), functions),
        List::append(errors, rows_errors_of(env, n.name, r.row))
      )
    }
  }
}

// An extern is the host's: it names no effects of its own.
pub fn rows_extern_errors(fns: List(SurfaceFn)): List(RowDiagnostic) {
  match fns: List(RowDiagnostic) {
    Nil => Nil
    Cons(f, rest) => match f.effects: List(RowDiagnostic) {
      Some(effects) => match effects: List(RowDiagnostic) {
        Nil => rows_extern_errors(rest)
        Cons(e, es) => Cons(
          rows_error("an extern cannot perform effects; wrap it in a tauto function", f),
          rows_extern_errors(rest)
        )
      }
      None => rows_extern_errors(rest)
    }
  }
}

pub fn rows_top_effects(effects: List(Text), t: SurfaceTerm): List(RowDiagnostic) {
  match effects: List(RowDiagnostic) {
    Nil => Nil
    Cons(eff, rest) => match eff == "Div" || eff == "show" || eff == "spawn": List(RowDiagnostic) {
      // `Div` is allowed at the top level, and the host answers `show` and `spawn`.
      true => rows_top_effects(rest, t)
      false => match rows_has_prefix(eff, "?"): List(RowDiagnostic) {
        true => Cons(
          RowDiagnostic::Mk(
            Text::concat("cannot follow the effects of ", rows_after_first(eff)),
            t.start,
            t.end
          ),
          rows_top_effects(rest, t)
        )
        false => Cons(
          RowDiagnostic::Mk(
            Text::concat_all(Cons("unhandled effect ", Cons(eff, Cons(" at the top level", Nil)))),
            t.start,
            t.end
          ),
          rows_top_effects(rest, t)
        )
      }
    }
  }
}

pub(open) inductive RowTop: Type {
  Mk(errors: List(RowDiagnostic), s: RowState): RowTop
}

pub fn rows_top_prepend(errors: List(RowDiagnostic), r: RowTop): RowTop {
  RowTop::Mk(List::append(errors, r.errors), r.s)
}

pub fn rows_top_errors(stmts: List(SurfaceStmt), k: Nat, env: RowEnv, s: RowState): RowTop {
  match stmts: RowTop {
    Nil => RowTop::Mk(Nil, s)
    Cons(st, rest) => match st: RowTop {
      StLet(name, ty, value, borrow, bm) => {
        let r := rows_term_row(k, env, s, value, Nil)
        rows_top_prepend(
          rows_top_effects(rowset_list(r.row), value),
          rows_top_errors(rest, k, env, r.s)
        )
      }
      StVar(name, ty, value, vb) => {
        let r := rows_term_row(k, env, s, value, Nil)
        rows_top_prepend(
          rows_top_effects(rowset_list(r.row), value),
          rows_top_errors(rest, k, env, r.s)
        )
      }
      StExpr(e) => {
        let r := rows_term_row(k, env, s, e, Nil)
        rows_top_prepend(
          rows_top_effects(rowset_list(r.row), e),
          rows_top_errors(rest, k, env, r.s)
        )
      }
      StExtern(l, fs, a, b) => rows_top_prepend(
        rows_extern_errors(fs),
        rows_top_errors(rest, k, env, s)
      )
      _ => rows_top_errors(rest, k, env, s)
    }
  }
}

// Budget inputs: the absolute end position plus one for each function and each
// top-level value expression. rows_steps scales their sum, plus one, by sixteen.
pub fn rows_fns_extent(fns: List(Pair(Text, SurfaceFn))): Nat {
  match fns: Nat {
    Nil => 0
    Cons(e, rest) => e.snd.end + 1 + rows_fns_extent(rest)
  }
}

pub fn rows_stmt_extent(st: SurfaceStmt): Nat {
  match st: Nat {
    StLet(name, ty, value, borrow, bm) => value.end + 1
    StVar(name, ty, value, vb) => value.end + 1
    StExpr(e) => e.end + 1
    _ => 0
  }
}

pub fn rows_stmts_extent(stmts: List(SurfaceStmt)): Nat {
  match stmts: Nat {
    Nil => 0
    Cons(st, rest) => rows_stmt_extent(st) + rows_stmts_extent(rest)
  }
}

pub fn rows_steps(env: RowEnv, program: List(SurfaceStmt)): Nat {
  16 * (rows_fns_extent(Ordmap::entries(env.fns)) + rows_stmts_extent(program) + 1)
}

pub fn rows_report_of(env: RowEnv, checked: RowChecked, tops: RowTop): RowReport {
  RowReport::Mk(
    checked.functions,
    List::append(tops.s.found, List::append(checked.errors, tops.errors)),
    tops.s.calls,
    env.quants
  )
}

pub fn rows_check_in(env: RowEnv, program: List(SurfaceStmt), checked: RowChecked): RowReport {
  rows_report_of(env, checked, rows_top_errors(program, rows_steps(env, program), env, checked.s))
}

pub fn rows_check_env(env: RowEnv, program: List(SurfaceStmt)): RowReport {
  rows_check_in(
    env,
    program,
    rows_check_fns(
      rows_sort_names(rowset_list(RowSet::Mk(rows_program_names(program, Ordmap::empty()))), env, Nil),
      rows_steps(env, program),
      env,
      rows_empty_state(),
      Nil,
      Nil
    )
  )
}

// The report on the program, with the prelude's declarations before its own.
pub fn rows_check(prelude: List(SurfaceStmt), program: List(SurfaceStmt)): RowReport {
  rows_check_env(
    rows_env_of(
      program,
      rows_env_of(
        prelude,
        RowEnv::Mk(Ordmap::empty(), rows_initial_quants(), rows_user_externs(program, Ordmap::empty()))
      )
    ),
    program
  )
}

pub fn rows_dump_row(r: RowSet): Text {
  Text::concat_all(Cons("{", Cons(rows_show(rowset_list(r)), Cons("}", Nil))))
}

pub fn rows_dump_functions(fns: List(RowFn)): List(Text) {
  match fns: List(Text) {
    Nil => Nil
    Cons(f, rest) => Cons(
      Text::concat_all(
        Cons(
          "function ",
          Cons(f.name, Cons(" ", Cons(rows_dump_row(f.row), Cons(text_newline(), Nil))))
        )
      ),
      rows_dump_functions(rest)
    )
  }
}

pub fn rows_dump_errors(errors: List(RowDiagnostic)): List(Text) {
  match errors: List(Text) {
    Nil => Nil
    Cons(e, rest) => Cons(
      Text::concat_all(
        Cons(
          "error ",
          Cons(
            Text::of_nat(e.start),
            Cons(
              " ",
              Cons(Text::of_nat(e.end), Cons(" ", Cons(e.message, Cons(text_newline(), Nil))))
            )
          )
        )
      ),
      rows_dump_errors(rest)
    )
  }
}

pub fn rows_dump_calls(calls: List(Pair(RowSpan, RowSet))): List(Text) {
  match calls: List(Text) {
    Nil => Nil
    Cons(c, rest) => Cons(
      Text::concat_all(
        Cons(
          "call ",
          Cons(
            Text::of_nat(c.fst.start),
            Cons(
              " ",
              Cons(
                Text::of_nat(c.fst.end),
                Cons(" ", Cons(rows_dump_row(c.snd), Cons(text_newline(), Nil)))
              )
            )
          )
        )
      ),
      rows_dump_calls(rest)
    )
  }
}

pub fn rows_dump_quants(quants: List(Pair(Text, Quant))): List(Text) {
  match quants: List(Text) {
    Nil => Nil
    Cons(q, rest) => Cons(
      Text::concat_all(
        Cons("quant ", Cons(q.fst, Cons(" ", Cons(quant_name(q.snd), Cons(text_newline(), Nil)))))
      ),
      rows_dump_quants(rest)
    )
  }
}

pub fn rows_dump(report: RowReport): Text {
  Text::concat_all(
    List::append(
      rows_dump_functions(report.functions),
      List::append(
        rows_dump_errors(report.errors),
        List::append(
          rows_dump_calls(Ordmap::entries(report.calls)),
          rows_dump_quants(Ordmap::entries(report.quants))
        )
      )
    )
  )
}
