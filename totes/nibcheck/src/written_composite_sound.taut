// Mapping the result of a state computation does not alter its diagnostics.
pub fn written_map<A: Type, B: Type>(f: (A) -> B, m: Mut1(A, Checker)): Mut1(B, Checker) {
  frame_bind(A, B, (value: A, state: Checker) => mut1(f(value), state), m)
}
pub theorem written_map_value<A: Type, B: Type>(
  f: (A) -> B,
  m: Mut1(A, Checker)
): ck_val(written_map(f, m)) = f(ck_val(m)) {
  match m: ck_val(written_map(f, m)) = f(ck_val(m)) { mut1(value, state) => Refl }
}
pub theorem written_map_clean<A: Type, B: Type>(
  f: (A) -> B,
  m: Mut1(A, Checker),
  clean: DiagnosticClean(ck_st(written_map(f, m)))
): DiagnosticClean(ck_st(m)) {
  match m: DiagnosticClean(ck_st(m)) { mut1(value, state) => clean }
}

pub theorem written_union_sound(
  parts: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  under_borrow: Bool,
  ih: ∀ clean: DiagnosticClean(
    ck_st(ck_written_each(parts, c, generics))
  ). WrittenTerms(
    ck_datas_of(c),
    generics,
    frame_constructor_position(c),
    parts,
    ck_val(ck_written_each(parts, c, generics))
  ),
  clean: DiagnosticClean(ck_st(frame_written_union(parts, c, generics)))
): WrittenKind(
  ck_datas_of(c),
  generics,
  frame_constructor_position(c),
  under_borrow,
  SkUnion(parts),
  ck_val(frame_written_union(parts, c, generics))
) {
  Eq::subst(
    (t: Ty) => WrittenKind(
      ck_datas_of(c),
      generics,
      frame_constructor_position(c),
      under_borrow,
      SkUnion(parts),
      t
    ),
    Eq::sym(written_map_value(ty_union, ck_written_each(parts, c, generics))),
    WrittenKindUnion(
      parts,
      ck_val(ck_written_each(parts, c, generics)),
      ih(written_map_clean(ty_union, ck_written_each(parts, c, generics), clean))
    )
  )
}

