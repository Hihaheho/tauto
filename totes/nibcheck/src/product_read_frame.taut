import "checker_frame.taut"

// Telling a product's members apart (`ck_product_apart`, `types_infer.taut`)
// keeps the declarations and the substitution. The finishing pass runs it
// again, so this lives below the frames that need more.

pub theorem read_return<A: Type>(c: Checker, v: A): CkReadFrame(c, mut1(v, c)) { Refl }

pub theorem read_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  h: CkReadFrame(c, m)
): CkReadFrame(c, ck_rewrap1(m)) {
  Eq::subst((z: Mut1(A, Checker)) => CkReadFrame(c, z), Eq::sym(ck_rewrap1_id(m)), h)
}

pub theorem read_record(
  c: Checker,
  ms: List(Ty),
  span: TySpan
): CkReadFrame(c, ck_record_product_check(c, ms, span)) { Refl }

pub fn po_step(c: Checker, ms: List(Ty), span: TySpan, o: Option(Ty)): Mut1(Unit, Checker) {
  match o: Mut1(Unit, Checker) {
    Some(m) => ck_rewrap1(
      ck_error(
        c,
        cat3(
          "a product's member ",
          ty_show(ck_shown(c, m)),
          " has a type parameter or an unknown type: it may be equal to another member"
        ),
        span
      )
    )
    None => mut1(Star, c)
  }
}

pub theorem ck_product_open_unf(
  c: Checker,
  ms: List(Ty),
  span: TySpan
): Eq(
  Mut1(Unit, Checker),
  ck_product_open(c, ms, span),
  po_step(c, ms, span, ck_first_open(c, ms))
) { Refl }

pub fn pk_step(c: Checker, ms: List(Ty), span: TySpan, o: Option(Ty)): Mut1(Unit, Checker) {
  match o: Mut1(Unit, Checker) {
    Some(a) => ck_rewrap1(
      ck_error(
        c,
        cat2(ty_show(ck_shown(c, a)), " is twice in a product; tell them apart with tags"),
        span
      )
    )
    None => ck_rewrap1(ck_product_open(c, ms, span))
  }
}

pub theorem ck_product_known_unf(
  c: Checker,
  ms: List(Ty),
  span: TySpan
): Eq(
  Mut1(Unit, Checker),
  ck_product_known(c, ms, span),
  pk_step(c, ms, span, ty_first_twice(ms, Nil))
) { Refl }

pub fn pa_wait(c: Checker, members: List(Ty), span: TySpan, wait: Bool): Mut1(Unit, Checker) {
  match wait: Mut1(Unit, Checker) {
    true => ck_rewrap1(
      ck_record_product_check(c, ty_resolve_list_in(c.steps, c.subst, members), span)
    )
    false => ck_rewrap1(ck_product_known(c, ty_resolve_list_in(c.steps, c.subst, members), span))
  }
}

pub fn pa_step(
  c: Checker,
  members: List(Ty),
  span: TySpan,
  at_end: Bool,
  two: Bool
): Mut1(Unit, Checker) {
  match two: Mut1(Unit, Checker) {
    true => pa_wait(
      c,
      members,
      span,
      bool_not(at_end) && ck_any_vars(c, ty_resolve_list_in(c.steps, c.subst, members))
    )
    false => mut1(Star, c)
  }
}

pub theorem ck_product_apart_unf(
  c: Checker,
  members: List(Ty),
  span: TySpan,
  at_end: Bool
): Eq(
  Mut1(Unit, Checker),
  ck_product_apart(c, members, span, at_end),
  pa_step(c, members, span, at_end, ty_two_or_more(members))
) { Refl }

pub theorem po_step_step_read(
  c: Checker,
  ms: List(Ty),
  span: TySpan,
  o: Option(Ty)
): CkReadFrame(c, po_step(c, ms, span, o)) {
  match o: CkReadFrame(c, po_step(c, ms, span, o)) {
    Some(m) => read_rewrap(
      c,
      ck_error(
        c,
        cat3(
          "a product's member ",
          ty_show(ck_shown(c, m)),
          " has a type parameter or an unknown type: it may be equal to another member"
        ),
        span
      ),
      ck_error_frame(
        c,
        cat3(
          "a product's member ",
          ty_show(ck_shown(c, m)),
          " has a type parameter or an unknown type: it may be equal to another member"
        ),
        span
      )
    )
    None => read_return(c, Star)
  }
}

pub theorem pk_step_step_read(
  c: Checker,
  ms: List(Ty),
  span: TySpan,
  o: Option(Ty)
): CkReadFrame(c, pk_step(c, ms, span, o)) {
  match o: CkReadFrame(c, pk_step(c, ms, span, o)) {
    Some(a) => read_rewrap(
      c,
      ck_error(
        c,
        cat2(ty_show(ck_shown(c, a)), " is twice in a product; tell them apart with tags"),
        span
      ),
      ck_error_frame(
        c,
        cat2(ty_show(ck_shown(c, a)), " is twice in a product; tell them apart with tags"),
        span
      )
    )
    None => read_rewrap(
      c,
      ck_product_open(c, ms, span),
      Eq::subst(
        (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
        Eq::sym(ck_product_open_unf(c, ms, span)),
        po_step_step_read(c, ms, span, ck_first_open(c, ms))
      )
    )
  }
}

pub theorem ck_product_known_step_read(
  c: Checker,
  ms: List(Ty),
  span: TySpan
): CkReadFrame(c, ck_product_known(c, ms, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
    Eq::sym(ck_product_known_unf(c, ms, span)),
    pk_step_step_read(c, ms, span, ty_first_twice(ms, Nil))
  )
}

pub theorem pa_wait_step_read(
  c: Checker,
  members: List(Ty),
  span: TySpan,
  wait: Bool
): CkReadFrame(c, pa_wait(c, members, span, wait)) {
  match wait: CkReadFrame(c, pa_wait(c, members, span, wait)) {
    true => read_rewrap(
      c,
      ck_record_product_check(c, ty_resolve_list_in(c.steps, c.subst, members), span),
      read_record(c, ty_resolve_list_in(c.steps, c.subst, members), span)
    )
    false => read_rewrap(
      c,
      ck_product_known(c, ty_resolve_list_in(c.steps, c.subst, members), span),
      ck_product_known_step_read(c, ty_resolve_list_in(c.steps, c.subst, members), span)
    )
  }
}

pub theorem pa_step_step_read(
  c: Checker,
  members: List(Ty),
  span: TySpan,
  at_end: Bool,
  two: Bool
): CkReadFrame(c, pa_step(c, members, span, at_end, two)) {
  match two: CkReadFrame(c, pa_step(c, members, span, at_end, two)) {
    true => pa_wait_step_read(
      c,
      members,
      span,
      bool_not(at_end) && ck_any_vars(c, ty_resolve_list_in(c.steps, c.subst, members))
    )
    false => read_return(c, Star)
  }
}

pub theorem ck_product_apart_step_read(
  c: Checker,
  members: List(Ty),
  span: TySpan,
  at_end: Bool
): CkReadFrame(c, ck_product_apart(c, members, span, at_end)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
    Eq::sym(ck_product_apart_unf(c, members, span, at_end)),
    pa_step_step_read(c, members, span, at_end, ty_two_or_more(members))
  )
}

// The steps also keep what the finishing pass reads after them.
pub fn product_keep_view(
  c: Checker
): Pair(
  List(TyLiteral),
  Pair(Ordmap(Text, Scheme), Pair(List(TyBound), Pair(List(TyPending), List(TyCtorBound))))
) {
  Pair {
    fst: c.literals,
    snd: Pair {
      fst: c.fns,
      snd: Pair { fst: c.bounds, snd: Pair { fst: c.pending, snd: c.ctor_bounds } }
    }
  }
}

pub def ProductKeep<A: Type>(
  c: Checker,
  m: Mut1(A, Checker)
): Prop := Eq(
  Pair(
    List(TyLiteral),
    Pair(Ordmap(Text, Scheme), Pair(List(TyBound), Pair(List(TyPending), List(TyCtorBound))))
  ),
  product_keep_view(ck_st(m)),
  product_keep_view(c)
)

pub theorem keep_return<A: Type>(c: Checker, v: A): ProductKeep(c, mut1(v, c)) { Refl }

pub theorem keep_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  h: ProductKeep(c, m)
): ProductKeep(c, ck_rewrap1(m)) {
  Eq::subst((z: Mut1(A, Checker)) => ProductKeep(c, z), Eq::sym(ck_rewrap1_id(m)), h)
}

pub theorem keep_bind<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  hm: ProductKeep(c, m),
  hk: ∀ v: A. ∀ next: Checker. ProductKeep(next, k(v, next))
): ProductKeep(c, frame_bind(k, m)) {
  match m: ProductKeep(c, frame_bind(k, m)) {
    mut1(v, next) => Eq::trans(hk(v, next), hm)
  }
}

pub theorem keep_error(
  c: Checker,
  message: Text,
  span: TySpan
): ProductKeep(c, ck_error(c, message, span)) { Refl }

pub theorem keep_record(
  c: Checker,
  ms: List(Ty),
  span: TySpan
): ProductKeep(c, ck_record_product_check(c, ms, span)) { Refl }

pub theorem po_step_step_keep(
  c: Checker,
  ms: List(Ty),
  span: TySpan,
  o: Option(Ty)
): ProductKeep(c, po_step(c, ms, span, o)) {
  match o: ProductKeep(c, po_step(c, ms, span, o)) {
    Some(m) => keep_rewrap(
      c,
      ck_error(
        c,
        cat3(
          "a product's member ",
          ty_show(ck_shown(c, m)),
          " has a type parameter or an unknown type: it may be equal to another member"
        ),
        span
      ),
      keep_error(
        c,
        cat3(
          "a product's member ",
          ty_show(ck_shown(c, m)),
          " has a type parameter or an unknown type: it may be equal to another member"
        ),
        span
      )
    )
    None => keep_return(c, Star)
  }
}

pub theorem pk_step_step_keep(
  c: Checker,
  ms: List(Ty),
  span: TySpan,
  o: Option(Ty)
): ProductKeep(c, pk_step(c, ms, span, o)) {
  match o: ProductKeep(c, pk_step(c, ms, span, o)) {
    Some(a) => keep_rewrap(
      c,
      ck_error(
        c,
        cat2(ty_show(ck_shown(c, a)), " is twice in a product; tell them apart with tags"),
        span
      ),
      keep_error(
        c,
        cat2(ty_show(ck_shown(c, a)), " is twice in a product; tell them apart with tags"),
        span
      )
    )
    None => keep_rewrap(
      c,
      ck_product_open(c, ms, span),
      Eq::subst(
        (z: Mut1(Unit, Checker)) => ProductKeep(c, z),
        Eq::sym(ck_product_open_unf(c, ms, span)),
        po_step_step_keep(c, ms, span, ck_first_open(c, ms))
      )
    )
  }
}

pub theorem ck_product_known_step_keep(
  c: Checker,
  ms: List(Ty),
  span: TySpan
): ProductKeep(c, ck_product_known(c, ms, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => ProductKeep(c, z),
    Eq::sym(ck_product_known_unf(c, ms, span)),
    pk_step_step_keep(c, ms, span, ty_first_twice(ms, Nil))
  )
}

pub theorem pa_wait_step_keep(
  c: Checker,
  members: List(Ty),
  span: TySpan,
  wait: Bool
): ProductKeep(c, pa_wait(c, members, span, wait)) {
  match wait: ProductKeep(c, pa_wait(c, members, span, wait)) {
    true => keep_rewrap(
      c,
      ck_record_product_check(c, ty_resolve_list_in(c.steps, c.subst, members), span),
      keep_record(c, ty_resolve_list_in(c.steps, c.subst, members), span)
    )
    false => keep_rewrap(
      c,
      ck_product_known(c, ty_resolve_list_in(c.steps, c.subst, members), span),
      ck_product_known_step_keep(c, ty_resolve_list_in(c.steps, c.subst, members), span)
    )
  }
}

pub theorem pa_step_step_keep(
  c: Checker,
  members: List(Ty),
  span: TySpan,
  at_end: Bool,
  two: Bool
): ProductKeep(c, pa_step(c, members, span, at_end, two)) {
  match two: ProductKeep(c, pa_step(c, members, span, at_end, two)) {
    true => pa_wait_step_keep(
      c,
      members,
      span,
      bool_not(at_end) && ck_any_vars(c, ty_resolve_list_in(c.steps, c.subst, members))
    )
    false => keep_return(c, Star)
  }
}

pub theorem ck_product_apart_step_keep(
  c: Checker,
  members: List(Ty),
  span: TySpan,
  at_end: Bool
): ProductKeep(c, ck_product_apart(c, members, span, at_end)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => ProductKeep(c, z),
    Eq::sym(ck_product_apart_unf(c, members, span, at_end)),
    pa_step_step_keep(c, members, span, at_end, ty_two_or_more(members))
  )
}

pub fn keep_literals(
  v: Pair(
    List(TyLiteral),
    Pair(Ordmap(Text, Scheme), Pair(List(TyBound), Pair(List(TyPending), List(TyCtorBound))))
  )
): List(TyLiteral) { v.fst }

pub fn keep_stable(
  v: Pair(
    List(TyLiteral),
    Pair(Ordmap(Text, Scheme), Pair(List(TyBound), Pair(List(TyPending), List(TyCtorBound))))
  )
): Pair(List(TyLiteral), Ordmap(Text, Scheme)) { Pair { fst: v.fst, snd: v.snd.fst } }

pub fn keep_obligations(
  v: Pair(
    List(TyLiteral),
    Pair(Ordmap(Text, Scheme), Pair(List(TyBound), Pair(List(TyPending), List(TyCtorBound))))
  )
): Pair(List(TyBound), Pair(List(TyPending), List(TyCtorBound))) { v.snd.snd }

pub fn keep_requirements(
  v: Pair(
    List(TyLiteral),
    Pair(Ordmap(Text, Scheme), Pair(List(TyBound), Pair(List(TyPending), List(TyCtorBound))))
  )
): Pair(List(TyBound), List(TyCtorBound)) { Pair { fst: v.snd.snd.fst, snd: v.snd.snd.snd.snd } }
