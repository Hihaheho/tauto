import "allocation_bind.taut"
import "allocation_advance.taut"
import "allocation_resolution.taut"
import "allocation_state.taut"
import "checker.taut"
import "checker_frame.taut"
import "datas.taut"
import "fits_allocation_sound.taut"
import "fits_sound.taut"
import "ty.taut"
import "type_allocation.taut"
import "types_match.taut"
import "unify_allocation_sound.taut"
import "unify_sound.taut"
import "widen_frame.taut"

pub theorem widen_alloc_store(
  c: Checker,
  rv: Nat,
  value: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  rv_bound: TypeAllocated(ck_next_of(c), TyVar(rv)),
  value_bound: TypeAllocated(ck_next_of(c), value),
  occurs: Bool
): AllocationAdvance(c, widen_store(c, rv, value, occurs)) {
  match occurs: AllocationAdvance(c, widen_store(c, rv, value, occurs)) {
    false => allocation_advance_return(c, Star, state)
    true => allocation_advance_rewrap(
      c,
      ck_set_subst(c, rv, value),
      allocation_advance_set(c, rv, value, ordered, state, rv_bound, value_bound)
    )
  }
}
pub theorem widen_alloc_store_true(
  c: Checker,
  rv: Nat,
  value: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  rv_bound: TypeAllocated(ck_next_of(c), TyVar(rv)),
  value_bound: TypeAllocated(ck_next_of(c), value)
): AllocationAdvance(c, widen_store_true(c, rv, value)) {
  allocation_advance_bind(
    Unit,
    Bool,
    c,
    (ignored: Unit, next: Checker) => mut1(true, next),
    widen_store(c, rv, value, not(ck_occurs(c, rv, value))),
    widen_alloc_store(
      c,
      rv,
      value,
      ordered,
      state,
      rv_bound,
      value_bound,
      not(ck_occurs(c, rv, value))
    ),
    And::left(widen_store_frame(c, rv, value, not(ck_occurs(c, rv, value)), ordered)),
    ignored => next => advanced => current_state => order => allocation_advance_return(
      next,
      true,
      current_state
    )
  )
}
pub theorem widen_alloc_attempt(
  c: Checker,
  rv: Nat,
  wide: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  rv_bound: TypeAllocated(ck_next_of(c), TyVar(rv)),
  wide_bound: TypeAllocated(ck_next_of(c), wide),
  success: Bool
): AllocationAdvance(c, widen_attempt(c, rv, wide, success)) {
  match success: AllocationAdvance(c, widen_attempt(c, rv, wide, success)) {
    false => allocation_advance_return(c, false, state)
    true => widen_alloc_store_true(
      c,
      rv,
      ck_resolve(c, wide),
      ordered,
      state,
      rv_bound,
      ck_resolve_allocated(c, wide, And::right(state), wide_bound)
    )
  }
}
pub theorem widen_alloc_fn_allowed(
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  rv: Nat,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  pa_bound: TypeListAllocated(ck_next_of(c), pa),
  ra_bound: TypeAllocated(ck_next_of(c), ra),
  pb_bound: TypeListAllocated(ck_next_of(c), pb),
  rb_bound: TypeAllocated(ck_next_of(c), rb),
  rv_bound: TypeAllocated(ck_next_of(c), TyVar(rv)),
  allowed: Bool
): AllocationAdvance(c, widen_fn_allowed(c, pa, ra, ka, pb, rb, kb, rv, allowed)) {
  match allowed: AllocationAdvance(c, widen_fn_allowed(c, pa, ra, ka, pb, rb, kb, rv, allowed)) {
    false => allocation_advance_return(c, false, state)
    true => allocation_advance_bind(
      Bool,
      Bool,
      c,
      (success: Bool, next: Checker) => widen_attempt(
        next,
        rv,
        TyFn(pb, rb, kind_join(ka, kb)),
        success
      ),
      ck_attempt_unify(c, TyFn(pa, ra, kind_join(ka, kb)), TyFn(pb, rb, kind_join(ka, kb))),
      allocation_advance_fixed(
        c,
        ck_attempt_unify(c, TyFn(pa, ra, kind_join(ka, kb)), TyFn(pb, rb, kind_join(ka, kb))),
        ck_attempt_unify_allocation(
          c,
          TyFn(pa, ra, kind_join(ka, kb)),
          TyFn(pb, rb, kind_join(ka, kb)),
          ordered,
          state,
          AndIntro(pa_bound, ra_bound),
          AndIntro(pb_bound, rb_bound)
        )
      ),
      And::left(
        ck_attempt_unify_run_frame(
          c,
          TyFn(pa, ra, kind_join(ka, kb)),
          TyFn(pb, rb, kind_join(ka, kb)),
          ordered
        )
      ),
      success => next => advanced => current_state => order => widen_alloc_attempt(
        next,
        rv,
        TyFn(pb, rb, kind_join(ka, kb)),
        order,
        current_state,
        type_allocated_weaken(TyVar(rv), ck_next_of(c), ck_next_of(next), advanced, rv_bound),
        AndIntro(
          type_list_allocated_weaken(pb, ck_next_of(c), ck_next_of(next), advanced, pb_bound),
          type_allocated_weaken(rb, ck_next_of(c), ck_next_of(next), advanced, rb_bound)
        ),
        success
      )
    )
  }
}
pub theorem widen_alloc_fn_current(
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  rv: Nat,
  current: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  pa_bound: TypeListAllocated(ck_next_of(c), pa),
  ra_bound: TypeAllocated(ck_next_of(c), ra),
  rv_bound: TypeAllocated(ck_next_of(c), TyVar(rv)),
  current_bound: TypeAllocated(ck_next_of(c), current)
): AllocationAdvance(c, widen_fn_current(c, pa, ra, ka, rv, current)) {
  match current: AllocationAdvance(c, widen_fn_current(c, pa, ra, ka, rv, current)) {
    TyInt(width) => allocation_advance_return(c, false, state)
    TyBool => allocation_advance_return(c, false, state)
    TyText => allocation_advance_return(c, false, state)
    TyUnit => allocation_advance_return(c, false, state)
    TyNever => allocation_advance_return(c, false, state)
    TyDecimal => allocation_advance_return(c, false, state)
    TyFloat => allocation_advance_return(c, false, state)
    TyParam(name, kind) => allocation_advance_return(c, false, state)
    TyVar(index) => allocation_advance_return(c, false, state)
    TyFn(params, result, kind) => widen_alloc_fn_allowed(
      c,
      pa,
      ra,
      ka,
      params,
      result,
      kind,
      rv,
      ordered,
      state,
      pa_bound,
      ra_bound,
      And::left(current_bound),
      And::right(current_bound),
      rv_bound,
      Bool::and(Nat::eq(list_len(pa), list_len(params)), not(kind_eq(ka, kind)))
    )
    TyUnion(members) => allocation_advance_return(c, false, state)
    TyProduct(members) => allocation_advance_return(c, false, state)
    TyNamed(name, params) => allocation_advance_return(c, false, state)
    TyTagged(tags, inner) => allocation_advance_return(c, false, state)
    TyInfo(inner) => allocation_advance_return(c, false, state)
    TyBorrow(inner, mutable) => allocation_advance_return(c, false, state)
    TyPoly(gs, inner) => allocation_advance_return(c, false, state)
    TyApp(head, arg) => allocation_advance_return(c, false, state)
  }
}
pub theorem widen_alloc_fn_arm(
  c: Checker,
  current: Ty,
  rv: Nat,
  arm: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  current_bound: TypeAllocated(ck_next_of(c), current),
  rv_bound: TypeAllocated(ck_next_of(c), TyVar(rv)),
  arm_bound: TypeAllocated(ck_next_of(c), arm)
): AllocationAdvance(c, widen_fn_arm(c, current, rv, arm)) {
  match arm: AllocationAdvance(c, widen_fn_arm(c, current, rv, arm)) {
    TyInt(width) => allocation_advance_return(c, false, state)
    TyBool => allocation_advance_return(c, false, state)
    TyText => allocation_advance_return(c, false, state)
    TyUnit => allocation_advance_return(c, false, state)
    TyNever => allocation_advance_return(c, false, state)
    TyDecimal => allocation_advance_return(c, false, state)
    TyFloat => allocation_advance_return(c, false, state)
    TyParam(name, kind) => allocation_advance_return(c, false, state)
    TyVar(index) => allocation_advance_return(c, false, state)
    TyFn(params, result, kind) => widen_alloc_fn_current(
      c,
      params,
      result,
      kind,
      rv,
      current,
      ordered,
      state,
      And::left(arm_bound),
      And::right(arm_bound),
      rv_bound,
      current_bound
    )
    TyUnion(members) => allocation_advance_return(c, false, state)
    TyProduct(members) => allocation_advance_return(c, false, state)
    TyNamed(name, params) => allocation_advance_return(c, false, state)
    TyTagged(tags, inner) => allocation_advance_return(c, false, state)
    TyInfo(inner) => allocation_advance_return(c, false, state)
    TyBorrow(inner, mutable) => allocation_advance_return(c, false, state)
    TyPoly(gs, inner) => allocation_advance_return(c, false, state)
    TyApp(head, arg) => allocation_advance_return(c, false, state)
  }
}
pub theorem ck_widen_fn_allocation(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  a_bound: TypeAllocated(ck_next_of(c), a),
  current_bound: TypeAllocated(ck_next_of(c), current),
  rv_bound: TypeAllocated(ck_next_of(c), TyVar(rv))
): AllocationAdvance(c, ck_widen_fn(c, a, current, rv)) {
  Eq::subst(
    (result: Mut1(Bool, Checker)) => AllocationAdvance(c, result),
    Eq::sym(widen_fn_unf(c, a, current, rv)),
    widen_alloc_fn_arm(
      c,
      current,
      rv,
      ck_resolve(c, a),
      ordered,
      state,
      current_bound,
      rv_bound,
      ck_resolve_allocated(c, a, And::right(state), a_bound)
    )
  )
}
pub theorem widen_alloc_fits_if(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  a_bound: TypeAllocated(ck_next_of(c), a),
  b_bound: TypeAllocated(ck_next_of(c), b),
  allowed: Bool
): AllocationAdvance(c, widen_fits_if(c, a, b, allowed)) {
  match allowed: AllocationAdvance(c, widen_fits_if(c, a, b, allowed)) {
    false => allocation_advance_return(c, false, state)
    true => allocation_advance_rewrap(
      c,
      ck_attempt_fits(c, a, b),
      ck_attempt_fits_allocation(c, a, b, ordered, state, a_bound, b_bound)
    )
  }
}
