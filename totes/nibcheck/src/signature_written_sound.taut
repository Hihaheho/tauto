import "../../surface/src/surface.taut"

pub fn signature_fresh_index(c: Checker): Nat { c.next }
pub theorem ck_sig_written_sound(
  p: Option(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  clean: DiagnosticClean(ck_st(ck_sig_written(c, p, generics)))
): SignatureType(
  ck_datas_of(c),
  generics,
  frame_constructor_position(c),
  frame_under_borrow(c),
  p,
  ck_val(ck_sig_written(c, p, generics))
) {
  ⊢ SignatureType(
    ck_datas_of(c),
    generics,
    frame_constructor_position(c),
    frame_under_borrow(c),
    p,
    ck_val(ck_sig_written(c, p, generics))
  ) from match p {
    None => SignatureTypeInferred(signature_fresh_index(c))
    Some(source) => Eq::subst(
      (m: Mut1(Ty, Checker)) => SignatureType(
        ck_datas_of(c),
        generics,
        frame_constructor_position(c),
        frame_under_borrow(c),
        Some(source),
        ck_val(m)
      ),
      Eq::sym(ck_rewrap1_id(ck_written(c, source, generics))),
      SignatureTypeWritten(
        source,
        ck_val(ck_written(c, source, generics)),
        ck_written_sound(
          c,
          source,
          generics,
          Eq::subst(
            (m: Mut1(Ty, Checker)) => DiagnosticClean(ck_st(m)),
            ck_rewrap1_id(ck_written(c, source, generics)),
            clean
          )
        )
      )
    )
  }
}

pub theorem signature_existing_borrow(
  t: Ty,
  requested: Bool,
  borrowed: ty_is_borrow(t) = true
): SignatureBorrow(Some(requested), t, t) {
  ⊢ SignatureBorrow(Some(requested), t, t) from match t {
    TyInt(width) => False::elim(false_ne_true(borrowed))
    TyBool => False::elim(false_ne_true(borrowed))
    TyText => False::elim(false_ne_true(borrowed))
    TyUnit => False::elim(false_ne_true(borrowed))
    TyNever => False::elim(false_ne_true(borrowed))
    TyDecimal => False::elim(false_ne_true(borrowed))
    TyFloat => False::elim(false_ne_true(borrowed))
    TyFn(params, result, kind) => False::elim(false_ne_true(borrowed))
    TyUnion(members) => False::elim(false_ne_true(borrowed))
    TyProduct(members) => False::elim(false_ne_true(borrowed))
    TyTagged(tags, inner) => False::elim(false_ne_true(borrowed))
    TyNamed(name, args) => False::elim(false_ne_true(borrowed))
    TyParam(name, kind) => False::elim(false_ne_true(borrowed))
    TyInfo(inner) => False::elim(false_ne_true(borrowed))
    TyBorrow(inner, mutable) => SignatureBorrowExisting(requested, inner, mutable)
    TyVar(index) => False::elim(false_ne_true(borrowed))
    TyPoly(gs, inner) => False::elim(false_ne_true(borrowed))
    TyApp(head, arg) => False::elim(false_ne_true(borrowed))
  }
}
pub theorem signature_wrap_if_sound(
  c: Checker,
  t: Ty,
  requested: Bool,
  borrowed: Bool,
  equal: ty_is_borrow(t) = borrowed
): SignatureBorrow(Some(requested), t, ck_val(signature_wrap_if(c, t, requested, borrowed))) {
  ⊢ SignatureBorrow(
    Some(requested),
    t,
    ck_val(signature_wrap_if(c, t, requested, borrowed))
  ) from match borrowed {
    true => signature_existing_borrow(t, requested, equal)
    false => SignatureBorrowWrap(requested, t, equal)
  }
}
pub theorem signature_wrap_sound(
  borrow: Option(Bool),
  c: Checker,
  t: Ty
): SignatureBorrow(borrow, t, ck_val(signature_wrap(c, t, borrow))) {
  ⊢ SignatureBorrow(borrow, t, ck_val(signature_wrap(c, t, borrow))) from match borrow {
    None => SignatureBorrowNone(t)
    Some(requested) => signature_wrap_if_sound(c, t, requested, ty_is_borrow(t), Refl)
  }
}
pub theorem ck_sig_written_reset(
  p: Option(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty)
): CkWrittenReset(c, ck_sig_written(c, p, generics)) {
  ⊢ CkWrittenReset(c, ck_sig_written(c, p, generics)) from match p {
    None => Refl
    Some(source) => Eq::subst(
      (m: Mut1(Ty, Checker)) => CkWrittenReset(c, m),
      Eq::sym(ck_rewrap1_id(ck_written(c, source, generics))),
      ck_written_reset(c, source, generics)
    )
  }
}

pub fn signature_parameter_after(borrow: Option(Bool), m: Mut1(Ty, Checker)): Mut1(Ty, Checker) {
  frame_bind(Ty, Ty, (inner: Ty, next: Checker) => signature_wrap(next, inner, borrow), m)
}
pub theorem signature_parameter_after_sound(
  env: Datas,
  generics: Ordmap(Text, Ty),
  partial: Bool,
  source: Option(SurfaceTerm),
  borrow: Option(Bool),
  m: Mut1(Ty, Checker),
  meaning: ∀ accepted: DiagnosticClean(
    ck_st(m)
  ). SignatureType(env, generics, partial, signature_borrow_mode(borrow), source, ck_val(m)),
  clean: DiagnosticClean(ck_st(signature_parameter_after(borrow, m)))
): SignatureParameter(
  env,
  generics,
  partial,
  source,
  borrow,
  ck_val(signature_parameter_after(borrow, m))
) {
  ⊢ SignatureParameter(
    env,
    generics,
    partial,
    source,
    borrow,
    ck_val(signature_parameter_after(borrow, m))
  ) from match m {
    mut1(inner, next) => SignatureParameter::Mk(
      inner,
      ck_val(signature_wrap(next, inner, borrow)),
      meaning(signature_wrap_frame_errors(next, inner, borrow, clean)),
      signature_wrap_sound(borrow, next, inner)
    )
  }
}
pub theorem ck_sig_param_sound(
  c: Checker,
  source: Option(SurfaceTerm),
  borrow: Option(Bool),
  generics: Ordmap(Text, Ty),
  clean: DiagnosticClean(ck_st(ck_sig_param(c, source, borrow, generics)))
): SignatureParameter(
  ck_datas_of(c),
  generics,
  frame_constructor_position(c),
  source,
  borrow,
  ck_val(ck_sig_param(c, source, borrow, generics))
) {
  Eq::subst(
    (m: Mut1(Ty, Checker)) => SignatureParameter(
      ck_datas_of(c),
      generics,
      frame_constructor_position(c),
      source,
      borrow,
      ck_val(m)
    ),
    Eq::sym(signature_param_unf(c, source, borrow, generics)),
    signature_parameter_after_sound(
      ck_datas_of(c),
      generics,
      frame_constructor_position(c),
      source,
      borrow,
      ck_sig_written(frame_set_under_borrow(c, signature_some_borrow(borrow)), source, generics),
      accepted => ck_sig_written_sound(
        source,
        frame_set_under_borrow(c, signature_some_borrow(borrow)),
        generics,
        accepted
      ),
      Eq::subst(
        (m: Mut1(Ty, Checker)) => DiagnosticClean(ck_st(m)),
        signature_param_unf(c, source, borrow, generics),
        clean
      )
    )
  )
}
pub theorem signature_wrap_if_context(
  c: Checker,
  t: Ty,
  mutable: Bool,
  borrowed: Bool
): written_context(ck_st(signature_wrap_if(c, t, mutable, borrowed))) = written_context(c) {
  ⊢ written_context(
    ck_st(signature_wrap_if(c, t, mutable, borrowed))
  ) = written_context(c) from match borrowed {
    true => Refl
    false => Refl
  }
}
pub theorem signature_wrap_context(
  borrow: Option(Bool),
  c: Checker,
  t: Ty
): written_context(ck_st(signature_wrap(c, t, borrow))) = written_context(c) {
  ⊢ written_context(ck_st(signature_wrap(c, t, borrow))) = written_context(c) from match borrow {
    None => Refl
    Some(mutable) => signature_wrap_if_context(c, t, mutable, ty_is_borrow(t))
  }
}
pub theorem signature_parameter_after_reset(
  c: Checker,
  borrow: Option(Bool),
  m: Mut1(Ty, Checker),
  reset: CkWrittenReset(c, m)
): CkWrittenReset(c, signature_parameter_after(borrow, m)) {
  ⊢ CkWrittenReset(c, signature_parameter_after(borrow, m)) from match m {
    mut1(inner, next) => Eq::trans(signature_wrap_context(borrow, next, inner), reset)
  }
}
pub theorem ck_sig_param_reset(
  c: Checker,
  source: Option(SurfaceTerm),
  borrow: Option(Bool),
  generics: Ordmap(Text, Ty)
): CkWrittenReset(c, ck_sig_param(c, source, borrow, generics)) {
  Eq::subst(
    (m: Mut1(Ty, Checker)) => CkWrittenReset(c, m),
    Eq::sym(signature_param_unf(c, source, borrow, generics)),
    signature_parameter_after_reset(
      c,
      borrow,
      ck_sig_written(frame_set_under_borrow(c, signature_some_borrow(borrow)), source, generics),
      ck_sig_written_reset(
        source,
        frame_set_under_borrow(c, signature_some_borrow(borrow)),
        generics
      )
    )
  )
}
