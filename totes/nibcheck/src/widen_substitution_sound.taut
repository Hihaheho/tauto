import "substitution_except.taut"
import std::Map
import "checker.taut"
import "datas.taut"
import "rules_ty.taut"
import "ty.taut"
import "types_match.taut"
import "unify_sound.taut"
import "widen_frame.taut"

pub theorem widen_store_frame_except(
  c: Checker,
  rv: Nat,
  value: Ty,
  occurs: Bool,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_store(c, rv, value, occurs)) {
  match occurs: ExceptRunFrame(rv, c, widen_store(c, rv, value, occurs)) {
    false => except_frame_return(rv, c, Star, ordered)
    true => except_frame_rewrap(
      rv,
      c,
      ck_set_subst(c, rv, value),
      ck_set_subst_except_frame(c, rv, value, ordered)
    )
  }
}

pub theorem widen_store_true_frame_except(
  c: Checker,
  rv: Nat,
  value: Ty,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_store_true(c, rv, value)) {
  except_frame_bind(
    Unit,
    Bool,
    rv,
    c,
    (ignored: Unit, c1: Checker) => mut1(true, c1),
    widen_store(c, rv, value, not(ck_occurs(c, rv, value))),
    widen_store_frame_except(c, rv, value, not(ck_occurs(c, rv, value)), ordered),
    ignored => c1 => o_c1 => except_frame_return(rv, c1, true, o_c1)
  )
}

pub theorem widen_attempt_frame_except(
  c: Checker,
  rv: Nat,
  wide: Ty,
  success: Bool,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_attempt(c, rv, wide, success)) {
  match success: ExceptRunFrame(rv, c, widen_attempt(c, rv, wide, success)) {
    true => widen_store_true_frame_except(c, rv, ck_resolve(c, wide), ordered)
    false => except_frame_return(rv, c, false, ordered)
  }
}

pub theorem widen_fn_allowed_frame_except(
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  rv: Nat,
  allowed: Bool,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_fn_allowed(c, pa, ra, ka, pb, rb, kb, rv, allowed)) {
  match allowed: ExceptRunFrame(rv, c, widen_fn_allowed(c, pa, ra, ka, pb, rb, kb, rv, allowed)) {
    true => except_frame_bind(
      Bool,
      Bool,
      rv,
      c,
      (success: Bool, c1: Checker) => widen_attempt(c1, rv, TyFn(pb, rb, kind_join(ka, kb)), success),
      ck_attempt_unify(c, TyFn(pa, ra, kind_join(ka, kb)), TyFn(pb, rb, kind_join(ka, kb))),
      ck_attempt_unify_except_frame(
        rv,
        c,
        TyFn(pa, ra, kind_join(ka, kb)),
        TyFn(pb, rb, kind_join(ka, kb)),
        ordered
      ),
      success => c1 => o_c1 => widen_attempt_frame_except(
        c1,
        rv,
        TyFn(pb, rb, kind_join(ka, kb)),
        success,
        o_c1
      )
    )
    false => except_frame_return(rv, c, false, ordered)
  }
}

pub theorem widen_fn_current_frame_except(
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  rv: Nat,
  current: Ty,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_fn_current(c, pa, ra, ka, rv, current)) {
  match current: ExceptRunFrame(rv, c, widen_fn_current(c, pa, ra, ka, rv, current)) {
    TyInt(w) => except_frame_return(rv, c, false, ordered)
    TyBool => except_frame_return(rv, c, false, ordered)
    TyText => except_frame_return(rv, c, false, ordered)
    TyUnit => except_frame_return(rv, c, false, ordered)
    TyNever => except_frame_return(rv, c, false, ordered)
    TyDecimal => except_frame_return(rv, c, false, ordered)
    TyFloat => except_frame_return(rv, c, false, ordered)
    TyFn(pb, rb, kb) => widen_fn_allowed_frame_except(
      c,
      pa,
      ra,
      ka,
      pb,
      rb,
      kb,
      rv,
      Bool::and(Nat::eq(list_len(pa), list_len(pb)), not(kind_eq(ka, kb))),
      ordered
    )
    TyUnion(members) => except_frame_return(rv, c, false, ordered)
    TyProduct(members) => except_frame_return(rv, c, false, ordered)
    TyTagged(tags, inner) => except_frame_return(rv, c, false, ordered)
    TyNamed(name, args) => except_frame_return(rv, c, false, ordered)
    TyParam(name, bound) => except_frame_return(rv, c, false, ordered)
    TyInfo(inner) => except_frame_return(rv, c, false, ordered)
    TyBorrow(inner, mutable) => except_frame_return(rv, c, false, ordered)
    TyVar(v) => except_frame_return(rv, c, false, ordered)
    TyPoly(generics, inner) => except_frame_return(rv, c, false, ordered)
    TyApp(head, arg) => except_frame_return(rv, c, false, ordered)
  }
}

pub theorem widen_fn_arm_frame_except(
  c: Checker,
  current: Ty,
  rv: Nat,
  arm: Ty,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_fn_arm(c, current, rv, arm)) {
  match arm: ExceptRunFrame(rv, c, widen_fn_arm(c, current, rv, arm)) {
    TyInt(w) => except_frame_return(rv, c, false, ordered)
    TyBool => except_frame_return(rv, c, false, ordered)
    TyText => except_frame_return(rv, c, false, ordered)
    TyUnit => except_frame_return(rv, c, false, ordered)
    TyNever => except_frame_return(rv, c, false, ordered)
    TyDecimal => except_frame_return(rv, c, false, ordered)
    TyFloat => except_frame_return(rv, c, false, ordered)
    TyFn(pa, ra, ka) => widen_fn_current_frame_except(c, pa, ra, ka, rv, current, ordered)
    TyUnion(members) => except_frame_return(rv, c, false, ordered)
    TyProduct(members) => except_frame_return(rv, c, false, ordered)
    TyTagged(tags, inner) => except_frame_return(rv, c, false, ordered)
    TyNamed(name, args) => except_frame_return(rv, c, false, ordered)
    TyParam(name, bound) => except_frame_return(rv, c, false, ordered)
    TyInfo(inner) => except_frame_return(rv, c, false, ordered)
    TyBorrow(inner, mutable) => except_frame_return(rv, c, false, ordered)
    TyVar(v) => except_frame_return(rv, c, false, ordered)
    TyPoly(generics, inner) => except_frame_return(rv, c, false, ordered)
    TyApp(head, arg) => except_frame_return(rv, c, false, ordered)
  }
}

pub theorem ck_widen_fn_run_frame_except(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, ck_widen_fn(c, a, current, rv)) {
  Eq::subst(
    (z: Mut1(Bool, Checker)) => ExceptRunFrame(rv, c, z),
    Eq::sym(widen_fn_unf(c, a, current, rv)),
    widen_fn_arm_frame_except(c, current, rv, ck_resolve(c, a), ordered)
  )
}

pub theorem widen_fits_if_frame_except(
  rv: Nat,
  c: Checker,
  a: Ty,
  b: Ty,
  allowed: Bool,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_fits_if(c, a, b, allowed)) {
  match allowed: ExceptRunFrame(rv, c, widen_fits_if(c, a, b, allowed)) {
    true => except_frame_rewrap(
      rv,
      c,
      ck_attempt_fits(c, a, b),
      ck_attempt_fits_except_frame(rv, c, a, b, ordered)
    )
    false => except_frame_return(rv, c, false, ordered)
  }
}

pub theorem widen_borrow_current_frame_except(
  c: Checker,
  a: Ty,
  rv: Nat,
  current: Ty,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_borrow_current(c, a, rv, current)) {
  match current: ExceptRunFrame(rv, c, widen_borrow_current(c, a, rv, current)) {
    TyInt(w) => except_frame_return(rv, c, false, ordered)
    TyBool => except_frame_return(rv, c, false, ordered)
    TyText => except_frame_return(rv, c, false, ordered)
    TyUnit => except_frame_return(rv, c, false, ordered)
    TyNever => except_frame_return(rv, c, false, ordered)
    TyDecimal => except_frame_return(rv, c, false, ordered)
    TyFloat => except_frame_return(rv, c, false, ordered)
    TyFn(params, result, kind) => except_frame_return(rv, c, false, ordered)
    TyUnion(members) => except_frame_return(rv, c, false, ordered)
    TyProduct(members) => except_frame_return(rv, c, false, ordered)
    TyTagged(tags, inner) => except_frame_return(rv, c, false, ordered)
    TyNamed(name, args) => except_frame_return(rv, c, false, ordered)
    TyParam(name, bound) => except_frame_return(rv, c, false, ordered)
    TyInfo(inner) => except_frame_return(rv, c, false, ordered)
    TyBorrow(x, m) => except_frame_bind(
      Bool,
      Bool,
      rv,
      c,
      (success: Bool, c1: Checker) => widen_attempt(c1, rv, x, success),
      widen_fits_if(
        c,
        a,
        x,
        Bool::and(not(ty_is_borrow(ck_resolve(c, a))), kind_dup(ck_kind(c, x)))
      ),
      widen_fits_if_frame_except(
        rv,
        c,
        a,
        x,
        Bool::and(not(ty_is_borrow(ck_resolve(c, a))), kind_dup(ck_kind(c, x))),
        ordered
      ),
      success => c1 => o_c1 => widen_attempt_frame_except(c1, rv, x, success, o_c1)
    )
    TyVar(v) => except_frame_return(rv, c, false, ordered)
    TyPoly(generics, inner) => except_frame_return(rv, c, false, ordered)
    TyApp(head, arg) => except_frame_return(rv, c, false, ordered)
  }
}

pub theorem ck_widen_borrowed_current_run_frame_except(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, ck_widen_borrowed_current(c, a, current, rv)) {
  Eq::subst(
    (z: Mut1(Bool, Checker)) => ExceptRunFrame(rv, c, z),
    Eq::sym(widen_borrow_current_unf(c, a, current, rv)),
    widen_borrow_current_frame_except(c, a, rv, current, ordered)
  )
}

pub theorem widen_borrow_arm_frame_except(
  rv: Nat,
  c: Checker,
  current: Ty,
  arm: Ty,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_borrow_arm(c, current, arm)) {
  match arm: ExceptRunFrame(rv, c, widen_borrow_arm(c, current, arm)) {
    TyInt(w) => except_frame_return(rv, c, false, ordered)
    TyBool => except_frame_return(rv, c, false, ordered)
    TyText => except_frame_return(rv, c, false, ordered)
    TyUnit => except_frame_return(rv, c, false, ordered)
    TyNever => except_frame_return(rv, c, false, ordered)
    TyDecimal => except_frame_return(rv, c, false, ordered)
    TyFloat => except_frame_return(rv, c, false, ordered)
    TyFn(params, result, kind) => except_frame_return(rv, c, false, ordered)
    TyUnion(members) => except_frame_return(rv, c, false, ordered)
    TyProduct(members) => except_frame_return(rv, c, false, ordered)
    TyTagged(tags, inner) => except_frame_return(rv, c, false, ordered)
    TyNamed(name, args) => except_frame_return(rv, c, false, ordered)
    TyParam(name, bound) => except_frame_return(rv, c, false, ordered)
    TyInfo(inner) => except_frame_return(rv, c, false, ordered)
    TyBorrow(x, m) => widen_fits_if_frame_except(
      rv,
      c,
      x,
      current,
      Bool::and(not(ty_is_borrow(current)), kind_dup(ck_kind(c, x))),
      ordered
    )
    TyVar(v) => except_frame_return(rv, c, false, ordered)
    TyPoly(generics, inner) => except_frame_return(rv, c, false, ordered)
    TyApp(head, arg) => except_frame_return(rv, c, false, ordered)
  }
}

pub theorem ck_widen_borrowed_arm_run_frame_except(
  rv: Nat,
  c: Checker,
  a: Ty,
  current: Ty,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, ck_widen_borrowed_arm(c, a, current)) {
  Eq::subst(
    (z: Mut1(Bool, Checker)) => ExceptRunFrame(rv, c, z),
    Eq::sym(widen_borrow_arm_unf(c, a, current)),
    widen_borrow_arm_frame_except(rv, c, current, ck_resolve(c, a), ordered)
  )
}

pub theorem widen_final_fits_frame_except(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_final_fits(c, a, current, rv, failed)) {
  match failed: ExceptRunFrame(rv, c, widen_final_fits(c, a, current, rv, failed)) {
    true => except_frame_rewrap(
      rv,
      c,
      ck_set_subst(c, rv, ty_union(Cons(current, Cons(ck_resolve(c, a), Nil)))),
      ck_set_subst_except_frame(
        c,
        rv,
        ty_union(Cons(current, Cons(ck_resolve(c, a), Nil))),
        ordered
      )
    )
    false => except_frame_return(rv, c, Star, ordered)
  }
}

pub theorem widen_after_arm_frame_except(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_after_arm(c, a, current, rv, failed)) {
  match failed: ExceptRunFrame(rv, c, widen_after_arm(c, a, current, rv, failed)) {
    true => except_frame_bind(
      Bool,
      Unit,
      rv,
      c,
      (success: Bool, c1: Checker) => widen_final_fits(c1, a, current, rv, not(success)),
      ck_attempt_fits(c, a, current),
      ck_attempt_fits_except_frame(rv, c, a, current, ordered),
      success => c1 => o_c1 => widen_final_fits_frame_except(
        c1,
        a,
        current,
        rv,
        not(success),
        o_c1
      )
    )
    false => except_frame_return(rv, c, Star, ordered)
  }
}

pub theorem widen_after_current_frame_except(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_after_current(c, a, current, rv, failed)) {
  match failed: ExceptRunFrame(rv, c, widen_after_current(c, a, current, rv, failed)) {
    true => except_frame_bind(
      Bool,
      Unit,
      rv,
      c,
      (success: Bool, c1: Checker) => widen_after_arm(c1, a, current, rv, not(success)),
      ck_widen_borrowed_arm(c, a, current),
      ck_widen_borrowed_arm_run_frame_except(rv, c, a, current, ordered),
      success => c1 => o_c1 => widen_after_arm_frame_except(
        c1,
        a,
        current,
        rv,
        not(success),
        o_c1
      )
    )
    false => except_frame_return(rv, c, Star, ordered)
  }
}

pub theorem widen_after_fn_frame_except(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_after_fn(c, a, current, rv, failed)) {
  match failed: ExceptRunFrame(rv, c, widen_after_fn(c, a, current, rv, failed)) {
    true => except_frame_bind(
      Bool,
      Unit,
      rv,
      c,
      (success: Bool, c1: Checker) => widen_after_current(c1, a, current, rv, not(success)),
      ck_widen_borrowed_current(c, a, current, rv),
      ck_widen_borrowed_current_run_frame_except(c, a, current, rv, ordered),
      success => c1 => o_c1 => widen_after_current_frame_except(
        c1,
        a,
        current,
        rv,
        not(success),
        o_c1
      )
    )
    false => except_frame_return(rv, c, Star, ordered)
  }
}

pub theorem widen_handle_frame_except(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, widen_handle(c, a, current, rv)) {
  except_frame_bind(
    Bool,
    Unit,
    rv,
    c,
    (success: Bool, c1: Checker) => widen_after_fn(c1, a, current, rv, not(success)),
    ck_widen_fn(c, a, current, rv),
    ck_widen_fn_run_frame_except(c, a, current, rv, ordered),
    success => c1 => o_c1 => widen_after_fn_frame_except(c1, a, current, rv, not(success), o_c1)
  )
}

pub theorem ck_handle_widen_run_frame_except(
  c: Checker,
  a: Ty,
  result: Ty,
  rv: Nat,
  ordered: CkOrdered(c)
): ExceptRunFrame(rv, c, ck_handle_widen(c, a, result, rv)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => ExceptRunFrame(rv, c, z),
    Eq::sym(widen_handle_unf(c, a, result, rv)),
    widen_handle_frame_except(c, a, ck_resolve(c, result), rv, ordered)
  )
}

// Widening preserves all bindings established before its private result existed.
pub theorem ck_handle_widen_snapshot(
  snapshot: Ordmap(Nat, Ty),
  c: Checker,
  a: Ty,
  result: Ty,
  rv: Nat,
  ordered: CkOrdered(c),
  absent: Ordmap::get(snapshot, rv, Ordmap::compare_nat) = None,
  prior: SubstExt(snapshot, ck_subst_of(c))
): SubstExt(snapshot, ck_subst_of(ck_st(ck_handle_widen(c, a, result, rv)))) {
  subst_except_snapshot(
    rv,
    snapshot,
    ck_subst_of(c),
    ck_subst_of(ck_st(ck_handle_widen(c, a, result, rv))),
    absent,
    prior,
    And::left(And::right(ck_handle_widen_run_frame_except(c, a, result, rv, ordered)))
  )
}
