import "registration_body_sound.taut"
import "program_data_header_sound.taut"
import "program_data_context_sound.taut"
import "program_data_error_sound.taut"
import "../../surface/src/surface.taut"

pub fn body_program_after(rest: List(SurfaceStmt), m: Mut1(Unit, Checker)): Mut1(Unit, Checker) {
  frame_bind(
    Unit,
    Unit,
    (ignored: Unit, next: Checker) => ck_rewrap1(ck_program_data(rest, next)),
    m
  )
}
pub theorem body_after_prefix(
  rest: List(SurfaceStmt),
  source: SurfaceData,
  m: Mut1(Unit, Checker),
  ordered: CkDatasOrdered(ck_st(m)),
  present: DataBodyRegistered(ck_datas_of(ck_st(m)), source),
  no_name: NoDeclarationName(registration_name(source), rest)
): DataBodyRegistered(ck_datas_of(ck_st(body_program_after(rest, m))), source) {
  match m: DataBodyRegistered(ck_datas_of(ck_st(body_program_after(rest, m))), source) {
    mut1(ignored, next) => body_registered_lookup(
      present,
      ck_datas_of(ck_st(ck_rewrap1(ck_program_data(rest, next)))),
      body_lookup_metadata(
        summary_decls(ck_datas_of(ck_st(ck_rewrap1(ck_program_data(rest, next))))),
        summary_decls(ck_datas_of(next)),
        registration_name(source),
        And::right(
          registration_rewrap_protected(
            registration_name(source),
            data_metadata_lookup(summary_decls(ck_datas_of(next)), registration_name(source)),
            ck_program_data(rest, next),
            ck_program_data_protected(
              registration_name(source),
              data_metadata_lookup(summary_decls(ck_datas_of(next)), registration_name(source)),
              rest,
              next,
              AndIntro(ordered, Refl),
              no_name
            )
          )
        )
      )
    )
  }
}
pub theorem body_prefix_clean(
  rest: List(SurfaceStmt),
  m: Mut1(Unit, Checker),
  clean: DiagnosticClean(ck_st(body_program_after(rest, m)))
): DiagnosticClean(ck_st(m)) {
  written_bind_input_clean(
    Unit,
    Unit,
    m,
    (ignored: Unit, next: Checker) => ck_rewrap1(ck_program_data(rest, next)),
    ignored => next => error_frame_rewrap(
      next,
      ck_program_data(rest, next),
      ck_program_data_errors(rest, next)
    ),
    clean
  )
}
pub theorem body_struct(
  c: Checker,
  source: SurfaceData,
  ordered: CkDatasOrdered(c),
  ordinary: frame_under_borrow(c) = false,
  position: frame_constructor_position(c) = false,
  clean: DiagnosticClean(ck_st(ck_program_data_one(c, StStruct(source))))
): DataBodyRegistered(ck_datas_of(ck_st(ck_program_data_one(c, StStruct(source)))), source) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => DataBodyRegistered(ck_datas_of(ck_st(m)), source),
    Eq::sym(
      Eq::trans(
        registration_program_StStruct_unf(source, c),
        ck_rewrap1_id(ck_declare_data(c, source, true, false))
      )
    ),
    ck_declare_data_body(
      c,
      source,
      true,
      false,
      ordered,
      ordinary,
      position,
      Eq::subst(
        (m: Mut1(Unit, Checker)) => DiagnosticClean(ck_st(m)),
        Eq::trans(
          registration_program_StStruct_unf(source, c),
          ck_rewrap1_id(ck_declare_data(c, source, true, false))
        ),
        clean
      )
    )
  )
}
pub theorem body_enum(
  c: Checker,
  source: SurfaceData,
  ordered: CkDatasOrdered(c),
  ordinary: frame_under_borrow(c) = false,
  position: frame_constructor_position(c) = false,
  clean: DiagnosticClean(ck_st(ck_program_data_one(c, StEnum(source))))
): DataBodyRegistered(ck_datas_of(ck_st(ck_program_data_one(c, StEnum(source)))), source) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => DataBodyRegistered(ck_datas_of(ck_st(m)), source),
    Eq::sym(
      Eq::trans(
        registration_program_StEnum_unf(source, c),
        ck_rewrap1_id(ck_declare_data(c, source, false, false))
      )
    ),
    ck_declare_data_body(
      c,
      source,
      false,
      false,
      ordered,
      ordinary,
      position,
      Eq::subst(
        (m: Mut1(Unit, Checker)) => DiagnosticClean(ck_st(m)),
        Eq::trans(
          registration_program_StEnum_unf(source, c),
          ck_rewrap1_id(ck_declare_data(c, source, false, false))
        ),
        clean
      )
    )
  )
}
pub def RegisterBodies(
  rest: List(SurfaceStmt)
): Prop := ∀ next: Checker. ∀ source: SurfaceData. ∀ ordered: CkDatasOrdered(
  next
). ∀ ordinary: frame_under_borrow(next) = false. ∀ position: frame_constructor_position(next) = false. ∀ declared: DeclaresData(
  rest,
  source
). ∀ fresh: UniqueDataNames(
  types_data_decls(rest)
). ∀ clean: DiagnosticClean(
  ck_st(ck_program_data(rest, next))
). DataBodyRegistered(ck_datas_of(ck_st(ck_program_data(rest, next))), source)
pub theorem body_tail_after(
  rest: List(SurfaceStmt),
  c: Checker,
  source: SurfaceData,
  m: Mut1(Unit, Checker),
  ordered: CkDatasOrdered(ck_st(m)),
  context: written_context(ck_st(m)) = written_context(c),
  ordinary: frame_under_borrow(c) = false,
  position: frame_constructor_position(c) = false,
  declared: DeclaresData(rest, source),
  fresh: UniqueDataNames(types_data_decls(rest)),
  ih: RegisterBodies(rest),
  clean: DiagnosticClean(ck_st(body_program_after(rest, m)))
): DataBodyRegistered(ck_datas_of(ck_st(body_program_after(rest, m))), source) {
  match m: DataBodyRegistered(ck_datas_of(ck_st(body_program_after(rest, m))), source) {
    mut1(ignored, next) => Eq::subst(
      (result: Mut1(Unit, Checker)) => DataBodyRegistered(ck_datas_of(ck_st(result)), source),
      Eq::sym(ck_rewrap1_id(ck_program_data(rest, next))),
      ih(
        next,
        source,
        ordered,
        Eq::trans(Eq::congr(written_context_borrow, context), ordinary),
        Eq::trans(Eq::congr(written_context_position, context), position),
        declared,
        fresh,
        recheck_clean_unwrap(ck_program_data(rest, next), clean)
      )
    )
  }
}
pub theorem body_program_cons(
  stmt: SurfaceStmt,
  rest: List(SurfaceStmt),
  c: Checker,
  source: SurfaceData,
  ordered: CkDatasOrdered(c),
  ordinary: frame_under_borrow(c) = false,
  position: frame_constructor_position(c) = false,
  declared: DeclaresData(Cons(stmt, rest), source),
  fresh: UniqueDataNames(types_data_decls(Cons(stmt, rest))),
  ih: RegisterBodies(rest),
  clean: DiagnosticClean(ck_st(body_program_after(rest, ck_program_data_one(c, stmt))))
): DataBodyRegistered(
  ck_datas_of(ck_st(body_program_after(rest, ck_program_data_one(c, stmt)))),
  source
) {
  match declared: DataBodyRegistered(
    ck_datas_of(ck_st(body_program_after(rest, ck_program_data_one(c, stmt)))),
    source
  ) {
    DeclaresDataStruct(decl, tail) => body_after_prefix(
      tail,
      decl,
      ck_program_data_one(c, StStruct(decl)),
      ck_program_data_one_ordered(c, StStruct(decl), ordered),
      body_struct(
        c,
        decl,
        ordered,
        ordinary,
        position,
        body_prefix_clean(tail, ck_program_data_one(c, StStruct(decl)), clean)
      ),
      fresh_program_excludes(
        tail,
        Cons(registration_name(decl), Nil),
        fresh_data_tail(decl, types_data_decls(tail), Nil, fresh),
        registration_name(decl),
        MemHere(Nil)
      )
    )
    DeclaresDataEnum(decl, tail) => body_after_prefix(
      tail,
      decl,
      ck_program_data_one(c, StEnum(decl)),
      ck_program_data_one_ordered(c, StEnum(decl), ordered),
      body_enum(
        c,
        decl,
        ordered,
        ordinary,
        position,
        body_prefix_clean(tail, ck_program_data_one(c, StEnum(decl)), clean)
      ),
      fresh_program_excludes(
        tail,
        Cons(registration_name(decl), Nil),
        fresh_data_tail(decl, types_data_decls(tail), Nil, fresh),
        registration_name(decl),
        MemHere(Nil)
      )
    )
    DeclaresDataLater(head, tail, decl, member) => body_tail_after(
      tail,
      c,
      decl,
      ck_program_data_one(c, head),
      ck_program_data_one_ordered(c, head, ordered),
      ck_program_data_one_context(c, head, ordinary),
      ordinary,
      position,
      member,
      fresh_data_append_tail(types_stmt_data(head), types_data_decls(tail), Nil, fresh),
      ih,
      clean
    )
  }
}
pub theorem ck_program_data_bodies(
  stmts: List(SurfaceStmt),
  c: Checker,
  source: SurfaceData,
  ordered: CkDatasOrdered(c),
  ordinary: frame_under_borrow(c) = false,
  position: frame_constructor_position(c) = false,
  declared: DeclaresData(stmts, source),
  fresh: UniqueDataNames(types_data_decls(stmts)),
  clean: DiagnosticClean(ck_st(ck_program_data(stmts, c)))
): DataBodyRegistered(ck_datas_of(ck_st(ck_program_data(stmts, c))), source) {
  match stmts: DataBodyRegistered(ck_datas_of(ck_st(ck_program_data(stmts, c))), source) {
    Nil => match declared: DataBodyRegistered(
      ck_datas_of(ck_st(ck_program_data(Nil, c))),
      source
    ) {
    }
    Cons(stmt, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => DataBodyRegistered(ck_datas_of(ck_st(m)), source),
      Eq::sym(registration_program_unf(stmt, rest, c)),
      body_program_cons(
        stmt,
        rest,
        c,
        source,
        ordered,
        ordinary,
        position,
        declared,
        fresh,
        next => decl => ord => ordinary_next => next_position => member => unique => inner_clean => ck_program_data_bodies(
          rest,
          next,
          decl,
          ord,
          ordinary_next,
          next_position,
          member,
          unique,
          inner_clean
        ),
        Eq::subst(
          (m: Mut1(Unit, Checker)) => DiagnosticClean(ck_st(m)),
          registration_program_unf(stmt, rest, c),
          clean
        )
      )
    )
  }
}
