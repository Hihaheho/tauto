import "expr_checks_frame.taut"
import std::List
import std::Text
import "checker.taut"
import "checker_frame.taut"
import "datas_frame.taut"
import "ty.taut"
import "types_decl.taut"
import "types_infer.taut"
import "types_match.taut"
import "unify_sound.taut"
import "../../surface/src/surface.taut"

pub fn argument_terms(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  p: Ty,
  more: List(Ty),
  args: List(SurfaceTerm)
): Mut1(Unit, Checker) {
  match args: Mut1(Unit, Checker) {
    Nil => mut1(Star, c)
    Cons(at, atail) => frame_bind(
      Unit,
      Unit,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_expect_args(rest, c1, more, atail)),
      ck_expect(c, a, p, span_of(at), "an argument")
    )
  }
}

pub theorem argument_terms_frame(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  p: Ty,
  more: List(Ty),
  args: List(SurfaceTerm),
  ih: ∀ next: Checker. ∀ ps: List(
    Ty
  ). ∀ args: List(
    SurfaceTerm
  ). ∀ ordered: CkOrdered(next). CkRunFrame(next, ck_expect_args(rest, next, ps, args)),
  ordered: CkOrdered(c)
): CkRunFrame(c, argument_terms(a, rest, c, p, more, args)) {
  match args: CkRunFrame(c, argument_terms(a, rest, c, p, more, args)) {
    Nil => run_frame_return(c, Star, ordered)
    Cons(at, atail) => run_frame_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_expect_args(rest, c1, more, atail)),
      ck_expect(c, a, p, span_of(at), "an argument"),
      ck_expect_run_frame(c, a, p, span_of(at), "an argument", ordered),
      ignored => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_expect_args(rest, c1, more, atail),
        ih(c1, more, atail, o_c1)
      )
    )
  }
}

pub fn argument_params(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  args: List(SurfaceTerm),
  ps: List(Ty)
): Mut1(Unit, Checker) {
  match ps: Mut1(Unit, Checker) {
    Nil => mut1(Star, c)
    Cons(p, more) => argument_terms(a, rest, c, p, more, args)
  }
}

pub theorem argument_params_frame(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  args: List(SurfaceTerm),
  ps: List(Ty),
  ih: ∀ next: Checker. ∀ ps: List(
    Ty
  ). ∀ args: List(
    SurfaceTerm
  ). ∀ ordered: CkOrdered(next). CkRunFrame(next, ck_expect_args(rest, next, ps, args)),
  ordered: CkOrdered(c)
): CkRunFrame(c, argument_params(a, rest, c, args, ps)) {
  match ps: CkRunFrame(c, argument_params(a, rest, c, args, ps)) {
    Nil => run_frame_return(c, Star, ordered)
    Cons(p, more) => argument_terms_frame(a, rest, c, p, more, args, ih, ordered)
  }
}

pub theorem argument_cons_unf(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  ps: List(Ty),
  args: List(SurfaceTerm)
): ck_expect_args(Cons(a, rest), c, ps, args) = argument_params(a, rest, c, args, ps) { Refl }

pub theorem ck_expect_args_run_frame(
  tys: List(Ty),
  c: Checker,
  ps: List(Ty),
  args: List(SurfaceTerm),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_expect_args(tys, c, ps, args)) {
  match tys: CkRunFrame(c, ck_expect_args(tys, c, ps, args)) {
    Nil => run_frame_return(c, Star, ordered)
    Cons(a, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
      Eq::sym(argument_cons_unf(a, rest, c, ps, args)),
      argument_params_frame(
        a,
        rest,
        c,
        args,
        ps,
        next => more => terms => onext => ck_expect_args_run_frame(rest, next, more, terms, onext),
        ordered
      )
    )
  }
}

pub fn argument_lambda_cons(
  p: Text,
  rest: List(Text),
  c: Checker,
  borrows: List(Option(Bool))
): Mut1(List(Ty), Checker) {
  frame_bind(
    Ty,
    List(Ty),
    (t: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tl: List(Ty), c2: Checker) => mut1(Cons(field_under(t, list_head_or_none(borrows)), tl), c2),
      ck_lambda_params(rest, c1, List::tail(borrows))
    ),
    ck_fresh(c)
  )
}

pub theorem argument_lambda_cons_frame(
  p: Text,
  rest: List(Text),
  c: Checker,
  borrows: List(Option(Bool)),
  ih: ∀ next: Checker. CkReadFrame(next, ck_lambda_params(rest, next, List::tail(borrows)))
): CkReadFrame(c, argument_lambda_cons(p, rest, c, borrows)) {
  frame_bind_ok(
    Ty,
    List(Ty),
    c,
    (t: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tl: List(Ty), c2: Checker) => mut1(Cons(field_under(t, list_head_or_none(borrows)), tl), c2),
      ck_lambda_params(rest, c1, List::tail(borrows))
    ),
    ck_fresh(c),
    ck_fresh_frame(c),
    t => c1 => frame_bind_ok(
      List(Ty),
      List(Ty),
      c1,
      (tl: List(Ty), c2: Checker) => mut1(Cons(field_under(t, list_head_or_none(borrows)), tl), c2),
      ck_lambda_params(rest, c1, List::tail(borrows)),
      ih(c1),
      tl => c2 => Refl
    )
  )
}

pub theorem argument_lambda_cons_unf(
  p: Text,
  rest: List(Text),
  c: Checker,
  borrows: List(Option(Bool))
): ck_lambda_params(Cons(p, rest), c, borrows) = argument_lambda_cons(p, rest, c, borrows) { Refl }

pub theorem ck_lambda_params_frame(
  ps: List(Text),
  c: Checker,
  borrows: List(Option(Bool))
): CkReadFrame(c, ck_lambda_params(ps, c, borrows)) {
  match ps: CkReadFrame(c, ck_lambda_params(ps, c, borrows)) {
    Nil => Refl
    Cons(p, rest) => Eq::subst(
      (z: Mut1(List(Ty), Checker)) => CkReadFrame(c, z),
      Eq::sym(argument_lambda_cons_unf(p, rest, c, borrows)),
      argument_lambda_cons_frame(
        p,
        rest,
        c,
        borrows,
        next => ck_lambda_params_frame(rest, next, List::tail(borrows))
      )
    )
  }
}

pub fn argument_hint_cons(p: Ty, rest: List(Ty), c: Checker, hs: List(Ty)): Mut1(Unit, Checker) {
  match hs: Mut1(Unit, Checker) {
    Nil => mut1(Star, c)
    Cons(h, more) => frame_bind(
      Bool,
      Unit,
      (ignored: Bool, c1: Checker) => ck_rewrap1(ck_lambda_hint(rest, c1, more)),
      ck_attempt_unify(c, p, h)
    )
  }
}

pub theorem argument_hint_cons_frame(
  p: Ty,
  rest: List(Ty),
  c: Checker,
  hs: List(Ty),
  ih: ∀ next: Checker. ∀ hs: List(
    Ty
  ). ∀ ordered: CkOrdered(next). CkRunFrame(next, ck_lambda_hint(rest, next, hs)),
  ordered: CkOrdered(c)
): CkRunFrame(c, argument_hint_cons(p, rest, c, hs)) {
  match hs: CkRunFrame(c, argument_hint_cons(p, rest, c, hs)) {
    Nil => run_frame_return(c, Star, ordered)
    Cons(h, more) => run_frame_bind(
      Bool,
      Unit,
      c,
      (ignored: Bool, c1: Checker) => ck_rewrap1(ck_lambda_hint(rest, c1, more)),
      ck_attempt_unify(c, p, h),
      ck_attempt_unify_run_frame(c, p, h, ordered),
      ignored => c1 => o_c1 => run_frame_rewrap(
        c1,
        ck_lambda_hint(rest, c1, more),
        ih(c1, more, o_c1)
      )
    )
  }
}

pub theorem argument_hint_cons_unf(
  p: Ty,
  rest: List(Ty),
  c: Checker,
  hs: List(Ty)
): ck_lambda_hint(Cons(p, rest), c, hs) = argument_hint_cons(p, rest, c, hs) { Refl }

pub theorem ck_lambda_hint_run_frame(
  ps: List(Ty),
  c: Checker,
  hs: List(Ty),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_lambda_hint(ps, c, hs)) {
  match ps: CkRunFrame(c, ck_lambda_hint(ps, c, hs)) {
    Nil => run_frame_return(c, Star, ordered)
    Cons(p, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
      Eq::sym(argument_hint_cons_unf(p, rest, c, hs)),
      argument_hint_cons_frame(
        p,
        rest,
        c,
        hs,
        next => more => onext => ck_lambda_hint_run_frame(rest, next, more, onext),
        ordered
      )
    )
  }
}

pub fn argument_expected(
  c: Checker,
  t: Ty,
  a: SurfaceTerm,
  expected: Option(Ty)
): Mut1(Unit, Checker) {
  match expected: Mut1(Unit, Checker) {
    None => mut1(Star, c)
    Some(p) => ck_rewrap1(ck_expect(c, t, p, span_of(a), "an argument"))
  }
}

pub theorem argument_expected_frame(
  c: Checker,
  t: Ty,
  a: SurfaceTerm,
  expected: Option(Ty),
  ordered: CkOrdered(c)
): CkRunFrame(c, argument_expected(c, t, a, expected)) {
  match expected: CkRunFrame(c, argument_expected(c, t, a, expected)) {
    None => run_frame_return(c, Star, ordered)
    Some(p) => run_frame_rewrap(
      c,
      ck_expect(c, t, p, span_of(a), "an argument"),
      ck_expect_run_frame(c, t, p, span_of(a), "an argument", ordered)
    )
  }
}

pub theorem argument_expected_unf(
  c: Checker,
  t: Ty,
  expected: Option(Ty),
  a: SurfaceTerm
): ck_expect_opt(c, t, expected, a) = argument_expected(c, t, a, expected) { match expected: ck_expect_opt(c, t, expected, a) = argument_expected(c, t, a, expected) { None => Refl
    Some(p) => Refl } }

pub theorem ck_expect_opt_run_frame(
  c: Checker,
  t: Ty,
  expected: Option(Ty),
  a: SurfaceTerm,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_expect_opt(c, t, expected, a)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
    Eq::sym(argument_expected_unf(c, t, expected, a)),
    argument_expected_frame(c, t, a, expected, ordered)
  )
}
pub fn argument_returns(c: Checker): List(Ty) { c.returns }
pub fn argument_exceeded(c: Checker): List(Ty) { c.exceeded }

pub fn argument_return(c: Checker, t: Ty, span: TySpan, returns: List(Ty)): Mut1(Unit, Checker) {
  match returns: Mut1(Unit, Checker) {
    Nil => ck_rewrap1(ck_error(c, "`return` outside a function", span))
    Cons(r, rest) => ck_rewrap1(ck_expect(c, t, r, span, "the returned value"))
  }
}

pub theorem argument_return_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  returns: List(Ty),
  ordered: CkOrdered(c)
): CkRunFrame(c, argument_return(c, t, span, returns)) {
  match returns: CkRunFrame(c, argument_return(c, t, span, returns)) {
    Nil => run_frame_read(
      c,
      ck_rewrap1(ck_error(c, "`return` outside a function", span)),
      frame_rewrap(
        c,
        ck_error(c, "`return` outside a function", span),
        ck_error_frame(c, "`return` outside a function", span)
      ),
      ordered
    )
    Cons(r, rest) => run_frame_rewrap(
      c,
      ck_expect(c, t, r, span, "the returned value"),
      ck_expect_run_frame(c, t, r, span, "the returned value", ordered)
    )
  }
}

pub theorem argument_return_unf(
  c: Checker,
  t: Ty,
  span: TySpan
): ck_return_check(c, t, span) = argument_return(c, t, span, argument_returns(c)) { Refl }

pub theorem ck_return_check_run_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_return_check(c, t, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
    Eq::sym(argument_return_unf(c, t, span)),
    argument_return_frame(c, t, span, argument_returns(c), ordered)
  )
}

pub fn argument_budget_after(c: Checker, t: Ty, span: TySpan, same: Bool): Mut1(Unit, Checker) {
  frame_error_if(c, "budgets answered by one `exceeded` arm give different types", span, not(same))
}

pub theorem argument_budget_after_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, argument_budget_after(c, t, span, same)) {
  run_frame_read(
    c,
    frame_error_if(
      c,
      "budgets answered by one `exceeded` arm give different types",
      span,
      not(same)
    ),
    frame_error_if_ok(
      c,
      "budgets answered by one `exceeded` arm give different types",
      span,
      not(same)
    ),
    ordered
  )
}

pub fn argument_budget(c: Checker, t: Ty, span: TySpan, exceeded: List(Ty)): Mut1(Unit, Checker) {
  match exceeded: Mut1(Unit, Checker) {
    Nil => mut1(Star, c)
    Cons(x, rest) => frame_bind(
      Bool,
      Unit,
      (same: Bool, c1: Checker) => argument_budget_after(c1, t, span, same),
      ck_unify(c, x, t)
    )
  }
}

pub theorem argument_budget_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  exceeded: List(Ty),
  ordered: CkOrdered(c)
): CkRunFrame(c, argument_budget(c, t, span, exceeded)) {
  match exceeded: CkRunFrame(c, argument_budget(c, t, span, exceeded)) {
    Nil => run_frame_return(c, Star, ordered)
    Cons(x, rest) => run_frame_bind(
      Bool,
      Unit,
      c,
      (same: Bool, c1: Checker) => argument_budget_after(c1, t, span, same),
      ck_unify(c, x, t),
      ck_unify_run_frame(c, x, t, ordered),
      same => c1 => o_c1 => argument_budget_after_frame(c1, t, span, same, o_c1)
    )
  }
}

pub theorem argument_budget_unf(
  c: Checker,
  t: Ty,
  span: TySpan
): ck_budget_answer(c, t, span) = argument_budget(c, t, span, argument_exceeded(c)) { Refl }

pub theorem ck_budget_answer_run_frame(
  c: Checker,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_budget_answer(c, t, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
    Eq::sym(argument_budget_unf(c, t, span)),
    argument_budget_frame(c, t, span, argument_exceeded(c), ordered)
  )
}
