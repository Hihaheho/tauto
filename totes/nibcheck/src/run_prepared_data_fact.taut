import "prepare_data_body_sound.taut"
import "run_data_names_sound.taut"
import std::Base
import std::Map
import std::Text
import "checker.taut"
import "datas_frame.taut"
import "diagnostic_report.taut"
import "diagnostic_sound.taut"
import "registration_ordered.taut"
