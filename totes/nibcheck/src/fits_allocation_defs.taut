pub def FitsAllocP(
  fuel: Nat
): Prop := ∀ c: Checker. ∀ pa: List(
  Ty
). ∀ pb: List(
  Ty
). ∀ ordered: CkOrdered(
  c
). ∀ state: CheckerAllocation(
  c
). ∀ pa_bound: TypeListAllocated(
  ck_next_of(c),
  pa
). ∀ pb_bound: TypeListAllocated(
  ck_next_of(c),
  pb
). AllocationAdvance(c, ck_fits_params_in(fuel, c, pa, pb))
pub theorem fits_alloc_ordered_P(
  fuel: Nat,
  c: Checker,
  pa: List(Ty),
  pb: List(Ty),
  ordered: CkOrdered(c)
): CkOrdered(ck_st(ck_fits_params_in(fuel, c, pa, pb))) {
  And::left(
    And::left(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
