  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): CkOrdered(ck_st(ck_attempt_fits_in(fuel, c, a, b))) {
  And::left(And::left(And::left(And::right(fits_all(fuel)))(c, a, b)(ordered)))
}
