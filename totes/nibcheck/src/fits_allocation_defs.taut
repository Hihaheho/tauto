pub def FitsAllocationAt(
  fuel: Nat
): Prop := And(
  FitsAllocU(fuel),
  And(
    FitsAllocA(fuel),
    And(
      FitsAllocPo(fuel),
      And(
        FitsAllocL(fuel),
        And(
          FitsAllocB(fuel),
          And(
            FitsAllocLe(fuel),
            And(
              FitsAllocV(fuel),
              And(
                FitsAllocS(fuel),
                And(
                  FitsAllocI(fuel),
                  And(
                    FitsAllocT(fuel),
                    And(
                      FitsAllocUt(fuel),
                      And(
                        FitsAllocF(fuel),
                        And(FitsAllocE(fuel), And(FitsAllocY(fuel), FitsAllocP(fuel)))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
