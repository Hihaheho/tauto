pub def FitsAllocU(
  fuel: Nat
): Prop := ∀ c: Checker. ∀ a: Ty. ∀ b: Ty. ∀ ordered: CkOrdered(
  c
). ∀ state: CheckerAllocation(
  c
). ∀ a_bound: TypeAllocated(
  ck_next_of(c),
  a
). ∀ b_bound: TypeAllocated(ck_next_of(c), b). AllocationAdvance(c, ck_fits_in(fuel, c, a, b))
pub theorem fits_alloc_ordered_U(
  fuel: Nat,
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): CkOrdered(ck_st(ck_fits_in(fuel, c, a, b))) {
  And::left(And::left(And::left(fits_all(fuel))(c, a, b)(ordered)))
}
