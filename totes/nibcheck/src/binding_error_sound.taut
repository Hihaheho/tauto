import "messages.taut"
import "binding_frame.taut"
import "application_frame.taut"
import "argument_error_sound.taut"
import std::text
import "checker.taut"
import "error_frame.taut"
import "expr_checks_error_sound.taut"
import "ty.taut"
import "types_decl.taut"
import "types_decl_head.taut"
import "types_infer.taut"
import "infer_parts.taut"
import "written_error_sound.taut"
import "../../surface/src/surface.taut"

pub theorem binding_let_mode_frame_errors(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm,
  bm: Bool
): CkErrorFrame(c, binding_let_mode(c, name, resolved, value, bm)) {
  match bm {
    true => error_frame_rewrap(
      c,
      ck_error(
        c,
        let_mut_borrow_binds_return_message(name),
        span_of(value)
      ),
      ck_error_frame_errors(
        c,
        let_mut_borrow_binds_return_message(name),
        span_of(value)
      )
    )
    false => error_frame_rewrap(
      c,
      ck_error(
        c,
        let_borrow_binds_return_message(name),
        span_of(value)
      ),
      ck_error_frame_errors(
        c,
        let_borrow_binds_return_message(name),
        span_of(value)
      )
    )
  }
}

pub theorem binding_let_view_frame_errors(
  c: Checker,
  name: Text,
  bm: Bool,
  resolved: Ty,
  value: SurfaceTerm,
  view: Bool
): CkErrorFrame(c, binding_let_view(c, name, bm, resolved, value, view)) {
  match view {
    true => frame_error_if_ok_errors(
      c,
      let_mut_borrow_binds_return_message(name),
      span_of(value),
      Bool::and(bm, not(ck_has_mut_borrow(c, resolved)))
    )
    false => binding_let_mode_frame_errors(c, name, resolved, value, bm)
  }
}

pub theorem ck_let_borrow_frame_errors(
  c: Checker,
  name: Text,
  view: Bool,
  bm: Bool,
  resolved: Ty,
  value: SurfaceTerm
): CkErrorFrame(c, ck_let_borrow(c, name, view, bm, resolved, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(binding_let_borrow_unf(c, name, view, bm, resolved, value)),
    binding_let_view_frame_errors(c, name, bm, resolved, value, view)
  )
}

pub theorem binding_stored_borrow_frame_errors(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  p: Ty,
  r#borrow: Bool
): CkErrorFrame(c, binding_stored_borrow(c, name, t, resolved, value, p, r#borrow)) {
  match r#borrow {
    true => (clean_errors => clean_errors)
    false => (clean_errors => clean_errors)
  }
}

pub theorem binding_stored_found_frame_errors(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  found: Option(Ty)
): CkErrorFrame(c, binding_stored_found(c, name, t, resolved, value, found)) {
  match found {
    None => (clean_errors => clean_errors)
    Some(p) => binding_stored_borrow_frame_errors(
      c,
      name,
      t,
      resolved,
      value,
      p,
      term_is_borrow(value)
    )
  }
}

pub theorem binding_stored_frame_errors(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  stored: Bool
): CkErrorFrame(c, binding_stored(c, name, t, resolved, value, stored)) {
  match stored {
    true => binding_stored_found_frame_errors(
      c,
      name,
      t,
      resolved,
      value,
      ck_view_value(c, resolved)
    )
    false => (clean_errors => clean_errors)
  }
}

pub theorem ck_let_stored_frame_errors(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  stored: Bool
): CkErrorFrame(c, ck_let_stored(c, name, t, resolved, value, stored)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
    Eq::sym(binding_stored_unf(c, name, t, resolved, value, stored)),
    binding_stored_frame_errors(c, name, t, resolved, value, stored)
  )
}

pub theorem binding_var_view_frame_errors(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm
): CkErrorFrame(c, binding_var_view(c, name, resolved, value)) {
  frame_error_if_ok_errors(
      c,
      var_holds_linear_message(name, ty_show(ck_shown(c, resolved))),
      span_of(value),
      kind_eq(ck_kind(c, resolved), KindLinear)
    )
}

pub theorem binding_var_mode_frame_errors(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm,
  vb: Bool
): CkErrorFrame(c, binding_var_mode(c, name, resolved, value, vb)) {
  match vb {
    true => frame_error_if_ok_errors(
      c,
      var_borrow_binds_view_message(name),
      span_of(value),
      not(ck_is_view(c, resolved))
    )
    false => binding_var_view_frame_errors(c, name, resolved, value)
  }
}

pub theorem ck_var_check_frame_errors(
  c: Checker,
  name: Text,
  vb: Bool,
  resolved: Ty,
  value: SurfaceTerm
): CkErrorFrame(c, ck_var_check(c, name, vb, resolved, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(binding_var_check_unf(c, name, vb, resolved, value)),
    binding_var_mode_frame_errors(c, name, resolved, value, vb)
  )
}
