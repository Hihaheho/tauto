import "binding_frame.taut"
import "application_frame.taut"
import "argument_error_sound.taut"

pub theorem binding_let_mode_frame_errors(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm,
  bm: Bool
): CkErrorFrame(c, binding_let_mode(c, name, resolved, value, bm)) {
  match bm: CkErrorFrame(c, binding_let_mode(c, name, resolved, value, bm)) {
    true => error_frame_rewrap(
      c,
      ck_error(
        c,
        cat3("`let &mut ", name, "` binds what a function returns as `-> &mut A`"),
        span_of(value)
      ),
      ck_error_frame_errors(
        c,
        cat3("`let &mut ", name, "` binds what a function returns as `-> &mut A`"),
        span_of(value)
      )
    )
    false => error_frame_rewrap(
      c,
      ck_error(
        c,
        cat3("`let &", name, "` binds what a function returns as `-> &A`"),
        span_of(value)
      ),
      ck_error_frame_errors(
        c,
        cat3("`let &", name, "` binds what a function returns as `-> &A`"),
        span_of(value)
      )
    )
  }
}

pub theorem binding_let_view_frame_errors(
  c: Checker,
  name: Text,
  bm: Bool,
  resolved: Ty,
  value: SurfaceTerm,
  r#view: Bool
): CkErrorFrame(c, binding_let_view(c, name, bm, resolved, value, r#view)) {
  match r#view: CkErrorFrame(c, binding_let_view(c, name, bm, resolved, value, r#view)) {
    true => frame_error_if_ok_errors(
      c,
      cat3("`let &mut ", name, "` binds what a function returns as `-> &mut A`"),
      span_of(value),
      Bool::and(bm, not(ck_has_mut_borrow(c, resolved)))
    )
    false => binding_let_mode_frame_errors(c, name, resolved, value, bm)
  }
}

pub theorem ck_let_borrow_frame_errors(
  c: Checker,
  name: Text,
  r#view: Bool,
  bm: Bool,
  resolved: Ty,
  value: SurfaceTerm
): CkErrorFrame(c, ck_let_borrow(c, name, r#view, bm, resolved, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(binding_let_borrow_unf(c, name, r#view, bm, resolved, value)),
    binding_let_view_frame_errors(c, name, bm, resolved, value, r#view)
  )
}

pub theorem binding_stored_borrow_frame_errors(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  p: Ty,
  borrow: Bool
): CkErrorFrame(c, binding_stored_borrow(c, name, t, resolved, value, p, borrow)) {
  match borrow: CkErrorFrame(c, binding_stored_borrow(c, name, t, resolved, value, p, borrow)) {
    true => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(t, c1),
      ck_stored_borrow(c, name, resolved, value),
      ck_stored_borrow_frame_errors(c, name, resolved, value),
      ignored => c1 => (clean_errors => clean_errors)
    )
    false => (clean_errors => clean_errors)
  }
}

pub theorem binding_stored_found_frame_errors(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  found: Option(Ty)
): CkErrorFrame(c, binding_stored_found(c, name, t, resolved, value, found)) {
  match found: CkErrorFrame(c, binding_stored_found(c, name, t, resolved, value, found)) {
    None => error_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(t, c1),
      ck_stored_borrow(c, name, resolved, value),
      ck_stored_borrow_frame_errors(c, name, resolved, value),
      ignored => c1 => (clean_errors => clean_errors)
    )
    Some(p) => binding_stored_borrow_frame_errors(
      c,
      name,
      t,
      resolved,
      value,
      p,
      term_is_borrow(value)
    )
  }
}

pub theorem binding_stored_frame_errors(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  stored: Bool
): CkErrorFrame(c, binding_stored(c, name, t, resolved, value, stored)) {
  match stored: CkErrorFrame(c, binding_stored(c, name, t, resolved, value, stored)) {
    true => binding_stored_found_frame_errors(
      c,
      name,
      t,
      resolved,
      value,
      ck_view_value(c, resolved)
    )
    false => (clean_errors => clean_errors)
  }
}

pub theorem ck_let_stored_frame_errors(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  stored: Bool
): CkErrorFrame(c, ck_let_stored(c, name, t, resolved, value, stored)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkErrorFrame(c, z),
    Eq::sym(binding_stored_unf(c, name, t, resolved, value, stored)),
    binding_stored_frame_errors(c, name, t, resolved, value, stored)
  )
}

pub theorem binding_var_view_frame_errors(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm,
  r#view: Bool
): CkErrorFrame(c, binding_var_view(c, name, resolved, value, r#view)) {
  match r#view: CkErrorFrame(c, binding_var_view(c, name, resolved, value, r#view)) {
    true => error_frame_rewrap(
      c,
      ck_error(c, cat3("a borrow cannot be stored in `var ", name, "`"), span_of(value)),
      ck_error_frame_errors(
        c,
        cat3("a borrow cannot be stored in `var ", name, "`"),
        span_of(value)
      )
    )
    false => frame_error_if_ok_errors(
      c,
      cat5(
        "a var cannot hold a linear value: `",
        name,
        "` is ",
        ty_show(ck_shown(c, resolved)),
        ""
      ),
      span_of(value),
      kind_eq(ck_kind(c, resolved), KindLinear)
    )
  }
}

pub theorem binding_var_mode_frame_errors(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm,
  vb: Bool
): CkErrorFrame(c, binding_var_mode(c, name, resolved, value, vb)) {
  match vb: CkErrorFrame(c, binding_var_mode(c, name, resolved, value, vb)) {
    true => frame_error_if_ok_errors(
      c,
      cat3("`var &", name, "` binds what a function returns as a view"),
      span_of(value),
      not(ck_is_view(c, resolved))
    )
    false => binding_var_view_frame_errors(c, name, resolved, value, ck_is_view(c, resolved))
  }
}

pub theorem ck_var_check_frame_errors(
  c: Checker,
  name: Text,
  vb: Bool,
  resolved: Ty,
  value: SurfaceTerm
): CkErrorFrame(c, ck_var_check(c, name, vb, resolved, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(binding_var_check_unf(c, name, vb, resolved, value)),
    binding_var_mode_frame_errors(c, name, resolved, value, vb)
  )
}
