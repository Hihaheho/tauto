import "arm_frame.taut"
import "written_error_sound.taut"
import "handle_error_sound.taut"
import "handler_result_checked.taut"

pub theorem ck_arm_enter_frame_errors(c: Checker, xs: List(TypeName)): CkErrorFrame(
  c,
  ck_arm_enter(c, xs)
) { (clean => clean) }

pub theorem ck_enter_fn_frame_errors(c: Checker, scheme: Scheme): CkErrorFrame(c, ck_enter_fn(c, scheme)) {
  (clean => clean)
}

pub theorem ck_leave_fn_frame_errors(
  c: Checker,
  assume: List(Pair(Text, Text)),
  types: List(TypeName)
): CkErrorFrame(c, ck_leave_fn(c, assume, types)) { (clean => clean) }

pub theorem ck_arm_report_frame_errors(
  c: Checker,
  why: Text,
  rv: Option(Nat),
  body: SurfaceTerm
): CkErrorFrame(c, ck_arm_report(c, why, rv, body)) {
  match rv: CkErrorFrame(c, ck_arm_report(c, why, rv, body)) {
    Some(v) => ck_error_frame_errors(c, why, span_of(body))
    None => (clean => clean)
  }
}

pub theorem arm_fresh_step_frame_errors(
  c: Checker,
  g: Text,
  rest: List(Text),
  map: Ordmap(Text, Ty),
  has: Bool,
  ih: ∀ next: Checker. ∀ m: Ordmap(Text, Ty). CkErrorFrame(next, ck_arm_fresh(next, rest, m))
): CkErrorFrame(c, arm_fresh_step(c, g, rest, map, has)) {
  match has: CkErrorFrame(c, arm_fresh_step(c, g, rest, map, has)) {
    true => error_frame_rewrap(c, ck_arm_fresh(c, rest, map), ih(c, map))
    false => error_frame_bind(
      Ty,
      Ordmap(Text, Ty),
      c,
      (v: Ty, c1: Checker) => ck_rewrap1(
        ck_arm_fresh(c1, rest, Ordmap::insert(map, g, v, Ordmap::compare_text))
      ),
      ck_fresh(c),
      ck_fresh_frame_errors(c),
      v => next => error_frame_rewrap(
        next,
        ck_arm_fresh(next, rest, Ordmap::insert(map, g, v, Ordmap::compare_text)),
        ih(next, Ordmap::insert(map, g, v, Ordmap::compare_text))
      )
    )
  }
}

pub theorem ck_arm_fresh_frame_errors(
  c: Checker,
  gs: List(Text),
  map: Ordmap(Text, Ty)
): CkErrorFrame(c, ck_arm_fresh(c, gs, map)) {
  match gs: CkErrorFrame(c, ck_arm_fresh(c, gs, map)) {
    Nil => (clean => clean)
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => CkErrorFrame(c, z),
      Eq::sym(arm_fresh_unf(c, g, rest, map)),
      arm_fresh_step_frame_errors(
        c,
        g,
        rest,
        map,
        Ordmap::contains(map, g, Ordmap::compare_text),
        next => m => ck_arm_fresh_frame_errors(next, rest, m)
      )
    )
  }
}

pub theorem ck_arm_given_frame_errors(
  c: Checker,
  typed: List(Text),
  types: List(SurfaceTerm),
  map: Ordmap(Text, Ty)
): CkErrorFrame(c, ck_arm_given(c, typed, types, map)) {
  match typed: CkErrorFrame(c, ck_arm_given(c, typed, types, map)) {
    Nil => (clean => clean)
    Cons(g, gs) => match types: CkErrorFrame(c, ck_arm_given(c, Cons(g, gs), types, map)) {
      Nil => (clean => clean)
      Cons(t, ts) => error_frame_bind(
        Ty,
        Ordmap(Text, Ty),
        c,
        (w: Ty, c1: Checker) => ck_rewrap1(
          ck_arm_given(c1, gs, ts, Ordmap::insert(map, g, w, Ordmap::compare_text))
        ),
        ck_written(c, t, type_scope(ck_type_params_of(c))),
        ck_written_frame_errors(c, t, type_scope(ck_type_params_of(c))),
        w => next => error_frame_rewrap(
          next,
          ck_arm_given(next, gs, ts, Ordmap::insert(map, g, w, Ordmap::compare_text)),
          ck_arm_given_frame_errors(next, gs, ts, Ordmap::insert(map, g, w, Ordmap::compare_text))
        )
      )
    }
  }
}

pub theorem ck_rigid_k_frame_errors(
  c: Checker,
  g: Pair(Text, Kind),
  t: Ty,
  m: Mut1(Ordmap(Text, Ty), Checker),
  h: CkErrorFrame(c, m)
): CkErrorFrame(c, ck_rigid_k(g, t, m)) {
  match m: CkErrorFrame(c, ck_rigid_k(g, t, m)) {
    mut1(x, c2) => h
  }
}

// Making rigid types only counts them.
pub theorem ck_rigid_frame_errors(gs: List(Pair(Text, Kind)), c: Checker): CkErrorFrame(c, ck_rigid(gs, c)) {
  match gs: CkErrorFrame(c, ck_rigid(gs, c)) {
    Nil => (clean => clean)
    Cons(g, rest) => ck_rigid_k_frame_errors(
      c,
      g,
      TyParam(cat3(tk_first(g), "#", Text::of_nat(Nat::add(ck_rigids_of(c), 1))), tk_second(g)),
      ck_rigid(rest, ck_st(ck_bump_rigids(c))),
      ck_rigid_frame_errors(rest, ck_st(ck_bump_rigids(c)))
    )
  }
}

pub theorem ck_arm_sig_at_frame_errors(
  c: Checker,
  s: EffectSig,
  typed: List(Text),
  r#instance: ArmInstance,
  binds: List(Text),
  rv: Option(Nat),
  body: SurfaceTerm
): CkErrorFrame(c, ck_arm_sig_at(c, s, typed, r#instance, binds, rv, body)) {
  match r#instance: CkErrorFrame(c, ck_arm_sig_at(c, s, typed, r#instance, binds, rv, body)) {
    ArmBad(why) => error_frame_bind(
      Unit,
      Option(ArmSig),
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        Ordmap(Text, Ty),
        Option(ArmSig),
        (fresh: Ordmap(Text, Ty), c2: Checker) => mut1(
          arm_sig_of(ty_substitute(handle_effect_type(s), fresh), Nil, Nil),
          c2
        ),
        ck_arm_fresh(c1, handle_effect_generics(s), Ordmap::empty())
      ),
      ck_arm_report(c, why, rv, body),
      ck_arm_report_frame_errors(c, why, rv, body),
      ignored => c1 => error_frame_bind(
        Ordmap(Text, Ty),
        Option(ArmSig),
        c1,
        (fresh: Ordmap(Text, Ty), c2: Checker) => mut1(
          arm_sig_of(ty_substitute(handle_effect_type(s), fresh), Nil, Nil),
          c2
        ),
        ck_arm_fresh(c1, handle_effect_generics(s), Ordmap::empty()),
        ck_arm_fresh_frame_errors(c1, handle_effect_generics(s), Ordmap::empty()),
        fresh => c2 => (clean => clean)
      )
    )
    ArmOne(written) => error_frame_bind(
      Ordmap(Text, Ty),
      Option(ArmSig),
      c,
      (given: Ordmap(Text, Ty), c1: Checker) => frame_bind(
        Ordmap(Text, Ty),
        Option(ArmSig),
        (fixed: Ordmap(Text, Ty), c2: Checker) => mut1(
          arm_sig_of(ty_substitute(handle_effect_type(s), fixed), Nil, Nil),
          c2
        ),
        ck_arm_fresh(c1, handle_effect_generics(s), given)
      ),
      ck_arm_given(c, typed, written, Ordmap::empty()),
      ck_arm_given_frame_errors(c, typed, written, Ordmap::empty()),
      given => c1 => error_frame_bind(
        Ordmap(Text, Ty),
        Option(ArmSig),
        c1,
        (fixed: Ordmap(Text, Ty), c2: Checker) => mut1(
          arm_sig_of(ty_substitute(handle_effect_type(s), fixed), Nil, Nil),
          c2
        ),
        ck_arm_fresh(c1, handle_effect_generics(s), given),
        ck_arm_fresh_frame_errors(c1, handle_effect_generics(s), given),
        fixed => c2 => (clean => clean)
      )
    )
    ArmEvery => error_frame_bind(
      Ordmap(Text, Ty),
      Option(ArmSig),
      c,
      (rigid: Ordmap(Text, Ty), c1: Checker) => mut1(
        arm_sig_of(
          ty_substitute(handle_effect_type(s), rigid),
          rigid_param_names(handle_effect_generics(s), rigid),
          arm_bound(binds, typed, rigid)
        ),
        c1
      ),
      ck_rigid(affine_generics(handle_effect_generics(s)), c),
      ck_rigid_frame_errors(affine_generics(handle_effect_generics(s)), c),
      rigid => c1 => (clean => clean)
    )
  }
}

pub theorem arm_sig_found_frame_errors(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  rv: Option(Nat),
  body: SurfaceTerm,
  found: Option(EffectSig)
): CkErrorFrame(c, arm_sig_found(c, eff, binds, types, rv, body, found)) {
  match found: CkErrorFrame(c, arm_sig_found(c, eff, binds, types, rv, body, found)) {
    Some(s) => error_frame_rewrap(
      c,
      ck_arm_sig_at(
        c,
        s,
        effect_typed_generics(handle_effect_generics(s), s),
        arm_instance(eff, binds, types, effect_typed_generics(handle_effect_generics(s), s)),
        binds,
        rv,
        body
      ),
      ck_arm_sig_at_frame_errors(
        c,
        s,
        effect_typed_generics(handle_effect_generics(s), s),
        arm_instance(eff, binds, types, effect_typed_generics(handle_effect_generics(s), s)),
        binds,
        rv,
        body
      )
    )
    None => error_frame_bind(
      Unit,
      Option(ArmSig),
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, cat3("no effect `", eff, "` is declared"), span_of(body)),
      ck_error_frame_errors(c, cat3("no effect `", eff, "` is declared"), span_of(body)),
      ignored => c1 => (clean => clean)
    )
  }
}

pub theorem arm_sig_step_frame_errors(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  body: SurfaceTerm,
  exceeded: Bool
): CkErrorFrame(c, arm_sig_step(c, eff, binds, types, result, rv, budget_ty, body, exceeded)) {
  match exceeded: CkErrorFrame(
    c,
    arm_sig_step(c, eff, binds, types, result, rv, budget_ty, body, exceeded)
  ) {
    true => (clean => clean)
    false => arm_sig_found_frame_errors(
      c,
      eff,
      binds,
      types,
      rv,
      body,
      Ordmap::get(handle_effects(c), eff, Ordmap::compare_text)
    )
  }
}

pub theorem ck_handle_arm_sig_frame_errors(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  body: SurfaceTerm
): CkErrorFrame(c, ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body)) {
  Eq::subst(
    (z: Mut1(Option(ArmSig), Checker)) => CkErrorFrame(c, z),
    Eq::sym(arm_sig_unf(c, eff, binds, types, result, rv, budget_ty, body)),
    arm_sig_step_frame_errors(c, eff, binds, types, result, rv, budget_ty, body, Text::eq(eff, "exceeded"))
  )
}


pub theorem arm_finish_after_run_frame_checked(
  c: Checker,
  eff: Text,
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  out: Bool,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, arm_finish_after(c, eff, a, result, rv, span, out)) {
  match out: CkCheckedFrame(c, arm_finish_after(c, eff, a, result, rv, span, out)) {
    true => checked_frame_read(
      c,
      arm_finish_after(c, eff, a, result, rv, span, true),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        ),
        ck_error_frame(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        )
      ),
      error_frame_rewrap(
        c,
        ck_error(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        ),
        ck_error_frame_errors(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        )
      ),
      ordered
    )
    false => checked_frame_rewrap(
      c,
      ck_handle_arm_result(c, a, result, rv, span),
      ck_handle_arm_result_run_frame_checked(c, a, result, rv, span, ordered)
    )
  }
}

pub theorem ck_handle_arm_finish_run_frame_checked(
  c: Checker,
  eff: Text,
  rigid: List(Text),
  env: List(Local),
  types: List(TypeName),
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_handle_arm_finish(c, eff, rigid, env, types, a, result, rv, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(arm_finish_unf(c, eff, rigid, env, types, a, result, rv, span)),
    checked_frame_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => arm_finish_after(
        c1,
        eff,
        a,
        result,
        rv,
        span,
        ck_arm_lets_rigid_out(c1, rigid, a, result, env)
      ),
      arm_set_types(c, types),
      checked_frame_read(c, arm_set_types(c, types), Refl, (clean => clean), ordered),
      ignored => c1 => o_c1 => arm_finish_after_run_frame_checked(
        c1,
        eff,
        a,
        result,
        rv,
        span,
        ck_arm_lets_rigid_out(c1, rigid, a, result, env),
        o_c1
      )
    )
  )
}
