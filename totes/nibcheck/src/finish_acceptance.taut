import "diagnostic_report.taut"
pub def FinalDiagnostics6(c: Checker): Prop := True
pub fn diagnostic_finish6(
  c: Checker,
  widths: Ordmap(TermAt, Width)
): Mut1(TypeReport, Checker) { mut1(finish_report(c, Widths), c) }
pub theorem diagnostic_finish6_accepts(
  c: Checker,
  widths: Ordmap(TermAt, Width),
  clean: DiagnosticReportClean(diagnostic_finish6(c, widths))
): DiagnosticReportResult(
  FinalDiagnostics6,
  c,
  Widths,
  diagnostic_finish6(c, Widths)
) { AndIntro(Trivial, Refl) }
pub def FinalDiagnostics5(
  c: Checker
): Prop := And(
  DiagnosticItems(TyPending, DiagnosticPending, c, List::reverse(finish_pending_items(c))),
  FinalDiagnostics6(c)
)
pub fn diagnostic_finish5(
  c: Checker,
  widths: Ordmap(TermAt, Width)
): Mut1(
  TypeReport,
  Checker
) {
  diagnostic_report_after(
    (next: Checker) => diagnostic_finish6(next, Widths),
    ck_check_pending(List::reverse(finish_pending_items(c)), c)
  )
}
pub theorem diagnostic_finish5_accepts(
  c: Checker,
  widths: Ordmap(TermAt, Width),
  clean: DiagnosticReportClean(diagnostic_finish5(c, widths))
): DiagnosticReportResult(FinalDiagnostics5, c, Widths, diagnostic_finish5(c, Widths)) {
  diagnostic_report_cons(
    c,
    Widths,
    ck_check_pending(List::reverse(finish_pending_items(c)), c),
    (next: Checker) => diagnostic_finish6(next, Widths),
    DiagnosticItems(TyPending, DiagnosticPending, c, List::reverse(finish_pending_items(c))),
    FinalDiagnostics6,
    h => ck_check_pending_accepts(List::reverse(finish_pending_items(c)), c, h),
    next => h => diagnostic_finish6_accepts(next, Widths, h),
    clean
  )
}
