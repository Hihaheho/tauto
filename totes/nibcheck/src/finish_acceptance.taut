pub def FinalDiagnostics0(
  c: Checker
): Prop := And(
  DiagnosticItems(TyLiteral, DiagnosticLiteral, c, List::reverse(finish_literals(c))),
  FinalDiagnostics1(c)
)
pub fn diagnostic_finish0(
  c: Checker,
  widths: Ordmap(TermAt, Width)
): Mut1(
  TypeReport,
  Checker
) {
  diagnostic_report_after(
    (next: Checker) => diagnostic_finish1(next, Widths),
    ck_check_literals(List::reverse(finish_literals(c)), c)
  )
}
pub theorem diagnostic_finish0_accepts(
  c: Checker,
  widths: Ordmap(TermAt, Width),
  clean: DiagnosticReportClean(diagnostic_finish0(c, widths))
): DiagnosticReportResult(FinalDiagnostics0, c, Widths, diagnostic_finish0(c, Widths)) {
  diagnostic_report_cons(
    c,
    Widths,
    ck_check_literals(List::reverse(finish_literals(c)), c),
    (next: Checker) => diagnostic_finish1(next, Widths),
    DiagnosticItems(TyLiteral, DiagnosticLiteral, c, List::reverse(finish_literals(c))),
    FinalDiagnostics1,
    h => ck_check_literals_accepts(List::reverse(finish_literals(c)), c, h),
    next => h => diagnostic_finish1_accepts(next, Widths, h),
    clean
  )
}
pub theorem diagnostic_finish_unf(
  c: Checker,
  widths: Ordmap(TermAt, Width)
): finish_after_defaults(c, Widths) = diagnostic_finish0(c, Widths) { Refl }
pub theorem finish_after_defaults_accepts(
  c: Checker,
  widths: Ordmap(TermAt, Width),
  clean: DiagnosticReportClean(finish_after_defaults(c, widths))
): DiagnosticReportResult(FinalDiagnostics0, c, Widths, finish_after_defaults(c, Widths)) {
  Eq::subst(
    (m: Mut1(TypeReport, Checker)) => DiagnosticReportResult(FinalDiagnostics0, c, Widths, m),
    Eq::sym(diagnostic_finish_unf(c, Widths)),
    diagnostic_finish0_accepts(
      c,
      Widths,
      Eq::subst(DiagnosticReportClean, diagnostic_finish_unf(c, Widths), clean)
    )
  )
}

pub fn diagnostic_finish_default_result(m: Mut1(Unit, Checker)): Mut1(TypeReport, Checker) {
  match m: Mut1(
    TypeReport,
    Checker
  ) {
    mut1(v, next) => finish_after_defaults(
      next,
      ck_widths(List::reverse(finish_ops(next)), next, Ordmap::empty())
    )
  }
}
pub theorem diagnostic_finish_default_result_accepts(
  m: Mut1(Unit, Checker),
  clean: DiagnosticReportClean(diagnostic_finish_default_result(m))
): FinalDiagnostics0(ck_st(diagnostic_finish_default_result(m))) {
  match m: FinalDiagnostics0(ck_st(diagnostic_finish_default_result(m))) {
    mut1(v, next) => {
      let accepted: DiagnosticReportResult(
        FinalDiagnostics0,
        next,
        ck_widths(List::reverse(finish_ops(next)), next, Ordmap::empty()),
        finish_after_defaults(next, ck_widths(List::reverse(finish_ops(next)), next, Ordmap::empty()))
      ) := finish_after_defaults_accepts(
        next,
        ck_widths(List::reverse(finish_ops(next)), next, Ordmap::empty()),
        clean
      )
      Eq::subst(
        FinalDiagnostics0,
        Eq::sym(Eq::congr((z: Mut1(TypeReport, Checker)) => ck_st(z), And::right(accepted))),
        And::left(accepted)
      )
    }
  }
}
pub fn diagnostic_finish_products_result(m: Mut1(Unit, Checker)): Mut1(TypeReport, Checker) {
  match m: Mut1(
    TypeReport,
    Checker
  ) {
    mut1(v, next) => diagnostic_finish_default_result(
      ck_check_products(List::reverse(finish_product_checks(next)), next)
    )
  }
}
pub theorem diagnostic_finish_products_result_accepts(
  m: Mut1(Unit, Checker),
  clean: DiagnosticReportClean(diagnostic_finish_products_result(m))
): FinalDiagnostics0(ck_st(diagnostic_finish_products_result(m))) {
  match m: FinalDiagnostics0(ck_st(diagnostic_finish_products_result(m))) {
    mut1(v, next) => diagnostic_finish_default_result_accepts(
      ck_check_products(List::reverse(finish_product_checks(next)), next),
      clean
    )
  }
}
pub theorem diagnostic_finish_default_unf(
  c: Checker
): ck_finish(c) = diagnostic_finish_products_result(ck_default_ints(Ordmap::entries(finish_ints(c)), c)) { Refl }
pub theorem ck_finish_obligations(
  c: Checker,
  clean: DiagnosticReportClean(ck_finish(c))
): FinalDiagnostics0(ck_st(ck_finish(c))) {
  Eq::subst(
    (z: Mut1(TypeReport, Checker)) => FinalDiagnostics0(ck_st(z)),
    Eq::sym(diagnostic_finish_default_unf(c)),
    diagnostic_finish_products_result_accepts(
      ck_default_ints(Ordmap::entries(finish_ints(c)), c),
      Eq::subst(DiagnosticReportClean, diagnostic_finish_default_unf(c), clean)
    )
  )
}
