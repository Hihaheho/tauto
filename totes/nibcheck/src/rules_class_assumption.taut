import "ty.taut"
import std::row
import std::text

// Class assumptions are declarations in the context. DecEq also supplies
// PartialEq, independently of the implementation's boolean search.
pub(open) inductive ClassAssumption(assume: List(Text × Text)): (Text, Text) -> Prop {
  ClassAssumeDirect(
    r#class: Text,
    name: Text,
    present: Mem(Text × Text, #(r#class, name), assume)
  ): ClassAssumption(assume, r#class, name)
  ClassAssumeDecEq(
    name: Text,
    present: Mem(Text × Text, #("DecEq", name), assume)
  ): ClassAssumption(assume, "PartialEq", name)
}
