import "checker_frame.taut"
import "checked_frame.taut"
import "written_error_sound.taut"
import std::Map
import std::MapLaws
import std::Text
import "checker.taut"
import "datas_frame.taut"
import "fits_sound.taut"
import "join_sound.taut"
import "ty.taut"
import "unify_sound.taut"

pub theorem ck_set_subst_run_frame_checked(
  c: Checker,
  v: Nat,
  t: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_set_subst(c, v, t)) {
  AndIntro(
    Ordmap::insert_ordered(
      Ordmap::compare_nat,
      Ordmap::compare_nat_law(),
      ck_subst_of(c),
      v,
      t,
      ordered
    ),
    (clean_errors => clean_errors)
  )
}
pub theorem ck_unify_run_frame_checked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_unify(c, a, b)) {
  checked_frame_grows(c, ck_unify(c, a, b), And::left(ck_unify_ok(c, a, b)(ordered)))
}
