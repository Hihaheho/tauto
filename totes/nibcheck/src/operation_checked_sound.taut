pub theorem run_expect_after_frame_checked(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  fits: Bool,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, run_expect_after(c, a, b, span, what, fits)) {
  match fits {
    true => checked_frame_return(c, Star, ordered)
    false => checked_frame_bind(
      <A: Option(CoerceFound), B: Unit>,
      c,
      (found: Option(CoerceFound), next: Checker) => run_expect_refused(next, a, b, span, what, found),
      ck_coerce_fit(c, a, b),
      checked_frame_grows(c, ck_coerce_fit(c, a, b), ck_coerce_fit_grows(c, a, b, ordered)),
      found => next => onext => checked_frame_read(
        next,
        run_expect_refused(next, a, b, span, what, found),
        frame_error_if_ok(next, coerce_refusal(next, a, b, what, found), span, coerce_refused(next, found)),
        frame_error_if_ok_errors(next, coerce_refusal(next, a, b, what, found), span, coerce_refused(next, found)),
        onext
      )
    )
  }
}
pub theorem ck_expect_run_frame_checked(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_expect(c, a, b, span, what)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(run_expect_unf(c, a, b, span, what)),
    checked_frame_bind(
      <A: Bool, B: Unit>,
      c,
      (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits),
      ck_fits_wide(c, a, b),
      ck_fits_wide_run_frame_checked(c, a, b, ordered),
      fits => next => onext => run_expect_after_frame_checked(next, a, b, span, what, fits, onext)
    )
  )
}

pub theorem ck_attempt_unify_run_frame_checked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_attempt_unify(c, a, b)) {
  checked_frame_grows(c, ck_attempt_unify(c, a, b), And::left(attempt_unify_sub(c, a, b)(ordered)))
}
