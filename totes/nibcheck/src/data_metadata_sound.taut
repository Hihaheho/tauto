import "data_entries_sound.taut"
import "summary_state.taut"
import std::Map
import std::MapLaws
import std::MapText
import std::Row
import std::Text
import "datas.taut"
import "kind_sound.taut"
import "summary_sound.taut"
import "ty.taut"
import "types_decl.taut"
import std::prelude::Ord

// Erase only the fields computed by recursive analysis and kind summarization.
pub fn data_metadata(data: Data): Data {
  Data {
    name: data.name,
    declared: data.declared,
    generics: data.generics,
    constructors: data.constructors,
    is_struct: data.is_struct,
    recursive: false,
    base: KindCopy,
    holds: Nil,
    builtin: data.builtin,
    r#view: data.r#view
  }
}
pub fn data_metadata_option(o: Option(Data)): Option(Data) {
  match o: Option(Data) {
    None => None
    Some(data) => Some(data_metadata(data))
  }
}
pub fn data_metadata_lookup(
  m: Ordmap(Text, Data),
  n: Text
): Option(Data) { data_metadata_option(Ordmap::get(m, n, Ordmap::compare_text)) }
pub def DataMetadataSame(
  a: Ordmap(Text, Data),
  b: Ordmap(Text, Data)
): Prop := ∀ n: Text. data_metadata_lookup(a, n) = data_metadata_lookup(b, n)

pub theorem data_metadata_summary(
  data: Data,
  base: Kind,
  holds: List(Text)
): data_metadata(data_with_summary(data, base, holds)) = data_metadata(data) { Refl }
pub theorem data_metadata_recursive(
  data: Data,
  recursive: Bool
): data_metadata(data_with_recursive(data, recursive)) = data_metadata(data) { Refl }
pub theorem data_metadata_least(
  data: Data
): data_metadata(data_least(data)) = data_metadata(data) { Refl }
pub theorem data_metadata_top(
  data: Data
): data_metadata(data_top(data)) = data_metadata(data) { Refl }

pub theorem data_metadata_insert_at(
  m: Ordmap(Text, Data),
  k: Text,
  v: Data,
  ordered: Ordmap::ordered(m, Ordmap::compare_text),
  compatible: data_metadata_lookup(m, k) = Some(data_metadata(v))
): data_metadata_lookup(m, k) = data_metadata_lookup(Ordmap::insert(m, k, v, Ordmap::compare_text), k) {
  Eq::trans(
    compatible,
    Eq::sym(Eq::congr(data_metadata_option, Ordmap::text_get_insert_same(m, k, v, ordered)))
  )
}

pub theorem data_metadata_insert_k(
  m: Ordmap(Text, Data),
  k: Text,
  v: Data,
  ordered: Ordmap::ordered(m, Ordmap::compare_text),
  compatible: data_metadata_lookup(m, k) = Some(data_metadata(v)),
  n: Text,
  o: Ordering,
  eo: Ordmap::compare_text(n, k) = o
): data_metadata_lookup(m, n) = data_metadata_lookup(Ordmap::insert(m, k, v, Ordmap::compare_text), n) {
  match o: data_metadata_lookup(m, n) = data_metadata_lookup(Ordmap::insert(m, k, v, Ordmap::compare_text), n) {
    Equal => Eq::subst(
      (key: Text) => data_metadata_lookup(m, key) = data_metadata_lookup(Ordmap::insert(m, k, v, Ordmap::compare_text), key),
      Eq::sym(Ordmap::compare_text_eq(n, k, eo)),
      data_metadata_insert_at(m, k, v, ordered, compatible)
    )
    Less => Eq::sym(
      Eq::congr(
        data_metadata_option,
        Ordmap::get_insert_other(
          Ordmap::compare_text,
          Ordmap::compare_text_law(),
          m,
          k,
          v,
          n,
          Less,
          q => less_ne_equal(q),
          eo,
          ordered
        )
      )
    )
    Greater => Eq::sym(
      Eq::congr(
        data_metadata_option,
        Ordmap::get_insert_other(
          Ordmap::compare_text,
          Ordmap::compare_text_law(),
          m,
          k,
          v,
          n,
          Greater,
          q => greater_ne_equal(q),
          eo,
          ordered
        )
      )
    )
  }
}

pub theorem data_metadata_insert(
  m: Ordmap(Text, Data),
  k: Text,
  v: Data,
  ordered: Ordmap::ordered(m, Ordmap::compare_text),
  compatible: data_metadata_lookup(m, k) = Some(data_metadata(v))
): DataMetadataSame(m, Ordmap::insert(m, k, v, Ordmap::compare_text)) {
  n => data_metadata_insert_k(m, k, v, ordered, compatible, n, Ordmap::compare_text(n, k), Refl)
}

pub def DataEntriesFrom(
  es: List(Pair(Text, Data)),
  original: Ordmap(Text, Data)
): Prop := ∀ e: Pair(
  Text,
  Data
). ∀ member: Mem(
  Pair(Text, Data),
  e,
  es
). Ordmap::get(original, summary_key(e), Ordmap::compare_text) = Some(data_entry_value(e))

pub theorem data_metadata_map(
  es: List(Pair(Text, Data)),
  f: (Data) -> Data,
  original: Ordmap(Text, Data),
  acc: Ordmap(Text, Data),
  ordered: Ordmap::ordered(acc, Ordmap::compare_text),
  same: DataMetadataSame(original, acc),
  entries: DataEntriesFrom(es, original),
  preserves: ∀ data: Data. data_metadata(f(data)) = data_metadata(data)
): DataMetadataSame(original, datas_map_decls(es, f, acc)) {
  match es: DataMetadataSame(original, datas_map_decls(es, f, acc)) {
    Nil => same
    Cons(e, rest) => {
      let k: Text := summary_key(e)
      let v: Data := f(data_entry_value(e))
      let next: Ordmap(Text, Data) := Ordmap::insert(acc, k, v, Ordmap::compare_text)
      let compatible: data_metadata_lookup(acc, k) = Some(data_metadata(v)) := Eq::trans(
        Eq::sym(same(k)),
        Eq::trans(
          Eq::congr(data_metadata_option, entries(e, MemHere(rest))),
          Eq::congr((d: Data) => Some(d), Eq::sym(preserves(data_entry_value(e))))
        )
      )
      let unchanged: DataMetadataSame(
        acc,
        next
      ) := data_metadata_insert(acc, k, v, ordered, compatible)
      data_metadata_map(
        rest,
        f,
        original,
        next,
        Ordmap::insert_ordered(Ordmap::compare_text, Ordmap::compare_text_law(), acc, k, v, ordered),
        n => Eq::trans(same(n), unchanged(n)),
        entry => member => entries(entry, MemThere(e, rest, member)),
        preserves
      )
    }
  }
}

pub theorem data_metadata_map_entries(
  m: Ordmap(Text, Data),
  f: (Data) -> Data,
  ordered: Ordmap::ordered(m, Ordmap::compare_text),
  preserves: ∀ data: Data. data_metadata(f(data)) = data_metadata(data)
): DataMetadataSame(m, datas_map_decls(Ordmap::entries(m), f, m)) {
  data_metadata_map(
    Ordmap::entries(m),
    f,
    m,
    m,
    ordered,
    n => Refl,
    e => member => data_entries_lookup(m, e, ordered, member),
    preserves
  )
}

pub def DataMetadataPreserved(
  d: Datas,
  next: Datas
): Prop := DataMetadataSame(summary_decls(d), summary_decls(next))

pub theorem data_metadata_update(
  d: Datas,
  n: Text,
  data: Data,
  ordered: SummaryOrdered(d),
  found: datas_decl(d, n) = Some(data)
): DataMetadataPreserved(d, summary_update(d, n, data)) {
  let r: Pair(
    Kind,
    List(Text)
  ) := ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) })
  data_metadata_insert(
    summary_decls(d),
    n,
    data_with_summary(data, kind_join(dbase(data), pfst(r)), psnd(r)),
    ordered,
    Eq::trans(
      Eq::congr(data_metadata_option, found),
      Eq::congr(
        (v: Data) => Some(v),
        Eq::sym(data_metadata_summary(data, kind_join(dbase(data), pfst(r)), psnd(r)))
      )
    )
  )
}

pub def DataMetadataRound(
  d: Datas,
  r: Pair(Datas, Bool)
): Prop := DataMetadataPreserved(d, summary_result(r))

pub theorem data_metadata_round_test(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  data: Data,
  b: Bool,
  ih: ∀ next: Datas. ∀ flag: Bool. ∀ ready: SummaryReady(
    next
  ). DataMetadataRound(next, datas_round(rest, next, flag)),
  ready: SummaryReady(d),
  found: datas_decl(d, n) = Some(data)
): DataMetadataRound(d, summary_round_test(rest, d, grew, n, data, b)) {
  match b: DataMetadataRound(d, summary_round_test(rest, d, grew, n, data, b)) {
    true => ih(d, grew, ready)
    false => key => Eq::trans(
      data_metadata_update(d, n, data, And::left(ready), found)(key),
      ih(summary_update(d, n, data), true, summary_update_ready(d, n, data, ready, found))(key)
    )
  }
}

pub theorem data_metadata_round_decl(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  o: Option(Data),
  found: datas_decl(d, n) = o,
  ready: SummaryReady(d),
  ih: ∀ next: Datas. ∀ flag: Bool. ∀ good: SummaryReady(
    next
  ). DataMetadataRound(next, datas_round(rest, next, flag))
): DataMetadataRound(d, summary_round_decl(rest, d, grew, n, o)) {
  match o: DataMetadataRound(d, summary_round_decl(rest, d, grew, n, o)) {
    None => ih(d, grew, ready)
    Some(data) => data_metadata_round_test(
      rest,
      d,
      grew,
      n,
      data,
      summary_test(d, data),
      ih,
      ready,
      found
    )
  }
}

pub theorem data_metadata_round(
  es: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  ready: SummaryReady(d)
): DataMetadataRound(d, datas_round(es, d, grew)) {
  match es: DataMetadataRound(d, datas_round(es, d, grew)) {
    Nil => n => Refl
    Cons(e, rest) => Eq::subst(
      (r: Pair(Datas, Bool)) => DataMetadataRound(d, r),
      Eq::sym(summary_round_unf(e, rest, d, grew)),
      data_metadata_round_decl(
        rest,
        d,
        grew,
        summary_key(e),
        datas_decl(d, summary_key(e)),
        Refl,
        ready,
        next => flag => good => data_metadata_round(rest, next, flag, good)
      )
    )
  }
}

pub theorem data_metadata_choice(
  j: Nat,
  d: Datas,
  b: Bool,
  next: DataMetadataPreserved(d, datas_rounds(j, d))
): DataMetadataPreserved(d, summary_rounds_choice(j, d, b)) {
  match b: DataMetadataPreserved(d, summary_rounds_choice(j, d, b)) {
    true => next
    false => n => Refl
  }
}

pub theorem data_metadata_rounds(
  k: Nat,
  d: Datas,
  ready: SummaryReady(d)
): DataMetadataPreserved(d, datas_rounds(k, d)) {
  match k: DataMetadataPreserved(d, datas_rounds(k, d)) {
    Zero => data_metadata_map_entries(
      summary_decls(d),
      data_top,
      And::left(ready),
      data => data_metadata_top(data)
    )
    Succ(j) => {
      let r: Pair(Datas, Bool) := datas_round(Ordmap::entries(summary_decls(d)), d, false)
      let next: DataMetadataPreserved(
        summary_result(r),
        summary_rounds_choice(j, summary_result(r), summary_grew(r))
      ) := data_metadata_choice(
        j,
        summary_result(r),
        summary_grew(r),
        data_metadata_rounds(
          j,
          summary_result(r),
          summary_round_ready(Ordmap::entries(summary_decls(d)), d, false, ready)
        )
      )
      Eq::subst(
        (z: Datas) => DataMetadataPreserved(d, z),
        Eq::sym(summary_rounds_unf(j, d)),
        n => Eq::trans(
          data_metadata_round(Ordmap::entries(summary_decls(d)), d, false, ready)(n),
          next(n)
        )
      )
    }
  }
}

pub theorem datas_summarize_preserves_metadata(
  d: Datas,
  ordered: SummaryOrdered(d)
): DataMetadataPreserved(d, datas_summarize(d)) {
  n => Eq::trans(
    data_metadata_map_entries(
      summary_decls(d),
      data_least,
      ordered,
      data => data_metadata_least(data)
    )(n),
    data_metadata_rounds(summary_steps(d), summary_initial(d), summary_initial_ready(d, ordered))(n)
  )
}
