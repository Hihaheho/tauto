pub fn OptionEffectAllocated(limit: Nat, found: Option(EffectSig)): Prop {
  ⊢ Prop from match found { None => True
    Some(sig) => TypeAllocated(limit, handle_effect_type(sig)) }
}
pub def EffectsAllocated(
  limit: Nat,
  effects: Ordmap(Text, EffectSig)
): Prop := ∀ name: Text. OptionEffectAllocated(
  limit,
  Ordmap::get(effects, name, Ordmap::compare_text)
)
pub theorem application_effect_arity_allocation(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ps: List(Ty),
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  actual: TypeListAllocated(ck_next_of(c), types),
  expected: TypeListAllocated(ck_next_of(c), ps),
  bad: Bool
): AllocationAdvance(c, application_effect_arity(c, eff, types, args, span, ps, bad)) {
  ⊢ AllocationAdvance(c, application_effect_arity(c, eff, types, args, span, ps, bad)) from match bad {
    true => allocation_advance_rewrap(
      c,
      ck_error(
        c,
        cat5(
          "`",
          eff,
          "` takes ",
          Text::of_nat(list_len(ps)),
          cat2(" values, given ", Text::of_nat(list_len(types)))
        ),
        span
      ),
      AndIntro(Nat::le_refl(ck_next_of(c)), state)
    )
    false => allocation_advance_rewrap(
      c,
      ck_expect_args(types, c, ps, args),
      ck_expect_args_allocation(types, c, ps, args, ordered, state, actual, expected)
    ) }
}
pub theorem application_effect_inst_allocation(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  original: Ty,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  actual: TypeListAllocated(ck_next_of(c), types),
  original_bound: TypeAllocated(ck_next_of(c), original),
  inst: Ty,
  bounded: TypeAllocated(ck_next_of(c), inst)
): AllocationResult(c, application_effect_inst(c, eff, types, args, span, original, inst)) {
  ⊢ AllocationResult(
    c,
    application_effect_inst(c, eff, types, args, span, original, inst)
  ) from match inst {
    TyInt(w) => allocation_result_return(c, original, state, original_bound)
    TyBool => allocation_result_return(c, original, state, original_bound)
    TyText => allocation_result_return(c, original, state, original_bound)
    TyUnit => allocation_result_return(c, original, state, original_bound)
    TyNever => allocation_result_return(c, original, state, original_bound)
    TyDecimal => allocation_result_return(c, original, state, original_bound)
    TyFloat => allocation_result_return(c, original, state, original_bound)
    TyFn(ps, r, k) => allocation_result_bind(
      Unit,
      c,
      (ignored: Unit, next: Checker) => mut1(r, next),
      application_effect_arity(
        c,
        eff,
        types,
        args,
        span,
        ps,
        not(Nat::eq(list_len(ps), list_len(types)))
      ),
      application_effect_arity_allocation(
        c,
        eff,
        types,
        args,
        span,
        ps,
        ordered,
        state,
        actual,
        And::left(bounded),
        not(Nat::eq(list_len(ps), list_len(types)))
      ),
      ignored => next => advanced => current => allocation_result_return(
        next,
        r,
        current,
        type_allocated_weaken(r, ck_next_of(c), ck_next_of(next), advanced, And::right(bounded))
      )
    )
    TyUnion(ts) => allocation_result_return(c, original, state, original_bound)
    TyProduct(ts) => allocation_result_return(c, original, state, original_bound)
    TyTagged(tags, inner) => allocation_result_return(c, original, state, original_bound)
    TyNamed(d, more) => allocation_result_return(c, original, state, original_bound)
    TyParam(n, k) => allocation_result_return(c, original, state, original_bound)
    TyInfo(h) => allocation_result_return(c, original, state, original_bound)
    TyBorrow(inner, mutable) => allocation_result_return(c, original, state, original_bound)
    TyVar(v) => allocation_result_return(c, original, state, original_bound)
    TyPoly(gs, inner) => allocation_result_return(c, original, state, original_bound)
    TyApp(h, a) => allocation_result_return(c, original, state, original_bound)
  }
}
pub theorem application_effect_found_allocation(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  actual: TypeListAllocated(ck_next_of(c), types),
  found: Option(EffectSig),
  bounded: OptionEffectAllocated(ck_next_of(c), found)
): AllocationResult(c, application_effect_found(c, eff, types, args, span, found)) {
  ⊢ AllocationResult(c, application_effect_found(c, eff, types, args, span, found)) from match found {
    None => allocation_error_fresh(c, cat3("no effect `", eff, "` is declared"), span, state)
    Some(sig) => allocation_result_ty_bind(
      c,
      (inst: Ty, next: Checker) => application_effect_inst(
        next,
        eff,
        types,
        args,
        span,
        inst,
        inst
      ),
      ck_instantiate_named(c, handle_effect_generics(sig), handle_effect_type(sig)),
      ck_instantiate_named_allocation(
        c,
        handle_effect_generics(sig),
        handle_effect_type(sig),
        state,
        bounded
      ),
      And::left(
        run_frame_read(
          c,
          ck_instantiate_named(c, handle_effect_generics(sig), handle_effect_type(sig)),
          ck_instantiate_named_frame(c, handle_effect_generics(sig), handle_effect_type(sig)),
          ordered
        )
      ),
      inst => next => advanced => current => order => bound => application_effect_inst_allocation(
        next,
        eff,
        types,
        args,
        span,
        inst,
        order,
        current,
        type_list_allocated_weaken(types, ck_next_of(c), ck_next_of(next), advanced, actual),
        bound,
        inst,
        bound
      )
    ) }
}
pub theorem ck_perform_of_allocation(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ordered: CkOrdered(c),
  state: CheckerAllocation(c),
  actual: TypeListAllocated(ck_next_of(c), types),
  effects: EffectsAllocated(ck_next_of(c), handle_effects(c))
): AllocationResult(c, ck_perform_of(c, eff, types, args, span)) {
  Eq::subst(
    (result: Mut1(Ty, Checker)) => AllocationResult(c, result),
    Eq::sym(application_effect_unf(c, eff, types, args, span)),
    application_effect_found_allocation(
      c,
      eff,
      types,
      args,
      span,
      ordered,
      state,
      actual,
      Ordmap::get(handle_effects(c), eff, Ordmap::compare_text),
      effects(eff)
    )
  )
}
