import "unify_sound.taut"
import std::base
import std::map
import std::text
import "checker.taut"
import "datas.taut"
import "rules_ty.taut"
import "ty.taut"
import "unify.taut"
import "fits_sound_head.taut"

// Continued from `fits_sound_head.taut`.

pub theorem shape_cases(
  j: Nat,
  he: FitsE(j),
  hi: FitsI(j),
  c: Checker,
  a1: Ty,
  b1: Ty,
  a: Ty,
  b: Ty,
  ea: a1 = a,
  eb: b1 = b
): Post(c, ck_fits_shape_in(Succ(j), c, a, b), (c2: Checker) => SubAt(c2, a1, b1)) {
  match a {
    TyUnion(xs) => post_sub_eqs(
      c,
      ck_fits_shape_in(Succ(j), c, TyUnion(xs), b),
      a1,
      b1,
      ea,
      eb,
      post_unf(
        c,
        ck_fits_shape_in(Succ(j), c, TyUnion(xs), b),
        ck_rewrap1(ck_fits_each_in(j, ck_off(c), xs, b)),
        (c2: Checker) => SubAt(c2, TyUnion(xs), b),
        Refl,
        post_after(
          c,
          ck_off(c),
          ck_rewrap1(ck_fits_each_in(j, ck_off(c), xs, b)),
          (c2: Checker) => SubAt(c2, TyUnion(xs), b),
          (o: CkOrdered(c)) => grows_refl(c, o),
          post_map(
            ck_off(c),
            ck_fits_each_in(j, ck_off(c), xs, b),
            (c2: Checker) => SubEachAt(c2, b, xs),
            (c2: Checker) => SubAt(c2, TyUnion(xs), b),
            (c2: Checker, h: SubEachAt(c2, b, xs)) => sub_union_l_at(c2, xs, b, h),
            he(ck_off(c), xs, b)
          )
        )
      )
    )
    _ => post_cases(
      c,
      (z: Ty, w: Ty) => ck_fits_shape_in(Succ(j), c, z, w),
      (z: Ty, w: Ty) => ck_rewrap1(ck_fits_into_in(j, c, z, w)),
      (c2: Checker) => SubAt(c2, a1, b1),
      a1,
      b1,
      ea,
      eb,
      Refl,
      post_map(
        c,
        ck_fits_into_in(j, c, a1, b1),
        (c2: Checker) => SubAt(c2, a1, b1),
        (c2: Checker) => SubAt(c2, a1, b1),
        (c2: Checker, h: SubAt(c2, a1, b1)) => h,
        hi(c, a1, b1)
      )
    )
  }
}

pub theorem attempt_unify_sub(
  c: Checker,
  a: Ty,
  b: Ty
): Post(c, ck_attempt_unify(c, a, b), (c2: Checker) => SubAt(c2, a, b)) {
  post_unf(
    c,
    ck_attempt_unify(c, a, b),
    ck_attempt_k(c, ck_unify(c, a, b)),
    (c2: Checker) => SubAt(c2, a, b),
    Refl,
    post_attempt(
      c,
      ck_unify(c, a, b),
      (c2: Checker) => SubAt(c2, a, b),
      post_weak(
        c,
        ck_unify(c, a, b),
        (c2: Checker) => TyEqAt(c2, a, b),
        (c2: Checker) => SubAt(c2, a, b),
        (c2: Checker, h: TyEqAt(c2, a, b)) => sub_of_eq(c2, a, b, h),
        ck_unify_ok(c, a, b)
      )
    )
  )
}

pub theorem into_cases(
  j: Nat,
  hy: FitsY(j),
  ht: FitsT(j),
  c: Checker,
  a1: Ty,
  b1: Ty,
  a: Ty,
  b: Ty,
  ea: a1 = a,
  eb: b1 = b
): Post(c, ck_fits_into_in(Succ(j), c, a, b), (c2: Checker) => SubAt(c2, a1, b1)) {
  match b {
    TyUnion(ys) => post_sub_eqs(
      c,
      ck_fits_into_in(Succ(j), c, a, TyUnion(ys)),
      a1,
      b1,
      ea,
      eb,
      post_unf(
        c,
        ck_fits_into_in(Succ(j), c, a, TyUnion(ys)),
        ck_or(
          (c2: Checker) => ck_fits_any_in(j, c2, a, ys),
          ck_attempt_unify(ck_off(c), a, TyUnion(ys))
        ),
        (c2: Checker) => SubAt(c2, a, TyUnion(ys)),
        Refl,
        post_after(
          c,
          ck_off(c),
          ck_or(
            (c2: Checker) => ck_fits_any_in(j, c2, a, ys),
            ck_attempt_unify(ck_off(c), a, TyUnion(ys))
          ),
          (c2: Checker) => SubAt(c2, a, TyUnion(ys)),
          (o: CkOrdered(c)) => grows_refl(c, o),
          post_or(
            ck_off(c),
            ck_attempt_unify(ck_off(c), a, TyUnion(ys)),
            (c2: Checker) => SubAt(c2, a, TyUnion(ys)),
            (c2: Checker) => ck_fits_any_in(j, c2, a, ys),
            (c2: Checker) => SubAnyAt(c2, a, ys),
            (c2: Checker) => SubAt(c2, a, TyUnion(ys)),
            attempt_unify_sub(ck_off(c), a, TyUnion(ys)),
            (c2: Checker) => hy(c2, a, ys),
            (c3: Checker, h: SubAt(c3, a, TyUnion(ys))) => h,
            (c3: Checker, h: SubAnyAt(c3, a, ys)) => sub_union_r_at(c3, a, ys, h)
          )
        )
      )
    )
    _ => post_cases(
      c,
      (z: Ty, w: Ty) => ck_fits_into_in(Succ(j), c, z, w),
      (z: Ty, w: Ty) => ck_rewrap1(ck_fits_tagged_in(j, c, z, w)),
      (c2: Checker) => SubAt(c2, a1, b1),
      a1,
      b1,
      ea,
      eb,
      Refl,
      post_map(
        c,
        ck_fits_tagged_in(j, c, a1, b1),
        (c2: Checker) => SubAt(c2, a1, b1),
        (c2: Checker) => SubAt(c2, a1, b1),
        (c2: Checker, h: SubAt(c2, a1, b1)) => h,
        ht(c, a1, b1)
      )
    )
  }
}

pub def Tag2Ok(
  j: Nat,
  c: Checker,
  ta: List(Text),
  x: Ty,
  tb: List(Text),
  y: Ty,
  e: Bool
): Prop := (
  tags_subset(tb, ta) = e
) -> Post(
  c,
  ck_tag2_c(j, c, ta, x, tb, y, e),
  (c2: Checker) => SubAt(c2, TyTagged(ta, x), TyTagged(tb, y))
)

pub theorem tag2_ok(
  j: Nat,
  hu: FitsU(j),
  c: Checker,
  ta: List(Text),
  x: Ty,
  tb: List(Text),
  y: Ty,
  e: Bool
): Tag2Ok(j, c, ta, x, tb, y, e) {
  match e {
    true => (ht: tags_subset(tb, ta) = true) => post_after(
      c,
      ck_off(c),
      ck_rewrap1(ck_fits_in(j, ck_off(c), x, y)),
      (c2: Checker) => SubAt(c2, TyTagged(ta, x), TyTagged(tb, y)),
      (o: CkOrdered(c)) => grows_refl(c, o),
      post_map(
        ck_off(c),
        ck_fits_in(j, ck_off(c), x, y),
        (c2: Checker) => SubAt(c2, x, y),
        (c2: Checker) => SubAt(c2, TyTagged(ta, x), TyTagged(tb, y)),
        (c2: Checker, h: SubAt(c2, x, y)) => sub_tagged_at(c2, ta, x, tb, y, ht, h),
        hu(ck_off(c), x, y)
      )
    )
    false => (ht: tags_subset(tb, ta) = false) => unify_sub(c, TyTagged(ta, x), TyTagged(tb, y))
  }
}

pub def Fn2Ok(
  j: Nat,
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  e: Bool
): Prop := (
  Bool::and(Nat::eq(list_len(pa), list_len(pb)), kind_fits(ka, kb)) = e
) -> Post(
  c,
  ck_fn2_c(j, c, pa, ra, ka, pb, rb, kb, e),
  (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyFn(pb, rb, kb))
)

pub theorem fn2_ok(
  j: Nat,
  hu: FitsU(j),
  hp: FitsP(j),
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  e: Bool
): Fn2Ok(j, c, pa, ra, ka, pb, rb, kb, e) {
  match e {
    true => (hk: Bool::and(Nat::eq(list_len(pa), list_len(pb)), kind_fits(ka, kb)) = true) => post_after(
      c,
      ck_off(c),
      ck_and((c2: Checker) => ck_fits_in(j, c2, ra, rb), ck_fits_params_in(j, ck_off(c), pa, pb)),
      (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyFn(pb, rb, kb)),
      (o: CkOrdered(c)) => grows_refl(c, o),
      post_seq(
        ck_off(c),
        ck_fits_params_in(j, ck_off(c), pa, pb),
        (c2: Checker) => SubLenAt(c2, pa, pb),
        (c2: Checker) => ck_fits_in(j, c2, ra, rb),
        (c2: Checker) => SubAt(c2, ra, rb),
        (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyFn(pb, rb, kb)),
        mono_len_sub(pa, pb),
        hp(ck_off(c), pa, pb),
        (c2: Checker) => hu(c2, ra, rb),
        (c2: Checker, h1: SubLenAt(c2, pa, pb), h2: SubAt(c2, ra, rb)) => sub_fn_at(
          c2,
          pa,
          pb,
          ra,
          rb,
          ka,
          kb,
          ck_bool_and_right(Nat::eq(list_len(pa), list_len(pb)), kind_fits(ka, kb), hk),
          h1(ck_bool_and_left(Nat::eq(list_len(pa), list_len(pb)), kind_fits(ka, kb), hk)),
          h2
        )
      )
    )
    false => (hk: Bool::and(Nat::eq(list_len(pa), list_len(pb)), kind_fits(ka, kb)) = false) => unify_sub(
      c,
      TyFn(pa, ra, ka),
      TyFn(pb, rb, kb)
    )
  }
}

pub theorem lend_cases(
  j: Nat,
  hu: FitsU(j),
  c: Checker,
  x: Ty,
  ma: Bool,
  b1: Ty,
  b: Ty,
  eb: b1 = b
): Post(c, ck_fits_lend_in(Succ(j), c, x, ma, b), (c2: Checker) => SubAt(c2, TyBorrow(x, ma), b1)) {
  ⊢ Post(
    c,
    ck_fits_lend_in(Succ(j), c, x, ma, b),
    (c2: Checker) => SubAt(c2, TyBorrow(x, ma), b1)
  ) from match b {
    TyBorrow(y, mb) => post_sub_eqs(
      c,
      ck_fits_lend_in(Succ(j), c, x, ma, TyBorrow(y, mb)),
      TyBorrow(x, ma),
      b1,
      Refl,
      eb,
      post_unf(
        c,
        ck_fits_lend_in(Succ(j), c, x, ma, TyBorrow(y, mb)),
        ck_borrow2_c(j, c, x, y, mb, Bool::or(Bool::eq(ma, mb), not(mb))),
        (c2: Checker) => SubAt(c2, TyBorrow(x, ma), TyBorrow(y, mb)),
        Refl,
        borrow2_ok(j, hu, c, x, ma, y, mb, Bool::or(Bool::eq(ma, mb), not(mb)))(Refl)
      )
    )
    _ => post_cases(
      c,
      (z: Ty, w: Ty) => ck_fits_lend_in(Succ(j), c, x, ma, w),
      (z: Ty, w: Ty) => ck_rewrap1(ck_fits_in(j, c, x, w)),
      (c2: Checker) => SubAt(c2, TyBorrow(x, ma), b1),
      b1,
      b1,
      eb,
      eb,
      Refl,
      post_map(
        c,
        ck_fits_in(j, c, x, b1),
        (c2: Checker) => SubAt(c2, x, b1),
        (c2: Checker) => SubAt(c2, TyBorrow(x, ma), b1),
        (c2: Checker, h: SubAt(c2, x, b1)) => sub_unborrow_at(c2, x, b1, ma, h),
        hu(c, x, b1)
      )
    )
  }
}

pub theorem borrow_cases(
  j: Nat,
  hle: FitsLe(j),
  hv: FitsV(j),
  c: Checker,
  a1: Ty,
  b1: Ty,
  a: Ty,
  b: Ty,
  ea: a1 = a,
  eb: b1 = b
): Post(c, ck_fits_borrow_in(Succ(j), c, a, b), (c2: Checker) => SubAt(c2, a1, b1)) {
  match a {
    TyBorrow(x, ma) => post_sub_eqs(
      c,
      ck_fits_borrow_in(Succ(j), c, TyBorrow(x, ma), b),
      a1,
      b1,
      ea,
      eb,
      post_unf(
        c,
        ck_fits_borrow_in(Succ(j), c, TyBorrow(x, ma), b),
        ck_rewrap1(ck_fits_lend_in(j, c, x, ma, b)),
        (c2: Checker) => SubAt(c2, TyBorrow(x, ma), b),
        Refl,
        post_map(
          c,
          ck_fits_lend_in(j, c, x, ma, b),
          (c2: Checker) => SubAt(c2, TyBorrow(x, ma), b),
          (c2: Checker) => SubAt(c2, TyBorrow(x, ma), b),
          (c2: Checker, h: SubAt(c2, TyBorrow(x, ma), b)) => h,
          hle(c, x, ma, b)
        )
      )
    )
    _ => post_cases(
      c,
      (z: Ty, w: Ty) => ck_fits_borrow_in(Succ(j), c, z, w),
      (z: Ty, w: Ty) => ck_rewrap1(ck_fits_value_in(j, c, z, w)),
      (c2: Checker) => SubAt(c2, a1, b1),
      a1,
      b1,
      ea,
      eb,
      Refl,
      post_map(
        c,
        ck_fits_value_in(j, c, a1, b1),
        (c2: Checker) => SubAt(c2, a1, b1),
        (c2: Checker) => SubAt(c2, a1, b1),
        (c2: Checker, h: SubAt(c2, a1, b1)) => h,
        hv(c, a1, b1)
      )
    )
  }
}

pub theorem untag_cases(
  j: Nat,
  hu: FitsU(j),
  c: Checker,
  ta: List(Text),
  x: Ty,
  b1: Ty,
  b: Ty,
  eb: b1 = b
): Post(c, ck_fits_untag_in(Succ(j), c, ta, x, b), (c2: Checker) => SubAt(c2, TyTagged(ta, x), b1)) {
  ⊢ Post(
    c,
    ck_fits_untag_in(Succ(j), c, ta, x, b),
    (c2: Checker) => SubAt(c2, TyTagged(ta, x), b1)
  ) from match b {
    TyTagged(tb, y) => post_sub_eqs(
      c,
      ck_fits_untag_in(Succ(j), c, ta, x, TyTagged(tb, y)),
      TyTagged(ta, x),
      b1,
      Refl,
      eb,
      post_unf(
        c,
        ck_fits_untag_in(Succ(j), c, ta, x, TyTagged(tb, y)),
        ck_tag2_c(j, c, ta, x, tb, y, tags_subset(tb, ta)),
        (c2: Checker) => SubAt(c2, TyTagged(ta, x), TyTagged(tb, y)),
        Refl,
        tag2_ok(j, hu, c, ta, x, tb, y, tags_subset(tb, ta))(Refl)
      )
    )
    _ => post_cases(
      c,
      (z: Ty, w: Ty) => ck_fits_untag_in(Succ(j), c, ta, x, w),
      (z: Ty, w: Ty) => ck_rewrap1(ck_fits_in(j, ck_off(c), x, w)),
      (c2: Checker) => SubAt(c2, TyTagged(ta, x), b1),
      b1,
      b1,
      eb,
      eb,
      Refl,
      post_after(
        c,
        ck_off(c),
        ck_rewrap1(ck_fits_in(j, ck_off(c), x, b1)),
        (c2: Checker) => SubAt(c2, TyTagged(ta, x), b1),
        (o: CkOrdered(c)) => grows_refl(c, o),
        post_map(
          ck_off(c),
          ck_fits_in(j, ck_off(c), x, b1),
          (c2: Checker) => SubAt(c2, x, b1),
          (c2: Checker) => SubAt(c2, TyTagged(ta, x), b1),
          (c2: Checker, h: SubAt(c2, x, b1)) => sub_untag_at(c2, ta, x, b1, h),
          hu(ck_off(c), x, b1)
        )
      )
    )
  }
}

pub def LentFnOk(
  j: Nat,
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  y: Ty,
  mb: Bool,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  e: Bool
): Prop := (kind_eq(ka, KindAffine) = true) -> (not(mb) = true) -> (
  TyEqAt(c, y, TyFn(pb, rb, kb))
) -> (Nat::eq(list_len(pa), list_len(pb)) = e) -> Post(
  c,
  ck_lentfn_c(j, c, pa, ra, ka, y, mb, pb, rb, e),
  (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyBorrow(y, mb))
)

pub theorem lentfn_ok(
  j: Nat,
  hu: FitsU(j),
  hp: FitsP(j),
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  y: Ty,
  mb: Bool,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  e: Bool
): LentFnOk(j, c, pa, ra, ka, y, mb, pb, rb, kb, e) {
  match e {
    true => (hk: kind_eq(ka, KindAffine) = true) => (hm: not(mb) = true) => (
      hy: TyEqAt(c, y, TyFn(pb, rb, kb))
    ) => (hl: Nat::eq(list_len(pa), list_len(pb)) = true) => (
      o: CkOrdered(c)
    ) => AndIntro(
      And::left(
        post_seq(
          c,
          ck_fits_params_in(j, c, pa, pb),
          (c2: Checker) => SubLenAt(c2, pa, pb),
          (c2: Checker) => ck_fits_in(j, c2, ra, rb),
          (c2: Checker) => SubAt(c2, ra, rb),
          (c2: Checker) => TyEqAt(c2, y, TyFn(pb, rb, kb)) -> SubAt(
            c2,
            TyFn(pa, ra, ka),
            TyBorrow(y, mb)
          ),
          mono_len_sub(pa, pb),
          hp(c, pa, pb),
          (c2: Checker) => hu(c2, ra, rb),
          (c2: Checker, h1: SubLenAt(c2, pa, pb), h2: SubAt(c2, ra, rb)) => (
            hy2: TyEqAt(c2, y, TyFn(pb, rb, kb))
          ) => sub_lend_fn_at(c2, pa, pb, ra, rb, y, ka, kb, mb, hk, hm, hy2, h1(hl), h2)
        )(o)
      ),
      (v: ck_val(
        ck_lentfn_c(j, c, pa, ra, ka, y, mb, pb, rb, true)
      ) = true) => And::right(
        post_seq(
          c,
          ck_fits_params_in(j, c, pa, pb),
          (c2: Checker) => SubLenAt(c2, pa, pb),
          (c2: Checker) => ck_fits_in(j, c2, ra, rb),
          (c2: Checker) => SubAt(c2, ra, rb),
          (c2: Checker) => TyEqAt(c2, y, TyFn(pb, rb, kb)) -> SubAt(
            c2,
            TyFn(pa, ra, ka),
            TyBorrow(y, mb)
          ),
          mono_len_sub(pa, pb),
          hp(c, pa, pb),
          (c2: Checker) => hu(c2, ra, rb),
          (c2: Checker, h1: SubLenAt(c2, pa, pb), h2: SubAt(c2, ra, rb)) => (
            hy2: TyEqAt(c2, y, TyFn(pb, rb, kb))
          ) => sub_lend_fn_at(c2, pa, pb, ra, rb, y, ka, kb, mb, hk, hm, hy2, h1(hl), h2)
        )(o)
      )(v)(
        tyeq_at_move(
          c,
          ck_st(ck_lentfn_c(j, c, pa, ra, ka, y, mb, pb, rb, true)),
          And::left(
            post_seq(
              c,
              ck_fits_params_in(j, c, pa, pb),
              (c2: Checker) => SubLenAt(c2, pa, pb),
              (c2: Checker) => ck_fits_in(j, c2, ra, rb),
              (c2: Checker) => SubAt(c2, ra, rb),
              (c2: Checker) => TyEqAt(c2, y, TyFn(pb, rb, kb)) -> SubAt(
                c2,
                TyFn(pa, ra, ka),
                TyBorrow(y, mb)
              ),
              mono_len_sub(pa, pb),
              hp(c, pa, pb),
              (c2: Checker) => hu(c2, ra, rb),
              (c2: Checker, h1: SubLenAt(c2, pa, pb), h2: SubAt(c2, ra, rb)) => (
                hy2: TyEqAt(c2, y, TyFn(pb, rb, kb))
              ) => sub_lend_fn_at(c2, pa, pb, ra, rb, y, ka, kb, mb, hk, hm, hy2, h1(hl), h2)
            )(o)
          ),
          y,
          TyFn(pb, rb, kb),
          hy
        )
      )
    )
    false => (hk: kind_eq(ka, KindAffine) = true) => (hm: not(mb) = true) => (
      hy: TyEqAt(c, y, TyFn(pb, rb, kb))
    ) => (hl: Nat::eq(list_len(pa), list_len(pb)) = false) => unify_sub(
      c,
      TyFn(pa, ra, ka),
      TyBorrow(y, mb)
    )
  }
}

pub theorem lent_ok(
  j: Nat,
  hu: FitsU(j),
  hp: FitsP(j),
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  y: Ty,
  mb: Bool,
  r: Ty,
  hk: kind_eq(ka, KindAffine) = true,
  hm: not(mb) = true,
  hy: TyEqAt(c, y, r)
): Post(
  c,
  ck_lent_c(j, c, pa, ra, ka, y, mb, r),
  (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyBorrow(y, mb))
) {
  ⊢ Post(
    c,
    ck_lent_c(j, c, pa, ra, ka, y, mb, r),
    (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyBorrow(y, mb))
  ) from match r {
    TyFn(pb, rb, kb) => lentfn_ok(
      j,
      hu,
      hp,
      c,
      pa,
      ra,
      ka,
      y,
      mb,
      pb,
      rb,
      kb,
      Nat::eq(list_len(pa), list_len(pb))
    )(hk)(hm)(hy)(Refl)
    _ => unify_sub(c, TyFn(pa, ra, ka), TyBorrow(y, mb))
  }
}

pub def LentbOk(
  j: Nat,
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  y: Ty,
  mb: Bool,
  e: Bool
): Prop := (Bool::and(not(mb), kind_eq(ka, KindAffine)) = e) -> Post(
  c,
  ck_lentb_c(j, c, pa, ra, ka, y, mb, e),
  (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyBorrow(y, mb))
)

pub theorem lentb_ok(
  j: Nat,
  hu: FitsU(j),
  hp: FitsP(j),
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  y: Ty,
  mb: Bool,
  e: Bool
): LentbOk(j, c, pa, ra, ka, y, mb, e) {
  match e {
    true => (hq: Bool::and(not(mb), kind_eq(ka, KindAffine)) = true) => lent_ok(
      j,
      hu,
      hp,
      c,
      pa,
      ra,
      ka,
      y,
      mb,
      ck_resolve(c, y),
      ck_bool_and_right(not(mb), kind_eq(ka, KindAffine), hq),
      ck_bool_and_left(not(mb), kind_eq(ka, KindAffine), hq),
      ty_resolve_eq(ck_steps_of(c), ck_subst_of(c), KeptOk(ck_kept_of(c)), y)
    )
    false => (hq: Bool::and(not(mb), kind_eq(ka, KindAffine)) = false) => unify_sub(
      c,
      TyFn(pa, ra, ka),
      TyBorrow(y, mb)
    )
  }
}

pub theorem fn_cases(
  j: Nat,
  hu: FitsU(j),
  hp: FitsP(j),
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  b1: Ty,
  b: Ty,
  eb: b1 = b
): Post(
  c,
  ck_fits_fn_in(Succ(j), c, pa, ra, ka, b),
  (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), b1)
) {
  ⊢ Post(
    c,
    ck_fits_fn_in(Succ(j), c, pa, ra, ka, b),
    (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), b1)
  ) from match b {
    TyFn(pb, rb, kb) => post_sub_eqs(
      c,
      ck_fits_fn_in(Succ(j), c, pa, ra, ka, TyFn(pb, rb, kb)),
      TyFn(pa, ra, ka),
      b1,
      Refl,
      eb,
      post_unf(
        c,
        ck_fits_fn_in(Succ(j), c, pa, ra, ka, TyFn(pb, rb, kb)),
        ck_fn2_c(
          j,
          c,
          pa,
          ra,
          ka,
          pb,
          rb,
          kb,
          Bool::and(Nat::eq(list_len(pa), list_len(pb)), kind_fits(ka, kb))
        ),
        (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyFn(pb, rb, kb)),
        Refl,
        fn2_ok(
          j,
          hu,
          hp,
          c,
          pa,
          ra,
          ka,
          pb,
          rb,
          kb,
          Bool::and(Nat::eq(list_len(pa), list_len(pb)), kind_fits(ka, kb))
        )(Refl)
      )
    )
    TyBorrow(y, mb) => post_sub_eqs(
      c,
      ck_fits_fn_in(Succ(j), c, pa, ra, ka, TyBorrow(y, mb)),
      TyFn(pa, ra, ka),
      b1,
      Refl,
      eb,
      post_unf(
        c,
        ck_fits_fn_in(Succ(j), c, pa, ra, ka, TyBorrow(y, mb)),
        ck_lentb_c(j, c, pa, ra, ka, y, mb, Bool::and(not(mb), kind_eq(ka, KindAffine))),
        (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), TyBorrow(y, mb)),
        Refl,
        lentb_ok(j, hu, hp, c, pa, ra, ka, y, mb, Bool::and(not(mb), kind_eq(ka, KindAffine)))(Refl)
      )
    )
    _ => post_cases(
      c,
      (z: Ty, w: Ty) => ck_fits_fn_in(Succ(j), c, pa, ra, ka, w),
      (z: Ty, w: Ty) => ck_rewrap1(ck_unify(c, TyFn(pa, ra, ka), w)),
      (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), b1),
      b1,
      b1,
      eb,
      eb,
      Refl,
      unify_sub(c, TyFn(pa, ra, ka), b1)
    )
  }
}

// ----- a product fitted by the types of its members -----

pub def ProdFitAt(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty)
): Prop := ProdFit(ck_subst_of(c), KeptOk(ck_kept_of(c)), xs, ys)

pub fn pair_fst(p: Ty × Ty): Ty {
  match p {
    #(a, ^b) => a
  }
}

pub fn pair_snd(p: Ty × Ty): Ty {
  match p {
    #(^a, b) => b
  }
}

// `found` pairs each of `ys` with a member of `xs`.
pub(open) inductive FoundIn(xs: List(Ty)): (List(Ty), List(Ty × Ty)) -> Prop {
  FoundNil: FoundIn(xs, Nil, Nil)
  FoundCons<y: Ty, ys: List(
    Ty
  ), p: Ty × Ty, rest: List(
    (Ty × Ty)
  )>(
    hin: TyIn(xs, pair_fst(p)),
    hy: pair_snd(p) = y,
    h: FoundIn(xs, ys, rest)
  ): FoundIn(xs, Cons(y, ys), Cons(p, rest))
}

// Each pair is two types made the same.
pub(open) inductive PairsEq(
  s: Ordmap(Nat, Ty),
  ok: (List(Text × Kind), Ordmap(Text, Ty), Ty, Ty) -> Prop
): (List(Ty × Ty)) -> Prop {
  PairsNil: PairsEq(s, ok, Nil)
  PairsCons<p: Ty × Ty, rest: List(
    (Ty × Ty)
  )>(
    h: TyEq(s, ok, pair_fst(p), pair_snd(p)),
    hs: PairsEq(s, ok, rest)
  ): PairsEq(s, ok, Cons(p, rest))
}

pub def PairsEqAt(
  c: Checker,
  found: List(Ty × Ty)
): Prop := PairsEq(ck_subst_of(c), KeptOk(ck_kept_of(c)), found)

pub theorem mono_tyeq(a: Ty, b: Ty): Mono((c: Checker) => TyEqAt(c, a, b)) {
  (c1: Checker, c2: Checker, g: Grows(c1, c2), h: TyEqAt(c1, a, b)) => tyeq_at_move(
    c1,
    c2,
    g,
    a,
    b,
    h
  )
}

pub theorem unify_found_ok(
  c: Checker,
  found: List(Ty × Ty)
): Post(c, ck_unify_found(c, found), (c2: Checker) => PairsEqAt(c2, found)) {
  match found {
    Nil => post_unf(
      c,
      ck_unify_found(c, Nil),
      mut1(true, c),
      (c2: Checker) => PairsEqAt(c2, Nil),
      Refl,
      post_true(c, (c2: Checker) => PairsEqAt(c2, Nil), PairsNil)
    )
    Cons(p, rest) => post_unf(
      c,
      ck_unify_found(c, Cons(p, rest)),
      ck_and((c2: Checker) => ck_unify_found(c2, rest), ck_unify(c, p.fst, p.snd)),
      (c2: Checker) => PairsEqAt(c2, Cons(p, rest)),
      Refl,
      post_seq(
        c,
        ck_unify(c, p.fst, p.snd),
        (c2: Checker) => TyEqAt(c2, p.fst, p.snd),
        (c2: Checker) => ck_unify_found(c2, rest),
        (c2: Checker) => PairsEqAt(c2, rest),
        (c2: Checker) => PairsEqAt(c2, Cons(p, rest)),
        mono_tyeq(p.fst, p.snd),
        ck_unify_ok(c, p.fst, p.snd),
        (c2: Checker) => unify_found_ok(c2, rest),
        (c2: Checker, h1: TyEqAt(c2, p.fst, p.snd), h2: PairsEqAt(c2, rest)) => PairsCons(h1, h2)
      )
    )
  }
}

pub theorem found_fit(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty),
  found: List(Ty × Ty),
  hf: FoundIn(xs, ys, found),
  he: PairsEqAt(c, found)
): ProdFitAt(c, xs, ys) {
  match hf {
    FoundNil => ProdNil
    FoundCons(y, ys1, p, rest, hin, hy, h) => ⊢ ProdFitAt(c, xs, Cons(y, ys1)) from match he {
      PairsCons(p1, rest1, h1, hs1) => ProdCons(
        p.fst,
        hin,
        Eq::subst((z: Ty) => TyEqAt(c, p.fst, z), hy, h1),
        found_fit(c, xs, ys1, rest, h, hs1)
      )
    }
  }
}

pub fn FindSpec(xs: List(Ty), o: Option(Ty)): Prop {
  match o {
    None => True
    Some(x) => TyIn(xs, x)
  }
}

pub theorem find_cons_spec(
  xs: List(Ty),
  x: Ty,
  same: Bool,
  rest: Option(Ty),
  hx: TyIn(xs, x),
  hr: FindSpec(xs, rest)
): FindSpec(xs, ck_find_cons(x, same, rest)) {
  match same {
    true => hx
    false => hr
  }
}

pub theorem find_spec(
  c: Checker,
  y: Ty,
  xs0: List(Ty),
  xs: List(Ty),
  pre: ∀ z: Ty. (TyIn(xs, z)) -> TyIn(xs0, z)
): FindSpec(xs0, ck_members_find(c, xs, y)) {
  match xs {
    Nil => Trivial
    Cons(x, rest) => find_cons_spec(
      xs0,
      x,
      ck_member_same(c, x, y),
      ck_members_find(c, rest, y),
      pre(x, InHere(x, rest)),
      find_spec(c, y, xs0, rest, (z: Ty, hz: TyIn(rest, z)) => pre(z, InThere(x, hz)))
    )
  }
}

pub fn PairsSpec(xs: List(Ty), ys: List(Ty), o: Option(List(Ty × Ty))): Prop {
  match o {
    None => True
    Some(f) => FoundIn(xs, ys, f)
  }
}

pub theorem pairs_cons_spec(
  xs: List(Ty),
  y: Ty,
  yrest: List(Ty),
  found: Option(Ty),
  rest: Option(List(Ty × Ty)),
  hf: FindSpec(xs, found),
  hr: PairsSpec(xs, yrest, rest)
): PairsSpec(xs, Cons(y, yrest), ck_pairs_cons(y, found, rest)) {
  match found {
    None => Trivial
    Some(x) => ⊢ PairsSpec(xs, Cons(y, yrest), ck_pairs_cons(y, Some(x), rest)) from match rest {
      None => Trivial
      Some(pairs) => FoundCons(hf, Refl, hr)
    }
  }
}

pub theorem pairs_spec(
  c: Checker,
  xs0: List(Ty),
  xs: List(Ty),
  ys: List(Ty),
  pre: ∀ z: Ty. (TyIn(xs, z)) -> TyIn(xs0, z)
): PairsSpec(xs0, ys, ck_members_pairs(c, xs, ys)) {
  match ys {
    Nil => FoundNil
    Cons(y, yrest) => pairs_cons_spec(
      xs0,
      y,
      yrest,
      ck_members_find(c, xs, y),
      ck_members_pairs(c, xs, yrest),
      find_spec(c, y, xs0, xs, pre),
      pairs_spec(c, xs0, xs, yrest, pre)
    )
  }
}

pub fn ck_fit_some(c: Checker, f: List(Ty × Ty), e: Bool): Mut1(Bool, Checker) {
  match e {
    true => mut1(false, c)
    false => ck_rewrap1(ck_unify_found(c, f))
  }
}

pub theorem fit_some_ok(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty),
  f: List(Ty × Ty),
  e: Bool,
  hf: FoundIn(xs, ys, f)
): Post(c, ck_fit_some(c, f, e), (c2: Checker) => ProdFitAt(c2, xs, ys)) {
  match e {
    true => post_false(c, (c2: Checker) => ProdFitAt(c2, xs, ys))
    false => post_map(
      c,
      ck_unify_found(c, f),
      (c2: Checker) => PairsEqAt(c2, f),
      (c2: Checker) => ProdFitAt(c2, xs, ys),
      (c2: Checker, h: PairsEqAt(c2, f)) => found_fit(c2, xs, ys, f, hf, h),
      unify_found_ok(c, f)
    )
  }
}

pub theorem fit_found_ok(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty),
  found: Option(List(Ty × Ty)),
  spec: PairsSpec(xs, ys, found)
): Post(c, ck_fit_found(c, found), (c2: Checker) => ProdFitAt(c2, xs, ys)) {
  match found {
    None => post_unf(
      c,
      ck_fit_found(c, None),
      mut1(false, c),
      (c2: Checker) => ProdFitAt(c2, xs, ys),
      Refl,
      post_false(c, (c2: Checker) => ProdFitAt(c2, xs, ys))
    )
    Some(f) => post_unf(
      c,
      ck_fit_found(c, Some(f)),
      ck_fit_some(c, f, ck_members_repeat(c, ck_pairs_firsts(f))),
      (c2: Checker) => ProdFitAt(c2, xs, ys),
      Refl,
      fit_some_ok(c, xs, ys, f, ck_members_repeat(c, ck_pairs_firsts(f)), spec)
    )
  }
}

pub fn ck_fit_c(c: Checker, xs: List(Ty), ys: List(Ty), e1: Bool, e2: Bool): Mut1(Bool, Checker) {
  match e1 {
    true => mut1(false, c)
    false => ⊢ Mut1(Bool, Checker) from match e2 {
      true => mut1(false, c)
      false => ck_rewrap1(ck_fit_found(c, ck_members_pairs(c, xs, ys)))
    }
  }
}

pub theorem fit_c_ok(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty),
  e1: Bool,
  e2: Bool
): Post(c, ck_fit_c(c, xs, ys, e1, e2), (c2: Checker) => ProdFitAt(c2, xs, ys)) {
  match e1 {
    true => post_false(c, (c2: Checker) => ProdFitAt(c2, xs, ys))
    false => ⊢ Post(
      c,
      ck_fit_c(c, xs, ys, false, e2),
      (c2: Checker) => ProdFitAt(c2, xs, ys)
    ) from match e2 {
      true => post_false(c, (c2: Checker) => ProdFitAt(c2, xs, ys))
      false => post_map(
        c,
        ck_fit_found(c, ck_members_pairs(c, xs, ys)),
        (c2: Checker) => ProdFitAt(c2, xs, ys),
        (c2: Checker) => ProdFitAt(c2, xs, ys),
        (c2: Checker, h: ProdFitAt(c2, xs, ys)) => h,
        fit_found_ok(
          c,
          xs,
          ys,
          ck_members_pairs(c, xs, ys),
          pairs_spec(c, xs, xs, ys, (z: Ty, h: TyIn(xs, z)) => h)
        )
      )
    }
  }
}

pub theorem fit_by_types_ok(
  c: Checker,
  xs: List(Ty),
  ys: List(Ty)
): Post(c, ck_fit_by_types(c, xs, ys), (c2: Checker) => ProdFitAt(c2, xs, ys)) {
  post_unf(
    c,
    ck_fit_by_types(c, xs, ys),
    ck_fit_c(
      c,
      xs,
      ys,
      Bool::or(ck_members_open(c, xs), ck_members_open(c, ys)),
      Bool::or(ck_members_repeat(c, xs), ck_members_repeat(c, ys))
    ),
    (c2: Checker) => ProdFitAt(c2, xs, ys),
    Refl,
    fit_c_ok(
      c,
      xs,
      ys,
      Bool::or(ck_members_open(c, xs), ck_members_open(c, ys)),
      Bool::or(ck_members_repeat(c, xs), ck_members_repeat(c, ys))
    )
  )
}

pub fn ck_product_w(c: Checker, a: Ty, xs: List(Ty), b: Ty, w: Bool): Mut1(Bool, Checker) {
  match w {
    true => ck_or(
      (c2: Checker) => ck_fit_by_types(c2, xs, ty_wanted_members(b)),
      ck_attempt_unify(c, a, b)
    )
    false => ck_rewrap1(ck_unify(c, a, b))
  }
}

pub theorem product_w_ok(
  c: Checker,
  xs: List(Ty),
  b: Ty,
  w: Bool
): Post(c, ck_product_w(c, TyProduct(xs), xs, b, w), (c2: Checker) => SubAt(c2, TyProduct(xs), b)) {
  ⊢ Post(
    c,
    ck_product_w(c, TyProduct(xs), xs, b, w),
    (c2: Checker) => SubAt(c2, TyProduct(xs), b)
  ) from match w {
    true => post_or(
      c,
      ck_attempt_unify(c, TyProduct(xs), b),
      (c2: Checker) => SubAt(c2, TyProduct(xs), b),
      (c2: Checker) => ck_fit_by_types(c2, xs, ty_wanted_members(b)),
      (c2: Checker) => ProdFitAt(c2, xs, ty_wanted_members(b)),
      (c2: Checker) => SubAt(c2, TyProduct(xs), b),
      attempt_unify_sub(c, TyProduct(xs), b),
      (c2: Checker) => fit_by_types_ok(c2, xs, ty_wanted_members(b)),
      (c3: Checker, h: SubAt(c3, TyProduct(xs), b)) => h,
      (c3: Checker, h: ProdFitAt(c3, xs, ty_wanted_members(b))) => TysubProduct(h)
    )
    false => unify_sub(c, TyProduct(xs), b)
  }
}

pub theorem fits_product_ok(
  c: Checker,
  xs: List(Ty),
  b: Ty
): Post(c, ck_fits_product(c, TyProduct(xs), xs, b), (c2: Checker) => SubAt(c2, TyProduct(xs), b)) {
  post_unf(
    c,
    ck_fits_product(c, TyProduct(xs), xs, b),
    ck_product_w(c, TyProduct(xs), xs, b, ck_widen_of(c)),
    (c2: Checker) => SubAt(c2, TyProduct(xs), b),
    Refl,
    product_w_ok(c, xs, b, ck_widen_of(c))
  )
}

pub theorem tagged_cases(
  j: Nat,
  hut: FitsUt(j),
  hf: FitsF(j),
  c: Checker,
  a1: Ty,
  b1: Ty,
  a: Ty,
  b: Ty,
  ea: a1 = a,
  eb: b1 = b
): Post(c, ck_fits_tagged_in(Succ(j), c, a, b), (c2: Checker) => SubAt(c2, a1, b1)) {
  match a {
    TyTagged(ta, x) => post_sub_eqs(
      c,
      ck_fits_tagged_in(Succ(j), c, TyTagged(ta, x), b),
      a1,
      b1,
      ea,
      eb,
      post_unf(
        c,
        ck_fits_tagged_in(Succ(j), c, TyTagged(ta, x), b),
        ck_rewrap1(ck_fits_untag_in(j, c, ta, x, b)),
        (c2: Checker) => SubAt(c2, TyTagged(ta, x), b),
        Refl,
        post_map(
          c,
          ck_fits_untag_in(j, c, ta, x, b),
          (c2: Checker) => SubAt(c2, TyTagged(ta, x), b),
          (c2: Checker) => SubAt(c2, TyTagged(ta, x), b),
          (c2: Checker, h: SubAt(c2, TyTagged(ta, x), b)) => h,
          hut(c, ta, x, b)
        )
      )
    )
    TyProduct(xs) => post_sub_eqs(
      c,
      ck_fits_tagged_in(Succ(j), c, TyProduct(xs), b),
      a1,
      b1,
      ea,
      eb,
      post_unf(
        c,
        ck_fits_tagged_in(Succ(j), c, TyProduct(xs), b),
        ck_rewrap1(ck_fits_product(c, TyProduct(xs), xs, b)),
        (c2: Checker) => SubAt(c2, TyProduct(xs), b),
        Refl,
        post_map(
          c,
          ck_fits_product(c, TyProduct(xs), xs, b),
          (c2: Checker) => SubAt(c2, TyProduct(xs), b),
          (c2: Checker) => SubAt(c2, TyProduct(xs), b),
          (c2: Checker, h: SubAt(c2, TyProduct(xs), b)) => h,
          fits_product_ok(c, xs, b)
        )
      )
    )
    TyFn(pa, ra, ka) => post_sub_eqs(
      c,
      ck_fits_tagged_in(Succ(j), c, TyFn(pa, ra, ka), b),
      a1,
      b1,
      ea,
      eb,
      post_unf(
        c,
        ck_fits_tagged_in(Succ(j), c, TyFn(pa, ra, ka), b),
        ck_rewrap1(ck_fits_fn_in(j, c, pa, ra, ka, b)),
        (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), b),
        Refl,
        post_map(
          c,
          ck_fits_fn_in(j, c, pa, ra, ka, b),
          (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), b),
          (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), b),
          (c2: Checker, h: SubAt(c2, TyFn(pa, ra, ka), b)) => h,
          hf(c, pa, ra, ka, b)
        )
      )
    )
    _ => post_cases(
      c,
      (z: Ty, w: Ty) => ck_fits_tagged_in(Succ(j), c, z, w),
      (z: Ty, w: Ty) => ck_rewrap1(ck_unify(c, z, w)),
      (c2: Checker) => SubAt(c2, a1, b1),
      a1,
      b1,
      ea,
      eb,
      Refl,
      unify_sub(c, a1, b1)
    )
  }
}

pub def FitsAll(
  k: Nat
): Prop := And(
  FitsU(k),
  And(
    FitsA(k),
    And(
      FitsPo(k),
      And(
        FitsL(k),
        And(
          FitsB(k),
          And(
            FitsLe(k),
            And(
              FitsV(k),
              And(
                FitsS(k),
                And(
                  FitsI(k),
                  And(
                    FitsT(k),
                    And(FitsUt(k), And(FitsF(k), And(FitsE(k), And(FitsY(k), FitsP(k)))))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

pub theorem fits_all(k: Nat): FitsAll(k) {
  match k {
    Zero => AndIntro(
      (c: Checker, a: Ty, b: Ty) => post_false(c, (c2: Checker) => SubAt(c2, a, b)),
      AndIntro(
        (c: Checker, a: Ty, b: Ty) => post_false(c, (c2: Checker) => SubAt(c2, a, b)),
        AndIntro(
          (c: Checker, a: Ty, b: Ty) => post_false(c, (c2: Checker) => SubAt(c2, a, b)),
          AndIntro(
            (c: Checker, a: Ty, b: Ty) => post_false(c, (c2: Checker) => SubAt(c2, a, b)),
            AndIntro(
              (c: Checker, a: Ty, b: Ty) => post_false(c, (c2: Checker) => SubAt(c2, a, b)),
              AndIntro(
                (c: Checker, x: Ty, ma: Bool, b: Ty) => post_false(
                  c,
                  (c2: Checker) => SubAt(c2, TyBorrow(x, ma), b)
                ),
                AndIntro(
                  (c: Checker, a: Ty, b: Ty) => post_false(c, (c2: Checker) => SubAt(c2, a, b)),
                  AndIntro(
                    (c: Checker, a: Ty, b: Ty) => post_false(c, (c2: Checker) => SubAt(c2, a, b)),
                    AndIntro(
                      (c: Checker, a: Ty, b: Ty) => post_false(c, (c2: Checker) => SubAt(c2, a, b)),
                      AndIntro(
                        (c: Checker, a: Ty, b: Ty) => post_false(
                          c,
                          (c2: Checker) => SubAt(c2, a, b)
                        ),
                        AndIntro(
                          (c: Checker, ta: List(Text), x: Ty, b: Ty) => post_false(
                            c,
                            (c2: Checker) => SubAt(c2, TyTagged(ta, x), b)
                          ),
                          AndIntro(
                            (c: Checker, pa: List(Ty), ra: Ty, ka: Kind, b: Ty) => post_false(
                              c,
                              (c2: Checker) => SubAt(c2, TyFn(pa, ra, ka), b)
                            ),
                            AndIntro(
                              (c: Checker, xs: List(Ty), b: Ty) => post_false(
                                c,
                                (c2: Checker) => SubEachAt(c2, b, xs)
                              ),
                              AndIntro(
                                (c: Checker, a: Ty, ys: List(Ty)) => post_false(
                                  c,
                                  (c2: Checker) => SubAnyAt(c2, a, ys)
                                ),
                                (c: Checker, pa: List(Ty), pb: List(Ty)) => post_false(
                                  c,
                                  (c2: Checker) => SubLenAt(c2, pa, pb)
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    Succ(j) => AndIntro(
      (c: Checker, a: Ty, b: Ty) => fits_step(
        j,
        And::left(And::right(And::right(fits_all(j)))),
        c,
        a,
        b
      ),
      AndIntro(
        (c: Checker, a: Ty, b: Ty) => attempt_step(j, And::left(fits_all(j)), c, a, b),
        AndIntro(
          (c: Checker, a: Ty, b: Ty) => poly_cases(
            j,
            And::left(fits_all(j)),
            And::left(And::right(And::right(And::right(fits_all(j))))),
            c,
            a,
            b,
            a,
            b,
            Refl,
            Refl
          ),
          AndIntro(
            (c: Checker, a: Ty, b: Ty) => inst_cases(
              j,
              And::left(fits_all(j)),
              And::left(And::right(And::right(And::right(And::right(fits_all(j)))))),
              c,
              a,
              b,
              a,
              b,
              Refl,
              Refl
            ),
            AndIntro(
              (c: Checker, a: Ty, b: Ty) => borrow_cases(
                j,
                And::left(And::right(And::right(And::right(And::right(And::right(fits_all(j))))))),
                And::left(
                  And::right(
                    And::right(And::right(And::right(And::right(And::right(fits_all(j))))))
                  )
                ),
                c,
                a,
                b,
                a,
                b,
                Refl,
                Refl
              ),
              AndIntro(
                (c: Checker, x: Ty, ma: Bool, b: Ty) => lend_cases(
                  j,
                  And::left(fits_all(j)),
                  c,
                  x,
                  ma,
                  b,
                  b,
                  Refl
                ),
                AndIntro(
                  (c: Checker, a: Ty, b: Ty) => value_cases(
                    j,
                    And::left(fits_all(j)),
                    And::left(
                      And::right(
                        And::right(
                          And::right(And::right(And::right(And::right(And::right(fits_all(j))))))
                        )
                      )
                    ),
                    c,
                    a,
                    b,
                    a,
                    b,
                    Refl,
                    Refl
                  ),
                  AndIntro(
                    (c: Checker, a: Ty, b: Ty) => shape_cases(
                      j,
                      And::left(
                        And::right(
                          And::right(
                            And::right(
                              And::right(
                                And::right(
                                  And::right(
                                    And::right(
                                      And::right(
                                        And::right(And::right(And::right(And::right(fits_all(j)))))
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      ),
                      And::left(
                        And::right(
                          And::right(
                            And::right(
                              And::right(
                                And::right(And::right(And::right(And::right(fits_all(j)))))
                              )
                            )
                          )
                        )
                      ),
                      c,
                      a,
                      b,
                      a,
                      b,
                      Refl,
                      Refl
                    ),
                    AndIntro(
                      (c: Checker, a: Ty, b: Ty) => into_cases(
                        j,
                        And::left(
                          And::right(
                            And::right(
                              And::right(
                                And::right(
                                  And::right(
                                    And::right(
                                      And::right(
                                        And::right(
                                          And::right(
                                            And::right(
                                              And::right(And::right(And::right(fits_all(j))))
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        ),
                        And::left(
                          And::right(
                            And::right(
                              And::right(
                                And::right(
                                  And::right(
                                    And::right(And::right(And::right(And::right(fits_all(j)))))
                                  )
                                )
                              )
                            )
                          )
                        ),
                        c,
                        a,
                        b,
                        a,
                        b,
                        Refl,
                        Refl
                      ),
                      AndIntro(
                        (c: Checker, a: Ty, b: Ty) => tagged_cases(
                          j,
                          And::left(
                            And::right(
                              And::right(
                                And::right(
                                  And::right(
                                    And::right(
                                      And::right(
                                        And::right(And::right(And::right(And::right(fits_all(j)))))
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          ),
                          And::left(
                            And::right(
                              And::right(
                                And::right(
                                  And::right(
                                    And::right(
                                      And::right(
                                        And::right(
                                          And::right(
                                            And::right(And::right(And::right(fits_all(j))))
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          ),
                          c,
                          a,
                          b,
                          a,
                          b,
                          Refl,
                          Refl
                        ),
                        AndIntro(
                          (c: Checker, ta: List(Text), x: Ty, b: Ty) => untag_cases(
                            j,
                            And::left(fits_all(j)),
                            c,
                            ta,
                            x,
                            b,
                            b,
                            Refl
                          ),
                          AndIntro(
                            (c: Checker, pa: List(Ty), ra: Ty, ka: Kind, b: Ty) => fn_cases(
                              j,
                              And::left(fits_all(j)),
                              And::right(
                                And::right(
                                  And::right(
                                    And::right(
                                      And::right(
                                        And::right(
                                          And::right(
                                            And::right(
                                              And::right(
                                                And::right(
                                                  And::right(
                                                    And::right(And::right(And::right(fits_all(j))))
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              ),
                              c,
                              pa,
                              ra,
                              ka,
                              b,
                              b,
                              Refl
                            ),
                            AndIntro(
                              (c: Checker, xs: List(Ty), b: Ty) => each_step(
                                j,
                                And::left(fits_all(j)),
                                And::left(
                                  And::right(
                                    And::right(
                                      And::right(
                                        And::right(
                                          And::right(
                                            And::right(
                                              And::right(
                                                And::right(
                                                  And::right(
                                                    And::right(And::right(And::right(fits_all(j))))
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                ),
                                c,
                                xs,
                                b
                              ),
                              AndIntro(
                                (c: Checker, a: Ty, ys: List(Ty)) => any_step(
                                  j,
                                  And::left(And::right(fits_all(j))),
                                  And::left(
                                    And::right(
                                      And::right(
                                        And::right(
                                          And::right(
                                            And::right(
                                              And::right(
                                                And::right(
                                                  And::right(
                                                    And::right(
                                                      And::right(
                                                        And::right(
                                                          And::right(And::right(fits_all(j)))
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  c,
                                  a,
                                  ys
                                ),
                                (c: Checker, pa: List(Ty), pb: List(Ty)) => params_step(
                                  j,
                                  And::left(fits_all(j)),
                                  And::right(
                                    And::right(
                                      And::right(
                                        And::right(
                                          And::right(
                                            And::right(
                                              And::right(
                                                And::right(
                                                  And::right(
                                                    And::right(
                                                      And::right(
                                                        And::right(
                                                          And::right(And::right(fits_all(j)))
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  c,
                                  pa,
                                  pb
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  }
}

pub theorem ck_fits_ok(
  c: Checker,
  a: Ty,
  b: Ty
): Post(c, ck_fits(c, a, b), (c2: Checker) => SubAt(c2, a, b)) {
  post_unf(
    c,
    ck_fits(c, a, b),
    ck_rewrap1(ck_fits_in(ck_steps_of(c), c, a, b)),
    (c2: Checker) => SubAt(c2, a, b),
    Refl,
    post_map(
      c,
      ck_fits_in(ck_steps_of(c), c, a, b),
      (c2: Checker) => SubAt(c2, a, b),
      (c2: Checker) => SubAt(c2, a, b),
      (c2: Checker, h: SubAt(c2, a, b)) => h,
      And::left(fits_all(ck_steps_of(c)))(c, a, b)
    )
  )
}

pub theorem ck_attempt_fits_ok(
  c: Checker,
  a: Ty,
  b: Ty
): Post(c, ck_attempt_fits(c, a, b), (c2: Checker) => SubAt(c2, a, b)) {
  post_unf(
    c,
    ck_attempt_fits(c, a, b),
    ck_rewrap1(ck_attempt_fits_in(ck_steps_of(c), c, a, b)),
    (c2: Checker) => SubAt(c2, a, b),
    Refl,
    post_map(
      c,
      ck_attempt_fits_in(ck_steps_of(c), c, a, b),
      (c2: Checker) => SubAt(c2, a, b),
      (c2: Checker) => SubAt(c2, a, b),
      (c2: Checker, h: SubAt(c2, a, b)) => h,
      And::left(And::right(fits_all(ck_steps_of(c))))(c, a, b)
    )
  )
}

// The state with products fitted by the types of their members, as `ck_expect` fits.
pub fn ck_on(c: Checker): Checker {
  ck_st(ck_widen_to(c, true))
}

pub theorem post_unwiden_on(
  c: Checker,
  m: Mut1(Bool, Checker),
  q: (Checker) -> Prop,
  hq: ∀ c2: Checker. ∀ w: Bool. (q(c2)) -> q(ck_st(ck_widen_to(c2, w))),
  h: Post(ck_on(c), m, q)
): Post(c, ck_unwiden_k(ck_widen_of(c), m), q) {
  match m {
    mut1(v, c2) => (o: CkOrdered(c)) => AndIntro(
      grows_trans(
        c,
        c2,
        ck_st(ck_widen_to(c2, ck_widen_of(c))),
        grows_trans(c, ck_on(c), c2, grows_refl(c, o), And::left(h(o))),
        grows_refl(c2, And::left(And::left(h(o))))
      ),
      (y: v = true) => hq(c2, ck_widen_of(c), And::right(h(o))(y))
    )
  }
}

pub theorem ck_fits_wide_ok(
  c: Checker,
  a: Ty,
  b: Ty
): Post(c, ck_fits_wide(c, a, b), (c2: Checker) => SubAt(c2, a, b)) {
  post_unf(
    c,
    ck_fits_wide(c, a, b),
    ck_unwiden_k(ck_widen_of(c), ck_fits(ck_on(c), a, b)),
    (c2: Checker) => SubAt(c2, a, b),
    Refl,
    post_unwiden_on(
      c,
      ck_fits(ck_on(c), a, b),
      (c2: Checker) => SubAt(c2, a, b),
      (c2: Checker, w: Bool, h: SubAt(c2, a, b)) => h,
      ck_fits_ok(ck_on(c), a, b)
    )
  )
}
