pub theorem inf_preds_missing_frame_errors(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  missing: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkErrorFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkErrorFrame(c, inf_preds_missing(w, rest, c, gs, preds, missing)) {
  ⊢ CkErrorFrame(c, inf_preds_missing(w, rest, c, gs, preds, missing)) from match missing {
    true => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        cat2(signature_constraint_class(w), " is not a class"),
        signature_constraint_span(w)
      ),
      ck_error_frame_errors(
        c,
        cat2(signature_constraint_class(w), " is not a class"),
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    false => inf_preds_kind_frame_errors(w, rest, c, gs, preds, inf_pred_kind(w), ih)
  }
}

pub theorem ck_instance_preds_frame_errors(
  ws: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text))
): CkErrorFrame(c, ck_instance_preds(ws, c, gs, preds)) {
  ⊢ CkErrorFrame(c, ck_instance_preds(ws, c, gs, preds)) from match ws {
    Nil => (clean_errors => clean_errors)
    Cons(w, rest) => Eq::subst(
      (z: Mut1(List(Pair(Text, Text)), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_preds_unf(w, rest, c, gs, preds)),
      inf_preds_missing_frame_errors(
        w,
        rest,
        c,
        gs,
        preds,
        signature_class_missing(c, w),
        next => ps => ck_instance_preds_frame_errors(rest, next, gs, ps)
      )
    )
  }
}

pub theorem inf_store_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  ctor: Text,
  g: SigGenerics,
  head: Ty,
  preds: List(Pair(Text, Text)),
  made: List(SurfaceFn)
): CkErrorFrame(c, inf_store(c, i, ctor, g, head, preds, made)) { (clean_errors => clean_errors) }

pub theorem inf_rest_duplicate_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Bool
): CkErrorFrame(
  c,
  inf_rest_duplicate(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
) {
  ⊢ CkErrorFrame(
    c,
    inf_rest_duplicate(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
  ) from match bad {
    true => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat3(inf_class(i), " already has an instance for ", ctor), inf_span(i)),
      ck_error_frame_errors(
        c,
        cat3(inf_class(i), " already has an instance for ", ctor),
        inf_span(i)
      ),
      ignored => c1 => (clean_errors => clean_errors)
    )
    false => error_frame_bind(
      List(Pair(Text, Text)),
      List(SurfaceFn),
      c,
      (preds: List(Pair(Text, Text)), c1: Checker) => frame_bind(
        Unit,
        List(SurfaceFn),
        (ignored1: Unit, c2: Checker) => frame_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info))
      ),
      ck_instance_preds(inf_wheres(i), c, inf_generics(i), Nil),
      ck_instance_preds_frame_errors(inf_wheres(i), c, inf_generics(i), Nil),
      preds => c1 => error_frame_bind(
        Unit,
        List(SurfaceFn),
        c1,
        (ignored1: Unit, c2: Checker) => frame_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info)),
        ck_instance_laws_frame_errors(inf_laws(i), Nil, c1, i, inf_info_decl(info)),
        ignored1 => c2 => error_frame_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          c2,
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          ),
          ck_instance_methods_frame_errors(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          ),
          made => c3 => error_frame_bind(
            Unit,
            List(SurfaceFn),
            c3,
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info)),
            ck_instance_extra_frame_errors(inf_methods(i), c3, i, inf_info_decl(info)),
            ignored2 => c4 => inf_store_frame_errors(c4, i, ctor, g, head, preds, made)
          )
        )
      )
    )
  }
}

pub theorem inf_rest_orphan_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Bool
): CkErrorFrame(
  c,
  inf_rest_orphan(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
) {
  ⊢ CkErrorFrame(
    c,
    inf_rest_orphan(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
  ) from match bad {
    true => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(
        c,
        cat5(
          inf_class(i),
          cat3("(", ctor, ")"),
          " must be in the tote of ",
          inf_class(i),
          cat2(" or of ", ctor)
        ),
        inf_span(i)
      ),
      ck_error_frame_errors(
        c,
        cat5(
          inf_class(i),
          cat3("(", ctor, ")"),
          " must be in the tote of ",
          inf_class(i),
          cat2(" or of ", ctor)
        ),
        inf_span(i)
      ),
      ignored => c1 => (clean_errors => clean_errors)
    )
    false => inf_rest_duplicate_frame_errors(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      inf_duplicate(c, i, ctor)
    )
  }
}

pub theorem ck_declare_instance_rest_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text
): CkErrorFrame(
  c,
  ck_declare_instance_rest(c, i, info, own_classes, own_types, out, g, head, ctor, shown)
) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
    Eq::sym(inf_rest_unf(c, i, info, own_classes, own_types, out, g, head, ctor, shown)),
    inf_rest_orphan_frame_errors(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      Bool::and(not(text_list_has(own_classes, inf_class(i))), not(text_list_has(own_types, ctor)))
    )
  )
}

pub theorem inf_head_message_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  ctor: Text,
  message: Option(Pair(Text, TySpan))
): CkErrorFrame(c, inf_head_message(c, i, info, own_classes, own_types, out, head, ctor, message)) {
  ⊢ CkErrorFrame(
    c,
    inf_head_message(c, i, info, own_classes, own_types, out, head, ctor, message)
  ) from match message {
    None => error_frame_rewrap(
      c,
      ck_declare_instance_rest(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      ),
      ck_declare_instance_rest_frame_errors(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      )
    )
    Some(m) => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, inf_message_text(m), inf_message_span(m)),
      ck_error_frame_errors(c, inf_message_text(m), inf_message_span(m)),
      ignored => c1 => (clean_errors => clean_errors)
    )
  }
}

pub theorem inf_head_ctor_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  found: Option(Text)
): CkErrorFrame(c, inf_head_ctor(c, i, info, own_classes, own_types, out, head, found)) {
  ⊢ CkErrorFrame(c, inf_head_ctor(c, i, info, own_classes, own_types, out, head, found)) from match found {
    None => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ck_error_frame_errors(
        c,
        "an instance head applies a type to distinct generics",
        inf_head_span(i)
      ),
      ignored => c1 => (clean_errors => clean_errors)
    )
    Some(ctor) => inf_head_message_frame_errors(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      head,
      ctor,
      ck_instance_head_message(c, i, info, head, ctor)
    )
  }
}

pub theorem inf_head_missing_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  missing: Option(Text)
): CkErrorFrame(c, inf_head_missing(c, i, info, own_classes, own_types, out, missing)) {
  ⊢ CkErrorFrame(
    c,
    inf_head_missing(c, i, info, own_classes, own_types, out, missing)
  ) from match missing {
    Some(name) => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(name, " does not appear in the head"), inf_head_span(i)),
      ck_error_frame_errors(c, cat2(name, " does not appear in the head"), inf_head_span(i)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    None => written_error_changed(
      c,
      frame_set_constructor_position(c, true),
      frame_bind(
        Ty,
        List(SurfaceFn),
        (head: Ty, c1: Checker) => inf_head_ctor(
          frame_set_constructor_position(c1, false),
          i,
          info,
          own_classes,
          own_types,
          out,
          head,
          ty_constructor(head)
        ),
        ck_written(frame_set_constructor_position(c, true), inf_head(i), signature_map(inf_gens(i)))
      ),
      frame_set_constructor_position_same_errors(c, true),
      error_frame_bind(
        Ty,
        List(SurfaceFn),
        frame_set_constructor_position(c, true),
        (head: Ty, c1: Checker) => inf_head_ctor(
          frame_set_constructor_position(c1, false),
          i,
          info,
          own_classes,
          own_types,
          out,
          head,
          ty_constructor(head)
        ),
        ck_written(
          frame_set_constructor_position(c, true),
          inf_head(i),
          signature_map(inf_gens(i))
        ),
        ck_written_frame_errors(
          frame_set_constructor_position(c, true),
          inf_head(i),
          signature_map(inf_gens(i))
        ),
        head => c1 => written_error_changed(
          c1,
          frame_set_constructor_position(c1, false),
          inf_head_ctor(
            frame_set_constructor_position(c1, false),
            i,
            info,
            own_classes,
            own_types,
            out,
            head,
            ty_constructor(head)
          ),
          frame_set_constructor_position_same_errors(c1, false),
          inf_head_ctor_frame_errors(
            frame_set_constructor_position(c1, false),
            i,
            info,
            own_classes,
            own_types,
            out,
            head,
            ty_constructor(head)
          )
        )
      )
    )
  }
}

pub theorem inf_head_shape_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  bad: Bool
): CkErrorFrame(c, inf_head_shape(c, i, info, own_classes, own_types, out, bad)) {
  ⊢ CkErrorFrame(c, inf_head_shape(c, i, info, own_classes, own_types, out, bad)) from match bad {
    true => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ck_error_frame_errors(
        c,
        "an instance head applies a type to distinct generics",
        inf_head_span(i)
      ),
      ignored => c1 => (clean_errors => clean_errors)
    )
    false => inf_head_missing_frame_errors(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      generic_not_in_head(inf_generics(i), inf_head(i))
    )
  }
}

pub theorem ck_declare_instance_at_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkErrorFrame(c, ck_declare_instance_at(c, i, info, own_classes, own_types, out)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
    Eq::sym(inf_at_unf(c, i, info, own_classes, own_types, out)),
    inf_head_shape_frame_errors(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      not(head_shape_ok(inf_head(i), inf_generics(i)))
    )
  )
}

pub theorem inf_class_lookup_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  o: Option(ClassInfo)
): CkErrorFrame(c, inf_class_lookup(c, i, own_classes, own_types, out, o)) {
  ⊢ CkErrorFrame(c, inf_class_lookup(c, i, own_classes, own_types, out, o)) from match o {
    None => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(inf_class(i), " is not a class"), inf_span(i)),
      ck_error_frame_errors(c, cat2(inf_class(i), " is not a class"), inf_span(i)),
      ignored => c1 => (clean_errors => clean_errors)
    )
    Some(info) => error_frame_rewrap(
      c,
      ck_declare_instance_at(c, i, info, own_classes, own_types, out),
      ck_declare_instance_at_frame_errors(c, i, info, own_classes, own_types, out)
    )
  }
}

pub theorem inf_class_structural_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  structural: Bool
): CkErrorFrame(c, inf_class_structural(c, i, own_classes, own_types, out, structural)) {
  ⊢ CkErrorFrame(
    c,
    inf_class_structural(c, i, own_classes, own_types, out, structural)
  ) from match structural {
    true => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(inf_class(i), " is structural and has no instances to write"), inf_span(i)),
      ck_error_frame_errors(
        c,
        cat2(inf_class(i), " is structural and has no instances to write"),
        inf_span(i)
      ),
      ignored => c1 => (clean_errors => clean_errors)
    )
    false => inf_class_lookup_frame_errors(c, i, own_classes, own_types, out, inf_class_get(c, i))
  }
}

pub theorem ck_declare_instance_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkErrorFrame(c, ck_declare_instance(c, i, own_classes, own_types, out)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
    Eq::sym(inf_declare_unf(c, i, own_classes, own_types, out)),
    inf_class_structural_frame_errors(
      c,
      i,
      own_classes,
      own_types,
      out,
      class_is_structural(inf_class(i))
    )
  )
}

pub theorem inf_list_cons_frame_errors(
  i: SurfaceInstance,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkErrorFrame(next, ck_declare_instances(rest, next, own_classes, own_types, fs))
): CkErrorFrame(c, inf_list_cons(i, rest, c, own_classes, own_types, out)) {
  error_frame_bind(
    List(SurfaceFn),
    List(SurfaceFn),
    c,
    (made: List(SurfaceFn), c1: Checker) => ck_rewrap1(
      ck_declare_instances(rest, c1, own_classes, own_types, made)
    ),
    ck_declare_instance(c, i, own_classes, own_types, out),
    ck_declare_instance_frame_errors(c, i, own_classes, own_types, out),
    made => c1 => error_frame_rewrap(
      c1,
      ck_declare_instances(rest, c1, own_classes, own_types, made),
      ih(c1, made)
    )
  )
}

pub theorem inf_list_step_errors(
  s: SurfaceStmt,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkErrorFrame(next, ck_declare_instances(rest, next, own_classes, own_types, fs))
): CkErrorFrame(c, ck_declare_instances(Cons(s, rest), c, own_classes, own_types, out)) {
  ⊢ CkErrorFrame(c, ck_declare_instances(Cons(s, rest), c, own_classes, own_types, out)) from match s {
    StLet(name, ty, value, borrow, mutable) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(
        inf_list_StLet_unf(name, ty, value, borrow, mutable, rest, c, own_classes, own_types, out)
      ),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StVar(name, ty, value, borrow) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StVar_unf(name, ty, value, borrow, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StModule(name, stmts, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StModule_unf(name, stmts, start, end, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StAssign(name, name_place, value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StAssign_unf(name, name_place, value, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StCalled(name_generates, value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StCalled_unf(name_generates, value, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StFn(f) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StFn_unf(f, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StTheorem(t) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StTheorem_unf(t, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StDef(t) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StDef_unf(t, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StMutual(stmts, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StMutual_unf(stmts, start, end, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StImport(path, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StImport_unf(path, start, end, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StInductive(i) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StInductive_unf(i, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StEffect(e) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StEffect_unf(e, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StStruct(d) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StStruct_unf(d, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StEnum(d) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StEnum_unf(d, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StExtern(abi, fns, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StExtern_unf(abi, fns, start, end, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StClass(cl) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StClass_unf(cl, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StInstance(i) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StInstance_unf(i, rest, c, own_classes, own_types, out)),
      inf_list_cons_frame_errors(i, rest, c, own_classes, own_types, out, ih)
    )
    StWhile(cond, body) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StWhile_unf(cond, body, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StReturn(value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StReturn_unf(value, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StExpr(value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StExpr_unf(value, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StOther(what, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_list_StOther_unf(what, start, end, rest, c, own_classes, own_types, out)),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StMacro(name, function, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(
        inf_list_StMacro_unf(name, function, start, end, rest, c, own_classes, own_types, out)
      ),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(
        inf_list_StAttributed_unf(
          attr_name,
          attr_arg,
          attr_generates,
          attr_stmt,
          rest,
          c,
          own_classes,
          own_types,
          out
        )
      ),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StSyntax(name, grammar, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(
        inf_list_StSyntax_unf(name, grammar, start, end, rest, c, own_classes, own_types, out)
      ),
      error_frame_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
  }
}

pub theorem ck_declare_instances_frame_errors(
  ss: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkErrorFrame(c, ck_declare_instances(ss, c, own_classes, own_types, out)) {
  ⊢ CkErrorFrame(c, ck_declare_instances(ss, c, own_classes, own_types, out)) from match ss {
    Nil => (clean_errors => clean_errors)
    Cons(s, rest) => inf_list_step_errors(
      s,
      rest,
      c,
      own_classes,
      own_types,
      out,
      next => fs => ck_declare_instances_frame_errors(rest, next, own_classes, own_types, fs)
    )
  }
}

pub theorem inf_declare_classes_frame_errors(
  c: Checker,
  program: List(SurfaceStmt)
): CkErrorFrame(c, inf_declare_classes(c, program)) {
  error_frame_bind(
    List(SurfaceClass),
    List(SurfaceFn),
    c,
    (declared: List(SurfaceClass), c1: Checker) => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c2: Checker) => frame_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1)
    ),
    ck_declare_class_list(program, c, stmts_type_names(program)),
    ck_declare_class_list_frame_errors(program, c, stmts_type_names(program)),
    declared => c1 => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c1,
      (ignored: Unit, c2: Checker) => frame_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1),
      ck_declare_methods_frame_errors(declared, c1),
      ignored => c2 => error_frame_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        c2,
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        ),
        ck_declare_instances_frame_errors(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        ),
        fs => c3 => (clean_errors => clean_errors)
      )
    )
  )
}

pub theorem ck_declare_classes_frame_errors(
  c: Checker,
  program: List(SurfaceStmt)
): CkErrorFrame(c, ck_declare_classes(c, program)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
    Eq::sym(inf_classes_unf(c, program)),
    inf_declare_classes_frame_errors(c, program)
  )
}
