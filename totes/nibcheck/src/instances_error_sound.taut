pub theorem inf_law_duplicate_frame_errors(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Bool,
  ih: ∀ ns: List(
    Text
  ). ∀ next: Checker. CkErrorFrame(next, ck_instance_laws(rest, ns, next, i, decl))
): CkErrorFrame(c, inf_law_duplicate(l, rest, seen, c, i, decl, bad)) {
  ⊢ CkErrorFrame(c, inf_law_duplicate(l, rest, seen, c, i, decl, bad)) from match bad {
    true => error_frame_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(
        c,
        cat3("the law ", cf_law_name(l), " of the instance is written twice"),
        cf_law_span(l)
      ),
      ck_error_frame_errors(
        c,
        cat3("the law ", cf_law_name(l), " of the instance is written twice"),
        cf_law_span(l)
      ),
      ignored => c1 => error_frame_rewrap(
        c1,
        ck_instance_laws(rest, seen, c1, i, decl),
        ih(seen, c1)
      )
    )
    false => error_frame_rewrap(
      c,
      ck_instance_laws(rest, Cons(cf_law_name(l), seen), c, i, decl),
      ih(Cons(cf_law_name(l), seen), c)
    )
  }
}

pub theorem inf_law_missing_frame_errors(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Bool,
  ih: ∀ ns: List(
    Text
  ). ∀ next: Checker. CkErrorFrame(next, ck_instance_laws(rest, ns, next, i, decl))
): CkErrorFrame(c, inf_law_missing(l, rest, seen, c, i, decl, bad)) {
  ⊢ CkErrorFrame(c, inf_law_missing(l, rest, seen, c, i, decl, bad)) from match bad {
    true => error_frame_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(c, cat3(inf_class(i), " has no law ", cf_law_name(l)), cf_law_span(l)),
      ck_error_frame_errors(c, cat3(inf_class(i), " has no law ", cf_law_name(l)), cf_law_span(l)),
      ignored => c1 => error_frame_rewrap(
        c1,
        ck_instance_laws(rest, seen, c1, i, decl),
        ih(seen, c1)
      )
    )
    false => inf_law_duplicate_frame_errors(
      l,
      rest,
      seen,
      c,
      i,
      decl,
      text_list_has(seen, cf_law_name(l)),
      ih
    )
  }
}

pub theorem ck_instance_laws_frame_errors(
  ls: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): CkErrorFrame(c, ck_instance_laws(ls, seen, c, i, decl)) {
  ⊢ CkErrorFrame(c, ck_instance_laws(ls, seen, c, i, decl)) from match ls {
    Nil => (clean_errors => clean_errors)
    Cons(l, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_laws_unf(l, rest, seen, c, i, decl)),
      inf_law_missing_frame_errors(
        l,
        rest,
        seen,
        c,
        i,
        decl,
        not(law_named(cf_class_laws(decl), cf_law_name(l))),
        ns => next => ck_instance_laws_frame_errors(rest, ns, next, i, decl)
      )
    )
  }
}

pub theorem inf_extra_cons_frame_errors(
  m: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ih: ∀ next: Checker. CkErrorFrame(next, ck_instance_extra(rest, next, i, decl))
): CkErrorFrame(c, inf_extra_cons(m, rest, c, i, decl)) {
  error_frame_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_extra(rest, c1, i, decl)),
    frame_error_if(
      c,
      cat3(inf_class(i), " has no method ", signature_name(m)),
      cf_method_span(m),
      not(method_names_have(cf_class_methods(decl), signature_name(m)))
    ),
    frame_error_if_ok_errors(
      c,
      cat3(inf_class(i), " has no method ", signature_name(m)),
      cf_method_span(m),
      not(method_names_have(cf_class_methods(decl), signature_name(m)))
    ),
    ignored => c1 => error_frame_rewrap(c1, ck_instance_extra(rest, c1, i, decl), ih(c1))
  )
}

pub theorem ck_instance_extra_frame_errors(
  ms: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): CkErrorFrame(c, ck_instance_extra(ms, c, i, decl)) {
  ⊢ CkErrorFrame(c, ck_instance_extra(ms, c, i, decl)) from match ms {
    Nil => (clean_errors => clean_errors)
    Cons(m, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_extra_unf(m, rest, c, i, decl)),
      inf_extra_cons_frame_errors(
        m,
        rest,
        c,
        i,
        decl,
        next => ck_instance_extra_frame_errors(rest, next, i, decl)
      )
    )
  }
}

pub theorem inf_same_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  head: Text,
  want: SurfaceFn
): CkErrorFrame(c, inf_same(c, i, got, scheme, expected, head, want)) {
  error_frame_bind(
    Scheme,
    Unit,
    c,
    (wanted: Scheme, c1: Checker) => frame_error_if(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    ),
    ck_signature(c, want),
    ck_signature_frame_errors(c, want),
    wanted => c1 => frame_error_if_ok_errors(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    )
  )
}

pub theorem ck_same_signature_frame_errors(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  param: Text,
  head: Text
): CkErrorFrame(c, ck_same_signature(c, i, got, scheme, expected, param, head)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkErrorFrame(c, z),
    Eq::sym(inf_same_unf(c, i, got, scheme, expected, param, head)),
    inf_same_frame_errors(c, i, got, scheme, expected, head, inf_want(i, got, expected, param))
  )
}

pub theorem inf_method_found_frame_errors(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  made: SurfaceFn,
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkErrorFrame(next, ck_instance_methods(rest, next, i, decl, ctor, shown, fs))
): CkErrorFrame(c, inf_method_found(e, rest, c, i, decl, ctor, shown, out, made)) {
  error_frame_bind(
    Scheme,
    List(SurfaceFn),
    c,
    (scheme: Scheme, c1: Checker) => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown)
    ),
    ck_signature(c, made),
    ck_signature_frame_errors(c, made),
    scheme => c1 => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c1,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown),
      ck_same_signature_frame_errors(c1, i, made, scheme, e, cf_class_param(decl), shown),
      ignored => c2 => written_error_changed(
        c2,
        cf_store_state(c2, made, scheme),
        ck_rewrap1(
          ck_instance_methods(
            rest,
            cf_store_state(c2, made, scheme),
            i,
            decl,
            ctor,
            shown,
            Cons(made, out)
          )
        ),
        cf_store_state_same_errors(c2, made, scheme),
        error_frame_rewrap(
          cf_store_state(c2, made, scheme),
          ck_instance_methods(
            rest,
            cf_store_state(c2, made, scheme),
            i,
            decl,
            ctor,
            shown,
            Cons(made, out)
          ),
          ih(cf_store_state(c2, made, scheme), Cons(made, out))
        )
      )
    )
  )
}

pub theorem inf_method_get_frame_errors(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  o: Option(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkErrorFrame(next, ck_instance_methods(rest, next, i, decl, ctor, shown, fs))
): CkErrorFrame(c, inf_method_get(e, rest, c, i, decl, ctor, shown, out, o)) {
  ⊢ CkErrorFrame(c, inf_method_get(e, rest, c, i, decl, ctor, shown, out, o)) from match o {
    None => error_frame_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(
        ck_instance_methods(rest, c1, i, decl, ctor, shown, out)
      ),
      ck_error(
        c,
        cat5(
          "the instance ",
          inf_class(i),
          cat3("(", shown, ")"),
          " does not define ",
          signature_name(e)
        ),
        inf_span(i)
      ),
      ck_error_frame_errors(
        c,
        cat5(
          "the instance ",
          inf_class(i),
          cat3("(", shown, ")"),
          " does not define ",
          signature_name(e)
        ),
        inf_span(i)
      ),
      ignored => c1 => error_frame_rewrap(
        c1,
        ck_instance_methods(rest, c1, i, decl, ctor, shown, out),
        ih(c1, out)
      )
    )
    Some(m) => inf_method_found_frame_errors(
      e,
      rest,
      c,
      i,
      decl,
      ctor,
      shown,
      out,
      inf_method_fn(i, ctor, m),
      ih
    )
  }
}

pub theorem ck_instance_methods_frame_errors(
  expected: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn)
): CkErrorFrame(c, ck_instance_methods(expected, c, i, decl, ctor, shown, out)) {
  ⊢ CkErrorFrame(c, ck_instance_methods(expected, c, i, decl, ctor, shown, out)) from match expected {
    Nil => (clean_errors => clean_errors)
    Cons(e, rest) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkErrorFrame(c, z),
      Eq::sym(inf_methods_unf(e, rest, c, i, decl, ctor, shown, out)),
      inf_method_get_frame_errors(
        e,
        rest,
        c,
        i,
        decl,
        ctor,
        shown,
        out,
        method_named(inf_methods(i), signature_name(e)),
        next => fs => ck_instance_methods_frame_errors(rest, next, i, decl, ctor, shown, fs)
      )
    )
  }
}

pub theorem inf_preds_dup_frame_errors(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  g: Text,
  dup: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkErrorFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkErrorFrame(c, inf_preds_dup(w, rest, c, gs, preds, g, dup)) {
  ⊢ CkErrorFrame(c, inf_preds_dup(w, rest, c, gs, preds, g, dup)) from match dup {
    true => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        cat5(signature_constraint_class(w), "(", g, ") is written twice", ""),
        signature_constraint_span(w)
      ),
      ck_error_frame_errors(
        c,
        cat5(signature_constraint_class(w), "(", g, ") is written twice", ""),
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    false => error_frame_rewrap(
      c,
      ck_instance_preds(
        rest,
        c,
        gs,
        Cons(Pair { fst: signature_constraint_class(w), snd: g }, preds)
      ),
      ih(c, Cons(Pair { fst: signature_constraint_class(w), snd: g }, preds))
    )
  }
}

pub theorem inf_preds_has_frame_errors(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  g: Text,
  has: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkErrorFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkErrorFrame(c, inf_preds_has(w, rest, c, gs, preds, g, has)) {
  ⊢ CkErrorFrame(c, inf_preds_has(w, rest, c, gs, preds, g, has)) from match has {
    true => inf_preds_dup_frame_errors(
      w,
      rest,
      c,
      gs,
      preds,
      g,
      preds_have(preds, signature_constraint_class(w), g),
      ih
    )
    false => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
  }
}

pub theorem inf_preds_kind_frame_errors(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  k: SurfaceKind,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkErrorFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkErrorFrame(c, inf_preds_kind(w, rest, c, gs, preds, k)) {
  ⊢ CkErrorFrame(c, inf_preds_kind(w, rest, c, gs, preds, k)) from match k {
    SkVar(g) => inf_preds_has_frame_errors(w, rest, c, gs, preds, g, text_list_has(gs, g), ih)
    SkNat(digits) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkText(value) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkBool(value) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkApp(head, args) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkPi(params, result, effects) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkExists(binder, domain, body) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkLam(params, body) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkUnion(parts) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkTagged(tag, value) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkIf(cond, then, otherwise) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkField(value, name) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkBlock(stmts) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => error_frame_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkPerform(op, args) => error_frame_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_frame_errors(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
