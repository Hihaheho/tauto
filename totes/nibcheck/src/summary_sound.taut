import "kind_sound.taut"
import std::Base
import std::Map
import std::MapLaws
import std::MapText
import std::Row
import std::Text
import "datas.taut"
import "ty.taut"
import "ty_eq.taut"
import std::prelude::Ord

// Summary construction preserves the declared floor and keeps holds inside
// the declaration's generics.

pub theorem summary_within_mem<g: Text, xs: List(
  Text
)>(m: Mem(Text, g, xs), ys: List(Text), h: texts_within(xs, ys) = true): Mem(Text, g, ys) {
  match m: Mem(Text, g, ys) {
    MemHere(t) => lht_sound(
      ys,
      g,
      And::left(Bool::and_split(list_has_text(ys, g), texts_within(t, ys), h))
    )
    MemThere(b, t, mr) => summary_within_mem(
      mr,
      ys,
      And::right(Bool::and_split(list_has_text(ys, b), texts_within(t, ys), h))
    )
  }
}

pub theorem summary_within_sound(
  xs: List(Text),
  ys: List(Text),
  h: texts_within(xs, ys) = true,
  g: Text,
  m: Mem(Text, g, xs)
): Mem(Text, g, ys) {
  summary_within_mem(m, ys, h)
}

pub theorem summary_ha_k(
  holds: List(Text),
  n: Text,
  gs: List(Text),
  b: Bool,
  sub: Sub(Text, holds, gs),
  hn: Mem(Text, n, gs)
): Sub(Text, ha_k(holds, n, b), gs) {
  match b: Sub(Text, ha_k(holds, n, b), gs) {
    true => sub
    false => g => m => match m: Mem(Text, g, gs) {
      MemHere(t) => hn
      MemThere(x, t, mr) => sub(g, mr)
    }
  }
}

pub theorem summary_ha(
  holds: List(Text),
  n: Text,
  gs: List(Text),
  sub: Sub(Text, holds, gs),
  hn: Mem(Text, n, gs)
): Sub(Text, holds_add(holds, n), gs) {
  Eq::subst(
    (z: List(Text)) => Sub(Text, z, gs),
    Eq::sym(ha_unf(holds, n)),
    summary_ha_k(holds, n, gs, list_has_text(holds, n), sub, hn)
  )
}

pub theorem summary_param(
  n: Text,
  pk: Kind,
  gs: List(Text),
  holds: List(Text),
  b: Bool,
  eb: list_has_text(gs, n) = b,
  sub: Sub(Text, holds, gs)
): Sub(Text, psnd(fkp_k(n, pk, holds, b)), gs) {
  match b: Sub(Text, psnd(fkp_k(n, pk, holds, b)), gs) {
    true => summary_ha(holds, n, gs, sub, lht_sound(gs, n, eb))
    false => sub
  }
}

pub theorem summary_decl(
  d: Datas,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text),
  o: Option(Data),
  sub: Sub(Text, holds, gs),
  ih: ∀ data: Data. Sub(
    Text,
    psnd(
      field_kind_list(
        d,
        args,
        false,
        generics_picked(dgen(data), dholds(data)),
        gs,
        Pair { fst: dbase(data), snd: holds }
      )
    ),
    gs
  )
): Sub(Text, psnd(fkd_k(d, args, gs, holds, o)), gs) {
  match o: Sub(Text, psnd(fkd_k(d, args, gs, holds, o)), gs) {
    None => sub
    Some(data) => ih(data)
  }
}

pub theorem summary_named(
  d: Datas,
  n: Text,
  args: List(Ty),
  gs: List(Text),
  holds: List(Text),
  b: Bool,
  eb: Bool::and(ty_no_args(args), list_has_text(gs, n)) = b,
  sub: Sub(Text, holds, gs),
  ih: Sub(Text, psnd(fkd_k(d, args, gs, holds, datas_decl(d, n))), gs)
): Sub(Text, psnd(fkn_k(d, n, args, gs, holds, b)), gs) {
  match b: Sub(Text, psnd(fkn_k(d, n, args, gs, holds, b)), gs) {
    true => summary_ha(
      holds,
      n,
      gs,
      sub,
      lht_sound(gs, n, And::right(Bool::and_split(ty_no_args(args), list_has_text(gs, n), eb)))
    )
    false => ih
  }
}

pub theorem summary_pick(
  d: Datas,
  t: Ty,
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  p: Bool,
  sub: Sub(Text, psnd(acc), gs),
  ih: Sub(Text, psnd(field_kind(d, t, gs, psnd(acc))), gs)
): Sub(Text, psnd(fkl_pick(d, t, gs, acc, p)), gs) {
  match p: Sub(Text, psnd(fkl_pick(d, t, gs, acc, p)), gs) {
    true => ih
    false => sub
  }
}

pub theorem summary_list_k(
  d: Datas,
  t: Ty,
  rest: List(Ty),
  every: Bool,
  picks: List(Bool),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  go: Bool,
  sub: Sub(Text, psnd(acc), gs),
  iht: Sub(Text, psnd(field_kind(d, t, gs, psnd(acc))), gs),
  ihr: ∀ a: Pair(
    Kind,
    List(Text)
  ). (
    Sub(Text, psnd(a), gs)
  ) -> Sub(Text, psnd(field_kind_list(d, rest, every, picks_tail(picks), gs, a)), gs)
): Sub(Text, psnd(fkl_k(d, t, rest, every, picks, gs, acc, go)), gs) {
  match go: Sub(Text, psnd(fkl_k(d, t, rest, every, picks, gs, acc, go)), gs) {
    false => sub
    true => ihr(
      fkl_pick(d, t, gs, acc, picks_head(every, picks)),
      summary_pick(d, t, gs, acc, picks_head(every, picks), sub, iht)
    )
  }
}

mutual {
  pub theorem summary_field_list(
    d: Datas,
    ts: List(Ty),
    every: Bool,
    picks: List(Bool),
    gs: List(Text),
    acc: Pair(Kind, List(Text)),
    sub: Sub(Text, psnd(acc), gs)
  ): Sub(Text, psnd(field_kind_list(d, ts, every, picks, gs, acc)), gs) {
    match ts: Sub(Text, psnd(field_kind_list(d, ts, every, picks, gs, acc)), gs) {
      Nil => sub
      Cons(t, rest) => Eq::subst(
        (z: Pair(Kind, List(Text))) => Sub(Text, psnd(z), gs),
        Eq::sym(fkl_unf(d, t, rest, every, picks, gs, acc)),
        summary_list_k(
          d,
          t,
          rest,
          every,
          picks,
          gs,
          acc,
          Bool::or(every, not(Nat::eq(list_len(picks), 0))),
          sub,
          summary_field(d, t, gs, psnd(acc), sub),
          a => sa => summary_field_list(d, rest, every, picks_tail(picks), gs, a, sa)
        )
      )
    }
  }

  pub theorem summary_field(
    d: Datas,
    t: Ty,
    gs: List(Text),
    holds: List(Text),
    sub: Sub(Text, holds, gs)
  ): Sub(Text, psnd(field_kind(d, t, gs, holds)), gs) {
    match t: Sub(Text, psnd(field_kind(d, t, gs, holds)), gs) {
      TyInt(w) => sub
      TyBool => sub
      TyText => sub
      TyUnit => sub
      TyNever => sub
      TyDecimal => sub
      TyFloat => sub
      TyFn(ps, r, k) => sub
      TyUnion(ts) => summary_field_list(
        d,
        ts,
        true,
        Nil(Bool),
        gs,
        Pair { fst: KindCopy, snd: holds },
        sub
      )
      TyProduct(ts) => summary_field_list(
        d,
        ts,
        true,
        Nil(Bool),
        gs,
        Pair { fst: KindCopy, snd: holds },
        sub
      )
      TyTagged(tags, x) => summary_field(d, x, gs, holds, sub)
      TyNamed(n, args) => Eq::subst(
        (z: Pair(Kind, List(Text))) => Sub(Text, psnd(z), gs),
        Eq::sym(fk_named_unf(d, n, args, gs, holds)),
        summary_named(
          d,
          n,
          args,
          gs,
          holds,
          Bool::and(ty_no_args(args), list_has_text(gs, n)),
          Refl,
          sub,
          summary_decl(
            d,
            args,
            gs,
            holds,
            datas_decl(d, n),
            sub,
            data => summary_field_list(
              d,
              args,
              false,
              generics_picked(dgen(data), dholds(data)),
              gs,
              Pair { fst: dbase(data), snd: holds },
              sub
            )
          )
        )
      )
      TyParam(n, pk) => Eq::subst(
        (z: Pair(Kind, List(Text))) => Sub(Text, psnd(z), gs),
        Eq::sym(fk_param_unf(d, n, pk, gs, holds)),
        summary_param(n, pk, gs, holds, list_has_text(gs, n), Refl, sub)
      )
      TyInfo(x) => sub
      TyBorrow(x, mu) => summary_field(d, x, gs, holds, sub)
      TyVar(v) => sub
      TyApp(h, x) => summary_field(
        d,
        x,
        gs,
        psnd(field_kind(d, h, gs, holds)),
        summary_field(d, h, gs, holds, sub)
      )
      TyPoly(ps, x) => sub
    }
  }
}

pub theorem summary_fields(
  d: Datas,
  fs: List(DataField),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  sub: Sub(Text, psnd(acc), gs)
): Sub(Text, psnd(fields_kind(d, fs, gs, acc)), gs) {
  match fs: Sub(Text, psnd(fields_kind(d, fs, gs, acc)), gs) {
    Nil => sub
    Cons(f, rest) => summary_fields(
      d,
      rest,
      gs,
      kind_pair_join(acc, field_kind(d, fty(f), gs, psnd(acc))),
      summary_field(d, fty(f), gs, psnd(acc), sub)
    )
  }
}

pub theorem summary_ctors(
  d: Datas,
  cs: List(DataCtor),
  gs: List(Text),
  acc: Pair(Kind, List(Text)),
  sub: Sub(Text, psnd(acc), gs)
): Sub(Text, psnd(ctors_kind(d, cs, gs, acc)), gs) {
  match cs: Sub(Text, psnd(ctors_kind(d, cs, gs, acc)), gs) {
    Nil => sub
    Cons(c, rest) => summary_ctors(
      d,
      rest,
      gs,
      fields_kind(d, cfields(c), gs, acc),
      summary_fields(d, cfields(c), gs, acc, sub)
    )
  }
}

// The floor conditions do not depend on other declarations.
pub def SummaryFloor(
  data: Data
): Prop := And(KLe(data_declared_kind(data), dbase(data)), And(RecOk(data), UnmentionedOk(data)))

pub fn summary_unmentioned_k(data: Data, g: Text, rest: List(Text), b: Bool): List(Text) {
  match b: List(Text) {
    true => generics_unmentioned(data, rest)
    false => Cons(g, generics_unmentioned(data, rest))
  }
}

pub theorem summary_unmentioned_unf(
  data: Data,
  g: Text,
  rest: List(Text)
): generics_unmentioned(data, Cons(g, rest)) = summary_unmentioned_k(data, g, rest, data_mentions(data, g)) { Refl }

pub theorem summary_unmentioned_head(
  data: Data,
  g: Text,
  rest: List(Text),
  b: Bool,
  e: b = false
): Mem(Text, g, summary_unmentioned_k(data, g, rest, b)) {
  match b: Mem(Text, g, summary_unmentioned_k(data, g, rest, b)) {
    true => False::elim(true_ne_false(e))
    false => MemHere(Text, g, generics_unmentioned(data, rest))
  }
}

pub theorem summary_unmentioned_tail(
  data: Data,
  x: Text,
  rest: List(Text),
  b: Bool,
  g: Text,
  m: Mem(Text, g, generics_unmentioned(data, rest))
): Mem(Text, g, summary_unmentioned_k(data, x, rest, b)) {
  match b: Mem(Text, g, summary_unmentioned_k(data, x, rest, b)) {
    true => m
    false => MemThere(Text, g, x, generics_unmentioned(data, rest), m)
  }
}

pub theorem summary_unmentioned(
  data: Data,
  gs: List(Text),
  g: Text,
  m: Mem(Text, g, gs),
  e: data_mentions(data, g) = false
): Mem(Text, g, generics_unmentioned(data, gs)) {
  match gs: Mem(Text, g, generics_unmentioned(data, gs)) {
    Nil => Mem::nil(Mem(Text, g, generics_unmentioned(data, Nil(Text))), m)
    Cons(x, rest) => match m: Mem(Text, g, generics_unmentioned(data, Cons(x, rest))) {
      MemHere(t) => Eq::subst(
        (z: List(Text)) => Mem(Text, x, z),
        Eq::sym(summary_unmentioned_unf(data, x, rest)),
        summary_unmentioned_head(data, x, rest, data_mentions(data, x), e)
      )
      MemThere(y, t, mr) => Eq::subst(
        (z: List(Text)) => Mem(Text, g, z),
        Eq::sym(summary_unmentioned_unf(data, x, rest)),
        summary_unmentioned_tail(
          data,
          x,
          rest,
          data_mentions(data, x),
          g,
          summary_unmentioned(data, rest, g, mr, e)
        )
      )
    }
  }
}

pub theorem summary_least(data: Data): SummaryFloor(data_least(data)) {
  match data: SummaryFloor(data_least(data)) {
    DataMk(n, declared, gs, cs, st, rec, base, holds, builtin, r#view) => match rec: SummaryFloor(
      data_least(DataMk(n, declared, gs, cs, st, rec, base, holds, builtin, r#view))
    ) {
      true => AndIntro(
        kle_join_l(
          data_declared_kind(DataMk(n, declared, gs, cs, st, true, base, holds, builtin, r#view)),
          KindShared
        ),
        AndIntro(
          e => kle_join_r(
            data_declared_kind(DataMk(n, declared, gs, cs, st, true, base, holds, builtin, r#view)),
            KindShared
          ),
          g => m => e => summary_unmentioned(
            DataMk(n, declared, gs, cs, st, true, base, holds, builtin, r#view),
            gs,
            g,
            m,
            e
          )
        )
      )
      false => AndIntro(
        kle_refl(
          data_declared_kind(DataMk(n, declared, gs, cs, st, false, base, holds, builtin, r#view))
        ),
        AndIntro(
          e => False::elim(false_ne_true(e)),
          g => m => e => summary_unmentioned(
            DataMk(n, declared, gs, cs, st, false, base, holds, builtin, r#view),
            gs,
            g,
            m,
            e
          )
        )
      )
    }
  }
}

pub theorem summary_floor_grow(
  data: Data,
  base: Kind,
  holds: List(Text),
  floor: SummaryFloor(data),
  kb: KLe(dbase(data), base),
  hs: Sub(Text, dholds(data), holds)
): SummaryFloor(data_with_summary(data, base, holds)) {
  match data: SummaryFloor(data_with_summary(data, base, holds)) {
    DataMk(n, declared, gs, cs, st, rec, old, oldholds, builtin, r#view) => AndIntro(
      kle_trans(
        data_declared_kind(DataMk(n, declared, gs, cs, st, rec, old, oldholds, builtin, r#view)),
        old,
        base,
        And::left(floor),
        kb
      ),
      AndIntro(
        e => kle_trans(KindShared, old, base, And::left(And::right(floor))(e), kb),
        g => m => e => hs(g, And::right(And::right(floor))(g, m, e))
      )
    )
  }
}

// Even when fuel runs out, every field is bounded by the top summary.
pub theorem summary_top(d: Datas, data: Data): DataOk(d, data_top(data)) {
  match data: DataOk(d, data_top(data)) {
    DataMk(n, declared, gs, cs, st, rec, base, holds, builtin, r#view) => AndIntro(
      kle_linear(pfst(ctors_kind(d, cs, gs, Pair { fst: KindLinear, snd: gs }))),
      AndIntro(
        summary_ctors(d, cs, gs, Pair { fst: KindLinear, snd: gs }, Sub::refl(gs)),
        AndIntro(
          kle_linear(
            data_declared_kind(DataMk(n, declared, gs, cs, st, rec, base, holds, builtin, r#view))
          ),
          AndIntro(e => kle_linear(KindShared), g => m => e => m)
        )
      )
    )
  }
}

pub def SummaryStable(
  d: Datas,
  data: Data
): Prop := And(
  KLe(
    pfst(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) })),
    dbase(data)
  ),
  HoldsOk(d, data)
)

pub fn summary_update(d: Datas, n: Text, data: Data): Datas {
  let r := ctors_kind(d, data.constructors, data.generics, Pair { fst: data.base, snd: data.holds })
  datas_with_decls(
    d,
    Ordmap::insert(
      d.decls,
      n,
      data_with_summary(data, kind_join(data.base, r.fst), r.snd),
      Ordmap::compare_text
    )
  )
}

pub fn summary_test(d: Datas, data: Data): Bool {
  let r := ctors_kind(d, data.constructors, data.generics, Pair { fst: data.base, snd: data.holds })
  Bool::and(kind_eq(kind_join(data.base, r.fst), data.base), texts_within(r.snd, data.holds))
}

pub theorem summary_test_sound(
  d: Datas,
  data: Data,
  h: summary_test(d, data) = true
): SummaryStable(d, data) {
  let r: Pair(
    Kind,
    List(Text)
  ) := ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) })
  let eqbase: kind_join(dbase(data), pfst(r)) = dbase(data) := kind_rank_inj(
    kind_join(dbase(data), pfst(r)),
    dbase(data),
    Nat::eq_sound(
      kind_rank(kind_join(dbase(data), pfst(r))),
      kind_rank(dbase(data)),
      And::left(
        Bool::and_split(
          kind_eq(kind_join(dbase(data), pfst(r)), dbase(data)),
          texts_within(psnd(r), dholds(data)),
          h
        )
      )
    )
  )
  AndIntro(
    Eq::subst((z: Kind) => KLe(pfst(r), z), eqbase, kle_join_r(dbase(data), pfst(r))),
    g => m => summary_within_sound(
      psnd(r),
      dholds(data),
      And::right(
        Bool::and_split(
          kind_eq(kind_join(dbase(data), pfst(r)), dbase(data)),
          texts_within(psnd(r), dholds(data)),
          h
        )
      ),
      g,
      m
    )
  )
}

pub theorem summary_update_floor(
  d: Datas,
  data: Data,
  floor: SummaryFloor(data)
): SummaryFloor(
  data_with_summary(
    data,
    kind_join(
      dbase(data),
      pfst(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) }))
    ),
    psnd(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) }))
  )
) {
  summary_floor_grow(
    data,
    kind_join(
      dbase(data),
      pfst(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) }))
    ),
    psnd(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) })),
    floor,
    kle_join_l(
      dbase(data),
      pfst(ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) }))
    ),
    g => m => ctors_grow(
      d,
      dctors(data),
      dgen(data),
      Pair { fst: dbase(data), snd: dholds(data) },
      g,
      m
    )
  )
}

pub fn summary_round_test(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  data: Data,
  b: Bool
): Pair(Datas, Bool) {
  match b: Pair(Datas, Bool) {
    true => datas_round(rest, d, grew)
    false => datas_round(rest, summary_update(d, n, data), true)
  }
}

pub fn summary_round_decl(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  o: Option(Data)
): Pair(Datas, Bool) {
  match o: Pair(Datas, Bool) {
    None => datas_round(rest, d, grew)
    Some(data) => summary_round_test(rest, d, grew, n, data, summary_test(d, data))
  }
}

pub fn summary_key(e: Pair(Text, Data)): Text { e.fst }
pub fn summary_result(r: Pair(Datas, Bool)): Datas { r.fst }
pub fn summary_grew(r: Pair(Datas, Bool)): Bool { r.snd }

pub theorem summary_round_unf(
  e: Pair(Text, Data),
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool
): datas_round(Cons(e, rest), d, grew) = summary_round_decl(rest, d, grew, summary_key(e), datas_decl(d, summary_key(e))) { Refl }

// A round can never clear an earlier growth flag.
pub def SummaryFlag(
  grew: Bool,
  r: Pair(Datas, Bool)
): Prop := (summary_grew(r) = false) -> (grew = false)

pub theorem summary_flag_test(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  data: Data,
  b: Bool,
  ih: ∀ dd: Datas. ∀ gg: Bool. SummaryFlag(gg, datas_round(rest, dd, gg))
): SummaryFlag(grew, summary_round_test(rest, d, grew, n, data, b)) {
  match b: SummaryFlag(grew, summary_round_test(rest, d, grew, n, data, b)) {
    true => ih(d, grew)
    false => h => False::elim(true_ne_false(ih(summary_update(d, n, data), true, h)))
  }
}

pub theorem summary_flag_decl(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  o: Option(Data),
  ih: ∀ dd: Datas. ∀ gg: Bool. SummaryFlag(gg, datas_round(rest, dd, gg))
): SummaryFlag(grew, summary_round_decl(rest, d, grew, n, o)) {
  match o: SummaryFlag(grew, summary_round_decl(rest, d, grew, n, o)) {
    None => ih(d, grew)
    Some(data) => summary_flag_test(rest, d, grew, n, data, summary_test(d, data), ih)
  }
}

pub theorem summary_round_flag(
  es: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  h: summary_grew(datas_round(es, d, grew)) = false
): grew = false {
  match es: grew = false {
    Nil => h
    Cons(e, rest) => Eq::subst(
      (z: Pair(Datas, Bool)) => SummaryFlag(grew, z),
      Eq::sym(summary_round_unf(e, rest, d, grew)),
      summary_flag_decl(
        rest,
        d,
        grew,
        summary_key(e),
        datas_decl(d, summary_key(e)),
        dd => gg => hh => summary_round_flag(rest, dd, gg, hh)
      )
    )(h)
  }
}

pub def SummaryUnchanged(
  d: Datas,
  r: Pair(Datas, Bool)
): Prop := (summary_grew(r) = false) -> (summary_result(r) = d)

pub theorem summary_unchanged_test(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  data: Data,
  b: Bool,
  ih: SummaryUnchanged(d, datas_round(rest, d, grew))
): SummaryUnchanged(d, summary_round_test(rest, d, grew, n, data, b)) {
  match b: SummaryUnchanged(d, summary_round_test(rest, d, grew, n, data, b)) {
    true => ih
    false => h => False::elim(true_ne_false(summary_round_flag(rest, summary_update(d, n, data), true, h)))
  }
}

pub theorem summary_unchanged_decl(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  o: Option(Data),
  ih: SummaryUnchanged(d, datas_round(rest, d, grew))
): SummaryUnchanged(d, summary_round_decl(rest, d, grew, n, o)) {
  match o: SummaryUnchanged(d, summary_round_decl(rest, d, grew, n, o)) {
    None => ih
    Some(data) => summary_unchanged_test(rest, d, grew, n, data, summary_test(d, data), ih)
  }
}

pub theorem summary_round_unchanged(
  es: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  h: summary_grew(datas_round(es, d, grew)) = false
): summary_result(datas_round(es, d, grew)) = d {
  match es: summary_result(datas_round(es, d, grew)) = d {
    Nil => Refl
    Cons(e, rest) => Eq::subst(
      (z: Pair(Datas, Bool)) => SummaryUnchanged(d, z),
      Eq::sym(summary_round_unf(e, rest, d, grew)),
      summary_unchanged_decl(
        rest,
        d,
        grew,
        summary_key(e),
        datas_decl(d, summary_key(e)),
        hh => summary_round_unchanged(rest, d, grew, hh)
      )
    )(h)
  }
}

pub def SummaryVisited(
  es: List(Pair(Text, Data)),
  d: Datas
): Prop := ∀ e: Pair(
  Text,
  Data
). ∀ data: Data. (
  Mem(Pair(Text, Data), e, es)
) -> (datas_decl(d, summary_key(e)) = Some(data)) -> SummaryStable(d, data)

pub def SummaryQuiet(
  es: List(Pair(Text, Data)),
  d: Datas,
  r: Pair(Datas, Bool)
): Prop := (summary_grew(r) = false) -> SummaryVisited(es, d)

pub theorem summary_visited_cons<e: Pair(
  Text,
  Data
), es: List(
  Pair(Text, Data)
), item: Pair(
  Text,
  Data
)>(
  m: Mem(Pair(Text, Data), item, Cons(e, es)),
  d: Datas,
  data: Data,
  hd: datas_decl(d, summary_key(item)) = Some(data),
  head: ∀ v: Data. (datas_decl(d, summary_key(e)) = Some(v)) -> SummaryStable(
    d,
    v
  ),
  tail: SummaryVisited(es, d)
): SummaryStable(d, data) {
  match m: SummaryStable(d, data) {
    MemHere(t) => head(data, hd)
    MemThere(b, t, mr) => tail(item, data, mr, hd)
  }
}

pub fn summary_some_default(a: Data, o: Option(Data)): Data {
  match o: Data {
    None => a
    Some(v) => v
  }
}
pub fn summary_is_some(o: Option(Data)): Bool {
  match o: Bool {
    None => false
    Some(v) => true
  }
}
pub theorem summary_some_inj(
  a: Data,
  b: Data,
  h: Some(a) = Some(b)
): a = b {
  Eq::congr((o: Option(Data)) => summary_some_default(a, o), h)
}
pub theorem summary_none_some(data: Data, h: None(Data) = Some(data)): False {
  false_ne_true(Eq::congr(summary_is_some, h))
}

pub theorem summary_quiet_test(
  e: Pair(Text, Data),
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  data: Data,
  hd: datas_decl(d, summary_key(e)) = Some(data),
  b: Bool,
  eb: summary_test(d, data) = b,
  ih: SummaryQuiet(rest, d, datas_round(rest, d, grew))
): SummaryQuiet(Cons(e, rest), d, summary_round_test(rest, d, grew, summary_key(e), data, b)) {
  match b: SummaryQuiet(
    Cons(e, rest),
    d,
    summary_round_test(rest, d, grew, summary_key(e), data, b)
  ) {
    true => h => item => v => m => hv => summary_visited_cons(
      m,
      d,
      v,
      hv,
      vv => hh => Eq::subst(
        (z: Data) => SummaryStable(d, z),
        summary_some_inj(data, vv, Eq::trans(Eq::sym(hd), hh)),
        summary_test_sound(d, data, eb)
      ),
      ih(h)
    )
    false => h => False::elim(
      true_ne_false(summary_round_flag(rest, summary_update(d, summary_key(e), data), true, h))
    )
  }
}

pub theorem summary_quiet_decl(
  e: Pair(Text, Data),
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  o: Option(Data),
  eo: datas_decl(d, summary_key(e)) = o,
  ih: SummaryQuiet(rest, d, datas_round(rest, d, grew))
): SummaryQuiet(Cons(e, rest), d, summary_round_decl(rest, d, grew, summary_key(e), o)) {
  match o: SummaryQuiet(Cons(e, rest), d, summary_round_decl(rest, d, grew, summary_key(e), o)) {
    None => h => item => v => m => hv => summary_visited_cons(
      m,
      d,
      v,
      hv,
      vv => hh => False::elim(summary_none_some(vv, Eq::trans(Eq::sym(eo), hh))),
      ih(h)
    )
    Some(data) => summary_quiet_test(e, rest, d, grew, data, eo, summary_test(d, data), Refl, ih)
  }
}

pub theorem summary_round_quiet(
  es: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  h: summary_grew(datas_round(es, d, grew)) = false
): SummaryVisited(es, d) {
  match es: SummaryVisited(es, d) {
    Nil => item => data => m => hd => Mem::nil(SummaryStable(d, data), m)
    Cons(e, rest) => Eq::subst(
      (z: Pair(Datas, Bool)) => SummaryQuiet(Cons(e, rest), d, z),
      Eq::sym(summary_round_unf(e, rest, d, grew)),
      summary_quiet_decl(
        e,
        rest,
        d,
        grew,
        datas_decl(d, summary_key(e)),
        Refl,
        hh => summary_round_quiet(rest, d, grew, hh)
      )
    )(h)
  }
}

// A lookup's key occurs in the map's enumeration, which is the worklist.
pub(open) inductive SummaryKey(n: Text): (List(Pair(Text, Data))) -> Prop {
  SummaryKeyHere(
    v: Data,
    rest: List(Pair(Text, Data))
  ): SummaryKey(n, Cons(Pair { fst: n, snd: v }, rest))
  SummaryKeyThere(
    e: Pair(Text, Data),
    rest: List(Pair(Text, Data)),
    h: SummaryKey(n, rest)
  ): SummaryKey(n, Cons(e, rest))
}

pub fn summary_decls(d: Datas): Ordmap(Text, Data) { d.decls }

pub def SummaryOrdered(d: Datas): Prop := Ordmap::ordered(summary_decls(d), Ordmap::compare_text)
pub def SummaryAll(
  m: Ordmap(Text, Data),
  p: (Data) -> Prop
): Prop := ∀ n: Text. ∀ v: Data. (
  Ordmap::get(m, n, Ordmap::compare_text) = Some(v)
) -> p(v)
pub def SummaryPending(
  es: List(Pair(Text, Data)),
  m: Ordmap(Text, Data),
  p: (Data) -> Prop
): Prop := ∀ n: Text. ∀ v: Data. (
  Ordmap::get(m, n, Ordmap::compare_text) = Some(v)
) -> Or(p(v), SummaryKey(n, es))

pub theorem summary_key_skip<n: Text, e: Pair(
  Text,
  Data
), rest: List(
  Pair(Text, Data)
)>(
  h: SummaryKey(n, Cons(e, rest)),
  ne: (n = summary_key(e)) -> False
): SummaryKey(n, rest) {
  match h: SummaryKey(n, rest) {
    SummaryKeyHere(v, tail) => False::elim(ne(Refl))
    SummaryKeyThere(item, tail, ht) => ht
  }
}

pub theorem summary_key_visit<n: Text, es: List(
  Pair(Text, Data)
)>(
  h: SummaryKey(n, es),
  d: Datas,
  data: Data,
  hd: datas_decl(d, n) = Some(data),
  visited: SummaryVisited(es, d)
): SummaryStable(d, data) {
  match h: SummaryStable(d, data) {
    SummaryKeyHere(v, rest) => visited(
      Pair { fst: n, snd: v },
      data,
      MemHere(Pair(Text, Data), Pair { fst: n, snd: v }, rest),
      hd
    )
    SummaryKeyThere(e, rest, ht) => summary_key_visit(
      ht,
      d,
      data,
      hd,
      item => val => m => hv => visited(item, val, MemThere(Pair(Text, Data), item, e, rest, m), hv)
    )
  }
}

pub fn summary_list_get_k(
  rest: List(Pair(Text, Data)),
  n: Text,
  v: Data,
  o: Ordering
): Option(Data) {
  match o: Option(Data) {
    Equal => Some(v)
    Less => Ordmap::list_get(rest, n, Ordmap::compare_text)
    Greater => Ordmap::list_get(rest, n, Ordmap::compare_text)
  }
}

pub theorem summary_list_get_unf(
  k: Text,
  v: Data,
  rest: List(Pair(Text, Data)),
  n: Text
): Ordmap::list_get(Cons(Pair { fst: k, snd: v }, rest), n, Ordmap::compare_text) = summary_list_get_k(rest, n, v, Ordmap::compare_text(n, k)) { Refl }

pub def SummaryGetKey(
  es: List(Pair(Text, Data)),
  n: Text,
  o: Option(Data)
): Prop := ∀ v: Data. (o = Some(v)) -> SummaryKey(n, es)

pub theorem summary_list_key_k(
  k: Text,
  v: Data,
  rest: List(Pair(Text, Data)),
  n: Text,
  o: Ordering,
  eo: Ordmap::compare_text(n, k) = o,
  ih: SummaryGetKey(rest, n, Ordmap::list_get(rest, n, Ordmap::compare_text))
): SummaryGetKey(Cons(Pair { fst: k, snd: v }, rest), n, summary_list_get_k(rest, n, v, o)) {
  match o: SummaryGetKey(
    Cons(Pair { fst: k, snd: v }, rest),
    n,
    summary_list_get_k(rest, n, v, o)
  ) {
    Equal => val => h => Eq::subst(
      (z: Text) => SummaryKey(n, Cons(Pair { fst: z, snd: v }, rest)),
      Ordmap::compare_text_eq(n, k, eo),
      SummaryKeyHere(n, v, rest)
    )
    Less => val => h => SummaryKeyThere(n, Pair { fst: k, snd: v }, rest, ih(val, h))
    Greater => val => h => SummaryKeyThere(n, Pair { fst: k, snd: v }, rest, ih(val, h))
  }
}

pub theorem summary_list_key(
  es: List(Pair(Text, Data)),
  n: Text,
  v: Data,
  h: Ordmap::list_get(es, n, Ordmap::compare_text) = Some(v)
): SummaryKey(n, es) {
  match es: SummaryKey(n, es) {
    Nil => False::elim(summary_none_some(v, h))
    Cons(e, rest) => match e: SummaryKey(n, Cons(e, rest)) {
      Pair { fst: k, snd: val } => Eq::subst(
        (z: Option(Data)) => SummaryGetKey(Cons(Pair { fst: k, snd: val }, rest), n, z),
        Eq::sym(summary_list_get_unf(k, val, rest, n)),
        summary_list_key_k(
          k,
          val,
          rest,
          n,
          Ordmap::compare_text(n, k),
          Refl,
          vv => hh => summary_list_key(rest, n, vv, hh)
        )
      )(v, h)
    }
  }
}

pub theorem summary_map_key(
  m: Ordmap(Text, Data),
  n: Text,
  v: Data,
  om: Ordmap::ordered(m, Ordmap::compare_text),
  h: Ordmap::get(m, n, Ordmap::compare_text) = Some(v)
): SummaryKey(n, Ordmap::entries(m)) {
  summary_list_key(
    Ordmap::entries(m),
    n,
    v,
    Eq::trans(
      Eq::sym(
        Ordmap::tree_get_entries(
          Ordmap::compare_text,
          Ordmap::compare_text_law(),
          Ordmap::tree(m),
          n,
          om
        )
      ),
      h
    )
  )
}

pub theorem summary_pending_other(
  es: List(Pair(Text, Data)),
  m: Ordmap(Text, Data),
  p: (Data) -> Prop,
  k: Text,
  old: Data,
  v: Data,
  om: Ordmap::ordered(m, Ordmap::compare_text),
  pending: SummaryPending(Cons(Pair { fst: k, snd: old }, es), m, p),
  n: Text,
  val: Data,
  o: Ordering,
  ne: (o = Equal) -> False,
  eo: Ordmap::compare_text(n, k) = o,
  h: Ordmap::get(Ordmap::insert(m, k, v, Ordmap::compare_text), n, Ordmap::compare_text) = Some(val)
): Or(p(val), SummaryKey(n, es)) {
  Or::elim(
    pending(
      n,
      val,
      Eq::trans(
        Eq::sym(
          Ordmap::get_insert_other(
            Ordmap::compare_text,
            Ordmap::compare_text_law(),
            m,
            k,
            v,
            n,
            o,
            ne,
            eo,
            om
          )
        ),
        h
      )
    ),
    hp => OrInl(hp),
    hk => OrInr(
      summary_key_skip(
        hk,
        eq => ne(
          Eq::trans(
            Eq::sym(eo),
            Eq::trans(
              Eq::congr((z: Text) => Ordmap::compare_text(z, k), eq),
              Ordmap::law_same(Ordmap::compare_text, Ordmap::compare_text_law(), k)
            )
          )
        )
      )
    )
  )
}

pub theorem summary_pending_insert_k(
  es: List(Pair(Text, Data)),
  m: Ordmap(Text, Data),
  p: (Data) -> Prop,
  k: Text,
  old: Data,
  v: Data,
  om: Ordmap::ordered(m, Ordmap::compare_text),
  pending: SummaryPending(Cons(Pair { fst: k, snd: old }, es), m, p),
  pv: p(v),
  n: Text,
  val: Data,
  o: Ordering,
  eo: Ordmap::compare_text(n, k) = o,
  h: Ordmap::get(Ordmap::insert(m, k, v, Ordmap::compare_text), n, Ordmap::compare_text) = Some(val)
): Or(p(val), SummaryKey(n, es)) {
  match o: Or(p(val), SummaryKey(n, es)) {
    Equal => OrInl(
      Eq::subst(
        p,
        summary_some_inj(
          v,
          val,
          Eq::trans(
            Eq::sym(Ordmap::text_get_insert_same(m, k, v, om)),
            Eq::subst(
              (z: Text) => Ordmap::get(Ordmap::insert(m, k, v, Ordmap::compare_text), z, Ordmap::compare_text) = Some(val),
              Ordmap::compare_text_eq(n, k, eo),
              h
            )
          )
        ),
        pv
      )
    )
    Less => summary_pending_other(
      es,
      m,
      p,
      k,
      old,
      v,
      om,
      pending,
      n,
      val,
      Less,
      q => less_ne_equal(q),
      eo,
      h
    )
    Greater => summary_pending_other(
      es,
      m,
      p,
      k,
      old,
      v,
      om,
      pending,
      n,
      val,
      Greater,
      q => greater_ne_equal(q),
      eo,
      h
    )
  }
}

pub theorem summary_key_nil(n: Text, p: Prop, h: SummaryKey(n, Nil(Pair(Text, Data)))): p {
  match h: p {
  }
}

pub theorem summary_map_all(
  es: List(Pair(Text, Data)),
  f: (Data) -> Data,
  m: Ordmap(Text, Data),
  p: (Data) -> Prop,
  good: ∀ v: Data. p(f(v)),
  om: Ordmap::ordered(m, Ordmap::compare_text),
  pending: SummaryPending(es, m, p)
): And(
  Ordmap::ordered(datas_map_decls(es, f, m), Ordmap::compare_text),
  SummaryAll(datas_map_decls(es, f, m), p)
) {
  match es: And(
    Ordmap::ordered(datas_map_decls(es, f, m), Ordmap::compare_text),
    SummaryAll(datas_map_decls(es, f, m), p)
  ) {
    Nil => AndIntro(
      om,
      n => v => h => Or::elim(pending(n, v, h), pv => pv, hk => summary_key_nil(n, p(v), hk))
    )
    Cons(e, rest) => match e: And(
      Ordmap::ordered(datas_map_decls(Cons(e, rest), f, m), Ordmap::compare_text),
      SummaryAll(datas_map_decls(Cons(e, rest), f, m), p)
    ) {
      Pair { fst: k, snd: old } => summary_map_all(
        rest,
        f,
        Ordmap::insert(m, k, f(old), Ordmap::compare_text),
        p,
        good,
        Ordmap::insert_ordered(Ordmap::compare_text, Ordmap::compare_text_law(), m, k, f(old), om),
        n => v => h => summary_pending_insert_k(
          rest,
          m,
          p,
          k,
          old,
          f(old),
          om,
          pending,
          good(old),
          n,
          v,
          Ordmap::compare_text(n, k),
          Refl,
          h
        )
      )
    }
  }
}

pub theorem summary_map_decls_all(
  f: (Data) -> Data,
  m: Ordmap(Text, Data),
  p: (Data) -> Prop,
  good: ∀ v: Data. p(f(v)),
  om: Ordmap::ordered(m, Ordmap::compare_text)
): And(
  Ordmap::ordered(datas_map_decls(Ordmap::entries(m), f, m), Ordmap::compare_text),
  SummaryAll(datas_map_decls(Ordmap::entries(m), f, m), p)
) {
  summary_map_all(
    Ordmap::entries(m),
    f,
    m,
    p,
    good,
    om,
    n => v => h => OrInr(summary_map_key(m, n, v, om, h))
  )
}

pub def SummaryReady(
  d: Datas
): Prop := And(SummaryOrdered(d), SummaryAll(summary_decls(d), SummaryFloor))

pub theorem summary_insert_all(
  m: Ordmap(Text, Data),
  p: (Data) -> Prop,
  k: Text,
  v: Data,
  om: Ordmap::ordered(m, Ordmap::compare_text),
  all: SummaryAll(m, p),
  pv: p(v)
): SummaryAll(Ordmap::insert(m, k, v, Ordmap::compare_text), p) {
  n => val => h => Or::elim(
    summary_pending_insert_k(
      Nil(Pair(Text, Data)),
      m,
      p,
      k,
      v,
      v,
      om,
      nn => vv => hh => OrInl(all(nn, vv, hh)),
      pv,
      n,
      val,
      Ordmap::compare_text(n, k),
      Refl,
      h
    ),
    hv => hv,
    hk => summary_key_nil(n, p(val), hk)
  )
}

pub theorem summary_update_ready(
  d: Datas,
  n: Text,
  data: Data,
  ready: SummaryReady(d),
  hd: datas_decl(d, n) = Some(data)
): SummaryReady(summary_update(d, n, data)) {
  let r: Pair(
    Kind,
    List(Text)
  ) := ctors_kind(d, dctors(data), dgen(data), Pair { fst: dbase(data), snd: dholds(data) })
  let next: Data := data_with_summary(data, kind_join(dbase(data), pfst(r)), psnd(r))
  AndIntro(
    Ordmap::insert_ordered(
      Ordmap::compare_text,
      Ordmap::compare_text_law(),
      summary_decls(d),
      n,
      next,
      And::left(ready)
    ),
    summary_insert_all(
      summary_decls(d),
      SummaryFloor,
      n,
      next,
      And::left(ready),
      And::right(ready),
      summary_update_floor(d, data, And::right(ready)(n, data, hd))
    )
  )
}

pub theorem summary_ready_test(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  data: Data,
  b: Bool,
  ready: SummaryReady(d),
  hd: datas_decl(d, n) = Some(data),
  ih: ∀ dd: Datas. ∀ gg: Bool. (
    SummaryReady(dd)
  ) -> SummaryReady(summary_result(datas_round(rest, dd, gg)))
): SummaryReady(summary_result(summary_round_test(rest, d, grew, n, data, b))) {
  match b: SummaryReady(summary_result(summary_round_test(rest, d, grew, n, data, b))) {
    true => ih(d, grew, ready)
    false => ih(summary_update(d, n, data), true, summary_update_ready(d, n, data, ready, hd))
  }
}

pub theorem summary_ready_decl(
  rest: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  n: Text,
  o: Option(Data),
  ready: SummaryReady(d),
  eo: datas_decl(d, n) = o,
  ih: ∀ dd: Datas. ∀ gg: Bool. (
    SummaryReady(dd)
  ) -> SummaryReady(summary_result(datas_round(rest, dd, gg)))
): SummaryReady(summary_result(summary_round_decl(rest, d, grew, n, o))) {
  match o: SummaryReady(summary_result(summary_round_decl(rest, d, grew, n, o))) {
    None => ih(d, grew, ready)
    Some(data) => summary_ready_test(rest, d, grew, n, data, summary_test(d, data), ready, eo, ih)
  }
}

pub theorem summary_round_ready(
  es: List(Pair(Text, Data)),
  d: Datas,
  grew: Bool,
  ready: SummaryReady(d)
): SummaryReady(summary_result(datas_round(es, d, grew))) {
  match es: SummaryReady(summary_result(datas_round(es, d, grew))) {
    Nil => ready
    Cons(e, rest) => Eq::subst(
      (z: Pair(Datas, Bool)) => SummaryReady(summary_result(z)),
      Eq::sym(summary_round_unf(e, rest, d, grew)),
      summary_ready_decl(
        rest,
        d,
        grew,
        summary_key(e),
        datas_decl(d, summary_key(e)),
        ready,
        Refl,
        dd => gg => rr => summary_round_ready(rest, dd, gg, rr)
      )
    )
  }
}

pub theorem summary_stopped(
  d: Datas,
  ready: SummaryReady(d),
  h: summary_grew(datas_round(Ordmap::entries(summary_decls(d)), d, false)) = false
): SummaryOk(summary_result(datas_round(Ordmap::entries(summary_decls(d)), d, false))) {
  let stable: SummaryVisited(
    Ordmap::entries(summary_decls(d)),
    d
  ) := summary_round_quiet(Ordmap::entries(summary_decls(d)), d, false, h)
  let ok: SummaryOk(d) := n => data => hd => {
    let sd: SummaryStable(
      d,
      data
    ) := summary_key_visit(
      summary_map_key(summary_decls(d), n, data, And::left(ready), hd),
      d,
      data,
      hd,
      stable
    )
    AndIntro(And::left(sd), AndIntro(And::right(sd), And::right(ready)(n, data, hd)))
  }
  Eq::subst(
    SummaryOk,
    Eq::sym(summary_round_unchanged(Ordmap::entries(summary_decls(d)), d, false, h)),
    ok
  )
}

pub fn summary_initial(d: Datas): Datas {
  datas_with_decls(d, datas_map_decls(Ordmap::entries(d.decls), data_least, d.decls))
}

pub fn summary_exhausted(d: Datas): Datas {
  datas_with_decls(d, datas_map_decls(Ordmap::entries(d.decls), data_top, d.decls))
}

pub theorem summary_initial_ready(
  d: Datas,
  ordered: SummaryOrdered(d)
): SummaryReady(summary_initial(d)) {
  summary_map_decls_all(
    data_least,
    summary_decls(d),
    SummaryFloor,
    data => summary_least(data),
    ordered
  )
}

pub theorem summary_exhausted_ok(
  d: Datas,
  ordered: SummaryOrdered(d)
): SummaryOk(summary_exhausted(d)) {
  And::right(
    summary_map_decls_all(
      data_top,
      summary_decls(d),
      data => DataOk(summary_exhausted(d), data),
      data => summary_top(summary_exhausted(d), data),
      ordered
    )
  )
}

pub fn summary_rounds_choice(j: Nat, d: Datas, b: Bool): Datas {
  match b: Datas {
    true => datas_rounds(j, d)
    false => d
  }
}

pub theorem summary_rounds_unf(
  j: Nat,
  d: Datas
): datas_rounds(Succ(j), d) = summary_rounds_choice(
    j,
    summary_result(datas_round(Ordmap::entries(summary_decls(d)), d, false)),
    summary_grew(datas_round(Ordmap::entries(summary_decls(d)), d, false))
  ) { Refl }

pub theorem summary_choice_ok(
  j: Nat,
  d: Datas,
  b: Bool,
  stopped: (b = false) -> SummaryOk(d),
  next: SummaryOk(datas_rounds(j, d))
): SummaryOk(summary_rounds_choice(j, d, b)) {
  match b: SummaryOk(summary_rounds_choice(j, d, b)) {
    true => next
    false => stopped(Refl)
  }
}

pub theorem datas_rounds_summary_ok(
  k: Nat,
  d: Datas,
  ready: SummaryReady(d)
): SummaryOk(datas_rounds(k, d)) {
  match k: SummaryOk(datas_rounds(k, d)) {
    Zero => summary_exhausted_ok(d, And::left(ready))
    Succ(j) => Eq::subst(
      SummaryOk,
      Eq::sym(summary_rounds_unf(j, d)),
      summary_choice_ok(
        j,
        summary_result(datas_round(Ordmap::entries(summary_decls(d)), d, false)),
        summary_grew(datas_round(Ordmap::entries(summary_decls(d)), d, false)),
        h => summary_stopped(d, ready, h),
        datas_rounds_summary_ok(
          j,
          summary_result(datas_round(Ordmap::entries(summary_decls(d)), d, false)),
          summary_round_ready(Ordmap::entries(summary_decls(d)), d, false, ready)
        )
      )
    )
  }
}

pub fn summary_steps(d: Datas): Nat { d.steps }

// The input declaration map is ordered; its summaries may be arbitrary.
pub theorem datas_summarize_summary_ok(
  d: Datas,
  ordered: SummaryOrdered(d)
): SummaryOk(datas_summarize(d)) {
  datas_rounds_summary_ok(summary_steps(d), summary_initial(d), summary_initial_ready(d, ordered))
}
