import "handler_result_frame.taut"
import std::Base
import std::Map
import std::Text
import "checker.taut"
import "checker_frame.taut"
import "datas_frame.taut"
import "handle_frame.taut"
import "ty.taut"
import "types_decl.taut"
import "types_match.taut"
import "unify_sound.taut"
import "../../surface/src/surface.taut"

// The read frames of the steps that check an arm at the instance it writes
// (`ck_handle_arm_sig` and the steps around its body, `types_match.taut`) and
// of the steps that put a function's generics in scope.

pub theorem ck_arm_enter_frame(
  c: Checker,
  xs: List(TypeName)
): CkReadFrame(c, ck_arm_enter(c, xs)) { Refl }

pub theorem ck_enter_fn_frame(c: Checker, scheme: Scheme): CkReadFrame(c, ck_enter_fn(c, scheme)) {
  Refl
}

pub theorem ck_leave_fn_frame(
  c: Checker,
  assume: List(Pair(Text, Text)),
  types: List(TypeName)
): CkReadFrame(c, ck_leave_fn(c, assume, types)) { Refl }

pub theorem ck_arm_report_frame(
  c: Checker,
  why: Text,
  rv: Option(Nat),
  body: SurfaceTerm
): CkReadFrame(c, ck_arm_report(c, why, rv, body)) {
  ⊢ CkReadFrame(c, ck_arm_report(c, why, rv, body)) from match rv {
    Some(v) => Refl
    None => Refl
  }
}

pub fn arm_fresh_step(
  c: Checker,
  g: Text,
  rest: List(Text),
  map: Ordmap(Text, Ty),
  has: Bool
): Mut1(Ordmap(Text, Ty), Checker) {
  ⊢ Mut1(Ordmap(Text, Ty), Checker) from match has {
    true => ck_rewrap1(ck_arm_fresh(c, rest, map))
    false => frame_bind(
      Ty,
      Ordmap(Text, Ty),
      (v: Ty, c1: Checker) => ck_rewrap1(
        ck_arm_fresh(c1, rest, Ordmap::insert(map, g, v, Ordmap::compare_text))
      ),
      ck_fresh(c)
    )
  }
}

pub theorem arm_fresh_unf(
  c: Checker,
  g: Text,
  rest: List(Text),
  map: Ordmap(Text, Ty)
): ck_arm_fresh(
  c,
  Cons(g, rest),
  map
) = arm_fresh_step(c, g, rest, map, Ordmap::contains(map, g, Ordmap::compare_text)) { Refl }

pub theorem arm_fresh_step_frame(
  c: Checker,
  g: Text,
  rest: List(Text),
  map: Ordmap(Text, Ty),
  has: Bool,
  ih: ∀ next: Checker. ∀ m: Ordmap(Text, Ty). CkReadFrame(next, ck_arm_fresh(next, rest, m))
): CkReadFrame(c, arm_fresh_step(c, g, rest, map, has)) {
  ⊢ CkReadFrame(c, arm_fresh_step(c, g, rest, map, has)) from match has {
    true => frame_rewrap(c, ck_arm_fresh(c, rest, map), ih(c, map))
    false => frame_bind_ok(
      Ty,
      Ordmap(Text, Ty),
      c,
      (v: Ty, c1: Checker) => ck_rewrap1(
        ck_arm_fresh(c1, rest, Ordmap::insert(map, g, v, Ordmap::compare_text))
      ),
      ck_fresh(c),
      ck_fresh_frame(c),
      v => next => frame_rewrap(
        next,
        ck_arm_fresh(next, rest, Ordmap::insert(map, g, v, Ordmap::compare_text)),
        ih(next, Ordmap::insert(map, g, v, Ordmap::compare_text))
      )
    )
  }
}

pub theorem ck_arm_fresh_frame(
  c: Checker,
  gs: List(Text),
  map: Ordmap(Text, Ty)
): CkReadFrame(c, ck_arm_fresh(c, gs, map)) {
  ⊢ CkReadFrame(c, ck_arm_fresh(c, gs, map)) from match gs {
    Nil => Refl
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => CkReadFrame(c, z),
      Eq::sym(arm_fresh_unf(c, g, rest, map)),
      arm_fresh_step_frame(
        c,
        g,
        rest,
        map,
        Ordmap::contains(map, g, Ordmap::compare_text),
        next => m => ck_arm_fresh_frame(next, rest, m)
      )
    )
  }
}

pub theorem ck_arm_given_frame(
  c: Checker,
  typed: List(Text),
  types: List(SurfaceTerm),
  map: Ordmap(Text, Ty)
): CkReadFrame(c, ck_arm_given(c, typed, types, map)) {
  ⊢ CkReadFrame(c, ck_arm_given(c, typed, types, map)) from match typed {
    Nil => Refl
    Cons(g, gs) => ⊢ CkReadFrame(c, ck_arm_given(c, Cons(g, gs), types, map)) from match types {
      Nil => Refl
      Cons(t, ts) => frame_bind_ok(
        Ty,
        Ordmap(Text, Ty),
        c,
        (w: Ty, c1: Checker) => ck_rewrap1(
          ck_arm_given(c1, gs, ts, Ordmap::insert(map, g, w, Ordmap::compare_text))
        ),
        ck_written(c, t, type_scope(ck_type_params_of(c))),
        ck_written_frame(c, t, type_scope(ck_type_params_of(c))),
        w => next => frame_rewrap(
          next,
          ck_arm_given(next, gs, ts, Ordmap::insert(map, g, w, Ordmap::compare_text)),
          ck_arm_given_frame(next, gs, ts, Ordmap::insert(map, g, w, Ordmap::compare_text))
        )
      )
    }
  }
}

pub theorem ck_rigid_k_frame(
  c: Checker,
  g: Pair(Text, Kind),
  t: Ty,
  m: Mut1(Ordmap(Text, Ty), Checker),
  h: CkReadFrame(c, m)
): CkReadFrame(c, ck_rigid_k(g, t, m)) {
  ⊢ CkReadFrame(c, ck_rigid_k(g, t, m)) from match m {
    mut1(x, c2) => h
  }
}

// Making rigid types only counts them.
pub theorem ck_rigid_frame(
  gs: List(Pair(Text, Kind)),
  c: Checker
): CkReadFrame(c, ck_rigid(gs, c)) {
  ⊢ CkReadFrame(c, ck_rigid(gs, c)) from match gs {
    Nil => Refl
    Cons(g, rest) => ck_rigid_k_frame(
      c,
      g,
      TyParam(cat3(tk_first(g), "#", Text::of_nat(Nat::add(ck_rigids_of(c), 1))), tk_second(g)),
      ck_rigid(rest, ck_st(ck_bump_rigids(c))),
      ck_rigid_frame(rest, ck_st(ck_bump_rigids(c)))
    )
  }
}

pub theorem ck_arm_sig_at_frame(
  c: Checker,
  s: EffectSig,
  typed: List(Text),
  r#instance: ArmInstance,
  binds: List(Text),
  rv: Option(Nat),
  body: SurfaceTerm
): CkReadFrame(c, ck_arm_sig_at(c, s, typed, r#instance, binds, rv, body)) {
  ⊢ CkReadFrame(c, ck_arm_sig_at(c, s, typed, r#instance, binds, rv, body)) from match r#instance {
    ArmBad(why) => frame_bind_ok(
      Unit,
      Option(ArmSig),
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        Ordmap(Text, Ty),
        Option(ArmSig),
        (fresh: Ordmap(Text, Ty), c2: Checker) => mut1(
          arm_sig_of(ty_substitute(handle_effect_type(s), fresh), Nil, Nil),
          c2
        ),
        ck_arm_fresh(c1, handle_effect_generics(s), Ordmap::empty())
      ),
      ck_arm_report(c, why, rv, body),
      ck_arm_report_frame(c, why, rv, body),
      ignored => c1 => frame_bind_ok(
        Ordmap(Text, Ty),
        Option(ArmSig),
        c1,
        (fresh: Ordmap(Text, Ty), c2: Checker) => mut1(
          arm_sig_of(ty_substitute(handle_effect_type(s), fresh), Nil, Nil),
          c2
        ),
        ck_arm_fresh(c1, handle_effect_generics(s), Ordmap::empty()),
        ck_arm_fresh_frame(c1, handle_effect_generics(s), Ordmap::empty()),
        fresh => c2 => Refl
      )
    )
    ArmOne(written) => frame_bind_ok(
      Ordmap(Text, Ty),
      Option(ArmSig),
      c,
      (given: Ordmap(Text, Ty), c1: Checker) => frame_bind(
        Ordmap(Text, Ty),
        Option(ArmSig),
        (fixed: Ordmap(Text, Ty), c2: Checker) => mut1(
          arm_sig_of(ty_substitute(handle_effect_type(s), fixed), Nil, Nil),
          c2
        ),
        ck_arm_fresh(c1, handle_effect_generics(s), given)
      ),
      ck_arm_given(c, typed, written, Ordmap::empty()),
      ck_arm_given_frame(c, typed, written, Ordmap::empty()),
      given => c1 => frame_bind_ok(
        Ordmap(Text, Ty),
        Option(ArmSig),
        c1,
        (fixed: Ordmap(Text, Ty), c2: Checker) => mut1(
          arm_sig_of(ty_substitute(handle_effect_type(s), fixed), Nil, Nil),
          c2
        ),
        ck_arm_fresh(c1, handle_effect_generics(s), given),
        ck_arm_fresh_frame(c1, handle_effect_generics(s), given),
        fixed => c2 => Refl
      )
    )
    ArmEvery => frame_bind_ok(
      Ordmap(Text, Ty),
      Option(ArmSig),
      c,
      (rigid: Ordmap(Text, Ty), c1: Checker) => mut1(
        arm_sig_of(
          ty_substitute(handle_effect_type(s), rigid),
          rigid_param_names(handle_effect_generics(s), rigid),
          arm_bound(binds, typed, rigid)
        ),
        c1
      ),
      ck_rigid(affine_generics(handle_effect_generics(s)), c),
      ck_rigid_frame(affine_generics(handle_effect_generics(s)), c),
      rigid => c1 => Refl
    )
  }
}

pub fn arm_sig_found(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  rv: Option(Nat),
  body: SurfaceTerm,
  found: Option(EffectSig)
): Mut1(Option(ArmSig), Checker) {
  ⊢ Mut1(Option(ArmSig), Checker) from match found {
    Some(s) => ck_rewrap1(
      ck_arm_sig_at(
        c,
        s,
        effect_typed_generics(handle_effect_generics(s), s),
        arm_instance(eff, binds, types, effect_typed_generics(handle_effect_generics(s), s)),
        binds,
        rv,
        body
      )
    )
    None => frame_bind(
      Unit,
      Option(ArmSig),
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, cat3("no effect `", eff, "` is declared"), span_of(body))
    )
  }
}

pub fn arm_sig_step(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  body: SurfaceTerm,
  exceeded: Bool
): Mut1(Option(ArmSig), Checker) {
  ⊢ Mut1(Option(ArmSig), Checker) from match exceeded {
    true => mut1(
      Some(ArmSig { params: Cons(TyInfo(result), Nil), answer: budget_ty, rigid: Nil, bound: Nil }),
      c
    )
    false => arm_sig_found(
      c,
      eff,
      binds,
      types,
      rv,
      body,
      Ordmap::get(handle_effects(c), eff, Ordmap::compare_text)
    )
  }
}

pub theorem arm_sig_unf(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  body: SurfaceTerm
): ck_handle_arm_sig(
  c,
  eff,
  binds,
  types,
  result,
  rv,
  budget_ty,
  body
) = arm_sig_step(
  c,
  eff,
  binds,
  types,
  result,
  rv,
  budget_ty,
  body,
  Text::eq(eff, "exceeded")
) { Refl }

pub theorem arm_sig_found_frame(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  rv: Option(Nat),
  body: SurfaceTerm,
  found: Option(EffectSig)
): CkReadFrame(c, arm_sig_found(c, eff, binds, types, rv, body, found)) {
  ⊢ CkReadFrame(c, arm_sig_found(c, eff, binds, types, rv, body, found)) from match found {
    Some(s) => frame_rewrap(
      c,
      ck_arm_sig_at(
        c,
        s,
        effect_typed_generics(handle_effect_generics(s), s),
        arm_instance(eff, binds, types, effect_typed_generics(handle_effect_generics(s), s)),
        binds,
        rv,
        body
      ),
      ck_arm_sig_at_frame(
        c,
        s,
        effect_typed_generics(handle_effect_generics(s), s),
        arm_instance(eff, binds, types, effect_typed_generics(handle_effect_generics(s), s)),
        binds,
        rv,
        body
      )
    )
    None => frame_bind_ok(
      Unit,
      Option(ArmSig),
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, cat3("no effect `", eff, "` is declared"), span_of(body)),
      ck_error_frame(c, cat3("no effect `", eff, "` is declared"), span_of(body)),
      ignored => c1 => Refl
    )
  }
}

pub theorem arm_sig_step_frame(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  body: SurfaceTerm,
  exceeded: Bool
): CkReadFrame(c, arm_sig_step(c, eff, binds, types, result, rv, budget_ty, body, exceeded)) {
  ⊢ CkReadFrame(
    c,
    arm_sig_step(c, eff, binds, types, result, rv, budget_ty, body, exceeded)
  ) from match exceeded {
    true => Refl
    false => arm_sig_found_frame(
      c,
      eff,
      binds,
      types,
      rv,
      body,
      Ordmap::get(handle_effects(c), eff, Ordmap::compare_text)
    )
  }
}

pub theorem ck_handle_arm_sig_frame(
  c: Checker,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  body: SurfaceTerm
): CkReadFrame(c, ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body)) {
  Eq::subst(
    (z: Mut1(Option(ArmSig), Checker)) => CkReadFrame(c, z),
    Eq::sym(arm_sig_unf(c, eff, binds, types, result, rv, budget_ty, body)),
    arm_sig_step_frame(c, eff, binds, types, result, rv, budget_ty, body, Text::eq(eff, "exceeded"))
  )
}

pub fn arm_set_types(&mut c: Checker, v: List(TypeName)): Unit {
  set_to(&mut c.type_params, v)
}

pub fn arm_finish_after(
  c: Checker,
  eff: Text,
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  out: Bool
): Mut1(Unit, Checker) {
  ⊢ Mut1(Unit, Checker) from match out {
    true => ck_rewrap1(
      ck_error(
        c,
        cat3(
          "the arm of `",
          eff,
          "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
        ),
        span
      )
    )
    false => ck_rewrap1(ck_handle_arm_result(c, a, result, rv, span))
  }
}

pub fn arm_finish(
  c: Checker,
  eff: Text,
  rigid: List(Text),
  env: List(Local),
  types: List(TypeName),
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan
): Mut1(Unit, Checker) {
  frame_bind(
    Unit,
    Unit,
    (ignored: Unit, c1: Checker) => arm_finish_after(
      c1,
      eff,
      a,
      result,
      rv,
      span,
      ck_arm_lets_rigid_out(c1, rigid, a, result, env)
    ),
    arm_set_types(c, types)
  )
}

pub theorem arm_finish_unf(
  c: Checker,
  eff: Text,
  rigid: List(Text),
  env: List(Local),
  types: List(TypeName),
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan
): ck_handle_arm_finish(
  c,
  eff,
  rigid,
  env,
  types,
  a,
  result,
  rv,
  span
) = arm_finish(c, eff, rigid, env, types, a, result, rv, span) { Refl }

pub theorem arm_finish_after_run_frame(
  c: Checker,
  eff: Text,
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  out: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, arm_finish_after(c, eff, a, result, rv, span, out)) {
  ⊢ CkRunFrame(c, arm_finish_after(c, eff, a, result, rv, span, out)) from match out {
    true => run_frame_read(
      c,
      arm_finish_after(c, eff, a, result, rv, span, true),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        ),
        ck_error_frame(
          c,
          cat3(
            "the arm of `",
            eff,
            "` must work for whatever type arguments it is performed with: they are chosen where it is performed"
          ),
          span
        )
      ),
      ordered
    )
    false => run_frame_rewrap(
      c,
      ck_handle_arm_result(c, a, result, rv, span),
      ck_handle_arm_result_run_frame(c, a, result, rv, span, ordered)
    )
  }
}

pub theorem ck_handle_arm_finish_run_frame(
  c: Checker,
  eff: Text,
  rigid: List(Text),
  env: List(Local),
  types: List(TypeName),
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_handle_arm_finish(c, eff, rigid, env, types, a, result, rv, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
    Eq::sym(arm_finish_unf(c, eff, rigid, env, types, a, result, rv, span)),
    run_frame_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => arm_finish_after(
        c1,
        eff,
        a,
        result,
        rv,
        span,
        ck_arm_lets_rigid_out(c1, rigid, a, result, env)
      ),
      arm_set_types(c, types),
      run_frame_read(c, arm_set_types(c, types), Refl, ordered),
      ignored => c1 => o_c1 => arm_finish_after_run_frame(
        c1,
        eff,
        a,
        result,
        rv,
        span,
        ck_arm_lets_rigid_out(c1, rigid, a, result, env),
        o_c1
      )
    )
  )
}
