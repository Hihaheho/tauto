import "instantiation_pending_sound.taut"

pub def InstantiationContextFrame<A: Type>(
  c: Checker,
  m: Mut1(A, Checker)
): Prop := inference_assume(ck_st(m)) = inference_assume(c)
pub theorem instantiation_context_bind<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  first: InstantiationContextFrame(c, m),
  tail: ∀ value: A. ∀ next: Checker. InstantiationContextFrame(next, k(value, next))
): InstantiationContextFrame(c, frame_bind(A, B, k, m)) {
  match m: InstantiationContextFrame(
    c,
    frame_bind(A, B, k, m)
  ) { mut1(value, next) => Eq::trans(tail(value, next), first) }
}
pub theorem instantiation_context_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  h: InstantiationContextFrame(c, m)
): InstantiationContextFrame(c, ck_rewrap1(m)) {
  Eq::subst(
    (result: Mut1(A, Checker)) => InstantiationContextFrame(c, result),
    Eq::sym(ck_rewrap1_id(m)),
    h
  )
}
pub theorem instantiation_fresh_context(
  c: Checker
): InstantiationContextFrame(c, ck_fresh(c)) { Refl }
pub theorem instantiation_bound_frame_context(
  c: Checker,
  g: Pair(Text, Kind),
  v: Ty,
  name: Text,
  span: TySpan,
  arg: Option(Kind)
): InstantiationContextFrame(c, instantiation_bound(c, g, v, name, span, arg)) {
  match arg: InstantiationContextFrame(
    c,
    instantiation_bound(c, g, v, name, span, arg)
  ) { Some(k) => Refl
    None => Refl }
}

pub theorem instantiation_cons_frame_context(
  g: Pair(Text, Kind),
  rest: List(Pair(Text, Kind)),
  c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ more: Ordmap(
    Text,
    Ty
  ). InstantiationContextFrame(next, ck_instantiate_map_ctors(rest, next, ctors, name, span, more))
): InstantiationContextFrame(c, instantiation_cons(g, rest, c, ctors, name, span, map)) {
  instantiation_context_bind(
    Ty,
    Ordmap(Text, Ty),
    c,
    (v: Ty, c1: Checker) => frame_bind(
      Unit,
      Ordmap(Text, Ty),
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        )
      ),
      instantiation_bound(c1, g, v, name, span, ctor_arg_of(ctors, instantiation_name(g)))
    ),
    ck_fresh(c),
    instantiation_fresh_context(c),
    v => c1 => instantiation_context_bind(
      Unit,
      Ordmap(Text, Ty),
      c1,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        )
      ),
      instantiation_bound(c1, g, v, name, span, ctor_arg_of(ctors, instantiation_name(g))),
      instantiation_bound_frame_context(
        c1,
        g,
        v,
        name,
        span,
        ctor_arg_of(ctors, instantiation_name(g))
      ),
      ignored => c2 => instantiation_context_rewrap(
        c2,
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        ),
        ih(c2, Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text))
      )
    )
  )
}

pub theorem ck_instantiate_map_ctors_frame_context(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty)
): InstantiationContextFrame(c, ck_instantiate_map_ctors(gs, c, ctors, name, span, map)) {
  match gs: InstantiationContextFrame(c, ck_instantiate_map_ctors(gs, c, ctors, name, span, map)) {
    Nil => Refl
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => InstantiationContextFrame(c, z),
      Eq::sym(instantiation_cons_unf(g, rest, c, ctors, name, span, map)),
      instantiation_cons_frame_context(
        g,
        rest,
        c,
        ctors,
        name,
        span,
        map,
        next => more => ck_instantiate_map_ctors_frame_context(rest, next, ctors, name, span, more)
      )
    )
  }
}
pub theorem ck_instantiate_map_frame_context(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  span: TySpan,
  map: Ordmap(Text, Ty)
): InstantiationContextFrame(c, ck_instantiate_map(gs, c, span, map)) {
  instantiation_context_rewrap(
    c,
    ck_instantiate_map_ctors(gs, c, Nil, "", span, map),
    ck_instantiate_map_ctors_frame_context(gs, c, Nil, "", span, map)
  )
}
pub theorem ck_pend_frame_context(
  c: Checker,
  r#class: Text,
  t: Ty,
  what: Text,
  span: TySpan
): InstantiationContextFrame(c, ck_pend(c, r#class, t, what, span)) { Refl }

pub theorem instantiation_pred_frame_context(
  c: Checker,
  p: Pair(Text, Text),
  what: Text,
  span: TySpan,
  found: Option(Ty)
): InstantiationContextFrame(c, instantiation_pred(c, p, what, span, found)) {
  match found: InstantiationContextFrame(c, instantiation_pred(c, p, what, span, found)) {
    None => Refl
    Some(t) => instantiation_context_rewrap(
      c,
      ck_pend(c, instantiation_constraint(p), t, what, span),
      ck_pend_frame_context(c, instantiation_constraint(p), t, what, span)
    )
  }
}

pub theorem instantiation_preds_cons_frame_context(
  p: Pair(Text, Text),
  rest: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  ih: ∀ next: Checker. InstantiationContextFrame(next, ck_pend_preds(rest, next, map, what, span))
): InstantiationContextFrame(c, instantiation_preds_cons(p, rest, c, map, what, span)) {
  instantiation_context_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_pend_preds(rest, c1, map, what, span)),
    instantiation_pred(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    instantiation_pred_frame_context(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    ignored => c1 => instantiation_context_rewrap(
      c1,
      ck_pend_preds(rest, c1, map, what, span),
      ih(c1)
    )
  )
}

pub theorem ck_pend_preds_frame_context(
  ps: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): InstantiationContextFrame(c, ck_pend_preds(ps, c, map, what, span)) {
  match ps: InstantiationContextFrame(c, ck_pend_preds(ps, c, map, what, span)) {
    Nil => Refl
    Cons(p, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => InstantiationContextFrame(c, z),
      Eq::sym(instantiation_preds_cons_unf(p, rest, c, map, what, span)),
      instantiation_preds_cons_frame_context(
        p,
        rest,
        c,
        map,
        what,
        span,
        next => ck_pend_preds_frame_context(rest, next, map, what, span)
      )
    )
  }
}

pub theorem instantiation_named_cons_frame_context(
  g: Text,
  rest: List(Text),
  c: Checker,
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ more: Ordmap(
    Text,
    Ty
  ). InstantiationContextFrame(next, ck_instantiate_named_map(rest, next, more))
): InstantiationContextFrame(c, instantiation_named_cons(g, rest, c, map)) {
  instantiation_context_bind(
    Ty,
    Ordmap(Text, Ty),
    c,
    (v: Ty, c1: Checker) => ck_rewrap1(
      ck_instantiate_named_map(rest, c1, Ordmap::insert(map, g, v, Ordmap::compare_text))
    ),
    ck_fresh(c),
    instantiation_fresh_context(c),
    v => c1 => instantiation_context_rewrap(
      c1,
      ck_instantiate_named_map(rest, c1, Ordmap::insert(map, g, v, Ordmap::compare_text)),
      ih(c1, Ordmap::insert(map, g, v, Ordmap::compare_text))
    )
  )
}

pub theorem ck_instantiate_named_map_frame_context(
  gs: List(Text),
  c: Checker,
  map: Ordmap(Text, Ty)
): InstantiationContextFrame(c, ck_instantiate_named_map(gs, c, map)) {
  match gs: InstantiationContextFrame(c, ck_instantiate_named_map(gs, c, map)) {
    Nil => Refl
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => InstantiationContextFrame(c, z),
      Eq::sym(instantiation_named_cons_unf(g, rest, c, map)),
      instantiation_named_cons_frame_context(
        g,
        rest,
        c,
        map,
        next => more => ck_instantiate_named_map_frame_context(rest, next, more)
      )
    )
  }
}

pub theorem instantiation_ck_instantiate_frame_context(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  t: Ty,
  span: TySpan
): InstantiationContextFrame(c, instantiation_ck_instantiate(c, gs, t, span)) {
  instantiation_context_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => mut1(ty_substitute(t, map), c1),
    ck_instantiate_map(gs, c, span, Ordmap::empty()),
    ck_instantiate_map_frame_context(gs, c, span, Ordmap::empty()),
    map => c1 => Refl
  )
}

pub theorem ck_instantiate_frame_context(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  t: Ty,
  span: TySpan
): InstantiationContextFrame(c, ck_instantiate(c, gs, t, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => InstantiationContextFrame(c, z),
    Eq::sym(instantiation_ck_instantiate_unf(c, gs, t, span)),
    instantiation_ck_instantiate_frame_context(c, gs, t, span)
  )
}

pub theorem instantiation_ck_instantiate_named_frame_context(
  c: Checker,
  gs: List(Text),
  t: Ty
): InstantiationContextFrame(c, instantiation_ck_instantiate_named(c, gs, t)) {
  instantiation_context_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => mut1(ty_substitute(t, map), c1),
    ck_instantiate_named_map(gs, c, Ordmap::empty()),
    ck_instantiate_named_map_frame_context(gs, c, Ordmap::empty()),
    map => c1 => Refl
  )
}

pub theorem ck_instantiate_named_frame_context(
  c: Checker,
  gs: List(Text),
  t: Ty
): InstantiationContextFrame(c, ck_instantiate_named(c, gs, t)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => InstantiationContextFrame(c, z),
    Eq::sym(instantiation_ck_instantiate_named_unf(c, gs, t)),
    instantiation_ck_instantiate_named_frame_context(c, gs, t)
  )
}

pub theorem instantiation_scheme_frame_context(
  c: Checker,
  name: Text,
  s: Scheme,
  span: TySpan
): InstantiationContextFrame(c, instantiation_scheme(c, name, s, span)) {
  instantiation_context_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(ty_substitute(instantiation_scheme_ty(s), map), c2),
      ck_pend_preds(instantiation_scheme_preds(s), c1, map, name, span)
    ),
    ck_instantiate_map_ctors(
      instantiation_scheme_generics(s),
      c,
      instantiation_scheme_ctors(s),
      name,
      span,
      Ordmap::empty()
    ),
    ck_instantiate_map_ctors_frame_context(
      instantiation_scheme_generics(s),
      c,
      instantiation_scheme_ctors(s),
      name,
      span,
      Ordmap::empty()
    ),
    map => c1 => instantiation_context_bind(
      Unit,
      Ty,
      c1,
      (ignored: Unit, c2: Checker) => mut1(ty_substitute(instantiation_scheme_ty(s), map), c2),
      ck_pend_preds(instantiation_scheme_preds(s), c1, map, name, span),
      ck_pend_preds_frame_context(instantiation_scheme_preds(s), c1, map, name, span),
      ignored => c2 => Refl
    )
  )
}

pub theorem ck_instantiate_scheme_frame_context(
  c: Checker,
  name: Text,
  s: Scheme,
  span: TySpan
): InstantiationContextFrame(c, ck_instantiate_scheme(c, name, s, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => InstantiationContextFrame(c, z),
    Eq::sym(instantiation_scheme_unf(c, name, s, span)),
    instantiation_scheme_frame_context(c, name, s, span)
  )
}
