pub theorem application_effect_arity_frame_checked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ps: List(Ty),
  bad: Bool,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, application_effect_arity(c, eff, types, args, span, ps, bad)) {
  ⊢ CkCheckedFrame(c, application_effect_arity(c, eff, types, args, span, ps, bad)) from match bad {
    true => checked_frame_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        ),
        ck_error_frame(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      error_frame_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        ),
        ck_error_frame_errors(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      ordered
    )
    false => checked_frame_rewrap(
      c,
      ck_expect_args(types, c, ps, args),
      ck_expect_args_run_frame_checked(types, c, ps, args, ordered)
    )
  }
}

pub theorem application_effect_inst_frame_checked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  original: Ty,
  inst: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, application_effect_inst(c, eff, types, args, span, original, inst)) {
  ⊢ CkCheckedFrame(c, application_effect_inst(c, eff, types, args, span, original, inst)) from match inst {
    TyInt(pat_w) => checked_frame_return(c, original, ordered)
    TyBool => checked_frame_return(c, original, ordered)
    TyText => checked_frame_return(c, original, ordered)
    TyUnit => checked_frame_return(c, original, ordered)
    TyNever => checked_frame_return(c, original, ordered)
    TyDecimal => checked_frame_return(c, original, ordered)
    TyFloat => checked_frame_return(c, original, ordered)
    TyFn(ps, r, fk) => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(r, c1),
      application_effect_arity(
        c,
        eff,
        types,
        args,
        span,
        ps,
        not(Nat::eq(list_len(ps), list_len(types)))
      ),
      application_effect_arity_frame_checked(
        c,
        eff,
        types,
        args,
        span,
        ps,
        not(Nat::eq(list_len(ps), list_len(types))),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_return(c1, r, o_c1)
    )
    TyUnion(pat_members) => checked_frame_return(c, original, ordered)
    TyProduct(pat_members) => checked_frame_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => checked_frame_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => checked_frame_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => checked_frame_return(c, original, ordered)
    TyInfo(pat_inner) => checked_frame_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => checked_frame_return(c, original, ordered)
    TyVar(pat_v) => checked_frame_return(c, original, ordered)
    TyPoly(pat_generics, pat_inner) => checked_frame_return(c, original, ordered)
    TyApp(pat_head, pat_arg) => checked_frame_return(c, original, ordered)
  }
}

pub theorem application_effect_found_frame_checked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  found: Option(EffectSig),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, application_effect_found(c, eff, types, args, span, found)) {
  ⊢ CkCheckedFrame(c, application_effect_found(c, eff, types, args, span, found)) from match found {
    None => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat3("no effect `", eff, "` is declared"), span),
      checked_frame_read(
        c,
        ck_error(c, cat3("no effect `", eff, "` is declared"), span),
        ck_error_frame(c, cat3("no effect `", eff, "` is declared"), span),
        ck_error_frame_errors(c, cat3("no effect `", eff, "` is declared"), span),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    Some(sig) => checked_frame_bind(
      Ty,
      Ty,
      c,
      (inst: Ty, c1: Checker) => application_effect_inst(c1, eff, types, args, span, inst, inst),
      ck_instantiate_named(c, handle_effect_generics(sig), handle_effect_type(sig)),
      checked_frame_read(
        c,
        ck_instantiate_named(c, handle_effect_generics(sig), handle_effect_type(sig)),
        ck_instantiate_named_frame(c, handle_effect_generics(sig), handle_effect_type(sig)),
        ck_instantiate_named_frame_errors(c, handle_effect_generics(sig), handle_effect_type(sig)),
        ordered
      ),
      inst => c1 => o_c1 => application_effect_inst_frame_checked(
        c1,
        eff,
        types,
        args,
        span,
        inst,
        inst,
        o_c1
      )
    )
  }
}

pub theorem ck_perform_of_run_frame_checked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_perform_of(c, eff, types, args, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(application_effect_unf(c, eff, types, args, span)),
    application_effect_found_frame_checked(
      c,
      eff,
      types,
      args,
      span,
      Ordmap::get(handle_effects(c), eff, Ordmap::compare_text),
      ordered
    )
  )
}

pub theorem application_fn_arity_frame_checked(
  c: Checker,
  term: SurfaceTerm,
  arguments: List(SurfaceTerm),
  args: List(Ty),
  ps: List(Ty),
  bad: Bool,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, application_fn_arity(c, term, arguments, args, ps, bad)) {
  ⊢ CkCheckedFrame(c, application_fn_arity(c, term, arguments, args, ps, bad)) from match bad {
    true => checked_frame_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        ),
        ck_error_frame(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        )
      ),
      error_frame_rewrap(
        c,
        ck_error(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        ),
        ck_error_frame_errors(
          c,
          cat4(
            "a function of ",
            Text::of_nat(list_len(ps)),
            " values is given ",
            Text::of_nat(list_len(args))
          ),
          span_of(term)
        )
      ),
      ordered
    )
    false => checked_frame_rewrap(
      c,
      ck_expect_args(args, c, ps, arguments),
      ck_expect_args_run_frame_checked(args, c, ps, arguments, ordered)
    )
  }
}

pub theorem application_fn_known_frame_checked(
  c: Checker,
  term: SurfaceTerm,
  arguments: List(SurfaceTerm),
  args: List(Ty),
  ps: List(Ty),
  r: Ty,
  known: Option(List(Ty)),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, application_fn_known(c, term, arguments, args, ps, r, known)) {
  ⊢ CkCheckedFrame(c, application_fn_known(c, term, arguments, args, ps, r, known)) from match known {
    Some(kp) => checked_frame_return(c, r, ordered)
    None => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(r, c1),
      application_fn_arity(
        c,
        term,
        arguments,
        args,
        ps,
        not(Nat::eq(list_len(ps), list_len(args)))
      ),
      application_fn_arity_frame_checked(
        c,
        term,
        arguments,
        args,
        ps,
        not(Nat::eq(list_len(ps), list_len(args))),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_return(c1, r, o_c1)
    )
  }
}

pub theorem application_fn_frame_checked(
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  f: Ty,
  known: Option(List(Ty)),
  args: List(Ty),
  original: Ty,
  fr: Ty,
  ordered: CkOrdered(c)
): CkCheckedFrame(c, application_fn(c, term, function, arguments, f, known, args, original, fr)) {
  ⊢ CkCheckedFrame(
    c,
    application_fn(c, term, function, arguments, f, known, args, original, fr)
  ) from match fr {
    TyInt(pat_w) => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyBool => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyText => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyUnit => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyNever => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
