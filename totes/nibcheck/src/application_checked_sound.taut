        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyParam(pat_name, pat_bound) => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyInfo(pat_inner) => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyBorrow(pat_inner, pat_mutable) => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyVar(v) => checked_frame_bind(
      Ty,
      Ty,
      c,
      (r: Ty, c1: Checker) => frame_bind(
        Bool,
        Ty,
        (unified: Bool, c2: Checker) => frame_bind(
          Unit,
          Ty,
          (ignored: Unit, c3: Checker) => mut1(r, c3),
          frame_error_if(
            c2,
            "cannot infer a function type for this call",
            span_of(function),
            not(unified)
          )
        ),
        ck_unify(c1, f, TyFn(args, r, KindShared))
      ),
      ck_fresh(c),
      checked_frame_read(c, ck_fresh(c), ck_fresh_frame(c), ck_fresh_frame_errors(c), ordered),
      r => c1 => o_c1 => checked_frame_bind(
        Bool,
        Ty,
        c1,
        (unified: Bool, c2: Checker) => frame_bind(
          Unit,
          Ty,
          (ignored: Unit, c3: Checker) => mut1(r, c3),
          frame_error_if(
            c2,
            "cannot infer a function type for this call",
            span_of(function),
            not(unified)
          )
        ),
        ck_unify(c1, f, TyFn(args, r, KindShared)),
        ck_unify_run_frame_checked(c1, f, TyFn(args, r, KindShared), o_c1),
        unified => c2 => o_c2 => checked_frame_bind(
          Unit,
          Ty,
          c2,
          (ignored: Unit, c3: Checker) => mut1(r, c3),
          frame_error_if(
            c2,
            "cannot infer a function type for this call",
            span_of(function),
            not(unified)
          ),
          checked_frame_read(
            c2,
            frame_error_if(
              c2,
              "cannot infer a function type for this call",
              span_of(function),
              not(unified)
            ),
            frame_error_if_ok(
              c2,
              "cannot infer a function type for this call",
              span_of(function),
              not(unified)
            ),
            frame_error_if_ok_errors(
              c2,
              "cannot infer a function type for this call",
              span_of(function),
              not(unified)
            ),
            o_c2
          ),
          ignored => c3 => o_c3 => checked_frame_return(c3, r, o_c3)
        )
      )
    )
    TyPoly(pat_generics, pat_inner) => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
    TyApp(pat_head, pat_arg) => checked_frame_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
      checked_frame_read(
        c,
        ck_error(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ck_error_frame_errors(c, cat2(ty_show(original), " is not a function"), span_of(function)),
        ordered
      ),
      ignored => c1 => o_c1 => checked_frame_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        error_frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame_errors(c1)),
        o_c1
      )
    )
  }
}

pub theorem ck_app_result_run_frame_checked(
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  f: Ty,
  known: Option(List(Ty)),
  args: List(Ty),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_app_result(c, term, function, arguments, f, known, args)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(application_fn_unf(c, term, function, arguments, f, known, args)),
    application_fn_frame_checked(
      c,
      term,
      function,
      arguments,
      f,
      known,
      args,
      ty_unborrowed(ck_resolve(c, f)),
      ty_unborrowed(ck_resolve(c, f)),
      ordered
    )
  )
}
