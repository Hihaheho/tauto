import "checker_frame.taut"

// These views are invariant under unification, compatibility and joining.
pub fn stable_literals(c: Checker): List(TyLiteral) { c.literals }
pub fn stable_functions(c: Checker): Ordmap(Text, Scheme) { c.fns }
pub fn stable_view_literals(
  r#view: Pair(List(TyLiteral), Ordmap(Text, Scheme))
): List(TyLiteral) { (r#view: List(TyLiteral)) }
pub fn stable_view_functions(
  r#view: Pair(List(TyLiteral), Ordmap(Text, Scheme))
): Ordmap(Text, Scheme) { (r#view: Ordmap(Text, Scheme)) }

pub def StableStateFrame<A: Type>(
  c: Checker,
  m: Mut1(A, Checker)
): Prop := ck_stable_view(ck_st(m)) = ck_stable_view(c)
pub theorem grows_stable_view(
  c: Checker,
  next: Checker,
  grows: Grows(c, next)
): ck_stable_view(c) = ck_stable_view(next) {
  Eq::congr(
    ck_deferred_stable,
    And::right(And::right(And::right(And::right(And::right(And::right(grows))))))
  )
}
pub theorem stable_frame_grows<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  grows: Grows(c, ck_st(m))
): StableStateFrame(c, m) {
  Eq::sym(grows_stable_view(c, ck_st(m), grows))
}
pub theorem stable_frame_literals<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  frame: StableStateFrame(c, m)
): stable_literals(ck_st(m)) = stable_literals(c) {
  Eq::congr(stable_view_literals, frame)
}
pub theorem stable_frame_functions<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  frame: StableStateFrame(c, m)
): stable_functions(ck_st(m)) = stable_functions(c) {
  Eq::congr(stable_view_functions, frame)
}
pub theorem stable_frame_bind<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  first: StableStateFrame(c, m),
  tail: ∀ value: A. ∀ next: Checker. StableStateFrame(next, k(value, next))
): StableStateFrame(c, frame_bind(A, B, k, m)) {
  match m: StableStateFrame(
    c,
    frame_bind(A, B, k, m)
  ) { mut1(value, next) => Eq::trans(tail(value, next), first) }
}
pub theorem stable_frame_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  frame: StableStateFrame(c, m)
): StableStateFrame(c, ck_rewrap1(m)) {
  Eq::subst(
    (result: Mut1(A, Checker)) => StableStateFrame(c, result),
    Eq::sym(ck_rewrap1_id(m)),
    frame
  )
}
pub theorem ck_unify_stable_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): StableStateFrame(c, ck_unify(c, a, b)) {
  stable_frame_grows(c, ck_unify(c, a, b), And::left(ck_unify_ok(c, a, b)(ordered)))
}
pub theorem ck_fits_stable_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): StableStateFrame(c, ck_fits(c, a, b)) {
  stable_frame_grows(c, ck_fits(c, a, b), And::left(ck_fits_ok(c, a, b)(ordered)))
}
pub theorem ck_attempt_fits_stable_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): StableStateFrame(c, ck_attempt_fits(c, a, b)) {
  stable_frame_grows(c, ck_attempt_fits(c, a, b), And::left(ck_attempt_fits_ok(c, a, b)(ordered)))
}
pub theorem ck_attempt_unify_stable_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): StableStateFrame(c, ck_attempt_unify(c, a, b)) {
  stable_frame_grows(c, ck_attempt_unify(c, a, b), And::left(attempt_unify_sub(c, a, b)(ordered)))
}
pub theorem ck_join_stable_frame(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): StableStateFrame(c, ck_join(c, a, b)) {
  stable_frame_grows(c, ck_join(c, a, b), And::left(ck_join_ok(c, a, b)(ordered)))
}
