import "checker.taut"

// The rules (`docs/design/self-host.md`「層 2：`ck_fits`（`src/fits_sound.taut`、規則は `src/rules_ty.taut` の `TySub`）」): when two types are the same type
// under a substitution `s` of type variables. These rules define the contracts
// used by the soundness proofs for unification, compatibility and joins.
//
// * A bound variable is what it is bound to.
// * Types with the same constructor are the same when their parts are.
// * The two duplicable kinds of a function (`copy`, `shared`) are the same
//   type: they differ only at run time.
// * A union is its normal form (`ty_union`: flattened, sorted, without
//   repeats, `Never` dropped, one member is that member), so is a product
//   (`ty_product`: the same with `()` dropped), tags are their
//   normal form (`ty_tagged`), and `F(X)` with `F` a declared type
//   constructor is that type with one more argument (`ty_apply`).
// * Two `TyPoly` with the same kinds of generics are the same when their
//   bodies are, the generics of each read as the same new type parameters
//   (`ty_poly_map`): parameters of their own, in neither type.

// A type parameter named `n` is in `t`, with `s`'s variables replaced.
mutual {
  pub(open) inductive TyMentions(s: Ordmap(Nat, Ty), n: Text): (Ty) -> Prop {
    MenParam(k: Kind): TyMentions(s, n, TyParam(n, k))
    MenVar<t: Ty>(
      i: Nat,
      e: Ordmap::get(s, i, Ordmap::compare_nat) = Some(t),
      h: TyMentions(s, n, t)
    ): TyMentions(s, n, TyVar(i))
    MenFnParam<ps: List(
      Ty
    )>(r: Ty, k: Kind, h: TyMentionsList(s, n, ps)): TyMentions(s, n, TyFn(ps, r, k))
    MenFnResult<r: Ty>(
      ps: List(Ty),
      k: Kind,
      h: TyMentions(s, n, r)
    ): TyMentions(s, n, TyFn(ps, r, k))
    MenUnion<ts: List(Ty)>(h: TyMentionsList(s, n, ts)): TyMentions(s, n, TyUnion(ts))
    MenProduct<ts: List(Ty)>(h: TyMentionsList(s, n, ts)): TyMentions(s, n, TyProduct(ts))
    MenTagged<x: Ty>(tags: List(Text), h: TyMentions(s, n, x)): TyMentions(s, n, TyTagged(tags, x))
    MenNamed<ts: List(Ty)>(m: Text, h: TyMentionsList(s, n, ts)): TyMentions(s, n, TyNamed(m, ts))
    MenInfo<x: Ty>(h: TyMentions(s, n, x)): TyMentions(s, n, TyInfo(x))
    MenBorrow<x: Ty>(m: Bool, h: TyMentions(s, n, x)): TyMentions(s, n, TyBorrow(x, m))
    MenPoly<x: Ty>(
      gs: List(Pair(Text, Kind)),
      h: TyMentions(s, n, x)
    ): TyMentions(s, n, TyPoly(gs, x))
    MenAppHead<f: Ty>(x: Ty, h: TyMentions(s, n, f)): TyMentions(s, n, TyApp(f, x))
    MenAppArg<x: Ty>(f: Ty, h: TyMentions(s, n, x)): TyMentions(s, n, TyApp(f, x))
  }

  pub(open) inductive TyMentionsList(s: Ordmap(Nat, Ty), n: Text): (List(Ty)) -> Prop {
    MenHead<x: Ty>(xs: List(Ty), h: TyMentions(s, n, x)): TyMentionsList(s, n, Cons(x, xs))
    MenTail<xs: List(Ty)>(x: Ty, h: TyMentionsList(s, n, xs)): TyMentionsList(s, n, Cons(x, xs))
  }
}

// None of the parameters named `ns` is in `t`.
pub def RigidAbsent(
  s: Ordmap(Nat, Ty),
  ns: List(Text),
  t: Ty
): Prop := ∀ n: Text. (list_has_text(ns, n) = true) -> ¬TyMentions(s, n, t)

// `rigid` reads the generics `gs` as type parameters of their own: each
// generic is read as one, no two as the same, and none of them is in `a`
// or `b`.
pub(open) inductive RigidFor(
  s: Ordmap(Nat, Ty),
  gs: List(Pair(Text, Kind)),
  rigid: Ordmap(Text, Ty),
  a: Ty,
  b: Ty
): Prop {
  Mk(
    ns: List(Text),
    hn: ty_rigid_names(gs, rigid) = Some(ns),
    hd: text_list_distinct(ns) = true,
    ha: RigidAbsent(s, ns, a),
    hb: RigidAbsent(s, ns, b)
  ): RigidFor(s, gs, rigid, a, b)
}

// The two kinds of a function may stand for each other.
pub(open) inductive KindSame: (Kind, Kind) -> Prop {
  KindSameRefl(k: Kind): KindSame(k, k)
  KindSameDup<a: Kind, b: Kind>(
    ha: kind_dup(a) = true,
    hb: kind_dup(b) = true
  ): KindSame(a, b)
}

mutual {
  pub(open) inductive TyEq(
    s: Ordmap(Nat, Ty),
    ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop
  ): (Ty, Ty) -> Prop {
    TyeqRefl(a: Ty): TyEq(s, ok, a, a)
    TyeqSym<a: Ty, b: Ty>(h: TyEq(s, ok, a, b)): TyEq(s, ok, b, a)
    TyeqTrans<a: Ty, b: Ty, c: Ty>(h1: TyEq(s, ok, a, b), h2: TyEq(s, ok, b, c)): TyEq(s, ok, a, c)
    TyeqVar<t: Ty>(
      i: Nat,
      e: Ordmap::get(s, i, Ordmap::compare_nat) = Some(t)
    ): TyEq(s, ok, TyVar(i), t)
    TyeqFn<ps: List(
      Ty
    ), qs: List(
      Ty
    ), r: Ty, r2: Ty, k: Kind, k2: Kind>(
      hp: TyEqList(s, ok, ps, qs),
      hr: TyEq(s, ok, r, r2),
      hk: KindSame(k, k2)
    ): TyEq(s, ok, TyFn(ps, r, k), TyFn(qs, r2, k2))
    TyeqUnion<xs: List(
      Ty
    ), ys: List(Ty)>(h: TyEqList(s, ok, xs, ys)): TyEq(s, ok, TyUnion(xs), TyUnion(ys))
    TyeqUnionNorm(xs: List(Ty)): TyEq(s, ok, TyUnion(xs), ty_union(xs))
    TyeqProduct<xs: List(
      Ty
    ), ys: List(Ty)>(h: TyEqList(s, ok, xs, ys)): TyEq(s, ok, TyProduct(xs), TyProduct(ys))
    TyeqProductNorm(xs: List(Ty)): TyEq(s, ok, TyProduct(xs), ty_product(xs))
    TyeqTagged<x: Ty, y: Ty>(
      tags: List(Text),
      h: TyEq(s, ok, x, y)
    ): TyEq(s, ok, TyTagged(tags, x), TyTagged(tags, y))
    TyeqTaggedNorm(tags: List(Text), x: Ty): TyEq(s, ok, TyTagged(tags, x), ty_tagged(tags, x))
    TyeqNamed<xs: List(
      Ty
    ), ys: List(
      Ty
    )>(n: Text, h: TyEqList(s, ok, xs, ys)): TyEq(s, ok, TyNamed(n, xs), TyNamed(n, ys))
    TyeqInfo<x: Ty, y: Ty>(h: TyEq(s, ok, x, y)): TyEq(s, ok, TyInfo(x), TyInfo(y))
    TyeqBorrow<x: Ty, y: Ty>(
      m: Bool,
      h: TyEq(s, ok, x, y)
    ): TyEq(s, ok, TyBorrow(x, m), TyBorrow(y, m))
    TyeqApp<h1: Ty, h2: Ty, x1: Ty, x2: Ty>(
      hh: TyEq(s, ok, h1, h2),
      hx: TyEq(s, ok, x1, x2)
    ): TyEq(s, ok, TyApp(h1, x1), TyApp(h2, x2))
    TyeqAppNorm(h: Ty, x: Ty): TyEq(s, ok, TyApp(h, x), ty_apply(h, x))
    TyeqPolyBody<x: Ty, y: Ty>(
      gs: List(Pair(Text, Kind)),
      h: TyEq(s, ok, x, y)
    ): TyEq(s, ok, TyPoly(gs, x), TyPoly(gs, y))
    TyeqPoly<ta: Ty, tb: Ty>(
      ga: List(Pair(Text, Kind)),
      gb: List(Pair(Text, Kind)),
      rigid: Ordmap(Text, Ty),
      hk: ty_kinds_match(ga, gb) = true,
      hr: ok(ga, rigid, TyPoly(ga, ta), TyPoly(gb, tb)),
      h: TyEq(s, ok, ty_substitute(ta, rigid), ty_substitute(tb, ty_poly_map(gb, ga, rigid)))
    ): TyEq(s, ok, TyPoly(ga, ta), TyPoly(gb, tb))
  }

  pub(open) inductive TyEqList(
    s: Ordmap(Nat, Ty),
    ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop
  ): (List(Ty), List(Ty)) -> Prop {
    TyeqNil: TyEqList(s, ok, Nil, Nil)
    TyeqCons<x: Ty, y: Ty, xs: List(
      Ty
    ), ys: List(
      Ty
    )>(h: TyEq(s, ok, x, y), hs: TyEqList(s, ok, xs, ys)): TyEqList(s, ok, Cons(x, xs), Cons(y, ys))
  }
}

// `s2` binds every variable `s` binds, to the same type.
pub def SubstExt(
  s: Ordmap(Nat, Ty),
  s2: Ordmap(Nat, Ty)
): Prop := ∀ i: Nat. ∀ t: Ty. (
  Ordmap::get(s, i, Ordmap::compare_nat) = Some(t)
) -> (Ordmap::get(s2, i, Ordmap::compare_nat) = Some(t))

// The rules with the rigid types of each `TyeqPoly` kept out of the two
// types under `s` itself: what the unifier is sound against. A proof goes
// through `TyEq` with `ok` the uses the checker recorded, and the checker
// checks them all again with the substitution it ends with.
pub def TyEqIn(
  s: Ordmap(Nat, Ty),
  a: Ty,
  b: Ty
): Prop := TyEq(
  s,
  (gs: List(Pair(Text, Kind)), rigid: Ordmap(Text, Ty), x: Ty, y: Ty) => RigidFor(
    s,
    gs,
    rigid,
    x,
    y
  ),
  a,
  b
)

// When a value of type `a` may stand where `b` is expected, under `s`
// (`docs/design/self-host.md`
// 「層 2：`ck_fits`（`src/fits_sound.taut`、規則は `src/rules_ty.taut` の `TySub`）」).
// `ok` is as for `TyEq`; `inst` says which instances of a generic type may be
// taken (the checker records a kind bound for each, checked at the end); `dup`
// says which types are duplicable.
//
// * The same type fits, and fitting is transitive.
// * `Never` fits anywhere.
// * A generic type is wanted: `a` fits it when it fits the body with the
//   generics read as rigid types. A generic type is given: some instance of
//   it fits.
// * A borrow fits a borrow of what it borrows fits; a `&mut` may be lent as a
//   `&`. A borrow fits where its referent does (whether it may be used so is
//   the linearity rules'). A duplicable type fits where a borrow of it is
//   wanted.
// * A union fits when each member does; a type fits a union when it fits a
//   member.
// * Tags are forgotten, never added.
// * Functions: contravariant in the parameters, covariant in the result, and
//   a function of a kind may stand for one of a kind it fits (`kind_fits`).
mutual {
  pub(open) inductive TySub(
    s: Ordmap(Nat, Ty),
    ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
    inst: (List(Pair(Text, Kind)), Ordmap(Text, Ty)) -> Prop,
    dup: (Ty) -> Prop
  ): (Ty, Ty) -> Prop {
    TysubEq<a: Ty, b: Ty>(h: TyEq(s, ok, a, b)): TySub(s, ok, inst, dup, a, b)
    TysubTrans<a: Ty, b: Ty, c: Ty>(
      h1: TySub(s, ok, inst, dup, a, b),
      h2: TySub(s, ok, inst, dup, b, c)
    ): TySub(s, ok, inst, dup, a, c)
    TysubNever(b: Ty): TySub(s, ok, inst, dup, TyNever, b)
    TysubPolyR<a: Ty>(
      gs: List(Pair(Text, Kind)),
      t: Ty,
      rigid: Ordmap(Text, Ty),
      h: TySub(s, ok, inst, dup, a, ty_substitute(t, rigid)),
      hr: ok(gs, rigid, a, TyPoly(gs, t))
    ): TySub(s, ok, inst, dup, a, TyPoly(gs, t))
    TysubPolyL<b: Ty>(
      gs: List(Pair(Text, Kind)),
      t: Ty,
      map: Ordmap(Text, Ty),
      h: TySub(s, ok, inst, dup, ty_substitute(t, map), b),
      hi: inst(gs, map)
    ): TySub(s, ok, inst, dup, TyPoly(gs, t), b)
    TysubBorrow<x: Ty, y: Ty>(
      ma: Bool,
      mb: Bool,
      hm: Bool::or(Bool::eq(ma, mb), not(mb)) = true,
      h: TySub(s, ok, inst, dup, x, y)
    ): TySub(s, ok, inst, dup, TyBorrow(x, ma), TyBorrow(y, mb))
    TysubUnborrow<x: Ty, b: Ty>(
      m: Bool,
      h: TySub(s, ok, inst, dup, x, b)
    ): TySub(s, ok, inst, dup, TyBorrow(x, m), b)
    TysubDup<a: Ty, y: Ty>(
      m: Bool,
      h: TySub(s, ok, inst, dup, a, y),
      hd: dup(a)
    ): TySub(s, ok, inst, dup, a, TyBorrow(y, m))
    TysubUnionL<b: Ty>(
      xs: List(Ty),
      h: TySubEach(s, ok, inst, dup, b, xs)
    ): TySub(s, ok, inst, dup, TyUnion(xs), b)
    TysubUnionR<a: Ty>(
      ys: List(Ty),
      h: TySubAny(s, ok, inst, dup, a, ys)
    ): TySub(s, ok, inst, dup, a, TyUnion(ys))
    TysubTagged<x: Ty, y: Ty>(
      ta: List(Text),
      tb: List(Text),
      ht: tags_subset(tb, ta) = true,
      h: TySub(s, ok, inst, dup, x, y)
    ): TySub(s, ok, inst, dup, TyTagged(ta, x), TyTagged(tb, y))
    TysubUntag<x: Ty, b: Ty>(
      ta: List(Text),
      h: TySub(s, ok, inst, dup, x, b)
    ): TySub(s, ok, inst, dup, TyTagged(ta, x), b)
    TysubFn<pa: List(
      Ty
    ), pb: List(
      Ty
    ), ra: Ty, rb: Ty>(
      ka: Kind,
      kb: Kind,
      hk: kind_fits(ka, kb) = true,
      hp: TySubList(s, ok, inst, dup, pb, pa),
      hr: TySub(s, ok, inst, dup, ra, rb)
    ): TySub(s, ok, inst, dup, TyFn(pa, ra, ka), TyFn(pb, rb, kb))
  }

  // Each of the first list fits the one of the second at its place.
  pub(open) inductive TySubList(
    s: Ordmap(Nat, Ty),
    ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
    inst: (List(Pair(Text, Kind)), Ordmap(Text, Ty)) -> Prop,
    dup: (Ty) -> Prop
  ): (List(Ty), List(Ty)) -> Prop {
    TysubNil: TySubList(s, ok, inst, dup, Nil, Nil)
    TysubCons<x: Ty, y: Ty, xs: List(
      Ty
    ), ys: List(
      Ty
    )>(
      h: TySub(s, ok, inst, dup, x, y),
      hs: TySubList(s, ok, inst, dup, xs, ys)
    ): TySubList(s, ok, inst, dup, Cons(x, xs), Cons(y, ys))
  }

  // Each of the list fits `b`.
  pub(open) inductive TySubEach(
    s: Ordmap(Nat, Ty),
    ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
    inst: (List(Pair(Text, Kind)), Ordmap(Text, Ty)) -> Prop,
    dup: (Ty) -> Prop
  ): (Ty, List(Ty)) -> Prop {
    TysubEachNil(b: Ty): TySubEach(s, ok, inst, dup, b, Nil)
    TysubEachCons<b: Ty, x: Ty, xs: List(
      Ty
    )>(
      h: TySub(s, ok, inst, dup, x, b),
      hs: TySubEach(s, ok, inst, dup, b, xs)
    ): TySubEach(s, ok, inst, dup, b, Cons(x, xs))
  }

  // `a` fits one of the list.
  pub(open) inductive TySubAny(
    s: Ordmap(Nat, Ty),
    ok: (List(Pair(Text, Kind)), Ordmap(Text, Ty), Ty, Ty) -> Prop,
    inst: (List(Pair(Text, Kind)), Ordmap(Text, Ty)) -> Prop,
    dup: (Ty) -> Prop
  ): (Ty, List(Ty)) -> Prop {
    TysubAnyHere<a: Ty, y: Ty>(
      ys: List(Ty),
      h: TySub(s, ok, inst, dup, a, y)
    ): TySubAny(s, ok, inst, dup, a, Cons(y, ys))
    TysubAnyThere<a: Ty, ys: List(
      Ty
    )>(y: Ty, h: TySubAny(s, ok, inst, dup, a, ys)): TySubAny(s, ok, inst, dup, a, Cons(y, ys))
  }
}
