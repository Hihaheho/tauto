// What a numeral that does not read as `name` (`Nat` or `Int`) is reported as.
pub fn numeral_not_message(name: Text, value: Text): Text {
  match name == "Int" {
    true => not_an_int_message(value)
    false => not_a_nat_message(value)
  }
}

