}

// What refuses `name := v` (`deref` false) or `*name := v` (`deref` true) where `name` is
// neither a `var` nor a `&mut` borrow.
pub fn binding_refused_message(name: Text, deref: Bool): Text {
  match deref {
    true => deref_needs_mut_borrow_message(name)
    false => not_a_var_message(name)
  }
}

