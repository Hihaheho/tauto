pub fn type_not_determined_message(generics: List(Text), name: Text): Text {
  msg2(
    "nibcheck-type-not-determined",
    marg("generics", type_not_determined_quoted(generics)),
    marg("name", name)
  )
}

pub fn type_not_determined_quoted(gs: List(Text)): Text {
  match gs {
    Nil => ""
    Cons(g, rest) => ⊢ Text from match rest {
      Nil => Text::concat_all(Cons("`", Cons(g, Cons("`", Nil))))
      Cons(^h, ^more) => Text::concat_all(
        Cons("`", Cons(g, Cons("`, ", Cons(type_not_determined_quoted(rest), Nil))))
      )
    }
  }
}

