import std::base
import std::text

// A diagnostic is a message of the toolchain: an id and its arguments, which
// `crates/tauto-messages/locales` writes in each language. The tote does not
// write the text: it gives the message as `id(name: "value", …)`, the form
// `tauto_message::Message` has when no writer is set, so that it matches what
// the Rust checker says id for id and argument for argument.

// The bytes of a text as a Rust `{:?}` writes them: `"`, `\` and the line
// breaks escaped.
pub fn msg_escape(bs: List(Nat)): List(Nat) {
  match bs {
    Nil => Nil
    Cons(b, rest) => if b == 34 {
      Cons(92, Cons(34, msg_escape(rest)))
    } else {
      if b == 92 {
        Cons(92, Cons(92, msg_escape(rest)))
      } else {
        if b == 10 {
          Cons(92, Cons(110, msg_escape(rest)))
        } else {
          if b == 13 {
            Cons(92, Cons(114, msg_escape(rest)))
          } else {
            if b == 9 { Cons(92, Cons(116, msg_escape(rest))) } else { Cons(b, msg_escape(rest)) }
          }
        }
      }
    }
  }
}

pub fn msg_quote(t: Text): Text {
  match Text::of_utf8(msg_escape(Text::bytes(t))) {
    Some(e) => Text::concat_all(Cons("\"", Cons(e, Cons("\"", Nil))))
    None => "\"\""
  }
}

// `id`, for a message without arguments.
pub fn msg0(id: Text): Text {
  id
}

// `name: "value"`, an argument that is a text.
pub fn marg(name: Text, value: Text): Text {
  Text::concat_all(Cons(name, Cons(": ", Cons(msg_quote(value), Nil))))
}

// `name: id(…)`, an argument that is a message.
pub fn marg_msg(name: Text, message: Text): Text {
  Text::concat_all(Cons(name, Cons(": ", Cons(message, Nil))))
}

// `name: 3`, an argument that is a number.
pub fn marg_num(name: Text, value: Nat): Text {
  Text::concat_all(Cons(name, Cons(": ", Cons(Text::of_nat(value), Nil))))
}

pub fn msg_join(args: List(Text)): Text {
  match args {
    Nil => ""
    Cons(a, rest) => ⊢ Text from match rest {
      Nil => a
      Cons(^b, ^more) => Text::concat_all(Cons(a, Cons(", ", Cons(msg_join(rest), Nil))))
    }
  }
}

// `id(arg, …)`, with the arguments made by `marg`, `marg_msg` and `marg_num`.
pub fn msg_with(id: Text, args: List(Text)): Text {
  Text::concat_all(Cons(id, Cons("(", Cons(msg_join(args), Cons(")", Nil)))))
}

pub fn msg1(id: Text, a: Text): Text {
  msg_with(id, Cons(a, Nil))
}

pub fn msg2(id: Text, a: Text, b: Text): Text {
  msg_with(id, Cons(a, Cons(b, Nil)))
}

pub fn msg3(id: Text, a: Text, b: Text, c: Text): Text {
  msg_with(id, Cons(a, Cons(b, Cons(c, Nil))))
}

pub fn msg4(id: Text, a: Text, b: Text, c: Text, d: Text): Text {
  msg_with(id, Cons(a, Cons(b, Cons(c, Cons(d, Nil)))))
}

pub fn msg5(id: Text, a: Text, b: Text, c: Text, d: Text, e: Text): Text {
  msg_with(id, Cons(a, Cons(b, Cons(c, Cons(d, Cons(e, Nil))))))
}

