import std::map
import "freevars.taut"
import "../../surface/src/surface.taut"
import std::base
import std::text
import "checker.taut"
import "datas.taut"
import "ty.taut"
import "../../text/src/text.taut"
import "../../identity/src/identity.taut"

// `module M { … }` and the names `M::f` (`crates/tauto-surface/src/surface/modules.rs`), in the proof
// language (`docs/design/self-host.md`「nibcheck soundness (`totes/nibcheck/src/`)」): modules are flattened where the program is
// read, so what follows sees plain names with `::` in them (`File::open`).
// Functions (and the functions of `extern` blocks) and types (`struct`,
// `enum`) take the module's name: a type `T` of `module M` is `M::T`, written
// `T` inside the module, in a signature, a field or a `let` as anywhere else.
// An enum's constructors take its type's name (`M::T::C`), and `T::C` or a
// bare `C` written in the module names them.

pub(open) inductive ModState: Type {
  ModStateMk(
    // Every module, by its full path (`A::B`).
    modules: Ordmap(Text, Bool),
    // Every function in a module, by its full name (`A::B::f`).
    fns: Ordmap(Text, Bool),
    // Every type in a module, by its full name (`A::T`).
    types: Ordmap(Text, Bool),
    // The constructors of the types in a module, by the module and the short
    // name (`A::C`), each with its full name (`A::T::C`); a short name two
    // types of the module share names neither (`None`).
    ctors: Ordmap(Text, Option(Text)),
    // The full names of the constructors `ctors` names.
    ctor_fulls: Ordmap(Text, Bool),
    locals: List(Text),
    errors: List(TypeError)
  ): ModState
}

pub(open) inductive ModResolved: Type {
  ModResolvedMk(stmts: List(SurfaceStmt), errors: List(TypeError)): ModResolved
}

pub fn mod_join(path: List(Text), name: Text): Text {
  match path {
    Nil => name
    Cons(p, rest) => Text::concat_all(
      Cons(text_join(Cons(p, rest), "::"), Cons("::", Cons(name, Nil)))
    )
  }
}

pub fn mod_take(n: Nat, path: List(Text)): List(Text) {
  match n {
    Zero => Nil
    Succ(m) => ⊢ List(Text) from match path {
      Nil => Nil
      Cons(p, rest) => Cons(p, mod_take(m, rest))
    }
  }
}

pub fn mod_error(s: &mut ModState, message: Text, start: Nat, end: Nat): Unit {
  *s := ModState {
    modules: s.modules,
    fns: s.fns,
    types: s.types,
    ctors: s.ctors,
    ctor_fulls: s.ctor_fulls,
    locals: s.locals,
    errors: Cons(TypeError { message: message, start: start, end: end }, s.errors)
  }
}

pub fn stmt_is_module(st: SurfaceStmt): Bool {
  match st {
    _ => false
  }
}

pub fn mod_has_module(stmts: List(SurfaceStmt)): Bool {
  match stmts {
    Nil => false
    Cons(st, rest) => stmt_is_module(st) || mod_has_module(rest)
  }
}

pub fn mod_add_fn(s: &mut ModState, path: List(Text), name: Text): Unit {
  match path {
    Nil => #()
    Cons(p, rest) => {
      *s := ModState {
        modules: s.modules,
        fns: Ordmap::insert(s.fns, mod_join(Cons(p, rest), name), true, Ordmap::compare_text),
        types: s.types,
        ctors: s.ctors,
        ctor_fulls: s.ctor_fulls,
        locals: s.locals,
        errors: s.errors
      }
    }
  }
}

pub fn mod_add_fns(fns: List(SurfaceFn), s: &mut ModState, path: List(Text)): Unit {
  match fns {
    Nil => #()
    Cons(f, rest) => {
      mod_add_fn(&mut s, path, f.name)
      mod_add_fns(rest, &mut s, path)
    }
  }
}

pub fn mod_add_module(
  s: &mut ModState,
  classes: Ordmap(Text, Bool),
  path: List(Text),
  name: Text,
  a: Nat,
  b: Nat
): Unit {
  let full := mod_join(path, name)
  // A class's members are the flat names `Class.member`, so a module of the
  // same name would put its functions among them.
  if Ordmap::contains(classes, full, Ordmap::compare_text) {
    mod_error(&mut s, cat4("module ", full, " collides with class ", full), a, b)
  } else {
    #()
  }
  // A module may be opened again (`module Text { … }` in several files of
  // the prelude): its functions join the ones it already has.
  *s := ModState {
    modules: Ordmap::insert(s.modules, full, true, Ordmap::compare_text),
    fns: s.fns,
    types: s.types,
    ctors: s.ctors,
    ctor_fulls: s.ctor_fulls,
    locals: s.locals,
    errors: s.errors
  }
}

pub fn mod_add_ctor(s: &mut ModState, path: List(Text), full: Text, c: Text): Unit {
  let ctor := cat3(full, "::", c)
  let key := mod_join(path, c)
  let named: Option(Text) := ⊢ Option(Text) from match Ordmap::get(s.ctors, key, Ordmap::compare_text) {
    None => Some(ctor)
    Some(^seen) => None
  }
  *s := ModState {
    modules: s.modules,
    fns: Ordmap::insert(s.fns, ctor, true, Ordmap::compare_text),
    types: s.types,
    ctors: Ordmap::insert(s.ctors, key, named, Ordmap::compare_text),
    ctor_fulls: Ordmap::insert(s.ctor_fulls, ctor, true, Ordmap::compare_text),
    locals: s.locals,
    errors: s.errors
  }
}

pub fn mod_add_ctors(
  cs: List(SurfaceDataCtor),
  s: &mut ModState,
  path: List(Text),
  name: Text,
  full: Text
): Unit {
  match cs {
    Nil => #()
    Cons(k, rest) => {
      if k.name == name { #() } else { mod_add_ctor(&mut s, path, full, k.name) }
      mod_add_ctors(rest, &mut s, path, name, full)
    }
  }
}

// A type of a module (`J::E`) and its constructors (`J::E::One`), as
// `type_in` of the Rust resolver names them.
pub fn mod_add_type(s: &mut ModState, path: List(Text), d: SurfaceData): Unit {
  match path {
    Nil => #()
    Cons(^p, ^rest) => {
      let full := mod_join(path, d.name)
      *s := ModState {
        modules: s.modules,
        fns: Ordmap::insert(s.fns, full, true, Ordmap::compare_text),
        types: Ordmap::insert(s.types, full, true, Ordmap::compare_text),
        ctors: s.ctors,
        ctor_fulls: s.ctor_fulls,
        locals: s.locals,
        errors: s.errors
      }
      mod_add_ctors(d.constructors, &mut s, path, d.name, full)
    }
  }
}

mutual {
  pub fn mod_collect(
    stmts: List(SurfaceStmt),
    s: &mut ModState,
    classes: Ordmap(Text, Bool),
    path: List(Text)
  ): Unit {
    match stmts {
      Nil => #()
      Cons(st, rest) => {
        mod_collect_one(st, &mut s, classes, path)
        mod_collect(rest, &mut s, classes, path)
      }
    }
  }

  pub fn mod_collect_one(
    st: SurfaceStmt,
    s: &mut ModState,
    classes: Ordmap(Text, Bool),
    path: List(Text)
  ): Unit {
    match st {
      StFn(f) => mod_add_fn(&mut s, path, f.name)
      StExtern(fns, ^instances, ^types, ^structs, ^enums, ^a, ^b) => mod_add_fns(fns, &mut s, path)
      StStruct(d) => mod_add_type(&mut s, path, d)
      StEnum(d) => mod_add_type(&mut s, path, d)
      _ => #()
    }
  }
}

pub fn mod_is_local(names: List(Text), name: Text): Bool {
  match names {
    Nil => false
    Cons(first, rest) => first == name || mod_is_local(rest, name)
  }
}

// The full name of `name` written in the module `path`: the innermost module
// that has it, then the outer ones, then the top level.
pub fn mod_name_from(n: Nat, s: ModState, name: Text, path: List(Text)): Text {
  match n {
    Zero => name
    Succ(m) => if Ordmap::contains(
      s.fns,
      mod_join(mod_take(Succ(m), path), name),
      Ordmap::compare_text
    ) {
      mod_join(mod_take(Succ(m), path), name)
    } else {
      ⊢ Text from match Ordmap::get(
        s.ctors,
        mod_join(mod_take(Succ(m), path), name),
        Ordmap::compare_text
      ) {
        Some(named) => ⊢ Text from match named {
          Some(ctor) => ctor
          None => mod_name_from(m, s, name, path)
        }
        None => mod_name_from(m, s, name, path)
      }
    }
  }
}

pub fn mod_name(s: ModState, name: Text, path: List(Text)): Text {
  if mod_is_local(s.locals, name) { name } else { mod_name_from(list_len(path), s, name, path) }
}

pub fn mod_module_from(n: Nat, s: ModState, m: Text, path: List(Text)): Option(Text) {
  match n {
    Zero => if Ordmap::contains(s.modules, m, Ordmap::compare_text) { Some(m) } else { None }
    Succ(k) => if Ordmap::contains(
      s.modules,
      mod_join(mod_take(Succ(k), path), m),
      Ordmap::compare_text
    ) {
      Some(mod_join(mod_take(Succ(k), path), m))
    } else {
      mod_module_from(k, s, m, path)
    }
  }
}

pub fn mod_module(s: ModState, m: Text, path: List(Text)): Option(Text) {
  mod_module_from(list_len(path), s, m, path)
}

mutual {
  pub fn mod_dotted(t: SurfaceTerm): Option(List(Text)) {
    match t {
      SurfaceTermIndexedMk(sk, ^start, ^end, ^ast_occurrence) => mod_dotted_kind(sk)
    }
  }

  pub fn mod_dotted_kind(sk: SurfaceKind): Option(List(Text)) {
    match sk {
      SkVar(n) => Some(Cons(surface_name_text(n), Nil))
      SkField(base, name) => ⊢ Option(List(Text)) from match mod_dotted(base) {
        Some(parts) => Some(List::append(parts, Cons(name, Nil)))
        None => None
      }
      _ => None
    }
  }
}

pub fn mod_check_local(s: &mut ModState, name: Text, path: List(Text), start: Nat, end: Nat): Unit {
  match mod_module(s, name, path) {
    Some(^m) => mod_error(&mut s, cat3(name, " is the name of a module", ""), start, end)
    None => #()
  }
}

pub fn mod_check_locals(
  names: List(Text),
  s: &mut ModState,
  path: List(Text),
  start: Nat,
  end: Nat
): Unit {
  match names {
    Nil => #()
    Cons(n, rest) => {
      mod_check_local(&mut s, n, path, start, end)
      mod_check_locals(rest, &mut s, path, start, end)
    }
  }
}

pub fn mod_bind_names(
  names: List(Text),
  s: &mut ModState,
  path: List(Text),
  start: Nat,
  end: Nat
): Unit {
  mod_check_locals(names, &mut s, path, start, end)
  let outer := s.locals
  set_to(&mut s.locals, List::append(names, outer))
}

pub fn mod_optional_name(name: Option(Text)): List(Text) {
  match name {
    None => Nil
    Some(value) => Cons(value, Nil)
  }
}

pub fn mod_dots(parts: List(Text)): List(Text) {
  match parts {
    Nil => Nil
    Cons(p, rest) => Cons("::", Cons(p, mod_dots(rest)))
  }
}

pub fn mod_qualified(s: ModState, parts: List(Text), path: List(Text)): Option(Text) {
  match parts {
    Nil => None
    Cons(first, rest) => if mod_is_local(s.locals, first) {
      None
    } else {
      ⊢ Option(Text) from match mod_module(s, first, path) {
        Some(full) => Some(Text::concat_all(Cons(full, mod_dots(rest))))
        None => {
          // `T::C` inside the module of `T`: the first part a type of a module.
          let t := mod_name(s, first, path)
          if Ordmap::contains(s.types, t, Ordmap::compare_text) {
            Some(Text::concat_all(Cons(t, mod_dots(rest))))
          } else {
            None
          }
        }
      }
    }
  }
}

// A name written with `::` in one variable (`E::One`), or a plain name.
pub fn mod_var_name(s: ModState, n: Text, path: List(Text)): Text {
  let parts := text_split(n, "::")
  ⊢ Text from match parts {
    Cons(^first, more) => ⊢ Text from match more {
      Nil => mod_name(s, n, path)
      Cons(^m, ^ms) => ⊢ Text from match mod_qualified(s, parts, path) {
        Some(full) => full
        None => n
      }
    }
    Nil => mod_name(s, n, path)
  }
}

// A constructor's or a struct's name as written in a pattern or a record,
// read in the module `path`.
pub fn mod_ctor_name(s: ModState, n: Text, path: List(Text)): Text {
  mod_var_name(s, n, path)
}

// A constructor without fields, written bare (`C` of `M::T::C`).
pub fn mod_bare_pattern(s: ModState, n: Text, path: List(Text), p: SurfacePattern): SurfacePattern {
  let full := mod_name(s, n, path)
  if full != n && Ordmap::contains(s.ctor_fulls, full, Ordmap::compare_text) {
    PtCtor(NameSpelled(full), Nil)
  } else {
    p
  }
}

// A constructor's name in a pattern; `@a`, a label, names no declaration.
pub fn mod_pattern_ctor(s: ModState, name: Text, path: List(Text)): Text {
  if text_starts_with(name, "@", 0) { name } else { mod_ctor_name(s, name, path) }
}

mutual {
  pub fn mod_pattern(s: ModState, p: SurfacePattern, path: List(Text)): SurfacePattern {
    match p {
      PtCtor(name, args) => PtCtor(NameSpelled(mod_pattern_ctor(s, surface_name_text(name), path)), mod_patterns(s, args, path))
      PtRecord(name, fields) => PtRecord(mod_ctor_name(s, name, path), mod_pattern_fields(s, fields, path))
      PtBind(n, _) => mod_bare_pattern(s, n, path, p)
      _ => p
    }
  }

  pub fn mod_patterns(
    s: ModState,
    ps: List(SurfacePattern),
    path: List(Text)
  ): List(SurfacePattern) {
    match ps {
      Nil => Nil
      Cons(p, rest) => Cons(mod_pattern(s, p, path), mod_patterns(s, rest, path))
    }
  }

  pub fn mod_pattern_fields(
    s: ModState,
    fs: List(SurfacePatternField),
    path: List(Text)
  ): List(SurfacePatternField) {
    match fs {
      Nil => Nil
      Cons(f, rest) => Cons(mod_pattern_field(s, f, path), mod_pattern_fields(s, rest, path))
    }
  }

  pub fn mod_pattern_field(s: ModState, f: SurfacePatternField, path: List(Text)): SurfacePatternField {
    match f {
      SurfacePatternFieldMk(name, p) => SurfacePatternField { name: name, pattern: mod_pattern(s, p, path) }
    }
  }
}

pub fn mod_qualified_kind(s: ModState, sk: SurfaceKind, path: List(Text)): Option(Text) {
  match sk {
    SkField(^base, ^name) => ⊢ Option(Text) from match mod_dotted_kind(sk) {
      Some(parts) => mod_qualified(s, parts, path)
      None => None
    }
    _ => None
  }
}

mutual {
  pub fn mod_term(t: SurfaceTerm, s: &mut ModState, path: List(Text)): SurfaceTerm {
    match t {
      SurfaceTermIndexedMk(sk, start, end, ^ast_occurrence) => ⊢ SurfaceTerm from match mod_qualified_kind(
        s,
        sk,
        path
      ) {
        Some(full) => SurfaceTerm { occurrence: None, kind: SkVar(NameSpelled(full)), start: start, end: end }
        None => {
          let k2 := mod_kind(sk, &mut s, path, sk, start, end)
          SurfaceTerm { occurrence: None, kind: k2, start: start, end: end }
        }
      }
    }
  }

  pub fn mod_kind(
    sk: SurfaceKind,
    s: &mut ModState,
    path: List(Text),
    whole: SurfaceKind,
    start: Nat,
    end: Nat
  ): SurfaceKind {
    match sk {
      SkVar(n) => SkVar(NameSpelled(mod_var_name(s, surface_name_text(n), path)))
      SkApp(f, args) => {
        let f2 := mod_term(f, &mut s, path)
        let args2 := mod_terms(args, &mut s, path)
        SkApp(f2, args2)
      }
      SkLam(params, body, types, unused) => {
        let outer := s.locals
        let types2 := mod_opt_terms(types, &mut s, path)
        mod_bind_names(params, &mut s, path, start, end)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        SkLam(params, b, types2, unused)
      }
      SkBorrowLam(r#borrows, lam) => {
        let l := mod_term(lam, &mut s, path)
        SkBorrowLam(r#borrows, l)
      }
      SkBorrow(m, m_orig, x) => {
        let x2 := mod_term(x, &mut s, path)
        SkBorrow(m, m_orig, x2)
      }
      SkTagged(tag, x) => {
        let x2 := mod_term(x, &mut s, path)
        SkTagged(tag, x2)
      }
      SkRecord(name, fields) => {
        let fs := mod_fields(fields, &mut s, path)
        SkRecord(mod_ctor_name(s, name, path), fs)
      }
      SkIf(c, th, el) => {
        let c2 := mod_term(c, &mut s, path)
        let t2 := mod_term(th, &mut s, path)
        let e2 := mod_opt_term(el, &mut s, path)
        SkIf(c2, t2, e2)
      }
      SkField(base, name) => {
        let b := mod_term(base, &mut s, path)
        SkField(b, name)
      }
      SkPerform(eff, args) => {
        let args2 := mod_terms(args, &mut s, path)
        SkPerform(eff, args2)
      }
      SkBudget(steps_memory, steps, body) => {
        let a := mod_term(steps, &mut s, path)
        let b := mod_term(body, &mut s, path)
        SkBudget(steps_memory, a, b)
      }
      SkBlock(stmts) => {
        let outer := s.locals
        let ss := mod_stmts(stmts, &mut s, path)
        set_to(&mut s.locals, outer)
        SkBlock(ss)
      }
      SkHandle(body, handlers) => {
        let b := mod_term(body, &mut s, path)
        let hs := mod_handlers(handlers, &mut s, path)
        SkHandle(b, hs)
      }
      SkMatch(scrutinee, r, arms, binder, _) => {
        let sc := mod_term(scrutinee, &mut s, path)
        let result := mod_opt_term(r, &mut s, path)
        let outer := s.locals
        mod_bind_names(mod_optional_name(binder), &mut s, path, start, end)
        let as2 := mod_arms(arms, &mut s, path)
        set_to(&mut s.locals, outer)
        SkMatch(sc, result, as2, binder, None)
      }
      _ => whole
    }
  }

  pub fn mod_terms(ts: List(SurfaceTerm), s: &mut ModState, path: List(Text)): List(SurfaceTerm) {
    match ts {
      Nil => Nil
      Cons(t, rest) => {
        let h := mod_term(t, &mut s, path)
        let tl := mod_terms(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_opt_term(
    t: Option(SurfaceTerm),
    s: &mut ModState,
    path: List(Text)
  ): Option(SurfaceTerm) {
    match t {
      None => None
      Some(x) => {
        let x2 := mod_term(x, &mut s, path)
        Some(x2)
      }
    }
  }

  pub fn mod_opt_terms(
    ts: List(Option(SurfaceTerm)),
    s: &mut ModState,
    path: List(Text)
  ): List(Option(SurfaceTerm)) {
    match ts {
      Nil => Nil
      Cons(t, rest) => {
        let t2 := mod_opt_term(t, &mut s, path)
        let rest2 := mod_opt_terms(rest, &mut s, path)
        Cons(t2, rest2)
      }
    }
  }

  pub fn mod_fields(
    fs: List(SurfaceField),
    s: &mut ModState,
    path: List(Text)
  ): List(SurfaceField) {
    match fs {
      Nil => Nil
      Cons(f, rest) => {
        let h := mod_field(f, &mut s, path)
        let tl := mod_fields(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_field(f: SurfaceField, s: &mut ModState, path: List(Text)): SurfaceField {
    match f {
      SurfaceFieldMk(name, value) => {
        let v := mod_term(value, &mut s, path)
        SurfaceField { name: name, value: v }
      }
    }
  }

  pub fn mod_handlers(
    hs: List(SurfaceHandler),
    s: &mut ModState,
    path: List(Text)
  ): List(SurfaceHandler) {
    match hs {
      Nil => Nil
      Cons(h, rest) => {
        let h2 := mod_handler(h, &mut s, path)
        let tl := mod_handlers(rest, &mut s, path)
        Cons(h2, tl)
      }
    }
  }

  pub fn mod_handler(h: SurfaceHandler, s: &mut ModState, path: List(Text)): SurfaceHandler {
    match h {
      HdReturn(written, body) => {
        let p := mod_pattern(s, written, path)
        let outer := s.locals
        mod_bind_names(pattern_names(p, Nil), &mut s, path, body.start, body.end)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        HdReturn(p, b)
      }
      HdOperation(eff, hfa, hty, ps, cont, _, guard, body) => {
        let outer := s.locals
        mod_bind_names(
          List::append(pattern_names_each(ps, Nil), mod_optional_name(cont)),
          &mut s,
          path,
          body.start,
          body.end
        )
        let g := mod_opt_term(guard, &mut s, path)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        HdOperation(eff, hfa, hty, ps, cont, None, g, b)
      }
    }
  }

  pub fn mod_arms(arms: List(SurfaceArm), s: &mut ModState, path: List(Text)): List(SurfaceArm) {
    match arms {
      Nil => Nil
      Cons(a, rest) => {
        let h := mod_arm(a, &mut s, path)
        let tl := mod_arms(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_arm(a: SurfaceArm, s: &mut ModState, path: List(Text)): SurfaceArm {
    match a {
      SurfaceArmMk(written, guard, goal, body) => {
        let pattern := mod_pattern(s, written, path)
        let outer := s.locals
        mod_bind_names(pattern_names(pattern, Nil), &mut s, path, body.start, body.end)
        let g := mod_opt_term(guard, &mut s, path)
        let target := mod_opt_term(goal, &mut s, path)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        SurfaceArm { pattern: pattern, guard: g, goal: target, body: b }
      }
    }
  }

  pub fn mod_stmts(
    stmts: List(SurfaceStmt),
    s: &mut ModState,
    path: List(Text)
  ): List(SurfaceStmt) {
    match stmts {
      Nil => Nil
      Cons(st, rest) => {
        let h := mod_stmt(st, &mut s, path, st)
        let tl := mod_stmts(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_data_fields(
    fs: List(SurfaceDataField),
    s: &mut ModState,
    path: List(Text)
  ): List(SurfaceDataField) {
    match fs {
      Nil => Nil
      Cons(f, rest) => {
        let h := mod_data_field(f, &mut s, path)
        let tl := mod_data_fields(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_data_field(f: SurfaceDataField, s: &mut ModState, path: List(Text)): SurfaceDataField {
    match f {
      SurfaceDataFieldMk(name, ty) => {
        let ty2 := mod_term(ty, &mut s, path)
        SurfaceDataField { name: name, ty: ty2 }
      }
    }
  }

  pub fn mod_data_ctors(
    cs: List(SurfaceDataCtor),
    s: &mut ModState,
    path: List(Text)
  ): List(SurfaceDataCtor) {
    match cs {
      Nil => Nil
      Cons(k, rest) => {
        let h := mod_data_ctor(k, &mut s, path)
        let tl := mod_data_ctors(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_data_ctor(k: SurfaceDataCtor, s: &mut ModState, path: List(Text)): SurfaceDataCtor {
    match k {
      SurfaceDataCtorMk(name, fields) => {
        let fs := mod_data_fields(fields, &mut s, path)
        SurfaceDataCtor { name: name, fields: fs }
      }
    }
  }

  // The types written in the fields of a `struct` or an `enum`, named as in a
  // signature; its generics are local.
  pub fn mod_data(d: SurfaceData, s: &mut ModState, path: List(Text)): SurfaceData {
    match d {
      SurfaceDataMk(kind, name, generics, constructors, start, end, coerce_level, coerce_field, visibility, slot_unused_generics, slot_rows) => {
        let outer := s.locals
        mod_bind_names(generics, &mut s, path, start, end)
        let cs := mod_data_ctors(constructors, &mut s, path)
        set_to(&mut s.locals, outer)
        SurfaceData {
          kind: kind,
          name: name,
          generics: generics,
          constructors: cs,
          start: start,
          end: end,
          coerce_level: coerce_level,
          coerce_field: coerce_field,
          visibility: visibility,
          unused_generics: slot_unused_generics,
          rows: slot_rows
        }
      }
    }
  }

  pub fn mod_fn(f: SurfaceFn, s: &mut ModState, path: List(Text)): SurfaceFn {
    match f {
      SurfaceFnMk(name, generics, bounds, params, r#borrows, param_types, result, effects, wheres, start, end, body, ^lends, generic_types, bound_starts, visibility, row_hole, slot_unused, slot_unused_generics, slot_unused_params) => {
        let outer := s.locals
        mod_bind_names(List::append(generics, params), &mut s, path, start, end)
        // The types written in the signature are named as in the body.
        let pts := mod_opt_terms(param_types, &mut s, path)
        let r := mod_opt_term(result, &mut s, path)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        SurfaceFn {
          name: name,
          generics: generics,
          bounds: bounds,
          params: params,
          r#borrows: r#borrows,
          param_types: pts,
          result: r,
          effects: effects,
          wheres: wheres,
          start: start,
          end: end,
          body: b,
          lends: None,
          generic_types: generic_types,
          bound_starts: bound_starts,
          visibility: visibility,
          row_hole: row_hole,
          unused: slot_unused,
          unused_generics: slot_unused_generics,
          unused_params: slot_unused_params
        }
      }
    }
  }

  pub fn mod_stmt(
    st: SurfaceStmt,
    s: &mut ModState,
    path: List(Text),
    whole: SurfaceStmt
  ): SurfaceStmt {
    match st {
      StLet(name, ty, value, b, bm, unused, st_stack) => {
        mod_check_local(&mut s, name, path, value.start, value.end)
        let t := mod_opt_term(ty, &mut s, path)
        let v := mod_term(value, &mut s, path)
        let outer := s.locals
        set_to(&mut s.locals, Cons(name, outer))
        StLet(name, t, v, b, bm, unused, st_stack)
      }
      StVar(name, ty, value, vb, unused, st_stack) => {
        mod_check_local(&mut s, name, path, value.start, value.end)
        let t := mod_opt_term(ty, &mut s, path)
        let v := mod_term(value, &mut s, path)
        let outer := s.locals
        set_to(&mut s.locals, Cons(name, outer))
        StVar(name, t, v, vb, unused, st_stack)
      }
      StAssign(name, name_place, value) => {
        let p := mod_opt_term(name_place, &mut s, path)
        let v := mod_term(value, &mut s, path)
        StAssign(name, p, v)
      }
      StFn(f) => {
        let f2 := mod_fn(f, &mut s, path)
        StFn(f2)
      }
      StWhile(c, body) => {
        let c2 := mod_term(c, &mut s, path)
        let b := mod_term(body, &mut s, path)
        StWhile(c2, b)
      }
      StReturn(e) => {
        let e2 := mod_opt_term(e, &mut s, path)
        StReturn(e2)
      }
      StExpr(e) => {
        let e2 := mod_term(e, &mut s, path)
        StExpr(e2)
      }
      StMutual(items, a, b) => {
        let items2 := mod_stmts(items, &mut s, path)
        StMutual(items2, a, b)
      }
      StStruct(d) => StStruct(mod_data(d, &mut s, path))
      StEnum(d) => StEnum(mod_data(d, &mut s, path))
      _ => whole
    }
  }
}
