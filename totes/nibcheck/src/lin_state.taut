// Use, control-flow linearity and borrows (`lin.rs`): the checker's state and
// what it does to the bindings, in the proof language (`docs/design/self-host.md`「nibcheck soundness (`totes/nibcheck/src/`)」).
// Every name a program binds is a binding, kept by its index (the order it was
// pushed in); `count` is how many there are.

pub(open) inductive LinClass: Type {
  ClassDup: LinClass
  ClassAffine: LinClass
  ClassLinear: LinClass
}

pub(open) inductive LinMode: Type {
  // A `let`, a parameter, a pattern's name, `k`.
  ModeOwned: LinMode
  ModeVar: LinMode
  // A `var` a closure captured: it may be borrowed and assigned, not moved out
  // of.
  ModeVarInClosure: LinMode
  // `&x` (`false`) or `&mut x` (`true`).
  ModeBorrow(mutable: Bool): LinMode
  // A closure that holds borrows or `var`s with affine content: the names it
  // borrows, and whether one is lent `&mut`.
  ModeBorrowClosure(names: List(Text), mutable: Bool): LinMode
}

pub(open) inductive LinState: Type {
  BsOwned: LinState
  BsMoved: LinState
  // Moved on some paths.
  BsMaybe: LinState
  // Some fields moved out (`p.fst`), each by its path from the binding: the
  // others can still be taken or borrowed, the whole no longer.
  BsPartial(moved: List(List(Text))): LinState
}

pub(open) inductive Binding: Type {
  BindingMk(
    name: Text,
    r#class: LinClass,
    mode: LinMode,
    state: LinState,
    // `let x` bindings that freeze it: their index, and whether what they
    // borrow is lent `&mut`. The oldest first.
    frozen: List(Nat × Bool × List(Text)),
    // Not a name but a value moved into a call whose later arguments are still
    // being evaluated: it lives across them.
    held: Bool,
    // A shared view (`Option(&A)`, a `Pair` of one): it is copied.
    shared_view: Bool,
    // A parameter of the function or closure being walked. A `&mut` one is
    // the caller's binding and may take in only what the caller lent.
    param: Bool,
    // A parameter of a closure: the borrows it brings in belong to the caller,
    // so a value of it that holds one may not be stored where the closure's
    // captures outlive the call.
    lam_param: Bool,
    // A `let`, a `var` or a parameter of the body walked whose type holds no
    // opaque view: what it freezes stays frozen only while it is live
    // (`lin_live.taut`). Any other holder freezes to the end of its scope.
    nll: Bool,
    // Its value may be a lent function, or hold one: a function behind a `&`
    // that came from a parameter or from a closure that borrows, not a copy
    // out of owned data. Such a function is called or lent on, and a copy of
    // it is still lent.
    lent_function: Bool,
    // A parameter of a function type behind `&` or `&mut`
    // (`lin_param_binding`): lending it is an exclusive use.
    fn_borrow: Bool,
    // The lent functions this one may be, under another name
    // (`let g := cb`, `let g := same(cb)`): lending it lends them.
    origins: List(Nat),
    // The type of the name, for the fields it can be taken apart by.
    ty: Option(Ty),
    // For a closure written here, whether its body consumes what it captured
    // (`once` of `lin.rs`): such a closure is called once and never lent to a
    // borrowed function parameter.
    once: Option(Bool)
  ): Binding
}

// A `handle` whose body is being walked: where its bindings start, what it
// answers, and the bindings its `return` arm uses, which live across the body.
// `arms`: the operations it has an arm for, guarded or not. `owned_at_arm`: the
// bindings from outside that are not moved where the body may perform one of
// them, which the function still owns when an arm runs.
pub(open) inductive HandleCtx: Type {
  HandleCtxMk(
    start: Nat,
    answers: Ordmap(Text, Bool),
    return_uses: List(Nat),
    arms: List(Text),
    owned_at_arm: List(Nat)
  ): HandleCtx
}

// A function's body (or a closure's) being walked. `handles` is the newest
// first.
pub(open) inductive Frame: Type {
  FrameMk(
    base: Nat,
    handles: List(HandleCtx),
    // How many `budget` bodies of this function the walk is inside.
    budgets: Nat,
    bounded: List(Text),
    direct_bounded: List(Text),
    returns_borrow: Bool
  ): Frame
}

pub(open) inductive LinPos: Type {
  // Moved: an argument, a field, an effect's argument, a `:=`.
  PosMove: LinPos
  // Bound by `let` or called in place: a closure that borrows may be.
  PosLet: LinPos
  PosResult: LinPos
  PosDrop: LinPos
}

pub(open) inductive LinUse: Type {
  UseMove: LinUse
  UseShared: LinUse
  UseMut: LinUse
}

pub(open) inductive Access: Type {
  AccessMk(root: Nat, path: List(Text), how: LinUse): Access
}

pub(open) inductive LinError: Type {
  LinErrorMk(message: Text, start: Nat, end: Nat): LinError
}

pub(open) inductive Lin: Type {
  LinMk(
    types: TypeReport,
    rows: RowReport,
    bindings: Ordmap(Nat, Binding),
    count: Nat,
    // The current frame first.
    frames: List(Frame),
    errors: List(LinError),
    // The current path has returned.
    dead: Bool,
    // Inside a handler arm: the bindings below this index are outside the
    // handle, and the arm may capture only duplicable ones.
    arm_floor: Option(Nat),
    // Inside the arm of a `direct` operation: the bindings below the first
    // index are outside the handle, and the arm may not move them.
    arm_direct: Option(Nat × Text),
    // What the call a `let x` binds lends.
    lent: List(Nat × Bool × List(Text)),
    // `borrows(…)`: for each function that writes it, whether its result
    // may borrow each parameter.
    // For each function with `borrows(…)`, per parameter: the field paths of
    // it the result borrows (`borrows(p.a)` is `a` of `p`, `borrows(p)` the
    // empty path), or `None` where it is not named.
    lends: Ordmap(Text, List(Option(List(List(Text))))),
    // `borrows(…)`: for each function that writes it, the operations of its
    // row it names.
    lends_effects: Ordmap(Text, List(Text)),
    // In the arm of an operation whose result holds a borrow: what the arm
    // answers is lent to `k`, so a `&` of a binding from outside is allowed.
    arm_lends: Bool,
    // What a result of each operation that lends borrows here: what its
    // innermost handle answers, innermost first.
    lenders: List(Text × List(Nat × Bool × List(Text))),
    // The bindings lent through an operation, with the operation.
    lent_through: List(Nat × Text),
    // Whether a lent function was met since this was last cleared: a value
    // walked since then may be one, or hold one.
    met: Bool,
    // The lent functions met, as `met` says one was.
    met_origins: List(Nat),
    // The borrows the earlier arguments of the calls around hold: those calls
    // have not run yet.
    outer_accesses: List(Access),
    // Whether the closure checked last owns a value it captured that is not
    // duplicable.
    closure_owns: Bool,
    // Whether the body of the closure checked last consumes a value it captured.
    closure_consumes: Bool,
    // For the call being walked: whether each argument met a lent function,
    // what the closures written in place as arguments borrow, and such a
    // closure that owns what it captured, gone when the call returns.
    arg_mets: List(Bool),
    closure_lent: List(Nat × Bool × List(Text)),
    temporary: Option(TySpan),
    // For each function, whether each parameter is a borrow of one of its
    // type parameters (`x: &A`): a lent function is not given to one.
    generic_borrows: Ordmap(Text, List(Bool)),
    // For each function whose signature is parametric (no `where`): its
    // type parameters and parameters as written, for what a `&mut`
    // argument may take in.
    parametric: Ordmap(Text, LinParametric),
    // The starts of the `budget`s whose stopped body cannot leave the
    // `handle` around them (`confined_budget`): they may borrow from outside.
    confined: List(Nat),
    steps: Nat,
    // Where the bindings of the function walked are live, the innermost
    // first: a closure's body is part of its function's.
    live: List(LiveMap)
  ): Lin
}

// A function's signature as written: its type parameters, which parameters
// are borrowed, and their types.
pub(open) struct LinParametric {
  generics: List(Text),
  effects: Option(List(RowEntry)),
  r#borrows: List(Option(Bool)),
  types: List(Option(SurfaceTerm))
}

pub fn lin_new(types: TypeReport, rows: RowReport, steps: Nat): Lin {
  Lin {
    types: types,
    rows: rows,
    bindings: Ordmap::empty(),
    count: 0,
    frames: Nil,
    errors: Nil,
    dead: false,
    arm_floor: None,
    arm_direct: None,
    lent: Nil,
    lends: Ordmap::empty(),
    lends_effects: Ordmap::empty(),
    arm_lends: false,
    lenders: Nil,
    lent_through: Nil,
    met: false,
    met_origins: Nil,
    outer_accesses: Nil,
    closure_owns: false,
    closure_consumes: false,
    arg_mets: Nil,
    closure_lent: Nil,
    temporary: None,
    generic_borrows: Ordmap::empty(),
    parametric: Ordmap::empty(),
    confined: Nil,
    steps: steps,
    live: Nil
  }
}

pub fn frame_default(): Frame {
  Frame {
    base: 0,
    handles: Nil,
    budgets: 0,
    bounded: Nil,
    direct_bounded: Nil,
    returns_borrow: false
  }
}

pub fn binding_dummy(): Binding {
  Binding {
    name: "",
    r#class: ClassDup,
    mode: ModeOwned,
    state: BsOwned,
    frozen: Nil,
    held: false,
    shared_view: false,
    param: false,
    lam_param: false,
    nll: false,
    lent_function: false,
    fn_borrow: false,
    origins: Nil,
    ty: None,
    once: None
  }
}

pub fn class_of_kind(k: Kind): LinClass {
  match k {
    KindCopy => ClassDup
    KindShared => ClassDup
    KindAffine => ClassAffine
    KindLinear => ClassLinear
  }
}

pub fn class_word(c: LinClass): Text {
  match c {
    ClassDup => lin_class_shared_message()
    ClassAffine => lin_class_affine_message()
    ClassLinear => lin_class_linear_message()
  }
}

pub fn class_is_dup(c: LinClass): Bool {
  match c {
    ClassDup => true
    _ => false
  }
}

pub fn class_is_linear(c: LinClass): Bool {
  match c {
    ClassLinear => true
    _ => false
  }
}

pub fn mode_is_owned(m: LinMode): Bool {
  match m {
    ModeOwned => true
    _ => false
  }
}

pub fn mode_is_var_in_closure(m: LinMode): Bool {
  match m {
    ModeVarInClosure => true
    _ => false
  }
}

pub fn mode_is_borrow(m: LinMode): Bool {
  match m {
    ModeBorrow(^x) => true
    _ => false
  }
}

pub fn mode_is_shared_borrow(m: LinMode): Bool {
  match m {
    ModeBorrow(x) => not(x)
    _ => false
  }
}

pub fn mode_borrows(m: LinMode): Bool {
  match m {
    ModeBorrow(^x) => true
    ModeBorrowClosure(^names, ^x) => true
    _ => false
  }
}

pub fn state_is_owned(s: LinState): Bool {
  match s {
    BsOwned => true
    _ => false
  }
}

pub fn state_is_moved(s: LinState): Bool {
  match s {
    BsMoved => true
    _ => false
  }
}

pub fn paths_eq(a: List(List(Text)), b: List(List(Text))): Bool {
  match a {
    Nil => ⊢ Bool from match b {
      Nil => true
      Cons(^y, ^ys) => false
    }
    Cons(x, xs) => ⊢ Bool from match b {
      Nil => false
      Cons(y, ys) => text_list_eq(x, y) && paths_eq(xs, ys)
    }
  }
}

pub fn state_eq(a: LinState, b: LinState): Bool {
  match a {
    BsOwned => state_is_owned(b)
    BsMoved => state_is_moved(b)
    BsMaybe => ⊢ Bool from match b {
      BsMaybe => true
      _ => false
    }
    BsPartial(m) => ⊢ Bool from match b {
      BsPartial(n) => paths_eq(m, n)
      _ => false
    }
  }
}

pub fn pos_is_let(p: LinPos): Bool {
  match p {
    PosLet => true
    _ => false
  }
}

pub fn pos_is_result(p: LinPos): Bool {
  match p {
    PosResult => true
    _ => false
  }
}

pub fn pos_is_drop(p: LinPos): Bool {
  match p {
    PosDrop => true
    _ => false
  }
}

pub fn binding_with_state(b: Binding, s: LinState): Binding {
  Binding {
    name: b.name,
    r#class: b.r#class,
    mode: b.mode,
    state: s,
    frozen: b.frozen,
    held: b.held,
    shared_view: b.shared_view,
    param: b.param,
    lam_param: b.lam_param,
    nll: b.nll,
    lent_function: b.lent_function,
    fn_borrow: b.fn_borrow,
    origins: b.origins,
    ty: b.ty,
    once: b.once
  }
}

pub fn binding_with_once(b: Binding, once: Option(Bool)): Binding {
  Binding {
    name: b.name,
    r#class: b.r#class,
    mode: b.mode,
    state: b.state,
    frozen: b.frozen,
    held: b.held,
    shared_view: b.shared_view,
    param: b.param,
    lam_param: b.lam_param,
    nll: b.nll,
    lent_function: b.lent_function,
    fn_borrow: b.fn_borrow,
    origins: b.origins,
    ty: b.ty,
    once: once
  }
}

