import "types_run.taut"
import "freevars.taut"
import std::List
import std::Map
import std::Text
import "checker.taut"
import "datas.taut"
import "rows.taut"
import "ty.taut"
import "../../surface/src/surface.taut"
import "../../text/src/text.taut"

// Use, control-flow linearity and borrows (`lin.rs`): the checker's state and
// what it does to the bindings, in the proof language (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」).
// Every name a program binds is a binding, kept by its index (the order it was
// pushed in); `count` is how many there are.

pub(open) inductive LinClass: Type {
  ClassDup: LinClass
  ClassAffine: LinClass
  ClassLinear: LinClass
}

pub(open) inductive LinMode: Type {
  // A `let`, a parameter, a pattern's name, `k`.
  ModeOwned: LinMode
  ModeVar: LinMode
  // A `var` a closure captured: it may be borrowed and assigned, not moved out
  // of.
  ModeVarInClosure: LinMode
  // `&x` (`false`) or `&mut x` (`true`).
  ModeBorrow(mutable: Bool): LinMode
  // A closure that holds borrows or `var`s with affine content: the names it
  // borrows, and whether one is lent `&mut`.
  ModeBorrowClosure(names: List(Text), mutable: Bool): LinMode
}

pub(open) inductive LinState: Type {
  BsOwned: LinState
  BsMoved: LinState
  // Moved on some paths.
  BsMaybe: LinState
}

pub(open) inductive Binding: Type {
  BindingMk(
    name: Text,
    r#class: LinClass,
    mode: LinMode,
    state: LinState,
    // The loops around its declaration, in its function.
    loops: Nat,
    // `let &x` bindings that freeze it: their index, and whether what they
    // borrow is lent `&mut`. The oldest first.
    frozen: List(Pair(Nat, Bool)),
    // Not a name but a value moved into a call whose later arguments are still
    // being evaluated: it lives across them.
    held: Bool,
    // A shared view (`Option(&A)`, a `Pair` of one): it is copied.
    shared_view: Bool
  ): Binding
}

// A `handle` whose body is being walked: where its bindings start, what it
// answers, and the bindings its `return` arm uses, which live across the body.
pub(open) inductive HandleCtx: Type {
  HandleCtxMk(start: Nat, answers: Ordmap(Text, Bool), return_uses: List(Nat)): HandleCtx
}

// A function's body (or a closure's) being walked. `handles` is the newest
// first.
pub(open) inductive Frame: Type {
  FrameMk(
    base: Nat,
    handles: List(HandleCtx),
    // How many `budget` bodies of this function the walk is inside; `loops`,
    // how many loops.
    budgets: Nat,
    loops: Nat,
    bounded: List(Text),
    direct_bounded: List(Text),
    returns_borrow: Bool
  ): Frame
}

pub(open) inductive LinPos: Type {
  // Moved: an argument, a field, an effect's argument, a `:=`.
  PosMove: LinPos
  // Bound by `let` or called in place: a closure that borrows may be.
  PosLet: LinPos
  PosResult: LinPos
  PosDrop: LinPos
}

pub(open) inductive LinUse: Type {
  UseMove: LinUse
  UseShared: LinUse
  UseMut: LinUse
}

pub(open) inductive Access: Type {
  AccessMk(root: Nat, path: List(Text), how: LinUse): Access
}

pub(open) inductive LinError: Type {
  LinErrorMk(message: Text, start: Nat, end: Nat): LinError
}

pub(open) inductive Lin: Type {
  LinMk(
    types: TypeReport,
    rows: RowReport,
    bindings: Ordmap(Nat, Binding),
    count: Nat,
    // The current frame first.
    frames: List(Frame),
    errors: List(LinError),
    // The current path has returned.
    dead: Bool,
    // Inside a handler arm: the bindings below this index are outside the
    // handle, and the arm may capture only duplicable ones.
    arm_floor: Option(Nat),
    // Inside the arm of a `direct` operation: the bindings below the first
    // index are outside the handle, and the arm may not move them.
    arm_direct: Option(Pair(Nat, Text)),
    // What the call a `let &x` binds lends.
    lent: List(Pair(Nat, Bool)),
    steps: Nat
  ): Lin
}

pub fn lin_new(types: TypeReport, rows: RowReport, steps: Nat): Lin {
  Lin {
    types: types,
    rows: rows,
    bindings: Ordmap::empty(),
    count: 0,
    frames: Nil,
    errors: Nil,
    dead: false,
    arm_floor: None,
    arm_direct: None,
    lent: Nil,
    steps: steps
  }
}

pub fn frame_default(): Frame {
  Frame {
    base: 0,
    handles: Nil,
    budgets: 0,
    loops: 0,
    bounded: Nil,
    direct_bounded: Nil,
    returns_borrow: false
  }
}

pub fn binding_dummy(): Binding {
  Binding {
    name: "",
    r#class: ClassDup,
    mode: ModeOwned,
    state: BsOwned,
    loops: 0,
    frozen: Nil,
    held: false,
    shared_view: false
  }
}

pub fn class_of_kind(k: Kind): LinClass {
  match k: LinClass {
    KindCopy => ClassDup
    KindShared => ClassDup
    KindAffine => ClassAffine
    KindLinear => ClassLinear
  }
}

pub fn class_word(c: LinClass): Text {
  match c: Text {
    ClassDup => "shared"
    ClassAffine => "affine"
    ClassLinear => "linear"
  }
}

pub fn class_is_dup(c: LinClass): Bool {
  match c: Bool {
    ClassDup => true
    _ => false
  }
}

pub fn class_is_linear(c: LinClass): Bool {
  match c: Bool {
    ClassLinear => true
    _ => false
  }
}

pub fn mode_is_owned(m: LinMode): Bool {
  match m: Bool {
    ModeOwned => true
    _ => false
  }
}

pub fn mode_is_borrow(m: LinMode): Bool {
  match m: Bool {
    ModeBorrow(x) => true
    _ => false
  }
}

pub fn mode_is_shared_borrow(m: LinMode): Bool {
  match m: Bool {
    ModeBorrow(x) => not(x)
    _ => false
  }
}

pub fn mode_borrows(m: LinMode): Bool {
  match m: Bool {
    ModeBorrow(x) => true
    ModeBorrowClosure(names, x) => true
    _ => false
  }
}

pub fn state_is_owned(s: LinState): Bool {
  match s: Bool {
    BsOwned => true
    _ => false
  }
}

pub fn state_is_moved(s: LinState): Bool {
  match s: Bool {
    BsMoved => true
    _ => false
  }
}

pub fn state_eq(a: LinState, b: LinState): Bool {
  match a: Bool {
    BsOwned => state_is_owned(b)
    BsMoved => state_is_moved(b)
    BsMaybe => not(state_is_owned(b)) && not(state_is_moved(b))
  }
}

pub fn pos_is_let(p: LinPos): Bool {
  match p: Bool {
    PosLet => true
    _ => false
  }
}

pub fn pos_is_result(p: LinPos): Bool {
  match p: Bool {
    PosResult => true
    _ => false
  }
}

pub fn pos_is_drop(p: LinPos): Bool {
  match p: Bool {
    PosDrop => true
    _ => false
  }
}

pub fn binding_with_state(b: Binding, s: LinState): Binding {
  Binding {
    name: b.name,
    r#class: b.r#class,
    mode: b.mode,
    state: s,
    loops: b.loops,
    frozen: b.frozen,
    held: b.held,
    shared_view: b.shared_view
  }
}

pub fn binding_with_mode(b: Binding, m: LinMode): Binding {
  Binding {
    name: b.name,
    r#class: b.r#class,
    mode: m,
    state: b.state,
    loops: b.loops,
    frozen: b.frozen,
    held: b.held,
    shared_view: b.shared_view
  }
}

pub fn binding_with_class(b: Binding, c: LinClass): Binding {
  Binding {
    name: b.name,
    r#class: c,
    mode: b.mode,
    state: b.state,
    loops: b.loops,
    frozen: b.frozen,
    held: b.held,
    shared_view: b.shared_view
  }
}

pub fn binding_with_held(b: Binding, h: Bool): Binding {
  Binding {
    name: b.name,
    r#class: b.r#class,
    mode: b.mode,
    state: b.state,
    loops: b.loops,
    frozen: b.frozen,
    held: h,
    shared_view: b.shared_view
  }
}

pub fn binding_with_frozen(b: Binding, f: List(Pair(Nat, Bool))): Binding {
  Binding {
    name: b.name,
    r#class: b.r#class,
    mode: b.mode,
    state: b.state,
    loops: b.loops,
    frozen: f,
    held: b.held,
    shared_view: b.shared_view
  }
}

pub fn binding_with_shared_view(b: Binding, v: Bool): Binding {
  Binding {
    name: b.name,
    r#class: b.r#class,
    mode: b.mode,
    state: b.state,
    loops: b.loops,
    frozen: b.frozen,
    held: b.held,
    shared_view: v
  }
}

pub fn binding_owns(b: Binding): Bool {
  not(class_is_dup(b.r#class)) && match b.mode: Bool {
    ModeOwned => true
    ModeVar => true
    ModeVarInClosure => true
    ModeBorrow(m) => false
    ModeBorrowClosure(names, m) => false
  }
}

pub fn lin_get(c: Lin, i: Nat): Binding {
  match Ordmap::get(c.bindings, i, Ordmap::compare_nat): Binding {
    Some(b) => b
    None => binding_dummy()
  }
}

pub fn lin_put(&mut c: Lin, i: Nat, b: Binding): Unit {
  set_to(&mut c.bindings, Ordmap::insert(c.bindings, i, b, Ordmap::compare_nat))
}

pub fn lin_set_state(&mut c: Lin, i: Nat, s: LinState): Unit {
  lin_put(&mut c, i, binding_with_state(lin_get(c, i), s))
}

pub fn lin_frame(c: Lin): Frame {
  match c.frames: Frame {
    Cons(f, rest) => f
    Nil => frame_default()
  }
}

pub fn lin_set_frame(&mut c: Lin, f: Frame): Unit {
  match c.frames: Unit {
    Cons(old, rest) => set_to(&mut c.frames, Cons(f, rest))
    Nil => #()
  }
}

pub fn lin_push_frame(&mut c: Lin, f: Frame): Unit {
  set_to(&mut c.frames, Cons(f, c.frames))
}

pub fn lin_pop_frame(&mut c: Lin): Unit {
  set_to(&mut c.frames, List::tail(c.frames))
}

pub fn lin_has_error(es: List(LinError), message: Text, span: TySpan): Bool {
  match es: Bool {
    Nil => false
    Cons(e, rest) => (
      e.message == message && e.start == span.start && e.end == span.end
    ) || lin_has_error(rest, message, span)
  }
}

pub fn lin_error(&mut c: Lin, message: Text, span: TySpan): Unit {
  if not(lin_has_error(c.errors, message, span)) {
    set_to(
      &mut c.errors,
      Cons(LinError { message: message, start: span.start, end: span.end }, c.errors)
    )
  }
}

// The newest binding below index `n` named `name`; a held value (`held`)
// is not a name and is skipped.
pub fn lin_find_below(n: Nat, c: Lin, name: Text): Option(Nat) {
  match n: Option(Nat) {
    Zero => None
    Succ(i) => if lin_get(c, i).name == name && not(lin_get(c, i).held) {
      Some(i)
    } else {
      lin_find_below(i, c, name)
    }
  }
}

pub fn lin_find(c: Lin, name: Text): Option(Nat) {
  lin_find_below(c.count, c, name)
}

pub fn lin_local_type(c: Lin, name: Text, site: Nat): Option(Ty) {
  Ordmap::get(c.types.locals, LocalKey { name: name, site: site }, local_key_compare)
}

pub fn lin_term_type(c: Lin, t: SurfaceTerm): Option(Ty) {
  Ordmap::get(c.types.terms, term_at_of(t), term_at_compare)
}

pub fn lin_kind(c: Lin, t: Ty): LinClass {
  class_of_kind(datas_kind(c.types.datas, t))
}

pub fn lin_class_of_borrow(r#class: LinClass, m: Bool): Pair(LinClass, Option(Bool)) {
  if class_is_dup(
    r#class
  ) { Pair { fst: ClassDup, snd: None } } else { Pair { fst: r#class, snd: Some(m) } }
}

pub fn lin_class_of_value(c: Lin, t: Ty): Pair(LinClass, Option(Bool)) {
  match datas_view_borrow(c.types.datas, t): Pair(LinClass, Option(Bool)) {
    Some(m) => Pair { fst: ClassAffine, snd: Some(m) }
    None => Pair { fst: lin_kind(c, t), snd: None }
  }
}

pub fn lin_class_of_ty(c: Lin, t: Ty): Pair(LinClass, Option(Bool)) {
  match t: Pair(LinClass, Option(Bool)) {
    TyBorrow(inner, m) => lin_class_of_borrow(lin_kind(c, inner), m)
    _ => lin_class_of_value(c, t)
  }
}

pub fn lin_class_of(c: Lin, ty: Option(Ty)): Pair(LinClass, Option(Bool)) {
  match ty: Pair(LinClass, Option(Bool)) {
    None => Pair { fst: ClassDup, snd: None }
    Some(t) => lin_class_of_ty(c, t)
  }
}

pub fn lin_push_binding(&mut c: Lin, name: Text, r#class: LinClass, mode: LinMode): Nat {
  let loops := lin_frame(c).loops
  let i := c.count
  lin_put(
    &mut c,
    i,
    Binding {
      name: name,
      r#class: r#class,
      mode: mode,
      state: BsOwned,
      loops: loops,
      frozen: Nil,
      held: false,
      shared_view: false
    }
  )
  set_to(&mut c.count, i + 1)
  i
}

pub fn view_is_shared(v: Option(Bool)): Bool {
  match v: Bool {
    Some(m) => not(m)
    None => false
  }
}

pub fn lin_ty_shared_view(c: Lin, t: Ty): Bool {
  match t: Bool {
    TyBorrow(x, m) => false
    _ => view_is_shared(datas_view_borrow(c.types.datas, t))
  }
}

pub fn lin_shared_view(c: Lin, ty: Option(Ty)): Bool {
  match ty: Bool {
    Some(t) => lin_ty_shared_view(c, t)
    None => false
  }
}

pub fn lin_mode_of(is_var: Bool, borrow: Option(Bool)): LinMode {
  if is_var {
    ModeVar
  } else {
    match borrow: LinMode {
      Some(m) => ModeBorrow(m)
      None => ModeOwned
    }
  }
}

pub fn lin_push(&mut c: Lin, name: Text, site: Nat, is_var: Bool): Nat {
  let cm := lin_class_of(c, lin_local_type(c, name, site))
  let i := lin_push_binding(&mut c, name, cm.fst, lin_mode_of(is_var, cm.snd))
  if lin_shared_view(c, lin_local_type(c, name, site)) {
    lin_put(&mut c, i, binding_with_shared_view(lin_get(c, i), true))
  }
  i
}

pub fn lin_push_unit(&mut c: Lin, name: Text, site: Nat, is_var: Bool): Unit {
  let i := lin_push(&mut c, name, site, is_var)
  #()
}

// The bindings from `mark` on are gone (the indexes below `n`).
pub fn lin_remove_below(n: Nat, m: Ordmap(Nat, Binding), mark: Nat): Ordmap(Nat, Binding) {
  match n: Ordmap(Nat, Binding) {
    Zero => m
    Succ(i) => if i < mark { m } else {
      lin_remove_below(i, Ordmap::remove(m, i, Ordmap::compare_nat), mark)
    }
  }
}

pub fn lin_truncate(&mut c: Lin, mark: Nat): Unit {
  if mark < c.count {
    set_to(&mut c.bindings, lin_remove_below(c.count, c.bindings, mark))
    set_to(&mut c.count, mark)
  }
}

pub fn lin_report_one(&mut c: Lin, i: Nat, span: TySpan): Unit {
  let b := lin_get(c, i)
  if class_is_linear(b.r#class) && mode_is_owned(b.mode) && state_is_owned(b.state) {
    lin_error(&mut c, cat2(b.name, " is not used"), span)
  }
}

// The linear bindings from `mark` on (below `n`) that are still owned.
pub fn lin_report_unused_below(n: Nat, &mut c: Lin, mark: Nat, span: TySpan): Unit {
  match n: Unit {
    Zero => #()
    Succ(i) => if mark <= i {
      lin_report_one(&mut c, i, span)
      lin_report_unused_below(i, &mut c, mark, span)
    }
  }
}

pub fn frozen_keep(fs: List(Pair(Nat, Bool)), mark: Nat): List(Pair(Nat, Bool)) {
  match fs: List(Pair(Nat, Bool)) {
    Nil => Nil
    Cons(f, rest) => if f.fst < mark { Cons(f, frozen_keep(rest, mark)) } else {
      frozen_keep(rest, mark)
    }
  }
}

pub fn lin_unfreeze_one(&mut c: Lin, i: Nat, mark: Nat): Unit {
  let b := lin_get(c, i)
  match b.frozen: Unit {
    Nil => #()
    Cons(f, rest) => lin_put(&mut c, i, binding_with_frozen(b, frozen_keep(b.frozen, mark)))
  }
}

pub fn lin_unfreeze_below(n: Nat, &mut c: Lin, mark: Nat): Unit {
  match n: Unit {
    Zero => #()
    Succ(i) => {
      lin_unfreeze_one(&mut c, i, mark)
      lin_unfreeze_below(i, &mut c, mark)
    }
  }
}

// Leaves a scope: reports the linear bindings left (unless the path returned)
// and lifts the freezes the leaving bindings made.
pub fn lin_pop_to(&mut c: Lin, mark: Nat, span: TySpan): Unit {
  if not(c.dead) {
    lin_report_unused_below(c.count, &mut c, mark, span)
  }
  lin_truncate(&mut c, mark)
  lin_unfreeze_below(c.count, &mut c, mark)
}

pub fn lin_capture_what(b: Binding): Option(Text) {
  if class_is_dup(b.r#class) {
    None
  } else {
    match b.mode: Option(Text) {
      ModeBorrow(m) => if m { Some("&mut") } else { None }
      ModeOwned => Some(class_word(b.r#class))
      ModeVar => Some(cat2(class_word(b.r#class), " var"))
      ModeVarInClosure => Some(cat2(class_word(b.r#class), " var"))
      ModeBorrowClosure(names, m) => Some("the borrowing closure")
    }
  }
}

pub fn lin_arm_captures(&mut c: Lin, b: Binding, span: TySpan): Bool {
  match lin_capture_what(b): Bool {
    None => false
    Some(w) => {
      lin_error(&mut c, cat4("arm captures ", w, " ", b.name), span)
      true
    }
  }
}

// Whether binding `i` may be touched from here: in a handler arm, a binding
// from outside the handle must be duplicable or a `&` borrow.
pub fn lin_captured_by_arm(&mut c: Lin, i: Nat, span: TySpan): Bool {
  match c.arm_floor: Bool {
    None => false
    Some(floor) => if floor <= i { false } else { lin_arm_captures(&mut c, lin_get(c, i), span) }
  }
}

pub fn lin_frozen_find(
  bindings: Ordmap(Nat, Binding),
  fs: List(Pair(Nat, Bool)),
  mutable: Bool
): Option(Text) {
  match fs: Option(Text) {
    Nil => None
    Cons(f, rest) => if mutable || f.snd {
      match Ordmap::get(bindings, f.fst, Ordmap::compare_nat): Option(Text) {
        Some(b) => Some(b.name)
        None => Some("")
      }
    } else {
      lin_frozen_find(bindings, rest, mutable)
    }
  }
}

pub fn lin_frozen_by(c: Lin, i: Nat, mutable: Bool): Option(Text) {
  lin_frozen_find(c.bindings, lin_get(c, i).frozen, mutable)
}

pub fn lin_direct_move(&mut c: Lin, b: Binding, eff: Text, span: TySpan): Bool {
  if not(class_is_dup(b.r#class)) && not(mode_borrows(b.mode)) {
    lin_error(
      &mut c,
      cat4("the arm of ", eff, cat3(" moves ", b.name, ", but it runs many times"), ""),
      span
    )
    true
  } else {
    false
  }
}

// In the arm of a direct operation: a binding from outside the handle is not
// moved, for the arm runs many times.
pub fn lin_direct_arm_moves(&mut c: Lin, i: Nat, span: TySpan): Bool {
  match c.arm_direct: Bool {
    None => false
    Some(a) => if a.fst <= i { false } else { lin_direct_move(&mut c, lin_get(c, i), a.snd, span) }
  }
}

// What a use of `name` says when `by` holds it: a `let &x` freezes it, a direct
// arm borrows it.
pub fn lin_frozen_text(name: Text, r#by: Text): Text {
  if text_starts_with(r#by, "the arm of ", 0) {
    cat3(name, " is borrowed by ", r#by)
  } else {
    cat3(name, " is frozen by ", r#by)
  }
}

pub fn lin_take_owned(&mut c: Lin, i: Nat, b: Binding, span: TySpan): Unit {
  match lin_frozen_by(c, i, true): Unit {
    Some(r#by) => lin_error(&mut c, lin_frozen_text(b.name, r#by), span)
    None => if not(state_is_owned(b.state)) {
      lin_error(&mut c, cat2(b.name, " is used after move"), span)
    } else if b.loops < lin_frame(c).loops {
      lin_error(&mut c, cat2(b.name, " is moved inside a loop"), span)
    } else {
      lin_set_state(&mut c, i, BsMoved)
    }
  }
}

pub fn lin_take_binding(&mut c: Lin, i: Nat, b: Binding, span: TySpan): Unit {
  if not(class_is_dup(b.r#class)) {
    match b.mode: Unit {
      ModeBorrow(m) => if not(m) && b.shared_view {
        #()
      } else {
        lin_error(&mut c, cat2(b.name, " is borrowed and cannot be moved"), span)
      }
      ModeBorrowClosure(borrows, m) => lin_error(
        &mut c,
        cat5(b.name, " borrows ", text_join(borrows, ", "), " and cannot be stored", ""),
        span
      )
      ModeVarInClosure => lin_error(
        &mut c,
        cat2(b.name, " is a var and cannot be moved out of a closure"),
        span
      )
      ModeOwned => lin_take_owned(&mut c, i, b, span)
      ModeVar => lin_take_owned(&mut c, i, b, span)
    }
  }
}

pub fn lin_take(&mut c: Lin, i: Nat, span: TySpan): Unit {
  if lin_direct_arm_moves(&mut c, i, span) {
    #()
  } else if not(lin_captured_by_arm(&mut c, i, span)) {
    lin_take_binding(&mut c, i, lin_get(c, i), span)
  }
}

// Reads binding `i` without moving it (a duplicable field, a borrow).
pub fn lin_read(&mut c: Lin, i: Nat, span: TySpan): Unit {
  if not(lin_captured_by_arm(&mut c, i, span)) {
    let b := lin_get(c, i)
    if binding_owns(b) && not(state_is_owned(b.state)) {
      lin_error(&mut c, cat2(b.name, " is used after move"), span)
    }
  }
}
