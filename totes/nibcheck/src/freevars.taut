import "checker.taut"
import "../../surface/src/surface.taut"
import std::base
import std::text
import "datas.taut"
import "../../identity/src/identity.taut"

// The names a term refers to that it does not bind (`free_vars`, `used_vars`
// and `pattern_names` of `lin.rs`), in the proof language (`docs/design/self-host.md`「nibcheck soundness (`totes/nibcheck/src/`)」).
// The bound names and the ones found so far are lists, the newest first.
// With `skip`, the names a term only borrows (`&x`, `&mut x.f`) are left out.

// The root of a place (`x`, `x.f.g`) and its path, the root first.
mutual {
  pub fn lin_place(t: SurfaceTerm): Option(Text × List(Text)) {
    match t {
      SurfaceTermIndexedMk(k, ^start, ^end, ^ast_occurrence) => lin_place_kind(k)
    }
  }

  pub fn lin_place_kind(k: SurfaceKind): Option(Text × List(Text)) {
    match k {
      SkVar(n) => Some(#(surface_name_text(n), Cons(surface_name_text(n), Nil)))
      SkField(base, name) => ⊢ Option(Text × List(Text)) from match lin_place(base) {
        Some(p) => Some(#(p.fst, List::append(p.snd, Cons(name, Nil))))
        None => None
      }
      _ => None
    }
  }
}

pub(open) inductive FreeState: Type {
  FreeStateMk(bound: List(Text), out: List(Text)): FreeState
}

pub fn free_note(name: Text, bound: List(Text), out: List(Text)): List(Text) {
  if not(
    list_has_text(bound, name)
  ) && not(list_has_text(out, name)) { Cons(name, out) } else { out }
}

pub fn free_names(ns: List(Text), bound: List(Text)): List(Text) {
  match ns {
    Nil => bound
    Cons(n, rest) => free_names(rest, Cons(n, bound))
  }
}

// The names a pattern binds are added to `bound`; a bare name may be a
// constructor, which the caller tells apart.
mutual {
  pub fn pattern_names(p: SurfacePattern, bound: List(Text)): List(Text) {
    match p {
      PtBind(n, _) => Cons(n, bound)
      PtCtor(^name, args) => pattern_names_each(args, bound)
      PtRecord(^name, fields) => pattern_names_fields(fields, bound)
      _ => bound
    }
  }

  pub fn pattern_names_each(ps: List(SurfacePattern), bound: List(Text)): List(Text) {
    match ps {
      Nil => bound
      Cons(p, rest) => pattern_names_each(rest, pattern_names(p, bound))
    }
  }

  pub fn pattern_names_fields(fs: List(SurfacePatternField), bound: List(Text)): List(Text) {
    match fs {
      Nil => bound
      Cons(f, rest) => pattern_names_fields(rest, pattern_names_field(f, bound))
    }
  }

  pub fn pattern_names_field(f: SurfacePatternField, bound: List(Text)): List(Text) {
    match f {
      SurfacePatternFieldMk(^name, p) => pattern_names(p, bound)
    }
  }
}

pub fn free_cont(cont: Option(Text), bound: List(Text)): List(Text) {
  match cont {
    None => bound
    Some(k) => Cons(k, bound)
  }
}

pub fn free_borrow(skip: Bool, x: SurfaceTerm): Bool {
  match lin_place(x) {
    Some(^p) => skip
    None => false
  }
}

mutual {
  pub fn free_in(t: SurfaceTerm, bound: List(Text), out: List(Text), skip: Bool): List(Text) {
    match t {
      SurfaceTermIndexedMk(k, ^start, ^end, ^ast_occurrence) => free_kind(k, bound, out, skip)
    }
  }

  pub fn free_kind(k: SurfaceKind, bound: List(Text), out: List(Text), skip: Bool): List(Text) {
    match k {
      SkVar(n) => free_note(surface_name_text(n), bound, out)
      SkApp(f, args) => free_each(args, bound, free_in(f, bound, out, skip), skip)
      SkLam(params, body, _, _) => free_in(body, free_names(params, bound), out, skip)
      SkBorrowLam(^r#borrows, lam) => free_in(lam, bound, out, skip)
      SkIf(c, th, el) => free_opt(
        el,
        bound,
        free_in(th, bound, free_in(c, bound, out, skip), skip),
        skip
      )
      SkField(base, ^name) => free_in(base, bound, out, skip)
      SkTagged(^tag, x) => free_in(x, bound, out, skip)
      SkBorrow(^m, ^m_orig, x) => if free_borrow(skip, x) { out } else { free_in(x, bound, out, skip) }
      SkRecord(^name, fields) => free_fields(fields, bound, out, skip)
      SkPerform(^eff, args) => free_each(args, bound, out, skip)
      SkBudget(^steps_memory, steps, body) => free_in(
        body,
        bound,
        free_in(steps, bound, out, skip),
        skip
      )
      SkBlock(stmts) => free_stmts(stmts, FreeState { bound: bound, out: out }, skip).out
      SkMatch(s, ^motive, arms, ^hb, _) => free_arms(arms, bound, free_in(s, bound, out, skip), skip)
      SkHandle(body, handlers) => free_handlers(
        handlers,
        bound,
        free_in(body, bound, out, skip),
        skip
      )
      _ => out
    }
  }

  pub fn free_each(
    ts: List(SurfaceTerm),
    bound: List(Text),
    out: List(Text),
    skip: Bool
  ): List(Text) {
    match ts {
      Nil => out
      Cons(t, rest) => free_each(rest, bound, free_in(t, bound, out, skip), skip)
    }
  }

  pub fn free_fields(
    fs: List(SurfaceField),
    bound: List(Text),
    out: List(Text),
    skip: Bool
  ): List(Text) {
    match fs {
      Nil => out
      Cons(f, rest) => free_fields(rest, bound, free_field(f, bound, out, skip), skip)
    }
  }

  pub fn free_field(f: SurfaceField, bound: List(Text), out: List(Text), skip: Bool): List(Text) {
    match f {
      SurfaceFieldMk(^name, value) => free_in(value, bound, out, skip)
    }
  }

  pub fn free_opt(
    t: Option(SurfaceTerm),
    bound: List(Text),
    out: List(Text),
    skip: Bool
  ): List(Text) {
    match t {
      None => out
      Some(x) => free_in(x, bound, out, skip)
    }
  }

  pub fn free_arms(
    arms: List(SurfaceArm),
    bound: List(Text),
    out: List(Text),
    skip: Bool
  ): List(Text) {
    match arms {
      Nil => out
      Cons(arm, rest) => free_arms(rest, bound, free_arm(arm, bound, out, skip), skip)
    }
  }

  pub fn free_arm(arm: SurfaceArm, bound: List(Text), out: List(Text), skip: Bool): List(Text) {
    match arm {
      SurfaceArmMk(pattern, guard, ^goal, body) => free_in(
        body,
        pattern_names(pattern, bound),
        free_opt(guard, pattern_names(pattern, bound), out, skip),
        skip
      )
    }
  }

  pub fn free_handlers(
    hs: List(SurfaceHandler),
    bound: List(Text),
    out: List(Text),
    skip: Bool
  ): List(Text) {
    match hs {
      Nil => out
      Cons(h, rest) => free_handlers(rest, bound, free_handler(h, bound, out, skip), skip)
    }
  }

  pub fn free_handler(
    h: SurfaceHandler,
    bound: List(Text),
    out: List(Text),
    skip: Bool
  ): List(Text) {
    match h {
      HdReturn(p, body) => free_in(body, pattern_names(p, bound), out, skip)
      HdOperation(^eff, ^hfa, ^hty, patterns, cont, _, guard, body) => free_in(
        body,
        free_cont(cont, pattern_names_each(patterns, bound)),
        free_opt(guard, free_cont(cont, pattern_names_each(patterns, bound)), out, skip),
        skip
      )
    }
  }

  pub fn free_stmts(ss: List(SurfaceStmt), st: FreeState, skip: Bool): FreeState {
    match ss {
      Nil => st
      Cons(s, rest) => free_stmts(rest, free_stmt(s, st.bound, st.out, skip), skip)
    }
  }

  pub fn free_stmt(s: SurfaceStmt, bound: List(Text), out: List(Text), skip: Bool): FreeState {
    match s {
      StLet(name, ^ty, value, ^r#borrow, ^bm, ^unused, ^st_stack) => FreeState {
        bound: Cons(name, bound),
        out: free_in(value, bound, out, skip)
      }
      StVar(name, ^ty, value, ^vb, ^unused, ^st_stack) => FreeState {
        bound: Cons(name, bound),
        out: free_in(value, bound, out, skip)
      }
      StAssign(name, ^name_place, value) => FreeState {
        bound: bound,
        out: free_in(value, bound, free_note(name, bound, out), skip)
      }
      StFn(f) => free_fn(f, bound, out, skip)
      StWhile(c, body) => FreeState {
        bound: bound,
        out: free_in(body, bound, free_in(c, bound, out, skip), skip)
      }
      StReturn(e) => FreeState { bound: bound, out: free_opt(e, bound, out, skip) }
      StExpr(e) => FreeState { bound: bound, out: free_in(e, bound, out, skip) }
      _ => FreeState { bound: bound, out: out }
    }
  }

  pub fn free_fn(f: SurfaceFn, bound: List(Text), out: List(Text), skip: Bool): FreeState {
    match f {
      SurfaceFnMk(name, ^generics, ^bounds, params, ^r#borrows, ParamTypes, ^result, ^effects, ^wheres, ^start, ^end, body, ^lends, ^generic_types, ^bound_starts, ^visibility, ^row_hole, ^slot_unused, ^slot_unused_generics, ^slot_unused_params) => FreeState {
        bound: Cons(name, bound),
        out: free_in(body, free_names(params, Cons(name, bound)), out, skip)
      }
    }
  }
}

pub fn free_vars(t: SurfaceTerm): List(Text) {
  List::reverse(free_in(t, Nil, Nil, false))
}

pub fn used_vars(t: SurfaceTerm): List(Text) {
  List::reverse(free_in(t, Nil, Nil, true))
}

// `t` and every subterm, statements included, the last first (`visit` of
// `lin.rs` in reverse).
mutual {
  pub fn subterms(t: SurfaceTerm, acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match t {
      SurfaceTermIndexedMk(k, start, end, ast_occurrence) => subterms_kind(
        k,
        Cons(SurfaceTermIndexedMk(k, start, end, ast_occurrence), acc)
      )
    }
  }

  pub fn subterms_kind(k: SurfaceKind, here: List(SurfaceTerm)): List(SurfaceTerm) {
    match k {
      SkApp(f, args) => subterms_each(args, subterms(f, here))
      SkLam(^params, body, _, _) => subterms(body, here)
      SkBorrowLam(^r#borrows, lam) => subterms(lam, here)
      SkField(base, ^name) => subterms(base, here)
      SkTagged(^tag, x) => subterms(x, here)
      SkBorrow(^m, ^m_orig, x) => subterms(x, here)
      SkRecord(^name, fields) => subterms_fields(fields, here)
      SkIf(c, th, el) => subterms_opt(el, subterms(th, subterms(c, here)))
      SkPerform(^eff, args) => subterms_each(args, here)
      SkBudget(^steps_memory, steps, body) => subterms(body, subterms(steps, here))
      SkBlock(stmts) => subterms_stmts(stmts, here)
      SkHandle(body, handlers) => subterms_handlers(handlers, subterms(body, here))
      SkMatch(s, ^motive, arms, ^hb, _) => subterms_arms(arms, subterms(s, here))
      _ => here
    }
  }

  pub fn subterms_each(ts: List(SurfaceTerm), acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match ts {
      Nil => acc
      Cons(t, rest) => subterms_each(rest, subterms(t, acc))
    }
  }

  pub fn subterms_opt(t: Option(SurfaceTerm), acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match t {
      None => acc
      Some(x) => subterms(x, acc)
    }
  }

  pub fn subterms_fields(fs: List(SurfaceField), acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match fs {
      Nil => acc
      Cons(f, rest) => subterms_fields(rest, subterms_field(f, acc))
    }
  }

  pub fn subterms_field(f: SurfaceField, acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match f {
      SurfaceFieldMk(^name, value) => subterms(value, acc)
    }
  }

  pub fn subterms_stmts(ss: List(SurfaceStmt), acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match ss {
      Nil => acc
      Cons(s, rest) => subterms_stmts(rest, subterms_stmt(s, acc))
    }
  }

  pub fn subterms_stmt(s: SurfaceStmt, acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match s {
      StFn(f) => subterms_fn(f, acc)
      StLet(^name, ^ty, value, ^r#borrow, ^bm, ^unused, ^st_stack) => subterms(value, acc)
      StVar(^name, ^ty, value, ^vb, ^unused, ^st_stack) => subterms(value, acc)
      StAssign(^name, ^name_place, value) => subterms(value, acc)
      StExpr(e) => subterms(e, acc)
      StReturn(e) => subterms_opt(e, acc)
      StWhile(c, body) => subterms(body, subterms(c, acc))
      _ => acc
    }
  }

  pub fn subterms_fn(f: SurfaceFn, acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match f {
      SurfaceFnMk(^name, ^generics, ^bounds, ^params, ^r#borrows, ParamTypes, ^result, ^effects, ^wheres, ^start, ^end, body, ^lends, ^generic_types, ^bound_starts, ^visibility, ^row_hole, ^slot_unused, ^slot_unused_generics, ^slot_unused_params) => subterms(
        body,
        acc
      )
    }
  }

  pub fn subterms_handlers(hs: List(SurfaceHandler), acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match hs {
      Nil => acc
      Cons(h, rest) => subterms_handlers(rest, subterms_handler(h, acc))
    }
  }

  pub fn subterms_handler(h: SurfaceHandler, acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match h {
      HdReturn(^p, body) => subterms(body, acc)
      HdOperation(^eff, ^hfa, ^hty, ^patterns, ^cont, _, guard, body) => subterms_opt(
        guard,
        subterms(body, acc)
      )
    }
  }

  pub fn subterms_arms(arms: List(SurfaceArm), acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match arms {
      Nil => acc
      Cons(arm, rest) => subterms_arms(rest, subterms_arm(arm, acc))
    }
  }

  pub fn subterms_arm(arm: SurfaceArm, acc: List(SurfaceTerm)): List(SurfaceTerm) {
    match arm {
      SurfaceArmMk(^pattern, guard, ^goal, body) => subterms(body, subterms_opt(guard, acc))
    }
  }
}

pub fn borrow_root(t: SurfaceTerm): Option(Text) {
  match t.kind {
    SkBorrow(^m, ^m_orig, x) => ⊢ Option(Text) from match lin_place(x) {
      Some(p) => Some(p.fst)
      None => None
    }
    _ => None
  }
}

pub fn borrow_roots(ts: List(SurfaceTerm)): List(Text) {
  match ts {
    Nil => Nil
    Cons(t, rest) => ⊢ List(Text) from match borrow_root(t) {
      Some(r) => Cons(r, borrow_roots(rest))
      None => borrow_roots(rest)
    }
  }
}

pub fn var_is(t: SurfaceTerm, k: Text): Bool {
  match t.kind {
    SkVar(n) => surface_name_text(n) == k
    _ => false
  }
}

// The spans of the uses of `k` among the terms, the last first.
pub fn var_spans(ts: List(SurfaceTerm), k: Text): List(TySpan) {
  match ts {
    Nil => Nil
    Cons(t, rest) => if var_is(
      t,
      k
    ) { Cons(span_of(t), var_spans(rest, k)) } else { var_spans(rest, k) }
  }
}
