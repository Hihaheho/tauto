import "messages.taut"
import "types_match.taut"
import "match_written.taut"
import "../../surface/src/surface.taut"
import std::base
import std::list
import std::map
import std::text
import "checker.taut"
import "datas.taut"
import "freevars.taut"
import "ty.taut"
import "types_decl.taut"
import "types_decl_head.taut"
import "../../text/src/text.taut"
import "infer_parts.taut"
import "../../identity/src/identity.taut"

// The expressions and statements checked, one calling another (`stmt`,
// `infer`, `lambda`, `handle` of `types.rs`). What they share is in
// `infer_parts.taut`.

mutual {
  pub fn ck_infer_in(k: Nat, c: &mut Checker, term: SurfaceTerm, env: List(Local)): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => {
        let t := ck_infer_term_in(j, &mut c, term, env)
        set_to(&mut c.result_hint, None)
        set_to(&mut c.terms, Cons(#(term_at_of(term), t), c.terms))
        t
      }
    }
  }

  pub fn ck_infer_term_in(k: Nat, c: &mut Checker, term: SurfaceTerm, env: List(Local)): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => {
        let span := span_of(term)
        ⊢ Ty from match term.kind {
          SkNat(n) => ck_nat_literal(&mut c, n, span)
          SkText(^s) => TyText
          SkFloat(x) => ck_float_literal(&mut c, x, span)
          SkBool(^b) => TyBool
          SkVar(name) => ck_lookup(&mut c, surface_name_text(name), env, span, term.occurrence)
          SkLam(^params, ^body, _, _) => ck_lambda_in(j, &mut c, term, Nil, env)
          SkBorrowLam(r#borrows, lam) => ck_lambda_in(j, &mut c, lam, r#borrows, env)
          SkBorrow(mutable, ^mutable_orig, inner) => {
            ck_check_lend(&mut c, mutable, inner, env, span)
            let t := ck_infer_in(j, &mut c, inner, env)
            ck_borrow_of(c, t, mutable)
          }
          SkRecord(name, fields) => ck_record_in(j, &mut c, name, fields, env, span)
          SkApp(function, arguments) => ck_app_in(j, &mut c, term, function, arguments, env)
          SkField(base, name) => ⊢ Ty from match class_of_base(c, base, env) {
            Some(cn) => {
              let full := cat3(cn, "::", name)
              if Ordmap::contains(c.fns, full, Ordmap::compare_text) {
                ck_lookup(&mut c, full, env, span, term.occurrence)
              } else {
                ck_error(&mut c, no_method_message(cn, name), span)
                ck_fresh(&mut c)
              }
            }
            None => {
              let b := ck_infer_in(j, &mut c, base, env)
              ck_field_through(&mut c, term, coerce_place(base), b, name)
            }
          }
          SkIf(condition, th, el) => {
            let hint := c.result_hint
            set_to(&mut c.result_hint, None)
            let ct := ck_infer_in(j, &mut c, condition, env)
            ck_expect(&mut c, ct, TyBool, span_of(condition), what_if_condition_message())
            set_to(&mut c.result_hint, ck_result_hint_for(th, hint))
            let t := ck_infer_in(j, &mut c, th, env)
            set_to(&mut c.result_hint, ck_else_hint(el, hint))
            ck_else_in(j, &mut c, t, el, env)
          }
          SkBlock(stmts) => {
            let saved := c.arm_hint
            set_to(&mut c.arm_hint, c.result_hint)
            var inner: Scope := Scope { items: env }
            let t := ck_block_in(j, &mut c, stmts, &mut inner, false, TyUnit)
            set_to(&mut c.arm_hint, saved)
            t
          }
          SkMatch(scrutinee, motive, arms, ^binder, _) => {
            let hint := c.result_hint
            let saved := c.arm_hint
            let before := ck_match_before(&mut c, motive, arms, env)
            set_to(&mut c.arm_hint, ck_hint_or_before(before, hint))
            set_to(&mut c.result_hint, None)
            let got := ck_match_expr_in(j, &mut c, scrutinee, arms, env, span)
            set_to(&mut c.arm_hint, saved)
            ck_match_after(&mut c, before, arms, got, span)
          }
          SkPerform(eff, args) => {
            let types := ck_infer_each_in(j, &mut c, args, env)
            ck_perform_of(&mut c, eff, types, args, span)
          }
          SkHandle(body, handlers) => ck_handle_in(j, &mut c, body, handlers, env)
          SkBudget(^steps_memory, steps, body) => {
            let s := ck_infer_in(j, &mut c, steps, env)
            ck_expect(&mut c, s, TyInt(WidthU64), span_of(steps), what_budget_steps_message())
            let t := ck_infer_in(j, &mut c, body, env)
            ck_budget_answer(&mut c, t, span)
            t
          }
          SkTagged(tag, x) => {
            let t := ck_infer_in(j, &mut c, x, env)
            ty_tagged(Cons(tag, Nil), ck_resolve(&c, t))
          }
          // `syntax::expand` reported why it is still here.
          SkSyntaxLit(^name, ^written) => ck_fresh(&mut c)
          SkMacroCall(^name, ^arg) => ck_fresh(&mut c)
          SkQuote(^stmts_form, ^stmts) => ck_fresh(&mut c)
          SkSplice(^inner) => ck_fresh(&mut c)
          _ => {
            ck_error(&mut c, not_supported_yet_message(sk_name(term.kind)), span)
            ck_fresh(&mut c)
          }
        }
      }
    }
  }

  pub fn ck_else_in(k: Nat, c: &mut Checker, t: Ty, el: Option(SurfaceTerm), env: List(Local)): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => ⊢ Ty from match el {
        Some(o) => {
          let ot := ck_infer_in(j, &mut c, o, env)
          ck_join(&mut c, t, ot)
        }
        None => TyUnit
      }
    }
  }

  pub fn ck_infer_each_in(
    k: Nat,
    c: &mut Checker,
    ts: List(SurfaceTerm),
    env: List(Local)
  ): List(Ty) {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        Nil
      }
      Succ(j) => ⊢ List(Ty) from match ts {
        Nil => Nil
        Cons(t, rest) => {
          let h := ck_infer_in(j, &mut c, t, env)
          let tl := ck_infer_each_in(j, &mut c, rest, env)
          Cons(h, tl)
        }
      }
    }
  }

  pub fn ck_guard_in(k: Nat, c: &mut Checker, guard: Option(SurfaceTerm), env: List(Local)): Unit {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        #()
      }
      Succ(j) => ⊢ Unit from match guard {
        Some(g) => {
          let gt := ck_infer_in(j, &mut c, g, env)
          ck_expect(&mut c, gt, TyBool, span_of(g), what_guard_message())
        }
        None => #()
      }
    }
  }

  // ----- statements -----

  pub fn ck_stmt_in(k: Nat, c: &mut Checker, s: SurfaceStmt, env: &mut Scope): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => ⊢ Ty from match s {
        StLet(name, ty, value, r#borrow, bm, ^unused, ^st_stack) => {
          set_to(&mut c.result_hint, ck_let_hint(ty, value))
          let v := ck_infer_in(j, &mut c, value, env.items)
          ck_let(&mut c, &mut env, name, ty, v, value, r#borrow, bm)
          TyUnit
        }
        StVar(name, ty, value, vb, ^unused, ^st_stack) => {
          let v := ck_infer_in(j, &mut c, value, env.items)
          ck_var(&mut c, &mut env, name, ty, v, value, vb)
          TyUnit
        }
        StAssign(name, name_place, value) => {
          let v := ck_infer_in(j, &mut c, value, env.items)
          ck_coerce_assign_place(&mut c, env.items, name_place)
          ⊢ Ty from match ck_assign_field_place(name_place) {
            None => {
              ck_assign(&mut c, env.items, name, ck_place_deref(name_place), v, value)
              TyUnit
            }
            Some(place) => ⊢ Ty from match ck_place_ok(&c, env.items, name, place) {
              true => {
                let pt := ck_infer_in(j, &mut c, place, env.items)
                ck_assign_place(&mut c, env.items, name, ck_place_deref(name_place), v, pt, place, value)
                TyUnit
              }
              false => {
                ck_assign_refuse(&mut c, env.items, name, place, value)
                TyUnit
              }
            }
          }
        }
        StFn(f) => {
          let scheme := ck_signature(&mut c, f)
          ck_bind_local(&mut c, &mut env, f.name, scheme_local_type(scheme), false, f.body.start)
          ck_check_fn_in(j, &mut c, f, scheme, env.items)
          TyUnit
        }
        StEffect(e) => {
          ck_declare_effect(&mut c, e)
          TyUnit
        }
        StWhile(condition, body) => {
          let t := ck_infer_in(j, &mut c, condition, env.items)
          ck_expect(&mut c, t, TyBool, span_of(condition), what_while_condition_message())
          let ignored := ck_infer_in(j, &mut c, body, env.items)
          TyUnit
        }
        StReturn(e) => {
          let returned := ck_returned_in(j, &mut c, e, env.items)
          ck_return_check(&mut c, returned.fst, returned.snd)
          TyNever
        }
        StExpr(e) => ck_infer_in(j, &mut c, e, env.items)
        _ => ck_stmt_other(&mut c, s)
      }
    }
  }

  // The value `return` gives and where it is written.
  pub fn ck_returned_in(
    k: Nat,
    c: &mut Checker,
    e: Option(SurfaceTerm),
    env: List(Local)
  ): Ty × TySpan {
    ⊢ (Ty × TySpan) from match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        #(TyUnit, TySpan { start: 0, end: 0 })
      }
      Succ(j) => ⊢ (Ty × TySpan) from match e {
        Some(x) => {
          set_to(&mut c.result_hint, ck_result_hint_for(x, ck_return_hint(c.returns)))
          let t := ck_infer_in(j, &mut c, x, env)
          #(t, span_of(x))
        }
        None => #(TyUnit, TySpan { start: 0, end: 0 })
      }
    }
  }

  pub fn ck_check_fn_in(
    k: Nat,
    c: &mut Checker,
    f: SurfaceFn,
    scheme: Scheme,
    env: List(Local)
  ): Unit {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        #()
      }
      Succ(j) => ⊢ Unit from match scheme.ty {
        TyFn(params, result, ^fk) => {
          var inner: Scope := Scope { items: env }
          ck_bind_params(f.params, &mut c, &mut inner, params, f.body.start)
          set_to(&mut c.returns, Cons(result, c.returns))
          let outer: List(Text × Text) := c.assume
          let outer_types: List(TypeName) := c.type_params
          ck_enter_fn(&mut c, scheme)
          set_to(&mut c.result_hint, ck_result_hint_for(f.body, Some(result)))
          let body := ck_infer_in(j, &mut c, f.body, inner.items)
          ck_leave_fn(&mut c, outer, outer_types)
          set_to(&mut c.returns, List::tail(c.returns))
          ck_expect(&mut c, body, result, span_of(f.body), what_result_of_message(f.name))
        }
        _ => #()
      }
    }
  }

  pub fn ck_block_in(
    k: Nat,
    c: &mut Checker,
    stmts: List(SurfaceStmt),
    env: &mut Scope,
    stopped: Bool,
    last: Ty
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => ⊢ Ty from match stmts {
        Nil => if stopped { TyNever } else { last }
        Cons(s, rest) => {
          set_to(&mut c.result_hint, ck_block_hint_for(s, rest, c.arm_hint))
          let t := ck_stmt_in(j, &mut c, s, &mut env)
          ck_block_in(j, &mut c, rest, &mut env, stopped || ty_is_never(t), block_value(s, rest, t))
        }
      }
    }
  }

  pub fn ck_app_args_in(
    k: Nat,
    c: &mut Checker,
    arguments: List(SurfaceTerm),
    known: Option(List(Ty)),
    env: List(Local),
    i: Nat
  ): List(Ty) {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        Nil
      }
      Succ(j) => ⊢ List(Ty) from match arguments {
        Nil => Nil
        Cons(a, rest) => {
          let expected := ck_expected(known, i)
          if ck_is_lambda(a) {
            set_to(&mut c.hint, expected)
          } else {
            set_to(&mut c.result_hint, ck_result_hint_for(a, expected))
          }
          let t := ck_infer_in(j, &mut c, a, env)
          set_to(&mut c.hint, None)
          ck_expect_opt(&mut c, t, expected, a)
          let tl := ck_app_args_in(j, &mut c, rest, known, env, i + 1)
          Cons(t, tl)
        }
      }
    }
  }

  pub fn ck_app_in(
    k: Nat,
    c: &mut Checker,
    term: SurfaceTerm,
    function: SurfaceTerm,
    arguments: List(SurfaceTerm),
    env: List(Local)
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => ⊢ Ty from match ck_direct_name(function, env) {
        // `#(a, b)`: the prelude's `Pair::Mk` of the two members.
        Some(name) => if name == "std::prelude::Pair::Mk" {
          let types := ck_infer_each_in(j, &mut c, arguments, env)
          ck_product_of(&mut c, types, arguments, span_of(term))
        } else if name == "#ascribe" {
          let types := ck_infer_each_in(j, &mut c, ascribe_body(arguments), env)
          ck_ascribe_of(&mut c, types, term, arguments)
        } else if ck_is_operator(name) {
          let args := ck_operands_in(j, &mut c, arguments, env)
          ck_operator_of(&mut c, name, args, arguments, span_of(term), term.occurrence)
        } else if name == "clone" && not(Ordmap::contains(c.fns, name, Ordmap::compare_text)) {
          ck_clone_of_in(j, &mut c, arguments, env, span_of(term))
        } else if ck_nullary_call(c, name, arguments) {
          // A constructor without fields is written without `()`.
          ck_error(&mut c, constructor_without_fields_message(name), span_of(term))
          ck_infer_in(j, &mut c, function, env)
        } else {
          ck_app_call_in(j, &mut c, term, function, arguments, env)
        }
        None => ck_app_call_in(j, &mut c, term, function, arguments, env)
      }
    }
  }

  pub fn ck_app_call_in(
    k: Nat,
    c: &mut Checker,
    term: SurfaceTerm,
    function: SurfaceTerm,
    arguments: List(SurfaceTerm),
    env: List(Local)
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => {
        let hint := c.result_hint
        set_to(&mut c.result_hint, None)
        let rest := ck_call_arguments(arguments)
        let inferred := ck_infer_in(j, &mut c, function, env)
        let f := ck_call_instance(&mut c, function, inferred, ck_call_implicits(arguments), hint)
        // A lambda argument learns its parameters' types from the callee's,
        // once the arguments before it are checked.
        let known := ck_known_params(c, f, list_len(rest))
        let args := ck_app_args_in(j, &mut c, rest, known, env, 0)
        ck_app_result(&mut c, term, function, rest, f, known, args)
      }
    }
  }

  pub fn ck_operands_in(
    k: Nat,
    c: &mut Checker,
    arguments: List(SurfaceTerm),
    env: List(Local)
  ): List(Ty) {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        Nil
      }
      Succ(j) => ⊢ List(Ty) from match arguments {
        Nil => Nil
        Cons(a, rest) => {
          let t := ck_infer_in(j, &mut c, a, env)
          let h := ty_operand(ck_resolve(&c, t))
          let tl := ck_operands_in(j, &mut c, rest, env)
          Cons(h, tl)
        }
      }
    }
  }

  pub fn ck_clone_of_in(
    k: Nat,
    c: &mut Checker,
    arguments: List(SurfaceTerm),
    env: List(Local),
    span: TySpan
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => ⊢ Ty from match arguments {
        Cons(arg, rest) => ⊢ Ty from match rest {
          Nil => {
            let t0 := ck_infer_in(j, &mut c, arg, env)
            ck_clone_value(&mut c, t0, arg, span)
          }
          Cons(^x, ^more) => ck_clone_bad(&mut c, span)
        }
        Nil => ck_clone_bad(&mut c, span)
      }
    }
  }

  pub fn ck_lambda_in(
    k: Nat,
    c: &mut Checker,
    lam: SurfaceTerm,
    r#borrows: List(Option(Bool)),
    env: List(Local)
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => {
        let hint := c.hint
        set_to(&mut c.hint, None)
        ⊢ Ty from match lam.kind {
          SkLam(params, body, types, _) => {
            let ps := ck_lambda_params(params, &mut c, r#borrows)
            ck_lambda_hints(&mut c, hint, ps, types)
            let cap := ck_lambda_captures(lam, c, env)
            var inner: Scope := Scope { items: env }
            ck_bind_params(params, &mut c, &mut inner, ps, body.start)
            let r := ck_fresh(&mut c)
            set_to(&mut c.returns, Cons(r, c.returns))
            let b := ck_infer_in(j, &mut c, body, inner.items)
            set_to(&mut c.returns, List::tail(c.returns))
            ck_expect(&mut c, b, r, span_of(body), what_function_result_message())
            set_to(
              &mut c.closure_results,
              Cons(TyClosure { ty: r, start: body.start, end: body.end, cap: cap }, c.closure_results)
            )
            TyFn(ps, r, captures_kind(cap))
          }
          _ => ck_fresh(&mut c)
        }
      }
    }
  }

  pub fn ck_record_fields_in(
    k: Nat,
    c: &mut Checker,
    name: Text,
    fields: List(SurfaceField),
    declared: List(DataField),
    env: List(Local),
    seen: List(Text)
  ): List(Text) {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        seen
      }
      Succ(j) => ⊢ List(Text) from match fields {
        Nil => seen
        Cons(f, rest) => {
          let v := ck_infer_in(j, &mut c, f.value, env)
          let again := ck_record_field_check(&mut c, name, f, v, declared, seen)
          ck_record_fields_in(j, &mut c, name, rest, declared, env, seen_with(again, seen, f.name))
        }
      }
    }
  }

  pub fn ck_record_in(
    k: Nat,
    c: &mut Checker,
    name: Text,
    fields: List(SurfaceField),
    env: List(Local),
    span: TySpan
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => ⊢ Ty from match datas_ctor(c.datas, name) {
        None => {
          ck_error(&mut c, not_a_struct_message(name), span)
          ck_fresh(&mut c)
        }
        Some(dc) => {
          let d := dc.fst
          let args := ck_fresh_each(data_generics_of(c.datas, d), &mut c)
          let declared := datas_fields(c.datas, d, dc.snd, args)
          let seen := ck_record_fields_in(j, &mut c, name, fields, declared, env, Nil)
          ck_record_missing(declared, &mut c, name, seen, span)
          TyNamed(NameSpelled(d), args)
        }
      }
    }
  }

  // ----- match -----

  pub fn ck_match_arms_in(
    k: Nat,
    c: &mut Checker,
    arms: List(SurfaceArm),
    s: Ty,
    env: List(Local),
    result: Option(Ty)
  ): Option(Ty) {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        result
      }
      Succ(j) => ⊢ Option(Ty) from match arms {
        Nil => result
        Cons(arm, rest) => {
          var inner: Scope := Scope { items: env }
          ck_pattern(&mut c, arm.pattern, s, &mut inner, span_of(arm.body), arm.body.start)
          ck_guard_in(j, &mut c, arm.guard, inner.items)
          set_to(&mut c.result_hint, ck_result_hint_for(arm.body, c.arm_hint))
          let b := ck_infer_in(j, &mut c, arm.body, inner.items)
          let joined := ck_join_opt(&mut c, result, b)
          ck_match_arms_in(j, &mut c, rest, s, env, Some(joined))
        }
      }
    }
  }

  pub fn ck_match_expr_in(
    k: Nat,
    c: &mut Checker,
    scrutinee: SurfaceTerm,
    arms: List(SurfaceArm),
    env: List(Local),
    span: TySpan
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => {
        let read := ck_infer_in(j, &mut c, scrutinee, env)
        let s := ck_coerce_scrutinee(&mut c, read, arms, span_of(scrutinee))
        let result := ck_match_arms_in(j, &mut c, arms, s, env, None)
        ck_check_covers(&mut c, s, arms, span)
        ⊢ Ty from match result {
          Some(t) => t
          None => TyNever
        }
      }
    }
  }

  pub fn ck_handle_in(
    k: Nat,
    c: &mut Checker,
    body: SurfaceTerm,
    handlers: List(SurfaceHandler),
    env: List(Local)
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        TyNever
      }
      Succ(j) => {
        let answers_exceeded := handlers_answer_exceeded(handlers)
        let budget_ty := ck_fresh(&mut c)
        if answers_exceeded {
          set_to(&mut c.exceeded, Cons(budget_ty, c.exceeded))
        }
        let b := ck_infer_in(j, &mut c, body, env)
        if answers_exceeded {
          set_to(&mut c.exceeded, List::tail(c.exceeded))
        }
        // The result: the `return` arm's type (or the body's), widened by
        // each arm into a union.
        let result := ck_fresh(&mut c)
        let first := ck_handle_first_in(j, &mut c, handlers, b, env)
        ck_handle_result_in(j, &mut c, handlers, env, result, first, budget_ty)
        result
      }
    }
  }

  pub fn ck_handle_first_in(
    k: Nat,
    c: &mut Checker,
    handlers: List(SurfaceHandler),
    b: Ty,
    env: List(Local)
  ): Ty {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        b
      }
      Succ(j) => ⊢ Ty from match handlers_return(handlers) {
        Some(r) => {
          var inner: Scope := Scope { items: env }
          ck_pattern(&mut c, r.fst, b, &mut inner, span_of(r.snd), r.snd.start)
          ck_infer_in(j, &mut c, r.snd, inner.items)
        }
        None => b
      }
    }
  }

  pub fn ck_handle_result_in(
    k: Nat,
    c: &mut Checker,
    handlers: List(SurfaceHandler),
    env: List(Local),
    result: Ty,
    first: Ty,
    budget_ty: Ty
  ): Unit {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        #()
      }
      Succ(j) => ⊢ Unit from match ty_var_of(result) {
        Some(rv) => {
          ck_set_subst(&mut c, rv, first)
          ck_handle_arms_in(j, &mut c, handlers, env, result, Some(rv), budget_ty)
          // Validate every use of the continuation against all arm results.
          let complete := ck_resolve(&c, result)
          ck_handle_arms_in(j, &mut c, handlers, env, complete, None, budget_ty)
        }
        None => #()
      }
    }
  }

  pub fn ck_handle_arms_in(
    k: Nat,
    c: &mut Checker,
    hs: List(SurfaceHandler),
    env: List(Local),
    result: Ty,
    rv: Option(Nat),
    budget_ty: Ty
  ): Unit {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        #()
      }
      Succ(j) => ⊢ Unit from match hs {
        Nil => #()
        Cons(h, rest) => {
          ck_handle_one_in(j, &mut c, h, env, result, rv, budget_ty)
          ck_handle_arms_in(j, &mut c, rest, env, result, rv, budget_ty)
        }
      }
    }
  }

  pub fn ck_handle_one_in(
    k: Nat,
    c: &mut Checker,
    h: SurfaceHandler,
    env: List(Local),
    result: Ty,
    rv: Option(Nat),
    budget_ty: Ty
  ): Unit {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        #()
      }
      Succ(j) => ⊢ Unit from match h {
        HdReturn(^p, ^b) => #()
        HdOperation(eff, hfa, hty, patterns, cont, _, guard, body) => ck_handle_arm_in(
          j,
          &mut c,
          env,
          result,
          rv,
          budget_ty,
          eff,
          hfa,
          hty,
          patterns,
          cont,
          guard,
          body
        )
      }
    }
  }

  pub fn ck_handle_arm_in(
    k: Nat,
    c: &mut Checker,
    env: List(Local),
    result: Ty,
    rv: Option(Nat),
    budget_ty: Ty,
    eff: Text,
    binds: List(Text),
    types: List(SurfaceTerm),
    patterns: List(SurfacePattern),
    cont: Option(Text),
    guard: Option(SurfaceTerm),
    body: SurfaceTerm
  ): Unit {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        #()
      }
      Succ(j) => ⊢ Unit from match ck_handle_arm_sig(
        &mut c,
        eff,
        binds,
        types,
        result,
        rv,
        budget_ty,
        body
      ) {
        None => #()
        Some(pa) => if not(list_len(pa.params) == list_len(patterns)) {
          ck_error(
            &mut c,
            arm_value_count_message(eff, Text::of_nat(list_len(pa.params)), Text::of_nat(list_len(patterns))),
            span_of(body)
          )
        } else {
          ck_handle_body_in(
            j,
            &mut c,
            env,
            result,
            rv,
            eff,
            pa.params,
            pa.answer,
            pa.rigid,
            pa.bound,
            patterns,
            cont,
            guard,
            body
          )
        }
      }
    }
  }

  pub fn ck_handle_body_in(
    k: Nat,
    c: &mut Checker,
    env: List(Local),
    result: Ty,
    rv: Option(Nat),
    eff: Text,
    params: List(Ty),
    answer: Ty,
    rigid: List(Text),
    bound: List(TypeName),
    patterns: List(SurfacePattern),
    cont: Option(Text),
    guard: Option(SurfaceTerm),
    body: SurfaceTerm
  ): Unit {
    match k {
      Zero => {
        ck_error(&mut c, "type checking ran out of steps", TySpan { start: 0, end: 0 })
        #()
      }
      Succ(j) => {
        let quant := ck_quant_of(c, eff)
        ck_handle_direct(&mut c, quant, eff, cont, guard, body)
        var inner: Scope := Scope { items: env }
        ck_handle_patterns(patterns, &mut c, params, &mut inner, body)
        ck_handle_cont(&mut c, &mut inner, quant, eff, cont, answer, result, body)
        let outer_types: List(TypeName) := c.type_params
        ck_arm_enter(&mut c, bound)
        ck_guard_in(j, &mut c, guard, inner.items)
        let a := ck_infer_in(j, &mut c, body, inner.items)
        ck_handle_arm_finish(&mut c, eff, rigid, env, outer_types, a, result, rv, span_of(body))
      }
    }
  }
}

pub fn ck_infer(c: &mut Checker, term: SurfaceTerm, env: List(Local)): Ty {
  ck_infer_in(c.steps, &mut c, term, env)
}

pub fn ck_stmt(c: &mut Checker, s: SurfaceStmt, env: &mut Scope): Ty {
  ck_stmt_in(c.steps, &mut c, s, &mut env)
}

pub fn ck_check_fn(c: &mut Checker, f: SurfaceFn, scheme: Scheme, env: List(Local)): Unit {
  ck_check_fn_in(c.steps, &mut c, f, scheme, env)
}
