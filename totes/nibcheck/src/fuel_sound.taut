import "finish_frame.taut"

pub fn fuel_errors(c: Checker): List(TypeError) { c.errors }
pub fn fuel_has_errors(es: List(TypeError)): Bool {
  match es: Bool { Nil => false
    Cons(e, rest) => true }
}
pub fn fuel_second_state<A: Type>(m: Mut2(A, Checker, Scope)): Checker {
  match m: Checker { mut2(v, c, env) => c }
}

pub theorem ck_infer_in_fuel_error(
  c: Checker,
  term: SurfaceTerm,
  env: List(Local)
): fuel_has_errors(fuel_errors(ck_st(ck_infer_in(Zero, c, term, env)))) = true { Refl }

