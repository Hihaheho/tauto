pub def Inference_ck_infer_in_checked(
  k: Nat
): Prop := ∀ c: Checker. ∀ term: SurfaceTerm. ∀ env: List(
  Local
). ∀ ordered: CkOrdered(c). CkCheckedFrame(c, ck_infer_in(k, c, term, env))

