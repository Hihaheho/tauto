pub theorem inference_use_ck_handle_in_checked(
  k: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_checked(k)
): CkCheckedFrame(c, ck_handle_in(k, c, body, handlers, env)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(
                            And::right(
                              And::right(
                                And::right(And::right(And::right(And::right(And::right(ih)))))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, body, handlers, env, ordered)
}

