    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body
  )
)

pub def InferenceFrames_checked(
  k: Nat
): Prop := And(
  Inference_ck_infer_in_checked(k),
  And(
    Inference_ck_infer_term_in_checked(k),
    And(
      Inference_ck_else_in_checked(k),
      And(
        Inference_ck_infer_each_in_checked(k),
        And(
          Inference_ck_guard_in_checked(k),
          And(
            Inference_ck_stmt_in_checked(k),
            And(
              Inference_ck_returned_in_checked(k),
              And(
                Inference_ck_check_fn_in_checked(k),
                And(
                  Inference_ck_block_in_checked(k),
                  And(
                    Inference_ck_app_args_in_checked(k),
                    And(
                      Inference_ck_app_in_checked(k),
                      And(
                        Inference_ck_app_call_in_checked(k),
                        And(
                          Inference_ck_operands_in_checked(k),
                          And(
                            Inference_ck_clone_of_in_checked(k),
                            And(
                              Inference_ck_lambda_in_checked(k),
                              And(
                                Inference_ck_record_fields_in_checked(k),
                                And(
                                  Inference_ck_record_in_checked(k),
                                  And(
                                    Inference_ck_match_arms_in_checked(k),
                                    And(
                                      Inference_ck_match_expr_in_checked(k),
                                      And(
                                        Inference_ck_handle_in_checked(k),
                                        And(
                                          Inference_ck_handle_first_in_checked(k),
                                          And(
                                            Inference_ck_handle_result_in_checked(k),
                                            And(
                                              Inference_ck_handle_arms_in_checked(k),
                                              And(
                                                Inference_ck_handle_one_in_checked(k),
                                                And(
                                                  Inference_ck_handle_arm_in_checked(k),
                                                  And(Inference_ck_handle_body_in_checked(k), True)
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

pub theorem inference_use_ck_infer_in_checked(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_checked(k)
): CkCheckedFrame(c, ck_infer_in(k, c, term, env)) { And::left(ih)(c, term, env, ordered) }

pub theorem inference_use_ck_infer_term_in_checked(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_checked(k)
): CkCheckedFrame(
  c,
  ck_infer_term_in(k, c, term, env)
) { And::left(And::right(ih))(c, term, env, ordered) }

pub theorem inference_use_ck_else_in_checked(
  k: Nat,
  c: Checker,
  t: Ty,
  el: Option(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_checked(k)
): CkCheckedFrame(
  c,
  ck_else_in(k, c, t, el, env)
) { And::left(And::right(And::right(ih)))(c, t, el, env, ordered) }

