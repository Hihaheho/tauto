pub theorem inference_bind_scope_frame_checked<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker, Scope) -> Mut1(B, Checker),
  m: Mut2(A, Checker, Scope),
  hm: CkScopeChecked(c, m),
  hk: ∀ v: A. ∀ next: Checker. ∀ env: Scope. ∀ ordered: CkOrdered(
    next
  ). CkCheckedFrame(next, k(v, next, env))
): CkCheckedFrame(c, inference_bind_scope(k, m)) {
  ⊢ CkCheckedFrame(c, inference_bind_scope(k, m)) from match m {
    mut2(v, next, env) => {
      let h: CkCheckedFrame(next, k(v, next, env)) := hk(v, next, env, And::left(hm))
      AndIntro(And::left(h), clean_errors => And::right(hm)(And::right(h)(clean_errors)))
    }
  }
}
