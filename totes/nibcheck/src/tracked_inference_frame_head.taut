pub theorem inference_handle_arms_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  hs: List(SurfaceHandler),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_handle_arms(j, c, env, result, rv, budget_ty, hs)) {
  match hs {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(h, rest) => tracked_run_bind(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(
        ck_handle_arms_in(j, c1, rest, env, result, rv, budget_ty)
      ),
      ck_handle_one_in(j, c, h, env, result, rv, budget_ty),
      inference_use_ck_handle_one_in_tracked(j, c, h, env, result, rv, budget_ty, ordered, ih),
      ignored => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_handle_arms_in(j, c1, rest, env, result, rv, budget_ty),
        inference_use_ck_handle_arms_in_tracked(j, c1, rest, env, result, rv, budget_ty, o_c1, ih)
      )
    )
  }
}

