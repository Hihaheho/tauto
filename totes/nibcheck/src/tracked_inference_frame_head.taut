): TrackedRunFrame(c, inference_budget_pop(j, c, answers)) {
  match answers {
    true => tracked_run_read(
      c,
      inference_set_exceeded(c, List::tail(inference_exceeded(c))),
      inference_set_exceeded_frame(c, List::tail(inference_exceeded(c))),
      inference_set_exceeded_frame_tracked(c, List::tail(inference_exceeded(c))),
      ordered
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem inference_use_ck_handle_first_in_tracked(
  k: Nat,
  c: Checker,
  handlers: List(SurfaceHandler),
  b: Ty,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_handle_first_in(k, c, handlers, b, env)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(
                            And::right(
                              And::right(
                                And::right(
                                  And::right(And::right(And::right(And::right(And::right(ih)))))
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, handlers, b, env, ordered)
}

