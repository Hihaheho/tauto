    Eq::sym(inference_unf_ck_infer_term_in(j, c, term, env)),
    inference_step_ck_infer_term_in_frame_tracked(j, c, term, env, ih, ordered)
  )
}
pub theorem inference_successor_ck_else_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_else_in_tracked(Succ(j)) {
  c => t => el => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_else_in(j, c, t, el, env)),
    inference_step_ck_else_in_frame_tracked(j, c, t, el, env, ih, ordered)
  )
}
pub theorem inference_successor_ck_infer_each_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_infer_each_in_tracked(Succ(j)) {
  c => ts => env => ordered => Eq::subst(
    (z: Mut1(List(Ty), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_infer_each_in(j, c, ts, env)),
    inference_step_ck_infer_each_in_frame_tracked(j, c, ts, env, ih, ordered)
  )
}
