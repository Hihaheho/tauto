pub def InferenceFrames_tracked(
  k: Nat
): Prop := And(
  Inference_ck_infer_in_tracked(k),
  And(
    Inference_ck_infer_term_in_tracked(k),
    And(
      Inference_ck_else_in_tracked(k),
      And(
        Inference_ck_infer_each_in_tracked(k),
        And(
          Inference_ck_guard_in_tracked(k),
          And(
            Inference_ck_stmt_in_tracked(k),
            And(
              Inference_ck_returned_in_tracked(k),
              And(
                Inference_ck_check_fn_in_tracked(k),
                And(
                  Inference_ck_block_in_tracked(k),
                  And(
                    Inference_ck_app_args_in_tracked(k),
                    And(
                      Inference_ck_app_in_tracked(k),
                      And(
                        Inference_ck_app_call_in_tracked(k),
                        And(
                          Inference_ck_operands_in_tracked(k),
                          And(
                            Inference_ck_clone_of_in_tracked(k),
                            And(
                              Inference_ck_lambda_in_tracked(k),
                              And(
                                Inference_ck_record_fields_in_tracked(k),
                                And(
                                  Inference_ck_record_in_tracked(k),
                                  And(
                                    Inference_ck_match_arms_in_tracked(k),
                                    And(
                                      Inference_ck_match_expr_in_tracked(k),
                                      And(
                                        Inference_ck_handle_in_tracked(k),
                                        And(
                                          Inference_ck_handle_first_in_tracked(k),
                                          And(
                                            Inference_ck_handle_result_in_tracked(k),
                                            And(
                                              Inference_ck_handle_arms_in_tracked(k),
                                              And(
                                                Inference_ck_handle_one_in_tracked(k),
                                                And(
                                                  Inference_ck_handle_arm_in_tracked(k),
                                                  And(Inference_ck_handle_body_in_tracked(k), True)
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

pub theorem inference_class_method_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  cn: Text,
  found: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_class_method(j, c, term, env, span, base, name, cn, found)) {
  ⊢ TrackedRunFrame(
    c,
    inference_class_method(j, c, term, env, span, base, name, cn, found)
  ) from match found {
    true => tracked_run_read(
      c,
      ck_rewrap1(ck_lookup(c, cat3(cn, "::", name), env, span, term.occurrence)),
      frame_rewrap(
        c,
        ck_lookup(c, cat3(cn, "::", name), env, span, term.occurrence),
        ck_lookup_frame(c, cat3(cn, "::", name), env, span, term.occurrence)
      ),
      tracked_rewrap(
        c,
        ck_lookup(c, cat3(cn, "::", name), env, span, term.occurrence),
        ck_lookup_frame_tracked(c, cat3(cn, "::", name), env, span, term.occurrence)
      ),
      ordered
    )
    false => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(ck_error(c, no_method_message(cn, name), span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, no_method_message(cn, name), span)),
        frame_rewrap(
          c,
          ck_error(c, no_method_message(cn, name), span),
          ck_error_frame(c, no_method_message(cn, name), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, no_method_message(cn, name), span),
          ck_error_frame_tracked(c, no_method_message(cn, name), span)
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
  }
}

pub theorem inference_use_ck_infer_in_tracked(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_infer_in(k, c, term, env)) { And::left(ih)(c, term, env, ordered) }

pub theorem inference_field_base_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  base: SurfaceTerm,
  name: Text,
  r#class: Option(Text),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_field_base(j, c, term, env, span, base, name, r#class)) {
  ⊢ TrackedRunFrame(
    c,
    inference_field_base(j, c, term, env, span, base, name, r#class)
  ) from match r#class {
    None => tracked_run_bind(
      <A: Ty, B: Ty>,
      c,
      (b: Ty, c1: Checker) => ck_rewrap1(ck_field_through(c1, term, coerce_place(base), b, name)),
      ck_infer_in(j, c, base, env),
      inference_use_ck_infer_in_tracked(j, c, base, env, ordered, ih),
      b => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_field_through(c1, term, coerce_place(base), b, name)),
        frame_rewrap(c1, ck_field_through(c1, term, coerce_place(base), b, name), ck_field_through_frame(c1, term, coerce_place(base), b, name)),
        tracked_rewrap(
          c1,
          ck_field_through(c1, term, coerce_place(base), b, name),
          ck_field_through_frame_tracked(c1, term, coerce_place(base), b, name)
        ),
        o_c1
      )
    )
    Some(cn) => inference_class_method_frame_tracked(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      cn,
      Ordmap::contains(inference_fns(c), cat3(cn, "::", name), Ordmap::compare_text),
      ih,
      ordered
    )
  }
}

pub theorem inference_use_ck_app_in_tracked(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_app_in(k, c, term, function, arguments, env)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih)))))))
        )
      )
    )
  )(c, term, function, arguments, env, ordered)
}

pub theorem inference_use_ck_lambda_in_tracked(
  k: Nat,
  c: Checker,
  lam: SurfaceTerm,
  r#borrows: List(Option(Bool)),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_lambda_in(k, c, lam, r#borrows, env)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, lam, r#borrows, env, ordered)
}

pub theorem ck_fits_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_fits(c, a, b)) {
  tracked_run_grows(c, ck_fits(c, a, b), And::left(ck_fits_ok(c, a, b)(ordered)))
}
pub theorem ck_fits_wide_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_fits_wide(c, a, b)) {
  tracked_run_grows(c, ck_fits_wide(c, a, b), And::left(ck_fits_wide_ok(c, a, b)(ordered)))
}
pub theorem run_expect_after_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  fits: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, run_expect_after(c, a, b, span, what, fits)) {
  match fits {
    true => tracked_run_return(c, Star, ordered)
    false => tracked_run_bind(
      <A: Option(CoerceFound), B: Unit>,
      c,
      (found: Option(CoerceFound), next: Checker) => run_expect_refused(next, a, b, span, what, found),
      ck_coerce_fit(c, a, b),
      tracked_run_grows(c, ck_coerce_fit(c, a, b), ck_coerce_fit_grows(c, a, b, ordered)),
      found => next => onext => tracked_run_read(
        next,
        run_expect_refused(next, a, b, span, what, found),
        frame_error_if_ok(next, coerce_refusal(next, a, b, what, found), span, coerce_refused(next, found)),
        frame_error_if_ok_tracked(next, coerce_refusal(next, a, b, what, found), span, coerce_refused(next, found)),
        onext
      )
    )
  }
}
pub theorem ck_expect_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  span: TySpan,
  what: Text,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_expect(c, a, b, span, what)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(run_expect_unf(c, a, b, span, what)),
    tracked_run_bind(
      <A: Bool, B: Unit>,
      c,
      (fits: Bool, next: Checker) => run_expect_after(next, a, b, span, what, fits),
      ck_fits_wide(c, a, b),
      ck_fits_wide_run_frame_tracked(c, a, b, ordered),
      fits => next => onext => run_expect_after_frame_tracked(next, a, b, span, what, fits, onext)
    )
  )
}

// The written types of a `match` keep what the checker tracks.

pub theorem leaf_match_type_frame_tracked(
  c: Checker,
  t: SurfaceTerm,
  named: Option(Text)
): TrackedFrame(c, leaf_match_type(c, t, named)) {
  match named {
    Some(n) => tracked_bind(
      <A: Unit, B: Option(Ty)>,
      c,
      (reported: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, match_depends_on_value_message(n), span_of(t)),
      ck_error_frame_tracked(c, match_depends_on_value_message(n), span_of(t)),
      reported => c1 => tracked_state_refl(c1)
    )
    None => tracked_bind(
      <A: Ty, B: Option(Ty)>,
      c,
      (w: Ty, c1: Checker) => mut1(Some(w), c1),
      ck_written(c, t, type_scope(ck_type_params_of(c))),
      ck_written_frame_tracked(c, t, type_scope(ck_type_params_of(c))),
      w => c1 => tracked_state_refl(c1)
    )
  }
}

pub theorem ck_match_type_frame_tracked(
  c: Checker,
  t: SurfaceTerm,
  env: List(Local)
): TrackedFrame(c, ck_match_type(c, t, env)) {
  Eq::subst(
    (z: Mut1(Option(Ty), Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_match_type_unf(c, t, env)),
    leaf_match_type_frame_tracked(c, t, type_local_named(t, env))
  )
}

pub theorem ck_match_type_opt_frame_tracked(
  c: Checker,
  t: Option(SurfaceTerm),
  env: List(Local)
): TrackedFrame(c, ck_match_type_opt(c, t, env)) {
  match t {
    None => tracked_state_refl(c)
    Some(w) => tracked_rewrap(
      c,
      ck_match_type(c, w, env),
      ck_match_type_frame_tracked(c, w, env)
    )
  }
}

pub theorem ck_arm_goals_frame_tracked(
  c: Checker,
  arms: List(SurfaceArm),
  env: List(Local)
): TrackedFrame(c, ck_arm_goals(c, arms, env)) {
  match arms {
    Nil => tracked_state_refl(c)
    Cons(arm, rest) => Eq::subst(
      (z: Mut1(List(Option(Ty)), Checker)) => TrackedFrame(c, z),
      Eq::sym(leaf_arm_goals_cons_unf(c, arm, rest, env)),
      tracked_bind(
        <A: Option(Ty), B: List(Option(Ty))>,
        c,
        (g: Option(Ty), c1: Checker) => frame_bind(
          <A: List(Option(Ty)), B: List(Option(Ty))>,
          (gs: List(Option(Ty)), c2: Checker) => mut1(Cons(g, gs), c2),
          ck_arm_goals(c1, rest, env)
        ),
        ck_match_type_opt(c, arm.goal, env),
        ck_match_type_opt_frame_tracked(c, arm.goal, env),
        g => c1 => tracked_bind(
          <A: List(Option(Ty)), B: List(Option(Ty))>,
          c1,
          (gs: List(Option(Ty)), c2: Checker) => mut1(Cons(g, gs), c2),
          ck_arm_goals(c1, rest, env),
          ck_arm_goals_frame_tracked(c1, rest, env),
          gs => c2 => tracked_state_refl(c2)
        )
      )
    )
  }
}

pub theorem leaf_goal_fit_run_frame_tracked(
  c: Checker,
  want: Option(Ty),
  head: Option(Ty),
  goal: Option(SurfaceTerm),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, leaf_goal_fit(c, want, head, goal)) {
  match want {
    None => tracked_run_return(c, (), ordered)
    Some(w) => ⊢ TrackedRunFrame(c, leaf_goal_fit(c, Some(w), head, goal)) from match head {
      None => tracked_run_return(c, (), ordered)
      Some(g) => ⊢ TrackedRunFrame(c, leaf_goal_fit(c, Some(w), Some(g), goal)) from match goal {
        None => tracked_run_return(c, (), ordered)
        Some(written) => tracked_run_rewrap(
          c,
          ck_expect(c, g, w, span_of(written), what_arm_goal_message()),
          ck_expect_run_frame_tracked(c, g, w, span_of(written), what_arm_goal_message(), ordered)
        )
      }
    }
  }
}

pub theorem ck_arm_goals_fit_run_frame_tracked(
  c: Checker,
  goals: List(Option(Ty)),
  arms: List(SurfaceArm),
  want: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_arm_goals_fit(c, goals, arms, want)) {
  match arms {
    Nil => tracked_run_return(c, (), ordered)
    Cons(arm, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
      Eq::sym(leaf_goals_fit_cons_unf(c, goals, arm, rest, want)),
      tracked_run_bind(
        <A: Unit, B: Unit>,
        c,
        (ignored: Unit, c1: Checker) => ck_rewrap1(ck_arm_goals_fit(c1, List::tail(goals), rest, want)),
        leaf_goal_fit(c, want, goal_head(goals), arm.goal),
        leaf_goal_fit_run_frame_tracked(c, want, goal_head(goals), arm.goal, ordered),
        ignored => c1 => o_c1 => tracked_run_rewrap(
          c1,
          ck_arm_goals_fit(c1, List::tail(goals), rest, want),
          ck_arm_goals_fit_run_frame_tracked(c1, List::tail(goals), rest, want, o_c1)
        )
      )
    )
  }
}

pub theorem leaf_body_fit_run_frame_tracked(
  c: Checker,
  head: Option(Ty),
  found: Option(Ty),
  body: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, leaf_body_fit(c, head, found, body)) {
  match head {
    None => tracked_run_return(c, (), ordered)
    Some(g) => ⊢ TrackedRunFrame(c, leaf_body_fit(c, Some(g), found, body)) from match found {
      None => tracked_run_return(c, (), ordered)
      Some(b) => tracked_run_rewrap(
        c,
        ck_expect(c, b, g, span_of(body), what_arm_body_message()),
        ck_expect_run_frame_tracked(c, b, g, span_of(body), what_arm_body_message(), ordered)
      )
    }
  }
}

pub theorem ck_arm_bodies_fit_run_frame_tracked(
  c: Checker,
  goals: List(Option(Ty)),
  arms: List(SurfaceArm),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_arm_bodies_fit(c, goals, arms)) {
  match arms {
    Nil => tracked_run_return(c, (), ordered)
    Cons(arm, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
      Eq::sym(leaf_bodies_fit_cons_unf(c, goals, arm, rest)),
      tracked_run_bind(
        <A: Unit, B: Unit>,
        c,
        (ignored: Unit, c1: Checker) => ck_rewrap1(ck_arm_bodies_fit(c1, List::tail(goals), rest)),
        leaf_body_fit(c, goal_head(goals), terms_find(c.terms, term_at_of(arm.body)), arm.body),
        leaf_body_fit_run_frame_tracked(
          c,
          goal_head(goals),
          terms_find(c.terms, term_at_of(arm.body)),
          arm.body,
          ordered
        ),
        ignored => c1 => o_c1 => tracked_run_rewrap(
          c1,
          ck_arm_bodies_fit(c1, List::tail(goals), rest),
          ck_arm_bodies_fit_run_frame_tracked(c1, List::tail(goals), rest, o_c1)
        )
      )
    )
  }
}

pub theorem ck_match_before_run_frame_tracked(
  c: Checker,
  motive: Option(SurfaceTerm),
  arms: List(SurfaceArm),
  env: List(Local),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_match_before(c, motive, arms, env)) {
  Eq::subst(
    (z: Mut1(Option(Ty) × List(Option(Ty)), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(leaf_match_before_unf(c, motive, arms, env)),
    tracked_run_bind(
      <A: Option(Ty), B: Option(Ty) × List(Option(Ty))>,
      c,
      (want: Option(Ty), c1: Checker) => frame_bind(
        <A: List(Option(Ty)), B: Option(Ty) × List(Option(Ty))>,
        (goals: List(Option(Ty)), c2: Checker) => frame_bind(
          <A: Unit, B: Option(Ty) × List(Option(Ty))>,
          (fitted: Unit, c3: Checker) => mut1(#(want, goals), c3),
          ck_arm_goals_fit(c2, goals, arms, want)
        ),
        ck_arm_goals(c1, arms, env)
      ),
      ck_match_type_opt(c, motive, env),
      tracked_run_read(
        c,
        ck_match_type_opt(c, motive, env),
        ck_match_type_opt_frame(c, motive, env),
        ck_match_type_opt_frame_tracked(c, motive, env),
        ordered
      ),
      want => c1 => o_c1 => tracked_run_bind(
        <A: List(Option(Ty)), B: Option(Ty) × List(Option(Ty))>,
        c1,
        (goals: List(Option(Ty)), c2: Checker) => frame_bind(
          <A: Unit, B: Option(Ty) × List(Option(Ty))>,
          (fitted: Unit, c3: Checker) => mut1(#(want, goals), c3),
          ck_arm_goals_fit(c2, goals, arms, want)
        ),
        ck_arm_goals(c1, arms, env),
        tracked_run_read(
          c1,
          ck_arm_goals(c1, arms, env),
          ck_arm_goals_frame(c1, arms, env),
          ck_arm_goals_frame_tracked(c1, arms, env),
          o_c1
        ),
        goals => c2 => o_c2 => tracked_run_bind(
          <A: Unit, B: Option(Ty) × List(Option(Ty))>,
          c2,
          (fitted: Unit, c3: Checker) => mut1(#(want, goals), c3),
          ck_arm_goals_fit(c2, goals, arms, want),
          ck_arm_goals_fit_run_frame_tracked(c2, goals, arms, want, o_c2),
          fitted => c3 => o_c3 => tracked_run_return(c3, #(want, goals), o_c3)
        )
      )
    )
  )
}

pub theorem leaf_match_answer_run_frame_tracked(
  c: Checker,
  fst: Option(Ty),
  got: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, leaf_match_answer(c, fst, got, span)) {
  match fst {
    None => tracked_run_return(c, got, ordered)
    Some(w) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(w, c1),
      ck_expect(c, got, w, span, what_match_result_message()),
      ck_expect_run_frame_tracked(c, got, w, span, what_match_result_message(), ordered),
      ignored => c1 => o_c1 => tracked_run_return(c1, w, o_c1)
    )
  }
}

pub theorem ck_match_after_run_frame_tracked(
  c: Checker,
  before: Option(Ty) × List(Option(Ty)),
  arms: List(SurfaceArm),
  got: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_match_after(c, before, arms, got, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(leaf_match_after_unf(c, before, arms, got, span)),
    tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => leaf_match_answer(c1, before.fst, got, span),
      ck_arm_bodies_fit(c, before.snd, arms),
      ck_arm_bodies_fit_run_frame_tracked(c, before.snd, arms, ordered),
      ignored => c1 => o_c1 => leaf_match_answer_run_frame_tracked(c1, before.fst, got, span, o_c1)
    )
  )
}

pub theorem inference_use_ck_else_in_tracked(
  k: Nat,
  c: Checker,
  t: Ty,
  el: Option(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_else_in(k, c, t, el, env)
) { And::left(And::right(And::right(ih)))(c, t, el, env, ordered) }

pub theorem inference_bind_scope_frame_tracked<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker, Scope) -> Mut1(B, Checker),
  m: Mut2(A, Checker, Scope),
  hm: TrackedScopeFrame(c, m),
  hk: ∀ v: A. ∀ next: Checker. ∀ env: Scope. ∀ ordered: CkOrdered(
    next
  ). TrackedRunFrame(next, k(v, next, env))
): TrackedRunFrame(c, inference_bind_scope(k, m)) {
  match m {
    mut2(v, next, env) => {
      let h: TrackedRunFrame(next, k(v, next, env)) := hk(v, next, env, And::left(hm))
      AndIntro(
        And::left(h),
        tracked_state_trans(c, next, ck_st(k(v, next, env)), And::right(hm), And::right(h))
      )
    }
  }
}
pub theorem inference_use_ck_block_in_tracked(
  k: Nat,
  c: Checker,
  stmts: List(SurfaceStmt),
  env: Scope,
  stopped: Bool,
  last: Ty,
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedScopeFrame(c, ck_block_in(k, c, stmts, env, stopped, last)) {
  And::left(
    And::right(
      And::right(And::right(And::right(And::right(And::right(And::right(And::right(ih)))))))
    )
  )(c, stmts, env, stopped, last, ordered)
}

pub theorem inference_use_ck_infer_each_in_tracked(
  k: Nat,
  c: Checker,
  ts: List(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_infer_each_in(k, c, ts, env)
) { And::left(And::right(And::right(And::right(ih))))(c, ts, env, ordered) }

pub theorem argument_terms_frame_tracked(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  p: Ty,
  more: List(Ty),
  args: List(SurfaceTerm),
  ih: ∀ next: Checker. ∀ ps: List(
    Ty
  ). ∀ args: List(
    SurfaceTerm
  ). ∀ ordered: CkOrdered(next). TrackedRunFrame(next, ck_expect_args(rest, next, ps, args)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_terms(a, rest, c, p, more, args)) {
  match args {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(at, atail) => tracked_run_bind(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_expect_args(rest, c1, more, atail)),
      ck_expect(c, a, p, span_of(at), what_argument_message()),
      ck_expect_run_frame_tracked(c, a, p, span_of(at), what_argument_message(), ordered),
      ignored => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_expect_args(rest, c1, more, atail),
        ih(c1, more, atail, o_c1)
      )
    )
  }
}

pub theorem argument_params_frame_tracked(
  a: Ty,
  rest: List(Ty),
  c: Checker,
  args: List(SurfaceTerm),
  ps: List(Ty),
  ih: ∀ next: Checker. ∀ ps: List(
    Ty
  ). ∀ args: List(
    SurfaceTerm
  ). ∀ ordered: CkOrdered(next). TrackedRunFrame(next, ck_expect_args(rest, next, ps, args)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_params(a, rest, c, args, ps)) {
  match ps {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(p, more) => argument_terms_frame_tracked(a, rest, c, p, more, args, ih, ordered)
  }
}

pub theorem ck_expect_args_run_frame_tracked(
  tys: List(Ty),
  c: Checker,
  ps: List(Ty),
  args: List(SurfaceTerm),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_expect_args(tys, c, ps, args)) {
  match tys {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(a, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
      Eq::sym(argument_cons_unf(a, rest, c, ps, args)),
      argument_params_frame_tracked(
        a,
        rest,
        c,
        args,
        ps,
        next => more => terms => onext => ck_expect_args_run_frame_tracked(
          rest,
          next,
          more,
          terms,
          onext
        ),
        ordered
      )
    )
  }
}

pub theorem application_effect_arity_frame_tracked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ps: List(Ty),
  bad: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_effect_arity(c, eff, types, args, span, ps, bad)) {
  match bad {
    true => tracked_run_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        ),
        ck_error_frame(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      tracked_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        ),
        ck_error_frame_tracked(
          c,
          cat5(
            "`",
            eff,
            "` takes ",
            Text::of_nat(list_len(ps)),
            cat2(" values, given ", Text::of_nat(list_len(types)))
          ),
          span
        )
      ),
      ordered
    )
    false => tracked_run_rewrap(
      c,
      ck_expect_args(types, c, ps, args),
      ck_expect_args_run_frame_tracked(types, c, ps, args, ordered)
    )
  }
}

pub theorem application_effect_inst_frame_tracked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  original: Ty,
  inst: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_effect_inst(c, eff, types, args, span, original, inst)) {
  ⊢ TrackedRunFrame(
    c,
    application_effect_inst(c, eff, types, args, span, original, inst)
  ) from match inst {
    TyInt(pat_w) => tracked_run_return(c, original, ordered)
    TyBool => tracked_run_return(c, original, ordered)
    TyText => tracked_run_return(c, original, ordered)
    TyUnit => tracked_run_return(c, original, ordered)
    TyNever => tracked_run_return(c, original, ordered)
    TyDecimal => tracked_run_return(c, original, ordered)
    TyFloat => tracked_run_return(c, original, ordered)
    TyFloat32 => tracked_run_return(c, original, ordered)
    TyFn(ps, r, fk) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(r, c1),
      application_effect_arity(
        c,
        eff,
        types,
        args,
        span,
        ps,
        not(Nat::eq(list_len(ps), list_len(types)))
      ),
      application_effect_arity_frame_tracked(
        c,
        eff,
        types,
        args,
        span,
        ps,
        not(Nat::eq(list_len(ps), list_len(types))),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, r, o_c1)
    )
    TyUnion(pat_members) => tracked_run_return(c, original, ordered)
    TyProduct(pat_members) => tracked_run_return(c, original, ordered)
    TyTagged(pat_tags, pat_inner) => tracked_run_return(c, original, ordered)
    TyNamed(pat_name, pat_args) => tracked_run_return(c, original, ordered)
    TyParam(pat_name, pat_bound) => tracked_run_return(c, original, ordered)
    TyInfo(pat_inner) => tracked_run_return(c, original, ordered)
    TyBorrow(pat_inner, pat_mutable) => tracked_run_return(c, original, ordered)
    TyVar(pat_v) => tracked_run_return(c, original, ordered)
    TyPoly(pat_generics, pat_inner) => tracked_run_return(c, original, ordered)
    TyApp(pat_head, pat_arg) => tracked_run_return(c, original, ordered)
  }
}

pub theorem application_effect_found_frame_tracked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  found: Option(EffectSig),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, application_effect_found(c, eff, types, args, span, found)) {
  match found {
    None => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, no_effect_declared_message(eff), span),
      tracked_run_read(
        c,
        ck_error(c, no_effect_declared_message(eff), span),
        ck_error_frame(c, no_effect_declared_message(eff), span),
        ck_error_frame_tracked(c, no_effect_declared_message(eff), span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    Some(sig) => tracked_run_bind(
      <A: Ty, B: Ty>,
      c,
      (inst: Ty, c1: Checker) => application_effect_inst(c1, eff, types, args, span, inst, inst),
      ck_instantiate_kinded(c, handle_effect_kinded(sig), span, handle_effect_type(sig)),
      tracked_run_read(
        c,
        ck_instantiate_kinded(c, handle_effect_kinded(sig), span, handle_effect_type(sig)),
        ck_instantiate_kinded_frame(c, handle_effect_kinded(sig), span, handle_effect_type(sig)),
        ck_instantiate_kinded_frame_tracked(c, handle_effect_kinded(sig), span, handle_effect_type(sig)),
        ordered
      ),
      inst => c1 => o_c1 => application_effect_inst_frame_tracked(
        c1,
        eff,
        types,
        args,
        span,
        inst,
        inst,
        o_c1
      )
    )
  }
}

pub theorem ck_perform_of_run_frame_tracked(
  c: Checker,
  eff: Text,
  types: List(Ty),
  args: List(SurfaceTerm),
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_perform_of(c, eff, types, args, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(application_effect_unf(c, eff, types, args, span)),
    application_effect_found_frame_tracked(
      c,
      eff,
      types,
      args,
      span,
      Ordmap::get(handle_effects(c), eff, Ordmap::compare_text),
      ordered
    )
  )
}

pub theorem inference_use_ck_handle_in_tracked(
  k: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_handle_in(k, c, body, handlers, env)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(
                            And::right(
                              And::right(
                                And::right(And::right(And::right(And::right(And::right(ih)))))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, body, handlers, env, ordered)
}

pub theorem ck_unify_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_unify(c, a, b)) {
  tracked_run_grows(c, ck_unify(c, a, b), And::left(ck_unify_ok(c, a, b)(ordered)))
}
pub theorem argument_budget_after_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_budget_after(c, t, span, same)) {
  tracked_run_read(
    c,
    frame_error_if(
      c,
      budget_arms_differ_message(),
      span,
      not(same)
    ),
    frame_error_if_ok(
      c,
      budget_arms_differ_message(),
      span,
      not(same)
    ),
    frame_error_if_ok_tracked(
      c,
      budget_arms_differ_message(),
      span,
      not(same)
    ),
    ordered
  )
}

pub theorem argument_budget_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  exceeded: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, argument_budget(c, t, span, exceeded)) {
  match exceeded {
    Nil => tracked_run_return(c, Star, ordered)
    Cons(x, rest) => tracked_run_bind(
      <A: Bool, B: Unit>,
      c,
      (same: Bool, c1: Checker) => argument_budget_after(c1, t, span, same),
      ck_unify(c, x, t),
      ck_unify_run_frame_tracked(c, x, t, ordered),
      same => c1 => o_c1 => argument_budget_after_frame_tracked(c1, t, span, same, o_c1)
    )
  }
}

pub theorem ck_budget_answer_run_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_budget_answer(c, t, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(argument_budget_unf(c, t, span)),
    argument_budget_frame_tracked(c, t, span, argument_exceeded(c), ordered)
  )
}
pub theorem inference_use_ck_match_expr_in_tracked(
  k: Nat,
  c: Checker,
  scrutinee: SurfaceTerm,
  arms: List(SurfaceArm),
  env: List(Local),
  span: TySpan,
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_match_expr_in(k, c, scrutinee, arms, env, span)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(
                          And::right(
                            And::right(
                              And::right(And::right(And::right(And::right(And::right(ih)))))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, scrutinee, arms, env, span, ordered)
}

pub theorem inference_use_ck_record_in_tracked(
  k: Nat,
  c: Checker,
  name: Text,
  fields: List(SurfaceField),
  env: List(Local),
  span: TySpan,
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(c, ck_record_in(k, c, name, fields, env, span)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(
                      And::right(
                        And::right(And::right(And::right(And::right(And::right(And::right(ih))))))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, name, fields, env, span, ordered)
}

pub theorem inference_term_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  span: TySpan,
  sk: SurfaceKind,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_term(j, c, term, env, span, sk)) {
  match sk {
    SkVar(name) => tracked_run_read(
      c,
      ck_rewrap1(ck_lookup(c, surface_name_text(name), env, span, term.occurrence)),
      frame_rewrap(c, ck_lookup(c, surface_name_text(name), env, span, term.occurrence), ck_lookup_frame(c, surface_name_text(name), env, span, term.occurrence)),
      tracked_rewrap(c, ck_lookup(c, surface_name_text(name), env, span, term.occurrence), ck_lookup_frame_tracked(c, surface_name_text(name), env, span, term.occurrence)),
      ordered
    )
    SkNat(n) => tracked_run_read(
      c,
      ck_rewrap1(ck_nat_literal(c, n, span)),
      frame_rewrap(c, ck_nat_literal(c, n, span), ck_nat_literal_frame(c, n, span)),
      tracked_rewrap(c, ck_nat_literal(c, n, span), ck_nat_literal_frame_tracked(c, n, span)),
      ordered
    )
    SkText(s) => tracked_run_return(c, TyText, ordered)
    SkBool(b) => tracked_run_return(c, TyBool, ordered)
    SkApp(function, arguments) => tracked_run_rewrap(
      c,
      ck_app_in(j, c, term, function, arguments, env),
      inference_use_ck_app_in_tracked(j, c, term, function, arguments, env, ordered, ih)
    )
    SkPi(pat_params, pat_result, pat_effects) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkExists(pat_binder, pat_domain, pat_body, unused) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkLam(params, body, _, _) => tracked_run_rewrap(
      c,
      ck_lambda_in(j, c, term, Nil, env),
      inference_use_ck_lambda_in_tracked(j, c, term, Nil, env, ordered, ih)
    )
    SkUnion(pat_parts) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkTagged(tag, x) => tracked_run_bind(
      <A: Ty, B: Ty>,
      c,
      (t: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), c1),
      ck_infer_in(j, c, x, env),
      inference_use_ck_infer_in_tracked(j, c, x, env, ordered, ih),
      t => c1 => o_c1 => tracked_run_return(c1, ty_tagged(Cons(tag, Nil), ck_resolve(c1, t)), o_c1)
    )
    SkIf(condition, th, el) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (cleared: Unit, c1: Checker) => frame_bind(
        <A: Ty, B: Ty>,
        (ct: Ty, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c)))
          ),
          ck_expect(c2, ct, TyBool, span_of(condition), what_if_condition_message())
        ),
        ck_infer_in(j, c1, condition, env)
      ),
      inference_set_result_hint(c, None),
      tracked_run_read(
        c,
        inference_set_result_hint(c, None),
        inference_set_result_hint_frame(c, None),
        inference_set_result_hint_frame_tracked(c, None),
        ordered
      ),
      cleared => c1 => o_c1 => tracked_run_bind(
        <A: Ty, B: Ty>,
        c1,
        (ct: Ty, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (checked: Unit, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c)))
          ),
          ck_expect(c2, ct, TyBool, span_of(condition), what_if_condition_message())
        ),
        ck_infer_in(j, c1, condition, env),
        inference_use_ck_infer_in_tracked(j, c1, condition, env, o_c1, ih),
        ct => c2 => o_c2 => tracked_run_bind(
          <A: Unit, B: Ty>,
          c2,
          (checked: Unit, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c)))
          ),
          ck_expect(c2, ct, TyBool, span_of(condition), what_if_condition_message()),
          ck_expect_run_frame_tracked(c2, ct, TyBool, span_of(condition), what_if_condition_message(), o_c2),
          checked => c3 => o_c3 => tracked_run_bind(
            <A: Unit, B: Ty>,
            c3,
            (set1: Unit, c4: Checker) => frame_bind(
              <A: Ty, B: Ty>,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env)
            ),
            inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c))),
            tracked_run_read(
              c3,
              inference_set_result_hint(c3, ck_result_hint_for(th, inference_result_hint(c))),
              inference_set_result_hint_frame(c3, ck_result_hint_for(th, inference_result_hint(c))),
              inference_set_result_hint_frame_tracked(c3, ck_result_hint_for(th, inference_result_hint(c))),
              o_c3
            ),
            set1 => c4 => o_c4 => tracked_run_bind(
              <A: Ty, B: Ty>,
              c4,
              (t: Ty, c5: Checker) => frame_bind(
                <A: Unit, B: Ty>,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c)))
              ),
              ck_infer_in(j, c4, th, env),
              inference_use_ck_infer_in_tracked(j, c4, th, env, o_c4, ih),
              t => c5 => o_c5 => tracked_run_bind(
                <A: Unit, B: Ty>,
                c5,
                (set2: Unit, c6: Checker) => ck_rewrap1(ck_else_in(j, c6, t, el, env)),
                inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c))),
                tracked_run_read(
                  c5,
                  inference_set_result_hint(c5, ck_else_hint(el, inference_result_hint(c))),
                  inference_set_result_hint_frame(c5, ck_else_hint(el, inference_result_hint(c))),
                  inference_set_result_hint_frame_tracked(c5, ck_else_hint(el, inference_result_hint(c))),
                  o_c5
                ),
                set2 => c6 => o_c6 => tracked_run_rewrap(
                  c6,
                  ck_else_in(j, c6, t, el, env),
                  inference_use_ck_else_in_tracked(j, c6, t, el, env, o_c6, ih)
                )
              )
            )
          )
        )
      )
    )
    SkField(base, name) => inference_field_base_frame_tracked(
      j,
      c,
      term,
      env,
      span,
      base,
      name,
      class_of_base(c, base, env),
      ih,
      ordered
    )
    SkBlock(stmts) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (armed: Unit, c1: Checker) => inference_bind_scope(
        <A: Ty, B: Ty>,
        (t: Ty, c2: Checker, inner: Scope) => frame_bind(
          <A: Unit, B: Ty>,
          (restored: Unit, c3: Checker) => mut1(t, c3),
          inference_set_arm_hint(c2, inference_arm_hint(c))
        ),
        ck_block_in(j, c1, stmts, ScopeMk(env), false, TyUnit)
      ),
      inference_set_arm_hint(c, inference_result_hint(c)),
      tracked_run_read(
        c,
        inference_set_arm_hint(c, inference_result_hint(c)),
        inference_set_arm_hint_frame(c, inference_result_hint(c)),
        inference_set_arm_hint_frame_tracked(c, inference_result_hint(c)),
        ordered
      ),
      armed => c1 => o_c1 => inference_bind_scope_frame_tracked(
        <A: Ty, B: Ty>,
        c1,
        (t: Ty, c2: Checker, inner: Scope) => frame_bind(
          <A: Unit, B: Ty>,
          (restored: Unit, c3: Checker) => mut1(t, c3),
          inference_set_arm_hint(c2, inference_arm_hint(c))
        ),
        ck_block_in(j, c1, stmts, ScopeMk(env), false, TyUnit),
        inference_use_ck_block_in_tracked(j, c1, stmts, ScopeMk(env), false, TyUnit, o_c1, ih),
        t => c2 => inner => o_c2 => tracked_run_bind(
          <A: Unit, B: Ty>,
          c2,
          (restored: Unit, c3: Checker) => mut1(t, c3),
          inference_set_arm_hint(c2, inference_arm_hint(c)),
          tracked_run_read(
            c2,
            inference_set_arm_hint(c2, inference_arm_hint(c)),
            inference_set_arm_hint_frame(c2, inference_arm_hint(c)),
            inference_set_arm_hint_frame_tracked(c2, inference_arm_hint(c)),
            o_c2
          ),
          restored => c3 => o_c3 => tracked_run_return(c3, t, o_c3)
        )
      )
    )
    SkPerform(eff, args) => tracked_run_bind(
      <A: List(Ty), B: Ty>,
      c,
      (types: List(Ty), c1: Checker) => ck_rewrap1(ck_perform_of(c1, eff, types, args, span)),
      ck_infer_each_in(j, c, args, env),
      inference_use_ck_infer_each_in_tracked(j, c, args, env, ordered, ih),
      types => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_perform_of(c1, eff, types, args, span),
        ck_perform_of_run_frame_tracked(c1, eff, types, args, span, o_c1)
      )
    )
    SkHandle(body, handlers) => tracked_run_rewrap(
      c,
      ck_handle_in(j, c, body, handlers, env),
      inference_use_ck_handle_in_tracked(j, c, body, handlers, env, ordered, ih)
    )
    SkBudget(steps_memory, steps, body) => tracked_run_bind(
      <A: Ty, B: Ty>,
      c,
      (s: Ty, c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (checked: Unit, c2: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (t: Ty, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env)
        ),
        ck_expect(c1, s, TyInt(WidthU64), span_of(steps), what_budget_steps_message())
      ),
      ck_infer_in(j, c, steps, env),
      inference_use_ck_infer_in_tracked(j, c, steps, env, ordered, ih),
      s => c1 => o_c1 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c1,
        (checked: Unit, c2: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (t: Ty, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env)
        ),
        ck_expect(c1, s, TyInt(WidthU64), span_of(steps), what_budget_steps_message()),
        ck_expect_run_frame_tracked(
          c1,
          s,
          TyInt(WidthU64),
          span_of(steps),
          what_budget_steps_message(),
          o_c1
        ),
        checked => c2 => o_c2 => tracked_run_bind(
          <A: Ty, B: Ty>,
          c2,
          (t: Ty, c3: Checker) => frame_bind(
            <A: Unit, B: Ty>,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span)
          ),
          ck_infer_in(j, c2, body, env),
          inference_use_ck_infer_in_tracked(j, c2, body, env, o_c2, ih),
          t => c3 => o_c3 => tracked_run_bind(
            <A: Unit, B: Ty>,
            c3,
            (answered: Unit, c4: Checker) => mut1(t, c4),
            ck_budget_answer(c3, t, span),
            ck_budget_answer_run_frame_tracked(c3, t, span, o_c3),
            answered => c4 => o_c4 => tracked_run_return(c4, t, o_c4)
          )
        )
      )
    )
    SkMatch(scrutinee, motive, arms, binder, _) => tracked_run_bind(
      <A: Option(Ty) × List(Option(Ty)), B: Ty>,
      c,
      (before: Option(Ty) × List(Option(Ty)), c1: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (armed: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (cleared: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span)
          ),
          inference_set_result_hint(c2, None)
        ),
        inference_set_arm_hint(c1, ck_hint_or_before(before, inference_result_hint(c)))
      ),
      ck_match_before(c, motive, arms, env),
      ck_match_before_run_frame_tracked(c, motive, arms, env, ordered),
      before => c1 => o_c1 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c1,
        (armed: Unit, c2: Checker) => frame_bind(
          <A: Unit, B: Ty>,
          (cleared: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span)
          ),
          inference_set_result_hint(c2, None)
        ),
        inference_set_arm_hint(c1, ck_hint_or_before(before, inference_result_hint(c))),
        tracked_run_read(
          c1,
          inference_set_arm_hint(c1, ck_hint_or_before(before, inference_result_hint(c))),
          inference_set_arm_hint_frame(c1, ck_hint_or_before(before, inference_result_hint(c))),
          inference_set_arm_hint_frame_tracked(c1, ck_hint_or_before(before, inference_result_hint(c))),
          o_c1
        ),
        armed => c2 => o_c2 => tracked_run_bind(
          <A: Unit, B: Ty>,
          c2,
          (cleared: Unit, c3: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span)
          ),
          inference_set_result_hint(c2, None),
          tracked_run_read(
            c2,
            inference_set_result_hint(c2, None),
            inference_set_result_hint_frame(c2, None),
            inference_set_result_hint_frame_tracked(c2, None),
            o_c2
          ),
          cleared => c3 => o_c3 => tracked_run_bind(
            <A: Ty, B: Ty>,
            c3,
            (got: Ty, c4: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c))
            ),
            ck_match_expr_in(j, c3, scrutinee, arms, env, span),
            inference_use_ck_match_expr_in_tracked(j, c3, scrutinee, arms, env, span, o_c3, ih),
            got => c4 => o_c4 => tracked_run_bind(
              <A: Unit, B: Ty>,
              c4,
              (restored: Unit, c5: Checker) => ck_rewrap1(ck_match_after(c5, before, arms, got, span)),
              inference_set_arm_hint(c4, inference_arm_hint(c)),
              tracked_run_read(
                c4,
                inference_set_arm_hint(c4, inference_arm_hint(c)),
                inference_set_arm_hint_frame(c4, inference_arm_hint(c)),
                inference_set_arm_hint_frame_tracked(c4, inference_arm_hint(c)),
                o_c4
              ),
              restored => c5 => o_c5 => tracked_run_rewrap(
                c5,
                ck_match_after(c5, before, arms, got, span),
                ck_match_after_run_frame_tracked(c5, before, arms, got, span, o_c5)
              )
            )
          )
        )
      )
    )
    SkHole(pat_name) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkRecord(name, fields) => tracked_run_rewrap(
      c,
      ck_record_in(j, c, name, fields, env, span),
      inference_use_ck_record_in_tracked(j, c, name, fields, env, span, ordered, ih)
    )
    SkBorrow(mutable, mutable_orig, inner) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (checked: Unit, c1: Checker) => frame_bind(
        <A: Ty, B: Ty>,
        (t: Ty, c2: Checker) => mut1(ck_borrow_of(c2, t, mutable), c2),
        ck_infer_in(j, c1, inner, env)
      ),
      ck_check_lend(c, mutable, inner, env, span),
      tracked_run_read(
        c,
        ck_check_lend(c, mutable, inner, env, span),
        ck_check_lend_frame(c, mutable, inner, env, span),
        ck_check_lend_frame_tracked(c, mutable, inner, env, span),
        ordered
      ),
      checked => c1 => o_c1 => tracked_run_bind(
        <A: Ty, B: Ty>,
        c1,
        (t: Ty, c2: Checker) => mut1(ck_borrow_of(c2, t, mutable), c2),
        ck_infer_in(j, c1, inner, env),
        inference_use_ck_infer_in_tracked(j, c1, inner, env, o_c1, ih),
        t => c2 => o_c2 => tracked_run_return(c2, ck_borrow_of(c2, t, mutable), o_c2)
      )
    )
    SkFnKind(pat_kind, pat_ty) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkBorrowLam(r#borrows, lam) => tracked_run_rewrap(
      c,
      ck_lambda_in(j, c, lam, r#borrows, env),
      inference_use_ck_lambda_in_tracked(j, c, lam, r#borrows, env, ordered, ih)
    )
    SkOther(pat_what) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkAscribe(pat_what, pat_what_ty) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkRow(pat_what_effects) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
    SkFloat(pat_what) => tracked_run_read(
      c,
      ck_rewrap1(ck_float_literal(c, pat_what, span)),
      frame_rewrap(c, ck_float_literal(c, pat_what, span), ck_float_literal_frame(c, pat_what, span)),
      tracked_rewrap(c, ck_float_literal(c, pat_what, span), ck_float_literal_frame_tracked(c, pat_what, span)),
      ordered
    )
    SkMacroCall(pat_name, pat_arg) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkQuote(pat_stmts_form, pat_stmts) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkSplice(pat_value) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkSyntaxLit(pat_name, pat_body) => tracked_run_read(
      c,
      ck_rewrap1(ck_fresh(c)),
      frame_rewrap(c, ck_fresh(c), ck_fresh_frame(c)),
      tracked_rewrap(c, ck_fresh(c), ck_fresh_frame_tracked(c)),
      ordered
    )
    SkStep(pat_tactic, pat_arg, pat_call_start, pat_call_end, pat_before, pat_arms) => tracked_run_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_rewrap1(
        ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
      ),
      tracked_run_read(
        c,
        ck_rewrap1(
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        frame_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, not_supported_yet_message(sk_name(inference_term_kind(term))), span),
          ck_error_frame_tracked(
            c,
            not_supported_yet_message(sk_name(inference_term_kind(term))),
            span
          )
        ),
        ordered
      ),
      reported => c1 => o_c1 => tracked_run_read(
        c1,
        ck_rewrap1(ck_fresh(c1)),
        frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1)),
        tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1)),
        o_c1
      )
    )
  }
}

pub theorem inference_step_ck_infer_term_in_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_step_ck_infer_term_in(j, c, term, env)) {
  inference_term_frame_tracked(
    j,
    c,
    term,
    env,
    span_of(term),
    inference_term_kind(term),
    ih,
    ordered
  )
}

pub theorem pattern_return_frame_tracked<A: Type>(
  c: Checker,
  env: Scope,
  v: A,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, mut2(v, c, env)) {
  AndIntro(ordered, AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))))
}
pub theorem pattern_rewrap_frame_tracked<A: Type>(
  c: Checker,
  m: Mut2(A, Checker, Scope),
  h: TrackedScopeFrame(c, m)
): TrackedScopeFrame(c, pattern_rewrap(m)) {
  Eq::subst(
    (z: Mut2(A, Checker, Scope)) => TrackedScopeFrame(c, z),
    Eq::sym(pattern_rewrap_id(m)),
    h
  )
}
pub def PatternIH_pattern_tracked(
  k: Nat
): Prop := ∀ c: Checker. ∀ p: SurfacePattern. ∀ t: Ty. ∀ env: Scope. ∀ span: TySpan. ∀ at: Nat. ∀ ordered: CkOrdered(
  c
). TrackedScopeFrame(c, ck_pattern_in(k, c, p, t, env, span, at))

pub def PatternIH_ctor_pattern_tracked(
  k: Nat
): Prop := ∀ c: Checker. ∀ name: Text. ∀ args: List(
  SurfacePattern
). ∀ t: Ty. ∀ env: Scope. ∀ span: TySpan. ∀ at: Nat. ∀ ordered: CkOrdered(
  c
). TrackedScopeFrame(c, ck_ctor_pattern_in(k, c, name, args, t, env, span, at))

pub def PatternIH_ctor_args_tracked(
  k: Nat
): Prop := ∀ c: Checker. ∀ args: List(
  SurfacePattern
). ∀ fields: List(
  DataField
). ∀ borrowed: Option(
  Bool
). ∀ env: Scope. ∀ span: TySpan. ∀ at: Nat. ∀ ordered: CkOrdered(
  c
). TrackedScopeFrame(c, ck_ctor_args_in(k, c, args, fields, borrowed, env, span, at))

pub def PatternAll_tracked(
  k: Nat
): Prop := And(
  PatternIH_pattern_tracked(k),
  And(PatternIH_ctor_pattern_tracked(k), PatternIH_ctor_args_tracked(k))
)
pub theorem ck_bind_local_scope_frame_tracked(
  c: Checker,
  env: Scope,
  name: Text,
  ty: Ty,
  mutable: Bool,
  site: Nat,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, ck_bind_local(c, env, name, ty, mutable, site)) {
  AndIntro(ordered, AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))))
}

pub theorem pattern_bind_name_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  name: Text,
  nullary: Bool,
  ih_ctor_pattern: PatternIH_ctor_pattern_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_bind_name(j, c, t, env, span, at, name, nullary)) {
  match nullary {
    true => pattern_rewrap_frame_tracked(
      c,
      ck_ctor_pattern_in(j, c, name, Nil, t, env, span, at),
      ih_ctor_pattern(c, name, Nil, t, env, span, at, ordered)
    )
    false => pattern_rewrap_frame_tracked(
      c,
      ck_bind_local(c, env, name, t, false, at),
      ck_bind_local_scope_frame_tracked(c, env, name, t, false, at, ordered)
    )
  }
}

pub theorem pattern_bind_one_frame_tracked<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut2(B, Checker, Scope),
  m: Mut1(A, Checker),
  hm: TrackedRunFrame(c, m),
  hk: ∀ v: A. ∀ next: Checker. ∀ ordered: CkOrdered(next). TrackedScopeFrame(next, k(v, next))
): TrackedScopeFrame(c, pattern_bind_one(k, m)) {
  match m {
    mut1(v, next) => {
      let h: TrackedScopeFrame(next, k(v, next)) := hk(v, next, And::left(hm))
      AndIntro(
        And::left(h),
        tracked_state_trans(
          c,
          next,
          ck_st(pattern_checker(k(v, next))),
          And::right(hm),
          And::right(h)
        )
      )
    }
  }
}
pub theorem pattern_lift_frame_tracked<A: Type>(
  c: Checker,
  env: Scope,
  m: Mut1(A, Checker),
  h: TrackedRunFrame(c, m)
): TrackedScopeFrame(c, pattern_lift(env, m)) {
  match m { mut1(v, next) => h }
}
pub theorem pattern_literal_after_frame_tracked(
  c: Checker,
  l: Ty,
  target: Ty,
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_literal_after(c, l, target, span, same)) {
  tracked_run_read(
    c,
    frame_error_if(
      c,
      pattern_cannot_match_message(ty_show(ck_resolve(c, l)), ty_show(ck_resolve(c, target))),
      span,
      not(same)
    ),
    frame_error_if_ok(
      c,
      pattern_cannot_match_message(ty_show(ck_resolve(c, l)), ty_show(ck_resolve(c, target))),
      span,
      not(same)
    ),
    frame_error_if_ok_tracked(
      c,
      pattern_cannot_match_message(ty_show(ck_resolve(c, l)), ty_show(ck_resolve(c, target))),
      span,
      not(same)
    ),
    ordered
  )
}

pub theorem pattern_literal_frame_tracked(
  c: Checker,
  l: Ty,
  target: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_literal(c, l, target, span)) {
  tracked_run_bind(
    <A: Bool, B: Unit>,
    c,
    (same: Bool, c1: Checker) => pattern_literal_after(c1, l, target, span, same),
    ck_unify(c, l, target),
    ck_unify_run_frame_tracked(c, l, target, ordered),
    same => c1 => o_c1 => pattern_literal_after_frame_tracked(c1, l, target, span, same, o_c1)
  )
}

pub theorem ck_pattern_literal_run_frame_tracked(
  c: Checker,
  l: Ty,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_pattern_literal(c, l, t, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(pattern_literal_unf(c, l, t, span)),
    pattern_literal_frame_tracked(c, l, ty_unborrowed(ck_resolve(c, t)), span, ordered)
  )
}

pub theorem pattern_record_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  name: Text,
  pos: Positional,
  ih_ctor_pattern: PatternIH_ctor_pattern_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_record(j, c, t, env, span, at, name, pos)) {
  match pos {
    PositionalOk(args) => pattern_rewrap_frame_tracked(
      c,
      ck_ctor_pattern_in(j, c, name, args, t, env, span, at),
      ih_ctor_pattern(c, name, args, t, env, span, at, ordered)
    )
    PositionalErr(e) => pattern_lift_frame_tracked(
      c,
      env,
      ck_rewrap1(ck_error(c, e, span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, e, span)),
        frame_rewrap(c, ck_error(c, e, span), ck_error_frame(c, e, span)),
        tracked_rewrap(c, ck_error(c, e, span), ck_error_frame_tracked(c, e, span)),
        ordered
      )
    )
  }
}

pub theorem pattern_step_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  p: SurfacePattern,
  ih_ctor_pattern: PatternIH_ctor_pattern_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_step(j, c, t, env, span, at, p)) {
  match p {
    PtWild => pattern_return_frame_tracked(c, env, Star, ordered)
    PtBind(name, _) => pattern_bind_name_frame_tracked(
      j,
      c,
      t,
      env,
      span,
      at,
      name,
      datas_nullary_expected(ck_datas_of(c), name, ck_resolve(c, t)),
      ih_ctor_pattern,
      ordered
    )
    PtInt(negative, magnitude) => pattern_bind_one_frame_tracked(
      <A: Ty, B: Unit>,
      c,
      (i: Ty, c1: Checker) => pattern_bind_one(
        <A: Unit, B: Unit>,
        (ignored: Unit, c2: Checker) => pattern_lift(env, ck_pattern_literal(c2, i, t, span)),
        pattern_literal_record(c1, negative, magnitude, i, span)
      ),
      ck_fresh_int(c),
      tracked_run_read(
        c,
        ck_fresh_int(c),
        ck_fresh_int_read_frame(c),
        ck_fresh_int_read_frame_tracked(c),
        ordered
      ),
      i => c1 => o_c1 => pattern_bind_one_frame_tracked(
        <A: Unit, B: Unit>,
        c1,
        (ignored: Unit, c2: Checker) => pattern_lift(env, ck_pattern_literal(c2, i, t, span)),
        pattern_literal_record(c1, negative, magnitude, i, span),
        tracked_run_read(
          c1,
          pattern_literal_record(c1, negative, magnitude, i, span),
          pattern_literal_record_frame(c1, negative, magnitude, i, span),
          pattern_literal_record_frame_tracked(c1, negative, magnitude, i, span),
          o_c1
        ),
        ignored => c2 => o_c2 => pattern_lift_frame_tracked(
          c2,
          env,
          ck_pattern_literal(c2, i, t, span),
          ck_pattern_literal_run_frame_tracked(c2, i, t, span, o_c2)
        )
      )
    )
    PtBool(b) => pattern_lift_frame_tracked(
      c,
      env,
      ck_pattern_literal(c, TyBool, t, span),
      ck_pattern_literal_run_frame_tracked(c, TyBool, t, span, ordered)
    )
    PtText(s) => pattern_lift_frame_tracked(
      c,
      env,
      ck_pattern_literal(c, TyText, t, span),
      ck_pattern_literal_run_frame_tracked(c, TyText, t, span, ordered)
    )
    PtCtor(name, args) => pattern_rewrap_frame_tracked(
      c,
      ck_ctor_pattern_in(j, c, surface_name_text(name), args, t, env, span, at),
      ih_ctor_pattern(c, surface_name_text(name), args, t, env, span, at, ordered)
    )
    PtRecord(name, fields) => pattern_record_frame_tracked(
      j,
      c,
      t,
      env,
      span,
      at,
      name,
      datas_positional_expected(ck_datas_of(c), name, fields, ck_resolve(c, t)),
      ih_ctor_pattern,
      ordered
    )
    PtOther(what) => pattern_lift_frame_tracked(
      c,
      env,
      ck_rewrap1(ck_error(c, pattern_not_supported_message(what), span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, pattern_not_supported_message(what), span)),
        frame_rewrap(
          c,
          ck_error(c, pattern_not_supported_message(what), span),
          ck_error_frame(c, pattern_not_supported_message(what), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, pattern_not_supported_message(what), span),
          ck_error_frame_tracked(c, pattern_not_supported_message(what), span)
        ),
        ordered
      )
    )
    PtTyped(name, ty, _) => pattern_lift_frame_tracked(
      c,
      env,
      ck_rewrap1(ck_error(c, pattern_not_supported_message("a typed arm"), span)),
      tracked_run_read(
        c,
        ck_rewrap1(ck_error(c, pattern_not_supported_message("a typed arm"), span)),
        frame_rewrap(
          c,
          ck_error(c, pattern_not_supported_message("a typed arm"), span),
          ck_error_frame(c, pattern_not_supported_message("a typed arm"), span)
        ),
        tracked_rewrap(
          c,
          ck_error(c, pattern_not_supported_message("a typed arm"), span),
          ck_error_frame_tracked(c, pattern_not_supported_message("a typed arm"), span)
        ),
        ordered
      )
    )
  }
}

pub theorem pattern_ctor_arity_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  fields: List(DataField),
  span: TySpan,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_arity(c, name, args, fields, span, same)) {
  match same {
    false => tracked_run_return(c, Some(fields), ordered)
    true => tracked_run_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(
        c,
        pattern_field_count_message(name, Text::of_nat(list_len(fields)), Text::of_nat(list_len(args))),
        span
      ),
      tracked_run_read(
        c,
        ck_error(
          c,
          pattern_field_count_message(name, Text::of_nat(list_len(fields)), Text::of_nat(list_len(args))),
          span
        ),
        ck_error_frame(
          c,
          pattern_field_count_message(name, Text::of_nat(list_len(fields)), Text::of_nat(list_len(args))),
          span
        ),
        ck_error_frame_tracked(
          c,
          pattern_field_count_message(name, Text::of_nat(list_len(fields)), Text::of_nat(list_len(args))),
          span
        ),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, None, o_c1)
    )
  }
}

pub theorem pattern_ctor_same_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  dc: Text × Nat,
  targs: List(Ty),
  target: Ty,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_same(c, name, args, t, span, dc, targs, target, same)) {
  ⊢ TrackedRunFrame(
    c,
    pattern_ctor_same(c, name, args, t, span, dc, targs, target, same)
  ) from match same {
    false => pattern_ctor_arity_frame_tracked(
      c,
      name,
      args,
      datas_fields(ck_datas_of(c), pattern_ctor_name(dc), pattern_ctor_index(dc), targs),
      span,
      not(
        Nat::eq(
          list_len(
            datas_fields(ck_datas_of(c), pattern_ctor_name(dc), pattern_ctor_index(dc), targs)
          ),
          list_len(args)
        )
      ),
      ordered
    )
    true => tracked_run_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(
        c,
        pattern_cannot_match_message(pattern_ctor_name(dc), ty_show(ck_shown(c, target))),
        span
      ),
      tracked_run_read(
        c,
        ck_error(
          c,
          pattern_cannot_match_message(pattern_ctor_name(dc), ty_show(ck_shown(c, target))),
          span
        ),
        ck_error_frame(
          c,
          pattern_cannot_match_message(pattern_ctor_name(dc), ty_show(ck_shown(c, target))),
          span
        ),
        ck_error_frame_tracked(
          c,
          pattern_cannot_match_message(pattern_ctor_name(dc), ty_show(ck_shown(c, target))),
          span
        ),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, None, o_c1)
    )
  }
}

pub theorem pattern_ctor_unify_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  dc: Text × Nat,
  targs: List(Ty),
  target: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_unify(c, name, args, t, span, dc, targs, target)) {
  tracked_run_bind(
    <A: Bool, B: Option(List(DataField))>,
    c,
    (same: Bool, c1: Checker) => pattern_ctor_same(
      c1,
      name,
      args,
      t,
      span,
      dc,
      targs,
      target,
      not(same)
    ),
    ck_unify(c, target, TyNamed(NameSpelled(pattern_ctor_name(dc)), targs)),
    ck_unify_run_frame_tracked(c, target, TyNamed(NameSpelled(pattern_ctor_name(dc)), targs), ordered),
    same => c1 => o_c1 => pattern_ctor_same_frame_tracked(
      c1,
      name,
      args,
      t,
      span,
      dc,
      targs,
      target,
      not(same),
      o_c1
    )
  )
}

pub theorem pattern_ctor_missing_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  nat: Option(List(DataField)),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_missing(c, name, args, t, span, nat)) {
  match nat {
    Some(fields) => tracked_run_return(c, Some(fields), ordered)
    None => tracked_run_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, datas_pattern_ctor_error(ck_datas_of(c), name, ty_unborrowed(ck_resolve(c, t))), span),
      tracked_run_read(
        c,
        ck_error(c, datas_pattern_ctor_error(ck_datas_of(c), name, ty_unborrowed(ck_resolve(c, t))), span),
        ck_error_frame(c, datas_pattern_ctor_error(ck_datas_of(c), name, ty_unborrowed(ck_resolve(c, t))), span),
        ck_error_frame_tracked(c, datas_pattern_ctor_error(ck_datas_of(c), name, ty_unborrowed(ck_resolve(c, t))), span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, None, o_c1)
    )
  }
}

pub theorem pattern_ctor_lookup_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  found: Option(Text × Nat),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_ctor_lookup(c, name, args, t, span, found)) {
  match found {
    None => pattern_ctor_missing_frame_tracked(
      c,
      name,
      args,
      t,
      span,
      nat_pattern_fields(ck_datas_of(c), name, args, ty_unborrowed(ck_resolve(c, t))),
      ordered
    )
    Some(dc) => tracked_run_bind(
      <A: List(Ty), B: Option(List(DataField))>,
      c,
      (targs: List(Ty), c1: Checker) => pattern_ctor_unify(
        c1,
        name,
        args,
        t,
        span,
        dc,
        targs,
        ty_unborrowed(ck_resolve(c1, t))
      ),
      ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
      tracked_run_read(
        c,
        ck_fresh_each(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ck_fresh_each_frame_tracked(data_generics_of(ck_datas_of(c), pattern_ctor_name(dc)), c),
        ordered
      ),
      targs => c1 => o_c1 => pattern_ctor_unify_frame_tracked(
        c1,
        name,
        args,
        t,
        span,
        dc,
        targs,
        ty_unborrowed(ck_resolve(c1, t)),
        o_c1
      )
    )
  }
}

pub theorem ck_data_ctor_fields_run_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_data_ctor_fields(c, name, args, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(pattern_ctor_fields_unf(c, name, args, t, span)),
    pattern_ctor_lookup_frame_tracked(
      c,
      name,
      args,
      t,
      span,
      datas_ctor_expected(ck_datas_of(c), name, ck_resolve(c, t)),
      ordered
    )
  )
}

pub theorem pattern_product_same_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  parts: List(Ty),
  target: Ty,
  same: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_product_same(c, t, span, parts, target, same)) {
  match same {
    false => tracked_run_return(c, Some(product_pattern_fields(parts)), ordered)
    true => tracked_run_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, product_pattern_cannot_match_message(ty_show(ck_shown(c, target))), span),
      tracked_run_read(
        c,
        ck_error(c, product_pattern_cannot_match_message(ty_show(ck_shown(c, target))), span),
        ck_error_frame(c, product_pattern_cannot_match_message(ty_show(ck_shown(c, target))), span),
        ck_error_frame_tracked(c, product_pattern_cannot_match_message(ty_show(ck_shown(c, target))), span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, None, o_c1)
    )
  }
}

pub theorem pattern_product_unify_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  parts: List(Ty),
  target: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_product_unify(c, t, span, parts, target)) {
  tracked_run_bind(
    <A: Bool, B: Option(List(DataField))>,
    c,
    (same: Bool, c1: Checker) => pattern_product_same(c1, t, span, parts, target, not(same)),
    ck_unify(c, target, ty_product_of(parts)),
    ck_unify_run_frame_tracked(c, target, ty_product_of(parts), ordered),
    same => c1 => o_c1 => pattern_product_same_frame_tracked(c1, t, span, parts, target, not(same), o_c1)
  )
}

pub theorem ck_product_fields_run_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_product_fields(c, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(pattern_product_unf(c, t, span)),
    tracked_run_bind(
      <A: List(Ty), B: Option(List(DataField))>,
      c,
      (parts: List(Ty), c1: Checker) => pattern_product_unify(
        c1,
        t,
        span,
        parts,
        ty_unborrowed(ck_resolve(c1, t))
      ),
      ck_fresh_each(product_pattern_names(), c),
      tracked_run_read(
        c,
        ck_fresh_each(product_pattern_names(), c),
        ck_fresh_each_frame(product_pattern_names(), c),
        ck_fresh_each_frame_tracked(product_pattern_names(), c),
        ordered
      ),
      parts => c1 => o_c1 => pattern_product_unify_frame_tracked(
        c1,
        t,
        span,
        parts,
        ty_unborrowed(ck_resolve(c1, t)),
        o_c1
      )
    )
  )
}

pub theorem pattern_fields_pick_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  product: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, pattern_fields_pick(c, name, args, t, span, product)) {
  match product {
    true => tracked_run_rewrap(
      c,
      ck_product_fields(c, t, span),
      ck_product_fields_run_frame_tracked(c, t, span, ordered)
    )
    false => tracked_run_rewrap(
      c,
      ck_data_ctor_fields(c, name, args, t, span),
      ck_data_ctor_fields_run_frame_tracked(c, name, args, t, span, ordered)
    )
  }
}

pub theorem ck_unlabelled_fields_run_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_unlabelled_fields(c, name, args, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(pattern_fields_pick_unf(c, name, args, t, span)),
    pattern_fields_pick_frame_tracked(
      c,
      name,
      args,
      t,
      span,
      Text::eq(name, surface_product_ctor()),
      ordered
    )
  )
}
pub theorem ck_label_fields_frame_tracked(
  c: Checker,
  tag: Text,
  target: Ty,
  span: TySpan,
  found: Option(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_label_fields(c, tag, target, span, found)) {
  match found {
    Some(under) => tracked_run_return(c, Some(Cons(DataFieldMk(None, under), Nil)), ordered)
    None => tracked_run_bind(
      <A: Unit, B: Option(List(DataField))>,
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, label_not_on_message(tag, ty_show(target)), span),
      tracked_run_read(
        c,
        ck_error(c, label_not_on_message(tag, ty_show(target)), span),
        ck_error_frame(c, label_not_on_message(tag, ty_show(target)), span),
        ck_error_frame_tracked(c, label_not_on_message(tag, ty_show(target)), span),
        ordered
      ),
      ignored => c1 => o_c1 => tracked_run_return(c1, None, o_c1)
    )
  }
}

pub theorem ck_label_var_frame_tracked(c: Checker, tag: Text, target: Ty, o: CkOrdered(c)): TrackedRunFrame(c, ck_label_var(c, tag, target)) {
  tracked_run_bind(
    <A: Ty, B: Option(Ty)>,
    c,
    (under: Ty, c1: Checker) => frame_bind(
      <A: Bool, B: Option(Ty)>,
      (ok: Bool, c2: Checker) => mut1(label_unified(ok, under), c2),
      ck_unify(c1, target, ty_tagged_with(Cons(tag, Nil), under))
    ),
    ck_fresh(c),
    tracked_run_read(c, ck_fresh(c), ck_fresh_frame(c), ck_fresh_frame_tracked(c), o),
    under => c1 => o1 => tracked_run_bind(
      <A: Bool, B: Option(Ty)>,
      c1,
      (ok: Bool, c2: Checker) => mut1(label_unified(ok, under), c2),
      ck_unify(c1, target, ty_tagged_with(Cons(tag, Nil), under)),
      ck_unify_run_frame_tracked(c1, target, ty_tagged_with(Cons(tag, Nil), under), o1),
      ok => c2 => o2 => tracked_run_return(c2, label_unified(ok, under), o2)
    )
  )
}
pub theorem ck_label_found_frame_tracked(c: Checker, tag: Text, target: Ty, unsolved: Bool, o: CkOrdered(c)): TrackedRunFrame(c, ck_label_found(c, tag, target, unsolved)) {
  match unsolved {
    true => tracked_run_rewrap(c, ck_label_var(c, tag, target), ck_label_var_frame_tracked(c, tag, target, o))
    false => tracked_run_return(c, label_under(target, tag), o)
  }
}
pub theorem ck_label_at_frame_tracked(c: Checker, tag: Text, target: Ty, span: TySpan, o: CkOrdered(c)): TrackedRunFrame(c, ck_label_at(c, tag, target, span)) {
  tracked_run_bind(
    <A: Option(Ty), B: Option(List(DataField))>,
    c,
    (found: Option(Ty), c1: Checker) => ck_rewrap1(ck_label_fields(c1, tag, target, span, found)),
    ck_label_found(c, tag, target, ty_is_var(target)),
    ck_label_found_frame_tracked(c, tag, target, ty_is_var(target), o),
    found => c1 => o1 => tracked_run_rewrap(c1, ck_label_fields(c1, tag, target, span, found), ck_label_fields_frame_tracked(c1, tag, target, span, found, o1))
  )
}

pub theorem ck_ctor_fields_by_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  label: Option(Text),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_ctor_fields_by(c, name, args, t, span, label)) {
  match label {
    Some(tag) => tracked_run_rewrap(
      c,
      ck_label_at(c, tag, ty_unborrowed(ck_resolve(c, t)), span),
      ck_label_at_frame_tracked(c, tag, ty_unborrowed(ck_resolve(c, t)), span, ordered)
    )
    None => Eq::subst(
      (z: Mut1(Option(List(DataField)), Checker)) => TrackedRunFrame(c, z),
      Eq::sym(ck_rewrap1_id(ck_unlabelled_fields(c, name, args, t, span))),
      ck_unlabelled_fields_run_frame_tracked(c, name, args, t, span, ordered)
    )
  }
}

pub theorem ck_ctor_fields_run_frame_tracked(
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_ctor_fields(c, name, args, t, span)) {
  Eq::subst(
    (z: Mut1(Option(List(DataField)), Checker)) => TrackedRunFrame(c, z),
    Eq::sym(ck_rewrap1_id(ck_ctor_fields_by(c, name, args, t, span, label_of_ctor(name)))),
    ck_ctor_fields_by_frame_tracked(c, name, args, t, span, label_of_ctor(name), ordered)
  )
}

pub theorem pattern_fields_next_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  borrowed: Option(Bool),
  found: Option(List(DataField)),
  ih_ctor_args: PatternIH_ctor_args_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_fields_next(j, c, name, args, t, env, span, at, borrowed, found)) {
  ⊢ TrackedScopeFrame(
    c,
    pattern_fields_next(j, c, name, args, t, env, span, at, borrowed, found)
  ) from match found {
    None => pattern_return_frame_tracked(c, env, Star, ordered)
    Some(fields) => pattern_rewrap_frame_tracked(
      c,
      ck_ctor_args_in(j, c, args, fields, borrowed, env, span, at),
      ih_ctor_args(c, args, fields, borrowed, env, span, at, ordered)
    )
  }
}

pub theorem pattern_ctor_step_frame_tracked(
  j: Nat,
  c: Checker,
  name: Text,
  args: List(SurfacePattern),
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  borrowed: Option(Bool),
  ih_ctor_args: PatternIH_ctor_args_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_ctor_step(j, c, name, args, t, env, span, at, borrowed)) {
  pattern_bind_one_frame_tracked(
    <A: Option(List(DataField)), B: Unit>,
    c,
    (found: Option(List(DataField)), c1: Checker) => pattern_fields_next(
      j,
      c1,
      name,
      args,
      t,
      env,
      span,
      at,
      borrowed,
      found
    ),
    ck_ctor_fields(c, name, args, t, span),
    ck_ctor_fields_run_frame_tracked(c, name, args, t, span, ordered),
    found => c1 => o_c1 => pattern_fields_next_frame_tracked(
      j,
      c1,
      name,
      args,
      t,
      env,
      span,
      at,
      borrowed,
      found,
      ih_ctor_args,
      o_c1
    )
  )
}

pub theorem pattern_args_fields_frame_tracked(
  j: Nat,
  c: Checker,
  p: SurfacePattern,
  rest: List(SurfacePattern),
  borrowed: Option(Bool),
  env: Scope,
  span: TySpan,
  at: Nat,
  fields: List(DataField),
  ih_pattern: PatternIH_pattern_tracked(j),
  ih_ctor_args: PatternIH_ctor_args_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_args_fields(j, c, p, rest, borrowed, env, span, at, fields)) {
  ⊢ TrackedScopeFrame(
    c,
    pattern_args_fields(j, c, p, rest, borrowed, env, span, at, fields)
  ) from match fields {
    Nil => pattern_return_frame_tracked(c, env, Star, ordered)
    Cons(field, more) => tracked_pattern_bind(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, c1: Checker, env1: Scope) => pattern_rewrap(
        ck_ctor_args_in(j, c1, rest, more, borrowed, env1, span, at)
      ),
      ck_pattern_in(j, c, p, field_under(pattern_field_ty(field), borrowed), env, span, at),
      ih_pattern(c, p, field_under(pattern_field_ty(field), borrowed), env, span, at, ordered),
      ignored => c1 => env1 => o_c1 => pattern_rewrap_frame_tracked(
        c1,
        ck_ctor_args_in(j, c1, rest, more, borrowed, env1, span, at),
        ih_ctor_args(c1, rest, more, borrowed, env1, span, at, o_c1)
      )
    )
  }
}

pub theorem pattern_args_step_frame_tracked(
  j: Nat,
  c: Checker,
  fields: List(DataField),
  borrowed: Option(Bool),
  env: Scope,
  span: TySpan,
  at: Nat,
  args: List(SurfacePattern),
  ih_pattern: PatternIH_pattern_tracked(j),
  ih_ctor_args: PatternIH_ctor_args_tracked(j),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, pattern_args_step(j, c, fields, borrowed, env, span, at, args)) {
  match args {
    Nil => pattern_return_frame_tracked(c, env, Star, ordered)
    Cons(p, rest) => pattern_args_fields_frame_tracked(
      j,
      c,
      p,
      rest,
      borrowed,
      env,
      span,
      at,
      fields,
      ih_pattern,
      ih_ctor_args,
      ordered
    )
  }
}

pub theorem pattern_all_tracked(k: Nat): PatternAll_tracked(k) {
  match k {
    Zero => AndIntro(
      c => p => t => env => span => at => ordered => AndIntro(
        ordered,
        AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
      ),
      AndIntro(
        c => name => args => t => env => span => at => ordered => AndIntro(
          ordered,
          AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
        ),
        c => args => fields => borrowed => env => span => at => ordered => AndIntro(
          ordered,
          AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
        )
      )
    )
    Succ(j) => {
      let ih: PatternAll_tracked(j) := pattern_all_tracked(j)
      AndIntro(
        c => p => t => env => span => at => ordered => Eq::subst(
          (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
          Eq::sym(pattern_pattern_succ_unf(j, c, p, t, env, span, at)),
          pattern_step_frame_tracked(j, c, t, env, span, at, p, And::left(And::right(ih)), ordered)
        ),
        AndIntro(
          c => name => args => t => env => span => at => ordered => Eq::subst(
            (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
            Eq::sym(pattern_ctor_pattern_succ_unf(j, c, name, args, t, env, span, at)),
            pattern_ctor_step_frame_tracked(
              j,
              c,
              name,
              args,
              t,
              env,
              span,
              at,
              ty_borrow_mode(ck_resolve(c, t)),
              And::right(And::right(ih)),
              ordered
            )
          ),
          c => args => fields => borrowed => env => span => at => ordered => Eq::subst(
            (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
            Eq::sym(pattern_ctor_args_succ_unf(j, c, args, fields, borrowed, env, span, at)),
            pattern_args_step_frame_tracked(
              j,
              c,
              fields,
              borrowed,
              env,
              span,
              at,
              args,
              And::left(ih),
              And::right(And::right(ih)),
              ordered
            )
          )
        )
      )
    }
  }
}

pub theorem ck_pattern_scope_frame_tracked(
  k: Nat,
  c: Checker,
  p: SurfacePattern,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  ordered: CkOrdered(c)
): TrackedScopeFrame(
  c,
  ck_pattern_in(k, c, p, t, env, span, at)
) { And::left(pattern_all_tracked(k))(c, p, t, env, span, at, ordered) }

pub theorem ck_pattern_frame_tracked(
  c: Checker,
  p: SurfacePattern,
  t: Ty,
  env: Scope,
  span: TySpan,
  at: Nat,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, ck_pattern(c, p, t, env, span, at)) {
  pattern_rewrap_frame_tracked(
    c,
    ck_pattern_in(ck_steps_of(c), c, p, t, env, span, at),
    ck_pattern_scope_frame_tracked(ck_steps_of(c), c, p, t, env, span, at, ordered)
  )
}
pub theorem handle_patterns_cons_frame_tracked(
  p: SurfacePattern,
  rest: List(SurfacePattern),
  c: Checker,
  inner: Scope,
  body: SurfaceTerm,
  tys: List(Ty),
  ih: ∀ next: Checker. ∀ more: List(
    Ty
  ). ∀ env: Scope. ∀ ordered: CkOrdered(
    next
  ). TrackedScopeFrame(next, ck_handle_patterns(rest, next, more, env, body)),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, handle_patterns_cons(p, rest, c, inner, body, tys)) {
  match tys {
    Nil => pattern_return_frame_tracked(c, inner, Star, ordered)
    Cons(t, more) => tracked_pattern_bind(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, c1: Checker, inner1: Scope) => pattern_rewrap(
        ck_handle_patterns(rest, c1, more, inner1, body)
      ),
      ck_pattern(c, p, t, inner, span_of(body), handle_body_start(body)),
      ck_pattern_frame_tracked(c, p, t, inner, span_of(body), handle_body_start(body), ordered),
      ignored => c1 => inner1 => o_c1 => pattern_rewrap_frame_tracked(
        c1,
        ck_handle_patterns(rest, c1, more, inner1, body),
        ih(c1, more, inner1, o_c1)
      )
    )
  }
}

pub theorem ck_handle_patterns_frame_tracked(
  ps: List(SurfacePattern),
  c: Checker,
  tys: List(Ty),
  inner: Scope,
  body: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, ck_handle_patterns(ps, c, tys, inner, body)) {
  match ps {
    Nil => AndIntro(
      ordered,
      AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    )
    Cons(p, rest) => Eq::subst(
      (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
      Eq::sym(handle_patterns_unf(p, rest, c, tys, inner, body)),
      handle_patterns_cons_frame_tracked(
        p,
        rest,
        c,
        inner,
        body,
        tys,
        next => more => env => onext => ck_handle_patterns_frame_tracked(
          rest,
          next,
          more,
          env,
          body,
          onext
        ),
        ordered
      )
    )
  }
}

pub theorem handle_cont_frame_tracked(
  c: Checker,
  inner: Scope,
  quant: Quant,
  eff: Text,
  answer: Ty,
  result: Ty,
  body: SurfaceTerm,
  cont: Option(Text),
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, handle_cont(c, inner, quant, eff, answer, result, body, cont)) {
  match cont {
    None => pattern_return_frame_tracked(c, inner, Star, ordered)
    Some(k) => pattern_bind_one_frame_tracked(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, c1: Checker) => pattern_rewrap(
        ck_bind_local(
          c1,
          inner,
          k,
          TyFn(Cons(answer, Nil), result, quant_continuation_kind(quant)),
          false,
          handle_body_start(body)
        )
      ),
      frame_error_if(
        c,
        arm_does_not_resume_message(eff, k),
        span_of(body),
        quant_is_zero(quant)
      ),
      tracked_run_read(
        c,
        frame_error_if(
          c,
          arm_does_not_resume_message(eff, k),
          span_of(body),
          quant_is_zero(quant)
        ),
        frame_error_if_ok(
          c,
          arm_does_not_resume_message(eff, k),
          span_of(body),
          quant_is_zero(quant)
        ),
        frame_error_if_ok_tracked(
          c,
          arm_does_not_resume_message(eff, k),
          span_of(body),
          quant_is_zero(quant)
        ),
        ordered
      ),
      ignored => c1 => o_c1 => pattern_rewrap_frame_tracked(
        c1,
        ck_bind_local(
          c1,
          inner,
          k,
          TyFn(Cons(answer, Nil), result, quant_continuation_kind(quant)),
          false,
          handle_body_start(body)
        ),
        ck_bind_local_scope_frame_tracked(
          c1,
          inner,
          k,
          TyFn(Cons(answer, Nil), result, quant_continuation_kind(quant)),
          false,
          handle_body_start(body),
          o_c1
        )
      )
    )
  }
}

pub theorem ck_handle_cont_frame_tracked(
  c: Checker,
  inner: Scope,
  quant: Quant,
  eff: Text,
  cont: Option(Text),
  answer: Ty,
  result: Ty,
  body: SurfaceTerm,
  ordered: CkOrdered(c)
): TrackedScopeFrame(c, ck_handle_cont(c, inner, quant, eff, cont, answer, result, body)) {
  Eq::subst(
    (z: Mut2(Unit, Checker, Scope)) => TrackedScopeFrame(c, z),
    Eq::sym(handle_cont_unf(c, inner, quant, eff, cont, answer, result, body)),
    handle_cont_frame_tracked(c, inner, quant, eff, answer, result, body, cont, ordered)
  )
}
pub theorem inference_use_ck_guard_in_tracked(
  k: Nat,
  c: Checker,
  guard: Option(SurfaceTerm),
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_guard_in(k, c, guard, env)
) { And::left(And::right(And::right(And::right(And::right(ih)))))(c, guard, env, ordered) }

pub theorem ck_attempt_unify_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_attempt_unify(c, a, b)) {
  tracked_run_grows(c, ck_attempt_unify(c, a, b), And::left(attempt_unify_sub(c, a, b)(ordered)))
}
pub theorem ck_set_subst_run_frame_tracked(
  c: Checker,
  v: Nat,
  t: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_set_subst(c, v, t)) {
  AndIntro(
    Ordmap::insert_ordered(
      Ordmap::compare_nat,
      Ordmap::compare_nat_law(),
      ck_subst_of(c),
      v,
      t,
      ordered
    ),
    AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  )
}
pub theorem widen_store_frame_tracked(
  c: Checker,
  rv: Nat,
  value: Ty,
  occurs: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_store(c, rv, value, occurs)) {
  match occurs {
    false => tracked_run_return(c, Star, ordered)
    true => tracked_run_rewrap(
      c,
      ck_set_subst(c, rv, value),
      ck_set_subst_run_frame_tracked(c, rv, value, ordered)
    )
  }
}

pub theorem widen_store_true_frame_tracked(
  c: Checker,
  rv: Nat,
  value: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_store_true(c, rv, value)) {
  tracked_run_bind(
    <A: Unit, B: Bool>,
    c,
    (ignored: Unit, c1: Checker) => mut1(true, c1),
    widen_store(c, rv, value, not(ck_occurs(c, rv, value))),
    widen_store_frame_tracked(c, rv, value, not(ck_occurs(c, rv, value)), ordered),
    ignored => c1 => o_c1 => tracked_run_return(c1, true, o_c1)
  )
}

pub theorem widen_attempt_frame_tracked(
  c: Checker,
  rv: Nat,
  wide: Ty,
  success: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_attempt(c, rv, wide, success)) {
  match success {
    true => widen_store_true_frame_tracked(c, rv, ck_resolve(c, wide), ordered)
    false => tracked_run_return(c, false, ordered)
  }
}

pub theorem widen_fn_allowed_frame_tracked(
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  pb: List(Ty),
  rb: Ty,
  kb: Kind,
  rv: Nat,
  allowed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_fn_allowed(c, pa, ra, ka, pb, rb, kb, rv, allowed)) {
  match allowed {
    true => tracked_run_bind(
      <A: Bool, B: Bool>,
      c,
      (success: Bool, c1: Checker) => widen_attempt(
        c1,
        rv,
        TyFn(pb, rb, kind_join(ka, kb)),
        success
      ),
      ck_attempt_unify(c, TyFn(pa, ra, kind_join(ka, kb)), TyFn(pb, rb, kind_join(ka, kb))),
      ck_attempt_unify_run_frame_tracked(
        c,
        TyFn(pa, ra, kind_join(ka, kb)),
        TyFn(pb, rb, kind_join(ka, kb)),
        ordered
      ),
      success => c1 => o_c1 => widen_attempt_frame_tracked(
        c1,
        rv,
        TyFn(pb, rb, kind_join(ka, kb)),
        success,
        o_c1
      )
    )
    false => tracked_run_return(c, false, ordered)
  }
}

pub theorem widen_fn_current_frame_tracked(
  c: Checker,
  pa: List(Ty),
  ra: Ty,
  ka: Kind,
  rv: Nat,
  current: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_fn_current(c, pa, ra, ka, rv, current)) {
  match current {
    TyInt(w) => tracked_run_return(c, false, ordered)
    TyBool => tracked_run_return(c, false, ordered)
    TyText => tracked_run_return(c, false, ordered)
    TyUnit => tracked_run_return(c, false, ordered)
    TyNever => tracked_run_return(c, false, ordered)
    TyDecimal => tracked_run_return(c, false, ordered)
    TyFloat => tracked_run_return(c, false, ordered)
    TyFloat32 => tracked_run_return(c, false, ordered)
    TyFn(pb, rb, kb) => widen_fn_allowed_frame_tracked(
      c,
      pa,
      ra,
      ka,
      pb,
      rb,
      kb,
      rv,
      Bool::and(Nat::eq(list_len(pa), list_len(pb)), not(kind_eq(ka, kb))),
      ordered
    )
    TyUnion(members) => tracked_run_return(c, false, ordered)
    TyProduct(members) => tracked_run_return(c, false, ordered)
    TyTagged(tags, inner) => tracked_run_return(c, false, ordered)
    TyNamed(name, args) => tracked_run_return(c, false, ordered)
    TyParam(name, bound) => tracked_run_return(c, false, ordered)
    TyInfo(inner) => tracked_run_return(c, false, ordered)
    TyBorrow(inner, mutable) => tracked_run_return(c, false, ordered)
    TyVar(v) => tracked_run_return(c, false, ordered)
    TyPoly(generics, inner) => tracked_run_return(c, false, ordered)
    TyApp(head, arg) => tracked_run_return(c, false, ordered)
  }
}

pub theorem widen_fn_arm_frame_tracked(
  c: Checker,
  current: Ty,
  rv: Nat,
  arm: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_fn_arm(c, current, rv, arm)) {
  match arm {
    TyInt(w) => tracked_run_return(c, false, ordered)
    TyBool => tracked_run_return(c, false, ordered)
    TyText => tracked_run_return(c, false, ordered)
    TyUnit => tracked_run_return(c, false, ordered)
    TyNever => tracked_run_return(c, false, ordered)
    TyDecimal => tracked_run_return(c, false, ordered)
    TyFloat => tracked_run_return(c, false, ordered)
    TyFloat32 => tracked_run_return(c, false, ordered)
    TyFn(pa, ra, ka) => widen_fn_current_frame_tracked(c, pa, ra, ka, rv, current, ordered)
    TyUnion(members) => tracked_run_return(c, false, ordered)
    TyProduct(members) => tracked_run_return(c, false, ordered)
    TyTagged(tags, inner) => tracked_run_return(c, false, ordered)
    TyNamed(name, args) => tracked_run_return(c, false, ordered)
    TyParam(name, bound) => tracked_run_return(c, false, ordered)
    TyInfo(inner) => tracked_run_return(c, false, ordered)
    TyBorrow(inner, mutable) => tracked_run_return(c, false, ordered)
    TyVar(v) => tracked_run_return(c, false, ordered)
    TyPoly(generics, inner) => tracked_run_return(c, false, ordered)
    TyApp(head, arg) => tracked_run_return(c, false, ordered)
  }
}

pub theorem ck_widen_fn_run_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_widen_fn(c, a, current, rv)) {
  Eq::subst(
    (z: Mut1(Bool, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(widen_fn_unf(c, a, current, rv)),
    widen_fn_arm_frame_tracked(c, current, rv, ck_resolve(c, a), ordered)
  )
}

pub theorem ck_attempt_fits_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_attempt_fits(c, a, b)) {
  tracked_run_grows(c, ck_attempt_fits(c, a, b), And::left(ck_attempt_fits_ok(c, a, b)(ordered)))
}
pub theorem widen_fits_if_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  allowed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_fits_if(c, a, b, allowed)) {
  match allowed {
    true => tracked_run_rewrap(
      c,
      ck_attempt_fits(c, a, b),
      ck_attempt_fits_run_frame_tracked(c, a, b, ordered)
    )
    false => tracked_run_return(c, false, ordered)
  }
}

pub theorem widen_borrow_current_frame_tracked(
  c: Checker,
  a: Ty,
  rv: Nat,
  current: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_borrow_current(c, a, rv, current)) {
  match current {
    TyInt(w) => tracked_run_return(c, false, ordered)
    TyBool => tracked_run_return(c, false, ordered)
    TyText => tracked_run_return(c, false, ordered)
    TyUnit => tracked_run_return(c, false, ordered)
    TyNever => tracked_run_return(c, false, ordered)
    TyDecimal => tracked_run_return(c, false, ordered)
    TyFloat => tracked_run_return(c, false, ordered)
    TyFloat32 => tracked_run_return(c, false, ordered)
    TyFn(params, result, kind) => tracked_run_return(c, false, ordered)
    TyUnion(members) => tracked_run_return(c, false, ordered)
    TyProduct(members) => tracked_run_return(c, false, ordered)
    TyTagged(tags, inner) => tracked_run_return(c, false, ordered)
    TyNamed(name, args) => tracked_run_return(c, false, ordered)
    TyParam(name, bound) => tracked_run_return(c, false, ordered)
    TyInfo(inner) => tracked_run_return(c, false, ordered)
    TyBorrow(x, m) => tracked_run_bind(
      <A: Bool, B: Bool>,
      c,
      (success: Bool, c1: Checker) => widen_attempt(c1, rv, x, success),
      widen_fits_if(
        c,
        a,
        x,
        Bool::and(not(ty_is_borrow(ck_resolve(c, a))), kind_dup(ck_kind(c, x)))
      ),
      widen_fits_if_frame_tracked(
        c,
        a,
        x,
        Bool::and(not(ty_is_borrow(ck_resolve(c, a))), kind_dup(ck_kind(c, x))),
        ordered
      ),
      success => c1 => o_c1 => widen_attempt_frame_tracked(c1, rv, x, success, o_c1)
    )
    TyVar(v) => tracked_run_return(c, false, ordered)
    TyPoly(generics, inner) => tracked_run_return(c, false, ordered)
    TyApp(head, arg) => tracked_run_return(c, false, ordered)
  }
}

pub theorem ck_widen_borrowed_current_run_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_widen_borrowed_current(c, a, current, rv)) {
  Eq::subst(
    (z: Mut1(Bool, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(widen_borrow_current_unf(c, a, current, rv)),
    widen_borrow_current_frame_tracked(c, a, rv, current, ordered)
  )
}

pub theorem widen_borrow_arm_frame_tracked(
  c: Checker,
  current: Ty,
  arm: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_borrow_arm(c, current, arm)) {
  match arm {
    TyInt(w) => tracked_run_return(c, false, ordered)
    TyBool => tracked_run_return(c, false, ordered)
    TyText => tracked_run_return(c, false, ordered)
    TyUnit => tracked_run_return(c, false, ordered)
    TyNever => tracked_run_return(c, false, ordered)
    TyDecimal => tracked_run_return(c, false, ordered)
    TyFloat => tracked_run_return(c, false, ordered)
    TyFloat32 => tracked_run_return(c, false, ordered)
    TyFn(params, result, kind) => tracked_run_return(c, false, ordered)
    TyUnion(members) => tracked_run_return(c, false, ordered)
    TyProduct(members) => tracked_run_return(c, false, ordered)
    TyTagged(tags, inner) => tracked_run_return(c, false, ordered)
    TyNamed(name, args) => tracked_run_return(c, false, ordered)
    TyParam(name, bound) => tracked_run_return(c, false, ordered)
    TyInfo(inner) => tracked_run_return(c, false, ordered)
    TyBorrow(x, m) => widen_fits_if_frame_tracked(
      c,
      x,
      current,
      Bool::and(not(ty_is_borrow(current)), kind_dup(ck_kind(c, x))),
      ordered
    )
    TyVar(v) => tracked_run_return(c, false, ordered)
    TyPoly(generics, inner) => tracked_run_return(c, false, ordered)
    TyApp(head, arg) => tracked_run_return(c, false, ordered)
  }
}

pub theorem ck_widen_borrowed_arm_run_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_widen_borrowed_arm(c, a, current)) {
  Eq::subst(
    (z: Mut1(Bool, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(widen_borrow_arm_unf(c, a, current)),
    widen_borrow_arm_frame_tracked(c, current, ck_resolve(c, a), ordered)
  )
}

pub theorem widen_final_fits_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_final_fits(c, a, current, rv, failed)) {
  match failed {
    true => tracked_run_rewrap(
      c,
      ck_set_subst(c, rv, ty_union(Cons(current, Cons(ck_resolve(c, a), Nil)))),
      ck_set_subst_run_frame_tracked(
        c,
        rv,
        ty_union(Cons(current, Cons(ck_resolve(c, a), Nil))),
        ordered
      )
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem widen_after_arm_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_after_arm(c, a, current, rv, failed)) {
  match failed {
    true => tracked_run_bind(
      <A: Bool, B: Unit>,
      c,
      (success: Bool, c1: Checker) => widen_final_fits(c1, a, current, rv, not(success)),
      ck_attempt_fits(c, a, current),
      ck_attempt_fits_run_frame_tracked(c, a, current, ordered),
      success => c1 => o_c1 => widen_final_fits_frame_tracked(
        c1,
        a,
        current,
        rv,
        not(success),
        o_c1
      )
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem widen_after_current_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_after_current(c, a, current, rv, failed)) {
  match failed {
    true => tracked_run_bind(
      <A: Bool, B: Unit>,
      c,
      (success: Bool, c1: Checker) => widen_after_arm(c1, a, current, rv, not(success)),
      ck_widen_borrowed_arm(c, a, current),
      ck_widen_borrowed_arm_run_frame_tracked(c, a, current, ordered),
      success => c1 => o_c1 => widen_after_arm_frame_tracked(c1, a, current, rv, not(success), o_c1)
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem widen_after_fn_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  failed: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_after_fn(c, a, current, rv, failed)) {
  match failed {
    true => tracked_run_bind(
      <A: Bool, B: Unit>,
      c,
      (success: Bool, c1: Checker) => widen_after_current(c1, a, current, rv, not(success)),
      ck_widen_borrowed_current(c, a, current, rv),
      ck_widen_borrowed_current_run_frame_tracked(c, a, current, rv, ordered),
      success => c1 => o_c1 => widen_after_current_frame_tracked(
        c1,
        a,
        current,
        rv,
        not(success),
        o_c1
      )
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem widen_handle_frame_tracked(
  c: Checker,
  a: Ty,
  current: Ty,
  rv: Nat,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, widen_handle(c, a, current, rv)) {
  tracked_run_bind(
    <A: Bool, B: Unit>,
    c,
    (success: Bool, c1: Checker) => widen_after_fn(c1, a, current, rv, not(success)),
    ck_widen_fn(c, a, current, rv),
    ck_widen_fn_run_frame_tracked(c, a, current, rv, ordered),
    success => c1 => o_c1 => widen_after_fn_frame_tracked(c1, a, current, rv, not(success), o_c1)
  )
}

pub theorem ck_handle_widen_run_frame_tracked(
  c: Checker,
  a: Ty,
  result: Ty,
  rv: Nat,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_handle_widen(c, a, result, rv)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(widen_handle_unf(c, a, result, rv)),
    widen_handle_frame_tracked(c, a, ck_resolve(c, result), rv, ordered)
  )
}
pub theorem handler_fits_any_frame_tracked(
  k: Nat,
  c: Checker,
  a: Ty,
  choices: List(Ty),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_fits_any_in(k, c, a, choices)) {
  tracked_run_grows(
    c,
    ck_fits_any_in(k, c, a, choices),
    And::left(handler_fits_any_ok(k, c, a, choices)(ordered))
  )
}

pub theorem handler_validate_after_frame_tracked(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  fits: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, handler_validate_after(c, arm, result, span, fits)) {
  match fits {
    true => tracked_run_return(c, Star, ordered)
    false => tracked_run_rewrap(
      c,
      ck_expect(c, arm, result, span, what_handler_arm_message()),
      ck_expect_run_frame_tracked(c, arm, result, span, what_handler_arm_message(), ordered)
    )
  }
}

pub theorem handler_validate_unfolded_frame_tracked(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, handler_validate_unfolded(c, arm, result, span)) {
  tracked_run_bind(
    <A: Bool, B: Unit>,
    c,
    (fits: Bool, c1: Checker) => handler_validate_after(c1, arm, result, span, fits),
    ck_fits_any_in(ck_steps_of(c), c, arm, ck_handle_result_choices(ck_resolve(c, result))),
    handler_fits_any_frame_tracked(
      ck_steps_of(c),
      c,
      arm,
      ck_handle_result_choices(ck_resolve(c, result)),
      ordered
    ),
    fits => c1 => o_c1 => handler_validate_after_frame_tracked(c1, arm, result, span, fits, o_c1)
  )
}

pub theorem ck_handle_validate_frame_tracked(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_handle_validate(c, arm, result, span)) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => TrackedRunFrame(c, m),
    Eq::sym(handler_validate_unf(c, arm, result, span)),
    handler_validate_unfolded_frame_tracked(c, arm, result, span, ordered)
  )
}
pub theorem ck_handle_arm_result_run_frame_tracked(
  c: Checker,
  arm: Ty,
  result: Ty,
  variable: Option(Nat),
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_handle_arm_result(c, arm, result, variable, span)) {
  match variable {
    Some(rv) => tracked_run_rewrap(
      c,
      ck_handle_widen(c, arm, result, rv),
      ck_handle_widen_run_frame_tracked(c, arm, result, rv, ordered)
    )
    None => tracked_run_rewrap(
      c,
      ck_handle_validate(c, arm, result, span),
      ck_handle_validate_frame_tracked(c, arm, result, span, ordered)
    )
  }
}
pub theorem arm_finish_after_run_frame_tracked(
  c: Checker,
  eff: Text,
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  out: Bool,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, arm_finish_after(c, eff, a, result, rv, span, out)) {
  match out {
    true => tracked_run_read(
      c,
      arm_finish_after(c, eff, a, result, rv, span, true),
      frame_rewrap(
        c,
        ck_error(
          c,
          arm_must_be_generic_message(eff),
          span
        ),
        ck_error_frame(
          c,
          arm_must_be_generic_message(eff),
          span
        )
      ),
      tracked_rewrap(
        c,
        ck_error(
          c,
          arm_must_be_generic_message(eff),
          span
        ),
        ck_error_frame_tracked(
          c,
          arm_must_be_generic_message(eff),
          span
        )
      ),
      ordered
    )
    false => tracked_run_rewrap(
      c,
      ck_handle_arm_result(c, a, result, rv, span),
      ck_handle_arm_result_run_frame_tracked(c, a, result, rv, span, ordered)
    )
  }
}
pub theorem ck_handle_arm_finish_run_frame_tracked(
  c: Checker,
  eff: Text,
  rigid: List(Text),
  env: List(Local),
  types: List(TypeName),
  a: Ty,
  result: Ty,
  rv: Option(Nat),
  span: TySpan,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_handle_arm_finish(c, eff, rigid, env, types, a, result, rv, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(arm_finish_unf(c, eff, rigid, env, types, a, result, rv, span)),
    tracked_run_bind(
      <A: Unit, B: Unit>,
      c,
      (ignored: Unit, c1: Checker) => arm_finish_after(
        c1,
        eff,
        a,
        result,
        rv,
        span,
        ck_arm_lets_rigid_out(c1, rigid, a, result, env)
      ),
      arm_set_types(c, types),
      tracked_run_read(c, arm_set_types(c, types), Refl, tracked_state_refl(c), ordered),
      ignored => c1 => o_c1 => arm_finish_after_run_frame_tracked(
        c1,
        eff,
        a,
        result,
        rv,
        span,
        ck_arm_lets_rigid_out(c1, rigid, a, result, env),
        o_c1
      )
    )
  )
}
pub theorem inference_arm_tail_frame_tracked(
  j: Nat,
  c: Checker,
  inner: Scope,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  rigid: List(Text),
  names: List(TypeName),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_arm_tail(j, c, inner, env, result, rv, eff, rigid, names, guard, body)
) {
  tracked_run_bind(
    <A: Unit, B: Unit>,
    c,
    (entered: Unit, c1: Checker) => frame_bind(
      <A: Unit, B: Unit>,
      (guarded: Unit, c2: Checker) => frame_bind(
        <A: Ty, B: Unit>,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner))
    ),
    ck_arm_enter(c, names),
    tracked_run_read(
      c,
      ck_arm_enter(c, names),
      ck_arm_enter_frame(c, names),
      ck_arm_enter_frame_tracked(c, names),
      ordered
    ),
    entered => c1 => o_c1 => tracked_run_bind(
      <A: Unit, B: Unit>,
      c1,
      (guarded: Unit, c2: Checker) => frame_bind(
        <A: Ty, B: Unit>,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner)),
      inference_use_ck_guard_in_tracked(j, c1, guard, inference_scope_items(inner), o_c1, ih),
      guarded => c2 => o_c2 => tracked_run_bind(
        <A: Ty, B: Unit>,
        c2,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner)),
        inference_use_ck_infer_in_tracked(j, c2, body, inference_scope_items(inner), o_c2, ih),
        a => c3 => o_c3 => tracked_run_rewrap(
          c3,
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          ),
          ck_handle_arm_finish_run_frame_tracked(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body),
            o_c3
          )
        )
      )
    )
  )
}

pub theorem inference_handle_body_step_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  params: List(Ty),
  answer: Ty,
  rigid: List(Text),
  names: List(TypeName),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  quant: Quant,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_handle_body_step(
    j,
    c,
    env,
    result,
    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body,
    quant
  )
) {
  tracked_run_bind(
    <A: Unit, B: Unit>,
    c,
    (r#direct: Unit, c1: Checker) => inference_bind_scope(
      <A: Unit, B: Unit>,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        <A: Unit, B: Unit>,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body)
    ),
    ck_handle_direct(c, quant, eff, cont, guard, body),
    tracked_run_read(
      c,
      ck_handle_direct(c, quant, eff, cont, guard, body),
      ck_handle_direct_frame(c, quant, eff, cont, guard, body),
      ck_handle_direct_frame_tracked(c, quant, eff, cont, guard, body),
      ordered
    ),
    r#direct => c1 => o_c1 => inference_bind_scope_frame_tracked(
      <A: Unit, B: Unit>,
      c1,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        <A: Unit, B: Unit>,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body),
      ck_handle_patterns_frame_tracked(patterns, c1, params, ScopeMk(env), body, o_c1),
      matched => c2 => inner => o_c2 => inference_bind_scope_frame_tracked(
        <A: Unit, B: Unit>,
        c2,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body),
        ck_handle_cont_frame_tracked(c2, inner, quant, eff, cont, answer, result, body, o_c2),
        bound => c3 => inner2 => o_c3 => inference_arm_tail_frame_tracked(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body,
          ih,
          o_c3
        )
      )
    )
  )
}

