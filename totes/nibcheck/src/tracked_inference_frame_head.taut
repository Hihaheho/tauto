}

pub theorem inference_tail_ck_operands_in_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  first: Ty,
  rest: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_tail_ck_operands_in(j, c, env, first, rest)) {
  tracked_run_bind(
    <A: List(Ty), B: List(Ty)>,
    c,
    (tl: List(Ty), c1: Checker) => mut1(Cons(first, tl), c1),
    ck_operands_in(j, c, rest, env),
    inference_use_ck_operands_in_tracked(j, c, rest, env, ordered, ih),
    tl => c1 => o_c1 => tracked_run_return(c1, Cons(first, tl), o_c1)
  )
}

pub theorem inference_list_ck_operands_in_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  arguments: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_list_ck_operands_in(j, c, env, arguments)) {
  match arguments {
    Nil => tracked_run_return(c, Nil, ordered)
    Cons(a, rest) => tracked_run_bind(
      <A: Ty, B: List(Ty)>,
      c,
      (h: Ty, c1: Checker) => inference_tail_ck_operands_in(
        j,
        c1,
        env,
        ty_operand(ck_resolve(c1, h)),
        rest
      ),
      ck_infer_in(j, c, a, env),
      inference_use_ck_infer_in_tracked(j, c, a, env, ordered, ih),
      h => c1 => o_c1 => inference_tail_ck_operands_in_frame_tracked(
        j,
        c1,
        env,
        ty_operand(ck_resolve(c1, h)),
        rest,
        ih,
        o_c1
      )
    )
  }
}

