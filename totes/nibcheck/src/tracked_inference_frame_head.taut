pub theorem inference_handle_budget_frame_tracked(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_handle_budget(j, c, body, handlers, env, budget_ty, answers)) {
  tracked_run_bind(
    <A: Unit, B: Ty>,
    c,
    (pushed: Unit, c1: Checker) => frame_bind(
      <A: Ty, B: Ty>,
      (b: Ty, c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (popped: Unit, c3: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (result: Ty, c4: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (first: Ty, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env)
    ),
    inference_budget_push(j, c, body, handlers, env, budget_ty, answers),
    inference_budget_push_frame_tracked(j, c, body, handlers, env, budget_ty, answers, ih, ordered),
    pushed => c1 => o_c1 => tracked_run_bind(
      <A: Ty, B: Ty>,
      c1,
      (b: Ty, c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (popped: Unit, c3: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (result: Ty, c4: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (first: Ty, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env),
      inference_use_ck_infer_in_tracked(j, c1, body, env, o_c1, ih),
      b => c2 => o_c2 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c2,
        (popped: Unit, c3: Checker) => frame_bind(
          <A: Ty, B: Ty>,
          (result: Ty, c4: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (first: Ty, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers),
        inference_budget_pop_frame_tracked(j, c2, answers, ih, o_c2),
        popped => c3 => o_c3 => tracked_run_bind(
          <A: Ty, B: Ty>,
          c3,
          (result: Ty, c4: Checker) => frame_bind(
            <A: Ty, B: Ty>,
            (first: Ty, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3),
          tracked_run_read(c3, ck_fresh(c3), ck_fresh_frame(c3), ck_fresh_frame_tracked(c3), o_c3),
          result => c4 => o_c4 => tracked_run_bind(
            <A: Ty, B: Ty>,
            c4,
            (first: Ty, c5: Checker) => frame_bind(
              <A: Unit, B: Ty>,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env),
            inference_use_ck_handle_first_in_tracked(j, c4, handlers, b, env, o_c4, ih),
            first => c5 => o_c5 => tracked_run_bind(
              <A: Unit, B: Ty>,
              c5,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty),
              inference_use_ck_handle_result_in_tracked(
                j,
                c5,
                handlers,
                env,
                result,
                first,
                budget_ty,
                o_c5,
                ih
              ),
              finished => c6 => o_c6 => tracked_run_return(c6, result, o_c6)
            )
          )
        )
      )
    )
  )
}

pub theorem inference_step_ck_handle_in_frame_tracked(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_step_ck_handle_in(j, c, body, handlers, env)) {
  tracked_run_bind(
    <A: Ty, B: Ty>,
    c,
    (budget_ty: Ty, c1: Checker) => inference_handle_budget(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers)
    ),
    ck_fresh(c),
    tracked_run_read(c, ck_fresh(c), ck_fresh_frame(c), ck_fresh_frame_tracked(c), ordered),
    budget_ty => c1 => o_c1 => inference_handle_budget_frame_tracked(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers),
      ih,
      o_c1
    )
  )
}

pub theorem inference_use_ck_infer_term_in_tracked(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c),
  ih: InferenceFrames_tracked(k)
): TrackedRunFrame(
  c,
  ck_infer_term_in(k, c, term, env)
) { And::left(And::right(ih))(c, term, env, ordered) }

pub theorem inference_step_ck_infer_in_frame_tracked(
  j: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_step_ck_infer_in(j, c, term, env)) {
  tracked_run_bind(
    <A: Ty, B: Ty>,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      <A: Unit, B: Ty>,
      (cleared: Unit, c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (ignored: Unit, c3: Checker) => mut1(t, c3),
        access_record_term(c2, term, t)
      ),
      inference_set_result_hint(c1, None)
    ),
    ck_infer_term_in(j, c, term, env),
    inference_use_ck_infer_term_in_tracked(j, c, term, env, ordered, ih),
    t => c1 => o_c1 => tracked_run_bind(
      <A: Unit, B: Ty>,
      c1,
      (cleared: Unit, c2: Checker) => frame_bind(
        <A: Unit, B: Ty>,
        (ignored: Unit, c3: Checker) => mut1(t, c3),
        access_record_term(c2, term, t)
      ),
      inference_set_result_hint(c1, None),
      tracked_run_read(
        c1,
        inference_set_result_hint(c1, None),
        inference_set_result_hint_frame(c1, None),
        inference_set_result_hint_frame_tracked(c1, None),
        o_c1
      ),
      cleared => c2 => o_c2 => tracked_run_bind(
        <A: Unit, B: Ty>,
        c2,
        (ignored: Unit, c3: Checker) => mut1(t, c3),
        access_record_term(c2, term, t),
        tracked_run_read(
          c2,
          access_record_term(c2, term, t),
          access_record_term_frame(c2, term, t),
          access_record_term_frame_tracked(c2, term, t),
          o_c2
        ),
        ignored => c3 => o_c3 => tracked_run_return(c3, t, o_c3)
      )
    )
  )
}

pub theorem ck_join_run_frame_tracked(
  c: Checker,
  a: Ty,
  b: Ty,
  ordered: CkOrdered(c)
): TrackedRunFrame(c, ck_join(c, a, b)) {
  tracked_run_grows(c, ck_join(c, a, b), And::left(ck_join_ok(c, a, b)(ordered)))
}
pub theorem inference_else_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  env: List(Local),
  el: Option(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_else(j, c, t, env, el)) {
  match el {
    None => tracked_run_return(c, TyUnit, ordered)
    Some(o) => tracked_run_bind(
      <A: Ty, B: Ty>,
      c,
      (ot: Ty, c1: Checker) => ck_rewrap1(ck_join(c1, t, ot)),
      ck_infer_in(j, c, o, env),
      inference_use_ck_infer_in_tracked(j, c, o, env, ordered, ih),
      ot => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_join(c1, t, ot),
        ck_join_run_frame_tracked(c1, t, ot, o_c1)
      )
    )
  }
}

pub theorem inference_step_ck_else_in_frame_tracked(
  j: Nat,
  c: Checker,
  t: Ty,
  el: Option(SurfaceTerm),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_else_in(j, c, t, el, env)
) { inference_else_frame_tracked(j, c, t, env, el, ih, ordered) }

pub theorem inference_guard_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  guard: Option(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_guard(j, c, env, guard)) {
  match guard {
    None => tracked_run_return(c, Star, ordered)
    Some(g) => tracked_run_bind(
      <A: Ty, B: Unit>,
      c,
      (gt: Ty, c1: Checker) => ck_rewrap1(ck_expect(c1, gt, TyBool, span_of(g), what_guard_message())),
      ck_infer_in(j, c, g, env),
      inference_use_ck_infer_in_tracked(j, c, g, env, ordered, ih),
      gt => c1 => o_c1 => tracked_run_rewrap(
        c1,
        ck_expect(c1, gt, TyBool, span_of(g), what_guard_message()),
        ck_expect_run_frame_tracked(c1, gt, TyBool, span_of(g), what_guard_message(), o_c1)
      )
    )
  }
}

pub theorem inference_step_ck_guard_in_frame_tracked(
  j: Nat,
  c: Checker,
  guard: Option(SurfaceTerm),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_guard_in(j, c, guard, env)
) { inference_guard_frame_tracked(j, c, env, guard, ih, ordered) }

pub theorem inference_returned_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  e: Option(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_returned(j, c, env, e)) {
  match e {
    None => tracked_run_return(c, #(TyUnit, TySpan { start: 0, end: 0 }), ordered)
    Some(x) => tracked_run_bind(
      <A: Unit, B: (Ty × TySpan)>,
      c,
      (hinted: Unit, c0: Checker) => frame_bind(
        <A: Ty, B: (Ty × TySpan)>,
        (t: Ty, c1: Checker) => mut1(#(t, span_of(x)), c1),
        ck_infer_in(j, c0, x, env)
      ),
      inference_set_result_hint(c, ck_result_hint_for(x, ck_return_hint(inference_returns(c)))),
      tracked_run_read(
      c,
      inference_set_result_hint(c, ck_result_hint_for(x, ck_return_hint(inference_returns(c)))),
      inference_set_result_hint_frame(c, ck_result_hint_for(x, ck_return_hint(inference_returns(c)))),
      inference_set_result_hint_frame_tracked(c, ck_result_hint_for(x, ck_return_hint(inference_returns(c)))),
      ordered
      ),
      hinted => c0 => o_c0 => tracked_run_bind(
        <A: Ty, B: (Ty × TySpan)>,
        c0,
        (t: Ty, c1: Checker) => mut1(#(t, span_of(x)), c1),
        ck_infer_in(j, c0, x, env),
        inference_use_ck_infer_in_tracked(j, c0, x, env, o_c0, ih),
        t => c1 => o_c1 => tracked_run_return(c1, #(t, span_of(x)), o_c1)
      )
    )
  }
}

pub theorem inference_step_ck_returned_in_frame_tracked(
  j: Nat,
  c: Checker,
  e: Option(SurfaceTerm),
  env: List(Local),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_returned_in(j, c, e, env)
) { inference_returned_frame_tracked(j, c, env, e, ih, ordered) }

pub theorem inference_tail_ck_infer_each_in_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  first: Ty,
  rest: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_tail_ck_infer_each_in(j, c, env, first, rest)) {
  tracked_run_bind(
    <A: List(Ty), B: List(Ty)>,
    c,
    (tl: List(Ty), c1: Checker) => mut1(Cons(first, tl), c1),
    ck_infer_each_in(j, c, rest, env),
    inference_use_ck_infer_each_in_tracked(j, c, rest, env, ordered, ih),
    tl => c1 => o_c1 => tracked_run_return(c1, Cons(first, tl), o_c1)
  )
}

pub theorem inference_list_ck_infer_each_in_frame_tracked(
  j: Nat,
  c: Checker,
  env: List(Local),
  ts: List(SurfaceTerm),
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_list_ck_infer_each_in(j, c, env, ts)) {
  match ts {
    Nil => tracked_run_return(c, Nil, ordered)
    Cons(t, rest) => tracked_run_bind(
      <A: Ty, B: List(Ty)>,
      c,
      (h: Ty, c1: Checker) => inference_tail_ck_infer_each_in(j, c1, env, h, rest),
      ck_infer_in(j, c, t, env),
      inference_use_ck_infer_in_tracked(j, c, t, env, ordered, ih),
      h => c1 => o_c1 => inference_tail_ck_infer_each_in_frame_tracked(
        j,
        c1,
        env,
        h,
        rest,
        ih,
        o_c1
      )
    )
  }
}

