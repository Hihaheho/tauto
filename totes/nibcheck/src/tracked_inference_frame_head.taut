  budget_ty: Ty,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(
  c,
  inference_step_ck_handle_result_in(j, c, handlers, env, result, first, budget_ty)
) {
  inference_handle_result_frame_tracked(
    j,
    c,
    handlers,
    env,
    result,
    first,
    budget_ty,
    ty_var_of(result),
    ih,
    ordered
  )
}

pub theorem inference_successor_ck_infer_in_tracked(
  j: Nat,
  ih: InferenceFrames_tracked(j)
): Inference_ck_infer_in_tracked(Succ(j)) {
  c => term => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedRunFrame(c, z),
    Eq::sym(inference_unf_ck_infer_in(j, c, term, env)),
    inference_step_ck_infer_in_frame_tracked(j, c, term, env, ih, ordered)
  )
}
