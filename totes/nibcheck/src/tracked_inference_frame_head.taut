    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body
  )
) {
  tracked_run_bind(
    <A: Option(ArmSig), B: Unit>,
    c,
    (signature: Option(ArmSig), c1: Checker) => inference_handler_signature(
      j,
      c1,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature
    ),
    ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body),
    tracked_run_read(
      c,
      ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body),
      ck_handle_arm_sig_frame(c, eff, binds, types, result, rv, budget_ty, body),
      ck_handle_arm_sig_frame_tracked(c, eff, binds, types, result, rv, budget_ty, body),
      ordered
    ),
    signature => c1 => o_c1 => inference_handler_signature_frame_tracked(
      j,
      c1,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature,
      ih,
      o_c1
    )
  )
}

pub theorem inference_budget_push_frame_tracked(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool,
  ih: InferenceFrames_tracked(j),
  ordered: CkOrdered(c)
): TrackedRunFrame(c, inference_budget_push(j, c, body, handlers, env, budget_ty, answers)) {
  ⊢ TrackedRunFrame(
    c,
    inference_budget_push(j, c, body, handlers, env, budget_ty, answers)
  ) from match answers {
    true => tracked_run_read(
      c,
      inference_set_exceeded(c, Cons(budget_ty, inference_exceeded(c))),
      inference_set_exceeded_frame(c, Cons(budget_ty, inference_exceeded(c))),
      inference_set_exceeded_frame_tracked(c, Cons(budget_ty, inference_exceeded(c))),
      ordered
    )
    false => tracked_run_return(c, Star, ordered)
  }
}

pub theorem inference_budget_pop_frame_tracked(
  j: Nat,
  c: Checker,
  answers: Bool,
  ih: InferenceFrames_tracked(j),
