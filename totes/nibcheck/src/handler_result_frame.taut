import "widen_error_sound.taut"
import "checker.taut"
import "checker_frame.taut"
import "datas_frame.taut"
import "fits_sound.taut"
import "ty.taut"
import "types_match.taut"
import "unify_sound.taut"
import "widen_frame.taut"

pub theorem handler_fits_any_ok(
  k: Nat,
  c: Checker,
  a: Ty,
  choices: List(Ty)
): Post(c, ck_fits_any_in(k, c, a, choices), (next: Checker) => SubAnyAt(next, a, choices)) {
  And::left(
    And::right(
      And::right(
        And::right(
          And::right(
            And::right(
              And::right(
                And::right(
                  And::right(
                    And::right(And::right(And::right(And::right(And::right(fits_all(k))))))
                  )
                )
              )
            )
          )
        )
      )
    )
  )(c, a, choices)
}

pub theorem handler_fits_any_frame(
  k: Nat,
  c: Checker,
  a: Ty,
  choices: List(Ty),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_fits_any_in(k, c, a, choices)) {
  run_frame_grows(
    c,
    ck_fits_any_in(k, c, a, choices),
    And::left(handler_fits_any_ok(k, c, a, choices)(ordered))
  )
}

pub fn handler_validate_after(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  fits: Bool
): Mut1(Unit, Checker) {
  ⊢ Mut1(Unit, Checker) from match fits {
    true => mut1(Star, c)
    false => ck_rewrap1(ck_expect(c, arm, result, span, "a handler arm"))
  }
}

pub theorem handler_validate_after_frame(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  fits: Bool,
  ordered: CkOrdered(c)
): CkRunFrame(c, handler_validate_after(c, arm, result, span, fits)) {
  ⊢ CkRunFrame(c, handler_validate_after(c, arm, result, span, fits)) from match fits {
    true => run_frame_return(c, Star, ordered)
    false => run_frame_rewrap(
      c,
      ck_expect(c, arm, result, span, "a handler arm"),
      ck_expect_run_frame(c, arm, result, span, "a handler arm", ordered)
    )
  }
}

pub fn handler_validate_unfolded(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan
): Mut1(Unit, Checker) {
  frame_bind(
    Bool,
    Unit,
    (fits: Bool, c1: Checker) => handler_validate_after(c1, arm, result, span, fits),
    ck_fits_any_in(ck_steps_of(c), c, arm, ck_handle_result_choices(ck_resolve(c, result)))
  )
}

pub theorem handler_validate_unfolded_frame(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, handler_validate_unfolded(c, arm, result, span)) {
  run_frame_bind(
    Bool,
    Unit,
    c,
    (fits: Bool, c1: Checker) => handler_validate_after(c1, arm, result, span, fits),
    ck_fits_any_in(ck_steps_of(c), c, arm, ck_handle_result_choices(ck_resolve(c, result))),
    handler_fits_any_frame(
      ck_steps_of(c),
      c,
      arm,
      ck_handle_result_choices(ck_resolve(c, result)),
      ordered
    ),
    fits => c1 => o_c1 => handler_validate_after_frame(c1, arm, result, span, fits, o_c1)
  )
}

pub theorem handler_validate_unf(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan
): ck_handle_validate(
  c,
  arm,
  result,
  span
) = handler_validate_unfolded(c, arm, result, span) { Refl }
pub theorem ck_handle_validate_frame(
  c: Checker,
  arm: Ty,
  result: Ty,
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_handle_validate(c, arm, result, span)) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => CkRunFrame(c, m),
    Eq::sym(handler_validate_unf(c, arm, result, span)),
    handler_validate_unfolded_frame(c, arm, result, span, ordered)
  )
}
pub theorem ck_handle_arm_result_run_frame(
  c: Checker,
  arm: Ty,
  result: Ty,
  variable: Option(Nat),
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_handle_arm_result(c, arm, result, variable, span)) {
  ⊢ CkRunFrame(c, ck_handle_arm_result(c, arm, result, variable, span)) from match variable {
    Some(rv) => run_frame_rewrap(
      c,
      ck_handle_widen(c, arm, result, rv),
      ck_handle_widen_run_frame(c, arm, result, rv, ordered)
    )
    None => run_frame_rewrap(
      c,
      ck_handle_validate(c, arm, result, span),
      ck_handle_validate_frame(c, arm, result, span, ordered)
    )
  }
}
