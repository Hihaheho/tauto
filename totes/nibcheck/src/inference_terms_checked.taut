        o_c1
      )
    )
    SkBorrowLam(r#borrows, lam) => checked_frame_rewrap(
      c,
      ck_lambda_in(j, c, lam, r#borrows, env),
      inference_use_ck_lambda_in_checked(j, c, lam, r#borrows, env, ordered, ih)
    )
    SkOther(pat_what) => checked_frame_bind(
      <A: Unit, B: Ty>,
