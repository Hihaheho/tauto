pub theorem inference_frames(k: Nat): InferenceFrames(k) {
  ⊢ InferenceFrames(k) from match k {
    Zero => AndIntro(
      inference_zero_ck_infer_in(),
      AndIntro(
        inference_zero_ck_infer_term_in(),
        AndIntro(
          inference_zero_ck_else_in(),
          AndIntro(
            inference_zero_ck_infer_each_in(),
            AndIntro(
              inference_zero_ck_guard_in(),
              AndIntro(
                inference_zero_ck_stmt_in(),
                AndIntro(
                  inference_zero_ck_returned_in(),
                  AndIntro(
                    inference_zero_ck_check_fn_in(),
                    AndIntro(
                      inference_zero_ck_block_in(),
                      AndIntro(
                        inference_zero_ck_app_args_in(),
                        AndIntro(
                          inference_zero_ck_app_in(),
                          AndIntro(
                            inference_zero_ck_app_call_in(),
                            AndIntro(
                              inference_zero_ck_operands_in(),
                              AndIntro(
                                inference_zero_ck_clone_of_in(),
                                AndIntro(
                                  inference_zero_ck_lambda_in(),
                                  AndIntro(
                                    inference_zero_ck_record_fields_in(),
                                    AndIntro(
                                      inference_zero_ck_record_in(),
                                      AndIntro(
                                        inference_zero_ck_match_arms_in(),
                                        AndIntro(
                                          inference_zero_ck_match_expr_in(),
                                          AndIntro(
                                            inference_zero_ck_handle_in(),
                                            AndIntro(
                                              inference_zero_ck_handle_first_in(),
                                              AndIntro(
                                                inference_zero_ck_handle_result_in(),
                                                AndIntro(
                                                  inference_zero_ck_handle_arms_in(),
                                                  AndIntro(
                                                    inference_zero_ck_handle_one_in(),
                                                    AndIntro(
                                                      inference_zero_ck_handle_arm_in(),
                                                      AndIntro(
                                                        inference_zero_ck_handle_body_in(),
                                                        Trivial
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    Succ(j) => {
      let ih: InferenceFrames(j) := inference_frames(j)
      AndIntro(
        inference_successor_ck_infer_in(j, ih),
        AndIntro(
          inference_successor_ck_infer_term_in(j, ih),
          AndIntro(
            inference_successor_ck_else_in(j, ih),
            AndIntro(
              inference_successor_ck_infer_each_in(j, ih),
              AndIntro(
                inference_successor_ck_guard_in(j, ih),
                AndIntro(
                  inference_successor_ck_stmt_in(j, ih),
                  AndIntro(
                    inference_successor_ck_returned_in(j, ih),
                    AndIntro(
                      inference_successor_ck_check_fn_in(j, ih),
                      AndIntro(
                        inference_successor_ck_block_in(j, ih),
                        AndIntro(
                          inference_successor_ck_app_args_in(j, ih),
                          AndIntro(
                            inference_successor_ck_app_in(j, ih),
                            AndIntro(
                              inference_successor_ck_app_call_in(j, ih),
                              AndIntro(
                                inference_successor_ck_operands_in(j, ih),
                                AndIntro(
                                  inference_successor_ck_clone_of_in(j, ih),
                                  AndIntro(
                                    inference_successor_ck_lambda_in(j, ih),
                                    AndIntro(
                                      inference_successor_ck_record_fields_in(j, ih),
                                      AndIntro(
                                        inference_successor_ck_record_in(j, ih),
                                        AndIntro(
                                          inference_successor_ck_match_arms_in(j, ih),
                                          AndIntro(
                                            inference_successor_ck_match_expr_in(j, ih),
                                            AndIntro(
                                              inference_successor_ck_handle_in(j, ih),
                                              AndIntro(
                                                inference_successor_ck_handle_first_in(j, ih),
                                                AndIntro(
                                                  inference_successor_ck_handle_result_in(j, ih),
                                                  AndIntro(
                                                    inference_successor_ck_handle_arms_in(j, ih),
                                                    AndIntro(
                                                      inference_successor_ck_handle_one_in(j, ih),
                                                      AndIntro(
                                                        inference_successor_ck_handle_arm_in(j, ih),
                                                        AndIntro(
                                                          inference_successor_ck_handle_body_in(
                                                            j,
                                                            ih
                                                          ),
                                                          Trivial
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    }
  }
}

pub theorem ck_infer_in_frame(
  k: Nat,
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
