pub theorem inference_zero_ck_handle_arm_in(): Inference_ck_handle_arm_in(Zero) {
  c => env => result => rv => budget_ty => eff => binds => types => patterns => cont => guard => body => ordered => AndIntro(
    ordered,
    Refl
  )
}
pub theorem inference_successor_ck_handle_arm_in(
  j: Nat,
  ih: InferenceFrames(j)
): Inference_ck_handle_arm_in(Succ(j)) {
  c => env => result => rv => budget_ty => eff => binds => types => patterns => cont => guard => body => ordered => Eq::subst(
    (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
    Eq::sym(
      inference_unf_ck_handle_arm_in(
        j,
        c,
        env,
        result,
        rv,
        budget_ty,
        eff,
        binds,
        types,
        patterns,
        cont,
        guard,
        body
      )
    ),
    inference_step_ck_handle_arm_in_frame(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      ih,
      ordered
    )
  )
}
