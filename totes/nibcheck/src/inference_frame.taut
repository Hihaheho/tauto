// A single fuel induction covers the mutually recursive checker entry points.
pub theorem inference_zero_ck_infer_in(): Inference_ck_infer_in(
  Zero
) { c => term => env => ordered => AndIntro(ordered, Refl) }
pub theorem inference_successor_ck_infer_in(
  j: Nat,
  ih: InferenceFrames(j)
): Inference_ck_infer_in(Succ(j)) {
  c => term => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => CkRunFrame(c, z),
    Eq::sym(inference_unf_ck_infer_in(j, c, term, env)),
    inference_step_ck_infer_in_frame(j, c, term, env, ih, ordered)
  )
}
