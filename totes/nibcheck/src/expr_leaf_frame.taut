import "widen_frame.taut"

pub fn leaf_local_ty(l: Local): Ty { l.ty }
pub fn leaf_functions(c: Checker): Ordmap(Text, Scheme) { c.fns }
pub fn leaf_constructor_ty(d: Text, args: List(Ty), fields: List(DataField)): Ty {
  match fields: Ty { Nil => TyNamed(d, args)
    Cons(f, rest) => TyFn(field_tys(Cons(f, rest)), TyNamed(d, args), KindShared) }
}

pub fn leaf_constructor_return(
  c: Checker,
  d: Text,
  args: List(Ty),
  fields: List(DataField)
): Mut1(Ty, Checker) {
  match fields: Mut1(Ty, Checker) {
    Nil => mut1(TyNamed(d, args), c)
    Cons(f, rest) => mut1(TyFn(field_tys(Cons(f, rest)), TyNamed(d, args), KindShared), c)
  }
}
pub theorem leaf_constructor_return_frame(
  c: Checker,
  d: Text,
  args: List(Ty),
  fields: List(DataField)
): CkReadFrame(c, leaf_constructor_return(c, d, args, fields)) {
  match fields: CkReadFrame(c, leaf_constructor_return(c, d, args, fields)) { Nil => Refl
    Cons(f, rest) => Refl }
}
pub theorem ck_written_here_frame(
  c: Checker,
  t: SurfaceTerm
): CkReadFrame(c, ck_written_here(c, t)) {
  frame_rewrap(
    c,
    ck_written(c, t, type_scope(ck_type_params_of(c))),
    ck_written_frame(c, t, type_scope(ck_type_params_of(c)))
  )
}

pub fn leaf_constructor_fields(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text,
  args: List(Ty),
  fields: List(DataField)
): Mut1(Ty, Checker) {
  frame_bind(
    Unit,
    Ty,
    (ignored: Unit, c1: Checker) => leaf_constructor_return(c1, d, args, fields),
    frame_error_if(
      c,
      cat5("`", name, "` is a struct: write `", name, " { field: value }`"),
      span,
      data_is_struct(ck_datas_of(c), d)
    )
  )
}

pub theorem leaf_constructor_fields_frame(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text,
  args: List(Ty),
  fields: List(DataField)
): CkReadFrame(c, leaf_constructor_fields(c, d, idx, span, name, args, fields)) {
  frame_bind_ok(
    Unit,
    Ty,
    c,
    (ignored: Unit, c1: Checker) => leaf_constructor_return(c1, d, args, fields),
    frame_error_if(
      c,
      cat5("`", name, "` is a struct: write `", name, " { field: value }`"),
      span,
      data_is_struct(ck_datas_of(c), d)
    ),
    frame_error_if_ok(
      c,
      cat5("`", name, "` is a struct: write `", name, " { field: value }`"),
      span,
      data_is_struct(ck_datas_of(c), d)
    ),
    ignored => c1 => leaf_constructor_return_frame(c1, d, args, fields)
  )
}

pub fn leaf_constructor(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): Mut1(Ty, Checker) {
  frame_bind(
    List(Ty),
    Ty,
    (args: List(Ty), c1: Checker) => leaf_constructor_fields(
      c1,
      d,
      idx,
      span,
      name,
      args,
      datas_fields(ck_datas_of(c1), d, idx, args)
    ),
    ck_fresh_each(data_generics_of(ck_datas_of(c), d), c)
  )
}

pub theorem leaf_constructor_frame(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): CkReadFrame(c, leaf_constructor(c, d, idx, span, name)) {
  frame_bind_ok(
    List(Ty),
    Ty,
    c,
    (args: List(Ty), c1: Checker) => leaf_constructor_fields(
      c1,
      d,
      idx,
      span,
      name,
      args,
      datas_fields(ck_datas_of(c1), d, idx, args)
    ),
    ck_fresh_each(data_generics_of(ck_datas_of(c), d), c),
    ck_fresh_each_frame(data_generics_of(ck_datas_of(c), d), c),
    args => c1 => leaf_constructor_fields_frame(
      c1,
      d,
      idx,
      span,
      name,
      args,
      datas_fields(ck_datas_of(c1), d, idx, args)
    )
  )
}

pub theorem leaf_constructor_unf(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): ck_constructor_known(c, d, idx, span, name) = leaf_constructor(c, d, idx, span, name) { Refl }

pub theorem ck_constructor_known_frame(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): CkReadFrame(c, ck_constructor_known(c, d, idx, span, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_constructor_unf(c, d, idx, span, name)),
    leaf_constructor_frame(c, d, idx, span, name)
  )
}

pub theorem ck_defer_constructor_frame(
  c: Checker,
  name: Text,
  span: TySpan
): CkReadFrame(c, ck_defer_constructor(c, name, span)) { Refl }

pub fn leaf_constructor_choice(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text,
  ambiguous: Bool
): Mut1(Ty, Checker) {
  match ambiguous: Mut1(Ty, Checker) {
    true => ck_rewrap1(ck_defer_constructor(c, name, span))
    false => ck_rewrap1(ck_constructor_known(c, d, idx, span, name))
  }
}

pub theorem leaf_constructor_choice_unf(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): ck_constructor(c, d, idx, span, name) = leaf_constructor_choice(c, d, idx, span, name, datas_ctor_ambiguous(ck_datas_of(c), name)) { Refl }

pub theorem leaf_constructor_choice_frame(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text,
  ambiguous: Bool
): CkReadFrame(c, leaf_constructor_choice(c, d, idx, span, name, ambiguous)) {
  match ambiguous: CkReadFrame(c, leaf_constructor_choice(c, d, idx, span, name, ambiguous)) {
    true => frame_rewrap(
      c,
      ck_defer_constructor(c, name, span),
      ck_defer_constructor_frame(c, name, span)
    )
    false => frame_rewrap(
      c,
      ck_constructor_known(c, d, idx, span, name),
      ck_constructor_known_frame(c, d, idx, span, name)
    )
  }
}

pub theorem ck_constructor_frame(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): CkReadFrame(c, ck_constructor(c, d, idx, span, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_constructor_choice_unf(c, d, idx, span, name)),
    leaf_constructor_choice_frame(c, d, idx, span, name, datas_ctor_ambiguous(ck_datas_of(c), name))
  )
}

pub fn leaf_lookup_ctor(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Pair(Text, Nat))
): Mut1(Ty, Checker) {
  match found: Mut1(Ty, Checker) {
    None => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(name, " is not defined"), span)
    )
    Some(dc) => ck_rewrap1(
      ck_constructor(c, pattern_ctor_name(dc), pattern_ctor_index(dc), span, name)
    )
  }
}

pub theorem leaf_lookup_ctor_frame(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Pair(Text, Nat))
): CkReadFrame(c, leaf_lookup_ctor(c, name, env, span, found)) {
  match found: CkReadFrame(c, leaf_lookup_ctor(c, name, env, span, found)) {
    None => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(name, " is not defined"), span),
      ck_error_frame(c, cat2(name, " is not defined"), span),
      ignored => c1 => frame_rewrap(c1, ck_fresh(c1), ck_fresh_frame(c1))
    )
    Some(dc) => frame_rewrap(
      c,
      ck_constructor(c, pattern_ctor_name(dc), pattern_ctor_index(dc), span, name),
      ck_constructor_frame(c, pattern_ctor_name(dc), pattern_ctor_index(dc), span, name)
    )
  }
}

pub fn leaf_lookup_special(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  special: Bool
): Mut1(Ty, Checker) {
  match special: Mut1(Ty, Checker) {
    true => frame_bind(
      Ty,
      Ty,
      (i: Ty, c1: Checker) => mut1(TyFn(Cons(i, Cons(i, Nil)), i, KindShared), c1),
      ck_fresh_int(c)
    )
    false => leaf_lookup_ctor(c, name, env, span, datas_ctor(ck_datas_of(c), name))
  }
}

pub theorem leaf_lookup_special_frame(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  special: Bool
): CkReadFrame(c, leaf_lookup_special(c, name, env, span, special)) {
  match special: CkReadFrame(c, leaf_lookup_special(c, name, env, span, special)) {
    true => frame_bind_ok(
      Ty,
      Ty,
      c,
      (i: Ty, c1: Checker) => mut1(TyFn(Cons(i, Cons(i, Nil)), i, KindShared), c1),
      ck_fresh_int(c),
      ck_fresh_int_read_frame(c),
      i => c1 => Refl
    )
    false => leaf_lookup_ctor_frame(c, name, env, span, datas_ctor(ck_datas_of(c), name))
  }
}

pub fn leaf_lookup_function(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Scheme)
): Mut1(Ty, Checker) {
  match found: Mut1(Ty, Checker) {
    Some(s) => ck_rewrap1(ck_instantiate_scheme(c, name, s, span))
    None => leaf_lookup_special(
      c,
      name,
      env,
      span,
      Bool::or(Text::eq(name, "div"), Text::eq(name, "mod"))
    )
  }
}

pub theorem leaf_lookup_function_frame(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Scheme)
): CkReadFrame(c, leaf_lookup_function(c, name, env, span, found)) {
  match found: CkReadFrame(c, leaf_lookup_function(c, name, env, span, found)) {
    Some(s) => frame_rewrap(
      c,
      ck_instantiate_scheme(c, name, s, span),
      ck_instantiate_scheme_frame(c, name, s, span)
    )
    None => leaf_lookup_special_frame(
      c,
      name,
      env,
      span,
      Bool::or(Text::eq(name, "div"), Text::eq(name, "mod"))
    )
  }
}

pub fn leaf_lookup(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Local)
): Mut1(Ty, Checker) {
  match found: Mut1(Ty, Checker) {
    Some(l) => mut1(leaf_local_ty(l), c)
    None => leaf_lookup_function(
      c,
      name,
      env,
      span,
      Ordmap::get(leaf_functions(c), name, Ordmap::compare_text)
    )
  }
}

pub theorem leaf_lookup_frame(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Local)
): CkReadFrame(c, leaf_lookup(c, name, env, span, found)) {
  match found: CkReadFrame(c, leaf_lookup(c, name, env, span, found)) {
    Some(l) => Refl
    None => leaf_lookup_function_frame(
      c,
      name,
      env,
      span,
      Ordmap::get(leaf_functions(c), name, Ordmap::compare_text)
    )
  }
}

pub theorem leaf_lookup_unf(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan
): ck_lookup(c, name, env, span) = leaf_lookup(c, name, env, span, env_find(env, name)) { Refl }

pub theorem ck_lookup_frame(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan
): CkReadFrame(c, ck_lookup(c, name, env, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_lookup_unf(c, name, env, span)),
    leaf_lookup_frame(c, name, env, span, env_find(env, name))
  )
}

pub fn leaf_literal_parsed(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty,
  parsed: Option(Nat)
): Mut1(Unit, Checker) {
  match parsed: Mut1(Unit, Checker) {
    Some(v) => ck_rewrap1(pattern_literal_record(c, false, v, t, span))
    None => ck_rewrap1(ck_error(c, cat2(n, " is too large"), span))
  }
}

pub theorem leaf_literal_parsed_frame(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty,
  parsed: Option(Nat)
): CkReadFrame(c, leaf_literal_parsed(c, n, span, t, parsed)) {
  match parsed: CkReadFrame(c, leaf_literal_parsed(c, n, span, t, parsed)) {
    Some(v) => frame_rewrap(
      c,
      pattern_literal_record(c, false, v, t, span),
      pattern_literal_record_frame(c, false, v, t, span)
    )
    None => frame_rewrap(
      c,
      ck_error(c, cat2(n, " is too large"), span),
      ck_error_frame(c, cat2(n, " is too large"), span)
    )
  }
}

pub fn leaf_literal_after(c: Checker, n: Text, span: TySpan, t: Ty): Mut1(Ty, Checker) {
  frame_bind(
    Unit,
    Ty,
    (ignored: Unit, c1: Checker) => mut1(t, c1),
    leaf_literal_parsed(c, n, span, t, text_parse_u64(n))
  )
}

pub theorem leaf_literal_after_frame(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty
): CkReadFrame(c, leaf_literal_after(c, n, span, t)) {
  frame_bind_ok(
    Unit,
    Ty,
    c,
    (ignored: Unit, c1: Checker) => mut1(t, c1),
    leaf_literal_parsed(c, n, span, t, text_parse_u64(n)),
    leaf_literal_parsed_frame(c, n, span, t, text_parse_u64(n)),
    ignored => c1 => Refl
  )
}

pub fn leaf_literal(c: Checker, n: Text, span: TySpan): Mut1(Ty, Checker) {
  frame_bind(Ty, Ty, (t: Ty, c1: Checker) => leaf_literal_after(c1, n, span, t), ck_fresh_int(c))
}

pub theorem leaf_literal_frame(
  c: Checker,
  n: Text,
  span: TySpan
): CkReadFrame(c, leaf_literal(c, n, span)) {
  frame_bind_ok(
    Ty,
    Ty,
    c,
    (t: Ty, c1: Checker) => leaf_literal_after(c1, n, span, t),
    ck_fresh_int(c),
    ck_fresh_int_read_frame(c),
    t => c1 => leaf_literal_after_frame(c1, n, span, t)
  )
}

pub theorem leaf_literal_unf(
  c: Checker,
  n: Text,
  span: TySpan
): ck_nat_literal(c, n, span) = leaf_literal(c, n, span) { Refl }

pub theorem ck_nat_literal_frame(
  c: Checker,
  n: Text,
  span: TySpan
): CkReadFrame(c, ck_nat_literal(c, n, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(leaf_literal_unf(c, n, span)),
    leaf_literal_frame(c, n, span)
  )
}

pub fn leaf_stmt_ty(
  c: Checker,
  v: Ty,
  value: SurfaceTerm,
  name: Text,
  ty: Option(SurfaceTerm)
): Mut1(Ty, Checker) {
  match ty: Mut1(Ty, Checker) {
    None => mut1(v, c)
    Some(tt) => frame_bind(
      Ty,
      Ty,
      (w: Ty, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (ignored: Unit, c2: Checker) => mut1(w, c2),
        ck_expect(c1, v, w, span_of(value), cat3("`", name, "`"))
      ),
      ck_written_here(c, tt)
    )
  }
}

pub theorem leaf_stmt_ty_frame(
  c: Checker,
  v: Ty,
  value: SurfaceTerm,
  name: Text,
  ty: Option(SurfaceTerm),
  ordered: CkOrdered(c)
): CkRunFrame(c, leaf_stmt_ty(c, v, value, name, ty)) {
  match ty: CkRunFrame(c, leaf_stmt_ty(c, v, value, name, ty)) {
    None => run_frame_return(c, v, ordered)
    Some(tt) => run_frame_bind(
      Ty,
      Ty,
      c,
      (w: Ty, c1: Checker) => frame_bind(
        Unit,
        Ty,
        (ignored: Unit, c2: Checker) => mut1(w, c2),
        ck_expect(c1, v, w, span_of(value), cat3("`", name, "`"))
      ),
      ck_written_here(c, tt),
      run_frame_read(c, ck_written_here(c, tt), ck_written_here_frame(c, tt), ordered),
      w => c1 => o_c1 => run_frame_bind(
        Unit,
        Ty,
        c1,
        (ignored: Unit, c2: Checker) => mut1(w, c2),
        ck_expect(c1, v, w, span_of(value), cat3("`", name, "`")),
        ck_expect_run_frame(c1, v, w, span_of(value), cat3("`", name, "`"), o_c1),
        ignored => c2 => o_c2 => run_frame_return(c2, w, o_c2)
      )
    )
  }
}

pub theorem leaf_stmt_ty_unf(
  c: Checker,
  ty: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  name: Text
): ck_stmt_ty(c, ty, v, value, name) = leaf_stmt_ty(c, v, value, name, ty) { match ty: ck_stmt_ty(c, ty, v, value, name) = leaf_stmt_ty(c, v, value, name, ty) { None => Refl
    Some(tt) => Refl } }

pub theorem ck_stmt_ty_run_frame(
  c: Checker,
  ty: Option(SurfaceTerm),
  v: Ty,
  value: SurfaceTerm,
  name: Text,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_stmt_ty(c, ty, v, value, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkRunFrame(c, z),
    Eq::sym(leaf_stmt_ty_unf(c, ty, v, value, name)),
    leaf_stmt_ty_frame(c, v, value, name, ty, ordered)
  )
}
