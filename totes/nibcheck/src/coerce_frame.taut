import "coerce_sound.taut"
import "checker.taut"
import "checker_frame.taut"
import "datas_frame.taut"
import "infer_parts.taut"
import "ty.taut"
import "unify_sound.taut"
import "../../surface/src/surface.taut"
import std::text

// The frames of the checker's `coerce` readings at a `match` scrutinee and at
// an assignment to a field: each only reads, reports, and grows the
// substitution as `ck_coerce_fit` does.

pub fn scrutinee_report_model(c: Checker, s: Ty, want: Ty, found: Option(CoerceFound), span: TySpan): Mut1(Ty, Checker) {
  frame_bind(
    <A: Unit, B: Ty>,
    (ignored: Unit, c1: Checker) => mut1(coerce_scrutinee_ty(s, want, found), c1),
    frame_error_if(c, coerce_scrutinee_refusal(c, found), span, coerce_scrutinee_refused(c, found))
  )
}

pub theorem scrutinee_report_unf(
  c: Checker,
  s: Ty,
  want: Ty,
  found: Option(CoerceFound),
  span: TySpan
): ck_coerce_scrutinee_report(c, s, want, found, span) = scrutinee_report_model(c, s, want, found, span) { Refl }

pub fn scrutinee_with(c: Checker, s: Ty, span: TySpan, target: Option(Ty)): Mut1(Ty, Checker) {
  match target {
    None => mut1(s, c)
    Some(want) => frame_bind(
      <A: Option(CoerceFound), B: Ty>,
      (found: Option(CoerceFound), c1: Checker) => ck_rewrap1(ck_coerce_scrutinee_report(c1, s, want, found, span)),
      ck_coerce_fit(c, ck_resolve(c, s), want)
    )
  }
}

pub theorem scrutinee_unf(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): ck_coerce_scrutinee(c, s, arms, span) = scrutinee_with(c, s, span, coerce_scrutinee_target(c, s, arms)) { Refl }

pub fn assign_place_model(c: Checker, env: List(Local), place: Option(SurfaceTerm)): Mut1(Unit, Checker) {
  frame_error_if(
    c,
    option_text_or_empty(coerce_assign_place_message(c, env, place)),
    coerce_assign_span(place),
    option_text_some(coerce_assign_place_message(c, env, place))
  )
}

pub theorem assign_place_unf(
  c: Checker,
  env: List(Local),
  place: Option(SurfaceTerm)
): ck_coerce_assign_place(c, env, place) = assign_place_model(c, env, place) { Refl }

pub theorem ck_coerce_scrutinee_report_frame_run(
  c: Checker,
  s: Ty,
  want: Ty,
  found: Option(CoerceFound),
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_coerce_scrutinee_report(c, s, want, found, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkRunFrame(c, z),
    Eq::sym(scrutinee_report_unf(c, s, want, found, span)),
    run_frame_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(coerce_scrutinee_ty(s, want, found), c1),
      frame_error_if(c, coerce_scrutinee_refusal(c, found), span, coerce_scrutinee_refused(c, found)),
      run_frame_read(
      c,
      frame_error_if(c, coerce_scrutinee_refusal(c, found), span, coerce_scrutinee_refused(c, found)),
      frame_error_if_ok(c, coerce_scrutinee_refusal(c, found), span, coerce_scrutinee_refused(c, found)),
      ordered
    ),
      ignored => c1 => o1 => run_frame_return(c1, coerce_scrutinee_ty(s, want, found), o1)
    )
  )
}

pub theorem scrutinee_with_frame_run(
  c: Checker,
  s: Ty,
  span: TySpan,
  target: Option(Ty),
  ordered: CkOrdered(c)
): CkRunFrame(c, scrutinee_with(c, s, span, target)) {
  match target {
    None => run_frame_return(c, s, ordered)
    Some(want) => run_frame_bind(
      <A: Option(CoerceFound), B: Ty>,
      c,
      (found: Option(CoerceFound), c1: Checker) => ck_rewrap1(ck_coerce_scrutinee_report(c1, s, want, found, span)),
      ck_coerce_fit(c, ck_resolve(c, s), want),
      run_frame_grows(c, ck_coerce_fit(c, ck_resolve(c, s), want), ck_coerce_fit_grows(c, ck_resolve(c, s), want, ordered)),
      found => c1 => o1 => Eq::subst(
        (z: Mut1(Ty, Checker)) => CkRunFrame(c1, z),
        Eq::sym(ck_rewrap1_id(ck_coerce_scrutinee_report(c1, s, want, found, span))),
        ck_coerce_scrutinee_report_frame_run(c1, s, want, found, span, o1)
      )
    )
  }
}

pub theorem ck_coerce_scrutinee_frame_run(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan,
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_coerce_scrutinee(c, s, arms, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkRunFrame(c, z),
    Eq::sym(scrutinee_unf(c, s, arms, span)),
    scrutinee_with_frame_run(c, s, span, coerce_scrutinee_target(c, s, arms), ordered)
  )
}

pub theorem ck_coerce_assign_place_frame_run(
  c: Checker,
  env: List(Local),
  place: Option(SurfaceTerm),
  ordered: CkOrdered(c)
): CkRunFrame(c, ck_coerce_assign_place(c, env, place)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkRunFrame(c, z),
    Eq::sym(assign_place_unf(c, env, place)),
    run_frame_read(
      c,
      assign_place_model(c, env, place),
      frame_error_if_ok(c, option_text_or_empty(coerce_assign_place_message(c, env, place)), coerce_assign_span(place), option_text_some(coerce_assign_place_message(c, env, place))),
      ordered
    )
  )
}
