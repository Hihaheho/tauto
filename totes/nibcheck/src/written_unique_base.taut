import "written_value_base.taut"
import std::map
import std::text
import "datas.taut"
import "rules_written.taut"
import "ty.taut"
import "../../surface/src/surface.taut"
import "../../identity/src/identity.taut"

// These predicates quantify over the declaration environment as well: it may
// reject a type expression, but cannot change its successfully elaborated value.
pub def WrittenTermUnique(
  generics: Ordmap(Text, Ty),
  partial: Bool,
  r#borrow: Bool,
  term: SurfaceTerm,
  t: Ty
): Prop := ∀ env: Datas. ∀ other: Ty. ∀ meaning: WrittenTerm(
  env,
  generics,
  partial,
  r#borrow,
  term,
  other
). t = other
pub def WrittenKindUnique(
  generics: Ordmap(Text, Ty),
  partial: Bool,
  r#borrow: Bool,
  kind: SurfaceKind,
  t: Ty
): Prop := ∀ env: Datas. ∀ other: Ty. ∀ meaning: WrittenKind(
  env,
  generics,
  partial,
  r#borrow,
  kind,
  other
). t = other
pub def WrittenTermsUnique(
  generics: Ordmap(Text, Ty),
  partial: Bool,
  terms: List(SurfaceTerm),
  types: List(Ty)
): Prop := ∀ env: Datas. ∀ others: List(
  Ty
). ∀ meaning: WrittenTerms(env, generics, partial, terms, others). types = others
pub def WrittenParametersUnique(
  generics: Ordmap(Text, Ty),
  partial: Bool,
  params: List(SurfaceParam),
  types: List(Ty)
): Prop := ∀ env: Datas. ∀ others: List(
  Ty
). ∀ meaning: WrittenParameters(env, generics, partial, params, others). types = others

pub theorem written_unique_term<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, sk: SurfaceKind, start: Nat, end: Nat, other: Ty>(
  ast_occurrence: Option(TermOccurrence),
  meaning: WrittenTerm(
    env,
    generics,
    partial,
    r#borrow,
    SurfaceTermIndexedMk(sk, start, end, ast_occurrence),
    other
  ),
  t: Ty,
  ih: WrittenKindUnique(generics, partial, r#borrow, sk, t)
): t = other {
  match meaning {
    Mk(ctor_ast_occurrence, gs, Mode, borrowing, kind, value, begin, finish, inner) => ih(
      env,
      value,
      inner
    )
  }
}
pub theorem written_unique_name<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, name: SurfaceName, other: Ty>(
  meaning: WrittenKind(env, generics, partial, r#borrow, SkVar(name), other),
  first_env: Datas,
  t: Ty,
  not_star: (surface_name_text(name) = "std::prelude::Star") -> False,
  first: WrittenNameType(first_env, generics, surface_name_text(name), partial, t)
): t = other {
  match meaning {
    WrittenKindName(gs, Mode, borrowing, spelling, value, NotStar, Named) => Eq::trans(
      Eq::sym(written_name_mode_value(first)),
      written_name_mode_value(Named)
    )
    WrittenKindUnit(gs, Mode, borrowing) => False::elim(not_star(Refl))
  }
}
pub theorem written_unique_row<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, es: List(RowEntry), other: Ty>(
  meaning: WrittenKind(env, generics, partial, r#borrow, SkRow(es), other)
): TyUnit = other {
  match meaning {
    WrittenKindRow(gs, Mode, borrowing, row) => Refl
  }
}
pub theorem written_unique_unit<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, other: Ty>(
  meaning: WrittenKind(env, generics, partial, r#borrow, SkVar(NameSpelled("std::prelude::Star")), other)
): TyUnit = other {
  match meaning {
    WrittenKindUnit(gs, Mode, borrowing) => Refl
    WrittenKindName(gs, Mode, borrowing, spelling, value, NotStar, Named) => False::elim(NotStar(Refl))
  }
}
