import "ty_eq.taut"
import std::Row
import std::Map
import std::MapText
import std::Text
import "ty.taut"

// `ty_union` keeps exactly the leaves of what it joins
// (`docs/design/self-host.md`「層 1：合併とタグ（`src/union_sound.taut`）」):
// read as a set, the members of `ty_union(ts)` are the leaves of `ts`, and
// each member is a leaf (not a union, not `Never`).

// A leaf is any type but a union or `Never`.
pub fn ty_plain(t: Ty): Bool {
  ⊢ Bool from match t {
    TyUnion(ts) => false
    TyNever => false
    _ => true
  }
}

pub def Plain(t: Ty): Prop := ty_plain(t) = true

// `t` is a leaf of the list: one of its members, or a leaf of a union in it.
pub(open) inductive Leaves(t: Ty): (List(Ty)) -> Prop {
  LvHere(rest: List(Ty), p: Plain(t)): Leaves(t, Cons(t, rest))
  LvIn(ys: List(Ty), rest: List(Ty), l: Leaves(t, ys)): Leaves(t, Cons(TyUnion(ys), rest))
  LvThere(y: Ty, rest: List(Ty), l: Leaves(t, rest)): Leaves(t, Cons(y, rest))
}

// The members of a type read as a union: a union's own list, none for
// `Never`, the type itself otherwise.
pub fn ty_members(u: Ty): List(Ty) {
  ⊢ List(Ty) from match u {
    TyUnion(ys) => ys
    TyNever => Nil
    _ => Cons(u, Nil)
  }
}

pub def AllPlain(ms: List(Ty)): Prop := ∀ z: Ty. (Mem(Ty, z, ms)) -> Plain(z)

pub theorem mem_cons_inv<A: Type, e: A>(
  h: A,
  t: List(A),
  m: Mem(A, e, Cons(h, t))
): Or(e = h, Mem(A, e, t)) {
  ⊢ Or(e = h, Mem(A, e, t)) from match m {
    MemHere(t2) => OrInl(Refl)
    MemThere(b, t2, m2) => OrInr(m2)
  }
}

pub theorem mem_of_eq<A: Type>(e: A, h: A, t: List(A), q: e = h): Mem(A, e, Cons(h, t)) {
  Eq::subst((z: A) => Mem(A, z, Cons(h, t)), Eq::sym(q), MemHere(A, h, t))
}

pub fn ins_k(t: Ty, m: Ty, rest: List(Ty), o: Ordering): List(Ty) {
  ⊢ List(Ty) from match o {
    Less => Cons(t, Cons(m, rest))
    Equal => Cons(m, rest)
    Greater => Cons(m, members_insert(rest, t))
  }
}

pub theorem ins_unf(
  t: Ty,
  m: Ty,
  rest: List(Ty)
): members_insert(Cons(m, rest), t) = ins_k(t, m, rest, ty_compare(t, m)) {
  Refl
}

pub theorem insk_mem(
  o: Ordering,
  e: Ty,
  t: Ty,
  h: Ty,
  rest: List(Ty),
  ih: (Mem(Ty, e, members_insert(rest, t))) -> Or(e = t, Mem(Ty, e, rest)),
  m: Mem(Ty, e, ins_k(t, h, rest, o))
): Or(e = t, Mem(Ty, e, Cons(h, rest))) {
  ⊢ Or(e = t, Mem(Ty, e, Cons(h, rest))) from match o {
    Less => mem_cons_inv(t, Cons(h, rest), m)
    Equal => OrInr(m)
    Greater => Or::elim(
      mem_cons_inv(h, members_insert(rest, t), m),
      q => OrInr(mem_of_eq(e, h, rest, q)),
      k => Or::elim(ih(k), q => OrInl(q), k2 => OrInr(MemThere(Ty, e, h, rest, k2)))
    )
  }
}

// A member after inserting `t` is `t` or was there before.
pub theorem insert_mem(
  e: Ty,
  ms: List(Ty),
  t: Ty,
  m: Mem(Ty, e, members_insert(ms, t))
): Or(e = t, Mem(Ty, e, ms)) {
  ⊢ Or(e = t, Mem(Ty, e, ms)) from match ms {
    Nil => Or::elim(
      mem_cons_inv(t, Nil(Ty), m),
      q => OrInl(q),
      k => Mem::nil(Or(e = t, Mem(Ty, e, Nil(Ty))), k)
    )
    Cons(h, rest) => insk_mem(
      ty_compare(t, h),
      e,
      t,
      h,
      rest,
      k => insert_mem(e, rest, t, k),
      Eq::subst((z: List(Ty)) => Mem(Ty, e, z), ins_unf(t, h, rest), m)
    )
  }
}

pub theorem insk_has(
  o: Ordering,
  t: Ty,
  h: Ty,
  rest: List(Ty),
  eo: ty_compare(t, h) = o,
  ih: Mem(Ty, t, members_insert(rest, t))
): Mem(Ty, t, ins_k(t, h, rest, o)) {
  ⊢ Mem(Ty, t, ins_k(t, h, rest, o)) from match o {
    Less => MemHere(Ty, t, Cons(h, rest))
    Equal => mem_of_eq(t, h, rest, ty_compare_eq(t, h, eo))
    Greater => MemThere(Ty, t, h, members_insert(rest, t), ih)
  }
}

// `t` is a member after inserting it.
pub theorem insert_has(t: Ty, ms: List(Ty)): Mem(Ty, t, members_insert(ms, t)) {
  ⊢ Mem(Ty, t, members_insert(ms, t)) from match ms {
    Nil => MemHere(Ty, t, Nil(Ty))
    Cons(h, rest) => Eq::subst(
      (z: List(Ty)) => Mem(Ty, t, z),
      Eq::sym(ins_unf(t, h, rest)),
      insk_has(ty_compare(t, h), t, h, rest, Refl, insert_has(t, rest))
    )
  }
}

pub theorem insk_keep(
  o: Ordering,
  e: Ty,
  t: Ty,
  h: Ty,
  rest: List(Ty),
  ih: (Mem(Ty, e, rest)) -> Mem(Ty, e, members_insert(rest, t)),
  m: Mem(Ty, e, Cons(h, rest))
): Mem(Ty, e, ins_k(t, h, rest, o)) {
  ⊢ Mem(Ty, e, ins_k(t, h, rest, o)) from match o {
    Less => MemThere(Ty, e, t, Cons(h, rest), m)
    Equal => m
    Greater => Or::elim(
      mem_cons_inv(h, rest, m),
      q => mem_of_eq(e, h, members_insert(rest, t), q),
      k => MemThere(Ty, e, h, members_insert(rest, t), ih(k))
    )
  }
}

pub theorem insert_keep(
  e: Ty,
  ms: List(Ty),
  t: Ty,
  m: Mem(Ty, e, ms)
): Mem(Ty, e, members_insert(ms, t)) {
  ⊢ Mem(Ty, e, members_insert(ms, t)) from match ms {
    Nil => Mem::nil(Mem(Ty, e, members_insert(Nil(Ty), t)), m)
    Cons(h, rest) => Eq::subst(
      (z: List(Ty)) => Mem(Ty, e, z),
      Eq::sym(ins_unf(t, h, rest)),
      insk_keep(ty_compare(t, h), e, t, h, rest, k => insert_keep(e, rest, t, k), m)
    )
  }
}

pub theorem leaf_of_eq(
  e: Ty,
  w: Ty,
  rest: List(Ty),
  q: e = w,
  p: Plain(w)
): Leaves(e, Cons(w, rest)) {
  Eq::subst((z: Ty) => Leaves(z, Cons(w, rest)), Eq::sym(q), LvHere(w, rest, p))
}

mutual {
  // A member after adding `ts` is a leaf of `ts` or was there before.
  pub theorem add_mem(
    e: Ty,
    ts: List(Ty),
    ms: List(Ty),
    m: Mem(Ty, e, members_add(ts, ms))
  ): Or(Leaves(e, ts), Mem(Ty, e, ms)) {
    ⊢ Or(Leaves(e, ts), Mem(Ty, e, ms)) from match ts {
      Nil => OrInr(m)
      Cons(x, rest) => Or::elim(
        add_mem(e, rest, members_add_one(x, x, ms), m),
        l => OrInl(LvThere(e, x, rest, l)),
        k => one_mem(e, x, x, Refl, rest, ms, k)
      )
    }
  }

  pub theorem one_mem(
    e: Ty,
    x: Ty,
    w: Ty,
    ew: x = w,
    rest: List(Ty),
    ms: List(Ty),
    k: Mem(Ty, e, members_add_one(x, w, ms))
  ): Or(Leaves(e, Cons(x, rest)), Mem(Ty, e, ms)) {
    ⊢ Or(Leaves(e, Cons(x, rest)), Mem(Ty, e, ms)) from match x {
      TyUnion(inner) => Or::elim(
        add_mem(e, inner, ms, k),
        l => OrInl(LvIn(e, inner, rest, l)),
        m2 => OrInr(m2)
      )
      TyNever => OrInr(k)
      _ => Or::elim(
        insert_mem(e, ms, w, k),
        q => OrInl(
          Eq::subst(
            (z: Ty) => Leaves(e, Cons(z, rest)),
            Eq::sym(ew),
            leaf_of_eq(e, w, rest, q, Eq::subst((z: Ty) => Plain(z), ew, Refl))
          )
        ),
        m2 => OrInr(m2)
      )
    }
  }
}

mutual {
  pub theorem add_keep(
    e: Ty,
    ts: List(Ty),
    ms: List(Ty),
    m: Mem(Ty, e, ms)
  ): Mem(Ty, e, members_add(ts, ms)) {
    ⊢ Mem(Ty, e, members_add(ts, ms)) from match ts {
      Nil => m
      Cons(x, rest) => add_keep(e, rest, members_add_one(x, x, ms), one_keep(e, x, x, ms, m))
    }
  }

  pub theorem one_keep(
    e: Ty,
    x: Ty,
    w: Ty,
    ms: List(Ty),
    m: Mem(Ty, e, ms)
  ): Mem(Ty, e, members_add_one(x, w, ms)) {
    ⊢ Mem(Ty, e, members_add_one(x, w, ms)) from match x {
      TyUnion(inner) => add_keep(e, inner, ms, m)
      TyNever => m
      _ => insert_keep(e, ms, w, m)
    }
  }
}

pub theorem one_has(
  x: Ty,
  w: Ty,
  ms: List(Ty),
  p: Plain(x)
): Mem(Ty, w, members_add_one(x, w, ms)) {
  ⊢ Mem(Ty, w, members_add_one(x, w, ms)) from match x {
    TyUnion(inner) => False::elim(false_ne_true(p))
    TyNever => False::elim(false_ne_true(p))
    _ => insert_has(w, ms)
  }
}

// Every leaf of `ts` is a member after adding `ts`.
pub theorem add_has<e: Ty, ts: List(
  Ty
)>(l: Leaves(e, ts), ms: List(Ty)): Mem(Ty, e, members_add(ts, ms)) {
  ⊢ Mem(Ty, e, members_add(ts, ms)) from match l {
    LvHere(rest, p) => add_keep(e, rest, members_add_one(e, e, ms), one_has(e, e, ms, p))
    LvIn(ys, rest, l2) => add_keep(e, rest, members_add(ys, ms), add_has(l2, ms))
    LvThere(y, rest, l2) => add_has(l2, members_add_one(y, y, ms))
  }
}

pub theorem leaves_plain(e: Ty, ts: List(Ty), l: Leaves(e, ts)): Plain(e) {
  ⊢ Plain(e) from match l {
    LvHere(rest, p) => p
    LvIn(ys, rest, l2) => leaves_plain(e, ys, l2)
    LvThere(y, rest, l2) => leaves_plain(e, rest, l2)
  }
}

pub theorem added_plain(ts: List(Ty)): AllPlain(members_add(ts, Nil(Ty))) {
  z => m => Or::elim(
    add_mem(z, ts, Nil(Ty), m),
    l => leaves_plain(z, ts, l),
    k => Mem::nil(Plain(z), k)
  )
}

pub theorem plain_members(x: Ty, p: Plain(x)): ty_members(x) = Cons(x, Nil(Ty)) {
  ⊢ ty_members(x) = Cons(x, Nil(Ty)) from match x {
    TyUnion(ys) => False::elim(false_ne_true(p))
    TyNever => False::elim(false_ne_true(p))
    _ => Refl
  }
}

// Wrapping leaves as one type and reading them back gives the same list.
pub theorem members_of(ms: List(Ty), ap: AllPlain(ms)): (ty_members(ty_union_of(ms)) = ms) {
  ⊢ (ty_members(ty_union_of(ms)) = ms) from match ms {
    Nil => Refl
    Cons(only, rest) => ⊢ ty_members(ty_union_of(Cons(only, rest))) = Cons(only, rest) from match rest {
      Nil => plain_members(only, ap(only, MemHere(Ty, only, Nil(Ty))))
      Cons(second, more) => Refl
    }
  }
}

pub theorem union_members(ts: List(Ty)): ty_members(ty_union(ts)) = members_add(ts, Nil(Ty)) {
  members_of(members_add(ts, Nil(Ty)), added_plain(ts))
}

// The members of `ty_union(ts)` are leaves of `ts`, and leaves themselves.
pub theorem union_mem(
  e: Ty,
  ts: List(Ty),
  m: Mem(Ty, e, ty_members(ty_union(ts)))
): And(Leaves(e, ts), Plain(e)) {
  Or::elim(
    add_mem(e, ts, Nil(Ty), Eq::subst((z: List(Ty)) => Mem(Ty, e, z), union_members(ts), m)),
    l => AndIntro(l, leaves_plain(e, ts, l)),
    k => Mem::nil(And(Leaves(e, ts), Plain(e)), k)
  )
}

// Every leaf of `ts` is a member of `ty_union(ts)`.
pub theorem union_has(e: Ty, ts: List(Ty), l: Leaves(e, ts)): Mem(Ty, e, ty_members(ty_union(ts))) {
  Eq::subst((z: List(Ty)) => Mem(Ty, e, z), Eq::sym(union_members(ts)), add_has(l, Nil(Ty)))
}

pub fn tins_k(tag: Text, t: Text, rest: List(Text), o: Ordering): List(Text) {
  ⊢ List(Text) from match o {
    Less => Cons(tag, Cons(t, rest))
    Equal => Cons(t, rest)
    Greater => Cons(t, tags_insert(rest, tag))
  }
}

pub theorem tins_unf(
  tag: Text,
  t: Text,
  rest: List(Text)
): tags_insert(Cons(t, rest), tag) = tins_k(tag, t, rest, Ordmap::compare_text(tag, t)) {
  Refl
}

pub theorem tinsk_mem(
  o: Ordering,
  e: Text,
  g: Text,
  h: Text,
  rest: List(Text),
  ih: (Mem(Text, e, tags_insert(rest, g))) -> Or(e = g, Mem(Text, e, rest)),
  m: Mem(Text, e, tins_k(g, h, rest, o))
): Or(e = g, Mem(Text, e, Cons(h, rest))) {
  ⊢ Or(e = g, Mem(Text, e, Cons(h, rest))) from match o {
    Less => mem_cons_inv(g, Cons(h, rest), m)
    Equal => OrInr(m)
    Greater => Or::elim(
      mem_cons_inv(h, tags_insert(rest, g), m),
      q => OrInr(mem_of_eq(e, h, rest, q)),
      k => Or::elim(ih(k), q => OrInl(q), k2 => OrInr(MemThere(Text, e, h, rest, k2)))
    )
  }
}

pub theorem tags_insert_mem(
  e: Text,
  ts: List(Text),
  g: Text,
  m: Mem(Text, e, tags_insert(ts, g))
): Or(e = g, Mem(Text, e, ts)) {
  ⊢ Or(e = g, Mem(Text, e, ts)) from match ts {
    Nil => Or::elim(
      mem_cons_inv(g, Nil(Text), m),
      q => OrInl(q),
      k => Mem::nil(Or(e = g, Mem(Text, e, Nil(Text))), k)
    )
    Cons(h, rest) => tinsk_mem(
      Ordmap::compare_text(g, h),
      e,
      g,
      h,
      rest,
      k => tags_insert_mem(e, rest, g, k),
      Eq::subst((z: List(Text)) => Mem(Text, e, z), tins_unf(g, h, rest), m)
    )
  }
}

pub theorem tinsk_has(
  o: Ordering,
  g: Text,
  h: Text,
  rest: List(Text),
  eo: Ordmap::compare_text(g, h) = o,
  ih: Mem(Text, g, tags_insert(rest, g))
): Mem(Text, g, tins_k(g, h, rest, o)) {
  ⊢ Mem(Text, g, tins_k(g, h, rest, o)) from match o {
    Less => MemHere(Text, g, Cons(h, rest))
    Equal => mem_of_eq(g, h, rest, Ordmap::compare_text_eq(g, h, eo))
    Greater => MemThere(Text, g, h, tags_insert(rest, g), ih)
  }
}

pub theorem tags_insert_has(g: Text, ts: List(Text)): Mem(Text, g, tags_insert(ts, g)) {
  ⊢ Mem(Text, g, tags_insert(ts, g)) from match ts {
    Nil => MemHere(Text, g, Nil(Text))
    Cons(h, rest) => Eq::subst(
      (z: List(Text)) => Mem(Text, g, z),
      Eq::sym(tins_unf(g, h, rest)),
      tinsk_has(Ordmap::compare_text(g, h), g, h, rest, Refl, tags_insert_has(g, rest))
    )
  }
}

pub theorem tinsk_keep(
  o: Ordering,
  e: Text,
  g: Text,
  h: Text,
  rest: List(Text),
  ih: (Mem(Text, e, rest)) -> Mem(Text, e, tags_insert(rest, g)),
  m: Mem(Text, e, Cons(h, rest))
): Mem(Text, e, tins_k(g, h, rest, o)) {
  ⊢ Mem(Text, e, tins_k(g, h, rest, o)) from match o {
    Less => MemThere(Text, e, g, Cons(h, rest), m)
    Equal => m
    Greater => Or::elim(
      mem_cons_inv(h, rest, m),
      q => mem_of_eq(e, h, tags_insert(rest, g), q),
      k => MemThere(Text, e, h, tags_insert(rest, g), ih(k))
    )
  }
}

pub theorem tags_insert_keep(
  e: Text,
  ts: List(Text),
  g: Text,
  m: Mem(Text, e, ts)
): Mem(Text, e, tags_insert(ts, g)) {
  ⊢ Mem(Text, e, tags_insert(ts, g)) from match ts {
    Nil => Mem::nil(Mem(Text, e, tags_insert(Nil(Text), g)), m)
    Cons(h, rest) => Eq::subst(
      (z: List(Text)) => Mem(Text, e, z),
      Eq::sym(tins_unf(g, h, rest)),
      tinsk_keep(Ordmap::compare_text(g, h), e, g, h, rest, k => tags_insert_keep(e, rest, g, k), m)
    )
  }
}

// A tag of `tags_union_into(b, a)` is in `b` or in `a`.
pub theorem tags_into_mem(
  e: Text,
  b: List(Text),
  a: List(Text),
  m: Mem(Text, e, tags_union_into(b, a))
): Or(Mem(Text, e, b), Mem(Text, e, a)) {
  ⊢ Or(Mem(Text, e, b), Mem(Text, e, a)) from match b {
    Nil => OrInr(m)
    Cons(t, rest) => Or::elim(
      tags_into_mem(e, rest, tags_insert(a, t), m),
      k => OrInl(MemThere(Text, e, t, rest, k)),
      k => Or::elim(
        tags_insert_mem(e, a, t, k),
        q => OrInl(mem_of_eq(e, t, rest, q)),
        k2 => OrInr(k2)
      )
    )
  }
}

pub theorem tags_into_keep(
  e: Text,
  b: List(Text),
  a: List(Text),
  m: Mem(Text, e, a)
): Mem(Text, e, tags_union_into(b, a)) {
  ⊢ Mem(Text, e, tags_union_into(b, a)) from match b {
    Nil => m
    Cons(t, rest) => tags_into_keep(e, rest, tags_insert(a, t), tags_insert_keep(e, a, t, m))
  }
}

pub theorem tags_into_has<e: Text, b: List(
  Text
)>(m: Mem(Text, e, b), a: List(Text)): Mem(Text, e, tags_union_into(b, a)) {
  ⊢ Mem(Text, e, tags_union_into(b, a)) from match m {
    MemHere(rest) => tags_into_keep(e, rest, tags_insert(a, e), tags_insert_has(e, a))
    MemThere(t, rest, m2) => tags_into_has(m2, tags_insert(a, t))
  }
}

// The tags of `tags_union(a, b)` are those of `a` and those of `b`.
pub theorem tags_union_mem(
  e: Text,
  a: List(Text),
  b: List(Text),
  m: Mem(Text, e, tags_union(a, b))
): Or(Mem(Text, e, a), Mem(Text, e, b)) {
  Or::elim(tags_into_mem(e, b, a, m), k => OrInr(k), k => OrInl(k))
}

pub theorem tags_union_left(
  e: Text,
  a: List(Text),
  b: List(Text),
  m: Mem(Text, e, a)
): Mem(Text, e, tags_union(a, b)) {
  tags_into_keep(e, b, a, m)
}

pub theorem tags_union_right(
  e: Text,
  a: List(Text),
  b: List(Text),
  m: Mem(Text, e, b)
): Mem(Text, e, tags_union(a, b)) {
  tags_into_has(m, a)
}

pub fn ty_tags(t: Ty): List(Text) {
  ⊢ List(Text) from match t {
    TyTagged(tags, x) => tags
    _ => Nil
  }
}

pub fn ty_untagged(t: Ty): Ty {
  ⊢ Ty from match t {
    TyTagged(tags, x) => x
    _ => t
  }
}

// Tagging a type merges the new tags with the type's own, around what is
// under them.
pub theorem tagged_shape(
  tags: List(Text),
  t: Ty
): ty_tagged(tags, t) = ty_tagged_with(tags_union(tags, ty_tags(t)), ty_untagged(t)) {
  ⊢ ty_tagged(tags, t) = ty_tagged_with(tags_union(tags, ty_tags(t)), ty_untagged(t)) from match t {
    TyTagged(inner, x) => Refl
    _ => Refl
  }
}
