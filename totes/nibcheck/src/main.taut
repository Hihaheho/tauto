// With `--rows PRELUDE`, `--types PRELUDE` or `--lin PRELUDE`: prints `== <path>`
// and the report of the rows (the types, the use check) of each file given after it, or `error` (the
// differential test's input, `docs/design/self-host.md`). PRELUDE is the file of
// the standard library.

// `expanded` is the prelude with its indexed effects expanded
// (`types/indices.rs`), which the types and the use check read.
pub fn nibcheck_report(
  once: NibcheckShared,
  mode: NibcheckMode,
  prelude: List(SurfaceStmt),
  expanded: List(SurfaceStmt),
  source: List(SurfaceStmt),
  resolved: ModResolved,
  derived: ModResolved,
  sealed: List(Text × Text)
): Text {
  match mode {
    NibcheckRows => nibcheck_rows(once, prelude, source, resolved)
    NibcheckTypes => nibcheck_types(expanded, source, resolved, derived.stmts, sealed)
    NibcheckLin => nibcheck_lin(once, source, resolved, derived)
  }
}

pub fn nibcheck_each(
  once: NibcheckShared,
  t: &SyntaxTables,
  classes: UnicodeClasses,
  prelude: List(SurfaceStmt),
  expanded: List(SurfaceStmt),
  source: List(SurfaceStmt),
  mode: NibcheckMode,
  sealed: List(Text × Text),
  paths: List(Text)
): Unit ! {div, fs_read, overflow, stdout} {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match nibcheck_read_text(t, classes, path, 0) {
        None => print(Text::concat_all(Cons("error", Cons(text_newline(), Nil))))
        Some(read) => {
          let plain := modules_resolve(read.snd)
          print(nibcheck_report(once, mode, prelude, expanded, source, plain, debug_program(t, classes, read.snd, read.fst, plain), sealed))
        }
      }
      nibcheck_each(once, t, classes, prelude, expanded, source, mode, sealed, rest)
    }
  }
}

// The files read as one program: their statements in the order given, so a
// name one file declares is defined in the others (`--program`).
// `--program` before the prelude reads the files as one program.
pub fn nibcheck_is_whole(args: List(Text)): Bool {
  match args {
    Cons(a, ^rest) => a == "--program"
    Nil => false
  }
}

pub fn nibcheck_whole(args: List(Text)): List(Text) {
  if nibcheck_is_whole(args) {
    match args {
      Cons(^a, rest) => rest
      Nil => Nil
    }
  } else { args }
}

pub fn nibcheck_read_all(
  t: &SyntaxTables,
  classes: UnicodeClasses,
  paths: List(Text)
): Option(List(SurfaceStmt)) ! {div, fs_read, overflow} {
  match paths {
    Nil => Some(Nil)
    Cons(path, rest) => match nibcheck_read(t, classes, path, 0) {
      None => None
      Some(stmts) => match nibcheck_read_all(t, classes, rest) {
        None => None
        Some(more) => Some(List::append(stmts, more))
      }
    }
  }
}

pub fn nibcheck_program(
  once: NibcheckShared,
  t: &SyntaxTables,
  classes: UnicodeClasses,
  prelude: List(SurfaceStmt),
  expanded: List(SurfaceStmt),
  source: List(SurfaceStmt),
  mode: NibcheckMode,
  sealed: List(Text × Text),
  paths: List(Text)
): Unit ! {div, fs_read, overflow, stdout} {
  print(Text::concat_all(Cons("== program", Cons(text_newline(), Nil))))
  match nibcheck_read_all(t, classes, paths) {
    None => print(Text::concat_all(Cons("error", Cons(text_newline(), Nil))))
    // The files are one program, but their spans start at one each: no
    // instances are made for the types of a program read this way.
    Some(program) => {
      let plain := modules_resolve(program)
      print(nibcheck_report(once, mode, prelude, expanded, source, plain, plain, sealed))
    }
  }
}

pub fn nibcheck_run(
  t: &SyntaxTables,
  classes: UnicodeClasses,
  prelude: List(SurfaceStmt),
  expanded: List(SurfaceStmt),
  source: List(SurfaceStmt),
  mode: NibcheckMode,
  sealed: List(Text × Text),
  whole: Bool,
  paths: List(Text)
): Unit ! {div, fs_read, overflow, stdout} {
  // The prelude's share of the work is done once, before any program.
  let once := nibcheck_shared(mode, prelude, expanded)
  if whole { nibcheck_program(once, t, classes, prelude, expanded, source, mode, sealed, paths) } else {
    nibcheck_each(once, t, classes, prelude, expanded, source, mode, sealed, paths)
  }
}

perform main(() => {
  match syntax_tables() {
    None => eprint("the tables of the syntax are damaged")
    Some(t) => match perform argv() {
      Nil => #()
      Cons(written, rest) => match nibcheck_mode(written) {
        None => eprint("usage: --rows|--types|--lin [--program] PRELUDE FILE…")
        Some(Mode) => match nibcheck_whole(rest) {
          Nil => #()
          Cons(prelude_path, paths) => {
            let classes := unicode_classes()
            match nibcheck_prelude_load(t, classes, prelude_path) {
              None => eprint("the prelude does not parse")
              Some(p) => nibcheck_run(
                t,
                classes,
                List::append(p.sets, p.expanded),
                p.expanded,
                p.source,
                Mode, p.sealed, nibcheck_is_whole(rest), paths)
            }
          }
        }
      }
    }
  }
})
