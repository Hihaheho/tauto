// Which mutable storages may hold which others (`cycle/analysis.rs`), in the
// proof language (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」).
// Every syntactic place that makes a storage is one site; a node is a set of
// atoms a value may be, and the constraints between nodes are solved to a
// fixpoint. The program is rejected when the graph of the storages each
// storage's content reaches through immutable values and closures has a cycle,
// or when such a content may be a value the analysis does not model
// (`docs/design/shared-levels.md`). Node `0` is the empty set.

pub(open) inductive CyAtom: Type {
  // A strong reference to the storage of a site.
  AtCell(site: Nat): CyAtom
  // A borrowed `var` (or container) place: read through, never stored.
  AtPlace(site: Nat): CyAtom
  AtLam(lam: Nat): CyAtom
  // A value nothing is known about.
  AtUnknown(id: Nat): CyAtom
  // A `Weak` on the storage of a site: no edge, an `AtCell` again through
  // `Weak.get`.
  AtWeak(site: Nat): CyAtom
}

pub(open) inductive CyCell: Type {
  CyCellMk(contents: Nat, start: Nat, end: Nat, what: Text): CyCell
}

pub(open) inductive CyLam: Type {
  // `env` is what the closure holds; `frame`, what a frame of it holds while
  // it runs: its parameters, locals and the values it is in the middle of,
  // and the frames of what it calls.
  CyLamMk(params: List(Nat), ret: Nat, env: Nat, frame: Nat): CyLam
}

pub(open) inductive CyCall: Type {
  // `frame` is the frame the call is made from: it holds the callee's frame.
  CyCallMk(callee: Nat, args: List(Nat), res: Nat, frame: Nat): CyCall
}

pub(open) inductive CyFilter: Type {
  // `dst ⊇ src` without the storages made by an allocation whose kind is not
  // in `kinds`.
  CyFilterMk(dst: Nat, src: Nat, kinds: List(Text)): CyFilter
}

pub(open) inductive CyBound: Type {
  BdVal(n: Nat): CyBound
  // A borrowed parameter or view: the place it stands for is read through.
  BdPlace(n: Nat): CyBound
  BdVar(site: Nat): CyBound
}

pub(open) inductive CyBinding: Type {
  CyBindingMk(name: Text, bound: CyBound, frame: Nat): CyBinding
}

pub(open) inductive CyFrame: Type {
  // `at` is its depth, from 1; `raw`, the function returns a borrow.
  CyFrameMk(at: Nat, lam: Option(Nat), ret: Nat, raw: Bool): CyFrame
}

// What a prelude `extern` does with the storages it is given (`Extern` of
// `cycle/analysis.rs`).
pub(open) inductive CyExtern: Type {
  ExFlatten: CyExtern
  ExHost: CyExtern
  ExAlloc: CyExtern
  ExStore: CyExtern
  ExLoad: CyExtern
  ExSwap: CyExtern
  ExDowngrade: CyExtern
  ExUpgrade: CyExtern
  ExReplace: CyExtern
  ExLoadMut: CyExtern
  ExConvert: CyExtern
}

pub(open) inductive Cy: Type {
  CyMk(
    types: TypeReport,
    nodes: Nat,
    pts: Ordmap(Nat, Ordmap(CyAtom, Bool)),
    edges: Ordmap(Nat, Ordmap(Nat, Bool)),
    // `dst ⊇ contents(c)` for each storage `c` in `src`, as `(dst, src)`.
    loads: List(Pair(Nat, Nat)),
    // `dst ⊇ src` without its places, and the content of each place.
    reads: List(Pair(Nat, Nat)),
    // `contents(c) ⊇ src` for each storage or place `c` in `dst`, as `(dst, src)`.
    stores: List(Pair(Nat, Nat)),
    // `dst ∋ Place(c)` for each storage `c` in `src`.
    places: List(Pair(Nat, Nat)),
    // `dst ∋ Weak(c)` for each storage `c` in `src`.
    weakens: List(Pair(Nat, Nat)),
    // `dst ∋ Cell(c)` for each `Weak(c)` in `src`.
    upgrades: List(Pair(Nat, Nat)),
    filters: List(CyFilter),
    calls: List(CyCall),
    cells: Ordmap(Nat, CyCell),
    cell_count: Nat,
    lams: Ordmap(Nat, CyLam),
    lam_count: Nat,
    unknowns: Ordmap(Nat, Pair(Text, Nat)),
    unknown_count: Nat,
    effect_args: Ordmap(Text, List(Nat)),
    effect_resume: Ordmap(Text, Nat),
    globals: Ordmap(Text, Nat),
    methods: Ordmap(Text, List(Nat)),
    hosts: Ordmap(Text, Nat),
    host_fns: Ordmap(Text, Bool),
    // The generic global functions, analysed afresh at each direct call.
    generic_fns: Ordmap(Text, SurfaceFn),
    cloning: List(Text),
    // How many fresh copies have been made (`cy_max_clones`).
    clones: Nat,
    bindings: List(CyBinding),
    frames: List(CyFrame),
    // The frames being built, the innermost first: every value made and
    // every name bound flows into it.
    scopes: List(Nat),
    depth: Nat,
    changed: Bool,
    steps: Nat
  ): Cy
}

pub fn cy_new(types: TypeReport, steps: Nat): Cy {
  Cy {
    types: types,
    nodes: 1,
    pts: Ordmap::empty(),
    edges: Ordmap::empty(),
    loads: Nil,
    reads: Nil,
    stores: Nil,
    places: Nil,
    weakens: Nil,
    upgrades: Nil,
    filters: Nil,
    calls: Nil,
    cells: Ordmap::empty(),
    cell_count: 0,
    lams: Ordmap::empty(),
    lam_count: 0,
    unknowns: Ordmap::empty(),
    unknown_count: 0,
    effect_args: Ordmap::empty(),
    effect_resume: Ordmap::empty(),
    globals: Ordmap::empty(),
    methods: Ordmap::empty(),
    hosts: Ordmap::empty(),
    host_fns: Ordmap::empty(),
    generic_fns: Ordmap::empty(),
    cloning: Nil,
    clones: 0,
    bindings: Nil,
    frames: Nil,
    scopes: Nil,
    depth: 0,
    changed: false,
    steps: steps
  }
}

pub fn cy_ignore(n: Nat): Unit {
  #()
}

pub fn cy_extern_in(name: Text, names: List(Text)): Bool {
  list_has_text(names, name)
}

