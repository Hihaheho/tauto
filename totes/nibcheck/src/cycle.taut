pub fn cy_extern_model(name: Text): Option(CyExtern) {
  if cy_extern_in(
    name,
    Cons("Ref.new", Cons("Mutex.new", Cons("Vec.new", Cons("HashMap.new", Nil))))
  ) {
    Some(ExAlloc)
  } else if cy_extern_in(name, Cons("Ref.set", Cons("Mutex.put", Cons("Vec.push", Nil)))) {
    Some(ExStore)
  } else if name == "HashMap.insert" {
    Some(ExSwap)
  } else if name == "replace" {
    Some(ExReplace)
  } else if name == "Weak.of" {
    Some(ExDowngrade)
  } else if name == "Weak.get" {
    Some(ExUpgrade)
  } else if name == "MutexGuard.get_mut" {
    Some(ExLoadMut)
  } else if name == "MutexGuard.get" {
    Some(ExLoad)
  } else if name == "MutexGuard.claimed" {
    Some(ExFlatten)
  } else if cy_extern_in(
    name,
    Cons(
      "Vec.get_mut",
      Cons("Vec.last_mut", Cons("Vec.as_mut_slice", Cons("HashMap.get_mut", Nil)))
    )
  ) {
    Some(ExLoadMut)
  } else if cy_extern_in(
    name,
    Cons(
      "Ref.get",
      Cons(
        "Mutex.take_claimed",
        Cons(
          "Vec.pop",
          Cons(
            "Vec.index",
            Cons(
              "Vec.get",
              Cons(
                "Vec.as_slice",
                Cons("Slice.get", Cons("HashMap.get", Cons("HashMap.index", Nil)))
              )
            )
          )
        )
      )
    )
  ) {
    Some(ExLoad)
  } else if cy_extern_in(
    name,
    Cons("Vec.into_list", Cons("Vec.into_array", Cons("HashMap.into_vec", Nil)))
  ) {
    Some(ExConvert)
  } else if cy_extern_in(name, cy_flatten_names()) {
    Some(ExFlatten)
  } else if cy_extern_in(name, Cons("secret", Cons("expose", Nil))) {
    Some(ExFlatten)
  } else if Text::starts_with(name, "ct_") {
    // The secret words (`std/prelude/Secret.taut`).
    Some(ExFlatten)
  } else {
    None
  }
}

pub fn cy_is_some_extern(name: Text): Bool {
  match cy_extern_model(name): Bool {
    Some(m) => true
    None => false
  }
}

// An operator's name starts with ASCII punctuation other than `_`.
pub fn cy_is_operator(name: Text): Bool {
  match Text::byte(name, 0): Bool {
    None => false
    Some(b) => not(
      b == 95
    ) && ((32 < b && b < 48) || (57 < b && b < 65) || (90 < b && b < 97) || (122 < b && b < 127))
  }
}

pub fn cy_has_ctor(c: Cy, name: Text): Bool {
  match datas_ctor(c.types.datas, name): Bool {
    Some(x) => true
    None => match datas_ctor_candidates(c.types.datas, name): Bool {
      Nil => false
      Cons(x, rest) => true
    }
  }
}

// A name whose value holds nothing the check follows.
pub fn cy_quiet_name(c: Cy, name: Text): Bool {
  cy_has_ctor(
    c,
    name
  ) || cy_is_some_extern(
    name
  ) || Ordmap::contains(c.host_fns, name, Ordmap::compare_text) || cy_is_operator(name)
}

pub fn cy_atom_rank(a: CyAtom): Pair(Nat, Nat) {
  match a: Pair(Nat, Nat) {
    AtCell(s) => Pair { fst: 0, snd: s }
    AtPlace(s) => Pair { fst: 1, snd: s }
    AtLam(l) => Pair { fst: 2, snd: l }
    AtUnknown(u) => Pair { fst: 3, snd: u }
    AtWeak(s) => Pair { fst: 4, snd: s }
  }
}

pub fn cy_atom_compare(a: CyAtom, b: CyAtom): Ordering {
  let x := cy_atom_rank(a)
  let y := cy_atom_rank(b)
  match Ordmap::compare_nat(x.fst, y.fst): Ordering {
    Equal => Ordmap::compare_nat(x.snd, y.snd)
    Less => Less
    Greater => Greater
  }
}

pub fn cy_atoms(c: Cy, n: Nat): Ordmap(CyAtom, Bool) {
  match Ordmap::get(c.pts, n, Ordmap::compare_nat): Ordmap(CyAtom, Bool) {
    Some(s) => s
    None => Ordmap::empty()
  }
}

pub fn cy_keys<K>(es: List(Pair(K, Bool))): List(K) {
  match es: List(K) {
    Nil => Nil
    Cons(e, rest) => Cons(e.fst, cy_keys(rest))
  }
}

pub fn cy_atom_list(c: Cy, n: Nat): List(CyAtom) {
  cy_keys(Ordmap::entries(cy_atoms(c, n)))
}

pub fn cy_succs(c: Cy, n: Nat): Ordmap(Nat, Bool) {
  match Ordmap::get(c.edges, n, Ordmap::compare_nat): Ordmap(Nat, Bool) {
    Some(s) => s
    None => Ordmap::empty()
  }
}

pub fn cy_node(&mut c: Cy): Nat {
  let n := c.nodes
  set_to(&mut c.nodes, n + 1)
  n
}

pub fn cy_insert(&mut c: Cy, n: Nat, a: CyAtom): Unit {
  let s := cy_atoms(c, n)
  if not(Ordmap::contains(s, a, cy_atom_compare)) {
    set_to(
      &mut c.pts,
      Ordmap::insert(c.pts, n, Ordmap::insert(s, a, true, cy_atom_compare), Ordmap::compare_nat)
    )
    set_to(&mut c.changed, true)
  }
}

pub fn cy_insert_all(atoms: List(CyAtom), &mut c: Cy, n: Nat): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      cy_insert(&mut c, n, a)
      cy_insert_all(rest, &mut c, n)
    }
  }
}

pub fn cy_flow(&mut c: Cy, r#from: Nat, to: Nat): Unit {
  if not(r#from == 0) && not(to == 0) && not(r#from == to) {
    let s := cy_succs(c, r#from)
    if not(Ordmap::contains(s, to, Ordmap::compare_nat)) {
      set_to(
        &mut c.edges,
        Ordmap::insert(
          c.edges,
          r#from,
          Ordmap::insert(s, to, true, Ordmap::compare_nat),
          Ordmap::compare_nat
        )
      )
      set_to(&mut c.changed, true)
    }
  }
}

pub fn cy_flow_each(froms: List(Nat), &mut c: Cy, to: Nat): Unit {
  match froms: Unit {
    Nil => #()
    Cons(f, rest) => {
      cy_flow(&mut c, f, to)
      cy_flow_each(rest, &mut c, to)
    }
  }
}

pub fn cy_flow_zip(froms: List(Nat), &mut c: Cy, tos: List(Nat)): Unit {
  match froms: Unit {
    Nil => #()
    Cons(f, rest) => match tos: Unit {
      Nil => #()
      Cons(t, more) => {
        cy_flow(&mut c, f, t)
        cy_flow_zip(rest, &mut c, more)
      }
    }
  }
}

pub fn cy_atom(&mut c: Cy, a: CyAtom): Nat {
  let n := cy_node(&mut c)
  cy_insert(&mut c, n, a)
  n
}

pub fn cy_unknown(&mut c: Cy, why: Text, start: Nat): Nat {
  let id := c.unknown_count
  set_to(
    &mut c.unknowns,
    Ordmap::insert(c.unknowns, id, Pair { fst: why, snd: start }, Ordmap::compare_nat)
  )
  set_to(&mut c.unknown_count, id + 1)
  cy_atom(&mut c, AtUnknown(id))
}

pub fn cy_cell_dummy(): CyCell {
  CyCell { contents: 0, start: 0, end: 0, what: "" }
}

pub fn cy_cell_at(c: Cy, s: Nat): CyCell {
  match Ordmap::get(c.cells, s, Ordmap::compare_nat): CyCell {
    Some(x) => x
    None => cy_cell_dummy()
  }
}

pub fn cy_contents(c: Cy, s: Nat): Nat {
  cy_cell_at(c, s).contents
}

// A new site: its number and the node of its content.
pub fn cy_cell(&mut c: Cy, what: Text, start: Nat, end: Nat): Pair(Nat, Nat) {
  let contents := cy_node(&mut c)
  let site := c.cell_count
  set_to(
    &mut c.cells,
    Ordmap::insert(
      c.cells,
      site,
      CyCell { contents: contents, start: start, end: end, what: what },
      Ordmap::compare_nat
    )
  )
  set_to(&mut c.cell_count, site + 1)
  Pair { fst: site, snd: contents }
}

// The state of a host function, one for all its calls.
pub fn cy_host_cell(&mut c: Cy, name: Text, start: Nat, end: Nat): Nat {
  match Ordmap::get(c.hosts, name, Ordmap::compare_text): Nat {
    Some(s) => s
    None => {
      let s := cy_cell(&mut c, cat3("the host state of ", name, ""), start, end).fst
      set_to(&mut c.hosts, Ordmap::insert(c.hosts, name, s, Ordmap::compare_text))
      s
    }
  }
}

pub fn cy_lam_dummy(): CyLam {
  CyLam { params: Nil, ret: 0, env: 0, frame: 0 }
}

pub fn cy_lam(c: Cy, l: Nat): CyLam {
  match Ordmap::get(c.lams, l, Ordmap::compare_nat): CyLam {
    Some(x) => x
    None => cy_lam_dummy()
  }
}

pub fn cy_nodes(ps: List(Text), &mut c: Cy): List(Nat) {
  match ps: List(Nat) {
    Nil => Nil
    Cons(p, rest) => {
      let n := cy_node(&mut c)
      Cons(n, cy_nodes(rest, &mut c))
    }
  }
}

pub fn cy_new_lam(&mut c: Cy, params: List(Text)): Nat {
  let ps := cy_nodes(params, &mut c)
  let ret := cy_node(&mut c)
  let env := cy_node(&mut c)
  let frame := cy_node(&mut c)
  let l := c.lam_count
  set_to(
    &mut c.lams,
    Ordmap::insert(
      c.lams,
      l,
      CyLam { params: ps, ret: ret, env: env, frame: frame },
      Ordmap::compare_nat
    )
  )
  set_to(&mut c.lam_count, l + 1)
  l
}

pub fn cy_nonempty(ns: List(Nat)): List(Nat) {
  match ns: List(Nat) {
    Nil => Nil
    Cons(n, rest) => if n == 0 { cy_nonempty(rest) } else { Cons(n, cy_nonempty(rest)) }
  }
}

pub fn cy_join(&mut c: Cy, parts: List(Nat)): Nat {
  match cy_nonempty(parts): Nat {
    Nil => 0
    Cons(first, rest) => match rest: Nat {
      Nil => first
      Cons(second, more) => {
        let n := cy_node(&mut c)
        cy_flow_each(Cons(first, rest), &mut c, n)
        n
      }
    }
  }
}

pub fn cy_term_type(c: Cy, t: SurfaceTerm): Option(Ty) {
  Ordmap::get(c.types.terms, term_at_of(t), term_at_compare)
}

pub fn cy_local_type(c: Cy, name: Text, at: SurfaceTerm): Option(Ty) {
  Ordmap::get(c.types.locals, LocalKey { name: name, site: at.start }, local_key_compare)
}

pub fn cy_data_is_handle(cs: List(DataCtor)): Bool {
  match cs: Bool {
    Nil => true
    Cons(x, more) => match more: Bool {
      Nil => match x.fields: Bool {
        Nil => true
        Cons(f, rest) => false
      }
      Cons(y, others) => false
    }
  }
}

// Whether a value of this type may hold a storage or a closure.
//
// Each walk returns, with its answer, the data types entered so far. A type
// entered once is not read again, even off the current path: it reaches the
// same fields, so reading it again adds nothing, and following every path
// through nested data types grows exponentially with their depth. `inside`
// says the walk is in the fields of a data type.
mutual {
  pub fn cy_holds_ty(k: Nat, d: Datas, t: Ty, inside: Bool, seen: List(Text)): Pair(Bool, List(Text)) {
    match k: Pair(Bool, List(Text)) {
      Zero => Pair { fst: true, snd: seen }
      Succ(j) => match t: Pair(Bool, List(Text)) {
        TyInt(w) => Pair { fst: false, snd: seen }
        TyBool => Pair { fst: false, snd: seen }
        TyText => Pair { fst: false, snd: seen }
        TyUnit => Pair { fst: false, snd: seen }
        TyNever => Pair { fst: false, snd: seen }
        TyDecimal => Pair { fst: false, snd: seen }
        TyFloat => Pair { fst: false, snd: seen }
        TyFn(ps, r, kind) => Pair { fst: true, snd: seen }
        TyPoly(gs, inner) => Pair { fst: true, snd: seen }
        TyVar(v) => Pair { fst: true, snd: seen }
        // Inside the fields of a data type, a parameter stands for an
        // argument `cy_holds_named` has already read, so it adds nothing:
        // the tail of a `List(A)` is not an unknown type.
        TyParam(n, b) => Pair { fst: not(inside), snd: seen }
        TyApp(h, a) => Pair { fst: true, snd: seen }
        TyUnion(ts) => cy_holds_any(j, d, ts, inside, seen)
        TyProduct(ts) => cy_holds_any(j, d, ts, inside, seen)
        TyTagged(tags, inner) => cy_holds_ty(j, d, inner, inside, seen)
        TyInfo(inner) => cy_holds_ty(j, d, inner, inside, seen)
        TyBorrow(inner, m) => cy_holds_ty(j, d, inner, inside, seen)
        TyNamed(n, args) => cy_holds_named(j, d, n, args, inside, seen)
      }
    }
  }

  pub fn cy_holds_any(
    k: Nat,
    d: Datas,
    ts: List(Ty),
    inside: Bool,
    seen: List(Text)
  ): Pair(Bool, List(Text)) {
    match k: Pair(Bool, List(Text)) {
      Zero => Pair { fst: true, snd: seen }
      Succ(j) => match ts: Pair(Bool, List(Text)) {
        Nil => Pair { fst: false, snd: seen }
        Cons(t, rest) => {
          let r := cy_holds_ty(j, d, t, inside, seen)
          if r.fst { r } else { cy_holds_any(j, d, rest, inside, r.snd) }
        }
      }
    }
  }

  pub fn cy_holds_named(
    k: Nat,
    d: Datas,
    n: Text,
    args: List(Ty),
    inside: Bool,
    seen: List(Text)
  ): Pair(Bool, List(Text)) {
    match k: Pair(Bool, List(Text)) {
      Zero => Pair { fst: true, snd: seen }
      Succ(j) => if list_has_text(
        Cons(
          "Ref",
          Cons(
            "Mutex",
            Cons(
              "MutexGuard",
              Cons("Vec", Cons("HashMap", Cons("Slice", Cons("Task", Cons("Pending", Nil)))))
            )
          )
        ),
        n
      ) {
        Pair { fst: true, snd: seen }
      } else if n == "Atomic" || n == "Buf" {
        Pair { fst: false, snd: seen }
      } else {
        let r := cy_holds_any(j, d, args, inside, seen)
        if r.fst {
          r
        } else {
          match datas_decl(d, n): Pair(Bool, List(Text)) {
            None => Pair { fst: true, snd: r.snd }
            Some(data) => if data.is_struct && cy_data_is_handle(data.constructors) {
              Pair { fst: true, snd: r.snd }
            } else if list_has_text(r.snd, n) {
              Pair { fst: false, snd: r.snd }
            } else {
              cy_holds_ctors(j, d, data.constructors, Cons(n, r.snd))
            }
          }
        }
      }
    }
  }

  pub fn cy_holds_ctors(
    k: Nat,
    d: Datas,
    cs: List(DataCtor),
    seen: List(Text)
  ): Pair(Bool, List(Text)) {
    match k: Pair(Bool, List(Text)) {
      Zero => Pair { fst: true, snd: seen }
      Succ(j) => match cs: Pair(Bool, List(Text)) {
        Nil => Pair { fst: false, snd: seen }
        Cons(x, rest) => {
          let r := cy_holds_fields(j, d, x.fields, seen)
          if r.fst { r } else { cy_holds_ctors(j, d, rest, r.snd) }
        }
      }
    }
  }

  pub fn cy_holds_fields(
    k: Nat,
    d: Datas,
    fs: List(DataField),
    seen: List(Text)
  ): Pair(Bool, List(Text)) {
    match k: Pair(Bool, List(Text)) {
      Zero => Pair { fst: true, snd: seen }
      Succ(j) => match fs: Pair(Bool, List(Text)) {
        Nil => Pair { fst: false, snd: seen }
        Cons(f, rest) => {
          let r := cy_holds_ty(j, d, f.ty, true, seen)
          if r.fst { r } else { cy_holds_fields(j, d, rest, r.snd) }
        }
      }
    }
  }
}

// `None` is not known, which holds.
pub fn cy_holds(c: Cy, ty: Option(Ty)): Bool {
  match ty: Bool {
    None => true
    Some(t) => cy_holds_ty(c.steps, c.types.datas, t, false, Nil).fst
  }
}

// The kind of storage an allocation makes, by the name of the `extern` that
// makes it; `None` for every other storage (a `var`, a host state).
pub fn cy_storage_kind(what: Text): Option(Text) {
  if what == "Ref.new" {
    Some("Ref")
  } else if what == "Mutex.new" {
    Some("Mutex")
  } else if what == "Vec.new" || what == "HashMap.into_vec" {
    Some("Vec")
  } else if what == "HashMap.new" {
    Some("HashMap")
  } else {
    None
  }
}

pub fn cy_is_storage_type(n: Text): Bool {
  list_has_text(Cons("Ref", Cons("Mutex", Cons("Vec", Cons("HashMap", Nil)))), n)
}

// The kinds of storage a value of a type may hold without going through a
// storage or a closure, with the data types entered so far (as in
// `cy_holds_ty`); `None` when any storage may be (a function, a type
// parameter, a type the check does not know).
mutual {
  pub fn cy_kinds_ty(
    k: Nat,
    d: Datas,
    t: Ty,
    inside: Bool,
    acc: Pair(List(Text), List(Text))
  ): Option(Pair(List(Text), List(Text))) {
    match k: Option(Pair(List(Text), List(Text))) {
      Zero => None
      Succ(j) => match t: Option(Pair(List(Text), List(Text))) {
        TyInt(w) => Some(acc)
        TyBool => Some(acc)
        TyText => Some(acc)
        TyUnit => Some(acc)
        TyNever => Some(acc)
        TyDecimal => Some(acc)
        TyFloat => Some(acc)
        TyFn(ps, r, kind) => None
        TyPoly(gs, inner) => None
        TyVar(v) => None
        TyParam(n, b) => if inside { Some(acc) } else { None }
        TyApp(h, a) => None
        TyUnion(ts) => cy_kinds_all(j, d, ts, inside, acc)
        TyProduct(ts) => cy_kinds_all(j, d, ts, inside, acc)
        TyTagged(tags, inner) => cy_kinds_ty(j, d, inner, inside, acc)
        TyInfo(inner) => cy_kinds_ty(j, d, inner, inside, acc)
        TyBorrow(inner, m) => cy_kinds_ty(j, d, inner, inside, acc)
        TyNamed(n, args) => cy_kinds_named(j, d, n, args, inside, acc)
      }
    }
  }

  pub fn cy_kinds_all(
    k: Nat,
    d: Datas,
    ts: List(Ty),
    inside: Bool,
    acc: Pair(List(Text), List(Text))
  ): Option(Pair(List(Text), List(Text))) {
    match k: Option(Pair(List(Text), List(Text))) {
      Zero => None
      Succ(j) => match ts: Option(Pair(List(Text), List(Text))) {
        Nil => Some(acc)
        Cons(t, rest) => match cy_kinds_ty(
          j,
          d,
          t,
          inside,
          acc
        ): Option(Pair(List(Text), List(Text))) {
          None => None
          Some(r) => cy_kinds_all(j, d, rest, inside, r)
        }
      }
    }
  }

  pub fn cy_kinds_named(
    k: Nat,
    d: Datas,
    n: Text,
    args: List(Ty),
    inside: Bool,
    acc: Pair(List(Text), List(Text))
  ): Option(Pair(List(Text), List(Text))) {
    match k: Option(Pair(List(Text), List(Text))) {
      Zero => None
      Succ(j) => {
        // The storages the prelude declares, read by name as
        // `cy_holds_named` reads them.
        if cy_is_storage_type(n) {
          Some(Pair { fst: Cons(n, acc.fst), snd: acc.snd })
        } else if n == "Atomic" || n == "Buf" || n == "Bytes" {
          Some(acc)
        } else {
          match cy_kinds_all(j, d, args, inside, acc): Option(Pair(List(Text), List(Text))) {
            None => None
            Some(r) => match datas_decl(d, n): Option(Pair(List(Text), List(Text))) {
              None => None
              Some(data) => if data.is_struct && cy_data_is_handle(data.constructors) {
                None
              } else if list_has_text(r.snd, n) {
                Some(r)
              } else {
                cy_kinds_ctors(j, d, data.constructors, Pair { fst: r.fst, snd: Cons(n, r.snd) })
              }
            }
          }
        }
      }
    }
  }

  pub fn cy_kinds_ctors(
    k: Nat,
    d: Datas,
    cs: List(DataCtor),
    acc: Pair(List(Text), List(Text))
  ): Option(Pair(List(Text), List(Text))) {
    match k: Option(Pair(List(Text), List(Text))) {
      Zero => None
      Succ(j) => match cs: Option(Pair(List(Text), List(Text))) {
        Nil => Some(acc)
        Cons(x, rest) => match cy_kinds_fields(
          j,
          d,
          x.fields,
          acc
        ): Option(Pair(List(Text), List(Text))) {
          None => None
          Some(r) => cy_kinds_ctors(j, d, rest, r)
        }
      }
    }
  }

  pub fn cy_kinds_fields(
    k: Nat,
    d: Datas,
    fs: List(DataField),
    acc: Pair(List(Text), List(Text))
  ): Option(Pair(List(Text), List(Text))) {
    match k: Option(Pair(List(Text), List(Text))) {
      Zero => None
      Succ(j) => match fs: Option(Pair(List(Text), List(Text))) {
        Nil => Some(acc)
        Cons(f, rest) => match cy_kinds_ty(
          j,
          d,
          f.ty,
          true,
          acc
        ): Option(Pair(List(Text), List(Text))) {
          None => None
          Some(r) => cy_kinds_fields(j, d, rest, r)
        }
      }
    }
  }
}

// `n` without the storages a value of type `ty` cannot be: the flattening
// merges values of different types, and a value of type `HashMap(K, V)` is
// never a `Ref`, whatever it was merged with.
pub fn cy_typed(&mut c: Cy, n: Nat, ty: Option(Ty)): Nat {
  match ty: Nat {
    None => n
    Some(t) => if n == 0 {
      0
    } else {
      match cy_kinds_ty(c.steps, c.types.datas, t, false, Pair { fst: Nil, snd: Nil }): Nat {
        None => n
        Some(r) => {
          let d := cy_node(&mut c)
          set_to(&mut c.filters, Cons(CyFilter { dst: d, src: n, kinds: r.fst }, c.filters))
          d
        }
      }
    }
  }
}

pub fn cy_read_through_typed(&mut c: Cy, n: Nat, t: Option(SurfaceTerm)): Nat {
  let v := cy_read_through(&mut c, n)
  match t: Nat {
    None => v
    Some(term) => cy_typed(&mut c, v, cy_term_type(c, term))
  }
}

pub fn cy_max_clones(): Nat {
  4096
}

pub fn cy_find_in(bs: List(CyBinding), name: Text): Option(CyBinding) {
  match bs: Option(CyBinding) {
    Nil => None
    Cons(b, rest) => if b.name == name { Some(b) } else { cy_find_in(rest, name) }
  }
}

pub fn cy_find(c: Cy, name: Text): Option(CyBinding) {
  cy_find_in(c.bindings, name)
}

pub fn cy_scope(c: Cy): Nat {
  match c.scopes: Nat {
    Cons(f, rest) => f
    Nil => 0
  }
}

pub fn cy_hold(&mut c: Cy, n: Nat): Unit {
  cy_flow(&mut c, n, cy_scope(c))
}

pub fn cy_bound_node(&mut c: Cy, bound: CyBound): Nat {
  match bound: Nat {
    BdVal(n) => n
    BdPlace(n) => n
    BdVar(s) => cy_atom(&mut c, AtCell(s))
  }
}

pub fn cy_bind(&mut c: Cy, name: Text, bound: CyBound): Unit {
  let held := cy_bound_node(&mut c, bound)
  cy_hold(&mut c, held)
  set_to(&mut c.bindings, Cons(CyBinding { name: name, bound: bound, frame: c.depth }, c.bindings))
}

pub fn cy_push_frame(&mut c: Cy, lam: Option(Nat), ret: Nat, raw: Bool): Unit {
  let at := c.depth + 1
  set_to(&mut c.frames, Cons(CyFrame { at: at, lam: lam, ret: ret, raw: raw }, c.frames))
  set_to(&mut c.depth, at)
}

pub fn cy_top_frame(c: Cy): CyFrame {
  match c.frames: CyFrame {
    Nil => CyFrame { at: 0, lam: None, ret: 0, raw: false }
    Cons(f, rest) => f
  }
}

pub fn cy_capture_in(fs: List(CyFrame), &mut c: Cy, b: CyBinding): Unit {
  match fs: Unit {
    Nil => #()
    Cons(f, rest) => {
      if b.frame < f.at {
        match f.lam: Unit {
          None => #()
          Some(l) => {
            let env := cy_lam(c, l).env
            match b.bound: Unit {
              BdVal(n) => cy_flow(&mut c, n, env)
              BdPlace(n) => cy_flow(&mut c, n, env)
              BdVar(s) => cy_insert(&mut c, env, AtCell(s))
            }
          }
        }
      }
      cy_capture_in(rest, &mut c, b)
    }
  }
}

// A name used from a frame inside the one that binds it is captured by every
// closure in between.
pub fn cy_capture(&mut c: Cy, b: CyBinding): Unit {
  cy_capture_in(c.frames, &mut c, b)
}

pub fn cy_read_through(&mut c: Cy, n: Nat): Nat {
  if n == 0 {
    0
  } else {
    let d := cy_node(&mut c)
    set_to(&mut c.reads, Cons(Pair { fst: d, snd: n }, c.reads))
    d
  }
}

pub fn cy_read_through_each(ns: List(Nat), &mut c: Cy): List(Nat) {
  match ns: List(Nat) {
    Nil => Nil
    Cons(n, rest) => {
      let d := cy_read_through(&mut c, n)
      Cons(d, cy_read_through_each(rest, &mut c))
    }
  }
}

pub fn cy_store_each(vs: List(Nat), &mut c: Cy, dst: Nat): Unit {
  match vs: Unit {
    Nil => #()
    Cons(v, rest) => {
      set_to(&mut c.stores, Cons(Pair { fst: dst, snd: v }, c.stores))
      cy_store_each(rest, &mut c, dst)
    }
  }
}

pub fn cy_new_nodes(n: Nat, &mut c: Cy): List(Nat) {
  match n: List(Nat) {
    Zero => Nil
    Succ(m) => {
      let x := cy_node(&mut c)
      Cons(x, cy_new_nodes(m, &mut c))
    }
  }
}

pub fn cy_lam_atoms(c: Cy, ls: List(Nat)): List(CyAtom) {
  match ls: List(CyAtom) {
    Nil => Nil
    Cons(l, rest) => Cons(AtLam(l), cy_lam_atoms(c, rest))
  }
}

pub fn cy_methods(c: Cy, name: Text): Option(List(Nat)) {
  Ordmap::get(c.methods, name, Ordmap::compare_text)
}

pub fn cy_effect_slots(&mut c: Cy, eff: Text, arity: Nat): List(Nat) {
  let have := match Ordmap::get(c.effect_args, eff, Ordmap::compare_text): List(Nat) {
    Some(ns) => ns
    None => Nil
  }
  let len := List::length(have)
  if len < arity {
    let more := cy_new_nodes(Nat::sub(arity, len), &mut c)
    let all := List::append(have, more)
    set_to(&mut c.effect_args, Ordmap::insert(c.effect_args, eff, all, Ordmap::compare_text))
    List::take(arity, all)
  } else {
    set_to(&mut c.effect_args, Ordmap::insert(c.effect_args, eff, have, Ordmap::compare_text))
    List::take(arity, have)
  }
}

pub fn cy_effect_resume(&mut c: Cy, eff: Text): Nat {
  match Ordmap::get(c.effect_resume, eff, Ordmap::compare_text): Nat {
    Some(n) => n
    None => {
      let n := cy_node(&mut c)
      set_to(&mut c.effect_resume, Ordmap::insert(c.effect_resume, eff, n, Ordmap::compare_text))
      n
    }
  }
}

pub fn cy_is_borrow_term(t: Option(SurfaceTerm)): Bool {
  match t: Bool {
    None => false
    Some(r) => match r.kind: Bool {
      SkBorrow(m, inner) => true
      _ => false
    }
  }
}

pub fn cy_bound(place: Bool, n: Nat): CyBound {
  if place { BdPlace(n) } else { BdVal(n) }
}

pub fn cy_kept(holds: Bool, n: Nat): Nat {
  if holds { n } else { 0 }
}

pub fn cy_bind_params(
  ps: List(Text),
  &mut c: Cy,
  nodes: List(Nat),
  borrows: List(Option(Bool))
): Unit {
  match ps: Unit {
    Nil => #()
    Cons(p, rest) => match nodes: Unit {
      Nil => #()
      Cons(n, more) => {
        let placed := match borrows: Bool {
          Cons(b, bs) => match b: Bool {
            Some(m) => true
            None => false
          }
          Nil => false
        }
        cy_bind(&mut c, p, cy_bound(placed, n))
        cy_bind_params(rest, &mut c, more, match borrows: List(Option(Bool)) {
          Cons(b, bs) => bs
          Nil => Nil
        })
      }
    }
  }
}

pub fn cy_place_root(t: SurfaceTerm): Option(Text) {
  match lin_place(t): Option(Text) {
    Some(p) => Some(p.fst)
    None => None
  }
}

pub fn cy_none_borrows(ps: List(Text)): List(Option(Bool)) {
  match ps: List(Option(Bool)) {
    Nil => Nil
    Cons(p, rest) => Cons(None, cy_none_borrows(rest))
  }
}

pub fn cy_var(&mut c: Cy, name: Text, t: SurfaceTerm, raw: Bool): Nat {
  match cy_find(c, name): Nat {
    Some(b) => {
      cy_capture(&mut c, b)
      match b.bound: Nat {
        BdVal(n) => if raw { n } else { cy_read_through(&mut c, n) }
        BdPlace(n) => if raw { n } else { cy_read_through(&mut c, n) }
        // The content of the `var`: a read, which is a copy.
        BdVar(s) => cy_contents(c, s)
      }
    }
    None => match Ordmap::get(c.globals, name, Ordmap::compare_text): Nat {
      Some(l) => cy_atom(&mut c, AtLam(l))
      None => match cy_methods(c, name): Nat {
        Some(ls) => {
          let n := cy_node(&mut c)
          cy_insert_all(cy_lam_atoms(c, ls), &mut c, n)
          n
        }
        None => if cy_quiet_name(c, name) {
          0
        } else {
          cy_unknown(&mut c, cat3("the name ", name, " is not known to the cycle check"), t.start)
        }
      }
    }
  }
}

pub fn cy_call_methods(ls: List(Nat), &mut c: Cy, args: List(Nat), res: Nat): Unit {
  match ls: Unit {
    Nil => #()
    Cons(l, rest) => {
      let lam := cy_lam(c, l)
      cy_flow_zip(args, &mut c, lam.params)
      cy_flow(&mut c, lam.ret, res)
      cy_hold(&mut c, lam.frame)
      cy_call_methods(rest, &mut c, args, res)
    }
  }
}

pub fn cy_bind_names(names: List(Text), &mut c: Cy, r#from: Nat, at: SurfaceTerm): Unit {
  match names: Unit {
    Nil => #()
    Cons(n, rest) => {
      let v := cy_kept(cy_holds(c, cy_local_type(c, n, at)), r#from)
      cy_bind(&mut c, n, BdVal(v))
      cy_bind_names(rest, &mut c, r#from, at)
    }
  }
}

pub fn cy_bind_pattern(&mut c: Cy, p: SurfacePattern, r#from: Nat, at: SurfaceTerm): Unit {
  cy_bind_names(pattern_names_ordered(p), &mut c, r#from, at)
}

pub fn cy_bind_patterns(
  ps: List(SurfacePattern),
  &mut c: Cy,
  froms: List(Nat),
  at: SurfaceTerm
): Unit {
  match ps: Unit {
    Nil => #()
    Cons(p, rest) => match froms: Unit {
      Nil => #()
      Cons(f, more) => {
        cy_bind_pattern(&mut c, p, f, at)
        cy_bind_patterns(rest, &mut c, more, at)
      }
    }
  }
}

mutual {
  // The node of the value of `t`. `raw` leaves places unread (a function that
  // returns a borrow).
  pub fn cy_eval(k: Nat, &mut c: Cy, t: SurfaceTerm, raw: Bool): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        let n := cy_eval_kind(j, &mut c, t, raw)
        if not(n == 0) && not(cy_holds(c, cy_term_type(c, t))) {
          0
        } else {
          let m := cy_typed(&mut c, n, cy_term_type(c, t))
          cy_hold(&mut c, m)
          m
        }
      }
    }
  }

  pub fn cy_eval_each(k: Nat, &mut c: Cy, ts: List(SurfaceTerm), raw: Bool): List(Nat) {
    match k: List(Nat) {
      Zero => Nil
      Succ(j) => match ts: List(Nat) {
        Nil => Nil
        Cons(t, rest) => {
          let n := cy_eval(j, &mut c, t, raw)
          Cons(n, cy_eval_each(j, &mut c, rest, raw))
        }
      }
    }
  }

  pub fn cy_eval_fields(k: Nat, &mut c: Cy, fs: List(SurfaceField)): List(Nat) {
    match k: List(Nat) {
      Zero => Nil
      Succ(j) => match fs: List(Nat) {
        Nil => Nil
        Cons(f, rest) => {
          let n := cy_eval(j, &mut c, f.value, false)
          Cons(n, cy_eval_fields(j, &mut c, rest))
        }
      }
    }
  }

  pub fn cy_eval_kind(k: Nat, &mut c: Cy, t: SurfaceTerm, raw: Bool): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => match t.kind: Nat {
        SkVar(name) => cy_var(&mut c, name, t, raw)
        SkNat(d) => 0
        SkText(v) => 0
        SkBool(v) => 0
        SkHole(n) => 0
        SkPi(ps, r, e) => 0
        SkExists(b, d, body) => 0
        SkUnion(ps) => 0
        SkFnKind(kind, ty) => 0
        SkTagged(tag, term) => cy_eval(j, &mut c, term, raw)
        SkField(base, name) => cy_eval(j, &mut c, base, false)
        SkRecord(name, fields) => {
          let parts := cy_eval_fields(j, &mut c, fields)
          cy_join(&mut c, parts)
        }
        SkIf(cond, th, el) => {
          cy_ignore(cy_eval(j, &mut c, cond, false))
          let a := cy_eval(j, &mut c, th, raw)
          let b := match el: Nat {
            Some(o) => cy_eval(j, &mut c, o, raw)
            None => 0
          }
          cy_join(&mut c, Cons(a, Cons(b, Nil)))
        }
        SkBlock(stmts) => cy_block(j, &mut c, stmts, raw)
        SkLam(params, body) => cy_closure(j, &mut c, params, cy_none_borrows(params), body, false)
        SkBorrowLam(borrows, lam) => match lam.kind: Nat {
          SkLam(params, body) => cy_closure(j, &mut c, params, borrows, body, false)
          _ => cy_unknown(&mut c, "a borrowing closure of an unexpected shape", t.start)
        }
        SkBorrow(m, term) => cy_borrow(j, &mut c, term)
        SkApp(function, arguments) => cy_app(j, &mut c, t, function, arguments)
        SkPerform(eff, args) => {
          let nodes := cy_eval_each(j, &mut c, args, false)
          let slots := cy_effect_slots(&mut c, eff, List::length(nodes))
          cy_flow_zip(nodes, &mut c, slots)
          // The handler of an effect nothing here handles (the runtime's) may
          // keep or return what it is given.
          let back := cy_effect_resume(&mut c, eff)
          cy_join(&mut c, List::append(nodes, Cons(back, Nil)))
        }
        SkHandle(body, handlers) => cy_handle(j, &mut c, body, handlers)
        SkBudget(steps_memory, steps, body) => {
          cy_ignore(cy_eval(j, &mut c, steps, false))
          cy_eval(j, &mut c, body, raw)
        }
        SkMatch(scrutinee, motive, arms, binder) => {
          let s := cy_eval(j, &mut c, scrutinee, false)
          let results := cy_arms(j, &mut c, arms, s, raw)
          cy_join(&mut c, results)
        }
        _ => cy_unknown(&mut c, "syntax the cycle check does not read", t.start)
      }
    }
  }

  pub fn cy_arms(k: Nat, &mut c: Cy, arms: List(SurfaceArm), s: Nat, raw: Bool): List(Nat) {
    match k: List(Nat) {
      Zero => Nil
      Succ(j) => match arms: List(Nat) {
        Nil => Nil
        Cons(arm, rest) => {
          let saved := c.bindings
          cy_bind_pattern(&mut c, arm.pattern, s, arm.body)
          match arm.guard: Unit {
            Some(g) => {
              cy_ignore(cy_eval(j, &mut c, g, false))
            }
            None => #()
          }
          let r := cy_eval(j, &mut c, arm.body, raw)
          set_to(&mut c.bindings, saved)
          Cons(r, cy_arms(j, &mut c, rest, s, raw))
        }
      }
    }
  }

  // `&p` or `&mut p`: the place of a `var`, or the value.
  pub fn cy_borrow(k: Nat, &mut c: Cy, term: SurfaceTerm): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => match cy_place_root(term): Nat {
        None => cy_eval(j, &mut c, term, false)
        Some(root) => match cy_find(c, root): Nat {
          None => cy_eval(j, &mut c, term, false)
          Some(b) => {
            cy_capture(&mut c, b)
            match b.bound: Nat {
              BdVar(s) => cy_atom(&mut c, AtPlace(s))
              BdPlace(n) => n
              BdVal(n) => n
            }
          }
        }
      }
    }
  }

  pub fn cy_block(k: Nat, &mut c: Cy, stmts: List(SurfaceStmt), raw: Bool): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        let saved := c.bindings
        let last := cy_stmts(j, &mut c, stmts, raw)
        set_to(&mut c.bindings, saved)
        last
      }
    }
  }

  pub fn cy_stmts(k: Nat, &mut c: Cy, stmts: List(SurfaceStmt), raw: Bool): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => match stmts: Nat {
        Nil => 0
        Cons(s, rest) => match rest: Nat {
          Nil => cy_stmt(j, &mut c, s, raw)
          Cons(next, more) => {
            cy_ignore(cy_stmt(j, &mut c, s, false))
            cy_stmts(j, &mut c, rest, raw)
          }
        }
      }
    }
  }

  pub fn cy_stmt(k: Nat, &mut c: Cy, s: SurfaceStmt, raw: Bool): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => match s: Nat {
        StLet(name, ty, value, borrow, mutable) => {
          let place := borrow || mutable
          let v0 := cy_eval(j, &mut c, value, place)
          let v := cy_kept(cy_holds(c, cy_local_type(c, name, value)), v0)
          cy_bind(&mut c, name, cy_bound(place, v))
          0
        }
        StVar(name, ty, value, borrow) => {
          if borrow {
            let v := cy_eval(j, &mut c, value, true)
            cy_bind(&mut c, name, BdPlace(v))
          } else {
            let v := cy_eval(j, &mut c, value, false)
            let cell := cy_cell(&mut c, cat3("var ", name, ""), value.start, value.end)
            cy_flow(&mut c, v, cell.snd)
            cy_bind(&mut c, name, BdVar(cell.fst))
          }
          0
        }
        StAssign(name, name_place, value) => {
          let v := cy_eval(j, &mut c, value, false)
          match cy_find(c, name): Unit {
            None => #()
            Some(b) => {
              cy_capture(&mut c, b)
              match b.bound: Unit {
                BdVar(site) => cy_flow(&mut c, v, cy_contents(c, site))
                BdPlace(p) => cy_store_each(Cons(v, Nil), &mut c, p)
                // A name a borrowed `match` binds to a `&mut`.
                BdVal(n) => cy_store_each(Cons(v, Nil), &mut c, n)
              }
            }
          }
          0
        }
        StFn(f) => {
          let l := cy_local_fn(j, &mut c, f)
          let n := cy_atom(&mut c, AtLam(l))
          cy_bind(&mut c, f.name, BdVal(n))
          0
        }
        StWhile(cond, body) => {
          cy_ignore(cy_eval(j, &mut c, cond, false))
          cy_ignore(cy_eval(j, &mut c, body, false))
          0
        }
        StReturn(e) => {
          match e: Unit {
            None => #()
            Some(v) => {
              let top := cy_top_frame(c)
              let n := cy_eval(j, &mut c, v, top.raw)
              cy_flow(&mut c, n, top.ret)
            }
          }
          0
        }
        StExpr(e) => cy_eval(j, &mut c, e, raw)
        _ => 0
      }
    }
  }

  pub fn cy_local_fn(k: Nat, &mut c: Cy, f: SurfaceFn): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        let l := cy_new_lam(&mut c, f.params)
        // The name is visible in its own body.
        let saved := c.bindings
        let me := cy_atom(&mut c, AtLam(l))
        cy_bind(&mut c, f.name, BdVal(me))
        cy_closure_body(j, &mut c, l, f.params, f.borrows, f.body, cy_is_borrow_term(f.result))
        set_to(&mut c.bindings, saved)
        l
      }
    }
  }

  pub fn cy_closure(
    k: Nat,
    &mut c: Cy,
    params: List(Text),
    borrows: List(Option(Bool)),
    body: SurfaceTerm,
    raw: Bool
  ): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        let l := cy_new_lam(&mut c, params)
        cy_closure_body(j, &mut c, l, params, borrows, body, raw)
        cy_atom(&mut c, AtLam(l))
      }
    }
  }

  pub fn cy_closure_body(
    k: Nat,
    &mut c: Cy,
    l: Nat,
    params: List(Text),
    borrows: List(Option(Bool)),
    body: SurfaceTerm,
    raw: Bool
  ): Unit {
    match k: Unit {
      Zero => #()
      Succ(j) => {
        let lam := cy_lam(c, l)
        let saved_frames := c.frames
        let saved_depth := c.depth
        let saved := c.bindings
        let saved_scopes := c.scopes
        cy_push_frame(&mut c, Some(l), lam.ret, raw)
        set_to(&mut c.scopes, Cons(lam.frame, c.scopes))
        cy_bind_params(params, &mut c, lam.params, borrows)
        let v := cy_eval(j, &mut c, body, raw)
        cy_flow(&mut c, v, lam.ret)
        set_to(&mut c.bindings, saved)
        set_to(&mut c.scopes, saved_scopes)
        set_to(&mut c.frames, saved_frames)
        set_to(&mut c.depth, saved_depth)
      }
    }
  }

  pub fn cy_app(
    k: Nat,
    &mut c: Cy,
    t: SurfaceTerm,
    function: SurfaceTerm,
    arguments: List(SurfaceTerm)
  ): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        let named := match function.kind: Option(Text) {
          SkVar(n) => match cy_find(c, n): Option(Text) {
            None => Some(n)
            Some(b) => None
          }
          _ => None
        }
        let r#copy := match named: Option(Nat) {
          None => None
          Some(name) => cy_clone_of(j, &mut c, name)
        }
        match r#copy: Nat {
          Some(l) => {
            let args := cy_eval_each(j, &mut c, arguments, false)
            let lam := cy_lam(c, l)
            cy_flow_zip(args, &mut c, lam.params)
            cy_hold(&mut c, lam.frame)
            lam.ret
          }
          None => cy_app_named(j, &mut c, t, function, arguments, named)
        }
      }
    }
  }

  // A copy of the generic function `name` for one call, so that what one
  // caller passes through it does not come back to another: a generic body
  // cannot look into the values of its type parameters, and one shared copy
  // would merge, say, the contents of every mutex a `Mutex.lock` is ever
  // given. A copy is the same body over fresh nodes, so it makes every value
  // and storage the call may make; a call to a function already being copied
  // (recursion) and every use as a value read the shared copy instead.
  pub fn cy_clone_of(k: Nat, &mut c: Cy, name: Text): Option(Nat) {
    match k: Option(Nat) {
      Zero => None
      Succ(j) => match Ordmap::get(c.generic_fns, name, Ordmap::compare_text): Option(Nat) {
        None => None
        Some(f) => if list_has_text(c.cloning, name) || not(c.clones < cy_max_clones()) {
          None
        } else {
          set_to(&mut c.clones, c.clones + 1)
          let l := cy_new_lam(&mut c, f.params)
          // The body sees what a global body sees: no local name.
          let saved_frames := c.frames
          let saved_depth := c.depth
          let saved := c.bindings
          let saved_scopes := c.scopes
          let saved_cloning := c.cloning
          set_to(&mut c.frames, Nil)
          set_to(&mut c.depth, 0)
          set_to(&mut c.bindings, Nil)
          set_to(&mut c.scopes, Nil)
          cy_push_frame(&mut c, None, 0, false)
          set_to(&mut c.cloning, Cons(name, c.cloning))
          cy_closure_body(j, &mut c, l, f.params, f.borrows, f.body, cy_is_borrow_term(f.result))
          set_to(&mut c.cloning, saved_cloning)
          set_to(&mut c.frames, saved_frames)
          set_to(&mut c.depth, saved_depth)
          set_to(&mut c.bindings, saved)
          set_to(&mut c.scopes, saved_scopes)
          Some(l)
        }
      }
    }
  }

  pub fn cy_app_named(
    k: Nat,
    &mut c: Cy,
    t: SurfaceTerm,
    function: SurfaceTerm,
    arguments: List(SurfaceTerm),
    named: Option(Text)
  ): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        match named: Nat {
          None => cy_app_value(j, &mut c, t, function, arguments)
          Some(name) => match Ordmap::get(c.globals, name, Ordmap::compare_text): Nat {
            Some(l) => {
              let args := cy_eval_each(j, &mut c, arguments, false)
              let lam := cy_lam(c, l)
              cy_flow_zip(args, &mut c, lam.params)
              cy_hold(&mut c, lam.frame)
              lam.ret
            }
            None => match cy_extern_model(name): Nat {
              Some(model) => cy_extern_call(j, &mut c, model, name, t, arguments)
              None => if Ordmap::contains(c.host_fns, name, Ordmap::compare_text) {
                cy_extern_call(j, &mut c, ExHost, name, t, arguments)
              } else {
                match cy_methods(c, name): Nat {
                  Some(ls) => {
                    let args := cy_eval_each(j, &mut c, arguments, false)
                    let res := cy_node(&mut c)
                    cy_call_methods(ls, &mut c, args, res)
                    res
                  }
                  None => if cy_has_ctor(c, name) || cy_is_operator(name) || name == "Tuple" {
                    let parts := cy_eval_each(j, &mut c, arguments, false)
                    cy_join(&mut c, parts)
                  } else {
                    cy_ignore(
                      cy_unknown(
                        &mut c,
                        cat3("the function ", name, " is not known to the cycle check"),
                        t.start
                      )
                    )
                    cy_app_value(j, &mut c, t, function, arguments)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // A call of a value: what it calls is known once the program is solved.
  pub fn cy_app_value(
    k: Nat,
    &mut c: Cy,
    t: SurfaceTerm,
    function: SurfaceTerm,
    arguments: List(SurfaceTerm)
  ): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        let callee := cy_eval(j, &mut c, function, false)
        let args := cy_eval_each(j, &mut c, arguments, false)
        let res := cy_node(&mut c)
        set_to(
          &mut c.calls,
          Cons(CyCall { callee: callee, args: args, res: res, frame: cy_scope(c) }, c.calls)
        )
        res
      }
    }
  }

  pub fn cy_extern_call(
    k: Nat,
    &mut c: Cy,
    model: CyExtern,
    name: Text,
    t: SurfaceTerm,
    arguments: List(SurfaceTerm)
  ): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        let args := cy_eval_each(j, &mut c, arguments, true)
        // The storage an operation works on is the first argument, read
        // through when it is a place.
        let first := match args: Nat {
          Cons(a, rest) => a
          Nil => 0
        }
        let first_term := match arguments: Option(SurfaceTerm) {
          Cons(a, rest) => Some(a)
          Nil => None
        }
        let others := match args: List(Nat) {
          Cons(a, rest) => rest
          Nil => Nil
        }
        match model: Nat {
          ExFlatten => {
            let parts := cy_read_through_each(args, &mut c)
            cy_join(&mut c, parts)
          }
          ExHost => {
            let h := cy_host_cell(&mut c, name, t.start, t.end)
            let contents := cy_contents(c, h)
            let vs := cy_read_through_each(args, &mut c)
            cy_flow_each(vs, &mut c, contents)
            let holder := cy_atom(&mut c, AtCell(h))
            let d := cy_node(&mut c)
            cy_flow(&mut c, contents, d)
            cy_join(&mut c, Cons(holder, Cons(d, Nil)))
          }
          ExAlloc => {
            let cell := cy_cell(&mut c, name, t.start, t.end)
            let vs := cy_read_through_each(args, &mut c)
            cy_flow_each(vs, &mut c, cell.snd)
            cy_atom(&mut c, AtCell(cell.fst))
          }
          ExStore => {
            let target := cy_read_through_typed(&mut c, first, first_term)
            let vs := cy_read_through_each(others, &mut c)
            cy_store_each(vs, &mut c, target)
            0
          }
          ExLoad => {
            let target := cy_read_through_typed(&mut c, first, first_term)
            let d := cy_node(&mut c)
            set_to(&mut c.loads, Cons(Pair { fst: d, snd: target }, c.loads))
            d
          }
          ExSwap => {
            let target := cy_read_through_typed(&mut c, first, first_term)
            let vs := cy_read_through_each(others, &mut c)
            cy_store_each(vs, &mut c, target)
            let d := cy_node(&mut c)
            set_to(&mut c.loads, Cons(Pair { fst: d, snd: target }, c.loads))
            d
          }
          ExReplace => {
            let vs := cy_read_through_each(others, &mut c)
            cy_store_each(vs, &mut c, first)
            let d := cy_node(&mut c)
            set_to(&mut c.reads, Cons(Pair { fst: d, snd: first }, c.reads))
            d
          }
          ExDowngrade => {
            let target := cy_read_through_typed(&mut c, first, first_term)
            let d := cy_node(&mut c)
            set_to(&mut c.weakens, Cons(Pair { fst: d, snd: target }, c.weakens))
            d
          }
          ExUpgrade => {
            let target := cy_read_through_typed(&mut c, first, first_term)
            let d := cy_node(&mut c)
            set_to(&mut c.upgrades, Cons(Pair { fst: d, snd: target }, c.upgrades))
            d
          }
          ExLoadMut => {
            let target := cy_read_through_typed(&mut c, first, first_term)
            let d := cy_node(&mut c)
            set_to(&mut c.places, Cons(Pair { fst: d, snd: target }, c.places))
            d
          }
          ExConvert => match cy_storage_kind(name): Nat {
            // A storage of another kind, holding what the first held.
            Some(kind) => {
              let target := cy_read_through_typed(&mut c, first, first_term)
              let cell := cy_cell(&mut c, name, t.start, t.end)
              set_to(&mut c.loads, Cons(Pair { fst: cell.snd, snd: target }, c.loads))
              cy_atom(&mut c, AtCell(cell.fst))
            }
            None => {
              let target := cy_read_through_typed(&mut c, first, first_term)
              let d := cy_node(&mut c)
              set_to(&mut c.loads, Cons(Pair { fst: d, snd: target }, c.loads))
              d
            }
          }
        }
      }
    }
  }

  pub fn cy_handle(k: Nat, &mut c: Cy, body: SurfaceTerm, handlers: List(SurfaceHandler)): Nat {
    match k: Nat {
      Zero => 0
      Succ(j) => {
        // What the body holds at a `perform`: the stack up to this handle.
        let stack := cy_node(&mut c)
        let saved_scopes := c.scopes
        set_to(&mut c.scopes, Cons(stack, c.scopes))
        let b := cy_eval(j, &mut c, body, false)
        set_to(&mut c.scopes, saved_scopes)
        cy_hold(&mut c, stack)
        // The frames of the body hold the scope of the handle (the
        // evaluator's frames hold their whole environment), and a resume
        // reinstalls the handler, whose arms see that scope too.
        cy_hold_bindings(c.bindings, &mut c, stack)
        let res := cy_node(&mut c)
        let returned := cy_handlers(j, &mut c, handlers, b, res, stack)
        if not(returned) {
          cy_flow(&mut c, b, res)
        }
        res
      }
    }
  }

  pub fn cy_handlers(
    k: Nat,
    &mut c: Cy,
    hs: List(SurfaceHandler),
    b: Nat,
    res: Nat,
    arms: Nat
  ): Bool {
    match k: Bool {
      Zero => false
      Succ(j) => match hs: Bool {
        Nil => false
        Cons(h, rest) => {
          let saved := c.bindings
          let here := match h: Bool {
            HdReturn(pattern, arm) => {
              cy_bind_pattern(&mut c, pattern, b, arm)
              let v := cy_eval(j, &mut c, arm, false)
              cy_flow(&mut c, v, res)
              true
            }
            HdOperation(eff, hfa, hty, patterns, cont, guard, arm) => {
              let slots := cy_effect_slots(&mut c, eff, List::length(patterns))
              cy_bind_patterns(patterns, &mut c, slots, arm)
              match cont: Unit {
                None => #()
                Some(name) => {
                  // The continuation holds the stack of the body and the
                  // handler.
                  let l := cy_new_lam(&mut c, Cons("", Nil))
                  let lam := cy_lam(c, l)
                  let back := cy_effect_resume(&mut c, eff)
                  cy_flow_each(lam.params, &mut c, back)
                  cy_flow(&mut c, res, lam.ret)
                  cy_flow(&mut c, arms, lam.env)
                  cy_flow(&mut c, lam.env, lam.frame)
                  let n := cy_atom(&mut c, AtLam(l))
                  cy_bind(&mut c, name, BdVal(n))
                }
              }
              match guard: Unit {
                Some(g) => {
                  cy_ignore(cy_eval(j, &mut c, g, false))
                }
                None => #()
              }
              let v := cy_eval(j, &mut c, arm, false)
              cy_flow(&mut c, v, res)
              false
            }
          }
          set_to(&mut c.bindings, saved)
          let later := cy_handlers(j, &mut c, rest, b, res, arms)
          here || later
        }
      }
    }
  }
}

pub fn cy_hold_bindings(bs: List(CyBinding), &mut c: Cy, dst: Nat): Unit {
  match bs: Unit {
    Nil => #()
    Cons(b, rest) => {
      let held := cy_bound_node(&mut c, b.bound)
      cy_flow(&mut c, held, dst)
      cy_hold_bindings(rest, &mut c, dst)
    }
  }
}

pub fn cy_collect_externs(fns: List(SurfaceFn), &mut c: Cy): Unit {
  match fns: Unit {
    Nil => #()
    Cons(f, rest) => {
      if not(cy_is_some_extern(f.name)) {
        set_to(&mut c.host_fns, Ordmap::insert(c.host_fns, f.name, true, Ordmap::compare_text))
      }
      cy_collect_externs(rest, &mut c)
    }
  }
}

// The functions to walk, the oldest first, as `(lam, decl)` pairs newest
// first in `acc`.
mutual {
  pub fn cy_collect(
    k: Nat,
    &mut c: Cy,
    ss: List(SurfaceStmt),
    acc: List(Pair(Nat, SurfaceFn))
  ): List(Pair(Nat, SurfaceFn)) {
    match k: List(Pair(Nat, SurfaceFn)) {
      Zero => acc
      Succ(j) => match ss: List(Pair(Nat, SurfaceFn)) {
        Nil => acc
        Cons(s, rest) => {
          let more := cy_collect_one(j, &mut c, s, acc)
          cy_collect(j, &mut c, rest, more)
        }
      }
    }
  }

  pub fn cy_collect_one(
    k: Nat,
    &mut c: Cy,
    s: SurfaceStmt,
    acc: List(Pair(Nat, SurfaceFn))
  ): List(Pair(Nat, SurfaceFn)) {
    match k: List(Pair(Nat, SurfaceFn)) {
      Zero => acc
      Succ(j) => match s: List(Pair(Nat, SurfaceFn)) {
        StFn(f) => {
          let l := cy_new_lam(&mut c, f.params)
          set_to(&mut c.globals, Ordmap::insert(c.globals, f.name, l, Ordmap::compare_text))
          match f.generics: Unit {
            Nil => #()
            Cons(g, more) => set_to(
              &mut c.generic_fns,
              Ordmap::insert(c.generic_fns, f.name, f, Ordmap::compare_text)
            )
          }
          Cons(Pair { fst: l, snd: f }, acc)
        }
        StInstance(i) => cy_collect_methods(j, &mut c, i.methods, acc)
        StMutual(items, start, end) => cy_collect(j, &mut c, items, acc)
        StExtern(abi, fns, start, end) => {
          cy_collect_externs(fns, &mut c)
          acc
        }
        _ => acc
      }
    }
  }

  pub fn cy_collect_methods(
    k: Nat,
    &mut c: Cy,
    ms: List(SurfaceFn),
    acc: List(Pair(Nat, SurfaceFn))
  ): List(Pair(Nat, SurfaceFn)) {
    match k: List(Pair(Nat, SurfaceFn)) {
      Zero => acc
      Succ(j) => match ms: List(Pair(Nat, SurfaceFn)) {
        Nil => acc
        Cons(m, rest) => {
          let l := cy_new_lam(&mut c, m.params)
          let have := match cy_methods(c, m.name): List(Nat) {
            Some(ls) => ls
            None => Nil
          }
          set_to(
            &mut c.methods,
            Ordmap::insert(c.methods, m.name, List::append(have, Cons(l, Nil)), Ordmap::compare_text)
          )
          cy_collect_methods(j, &mut c, rest, Cons(Pair { fst: l, snd: m }, acc))
        }
      }
    }
  }
}

pub fn cy_functions(k: Nat, &mut c: Cy, ds: List(Pair(Nat, SurfaceFn))): Unit {
  match k: Unit {
    Zero => #()
    Succ(j) => match ds: Unit {
      Nil => #()
      Cons(d, rest) => {
        let f := d.snd
        cy_closure_body(
          c.steps,
          &mut c,
          d.fst,
          f.params,
          f.borrows,
          f.body,
          cy_is_borrow_term(f.result)
        )
        cy_functions(j, &mut c, rest)
      }
    }
  }
}

pub fn cy_not_fns(ss: List(SurfaceStmt)): List(SurfaceStmt) {
  match ss: List(SurfaceStmt) {
    Nil => Nil
    Cons(s, rest) => match s: List(SurfaceStmt) {
      StFn(f) => cy_not_fns(rest)
      _ => Cons(s, cy_not_fns(rest))
    }
  }
}

pub fn cy_union(&mut c: Cy, dst: Nat, src: Nat): Unit {
  cy_insert_all(cy_atom_list(c, src), &mut c, dst)
}

pub fn cy_union_each(dsts: List(Nat), &mut c: Cy, src: Nat): Unit {
  match dsts: Unit {
    Nil => #()
    Cons(d, rest) => {
      cy_union(&mut c, d, src)
      cy_union_each(rest, &mut c, src)
    }
  }
}

pub fn cy_solve_copies(es: List(Pair(Nat, Ordmap(Nat, Bool))), &mut c: Cy): Unit {
  match es: Unit {
    Nil => #()
    Cons(e, rest) => {
      cy_union_each(cy_keys(Ordmap::entries(e.snd)), &mut c, e.fst)
      cy_solve_copies(rest, &mut c)
    }
  }
}

pub fn cy_load_atoms(atoms: List(CyAtom), &mut c: Cy, dst: Nat): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      match a: Unit {
        AtCell(s) => cy_union(&mut c, dst, cy_contents(c, s))
        AtPlace(s) => cy_union(&mut c, dst, cy_contents(c, s))
        _ => #()
      }
      cy_load_atoms(rest, &mut c, dst)
    }
  }
}

pub fn cy_read_atoms(atoms: List(CyAtom), &mut c: Cy, dst: Nat): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      match a: Unit {
        AtPlace(s) => cy_union(&mut c, dst, cy_contents(c, s))
        _ => cy_insert(&mut c, dst, a)
      }
      cy_read_atoms(rest, &mut c, dst)
    }
  }
}

pub fn cy_place_atoms(atoms: List(CyAtom), &mut c: Cy, dst: Nat): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      match a: Unit {
        AtCell(s) => cy_insert(&mut c, dst, AtPlace(s))
        AtPlace(s) => cy_insert(&mut c, dst, AtPlace(s))
        _ => #()
      }
      cy_place_atoms(rest, &mut c, dst)
    }
  }
}

pub fn cy_weaken_atoms(atoms: List(CyAtom), &mut c: Cy, dst: Nat): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      match a: Unit {
        AtCell(s) => cy_insert(&mut c, dst, AtWeak(s))
        _ => #()
      }
      cy_weaken_atoms(rest, &mut c, dst)
    }
  }
}

pub fn cy_upgrade_atoms(atoms: List(CyAtom), &mut c: Cy, dst: Nat): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      match a: Unit {
        AtWeak(s) => cy_insert(&mut c, dst, AtCell(s))
        _ => #()
      }
      cy_upgrade_atoms(rest, &mut c, dst)
    }
  }
}

pub fn cy_solve_weakens(es: List(Pair(Nat, Nat)), &mut c: Cy): Unit {
  match es: Unit {
    Nil => #()
    Cons(e, rest) => {
      cy_weaken_atoms(cy_atom_list(c, e.snd), &mut c, e.fst)
      cy_solve_weakens(rest, &mut c)
    }
  }
}

pub fn cy_solve_upgrades(es: List(Pair(Nat, Nat)), &mut c: Cy): Unit {
  match es: Unit {
    Nil => #()
    Cons(e, rest) => {
      cy_upgrade_atoms(cy_atom_list(c, e.snd), &mut c, e.fst)
      cy_solve_upgrades(rest, &mut c)
    }
  }
}

pub fn cy_store_atoms(atoms: List(CyAtom), &mut c: Cy, src: Nat): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      match a: Unit {
        AtCell(s) => cy_flow(&mut c, src, cy_contents(c, s))
        AtPlace(s) => cy_flow(&mut c, src, cy_contents(c, s))
        _ => #()
      }
      cy_store_atoms(rest, &mut c, src)
    }
  }
}

pub fn cy_call_atoms(atoms: List(CyAtom), &mut c: Cy, call: CyCall): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      match a: Unit {
        AtLam(l) => {
          let lam := cy_lam(c, l)
          cy_flow_zip(call.args, &mut c, lam.params)
          cy_flow(&mut c, lam.ret, call.res)
          cy_flow(&mut c, lam.frame, call.frame)
        }
        AtUnknown(u) => cy_insert(&mut c, call.res, a)
        _ => #()
      }
      cy_call_atoms(rest, &mut c, call)
    }
  }
}

pub fn cy_solve_loads(es: List(Pair(Nat, Nat)), &mut c: Cy): Unit {
  match es: Unit {
    Nil => #()
    Cons(e, rest) => {
      cy_load_atoms(cy_atom_list(c, e.snd), &mut c, e.fst)
      cy_solve_loads(rest, &mut c)
    }
  }
}

pub fn cy_solve_reads(es: List(Pair(Nat, Nat)), &mut c: Cy): Unit {
  match es: Unit {
    Nil => #()
    Cons(e, rest) => {
      cy_read_atoms(cy_atom_list(c, e.snd), &mut c, e.fst)
      cy_solve_reads(rest, &mut c)
    }
  }
}

pub fn cy_solve_places(es: List(Pair(Nat, Nat)), &mut c: Cy): Unit {
  match es: Unit {
    Nil => #()
    Cons(e, rest) => {
      cy_place_atoms(cy_atom_list(c, e.snd), &mut c, e.fst)
      cy_solve_places(rest, &mut c)
    }
  }
}

pub fn cy_solve_stores(es: List(Pair(Nat, Nat)), &mut c: Cy): Unit {
  match es: Unit {
    Nil => #()
    Cons(e, rest) => {
      cy_store_atoms(cy_atom_list(c, e.fst), &mut c, e.snd)
      cy_solve_stores(rest, &mut c)
    }
  }
}

pub fn cy_filter_atoms(atoms: List(CyAtom), &mut c: Cy, f: CyFilter): Unit {
  match atoms: Unit {
    Nil => #()
    Cons(a, rest) => {
      let kept := match a: Bool {
        AtCell(s) => match cy_storage_kind(cy_cell_at(c, s).what): Bool {
          None => true
          Some(kind) => list_has_text(f.kinds, kind)
        }
        _ => true
      }
      if kept {
        cy_insert(&mut c, f.dst, a)
      }
      cy_filter_atoms(rest, &mut c, f)
    }
  }
}

pub fn cy_solve_filters(fs: List(CyFilter), &mut c: Cy): Unit {
  match fs: Unit {
    Nil => #()
    Cons(f, rest) => {
      cy_filter_atoms(cy_atom_list(c, f.src), &mut c, f)
      cy_solve_filters(rest, &mut c)
    }
  }
}

pub fn cy_solve_calls(cs: List(CyCall), &mut c: Cy): Unit {
  match cs: Unit {
    Nil => #()
    Cons(call, rest) => {
      cy_call_atoms(cy_atom_list(c, call.callee), &mut c, call)
      cy_solve_calls(rest, &mut c)
    }
  }
}

// Every constraint once, until none adds an atom or an edge.
pub fn cy_solve(k: Nat, &mut c: Cy): Unit {
  match k: Unit {
    Zero => #()
    Succ(j) => {
      set_to(&mut c.changed, false)
      cy_solve_copies(Ordmap::entries(c.edges), &mut c)
      cy_solve_loads(c.loads, &mut c)
      cy_solve_reads(c.reads, &mut c)
      cy_solve_places(c.places, &mut c)
      cy_solve_weakens(c.weakens, &mut c)
      cy_solve_upgrades(c.upgrades, &mut c)
      cy_solve_filters(c.filters, &mut c)
      cy_solve_stores(c.stores, &mut c)
      cy_solve_calls(c.calls, &mut c)
      if c.changed {
        cy_solve(j, &mut c)
      }
    }
  }
}

pub(open) inductive CyFrontier: Type {
  CyFrontierMk(cells: Ordmap(Nat, Bool), unknown: List(Nat), lams: Ordmap(Nat, Bool)): CyFrontier
}

// The sites a content reaches through immutable values and closures.
pub fn cy_frontier_in(k: Nat, c: Cy, stack: List(CyAtom), f: CyFrontier): CyFrontier {
  match k: CyFrontier {
    Zero => f
    Succ(j) => match stack: CyFrontier {
      Nil => f
      Cons(a, rest) => match a: CyFrontier {
        AtCell(s) => cy_frontier_in(j, c, rest, CyFrontier {
          cells: Ordmap::insert(f.cells, s, true, Ordmap::compare_nat),
          unknown: f.unknown,
          lams: f.lams
        })
        AtPlace(s) => cy_frontier_in(j, c, rest, CyFrontier {
          cells: Ordmap::insert(f.cells, s, true, Ordmap::compare_nat),
          unknown: f.unknown,
          lams: f.lams
        })
        // A `Weak` keeps nothing alive.
        AtWeak(s) => cy_frontier_in(j, c, rest, f)
        AtUnknown(u) => cy_frontier_in(
          j,
          c,
          rest,
          CyFrontier { cells: f.cells, unknown: Cons(u, f.unknown), lams: f.lams }
        )
        AtLam(l) => if Ordmap::contains(f.lams, l, Ordmap::compare_nat) {
          cy_frontier_in(j, c, rest, f)
        } else {
          cy_frontier_in(
            j,
            c,
            List::append(cy_atom_list(c, cy_lam(c, l).env), rest),
            CyFrontier {
              cells: f.cells,
              unknown: f.unknown,
              lams: Ordmap::insert(f.lams, l, true, Ordmap::compare_nat)
            }
          )
        }
      }
    }
  }
}

pub fn cy_frontier(c: Cy, contents: Nat): CyFrontier {
  cy_frontier_in(
    (c.lam_count + 1) * (c.cell_count + c.cell_count + c.lam_count + c.unknown_count + 1),
    c,
    cy_atom_list(c, contents),
    CyFrontier { cells: Ordmap::empty(), unknown: Nil, lams: Ordmap::empty() }
  )
}

// `(why, start)` before by where, then why.
pub fn cy_unknown_before(a: Pair(Text, Nat), b: Pair(Text, Nat)): Bool {
  let less := match Text::ordering(a.fst, b.fst): Bool {
    Less => true
    _ => false
  }
  a.snd < b.snd || (a.snd == b.snd && less)
}

pub fn cy_pick(first: Bool, x: Pair(Text, Nat), y: Pair(Text, Nat)): Option(Pair(Text, Nat)) {
  if first { Some(x) } else { Some(y) }
}

pub fn cy_min_unknown(
  us: List(Nat),
  c: Cy,
  best: Option(Pair(Text, Nat))
): Option(Pair(Text, Nat)) {
  match us: Option(Pair(Text, Nat)) {
    Nil => best
    Cons(u, rest) => match Ordmap::get(c.unknowns, u, Ordmap::compare_nat): Option(Pair(Text, Nat)) {
      None => cy_min_unknown(rest, c, best)
      Some(x) => match best: Option(Pair(Text, Nat)) {
        None => cy_min_unknown(rest, c, Some(x))
        Some(b) => cy_min_unknown(rest, c, cy_pick(cy_unknown_before(x, b), x, b))
      }
    }
  }
}

// The storages each one's content reaches first, and the errors of the ones
// that may hold a value the analysis does not know.
pub fn cy_edges(
  k: Nat,
  c: Cy,
  s: Nat,
  edges: Ordmap(Nat, List(Nat)),
  out: List(LinError)
): Pair(Ordmap(Nat, List(Nat)), List(LinError)) {
  match k: Pair(Ordmap(Nat, List(Nat)), List(LinError)) {
    Zero => Pair { fst: edges, snd: out }
    Succ(j) => if s < c.cell_count {
      let cell := cy_cell_at(c, s)
      let f := cy_frontier(c, cell.contents)
      let more := match cy_min_unknown(f.unknown, c, None): List(LinError) {
        None => out
        Some(u) => Cons(
          LinError {
            message: Text::concat_all(
              Cons(cell.what, Cons(" may hold a value that cannot be checked for reference cycles: ", Cons(u.fst, Nil)))
            ),
            start: cell.start,
            end: cell.end
          },
          out
        )
      }
      cy_edges(
        j,
        c,
        s + 1,
        Ordmap::insert(edges, s, cy_keys(Ordmap::entries(f.cells)), Ordmap::compare_nat),
        more
      )
    } else {
      Pair { fst: edges, snd: out }
    }
  }
}

pub fn cy_edges_of(edges: Ordmap(Nat, List(Nat)), s: Nat): List(Nat) {
  match Ordmap::get(edges, s, Ordmap::compare_nat): List(Nat) {
    Some(es) => es
    None => Nil
  }
}

pub fn cy_reach_in(
  k: Nat,
  edges: Ordmap(Nat, List(Nat)),
  stack: List(Nat),
  seen: Ordmap(Nat, Bool)
): Ordmap(Nat, Bool) {
  match k: Ordmap(Nat, Bool) {
    Zero => seen
    Succ(j) => match stack: Ordmap(Nat, Bool) {
      Nil => seen
      Cons(d, rest) => if Ordmap::contains(seen, d, Ordmap::compare_nat) {
        cy_reach_in(j, edges, rest, seen)
      } else {
        cy_reach_in(
          j,
          edges,
          List::append(cy_edges_of(edges, d), rest),
          Ordmap::insert(seen, d, true, Ordmap::compare_nat)
        )
      }
    }
  }
}

pub fn cy_reaches(
  k: Nat,
  edges: Ordmap(Nat, List(Nat)),
  s: Nat,
  n: Nat,
  acc: Ordmap(Nat, Ordmap(Nat, Bool))
): Ordmap(Nat, Ordmap(Nat, Bool)) {
  match k: Ordmap(Nat, Ordmap(Nat, Bool)) {
    Zero => acc
    Succ(j) => if s < n {
      cy_reaches(
        j,
        edges,
        s + 1,
        n,
        Ordmap::insert(
          acc,
          s,
          cy_reach_in(n * n + n + 1, edges, cy_edges_of(edges, s), Ordmap::empty()),
          Ordmap::compare_nat
        )
      )
    } else {
      acc
    }
  }
}

pub fn cy_reach_of(reach: Ordmap(Nat, Ordmap(Nat, Bool)), s: Nat): Ordmap(Nat, Bool) {
  match Ordmap::get(reach, s, Ordmap::compare_nat): Ordmap(Nat, Bool) {
    Some(r) => r
    None => Ordmap::empty()
  }
}

pub fn cy_reached(reach: Ordmap(Nat, Ordmap(Nat, Bool)), r#from: Nat, to: Nat): Bool {
  Ordmap::contains(cy_reach_of(reach, r#from), to, Ordmap::compare_nat)
}

// The storages that reach `s` and that `s` reaches, from `d` on.
pub fn cy_component(
  k: Nat,
  reach: Ordmap(Nat, Ordmap(Nat, Bool)),
  s: Nat,
  d: Nat,
  n: Nat
): List(Nat) {
  match k: List(Nat) {
    Zero => Nil
    Succ(j) => if d < n {
      if cy_reached(reach, s, d) && cy_reached(reach, d, s) {
        Cons(d, cy_component(j, reach, s, d + 1, n))
      } else {
        cy_component(j, reach, s, d + 1, n)
      }
    } else {
      Nil
    }
  }
}

pub fn cy_mark_done(ds: List(Nat), done: Ordmap(Nat, Bool)): Ordmap(Nat, Bool) {
  match ds: Ordmap(Nat, Bool) {
    Nil => done
    Cons(d, rest) => cy_mark_done(rest, Ordmap::insert(done, d, true, Ordmap::compare_nat))
  }
}

// The prelude's storages after the program's, then by where and what.
pub fn cy_cell_order(a: CyCell, b: CyCell): Ordering {
  let pa := 2147483648 < a.start || a.start == 2147483648
  let pb := 2147483648 < b.start || b.start == 2147483648
  if not(pa) && pb {
    Less
  } else if pa && not(pb) {
    Greater
  } else {
    match Ordmap::compare_nat(a.start, b.start): Ordering {
      Equal => Text::ordering(a.what, b.what)
      Less => Less
      Greater => Greater
    }
  }
}

// `x` was before every element of `l`: it goes before the equal ones.
pub fn cy_insert_cell_first(x: CyCell, l: List(CyCell)): List(CyCell) {
  match l: List(CyCell) {
    Nil => Cons(x, Nil)
    Cons(h, t) => match cy_cell_order(x, h): List(CyCell) {
      Greater => Cons(h, cy_insert_cell_first(x, t))
      _ => Cons(x, l)
    }
  }
}

// Stable: equal ones keep their order.
pub fn cy_sort_cells(l: List(CyCell)): List(CyCell) {
  match l: List(CyCell) {
    Nil => Nil
    Cons(h, t) => cy_insert_cell_first(h, cy_sort_cells(t))
  }
}

pub fn cy_cells_of(c: Cy, ds: List(Nat)): List(CyCell) {
  match ds: List(CyCell) {
    Nil => Nil
    Cons(d, rest) => Cons(cy_cell_at(c, d), cy_cells_of(c, rest))
  }
}

pub fn cy_whats(cs: List(CyCell)): List(Text) {
  match cs: List(Text) {
    Nil => Nil
    Cons(x, rest) => Cons(x.what, cy_whats(rest))
  }
}

pub fn cy_comma(ns: List(Text)): Text {
  match ns: Text {
    Nil => ""
    Cons(n, rest) => match rest: Text {
      Nil => n
      Cons(m, more) => Text::concat_all(Cons(n, Cons(", ", Cons(cy_comma(rest), Nil))))
    }
  }
}

pub fn cy_cycle_message(names: List(Text)): Text {
  if List::length(names) == 1 {
    cat3(
      cy_comma(names),
      " may hold itself through a closure or a data structure, which is a strong reference cycle",
      ""
    )
  } else {
    cat3("strong reference cycle among ", cy_comma(names), "")
  }
}

pub fn cy_cycles(
  k: Nat,
  c: Cy,
  reach: Ordmap(Nat, Ordmap(Nat, Bool)),
  s: Nat,
  done: Ordmap(Nat, Bool),
  out: List(LinError)
): List(LinError) {
  match k: List(LinError) {
    Zero => out
    Succ(j) => if s < c.cell_count {
      if Ordmap::contains(done, s, Ordmap::compare_nat) || not(cy_reached(reach, s, s)) {
        cy_cycles(j, c, reach, s + 1, done, out)
      } else {
        let component := cy_component(c.cell_count + 1, reach, s, 0, c.cell_count)
        let cells := cy_sort_cells(cy_cells_of(c, component))
        let names := cy_whats(cells)
        let message := cy_cycle_message(names)
        let first := match cells: CyCell {
          Cons(x, rest) => x
          Nil => cy_cell_dummy()
        }
        cy_cycles(
          j,
          c,
          reach,
          s + 1,
          cy_mark_done(component, done),
          Cons(LinError { message: message, start: first.start, end: first.end }, out)
        )
      }
    } else {
      out
    }
  }
}

pub fn cy_error_order(a: LinError, b: LinError): Ordering {
  match Ordmap::compare_nat(a.start, b.start): Ordering {
    Equal => match Ordmap::compare_nat(a.end, b.end): Ordering {
      Equal => Text::ordering(a.message, b.message)
      Less => Less
      Greater => Greater
    }
    Less => Less
    Greater => Greater
  }
}

pub fn cy_insert_error(x: LinError, l: List(LinError)): List(LinError) {
  match l: List(LinError) {
    Nil => Cons(x, Nil)
    Cons(h, t) => match cy_error_order(x, h): List(LinError) {
      Greater => Cons(h, cy_insert_error(x, t))
      _ => Cons(x, l)
    }
  }
}

pub fn cy_sort_errors(l: List(LinError)): List(LinError) {
  match l: List(LinError) {
    Nil => Nil
    Cons(h, t) => cy_insert_error(h, cy_sort_errors(t))
  }
}

pub fn cy_dedup(es: List(LinError)): List(LinError) {
  match es: List(LinError) {
    Nil => Nil
    Cons(a, rest) => match rest: List(LinError) {
      Cons(b, more) => match cy_error_order(a, b): List(LinError) {
        Equal => cy_dedup(rest)
        _ => Cons(a, cy_dedup(rest))
      }
      Nil => Cons(a, Nil)
    }
  }
}

// The errors, each independent of the order the analysis numbered things in,
// sorted by where they are.
pub fn cy_diagnostics(c: Cy): List(LinError) {
  let n := c.cell_count
  let found := cy_edges(n + 1, c, 0, Ordmap::empty(), Nil)
  let reach := cy_reaches(n + 1, found.fst, 0, n, Ordmap::empty())
  let all := cy_cycles(n + 1, c, reach, 0, Ordmap::empty(), found.snd)
  cy_dedup(cy_sort_errors(all))
}

// The cycle check of a program whose use check passed.
pub fn cycle_check(
  types: TypeReport,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt)
): List(LinError) {
  let steps := 16 * (program_extent(prelude) + program_extent(program) + 1)
  var c: Cy := cy_new(types, steps)
  let a := cy_collect(steps, &mut c, prelude, Nil)
  let decls := List::reverse(cy_collect(steps, &mut c, program, a))
  cy_push_frame(&mut c, None, 0, false)
  cy_functions(steps, &mut c, decls)
  cy_ignore(cy_block(steps, &mut c, cy_not_fns(program), false))
  // Each round but the last adds an atom or an edge.
  cy_solve(steps, &mut c)
  cy_diagnostics(c)
}
