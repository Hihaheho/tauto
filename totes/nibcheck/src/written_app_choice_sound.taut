import "written_application_sound.taut"

// Classification of the head and argument count, before reading the arguments.
pub(open) inductive WrittenAppChoice(
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat
): (WrittenApp) -> Prop {
  WrittenChoiceUnit(
    named: name = "Tuple",
    empty: count = 0
  ): WrittenAppChoice(generics, name, count, WrittenUnit)
  WrittenChoiceInfo(
    named: name = "info",
    one: count = 1
  ): WrittenAppChoice(generics, name, count, WrittenInfo)
  WrittenChoiceGeneric(
    bound: Ty,
    parameter: Ordmap::get(generics, name, Ordmap::compare_text) = Some(bound),
    not_info: (name = "info") -> (count = 1) -> False
  ): WrittenAppChoice(generics, name, count, WrittenGeneric(name))
  WrittenChoiceNamed(
    unbound: Ordmap::get(generics, name, Ordmap::compare_text) = None,
    not_tuple: (name = "Tuple") -> False,
    not_info: (name = "info") -> (count = 1) -> False
  ): WrittenAppChoice(generics, name, count, WrittenNamed(name))
  WrittenChoiceBad: WrittenAppChoice(generics, name, count, WrittenBad)
}
pub fn written_choice_tail(name: Text, tuple: Bool, found: Option(Ty)): WrittenApp {
  match found: WrittenApp {
    Some(bound) => WrittenGeneric(name)
    None => match tuple: WrittenApp {
      true => WrittenBad
      false => WrittenNamed(name)
    }
  }
}
pub fn written_choice_info_test(name: Text, tuple: Bool, found: Option(Ty), info: Bool): WrittenApp {
  match info: WrittenApp {
    true => WrittenInfo
    false => written_choice_tail(name, tuple, found)
  }
}
pub fn written_choice_unit_test(
  name: Text,
  tuple: Bool,
  found: Option(Ty),
  info: Bool,
  unit: Bool
): WrittenApp {
  match unit: WrittenApp {
    true => WrittenUnit
    false => written_choice_info_test(name, tuple, found, info)
  }
}
pub theorem written_choice_not_tuple(
  name: Text,
  different: Text::eq(name, "Tuple") = false,
  same: name = "Tuple"
): False {
  false_ne_true(
    Eq::trans(
      Eq::sym(Eq::subst((n: Text) => Text::eq(n, "Tuple") = false, same, different)),
      Refl
    )
  )
}
pub theorem written_choice_not_info(
  name: Text,
  count: Nat,
  different: Bool::and(Text::eq(name, "info"), Nat::eq(count, 1)) = false,
  same: name = "info",
  one: count = 1
): False {
  false_ne_true(
    Eq::trans(
      Eq::sym(
        Eq::subst(
          (n: Nat) => Bool::and(Text::eq("info", "info"), Nat::eq(n, 1)) = false,
          one,
          Eq::subst(
            (n: Text) => Bool::and(Text::eq(n, "info"), Nat::eq(count, 1)) = false,
            same,
            different
          )
        )
      ),
      Refl
    )
  )
}
pub theorem written_choice_tail_sound(
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat,
  tuple: Bool,
  found: Option(Ty),
  tuple_test: Text::eq(name, "Tuple") = tuple,
  lookup: Ordmap::get(generics, name, Ordmap::compare_text) = found,
  not_info: (name = "info") -> (count = 1) -> False
): WrittenAppChoice(generics, name, count, written_choice_tail(name, tuple, found)) {
  match found: WrittenAppChoice(generics, name, count, written_choice_tail(name, tuple, found)) {
    Some(bound) => WrittenChoiceGeneric(bound, lookup, not_info)
    None => match tuple: WrittenAppChoice(
      generics,
      name,
      count,
      written_choice_tail(name, tuple, None)
    ) {
      true => WrittenChoiceBad
      false => WrittenChoiceNamed(
        lookup,
        same => written_choice_not_tuple(name, tuple_test, same),
        not_info
      )
    }
  }
}
pub theorem written_choice_info_sound(
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat,
  tuple: Bool,
  found: Option(Ty),
  info: Bool,
  tuple_test: Text::eq(name, "Tuple") = tuple,
  lookup: Ordmap::get(generics, name, Ordmap::compare_text) = found,
  info_test: Bool::and(Text::eq(name, "info"), Nat::eq(count, 1)) = info
): WrittenAppChoice(generics, name, count, written_choice_info_test(name, tuple, found, info)) {
  match info: WrittenAppChoice(
    generics,
    name,
    count,
    written_choice_info_test(name, tuple, found, info)
  ) {
    true => WrittenChoiceInfo(
      text_eq_true(name, "info", ck_bool_and_left(Text::eq(name, "info"), Nat::eq(count, 1), info_test)),
      Nat::eq_sound(count, 1, ck_bool_and_right(Text::eq(name, "info"), Nat::eq(count, 1), info_test))
    )
    false => written_choice_tail_sound(
      generics,
      name,
      count,
      tuple,
      found,
      tuple_test,
      lookup,
      same => one => written_choice_not_info(name, count, info_test, same, one)
    )
  }
}
pub theorem written_choice_unit_sound(
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat,
  tuple: Bool,
  found: Option(Ty),
  info: Bool,
  unit: Bool,
  tuple_test: Text::eq(name, "Tuple") = tuple,
  lookup: Ordmap::get(generics, name, Ordmap::compare_text) = found,
  info_test: Bool::and(Text::eq(name, "info"), Nat::eq(count, 1)) = info,
  unit_test: Bool::and(Text::eq(name, "Tuple"), Nat::eq(count, 0)) = unit
): WrittenAppChoice(
  generics,
  name,
  count,
  written_choice_unit_test(name, tuple, found, info, unit)
) {
  match unit: WrittenAppChoice(
    generics,
    name,
    count,
    written_choice_unit_test(name, tuple, found, info, unit)
  ) {
    true => WrittenChoiceUnit(
      text_eq_true(
        name,
        "Tuple",
        ck_bool_and_left(Text::eq(name, "Tuple"), Nat::eq(count, 0), unit_test)
      ),
      Nat::eq_sound(count, 0, ck_bool_and_right(Text::eq(name, "Tuple"), Nat::eq(count, 0), unit_test))
    )
    false => written_choice_info_sound(
      generics,
      name,
      count,
      tuple,
      found,
      info,
      tuple_test,
      lookup,
      info_test
    )
  }
}

pub fn written_choice_contains(name: Text, tuple: Bool, contains: Bool): WrittenApp {
  match contains: WrittenApp {
    true => WrittenGeneric(name)
    false => match tuple: WrittenApp {
      true => WrittenBad
      false => WrittenNamed(name)
    }
  }
}
pub fn written_choice_original_info(name: Text, tuple: Bool, contains: Bool, info: Bool): WrittenApp {
  match info: WrittenApp {
    true => WrittenInfo
    false => written_choice_contains(name, tuple, contains)
  }
}
pub fn written_choice_original_unit(
  name: Text,
  tuple: Bool,
  contains: Bool,
  info: Bool,
  unit: Bool
): WrittenApp {
  match unit: WrittenApp {
    true => WrittenUnit
    false => written_choice_original_info(name, tuple, contains, info)
  }
}
pub theorem written_choice_lookup_equal(
  name: Text,
  tuple: Bool,
  found: Option(Ty)
): written_choice_contains(name, tuple, written_name_contains(found)) = written_choice_tail(name, tuple, found) {
  match found: written_choice_contains(name, tuple, written_name_contains(found)) = written_choice_tail(name, tuple, found) {
    None => Refl
    Some(bound) => Refl
  }
}
pub theorem written_choice_info_equal(
  name: Text,
  tuple: Bool,
  found: Option(Ty),
  info: Bool
): written_choice_original_info(name, tuple, written_name_contains(found), info) = written_choice_info_test(name, tuple, found, info) {
  match info: written_choice_original_info(name, tuple, written_name_contains(found), info) = written_choice_info_test(name, tuple, found, info) {
    true => Refl
    false => written_choice_lookup_equal(name, tuple, found)
  }
}
pub theorem written_choice_unit_equal(
  name: Text,
  tuple: Bool,
  found: Option(Ty),
  info: Bool,
  unit: Bool
): written_choice_original_unit(name, tuple, written_name_contains(found), info, unit) = written_choice_unit_test(name, tuple, found, info, unit) {
  match unit: written_choice_original_unit(name, tuple, written_name_contains(found), info, unit) = written_choice_unit_test(name, tuple, found, info, unit) {
    true => Refl
    false => written_choice_info_equal(name, tuple, found, info)
  }
}
pub theorem written_app_name_unfold(
  ast_occurrence: Option(TermOccurrence),
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat,
  start: Nat,
  end: Nat
): written_app(SurfaceTermIndexedMk(SkVar(name), start, end, ast_occurrence), count, generics) = written_choice_original_unit(
    name,
    Text::eq(name, "Tuple"),
    written_name_contains(Ordmap::get(generics, name, Ordmap::compare_text)),
    Bool::and(Text::eq(name, "info"), Nat::eq(count, 1)),
    Bool::and(Text::eq(name, "Tuple"), Nat::eq(count, 0))
  ) { Refl }
pub theorem written_app_name_sound(
  ast_occurrence: Option(TermOccurrence),
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat,
  start: Nat,
  end: Nat
): WrittenAppChoice(
  generics,
  name,
  count,
  written_app(SurfaceTermIndexedMk(SkVar(name), start, end, ast_occurrence), count, generics)
) {
  Eq::subst(
    (app: WrittenApp) => WrittenAppChoice(generics, name, count, app),
    Eq::sym(
      Eq::trans(
        written_app_name_unfold(ast_occurrence, generics, name, count, start, end),
        written_choice_unit_equal(
          name,
          Text::eq(name, "Tuple"),
          Ordmap::get(generics, name, Ordmap::compare_text),
          Bool::and(Text::eq(name, "info"), Nat::eq(count, 1)),
          Bool::and(Text::eq(name, "Tuple"), Nat::eq(count, 0))
        )
      )
    ),
    written_choice_unit_sound(
      generics,
      name,
      count,
      Text::eq(name, "Tuple"),
      Ordmap::get(generics, name, Ordmap::compare_text),
      Bool::and(Text::eq(name, "info"), Nat::eq(count, 1)),
      Bool::and(Text::eq(name, "Tuple"), Nat::eq(count, 0)),
      Refl,
      Refl,
      Refl,
      Refl
    )
  )
}
