import "written_application_sound.taut"
import std::map
import std::text
import "kind_sound.taut"
import "ty.taut"
import "types_decl.taut"
import "types_decl_head.taut"
import "unify_sound.taut"
import "written_atomic_sound.taut"
import "../../surface/src/surface.taut"
import "../../identity/src/identity.taut"

// Classification of the head and argument count, before reading the arguments.
pub(open) inductive WrittenAppChoice(
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat
): (WrittenApp) -> Prop {
  WrittenChoiceProduct(
    named: name = "std::prelude::Pair",
    two: count = 2
  ): WrittenAppChoice(generics, name, count, WrittenProduct)
  WrittenChoiceInfo(
    named: name = "Info",
    one: count = 1
  ): WrittenAppChoice(generics, name, count, WrittenInfo)
  WrittenChoiceGeneric(
    bound: Ty,
    parameter: Ordmap::get(generics, name, Ordmap::compare_text) = Some(bound),
    not_info: (name = "Info") -> (count = 1) -> False
  ): WrittenAppChoice(generics, name, count, WrittenGeneric(name))
  WrittenChoiceNamed(
    unbound: Ordmap::get(generics, name, Ordmap::compare_text) = None,
    not_pair: (name = "std::prelude::Pair") -> False,
    not_info: (name = "Info") -> (count = 1) -> False
  ): WrittenAppChoice(generics, name, count, WrittenNamed(name))
  WrittenChoiceBad: WrittenAppChoice(generics, name, count, WrittenBad)
}
pub fn written_choice_tail(name: Text, pair: Bool, found: Option(Ty)): WrittenApp {
  match found {
    Some(^bound) => WrittenGeneric(name)
    None => ⊢ WrittenApp from match pair {
      true => WrittenBad
      false => WrittenNamed(name)
    }
  }
}
pub fn written_choice_info_test(
  name: Text,
  pair: Bool,
  found: Option(Ty),
  info: Bool
): WrittenApp {
  match info {
    true => WrittenInfo
    false => written_choice_tail(name, pair, found)
  }
}
pub fn written_choice_product_test(
  name: Text,
  pair: Bool,
  found: Option(Ty),
  info: Bool,
  product: Bool
): WrittenApp {
  match product {
    true => WrittenProduct
    false => written_choice_info_test(name, pair, found, info)
  }
}
// A name that tests unequal to a text is not that text.
pub theorem written_not_named(
  name: Text,
  text: Text,
  different: Text::eq(name, text) = false,
  same: name = text
): False {
  false_ne_true(
    Eq::trans(Eq::sym(Eq::subst((n: Text) => Text::eq(n, text) = false, same, different)), text_eq_refl(text))
  )
}
pub theorem written_choice_not_pair(
  name: Text,
  different: Text::eq(name, "std::prelude::Pair") = false,
  same: name = "std::prelude::Pair"
): False {
  false_ne_true(
    Eq::trans(Eq::sym(Eq::subst((n: Text) => Text::eq(n, "std::prelude::Pair") = false, same, different)), Refl)
  )
}
pub theorem written_choice_not_info(
  name: Text,
  count: Nat,
  different: Bool::and(Text::eq(name, "Info"), Nat::eq(count, 1)) = false,
  same: name = "Info",
  one: count = 1
): False {
  false_ne_true(
    Eq::trans(
      Eq::sym(
        Eq::subst(
          (n: Nat) => Bool::and(Text::eq("Info", "Info"), Nat::eq(n, 1)) = false,
          one,
          Eq::subst(
            (n: Text) => Bool::and(Text::eq(n, "Info"), Nat::eq(count, 1)) = false,
            same,
            different
          )
        )
      ),
      Refl
    )
  )
}
pub theorem written_choice_tail_sound(
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat,
  pair: Bool,
  found: Option(Ty),
  pair_test: Text::eq(name, "std::prelude::Pair") = pair,
  lookup: Ordmap::get(generics, name, Ordmap::compare_text) = found,
  not_info: (name = "Info") -> (count = 1) -> False
): WrittenAppChoice(generics, name, count, written_choice_tail(name, pair, found)) {
  match found {
    Some(bound) => WrittenChoiceGeneric(bound, lookup, not_info)
    None => ⊢ WrittenAppChoice(
      generics,
      name,
      count,
      written_choice_tail(name, pair, None)
    ) from match pair {
      true => WrittenChoiceBad
      false => WrittenChoiceNamed(
        lookup,
        same => written_choice_not_pair(name, pair_test, same),
        not_info
      )
    }
  }
}
pub theorem written_choice_info_sound(
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat,
  pair: Bool,
  found: Option(Ty),
  info: Bool,
  pair_test: Text::eq(name, "std::prelude::Pair") = pair,
  lookup: Ordmap::get(generics, name, Ordmap::compare_text) = found,
  info_test: Bool::and(Text::eq(name, "Info"), Nat::eq(count, 1)) = info
): WrittenAppChoice(generics, name, count, written_choice_info_test(name, pair, found, info)) {
  ⊢ WrittenAppChoice(
    generics,
    name,
    count,
    written_choice_info_test(name, pair, found, info)
  ) from match info {
    true => WrittenChoiceInfo(
      text_eq_true(
        name,
        "Info",
        ck_bool_and_left(Text::eq(name, "Info"), Nat::eq(count, 1), info_test)
      ),
      Nat::eq_sound(
        count,
        1,
        ck_bool_and_right(Text::eq(name, "Info"), Nat::eq(count, 1), info_test)
      )
    )
    false => written_choice_tail_sound(
      generics,
      name,
      count,
      pair,
      found,
      pair_test,
      lookup,
      same => one => written_choice_not_info(name, count, info_test, same, one)
    )
  }
}
pub theorem written_choice_product_sound(
  generics: Ordmap(Text, Ty),
  name: Text,
  count: Nat,
  pair: Bool,
  found: Option(Ty),
  info: Bool,
  product: Bool,
  pair_test: Text::eq(name, "std::prelude::Pair") = pair,
  lookup: Ordmap::get(generics, name, Ordmap::compare_text) = found,
  info_test: Bool::and(Text::eq(name, "Info"), Nat::eq(count, 1)) = info,
  product_test: Bool::and(Text::eq(name, "std::prelude::Pair"), Nat::eq(count, 2)) = product
): WrittenAppChoice(
  generics,
  name,
  count,
  written_choice_product_test(name, pair, found, info, product)
) {
  ⊢ WrittenAppChoice(
    generics,
    name,
    count,
    written_choice_product_test(name, pair, found, info, product)
  ) from match product {
    true => WrittenChoiceProduct(
      text_eq_true(
        name,
        "std::prelude::Pair",
        ck_bool_and_left(Text::eq(name, "std::prelude::Pair"), Nat::eq(count, 2), product_test)
      ),
      Nat::eq_sound(
        count,
        2,
        ck_bool_and_right(Text::eq(name, "std::prelude::Pair"), Nat::eq(count, 2), product_test)
      )
    )
    false => written_choice_info_sound(
      generics,
      name,
      count,
      pair,
      found,
      info,
      pair_test,
      lookup,
      info_test
    )
  }
}

pub fn written_choice_contains(name: Text, pair: Bool, contains: Bool): WrittenApp {
  match contains {
    true => WrittenGeneric(name)
    false => ⊢ WrittenApp from match pair {
      true => WrittenBad
      false => WrittenNamed(name)
    }
  }
}
pub fn written_choice_original_info(
  name: Text,
  pair: Bool,
  contains: Bool,
  info: Bool
): WrittenApp {
  match info {
    true => WrittenInfo
    false => written_choice_contains(name, pair, contains)
  }
}
pub fn written_choice_original_product(
  name: Text,
  pair: Bool,
  contains: Bool,
  info: Bool,
  product: Bool
): WrittenApp {
  match product {
    true => WrittenProduct
    false => written_choice_original_info(name, pair, contains, info)
  }
}
pub theorem written_choice_lookup_equal(
  name: Text,
  pair: Bool,
  found: Option(Ty)
): written_choice_contains(
  name,
  pair,
  written_name_contains(found)
) = written_choice_tail(name, pair, found) {
  ⊢ written_choice_contains(
    name,
    pair,
    written_name_contains(found)
  ) = written_choice_tail(name, pair, found) from match found {
    None => Refl
    Some(bound) => Refl
  }
}
pub theorem written_choice_info_equal(
  name: Text,
  pair: Bool,
  found: Option(Ty),
  info: Bool
): written_choice_original_info(
  name,
  pair,
  written_name_contains(found),
  info
) = written_choice_info_test(name, pair, found, info) {
  ⊢ written_choice_original_info(
    name,
    pair,
    written_name_contains(found),
    info
  ) = written_choice_info_test(name, pair, found, info) from match info {
    true => Refl
    false => written_choice_lookup_equal(name, pair, found)
  }
}
pub theorem written_choice_product_equal(
  name: Text,
  pair: Bool,
  found: Option(Ty),
  info: Bool,
  product: Bool
): written_choice_original_product(
  name,
  pair,
  written_name_contains(found),
  info,
  product
) = written_choice_product_test(name, pair, found, info, product) {
  ⊢ written_choice_original_product(
    name,
    pair,
    written_name_contains(found),
    info,
    product
  ) = written_choice_product_test(name, pair, found, info, product) from match product {
    true => Refl
    false => written_choice_info_equal(name, pair, found, info)
  }
}
pub theorem written_app_name_unfold(
  ast_occurrence: Option(TermOccurrence),
  generics: Ordmap(Text, Ty),
  name: SurfaceName,
  count: Nat,
  start: Nat,
  end: Nat
): written_app(
  SurfaceTermIndexedMk(SkVar(name), start, end, ast_occurrence),
  count,
  generics
) = written_choice_original_product(
  surface_name_text(name),
  Text::eq(surface_name_text(name), "std::prelude::Pair"),
  written_name_contains(Ordmap::get(generics, surface_name_text(name), Ordmap::compare_text)),
  Bool::and(Text::eq(surface_name_text(name), "Info"), Nat::eq(count, 1)),
  Bool::and(Text::eq(surface_name_text(name), "std::prelude::Pair"), Nat::eq(count, 2))
) { Refl }
pub theorem written_app_name_sound(
  ast_occurrence: Option(TermOccurrence),
  generics: Ordmap(Text, Ty),
  name: SurfaceName,
  count: Nat,
  start: Nat,
  end: Nat
): WrittenAppChoice(
  generics,
  surface_name_text(name),
  count,
  written_app(SurfaceTermIndexedMk(SkVar(name), start, end, ast_occurrence), count, generics)
) {
  Eq::subst(
    (app: WrittenApp) => WrittenAppChoice(generics, surface_name_text(name), count, app),
    Eq::sym(
      Eq::trans(
        written_app_name_unfold(ast_occurrence, generics, name, count, start, end),
        written_choice_product_equal(
          surface_name_text(name),
          Text::eq(surface_name_text(name), "std::prelude::Pair"),
          Ordmap::get(generics, surface_name_text(name), Ordmap::compare_text),
          Bool::and(Text::eq(surface_name_text(name), "Info"), Nat::eq(count, 1)),
          Bool::and(Text::eq(surface_name_text(name), "std::prelude::Pair"), Nat::eq(count, 2))
        )
      )
    ),
    written_choice_product_sound(
      generics,
      surface_name_text(name),
      count,
      Text::eq(surface_name_text(name), "std::prelude::Pair"),
      Ordmap::get(generics, surface_name_text(name), Ordmap::compare_text),
      Bool::and(Text::eq(surface_name_text(name), "Info"), Nat::eq(count, 1)),
      Bool::and(Text::eq(surface_name_text(name), "std::prelude::Pair"), Nat::eq(count, 2)),
      Refl,
      Refl,
      Refl,
      Refl
    )
  )
}
