import std::Map
import "freevars.taut"
import "../../surface/src/surface.taut"
import std::Base
import std::Text
import "checker.taut"
import "datas.taut"
import "ty.taut"
import "../../text/src/text.taut"

// `module M { … }` and the names `M.f` (`crates/tauto-surface/src/surface/modules.rs`), in the proof
// language (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」): modules are flattened where the program is
// read, so what follows sees plain names with a dot in them (`File.open`).
// Only functions (and the functions of `extern` blocks) take the module's
// name.

pub(open) inductive ModState: Type {
  ModStateMk(
    // Every module, by its full path (`A.B`).
    modules: Ordmap(Text, Bool),
    // Every function in a module, by its full name (`A.B.f`).
    fns: Ordmap(Text, Bool),
    locals: List(Text),
    errors: List(TypeError)
  ): ModState
}

pub(open) inductive ModResolved: Type {
  ModResolvedMk(stmts: List(SurfaceStmt), errors: List(TypeError)): ModResolved
}

pub fn mod_join(path: List(Text), name: Text): Text {
  match path: Text {
    Nil => name
    Cons(p, rest) => Text::concat_all(
      Cons(text_join(Cons(p, rest), "."), Cons(".", Cons(name, Nil)))
    )
  }
}

pub fn mod_take(n: Nat, path: List(Text)): List(Text) {
  match n: List(Text) {
    Zero => Nil
    Succ(m) => match path: List(Text) {
      Nil => Nil
      Cons(p, rest) => Cons(p, mod_take(m, rest))
    }
  }
}

pub fn mod_error(&mut s: ModState, message: Text, start: Nat, end: Nat): Unit {
  s := ModState {
    modules: s.modules,
    fns: s.fns,
    locals: s.locals,
    errors: Cons(TypeError { message: message, start: start, end: end }, s.errors)
  }
}

pub fn stmt_is_module(st: SurfaceStmt): Bool {
  match st: Bool {
    StModule(n, items, a, b) => true
    _ => false
  }
}

pub fn mod_has_module(stmts: List(SurfaceStmt)): Bool {
  match stmts: Bool {
    Nil => false
    Cons(st, rest) => stmt_is_module(st) || mod_has_module(rest)
  }
}

pub fn mod_add_fn(&mut s: ModState, path: List(Text), name: Text): Unit {
  match path: Unit {
    Nil => #()
    Cons(p, rest) => {
      s := ModState {
        modules: s.modules,
        fns: Ordmap::insert(s.fns, mod_join(Cons(p, rest), name), true, Ordmap::compare_text),
        locals: s.locals,
        errors: s.errors
      }
    }
  }
}

pub fn mod_add_fns(fns: List(SurfaceFn), &mut s: ModState, path: List(Text)): Unit {
  match fns: Unit {
    Nil => #()
    Cons(f, rest) => {
      mod_add_fn(&mut s, path, f.name)
      mod_add_fns(rest, &mut s, path)
    }
  }
}

pub fn mod_add_module(
  &mut s: ModState,
  classes: Ordmap(Text, Bool),
  path: List(Text),
  name: Text,
  a: Nat,
  b: Nat
): Unit {
  let full := mod_join(path, name)
  // A class's members are the flat names `Class.member`, so a module of the
  // same name would put its functions among them.
  if Ordmap::contains(classes, full, Ordmap::compare_text) {
    mod_error(&mut s, cat4("module ", full, " collides with class ", full), a, b)
  } else {
    #()
  }
  if Ordmap::contains(s.modules, full, Ordmap::compare_text) {
    mod_error(&mut s, cat3("module ", name, " is declared twice"), a, b)
  } else {
    s := ModState {
      modules: Ordmap::insert(s.modules, full, true, Ordmap::compare_text),
      fns: s.fns,
      locals: s.locals,
      errors: s.errors
    }
  }
}

mutual {
  pub fn mod_collect(
    stmts: List(SurfaceStmt),
    &mut s: ModState,
    classes: Ordmap(Text, Bool),
    path: List(Text)
  ): Unit {
    match stmts: Unit {
      Nil => #()
      Cons(st, rest) => {
        mod_collect_one(st, &mut s, classes, path)
        mod_collect(rest, &mut s, classes, path)
      }
    }
  }

  pub fn mod_collect_one(
    st: SurfaceStmt,
    &mut s: ModState,
    classes: Ordmap(Text, Bool),
    path: List(Text)
  ): Unit {
    match st: Unit {
      StModule(name, items, a, b) => {
        mod_add_module(&mut s, classes, path, name, a, b)
        mod_collect(items, &mut s, classes, List::append(path, Cons(name, Nil)))
      }
      StFn(f) => mod_add_fn(&mut s, path, f.name)
      StExtern(l, fns, a, b) => mod_add_fns(fns, &mut s, path)
      _ => #()
    }
  }
}

pub fn mod_is_local(names: List(Text), name: Text): Bool {
  match names: Bool {
    Nil => false
    Cons(first, rest) => first == name || mod_is_local(rest, name)
  }
}

// The full name of `name` written in the module `path`: the innermost module
// that has it, then the outer ones, then the top level.
pub fn mod_name_from(n: Nat, s: ModState, name: Text, path: List(Text)): Text {
  match n: Text {
    Zero => name
    Succ(m) => if Ordmap::contains(
      s.fns,
      mod_join(mod_take(Succ(m), path), name),
      Ordmap::compare_text
    ) {
      mod_join(mod_take(Succ(m), path), name)
    } else {
      mod_name_from(m, s, name, path)
    }
  }
}

pub fn mod_name(s: ModState, name: Text, path: List(Text)): Text {
  if mod_is_local(s.locals, name) { name } else { mod_name_from(list_len(path), s, name, path) }
}

pub fn mod_module_from(n: Nat, s: ModState, m: Text, path: List(Text)): Option(Text) {
  match n: Option(Text) {
    Zero => if Ordmap::contains(s.modules, m, Ordmap::compare_text) { Some(m) } else { None }
    Succ(k) => if Ordmap::contains(
      s.modules,
      mod_join(mod_take(Succ(k), path), m),
      Ordmap::compare_text
    ) {
      Some(mod_join(mod_take(Succ(k), path), m))
    } else {
      mod_module_from(k, s, m, path)
    }
  }
}

pub fn mod_module(s: ModState, m: Text, path: List(Text)): Option(Text) {
  mod_module_from(list_len(path), s, m, path)
}

mutual {
  pub fn mod_dotted(t: SurfaceTerm): Option(List(Text)) {
    match t: Option(List(Text)) {
      SurfaceTermIndexedMk(sk, start, end, ast_occurrence) => mod_dotted_kind(sk)
    }
  }

  pub fn mod_dotted_kind(sk: SurfaceKind): Option(List(Text)) {
    match sk: Option(List(Text)) {
      SkVar(n) => Some(Cons(n, Nil))
      SkField(base, name) => match mod_dotted(base): Option(List(Text)) {
        Some(parts) => Some(List::append(parts, Cons(name, Nil)))
        None => None
      }
      _ => None
    }
  }
}

pub fn mod_check_local(&mut s: ModState, name: Text, path: List(Text), start: Nat, end: Nat): Unit {
  match mod_module(s, name, path): Unit {
    Some(m) => mod_error(&mut s, cat3(name, " is the name of a module", ""), start, end)
    None => #()
  }
}

pub fn mod_check_locals(
  names: List(Text),
  &mut s: ModState,
  path: List(Text),
  start: Nat,
  end: Nat
): Unit {
  match names: Unit {
    Nil => #()
    Cons(n, rest) => {
      mod_check_local(&mut s, n, path, start, end)
      mod_check_locals(rest, &mut s, path, start, end)
    }
  }
}

pub fn mod_bind_names(
  names: List(Text),
  &mut s: ModState,
  path: List(Text),
  start: Nat,
  end: Nat
): Unit {
  mod_check_locals(names, &mut s, path, start, end)
  let outer := s.locals
  set_to(&mut s.locals, List::append(names, outer))
}

pub fn mod_optional_name(name: Option(Text)): List(Text) {
  match name: List(Text) {
    None => Nil
    Some(value) => Cons(value, Nil)
  }
}

pub fn mod_dots(parts: List(Text)): List(Text) {
  match parts: List(Text) {
    Nil => Nil
    Cons(p, rest) => Cons(".", Cons(p, mod_dots(rest)))
  }
}

pub fn mod_qualified(s: ModState, parts: List(Text), path: List(Text)): Option(Text) {
  match parts: Option(Text) {
    Nil => None
    Cons(first, rest) => if mod_is_local(s.locals, first) {
      None
    } else {
      match mod_module(s, first, path): Option(Text) {
        Some(full) => Some(Text::concat_all(Cons(full, mod_dots(rest))))
        None => None
      }
    }
  }
}

pub fn mod_qualified_kind(s: ModState, sk: SurfaceKind, path: List(Text)): Option(Text) {
  match sk: Option(Text) {
    SkField(base, name) => match mod_dotted_kind(sk): Option(Text) {
      Some(parts) => mod_qualified(s, parts, path)
      None => None
    }
    _ => None
  }
}

mutual {
  pub fn mod_term(t: SurfaceTerm, &mut s: ModState, path: List(Text)): SurfaceTerm {
    match t: SurfaceTerm {
      SurfaceTermIndexedMk(sk, start, end, ast_occurrence) => match mod_qualified_kind(
        s,
        sk,
        path
      ): SurfaceTerm {
        Some(full) => SurfaceTerm { occurrence: None, kind: SkVar(full), start: start, end: end }
        None => {
          let k2 := mod_kind(sk, &mut s, path, sk, start, end)
          SurfaceTerm { occurrence: None, kind: k2, start: start, end: end }
        }
      }
    }
  }

  pub fn mod_kind(
    sk: SurfaceKind,
    &mut s: ModState,
    path: List(Text),
    whole: SurfaceKind,
    start: Nat,
    end: Nat
  ): SurfaceKind {
    match sk: SurfaceKind {
      SkVar(n) => SkVar(mod_name(s, n, path))
      SkApp(f, args) => {
        let f2 := mod_term(f, &mut s, path)
        let args2 := mod_terms(args, &mut s, path)
        SkApp(f2, args2)
      }
      SkLam(params, body) => {
        let outer := s.locals
        mod_bind_names(params, &mut s, path, start, end)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        SkLam(params, b)
      }
      SkBorrowLam(borrows, lam) => {
        let l := mod_term(lam, &mut s, path)
        SkBorrowLam(borrows, l)
      }
      SkBorrow(m, x) => {
        let x2 := mod_term(x, &mut s, path)
        SkBorrow(m, x2)
      }
      SkTagged(tag, x) => {
        let x2 := mod_term(x, &mut s, path)
        SkTagged(tag, x2)
      }
      SkRecord(name, fields) => {
        let fs := mod_fields(fields, &mut s, path)
        SkRecord(name, fs)
      }
      SkIf(c, th, el) => {
        let c2 := mod_term(c, &mut s, path)
        let t2 := mod_term(th, &mut s, path)
        let e2 := mod_opt_term(el, &mut s, path)
        SkIf(c2, t2, e2)
      }
      SkField(base, name) => {
        let b := mod_term(base, &mut s, path)
        SkField(b, name)
      }
      SkPerform(eff, args) => {
        let args2 := mod_terms(args, &mut s, path)
        SkPerform(eff, args2)
      }
      SkBudget(steps_memory, steps, body) => {
        let a := mod_term(steps, &mut s, path)
        let b := mod_term(body, &mut s, path)
        SkBudget(steps_memory, a, b)
      }
      SkBlock(stmts) => {
        let outer := s.locals
        let ss := mod_stmts(stmts, &mut s, path)
        set_to(&mut s.locals, outer)
        SkBlock(ss)
      }
      SkHandle(body, handlers) => {
        let b := mod_term(body, &mut s, path)
        let hs := mod_handlers(handlers, &mut s, path)
        SkHandle(b, hs)
      }
      SkMatch(scrutinee, r, arms, binder) => {
        let sc := mod_term(scrutinee, &mut s, path)
        let result := mod_opt_term(r, &mut s, path)
        let outer := s.locals
        mod_bind_names(mod_optional_name(binder), &mut s, path, start, end)
        let as2 := mod_arms(arms, &mut s, path)
        set_to(&mut s.locals, outer)
        SkMatch(sc, result, as2, binder)
      }
      _ => whole
    }
  }

  pub fn mod_terms(ts: List(SurfaceTerm), &mut s: ModState, path: List(Text)): List(SurfaceTerm) {
    match ts: List(SurfaceTerm) {
      Nil => Nil
      Cons(t, rest) => {
        let h := mod_term(t, &mut s, path)
        let tl := mod_terms(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_opt_term(
    t: Option(SurfaceTerm),
    &mut s: ModState,
    path: List(Text)
  ): Option(SurfaceTerm) {
    match t: Option(SurfaceTerm) {
      None => None
      Some(x) => {
        let x2 := mod_term(x, &mut s, path)
        Some(x2)
      }
    }
  }

  pub fn mod_fields(
    fs: List(SurfaceField),
    &mut s: ModState,
    path: List(Text)
  ): List(SurfaceField) {
    match fs: List(SurfaceField) {
      Nil => Nil
      Cons(f, rest) => {
        let h := mod_field(f, &mut s, path)
        let tl := mod_fields(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_field(f: SurfaceField, &mut s: ModState, path: List(Text)): SurfaceField {
    match f: SurfaceField {
      SurfaceFieldMk(name, value) => {
        let v := mod_term(value, &mut s, path)
        SurfaceField { name: name, value: v }
      }
    }
  }

  pub fn mod_handlers(
    hs: List(SurfaceHandler),
    &mut s: ModState,
    path: List(Text)
  ): List(SurfaceHandler) {
    match hs: List(SurfaceHandler) {
      Nil => Nil
      Cons(h, rest) => {
        let h2 := mod_handler(h, &mut s, path)
        let tl := mod_handlers(rest, &mut s, path)
        Cons(h2, tl)
      }
    }
  }

  pub fn mod_handler(h: SurfaceHandler, &mut s: ModState, path: List(Text)): SurfaceHandler {
    match h: SurfaceHandler {
      HdReturn(p, body) => {
        let outer := s.locals
        mod_bind_names(pattern_names(p, Nil), &mut s, path, body.start, body.end)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        HdReturn(p, b)
      }
      HdOperation(eff, hfa, hty, ps, cont, guard, body) => {
        let outer := s.locals
        mod_bind_names(
          List::append(pattern_names_each(ps, Nil), mod_optional_name(cont)),
          &mut s,
          path,
          body.start,
          body.end
        )
        let g := mod_opt_term(guard, &mut s, path)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        HdOperation(eff, hfa, hty, ps, cont, g, b)
      }
    }
  }

  pub fn mod_arms(arms: List(SurfaceArm), &mut s: ModState, path: List(Text)): List(SurfaceArm) {
    match arms: List(SurfaceArm) {
      Nil => Nil
      Cons(a, rest) => {
        let h := mod_arm(a, &mut s, path)
        let tl := mod_arms(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_arm(a: SurfaceArm, &mut s: ModState, path: List(Text)): SurfaceArm {
    match a: SurfaceArm {
      SurfaceArmMk(pattern, guard, goal, body) => {
        let outer := s.locals
        mod_bind_names(pattern_names(pattern, Nil), &mut s, path, body.start, body.end)
        let g := mod_opt_term(guard, &mut s, path)
        let target := mod_opt_term(goal, &mut s, path)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        SurfaceArm { pattern: pattern, guard: g, goal: target, body: b }
      }
    }
  }

  pub fn mod_stmts(
    stmts: List(SurfaceStmt),
    &mut s: ModState,
    path: List(Text)
  ): List(SurfaceStmt) {
    match stmts: List(SurfaceStmt) {
      Nil => Nil
      Cons(st, rest) => {
        let h := mod_stmt(st, &mut s, path, st)
        let tl := mod_stmts(rest, &mut s, path)
        Cons(h, tl)
      }
    }
  }

  pub fn mod_fn(f: SurfaceFn, &mut s: ModState, path: List(Text)): SurfaceFn {
    match f: SurfaceFn {
      SurfaceFnMk(
        name,
        generics,
        bounds,
        params,
        borrows,
        param_types,
        result,
        effects,
        wheres,
        start,
        end,
        body
      ) => {
        let outer := s.locals
        mod_bind_names(List::append(generics, params), &mut s, path, start, end)
        let b := mod_term(body, &mut s, path)
        set_to(&mut s.locals, outer)
        SurfaceFn {
          name: name,
          generics: generics,
          bounds: bounds,
          params: params,
          borrows: borrows,
          param_types: param_types,
          result: result,
          effects: effects,
          wheres: wheres,
          start: start,
          end: end,
          body: b
        }
      }
    }
  }

  pub fn mod_stmt(
    st: SurfaceStmt,
    &mut s: ModState,
    path: List(Text),
    whole: SurfaceStmt
  ): SurfaceStmt {
    match st: SurfaceStmt {
      StLet(name, ty, value, b, bm) => {
        mod_check_local(&mut s, name, path, value.start, value.end)
        let v := mod_term(value, &mut s, path)
        let outer := s.locals
        set_to(&mut s.locals, Cons(name, outer))
        StLet(name, ty, v, b, bm)
      }
      StVar(name, ty, value, vb) => {
        mod_check_local(&mut s, name, path, value.start, value.end)
        let v := mod_term(value, &mut s, path)
        let outer := s.locals
        set_to(&mut s.locals, Cons(name, outer))
        StVar(name, ty, v, vb)
      }
      StAssign(name, name_place, value) => {
        let p := mod_opt_term(name_place, &mut s, path)
        let v := mod_term(value, &mut s, path)
        StAssign(name, p, v)
      }
      StFn(f) => {
        let f2 := mod_fn(f, &mut s, path)
        StFn(f2)
      }
      StWhile(c, body) => {
        let c2 := mod_term(c, &mut s, path)
        let b := mod_term(body, &mut s, path)
        StWhile(c2, b)
      }
      StReturn(e) => {
        let e2 := mod_opt_term(e, &mut s, path)
        StReturn(e2)
      }
      StExpr(e) => {
        let e2 := mod_term(e, &mut s, path)
        StExpr(e2)
      }
      StMutual(items, a, b) => {
        let items2 := mod_stmts(items, &mut s, path)
        StMutual(items2, a, b)
      }
      _ => whole
    }
  }
}

pub fn mod_renamed(path: List(Text), f: SurfaceFn): SurfaceFn {
  SurfaceFn {
    name: mod_join(path, f.name),
    generics: f.generics,
    bounds: f.bounds,
    params: f.params,
    borrows: f.borrows,
    param_types: f.param_types,
    result: f.result,
    effects: f.effects,
    wheres: f.wheres,
    start: f.start,
    end: f.end,
    body: f.body
  }
}

pub fn mod_rename_fns(path: List(Text), fns: List(SurfaceFn)): List(SurfaceFn) {
  match fns: List(SurfaceFn) {
    Nil => Nil
    Cons(f, rest) => Cons(mod_renamed(path, f), mod_rename_fns(path, rest))
  }
}

// A statement inside a module: its functions take the module's name.
pub fn mod_rename_stmt(path: List(Text), st: SurfaceStmt): SurfaceStmt {
  match st: SurfaceStmt {
    StFn(f) => StFn(mod_renamed(path, f))
    StExtern(l, fns, a, b) => StExtern(l, mod_rename_fns(path, fns), a, b)
    _ => st
  }
}

pub fn mod_placed(path: List(Text), st: SurfaceStmt): SurfaceStmt {
  match path: SurfaceStmt {
    Nil => st
    Cons(p, more) => mod_rename_stmt(Cons(p, more), st)
  }
}

// The statements of the modules, flattened, the last first in `out`.
mutual {
  pub fn mod_flatten(
    stmts: List(SurfaceStmt),
    &mut s: ModState,
    path: List(Text),
    out: List(SurfaceStmt)
  ): List(SurfaceStmt) {
    match stmts: List(SurfaceStmt) {
      Nil => out
      Cons(st, rest) => {
        let inner := mod_flatten_one(st, &mut s, path, out, st)
        mod_flatten(rest, &mut s, path, inner)
      }
    }
  }

  pub fn mod_flatten_one(
    st: SurfaceStmt,
    &mut s: ModState,
    path: List(Text),
    out: List(SurfaceStmt),
    whole: SurfaceStmt
  ): List(SurfaceStmt) {
    match st: List(SurfaceStmt) {
      StModule(name, items, a, b) => {
        let outer := s.locals
        let result := mod_flatten(items, &mut s, List::append(path, Cons(name, Nil)), out)
        set_to(&mut s.locals, outer)
        result
      }
      _ => {
        let outer := s.locals
        let st2 := mod_stmt(whole, &mut s, path, whole)
        set_to(&mut s.locals, outer)
        Cons(mod_placed(path, st2), out)
      }
    }
  }
}

pub fn mod_classes(stmts: List(SurfaceStmt), acc: Ordmap(Text, Bool)): Ordmap(Text, Bool) {
  match stmts: Ordmap(Text, Bool) {
    Nil => acc
    Cons(st, rest) => match st: Ordmap(Text, Bool) {
      StClass(c) => mod_classes(rest, Ordmap::insert(acc, c.name, true, Ordmap::compare_text))
      _ => mod_classes(rest, acc)
    }
  }
}

pub fn mod_resolve_all(stmts: List(SurfaceStmt)): ModResolved {
  var s: ModState := ModState {
    modules: Ordmap::empty(),
    fns: Ordmap::empty(),
    locals: Nil,
    errors: Nil
  }
  mod_collect(stmts, &mut s, mod_classes(stmts, Ordmap::empty()), Nil)
  let out := mod_flatten(stmts, &mut s, Nil, Nil)
  ModResolved { stmts: List::reverse(out), errors: List::reverse(s.errors) }
}

pub fn modules_flatten(stmts: List(SurfaceStmt)): ModResolved {
  if mod_has_module(
    stmts
  ) { mod_resolve_all(stmts) } else { ModResolved { stmts: stmts, errors: Nil } }
}

mutual {
  pub fn modules_drop_sets(stmts: List(SurfaceStmt)): List(SurfaceStmt) {
    match stmts: List(SurfaceStmt) {
      Nil => Nil
      Cons(s, rest) => modules_drop_one(s, modules_drop_sets(rest))
    }
  }

  pub fn modules_drop_one(s: SurfaceStmt, more: List(SurfaceStmt)): List(SurfaceStmt) {
    match s: List(SurfaceStmt) {
      StEffect(e) => match e.set: List(SurfaceStmt) {
        Some(names) => more
        None => Cons(s, more)
      }
      StMutual(items, a, b) => Cons(StMutual(modules_drop_sets(items), a, b), more)
      StModule(name, items, a, b) => Cons(StModule(name, modules_drop_sets(items), a, b), more)
      _ => Cons(s, more)
    }
  }
}

// Flattens the modules of `stmts`, and drops the declarations of sets of
// effects (`effect Host {Div, stdout}`): a set is a name for effects, not
// an effect, so what follows never sees it as one.
pub fn modules_resolve(stmts: List(SurfaceStmt)): ModResolved {
  let flat := modules_flatten(stmts)
  ModResolved { stmts: modules_drop_sets(flat.stmts), errors: flat.errors }
}
