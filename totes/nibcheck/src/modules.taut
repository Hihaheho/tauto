// Continued from `modules_head.taut`.

pub fn mod_renamed(path: List(Text), f: SurfaceFn): SurfaceFn {
  SurfaceFn {
    name: mod_join(path, f.name),
    generics: f.generics,
    bounds: f.bounds,
    params: f.params,
    r#borrows: f.r#borrows,
    param_types: f.param_types,
    result: f.result,
    effects: f.effects,
    wheres: f.wheres,
    start: f.start,
    end: f.end,
    body: f.body,
    lends: f.lends,
    generic_types: f.generic_types,
    bound_starts: f.bound_starts,
    visibility: f.visibility,
    row_hole: f.row_hole,
    unused: f.unused,
    unused_generics: f.unused_generics,
    unused_params: f.unused_params
  }
}

pub fn mod_rename_fns(path: List(Text), fns: List(SurfaceFn)): List(SurfaceFn) {
  match fns {
    Nil => Nil
    Cons(f, rest) => Cons(mod_renamed(path, f), mod_rename_fns(path, rest))
  }
}

// A struct's constructor is named as the struct (`Judgement::Binder`), and
// an enum's under its type (`Shape::Kind::Circle`).
pub fn mod_rename_ctors(
  path: List(Text),
  name: Text,
  cs: List(SurfaceDataCtor)
): List(SurfaceDataCtor) {
  match cs {
    Nil => Nil
    Cons(k, rest) => Cons(
      SurfaceDataCtor {
        name: if k.name == name { mod_join(path, k.name) } else { cat3(mod_join(path, name), "::", k.name) },
        fields: k.fields
      },
      mod_rename_ctors(path, name, rest)
    )
  }
}

pub fn mod_renamed_data(path: List(Text), d: SurfaceData): SurfaceData {
  SurfaceData {
    kind: d.kind,
    name: mod_join(path, d.name),
    generics: d.generics,
    constructors: mod_rename_ctors(path, d.name, d.constructors),
    start: d.start,
    end: d.end,
    coerce_level: d.coerce_level,
    coerce_field: d.coerce_field,
    visibility: d.visibility,
    unused_generics: d.unused_generics,
    rows: d.rows
  }
}

// A statement inside a module: its functions and types take the module's
// name, as a program names them (`Task::join`, `Judgement::Binder`).
pub fn mod_rename_stmt(path: List(Text), st: SurfaceStmt): SurfaceStmt {
  match st {
    StFn(f) => StFn(mod_renamed(path, f))
    StExtern(fns, instances, types, structs, enums, a, b) => StExtern(
      mod_rename_fns(path, fns),
      instances,
      types,
      structs,
      enums,
      a,
      b
    )
    StStruct(d) => StStruct(mod_renamed_data(path, d))
    StEnum(d) => StEnum(mod_renamed_data(path, d))
    _ => st
  }
}

pub fn mod_placed(path: List(Text), st: SurfaceStmt): SurfaceStmt {
  match path {
    Nil => st
    Cons(p, more) => mod_rename_stmt(Cons(p, more), st)
  }
}

// The statements of the modules, flattened, the last first in `out`.
mutual {
  pub fn mod_flatten(
    stmts: List(SurfaceStmt),
    s: &mut ModState,
    path: List(Text),
    out: List(SurfaceStmt)
  ): List(SurfaceStmt) {
    match stmts {
      Nil => out
      Cons(st, rest) => {
        let inner := mod_flatten_one(st, &mut s, path, out, st)
        mod_flatten(rest, &mut s, path, inner)
      }
    }
  }

  pub fn mod_flatten_one(
    st: SurfaceStmt,
    s: &mut ModState,
    path: List(Text),
    out: List(SurfaceStmt),
    whole: SurfaceStmt
  ): List(SurfaceStmt) {
    match st {
      _ => {
        let outer := s.locals
        let st2 := mod_stmt(whole, &mut s, path, whole)
        set_to(&mut s.locals, outer)
        Cons(mod_placed(path, st2), out)
      }
    }
  }
}

pub fn mod_classes(stmts: List(SurfaceStmt), acc: Ordmap(Text, Bool)): Ordmap(Text, Bool) {
  match stmts {
    Nil => acc
    Cons(st, rest) => ⊢ Ordmap(Text, Bool) from match st {
      StClass(c) => mod_classes(rest, Ordmap::insert(acc, c.name, true, Ordmap::compare_text))
      _ => mod_classes(rest, acc)
    }
  }
}

pub fn mod_resolve_all(stmts: List(SurfaceStmt)): ModResolved {
  var s: ModState := ModState {
    modules: Ordmap::empty(),
    fns: Ordmap::empty(),
    types: Ordmap::empty(),
    ctors: Ordmap::empty(),
    ctor_fulls: Ordmap::empty(),
    locals: Nil,
    errors: Nil
  }
  mod_collect(stmts, &mut s, mod_classes(stmts, Ordmap::empty()), Nil)
  let out := mod_flatten(stmts, &mut s, Nil, Nil)
  ModResolved { stmts: List::reverse(out), errors: List::reverse(s.errors) }
}

pub fn modules_flatten(stmts: List(SurfaceStmt)): ModResolved {
  if mod_has_module(
    stmts
  ) { mod_resolve_all(stmts) } else { ModResolved { stmts: stmts, errors: Nil } }
}

mutual {
  pub fn modules_drop_sets(stmts: List(SurfaceStmt)): List(SurfaceStmt) {
    match stmts {
      Nil => Nil
      Cons(s, rest) => modules_drop_one(s, modules_drop_sets(rest))
    }
  }

  pub fn modules_drop_one(s: SurfaceStmt, more: List(SurfaceStmt)): List(SurfaceStmt) {
    match s {
      StEffect(e) => ⊢ List(SurfaceStmt) from match e.set {
        Some(^names) => more
        None => Cons(s, more)
      }
      StMutual(items, a, b) => Cons(StMutual(modules_drop_sets(items), a, b), more)
      _ => Cons(s, more)
    }
  }
}

// Flattens the modules of `stmts`, and drops the declarations of sets of
// effects (`effect Host {div, stdout}`): a set is a name for effects, not
// an effect, so what follows never sees it as one.
pub fn modules_resolve(stmts: List(SurfaceStmt)): ModResolved {
  let flat := modules_flatten(stmts)
  let inherited := expand_superclasses(modules_drop_sets(flat.stmts), Nil)
  let errors := List::map((e: SuperclassError) => {
    let message := match e.name { None => msg0(e.id), Some(n) => msg_with(e.id, [marg("name", n)]) }
    TypeErrorMk(message, e.start, e.end)
  }, inherited.snd)
  ModResolved { stmts: inherited.fst, errors: List::append(flat.errors, errors) }
}
