// Continued from `types_decl_head.taut`.

pub fn ck_register_ctors(cs: List(DataCtor), c: &mut Checker, dname: Text, i: Nat): Unit {
  match cs {
    Nil => #()
    Cons(k, rest) => {
      let m := Ordmap::insert(
        c.datas.ctors,
        k.name,
        #(dname, i),
        Ordmap::compare_text
      )
      let m2 := Ordmap::insert(
        m,
        cat3(dname, "::", k.name),
        #(dname, i),
        Ordmap::compare_text
      )
      set_to(&mut c.datas, Datas { decls: c.datas.decls, ctors: m2, owners: datas_owners_insert(c.datas.owners, k.name, dname, i), coerces: c.datas.coerces, steps: c.datas.steps, lower: c.datas.lower })
      ck_register_ctors(rest, &mut c, dname, i + 1)
    }
  }
}

pub fn ctors_have_fields(cs: List(SurfaceDataCtor)): Bool {
  match cs {
    Nil => false
    Cons(k, rest) => ⊢ Bool from match k.fields {
      Cons(^f, ^more) => true
      Nil => ctors_have_fields(rest)
    }
  }
}

// An extern type declared to hold a borrow: `type(borrow) Iter(A: Type)` or
// `type(affine, borrow) Guard`, read as the words `borrow` and `affine, borrow`.
pub fn kind_words_borrow(k: Text): Bool {
  k == "borrow" || kind_words_without_borrow(k) != k
}

// The kind written beside `borrow`: `affine, borrow` is `affine`.
pub fn kind_words_without_borrow(k: Text): Text {
  match Text::len(k) < 8 {
    true => k
    false => ⊢ Text from match Text::slice_or_empty(k, Text::len(k) - 8, Text::len(k)) == ", borrow" {
      true => Text::slice_or_empty(k, 0, Text::len(k) - 8)
      false => k
    }
  }
}

pub fn surface_data_is_view(d: SurfaceData): Bool {
  match d.kind {
    Some(k) => kind_words_borrow(k)
    None => false
  }
}

pub fn data_declared(d: SurfaceData): Option(Kind) {
  match d.kind {
    Some(k) => ⊢ Option(Kind) from match k == "borrow" {
      true => Some(KindAffine)
      false => kind_parse(kind_words_without_borrow(k))
    }
    None => None
  }
}

// The level a `coerce` field is written with: `coerce`, `coerce(mut)` or
// `coerce(owned)`.
pub fn coerce_level_of(written: Text): CoerceLevel {
  if written == "coerce(mut)" {
    CoerceMut
  } else if written == "coerce(owned)" {
    CoerceOwned
  } else {
    CoerceRef
  }
}

// The struct's `coerce` field, recorded with the others.
pub fn data_coerces_with(m: Ordmap(Text, DataCoerce), d: SurfaceData, is_struct: Bool): Ordmap(Text, DataCoerce) {
  match d.coerce_level {
    Some(l) => if is_struct {
      Ordmap::insert(m, d.name, DataCoerce { field: d.coerce_field, level: coerce_level_of(l) }, Ordmap::compare_text)
    } else {
      m
    }
    None => m
  }
}

// Records a `struct` or `enum`; field types are checked again after all
// declarations are known (`ck_recheck_datas`).
pub fn ck_declare_data(c: &mut Checker, d: SurfaceData, is_struct: Bool, builtin: Bool): Unit {
  let view := surface_data_is_view(d)
  if view && (not(is_struct) || ctors_have_fields(d.constructors)) {
    ck_error(
      &mut c,
      view_decl_message(is_struct),
      TySpan { start: d.start, end: d.end }
    )
  }
  let generics := ck_param_generics(d.generics, KindLinear, Ordmap::empty())
  let constructors := ck_data_ctors(d.constructors, &mut c, generics)
  ck_register_ctors(constructors, &mut c, d.name, 0)
  let decl := Data {
    name: d.name,
    declared: data_declared(d),
    generics: d.generics,
    constructors: constructors,
    is_struct: is_struct,
    recursive: false,
    base: KindLinear,
    holds: d.generics,
    builtin: builtin,
    view: view
  }
  set_to(
    &mut c.datas,
    Datas {
      decls: Ordmap::insert(c.datas.decls, d.name, decl, Ordmap::compare_text),
      ctors: c.datas.ctors,
      owners: c.datas.owners,
      coerces: data_coerces_with(c.datas.coerces, d, is_struct),
      steps: c.datas.steps,
      lower: c.datas.lower
    }
  )
}

pub fn data_with_recursive(data: Data, recursive: Bool): Data {
  Data {
    name: data.name,
    declared: data.declared,
    generics: data.generics,
    constructors: data.constructors,
    is_struct: data.is_struct,
    recursive: recursive,
    base: data.base,
    holds: data.holds,
    builtin: data.builtin,
    view: data.view
  }
}

pub fn datas_mark_recursive(d: Datas, n: Text): Datas {
  match datas_decl(d, n) {
    None => d
    Some(data) => Datas {
      decls: Ordmap::insert(
        d.decls,
        n,
        data_with_recursive(data, datas_reaches_from(d, n, n)),
        Ordmap::compare_text
      ),
      ctors: d.ctors,
      owners: d.owners,
      coerces: d.coerces,
      steps: d.steps,
      lower: d.lower
    }
  }
}

pub fn ck_mark_recursive(names: List(Text × Data), c: &mut Checker): Unit {
  match names {
    Nil => #()
    Cons(entry, rest) => {
      set_to(&mut c.datas, datas_mark_recursive(c.datas, entry.fst))
      ck_mark_recursive(rest, &mut c)
    }
  }
}

pub fn data_with_view(data: Data, view: Bool): Data {
  Data {
    name: data.name,
    declared: data.declared,
    generics: data.generics,
    constructors: data.constructors,
    is_struct: data.is_struct,
    recursive: data.recursive,
    base: data.base,
    holds: data.holds,
    builtin: data.builtin,
    view: view
  }
}

// A declaration that holds a view is one (`find_views` of `types.rs`), not
// only an extern `type(borrow)`.
pub fn datas_mark_view(d: Datas, n: Text): Datas {
  match datas_decl(d, n) {
    None => d
    Some(data) => Datas {
      decls: Ordmap::insert(d.decls, n, data_with_view(data, data_is_view(d, n)), Ordmap::compare_text),
      ctors: d.ctors,
      owners: d.owners,
      coerces: d.coerces,
      steps: d.steps,
      lower: d.lower
    }
  }
}

pub fn datas_mark_views(names: List(Text × Data), d: Datas): Datas {
  match names {
    Nil => d
    Cons(entry, rest) => datas_mark_views(rest, datas_mark_view(d, entry.fst))
  }
}

// The first field whose kind is looser than the declared one: the message.
pub fn ck_declared_fields(
  fs: List(DataField),
  datas: Datas,
  cname: Text,
  least: Ordmap(Text, Ty),
  declared: Kind,
  i: Nat
): Option(Text) {
  match fs {
    Nil => None
    Cons(f, rest) => {
      let k := datas_kind(datas, ty_substitute(f.ty, least))
      if not(kind_fits(k, declared)) || (kind_eq(declared, KindCopy) && not(kind_eq(k, KindCopy))) {
        let field := ⊢ Text from match f.name {
          Some(n) => n
          None => cat3(Text::of_nat(i), " of ", cname)
        }
        Some(
          cat5("declared ", kind_name(declared), " but field ", field, cat2(" is ", kind_name(k)))
        )
      } else {
        ck_declared_fields(rest, datas, cname, least, declared, i + 1)
      }
    }
  }
}

pub fn ck_declared_ctors(
  cs: List(DataCtor),
  datas: Datas,
  least: Ordmap(Text, Ty),
  declared: Kind
): Option(Text) {
  match cs {
    Nil => None
    Cons(k, rest) => ⊢ Option(Text) from match ck_declared_fields(
      k.fields,
      datas,
      k.name,
      least,
      declared,
      0
    ) {
      Some(m) => Some(m)
      None => ck_declared_ctors(rest, datas, least, declared)
    }
  }
}

pub fn ck_declared_message(d: SurfaceData, data: Data, declared: Kind): Option(Text) {
  if data.recursive && kind_rank(declared) < kind_rank(KindShared) {
    Some(
      declared_shared_holds_itself_message(kind_name(declared), d.name)
    )
  } else {
    None
  }
}

pub fn ck_finish_message(datas: Datas, d: SurfaceData): Option(Text) {
  match datas_decl(datas, d.name) {
    None => None
    Some(data) => ⊢ Option(Text) from match data.declared {
      None => None
      Some(declared) => ⊢ Option(Text) from match ck_declared_message(d, data, declared) {
        Some(m) => Some(m)
        None => ck_declared_ctors(
          data.constructors,
          datas,
          ck_param_generics(data.generics, KindCopy, Ordmap::empty()),
          declared
        )
      }
    }
  }
}

pub fn ck_finish_decl(c: &mut Checker, d: SurfaceData): Unit {
  match ck_finish_message(c.datas, d) {
    None => #()
    Some(m) => ck_error(&mut c, m, TySpan { start: d.start, end: d.end })
  }
}

pub fn ck_finish_stmt(c: &mut Checker, s: SurfaceStmt): Unit {
  match s {
    StStruct(d) => ck_finish_decl(&mut c, d)
    StEnum(d) => ck_finish_decl(&mut c, d)
    _ => #()
  }
}

pub fn ck_finish_stmts(ss: List(SurfaceStmt), c: &mut Checker): Unit {
  match ss {
    Nil => #()
    Cons(s, rest) => {
      ck_finish_stmt(&mut c, s)
      ck_finish_stmts(rest, &mut c)
    }
  }
}

// Which declarations hold themselves, and whether a written kind is looser
// than what the fields give.
pub fn ck_finish_datas(c: &mut Checker, program: List(SurfaceStmt)): Unit {
  ck_mark_recursive(Ordmap::entries(c.datas.decls), &mut c)
  set_to(&mut c.datas, datas_summarize(c.datas))
  ck_finish_stmts(program, &mut c)
}

// A declaration that holds a borrow: an extern `type(borrow)`, or one whose fields
// hold one.
pub fn ck_declared_view(c: Checker, n: Text): Bool {
  data_is_view(c.datas, n)
}

// A type that holds a borrow, received as one is: a borrow, a declaration
// that holds one, or a type applied to one.
mutual {
  pub fn ck_any_view_in(k: Nat, c: &Checker, ts: List(Ty)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => ck_is_view_in(j, &c, t) || ck_any_view_in(j, &c, rest)
      }
    }
  }

  pub fn ck_is_view_in(k: Nat, c: &Checker, t: Ty): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ck_resolve(&c, t) {
        TyBorrow(^x, ^m) => true
        TyNamed(n, args) => ck_declared_view(
          c,
          surface_name_text(n)
        ) || ck_any_view_in(j, &c, args)
        _ => false
      }
    }
  }
}

pub fn ck_is_view(c: &Checker, t: Ty): Bool {
  ck_is_view_in(c.steps, &c, t)
}

mutual {
  pub fn ck_any_mut_borrow_in(k: Nat, c: &Checker, ts: List(Ty)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => ck_has_mut_borrow_in(j, &c, t) || ck_any_mut_borrow_in(j, &c, rest)
      }
    }
  }

  pub fn ck_has_mut_borrow_in(k: Nat, c: &Checker, t: Ty): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ck_resolve(&c, t) {
        TyBorrow(inner, m) => m || ck_has_mut_borrow_in(j, &c, inner)
        TyNamed(^n, args) => ck_any_mut_borrow_in(j, &c, args)
        _ => false
      }
    }
  }
}

pub fn ck_has_mut_borrow(c: &Checker, t: Ty): Bool {
  ck_has_mut_borrow_in(c.steps, &c, t)
}

// The value a view of duplicable things stands for (`&A == A`), or `None`
// when something in it is not duplicable or is a `&mut`.
mutual {
  pub fn ck_view_values_in(k: Nat, c: &Checker, ts: List(Ty)): Option(List(Ty)) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(List(Ty)) from match ts {
        Nil => Some(Nil)
        Cons(t, rest) => ⊢ Option(List(Ty)) from match ck_view_value_in(j, &c, t) {
          None => None
          Some(v) => ⊢ Option(List(Ty)) from match ck_view_values_in(j, &c, rest) {
            None => None
            Some(vs) => Some(Cons(v, vs))
          }
        }
      }
    }
  }

  pub fn ck_view_value_in(k: Nat, c: &Checker, t: Ty): Option(Ty) {
    match k {
      Zero => None
      Succ(j) => ⊢ Option(Ty) from match ck_resolve(&c, t) {
        TyBorrow(inner, m) => if m {
          None
        } else {
          ⊢ Option(Ty) from match ck_view_value_in(j, &c, inner) {
            None => None
            Some(v) => if kind_dup(ck_kind(&c, v)) { Some(v) } else { None }
          }
        }
        TyNamed(n, args) => if ck_declared_view(c, surface_name_text(n)) {
          None
        } else {
          ⊢ Option(Ty) from match ck_view_values_in(j, &c, args) {
            None => None
            Some(vs) => Some(TyNamed(n, vs))
          }
        }
        _ => Some(ck_resolve(&c, t))
      }
    }
  }
}

pub fn ck_view_value(c: &Checker, t: Ty): Option(Ty) {
  ck_view_value_in(c.steps, &c, t)
}

pub fn ck_bound_of(bounds: List(Option(Text)), i: Nat): Option(Kind) {
  match nth_item(bounds, i) {
    None => Some(KindAffine)
    Some(o) => ⊢ Option(Kind) from match o {
      None => Some(KindAffine)
      Some(b) => kind_parse_bound(b)
    }
  }
}

// The generics of a signature with their bounds, newest first, and the map
// from their names to type parameters.
pub(open) inductive SigGenerics: Type {
  SigGenericsMk(
    generics: List(Text × Kind),
    map: Ordmap(Text, Ty),
    // The type constructors among them, with the kind each takes.
    ctors: List(Text × Kind)
  ): SigGenerics
}

// `(k₁)->k₂`: the generic is a type constructor.
pub fn ck_ctor_bound_of(bounds: List(Option(Text)), i: Nat): Option(Kind × Kind) {
  match nth_item(bounds, i) {
    None => None
    Some(o) => ⊢ Option(Kind × Kind) from match o {
      None => None
      Some(b) => kind_parse_ctor(b)
    }
  }
}

pub fn sig_generics(
  gs: List(Text),
  bounds: List(Option(Text)),
  i: Nat,
  acc: SigGenerics
): SigGenerics {
  match gs {
    Nil => acc
    Cons(g, rest) => ⊢ SigGenerics from match ck_ctor_bound_of(bounds, i) {
      Some(ak) => sig_generics(
        rest,
        bounds,
        i + 1,
        SigGenerics {
          generics: Cons(#(g, ak.snd), acc.generics),
          map: Ordmap::insert(acc.map, g, TyParam(g, ak.snd), Ordmap::compare_text),
          ctors: Cons(#(g, ak.fst), acc.ctors)
        }
      )
      None => ⊢ SigGenerics from match ck_bound_of(bounds, i) {
        None => sig_generics(rest, bounds, i + 1, acc)
        Some(k) => sig_generics(
          rest,
          bounds,
          i + 1,
          SigGenerics {
            generics: Cons(#(g, k), acc.generics),
            map: Ordmap::insert(acc.map, g, TyParam(g, k), Ordmap::compare_text),
            ctors: acc.ctors
          }
        )
      }
    }
  }
}

pub fn ck_sig_written(c: &mut Checker, p: Option(SurfaceTerm), map: Ordmap(Text, Ty)): Ty {
  match p {
    Some(x) => ck_written(&mut c, x, map)
    None => {
      // No written type consumes the borrow-position flag for an inferred parameter.
      set_to(&mut c.under_borrow, false)
      ck_fresh(&mut c)
    }
  }
}

pub fn ck_sig_param(
  c: &mut Checker,
  p: Option(SurfaceTerm),
  b: Option(Bool),
  map: Ordmap(Text, Ty)
): Ty {
  set_to(&mut c.under_borrow, ⊢ Bool from match b {
    Some(^m) => true
    None => false
  })
  let t := ck_sig_written(&mut c, p, map)
  ⊢ Ty from match b {
    Some(m) => if ty_is_borrow(t) { t } else { TyBorrow(t, m) }
    None => t
  }
}

pub fn list_head_or_none<A>(xs: List(Option(A))): Option(A) {
  match xs {
    Nil => None
    Cons(o, ^more) => o
  }
}

pub fn ck_sig_params(
  pts: List(Option(SurfaceTerm)),
  c: &mut Checker,
  r#borrows: List(Option(Bool)),
  map: Ordmap(Text, Ty)
): List(Ty) {
  match pts {
    Nil => Nil
    Cons(p, rest) => {
      let wrapped := ck_sig_param(&mut c, p, list_head_or_none(r#borrows), map)
      let tl := ck_sig_params(rest, &mut c, List::tail(r#borrows), map)
      Cons(wrapped, tl)
    }
  }
}

pub fn ty_any_mut_borrow(ts: List(Ty)): Bool {
  match ts {
    Nil => false
    Cons(t, rest) => ⊢ Bool from match t {
      TyBorrow(^x, m) => m || ty_any_mut_borrow(rest)
      _ => ty_any_mut_borrow(rest)
    }
  }
}

pub fn ty_any_borrow(ts: List(Ty)): Bool {
  match ts {
    Nil => false
    Cons(t, rest) => ty_is_borrow(t) || ty_any_borrow(rest)
  }
}

pub fn ck_sig_result(c: &mut Checker, f: SurfaceFn, map: Ordmap(Text, Ty)): Ty {
  match f.result {
    Some(r) => ck_written(&mut c, r, map)
    None => ck_fresh(&mut c)
  }
}

// A view is returned only from a borrowed parameter: the message when not.
pub fn ck_view_result_message(c: Checker, params: List(Ty), result: Ty): Option(Text) {
  let shown := ty_show(ck_shown(&c, result))
  // A result that may hold a borrow needs a lender only when it is written
  // `&T` or `&mut T` itself; without one, the body's check sees that the
  // result borrows nothing (an extern, which has no body, is trusted to).
  let lends := ty_any_borrow(params)
  let written := ty_is_borrow(ck_resolve(&c, result))
  if not(ck_is_view(&c, result)) || not(lends || written) {
    None
  } else if ck_has_mut_borrow(&c, result) {
    if ty_any_mut_borrow(
      params
    ) { None } else { Some(return_needs_mut_parameter_message(shown)) }
  } else if lends {
    None
  } else {
    Some(return_needs_borrowed_parameter_message(shown))
  }
}

// What a signature's result says wrong, the first of it: a view returned
// without a lender (`ck_view_result_message`), then what `borrows(…)` names
// (`ck_lends_message`).
pub fn ck_signature_message(c: Checker, f: SurfaceFn, params: List(Ty), result: Ty): Option(Text) {
  match ck_view_result_message(c, params, result) {
    Some(m) => Some(m)
    None => ck_lends_message(c, f, params, result)
  }
}

// `borrows(m, x.f, place(Tree))`: the result holds a borrow, each path starts
// at a parameter that lends one or names an operation of the written row,
// and a result that holds a `&mut` borrow names a lender of one.
pub fn ck_lends_message(c: Checker, f: SurfaceFn, params: List(Ty), result: Ty): Option(Text) {
  match f.lends {
    None => None
    Some(paths) => {
      let shown := ty_show(ck_shown(&c, result))
      if not(ck_is_view(&c, result)) {
        Some(borrows_result_holds_no_borrow_message(shown))
      } else {
        ⊢ Option(Text) from match ck_lends_bad(c, f, params, paths) {
          Some(root) => Some(borrows_not_a_borrowed_parameter_message(root))
          None => if ck_has_mut_borrow(&c, result) && not(ck_lends_mut(c, f, params, paths)) {
            Some(return_needs_mut_parameter_message(shown))
          } else { None }
        }
      }
    }
  }
}

pub fn lends_root(path: Text): Text {
  match text_split(path, ".") {
    Cons(r, ^more) => r
    Nil => path
  }
}

pub fn lends_has_field(path: Text): Bool {
  match text_split(path, ".") {
    Cons(^r, Cons(^x, ^more)) => true
    _ => false
  }
}

pub fn lends_effects_have(es: List(RowEntry), key: Text): Bool {
  match es {
    Nil => false
    Cons(e, rest) => effect_key_text(row_entry_text(e)) == key || lends_effects_have(rest, key)
  }
}

// Whether `path` names an operation of the written row.
pub fn lends_in_row(f: SurfaceFn, path: Text): Bool {
  match f.effects {
    None => false
    Some(es) => not(lends_has_field(path)) && lends_effects_have(es, effect_key_text(path))
  }
}

pub fn lends_param_ty(names: List(Text), tys: List(Ty), root: Text): Option(Ty) {
  match names {
    Nil => None
    Cons(n, rest) => ⊢ Option(Ty) from match tys {
      Nil => None
      Cons(t, more) => if n == root { Some(t) } else { lends_param_ty(rest, more, root) }
    }
  }
}

// What the parameter a path starts at lends: `None` for a path that lends
// nothing, `Some(m)` for one that lends a borrow (`&mut` when `m`).
pub fn ck_lends_path(c: Checker, f: SurfaceFn, params: List(Ty), path: Text): Option(Bool) {
  if lends_in_row(f, path) { Some(false) } else {
    ⊢ Option(Bool) from match lends_param_ty(f.params, params, lends_root(path)) {
      None => None
      Some(t) => ⊢ Option(Bool) from match t {
        TyBorrow(^inner, m) => Some(m)
        _ => if ck_is_view(&c, t) { Some(ck_has_mut_borrow(&c, t)) } else { None }
      }
    }
  }
}

// The root of the first path that lends nothing.
pub fn ck_lends_bad(c: Checker, f: SurfaceFn, params: List(Ty), paths: List(Text)): Option(Text) {
  match paths {
    Nil => None
    Cons(p, rest) => ⊢ Option(Text) from match ck_lends_path(c, f, params, p) {
      None => Some(lends_root(p))
      Some(^m) => ck_lends_bad(c, f, params, rest)
    }
  }
}

// Whether a path lends a `&mut` borrow.
pub fn ck_lends_mut(c: Checker, f: SurfaceFn, params: List(Ty), paths: List(Text)): Bool {
  match paths {
    Nil => false
    Cons(p, rest) => ⊢ Bool from match ck_lends_path(c, f, params, p) {
      Some(true) => true
      _ => ck_lends_mut(c, f, params, rest)
    }
  }
}

pub fn generic_no_effects(effects: Option(List(RowEntry))): Bool {
  match effects {
    None => true
    Some(es) => ⊢ Bool from match es {
      Nil => true
      Cons(^e, ^rest) => false
    }
  }
}
pub fn generic_sort(n: Text): Bool {
  Text::slice_or_empty(n, 0, 4) == "Type" && generic_digits(n, 4, Text::len(n) - 4)
}
pub fn generic_digits(t: Text, at: Nat, k: Nat): Bool {
  match k {
    Zero => true
    Succ(j) => Text::byte_value(t, at) >= 48 && Text::byte_value(t, at) <= 57 && generic_digits(t, at + 1, j)
  }
}

// What native Nib takes as a generic: a sort (`Type`, `Type1`), `NoBorrow`,
// a sum of them (`Shared + NoBorrow`), a sort applied (`Type(u)`), or a pure
// function of them.
mutual {
  pub fn generic_native(k: Nat, t: SurfaceTerm): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match t.kind {
        SkVar(n) => surface_name_text(n) == "NoBorrow" || generic_sort(surface_name_text(n))
        SkApp(f, args) => ⊢ Bool from match f.kind {
          SkVar(n) => if surface_name_text(n) == "+" { generic_native_all(j, args) } else { generic_sort(surface_name_text(n)) }
          _ => false
        }
        SkPi(params, result, effects) => generic_no_effects(effects) && generic_native_params(j, params) && generic_native(j, result)
        _ => false
      }
    }
  }
  pub fn generic_native_all(k: Nat, ts: List(SurfaceTerm)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => true
        Cons(t, rest) => generic_native(j, t) && generic_native_all(j, rest)
      }
    }
  }
  pub fn generic_native_params(k: Nat, ps: List(SurfaceParam)): Bool {
    match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ps {
        Nil => true
        Cons(p, rest) => generic_native(j, p.ty) && generic_native_params(j, rest)
      }
    }
  }
}

// A generic of a signature that is a term rather than a type or a row
// (`<n: Nat>`): native Nib takes it as an ordinary parameter only once it is
// lowered to one, so it is reported, at its `n: Nat`.
pub fn term_generic_problem(f: SurfaceFn): Option(Text × TySpan) {
  term_generic_in(f, f.generics, 0)
}
pub fn term_generic_in(f: SurfaceFn, gs: List(Text), i: Nat): Option(Text × TySpan) {
  match gs {
    Nil => None
    Cons(g, rest) => if term_generic_at(f, i) {
      Some(#(term_generic_needs_extraction_message(g), term_generic_span(f, i)))
    } else {
      term_generic_in(f, rest, i + 1)
    }
  }
}
pub fn term_generic_at(f: SurfaceFn, i: Nat): Bool {
  match nth_item(f.bound_starts, i) {
    Some(o) => ⊢ Bool from match o {
      None => false
      Some(^s) => term_generic_written(f, i)
    }
    None => term_generic_written(f, i)
  }
}
pub fn term_generic_written(f: SurfaceFn, i: Nat): Bool {
  let typed := ⊢ Bool from match nth_item(f.generic_types, i) {
    None => false
    Some(t) => not(generic_native(1000, t))
  }
  let bounded := ⊢ Bool from match nth_item(f.bounds, i) {
    None => false
    Some(o) => ⊢ Bool from match o {
      None => false
      Some(b) => ⊢ Bool from match bound_kind_part(b) {
        None => false
        Some(k) => ⊢ Bool from match kind_parse(k) {
          Some(^x) => false
          None => ⊢ Bool from match kind_parse_ctor(k) {
            Some(^x) => false
            None => true
          }
        }
      }
    }
  }
  typed || bounded
}
pub fn term_generic_span(f: SurfaceFn, i: Nat): TySpan {
  match nth_item(f.bound_starts, i) {
    Some(o) => ⊢ TySpan from match o {
      Some(s) => ⊢ TySpan from match nth_item(f.generic_types, i) {
        Some(t) => TySpan { start: s, end: span_of(t).end }
        None => TySpan { start: f.start, end: f.end }
      }
      None => TySpan { start: f.start, end: f.end }
    }
    None => TySpan { start: f.start, end: f.end }
  }
}
// What a signature reports: a term generic first, else what its result says.
pub fn sig_report_message(c: Checker, f: SurfaceFn, params: List(Ty), result: Ty): Option(Text) {
  match term_generic_problem(f) {
    Some(p) => Some(p.fst)
    None => ck_signature_message(c, f, params, result)
  }
}
pub fn sig_report_span(f: SurfaceFn): TySpan {
  match term_generic_problem(f) {
    Some(p) => p.snd
    None => ck_sig_span(f)
  }
}

pub fn ck_sig_span(f: SurfaceFn): TySpan {
  match f.result {
    Some(r) => span_of(r)
    None => TySpan { start: f.start, end: f.end }
  }
}

pub fn ck_report(c: &mut Checker, message: Option(Text), span: TySpan): Unit {
  match message {
    None => #()
    Some(m) => ck_error(&mut c, m, span)
  }
}

pub fn generics_have(gs: List(Text × Kind), n: Text): Bool {
  match gs {
    Nil => false
    Cons(g, rest) => g.fst == n || generics_have(rest, n)
  }
}

pub fn preds_have(ps: List(Text × Text), r#class: Text, g: Text): Bool {
  match ps {
    Nil => false
    Cons(p, rest) => (p.fst == r#class && p.snd == g) || preds_have(rest, r#class, g)
  }
}

pub fn constraint_generic(t: SurfaceTerm, gs: List(Text × Kind)): Option(Text) {
  match t.kind {
    SkVar(g) => if generics_have(gs, surface_name_text(g)) { Some(surface_name_text(g)) } else { None }
    _ => None
  }
}

// The legacy monomorphic checker must not silently drop value indices.
// Checked dictionary expansion must remove indexed constraints before this
// path; preserve the source AST and reject the unsupported view here.
pub fn constraint_single_type(w: SurfaceConstraint): SurfaceTerm {
  match w.arguments {
    Nil => w.ty
    Cons(^index, ^rest) => surface_term_mk(SkOther("indexed class constraint"), w.start, w.end)
  }
}

pub fn ck_where_pred(
  c: &mut Checker,
  w: SurfaceConstraint,
  gs: List(Text × Kind),
  name: Text,
  preds: List(Text × Text)
): List(Text × Text) {
  let span: TySpan := TySpan { start: w.start, end: w.end }
  if not(
    class_is_structural(w.r#class)
  ) && not(Ordmap::contains(c.classes, w.r#class, Ordmap::compare_text)) {
    ck_error(&mut c, not_a_class_message(w.r#class), span)
    preds
  } else {
    ⊢ List(Text × Text) from match constraint_generic(constraint_single_type(w), gs) {
      None => {
        ck_error(&mut c, cat2("where constrains only generics of ", name), span)
        preds
      }
      Some(g) => if preds_have(preds, w.r#class, g) {
        ck_error(&mut c, predicate_written_twice_message(w.r#class, g), span)
        preds
      } else {
        Cons(#(w.r#class, g), preds)
      }
    }
  }
}

pub fn ck_where_preds(
  ws: List(SurfaceConstraint),
  c: &mut Checker,
  gs: List(Text × Kind),
  name: Text,
  preds: List(Text × Text)
): List(Text × Text) {
  match ws {
    Nil => preds
    Cons(w, rest) => {
      let next: List(Text × Text) := ck_where_pred(&mut c, w, gs, name, preds)
      ck_where_preds(rest, &mut c, gs, name, next)
    }
  }
}

pub fn ck_signature(c: &mut Checker, f: SurfaceFn): Scheme {
  let g := sig_generics(
    f.generics,
    f.bounds,
    0,
    SigGenerics { generics: Nil, map: Ordmap::empty(), ctors: Nil }
  )
  let params := ck_sig_params(f.param_types, &mut c, f.r#borrows, g.map)
  let result := ck_sig_result(&mut c, f, g.map)
  ck_report(&mut c, sig_report_message(c, f, params, result), sig_report_span(f))
  let preds: List(Text × Text) := ck_where_preds(f.wheres, &mut c, g.generics, f.name, Nil)
  Scheme {
    generics: List::reverse(g.generics),
    ty: TyFn(params, result, KindShared),
    preds: List::reverse(preds),
    ctors: List::reverse(g.ctors)
  }
}

pub fn ctor_arg_of(ctors: List(Text × Kind), g: Text): Option(Kind) {
  match ctors {
    Nil => None
    Cons(p, rest) => if p.fst == g { Some(p.snd) } else { ctor_arg_of(rest, g) }
  }
}

// Fresh variables for the generics; a type constructor's bound is checked
// once it is known, for `name`.
pub fn ck_instantiate_map_ctors(
  generics: List(Text × Kind),
  c: &mut Checker,
  ctors: List(Text × Kind),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty)
): Ordmap(Text, Ty) {
  match generics {
    Nil => map
    Cons(g, rest) => {
      let v := ck_fresh(&mut c)
      ⊢ Unit from match ctor_arg_of(ctors, g.fst) {
        Some(arg) => set_to(
          &mut c.ctor_bounds,
          Cons(
            TyCtorBound {
              ty: v,
              arg: arg,
              result: g.snd,
              what: name,
              start: span.start,
              end: span.end
            },
            c.ctor_bounds
          )
        )
        None => set_to(
          &mut c.bounds,
          Cons(TyBound { ty: v, kind: g.snd, start: span.start, end: span.end }, c.bounds)
        )
      }
      ck_instantiate_map_ctors(
        rest,
        &mut c,
        ctors,
        name,
        span,
        Ordmap::insert(map, g.fst, v, Ordmap::compare_text)
      )
    }
  }
}

pub fn ck_instantiate_map(
  generics: List(Text × Kind),
  c: &mut Checker,
  span: TySpan,
  map: Ordmap(Text, Ty)
): Ordmap(Text, Ty) {
  ck_instantiate_map_ctors(generics, &mut c, Nil, "", span, map)
}

pub fn ck_instantiate(c: &mut Checker, generics: List(Text × Kind), t: Ty, span: TySpan): Ty {
  let map := ck_instantiate_map(generics, &mut c, span, Ordmap::empty())
  ty_substitute(t, map)
}

pub fn ck_pend(c: &mut Checker, r#class: Text, t: Ty, what: Text, span: TySpan): Unit {
  set_to(
    &mut c.pending,
    Cons(
      TyPending {
        r#class: r#class,
        ty: t,
        what: what,
        assume: c.assume,
        start: span.start,
        end: span.end
      },
      c.pending
    )
  )
}

pub fn ck_pend_preds(
  ps: List(Text × Text),
  c: &mut Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): Unit {
  match ps {
    Nil => #()
    Cons(p, rest) => {
      ⊢ Unit from match Ordmap::get(map, p.snd, Ordmap::compare_text) {
        Some(t) => ck_pend(&mut c, p.fst, t, what, span)
        None => #()
      }
      ck_pend_preds(rest, &mut c, map, what, span)
    }
  }
}

// The generics a function's type mentions, with what a use gave each: a
// generic the type does not mention is no type argument a backend writes.
pub fn ck_use_generics(gs: List(Text × Kind), t: Ty, map: Ordmap(Text, Ty)): List(Text × Ty) {
  match gs {
    Nil => Nil
    Cons(g, rest) => if ty_param_in(t, g.fst) {
      ⊢ List(Text × Ty) from match Ordmap::get(map, g.fst, Ordmap::compare_text) {
        Some(v) => Cons(#(g.fst, v), ck_use_generics(rest, t, map))
        None => ck_use_generics(rest, t, map)
      }
    } else {
      ck_use_generics(rest, t, map)
    }
  }
}

// A use that gives no generic a type is not recorded: it has nothing to determine.
pub fn ck_uses_after(uses: List(TyUse), name: Text, gs: List(Text × Ty), span: TySpan): List(TyUse) {
  match gs {
    Nil => uses
    Cons(^g, ^rest) => Cons(TyUse { name: name, generics: gs, start: span.start, end: span.end }, uses)
  }
}

pub fn ck_record_use(c: &mut Checker, name: Text, gs: List(Text × Ty), span: TySpan): Unit {
  set_to(&mut c.uses, ck_uses_after(c.uses, name, gs, span))
}

// A function's type at a use, its constraints left to be checked once the
// types are known.
pub fn ck_instantiate_scheme(c: &mut Checker, name: Text, s: Scheme, span: TySpan): Ty {
  let map := ck_instantiate_map_ctors(s.generics, &mut c, s.ctors, name, span, Ordmap::empty())
  ck_pend_preds(s.preds, &mut c, map, name, span)
  ck_record_use(&mut c, name, ck_use_generics(s.generics, s.ty, map), span)
  ty_substitute(s.ty, map)
}

// An effect's generics by name (they are written as names, not parameters).
pub fn ck_instantiate_named_map(
  gs: List(Text),
  c: &mut Checker,
  map: Ordmap(Text, Ty)
): Ordmap(Text, Ty) {
  match gs {
    Nil => map
    Cons(g, rest) => {
      let v := ck_fresh(&mut c)
      ck_instantiate_named_map(rest, &mut c, Ordmap::insert(map, g, v, Ordmap::compare_text))
    }
  }
}

// `t` with `gs` as fresh variables, each bound by its kind at `span`.
pub fn ck_instantiate_kinded(c: &mut Checker, gs: List(Text × Kind), span: TySpan, t: Ty): Ty {
  let map := ck_instantiate_map(gs, &mut c, span, Ordmap::empty())
  ty_substitute(t, map)
}

pub fn ck_instantiate_named(c: &mut Checker, gs: List(Text), t: Ty): Ty {
  let map := ck_instantiate_named_map(gs, &mut c, Ordmap::empty())
  ty_substitute(t, map)
}
