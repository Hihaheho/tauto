import "checker.taut"
import "../../surface/src/surface.taut"
import std::Base
import std::List
import std::Map
import std::Text
import "datas.taut"
import "rows.taut"
import "ty.taut"

// Written types and declarations (`written`, `declare_effect`, `declare_data`,
// `finish_datas`, `signature`, `instantiate` of `types.rs`), in the proof
// language (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」).

pub fn ck_written_name(n: Text, generics: Ordmap(Text, Ty)): Ty {
  if n == "i32" {
    TyInt(Width32)
  } else if n == "i64" {
    TyInt(Width64)
  } else if n == "u8" {
    TyInt(WidthU8)
  } else if n == "u32" {
    TyInt(WidthU32)
  } else if n == "u64" {
    TyInt(WidthU64)
  } else if n == "Bool" {
    TyBool
  } else if n == "Text" {
    TyText
  } else if n == "Never" {
    TyNever
  } else if n == "Decimal" {
    TyDecimal
  } else if n == "Float" {
    TyFloat
  } else {
    ⊢ Ty from match Ordmap::get(generics, n, Ordmap::compare_text) {
      Some(t) => t
      None => TyNamed(n, Nil)
    }
  }
}

pub fn ck_written_ctor_arity(&mut c: Checker, n: Text, span: TySpan): Ty {
  ck_error(&mut c, cat2(n, " is a type constructor variable and takes one argument"), span)
  ck_fresh(&mut c)
}

pub fn ck_written_bad(&mut c: Checker, span: TySpan): Ty {
  ck_error(&mut c, "not a type", span)
  ck_fresh(&mut c)
}

pub(open) inductive WrittenApp: Type {
  WrittenUnit: WrittenApp
  WrittenInfo: WrittenApp
  WrittenNamed(name: Text): WrittenApp
  WrittenGeneric(name: Text): WrittenApp
  WrittenBad: WrittenApp
}

pub fn written_nested(function: SurfaceTerm): Bool {
  ⊢ Bool from match function.kind {
    SkApp(inner, first) => true
    _ => false
  }
}

pub fn written_app(function: SurfaceTerm, arity: Nat, generics: Ordmap(Text, Ty)): WrittenApp {
  ⊢ WrittenApp from match function.kind {
    SkVar(n) => if n == "Tuple" && arity == 0 {
      WrittenUnit
    } else if n == "Info" && arity == 1 {
      WrittenInfo
    } else if Ordmap::contains(generics, n, Ordmap::compare_text) {
      WrittenGeneric(n)
    } else if n == "Tuple" {
      WrittenBad
    } else {
      WrittenNamed(n)
    }
    _ => WrittenBad
  }
}

// A declared type is written with all its arguments, except where a type
// constructor is wanted.
pub fn ck_arity(&mut c: Checker, name: Text, given: Nat, span: TySpan): Unit {
  if not(c.constructor_position) {
    ⊢ Unit from match datas_decl(c.datas, name) {
      None => #()
      Some(d) => if given != list_len(d.generics) {
        ck_error(
          &mut c,
          cat4(name, " takes ", Text::of_nat(list_len(d.generics)), " arguments"),
          span
        )
      }
    }
  }
}

pub fn ck_written_var(&mut c: Checker, n: Text, generics: Ordmap(Text, Ty), span: TySpan): Ty {
  let t := ck_written_name(n, generics)
  ⊢ Ty from match t {
    TyNamed(name, args) => if Ordmap::contains(generics, n, Ordmap::compare_text) {
      t
    } else {
      ck_arity(&mut c, n, 0, span)
      t
    }
    _ => t
  }
}

pub fn pi_binder(p: SurfaceParam): Option(Pair(Text, Kind)) {
  ⊢ Option(Pair(Text, Kind)) from match p.name {
    None => None
    Some(n) => ⊢ Option(Pair(Text, Kind)) from match p.ty.kind {
      SkVar(k) => ⊢ Option(Pair(Text, Kind)) from match kind_parse(k) {
        None => None
        Some(kind) => Some(Pair { fst: n, snd: kind })
      }
      _ => None
    }
  }
}

// The leading `(A: Shared, B: Type, …)` of a function type: the expansion's
// `<A: Shared, B: Type>(…) -> …`.
pub fn pi_binders(ps: List(SurfaceParam)): Pair(List(Pair(Text, Kind)), List(SurfaceParam)) {
  ⊢ Pair(List(Pair(Text, Kind)), List(SurfaceParam)) from match ps {
    Nil => Pair { fst: Nil, snd: Nil }
    Cons(p, rest) => ⊢ Pair(List(Pair(Text, Kind)), List(SurfaceParam)) from match pi_binder(p) {
      None => Pair { fst: Nil, snd: ps }
      Some(b) => {
        let more := pi_binders(rest)
        Pair { fst: Cons(b, more.fst), snd: more.snd }
      }
    }
  }
}

pub fn binders_map(bs: List(Pair(Text, Kind)), map: Ordmap(Text, Ty)): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match bs {
    Nil => map
    Cons(b, rest) => binders_map(
      rest,
      Ordmap::insert(map, b.fst, TyParam(b.fst, b.snd), Ordmap::compare_text)
    )
  }
}

pub fn ty_poly_of(bs: List(Pair(Text, Kind)), fun: Ty): Ty {
  ⊢ Ty from match bs {
    Nil => fun
    Cons(b, rest) => TyPoly(bs, fun)
  }
}

pub fn ck_written_fn_kind(w: Ty, &mut c: Checker, fk: Text, span: TySpan): Ty {
  ⊢ Ty from match w {
    TyFn(ps, r, k) => TyFn(ps, r, ⊢ Kind from match kind_parse(fk) {
      Some(x) => x
      None => KindShared
    })
    _ => {
      ck_error(&mut c, cat3("`", fk, "` is the kind of a function type"), span)
      w
    }
  }
}

// A type written in a program, over the type parameters `generics` names.
// `under_borrow` is whether the type is the one directly under a `&`.
mutual {
  pub fn ck_written_in(t: SurfaceTerm, &mut c: Checker, generics: Ordmap(Text, Ty)): Ty {
    ⊢ Ty from match t {
      SurfaceTermIndexedMk(sk, start, end, ast_occurrence) => {
        let under_borrow := c.under_borrow
        set_to(&mut c.under_borrow, false)
        ck_written_kind(sk, &mut c, generics, TySpan { start: start, end: end }, under_borrow)
      }
    }
  }

  pub fn ck_written_kind(
    sk: SurfaceKind,
    &mut c: Checker,
    generics: Ordmap(Text, Ty),
    span: TySpan,
    under_borrow: Bool
  ): Ty {
    ⊢ Ty from match sk {
      SkVar(n) => ck_written_var(&mut c, n, generics, span)
      SkApp(function, arguments) => if written_nested(function) {
        // The arguments of both, the inner ones first.
        let saved := c.constructor_position
        set_to(&mut c.constructor_position, true)
        let inner := ck_written_in(function, &mut c, generics)
        set_to(&mut c.constructor_position, saved)
        let after := ck_written_each(arguments, &mut c, generics)
        ⊢ Ty from match inner {
          TyNamed(n, before) => {
            let targs := List::append(before, after)
            ck_arity(&mut c, n, list_len(targs), span)
            TyNamed(n, targs)
          }
          _ => ck_written_bad(&mut c, span)
        }
      } else {
        ⊢ Ty from match written_app(function, list_len(arguments), generics) {
          WrittenUnit => TyUnit
          WrittenInfo => ⊢ Ty from match ck_written_each(arguments, &mut c, generics) {
            Cons(a, rest) => TyInfo(a)
            Nil => TyUnit
          }
          WrittenNamed(n) => {
            if n == "Slice" && not(under_borrow) {
              ck_error(&mut c, "Slice(A) can only be borrowed", span)
            }
            let targs := ck_written_each(arguments, &mut c, generics)
            ck_arity(&mut c, n, list_len(targs), span)
            TyNamed(n, targs)
          }
          WrittenGeneric(n) => if list_len(arguments) == 1 {
            ⊢ Ty from match ck_written_each(arguments, &mut c, generics) {
              Cons(x, more) => ty_apply(ck_written_name(n, generics), x)
              Nil => ck_written_ctor_arity(&mut c, n, span)
            }
          } else {
            ck_written_ctor_arity(&mut c, n, span)
          }
          WrittenBad => ck_written_bad(&mut c, span)
        }
      }
      SkPi(params, result, effects) => {
        let split := pi_binders(params)
        let inner := binders_map(split.fst, generics)
        let ps := ck_written_params(params, &mut c, inner, list_len(split.fst))
        let r := ck_written_in(result, &mut c, inner)
        ty_poly_of(split.fst, TyFn(ps, r, KindShared))
      }
      SkFnKind(fk, ty) => ck_written_fn_kind(ck_written_in(ty, &mut c, generics), &mut c, fk, span)
      SkBorrow(mutable, x) => {
        set_to(&mut c.under_borrow, true)
        let w := ck_written_in(x, &mut c, generics)
        TyBorrow(w, mutable)
      }
      SkUnion(ts) => {
        let ws := ck_written_each(ts, &mut c, generics)
        ty_union(ws)
      }
      SkProduct(ts) => {
        let ws := ck_written_each(ts, &mut c, generics)
        ty_product(ws)
      }
      SkTagged(tag, x) => {
        let w := ck_written_in(x, &mut c, generics)
        ty_tagged(Cons(tag, Nil), w)
      }
      _ => {
        ck_error(&mut c, "not a type of a program", span)
        ck_fresh(&mut c)
      }
    }
  }

  pub fn ck_written_each(
    ts: List(SurfaceTerm),
    &mut c: Checker,
    generics: Ordmap(Text, Ty)
  ): List(Ty) {
    ⊢ List(Ty) from match ts {
      Nil => Nil
      Cons(t, rest) => {
        let h := ck_written_in(t, &mut c, generics)
        let tl := ck_written_each(rest, &mut c, generics)
        Cons(h, tl)
      }
    }
  }

  // The parameters after the first `skip`.
  pub fn ck_written_params(
    ps: List(SurfaceParam),
    &mut c: Checker,
    generics: Ordmap(Text, Ty),
    skip: Nat
  ): List(Ty) {
    ⊢ List(Ty) from match ps {
      Nil => Nil
      Cons(p, rest) => ⊢ List(Ty) from match skip {
        Succ(n) => ck_written_params(rest, &mut c, generics, n)
        Zero => {
          let h := ck_written_param(p, &mut c, generics)
          let tl := ck_written_params(rest, &mut c, generics, 0)
          Cons(h, tl)
        }
      }
    }
  }

  pub fn ck_written_param(p: SurfaceParam, &mut c: Checker, generics: Ordmap(Text, Ty)): Ty {
    ⊢ Ty from match p {
      SurfaceParamMk(name, ty) => ck_written_in(ty, &mut c, generics)
    }
  }
}

pub fn ck_written(&mut c: Checker, t: SurfaceTerm, generics: Ordmap(Text, Ty)): Ty {
  ck_written_in(t, &mut c, generics)
}

pub fn ck_named_generics(gs: List(Text), map: Ordmap(Text, Ty)): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match gs {
    Nil => map
    Cons(g, rest) => ck_named_generics(
      rest,
      Ordmap::insert(map, g, TyNamed(g, Nil), Ordmap::compare_text)
    )
  }
}

pub fn ck_effect_param(
  &mut c: Checker,
  e: SurfaceEffect,
  p: Option(SurfaceTerm),
  generics: Ordmap(Text, Ty)
): Ty {
  ⊢ Ty from match p {
    Some(x) => ck_written(&mut c, x, generics)
    None => {
      ck_error(
        &mut c,
        cat3("a parameter of `", e.name, "` has no type"),
        TySpan { start: e.start, end: e.end }
      )
      TyNever
    }
  }
}

pub fn ck_effect_params(
  ps: List(Option(SurfaceTerm)),
  &mut c: Checker,
  e: SurfaceEffect,
  generics: Ordmap(Text, Ty)
): List(Ty) {
  ⊢ List(Ty) from match ps {
    Nil => Nil
    Cons(p, rest) => {
      let h := ck_effect_param(&mut c, e, p, generics)
      let tl := ck_effect_params(rest, &mut c, e, generics)
      Cons(h, tl)
    }
  }
}

pub fn ck_effect_quant(&mut c: Checker, e: SurfaceEffect): Quant {
  ⊢ Quant from match e.r#resume {
    None => QuantAtMostOne
    Some(q) => ⊢ Quant from match quant_parse(q) {
      Some(x) => x
      None => {
        ck_error(
          &mut c,
          cat3("`resume ", q, "`: write 0, <=1, 1 or \u{3c9}"),
          TySpan { start: e.start, end: e.end }
        )
        QuantAtMostOne
      }
    }
  }
}

pub fn ck_effect_result(&mut c: Checker, e: SurfaceEffect, generics: Ordmap(Text, Ty)): Ty {
  ⊢ Ty from match e.result {
    Some(r) => ck_written(&mut c, r, generics)
    None => TyUnit
  }
}

pub fn ck_declare_effect(&mut c: Checker, e: SurfaceEffect): Unit {
  let generics := ck_named_generics(e.generics, Ordmap::empty())
  let params := ck_effect_params(e.params, &mut c, e, generics)
  let result := ck_effect_result(&mut c, e, generics)
  let quant := ck_effect_quant(&mut c, e)
  set_to(&mut c.quants, Ordmap::insert(c.quants, e.name, quant, Ordmap::compare_text))
  set_to(
    &mut c.effects,
    Ordmap::insert(
      c.effects,
      e.name,
      EffectSig { generics: e.generics, params: params, result: result },
      Ordmap::compare_text
    )
  )
}

pub fn ck_param_generics(gs: List(Text), kind: Kind, map: Ordmap(Text, Ty)): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match gs {
    Nil => map
    Cons(g, rest) => ck_param_generics(
      rest,
      kind,
      Ordmap::insert(map, g, TyParam(g, kind), Ordmap::compare_text)
    )
  }
}

mutual {
  pub fn term_has_borrow(t: SurfaceTerm): Bool {
    ⊢ Bool from match t {
      SurfaceTermIndexedMk(sk, start, end, ast_occurrence) => kind_has_borrow(sk)
    }
  }

  pub fn kind_has_borrow(sk: SurfaceKind): Bool {
    ⊢ Bool from match sk {
      SkBorrow(m, x) => true
      SkApp(f, args) => term_has_borrow(f) || terms_have_borrow(args)
      SkTagged(tag, x) => term_has_borrow(x)
      SkUnion(ts) => terms_have_borrow(ts)
      SkProduct(ts) => terms_have_borrow(ts)
      SkPi(ps, r, e) => params_have_borrow(ps) || term_has_borrow(r)
      _ => false
    }
  }

  pub fn terms_have_borrow(ts: List(SurfaceTerm)): Bool {
    ⊢ Bool from match ts {
      Nil => false
      Cons(t, rest) => term_has_borrow(t) || terms_have_borrow(rest)
    }
  }

  pub fn params_have_borrow(ps: List(SurfaceParam)): Bool {
    ⊢ Bool from match ps {
      Nil => false
      Cons(p, rest) => param_has_borrow(p) || params_have_borrow(rest)
    }
  }

  pub fn param_has_borrow(p: SurfaceParam): Bool {
    ⊢ Bool from match p {
      SurfaceParamMk(name, ty) => term_has_borrow(ty)
    }
  }
}

pub fn ck_data_fields(
  fs: List(SurfaceDataField),
  &mut c: Checker,
  generics: Ordmap(Text, Ty)
): List(DataField) {
  ⊢ List(DataField) from match fs {
    Nil => Nil
    Cons(f, rest) => {
      if term_has_borrow(f.ty) {
        ck_error(&mut c, "a borrow cannot be a field", span_of(f.ty))
      }
      let t := ck_written(&mut c, f.ty, generics)
      let tl := ck_data_fields(rest, &mut c, generics)
      Cons(DataField { name: f.name, ty: t }, tl)
    }
  }
}

pub fn ck_data_ctors(
  cs: List(SurfaceDataCtor),
  &mut c: Checker,
  generics: Ordmap(Text, Ty)
): List(DataCtor) {
  ⊢ List(DataCtor) from match cs {
    Nil => Nil
    Cons(k, rest) => {
      let fields := ck_data_fields(k.fields, &mut c, generics)
      let tl := ck_data_ctors(rest, &mut c, generics)
      Cons(DataCtor { name: k.name, fields: fields }, tl)
    }
  }
}

pub fn ck_register_ctors(cs: List(DataCtor), &mut c: Checker, dname: Text, i: Nat): Unit {
  ⊢ Unit from match cs {
    Nil => #()
    Cons(k, rest) => {
      let m := Ordmap::insert(
        c.datas.ctors,
        k.name,
        Pair { fst: dname, snd: i },
        Ordmap::compare_text
      )
      let m2 := Ordmap::insert(
        m,
        cat3(dname, ".", k.name),
        Pair { fst: dname, snd: i },
        Ordmap::compare_text
      )
      set_to(&mut c.datas, Datas { decls: c.datas.decls, ctors: m2, steps: c.datas.steps })
      ck_register_ctors(rest, &mut c, dname, i + 1)
    }
  }
}

pub fn ctors_have_fields(cs: List(SurfaceDataCtor)): Bool {
  ⊢ Bool from match cs {
    Nil => false
    Cons(k, rest) => ⊢ Bool from match k.fields {
      Cons(f, more) => true
      Nil => ctors_have_fields(rest)
    }
  }
}

pub fn surface_data_is_view(d: SurfaceData): Bool {
  ⊢ Bool from match d.kind {
    Some(k) => k == "view"
    None => false
  }
}

pub fn data_declared(d: SurfaceData): Option(Kind) {
  if surface_data_is_view(d) {
    Some(KindAffine)
  } else {
    ⊢ Option(Kind) from match d.kind {
      Some(k) => kind_parse(k)
      None => None
    }
  }
}

// Records a `struct` or `enum`; field types are checked again after all
// declarations are known (`ck_recheck_datas`).
pub fn ck_declare_data(&mut c: Checker, d: SurfaceData, is_struct: Bool, builtin: Bool): Unit {
  let r#view := surface_data_is_view(d)
  if r#view && (not(is_struct) || ctors_have_fields(d.constructors)) {
    ck_error(
      &mut c,
      "a view struct has no fields: it is an opaque type",
      TySpan { start: d.start, end: d.end }
    )
  }
  let generics := ck_param_generics(d.generics, KindLinear, Ordmap::empty())
  let constructors := ck_data_ctors(d.constructors, &mut c, generics)
  ck_register_ctors(constructors, &mut c, d.name, 0)
  let decl := Data {
    name: d.name,
    declared: data_declared(d),
    generics: d.generics,
    constructors: constructors,
    is_struct: is_struct,
    recursive: false,
    base: KindLinear,
    holds: d.generics,
    builtin: builtin,
    r#view: r#view
  }
  set_to(
    &mut c.datas,
    Datas {
      decls: Ordmap::insert(c.datas.decls, d.name, decl, Ordmap::compare_text),
      ctors: c.datas.ctors,
      steps: c.datas.steps
    }
  )
}

pub fn data_with_recursive(data: Data, recursive: Bool): Data {
  Data {
    name: data.name,
    declared: data.declared,
    generics: data.generics,
    constructors: data.constructors,
    is_struct: data.is_struct,
    recursive: recursive,
    base: data.base,
    holds: data.holds,
    builtin: data.builtin,
    r#view: data.r#view
  }
}

pub fn datas_mark_recursive(d: Datas, n: Text): Datas {
  ⊢ Datas from match datas_decl(d, n) {
    None => d
    Some(data) => Datas {
      decls: Ordmap::insert(
        d.decls,
        n,
        data_with_recursive(data, datas_reaches_from(d, n, n)),
        Ordmap::compare_text
      ),
      ctors: d.ctors,
      steps: d.steps
    }
  }
}

pub fn ck_mark_recursive(names: List(Pair(Text, Data)), &mut c: Checker): Unit {
  ⊢ Unit from match names {
    Nil => #()
    Cons(entry, rest) => {
      set_to(&mut c.datas, datas_mark_recursive(c.datas, entry.fst))
      ck_mark_recursive(rest, &mut c)
    }
  }
}

// The first field whose kind is looser than the declared one: the message.
pub fn ck_declared_fields(
  fs: List(DataField),
  datas: Datas,
  cname: Text,
  least: Ordmap(Text, Ty),
  declared: Kind,
  i: Nat
): Option(Text) {
  ⊢ Option(Text) from match fs {
    Nil => None
    Cons(f, rest) => {
      let k := datas_kind(datas, ty_substitute(f.ty, least))
      if not(kind_fits(k, declared)) || (kind_eq(declared, KindCopy) && not(kind_eq(k, KindCopy))) {
        let field := ⊢ Text from match f.name {
          Some(n) => n
          None => cat3(Text::of_nat(i), " of ", cname)
        }
        Some(
          cat5("declared ", kind_name(declared), " but field ", field, cat2(" is ", kind_name(k)))
        )
      } else {
        ck_declared_fields(rest, datas, cname, least, declared, i + 1)
      }
    }
  }
}

pub fn ck_declared_ctors(
  cs: List(DataCtor),
  datas: Datas,
  least: Ordmap(Text, Ty),
  declared: Kind
): Option(Text) {
  ⊢ Option(Text) from match cs {
    Nil => None
    Cons(k, rest) => ⊢ Option(Text) from match ck_declared_fields(
      k.fields,
      datas,
      k.name,
      least,
      declared,
      0
    ) {
      Some(m) => Some(m)
      None => ck_declared_ctors(rest, datas, least, declared)
    }
  }
}

pub fn ck_declared_message(d: SurfaceData, data: Data, declared: Kind): Option(Text) {
  if data.recursive && kind_rank(declared) < kind_rank(KindShared) {
    Some(
      cat5("declared ", kind_name(declared), " but `", d.name, "` holds itself, so it is shared")
    )
  } else {
    None
  }
}

pub fn ck_finish_message(datas: Datas, d: SurfaceData): Option(Text) {
  ⊢ Option(Text) from match datas_decl(datas, d.name) {
    None => None
    Some(data) => ⊢ Option(Text) from match data.declared {
      None => None
      Some(declared) => ⊢ Option(Text) from match ck_declared_message(d, data, declared) {
        Some(m) => Some(m)
        None => ck_declared_ctors(
          data.constructors,
          datas,
          ck_param_generics(data.generics, KindCopy, Ordmap::empty()),
          declared
        )
      }
    }
  }
}

pub fn ck_finish_decl(&mut c: Checker, d: SurfaceData): Unit {
  ⊢ Unit from match ck_finish_message(c.datas, d) {
    None => #()
    Some(m) => ck_error(&mut c, m, TySpan { start: d.start, end: d.end })
  }
}

pub fn ck_finish_stmt(&mut c: Checker, s: SurfaceStmt): Unit {
  ⊢ Unit from match s {
    StStruct(d) => ck_finish_decl(&mut c, d)
    StEnum(d) => ck_finish_decl(&mut c, d)
    _ => #()
  }
}

pub fn ck_finish_stmts(ss: List(SurfaceStmt), &mut c: Checker): Unit {
  ⊢ Unit from match ss {
    Nil => #()
    Cons(s, rest) => {
      ck_finish_stmt(&mut c, s)
      ck_finish_stmts(rest, &mut c)
    }
  }
}

// Which declarations hold themselves, and whether a written kind is looser
// than what the fields give.
pub fn ck_finish_datas(&mut c: Checker, program: List(SurfaceStmt)): Unit {
  ck_mark_recursive(Ordmap::entries(c.datas.decls), &mut c)
  set_to(&mut c.datas, datas_summarize(c.datas))
  ck_finish_stmts(program, &mut c)
}

// `Option`, `Result` and `Pair` hold what they are given: a view if one of
// the arguments is.
pub fn ck_view_container(n: Text): Bool {
  n == "Option" || n == "Result" || n == "Pair"
}

pub fn ck_declared_view(c: Checker, n: Text): Bool {
  ⊢ Bool from match datas_decl(c.datas, n) {
    Some(d) => d.r#view
    None => false
  }
}

// A type that holds a borrow, received as one is: a borrow, a `view struct`,
// or an `Option`, `Result` or `Pair` of one.
mutual {
  pub fn ck_any_view_in(k: Nat, &c: Checker, ts: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => ck_is_view_in(j, &c, t) || ck_any_view_in(j, &c, rest)
      }
    }
  }

  pub fn ck_is_view_in(k: Nat, &c: Checker, t: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ck_resolve(&c, t) {
        TyBorrow(x, m) => true
        TyNamed(n, args) => ck_declared_view(
          c,
          n
        ) || (ck_view_container(n) && ck_any_view_in(j, &c, args))
        _ => false
      }
    }
  }
}

pub fn ck_is_view(&c: Checker, t: Ty): Bool {
  ck_is_view_in(c.steps, &c, t)
}

mutual {
  pub fn ck_any_mut_borrow_in(k: Nat, &c: Checker, ts: List(Ty)): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ts {
        Nil => false
        Cons(t, rest) => ck_has_mut_borrow_in(j, &c, t) || ck_any_mut_borrow_in(j, &c, rest)
      }
    }
  }

  pub fn ck_has_mut_borrow_in(k: Nat, &c: Checker, t: Ty): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match ck_resolve(&c, t) {
        TyBorrow(inner, m) => m || ck_has_mut_borrow_in(j, &c, inner)
        TyNamed(n, args) => ck_any_mut_borrow_in(j, &c, args)
        _ => false
      }
    }
  }
}

pub fn ck_has_mut_borrow(&c: Checker, t: Ty): Bool {
  ck_has_mut_borrow_in(c.steps, &c, t)
}

// The value a view of duplicable things stands for (`&A == A`), or `None`
// when something in it is not duplicable or is a `&mut`.
mutual {
  pub fn ck_view_values_in(k: Nat, &c: Checker, ts: List(Ty)): Option(List(Ty)) {
    ⊢ Option(List(Ty)) from match k {
      Zero => None
      Succ(j) => ⊢ Option(List(Ty)) from match ts {
        Nil => Some(Nil)
        Cons(t, rest) => ⊢ Option(List(Ty)) from match ck_view_value_in(j, &c, t) {
          None => None
          Some(v) => ⊢ Option(List(Ty)) from match ck_view_values_in(j, &c, rest) {
            None => None
            Some(vs) => Some(Cons(v, vs))
          }
        }
      }
    }
  }

  pub fn ck_view_value_in(k: Nat, &c: Checker, t: Ty): Option(Ty) {
    ⊢ Option(Ty) from match k {
      Zero => None
      Succ(j) => ⊢ Option(Ty) from match ck_resolve(&c, t) {
        TyBorrow(inner, m) => if m {
          None
        } else {
          ⊢ Option(Ty) from match ck_view_value_in(j, &c, inner) {
            None => None
            Some(v) => if kind_dup(ck_kind(&c, v)) { Some(v) } else { None }
          }
        }
        TyNamed(n, args) => if ck_declared_view(c, n) {
          None
        } else {
          ⊢ Option(Ty) from match ck_view_values_in(j, &c, args) {
            None => None
            Some(vs) => Some(TyNamed(n, vs))
          }
        }
        _ => Some(ck_resolve(&c, t))
      }
    }
  }
}

pub fn ck_view_value(&c: Checker, t: Ty): Option(Ty) {
  ck_view_value_in(c.steps, &c, t)
}

pub fn ck_bound_of(bounds: List(Option(Text)), i: Nat): Option(Kind) {
  ⊢ Option(Kind) from match nth_item(bounds, i) {
    None => Some(KindAffine)
    Some(o) => ⊢ Option(Kind) from match o {
      None => Some(KindAffine)
      Some(b) => kind_parse(b)
    }
  }
}

// The generics of a signature with their bounds, newest first, and the map
// from their names to type parameters.
pub(open) inductive SigGenerics: Type {
  SigGenericsMk(
    generics: List(Pair(Text, Kind)),
    map: Ordmap(Text, Ty),
    // The type constructors among them, with the kind each takes.
    ctors: List(Pair(Text, Kind))
  ): SigGenerics
}

// `(k₁)->k₂`: the generic is a type constructor.
pub fn ck_ctor_bound_of(bounds: List(Option(Text)), i: Nat): Option(Pair(Kind, Kind)) {
  ⊢ Option(Pair(Kind, Kind)) from match nth_item(bounds, i) {
    None => None
    Some(o) => ⊢ Option(Pair(Kind, Kind)) from match o {
      None => None
      Some(b) => kind_parse_ctor(b)
    }
  }
}

pub fn sig_generics(
  gs: List(Text),
  bounds: List(Option(Text)),
  i: Nat,
  acc: SigGenerics
): SigGenerics {
  ⊢ SigGenerics from match gs {
    Nil => acc
    Cons(g, rest) => ⊢ SigGenerics from match ck_ctor_bound_of(bounds, i) {
      Some(ak) => sig_generics(
        rest,
        bounds,
        i + 1,
        SigGenerics {
          generics: Cons(Pair { fst: g, snd: ak.snd }, acc.generics),
          map: Ordmap::insert(acc.map, g, TyParam(g, ak.snd), Ordmap::compare_text),
          ctors: Cons(Pair { fst: g, snd: ak.fst }, acc.ctors)
        }
      )
      None => ⊢ SigGenerics from match ck_bound_of(bounds, i) {
        None => sig_generics(rest, bounds, i + 1, acc)
        Some(k) => sig_generics(
          rest,
          bounds,
          i + 1,
          SigGenerics {
            generics: Cons(Pair { fst: g, snd: k }, acc.generics),
            map: Ordmap::insert(acc.map, g, TyParam(g, k), Ordmap::compare_text),
            ctors: acc.ctors
          }
        )
      }
    }
  }
}

pub fn ck_sig_written(&mut c: Checker, p: Option(SurfaceTerm), map: Ordmap(Text, Ty)): Ty {
  ⊢ Ty from match p {
    Some(x) => ck_written(&mut c, x, map)
    None => {
      // No written type consumes the borrow-position flag for an inferred parameter.
      set_to(&mut c.under_borrow, false)
      ck_fresh(&mut c)
    }
  }
}

pub fn ck_sig_param(
  &mut c: Checker,
  p: Option(SurfaceTerm),
  b: Option(Bool),
  map: Ordmap(Text, Ty)
): Ty {
  set_to(&mut c.under_borrow, ⊢ Bool from match b {
    Some(m) => true
    None => false
  })
  let t := ck_sig_written(&mut c, p, map)
  ⊢ Ty from match b {
    Some(m) => if ty_is_borrow(t) { t } else { TyBorrow(t, m) }
    None => t
  }
}

pub fn list_head_or_none<A>(xs: List(Option(A))): Option(A) {
  ⊢ Option(A) from match xs {
    Nil => None
    Cons(o, more) => o
  }
}

pub fn ck_sig_params(
  pts: List(Option(SurfaceTerm)),
  &mut c: Checker,
  borrows: List(Option(Bool)),
  map: Ordmap(Text, Ty)
): List(Ty) {
  ⊢ List(Ty) from match pts {
    Nil => Nil
    Cons(p, rest) => {
      let wrapped := ck_sig_param(&mut c, p, list_head_or_none(borrows), map)
      let tl := ck_sig_params(rest, &mut c, List::tail(borrows), map)
      Cons(wrapped, tl)
    }
  }
}

pub fn ty_any_mut_borrow(ts: List(Ty)): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(t, rest) => ⊢ Bool from match t {
      TyBorrow(x, m) => m || ty_any_mut_borrow(rest)
      _ => ty_any_mut_borrow(rest)
    }
  }
}

pub fn ty_any_borrow(ts: List(Ty)): Bool {
  ⊢ Bool from match ts {
    Nil => false
    Cons(t, rest) => ty_is_borrow(t) || ty_any_borrow(rest)
  }
}

pub fn ck_sig_result(&mut c: Checker, f: SurfaceFn, map: Ordmap(Text, Ty)): Ty {
  ⊢ Ty from match f.result {
    Some(r) => ck_written(&mut c, r, map)
    None => ck_fresh(&mut c)
  }
}

// A view is returned only from a borrowed parameter: the message when not.
pub fn ck_view_result_message(c: Checker, params: List(Ty), result: Ty): Option(Text) {
  let shown := ty_show(ck_shown(&c, result))
  if not(ck_is_view(&c, result)) {
    None
  } else if ck_has_mut_borrow(&c, result) {
    if ty_any_mut_borrow(
      params
    ) { None } else { Some(cat3("-> ", shown, " needs a &mut parameter")) }
  } else if ty_any_borrow(params) {
    None
  } else {
    Some(cat3("-> ", shown, " needs a borrowed parameter"))
  }
}

pub fn ck_sig_span(f: SurfaceFn): TySpan {
  ⊢ TySpan from match f.result {
    Some(r) => span_of(r)
    None => TySpan { start: f.start, end: f.end }
  }
}

pub fn ck_report(&mut c: Checker, message: Option(Text), span: TySpan): Unit {
  ⊢ Unit from match message {
    None => #()
    Some(m) => ck_error(&mut c, m, span)
  }
}

pub fn generics_have(gs: List(Pair(Text, Kind)), n: Text): Bool {
  ⊢ Bool from match gs {
    Nil => false
    Cons(g, rest) => g.fst == n || generics_have(rest, n)
  }
}

pub fn preds_have(ps: List(Pair(Text, Text)), r#class: Text, g: Text): Bool {
  ⊢ Bool from match ps {
    Nil => false
    Cons(p, rest) => (p.fst == r#class && p.snd == g) || preds_have(rest, r#class, g)
  }
}

pub fn constraint_generic(t: SurfaceTerm, gs: List(Pair(Text, Kind))): Option(Text) {
  ⊢ Option(Text) from match t.kind {
    SkVar(g) => if generics_have(gs, g) { Some(g) } else { None }
    _ => None
  }
}

// The legacy monomorphic checker must not silently drop value indices.
// Checked dictionary expansion must remove indexed constraints before this
// path; preserve the source AST and reject the unsupported view here.
pub fn constraint_single_type(w: SurfaceConstraint): SurfaceTerm {
  ⊢ SurfaceTerm from match w.arguments {
    Nil => w.ty
    Cons(index, rest) => surface_term_mk(SkOther("indexed class constraint"), w.start, w.end)
  }
}

pub fn ck_where_pred(
  &mut c: Checker,
  w: SurfaceConstraint,
  gs: List(Pair(Text, Kind)),
  name: Text,
  preds: List(Pair(Text, Text))
): List(Pair(Text, Text)) {
  let span: TySpan := TySpan { start: w.start, end: w.end }
  if not(
    class_is_structural(w.r#class)
  ) && not(Ordmap::contains(c.classes, w.r#class, Ordmap::compare_text)) {
    ck_error(&mut c, cat2(w.r#class, " is not a class"), span)
    preds
  } else {
    ⊢ List(Pair(Text, Text)) from match constraint_generic(constraint_single_type(w), gs) {
      None => {
        ck_error(&mut c, cat2("where constrains only generics of ", name), span)
        preds
      }
      Some(g) => if preds_have(preds, w.r#class, g) {
        ck_error(&mut c, cat5(w.r#class, "(", g, ") is written twice", ""), span)
        preds
      } else {
        Cons(Pair { fst: w.r#class, snd: g }, preds)
      }
    }
  }
}

pub fn ck_where_preds(
  ws: List(SurfaceConstraint),
  &mut c: Checker,
  gs: List(Pair(Text, Kind)),
  name: Text,
  preds: List(Pair(Text, Text))
): List(Pair(Text, Text)) {
  ⊢ List(Pair(Text, Text)) from match ws {
    Nil => preds
    Cons(w, rest) => {
      let next: List(Pair(Text, Text)) := ck_where_pred(&mut c, w, gs, name, preds)
      ck_where_preds(rest, &mut c, gs, name, next)
    }
  }
}

pub fn ck_signature(&mut c: Checker, f: SurfaceFn): Scheme {
  let g := sig_generics(
    f.generics,
    f.bounds,
    0,
    SigGenerics { generics: Nil, map: Ordmap::empty(), ctors: Nil }
  )
  let params := ck_sig_params(f.param_types, &mut c, f.borrows, g.map)
  let result := ck_sig_result(&mut c, f, g.map)
  ck_report(&mut c, ck_view_result_message(c, params, result), ck_sig_span(f))
  let preds: List(Pair(Text, Text)) := ck_where_preds(f.wheres, &mut c, g.generics, f.name, Nil)
  Scheme {
    generics: List::reverse(g.generics),
    ty: TyFn(params, result, KindShared),
    preds: List::reverse(preds),
    ctors: List::reverse(g.ctors)
  }
}

pub fn ctor_arg_of(ctors: List(Pair(Text, Kind)), g: Text): Option(Kind) {
  ⊢ Option(Kind) from match ctors {
    Nil => None
    Cons(p, rest) => if p.fst == g { Some(p.snd) } else { ctor_arg_of(rest, g) }
  }
}

// Fresh variables for the generics; a type constructor's bound is checked
// once it is known, for `name`.
pub fn ck_instantiate_map_ctors(
  generics: List(Pair(Text, Kind)),
  &mut c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty)
): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match generics {
    Nil => map
    Cons(g, rest) => {
      let v := ck_fresh(&mut c)
      ⊢ Unit from match ctor_arg_of(ctors, g.fst) {
        Some(arg) => set_to(
          &mut c.ctor_bounds,
          Cons(
            TyCtorBound {
              ty: v,
              arg: arg,
              result: g.snd,
              what: name,
              start: span.start,
              end: span.end
            },
            c.ctor_bounds
          )
        )
        None => set_to(
          &mut c.bounds,
          Cons(TyBound { ty: v, kind: g.snd, start: span.start, end: span.end }, c.bounds)
        )
      }
      ck_instantiate_map_ctors(
        rest,
        &mut c,
        ctors,
        name,
        span,
        Ordmap::insert(map, g.fst, v, Ordmap::compare_text)
      )
    }
  }
}

pub fn ck_instantiate_map(
  generics: List(Pair(Text, Kind)),
  &mut c: Checker,
  span: TySpan,
  map: Ordmap(Text, Ty)
): Ordmap(Text, Ty) {
  ck_instantiate_map_ctors(generics, &mut c, Nil, "", span, map)
}

pub fn ck_instantiate(&mut c: Checker, generics: List(Pair(Text, Kind)), t: Ty, span: TySpan): Ty {
  let map := ck_instantiate_map(generics, &mut c, span, Ordmap::empty())
  ty_substitute(t, map)
}

pub fn ck_pend(&mut c: Checker, r#class: Text, t: Ty, what: Text, span: TySpan): Unit {
  set_to(
    &mut c.pending,
    Cons(
      TyPending {
        r#class: r#class,
        ty: t,
        what: what,
        assume: c.assume,
        start: span.start,
        end: span.end
      },
      c.pending
    )
  )
}

pub fn ck_pend_preds(
  ps: List(Pair(Text, Text)),
  &mut c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): Unit {
  ⊢ Unit from match ps {
    Nil => #()
    Cons(p, rest) => {
      ⊢ Unit from match Ordmap::get(map, p.snd, Ordmap::compare_text) {
        Some(t) => ck_pend(&mut c, p.fst, t, what, span)
        None => #()
      }
      ck_pend_preds(rest, &mut c, map, what, span)
    }
  }
}

// A function's type at a use, its constraints left to be checked once the
// types are known.
pub fn ck_instantiate_scheme(&mut c: Checker, name: Text, s: Scheme, span: TySpan): Ty {
  let map := ck_instantiate_map_ctors(s.generics, &mut c, s.ctors, name, span, Ordmap::empty())
  ck_pend_preds(s.preds, &mut c, map, name, span)
  ty_substitute(s.ty, map)
}

// An effect's generics by name (they are written as names, not parameters).
pub fn ck_instantiate_named_map(
  gs: List(Text),
  &mut c: Checker,
  map: Ordmap(Text, Ty)
): Ordmap(Text, Ty) {
  ⊢ Ordmap(Text, Ty) from match gs {
    Nil => map
    Cons(g, rest) => {
      let v := ck_fresh(&mut c)
      ck_instantiate_named_map(rest, &mut c, Ordmap::insert(map, g, v, Ordmap::compare_text))
    }
  }
}

pub fn ck_instantiate_named(&mut c: Checker, gs: List(Text), t: Ty): Ty {
  let map := ck_instantiate_named_map(gs, &mut c, Ordmap::empty())
  ty_substitute(t, map)
}
