// Continued from `written_unique_application_mid.taut`.

pub theorem written_named_extend_equal<name: SurfaceName, first: List(
  Ty
), other_name: SurfaceName, other_first: List(
  Ty
)>(
  equal: TyNamed(name, first) = TyNamed(other_name, other_first),
  last: List(Ty),
  other_last: List(Ty),
  arguments: last = other_last
): TyNamed(
  name,
  List::append(first, last)
) = TyNamed(other_name, List::append(other_first, other_last)) {
  ⊢ TyNamed(
    name,
    List::append(first, last)
  ) = TyNamed(other_name, List::append(other_first, other_last)) from match equal {
    Refl => Eq::congr((ts: List(Ty)) => TyNamed(name, List::append(first, ts)), arguments)
  }
}
pub theorem written_unique_nested<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, r#borrow: Bool, function: SurfaceTerm, before: List(
  SurfaceTerm
), args: List(
  SurfaceTerm
), start: Nat, end: Nat, other: Ty>(
  ast_occurrence: Option(TermOccurrence),
  meaning: WrittenKind(
    env,
    generics,
    partial,
    r#borrow,
    SkApp(SurfaceTermIndexedMk(SkApp(function, before), start, end, ast_occurrence), args),
    other
  ),
  name: SurfaceName,
  first: List(Ty),
  last: List(Ty),
  ihhead: WrittenTermUnique(
    generics,
    true,
    false,
    SurfaceTermIndexedMk(SkApp(function, before), start, end, ast_occurrence),
    TyNamed(name, first)
  ),
  ihtail: WrittenTermsUnique(generics, partial, args, last)
): TyNamed(name, List::append(first, last)) = other {
  match meaning {
    WrittenKindNested(ctor_ast_occurrence, gs, Mode, borrowing, inner, initial, terms, begin, finish, other_name, other_first, other_last, constructor, arguments, arity) => written_named_extend_equal(
      ihhead(env, TyNamed(other_name, other_first), constructor),
      last,
      other_last,
      ihtail(env, other_last, arguments)
    )
  }
}
