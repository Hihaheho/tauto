// All callable declarations preserve the already computed data summaries.

pub fn registration_fns_after_fields(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): Mut1(List(Pair(SurfaceFn, Scheme)), Checker) {
  frame_bind(
    List(SurfaceFn),
    List(Pair(SurfaceFn, Scheme)),
    (synthesized: List(SurfaceFn), c1: Checker) => frame_bind(
      Unit,
      List(Pair(SurfaceFn, Scheme)),
      (ignored: Unit, c2: Checker) => frame_bind(
        List(Pair(SurfaceFn, Scheme)),
        List(Pair(SurfaceFn, Scheme)),
        (fns: List(Pair(SurfaceFn, Scheme)), c3: Checker) => mut1(
          List::append(fns, ck_synthesized_schemes(synthesized, c3)),
          c3
        ),
        ck_program_decls(program, c2)
      ),
      ck_prelude_fns(prelude, c1, own)
    ),
    ck_declare_classes(c, program)
  )
}

pub theorem registration_fns_after_fields_frame(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkReadFrame(c, registration_fns_after_fields(c, prelude, program, own)) {
  frame_bind_ok(
    List(SurfaceFn),
    List(Pair(SurfaceFn, Scheme)),
    c,
    (synthesized: List(SurfaceFn), c1: Checker) => frame_bind(
      Unit,
      List(Pair(SurfaceFn, Scheme)),
      (ignored: Unit, c2: Checker) => frame_bind(
        List(Pair(SurfaceFn, Scheme)),
        List(Pair(SurfaceFn, Scheme)),
        (fns: List(Pair(SurfaceFn, Scheme)), c3: Checker) => mut1(
          List::append(fns, ck_synthesized_schemes(synthesized, c3)),
          c3
        ),
        ck_program_decls(program, c2)
      ),
      ck_prelude_fns(prelude, c1, own)
    ),
    ck_declare_classes(c, program),
    ck_declare_classes_frame(c, program),
    synthesized => c1 => frame_bind_ok(
      Unit,
      List(Pair(SurfaceFn, Scheme)),
      c1,
      (ignored: Unit, c2: Checker) => frame_bind(
        List(Pair(SurfaceFn, Scheme)),
        List(Pair(SurfaceFn, Scheme)),
        (fns: List(Pair(SurfaceFn, Scheme)), c3: Checker) => mut1(
          List::append(fns, ck_synthesized_schemes(synthesized, c3)),
          c3
        ),
        ck_program_decls(program, c2)
      ),
      ck_prelude_fns(prelude, c1, own),
      ck_prelude_fns_frame(prelude, c1, own),
      ignored => c2 => frame_bind_ok(
        List(Pair(SurfaceFn, Scheme)),
        List(Pair(SurfaceFn, Scheme)),
        c2,
        (fns: List(Pair(SurfaceFn, Scheme)), c3: Checker) => mut1(
          List::append(fns, ck_synthesized_schemes(synthesized, c3)),
          c3
        ),
        ck_program_decls(program, c2),
        ck_program_decls_frame(program, c2),
        fns => c3 => Refl
      )
    )
  )
}

pub fn registration_fns_after_names(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): Mut1(List(Pair(SurfaceFn, Scheme)), Checker) {
  frame_bind(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    (ignored: Unit, next: Checker) => registration_fns_after_fields(next, prelude, program, own),
    ck_recheck_datas(types_data_decls(program), c)
  )
}
pub theorem registration_fns_after_names_frame(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkReadFrame(c, registration_fns_after_names(c, prelude, program, own)) {
  frame_bind_ok(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    c,
    (ignored: Unit, next: Checker) => registration_fns_after_fields(next, prelude, program, own),
    ck_recheck_datas(types_data_decls(program), c),
    ck_recheck_datas_frame(types_data_decls(program), c),
    ignored => next => registration_fns_after_fields_frame(next, prelude, program, own)
  )
}

pub fn registration_fns_after_data_names(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): Mut1(List(Pair(SurfaceFn, Scheme)), Checker) {
  frame_bind(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    (ignored: Unit, next: Checker) => registration_fns_after_names(next, prelude, program, own),
    ck_check_fn_names(c, types_function_decls(program))
  )
}
pub theorem registration_fns_after_data_names_frame(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkReadFrame(c, registration_fns_after_data_names(c, prelude, program, own)) {
  frame_bind_ok(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    c,
    (ignored: Unit, next: Checker) => registration_fns_after_names(next, prelude, program, own),
    ck_check_fn_names(c, types_function_decls(program)),
    ck_check_fn_names_frame(c, types_function_decls(program)),
    ignored => next => registration_fns_after_names_frame(next, prelude, program, own)
  )
}

pub fn registration_fns(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): Mut1(List(Pair(SurfaceFn, Scheme)), Checker) {
  frame_bind(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    (ignored: Unit, next: Checker) => registration_fns_after_data_names(
      next,
      prelude,
      program,
      own
    ),
    ck_check_data_names(c, types_data_decls(program))
  )
}
pub theorem registration_fns_frame(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkReadFrame(c, registration_fns(c, prelude, program, own)) {
  frame_bind_ok(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    c,
    (ignored: Unit, next: Checker) => registration_fns_after_data_names(
      next,
      prelude,
      program,
      own
    ),
    ck_check_data_names(c, types_data_decls(program)),
    ck_check_data_names_frame(c, types_data_decls(program)),
    ignored => next => registration_fns_after_data_names_frame(next, prelude, program, own)
  )
}
pub theorem registration_fns_unf(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): ck_prepare_fns(c, prelude, program, own) = registration_fns(c, prelude, program, own) { Refl }

pub theorem ck_prepare_fns_frame(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): CkReadFrame(c, ck_prepare_fns(c, prelude, program, own)) {
  Eq::subst(
    (z: Mut1(List(Pair(SurfaceFn, Scheme)), Checker)) => CkReadFrame(c, z),
    Eq::sym(registration_fns_unf(c, prelude, program, own)),
    registration_fns_frame(c, prelude, program, own)
  )
}

pub theorem ck_prepare_fns_summary_ok(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool),
  ok: CkSummaryOk(c)
): CkSummaryOk(ck_st(ck_prepare_fns(c, prelude, program, own))) {
  frame_summary(
    c,
    ck_prepare_fns(c, prelude, program, own),
    ck_prepare_fns_frame(c, prelude, program, own),
    ok
  )
}
pub fn registration_after_datas(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool)
): Mut1(List(Pair(SurfaceFn, Scheme)), Checker) {
  frame_bind(
    Unit,
    List(Pair(SurfaceFn, Scheme)),
    (ignored: Unit, next: Checker) => ck_prepare_fns(next, prelude, program, own),
    ck_prepare_datas(c, prelude, program, own)
  )
}
pub theorem registration_after_datas_ok(
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool),
  m: Mut1(Unit, Checker),
  ok: CkSummaryOk(ck_st(m))
): CkSummaryOk(
  ck_st(
    frame_bind(
      Unit,
      List(Pair(SurfaceFn, Scheme)),
      (ignored: Unit, next: Checker) => ck_prepare_fns(next, prelude, program, own),
      m
    )
  )
) {
  ⊢ CkSummaryOk(
    ck_st(
      frame_bind(
        Unit,
        List(Pair(SurfaceFn, Scheme)),
        (ignored: Unit, next: Checker) => ck_prepare_fns(next, prelude, program, own),
        m
      )
    )
  ) from match m {
    mut1(v, next) => ck_prepare_fns_summary_ok(next, prelude, program, own, ok)
  }
}
pub theorem registration_all_summary_ok(
  c: Checker,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt),
  own: Ordmap(Text, Bool),
  ordered: CkDatasOrdered(c)
): CkSummaryOk(ck_st(registration_after_datas(c, prelude, program, own))) {
  registration_after_datas_ok(
    prelude,
    program,
    own,
    ck_prepare_datas(c, prelude, program, own),
    ck_prepare_datas_summary_ok(c, prelude, program, own, ordered)
  )
}
pub theorem registration_new_summary_ok(
  steps: Nat,
  prelude: List(SurfaceStmt),
  program: List(SurfaceStmt)
): CkSummaryOk(
  ck_st(
    registration_after_datas(
      checker_new(steps),
      prelude,
      program,
      types_own(program, Ordmap::empty())
    )
  )
) {
  registration_all_summary_ok(
    checker_new(steps),
    prelude,
    program,
    types_own(program, Ordmap::empty()),
    checker_new_datas_ordered(steps)
  )
}
