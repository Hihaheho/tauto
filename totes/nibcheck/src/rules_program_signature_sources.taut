import "rules_program_signatures.taut"
import "../../surface/src/surface.taut"
import std::Base
import "checker.taut"
import "datas.taut"

pub fn signature_source_cons(head: Option(SurfaceFn), tail: List(SurfaceFn)): List(SurfaceFn) {
  match head: List(SurfaceFn) {
    None => tail
    Some(source) => Cons(source, tail)
  }
}
// Source coverage: declarations with bodies occur exactly once in this list,
// in source order, independently of whether their signatures report errors.
pub fn signature_statement_source(stmt: SurfaceStmt): Option(SurfaceFn) {
  match stmt: Option(SurfaceFn) {
    StLet(name, ty, value, borrow, mutable) => None
    StVar(name, ty, value, borrow) => None
    StModule(name, stmts, start, end) => None
    StAssign(name, name_place, value) => None
    StCalled(name_generates, value) => None
    StFn(f) => Some(f)
    StTheorem(t) => None
    StDef(t) => None
    StMutual(stmts, start, end) => None
    StImport(path, start, end) => None
    StInductive(i) => None
    StEffect(e) => None
    StExtern(abi, fns, start, end) => None
    StClass(klass) => None
    StInstance(i) => None
    StWhile(cond, body) => None
    StReturn(value) => None
    StExpr(value) => None
    StOther(what, start, end) => None
    StMacro(name, function, start, end) => None
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => None
    StSyntax(name, grammar, start, end) => None
    StStruct(d) => None
    StEnum(d) => None
  }
}
pub fn signature_program_sources(program: List(SurfaceStmt)): List(SurfaceFn) {
  match program: List(SurfaceFn) {
    Nil => Nil
    Cons(Stmt, rest) => signature_source_cons(
      signature_statement_source(Stmt),
      signature_program_sources(rest)
    )
  }
}
pub fn signature_option_source(item: Option(Pair(SurfaceFn, Scheme))): Option(SurfaceFn) {
  match item: Option(SurfaceFn) {
    None => None
    Some(entry) => Some(entry.fst)
  }
}
pub fn signature_list_sources(items: List(Pair(SurfaceFn, Scheme))): List(SurfaceFn) {
  match items: List(SurfaceFn) {
    Nil => Nil
    Cons(entry, rest) => Cons(entry.fst, signature_list_sources(rest))
  }
}
pub(open) inductive PreparedSourceSignatures(
  env: Datas,
  program: List(SurfaceStmt),
  schemes: List(Pair(SurfaceFn, Scheme))
): Prop {
  Mk(
    own: List(Pair(SurfaceFn, Scheme)),
    generated: List(Pair(SurfaceFn, Scheme)),
    combined: schemes = List::append(own, generated),
    sources: signature_list_sources(own) = signature_program_sources(program),
    derived: ElaboratedSignatures(env, false, own)
  ): PreparedSourceSignatures(env, program, schemes)
}

pub(open) inductive SourceFunctionsElaborated(env: Datas, program: List(SurfaceStmt)): Prop {
  Mk(
    schemes: List(Pair(SurfaceFn, Scheme)),
    sources: signature_list_sources(schemes) = signature_program_sources(program),
    derived: ElaboratedSignatures(env, false, schemes)
  ): SourceFunctionsElaborated(env, program)
}
