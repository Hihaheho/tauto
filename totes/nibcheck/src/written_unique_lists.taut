import "written_unique_function.taut"
import std::Map
import std::Text
import "datas.taut"
import "rules_written.taut"
import "ty.taut"
import "written_unique_base.taut"
import "../../surface/src/surface.taut"

pub theorem written_unique_terms_nil<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, other: List(
  Ty
)>(meaning: WrittenTerms(env, generics, partial, Nil, other)): Nil = other {
  match meaning: Nil = other { WrittenTermsNil(gs, mode) => Refl }
}
pub theorem written_unique_terms_cons<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, first: SurfaceTerm, rest: List(
  SurfaceTerm
), other: List(
  Ty
)>(
  meaning: WrittenTerms(env, generics, partial, Cons(first, rest), other),
  t: Ty,
  types: List(Ty),
  ihhead: WrittenTermUnique(generics, partial, false, first, t),
  ihtail: WrittenTermsUnique(generics, partial, rest, types)
): Cons(t, types) = other {
  match meaning: Cons(t, types) = other {
    WrittenTermsCons(gs, mode, term, terms, value, values, head, tail) => Eq::trans(
      Eq::congr((x: Ty) => Cons(x, types), ihhead(env, value, head)),
      Eq::congr((xs: List(Ty)) => Cons(value, xs), ihtail(env, values, tail))
    )
  }
}
pub theorem written_unique_parameters_nil<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, other: List(
  Ty
)>(meaning: WrittenParameters(env, generics, partial, Nil, other)): Nil = other {
  match meaning: Nil = other { WrittenParametersNil(gs, mode) => Refl }
}
pub theorem written_unique_parameters_cons<env: Datas, generics: Ordmap(
  Text,
  Ty
), partial: Bool, name: Option(
  Text
), body: SurfaceTerm, rest: List(
  SurfaceParam
), other: List(
  Ty
)>(
  meaning: WrittenParameters(
    env,
    generics,
    partial,
    Cons(SurfaceParamMk(name, body), rest),
    other
  ),
  t: Ty,
  types: List(Ty),
  ihhead: WrittenTermUnique(generics, partial, false, body, t),
  ihtail: WrittenParametersUnique(generics, partial, rest, types)
): Cons(t, types) = other {
  match meaning: Cons(t, types) = other {
    WrittenParametersCons(gs, mode, label, term, terms, value, values, head, tail) => Eq::trans(
      Eq::congr((x: Ty) => Cons(x, types), ihhead(env, value, head)),
      Eq::congr((xs: List(Ty)) => Cons(value, xs), ihtail(env, values, tail))
    )
  }
}
