}

pub fn rows_set_pass_rows(s: RowState, pass_rows: Ordmap(Text, RowSet)): RowState {
  RowState::Mk(
    s.memo,
    s.in_progress,
    s.calls,
    s.direct_vars,
    s.found,
    s.leaned,
    s.seeds,
