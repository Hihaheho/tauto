pub fn rows_set_leaned(s: RowState, leaned: RowSet): RowState {
  RowState::Mk(
    s.memo,
    s.in_progress,
    s.calls,
    s.direct_vars,
    s.found,
    leaned,
    s.seeds,
    s.pass_rows,
    s.pass_leaned,
    s.pass_log
  )
}

pub fn rows_set_seeds(s: RowState, seeds: Ordmap(Text, RowSet)): RowState {
  RowState::Mk(
    s.memo,
    s.in_progress,
    s.calls,
    s.direct_vars,
    s.found,
    s.leaned,
    seeds,
    s.pass_rows,
    s.pass_leaned,
    s.pass_log
