}

pub fn rows_set_found(s: RowState, found: List(RowDiagnostic)): RowState {
  RowState::Mk(
    s.memo,
    s.in_progress,
    s.calls,
    s.direct_vars,
    found,
    s.leaned,
    s.seeds,
    s.pass_rows,
    s.pass_leaned,
    s.pass_log
