  Nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
}

pub fn rows_names_has(names: List(Text), name: Text): Bool {
  match names {
    Nil => false
    Cons(n, rest) => n == name || rows_names_has(rest, name)
  }
}

pub fn rows_budget_inner(memory: Bool, inner: RowSet): RowSet {
  match memory {
    true => inner
    false => rowset_drop(inner, "div")
  }
}

// `#(a, b)` is read as an application of the prelude's `Pair::Mk`, which makes
// its value of its arguments alone, no call.
pub fn rows_record_app(s: RowState, t: SurfaceTerm, function: SurfaceTerm, arguments: List(SurfaceTerm), row: RowSet): RowState {
  match rows_is_product(function, arguments) {
    true => s
    false => rows_record_call(s, t, row)
  }
}

pub fn rows_is_product(function: SurfaceTerm, arguments: List(SurfaceTerm)): Bool {
  match function.kind {
    SkVar(n) => surface_name_text(n) == "std::prelude::Pair::Mk" && not(rows_no_terms(arguments))
    _ => false
  }
}

pub fn rows_field_named(field: Option(Text), name: Text): Bool {
  match field {
    Some(n) => n == name
    None => false
  }
}

// What a call performs, and `overflow` or `divzero` when it is an operator
// of the program whose result may not exist.
pub fn rows_with_operator(env: RowEnv, t: SurfaceTerm, function: SurfaceTerm, locals: List(RowLocal), row: RowSet): RowSet {
  match function.kind {
    SkVar(n) => if rows_local_has(locals, surface_name_text(n)) || rows_env_has(env, surface_name_text(n)) {
      row
    } else {
      match Ordmap::get(env.ops, RowSpan { start: t.start, end: t.end }, rows_compare_span) {
        Some(op_effect) => rowset_add(row, op_effect)
        None => row
      }
    }
    _ => row
  }
}
