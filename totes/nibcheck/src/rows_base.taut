  Cons("proc_spawn",
  Cons("proc_read",
  Cons("proc_write",
  Cons("proc_close_stdin",
  Cons("proc_wait",
  Cons("proc_close",
  Cons("proc_run",
  Cons("env",
  Cons("environ",
  Cons("permission",
  Cons("net",
  Cons("net_addr",
  Cons("net_resolve",
  Cons("net_open",
  Cons("net_write",
