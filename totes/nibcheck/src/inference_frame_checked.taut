pub theorem inference_frames_checked(k: Nat): InferenceFrames_checked(k) {
  match k: InferenceFrames_checked(k) {
    Zero => AndIntro(
      inference_zero_ck_infer_in_checked(),
      AndIntro(
        inference_zero_ck_infer_term_in_checked(),
        AndIntro(
          inference_zero_ck_else_in_checked(),
          AndIntro(
            inference_zero_ck_infer_each_in_checked(),
            AndIntro(
              inference_zero_ck_guard_in_checked(),
              AndIntro(
                inference_zero_ck_stmt_in_checked(),
                AndIntro(
                  inference_zero_ck_returned_in_checked(),
                  AndIntro(
                    inference_zero_ck_check_fn_in_checked(),
                    AndIntro(
                      inference_zero_ck_block_in_checked(),
                      AndIntro(
                        inference_zero_ck_app_args_in_checked(),
                        AndIntro(
                          inference_zero_ck_app_in_checked(),
                          AndIntro(
                            inference_zero_ck_app_call_in_checked(),
                            AndIntro(
                              inference_zero_ck_operands_in_checked(),
                              AndIntro(
                                inference_zero_ck_clone_of_in_checked(),
                                AndIntro(
                                  inference_zero_ck_lambda_in_checked(),
                                  AndIntro(
                                    inference_zero_ck_record_fields_in_checked(),
                                    AndIntro(
                                      inference_zero_ck_record_in_checked(),
                                      AndIntro(
                                        inference_zero_ck_match_arms_in_checked(),
                                        AndIntro(
                                          inference_zero_ck_match_expr_in_checked(),
                                          AndIntro(
                                            inference_zero_ck_handle_in_checked(),
                                            AndIntro(
                                              inference_zero_ck_handle_first_in_checked(),
                                              AndIntro(
                                                inference_zero_ck_handle_result_in_checked(),
                                                AndIntro(
                                                  inference_zero_ck_handle_arms_in_checked(),
                                                  AndIntro(
                                                    inference_zero_ck_handle_one_in_checked(),
                                                    AndIntro(
                                                      inference_zero_ck_handle_arm_in_checked(),
                                                      AndIntro(
                                                        inference_zero_ck_handle_body_in_checked(),
                                                        Trivial
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    Succ(j) => {
      let ih: InferenceFrames_checked(j) := inference_frames_checked(j)
      AndIntro(
        inference_successor_ck_infer_in_checked(j, ih),
        AndIntro(
          inference_successor_ck_infer_term_in_checked(j, ih),
          AndIntro(
            inference_successor_ck_else_in_checked(j, ih),
            AndIntro(
              inference_successor_ck_infer_each_in_checked(j, ih),
              AndIntro(
                inference_successor_ck_guard_in_checked(j, ih),
                AndIntro(
                  inference_successor_ck_stmt_in_checked(j, ih),
                  AndIntro(
                    inference_successor_ck_returned_in_checked(j, ih),
                    AndIntro(
                      inference_successor_ck_check_fn_in_checked(j, ih),
                      AndIntro(
                        inference_successor_ck_block_in_checked(j, ih),
                        AndIntro(
                          inference_successor_ck_app_args_in_checked(j, ih),
                          AndIntro(
                            inference_successor_ck_app_in_checked(j, ih),
                            AndIntro(
                              inference_successor_ck_app_call_in_checked(j, ih),
                              AndIntro(
                                inference_successor_ck_operands_in_checked(j, ih),
                                AndIntro(
                                  inference_successor_ck_clone_of_in_checked(j, ih),
                                  AndIntro(
                                    inference_successor_ck_lambda_in_checked(j, ih),
                                    AndIntro(
                                      inference_successor_ck_record_fields_in_checked(j, ih),
                                      AndIntro(
                                        inference_successor_ck_record_in_checked(j, ih),
                                        AndIntro(
                                          inference_successor_ck_match_arms_in_checked(j, ih),
                                          AndIntro(
                                            inference_successor_ck_match_expr_in_checked(j, ih),
                                            AndIntro(
                                              inference_successor_ck_handle_in_checked(j, ih),
                                              AndIntro(
                                                inference_successor_ck_handle_first_in_checked(
                                                  j,
                                                  ih
                                                ),
                                                AndIntro(
                                                  inference_successor_ck_handle_result_in_checked(
                                                    j,
                                                    ih
                                                  ),
                                                  AndIntro(
                                                    inference_successor_ck_handle_arms_in_checked(
                                                      j,
                                                      ih
                                                    ),
                                                    AndIntro(
                                                      inference_successor_ck_handle_one_in_checked(
                                                        j,
                                                        ih
                                                      ),
                                                      AndIntro(
                                                        inference_successor_ck_handle_arm_in_checked(
                                                          j,
                                                          ih
                                                        ),
                                                        AndIntro(
                                                          inference_successor_ck_handle_body_in_checked(
                                                            j,
                                                            ih
                                                          ),
                                                          Trivial
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    }
  }
}

