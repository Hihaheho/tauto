import "inference_frame.taut"
import "inference_terms_checked.taut"

pub theorem inference_zero_ck_infer_in_checked(): Inference_ck_infer_in_checked(Zero) {
  c => term => env => ordered => AndIntro(
    ordered,
    (clean_errors => False::elim(false_ne_true(Eq::congr(decl_names_empty, clean_errors))))
  )
}
pub theorem inference_successor_ck_infer_in_checked(
  j: Nat,
  ih: InferenceFrames_checked(j)
): Inference_ck_infer_in_checked(Succ(j)) {
  c => term => env => ordered => Eq::subst(
    (z: Mut1(Ty, Checker)) => CkCheckedFrame(c, z),
    Eq::sym(inference_unf_ck_infer_in(j, c, term, env)),
    inference_step_ck_infer_in_frame_checked(j, c, term, env, ih, ordered)
  )
}
