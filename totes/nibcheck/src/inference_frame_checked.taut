pub theorem ck_infer_frame_checked(
  c: Checker,
  term: SurfaceTerm,
  env: List(Local),
  ordered: CkOrdered(c)
): CkCheckedFrame(c, ck_infer(c, term, env)) {
  checked_frame_rewrap(
    c,
    ck_infer_in(ck_steps_of(c), c, term, env),
    ck_infer_in_frame_checked(ck_steps_of(c), c, term, env, ordered)
  )
}

