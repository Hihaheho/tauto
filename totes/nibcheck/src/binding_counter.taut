import "binding_allocation.taut"
import std::Base
import "checker.taut"
import "fits_sound.taut"
import "ty.taut"
import "unify_sound.taut"

pub def CounterUnchanged<A: Type>(
  c: Checker,
  m: Mut1(A, Checker)
): Prop := ck_next_of(c) = ck_next_of(ck_st(m))
pub theorem counter_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  h: CounterUnchanged(c, m)
): CounterUnchanged(c, ck_rewrap1(m)) {
  Eq::subst((result: Mut1(A, Checker)) => CounterUnchanged(c, result), Eq::sym(ck_rewrap1_id(m)), h)
}
pub theorem ck_bind_value_counter(
  c: Checker,
  v: Nat,
  t: Ty
): CounterUnchanged(c, ck_bind_value(c, v, t)) {
  Bool::cases(
    (flag: Bool) => CounterUnchanged(c, ck_bind_value_k(c, v, t, flag)),
    ck_occurs(c, v, t),
    ignored => Refl,
    ignored => Refl
  )
}
pub theorem ck_bind_other_counter(
  c: Checker,
  v: Nat,
  t: Ty
): CounterUnchanged(c, ck_bind_other(c, v, t)) {
  Bool::cases(
    (flag: Bool) => CounterUnchanged(c, ck_bind_other_k(c, v, t, flag)),
    ck_is_int(c, v),
    ignored => counter_rewrap(c, ck_bind_value(c, v, t), ck_bind_value_counter(c, v, t)),
    ignored => Refl
  )
}
pub theorem ck_var_set_counter(
  c: Checker,
  v: Nat,
  w: Nat,
  flag: Bool
): CounterUnchanged(c, ck_var_set(v, w, ck_int_k(c, w, flag))) {
  ⊢ CounterUnchanged(c, ck_var_set(v, w, ck_int_k(c, w, flag))) from match flag {
    true => Refl
    false => Refl
  }
}
pub theorem ck_bind_var_counter(
  c: Checker,
  v: Nat,
  w: Nat
): CounterUnchanged(c, ck_bind_var(c, v, w)) {
  Bool::cases(
    (flag: Bool) => CounterUnchanged(c, ck_bind_var_k(c, v, w, flag)),
    Nat::eq(w, v),
    ignored => ck_var_set_counter(c, v, w, ck_is_int(c, v)),
    ignored => Refl
  )
}
pub theorem ck_bind_unbound_counter(
  c: Checker,
  v: Nat,
  t: Ty
): CounterUnchanged(c, ck_bind_unbound(c, v, t)) {
  ⊢ CounterUnchanged(c, ck_bind_unbound(c, v, t)) from match t {
    TyInt(width) => counter_rewrap(
      c,
      ck_bind_value(c, v, TyInt(width)),
      ck_bind_value_counter(c, v, TyInt(width))
    )
    TyBool => counter_rewrap(c, ck_bind_other(c, v, TyBool), ck_bind_other_counter(c, v, TyBool))
    TyText => counter_rewrap(c, ck_bind_other(c, v, TyText), ck_bind_other_counter(c, v, TyText))
    TyUnit => counter_rewrap(c, ck_bind_other(c, v, TyUnit), ck_bind_other_counter(c, v, TyUnit))
    TyNever => counter_rewrap(c, ck_bind_other(c, v, TyNever), ck_bind_other_counter(c, v, TyNever))
    TyDecimal => counter_rewrap(
      c,
      ck_bind_other(c, v, TyDecimal),
      ck_bind_other_counter(c, v, TyDecimal)
    )
    TyFloat => counter_rewrap(c, ck_bind_other(c, v, TyFloat), ck_bind_other_counter(c, v, TyFloat))
    TyParam(name, kind) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyParam(name, kind)),
      ck_bind_other_counter(c, v, TyParam(name, kind))
    )
    TyVar(index) => counter_rewrap(c, ck_bind_var(c, v, index), ck_bind_var_counter(c, v, index))
    TyFn(params, result, kind) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyFn(params, result, kind)),
      ck_bind_other_counter(c, v, TyFn(params, result, kind))
    )
    TyUnion(members) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyUnion(members)),
      ck_bind_other_counter(c, v, TyUnion(members))
    )
    TyProduct(members) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyProduct(members)),
      ck_bind_other_counter(c, v, TyProduct(members))
    )
    TyNamed(name, params) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyNamed(name, params)),
      ck_bind_other_counter(c, v, TyNamed(name, params))
    )
    TyTagged(tags, inner) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyTagged(tags, inner)),
      ck_bind_other_counter(c, v, TyTagged(tags, inner))
    )
    TyInfo(inner) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyInfo(inner)),
      ck_bind_other_counter(c, v, TyInfo(inner))
    )
    TyBorrow(inner, mutable) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyBorrow(inner, mutable)),
      ck_bind_other_counter(c, v, TyBorrow(inner, mutable))
    )
    TyPoly(gs, inner) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyPoly(gs, inner)),
      ck_bind_other_counter(c, v, TyPoly(gs, inner))
    )
    TyApp(head, arg) => counter_rewrap(
      c,
      ck_bind_other(c, v, TyApp(head, arg)),
      ck_bind_other_counter(c, v, TyApp(head, arg))
    )
  }
}
pub theorem ck_bind_counter(c: Checker, v: Nat, t: Ty): CounterUnchanged(c, ck_bind(c, v, t)) {
  Bool::cases(
    (flag: Bool) => CounterUnchanged(c, ck_bind_k(c, v, t, flag)),
    ck_is_bound(c, v),
    ignored => counter_rewrap(c, ck_bind_unbound(c, v, t), ck_bind_unbound_counter(c, v, t)),
    ignored => Refl
  )
}
