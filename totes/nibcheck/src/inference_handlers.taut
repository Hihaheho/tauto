    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body
  ) { Refl }

pub fn inference_handler_arity(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  pa: ArmSig,
  wrong: Bool
): Mut1(Unit, Checker) {
  match wrong: Mut1(Unit, Checker) {
    true => ck_rewrap1(
      ck_error(
        c,
        cat5(
          "`",
          eff,
          "` gives ",
          Text::of_nat(list_len(inference_handler_params(pa))),
          cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
        ),
        span_of(body)
      )
    )
    false => ck_rewrap1(
      ck_handle_body_in(
        j,
        c,
        env,
        result,
        rv,
        eff,
        inference_handler_params(pa),
        inference_handler_answer(pa),
        inference_handler_rigid(pa),
        inference_handler_names(pa),
        patterns,
        cont,
        guard,
        body
      )
    )
  }
}

pub theorem inference_handler_arity_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  pa: ArmSig,
  wrong: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
  inference_handler_arity(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body,
    pa,
    wrong
  )
) {
  match wrong: CkRunFrame(
    c,
    inference_handler_arity(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      pa,
      wrong
    )
  ) {
    true => run_frame_read(
      c,
      ck_rewrap1(
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        )
      ),
      frame_rewrap(
        c,
        ck_error(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        ),
        ck_error_frame(
          c,
          cat5(
            "`",
            eff,
            "` gives ",
            Text::of_nat(list_len(inference_handler_params(pa))),
            cat2(" values, the arm takes ", Text::of_nat(list_len(patterns)))
          ),
          span_of(body)
        )
      ),
      ordered
    )
    false => run_frame_rewrap(
      c,
      ck_handle_body_in(
        j,
        c,
        env,
        result,
        rv,
        eff,
        inference_handler_params(pa),
        inference_handler_answer(pa),
        inference_handler_rigid(pa),
        inference_handler_names(pa),
        patterns,
        cont,
        guard,
        body
      ),
      inference_use_ck_handle_body_in(
        j,
        c,
        env,
        result,
        rv,
        eff,
        inference_handler_params(pa),
        inference_handler_answer(pa),
        inference_handler_rigid(pa),
        inference_handler_names(pa),
        patterns,
        cont,
        guard,
        body,
        ordered,
        ih
      )
    )
  }
}

pub fn inference_handler_signature(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  signature: Option(ArmSig)
): Mut1(Unit, Checker) {
  match signature: Mut1(Unit, Checker) {
    None => mut1(Star, c)
    Some(pa) => inference_handler_arity(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      pa,
      not(Nat::eq(list_len(inference_handler_params(pa)), list_len(patterns)))
    )
  }
}

pub theorem inference_handler_signature_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  signature: Option(ArmSig),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
  inference_handler_signature(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body,
    signature
  )
) {
  match signature: CkRunFrame(
    c,
    inference_handler_signature(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature
    )
  ) {
    None => run_frame_return(c, Star, ordered)
    Some(pa) => inference_handler_arity_frame(
      j,
      c,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      pa,
      not(Nat::eq(list_len(inference_handler_params(pa)), list_len(patterns))),
      ih,
      ordered
    )
  }
}

pub fn inference_step_ck_handle_arm_in(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm
): Mut1(Unit, Checker) {
  frame_bind(
    Option(ArmSig),
    Unit,
    (signature: Option(ArmSig), c1: Checker) => inference_handler_signature(
      j,
      c1,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature
    ),
    ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body)
  )
}

pub theorem inference_step_ck_handle_arm_in_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
  inference_step_ck_handle_arm_in(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body
  )
) {
  run_frame_bind(
    Option(ArmSig),
    Unit,
    c,
    (signature: Option(ArmSig), c1: Checker) => inference_handler_signature(
      j,
      c1,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature
    ),
    ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body),
    run_frame_read(
      c,
      ck_handle_arm_sig(c, eff, binds, types, result, rv, budget_ty, body),
      ck_handle_arm_sig_frame(c, eff, binds, types, result, rv, budget_ty, body),
      ordered
    ),
    signature => c1 => o_c1 => inference_handler_signature_frame(
      j,
      c1,
      env,
      result,
      rv,
      budget_ty,
      eff,
      binds,
      types,
      patterns,
      cont,
      guard,
      body,
      signature,
      ih,
      o_c1
    )
  )
}

pub theorem inference_unf_ck_handle_arm_in(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  budget_ty: Ty,
  eff: Text,
  binds: List(Text),
  types: List(SurfaceTerm),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
