    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body
  ) = inference_step_ck_handle_arm_in(
    j,
    c,
    env,
    result,
    rv,
    budget_ty,
    eff,
    binds,
    types,
    patterns,
    cont,
    guard,
    body
  ) { Refl }

pub fn inference_budget_push(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool
): Mut1(Unit, Checker) {
  match answers: Mut1(Unit, Checker) {
    true => inference_set_exceeded(c, Cons(budget_ty, inference_exceeded(c)))
    false => mut1(Star, c)
  }
}

pub theorem inference_budget_push_frame(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_budget_push(j, c, body, handlers, env, budget_ty, answers)) {
  match answers: CkRunFrame(
    c,
    inference_budget_push(j, c, body, handlers, env, budget_ty, answers)
  ) {
    true => run_frame_read(
      c,
      inference_set_exceeded(c, Cons(budget_ty, inference_exceeded(c))),
      inference_set_exceeded_frame(c, Cons(budget_ty, inference_exceeded(c))),
      ordered
    )
    false => run_frame_return(c, Star, ordered)
  }
}

pub fn inference_budget_pop(j: Nat, c: Checker, answers: Bool): Mut1(Unit, Checker) {
  match answers: Mut1(Unit, Checker) {
    true => inference_set_exceeded(c, List::tail(inference_exceeded(c)))
    false => mut1(Star, c)
  }
}

pub theorem inference_budget_pop_frame(
  j: Nat,
  c: Checker,
  answers: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_budget_pop(j, c, answers)) {
  match answers: CkRunFrame(c, inference_budget_pop(j, c, answers)) {
    true => run_frame_read(
      c,
      inference_set_exceeded(c, List::tail(inference_exceeded(c))),
      inference_set_exceeded_frame(c, List::tail(inference_exceeded(c))),
      ordered
    )
    false => run_frame_return(c, Star, ordered)
  }
}

pub fn inference_handle_budget(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool
): Mut1(Ty, Checker) {
  frame_bind(
    Unit,
    Ty,
    (pushed: Unit, c1: Checker) => frame_bind(
      Ty,
      Ty,
      (b: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env)
    ),
    inference_budget_push(j, c, body, handlers, env, budget_ty, answers)
  )
}

pub theorem inference_handle_budget_frame(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  budget_ty: Ty,
  answers: Bool,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_handle_budget(j, c, body, handlers, env, budget_ty, answers)) {
  run_frame_bind(
    Unit,
    Ty,
    c,
    (pushed: Unit, c1: Checker) => frame_bind(
      Ty,
      Ty,
      (b: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env)
    ),
    inference_budget_push(j, c, body, handlers, env, budget_ty, answers),
    inference_budget_push_frame(j, c, body, handlers, env, budget_ty, answers, ih, ordered),
    pushed => c1 => o_c1 => run_frame_bind(
      Ty,
      Ty,
      c1,
      (b: Ty, c2: Checker) => frame_bind(
        Unit,
        Ty,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers)
      ),
      ck_infer_in(j, c1, body, env),
      inference_use_ck_infer_in(j, c1, body, env, o_c1, ih),
      b => c2 => o_c2 => run_frame_bind(
        Unit,
        Ty,
        c2,
        (popped: Unit, c3: Checker) => frame_bind(
          Ty,
          Ty,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3)
        ),
        inference_budget_pop(j, c2, answers),
        inference_budget_pop_frame(j, c2, answers, ih, o_c2),
        popped => c3 => o_c3 => run_frame_bind(
          Ty,
          Ty,
          c3,
          (result: Ty, c4: Checker) => frame_bind(
            Ty,
            Ty,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env)
          ),
          ck_fresh(c3),
          run_frame_read(c3, ck_fresh(c3), ck_fresh_frame(c3), o_c3),
          result => c4 => o_c4 => run_frame_bind(
            Ty,
            Ty,
            c4,
            (first: Ty, c5: Checker) => frame_bind(
              Unit,
              Ty,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty)
            ),
            ck_handle_first_in(j, c4, handlers, b, env),
            inference_use_ck_handle_first_in(j, c4, handlers, b, env, o_c4, ih),
            first => c5 => o_c5 => run_frame_bind(
              Unit,
              Ty,
              c5,
              (finished: Unit, c6: Checker) => mut1(result, c6),
              ck_handle_result_in(j, c5, handlers, env, result, first, budget_ty),
              inference_use_ck_handle_result_in(
                j,
                c5,
                handlers,
                env,
                result,
                first,
                budget_ty,
                o_c5,
                ih
              ),
              finished => c6 => o_c6 => run_frame_return(c6, result, o_c6)
            )
          )
        )
      )
    )
  )
}

pub fn inference_handle_after(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  answers: Bool
): Mut1(Ty, Checker) {
  frame_bind(
    Ty,
    Ty,
    (budget_ty: Ty, c1: Checker) => inference_handle_budget(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      answers
    ),
    ck_fresh(c)
  )
}

pub fn inference_handle_original(
  j: Nat,
  &mut c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  answers: Bool
): Ty {
  let budget_ty := ck_fresh(&mut c)
  if answers { set_to(&mut c.exceeded, Cons(budget_ty, c.exceeded)) }
  let b := ck_infer_in(j, &mut c, body, env)
  if answers { set_to(&mut c.exceeded, List::tail(c.exceeded)) }
  let result := ck_fresh(&mut c)
  let first := ck_handle_first_in(j, &mut c, handlers, b, env)
  ck_handle_result_in(j, &mut c, handlers, env, result, first, budget_ty)
  result
}

pub theorem inference_handle_boolean(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  answers: Bool
): inference_handle_original(j, c, body, handlers, env, answers) = inference_handle_after(j, c, body, handlers, env, answers) { match answers: inference_handle_original(j, c, body, handlers, env, answers) = inference_handle_after(j, c, body, handlers, env, answers) { true => Refl
    false => Refl } }

pub fn inference_step_ck_handle_in(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local)
): Mut1(Ty, Checker) {
  frame_bind(
    Ty,
    Ty,
    (budget_ty: Ty, c1: Checker) => inference_handle_budget(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers)
    ),
    ck_fresh(c)
  )
}

pub theorem inference_step_ck_handle_in_frame(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local),
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_step_ck_handle_in(j, c, body, handlers, env)) {
  run_frame_bind(
    Ty,
    Ty,
    c,
    (budget_ty: Ty, c1: Checker) => inference_handle_budget(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers)
    ),
    ck_fresh(c),
    run_frame_read(c, ck_fresh(c), ck_fresh_frame(c), ordered),
    budget_ty => c1 => o_c1 => inference_handle_budget_frame(
      j,
      c1,
      body,
      handlers,
      env,
      budget_ty,
      handlers_answer_exceeded(handlers),
      ih,
      o_c1
    )
  )
}

pub theorem inference_unf_ck_handle_in(
  j: Nat,
  c: Checker,
  body: SurfaceTerm,
  handlers: List(SurfaceHandler),
  env: List(Local)
): ck_handle_in(Succ(j), c, body, handlers, env) = inference_step_ck_handle_in(j, c, body, handlers, env) { inference_handle_boolean(j, c, body, handlers, env, handlers_answer_exceeded(handlers)) }
