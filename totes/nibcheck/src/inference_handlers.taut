// After the continuation is bound: the arm's names are put in scope, its
// guard and body checked, and the arm finished with the outer names back.
pub fn inference_arm_tail(
  j: Nat,
  c: Checker,
  inner: Scope,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  rigid: List(Text),
  names: List(TypeName),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm
): Mut1(Unit, Checker) {
  frame_bind(
    Unit,
    Unit,
    (entered: Unit, c1: Checker) => frame_bind(
      Unit,
      Unit,
      (guarded: Unit, c2: Checker) => frame_bind(
        Ty,
        Unit,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner))
    ),
    ck_arm_enter(c, names)
  )
}

pub theorem inference_arm_tail_frame(
  j: Nat,
  c: Checker,
  inner: Scope,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  rigid: List(Text),
  names: List(TypeName),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(c, inference_arm_tail(j, c, inner, env, result, rv, eff, rigid, names, guard, body)) {
  run_frame_bind(
    Unit,
    Unit,
    c,
    (entered: Unit, c1: Checker) => frame_bind(
      Unit,
      Unit,
      (guarded: Unit, c2: Checker) => frame_bind(
        Ty,
        Unit,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner))
    ),
    ck_arm_enter(c, names),
    run_frame_read(c, ck_arm_enter(c, names), ck_arm_enter_frame(c, names), ordered),
    entered => c1 => o_c1 => run_frame_bind(
      Unit,
      Unit,
      c1,
      (guarded: Unit, c2: Checker) => frame_bind(
        Ty,
        Unit,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner))
      ),
      ck_guard_in(j, c1, guard, inference_scope_items(inner)),
      inference_use_ck_guard_in(j, c1, guard, inference_scope_items(inner), o_c1, ih),
      guarded => c2 => o_c2 => run_frame_bind(
        Ty,
        Unit,
        c2,
        (a: Ty, c3: Checker) => ck_rewrap1(
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          )
        ),
        ck_infer_in(j, c2, body, inference_scope_items(inner)),
        inference_use_ck_infer_in(j, c2, body, inference_scope_items(inner), o_c2, ih),
        a => c3 => o_c3 => run_frame_rewrap(
          c3,
          ck_handle_arm_finish(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body)
          ),
          ck_handle_arm_finish_run_frame(
            c3,
            eff,
            rigid,
            env,
            ck_type_params_of(c),
            a,
            result,
            rv,
            span_of(body),
            o_c3
          )
        )
      )
    )
  )
}

pub fn inference_handle_body_step(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  params: List(Ty),
  answer: Ty,
  rigid: List(Text),
  names: List(TypeName),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  quant: Quant
): Mut1(Unit, Checker) {
  frame_bind(
    Unit,
    Unit,
    (r#direct: Unit, c1: Checker) => inference_bind_scope(
      Unit,
      Unit,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        Unit,
        Unit,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body)
    ),
    ck_handle_direct(c, quant, eff, cont, guard, body)
  )
}

pub theorem inference_handle_body_step_frame(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  params: List(Ty),
  answer: Ty,
  rigid: List(Text),
  names: List(TypeName),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm,
  quant: Quant,
  ih: InferenceFrames(j),
  ordered: CkOrdered(c)
): CkRunFrame(
  c,
  inference_handle_body_step(
    j,
    c,
    env,
    result,
    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body,
    quant
  )
) {
  run_frame_bind(
    Unit,
    Unit,
    c,
    (r#direct: Unit, c1: Checker) => inference_bind_scope(
      Unit,
      Unit,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        Unit,
        Unit,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body)
    ),
    ck_handle_direct(c, quant, eff, cont, guard, body),
    run_frame_read(
      c,
      ck_handle_direct(c, quant, eff, cont, guard, body),
      ck_handle_direct_frame(c, quant, eff, cont, guard, body),
      ordered
    ),
    r#direct => c1 => o_c1 => inference_bind_scope_frame(
      Unit,
      Unit,
      c1,
      (matched: Unit, c2: Checker, inner: Scope) => inference_bind_scope(
        Unit,
        Unit,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body)
      ),
      ck_handle_patterns(patterns, c1, params, ScopeMk(env), body),
      ck_handle_patterns_frame(patterns, c1, params, ScopeMk(env), body, o_c1),
      matched => c2 => inner => o_c2 => inference_bind_scope_frame(
        Unit,
        Unit,
        c2,
        (bound: Unit, c3: Checker, inner2: Scope) => inference_arm_tail(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body
        ),
        ck_handle_cont(c2, inner, quant, eff, cont, answer, result, body),
        ck_handle_cont_frame(c2, inner, quant, eff, cont, answer, result, body, o_c2),
        bound => c3 => inner2 => o_c3 => inference_arm_tail_frame(
          j,
          c3,
          inner2,
          env,
          result,
          rv,
          eff,
          rigid,
          names,
          guard,
          body,
          ih,
          o_c3
        )
      )
    )
  )
}

pub fn inference_step_ck_handle_body_in(
  j: Nat,
  c: Checker,
  env: List(Local),
  result: Ty,
  rv: Option(Nat),
  eff: Text,
  params: List(Ty),
  answer: Ty,
  rigid: List(Text),
  names: List(TypeName),
  patterns: List(SurfacePattern),
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm
): Mut1(Unit, Checker) {
  inference_handle_body_step(
    j,
    c,
    env,
    result,
    rv,
    eff,
    params,
    answer,
    rigid,
    names,
    patterns,
    cont,
    guard,
    body,
    ck_quant_of(c, eff)
  )
}

