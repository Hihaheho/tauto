import "inference_base.taut"
import "record_error_sound.taut"

pub theorem inference_set_hint_frame_errors(
  c: Checker,
  value: Option(Ty)
): CkErrorFrame(c, inference_set_hint(c, value)) { (clean_errors => clean_errors) }

pub theorem inference_set_returns_frame_errors(
  c: Checker,
  value: List(Ty)
): CkErrorFrame(c, inference_set_returns(c, value)) { (clean_errors => clean_errors) }

pub theorem inference_set_assume_frame_errors(
  c: Checker,
  value: List(Pair(Text, Text))
): CkErrorFrame(c, inference_set_assume(c, value)) { (clean_errors => clean_errors) }

pub theorem inference_set_exceeded_frame_errors(
  c: Checker,
  value: List(Ty)
): CkErrorFrame(c, inference_set_exceeded(c, value)) { (clean_errors => clean_errors) }

pub theorem inference_record_closure_frame_errors(
  c: Checker,
  t: Ty,
  body: SurfaceTerm
): CkErrorFrame(c, inference_record_closure(c, t, body)) { (clean_errors => clean_errors) }
