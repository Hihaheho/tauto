import "instantiation_scheme_records.taut"

pub def RequirementState(
  c: Checker,
  next: Checker
): Prop := And(
  Sub(TyBound, finish_bounds(c), finish_bounds(next)),
  Sub(TyCtorBound, finish_ctor_bounds(c), finish_ctor_bounds(next))
)
pub def RequirementFrame<A: Type>(
  c: Checker,
  m: Mut1(A, Checker)
): Prop := RequirementState(c, ck_st(m))
pub theorem requirement_state_refl(c: Checker): RequirementState(c, c) {
  AndIntro(
    (item: TyBound, member: Mem(TyBound, item, finish_bounds(c))) => member,
    (item: TyCtorBound, member: Mem(TyCtorBound, item, finish_ctor_bounds(c))) => member
  )
}
pub theorem requirement_state_trans(
  c: Checker,
  next: Checker,
  last: Checker,
  first: RequirementState(c, next),
  tail: RequirementState(next, last)
): RequirementState(c, last) {
  AndIntro(
    (item: TyBound, member: Mem(TyBound, item, finish_bounds(c))) => And::left(
      tail
    )(item, And::left(first)(item, member)),
    (item: TyCtorBound, member: Mem(TyCtorBound, item, finish_ctor_bounds(c))) => And::right(
      tail
    )(item, And::right(first)(item, member))
  )
}
pub theorem requirement_frame_bind<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  first: RequirementFrame(c, m),
  tail: ∀ value: A. ∀ next: Checker. RequirementFrame(next, k(value, next))
): RequirementFrame(c, frame_bind(A, B, k, m)) {
  match m: RequirementFrame(c, frame_bind(A, B, k, m)) {
    mut1(value, next) => requirement_state_trans(
      c,
      next,
      ck_st(k(value, next)),
      first,
      tail(value, next)
    )
  }
}
pub theorem requirement_frame_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  h: RequirementFrame(c, m)
): RequirementFrame(c, ck_rewrap1(m)) {
  Eq::subst((result: Mut1(A, Checker)) => RequirementFrame(c, result), Eq::sym(ck_rewrap1_id(m)), h)
}
pub theorem requirement_fresh_frame(
  c: Checker
): RequirementFrame(c, ck_fresh(c)) { requirement_state_refl(c) }
pub fn instance_scalar_bound(
  g: Pair(Text, Kind),
  value: Ty,
  span: TySpan
): TyBound { TyBound {ty: value, kind: (g: Kind), start: span.start, end: span.end} }
pub fn instance_constructor_bound(
  g: Pair(Text, Kind),
  value: Ty,
  name: Text,
  span: TySpan,
  arg: Kind
): TyCtorBound {
  TyCtorBound {ty: value, arg: arg, result: (g: Kind), what: name, start: span.start, end: span.end}
}
pub theorem instantiation_bound_frame_requirements(
  c: Checker,
  g: Pair(Text, Kind),
  value: Ty,
  name: Text,
  span: TySpan,
  arg: Option(Kind)
): RequirementFrame(c, instantiation_bound(c, g, value, name, span, arg)) {
  match arg: RequirementFrame(c, instantiation_bound(c, g, value, name, span, arg)) {
    None => AndIntro(
      (item: TyBound, member: Mem(TyBound, item, finish_bounds(c))) => MemThere(
        instance_scalar_bound(g, value, span),
        finish_bounds(c),
        member
      ),
      (item: TyCtorBound, member: Mem(TyCtorBound, item, finish_ctor_bounds(c))) => member
    )
    Some(kind) => AndIntro(
      (item: TyBound, member: Mem(TyBound, item, finish_bounds(c))) => member,
      (item: TyCtorBound, member: Mem(TyCtorBound, item, finish_ctor_bounds(c))) => MemThere(
        instance_constructor_bound(g, value, name, span, kind),
        finish_ctor_bounds(c),
        member
      )
    )
  }
}
pub theorem instantiation_cons_frame_requirements(
  g: Pair(Text, Kind),
  rest: List(Pair(Text, Kind)),
  c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ more: Ordmap(
    Text,
    Ty
  ). RequirementFrame(next, ck_instantiate_map_ctors(rest, next, ctors, name, span, more))
): RequirementFrame(c, instantiation_cons(g, rest, c, ctors, name, span, map)) {
  requirement_frame_bind(
    Ty,
    Ordmap(Text, Ty),
    c,
    (v: Ty, c1: Checker) => frame_bind(
      Unit,
      Ordmap(Text, Ty),
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        )
      ),
      instantiation_bound(c1, g, v, name, span, ctor_arg_of(ctors, instantiation_name(g)))
    ),
    ck_fresh(c),
    requirement_fresh_frame(c),
    v => c1 => requirement_frame_bind(
      Unit,
      Ordmap(Text, Ty),
      c1,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        )
      ),
      instantiation_bound(c1, g, v, name, span, ctor_arg_of(ctors, instantiation_name(g))),
      instantiation_bound_frame_requirements(
        c1,
        g,
        v,
        name,
        span,
        ctor_arg_of(ctors, instantiation_name(g))
      ),
      ignored => c2 => requirement_frame_rewrap(
        c2,
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        ),
        ih(c2, Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text))
      )
    )
  )
}

pub theorem ck_instantiate_map_ctors_frame_requirements(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty)
): RequirementFrame(c, ck_instantiate_map_ctors(gs, c, ctors, name, span, map)) {
  match gs: RequirementFrame(c, ck_instantiate_map_ctors(gs, c, ctors, name, span, map)) {
    Nil => requirement_state_refl(c)
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => RequirementFrame(c, z),
      Eq::sym(instantiation_cons_unf(g, rest, c, ctors, name, span, map)),
      instantiation_cons_frame_requirements(
        g,
        rest,
        c,
        ctors,
        name,
        span,
        map,
        next => more => ck_instantiate_map_ctors_frame_requirements(
          rest,
          next,
          ctors,
          name,
          span,
          more
        )
      )
    )
  }
}
pub theorem ck_instantiate_map_frame_requirements(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  span: TySpan,
  map: Ordmap(Text, Ty)
): RequirementFrame(c, ck_instantiate_map(gs, c, span, map)) {
  requirement_frame_rewrap(
    c,
    ck_instantiate_map_ctors(gs, c, Nil, "", span, map),
    ck_instantiate_map_ctors_frame_requirements(gs, c, Nil, "", span, map)
  )
}
pub theorem ck_pend_frame_requirements(
  c: Checker,
  r#class: Text,
  t: Ty,
  what: Text,
  span: TySpan
): RequirementFrame(c, ck_pend(c, r#class, t, what, span)) { requirement_state_refl(c) }

pub theorem instantiation_pred_frame_requirements(
  c: Checker,
  p: Pair(Text, Text),
  what: Text,
  span: TySpan,
  found: Option(Ty)
): RequirementFrame(c, instantiation_pred(c, p, what, span, found)) {
  match found: RequirementFrame(c, instantiation_pred(c, p, what, span, found)) {
    None => requirement_state_refl(c)
    Some(t) => requirement_frame_rewrap(
      c,
      ck_pend(c, instantiation_constraint(p), t, what, span),
      ck_pend_frame_requirements(c, instantiation_constraint(p), t, what, span)
    )
  }
}

pub theorem instantiation_preds_cons_frame_requirements(
  p: Pair(Text, Text),
  rest: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  ih: ∀ next: Checker. RequirementFrame(next, ck_pend_preds(rest, next, map, what, span))
): RequirementFrame(c, instantiation_preds_cons(p, rest, c, map, what, span)) {
  requirement_frame_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_pend_preds(rest, c1, map, what, span)),
    instantiation_pred(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    instantiation_pred_frame_requirements(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    ignored => c1 => requirement_frame_rewrap(c1, ck_pend_preds(rest, c1, map, what, span), ih(c1))
  )
}

pub theorem ck_pend_preds_frame_requirements(
  ps: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): RequirementFrame(c, ck_pend_preds(ps, c, map, what, span)) {
  match ps: RequirementFrame(c, ck_pend_preds(ps, c, map, what, span)) {
    Nil => requirement_state_refl(c)
    Cons(p, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => RequirementFrame(c, z),
      Eq::sym(instantiation_preds_cons_unf(p, rest, c, map, what, span)),
      instantiation_preds_cons_frame_requirements(
        p,
        rest,
        c,
        map,
        what,
        span,
        next => ck_pend_preds_frame_requirements(rest, next, map, what, span)
      )
    )
  }
}

pub theorem instantiation_named_cons_frame_requirements(
  g: Text,
  rest: List(Text),
  c: Checker,
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ more: Ordmap(
    Text,
    Ty
  ). RequirementFrame(next, ck_instantiate_named_map(rest, next, more))
): RequirementFrame(c, instantiation_named_cons(g, rest, c, map)) {
  requirement_frame_bind(
    Ty,
    Ordmap(Text, Ty),
    c,
    (v: Ty, c1: Checker) => ck_rewrap1(
      ck_instantiate_named_map(rest, c1, Ordmap::insert(map, g, v, Ordmap::compare_text))
    ),
    ck_fresh(c),
    requirement_fresh_frame(c),
    v => c1 => requirement_frame_rewrap(
      c1,
      ck_instantiate_named_map(rest, c1, Ordmap::insert(map, g, v, Ordmap::compare_text)),
      ih(c1, Ordmap::insert(map, g, v, Ordmap::compare_text))
    )
  )
}

pub theorem ck_instantiate_named_map_frame_requirements(
  gs: List(Text),
  c: Checker,
  map: Ordmap(Text, Ty)
): RequirementFrame(c, ck_instantiate_named_map(gs, c, map)) {
  match gs: RequirementFrame(c, ck_instantiate_named_map(gs, c, map)) {
    Nil => requirement_state_refl(c)
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => RequirementFrame(c, z),
      Eq::sym(instantiation_named_cons_unf(g, rest, c, map)),
      instantiation_named_cons_frame_requirements(
        g,
        rest,
        c,
        map,
        next => more => ck_instantiate_named_map_frame_requirements(rest, next, more)
      )
    )
  }
}

pub theorem instantiation_ck_instantiate_frame_requirements(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  t: Ty,
  span: TySpan
): RequirementFrame(c, instantiation_ck_instantiate(c, gs, t, span)) {
  requirement_frame_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => mut1(ty_substitute(t, map), c1),
    ck_instantiate_map(gs, c, span, Ordmap::empty()),
    ck_instantiate_map_frame_requirements(gs, c, span, Ordmap::empty()),
    map => c1 => requirement_state_refl(c1)
  )
}

pub theorem ck_instantiate_frame_requirements(
  c: Checker,
  gs: List(Pair(Text, Kind)),
  t: Ty,
  span: TySpan
): RequirementFrame(c, ck_instantiate(c, gs, t, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => RequirementFrame(c, z),
    Eq::sym(instantiation_ck_instantiate_unf(c, gs, t, span)),
    instantiation_ck_instantiate_frame_requirements(c, gs, t, span)
  )
}

pub theorem instantiation_ck_instantiate_named_frame_requirements(
  c: Checker,
  gs: List(Text),
  t: Ty
): RequirementFrame(c, instantiation_ck_instantiate_named(c, gs, t)) {
  requirement_frame_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => mut1(ty_substitute(t, map), c1),
    ck_instantiate_named_map(gs, c, Ordmap::empty()),
    ck_instantiate_named_map_frame_requirements(gs, c, Ordmap::empty()),
    map => c1 => requirement_state_refl(c1)
  )
}

pub theorem ck_instantiate_named_frame_requirements(
  c: Checker,
  gs: List(Text),
  t: Ty
): RequirementFrame(c, ck_instantiate_named(c, gs, t)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => RequirementFrame(c, z),
    Eq::sym(instantiation_ck_instantiate_named_unf(c, gs, t)),
    instantiation_ck_instantiate_named_frame_requirements(c, gs, t)
  )
}

pub theorem instantiation_scheme_frame_requirements(
  c: Checker,
  name: Text,
  s: Scheme,
  span: TySpan
): RequirementFrame(c, instantiation_scheme(c, name, s, span)) {
  requirement_frame_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(ty_substitute(instantiation_scheme_ty(s), map), c2),
      ck_pend_preds(instantiation_scheme_preds(s), c1, map, name, span)
    ),
    ck_instantiate_map_ctors(
      instantiation_scheme_generics(s),
      c,
      instantiation_scheme_ctors(s),
      name,
      span,
      Ordmap::empty()
    ),
    ck_instantiate_map_ctors_frame_requirements(
      instantiation_scheme_generics(s),
      c,
      instantiation_scheme_ctors(s),
      name,
      span,
      Ordmap::empty()
    ),
    map => c1 => requirement_frame_bind(
      Unit,
      Ty,
      c1,
      (ignored: Unit, c2: Checker) => mut1(ty_substitute(instantiation_scheme_ty(s), map), c2),
      ck_pend_preds(instantiation_scheme_preds(s), c1, map, name, span),
      ck_pend_preds_frame_requirements(instantiation_scheme_preds(s), c1, map, name, span),
      ignored => c2 => requirement_state_refl(c2)
    )
  )
}

pub theorem ck_instantiate_scheme_frame_requirements(
  c: Checker,
  name: Text,
  s: Scheme,
  span: TySpan
): RequirementFrame(c, ck_instantiate_scheme(c, name, s, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => RequirementFrame(c, z),
    Eq::sym(instantiation_scheme_unf(c, name, s, span)),
    instantiation_scheme_frame_requirements(c, name, s, span)
  )
}
