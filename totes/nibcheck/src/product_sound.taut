import "union_sound.taut"
import std::base
import std::row
import "ty.taut"

// Where the members of `ty_product(ts)` come from: each is a member of `ts`, or a member of a
// product among them (`product_members_of` takes the members of a last member that is a
// product). The kind of a product is bounded through this.

// The members of a type read as a product: a product's own list, none for
// `()`, the type itself otherwise.
pub fn ty_pmembers(u: Ty): List(Ty) {
  match u {
    TyProduct(ys) => ys
    TyUnit => Nil
    _ => Cons(u, Nil)
  }
}

// `t` is one of the list, or one of a product in it.
pub(open) inductive PLeaves(t: Ty): (List(Ty)) -> Prop {
  PlvHere(rest: List(Ty)): PLeaves(t, Cons(t, rest))
  PlvIn(ys: List(Ty), rest: List(Ty), l: PLeaves(t, ys)): PLeaves(t, Cons(TyProduct(ys), rest))
  PlvThere(y: Ty, rest: List(Ty), l: PLeaves(t, rest)): PLeaves(t, Cons(y, rest))
}

pub theorem mem_pleaves(e: Ty, ys: List(Ty), m: Mem(Ty, e, ys)): PLeaves(e, ys) {
  match m {
    MemHere(rest) => PlvHere(<t: e>, rest)
    MemThere(x, rest, inside) => PlvThere(<t: e>, x, rest, mem_pleaves(e, rest, inside))
  }
}

// What is one of a product that is a leaf is a leaf too.
pub theorem pleaves_in(
  ys: List(Ty),
  ts: List(Ty),
  l: PLeaves(TyProduct(ys), ts),
  e: Ty,
  m: Mem(Ty, e, ys)
): PLeaves(e, ts) {
  match l {
    PlvHere(rest) => PlvIn(<t: e>, ys, rest, mem_pleaves(e, ys, m))
    PlvIn(zs, rest, l2) => PlvIn(<t: e>, zs, rest, pleaves_in(ys, zs, l2, e, m))
    PlvThere(y, rest, l2) => PlvThere(<t: e>, y, rest, pleaves_in(ys, rest, l2, e, m))
  }
}

pub theorem pml_one(
  x: Ty,
  t: Ty,
  whole: Ty,
  ew: t = whole,
  m: Mem(Ty, x, Cons(whole, Nil(<A: Ty>)))
): PLeaves(x, Cons(t, Nil(<A: Ty>))) {
  Eq::subst(
    (z: Ty) => PLeaves(x, Cons(z, Nil(<A: Ty>))),
    Eq::sym(ew),
    mem_pleaves(x, Cons(whole, Nil(<A: Ty>)), m)
  )
}

pub theorem pm_cons_leaves(
  x: Ty,
  t: Ty,
  rest: List(Ty),
  ih: ∀ y: Ty. (Mem(Ty, y, product_members_of(rest))) -> PLeaves(y, rest),
  ihl: ∀ y: Ty. (Mem(Ty, y, product_members_last(t, t))) -> PLeaves(y, Cons(t, Nil(<A: Ty>))),
  m: Mem(Ty, x, product_members_of(Cons(t, rest)))
): PLeaves(x, Cons(t, rest)) {
  match rest {
    Nil => ihl(x, m)
    Cons(second, more) => Or::elim(
      mem_cons_inv(t, product_members_of(Cons(second, more)), m),
      q => Eq::subst(
        (z: Ty) => PLeaves(z, Cons(t, Cons(second, more))),
        Eq::sym(q),
        PlvHere(<t: t>, Cons(second, more))
      ),
      k => PlvThere(<t: x>, t, Cons(second, more), ih(x, k))
    )
  }
}

// Each of `product_members_of(ts)` is a leaf of `ts`.
mutual {
  pub theorem pm_leaves(
    x: Ty,
    ts: List(Ty),
    m: Mem(Ty, x, product_members_of(ts))
  ): PLeaves(x, ts) {
    match ts {
      Nil => Mem::nil(PLeaves(x, Nil(<A: Ty>)), m)
      Cons(t, rest) => pm_cons_leaves(
        x,
        t,
        rest,
        y => my => pm_leaves(y, rest, my),
        y => my => pml_leaves(y, t, t, Refl, my),
        m
      )
    }
  }

  pub theorem pml_leaves(
    x: Ty,
    t: Ty,
    whole: Ty,
    ew: t = whole,
    m: Mem(Ty, x, product_members_last(t, whole))
  ): PLeaves(x, Cons(t, Nil(<A: Ty>))) {
    match t {
      TyProduct(inner) => PlvIn(<t: x>, inner, Nil(<A: Ty>), pm_leaves(x, inner, m))
      TyInt(w) => pml_one(x, TyInt(w), whole, ew, m)
      TyBool => pml_one(x, TyBool, whole, ew, m)
      TyText => pml_one(x, TyText, whole, ew, m)
      TyNever => pml_one(x, TyNever, whole, ew, m)
      TyDecimal => pml_one(x, TyDecimal, whole, ew, m)
      TyFloat => pml_one(x, TyFloat, whole, ew, m)
      TyFloat32 => pml_one(x, TyFloat32, whole, ew, m)
      TyFn(ps, r, k) => pml_one(x, TyFn(ps, r, k), whole, ew, m)
      TyUnion(zs) => pml_one(x, TyUnion(zs), whole, ew, m)
      TyTagged(tags, inn) => pml_one(x, TyTagged(tags, inn), whole, ew, m)
      TyNamed(nm, args) => pml_one(x, TyNamed(nm, args), whole, ew, m)
      TyParam(nm, k) => pml_one(x, TyParam(nm, k), whole, ew, m)
      TyInfo(inn) => pml_one(x, TyInfo(inn), whole, ew, m)
      TyBorrow(inn, mu) => pml_one(x, TyBorrow(inn, mu), whole, ew, m)
      TyVar(v) => pml_one(x, TyVar(v), whole, ew, m)
      TyPoly(gs, inn) => pml_one(x, TyPoly(gs, inn), whole, ew, m)
      TyApp(hd, inn) => pml_one(x, TyApp(hd, inn), whole, ew, m)
      TyUnit => pml_one(x, TyUnit, whole, ew, m)
    }
  }
}

pub theorem pone_plain(
  e: Ty,
  ts: List(Ty),
  o: Ty,
  whole: Ty,
  ew: o = whole,
  hw: PLeaves(whole, ts),
  m: Mem(Ty, e, Cons(o, Nil(<A: Ty>)))
): PLeaves(e, ts) {
  Or::elim(
    mem_cons_inv(o, Nil(<A: Ty>), m),
    q => Eq::subst(
      (z: Ty) => PLeaves(z, ts),
      Eq::sym(q),
      Eq::subst((z: Ty) => PLeaves(z, ts), Eq::sym(ew), hw)
    ),
    k => Mem::nil(PLeaves(e, ts), k)
  )
}

// A product of one member `o` has the members of `o`.
pub theorem pone_leaves(
  e: Ty,
  ts: List(Ty),
  o: Ty,
  whole: Ty,
  ew: o = whole,
  hw: PLeaves(whole, ts),
  m: Mem(Ty, e, ty_pmembers(o))
): PLeaves(e, ts) {
  match o {
    TyProduct(ys) => pleaves_in(
      ys,
      ts,
      Eq::subst((z: Ty) => PLeaves(z, ts), Eq::sym(ew), hw),
      e,
      m
    )
    TyUnit => Mem::nil(PLeaves(e, ts), m)
    TyInt(w) => pone_plain(e, ts, TyInt(w), whole, ew, hw, m)
    TyBool => pone_plain(e, ts, TyBool, whole, ew, hw, m)
    TyText => pone_plain(e, ts, TyText, whole, ew, hw, m)
    TyNever => pone_plain(e, ts, TyNever, whole, ew, hw, m)
    TyDecimal => pone_plain(e, ts, TyDecimal, whole, ew, hw, m)
    TyFloat => pone_plain(e, ts, TyFloat, whole, ew, hw, m)
    TyFloat32 => pone_plain(e, ts, TyFloat32, whole, ew, hw, m)
    TyFn(ps, r, k) => pone_plain(e, ts, TyFn(ps, r, k), whole, ew, hw, m)
    TyUnion(zs) => pone_plain(e, ts, TyUnion(zs), whole, ew, hw, m)
    TyTagged(tags, inn) => pone_plain(e, ts, TyTagged(tags, inn), whole, ew, hw, m)
    TyNamed(nm, args) => pone_plain(e, ts, TyNamed(nm, args), whole, ew, hw, m)
    TyParam(nm, k) => pone_plain(e, ts, TyParam(nm, k), whole, ew, hw, m)
    TyInfo(inn) => pone_plain(e, ts, TyInfo(inn), whole, ew, hw, m)
    TyBorrow(inn, mu) => pone_plain(e, ts, TyBorrow(inn, mu), whole, ew, hw, m)
    TyVar(v) => pone_plain(e, ts, TyVar(v), whole, ew, hw, m)
    TyPoly(gs, inn) => pone_plain(e, ts, TyPoly(gs, inn), whole, ew, hw, m)
    TyApp(hd, inn) => pone_plain(e, ts, TyApp(hd, inn), whole, ew, hw, m)
  }
}

pub theorem pof_leaves(
  e: Ty,
  ts: List(Ty),
  ms: List(Ty),
  hc: ∀ x: Ty. (Mem(Ty, x, ms)) -> PLeaves(x, ts),
  m: Mem(Ty, e, ty_pmembers(ty_product_of(ms)))
): PLeaves(e, ts) {
  match ms {
    Nil => Mem::nil(PLeaves(e, ts), m)
    Cons(only, rest) => ⊢ PLeaves(e, ts) from match rest {
      Nil => pone_leaves(
        e,
        ts,
        only,
        only,
        Refl,
        hc(only, MemHere(<A: Ty, a: only>, Nil(<A: Ty>))),
        m
      )
      Cons(second, more) => hc(e, m)
    }
  }
}

// The members of `ty_product(ts)` are leaves of `ts`.
pub theorem product_mem(
  e: Ty,
  ts: List(Ty),
  m: Mem(Ty, e, ty_pmembers(ty_product(ts)))
): PLeaves(e, ts) {
  pof_leaves(
    e,
    ts,
    product_members_of(ts),
    x => mx => pm_leaves(x, ts, mx),
    m
  )
}
