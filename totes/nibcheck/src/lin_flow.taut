import "lin_state.taut"
import "../../surface/src/surface.taut"

// Control-flow linearity, frames, statements' spans and the paths of a walk
// (`event`, `merge` of `lin.rs`), in the proof language (`docs/design/self-host.md`「nibcheck の健全性（`totes/nibcheck/src/`）」).

// The indexes from `from`, `n` of them.
pub fn range_from(n: Nat, r#from: Nat): List(Nat) {
  match n: List(Nat) {
    Zero => Nil
    Succ(m) => Cons(r#from, range_from(m, r#from + 1))
  }
}

pub fn range_list(r#from: Nat, to: Nat): List(Nat) {
  range_from(Nat::sub(to, r#from), r#from)
}

pub fn trim_bars_in(n: Nat, t: Text): Text {
  match n: Text {
    Zero => t
    Succ(m) => if text_starts_with(
      t,
      "|",
      0
    ) { trim_bars_in(m, Text::slice_or_empty(t, 1, Text::len(t))) } else { t }
  }
}

pub fn trim_bars(t: Text): Text {
  trim_bars_in(Text::len(t), t)
}

// The quantities an effect of a row may have: a declared one's own, any for a
// row variable (`<=1` and below when it is bounded so), none for an effect
// that cannot be followed.
pub fn lin_row_var_quants(v: Text, bounded: List(Text), r#direct: List(Text)): List(Quant) {
  if list_has_text(r#direct, v) {
    Cons(QuantDirect, Nil)
  } else if list_has_text(bounded, v) {
    Cons(QuantZero, Cons(QuantAtMostOne, Cons(QuantOne, Nil)))
  } else {
    Cons(QuantZero, Cons(QuantAtMostOne, Cons(QuantOne, Cons(QuantMany, Nil))))
  }
}

pub fn lin_quants_of(c: Lin, eff: Text, bounded: List(Text), r#direct: List(Text)): List(Quant) {
  if text_starts_with(eff, "|", 0) {
    lin_row_var_quants(Text::slice_or_empty(eff, 1, Text::len(eff)), bounded, r#direct)
  } else if text_starts_with(eff, "?", 0) {
    Nil
  } else {
    match Ordmap::get(c.rows.quants, eff, Ordmap::compare_text): List(Quant) {
      Some(q) => Cons(q, Nil)
      None => Cons(QuantAtMostOne, Nil)
    }
  }
}

pub fn quants_any_many(qs: List(Quant)): Bool {
  match qs: Bool {
    Nil => false
    Cons(q, rest) => quant_is_many(q) || quants_any_many(rest)
  }
}

pub fn quant_is_one(q: Quant): Bool {
  match q: Bool {
    QuantOne => true
    _ => false
  }
}

pub fn quants_any_not_one(qs: List(Quant)): Bool {
  match qs: Bool {
    Nil => false
    Cons(q, rest) => (not(quant_is_one(q)) && not(quant_is_direct(q))) || quants_any_not_one(rest)
  }
}

pub fn handles_answering(hs: List(HandleCtx), eff: Text): Option(HandleCtx) {
  match hs: Option(HandleCtx) {
    Nil => None
    Cons(h, rest) => if Ordmap::contains(h.answers, eff, Ordmap::compare_text) {
      Some(h)
    } else {
      handles_answering(rest, eff)
    }
  }
}

pub fn indexes_below(xs: List(Nat), limit: Nat): List(Nat) {
  match xs: List(Nat) {
    Nil => Nil
    Cons(i, rest) => if i < limit { Cons(i, indexes_below(rest, limit)) } else {
      indexes_below(rest, limit)
    }
  }
}

// Whether a binding is duplicated when a continuation runs more than once.
pub fn binding_duplicated(b: Binding): Bool {
  if class_is_dup(b.r#class) {
    false
  } else {
    match b.mode: Bool {
      ModeOwned => true
      ModeVar => true
      ModeVarInClosure => true
      ModeBorrow(m) => m
      ModeBorrowClosure(names, m) => m
    }
  }
}

// What a linear binding live across `eff` can do instead, when `eff` is `Div`:
// a `budget` turns `Div` into `Exceeded` and drops the rest, and the host's
// step limit stops it.
pub fn may_not_resume_hint(eff: Text): Text {
  if eff == "Div" {
    "; finish the loop before the arm (in the body), give it fuel so it has no Div, or declare the operation resume <=1"
  } else {
    ""
  }
}

pub fn lin_event_one(
  &mut c: Lin,
  i: Nat,
  many: Bool,
  not_one: Bool,
  eff: Text,
  shown: Text,
  span: TySpan
): Unit {
  let b := lin_get(c, i)
  if not(state_is_moved(b.state)) {
    if many && binding_duplicated(b) {
      lin_error(&mut c, cat4(b.name, " is live across ", shown, ", which resumes \u{3c9}"), span)
    } else if not_one && class_is_linear(b.r#class) && mode_is_owned(b.mode) {
      lin_error(&mut c, cat5(b.name, " is live across ", shown, ", which may not resume", may_not_resume_hint(eff)), span)
    }
  }
}

pub fn lin_event_live(
  live: List(Nat),
  &mut c: Lin,
  many: Bool,
  not_one: Bool,
  eff: Text,
  shown: Text,
  span: TySpan
): Unit {
  match live: Unit {
    Nil => #()
    Cons(i, rest) => {
      lin_event_one(&mut c, i, many, not_one, eff, shown, span)
      lin_event_live(rest, &mut c, many, not_one, eff, shown, span)
    }
  }
}

pub fn handle_start(frame: Frame, eff: Text): Nat {
  match handles_answering(frame.handles, eff): Nat {
    Some(h) => h.start
    None => frame.base
  }
}

pub fn handle_extra(frame: Frame, eff: Text, r#from: Nat): List(Nat) {
  match handles_answering(frame.handles, eff): List(Nat) {
    Some(h) => indexes_below(h.return_uses, r#from)
    None => Nil
  }
}

pub fn lin_event_effect(&mut c: Lin, eff: Text, span: TySpan): Unit {
  let frame := lin_frame(c)
  let quants := lin_quants_of(c, eff, frame.bounded, frame.direct_bounded)
  let many := quants_any_many(quants)
  let not_one := quants_any_not_one(quants)
  if many || not_one {
    let r#from := handle_start(frame, eff)
    let live := List::append(handle_extra(frame, eff, r#from), range_list(r#from, c.count))
    lin_event_live(live, &mut c, many, not_one, eff, trim_bars(eff), span)
  }
}

pub fn lin_event_effects(effects: List(Text), &mut c: Lin, span: TySpan): Unit {
  match effects: Unit {
    Nil => #()
    Cons(eff, rest) => {
      lin_event_effect(&mut c, eff, span)
      lin_event_effects(rest, &mut c, span)
    }
  }
}

// `row` may be performed here: the bindings live across it must suit its
// quantities.
pub fn lin_event(&mut c: Lin, row: RowSet, span: TySpan): Unit {
  match c.frames: Unit {
    Nil => #()
    Cons(f, rest) => lin_event_effects(rowset_list(row), &mut c, span)
  }
}

pub fn lin_call_event(&mut c: Lin, t: SurfaceTerm): Unit {
  match Ordmap::get(c.rows.calls, RowSpan { start: t.start, end: t.end }, rows_compare_span): Unit {
    Some(row) => lin_event(&mut c, row, span_of(t))
    None => #()
  }
}

// ----- functions and blocks -----

pub fn bound_is_at_most_one(b: Option(Text)): Bool {
  match b: Bool {
    Some(x) => x == "<=1"
    None => false
  }
}

pub fn lin_bounded(gs: List(Text), bs: List(Option(Text))): List(Text) {
  match gs: List(Text) {
    Nil => Nil
    Cons(g, rest) => if bound_is_at_most_one(list_head_or_none(bs)) {
      Cons(g, lin_bounded(rest, List::tail(bs)))
    } else {
      lin_bounded(rest, List::tail(bs))
    }
  }
}

pub fn lin_push_params(ps: List(Text), &mut c: Lin, site: Nat): Unit {
  match ps: Unit {
    Nil => #()
    Cons(p, rest) => {
      lin_push_unit(&mut c, p, site, false)
      lin_push_params(rest, &mut c, site)
    }
  }
}

pub fn fn_returns_borrow(f: SurfaceFn): Bool {
  match f.result: Bool {
    Some(r) => match r.kind: Bool {
      SkBorrow(m, x) => true
      _ => false
    }
    None => false
  }
}

pub fn opt_span(e: Option(SurfaceTerm)): TySpan {
  match e: TySpan {
    Some(x) => span_of(x)
    None => TySpan { start: 0, end: 0 }
  }
}

pub fn stmt_span(s: SurfaceStmt): TySpan {
  match s: TySpan {
    StLet(n, ty, value, b, bm) => span_of(value)
    StVar(n, ty, value, vb) => span_of(value)
    StAssign(n, n_place, value) => span_of(value)
    StFn(f) => TySpan { start: f.start, end: f.end }
    StWhile(c, body) => span_of(body)
    StReturn(e) => opt_span(e)
    StExpr(e) => span_of(e)
    StStruct(d) => TySpan { start: d.start, end: d.end }
    StEnum(d) => TySpan { start: d.start, end: d.end }
    StExtern(n, fns, a, b) => TySpan { start: a, end: b }
    StOther(n, a, b) => TySpan { start: a, end: b }
    StMacro(m1, m2, a, b) => TySpan { start: a, end: b }
    StSyntax(m1, m2, a, b) => TySpan { start: a, end: b }
    _ => TySpan { start: 0, end: 0 }
  }
}

pub fn last_stmt_span(ss: List(SurfaceStmt)): TySpan {
  match ss: TySpan {
    Nil => TySpan { start: 0, end: 0 }
    Cons(s, rest) => match rest: TySpan {
      Nil => stmt_span(s)
      Cons(x, more) => last_stmt_span(rest)
    }
  }
}

pub fn lin_freeze_all(lent: List(Pair(Nat, Bool)), &mut c: Lin, r#by: Nat): Unit {
  match lent: Unit {
    Nil => #()
    Cons(l, rest) => {
      let b := lin_get(c, l.fst)
      lin_put(
        &mut c,
        l.fst,
        binding_with_frozen(b, List::append(b.frozen, Cons(Pair { fst: r#by, snd: l.snd }, Nil)))
      )
      lin_freeze_all(rest, &mut c, r#by)
    }
  }
}

pub fn frame_with(f: Frame, handles: List(HandleCtx), budgets: Nat, loops: Nat): Frame {
  Frame {
    base: f.base,
    handles: handles,
    budgets: budgets,
    loops: loops,
    bounded: f.bounded,
    direct_bounded: f.direct_bounded,
    returns_borrow: f.returns_borrow
  }
}

pub fn lin_frame_loops_add(&mut c: Lin): Unit {
  let f := lin_frame(c)
  lin_set_frame(&mut c, frame_with(f, f.handles, f.budgets, f.loops + 1))
}

pub fn lin_frame_loops_sub(&mut c: Lin): Unit {
  let f := lin_frame(c)
  lin_set_frame(&mut c, frame_with(f, f.handles, f.budgets, Nat::pred(f.loops)))
}

pub fn lin_frame_budgets_add(&mut c: Lin): Unit {
  let f := lin_frame(c)
  lin_set_frame(&mut c, frame_with(f, f.handles, f.budgets + 1, f.loops))
}

pub fn lin_frame_budgets_sub(&mut c: Lin): Unit {
  let f := lin_frame(c)
  lin_set_frame(&mut c, frame_with(f, f.handles, Nat::pred(f.budgets), f.loops))
}

pub fn lin_frame_handles(&mut c: Lin, handles: List(HandleCtx)): Unit {
  let f := lin_frame(c)
  lin_set_frame(&mut c, frame_with(f, handles, f.budgets, f.loops))
}

// `return`: the linear bindings of the function must be used by now.
pub fn lin_leave_function(&mut c: Lin, span: TySpan): Unit {
  lin_report_unused_below(c.count, &mut c, lin_frame(c).base, span)
  set_to(&mut c.dead, true)
}

// ----- paths -----

pub fn lin_states_below(n: Nat, c: Lin, acc: List(LinState)): List(LinState) {
  match n: List(LinState) {
    Zero => acc
    Succ(i) => lin_states_below(i, c, Cons(lin_get(c, i).state, acc))
  }
}

pub fn lin_snapshot(c: Lin): Option(List(LinState)) {
  if c.dead { None } else { Some(lin_states_below(c.count, c, Nil)) }
}

pub fn lin_restore_from(states: List(LinState), &mut c: Lin, i: Nat): Unit {
  match states: Unit {
    Nil => #()
    Cons(s, rest) => if i < c.count {
      lin_set_state(&mut c, i, s)
      lin_restore_from(rest, &mut c, i + 1)
    }
  }
}

pub fn lin_restore(&mut c: Lin, states: Option(List(LinState))): Unit {
  match states: Unit {
    None => set_to(&mut c.dead, true)
    Some(ss) => {
      set_to(&mut c.dead, false)
      lin_restore_from(ss, &mut c, 0)
    }
  }
}

pub fn live_paths(paths: List(Option(List(LinState)))): List(List(LinState)) {
  match paths: List(List(LinState)) {
    Nil => Nil
    Cons(p, rest) => match p: List(List(LinState)) {
      Some(ss) => Cons(ss, live_paths(rest))
      None => live_paths(rest)
    }
  }
}

pub fn state_at(ss: List(LinState), i: Nat): LinState {
  match nth_item(ss, i): LinState {
    Some(s) => s
    None => BsOwned
  }
}

pub fn states_at(paths: List(List(LinState)), i: Nat): List(LinState) {
  match paths: List(LinState) {
    Nil => Nil
    Cons(p, rest) => Cons(state_at(p, i), states_at(rest, i))
  }
}

pub fn all_state(ss: List(LinState), s: LinState): Bool {
  match ss: Bool {
    Nil => true
    Cons(x, rest) => state_eq(x, s) && all_state(rest, s)
  }
}

pub fn lin_merged_state(&mut c: Lin, states: List(LinState), b: Binding, span: TySpan): LinState {
  if all_state(states, BsOwned) {
    BsOwned
  } else if all_state(states, BsMoved) {
    BsMoved
  } else if class_is_linear(b.r#class) && mode_is_owned(b.mode) {
    lin_error(&mut c, cat2(b.name, " is used on some paths only"), span)
    BsMoved
  } else {
    BsMaybe
  }
}

// The bindings from `i` on, `r` of them, take the state their paths join in.
pub fn lin_merge_from(r: Nat, &mut c: Lin, live: List(List(LinState)), i: Nat, span: TySpan): Unit {
  match r: Unit {
    Zero => #()
    Succ(r2) => {
      let state := lin_merged_state(&mut c, states_at(live, i), lin_get(c, i), span)
      lin_set_state(&mut c, i, state)
      lin_merge_from(r2, &mut c, live, i + 1, span)
    }
  }
}

// The state after paths join: a binding moved on some paths only is `Maybe`,
// which a linear one may not be.
pub fn lin_merge(&mut c: Lin, paths: List(Option(List(LinState))), span: TySpan): Unit {
  match live_paths(paths): Unit {
    Nil => set_to(&mut c.dead, true)
    Cons(first, rest) => {
      set_to(&mut c.dead, false)
      lin_merge_from(Nat::min(list_len(first), c.count), &mut c, Cons(first, rest), 0, span)
    }
  }
}
