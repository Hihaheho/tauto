pub theorem leaf_ck_clone_bad_frame_tracked(
  c: Checker,
  span: TySpan
): TrackedFrame(c, leaf_ck_clone_bad(c, span)) {
  tracked_bind(
    Unit,
    Ty,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, "`clone` takes one borrow, `clone(&x)`", span),
    ck_error_frame_tracked(c, "`clone` takes one borrow, `clone(&x)`", span),
    ignored => c1 => tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1))
  )
}

