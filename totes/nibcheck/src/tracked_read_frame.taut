pub theorem signature_pred_missing_frame_tracked(
  c: Checker,
  w: SurfaceConstraint,
  gs: List(Text × Kind),
  name: Text,
  preds: List(Text × Text),
  missing: Bool
): TrackedFrame(c, signature_pred_missing(c, w, gs, name, preds, missing)) {
