    Eq::sym(binding_let_borrow_unf(c, name, view, bm, resolved, value)),
    binding_let_view_frame_tracked(c, name, bm, resolved, value, view)
  )
}

pub theorem leaf_ck_stored_borrow_frame_tracked(
