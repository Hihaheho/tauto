): TrackedFrame(c, ck_where_pred(c, w, gs, name, preds)) {
  Eq::subst(
    (z: Mut1(List(Pair(Text, Text)), Checker)) => TrackedFrame(c, z),
    Eq::sym(signature_pred_unf(c, w, gs, name, preds)),
    signature_pred_missing_frame_tracked(c, w, gs, name, preds, signature_class_missing(c, w))
  )
}

pub theorem signature_preds_cons_frame_tracked(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Pair(Text, Kind)),
  name: Text,
  preds: List(Pair(Text, Text)),
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). TrackedFrame(next, ck_where_preds(rest, next, gs, name, ps))
): TrackedFrame(c, signature_preds_cons(w, rest, c, gs, name, preds)) {
  tracked_bind(
    List(Pair(Text, Text)),
    List(Pair(Text, Text)),
    c,
    (head: List(Pair(Text, Text)), c1: Checker) => ck_rewrap1(
      ck_where_preds(rest, c1, gs, name, head)
    ),
    ck_where_pred(c, w, gs, name, preds),
    ck_where_pred_frame_tracked(c, w, gs, name, preds),
    head => c1 => tracked_rewrap(c1, ck_where_preds(rest, c1, gs, name, head), ih(c1, head))
  )
}

pub theorem ck_where_preds_frame_tracked(
  ws: List(SurfaceConstraint),
  c: Checker,
  gs: List(Pair(Text, Kind)),
  name: Text,
  preds: List(Pair(Text, Text))
): TrackedFrame(c, ck_where_preds(ws, c, gs, name, preds)) {
  match ws: TrackedFrame(c, ck_where_preds(ws, c, gs, name, preds)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(w, rest) => Eq::subst(
      (z: Mut1(List(Pair(Text, Text)), Checker)) => TrackedFrame(c, z),
      Eq::sym(signature_preds_unf(w, rest, c, gs, name, preds)),
      signature_preds_cons_frame_tracked(
        w,
        rest,
        c,
        gs,
        name,
        preds,
        next => ps => ck_where_preds_frame_tracked(rest, next, gs, name, ps)
      )
    )
  }
}

pub theorem signature_read_frame_tracked(
  c: Checker,
  f: SurfaceFn,
  g: SigGenerics
): TrackedFrame(c, signature_read(c, f, g)) {
  tracked_bind(
    List(Ty),
    Scheme,
    c,
    (params: List(Ty), c1: Checker) => frame_bind(
      Ty,
      Scheme,
      (result: Ty, c2: Checker) => frame_bind(
        Unit,
        Scheme,
        (ignored: Unit, c3: Checker) => frame_bind(
          List(Pair(Text, Text)),
          Scheme,
          (preds: List(Pair(Text, Text)), c4: Checker) => mut1(
            signature_scheme(g, params, result, preds),
            c4
          ),
          ck_where_preds(signature_wheres(f), c3, signature_gens(g), signature_name(f), Nil)
        ),
        ck_report(c2, ck_view_result_message(c2, params, result), ck_sig_span(f))
      ),
      ck_sig_result(c1, f, signature_map(g))
    ),
    ck_sig_params(signature_ptypes(f), c, signature_borrows(f), signature_map(g)),
    ck_sig_params_frame_tracked(signature_ptypes(f), c, signature_borrows(f), signature_map(g)),
    params => c1 => tracked_bind(
      Ty,
      Scheme,
      c1,
      (result: Ty, c2: Checker) => frame_bind(
        Unit,
        Scheme,
        (ignored: Unit, c3: Checker) => frame_bind(
          List(Pair(Text, Text)),
          Scheme,
          (preds: List(Pair(Text, Text)), c4: Checker) => mut1(
            signature_scheme(g, params, result, preds),
            c4
          ),
          ck_where_preds(signature_wheres(f), c3, signature_gens(g), signature_name(f), Nil)
        ),
        ck_report(c2, ck_view_result_message(c2, params, result), ck_sig_span(f))
      ),
      ck_sig_result(c1, f, signature_map(g)),
      ck_sig_result_frame_tracked(c1, f, signature_map(g)),
      result => c2 => tracked_bind(
        Unit,
        Scheme,
        c2,
        (ignored: Unit, c3: Checker) => frame_bind(
          List(Pair(Text, Text)),
          Scheme,
          (preds: List(Pair(Text, Text)), c4: Checker) => mut1(
            signature_scheme(g, params, result, preds),
            c4
          ),
          ck_where_preds(signature_wheres(f), c3, signature_gens(g), signature_name(f), Nil)
        ),
        ck_report(c2, ck_view_result_message(c2, params, result), ck_sig_span(f)),
        ck_report_frame_tracked(c2, ck_view_result_message(c2, params, result), ck_sig_span(f)),
        ignored => c3 => tracked_bind(
          List(Pair(Text, Text)),
          Scheme,
          c3,
          (preds: List(Pair(Text, Text)), c4: Checker) => mut1(
            signature_scheme(g, params, result, preds),
            c4
          ),
          ck_where_preds(signature_wheres(f), c3, signature_gens(g), signature_name(f), Nil),
          ck_where_preds_frame_tracked(
            signature_wheres(f),
            c3,
            signature_gens(g),
            signature_name(f),
            Nil
          ),
          preds => c4 => AndIntro(
            item => member => member,
            AndIntro(Refl, obligation_state_refl(c4))
          )
        )
      )
    )
  )
}

pub theorem ck_signature_frame_tracked(
  c: Checker,
  f: SurfaceFn
): TrackedFrame(c, ck_signature(c, f)) {
  Eq::subst(
    (z: Mut1(Scheme, Checker)) => TrackedFrame(c, z),
    Eq::sym(signature_read_unf(c, f)),
    signature_read_frame_tracked(c, f, signature_generics(f))
  )
}

pub theorem ck_effect_param_frame_tracked(
  c: Checker,
  e: SurfaceEffect,
  p: Option(SurfaceTerm),
  generics: Ordmap(Text, Ty)
): TrackedFrame(c, ck_effect_param(c, e, p, generics)) {
