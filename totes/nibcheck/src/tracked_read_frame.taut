pub theorem ck_clone_target_frame_tracked(
  c: Checker,
  t: Ty,
  arg: SurfaceTerm
): TrackedFrame(c, ck_clone_target(c, t, arg)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_clone_target_unf(c, t, arg)),
    leaf_clone_target_frame_tracked(c, ck_resolve(c, t), arg, ck_resolve(c, t))
  )
}

pub theorem leaf_clone_why_frame_tracked(
  c: Checker,
  span: TySpan,
  why: Option(Text)
): TrackedFrame(c, leaf_clone_why(c, span, why)) {
  match why: TrackedFrame(c, leaf_clone_why(c, span, why)) {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(message) => tracked_rewrap(
      c,
      ck_error(c, message, span),
      ck_error_frame_tracked(c, message, span)
    )
  }
}

pub theorem leaf_clone_frame_tracked(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): TrackedFrame(c, leaf_clone(c, t0, arg, span)) {
  tracked_bind(
    Ty,
    Ty,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t))
    ),
    ck_clone_target(c, t0, arg),
    ck_clone_target_frame_tracked(c, t0, arg),
    t => c1 => tracked_bind(
      Unit,
      Ty,
      c1,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      leaf_clone_why_frame_tracked(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      ignored => c2 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c2))
      )
    )
  )
}

pub theorem ck_clone_value_frame_tracked(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): TrackedFrame(c, ck_clone_value(c, t0, arg, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_clone_unf(c, t0, arg, span)),
    leaf_clone_frame_tracked(c, t0, arg, span)
  )
}
pub theorem argument_lambda_cons_frame_tracked(
  p: Text,
  rest: List(Text),
  c: Checker,
  borrows: List(Option(Bool)),
  ih: ∀ next: Checker. TrackedFrame(next, ck_lambda_params(rest, next, List::tail(borrows)))
): TrackedFrame(c, argument_lambda_cons(p, rest, c, borrows)) {
  tracked_bind(
    Ty,
    List(Ty),
    c,
    (t: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tl: List(Ty), c2: Checker) => mut1(Cons(field_under(t, list_head_or_none(borrows)), tl), c2),
      ck_lambda_params(rest, c1, List::tail(borrows))
    ),
    ck_fresh(c),
    ck_fresh_frame_tracked(c),
    t => c1 => tracked_bind(
      List(Ty),
      List(Ty),
      c1,
      (tl: List(Ty), c2: Checker) => mut1(Cons(field_under(t, list_head_or_none(borrows)), tl), c2),
      ck_lambda_params(rest, c1, List::tail(borrows)),
      ih(c1),
      tl => c2 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c2)))
    )
  )
}

pub theorem ck_lambda_params_frame_tracked(
  ps: List(Text),
  c: Checker,
  borrows: List(Option(Bool))
): TrackedFrame(c, ck_lambda_params(ps, c, borrows)) {
  match ps: TrackedFrame(c, ck_lambda_params(ps, c, borrows)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(p, rest) => Eq::subst(
      (z: Mut1(List(Ty), Checker)) => TrackedFrame(c, z),
      Eq::sym(argument_lambda_cons_unf(p, rest, c, borrows)),
      argument_lambda_cons_frame_tracked(
        p,
        rest,
        c,
        borrows,
        next => ck_lambda_params_frame_tracked(rest, next, List::tail(borrows))
      )
    )
  }
}

pub theorem inference_record_closure_frame_tracked(
  c: Checker,
  t: Ty,
  body: SurfaceTerm
): TrackedFrame(
  c,
  inference_record_closure(c, t, body)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }
pub theorem record_missing_name_frame_tracked(
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan,
  fieldname: Option(Text)
): TrackedFrame(c, record_missing_name(c, name, seen, span, fieldname)) {
  match fieldname: TrackedFrame(c, record_missing_name(c, name, seen, span, fieldname)) {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(n) => frame_error_if_ok_tracked(
      c,
      cat4("field `", n, "` of ", cat2(name, " is missing")),
      span,
      not(list_has_text(seen, n))
    )
  }
}

pub theorem ck_record_missing_one_frame_tracked(
  c: Checker,
  name: Text,
  f: DataField,
  seen: List(Text),
  span: TySpan
): TrackedFrame(c, ck_record_missing_one(c, name, f, seen, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(record_missing_one_unf(c, name, f, seen, span)),
    record_missing_name_frame_tracked(c, name, seen, span, record_data_name(f))
  )
}

pub theorem record_missing_cons_frame_tracked(
  f: DataField,
  rest: List(DataField),
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan,
  ih: ∀ next: Checker. TrackedFrame(next, ck_record_missing(rest, next, name, seen, span))
): TrackedFrame(c, record_missing_cons(f, rest, c, name, seen, span)) {
  tracked_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_record_missing(rest, c1, name, seen, span)),
    ck_record_missing_one(c, name, f, seen, span),
    ck_record_missing_one_frame_tracked(c, name, f, seen, span),
    ignored => c1 => tracked_rewrap(c1, ck_record_missing(rest, c1, name, seen, span), ih(c1))
  )
}

pub theorem ck_record_missing_frame_tracked(
  fs: List(DataField),
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan
): TrackedFrame(c, ck_record_missing(fs, c, name, seen, span)) {
  match fs: TrackedFrame(c, ck_record_missing(fs, c, name, seen, span)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(f, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_missing_cons_unf(f, rest, c, name, seen, span)),
      record_missing_cons_frame_tracked(
        f,
        rest,
        c,
        name,
        seen,
        span,
        next => ck_record_missing_frame_tracked(rest, next, name, seen, span)
      )
    )
  }
}
pub theorem leaf_ck_check_covers_frame_tracked(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): TrackedFrame(c, leaf_ck_check_covers(c, s, arms, span)) {
  frame_error_if_ok_tracked(
    c,
    "the `match` does not cover every value",
    span,
    not(covers(ck_datas_of(c), ck_resolve(c, s), open_patterns(arms)))
  )
}

