pub theorem registration_quant_resume_frame_tracked(
  c: Checker,
  e: SurfaceEffect,
  r#resume: Option(Text)
): TrackedFrame(c, registration_quant_resume(c, e, r#resume)) {
  match r#resume {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(q) => registration_quant_parsed_frame_tracked(c, e, q, quant_parse(q))
  }
}
pub theorem ck_effect_quant_frame_tracked(
  c: Checker,
  e: SurfaceEffect
): TrackedFrame(c, ck_effect_quant(c, e)) {
  Eq::subst(
    (z: Mut1(Quant, Checker)) => TrackedFrame(c, z),
    Eq::sym(registration_quant_unf(c, e)),
    registration_quant_resume_frame_tracked(c, e, registration_effect_resume(e))
  )
}

pub theorem registration_effect_store_frame_tracked(
  c: Checker,
  e: SurfaceEffect,
  params: List(Ty),
  result: Ty,
  quant: Quant
): TrackedFrame(
  c,
  registration_effect_store(c, e, params, result, quant)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }

pub theorem registration_effect_declare_frame_tracked(
  c: Checker,
  e: SurfaceEffect
): TrackedFrame(c, registration_effect_declare(c, e)) {
  tracked_bind(
    <A: List(Ty), B: Unit>,
    c,
    (params: List(Ty), c1: Checker) => frame_bind(
      <A: Ty, B: Unit>,
      (result: Ty, c2: Checker) => frame_bind(
        <A: Quant, B: Unit>,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e)
      ),
      ck_effect_result(c1, e, ck_named_generics(registration_effect_generics(e), Ordmap::empty()))
    ),
    ck_effect_params(
      registration_effect_params(e),
      c,
      e,
      ck_named_generics(registration_effect_generics(e), Ordmap::empty())
    ),
    ck_effect_params_frame_tracked(
      registration_effect_params(e),
      c,
      e,
      ck_named_generics(registration_effect_generics(e), Ordmap::empty())
    ),
    params => c1 => tracked_bind(
      <A: Ty, B: Unit>,
      c1,
      (result: Ty, c2: Checker) => frame_bind(
        <A: Quant, B: Unit>,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e)
      ),
      ck_effect_result(c1, e, ck_named_generics(registration_effect_generics(e), Ordmap::empty())),
      ck_effect_result_frame_tracked(
        c1,
        e,
        ck_named_generics(registration_effect_generics(e), Ordmap::empty())
      ),
      result => c2 => tracked_bind(
        <A: Quant, B: Unit>,
        c2,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e),
        ck_effect_quant_frame_tracked(c2, e),
        quant => c3 => registration_effect_store_frame_tracked(c3, e, params, result, quant)
      )
    )
  )
}

pub theorem ck_declare_effect_frame_tracked(
  c: Checker,
  e: SurfaceEffect
): TrackedFrame(c, ck_declare_effect(c, e)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(registration_effect_declare_unf(c, e)),
    registration_effect_declare_frame_tracked(c, e)
  )
}

pub theorem ck_top_level_only_frame_tracked(
  c: Checker,
  message: Text,
  start: Nat,
  end: Nat
): TrackedFrame(
  c,
  ck_top_level_only(c, message, start, end)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }

pub theorem record_stmt_label_frame_tracked(
  c: Checker,
  what: Text,
  start: Nat,
  end: Nat,
  label: Bool
): TrackedFrame(c, record_stmt_label(c, what, start, end, label)) {
  match label {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => tracked_rewrap(
      c,
      ck_top_level_only(c, not_supported_yet_message(what), start, end),
      ck_top_level_only_frame_tracked(c, not_supported_yet_message(what), start, end)
    )
  }
}

pub theorem ck_stmt_other_frame_tracked(
  c: Checker,
  s: SurfaceStmt
): TrackedFrame(c, ck_stmt_other(c, s)) {
  match s {
    StLet(pat_name, pat_ty, pat_value, pat_borrow, pat_mutable, unused, st_stack) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StVar(pat_name, pat_ty, pat_value, pat_borrow, unused, st_stack) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StAssign(pat_name, pat_name_place, pat_value) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StCalled(pat_name_generates, pat_value) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StFn(pat_f) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StTheorem(pat_t) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StDef(pat_t) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StMutual(pat_stmts, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StImport(pat_path, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StInductive(pat_i) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StEffect(pat_e) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StStruct(pat_d) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StEnum(pat_d) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StExtern(pat_fns, pat_instances, pat_types, pat_structs, pat_enums, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StClass(pat_c) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StInstance(pat_i) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StWhile(pat_cond, pat_body) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StReturn(pat_value) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StExpr(pat_value) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StOther(what, start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, what, start, end)),
      record_stmt_label_frame_tracked(c, what, start, end, Text::eq(what, "LabelDecl"))
    )
    StLoop(st_body, start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, "LoopExpr", start, end)),
      record_stmt_label_frame_tracked(c, "LoopExpr", start, end, Text::eq("LoopExpr", "LabelDecl"))
    )
    StModule(mod_name, mod_vis, mod_items, start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, "ModuleDecl", start, end)),
      record_stmt_label_frame_tracked(c, "ModuleDecl", start, end, Text::eq("ModuleDecl", "LabelDecl"))
    )
    StReexport(re_path, re_names, re_spans, start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, "ReexportDecl", start, end)),
      record_stmt_label_frame_tracked(c, "ReexportDecl", start, end, Text::eq("ReexportDecl", "LabelDecl"))
    )
    StFor(for_pat, for_src, st_body, start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, "ForStmt", start, end)),
      record_stmt_label_frame_tracked(c, "ForStmt", start, end, Text::eq("ForStmt", "LabelDecl"))
    )
    StBreak(st_value, start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, "BreakStmt", start, end)),
      record_stmt_label_frame_tracked(c, "BreakStmt", start, end, Text::eq("BreakStmt", "LabelDecl"))
    )
    StContinue(start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, "ContinueStmt", start, end)),
      record_stmt_label_frame_tracked(c, "ContinueStmt", start, end, Text::eq("ContinueStmt", "LabelDecl"))
    )
    StMacro(pat_name, pat_function, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StSyntax(pat_name, pat_grammar, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
  }
}

pub theorem field_through_with_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  read: CoerceRead,
  refused: Option(Text)
): TrackedFrame(c, field_through_with(c, term, read, refused)) {
  match refused {
    Some(m) => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, m, span_of(term)),
      ck_error_frame_tracked(c, m, span_of(term)),
      ignored => c1 => tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1))
    )
    None => tracked_rewrap(
      c,
      ck_field_of(c, term, coerce_read_base(read), coerce_read_field(read)),
      ck_field_of_frame_tracked(c, term, coerce_read_base(read), coerce_read_field(read))
    )
  }
}

pub theorem ck_field_through_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  place: Text,
  b: Ty,
  name: Text
): TrackedFrame(c, ck_field_through(c, term, place, b, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(field_through_unf(c, term, place, b, name)),
    field_through_with_frame_tracked(
      c,
      term,
      ck_coerce_read(c, place, b, name),
      coerce_read_refused(ck_coerce_read(c, place, b, name))
    )
  )
}
