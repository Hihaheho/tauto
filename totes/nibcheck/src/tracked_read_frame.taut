    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(g) => signature_pred_duplicate_frame_tracked(
      c,
      w,
      preds,
      g,
      preds_have(preds, signature_constraint_class(w), g)
    )
  }
