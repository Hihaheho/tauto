    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(x) => tracked_rewrap(
      c,
      ck_written(c, x, generics),
      ck_written_frame_tracked(c, x, generics)
    )
  }
}

pub theorem registration_effect_params_cons_ok_tracked(
  p: Option(SurfaceTerm),
  rest: List(Option(SurfaceTerm)),
  c: Checker,
  e: SurfaceEffect,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. TrackedFrame(next, ck_effect_params(rest, next, e, generics))
): TrackedFrame(c, registration_effect_params_cons(p, rest, c, e, generics)) {
  tracked_bind(
    Ty,
    List(Ty),
    c,
    (head: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_effect_params(rest, c1, e, generics)
    ),
    ck_effect_param(c, e, p, generics),
    ck_effect_param_frame_tracked(c, e, p, generics),
    head => c1 => tracked_bind(
      List(Ty),
      List(Ty),
      c1,
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_effect_params(rest, c1, e, generics),
      ih(c1),
      tail => c2 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c2))
      )
    )
  )
}

pub theorem ck_effect_params_frame_tracked(
  ps: List(Option(SurfaceTerm)),
  c: Checker,
  e: SurfaceEffect,
  generics: Ordmap(Text, Ty)
): TrackedFrame(c, ck_effect_params(ps, c, e, generics)) {
  match ps: TrackedFrame(c, ck_effect_params(ps, c, e, generics)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(p, rest) => Eq::subst(
      (z: Mut1(List(Ty), Checker)) => TrackedFrame(c, z),
      Eq::sym(registration_effect_params_unf(p, rest, c, e, generics)),
      registration_effect_params_cons_ok_tracked(
        p,
        rest,
        c,
        e,
        generics,
        next => ck_effect_params_frame_tracked(rest, next, e, generics)
      )
    )
  }
}

pub theorem registration_effect_result_frame_tracked(
  c: Checker,
  generics: Ordmap(Text, Ty),
  o: Option(SurfaceTerm)
): TrackedFrame(c, registration_effect_result_k(c, generics, o)) {
  match o: TrackedFrame(c, registration_effect_result_k(c, generics, o)) {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(r) => tracked_rewrap(
      c,
      ck_written(c, r, generics),
      ck_written_frame_tracked(c, r, generics)
    )
  }
}
pub theorem ck_effect_result_frame_tracked(
  c: Checker,
  e: SurfaceEffect,
  generics: Ordmap(Text, Ty)
): TrackedFrame(c, ck_effect_result(c, e, generics)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(registration_effect_result_unf(c, e, generics)),
    registration_effect_result_frame_tracked(c, generics, registration_effect_result(e))
  )
}

pub theorem registration_quant_parsed_frame_tracked(
  c: Checker,
  e: SurfaceEffect,
  q: Text,
  o: Option(Quant)
): TrackedFrame(c, registration_quant_parsed(c, e, q, o)) {
  match o: TrackedFrame(c, registration_quant_parsed(c, e, q, o)) {
    Some(x) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  }
}
pub theorem registration_quant_resume_frame_tracked(
  c: Checker,
  e: SurfaceEffect,
  r#resume: Option(Text)
): TrackedFrame(c, registration_quant_resume(c, e, r#resume)) {
  match r#resume: TrackedFrame(c, registration_quant_resume(c, e, r#resume)) {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(q) => registration_quant_parsed_frame_tracked(c, e, q, quant_parse(q))
  }
}
pub theorem ck_effect_quant_frame_tracked(
  c: Checker,
  e: SurfaceEffect
): TrackedFrame(c, ck_effect_quant(c, e)) {
  Eq::subst(
    (z: Mut1(Quant, Checker)) => TrackedFrame(c, z),
    Eq::sym(registration_quant_unf(c, e)),
    registration_quant_resume_frame_tracked(c, e, registration_effect_resume(e))
  )
}

pub theorem registration_effect_store_frame_tracked(
  c: Checker,
  e: SurfaceEffect,
  params: List(Ty),
  result: Ty,
  quant: Quant
): TrackedFrame(
  c,
  registration_effect_store(c, e, params, result, quant)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }

pub theorem registration_effect_declare_frame_tracked(
  c: Checker,
  e: SurfaceEffect
): TrackedFrame(c, registration_effect_declare(c, e)) {
  tracked_bind(
    List(Ty),
    Unit,
    c,
    (params: List(Ty), c1: Checker) => frame_bind(
      Ty,
      Unit,
      (result: Ty, c2: Checker) => frame_bind(
        Quant,
        Unit,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e)
      ),
      ck_effect_result(c1, e, ck_named_generics(registration_effect_generics(e), Ordmap::empty()))
    ),
    ck_effect_params(
      registration_effect_params(e),
      c,
      e,
      ck_named_generics(registration_effect_generics(e), Ordmap::empty())
    ),
    ck_effect_params_frame_tracked(
      registration_effect_params(e),
      c,
      e,
      ck_named_generics(registration_effect_generics(e), Ordmap::empty())
    ),
    params => c1 => tracked_bind(
      Ty,
      Unit,
      c1,
      (result: Ty, c2: Checker) => frame_bind(
        Quant,
        Unit,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e)
      ),
      ck_effect_result(c1, e, ck_named_generics(registration_effect_generics(e), Ordmap::empty())),
      ck_effect_result_frame_tracked(
        c1,
        e,
        ck_named_generics(registration_effect_generics(e), Ordmap::empty())
      ),
      result => c2 => tracked_bind(
        Quant,
        Unit,
        c2,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e),
        ck_effect_quant_frame_tracked(c2, e),
        quant => c3 => registration_effect_store_frame_tracked(c3, e, params, result, quant)
      )
    )
  )
}

pub theorem ck_declare_effect_frame_tracked(
  c: Checker,
  e: SurfaceEffect
): TrackedFrame(c, ck_declare_effect(c, e)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(registration_effect_declare_unf(c, e)),
    registration_effect_declare_frame_tracked(c, e)
  )
}

pub theorem ck_top_level_only_frame_tracked(
  c: Checker,
  message: Text,
  start: Nat,
  end: Nat
): TrackedFrame(
  c,
  ck_top_level_only(c, message, start, end)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }

pub theorem record_stmt_label_frame_tracked(
  c: Checker,
  what: Text,
  start: Nat,
  end: Nat,
  label: Bool
): TrackedFrame(c, record_stmt_label(c, what, start, end, label)) {
  match label: TrackedFrame(c, record_stmt_label(c, what, start, end, label)) {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => tracked_rewrap(
      c,
      ck_top_level_only(c, cat2("not supported yet: ", what), start, end),
      ck_top_level_only_frame_tracked(c, cat2("not supported yet: ", what), start, end)
    )
  }
}

pub theorem ck_stmt_other_frame_tracked(
  c: Checker,
  s: SurfaceStmt
): TrackedFrame(c, ck_stmt_other(c, s)) {
  match s: TrackedFrame(c, ck_stmt_other(c, s)) {
    StLet(pat_name, pat_ty, pat_value, pat_borrow, pat_mutable) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StVar(pat_name, pat_ty, pat_value, pat_borrow) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StModule(pat_name, pat_stmts, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StAssign(pat_name, pat_name_place, pat_value) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StCalled(pat_name_generates, pat_value) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StFn(pat_f) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StTheorem(pat_t) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StDef(pat_t) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    StMutual(pat_stmts, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StImport(pat_path, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StInductive(pat_i) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StEffect(pat_e) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StStruct(pat_d) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StEnum(pat_d) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StExtern(pat_abi, pat_fns, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StClass(pat_c) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StInstance(pat_i) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StWhile(pat_cond, pat_body) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StReturn(pat_value) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StExpr(pat_value) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StOther(what, start, end) => Eq::subst(
      (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_stmt_label_unf(c, what, start, end)),
      record_stmt_label_frame_tracked(c, what, start, end, Text::eq(what, "LabelDecl"))
    )
    StMacro(pat_name, pat_function, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    StSyntax(pat_name, pat_grammar, pat_start, pat_end) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
  }
}
