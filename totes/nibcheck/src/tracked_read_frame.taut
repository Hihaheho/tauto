pub theorem binding_stored_borrow_frame_tracked(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  p: Ty,
  borrow: Bool
): TrackedFrame(c, binding_stored_borrow(c, name, t, resolved, value, p, borrow)) {
  match borrow: TrackedFrame(c, binding_stored_borrow(c, name, t, resolved, value, p, borrow)) {
    true => tracked_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(t, c1),
      ck_stored_borrow(c, name, resolved, value),
      ck_stored_borrow_frame_tracked(c, name, resolved, value),
      ignored => c1 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c1))
      )
    )
    false => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  }
}

pub theorem binding_stored_found_frame_tracked(
  c: Checker,
  name: Text,
  t: Ty,
  resolved: Ty,
  value: SurfaceTerm,
  found: Option(Ty)
): TrackedFrame(c, binding_stored_found(c, name, t, resolved, value, found)) {
  match found: TrackedFrame(c, binding_stored_found(c, name, t, resolved, value, found)) {
    None => tracked_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(t, c1),
      ck_stored_borrow(c, name, resolved, value),
      ck_stored_borrow_frame_tracked(c, name, resolved, value),
      ignored => c1 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c1))
      )
    )
    Some(p) => binding_stored_borrow_frame_tracked(
      c,
      name,
      t,
      resolved,
      value,
      p,
      term_is_borrow(value)
    )
  }
}

pub theorem binding_stored_frame_tracked(
