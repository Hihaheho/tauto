  constructor: Bool
): TrackedFrame(c, frame_arity_k(c, n, given, span, constructor)) {
  match constructor: TrackedFrame(c, frame_arity_k(c, n, given, span, constructor)) {
    true => frame_arity_decl_ok_tracked(c, n, given, span, datas_decl(ck_datas_of(c), n))
    false => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  }
}

pub theorem ck_arity_frame_tracked(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan
): TrackedFrame(c, ck_arity(c, n, given, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(frame_arity_unf(c, n, given, span)),
    frame_arity_k_ok_tracked(c, n, given, span, not(frame_constructor_position(c)))
  )
}

pub theorem frame_written_var_named_ok_tracked(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty,
  found: Bool
): TrackedFrame(c, frame_written_var_named(c, n, span, t, found)) {
  match found: TrackedFrame(c, frame_written_var_named(c, n, span, t, found)) {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => tracked_return(c, t, ck_arity(c, n, 0, span), ck_arity_frame_tracked(c, n, 0, span))
  }
}

pub theorem frame_written_var_k_ok_tracked(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  original: Ty,
  t: Ty
): TrackedFrame(c, frame_written_var_k(c, n, generics, span, original, t)) {
  match t: TrackedFrame(c, frame_written_var_k(c, n, generics, span, original, t)) {
    TyNamed(name, args) => frame_written_var_named_ok_tracked(
      c,
      n,
      span,
      original,
      Ordmap::contains(generics, n, Ordmap::compare_text)
    )
    TyInt(width) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyBool => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyText => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyUnit => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyNever => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyDecimal => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyFloat => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyFn(params, result, kind) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyUnion(members) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyProduct(members) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyTagged(tags, inner) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyParam(name, bound) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyInfo(inner) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyBorrow(inner, mutable) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyVar(index) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyPoly(generics0, inner) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyApp(head, arg) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
  }
}

pub theorem ck_written_var_frame_tracked(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan
): TrackedFrame(c, ck_written_var(c, n, generics, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(frame_written_var_unf(c, n, generics, span)),
    frame_written_var_k_ok_tracked(
      c,
      n,
      generics,
      span,
      ck_written_name(n, generics),
      ck_written_name(n, generics)
    )
  )
}

pub theorem frame_app_nested_ok_tracked(
  c: Checker,
  span: TySpan,
  after: List(Ty),
  inner: Ty
): TrackedFrame(c, frame_app_nested(c, span, after, inner)) {
  match inner: TrackedFrame(c, frame_app_nested(c, span, after, inner)) {
    TyNamed(n, before) => tracked_return(
      c,
      TyNamed(n, List::append(before, after)),
      ck_arity(c, n, list_len(List::append(before, after)), span),
      ck_arity_frame_tracked(c, n, list_len(List::append(before, after)), span)
    )
    TyInt(width) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyBool => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyText => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyUnit => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyNever => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyDecimal => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyFloat => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyFn(params, result, kind) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyUnion(members) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyProduct(members) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyTagged(tags, _) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyParam(name, bound) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyInfo(_) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyBorrow(_, mutable) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyVar(index) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyPoly(generics0, _) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyApp(head, arg) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
  }
}

