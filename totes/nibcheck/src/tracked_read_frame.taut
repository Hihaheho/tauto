}

pub theorem frame_arity_decl_ok_tracked(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan,
  o: Option(Data)
): TrackedFrame(c, frame_arity_decl(c, n, given, span, o)) {
  match o: TrackedFrame(c, frame_arity_decl(c, n, given, span, o)) {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(data) => frame_arity_small_ok_tracked(
      c,
      n,
      span,
      data,
      not(Nat::eq(given, list_len(dgen(data))))
    )
