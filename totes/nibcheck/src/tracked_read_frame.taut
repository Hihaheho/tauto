): TrackedFrame(c, frame_app_generic(c, n, generics, span, args)) {
  match args: TrackedFrame(c, frame_app_generic(c, n, generics, span, args)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(x, more) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
  }
}

pub theorem ck_written_ctor_arity_frame_tracked(
  c: Checker,
  n: Text,
  span: TySpan
): TrackedFrame(
  c,
  ck_written_ctor_arity(c, n, span)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }

pub theorem frame_app_generic_count_ok_tracked(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  n: Text,
  one: Bool,
  iheach: ∀ next: Checker. TrackedFrame(next, ck_written_each(arguments, next, generics))
): TrackedFrame(c, frame_app_generic_count(c, arguments, generics, span, n, one)) {
  match one: TrackedFrame(c, frame_app_generic_count(c, arguments, generics, span, n, one)) {
    true => tracked_bind(
      List(Ty),
      Ty,
      c,
      (ws: List(Ty), c1: Checker) => frame_app_generic(c1, n, generics, span, ws),
      ck_written_each(arguments, c, generics),
      iheach(c),
      ws => c1 => frame_app_generic_ok_tracked(c1, n, generics, span, ws)
    )
    false => tracked_rewrap(
      c,
      ck_written_ctor_arity(c, n, span),
      ck_written_ctor_arity_frame_tracked(c, n, span)
    )
  }
}

pub theorem ck_written_bad_frame_tracked(
  c: Checker,
  span: TySpan
): TrackedFrame(
  c,
  ck_written_bad(c, span)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }
pub theorem frame_app_kind_ok_tracked(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool,
  app: WrittenApp,
  iheach: ∀ next: Checker. TrackedFrame(next, ck_written_each(arguments, next, generics))
): TrackedFrame(c, frame_app_kind(c, arguments, generics, span, under_borrow, app)) {
  match app: TrackedFrame(c, frame_app_kind(c, arguments, generics, span, under_borrow, app)) {
    WrittenUnit => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    WrittenInfo => tracked_bind(
      List(Ty),
      Ty,
      c,
      (ws: List(Ty), c1: Checker) => frame_app_info(c1, ws),
      ck_written_each(arguments, c, generics),
      iheach(c),
      ws => c1 => frame_app_info_ok_tracked(c1, ws)
    )
    WrittenNamed(n) => tracked_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        List(Ty),
        Ty,
        (ws: List(Ty), c2: Checker) => frame_return(
          TyNamed(n, ws),
          ck_arity(c2, n, list_len(ws), span)
        ),
        ck_written_each(arguments, c1, generics)
      ),
      frame_error_if(
        c,
        "Slice(A) can only be borrowed",
        span,
        Bool::and(Text::eq(n, "Slice"), not(under_borrow))
      ),
      frame_error_if_ok_tracked(
        c,
        "Slice(A) can only be borrowed",
        span,
        Bool::and(Text::eq(n, "Slice"), not(under_borrow))
      ),
      ignored => c1 => tracked_bind(
        List(Ty),
        Ty,
        c1,
        (ws: List(Ty), c2: Checker) => frame_return(
          TyNamed(n, ws),
          ck_arity(c2, n, list_len(ws), span)
        ),
        ck_written_each(arguments, c1, generics),
        iheach(c1),
        ws => c2 => tracked_return(
          c2,
          TyNamed(n, ws),
          ck_arity(c2, n, list_len(ws), span),
          ck_arity_frame_tracked(c2, n, list_len(ws), span)
        )
      )
    )
    WrittenGeneric(n) => frame_app_generic_count_ok_tracked(
      c,
      arguments,
      generics,
      span,
      n,
      Nat::eq(list_len(arguments), 1),
      iheach
    )
    WrittenBad => tracked_rewrap(c, ck_written_bad(c, span), ck_written_bad_frame_tracked(c, span))
  }
}

pub theorem frame_written_app_ok_tracked(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  function: SurfaceTerm,
  under_borrow: Bool,
  nested: Bool,
  ihterm: ∀ next: Checker. TrackedFrame(next, ck_written_in(function, next, generics)),
  iheach: ∀ next: Checker. TrackedFrame(next, ck_written_each(arguments, next, generics))
): TrackedFrame(c, frame_written_app(c, arguments, generics, span, function, under_borrow, nested)) {
  match nested: TrackedFrame(
    c,
    frame_written_app(c, arguments, generics, span, function, under_borrow, nested)
  ) {
    true => tracked_changed(
      c,
      frame_set_constructor_position(c, true),
      frame_bind(
        Ty,
        Ty,
        (before: Ty, c1: Checker) => frame_bind(
          List(Ty),
          Ty,
          (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
          ck_written_each(
            arguments,
            frame_set_constructor_position(c1, frame_constructor_position(c)),
            generics
          )
        ),
        ck_written_in(function, frame_set_constructor_position(c, true), generics)
      ),
      tracked_constructor_position(c, true),
      tracked_bind(
        Ty,
        Ty,
        frame_set_constructor_position(c, true),
        (before: Ty, c1: Checker) => frame_bind(
          List(Ty),
          Ty,
          (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
          ck_written_each(
            arguments,
            frame_set_constructor_position(c1, frame_constructor_position(c)),
            generics
          )
        ),
        ck_written_in(function, frame_set_constructor_position(c, true), generics),
        ihterm(frame_set_constructor_position(c, true)),
        before => c1 => tracked_changed(
          c1,
          frame_set_constructor_position(c1, frame_constructor_position(c)),
          frame_bind(
            List(Ty),
            Ty,
            (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
            ck_written_each(
              arguments,
              frame_set_constructor_position(c1, frame_constructor_position(c)),
              generics
            )
          ),
          tracked_constructor_position(c1, frame_constructor_position(c)),
          tracked_bind(
            List(Ty),
            Ty,
            frame_set_constructor_position(c1, frame_constructor_position(c)),
            (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
            ck_written_each(
              arguments,
              frame_set_constructor_position(c1, frame_constructor_position(c)),
              generics
            ),
            iheach(frame_set_constructor_position(c1, frame_constructor_position(c))),
            after => c2 => frame_app_nested_ok_tracked(c2, span, after, before)
          )
        )
      )
    )
    false => frame_app_kind_ok_tracked(
      c,
      arguments,
      generics,
      span,
      under_borrow,
      written_app(function, list_len(arguments), generics),
      iheach
    )
  }
}

pub theorem frame_written_pi_ok_tracked(
  params: List(SurfaceParam),
  result: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  ihps: ∀ next: Checker. TrackedFrame(
    next,
    ck_written_params(
      params,
      next,
      frame_pi_generics(params, generics),
      list_len(frame_pi_binders(params))
    )
  ),
  ihr: ∀ next: Checker. TrackedFrame(
    next,
    ck_written_in(result, next, frame_pi_generics(params, generics))
  )
): TrackedFrame(c, frame_written_pi(params, result, c, generics)) {
  tracked_bind(
    List(Ty),
    Ty,
    c,
    (ps: List(Ty), c1: Checker) => frame_bind(
      Ty,
      Ty,
      (r: Ty, c2: Checker) => mut1(
        ty_poly_of(frame_pi_binders(params), TyFn(ps, r, KindShared)),
        c2
      ),
      ck_written_in(result, c1, frame_pi_generics(params, generics))
    ),
    ck_written_params(
      params,
      c,
      frame_pi_generics(params, generics),
      list_len(frame_pi_binders(params))
    ),
    ihps(c),
    ps => c1 => tracked_bind(
      Ty,
      Ty,
      c1,
      (r: Ty, c2: Checker) => mut1(
        ty_poly_of(frame_pi_binders(params), TyFn(ps, r, KindShared)),
        c2
      ),
      ck_written_in(result, c1, frame_pi_generics(params, generics)),
      ihr(c1),
      r => c2 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c2)))
    )
  )
}

