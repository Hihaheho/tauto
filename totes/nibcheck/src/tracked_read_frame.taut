    )
    TyText => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyUnit => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyNever => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyDecimal => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyFloat => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyFloat32 => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyFn(params, result, kind) => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyUnion(members) => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyProduct(members) => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyTagged(tags, inner) => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyNamed(name, args) => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyParam(name, bound) => tracked_bind(
      <A: Unit, B: Ty>,
