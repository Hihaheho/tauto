pub theorem binding_var_view_frame_tracked(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm,
  r#view: Bool
): TrackedFrame(c, binding_var_view(c, name, resolved, value, r#view)) {
  match r#view: TrackedFrame(c, binding_var_view(c, name, resolved, value, r#view)) {
    true => tracked_rewrap(
      c,
      ck_error(c, cat3("a borrow cannot be stored in `var ", name, "`"), span_of(value)),
      ck_error_frame_tracked(
        c,
        cat3("a borrow cannot be stored in `var ", name, "`"),
        span_of(value)
      )
    )
    false => frame_error_if_ok_tracked(
      c,
      cat5(
        "a var cannot hold a linear value: `",
        name,
        "` is ",
        ty_show(ck_shown(c, resolved)),
        ""
      ),
      span_of(value),
      kind_eq(ck_kind(c, resolved), KindLinear)
    )
  }
}

