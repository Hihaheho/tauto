    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => signature_pred_generic_frame_tracked(
      c,
      w,
      name,
      preds,
      constraint_generic(signature_constraint_type(w), gs)
    )
  }
