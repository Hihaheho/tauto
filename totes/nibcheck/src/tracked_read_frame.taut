): TrackedFrame(c, ck_written_fn_kind(w, c, fk, span)) {
  match w: TrackedFrame(c, ck_written_fn_kind(w, c, fk, span)) {
    TyFn(ps, r, k) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyInt(width) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyBool => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyText => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyUnit => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyNever => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyDecimal => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyFloat => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyUnion(members) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyProduct(members) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyTagged(tags, inner) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyNamed(name, args) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyParam(name, bound) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyInfo(inner) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyBorrow(inner, mutable) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyVar(index) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyPoly(generics0, inner) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
    TyApp(head, arg) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    )
  }
}

pub theorem frame_written_fnkind_ok_tracked(
  fk: Text,
  ty: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  ih: ∀ next: Checker. TrackedFrame(next, ck_written_in(ty, next, generics))
): TrackedFrame(c, frame_written_fnkind(fk, ty, c, generics, span)) {
  tracked_bind(
    Ty,
    Ty,
    c,
    (w: Ty, c1: Checker) => ck_rewrap1(ck_written_fn_kind(w, c1, fk, span)),
    ck_written_in(ty, c, generics),
    ih(c),
    w => c1 => tracked_rewrap(
      c1,
      ck_written_fn_kind(w, c1, fk, span),
      ck_written_fn_kind_frame_tracked(w, c1, fk, span)
    )
  )
}

pub theorem frame_written_borrow_ok_tracked(
  mutable: Bool,
  x: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. TrackedFrame(next, ck_written_in(x, next, generics))
): TrackedFrame(c, frame_written_borrow(mutable, x, c, generics)) {
  tracked_changed(
    c,
    frame_set_under_borrow(c, true),
    frame_bind(
      Ty,
      Ty,
      (w: Ty, c1: Checker) => mut1(TyBorrow(w, mutable), c1),
      ck_written_in(x, frame_set_under_borrow(c, true), generics)
    ),
    tracked_under_borrow(c, true),
    tracked_bind(
      Ty,
      Ty,
      frame_set_under_borrow(c, true),
      (w: Ty, c1: Checker) => mut1(TyBorrow(w, mutable), c1),
      ck_written_in(x, frame_set_under_borrow(c, true), generics),
      ih(frame_set_under_borrow(c, true)),
      w => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
  )
}

pub theorem frame_written_union_ok_tracked(
  ts: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. TrackedFrame(next, ck_written_each(ts, next, generics))
): TrackedFrame(c, frame_written_union(ts, c, generics)) {
  tracked_bind(
    List(Ty),
    Ty,
    c,
    (w: List(Ty), c1: Checker) => mut1(ty_union(w), c1),
    ck_written_each(ts, c, generics),
    ih(c),
    w => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
  )
}

pub theorem frame_written_product_ok_tracked(
  ts: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. TrackedFrame(next, ck_written_each(ts, next, generics))
): TrackedFrame(c, frame_written_product(ts, c, generics)) {
  tracked_bind(
    List(Ty),
    Ty,
    c,
    (w: List(Ty), c1: Checker) => mut1(ty_product(w), c1),
    ck_written_each(ts, c, generics),
    ih(c),
    w => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
  )
}

pub theorem frame_written_tagged_ok_tracked(
  tag: Text,
  x: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. TrackedFrame(next, ck_written_in(x, next, generics))
): TrackedFrame(c, frame_written_tagged(tag, x, c, generics)) {
  tracked_bind(
    Ty,
    Ty,
    c,
    (w: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), w), c1),
    ck_written_in(x, c, generics),
    ih(c),
    w => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
  )
}

pub theorem frame_written_each_cons_ok_tracked(
  t: SurfaceTerm,
  rest: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  iht: ∀ next: Checker. TrackedFrame(next, ck_written_in(t, next, generics)),
  ihr: ∀ next: Checker. TrackedFrame(next, ck_written_each(rest, next, generics))
): TrackedFrame(c, frame_written_each_cons(t, rest, c, generics)) {
  tracked_bind(
    Ty,
    List(Ty),
    c,
    (head: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_written_each(rest, c1, generics)
    ),
    ck_written_in(t, c, generics),
    iht(c),
    head => c1 => tracked_bind(
      List(Ty),
      List(Ty),
      c1,
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_written_each(rest, c1, generics),
      ihr(c1),
      tail => c2 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c2))
      )
    )
  )
}

pub theorem frame_written_params_cons_ok_tracked(
  p: SurfaceParam,
  rest: List(SurfaceParam),
  c: Checker,
  generics: Ordmap(Text, Ty),
  skip: Nat,
  ihp: ∀ next: Checker. TrackedFrame(next, ck_written_param(p, next, generics)),
  ihr: ∀ next: Checker. ∀ count: Nat. TrackedFrame(
    next,
    ck_written_params(rest, next, generics, count)
  )
): TrackedFrame(c, frame_written_params_cons(p, rest, c, generics, skip)) {
  match skip: TrackedFrame(c, frame_written_params_cons(p, rest, c, generics, skip)) {
    Zero => tracked_bind(
      Ty,
      List(Ty),
      c,
      (head: Ty, c1: Checker) => frame_bind(
        List(Ty),
        List(Ty),
        (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
        ck_written_params(rest, c1, generics, 0)
      ),
      ck_written_param(p, c, generics),
      ihp(c),
      head => c1 => tracked_bind(
        List(Ty),
        List(Ty),
        c1,
        (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
        ck_written_params(rest, c1, generics, 0),
        ihr(c1, 0),
        tail => c2 => AndIntro(
          item => member => member,
          AndIntro(Refl, obligation_state_refl(c2))
        )
      )
    )
    Succ(n) => tracked_rewrap(c, ck_written_params(rest, c, generics, n), ihr(c, n))
  }
}

mutual {
  pub theorem ck_written_in_frame_tracked(
    t: SurfaceTerm,
    c: Checker,
    generics: Ordmap(Text, Ty)
  ): TrackedFrame(c, ck_written_in(t, c, generics)) {
    match t: TrackedFrame(c, ck_written_in(t, c, generics)) {
      SurfaceTermIndexedMk(sk, start, end, ast_occurrence) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_written_in_unf(ast_occurrence, sk, start, end, c, generics)),
        tracked_rewrap(
          c,
          ck_written_kind(
            sk,
            frame_set_under_borrow(c, false),
            generics,
            TySpan { start: start, end: end },
            frame_under_borrow(c)
          ),
          tracked_changed(
            c,
            frame_set_under_borrow(c, false),
            ck_written_kind(
              sk,
              frame_set_under_borrow(c, false),
              generics,
              TySpan { start: start, end: end },
              frame_under_borrow(c)
            ),
            tracked_under_borrow(c, false),
            ck_written_kind_frame_tracked(
              sk,
              frame_set_under_borrow(c, false),
              generics,
              TySpan { start: start, end: end },
              frame_under_borrow(c)
            )
          )
        )
      )
    }
  }
  pub theorem ck_written_kind_frame_tracked(
    sk: SurfaceKind,
    c: Checker,
    generics: Ordmap(Text, Ty),
    span: TySpan,
    under_borrow: Bool
  ): TrackedFrame(c, ck_written_kind(sk, c, generics, span, under_borrow)) {
    match sk: TrackedFrame(c, ck_written_kind(sk, c, generics, span, under_borrow)) {
      SkVar(n) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkVar(n, c, generics, span, under_borrow)),
        tracked_rewrap(
          c,
          ck_written_var(c, n, generics, span),
          ck_written_var_frame_tracked(c, n, generics, span)
        )
      )
      SkApp(function, arguments) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkApp(function, arguments, c, generics, span, under_borrow)),
        frame_written_app_ok_tracked(
          c,
          arguments,
          generics,
          span,
          function,
          under_borrow,
          written_nested(function),
          next => ck_written_in_frame_tracked(function, next, generics),
          next => ck_written_each_frame_tracked(arguments, next, generics)
        )
      )
      SkPi(params, result, effects) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkPi(params, result, effects, c, generics, span, under_borrow)),
        frame_written_pi_ok_tracked(
          params,
          result,
          c,
          generics,
          next => ck_written_params_frame_tracked(
            params,
            next,
            frame_pi_generics(params, generics),
            list_len(frame_pi_binders(params))
          ),
          next => ck_written_in_frame_tracked(result, next, frame_pi_generics(params, generics))
        )
      )
      SkFnKind(fk, ty) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkFnKind(fk, ty, c, generics, span, under_borrow)),
        frame_written_fnkind_ok_tracked(
          fk,
          ty,
          c,
          generics,
          span,
          next => ck_written_in_frame_tracked(ty, next, generics)
        )
      )
      SkBorrow(mutable, x) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkBorrow(mutable, x, c, generics, span, under_borrow)),
        frame_written_borrow_ok_tracked(
          mutable,
          x,
          c,
          generics,
          next => ck_written_in_frame_tracked(x, next, generics)
        )
      )
      SkUnion(ts) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkUnion(ts, c, generics, span, under_borrow)),
        frame_written_union_ok_tracked(
          ts,
          c,
          generics,
          next => ck_written_each_frame_tracked(ts, next, generics)
        )
      )
      SkProduct(ts) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkProduct(ts, c, generics, span, under_borrow)),
        frame_written_product_ok_tracked(
          ts,
          c,
          generics,
          next => ck_written_each_frame_tracked(ts, next, generics)
        )
      )
      SkTagged(tag, x) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkTagged(tag, x, c, generics, span, under_borrow)),
        frame_written_tagged_ok_tracked(
          tag,
          x,
          c,
          generics,
          next => ck_written_in_frame_tracked(x, next, generics)
        )
      )
      SkNat(digits) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkNat(digits, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkText(value) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkText(value, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkBool(value) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkBool(value, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkExists(binder, domain, body) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkExists(binder, domain, body, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkLam(params, body) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkLam(params, body, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkIf(cond, then, otherwise) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkIf(cond, then, otherwise, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkField(value, name) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkField(value, name, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkBlock(stmts) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkBlock(stmts, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkPerform(op, args) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkPerform(op, args, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkHandle(body, handlers) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkHandle(body, handlers, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkBudget(amount_memory, amount, body) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkBudget(amount_memory, amount, body, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkMatch(scrutinee, motive, arms, binder) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkMatch(scrutinee, motive, arms, binder, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkHole(name) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkHole(name, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkRecord(name, fields) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkRecord(name, fields, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkBorrowLam(borrows, lam) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkBorrowLam(borrows, lam, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkOther(what) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkOther(what, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkRow(what_effects) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkRow(what_effects, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkFloat(what) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkFloat(what, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkProject(what, what_ty) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkProject(what, what_ty, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkMacroCall(name, arg) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkMacroCall(name, arg, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkQuote(stmts_form, stmts) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkQuote(stmts_form, stmts, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkSplice(value) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkSplice(value, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkSyntaxLit(name, body) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_unf_SkSyntaxLit(name, body, c, generics, span, under_borrow)),
        tracked_state_refl(c)
      )
      SkStep(tactic, arg, call_start, call_end, before, arms) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(
          frame_unf_SkStep(
            tactic,
            arg,
            call_start,
            call_end,
            before,
            arms,
            c,
            generics,
            span,
            under_borrow
          )
        ),
        tracked_state_refl(c)
      )
    }
  }
  pub theorem ck_written_each_frame_tracked(
    ts: List(SurfaceTerm),
    c: Checker,
    generics: Ordmap(Text, Ty)
  ): TrackedFrame(c, ck_written_each(ts, c, generics)) {
    match ts: TrackedFrame(c, ck_written_each(ts, c, generics)) {
      Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
      Cons(t, rest) => Eq::subst(
        (z: Mut1(List(Ty), Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_written_each_unf(t, rest, c, generics)),
        frame_written_each_cons_ok_tracked(
          t,
          rest,
          c,
          generics,
          next => ck_written_in_frame_tracked(t, next, generics),
          next => ck_written_each_frame_tracked(rest, next, generics)
        )
      )
    }
  }
  pub theorem ck_written_params_frame_tracked(
    ps: List(SurfaceParam),
    c: Checker,
    generics: Ordmap(Text, Ty),
    skip: Nat
  ): TrackedFrame(c, ck_written_params(ps, c, generics, skip)) {
    match ps: TrackedFrame(c, ck_written_params(ps, c, generics, skip)) {
      Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
      Cons(p, rest) => Eq::subst(
        (z: Mut1(List(Ty), Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_written_params_unf(p, rest, c, generics, skip)),
        frame_written_params_cons_ok_tracked(
          p,
          rest,
          c,
          generics,
          skip,
          next => ck_written_param_frame_tracked(p, next, generics),
          next => count => ck_written_params_frame_tracked(rest, next, generics, count)
        )
      )
    }
  }
  pub theorem ck_written_param_frame_tracked(
    p: SurfaceParam,
    c: Checker,
    generics: Ordmap(Text, Ty)
  ): TrackedFrame(c, ck_written_param(p, c, generics)) {
    match p: TrackedFrame(c, ck_written_param(p, c, generics)) {
      SurfaceParamMk(name, ty) => Eq::subst(
        (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
        Eq::sym(frame_written_param_unf(name, ty, c, generics)),
        tracked_rewrap(
          c,
          ck_written_in(ty, c, generics),
          ck_written_in_frame_tracked(ty, c, generics)
        )
      )
    }
  }
}
pub theorem ck_written_frame_tracked(
  c: Checker,
  t: SurfaceTerm,
  generics: Ordmap(Text, Ty)
): TrackedFrame(c, ck_written(c, t, generics)) {
  tracked_rewrap(c, ck_written_in(t, c, generics), ck_written_in_frame_tracked(t, c, generics))
}

pub theorem ck_written_here_frame_tracked(
  c: Checker,
  t: SurfaceTerm
): TrackedFrame(c, ck_written_here(c, t)) {
  tracked_rewrap(
    c,
    ck_written(c, t, type_scope(ck_type_params_of(c))),
    ck_written_frame_tracked(c, t, type_scope(ck_type_params_of(c)))
  )
}

pub theorem binding_let_mode_frame_tracked(
  c: Checker,
  name: Text,
  resolved: Ty,
  value: SurfaceTerm,
  bm: Bool
): TrackedFrame(c, binding_let_mode(c, name, resolved, value, bm)) {
  match bm: TrackedFrame(c, binding_let_mode(c, name, resolved, value, bm)) {
    true => tracked_rewrap(
      c,
      ck_error(
        c,
        cat3("`let &mut ", name, "` binds what a function returns as `-> &mut A`"),
        span_of(value)
      ),
      ck_error_frame_tracked(
        c,
        cat3("`let &mut ", name, "` binds what a function returns as `-> &mut A`"),
        span_of(value)
      )
    )
    false => tracked_rewrap(
      c,
      ck_error(
        c,
        cat3("`let &", name, "` binds what a function returns as `-> &A`"),
        span_of(value)
      ),
      ck_error_frame_tracked(
        c,
        cat3("`let &", name, "` binds what a function returns as `-> &A`"),
        span_of(value)
      )
    )
  }
}

pub theorem binding_let_view_frame_tracked(
  c: Checker,
  name: Text,
  bm: Bool,
  resolved: Ty,
  value: SurfaceTerm,
  r#view: Bool
): TrackedFrame(c, binding_let_view(c, name, bm, resolved, value, r#view)) {
  match r#view: TrackedFrame(c, binding_let_view(c, name, bm, resolved, value, r#view)) {
    true => frame_error_if_ok_tracked(
      c,
      cat3("`let &mut ", name, "` binds what a function returns as `-> &mut A`"),
      span_of(value),
      Bool::and(bm, not(ck_has_mut_borrow(c, resolved)))
    )
    false => binding_let_mode_frame_tracked(c, name, resolved, value, bm)
  }
}

pub theorem ck_let_borrow_frame_tracked(
  c: Checker,
  name: Text,
  r#view: Bool,
  bm: Bool,
  resolved: Ty,
  value: SurfaceTerm
): TrackedFrame(c, ck_let_borrow(c, name, r#view, bm, resolved, value)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(binding_let_borrow_unf(c, name, r#view, bm, resolved, value)),
    binding_let_view_frame_tracked(c, name, bm, resolved, value, r#view)
  )
}

pub theorem leaf_ck_stored_borrow_frame_tracked(
