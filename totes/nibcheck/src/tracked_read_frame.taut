pub theorem ck_sig_written_frame_tracked(
  c: Checker,
  p: Option(SurfaceTerm),
  map: Ordmap(Text, Ty)
): TrackedFrame(c, ck_sig_written(c, p, map)) {
  match p: TrackedFrame(c, ck_sig_written(c, p, map)) {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(x) => tracked_rewrap(c, ck_written(c, x, map), ck_written_frame_tracked(c, x, map))
  }
}
pub theorem signature_wrap_if_frame_tracked(
  c: Checker,
  t: Ty,
  mutable: Bool,
  borrowed: Bool
): TrackedFrame(c, signature_wrap_if(c, t, mutable, borrowed)) {
  match borrowed: TrackedFrame(c, signature_wrap_if(c, t, mutable, borrowed)) {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  }
}
pub theorem signature_wrap_frame_tracked(
  c: Checker,
  t: Ty,
  b: Option(Bool)
): TrackedFrame(c, signature_wrap(c, t, b)) {
  match b: TrackedFrame(c, signature_wrap(c, t, b)) {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(m) => signature_wrap_if_frame_tracked(c, t, m, ty_is_borrow(t))
  }
}
pub theorem ck_sig_param_frame_tracked(
  c: Checker,
  p: Option(SurfaceTerm),
  b: Option(Bool),
  map: Ordmap(Text, Ty)
): TrackedFrame(c, ck_sig_param(c, p, b, map)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(signature_param_unf(c, p, b, map)),
    tracked_bind(
      Ty,
      Ty,
      c,
      (t: Ty, next: Checker) => signature_wrap(next, t, b),
      ck_sig_written(frame_set_under_borrow(c, signature_some_borrow(b)), p, map),
      tracked_changed(
        c,
        frame_set_under_borrow(c, signature_some_borrow(b)),
        ck_sig_written(frame_set_under_borrow(c, signature_some_borrow(b)), p, map),
        tracked_under_borrow(c, signature_some_borrow(b)),
        ck_sig_written_frame_tracked(frame_set_under_borrow(c, signature_some_borrow(b)), p, map)
      ),
      t => next => signature_wrap_frame_tracked(next, t, b)
    )
  )
}

pub theorem signature_params_cons_frame_tracked(
  p: Option(SurfaceTerm),
  rest: List(Option(SurfaceTerm)),
  c: Checker,
  borrows: List(Option(Bool)),
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ bs: List(
    Option(Bool)
  ). TrackedFrame(next, ck_sig_params(rest, next, bs, map))
): TrackedFrame(c, signature_params_cons(p, rest, c, borrows, map)) {
  tracked_bind(
    Ty,
    List(Ty),
    c,
    (head: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_sig_params(rest, c1, List::tail(borrows), map)
    ),
    ck_sig_param(c, p, list_head_or_none(borrows), map),
    ck_sig_param_frame_tracked(c, p, list_head_or_none(borrows), map),
    head => c1 => tracked_bind(
      List(Ty),
      List(Ty),
      c1,
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_sig_params(rest, c1, List::tail(borrows), map),
      ih(c1, List::tail(borrows)),
      tail => c2 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c2))
      )
    )
  )
}

pub theorem ck_sig_params_frame_tracked(
  pts: List(Option(SurfaceTerm)),
  c: Checker,
  borrows: List(Option(Bool)),
  map: Ordmap(Text, Ty)
): TrackedFrame(c, ck_sig_params(pts, c, borrows, map)) {
  match pts: TrackedFrame(c, ck_sig_params(pts, c, borrows, map)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(p, rest) => Eq::subst(
      (z: Mut1(List(Ty), Checker)) => TrackedFrame(c, z),
      Eq::sym(signature_params_unf(p, rest, c, borrows, map)),
      signature_params_cons_frame_tracked(
        p,
        rest,
        c,
        borrows,
        map,
        next => bs => ck_sig_params_frame_tracked(rest, next, bs, map)
      )
    )
  }
}

