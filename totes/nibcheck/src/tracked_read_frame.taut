    Eq::sym(leaf_ck_check_covers_unf(c, s, arms, span)),
    leaf_ck_check_covers_frame_tracked(c, s, arms, span)
  )
}

pub theorem frame_arity_small_ok_tracked(
  c: Checker,
  n: Text,
