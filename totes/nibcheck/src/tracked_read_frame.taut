pub fn tracked_literal_entry(negative: Bool, magnitude: Nat, ty: Ty, span: TySpan): TyLiteral {
  TyLiteral {
    start: span.start,
    end: span.end,
    negative: Bool::and(negative, Nat::lt(0, magnitude)),
    magnitude: magnitude,
    ty: ty
  }
}
pub theorem pattern_literal_record_frame_tracked(
  c: Checker,
  negative: Bool,
  magnitude: Nat,
  ty: Ty,
  span: TySpan
): TrackedFrame(c, pattern_literal_record(c, negative, magnitude, ty, span)) {
  AndIntro(
    item => member => MemThere(
      tracked_literal_entry(negative, magnitude, ty, span),
      stable_literals(c),
      member
    ),
    AndIntro(Refl, obligation_state_refl(c))
  )
}
pub theorem ck_fresh_frame_tracked(
  c: Checker
): TrackedFrame(
  c,
  ck_fresh(c)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }
pub theorem instantiation_bound_frame_tracked(
  c: Checker,
  g: Pair(Text, Kind),
  v: Ty,
  name: Text,
  span: TySpan,
  arg: Option(Kind)
): TrackedFrame(
  c,
  instantiation_bound(c, g, v, name, span, arg)
) { match arg: TrackedFrame(c, instantiation_bound(c, g, v, name, span, arg)) { None => AndIntro(
  item => member => member,
  AndIntro(
    Refl,
    AndIntro(
      instantiation_bound_frame_requirements(c, g, v, name, span, None),
      (item: TyPending, member: Mem(TyPending, item, finish_pending_items(c))) => member
    )
  )
)
    Some(kind) => AndIntro(
      item => member => member,
      AndIntro(
        Refl,
        AndIntro(
          instantiation_bound_frame_requirements(c, g, v, name, span, Some(kind)),
          (item: TyPending, member: Mem(TyPending, item, finish_pending_items(c))) => member
        )
      )
    ) } }
pub theorem instantiation_cons_frame_tracked(
  g: Pair(Text, Kind),
  rest: List(Pair(Text, Kind)),
  c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ more: Ordmap(
    Text,
    Ty
  ). TrackedFrame(next, ck_instantiate_map_ctors(rest, next, ctors, name, span, more))
): TrackedFrame(c, instantiation_cons(g, rest, c, ctors, name, span, map)) {
  tracked_bind(
    Ty,
    Ordmap(Text, Ty),
    c,
    (v: Ty, c1: Checker) => frame_bind(
      Unit,
      Ordmap(Text, Ty),
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        )
      ),
      instantiation_bound(c1, g, v, name, span, ctor_arg_of(ctors, instantiation_name(g)))
    ),
    ck_fresh(c),
    ck_fresh_frame_tracked(c),
    v => c1 => tracked_bind(
      Unit,
      Ordmap(Text, Ty),
      c1,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        )
      ),
      instantiation_bound(c1, g, v, name, span, ctor_arg_of(ctors, instantiation_name(g))),
      instantiation_bound_frame_tracked(
        c1,
        g,
        v,
        name,
        span,
        ctor_arg_of(ctors, instantiation_name(g))
      ),
      ignored => c2 => tracked_rewrap(
        c2,
        ck_instantiate_map_ctors(
          rest,
          c2,
          ctors,
          name,
          span,
          Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text)
        ),
        ih(c2, Ordmap::insert(map, instantiation_name(g), v, Ordmap::compare_text))
      )
    )
  )
}

pub theorem ck_instantiate_map_ctors_frame_tracked(
  gs: List(Pair(Text, Kind)),
  c: Checker,
  ctors: List(Pair(Text, Kind)),
  name: Text,
  span: TySpan,
  map: Ordmap(Text, Ty)
): TrackedFrame(c, ck_instantiate_map_ctors(gs, c, ctors, name, span, map)) {
  match gs: TrackedFrame(c, ck_instantiate_map_ctors(gs, c, ctors, name, span, map)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => TrackedFrame(c, z),
      Eq::sym(instantiation_cons_unf(g, rest, c, ctors, name, span, map)),
      instantiation_cons_frame_tracked(
        g,
        rest,
        c,
        ctors,
        name,
        span,
        map,
        next => more => ck_instantiate_map_ctors_frame_tracked(rest, next, ctors, name, span, more)
      )
    )
  }
}
pub theorem ck_pend_frame_tracked(
  c: Checker,
  r#class: Text,
  t: Ty,
  what: Text,
  span: TySpan
): TrackedFrame(c, ck_pend(c, r#class, t, what, span)) {
  AndIntro(
    item => member => member,
    AndIntro(
      Refl,
      AndIntro(
        ck_pend_frame_requirements(c, r#class, t, what, span),
        And::left(ck_pend_retains(c, r#class, t, what, span))
      )
    )
  )
}
pub theorem instantiation_pred_frame_tracked(
  c: Checker,
  p: Pair(Text, Text),
  what: Text,
  span: TySpan,
  found: Option(Ty)
): TrackedFrame(c, instantiation_pred(c, p, what, span, found)) {
  match found: TrackedFrame(c, instantiation_pred(c, p, what, span, found)) {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(t) => tracked_rewrap(
      c,
      ck_pend(c, instantiation_constraint(p), t, what, span),
      ck_pend_frame_tracked(c, instantiation_constraint(p), t, what, span)
    )
  }
}

pub theorem instantiation_preds_cons_frame_tracked(
  p: Pair(Text, Text),
  rest: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan,
  ih: ∀ next: Checker. TrackedFrame(next, ck_pend_preds(rest, next, map, what, span))
): TrackedFrame(c, instantiation_preds_cons(p, rest, c, map, what, span)) {
  tracked_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_pend_preds(rest, c1, map, what, span)),
    instantiation_pred(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    instantiation_pred_frame_tracked(
      c,
      p,
      what,
      span,
      Ordmap::get(map, instantiation_parameter(p), Ordmap::compare_text)
    ),
    ignored => c1 => tracked_rewrap(c1, ck_pend_preds(rest, c1, map, what, span), ih(c1))
  )
}

pub theorem ck_pend_preds_frame_tracked(
  ps: List(Pair(Text, Text)),
  c: Checker,
  map: Ordmap(Text, Ty),
  what: Text,
  span: TySpan
): TrackedFrame(c, ck_pend_preds(ps, c, map, what, span)) {
  match ps: TrackedFrame(c, ck_pend_preds(ps, c, map, what, span)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(p, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
      Eq::sym(instantiation_preds_cons_unf(p, rest, c, map, what, span)),
      instantiation_preds_cons_frame_tracked(
        p,
        rest,
        c,
        map,
        what,
        span,
        next => ck_pend_preds_frame_tracked(rest, next, map, what, span)
      )
    )
  }
}

pub theorem instantiation_scheme_frame_tracked(
  c: Checker,
  name: Text,
  s: Scheme,
  span: TySpan
): TrackedFrame(c, instantiation_scheme(c, name, s, span)) {
  tracked_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c2: Checker) => mut1(ty_substitute(instantiation_scheme_ty(s), map), c2),
      ck_pend_preds(instantiation_scheme_preds(s), c1, map, name, span)
    ),
    ck_instantiate_map_ctors(
      instantiation_scheme_generics(s),
      c,
      instantiation_scheme_ctors(s),
      name,
      span,
      Ordmap::empty()
    ),
    ck_instantiate_map_ctors_frame_tracked(
      instantiation_scheme_generics(s),
      c,
      instantiation_scheme_ctors(s),
      name,
      span,
      Ordmap::empty()
    ),
    map => c1 => tracked_bind(
      Unit,
      Ty,
      c1,
      (ignored: Unit, c2: Checker) => mut1(ty_substitute(instantiation_scheme_ty(s), map), c2),
      ck_pend_preds(instantiation_scheme_preds(s), c1, map, name, span),
      ck_pend_preds_frame_tracked(instantiation_scheme_preds(s), c1, map, name, span),
      ignored => c2 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c2))
      )
    )
  )
}

pub theorem ck_instantiate_scheme_frame_tracked(
  c: Checker,
  name: Text,
  s: Scheme,
  span: TySpan
): TrackedFrame(c, ck_instantiate_scheme(c, name, s, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(instantiation_scheme_unf(c, name, s, span)),
    instantiation_scheme_frame_tracked(c, name, s, span)
  )
}
pub theorem ck_fresh_int_read_frame_tracked(
  c: Checker
): TrackedFrame(
  c,
  ck_fresh_int(c)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }
pub theorem ck_error_frame_tracked(
  c: Checker,
  message: Text,
  span: TySpan
): TrackedFrame(
  c,
  ck_error(c, message, span)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }
pub theorem pattern_fresh_cons_frame_tracked(
  g: Text,
  rest: List(Text),
  c: Checker,
  ih: ∀ next: Checker. TrackedFrame(next, ck_fresh_each(rest, next))
): TrackedFrame(c, pattern_fresh_cons(g, rest, c)) {
  tracked_bind(
    Ty,
    List(Ty),
    c,
    (h: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tl: List(Ty), c2: Checker) => mut1(Cons(h, tl), c2),
      ck_fresh_each(rest, c1)
    ),
    ck_fresh(c),
    ck_fresh_frame_tracked(c),
    h => c1 => tracked_bind(
      List(Ty),
      List(Ty),
      c1,
      (tl: List(Ty), c2: Checker) => mut1(Cons(h, tl), c2),
      ck_fresh_each(rest, c1),
      ih(c1),
      tl => c2 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c2)))
    )
  )
}

pub theorem ck_fresh_each_frame_tracked(
  gs: List(Text),
  c: Checker
): TrackedFrame(c, ck_fresh_each(gs, c)) {
  match gs: TrackedFrame(c, ck_fresh_each(gs, c)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(g, rest) => Eq::subst(
      (z: Mut1(List(Ty), Checker)) => TrackedFrame(c, z),
      Eq::sym(pattern_fresh_unf(g, rest, c)),
      pattern_fresh_cons_frame_tracked(g, rest, c, next => ck_fresh_each_frame_tracked(rest, next))
    )
  }
}

pub theorem frame_error_if_ok_tracked(
  c: Checker,
  message: Text,
  span: TySpan,
  b: Bool
): TrackedFrame(c, frame_error_if(c, message, span, b)) {
  match b: TrackedFrame(c, frame_error_if(c, message, span, b)) {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  }
}

pub theorem leaf_constructor_return_frame_tracked(
  c: Checker,
  d: Text,
  args: List(Ty),
  fields: List(DataField)
): TrackedFrame(c, leaf_constructor_return(c, d, args, fields)) {
  match fields: TrackedFrame(c, leaf_constructor_return(c, d, args, fields)) { Nil => AndIntro(
    item => member => member,
    AndIntro(Refl, obligation_state_refl(c))
  )
    Cons(f, rest) => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c))
    ) }
}
pub theorem leaf_constructor_fields_frame_tracked(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text,
  args: List(Ty),
  fields: List(DataField)
): TrackedFrame(c, leaf_constructor_fields(c, d, idx, span, name, args, fields)) {
  tracked_bind(
    Unit,
    Ty,
    c,
    (ignored: Unit, c1: Checker) => leaf_constructor_return(c1, d, args, fields),
    frame_error_if(
      c,
      cat5("`", name, "` is a struct: write `", name, " { field: value }`"),
      span,
      data_is_struct(ck_datas_of(c), d)
    ),
    frame_error_if_ok_tracked(
      c,
      cat5("`", name, "` is a struct: write `", name, " { field: value }`"),
      span,
      data_is_struct(ck_datas_of(c), d)
    ),
    ignored => c1 => leaf_constructor_return_frame_tracked(c1, d, args, fields)
  )
}

pub theorem leaf_constructor_frame_tracked(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): TrackedFrame(c, leaf_constructor(c, d, idx, span, name)) {
  tracked_bind(
    List(Ty),
    Ty,
    c,
    (args: List(Ty), c1: Checker) => leaf_constructor_fields(
      c1,
      d,
      idx,
      span,
      name,
      args,
      datas_fields(ck_datas_of(c1), d, idx, args)
    ),
    ck_fresh_each(data_generics_of(ck_datas_of(c), d), c),
    ck_fresh_each_frame_tracked(data_generics_of(ck_datas_of(c), d), c),
    args => c1 => leaf_constructor_fields_frame_tracked(
      c1,
      d,
      idx,
      span,
      name,
      args,
      datas_fields(ck_datas_of(c1), d, idx, args)
    )
  )
}

pub theorem ck_constructor_known_frame_tracked(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): TrackedFrame(c, ck_constructor_known(c, d, idx, span, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_constructor_unf(c, d, idx, span, name)),
    leaf_constructor_frame_tracked(c, d, idx, span, name)
  )
}

pub theorem ck_defer_constructor_frame_tracked(
  c: Checker,
  name: Text,
  span: TySpan
): TrackedFrame(c, ck_defer_constructor(c, name, span)) {
  AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
}

pub theorem leaf_constructor_choice_frame_tracked(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text,
  ambiguous: Bool
): TrackedFrame(c, leaf_constructor_choice(c, d, idx, span, name, ambiguous)) {
  match ambiguous: TrackedFrame(c, leaf_constructor_choice(c, d, idx, span, name, ambiguous)) {
    true => tracked_rewrap(
      c,
      ck_defer_constructor(c, name, span),
      ck_defer_constructor_frame_tracked(c, name, span)
    )
    false => tracked_rewrap(
      c,
      ck_constructor_known(c, d, idx, span, name),
      ck_constructor_known_frame_tracked(c, d, idx, span, name)
    )
  }
}

pub theorem ck_constructor_frame_tracked(
  c: Checker,
  d: Text,
  idx: Nat,
  span: TySpan,
  name: Text
): TrackedFrame(c, ck_constructor(c, d, idx, span, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_constructor_choice_unf(c, d, idx, span, name)),
    leaf_constructor_choice_frame_tracked(
      c,
      d,
      idx,
      span,
      name,
      datas_ctor_ambiguous(ck_datas_of(c), name)
    )
  )
}

pub theorem leaf_lookup_ctor_frame_tracked(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Pair(Text, Nat))
): TrackedFrame(c, leaf_lookup_ctor(c, name, env, span, found)) {
  match found: TrackedFrame(c, leaf_lookup_ctor(c, name, env, span, found)) {
    None => tracked_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat2(name, " is not defined"), span),
      ck_error_frame_tracked(c, cat2(name, " is not defined"), span),
      ignored => c1 => tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1))
    )
    Some(dc) => tracked_rewrap(
      c,
      ck_constructor(c, pattern_ctor_name(dc), pattern_ctor_index(dc), span, name),
      ck_constructor_frame_tracked(c, pattern_ctor_name(dc), pattern_ctor_index(dc), span, name)
    )
  }
}

pub theorem leaf_lookup_special_frame_tracked(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  special: Bool
): TrackedFrame(c, leaf_lookup_special(c, name, env, span, special)) {
  match special: TrackedFrame(c, leaf_lookup_special(c, name, env, span, special)) {
    true => tracked_bind(
      Ty,
      Ty,
      c,
      (i: Ty, c1: Checker) => mut1(TyFn(Cons(i, Cons(i, Nil)), i, KindShared), c1),
      ck_fresh_int(c),
      ck_fresh_int_read_frame_tracked(c),
      i => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    false => leaf_lookup_ctor_frame_tracked(c, name, env, span, datas_ctor(ck_datas_of(c), name))
  }
}

pub theorem leaf_lookup_function_frame_tracked(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Scheme)
): TrackedFrame(c, leaf_lookup_function(c, name, env, span, found)) {
  match found: TrackedFrame(c, leaf_lookup_function(c, name, env, span, found)) {
    Some(s) => tracked_rewrap(
      c,
      ck_instantiate_scheme(c, name, s, span),
      ck_instantiate_scheme_frame_tracked(c, name, s, span)
    )
    None => leaf_lookup_special_frame_tracked(
      c,
      name,
      env,
      span,
      Bool::or(Text::eq(name, "div"), Text::eq(name, "mod"))
    )
  }
}

pub theorem leaf_lookup_frame_tracked(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan,
  found: Option(Local)
): TrackedFrame(c, leaf_lookup(c, name, env, span, found)) {
  match found: TrackedFrame(c, leaf_lookup(c, name, env, span, found)) {
    Some(l) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    None => leaf_lookup_function_frame_tracked(
      c,
      name,
      env,
      span,
      Ordmap::get(leaf_functions(c), name, Ordmap::compare_text)
    )
  }
}

pub theorem ck_lookup_frame_tracked(
  c: Checker,
  name: Text,
  env: List(Local),
  span: TySpan
): TrackedFrame(c, ck_lookup(c, name, env, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_lookup_unf(c, name, env, span)),
    leaf_lookup_frame_tracked(c, name, env, span, env_find(env, name))
  )
}

pub theorem leaf_ck_field_missing_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  t: Ty,
  name: Text
): TrackedFrame(c, leaf_ck_field_missing(c, term, t, name)) {
  tracked_bind(
    Unit,
    Ty,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, cat4(ty_show(t), " has no field `", name, "`"), span_of(term)),
    ck_error_frame_tracked(c, cat4(ty_show(t), " has no field `", name, "`"), span_of(term)),
    ignored => c1 => tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1))
  )
}

pub theorem ck_field_missing_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  t: Ty,
  name: Text
): TrackedFrame(c, ck_field_missing(c, term, t, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_ck_field_missing_unf(c, term, t, name)),
    leaf_ck_field_missing_frame_tracked(c, term, t, name)
  )
}

pub theorem access_borrow_frame_tracked(
  c: Checker,
  t: Ty,
  borrow: Bool
): TrackedFrame(c, access_borrow(c, t, borrow)) {
  match borrow: TrackedFrame(c, access_borrow(c, t, borrow)) {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
  }
}

pub theorem access_found_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  name: Text,
  d: Text,
  borrowed: Bool,
  found: Option(Ty)
): TrackedFrame(c, access_found(c, term, name, d, borrowed, found)) {
  match found: TrackedFrame(c, access_found(c, term, name, d, borrowed, found)) {
    None => tracked_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
      ck_error(c, cat4(d, " has no field `", name, "`"), span_of(term)),
      ck_error_frame_tracked(c, cat4(d, " has no field `", name, "`"), span_of(term)),
      ignored => c1 => tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1))
    )
    Some(t) => access_borrow_frame_tracked(c, t, Bool::and(borrowed, not(kind_dup(ck_kind(c, t)))))
  }
}

pub theorem access_struct_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  name: Text,
  d: Text,
  args: List(Ty),
  borrowed: Bool,
  structural: Bool
): TrackedFrame(c, access_struct(c, term, name, d, args, borrowed, structural)) {
  match structural: TrackedFrame(c, access_struct(c, term, name, d, args, borrowed, structural)) {
    true => access_found_frame_tracked(
      c,
      term,
      name,
      d,
      borrowed,
      ck_field_find(datas_fields(ck_datas_of(c), d, 0, args), name)
    )
    false => tracked_rewrap(
      c,
      ck_field_missing(c, term, TyNamed(d, args), name),
      ck_field_missing_frame_tracked(c, term, TyNamed(d, args), name)
    )
  }
}

pub theorem access_info_unbounded_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  name: Text,
  h: Ty,
  unbounded: Bool
): TrackedFrame(c, access_info_unbounded(c, term, name, h, unbounded)) {
  match unbounded: TrackedFrame(c, access_info_unbounded(c, term, name, h, unbounded)) {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => tracked_rewrap(
      c,
      ck_field_missing(c, term, TyInfo(h), name),
      ck_field_missing_frame_tracked(c, term, TyInfo(h), name)
    )
  }
}

pub theorem access_info_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  name: Text,
  h: Ty,
  more: Bool
): TrackedFrame(c, access_info(c, term, name, h, more)) {
  match more: TrackedFrame(c, access_info(c, term, name, h, more)) {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => access_info_unbounded_frame_tracked(c, term, name, h, Text::eq(name, "unbounded"))
  }
}

pub theorem access_field_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  name: Text,
  original: Ty,
  borrowed: Bool,
  t: Ty
): TrackedFrame(c, access_field(c, term, name, original, borrowed, t)) {
  match t: TrackedFrame(c, access_field(c, term, name, original, borrowed, t)) {
    TyInt(pat_w) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyBool => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyText => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyUnit => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyNever => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyDecimal => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyFloat => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyFn(pat_params, pat_result, pat_kind) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyUnion(pat_members) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyProduct(pat_members) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyTagged(pat_tags, pat_inner) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyNamed(d, args) => access_struct_frame_tracked(
      c,
      term,
      name,
      d,
      args,
      borrowed,
      data_is_struct(ck_datas_of(c), d)
    )
    TyParam(pat_name, pat_bound) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyInfo(h) => access_info_frame_tracked(c, term, name, h, Text::eq(name, "more"))
    TyBorrow(pat_inner, pat_mutable) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyVar(pat_v) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyPoly(pat_generics, pat_inner) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
    TyApp(pat_head, pat_arg) => tracked_rewrap(
      c,
      ck_field_missing(c, term, original, name),
      ck_field_missing_frame_tracked(c, term, original, name)
    )
  }
}

pub theorem ck_field_of_frame_tracked(
  c: Checker,
  term: SurfaceTerm,
  b: Ty,
  name: Text
): TrackedFrame(c, ck_field_of(c, term, b, name)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(access_field_unf(c, term, b, name)),
    access_field_frame_tracked(
      c,
      term,
      name,
      ty_unborrowed(ck_resolve(c, b)),
      ty_is_borrow(ck_resolve(c, b)),
      ty_unborrowed(ck_resolve(c, b))
    )
  )
}

pub theorem leaf_literal_parsed_frame_tracked(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty,
  parsed: Option(Nat)
): TrackedFrame(c, leaf_literal_parsed(c, n, span, t, parsed)) {
  match parsed: TrackedFrame(c, leaf_literal_parsed(c, n, span, t, parsed)) {
    Some(v) => tracked_rewrap(
      c,
      pattern_literal_record(c, false, v, t, span),
      pattern_literal_record_frame_tracked(c, false, v, t, span)
    )
    None => tracked_rewrap(
      c,
      ck_error(c, cat2(n, " is too large"), span),
      ck_error_frame_tracked(c, cat2(n, " is too large"), span)
    )
  }
}

pub theorem leaf_literal_after_frame_tracked(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty
): TrackedFrame(c, leaf_literal_after(c, n, span, t)) {
  tracked_bind(
    Unit,
    Ty,
    c,
    (ignored: Unit, c1: Checker) => mut1(t, c1),
    leaf_literal_parsed(c, n, span, t, text_parse_u64(n)),
    leaf_literal_parsed_frame_tracked(c, n, span, t, text_parse_u64(n)),
    ignored => c1 => AndIntro(
      item => member => member,
      AndIntro(Refl, obligation_state_refl(c1))
    )
  )
}

pub theorem leaf_literal_frame_tracked(
  c: Checker,
  n: Text,
  span: TySpan
): TrackedFrame(c, leaf_literal(c, n, span)) {
  tracked_bind(
    Ty,
    Ty,
    c,
    (t: Ty, c1: Checker) => leaf_literal_after(c1, n, span, t),
    ck_fresh_int(c),
    ck_fresh_int_read_frame_tracked(c),
    t => c1 => leaf_literal_after_frame_tracked(c1, n, span, t)
  )
}

pub theorem ck_nat_literal_frame_tracked(
  c: Checker,
  n: Text,
  span: TySpan
): TrackedFrame(c, ck_nat_literal(c, n, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_literal_unf(c, n, span)),
    leaf_literal_frame_tracked(c, n, span)
  )
}

pub theorem instantiation_named_cons_frame_tracked(
  g: Text,
  rest: List(Text),
  c: Checker,
  map: Ordmap(Text, Ty),
  ih: ∀ next: Checker. ∀ more: Ordmap(
    Text,
    Ty
  ). TrackedFrame(next, ck_instantiate_named_map(rest, next, more))
): TrackedFrame(c, instantiation_named_cons(g, rest, c, map)) {
  tracked_bind(
    Ty,
    Ordmap(Text, Ty),
    c,
    (v: Ty, c1: Checker) => ck_rewrap1(
      ck_instantiate_named_map(rest, c1, Ordmap::insert(map, g, v, Ordmap::compare_text))
    ),
    ck_fresh(c),
    ck_fresh_frame_tracked(c),
    v => c1 => tracked_rewrap(
      c1,
      ck_instantiate_named_map(rest, c1, Ordmap::insert(map, g, v, Ordmap::compare_text)),
      ih(c1, Ordmap::insert(map, g, v, Ordmap::compare_text))
    )
  )
}

pub theorem ck_instantiate_named_map_frame_tracked(
  gs: List(Text),
  c: Checker,
  map: Ordmap(Text, Ty)
): TrackedFrame(c, ck_instantiate_named_map(gs, c, map)) {
  match gs: TrackedFrame(c, ck_instantiate_named_map(gs, c, map)) {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(g, rest) => Eq::subst(
      (z: Mut1(Ordmap(Text, Ty), Checker)) => TrackedFrame(c, z),
      Eq::sym(instantiation_named_cons_unf(g, rest, c, map)),
      instantiation_named_cons_frame_tracked(
        g,
        rest,
        c,
        map,
        next => more => ck_instantiate_named_map_frame_tracked(rest, next, more)
      )
    )
  }
}

pub theorem instantiation_ck_instantiate_named_frame_tracked(
  c: Checker,
  gs: List(Text),
  t: Ty
): TrackedFrame(c, instantiation_ck_instantiate_named(c, gs, t)) {
  tracked_bind(
    Ordmap(Text, Ty),
    Ty,
    c,
    (map: Ordmap(Text, Ty), c1: Checker) => mut1(ty_substitute(t, map), c1),
    ck_instantiate_named_map(gs, c, Ordmap::empty()),
    ck_instantiate_named_map_frame_tracked(gs, c, Ordmap::empty()),
    map => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
  )
}

pub theorem ck_instantiate_named_frame_tracked(
  c: Checker,
  gs: List(Text),
  t: Ty
): TrackedFrame(c, ck_instantiate_named(c, gs, t)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(instantiation_ck_instantiate_named_unf(c, gs, t)),
    instantiation_ck_instantiate_named_frame_tracked(c, gs, t)
  )
}

pub theorem leaf_ck_check_lend_frame_tracked(
  c: Checker,
  mutable: Bool,
  inner: SurfaceTerm,
  env: List(Local),
  span: TySpan
): TrackedFrame(c, leaf_ck_check_lend(c, mutable, inner, env, span)) {
  frame_error_if_ok_tracked(
    c,
    cat2(leaf_lend_name(inner), " is not a var: only a var lends `&mut`"),
    span,
    Bool::and(mutable, not(ck_mutable_place(inner, c, env)))
  )
}

pub theorem ck_check_lend_frame_tracked(
  c: Checker,
  mutable: Bool,
  inner: SurfaceTerm,
  env: List(Local),
  span: TySpan
): TrackedFrame(c, ck_check_lend(c, mutable, inner, env, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_ck_check_lend_unf(c, mutable, inner, env, span)),
    leaf_ck_check_lend_frame_tracked(c, mutable, inner, env, span)
  )
}

pub theorem handle_direct_frame_tracked(
  c: Checker,
  quant: Quant,
  eff: Text,
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm
): TrackedFrame(c, handle_direct(c, quant, eff, cont, guard, body)) {
  frame_error_if_ok_tracked(
    c,
    cat3(eff, " is direct; every path of its arm must end in k(e)", ""),
    span_of(body),
    handle_direct_bad(quant, cont, guard, body)
  )
}

pub theorem ck_handle_direct_frame_tracked(
  c: Checker,
  quant: Quant,
  eff: Text,
  cont: Option(Text),
  guard: Option(SurfaceTerm),
  body: SurfaceTerm
): TrackedFrame(c, ck_handle_direct(c, quant, eff, cont, guard, body)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(handle_direct_unf(c, quant, eff, cont, guard, body)),
    handle_direct_frame_tracked(c, quant, eff, cont, guard, body)
  )
}

pub theorem handle_sig_found_frame_tracked(
  c: Checker,
  eff: Text,
  result: Ty,
  budget_ty: Ty,
  body: SurfaceTerm,
  found: Option(EffectSig)
): TrackedFrame(c, handle_sig_found(c, eff, result, budget_ty, body, found)) {
  match found: TrackedFrame(c, handle_sig_found(c, eff, result, budget_ty, body, found)) {
    Some(s) => tracked_bind(
      Ty,
      Option(Pair(List(Ty), Ty)),
      c,
      (ty: Ty, c1: Checker) => mut1(ty_fn_sig(ty), c1),
      ck_instantiate_named(c, handle_effect_generics(s), handle_effect_type(s)),
      ck_instantiate_named_frame_tracked(c, handle_effect_generics(s), handle_effect_type(s)),
      ty => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    None => tracked_bind(
      Unit,
      Option(Pair(List(Ty), Ty)),
      c,
      (ignored: Unit, c1: Checker) => mut1(None, c1),
      ck_error(c, cat3("no effect `", eff, "` is declared"), span_of(body)),
      ck_error_frame_tracked(c, cat3("no effect `", eff, "` is declared"), span_of(body)),
      ignored => c1 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c1))
      )
    )
  }
}

pub theorem handle_sig_frame_tracked(
  c: Checker,
  eff: Text,
  result: Ty,
  budget_ty: Ty,
  body: SurfaceTerm,
  exceeded: Bool
): TrackedFrame(c, handle_sig(c, eff, result, budget_ty, body, exceeded)) {
  match exceeded: TrackedFrame(c, handle_sig(c, eff, result, budget_ty, body, exceeded)) {
    true => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    false => handle_sig_found_frame_tracked(
      c,
      eff,
      result,
      budget_ty,
      body,
      Ordmap::get(handle_effects(c), eff, Ordmap::compare_text)
    )
  }
}

pub theorem ck_handle_sig_frame_tracked(
  c: Checker,
  eff: Text,
  result: Ty,
  budget_ty: Ty,
  body: SurfaceTerm
): TrackedFrame(c, ck_handle_sig(c, eff, result, budget_ty, body)) {
  Eq::subst(
    (z: Mut1(Option(Pair(List(Ty), Ty)), Checker)) => TrackedFrame(c, z),
    Eq::sym(handle_sig_unf(c, eff, result, budget_ty, body)),
    handle_sig_frame_tracked(c, eff, result, budget_ty, body, Text::eq(eff, "exceeded"))
  )
}

