pub theorem leaf_ck_operator_bad_frame_tracked(
  c: Checker,
  op: Text,
  span: TySpan
): TrackedFrame(c, leaf_ck_operator_bad(c, op, span)) {
  tracked_bind(
    Unit,
    Ty,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_fresh(c1)),
    ck_error(c, cat3("`", op, "` takes other operands"), span),
    ck_error_frame_tracked(c, cat3("`", op, "` takes other operands"), span),
    ignored => c1 => tracked_rewrap(c1, ck_fresh(c1), ck_fresh_frame_tracked(c1))
  )
}

pub theorem ck_operator_bad_frame_tracked(
  c: Checker,
  op: Text,
  span: TySpan
): TrackedFrame(c, ck_operator_bad(c, op, span)) {
