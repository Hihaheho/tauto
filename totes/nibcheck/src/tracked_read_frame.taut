      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
    TyApp(typehead, typearg) => tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, clone_takes_borrow_message(), span_of(arg)),
      ck_error_frame_tracked(c, clone_takes_borrow_message(), span_of(arg)),
      ignored => c1 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c1)))
    )
  }
}

pub theorem ck_clone_target_frame_tracked(
  c: Checker,
  t: Ty,
  arg: SurfaceTerm
): TrackedFrame(c, ck_clone_target(c, t, arg)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_clone_target_unf(c, t, arg)),
    leaf_clone_target_frame_tracked(c, ck_resolve(c, t), arg, ck_resolve(c, t))
  )
}

pub theorem leaf_clone_why_frame_tracked(
  c: Checker,
  span: TySpan,
  why: Option(Text)
): TrackedFrame(c, leaf_clone_why(c, span, why)) {
  match why {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(message) => tracked_rewrap(
      c,
      ck_error(c, message, span),
      ck_error_frame_tracked(c, message, span)
    )
  }
}

pub theorem leaf_clone_frame_tracked(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): TrackedFrame(c, leaf_clone(c, t0, arg, span)) {
  tracked_bind(
    <A: Ty, B: Ty>,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      <A: Unit, B: Ty>,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t))
    ),
    ck_clone_target(c, t0, arg),
    ck_clone_target_frame_tracked(c, t0, arg),
    t => c1 => tracked_bind(
      <A: Unit, B: Ty>,
      c1,
      (ignored: Unit, c2: Checker) => mut1(t, c2),
      leaf_clone_why(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      leaf_clone_why_frame_tracked(c1, span, datas_no_clone(ck_datas_of(c1), t)),
      ignored => c2 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c2)))
    )
  )
}

pub theorem ck_clone_value_frame_tracked(
  c: Checker,
  t0: Ty,
  arg: SurfaceTerm,
  span: TySpan
): TrackedFrame(c, ck_clone_value(c, t0, arg, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_clone_unf(c, t0, arg, span)),
    leaf_clone_frame_tracked(c, t0, arg, span)
  )
}
pub theorem argument_lambda_cons_frame_tracked(
  p: Text,
  rest: List(Text),
  c: Checker,
  r#borrows: List(Option(Bool)),
  ih: ∀ next: Checker. TrackedFrame(next, ck_lambda_params(rest, next, List::tail(r#borrows)))
): TrackedFrame(c, argument_lambda_cons(p, rest, c, r#borrows)) {
  tracked_bind(
    <A: Ty, B: List(Ty)>,
    c,
    (t: Ty, c1: Checker) => frame_bind(
      <A: List(Ty), B: List(Ty)>,
      (tl: List(Ty), c2: Checker) => mut1(Cons(field_under(t, list_head_or_none(r#borrows)), tl), c2),
      ck_lambda_params(rest, c1, List::tail(r#borrows))
    ),
    ck_fresh(c),
    ck_fresh_frame_tracked(c),
    t => c1 => tracked_bind(
      <A: List(Ty), B: List(Ty)>,
      c1,
      (tl: List(Ty), c2: Checker) => mut1(Cons(field_under(t, list_head_or_none(r#borrows)), tl), c2),
      ck_lambda_params(rest, c1, List::tail(r#borrows)),
      ih(c1),
      tl => c2 => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c2)))
    )
  )
}

pub theorem ck_lambda_params_frame_tracked(
  ps: List(Text),
  c: Checker,
  r#borrows: List(Option(Bool))
): TrackedFrame(c, ck_lambda_params(ps, c, r#borrows)) {
  match ps {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(p, rest) => Eq::subst(
      (z: Mut1(List(Ty), Checker)) => TrackedFrame(c, z),
      Eq::sym(argument_lambda_cons_unf(p, rest, c, r#borrows)),
      argument_lambda_cons_frame_tracked(
        p,
        rest,
        c,
        r#borrows,
        next => ck_lambda_params_frame_tracked(rest, next, List::tail(r#borrows))
      )
    )
  }
}

pub theorem inference_record_closure_frame_tracked(
  c: Checker,
  t: Ty,
  body: SurfaceTerm,
  cap: TyCaptures
): TrackedFrame(
  c,
  inference_record_closure(c, t, body, cap)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }
pub theorem record_missing_name_frame_tracked(
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan,
  fieldname: Option(Text)
): TrackedFrame(c, record_missing_name(c, name, seen, span, fieldname)) {
  match fieldname {
    None => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Some(n) => frame_error_if_ok_tracked(
      c,
      field_missing_message(n, name),
      span,
      not(list_has_text(seen, n))
    )
  }
}

pub theorem ck_record_missing_one_frame_tracked(
  c: Checker,
  name: Text,
  f: DataField,
  seen: List(Text),
  span: TySpan
): TrackedFrame(c, ck_record_missing_one(c, name, f, seen, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(record_missing_one_unf(c, name, f, seen, span)),
    record_missing_name_frame_tracked(c, name, seen, span, record_data_name(f))
  )
}

pub theorem record_missing_cons_frame_tracked(
  f: DataField,
  rest: List(DataField),
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan,
  ih: ∀ next: Checker. TrackedFrame(next, ck_record_missing(rest, next, name, seen, span))
): TrackedFrame(c, record_missing_cons(f, rest, c, name, seen, span)) {
  tracked_bind(
    <A: Unit, B: Unit>,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_record_missing(rest, c1, name, seen, span)),
    ck_record_missing_one(c, name, f, seen, span),
    ck_record_missing_one_frame_tracked(c, name, f, seen, span),
    ignored => c1 => tracked_rewrap(c1, ck_record_missing(rest, c1, name, seen, span), ih(c1))
  )
}

pub theorem ck_record_missing_frame_tracked(
  fs: List(DataField),
  c: Checker,
  name: Text,
  seen: List(Text),
  span: TySpan
): TrackedFrame(c, ck_record_missing(fs, c, name, seen, span)) {
  match fs {
    Nil => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    Cons(f, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
      Eq::sym(record_missing_cons_unf(f, rest, c, name, seen, span)),
      record_missing_cons_frame_tracked(
        f,
        rest,
        c,
        name,
        seen,
        span,
        next => ck_record_missing_frame_tracked(rest, next, name, seen, span)
      )
    )
  }
}
pub theorem leaf_ck_check_covers_frame_tracked(
  c: Checker,
  s: Ty,
  arms: List(SurfaceArm),
  span: TySpan
): TrackedFrame(c, leaf_ck_check_covers(c, s, arms, span)) {
  tracked_bind(
    <A: Unit, B: Unit>,
    c,
    (reported: Unit, c1: Checker) => ck_rewrap1(ck_check_default_arm(c1, s, arms, span)),
    frame_error_if(c, match_not_exhaustive_message(), span, not(covers(ck_datas_of(c), ck_resolve(c, s), open_patterns(arms)))),
    frame_error_if_ok_tracked(c, match_not_exhaustive_message(), span, not(covers(ck_datas_of(c), ck_resolve(c, s), open_patterns(arms)))),
    reported => c1 => tracked_rewrap(
      c1,
      ck_check_default_arm(c1, s, arms, span),
      Eq::subst(
        (z: Mut1(Unit, Checker)) => TrackedFrame(c1, z),
        Eq::sym(leaf_ck_check_default_arm_unf(c1, s, arms, span)),
        frame_error_if_ok_tracked(
        c1,
        problem_message(arm_problem(ck_datas_of(c1), ck_resolve(c1, s), arms, span)),
        problem_span(arm_problem(ck_datas_of(c1), ck_resolve(c1, s), arms, span)),
        problem_found(arm_problem(ck_datas_of(c1), ck_resolve(c1, s), arms, span))
      )
    )
      )
    )
}

pub theorem ck_float_literal_frame_tracked(
  c: Checker,
  x: Text,
  span: TySpan
): TrackedFrame(c, ck_float_literal(c, x, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => TrackedFrame(c, z),
    Eq::sym(ck_float_literal_unf(c, x, span)),
    tracked_bind(
      <A: Unit, B: Ty>,
      c,
      (reported: Unit, c1: Checker) => mut1(TyFloat, c1),
      frame_error_if(c, float_too_large_message(x), span, not(float_literal_fits(x))),
      frame_error_if_ok_tracked(c, float_too_large_message(x), span, not(float_literal_fits(x))),
      reported => c1 => tracked_state_refl(c1)
    )
  )
}

