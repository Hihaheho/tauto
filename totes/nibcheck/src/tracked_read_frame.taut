      )
    )
    TyFloat => tracked_bind(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => mut1(original, c1),
      ck_error(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ck_error_frame_tracked(c, "`clone` takes a borrow: write `clone(&x)`", span_of(arg)),
      ignored => c1 => AndIntro(
        item => member => member,
        AndIntro(Refl, obligation_state_refl(c1))
      )
