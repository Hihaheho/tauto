pub theorem ck_add_int_frame_tracked(
  c: Checker,
  v: Nat
): TrackedFrame(
  c,
  ck_add_int(c, v)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }

pub theorem leaf_number_frame_tracked(
  c: Checker,
  original: Ty,
  span: TySpan,
  op: Text,
  r: Ty
): TrackedFrame(c, leaf_number(c, original, span, op, r)) {
  match r: TrackedFrame(c, leaf_number(c, original, span, op, r)) {
    TyInt(w) => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyBool => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyText => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyUnit => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyNever => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyDecimal => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyFloat => AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c)))
    TyFn(params, result, kind) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyUnion(members) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyProduct(members) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyTagged(tags, inner) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyNamed(name, args) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyParam(name, bound) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyInfo(inner) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyBorrow(inner, mutable) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyVar(v) => tracked_rewrap(c, ck_add_int(c, v), ck_add_int_frame_tracked(c, v))
    TyPoly(generics, inner) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
    TyApp(typehead, typearg) => tracked_rewrap(
      c,
      ck_error(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span),
      ck_error_frame_tracked(c, cat5("`", op, "` of ", ty_show(original), ": not a number"), span)
    )
  }
}

pub theorem ck_number_frame_tracked(
  c: Checker,
  t: Ty,
  span: TySpan,
  op: Text
): TrackedFrame(c, ck_number(c, t, span, op)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => TrackedFrame(c, z),
    Eq::sym(leaf_number_unf(c, t, span, op)),
    leaf_number_frame_tracked(c, ck_resolve(c, t), span, op, ck_resolve(c, t))
  )
}

pub theorem ck_record_op_frame_tracked(
  c: Checker,
  a: Ty,
  span: TySpan,
  occurrence: Option(TermOccurrence)
): TrackedFrame(
  c,
  ck_record_op(c, a, span, occurrence)
) { AndIntro(item => member => member, AndIntro(Refl, obligation_state_refl(c))) }

pub theorem leaf_div_var_frame_tracked(
  c: Checker,
  span: TySpan,
  v: Nat,
  unknown: Bool
): TrackedFrame(c, leaf_div_var(c, span, v, unknown)) {
  match unknown: TrackedFrame(c, leaf_div_var(c, span, v, unknown)) {
    true => tracked_rewrap(
      c,
      ck_error(c, "the operands of `/` have no known type: write it", span),
      ck_error_frame_tracked(c, "the operands of `/` have no known type: write it", span)
    )
    false => tracked_rewrap(
      c,
      ck_error(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      ),
      ck_error_frame_tracked(
        c,
        "integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)",
        span
      )
    )
  }
}

