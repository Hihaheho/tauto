pub theorem inf_preds_missing_normal(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  missing: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkNormalFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkNormalFrame(c, inf_preds_missing(w, rest, c, gs, preds, missing)) {
  match missing: CkNormalFrame(c, inf_preds_missing(w, rest, c, gs, preds, missing)) {
    true => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        cat2(signature_constraint_class(w), " is not a class"),
        signature_constraint_span(w)
      ),
      ck_error_normal(
        c,
        cat2(signature_constraint_class(w), " is not a class"),
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    false => inf_preds_kind_normal(w, rest, c, gs, preds, inf_pred_kind(w), ih)
  }
}

pub theorem ck_instance_preds_normal(
  ws: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text))
): CkNormalFrame(c, ck_instance_preds(ws, c, gs, preds)) {
  match ws: CkNormalFrame(c, ck_instance_preds(ws, c, gs, preds)) {
    Nil => normal => normal
    Cons(w, rest) => Eq::subst(
      (z: Mut1(List(Pair(Text, Text)), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_preds_unf(w, rest, c, gs, preds)),
      inf_preds_missing_normal(
        w,
        rest,
        c,
        gs,
        preds,
        signature_class_missing(c, w),
        next => ps => ck_instance_preds_normal(rest, next, gs, ps)
      )
    )
  }
}

pub theorem inf_store_normal(
  c: Checker,
  i: SurfaceInstance,
  ctor: Text,
  g: SigGenerics,
  head: Ty,
  preds: List(Pair(Text, Text)),
  made: List(SurfaceFn)
): CkNormalFrame(c, inf_store(c, i, ctor, g, head, preds, made)) { normal => normal }

pub theorem inf_rest_duplicate_normal(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Bool
): CkNormalFrame(
  c,
  inf_rest_duplicate(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
) {
  match bad: CkNormalFrame(
    c,
    inf_rest_duplicate(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
  ) {
    true => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat3(inf_class(i), " already has an instance for ", ctor), inf_span(i)),
      ck_error_normal(c, cat3(inf_class(i), " already has an instance for ", ctor), inf_span(i)),
      ignored => c1 => normal => normal
    )
    false => normal_bind(
      List(Pair(Text, Text)),
      List(SurfaceFn),
      c,
      (preds: List(Pair(Text, Text)), c1: Checker) => frame_bind(
        Unit,
        List(SurfaceFn),
        (ignored1: Unit, c2: Checker) => frame_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info))
      ),
      ck_instance_preds(inf_wheres(i), c, inf_generics(i), Nil),
      ck_instance_preds_normal(inf_wheres(i), c, inf_generics(i), Nil),
      preds => c1 => normal_bind(
        Unit,
        List(SurfaceFn),
        c1,
        (ignored1: Unit, c2: Checker) => frame_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          )
        ),
        ck_instance_laws(inf_laws(i), Nil, c1, i, inf_info_decl(info)),
        ck_instance_laws_normal(inf_laws(i), Nil, c1, i, inf_info_decl(info)),
        ignored1 => c2 => normal_bind(
          List(SurfaceFn),
          List(SurfaceFn),
          c2,
          (made: List(SurfaceFn), c3: Checker) => frame_bind(
            Unit,
            List(SurfaceFn),
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info))
          ),
          ck_instance_methods(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          ),
          ck_instance_methods_normal(
            cf_class_methods(inf_info_decl(info)),
            c2,
            i,
            inf_info_decl(info),
            ctor,
            shown,
            out
          ),
          made => c3 => normal_bind(
            Unit,
            List(SurfaceFn),
            c3,
            (ignored2: Unit, c4: Checker) => inf_store(c4, i, ctor, g, head, preds, made),
            ck_instance_extra(inf_methods(i), c3, i, inf_info_decl(info)),
            ck_instance_extra_normal(inf_methods(i), c3, i, inf_info_decl(info)),
            ignored2 => c4 => inf_store_normal(c4, i, ctor, g, head, preds, made)
          )
        )
      )
    )
  }
}

pub theorem inf_rest_orphan_normal(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text,
  bad: Bool
): CkNormalFrame(
  c,
  inf_rest_orphan(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
) {
  match bad: CkNormalFrame(
    c,
    inf_rest_orphan(c, i, info, own_classes, own_types, out, g, head, ctor, shown, bad)
  ) {
    true => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(
        c,
        cat5(
          inf_class(i),
          cat3("(", ctor, ")"),
          " must be in the tote of ",
          inf_class(i),
          cat2(" or of ", ctor)
        ),
        inf_span(i)
      ),
      ck_error_normal(
        c,
        cat5(
          inf_class(i),
          cat3("(", ctor, ")"),
          " must be in the tote of ",
          inf_class(i),
          cat2(" or of ", ctor)
        ),
        inf_span(i)
      ),
      ignored => c1 => normal => normal
    )
    false => inf_rest_duplicate_normal(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      inf_duplicate(c, i, ctor)
    )
  }
}

pub theorem ck_declare_instance_rest_normal(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  g: SigGenerics,
  head: Ty,
  ctor: Text,
  shown: Text
): CkNormalFrame(
  c,
  ck_declare_instance_rest(c, i, info, own_classes, own_types, out, g, head, ctor, shown)
) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
    Eq::sym(inf_rest_unf(c, i, info, own_classes, own_types, out, g, head, ctor, shown)),
    inf_rest_orphan_normal(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      g,
      head,
      ctor,
      shown,
      Bool::and(not(text_list_has(own_classes, inf_class(i))), not(text_list_has(own_types, ctor)))
    )
  )
}

pub theorem inf_head_message_normal(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  ctor: Text,
  message: Option(Pair(Text, TySpan))
): CkNormalFrame(c, inf_head_message(c, i, info, own_classes, own_types, out, head, ctor, message)) {
  match message: CkNormalFrame(
    c,
    inf_head_message(c, i, info, own_classes, own_types, out, head, ctor, message)
  ) {
    None => normal_rewrap(
      c,
      ck_declare_instance_rest(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      ),
      ck_declare_instance_rest_normal(
        c,
        i,
        info,
        own_classes,
        own_types,
        out,
        inf_gens(i),
        head,
        ctor,
        ty_show(ck_shown(c, head))
      )
    )
    Some(m) => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, inf_message_text(m), inf_message_span(m)),
      ck_error_normal(c, inf_message_text(m), inf_message_span(m)),
      ignored => c1 => normal => normal
    )
  }
}

pub theorem inf_head_ctor_normal(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  head: Ty,
  found: Option(Text)
): CkNormalFrame(c, inf_head_ctor(c, i, info, own_classes, own_types, out, head, found)) {
  match found: CkNormalFrame(
    c,
    inf_head_ctor(c, i, info, own_classes, own_types, out, head, found)
  ) {
    None => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ck_error_normal(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ignored => c1 => normal => normal
    )
    Some(ctor) => inf_head_message_normal(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      head,
      ctor,
      ck_instance_head_message(c, i, info, head, ctor)
    )
  }
}

pub fn normal_instance_head_after(
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  m: Mut1(Ty, Checker)
): Mut1(List(SurfaceFn), Checker) {
  frame_bind(
    Ty,
    List(SurfaceFn),
    (head: Ty, next: Checker) => inf_head_ctor(
      frame_set_constructor_position(next, false),
      i,
      info,
      own_classes,
      own_types,
      out,
      head,
      ty_constructor(head)
    ),
    m
  )
}
pub theorem normal_instance_head_after_sound(
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  m: Mut1(Ty, Checker),
  ordinary: frame_under_borrow(ck_st(m)) = false
): CkNormal(ck_st(normal_instance_head_after(i, info, own_classes, own_types, out, m))) {
  match m: CkNormal(ck_st(normal_instance_head_after(i, info, own_classes, own_types, out, m))) {
    mut1(head, next) => inf_head_ctor_normal(
      frame_set_constructor_position(next, false),
      i,
      info,
      own_classes,
      own_types,
      out,
      head,
      ty_constructor(head),
      Eq::congr((borrow: Bool) => Pair { fst: false, snd: borrow }, ordinary)
    )
  }
}
pub theorem inf_head_missing_normal(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  missing: Option(Text)
): CkNormalFrame(c, inf_head_missing(c, i, info, own_classes, own_types, out, missing)) {
  match missing: CkNormalFrame(
    c,
    inf_head_missing(c, i, info, own_classes, own_types, out, missing)
  ) {
    Some(name) => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, next: Checker) => mut1(out, next),
      ck_error(c, cat2(name, " does not appear in the head"), inf_head_span(i)),
      ck_error_normal(c, cat2(name, " does not appear in the head"), inf_head_span(i)),
      ignored => next => normal => normal
    )
    None => normal => normal_instance_head_after_sound(
      i,
      info,
      own_classes,
      own_types,
      out,
      ck_written(frame_set_constructor_position(c, true), inf_head(i), signature_map(inf_gens(i))),
      Eq::congr(
        written_context_borrow,
        ck_written_reset(
          frame_set_constructor_position(c, true),
          inf_head(i),
          signature_map(inf_gens(i))
        )
      )
    )
  }
}

pub theorem inf_head_shape_normal(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  bad: Bool
): CkNormalFrame(c, inf_head_shape(c, i, info, own_classes, own_types, out, bad)) {
  match bad: CkNormalFrame(c, inf_head_shape(c, i, info, own_classes, own_types, out, bad)) {
    true => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ck_error_normal(c, "an instance head applies a type to distinct generics", inf_head_span(i)),
      ignored => c1 => normal => normal
    )
    false => inf_head_missing_normal(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      generic_not_in_head(inf_generics(i), inf_head(i))
    )
  }
}

pub theorem ck_declare_instance_at_normal(
  c: Checker,
  i: SurfaceInstance,
  info: ClassInfo,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkNormalFrame(c, ck_declare_instance_at(c, i, info, own_classes, own_types, out)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
    Eq::sym(inf_at_unf(c, i, info, own_classes, own_types, out)),
    inf_head_shape_normal(
      c,
      i,
      info,
      own_classes,
      own_types,
      out,
      not(head_shape_ok(inf_head(i), inf_generics(i)))
    )
  )
}

pub theorem inf_class_lookup_normal(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  o: Option(ClassInfo)
): CkNormalFrame(c, inf_class_lookup(c, i, own_classes, own_types, out, o)) {
  match o: CkNormalFrame(c, inf_class_lookup(c, i, own_classes, own_types, out, o)) {
    None => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(inf_class(i), " is not a class"), inf_span(i)),
      ck_error_normal(c, cat2(inf_class(i), " is not a class"), inf_span(i)),
      ignored => c1 => normal => normal
    )
    Some(info) => normal_rewrap(
      c,
      ck_declare_instance_at(c, i, info, own_classes, own_types, out),
      ck_declare_instance_at_normal(c, i, info, own_classes, own_types, out)
    )
  }
}

pub theorem inf_class_structural_normal(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  structural: Bool
): CkNormalFrame(c, inf_class_structural(c, i, own_classes, own_types, out, structural)) {
  match structural: CkNormalFrame(
    c,
    inf_class_structural(c, i, own_classes, own_types, out, structural)
  ) {
    true => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => mut1(out, c1),
      ck_error(c, cat2(inf_class(i), " is structural and has no instances to write"), inf_span(i)),
      ck_error_normal(
        c,
        cat2(inf_class(i), " is structural and has no instances to write"),
        inf_span(i)
      ),
      ignored => c1 => normal => normal
    )
    false => inf_class_lookup_normal(c, i, own_classes, own_types, out, inf_class_get(c, i))
  }
}

pub theorem ck_declare_instance_normal(
  c: Checker,
  i: SurfaceInstance,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkNormalFrame(c, ck_declare_instance(c, i, own_classes, own_types, out)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
    Eq::sym(inf_declare_unf(c, i, own_classes, own_types, out)),
    inf_class_structural_normal(
      c,
      i,
      own_classes,
      own_types,
      out,
      class_is_structural(inf_class(i))
    )
  )
}

pub theorem inf_list_cons_normal(
  i: SurfaceInstance,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkNormalFrame(next, ck_declare_instances(rest, next, own_classes, own_types, fs))
): CkNormalFrame(c, inf_list_cons(i, rest, c, own_classes, own_types, out)) {
  normal_bind(
    List(SurfaceFn),
    List(SurfaceFn),
    c,
    (made: List(SurfaceFn), c1: Checker) => ck_rewrap1(
      ck_declare_instances(rest, c1, own_classes, own_types, made)
    ),
    ck_declare_instance(c, i, own_classes, own_types, out),
    ck_declare_instance_normal(c, i, own_classes, own_types, out),
    made => c1 => normal_rewrap(
      c1,
      ck_declare_instances(rest, c1, own_classes, own_types, made),
      ih(c1, made)
    )
  )
}

pub theorem inf_list_step_normal(
  s: SurfaceStmt,
  rest: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkNormalFrame(next, ck_declare_instances(rest, next, own_classes, own_types, fs))
): CkNormalFrame(c, ck_declare_instances(Cons(s, rest), c, own_classes, own_types, out)) {
  match s: CkNormalFrame(c, ck_declare_instances(Cons(s, rest), c, own_classes, own_types, out)) {
    StLet(name, ty, value, borrow, mutable) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(
        inf_list_StLet_unf(name, ty, value, borrow, mutable, rest, c, own_classes, own_types, out)
      ),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StVar(name, ty, value, borrow) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StVar_unf(name, ty, value, borrow, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StModule(name, stmts, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StModule_unf(name, stmts, start, end, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StAssign(name, name_place, value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StAssign_unf(name, name_place, value, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StCalled(name_generates, value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StCalled_unf(name_generates, value, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StFn(f) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StFn_unf(f, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StTheorem(t) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StTheorem_unf(t, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StDef(t) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StDef_unf(t, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StMutual(stmts, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StMutual_unf(stmts, start, end, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StImport(path, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StImport_unf(path, start, end, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StInductive(i) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StInductive_unf(i, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StEffect(e) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StEffect_unf(e, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StStruct(d) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StStruct_unf(d, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StEnum(d) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StEnum_unf(d, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StExtern(abi, fns, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StExtern_unf(abi, fns, start, end, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StClass(cl) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StClass_unf(cl, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StInstance(i) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StInstance_unf(i, rest, c, own_classes, own_types, out)),
      inf_list_cons_normal(i, rest, c, own_classes, own_types, out, ih)
    )
    StWhile(cond, body) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StWhile_unf(cond, body, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StReturn(value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StReturn_unf(value, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StExpr(value) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StExpr_unf(value, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StOther(what, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_list_StOther_unf(what, start, end, rest, c, own_classes, own_types, out)),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StMacro(name, function, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(
        inf_list_StMacro_unf(name, function, start, end, rest, c, own_classes, own_types, out)
      ),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StAttributed(attr_name, attr_arg, attr_generates, attr_stmt) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(
        inf_list_StAttributed_unf(
          attr_name,
          attr_arg,
          attr_generates,
          attr_stmt,
          rest,
          c,
          own_classes,
          own_types,
          out
        )
      ),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
    StSyntax(name, grammar, start, end) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(
        inf_list_StSyntax_unf(name, grammar, start, end, rest, c, own_classes, own_types, out)
      ),
      normal_rewrap(c, ck_declare_instances(rest, c, own_classes, own_types, out), ih(c, out))
    )
  }
}

pub theorem ck_declare_instances_normal(
  ss: List(SurfaceStmt),
  c: Checker,
  own_classes: List(Text),
  own_types: List(Text),
  out: List(SurfaceFn)
): CkNormalFrame(c, ck_declare_instances(ss, c, own_classes, own_types, out)) {
  match ss: CkNormalFrame(c, ck_declare_instances(ss, c, own_classes, own_types, out)) {
    Nil => normal => normal
    Cons(s, rest) => inf_list_step_normal(
      s,
      rest,
      c,
      own_classes,
      own_types,
      out,
      next => fs => ck_declare_instances_normal(rest, next, own_classes, own_types, fs)
    )
  }
}

pub theorem inf_declare_classes_normal(
  c: Checker,
  program: List(SurfaceStmt)
): CkNormalFrame(c, inf_declare_classes(c, program)) {
  normal_bind(
    List(SurfaceClass),
    List(SurfaceFn),
    c,
    (declared: List(SurfaceClass), c1: Checker) => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c2: Checker) => frame_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1)
    ),
    ck_declare_class_list(program, c, stmts_type_names(program)),
    ck_declare_class_list_normal(program, c, stmts_type_names(program)),
    declared => c1 => normal_bind(
      Unit,
      List(SurfaceFn),
      c1,
      (ignored: Unit, c2: Checker) => frame_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        )
      ),
      ck_declare_methods(declared, c1),
      ck_declare_methods_normal(declared, c1),
      ignored => c2 => normal_bind(
        List(SurfaceFn),
        List(SurfaceFn),
        c2,
        (fs: List(SurfaceFn), c3: Checker) => mut1(List::reverse(fs), c3),
        ck_declare_instances(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        ),
        ck_declare_instances_normal(
          program,
          c2,
          stmts_class_names(program),
          stmts_type_names(program),
          Nil
        ),
        fs => c3 => normal => normal
      )
    )
  )
}

pub theorem ck_declare_classes_normal(
  c: Checker,
  program: List(SurfaceStmt)
): CkNormalFrame(c, ck_declare_classes(c, program)) {
  Eq::subst(
    (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
    Eq::sym(inf_classes_unf(c, program)),
    inf_declare_classes_normal(c, program)
  )
}
