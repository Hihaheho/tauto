import "classes_normal.taut"
import "../../surface/src/surface.taut"

pub theorem inf_law_duplicate_normal(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Bool,
  ih: ∀ ns: List(
    Text
  ). ∀ next: Checker. CkNormalFrame(next, ck_instance_laws(rest, ns, next, i, decl))
): CkNormalFrame(c, inf_law_duplicate(l, rest, seen, c, i, decl, bad)) {
  match bad: CkNormalFrame(c, inf_law_duplicate(l, rest, seen, c, i, decl, bad)) {
    true => normal_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(
        c,
        cat3("the law ", cf_law_name(l), " of the instance is written twice"),
        cf_law_span(l)
      ),
      ck_error_normal(
        c,
        cat3("the law ", cf_law_name(l), " of the instance is written twice"),
        cf_law_span(l)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_laws(rest, seen, c1, i, decl), ih(seen, c1))
    )
    false => normal_rewrap(
      c,
      ck_instance_laws(rest, Cons(cf_law_name(l), seen), c, i, decl),
      ih(Cons(cf_law_name(l), seen), c)
    )
  }
}

pub theorem inf_law_missing_normal(
  l: SurfaceLaw,
  rest: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  bad: Bool,
  ih: ∀ ns: List(
    Text
  ). ∀ next: Checker. CkNormalFrame(next, ck_instance_laws(rest, ns, next, i, decl))
): CkNormalFrame(c, inf_law_missing(l, rest, seen, c, i, decl, bad)) {
  match bad: CkNormalFrame(c, inf_law_missing(l, rest, seen, c, i, decl, bad)) {
    true => normal_bind(
      Unit,
      Unit,
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_laws(rest, seen, c1, i, decl)),
      ck_error(c, cat3(inf_class(i), " has no law ", cf_law_name(l)), cf_law_span(l)),
      ck_error_normal(c, cat3(inf_class(i), " has no law ", cf_law_name(l)), cf_law_span(l)),
      ignored => c1 => normal_rewrap(c1, ck_instance_laws(rest, seen, c1, i, decl), ih(seen, c1))
    )
    false => inf_law_duplicate_normal(
      l,
      rest,
      seen,
      c,
      i,
      decl,
      text_list_has(seen, cf_law_name(l)),
      ih
    )
  }
}

pub theorem ck_instance_laws_normal(
  ls: List(SurfaceLaw),
  seen: List(Text),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): CkNormalFrame(c, ck_instance_laws(ls, seen, c, i, decl)) {
  match ls: CkNormalFrame(c, ck_instance_laws(ls, seen, c, i, decl)) {
    Nil => normal => normal
    Cons(l, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_laws_unf(l, rest, seen, c, i, decl)),
      inf_law_missing_normal(
        l,
        rest,
        seen,
        c,
        i,
        decl,
        not(law_named(cf_class_laws(decl), cf_law_name(l))),
        ns => next => ck_instance_laws_normal(rest, ns, next, i, decl)
      )
    )
  }
}

pub theorem inf_extra_cons_normal(
  m: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ih: ∀ next: Checker. CkNormalFrame(next, ck_instance_extra(rest, next, i, decl))
): CkNormalFrame(c, inf_extra_cons(m, rest, c, i, decl)) {
  normal_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_extra(rest, c1, i, decl)),
    frame_error_if(
      c,
      cat3(inf_class(i), " has no method ", signature_name(m)),
      cf_method_span(m),
      not(method_names_have(cf_class_methods(decl), signature_name(m)))
    ),
    normal_error_if(
      c,
      cat3(inf_class(i), " has no method ", signature_name(m)),
      cf_method_span(m),
      not(method_names_have(cf_class_methods(decl), signature_name(m)))
    ),
    ignored => c1 => normal_rewrap(c1, ck_instance_extra(rest, c1, i, decl), ih(c1))
  )
}

pub theorem ck_instance_extra_normal(
  ms: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass
): CkNormalFrame(c, ck_instance_extra(ms, c, i, decl)) {
  match ms: CkNormalFrame(c, ck_instance_extra(ms, c, i, decl)) {
    Nil => normal => normal
    Cons(m, rest) => Eq::subst(
      (z: Mut1(Unit, Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_extra_unf(m, rest, c, i, decl)),
      inf_extra_cons_normal(
        m,
        rest,
        c,
        i,
        decl,
        next => ck_instance_extra_normal(rest, next, i, decl)
      )
    )
  }
}

pub theorem inf_same_normal(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  head: Text,
  want: SurfaceFn
): CkNormalFrame(c, inf_same(c, i, got, scheme, expected, head, want)) {
  normal_bind(
    Scheme,
    Unit,
    c,
    (wanted: Scheme, c1: Checker) => frame_error_if(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    ),
    ck_signature(c, want),
    ck_signature_normal(c, want),
    wanted => c1 => normal_error_if(
      c1,
      inf_signature_message(c1, i, expected, head, want, wanted),
      cf_method_span(got),
      inf_signature_diff(wanted, scheme, got, want)
    )
  )
}

pub theorem ck_same_signature_normal(
  c: Checker,
  i: SurfaceInstance,
  got: SurfaceFn,
  scheme: Scheme,
  expected: SurfaceFn,
  param: Text,
  head: Text
): CkNormalFrame(c, ck_same_signature(c, i, got, scheme, expected, param, head)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkNormalFrame(c, z),
    Eq::sym(inf_same_unf(c, i, got, scheme, expected, param, head)),
    inf_same_normal(c, i, got, scheme, expected, head, inf_want(i, got, expected, param))
  )
}

pub theorem inf_method_found_normal(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  made: SurfaceFn,
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkNormalFrame(next, ck_instance_methods(rest, next, i, decl, ctor, shown, fs))
): CkNormalFrame(c, inf_method_found(e, rest, c, i, decl, ctor, shown, out, made)) {
  normal_bind(
    Scheme,
    List(SurfaceFn),
    c,
    (scheme: Scheme, c1: Checker) => frame_bind(
      Unit,
      List(SurfaceFn),
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown)
    ),
    ck_signature(c, made),
    ck_signature_normal(c, made),
    scheme => c1 => normal_bind(
      Unit,
      List(SurfaceFn),
      c1,
      (ignored: Unit, c2: Checker) => ck_rewrap1(
        ck_instance_methods(
          rest,
          cf_store_state(c2, made, scheme),
          i,
          decl,
          ctor,
          shown,
          Cons(made, out)
        )
      ),
      ck_same_signature(c1, i, made, scheme, e, cf_class_param(decl), shown),
      ck_same_signature_normal(c1, i, made, scheme, e, cf_class_param(decl), shown),
      ignored => c2 => normal_changed(
        c2,
        cf_store_state(c2, made, scheme),
        ck_rewrap1(
          ck_instance_methods(
            rest,
            cf_store_state(c2, made, scheme),
            i,
            decl,
            ctor,
            shown,
            Cons(made, out)
          )
        ),
        cf_store_state_context_same(c2, made, scheme),
        normal_rewrap(
          cf_store_state(c2, made, scheme),
          ck_instance_methods(
            rest,
            cf_store_state(c2, made, scheme),
            i,
            decl,
            ctor,
            shown,
            Cons(made, out)
          ),
          ih(cf_store_state(c2, made, scheme), Cons(made, out))
        )
      )
    )
  )
}

pub theorem inf_method_get_normal(
  e: SurfaceFn,
  rest: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn),
  o: Option(SurfaceFn),
  ih: ∀ next: Checker. ∀ fs: List(
    SurfaceFn
  ). CkNormalFrame(next, ck_instance_methods(rest, next, i, decl, ctor, shown, fs))
): CkNormalFrame(c, inf_method_get(e, rest, c, i, decl, ctor, shown, out, o)) {
  match o: CkNormalFrame(c, inf_method_get(e, rest, c, i, decl, ctor, shown, out, o)) {
    None => normal_bind(
      Unit,
      List(SurfaceFn),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(
        ck_instance_methods(rest, c1, i, decl, ctor, shown, out)
      ),
      ck_error(
        c,
        cat5(
          "the instance ",
          inf_class(i),
          cat3("(", shown, ")"),
          " does not define ",
          signature_name(e)
        ),
        inf_span(i)
      ),
      ck_error_normal(
        c,
        cat5(
          "the instance ",
          inf_class(i),
          cat3("(", shown, ")"),
          " does not define ",
          signature_name(e)
        ),
        inf_span(i)
      ),
      ignored => c1 => normal_rewrap(
        c1,
        ck_instance_methods(rest, c1, i, decl, ctor, shown, out),
        ih(c1, out)
      )
    )
    Some(m) => inf_method_found_normal(
      e,
      rest,
      c,
      i,
      decl,
      ctor,
      shown,
      out,
      inf_method_fn(i, ctor, m),
      ih
    )
  }
}

pub theorem ck_instance_methods_normal(
  expected: List(SurfaceFn),
  c: Checker,
  i: SurfaceInstance,
  decl: SurfaceClass,
  ctor: Text,
  shown: Text,
  out: List(SurfaceFn)
): CkNormalFrame(c, ck_instance_methods(expected, c, i, decl, ctor, shown, out)) {
  match expected: CkNormalFrame(c, ck_instance_methods(expected, c, i, decl, ctor, shown, out)) {
    Nil => normal => normal
    Cons(e, rest) => Eq::subst(
      (z: Mut1(List(SurfaceFn), Checker)) => CkNormalFrame(c, z),
      Eq::sym(inf_methods_unf(e, rest, c, i, decl, ctor, shown, out)),
      inf_method_get_normal(
        e,
        rest,
        c,
        i,
        decl,
        ctor,
        shown,
        out,
        method_named(inf_methods(i), signature_name(e)),
        next => fs => ck_instance_methods_normal(rest, next, i, decl, ctor, shown, fs)
      )
    )
  }
}

pub theorem inf_preds_dup_normal(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  g: Text,
  dup: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkNormalFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkNormalFrame(c, inf_preds_dup(w, rest, c, gs, preds, g, dup)) {
  match dup: CkNormalFrame(c, inf_preds_dup(w, rest, c, gs, preds, g, dup)) {
    true => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(
        c,
        cat5(signature_constraint_class(w), "(", g, ") is written twice", ""),
        signature_constraint_span(w)
      ),
      ck_error_normal(
        c,
        cat5(signature_constraint_class(w), "(", g, ") is written twice", ""),
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    false => normal_rewrap(
      c,
      ck_instance_preds(
        rest,
        c,
        gs,
        Cons(Pair { fst: signature_constraint_class(w), snd: g }, preds)
      ),
      ih(c, Cons(Pair { fst: signature_constraint_class(w), snd: g }, preds))
    )
  }
}

pub theorem inf_preds_has_normal(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  g: Text,
  has: Bool,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkNormalFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkNormalFrame(c, inf_preds_has(w, rest, c, gs, preds, g, has)) {
  match has: CkNormalFrame(c, inf_preds_has(w, rest, c, gs, preds, g, has)) {
    true => inf_preds_dup_normal(
      w,
      rest,
      c,
      gs,
      preds,
      g,
      preds_have(preds, signature_constraint_class(w), g),
      ih
    )
    false => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
  }
}

pub theorem inf_preds_kind_normal(
  w: SurfaceConstraint,
  rest: List(SurfaceConstraint),
  c: Checker,
  gs: List(Text),
  preds: List(Pair(Text, Text)),
  k: SurfaceKind,
  ih: ∀ next: Checker. ∀ ps: List(
    Pair(Text, Text)
  ). CkNormalFrame(next, ck_instance_preds(rest, next, gs, ps))
): CkNormalFrame(c, inf_preds_kind(w, rest, c, gs, preds, k)) {
  match k: CkNormalFrame(c, inf_preds_kind(w, rest, c, gs, preds, k)) {
    SkVar(g) => inf_preds_has_normal(w, rest, c, gs, preds, g, text_list_has(gs, g), ih)
    SkNat(digits) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkText(value) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkBool(value) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkApp(head, args) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkPi(params, result, effects) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkExists(binder, domain, body) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkLam(params, body) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkUnion(parts) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkTagged(tag, value) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkIf(cond, then, otherwise) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkField(value, name) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkBlock(stmts) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkPerform(op, args) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkHandle(body, handlers) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkBudget(amount_memory, amount, body) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
      ck_error_normal(
        c,
        "where constrains only generics of the instance",
        signature_constraint_span(w)
      ),
      ignored => c1 => normal_rewrap(c1, ck_instance_preds(rest, c1, gs, preds), ih(c1, preds))
    )
    SkMatch(scrutinee, motive, arms, binder) => normal_bind(
      Unit,
      List(Pair(Text, Text)),
      c,
      (ignored: Unit, c1: Checker) => ck_rewrap1(ck_instance_preds(rest, c1, gs, preds)),
      ck_error(c, "where constrains only generics of the instance", signature_constraint_span(w)),
