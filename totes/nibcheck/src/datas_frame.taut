  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool
): ck_written_kind(
  SkApp(function, arguments),
  c,
  generics,
  span,
  under_borrow
) = frame_written_app(
  c,
  arguments,
  generics,
  span,
  function,
  under_borrow,
  written_nested(function)
) { Refl }

pub theorem frame_unf_SkPi(
  params: List(SurfaceParam),
  result: SurfaceTerm,
  effects: Option(List(Text)),
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool
): ck_written_kind(
  SkPi(params, result, effects),
  c,
  generics,
  span,
  under_borrow
) = frame_written_pi(params, result, c, generics) { Refl }

pub theorem frame_unf_SkFnKind(
  fk: Text,
  ty: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool
): ck_written_kind(
  SkFnKind(fk, ty),
  c,
  generics,
  span,
  under_borrow
) = frame_written_fnkind(fk, ty, c, generics, span) { Refl }

pub theorem frame_unf_SkBorrow(
  mutable: Bool,
  x: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool
): ck_written_kind(
  SkBorrow(mutable, x),
  c,
  generics,
  span,
  under_borrow
) = frame_written_borrow(mutable, x, c, generics) { Refl }

pub theorem frame_unf_SkUnion(
  ts: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool
): ck_written_kind(
  SkUnion(ts),
  c,
  generics,
