theorem frame_unf_SkBool(
  value: Yn,
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Yn
): Eq(
  Mut1(Ty, Checker),
  ck_written_kind(SkBool(value), c, generics, span, under_borrow),
  frame_written_invalid(c, span)
) { refl() }

