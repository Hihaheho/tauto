theorem frame_unf_SkText(
  value: Text,
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Yn
): Eq(
  Mut1(Ty, Checker),
  ck_written_kind(SkText(value), c, generics, span, under_borrow),
