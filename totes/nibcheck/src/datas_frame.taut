import "summary_state.taut"
import std::Base
import std::Map
import std::MapLaws
import std::Text
import "checker.taut"
import "datas.taut"
import "kind_sound.taut"
import "summary_sound.taut"
import "ty.taut"
import "types_decl.taut"
import "unify_sound.taut"
import "../../surface/src/surface.taut"

// Written types preserve the declaration environment and the substitution.
pub fn frame_read_view(
  c: Checker
): Pair(Datas, Ordmap(Nat, Ty)) { Pair { fst: c.datas, snd: c.subst } }
pub fn frame_read_datas(v: Pair(Datas, Ordmap(Nat, Ty))): Datas { v.fst }
pub fn frame_read_subst(v: Pair(Datas, Ordmap(Nat, Ty))): Ordmap(Nat, Ty) { v.snd }

pub def CkReadFrame<A: Type>(
  c: Checker,
  m: Mut1(A, Checker)
): Prop := frame_read_view(ck_st(m)) = frame_read_view(c)

pub fn frame_bind<A, B>(
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker)
): Mut1(B, Checker) {
  ⊢ Mut1(B, Checker) from match m {
    mut1(v, next) => k(v, next)
  }
}

pub theorem frame_bind_ok<A: Type, B: Type>(
  c: Checker,
  k: (A, Checker) -> Mut1(B, Checker),
  m: Mut1(A, Checker),
  hm: CkReadFrame(c, m),
  hk: ∀ v: A. ∀ next: Checker. CkReadFrame(next, k(v, next))
): CkReadFrame(c, frame_bind(k, m)) {
  ⊢ CkReadFrame(c, frame_bind(k, m)) from match m {
    mut1(v, next) => Eq::trans(hk(v, next), hm)
  }
}

pub theorem frame_rewrap<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  h: CkReadFrame(c, m)
): CkReadFrame(c, ck_rewrap1(m)) {
  Eq::subst((z: Mut1(A, Checker)) => CkReadFrame(c, z), Eq::sym(ck_rewrap1_id(m)), h)
}

pub theorem frame_summary<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  frame: CkReadFrame(c, m),
  ok: CkSummaryOk(c)
): CkSummaryOk(ck_st(m)) {
  Eq::subst(SummaryOk, Eq::sym(Eq::congr(frame_read_datas, frame)), ok)
}

pub theorem frame_ordered<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  frame: CkReadFrame(c, m),
  ordered: SummaryOrdered(ck_datas_of(c))
): SummaryOrdered(ck_datas_of(ck_st(m))) {
  Eq::subst(SummaryOrdered, Eq::sym(Eq::congr(frame_read_datas, frame)), ordered)
}

pub theorem ck_error_frame(
  c: Checker,
  message: Text,
  span: TySpan
): CkReadFrame(c, ck_error(c, message, span)) { Refl }
pub theorem ck_fresh_frame(c: Checker): CkReadFrame(c, ck_fresh(c)) { Refl }
pub theorem ck_written_bad_frame(
  c: Checker,
  span: TySpan
): CkReadFrame(c, ck_written_bad(c, span)) { Refl }
pub theorem ck_written_ctor_arity_frame(
  c: Checker,
  n: Text,
  span: TySpan
): CkReadFrame(c, ck_written_ctor_arity(c, n, span)) { Refl }

pub fn frame_arity_small(
  c: Checker,
  n: Text,
  span: TySpan,
  data: Data,
  small: Bool
): Mut1(Unit, Checker) {
  ⊢ Mut1(Unit, Checker) from match small {
    true => ck_rewrap1(
      ck_error(c, cat4(n, " takes ", Text::of_nat(list_len(dgen(data))), " arguments"), span)
    )
    false => mut1(Star, c)
  }
}

pub fn frame_arity_decl(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan,
  o: Option(Data)
): Mut1(Unit, Checker) {
  ⊢ Mut1(Unit, Checker) from match o {
    None => mut1(Star, c)
    Some(data) => frame_arity_small(c, n, span, data, not(Nat::eq(given, list_len(dgen(data)))))
  }
}

pub fn frame_arity_k(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan,
  constructor: Bool
): Mut1(Unit, Checker) {
  ⊢ Mut1(Unit, Checker) from match constructor {
    true => frame_arity_decl(c, n, given, span, datas_decl(ck_datas_of(c), n))
    false => mut1(Star, c)
  }
}
pub fn frame_constructor_position(c: Checker): Bool { c.constructor_position }

pub theorem frame_arity_unf(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan
): ck_arity(
  c,
  n,
  given,
  span
) = frame_arity_k(c, n, given, span, not(frame_constructor_position(c))) { Refl }

pub theorem frame_arity_small_ok(
  c: Checker,
  n: Text,
  span: TySpan,
  data: Data,
  small: Bool
): CkReadFrame(c, frame_arity_small(c, n, span, data, small)) {
  ⊢ CkReadFrame(c, frame_arity_small(c, n, span, data, small)) from match small {
    true => Refl
    false => Refl
  }
}

pub theorem frame_arity_decl_ok(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan,
  o: Option(Data)
): CkReadFrame(c, frame_arity_decl(c, n, given, span, o)) {
  ⊢ CkReadFrame(c, frame_arity_decl(c, n, given, span, o)) from match o {
    None => Refl
    Some(data) => frame_arity_small_ok(c, n, span, data, not(Nat::eq(given, list_len(dgen(data)))))
  }
}

pub theorem frame_arity_k_ok(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan,
  constructor: Bool
): CkReadFrame(c, frame_arity_k(c, n, given, span, constructor)) {
  ⊢ CkReadFrame(c, frame_arity_k(c, n, given, span, constructor)) from match constructor {
    true => frame_arity_decl_ok(c, n, given, span, datas_decl(ck_datas_of(c), n))
    false => Refl
  }
}

pub theorem ck_arity_frame(
  c: Checker,
  n: Text,
  given: Nat,
  span: TySpan
): CkReadFrame(c, ck_arity(c, n, given, span)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkReadFrame(c, z),
    Eq::sym(frame_arity_unf(c, n, given, span)),
    frame_arity_k_ok(c, n, given, span, not(frame_constructor_position(c)))
  )
}

pub fn frame_return<A, B>(v: B, m: Mut1(A, Checker)): Mut1(B, Checker) {
  ⊢ Mut1(B, Checker) from match m {
    mut1(ignored, next) => mut1(v, next)
  }
}

pub theorem frame_return_ok<A: Type, B: Type>(
  c: Checker,
  v: B,
  m: Mut1(A, Checker),
  h: CkReadFrame(c, m)
): CkReadFrame(c, frame_return(v, m)) {
  ⊢ CkReadFrame(c, frame_return(v, m)) from match m {
    mut1(ignored, next) => h
  }
}

pub fn frame_written_var_named(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty,
  found: Bool
): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match found {
    true => mut1(t, c)
    false => frame_return(t, ck_arity(c, n, 0, span))
  }
}

pub fn frame_written_var_k(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  original: Ty,
  t: Ty
): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match t {
    TyNamed(name, args) => frame_written_var_named(
      c,
      n,
      span,
      original,
      Ordmap::contains(generics, n, Ordmap::compare_text)
    )
    TyInt(width) => mut1(original, c)
    TyBool => mut1(original, c)
    TyText => mut1(original, c)
    TyUnit => mut1(original, c)
    TyNever => mut1(original, c)
    TyDecimal => mut1(original, c)
    TyFloat => mut1(original, c)
    TyFn(params, result, kind) => mut1(original, c)
    TyUnion(members) => mut1(original, c)
    TyProduct(members) => mut1(original, c)
    TyTagged(tags, inner) => mut1(original, c)
    TyParam(name, bound) => mut1(original, c)
    TyInfo(inner) => mut1(original, c)
    TyBorrow(inner, mutable) => mut1(original, c)
    TyVar(index) => mut1(original, c)
    TyPoly(generics0, inner) => mut1(original, c)
    TyApp(head, arg) => mut1(original, c)
  }
}

pub theorem frame_written_var_unf(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan
): ck_written_var(
  c,
  n,
  generics,
  span
) = frame_written_var_k(
  c,
  n,
  generics,
  span,
  ck_written_name(n, generics),
  ck_written_name(n, generics)
) { Refl }

pub theorem frame_written_var_named_ok(
  c: Checker,
  n: Text,
  span: TySpan,
  t: Ty,
  found: Bool
): CkReadFrame(c, frame_written_var_named(c, n, span, t, found)) {
  ⊢ CkReadFrame(c, frame_written_var_named(c, n, span, t, found)) from match found {
    true => Refl
    false => frame_return_ok(c, t, ck_arity(c, n, 0, span), ck_arity_frame(c, n, 0, span))
  }
}

pub theorem frame_written_var_k_ok(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  original: Ty,
  t: Ty
): CkReadFrame(c, frame_written_var_k(c, n, generics, span, original, t)) {
  ⊢ CkReadFrame(c, frame_written_var_k(c, n, generics, span, original, t)) from match t {
    TyNamed(name, args) => frame_written_var_named_ok(
      c,
      n,
      span,
      original,
      Ordmap::contains(generics, n, Ordmap::compare_text)
    )
    TyInt(width) => Refl
    TyBool => Refl
    TyText => Refl
    TyUnit => Refl
    TyNever => Refl
    TyDecimal => Refl
    TyFloat => Refl
    TyFn(params, result, kind) => Refl
    TyUnion(members) => Refl
    TyProduct(members) => Refl
    TyTagged(tags, inner) => Refl
    TyParam(name, bound) => Refl
    TyInfo(inner) => Refl
    TyBorrow(inner, mutable) => Refl
    TyVar(index) => Refl
    TyPoly(generics0, inner) => Refl
    TyApp(head, arg) => Refl
  }
}

pub theorem ck_written_var_frame(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan
): CkReadFrame(c, ck_written_var(c, n, generics, span)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
    Eq::sym(frame_written_var_unf(c, n, generics, span)),
    frame_written_var_k_ok(
      c,
      n,
      generics,
      span,
      ck_written_name(n, generics),
      ck_written_name(n, generics)
    )
  )
}

pub theorem ck_written_fn_kind_frame(
  w: Ty,
  c: Checker,
  fk: Text,
  span: TySpan
): CkReadFrame(c, ck_written_fn_kind(w, c, fk, span)) {
  ⊢ CkReadFrame(c, ck_written_fn_kind(w, c, fk, span)) from match w {
    TyFn(ps, r, k) => Refl
    TyInt(width) => Refl
    TyBool => Refl
    TyText => Refl
    TyUnit => Refl
    TyNever => Refl
    TyDecimal => Refl
    TyFloat => Refl
    TyUnion(members) => Refl
    TyProduct(members) => Refl
    TyTagged(tags, inner) => Refl
    TyNamed(name, args) => Refl
    TyParam(name, bound) => Refl
    TyInfo(inner) => Refl
    TyBorrow(inner, mutable) => Refl
    TyVar(index) => Refl
    TyPoly(generics0, inner) => Refl
    TyApp(head, arg) => Refl
  }
}

pub fn frame_set_constructor_position(c: Checker, b: Bool): Checker {
  Checker {
    classes: c.classes,
    instances: c.instances,
    subst: c.subst,
    next: c.next,
    ints: c.ints,
    fns: c.fns,
    effects: c.effects,
    quants: c.quants,
    datas: c.datas,
    errors: c.errors,
    ops: c.ops,
    literals: c.literals,
    returns: c.returns,
    exceeded: c.exceeded,
    lets: c.lets,
    bounds: c.bounds,
    ctor_bounds: c.ctor_bounds,
    constructor_position: b,
    rigids: c.rigids,
    kept: c.kept,
    assume: c.assume,
    pending: c.pending,
    constructor_uses: c.constructor_uses,
    locals: c.locals,
    terms: c.terms,
    closure_results: c.closure_results,
    hint: c.hint,
    under_borrow: c.under_borrow,
    type_params: c.type_params,
    widen_products: c.widen_products,
    steps: c.steps
  }
}
pub theorem frame_set_constructor_position_same(
  c: Checker,
  b: Bool
): frame_read_view(frame_set_constructor_position(c, b)) = frame_read_view(c) { Refl }

pub fn frame_set_under_borrow(c: Checker, b: Bool): Checker {
  Checker {
    classes: c.classes,
    instances: c.instances,
    subst: c.subst,
    next: c.next,
    ints: c.ints,
    fns: c.fns,
    effects: c.effects,
    quants: c.quants,
    datas: c.datas,
    errors: c.errors,
    ops: c.ops,
    literals: c.literals,
    returns: c.returns,
    exceeded: c.exceeded,
    lets: c.lets,
    bounds: c.bounds,
    ctor_bounds: c.ctor_bounds,
    constructor_position: c.constructor_position,
    rigids: c.rigids,
    kept: c.kept,
    assume: c.assume,
    pending: c.pending,
    constructor_uses: c.constructor_uses,
    locals: c.locals,
    terms: c.terms,
    closure_results: c.closure_results,
    hint: c.hint,
    under_borrow: b,
    type_params: c.type_params,
    widen_products: c.widen_products,
    steps: c.steps
  }
}
pub theorem frame_set_under_borrow_same(
  c: Checker,
  b: Bool
): frame_read_view(frame_set_under_borrow(c, b)) = frame_read_view(c) { Refl }

pub fn frame_under_borrow(c: Checker): Bool { c.under_borrow }

pub theorem frame_changed<A: Type>(
  c: Checker,
  next: Checker,
  m: Mut1(A, Checker),
  eq: frame_read_view(next) = frame_read_view(c),
  h: CkReadFrame(next, m)
): CkReadFrame(c, m) {
  Eq::trans(h, eq)
}

pub fn frame_error_if(c: Checker, message: Text, span: TySpan, b: Bool): Mut1(Unit, Checker) {
  ⊢ Mut1(Unit, Checker) from match b {
    true => ck_rewrap1(ck_error(c, message, span))
    false => mut1(Star, c)
  }
}

pub theorem frame_error_if_ok(
  c: Checker,
  message: Text,
  span: TySpan,
  b: Bool
): CkReadFrame(c, frame_error_if(c, message, span, b)) {
  ⊢ CkReadFrame(c, frame_error_if(c, message, span, b)) from match b {
    true => Refl
    false => Refl
  }
}

pub fn frame_app_nested(c: Checker, span: TySpan, after: List(Ty), inner: Ty): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match inner {
    TyNamed(n, before) => frame_return(
      TyNamed(n, List::append(before, after)),
      ck_arity(c, n, list_len(List::append(before, after)), span)
    )
    TyInt(width) => ck_rewrap1(ck_written_bad(c, span))
    TyBool => ck_rewrap1(ck_written_bad(c, span))
    TyText => ck_rewrap1(ck_written_bad(c, span))
    TyUnit => ck_rewrap1(ck_written_bad(c, span))
    TyNever => ck_rewrap1(ck_written_bad(c, span))
    TyDecimal => ck_rewrap1(ck_written_bad(c, span))
    TyFloat => ck_rewrap1(ck_written_bad(c, span))
    TyFn(params, result, kind) => ck_rewrap1(ck_written_bad(c, span))
    TyUnion(members) => ck_rewrap1(ck_written_bad(c, span))
    TyProduct(members) => ck_rewrap1(ck_written_bad(c, span))
    TyTagged(tags, _) => ck_rewrap1(ck_written_bad(c, span))
    TyParam(name, bound) => ck_rewrap1(ck_written_bad(c, span))
    TyInfo(_) => ck_rewrap1(ck_written_bad(c, span))
    TyBorrow(_, mutable) => ck_rewrap1(ck_written_bad(c, span))
    TyVar(index) => ck_rewrap1(ck_written_bad(c, span))
    TyPoly(generics0, _) => ck_rewrap1(ck_written_bad(c, span))
    TyApp(head, arg) => ck_rewrap1(ck_written_bad(c, span))
  }
}

pub theorem frame_app_nested_ok(
  c: Checker,
  span: TySpan,
  after: List(Ty),
  inner: Ty
): CkReadFrame(c, frame_app_nested(c, span, after, inner)) {
  ⊢ CkReadFrame(c, frame_app_nested(c, span, after, inner)) from match inner {
    TyNamed(n, before) => frame_return_ok(
      c,
      TyNamed(n, List::append(before, after)),
      ck_arity(c, n, list_len(List::append(before, after)), span),
      ck_arity_frame(c, n, list_len(List::append(before, after)), span)
    )
    TyInt(width) => Refl
    TyBool => Refl
    TyText => Refl
    TyUnit => Refl
    TyNever => Refl
    TyDecimal => Refl
    TyFloat => Refl
    TyFn(params, result, kind) => Refl
    TyUnion(members) => Refl
    TyProduct(members) => Refl
    TyTagged(tags, _) => Refl
    TyParam(name, bound) => Refl
    TyInfo(_) => Refl
    TyBorrow(_, mutable) => Refl
    TyVar(index) => Refl
    TyPoly(generics0, _) => Refl
    TyApp(head, arg) => Refl
  }
}

pub fn frame_app_info(c: Checker, args: List(Ty)): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match args {
    Nil => mut1(TyUnit, c)
    Cons(a, rest) => mut1(TyInfo(a), c)
  }
}
pub theorem frame_app_info_ok(c: Checker, args: List(Ty)): CkReadFrame(c, frame_app_info(c, args)) {
  ⊢ CkReadFrame(c, frame_app_info(c, args)) from match args {
    Nil => Refl
    Cons(a, rest) => Refl
  }
}
pub fn frame_app_generic(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  args: List(Ty)
): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match args {
    Nil => ck_rewrap1(ck_written_ctor_arity(c, n, span))
    Cons(x, more) => mut1(ty_apply(ck_written_name(n, generics), x), c)
  }
}
pub theorem frame_app_generic_ok(
  c: Checker,
  n: Text,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  args: List(Ty)
): CkReadFrame(c, frame_app_generic(c, n, generics, span, args)) {
  ⊢ CkReadFrame(c, frame_app_generic(c, n, generics, span, args)) from match args {
    Nil => Refl
    Cons(x, more) => Refl
  }
}

pub fn frame_app_generic_count(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  n: Text,
  one: Bool
): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match one {
    true => frame_bind(
      List(Ty),
      Ty,
      (ws: List(Ty), c1: Checker) => frame_app_generic(c1, n, generics, span, ws),
      ck_written_each(arguments, c, generics)
    )
    false => ck_rewrap1(ck_written_ctor_arity(c, n, span))
  }
}
pub theorem frame_app_generic_count_ok(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  n: Text,
  one: Bool,
  iheach: ∀ next: Checker. CkReadFrame(next, ck_written_each(arguments, next, generics))
): CkReadFrame(c, frame_app_generic_count(c, arguments, generics, span, n, one)) {
  ⊢ CkReadFrame(c, frame_app_generic_count(c, arguments, generics, span, n, one)) from match one {
    true => frame_bind_ok(
      List(Ty),
      Ty,
      c,
      (ws: List(Ty), c1: Checker) => frame_app_generic(c1, n, generics, span, ws),
      ck_written_each(arguments, c, generics),
      iheach(c),
      ws => c1 => frame_app_generic_ok(c1, n, generics, span, ws)
    )
    false => frame_rewrap(
      c,
      ck_written_ctor_arity(c, n, span),
      ck_written_ctor_arity_frame(c, n, span)
    )
  }
}

pub fn frame_app_kind(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool,
  app: WrittenApp
): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match app {
    WrittenUnit => mut1(TyUnit, c)
    WrittenInfo => frame_bind(
      List(Ty),
      Ty,
      (ws: List(Ty), c1: Checker) => frame_app_info(c1, ws),
      ck_written_each(arguments, c, generics)
    )
    WrittenNamed(n) => frame_bind(
      Unit,
      Ty,
      (ignored: Unit, c1: Checker) => frame_bind(
        List(Ty),
        Ty,
        (ws: List(Ty), c2: Checker) => frame_return(
          TyNamed(n, ws),
          ck_arity(c2, n, list_len(ws), span)
        ),
        ck_written_each(arguments, c1, generics)
      ),
      frame_error_if(
        c,
        "Slice(A) can only be borrowed",
        span,
        Bool::and(Text::eq(n, "Slice"), not(under_borrow))
      )
    )
    WrittenGeneric(n) => frame_app_generic_count(
      c,
      arguments,
      generics,
      span,
      n,
      Nat::eq(list_len(arguments), 1)
    )
    WrittenBad => ck_rewrap1(ck_written_bad(c, span))
  }
}

pub theorem frame_app_kind_ok(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool,
  app: WrittenApp,
  iheach: ∀ next: Checker. CkReadFrame(next, ck_written_each(arguments, next, generics))
): CkReadFrame(c, frame_app_kind(c, arguments, generics, span, under_borrow, app)) {
  ⊢ CkReadFrame(c, frame_app_kind(c, arguments, generics, span, under_borrow, app)) from match app {
    WrittenUnit => Refl
    WrittenInfo => frame_bind_ok(
      List(Ty),
      Ty,
      c,
      (ws: List(Ty), c1: Checker) => frame_app_info(c1, ws),
      ck_written_each(arguments, c, generics),
      iheach(c),
      ws => c1 => frame_app_info_ok(c1, ws)
    )
    WrittenNamed(n) => frame_bind_ok(
      Unit,
      Ty,
      c,
      (ignored: Unit, c1: Checker) => frame_bind(
        List(Ty),
        Ty,
        (ws: List(Ty), c2: Checker) => frame_return(
          TyNamed(n, ws),
          ck_arity(c2, n, list_len(ws), span)
        ),
        ck_written_each(arguments, c1, generics)
      ),
      frame_error_if(
        c,
        "Slice(A) can only be borrowed",
        span,
        Bool::and(Text::eq(n, "Slice"), not(under_borrow))
      ),
      frame_error_if_ok(
        c,
        "Slice(A) can only be borrowed",
        span,
        Bool::and(Text::eq(n, "Slice"), not(under_borrow))
      ),
      ignored => c1 => frame_bind_ok(
        List(Ty),
        Ty,
        c1,
        (ws: List(Ty), c2: Checker) => frame_return(
          TyNamed(n, ws),
          ck_arity(c2, n, list_len(ws), span)
        ),
        ck_written_each(arguments, c1, generics),
        iheach(c1),
        ws => c2 => frame_return_ok(
          c2,
          TyNamed(n, ws),
          ck_arity(c2, n, list_len(ws), span),
          ck_arity_frame(c2, n, list_len(ws), span)
        )
      )
    )
    WrittenGeneric(n) => frame_app_generic_count_ok(
      c,
      arguments,
      generics,
      span,
      n,
      Nat::eq(list_len(arguments), 1),
      iheach
    )
    WrittenBad => frame_rewrap(c, ck_written_bad(c, span), ck_written_bad_frame(c, span))
  }
}

pub fn frame_written_app(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  function: SurfaceTerm,
  under_borrow: Bool,
  nested: Bool
): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match nested {
    true => frame_bind(
      Ty,
      Ty,
      (before: Ty, c1: Checker) => frame_bind(
        List(Ty),
        Ty,
        (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
        ck_written_each(
          arguments,
          frame_set_constructor_position(c1, frame_constructor_position(c)),
          generics
        )
      ),
      ck_written_in(function, frame_set_constructor_position(c, true), generics)
    )
    false => frame_app_kind(
      c,
      arguments,
      generics,
      span,
      under_borrow,
      written_app(function, list_len(arguments), generics)
    )
  }
}

pub theorem frame_written_app_ok(
  c: Checker,
  arguments: List(SurfaceTerm),
  generics: Ordmap(Text, Ty),
  span: TySpan,
  function: SurfaceTerm,
  under_borrow: Bool,
  nested: Bool,
  ihterm: ∀ next: Checker. CkReadFrame(next, ck_written_in(function, next, generics)),
  iheach: ∀ next: Checker. CkReadFrame(next, ck_written_each(arguments, next, generics))
): CkReadFrame(c, frame_written_app(c, arguments, generics, span, function, under_borrow, nested)) {
  ⊢ CkReadFrame(
    c,
    frame_written_app(c, arguments, generics, span, function, under_borrow, nested)
  ) from match nested {
    true => frame_changed(
      c,
      frame_set_constructor_position(c, true),
      frame_bind(
        Ty,
        Ty,
        (before: Ty, c1: Checker) => frame_bind(
          List(Ty),
          Ty,
          (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
          ck_written_each(
            arguments,
            frame_set_constructor_position(c1, frame_constructor_position(c)),
            generics
          )
        ),
        ck_written_in(function, frame_set_constructor_position(c, true), generics)
      ),
      frame_set_constructor_position_same(c, true),
      frame_bind_ok(
        Ty,
        Ty,
        frame_set_constructor_position(c, true),
        (before: Ty, c1: Checker) => frame_bind(
          List(Ty),
          Ty,
          (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
          ck_written_each(
            arguments,
            frame_set_constructor_position(c1, frame_constructor_position(c)),
            generics
          )
        ),
        ck_written_in(function, frame_set_constructor_position(c, true), generics),
        ihterm(frame_set_constructor_position(c, true)),
        before => c1 => frame_changed(
          c1,
          frame_set_constructor_position(c1, frame_constructor_position(c)),
          frame_bind(
            List(Ty),
            Ty,
            (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
            ck_written_each(
              arguments,
              frame_set_constructor_position(c1, frame_constructor_position(c)),
              generics
            )
          ),
          frame_set_constructor_position_same(c1, frame_constructor_position(c)),
          frame_bind_ok(
            List(Ty),
            Ty,
            frame_set_constructor_position(c1, frame_constructor_position(c)),
            (after: List(Ty), c2: Checker) => frame_app_nested(c2, span, after, before),
            ck_written_each(
              arguments,
              frame_set_constructor_position(c1, frame_constructor_position(c)),
              generics
            ),
            iheach(frame_set_constructor_position(c1, frame_constructor_position(c))),
            after => c2 => frame_app_nested_ok(c2, span, after, before)
          )
        )
      )
    )
    false => frame_app_kind_ok(
      c,
      arguments,
      generics,
      span,
      under_borrow,
      written_app(function, list_len(arguments), generics),
      iheach
    )
  }
}

pub fn frame_pi_binders(
  params: List(SurfaceParam)
): List(Pair(Text, Kind)) { pi_binders(params).fst }
pub fn frame_pi_generics(
  params: List(SurfaceParam),
  generics: Ordmap(Text, Ty)
): Ordmap(Text, Ty) { binders_map(frame_pi_binders(params), generics) }

pub fn frame_written_each_cons(
  t: SurfaceTerm,
  rest: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty)
): Mut1(List(Ty), Checker) {
  frame_bind(
    Ty,
    List(Ty),
    (head: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_written_each(rest, c1, generics)
    ),
    ck_written_in(t, c, generics)
  )
}

pub theorem frame_written_each_cons_ok(
  t: SurfaceTerm,
  rest: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  iht: ∀ next: Checker. CkReadFrame(next, ck_written_in(t, next, generics)),
  ihr: ∀ next: Checker. CkReadFrame(next, ck_written_each(rest, next, generics))
): CkReadFrame(c, frame_written_each_cons(t, rest, c, generics)) {
  frame_bind_ok(
    Ty,
    List(Ty),
    c,
    (head: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_written_each(rest, c1, generics)
    ),
    ck_written_in(t, c, generics),
    iht(c),
    head => c1 => frame_bind_ok(
      List(Ty),
      List(Ty),
      c1,
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_written_each(rest, c1, generics),
      ihr(c1),
      tail => c2 => Refl
    )
  )
}

pub theorem frame_written_each_unf(
  t: SurfaceTerm,
  rest: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty)
): ck_written_each(
  Cons(t, rest),
  c,
  generics
) = frame_written_each_cons(t, rest, c, generics) { Refl }

pub fn frame_written_params_cons(
  p: SurfaceParam,
  rest: List(SurfaceParam),
  c: Checker,
  generics: Ordmap(Text, Ty),
  skip: Nat
): Mut1(List(Ty), Checker) {
  ⊢ Mut1(List(Ty), Checker) from match skip {
    Zero => frame_bind(
      Ty,
      List(Ty),
      (head: Ty, c1: Checker) => frame_bind(
        List(Ty),
        List(Ty),
        (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
        ck_written_params(rest, c1, generics, 0)
      ),
      ck_written_param(p, c, generics)
    )
    Succ(n) => ck_rewrap1(ck_written_params(rest, c, generics, n))
  }
}

pub theorem frame_written_params_cons_ok(
  p: SurfaceParam,
  rest: List(SurfaceParam),
  c: Checker,
  generics: Ordmap(Text, Ty),
  skip: Nat,
  ihp: ∀ next: Checker. CkReadFrame(next, ck_written_param(p, next, generics)),
  ihr: ∀ next: Checker. ∀ count: Nat. CkReadFrame(
    next,
    ck_written_params(rest, next, generics, count)
  )
): CkReadFrame(c, frame_written_params_cons(p, rest, c, generics, skip)) {
  ⊢ CkReadFrame(c, frame_written_params_cons(p, rest, c, generics, skip)) from match skip {
    Zero => frame_bind_ok(
      Ty,
      List(Ty),
      c,
      (head: Ty, c1: Checker) => frame_bind(
        List(Ty),
        List(Ty),
        (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
        ck_written_params(rest, c1, generics, 0)
      ),
      ck_written_param(p, c, generics),
      ihp(c),
      head => c1 => frame_bind_ok(
        List(Ty),
        List(Ty),
        c1,
        (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
        ck_written_params(rest, c1, generics, 0),
        ihr(c1, 0),
        tail => c2 => Refl
      )
    )
    Succ(n) => frame_rewrap(c, ck_written_params(rest, c, generics, n), ihr(c, n))
  }
}

pub theorem frame_written_params_unf(
  p: SurfaceParam,
  rest: List(SurfaceParam),
  c: Checker,
  generics: Ordmap(Text, Ty),
  skip: Nat
): ck_written_params(
  Cons(p, rest),
  c,
  generics,
  skip
) = frame_written_params_cons(p, rest, c, generics, skip) { Refl }

pub fn frame_written_pi(
  params: List(SurfaceParam),
  result: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty)
): Mut1(Ty, Checker) {
  frame_bind(
    List(Ty),
    Ty,
    (ps: List(Ty), c1: Checker) => frame_bind(
      Ty,
      Ty,
      (r: Ty, c2: Checker) => mut1(
        ty_poly_of(frame_pi_binders(params), TyFn(ps, r, KindShared)),
        c2
      ),
      ck_written_in(result, c1, frame_pi_generics(params, generics))
    ),
    ck_written_params(
      params,
      c,
      frame_pi_generics(params, generics),
      list_len(frame_pi_binders(params))
    )
  )
}

pub theorem frame_written_pi_ok(
  params: List(SurfaceParam),
  result: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  ihps: ∀ next: Checker. CkReadFrame(
    next,
    ck_written_params(
      params,
      next,
      frame_pi_generics(params, generics),
      list_len(frame_pi_binders(params))
    )
  ),
  ihr: ∀ next: Checker. CkReadFrame(
    next,
    ck_written_in(result, next, frame_pi_generics(params, generics))
  )
): CkReadFrame(c, frame_written_pi(params, result, c, generics)) {
  frame_bind_ok(
    List(Ty),
    Ty,
    c,
    (ps: List(Ty), c1: Checker) => frame_bind(
      Ty,
      Ty,
      (r: Ty, c2: Checker) => mut1(
        ty_poly_of(frame_pi_binders(params), TyFn(ps, r, KindShared)),
        c2
      ),
      ck_written_in(result, c1, frame_pi_generics(params, generics))
    ),
    ck_written_params(
      params,
      c,
      frame_pi_generics(params, generics),
      list_len(frame_pi_binders(params))
    ),
    ihps(c),
    ps => c1 => frame_bind_ok(
      Ty,
      Ty,
      c1,
      (r: Ty, c2: Checker) => mut1(
        ty_poly_of(frame_pi_binders(params), TyFn(ps, r, KindShared)),
        c2
      ),
      ck_written_in(result, c1, frame_pi_generics(params, generics)),
      ihr(c1),
      r => c2 => Refl
    )
  )
}

pub fn frame_written_fnkind(
  fk: Text,
  ty: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan
): Mut1(Ty, Checker) {
  frame_bind(
    Ty,
    Ty,
    (w: Ty, c1: Checker) => ck_rewrap1(ck_written_fn_kind(w, c1, fk, span)),
    ck_written_in(ty, c, generics)
  )
}

pub theorem frame_written_fnkind_ok(
  fk: Text,
  ty: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  ih: ∀ next: Checker. CkReadFrame(next, ck_written_in(ty, next, generics))
): CkReadFrame(c, frame_written_fnkind(fk, ty, c, generics, span)) {
  frame_bind_ok(
    Ty,
    Ty,
    c,
    (w: Ty, c1: Checker) => ck_rewrap1(ck_written_fn_kind(w, c1, fk, span)),
    ck_written_in(ty, c, generics),
    ih(c),
    w => c1 => frame_rewrap(
      c1,
      ck_written_fn_kind(w, c1, fk, span),
      ck_written_fn_kind_frame(w, c1, fk, span)
    )
  )
}

pub fn frame_written_borrow(
  mutable: Bool,
  x: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty)
): Mut1(Ty, Checker) {
  frame_bind(
    Ty,
    Ty,
    (w: Ty, c1: Checker) => mut1(TyBorrow(w, mutable), c1),
    ck_written_in(x, frame_set_under_borrow(c, true), generics)
  )
}

pub theorem frame_written_borrow_ok(
  mutable: Bool,
  x: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkReadFrame(next, ck_written_in(x, next, generics))
): CkReadFrame(c, frame_written_borrow(mutable, x, c, generics)) {
  frame_changed(
    c,
    frame_set_under_borrow(c, true),
    frame_bind(
      Ty,
      Ty,
      (w: Ty, c1: Checker) => mut1(TyBorrow(w, mutable), c1),
      ck_written_in(x, frame_set_under_borrow(c, true), generics)
    ),
    frame_set_under_borrow_same(c, true),
    frame_bind_ok(
      Ty,
      Ty,
      frame_set_under_borrow(c, true),
      (w: Ty, c1: Checker) => mut1(TyBorrow(w, mutable), c1),
      ck_written_in(x, frame_set_under_borrow(c, true), generics),
      ih(frame_set_under_borrow(c, true)),
      w => c1 => Refl
    )
  )
}

pub fn frame_written_union(
  ts: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty)
): Mut1(Ty, Checker) {
  frame_bind(
    List(Ty),
    Ty,
    (w: List(Ty), c1: Checker) => mut1(ty_union(w), c1),
    ck_written_each(ts, c, generics)
  )
}

pub fn frame_written_product(
  ts: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty)
): Mut1(Ty, Checker) {
  frame_bind(
    List(Ty),
    Ty,
    (w: List(Ty), c1: Checker) => mut1(ty_product(w), c1),
    ck_written_each(ts, c, generics)
  )
}

pub theorem frame_written_union_ok(
  ts: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkReadFrame(next, ck_written_each(ts, next, generics))
): CkReadFrame(c, frame_written_union(ts, c, generics)) {
  frame_bind_ok(
    List(Ty),
    Ty,
    c,
    (w: List(Ty), c1: Checker) => mut1(ty_union(w), c1),
    ck_written_each(ts, c, generics),
    ih(c),
    w => c1 => Refl
  )
}

pub theorem frame_written_product_ok(
  ts: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkReadFrame(next, ck_written_each(ts, next, generics))
): CkReadFrame(c, frame_written_product(ts, c, generics)) {
  frame_bind_ok(
    List(Ty),
    Ty,
    c,
    (w: List(Ty), c1: Checker) => mut1(ty_product(w), c1),
    ck_written_each(ts, c, generics),
    ih(c),
    w => c1 => Refl
  )
}

pub fn frame_written_tagged(
  tag: Text,
  x: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty)
): Mut1(Ty, Checker) {
  frame_bind(
    Ty,
    Ty,
    (w: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), w), c1),
    ck_written_in(x, c, generics)
  )
}

pub theorem frame_written_tagged_ok(
  tag: Text,
  x: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkReadFrame(next, ck_written_in(x, next, generics))
): CkReadFrame(c, frame_written_tagged(tag, x, c, generics)) {
  frame_bind_ok(
    Ty,
    Ty,
    c,
    (w: Ty, c1: Checker) => mut1(ty_tagged(Cons(tag, Nil), w), c1),
    ck_written_in(x, c, generics),
    ih(c),
    w => c1 => Refl
  )
}

pub fn frame_written_invalid(&mut c: Checker, span: TySpan): Ty {
  ck_error(&mut c, "not a type of a program", span)
  ck_fresh(&mut c)
}

pub fn frame_written_kind_k(
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool,
  sk: SurfaceKind
): Mut1(Ty, Checker) {
  ⊢ Mut1(Ty, Checker) from match sk {
    SkVar(n) => ck_rewrap1(ck_written_var(c, n, generics, span))
    SkApp(function, arguments) => frame_written_app(
      c,
      arguments,
      generics,
      span,
      function,
      under_borrow,
      written_nested(function)
    )
    SkPi(params, result, effects) => frame_written_pi(params, result, c, generics)
    SkFnKind(fk, ty) => frame_written_fnkind(fk, ty, c, generics, span)
    SkBorrow(mutable, x) => frame_written_borrow(mutable, x, c, generics)
    SkUnion(ts) => frame_written_union(ts, c, generics)
    SkProduct(ts) => frame_written_product(ts, c, generics)
    SkTagged(tag, x) => frame_written_tagged(tag, x, c, generics)
    SkNat(digits) => frame_written_invalid(c, span)
    SkText(value) => frame_written_invalid(c, span)
    SkBool(value) => frame_written_invalid(c, span)
    SkExists(binder, domain, body) => frame_written_invalid(c, span)
    SkLam(params, body) => frame_written_invalid(c, span)
    SkIf(cond, then, otherwise) => frame_written_invalid(c, span)
    SkField(value, name) => frame_written_invalid(c, span)
    SkBlock(stmts) => frame_written_invalid(c, span)
    SkPerform(op, args) => frame_written_invalid(c, span)
    SkHandle(body, handlers) => frame_written_invalid(c, span)
    SkBudget(amount_memory, amount, body) => frame_written_invalid(c, span)
    SkMatch(scrutinee, motive, arms, binder) => frame_written_invalid(c, span)
    SkHole(name) => frame_written_invalid(c, span)
    SkRecord(name, fields) => frame_written_invalid(c, span)
    SkBorrowLam(borrows, lam) => frame_written_invalid(c, span)
    SkOther(what) => frame_written_invalid(c, span)
    SkRow(what_effects) => frame_written_invalid(c, span)
    SkFloat(what) => frame_written_invalid(c, span)
    SkProject(what, what_ty) => frame_written_invalid(c, span)
    SkMacroCall(name, arg) => frame_written_invalid(c, span)
    SkQuote(stmts_form, stmts) => frame_written_invalid(c, span)
    SkSplice(value) => frame_written_invalid(c, span)
    SkSyntaxLit(name, body) => frame_written_invalid(c, span)
    SkStep(tactic, arg, call_start, call_end, before, arms) => frame_written_invalid(c, span)
  }
}

pub theorem frame_unf_SkVar(
  n: Text,
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Bool
): ck_written_kind(
  SkVar(n),
  c,
  generics,
  span,
  under_borrow
) = ck_rewrap1(ck_written_var(c, n, generics, span)) { Refl }

