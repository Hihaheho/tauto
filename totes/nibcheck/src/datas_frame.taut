  function: SurfaceTerm,
  arguments: List(SurfaceTerm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Yn
): Eq(
  Mut1(Ty, Checker),
  ck_written_kind(SkApp(function, arguments), c, generics, span, under_borrow),
  frame_written_app(c, arguments, generics, span, function, under_borrow, written_nested(function))
) { refl() }

