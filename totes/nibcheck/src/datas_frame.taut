theorem frame_unf_SkStep(
  tactic: Text,
  arg: SurfaceTerm,
  call_start: Nat,
  call_end: Nat,
  before: Option(SurfaceTerm),
  arms: List(SurfaceStepArm),
  c: Checker,
  generics: Ordmap(Text, Ty),
  span: TySpan,
  under_borrow: Yn
): Eq(
  Mut1(Ty, Checker),
  ck_written_kind(
    SkStep(tactic, arg, call_start, call_end, before, arms),
    c,
    generics,
    span,
    under_borrow
  ),
  frame_written_invalid(c, span)
) { refl() }

theorem frame_written_in_unf(
  sk: SurfaceKind,
  start: Nat,
  end: Nat,
  c: Checker,
  generics: Ordmap(Text, Ty)
): Eq(
  Mut1(Ty, Checker),
  ck_written_in(surface_term_mk(sk, start, end), c, generics),
  ck_rewrap1(
    ck_written_kind(
      sk,
      frame_set_under_borrow(c, no),
      generics,
      TySpan { start: start, end: end },
      frame_under_borrow(c)
    )
  )
) { refl() }
theorem frame_written_param_unf(
  name: Option(Text),
  ty: SurfaceTerm,
  c: Checker,
  generics: Ordmap(Text, Ty)
): Eq(
  Mut1(Ty, Checker),
  ck_written_param(surface_param_mk(name, ty), c, generics),
  ck_rewrap1(ck_written_in(ty, c, generics))
) { refl() }

mutual {
  theorem ck_written_in_frame(
    t: SurfaceTerm,
    c: Checker,
    generics: Ordmap(Text, Ty)
  ): CkReadFrame(c, ck_written_in(t, c, generics)) {
    match t -> CkReadFrame(c, ck_written_in(t, c, generics)) {
      surface_term_mk(
        sk,
        start,
        end
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_written_in_unf(sk, start, end, c, generics)),
        frame_rewrap(
          c,
          ck_written_kind(
            sk,
            frame_set_under_borrow(c, no),
            generics,
            TySpan { start: start, end: end },
            frame_under_borrow(c)
          ),
          frame_changed(
            c,
            frame_set_under_borrow(c, no),
            ck_written_kind(
              sk,
              frame_set_under_borrow(c, no),
              generics,
              TySpan { start: start, end: end },
              frame_under_borrow(c)
            ),
            frame_set_under_borrow_same(c, no),
            ck_written_kind_frame(
              sk,
              frame_set_under_borrow(c, no),
              generics,
              TySpan { start: start, end: end },
              frame_under_borrow(c)
            )
          )
        )
      )
    }
  }
  theorem ck_written_kind_frame(
    sk: SurfaceKind,
    c: Checker,
    generics: Ordmap(Text, Ty),
    span: TySpan,
    under_borrow: Yn
  ): CkReadFrame(c, ck_written_kind(sk, c, generics, span, under_borrow)) {
    match sk -> CkReadFrame(c, ck_written_kind(sk, c, generics, span, under_borrow)) {
      SkVar(
        n
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkVar(n, c, generics, span, under_borrow)),
        frame_rewrap(
          c,
          ck_written_var(c, n, generics, span),
          ck_written_var_frame(c, n, generics, span)
        )
      )
      SkApp(
        function,
        arguments
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkApp(function, arguments, c, generics, span, under_borrow)),
        frame_written_app_ok(
          c,
          arguments,
          generics,
          span,
          function,
          under_borrow,
          written_nested(function),
          next => ck_written_in_frame(function, next, generics),
          next => ck_written_each_frame(arguments, next, generics)
        )
      )
      SkPi(
        params,
        result,
        effects
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkPi(params, result, effects, c, generics, span, under_borrow)),
        frame_written_pi_ok(
          params,
          result,
          c,
          generics,
          next => ck_written_params_frame(
            params,
            next,
            frame_pi_generics(params, generics),
            list_len(frame_pi_binders(params))
          ),
          next => ck_written_in_frame(result, next, frame_pi_generics(params, generics))
        )
      )
      SkFnKind(
        fk,
        ty
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkFnKind(fk, ty, c, generics, span, under_borrow)),
        frame_written_fnkind_ok(
          fk,
          ty,
          c,
          generics,
          span,
          next => ck_written_in_frame(ty, next, generics)
        )
      )
      SkBorrow(
        mutable,
        x
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkBorrow(mutable, x, c, generics, span, under_borrow)),
        frame_written_borrow_ok(
          mutable,
          x,
          c,
          generics,
          next => ck_written_in_frame(x, next, generics)
        )
      )
      SkUnion(
        ts
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkUnion(ts, c, generics, span, under_borrow)),
        frame_written_union_ok(ts, c, generics, next => ck_written_each_frame(ts, next, generics))
      )
      SkTagged(
        tag,
        x
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkTagged(tag, x, c, generics, span, under_borrow)),
        frame_written_tagged_ok(tag, x, c, generics, next => ck_written_in_frame(x, next, generics))
      )
      SkNat(
        digits
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkNat(digits, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkText(
        value
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkText(value, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkBool(
        value
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkBool(value, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkExists(
        binder,
        domain,
        body
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkExists(binder, domain, body, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkLam(
        params,
        body
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkLam(params, body, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkIf(
        cond,
        then,
        otherwise
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkIf(cond, then, otherwise, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkField(
        value,
        name
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkField(value, name, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkBlock(
        stmts
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkBlock(stmts, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkPerform(
        op,
        args
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkPerform(op, args, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkHandle(
        body,
        handlers
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkHandle(body, handlers, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkBudget(
        amount,
        body
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkBudget(amount, body, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkMatch(
        scrutinee,
        motive,
        arms,
        binder
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkMatch(scrutinee, motive, arms, binder, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkHole(
        name
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkHole(name, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkRecord(
        name,
        fields
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkRecord(name, fields, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkBorrowLam(
        borrows,
        lam
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkBorrowLam(borrows, lam, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkOther(
        what
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkOther(what, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkMacroCall(
        name,
        arg
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkMacroCall(name, arg, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkQuote(
        stmts_form,
        stmts
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkQuote(stmts_form, stmts, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkSplice(
        value
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkSplice(value, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkSyntaxLit(
        name,
        body
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_unf_SkSyntaxLit(name, body, c, generics, span, under_borrow)),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
      SkStep(
        tactic,
        arg,
        call_start,
        call_end,
        before,
        arms
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(
          frame_unf_SkStep(
            tactic,
            arg,
            call_start,
            call_end,
            before,
            arms,
            c,
            generics,
            span,
            under_borrow
          )
        ),
        refl(Pair(Datas, Ordmap(Nat, Ty)), frame_read_view(c))
      )
    }
  }
  theorem ck_written_each_frame(
    ts: List(SurfaceTerm),
    c: Checker,
    generics: Ordmap(Text, Ty)
  ): CkReadFrame(c, ck_written_each(ts, c, generics)) {
    match ts -> CkReadFrame(c, ck_written_each(ts, c, generics)) {
      Nil => refl()
      Cons(
        t,
        rest
      ) => Eq_subst(
        (z: Mut1(List(Ty), Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_written_each_unf(t, rest, c, generics)),
        frame_written_each_cons_ok(
          t,
          rest,
          c,
          generics,
          next => ck_written_in_frame(t, next, generics),
          next => ck_written_each_frame(rest, next, generics)
        )
      )
    }
  }
  theorem ck_written_params_frame(
    ps: List(SurfaceParam),
    c: Checker,
    generics: Ordmap(Text, Ty),
    skip: Nat
  ): CkReadFrame(c, ck_written_params(ps, c, generics, skip)) {
    match ps -> CkReadFrame(c, ck_written_params(ps, c, generics, skip)) {
      Nil => refl()
      Cons(
        p,
        rest
      ) => Eq_subst(
        (z: Mut1(List(Ty), Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_written_params_unf(p, rest, c, generics, skip)),
        frame_written_params_cons_ok(
          p,
          rest,
          c,
          generics,
          skip,
          next => ck_written_param_frame(p, next, generics),
          next => count => ck_written_params_frame(rest, next, generics, count)
        )
      )
    }
  }
  theorem ck_written_param_frame(
    p: SurfaceParam,
    c: Checker,
    generics: Ordmap(Text, Ty)
  ): CkReadFrame(c, ck_written_param(p, c, generics)) {
    match p -> CkReadFrame(c, ck_written_param(p, c, generics)) {
      surface_param_mk(
        name,
        ty
      ) => Eq_subst(
        (z: Mut1(Ty, Checker)) => CkReadFrame(c, z),
        Eq_sym(frame_written_param_unf(name, ty, c, generics)),
        frame_rewrap(c, ck_written_in(ty, c, generics), ck_written_in_frame(ty, c, generics))
      )
    }
  }
}
theorem ck_written_frame(
  c: Checker,
  t: SurfaceTerm,
  generics: Ordmap(Text, Ty)
): CkReadFrame(c, ck_written(c, t, generics)) {
  frame_rewrap(c, ck_written_in(t, c, generics), ck_written_in_frame(t, c, generics))
}

theorem frame_subst_ordered<A: Type>(
  c: Checker,
  m: Mut1(A, Checker),
  frame: CkReadFrame(c, m),
  ordered: CkOrdered(c)
): CkOrdered(ck_st(m)) {
  Eq_subst(
    (s: Ordmap(Nat, Ty)) => ordmap_ordered(s, ordmap_compare_nat),
    Eq_sym(Eq_congr(frame_read_subst, frame)),
    ordered
  )
}
