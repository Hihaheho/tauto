pub theorem ck_effect_param_frame_context(
  c: Checker,
  e: SurfaceEffect,
  p: Option(SurfaceTerm),
  generics: Ordmap(Text, Ty)
): CkContextFrame(c, ck_effect_param(c, e, p, generics)) {
  match p: CkContextFrame(c, ck_effect_param(c, e, p, generics)) {
    None => (ordinary => Refl)
    Some(x) => context_rewrap(
      c,
      ck_written(c, x, generics),
      ck_written_frame_context(c, x, generics)
    )
  }
}

pub theorem registration_effect_params_cons_ok_context(
  p: Option(SurfaceTerm),
  rest: List(Option(SurfaceTerm)),
  c: Checker,
  e: SurfaceEffect,
  generics: Ordmap(Text, Ty),
  ih: ∀ next: Checker. CkContextFrame(next, ck_effect_params(rest, next, e, generics))
): CkContextFrame(c, registration_effect_params_cons(p, rest, c, e, generics)) {
  context_bind(
    Ty,
    List(Ty),
    c,
    (head: Ty, c1: Checker) => frame_bind(
      List(Ty),
      List(Ty),
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_effect_params(rest, c1, e, generics)
    ),
    ck_effect_param(c, e, p, generics),
    ck_effect_param_frame_context(c, e, p, generics),
    head => c1 => context_bind(
      List(Ty),
      List(Ty),
      c1,
      (tail: List(Ty), c2: Checker) => mut1(Cons(head, tail), c2),
      ck_effect_params(rest, c1, e, generics),
      ih(c1),
      tail => c2 => (ordinary => Refl)
    )
  )
}

pub theorem ck_effect_params_frame_context(
  ps: List(Option(SurfaceTerm)),
  c: Checker,
  e: SurfaceEffect,
  generics: Ordmap(Text, Ty)
): CkContextFrame(c, ck_effect_params(ps, c, e, generics)) {
  match ps: CkContextFrame(c, ck_effect_params(ps, c, e, generics)) {
    Nil => (ordinary => Refl)
    Cons(p, rest) => Eq::subst(
      (z: Mut1(List(Ty), Checker)) => CkContextFrame(c, z),
      Eq::sym(registration_effect_params_unf(p, rest, c, e, generics)),
      registration_effect_params_cons_ok_context(
        p,
        rest,
        c,
        e,
        generics,
        next => ck_effect_params_frame_context(rest, next, e, generics)
      )
    )
  }
}

pub theorem registration_quant_parsed_frame_context(
  c: Checker,
  e: SurfaceEffect,
  q: Text,
  o: Option(Quant)
): CkContextFrame(c, registration_quant_parsed(c, e, q, o)) {
  match o: CkContextFrame(c, registration_quant_parsed(c, e, q, o)) {
    Some(x) => (ordinary => Refl)
    None => (ordinary => Refl)
  }
}

pub theorem registration_quant_resume_frame_context(
  c: Checker,
  e: SurfaceEffect,
  r#resume: Option(Text)
): CkContextFrame(c, registration_quant_resume(c, e, r#resume)) {
  match r#resume: CkContextFrame(c, registration_quant_resume(c, e, r#resume)) {
    None => (ordinary => Refl)
    Some(q) => registration_quant_parsed_frame_context(c, e, q, quant_parse(q))
  }
}

pub theorem ck_effect_quant_frame_context(
  c: Checker,
  e: SurfaceEffect
): CkContextFrame(c, ck_effect_quant(c, e)) {
  Eq::subst(
    (z: Mut1(Quant, Checker)) => CkContextFrame(c, z),
    Eq::sym(registration_quant_unf(c, e)),
    registration_quant_resume_frame_context(c, e, registration_effect_resume(e))
  )
}

pub theorem registration_effect_result_frame_context(
  c: Checker,
  generics: Ordmap(Text, Ty),
  o: Option(SurfaceTerm)
): CkContextFrame(c, registration_effect_result_k(c, generics, o)) {
  match o: CkContextFrame(c, registration_effect_result_k(c, generics, o)) {
    None => (ordinary => Refl)
    Some(r) => context_rewrap(
      c,
      ck_written(c, r, generics),
      ck_written_frame_context(c, r, generics)
    )
  }
}

pub theorem ck_effect_result_frame_context(
  c: Checker,
  e: SurfaceEffect,
  generics: Ordmap(Text, Ty)
): CkContextFrame(c, ck_effect_result(c, e, generics)) {
  Eq::subst(
    (z: Mut1(Ty, Checker)) => CkContextFrame(c, z),
    Eq::sym(registration_effect_result_unf(c, e, generics)),
    registration_effect_result_frame_context(c, generics, registration_effect_result(e))
  )
}

pub theorem registration_effect_store_frame_context(
  c: Checker,
  e: SurfaceEffect,
  params: List(Ty),
  result: Ty,
  quant: Quant
): CkContextFrame(c, registration_effect_store(c, e, params, result, quant)) {
  (ordinary => Refl)
}

pub theorem registration_effect_declare_frame_context(
  c: Checker,
  e: SurfaceEffect
): CkContextFrame(c, registration_effect_declare(c, e)) {
  context_bind(
    List(Ty),
    Unit,
    c,
    (params: List(Ty), c1: Checker) => frame_bind(
      Ty,
      Unit,
      (result: Ty, c2: Checker) => frame_bind(
        Quant,
        Unit,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e)
      ),
      ck_effect_result(c1, e, ck_named_generics(registration_effect_generics(e), Ordmap::empty()))
    ),
    ck_effect_params(
      registration_effect_params(e),
      c,
      e,
      ck_named_generics(registration_effect_generics(e), Ordmap::empty())
    ),
    ck_effect_params_frame_context(
      registration_effect_params(e),
      c,
      e,
      ck_named_generics(registration_effect_generics(e), Ordmap::empty())
    ),
    params => c1 => context_bind(
      Ty,
      Unit,
      c1,
      (result: Ty, c2: Checker) => frame_bind(
        Quant,
        Unit,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e)
      ),
      ck_effect_result(c1, e, ck_named_generics(registration_effect_generics(e), Ordmap::empty())),
      ck_effect_result_frame_context(
        c1,
        e,
        ck_named_generics(registration_effect_generics(e), Ordmap::empty())
      ),
      result => c2 => context_bind(
        Quant,
        Unit,
        c2,
        (quant: Quant, c3: Checker) => registration_effect_store(c3, e, params, result, quant),
        ck_effect_quant(c2, e),
        ck_effect_quant_frame_context(c2, e),
        quant => c3 => registration_effect_store_frame_context(c3, e, params, result, quant)
      )
    )
  )
}

pub theorem ck_declare_effect_frame_context(
  c: Checker,
  e: SurfaceEffect
): CkContextFrame(c, ck_declare_effect(c, e)) {
  Eq::subst(
    (z: Mut1(Unit, Checker)) => CkContextFrame(c, z),
    Eq::sym(registration_effect_declare_unf(c, e)),
    registration_effect_declare_frame_context(c, e)
  )
}

pub theorem registration_ctor_state_context(
  c: Checker,
  ctor: DataCtor,
  dname: Text,
  i: Nat
): written_context(registration_ctor_state(c, ctor, dname, i)) = written_context(c) { Refl }
pub theorem ck_register_ctors_context(
  ctors: List(DataCtor),
  c: Checker,
  dname: Text,
  is_struct: Bool,
  i: Nat
): CkContextFrame(c, ck_register_ctors(ctors, c, dname, i)) {
  match ctors: CkContextFrame(c, ck_register_ctors(ctors, c, dname, i)) {
    Nil => ordinary => Refl
    Cons(ctor, rest) => Eq::subst(
      (m: Mut1(Unit, Checker)) => CkContextFrame(c, m),
      Eq::sym(registration_register_unf(ctor, rest, c, dname, i)),
      context_changed(
        c,
        registration_ctor_state(c, ctor, dname, i),
        ck_rewrap1(
          ck_register_ctors(rest, registration_ctor_state(c, ctor, dname, i), dname, i + 1)
        ),
        registration_ctor_state_context(c, ctor, dname, i),
        context_rewrap(
          registration_ctor_state(c, ctor, dname, i),
          ck_register_ctors(rest, registration_ctor_state(c, ctor, dname, i), dname, i + 1),
          ck_register_ctors_context(
            rest,
            registration_ctor_state(c, ctor, dname, i),
            dname,
            is_struct,
            i + 1
          )
        )
      )
    )
  }
}
pub theorem registration_insert_context(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool,
  constructors: List(DataCtor)
): CkContextFrame(
  c,
  registration_insert(c, d, is_struct, builtin, constructors)
) { ordinary => Refl }
pub theorem registration_declare_context(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool
): CkContextFrame(c, registration_declare(c, d, is_struct, builtin)) {
  context_bind(
    Unit,
    Unit,
    c,
    (ignored: Unit, c1: Checker) => frame_bind(
      List(DataCtor),
      Unit,
      (constructors: List(DataCtor), c2: Checker) => frame_bind(
        Unit,
        Unit,
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0)
      ),
      ck_data_ctors(
        registration_ctors(d),
        c1,
        ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
      )
    ),
    frame_error_if(
      c,
      "a view struct has no fields: it is an opaque type",
      registration_span(d),
      Bool::and(
        surface_data_is_view(d),
        Bool::or(not(is_struct), ctors_have_fields(registration_ctors(d)))
      )
    ),
    frame_error_if_ok_context(
      c,
      "a view struct has no fields: it is an opaque type",
      registration_span(d),
      Bool::and(
        surface_data_is_view(d),
        Bool::or(not(is_struct), ctors_have_fields(registration_ctors(d)))
      )
    ),
    ignored => c1 => context_bind(
      List(DataCtor),
      Unit,
      c1,
      (constructors: List(DataCtor), c2: Checker) => frame_bind(
        Unit,
        Unit,
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0)
      ),
      ck_data_ctors(
        registration_ctors(d),
        c1,
        ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
      ),
      ck_data_ctors_frame_context(
        registration_ctors(d),
        c1,
        ck_param_generics(registration_generics(d), KindLinear, Ordmap::empty())
      ),
      constructors => c2 => context_bind(
        Unit,
        Unit,
        c2,
        (ignored2: Unit, c3: Checker) => registration_insert(
          c3,
          d,
          is_struct,
          builtin,
          constructors
        ),
        ck_register_ctors(constructors, c2, registration_name(d), 0),
        ck_register_ctors_context(constructors, c2, registration_name(d), is_struct, 0),
        ignored2 => c3 => registration_insert_context(c3, d, is_struct, builtin, constructors)
      )
    )
  )
}
pub theorem ck_declare_data_context(
  c: Checker,
  d: SurfaceData,
  is_struct: Bool,
  builtin: Bool
): CkContextFrame(c, ck_declare_data(c, d, is_struct, builtin)) {
  Eq::subst(
    (m: Mut1(Unit, Checker)) => CkContextFrame(c, m),
    Eq::sym(registration_declare_unf(c, d, is_struct, builtin)),
    registration_declare_context(c, d, is_struct, builtin)
  )
}
