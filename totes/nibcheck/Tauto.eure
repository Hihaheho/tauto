package {
  name = "nibcheck"
  version = "0.1.0"
}

dependencies {
  ordmap { path = "../ordmap" }
  surface { path = "../surface" }
  parse { path = "../parse" }
  syntax { path = "../syntax" }
  text { path = "../text" }
  unicode { path = "../unicode" }
}

// `cy_eval` of `src/cycle.taut` is one group of nineteen functions that call
// each other, and elaborating it alone exceeds the default limit, so splitting
// the file does not bring it under the default. The limit is raised for this
// file only.
check {
  slow {
    "src/cycle.taut" = 45
    "src/rows_verify_sound.taut" = 240
  }
}
