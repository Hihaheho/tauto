// Generated by `bash scripts/generate-syntax-tables.sh` from
// crates/tauto-parol/tauto.par: the tables of its parser and its scanner.
// Do not edit by hand: change the grammar and run the script again. Each
// table is the text of tables/<name>.txt, read where it is written.

// The terminals' names, in the parser's order.
fn syntax_tables_terminal_names() -> Text {
  concat("", include_text!("tables/terminal_names.txt"))
}

// The names the tree dump gives the terminals (those of `TerminalKind`; the end of input and the error token have none).
fn syntax_tables_terminal_kinds() -> Text {
  concat("", include_text!("tables/terminal_kinds.txt"))
}

// The non-terminals' names, in the parser's order.
fn syntax_tables_non_terminal_names() -> Text {
  concat("", include_text!("tables/non_terminal_names.txt"))
}

// The names the tree dump gives the non-terminals (those of `NonTerminalKind`).
fn syntax_tables_non_terminal_kinds() -> Text {
  concat("", include_text!("tables/non_terminal_kinds.txt"))
}

// The non-terminals the grammar declares (not the helpers the generator adds).
fn syntax_tables_declared() -> Text {
  concat("", include_text!("tables/declared.txt"))
}

// max_k, the start non-terminal, the terminals, the non-terminals.
fn syntax_tables_parser_meta() -> Text {
  concat("", include_text!("tables/parser_meta.txt"))
}

// Per scanner mode: how many tokens the parser skips there, then those.
fn syntax_tables_skip() -> Text {
  concat("", include_text!("tables/skip.txt"))
}

// The number of automata, then for each non-terminal: prod0 + 1 (0 for none), k, the states.
fn syntax_tables_lookahead_meta() -> Text {
  concat("", include_text!("tables/lookahead_meta.txt"))
}

// For each non-terminal's states and each terminal, run-length encoded: to * 1024 + production + 1, 0 for none.
fn syntax_tables_lookahead_cells() -> Text {
  concat("", include_text!("tables/lookahead_cells.txt"))
}

// The number of productions, then each one's left side, length and symbols (0 non-terminal, 1 terminal) in the order the parser pushes them.
fn syntax_tables_productions() -> Text {
  concat("", include_text!("tables/productions.txt"))
}

// The classes, the modes, the automata; then per mode its transitions (kind 0 set, 1 push, 2 pop; the token; the mode, 0 for a pop).
fn syntax_tables_scan_meta() -> Text {
  concat("", include_text!("tables/scan_meta.txt"))
}

// The number of runs, then each run's first and last code point and class.
fn syntax_tables_scan_classes() -> Text {
  concat("", include_text!("tables/scan_classes.txt"))
}

// Per automaton its states, and per state what it accepts: token, lookahead kind (0 none, 1 positive, 2 negative) and automaton (0 for none).
fn syntax_tables_scan_states() -> Text {
  concat("", include_text!("tables/scan_states.txt"))
}

// Per state, run-length encoded: the next state + 1 (0 for none) for each class.
fn syntax_tables_scan_rows() -> Text {
  concat("", include_text!("tables/scan_rows.txt"))
}
