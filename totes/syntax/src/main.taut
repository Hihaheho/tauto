// Prints `== <path>` and the dump of the tree of each file given on the
// command line, or `error` (the differential test's input,
// `docs/design/self-host.md`).

import "../../scan/src/scan.taut"
import "syntax.taut"
import "../../text/src/text.taut"
import std::Text
import std::prelude::Os
import std::prelude::Affine

// With `--tokens` first: the scanner's tokens only, a line `<kind> <start>
// <end>` for each (the differential test's way to tell the scanner's faults
// from the parser's).
pub fn syntax_tokens_each(t: SyntaxTables, paths: List(Text)): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => syntax_print_tokens(t, scan_all(t.scan, source))
      }
      syntax_tokens_each(t, rest)
    }
  }
}

pub fn syntax_print_tokens(t: SyntaxTables, tokens: List(ScanToken)): Unit {
  var b := Buf::new()
  var rest := tokens
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(token, more) => {
        rest := more
        Buf::push(&mut b, &syntax_name(t.terminal_kinds, token.token_type))
        Buf::push(&mut b, &" ")
        Buf::push(&mut b, &Text::of_nat(token.start))
        Buf::push(&mut b, &" ")
        Buf::push(&mut b, &Text::of_nat(token.end))
        Buf::push(&mut b, &text_newline())
      }
    }
  }
  print(Text::of(b))
}

pub fn syntax_main_each(t: SyntaxTables, paths: List(Text)): Unit {
  match paths {
    Nil => #()
    Cons(path, rest) => {
      print(Text::concat_all(Cons("== ", Cons(path, Cons(text_newline(), Nil)))))
      match read_file(path) {
        Err(e) => print(Text::concat_all(Cons("cannot read: ", Cons(e, Cons(text_newline(), Nil)))))
        Ok(source) => match syntax_dump(t, source) {
          Some(dump) => print(dump)
          None => print(Text::concat_all(Cons("error", Cons(text_newline(), Nil))))
        }
      }
      syntax_main_each(t, rest)
    }
  }
}

match syntax_tables() {
  None => eprint("the tables of the syntax are damaged")
  Some(t) => match perform argv() {
    Nil => #()
    Cons(first, rest) => if first == "--tokens" {
      syntax_tokens_each(t, rest)
    } else {
      syntax_main_each(t, Cons(first, rest))
    }
  }
}
