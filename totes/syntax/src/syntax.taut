import "tables.taut"
import "../../llk/src/llk.taut"
import "../../scan/src/scan.taut"
import "../../text/src/text.taut"
import std::Array
import std::Stack
import std::Text
import std::Base

// The syntax of Tauto, read from the parser and scanner tables of
// `crates/tauto-parol` (`tables.taut`), in the proof language (`docs/design/self-host.md`). `README.md`
// says what the tables hold. `syntax.taut` reads the texts of `tables.taut`
// and passes them to `syntax_tables_read`.

pub(open) inductive SyntaxTables: Type {
  Mk(
    scan: ScanTables,
    llk: LlkTables,
    // The names the dump gives the terminals and the non-terminals (the
    // root is the last of the non-terminals).
    terminal_kinds: Array(Text),
    non_terminal_kinds: Array(Text),
    declared: List(Text),
    // For each non-terminal, by number: whether the grammar declares it.
    declared_flags: Array(Bool)
  ): SyntaxTables
}

pub fn syntax_has_name(names: List(Text), name: Text): Bool {
  ⊢ Bool from match names {
    Nil => false
    Cons(n, rest) => ⊢ Bool from match n == name {
      true => true
      false => syntax_has_name(rest, name)
    }
  }
}

pub fn syntax_flags_of(non_terminals: List(Text), declared: List(Text)): List(Bool) {
  ⊢ List(Bool) from match non_terminals {
    Nil => Nil
    Cons(name, rest) => Cons(syntax_has_name(declared, name), syntax_flags_of(rest, declared))
  }
}

pub fn syntax_names(t: Text): Array(Text) {
  Array::of_list(text_split(t, " "))
}

pub fn syntax_tables_read(
  scan_meta: Text,
  scan_classes: Text,
  scan_states: Text,
  scan_rows: Text,
  parser_meta: Text,
  skip: Text,
  lookahead_meta: Text,
  lookahead_cells: Text,
  productions: Text,
  terminal_kinds: Text,
  non_terminal_kinds: Text,
  non_terminal_names: Text,
  declared: Text
): Option(SyntaxTables) {
  ⊢ Option(SyntaxTables) from match scan_tables_read(scan_meta, scan_classes, scan_states, scan_rows) {
    None => None
    Some(scan) => ⊢ Option(SyntaxTables) from match llk_tables_read(
      parser_meta,
      skip,
      lookahead_meta,
      lookahead_cells,
      productions
    ) {
      None => None
      Some(llk) => Some(
        SyntaxTables {
          scan: scan,
          llk: llk,
          terminal_kinds: syntax_names(terminal_kinds),
          non_terminal_kinds: syntax_names(Text::concat_all(Cons(non_terminal_kinds, Cons(" Root", Nil)))),
          declared: text_split(declared, " "),
          declared_flags: Array::of_list(syntax_flags_of(text_split(non_terminal_names, " "), text_split(declared, " ")))
        }
      )
    }
  }
}

pub fn syntax_name(names: Array(Text), i: Nat): Text {
  Array::get_or(names, i, "?")
}

pub fn syntax_flag(flags: Array(Bool), i: Nat): Bool {
  Array::get_or(flags, i, false)
}

pub(open) inductive CstKind: Type {
  CstNonTerminal(non_terminal: Nat): CstKind
  CstTerminal(terminal: Nat): CstKind
}

// A node of the tree: a non-terminal with its children, or a token. `name`
// is its kind's name (`NonTerminalKind` or `TerminalKind`), `terminal` tells
// which; `declared` is whether the grammar declares the non-terminal.
// `children` are all of them; `flat` are those of `Cst::children`: the
// helper non-terminals the grammar does not declare (`…List`, `…Opt`) are
// replaced by their own children, and white space and comments are left out.
pub(open) inductive CstNode: Type {
  Mk(
    kind: CstKind,
    name: Text,
    terminal: Bool,
    trivia: Bool,
    declared: Bool,
    start: Nat,
    end: Nat,
    children: List(CstNode),
    flat: List(CstNode)
  ): CstNode
}

pub(open) inductive CstSpan: Type {
  Mk(start: Nat, end: Nat): CstSpan
}

// A non-terminal that is open: what has been read of it, its children in
// order (left empty when the tree is built without them) and its `flat`.
pub(open) inductive CstFrame: Type {
  Mk(span: CstSpan, children: List(CstNode), flat: List(CstNode)): CstFrame
}

pub fn cst_empty(s: CstSpan): Bool {
  s.end <= s.start && s.start == 0
}

// `Span::merge` of `cst.rs`: an empty span at 0 is no span.
pub fn cst_merge(a: CstSpan, b: CstSpan): CstSpan {
  ⊢ CstSpan from match cst_empty(a) {
    true => b
    false => ⊢ CstSpan from match cst_empty(b) {
      true => a
      false => CstSpan { start: Nat::min(a.start, b.start), end: Nat::max(a.end, b.end) }
    }
  }
}

// `is_trivia` of `cst.rs`: NewLine, Whitespace, LineComment, BlockComment
// and Comment.
pub fn cst_is_trivia(kinds: Array(Text), terminal: Nat): Bool {
  let name := syntax_name(kinds, terminal)
  name == "NewLine" || name == "Whitespace" || name == "LineComment" || name == "BlockComment" || name == "Comment"
}

// The node of `non_terminal` that a frame closes into. Without `keep` it has
// no `children`, which saves the box they would be in.
pub fn cst_closed(&t: SyntaxTables, keep: Bool, non_terminal: Nat, frame: CstFrame): CstNode {
  ⊢ CstNode from match keep {
    true => CstNode {
      kind: CstNonTerminal(non_terminal),
      name: syntax_name(t.non_terminal_kinds, non_terminal),
      terminal: false,
      trivia: false,
      declared: syntax_flag(t.declared_flags, non_terminal),
      start: frame.span.start,
      end: frame.span.end,
      children: frame.children,
      flat: frame.flat
    }
    false => CstNode {
      kind: CstNonTerminal(non_terminal),
      name: syntax_name(t.non_terminal_kinds, non_terminal),
      terminal: false,
      trivia: false,
      declared: syntax_flag(t.declared_flags, non_terminal),
      start: frame.span.start,
      end: frame.span.end,
      children: Nil,
      flat: frame.flat
    }
  }
}

// A token goes into the innermost open node, before the children it has.
pub fn cst_add_token(
  &t: SyntaxTables,
  keep: Bool,
  &mut frames: Stack(CstFrame),
  terminal: Nat,
  r#from: Nat,
  to: Nat
): Unit {
  ⊢ Unit from match Stack::pop(&mut frames) {
    None => #()
    Some(parent) => {
      let trivia := cst_is_trivia(t.terminal_kinds, terminal)
      let node := CstNode {
        kind: CstTerminal(terminal),
        name: syntax_name(t.terminal_kinds, terminal),
        terminal: true,
        trivia: trivia,
        declared: false,
        start: r#from,
        end: to,
        children: Nil,
        flat: Nil
      }
      Stack::push(
        &mut frames,
        CstFrame {
          span: ⊢ CstSpan from match trivia {
            true => parent.span
            false => cst_merge(parent.span, CstSpan { start: r#from, end: to })
          },
          children: ⊢ List(CstNode) from match keep {
            true => Cons(node, parent.children)
            false => parent.children
          },
          flat: ⊢ List(CstNode) from match trivia {
            true => parent.flat
            false => Cons(node, parent.flat)
          }
        }
      )
    }
  }
}

// A closed node goes into the open node around it, before the children it has.
pub fn cst_add_node(keep: Bool, parent: CstFrame, span: CstSpan, node: CstNode): CstFrame {
  CstFrame {
    span: cst_merge(parent.span, span),
    children: ⊢ List(CstNode) from match keep {
      true => Cons(node, parent.children)
      false => parent.children
    },
    flat: ⊢ List(CstNode) from match node.declared {
      true => Cons(node, parent.flat)
      false => List::append(node.flat, parent.flat)
    }
  }
}

// The tree the events build (`CstBuilder`), taking at most `fuel` of them off
// `events`. The last event is on top, so a node is met at its end and is
// closed when its opening is reached: `frames` hold what has been read of
// the nodes still open (innermost on top), their children in order. The
// events of a parse that succeeded close everything they open. `keep` is
// whether the nodes keep all their `children`; `flat` is built either way.
pub fn cst_build_in(
  fuel: Nat,
  &t: SyntaxTables,
  keep: Bool,
  &mut events: Stack(LlkEvent),
  &mut frames: Stack(CstFrame),
  root: Option(CstNode)
): Option(CstNode) {
  ⊢ Option(CstNode) from match fuel {
    Zero => root
    Succ(f) => ⊢ Option(CstNode) from match Stack::pop(&mut events) {
      None => root
      Some(event) => ⊢ Option(CstNode) from match event {
        LlkClose => {
          Stack::push(
            &mut frames,
            CstFrame { span: CstSpan { start: 0, end: 0 }, children: Nil, flat: Nil }
          )
          cst_build_in(f, &t, keep, &mut events, &mut frames, root)
        }
        LlkOpen(non_terminal) => ⊢ Option(CstNode) from match Stack::pop(&mut frames) {
          None => cst_build_in(f, &t, keep, &mut events, &mut frames, root)
          Some(frame) => ⊢ Option(CstNode) from match Stack::pop(&mut frames) {
            None => cst_build_in(
              f,
              &t,
              keep,
              &mut events,
              &mut frames,
              Some(cst_closed(&t, keep, non_terminal, frame))
            )
            Some(parent) => {
              let span := frame.span
              let node := cst_closed(&t, keep, non_terminal, frame)
              Stack::push(&mut frames, cst_add_node(keep, parent, span, node))
              cst_build_in(f, &t, keep, &mut events, &mut frames, root)
            }
          }
        }
        LlkToken(terminal, r#from, to) => {
          cst_add_token(&t, keep, &mut frames, terminal, r#from, to)
          cst_build_in(f, &t, keep, &mut events, &mut frames, root)
        }
      }
    }
  }
}

pub fn cst_build(&t: SyntaxTables, keep: Bool, &mut events: Stack(LlkEvent)): Option(CstNode) {
  var frames: Stack(CstFrame) := Stack::new()
  cst_build_in(Stack::len(&events) + 1, &t, keep, &mut events, &mut frames, None)
}

pub fn cst_at_depth(
  nodes: List(CstNode),
  depth: Nat,
  rest: List(Pair(CstNode, Nat))
): List(Pair(CstNode, Nat)) {
  ⊢ List(Pair(CstNode, Nat)) from match nodes {
    Nil => rest
    Cons(node, more) => Cons(Pair { fst: node, snd: depth }, cst_at_depth(more, depth, rest))
  }
}

pub fn cst_line(node: CstNode, depth: Nat): Text {
  Text::concat_all(
    Cons(
      Text::of_nat(depth),
      Cons(
        " ",
        Cons(
          node.name,
          Cons(
            " ",
            Cons(
              Text::of_nat(node.start),
              Cons(" ", Cons(Text::of_nat(node.end), Cons(text_newline(), Nil)))
            )
          )
        )
      )
    )
  )
}

// The lines of at most `fuel` nodes of `todo` and their children, parents
// first, after `lines` (last first).
pub fn cst_dump_in(fuel: Nat, todo: List(Pair(CstNode, Nat)), lines: List(Text)): List(Text) {
  ⊢ List(Text) from match fuel {
    Zero => lines
    Succ(f) => ⊢ List(Text) from match todo {
      Nil => lines
      Cons(item, rest) => cst_dump_in(
        f,
        cst_at_depth(item.fst.children, Succ(item.snd), rest),
        Cons(cst_line(item.fst, item.snd), lines)
      )
    }
  }
}

// The dump of a tree of at most `size` nodes: a line for each node, the
// parent first, its children in order.
pub fn cst_dump(node: CstNode, size: Nat): Text {
  Text::concat_all(List::reverse(cst_dump_in(size, Cons(Pair { fst: node, snd: 0 }, Nil), Nil)))
}

// The events of the parse of `source` are left on `events`, the last on top.
pub fn syntax_events(&t: SyntaxTables, source: Text, &mut events: Stack(LlkEvent)): Bool {
  let tokens := llk_tokens(t.llk, scan_all(t.scan, source), Text::len(source))
  ⊢ Bool from match llk_parse(llk_fuel(t.llk, tokens), t.llk, tokens, &mut events) {
    LlkFailed(error) => false
    LlkParsed => true
  }
}

pub fn syntax_parse(&t: SyntaxTables, source: Text): Option(CstNode) {
  var events: Stack(LlkEvent) := Stack::new()
  ⊢ Option(CstNode) from match syntax_events(&t, source, &mut events) {
    false => None
    true => cst_build(&t, false, &mut events)
  }
}

// The dump of the tree of `source`, or `None` when it is not a program of
// the grammar. Each node opens or is a token, so there are no more nodes
// than events.
pub fn syntax_dump(&t: SyntaxTables, source: Text): Option(Text) {
  var events: Stack(LlkEvent) := Stack::new()
  ⊢ Option(Text) from match syntax_events(&t, source, &mut events) {
    false => None
    true => {
      let size := Stack::len(&events)
      ⊢ Option(Text) from match cst_build(&t, true, &mut events) {
        None => None
        Some(tree) => Some(cst_dump(tree, size))
      }
    }
  }
}

pub fn syntax_tables(): Option(SyntaxTables) {
  syntax_tables_read(
    syntax_tables_scan_meta(),
    syntax_tables_scan_classes(),
    syntax_tables_scan_states(),
    syntax_tables_scan_rows(),
    syntax_tables_parser_meta(),
    syntax_tables_skip(),
    syntax_tables_lookahead_meta(),
    syntax_tables_lookahead_cells(),
    syntax_tables_productions(),
    syntax_tables_terminal_kinds(),
    syntax_tables_non_terminal_kinds(),
    syntax_tables_non_terminal_names(),
    syntax_tables_declared()
  )
}
