import "../src/Simp.taut"

theorem explicit_chain(
  a: Nat,
  b: Nat,
  c: Nat,
  ab: Eq(Nat, a, b),
  bc: Eq(Nat, b, c)
): Eq(Nat, a, c) {
  by simp_only!(rules(8, ab, bc)) -> Eq(Nat, a, c) {}
}

theorem residual_goal(P: (Nat) -> Prop, a: Nat, b: Nat, ab: Eq(Nat, a, b), pb: P(b)): P(a) {
  by simp_only!(rules(8, ab)) -> P(a) {
    ⊢ P(b) => pb
  }
}
