import "../src/Simp.taut"

pub theorem explicit_chain(a: Nat, b: Nat, c: Nat, ab: a = b, bc: b = c): a = c {
  by simp_only!(rules(8, ab, bc)): a = c {}
}

pub theorem residual_goal(P: (Nat) -> Prop, a: Nat, b: Nat, ab: a = b, pb: P(b)): P(a) {
  by simp_only!(rules(8, ab)): P(a) {
    ⊢ P(b) from pb
  }
}
