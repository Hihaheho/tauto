import std::Base

// What the server asks of the analysis of the open files. Each answer is
// JSON as text. The analysis keeps the open files itself: `set_text` gives it
// a file's text, `close` gives the file back to the disk.

extern {
  // The names of the kinds of semantic tokens, a JSON array.
  fn lsp_token_kinds(): Text
  // The folder of the workspace, a `file://` URI; empty for none.
  fn lsp_set_root(&uri: Text): Bool
  // The file at `uri` is open with the text `text`.
  fn lsp_set_text(&uri: Text, &text: Text): Bool
  // The diagnostics of the file at `uri` as the open texts are now, a JSON array.
  fn lsp_diagnostics(&uri: Text): Text
  fn lsp_close(&uri: Text): Bool
  // The answer to the request `method` about the file at `uri` with the
  // parameters `params` (JSON): `{"result": …}` or `{"error": …}`; any other
  // object for a method the analysis does not answer.
  fn lsp_request(&method: Text, &uri: Text, &params: Text): Text
}

pub fn token_kinds(): Text {
  lsp_token_kinds()
}

pub fn set_root(uri: Text): Unit {
  let ok: Bool := lsp_set_root(uri)
  #()
}

pub fn set_text(uri: Text, text: Text): Unit {
  let ok: Bool := lsp_set_text(uri, text)
  #()
}

pub fn diagnostics(uri: Text): Text {
  lsp_diagnostics(uri)
}

pub fn close(uri: Text): Unit {
  let ok: Bool := lsp_close(uri)
  #()
}

pub fn request(method: Text, uri: Text, params: Text): Text {
  lsp_request(method, uri, params)
}
