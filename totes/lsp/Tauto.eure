// The language server `tauto lsp` runs: the protocol and the session are
// here; what a file says is asked of the Rust analyzer through the bridge
// (bridge/), and moves into this tote's own queries step by step.
package {
  name = "lsp"
  version = "0.1.0"
}

dependencies {
  json { path = "../json" }
  query-flow { path = "../query-flow" }
  text { path = "../text" }
}

rust {
  bridge = "bridge"
  exports = []
}
