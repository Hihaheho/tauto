import std::prelude::Affine
import std::prelude::Os {
  argv,
  eprint,
  fs_read,
  fs_write,
  print,
  read_file,
  stderr,
  stdout,
  write_file
}

// Renders a release changelog (`docs/changelogs/<date>.eure`) as one
// standalone HTML page.
//
//   tauto run --allow-read --allow-write --allow-div scripts/changelog-to-html.taut -- IN.eure OUT.html
//
// It reads only the subset of Eure the changelog schema uses: `base`, the
// top-level `summary`, and the entries `@ kind[]` with `area`, `breaking`,
// `summary`, `details` and `migration`. A text block is written
// `key = ````markdown` and ends at a line that is exactly four backticks.
// Positions are UTF-8 bytes. The text of a block is rendered as a small
// Markdown subset: paragraphs, `- ` lists, fenced code blocks, `code`,
// **bold**, *emphasis* and [links](url). Code blocks are not coloured.

// --- Byte-level helpers ---------------------------------------------------

fn byte_at(t: Text, i: u64): u64 {
  match Text::byte(t, i) {
    None => 0
    Some(b) => U64::of_u8(b)
  }
}

// The bytes `a` to `z` of `t`; empty when out of range.
fn sub(t: Text, a: u64, z: u64): Text {
  match Text::slice(t, a, z) {
    Some(s) => s
    None => ""
  }
}

fn same(a: Text, b: Text): Bool {
  Text::compare(a, b) == 0
}

fn has_prefix(t: Text, prefix: Text, at: u64): Bool {
  at + Text::len(prefix) <= Text::len(t) && same(sub(t, at, at + Text::len(prefix)), prefix)
}

fn put(&mut b: Buf, s: Text): Unit {
  Buf::push(&mut b, &s)
}

fn join2(a: Text, c: Text): Text {
  var b := Buf::new()
  put(&mut b, a)
  put(&mut b, c)
  Text::of(b)
}

// The position of the line break at or after `start`, or the end of `t`.
fn line_end(t: Text, start: u64): u64 {
  var i := start
  while i < Text::len(t) && byte_at(t, i) != 10 {
    i := i + 1
  }
  i
}

// The first position at or after `start` holding the byte `c`.
fn find_byte(t: Text, c: u64, start: u64): Option(u64) {
  var i := start
  var found: Option(u64) := None
  var running := true
  while running {
    if i >= Text::len(t) {
      running := false
    } else if byte_at(t, i) == c {
      found := Some(i)
      running := false
    } else {
      i := i + 1
    }
  }
  found
}

// The first position at or after `start` holding the byte `c` twice in a row.
fn find_pair(t: Text, c: u64, start: u64): Option(u64) {
  var i := start
  var found: Option(u64) := None
  var running := true
  while running {
    if i >= Text::len(t) {
      running := false
    } else if byte_at(t, i) == c && byte_at(t, i + 1) == c {
      found := Some(i)
      running := false
    } else {
      i := i + 1
    }
  }
  found
}

fn is_blank(line: Text): Bool {
  var blank := true
  var i: u64 := 0
  while i < Text::len(line) {
    let c := byte_at(line, i)
    if c == 32 || c == 9 || c == 13 {
      i := i + 1
    } else {
      blank := false
      i := Text::len(line)
    }
  }
  blank
}

// --- Inline Markdown ------------------------------------------------------

// Writes the bytes `a` to `z` of `s` with `& < > " '` escaped.
fn esc_push(&mut b: Buf, s: Text, a: u64, z: u64): Unit {
  var start := a
  var i := a
  while i < z {
    let c := byte_at(s, i)
    let rep := if c == 38 {
      "&amp;"
    } else if c == 60 {
      "&lt;"
    } else if c == 62 {
      "&gt;"
    } else if c == 34 {
      "&quot;"
    } else if c == 39 {
      "&#39;"
    } else {
      ""
    }
    if same(rep, "") {
      i := i + 1
    } else {
      put(&mut b, sub(s, start, i))
      put(&mut b, rep)
      i := i + 1
      start := i
    }
  }
  put(&mut b, sub(s, start, z))
}

// The positions of `]` and `)` of a link `[text](url)` starting at `i`.
fn find_link(s: Text, i: u64): Option(u64 × u64) {
  match find_byte(s, 93, i + 1) {
    None => None
    Some(j) => if byte_at(s, j + 1) == 40 {
      match find_byte(s, 41, j + 2) {
        None => None
        Some(k) => Some(#(j, k))
      }
    } else {
      None
    }
  }
}

// A link target is kept when it is `http(s)` or has no scheme at all.
fn url_ok(url: Text): Bool {
  if has_prefix(url, "http://", 0) || has_prefix(url, "https://", 0) {
    true
  } else {
    match find_byte(url, 58, 0) {
      None => true
      Some(p) => false
    }
  }
}

// Writes `s` with `code`, **bold**, *emphasis* and [links](url) as HTML.
fn inline(&mut b: Buf, s: Text): Unit {
  let n := Text::len(s)
  var start: u64 := 0
  var i: u64 := 0
  while i < n {
    let c := byte_at(s, i)
    if c == 96 {
      match find_byte(s, 96, i + 1) {
        None => {
          i := i + 1
        }
        Some(j) => {
          esc_push(&mut b, s, start, i)
          put(&mut b, "<code>")
          esc_push(&mut b, s, i + 1, j)
          put(&mut b, "</code>")
          i := j + 1
          start := i
        }
      }
    } else if c == 42 && byte_at(s, i + 1) == 42 {
      match find_pair(s, 42, i + 2) {
        None => {
          i := i + 2
        }
        Some(j) => {
          esc_push(&mut b, s, start, i)
          put(&mut b, "<strong>")
          inline(&mut b, sub(s, i + 2, j))
          put(&mut b, "</strong>")
          i := j + 2
          start := i
        }
      }
    } else if c == 42 && byte_at(s, i + 1) != 32 {
      match find_byte(s, 42, i + 1) {
        None => {
          i := i + 1
        }
        Some(j) => {
          esc_push(&mut b, s, start, i)
          put(&mut b, "<em>")
          inline(&mut b, sub(s, i + 1, j))
          put(&mut b, "</em>")
          i := j + 1
          start := i
        }
      }
    } else if c == 91 {
      match find_link(s, i) {
        None => {
          i := i + 1
        }
        Some(#(j, k)) => {
          let url := sub(s, j + 2, k)
          if url_ok(url) {
            esc_push(&mut b, s, start, i)
            put(&mut b, "<a href='")
            esc_push(&mut b, url, 0, Text::len(url))
            put(&mut b, "'>")
            inline(&mut b, sub(s, i + 1, j))
            put(&mut b, "</a>")
            i := k + 1
            start := i
          } else {
            i := i + 1
          }
        }
      }
    } else {
      i := i + 1
    }
  }
  esc_push(&mut b, s, start, n)
}

// --- Block Markdown -------------------------------------------------------

// Ends the open block: `mode` 1 is a paragraph over the bytes `ps` to `pe` of
// `src`, 2 is an open list, 0 is none.
fn close_block(&mut b: Buf, mode: u64, src: Text, ps: u64, pe: u64): Unit {
  if mode == 1 {
    put(&mut b, "<p>")
    inline(&mut b, sub(src, ps, pe))
    put(&mut b, "</p>\n")
  } else if mode == 2 {
    put(&mut b, "</li></ul>\n")
  } else {
    #()
  }
}

// The HTML of a Markdown text.
fn markdown(src: Text): Text {
  var b := Buf::new()
  var pos: u64 := 0
  var mode: u64 := 0
  var ps: u64 := 0
  var pe: u64 := 0
  while pos < Text::len(src) {
    let ls := pos
    let le := line_end(src, pos)
    let line := sub(src, ls, le)
    pos := le + 1
    if is_blank(line) {
      close_block(&mut b, mode, src, ps, pe)
      mode := 0
    } else if has_prefix(line, "```", 0) {
      close_block(&mut b, mode, src, ps, pe)
      mode := 0
      let lang := sub(line, 3, Text::len(line))
      put(&mut b, "<pre><code")
      if same(lang, "") {
        #()
      } else {
        put(&mut b, " class='lang-")
        esc_push(&mut b, lang, 0, Text::len(lang))
        put(&mut b, "'")
      }
      put(&mut b, ">")
      var fenced := true
      while fenced && pos < Text::len(src) {
        let e2 := line_end(src, pos)
        let l2 := sub(src, pos, e2)
        pos := e2 + 1
        if has_prefix(l2, "```", 0) {
          fenced := false
        } else {
          esc_push(&mut b, l2, 0, Text::len(l2))
          put(&mut b, "\n")
        }
      }
      put(&mut b, "</code></pre>\n")
    } else if has_prefix(line, "- ", 0) {
      if mode == 2 {
        put(&mut b, "</li>")
      } else {
        close_block(&mut b, mode, src, ps, pe)
        put(&mut b, "<ul>")
      }
      mode := 2
      put(&mut b, "<li>")
      inline(&mut b, sub(line, 2, Text::len(line)))
    } else if mode == 2 && has_prefix(line, "  ", 0) {
      put(&mut b, " ")
      inline(&mut b, sub(line, 2, Text::len(line)))
    } else if mode == 1 {
      pe := le
    } else {
      close_block(&mut b, mode, src, ps, pe)
      mode := 1
      ps := ls
      pe := le
    }
  }
  close_block(&mut b, mode, src, ps, pe)
  Text::of(b)
}

// --- Reading the changelog ------------------------------------------------

pub(open) struct Entry {
  kind: u64,
  area: Text,
  breaking: Bool,
  summary: Text,
  details: Text,
  migration: Text
}

pub(open) struct Changelog {
  base: Text,
  summary: Text,
  entries: List(Entry)
}

// 1 added, 2 changed, 3 removed, 4 fixed, 5 deprecated, 6 security; 0 for any
// other line.
fn kind_of(line: Text): u64 {
  if has_prefix(line, "@ added", 0) {
    1
  } else if has_prefix(line, "@ changed", 0) {
    2
  } else if has_prefix(line, "@ removed", 0) {
    3
  } else if has_prefix(line, "@ fixed", 0) {
    4
  } else if has_prefix(line, "@ deprecated", 0) {
    5
  } else if has_prefix(line, "@ security", 0) {
    6
  } else {
    0
  }
}

fn kind_name(k: u64): Text {
  if k == 1 {
    "Added"
  } else if k == 2 {
    "Changed"
  } else if k == 3 {
    "Removed"
  } else if k == 4 {
    "Fixed"
  } else if k == 5 {
    "Deprecated"
  } else {
    "Security"
  }
}

// The position of the first ` = ` in a line.
fn find_eq(line: Text): Option(u64) {
  var i: u64 := 0
  var found: Option(u64) := None
  var running := true
  while running {
    if i >= Text::len(line) {
      running := false
    } else if has_prefix(line, " = ", i) {
      found := Some(i)
      running := false
    } else {
      i := i + 1
    }
  }
  found
}

// The string written at the start of `v` (which begins with `"`), with the
// escapes `\"`, `\\` and `\n` decoded.
fn unquote(v: Text): Text {
  var b := Buf::new()
  var start: u64 := 1
  var i: u64 := 1
  var running := true
  while running {
    if i >= Text::len(v) {
      put(&mut b, sub(v, start, i))
      running := false
    } else {
      let c := byte_at(v, i)
      if c == 34 {
        put(&mut b, sub(v, start, i))
        running := false
      } else if c == 92 {
        put(&mut b, sub(v, start, i))
        if byte_at(v, i + 1) == 110 {
          put(&mut b, "\n")
        } else {
          put(&mut b, sub(v, i + 1, i + 2))
        }
        i := i + 2
        start := i
      } else {
        i := i + 1
      }
    }
  }
  Text::of(b)
}

// The lines of `src` from `start` up to a line that is exactly four backticks,
// and the position after that line.
fn read_block(src: Text, start: u64): Text × u64 {
  var pos := start
  var content_end := Text::len(src)
  var next := Text::len(src)
  var running := true
  while running {
    if pos >= Text::len(src) {
      running := false
    } else {
      let le := line_end(src, pos)
      if same(sub(src, pos, le), "````") {
        content_end := if pos > start {
          pos - 1
        } else {
          start
        }
        next := le + 1
        running := false
      } else {
        pos := le + 1
      }
    }
  }
  #(sub(src, start, content_end), next)
}

fn reverse_entries(es: List(Entry)): List(Entry) {
  var rest := es
  var done: List(Entry) := Nil
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(e, more) => {
        done := Cons(e, done)
        rest := more
      }
    }
  }
  done
}

// The release summary, the base commit and the entries (in file order).
fn parse(src: Text): Changelog {
  var pos: u64 := 0
  var base: Text := ""
  var top_summary: Text := ""
  var entries: List(Entry) := Nil
  var kind: u64 := 0
  var area: Text := ""
  var breaking := false
  var summary: Text := ""
  var details: Text := ""
  var migration: Text := ""
  while pos < Text::len(src) {
    let le := line_end(src, pos)
    let line := sub(src, pos, le)
    pos := le + 1
    if has_prefix(line, "//", 0) {
      #()
    } else if has_prefix(line, "@ ", 0) {
      if kind != 0 {
        entries := Cons(Entry {
          kind: kind,
          area: area,
          breaking: breaking,
          summary: summary,
          details: details,
          migration: migration
        }, entries)
      } else {
        #()
      }
      kind := kind_of(line)
      area := ""
      breaking := false
      summary := ""
      details := ""
      migration := ""
    } else {
      match find_eq(line) {
        None => #()
        Some(e) => {
          let key := sub(line, 0, e)
          let raw := sub(line, e + 3, Text::len(line))
          var value: Text := ""
          if has_prefix(raw, "```", 0) {
            match read_block(src, pos) {
              #(content, next) => {
                value := content
                pos := next
              }
            }
          } else if has_prefix(raw, "\"", 0) {
            value := unquote(raw)
          } else {
            value := raw
          }
          if same(key, "base") {
            base := value
          } else if same(key, "summary") {
            if kind == 0 {
              top_summary := value
            } else {
              summary := value
            }
          } else if same(key, "area") {
            area := value
          } else if same(key, "breaking") {
            breaking := same(value, "true")
          } else if same(key, "details") {
            details := value
          } else if same(key, "migration") {
            migration := value
          } else {
            #()
          }
        }
      }
    }
  }
  if kind != 0 {
    entries := Cons(Entry {
      kind: kind,
      area: area,
      breaking: breaking,
      summary: summary,
      details: details,
      migration: migration
    }, entries)
  } else {
    #()
  }
  Changelog { base: base, summary: top_summary, entries: reverse_entries(entries) }
}

// --- Writing the page -----------------------------------------------------

fn css(): Text {
  var b := Buf::new()
  put(
    &mut b,
    ":root{--bg:#fff;--fg:#1f2328;--muted:#59636e;--line:#d1d9e0;--code-bg:#eef1f4;--code-fg:#9a3412;--badge:#e6ebf1;--warn-bg:#ffebe9;--warn-fg:#a40e26;--link:#0550ae;color-scheme:light}\n"
  )
  put(
    &mut b,
    "@media (prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--muted:#9198a1;--line:#30363d;--code-bg:#1c232c;--code-fg:#ffb784;--badge:#262c36;--warn-bg:#4c1d24;--warn-fg:#ffaba8;--link:#79c0ff;color-scheme:dark}}\n"
  )
  put(
    &mut b,
    "body{margin:0;padding:2rem 1rem;background:var(--bg);color:var(--fg);font:16px/1.6 system-ui,sans-serif}\n"
  )
  put(&mut b, "main{max-width:48rem;margin:0 auto}\n")
  put(
    &mut b,
    "h1{font-size:1.8rem;margin:0 0 .25rem}h2{font-size:1.3rem;margin:2.5rem 0 1rem;border-bottom:1px solid var(--line);padding-bottom:.3rem}h4{margin:.5rem 0 .25rem;font-size:.9rem;color:var(--muted)}\n"
  )
  put(
    &mut b,
    ".count{font-size:.85rem;color:var(--muted);font-weight:400}.base{color:var(--muted);font-size:.9rem}\n"
  )
  put(
    &mut b,
    ".entry{border:1px solid var(--line);border-radius:8px;padding:.75rem 1rem;margin:0 0 1rem}\n"
  )
  put(
    &mut b,
    ".badge{display:inline-block;font-size:.75rem;padding:.05rem .5rem;border-radius:999px;background:var(--badge);color:var(--muted);margin-right:.4rem}\n"
  )
  put(&mut b, ".badge.breaking{background:var(--warn-bg);color:var(--warn-fg);font-weight:600}\n")
  put(
    &mut b,
    ".migration{margin-top:.75rem;padding:.5rem .75rem;border-left:3px solid var(--warn-fg);background:var(--warn-bg)}\n"
  )
  put(&mut b, ".details{color:var(--muted)}p,ul{margin:.5rem 0}a{color:var(--link)}\n")
  put(
    &mut b,
    "code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.88em;background:var(--code-bg);color:var(--code-fg);padding:.1em .35em;border-radius:4px}\n"
  )
  put(
    &mut b,
    "pre{background:var(--code-bg);padding:.75rem 1rem;border-radius:6px;overflow-x:auto}pre code{background:none;color:var(--fg);padding:0;font-size:.85em}\n"
  )
  Text::of(b)
}

fn entry_html(&mut b: Buf, e: Entry): Unit {
  put(&mut b, "<article class='entry'><div class='meta'>")
  if same(e.area, "") {
    #()
  } else {
    put(&mut b, "<span class='badge'>")
    esc_push(&mut b, e.area, 0, Text::len(e.area))
    put(&mut b, "</span>")
  }
  if e.breaking {
    put(&mut b, "<span class='badge breaking'>breaking</span>")
  } else {
    #()
  }
  put(&mut b, "</div>\n<div class='summary'>")
  put(&mut b, markdown(e.summary))
  put(&mut b, "</div>\n")
  if is_blank(e.details) {
    #()
  } else {
    put(&mut b, "<div class='details'>")
    put(&mut b, markdown(e.details))
    put(&mut b, "</div>\n")
  }
  if is_blank(e.migration) {
    #()
  } else {
    put(&mut b, "<div class='migration'><h4>Migration</h4>")
    put(&mut b, markdown(e.migration))
    put(&mut b, "</div>\n")
  }
  put(&mut b, "</article>\n")
}

fn count_kind(es: List(Entry), k: u64): u64 {
  var rest := es
  var n: u64 := 0
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(e, more) => {
        if e.kind == k {
          n := n + 1
        } else {
          #()
        }
        rest := more
      }
    }
  }
  n
}

// The section of the entries of kind `k`; nothing when there are none.
fn section(&mut b: Buf, es: List(Entry), k: u64): Unit {
  let n := count_kind(es, k)
  if n > 0 {
    put(&mut b, "<section>\n<h2>")
    put(&mut b, kind_name(k))
    put(&mut b, " <span class='count'>(")
    put(&mut b, Text::of_u64(n))
    put(&mut b, ")</span></h2>\n")
    var rest := es
    var running := true
    while running {
      match rest {
        Nil => {
          running := false
        }
        Cons(e, more) => {
          if e.kind == k {
            entry_html(&mut b, e)
          } else {
            #()
          }
          rest := more
        }
      }
    }
    put(&mut b, "</section>\n")
  } else {
    #()
  }
}

fn page(date: Text, c: Changelog): Text {
  var b := Buf::new()
  let title := join2("tauto changelog ", date)
  put(&mut b, "<!doctype html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n")
  put(&mut b, "<meta name='viewport' content='width=device-width,initial-scale=1'>\n<title>")
  esc_push(&mut b, title, 0, Text::len(title))
  put(&mut b, "</title>\n<style>\n")
  put(&mut b, css())
  put(&mut b, "</style>\n</head>\n<body>\n<main>\n<h1>")
  esc_push(&mut b, title, 0, Text::len(title))
  put(&mut b, "</h1>\n<p class='base'>Base commit: <code>")
  esc_push(&mut b, c.base, 0, Text::len(c.base))
  put(&mut b, "</code></p>\n<div class='release-summary'>")
  put(&mut b, markdown(c.summary))
  put(&mut b, "</div>\n")
  section(&mut b, c.entries, 1)
  section(&mut b, c.entries, 2)
  section(&mut b, c.entries, 3)
  section(&mut b, c.entries, 4)
  section(&mut b, c.entries, 5)
  section(&mut b, c.entries, 6)
  put(&mut b, "</main>\n</body>\n</html>\n")
  Text::of(b)
}

// The file name of `path` without its directory and its `.eure`.
fn file_date(path: Text): Text {
  var start: u64 := 0
  var i: u64 := 0
  while i < Text::len(path) {
    if byte_at(path, i) == 47 {
      start := i + 1
    } else {
      #()
    }
    i := i + 1
  }
  let name := sub(path, start, Text::len(path))
  let n := Text::len(name)
  if n >= 5 {
    if same(sub(name, n - 5, n), ".eure") {
      sub(name, 0, n - 5)
    } else {
      name
    }
  } else {
    name
  }
}

// --- Entry point ----------------------------------------------------------

fn run(args: List(Text)): Unit ! {fs_read, fs_write, stdout, stderr, Div} {
  match args {
    Cons(input, Cons(output, Nil)) => match read_file(input) {
      Err(why) => eprint(join2("cannot read the changelog: ", why))
      Ok(src) => match write_file(output, page(file_date(input), parse(src))) {
        Err(why) => eprint(join2("cannot write the page: ", why))
        Ok(done) => print(join2(output, "\n"))
      }
    }
    Nil => eprint("usage: changelog-to-html IN.eure OUT.html\n")
    Cons(only, Nil) => eprint("usage: changelog-to-html IN.eure OUT.html\n")
    Cons(first, Cons(second, Cons(more, rest))) => eprint("usage: changelog-to-html IN.eure OUT.html\n")
  }
}

run(perform argv())
