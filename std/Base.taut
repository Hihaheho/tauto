import "Std.taut"

// What programs of the proof language compute with:
// decisions, comparisons of numbers, and the lemmas that connect them to
// propositions. Extraction maps `Yn` onto Nib's `Bool`, `Nat` onto `u64`
// and the comparisons onto Nib's operators; the definitions here are what
// the proofs see.

// A decision: what a program branches on. (`Bool` is the kernel's own
// constant and has no eliminator.)
inductive Yn(): Type {
  no(): Yn
  yes(): Yn
}

// The answer of a comparison.
inductive Ordering(): Type {
  Less(): Ordering
  Equal(): Ordering
  Greater(): Ordering
}

fn yn_and(a: Yn, b: Yn) -> Yn {
  match a -> Yn {
    no => no
    yes => b
  }
}

fn yn_or(a: Yn, b: Yn) -> Yn {
  match a -> Yn {
    no => b
    yes => yes
  }
}

fn yn_not(a: Yn) -> Yn {
  match a -> Yn {
    no => yes
    yes => no
  }
}

fn yn_eq(a: Yn, b: Yn) -> Yn {
  match a -> Yn {
    no => yn_not(b)
    yes => b
  }
}

fn nat_eq(a: Nat, b: Nat) -> Yn {
  match a -> Yn {
    zero => match b -> Yn {
      zero => yes
      succ(b2) => no
    }
    succ(a2) => match b -> Yn {
      zero => no
      succ(b2) => nat_eq(a2, b2)
    }
  }
}

fn nat_lt(a: Nat, b: Nat) -> Yn {
  match a -> Yn {
    zero => match b -> Yn {
      zero => no
      succ(b2) => yes
    }
    succ(a2) => match b -> Yn {
      zero => no
      succ(b2) => nat_lt(a2, b2)
    }
  }
}

fn nat_le(a: Nat, b: Nat) -> Yn {
  nat_lt(a, succ(b))
}

// `nat_add` and `nat_mul` are the kernel's `+` and `*` under another name (and `+` and `*`
// are never read as anything else), so the kernel's reductions are theirs: `+` reduces by
// either operand, `*` by its first. Extraction maps them onto Nib's operators. `nat_sub` is
// by recursion on the second argument, so that the kernel computes it on any numbers (its
// own `-` computes on literals only).

fn nat_pred(n: Nat) -> Nat {
  match n -> Nat {
    zero => zero
    succ(k) => k
  }
}

fn nat_add(a: Nat, b: Nat) -> Nat {
  a + b
}

// `a - b`, or 0 when `b` is larger.
fn nat_sub(a: Nat, b: Nat) -> Nat {
  match b -> Nat {
    zero => a
    succ(k) => nat_pred(nat_sub(a, k))
  }
}

fn nat_mul(a: Nat, b: Nat) -> Nat {
  a * b
}

fn nat_max(a: Nat, b: Nat) -> Nat {
  match nat_lt(a, b) -> Nat {
    no => a
    yes => b
  }
}

fn nat_min(a: Nat, b: Nat) -> Nat {
  match nat_lt(a, b) -> Nat {
    no => b
    yes => a
  }
}

// `a` divided by `b` from a running quotient `q` and remainder `r`: each
// of the `a` steps adds one to `r`, and a remainder that reaches `b` is
// one more in the quotient. (One recursive call per step, so the kernel's
// reduction stays linear.)
fn nat_divmod(a: Nat, b: Nat, q: Nat, r: Nat) -> Pair(Nat, Nat) {
  match a -> Pair(Nat, Nat) {
    zero => pair(q, r)
    succ(a2) => match nat_eq(succ(r), b) -> Pair(Nat, Nat) {
      no => nat_divmod(a2, b, q, succ(r))
      yes => nat_divmod(a2, b, succ(q), zero)
    }
  }
}

// `a div b`, rounded down; 0 when `b` is 0.
fn nat_div(a: Nat, b: Nat) -> Nat {
  match nat_divmod(a, b, zero, zero) -> Nat {
    pair(q, r) => q
  }
}

// `a mod b`; `a` when `b` is 0.
fn nat_mod(a: Nat, b: Nat) -> Nat {
  match nat_divmod(a, b, zero, zero) -> Nat {
    pair(q, r) => r
  }
}

// ---- lists ------------------------------------------------------------------

fn list_length<A>(l: List(A)) -> Nat {
  match l -> Nat {
    Nil => zero
    Cons(h, t) => succ(list_length(t))
  }
}

fn list_append<A>(l: List(A), m: List(A)) -> List(A) {
  match l -> List(A) {
    Nil => m
    Cons(h, t) => Cons(h, list_append(t, m))
  }
}

fn list_reverse_onto<A>(l: List(A), acc: List(A)) -> List(A) {
  match l -> List(A) {
    Nil => acc
    Cons(h, t) => list_reverse_onto(t, Cons(h, acc))
  }
}

fn list_reverse<A>(l: List(A)) -> List(A) {
  list_reverse_onto(l, Nil)
}

fn list_map<A, B>(f: (A) -> B, l: List(A)) -> List(B) {
  match l -> List(B) {
    Nil => Nil
    Cons(h, t) => Cons(f(h), list_map(f, t))
  }
}

// The first `n` elements (all of them when there are fewer).
fn list_take<A>(n: Nat, l: List(A)) -> List(A) {
  match n -> List(A) {
    zero => Nil
    succ(k) => match l -> List(A) {
      Nil => Nil
      Cons(h, t) => Cons(h, list_take(k, t))
    }
  }
}

// What is left after the first `n` elements.
fn list_drop<A>(n: Nat, l: List(A)) -> List(A) {
  match n -> List(A) {
    zero => l
    succ(k) => match l -> List(A) {
      Nil => Nil
      Cons(h, t) => list_drop(k, t)
    }
  }
}

// The `i`th element, counted from 0.
fn list_nth<A>(l: List(A), i: Nat) -> Option(A) {
  match l -> Option(A) {
    Nil => None
    Cons(h, t) => match i -> Option(A) {
      zero => Some(h)
      succ(j) => list_nth(t, j)
    }
  }
}

// ---- decisions and propositions ---------------------------------------------

theorem yes_ne_no(e: Eq(Yn, yes, no)): False {
  match e -> False {
  }
}

theorem nat_eq_refl(n: Nat): Eq(Yn, nat_eq(n, n), yes) {
  match n -> Eq(Yn, nat_eq(n, n), yes) {
    zero => refl()
    succ(k) => nat_eq_refl(k)
  }
}

theorem nat_eq_sound(a: Nat, b: Nat, e: Eq(Yn, nat_eq(a, b), yes)): Eq(Nat, a, b) {
  match a -> Eq(Nat, a, b) {
    zero => match b -> Eq(Nat, zero, b) {
      zero => refl()
      succ(b2) => False_elim(yes_ne_no(Eq_sym(e)))
    }
    succ(a2) => match b -> Eq(Nat, succ(a2), b) {
      zero => False_elim(yes_ne_no(Eq_sym(e)))
      succ(b2) => Eq_congr(succ, nat_eq_sound(a2, b2, e))
    }
  }
}

// Case analysis on a term `o`: `P(o)` from each case, given that `o` is it.
// `P` is written with a `match` on its parameter, so a goal that unfolds to
// a `match` on `o` is `P(o)`.
theorem ordering_cases(
  P: (Ordering) -> Prop,
  o: Ordering,
  a: (Eq(Ordering, o, Less)) -> P(Less),
  b: (Eq(Ordering, o, Equal)) -> P(Equal),
  c: (Eq(Ordering, o, Greater)) -> P(Greater)
): P(o) {
  match o -> P(o) {
    Less => a(refl())
    Equal => b(refl())
    Greater => c(refl())
  }
}

theorem yn_cases(
  P: (Yn) -> Prop,
  o: Yn,
  a: (Eq(Yn, o, no)) -> P(no),
  b: (Eq(Yn, o, yes)) -> P(yes)
): P(o) {
  match o -> P(o) {
    no => a(refl())
    yes => b(refl())
  }
}

theorem less_ne_equal(e: Eq(Ordering, Less, Equal)): False {
  match e -> False {
  }
}

theorem less_ne_greater(e: Eq(Ordering, Less, Greater)): False {
  match e -> False {
  }
}

theorem equal_ne_less(e: Eq(Ordering, Equal, Less)): False {
  match e -> False {
  }
}

theorem equal_ne_greater(e: Eq(Ordering, Equal, Greater)): False {
  match e -> False {
  }
}

theorem greater_ne_less(e: Eq(Ordering, Greater, Less)): False {
  match e -> False {
  }
}

theorem greater_ne_equal(e: Eq(Ordering, Greater, Equal)): False {
  match e -> False {
  }
}

theorem list_append_assoc<A: Type>(
  a: List(A),
  b: List(A),
  c: List(A)
): Eq(List(A), list_append(list_append(a, b), c), list_append(a, list_append(b, c))) {
  match a -> Eq(List(A), list_append(list_append(a, b), c), list_append(a, list_append(b, c))) {
    Nil => refl()
    Cons(h, t) => Eq_congr((z: List(A)) => Cons(h, z), list_append_assoc(t, b, c))
  }
}

theorem no_ne_yes(e: Eq(Yn, no, yes)): False {
  yes_ne_no(Eq_sym(e))
}

theorem yn_eq_refl(a: Yn): Eq(Yn, yn_eq(a, a), yes) {
  match a -> Eq(Yn, yn_eq(a, a), yes) {
    no => refl()
    yes => refl()
  }
}

theorem yn_eq_sound(a: Yn, b: Yn, e: Eq(Yn, yn_eq(a, b), yes)): Eq(Yn, a, b) {
  match a -> Eq(Yn, a, b) {
    no => match b -> Eq(Yn, no, b) {
      no => refl()
      yes => False_elim(no_ne_yes(e))
    }
    yes => match b -> Eq(Yn, yes, b) {
      no => False_elim(no_ne_yes(e))
      yes => refl()
    }
  }
}

theorem yn_and_intro(
  p: Yn,
  q: Yn,
  hp: Eq(Yn, p, yes),
  hq: Eq(Yn, q, yes)
): Eq(Yn, yn_and(p, q), yes) {
  match p -> Eq(Yn, yn_and(p, q), yes) {
    no => False_elim(no_ne_yes(hp))
    yes => hq
  }
}

theorem yn_and_split(
  p: Yn,
  q: Yn,
  e: Eq(Yn, yn_and(p, q), yes)
): And(Eq(Yn, p, yes), Eq(Yn, q, yes)) {
  match p -> And(Eq(Yn, p, yes), Eq(Yn, q, yes)) {
    no => False_elim(no_ne_yes(e))
    yes => and_intro(refl(), e)
  }
}

theorem nat_lt_irrefl(a: Nat): Eq(Yn, nat_lt(a, a), no) {
  match a -> Eq(Yn, nat_lt(a, a), no) {
    zero => refl()
    succ(a2) => nat_lt_irrefl(a2)
  }
}

theorem nat_lt_asym(a: Nat, b: Nat, h: Eq(Yn, nat_lt(a, b), yes)): Eq(Yn, nat_lt(b, a), no) {
  match a -> Eq(Yn, nat_lt(b, a), no) {
    zero => match b {
      zero => refl()
      succ(b2) => refl()
    }
    succ(a2) => match b {
      zero => False_elim(no_ne_yes(h))
      succ(b2) => nat_lt_asym(a2, b2, h)
    }
  }
}

theorem nat_lt_trans(
  a: Nat,
  b: Nat,
  c: Nat,
  h1: Eq(Yn, nat_lt(a, b), yes),
  h2: Eq(Yn, nat_lt(b, c), yes)
): Eq(Yn, nat_lt(a, c), yes) {
  match a -> Eq(Yn, nat_lt(a, c), yes) {
    zero => match c {
      zero => match b {
        zero => False_elim(no_ne_yes(h2))
        succ(b2) => False_elim(no_ne_yes(h2))
      }
      succ(c2) => refl()
    }
    succ(a2) => match b {
      zero => False_elim(no_ne_yes(h1))
      succ(b2) => match c {
        zero => False_elim(no_ne_yes(h2))
        succ(c2) => nat_lt_trans(a2, b2, c2, h1, h2)
      }
    }
  }
}

// Neither is less than the other: they are equal.
theorem nat_lt_total(
  a: Nat,
  b: Nat,
  h1: Eq(Yn, nat_lt(a, b), no),
  h2: Eq(Yn, nat_lt(b, a), no)
): Eq(Nat, a, b) {
  match a -> Eq(Nat, a, b) {
    zero => match b {
      zero => refl()
      succ(b2) => False_elim(yes_ne_no(h1))
    }
    succ(a2) => match b {
      zero => False_elim(yes_ne_no(h2))
      succ(b2) => Eq_congr(succ, nat_lt_total(a2, b2, h1, h2))
    }
  }
}
