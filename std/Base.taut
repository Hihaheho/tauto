import std::prelude::Std { List, Option, Ordering }

module Bool {
  // What programs of the proof language compute with:
  // decisions, comparisons of numbers, and the lemmas that connect them to
  // propositions. Extraction maps `Bool` onto Nib's `Bool`, `Nat` onto `u64`
  // and the comparisons onto Nib's operators; the definitions here are what
  // the proofs see. `Bool`, `Nat::eq`, `Nat::lt`, `Nat::pred`, `Nat::sub`, `Nat::div` and
  // `Nat::rem` are the kernel's own (its prelude): it computes them at once on
  // numerals. `Bool::and`, `not`, `Bool::eq` and the lemmas a generated decidable
  // equality uses (`Nat::eq_refl`, `Nat::eq_sound`, `Bool::eq_refl`, `Bool::eq_sound`,
  // `Bool::and_intro`, `Bool::and_split`, `true_ne_false`, `false_ne_true`) are the
  // kernel's prelude too.

  pub fn or(a: Bool, b: Bool): Bool {
    ⊢ Bool from match a { false => b, true => true }
  }

  pub theorem cases(
    P: (Bool) -> Prop,
    o: Bool,
    a: (o = false) -> P(false),
    b: (o = true) -> P(true)
  ): P(o) {
    ⊢ P(o) from match o {
      false => a(Refl)
      true => b(Refl)
    }
  }

  pub theorem or_true_left(a: Bool, b: Bool, h: a = true): a || b = true {
    ⊢ a || b = true from match a {
      false => False::elim(false_ne_true(h))
      true => Refl
    }
  }

  pub theorem or_true_right(a: Bool, b: Bool, h: b = true): a || b = true {
    ⊢ a || b = true from match a { false => h, true => Refl }
  }

  pub theorem or_false_right(a: Bool, b: Bool, h: b = false): a || b = a {
    ⊢ a || b = a from match a { false => h, true => Refl }
  }

  pub theorem or_false_split(a: Bool, b: Bool, h: a || b = false): a = false ∧ b = false {
    ⊢ a = false ∧ b = false from match a {
      false => AndIntro(Refl, h)
      true => False::elim(true_ne_false(h))
    }
  }

  pub theorem or_comm(a: Bool, b: Bool): a || b = b || a {
    ⊢ a || b = b || a from match a {
      false => ⊢ b = b || false from match b { false => Refl, true => Refl }
      true => ⊢ true = b || true from match b { false => Refl, true => Refl }
    }
  }

  pub theorem or_assoc(a: Bool, b: Bool, c: Bool): a || b || c = a || (b || c) {
    ⊢ a || b || c = a || (b || c) from match a { false => Refl, true => Refl }
  }

  pub theorem or_absorb(a: Bool, b: Bool): a || (a && b) = a {
    ⊢ a || (a && b) = a from match a { false => Refl, true => Refl }
  }

  pub theorem and_true_left(a: Bool, b: Bool, h: a && b = true): a = true {
    ⊢ a = true from match a {
      false => False::elim(false_ne_true(h))
      true => Refl
    }
  }

  pub theorem and_true_right(a: Bool, b: Bool, h: a && b = true): b = true {
    ⊢ b = true from match a {
      false => False::elim(false_ne_true(h))
      true => h
    }
  }

  pub theorem and_false_right(a: Bool): a && false = false {
    ⊢ a && false = false from match a { false => Refl, true => Refl }
  }

  pub theorem and_comm(a: Bool, b: Bool): a && b = b && a {
    ⊢ a && b = b && a from match a {
      false => ⊢ false = b && false from match b { false => Refl, true => Refl }
      true => ⊢ b = b && true from match b { false => Refl, true => Refl }
    }
  }

  pub theorem and_assoc(a: Bool, b: Bool, c: Bool): a && b && c = a && (b && c) {
    ⊢ a && b && c = a && (b && c) from match a { false => Refl, true => Refl }
  }

  pub theorem and_absorb(a: Bool, b: Bool): a && (a || b) = a {
    ⊢ a && (a || b) = a from match a { false => Refl, true => Refl }
  }

  pub theorem not_true(a: Bool, h: not(a) = true): a = false {
    ⊢ a = false from match a {
      false => Refl
      true => False::elim(false_ne_true(h))
    }
  }

  pub theorem not_false(a: Bool, h: not(a) = false): a = true {
    ⊢ a = true from match a {
      false => False::elim(true_ne_false(h))
      true => Refl
    }
  }

  pub theorem not_of_false(a: Bool, h: a = false): not(a) = true {
    ⊢ not(a) = true from match a {
      false => Refl
      true => False::elim(true_ne_false(h))
    }
  }
}

module Nat {
  pub fn le(a: Nat, b: Nat): Bool {
    lt(a, Succ(b))
  }

  // `b` is not 0 when `Nat::eq` says so: the divisor of `Nat::div_nz` and
  // `Nat::rem_nz`, which for a numeral is `ne_zero(64, Refl)`.
  pub theorem ne_zero(b: Nat, h: Nat::eq(b, 0) = false): ¬(b = 0) {
    (e: b = 0) => true_ne_false(Eq::trans(Eq::sym(Eq::congr(⟦Nat::eq(□, 0)⟧, e)), h))
  }

  pub theorem succ_ne_zero(k: Nat): ¬(Succ(k) = 0) {
    ne_zero(Succ(k), Refl)
  }

  pub theorem ne_zero_of_pos(b: Nat, h: 0 < b = true): ¬(b = 0) {
    (e: b = 0) => true_ne_false(Eq::trans(Eq::sym(h), Eq::congr(⟦Nat::lt(0, □)⟧, e)))
  }

  // `Nat::add` and `Nat::mul` are the kernel's `+` and `*` under another name (and `+` and `*`
  // are never read as anything else). Those recurse on the second operand: `a + Succ(k)` is
  // `Succ(a + k)` and `a * Succ(k)` is `a * k + a`; on two numerals the kernel computes the
  // same value at once. Extraction maps them onto Nib's operators. `Nat::sub` recurses on the
  // second argument too.

  pub fn add(a: Nat, b: Nat): Nat {
    a + b
  }

  pub fn mul(a: Nat, b: Nat): Nat {
    a * b
  }

  pub fn max(a: Nat, b: Nat): Nat {
    ⊢ Nat from match lt(a, b) { false => a, true => b }
  }

  pub fn min(a: Nat, b: Nat): Nat {
    ⊢ Nat from match lt(a, b) { false => b, true => a }
  }

  pub theorem lt_irrefl(a: Nat): lt(a, a) = false {
    ⊢ lt(a, a) = false from match a {
      Zero => Refl
      Succ(a2) => lt_irrefl(a2)
    }
  }

  pub theorem lt_asym(a: Nat, b: Nat, h: lt(a, b) = true): lt(b, a) = false {
    ⊢ lt(b, a) = false from match a {
      Zero => match b {
        Zero => Refl
        Succ(_) => Refl
      }
      Succ(a2) => match b {
        Zero => False::elim(false_ne_true(h))
        Succ(b2) => lt_asym(a2, b2, h)
      }
    }
  }

  pub theorem lt_trans(
    a: Nat,
    b: Nat,
    c: Nat,
    h1: lt(a, b) = true,
    h2: lt(b, c) = true
  ): lt(a, c) = true {
    ⊢ lt(a, c) = true from match a {
      Zero => match c {
        Zero => match b {
          Zero => False::elim(false_ne_true(h2))
          Succ(b2) => False::elim(false_ne_true(h2))
        }
        Succ(_) => Refl
      }
      Succ(a2) => match b {
        Zero => False::elim(false_ne_true(h1))
        Succ(b2) => match c {
          Zero => False::elim(false_ne_true(h2))
          Succ(c2) => lt_trans(a2, b2, c2, h1, h2)
        }
      }
    }
  }

  // Neither is less than the other: they are equal.
  pub theorem lt_total(a: Nat, b: Nat, h1: lt(a, b) = false, h2: lt(b, a) = false): a = b {
    ⊢ a = b from match a {
      Zero => match b {
        Zero => Refl
        Succ(b2) => False::elim(true_ne_false(h1))
      }
      Succ(a2) => match b {
        Zero => False::elim(true_ne_false(h2))
        Succ(b2) => Eq::congr(Succ, lt_total(a2, b2, h1, h2))
      }
    }
  }
}

module List {

  pub fn length<A>(l: List(A)): Nat {
    ⊢ Nat from match l {
      Nil => Zero
      Cons(h, t) => Succ(List::length(t))
    }
  }

  pub fn append<A>(l: List(A), m: List(A)): List(A) {
    ⊢ List(A) from match l {
      Nil => m
      Cons(h, t) => Cons(h, List::append(t, m))
    }
  }

  pub fn reverse_onto<A>(l: List(A), acc: List(A)): List(A) {
    ⊢ List(A) from match l {
      Nil => acc
      Cons(h, t) => reverse_onto(t, Cons(h, acc))
    }
  }

  pub fn reverse<A>(l: List(A)): List(A) {
    reverse_onto(l, Nil)
  }

  pub fn map<A, B>(f: (A) -> B, l: List(A)): List(B) {
    ⊢ List(B) from match l {
      Nil => Nil
      Cons(h, t) => Cons(f(h), List::map(f, t))
    }
  }

  // The first `n` elements (all of them when there are fewer).
  pub fn take<A>(n: Nat, l: List(A)): List(A) {
    ⊢ List(A) from match n {
      Zero => Nil
      Succ(k) => ⊢ List(A) from match l {
        Nil => Nil
        Cons(h, t) => Cons(h, take(k, t))
      }
    }
  }

  pub fn drop<A>(n: Nat, l: List(A)): List(A) {
    ⊢ List(A) from match n {
      Zero => l
      Succ(k) => ⊢ List(A) from match l {
        Nil => Nil
        Cons(h, t) => drop(k, t)
      }
    }
  }

  // The `i`th element, counted from 0.
  pub fn nth<A>(l: List(A), i: Nat): Option(A) {
    ⊢ Option(A) from match l {
      Nil => None
      Cons(h, t) => ⊢ Option(A) from match i {
        Zero => Some(h)
        Succ(j) => nth(t, j)
      }
    }
  }

  pub theorem append_assoc<A: Type>(
    a: List(A),
    b: List(A),
    c: List(A)
  ): List::append(List::append(a, b), c) = List::append(a, List::append(b, c)) {
    ⊢ List::append(List::append(a, b), c) = List::append(a, List::append(b, c)) from match a {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(h, □)⟧, append_assoc(t, b, c))
    }
  }
}

module Ordering {

  // Case analysis on a term `o`: `P(o)` from each case, given that `o` is it.
  // `P` is written with a `match` on its parameter, so a goal that unfolds to
  // a `match` on `o` is `P(o)`.
  pub theorem cases(
    P: (Ordering) -> Prop,
    o: Ordering,
    a: (o = Less) -> P(Less),
    b: (o = Equal) -> P(Equal),
    c: (o = Greater) -> P(Greater)
  ): P(o) {
    ⊢ P(o) from match o {
      Less => a(Refl)
      Equal => b(Refl)
      Greater => c(Refl)
    }
  }
}
