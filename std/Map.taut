import "Base.taut" { Nat }
import "Text.taut" { Text }
import std::prelude::Std { List, Option, Ordering }

// An ordered map: an AVL tree, persistent (`docs/design/self-host.md`), in
// the proof language (`docs/design/self-host.md`). The order is the `cmp` given at
// every call. A set is an `Ordmap(K, Unit)`.

pub(open) inductive OrdmapTree(K: Type, V: Type): Type {
  OrdmapLeaf: OrdmapTree(K, V)
  OrdmapNode(l: OrdmapTree(K, V), k: K, v: V, r: OrdmapTree(K, V), h: Nat): OrdmapTree(K, V)
}

pub(open) inductive Ordmap(K: Type, V: Type): Type {
  Mk(tree: OrdmapTree(K, V), size: Nat): Ordmap(K, V)
}

module Ordmap {
  pub fn tree<K, V>(m: Ordmap(K, V)): OrdmapTree(K, V) {
    match m: OrdmapTree(K, V) {
      Mk(t, _) => t
    }
  }

  pub fn size<K, V>(m: Ordmap(K, V)): Nat {
    match m: Nat {
      Mk(_, n) => n
    }
  }

  pub fn empty<K, V>(): Ordmap(K, V) {
    Ordmap::Mk(OrdmapLeaf, 0)
  }

  pub fn compare_text(a: Text, b: Text): Ordering {
    Text::ordering(a, b)
  }

  // `less` when the first is before, else `greater` when the second is.
  pub fn select(before: Bool, after: Bool): Ordering {
    match before: Ordering {
      true => Less
      false => match after: Ordering {
        true => Greater
        false => Equal
      }
    }
  }

  pub fn compare_nat(a: Nat, b: Nat): Ordering {
    select(a < b, b < a)
  }

  pub fn tree_height<K, V>(t: OrdmapTree(K, V)): Nat {
    match t: Nat {
      OrdmapLeaf => 0
      OrdmapNode(l, k, v, r, h) => h
    }
  }

  // The height of the tree of `m`: at most 1.45 * log2(size + 2).
  pub fn height<K, V>(m: Ordmap(K, V)): Nat {
    tree_height(tree(m))
  }

  pub fn node<K, V>(l: OrdmapTree(K, V), k: K, v: V, r: OrdmapTree(K, V)): OrdmapTree(K, V) {
    OrdmapNode(l, k, v, r, Succ(Nat::max(tree_height(l), tree_height(r))))
  }

  // A node whose right tree is the taller by two: the right child comes up.
  pub fn rotate_left<K, V>(l: OrdmapTree(K, V), k: K, v: V, r: OrdmapTree(K, V)): OrdmapTree(K, V) {
    match r: OrdmapTree(K, V) {
      OrdmapLeaf => node(l, k, v, r)
      OrdmapNode(rl, rk, rv, rr, rh) => node(node(l, k, v, rl), rk, rv, rr)
    }
  }

  pub fn rotate_right<K, V>(
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V)
  ): OrdmapTree(K, V) {
    match l: OrdmapTree(K, V) {
      OrdmapLeaf => node(l, k, v, r)
      OrdmapNode(ll, lk, lv, lr, lh) => node(ll, lk, lv, node(lr, k, v, r))
    }
  }

  // The node of a left tree taller by two, `OrdmapNode(ll, lk, lv, lr, lh)`;
  // `c` says whether its left side is the taller (`height(lr) <=
  // height(ll)`). The decisions are parameters so the theorems below can
  // take each case.
  pub fn fix_left_by<K, V>(
    c: Bool,
    ll: OrdmapTree(K, V),
    lk: K,
    lv: V,
    lr: OrdmapTree(K, V),
    lh: Nat,
    k: K,
    v: V,
    r: OrdmapTree(K, V)
  ): OrdmapTree(K, V) {
    match c: OrdmapTree(K, V) {
      true => rotate_right(OrdmapNode(ll, lk, lv, lr, lh), k, v, r)
      false => rotate_right(rotate_left(ll, lk, lv, lr), k, v, r)
    }
  }

  pub fn fix_left<K, V>(l: OrdmapTree(K, V), k: K, v: V, r: OrdmapTree(K, V)): OrdmapTree(K, V) {
    match l: OrdmapTree(K, V) {
      OrdmapLeaf => node(l, k, v, r)
      OrdmapNode(ll, lk, lv, lr, lh) => fix_left_by(
        tree_height(lr) <= tree_height(ll),
        ll,
        lk,
        lv,
        lr,
        lh,
        k,
        v,
        r
      )
    }
  }

  // The mirror of `fix_left_by`: `r` is `OrdmapNode(rl, rk, rv, rr, rh)`.
  pub fn fix_right_by<K, V>(
    c: Bool,
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    rl: OrdmapTree(K, V),
    rk: K,
    rv: V,
    rr: OrdmapTree(K, V),
    rh: Nat
  ): OrdmapTree(K, V) {
    match c: OrdmapTree(K, V) {
      true => rotate_left(l, k, v, OrdmapNode(rl, rk, rv, rr, rh))
      false => rotate_left(l, k, v, rotate_right(rl, rk, rv, rr))
    }
  }

  pub fn fix_right<K, V>(l: OrdmapTree(K, V), k: K, v: V, r: OrdmapTree(K, V)): OrdmapTree(K, V) {
    match r: OrdmapTree(K, V) {
      OrdmapLeaf => node(l, k, v, r)
      OrdmapNode(rl, rk, rv, rr, rh) => fix_right_by(
        tree_height(rl) <= tree_height(rr),
        l,
        k,
        v,
        rl,
        rk,
        rv,
        rr,
        rh
      )
    }
  }

  // `left` says the left tree is taller by two, `right` the right one.
  pub fn balance_by<K, V>(
    left: Bool,
    right: Bool,
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V)
  ): OrdmapTree(K, V) {
    match left: OrdmapTree(K, V) {
      true => fix_left(l, k, v, r)
      false => match right: OrdmapTree(K, V) {
        true => fix_right(l, k, v, r)
        false => node(l, k, v, r)
      }
    }
  }

  // The node of `l`, `k`, `v` and `r` when their heights differ by at most two.
  pub fn balance<K, V>(l: OrdmapTree(K, V), k: K, v: V, r: OrdmapTree(K, V)): OrdmapTree(K, V) {
    balance_by(
      Succ(tree_height(r)) < tree_height(l),
      Succ(tree_height(l)) < tree_height(r),
      l,
      k,
      v,
      r
    )
  }

  pub fn tree_get<K, V>(t: OrdmapTree(K, V), k: K, cmp: (K, K) -> Ordering): Option(V) {
    match t: Option(V) {
      OrdmapLeaf => None
      OrdmapNode(l, nk, nv, r, h) => match cmp(k, nk): Option(V) {
        Less => tree_get(l, k, cmp)
        Equal => Some(nv)
        Greater => tree_get(r, k, cmp)
      }
    }
  }

  pub fn get<K, V>(m: Ordmap(K, V), k: K, cmp: (K, K) -> Ordering): Option(V) {
    tree_get(tree(m), k, cmp)
  }

  pub fn contains<K, V>(m: Ordmap(K, V), k: K, cmp: (K, K) -> Ordering): Bool {
    match get(m, k, cmp): Bool {
      None => false
      Some(v) => true
    }
  }

  pub fn tree_insert<K, V>(
    t: OrdmapTree(K, V),
    k: K,
    v: V,
    cmp: (K, K) -> Ordering
  ): OrdmapTree(K, V) {
    match t: OrdmapTree(K, V) {
      OrdmapLeaf => node(OrdmapLeaf, k, v, OrdmapLeaf)
      OrdmapNode(l, nk, nv, r, h) => match cmp(k, nk): OrdmapTree(K, V) {
        Less => balance(tree_insert(l, k, v, cmp), nk, nv, r)
        Equal => OrdmapNode(l, k, v, r, h)
        Greater => balance(l, nk, nv, tree_insert(r, k, v, cmp))
      }
    }
  }

  // `m` with `v` at `k`; a value already at `k` is replaced.
  pub fn insert<K, V>(m: Ordmap(K, V), k: K, v: V, cmp: (K, K) -> Ordering): Ordmap(K, V) {
    Ordmap::Mk(
      tree_insert(tree(m), k, v, cmp),
      match contains(m, k, cmp): Nat {
        true => size(m)
        false => Succ(size(m))
      }
    )
  }

  pub fn tree_min<K, V>(t: OrdmapTree(K, V)): Option(K × V) {
    match t: Option(K × V) {
      OrdmapLeaf => None
      OrdmapNode(l, k, v, r, h) => match l: Option(K × V) {
        OrdmapLeaf => Some(#(k, v))
        OrdmapNode(ll, lk, lv, lr, lh) => tree_min(l)
      }
    }
  }

  pub fn tree_remove_min<K, V>(t: OrdmapTree(K, V)): OrdmapTree(K, V) {
    match t: OrdmapTree(K, V) {
      OrdmapLeaf => OrdmapLeaf
      OrdmapNode(l, k, v, r, h) => match l: OrdmapTree(K, V) {
        OrdmapLeaf => r
        OrdmapNode(ll, lk, lv, lr, lh) => balance(tree_remove_min(l), k, v, r)
      }
    }
  }

  // `l` and `r` joined, every key of `l` before every key of `r`.
  pub fn join<K, V>(l: OrdmapTree(K, V), r: OrdmapTree(K, V)): OrdmapTree(K, V) {
    match tree_min(r): OrdmapTree(K, V) {
      None => l
      Some(least) => match least: OrdmapTree(K, V) {
        #(lk, lv) => balance(l, lk, lv, tree_remove_min(r))
      }
    }
  }

  pub fn tree_remove<K, V>(t: OrdmapTree(K, V), k: K, cmp: (K, K) -> Ordering): OrdmapTree(K, V) {
    match t: OrdmapTree(K, V) {
      OrdmapLeaf => OrdmapLeaf
      OrdmapNode(l, nk, nv, r, h) => match cmp(k, nk): OrdmapTree(K, V) {
        Less => balance(tree_remove(l, k, cmp), nk, nv, r)
        Equal => join(l, r)
        Greater => balance(l, nk, nv, tree_remove(r, k, cmp))
      }
    }
  }

  pub fn remove<K, V>(m: Ordmap(K, V), k: K, cmp: (K, K) -> Ordering): Ordmap(K, V) {
    match contains(m, k, cmp): Ordmap(K, V) {
      true => Ordmap::Mk(tree_remove(tree(m), k, cmp), Nat::pred(size(m)))
      false => m
    }
  }

  pub fn tree_entries<K, V>(t: OrdmapTree(K, V), done: List(K × V)): List(K × V) {
    match t: List(K × V) {
      OrdmapLeaf => done
      OrdmapNode(l, k, v, r, h) => tree_entries(l, Cons(#(k, v), tree_entries(r, done)))
    }
  }

  // The entries, the least key first.
  pub fn entries<K, V>(m: Ordmap(K, V)): List(K × V) {
    tree_entries(tree(m), Nil)
  }

  pub fn tree_floor<K, V>(
    t: OrdmapTree(K, V),
    k: K,
    best: Option(K × V),
    cmp: (K, K) -> Ordering
  ): Option(K × V) {
    match t: Option(K × V) {
      OrdmapLeaf => best
      OrdmapNode(l, nk, nv, r, h) => match cmp(k, nk): Option(K × V) {
        Less => tree_floor(l, k, best, cmp)
        Equal => Some(#(nk, nv))
        Greater => tree_floor(r, k, Some(#(nk, nv)), cmp)
      }
    }
  }

  // The entry with the greatest key that is not after `k`.
  pub fn floor<K, V>(m: Ordmap(K, V), k: K, cmp: (K, K) -> Ordering): Option(K × V) {
    tree_floor(tree(m), k, None, cmp)
  }

  // What the tree holds, in order, is kept by every step that rebuilds it:
  // `tree_entries` of the result is that of the node it replaces.

  pub theorem rotate_left_entries<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(rotate_left(l, k, v, r), d) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
    match r: tree_entries(
      rotate_left(l, k, v, r),
      d
    ) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
      OrdmapLeaf => Refl
      OrdmapNode(rl, rk, rv, rr, rh) => Refl
    }
  }

  pub theorem rotate_right_entries<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(rotate_right(l, k, v, r), d) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
    match l: tree_entries(
      rotate_right(l, k, v, r),
      d
    ) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
      OrdmapLeaf => Refl
      OrdmapNode(ll, lk, lv, lr, lh) => Refl
    }
  }

  pub theorem fix_left_by_entries<K: Type, V: Type>(
    c: Bool,
    ll: OrdmapTree(K, V),
    lk: K,
    lv: V,
    lr: OrdmapTree(K, V),
    lh: Nat,
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(
    fix_left_by(c, ll, lk, lv, lr, lh, k, v, r),
    d
  ) = tree_entries(OrdmapNode(ll, lk, lv, lr, lh), Cons(#(k, v), tree_entries(r, d))) {
    match c: tree_entries(
      fix_left_by(c, ll, lk, lv, lr, lh, k, v, r),
      d
    ) = tree_entries(OrdmapNode(ll, lk, lv, lr, lh), Cons(#(k, v), tree_entries(r, d))) {
      true => Refl
      false => Eq::trans(
        rotate_right_entries(rotate_left(ll, lk, lv, lr), k, v, r, d),
        rotate_left_entries(ll, lk, lv, lr, Cons(#(k, v), tree_entries(r, d)))
      )
    }
  }

  pub theorem fix_right_by_entries<K: Type, V: Type>(
    c: Bool,
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    rl: OrdmapTree(K, V),
    rk: K,
    rv: V,
    rr: OrdmapTree(K, V),
    rh: Nat,
    d: List(K × V)
  ): tree_entries(
    fix_right_by(c, l, k, v, rl, rk, rv, rr, rh),
    d
  ) = tree_entries(l, Cons(#(k, v), tree_entries(OrdmapNode(rl, rk, rv, rr, rh), d))) {
    match c: tree_entries(
      fix_right_by(c, l, k, v, rl, rk, rv, rr, rh),
      d
    ) = tree_entries(l, Cons(#(k, v), tree_entries(OrdmapNode(rl, rk, rv, rr, rh), d))) {
      true => Refl
      false => Eq::trans(
        rotate_left_entries(l, k, v, rotate_right(rl, rk, rv, rr), d),
        Eq::congr(⟦tree_entries(l, Cons(#(k, v), □))⟧, rotate_right_entries(rl, rk, rv, rr, d))
      )
    }
  }

  pub theorem fix_left_entries<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(fix_left(l, k, v, r), d) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
    match l: tree_entries(
      fix_left(l, k, v, r),
      d
    ) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
      OrdmapLeaf => Refl
      OrdmapNode(ll, lk, lv, lr, lh) => fix_left_by_entries(
        tree_height(lr) <= tree_height(ll),
        ll,
        lk,
        lv,
        lr,
        lh,
        k,
        v,
        r,
        d
      )
    }
  }

  pub theorem fix_right_entries<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(fix_right(l, k, v, r), d) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
    match r: tree_entries(
      fix_right(l, k, v, r),
      d
    ) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
      OrdmapLeaf => Refl
      OrdmapNode(rl, rk, rv, rr, rh) => fix_right_by_entries(
        tree_height(rl) <= tree_height(rr),
        l,
        k,
        v,
        rl,
        rk,
        rv,
        rr,
        rh,
        d
      )
    }
  }

  pub theorem balance_right_entries<K: Type, V: Type>(
    right: Bool,
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(
    balance_by(false, right, l, k, v, r),
    d
  ) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
    match right: tree_entries(
      balance_by(false, right, l, k, v, r),
      d
    ) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
      true => fix_right_entries(l, k, v, r, d)
      false => Refl
    }
  }

  pub theorem balance_by_entries<K: Type, V: Type>(
    left: Bool,
    right: Bool,
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(
    balance_by(left, right, l, k, v, r),
    d
  ) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
    match left: tree_entries(
      balance_by(left, right, l, k, v, r),
      d
    ) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
      true => fix_left_entries(l, k, v, r, d)
      false => balance_right_entries(right, l, k, v, r, d)
    }
  }

  pub theorem balance_entries<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(balance(l, k, v, r), d) = tree_entries(l, Cons(#(k, v), tree_entries(r, d))) {
    balance_by_entries(
      Succ(tree_height(r)) < tree_height(l),
      Succ(tree_height(l)) < tree_height(r),
      l,
      k,
      v,
      r,
      d
    )
  }
}
