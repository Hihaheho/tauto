import "Base.taut" { Nat }
import "Nat.taut" { Nat }
import "Tactic.taut" { nat_norm }

module Nat {
  // Division and remainder. `Nat::div_nz` and `Nat::rem_nz` are the kernel's own
  // (`Base.taut`): it computes them at once on numerals, and they unfold to
  // `Nat::divmod`, which counts up to `n` one step at a time. These are the
  // laws that step gives: `b * (n / b) + n % b = n` (`div_mod_eq`),
  // `n % (b + 1) < b + 1` (`mod_succ_lt`), and that a quotient and remainder with
  // `r < b` are the ones division finds (`div_of`, `mod_of`).

  pub fn dm_step(b: Nat, p: Nat × Nat): Nat × Nat {
    match p: Nat × Nat {
      #(q, r) => match Succ(r) == b: Nat × Nat {
        false => #(q, Succ(r))
        true => #(Succ(q), Zero)
      }
    }
  }

  pub theorem divmod_succ(
    a: Nat,
    b: Nat,
    q: Nat,
    r: Nat
  ): Nat::divmod(Succ(a), b, q, r) = dm_step(b, Nat::divmod(a, b, q, r)) {
    match a: Nat::divmod(Succ(a), b, q, r) = dm_step(b, Nat::divmod(a, b, q, r)) {
      Zero => Refl
      Succ(a2) => match Succ(
        r
      ) == b: Nat::divmod(Succ(Succ(a2)), b, q, r) = dm_step(b, Nat::divmod(Succ(a2), b, q, r)) {
        false => ⊢ Nat::divmod(
          Succ(a2),
          b,
          q,
          Succ(r)
        ) = dm_step(b, Nat::divmod(a2, b, q, Succ(r))) from divmod_succ(a2, b, q, Succ(r))
        true => ⊢ Nat::divmod(
          Succ(a2),
          b,
          Succ(q),
          Zero
        ) = dm_step(b, Nat::divmod(a2, b, Succ(q), Zero)) from divmod_succ(a2, b, Succ(q), Zero)
      }
    }
  }

  pub fn dm_fst(p: Nat × Nat): Nat {
    match p: Nat {
      #(q, r) => q
    }
  }

  pub fn dm_snd(p: Nat × Nat): Nat {
    match p: Nat {
      #(q, r) => r
    }
  }

  pub fn bool_ind(y: Bool): Nat {
    match y: Nat {
      false => 0
      true => 1
    }
  }

  // `r + 1`, or 0 when it has reached the divisor (`e` says whether it has).
  pub fn wrap_succ(e: Bool, r: Nat): Nat {
    match e: Nat {
      false => Succ(r)
      true => Zero
    }
  }

  pub theorem snd_dm_step(
    b: Nat,
    p: Nat × Nat
  ): dm_snd(dm_step(b, p)) = wrap_succ(Succ(dm_snd(p)) == b, dm_snd(p)) {
    match p: dm_snd(dm_step(b, p)) = wrap_succ(Succ(dm_snd(p)) == b, dm_snd(p)) {
      #(q, r) => match Succ(r) == b: dm_snd(dm_step(b, #(q, r))) = wrap_succ(Succ(r) == b, r) {
        false => ⊢ dm_snd(#(q, Succ(r))) = wrap_succ(false, r) from Refl
        true => ⊢ dm_snd(#(Succ(q), Zero)) = wrap_succ(true, r) from Refl
      }
    }
  }

  pub theorem mod_succ(
    n: Nat,
    b: Nat,
    h: ¬(b = 0)
  ): Nat::rem_nz(Succ(n), b, h) = wrap_succ(Succ(Nat::rem_nz(n, b, h)) == b, Nat::rem_nz(n, b, h)) {
    Eq::trans(
      Eq::congr(dm_snd, divmod_succ(n, b, Zero, Zero)),
      snd_dm_step(b, Nat::divmod(n, b, Zero, Zero))
    )
  }

  pub theorem lt_succ_self(n: Nat): n < Succ(n) = true {
    match n: n < Succ(n) = true {
      Zero => Refl
      Succ(k) => lt_succ_self(k)
    }
  }

  pub theorem lt_of_succ_lt(a: Nat, b: Nat, h: Succ(a) < b = true): a < b = true {
    match a: a < b = true {
      Zero => match b: Zero < b = true {
        Zero => False::elim(false_ne_true(h))
        Succ(b2) => Refl
      }
      Succ(a2) => match b: Succ(a2) < b = true {
        Zero => False::elim(false_ne_true(h))
        Succ(b2) => lt_of_succ_lt(a2, b2, h)
      }
    }
  }

  pub theorem lt_succ_of_ne(
    r: Nat,
    b: Nat,
    h: r < b = true,
    e: Succ(r) == b = false
  ): Succ(r) < b = true {
    match r: Succ(r) < b = true {
      Zero => match b: Succ(Zero) < b = true {
        Zero => False::elim(false_ne_true(h))
        Succ(b2) => match b2: Succ(Zero) < Succ(b2) = true {
          Zero => False::elim(true_ne_false(e))
          Succ(b3) => Refl
        }
      }
      Succ(r2) => match b: Succ(Succ(r2)) < b = true {
        Zero => False::elim(false_ne_true(h))
        Succ(b2) => lt_succ_of_ne(r2, b2, h, e)
      }
    }
  }

  pub theorem ne_of_lt(r: Nat, b: Nat, h: r < b = true): r == b = false {
    match r: r == b = false {
      Zero => match b: Zero == b = false {
        Zero => False::elim(false_ne_true(h))
        Succ(b2) => Refl
      }
      Succ(r2) => match b: Succ(r2) == b = false {
        Zero => Refl
        Succ(b2) => ne_of_lt(r2, b2, h)
      }
    }
  }

  pub theorem mod_succ_lt(
    n: Nat,
    b: Nat
  ): Nat::rem_nz(n, Succ(b), Nat::succ_ne_zero(b)) < Succ(b) = true {
    match n: Nat::rem_nz(n, Succ(b), Nat::succ_ne_zero(b)) < Succ(b) = true {
      Zero => Refl
      Succ(m) => Eq::subst(
        (x: Nat) => x < Succ(b) = true,
        Eq::sym(mod_succ(m, Succ(b), Nat::succ_ne_zero(b))),
        match Succ(Nat::rem_nz(m, Succ(b), Nat::succ_ne_zero(b))) == Succ(b) eqn e: wrap_succ(Succ(Nat::rem_nz(m, Succ(b), Nat::succ_ne_zero(b))) == Succ(b), Nat::rem_nz(m, Succ(b), Nat::succ_ne_zero(b))) < Succ(b) = true {
          false => ⊢ wrap_succ(false, Nat::rem_nz(m, Succ(b), Nat::succ_ne_zero(b))) < Succ(b) = true from lt_succ_of_ne(
            Nat::rem_nz(m, Succ(b), Nat::succ_ne_zero(b)),
            Succ(b),
            mod_succ_lt(m, b),
            e
          )
          true => ⊢ wrap_succ(true, Nat::rem_nz(m, Succ(b), Nat::succ_ne_zero(b))) < Succ(b) = true from Refl
        }
      )
    }
  }

  pub fn dm_value(b: Nat, p: Nat × Nat): Nat {
    add(mul(b, dm_fst(p)), dm_snd(p))
  }

  pub theorem dm_value_step(
    b: Nat,
    p: Nat × Nat
  ): dm_value(b, dm_step(b, p)) = Succ(dm_value(b, p)) {
    match p: dm_value(b, dm_step(b, p)) = Succ(dm_value(b, p)) {
      #(q, r) => match Succ(
        r
      ) == b eqn e: dm_value(b, dm_step(b, #(q, r))) = Succ(dm_value(b, #(q, r))) {
        false => ⊢ dm_value(b, #(q, Succ(r))) = Succ(add(mul(b, q), r)) from Refl
        true => ⊢ dm_value(
          b,
          #(Succ(q), Zero)
        ) = Succ(
          add(mul(b, q), r)
        ) from Eq::sym(Eq::congr(⟦add(mul(b, q), □)⟧, Nat::eq_sound(Succ(r), b, e)))
      }
    }
  }

  pub theorem div_mod_eq(
    n: Nat,
    b: Nat,
    h: ¬(b = 0)
  ): add(mul(b, Nat::div_nz(n, b, h)), Nat::rem_nz(n, b, h)) = n {
    match n: dm_value(b, Nat::divmod(n, b, Zero, Zero)) = n {
      Zero => Refl
      Succ(m) => Eq::trans(
        Eq::congr(⟦dm_value(b, □)⟧, divmod_succ(m, b, Zero, Zero)),
        Eq::trans(
          dm_value_step(b, Nat::divmod(m, b, Zero, Zero)),
          Eq::congr(Succ, div_mod_eq(m, b, h))
        )
      )
    }
  }

  pub theorem divmod_small(
    r: Nat,
    b: Nat,
    h: r < b = true
  ): Nat::divmod(r, b, Zero, Zero) = #(Zero, r) {
    match r: Nat::divmod(r, b, Zero, Zero) = #(Zero, r) {
      Zero => Refl
      Succ(k) => Eq::trans(
        divmod_succ(k, b, Zero, Zero),
        Eq::trans(
          Eq::congr(⟦dm_step(b, □)⟧, divmod_small(k, b, lt_of_succ_lt(k, b, h))),
          match Succ(k) == b eqn e: dm_step(b, #(Zero, k)) = #(Zero, Succ(k)) {
            false => ⊢ #(Zero, Succ(k)) = #(Zero, Succ(k)) from Refl
            true => ⊢ #(Succ(Zero), Zero) = #(Zero, Succ(k)) from False::elim(true_ne_false(Eq::trans(Eq::sym(e), ne_of_lt(Succ(k), b, h))))
          }
        )
      )
    }
  }

  pub fn pair_shift(p: Nat × Nat): Nat × Nat {
    match p: Nat × Nat {
      #(q, r) => #(Succ(q), r)
    }
  }

  pub theorem dm_step_shift(
    b: Nat,
    p: Nat × Nat
  ): dm_step(b, pair_shift(p)) = pair_shift(dm_step(b, p)) {
    match p: dm_step(b, pair_shift(p)) = pair_shift(dm_step(b, p)) {
      #(q, r) => match Succ(
        r
      ) == b: dm_step(b, pair_shift(#(q, r))) = pair_shift(dm_step(b, #(q, r))) {
        false => ⊢ #(Succ(q), Succ(r)) = pair_shift(#(q, Succ(r))) from Refl
        true => ⊢ #(Succ(Succ(q)), Zero) = pair_shift(#(Succ(q), Zero)) from Refl
      }
    }
  }

  pub theorem divmod_self(b: Nat): Nat::divmod(Succ(b), Succ(b), Zero, Zero) = #(Succ(Zero), Zero) {
    Eq::trans(
      divmod_succ(b, Succ(b), Zero, Zero),
      Eq::trans(
        Eq::congr(⟦dm_step(Succ(b), □)⟧, divmod_small(b, Succ(b), lt_succ_self(b))),
        match b == b eqn e: match b == b: Nat × Nat {
            false => #(Zero, Succ(b))
            true => #(Succ(Zero), Zero)
          } = #(Succ(Zero), Zero) {
          false => ⊢ #(Zero, Succ(b)) = #(Succ(Zero), Zero) from False::elim(true_ne_false(Eq::trans(Eq::sym(Nat::eq_refl(b)), e)))
          true => ⊢ #(Succ(Zero), Zero) = #(Succ(Zero), Zero) from Refl
        }
      )
    )
  }

  pub theorem divmod_add_self(
    n: Nat,
    b: Nat
  ): Nat::divmod(
    add(n, Succ(b)),
    Succ(b),
    Zero,
    Zero
  ) = pair_shift(Nat::divmod(n, Succ(b), Zero, Zero)) {
    match n: Nat::divmod(
      add(n, Succ(b)),
      Succ(b),
      Zero,
      Zero
    ) = pair_shift(Nat::divmod(n, Succ(b), Zero, Zero)) {
      Zero => Eq::trans(
        Eq::congr(⟦Nat::divmod(Succ(□), Succ(b), Zero, Zero)⟧, add_zero_left(b)),
        divmod_self(b)
      )
      Succ(m) => Eq::trans(
        Eq::congr(⟦Nat::divmod(Succ(□), Succ(b), Zero, Zero)⟧, add_succ_left(m, b)),
        Eq::trans(
          divmod_succ(add(m, Succ(b)), Succ(b), Zero, Zero),
          Eq::trans(
            Eq::congr(⟦dm_step(Succ(b), □)⟧, divmod_add_self(m, b)),
            Eq::trans(
              dm_step_shift(Succ(b), Nat::divmod(m, Succ(b), Zero, Zero)),
              Eq::congr(pair_shift, Eq::sym(divmod_succ(m, Succ(b), Zero, Zero)))
            )
          )
        )
      )
    }
  }

  pub theorem add_mul_regroup(
    b: Nat,
    k: Nat,
    r: Nat
  ): add(mul(Succ(b), Succ(k)), r) = add(add(mul(Succ(b), k), r), Succ(b)) {
    by nat_norm!(#()): (add(mul(Succ(b), Succ(k)), r) = add(add(mul(Succ(b), k), r), Succ(b))) {}
  }

  pub theorem divmod_of(
    q: Nat,
    r: Nat,
    b: Nat,
    h: r < Succ(b) = true
  ): Nat::divmod(add(mul(Succ(b), q), r), Succ(b), Zero, Zero) = #(q, r) {
    match q: Nat::divmod(add(mul(Succ(b), q), r), Succ(b), Zero, Zero) = #(q, r) {
      Zero => Eq::trans(
        Eq::congr(⟦Nat::divmod(□, Succ(b), Zero, Zero)⟧, add_zero_left(r)),
        divmod_small(r, Succ(b), h)
      )
      Succ(k) => Eq::trans(
        Eq::congr(⟦Nat::divmod(□, Succ(b), Zero, Zero)⟧, add_mul_regroup(b, k, r)),
        Eq::trans(
          divmod_add_self(add(mul(Succ(b), k), r), b),
          Eq::congr(pair_shift, divmod_of(k, r, b, h))
        )
      )
    }
  }

  pub theorem mod_of(
    q: Nat,
    r: Nat,
    b: Nat,
    h: r < Succ(b) = true
  ): Nat::rem_nz(add(mul(Succ(b), q), r), Succ(b), Nat::succ_ne_zero(b)) = r {
    Eq::congr(dm_snd, divmod_of(q, r, b, h))
  }

  pub theorem div_of(
    q: Nat,
    r: Nat,
    b: Nat,
    h: r < Succ(b) = true
  ): Nat::div_nz(add(mul(Succ(b), q), r), Succ(b), Nat::succ_ne_zero(b)) = q {
    Eq::congr(dm_fst, divmod_of(q, r, b, h))
  }

  pub theorem mul_div_of_mod_zero(
    n: Nat,
    b: Nat,
    hb: ¬(b = 0),
    h: Nat::rem_nz(n, b, hb) == Zero = true
  ): n = mul(b, Nat::div_nz(n, b, hb)) {
    Eq::sym(
      Eq::trans(
        Eq::congr(
          ⟦add(mul(b, Nat::div_nz(n, b, hb)), □)⟧,
          Eq::sym(Nat::eq_sound(Nat::rem_nz(n, b, hb), Zero, h))
        ),
        div_mod_eq(n, b, hb)
      )
    )
  }

  pub theorem mul_regroup(
    a: Nat,
    k: Nat,
    q: Nat
  ): mul(mul(Succ(a), Succ(k)), q) = add(mul(Succ(a), mul(Succ(k), q)), Zero) {
    by nat_norm!(#()): (mul(mul(Succ(a), Succ(k)), q) = add(mul(Succ(a), mul(Succ(k), q)), Zero)) {}
  }

  pub theorem mod_zero_of_mul(
    n: Nat,
    a: Nat,
    k: Nat,
    h: Nat::rem_nz(
      n,
      mul(Succ(a), Succ(k)),
      Nat::ne_zero(mul(Succ(a), Succ(k)), Refl)
    ) == Zero = true
  ): Nat::rem_nz(n, Succ(a), Nat::succ_ne_zero(a)) == Zero = true {
    Eq::subst(
      (x: Nat) => Nat::rem_nz(x, Succ(a), Nat::succ_ne_zero(a)) == Zero = true,
      Eq::sym(
        Eq::trans(
          mul_div_of_mod_zero(
            n,
            mul(Succ(a), Succ(k)),
            Nat::ne_zero(mul(Succ(a), Succ(k)), Refl),
            h
          ),
          mul_regroup(
            a,
            k,
            Nat::div_nz(n, mul(Succ(a), Succ(k)), Nat::ne_zero(mul(Succ(a), Succ(k)), Refl))
          )
        )
      ),
      Eq::subst(
        (x: Nat) => x == Zero = true,
        Eq::sym(
          mod_of(
            mul(
              Succ(k),
              Nat::div_nz(n, mul(Succ(a), Succ(k)), Nat::ne_zero(mul(Succ(a), Succ(k)), Refl))
            ),
            Zero,
            a,
            Refl
          )
        ),
        Refl
      )
    )
  }

  pub theorem fst_dm_step(
    b: Nat,
    p: Nat × Nat
  ): dm_fst(dm_step(b, p)) = add(dm_fst(p), bool_ind(dm_snd(dm_step(b, p)) == Zero)) {
    match p: dm_fst(dm_step(b, p)) = add(dm_fst(p), bool_ind(dm_snd(dm_step(b, p)) == Zero)) {
      #(q, r) => match Succ(
        r
      ) == b: dm_fst(dm_step(b, #(q, r))) = add(q, bool_ind(dm_snd(dm_step(b, #(q, r))) == Zero)) {
        false => ⊢ dm_fst(#(q, Succ(r))) = add(q, bool_ind(dm_snd(#(q, Succ(r))) == Zero)) from Refl
        true => ⊢ dm_fst(
          #(Succ(q), Zero)
        ) = add(q, bool_ind(dm_snd(#(Succ(q), Zero)) == Zero)) from Refl
      }
    }
  }

  pub theorem div_succ(
    n: Nat,
    b: Nat,
    h: ¬(b = 0)
  ): Nat::div_nz(
    Succ(n),
    b,
    h
  ) = add(Nat::div_nz(n, b, h), bool_ind(Nat::rem_nz(Succ(n), b, h) == Zero)) {
    Eq::subst(
      (p: Nat × Nat) => dm_fst(p) = add(Nat::div_nz(n, b, h), bool_ind(dm_snd(p) == Zero)),
      Eq::sym(divmod_succ(n, b, Zero, Zero)),
      fst_dm_step(b, Nat::divmod(n, b, Zero, Zero))
    )
  }
}
