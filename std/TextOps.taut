import "Text.taut"
import "List.taut"
import "Nat.taut"
import "Data.taut"

module Bytes {
  // More of `Text` (`Text::taut`), through its bytes: prefixes, search, and
  // splitting at a one-byte separator. A separator below 128 is an ASCII
  // character, so the parts of a split are texts again.

  // ---- bytes ------------------------------------------------------------------

  // Whether `p` is a prefix of `b`.
  pub fn starts_with(b: List(Nat), p: List(Nat)): Bool {
    match b: Bool {
      Nil => match p: Bool {
        Nil => true
        Cons(y, ys) => false
      }
      Cons(x, xs) => match p: Bool {
        Nil => true
        Cons(y, ys) => x == y && starts_with(xs, ys)
      }
    }
  }

  // The offset of the first place `needle` starts in `hay`, counted from `i`.
  pub fn find_from(hay: List(Nat), needle: List(Nat), i: Nat): Option(Nat) {
    match hay: Option(Nat) {
      Nil => match needle: Option(Nat) {
        Nil => Some(i)
        Cons(y, ys) => None
      }
      Cons(x, xs) => match starts_with(hay, needle): Option(Nat) {
        true => Some(i)
        false => find_from(xs, needle, Succ(i))
      }
    }
  }

  // `Bytes::split(bs, sep)` is the part that `bs` starts with and the parts
  // after it, in order.
  // The members of `List(List(Nat)) × List(Nat)` stand in this order, so a
  // pattern by position reads the parts after the first before it:
  // `#(rest, cur)`. `Nil(Nat)` and `Nil(List(Nat))` say which list a `Nil` is,
  // so the members of a value are put in place by their types.
  pub fn split_step(
    h: Nat,
    sep: Nat,
    pr: List(List(Nat)) × List(Nat)
  ): List(List(Nat)) × List(Nat) {
    match pr: List(List(Nat)) × List(Nat) {
      #(rest, cur) => match h == sep: List(List(Nat)) × List(Nat) {
        true => #(Nil(Nat), Cons(cur, rest))
        false => #(Cons(h, cur), rest)
      }
    }
  }

  pub fn split(bs: List(Nat), sep: Nat): List(List(Nat)) × List(Nat) {
    match bs: List(List(Nat)) × List(Nat) {
      Nil => #(Nil(Nat), Nil(List(Nat)))
      Cons(h, t) => split_step(h, sep, split(t, sep))
    }
  }

  // The parts after the first, each after a `sep`.
  pub fn join_rest(sep: List(Nat), rest: List(List(Nat))): List(Nat) {
    match rest: List(Nat) {
      Nil => Nil
      Cons(q, qs) => List::append(sep, List::append(q, join_rest(sep, qs)))
    }
  }

  pub fn unsplit(sep: List(Nat), pr: List(List(Nat)) × List(Nat)): List(Nat) {
    match pr: List(Nat) {
      #(rest, cur) => List::append(cur, join_rest(sep, rest))
    }
  }

  // ---- lemmas about prefixes and search ---------------------------------------

  pub theorem starts_with_nil(b: List(Nat)): starts_with(b, Nil) = true {
    match b: starts_with(b, Nil) = true {
      Nil => Refl
      Cons(x, xs) => Refl
    }
  }

  pub theorem starts_with_self(b: List(Nat)): starts_with(b, b) = true {
    match b: starts_with(b, b) = true {
      Nil => Refl
      Cons(x, xs) => Eq::trans(
        Eq::congr(⟦□ && starts_with(xs, xs)⟧, Nat::eq_refl(x)),
        starts_with_self(xs)
      )
    }
  }

  // A list starts with the front of itself.
  pub theorem starts_with_append(
    p: List(Nat),
    r: List(Nat)
  ): starts_with(List::append(p, r), p) = true {
    match p: starts_with(List::append(p, r), p) = true {
      Nil => starts_with_nil(r)
      Cons(y, ys) => Eq::trans(
        Eq::congr(⟦□ && starts_with(List::append(ys, r), ys)⟧, Nat::eq_refl(y)),
        starts_with_append(ys, r)
      )
    }
  }

  // A match is found where the text starts, when the text begins with it.
  pub theorem find_from_prefix(
    hay: List(Nat),
    needle: List(Nat),
    i: Nat,
    h: starts_with(hay, needle) = true
  ): find_from(hay, needle, i) = Some(i) {
    match hay: find_from(hay, needle, i) = Some(i) {
      Nil => match needle: find_from(Nil, needle, i) = Some(i) {
        Nil => Refl
        Cons(y, ys) => False::elim(false_ne_true(h))
      }
      Cons(x, xs) => match starts_with(Cons(x, xs), needle): find_from(Cons(x, xs), needle, i) = Some(i) {
        true => ⊢ Some(i) = Some(i) from Refl
        false => ⊢ find_from(xs, needle, Succ(i)) = Some(i) from False::elim(false_ne_true(h))
      }
    }
  }

  // ---- lemmas about splitting -------------------------------------------------

  pub theorem unsplit_step(
    h: Nat,
    sep: Nat,
    pr: List(List(Nat)) × List(Nat)
  ): unsplit(
    [sep],
    split_step(h, sep, pr)
  ) = Cons(h, unsplit([sep], pr)) {
    match pr: unsplit(
      [sep],
      split_step(h, sep, pr)
    ) = Cons(h, unsplit([sep], pr)) {
      #(rest, cur) => match h == sep eqn e: unsplit(
        [sep],
        split_step(h, sep, #(cur, rest))
      ) = Cons(h, List::append(cur, join_rest([sep], rest))) {
        true => ⊢ unsplit(
          [sep],
          #(Nil(Nat), Cons(cur, rest))
        ) = Cons(h, List::append(cur, join_rest([sep], rest))) from Eq::congr(
          ⟦Cons(□, List::append(cur, join_rest([sep], rest)))⟧,
          Eq::sym(Nat::eq_sound(h, sep, e))
        )
        false => ⊢ unsplit(
          [sep],
          #(Cons(h, cur), rest)
        ) = Cons(h, List::append(cur, join_rest([sep], rest))) from Refl
      }
    }
  }

  // Joining the parts of a split with the separator gives the bytes back.
  pub theorem split_unsplit(
    bs: List(Nat),
    sep: Nat
  ): unsplit([sep], split(bs, sep)) = bs {
    match bs: unsplit([sep], split(bs, sep)) = bs {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        unsplit_step(h, sep, split(t, sep)),
        Eq::congr(⟦Cons(h, □)⟧, split_unsplit(t, sep))
      )
    }
  }
}

module Text {
  // ---- text -------------------------------------------------------------------

  pub fn is_empty(t: Text): Bool {
    match Text::bytes(t): Bool {
      Nil => true
      Cons(x, xs) => false
    }
  }

  pub fn starts_with(t: Text, p: Text): Bool {
    Bytes::starts_with(Text::bytes(t), Text::bytes(p))
  }

  pub fn ends_with(t: Text, s: Text): Bool {
    Bytes::starts_with(List::reverse(Text::bytes(t)), List::reverse(Text::bytes(s)))
  }

  // The byte offset where `needle` first occurs.
  pub fn find(t: Text, needle: Text): Option(Nat) {
    Bytes::find_from(Text::bytes(t), Text::bytes(needle), Zero)
  }

  pub fn contains(t: Text, needle: Text): Bool {
    Option::is_some(find(t, needle))
  }

  // `n` copies of `t`.
  pub fn repeat(t: Text, n: Nat): Text {
    match n: Text {
      Zero => Text::Mk(Nil)
      Succ(k) => Text::concat(t, repeat(t, k))
    }
  }

  pub fn of_bytes_list(parts: List(List(Nat))): List(Text) {
    List::map((b: List(Nat)) => Text::Mk(b), parts)
  }

  pub fn of_split(pr: List(List(Nat)) × List(Nat)): List(Text) {
    match pr: List(Text) {
      #(rest, cur) => Cons(Text::Mk(cur), of_bytes_list(rest))
    }
  }

  // The parts of `t` between the bytes equal to `sep` (below 128).
  pub fn split_on(t: Text, sep: Nat): List(Text) {
    of_split(Bytes::split(Text::bytes(t), sep))
  }

  // `parts` with `sep` between them.
  pub fn join(sep: Text, parts: List(Text)): Text {
    match parts: Text {
      Nil => Text::Mk(Nil)
      Cons(p, rest) => Text::Mk(
        List::append(
          Text::bytes(p),
          Bytes::join_rest(Text::bytes(sep), List::map((q: Text) => Text::bytes(q), rest))
        )
      )
    }
  }

  // ---- lemmas about concatenation ---------------------------------------------

  pub theorem eta(t: Text): Text::Mk(Text::bytes(t)) = t {
    match t: Text::Mk(Text::bytes(t)) = t {
      Mk(bs) => Refl
    }
  }

  pub theorem concat_empty_left(t: Text): Text::concat(Text::Mk(Nil), t) = t {
    eta(t)
  }

  pub theorem concat_empty_right(t: Text): Text::concat(t, Text::Mk(Nil)) = t {
    Eq::trans(Eq::congr(⟦Text::Mk(□)⟧, List::append_nil(Text::bytes(t))), eta(t))
  }

  pub theorem concat_assoc(
    a: Text,
    b: Text,
    c: Text
  ): Text::concat(Text::concat(a, b), c) = Text::concat(a, Text::concat(b, c)) {
    Eq::congr(
      ⟦Text::Mk(□)⟧,
      List::append_assoc(Text::bytes(a), Text::bytes(b), Text::bytes(c))
    )
  }

  pub theorem len_concat(
    a: Text,
    b: Text
  ): Text::len(Text::concat(a, b)) = Nat::add(Text::len(a), Text::len(b)) {
    List::length_append(Text::bytes(a), Text::bytes(b))
  }

  pub theorem len_repeat(
    t: Text,
    n: Nat
  ): Text::len(repeat(t, n)) = Nat::mul(Text::len(t), n) {
    match n: Text::len(repeat(t, n)) = Nat::mul(Text::len(t), n) {
      Zero => Refl
      Succ(k) => Eq::trans(
        List::length_append(Text::bytes(t), Text::bytes(repeat(t, k))),
        Eq::trans(
          Nat::add_comm(Text::len(t), Text::len(repeat(t, k))),
          Eq::congr(⟦Nat::add(□, Text::len(t))⟧, len_repeat(t, k))
        )
      )
    }
  }

  pub theorem starts_with_concat(
    a: Text,
    b: Text
  ): starts_with(Text::concat(a, b), a) = true {
    Bytes::starts_with_append(Text::bytes(a), Text::bytes(b))
  }

  pub theorem starts_with_self(t: Text): starts_with(t, t) = true {
    Bytes::starts_with_self(Text::bytes(t))
  }

  pub theorem find_prefix(a: Text, b: Text): find(Text::concat(a, b), a) = Some(Zero) {
    Bytes::find_from_prefix(
      List::append(Text::bytes(a), Text::bytes(b)),
      Text::bytes(a),
      Zero,
      Bytes::starts_with_append(Text::bytes(a), Text::bytes(b))
    )
  }

  pub theorem contains_concat(a: Text, b: Text): contains(Text::concat(a, b), a) = true {
    Eq::congr(⟦Option::is_some(□)⟧, find_prefix(a, b))
  }

  pub theorem bytes_of_parts(
    rest: List(List(Nat))
  ): List::map((q: Text) => Text::bytes(q), of_bytes_list(rest)) = rest {
    Eq::trans(
      List::map_map((b: List(Nat)) => Text::Mk(b), (q: Text) => Text::bytes(q), rest),
      List::map_id(rest)
    )
  }

  pub theorem join_pair(
    pr: List(List(Nat)) × List(Nat),
    sep: Nat
  ): join(Text::Mk([sep]), of_split(pr)) = Text::Mk(Bytes::unsplit([sep], pr)) {
    match pr: join(
      Text::Mk([sep]),
      of_split(pr)
    ) = Text::Mk(Bytes::unsplit([sep], pr)) {
      #(rest, cur) => Eq::congr(
        ⟦Text::Mk(List::append(cur, Bytes::join_rest([sep], □)))⟧,
        bytes_of_parts(rest)
      )
    }
  }

  // Splitting at a byte and joining with it gives the text back.
  pub theorem split_on_join(
    t: Text,
    sep: Nat
  ): join(Text::Mk([sep]), split_on(t, sep)) = t {
    match t: join(Text::Mk([sep]), split_on(t, sep)) = t {
      Mk(bs) => Eq::trans(
        join_pair(Bytes::split(bs, sep), sep),
        Eq::congr(⟦Text::Mk(□)⟧, Bytes::split_unsplit(bs, sep))
      )
    }
  }

  // ---- examples ---------------------------------------------------------------

  pub theorem split_on_commas(): split_on(
    "a,b,c",
    44
  ) = ["a", "b", "c"] {
    Refl
  }

  pub theorem find_ll(): find("hello", "ll") = Some(2) {
    Refl
  }

  pub theorem find_missing(): find("hello", "z") = None {
    Refl
  }

  pub theorem repeat_ab(): repeat("ab", 3) = "ababab" {
    Refl
  }

  pub theorem ends_with_lo(): ends_with("hello", "lo") = true {
    Refl
  }

  pub theorem join_commas(): join(",", ["a", "b"]) = "a,b" {
    Refl
  }
}
