import "base.taut" { List }
import "uint.taut" { UInt }
import std::builtin::macro { SynExpr }
import std::prelude::std { List }

// A register-only model, not a CPU emulator or native assembler.
pub(open) inductive Asm::Reg: Type { X0: Asm::Reg, X1: Asm::Reg, X2: Asm::Reg }
pub(open) inductive struct Asm::State {
  x0: UInt(64)
  x1: UInt(64)
  x2: UInt(64)
}
pub(open) inductive Asm::Instr: Type {
  Mov(dst: Asm::Reg, src: Asm::Reg): Asm::Instr
  Add(dst: Asm::Reg, lhs: Asm::Reg, rhs: Asm::Reg): Asm::Instr
  Sub(dst: Asm::Reg, lhs: Asm::Reg, rhs: Asm::Reg): Asm::Instr
}
pub fn Asm::read(s: Asm::State, r: Asm::Reg): UInt(64) {
  match r {
    Asm::Reg::X0 => s.x0
    Asm::Reg::X1 => s.x1
    Asm::Reg::X2 => s.x2
  }
}
pub fn Asm::write(s: Asm::State, r: Asm::Reg, value: UInt(64)): Asm::State {
  match r {
    Asm::Reg::X0 => Asm::State { x0: value, x1: s.x1, x2: s.x2 }
    Asm::Reg::X1 => Asm::State { x0: s.x0, x1: value, x2: s.x2 }
    Asm::Reg::X2 => Asm::State { x0: s.x0, x1: s.x1, x2: value }
  }
}
// All reads use the input state, including when a source aliases the destination.
pub fn Asm::step(instruction: Asm::Instr, s: Asm::State): Asm::State {
  match instruction {
    Asm::Instr::Mov(dst, src) => Asm::write(s, dst, Asm::read(s, src))
    Asm::Instr::Add(dst, lhs, rhs) => Asm::write(s, dst, UInt::wrapping_add64(Asm::read(s, lhs), Asm::read(s, rhs)))
    Asm::Instr::Sub(dst, lhs, rhs) => Asm::write(s, dst, UInt::wrapping_sub64(Asm::read(s, lhs), Asm::read(s, rhs)))
  }
}
pub fn Asm::run(program: List(Asm::Instr), s: Asm::State): Asm::State {
  match program {
    Nil => s
    Cons(instruction, rest) => Asm::run(rest, Asm::step(instruction, s))
  }
}
// Clients supply a proof term; this specification alone certifies nothing.
pub def Asm::Hoare(program: List(Asm::Instr), pre: (Asm::State) -> Prop, post: (Asm::State) -> Prop): Prop :=
∀ s: Asm::State. pre(s) -> post(Asm::run(program, s))
pub theorem Asm::read_write(s: Asm::State, r: Asm::Reg, value: UInt(64)): Asm::read(Asm::write(s, r, value), r) = value {
  match r { Asm::Reg::X0 => Refl, Asm::Reg::X1 => Refl, Asm::Reg::X2 => Refl }
}
pub theorem Asm::run_nil(s: Asm::State): Asm::run(Nil, s) = s { Refl }
pub theorem Asm::run_cons(
  instruction: Asm::Instr,
  rest: List(Asm::Instr),
  s: Asm::State
): Asm::run(Cons(instruction, rest), s) = Asm::run(rest, Asm::step(instruction, s)) { Refl }
pub theorem Asm::run_append(
  first: List(Asm::Instr),
  second: List(Asm::Instr),
  s: Asm::State
): Asm::run(List::append(first, second), s) = Asm::run(second, Asm::run(first, s)) {
  ⊢ Asm::run(
    List::append(first, second),
    s
  ) = Asm::run(second, Asm::run(first, s)) from match first {
    Nil => Refl
    Cons(instruction, rest) => Asm::run_append(rest, second, Asm::step(instruction, s))
  }
}

syntax!(asm_syntax, ```par
%start Program
%title "register assembly"
%%
Program: Instruction { Semi Instruction };
Instruction: Move | Add | Sub;
Move: MovOp Reg Comma Reg;
Add: AddOp Reg Comma Reg Comma Reg;
Sub: SubOp Reg Comma Reg Comma Reg;
Reg: X0 | X1 | X2;
MovOp: 'mov';
AddOp: 'add';
SubOp: 'sub';
X0: 'x0';
X1: 'x1';
X2: 'x2';
Comma: ',';
Semi: ';';
```) => struct Add, enum Instruction, struct Move, struct Program,
  struct Program_Rep1, enum Reg, struct Sub, fn parse

pub fn asm_reg(r: asm_syntax::Reg): SynExpr {
  match r {
    X0(token) => quote { Asm::Reg::X0 }
    X1(token) => quote { Asm::Reg::X1 }
    X2(token) => quote { Asm::Reg::X2 }
  }
}
pub fn asm_instruction(instruction: asm_syntax::Instruction): SynExpr {
  match instruction {
    Move(m) => {
      let dst := asm_reg(m.reg)
      let src := asm_reg(m.reg_2)
      quote { Asm::Instr::Mov($dst, $src) }
    }
    Add(a) => {
      let dst := asm_reg(a.reg)
      let lhs := asm_reg(a.reg_2)
      let rhs := asm_reg(a.reg_3)
      quote { Asm::Instr::Add($dst, $lhs, $rhs) }
    }
    Sub(s) => {
      let dst := asm_reg(s.reg)
      let lhs := asm_reg(s.reg_2)
      let rhs := asm_reg(s.reg_3)
      quote { Asm::Instr::Sub($dst, $lhs, $rhs) }
    }
  }
}
pub fn asm_rest(rest: List(asm_syntax::Program_Rep1)): SynExpr ! {div} {
  match rest {
    Nil => quote { Nil }
    Cons(item, more) => {
      let instruction := asm_instruction(item.instruction)
      let tail := asm_rest(more)
      quote { Cons($instruction, $tail) }
    }
  }
}
// Produces a program, not a trusted assertion or proof.
pub macro fn asm(program: asm_syntax::Program): SynExpr ! {div} {
  let first := asm_instruction(program.instruction)
  let rest := asm_rest(program.rep)
  quote { Cons($first, $rest) }
}
