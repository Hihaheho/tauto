import "Nat.taut"

// Reflection for the equations of the natural numbers' commutative semiring:
// an expression of `+`, `*`, numerals and variables is read as a `NatExpr`, both
// sides are normalised to a sum of products of variables in a fixed order
// (`Ne::norm`), and when the two normal forms are the same term, the sides are equal
// (`Nat::norm_eq`). The theorem is the whole trust: `nat_norm!` in `Tactic.taut`
// only finds the `NatExpr`s and the list of values of the variables, and the kernel
// checks what it made. Each monomial carries its coefficient as a numeral, so a
// numeral `n` is one term, whatever its size.

pub(open) inductive NatExpr: Type =>
  fn NatExpr::beq, theorem NatExpr::beq_refl, theorem NatExpr::beq_sound, theorem NatExpr::deq {
  NeConst(n: Nat): NatExpr
  NeVar(i: Nat): NatExpr
  NeAdd(a: NatExpr, b: NatExpr): NatExpr
  NeMul(a: NatExpr, b: NatExpr): NatExpr
}

module Ne {
  // The value of variable `i`; the variables not in the list are 0.
  pub fn env_get(env: List(Nat), i: Nat): Nat {
    match env: Nat {
      Nil => Zero
      Cons(h, t) => match i: Nat {
        Zero => h
        Succ(k) => Ne::env_get(t, k)
      }
    }
  }

  pub fn eval(env: List(Nat), e: NatExpr): Nat {
    match e: Nat {
      NeConst(n) => n
      NeVar(i) => Ne::env_get(env, i)
      NeAdd(a, b) => Nat::add(Ne::eval(env, a), Ne::eval(env, b))
      NeMul(a, b) => Nat::mul(Ne::eval(env, a), Ne::eval(env, b))
    }
  }
}

// ---- monomials: the variables of a product, in order ------------------------------

module Nm {
  pub fn eval(env: List(Nat), m: List(Nat)): Nat {
    match m: Nat {
      Nil => Succ(Zero)
      Cons(v, r) => Nat::mul(Ne::env_get(env, v), Nm::eval(env, r))
    }
  }

  pub fn ins_at(y: Bool, v: Nat, w: Nat, m2: List(Nat), rest: List(Nat)): List(Nat) {
    match y: List(Nat) {
      false => Cons(w, rest)
      true => Cons(v, Cons(w, m2))
    }
  }

  // `v` before the first variable it is not after.
  pub fn ins(v: Nat, m: List(Nat)): List(Nat) {
    match m: List(Nat) {
      Nil => Cons(v, Nil)
      Cons(w, m2) => Nm::ins_at(v <= w, v, w, m2, Nm::ins(v, m2))
    }
  }

  pub fn mul(a: List(Nat), b: List(Nat)): List(Nat) {
    match a: List(Nat) {
      Nil => b
      Cons(v, r) => Nm::ins(v, Nm::mul(r, b))
    }
  }

  // ---- monomials compared ----------------------------------------------------------

  pub fn cmp_at(e: Bool, l: Bool, r: Ordering): Ordering {
    match e: Ordering {
      true => r
      false => match l: Ordering {
        true => Less
        false => Greater
      }
    }
  }

  // The lexicographic order of monomials.
  pub fn cmp(a: List(Nat), b: List(Nat)): Ordering {
    match a: Ordering {
      Nil => match b: Ordering {
        Nil => Equal
        Cons(y, ys) => Less
      }
      Cons(x, xs) => match b: Ordering {
        Nil => Greater
        Cons(y, ys) => Nm::cmp_at(x == y, x < y, Nm::cmp(xs, ys))
      }
    }
  }

  pub theorem cmp_at_sound(
    e: Bool,
    l: Bool,
    r: Ordering,
    x: Nat,
    y: Nat,
    xs: List(Nat),
    ys: List(Nat),
    he: (e = true) -> (x = y),
    hr: (r = Equal) -> (xs = ys),
    h: Nm::cmp_at(e, l, r) = Equal
  ): Cons(x, xs) = Cons(y, ys) {
    match e: Cons(x, xs) = Cons(y, ys) {
      true => Eq::trans(
        Eq::congr(⟦Cons(□, xs)⟧, he(Refl)),
        Eq::congr(⟦Cons(y, □)⟧, hr(h))
      )
      false => match l: Cons(x, xs) = Cons(y, ys) {
        true => False::elim(less_ne_equal(h))
        false => False::elim(greater_ne_equal(h))
      }
    }
  }

  pub theorem cmp_sound(a: List(Nat), b: List(Nat), h: Nm::cmp(a, b) = Equal): a = b {
    match a: a = b {
      Nil => match b: Nil = b {
        Nil => Refl
        Cons(y, ys) => False::elim(less_ne_equal(h))
      }
      Cons(x, xs) => match b: Cons(x, xs) = b {
        Nil => False::elim(greater_ne_equal(h))
        Cons(y, ys) => Nm::cmp_at_sound(
          x == y,
          x < y,
          Nm::cmp(xs, ys),
          x,
          y,
          xs,
          ys,
          (q: x == y = true) => Nat::eq_sound(x, y, q),
          (q: Nm::cmp(xs, ys) = Equal) => Nm::cmp_sound(xs, ys, q),
          h
        )
      }
    }
  }
}

// ---- polynomials: a sum of monomials with coefficients, in order --------------------

// `c` times the product `m`.
pub(open) inductive NmTerm: Type {
  Nt(c: Nat, m: List(Nat)): NmTerm
}

pub fn nt_eval(env: List(Nat), t: NmTerm): Nat {
  match t: Nat {
    Nt(c, m) => Nat::mul(c, Nm::eval(env, m))
  }
}

module Np {
  pub fn eval(env: List(Nat), p: List(NmTerm)): Nat {
    match p: Nat {
      Nil => Zero
      Cons(t, r) => Nat::add(nt_eval(env, t), Np::eval(env, r))
    }
  }

  pub fn ins_at(
    o: Ordering,
    c: Nat,
    m: List(Nat),
    d: Nat,
    n: List(Nat),
    p2: List(NmTerm),
    rest: List(NmTerm)
  ): List(NmTerm) {
    match o: List(NmTerm) {
      Less => Cons(Nt(c, m), Cons(Nt(d, n), p2))
      Equal => Cons(Nt(Nat::add(c, d), m), p2)
      Greater => Cons(Nt(d, n), rest)
    }
  }

  // `c` times `m` added, the coefficients of the same monomial summed.
  pub fn ins(c: Nat, m: List(Nat), p: List(NmTerm)): List(NmTerm) {
    match p: List(NmTerm) {
      Nil => Cons(Nt(c, m), Nil)
      Cons(u, p2) => match u: List(NmTerm) {
        Nt(d, n) => Np::ins_at(Nm::cmp(m, n), c, m, d, n, p2, Np::ins(c, m, p2))
      }
    }
  }

  pub fn add(p: List(NmTerm), q: List(NmTerm)): List(NmTerm) {
    match p: List(NmTerm) {
      Nil => q
      Cons(t, r) => match t: List(NmTerm) {
        Nt(c, m) => Np::ins(c, m, Np::add(r, q))
      }
    }
  }

  pub fn mul_mono(c: Nat, m: List(Nat), q: List(NmTerm)): List(NmTerm) {
    match q: List(NmTerm) {
      Nil => Nil
      Cons(u, r) => match u: List(NmTerm) {
        Nt(d, n) => Np::ins(Nat::mul(c, d), Nm::mul(m, n), Np::mul_mono(c, m, r))
      }
    }
  }

  pub fn mul(p: List(NmTerm), q: List(NmTerm)): List(NmTerm) {
    match p: List(NmTerm) {
      Nil => Nil
      Cons(t, r) => match t: List(NmTerm) {
        Nt(c, m) => Np::add(Np::mul_mono(c, m, q), Np::mul(r, q))
      }
    }
  }

  // `n` is `n` times the empty product, and 0 is no term.
  pub fn const(n: Nat): List(NmTerm) {
    match n: List(NmTerm) {
      Zero => Nil
      Succ(k) => Cons(Nt(Succ(k), Nil), Nil)
    }
  }
}

module Ne {
  pub fn norm(e: NatExpr): List(NmTerm) {
    match e: List(NmTerm) {
      NeConst(n) => Np::const(n)
      NeVar(i) => Cons(Nt(Succ(Zero), Cons(i, Nil)), Nil)
      NeAdd(a, b) => Np::add(Ne::norm(a), Ne::norm(b))
      NeMul(a, b) => Np::mul(Ne::norm(a), Ne::norm(b))
    }
  }
}

// ---- the normal form has the value of the expression ----------------------------------

module Nm {
  pub theorem ins_at_sound(
    env: List(Nat),
    y: Bool,
    v: Nat,
    w: Nat,
    m2: List(Nat),
    rest: List(Nat),
    ih: Nm::eval(env, rest) = Nat::mul(Ne::env_get(env, v), Nm::eval(env, m2))
  ): Nm::eval(
    env,
    Nm::ins_at(y, v, w, m2, rest)
  ) = Nat::mul(Ne::env_get(env, v), Nm::eval(env, Cons(w, m2))) {
    match y: Nm::eval(
      env,
      Nm::ins_at(y, v, w, m2, rest)
    ) = Nat::mul(Ne::env_get(env, v), Nm::eval(env, Cons(w, m2))) {
      false => Eq::trans(
        Eq::congr(⟦Nat::mul(Ne::env_get(env, w), □)⟧, ih),
        Nat::mul_swap(Ne::env_get(env, w), Ne::env_get(env, v), Nm::eval(env, m2))
      )
      true => Refl
    }
  }

  pub theorem ins_sound(
    env: List(Nat),
    v: Nat,
    m: List(Nat)
  ): Nm::eval(env, Nm::ins(v, m)) = Nat::mul(Ne::env_get(env, v), Nm::eval(env, m)) {
    match m: Nm::eval(env, Nm::ins(v, m)) = Nat::mul(Ne::env_get(env, v), Nm::eval(env, m)) {
      Nil => Refl
      Cons(w, m2) => Nm::ins_at_sound(
        env,
        v <= w,
        v,
        w,
        m2,
        Nm::ins(v, m2),
        Nm::ins_sound(env, v, m2)
      )
    }
  }

  pub theorem mul_sound(
    env: List(Nat),
    a: List(Nat),
    b: List(Nat)
  ): Nm::eval(env, Nm::mul(a, b)) = Nat::mul(Nm::eval(env, a), Nm::eval(env, b)) {
    match a: Nm::eval(env, Nm::mul(a, b)) = Nat::mul(Nm::eval(env, a), Nm::eval(env, b)) {
      Nil => Eq::sym(Nat::mul_one_left(Nm::eval(env, b)))
      Cons(v, r) => Eq::trans(
        Nm::ins_sound(env, v, Nm::mul(r, b)),
        Eq::trans(
          Eq::congr(⟦Nat::mul(Ne::env_get(env, v), □)⟧, Nm::mul_sound(env, r, b)),
          Eq::sym(Nat::mul_assoc(Ne::env_get(env, v), Nm::eval(env, r), Nm::eval(env, b)))
        )
      )
    }
  }
}

module Np {
  pub theorem ins_at_sound(
    env: List(Nat),
    o: Ordering,
    c: Nat,
    m: List(Nat),
    d: Nat,
    n: List(Nat),
    p2: List(NmTerm),
    rest: List(NmTerm),
    ih: Np::eval(env, rest) = Nat::add(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, p2)),
    same: (o = Equal) -> (m = n)
  ): Np::eval(
    env,
    Np::ins_at(o, c, m, d, n, p2, rest)
  ) = Nat::add(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, Cons(Nt(d, n), p2))) {
    match o: Np::eval(
      env,
      Np::ins_at(o, c, m, d, n, p2, rest)
    ) = Nat::add(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, Cons(Nt(d, n), p2))) {
      Less => Refl
      Equal => Eq::trans(
        Eq::congr(
          ⟦Nat::add(□, Np::eval(env, p2))⟧,
          Nat::mul_add_distrib_right(c, d, Nm::eval(env, m))
        ),
        Eq::trans(
          Nat::add_assoc(Nat::mul(c, Nm::eval(env, m)), Nat::mul(d, Nm::eval(env, m)), Np::eval(env, p2)),
          Eq::congr(
            ⟦Nat::add(Nat::mul(c, Nm::eval(env, m)), Nat::add(Nat::mul(d, Nm::eval(env, □)), Np::eval(env, p2)))⟧,
            same(Refl)
          )
        )
      )
      Greater => Eq::trans(
        Eq::congr(⟦Nat::add(Nat::mul(d, Nm::eval(env, n)), □)⟧, ih),
        Nat::add_swap_left(Nat::mul(d, Nm::eval(env, n)), Nat::mul(c, Nm::eval(env, m)), Np::eval(env, p2))
      )
    }
  }

  pub theorem ins_sound(
    env: List(Nat),
    c: Nat,
    m: List(Nat),
    p: List(NmTerm)
  ): Np::eval(env, Np::ins(c, m, p)) = Nat::add(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, p)) {
    match p: Np::eval(env, Np::ins(c, m, p)) = Nat::add(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, p)) {
      Nil => Refl
      Cons(u, p2) => match u: Np::eval(
        env,
        Np::ins(c, m, Cons(u, p2))
      ) = Nat::add(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, Cons(u, p2))) {
        Nt(d, n) => Np::ins_at_sound(
          env,
          Nm::cmp(m, n),
          c,
          m,
          d,
          n,
          p2,
          Np::ins(c, m, p2),
          Np::ins_sound(env, c, m, p2),
          (q: Nm::cmp(m, n) = Equal) => Nm::cmp_sound(m, n, q)
        )
      }
    }
  }

  pub theorem add_sound(
    env: List(Nat),
    p: List(NmTerm),
    q: List(NmTerm)
  ): Np::eval(env, Np::add(p, q)) = Nat::add(Np::eval(env, p), Np::eval(env, q)) {
    match p: Np::eval(env, Np::add(p, q)) = Nat::add(Np::eval(env, p), Np::eval(env, q)) {
      Nil => Eq::sym(Nat::add_zero_left(Np::eval(env, q)))
      Cons(t, r) => match t: Np::eval(
        env,
        Np::add(Cons(t, r), q)
      ) = Nat::add(Np::eval(env, Cons(t, r)), Np::eval(env, q)) {
        Nt(c, m) => Eq::trans(
          Np::ins_sound(env, c, m, Np::add(r, q)),
          Eq::trans(
            Eq::congr(⟦Nat::add(Nat::mul(c, Nm::eval(env, m)), □)⟧, Np::add_sound(env, r, q)),
            Eq::sym(Nat::add_assoc(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, r), Np::eval(env, q)))
          )
        )
      }
    }
  }
}

module Nat {
  // `(c * d) * (x * y)` is `(c * x) * (d * y)`.
  pub theorem mul_mul4(
    c: Nat,
    d: Nat,
    x: Nat,
    y: Nat
  ): mul(mul(c, d), mul(x, y)) = mul(mul(c, x), mul(d, y)) {
    Eq::trans(
      mul_assoc(c, d, mul(x, y)),
      Eq::trans(
        Eq::congr(⟦mul(c, □)⟧, mul_swap(d, x, y)),
        Eq::sym(mul_assoc(c, x, mul(d, y)))
      )
    )
  }
}

module Np {
  pub theorem mul_mono_sound(
    env: List(Nat),
    c: Nat,
    m: List(Nat),
    q: List(NmTerm)
  ): Np::eval(env, Np::mul_mono(c, m, q)) = Nat::mul(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, q)) {
    match q: Np::eval(
      env,
      Np::mul_mono(c, m, q)
    ) = Nat::mul(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, q)) {
      Nil => Eq::sym(Nat::mul_zero_right(Nat::mul(c, Nm::eval(env, m))))
      Cons(u, r) => match u: Np::eval(
        env,
        Np::mul_mono(c, m, Cons(u, r))
      ) = Nat::mul(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, Cons(u, r))) {
        Nt(d, n) => Eq::trans(
          Np::ins_sound(env, Nat::mul(c, d), Nm::mul(m, n), Np::mul_mono(c, m, r)),
          Eq::trans(
            Eq::congr(
              ⟦Nat::add(Nat::mul(Nat::mul(c, d), □), Np::eval(env, Np::mul_mono(c, m, r)))⟧,
              Nm::mul_sound(env, m, n)
            ),
            Eq::trans(
              Eq::congr(
                ⟦Nat::add(□, Np::eval(env, Np::mul_mono(c, m, r)))⟧,
                Nat::mul_mul4(c, d, Nm::eval(env, m), Nm::eval(env, n))
              ),
              Eq::trans(
                Eq::congr(
                  ⟦Nat::add(Nat::mul(Nat::mul(c, Nm::eval(env, m)), Nat::mul(d, Nm::eval(env, n))), □)⟧,
                  Np::mul_mono_sound(env, c, m, r)
                ),
                Eq::sym(
                  Nat::mul_add_distrib(
                    Nat::mul(c, Nm::eval(env, m)),
                    Nat::mul(d, Nm::eval(env, n)),
                    Np::eval(env, r)
                  )
                )
              )
            )
          )
        )
      }
    }
  }

  pub theorem mul_sound(
    env: List(Nat),
    p: List(NmTerm),
    q: List(NmTerm)
  ): Np::eval(env, Np::mul(p, q)) = Nat::mul(Np::eval(env, p), Np::eval(env, q)) {
    match p: Np::eval(env, Np::mul(p, q)) = Nat::mul(Np::eval(env, p), Np::eval(env, q)) {
      Nil => Eq::sym(Nat::mul_zero_left(Np::eval(env, q)))
      Cons(t, r) => match t: Np::eval(
        env,
        Np::mul(Cons(t, r), q)
      ) = Nat::mul(Np::eval(env, Cons(t, r)), Np::eval(env, q)) {
        Nt(c, m) => Eq::trans(
          Np::add_sound(env, Np::mul_mono(c, m, q), Np::mul(r, q)),
          Eq::trans(
            Eq::congr(
              ⟦Nat::add(□, Np::eval(env, Np::mul(r, q)))⟧,
              Np::mul_mono_sound(env, c, m, q)
            ),
            Eq::trans(
              Eq::congr(
                ⟦Nat::add(Nat::mul(Nat::mul(c, Nm::eval(env, m)), Np::eval(env, q)), □)⟧,
                Np::mul_sound(env, r, q)
              ),
              Eq::sym(
                Nat::mul_add_distrib_right(
                  Nat::mul(c, Nm::eval(env, m)),
                  Np::eval(env, r),
                  Np::eval(env, q)
                )
              )
            )
          )
        )
      }
    }
  }

  pub theorem const_sound(env: List(Nat), n: Nat): Np::eval(env, Np::const(n)) = n {
    match n: Np::eval(env, Np::const(n)) = n {
      Zero => Refl
      Succ(k) => Nat::mul_one_right(Succ(k))
    }
  }
}

module Ne {
  pub theorem norm_sound(env: List(Nat), e: NatExpr): Ne::eval(env, e) = Np::eval(env, Ne::norm(e)) {
    match e: Ne::eval(env, e) = Np::eval(env, Ne::norm(e)) {
      NeConst(n) => Eq::sym(Np::const_sound(env, n))
      NeVar(i) => Eq::sym(
        Eq::trans(
          Nat::mul_one_left(Nat::mul(Ne::env_get(env, i), Succ(Zero))),
          Nat::mul_one_right(Ne::env_get(env, i))
        )
      )
      NeAdd(a, b) => Eq::trans(
        Eq::congr(⟦Nat::add(□, Ne::eval(env, b))⟧, Ne::norm_sound(env, a)),
        Eq::trans(
          Eq::congr(⟦Nat::add(Np::eval(env, Ne::norm(a)), □)⟧, Ne::norm_sound(env, b)),
          Eq::sym(Np::add_sound(env, Ne::norm(a), Ne::norm(b)))
        )
      )
      NeMul(a, b) => Eq::trans(
        Eq::congr(⟦Nat::mul(□, Ne::eval(env, b))⟧, Ne::norm_sound(env, a)),
        Eq::trans(
          Eq::congr(⟦Nat::mul(Np::eval(env, Ne::norm(a)), □)⟧, Ne::norm_sound(env, b)),
          Eq::sym(Np::mul_sound(env, Ne::norm(a), Ne::norm(b)))
        )
      )
    }
  }
}

module Nat {
  // The sides are equal when their normal forms are the same term.
  pub theorem norm_eq(
    env: List(Nat),
    a: NatExpr,
    b: NatExpr,
    same: Ne::norm(a) = Ne::norm(b)
  ): Ne::eval(env, a) = Ne::eval(env, b) {
    Eq::trans(
      Ne::norm_sound(env, a),
      Eq::trans(Eq::congr(⟦Np::eval(env, □)⟧, same), Eq::sym(Ne::norm_sound(env, b)))
    )
  }
}
