import "base.taut" { List }
import "list.taut" { List }
import std::prelude::std { List, Option }
import "calc.taut" { calc }

// A double-ended queue, persistent: a front list and a back list kept in
// reverse, so that both ends are a list head. Its elements are
// `Deque::to_list`; the theorems say what each operation does to that list.
// Taking from an end whose list is empty reverses the other list into it.

pub(open) inductive Deque(A: Type): Type {
  // The elements are `front` followed by `back` reversed.
  Mk(front: List(A), back: List(A)): Deque(A)
}

pub fn Deque::new<A>(): Deque(A) {
  Deque::Mk(Nil, Nil)
}

pub fn Deque::to_list<A>(d: Deque(A)): List(A) {
  match d {
    Mk(f, b) => List::append(f, List::reverse(b))
  }
}

pub fn Deque::of_list<A>(l: List(A)): Deque(A) {
  Deque::Mk(l, Nil)
}

pub fn Deque::len<A>(d: Deque(A)): Nat {
  match d {
    Mk(f, b) => List::length(f) + List::length(b)
  }
}

pub fn Deque::is_empty<A>(d: Deque(A)): Bool {
  match d {
    Mk(f, b) => ⊢ Bool from match f {
      Nil => ⊢ Bool from match b {
        Nil => true
        Cons(_, _) => false
      }
      Cons(_, _) => false
    }
  }
}

pub fn Deque::push_front<A>(d: Deque(A), x: A): Deque(A) {
  match d {
    Mk(f, b) => Deque::Mk(Cons(x, f), b)
  }
}

pub fn Deque::push_back<A>(d: Deque(A), x: A): Deque(A) {
  match d {
    Mk(f, b) => Deque::Mk(f, Cons(x, b))
  }
}

// The same elements in the other order: the front list and the back list
// change places.
pub fn Deque::flip<A>(d: Deque(A)): Deque(A) {
  match d {
    Mk(f, b) => Deque::Mk(b, f)
  }
}

pub fn Deque::take_head<A>(l: List(A)): Option(A × Deque(A)) {
  match l {
    Nil => None
    Cons(x, rest) => Some(#(x, Deque::Mk(rest, Nil)))
  }
}

pub fn Deque::pop_front<A>(d: Deque(A)): Option(A × Deque(A)) {
  match d {
    Mk(f, b) => ⊢ Option(A × Deque(A)) from match f {
      Nil => Deque::take_head(List::reverse(b))
      Cons(x, rest) => Some(#(x, Deque::Mk(rest, b)))
    }
  }
}

pub fn Deque::flip_popped<A>(o: Option(A × Deque(A))): Option(A × Deque(A)) {
  match o {
    None => None
    Some(#(x, rest)) => Some(#(x, Deque::flip(rest)))
  }
}

pub fn Deque::pop_back<A>(d: Deque(A)): Option(A × Deque(A)) {
  Deque::flip_popped(Deque::pop_front(Deque::flip(d)))
}

pub fn Deque::peek_front<A>(d: Deque(A)): Option(A) {
  match Deque::pop_front(d) {
    None => None
    Some(#(x, rest)) => Some(x)
  }
}

pub fn Deque::peek_back<A>(d: Deque(A)): Option(A) {
  match Deque::pop_back(d) {
    None => None
    Some(#(x, rest)) => Some(x)
  }
}

pub fn Deque::popped_list<A>(o: Option(A × Deque(A))): Option(A × List(A)) {
  match o {
    None => None
    Some(#(x, rest)) => Some(#(x, Deque::to_list(rest)))
  }
}

pub fn Deque::list_uncons<A>(l: List(A)): Option(A × List(A)) {
  match l {
    Nil => None
    Cons(x, rest) => Some(#(x, rest))
  }
}

// What the reversed list is to a popped element: the rest reversed back.
pub fn Deque::reverse_rest<A>(o: Option(A × List(A))): Option(A × List(A)) {
  match o {
    None => None
    Some(#(x, rest)) => Some(#(x, List::reverse(rest)))
  }
}

pub theorem Deque::new_to_list<A: Type>(): Deque::to_list(Deque::new(<A: A>)) = Nil {
  Refl
}

pub theorem Deque::of_list_to_list<A: Type>(l: List(A)): Deque::to_list(Deque::of_list(l)) = l {
  List::append_nil(l)
}

pub theorem Deque::len_to_list<A: Type>(d: Deque(A)): Deque::len(d) = List::length(Deque::to_list(d)) {
  match d {
    Mk(f, b) => calc!(```
      $(List::length(f) + List::length(b))
      = $(List::length(f) + List::length(
        List::reverse(b)
      )) from $Eq::congr(⟦Nat::add(List::length(f), □)⟧, Eq::sym(List::length_reverse(b)))
      = $List::length(
        List::append(f, List::reverse(b))
      ) from $Eq::sym(List::length_append(f, List::reverse(b)))
      ```)
  }
}

pub theorem Deque::push_front_to_list<A: Type>(
  d: Deque(A),
  x: A
): Deque::to_list(Deque::push_front(d, x)) = Cons(x, Deque::to_list(d)) {
  match d {
    Mk(_, _) => Refl
  }
}

pub theorem Deque::push_back_to_list<A: Type>(
  d: Deque(A),
  x: A
): Deque::to_list(Deque::push_back(d, x)) = List::append(Deque::to_list(d), Cons(x, Nil)) {
  match d {
    Mk(f, b) => calc!(```
      $List::append(f, List::reverse(Cons(x, b)))
      = $List::append(
        f,
        List::append(List::reverse(b), Cons(x, Nil))
      ) from $Eq::congr(⟦List::append(f, □)⟧, List::reverse_cons(x, b))
      = $List::append(
        List::append(f, List::reverse(b)),
        Cons(x, Nil)
      ) from $Eq::sym(List::append_assoc(f, List::reverse(b), Cons(x, Nil)))
      ```)
  }
}

pub theorem Deque::flip_to_list<A: Type>(d: Deque(A)): Deque::to_list(Deque::flip(d)) = List::reverse(Deque::to_list(d)) {
  match d {
    Mk(f, b) => Eq::sym(
      Eq::trans(
        List::reverse_append(f, List::reverse(b)),
        Eq::congr(⟦List::append(□, List::reverse(f))⟧, List::reverse_reverse(b))
      )
    )
  }
}

pub theorem Deque::take_head_list<A: Type>(l: List(A)): Deque::popped_list(Deque::take_head(l)) = Deque::list_uncons(l) {
  match l {
    Nil => Refl
    Cons(x, rest) => Eq::congr(⟦Some(#(x, □))⟧, List::append_nil(rest))
  }
}

pub theorem Deque::pop_front_list<A: Type>(
  d: Deque(A)
): Deque::popped_list(Deque::pop_front(d)) = Deque::list_uncons(Deque::to_list(d)) {
  match d {
    Mk(f, b) => ⊢ Deque::popped_list(
      Deque::pop_front(Deque::Mk(f, b))
    ) = Deque::list_uncons(Deque::to_list(Deque::Mk(f, b))) from match f {
      Nil => Deque::take_head_list(List::reverse(b))
      Cons(_, _) => Refl
    }
  }
}

pub theorem Deque::flip_popped_list<A: Type>(
  o: Option(A × Deque(A))
): Deque::popped_list(Deque::flip_popped(o)) = Deque::reverse_rest(Deque::popped_list(o)) {
  match o {
    None => Refl
    Some(#(x, rest)) => Eq::congr(⟦Some(#(x, □))⟧, Deque::flip_to_list(rest))
  }
}

// Popping the back takes the head of the elements reversed: the element is
// the last one, and the rest reversed back are the elements before it.
pub theorem Deque::pop_back_list<A: Type>(
  d: Deque(A)
): Deque::popped_list(Deque::pop_back(d)) = Deque::reverse_rest(Deque::list_uncons(List::reverse(Deque::to_list(d)))) {
  calc!(```
    $popped_list(flip_popped(pop_front(flip(d))))
    = $reverse_rest(popped_list(pop_front(flip(d)))) from $flip_popped_list(pop_front(flip(d)))
    = $reverse_rest(
      list_uncons(to_list(flip(d)))
    ) from $Eq::congr(⟦reverse_rest(□)⟧, pop_front_list(flip(d)))
    = $reverse_rest(
      list_uncons(List::reverse(to_list(d)))
    ) from $Eq::congr(⟦reverse_rest(list_uncons(□))⟧, flip_to_list(d))
    ```)
}
