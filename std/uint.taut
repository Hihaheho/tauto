// `UInt(16)` with its bound written as a number: `UInt::fits(16, n)` is
// `n < 65536`, which `fits16_ok` says once, so that a literal or a result is
// checked against the number without computing `2^16`.
pub theorem UInt::fits16_ok(n: Nat): UInt::fits(16, n) = (n < 65536) {
  Refl
}

pub fn UInt::mk16(n: Nat, h: n < 65536 = true): UInt(16) {
  UInt::Mk(n, Eq::trans(UInt::fits16_ok(n), h))
}

// Mapped: the number a `u16` is.
pub fn UInt::val16(x: UInt(16)): Nat {
  UInt::val(x)
}

pub theorem UInt::ok16(x: UInt(16)): UInt::val16(x) < 65536 = true {
  Eq::trans(Eq::sym(UInt::fits16_ok(UInt::val(x))), UInt::ok(x))
}

// Mapped: `n` as a `u16` when `o`, the decision of `n < 2^16`, says it fits.
pub fn UInt::of_decided16(n: Nat, o: Bool, h: n < 65536 = o): Option(UInt(16)) {
  match o {
    false => None
    true => Some(UInt::mk16(n, h))
  }
}

// Mapped: `n` as a `u16`, or `None` when it is `2^16` or more.
pub fn UInt::of_nat_checked16(n: Nat): Option(UInt(16)) {
  UInt::of_decided16(n, n < 65536, Refl)
}

// Mapped: `a + b`, which `h` says fits.
pub fn UInt::add16(a: UInt(16), b: UInt(16), h: Nat::add(UInt::val16(a), UInt::val16(b)) < 65536 = true): UInt(16) {
  UInt::mk16(Nat::add(UInt::val16(a), UInt::val16(b)), h)
}

// Mapped: `a - b`, where `h` says `b <= a`.
pub fn UInt::sub16(a: UInt(16), b: UInt(16), h: UInt::val16(b) <= UInt::val16(a) = true): UInt(16) {
  UInt::mk16(
    UInt::val16(a) - UInt::val16(b),
    Nat::le_lt_trans(
      UInt::val16(a) - UInt::val16(b),
      UInt::val16(a),
      65536,
      Nat::sub_le(UInt::val16(a), UInt::val16(b)),
      UInt::ok16(a)
    )
  )
}

// Mapped: `a * b`, which `h` says fits.
pub fn UInt::mul16(a: UInt(16), b: UInt(16), h: Nat::mul(UInt::val16(a), UInt::val16(b)) < 65536 = true): UInt(16) {
  UInt::mk16(Nat::mul(UInt::val16(a), UInt::val16(b)), h)
}

// Mapped: `a + b`, or `None` when it does not fit.
pub fn UInt::checked_add16(a: UInt(16), b: UInt(16)): Option(UInt(16)) {
  UInt::of_nat_checked16(Nat::add(UInt::val16(a), UInt::val16(b)))
}

// Mapped: `a - b`, or `None` when `b` is larger.
pub fn UInt::checked_sub16(a: UInt(16), b: UInt(16)): Option(UInt(16)) {
  match UInt::val16(a) < UInt::val16(b) {
    false => UInt::of_nat_checked16(UInt::val16(a) - UInt::val16(b))
    true => None
  }
}

// Mapped: `a * b`, or `None` when it does not fit.
pub fn UInt::checked_mul16(a: UInt(16), b: UInt(16)): Option(UInt(16)) {
  UInt::of_nat_checked16(Nat::mul(UInt::val16(a), UInt::val16(b)))
}

// Mapped: the comparisons.
pub fn UInt::lt16(a: UInt(16), b: UInt(16)): Bool {
  UInt::val16(a) < UInt::val16(b)
}

pub fn UInt::le16(a: UInt(16), b: UInt(16)): Bool {
  UInt::val16(a) <= UInt::val16(b)
}

pub fn UInt::eq16(a: UInt(16), b: UInt(16)): Bool {
  UInt::val16(a) == UInt::val16(b)
}

pub fn UInt::of_nat_mod16(n: Nat): UInt(16) {
  UInt::mk16(
    Nat::rem_nz(n, 65536, Nat::ne_zero(65536, Refl)),
    Nat::mod_lt(n, 65536, Refl)
  )
}

// Mapped: `a + b` modulo `2^16`.
pub fn UInt::wrapping_add16(a: UInt(16), b: UInt(16)): UInt(16) {
  UInt::mk16(
    Nat::rem_nz(Nat::add(UInt::val16(a), UInt::val16(b)), 65536, Nat::ne_zero(65536, Refl)),
    Nat::mod_lt(Nat::add(UInt::val16(a), UInt::val16(b)), 65536, Refl)
