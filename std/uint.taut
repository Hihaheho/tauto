import std::prelude::num { overflow, divzero }
import "base.taut" { Nat }
import "nat.taut" { Nat }
import std::prelude::std { Option }

// Unsigned integers of a fixed width, as the proofs see them: a `Nat` with a
// proof that it is below `2^w`. Extraction maps `UInt(8)`, `UInt(16)`, `UInt(32)` and `UInt(64)`
// onto Nib's `u8`, `u16`, `u32` and `u64`, and the functions marked "Mapped" onto its
// operators; their definitions here say what those operators do, so a proof
// about them holds of the program that runs.
//
// The arithmetic comes in two kinds:
//
// * `UInt::add64(a, b, h)` takes a proof `h` that the result fits. Its value is
//   the exact sum, and it never fails at run time.
// * `UInt::checked_add64(a, b)` decides: `Some` of the exact sum when it fits,
//   `None` when it does not.
//
// * `UInt::wrapping_add64(a, b)` is the sum modulo `2^64`, said so in its
//   name: a wrap is never silent.
// * `UInt::add_or_overflow64(a, b)` performs `overflow` when it does not fit.
//   A handler of `overflow` cannot resume (its answer is `Never`), so the
//   value is the exact sum or nothing.
//
// Nothing here wraps silently.

// The type with no values: what `overflow` answers.
pub(open) inductive Never: Type {
}

pub fn Never::elim<A>(n: Never): A {
  match n {
  }
}

// The value in `o`, or `divzero` when it is `None`. `Nat::div`, `UInt::div8`,
// `Int::tdiv`, … are this of `Nat::checked_div`, `UInt::checked_div8`,
// `Int::checked_tdiv`, …: those decide whether the divisor is 0 and give
// `div_nz` its proof, and the kernel checks them; the kernel does not check
// a function that performs an effect, and such code cannot give a proof.
pub fn or_div_zero<A>(o: Option(A)): A ! {divzero} {
  ⊢ A from match o {
    Some(x) => x
    None => Never::elim(perform divzero())
  }
}

// `div`, or `None` when `b` is 0.
pub fn Nat::checked_div(a: Nat, b: Nat): Option(Nat) {
  match b == 0 eqn h {
    false => Some(Nat::div_nz(a, b, Nat::ne_zero(b, h)))
    true => None
  }
}

// `a div b`, rounded down, or `divzero` when `b` is 0.
pub fn Nat::div(a: Nat, b: Nat): Nat ! {divzero} {
  or_div_zero(Nat::checked_div(a, b))
}

// `rem`, or `None` when `b` is 0.
pub fn Nat::checked_rem(a: Nat, b: Nat): Option(Nat) {
  match b == 0 eqn h {
    false => Some(Nat::rem_nz(a, b, Nat::ne_zero(b, h)))
    true => None
  }
}

// The remainder of `div`, or `divzero` when `b` is 0.
pub fn Nat::rem(a: Nat, b: Nat): Nat ! {divzero} {
  or_div_zero(Nat::checked_rem(a, b))
}

// The three forms of `a - b` on `Nat`, whose result does not exist when
// `b` is larger. `-` performs `overflow` then; `Nat::sub`, the kernel's,
// stops at 0 and is total.

// `a - b`, where `h` says `b <= a`: the exact difference, with no path
// that fails.
pub fn Nat::sub_ge(a: Nat, b: Nat, h: b <= a = true): Nat {
  Nat::sub(a, b)
}

// `a - b`, or `None` when `b` is larger.
pub fn Nat::checked_sub(a: Nat, b: Nat): Option(Nat) {
  match b <= a eqn h {
    true => Some(Nat::sub_ge(a, b, h))
    false => None
  }
}

// `a - b`, or `overflow` when `b` is larger: what `-` on `Nat` does.
pub fn Nat::sub_or_overflow(a: Nat, b: Nat): Nat ! {overflow} {
  ⊢ Nat from match Nat::checked_sub(a, b) {
    Some(x) => x
    None => Never::elim(perform overflow())
  }
}

pub theorem Nat::le_lt_trans(
  a: Nat,
  b: Nat,
  c: Nat,
  h1: a <= b = true,
  h2: b < c = true
): a < c = true {
  Nat::le_trans(Succ(a), Succ(b), c, h1, h2)
}

pub theorem Nat::pred_le(n: Nat): Nat::pred(n) <= n = true {
  match n {
    Zero => Refl
    Succ(k) => Nat::le_succ(k)
  }
}

// `a - b` (cut off at 0) is at most `a`.
pub theorem Nat::sub_le(a: Nat, b: Nat): a - b <= a = true {
  match b {
    Zero => Nat::le_refl(a)
    Succ(k) => ⊢ a - Succ(k) <= a = true from match a {
      Zero => Refl
      Succ(j) => Nat::le_trans(j - k, j, Succ(j), Nat::sub_le(j, k), Nat::pred_le(Succ(j)))
    }
  }
}

// ---- bits --------------------------------------------------------------------
//
// The bits of a word, written on its value: the low `w` bits of `a` and `b`
// one at a time, by `Nat::rem_nz(_, 2, _)` and `Nat::div_nz(_, 2, _)`. The kernel computes
// those on numerals at once, so `Refl` decides an equation between words
// (a hash's test vector) without unfolding `Nat` to unary.

pub fn Nat::bits_and(w: Nat, a: Nat, b: Nat): Nat {
  match w {
    Zero => Zero
    Succ(k) => Nat::add(
      Nat::mul(Nat::rem_nz(a, 2, Nat::ne_zero(2, Refl)), Nat::rem_nz(b, 2, Nat::ne_zero(2, Refl))),
      Nat::mul(
        2,
        Nat::bits_and(
          k,
          Nat::div_nz(a, 2, Nat::ne_zero(2, Refl)),
          Nat::div_nz(b, 2, Nat::ne_zero(2, Refl))
        )
      )
    )
  }
}

pub fn Nat::bits_or(w: Nat, a: Nat, b: Nat): Nat {
  match w {
    Zero => Zero
    Succ(k) => Nat::add(
      Nat::add(
        Nat::rem_nz(a, 2, Nat::ne_zero(2, Refl)),
        Nat::rem_nz(b, 2, Nat::ne_zero(2, Refl))
      ) - Nat::mul(
        Nat::rem_nz(a, 2, Nat::ne_zero(2, Refl)),
        Nat::rem_nz(b, 2, Nat::ne_zero(2, Refl))
      ),
      Nat::mul(
        2,
        Nat::bits_or(
          k,
          Nat::div_nz(a, 2, Nat::ne_zero(2, Refl)),
          Nat::div_nz(b, 2, Nat::ne_zero(2, Refl))
        )
      )
    )
  }
}

pub fn Nat::bits_xor(w: Nat, a: Nat, b: Nat): Nat {
  match w {
    Zero => Zero
    Succ(k) => Nat::add(
      Nat::rem_nz(
        Nat::add(
          Nat::rem_nz(a, 2, Nat::ne_zero(2, Refl)),
          Nat::rem_nz(b, 2, Nat::ne_zero(2, Refl))
        ),
        2,
        Nat::ne_zero(2, Refl)
      ),
      Nat::mul(
        2,
        Nat::bits_xor(
          k,
          Nat::div_nz(a, 2, Nat::ne_zero(2, Refl)),
          Nat::div_nz(b, 2, Nat::ne_zero(2, Refl))
        )
      )
    )
  }
}

pub fn Nat::pow2(n: Nat): Nat {
  match n {
    Zero => 1
    Succ(k) => Nat::mul(2, Nat::pow2(k))
  }
}

pub theorem Nat::double_ne_zero(x: Nat, h: x == 0 = false): Nat::mul(2, x) == 0 = false {
  match x {
    Zero => ⊢ Nat::mul(2, Zero) == 0 = false from match true_ne_false(h) {
    }
    Succ(y) => Refl
  }
}

pub theorem Nat::pow2_eq_zero(n: Nat): Nat::pow2(n) == 0 = false {
  match n {
    Zero => Refl
    Succ(k) => Nat::double_ne_zero(Nat::pow2(k), Nat::pow2_eq_zero(k))
  }
}

// `2^n` is not 0: the divisor of a shift.
pub theorem Nat::pow2_ne_zero(n: Nat): ¬(Nat::pow2(n) = 0) {
  Nat::ne_zero(Nat::pow2(n), Nat::pow2_eq_zero(n))
}

// ---- the family ------------------------------------------------------------
//
// `UInt(w)`: a `Nat` below `2^w`. It is the one definition of the unsigned
// integers of every width; `u8`, `u32` and `u64` of a program are
// `UInt(8)`, `UInt(32)` and `UInt(64)`. The functions with the width in
// their name (`UInt::add64`) are the same operations with the bound written
// as a number, which is what extraction maps onto Nib's operators.

pub fn UInt::bound(w: Nat): Nat {
  Nat::pow2(w)
}

pub fn UInt::fits(w: Nat, n: Nat): Bool {
  n < UInt::bound(w)
}

pub(open) inductive UInt(w: Nat): Type {
  Mk(val: Nat, ok: UInt::fits(w, val) = true): UInt(w)
}

pub fn UInt::val<w: Nat>(x: UInt(w)): Nat {
  match x {
    Mk(v, h) => v
  }
}

pub theorem UInt::ok<w: Nat>(x: UInt(w)): UInt::fits(w, UInt::val(x)) = true {
  match x {
    Mk(v, h) => h
  }
}

// `UInt(8)` with its bound written as a number: `UInt::fits(8, n)` is
// `n < 256`, which `fits8_ok` says once, so that a literal or a result is
// checked against the number without computing `2^8`.
pub theorem UInt::fits8_ok(n: Nat): UInt::fits(8, n) = (n < 256) {
  Refl
}

pub fn UInt::mk8(n: Nat, h: n < 256 = true): UInt(8) {
  UInt::Mk(n, Eq::trans(UInt::fits8_ok(n), h))
}

// Mapped: the number a `u8` is.
pub fn UInt::val8(x: UInt(8)): Nat {
  UInt::val(x)
}

pub theorem UInt::ok8(x: UInt(8)): UInt::val8(x) < 256 = true {
  Eq::trans(Eq::sym(UInt::fits8_ok(UInt::val(x))), UInt::ok(x))
}

// Mapped: `n` as a `u8` when `o`, the decision of `n < 2^8`, says it fits.
pub fn UInt::of_decided8(n: Nat, o: Bool, h: n < 256 = o): Option(UInt(8)) {
  match o {
    false => None
    true => Some(UInt::mk8(n, h))
  }
}

// Mapped: `n` as a `u8`, or `None` when it is `2^8` or more.
pub fn UInt::of_nat_checked8(n: Nat): Option(UInt(8)) {
  UInt::of_decided8(n, n < 256, Refl)
}

// Mapped: `a + b`, which `h` says fits.
pub fn UInt::add8(a: UInt(8), b: UInt(8), h: Nat::add(UInt::val8(a), UInt::val8(b)) < 256 = true): UInt(8) {
  UInt::mk8(Nat::add(UInt::val8(a), UInt::val8(b)), h)
}

// Mapped: `a - b`, where `h` says `b <= a`.
pub fn UInt::sub8(a: UInt(8), b: UInt(8), h: UInt::val8(b) <= UInt::val8(a) = true): UInt(8) {
  UInt::mk8(
    UInt::val8(a) - UInt::val8(b),
    Nat::le_lt_trans(
      UInt::val8(a) - UInt::val8(b),
      UInt::val8(a),
      256,
      Nat::sub_le(UInt::val8(a), UInt::val8(b)),
      UInt::ok8(a)
    )
  )
}

// Mapped: `a * b`, which `h` says fits.
pub fn UInt::mul8(a: UInt(8), b: UInt(8), h: Nat::mul(UInt::val8(a), UInt::val8(b)) < 256 = true): UInt(8) {
  UInt::mk8(Nat::mul(UInt::val8(a), UInt::val8(b)), h)
}

// Mapped: `a + b`, or `None` when it does not fit.
pub fn UInt::checked_add8(a: UInt(8), b: UInt(8)): Option(UInt(8)) {
  UInt::of_nat_checked8(Nat::add(UInt::val8(a), UInt::val8(b)))
}

// Mapped: `a - b`, or `None` when `b` is larger.
pub fn UInt::checked_sub8(a: UInt(8), b: UInt(8)): Option(UInt(8)) {
  match UInt::val8(a) < UInt::val8(b) {
    false => UInt::of_nat_checked8(UInt::val8(a) - UInt::val8(b))
    true => None
  }
}

// Mapped: `a * b`, or `None` when it does not fit.
pub fn UInt::checked_mul8(a: UInt(8), b: UInt(8)): Option(UInt(8)) {
  UInt::of_nat_checked8(Nat::mul(UInt::val8(a), UInt::val8(b)))
}

// Mapped: the comparisons.
pub fn UInt::lt8(a: UInt(8), b: UInt(8)): Bool {
  UInt::val8(a) < UInt::val8(b)
}

pub fn UInt::le8(a: UInt(8), b: UInt(8)): Bool {
  UInt::val8(a) <= UInt::val8(b)
}

pub fn UInt::eq8(a: UInt(8), b: UInt(8)): Bool {
  UInt::val8(a) == UInt::val8(b)
}

pub fn UInt::of_nat_mod8(n: Nat): UInt(8) {
  UInt::mk8(Nat::rem_nz(n, 256, Nat::ne_zero(256, Refl)), Nat::mod_lt(n, 256, Refl))
}

// Mapped: `a + b` modulo `2^8`.
pub fn UInt::wrapping_add8(a: UInt(8), b: UInt(8)): UInt(8) {
  UInt::mk8(
    Nat::rem_nz(Nat::add(UInt::val8(a), UInt::val8(b)), 256, Nat::ne_zero(256, Refl)),
    Nat::mod_lt(Nat::add(UInt::val8(a), UInt::val8(b)), 256, Refl)
  )
}

// Mapped: `a - b` modulo `2^8`.
pub fn UInt::wrapping_sub8(a: UInt(8), b: UInt(8)): UInt(8) {
  UInt::mk8(
    Nat::rem_nz(Nat::add(UInt::val8(a), 256) - UInt::val8(b), 256, Nat::ne_zero(256, Refl)),
    Nat::mod_lt(Nat::add(UInt::val8(a), 256) - UInt::val8(b), 256, Refl)
  )
}

// Mapped: `a * b` modulo `2^8`.
pub fn UInt::wrapping_mul8(a: UInt(8), b: UInt(8)): UInt(8) {
  UInt::mk8(
    Nat::rem_nz(Nat::mul(UInt::val8(a), UInt::val8(b)), 256, Nat::ne_zero(256, Refl)),
    Nat::mod_lt(Nat::mul(UInt::val8(a), UInt::val8(b)), 256, Refl)
  )
}

pub theorem UInt::wrapping_add_val8(
  a: UInt(8),
  b: UInt(8)
): UInt::val8(
  UInt::wrapping_add8(a, b)
) = Nat::rem_nz(Nat::add(UInt::val8(a), UInt::val8(b)), 256, Nat::ne_zero(256, Refl)) {
  Refl
}

pub theorem UInt::wrapping_mul_val8(
  a: UInt(8),
  b: UInt(8)
): UInt::val8(
  UInt::wrapping_mul8(a, b)
) = Nat::rem_nz(Nat::mul(UInt::val8(a), UInt::val8(b)), 256, Nat::ne_zero(256, Refl)) {
  Refl
}

// Mapped: the value in `o`, or `overflow`.
pub fn UInt::or_overflow8(o: Option(UInt(8))): UInt(8) ! {overflow} {
  ⊢ UInt(8) from match o {
    Some(x) => x
    None => Never::elim(perform overflow())
  }
}

pub fn UInt::add_or_overflow8(a: UInt(8), b: UInt(8)): UInt(8) ! {overflow} {
  UInt::or_overflow8(UInt::checked_add8(a, b))
}

pub fn UInt::sub_or_overflow8(a: UInt(8), b: UInt(8)): UInt(8) ! {overflow} {
  UInt::or_overflow8(UInt::checked_sub8(a, b))
}

pub fn UInt::mul_or_overflow8(a: UInt(8), b: UInt(8)): UInt(8) ! {overflow} {
  UInt::or_overflow8(UInt::checked_mul8(a, b))
}

// `a / b` rounded down, for a `b` that `h` says is not 0. The
// quotient is at most `a`, so `of_nat_checked` always gives it; the `None` arm is
// never reached.
pub fn UInt::div_nz8(a: UInt(8), b: UInt(8), h: ¬(UInt::val8(b) = 0)): UInt(8) {
  match UInt::of_nat_checked8(Nat::div_nz(UInt::val8(a), UInt::val8(b), h)) {
    Some(q) => q
    None => a
  }
}

// The remainder of `div_nz`, below `b`, so `of_nat_checked` always gives it.
pub fn UInt::rem_nz8(a: UInt(8), b: UInt(8), h: ¬(UInt::val8(b) = 0)): UInt(8) {
  match UInt::of_nat_checked8(Nat::rem_nz(UInt::val8(a), UInt::val8(b), h)) {
    Some(r) => r
    None => a
  }
}

// `div`, or `None` when `b` is 0.
pub fn UInt::checked_div8(a: UInt(8), b: UInt(8)): Option(UInt(8)) {
  match UInt::val8(b) == 0 eqn h {
    false => Some(UInt::div_nz8(a, b, Nat::ne_zero(UInt::val8(b), h)))
    true => None
  }
}

// `a / b` rounded down, or `divzero` when `b` is 0.
pub fn UInt::div8(a: UInt(8), b: UInt(8)): UInt(8) ! {divzero} {
  or_div_zero(UInt::checked_div8(a, b))
}

// `rem`, or `None` when `b` is 0.
pub fn UInt::checked_rem8(a: UInt(8), b: UInt(8)): Option(UInt(8)) {
  match UInt::val8(b) == 0 eqn h {
    false => Some(UInt::rem_nz8(a, b, Nat::ne_zero(UInt::val8(b), h)))
    true => None
  }
}

// The remainder of `div`, or `divzero` when `b` is 0.
pub fn UInt::rem8(a: UInt(8), b: UInt(8)): UInt(8) ! {divzero} {
  or_div_zero(UInt::checked_rem8(a, b))
}

// `overflow` caught as `None`.
pub fn UInt::catch8(o: Option(UInt(8))): Option(UInt(8)) {
  handle { Some(UInt::or_overflow8(o)) } with {
    overflow() => None
  }
}

// Catching `overflow` gives back the decision: the effect says no more and
// no less than the `Option`.
pub theorem UInt::catch_is8(o: Option(UInt(8))): UInt::catch8(o) = o {
  match o {
    Some(x) => Refl
    None => Refl
  }
}

pub theorem UInt::add_val8(
  a: UInt(8),
  b: UInt(8),
  h: Nat::add(UInt::val8(a), UInt::val8(b)) < 256 = true
): UInt::val8(UInt::add8(a, b, h)) = Nat::add(UInt::val8(a), UInt::val8(b)) {
  Refl
}

pub theorem UInt::sub_val8(
  a: UInt(8),
  b: UInt(8),
  h: UInt::val8(b) <= UInt::val8(a) = true
): UInt::val8(UInt::sub8(a, b, h)) = UInt::val8(a) - UInt::val8(b) {
  Refl
}

pub theorem UInt::mul_val8(
  a: UInt(8),
  b: UInt(8),
  h: Nat::mul(UInt::val8(a), UInt::val8(b)) < 256 = true
): UInt::val8(UInt::mul8(a, b, h)) = Nat::mul(UInt::val8(a), UInt::val8(b)) {
  Refl
}

// `UInt(32)` with its bound written as a number: `UInt::fits(32, n)` is
// `n < 4294967296`, which `fits32_ok` says once, so that a literal or a result is
// checked against the number without computing `2^32`.
pub theorem UInt::fits32_ok(n: Nat): UInt::fits(32, n) = (n < 4294967296) {
  Refl
}

pub fn UInt::mk32(n: Nat, h: n < 4294967296 = true): UInt(32) {
  UInt::Mk(n, Eq::trans(UInt::fits32_ok(n), h))
}

// Mapped: the number a `u32` is.
pub fn UInt::val32(x: UInt(32)): Nat {
  UInt::val(x)
}

pub theorem UInt::ok32(x: UInt(32)): UInt::val32(x) < 4294967296 = true {
  Eq::trans(Eq::sym(UInt::fits32_ok(UInt::val(x))), UInt::ok(x))
}

// Mapped: `n` as a `u32` when `o`, the decision of `n < 2^32`, says it fits.
pub fn UInt::of_decided32(n: Nat, o: Bool, h: n < 4294967296 = o): Option(UInt(32)) {
  match o {
    false => None
    true => Some(UInt::mk32(n, h))
  }
}

// Mapped: `n` as a `u32`, or `None` when it is `2^32` or more.
pub fn UInt::of_nat_checked32(n: Nat): Option(UInt(32)) {
  UInt::of_decided32(n, n < 4294967296, Refl)
}

// Mapped: `a + b`, which `h` says fits.
pub fn UInt::add32(a: UInt(32), b: UInt(32), h: Nat::add(UInt::val32(a), UInt::val32(b)) < 4294967296 = true): UInt(32) {
  UInt::mk32(Nat::add(UInt::val32(a), UInt::val32(b)), h)
}

// Mapped: `a - b`, where `h` says `b <= a`.
pub fn UInt::sub32(a: UInt(32), b: UInt(32), h: UInt::val32(b) <= UInt::val32(a) = true): UInt(32) {
  UInt::mk32(
    UInt::val32(a) - UInt::val32(b),
    Nat::le_lt_trans(
      UInt::val32(a) - UInt::val32(b),
      UInt::val32(a),
      4294967296,
      Nat::sub_le(UInt::val32(a), UInt::val32(b)),
      UInt::ok32(a)
    )
  )
}

// Mapped: `a * b`, which `h` says fits.
pub fn UInt::mul32(a: UInt(32), b: UInt(32), h: Nat::mul(UInt::val32(a), UInt::val32(b)) < 4294967296 = true): UInt(32) {
  UInt::mk32(Nat::mul(UInt::val32(a), UInt::val32(b)), h)
}

// Mapped: `a + b`, or `None` when it does not fit.
pub fn UInt::checked_add32(a: UInt(32), b: UInt(32)): Option(UInt(32)) {
  UInt::of_nat_checked32(Nat::add(UInt::val32(a), UInt::val32(b)))
}

// Mapped: `a - b`, or `None` when `b` is larger.
pub fn UInt::checked_sub32(a: UInt(32), b: UInt(32)): Option(UInt(32)) {
  match UInt::val32(a) < UInt::val32(b) {
    false => UInt::of_nat_checked32(UInt::val32(a) - UInt::val32(b))
    true => None
  }
}

// Mapped: `a * b`, or `None` when it does not fit.
pub fn UInt::checked_mul32(a: UInt(32), b: UInt(32)): Option(UInt(32)) {
  UInt::of_nat_checked32(Nat::mul(UInt::val32(a), UInt::val32(b)))
}

// Mapped: the comparisons.
pub fn UInt::lt32(a: UInt(32), b: UInt(32)): Bool {
  UInt::val32(a) < UInt::val32(b)
}

pub fn UInt::le32(a: UInt(32), b: UInt(32)): Bool {
  UInt::val32(a) <= UInt::val32(b)
}

pub fn UInt::eq32(a: UInt(32), b: UInt(32)): Bool {
  UInt::val32(a) == UInt::val32(b)
}

pub fn UInt::of_nat_mod32(n: Nat): UInt(32) {
  UInt::mk32(
    Nat::rem_nz(n, 4294967296, Nat::ne_zero(4294967296, Refl)),
    Nat::mod_lt(n, 4294967296, Refl)
  )
}

// Mapped: `a + b` modulo `2^32`.
pub fn UInt::wrapping_add32(a: UInt(32), b: UInt(32)): UInt(32) {
  UInt::mk32(
    Nat::rem_nz(Nat::add(UInt::val32(a), UInt::val32(b)), 4294967296, Nat::ne_zero(4294967296, Refl)),
    Nat::mod_lt(Nat::add(UInt::val32(a), UInt::val32(b)), 4294967296, Refl)
  )
}

// Mapped: `a - b` modulo `2^32`.
pub fn UInt::wrapping_sub32(a: UInt(32), b: UInt(32)): UInt(32) {
  UInt::mk32(
    Nat::rem_nz(
      Nat::add(UInt::val32(a), 4294967296) - UInt::val32(b),
      4294967296,
      Nat::ne_zero(4294967296, Refl)
    ),
    Nat::mod_lt(Nat::add(UInt::val32(a), 4294967296) - UInt::val32(b), 4294967296, Refl)
  )
}

// Mapped: `a * b` modulo `2^32`.
pub fn UInt::wrapping_mul32(a: UInt(32), b: UInt(32)): UInt(32) {
  UInt::mk32(
    Nat::rem_nz(Nat::mul(UInt::val32(a), UInt::val32(b)), 4294967296, Nat::ne_zero(4294967296, Refl)),
    Nat::mod_lt(Nat::mul(UInt::val32(a), UInt::val32(b)), 4294967296, Refl)
  )
}

pub theorem UInt::wrapping_add_val32(
  a: UInt(32),
  b: UInt(32)
): UInt::val32(
  UInt::wrapping_add32(a, b)
) = Nat::rem_nz(Nat::add(UInt::val32(a), UInt::val32(b)), 4294967296, Nat::ne_zero(4294967296, Refl)) {
  Refl
}

pub theorem UInt::wrapping_mul_val32(
  a: UInt(32),
  b: UInt(32)
): UInt::val32(
