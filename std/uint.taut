// `a / b` rounded down, for a `b` that `h` says is not 0. The
// quotient is at most `a`, so `of_nat_checked` always gives it; the `None` arm is
// never reached.
pub fn UInt::div_nz32(a: UInt(32), b: UInt(32), h: ¬(UInt::val32(b) = 0)): UInt(32) {
  match UInt::of_nat_checked32(Nat::div_nz(UInt::val32(a), UInt::val32(b), h)) {
    Some(q) => q
    None => a
  }
}

// The remainder of `div_nz`, below `b`, so `of_nat_checked` always gives it.
pub fn UInt::rem_nz32(a: UInt(32), b: UInt(32), h: ¬(UInt::val32(b) = 0)): UInt(32) {
  match UInt::of_nat_checked32(Nat::rem_nz(UInt::val32(a), UInt::val32(b), h)) {
    Some(r) => r
    None => a
  }
}

// `div`, or `None` when `b` is 0.
pub fn UInt::checked_div32(a: UInt(32), b: UInt(32)): Option(UInt(32)) {
  match UInt::val32(b) == 0 eqn h {
    false => Some(UInt::div_nz32(a, b, Nat::ne_zero(UInt::val32(b), h)))
    true => None
  }
}

// `a / b` rounded down, or `divzero` when `b` is 0.
pub fn UInt::div32(a: UInt(32), b: UInt(32)): UInt(32) ! {divzero} {
  or_div_zero(UInt::checked_div32(a, b))
}

// `rem`, or `None` when `b` is 0.
pub fn UInt::checked_rem32(a: UInt(32), b: UInt(32)): Option(UInt(32)) {
