}

// Mapped: the value in `o`, or `overflow`.
pub fn UInt::or_overflow32(o: Option(UInt(32))): UInt(32) ! {overflow} {
  ⊢ UInt(32) from match o {
    Some(x) => x
    None => Never::elim(perform overflow())
  }
}

pub fn UInt::add_or_overflow32(a: UInt(32), b: UInt(32)): UInt(32) ! {overflow} {
  UInt::or_overflow32(UInt::checked_add32(a, b))
}

pub fn UInt::sub_or_overflow32(a: UInt(32), b: UInt(32)): UInt(32) ! {overflow} {
  UInt::or_overflow32(UInt::checked_sub32(a, b))
