}

// `overflow` caught as `None`.
pub fn UInt::catch32(o: Option(UInt(32))): Option(UInt(32)) {
  handle { Some(UInt::or_overflow32(o)) } with {
    overflow() => None
  }
}

// Catching `overflow` gives back the decision: the effect says no more and
// no less than the `Option`.
pub theorem UInt::catch_is32(o: Option(UInt(32))): UInt::catch32(o) = o {
  match o {
    Some(x) => Refl
    None => Refl
  }
}

