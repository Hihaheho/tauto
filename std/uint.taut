// quotient is at most `a`, so `of_nat_checked` always gives it; the `None` arm is
// never reached.
pub fn UInt::div_nz64(a: UInt(64), b: UInt(64), h: ¬(UInt::val64(b) = 0)): UInt(64) {
  match UInt::of_nat_checked64(Nat::div_nz(UInt::val64(a), UInt::val64(b), h)) {
    Some(q) => q
    None => a
  }
}

// The remainder of `div_nz`, below `b`, so `of_nat_checked` always gives it.
pub fn UInt::rem_nz64(a: UInt(64), b: UInt(64), h: ¬(UInt::val64(b) = 0)): UInt(64) {
  match UInt::of_nat_checked64(Nat::rem_nz(UInt::val64(a), UInt::val64(b), h)) {
    Some(r) => r
    None => a
  }
}

// `div`, or `None` when `b` is 0.
pub fn UInt::checked_div64(a: UInt(64), b: UInt(64)): Option(UInt(64)) {
  match UInt::val64(b) == 0 eqn h {
    false => Some(UInt::div_nz64(a, b, Nat::ne_zero(UInt::val64(b), h)))
    true => None
  }
}

// `a / b` rounded down, or `divzero` when `b` is 0.
pub fn UInt::div64(a: UInt(64), b: UInt(64)): UInt(64) ! {divzero} {
  or_div_zero(UInt::checked_div64(a, b))
}

// `rem`, or `None` when `b` is 0.
pub fn UInt::checked_rem64(a: UInt(64), b: UInt(64)): Option(UInt(64)) {
  match UInt::val64(b) == 0 eqn h {
    false => Some(UInt::rem_nz64(a, b, Nat::ne_zero(UInt::val64(b), h)))
    true => None
  }
}

// The remainder of `div`, or `divzero` when `b` is 0.
pub fn UInt::rem64(a: UInt(64), b: UInt(64)): UInt(64) ! {divzero} {
  or_div_zero(UInt::checked_rem64(a, b))
}

// `overflow` caught as `None`.
pub fn UInt::catch64(o: Option(UInt(64))): Option(UInt(64)) {
  handle { Some(UInt::or_overflow64(o)) } with {
    overflow() => None
  }
}

// Catching `overflow` gives back the decision: the effect says no more and
// no less than the `Option`.
pub theorem UInt::catch_is64(o: Option(UInt(64))): UInt::catch64(o) = o {
  match o {
    Some(x) => Refl
    None => Refl
  }
}

pub theorem UInt::add_val64(
  a: UInt(64),
  b: UInt(64),
  h: Nat::add(UInt::val64(a), UInt::val64(b)) < 18446744073709551616 = true
): UInt::val64(UInt::add64(a, b, h)) = Nat::add(UInt::val64(a), UInt::val64(b)) {
  Refl
}

pub theorem UInt::sub_val64(
  a: UInt(64),
  b: UInt(64),
  h: UInt::val64(b) <= UInt::val64(a) = true
): UInt::val64(UInt::sub64(a, b, h)) = UInt::val64(a) - UInt::val64(b) {
  Refl
}

pub theorem UInt::mul_val64(
  a: UInt(64),
  b: UInt(64),
  h: Nat::mul(UInt::val64(a), UInt::val64(b)) < 18446744073709551616 = true
): UInt::val64(UInt::mul64(a, b, h)) = Nat::mul(UInt::val64(a), UInt::val64(b)) {
  Refl
}

// Mapped: the bits set in both `a` and `b`.
pub fn UInt::and64(a: UInt(64), b: UInt(64)): UInt(64) {
  UInt::mk64(
    Nat::rem_nz(
      Nat::bits_and(64, UInt::val64(a), UInt::val64(b)),
      18446744073709551616,
      Nat::ne_zero(18446744073709551616, Refl)
    ),
    Nat::mod_lt(Nat::bits_and(64, UInt::val64(a), UInt::val64(b)), 18446744073709551616, Refl)
  )
}

// Mapped: the bits set in `a` or `b`.
pub fn UInt::or64(a: UInt(64), b: UInt(64)): UInt(64) {
  UInt::mk64(
    Nat::rem_nz(
      Nat::bits_or(64, UInt::val64(a), UInt::val64(b)),
      18446744073709551616,
      Nat::ne_zero(18446744073709551616, Refl)
    ),
    Nat::mod_lt(Nat::bits_or(64, UInt::val64(a), UInt::val64(b)), 18446744073709551616, Refl)
  )
}

// Mapped: the bits set in one of `a` and `b`.
pub fn UInt::xor64(a: UInt(64), b: UInt(64)): UInt(64) {
  UInt::mk64(
    Nat::rem_nz(
      Nat::bits_xor(64, UInt::val64(a), UInt::val64(b)),
      18446744073709551616,
      Nat::ne_zero(18446744073709551616, Refl)
    ),
    Nat::mod_lt(Nat::bits_xor(64, UInt::val64(a), UInt::val64(b)), 18446744073709551616, Refl)
  )
}

// Mapped: `a` shifted left by `s` modulo 64, the bits past the top dropped.
pub fn UInt::shl64(a: UInt(64), s: Nat): UInt(64) {
  UInt::mk64(
    Nat::rem_nz(
      Nat::mul(UInt::val64(a), Nat::pow2(Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl)))),
      18446744073709551616,
      Nat::ne_zero(18446744073709551616, Refl)
    ),
    Nat::mod_lt(
      Nat::mul(UInt::val64(a), Nat::pow2(Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl)))),
      18446744073709551616,
      Refl
    )
  )
}

// Mapped: `a` shifted right by `s` modulo 64.
pub fn UInt::shr64(a: UInt(64), s: Nat): UInt(64) {
  UInt::mk64(
    Nat::rem_nz(
      Nat::div_nz(
        UInt::val64(a),
        Nat::pow2(Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl))),
        Nat::pow2_ne_zero(Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl)))
      ),
      18446744073709551616,
      Nat::ne_zero(18446744073709551616, Refl)
    ),
    Nat::mod_lt(
      Nat::div_nz(
        UInt::val64(a),
        Nat::pow2(Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl))),
        Nat::pow2_ne_zero(Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl)))
      ),
      18446744073709551616,
      Refl
    )
  )
}

// Mapped: `a` rotated left by `s` modulo 64.
pub fn UInt::rotl64(a: UInt(64), s: Nat): UInt(64) {
  UInt::mk64(
    Nat::rem_nz(
      Nat::add(
        Nat::rem_nz(
          Nat::mul(UInt::val64(a), Nat::pow2(Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl)))),
          18446744073709551616,
          Nat::ne_zero(18446744073709551616, Refl)
        ),
        Nat::div_nz(
          UInt::val64(a),
          Nat::pow2(64 - Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl))),
          Nat::pow2_ne_zero(64 - Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl)))
        )
      ),
      18446744073709551616,
      Nat::ne_zero(18446744073709551616, Refl)
    ),
    Nat::mod_lt(
      Nat::add(
        Nat::rem_nz(
          Nat::mul(UInt::val64(a), Nat::pow2(Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl)))),
          18446744073709551616,
          Nat::ne_zero(18446744073709551616, Refl)
        ),
        Nat::div_nz(
          UInt::val64(a),
          Nat::pow2(64 - Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl))),
          Nat::pow2_ne_zero(64 - Nat::rem_nz(s, 64, Nat::ne_zero(64, Refl)))
        )
      ),
      18446744073709551616,
      Refl
    )
  )
}

