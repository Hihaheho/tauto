      Nat::ne_zero(65536, Refl)
    ),
    Nat::mod_lt(Nat::add(UInt::val16(a), 65536) - UInt::val16(b), 65536, Refl)
  )
}

// Mapped: `a * b` modulo `2^16`.
pub fn UInt::wrapping_mul16(a: UInt(16), b: UInt(16)): UInt(16) {
