    Nat::rem_nz(Nat::mul(UInt::val16(a), UInt::val16(b)), 65536, Nat::ne_zero(65536, Refl)),
    Nat::mod_lt(Nat::mul(UInt::val16(a), UInt::val16(b)), 65536, Refl)
  )
}

