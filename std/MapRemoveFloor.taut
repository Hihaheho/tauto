import "MapLaws.taut"
import "List.taut"
import "Base.taut"
import "Map.taut"
import std::prelude::Ord

module Ordmap {
  // `Ordmap::remove` and `Ordmap::floor`, proved (`docs/design/self-host.md`), the way
  // `MapLaws.taut` proves `Ordmap::insert`: the tree is read through its
  // entries in order, and each operation is one on that list.
  //
  // * `Ordmap::remove` drops the entries with the key: the entries stay
  //   sorted, the key is gone, and the other keys keep their values.
  // * `Ordmap::floor` is the last entry whose key is not after the key.
  //
  // No program imports this file; `tauto check` checks it.

  pub theorem none_ne_some<A: Type>(x: A, e: None = Some(x)): False {
    match e: False {
    }
  }

  pub theorem some_ne_none<A: Type>(x: A, e: Some(x) = None): False {
    match e: False {
    }
  }

  pub fn option_or<A>(o: Option(A), d: A): A {
    match o: A {
      None => d
      Some(x) => x
    }
  }

  pub theorem some_inj<A: Type>(a: A, b: A, e: Some(a) = Some(b)): a = b {
    Eq::congr(⟦option_or(□, a)⟧, e)
  }

  pub theorem option_cases<A: Type>(
    P: (Option(A)) -> Prop,
    o: Option(A),
    a: (o = None) -> P(None),
    b: ∀ x: A. (o = Some(x)) -> P(Some(x))
  ): P(o) {
    match o: P(o) {
      None => a(Refl)
      Some(x) => b(x, Refl)
    }
  }

  // `es` without the entries whose key is `k`.
  pub fn list_remove<K, V>(es: List(K × V), k: K, cmp: (K, K) -> Ordering): List(K × V) {
    match es: List(K × V) {
      Nil => Nil
      Cons(e, rest) => match e: List(K × V) {
        #(ek, ev) => match cmp(k, ek): List(K × V) {
          Less => Cons(#(ek, ev), list_remove(rest, k, cmp))
          Equal => list_remove(rest, k, cmp)
          Greater => Cons(#(ek, ev), list_remove(rest, k, cmp))
        }
      }
    }
  }

  pub theorem list_remove_skip<K: Type, V: Type>(
    o: Ordering,
    ne: ¬(o = Equal),
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = o
  ): list_remove(Cons(#(ek, ev), rest), k, cmp) = Cons(#(ek, ev), list_remove(rest, k, cmp)) {
    Ordering::cases(
      (x: Ordering) => match x: List(K × V) {
        Less => Cons(#(ek, ev), list_remove(rest, k, cmp))
        Equal => list_remove(rest, k, cmp)
        Greater => Cons(#(ek, ev), list_remove(rest, k, cmp))
      } = Cons(#(ek, ev), list_remove(rest, k, cmp)),
      cmp(k, ek),
      (h: cmp(k, ek) = Less) => Refl,
      (h: cmp(k, ek) = Equal) => False::elim(ne(Eq::trans(Eq::sym(e), h))),
      (h: cmp(k, ek) = Greater) => Refl
    )
  }

  pub theorem list_remove_equal<K: Type, V: Type>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = Equal
  ): list_remove(Cons(#(ek, ev), rest), k, cmp) = list_remove(rest, k, cmp) {
    Ordering::cases(
      (x: Ordering) => match x: List(K × V) {
        Less => Cons(#(ek, ev), list_remove(rest, k, cmp))
        Equal => list_remove(rest, k, cmp)
        Greater => Cons(#(ek, ev), list_remove(rest, k, cmp))
      } = list_remove(rest, k, cmp),
      cmp(k, ek),
      (h: cmp(k, ek) = Less) => False::elim(less_ne_equal(Eq::trans(Eq::sym(h), e))),
      (h: cmp(k, ek) = Equal) => Refl,
      (h: cmp(k, ek) = Greater) => False::elim(greater_ne_equal(Eq::trans(Eq::sym(h), e)))
    )
  }

  pub theorem list_remove_append<K: Type, V: Type>(
    a: List(K × V),
    b: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering
  ): list_remove(
    List::append(a, b),
    k,
    cmp
  ) = List::append(list_remove(a, k, cmp), list_remove(b, k, cmp)) {
    match a: list_remove(
      List::append(a, b),
      k,
      cmp
    ) = List::append(list_remove(a, k, cmp), list_remove(b, k, cmp)) {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => match c: List(K × V) {
            Less => Cons(#(xk, xv), list_remove(List::append(rest, b), k, cmp))
            Equal => list_remove(List::append(rest, b), k, cmp)
            Greater => Cons(#(xk, xv), list_remove(List::append(rest, b), k, cmp))
          } = List::append(match c: List(K × V) {
            Less => Cons(#(xk, xv), list_remove(rest, k, cmp))
            Equal => list_remove(rest, k, cmp)
            Greater => Cons(#(xk, xv), list_remove(rest, k, cmp))
          }, list_remove(b, k, cmp)),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => Eq::congr(
            ⟦Cons(#(xk, xv), □)⟧,
            list_remove_append(rest, b, k, cmp)
          ),
          (q: cmp(k, xk) = Equal) => list_remove_append(rest, b, k, cmp),
          (q: cmp(k, xk) = Greater) => Eq::congr(
            ⟦Cons(#(xk, xv), □)⟧,
            list_remove_append(rest, b, k, cmp)
          )
        )
      }
    }
  }

  pub theorem list_remove_keys_none<K: Type, V: Type>(
    k: K,
    o: Ordering,
    ne: ¬(o = Equal),
    es: List(K × V),
    cmp: (K, K) -> Ordering,
    h: keys(es, k, o, cmp)
  ): list_remove(es, k, cmp) = es {
    match es: list_remove(es, k, cmp) = es {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Eq::trans(
          list_remove_skip(o, ne, xk, xv, rest, k, cmp, And::left(h)),
          Eq::congr(⟦Cons(#(xk, xv), □)⟧, list_remove_keys_none(k, o, ne, rest, cmp, And::right(h)))
        )
      }
    }
  }

  pub theorem keys_remove<K: Type, V: Type>(
    es: List(K × V),
    a: K,
    o: Ordering,
    k: K,
    cmp: (K, K) -> Ordering,
    h: keys(es, a, o, cmp)
  ): keys(list_remove(es, k, cmp), a, o, cmp) {
    match es: keys(list_remove(es, k, cmp), a, o, cmp) {
      Nil => Trivial
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => keys(match c: List(K × V) {
            Less => Cons(#(xk, xv), list_remove(rest, k, cmp))
            Equal => list_remove(rest, k, cmp)
            Greater => Cons(#(xk, xv), list_remove(rest, k, cmp))
          }, a, o, cmp),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => AndIntro(
            And::left(h),
            keys_remove(rest, a, o, k, cmp, And::right(h))
          ),
          (q: cmp(k, xk) = Equal) => keys_remove(rest, a, o, k, cmp, And::right(h)),
          (q: cmp(k, xk) = Greater) => AndIntro(
            And::left(h),
            keys_remove(rest, a, o, k, cmp, And::right(h))
          )
        )
      }
    }
  }

  pub theorem list_remove_sorted<K: Type, V: Type>(
    es: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    h: sorted(es, cmp)
  ): sorted(list_remove(es, k, cmp), cmp) {
    match es: sorted(list_remove(es, k, cmp), cmp) {
      Nil => Trivial
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => sorted(match c: List(K × V) {
            Less => Cons(#(xk, xv), list_remove(rest, k, cmp))
            Equal => list_remove(rest, k, cmp)
            Greater => Cons(#(xk, xv), list_remove(rest, k, cmp))
          }, cmp),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => AndIntro(
            keys_remove(rest, xk, Less, k, cmp, And::left(h)),
            list_remove_sorted(rest, k, cmp, And::right(h))
          ),
          (q: cmp(k, xk) = Equal) => list_remove_sorted(rest, k, cmp, And::right(h)),
          (q: cmp(k, xk) = Greater) => AndIntro(
            keys_remove(rest, xk, Less, k, cmp, And::left(h)),
            list_remove_sorted(rest, k, cmp, And::right(h))
          )
        )
      }
    }
  }

  pub theorem list_get_remove_same<K: Type, V: Type>(
    es: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering
  ): list_get(list_remove(es, k, cmp), k, cmp) = None {
    match es: list_get(list_remove(es, k, cmp), k, cmp) = None {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => list_get(match c: List(K × V) {
            Less => Cons(#(xk, xv), list_remove(rest, k, cmp))
            Equal => list_remove(rest, k, cmp)
            Greater => Cons(#(xk, xv), list_remove(rest, k, cmp))
          }, k, cmp) = None,
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => Eq::trans(
            list_get_skip(Less, less_ne_equal, xk, xv, list_remove(rest, k, cmp), k, cmp, q),
            list_get_remove_same(rest, k, cmp)
          ),
          (q: cmp(k, xk) = Equal) => list_get_remove_same(rest, k, cmp),
          (q: cmp(k, xk) = Greater) => Eq::trans(
            list_get_skip(
              Greater,
              greater_ne_equal,
              xk,
              xv,
              list_remove(rest, k, cmp),
              k,
              cmp,
              q
            ),
            list_get_remove_same(rest, k, cmp)
          )
        )
      }
    }
  }

  pub theorem list_get_remove_other<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    es: List(K × V),
    k: K,
    j: K,
    o: Ordering,
    ne: ¬(o = Equal),
    ej: cmp(j, k) = o
  ): list_get(list_remove(es, k, cmp), j, cmp) = list_get(es, j, cmp) {
    match es: list_get(list_remove(es, k, cmp), j, cmp) = list_get(es, j, cmp) {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => list_get(match c: List(K × V) {
            Less => Cons(#(xk, xv), list_remove(rest, k, cmp))
            Equal => list_remove(rest, k, cmp)
            Greater => Cons(#(xk, xv), list_remove(rest, k, cmp))
          }, j, cmp) = list_get(Cons(#(xk, xv), rest), j, cmp),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => list_get_cons_congr(
            xk,
            xv,
            list_remove(rest, k, cmp),
            rest,
            j,
            cmp,
            list_get_remove_other(cmp, w, rest, k, j, o, ne, ej)
          ),
          (q: cmp(k, xk) = Equal) => Eq::trans(
            list_get_remove_other(cmp, w, rest, k, j, o, ne, ej),
            Eq::sym(
              list_get_skip(
                o,
                ne,
                xk,
                xv,
                rest,
                j,
                cmp,
                Eq::subst((z: K) => cmp(j, z) = o, law_eq(cmp, w, k, xk, q), ej)
              )
            )
          ),
          (q: cmp(k, xk) = Greater) => list_get_cons_congr(
            xk,
            xv,
            list_remove(rest, k, cmp),
            rest,
            j,
            cmp,
            list_get_remove_other(cmp, w, rest, k, j, o, ne, ej)
          )
        )
      }
    }
  }

  pub theorem tree_min_node<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    h: Nat,
    e: tree_min(OrdmapNode(l, k, v, r, h)) = None
  ): False {
    match l: False {
      OrdmapLeaf => some_ne_none(#(k, v), e)
      OrdmapNode(ll, lk, lv, lr, lh) => tree_min_node(ll, lk, lv, lr, lh, e)
    }
  }

  pub theorem tree_min_none<K: Type, V: Type>(
    t: OrdmapTree(K, V),
    e: tree_min(t) = None
  ): tree_entries(t, Nil) = Nil {
    match t: tree_entries(t, Nil) = Nil {
      OrdmapLeaf => Refl
      OrdmapNode(l, k, v, r, h) => False::elim(tree_min_node(l, k, v, r, h, e))
    }
  }

  pub theorem tree_min_some_node<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    k: K,
    v: V,
    r: OrdmapTree(K, V),
    h: Nat,
    mk: K,
    mv: V,
    e: tree_min(OrdmapNode(l, k, v, r, h)) = Some(#(mk, mv))
  ): tree_entries(
    OrdmapNode(l, k, v, r, h),
    Nil
  ) = Cons(#(mk, mv), tree_entries(tree_remove_min(OrdmapNode(l, k, v, r, h)), Nil)) {
    match l: tree_entries(
      OrdmapNode(l, k, v, r, h),
      Nil
    ) = Cons(#(mk, mv), tree_entries(tree_remove_min(OrdmapNode(l, k, v, r, h)), Nil)) {
      OrdmapLeaf => Eq::congr(⟦Cons(□, tree_entries(r, Nil))⟧, some_inj(#(k, v), #(mk, mv), e))
      OrdmapNode(ll, lk, lv, lr, lh) => Eq::trans(
        node_entries(OrdmapNode(ll, lk, lv, lr, lh), k, v, r, h),
        Eq::trans(
          Eq::congr(
            ⟦List::append(□, Cons(#(k, v), tree_entries(r, Nil)))⟧,
            tree_min_some_node(ll, lk, lv, lr, lh, mk, mv, e)
          ),
          Eq::congr(
            ⟦Cons(#(mk, mv), □)⟧,
            Eq::sym(
              Eq::trans(
                balance_entries(tree_remove_min(OrdmapNode(ll, lk, lv, lr, lh)), k, v, r, Nil),
                entries_append(
                  tree_remove_min(OrdmapNode(ll, lk, lv, lr, lh)),
                  Cons(#(k, v), tree_entries(r, Nil))
                )
              )
            )
          )
        )
      )
    }
  }

  pub theorem tree_min_some<K: Type, V: Type>(
    t: OrdmapTree(K, V),
    mk: K,
    mv: V,
    e: tree_min(t) = Some(#(mk, mv))
  ): tree_entries(t, Nil) = Cons(#(mk, mv), tree_entries(tree_remove_min(t), Nil)) {
    match t: tree_entries(t, Nil) = Cons(#(mk, mv), tree_entries(tree_remove_min(t), Nil)) {
      OrdmapLeaf => False::elim(none_ne_some(#(mk, mv), e))
      OrdmapNode(l, k, v, r, h) => tree_min_some_node(l, k, v, r, h, mk, mv, e)
    }
  }

  pub theorem pair_cases<A: Type, B: Type>(
    P: (A × B) -> Prop,
    x: A × B,
    f: ∀ a: A,
    b: B. (x = #(a, b)) -> P(#(a, b))
  ): P(x) {
    match x: P(x) {
      #(a, b) => f(a, b, Refl)
    }
  }

  pub theorem join_some<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    r: OrdmapTree(K, V),
    mk: K,
    mv: V,
    e: tree_min(r) = Some(#(mk, mv))
  ): tree_entries(
    balance(l, mk, mv, tree_remove_min(r)),
    Nil
  ) = List::append(tree_entries(l, Nil), tree_entries(r, Nil)) {
    Eq::trans(
      balance_entries(l, mk, mv, tree_remove_min(r), Nil),
      Eq::trans(
        entries_append(l, Cons(#(mk, mv), tree_entries(tree_remove_min(r), Nil))),
        Eq::congr(⟦List::append(tree_entries(l, Nil), □)⟧, Eq::sym(tree_min_some(r, mk, mv, e)))
      )
    )
  }

  // `Ordmap::join` once the least entry of `r` is known.
  pub fn join_pick<K, V>(
    l: OrdmapTree(K, V),
    r: OrdmapTree(K, V),
    o: Option(K × V)
  ): OrdmapTree(K, V) {
    match o: OrdmapTree(K, V) {
      None => l
      Some(least) => match least: OrdmapTree(K, V) {
        #(lk, lv) => balance(l, lk, lv, tree_remove_min(r))
      }
    }
  }

  pub theorem join_entries<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    r: OrdmapTree(K, V)
  ): tree_entries(join(l, r), Nil) = List::append(tree_entries(l, Nil), tree_entries(r, Nil)) {
    option_cases(
      (o: Option(K × V)) => tree_entries(
        join_pick(l, r, o),
        Nil
      ) = List::append(tree_entries(l, Nil), tree_entries(r, Nil)),
      tree_min(r),
      (e: tree_min(r) = None) => Eq::sym(
        Eq::trans(
          Eq::congr(⟦List::append(tree_entries(l, Nil), □)⟧, tree_min_none(r, e)),
          List::append_nil(tree_entries(l, Nil))
        )
      ),
      (least: K × V) => (e: tree_min(r) = Some(least)) => pair_cases(
        (y: K × V) => tree_entries(
          join_pick(l, r, Some(y)),
          Nil
        ) = List::append(tree_entries(l, Nil), tree_entries(r, Nil)),
        least,
        (mk: K) => (mv: V) => (ex: least = (#(mk, mv))) => join_some(
          l,
          r,
          mk,
          mv,
          Eq::trans(e, Eq::congr(⟦Some(□)⟧, ex))
        )
      )
    )
  }

  pub theorem tree_remove_entries<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    t: OrdmapTree(K, V),
    k: K,
    s: sorted(tree_entries(t, Nil), cmp)
  ): tree_entries(tree_remove(t, k, cmp), Nil) = list_remove(tree_entries(t, Nil), k, cmp) {
    match t: tree_entries(tree_remove(t, k, cmp), Nil) = list_remove(tree_entries(t, Nil), k, cmp) {
      OrdmapLeaf => Refl
      OrdmapNode(l, nk, nv, r, h) => Eq::trans(
        Ordering::cases(
          (c: Ordering) => tree_entries(match c: OrdmapTree(K, V) {
            Less => balance(tree_remove(l, k, cmp), nk, nv, r)
            Equal => join(l, r)
            Greater => balance(l, nk, nv, tree_remove(r, k, cmp))
          }, Nil) = list_remove(List::append(tree_entries(l, Nil), Cons(#(nk, nv), tree_entries(r, Nil))), k, cmp),
          cmp(k, nk),
          (q: cmp(k, nk) = Less) => Eq::trans(
            balance_entries(tree_remove(l, k, cmp), nk, nv, r, Nil),
            Eq::trans(
              entries_append(tree_remove(l, k, cmp), Cons(#(nk, nv), tree_entries(r, Nil))),
              Eq::trans(
                Eq::congr(
                  ⟦List::append(□, Cons(#(nk, nv), tree_entries(r, Nil)))⟧,
                  tree_remove_entries(
                    cmp,
                    w,
                    l,
                    k,
                    And::left(And::right(node_split(cmp, w, l, nk, nv, r, h, s)))
                  )
                ),
                Eq::sym(
                  Eq::trans(
                    list_remove_append(
                      tree_entries(l, Nil),
                      Cons(#(nk, nv), tree_entries(r, Nil)),
                      k,
                      cmp
                    ),
                    Eq::congr(
                      ⟦List::append(list_remove(tree_entries(l, Nil), k, cmp), □)⟧,
                      Eq::trans(
                        list_remove_skip(Less, less_ne_equal, nk, nv, tree_entries(r, Nil), k, cmp, q),
                        Eq::congr(
                          ⟦Cons(#(nk, nv), □)⟧,
                          list_remove_keys_none(
                            k,
                            Less,
                            less_ne_equal,
                            tree_entries(r, Nil),
                            cmp,
                            keys_less_trans(
                              cmp,
                              w,
                              tree_entries(r, Nil),
                              nk,
                              k,
                              q,
                              And::left(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          ),
          (q: cmp(k, nk) = Equal) => Eq::trans(
            join_entries(l, r),
            Eq::sym(
              Eq::trans(
                list_remove_append(
                  tree_entries(l, Nil),
                  Cons(#(nk, nv), tree_entries(r, Nil)),
                  k,
                  cmp
                ),
                Eq::trans(
                  Eq::congr(
                    ⟦List::append(
                      □,
                      list_remove(Cons(#(nk, nv), tree_entries(r, Nil)), k, cmp)
                    )⟧,
                    list_remove_keys_none(
                      k,
                      Greater,
                      greater_ne_equal,
                      tree_entries(l, Nil),
                      cmp,
                      keys_eq(
                        tree_entries(l, Nil),
                        nk,
                        k,
                        Eq::sym(law_eq(cmp, w, k, nk, q)),
                        Greater,
                        cmp,
                        And::left(node_split(cmp, w, l, nk, nv, r, h, s))
                      )
                    )
                  ),
                  Eq::congr(
                    ⟦List::append(tree_entries(l, Nil), □)⟧,
                    Eq::trans(
                      list_remove_equal(nk, nv, tree_entries(r, Nil), k, cmp, q),
                      list_remove_keys_none(
                        k,
                        Less,
                        less_ne_equal,
                        tree_entries(r, Nil),
                        cmp,
                        keys_eq(
                          tree_entries(r, Nil),
                          nk,
                          k,
                          Eq::sym(law_eq(cmp, w, k, nk, q)),
                          Less,
                          cmp,
                          And::left(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
                        )
                      )
                    )
                  )
                )
              )
            )
          ),
          (q: cmp(k, nk) = Greater) => Eq::trans(
            balance_entries(l, nk, nv, tree_remove(r, k, cmp), Nil),
            Eq::trans(
              entries_append(
                l,
                Cons(#(nk, nv), tree_entries(tree_remove(r, k, cmp), Nil))
              ),
              Eq::trans(
                Eq::congr(
                  ⟦List::append(tree_entries(l, Nil), Cons(#(nk, nv), □))⟧,
                  tree_remove_entries(
                    cmp,
                    w,
                    r,
                    k,
                    And::right(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
                  )
                ),
                Eq::sym(
                  Eq::trans(
                    list_remove_append(
                      tree_entries(l, Nil),
                      Cons(#(nk, nv), tree_entries(r, Nil)),
                      k,
                      cmp
                    ),
                    Eq::trans(
                      Eq::congr(
                        ⟦List::append(
                          □,
                          list_remove(Cons(#(nk, nv), tree_entries(r, Nil)), k, cmp)
                        )⟧,
                        list_remove_keys_none(
                          k,
                          Greater,
                          greater_ne_equal,
                          tree_entries(l, Nil),
                          cmp,
                          keys_greater_trans(
                            cmp,
                            w,
                            tree_entries(l, Nil),
                            nk,
                            k,
                            q,
                            And::left(node_split(cmp, w, l, nk, nv, r, h, s))
                          )
                        )
                      ),
                      Eq::congr(
                        ⟦List::append(tree_entries(l, Nil), □)⟧,
                        list_remove_skip(
                          Greater,
                          greater_ne_equal,
                          nk,
                          nv,
                          tree_entries(r, Nil),
                          k,
                          cmp,
                          q
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        ),
        Eq::sym(
          Eq::congr(
            ⟦list_remove(□, k, cmp)⟧,
            node_entries(l, nk, nv, r, h)
          )
        )
      )
    }
  }

  // `Ordmap::list_get` past an entry with the value `xv`, by `c`, the comparison of
  // `k` with the entry's key.
  pub fn list_get_step<K, V>(
    xv: V,
    rest: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    c: Ordering
  ): Option(V) {
    match c: Option(V) {
      Less => list_get(rest, k, cmp)
      Equal => Some(xv)
      Greater => list_get(rest, k, cmp)
    }
  }

  pub theorem list_remove_get_none<K: Type, V: Type>(
    es: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    e: list_get(es, k, cmp) = None
  ): list_remove(es, k, cmp) = es {
    match es: list_remove(es, k, cmp) = es {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => match c: List(K × V) {
            Less => Cons(#(xk, xv), list_remove(rest, k, cmp))
            Equal => list_remove(rest, k, cmp)
            Greater => Cons(#(xk, xv), list_remove(rest, k, cmp))
          } = Cons(#(xk, xv), rest),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => Eq::congr(
            ⟦Cons(#(xk, xv), □)⟧,
            list_remove_get_none(
              rest,
              k,
              cmp,
              Eq::subst(
                (c: Ordering) => list_get_step(xv, rest, k, cmp, c) = None,
                q,
                e
              )
            )
          ),
          (q: cmp(k, xk) = Equal) => False::elim(
            some_ne_none(
              xv,
              Eq::subst(
                (c: Ordering) => list_get_step(xv, rest, k, cmp, c) = None,
                q,
                e
              )
            )
          ),
          (q: cmp(k, xk) = Greater) => Eq::congr(
            ⟦Cons(#(xk, xv), □)⟧,
            list_remove_get_none(
              rest,
              k,
              cmp,
              Eq::subst(
                (c: Ordering) => list_get_step(xv, rest, k, cmp, c) = None,
                q,
                e
              )
            )
          )
        )
      }
    }
  }

  pub fn is_some<V>(o: Option(V)): Bool {
    match o: Bool {
      None => false
      Some(v) => true
    }
  }

  pub theorem is_some_false<V: Type>(o: Option(V), e: is_some(o) = false): o = None {
    match o: o = None {
      None => Refl
      Some(x) => False::elim(true_ne_false(e))
    }
  }

  pub theorem contains_false<K: Type, V: Type>(
    m: Ordmap(K, V),
    k: K,
    cmp: (K, K) -> Ordering,
    e: contains(m, k, cmp) = false
  ): get(m, k, cmp) = None {
    is_some_false(get(m, k, cmp), e)
  }

  pub theorem remove_entries<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    m: Ordmap(K, V),
    k: K,
    s: ordered(m, cmp)
  ): entries(remove(m, k, cmp)) = list_remove(entries(m), k, cmp) {
    match contains(m, k, cmp) eqn q: entries(remove(m, k, cmp)) = list_remove(entries(m), k, cmp) {
      true => ⊢ entries(
        Ordmap::Mk(tree_remove(tree(m), k, cmp), Nat::pred(size(m)))
      ) = list_remove(entries(m), k, cmp) from tree_remove_entries(cmp, w, tree(m), k, s)
      false => ⊢ entries(
        m
      ) = list_remove(
        entries(m),
        k,
        cmp
      ) from Eq::sym(
        list_remove_get_none(
          entries(m),
          k,
          cmp,
          Eq::trans(Eq::sym(tree_get_entries(cmp, w, tree(m), k, s)), contains_false(m, k, cmp, q))
        )
      )
    }
  }

  pub theorem remove_ordered<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    m: Ordmap(K, V),
    k: K,
    s: ordered(m, cmp)
  ): ordered(remove(m, k, cmp), cmp) {
    Eq::subst(
      (z: List(K × V)) => sorted(z, cmp),
      Eq::sym(remove_entries(cmp, w, m, k, s)),
      list_remove_sorted(entries(m), k, cmp, s)
    )
  }

  pub theorem get_remove_same<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    m: Ordmap(K, V),
    k: K,
    s: ordered(m, cmp)
  ): get(remove(m, k, cmp), k, cmp) = None {
    Eq::trans(
      tree_get_entries(cmp, w, tree(remove(m, k, cmp)), k, remove_ordered(cmp, w, m, k, s)),
      Eq::trans(
        Eq::congr(⟦list_get(□, k, cmp)⟧, remove_entries(cmp, w, m, k, s)),
        list_get_remove_same(entries(m), k, cmp)
      )
    )
  }

  pub theorem get_remove_other<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    m: Ordmap(K, V),
    k: K,
    j: K,
    o: Ordering,
    ne: ¬(o = Equal),
    ej: cmp(j, k) = o,
    s: ordered(m, cmp)
  ): get(remove(m, k, cmp), j, cmp) = get(m, j, cmp) {
    Eq::trans(
      tree_get_entries(cmp, w, tree(remove(m, k, cmp)), j, remove_ordered(cmp, w, m, k, s)),
      Eq::trans(
        Eq::congr(⟦list_get(□, j, cmp)⟧, remove_entries(cmp, w, m, k, s)),
        Eq::trans(
          list_get_remove_other(cmp, w, entries(m), k, j, o, ne, ej),
          Eq::sym(tree_get_entries(cmp, w, tree(m), j, s))
        )
      )
    )
  }

  // The last entry of `es` whose key is not after `k`, or `best` if there is
  // none.
  pub fn list_floor<K, V>(
    es: List(K × V),
    k: K,
    best: Option(K × V),
    cmp: (K, K) -> Ordering
  ): Option(K × V) {
    match es: Option(K × V) {
      Nil => best
      Cons(e, rest) => match e: Option(K × V) {
        #(ek, ev) => match cmp(k, ek): Option(K × V) {
          Less => list_floor(rest, k, best, cmp)
          Equal => list_floor(rest, k, Some(#(ek, ev)), cmp)
          Greater => list_floor(rest, k, Some(#(ek, ev)), cmp)
        }
      }
    }
  }

  pub fn list_floor_step<K, V>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    best: Option(K × V),
    cmp: (K, K) -> Ordering,
    c: Ordering
  ): Option(K × V) {
    match c: Option(K × V) {
      Less => list_floor(rest, k, best, cmp)
      Equal => list_floor(rest, k, Some(#(ek, ev)), cmp)
      Greater => list_floor(rest, k, Some(#(ek, ev)), cmp)
    }
  }

  pub theorem list_floor_less<K: Type, V: Type>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    best: Option(K × V),
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = Less
  ): list_floor(Cons(#(ek, ev), rest), k, best, cmp) = list_floor(rest, k, best, cmp) {
    Eq::congr(⟦list_floor_step(ek, ev, rest, k, best, cmp, □)⟧, e)
  }

  pub theorem list_floor_equal<K: Type, V: Type>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    best: Option(K × V),
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = Equal
  ): list_floor(Cons(#(ek, ev), rest), k, best, cmp) = list_floor(rest, k, Some(#(ek, ev)), cmp) {
    Eq::congr(⟦list_floor_step(ek, ev, rest, k, best, cmp, □)⟧, e)
  }

  pub theorem list_floor_greater<K: Type, V: Type>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    best: Option(K × V),
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = Greater
  ): list_floor(Cons(#(ek, ev), rest), k, best, cmp) = list_floor(rest, k, Some(#(ek, ev)), cmp) {
    Eq::congr(⟦list_floor_step(ek, ev, rest, k, best, cmp, □)⟧, e)
  }

  pub theorem list_floor_append<K: Type, V: Type>(
    a: List(K × V),
    b: List(K × V),
    k: K,
    best: Option(K × V),
    cmp: (K, K) -> Ordering
  ): list_floor(
    List::append(a, b),
    k,
    best,
    cmp
  ) = list_floor(b, k, list_floor(a, k, best, cmp), cmp) {
    match a: list_floor(
      List::append(a, b),
      k,
      best,
      cmp
    ) = list_floor(b, k, list_floor(a, k, best, cmp), cmp) {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => list_floor_step(
            xk,
            xv,
            List::append(rest, b),
            k,
            best,
            cmp,
            c
          ) = list_floor(b, k, list_floor_step(xk, xv, rest, k, best, cmp, c), cmp),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => list_floor_append(rest, b, k, best, cmp),
          (q: cmp(k, xk) = Equal) => list_floor_append(rest, b, k, Some(#(xk, xv)), cmp),
          (q: cmp(k, xk) = Greater) => list_floor_append(rest, b, k, Some(#(xk, xv)), cmp)
        )
      }
    }
  }

  pub theorem list_floor_keys_less<K: Type, V: Type>(
    es: List(K × V),
    k: K,
    best: Option(K × V),
    cmp: (K, K) -> Ordering,
    h: keys(es, k, Less, cmp)
  ): list_floor(es, k, best, cmp) = best {
    match es: list_floor(es, k, best, cmp) = best {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Eq::trans(
          list_floor_less(xk, xv, rest, k, best, cmp, And::left(h)),
          list_floor_keys_less(rest, k, best, cmp, And::right(h))
        )
      }
    }
  }

  pub theorem tree_floor_entries<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    t: OrdmapTree(K, V),
    k: K,
    best: Option(K × V),
    s: sorted(tree_entries(t, Nil), cmp)
  ): tree_floor(t, k, best, cmp) = list_floor(tree_entries(t, Nil), k, best, cmp) {
    match t: tree_floor(t, k, best, cmp) = list_floor(tree_entries(t, Nil), k, best, cmp) {
      OrdmapLeaf => Refl
      OrdmapNode(l, nk, nv, r, h) => Eq::trans(
        Ordering::cases(
          (c: Ordering) => match c: Option(K × V) {
            Less => tree_floor(l, k, best, cmp)
            Equal => Some(#(nk, nv))
            Greater => tree_floor(r, k, Some(#(nk, nv)), cmp)
          } = list_floor(Cons(#(nk, nv), tree_entries(r, Nil)), k, list_floor(tree_entries(l, Nil), k, best, cmp), cmp),
          cmp(k, nk),
          (q: cmp(k, nk) = Less) => Eq::trans(
            tree_floor_entries(cmp, w, l, k, best, And::left(And::right(node_split(cmp, w, l, nk, nv, r, h, s)))),
            Eq::sym(
              Eq::trans(
                list_floor_less(
                  nk,
                  nv,
                  tree_entries(r, Nil),
                  k,
                  list_floor(tree_entries(l, Nil), k, best, cmp),
                  cmp,
                  q
                ),
                list_floor_keys_less(
                  tree_entries(r, Nil),
                  k,
                  list_floor(tree_entries(l, Nil), k, best, cmp),
                  cmp,
                  keys_less_trans(
                    cmp,
                    w,
                    tree_entries(r, Nil),
                    nk,
                    k,
                    q,
                    And::left(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
                  )
                )
              )
            )
          ),
          (q: cmp(k, nk) = Equal) => Eq::sym(
            Eq::trans(
              list_floor_equal(
                nk,
                nv,
                tree_entries(r, Nil),
                k,
                list_floor(tree_entries(l, Nil), k, best, cmp),
                cmp,
                q
              ),
              list_floor_keys_less(
                tree_entries(r, Nil),
                k,
                Some(#(nk, nv)),
                cmp,
                keys_eq(
                  tree_entries(r, Nil),
                  nk,
                  k,
                  Eq::sym(law_eq(cmp, w, k, nk, q)),
                  Less,
                  cmp,
                  And::left(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
                )
              )
            )
          ),
          (q: cmp(k, nk) = Greater) => Eq::trans(
            tree_floor_entries(
              cmp,
              w,
              r,
              k,
              Some(#(nk, nv)),
              And::right(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
            ),
            Eq::sym(
              list_floor_greater(
                nk,
                nv,
                tree_entries(r, Nil),
                k,
                list_floor(tree_entries(l, Nil), k, best, cmp),
                cmp,
                q
              )
            )
          )
        ),
        Eq::sym(
          Eq::trans(
            Eq::congr(
              ⟦list_floor(□, k, best, cmp)⟧,
              node_entries(l, nk, nv, r, h)
            ),
            list_floor_append(
              tree_entries(l, Nil),
              Cons(#(nk, nv), tree_entries(r, Nil)),
              k,
              best,
              cmp
            )
          )
        )
      )
    }
  }

  pub theorem floor_entries<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    m: Ordmap(K, V),
    k: K,
    s: ordered(m, cmp)
  ): floor(m, k, cmp) = list_floor(entries(m), k, None, cmp) {
    tree_floor_entries(cmp, w, tree(m), k, None, s)
  }
}
