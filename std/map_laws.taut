import "base.taut" { List, Nat, Ordering }
import "map.taut" { Ordmap, OrdmapTree }
import std::builtin::ord {
  equal_ne_greater,
  equal_ne_less,
  greater_ne_equal,
  greater_ne_less,
  less_ne_equal,
  less_ne_greater
}
import std::prelude::std { List, Option, Ordering }

// What the ordered map does, proved (`docs/design/self-host.md`): a map's tree is
// read through its entries in order (`Ordmap::tree_entries`), and for a
// comparator that is a total order:
//
// * `Ordmap::get` is the first entry with the key, in a sorted list;
// * `Ordmap::insert` is the insertion into that sorted list;
// * so the entries stay sorted, `Ordmap::get` finds what was inserted, and
//   the other keys keep their values.
//
// No program imports this file; `tauto check` checks it.

// A comparator that is a total order. `equal` is equality.
pub(open) inductive OrdmapLaw(K: Type, cmp: (K, K) -> Ordering): Prop {
  Mk(
    same: ∀ a: K. cmp(a, a) = Equal,
    equal_is_eq: ∀ a: K, b: K. (cmp(a, b) = Equal) -> (a = b),
    flip_less: ∀ a: K, b: K. (cmp(a, b) = Less) -> (cmp(b, a) = Greater),
    flip_greater: ∀ a: K, b: K. (cmp(a, b) = Greater) -> (cmp(b, a) = Less),
    less_trans: ∀ a: K, b: K, c: K. (cmp(a, b) = Less) -> (cmp(b, c) = Less) -> (cmp(a, c) = Less)
  ): OrdmapLaw(K, cmp)
}

pub theorem Ordmap::law_same<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  a: K
): cmp(a, a) = Equal {
  match w {
    Mk(s, _, _, _, _) => s(a)
  }
}

pub theorem Ordmap::law_eq<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  a: K,
  b: K,
  e: cmp(a, b) = Equal
): a = b {
  match w {
    Mk(_, q, _, _, _) => q(a, b, e)
  }
}

pub theorem Ordmap::law_flip_less<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  a: K,
  b: K,
  e: cmp(a, b) = Less
): cmp(b, a) = Greater {
  match w {
    Mk(_, _, fl, _, _) => fl(a, b, e)
  }
}

pub theorem Ordmap::law_flip_greater<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  a: K,
  b: K,
  e: cmp(a, b) = Greater
): cmp(b, a) = Less {
  match w {
    Mk(_, _, _, fg, _) => fg(a, b, e)
  }
}

pub theorem Ordmap::law_less_trans<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  a: K,
  b: K,
  c: K,
  e1: cmp(a, b) = Less,
  e2: cmp(b, c) = Less
): cmp(a, c) = Less {
  match w {
    Mk(_, _, _, _, t) => t(a, b, c, e1, e2)
  }
}

pub theorem Ordmap::law_greater_trans<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  a: K,
  b: K,
  c: K,
  e1: cmp(a, b) = Greater,
  e2: cmp(b, c) = Greater
): cmp(a, c) = Greater {
  Ordmap::law_flip_less(
    cmp,
    w,
    c,
    a,
    Ordmap::law_less_trans(
      cmp,
      w,
      c,
      b,
      a,
      Ordmap::law_flip_greater(cmp, w, b, c, e2),
      Ordmap::law_flip_greater(cmp, w, a, b, e1)
    )
  )
}

// The entries in a list: the value of the first entry with the key.
pub fn Ordmap::list_get<K: Shared, V: Shared>(es: List(K × V), k: K, cmp: (K, K) -> Ordering): Option(V) {
  match es {
    Nil => None
    Cons(e, rest) => ⊢ Option(V) from match e {
      #(ek, ev) => ⊢ Option(V) from match cmp(k, ek) {
        Less => Ordmap::list_get(rest, k, cmp)
        Equal => Some(ev)
        Greater => Ordmap::list_get(rest, k, cmp)
      }
    }
  }
}

// `es` with `v` at `k`: before the first key after `k`, or in place of `k`.
pub fn Ordmap::list_insert<K: Shared, V: Shared>(
  es: List(K × V),
  k: K,
  v: V,
  cmp: (K, K) -> Ordering
): List(K × V) {
  match es {
    Nil => Cons(#(k, v), Nil)
    Cons(e, rest) => ⊢ List(K × V) from match e {
      #(ek, ev) => ⊢ List(K × V) from match cmp(k, ek) {
        Less => Cons(#(k, v), Cons(#(ek, ev), rest))
        Equal => Cons(#(k, v), rest)
        Greater => Cons(#(ek, ev), Ordmap::list_insert(rest, k, v, cmp))
      }
    }
  }
}

// `cmp(k, ek)` is `o` for every key `ek` of `es`.
pub fn Ordmap::keys<K: Shared, V: Shared>(
  es: List(K × V),
  k: K,
  o: Ordering,
  cmp: (K, K) -> Ordering
): Prop {
  match es {
    Nil => True
    Cons(e, rest) => ⊢ Prop from match e {
      #(ek, ev) => cmp(k, ek) = o ∧ Ordmap::keys(rest, k, o, cmp)
    }
  }
}

// Every key is before the keys after it.
pub fn Ordmap::sorted<K: Shared, V: Shared>(es: List(K × V), cmp: (K, K) -> Ordering): Prop {
  match es {
    Nil => True
    Cons(e, rest) => ⊢ Prop from match e {
      #(ek, ev) => Ordmap::keys(rest, ek, Less, cmp) ∧ Ordmap::sorted(rest, cmp)
    }
  }
}

// The steps of `list_get` and `list_insert`, one comparison
// each.

pub theorem Ordmap::list_get_equal<K: Type, V: Type>(
  ek: K,
  ev: V,
  rest: List(K × V),
  k: K,
  cmp: (K, K) -> Ordering,
  e: cmp(k, ek) = Equal
): Ordmap::list_get(Cons(#(ek, ev), rest), k, cmp) = Some(ev) {
  Ordering::cases(
    (x: Ordering) => (⊢ Option(V) from match x {
      Less => Ordmap::list_get(rest, k, cmp)
      Equal => Some(ev)
      Greater => Ordmap::list_get(rest, k, cmp)
    }) = Some(ev),
    cmp(k, ek),
    (h: cmp(k, ek) = Less) => False::elim(less_ne_equal(Eq::trans(Eq::sym(h), e))),
    (h: cmp(k, ek) = Equal) => Refl,
    (h: cmp(k, ek) = Greater) => False::elim(greater_ne_equal(Eq::trans(Eq::sym(h), e)))
  )
}

pub theorem Ordmap::list_get_skip<K: Type, V: Type>(
  o: Ordering,
  ne: ¬(o = Equal),
  ek: K,
  ev: V,
  rest: List(K × V),
  k: K,
  cmp: (K, K) -> Ordering,
  e: cmp(k, ek) = o
): Ordmap::list_get(Cons(#(ek, ev), rest), k, cmp) = Ordmap::list_get(rest, k, cmp) {
  Ordering::cases(
    (x: Ordering) => (⊢ Option(V) from match x {
      Less => Ordmap::list_get(rest, k, cmp)
      Equal => Some(ev)
      Greater => Ordmap::list_get(rest, k, cmp)
    }) = Ordmap::list_get(rest, k, cmp),
    cmp(k, ek),
    (h: cmp(k, ek) = Less) => Refl,
    (h: cmp(k, ek) = Equal) => False::elim(ne(Eq::trans(Eq::sym(e), h))),
    (h: cmp(k, ek) = Greater) => Refl
  )
}

pub theorem Ordmap::list_insert_less<K: Type, V: Type>(
  ek: K,
  ev: V,
  rest: List(K × V),
  k: K,
  v: V,
  cmp: (K, K) -> Ordering,
  e: cmp(k, ek) = Less
): Ordmap::list_insert(Cons(#(ek, ev), rest), k, v, cmp) = Cons(#(k, v), Cons(#(ek, ev), rest)) {
  Ordering::cases(
    (x: Ordering) => (⊢ List(K × V) from match x {
      Less => Cons(#(k, v), Cons(#(ek, ev), rest))
      Equal => Cons(#(k, v), rest)
      Greater => Cons(#(ek, ev), Ordmap::list_insert(rest, k, v, cmp))
    }) = Cons(#(k, v), Cons(#(ek, ev), rest)),
    cmp(k, ek),
    (h: cmp(k, ek) = Less) => Refl,
    (h: cmp(k, ek) = Equal) => False::elim(equal_ne_less(Eq::trans(Eq::sym(h), e))),
    (h: cmp(k, ek) = Greater) => False::elim(greater_ne_less(Eq::trans(Eq::sym(h), e)))
  )
}

pub theorem Ordmap::list_insert_equal<K: Type, V: Type>(
  ek: K,
  ev: V,
  rest: List(K × V),
  k: K,
  v: V,
  cmp: (K, K) -> Ordering,
  e: cmp(k, ek) = Equal
): Ordmap::list_insert(Cons(#(ek, ev), rest), k, v, cmp) = Cons(#(k, v), rest) {
  Ordering::cases(
    (x: Ordering) => (⊢ List(K × V) from match x {
      Less => Cons(#(k, v), Cons(#(ek, ev), rest))
      Equal => Cons(#(k, v), rest)
      Greater => Cons(#(ek, ev), Ordmap::list_insert(rest, k, v, cmp))
    }) = Cons(#(k, v), rest),
    cmp(k, ek),
    (h: cmp(k, ek) = Less) => False::elim(less_ne_equal(Eq::trans(Eq::sym(h), e))),
    (h: cmp(k, ek) = Equal) => Refl,
    (h: cmp(k, ek) = Greater) => False::elim(greater_ne_equal(Eq::trans(Eq::sym(h), e)))
  )
}

pub theorem Ordmap::list_insert_greater<K: Type, V: Type>(
  ek: K,
  ev: V,
  rest: List(K × V),
  k: K,
  v: V,
  cmp: (K, K) -> Ordering,
  e: cmp(k, ek) = Greater
): Ordmap::list_insert(Cons(#(ek, ev), rest), k, v, cmp) = Cons(#(ek, ev), Ordmap::list_insert(rest, k, v, cmp)) {
  Ordering::cases(
    (x: Ordering) => (⊢ List(K × V) from match x {
      Less => Cons(#(k, v), Cons(#(ek, ev), rest))
      Equal => Cons(#(k, v), rest)
      Greater => Cons(#(ek, ev), Ordmap::list_insert(rest, k, v, cmp))
    }) = Cons(#(ek, ev), Ordmap::list_insert(rest, k, v, cmp)),
    cmp(k, ek),
    (h: cmp(k, ek) = Less) => False::elim(less_ne_greater(Eq::trans(Eq::sym(h), e))),
    (h: cmp(k, ek) = Equal) => False::elim(equal_ne_greater(Eq::trans(Eq::sym(h), e))),
    (h: cmp(k, ek) = Greater) => Refl
  )
}

pub theorem Ordmap::entries_append<K: Type, V: Type>(
  t: OrdmapTree(K, V),
  d: List(K × V)
): Ordmap::tree_entries(t, d) = List::append(Ordmap::tree_entries(t, Nil), d) {
  match t {
    OrdmapLeaf => Refl
    OrdmapNode(l, k, v, r, h) => Eq::trans(
      Eq::trans(
        Ordmap::entries_append(l, Cons(#(k, v), Ordmap::tree_entries(r, d))),
        Eq::congr(⟦List::append(Ordmap::tree_entries(l, Nil), Cons(#(k, v), □))⟧, Ordmap::entries_append(r, d))
      ),
      Eq::sym(
        Eq::trans(
          Eq::congr(⟦List::append(□, d)⟧, Ordmap::entries_append(l, Cons(#(k, v), Ordmap::tree_entries(r, Nil)))),
          List::append_assoc(Ordmap::tree_entries(l, Nil), Cons(#(k, v), Ordmap::tree_entries(r, Nil)), d)
        )
      )
    )
  }
}

pub theorem Ordmap::keys_append_left<K: Type, V: Type>(
  a: List(K × V),
  b: List(K × V),
  x: K,
  o: Ordering,
  cmp: (K, K) -> Ordering,
  h: Ordmap::keys(List::append(a, b), x, o, cmp)
): Ordmap::keys(a, x, o, cmp) {
  match a {
    Nil => Trivial
    Cons(e, rest) => match e {
      #(ek, ev) => AndIntro(And::left(h), Ordmap::keys_append_left(rest, b, x, o, cmp, And::right(h)))
    }
  }
}

pub theorem Ordmap::keys_append_right<K: Type, V: Type>(
  a: List(K × V),
  b: List(K × V),
  x: K,
  o: Ordering,
  cmp: (K, K) -> Ordering,
  h: Ordmap::keys(List::append(a, b), x, o, cmp)
): Ordmap::keys(b, x, o, cmp) {
  match a {
    Nil => h
    Cons(e, rest) => match e {
      #(ek, ev) => Ordmap::keys_append_right(rest, b, x, o, cmp, And::right(h))
    }
  }
}

pub theorem Ordmap::keys_less_trans<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  ys: List(K × V),
  a: K,
  b: K,
  e: cmp(b, a) = Less,
  h: Ordmap::keys(ys, a, Less, cmp)
): Ordmap::keys(ys, b, Less, cmp) {
  match ys {
    Nil => Trivial
    Cons(y, rest) => match y {
      #(yk, yv) => AndIntro(
        Ordmap::law_less_trans(cmp, w, b, a, yk, e, And::left(h)),
        Ordmap::keys_less_trans(cmp, w, rest, a, b, e, And::right(h))
      )
    }
  }
}

pub theorem Ordmap::keys_greater_trans<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  ys: List(K × V),
  a: K,
  b: K,
  e: cmp(b, a) = Greater,
  h: Ordmap::keys(ys, a, Greater, cmp)
): Ordmap::keys(ys, b, Greater, cmp) {
  match ys {
    Nil => Trivial
    Cons(y, rest) => match y {
      #(yk, yv) => AndIntro(
        Ordmap::law_greater_trans(cmp, w, b, a, yk, e, And::left(h)),
        Ordmap::keys_greater_trans(cmp, w, rest, a, b, e, And::right(h))
      )
    }
  }
}

pub theorem Ordmap::keys_eq<K: Type, V: Type>(
  ys: List(K × V),
  a: K,
  b: K,
  e: a = b,
  o: Ordering,
  cmp: (K, K) -> Ordering,
  h: Ordmap::keys(ys, a, o, cmp)
): Ordmap::keys(ys, b, o, cmp) {
  Eq::subst((z: K) => Ordmap::keys(ys, z, o, cmp), e, h)
}

// A sorted list with `nk` in it: the keys before are before `nk`, the keys
// after are after it, and both sides are sorted.
pub theorem Ordmap::sorted_split<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  xs: List(K × V),
  nk: K,
  nv: V,
  ys: List(K × V),
  h: Ordmap::sorted(List::append(xs, Cons(#(nk, nv), ys)), cmp)
): Ordmap::keys(xs, nk, Greater, cmp) ∧ Ordmap::sorted(xs, cmp) ∧ Ordmap::keys(ys, nk, Less, cmp) ∧ Ordmap::sorted(ys, cmp) {
  ⊢ Ordmap::keys(
    xs,
    nk,
    Greater,
    cmp
  ) ∧ Ordmap::sorted(xs, cmp) ∧ Ordmap::keys(ys, nk, Less, cmp) ∧ Ordmap::sorted(ys, cmp) from match xs {
    Nil => AndIntro(Trivial, AndIntro(Trivial, h))
    Cons(x, rest) => match x {
      #(xk, xv) => AndIntro(
        AndIntro(
          Ordmap::law_flip_less(
            cmp,
            w,
            xk,
            nk,
            And::left(Ordmap::keys_append_right(rest, Cons(#(nk, nv), ys), xk, Less, cmp, And::left(h)))
          ),
          And::left(Ordmap::sorted_split(cmp, w, rest, nk, nv, ys, And::right(h)))
        ),
        AndIntro(
          AndIntro(
            Ordmap::keys_append_left(rest, Cons(#(nk, nv), ys), xk, Less, cmp, And::left(h)),
            And::left(And::right(Ordmap::sorted_split(cmp, w, rest, nk, nv, ys, And::right(h))))
          ),
          And::right(And::right(Ordmap::sorted_split(cmp, w, rest, nk, nv, ys, And::right(h))))
        )
      )
    }
  }
}

pub theorem Ordmap::list_get_keys_none<K: Type, V: Type>(
  k: K,
  o: Ordering,
  ne: ¬(o = Equal),
  ys: List(K × V),
  cmp: (K, K) -> Ordering,
  h: Ordmap::keys(ys, k, o, cmp)
): Ordmap::list_get(ys, k, cmp) = None {
  match ys {
    Nil => Refl
    Cons(y, rest) => match y {
      #(yk, yv) => Eq::trans(
        Ordmap::list_get_skip(o, ne, yk, yv, rest, k, cmp, And::left(h)),
        Ordmap::list_get_keys_none(k, o, ne, rest, cmp, And::right(h))
      )
    }
  }
}

pub theorem Ordmap::list_get_append_none<K: Type, V: Type>(
  xs: List(K × V),
  ys: List(K × V),
  k: K,
  cmp: (K, K) -> Ordering,
  n: Ordmap::list_get(ys, k, cmp) = None
): Ordmap::list_get(List::append(xs, ys), k, cmp) = Ordmap::list_get(xs, k, cmp) {
  match xs {
    Nil => n
    Cons(x, rest) => match x {
      #(xk, xv) => Ordering::cases(
        (c: Ordering) => (⊢ Option(V) from match c {
          Less => Ordmap::list_get(List::append(rest, ys), k, cmp)
          Equal => Some(xv)
          Greater => Ordmap::list_get(List::append(rest, ys), k, cmp)
        }) = (⊢ Option(V) from match c {
          Less => Ordmap::list_get(rest, k, cmp)
          Equal => Some(xv)
          Greater => Ordmap::list_get(rest, k, cmp)
        }),
        cmp(k, xk),
        (e: cmp(k, xk) = Less) => Ordmap::list_get_append_none(rest, ys, k, cmp, n),
        (e: cmp(k, xk) = Equal) => Refl,
        (e: cmp(k, xk) = Greater) => Ordmap::list_get_append_none(rest, ys, k, cmp, n)
      )
    }
  }
}

pub theorem Ordmap::list_get_append_skip<K: Type, V: Type>(
  o: Ordering,
  ne: ¬(o = Equal),
  xs: List(K × V),
  ys: List(K × V),
  k: K,
  cmp: (K, K) -> Ordering,
  h: Ordmap::keys(xs, k, o, cmp)
): Ordmap::list_get(List::append(xs, ys), k, cmp) = Ordmap::list_get(ys, k, cmp) {
  match xs {
    Nil => Refl
    Cons(x, rest) => match x {
      #(xk, xv) => Eq::trans(
        Ordmap::list_get_skip(o, ne, xk, xv, List::append(rest, ys), k, cmp, And::left(h)),
        Ordmap::list_get_append_skip(o, ne, rest, ys, k, cmp, And::right(h))
      )
    }
  }
}

pub theorem Ordmap::list_get_cons_congr<K: Type, V: Type>(
  xk: K,
  xv: V,
  a: List(K × V),
  b: List(K × V),
  j: K,
  cmp: (K, K) -> Ordering,
  e: Ordmap::list_get(a, j, cmp) = Ordmap::list_get(b, j, cmp)
): Ordmap::list_get(Cons(#(xk, xv), a), j, cmp) = Ordmap::list_get(Cons(#(xk, xv), b), j, cmp) {
  Ordering::cases(
    (c: Ordering) => (⊢ Option(V) from match c {
      Less => Ordmap::list_get(a, j, cmp)
      Equal => Some(xv)
      Greater => Ordmap::list_get(a, j, cmp)
    }) = (⊢ Option(V) from match c {
      Less => Ordmap::list_get(b, j, cmp)
      Equal => Some(xv)
      Greater => Ordmap::list_get(b, j, cmp)
    }),
    cmp(j, xk),
    (q: cmp(j, xk) = Less) => e,
    (q: cmp(j, xk) = Equal) => Refl,
    (q: cmp(j, xk) = Greater) => e
  )
}

pub theorem Ordmap::list_insert_append_less<K: Type, V: Type>(
  xs: List(K × V),
  nk: K,
  nv: V,
  ys: List(K × V),
  k: K,
  v: V,
  cmp: (K, K) -> Ordering,
  e: cmp(k, nk) = Less
): Ordmap::list_insert(
  List::append(xs, Cons(#(nk, nv), ys)),
  k,
  v,
  cmp
) = List::append(Ordmap::list_insert(xs, k, v, cmp), Cons(#(nk, nv), ys)) {
  ⊢ Ordmap::list_insert(
    List::append(xs, Cons(#(nk, nv), ys)),
    k,
    v,
    cmp
  ) = List::append(Ordmap::list_insert(xs, k, v, cmp), Cons(#(nk, nv), ys)) from match xs {
    Nil => Ordmap::list_insert_less(nk, nv, ys, k, v, cmp, e)
    Cons(x, rest) => match x {
      #(xk, xv) => Ordering::cases(
        (c: Ordering) => (⊢ List(K × V) from match c {
          Less => Cons(#(k, v), Cons(#(xk, xv), List::append(rest, Cons(#(nk, nv), ys))))
          Equal => Cons(#(k, v), List::append(rest, Cons(#(nk, nv), ys)))
          Greater => Cons(
            #(xk, xv),
            Ordmap::list_insert(List::append(rest, Cons(#(nk, nv), ys)), k, v, cmp)
          )
        }) = List::append(⊢ List(K × V) from match c {
          Less => Cons(#(k, v), Cons(#(xk, xv), rest))
          Equal => Cons(#(k, v), rest)
          Greater => Cons(#(xk, xv), Ordmap::list_insert(rest, k, v, cmp))
        }, Cons(#(nk, nv), ys)),
        cmp(k, xk),
        (q: cmp(k, xk) = Less) => Refl,
        (q: cmp(k, xk) = Equal) => Refl,
        (q: cmp(k, xk) = Greater) => Eq::congr(
          ⟦Cons(#(xk, xv), □)⟧,
          Ordmap::list_insert_append_less(rest, nk, nv, ys, k, v, cmp, e)
        )
      )
    }
  }
}

pub theorem Ordmap::list_insert_append_skip<K: Type, V: Type>(
  xs: List(K × V),
  ys: List(K × V),
  k: K,
  v: V,
  cmp: (K, K) -> Ordering,
  h: Ordmap::keys(xs, k, Greater, cmp)
): Ordmap::list_insert(List::append(xs, ys), k, v, cmp) = List::append(xs, Ordmap::list_insert(ys, k, v, cmp)) {
  ⊢ Ordmap::list_insert(
    List::append(xs, ys),
    k,
    v,
    cmp
  ) = List::append(xs, Ordmap::list_insert(ys, k, v, cmp)) from match xs {
    Nil => Refl
    Cons(x, rest) => match x {
      #(xk, xv) => Eq::trans(
        Ordmap::list_insert_greater(xk, xv, List::append(rest, ys), k, v, cmp, And::left(h)),
        Eq::congr(
          ⟦Cons(#(xk, xv), □)⟧,
          Ordmap::list_insert_append_skip(rest, ys, k, v, cmp, And::right(h))
        )
      )
    }
  }
}

pub theorem Ordmap::keys_insert<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  es: List(K × V),
  a: K,
  k: K,
  v: V,
  ea: cmp(a, k) = Less,
  h: Ordmap::keys(es, a, Less, cmp)
): Ordmap::keys(Ordmap::list_insert(es, k, v, cmp), a, Less, cmp) {
  match es {
    Nil => AndIntro(ea, Trivial)
    Cons(x, rest) => match x {
      #(xk, xv) => Ordering::cases(
        (c: Ordering) => Ordmap::keys(⊢ List(K × V) from match c {
          Less => Cons(#(k, v), Cons(#(xk, xv), rest))
          Equal => Cons(#(k, v), rest)
          Greater => Cons(#(xk, xv), Ordmap::list_insert(rest, k, v, cmp))
        }, a, Less, cmp),
        cmp(k, xk),
        (q: cmp(k, xk) = Less) => AndIntro(ea, h),
        (q: cmp(k, xk) = Equal) => AndIntro(ea, And::right(h)),
        (q: cmp(k, xk) = Greater) => AndIntro(
          And::left(h),
          Ordmap::keys_insert(cmp, w, rest, a, k, v, ea, And::right(h))
        )
      )
    }
  }
}

pub theorem Ordmap::list_insert_sorted<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  es: List(K × V),
  k: K,
  v: V,
  h: Ordmap::sorted(es, cmp)
): Ordmap::sorted(Ordmap::list_insert(es, k, v, cmp), cmp) {
  match es {
    Nil => AndIntro(Trivial, Trivial)
    Cons(x, rest) => match x {
      #(xk, xv) => Ordering::cases(
        (c: Ordering) => Ordmap::sorted(⊢ List(K × V) from match c {
          Less => Cons(#(k, v), Cons(#(xk, xv), rest))
          Equal => Cons(#(k, v), rest)
          Greater => Cons(#(xk, xv), Ordmap::list_insert(rest, k, v, cmp))
        }, cmp),
        cmp(k, xk),
        (q: cmp(k, xk) = Less) => AndIntro(
          AndIntro(q, Ordmap::keys_less_trans(cmp, w, rest, xk, k, q, And::left(h))),
          h
        ),
        (q: cmp(k, xk) = Equal) => AndIntro(
          Ordmap::keys_eq(rest, xk, k, Eq::sym(Ordmap::law_eq(cmp, w, k, xk, q)), Less, cmp, And::left(h)),
          And::right(h)
        ),
        (q: cmp(k, xk) = Greater) => AndIntro(
          Ordmap::keys_insert(
            cmp,
            w,
            rest,
            xk,
            k,
            v,
            Ordmap::law_flip_greater(cmp, w, k, xk, q),
            And::left(h)
          ),
          Ordmap::list_insert_sorted(cmp, w, rest, k, v, And::right(h))
        )
      )
    }
  }
}

pub theorem Ordmap::list_get_insert_same<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  es: List(K × V),
  k: K,
  v: V
): Ordmap::list_get(Ordmap::list_insert(es, k, v, cmp), k, cmp) = Some(v) {
  match es {
    Nil => Ordmap::list_get_equal(k, v, Nil, k, cmp, Ordmap::law_same(cmp, w, k))
    Cons(x, rest) => match x {
      #(xk, xv) => Ordering::cases(
        (c: Ordering) => Ordmap::list_get(⊢ List(K × V) from match c {
          Less => Cons(#(k, v), Cons(#(xk, xv), rest))
          Equal => Cons(#(k, v), rest)
          Greater => Cons(#(xk, xv), Ordmap::list_insert(rest, k, v, cmp))
        }, k, cmp) = Some(v),
        cmp(k, xk),
        (q: cmp(k, xk) = Less) => Ordmap::list_get_equal(
          k,
          v,
          Cons(#(xk, xv), rest),
          k,
          cmp,
          Ordmap::law_same(cmp, w, k)
        ),
        (q: cmp(k, xk) = Equal) => Ordmap::list_get_equal(k, v, rest, k, cmp, Ordmap::law_same(cmp, w, k)),
        (q: cmp(k, xk) = Greater) => Eq::trans(
          Ordmap::list_get_skip(
            Greater,
            greater_ne_equal,
            xk,
            xv,
            Ordmap::list_insert(rest, k, v, cmp),
            k,
            cmp,
            q
          ),
          Ordmap::list_get_insert_same(cmp, w, rest, k, v)
        )
      )
    }
  }
}

pub theorem Ordmap::list_get_insert_other<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  es: List(K × V),
  k: K,
  v: V,
  j: K,
  o: Ordering,
  ne: ¬(o = Equal),
  ej: cmp(j, k) = o
): Ordmap::list_get(Ordmap::list_insert(es, k, v, cmp), j, cmp) = Ordmap::list_get(es, j, cmp) {
  match es {
    Nil => Ordmap::list_get_skip(o, ne, k, v, Nil, j, cmp, ej)
    Cons(x, rest) => match x {
      #(xk, xv) => Ordering::cases(
        (c: Ordering) => Ordmap::list_get(⊢ List(K × V) from match c {
          Less => Cons(#(k, v), Cons(#(xk, xv), rest))
          Equal => Cons(#(k, v), rest)
          Greater => Cons(#(xk, xv), Ordmap::list_insert(rest, k, v, cmp))
        }, j, cmp) = Ordmap::list_get(Cons(#(xk, xv), rest), j, cmp),
        cmp(k, xk),
        (q: cmp(k, xk) = Less) => Ordmap::list_get_skip(o, ne, k, v, Cons(#(xk, xv), rest), j, cmp, ej),
        (q: cmp(k, xk) = Equal) => Eq::trans(
          Ordmap::list_get_skip(o, ne, k, v, rest, j, cmp, ej),
          Eq::sym(
            Ordmap::list_get_skip(
              o,
              ne,
              xk,
              xv,
              rest,
              j,
              cmp,
              Eq::subst((z: K) => cmp(j, z) = o, Ordmap::law_eq(cmp, w, k, xk, q), ej)
            )
          )
        ),
        (q: cmp(k, xk) = Greater) => Ordmap::list_get_cons_congr(
          xk,
          xv,
          Ordmap::list_insert(rest, k, v, cmp),
          rest,
          j,
          cmp,
          Ordmap::list_get_insert_other(cmp, w, rest, k, v, j, o, ne, ej)
        )
      )
    }
  }
}

pub theorem Ordmap::node_entries<K: Type, V: Type>(
  l: OrdmapTree(K, V),
  nk: K,
  nv: V,
  r: OrdmapTree(K, V),
  h: Nat
): Ordmap::tree_entries(
  OrdmapNode(l, nk, nv, r, h),
  Nil
) = List::append(Ordmap::tree_entries(l, Nil), Cons(#(nk, nv), Ordmap::tree_entries(r, Nil))) {
  Ordmap::entries_append(l, Cons(#(nk, nv), Ordmap::tree_entries(r, Nil)))
}

pub theorem Ordmap::node_split<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  l: OrdmapTree(K, V),
  nk: K,
  nv: V,
  r: OrdmapTree(K, V),
  h: Nat,
  s: Ordmap::sorted(Ordmap::tree_entries(OrdmapNode(l, nk, nv, r, h), Nil), cmp)
): Ordmap::keys(Ordmap::tree_entries(l, Nil), nk, Greater, cmp) ∧
Ordmap::sorted(Ordmap::tree_entries(l, Nil), cmp) ∧
Ordmap::keys(Ordmap::tree_entries(r, Nil), nk, Less, cmp) ∧
Ordmap::sorted(Ordmap::tree_entries(r, Nil), cmp) {
  Ordmap::sorted_split(
    cmp,
    w,
    Ordmap::tree_entries(l, Nil),
    nk,
    nv,
    Ordmap::tree_entries(r, Nil),
    Eq::subst((z: List(K × V)) => Ordmap::sorted(z, cmp), Ordmap::node_entries(l, nk, nv, r, h), s)
  )
}

// In a tree whose entries are sorted, `Ordmap::tree_get` is the lookup in
// its entries.
pub theorem Ordmap::tree_get_entries<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  t: OrdmapTree(K, V),
  k: K,
  s: Ordmap::sorted(Ordmap::tree_entries(t, Nil), cmp)
): Ordmap::tree_get(t, k, cmp) = Ordmap::list_get(Ordmap::tree_entries(t, Nil), k, cmp) {
  match t {
    OrdmapLeaf => Refl
    OrdmapNode(l, nk, nv, r, h) => Eq::trans(
      Ordering::cases(
        (c: Ordering) => (⊢ Option(V) from match c {
          Less => Ordmap::tree_get(l, k, cmp)
          Equal => Some(nv)
          Greater => Ordmap::tree_get(r, k, cmp)
        }) = Ordmap::list_get(List::append(Ordmap::tree_entries(l, Nil), Cons(#(nk, nv), Ordmap::tree_entries(r, Nil))), k, cmp),
        cmp(k, nk),
        (q: cmp(k, nk) = Less) => Eq::trans(
          Ordmap::tree_get_entries(cmp, w, l, k, And::left(And::right(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s)))),
          Eq::sym(
            Ordmap::list_get_append_none(
              Ordmap::tree_entries(l, Nil),
              Cons(#(nk, nv), Ordmap::tree_entries(r, Nil)),
              k,
              cmp,
              Ordmap::list_get_keys_none(
                k,
                Less,
                less_ne_equal,
                Cons(#(nk, nv), Ordmap::tree_entries(r, Nil)),
                cmp,
                AndIntro(
                  q,
                  Ordmap::keys_less_trans(
                    cmp,
                    w,
                    Ordmap::tree_entries(r, Nil),
                    nk,
                    k,
                    q,
                    And::left(And::right(And::right(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s))))
                  )
                )
              )
            )
          )
        ),
        (q: cmp(k, nk) = Equal) => Eq::sym(
          Eq::trans(
            Ordmap::list_get_append_skip(
              Greater,
              greater_ne_equal,
              Ordmap::tree_entries(l, Nil),
              Cons(#(nk, nv), Ordmap::tree_entries(r, Nil)),
              k,
              cmp,
              Ordmap::keys_eq(
                Ordmap::tree_entries(l, Nil),
                nk,
                k,
                Eq::sym(Ordmap::law_eq(cmp, w, k, nk, q)),
                Greater,
                cmp,
                And::left(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s))
              )
            ),
            Ordmap::list_get_equal(nk, nv, Ordmap::tree_entries(r, Nil), k, cmp, q)
          )
        ),
        (q: cmp(k, nk) = Greater) => Eq::trans(
          Ordmap::tree_get_entries(
            cmp,
            w,
            r,
            k,
            And::right(And::right(And::right(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s))))
          ),
          Eq::sym(
            Eq::trans(
              Ordmap::list_get_append_skip(
                Greater,
                greater_ne_equal,
                Ordmap::tree_entries(l, Nil),
                Cons(#(nk, nv), Ordmap::tree_entries(r, Nil)),
                k,
                cmp,
                Ordmap::keys_greater_trans(
                  cmp,
                  w,
                  Ordmap::tree_entries(l, Nil),
                  nk,
                  k,
                  q,
                  And::left(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s))
                )
              ),
              Ordmap::list_get_skip(Greater, greater_ne_equal, nk, nv, Ordmap::tree_entries(r, Nil), k, cmp, q)
            )
          )
        )
      ),
      Eq::sym(
        Eq::congr(⟦Ordmap::list_get(□, k, cmp)⟧, Ordmap::node_entries(l, nk, nv, r, h))
      )
    )
  }
}

// In a tree whose entries are sorted, `Ordmap::tree_insert` is the insertion
// into its entries.
pub theorem Ordmap::tree_insert_entries<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  t: OrdmapTree(K, V),
  k: K,
  v: V,
  s: Ordmap::sorted(Ordmap::tree_entries(t, Nil), cmp)
): Ordmap::tree_entries(Ordmap::tree_insert(t, k, v, cmp), Nil) = Ordmap::list_insert(Ordmap::tree_entries(t, Nil), k, v, cmp) {
  ⊢ Ordmap::tree_entries(
    Ordmap::tree_insert(t, k, v, cmp),
    Nil
  ) = Ordmap::list_insert(Ordmap::tree_entries(t, Nil), k, v, cmp) from match t {
    OrdmapLeaf => Refl
    OrdmapNode(l, nk, nv, r, h) => Eq::trans(
      Ordering::cases(
        (c: Ordering) => Ordmap::tree_entries(⊢ OrdmapTree(K, V) from match c {
          Less => Ordmap::balance(Ordmap::tree_insert(l, k, v, cmp), nk, nv, r)
          Equal => OrdmapNode(l, k, v, r, h)
          Greater => Ordmap::balance(l, nk, nv, Ordmap::tree_insert(r, k, v, cmp))
        }, Nil) = Ordmap::list_insert(List::append(Ordmap::tree_entries(l, Nil), Cons(#(nk, nv), Ordmap::tree_entries(r, Nil))), k, v, cmp),
        cmp(k, nk),
        (q: cmp(k, nk) = Less) => Eq::trans(
          Ordmap::balance_entries(Ordmap::tree_insert(l, k, v, cmp), nk, nv, r, Nil),
          Eq::trans(
            Ordmap::entries_append(Ordmap::tree_insert(l, k, v, cmp), Cons(#(nk, nv), Ordmap::tree_entries(r, Nil))),
            Eq::trans(
              Eq::congr(
                ⟦List::append(□, Cons(#(nk, nv), Ordmap::tree_entries(r, Nil)))⟧,
                Ordmap::tree_insert_entries(
                  cmp,
                  w,
                  l,
                  k,
                  v,
                  And::left(And::right(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s)))
                )
              ),
              Eq::sym(Ordmap::list_insert_append_less(Ordmap::tree_entries(l, Nil), nk, nv, Ordmap::tree_entries(r, Nil), k, v, cmp, q))
            )
          )
        ),
        (q: cmp(k, nk) = Equal) => Eq::trans(
          Ordmap::entries_append(l, Cons(#(k, v), Ordmap::tree_entries(r, Nil))),
          Eq::sym(
            Eq::trans(
              Ordmap::list_insert_append_skip(
                Ordmap::tree_entries(l, Nil),
                Cons(#(nk, nv), Ordmap::tree_entries(r, Nil)),
                k,
                v,
                cmp,
                Ordmap::keys_eq(
                  Ordmap::tree_entries(l, Nil),
                  nk,
                  k,
                  Eq::sym(Ordmap::law_eq(cmp, w, k, nk, q)),
                  Greater,
                  cmp,
                  And::left(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s))
                )
              ),
              Eq::congr(
                ⟦List::append(Ordmap::tree_entries(l, Nil), □)⟧,
                Ordmap::list_insert_equal(nk, nv, Ordmap::tree_entries(r, Nil), k, v, cmp, q)
              )
            )
          )
        ),
        (q: cmp(k, nk) = Greater) => Eq::trans(
          Ordmap::balance_entries(l, nk, nv, Ordmap::tree_insert(r, k, v, cmp), Nil),
          Eq::trans(
            Ordmap::entries_append(
              l,
              Cons(#(nk, nv), Ordmap::tree_entries(Ordmap::tree_insert(r, k, v, cmp), Nil))
            ),
            Eq::trans(
              Eq::congr(
                ⟦List::append(Ordmap::tree_entries(l, Nil), Cons(#(nk, nv), □))⟧,
                Ordmap::tree_insert_entries(
                  cmp,
                  w,
                  r,
                  k,
                  v,
                  And::right(And::right(And::right(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s))))
                )
              ),
              Eq::sym(
                Eq::trans(
                  Ordmap::list_insert_append_skip(
                    Ordmap::tree_entries(l, Nil),
                    Cons(#(nk, nv), Ordmap::tree_entries(r, Nil)),
                    k,
                    v,
                    cmp,
                    Ordmap::keys_greater_trans(
                      cmp,
                      w,
                      Ordmap::tree_entries(l, Nil),
                      nk,
                      k,
                      q,
                      And::left(Ordmap::node_split(cmp, w, l, nk, nv, r, h, s))
                    )
                  ),
                  Eq::congr(
                    ⟦List::append(Ordmap::tree_entries(l, Nil), □)⟧,
                    Ordmap::list_insert_greater(nk, nv, Ordmap::tree_entries(r, Nil), k, v, cmp, q)
                  )
                )
              )
            )
          )
        )
      ),
      Eq::sym(
        Eq::congr(
          ⟦Ordmap::list_insert(□, k, v, cmp)⟧,
          Ordmap::node_entries(l, nk, nv, r, h)
        )
      )
    )
  }
}

pub fn Ordmap::ordered<K: Shared, V: Shared>(m: Ordmap(K, V), cmp: (K, K) -> Ordering): Prop {
  Ordmap::sorted(Ordmap::tree_entries(Ordmap::tree(m), Nil), cmp)
}

pub theorem Ordmap::empty_ordered<K: Type, V: Type>(
  cmp: (K, K) -> Ordering
): Ordmap::ordered(Ordmap::empty(<K: K, V: V>), cmp) {
  Trivial
}

pub theorem Ordmap::insert_ordered<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  m: Ordmap(K, V),
  k: K,
  v: V,
  s: Ordmap::ordered(m, cmp)
): Ordmap::ordered(Ordmap::insert(m, k, v, cmp), cmp) {
  Eq::subst(
    (z: List(K × V)) => Ordmap::sorted(z, cmp),
    Eq::sym(Ordmap::tree_insert_entries(cmp, w, Ordmap::tree(m), k, v, s)),
    Ordmap::list_insert_sorted(cmp, w, Ordmap::tree_entries(Ordmap::tree(m), Nil), k, v, s)
  )
}

pub theorem Ordmap::get_insert_same<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  m: Ordmap(K, V),
  k: K,
  v: V,
  s: Ordmap::ordered(m, cmp)
): Ordmap::get(Ordmap::insert(m, k, v, cmp), k, cmp) = Some(v) {
  Eq::trans(
    Ordmap::tree_get_entries(
      cmp,
      w,
      Ordmap::tree_insert(Ordmap::tree(m), k, v, cmp),
      k,
      Ordmap::insert_ordered(cmp, w, m, k, v, s)
    ),
    Eq::trans(
      Eq::congr(⟦Ordmap::list_get(□, k, cmp)⟧, Ordmap::tree_insert_entries(cmp, w, Ordmap::tree(m), k, v, s)),
      Ordmap::list_get_insert_same(cmp, w, Ordmap::tree_entries(Ordmap::tree(m), Nil), k, v)
    )
  )
}

pub theorem Ordmap::get_insert_other<K: Type, V: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  m: Ordmap(K, V),
  k: K,
  v: V,
  j: K,
  o: Ordering,
  ne: ¬(o = Equal),
  ej: cmp(j, k) = o,
  s: Ordmap::ordered(m, cmp)
): Ordmap::get(Ordmap::insert(m, k, v, cmp), j, cmp) = Ordmap::get(m, j, cmp) {
  Eq::trans(
    Ordmap::tree_get_entries(
      cmp,
      w,
      Ordmap::tree_insert(Ordmap::tree(m), k, v, cmp),
      j,
      Ordmap::insert_ordered(cmp, w, m, k, v, s)
    ),
    Eq::trans(
      Eq::congr(⟦Ordmap::list_get(□, j, cmp)⟧, Ordmap::tree_insert_entries(cmp, w, Ordmap::tree(m), k, v, s)),
      Eq::trans(
        Ordmap::list_get_insert_other(cmp, w, Ordmap::tree_entries(Ordmap::tree(m), Nil), k, v, j, o, ne, ej),
        Eq::sym(Ordmap::tree_get_entries(cmp, w, Ordmap::tree(m), j, s))
      )
    )
  )
}

pub theorem Ordmap::select_equal(x: Bool, y: Bool, e: Ordmap::select(x, y) = Equal): x = false ∧ y = false {
  match x {
    false => match y {
      false => AndIntro(Refl, Refl)
      true => False::elim(greater_ne_equal(e))
    }
    true => False::elim(less_ne_equal(e))
  }
}

pub theorem Ordmap::select_less(x: Bool, y: Bool, e: Ordmap::select(x, y) = Less): x = true {
  match x {
    false => match y {
      false => False::elim(equal_ne_less(e))
      true => False::elim(greater_ne_less(e))
    }
    true => Refl
  }
}

pub theorem Ordmap::select_greater(x: Bool, y: Bool, e: Ordmap::select(x, y) = Greater): x = false ∧ y = true {
  match x {
    false => match y {
      false => False::elim(equal_ne_greater(e))
      true => AndIntro(Refl, Refl)
    }
    true => False::elim(less_ne_greater(e))
  }
}

pub theorem Ordmap::select_of_true(x: Bool, y: Bool, h: x = true): Ordmap::select(x, y) = Less {
  match x {
    false => False::elim(false_ne_true(h))
    true => Refl
  }
}

pub theorem Ordmap::select_of_false_true(
  x: Bool,
  y: Bool,
  hx: x = false,
  hy: y = true
): Ordmap::select(x, y) = Greater {
  match x {
    false => match y {
      false => False::elim(false_ne_true(hy))
      true => Refl
    }
    true => False::elim(true_ne_false(hx))
  }
}

pub theorem Ordmap::compare_nat_same(a: Nat): Ordmap::compare_nat(a, a) = Equal {
  Eq::subst((z: Bool) => Ordmap::select(z, z) = Equal, Eq::sym(Nat::lt_irrefl(a)), Refl)
}

pub theorem Ordmap::compare_nat_eq(a: Nat, b: Nat, e: Ordmap::compare_nat(a, b) = Equal): a = b {
  Nat::lt_total(
    a,
    b,
    And::left(Ordmap::select_equal(a < b, b < a, e)),
    And::right(Ordmap::select_equal(a < b, b < a, e))
  )
}

pub theorem Ordmap::compare_nat_flip_less(
  a: Nat,
  b: Nat,
  e: Ordmap::compare_nat(a, b) = Less
): Ordmap::compare_nat(b, a) = Greater {
  Ordmap::select_of_false_true(
    b < a,
    a < b,
    Nat::lt_asym(a, b, Ordmap::select_less(a < b, b < a, e)),
    Ordmap::select_less(a < b, b < a, e)
  )
}

pub theorem Ordmap::compare_nat_flip_greater(
  a: Nat,
  b: Nat,
  e: Ordmap::compare_nat(a, b) = Greater
): Ordmap::compare_nat(b, a) = Less {
  Ordmap::select_of_true(b < a, a < b, And::right(Ordmap::select_greater(a < b, b < a, e)))
}

pub theorem Ordmap::compare_nat_less_trans(
  a: Nat,
  b: Nat,
  c: Nat,
  e1: Ordmap::compare_nat(a, b) = Less,
  e2: Ordmap::compare_nat(b, c) = Less
): Ordmap::compare_nat(a, c) = Less {
  Ordmap::select_of_true(
    a < c,
    c < a,
    Nat::lt_trans(a, b, c, Ordmap::select_less(a < b, b < a, e1), Ordmap::select_less(b < c, c < b, e2))
  )
}

pub theorem Ordmap::compare_nat_law(): OrdmapLaw(Nat, Ordmap::compare_nat) {
  OrdmapLaw::Mk(
    Ordmap::compare_nat_same,
    Ordmap::compare_nat_eq,
    Ordmap::compare_nat_flip_less,
    Ordmap::compare_nat_flip_greater,
    Ordmap::compare_nat_less_trans
  )
}

// For maps keyed by numbers, the order needs no assumption; the map must be ordered:
pub theorem Ordmap::nat_get_insert_same<V: Type>(
  m: Ordmap(Nat, V),
  k: Nat,
  v: V,
  s: Ordmap::ordered(m, Ordmap::compare_nat)
): Ordmap::get(Ordmap::insert(m, k, v, Ordmap::compare_nat), k, Ordmap::compare_nat) = Some(v) {
  Ordmap::get_insert_same(Ordmap::compare_nat, Ordmap::compare_nat_law(), m, k, v, s)
}
