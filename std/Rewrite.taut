import "Std.taut"
import std::prelude::Macro

// `rewrite!` is here, apart from `Tactic.taut` (which also has `nat_norm!` and so imports
// `Base`), so that a file can use it without the arithmetic of `Base`.

// Tactics of the proof language (`docs/design/macro-steps.md`): macros whose
// function takes a `ProofStep`, called as `by t!(…): G0 { Δ ⊢ G from p … }`. A tactic
// is not trusted: the term it makes is checked by the kernel, with the goals
// written.

// `rewrite!(e)`, for `e: l = r`: the goal before is `M(l)` and the goal of
// the one arm `M(r)`; the term is `Eq::subst(z => M(z), Eq::sym(e), ?arm1)`. Which
// `l` change is what the arm's goal shows. `l` and `r` are read from the type of
// `e`, or, where it cannot be found (a call that is an induction hypothesis) or is
// written otherwise, from where the two goals differ. Where the goals do not say, every `l` is changed.
pub macro fn rewrite(s: ProofStep): SynExpr ! {macro_error, elab, Div} {
  let g0 := Judgement::term(s.before)
  let sides := Tac::eq_sides(s)
  let z := ExVar(SynIdent { name: "z", ctx: SynCtx { scopes: Nil }, span: s.span })
  let by_type := Tac::abstract_sides(s, sides, z)
  let body := match by_type {
    Some(m) => m
    None => match s.after {
      Nil => Syn::error(s.span, "rewrite!: the equation does not check here; write the arm's goal")
      Cons(g, rest) => match rest {
        Nil => match Syn::diff(g0, Judgement::term(g.ty)) {
          None => Syn::error(s.span, "rewrite!: the two goals are written the same")
          Some(#(@after after, @before before)) => if Syn::same(before, g0) {
            Tac::motive(s.span, None)
          } else {
            Tac::motive(s.span, Syn::abstract(g0, Judgement::term(g.ty), before, after, z))
          }
        }
        Cons(_, _) => Syn::error(s.span, "rewrite! leaves one goal: write one arm")
      }
    }
  }
  let motive := ExLam(
    [BName(SynIdent { name: "z", ctx: SynCtx { scopes: Nil }, span: s.span }, None)],
    body,
    s.span
  )
  let e := s.arg
  quote { Eq::subst($motive, Eq::sym($e), ?arm1) }
}

module Tac {
  // The body of the motive, from the sides `l` and `r` of the equation: the goal before
  // with `z` where it has `l` and the goal after has `r`. The goals are compared as written
  // first. Where they are written with another spelling than the sides (the sides come
  // elaborated: `a + b` for `Nat::add(a, b)`, the implicit arguments of a call given),
  // the goals are elaborated too, and the goal after, when no arm is written, is the one
  // before with `l` written `r`.
  pub fn abstract_sides(
    s: ProofStep,
    sides: Option(@lhs SynExpr × @rhs SynExpr),
    z: SynExpr
  ): Option(SynExpr) ! {elab, Div} {
    match sides {
      None => None
      Some(#(@lhs lhs, @rhs rhs)) => match s.after {
        Nil => match Tac::elaborated(s.before) {
          None => None
          Some(g0) => Syn::abstract(g0, Syn::replace(g0, lhs, rhs), lhs, rhs, z)
        }
        Cons(g, rest) => match rest {
          Cons(_, _) => None
          Nil => match Syn::abstract(Judgement::term(s.before), Judgement::term(g.ty), lhs, rhs, z) {
            Some(m) => Some(m)
            None => match Tac::elaborated(s.before) {
              None => None
              Some(g0) => match Tac::elaborated(g.ty) {
                None => None
                Some(g1) => Syn::abstract(g0, g1, lhs, rhs, z)
              }
            }
          }
        }
      }
    }
  }

  // The goal `g` as the checker elaborates it, `None` where it does not check.
  pub fn elaborated(g: Judgement): Option(SynExpr) ! {elab, Div} {
    match Elab::check(Judgement::term(g), g, None) {
      Err(_) => None
      Ok(c) => Some(Judgement::term(c))
    }
  }

  pub fn motive(at: SynSpan, found: Option(SynExpr)): SynExpr ! {macro_error} {
    match found {
      Some(m) => m
      None => Syn::error(
        at,
        "rewrite!: the two goals differ other than by the equation; write one step for each equation"
      )
    }
  }

  pub fn eq_sides(s: ProofStep): Option(@lhs SynExpr × @rhs SynExpr) ! {elab} {
    match Elab::check(s.arg, s.before, None) {
      Err(_) => None
      Ok(c) => match Syn::app_parts(Judgement::term(Elab::whnf(Judgement::type_of(c)))) {
        None => None
        Some(p) => Tac::sides((p: List(SynExpr)))
      }
    }
  }

  pub fn sides(xs: List(SynExpr)): Option(@lhs SynExpr × @rhs SynExpr) {
    match xs {
      Nil => None
      Cons(_, ys) => match ys {
        Nil => None
        Cons(l, zs) => match zs {
          Nil => None
          Cons(r, rest) => match rest {
            Nil => Some(#(@lhs l, @rhs r))
            Cons(_, _) => None
          }
        }
      }
    }
  }

  // The type and the two sides of a goal `l = r`. The sides are as written; the
  // type is read from the goal the kernel elaborates, where `l = r` is
  // `Eq(T, l, r)`. A goal written `Eq(T, l, r)` gives its own three.
  pub fn eq_goal(g: Judgement): Option(@lhs SynExpr × @rhs SynExpr × @ty SynExpr) ! {elab} {
    match Syn::app_parts(Judgement::term(g)) {
      None => None
      Some(p) => match Tac::two((p: List(SynExpr))) {
        Some(#(@lhs l, @rhs r)) => match Syn::app_parts(Judgement::term(Elab::whnf(g))) {
          None => None
          Some(q) => match Tac::typed((q: List(SynExpr))) {
            None => None
            Some(#(@lhs _, @rhs _, @ty ty)) => Some(#(@lhs l, @rhs r, @ty ty))
          }
        }
        None => Tac::typed((p: List(SynExpr)))
      }
    }
  }

  pub fn two(xs: List(SynExpr)): Option(@lhs SynExpr × @rhs SynExpr) {
    match xs {
      Nil => None
      Cons(l, ys) => match ys {
        Nil => None
        Cons(r, rest) => match rest {
          Nil => Some(#(@lhs l, @rhs r))
          Cons(_, _) => None
        }
      }
    }
  }

  pub fn typed(xs: List(SynExpr)): Option(@lhs SynExpr × @rhs SynExpr × @ty SynExpr) {
    match xs {
      Nil => None
      Cons(ty, rest) => match Tac::two(rest) {
        None => None
        Some(#(@lhs l, @rhs r)) => Some(#(@lhs l, @rhs r, @ty ty))
      }
    }
  }
}
