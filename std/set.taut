import "map.taut" { Ordmap }
import "map_laws.taut" { Ordmap, OrdmapLaw }
import "map_remove_floor.taut" { Ordmap }
import std::prelude::std { List, Ordering }

// An ordered set, persistent: the keys of an `Ordmap` whose values are all `true`.
// The order is the `cmp` given at every call, as in `Map::taut`, and the
// theorems take the laws of `map_laws.taut` and the order of the set from the
// map's.

pub(open) inductive Ordset(K: Type): Type {
  Mk(map: Ordmap(K, Bool)): Ordset(K)
}

pub fn Ordset::map<K: Shared>(s: Ordset(K)): Ordmap(K, Bool) {
  match s {
    Mk(m) => m
  }
}

pub fn Ordset::empty<K: Shared>(): Ordset(K) {
  Ordset::Mk(Ordmap::empty())
}

pub fn Ordset::size<K: Shared>(s: Ordset(K)): Nat {
  Ordmap::size(Ordset::map(s))
}

pub fn Ordset::contains<K: Shared>(s: Ordset(K), k: K, cmp: (K, K) -> Ordering): Bool {
  Ordmap::contains(Ordset::map(s), k, cmp)
}

pub fn Ordset::insert<K: Shared>(s: Ordset(K), k: K, cmp: (K, K) -> Ordering): Ordset(K) {
  Ordset::Mk(Ordmap::insert(Ordset::map(s), k, true, cmp))
}

pub fn Ordset::remove<K: Shared>(s: Ordset(K), k: K, cmp: (K, K) -> Ordering): Ordset(K) {
  Ordset::Mk(Ordmap::remove(Ordset::map(s), k, cmp))
}

pub fn Ordset::keys_of<K: Shared>(es: List(K × Bool)): List(K) {
  match es {
    Nil => Nil
    Cons(#(k, b), rest) => Cons(k, Ordset::keys_of(rest))
  }
}

// The elements, in order.
pub fn Ordset::to_list<K: Shared>(s: Ordset(K)): List(K) {
  Ordset::keys_of(Ordmap::entries(Ordset::map(s)))
}

pub fn Ordset::insert_all<K: Shared>(s: Ordset(K), l: List(K), cmp: (K, K) -> Ordering): Ordset(K) {
  match l {
    Nil => s
    Cons(k, rest) => Ordset::insert_all(Ordset::insert(s, k, cmp), rest, cmp)
  }
}

pub fn Ordset::of_list<K: Shared>(l: List(K), cmp: (K, K) -> Ordering): Ordset(K) {
  Ordset::insert_all(Ordset::empty(), l, cmp)
}

pub fn Ordset::union<K: Shared>(a: Ordset(K), b: Ordset(K), cmp: (K, K) -> Ordering): Ordset(K) {
  Ordset::insert_all(a, Ordset::to_list(b), cmp)
}

pub fn Ordset::keep<K: Shared>(l: List(K), b: Ordset(K), want: Bool, cmp: (K, K) -> Ordering): List(K) {
  match l {
    Nil => Nil
    Cons(k, rest) => ⊢ List(K) from match Bool::eq(Ordset::contains(b, k, cmp), want) {
      true => Cons(k, Ordset::keep(rest, b, want, cmp))
      false => Ordset::keep(rest, b, want, cmp)
    }
  }
}

pub fn Ordset::intersection<K: Shared>(a: Ordset(K), b: Ordset(K), cmp: (K, K) -> Ordering): Ordset(K) {
  Ordset::of_list(Ordset::keep(Ordset::to_list(a), b, true, cmp), cmp)
}

pub fn Ordset::difference<K: Shared>(a: Ordset(K), b: Ordset(K), cmp: (K, K) -> Ordering): Ordset(K) {
  Ordset::of_list(Ordset::keep(Ordset::to_list(a), b, false, cmp), cmp)
}

// The set's map is ordered: what the theorems below assume.
pub fn Ordset::ordered<K: Shared>(s: Ordset(K), cmp: (K, K) -> Ordering): Prop {
  Ordmap::ordered(Ordset::map(s), cmp)
}

pub theorem Ordset::empty_ordered<K: Type>(cmp: (K, K) -> Ordering): Ordset::ordered(Ordset::empty(<K: K>), cmp) {
  Ordmap::empty_ordered(<K: K, V: Bool>, cmp)
}

pub theorem Ordset::insert_ordered<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  s: Ordset(K),
  k: K,
  o: Ordset::ordered(s, cmp)
): Ordset::ordered(Ordset::insert(s, k, cmp), cmp) {
  Ordmap::insert_ordered(cmp, w, Ordset::map(s), k, true, o)
}

pub theorem Ordset::remove_ordered<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  s: Ordset(K),
  k: K,
  o: Ordset::ordered(s, cmp)
): Ordset::ordered(Ordset::remove(s, k, cmp), cmp) {
  Ordmap::remove_ordered(cmp, w, Ordset::map(s), k, o)
}

pub theorem Ordset::contains_insert_same<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  s: Ordset(K),
  k: K,
  o: Ordset::ordered(s, cmp)
): Ordset::contains(Ordset::insert(s, k, cmp), k, cmp) = true {
  Eq::congr(⟦Ordmap::is_some(□)⟧, Ordmap::get_insert_same(cmp, w, Ordset::map(s), k, true, o))
}

pub theorem Ordset::contains_insert_other<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  s: Ordset(K),
  k: K,
  j: K,
  c: Ordering,
  ne: ¬(c = Equal),
  ej: cmp(j, k) = c,
  o: Ordset::ordered(s, cmp)
): Ordset::contains(Ordset::insert(s, k, cmp), j, cmp) = Ordset::contains(s, j, cmp) {
  Eq::congr(
    ⟦Ordmap::is_some(□)⟧,
    Ordmap::get_insert_other(cmp, w, Ordset::map(s), k, true, j, c, ne, ej, o)
  )
}

pub theorem Ordset::contains_remove_same<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  s: Ordset(K),
  k: K,
  o: Ordset::ordered(s, cmp)
): Ordset::contains(Ordset::remove(s, k, cmp), k, cmp) = false {
  Eq::congr(⟦Ordmap::is_some(□)⟧, Ordmap::get_remove_same(cmp, w, Ordset::map(s), k, o))
}

pub theorem Ordset::contains_remove_other<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  s: Ordset(K),
  k: K,
  j: K,
  c: Ordering,
  ne: ¬(c = Equal),
  ej: cmp(j, k) = c,
  o: Ordset::ordered(s, cmp)
): Ordset::contains(Ordset::remove(s, k, cmp), j, cmp) = Ordset::contains(s, j, cmp) {
  Eq::congr(
    ⟦Ordmap::is_some(□)⟧,
    Ordmap::get_remove_other(cmp, w, Ordset::map(s), k, j, c, ne, ej, o)
  )
}

pub theorem Ordset::insert_all_ordered<K: Type>(
  cmp: (K, K) -> Ordering,
  w: OrdmapLaw(K, cmp),
  l: List(K),
  s: Ordset(K),
  o: Ordset::ordered(s, cmp)
): Ordset::ordered(Ordset::insert_all(s, l, cmp), cmp) {
  match l {
    Nil => o
    Cons(k, rest) => Ordset::insert_all_ordered(
      cmp,
      w,
      rest,
      Ordset::insert(s, k, cmp),
      Ordset::insert_ordered(cmp, w, s, k, o)
    )
  }
}
