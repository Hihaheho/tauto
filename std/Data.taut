import std::prelude::Std { Option, Pair }

module Option {
  // `Option` and `Pair` (`Std.taut`): the usual functions and their laws.

  pub fn map<A, B>(f: (A) -> B, o: Option(A)): Option(B) {
    ⊢ Option(B) from match o {
      None => None
      Some(a) => Some(f(a))
    }
  }

  pub fn bind<A, B>(o: Option(A), f: (A) -> Option(B)): Option(B) {
    ⊢ Option(B) from match o {
      None => None
      Some(a) => f(a)
    }
  }

  pub fn unwrap_or<A>(o: Option(A), d: A): A {
    ⊢ A from match o {
      None => d
      Some(a) => a
    }
  }

  pub fn is_some<A>(o: Option(A)): Bool {
    ⊢ Bool from match o {
      None => false
      Some(_) => true
    }
  }

  pub fn or<A>(o: Option(A), p: Option(A)): Option(A) {
    ⊢ Option(A) from match o {
      None => p
      Some(a) => o
    }
  }

  pub theorem map_id<A: Type>(o: Option(A)): Option::map((x: A) => x, o) = o {
    ⊢ Option::map((x: A) => x, o) = o from match o {
      None => Refl
      Some(_) => Refl
    }
  }

  pub theorem map_map<A: Type, B: Type, C: Type>(
    f: (A) -> B,
    g: (B) -> C,
    o: Option(A)
  ): Option::map(g, Option::map(f, o)) = Option::map((x: A) => g(f(x)), o) {
    ⊢ Option::map(g, Option::map(f, o)) = Option::map((x: A) => g(f(x)), o) from match o {
      None => Refl
      Some(_) => Refl
    }
  }

  pub theorem bind_some<A: Type>(o: Option(A)): bind(o, (x: A) => Some(x)) = o {
    ⊢ bind(o, (x: A) => Some(x)) = o from match o {
      None => Refl
      Some(_) => Refl
    }
  }

  pub theorem unwrap_or_some<A: Type>(a: A, d: A): unwrap_or(Some(a), d) = a {
    Refl
  }

  pub theorem unwrap_or_none<A: Type>(d: A): unwrap_or(None, d) = d {
    Refl
  }

  pub theorem or_none_right<A: Type>(o: Option(A)): or(o, None) = o {
    ⊢ or(o, None) = o from match o {
      None => Refl
      Some(_) => Refl
    }
  }
}

module Pair {
  pub fn fst<A, B>(p: A × B): A {
    ⊢ A from match p {
      #(a, b) => a
    }
  }

  pub fn snd<A, B>(p: A × B): B {
    ⊢ B from match p {
      #(a, b) => b
    }
  }

  pub fn swap<A, B>(p: A × B): B × A {
    ⊢ (B × A) from match p {
      #(a, b) => #(b, a)
    }
  }

  pub fn map<A, B, C, D>(f: (A) -> C, g: (B) -> D, p: A × B): C × D {
    ⊢ (C × D) from match p {
      #(a, b) => #(f(a), g(b))
    }
  }

  pub theorem swap_swap<A: Type, B: Type>(p: A × B): swap(swap(p)) = p {
    ⊢ swap(swap(p)) = p from match p {
      #(a, b) => Refl
    }
  }

  pub theorem eta<A: Type, B: Type>(p: A × B): Eq(A × B, #(Pair::fst(p), Pair::snd(p)), p) {
    ⊢ Eq(A × B, #(Pair::fst(p), Pair::snd(p)), p) from match p {
      #(a, b) => Refl
    }
  }
}
