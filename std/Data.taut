import "Base.taut"

module Option {
  // `Option` and `Pair` (`Std.taut`): the usual functions and their laws.

  pub fn map<A, B>(f: (A) -> B, o: Option(A)): Option(B) {
    match o: Option(B) {
      None => None
      Some(a) => Some(f(a))
    }
  }

  pub fn bind<A, B>(o: Option(A), f: (A) -> Option(B)): Option(B) {
    match o: Option(B) {
      None => None
      Some(a) => f(a)
    }
  }

  pub fn unwrap_or<A>(o: Option(A), d: A): A {
    match o: A {
      None => d
      Some(a) => a
    }
  }

  pub fn is_some<A>(o: Option(A)): Bool {
    match o: Bool {
      None => false
      Some(_) => true
    }
  }

  pub fn or<A>(o: Option(A), p: Option(A)): Option(A) {
    match o: Option(A) {
      None => p
      Some(a) => o
    }
  }

  pub theorem map_id<A: Type>(o: Option(A)): map((x: A) => x, o) = o {
    match o: map((x: A) => x, o) = o {
      None => Refl
      Some(_) => Refl
    }
  }

  pub theorem map_map<A: Type, B: Type, C: Type>(
    f: (A) -> B,
    g: (B) -> C,
    o: Option(A)
  ): map(g, map(f, o)) = map((x: A) => g(f(x)), o) {
    match o: map(g, map(f, o)) = map((x: A) => g(f(x)), o) {
      None => Refl
      Some(_) => Refl
    }
  }

  pub theorem bind_some<A: Type>(o: Option(A)): bind(o, (x: A) => Some(x)) = o {
    match o: bind(o, (x: A) => Some(x)) = o {
      None => Refl
      Some(_) => Refl
    }
  }

  pub theorem unwrap_or_some<A: Type>(a: A, d: A): unwrap_or(Some(a), d) = a {
    Refl
  }

  pub theorem unwrap_or_none<A: Type>(d: A): unwrap_or(None, d) = d {
    Refl
  }

  pub theorem or_none_right<A: Type>(o: Option(A)): or(o, None) = o {
    match o: or(o, None) = o {
      None => Refl
      Some(_) => Refl
    }
  }
}

module Pair {
  pub fn fst<A, B>(p: Pair(A, B)): A {
    match p: A {
      Pair { fst: a, snd: b } => a
    }
  }

  pub fn snd<A, B>(p: Pair(A, B)): B {
    match p: B {
      Pair { fst: a, snd: b } => b
    }
  }

  pub fn swap<A, B>(p: Pair(A, B)): Pair(B, A) {
    match p: Pair(B, A) {
      Pair { fst: a, snd: b } => Pair { fst: b, snd: a }
    }
  }

  pub fn map<A, B, C, D>(f: (A) -> C, g: (B) -> D, p: Pair(A, B)): Pair(C, D) {
    match p: Pair(C, D) {
      Pair { fst: a, snd: b } => Pair { fst: f(a), snd: g(b) }
    }
  }

  pub theorem swap_swap<A: Type, B: Type>(p: Pair(A, B)): swap(swap(p)) = p {
    match p: swap(swap(p)) = p {
      Pair { fst: a, snd: b } => Refl
    }
  }

  pub theorem eta<A: Type, B: Type>(
    p: Pair(A, B)
  ): Eq(Pair(A, B), Pair { fst: Pair::fst(p), snd: Pair::snd(p) }, p) {
    match p: Eq(Pair(A, B), Pair { fst: Pair::fst(p), snd: Pair::snd(p) }, p) {
      Pair { fst: a, snd: b } => Refl
    }
  }
}
