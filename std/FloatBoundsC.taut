pub theorem relb1(
  D: Nat,
  U: Nat,
  K2: Nat,
  A56: Nat,
  GQ: Nat,
  h1: NatLe(D, Nat::mul(U, K2)),
  h2: NatLe(U, Nat::mul(A56, Nat::mul(2, GQ)))
): NatLe(D, Nat::mul(A56, Nat::mul(Nat::mul(2, GQ), K2))) {
  Int::le_trans(
    IntOfNat(D),
    Int::mul(IntOfNat(2), IntOfNat(Nat::mul(K2, Nat::mul(A56, GQ)))),
    IntOfNat(Nat::mul(A56, Nat::mul(Nat::mul(2, GQ), K2))),
    int_le_lin(
      Int::add(Int::mul(IntOfNat(D), IntOfNat(1)), Int::mul(IntOfNat(U), IntOfNat(K2))),
      Int::add(
        Int::mul(IntOfNat(Nat::mul(U, K2)), IntOfNat(1)),
        Int::mul(IntOfNat(Nat::mul(A56, Nat::mul(2, GQ))), IntOfNat(K2))
      ),
      1,
      Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(U, K2)))),
      IntOfNat(D),
      Int::mul(IntOfNat(2), IntOfNat(Nat::mul(K2, Nat::mul(A56, GQ)))),
      int_le_add2(
        Int::mul(IntOfNat(D), IntOfNat(1)),
        Int::mul(IntOfNat(Nat::mul(U, K2)), IntOfNat(1)),
        Int::mul(IntOfNat(U), IntOfNat(K2)),
        Int::mul(IntOfNat(Nat::mul(A56, Nat::mul(2, GQ))), IntOfNat(K2)),
        int_le_mul_nat(IntOfNat(D), IntOfNat(Nat::mul(U, K2)), 1, h1),
        int_le_mul_nat(IntOfNat(U), IntOfNat(Nat::mul(A56, Nat::mul(2, GQ))), K2, h2)
      ),
      relb1_37(D, U, K2, A56, GQ),
      relb1_38(D, U, K2, A56, GQ)
    ),
    int_le_by(
      Int::mul(IntOfNat(2), IntOfNat(Nat::mul(K2, Nat::mul(A56, GQ)))),
      IntOfNat(Nat::mul(A56, Nat::mul(Nat::mul(2, GQ), K2))),
      0,
      relb1_39(D, U, K2, A56, GQ)
    )
  )
}

pub theorem relb2(
  D: Nat,
  U: Nat,
  K2: Nat,
  A56: Nat,
  GQ: Nat,
  h1: NatLe(Nat::mul(U, K2), D),
  h2: NatLe(Nat::mul(A56, Nat::mul(2, GQ)), U)
): NatLe(Nat::mul(A56, Nat::mul(Nat::mul(2, GQ), K2)), D) {
  Int::le_trans(
    IntOfNat(Nat::mul(A56, Nat::mul(Nat::mul(2, GQ), K2))),
    Int::mul(IntOfNat(1), IntOfNat(D)),
    IntOfNat(D),
    int_le_lin(
      Int::add(
        Int::mul(IntOfNat(Nat::mul(U, K2)), IntOfNat(1)),
        Int::mul(IntOfNat(Nat::mul(A56, Nat::mul(2, GQ))), IntOfNat(K2))
      ),
      Int::add(Int::mul(IntOfNat(D), IntOfNat(1)), Int::mul(IntOfNat(U), IntOfNat(K2))),
      1,
      Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(U, K2)))),
      IntOfNat(Nat::mul(A56, Nat::mul(Nat::mul(2, GQ), K2))),
      Int::mul(IntOfNat(1), IntOfNat(D)),
      int_le_add2(
        Int::mul(IntOfNat(Nat::mul(U, K2)), IntOfNat(1)),
        Int::mul(IntOfNat(D), IntOfNat(1)),
        Int::mul(IntOfNat(Nat::mul(A56, Nat::mul(2, GQ))), IntOfNat(K2)),
        Int::mul(IntOfNat(U), IntOfNat(K2)),
        int_le_mul_nat(IntOfNat(Nat::mul(U, K2)), IntOfNat(D), 1, h1),
        int_le_mul_nat(IntOfNat(Nat::mul(A56, Nat::mul(2, GQ))), IntOfNat(U), K2, h2)
      ),
      relb2_40(D, U, K2, A56, GQ),
      relb2_41(D, U, K2, A56, GQ)
    ),
    int_le_by(Int::mul(IntOfNat(1), IntOfNat(D)), IntOfNat(D), 0, relb2_42(D, U, K2, A56, GQ))
  )
}

