// Linear facts the proofs of `FloatPack.taut` combine: sticky digits and scaling.

import "Base.taut"
import "Int.taut"
import "IntNorm.taut"
import "IntOrder.taut"

pub theorem scaled_a1(
  S: Nat,
  P: Nat,
  Q: Nat,
  K2: Nat,
  Pe: Nat,
  Z: Nat,
  hs: NatLe(Nat::mul(S, Q), Nat::add(Nat::mul(2, Nat::mul(P, K2)), Q)),
  hz: NatLe(Nat::mul(2, Nat::mul(K2, Pe)), Z)
): NatLe(Nat::mul(S, Nat::mul(Q, Pe)), Nat::add(Nat::mul(P, Z), Nat::mul(Q, Pe))) {
  Int::le_trans(
    IntOfNat(Nat::mul(S, Nat::mul(Q, Pe))),
    Int::add(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(P, Z))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
    ),
    IntOfNat(Nat::add(Nat::mul(P, Z), Nat::mul(Q, Pe))),
    int_le_lin(
      Int::add(
        Int::mul(IntOfNat(Nat::mul(S, Q)), IntOfNat(Pe)),
        Int::mul(IntOfNat(Nat::mul(2, Nat::mul(K2, Pe))), IntOfNat(P))
      ),
      Int::add(
        Int::mul(IntOfNat(Nat::add(Nat::mul(2, Nat::mul(P, K2)), Q)), IntOfNat(Pe)),
        Int::mul(IntOfNat(Z), IntOfNat(P))
      ),
      1,
      Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(P, Nat::mul(K2, Pe))))),
      IntOfNat(Nat::mul(S, Nat::mul(Q, Pe))),
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(P, Z))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
      ),
      int_le_add2(
        Int::mul(IntOfNat(Nat::mul(S, Q)), IntOfNat(Pe)),
        Int::mul(IntOfNat(Nat::add(Nat::mul(2, Nat::mul(P, K2)), Q)), IntOfNat(Pe)),
        Int::mul(IntOfNat(Nat::mul(2, Nat::mul(K2, Pe))), IntOfNat(P)),
        Int::mul(IntOfNat(Z), IntOfNat(P)),
        int_le_mul_nat(
          IntOfNat(Nat::mul(S, Q)),
          IntOfNat(Nat::add(Nat::mul(2, Nat::mul(P, K2)), Q)),
          Pe,
          hs
        ),
        int_le_mul_nat(IntOfNat(Nat::mul(2, Nat::mul(K2, Pe))), IntOfNat(Z), P, hz)
      ),
      scaled_a1_0(S, P, Q, K2, Pe, Z),
      scaled_a1_1(S, P, Q, K2, Pe, Z)
    ),
    int_le_by(
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(P, Z))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
      ),
      IntOfNat(Nat::add(Nat::mul(P, Z), Nat::mul(Q, Pe))),
      0,
      scaled_a1_2(S, P, Q, K2, Pe, Z)
    )
  )
}

pub theorem scaled_a2(
  S: Nat,
  P: Nat,
  Q: Nat,
  K2: Nat,
  Pe: Nat,
  Z: Nat,
  hs: NatLe(Nat::mul(2, Nat::mul(P, K2)), Nat::add(Nat::mul(S, Q), Q)),
  hz: NatLe(Z, Nat::mul(2, Nat::mul(K2, Pe)))
): NatLe(Nat::mul(P, Z), Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))) {
  Int::le_trans(
    IntOfNat(Nat::mul(P, Z)),
    Int::add(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Nat::mul(Q, Pe)))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
    ),
    IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))),
    int_le_lin(
      Int::add(
        Int::mul(IntOfNat(Nat::mul(2, Nat::mul(P, K2))), IntOfNat(Pe)),
        Int::mul(IntOfNat(Z), IntOfNat(P))
      ),
      Int::add(
        Int::mul(IntOfNat(Nat::add(Nat::mul(S, Q), Q)), IntOfNat(Pe)),
        Int::mul(IntOfNat(Nat::mul(2, Nat::mul(K2, Pe))), IntOfNat(P))
      ),
      1,
      Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(P, Nat::mul(K2, Pe))))),
      IntOfNat(Nat::mul(P, Z)),
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Nat::mul(Q, Pe)))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
      ),
      int_le_add2(
        Int::mul(IntOfNat(Nat::mul(2, Nat::mul(P, K2))), IntOfNat(Pe)),
        Int::mul(IntOfNat(Nat::add(Nat::mul(S, Q), Q)), IntOfNat(Pe)),
        Int::mul(IntOfNat(Z), IntOfNat(P)),
        Int::mul(IntOfNat(Nat::mul(2, Nat::mul(K2, Pe))), IntOfNat(P)),
        int_le_mul_nat(
          IntOfNat(Nat::mul(2, Nat::mul(P, K2))),
          IntOfNat(Nat::add(Nat::mul(S, Q), Q)),
          Pe,
          hs
        ),
        int_le_mul_nat(IntOfNat(Z), IntOfNat(Nat::mul(2, Nat::mul(K2, Pe))), P, hz)
      ),
      scaled_a2_3(S, P, Q, K2, Pe, Z),
      scaled_a2_4(S, P, Q, K2, Pe, Z)
    ),
    int_le_by(
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Nat::mul(Q, Pe)))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
      ),
      IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))),
      0,
      scaled_a2_5(S, P, Q, K2, Pe, Z)
    )
  )
}

pub theorem scaled_b1(
  S: Nat,
  P: Nat,
  Q: Nat,
  K2: Nat,
  Pe: Nat,
  Z: Nat,
  H: Nat,
  hs: NatLe(Nat::mul(S, Nat::mul(Q, K2)), Nat::add(Nat::mul(2, P), Nat::mul(Q, K2))),
  hp1: NatLe(Pe, Nat::mul(H, K2)),
  hp2: NatLe(Nat::mul(H, K2), Pe),
  hz: NatLe(Nat::mul(2, H), Z)
): NatLe(Nat::mul(S, Nat::mul(Q, Pe)), Nat::add(Nat::mul(P, Z), Nat::mul(Q, Pe))) {
  Int::le_trans(
    IntOfNat(Nat::mul(S, Nat::mul(Q, Pe))),
    Int::add(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(P, Z))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
    ),
    IntOfNat(Nat::add(Nat::mul(P, Z), Nat::mul(Q, Pe))),
    int_le_lin(
      Int::add(
        Int::add(
          Int::add(
            Int::mul(IntOfNat(Nat::mul(S, Nat::mul(Q, K2))), IntOfNat(H)),
            Int::mul(IntOfNat(Pe), IntOfNat(Nat::mul(S, Q)))
          ),
          Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Q))
        ),
        Int::mul(IntOfNat(Nat::mul(2, H)), IntOfNat(P))
      ),
      Int::add(
        Int::add(
          Int::add(
            Int::mul(IntOfNat(Nat::add(Nat::mul(2, P), Nat::mul(Q, K2))), IntOfNat(H)),
            Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Nat::mul(S, Q)))
          ),
          Int::mul(IntOfNat(Pe), IntOfNat(Q))
        ),
        Int::mul(IntOfNat(Z), IntOfNat(P))
      ),
      1,
      Int::add(
        Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Nat::mul(Q, Nat::mul(K2, H)))))),
        Int::add(
          Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(P, H)))),
          Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(K2, H)))))
        )
      ),
      IntOfNat(Nat::mul(S, Nat::mul(Q, Pe))),
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(P, Z))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
      ),
      int_le_add2(
        Int::add(
          Int::add(
            Int::mul(IntOfNat(Nat::mul(S, Nat::mul(Q, K2))), IntOfNat(H)),
            Int::mul(IntOfNat(Pe), IntOfNat(Nat::mul(S, Q)))
          ),
          Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Q))
        ),
        Int::add(
          Int::add(
            Int::mul(IntOfNat(Nat::add(Nat::mul(2, P), Nat::mul(Q, K2))), IntOfNat(H)),
            Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Nat::mul(S, Q)))
          ),
          Int::mul(IntOfNat(Pe), IntOfNat(Q))
        ),
        Int::mul(IntOfNat(Nat::mul(2, H)), IntOfNat(P)),
        Int::mul(IntOfNat(Z), IntOfNat(P)),
        int_le_add2(
          Int::add(
            Int::mul(IntOfNat(Nat::mul(S, Nat::mul(Q, K2))), IntOfNat(H)),
            Int::mul(IntOfNat(Pe), IntOfNat(Nat::mul(S, Q)))
          ),
          Int::add(
            Int::mul(IntOfNat(Nat::add(Nat::mul(2, P), Nat::mul(Q, K2))), IntOfNat(H)),
            Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Nat::mul(S, Q)))
          ),
          Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Q)),
          Int::mul(IntOfNat(Pe), IntOfNat(Q)),
          int_le_add2(
            Int::mul(IntOfNat(Nat::mul(S, Nat::mul(Q, K2))), IntOfNat(H)),
            Int::mul(IntOfNat(Nat::add(Nat::mul(2, P), Nat::mul(Q, K2))), IntOfNat(H)),
            Int::mul(IntOfNat(Pe), IntOfNat(Nat::mul(S, Q))),
            Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Nat::mul(S, Q))),
            int_le_mul_nat(
              IntOfNat(Nat::mul(S, Nat::mul(Q, K2))),
              IntOfNat(Nat::add(Nat::mul(2, P), Nat::mul(Q, K2))),
              H,
              hs
            ),
            int_le_mul_nat(IntOfNat(Pe), IntOfNat(Nat::mul(H, K2)), Nat::mul(S, Q), hp1)
          ),
          int_le_mul_nat(IntOfNat(Nat::mul(H, K2)), IntOfNat(Pe), Q, hp2)
        ),
        int_le_mul_nat(IntOfNat(Nat::mul(2, H)), IntOfNat(Z), P, hz)
      ),
      scaled_b1_6(S, P, Q, K2, Pe, Z, H),
      scaled_b1_7(S, P, Q, K2, Pe, Z, H)
    ),
    int_le_by(
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(P, Z))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
      ),
      IntOfNat(Nat::add(Nat::mul(P, Z), Nat::mul(Q, Pe))),
      0,
      scaled_b1_8(S, P, Q, K2, Pe, Z, H)
    )
  )
}

pub theorem scaled_b2(
  S: Nat,
  P: Nat,
  Q: Nat,
  K2: Nat,
  Pe: Nat,
  Z: Nat,
  H: Nat,
  hs: NatLe(Nat::mul(2, P), Nat::add(Nat::mul(S, Nat::mul(Q, K2)), Nat::mul(Q, K2))),
  hp2: NatLe(Nat::mul(H, K2), Pe),
  hz: NatLe(Z, Nat::mul(2, H))
): NatLe(Nat::mul(P, Z), Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))) {
  Int::le_trans(
    IntOfNat(Nat::mul(P, Z)),
    Int::add(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Nat::mul(Q, Pe)))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
    ),
    IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))),
    int_le_lin(
      Int::add(
        Int::add(
          Int::mul(IntOfNat(Nat::mul(2, P)), IntOfNat(H)),
          Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Nat::add(Nat::mul(S, Q), Q)))
        ),
        Int::mul(IntOfNat(Z), IntOfNat(P))
      ),
      Int::add(
        Int::add(
          Int::mul(IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, K2)), Nat::mul(Q, K2))), IntOfNat(H)),
          Int::mul(IntOfNat(Pe), IntOfNat(Nat::add(Nat::mul(S, Q), Q)))
        ),
        Int::mul(IntOfNat(Nat::mul(2, H)), IntOfNat(P))
      ),
      1,
      Int::add(
        Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Nat::mul(Q, Nat::mul(K2, H)))))),
        Int::add(
          Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(P, H)))),
          Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(K2, H)))))
        )
      ),
      IntOfNat(Nat::mul(P, Z)),
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Nat::mul(Q, Pe)))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
      ),
      int_le_add2(
        Int::add(
          Int::mul(IntOfNat(Nat::mul(2, P)), IntOfNat(H)),
          Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Nat::add(Nat::mul(S, Q), Q)))
        ),
        Int::add(
          Int::mul(IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, K2)), Nat::mul(Q, K2))), IntOfNat(H)),
          Int::mul(IntOfNat(Pe), IntOfNat(Nat::add(Nat::mul(S, Q), Q)))
        ),
        Int::mul(IntOfNat(Z), IntOfNat(P)),
        Int::mul(IntOfNat(Nat::mul(2, H)), IntOfNat(P)),
        int_le_add2(
          Int::mul(IntOfNat(Nat::mul(2, P)), IntOfNat(H)),
          Int::mul(IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, K2)), Nat::mul(Q, K2))), IntOfNat(H)),
          Int::mul(IntOfNat(Nat::mul(H, K2)), IntOfNat(Nat::add(Nat::mul(S, Q), Q))),
          Int::mul(IntOfNat(Pe), IntOfNat(Nat::add(Nat::mul(S, Q), Q))),
          int_le_mul_nat(
            IntOfNat(Nat::mul(2, P)),
            IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, K2)), Nat::mul(Q, K2))),
            H,
            hs
          ),
          int_le_mul_nat(IntOfNat(Nat::mul(H, K2)), IntOfNat(Pe), Nat::add(Nat::mul(S, Q), Q), hp2)
        ),
        int_le_mul_nat(IntOfNat(Z), IntOfNat(Nat::mul(2, H)), P, hz)
      ),
      scaled_b2_9(S, P, Q, K2, Pe, Z, H),
      scaled_b2_10(S, P, Q, K2, Pe, Z, H)
    ),
    int_le_by(
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Nat::mul(Q, Pe)))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Pe)))
      ),
      IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))),
      0,
      scaled_b2_11(S, P, Q, K2, Pe, Z, H)
    )
  )
}

pub theorem a_lo_contra(
  S: Nat,
  P: Nat,
  Q: Nat,
  K2: Nat,
  GP: Nat,
  GQ: Nat,
  h: NatLe(Succ(S), 72057594037927936),
  hs: NatLe(Nat::mul(2, Nat::mul(P, K2)), Nat::add(Nat::mul(S, Q), Q)),
  hP: NatLe(GP, P),
  hr: NatLe(Nat::mul(72057594037927936, Nat::mul(2, GQ)), Nat::mul(Nat::mul(2, GP), K2)),
  hQ: NatLe(Succ(Q), Nat::mul(2, GQ))
): False {
  false_ne_true(
    Int::le_trans(
      IntOfNat(1),
      Int::neg(Int::mul(IntOfNat(72057594037927935), IntOfNat(1))),
      IntOfNat(0),
      int_le_lin(
        Int::add(
          Int::add(
            Int::add(
              Int::add(
                Int::mul(IntOfNat(Succ(S)), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::mul(2, Nat::mul(P, K2))), IntOfNat(1))
              ),
              Int::mul(IntOfNat(GP), IntOfNat(Nat::mul(2, K2)))
            ),
            Int::mul(IntOfNat(Nat::mul(72057594037927936, Nat::mul(2, GQ))), IntOfNat(1))
          ),
          Int::mul(IntOfNat(Succ(Q)), IntOfNat(72057594037927936))
        ),
        Int::add(
          Int::add(
            Int::add(
              Int::add(
                Int::mul(IntOfNat(72057594037927936), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::add(Nat::mul(S, Q), Q)), IntOfNat(1))
              ),
              Int::mul(IntOfNat(P), IntOfNat(Nat::mul(2, K2)))
            ),
            Int::mul(IntOfNat(Nat::mul(Nat::mul(2, GP), K2)), IntOfNat(1))
          ),
          Int::mul(IntOfNat(Nat::mul(2, GQ)), IntOfNat(72057594037927936))
        ),
        1,
        Int::add(
          Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(S, Q)))),
          Int::add(
            Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(P, K2)))),
            Int::add(
              Int::neg(Int::mul(IntOfNat(72057594037927937), IntOfNat(Q))),
              Int::add(
                Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(K2, GP)))),
                Int::add(
                  Int::neg(Int::mul(IntOfNat(144115188075855872), IntOfNat(GQ))),
                  Int::neg(Int::mul(IntOfNat(72057594037927935), IntOfNat(1)))
                )
              )
            )
          )
        ),
        IntOfNat(1),
        Int::neg(Int::mul(IntOfNat(72057594037927935), IntOfNat(1))),
        int_le_add2(
          Int::add(
            Int::add(
              Int::add(
                Int::mul(IntOfNat(Succ(S)), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::mul(2, Nat::mul(P, K2))), IntOfNat(1))
              ),
              Int::mul(IntOfNat(GP), IntOfNat(Nat::mul(2, K2)))
            ),
            Int::mul(IntOfNat(Nat::mul(72057594037927936, Nat::mul(2, GQ))), IntOfNat(1))
          ),
          Int::add(
            Int::add(
              Int::add(
                Int::mul(IntOfNat(72057594037927936), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::add(Nat::mul(S, Q), Q)), IntOfNat(1))
              ),
              Int::mul(IntOfNat(P), IntOfNat(Nat::mul(2, K2)))
            ),
            Int::mul(IntOfNat(Nat::mul(Nat::mul(2, GP), K2)), IntOfNat(1))
          ),
          Int::mul(IntOfNat(Succ(Q)), IntOfNat(72057594037927936)),
          Int::mul(IntOfNat(Nat::mul(2, GQ)), IntOfNat(72057594037927936)),
          int_le_add2(
            Int::add(
              Int::add(
                Int::mul(IntOfNat(Succ(S)), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::mul(2, Nat::mul(P, K2))), IntOfNat(1))
              ),
              Int::mul(IntOfNat(GP), IntOfNat(Nat::mul(2, K2)))
            ),
            Int::add(
              Int::add(
                Int::mul(IntOfNat(72057594037927936), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::add(Nat::mul(S, Q), Q)), IntOfNat(1))
              ),
              Int::mul(IntOfNat(P), IntOfNat(Nat::mul(2, K2)))
            ),
            Int::mul(IntOfNat(Nat::mul(72057594037927936, Nat::mul(2, GQ))), IntOfNat(1)),
            Int::mul(IntOfNat(Nat::mul(Nat::mul(2, GP), K2)), IntOfNat(1)),
            int_le_add2(
              Int::add(
                Int::mul(IntOfNat(Succ(S)), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::mul(2, Nat::mul(P, K2))), IntOfNat(1))
              ),
              Int::add(
                Int::mul(IntOfNat(72057594037927936), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::add(Nat::mul(S, Q), Q)), IntOfNat(1))
              ),
              Int::mul(IntOfNat(GP), IntOfNat(Nat::mul(2, K2))),
              Int::mul(IntOfNat(P), IntOfNat(Nat::mul(2, K2))),
              int_le_add2(
                Int::mul(IntOfNat(Succ(S)), IntOfNat(Q)),
                Int::mul(IntOfNat(72057594037927936), IntOfNat(Q)),
                Int::mul(IntOfNat(Nat::mul(2, Nat::mul(P, K2))), IntOfNat(1)),
                Int::mul(IntOfNat(Nat::add(Nat::mul(S, Q), Q)), IntOfNat(1)),
                int_le_mul_nat(IntOfNat(Succ(S)), IntOfNat(72057594037927936), Q, h),
                int_le_mul_nat(
                  IntOfNat(Nat::mul(2, Nat::mul(P, K2))),
                  IntOfNat(Nat::add(Nat::mul(S, Q), Q)),
                  1,
                  hs
                )
              ),
              int_le_mul_nat(IntOfNat(GP), IntOfNat(P), Nat::mul(2, K2), hP)
            ),
            int_le_mul_nat(
              IntOfNat(Nat::mul(72057594037927936, Nat::mul(2, GQ))),
              IntOfNat(Nat::mul(Nat::mul(2, GP), K2)),
              1,
              hr
            )
          ),
          int_le_mul_nat(IntOfNat(Succ(Q)), IntOfNat(Nat::mul(2, GQ)), 72057594037927936, hQ)
        ),
        a_lo_contra_12(S, P, Q, K2, GP, GQ),
        a_lo_contra_13(S, P, Q, K2, GP, GQ)
      ),
      int_le_by(
        Int::neg(Int::mul(IntOfNat(72057594037927935), IntOfNat(1))),
        IntOfNat(0),
        72057594037927935,
        a_lo_contra_14(S, P, Q, K2, GP, GQ)
      )
    )
  )
}

pub theorem a_hi_contra(
  S: Nat,
  P: Nat,
  Q: Nat,
  K2: Nat,
  GP: Nat,
  GQ: Nat,
  h: NatLe(Succ(288230376151711744), S),
  hs: NatLe(Nat::mul(S, Q), Nat::add(Nat::mul(2, Nat::mul(P, K2)), Q)),
  hP: NatLe(Succ(P), Nat::mul(2, GP)),
  hr: NatLe(Nat::mul(Nat::mul(2, GP), K2), Nat::mul(72057594037927936, Nat::mul(2, GQ))),
  hQ: NatLe(GQ, Q),
  hK: NatLe(1, K2)
): False {
  false_ne_true(
    Int::le_trans(
      IntOfNat(1),
      Int::neg(Int::mul(IntOfNat(1), IntOfNat(K2))),
      IntOfNat(0),
      int_le_lin(
        Int::add(
          Int::add(
            Int::add(
              Int::add(
                Int::add(
                  Int::mul(IntOfNat(Succ(288230376151711744)), IntOfNat(Q)),
                  Int::mul(IntOfNat(Nat::mul(S, Q)), IntOfNat(1))
                ),
                Int::mul(IntOfNat(Succ(P)), IntOfNat(Nat::mul(2, K2)))
              ),
