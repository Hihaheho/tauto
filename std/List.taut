import "Base.taut" { List, Nat }
import "Nat.taut" { Nat }
import std::prelude::Std { List, Option, Pair }

module List {
  // Lists beyond the basics of `Base.taut`: folds, searches, zips, and the
  // lemmas that relate them. Predicates are `(A) -> Bool`.

  pub fn filter<A>(p: (A) -> Bool, l: List(A)): List(A) {
    ⊢ List(A) from match l {
      Nil => Nil
      Cons(h, t) => ⊢ List(A) from match p(h) {
        false => List::filter(p, t)
        true => Cons(h, List::filter(p, t))
      }
    }
  }

  pub fn foldr<A, B>(f: (A, B) -> B, z: B, l: List(A)): B {
    ⊢ B from match l {
      Nil => z
      Cons(h, t) => f(h, foldr(f, z, t))
    }
  }

  // Folds from the left: `f(f(f(z, a), b), c)` for `[a, b, c]`.
  pub fn foldl<A, B>(f: (B, A) -> B, z: B, l: List(A)): B {
    foldr((a: A, acc: B) => f(acc, a), z, List::reverse(l))
  }

  pub fn any<A>(p: (A) -> Bool, l: List(A)): Bool {
    ⊢ Bool from match l {
      Nil => false
      Cons(h, t) => p(h) || any(p, t)
    }
  }

  pub fn all<A>(p: (A) -> Bool, l: List(A)): Bool {
    ⊢ Bool from match l {
      Nil => true
      Cons(h, t) => p(h) && all(p, t)
    }
  }

  pub fn find<A>(p: (A) -> Bool, l: List(A)): Option(A) {
    ⊢ Option(A) from match l {
      Nil => None
      Cons(h, t) => ⊢ Option(A) from match p(h) {
        false => find(p, t)
        true => Some(h)
      }
    }
  }

  // Membership by a decision `eq` on the elements.
  pub fn contains<A>(eq: (A, A) -> Bool, x: A, l: List(A)): Bool {
    any((y: A) => eq(x, y), l)
  }

  pub fn replicate<A>(n: Nat, x: A): List(A) {
    ⊢ List(A) from match n {
      Zero => Nil
      Succ(k) => Cons(x, replicate(k, x))
    }
  }

  pub fn range(n: Nat): List(Nat) {
    ⊢ List(Nat) from match n {
      Zero => Nil
      Succ(k) => Cons(Zero, List::map(Succ, range(k)))
    }
  }

  pub fn range_from(start: Nat, n: Nat): List(Nat) {
    List::map((i: Nat) => Nat::add(start, i), range(n))
  }

  pub fn head<A>(l: List(A)): Option(A) {
    ⊢ Option(A) from match l {
      Nil => None
      Cons(h, t) => Some(h)
    }
  }

  pub fn tail<A>(l: List(A)): List(A) {
    ⊢ List(A) from match l {
      Nil => Nil
      Cons(h, t) => t
    }
  }

  pub fn last<A>(l: List(A)): Option(A) {
    ⊢ Option(A) from match l {
      Nil => None
      Cons(h, t) => ⊢ Option(A) from match t {
        Nil => Some(h)
        Cons(h2, t2) => last(t)
      }
    }
  }

  pub fn concat<A>(ls: List(List(A))): List(A) {
    ⊢ List(A) from match ls {
      Nil => Nil
      Cons(h, t) => List::append(h, List::concat(t))
    }
  }

  pub fn take_while<A>(p: (A) -> Bool, l: List(A)): List(A) {
    ⊢ List(A) from match l {
      Nil => Nil
      Cons(h, t) => ⊢ List(A) from match p(h) {
        false => Nil
        true => Cons(h, take_while(p, t))
      }
    }
  }

  pub fn drop_while<A>(p: (A) -> Bool, l: List(A)): List(A) {
    ⊢ List(A) from match l {
      Nil => Nil
      Cons(h, t) => ⊢ List(A) from match p(h) {
        false => l
        true => drop_while(p, t)
      }
    }
  }

  // Pairs up to the shorter of the two lists.
  pub fn zip<A, B>(l: List(A), m: List(B)): List(A × B) {
    ⊢ List(A × B) from match l {
      Nil => Nil
      Cons(a, t) => ⊢ List(A × B) from match m {
        Nil => Nil
        Cons(b, u) => Cons(#(a, b), List::zip(t, u))
      }
    }
  }

  pub fn unzip<A, B>(l: List(A × B)): List(A) × List(B) {
    #(
      List::map((p: A × B) => ⊢ A from match p { #(a, _) => a }, l),
      List::map((p: A × B) => ⊢ B from match p { #(_, b) => b }, l)
    )
  }

  pub theorem append_nil<A: Type>(l: List(A)): List::append(l, Nil) = l {
    ⊢ List::append(l, Nil) = l from match l {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(h, □)⟧, append_nil(t))
    }
  }

  pub theorem length_append<A: Type>(
    l: List(A),
    m: List(A)
  ): List::length(List::append(l, m)) = Nat::add(List::length(l), List::length(m)) {
    ⊢ List::length(List::append(l, m)) = Nat::add(List::length(l), List::length(m)) from match l {
      Nil => Eq::sym(Nat::add_zero_left(List::length(m)))
      Cons(h, t) => Eq::trans(
        Eq::congr(Succ, length_append(t, m)),
        Eq::sym(Nat::add_succ_left(List::length(t), List::length(m)))
      )
    }
  }

  pub theorem length_map<A: Type, B: Type>(
    f: (A) -> B,
    l: List(A)
  ): List::length(List::map(f, l)) = List::length(l) {
    ⊢ List::length(List::map(f, l)) = List::length(l) from match l {
      Nil => Refl
      Cons(h, t) => Eq::congr(Succ, length_map(f, t))
    }
  }

  pub theorem map_append<A: Type, B: Type>(
    f: (A) -> B,
    l: List(A),
    m: List(A)
  ): List::map(f, List::append(l, m)) = List::append(List::map(f, l), List::map(f, m)) {
    ⊢ List::map(
      f,
      List::append(l, m)
    ) = List::append(List::map(f, l), List::map(f, m)) from match l {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(f(h), □)⟧, map_append(f, t, m))
    }
  }

  pub theorem map_map<A: Type, B: Type, C: Type>(
    f: (A) -> B,
    g: (B) -> C,
    l: List(A)
  ): List::map(g, List::map(f, l)) = List::map((x: A) => g(f(x)), l) {
    ⊢ List::map(g, List::map(f, l)) = List::map((x: A) => g(f(x)), l) from match l {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(g(f(h)), □)⟧, map_map(f, g, t))
    }
  }

  pub theorem map_id<A: Type>(l: List(A)): List::map((x: A) => x, l) = l {
    ⊢ List::map((x: A) => x, l) = l from match l {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(h, □)⟧, map_id(t))
    }
  }

  pub theorem reverse_onto_append<A: Type>(
    l: List(A),
    acc: List(A)
  ): reverse_onto(l, acc) = List::append(List::reverse(l), acc) {
    ⊢ reverse_onto(l, acc) = List::append(List::reverse(l), acc) from match l {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        reverse_onto_append(t, Cons(h, acc)),
        Eq::sym(
          Eq::trans(
            Eq::congr(⟦List::append(□, acc)⟧, reverse_onto_append(t, Cons(h, Nil))),
            append_assoc(List::reverse(t), Cons(h, Nil), acc)
          )
        )
      )
    }
  }

  pub theorem reverse_cons<A: Type>(
    h: A,
    t: List(A)
  ): List::reverse(Cons(h, t)) = List::append(List::reverse(t), Cons(h, Nil)) {
    reverse_onto_append(t, Cons(h, Nil))
  }

  pub theorem reverse_append<A: Type>(
    l: List(A),
    m: List(A)
  ): List::reverse(List::append(l, m)) = List::append(List::reverse(m), List::reverse(l)) {
    ⊢ List::reverse(
      List::append(l, m)
    ) = List::append(List::reverse(m), List::reverse(l)) from match l {
      Nil => Eq::sym(append_nil(List::reverse(m)))
      Cons(h, t) => Eq::trans(
        reverse_cons(h, List::append(t, m)),
        Eq::trans(
          Eq::congr(⟦List::append(□, Cons(h, Nil))⟧, reverse_append(t, m)),
          Eq::trans(
            append_assoc(List::reverse(m), List::reverse(t), Cons(h, Nil)),
            Eq::congr(⟦List::append(List::reverse(m), □)⟧, Eq::sym(reverse_cons(h, t)))
          )
        )
      )
    }
  }

  pub theorem reverse_reverse<A: Type>(l: List(A)): List::reverse(List::reverse(l)) = l {
    ⊢ List::reverse(List::reverse(l)) = l from match l {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        Eq::congr(⟦List::reverse(□)⟧, reverse_cons(h, t)),
        Eq::trans(
          reverse_append(List::reverse(t), Cons(h, Nil)),
          Eq::congr(⟦Cons(h, □)⟧, reverse_reverse(t))
        )
      )
    }
  }

  pub theorem length_reverse<A: Type>(
    l: List(A)
  ): List::length(List::reverse(l)) = List::length(l) {
    ⊢ List::length(List::reverse(l)) = List::length(l) from match l {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        Eq::congr(⟦List::length(□)⟧, reverse_cons(h, t)),
        Eq::trans(length_append(List::reverse(t), Cons(h, Nil)), Eq::congr(Succ, length_reverse(t)))
      )
    }
  }

  pub theorem take_drop<A: Type>(n: Nat, l: List(A)): List::append(take(n, l), drop(n, l)) = l {
    ⊢ List::append(take(n, l), drop(n, l)) = l from match n {
      Zero => Refl
      Succ(k) => ⊢ List::append(take(Succ(k), l), drop(Succ(k), l)) = l from match l {
        Nil => Refl
        Cons(h, t) => Eq::congr(⟦Cons(h, □)⟧, take_drop(k, t))
      }
    }
  }

  pub theorem length_replicate<A: Type>(n: Nat, x: A): List::length(replicate(n, x)) = n {
    ⊢ List::length(replicate(n, x)) = n from match n {
      Zero => Refl
      Succ(k) => Eq::congr(Succ, length_replicate(k, x))
    }
  }

  pub theorem length_range(n: Nat): List::length(range(n)) = n {
    ⊢ List::length(range(n)) = n from match n {
      Zero => Refl
      Succ(k) => Eq::congr(Succ, Eq::trans(length_map(Succ, range(k)), length_range(k)))
    }
  }

  pub theorem foldr_append<A: Type, B: Type>(
    f: (A, B) -> B,
    z: B,
    l: List(A),
    m: List(A)
  ): foldr(f, z, List::append(l, m)) = foldr(f, foldr(f, z, m), l) {
    ⊢ foldr(f, z, List::append(l, m)) = foldr(f, foldr(f, z, m), l) from match l {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦f(h, □)⟧, foldr_append(f, z, t, m))
    }
  }

  pub theorem concat_append<A: Type>(
    ls: List(List(A)),
    ms: List(List(A))
  ): List::concat(List::append(ls, ms)) = List::append(List::concat(ls), List::concat(ms)) {
    ⊢ List::concat(
      List::append(ls, ms)
    ) = List::append(List::concat(ls), List::concat(ms)) from match ls {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        Eq::congr(⟦List::append(h, □)⟧, concat_append(t, ms)),
        Eq::sym(append_assoc(h, List::concat(t), List::concat(ms)))
      )
    }
  }

  pub theorem filter_append<A: Type>(
    p: (A) -> Bool,
    l: List(A),
    m: List(A)
  ): List::filter(p, List::append(l, m)) = List::append(List::filter(p, l), List::filter(p, m)) {
    ⊢ List::filter(
      p,
      List::append(l, m)
    ) = List::append(List::filter(p, l), List::filter(p, m)) from match l {
      Nil => Refl
      Cons(h, t) => ⊢ List::filter(
        p,
        List::append(Cons(h, t), m)
      ) = List::append(List::filter(p, Cons(h, t)), List::filter(p, m)) from match p(h) {
        false => ⊢ List::filter(
          p,
          List::append(t, m)
        ) = List::append(List::filter(p, t), List::filter(p, m)) from filter_append(p, t, m)
        true => ⊢ Cons(
          h,
          List::filter(p, List::append(t, m))
        ) = List::append(
          Cons(h, List::filter(p, t)),
          List::filter(p, m)
        ) from Eq::congr(⟦Cons(h, □)⟧, filter_append(p, t, m))
      }
    }
  }

  pub theorem take_drop_while<A: Type>(
    p: (A) -> Bool,
    l: List(A)
  ): List::append(take_while(p, l), drop_while(p, l)) = l {
    ⊢ List::append(take_while(p, l), drop_while(p, l)) = l from match l {
      Nil => Refl
      Cons(h, t) => ⊢ List::append(
        take_while(p, Cons(h, t)),
        drop_while(p, Cons(h, t))
      ) = Cons(h, t) from match p(h) {
        false => ⊢ List::append(Nil, Cons(h, t)) = Cons(h, t) from Refl
        true => ⊢ List::append(
          Cons(h, take_while(p, t)),
          drop_while(p, t)
        ) = Cons(h, t) from Eq::congr(⟦Cons(h, □)⟧, take_drop_while(p, t))
      }
    }
  }

  pub theorem length_zip_le<A: Type, B: Type>(
    l: List(A),
    m: List(B)
  ): List::length(List::zip(l, m)) <= List::length(l) = true {
    ⊢ List::length(List::zip(l, m)) <= List::length(l) = true from match l {
      Nil => Refl
      Cons(a, t) => ⊢ List::length(
        List::zip(Cons(a, t), m)
      ) <= List::length(Cons(a, t)) = true from match m {
        Nil => Refl
        Cons(b, u) => length_zip_le(t, u)
      }
    }
  }
}
