import "Base.taut"
import "Nat.taut"
import "Data.taut"

module List {
  // Lists beyond the basics of `Base.taut`: folds, searches, zips, and the
  // lemmas that relate them. Predicates are `(A) -> Bool`.

  pub fn filter<A>(p: (A) -> Bool, l: List(A)): List(A) {
    match l: List(A) {
      Nil => Nil
      Cons(h, t) => match p(h): List(A) {
        false => filter(p, t)
        true => Cons(h, filter(p, t))
      }
    }
  }

  pub fn foldr<A, B>(f: (A, B) -> B, z: B, l: List(A)): B {
    match l: B {
      Nil => z
      Cons(h, t) => f(h, foldr(f, z, t))
    }
  }

  // Folds from the left: `f(f(f(z, a), b), c)` for `[a, b, c]`.
  pub fn foldl<A, B>(f: (B, A) -> B, z: B, l: List(A)): B {
    foldr((a: A, acc: B) => f(acc, a), z, reverse(l))
  }

  pub fn any<A>(p: (A) -> Bool, l: List(A)): Bool {
    match l: Bool {
      Nil => false
      Cons(h, t) => p(h) || any(p, t)
    }
  }

  pub fn all<A>(p: (A) -> Bool, l: List(A)): Bool {
    match l: Bool {
      Nil => true
      Cons(h, t) => p(h) && all(p, t)
    }
  }

  pub fn find<A>(p: (A) -> Bool, l: List(A)): Option(A) {
    match l: Option(A) {
      Nil => None
      Cons(h, t) => match p(h): Option(A) {
        false => find(p, t)
        true => Some(h)
      }
    }
  }

  // Membership by a decision `eq` on the elements.
  pub fn contains<A>(eq: (A, A) -> Bool, x: A, l: List(A)): Bool {
    any((y: A) => eq(x, y), l)
  }

  pub fn replicate<A>(n: Nat, x: A): List(A) {
    match n: List(A) {
      Zero => Nil
      Succ(k) => Cons(x, replicate(k, x))
    }
  }

  pub fn range(n: Nat): List(Nat) {
    match n: List(Nat) {
      Zero => Nil
      Succ(k) => Cons(Zero, map(Succ, range(k)))
    }
  }

  pub fn range_from(start: Nat, n: Nat): List(Nat) {
    map((i: Nat) => Nat::add(start, i), range(n))
  }

  pub fn head<A>(l: List(A)): Option(A) {
    match l: Option(A) {
      Nil => None
      Cons(h, t) => Some(h)
    }
  }

  pub fn tail<A>(l: List(A)): List(A) {
    match l: List(A) {
      Nil => Nil
      Cons(h, t) => t
    }
  }

  pub fn last<A>(l: List(A)): Option(A) {
    match l: Option(A) {
      Nil => None
      Cons(h, t) => match t: Option(A) {
        Nil => Some(h)
        Cons(h2, t2) => last(t)
      }
    }
  }

  pub fn concat<A>(ls: List(List(A))): List(A) {
    match ls: List(A) {
      Nil => Nil
      Cons(h, t) => append(h, concat(t))
    }
  }

  pub fn take_while<A>(p: (A) -> Bool, l: List(A)): List(A) {
    match l: List(A) {
      Nil => Nil
      Cons(h, t) => match p(h): List(A) {
        false => Nil
        true => Cons(h, take_while(p, t))
      }
    }
  }

  pub fn drop_while<A>(p: (A) -> Bool, l: List(A)): List(A) {
    match l: List(A) {
      Nil => Nil
      Cons(h, t) => match p(h): List(A) {
        false => l
        true => drop_while(p, t)
      }
    }
  }

  // Pairs up to the shorter of the two lists.
  pub fn zip<A, B>(l: List(A), m: List(B)): List(A × B) {
    match l: List(A × B) {
      Nil => Nil
      Cons(a, t) => match m: List(A × B) {
        Nil => Nil
        Cons(b, u) => Cons(#(a, b), zip(t, u))
      }
    }
  }

  pub fn unzip<A, B>(l: List(Pair(A, B))): Pair(List(A), List(B)) {
    Pair {
      fst: map((p: Pair(A, B)) => match p: A { Pair { fst: a, snd: _ } => a }, l),
      snd: map((p: Pair(A, B)) => match p: B { Pair { fst: _, snd: b } => b }, l)
    }
  }

  pub theorem append_nil<A: Type>(l: List(A)): append(l, Nil) = l {
    match l: append(l, Nil) = l {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(h, □)⟧, append_nil(t))
    }
  }

  pub theorem length_append<A: Type>(
    l: List(A),
    m: List(A)
  ): length(append(l, m)) = Nat::add(length(l), length(m)) {
    match l: length(append(l, m)) = Nat::add(length(l), length(m)) {
      Nil => Eq::sym(Nat::add_zero_left(length(m)))
      Cons(h, t) => Eq::trans(
        Eq::congr(Succ, length_append(t, m)),
        Eq::sym(Nat::add_succ_left(length(t), length(m)))
      )
    }
  }

  pub theorem length_map<A: Type, B: Type>(f: (A) -> B, l: List(A)): length(map(f, l)) = length(l) {
    match l: length(map(f, l)) = length(l) {
      Nil => Refl
      Cons(h, t) => Eq::congr(Succ, length_map(f, t))
    }
  }

  pub theorem map_append<A: Type, B: Type>(
    f: (A) -> B,
    l: List(A),
    m: List(A)
  ): map(f, append(l, m)) = append(map(f, l), map(f, m)) {
    match l: map(f, append(l, m)) = append(map(f, l), map(f, m)) {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(f(h), □)⟧, map_append(f, t, m))
    }
  }

  pub theorem map_map<A: Type, B: Type, C: Type>(
    f: (A) -> B,
    g: (B) -> C,
    l: List(A)
  ): map(g, map(f, l)) = map((x: A) => g(f(x)), l) {
    match l: map(g, map(f, l)) = map((x: A) => g(f(x)), l) {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(g(f(h)), □)⟧, map_map(f, g, t))
    }
  }

  pub theorem map_id<A: Type>(l: List(A)): map((x: A) => x, l) = l {
    match l: map((x: A) => x, l) = l {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦Cons(h, □)⟧, map_id(t))
    }
  }

  pub theorem reverse_onto_append<A: Type>(
    l: List(A),
    acc: List(A)
  ): reverse_onto(l, acc) = append(reverse(l), acc) {
    match l: reverse_onto(l, acc) = append(reverse(l), acc) {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        reverse_onto_append(t, Cons(h, acc)),
        Eq::sym(
          Eq::trans(
            Eq::congr(⟦append(□, acc)⟧, reverse_onto_append(t, Cons(h, Nil))),
            append_assoc(reverse(t), Cons(h, Nil), acc)
          )
        )
      )
    }
  }

  pub theorem reverse_cons<A: Type>(
    h: A,
    t: List(A)
  ): reverse(Cons(h, t)) = append(reverse(t), Cons(h, Nil)) {
    reverse_onto_append(t, Cons(h, Nil))
  }

  pub theorem reverse_append<A: Type>(
    l: List(A),
    m: List(A)
  ): reverse(append(l, m)) = append(reverse(m), reverse(l)) {
    match l: reverse(append(l, m)) = append(reverse(m), reverse(l)) {
      Nil => Eq::sym(append_nil(reverse(m)))
      Cons(h, t) => Eq::trans(
        reverse_cons(h, append(t, m)),
        Eq::trans(
          Eq::congr(⟦append(□, Cons(h, Nil))⟧, reverse_append(t, m)),
          Eq::trans(
            append_assoc(reverse(m), reverse(t), Cons(h, Nil)),
            Eq::congr(⟦append(reverse(m), □)⟧, Eq::sym(reverse_cons(h, t)))
          )
        )
      )
    }
  }

  pub theorem reverse_reverse<A: Type>(l: List(A)): reverse(reverse(l)) = l {
    match l: reverse(reverse(l)) = l {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        Eq::congr(⟦reverse(□)⟧, reverse_cons(h, t)),
        Eq::trans(
          reverse_append(reverse(t), Cons(h, Nil)),
          Eq::congr(⟦Cons(h, □)⟧, reverse_reverse(t))
        )
      )
    }
  }

  pub theorem length_reverse<A: Type>(l: List(A)): length(reverse(l)) = length(l) {
    match l: length(reverse(l)) = length(l) {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        Eq::congr(⟦length(□)⟧, reverse_cons(h, t)),
        Eq::trans(length_append(reverse(t), Cons(h, Nil)), Eq::congr(Succ, length_reverse(t)))
      )
    }
  }

  pub theorem take_drop<A: Type>(n: Nat, l: List(A)): append(take(n, l), drop(n, l)) = l {
    match n: append(take(n, l), drop(n, l)) = l {
      Zero => Refl
      Succ(k) => match l: append(take(Succ(k), l), drop(Succ(k), l)) = l {
        Nil => Refl
        Cons(h, t) => Eq::congr(⟦Cons(h, □)⟧, take_drop(k, t))
      }
    }
  }

  pub theorem length_replicate<A: Type>(n: Nat, x: A): length(replicate(n, x)) = n {
    match n: length(replicate(n, x)) = n {
      Zero => Refl
      Succ(k) => Eq::congr(Succ, length_replicate(k, x))
    }
  }

  pub theorem length_range(n: Nat): length(range(n)) = n {
    match n: length(range(n)) = n {
      Zero => Refl
      Succ(k) => Eq::congr(Succ, Eq::trans(length_map(Succ, range(k)), length_range(k)))
    }
  }

  pub theorem foldr_append<A: Type, B: Type>(
    f: (A, B) -> B,
    z: B,
    l: List(A),
    m: List(A)
  ): foldr(f, z, append(l, m)) = foldr(f, foldr(f, z, m), l) {
    match l: foldr(f, z, append(l, m)) = foldr(f, foldr(f, z, m), l) {
      Nil => Refl
      Cons(h, t) => Eq::congr(⟦f(h, □)⟧, foldr_append(f, z, t, m))
    }
  }

  pub theorem concat_append<A: Type>(
    ls: List(List(A)),
    ms: List(List(A))
  ): concat(append(ls, ms)) = append(concat(ls), concat(ms)) {
    match ls: concat(append(ls, ms)) = append(concat(ls), concat(ms)) {
      Nil => Refl
      Cons(h, t) => Eq::trans(
        Eq::congr(⟦append(h, □)⟧, concat_append(t, ms)),
        Eq::sym(append_assoc(h, concat(t), concat(ms)))
      )
    }
  }

  pub theorem filter_append<A: Type>(
    p: (A) -> Bool,
    l: List(A),
    m: List(A)
  ): filter(p, append(l, m)) = append(filter(p, l), filter(p, m)) {
    match l: filter(p, append(l, m)) = append(filter(p, l), filter(p, m)) {
      Nil => Refl
      Cons(h, t) => match p(
        h
      ): filter(p, append(Cons(h, t), m)) = append(filter(p, Cons(h, t)), filter(p, m)) {
        false => ⊢ filter(
          p,
          append(t, m)
        ) = append(filter(p, t), filter(p, m)) from filter_append(p, t, m)
        true => ⊢ Cons(
          h,
          filter(p, append(t, m))
        ) = append(
          Cons(h, filter(p, t)),
          filter(p, m)
        ) from Eq::congr(⟦Cons(h, □)⟧, filter_append(p, t, m))
      }
    }
  }

  pub theorem take_drop_while<A: Type>(
    p: (A) -> Bool,
    l: List(A)
  ): append(take_while(p, l), drop_while(p, l)) = l {
    match l: append(take_while(p, l), drop_while(p, l)) = l {
      Nil => Refl
      Cons(h, t) => match p(
        h
      ): append(take_while(p, Cons(h, t)), drop_while(p, Cons(h, t))) = Cons(h, t) {
        false => ⊢ append(Nil, Cons(h, t)) = Cons(h, t) from Refl
        true => ⊢ append(
          Cons(h, take_while(p, t)),
          drop_while(p, t)
        ) = Cons(h, t) from Eq::congr(⟦Cons(h, □)⟧, take_drop_while(p, t))
      }
    }
  }

  pub theorem length_zip_le<A: Type, B: Type>(
    l: List(A),
    m: List(B)
  ): length(zip(l, m)) <= length(l) = true {
    match l: length(zip(l, m)) <= length(l) = true {
      Nil => Refl
      Cons(a, t) => match m: length(zip(Cons(a, t), m)) <= length(Cons(a, t)) = true {
        Nil => Refl
        Cons(b, u) => length_zip_le(t, u)
      }
    }
  }
}
