import "Base.taut" { List, Nat, Ordering }
import "Map.taut" { Ordmap, OrdmapTree }
import std::prelude::Ord {
  equal_ne_greater,
  equal_ne_less,
  greater_ne_equal,
  greater_ne_less,
  less_ne_equal,
  less_ne_greater
}
import std::prelude::Std { List, Option, Ordering }

// What the ordered map does, proved (`docs/design/self-host.md`): a map's tree is
// read through its entries in order (`Ordmap::tree_entries`), and for a
// comparator that is a total order:
//
// * `Ordmap::get` is the first entry with the key, in a sorted list;
// * `Ordmap::insert` is the insertion into that sorted list;
// * so the entries stay sorted, `Ordmap::get` finds what was inserted, and
//   the other keys keep their values.
//
// No program imports this file; `tauto check` checks it.

// A comparator that is a total order. `equal` is equality.
pub(open) inductive OrdmapLaw(K: Type, cmp: (K, K) -> Ordering): Prop {
  Mk(
    same: ∀ a: K. cmp(a, a) = Equal,
    equal_is_eq: ∀ a: K, b: K. (cmp(a, b) = Equal) -> (a = b),
    flip_less: ∀ a: K, b: K. (cmp(a, b) = Less) -> (cmp(b, a) = Greater),
    flip_greater: ∀ a: K, b: K. (cmp(a, b) = Greater) -> (cmp(b, a) = Less),
    less_trans: ∀ a: K, b: K, c: K. (cmp(a, b) = Less) -> (cmp(b, c) = Less) -> (cmp(a, c) = Less)
  ): OrdmapLaw(K, cmp)
}

module Ordmap {
  pub theorem law_same<K: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    a: K
  ): cmp(a, a) = Equal {
    ⊢ cmp(a, a) = Equal from match w {
      Mk(s, _, _, _, _) => s(a)
    }
  }

  pub theorem law_eq<K: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    a: K,
    b: K,
    e: cmp(a, b) = Equal
  ): a = b {
    ⊢ a = b from match w {
      Mk(_, q, _, _, _) => q(a, b, e)
    }
  }

  pub theorem law_flip_less<K: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    a: K,
    b: K,
    e: cmp(a, b) = Less
  ): cmp(b, a) = Greater {
    ⊢ cmp(b, a) = Greater from match w {
      Mk(_, _, fl, _, _) => fl(a, b, e)
    }
  }

  pub theorem law_flip_greater<K: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    a: K,
    b: K,
    e: cmp(a, b) = Greater
  ): cmp(b, a) = Less {
    ⊢ cmp(b, a) = Less from match w {
      Mk(_, _, _, fg, _) => fg(a, b, e)
    }
  }

  pub theorem law_less_trans<K: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    a: K,
    b: K,
    c: K,
    e1: cmp(a, b) = Less,
    e2: cmp(b, c) = Less
  ): cmp(a, c) = Less {
    ⊢ cmp(a, c) = Less from match w {
      Mk(_, _, _, _, t) => t(a, b, c, e1, e2)
    }
  }

  pub theorem law_greater_trans<K: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    a: K,
    b: K,
    c: K,
    e1: cmp(a, b) = Greater,
    e2: cmp(b, c) = Greater
  ): cmp(a, c) = Greater {
    law_flip_less(
      cmp,
      w,
      c,
      a,
      law_less_trans(
        cmp,
        w,
        c,
        b,
        a,
        law_flip_greater(cmp, w, b, c, e2),
        law_flip_greater(cmp, w, a, b, e1)
      )
    )
  }

  // The entries in a list: the value of the first entry with the key.
  pub fn list_get<K, V>(es: List(K × V), k: K, cmp: (K, K) -> Ordering): Option(V) {
    ⊢ Option(V) from match es {
      Nil => None
      Cons(e, rest) => ⊢ Option(V) from match e {
        #(ek, ev) => ⊢ Option(V) from match cmp(k, ek) {
          Less => list_get(rest, k, cmp)
          Equal => Some(ev)
          Greater => list_get(rest, k, cmp)
        }
      }
    }
  }

  // `es` with `v` at `k`: before the first key after `k`, or in place of `k`.
  pub fn list_insert<K, V>(es: List(K × V), k: K, v: V, cmp: (K, K) -> Ordering): List(K × V) {
    ⊢ List(K × V) from match es {
      Nil => Cons(#(k, v), Nil)
      Cons(e, rest) => ⊢ List(K × V) from match e {
        #(ek, ev) => ⊢ List(K × V) from match cmp(k, ek) {
          Less => Cons(#(k, v), Cons(#(ek, ev), rest))
          Equal => Cons(#(k, v), rest)
          Greater => Cons(#(ek, ev), list_insert(rest, k, v, cmp))
        }
      }
    }
  }

  // `cmp(k, ek)` is `o` for every key `ek` of `es`.
  pub fn keys<K, V>(es: List(K × V), k: K, o: Ordering, cmp: (K, K) -> Ordering): Prop {
    ⊢ Prop from match es {
      Nil => True
      Cons(e, rest) => ⊢ Prop from match e {
        #(ek, ev) => cmp(k, ek) = o ∧ keys(rest, k, o, cmp)
      }
    }
  }

  // Every key is before the keys after it.
  pub fn sorted<K, V>(es: List(K × V), cmp: (K, K) -> Ordering): Prop {
    ⊢ Prop from match es {
      Nil => True
      Cons(e, rest) => ⊢ Prop from match e {
        #(ek, ev) => keys(rest, ek, Less, cmp) ∧ sorted(rest, cmp)
      }
    }
  }

  // The steps of `list_get` and `list_insert`, one comparison
  // each.

  pub theorem list_get_equal<K: Type, V: Type>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = Equal
  ): list_get(Cons(#(ek, ev), rest), k, cmp) = Some(ev) {
    Ordering::cases(
      (x: Ordering) => (⊢ Option(V) from match x {
        Less => list_get(rest, k, cmp)
        Equal => Some(ev)
        Greater => list_get(rest, k, cmp)
      }) = Some(ev),
      cmp(k, ek),
      (h: cmp(k, ek) = Less) => False::elim(less_ne_equal(Eq::trans(Eq::sym(h), e))),
      (h: cmp(k, ek) = Equal) => Refl,
      (h: cmp(k, ek) = Greater) => False::elim(greater_ne_equal(Eq::trans(Eq::sym(h), e)))
    )
  }

  pub theorem list_get_skip<K: Type, V: Type>(
    o: Ordering,
    ne: ¬(o = Equal),
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = o
  ): list_get(Cons(#(ek, ev), rest), k, cmp) = list_get(rest, k, cmp) {
    Ordering::cases(
      (x: Ordering) => (⊢ Option(V) from match x {
        Less => list_get(rest, k, cmp)
        Equal => Some(ev)
        Greater => list_get(rest, k, cmp)
      }) = list_get(rest, k, cmp),
      cmp(k, ek),
      (h: cmp(k, ek) = Less) => Refl,
      (h: cmp(k, ek) = Equal) => False::elim(ne(Eq::trans(Eq::sym(e), h))),
      (h: cmp(k, ek) = Greater) => Refl
    )
  }

  pub theorem list_insert_less<K: Type, V: Type>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    v: V,
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = Less
  ): list_insert(Cons(#(ek, ev), rest), k, v, cmp) = Cons(#(k, v), Cons(#(ek, ev), rest)) {
    Ordering::cases(
      (x: Ordering) => (⊢ List(K × V) from match x {
        Less => Cons(#(k, v), Cons(#(ek, ev), rest))
        Equal => Cons(#(k, v), rest)
        Greater => Cons(#(ek, ev), list_insert(rest, k, v, cmp))
      }) = Cons(#(k, v), Cons(#(ek, ev), rest)),
      cmp(k, ek),
      (h: cmp(k, ek) = Less) => Refl,
      (h: cmp(k, ek) = Equal) => False::elim(equal_ne_less(Eq::trans(Eq::sym(h), e))),
      (h: cmp(k, ek) = Greater) => False::elim(greater_ne_less(Eq::trans(Eq::sym(h), e)))
    )
  }

  pub theorem list_insert_equal<K: Type, V: Type>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    v: V,
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = Equal
  ): list_insert(Cons(#(ek, ev), rest), k, v, cmp) = Cons(#(k, v), rest) {
    Ordering::cases(
      (x: Ordering) => (⊢ List(K × V) from match x {
        Less => Cons(#(k, v), Cons(#(ek, ev), rest))
        Equal => Cons(#(k, v), rest)
        Greater => Cons(#(ek, ev), list_insert(rest, k, v, cmp))
      }) = Cons(#(k, v), rest),
      cmp(k, ek),
      (h: cmp(k, ek) = Less) => False::elim(less_ne_equal(Eq::trans(Eq::sym(h), e))),
      (h: cmp(k, ek) = Equal) => Refl,
      (h: cmp(k, ek) = Greater) => False::elim(greater_ne_equal(Eq::trans(Eq::sym(h), e)))
    )
  }

  pub theorem list_insert_greater<K: Type, V: Type>(
    ek: K,
    ev: V,
    rest: List(K × V),
    k: K,
    v: V,
    cmp: (K, K) -> Ordering,
    e: cmp(k, ek) = Greater
  ): list_insert(Cons(#(ek, ev), rest), k, v, cmp) = Cons(#(ek, ev), list_insert(rest, k, v, cmp)) {
    Ordering::cases(
      (x: Ordering) => (⊢ List(K × V) from match x {
        Less => Cons(#(k, v), Cons(#(ek, ev), rest))
        Equal => Cons(#(k, v), rest)
        Greater => Cons(#(ek, ev), list_insert(rest, k, v, cmp))
      }) = Cons(#(ek, ev), list_insert(rest, k, v, cmp)),
      cmp(k, ek),
      (h: cmp(k, ek) = Less) => False::elim(less_ne_greater(Eq::trans(Eq::sym(h), e))),
      (h: cmp(k, ek) = Equal) => False::elim(equal_ne_greater(Eq::trans(Eq::sym(h), e))),
      (h: cmp(k, ek) = Greater) => Refl
    )
  }

  pub theorem entries_append<K: Type, V: Type>(
    t: OrdmapTree(K, V),
    d: List(K × V)
  ): tree_entries(t, d) = List::append(tree_entries(t, Nil), d) {
    ⊢ tree_entries(t, d) = List::append(tree_entries(t, Nil), d) from match t {
      OrdmapLeaf => Refl
      OrdmapNode(l, k, v, r, h) => Eq::trans(
        Eq::trans(
          entries_append(l, Cons(#(k, v), tree_entries(r, d))),
          Eq::congr(⟦List::append(tree_entries(l, Nil), Cons(#(k, v), □))⟧, entries_append(r, d))
        ),
        Eq::sym(
          Eq::trans(
            Eq::congr(⟦List::append(□, d)⟧, entries_append(l, Cons(#(k, v), tree_entries(r, Nil)))),
            List::append_assoc(tree_entries(l, Nil), Cons(#(k, v), tree_entries(r, Nil)), d)
          )
        )
      )
    }
  }

  pub theorem keys_append_left<K: Type, V: Type>(
    a: List(K × V),
    b: List(K × V),
    x: K,
    o: Ordering,
    cmp: (K, K) -> Ordering,
    h: keys(List::append(a, b), x, o, cmp)
  ): keys(a, x, o, cmp) {
    ⊢ keys(a, x, o, cmp) from match a {
      Nil => Trivial
      Cons(e, rest) => match e {
        #(ek, ev) => AndIntro(And::left(h), keys_append_left(rest, b, x, o, cmp, And::right(h)))
      }
    }
  }

  pub theorem keys_append_right<K: Type, V: Type>(
    a: List(K × V),
    b: List(K × V),
    x: K,
    o: Ordering,
    cmp: (K, K) -> Ordering,
    h: keys(List::append(a, b), x, o, cmp)
  ): keys(b, x, o, cmp) {
    ⊢ keys(b, x, o, cmp) from match a {
      Nil => h
      Cons(e, rest) => match e {
        #(ek, ev) => keys_append_right(rest, b, x, o, cmp, And::right(h))
      }
    }
  }

  pub theorem keys_less_trans<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    ys: List(K × V),
    a: K,
    b: K,
    e: cmp(b, a) = Less,
    h: keys(ys, a, Less, cmp)
  ): keys(ys, b, Less, cmp) {
    ⊢ keys(ys, b, Less, cmp) from match ys {
      Nil => Trivial
      Cons(y, rest) => match y {
        #(yk, yv) => AndIntro(
          law_less_trans(cmp, w, b, a, yk, e, And::left(h)),
          keys_less_trans(cmp, w, rest, a, b, e, And::right(h))
        )
      }
    }
  }

  pub theorem keys_greater_trans<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    ys: List(K × V),
    a: K,
    b: K,
    e: cmp(b, a) = Greater,
    h: keys(ys, a, Greater, cmp)
  ): keys(ys, b, Greater, cmp) {
    ⊢ keys(ys, b, Greater, cmp) from match ys {
      Nil => Trivial
      Cons(y, rest) => match y {
        #(yk, yv) => AndIntro(
          law_greater_trans(cmp, w, b, a, yk, e, And::left(h)),
          keys_greater_trans(cmp, w, rest, a, b, e, And::right(h))
        )
      }
    }
  }

  pub theorem keys_eq<K: Type, V: Type>(
    ys: List(K × V),
    a: K,
    b: K,
    e: a = b,
    o: Ordering,
    cmp: (K, K) -> Ordering,
    h: keys(ys, a, o, cmp)
  ): keys(ys, b, o, cmp) {
    Eq::subst((z: K) => keys(ys, z, o, cmp), e, h)
  }

  // A sorted list with `nk` in it: the keys before are before `nk`, the keys
  // after are after it, and both sides are sorted.
  pub theorem sorted_split<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    xs: List(K × V),
    nk: K,
    nv: V,
    ys: List(K × V),
    h: sorted(List::append(xs, Cons(#(nk, nv), ys)), cmp)
  ): keys(xs, nk, Greater, cmp) ∧ sorted(xs, cmp) ∧ keys(ys, nk, Less, cmp) ∧ sorted(ys, cmp) {
    ⊢ keys(
      xs,
      nk,
      Greater,
      cmp
    ) ∧ sorted(xs, cmp) ∧ keys(ys, nk, Less, cmp) ∧ sorted(ys, cmp) from match xs {
      Nil => AndIntro(Trivial, AndIntro(Trivial, h))
      Cons(x, rest) => match x {
        #(xk, xv) => AndIntro(
          AndIntro(
            law_flip_less(
              cmp,
              w,
              xk,
              nk,
              And::left(keys_append_right(rest, Cons(#(nk, nv), ys), xk, Less, cmp, And::left(h)))
            ),
            And::left(sorted_split(cmp, w, rest, nk, nv, ys, And::right(h)))
          ),
          AndIntro(
            AndIntro(
              keys_append_left(rest, Cons(#(nk, nv), ys), xk, Less, cmp, And::left(h)),
              And::left(And::right(sorted_split(cmp, w, rest, nk, nv, ys, And::right(h))))
            ),
            And::right(And::right(sorted_split(cmp, w, rest, nk, nv, ys, And::right(h))))
          )
        )
      }
    }
  }

  pub theorem list_get_keys_none<K: Type, V: Type>(
    k: K,
    o: Ordering,
    ne: ¬(o = Equal),
    ys: List(K × V),
    cmp: (K, K) -> Ordering,
    h: keys(ys, k, o, cmp)
  ): list_get(ys, k, cmp) = None {
    ⊢ list_get(ys, k, cmp) = None from match ys {
      Nil => Refl
      Cons(y, rest) => match y {
        #(yk, yv) => Eq::trans(
          list_get_skip(o, ne, yk, yv, rest, k, cmp, And::left(h)),
          list_get_keys_none(k, o, ne, rest, cmp, And::right(h))
        )
      }
    }
  }

  pub theorem list_get_append_none<K: Type, V: Type>(
    xs: List(K × V),
    ys: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    n: list_get(ys, k, cmp) = None
  ): list_get(List::append(xs, ys), k, cmp) = list_get(xs, k, cmp) {
    ⊢ list_get(List::append(xs, ys), k, cmp) = list_get(xs, k, cmp) from match xs {
      Nil => n
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => (⊢ Option(V) from match c {
            Less => list_get(List::append(rest, ys), k, cmp)
            Equal => Some(xv)
            Greater => list_get(List::append(rest, ys), k, cmp)
          }) = (⊢ Option(V) from match c {
            Less => list_get(rest, k, cmp)
            Equal => Some(xv)
            Greater => list_get(rest, k, cmp)
          }),
          cmp(k, xk),
          (e: cmp(k, xk) = Less) => list_get_append_none(rest, ys, k, cmp, n),
          (e: cmp(k, xk) = Equal) => Refl,
          (e: cmp(k, xk) = Greater) => list_get_append_none(rest, ys, k, cmp, n)
        )
      }
    }
  }

  pub theorem list_get_append_skip<K: Type, V: Type>(
    o: Ordering,
    ne: ¬(o = Equal),
    xs: List(K × V),
    ys: List(K × V),
    k: K,
    cmp: (K, K) -> Ordering,
    h: keys(xs, k, o, cmp)
  ): list_get(List::append(xs, ys), k, cmp) = list_get(ys, k, cmp) {
    ⊢ list_get(List::append(xs, ys), k, cmp) = list_get(ys, k, cmp) from match xs {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Eq::trans(
          list_get_skip(o, ne, xk, xv, List::append(rest, ys), k, cmp, And::left(h)),
          list_get_append_skip(o, ne, rest, ys, k, cmp, And::right(h))
        )
      }
    }
  }

  pub theorem list_get_cons_congr<K: Type, V: Type>(
    xk: K,
    xv: V,
    a: List(K × V),
    b: List(K × V),
    j: K,
    cmp: (K, K) -> Ordering,
    e: list_get(a, j, cmp) = list_get(b, j, cmp)
  ): list_get(Cons(#(xk, xv), a), j, cmp) = list_get(Cons(#(xk, xv), b), j, cmp) {
    Ordering::cases(
      (c: Ordering) => (⊢ Option(V) from match c {
        Less => list_get(a, j, cmp)
        Equal => Some(xv)
        Greater => list_get(a, j, cmp)
      }) = (⊢ Option(V) from match c {
        Less => list_get(b, j, cmp)
        Equal => Some(xv)
        Greater => list_get(b, j, cmp)
      }),
      cmp(j, xk),
      (q: cmp(j, xk) = Less) => e,
      (q: cmp(j, xk) = Equal) => Refl,
      (q: cmp(j, xk) = Greater) => e
    )
  }

  pub theorem list_insert_append_less<K: Type, V: Type>(
    xs: List(K × V),
    nk: K,
    nv: V,
    ys: List(K × V),
    k: K,
    v: V,
    cmp: (K, K) -> Ordering,
    e: cmp(k, nk) = Less
  ): list_insert(
    List::append(xs, Cons(#(nk, nv), ys)),
    k,
    v,
    cmp
  ) = List::append(list_insert(xs, k, v, cmp), Cons(#(nk, nv), ys)) {
    ⊢ list_insert(
      List::append(xs, Cons(#(nk, nv), ys)),
      k,
      v,
      cmp
    ) = List::append(list_insert(xs, k, v, cmp), Cons(#(nk, nv), ys)) from match xs {
      Nil => list_insert_less(nk, nv, ys, k, v, cmp, e)
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => (⊢ List(K × V) from match c {
            Less => Cons(#(k, v), Cons(#(xk, xv), List::append(rest, Cons(#(nk, nv), ys))))
            Equal => Cons(#(k, v), List::append(rest, Cons(#(nk, nv), ys)))
            Greater => Cons(
              #(xk, xv),
              list_insert(List::append(rest, Cons(#(nk, nv), ys)), k, v, cmp)
            )
          }) = List::append(⊢ List(K × V) from match c {
            Less => Cons(#(k, v), Cons(#(xk, xv), rest))
            Equal => Cons(#(k, v), rest)
            Greater => Cons(#(xk, xv), list_insert(rest, k, v, cmp))
          }, Cons(#(nk, nv), ys)),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => Refl,
          (q: cmp(k, xk) = Equal) => Refl,
          (q: cmp(k, xk) = Greater) => Eq::congr(
            ⟦Cons(#(xk, xv), □)⟧,
            list_insert_append_less(rest, nk, nv, ys, k, v, cmp, e)
          )
        )
      }
    }
  }

  pub theorem list_insert_append_skip<K: Type, V: Type>(
    xs: List(K × V),
    ys: List(K × V),
    k: K,
    v: V,
    cmp: (K, K) -> Ordering,
    h: keys(xs, k, Greater, cmp)
  ): list_insert(List::append(xs, ys), k, v, cmp) = List::append(xs, list_insert(ys, k, v, cmp)) {
    ⊢ list_insert(
      List::append(xs, ys),
      k,
      v,
      cmp
    ) = List::append(xs, list_insert(ys, k, v, cmp)) from match xs {
      Nil => Refl
      Cons(x, rest) => match x {
        #(xk, xv) => Eq::trans(
          list_insert_greater(xk, xv, List::append(rest, ys), k, v, cmp, And::left(h)),
          Eq::congr(
            ⟦Cons(#(xk, xv), □)⟧,
            list_insert_append_skip(rest, ys, k, v, cmp, And::right(h))
          )
        )
      }
    }
  }

  pub theorem keys_insert<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    es: List(K × V),
    a: K,
    k: K,
    v: V,
    ea: cmp(a, k) = Less,
    h: keys(es, a, Less, cmp)
  ): keys(list_insert(es, k, v, cmp), a, Less, cmp) {
    ⊢ keys(list_insert(es, k, v, cmp), a, Less, cmp) from match es {
      Nil => AndIntro(ea, Trivial)
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => keys(⊢ List(K × V) from match c {
            Less => Cons(#(k, v), Cons(#(xk, xv), rest))
            Equal => Cons(#(k, v), rest)
            Greater => Cons(#(xk, xv), list_insert(rest, k, v, cmp))
          }, a, Less, cmp),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => AndIntro(ea, h),
          (q: cmp(k, xk) = Equal) => AndIntro(ea, And::right(h)),
          (q: cmp(k, xk) = Greater) => AndIntro(
            And::left(h),
            keys_insert(cmp, w, rest, a, k, v, ea, And::right(h))
          )
        )
      }
    }
  }

  pub theorem list_insert_sorted<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    es: List(K × V),
    k: K,
    v: V,
    h: sorted(es, cmp)
  ): sorted(list_insert(es, k, v, cmp), cmp) {
    ⊢ sorted(list_insert(es, k, v, cmp), cmp) from match es {
      Nil => AndIntro(Trivial, Trivial)
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => sorted(⊢ List(K × V) from match c {
            Less => Cons(#(k, v), Cons(#(xk, xv), rest))
            Equal => Cons(#(k, v), rest)
            Greater => Cons(#(xk, xv), list_insert(rest, k, v, cmp))
          }, cmp),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => AndIntro(
            AndIntro(q, keys_less_trans(cmp, w, rest, xk, k, q, And::left(h))),
            h
          ),
          (q: cmp(k, xk) = Equal) => AndIntro(
            keys_eq(rest, xk, k, Eq::sym(law_eq(cmp, w, k, xk, q)), Less, cmp, And::left(h)),
            And::right(h)
          ),
          (q: cmp(k, xk) = Greater) => AndIntro(
            keys_insert(
              cmp,
              w,
              rest,
              xk,
              k,
              v,
              law_flip_greater(cmp, w, k, xk, q),
              And::left(h)
            ),
            list_insert_sorted(cmp, w, rest, k, v, And::right(h))
          )
        )
      }
    }
  }

  pub theorem list_get_insert_same<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    es: List(K × V),
    k: K,
    v: V
  ): list_get(list_insert(es, k, v, cmp), k, cmp) = Some(v) {
    ⊢ list_get(list_insert(es, k, v, cmp), k, cmp) = Some(v) from match es {
      Nil => list_get_equal(k, v, Nil, k, cmp, law_same(cmp, w, k))
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => list_get(⊢ List(K × V) from match c {
            Less => Cons(#(k, v), Cons(#(xk, xv), rest))
            Equal => Cons(#(k, v), rest)
            Greater => Cons(#(xk, xv), list_insert(rest, k, v, cmp))
          }, k, cmp) = Some(v),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => list_get_equal(
            k,
            v,
            Cons(#(xk, xv), rest),
            k,
            cmp,
            law_same(cmp, w, k)
          ),
          (q: cmp(k, xk) = Equal) => list_get_equal(k, v, rest, k, cmp, law_same(cmp, w, k)),
          (q: cmp(k, xk) = Greater) => Eq::trans(
            list_get_skip(
              Greater,
              greater_ne_equal,
              xk,
              xv,
              list_insert(rest, k, v, cmp),
              k,
              cmp,
              q
            ),
            list_get_insert_same(cmp, w, rest, k, v)
          )
        )
      }
    }
  }

  pub theorem list_get_insert_other<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    es: List(K × V),
    k: K,
    v: V,
    j: K,
    o: Ordering,
    ne: ¬(o = Equal),
    ej: cmp(j, k) = o
  ): list_get(list_insert(es, k, v, cmp), j, cmp) = list_get(es, j, cmp) {
    ⊢ list_get(list_insert(es, k, v, cmp), j, cmp) = list_get(es, j, cmp) from match es {
      Nil => list_get_skip(o, ne, k, v, Nil, j, cmp, ej)
      Cons(x, rest) => match x {
        #(xk, xv) => Ordering::cases(
          (c: Ordering) => list_get(⊢ List(K × V) from match c {
            Less => Cons(#(k, v), Cons(#(xk, xv), rest))
            Equal => Cons(#(k, v), rest)
            Greater => Cons(#(xk, xv), list_insert(rest, k, v, cmp))
          }, j, cmp) = list_get(Cons(#(xk, xv), rest), j, cmp),
          cmp(k, xk),
          (q: cmp(k, xk) = Less) => list_get_skip(o, ne, k, v, Cons(#(xk, xv), rest), j, cmp, ej),
          (q: cmp(k, xk) = Equal) => Eq::trans(
            list_get_skip(o, ne, k, v, rest, j, cmp, ej),
            Eq::sym(
              list_get_skip(
                o,
                ne,
                xk,
                xv,
                rest,
                j,
                cmp,
                Eq::subst((z: K) => cmp(j, z) = o, law_eq(cmp, w, k, xk, q), ej)
              )
            )
          ),
          (q: cmp(k, xk) = Greater) => list_get_cons_congr(
            xk,
            xv,
            list_insert(rest, k, v, cmp),
            rest,
            j,
            cmp,
            list_get_insert_other(cmp, w, rest, k, v, j, o, ne, ej)
          )
        )
      }
    }
  }

  pub theorem node_entries<K: Type, V: Type>(
    l: OrdmapTree(K, V),
    nk: K,
    nv: V,
    r: OrdmapTree(K, V),
    h: Nat
  ): tree_entries(
    OrdmapNode(l, nk, nv, r, h),
    Nil
  ) = List::append(tree_entries(l, Nil), Cons(#(nk, nv), tree_entries(r, Nil))) {
    entries_append(l, Cons(#(nk, nv), tree_entries(r, Nil)))
  }

  pub theorem node_split<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    l: OrdmapTree(K, V),
    nk: K,
    nv: V,
    r: OrdmapTree(K, V),
    h: Nat,
    s: sorted(tree_entries(OrdmapNode(l, nk, nv, r, h), Nil), cmp)
  ): keys(tree_entries(l, Nil), nk, Greater, cmp) ∧
  sorted(tree_entries(l, Nil), cmp) ∧
  keys(tree_entries(r, Nil), nk, Less, cmp) ∧
  sorted(tree_entries(r, Nil), cmp) {
    sorted_split(
      cmp,
      w,
      tree_entries(l, Nil),
      nk,
      nv,
      tree_entries(r, Nil),
      Eq::subst((z: List(K × V)) => sorted(z, cmp), node_entries(l, nk, nv, r, h), s)
    )
  }

  // In a tree whose entries are sorted, `Ordmap::tree_get` is the lookup in
  // its entries.
  pub theorem tree_get_entries<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    t: OrdmapTree(K, V),
    k: K,
    s: sorted(tree_entries(t, Nil), cmp)
  ): tree_get(t, k, cmp) = list_get(tree_entries(t, Nil), k, cmp) {
    ⊢ tree_get(t, k, cmp) = list_get(tree_entries(t, Nil), k, cmp) from match t {
      OrdmapLeaf => Refl
      OrdmapNode(l, nk, nv, r, h) => Eq::trans(
        Ordering::cases(
          (c: Ordering) => (⊢ Option(V) from match c {
            Less => tree_get(l, k, cmp)
            Equal => Some(nv)
            Greater => tree_get(r, k, cmp)
          }) = list_get(List::append(tree_entries(l, Nil), Cons(#(nk, nv), tree_entries(r, Nil))), k, cmp),
          cmp(k, nk),
          (q: cmp(k, nk) = Less) => Eq::trans(
            tree_get_entries(cmp, w, l, k, And::left(And::right(node_split(cmp, w, l, nk, nv, r, h, s)))),
            Eq::sym(
              list_get_append_none(
                tree_entries(l, Nil),
                Cons(#(nk, nv), tree_entries(r, Nil)),
                k,
                cmp,
                list_get_keys_none(
                  k,
                  Less,
                  less_ne_equal,
                  Cons(#(nk, nv), tree_entries(r, Nil)),
                  cmp,
                  AndIntro(
                    q,
                    keys_less_trans(
                      cmp,
                      w,
                      tree_entries(r, Nil),
                      nk,
                      k,
                      q,
                      And::left(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
                    )
                  )
                )
              )
            )
          ),
          (q: cmp(k, nk) = Equal) => Eq::sym(
            Eq::trans(
              list_get_append_skip(
                Greater,
                greater_ne_equal,
                tree_entries(l, Nil),
                Cons(#(nk, nv), tree_entries(r, Nil)),
                k,
                cmp,
                keys_eq(
                  tree_entries(l, Nil),
                  nk,
                  k,
                  Eq::sym(law_eq(cmp, w, k, nk, q)),
                  Greater,
                  cmp,
                  And::left(node_split(cmp, w, l, nk, nv, r, h, s))
                )
              ),
              list_get_equal(nk, nv, tree_entries(r, Nil), k, cmp, q)
            )
          ),
          (q: cmp(k, nk) = Greater) => Eq::trans(
            tree_get_entries(
              cmp,
              w,
              r,
              k,
              And::right(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
            ),
            Eq::sym(
              Eq::trans(
                list_get_append_skip(
                  Greater,
                  greater_ne_equal,
                  tree_entries(l, Nil),
                  Cons(#(nk, nv), tree_entries(r, Nil)),
                  k,
                  cmp,
                  keys_greater_trans(
                    cmp,
                    w,
                    tree_entries(l, Nil),
                    nk,
                    k,
                    q,
                    And::left(node_split(cmp, w, l, nk, nv, r, h, s))
                  )
                ),
                list_get_skip(Greater, greater_ne_equal, nk, nv, tree_entries(r, Nil), k, cmp, q)
              )
            )
          )
        ),
        Eq::sym(
          Eq::congr(⟦list_get(□, k, cmp)⟧, node_entries(l, nk, nv, r, h))
        )
      )
    }
  }

  // In a tree whose entries are sorted, `Ordmap::tree_insert` is the insertion
  // into its entries.
  pub theorem tree_insert_entries<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    t: OrdmapTree(K, V),
    k: K,
    v: V,
    s: sorted(tree_entries(t, Nil), cmp)
  ): tree_entries(tree_insert(t, k, v, cmp), Nil) = list_insert(tree_entries(t, Nil), k, v, cmp) {
    ⊢ tree_entries(
      tree_insert(t, k, v, cmp),
      Nil
    ) = list_insert(tree_entries(t, Nil), k, v, cmp) from match t {
      OrdmapLeaf => Refl
      OrdmapNode(l, nk, nv, r, h) => Eq::trans(
        Ordering::cases(
          (c: Ordering) => tree_entries(⊢ OrdmapTree(K, V) from match c {
            Less => balance(tree_insert(l, k, v, cmp), nk, nv, r)
            Equal => OrdmapNode(l, k, v, r, h)
            Greater => balance(l, nk, nv, tree_insert(r, k, v, cmp))
          }, Nil) = list_insert(List::append(tree_entries(l, Nil), Cons(#(nk, nv), tree_entries(r, Nil))), k, v, cmp),
          cmp(k, nk),
          (q: cmp(k, nk) = Less) => Eq::trans(
            balance_entries(tree_insert(l, k, v, cmp), nk, nv, r, Nil),
            Eq::trans(
              entries_append(tree_insert(l, k, v, cmp), Cons(#(nk, nv), tree_entries(r, Nil))),
              Eq::trans(
                Eq::congr(
                  ⟦List::append(□, Cons(#(nk, nv), tree_entries(r, Nil)))⟧,
                  tree_insert_entries(
                    cmp,
                    w,
                    l,
                    k,
                    v,
                    And::left(And::right(node_split(cmp, w, l, nk, nv, r, h, s)))
                  )
                ),
                Eq::sym(list_insert_append_less(tree_entries(l, Nil), nk, nv, tree_entries(r, Nil), k, v, cmp, q))
              )
            )
          ),
          (q: cmp(k, nk) = Equal) => Eq::trans(
            entries_append(l, Cons(#(k, v), tree_entries(r, Nil))),
            Eq::sym(
              Eq::trans(
                list_insert_append_skip(
                  tree_entries(l, Nil),
                  Cons(#(nk, nv), tree_entries(r, Nil)),
                  k,
                  v,
                  cmp,
                  keys_eq(
                    tree_entries(l, Nil),
                    nk,
                    k,
                    Eq::sym(law_eq(cmp, w, k, nk, q)),
                    Greater,
                    cmp,
                    And::left(node_split(cmp, w, l, nk, nv, r, h, s))
                  )
                ),
                Eq::congr(
                  ⟦List::append(tree_entries(l, Nil), □)⟧,
                  list_insert_equal(nk, nv, tree_entries(r, Nil), k, v, cmp, q)
                )
              )
            )
          ),
          (q: cmp(k, nk) = Greater) => Eq::trans(
            balance_entries(l, nk, nv, tree_insert(r, k, v, cmp), Nil),
            Eq::trans(
              entries_append(
                l,
                Cons(#(nk, nv), tree_entries(tree_insert(r, k, v, cmp), Nil))
              ),
              Eq::trans(
                Eq::congr(
                  ⟦List::append(tree_entries(l, Nil), Cons(#(nk, nv), □))⟧,
                  tree_insert_entries(
                    cmp,
                    w,
                    r,
                    k,
                    v,
                    And::right(And::right(And::right(node_split(cmp, w, l, nk, nv, r, h, s))))
                  )
                ),
                Eq::sym(
                  Eq::trans(
                    list_insert_append_skip(
                      tree_entries(l, Nil),
                      Cons(#(nk, nv), tree_entries(r, Nil)),
                      k,
                      v,
                      cmp,
                      keys_greater_trans(
                        cmp,
                        w,
                        tree_entries(l, Nil),
                        nk,
                        k,
                        q,
                        And::left(node_split(cmp, w, l, nk, nv, r, h, s))
                      )
                    ),
                    Eq::congr(
                      ⟦List::append(tree_entries(l, Nil), □)⟧,
                      list_insert_greater(nk, nv, tree_entries(r, Nil), k, v, cmp, q)
                    )
                  )
                )
              )
            )
          )
        ),
        Eq::sym(
          Eq::congr(
            ⟦list_insert(□, k, v, cmp)⟧,
            node_entries(l, nk, nv, r, h)
          )
        )
      )
    }
  }

  pub fn ordered<K, V>(m: Ordmap(K, V), cmp: (K, K) -> Ordering): Prop {
    sorted(tree_entries(tree(m), Nil), cmp)
  }

  pub theorem empty_ordered<K: Type, V: Type>(
    cmp: (K, K) -> Ordering
  ): ordered(empty(<K: K, V: V>), cmp) {
    Trivial
  }

  pub theorem insert_ordered<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    m: Ordmap(K, V),
    k: K,
    v: V,
    s: ordered(m, cmp)
  ): ordered(insert(m, k, v, cmp), cmp) {
    Eq::subst(
      (z: List(K × V)) => sorted(z, cmp),
      Eq::sym(tree_insert_entries(cmp, w, tree(m), k, v, s)),
      list_insert_sorted(cmp, w, tree_entries(tree(m), Nil), k, v, s)
    )
  }

  pub theorem get_insert_same<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    m: Ordmap(K, V),
    k: K,
    v: V,
    s: ordered(m, cmp)
  ): Ordmap::get(insert(m, k, v, cmp), k, cmp) = Some(v) {
    Eq::trans(
      tree_get_entries(
        cmp,
        w,
        tree_insert(tree(m), k, v, cmp),
        k,
        insert_ordered(cmp, w, m, k, v, s)
      ),
      Eq::trans(
        Eq::congr(⟦list_get(□, k, cmp)⟧, tree_insert_entries(cmp, w, tree(m), k, v, s)),
        list_get_insert_same(cmp, w, tree_entries(tree(m), Nil), k, v)
      )
    )
  }

  pub theorem get_insert_other<K: Type, V: Type>(
    cmp: (K, K) -> Ordering,
    w: OrdmapLaw(K, cmp),
    m: Ordmap(K, V),
    k: K,
    v: V,
    j: K,
    o: Ordering,
    ne: ¬(o = Equal),
    ej: cmp(j, k) = o,
    s: ordered(m, cmp)
  ): Ordmap::get(insert(m, k, v, cmp), j, cmp) = Ordmap::get(m, j, cmp) {
    Eq::trans(
      tree_get_entries(
        cmp,
        w,
        tree_insert(tree(m), k, v, cmp),
        j,
        insert_ordered(cmp, w, m, k, v, s)
      ),
      Eq::trans(
        Eq::congr(⟦list_get(□, j, cmp)⟧, tree_insert_entries(cmp, w, tree(m), k, v, s)),
        Eq::trans(
          list_get_insert_other(cmp, w, tree_entries(tree(m), Nil), k, v, j, o, ne, ej),
          Eq::sym(tree_get_entries(cmp, w, tree(m), j, s))
        )
      )
    )
  }

  pub theorem select_equal(x: Bool, y: Bool, e: select(x, y) = Equal): x = false ∧ y = false {
    ⊢ x = false ∧ y = false from match x {
      false => match y {
        false => AndIntro(Refl, Refl)
        true => False::elim(greater_ne_equal(e))
      }
      true => False::elim(less_ne_equal(e))
    }
  }

  pub theorem select_less(x: Bool, y: Bool, e: select(x, y) = Less): x = true {
    ⊢ x = true from match x {
      false => match y {
        false => False::elim(equal_ne_less(e))
        true => False::elim(greater_ne_less(e))
      }
      true => Refl
    }
  }

  pub theorem select_greater(x: Bool, y: Bool, e: select(x, y) = Greater): x = false ∧ y = true {
    ⊢ x = false ∧ y = true from match x {
      false => match y {
        false => False::elim(equal_ne_greater(e))
        true => AndIntro(Refl, Refl)
      }
      true => False::elim(less_ne_greater(e))
    }
  }

  pub theorem select_of_true(x: Bool, y: Bool, h: x = true): select(x, y) = Less {
    ⊢ select(x, y) = Less from match x {
      false => False::elim(false_ne_true(h))
      true => Refl
    }
  }

  pub theorem select_of_false_true(
    x: Bool,
    y: Bool,
    hx: x = false,
    hy: y = true
  ): select(x, y) = Greater {
    ⊢ select(x, y) = Greater from match x {
      false => match y {
        false => False::elim(false_ne_true(hy))
        true => Refl
      }
      true => False::elim(true_ne_false(hx))
    }
  }

  pub theorem compare_nat_same(a: Nat): compare_nat(a, a) = Equal {
    Eq::subst((z: Bool) => select(z, z) = Equal, Eq::sym(Nat::lt_irrefl(a)), Refl)
  }

  pub theorem compare_nat_eq(a: Nat, b: Nat, e: compare_nat(a, b) = Equal): a = b {
    Nat::lt_total(
      a,
      b,
      And::left(select_equal(a < b, b < a, e)),
      And::right(select_equal(a < b, b < a, e))
    )
  }

  pub theorem compare_nat_flip_less(
    a: Nat,
    b: Nat,
    e: compare_nat(a, b) = Less
  ): compare_nat(b, a) = Greater {
    select_of_false_true(
      b < a,
      a < b,
      Nat::lt_asym(a, b, select_less(a < b, b < a, e)),
      select_less(a < b, b < a, e)
    )
  }

  pub theorem compare_nat_flip_greater(
    a: Nat,
    b: Nat,
    e: compare_nat(a, b) = Greater
  ): compare_nat(b, a) = Less {
    select_of_true(b < a, a < b, And::right(select_greater(a < b, b < a, e)))
  }

  pub theorem compare_nat_less_trans(
    a: Nat,
    b: Nat,
    c: Nat,
    e1: compare_nat(a, b) = Less,
    e2: compare_nat(b, c) = Less
  ): compare_nat(a, c) = Less {
    select_of_true(
      a < c,
      c < a,
      Nat::lt_trans(a, b, c, select_less(a < b, b < a, e1), select_less(b < c, c < b, e2))
    )
  }

  pub theorem compare_nat_law(): OrdmapLaw(Nat, compare_nat) {
    OrdmapLaw::Mk(
      compare_nat_same,
      compare_nat_eq,
      compare_nat_flip_less,
      compare_nat_flip_greater,
      compare_nat_less_trans
    )
  }

  // For maps keyed by numbers, the order needs no assumption; the map must be ordered:
  pub theorem nat_get_insert_same<V: Type>(
    m: Ordmap(Nat, V),
    k: Nat,
    v: V,
    s: ordered(m, compare_nat)
  ): Ordmap::get(insert(m, k, v, compare_nat), k, compare_nat) = Some(v) {
    get_insert_same(compare_nat, compare_nat_law(), m, k, v, s)
  }
}
