  }

  // Mapped: `a * b` modulo `2^32`.
  pub fn u32_mul(a: Secret(U32), b: Secret(U32)): Secret(U32) {
    Secret::Mk(U32::wrapping_mul(expose(a), expose(b)))
  }

  // Mapped: the bits set in both.
  pub fn u32_and(a: Secret(U32), b: Secret(U32)): Secret(U32) {
    Secret::Mk(U32::and(expose(a), expose(b)))
