  }

  // Mapped: `a` shifted left by `s` modulo 32, the bits past the top dropped. The amount is public.
  pub fn u32_shl(a: Secret(U32), s: Nat): Secret(U32) {
    Secret::Mk(U32::shl(expose(a), s))
  }

  // Mapped: `a` shifted right by `s` modulo 32. The amount is public.
  pub fn u32_shr(a: Secret(U32), s: Nat): Secret(U32) {
    Secret::Mk(U32::shr(expose(a), s))
  }

  // Mapped: `a` rotated left by `s` modulo 32. The amount is public.
  pub fn u32_rotl(a: Secret(U32), s: Nat): Secret(U32) {
    Secret::Mk(U32::rotl(expose(a), s))
  }

  // Mapped: `a` rotated right by `s` modulo 32. The amount is public.
  pub fn u32_rotr(a: Secret(U32), s: Nat): Secret(U32) {
    Secret::Mk(U32::rotr(expose(a), s))
  }

  // Mapped: whether `a = b`, kept secret.
  pub fn u32_eq(a: Secret(U32), b: Secret(U32)): Secret(Bool) {
    Secret::Mk(U32::eq(expose(a), expose(b)))
  }

  // Mapped: whether `a < b`, kept secret.
  pub fn u32_lt(a: Secret(U32), b: Secret(U32)): Secret(Bool) {
    Secret::Mk(U32::lt(expose(a), expose(b)))
  }

  // Mapped: `a` when `c`, `b` otherwise, without reading `c`.
  pub fn u32_select(c: Secret(Bool), a: Secret(U32), b: Secret(U32)): Secret(U32) {
    match expose(c): Secret(U32) {
      true => a
      false => b
    }
  }
}

module U64 {

  pub fn wrap(n: Nat): U64 {
    U64::Mk(
      Nat::rem_nz(n, 18446744073709551616, Nat::ne_zero(18446744073709551616, Refl)),
      Nat::mod_lt(n, 18446744073709551616, Refl)
    )
  }
}

module Ct {
  // Mapped: `a + b` modulo `2^64`.
  pub fn u64_add(a: Secret(U64), b: Secret(U64)): Secret(U64) {
    Secret::Mk(U64::wrapping_add(expose(a), expose(b)))
  }

  // Mapped: `a - b` modulo `2^64`.
  pub fn u64_sub(a: Secret(U64), b: Secret(U64)): Secret(U64) {
    Secret::Mk(U64::wrapping_sub(expose(a), expose(b)))
  }

  // Mapped: `a * b` modulo `2^64`.
  pub fn u64_mul(a: Secret(U64), b: Secret(U64)): Secret(U64) {
    Secret::Mk(U64::wrapping_mul(expose(a), expose(b)))
  }

  // Mapped: the bits set in both.
  pub fn u64_and(a: Secret(U64), b: Secret(U64)): Secret(U64) {
    Secret::Mk(U64::and(expose(a), expose(b)))
  }

  // Mapped: the bits set in either.
  pub fn u64_or(a: Secret(U64), b: Secret(U64)): Secret(U64) {
    Secret::Mk(U64::or(expose(a), expose(b)))
  }

  // Mapped: the bits set in one of the two.
  pub fn u64_xor(a: Secret(U64), b: Secret(U64)): Secret(U64) {
    Secret::Mk(U64::xor(expose(a), expose(b)))
  }

  // Mapped: every bit flipped.
  pub fn u64_not(a: Secret(U64)): Secret(U64) {
    Secret::Mk(U64::wrap(Nat::bits_xor(64, U64::val(expose(a)), 18446744073709551615)))
  }

  // Mapped: `a` shifted left by `s` modulo 64, the bits past the top dropped. The amount is public.
  pub fn u64_shl(a: Secret(U64), s: Nat): Secret(U64) {
    Secret::Mk(U64::shl(expose(a), s))
  }

  // Mapped: `a` shifted right by `s` modulo 64. The amount is public.
  pub fn u64_shr(a: Secret(U64), s: Nat): Secret(U64) {
    Secret::Mk(U64::shr(expose(a), s))
  }

  // Mapped: `a` rotated left by `s` modulo 64. The amount is public.
  pub fn u64_rotl(a: Secret(U64), s: Nat): Secret(U64) {
    Secret::Mk(U64::rotl(expose(a), s))
  }

  // Mapped: `a` rotated right by `s` modulo 64. The amount is public.
  pub fn u64_rotr(a: Secret(U64), s: Nat): Secret(U64) {
    Secret::Mk(U64::rotr(expose(a), s))
  }

  // Mapped: whether `a = b`, kept secret.
  pub fn u64_eq(a: Secret(U64), b: Secret(U64)): Secret(Bool) {
    Secret::Mk(U64::eq(expose(a), expose(b)))
  }

  // Mapped: whether `a < b`, kept secret.
  pub fn u64_lt(a: Secret(U64), b: Secret(U64)): Secret(Bool) {
    Secret::Mk(U64::lt(expose(a), expose(b)))
  }

  // Mapped: `a` when `c`, `b` otherwise, without reading `c`.
  pub fn u64_select(c: Secret(Bool), a: Secret(U64), b: Secret(U64)): Secret(U64) {
    match expose(c): Secret(U64) {
      true => a
      false => b
    }
  }

  // Mapped: the high 64 bits of the 128-bit product.
  pub fn u64_mul_hi(a: Secret(U64), b: Secret(U64)): Secret(U64) {
    Secret::Mk(
      U64::wrap(
        Nat::div_nz(
          Nat::mul(U64::val(expose(a)), U64::val(expose(b))),
          18446744073709551616,
          Nat::ne_zero(18446744073709551616, Refl)
        )
      )
    )
  }

  // Mapped: the same number in a wider word.
  pub fn u64_of_u8(a: Secret(U8)): Secret(U64) {
    Secret::Mk(U64::wrap(U8::val(expose(a))))
  }

  // Mapped: the same number in a wider word.
  pub fn u64_of_u32(a: Secret(U32)): Secret(U64) {
    Secret::Mk(U64::wrap(U32::val(expose(a))))
  }

  // Mapped: the same number in a wider word.
  pub fn u32_of_u8(a: Secret(U8)): Secret(U32) {
    Secret::Mk(U32::wrap(U8::val(expose(a))))
  }

  // Mapped: the low bits.
  pub fn u8_of_u32(a: Secret(U32)): Secret(U8) {
    Secret::Mk(U8::wrap(U32::val(expose(a))))
  }

  // Mapped: the low bits.
  pub fn u8_of_u64(a: Secret(U64)): Secret(U8) {
    Secret::Mk(U8::wrap(U64::val(expose(a))))
  }

  // Mapped: the low bits.
  pub fn u32_of_u64(a: Secret(U64)): Secret(U32) {
    Secret::Mk(U32::wrap(U64::val(expose(a))))
  }

  // Mapped: the secret yes or no of both, either, and the other one.
  pub fn bool_and(a: Secret(Bool), b: Secret(Bool)): Secret(Bool) {
    Secret::Mk(expose(a) && expose(b))
  }

  pub fn bool_or(a: Secret(Bool), b: Secret(Bool)): Secret(Bool) {
    Secret::Mk(expose(a) || expose(b))
  }

  pub fn bool_not(a: Secret(Bool)): Secret(Bool) {
    Secret::Mk(not(expose(a)))
  }

  // Mapped: `a` when `c`, `b` otherwise, without reading `c`.
  pub fn bool_select(c: Secret(Bool), a: Secret(Bool), b: Secret(Bool)): Secret(Bool) {
    match expose(c): Secret(Bool) {
      true => a
      false => b
    }
  }

  // The length of a secret byte string is public, as the length of every
  // secret list is: a key's bytes are reached one by one by a public index.

  // Mapped: the number of bytes, made public.
  pub fn bytes_len(s: Secret(Bytes)): Nat {
    Bytes::len(expose(s))
  }

  // Mapped: the byte at the public index `i`, still secret; `None` past the end.
  pub fn bytes_get(s: Secret(Bytes), i: Nat): Option(Secret(U8)) {
    Option::map((x: U8) => Secret::Mk(x), Bytes::get(expose(s), i))
  }

  pub theorem u8_add_val(
    a: Secret(U8),
    b: Secret(U8)
  ): expose(Ct::u8_add(a, b)) = U8::wrapping_add(expose(a), expose(b)) {
    Refl
  }

  pub theorem u8_sub_val(
    a: Secret(U8),
    b: Secret(U8)
  ): expose(Ct::u8_sub(a, b)) = U8::wrapping_sub(expose(a), expose(b)) {
    Refl
  }

  pub theorem u8_mul_val(
    a: Secret(U8),
    b: Secret(U8)
  ): expose(Ct::u8_mul(a, b)) = U8::wrapping_mul(expose(a), expose(b)) {
    Refl
  }

  pub theorem u8_eq_val(
    a: Secret(U8),
    b: Secret(U8)
  ): expose(Ct::u8_eq(a, b)) = U8::eq(expose(a), expose(b)) {
    Refl
  }

  pub theorem u8_lt_val(
    a: Secret(U8),
    b: Secret(U8)
  ): expose(Ct::u8_lt(a, b)) = U8::lt(expose(a), expose(b)) {
    Refl
  }

  pub theorem u8_select_true(
    c: Secret(Bool),
    a: Secret(U8),
    b: Secret(U8),
    h: expose(c) = true
  ): Ct::u8_select(c, a, b) = a {
    match c: Ct::u8_select(c, a, b) = a {
      Mk(v) => match v: Ct::u8_select(Secret::Mk(v), a, b) = a {
        true => ⊢ Ct::u8_select(Secret::Mk(true), a, b) = a from Refl
        false => ⊢ Ct::u8_select(
          Secret::Mk(false),
          a,
          b
        ) = a from match false_ne_true(h): Ct::u8_select(Secret::Mk(false), a, b) = a {}
      }
    }
  }

  pub theorem u8_select_false(
    c: Secret(Bool),
    a: Secret(U8),
    b: Secret(U8),
    h: expose(c) = false
  ): Ct::u8_select(c, a, b) = b {
    match c: Ct::u8_select(c, a, b) = b {
      Mk(v) => match v: Ct::u8_select(Secret::Mk(v), a, b) = b {
        true => ⊢ Ct::u8_select(
          Secret::Mk(true),
          a,
          b
        ) = b from match true_ne_false(h): Ct::u8_select(Secret::Mk(true), a, b) = b {}
        false => ⊢ Ct::u8_select(Secret::Mk(false), a, b) = b from Refl
      }
    }
  }

