  }

  pub theorem u64_rotl_val(
    a: Secret(U64),
    s: Nat
  ): expose(Ct::u64_rotl(a, s)) = U64::rotl(expose(a), s) {
    Refl
  }

  pub theorem u64_rotr_val(
    a: Secret(U64),
    s: Nat
  ): expose(Ct::u64_rotr(a, s)) = U64::rotr(expose(a), s) {
    Refl
  }

  pub theorem u64_eq_val(
    a: Secret(U64),
    b: Secret(U64)
  ): expose(Ct::u64_eq(a, b)) = U64::eq(expose(a), expose(b)) {
    Refl
  }

  pub theorem u64_lt_val(
    a: Secret(U64),
    b: Secret(U64)
  ): expose(Ct::u64_lt(a, b)) = U64::lt(expose(a), expose(b)) {
    Refl
  }

  pub theorem u64_select_true(
    c: Secret(Bool),
    a: Secret(U64),
    b: Secret(U64),
    h: expose(c) = true
  ): Ct::u64_select(c, a, b) = a {
    match c: Ct::u64_select(c, a, b) = a {
      Mk(v) => match v: Ct::u64_select(Secret::Mk(v), a, b) = a {
        true => ⊢ Ct::u64_select(Secret::Mk(true), a, b) = a from Refl
        false => ⊢ Ct::u64_select(
          Secret::Mk(false),
          a,
          b
        ) = a from match false_ne_true(h): Ct::u64_select(Secret::Mk(false), a, b) = a {}
      }
    }
  }

  pub theorem u64_select_false(
    c: Secret(Bool),
    a: Secret(U64),
    b: Secret(U64),
    h: expose(c) = false
  ): Ct::u64_select(c, a, b) = b {
    match c: Ct::u64_select(c, a, b) = b {
      Mk(v) => match v: Ct::u64_select(Secret::Mk(v), a, b) = b {
        true => ⊢ Ct::u64_select(
          Secret::Mk(true),
          a,
          b
        ) = b from match true_ne_false(h): Ct::u64_select(Secret::Mk(true), a, b) = b {}
        false => ⊢ Ct::u64_select(Secret::Mk(false), a, b) = b from Refl
      }
    }
  }

  pub theorem bytes_len_val(s: Secret(Bytes)): Ct::bytes_len(s) = Bytes::len(expose(s)) {
    Refl
  }

  pub theorem bytes_get_val(
    s: Secret(Bytes),
    i: Nat
  ): Ct::bytes_get(s, i) = Option::map((x: U8) => Secret::Mk(x), Bytes::get(expose(s), i)) {
    Refl
  }
}
