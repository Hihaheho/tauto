import "UInt.taut"
import "Bytes.taut"
import "Data.taut"
import "Base.taut"
import "Nat.taut"

// Secret values as the proofs see them: a box around the value. Extraction
// maps `Secret` onto Nib's `Secret`, whose content a program reads only
// through the functions here, each run in constant time, and through
// `expose`. A `match` on a `Secret` and the constructor `secret` are
// for proofs: in code that runs, a match on a secret is an error of
// extraction, and `secret` is the function that hides a public value. The
// definitions here say what the functions compute, so a proof about them
// holds of the program that runs (`docs/design/secret.md`).

pub(open) inductive Secret(A: Type): Type {
  Mk(v: A): Secret(A)
}

// Mapped: the content, made public. In code that runs, every call is listed
// by the trust report.
pub fn expose<A>(s: Secret(A)): A {
  match s: A {
    Mk(v) => v
  }
}

pub theorem expose_secret<A>(v: A): expose(Secret::Mk(v)) = v {
  Refl
}

module U8 {

  pub fn wrap(n: Nat): U8 {
    U8::Mk(Nat::rem_nz(n, 256, Nat::ne_zero(256, Refl)), Nat::mod_lt(n, 256, Refl))
  }
}

module Ct {
  // Mapped: `a + b` modulo `2^8`.
  pub fn u8_add(a: Secret(U8), b: Secret(U8)): Secret(U8) {
    Secret::Mk(U8::wrapping_add(expose(a), expose(b)))
  }

  // Mapped: `a - b` modulo `2^8`.
  pub fn u8_sub(a: Secret(U8), b: Secret(U8)): Secret(U8) {
    Secret::Mk(U8::wrapping_sub(expose(a), expose(b)))
  }

  // Mapped: `a * b` modulo `2^8`.
  pub fn u8_mul(a: Secret(U8), b: Secret(U8)): Secret(U8) {
    Secret::Mk(U8::wrapping_mul(expose(a), expose(b)))
  }

  // Mapped: the bits set in both.
  pub fn u8_and(a: Secret(U8), b: Secret(U8)): Secret(U8) {
    Secret::Mk(U8::wrap(Nat::bits_and(8, U8::val(expose(a)), U8::val(expose(b)))))
  }

  // Mapped: the bits set in either.
  pub fn u8_or(a: Secret(U8), b: Secret(U8)): Secret(U8) {
    Secret::Mk(U8::wrap(Nat::bits_or(8, U8::val(expose(a)), U8::val(expose(b)))))
  }

  // Mapped: the bits set in one of the two.
  pub fn u8_xor(a: Secret(U8), b: Secret(U8)): Secret(U8) {
    Secret::Mk(U8::wrap(Nat::bits_xor(8, U8::val(expose(a)), U8::val(expose(b)))))
  }

  // Mapped: every bit flipped.
  pub fn u8_not(a: Secret(U8)): Secret(U8) {
    Secret::Mk(U8::wrap(Nat::bits_xor(8, U8::val(expose(a)), 255)))
  }

  // Mapped: `a` shifted left by `s` modulo 8, the bits past the top dropped. The amount is public.
  pub fn u8_shl(a: Secret(U8), s: Nat): Secret(U8) {
    Secret::Mk(
      U8::wrap(Nat::mul(U8::val(expose(a)), Nat::pow2(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))))
    )
  }

  // Mapped: `a` shifted right by `s` modulo 8. The amount is public.
  pub fn u8_shr(a: Secret(U8), s: Nat): Secret(U8) {
    Secret::Mk(
      U8::wrap(
        Nat::div_nz(
          U8::val(expose(a)),
          Nat::pow2(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl))),
          Nat::pow2_ne_zero(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))
        )
      )
    )
  }

  // Mapped: `a` rotated left by `s` modulo 8. The amount is public.
  pub fn u8_rotl(a: Secret(U8), s: Nat): Secret(U8) {
    Secret::Mk(
      U8::wrap(
        Nat::add(
          Nat::rem_nz(
            Nat::mul(U8::val(expose(a)), Nat::pow2(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))),
            256,
            Nat::ne_zero(256, Refl)
          ),
          Nat::div_nz(
            U8::val(expose(a)),
            Nat::pow2(8 - Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl))),
            Nat::pow2_ne_zero(8 - Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))
          )
        )
      )
    )
  }

  // Mapped: `a` rotated right by `s` modulo 8. The amount is public.
  pub fn u8_rotr(a: Secret(U8), s: Nat): Secret(U8) {
    Secret::Mk(
      U8::wrap(
        Nat::add(
          Nat::div_nz(
            U8::val(expose(a)),
            Nat::pow2(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl))),
            Nat::pow2_ne_zero(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))
          ),
          Nat::rem_nz(
            Nat::mul(U8::val(expose(a)), Nat::pow2(8 - Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))),
            256,
            Nat::ne_zero(256, Refl)
          )
        )
      )
    )
  }

  // Mapped: whether `a = b`, kept secret.
  pub fn u8_eq(a: Secret(U8), b: Secret(U8)): Secret(Bool) {
    Secret::Mk(U8::eq(expose(a), expose(b)))
  }

  // Mapped: whether `a < b`, kept secret.
  pub fn u8_lt(a: Secret(U8), b: Secret(U8)): Secret(Bool) {
    Secret::Mk(U8::lt(expose(a), expose(b)))
  }

  // Mapped: `a` when `c`, `b` otherwise, without reading `c`.
  pub fn u8_select(c: Secret(Bool), a: Secret(U8), b: Secret(U8)): Secret(U8) {
    match expose(c): Secret(U8) {
      true => a
      false => b
    }
  }
}

module U32 {

  pub fn wrap(n: Nat): U32 {
    U32::Mk(
      Nat::rem_nz(n, 4294967296, Nat::ne_zero(4294967296, Refl)),
      Nat::mod_lt(n, 4294967296, Refl)
    )
  }
}

module Ct {
  // Mapped: `a + b` modulo `2^32`.
  pub fn u32_add(a: Secret(U32), b: Secret(U32)): Secret(U32) {
    Secret::Mk(U32::wrapping_add(expose(a), expose(b)))
  }

  // Mapped: `a - b` modulo `2^32`.
  pub fn u32_sub(a: Secret(U32), b: Secret(U32)): Secret(U32) {
