import "base.taut" { Nat }
import "int.taut" { Int }
import "uint.taut" { Nat }

// Rational numbers as the proofs see them: `num / (den + 1)`, so that no
// denominator is zero. A number has many representations (`1/2` and `2/4`);
// `Rat::eq` and `Rat::le` compare the numbers, `=` the
// representations. `Rat::add` and `Rat::mul` give lowest terms, which keeps
// the numbers small enough for the kernel to compute them at once. Every finite `Float` is one of these (`std/float_real.taut`).

pub(open) inductive Rat: Type {
  Mk(num: Int, den: Nat): Rat
}

pub fn Rat::num(x: Rat): Int {
  match x {
    Mk(n, d) => n
  }
}

pub fn Rat::den(x: Rat): Nat {
  match x {
    Mk(n, d) => Succ(d)
  }
}

pub fn Rat::of_int(n: Int): Rat {
  Rat::Mk(n, 0)
}

pub fn Rat::of_nat(n: Nat): Rat {
  Rat::Mk(IntOfNat(n), 0)
}

// `n / d` for a denominator `d` that is not zero: `frac(n, d)` is `n / (d + 1)`.
pub fn Rat::frac(n: Int, d: Nat): Rat {
  Rat::Mk(n, d)
}

// The greatest common divisor, by Euclid's steps counted down from `fuel`.
pub fn Rat::gcd(fuel: Nat, a: Nat, b: Nat): Nat {
  match fuel {
    Zero => a
    Succ(j) => ⊢ Nat from match Nat::eq(b, 0) eqn h {
      true => a
      false => Rat::gcd(j, b, Nat::rem_nz(a, b, Nat::ne_zero(b, h)))
    }
  }
}

// `n / d` in lowest terms, for `d > 0`. 400 steps reduce every pair below
// `2^256`; past that `g` may not divide both, and `n / d` is kept as it is, a
// correct but larger representation. A `g` of 0 (only when `n` and `d` are 0)
// keeps `n / d` too.
pub fn Rat::reduce(n: Int, d: Nat): Rat {
  match Nat::eq(Rat::gcd(400, d, Int::abs_nat(n)), 0) eqn hg {
    true => Rat::Mk(n, d - 1)
    false => Rat::reduce_by(
      n,
      d,
      Rat::gcd(400, d, Int::abs_nat(n)),
      Nat::ne_zero(Rat::gcd(400, d, Int::abs_nat(n)), hg)
    )
  }
}

pub fn Rat::reduce_by(n: Int, d: Nat, g: Nat, hg: ¬(g = 0)): Rat {
  Rat::pick_by(
    Rat::divides(n, d, g, hg),
    Rat::Mk(n, d - 1),
    Rat::Mk(Int::div_nat(n, g, hg), Nat::div_nz(d, g, hg) - 1)
  )
}

pub fn Rat::divides(n: Int, d: Nat, g: Nat, hg: ¬(g = 0)): Bool {
  Nat::eq(Nat::rem_nz(d, g, hg), 0) && Nat::eq(Nat::rem_nz(Int::abs_nat(n), g, hg), 0)
}

pub fn Rat::pick_by(o: Bool, x: Rat, c: Rat): Rat {
  match o { false => x, true => c }
}

pub fn Rat::neg(x: Rat): Rat {
  Rat::Mk(Int::neg(Rat::num(x)), Rat::den(x) - 1)
}

pub fn Rat::add(x: Rat, y: Rat): Rat {
  Rat::reduce(
    Int::add(Int::mul(Rat::num(x), IntOfNat(Rat::den(y))), Int::mul(Rat::num(y), IntOfNat(Rat::den(x)))),
    Nat::mul(Rat::den(x), Rat::den(y))
  )
}

pub fn Rat::sub(x: Rat, y: Rat): Rat {
  Rat::add(x, Rat::neg(y))
}

pub fn Rat::mul(x: Rat, y: Rat): Rat {
  Rat::reduce(Int::mul(Rat::num(x), Rat::num(y)), Nat::mul(Rat::den(x), Rat::den(y)))
}

pub fn Rat::is_zero(x: Rat): Bool {
  Int::eq(Rat::num(x), 0)
}

pub fn Rat::inv(x: Rat, h: Rat::is_zero(x) = false): Rat {
  match Rat::num(x) {
    IntOfNat(n) => Rat::Mk(IntOfNat(Rat::den(x)), n - 1)
    IntNegSucc(n) => Rat::Mk(Int::neg(IntOfNat(Rat::den(x))), n)
  }
}

pub fn Rat::div(x: Rat, y: Rat, h: Rat::is_zero(y) = false): Rat {
  Rat::mul(x, Rat::inv(y, h))
}

pub fn Rat::eq(x: Rat, y: Rat): Bool {
  Int::eq(Int::mul(Rat::num(x), IntOfNat(Rat::den(y))), Int::mul(Rat::num(y), IntOfNat(Rat::den(x))))
}

pub fn Rat::lt(x: Rat, y: Rat): Bool {
  Int::lt(Int::mul(Rat::num(x), IntOfNat(Rat::den(y))), Int::mul(Rat::num(y), IntOfNat(Rat::den(x))))
}

pub fn Rat::le(x: Rat, y: Rat): Bool {
  Int::le(Int::mul(Rat::num(x), IntOfNat(Rat::den(y))), Int::mul(Rat::num(y), IntOfNat(Rat::den(x))))
}

pub fn Rat::abs(x: Rat): Rat {
  match Rat::num(x) {
    IntOfNat(n) => x
    IntNegSucc(n) => Rat::neg(x)
  }
}

pub fn Rat::dist(x: Rat, y: Rat): Rat {
  Rat::abs(Rat::sub(x, y))
}

pub fn Rat::pow2(k: Nat): Rat {
  Rat::of_nat(Nat::pow2(k))
}

pub fn Rat::pow2_neg(k: Nat): Rat {
  Rat::Mk(IntOfNat(1), Nat::pow2(k) - 1)
}

pub theorem Rat::examples(): Rat::eq(Rat::add(Rat::frac(1, 1), Rat::frac(1, 2)), Rat::frac(5, 5)) = true {
  Refl
}

pub theorem Rat::lt_example(): Rat::lt(Rat::neg(Rat::pow2_neg(3)), Rat::of_nat(0)) = true {
  Refl
}

pub fn Int::abs_nat(n: Int): Nat {
  match n {
    IntOfNat(k) => k
    IntNegSucc(k) => Succ(k)
  }
}

// `n / g` of a multiple `n` of `g`.
pub fn Int::div_nat(n: Int, g: Nat, hg: ¬(g = 0)): Int {
  match n {
    IntOfNat(k) => IntOfNat(Nat::div_nz(k, g, hg))
    IntNegSucc(k) => Int::neg(IntOfNat(Nat::div_nz(Succ(k), g, hg)))
  }
}
