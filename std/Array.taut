import "Base.taut"

// Arrays as the proofs see them: a list. Extraction
// maps `Array` onto Nib's `Array` and the functions here onto its builtins,
// which read by index in O(1); their definitions here say what those
// builtins do.

pub(open) inductive Array(A: Type): Type =>
  fn Array::beq, theorem Array::beq_refl, theorem Array::beq_sound, theorem Array::deq {
  Mk(items: List(A)): Array(A)
}

module Array {
  // Mapped: the array of a list's elements.
  pub fn of_list<A>(l: List(A)): Array(A) {
    Array::Mk(l)
  }

  // Mapped: the elements, in order.
  pub fn to_list<A>(a: Array(A)): List(A) {
    match a: List(A) {
      Mk(l) => l
    }
  }

  // Mapped: the element at `i`.
  pub fn get<A>(a: Array(A), i: Nat): Option(A) {
    List::nth(to_list(a), i)
  }

  // Mapped: the number of elements.
  pub fn len<A>(a: Array(A)): Nat {
    List::length(to_list(a))
  }

  // The element at `i`, or `d` when there is none.
  pub fn get_or<A>(a: Array(A), i: Nat, d: A): A {
    match get(a, i): A {
      None => d
      Some(x) => x
    }
  }

  pub theorem get_of_list<A>(
    l: List(A),
    i: Nat
  ): get(of_list(l), i) = List::nth(l, i) {
    Refl
  }

  pub theorem len_of_list<A>(l: List(A)): len(of_list(l)) = List::length(l) {
    Refl
  }

  pub theorem to_list_of_list<A>(l: List(A)): to_list(of_list(l)) = l {
    Refl
  }
}
