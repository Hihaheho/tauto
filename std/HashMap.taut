import "Base.taut" { List, Ordering }
import "Map.taut" { Ordmap }
import "MapLaws.taut" { Ordmap }
import "MapRemoveFloor.taut" { Ordmap }
import std::prelude::Ord { greater_ne_equal, less_ne_equal }
import std::prelude::Std { List, Option, Ordering }

// A hash map, persistent: the entries are kept in buckets, one for each hash
// of a key, and the buckets in an `Ordmap` keyed by the hash. A bucket is a
// list of entries whose keys are told apart by `eq`. `hash` and `eq` are given
// at every call, as the comparator is in `Map::taut`; the theorems assume that
// `eq` decides equality (`HashEq`). A set is a `Hmap(K, Bool)` whose values
// are all `true` (`Hset`).

pub(open) inductive HashEq(K: Type, eq: (K, K) -> Bool): Prop {
  Mk(
    refl: ∀ a: K. eq(a, a) = true,
    sound: ∀ a: K, b: K. (eq(a, b) = true) -> (a = b)
  ): HashEq(K, eq)
}

pub theorem hash_eq_refl<K: Type>(eq: (K, K) -> Bool, w: HashEq(K, eq), a: K): eq(a, a) = true {
  ⊢ eq(a, a) = true from match w {
    Mk(r, s) => r(a)
  }
}

pub theorem hash_eq_sound<K: Type>(
  eq: (K, K) -> Bool,
  w: HashEq(K, eq),
  a: K,
  b: K,
  e: eq(a, b) = true
): a = b {
  ⊢ a = b from match w {
    Mk(r, s) => s(a, b, e)
  }
}

pub fn bucket_get<K, V>(b: List(K × V), k: K, eq: (K, K) -> Bool): Option(V) {
  ⊢ Option(V) from match b {
    Nil => None
    Cons(e, rest) => ⊢ Option(V) from match e {
      #(ek, ev) => ⊢ Option(V) from match eq(k, ek) {
        true => Some(ev)
        false => bucket_get(rest, k, eq)
      }
    }
  }
}

// The entry of `k` replaced, or put at the end.
pub fn bucket_insert<K, V>(b: List(K × V), k: K, v: V, eq: (K, K) -> Bool): List(K × V) {
  ⊢ List(K × V) from match b {
    Nil => Cons(#(k, v), Nil)
    Cons(e, rest) => ⊢ List(K × V) from match e {
      #(ek, ev) => ⊢ List(K × V) from match eq(k, ek) {
        true => Cons(#(k, v), rest)
        false => Cons(#(ek, ev), bucket_insert(rest, k, v, eq))
      }
    }
  }
}

// Every entry of `k` taken out.
pub fn bucket_remove<K, V>(b: List(K × V), k: K, eq: (K, K) -> Bool): List(K × V) {
  ⊢ List(K × V) from match b {
    Nil => Nil
    Cons(e, rest) => ⊢ List(K × V) from match e {
      #(ek, ev) => ⊢ List(K × V) from match eq(k, ek) {
        true => bucket_remove(rest, k, eq)
        false => Cons(#(ek, ev), bucket_remove(rest, k, eq))
      }
    }
  }
}

pub fn bucket_choose<T>(a: T, b: T, c: Bool): T {
  ⊢ T from match c { true => a, false => b }
}

pub theorem bucket_choose_true<T: Type>(
  c: Bool,
  a: T,
  b: T,
  h: c = true
): bucket_choose(a, b, c) = a {
  ⊢ bucket_choose(a, b, c) = a from match c {
    true => Refl
    false => False::elim(false_ne_true(h))
  }
}

pub theorem bucket_choose_false<T: Type>(
  c: Bool,
  a: T,
  b: T,
  h: c = false
): bucket_choose(a, b, c) = b {
  ⊢ bucket_choose(a, b, c) = b from match c {
    true => False::elim(true_ne_false(h))
    false => Refl
  }
}

pub theorem bucket_get_insert_same<K: Type, V: Type>(
  eq: (K, K) -> Bool,
  w: HashEq(K, eq),
  b: List(K × V),
  k: K,
  v: V
): bucket_get(bucket_insert(b, k, v, eq), k, eq) = Some(v) {
  ⊢ bucket_get(bucket_insert(b, k, v, eq), k, eq) = Some(v) from match b {
    Nil => bucket_choose_true(eq(k, k), Some(v), None(<A: V>), hash_eq_refl(eq, w, k))
    Cons(e, rest) => ⊢ bucket_get(
      bucket_insert(Cons(e, rest), k, v, eq),
      k,
      eq
    ) = Some(v) from match e {
      #(ek, ev) => ⊢ bucket_get(
        bucket_insert(Cons(#(ek, ev), rest), k, v, eq),
        k,
        eq
      ) = Some(v) from match eq(k, ek) eqn h {
        false => ⊢ bucket_get(
          bucket_choose(Cons(#(k, v), rest), Cons(#(ek, ev), bucket_insert(rest, k, v, eq)), false),
          k,
          eq
        ) = Some(v) from Eq::trans(
          bucket_choose_false(
            eq(k, ek),
            Some(ev),
            bucket_get(bucket_insert(rest, k, v, eq), k, eq),
            h
          ),
          bucket_get_insert_same(eq, w, rest, k, v)
        )
        true => ⊢ bucket_get(
          bucket_choose(Cons(#(k, v), rest), Cons(#(ek, ev), bucket_insert(rest, k, v, eq)), true),
          k,
          eq
        ) = Some(v) from bucket_choose_true(
          eq(k, k),
          Some(v),
          bucket_get(rest, k, eq),
          hash_eq_refl(eq, w, k)
        )
      }
    }
  }
}

// `eq(j, k)` is `false` and `eq(k, ek)` is `true`: `eq(j, ek)` is `false`.
pub theorem bucket_ne_moved<K: Type>(
  eq: (K, K) -> Bool,
  w: HashEq(K, eq),
  j: K,
  k: K,
  ek: K,
  ne: eq(j, k) = false,
  h: eq(k, ek) = true
): eq(j, ek) = false {
  Eq::subst((z: K) => eq(j, z) = false, hash_eq_sound(eq, w, k, ek, h), ne)
}

pub theorem bucket_get_insert_other<K: Type, V: Type>(
  eq: (K, K) -> Bool,
  w: HashEq(K, eq),
  b: List(K × V),
  k: K,
  v: V,
  j: K,
  ne: eq(j, k) = false
): bucket_get(bucket_insert(b, k, v, eq), j, eq) = bucket_get(b, j, eq) {
  ⊢ bucket_get(bucket_insert(b, k, v, eq), j, eq) = bucket_get(b, j, eq) from match b {
    Nil => bucket_choose_false(eq(j, k), Some(v), None(<A: V>), ne)
    Cons(e, rest) => ⊢ bucket_get(
      bucket_insert(Cons(e, rest), k, v, eq),
      j,
      eq
    ) = bucket_get(Cons(e, rest), j, eq) from match e {
      #(ek, ev) => ⊢ bucket_get(
        bucket_insert(Cons(#(ek, ev), rest), k, v, eq),
        j,
        eq
      ) = bucket_get(Cons(#(ek, ev), rest), j, eq) from match eq(k, ek) eqn h {
        false => ⊢ bucket_get(
          bucket_choose(Cons(#(k, v), rest), Cons(#(ek, ev), bucket_insert(rest, k, v, eq)), false),
          j,
          eq
        ) = bucket_get(
          Cons(#(ek, ev), rest),
          j,
          eq
        ) from Eq::congr(
          ⟦bucket_choose(Some(ev), □, eq(j, ek))⟧,
          bucket_get_insert_other(eq, w, rest, k, v, j, ne)
        )
        true => ⊢ bucket_get(
          bucket_choose(Cons(#(k, v), rest), Cons(#(ek, ev), bucket_insert(rest, k, v, eq)), true),
          j,
          eq
        ) = bucket_get(
          Cons(#(ek, ev), rest),
          j,
          eq
        ) from Eq::trans(
          bucket_choose_false(eq(j, k), Some(v), bucket_get(rest, j, eq), ne),
          Eq::sym(
            bucket_choose_false(
              eq(j, ek),
              Some(ev),
              bucket_get(rest, j, eq),
              bucket_ne_moved(eq, w, j, k, ek, ne, h)
            )
          )
        )
      }
    }
  }
}

pub theorem bucket_get_remove_same<K: Type, V: Type>(
  eq: (K, K) -> Bool,
  b: List(K × V),
  k: K
): bucket_get(bucket_remove(b, k, eq), k, eq) = None {
  ⊢ bucket_get(bucket_remove(b, k, eq), k, eq) = None from match b {
    Nil => Refl
    Cons(e, rest) => ⊢ bucket_get(bucket_remove(Cons(e, rest), k, eq), k, eq) = None from match e {
      #(ek, ev) => ⊢ bucket_get(
        bucket_remove(Cons(#(ek, ev), rest), k, eq),
        k,
        eq
      ) = None from match eq(k, ek) eqn h {
        false => ⊢ bucket_get(
          bucket_choose(
            bucket_remove(rest, k, eq),
            Cons(#(ek, ev), bucket_remove(rest, k, eq)),
            false
          ),
          k,
          eq
        ) = None from Eq::trans(
          bucket_choose_false(
            eq(k, ek),
            Some(ev),
            bucket_get(bucket_remove(rest, k, eq), k, eq),
            h
          ),
          bucket_get_remove_same(eq, rest, k)
        )
        true => ⊢ bucket_get(
          bucket_choose(
            bucket_remove(rest, k, eq),
            Cons(#(ek, ev), bucket_remove(rest, k, eq)),
            true
          ),
          k,
          eq
        ) = None from bucket_get_remove_same(eq, rest, k)
      }
    }
  }
}

pub theorem bucket_get_remove_other<K: Type, V: Type>(
  eq: (K, K) -> Bool,
  w: HashEq(K, eq),
  b: List(K × V),
  k: K,
  j: K,
  ne: eq(j, k) = false
): bucket_get(bucket_remove(b, k, eq), j, eq) = bucket_get(b, j, eq) {
  ⊢ bucket_get(bucket_remove(b, k, eq), j, eq) = bucket_get(b, j, eq) from match b {
    Nil => Refl
    Cons(e, rest) => ⊢ bucket_get(
      bucket_remove(Cons(e, rest), k, eq),
      j,
      eq
    ) = bucket_get(Cons(e, rest), j, eq) from match e {
      #(ek, ev) => ⊢ bucket_get(
        bucket_remove(Cons(#(ek, ev), rest), k, eq),
        j,
        eq
      ) = bucket_get(Cons(#(ek, ev), rest), j, eq) from match eq(k, ek) eqn h {
        false => ⊢ bucket_get(
          bucket_choose(
            bucket_remove(rest, k, eq),
            Cons(#(ek, ev), bucket_remove(rest, k, eq)),
            false
          ),
          j,
          eq
        ) = bucket_get(
          Cons(#(ek, ev), rest),
          j,
          eq
        ) from Eq::congr(
          ⟦bucket_choose(Some(ev), □, eq(j, ek))⟧,
          bucket_get_remove_other(eq, w, rest, k, j, ne)
        )
        true => ⊢ bucket_get(
          bucket_choose(
            bucket_remove(rest, k, eq),
            Cons(#(ek, ev), bucket_remove(rest, k, eq)),
            true
          ),
          j,
          eq
        ) = bucket_get(
          Cons(#(ek, ev), rest),
          j,
          eq
        ) from Eq::trans(
          bucket_get_remove_other(eq, w, rest, k, j, ne),
          Eq::sym(
            bucket_choose_false(
              eq(j, ek),
              Some(ev),
              bucket_get(rest, j, eq),
              bucket_ne_moved(eq, w, j, k, ek, ne, h)
            )
          )
        )
      }
    }
  }
}

pub(open) inductive Hmap(K: Type, V: Type): Type {
  Mk(buckets: Ordmap(Nat, List(K × V)), size: Nat): Hmap(K, V)
}

module Hmap {
  pub fn buckets<K, V>(m: Hmap(K, V)): Ordmap(Nat, List(K × V)) {
    ⊢ Ordmap(Nat, List(K × V)) from match m {
      Mk(bs, n) => bs
    }
  }

  pub fn size<K, V>(m: Hmap(K, V)): Nat {
    ⊢ Nat from match m {
      Mk(bs, n) => n
    }
  }

  pub fn empty<K, V>(): Hmap(K, V) {
    Hmap::Mk(Ordmap::empty(), 0)
  }

  pub fn option_bucket<K, V>(o: Option(List(K × V))): List(K × V) {
    ⊢ List(K × V) from match o {
      None => Nil
      Some(b) => b
    }
  }

  // The bucket of the hash `h`, empty when there is none.
  pub fn bucket<K, V>(m: Hmap(K, V), h: Nat): List(K × V) {
    option_bucket(Ordmap::get(buckets(m), h, Ordmap::compare_nat))
  }

  pub fn get<K, V>(m: Hmap(K, V), k: K, hash: (K) -> Nat, eq: (K, K) -> Bool): Option(V) {
    bucket_get(bucket(m, hash(k)), k, eq)
  }

  pub fn contains<K, V>(m: Hmap(K, V), k: K, hash: (K) -> Nat, eq: (K, K) -> Bool): Bool {
    Ordmap::is_some(Hmap::get(m, k, hash, eq))
  }

  // `k` with the value `v`, in place of any value it had.
  pub fn insert<K, V>(m: Hmap(K, V), k: K, v: V, hash: (K) -> Nat, eq: (K, K) -> Bool): Hmap(K, V) {
    Hmap::Mk(
      Ordmap::insert(
        buckets(m),
        hash(k),
        bucket_insert(bucket(m, hash(k)), k, v, eq),
        Ordmap::compare_nat
      ),
      ⊢ Nat from match contains(m, k, hash, eq) {
        true => size(m)
        false => Succ(size(m))
      }
    )
  }

  // `b` as the bucket of the hash `h`; an empty bucket is taken out.
  pub fn put_bucket<K, V>(
    bs: Ordmap(Nat, List(K × V)),
    h: Nat,
    b: List(K × V)
  ): Ordmap(Nat, List(K × V)) {
    ⊢ Ordmap(Nat, List(K × V)) from match b {
      Nil => Ordmap::remove(bs, h, Ordmap::compare_nat)
      Cons(e, rest) => Ordmap::insert(bs, h, b, Ordmap::compare_nat)
    }
  }

  // What `Hmap::remove` gives when `k` is in the map.
  pub fn remove_cases<K, V>(
    m: Hmap(K, V),
    k: K,
    hash: (K) -> Nat,
    eq: (K, K) -> Bool,
    c: Bool
  ): Hmap(K, V) {
    ⊢ Hmap(K, V) from match c {
      false => m
      true => Hmap::Mk(
            put_bucket(buckets(m), hash(k), bucket_remove(bucket(m, hash(k)), k, eq)),
            ⊢ Nat from match size(m) {
              Zero => Zero
              Succ(n) => n
            }
          )
    }
  }

  // `k` taken out. A bucket left empty is taken out with it.
  pub fn remove<K, V>(m: Hmap(K, V), k: K, hash: (K) -> Nat, eq: (K, K) -> Bool): Hmap(K, V) {
    remove_cases(m, k, hash, eq, contains(m, k, hash, eq))
  }

  pub fn concat<K, V>(bs: List(Nat × List(K × V))): List(K × V) {
    ⊢ List(K × V) from match bs {
      Nil => Nil
      Cons(#(h, e), rest) => List::append(e, Hmap::concat(rest))
    }
  }

  // The entries, bucket by bucket in the order of the hashes.
  pub fn entries<K, V>(m: Hmap(K, V)): List(K × V) {
    Hmap::concat(Ordmap::entries(buckets(m)))
  }

  pub fn insert_all<K, V>(
    m: Hmap(K, V),
    l: List(K × V),
    hash: (K) -> Nat,
    eq: (K, K) -> Bool
  ): Hmap(K, V) {
    ⊢ Hmap(K, V) from match l {
      Nil => m
      Cons(#(key, value), rest) => insert_all(insert(m, key, value, hash, eq), rest, hash, eq)
    }
  }

  pub fn of_list<K, V>(l: List(K × V), hash: (K) -> Nat, eq: (K, K) -> Bool): Hmap(K, V) {
    insert_all(empty(), l, hash, eq)
  }

  // The buckets are ordered by their hashes: what the theorems below assume.
  pub fn ordered<K, V>(m: Hmap(K, V)): Prop {
    Ordmap::ordered(buckets(m), Ordmap::compare_nat)
  }

  pub theorem put_bucket_same<K: Type, V: Type>(
    bs: Ordmap(Nat, List(K × V)),
    h: Nat,
    b: List(K × V),
    ord: Ordmap::ordered(bs, Ordmap::compare_nat)
  ): option_bucket(Ordmap::get(put_bucket(bs, h, b), h, Ordmap::compare_nat)) = b {
    ⊢ option_bucket(Ordmap::get(put_bucket(bs, h, b), h, Ordmap::compare_nat)) = b from match b {
      Nil => Eq::congr(
        ⟦option_bucket(□)⟧,
        Ordmap::get_remove_same(Ordmap::compare_nat, Ordmap::compare_nat_law(), bs, h, ord)
      )
      Cons(e, rest) => Eq::congr(
        ⟦option_bucket(□)⟧,
        Ordmap::get_insert_same(
          Ordmap::compare_nat,
          Ordmap::compare_nat_law(),
          bs,
          h,
          Cons(e, rest),
          ord
        )
      )
    }
  }

  pub theorem put_bucket_other<K: Type, V: Type>(
    bs: Ordmap(Nat, List(K × V)),
    h: Nat,
    b: List(K × V),
    g: Nat,
    c: Ordering,
    ne: ¬(c = Equal),
    eg: Ordmap::compare_nat(g, h) = c,
    ord: Ordmap::ordered(bs, Ordmap::compare_nat)
  ): Ordmap::get(
    put_bucket(bs, h, b),
    g,
    Ordmap::compare_nat
  ) = Ordmap::get(bs, g, Ordmap::compare_nat) {
    ⊢ Ordmap::get(
      put_bucket(bs, h, b),
      g,
      Ordmap::compare_nat
    ) = Ordmap::get(bs, g, Ordmap::compare_nat) from match b {
      Nil => Ordmap::get_remove_other(
        Ordmap::compare_nat,
        Ordmap::compare_nat_law(),
        bs,
        h,
        g,
        c,
        ne,
        eg,
        ord
      )
      Cons(e, rest) => Ordmap::get_insert_other(
        Ordmap::compare_nat,
        Ordmap::compare_nat_law(),
        bs,
        h,
        Cons(e, rest),
        g,
        c,
        ne,
        eg,
        ord
      )
    }
  }

  pub theorem put_bucket_ordered<K: Type, V: Type>(
    bs: Ordmap(Nat, List(K × V)),
    h: Nat,
    b: List(K × V),
    ord: Ordmap::ordered(bs, Ordmap::compare_nat)
  ): Ordmap::ordered(put_bucket(bs, h, b), Ordmap::compare_nat) {
    ⊢ Ordmap::ordered(put_bucket(bs, h, b), Ordmap::compare_nat) from match b {
      Nil => Ordmap::remove_ordered(Ordmap::compare_nat, Ordmap::compare_nat_law(), bs, h, ord)
      Cons(e, rest) => Ordmap::insert_ordered(
        Ordmap::compare_nat,
        Ordmap::compare_nat_law(),
        bs,
        h,
        Cons(e, rest),
        ord
      )
    }
  }

  pub theorem empty_ordered<K: Type, V: Type>(): ordered(empty(<K: K, V: V>)) {
    Ordmap::empty_ordered(<K: Nat, V: List(K × V)>, Ordmap::compare_nat)
  }

  pub theorem insert_ordered<K: Type, V: Type>(
    m: Hmap(K, V),
    k: K,
    v: V,
    hash: (K) -> Nat,
    eq: (K, K) -> Bool,
    ord: ordered(m)
  ): ordered(insert(m, k, v, hash, eq)) {
    Ordmap::insert_ordered(
      Ordmap::compare_nat,
      Ordmap::compare_nat_law(),
      buckets(m),
      hash(k),
      bucket_insert(bucket(m, hash(k)), k, v, eq),
      ord
    )
  }

  pub theorem get_insert_same<K: Type, V: Type>(
    eq: (K, K) -> Bool,
    w: HashEq(K, eq),
    hash: (K) -> Nat,
    m: Hmap(K, V),
    k: K,
    v: V,
    ord: ordered(m)
  ): Hmap::get(insert(m, k, v, hash, eq), k, hash, eq) = Some(v) {
    Eq::trans(
      Eq::congr(
        ⟦bucket_get(option_bucket(□), k, eq)⟧,
        Ordmap::get_insert_same(
          Ordmap::compare_nat,
          Ordmap::compare_nat_law(),
          buckets(m),
          hash(k),
          bucket_insert(bucket(m, hash(k)), k, v, eq),
          ord
        )
      ),
      bucket_get_insert_same(eq, w, bucket(m, hash(k)), k, v)
    )
  }

  pub theorem get_insert_other<K: Type, V: Type>(
    eq: (K, K) -> Bool,
    w: HashEq(K, eq),
    hash: (K) -> Nat,
    m: Hmap(K, V),
    k: K,
    v: V,
    j: K,
    ne: eq(j, k) = false,
    ord: ordered(m)
  ): Hmap::get(insert(m, k, v, hash, eq), j, hash, eq) = Hmap::get(m, j, hash, eq) {
    Ordering::cases(
      (c: Ordering) => Hmap::get(insert(m, k, v, hash, eq), j, hash, eq) = Hmap::get(
        m,
        j,
        hash,
        eq
      ),
      Ordmap::compare_nat(hash(j), hash(k)),
      (e: Ordmap::compare_nat(hash(j), hash(k)) = Less) => Eq::congr(
        ⟦bucket_get(option_bucket(□), j, eq)⟧,
        Ordmap::get_insert_other(
          Ordmap::compare_nat,
          Ordmap::compare_nat_law(),
          buckets(m),
          hash(k),
          bucket_insert(bucket(m, hash(k)), k, v, eq),
          hash(j),
          Less,
          (x: Less = Equal) => less_ne_equal(x),
          e,
          ord
        )
      ),
      (e: Ordmap::compare_nat(hash(j), hash(k)) = Equal) => Eq::subst(
        (g: Nat) => bucket_get(
          option_bucket(
            Ordmap::get(
              Ordmap::insert(
                buckets(m),
                hash(k),
                bucket_insert(bucket(m, hash(k)), k, v, eq),
                Ordmap::compare_nat
              ),
              g,
              Ordmap::compare_nat
            )
          ),
          j,
          eq
        ) = bucket_get(bucket(m, g), j, eq),
        Eq::sym(Ordmap::compare_nat_eq(hash(j), hash(k), e)),
        Eq::trans(
          Eq::congr(
            ⟦bucket_get(option_bucket(□), j, eq)⟧,
            Ordmap::get_insert_same(
              Ordmap::compare_nat,
              Ordmap::compare_nat_law(),
              buckets(m),
              hash(k),
              bucket_insert(bucket(m, hash(k)), k, v, eq),
              ord
            )
          ),
          bucket_get_insert_other(eq, w, bucket(m, hash(k)), k, v, j, ne)
        )
      ),
      (e: Ordmap::compare_nat(hash(j), hash(k)) = Greater) => Eq::congr(
        ⟦bucket_get(option_bucket(□), j, eq)⟧,
        Ordmap::get_insert_other(
          Ordmap::compare_nat,
          Ordmap::compare_nat_law(),
          buckets(m),
          hash(k),
          bucket_insert(bucket(m, hash(k)), k, v, eq),
          hash(j),
          Greater,
          (x: Greater = Equal) => greater_ne_equal(x),
          e,
          ord
        )
      )
    )
  }

  pub theorem remove_ordered<K: Type, V: Type>(
    m: Hmap(K, V),
    k: K,
    hash: (K) -> Nat,
    eq: (K, K) -> Bool,
    ord: ordered(m)
  ): ordered(remove(m, k, hash, eq)) {
    ⊢ ordered(remove(m, k, hash, eq)) from match contains(m, k, hash, eq) {
      false => ⊢ ordered(remove_cases(m, k, hash, eq, false)) from ord
      true => ⊢ ordered(
        remove_cases(m, k, hash, eq, true)
      ) from put_bucket_ordered(buckets(m), hash(k), bucket_remove(bucket(m, hash(k)), k, eq), ord)
    }
  }

  pub theorem get_remove_same<K: Type, V: Type>(
    eq: (K, K) -> Bool,
    hash: (K) -> Nat,
    m: Hmap(K, V),
    k: K,
    ord: ordered(m)
  ): Hmap::get(remove(m, k, hash, eq), k, hash, eq) = None {
    ⊢ Hmap::get(
      remove(m, k, hash, eq),
      k,
      hash,
      eq
    ) = None from match contains(m, k, hash, eq) eqn h {
      false => ⊢ Hmap::get(
        remove_cases(m, k, hash, eq, false),
        k,
        hash,
        eq
      ) = None from Ordmap::is_some_false(Hmap::get(m, k, hash, eq), h)
      true => ⊢ Hmap::get(
        remove_cases(m, k, hash, eq, true),
        k,
        hash,
        eq
      ) = None from Eq::trans(
        Eq::congr(
          ⟦bucket_get(□, k, eq)⟧,
          put_bucket_same(buckets(m), hash(k), bucket_remove(bucket(m, hash(k)), k, eq), ord)
        ),
        bucket_get_remove_same(eq, bucket(m, hash(k)), k)
      )
    }
  }

  // Taking `k` out of the bucket of its hash keeps what any other key `j` has.
  pub theorem get_put_remove_other<K: Type, V: Type>(
    eq: (K, K) -> Bool,
    w: HashEq(K, eq),
    hash: (K) -> Nat,
    m: Hmap(K, V),
    k: K,
    j: K,
    ne: eq(j, k) = false,
    ord: ordered(m)
  ): bucket_get(
    option_bucket(
      Ordmap::get(
        put_bucket(buckets(m), hash(k), bucket_remove(bucket(m, hash(k)), k, eq)),
        hash(j),
        Ordmap::compare_nat
      )
    ),
    j,
    eq
  ) = Hmap::get(m, j, hash, eq) {
    Ordering::cases(
      (c: Ordering) => bucket_get(
        option_bucket(
          Ordmap::get(
            put_bucket(buckets(m), hash(k), bucket_remove(bucket(m, hash(k)), k, eq)),
            hash(j),
            Ordmap::compare_nat
          )
        ),
        j,
        eq
      ) = Hmap::get(m, j, hash, eq),
      Ordmap::compare_nat(hash(j), hash(k)),
      (e: Ordmap::compare_nat(hash(j), hash(k)) = Less) => Eq::congr(
        ⟦bucket_get(option_bucket(□), j, eq)⟧,
        put_bucket_other(
          buckets(m),
          hash(k),
          bucket_remove(bucket(m, hash(k)), k, eq),
          hash(j),
          Less,
          (x: Less = Equal) => less_ne_equal(x),
          e,
          ord
        )
      ),
      (e: Ordmap::compare_nat(hash(j), hash(k)) = Equal) => Eq::subst(
        (g: Nat) => bucket_get(
          option_bucket(
            Ordmap::get(
              put_bucket(buckets(m), hash(k), bucket_remove(bucket(m, hash(k)), k, eq)),
              g,
              Ordmap::compare_nat
            )
          ),
          j,
          eq
        ) = bucket_get(bucket(m, g), j, eq),
        Eq::sym(Ordmap::compare_nat_eq(hash(j), hash(k), e)),
        Eq::trans(
          Eq::congr(
            ⟦bucket_get(□, j, eq)⟧,
            put_bucket_same(buckets(m), hash(k), bucket_remove(bucket(m, hash(k)), k, eq), ord)
          ),
          bucket_get_remove_other(eq, w, bucket(m, hash(k)), k, j, ne)
        )
      ),
      (e: Ordmap::compare_nat(hash(j), hash(k)) = Greater) => Eq::congr(
        ⟦bucket_get(option_bucket(□), j, eq)⟧,
        put_bucket_other(
          buckets(m),
          hash(k),
          bucket_remove(bucket(m, hash(k)), k, eq),
          hash(j),
          Greater,
          (x: Greater = Equal) => greater_ne_equal(x),
          e,
          ord
        )
      )
    )
  }

  pub theorem get_remove_other<K: Type, V: Type>(
    eq: (K, K) -> Bool,
    w: HashEq(K, eq),
    hash: (K) -> Nat,
    m: Hmap(K, V),
    k: K,
    j: K,
    ne: eq(j, k) = false,
    ord: ordered(m)
  ): Hmap::get(remove(m, k, hash, eq), j, hash, eq) = Hmap::get(m, j, hash, eq) {
    ⊢ Hmap::get(
      remove(m, k, hash, eq),
      j,
      hash,
      eq
    ) = Hmap::get(m, j, hash, eq) from match contains(m, k, hash, eq) {
      false => ⊢ Hmap::get(
        remove_cases(m, k, hash, eq, false),
        j,
        hash,
        eq
      ) = Hmap::get(m, j, hash, eq) from Refl
      true => ⊢ Hmap::get(
        remove_cases(m, k, hash, eq, true),
        j,
        hash,
        eq
      ) = Hmap::get(m, j, hash, eq) from get_put_remove_other(eq, w, hash, m, k, j, ne, ord)
    }
  }
}

pub(open) inductive Hset(K: Type): Type {
  Mk(map: Hmap(K, Bool)): Hset(K)
}

module Hset {
  pub fn map<K>(s: Hset(K)): Hmap(K, Bool) {
    ⊢ Hmap(K, Bool) from match s {
      Mk(m) => m
    }
  }

  pub fn empty<K>(): Hset(K) {
    Hset::Mk(Hmap::empty())
  }

  pub fn size<K>(s: Hset(K)): Nat {
    Hmap::size(Hset::map(s))
  }

  pub fn contains<K>(s: Hset(K), k: K, hash: (K) -> Nat, eq: (K, K) -> Bool): Bool {
    Hmap::contains(Hset::map(s), k, hash, eq)
  }

  pub fn insert<K>(s: Hset(K), k: K, hash: (K) -> Nat, eq: (K, K) -> Bool): Hset(K) {
    Hset::Mk(Hmap::insert(Hset::map(s), k, true, hash, eq))
  }

  pub fn remove<K>(s: Hset(K), k: K, hash: (K) -> Nat, eq: (K, K) -> Bool): Hset(K) {
    Hset::Mk(Hmap::remove(Hset::map(s), k, hash, eq))
  }

  pub fn keys_of<K>(es: List(K × Bool)): List(K) {
    ⊢ List(K) from match es {
      Nil => Nil
      Cons(#(k, b), rest) => Cons(k, keys_of(rest))
    }
  }

  // The elements, in the order of `Hmap::entries`.
  pub fn to_list<K>(s: Hset(K)): List(K) {
    keys_of(Hmap::entries(Hset::map(s)))
  }

  pub fn ordered<K>(s: Hset(K)): Prop {
    Hmap::ordered(Hset::map(s))
  }

  pub theorem contains_insert_same<K: Type>(
    eq: (K, K) -> Bool,
    w: HashEq(K, eq),
    hash: (K) -> Nat,
    s: Hset(K),
    k: K,
    ord: ordered(s)
  ): contains(insert(s, k, hash, eq), k, hash, eq) = true {
    Eq::congr(⟦Ordmap::is_some(□)⟧, Hmap::get_insert_same(eq, w, hash, Hset::map(s), k, true, ord))
  }

  pub theorem contains_insert_other<K: Type>(
    eq: (K, K) -> Bool,
    w: HashEq(K, eq),
    hash: (K) -> Nat,
    s: Hset(K),
    k: K,
    j: K,
    ne: eq(j, k) = false,
    ord: ordered(s)
  ): contains(insert(s, k, hash, eq), j, hash, eq) = contains(s, j, hash, eq) {
    Eq::congr(
      ⟦Ordmap::is_some(□)⟧,
      Hmap::get_insert_other(eq, w, hash, Hset::map(s), k, true, j, ne, ord)
    )
  }

  pub theorem contains_remove_same<K: Type>(
    eq: (K, K) -> Bool,
    hash: (K) -> Nat,
    s: Hset(K),
    k: K,
    ord: ordered(s)
  ): contains(remove(s, k, hash, eq), k, hash, eq) = false {
    Eq::congr(⟦Ordmap::is_some(□)⟧, Hmap::get_remove_same(eq, hash, Hset::map(s), k, ord))
  }

  pub theorem contains_remove_other<K: Type>(
    eq: (K, K) -> Bool,
    w: HashEq(K, eq),
    hash: (K) -> Nat,
    s: Hset(K),
    k: K,
    j: K,
    ne: eq(j, k) = false,
    ord: ordered(s)
  ): contains(remove(s, k, hash, eq), j, hash, eq) = contains(s, j, hash, eq) {
    Eq::congr(
      ⟦Ordmap::is_some(□)⟧,
      Hmap::get_remove_other(eq, w, hash, Hset::map(s), k, j, ne, ord)
    )
  }

  pub theorem insert_ordered<K: Type>(
    hash: (K) -> Nat,
    eq: (K, K) -> Bool,
    s: Hset(K),
    k: K,
    ord: ordered(s)
  ): ordered(insert(s, k, hash, eq)) {
    Hmap::insert_ordered(Hset::map(s), k, true, hash, eq, ord)
  }

  pub theorem remove_ordered<K: Type>(
    hash: (K) -> Nat,
    eq: (K, K) -> Bool,
    s: Hset(K),
    k: K,
    ord: ordered(s)
  ): ordered(remove(s, k, hash, eq)) {
    Hmap::remove_ordered(Hset::map(s), k, hash, eq, ord)
  }
}
