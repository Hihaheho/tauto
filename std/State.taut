import std::prelude::Std { List }

// The postcondition describes the exact state returned by the transition.
pub def StateHoare(
  S: Type,
  C: Type,
  step: (S, C) -> S,
  pre: (S, C) -> Prop,
  post: (S, C, S) -> Prop
): Prop :=
∀ s: S, c: C. (pre(s, c)) -> post(s, c, step(s, c))

pub def StatePreserves(S: Type, C: Type, step: (S, C) -> S, invariant: (S) -> Prop): Prop :=
∀ s: S, c: C. (invariant(s)) -> invariant(step(s, c))

pub fn state_run<S, C>(step: (S, C) -> S, commands: List(C), state: S): S {
  ⊢ S from match commands {
    Nil => state
    Cons(command, rest) => state_run(step, rest, step(state, command))
  }
}

pub theorem state_run_preserves<S: Type, C: Type>(
  step: (S, C) -> S,
  invariant: (S) -> Prop,
  safe: StatePreserves(S, C, step, invariant),
  commands: List(C),
  state: S,
  valid: invariant(state)
): invariant(state_run(step, commands, state)) {
  ⊢ invariant(state_run(step, commands, state)) from match commands {
    Nil => valid
    Cons(command, rest) => state_run_preserves(
      step,
      invariant,
      safe,
      rest,
      step(state, command),
      safe(state, command, valid)
    )
  }
}

// The proof-bearing entry point erases to the same state interpreter.
pub fn state_certified_run<S, C>(
  step: (S, C) -> S,
  invariant: (S) -> Prop,
  safe: StatePreserves(S, C, step, invariant),
  commands: List(C),
  state: S,
  valid: invariant(state)
): S { state_run(step, commands, state) }

pub theorem state_certified_run_preserves<S: Type, C: Type>(
  step: (S, C) -> S,
  invariant: (S) -> Prop,
  safe: StatePreserves(S, C, step, invariant),
  commands: List(C),
  state: S,
  valid: invariant(state)
): invariant(state_certified_run(step, invariant, safe, commands, state, valid)) {
  state_run_preserves(step, invariant, safe, commands, state, valid)
}
