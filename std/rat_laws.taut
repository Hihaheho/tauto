import "rat.taut" { Int, Rat }
import "int_order.taut" { Int, IntLe }
import "nat_div.taut" { Nat }
import "base.taut" { Nat }
import "int.taut" { Int }
import "int_laws.taut" { Int, Nat }
import "calc.taut" { calc }

// The laws of `Rat`'s arithmetic (`std/Rat::taut`). A number has many
// representations, so the laws hold up to `equiv`, the same number:
// `a / b` and `c / d` are the same when `a d = c b`. `Rat::add` and `Rat::mul`
// reduce their results, and `Rat::reduce_equiv` says a reduced fraction is
// the same number; the rest is `int_norm!`.

pub def Rat::equiv(
  x: Rat,
  y: Rat
): Prop := Int::mul(Rat::num(x), IntOfNat(Rat::den(y))) = Int::mul(Rat::num(y), IntOfNat(Rat::den(x)))

pub theorem Rat::equiv_refl(x: Rat): Rat::equiv(x, x) {
  Refl
}

pub theorem Rat::equiv_symm(x: Rat, y: Rat, h: Rat::equiv(x, y)): Rat::equiv(y, x) {
  Eq::sym(h)
}

pub theorem Rat::equiv_trans(x: Rat, y: Rat, z: Rat, h1: Rat::equiv(x, y), h2: Rat::equiv(y, z)): Rat::equiv(x, z) {
  match y {
    Mk(b, q) => Rat::equiv_trans_at(Rat::num(x), IntOfNat(Rat::den(x)), b, q, Rat::num(z), IntOfNat(Rat::den(z)), h1, h2)
  }
}

pub theorem Rat::equiv_trans_at(
  X: Int,
  P: Int,
  b: Int,
  q: Nat,
  Z: Int,
  R: Int,
  h1: Int::mul(X, IntOfNat(Succ(q))) = Int::mul(b, P),
  h2: Int::mul(b, R) = Int::mul(Z, IntOfNat(Succ(q)))
): Int::mul(X, R) = Int::mul(Z, P) {
  let Q: Int := IntOfNat(Succ(q))
  let s1: Int::mul(
    Int::mul(X, R),
    Q
  ) = Int::mul(
    Int::mul(X, Q),
    R
  ) := by int_norm!(): Int::mul(
    Int::mul(X, R),
    IntOfNat(Succ(q))
  ) = Int::mul(Int::mul(X, IntOfNat(Succ(q))), R) {}
  let s2: Int::mul(
    Int::mul(X, Q),
    R
  ) = Int::mul(Int::mul(b, P), R) := Eq::congr(⟦Int::mul(□, R)⟧, h1)
  let s3: Int::mul(
    Int::mul(b, P),
    R
  ) = Int::mul(
    Int::mul(b, R),
    P
  ) := by int_norm!(): Int::mul(Int::mul(b, P), R) = Int::mul(Int::mul(b, R), P) {}
  let s4: Int::mul(
    Int::mul(b, R),
    P
  ) = Int::mul(Int::mul(Z, Q), P) := Eq::congr(⟦Int::mul(□, P)⟧, h2)
  let s5: Int::mul(
    Int::mul(Z, Q),
    P
  ) = Int::mul(
    Int::mul(Z, P),
    Q
  ) := by int_norm!(): Int::mul(
    Int::mul(Z, IntOfNat(Succ(q))),
    P
  ) = Int::mul(Int::mul(Z, P), IntOfNat(Succ(q))) {}
  Int::mul_cancel(
    Int::mul(X, R),
    Int::mul(Z, P),
    q,
    calc!(```
      $Int::mul(Int::mul(X, R), Q)
      = $Int::mul(Int::mul(X, Q), R) from $s1
      = $Int::mul(Int::mul(b, P), R) from $s2
      = $Int::mul(Int::mul(b, R), P) from $s3
      = $Int::mul(Int::mul(Z, Q), P) from $s4
      = $Int::mul(Int::mul(Z, P), Q) from $s5
      ```)
  )
}


pub theorem Int::eq_sound(x: Int, y: Int, h: Int::eq(x, y) = true): x = y {
  match x {
    IntOfNat(a) => ⊢ IntOfNat(a) = y from match y {
      IntOfNat(b) => Eq::congr(IntOfNat, Nat::eq_sound(a, b, h))
      IntNegSucc(b) => False::elim(false_ne_true(h))
    }
    IntNegSucc(a) => ⊢ IntNegSucc(a) = y from match y {
      IntOfNat(b) => False::elim(false_ne_true(h))
      IntNegSucc(b) => Eq::congr(IntNegSucc, Nat::eq_sound(a, b, h))
    }
  }
}

pub theorem Rat::eq_sound(x: Rat, y: Rat, h: Rat::eq(x, y) = true): Rat::equiv(x, y) {
  Int::eq_sound(Int::mul(Rat::num(x), IntOfNat(Rat::den(y))), Int::mul(Rat::num(y), IntOfNat(Rat::den(x))), h)
}

pub theorem Rat::div_cross(
  a: Nat,
  s: Nat,
  g: Nat,
  k: Nat,
  j: Nat,
  ha: a = Nat::mul(g, k),
  hs: s = Nat::mul(g, j)
): Int::mul(IntOfNat(k), IntOfNat(s)) = Int::mul(IntOfNat(a), IntOfNat(j)) {
  let e: Int::mul(
    IntOfNat(k),
    IntOfNat(Nat::mul(g, j))
  ) = Int::mul(
    IntOfNat(Nat::mul(g, k)),
    IntOfNat(j)
  ) := by int_norm!(): Int::mul(
    IntOfNat(k),
    IntOfNat(Nat::mul(g, j))
  ) = Int::mul(IntOfNat(Nat::mul(g, k)), IntOfNat(j)) {}
  Eq::subst(
    (z: Nat) => Int::mul(IntOfNat(k), IntOfNat(s)) = Int::mul(IntOfNat(z), IntOfNat(j)),
    Eq::sym(ha),
    Eq::subst(
      (z: Nat) => Int::mul(
        IntOfNat(k),
        IntOfNat(z)
      ) = Int::mul(IntOfNat(Nat::mul(g, k)), IntOfNat(j)),
      Eq::sym(hs),
      e
    )
  )
}

pub theorem Rat::div_cross_neg(
  a: Nat,
  s: Nat,
  g: Nat,
  k: Nat,
  j: Nat,
  ha: a = Nat::mul(g, k),
  hs: s = Nat::mul(g, j)
): Int::mul(Int::neg(IntOfNat(k)), IntOfNat(s)) = Int::mul(Int::neg(IntOfNat(a)), IntOfNat(j)) {
  let e: Int::mul(
    IntOfNat(k),
    IntOfNat(s)
  ) = Int::mul(IntOfNat(a), IntOfNat(j)) := Rat::div_cross(a, s, g, k, j, ha, hs)
  let l: Int::mul(
    Int::neg(IntOfNat(k)),
    IntOfNat(s)
  ) = Int::neg(
    Int::mul(IntOfNat(k), IntOfNat(s))
  ) := by int_norm!(): Int::mul(
    Int::neg(IntOfNat(k)),
    IntOfNat(s)
  ) = Int::neg(Int::mul(IntOfNat(k), IntOfNat(s))) {}
  let r: Int::neg(
    Int::mul(IntOfNat(a), IntOfNat(j))
  ) = Int::mul(
    Int::neg(IntOfNat(a)),
    IntOfNat(j)
  ) := by int_norm!(): Int::neg(
    Int::mul(IntOfNat(a), IntOfNat(j))
  ) = Int::mul(Int::neg(IntOfNat(a)), IntOfNat(j)) {}
  calc!(```
    $Int::mul(Int::neg(IntOfNat(k)), IntOfNat(s))
    = $Int::neg(Int::mul(IntOfNat(k), IntOfNat(s))) from $l
    = $Int::neg(Int::mul(IntOfNat(a), IntOfNat(j))) from $Eq::congr(Int::neg, e)
    = $Int::mul(Int::neg(IntOfNat(a)), IntOfNat(j)) from $r
    ```)
}

pub theorem Nat::div_exact(
  d: Nat,
  g: Nat,
  hg: ¬(g = 0),
  h: Nat::eq(Nat::rem_nz(d, g, hg), 0) = true
): d = Nat::mul(g, Nat::div_nz(d, g, hg)) {
  Eq::sym(
    Eq::subst(
      (r: Nat) => Nat::add(Nat::mul(g, Nat::div_nz(d, g, hg)), r) = d,
      Nat::eq_sound(Nat::rem_nz(d, g, hg), 0, h),
      Nat::div_mod_eq(d, g, hg)
    )
  )
}

pub theorem Nat::factor_succ(m: Nat, g: Nat, j: Nat, h: Succ(m) = Nat::mul(g, j)): j = Succ(j - 1) {
  match j {
    Zero => False::elim(Nat::zero_ne_succ(m, Eq::sym(h)))
    Succ(k) => Refl
  }
}

pub theorem Rat::divided_equiv(
  n: Int,
  m: Nat,
  g: Nat,
  hg: ¬(g = 0),
  e: Rat::divides(n, Succ(m), g, hg) = true
): Rat::equiv(Rat::Mk(Int::div_nat(n, g, hg), Nat::div_nz(Succ(m), g, hg) - 1), Rat::Mk(n, m)) {
  let both: Nat::eq(
    Nat::rem_nz(Succ(m), g, hg),
    0
  ) = true ∧ Nat::eq(
    Nat::rem_nz(Int::abs_nat(n), g, hg),
    0
  ) = true := Bool::and_split(
    Nat::eq(Nat::rem_nz(Succ(m), g, hg), 0),
    Nat::eq(Nat::rem_nz(Int::abs_nat(n), g, hg), 0),
    e
  )
  ⊢ Rat::equiv(
    Rat::Mk(Int::div_nat(n, g, hg), Nat::div_nz(Succ(m), g, hg) - 1),
    Rat::Mk(n, m)
  ) from match both {
    AndIntro(hd, hn) => Rat::divided_equiv_at(
      n,
      m,
      g,
      hg,
      Nat::div_exact(Succ(m), g, hg, hd),
      Nat::div_exact(Int::abs_nat(n), g, hg, hn)
    )
  }
}

pub theorem Rat::divided_equiv_at(
  n: Int,
  m: Nat,
  g: Nat,
  hg: ¬(g = 0),
  hs: Succ(m) = Nat::mul(g, Nat::div_nz(Succ(m), g, hg)),
  ha: Int::abs_nat(n) = Nat::mul(g, Nat::div_nz(Int::abs_nat(n), g, hg))
): Rat::equiv(Rat::Mk(Int::div_nat(n, g, hg), Nat::div_nz(Succ(m), g, hg) - 1), Rat::Mk(n, m)) {
  Eq::subst(
    (z: Nat) => Int::mul(Int::div_nat(n, g, hg), IntOfNat(Succ(m))) = Int::mul(n, IntOfNat(z)),
    Nat::factor_succ(m, g, Nat::div_nz(Succ(m), g, hg), hs),
    ⊢ Int::mul(Int::div_nat(n, g, hg), IntOfNat(Succ(m))) = Int::mul(n, IntOfNat(Nat::div_nz(Succ(m), g, hg))) from match n {
      IntOfNat(a) => Rat::div_cross(a, Succ(m), g, Nat::div_nz(a, g, hg), Nat::div_nz(Succ(m), g, hg), ha, hs)
      IntNegSucc(b) => Rat::div_cross_neg(Succ(b), Succ(m), g, Nat::div_nz(Succ(b), g, hg), Nat::div_nz(Succ(m), g, hg), ha, hs)
    }
  )
}

pub theorem Rat::reduce_by_equiv(
  n: Int,
  m: Nat,
  g: Nat,
  hg: ¬(g = 0)
): Rat::equiv(Rat::reduce_by(n, Succ(m), g, hg), Rat::Mk(n, m)) {
  Rat::reduce_by_equiv_at(n, m, g, hg, Rat::divides(n, Succ(m), g, hg), Refl)
}

pub theorem Rat::reduce_by_equiv_at(
  n: Int,
  m: Nat,
  g: Nat,
  hg: ¬(g = 0),
  o: Bool,
  e: Rat::divides(n, Succ(m), g, hg) = o
): Rat::equiv(
  Rat::pick_by(o, Rat::Mk(n, m), Rat::Mk(Int::div_nat(n, g, hg), Nat::div_nz(Succ(m), g, hg) - 1)),
  Rat::Mk(n, m)
) {
  ⊢ Rat::equiv(
    Rat::pick_by(o, Rat::Mk(n, m), Rat::Mk(Int::div_nat(n, g, hg), Nat::div_nz(Succ(m), g, hg) - 1)),
    Rat::Mk(n, m)
  ) from match o {
    false => Rat::equiv_refl(Rat::Mk(n, m))
    true => Rat::divided_equiv(n, m, g, hg, e)
  }
}

pub theorem Rat::reduce_equiv(n: Int, m: Nat): Rat::equiv(Rat::reduce(n, Succ(m)), Rat::Mk(n, m)) {
  ⊢ Rat::equiv(
    Rat::reduce(n, Succ(m)),
    Rat::Mk(n, m)
  ) from match Nat::eq(Rat::gcd(400, Succ(m), Int::abs_nat(n)), 0) eqn hg {
    true => ⊢ Rat::equiv(Rat::Mk(n, Succ(m) - 1), Rat::Mk(n, m)) from Rat::equiv_refl(Rat::Mk(n, m))
    false => ⊢ Rat::equiv(
      Rat::reduce_by(
        n,
        Succ(m),
        Rat::gcd(400, Succ(m), Int::abs_nat(n)),
        Nat::ne_zero(Rat::gcd(400, Succ(m), Int::abs_nat(n)), hg)
      ),
      Rat::Mk(n, m)
    ) from Rat::reduce_by_equiv(
      n,
      m,
      Rat::gcd(400, Succ(m), Int::abs_nat(n)),
      Nat::ne_zero(Rat::gcd(400, Succ(m), Int::abs_nat(n)), hg)
    )
  }
}

pub fn Rat::zero(): Rat {
  Rat::Mk(IntOfNat(0), 0)
}

pub fn Rat::one(): Rat {
  Rat::Mk(IntOfNat(1), 0)
}

// `a / P + b / Q = (a Q + b P) / (P Q)`, with `P Q = (P Q - 1) + 1` written so
// that it is `Succ` of something.
pub fn Rat::add_raw(x: Rat, y: Rat): Rat {
  match x {
    Mk(a, p) => ⊢ Rat from match y {
      Mk(b, q) => Rat::Mk(
        Int::add(Int::mul(a, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p)))),
        Nat::add(Nat::mul(Succ(p), q), p)
      )
    }
  }
}

pub fn Rat::mul_raw(x: Rat, y: Rat): Rat {
  match x {
    Mk(a, p) => ⊢ Rat from match y {
      Mk(b, q) => Rat::Mk(Int::mul(a, b), Nat::add(Nat::mul(Succ(p), q), p))
    }
  }
}

pub theorem Rat::add_val(x: Rat, y: Rat): Rat::equiv(Rat::add(x, y), Rat::add_raw(x, y)) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(Rat::add(Rat::Mk(a, p), y), Rat::add_raw(Rat::Mk(a, p), y)) from match y {
      Mk(b, q) => Rat::reduce_equiv(
        Int::add(Int::mul(a, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p)))),
        Nat::add(Nat::mul(Succ(p), q), p)
      )
    }
  }
}

pub theorem Rat::mul_val(x: Rat, y: Rat): Rat::equiv(Rat::mul(x, y), Rat::mul_raw(x, y)) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(Rat::mul(Rat::Mk(a, p), y), Rat::mul_raw(Rat::Mk(a, p), y)) from match y {
      Mk(b, q) => Rat::reduce_equiv(Int::mul(a, b), Nat::add(Nat::mul(Succ(p), q), p))
    }
  }
}

pub theorem Rat::add_raw_comm(x: Rat, y: Rat): Rat::equiv(Rat::add_raw(x, y), Rat::add_raw(y, x)) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(Rat::add_raw(Rat::Mk(a, p), y), Rat::add_raw(y, Rat::Mk(a, p))) from match y {
      Mk(b, q) => {
        let e: Int::mul(
          Int::add(Int::mul(a, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p)))),
          Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(p)))
        ) = Int::mul(
          Int::add(Int::mul(b, IntOfNat(Succ(p))), Int::mul(a, IntOfNat(Succ(q)))),
          Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))
        ) := by int_norm!(): Int::mul(
          Int::add(Int::mul(a, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p)))),
          Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(p)))
        ) = Int::mul(
          Int::add(Int::mul(b, IntOfNat(Succ(p))), Int::mul(a, IntOfNat(Succ(q)))),
          Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))
        ) {}
        e
      }
    }
  }
}

pub theorem Rat::add_raw_assoc(
  x: Rat,
  y: Rat,
  z: Rat
): Rat::equiv(Rat::add_raw(Rat::add_raw(x, y), z), Rat::add_raw(x, Rat::add_raw(y, z))) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(
      Rat::add_raw(Rat::add_raw(Rat::Mk(a, p), y), z),
      Rat::add_raw(Rat::Mk(a, p), Rat::add_raw(y, z))
    ) from match y {
      Mk(b, q) => ⊢ Rat::equiv(
        Rat::add_raw(Rat::add_raw(Rat::Mk(a, p), Rat::Mk(b, q)), z),
        Rat::add_raw(Rat::Mk(a, p), Rat::add_raw(Rat::Mk(b, q), z))
      ) from match z {
        Mk(c, r) => {
          let e: Int::mul(
            Int::add(
              Int::mul(
                Int::add(Int::mul(a, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p)))),
                IntOfNat(Succ(r))
              ),
              Int::mul(c, Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))))
            ),
            Int::mul(IntOfNat(Succ(p)), Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r))))
          ) = Int::mul(
            Int::add(
              Int::mul(a, Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r)))),
              Int::mul(
                Int::add(Int::mul(b, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(q)))),
                IntOfNat(Succ(p))
              )
            ),
            Int::mul(Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))), IntOfNat(Succ(r)))
          ) := by int_norm!(): Int::mul(
            Int::add(
              Int::mul(
                Int::add(Int::mul(a, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p)))),
                IntOfNat(Succ(r))
              ),
              Int::mul(c, Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))))
            ),
            Int::mul(IntOfNat(Succ(p)), Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r))))
          ) = Int::mul(
            Int::add(
              Int::mul(a, Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r)))),
              Int::mul(
                Int::add(Int::mul(b, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(q)))),
                IntOfNat(Succ(p))
              )
            ),
            Int::mul(Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))), IntOfNat(Succ(r)))
          ) {}
          e
        }
      }
    }
  }
}

pub theorem Rat::mul_raw_comm(x: Rat, y: Rat): Rat::equiv(Rat::mul_raw(x, y), Rat::mul_raw(y, x)) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(Rat::mul_raw(Rat::Mk(a, p), y), Rat::mul_raw(y, Rat::Mk(a, p))) from match y {
      Mk(b, q) => {
        let e: Int::mul(
          Int::mul(a, b),
          Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(p)))
        ) = Int::mul(
          Int::mul(b, a),
          Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))
        ) := by int_norm!(): Int::mul(
          Int::mul(a, b),
          Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(p)))
        ) = Int::mul(Int::mul(b, a), Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))) {}
        e
      }
    }
  }
}

pub theorem Rat::mul_raw_assoc(
  x: Rat,
  y: Rat,
  z: Rat
): Rat::equiv(Rat::mul_raw(Rat::mul_raw(x, y), z), Rat::mul_raw(x, Rat::mul_raw(y, z))) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(
      Rat::mul_raw(Rat::mul_raw(Rat::Mk(a, p), y), z),
      Rat::mul_raw(Rat::Mk(a, p), Rat::mul_raw(y, z))
    ) from match y {
      Mk(b, q) => ⊢ Rat::equiv(
        Rat::mul_raw(Rat::mul_raw(Rat::Mk(a, p), Rat::Mk(b, q)), z),
        Rat::mul_raw(Rat::Mk(a, p), Rat::mul_raw(Rat::Mk(b, q), z))
      ) from match z {
        Mk(c, r) => {
          let e: Int::mul(
            Int::mul(Int::mul(a, b), c),
            Int::mul(IntOfNat(Succ(p)), Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r))))
          ) = Int::mul(
            Int::mul(a, Int::mul(b, c)),
            Int::mul(Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))), IntOfNat(Succ(r)))
          ) := by int_norm!(): Int::mul(
            Int::mul(Int::mul(a, b), c),
            Int::mul(IntOfNat(Succ(p)), Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r))))
          ) = Int::mul(
            Int::mul(a, Int::mul(b, c)),
            Int::mul(Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))), IntOfNat(Succ(r)))
          ) {}
          e
        }
      }
    }
  }
}

pub theorem Rat::mul_raw_add(
  x: Rat,
  y: Rat,
  z: Rat
): Rat::equiv(Rat::mul_raw(x, Rat::add_raw(y, z)), Rat::add_raw(Rat::mul_raw(x, y), Rat::mul_raw(x, z))) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(
      Rat::mul_raw(Rat::Mk(a, p), Rat::add_raw(y, z)),
      Rat::add_raw(Rat::mul_raw(Rat::Mk(a, p), y), Rat::mul_raw(Rat::Mk(a, p), z))
    ) from match y {
      Mk(b, q) => ⊢ Rat::equiv(
        Rat::mul_raw(Rat::Mk(a, p), Rat::add_raw(Rat::Mk(b, q), z)),
        Rat::add_raw(Rat::mul_raw(Rat::Mk(a, p), Rat::Mk(b, q)), Rat::mul_raw(Rat::Mk(a, p), z))
      ) from match z {
        Mk(c, r) => {
          let e: Int::mul(
            Int::mul(a, Int::add(Int::mul(b, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(q))))),
            Int::mul(
              Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))),
              Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(r)))
            )
          ) = Int::mul(
            Int::add(
              Int::mul(Int::mul(a, b), Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(r)))),
              Int::mul(Int::mul(a, c), Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))))
            ),
            Int::mul(IntOfNat(Succ(p)), Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r))))
          ) := by int_norm!(): Int::mul(
            Int::mul(a, Int::add(Int::mul(b, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(q))))),
            Int::mul(
              Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))),
              Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(r)))
            )
          ) = Int::mul(
            Int::add(
              Int::mul(Int::mul(a, b), Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(r)))),
              Int::mul(Int::mul(a, c), Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q))))
            ),
            Int::mul(IntOfNat(Succ(p)), Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r))))
          ) {}
          e
        }
      }
    }
  }
}

pub theorem Rat::add_raw_zero(x: Rat): Rat::equiv(Rat::add_raw(x, Rat::zero()), x) {
  match x {
    Mk(a, p) => {
      let e: Int::mul(
        Int::add(Int::mul(a, 1), Int::mul(0, IntOfNat(Succ(p)))),
        IntOfNat(Succ(p))
      ) = Int::mul(
        a,
        Int::mul(IntOfNat(Succ(p)), 1)
      ) := by int_norm!(): Int::mul(
        Int::add(Int::mul(a, 1), Int::mul(0, IntOfNat(Succ(p)))),
        IntOfNat(Succ(p))
      ) = Int::mul(a, Int::mul(IntOfNat(Succ(p)), 1)) {}
      e
    }
  }
}

pub theorem Rat::add_raw_neg(x: Rat): Rat::equiv(Rat::add_raw(x, Rat::neg(x)), Rat::zero()) {
  match x {
    Mk(a, p) => {
      let e: Int::mul(
        Int::add(Int::mul(a, IntOfNat(Succ(p))), Int::mul(Int::neg(a), IntOfNat(Succ(p)))),
        1
      ) = Int::mul(
        0,
        Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(p)))
      ) := by int_norm!(): Int::mul(
        Int::add(Int::mul(a, IntOfNat(Succ(p))), Int::mul(Int::neg(a), IntOfNat(Succ(p)))),
        1
      ) = Int::mul(0, Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(p)))) {}
      e
    }
  }
}

pub theorem Rat::mul_raw_one(x: Rat): Rat::equiv(Rat::mul_raw(x, Rat::one()), x) {
  match x {
    Mk(a, p) => {
      let e: Int::mul(
        Int::mul(a, 1),
        IntOfNat(Succ(p))
      ) = Int::mul(
        a,
        Int::mul(IntOfNat(Succ(p)), 1)
      ) := by int_norm!(): Int::mul(
        Int::mul(a, 1),
        IntOfNat(Succ(p))
      ) = Int::mul(a, Int::mul(IntOfNat(Succ(p)), 1)) {}
      e
    }
  }
}

pub theorem Rat::add_raw_congl(
  x: Rat,
  x2: Rat,
  y: Rat,
  h: Rat::equiv(x, x2)
): Rat::equiv(Rat::add_raw(x, y), Rat::add_raw(x2, y)) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(Rat::add_raw(Rat::Mk(a, p), y), Rat::add_raw(x2, y)) from match x2 {
      Mk(a2, p2) => ⊢ Rat::equiv(Rat::add_raw(Rat::Mk(a, p), y), Rat::add_raw(Rat::Mk(a2, p2), y)) from match y {
        Mk(b, q) => {
          let s1: Int::mul(
            Int::add(Int::mul(a, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p)))),
            Int::mul(IntOfNat(Succ(p2)), IntOfNat(Succ(q)))
          ) = Int::add(
            Int::mul(
              Int::mul(a, IntOfNat(Succ(p2))),
              Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(q)))
            ),
            Int::mul(
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2))),
              IntOfNat(Succ(q))
            )
          ) := by int_norm!(): Int::mul(
            Int::add(Int::mul(a, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p)))),
            Int::mul(IntOfNat(Succ(p2)), IntOfNat(Succ(q)))
          ) = Int::add(
            Int::mul(
              Int::mul(a, IntOfNat(Succ(p2))),
              Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(q)))
            ),
            Int::mul(
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2))),
              IntOfNat(Succ(q))
            )
          ) {}
          let s2: Int::add(
            Int::mul(
              Int::mul(a, IntOfNat(Succ(p2))),
              Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(q)))
            ),
            Int::mul(
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2))),
              IntOfNat(Succ(q))
            )
          ) = Int::add(
            Int::mul(
              Int::mul(a2, IntOfNat(Succ(p))),
              Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(q)))
            ),
            Int::mul(
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2))),
              IntOfNat(Succ(q))
            )
          ) := Eq::congr(
            ⟦Int::add(
              Int::mul(□, Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(q)))),
              Int::mul(
                Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2))),
                IntOfNat(Succ(q))
              )
            )⟧,
            h
          )
          let s3: Int::add(
            Int::mul(
              Int::mul(a2, IntOfNat(Succ(p))),
              Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(q)))
            ),
            Int::mul(
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2))),
              IntOfNat(Succ(q))
            )
          ) = Int::mul(
            Int::add(Int::mul(a2, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p2)))),
            Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))
          ) := by int_norm!(): Int::add(
            Int::mul(
              Int::mul(a2, IntOfNat(Succ(p))),
              Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(q)))
            ),
            Int::mul(
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2))),
              IntOfNat(Succ(q))
            )
          ) = Int::mul(
            Int::add(Int::mul(a2, IntOfNat(Succ(q))), Int::mul(b, IntOfNat(Succ(p2)))),
            Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))
          ) {}
          Eq::trans(s1, Eq::trans(s2, s3))
        }
      }
    }
  }
}

pub theorem Rat::mul_raw_congl(
  x: Rat,
  x2: Rat,
  y: Rat,
  h: Rat::equiv(x, x2)
): Rat::equiv(Rat::mul_raw(x, y), Rat::mul_raw(x2, y)) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(Rat::mul_raw(Rat::Mk(a, p), y), Rat::mul_raw(x2, y)) from match x2 {
      Mk(a2, p2) => ⊢ Rat::equiv(Rat::mul_raw(Rat::Mk(a, p), y), Rat::mul_raw(Rat::Mk(a2, p2), y)) from match y {
        Mk(b, q) => {
          let s1: Int::mul(
            Int::mul(a, b),
            Int::mul(IntOfNat(Succ(p2)), IntOfNat(Succ(q)))
          ) = Int::mul(
            Int::mul(a, IntOfNat(Succ(p2))),
            Int::mul(b, IntOfNat(Succ(q)))
          ) := by int_norm!(): Int::mul(
            Int::mul(a, b),
            Int::mul(IntOfNat(Succ(p2)), IntOfNat(Succ(q)))
          ) = Int::mul(Int::mul(a, IntOfNat(Succ(p2))), Int::mul(b, IntOfNat(Succ(q)))) {}
          let s2: Int::mul(
            Int::mul(a, IntOfNat(Succ(p2))),
            Int::mul(b, IntOfNat(Succ(q)))
          ) = Int::mul(
            Int::mul(a2, IntOfNat(Succ(p))),
            Int::mul(b, IntOfNat(Succ(q)))
          ) := Eq::congr(⟦Int::mul(□, Int::mul(b, IntOfNat(Succ(q))))⟧, h)
          let s3: Int::mul(
            Int::mul(a2, IntOfNat(Succ(p))),
            Int::mul(b, IntOfNat(Succ(q)))
          ) = Int::mul(
            Int::mul(a2, b),
            Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))
          ) := by int_norm!(): Int::mul(
            Int::mul(a2, IntOfNat(Succ(p))),
            Int::mul(b, IntOfNat(Succ(q)))
          ) = Int::mul(Int::mul(a2, b), Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))) {}
          calc!(```
            $Int::mul(Int::mul(a, b), Int::mul(IntOfNat(Succ(p2)), IntOfNat(Succ(q))))
            = $Int::mul(Int::mul(a, IntOfNat(Succ(p2))), Int::mul(b, IntOfNat(Succ(q)))) from $s1
            = $Int::mul(Int::mul(a2, IntOfNat(Succ(p))), Int::mul(b, IntOfNat(Succ(q)))) from $s2
            = $Int::mul(Int::mul(a2, b), Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))) from $s3
            ```)
        }
      }
    }
  }
}

pub theorem Rat::neg_congr(x: Rat, x2: Rat, h: Rat::equiv(x, x2)): Rat::equiv(Rat::neg(x), Rat::neg(x2)) {
  match x {
    Mk(a, p) => ⊢ Rat::equiv(Rat::neg(Rat::Mk(a, p)), Rat::neg(x2)) from match x2 {
      Mk(a2, p2) => {
        let s1: Int::mul(
          Int::neg(a),
          IntOfNat(Succ(p2))
        ) = Int::neg(
          Int::mul(a, IntOfNat(Succ(p2)))
        ) := by int_norm!(): Int::mul(
          Int::neg(a),
          IntOfNat(Succ(p2))
        ) = Int::neg(Int::mul(a, IntOfNat(Succ(p2)))) {}
        let s2: Int::neg(
          Int::mul(a, IntOfNat(Succ(p2)))
        ) = Int::neg(Int::mul(a2, IntOfNat(Succ(p)))) := Eq::congr(⟦Int::neg(□)⟧, h)
        let s3: Int::neg(
          Int::mul(a2, IntOfNat(Succ(p)))
        ) = Int::mul(
          Int::neg(a2),
          IntOfNat(Succ(p))
        ) := by int_norm!(): Int::neg(
          Int::mul(a2, IntOfNat(Succ(p)))
        ) = Int::mul(Int::neg(a2), IntOfNat(Succ(p))) {}
        calc!(```
          $Int::mul(Int::neg(a), IntOfNat(Succ(p2)))
          = $Int::neg(Int::mul(a, IntOfNat(Succ(p2)))) from $s1
          = $Int::neg(Int::mul(a2, IntOfNat(Succ(p)))) from $s2
          = $Int::mul(Int::neg(a2), IntOfNat(Succ(p))) from $s3
          ```)
      }
    }
  }
}

pub theorem Rat::add_raw_congr(
  x: Rat,
  y: Rat,
  y2: Rat,
  h: Rat::equiv(y, y2)
): Rat::equiv(Rat::add_raw(x, y), Rat::add_raw(x, y2)) {
  Rat::equiv_trans(
    Rat::add_raw(x, y),
    Rat::add_raw(y, x),
    Rat::add_raw(x, y2),
    Rat::add_raw_comm(x, y),
    Rat::equiv_trans(
      Rat::add_raw(y, x),
      Rat::add_raw(y2, x),
      Rat::add_raw(x, y2),
      Rat::add_raw_congl(y, y2, x, h),
      Rat::add_raw_comm(y2, x)
    )
  )
}

pub theorem Rat::add_congl(x: Rat, x2: Rat, y: Rat, h: Rat::equiv(x, x2)): Rat::equiv(Rat::add(x, y), Rat::add(x2, y)) {
  Rat::equiv_trans(
    Rat::add(x, y),
    Rat::add_raw(x, y),
    Rat::add(x2, y),
    Rat::add_val(x, y),
    Rat::equiv_trans(
      Rat::add_raw(x, y),
      Rat::add_raw(x2, y),
      Rat::add(x2, y),
      Rat::add_raw_congl(x, x2, y, h),
      Rat::equiv_symm(Rat::add(x2, y), Rat::add_raw(x2, y), Rat::add_val(x2, y))
    )
  )
}

pub theorem Rat::add_congr(x: Rat, y: Rat, y2: Rat, h: Rat::equiv(y, y2)): Rat::equiv(Rat::add(x, y), Rat::add(x, y2)) {
  Rat::equiv_trans(
    Rat::add(x, y),
    Rat::add_raw(x, y),
    Rat::add(x, y2),
    Rat::add_val(x, y),
    Rat::equiv_trans(
      Rat::add_raw(x, y),
      Rat::add_raw(x, y2),
      Rat::add(x, y2),
      Rat::add_raw_congr(x, y, y2, h),
      Rat::equiv_symm(Rat::add(x, y2), Rat::add_raw(x, y2), Rat::add_val(x, y2))
    )
  )
}

pub theorem Rat::add_comm(x: Rat, y: Rat): Rat::equiv(Rat::add(x, y), Rat::add(y, x)) {
  Rat::equiv_trans(
    Rat::add(x, y),
    Rat::add_raw(x, y),
    Rat::add(y, x),
    Rat::add_val(x, y),
    Rat::equiv_trans(
      Rat::add_raw(x, y),
      Rat::add_raw(y, x),
      Rat::add(y, x),
      Rat::add_raw_comm(x, y),
      Rat::equiv_symm(Rat::add(y, x), Rat::add_raw(y, x), Rat::add_val(y, x))
    )
  )
}

pub theorem Rat::add_assoc(x: Rat, y: Rat, z: Rat): Rat::equiv(Rat::add(Rat::add(x, y), z), Rat::add(x, Rat::add(y, z))) {
  Rat::equiv_trans(
    Rat::add(Rat::add(x, y), z),
    Rat::add_raw(Rat::add(x, y), z),
    Rat::add(x, Rat::add(y, z)),
    Rat::add_val(Rat::add(x, y), z),
    Rat::equiv_trans(
      Rat::add_raw(Rat::add(x, y), z),
      Rat::add_raw(Rat::add_raw(x, y), z),
      Rat::add(x, Rat::add(y, z)),
      Rat::add_raw_congl(Rat::add(x, y), Rat::add_raw(x, y), z, Rat::add_val(x, y)),
      Rat::equiv_trans(
        Rat::add_raw(Rat::add_raw(x, y), z),
        Rat::add_raw(x, Rat::add_raw(y, z)),
        Rat::add(x, Rat::add(y, z)),
        Rat::add_raw_assoc(x, y, z),
        Rat::equiv_trans(
          Rat::add_raw(x, Rat::add_raw(y, z)),
          Rat::add_raw(x, Rat::add(y, z)),
          Rat::add(x, Rat::add(y, z)),
          Rat::add_raw_congr(
            x,
            Rat::add_raw(y, z),
            Rat::add(y, z),
            Rat::equiv_symm(Rat::add(y, z), Rat::add_raw(y, z), Rat::add_val(y, z))
          ),
          Rat::equiv_symm(Rat::add(x, Rat::add(y, z)), Rat::add_raw(x, Rat::add(y, z)), Rat::add_val(x, Rat::add(y, z)))
        )
      )
    )
  )
}

pub theorem Rat::mul_raw_congr(
  x: Rat,
  y: Rat,
  y2: Rat,
  h: Rat::equiv(y, y2)
): Rat::equiv(Rat::mul_raw(x, y), Rat::mul_raw(x, y2)) {
  Rat::equiv_trans(
    Rat::mul_raw(x, y),
    Rat::mul_raw(y, x),
    Rat::mul_raw(x, y2),
    Rat::mul_raw_comm(x, y),
    Rat::equiv_trans(
      Rat::mul_raw(y, x),
      Rat::mul_raw(y2, x),
      Rat::mul_raw(x, y2),
      Rat::mul_raw_congl(y, y2, x, h),
      Rat::mul_raw_comm(y2, x)
    )
  )
}

pub theorem Rat::mul_congl(x: Rat, x2: Rat, y: Rat, h: Rat::equiv(x, x2)): Rat::equiv(Rat::mul(x, y), Rat::mul(x2, y)) {
  Rat::equiv_trans(
    Rat::mul(x, y),
    Rat::mul_raw(x, y),
    Rat::mul(x2, y),
    Rat::mul_val(x, y),
    Rat::equiv_trans(
      Rat::mul_raw(x, y),
      Rat::mul_raw(x2, y),
      Rat::mul(x2, y),
      Rat::mul_raw_congl(x, x2, y, h),
      Rat::equiv_symm(Rat::mul(x2, y), Rat::mul_raw(x2, y), Rat::mul_val(x2, y))
    )
  )
}

pub theorem Rat::mul_congr(x: Rat, y: Rat, y2: Rat, h: Rat::equiv(y, y2)): Rat::equiv(Rat::mul(x, y), Rat::mul(x, y2)) {
  Rat::equiv_trans(
    Rat::mul(x, y),
    Rat::mul_raw(x, y),
    Rat::mul(x, y2),
    Rat::mul_val(x, y),
    Rat::equiv_trans(
      Rat::mul_raw(x, y),
      Rat::mul_raw(x, y2),
      Rat::mul(x, y2),
      Rat::mul_raw_congr(x, y, y2, h),
      Rat::equiv_symm(Rat::mul(x, y2), Rat::mul_raw(x, y2), Rat::mul_val(x, y2))
    )
  )
}

pub theorem Rat::mul_comm(x: Rat, y: Rat): Rat::equiv(Rat::mul(x, y), Rat::mul(y, x)) {
  Rat::equiv_trans(
    Rat::mul(x, y),
    Rat::mul_raw(x, y),
    Rat::mul(y, x),
    Rat::mul_val(x, y),
    Rat::equiv_trans(
      Rat::mul_raw(x, y),
      Rat::mul_raw(y, x),
      Rat::mul(y, x),
      Rat::mul_raw_comm(x, y),
      Rat::equiv_symm(Rat::mul(y, x), Rat::mul_raw(y, x), Rat::mul_val(y, x))
    )
  )
}

pub theorem Rat::mul_assoc(x: Rat, y: Rat, z: Rat): Rat::equiv(Rat::mul(Rat::mul(x, y), z), Rat::mul(x, Rat::mul(y, z))) {
  Rat::equiv_trans(
    Rat::mul(Rat::mul(x, y), z),
    Rat::mul_raw(Rat::mul(x, y), z),
    Rat::mul(x, Rat::mul(y, z)),
    Rat::mul_val(Rat::mul(x, y), z),
    Rat::equiv_trans(
      Rat::mul_raw(Rat::mul(x, y), z),
      Rat::mul_raw(Rat::mul_raw(x, y), z),
      Rat::mul(x, Rat::mul(y, z)),
      Rat::mul_raw_congl(Rat::mul(x, y), Rat::mul_raw(x, y), z, Rat::mul_val(x, y)),
      Rat::equiv_trans(
        Rat::mul_raw(Rat::mul_raw(x, y), z),
        Rat::mul_raw(x, Rat::mul_raw(y, z)),
        Rat::mul(x, Rat::mul(y, z)),
        Rat::mul_raw_assoc(x, y, z),
        Rat::equiv_trans(
          Rat::mul_raw(x, Rat::mul_raw(y, z)),
          Rat::mul_raw(x, Rat::mul(y, z)),
          Rat::mul(x, Rat::mul(y, z)),
          Rat::mul_raw_congr(
            x,
            Rat::mul_raw(y, z),
            Rat::mul(y, z),
            Rat::equiv_symm(Rat::mul(y, z), Rat::mul_raw(y, z), Rat::mul_val(y, z))
          ),
          Rat::equiv_symm(Rat::mul(x, Rat::mul(y, z)), Rat::mul_raw(x, Rat::mul(y, z)), Rat::mul_val(x, Rat::mul(y, z)))
        )
      )
    )
  )
}

pub theorem Rat::add_zero(x: Rat): Rat::equiv(Rat::add(x, Rat::zero()), x) {
  Rat::equiv_trans(Rat::add(x, Rat::zero()), Rat::add_raw(x, Rat::zero()), x, Rat::add_val(x, Rat::zero()), Rat::add_raw_zero(x))
}

pub theorem Rat::add_neg(x: Rat): Rat::equiv(Rat::add(x, Rat::neg(x)), Rat::zero()) {
  Rat::equiv_trans(Rat::add(x, Rat::neg(x)), Rat::add_raw(x, Rat::neg(x)), Rat::zero(), Rat::add_val(x, Rat::neg(x)), Rat::add_raw_neg(x))
}

pub theorem Rat::mul_one(x: Rat): Rat::equiv(Rat::mul(x, Rat::one()), x) {
  Rat::equiv_trans(Rat::mul(x, Rat::one()), Rat::mul_raw(x, Rat::one()), x, Rat::mul_val(x, Rat::one()), Rat::mul_raw_one(x))
}

pub theorem Rat::mul_add(x: Rat, y: Rat, z: Rat): Rat::equiv(Rat::mul(x, Rat::add(y, z)), Rat::add(Rat::mul(x, y), Rat::mul(x, z))) {
  Rat::equiv_trans(
    Rat::mul(x, Rat::add(y, z)),
    Rat::mul_raw(x, Rat::add(y, z)),
    Rat::add(Rat::mul(x, y), Rat::mul(x, z)),
    Rat::mul_val(x, Rat::add(y, z)),
    Rat::equiv_trans(
      Rat::mul_raw(x, Rat::add(y, z)),
      Rat::mul_raw(x, Rat::add_raw(y, z)),
      Rat::add(Rat::mul(x, y), Rat::mul(x, z)),
      Rat::mul_raw_congr(x, Rat::add(y, z), Rat::add_raw(y, z), Rat::add_val(y, z)),
      Rat::equiv_trans(
        Rat::mul_raw(x, Rat::add_raw(y, z)),
        Rat::add_raw(Rat::mul_raw(x, y), Rat::mul_raw(x, z)),
        Rat::add(Rat::mul(x, y), Rat::mul(x, z)),
        Rat::mul_raw_add(x, y, z),
        Rat::equiv_trans(
          Rat::add_raw(Rat::mul_raw(x, y), Rat::mul_raw(x, z)),
          Rat::add_raw(Rat::mul(x, y), Rat::mul_raw(x, z)),
          Rat::add(Rat::mul(x, y), Rat::mul(x, z)),
          Rat::add_raw_congl(
            Rat::mul_raw(x, y),
            Rat::mul(x, y),
            Rat::mul_raw(x, z),
            Rat::equiv_symm(Rat::mul(x, y), Rat::mul_raw(x, y), Rat::mul_val(x, y))
          ),
          Rat::equiv_trans(
            Rat::add_raw(Rat::mul(x, y), Rat::mul_raw(x, z)),
            Rat::add_raw(Rat::mul(x, y), Rat::mul(x, z)),
            Rat::add(Rat::mul(x, y), Rat::mul(x, z)),
            Rat::add_raw_congr(
              Rat::mul(x, y),
              Rat::mul_raw(x, z),
              Rat::mul(x, z),
              Rat::equiv_symm(Rat::mul(x, z), Rat::mul_raw(x, z), Rat::mul_val(x, z))
            ),
            Rat::equiv_symm(
              Rat::add(Rat::mul(x, y), Rat::mul(x, z)),
              Rat::add_raw(Rat::mul(x, y), Rat::mul(x, z)),
              Rat::add_val(Rat::mul(x, y), Rat::mul(x, z))
            )
          )
        )
      )
    )
  )
}

pub def RatLe(
  x: Rat,
  y: Rat
): Prop := IntLe(
  Int::mul(Rat::num(x), IntOfNat(Rat::den(y))),
  Int::mul(Rat::num(y), IntOfNat(Rat::den(x)))
)

pub theorem Rat::le_refl(x: Rat): RatLe(x, x) {
  Int::le_refl(Int::mul(Rat::num(x), IntOfNat(Rat::den(x))))
}

pub theorem Rat::le_antisymm(x: Rat, y: Rat, l1: RatLe(x, y), l2: RatLe(y, x)): Rat::equiv(x, y) {
  Int::le_antisymm(Int::mul(Rat::num(x), IntOfNat(Rat::den(y))), Int::mul(Rat::num(y), IntOfNat(Rat::den(x))), l1, l2)
}

pub theorem Rat::le_total(x: Rat, y: Rat): RatLe(x, y) ∨ RatLe(y, x) {
  Int::le_total(Int::mul(Rat::num(x), IntOfNat(Rat::den(y))), Int::mul(Rat::num(y), IntOfNat(Rat::den(x))))
}

pub theorem Rat::add_le(x: Rat, y: Rat, z: Rat, l: RatLe(x, y)): RatLe(Rat::add(x, z), Rat::add(y, z)) {
  Rat::le_congr(
    Rat::add(x, z),
    Rat::add_raw(y, z),
    Rat::add(y, z),
    Rat::equiv_symm(Rat::add(y, z), Rat::add_raw(y, z), Rat::add_val(y, z)),
    Rat::le_congl(
      Rat::add_raw(x, z),
      Rat::add(x, z),
      Rat::add_raw(y, z),
      Rat::equiv_symm(Rat::add(x, z), Rat::add_raw(x, z), Rat::add_val(x, z)),
      Rat::le_add_raw(x, y, z, l)
    )
  )
}

pub theorem Rat::mul_nonneg(
  x: Rat,
  y: Rat,
  l1: RatLe(Rat::zero(), x),
  l2: RatLe(Rat::zero(), y)
): RatLe(Rat::zero(), Rat::mul(x, y)) {
  Rat::le_congr(
    Rat::zero(),
    Rat::mul_raw(x, y),
    Rat::mul(x, y),
    Rat::equiv_symm(Rat::mul(x, y), Rat::mul_raw(x, y), Rat::mul_val(x, y)),
    Rat::mul_raw_nonneg(x, y, l1, l2)
  )
}

pub theorem Bool::eq_of_iff(
  a: Bool,
  b: Bool,
  f: (a = true) -> (b = true),
  g: (b = true) -> (a = true)
): a = b {
  match a {
    true => Eq::sym(f(Refl))
    false => ⊢ false = b from match b {
      false => Refl
      true => False::elim(false_ne_true(g(Refl)))
    }
  }
}

pub theorem Rat::le_resp_l(x: Rat, x2: Rat, y: Rat, h: Rat::equiv(x, x2)): Rat::le(x, y) = Rat::le(x2, y) {
  Bool::eq_of_iff(
    Rat::le(x, y),
    Rat::le(x2, y),
    (l: Rat::le(x, y) = true) => Rat::le_congl(x, x2, y, h, l),
    (l: Rat::le(x2, y) = true) => Rat::le_congl(x2, x, y, Rat::equiv_symm(x, x2, h), l)
  )
}

pub theorem Rat::le_resp_r(x: Rat, y: Rat, y2: Rat, h: Rat::equiv(y, y2)): Rat::le(x, y) = Rat::le(x, y2) {
  Bool::eq_of_iff(
    Rat::le(x, y),
    Rat::le(x, y2),
    (l: Rat::le(x, y) = true) => Rat::le_congr(x, y, y2, h, l),
    (l: Rat::le(x, y2) = true) => Rat::le_congr(x, y2, y, Rat::equiv_symm(y, y2, h), l)
  )
}

pub theorem Rat::le_congl(x: Rat, x2: Rat, y: Rat, h: Rat::equiv(x, x2), l: RatLe(x, y)): RatLe(x2, y) {
  match x {
    Mk(a, p) => ⊢ RatLe(x2, y) from match x2 {
      Mk(a2, p2) => ⊢ RatLe(Rat::Mk(a2, p2), y) from match y {
        Mk(b, q) => {
          let l1: IntLe(
            Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(p2))),
            Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2)))
          ) := Int::le_mul_pos(
            Int::mul(a, IntOfNat(Succ(q))),
            Int::mul(b, IntOfNat(Succ(p))),
            p2,
            l
          )
          let s1: Int::mul(
            Int::mul(a, IntOfNat(Succ(q))),
            IntOfNat(Succ(p2))
          ) = Int::mul(
            Int::mul(a, IntOfNat(Succ(p2))),
            IntOfNat(Succ(q))
          ) := by int_norm!(): Int::mul(
            Int::mul(a, IntOfNat(Succ(q))),
            IntOfNat(Succ(p2))
          ) = Int::mul(Int::mul(a, IntOfNat(Succ(p2))), IntOfNat(Succ(q))) {}
          let s2: Int::mul(
            Int::mul(a, IntOfNat(Succ(p2))),
            IntOfNat(Succ(q))
          ) = Int::mul(
            Int::mul(a2, IntOfNat(Succ(p))),
            IntOfNat(Succ(q))
          ) := Eq::congr(⟦Int::mul(□, IntOfNat(Succ(q)))⟧, h)
          let s3: Int::mul(
            Int::mul(a2, IntOfNat(Succ(p))),
            IntOfNat(Succ(q))
          ) = Int::mul(
            Int::mul(a2, IntOfNat(Succ(q))),
            IntOfNat(Succ(p))
          ) := by int_norm!(): Int::mul(
            Int::mul(a2, IntOfNat(Succ(p))),
            IntOfNat(Succ(q))
          ) = Int::mul(Int::mul(a2, IntOfNat(Succ(q))), IntOfNat(Succ(p))) {}
          let s4: Int::mul(
            Int::mul(b, IntOfNat(Succ(p))),
            IntOfNat(Succ(p2))
          ) = Int::mul(
            Int::mul(b, IntOfNat(Succ(p2))),
            IntOfNat(Succ(p))
          ) := by int_norm!(): Int::mul(
            Int::mul(b, IntOfNat(Succ(p))),
            IntOfNat(Succ(p2))
          ) = Int::mul(Int::mul(b, IntOfNat(Succ(p2))), IntOfNat(Succ(p))) {}
          Int::le_mul_cancel(
            Int::mul(a2, IntOfNat(Succ(q))),
            Int::mul(b, IntOfNat(Succ(p2))),
            p,
            Int::le_rw(
              Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(p2))),
              Int::mul(Int::mul(a2, IntOfNat(Succ(q))), IntOfNat(Succ(p))),
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(p2))),
              Int::mul(Int::mul(b, IntOfNat(Succ(p2))), IntOfNat(Succ(p))),
              Eq::trans(s1, Eq::trans(s2, s3)),
              s4,
              l1
            )
          )
        }
      }
    }
  }
}

pub theorem Rat::le_congr(x: Rat, y: Rat, y2: Rat, h: Rat::equiv(y, y2), l: RatLe(x, y)): RatLe(x, y2) {
  match x {
    Mk(a, p) => ⊢ RatLe(Rat::Mk(a, p), y2) from match y {
      Mk(b, q) => ⊢ RatLe(Rat::Mk(a, p), y2) from match y2 {
        Mk(b2, q2) => {
          let l1: IntLe(
            Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(q2))),
            Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(q2)))
          ) := Int::le_mul_pos(
            Int::mul(a, IntOfNat(Succ(q))),
            Int::mul(b, IntOfNat(Succ(p))),
            q2,
            l
          )
          let s1: Int::mul(
            Int::mul(a, IntOfNat(Succ(q))),
            IntOfNat(Succ(q2))
          ) = Int::mul(
            Int::mul(a, IntOfNat(Succ(q2))),
            IntOfNat(Succ(q))
          ) := by int_norm!(): Int::mul(
            Int::mul(a, IntOfNat(Succ(q))),
            IntOfNat(Succ(q2))
          ) = Int::mul(Int::mul(a, IntOfNat(Succ(q2))), IntOfNat(Succ(q))) {}
          let t1: Int::mul(
            Int::mul(b, IntOfNat(Succ(p))),
            IntOfNat(Succ(q2))
          ) = Int::mul(
            Int::mul(b, IntOfNat(Succ(q2))),
            IntOfNat(Succ(p))
          ) := by int_norm!(): Int::mul(
            Int::mul(b, IntOfNat(Succ(p))),
            IntOfNat(Succ(q2))
          ) = Int::mul(Int::mul(b, IntOfNat(Succ(q2))), IntOfNat(Succ(p))) {}
          let t2: Int::mul(
            Int::mul(b, IntOfNat(Succ(q2))),
            IntOfNat(Succ(p))
          ) = Int::mul(
            Int::mul(b2, IntOfNat(Succ(q))),
            IntOfNat(Succ(p))
          ) := Eq::congr(⟦Int::mul(□, IntOfNat(Succ(p)))⟧, h)
          let t3: Int::mul(
            Int::mul(b2, IntOfNat(Succ(q))),
            IntOfNat(Succ(p))
          ) = Int::mul(
            Int::mul(b2, IntOfNat(Succ(p))),
            IntOfNat(Succ(q))
          ) := by int_norm!(): Int::mul(
            Int::mul(b2, IntOfNat(Succ(q))),
            IntOfNat(Succ(p))
          ) = Int::mul(Int::mul(b2, IntOfNat(Succ(p))), IntOfNat(Succ(q))) {}
          Int::le_mul_cancel(
            Int::mul(a, IntOfNat(Succ(q2))),
            Int::mul(b2, IntOfNat(Succ(p))),
            q,
            Int::le_rw(
              Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(q2))),
              Int::mul(Int::mul(a, IntOfNat(Succ(q2))), IntOfNat(Succ(q))),
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(q2))),
              Int::mul(Int::mul(b2, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
              s1,
              Eq::trans(t1, Eq::trans(t2, t3)),
              l1
            )
          )
        }
      }
    }
  }
}

pub theorem Rat::le_trans(x: Rat, y: Rat, z: Rat, l1: RatLe(x, y), l2: RatLe(y, z)): RatLe(x, z) {
  match x {
    Mk(a, p) => ⊢ RatLe(Rat::Mk(a, p), z) from match y {
      Mk(b, q) => ⊢ RatLe(Rat::Mk(a, p), z) from match z {
        Mk(c, r) => {
          let l1: IntLe(
            Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(r))),
            Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(r)))
          ) := Int::le_mul_pos(
            Int::mul(a, IntOfNat(Succ(q))),
            Int::mul(b, IntOfNat(Succ(p))),
            r,
            l1
          )
          let l2: IntLe(
            Int::mul(Int::mul(b, IntOfNat(Succ(r))), IntOfNat(Succ(p))),
            Int::mul(Int::mul(c, IntOfNat(Succ(q))), IntOfNat(Succ(p)))
          ) := Int::le_mul_pos(
            Int::mul(b, IntOfNat(Succ(r))),
            Int::mul(c, IntOfNat(Succ(q))),
            p,
            l2
          )
          let s: Int::mul(
            Int::mul(b, IntOfNat(Succ(p))),
            IntOfNat(Succ(r))
          ) = Int::mul(
            Int::mul(b, IntOfNat(Succ(r))),
            IntOfNat(Succ(p))
          ) := by int_norm!(): Int::mul(
            Int::mul(b, IntOfNat(Succ(p))),
            IntOfNat(Succ(r))
          ) = Int::mul(Int::mul(b, IntOfNat(Succ(r))), IntOfNat(Succ(p))) {}
          let l3: IntLe(
            Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(r))),
            Int::mul(Int::mul(c, IntOfNat(Succ(q))), IntOfNat(Succ(p)))
          ) := Int::le_trans(
            Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(r))),
            Int::mul(Int::mul(b, IntOfNat(Succ(r))), IntOfNat(Succ(p))),
            Int::mul(Int::mul(c, IntOfNat(Succ(q))), IntOfNat(Succ(p))),
            Int::le_rw(
              Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(r))),
              Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(r))),
              Int::mul(Int::mul(b, IntOfNat(Succ(p))), IntOfNat(Succ(r))),
              Int::mul(Int::mul(b, IntOfNat(Succ(r))), IntOfNat(Succ(p))),
              Refl,
              s,
              l1
            ),
            l2
          )
          let e1: Int::mul(
            Int::mul(a, IntOfNat(Succ(q))),
            IntOfNat(Succ(r))
          ) = Int::mul(
            Int::mul(a, IntOfNat(Succ(r))),
            IntOfNat(Succ(q))
          ) := by int_norm!(): Int::mul(
            Int::mul(a, IntOfNat(Succ(q))),
            IntOfNat(Succ(r))
          ) = Int::mul(Int::mul(a, IntOfNat(Succ(r))), IntOfNat(Succ(q))) {}
          let e2: Int::mul(
            Int::mul(c, IntOfNat(Succ(q))),
            IntOfNat(Succ(p))
          ) = Int::mul(
            Int::mul(c, IntOfNat(Succ(p))),
            IntOfNat(Succ(q))
          ) := by int_norm!(): Int::mul(
            Int::mul(c, IntOfNat(Succ(q))),
            IntOfNat(Succ(p))
          ) = Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))) {}
          Int::le_mul_cancel(
            Int::mul(a, IntOfNat(Succ(r))),
            Int::mul(c, IntOfNat(Succ(p))),
            q,
            Int::le_rw(
              Int::mul(Int::mul(a, IntOfNat(Succ(q))), IntOfNat(Succ(r))),
              Int::mul(Int::mul(a, IntOfNat(Succ(r))), IntOfNat(Succ(q))),
              Int::mul(Int::mul(c, IntOfNat(Succ(q))), IntOfNat(Succ(p))),
              Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
              e1,
              e2,
              l3
            )
          )
        }
      }
    }
  }
}

pub theorem Rat::le_add_raw(
  x: Rat,
  y: Rat,
  z: Rat,
  l: RatLe(x, y)
): RatLe(Rat::add_raw(x, z), Rat::add_raw(y, z)) {
  match x {
    Mk(a, p) => ⊢ RatLe(Rat::add_raw(Rat::Mk(a, p), z), Rat::add_raw(y, z)) from match y {
      Mk(b, q) => ⊢ RatLe(Rat::add_raw(Rat::Mk(a, p), z), Rat::add_raw(Rat::Mk(b, q), z)) from match z {
        Mk(c, r) => {
          let l1: IntLe(
            Int::mul(
              Int::mul(a, IntOfNat(Succ(q))),
              Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
            ),
            Int::mul(
              Int::mul(b, IntOfNat(Succ(p))),
              Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
            )
          ) := Int::le_mul_pos(
            Int::mul(a, IntOfNat(Succ(q))),
            Int::mul(b, IntOfNat(Succ(p))),
            Nat::add(Nat::mul(Succ(r), r), r),
            l
          )
          let l2: IntLe(
            Int::add(
              Int::mul(
                Int::mul(a, IntOfNat(Succ(q))),
                Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
              ),
              Int::mul(
                Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
                IntOfNat(Succ(r))
              )
            ),
            Int::add(
              Int::mul(
                Int::mul(b, IntOfNat(Succ(p))),
                Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
              ),
              Int::mul(
                Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
                IntOfNat(Succ(r))
              )
            )
          ) := Int::le_add(
            Int::mul(
              Int::mul(a, IntOfNat(Succ(q))),
              Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
            ),
            Int::mul(
              Int::mul(b, IntOfNat(Succ(p))),
              Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
            ),
            Int::mul(
              Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
              IntOfNat(Succ(r))
            ),
            l1
          )
          let e1: Int::add(
            Int::mul(
              Int::mul(a, IntOfNat(Succ(q))),
              Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
            ),
            Int::mul(
              Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
              IntOfNat(Succ(r))
            )
          ) = Int::mul(
            Int::add(Int::mul(a, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(p)))),
            Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r)))
          ) := by int_norm!(): Int::add(
            Int::mul(
              Int::mul(a, IntOfNat(Succ(q))),
              Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
            ),
            Int::mul(
              Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
              IntOfNat(Succ(r))
            )
          ) = Int::mul(
            Int::add(Int::mul(a, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(p)))),
            Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r)))
          ) {}
          let e2: Int::add(
            Int::mul(
              Int::mul(b, IntOfNat(Succ(p))),
              Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
            ),
            Int::mul(
              Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
              IntOfNat(Succ(r))
            )
          ) = Int::mul(
            Int::add(Int::mul(b, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(q)))),
            Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(r)))
          ) := by int_norm!(): Int::add(
            Int::mul(
              Int::mul(b, IntOfNat(Succ(p))),
              Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
            ),
            Int::mul(
              Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
              IntOfNat(Succ(r))
            )
          ) = Int::mul(
            Int::add(Int::mul(b, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(q)))),
            Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(r)))
          ) {}
          Int::le_rw(
            Int::add(
              Int::mul(
                Int::mul(a, IntOfNat(Succ(q))),
                Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
              ),
              Int::mul(
                Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
                IntOfNat(Succ(r))
              )
            ),
            Int::mul(
              Int::add(Int::mul(a, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(p)))),
              Int::mul(IntOfNat(Succ(q)), IntOfNat(Succ(r)))
            ),
            Int::add(
              Int::mul(
                Int::mul(b, IntOfNat(Succ(p))),
                Int::mul(IntOfNat(Succ(r)), IntOfNat(Succ(r)))
              ),
              Int::mul(
                Int::mul(Int::mul(c, IntOfNat(Succ(p))), IntOfNat(Succ(q))),
                IntOfNat(Succ(r))
              )
            ),
            Int::mul(
              Int::add(Int::mul(b, IntOfNat(Succ(r))), Int::mul(c, IntOfNat(Succ(q)))),
              Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(r)))
            ),
            e1,
            e2,
            l2
          )
        }
      }
    }
  }
}

pub theorem Rat::mul_raw_nonneg(
  x: Rat,
  y: Rat,
  l1: RatLe(Rat::zero(), x),
  l2: RatLe(Rat::zero(), y)
): RatLe(Rat::zero(), Rat::mul_raw(x, y)) {
  match x {
    Mk(a, p) => ⊢ RatLe(Rat::zero(), Rat::mul_raw(Rat::Mk(a, p), y)) from match y {
      Mk(b, q) => {
        let z1: Int::mul(
          0,
          IntOfNat(Succ(p))
        ) = 0 := by int_norm!(): Int::mul(0, IntOfNat(Succ(p))) = 0 {}
        let o1: Int::mul(a, 1) = a := by int_norm!(): Int::mul(a, 1) = a {}
        let z2: Int::mul(
          0,
          IntOfNat(Succ(q))
        ) = 0 := by int_norm!(): Int::mul(0, IntOfNat(Succ(q))) = 0 {}
        let o2: Int::mul(b, 1) = b := by int_norm!(): Int::mul(b, 1) = b {}
        let ha: IntLe(
          0,
          a
        ) := Int::le_rw(Int::mul(0, IntOfNat(Succ(p))), 0, Int::mul(a, 1), a, z1, o1, l1)
        let hb: IntLe(
          0,
          b
        ) := Int::le_rw(Int::mul(0, IntOfNat(Succ(q))), 0, Int::mul(b, 1), b, z2, o2, l2)
        let z3: 0 = Int::mul(
          0,
          Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))
        ) := by int_norm!(): 0 = Int::mul(0, Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))) {}
        let o3: Int::mul(
          a,
          b
        ) = Int::mul(
          Int::mul(a, b),
          1
        ) := by int_norm!(): Int::mul(a, b) = Int::mul(Int::mul(a, b), 1) {}
        Int::le_rw(
          0,
          Int::mul(0, Int::mul(IntOfNat(Succ(p)), IntOfNat(Succ(q)))),
          Int::mul(a, b),
          Int::mul(Int::mul(a, b), 1),
          z3,
          o3,
          Int::mul_nonneg(a, b, ha, hb)
        )
      }
    }
  }
}
