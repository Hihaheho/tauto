// The standard effects in proofs (`docs/design/effect-proofs.md`「Effects and rows」).
//
// A file that imports this module has its functions that perform or handle
// a standard effect (`stdout`, `fs_read`, `env`, … of
// `std/builtin/os.taut`) read as computation trees, like the functions of
// an effect the file declares itself. Nothing is declared again here. The
// kernel is given the prelude's own declarations: each `enum` and `struct`
// of that file it can read (`IoError`, `FileStat`) as a family of the same
// shape, and each effect whose parameter and answer types it then has,
// with the models imported below for the prelude's types (`u64` is `UInt(64)`,
// `Text` is `Text`). So the two cannot differ. An effect with a type only
// the host makes (a `Signal`, a `CancelToken`, a `Secret`) is not read, and
// a function that performs it runs as written.
import "bytes.taut" {  }
import "sint.taut" {  }
import "text.taut" {  }
import "uint.taut" {  }
