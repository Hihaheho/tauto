// Explicit changes of an integer's width (`docs/design/self-host.md`). A number
// that does not fit is the run error "the number is too large".

extern {
  fn i64_of_i32(n: i32) -> i64
  fn i32_of_i64(n: i64) -> i32
  fn i64_of_u64(n: u64) -> i64
  fn u64_of_i64(n: i64) -> u64
  fn u64_of_u32(n: u32) -> u64
  fn u32_of_u64(n: u64) -> u32
  fn u64_of_u8(n: u8) -> u64
  fn u8_of_u64(n: u64) -> u8
}
