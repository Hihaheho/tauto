// The ω standard library: duplicable data, and
// higher-order functions that take what they call by `&f`. A program sees
// it before its own declarations. The evaluator implements the `extern`
// functions, and their signatures are trusted; the functions with a body
// are checked as a program's own are.

// A persistent map; kind = join(shared, kind K, kind V).
pub(open) shared struct Map(K: Type, V: Type) { entries: List(Pair(K, V)) }

extern {
  fn words(t: Text): List(Text)
  fn concat(a: Text, b: Text): Text
}

// A read-only array: the elements of a list, read
// by index in O(1). `std/Array::taut` says what each function does.
pub shared struct Array(A: Type) {}

module Array {
  extern {
    fn of_list<A: Shared>(l: List(A)): Array(A)
    fn get<A: Shared>(a: Array(A), i: u64): Option(A)
    fn len<A: Shared>(a: Array(A)): u64
    fn to_list<A: Shared>(a: Array(A)): List(A)
  }
}

// A read-only byte sequence. A slice shares the storage of what it is cut
// from, so `Bytes::slice` copies nothing. `std/Bytes::taut` says what each
// function does.
pub(open) shared struct Bytes {}

module Bytes {
  extern {
    fn of_list(l: List(u8)): Bytes
    fn to_list(b: Bytes): List(u8)
    fn len(b: Bytes): u64
    fn get(b: Bytes, i: u64): Option(u8)
    // The bytes from `start` to `end`; `None` unless `start <= end <= len`.
    fn slice(b: Bytes, start: u64, end: u64): Option(Bytes)
    fn concat(a: Bytes, b: Bytes): Bytes
    fn eq(a: Bytes, b: Bytes): Bool
    fn of_text(t: Text): Bytes
  }
}

module Text {
  extern {
    // The text the bytes encode; `None` unless they are well-formed UTF-8.
    fn of_bytes(b: Bytes): Option(Text)
  }
}

pub fn map<A: Shared, B: Shared, !e>(xs: List(A), &f: (A) -> B ! e): List(B) ! e {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(f(x), map(rest, &f))
  }
}

pub fn each<A: Shared, !e>(xs: List(A), &f: (A) -> Unit ! e): Unit ! e {
  match xs {
    Nil => #()
    Cons(x, rest) => {
      f(x)
      each(rest, &f)
    }
  }
}

pub fn fold<A: Shared, B: Shared, !e>(xs: List(A), init: B, &f: (B, A) -> B ! e): B ! e {
  match xs {
    Nil => init
    Cons(x, rest) => fold(rest, f(init, x), &f)
  }
}

pub fn fold_once<A, B, !e: <=1>(xs: List(A), init: B, &f: (B, A) -> B ! e): B ! e {
  match xs {
    Nil => init
    Cons(x, rest) => fold_once(rest, f(init, x), &f)
  }
}

module Map {
  pub fn empty<K, V>(): Map(K, V) {
    Map { entries: Nil }
  }

  pub fn get<K: Shared, V: Shared>(m: Map(K, V), k: K): Option(V) where DecEq(K) {
    find(m.entries, k)
  }

  pub fn find<K: Shared, V: Shared>(es: List(Pair(K, V)), k: K): Option(V) where DecEq(K) {
    match es {
      Nil => None
      Cons(Pair { fst: key, snd: value }, rest) => if key == k { Some(value) } else {
        find(rest, k)
      }
    }
  }

  pub fn insert<K: Shared, V>(m: Map(K, V), k: K, v: V): Map(K, V) where DecEq(K) {
    match m {
      Map { entries } => Map { entries: Cons(Pair { fst: k, snd: v }, without(entries, k)) }
    }
  }

  pub fn without<K: Shared, V>(es: List(Pair(K, V)), k: K): List(Pair(K, V)) where DecEq(K) {
    match es {
      Nil => Nil
      Cons(Pair { fst: key, snd: value }, rest) => if key == k { rest } else {
        Cons(Pair { fst: key, snd: value }, without(rest, k))
      }
    }
  }

  pub fn entries<K, V>(m: Map(K, V)): List(Pair(K, V)) {
    match m {
      Map { entries } => entries
    }
  }
}
