// The order of a type, with the laws that make it a total order: `compare`
// is `Equal` just for equal values, `Less` one way is `Greater` the other,
// and `Less` is transitive. Programs and proofs both read this file: Nib
// reads past the laws and the theorems, and the kernel checks all of it,
// the instances' laws included. The instances for the builtin types are in
// `Classes.taut`; the kernel does not see those types, and their laws are
// trusted.

pub class Ord(A: Linear) {
  fn compare(&a: A, &b: A): Ordering
  law equal_iff<a: A, b: A>(): Ord::compare(a, b) = Equal ↔ a = b
  law swap<a: A, b: A>(): Ord::compare(a, b) = Less ↔ Ord::compare(b, a) = Greater
  law trans<a: A, b: A, c: A>(
    h1: Ord::compare(a, b) = Less,
    h2: Ord::compare(b, c) = Less
  ): Ord::compare(a, c) = Less
}

pub theorem less_ne_equal(e: Less = Equal): False {
  match e: False {
  }
}

pub theorem less_ne_greater(e: Less = Greater): False {
  match e: False {
  }
}

pub theorem equal_ne_less(e: Equal = Less): False {
  match e: False {
  }
}

pub theorem equal_ne_greater(e: Equal = Greater): False {
  match e: False {
  }
}

pub theorem greater_ne_less(e: Greater = Less): False {
  match e: False {
  }
}

pub theorem greater_ne_equal(e: Greater = Equal): False {
  match e: False {
  }
}

pub theorem ord_equal_eq<A>(a: A, b: A, e: Ord::compare(a, b) = Equal): a = b where Ord(A) {
  let h: Ord::compare(a, b) = Equal ↔ a = b := Ord::equal_iff()
  Iff::mp(h, e)
}

pub theorem ord_eq_equal<A>(a: A, b: A, e: a = b): Ord::compare(a, b) = Equal where Ord(A) {
  let h: Ord::compare(a, b) = Equal ↔ a = b := Ord::equal_iff()
  Iff::mpr(h, e)
}

pub theorem ord_swap_less<A>(
  a: A,
  b: A,
  e: Ord::compare(a, b) = Less
): Ord::compare(b, a) = Greater where Ord(A) {
  let h: Ord::compare(a, b) = Less ↔ Ord::compare(b, a) = Greater := Ord::swap()
  Iff::mp(h, e)
}

pub theorem ord_swap_greater<A>(
  a: A,
  b: A,
  e: Ord::compare(a, b) = Greater
): Ord::compare(b, a) = Less where Ord(A) {
  let h: Ord::compare(b, a) = Less ↔ Ord::compare(a, b) = Greater := Ord::swap()
  Iff::mpr(h, e)
}

pub theorem ord_trans<A>(
  a: A,
  b: A,
  c: A,
  h1: Ord::compare(a, b) = Less,
  h2: Ord::compare(b, c) = Less
): Ord::compare(a, c) = Less where Ord(A) {
  Ord::trans(h1, h2)
}

pub fn ord_then(o: Ordering, r: Ordering): Ordering {
  match o: Ordering {
    Less => Less
    Equal => r
    Greater => Greater
  }
}

pub theorem ord_then_equal(
  o: Ordering,
  r: Ordering,
  e: ord_then(o, r) = Equal
): o = Equal ∧ r = Equal {
  match o: o = Equal ∧ r = Equal {
    Less => False::elim(less_ne_equal(e))
    Equal => AndIntro(Refl, e)
    Greater => False::elim(greater_ne_equal(e))
  }
}

pub theorem ord_then_less(
  o: Ordering,
  r: Ordering,
  e: ord_then(o, r) = Less
): o = Less ∨ o = Equal ∧ r = Less {
  match o: o = Less ∨ o = Equal ∧ r = Less {
    Less => OrInl(Refl)
    Equal => OrInr(AndIntro(Refl, e))
    Greater => False::elim(greater_ne_less(e))
  }
}

pub theorem ord_then_greater(
  o: Ordering,
  r: Ordering,
  e: ord_then(o, r) = Greater
): o = Greater ∨ o = Equal ∧ r = Greater {
  match o: o = Greater ∨ o = Equal ∧ r = Greater {
    Less => False::elim(less_ne_greater(e))
    Equal => OrInr(AndIntro(Refl, e))
    Greater => OrInl(Refl)
  }
}

pub theorem ord_then_of_less(o: Ordering, r: Ordering, h: o = Less): ord_then(o, r) = Less {
  match o: ord_then(o, r) = Less {
    Less => Refl
    Equal => False::elim(equal_ne_less(h))
    Greater => False::elim(greater_ne_less(h))
  }
}

pub theorem ord_then_of_greater(
  o: Ordering,
  r: Ordering,
  h: o = Greater
): ord_then(o, r) = Greater {
  match o: ord_then(o, r) = Greater {
    Less => False::elim(less_ne_greater(h))
    Equal => False::elim(equal_ne_greater(h))
    Greater => Refl
  }
}

pub theorem ord_then_of_equal(
  o: Ordering,
  r: Ordering,
  p: Ordering,
  ho: o = Equal,
  hr: r = p
): ord_then(o, r) = p {
  match o: ord_then(o, r) = p {
    Less => False::elim(less_ne_equal(ho))
    Equal => hr
    Greater => False::elim(greater_ne_equal(ho))
  }
}

module Option {
  pub theorem some_inj<A: Type>(x: A, y: A, e: Some(x) = Some(y)): x = y {
    match e: x = y {
      Refl => Refl
    }
  }

  pub theorem none_ne_some<A: Type>(y: A, e: None = Some(y)): False {
    match e: False {
    }
  }

  pub theorem some_ne_none<A: Type>(x: A, e: Some(x) = None): False {
    match e: False {
    }
  }
}

// `None` first, then `Some` by its content.
instance<A> Ord(Option(A)) where Ord(A) {
  fn compare(&a: Option(A), &b: Option(A)): Ordering {
    match a: Ordering {
      None => match b: Ordering {
        None => Equal
        Some(y) => Less
      }
      Some(x) => match b: Ordering {
        None => Greater
        Some(y) => Ord::compare(&x, &y)
      }
    }
  }
  law equal_iff<a: Option(A), b: Option(A)>(): Ord::compare(a, b) = Equal ↔ a = b {
    match a: Ord::compare(a, b) = Equal ↔ a = b {
      None => match b: Ord::compare(None, b) = Equal ↔ None = b {
        None => IffIntro((e: Equal = Equal) => Refl, (e: Eq(Option(A), None, None)) => Refl)
        Some(y) => IffIntro(
          (e: Less = Equal) => False::elim(less_ne_equal(e)),
          (e: None = Some(y)) => False::elim(Option::none_ne_some(y, e))
        )
      }
      Some(x) => match b: Ord::compare(Some(x), b) = Equal ↔ Some(x) = b {
        None => IffIntro(
          (e: Greater = Equal) => False::elim(greater_ne_equal(e)),
          (e: Some(x) = None) => False::elim(Option::some_ne_none(x, e))
        )
        Some(y) => IffIntro(
          (e: Ord::compare(x, y) = Equal) => {
            let h: Ord::compare(x, y) = Equal := e
            Eq::congr(A, Option(A), x, y, ⟦Some(□)⟧, ord_equal_eq(x, y, h))
          },
          (e: Some(x) = Some(y)) => {
            let h: Ord::compare(x, y) = Equal := ord_eq_equal(x, y, Option::some_inj(x, y, e))
            h
          }
        )
      }
    }
  }
  law swap<a: Option(A), b: Option(A)>(): Ord::compare(a, b) = Less ↔ Ord::compare(b, a) = Greater {
    match a: Ord::compare(a, b) = Less ↔ Ord::compare(b, a) = Greater {
      None => match b: Ord::compare(None, b) = Less ↔ Ord::compare(b, None) = Greater {
        None => IffIntro(
          (e: Equal = Less) => False::elim(equal_ne_less(e)),
          (e: Equal = Greater) => False::elim(equal_ne_greater(e))
        )
        Some(y) => IffIntro((e: Less = Less) => Refl, (e: Greater = Greater) => Refl)
      }
      Some(x) => match b: Ord::compare(Some(x), b) = Less ↔ Ord::compare(b, Some(x)) = Greater {
        None => IffIntro(
          (e: Greater = Less) => False::elim(greater_ne_less(e)),
          (e: Less = Greater) => False::elim(less_ne_greater(e))
        )
        Some(y) => IffIntro(
          (e: Ord::compare(x, y) = Less) => {
            let h: Ord::compare(y, x) = Greater := ord_swap_less(x, y, e)
            h
          },
          (e: Ord::compare(y, x) = Greater) => {
            let h: Ord::compare(x, y) = Less := ord_swap_greater(y, x, e)
            h
          }
        )
      }
    }
  }
  law trans<a: Option(
    A
  ), b: Option(
    A
  ), c: Option(
    A
  )>(h1: Ord::compare(a, b) = Less, h2: Ord::compare(b, c) = Less): Ord::compare(a, c) = Less {
    match a: Ord::compare(a, c) = Less {
      None => match c: Ord::compare(None, c) = Less {
        None => match b: Equal = Less {
          None => match h1: Equal = Less {
          }
          Some(y) => match h2: Equal = Less {
          }
        }
        Some(z) => Refl
      }
      Some(x) => match b: Ord::compare(Some(x), c) = Less {
        None => match h1: Ord::compare(Some(x), c) = Less {
        }
        Some(y) => match c: Ord::compare(Some(x), c) = Less {
          None => match h2: Greater = Less {
          }
          Some(z) => {
            let h: Ord::compare(x, z) = Less := ord_trans(x, y, z, h1, h2)
            h
          }
        }
      }
    }
  }
}

module List {
  pub theorem nil_ne_cons<A: Type>(y: A, ys: List(A), e: Nil = Cons(y, ys)): False {
    match e: False {
    }
  }

  pub theorem cons_ne_nil<A: Type>(x: A, xs: List(A), e: Cons(x, xs) = Nil): False {
    match e: False {
    }
  }

  pub theorem cons_inj<A: Type>(
    x: A,
    y: A,
    xs: List(A),
    ys: List(A),
    e: Cons(x, xs) = Cons(y, ys)
  ): x = y ∧ xs = ys {
    match e: x = y ∧ xs = ys {
      Refl => AndIntro(Refl, Refl)
    }
  }

  pub theorem cons_congr<A: Type>(
    x: A,
    y: A,
    xs: List(A),
    ys: List(A),
    hx: x = y,
    hs: xs = ys
  ): Cons(x, xs) = Cons(y, ys) {
    calc Cons(x, xs) {
      = Cons(y, xs) from Eq::congr(A, List(A), x, y, ⟦Cons(□, xs)⟧, hx)
      = Cons(y, ys) from Eq::congr(List(A), List(A), xs, ys, ⟦Cons(y, □)⟧, hs)
    }
  }
}

// Element by element; a list that ends first is the smaller.
instance<A> Ord(List(A)) where Ord(A) {
  fn compare(&xs: List(A), &ys: List(A)): Ordering {
    match xs: Ordering {
      Nil => match ys: Ordering {
        Nil => Equal
        Cons(y, ys2) => Less
      }
      Cons(x, xs2) => match ys: Ordering {
        Nil => Greater
        Cons(y, ys2) => ord_then(Ord::compare(&x, &y), Ord::compare(&xs2, &ys2))
      }
    }
  }
  law equal_iff<a: List(A), b: List(A)>(): Ord::compare(a, b) = Equal ↔ a = b {
    match a: Ord::compare(a, b) = Equal ↔ a = b {
      Nil => match b: Ord::compare(Nil, b) = Equal ↔ Nil = b {
        Nil => IffIntro((e: Equal = Equal) => Refl, (e: Eq(List(A), Nil, Nil)) => Refl)
        Cons(y, ys) => IffIntro(
          (e: Less = Equal) => False::elim(less_ne_equal(e)),
          (e: Nil = Cons(y, ys)) => False::elim(List::nil_ne_cons(y, ys, e))
        )
      }
      Cons(x, xs) => match b: Ord::compare(Cons(x, xs), b) = Equal ↔ Cons(x, xs) = b {
        Nil => IffIntro(
          (e: Greater = Equal) => False::elim(greater_ne_equal(e)),
          (e: Cons(x, xs) = Nil) => False::elim(List::cons_ne_nil(x, xs, e))
        )
        Cons(y, ys) => IffIntro(
          (
            e: ord_then(Ord::compare(x, y), Ord::compare(xs, ys)) = Equal
          ) => match ord_then_equal(Ord::compare(x, y), Ord::compare(xs, ys), e): Cons(x, xs) = Cons(y, ys) {
            AndIntro(hx, hxs) => List::cons_congr(
              x,
              y,
              xs,
              ys,
              ord_equal_eq(x, y, hx),
              Iff::mp(Ord::equal_iff(xs, ys), hxs)
            )
          },
          (e: Cons(x, xs) = Cons(y, ys)) => match List::cons_inj(x, y, xs, ys, e): ord_then(
            Ord::compare(x, y),
            Ord::compare(xs, ys)
          ) = Equal {
            AndIntro(hx, hxs) => ord_then_of_equal(
              Ord::compare(x, y),
              Ord::compare(xs, ys),
              Equal,
              ord_eq_equal(x, y, hx),
              Iff::mpr(Ord::equal_iff(xs, ys), hxs)
            )
          }
        )
      }
    }
  }
  law swap<a: List(A), b: List(A)>(): Ord::compare(a, b) = Less ↔ Ord::compare(b, a) = Greater {
    match a: Ord::compare(a, b) = Less ↔ Ord::compare(b, a) = Greater {
      Nil => match b: Ord::compare(Nil, b) = Less ↔ Ord::compare(b, Nil) = Greater {
        Nil => IffIntro(
          (e: Equal = Less) => False::elim(equal_ne_less(e)),
          (e: Equal = Greater) => False::elim(equal_ne_greater(e))
        )
        Cons(_, _) => IffIntro((e: Less = Less) => Refl, (e: Greater = Greater) => Refl)
      }
      Cons(x, xs) => match b: Ord::compare(
        Cons(x, xs),
        b
      ) = Less ↔ Ord::compare(b, Cons(x, xs)) = Greater {
        Nil => IffIntro(
          (e: Greater = Less) => False::elim(greater_ne_less(e)),
          (e: Less = Greater) => False::elim(less_ne_greater(e))
        )
        Cons(y, ys) => IffIntro(
          (
            e: ord_then(Ord::compare(x, y), Ord::compare(xs, ys)) = Less
          ) => match ord_then_less(Ord::compare(x, y), Ord::compare(xs, ys), e): ord_then(
            Ord::compare(y, x),
            Ord::compare(ys, xs)
          ) = Greater {
            OrInl(h) => ord_then_of_greater(Ord::compare(y, x), Ord::compare(ys, xs), ord_swap_less(x, y, h))
            OrInr(AndIntro(hx, hxs)) => ord_then_of_equal(
              Ord::compare(y, x),
              Ord::compare(ys, xs),
              Greater,
              ord_eq_equal(y, x, Eq::sym(ord_equal_eq(x, y, hx))),
              Iff::mp(Ord::swap(xs, ys), hxs)
            )
          },
          (
            e: ord_then(Ord::compare(y, x), Ord::compare(ys, xs)) = Greater
          ) => match ord_then_greater(Ord::compare(y, x), Ord::compare(ys, xs), e): ord_then(
            Ord::compare(x, y),
            Ord::compare(xs, ys)
          ) = Less {
            OrInl(h) => ord_then_of_less(Ord::compare(x, y), Ord::compare(xs, ys), ord_swap_greater(y, x, h))
            OrInr(AndIntro(hx, hxs)) => ord_then_of_equal(
              Ord::compare(x, y),
              Ord::compare(xs, ys),
              Less,
              ord_eq_equal(x, y, Eq::sym(ord_equal_eq(y, x, hx))),
              Iff::mpr(Ord::swap(xs, ys), hxs)
            )
          }
        )
      }
    }
  }
  law trans<a: List(
    A
  ), b: List(
    A
  ), c: List(
    A
  )>(h1: Ord::compare(a, b) = Less, h2: Ord::compare(b, c) = Less): Ord::compare(a, c) = Less {
    match a: Ord::compare(a, c) = Less {
      Nil => match c: Ord::compare(Nil, c) = Less {
        Nil => match b: Equal = Less {
          Nil => False::elim(equal_ne_less(h1))
          Cons(_, _) => False::elim(greater_ne_less(h2))
        }
        Cons(_, _) => Refl
      }
      Cons(x, xs) => match b: Ord::compare(Cons(x, xs), c) = Less {
        Nil => False::elim(greater_ne_less(h1))
        Cons(y, ys) => match c: Ord::compare(Cons(x, xs), c) = Less {
          Nil => False::elim(greater_ne_less(h2))
          Cons(z, zs) => match ord_then_less(
            Ord::compare(x, y),
            Ord::compare(xs, ys),
            h1
          ): ord_then(Ord::compare(x, z), Ord::compare(xs, zs)) = Less {
            OrInl(p1) => match ord_then_less(
              Ord::compare(y, z),
              Ord::compare(ys, zs),
              h2
            ): ord_then(Ord::compare(x, z), Ord::compare(xs, zs)) = Less {
              OrInl(p2) => ord_then_of_less(
                Ord::compare(x, z),
                Ord::compare(xs, zs),
                ord_trans(x, y, z, p1, p2)
              )
              OrInr(AndIntro(q2, _)) => ord_then_of_less(
                Ord::compare(x, z),
                Ord::compare(xs, zs),
                Eq::subst(A, y, z, (w: A) => Ord::compare(x, w) = Less, ord_equal_eq(y, z, q2), p1)
              )
            }
            OrInr(AndIntro(q1, r1)) => match ord_then_less(
              Ord::compare(y, z),
              Ord::compare(ys, zs),
              h2
            ): ord_then(Ord::compare(x, z), Ord::compare(xs, zs)) = Less {
              OrInl(p2) => ord_then_of_less(
                Ord::compare(x, z),
                Ord::compare(xs, zs),
                Eq::subst(
                  A,
                  y,
                  x,
                  (w: A) => Ord::compare(w, z) = Less,
                  Eq::sym(ord_equal_eq(x, y, q1)),
                  p2
                )
              )
              OrInr(AndIntro(q2, r2)) => ord_then_of_equal(
                Ord::compare(x, z),
                Ord::compare(xs, zs),
                Less,
                ord_eq_equal(
                  x,
                  z,
                  calc x {
                    = y from ord_equal_eq(x, y, q1)
                    = z from ord_equal_eq(y, z, q2)
                  }
                ),
                Ord::trans(xs, ys, zs, r1, r2)
              )
            }
          }
        }
      }
    }
  }
}

module Pair {
  pub theorem inj<A: Type, B: Type>(
    x1: A,
    y1: B,
    x2: A,
    y2: B,
    e: (Pair { fst: x1, snd: y1 }) = (Pair { fst: x2, snd: y2 })
  ): x1 = x2 ∧ y1 = y2 {
    match e: x1 = x2 ∧ y1 = y2 {
      Refl => AndIntro(Refl, Refl)
    }
  }

  pub theorem congr<A: Type, B: Type>(
    x1: A,
    y1: B,
    x2: A,
    y2: B,
    hx: x1 = x2,
    hy: y1 = y2
  ): (Pair { fst: x1, snd: y1 }) = (Pair { fst: x2, snd: y2 }) {
    calc (Pair { fst: x1, snd: y1 }) {
      = (
        Pair { fst: x2, snd: y1 }
      ) from Eq::congr(A, Pair(A, B), x1, x2, ⟦(Pair { fst: □, snd: y1 })⟧, hx)
      = (
        Pair { fst: x2, snd: y2 }
      ) from Eq::congr(B, Pair(A, B), y1, y2, ⟦(Pair { fst: x2, snd: □ })⟧, hy)
    }
  }
}

instance<A, B> Ord(Pair(A, B)) where Ord(A), Ord(B) {
  fn compare(&p: Pair(A, B), &q: Pair(A, B)): Ordering {
    match p: Ordering {
      Pair { fst: x1, snd: y1 } => match q: Ordering {
        Pair { fst: x2, snd: y2 } => ord_then(Ord::compare(&x1, &x2), Ord::compare(&y1, &y2))
      }
    }
  }
  law equal_iff<p: Pair(A, B), q: Pair(A, B)>(): Ord::compare(p, q) = Equal ↔ p = q {
    match p: Ord::compare(p, q) = Equal ↔ p = q {
      Pair { fst: x1, snd: y1 } => match q: Ord::compare(
        Pair { fst: x1, snd: y1 },
        q
      ) = Equal ↔ (Pair { fst: x1, snd: y1 }) = q {
        Pair { fst: x2, snd: y2 } => IffIntro(
          (
            e: ord_then(Ord::compare(x1, x2), Ord::compare(y1, y2)) = Equal
          ) => match ord_then_equal(Ord::compare(x1, x2), Ord::compare(y1, y2), e): (Pair { fst: x1, snd: y1 }) = (Pair { fst: x2, snd: y2 }) {
            AndIntro(hx, hy) => Pair::congr(x1, y1, x2, y2, ord_equal_eq(x1, x2, hx), ord_equal_eq(y1, y2, hy))
          },
          (e: (Pair { fst: x1, snd: y1 }) = Pair { fst: x2, snd: y2 }) => match Pair::inj(x1, y1, x2, y2, e): ord_then(
            Ord::compare(x1, x2),
            Ord::compare(y1, y2)
          ) = Equal {
            AndIntro(hx, hy) => ord_then_of_equal(
              Ord::compare(x1, x2),
              Ord::compare(y1, y2),
              Equal,
              ord_eq_equal(x1, x2, hx),
              ord_eq_equal(y1, y2, hy)
            )
          }
        )
      }
    }
  }
  law swap<p: Pair(
    A,
    B
  ), q: Pair(A, B)>(): Ord::compare(p, q) = Less ↔ Ord::compare(q, p) = Greater {
    match p: Ord::compare(p, q) = Less ↔ Ord::compare(q, p) = Greater {
      Pair { fst: x1, snd: y1 } => match q: Ord::compare(
        Pair { fst: x1, snd: y1 },
        q
      ) = Less ↔ Ord::compare(q, (Pair { fst: x1, snd: y1 })) = Greater {
        Pair { fst: x2, snd: y2 } => IffIntro(
          (
            e: ord_then(Ord::compare(x1, x2), Ord::compare(y1, y2)) = Less
          ) => match ord_then_less(Ord::compare(x1, x2), Ord::compare(y1, y2), e): ord_then(
            Ord::compare(x2, x1),
            Ord::compare(y2, y1)
          ) = Greater {
            OrInl(h) => ord_then_of_greater(Ord::compare(x2, x1), Ord::compare(y2, y1), ord_swap_less(x1, x2, h))
            OrInr(AndIntro(hx, hy)) => ord_then_of_equal(
              Ord::compare(x2, x1),
              Ord::compare(y2, y1),
              Greater,
              ord_eq_equal(x2, x1, Eq::sym(ord_equal_eq(x1, x2, hx))),
              ord_swap_less(y1, y2, hy)
            )
          },
          (
            e: ord_then(Ord::compare(x2, x1), Ord::compare(y2, y1)) = Greater
          ) => match ord_then_greater(Ord::compare(x2, x1), Ord::compare(y2, y1), e): ord_then(
            Ord::compare(x1, x2),
            Ord::compare(y1, y2)
          ) = Less {
            OrInl(h) => ord_then_of_less(Ord::compare(x1, x2), Ord::compare(y1, y2), ord_swap_greater(x2, x1, h))
            OrInr(AndIntro(hx, hy)) => ord_then_of_equal(
              Ord::compare(x1, x2),
              Ord::compare(y1, y2),
              Less,
              ord_eq_equal(x1, x2, Eq::sym(ord_equal_eq(x2, x1, hx))),
              ord_swap_greater(y2, y1, hy)
            )
          }
        )
      }
    }
  }
  law trans<p: Pair(
    A,
    B
  ), q: Pair(
    A,
    B
  ), r: Pair(
    A,
    B
  )>(h1: Ord::compare(p, q) = Less, h2: Ord::compare(q, r) = Less): Ord::compare(p, r) = Less {
    match p: Ord::compare(p, r) = Less {
      Pair { fst: x1, snd: y1 } => match q: Ord::compare(Pair { fst: x1, snd: y1 }, r) = Less {
        Pair { fst: x2, snd: y2 } => match r: Ord::compare(Pair { fst: x1, snd: y1 }, r) = Less {
          Pair { fst: x3, snd: y3 } => match ord_then_less(
            Ord::compare(x1, x2),
            Ord::compare(y1, y2),
            h1
          ): ord_then(Ord::compare(x1, x3), Ord::compare(y1, y3)) = Less {
            OrInl(p1) => match ord_then_less(
              Ord::compare(x2, x3),
              Ord::compare(y2, y3),
              h2
            ): ord_then(Ord::compare(x1, x3), Ord::compare(y1, y3)) = Less {
              OrInl(p2) => ord_then_of_less(
                Ord::compare(x1, x3),
                Ord::compare(y1, y3),
                ord_trans(x1, x2, x3, p1, p2)
              )
              OrInr(AndIntro(q2, _)) => ord_then_of_less(
                Ord::compare(x1, x3),
                Ord::compare(y1, y3),
                Eq::subst(
                  A,
                  x2,
                  x3,
                  (w: A) => Ord::compare(x1, w) = Less,
                  ord_equal_eq(x2, x3, q2),
                  p1
                )
              )
            }
            OrInr(AndIntro(q1, r1)) => match ord_then_less(
              Ord::compare(x2, x3),
              Ord::compare(y2, y3),
              h2
            ): ord_then(Ord::compare(x1, x3), Ord::compare(y1, y3)) = Less {
              OrInl(p2) => ord_then_of_less(
                Ord::compare(x1, x3),
                Ord::compare(y1, y3),
                Eq::subst(
                  A,
                  x2,
                  x1,
                  (w: A) => Ord::compare(w, x3) = Less,
                  Eq::sym(ord_equal_eq(x1, x2, q1)),
                  p2
                )
              )
              OrInr(AndIntro(q2, r2)) => ord_then_of_equal(
                Ord::compare(x1, x3),
                Ord::compare(y1, y3),
                Less,
                ord_eq_equal(
                  x1,
                  x3,
                  calc x1 {
                    = x2 from ord_equal_eq(x1, x2, q1)
                    = x3 from ord_equal_eq(x2, x3, q2)
                  }
                ),
                ord_trans(y1, y2, y3, r1, r2)
              )
            }
          }
        }
      }
    }
  }
}

// The product `A × B`, in the order of its members. To the proofs a product is the `Pair`
// of its members, so `Pair::congr` and `Pair::inj` are its own.
instance<A, B> Ord(A × B) where Ord(A), Ord(B) {
  fn compare(&p: A × B, &q: A × B): Ordering {
    match p: Ordering {
      #(x1, y1) => match q: Ordering {
        #(x2, y2) => ord_then(Ord::compare(&x1, &x2), Ord::compare(&y1, &y2))
      }
    }
  }
  law equal_iff<p: A × B, q: A × B>(): Ord::compare(p, q) = Equal ↔ p = q {
    match p: Ord::compare(p, q) = Equal ↔ p = q {
      #(x1, y1) => match q: Ord::compare(#(x1, y1), q) = Equal ↔ #(x1, y1) = q {
        #(x2, y2) => IffIntro(
          (
            e: ord_then(Ord::compare(x1, x2), Ord::compare(y1, y2)) = Equal
          ) => match ord_then_equal(Ord::compare(x1, x2), Ord::compare(y1, y2), e): #(x1, y1) = #(x2, y2) {
            AndIntro(hx, hy) => Pair::congr(x1, y1, x2, y2, ord_equal_eq(x1, x2, hx), ord_equal_eq(y1, y2, hy))
          },
          (e: #(x1, y1) = #(x2, y2)) => match Pair::inj(x1, y1, x2, y2, e): ord_then(
            Ord::compare(x1, x2),
            Ord::compare(y1, y2)
          ) = Equal {
            AndIntro(hx, hy) => ord_then_of_equal(
              Ord::compare(x1, x2),
              Ord::compare(y1, y2),
              Equal,
              ord_eq_equal(x1, x2, hx),
              ord_eq_equal(y1, y2, hy)
            )
          }
        )
      }
    }
  }
  law swap<p: A × B, q: A × B>(): Ord::compare(p, q) = Less ↔ Ord::compare(q, p) = Greater {
    match p: Ord::compare(p, q) = Less ↔ Ord::compare(q, p) = Greater {
      #(x1, y1) => match q: Ord::compare(
        #(x1, y1),
        q
      ) = Less ↔ Ord::compare(q, #(x1, y1)) = Greater {
        #(x2, y2) => IffIntro(
          (
            e: ord_then(Ord::compare(x1, x2), Ord::compare(y1, y2)) = Less
          ) => match ord_then_less(Ord::compare(x1, x2), Ord::compare(y1, y2), e): ord_then(
            Ord::compare(x2, x1),
            Ord::compare(y2, y1)
          ) = Greater {
            OrInl(h) => ord_then_of_greater(Ord::compare(x2, x1), Ord::compare(y2, y1), ord_swap_less(x1, x2, h))
            OrInr(AndIntro(hx, hy)) => ord_then_of_equal(
              Ord::compare(x2, x1),
              Ord::compare(y2, y1),
              Greater,
              ord_eq_equal(x2, x1, Eq::sym(ord_equal_eq(x1, x2, hx))),
              ord_swap_less(y1, y2, hy)
            )
          },
          (
            e: ord_then(Ord::compare(x2, x1), Ord::compare(y2, y1)) = Greater
          ) => match ord_then_greater(Ord::compare(x2, x1), Ord::compare(y2, y1), e): ord_then(
            Ord::compare(x1, x2),
            Ord::compare(y1, y2)
          ) = Less {
            OrInl(h) => ord_then_of_less(Ord::compare(x1, x2), Ord::compare(y1, y2), ord_swap_greater(x2, x1, h))
            OrInr(AndIntro(hx, hy)) => ord_then_of_equal(
              Ord::compare(x1, x2),
              Ord::compare(y1, y2),
              Less,
              ord_eq_equal(x1, x2, Eq::sym(ord_equal_eq(x2, x1, hx))),
              ord_swap_greater(y2, y1, hy)
            )
          }
        )
      }
    }
  }
  law trans<p: A × B, q: A × B, r: A × B>(
    h1: Ord::compare(p, q) = Less,
    h2: Ord::compare(q, r) = Less
  ): Ord::compare(p, r) = Less {
    match p: Ord::compare(p, r) = Less {
      #(x1, y1) => match q: Ord::compare(#(x1, y1), r) = Less {
        #(x2, y2) => match r: Ord::compare(#(x1, y1), r) = Less {
          #(x3, y3) => match ord_then_less(
            Ord::compare(x1, x2),
            Ord::compare(y1, y2),
            h1
          ): ord_then(Ord::compare(x1, x3), Ord::compare(y1, y3)) = Less {
            OrInl(p1) => match ord_then_less(
              Ord::compare(x2, x3),
              Ord::compare(y2, y3),
              h2
            ): ord_then(Ord::compare(x1, x3), Ord::compare(y1, y3)) = Less {
              OrInl(p2) => ord_then_of_less(
                Ord::compare(x1, x3),
                Ord::compare(y1, y3),
                ord_trans(x1, x2, x3, p1, p2)
              )
              OrInr(AndIntro(q2, _)) => ord_then_of_less(
                Ord::compare(x1, x3),
                Ord::compare(y1, y3),
                Eq::subst(
                  A,
                  x2,
                  x3,
                  (w: A) => Ord::compare(x1, w) = Less,
                  ord_equal_eq(x2, x3, q2),
                  p1
                )
              )
            }
            OrInr(AndIntro(q1, r1)) => match ord_then_less(
              Ord::compare(x2, x3),
              Ord::compare(y2, y3),
              h2
            ): ord_then(Ord::compare(x1, x3), Ord::compare(y1, y3)) = Less {
              OrInl(p2) => ord_then_of_less(
                Ord::compare(x1, x3),
                Ord::compare(y1, y3),
                Eq::subst(
                  A,
                  x2,
                  x1,
                  (w: A) => Ord::compare(w, x3) = Less,
                  Eq::sym(ord_equal_eq(x1, x2, q1)),
                  p2
                )
              )
              OrInr(AndIntro(q2, r2)) => ord_then_of_equal(
                Ord::compare(x1, x3),
                Ord::compare(y1, y3),
                Less,
                ord_eq_equal(
                  x1,
                  x3,
                  calc x1 {
                    = x2 from ord_equal_eq(x1, x2, q1)
                    = x3 from ord_equal_eq(x2, x3, q2)
                  }
                ),
                ord_trans(y1, y2, y3, r1, r2)
              )
            }
          }
        }
      }
    }
  }
}
