// The host's operating system (`docs/design/self-host.md`). A failure is a
// `Result` with a text a person reads.

extern {
  fn os_args() -> List(Text)
  fn os_read_file(path: Text) -> Result(Text, Text)
  fn os_write_file(path: Text, contents: Text) -> Result((), Text)
  fn os_print(t: Text) -> ()
  fn os_eprint(t: Text) -> ()
  fn os_exit(code: i32) -> Never
}
