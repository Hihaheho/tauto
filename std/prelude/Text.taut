module Text {
  // Text and Buf: builtins the host provides; a program cannot write them
  // itself (`docs/design/self-host.md`).
  // Positions in a Text are UTF-8 bytes. The evaluator implements these
  // `extern` functions; their signatures are trusted.

  extern {
    fn len(t: Text): u64
    fn byte(t: Text, i: u64): Option(u8)
    fn slice(t: Text, start: u64, end: u64): Option(Text)
    fn compare(a: Text, b: Text): i64
    fn of_code_point(c: u32): Option(Text)
    fn of_utf8(bytes: List(u8)): Option(Text)
    fn of_i64(n: i64): Text
    fn of_u64(n: u64): Text
    fn of_nat(n: nat): Text
  }
}

module Buf {
  extern {
    fn new(): Buf
    fn push(&mut b: Buf, &t: Text): Unit
  }
}
