// Text and Buf: builtins the host provides; a program cannot write them
// itself (`docs/design/self-host.md`).
// Positions in a Text are UTF-8 bytes. The evaluator implements these
// `extern` functions; their signatures are trusted.

extern {
  fn text_len(t: Text) -> u64
  fn text_byte(t: Text, i: u64) -> Option(u8)
  fn text_slice(t: Text, start: u64, end: u64) -> Option(Text)
  fn text_compare(a: Text, b: Text) -> i64
  fn text_of_code_point(c: u32) -> Option(Text)
  fn text_of_i64(n: i64) -> Text
  fn text_of_u64(n: u64) -> Text
  fn buf_new() -> Buf
  fn buf_push(&mut b: Buf, &t: Text) -> ()
}
