// The affine standard library: owned buffers and containers, used at most
// once, moved, and read or changed through `&` and `&mut` borrows
// (`docs/design/ownership.md`「標準ライブラリ」). The evaluator implements
// the `extern` functions, and nothing checks their signatures against it:
// they are trusted. Conversions to the shared library consume owned
// containers; conversions from borrowed shared data copy it.

pub affine struct Buf {}
pub affine struct Vec(A: Type) {}
pub affine struct HashMap(K: Type, V: Type) {}
// A run of elements, which can only be borrowed (`&Slice(A)`).
pub affine struct Slice(A: Type) {}
pub(open) effect missing(): Never resume 0
pub(open) effect out_of_bounds(): Never resume 0

module Text {
  extern {
    fn of(b: Buf): Text
  }
}

module Buf {
  extern {
    fn of(&t: Text): Buf
    fn clone(&b: Buf): Buf
  }

  pub fn each_word<!e: <=1>(&s: Buf, &f: (&w: Buf) -> Unit ! e): Unit ! e {
    each(words(Text::of(clone(&s))), (w) => {
      let b := of(&w)
      f(&b)
    })
  }
}

module Vec {
  extern {

    fn new<A: Linear>(): Vec(A)
    fn push<A: Linear>(&mut v: Vec(A), x: A): Unit
    fn pop<A: Linear>(&mut v: Vec(A)): Option(A)
    fn len<A: Linear>(&v: Vec(A)): u64
    fn index<A: Linear>(&v: Vec(A), i: u64): &A ! {out_of_bounds}
    fn get<A: Linear>(&v: Vec(A), i: u64): Option(&A)
    fn get_mut<A: Linear>(&mut v: Vec(A), i: u64): Option(&mut A)
    fn last_mut<A: Linear>(&mut v: Vec(A)): Option(&mut A)
    fn as_slice<A: Linear>(&v: Vec(A)): &Slice(A)
    fn as_mut_slice<A: Linear>(&mut v: Vec(A)): &mut Slice(A)
    fn clear<A>(&mut v: Vec(A)): Unit
    fn truncate<A>(&mut v: Vec(A), n: u64): Unit
    fn swap<A: Linear>(&mut v: Vec(A), i: u64, j: u64): Unit ! {out_of_bounds}
    // Every element, in order.
    fn into_list<A: Linear>(v: Vec(A)): List(A)
    // Consume the builder without constructing an intermediate list.
    fn into_array<A: Shared>(v: Vec(A)): Array(A)
  }

  pub fn each<A: Linear, !e>(&v: Vec(A), &f: (&x: A) -> Unit ! e): Unit ! e {
    handle {
      var i: u64 := 0
      while i < Vec::len(&v) {
        let &x := index(&v, i)
        f(&x)
        i := i + 1
      }
    } with {
      out_of_bounds() => #()
    }
  }

  pub fn consume<A, !e: <=1>(v: Vec(A), &f: (x: A) -> Unit ! e): Unit ! e {
    List::consume(into_list(v), &f)
  }

  // Insertion sort in place: the elements stay in `v`, so none is held
  // across the loops.
  pub fn sort_by<A: Linear>(&mut v: Vec(A), &lt: (&a: A, &b: A) -> Bool): Unit {
    var i: u64 := 1
    while i < Vec::len(&v) {
      var j: u64 := i
      while 0 < j {
        if before(&v, j, &lt) {
          handle { swap(&mut v, j - 1, j) } with { out_of_bounds() => #() }
          j := j - 1
        } else {
          j := 0
        }
      }
      i := i + 1
    }
  }

  pub fn before<A: Linear>(&v: Vec(A), j: u64, &lt: (&a: A, &b: A) -> Bool): Bool {
    handle {
      let &a := index(&v, j)
      let &b := index(&v, j - 1)
      lt(&a, &b)
    } with {
      out_of_bounds() => false
    }
  }
}

module Slice {
  extern {
    fn len<A: Linear>(&s: Slice(A)): u64
    fn get<A: Linear>(&s: Slice(A), i: u64): Option(&A)
  }
}

module HashMap {
  extern {

    fn new<K: Linear, V: Linear>(): HashMap(K, V) where DecEq(K), Hash(K)
    fn get<K: Linear, V: Linear>(&m: HashMap(K, V), &k: K): Option(&V) where DecEq(K), Hash(K)
    fn get_mut<K: Linear, V: Linear>(
      &mut m: HashMap(K, V),
      &k: K
    ): Option(&mut V) where DecEq(K), Hash(K)
    fn index<K: Linear, V: Linear>(&m: HashMap(K, V), &k: K): &V ! {missing} where DecEq(K), Hash(K)
    fn insert<K: Linear, V: Linear>(
      &mut m: HashMap(K, V),
      k: K,
      v: V
    ): Option(V) where DecEq(K), Hash(K)
    fn into_vec<K: Linear, V: Linear>(m: HashMap(K, V)): Vec(K × V)
  }
}

extern {

  // The only way to move a value out of a `&mut` borrow.
  fn replace<A: Linear>(&mut x: A, v: A): A
}

module List {
  pub fn consume<A, !e: <=1>(xs: List(A), &f: (x: A) -> Unit ! e): Unit ! e {
    match xs {
      Nil => #()
      Cons(x, rest) => {
        f(x)
        consume(rest, &f)
      }
    }
  }
}
