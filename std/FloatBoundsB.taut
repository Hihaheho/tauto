        Int::mul(IntOfNat(Nat::add(e, k0)), IntOfNat(1))
      ),
      IntOfNat(1)
    ),
    Int::add(
      Int::neg(Int::mul(IntOfNat(1), IntOfNat(e))),
      Int::neg(Int::mul(IntOfNat(2926), IntOfNat(1)))
    )
  ),
  Int::mul(IntOfNat(1), IntOfNat(k0))
) {
  by int_norm!(): Eq(
    Int,
    Int::add(
      Int::mul(
        Int::add(
          Int::mul(IntOfNat(2926), IntOfNat(1)),
          Int::mul(IntOfNat(Nat::add(e, k0)), IntOfNat(1))
        ),
        IntOfNat(1)
      ),
      Int::add(
        Int::neg(Int::mul(IntOfNat(1), IntOfNat(e))),
        Int::neg(Int::mul(IntOfNat(2926), IntOfNat(1)))
      )
    ),
    Int::mul(IntOfNat(1), IntOfNat(k0))
  ) {}
}

pub theorem kp_ge_60(
  e: Nat,
  kk: Nat,
  k0: Nat
): Eq(Int, IntOfNat(k0), Int::add(Int::mul(IntOfNat(1), IntOfNat(k0)), IntOfNat(0))) {
  by int_norm!(): Eq(Int, IntOfNat(k0), Int::add(Int::mul(IntOfNat(1), IntOfNat(k0)), IntOfNat(0))) {}
}
