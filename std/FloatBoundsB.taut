      kp_ge_58(e, kk, k0),
      kp_ge_59(e, kk, k0)
    ),
    int_le_by(Int::mul(IntOfNat(1), IntOfNat(k0)), IntOfNat(k0), 0, kp_ge_60(e, kk, k0))
  )
}

