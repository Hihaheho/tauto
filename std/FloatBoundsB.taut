pub theorem kp_ge(
  e: Nat,
  kk: Nat,
  k0: Nat,
  h: NatLe(Succ(Nat::add(e, kk)), 2926),
  hg: NatLe(2926, Nat::add(e, k0))
): NatLe(Succ(kk), k0) {
