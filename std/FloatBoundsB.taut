// Linear facts the proofs of `FloatPack.taut` combine: rounding and the error.

import "IntNorm.taut"
import "IntOrder.taut"

pub theorem n_h3(
  c: Nat,
  T2: Nat,
  Q: Nat,
  Pe: Nat,
  K: Nat,
  S: Nat,
  hr1: NatLe(Nat::mul(2, Nat::mul(c, K)), Nat::add(Nat::mul(2, S), K)),
  hT1: NatLe(T2, Nat::mul(Pe, K))
): NatLe(
  Nat::mul(2, Nat::mul(Nat::mul(c, T2), Q)),
  Nat::add(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe))), Nat::mul(K, Nat::mul(Q, Pe)))
) {
  Int::le_trans(
    IntOfNat(Nat::mul(2, Nat::mul(Nat::mul(c, T2), Q))),
    Int::add(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K)))),
      Int::mul(IntOfNat(2), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S))))
    ),
    IntOfNat(Nat::add(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe))), Nat::mul(K, Nat::mul(Q, Pe)))),
    int_le_lin(
      Int::add(
        Int::mul(IntOfNat(Nat::mul(2, Nat::mul(c, K))), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(T2), IntOfNat(Nat::mul(2, Nat::mul(c, Q))))
      ),
      Int::add(
        Int::mul(IntOfNat(Nat::add(Nat::mul(2, S), K)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::mul(2, Nat::mul(c, Q))))
      ),
      1,
      Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(Q, Nat::mul(Pe, K)))))),
      IntOfNat(Nat::mul(2, Nat::mul(Nat::mul(c, T2), Q))),
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K)))),
        Int::mul(IntOfNat(2), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S))))
      ),
      int_le_add2(
        Int::mul(IntOfNat(Nat::mul(2, Nat::mul(c, K))), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::add(Nat::mul(2, S), K)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(T2), IntOfNat(Nat::mul(2, Nat::mul(c, Q)))),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::mul(2, Nat::mul(c, Q)))),
        int_le_mul_nat(
          IntOfNat(Nat::mul(2, Nat::mul(c, K))),
          IntOfNat(Nat::add(Nat::mul(2, S), K)),
          Nat::mul(Q, Pe),
          hr1
        ),
        int_le_mul_nat(IntOfNat(T2), IntOfNat(Nat::mul(Pe, K)), Nat::mul(2, Nat::mul(c, Q)), hT1)
      ),
      n_h3_0(c, T2, Q, Pe, K, S),
      n_h3_1(c, T2, Q, Pe, K, S)
    ),
    int_le_by(
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K)))),
        Int::mul(IntOfNat(2), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S))))
      ),
      IntOfNat(Nat::add(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe))), Nat::mul(K, Nat::mul(Q, Pe)))),
      0,
      n_h3_2(c, T2, Q, Pe, K, S)
    )
  )
}

pub theorem n_h4(
  c: Nat,
  T2: Nat,
  Q: Nat,
  Pe: Nat,
  K: Nat,
  S: Nat,
  hr2: NatLe(Nat::mul(2, S), Nat::add(Nat::mul(2, Nat::mul(c, K)), K)),
  hT2: NatLe(Nat::mul(Pe, K), T2)
): NatLe(
  Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe))),
  Nat::add(Nat::mul(2, Nat::mul(Nat::mul(c, T2), Q)), Nat::mul(K, Nat::mul(Q, Pe)))
) {
  Int::le_trans(
    IntOfNat(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe)))),
    Int::add(
      Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(T2, Q)))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K))))
    ),
    IntOfNat(Nat::add(Nat::mul(2, Nat::mul(Nat::mul(c, T2), Q)), Nat::mul(K, Nat::mul(Q, Pe)))),
    int_le_lin(
      Int::add(
        Int::mul(IntOfNat(Nat::mul(2, S)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::mul(2, Nat::mul(c, Q))))
      ),
      Int::add(
        Int::mul(IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, K)), K)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(T2), IntOfNat(Nat::mul(2, Nat::mul(c, Q))))
      ),
      1,
      Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(Q, Nat::mul(Pe, K)))))),
      IntOfNat(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe)))),
      Int::add(
        Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(T2, Q)))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K))))
      ),
      int_le_add2(
        Int::mul(IntOfNat(Nat::mul(2, S)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, K)), K)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::mul(2, Nat::mul(c, Q)))),
        Int::mul(IntOfNat(T2), IntOfNat(Nat::mul(2, Nat::mul(c, Q)))),
        int_le_mul_nat(
          IntOfNat(Nat::mul(2, S)),
          IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, K)), K)),
          Nat::mul(Q, Pe),
          hr2
        ),
        int_le_mul_nat(IntOfNat(Nat::mul(Pe, K)), IntOfNat(T2), Nat::mul(2, Nat::mul(c, Q)), hT2)
      ),
      n_h4_3(c, T2, Q, Pe, K, S),
      n_h4_4(c, T2, Q, Pe, K, S)
    ),
    int_le_by(
      Int::add(
        Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(T2, Q)))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K))))
      ),
      IntOfNat(Nat::add(Nat::mul(2, Nat::mul(Nat::mul(c, T2), Q)), Nat::mul(K, Nat::mul(Q, Pe)))),
      0,
      n_h4_5(c, T2, Q, Pe, K, S)
    )
  )
}

pub theorem n_h5(
  Q: Nat,
  Pe: Nat,
  K: Nat,
  S: Nat,
  h: NatLe(Nat::mul(4503599627370496, K), S)
): NatLe(Nat::mul(4503599627370496, Nat::mul(K, Nat::mul(Q, Pe))), Nat::mul(S, Nat::mul(Q, Pe))) {
  Int::le_trans(
    IntOfNat(Nat::mul(4503599627370496, Nat::mul(K, Nat::mul(Q, Pe)))),
    Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S)))),
    IntOfNat(Nat::mul(S, Nat::mul(Q, Pe))),
    int_le_lin(
      Int::mul(IntOfNat(Nat::mul(4503599627370496, K)), IntOfNat(Nat::mul(Q, Pe))),
      Int::mul(IntOfNat(S), IntOfNat(Nat::mul(Q, Pe))),
      1,
      IntOfNat(0),
      IntOfNat(Nat::mul(4503599627370496, Nat::mul(K, Nat::mul(Q, Pe)))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S)))),
      int_le_mul_nat(IntOfNat(Nat::mul(4503599627370496, K)), IntOfNat(S), Nat::mul(Q, Pe), h),
      n_h5_6(Q, Pe, K, S),
      n_h5_7(Q, Pe, K, S)
    ),
    int_le_by(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S)))),
      IntOfNat(Nat::mul(S, Nat::mul(Q, Pe))),
      0,
      n_h5_8(Q, Pe, K, S)
    )
  )
}

pub theorem n_h6(
  Q: Nat,
  Pe: Nat,
  S: Nat,
  h: NatLe(72057594037927936, S)
): NatLe(Nat::mul(72057594037927936, Nat::mul(Q, Pe)), Nat::mul(S, Nat::mul(Q, Pe))) {
  Int::le_trans(
    IntOfNat(Nat::mul(72057594037927936, Nat::mul(Q, Pe))),
    Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S)))),
    IntOfNat(Nat::mul(S, Nat::mul(Q, Pe))),
    int_le_lin(
      Int::mul(IntOfNat(72057594037927936), IntOfNat(Nat::mul(Q, Pe))),
      Int::mul(IntOfNat(S), IntOfNat(Nat::mul(Q, Pe))),
      1,
      IntOfNat(0),
      IntOfNat(Nat::mul(72057594037927936, Nat::mul(Q, Pe))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S)))),
      int_le_mul_nat(IntOfNat(72057594037927936), IntOfNat(S), Nat::mul(Q, Pe), h),
      n_h6_9(Q, Pe, S),
      n_h6_10(Q, Pe, S)
    ),
    int_le_by(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S)))),
      IntOfNat(Nat::mul(S, Nat::mul(Q, Pe))),
      0,
      n_h6_11(Q, Pe, S)
    )
  )
}

pub theorem s_h3(
  c: Nat,
  B: Nat,
  Q: Nat,
  Pe: Nat,
  K: Nat,
  S: Nat,
  hr1: NatLe(Nat::mul(2, Nat::mul(c, K)), Nat::add(Nat::mul(2, S), K)),
  hT1: NatLe(B, Nat::mul(Pe, K)),
  hT2: NatLe(Nat::mul(Pe, K), B)
): NatLe(
  Nat::mul(2, Nat::mul(Nat::mul(c, B), Q)),
  Nat::add(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe))), Nat::mul(Q, B))
) {
  Int::le_trans(
    IntOfNat(Nat::mul(2, Nat::mul(Nat::mul(c, B), Q))),
    Int::add(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(B, Q))),
      Int::mul(IntOfNat(2), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S))))
    ),
    IntOfNat(Nat::add(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe))), Nat::mul(Q, B))),
    int_le_lin(
      Int::add(
        Int::add(
          Int::mul(IntOfNat(Nat::mul(2, Nat::mul(c, K))), IntOfNat(Nat::mul(Q, Pe))),
          Int::mul(IntOfNat(B), IntOfNat(Nat::mul(2, Nat::mul(c, Q))))
        ),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Q))
      ),
      Int::add(
        Int::add(
          Int::mul(IntOfNat(Nat::add(Nat::mul(2, S), K)), IntOfNat(Nat::mul(Q, Pe))),
          Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::mul(2, Nat::mul(c, Q))))
        ),
        Int::mul(IntOfNat(B), IntOfNat(Q))
      ),
      1,
      Int::add(
        Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(Q, Nat::mul(Pe, K)))))),
        Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K)))))
      ),
      IntOfNat(Nat::mul(2, Nat::mul(Nat::mul(c, B), Q))),
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(B, Q))),
        Int::mul(IntOfNat(2), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S))))
      ),
      int_le_add2(
        Int::add(
          Int::mul(IntOfNat(Nat::mul(2, Nat::mul(c, K))), IntOfNat(Nat::mul(Q, Pe))),
          Int::mul(IntOfNat(B), IntOfNat(Nat::mul(2, Nat::mul(c, Q))))
        ),
        Int::add(
          Int::mul(IntOfNat(Nat::add(Nat::mul(2, S), K)), IntOfNat(Nat::mul(Q, Pe))),
          Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::mul(2, Nat::mul(c, Q))))
        ),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Q)),
        Int::mul(IntOfNat(B), IntOfNat(Q)),
        int_le_add2(
          Int::mul(IntOfNat(Nat::mul(2, Nat::mul(c, K))), IntOfNat(Nat::mul(Q, Pe))),
          Int::mul(IntOfNat(Nat::add(Nat::mul(2, S), K)), IntOfNat(Nat::mul(Q, Pe))),
          Int::mul(IntOfNat(B), IntOfNat(Nat::mul(2, Nat::mul(c, Q)))),
          Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::mul(2, Nat::mul(c, Q)))),
          int_le_mul_nat(
            IntOfNat(Nat::mul(2, Nat::mul(c, K))),
            IntOfNat(Nat::add(Nat::mul(2, S), K)),
            Nat::mul(Q, Pe),
            hr1
          ),
          int_le_mul_nat(IntOfNat(B), IntOfNat(Nat::mul(Pe, K)), Nat::mul(2, Nat::mul(c, Q)), hT1)
        ),
        int_le_mul_nat(IntOfNat(Nat::mul(Pe, K)), IntOfNat(B), Q, hT2)
      ),
      s_h3_12(c, B, Q, Pe, K, S),
      s_h3_13(c, B, Q, Pe, K, S)
    ),
    int_le_by(
      Int::add(
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(B, Q))),
        Int::mul(IntOfNat(2), IntOfNat(Nat::mul(Q, Nat::mul(Pe, S))))
      ),
      IntOfNat(Nat::add(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe))), Nat::mul(Q, B))),
      0,
      s_h3_14(c, B, Q, Pe, K, S)
    )
  )
}

pub theorem s_h4(
  c: Nat,
  B: Nat,
  Q: Nat,
  Pe: Nat,
  K: Nat,
  S: Nat,
  hr2: NatLe(Nat::mul(2, S), Nat::add(Nat::mul(2, Nat::mul(c, K)), K)),
  hT2: NatLe(Nat::mul(Pe, K), B)
): NatLe(
  Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe))),
  Nat::add(Nat::mul(2, Nat::mul(Nat::mul(c, B), Q)), Nat::mul(Q, B))
) {
  Int::le_trans(
    IntOfNat(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe)))),
    Int::add(
      Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(B, Q)))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(B, Q)))
    ),
    IntOfNat(Nat::add(Nat::mul(2, Nat::mul(Nat::mul(c, B), Q)), Nat::mul(Q, B))),
    int_le_lin(
      Int::add(
        Int::mul(IntOfNat(Nat::mul(2, S)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, Q)), Q)))
      ),
      Int::add(
        Int::mul(IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, K)), K)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(B), IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, Q)), Q)))
      ),
      1,
      Int::add(
        Int::neg(Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(Q, Nat::mul(Pe, K)))))),
        Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K)))))
      ),
      IntOfNat(Nat::mul(2, Nat::mul(S, Nat::mul(Q, Pe)))),
      Int::add(
        Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(B, Q)))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(B, Q)))
      ),
      int_le_add2(
        Int::mul(IntOfNat(Nat::mul(2, S)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, K)), K)), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, Q)), Q))),
        Int::mul(IntOfNat(B), IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, Q)), Q))),
        int_le_mul_nat(
          IntOfNat(Nat::mul(2, S)),
          IntOfNat(Nat::add(Nat::mul(2, Nat::mul(c, K)), K)),
          Nat::mul(Q, Pe),
          hr2
        ),
        int_le_mul_nat(
          IntOfNat(Nat::mul(Pe, K)),
          IntOfNat(B),
          Nat::add(Nat::mul(2, Nat::mul(c, Q)), Q),
          hT2
        )
      ),
      s_h4_15(c, B, Q, Pe, K, S),
      s_h4_16(c, B, Q, Pe, K, S)
    ),
    int_le_by(
      Int::add(
        Int::mul(IntOfNat(2), IntOfNat(Nat::mul(c, Nat::mul(B, Q)))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(B, Q)))
      ),
      IntOfNat(Nat::add(Nat::mul(2, Nat::mul(Nat::mul(c, B), Q)), Nat::mul(Q, B))),
      0,
      s_h4_17(c, B, Q, Pe, K, S)
    )
  )
}

pub theorem s_h8(
  Q: Nat,
  Pe: Nat,
  K: Nat,
  B: Nat,
  hK: NatLe(16, K),
  hT2: NatLe(Nat::mul(Pe, K), B)
): NatLe(Nat::mul(16, Nat::mul(Q, Pe)), Nat::mul(Q, B)) {
  Int::le_trans(
    IntOfNat(Nat::mul(16, Nat::mul(Q, Pe))),
    Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, B))),
    IntOfNat(Nat::mul(Q, B)),
    int_le_lin(
      Int::add(
        Int::mul(IntOfNat(16), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Q))
      ),
      Int::add(
        Int::mul(IntOfNat(K), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(B), IntOfNat(Q))
      ),
      1,
      Int::neg(Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, Nat::mul(Pe, K))))),
      IntOfNat(Nat::mul(16, Nat::mul(Q, Pe))),
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, B))),
      int_le_add2(
        Int::mul(IntOfNat(16), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(K), IntOfNat(Nat::mul(Q, Pe))),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Q)),
        Int::mul(IntOfNat(B), IntOfNat(Q)),
        int_le_mul_nat(IntOfNat(16), IntOfNat(K), Nat::mul(Q, Pe), hK),
        int_le_mul_nat(IntOfNat(Nat::mul(Pe, K)), IntOfNat(B), Q, hT2)
      ),
      s_h8_18(Q, Pe, K, B),
      s_h8_19(Q, Pe, K, B)
    ),
    int_le_by(
      Int::mul(IntOfNat(1), IntOfNat(Nat::mul(Q, B))),
      IntOfNat(Nat::mul(Q, B)),
      0,
      s_h8_20(Q, Pe, K, B)
    )
  )
}

pub theorem z_err_a(
  S: Nat,
  Q: Nat,
  Pe: Nat,
  P: Nat,
  Z: Nat,
  B: Nat,
  K: Nat,
  h2: NatLe(Nat::mul(P, Z), Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))),
  hhi: NatLe(S, 288230376151711744),
  hK: NatLe(1152921504606846976, K),
  hT2: NatLe(Nat::mul(Pe, K), B)
): NatLe(
  Nat::mul(4503599627370496, Nat::mul(Nat::mul(0, B), Q)),
  Nat::add(
    Nat::mul(4503599627370496, Nat::mul(P, Z)),
    Nat::add(Nat::mul(P, Z), Nat::mul(4503599627370496, Nat::mul(Q, B)))
  )
) {
  int_le_by(
    IntOfNat(Nat::mul(4503599627370496, Nat::mul(Nat::mul(0, B), Q))),
    IntOfNat(
      Nat::add(
        Nat::mul(4503599627370496, Nat::mul(P, Z)),
        Nat::add(Nat::mul(P, Z), Nat::mul(4503599627370496, Nat::mul(Q, B)))
      )
    ),
    Nat::add(Nat::mul(4503599627370496, Nat::mul(Q, B)), Nat::mul(4503599627370497, Nat::mul(P, Z))),
    z_err_a_21(S, Q, Pe, P, Z, B, K)
  )
}

pub theorem z_err_b(
  S: Nat,
  Q: Nat,
  Pe: Nat,
  P: Nat,
  Z: Nat,
  B: Nat,
  K: Nat,
  h2: NatLe(Nat::mul(P, Z), Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))),
  hhi: NatLe(S, 288230376151711744),
  hK: NatLe(1152921504606846976, K),
  hT2: NatLe(Nat::mul(Pe, K), B)
): NatLe(
  Nat::mul(4503599627370496, Nat::mul(P, Z)),
  Nat::add(
    Nat::mul(4503599627370496, Nat::mul(Nat::mul(0, B), Q)),
    Nat::add(Nat::mul(P, Z), Nat::mul(4503599627370496, Nat::mul(Q, B)))
  )
) {
  Int::le_trans(
    IntOfNat(Nat::mul(4503599627370496, Nat::mul(P, Z))),
    Int::add(
      Int::neg(Int::mul(IntOfNat(3894222643901121005124648771256321), IntOfNat(Nat::mul(Q, Pe)))),
      Int::add(
        Int::mul(IntOfNat(4503599627370496), IntOfNat(Nat::mul(Q, B))),
        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(P, Z)))
      )
    ),
    IntOfNat(
      Nat::add(
        Nat::mul(4503599627370496, Nat::mul(Nat::mul(0, B), Q)),
        Nat::add(Nat::mul(P, Z), Nat::mul(4503599627370496, Nat::mul(Q, B)))
      )
    ),
    int_le_lin(
      Int::add(
        Int::add(
          Int::add(
            Int::mul(IntOfNat(Nat::mul(P, Z)), IntOfNat(4503599627370495)),
            Int::mul(IntOfNat(S), IntOfNat(Nat::mul(4503599627370495, Nat::mul(Q, Pe))))
          ),
          Int::mul(
            IntOfNat(1152921504606846976),
            IntOfNat(Nat::mul(4503599627370496, Nat::mul(Q, Pe)))
          )
        ),
        Int::mul(IntOfNat(Nat::mul(Pe, K)), IntOfNat(Nat::mul(4503599627370496, Q)))
      ),
      Int::add(
        Int::add(
          Int::add(
            Int::mul(
              IntOfNat(Nat::add(Nat::mul(S, Nat::mul(Q, Pe)), Nat::mul(Q, Pe))),
              IntOfNat(4503599627370495)
            ),
            Int::mul(
              IntOfNat(288230376151711744),
              IntOfNat(Nat::mul(4503599627370495, Nat::mul(Q, Pe)))
