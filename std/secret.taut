pub theorem Ct::u32_select_true(
  c: Secret(Bool),
  a: Secret(UInt(32)),
  b: Secret(UInt(32)),
  h: expose(c) = true
): Ct::u32_select(c, a, b) = a {
  match c {
    Mk(v) => ⊢ Ct::u32_select(Secret::Mk(v), a, b) = a from match v {
      true => ⊢ Ct::u32_select(Secret::Mk(true), a, b) = a from Refl
      false => ⊢ Ct::u32_select(
        Secret::Mk(false),
        a,
        b
      ) = a from ⊢ Ct::u32_select(Secret::Mk(false), a, b) = a from match false_ne_true(h) {}
    }
  }
}

pub theorem Ct::u32_select_false(
  c: Secret(Bool),
  a: Secret(UInt(32)),
  b: Secret(UInt(32)),
  h: expose(c) = false
): Ct::u32_select(c, a, b) = b {
  match c {
    Mk(v) => ⊢ Ct::u32_select(Secret::Mk(v), a, b) = b from match v {
      true => ⊢ Ct::u32_select(
        Secret::Mk(true),
        a,
        b
      ) = b from ⊢ Ct::u32_select(Secret::Mk(true), a, b) = b from match true_ne_false(h) {}
      false => ⊢ Ct::u32_select(Secret::Mk(false), a, b) = b from Refl
    }
  }
}

