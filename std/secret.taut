import "uint.taut" { Nat, UInt }
import "bytes.taut" { Bytes }
import "data.taut" { Option }
import "base.taut" { Nat }
import "nat.taut" { Nat }
import std::prelude::std { Option }

// Secret values as the proofs see them: a box around the value. Extraction
// maps `Secret` onto Nib's `Secret`, whose content a program reads only
// through the functions here, each run in constant time, and through
// `expose`. A `match` on a `Secret` and the constructor `secret` are
// for proofs: in code that runs, a match on a secret is an error of
// extraction, and `secret` is the function that hides a public value. The
// definitions here say what the functions compute, so a proof about them
// holds of the program that runs (`docs/design/secret.md`).

pub(open) inductive Secret(A: Type): Type {
  Mk(v: A): Secret(A)
}

// Mapped: the content, made public. In code that runs, every call is listed
// by the trust report.
pub fn expose<A: Shared>(s: Secret(A)): A {
  match s {
    Mk(v) => v
  }
}

pub theorem expose_secret<A: Shared>(v: A): expose(Secret::Mk(v)) = v {
  Refl
}


pub fn UInt::wrap8(n: Nat): UInt(8) {
  UInt::mk8(Nat::rem_nz(n, 256, Nat::ne_zero(256, Refl)), Nat::mod_lt(n, 256, Refl))
}

// Mapped: `a + b` modulo `2^8`.
pub fn Ct::u8_add(a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrapping_add8(expose(a), expose(b)))
}

// Mapped: `a - b` modulo `2^8`.
pub fn Ct::u8_sub(a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrapping_sub8(expose(a), expose(b)))
}

// Mapped: `a * b` modulo `2^8`.
pub fn Ct::u8_mul(a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrapping_mul8(expose(a), expose(b)))
}

// Mapped: the bits set in both.
pub fn Ct::u8_and(a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrap8(Nat::bits_and(8, UInt::val8(expose(a)), UInt::val8(expose(b)))))
}

// Mapped: the bits set in either.
pub fn Ct::u8_or(a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrap8(Nat::bits_or(8, UInt::val8(expose(a)), UInt::val8(expose(b)))))
}

// Mapped: the bits set in one of the two.
pub fn Ct::u8_xor(a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrap8(Nat::bits_xor(8, UInt::val8(expose(a)), UInt::val8(expose(b)))))
}

// Mapped: every bit flipped.
pub fn Ct::u8_not(a: Secret(UInt(8))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrap8(Nat::bits_xor(8, UInt::val8(expose(a)), 255)))
}

// Mapped: `a` shifted left by `s` modulo 8, the bits past the top dropped. The amount is public.
pub fn Ct::u8_shl(a: Secret(UInt(8)), s: Nat): Secret(UInt(8)) {
  Secret::Mk(
    UInt::wrap8(Nat::mul(UInt::val8(expose(a)), Nat::pow2(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))))
  )
}

// Mapped: `a` shifted right by `s` modulo 8. The amount is public.
pub fn Ct::u8_shr(a: Secret(UInt(8)), s: Nat): Secret(UInt(8)) {
  Secret::Mk(
    UInt::wrap8(
      Nat::div_nz(
        UInt::val8(expose(a)),
        Nat::pow2(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl))),
        Nat::pow2_ne_zero(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))
      )
    )
  )
}

// Mapped: `a` rotated left by `s` modulo 8. The amount is public.
pub fn Ct::u8_rotl(a: Secret(UInt(8)), s: Nat): Secret(UInt(8)) {
  Secret::Mk(
    UInt::wrap8(
      Nat::add(
        Nat::rem_nz(
          Nat::mul(UInt::val8(expose(a)), Nat::pow2(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))),
          256,
          Nat::ne_zero(256, Refl)
        ),
        Nat::div_nz(
          UInt::val8(expose(a)),
          Nat::pow2(8 - Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl))),
          Nat::pow2_ne_zero(8 - Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))
        )
      )
    )
  )
}

// Mapped: `a` rotated right by `s` modulo 8. The amount is public.
pub fn Ct::u8_rotr(a: Secret(UInt(8)), s: Nat): Secret(UInt(8)) {
  Secret::Mk(
    UInt::wrap8(
      Nat::add(
        Nat::div_nz(
          UInt::val8(expose(a)),
          Nat::pow2(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl))),
          Nat::pow2_ne_zero(Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))
        ),
        Nat::rem_nz(
          Nat::mul(UInt::val8(expose(a)), Nat::pow2(8 - Nat::rem_nz(s, 8, Nat::ne_zero(8, Refl)))),
          256,
          Nat::ne_zero(256, Refl)
        )
      )
    )
  )
}

// Mapped: whether `a = b`, kept secret.
pub fn Ct::u8_eq(a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(Bool) {
  Secret::Mk(UInt::eq8(expose(a), expose(b)))
}

// Mapped: whether `a < b`, kept secret.
pub fn Ct::u8_lt(a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(Bool) {
  Secret::Mk(UInt::lt8(expose(a), expose(b)))
}

// Mapped: `a` when `c`, `b` otherwise, without reading `c`.
pub fn Ct::u8_select(c: Secret(Bool), a: Secret(UInt(8)), b: Secret(UInt(8))): Secret(UInt(8)) {
  match expose(c) { true => a, false => b }
}


