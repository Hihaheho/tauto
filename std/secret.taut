}

// Mapped: the high 64 bits of the 128-bit product.
pub fn Ct::u64_mul_hi(a: Secret(UInt(64)), b: Secret(UInt(64))): Secret(UInt(64)) {
  Secret::Mk(
    UInt::wrap64(
      Nat::div_nz(
        Nat::mul(UInt::val64(expose(a)), UInt::val64(expose(b))),
        18446744073709551616,
        Nat::ne_zero(18446744073709551616, Refl)
      )
    )
  )
}

// Mapped: the same number in a wider word.
pub fn Ct::u64_of_u8(a: Secret(UInt(8))): Secret(UInt(64)) {
  Secret::Mk(UInt::wrap64(UInt::val8(expose(a))))
}

// Mapped: the same number in a wider word.
pub fn Ct::u64_of_u32(a: Secret(UInt(32))): Secret(UInt(64)) {
  Secret::Mk(UInt::wrap64(UInt::val32(expose(a))))
}

// Mapped: the same number in a wider word.
pub fn Ct::u32_of_u8(a: Secret(UInt(8))): Secret(UInt(32)) {
  Secret::Mk(UInt::wrap32(UInt::val8(expose(a))))
}

// Mapped: the low bits.
pub fn Ct::u8_of_u32(a: Secret(UInt(32))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrap8(UInt::val32(expose(a))))
}

// Mapped: the low bits.
pub fn Ct::u8_of_u64(a: Secret(UInt(64))): Secret(UInt(8)) {
  Secret::Mk(UInt::wrap8(UInt::val64(expose(a))))
}

// Mapped: the low bits.
pub fn Ct::u32_of_u64(a: Secret(UInt(64))): Secret(UInt(32)) {
  Secret::Mk(UInt::wrap32(UInt::val64(expose(a))))
}

// Mapped: the secret yes or no of both, either, and the other one.
pub fn Ct::bool_and(a: Secret(Bool), b: Secret(Bool)): Secret(Bool) {
  Secret::Mk(expose(a) && expose(b))
}

pub fn Ct::bool_or(a: Secret(Bool), b: Secret(Bool)): Secret(Bool) {
  Secret::Mk(expose(a) || expose(b))
}

pub fn Ct::bool_not(a: Secret(Bool)): Secret(Bool) {
  Secret::Mk(not(expose(a)))
}

// Mapped: `a` when `c`, `b` otherwise, without reading `c`.
pub fn Ct::bool_select(c: Secret(Bool), a: Secret(Bool), b: Secret(Bool)): Secret(Bool) {
  match expose(c) { true => a, false => b }
}

// The length of a secret byte string is public, as the length of every
// secret list is: a key's bytes are reached one by one by a public index.

// Mapped: the number of bytes, made public.
pub fn Ct::bytes_len(s: Secret(Bytes)): Nat {
  Bytes::len(expose(s))
}

// Mapped: the byte at the public index `i`, still secret; `None` past the end.
pub fn Ct::bytes_get(s: Secret(Bytes), i: Nat): Option(Secret(UInt(8))) {
  Option::map((x: UInt(8)) => Secret::Mk(x), Bytes::get(expose(s), i))
}

pub theorem Ct::u8_add_val(
  a: Secret(UInt(8)),
  b: Secret(UInt(8))
): expose(Ct::u8_add(a, b)) = UInt::wrapping_add8(expose(a), expose(b)) {
  Refl
}

pub theorem Ct::u8_sub_val(
  a: Secret(UInt(8)),
  b: Secret(UInt(8))
): expose(Ct::u8_sub(a, b)) = UInt::wrapping_sub8(expose(a), expose(b)) {
  Refl
}

pub theorem Ct::u8_mul_val(
  a: Secret(UInt(8)),
  b: Secret(UInt(8))
): expose(Ct::u8_mul(a, b)) = UInt::wrapping_mul8(expose(a), expose(b)) {
  Refl
}

pub theorem Ct::u8_eq_val(
  a: Secret(UInt(8)),
  b: Secret(UInt(8))
): expose(Ct::u8_eq(a, b)) = UInt::eq8(expose(a), expose(b)) {
  Refl
}

pub theorem Ct::u8_lt_val(
  a: Secret(UInt(8)),
  b: Secret(UInt(8))
): expose(Ct::u8_lt(a, b)) = UInt::lt8(expose(a), expose(b)) {
  Refl
}

pub theorem Ct::u8_select_true(
  c: Secret(Bool),
  a: Secret(UInt(8)),
  b: Secret(UInt(8)),
  h: expose(c) = true
): Ct::u8_select(c, a, b) = a {
  match c {
    Mk(v) => ⊢ Ct::u8_select(Secret::Mk(v), a, b) = a from match v {
      true => ⊢ Ct::u8_select(Secret::Mk(true), a, b) = a from Refl
      false => ⊢ Ct::u8_select(
        Secret::Mk(false),
        a,
        b
      ) = a from ⊢ Ct::u8_select(Secret::Mk(false), a, b) = a from match false_ne_true(h) {}
    }
  }
}

pub theorem Ct::u8_select_false(
  c: Secret(Bool),
  a: Secret(UInt(8)),
  b: Secret(UInt(8)),
  h: expose(c) = false
): Ct::u8_select(c, a, b) = b {
  match c {
    Mk(v) => ⊢ Ct::u8_select(Secret::Mk(v), a, b) = b from match v {
      true => ⊢ Ct::u8_select(
        Secret::Mk(true),
        a,
        b
      ) = b from ⊢ Ct::u8_select(Secret::Mk(true), a, b) = b from match true_ne_false(h) {}
      false => ⊢ Ct::u8_select(Secret::Mk(false), a, b) = b from Refl
    }
  }
}

