}

pub theorem Ct::u64_shr_val(
  a: Secret(UInt(64)),
  s: Nat
): expose(Ct::u64_shr(a, s)) = UInt::shr64(expose(a), s) {
  Refl
}

pub theorem Ct::u64_rotl_val(
  a: Secret(UInt(64)),
  s: Nat
): expose(Ct::u64_rotl(a, s)) = UInt::rotl64(expose(a), s) {
  Refl
}

pub theorem Ct::u64_rotr_val(
  a: Secret(UInt(64)),
  s: Nat
): expose(Ct::u64_rotr(a, s)) = UInt::rotr64(expose(a), s) {
  Refl
}

pub theorem Ct::u64_eq_val(
  a: Secret(UInt(64)),
  b: Secret(UInt(64))
): expose(Ct::u64_eq(a, b)) = UInt::eq64(expose(a), expose(b)) {
  Refl
}

pub theorem Ct::u64_lt_val(
  a: Secret(UInt(64)),
  b: Secret(UInt(64))
): expose(Ct::u64_lt(a, b)) = UInt::lt64(expose(a), expose(b)) {
  Refl
}

pub theorem Ct::u64_select_true(
  c: Secret(Bool),
  a: Secret(UInt(64)),
  b: Secret(UInt(64)),
  h: expose(c) = true
): Ct::u64_select(c, a, b) = a {
  match c {
    Mk(v) => ⊢ Ct::u64_select(Secret::Mk(v), a, b) = a from match v {
      true => ⊢ Ct::u64_select(Secret::Mk(true), a, b) = a from Refl
      false => ⊢ Ct::u64_select(
        Secret::Mk(false),
        a,
        b
      ) = a from ⊢ Ct::u64_select(Secret::Mk(false), a, b) = a from match false_ne_true(h) {}
    }
  }
}

pub theorem Ct::u64_select_false(
  c: Secret(Bool),
  a: Secret(UInt(64)),
  b: Secret(UInt(64)),
  h: expose(c) = false
): Ct::u64_select(c, a, b) = b {
  match c {
    Mk(v) => ⊢ Ct::u64_select(Secret::Mk(v), a, b) = b from match v {
      true => ⊢ Ct::u64_select(
        Secret::Mk(true),
        a,
        b
      ) = b from ⊢ Ct::u64_select(Secret::Mk(true), a, b) = b from match true_ne_false(h) {}
      false => ⊢ Ct::u64_select(Secret::Mk(false), a, b) = b from Refl
    }
  }
}

pub theorem Ct::bytes_len_val(s: Secret(Bytes)): Ct::bytes_len(s) = Bytes::len(expose(s)) {
  Refl
}

pub theorem Ct::bytes_get_val(
  s: Secret(Bytes),
  i: Nat
): Ct::bytes_get(s, i) = Option::map((x: UInt(8)) => Secret::Mk(x), Bytes::get(expose(s), i)) {
  Refl
}
