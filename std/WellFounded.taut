import "Nat.taut"

// Accessibility and well-founded recursion, written out with the eliminator:
// no rule of the kernel is added. `Acc(A, R, x)` says every `R`-predecessor of
// `x` is accessible; a relation is well-founded when every element is.

pub(open) inductive Acc(A: Type, R: (A, A) -> Prop): (A) -> Prop {
  AccIntro(x: A, h: ∀ y: A. (R(y, x)) -> Acc(A, R, y)): Acc(A, R, x)
}

pub def WellFounded(A: Type, R: (A, A) -> Prop): Prop := ∀ x: A. Acc(A, R, x)

module Acc {
  // The recursor on an accessibility proof: `F` computes `B(x)` from the values
  // at the predecessors.
  pub def fix<A: Type>(
    R: (A, A) -> Prop,
    B: (A) -> Type,
    F: ∀ x: A. (∀ y: A. (R(y, x)) -> B(y)) -> B(x),
    x: A,
    a: Acc(A, R, x)
  ): B(x) := Acc::rec(A, R, x2 => a2 => B(x2), x2 => h => ih => F(x2, ih), x, a)

  // Whichever proof of accessibility the recursion is run on, `F` sees the same
  // values at the predecessors: the proofs are not told apart.
  pub theorem fix_eq<A: Type>(
    R: (A, A) -> Prop,
    B: (A) -> Type,
    wf: WellFounded(A, R),
    F: ∀ x: A. (∀ y: A. (R(y, x)) -> B(y)) -> B(x),
    x: A,
    a: Acc(A, R, x)
  ): fix(R, B, F, x, a) = F(x, y => r => fix(R, B, F, y, wf(y))) {
    Acc::ind(
      A,
      R,
      x2 => a2 => fix(R, B, F, x2, a2) = F(x2, y => r => fix(R, B, F, y, wf(y))),
      x2 => h => ih => Refl,
      x,
      a
    )
  }
}

// The fixed point of `F` over a well-founded relation.
pub def wf_fix<A: Type>(
  R: (A, A) -> Prop,
  B: (A) -> Type,
  wf: ∀ x: A. Acc(A, R, x),
  F: ∀ x: A. (∀ y: A. (R(y, x)) -> B(y)) -> B(x),
  x: A
): B(x) := Acc::fix(R, B, F, x, wf(x))

// The unfolding equation of `wf_fix`: the value at `x` is `F` applied to the
// values at the predecessors.
pub theorem wf_fix_eq<A: Type>(
  R: (A, A) -> Prop,
  B: (A) -> Type,
  wf: WellFounded(A, R),
  F: ∀ x: A. (∀ y: A. (R(y, x)) -> B(y)) -> B(x),
  x: A
): wf_fix(R, B, wf, F, x) = F(x, y => r => wf_fix(R, B, wf, F, y)) {
  Acc::fix_eq(R, B, wf, F, x, wf(x))
}

// ---- relations that are well-founded ---------------------------------------

// The order of the numbers as a proposition.
pub def NatLt(a: Nat, b: Nat): Prop := a < b = true

module Nat {
  pub fn lt_succ_cases(m: Nat, k: Nat, h: NatLt(m, Succ(k))): NatLt(m, k) ∨ m = k {
    match m: NatLt(m, k) ∨ m = k {
      Zero => match k {
        Zero => OrInr(Refl)
        Succ(k2) => OrInl(Refl)
      }
      Succ(m2) => match k {
        Zero => False::elim(false_ne_true(Eq::trans(Eq::sym(Nat::lt_zero_false(m2)), h)))
        Succ(k2) => Or::elim(
          lt_succ_cases(m2, k2, h),
          a => OrInl(a),
          e => OrInr(Eq::congr(Succ, e))
        )
      }
    }
  }

  // Every number below `n` is accessible.
  pub fn lt_acc(n: Nat, m: Nat, h: NatLt(m, n)): Acc(Nat, NatLt, m) {
    match n: Acc(Nat, NatLt, m) {
      Zero => False::elim(false_ne_true(Eq::trans(Eq::sym(Nat::lt_zero_false(m)), h)))
      Succ(k) => Or::elim(
        lt_succ_cases(m, k, h),
        a => lt_acc(k, m, a),
        e => Eq::subst(
          z => Acc(Nat, NatLt, z),
          Eq::sym(e),
          AccIntro(Nat, NatLt, k, y => r => lt_acc(k, y, r))
        )
      )
    }
  }

  pub fn lt_wf(): WellFounded(Nat, NatLt) {
    n => lt_acc(Succ(n), n, Nat::le_refl(n))
  }
}

// The relation on `A` that compares the images under `f`.
pub def InvImage(
  A: Type,
  B: Type,
  R: (B, B) -> Prop,
  f: (A) -> B,
  a: A,
  b: A
): Prop := R(f(a), f(b))

// Every `x` whose image is `z` is accessible, when `z` is.
pub def InvImageAcc(A: Type, B: Type, R: (B, B) -> Prop, f: (A) -> B, z: B): Prop :=
∀ x: A. (f(x) = z) -> Acc(A, InvImage(A, B, R, f), x)

pub fn inv_image_acc_gen<A: Type>(
  B: Type,
  R: (B, B) -> Prop,
  f: (A) -> B,
  z: B,
  a: Acc(B, R, z)
): InvImageAcc(A, B, R, f, z) {
  Acc::ind(
    B,
    R,
    z2 => a2 => InvImageAcc(A, B, R, f, z2),
    z2 => h => ih => x => e => AccIntro(
      A,
      InvImage(A, B, R, f),
      x,
      y => r => ih(f(y), Eq::subst(w => R(f(y), w), e, r), y, Refl)
    ),
    z,
    a
  )
}

// A measure into the numbers: `y` is below `x` when its measure is.
pub fn measure_wf<A: Type>(f: (A) -> Nat): WellFounded(A, InvImage(A, Nat, NatLt, f)) {
  x => inv_image_acc_gen(Nat, NatLt, f, f(x), Nat::lt_wf()(f(x)))(x, Refl)
}

// ---- a relation with its proof ----------------------------------------------

// A binary relation on `A`.
pub def Relation(A: Type): Type := (A, A) -> Prop

// What `decreasing_by` takes: a relation on `A` together with the proof that it
// is well-founded.
pub(open) inductive WfRel(A: Type): Type {
  Mk(R: (A, A) -> Prop, wf: WellFounded(A, R)): WfRel(A)
}

pub def wf_rel_lt<A: Type>(w: WfRel(A)): Relation(A) :=
WfRel::rec(A, w2 => Relation(A), R => wf => R, w)

pub fn wf_rel_wf<A: Type>(w: WfRel(A)): WellFounded(A, wf_rel_lt(w)) {
  match w: WellFounded(A, wf_rel_lt(w)) {
    Mk(R, wf) => wf
  }
}

// `y` is below `x` when `f(y)` is below `f(x)` as numbers.
pub def measure<A: Type>(
  f: (A) -> Nat
): WfRel(A) := WfRel::Mk(InvImage(A, Nat, NatLt, f), measure_wf(f))
