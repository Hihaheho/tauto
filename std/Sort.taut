import "Row.taut"
import "List.taut"
import "MapLaws.taut"

// Insertion sort by a comparator `cmp`, and its proofs. The comparator is an
// argument, as in `Map::taut`; the theorems about the order assume
// `OrdmapLaw(A, cmp)` (`cmp` is a total order, `MapLaws.taut`), the ones about
// the elements and the length assume nothing. The sort is stable: an element goes
// after the equal ones already placed.

// `a` is not after `b`.
pub def SortLe(A: Type, cmp: (A, A) -> Ordering, a: A, b: A): Prop := (cmp(a, b) = Greater) -> False

// `a` is not after any element of `l`.
pub fn sort_all_le<A>(cmp: (A, A) -> Ordering, a: A, l: List(A)): Prop {
  match l: Prop {
    Nil => True
    Cons(h, t) => SortLe(A, cmp, a, h) ∧ sort_all_le(cmp, a, t)
  }
}

// Each element is not after those that follow it.
pub fn sort_sorted<A>(cmp: (A, A) -> Ordering, l: List(A)): Prop {
  match l: Prop {
    Nil => True
    Cons(h, t) => sort_all_le(cmp, h, t) ∧ sort_sorted(cmp, t)
  }
}

module List {
  // `x` before the first element that is after it.
  pub fn insert_sorted<A>(cmp: (A, A) -> Ordering, x: A, l: List(A)): List(A) {
    match l: List(A) {
      Nil => [x]
      Cons(h, t) => match cmp(x, h): List(A) {
        Less => Cons(x, Cons(h, t))
        Equal => Cons(h, List::insert_sorted(cmp, x, t))
        Greater => Cons(h, List::insert_sorted(cmp, x, t))
      }
    }
  }

  pub fn sort<A>(cmp: (A, A) -> Ordering, l: List(A)): List(A) {
    match l: List(A) {
      Nil => Nil
      Cons(h, t) => List::insert_sorted(cmp, h, sort(cmp, t))
    }
  }
}

// ---- the order ----------------------------------------------------------------

pub theorem sort_le_trans<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  a: A,
  b: A,
  c: A,
  h1: SortLe(A, cmp, a, b),
  h2: SortLe(A, cmp, b, c)
): SortLe(A, cmp, a, c) {
  (e: cmp(a, c) = Greater) => Ordering::cases(
    (o: Ordering) => False,
    cmp(a, b),
    (e1: cmp(a, b) = Less) => Ordering::cases(
      (o: Ordering) => False,
      cmp(b, c),
      (e2: cmp(b, c) = Less) => less_ne_greater(
        Eq::trans(Eq::sym(Ordmap::law_less_trans(cmp, w, a, b, c, e1, e2)), e)
      ),
      (e2: cmp(b, c) = Equal) => h1(
        Eq::subst((z: A) => cmp(a, z) = Greater, Eq::sym(Ordmap::law_eq(cmp, w, b, c, e2)), e)
      ),
      (e2: cmp(b, c) = Greater) => h2(e2)
    ),
    (e1: cmp(a, b) = Equal) => h2(
      Eq::subst((z: A) => cmp(z, c) = Greater, Ordmap::law_eq(cmp, w, a, b, e1), e)
    ),
    (e1: cmp(a, b) = Greater) => h1(e1)
  )
}

// Of two elements one is not after the other.
pub theorem sort_le_total<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  a: A,
  b: A,
  e: cmp(a, b) = Greater
): SortLe(A, cmp, b, a) {
  (f: cmp(b, a) = Greater) => greater_ne_less(
    Eq::trans(Eq::sym(f), Ordmap::law_flip_greater(cmp, w, a, b, e))
  )
}

pub theorem sort_all_le_trans<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  a: A,
  b: A,
  l: List(A),
  h: SortLe(A, cmp, a, b),
  all: sort_all_le(cmp, b, l)
): sort_all_le(cmp, a, l) {
  match l: sort_all_le(cmp, a, l) {
    Nil => Trivial
    Cons(x, t) => match all: sort_all_le(cmp, a, Cons(x, t)) {
      AndIntro(hx, ht) => AndIntro(
        sort_le_trans(cmp, w, a, b, x, h, hx),
        sort_all_le_trans(cmp, w, a, b, t, h, ht)
      )
    }
  }
}

pub theorem sort_le_of_equal<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  a: A,
  b: A,
  e: cmp(a, b) = Equal
): SortLe(A, cmp, b, a) {
  (f: cmp(b, a) = Greater) => equal_ne_greater(
    Eq::trans(
      Eq::sym(Ordmap::law_same(cmp, w, a)),
      Eq::subst((z: A) => cmp(z, a) = Greater, Eq::sym(Ordmap::law_eq(cmp, w, a, b, e)), f)
    )
  )
}

pub theorem sort_le_of_less<A: Type>(
  cmp: (A, A) -> Ordering,
  a: A,
  b: A,
  e: cmp(a, b) = Less
): SortLe(A, cmp, a, b) {
  (f: cmp(a, b) = Greater) => less_ne_greater(Eq::trans(Eq::sym(e), f))
}

// ---- insertion ----------------------------------------------------------------

pub theorem sort_insert_all_le<A: Type>(
  cmp: (A, A) -> Ordering,
  y: A,
  x: A,
  l: List(A),
  all: sort_all_le(cmp, y, l),
  hx: SortLe(A, cmp, y, x)
): sort_all_le(cmp, y, List::insert_sorted(cmp, x, l)) {
  match l: sort_all_le(cmp, y, List::insert_sorted(cmp, x, l)) {
    Nil => AndIntro(hx, Trivial)
    Cons(h, t) => Ordering::cases(
      (o: Ordering) => sort_all_le(
        cmp,
        y,
        match o: List(A) {
          Less => Cons(x, Cons(h, t))
          Equal => Cons(h, List::insert_sorted(cmp, x, t))
          Greater => Cons(h, List::insert_sorted(cmp, x, t))
        }
      ),
      cmp(x, h),
      (e: cmp(x, h) = Less) => AndIntro(hx, all),
      (e: cmp(x, h) = Equal) => AndIntro(
        And::left(all),
        sort_insert_all_le(cmp, y, x, t, And::right(all), hx)
      ),
      (e: cmp(x, h) = Greater) => AndIntro(
        And::left(all),
        sort_insert_all_le(cmp, y, x, t, And::right(all), hx)
      )
    )
  }
}

pub theorem sort_insert_sorted<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  x: A,
  l: List(A),
  s: sort_sorted(cmp, l)
): sort_sorted(cmp, List::insert_sorted(cmp, x, l)) {
  match l: sort_sorted(cmp, List::insert_sorted(cmp, x, l)) {
    Nil => AndIntro(Trivial, Trivial)
    Cons(h, t) => Ordering::cases(
      (o: Ordering) => sort_sorted(
        cmp,
        match o: List(A) {
          Less => Cons(x, Cons(h, t))
          Equal => Cons(h, List::insert_sorted(cmp, x, t))
          Greater => Cons(h, List::insert_sorted(cmp, x, t))
        }
      ),
      cmp(x, h),
      (e: cmp(x, h) = Less) => AndIntro(
        AndIntro(
          sort_le_of_less(cmp, x, h, e),
          sort_all_le_trans(cmp, w, x, h, t, sort_le_of_less(cmp, x, h, e), And::left(s))
        ),
        s
      ),
      (e: cmp(x, h) = Equal) => AndIntro(
        sort_insert_all_le(cmp, h, x, t, And::left(s), sort_le_of_equal(cmp, w, x, h, e)),
        sort_insert_sorted(cmp, w, x, t, And::right(s))
      ),
      (e: cmp(x, h) = Greater) => AndIntro(
        sort_insert_all_le(cmp, h, x, t, And::left(s), sort_le_total(cmp, w, x, h, e)),
        sort_insert_sorted(cmp, w, x, t, And::right(s))
      )
    )
  }
}

pub theorem sort_sorts<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  l: List(A)
): sort_sorted(cmp, List::sort(cmp, l)) {
  match l: sort_sorted(cmp, List::sort(cmp, l)) {
    Nil => Trivial
    Cons(h, t) => sort_insert_sorted(cmp, w, h, List::sort(cmp, t), sort_sorts(cmp, w, t))
  }
}

// ---- what the sort keeps ------------------------------------------------------

pub theorem sort_mem_cons<A: Type>(
  x: A,
  a: List(A),
  b: List(A),
  h: Sub(A, a, b),
  e: A,
  m: Mem(A, e, Cons(x, a))
): Mem(A, e, Cons(x, b)) {
  match m: Mem(A, e, Cons(x, b)) {
    MemHere(t) => MemHere(A, e, b)
    MemThere(c, t, m2) => MemThere(A, e, x, b, h(e, m2))
  }
}

pub theorem sort_equiv_cons<A: Type>(
  x: A,
  a: List(A),
  b: List(A),
  h: Equiv(A, a, b)
): Equiv(A, Cons(x, a), Cons(x, b)) {
  AndIntro(
    (e: A) => (m: Mem(A, e, Cons(x, a))) => sort_mem_cons(x, a, b, And::left(h), e, m),
    (e: A) => (m: Mem(A, e, Cons(x, b))) => sort_mem_cons(x, b, a, And::right(h), e, m)
  )
}

pub theorem sort_mem_insert_self<A: Type>(
  cmp: (A, A) -> Ordering,
  x: A,
  l: List(A)
): Mem(A, x, List::insert_sorted(cmp, x, l)) {
  match l: Mem(A, x, List::insert_sorted(cmp, x, l)) {
    Nil => MemHere(A, x, Nil)
    Cons(h, t) => Ordering::cases(
      (o: Ordering) => Mem(
        A,
        x,
        match o: List(A) {
          Less => Cons(x, Cons(h, t))
          Equal => Cons(h, List::insert_sorted(cmp, x, t))
          Greater => Cons(h, List::insert_sorted(cmp, x, t))
        }
      ),
      cmp(x, h),
      (e: cmp(x, h) = Less) => MemHere(A, x, Cons(h, t)),
      (e: cmp(x, h) = Equal) => MemThere(A, x, h, List::insert_sorted(cmp, x, t), sort_mem_insert_self(cmp, x, t)),
      (e: cmp(x, h) = Greater) => MemThere(A, x, h, List::insert_sorted(cmp, x, t), sort_mem_insert_self(cmp, x, t))
    )
  }
}

pub theorem sort_mem_insert<A: Type>(
  cmp: (A, A) -> Ordering,
  x: A,
  e: A,
  l: List(A),
  m: Mem(A, e, l)
): Mem(A, e, List::insert_sorted(cmp, x, l)) {
  match l: Mem(A, e, List::insert_sorted(cmp, x, l)) {
    Nil => Mem::nil(Mem(A, e, List::insert_sorted(cmp, x, Nil)), m)
    Cons(h, t) => Ordering::cases(
      (o: Ordering) => Mem(
        A,
        e,
        match o: List(A) {
          Less => Cons(x, Cons(h, t))
          Equal => Cons(h, List::insert_sorted(cmp, x, t))
          Greater => Cons(h, List::insert_sorted(cmp, x, t))
        }
      ),
      cmp(x, h),
      (c: cmp(x, h) = Less) => MemThere(A, e, x, Cons(h, t), m),
      (c: cmp(x, h) = Equal) => match m: Mem(A, e, Cons(A, h, List::insert_sorted(cmp, x, t))) {
        MemHere(t2) => MemHere(A, e, List::insert_sorted(cmp, x, t))
        MemThere(b, t2, m2) => MemThere(A, e, h, List::insert_sorted(cmp, x, t), sort_mem_insert(cmp, x, e, t, m2))
      },
      (c: cmp(x, h) = Greater) => match m: Mem(A, e, Cons(A, h, List::insert_sorted(cmp, x, t))) {
        MemHere(t2) => MemHere(A, e, List::insert_sorted(cmp, x, t))
        MemThere(b, t2, m2) => MemThere(A, e, h, List::insert_sorted(cmp, x, t), sort_mem_insert(cmp, x, e, t, m2))
      }
    )
  }
}

pub theorem sort_mem_skip<A: Type>(
  x: A,
  h: A,
  t: List(A),
  e: A,
  m: Mem(A, e, Cons(x, t))
): Mem(A, e, Cons(x, Cons(h, t))) {
  match m: Mem(A, e, Cons(x, Cons(h, t))) {
    MemHere(t2) => MemHere(A, e, Cons(h, t))
    MemThere(b, t2, m2) => MemThere(A, e, x, Cons(h, t), MemThere(A, e, h, t, m2))
  }
}

pub theorem sort_mem_step<A: Type>(
  x: A,
  h: A,
  t: List(A),
  i: List(A),
  ih: Sub(A, i, Cons(x, t)),
  e: A,
  m: Mem(A, e, Cons(h, i))
): Mem(A, e, Cons(x, Cons(h, t))) {
  match m: Mem(A, e, Cons(x, Cons(h, t))) {
    MemHere(t2) => MemThere(A, e, x, Cons(e, t), MemHere(A, e, t))
    MemThere(b, t2, m2) => sort_mem_skip(x, h, t, e, ih(e, m2))
  }
}

// What `List::insert_sorted` does with `Cons(h, t)` once `cmp(x, h)` is `o`.
pub fn sort_insert_case<A>(cmp: (A, A) -> Ordering, x: A, h: A, t: List(A), o: Ordering): List(A) {
  match o: List(A) {
    Less => Cons(x, Cons(h, t))
    Equal => Cons(h, List::insert_sorted(cmp, x, t))
    Greater => Cons(h, List::insert_sorted(cmp, x, t))
  }
}

pub theorem sort_mem_case_inv<A: Type>(
  cmp: (A, A) -> Ordering,
  x: A,
  h: A,
  t: List(A),
  o: Ordering,
  e: A,
  ih: Sub(A, List::insert_sorted(cmp, x, t), Cons(x, t)),
  m: Mem(A, e, sort_insert_case(cmp, x, h, t, o))
): Mem(A, e, Cons(x, Cons(h, t))) {
  match o: Mem(A, e, Cons(x, Cons(h, t))) {
    Less => m
    Equal => sort_mem_step(x, h, t, List::insert_sorted(cmp, x, t), ih, e, m)
    Greater => sort_mem_step(x, h, t, List::insert_sorted(cmp, x, t), ih, e, m)
  }
}

pub theorem sort_insert_sub<A: Type>(
  cmp: (A, A) -> Ordering,
  x: A,
  l: List(A)
): Sub(A, List::insert_sorted(cmp, x, l), Cons(x, l)) {
  match l: Sub(A, List::insert_sorted(cmp, x, l), Cons(x, l)) {
    Nil => (e: A) => (m: Mem(A, e, List::insert_sorted(cmp, x, Nil))) => m
    Cons(h, t) => (e: A) => (
      m: Mem(A, e, List::insert_sorted(cmp, x, Cons(h, t)))
    ) => sort_mem_case_inv(cmp, x, h, t, cmp(x, h), e, sort_insert_sub(cmp, x, t), m)
  }
}

pub theorem sort_insert_sup<A: Type>(
  cmp: (A, A) -> Ordering,
  x: A,
  l: List(A),
  e: A,
  m: Mem(A, e, Cons(x, l))
): Mem(A, e, List::insert_sorted(cmp, x, l)) {
  match m: Mem(A, e, List::insert_sorted(cmp, x, l)) {
    MemHere(t) => sort_mem_insert_self(cmp, e, t)
    MemThere(b, t, m2) => sort_mem_insert(cmp, x, e, t, m2)
  }
}

// Inserting keeps the elements, and adds `x`.
pub theorem sort_insert_equiv<A: Type>(
  cmp: (A, A) -> Ordering,
  x: A,
  l: List(A)
): Equiv(A, List::insert_sorted(cmp, x, l), Cons(x, l)) {
  AndIntro(
    sort_insert_sub(cmp, x, l),
    (e: A) => (m: Mem(A, e, Cons(x, l))) => sort_insert_sup(cmp, x, l, e, m)
  )
}

// The sort keeps exactly the elements.
pub theorem sort_equiv<A: Type>(
  cmp: (A, A) -> Ordering,
  l: List(A)
): Equiv(A, List::sort(cmp, l), l) {
  match l: Equiv(A, List::sort(cmp, l), l) {
    Nil => Equiv::refl(A, Nil(A))
    Cons(h, t) => Equiv::trans(
      A,
      List::insert_sorted(cmp, h, List::sort(cmp, t)),
      Cons(h, List::sort(cmp, t)),
      Cons(h, t),
      sort_insert_equiv(cmp, h, List::sort(cmp, t)),
      sort_equiv_cons(h, List::sort(cmp, t), t, sort_equiv(cmp, t))
    )
  }
}

pub theorem sort_insert_case_length<A: Type>(
  cmp: (A, A) -> Ordering,
  x: A,
  h: A,
  t: List(A),
  o: Ordering,
  ih: List::length(List::insert_sorted(cmp, x, t)) = Succ(List::length(t))
): List::length(sort_insert_case(cmp, x, h, t, o)) = Succ(Succ(List::length(t))) {
  match o: List::length(sort_insert_case(cmp, x, h, t, o)) = Succ(Succ(List::length(t))) {
    Less => Refl
    Equal => Eq::congr(Succ, ih)
    Greater => Eq::congr(Succ, ih)
  }
}

pub theorem sort_insert_length<A: Type>(
  cmp: (A, A) -> Ordering,
  x: A,
  l: List(A)
): List::length(List::insert_sorted(cmp, x, l)) = Succ(List::length(l)) {
  match l: List::length(List::insert_sorted(cmp, x, l)) = Succ(List::length(l)) {
    Nil => Refl
    Cons(h, t) => sort_insert_case_length(cmp, x, h, t, cmp(x, h), sort_insert_length(cmp, x, t))
  }
}

pub theorem sort_length<A: Type>(
  cmp: (A, A) -> Ordering,
  l: List(A)
): List::length(List::sort(cmp, l)) = List::length(l) {
  match l: List::length(List::sort(cmp, l)) = List::length(l) {
    Nil => Refl
    Cons(h, t) => Eq::trans(
      sort_insert_length(cmp, h, List::sort(cmp, t)),
      Eq::congr(Succ, sort_length(cmp, t))
    )
  }
}

// ---- sorted lists stay as they are --------------------------------------------

pub theorem sort_insert_head_case<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  x: A,
  h: A,
  t: List(A),
  o: Ordering,
  c: cmp(x, h) = o,
  le: SortLe(A, cmp, x, h),
  ih: List::insert_sorted(cmp, x, t) = Cons(x, t)
): sort_insert_case(cmp, x, h, t, o) = Cons(x, Cons(h, t)) {
  match o: sort_insert_case(cmp, x, h, t, o) = Cons(x, Cons(h, t)) {
    Less => Refl
    Equal => Eq::trans(
      Eq::congr(⟦Cons(h, □)⟧, ih),
      Eq::subst(
        (z: A) => Cons(A, h, Cons(A, z, t)) = Cons(A, z, Cons(A, h, t)),
        Eq::sym(Ordmap::law_eq(cmp, w, x, h, c)),
        Refl
      )
    )
    Greater => False::elim(le(c))
  }
}

// Inserting an element that is not after any of them puts it in front.
pub theorem sort_insert_head<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  x: A,
  l: List(A),
  all: sort_all_le(cmp, x, l)
): List::insert_sorted(cmp, x, l) = Cons(x, l) {
  match l: List::insert_sorted(cmp, x, l) = Cons(x, l) {
    Nil => Refl
    Cons(h, t) => sort_insert_head_case(
      cmp,
      w,
      x,
      h,
      t,
      cmp(x, h),
      Refl,
      And::left(all),
      sort_insert_head(cmp, w, x, t, And::right(all))
    )
  }
}

pub theorem sort_of_sorted<A: Type>(
  cmp: (A, A) -> Ordering,
  w: OrdmapLaw(A, cmp),
  l: List(A),
  s: sort_sorted(cmp, l)
): List::sort(cmp, l) = l {
  match l: List::sort(cmp, l) = l {
    Nil => Refl
    Cons(h, t) => Eq::trans(
      Eq::congr(
        ⟦List::insert_sorted(cmp, h, □)⟧,
        sort_of_sorted(cmp, w, t, And::right(s))
      ),
      sort_insert_head(cmp, w, h, t, And::left(s))
    )
  }
}

// ---- an example ---------------------------------------------------------------

pub theorem sort_example(): List::sort(
  Ordmap::compare_nat,
  [3, 1, 2, 1]
) = [1, 1, 2, 3] {
  Refl
}

// Numbers sorted by `Ordmap::compare_nat` come out in order, with nothing assumed.
pub theorem sort_nat_sorts(
  l: List(Nat)
): sort_sorted(Ordmap::compare_nat, List::sort(Ordmap::compare_nat, l)) {
  sort_sorts(Ordmap::compare_nat, Ordmap::compare_nat_law(), l)
}
