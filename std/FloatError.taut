      Int::mul(IntOfNat(16 * w), 281474976710656)
    ),
    1
  ),
  Int::add(
    Int::neg(Int::mul(4503599627370496, IntOfNat(s))),
    Int::neg(Int::mul(4503599627370496, IntOfNat(w)))
  )
) = Int::mul(IntOfNat(4503599627370496 * y), 1) {
  by int_norm!(): Int::add(
    Int::mul(
      Int::add(
        Int::add(
          Int::mul(IntOfNat(y), IntOfNat(4503599627370496)),
          Int::mul(IntOfNat(2 * s), IntOfNat(2251799813685248))
        ),
        Int::mul(IntOfNat(16 * w), IntOfNat(281474976710656))
      ),
      IntOfNat(1)
    ),
    Int::add(
      Int::neg(Int::mul(IntOfNat(4503599627370496), IntOfNat(s))),
      Int::neg(Int::mul(IntOfNat(4503599627370496), IntOfNat(w)))
    )
  ) = Int::mul(IntOfNat(4503599627370496 * y), IntOfNat(1)) {}
}

