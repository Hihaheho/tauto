import "Base.taut"
import "Nat.taut"

// Natural numbers in binary, as inductive types: a number of `n` bits is a term
// of size `n`, where `Nat` takes a term of size of the number itself. The
// arithmetic here is the definitions; the kernel computes nothing of its own on
// these types. `to_nat` and `of_nat` go to and from `Nat`, and the theorems say
// that the operations agree with those of `Nat` through `to_nat`.

// A positive number, read from the least significant bit: `Bit0(p)` is `2p`
// and `Bit1(p)` is `2p + 1`.
pub(open) inductive Pos: Type {
  One: Pos
  Bit0(p: Pos): Pos
  Bit1(p: Pos): Pos
}

pub(open) inductive BinNat: Type {
  BinZero: BinNat
  BinPos(p: Pos): BinNat
}

pub(open) inductive PosDiff: Type {
  DiffNeg(r: Pos): PosDiff
  DiffZero: PosDiff
  DiffPos(r: Pos): PosDiff
}

module Pos {
  pub fn to_nat(p: Pos): Nat {
    match p: Nat {
      One => 1
      Bit0(q) => to_nat(q) + to_nat(q)
      Bit1(q) => Succ(to_nat(q) + to_nat(q))
    }
  }

  pub fn succ(p: Pos): Pos {
    match p: Pos {
      One => Bit0(One)
      Bit0(q) => Bit1(q)
      Bit1(q) => Bit0(succ(q))
    }
  }

  // The carry of `Bit1` and `Bit1` is added by `succ`.
  pub fn add(p: Pos, q: Pos): Pos {
    match p: Pos {
      One => match q: Pos {
        One => Bit0(One)
        Bit0(q2) => Bit1(q2)
        Bit1(q2) => Bit0(succ(q2))
      }
      Bit0(p2) => match q: Pos {
        One => Bit1(p2)
        Bit0(q2) => Bit0(add(p2, q2))
        Bit1(q2) => Bit1(add(p2, q2))
      }
      Bit1(p2) => match q: Pos {
        One => Bit0(succ(p2))
        Bit0(q2) => Bit1(add(p2, q2))
        Bit1(q2) => Bit0(succ(add(p2, q2)))
      }
    }
  }

  pub fn mul(p: Pos, q: Pos): Pos {
    match p: Pos {
      One => q
      Bit0(p2) => Bit0(mul(p2, q))
      Bit1(p2) => add(Bit0(mul(p2, q)), q)
    }
  }

  pub fn pred_double(p: Pos): Pos {
    match p: Pos {
      One => One
      Bit0(q) => Bit1(pred_double(q))
      Bit1(q) => Bit1(Bit0(q))
    }
  }

  pub fn pred(p: Pos): BinNat {
    match p: BinNat {
      One => BinZero
      Bit0(q) => BinPos(pred_double(q))
      Bit1(q) => BinPos(Bit0(q))
    }
  }

  pub fn diff_double(d: PosDiff): PosDiff {
    match d: PosDiff {
      DiffNeg(r) => DiffNeg(Bit0(r))
      DiffZero => DiffZero
      DiffPos(r) => DiffPos(Bit0(r))
    }
  }

  pub fn diff_succ_double(d: PosDiff): PosDiff {
    match d: PosDiff {
      DiffNeg(r) => DiffNeg(pred_double(r))
      DiffZero => DiffPos(One)
      DiffPos(r) => DiffPos(Bit1(r))
    }
  }

  pub fn diff_pred_double(d: PosDiff): PosDiff {
    match d: PosDiff {
      DiffNeg(r) => DiffNeg(Bit1(r))
      DiffZero => DiffNeg(One)
      DiffPos(r) => DiffPos(pred_double(r))
    }
  }

  // `1 - q`, for `q` other than `One`, is `-(q - 1)`.
  pub fn one_minus(q: Pos): PosDiff {
    match q: PosDiff {
      One => DiffZero
      Bit0(q2) => DiffNeg(pred_double(q2))
      Bit1(q2) => DiffNeg(Bit0(q2))
    }
  }

  // `p - 1`, for `p` other than `One`.
  pub fn minus_one(p: Pos): PosDiff {
    match p: PosDiff {
      One => DiffZero
      Bit0(p2) => DiffPos(pred_double(p2))
      Bit1(p2) => DiffPos(Bit0(p2))
    }
  }

  pub fn diff(p: Pos, q: Pos): PosDiff {
    match p: PosDiff {
      One => one_minus(q)
      Bit0(p2) => match q: PosDiff {
        One => minus_one(Bit0(p2))
        Bit0(q2) => diff_double(diff(p2, q2))
        Bit1(q2) => diff_pred_double(diff(p2, q2))
      }
      Bit1(p2) => match q: PosDiff {
        One => minus_one(Bit1(p2))
        Bit0(q2) => diff_succ_double(diff(p2, q2))
        Bit1(q2) => diff_double(diff(p2, q2))
      }
    }
  }

  pub fn diff_sign(d: PosDiff): Ordering {
    match d: Ordering {
      DiffNeg(_) => Less
      DiffZero => Equal
      DiffPos(_) => Greater
    }
  }

  // A difference, or zero when it is negative.
  pub fn diff_trunc(d: PosDiff): BinNat {
    match d: BinNat {
      DiffNeg(r) => BinZero
      DiffZero => BinZero
      DiffPos(r) => BinPos(r)
    }
  }

  pub fn compare(p: Pos, q: Pos): Ordering {
    diff_sign(diff(p, q))
  }

  pub fn eq(p: Pos, q: Pos): Bool {
    match p: Bool {
      One => match q: Bool {
        One => true
        Bit0(_) => false
        Bit1(_) => false
      }
      Bit0(p2) => match q: Bool {
        One => false
        Bit0(q2) => eq(p2, q2)
        Bit1(_) => false
      }
      Bit1(p2) => match q: Bool {
        One => false
        Bit0(_) => false
        Bit1(q2) => eq(p2, q2)
      }
    }
  }

  pub theorem double_congr<a: Nat, b: Nat>(h: a = b): a + a = b + b {
    calc a + a {
      = b + a from Eq::congr(⟦Nat::add(□, a)⟧, h)
      = b + b from Eq::congr(⟦Nat::add(b, □)⟧, h)
    }
  }

  pub theorem double_succ(n: Nat): Succ(n) + Succ(n) = Succ(Succ(n + n)) {
    Eq::congr(Succ, Nat::add_succ_left(n, n))
  }

  pub theorem one_add(n: Nat): 1 + n = Succ(n) {
    calc 1 + n {
      = Succ(Zero + n) from Nat::add_succ_left(Zero, n)
      = Succ(n) from Eq::congr(Succ, Nat::add_zero_left(n))
    }
  }

  pub theorem double_add(a: Nat, b: Nat): a + b + (a + b) = a + a + (b + b) {
    Nat::add_shuffle(a, b, a, b)
  }

  // ---- agreement with `Nat` -----------------------------------------------------

  pub theorem succ_to_nat(p: Pos): to_nat(succ(p)) = Succ(to_nat(p)) {
    match p: to_nat(succ(p)) = Succ(to_nat(p)) {
      One => Refl
      Bit0(_) => Refl
      Bit1(q) => calc to_nat(succ(q)) + to_nat(succ(q)) {
        = Succ(to_nat(q)) + Succ(to_nat(q)) from double_congr(succ_to_nat(q))
        = Succ(Succ(to_nat(q) + to_nat(q))) from double_succ(to_nat(q))
      }
    }
  }

  pub theorem add_to_nat(p: Pos, q: Pos): to_nat(add(p, q)) = to_nat(p) + to_nat(q) {
    match p: to_nat(add(p, q)) = to_nat(p) + to_nat(q) {
      One => match q: to_nat(add(One, q)) = 1 + to_nat(q) {
        One => Refl
        Bit0(q2) => Eq::sym(one_add(to_nat(Bit0(q2))))
        Bit1(q2) => calc to_nat(succ(q2)) + to_nat(succ(q2)) {
          = Succ(to_nat(q2)) + Succ(to_nat(q2)) from double_congr(succ_to_nat(q2))
          = Succ(Succ(to_nat(q2) + to_nat(q2))) from double_succ(to_nat(q2))
          = 1 + to_nat(Bit1(q2)) from Eq::sym(one_add(to_nat(Bit1(q2))))
        }
      }
      Bit0(p2) => match q: to_nat(add(Bit0(p2), q)) = to_nat(Bit0(p2)) + to_nat(q) {
        One => Refl
        Bit0(q2) => calc to_nat(add(p2, q2)) + to_nat(add(p2, q2)) {
          = to_nat(p2) + to_nat(q2) + (to_nat(p2) + to_nat(q2)) from double_congr(
            add_to_nat(p2, q2)
          )
          = to_nat(
            p2
          ) + to_nat(p2) + (to_nat(q2) + to_nat(q2)) from double_add(to_nat(p2), to_nat(q2))
        }
        Bit1(q2) => Eq::congr(
          Succ,
          Eq::trans(double_congr(add_to_nat(p2, q2)), double_add(to_nat(p2), to_nat(q2)))
        )
      }
      Bit1(p2) => match q: to_nat(add(Bit1(p2), q)) = to_nat(Bit1(p2)) + to_nat(q) {
        One => calc to_nat(succ(p2)) + to_nat(succ(p2)) {
          = Succ(to_nat(p2)) + Succ(to_nat(p2)) from double_congr(succ_to_nat(p2))
          = Succ(Succ(to_nat(p2) + to_nat(p2))) from double_succ(to_nat(p2))
        }
        Bit0(q2) => calc Succ(to_nat(add(p2, q2)) + to_nat(add(p2, q2))) {
          = Succ(
            to_nat(p2) + to_nat(q2) + (to_nat(p2) + to_nat(q2))
          ) from Eq::congr(Succ, double_congr(add_to_nat(p2, q2)))
          = Succ(
            to_nat(p2) + to_nat(p2) + (to_nat(q2) + to_nat(q2))
          ) from Eq::congr(Succ, double_add(to_nat(p2), to_nat(q2)))
          = Succ(
            to_nat(Bit0(p2))
          ) + to_nat(Bit0(q2)) from Eq::sym(Nat::add_succ_left(to_nat(Bit0(p2)), to_nat(Bit0(q2))))
        }
        Bit1(q2) => calc to_nat(succ(add(p2, q2))) + to_nat(succ(add(p2, q2))) {
          = Succ(
            to_nat(add(p2, q2))
          ) + Succ(to_nat(add(p2, q2))) from double_congr(succ_to_nat(add(p2, q2)))
          = Succ(
            Succ(to_nat(add(p2, q2)) + to_nat(add(p2, q2)))
          ) from double_succ(to_nat(add(p2, q2)))
          = Succ(
            Succ(to_nat(p2) + to_nat(q2) + (to_nat(p2) + to_nat(q2)))
          ) from Eq::congr(⟦Succ(Succ(□))⟧, double_congr(add_to_nat(p2, q2)))
          = Succ(
            Succ(to_nat(p2) + to_nat(p2) + (to_nat(q2) + to_nat(q2)))
          ) from Eq::congr(⟦Succ(Succ(□))⟧, double_add(to_nat(p2), to_nat(q2)))
          = Succ(
            Succ(to_nat(Bit0(p2))) + to_nat(Bit0(q2))
          ) from Eq::sym(Eq::congr(Succ, Nat::add_succ_left(to_nat(Bit0(p2)), to_nat(Bit0(q2)))))
        }
      }
    }
  }

  pub theorem mul_to_nat(p: Pos, q: Pos): to_nat(mul(p, q)) = to_nat(p) * to_nat(q) {
    match p: to_nat(mul(p, q)) = to_nat(p) * to_nat(q) {
      One => Eq::sym(Nat::mul_one_left(to_nat(q)))
      Bit0(p2) => calc to_nat(mul(p2, q)) + to_nat(mul(p2, q)) {
        = to_nat(p2) * to_nat(q) + to_nat(p2) * to_nat(q) from double_congr(mul_to_nat(p2, q))
        = (
          to_nat(p2) + to_nat(p2)
        ) * to_nat(q) from Eq::sym(Nat::mul_add_distrib_right(to_nat(p2), to_nat(p2), to_nat(q)))
      }
      Bit1(p2) => calc to_nat(add(Bit0(mul(p2, q)), q)) {
        = to_nat(Bit0(mul(p2, q))) + to_nat(q) from add_to_nat(Bit0(mul(p2, q)), q)
        = to_nat(
          p2
        ) * to_nat(
          q
        ) + to_nat(
          p2
        ) * to_nat(
          q
        ) + to_nat(q) from Eq::congr(⟦Nat::add(□, to_nat(q))⟧, double_congr(mul_to_nat(p2, q)))
        = (
          to_nat(p2) + to_nat(p2)
        ) * to_nat(
          q
        ) + to_nat(
          q
        ) from Eq::congr(
          ⟦Nat::add(□, to_nat(q))⟧,
          Eq::sym(Nat::mul_add_distrib_right(to_nat(p2), to_nat(p2), to_nat(q)))
        )
        = Succ(
          to_nat(Bit0(p2))
        ) * to_nat(q) from Eq::sym(Nat::mul_succ_left(to_nat(Bit0(p2)), to_nat(q)))
      }
    }
  }

  pub theorem eq_refl(p: Pos): eq(p, p) = true {
    match p: eq(p, p) = true {
      One => Refl
      Bit0(q) => eq_refl(q)
      Bit1(q) => eq_refl(q)
    }
  }

  pub theorem eq_sound(p: Pos, q: Pos, h: eq(p, q) = true): p = q {
    match p: p = q {
      One => match q: One = q {
        One => Refl
        Bit0(q2) => False::elim(false_ne_true(h))
        Bit1(q2) => False::elim(false_ne_true(h))
      }
      Bit0(p2) => match q: Bit0(p2) = q {
        One => False::elim(false_ne_true(h))
        Bit0(q2) => Eq::congr(Bit0, eq_sound(p2, q2, h))
        Bit1(q2) => False::elim(false_ne_true(h))
      }
      Bit1(p2) => match q: Bit1(p2) = q {
        One => False::elim(false_ne_true(h))
        Bit0(q2) => False::elim(false_ne_true(h))
        Bit1(q2) => Eq::congr(Bit1, eq_sound(p2, q2, h))
      }
    }
  }

  pub theorem diff_self(p: Pos): diff(p, p) = DiffZero {
    match p: diff(p, p) = DiffZero {
      One => Refl
      Bit0(q) => Eq::congr(diff_double, diff_self(q))
      Bit1(q) => Eq::congr(diff_double, diff_self(q))
    }
  }

  pub theorem compare_refl(p: Pos): compare(p, p) = Equal {
    Eq::congr(diff_sign, diff_self(p))
  }
}

module BinNat {
  pub fn to_nat(n: BinNat): Nat {
    match n: Nat {
      BinZero => 0
      BinPos(p) => Pos::to_nat(p)
    }
  }

  pub fn succ(n: BinNat): BinNat {
    match n: BinNat {
      BinZero => BinPos(One)
      BinPos(p) => BinPos(Pos::succ(p))
    }
  }

  pub fn of_nat(n: Nat): BinNat {
    match n: BinNat {
      Zero => BinZero
      Succ(k) => succ(of_nat(k))
    }
  }

  pub fn add(a: BinNat, b: BinNat): BinNat {
    match a: BinNat {
      BinZero => b
      BinPos(p) => match b: BinNat {
        BinZero => a
        BinPos(q) => BinPos(Pos::add(p, q))
      }
    }
  }

  pub fn mul(a: BinNat, b: BinNat): BinNat {
    match a: BinNat {
      BinZero => BinZero
      BinPos(p) => match b: BinNat {
        BinZero => BinZero
        BinPos(q) => BinPos(Pos::mul(p, q))
      }
    }
  }

  pub fn sub(a: BinNat, b: BinNat): BinNat {
    match a: BinNat {
      BinZero => BinZero
      BinPos(p) => match b: BinNat {
        BinZero => a
        BinPos(q) => Pos::diff_trunc(Pos::diff(p, q))
      }
    }
  }

  pub fn compare(a: BinNat, b: BinNat): Ordering {
    match a: Ordering {
      BinZero => match b: Ordering {
        BinZero => Equal
        BinPos(_) => Less
      }
      BinPos(p) => match b: Ordering {
        BinZero => Greater
        BinPos(q) => Pos::compare(p, q)
      }
    }
  }

  pub fn eq(a: BinNat, b: BinNat): Bool {
    match a: Bool {
      BinZero => match b: Bool {
        BinZero => true
        BinPos(_) => false
      }
      BinPos(p) => match b: Bool {
        BinZero => false
        BinPos(q) => Pos::eq(p, q)
      }
    }
  }

  // ---- agreement with `Nat` -----------------------------------------------------

  pub theorem succ_to_nat(n: BinNat): to_nat(succ(n)) = Succ(to_nat(n)) {
    match n: to_nat(succ(n)) = Succ(to_nat(n)) {
      BinZero => Refl
      BinPos(p) => Pos::succ_to_nat(p)
    }
  }

  pub theorem to_nat_of_nat(n: Nat): to_nat(of_nat(n)) = n {
    match n: to_nat(of_nat(n)) = n {
      Zero => Refl
      Succ(k) => Eq::trans(succ_to_nat(of_nat(k)), Eq::congr(Succ, to_nat_of_nat(k)))
    }
  }

  pub theorem add_to_nat(a: BinNat, b: BinNat): to_nat(add(a, b)) = to_nat(a) + to_nat(b) {
    match a: to_nat(add(a, b)) = to_nat(a) + to_nat(b) {
      BinZero => Eq::sym(Nat::add_zero_left(to_nat(b)))
      BinPos(p) => match b: to_nat(add(BinPos(p), b)) = Pos::to_nat(p) + to_nat(b) {
        BinZero => Refl
        BinPos(q) => Pos::add_to_nat(p, q)
      }
    }
  }

  pub theorem mul_to_nat(a: BinNat, b: BinNat): to_nat(mul(a, b)) = to_nat(a) * to_nat(b) {
    match a: to_nat(mul(a, b)) = to_nat(a) * to_nat(b) {
      BinZero => Eq::sym(Nat::mul_zero_left(to_nat(b)))
      BinPos(p) => match b: to_nat(mul(BinPos(p), b)) = Pos::to_nat(p) * to_nat(b) {
        BinZero => Refl
        BinPos(q) => Pos::mul_to_nat(p, q)
      }
    }
  }

  pub theorem compare_refl(a: BinNat): compare(a, a) = Equal {
    match a: compare(a, a) = Equal {
      BinZero => Refl
      BinPos(p) => Pos::compare_refl(p)
    }
  }

  pub theorem eq_refl(a: BinNat): eq(a, a) = true {
    match a: eq(a, a) = true {
      BinZero => Refl
      BinPos(p) => Pos::eq_refl(p)
    }
  }

  pub theorem eq_sound(a: BinNat, b: BinNat, h: eq(a, b) = true): a = b {
    match a: a = b {
      BinZero => match b: BinZero = b {
        BinZero => Refl
        BinPos(q) => False::elim(false_ne_true(h))
      }
      BinPos(p) => match b: BinPos(p) = b {
        BinZero => False::elim(false_ne_true(h))
        BinPos(q) => Eq::congr(BinPos, Pos::eq_sound(p, q, h))
      }
    }
  }

  pub theorem sub_self(a: BinNat): sub(a, a) = BinZero {
    match a: sub(a, a) = BinZero {
      BinZero => Refl
      BinPos(p) => Eq::congr(Pos::diff_trunc, Pos::diff_self(p))
    }
  }
}
