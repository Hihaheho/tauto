    Int,
    Int::add(
      Int::mul(Int::mul(IntOfNat(X), IntOfNat(1)), IntOfNat(1)),
      Int::neg(Int::mul(IntOfNat(1), IntOfNat(d)))
    ),
    Int::add(Int::neg(Int::mul(IntOfNat(1), IntOfNat(d))), Int::mul(IntOfNat(1), IntOfNat(X)))
  ) {}
}

