pub theorem len_j_contra_12(
  j3: Nat
): Eq(
  Int,
  Int::add(
    Int::mul(Int::mul(IntOfNat(Nat::add(56, Succ(Succ(Succ(j3))))), IntOfNat(1)), IntOfNat(1)),
    Int::add(
      Int::neg(Int::mul(IntOfNat(1), IntOfNat(j3))),
      Int::neg(Int::mul(IntOfNat(58), IntOfNat(1)))
    )
  ),
  IntOfNat(1)
) {
  by int_norm!(): Eq(
