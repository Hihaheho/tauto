// Generic data every development uses. Imported with `import "../std/Std.taut"` from meta/.

inductive Option(A: Type): Type {
  None(): Option(A)
  Some(a: A): Option(A)
}

inductive List(A: Type): Type {
  Nil(): List(A)
  Cons(h: A, t: List(A)): List(A)
}

fn plus(n: Nat, m: Nat) -> Nat {
  match n -> Nat {
    zero => m
    succ(k) => succ(plus(k, m))
  }
}

inductive Pair(A: Type, B: Type): Type {
  pair(fst: A, snd: B): Pair(A, B)
}
