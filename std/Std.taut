// What every development uses. Imported with `import "../std/Std.taut"` from meta/.
// `Option`, `List`, `Pair` and `Ordering` are the data of `std/prelude/Std.taut`,
// which proofs read as families: a `Pair` is written `Pair { fst: a, snd: b }`.

fn plus(n: Nat, m: Nat) -> Nat {
  match n -> Nat {
    zero => m
    succ(k) => succ(plus(k, m))
  }
}
