import "Base.taut" { List, Nat }
import std::prelude::Std { List, Option, Ordering }

// Text as the proofs see it: its UTF-8 bytes.
// Extraction maps `Text` onto Nib's `Text` and the functions marked below
// onto Nib's builtins; their definitions here say what those builtins do.
// Positions are byte offsets, as in `std/prelude/Text::taut`. Once this file is
// read, a literal "…" is a `Text` (`check/sugar.rs`).

pub(open) inductive Text: Type =>
  fn Text::beq, theorem Text::beq_refl, theorem Text::beq_sound, theorem Text::deq {
  Mk(bytes: List(Nat)): Text
}

module Text {
  pub fn bytes(t: Text): List(Nat) {
    ⊢ List(Nat) from match t {
      Mk(bs) => bs
    }
  }

  // Mapped: the length in bytes.
  pub fn len(t: Text): Nat {
    List::length(bytes(t))
  }

  // Mapped: the byte at `i`.
  pub fn byte(t: Text, i: Nat): Option(Nat) {
    List::nth(bytes(t), i)
  }

  pub fn byte_value(t: Text, i: Nat): Nat {
    ⊢ Nat from match byte(t, i) {
      None => Zero
      Some(b) => b
    }
  }

  // Whether a character starts at `i`: the end, or a byte that is not
  // `10xxxxxx`.
  pub fn boundary(t: Text, i: Nat): Bool {
    ⊢ Bool from match byte(t, i) {
      None => i == Text::len(t)
      Some(b) => b < 128 || 192 <= b
    }
  }

  // Mapped: the bytes from `start` to `end`, when both are boundaries of
  // characters in order.
  pub fn slice(t: Text, start: Nat, end: Nat): Option(Text) {
    ⊢ Option(Text) from match start <= end && (boundary(t, start) && boundary(t, end)) {
      false => None
      true => Some(Text::Mk(List::take(end - start, List::drop(start, bytes(t)))))
    }
  }

  pub fn slice_or_empty(t: Text, start: Nat, end: Nat): Text {
    ⊢ Text from match slice(t, start, end) {
      None => ""
      Some(s) => s
    }
  }

  // Mapped.
  pub fn concat(a: Text, b: Text): Text {
    Text::Mk(List::append(bytes(a), bytes(b)))
  }

  // Mapped: the parts one after another.
  pub fn concat_all(parts: List(Text)): Text {
    ⊢ Text from match parts {
      Nil => Text::Mk(Nil)
      Cons(p, rest) => Text::concat(p, concat_all(rest))
    }
  }
}

module Bytes {
  pub fn compare(a: List(Nat), b: List(Nat)): Ordering {
    ⊢ Ordering from match a {
      Nil => ⊢ Ordering from match b {
        Nil => Equal
        Cons(y, ys) => Less
      }
      Cons(x, xs) => ⊢ Ordering from match b {
        Nil => Greater
        Cons(y, ys) => ⊢ Ordering from match x < y {
          true => Less
          false => ⊢ Ordering from match y < x {
            true => Greater
            false => compare(xs, ys)
          }
        }
      }
    }
  }
}

module Text {
  // Mapped: byte by byte, a prefix first. The prelude's `Text::compare` says
  // the same as an `i64`.
  pub fn ordering(a: Text, b: Text): Ordering {
    Bytes::compare(bytes(a), bytes(b))
  }

  // Mapped.
  pub fn eq(a: Text, b: Text): Bool {
    ⊢ Bool from match ordering(a, b) { Less => false, Equal => true, Greater => false }
  }
}

module Nat {
  // The decimal digits of `n` before `acc`; `fuel` is more than the number
  // of digits.
  pub fn digits(fuel: Nat, n: Nat, acc: List(Nat)): List(Nat) {
    ⊢ List(Nat) from match fuel {
      Zero => acc
      Succ(f) => ⊢ List(Nat) from match Nat::div_nz(n, 10, Nat::ne_zero(10, Refl)) == 0 {
        true => Cons(Nat::add(Nat::rem_nz(n, 10, Nat::ne_zero(10, Refl)), 48), acc)
        false => digits(
          f,
          Nat::div_nz(n, 10, Nat::ne_zero(10, Refl)),
          Cons(Nat::add(Nat::rem_nz(n, 10, Nat::ne_zero(10, Refl)), 48), acc)
        )
      }
    }
  }

  pub fn between(lo: Nat, hi: Nat, n: Nat): Bool {
    lo <= n && n <= hi
  }
}

module Text {
  // Mapped: `n` in decimal.
  pub fn of_nat(n: Nat): Text {
    Text::Mk(Nat::digits(Succ(n), n, Nil))
  }

  // Mapped: the character `c`, or `None` when `c` is not one (a surrogate,
  // or past 0x10FFFF).
  pub fn of_code_point(c: Nat): Option(Text) {
    ⊢ Option(Text) from match (55296 <= c && c < 57344) || 1114112 <= c {
      true => None
      false => Some(utf8_of_code_point(c))
    }
  }

  // Mapped: the UTF-8 encoding of the character `c`; "" when `c` is not one.
  pub fn utf8_of_code_point(c: Nat): Text {
    ⊢ Text from match c < 128 {
      true => Text::Mk([c])
      false => ⊢ Text from match c < 2048 {
        true => Text::Mk(
          Cons(
            Nat::add(Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)), 192),
            Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil)
          )
        )
        false => ⊢ Text from match 55296 <= c && c < 57344 {
          true => Text::Mk(Nil)
          false => ⊢ Text from match c < 65536 {
            true => Text::Mk(
              Cons(
                Nat::add(Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)), 224),
                Cons(
                  Nat::add(
                    Nat::rem_nz(
                      Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)),
                      64,
                      Nat::ne_zero(64, Refl)
                    ),
                    128
                  ),
                  Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil)
                )
              )
            )
            false => ⊢ Text from match c < 1114112 {
              true => Text::Mk(
                Cons(
                  Nat::add(Nat::div_nz(c, 262144, Nat::ne_zero(262144, Refl)), 240),
                  Cons(
                    Nat::add(
                      Nat::rem_nz(
                        Nat::div_nz(c, 4096, Nat::ne_zero(4096, Refl)),
                        64,
                        Nat::ne_zero(64, Refl)
                      ),
                      128
                    ),
                    Cons(
                      Nat::add(
                        Nat::rem_nz(
                          Nat::div_nz(c, 64, Nat::ne_zero(64, Refl)),
                          64,
                          Nat::ne_zero(64, Refl)
                        ),
                        128
                      ),
                      Cons(Nat::add(Nat::rem_nz(c, 64, Nat::ne_zero(64, Refl)), 128), Nil)
                    )
                  )
                )
              )
              false => Text::Mk(Nil)
            }
          }
        }
      }
    }
  }
}

// A byte after the first of a character: `10xxxxxx`.
pub fn utf8_continuation(b: Nat): Bool {
  Nat::between(128, 191, b)
}

// The least second byte after the first byte `b` of three or four: below
// it would be an overlong encoding.
pub fn utf8_second_min(b: Nat): Nat {
  ⊢ Nat from match b == 224 {
    true => 160
    false => ⊢ Nat from match b == 240 { true => 144, false => 128 }
  }
}

// The greatest second byte after the first byte `b` of three or four:
// past it would be a surrogate or past 0x10FFFF.
pub fn utf8_second_max(b: Nat): Nat {
  ⊢ Nat from match b == 237 {
    true => 159
    false => ⊢ Nat from match b == 244 { true => 143, false => 191 }
  }
}

// Whether `bs` is well-formed UTF-8: each character in the shortest
// encoding, no surrogate, nothing past 0x10FFFF.
pub fn utf8_valid(bs: List(Nat)): Bool {
  ⊢ Bool from match bs {
    Nil => true
    Cons(b, r1) => ⊢ Bool from match b < 128 {
      true => utf8_valid(r1)
      false => ⊢ Bool from match r1 {
        Nil => false
        Cons(c1, r2) => ⊢ Bool from match Nat::between(194, 223, b) {
          true => utf8_continuation(c1) && utf8_valid(r2)
          false => ⊢ Bool from match r2 {
            Nil => false
            Cons(c2, r3) => ⊢ Bool from match Nat::between(224, 239, b) {
              true => Nat::between(
                utf8_second_min(b),
                utf8_second_max(b),
                c1
              ) && (utf8_continuation(c2) && utf8_valid(r3))
              false => ⊢ Bool from match r3 {
                Nil => false
                Cons(c3, r4) => Nat::between(
                  240,
                  244,
                  b
                ) && (
                  Nat::between(
                    utf8_second_min(b),
                    utf8_second_max(b),
                    c1
                  ) && (utf8_continuation(c2) && (utf8_continuation(c3) && utf8_valid(r4)))
                )
              }
            }
          }
        }
      }
    }
  }
}

module Text {
  // Mapped: the text whose bytes are `bs`, when they are well-formed UTF-8.
  pub fn of_utf8(bs: List(Nat)): Option(Text) {
    ⊢ Option(Text) from match utf8_valid(bs) {
      true => Some(Text::Mk(bs))
      false => None
    }
  }

  pub theorem of_nat_42(): of_nat(42) = "42" {
    Refl
  }

  pub theorem concat_ab(): Text::concat("a", "b") = "ab" {
    Refl
  }

  pub theorem slice_cuts_bytes(): slice("héllo", 1, 3) = Some("é") {
    Refl
  }

  pub theorem slice_inside_a_character(): slice("héllo", 2, 3) = None {
    Refl
  }

  pub theorem of_code_point_e(): of_code_point(233) = Some("é") {
    Refl
  }

  pub theorem of_utf8_e(): of_utf8([104, 195, 169]) = Some("hé") {
    Refl
  }

  pub theorem of_utf8_overlong(): of_utf8([192, 175]) = None {
    Refl
  }

  pub theorem of_utf8_surrogate(): of_utf8([237, 160, 128]) = None {
    Refl
  }

  pub theorem of_utf8_cut(): of_utf8([227, 129]) = None {
    Refl
  }

  pub theorem of_utf8_past_max(): of_utf8([244, 144, 128, 128]) = None {
    Refl
  }
}
