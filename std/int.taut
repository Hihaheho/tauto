import std::prelude::num { divzero }
import "base.taut" { Nat }
import "uint.taut" { or_div_zero }
import std::prelude::std { Option }

// Integers as the proofs see them: a natural number, or the negative of
// one more than a natural number, so that each integer is written one way.
// Extraction writes `Int` as an `enum` of Nib on `nat`. Once this file is
// read, a numeral where an `Int` is expected is one (`-3` is `IntNegSucc(2)`),
// and a `match` on an `Int` with numerals for patterns is the branches on `==`
// it stands for (`check/implicit.rs`, `check/sugar.rs`).

pub(open) inductive Int: Type =>
  fn Int::beq, theorem Int::beq_refl, theorem Int::beq_sound, theorem Int::deq {
  IntOfNat(n: Nat): Int
  // `-(n + 1)`.
  IntNegSucc(n: Nat): Int
}

pub fn Int::neg(x: Int): Int {
  match x {
    IntOfNat(n) => ⊢ Int from match n {
      Zero => IntOfNat(Zero)
      Succ(k) => IntNegSucc(k)
    }
    IntNegSucc(n) => IntOfNat(Succ(n))
  }
}

pub fn Int::sub_nat(a: Nat, b: Nat): Int {
  match a < b {
    false => IntOfNat(a - b)
    true => IntNegSucc((b - a) - Succ(Zero))
  }
}

pub fn Int::add(x: Int, y: Int): Int {
  match x {
    IntOfNat(a) => ⊢ Int from match y {
      IntOfNat(b) => IntOfNat(Nat::add(a, b))
      IntNegSucc(b) => Int::sub_nat(a, Succ(b))
    }
    IntNegSucc(a) => ⊢ Int from match y {
      IntOfNat(b) => Int::sub_nat(b, Succ(a))
      IntNegSucc(b) => IntNegSucc(Succ(Nat::add(a, b)))
    }
  }
}

pub fn Int::sub(x: Int, y: Int): Int {
  Int::add(x, Int::neg(y))
}

pub fn Int::mul(x: Int, y: Int): Int {
  match x {
    IntOfNat(a) => ⊢ Int from match y {
      IntOfNat(b) => IntOfNat(Nat::mul(a, b))
      IntNegSucc(b) => Int::neg(IntOfNat(Nat::mul(a, Succ(b))))
    }
    IntNegSucc(a) => ⊢ Int from match y {
      IntOfNat(b) => Int::neg(IntOfNat(Nat::mul(Succ(a), b)))
      IntNegSucc(b) => IntOfNat(Nat::mul(Succ(a), Succ(b)))
    }
  }
}

pub theorem Int::of_nat_ne_zero(b: Nat, h: ¬(IntOfNat(b) = 0)): ¬(b = 0) {
  (e: b = 0) => h(Eq::congr(⟦IntOfNat(□)⟧, e))
}

// `x / y` rounded toward zero, for a `y` that `h` says is not 0.
pub fn Int::tdiv_nz(x: Int, y: Int, h: ¬(y = 0)): Int {
  match x {
    IntOfNat(a) => ⊢ Int from match y {
      IntOfNat(b) => IntOfNat(Nat::div_nz(a, b, Int::of_nat_ne_zero(b, h)))
      IntNegSucc(b) => Int::neg(IntOfNat(Nat::div_nz(a, Succ(b), Nat::succ_ne_zero(b))))
    }
    IntNegSucc(a) => ⊢ Int from match y {
      IntOfNat(b) => Int::neg(IntOfNat(Nat::div_nz(Succ(a), b, Int::of_nat_ne_zero(b, h))))
      IntNegSucc(b) => IntOfNat(Nat::div_nz(Succ(a), Succ(b), Nat::succ_ne_zero(b)))
    }
  }
}

// The remainder of `tdiv_nz`, with the sign of `x`.
pub fn Int::tmod_nz(x: Int, y: Int, h: ¬(y = 0)): Int {
  Int::sub(x, Int::mul(y, Int::tdiv_nz(x, y, h)))
}

// `x / y` rounded down, for a `y` that `h` says is not 0.
pub fn Int::fdiv_nz(x: Int, y: Int, h: ¬(y = 0)): Int {
  match x {
    IntOfNat(a) => ⊢ Int from match y {
      IntOfNat(b) => IntOfNat(Nat::div_nz(a, b, Int::of_nat_ne_zero(b, h)))
      IntNegSucc(b) => Int::neg(IntOfNat(Nat::div_nz(Nat::add(a, b), Succ(b), Nat::succ_ne_zero(b))))
    }
    IntNegSucc(a) => ⊢ Int from match y {
      IntOfNat(b) => Int::neg(IntOfNat(Nat::div_nz(Nat::add(a, b), b, Int::of_nat_ne_zero(b, h))))
      IntNegSucc(b) => IntOfNat(Nat::div_nz(Succ(a), Succ(b), Nat::succ_ne_zero(b)))
    }
  }
}

// The remainder of `fdiv_nz`, with the sign of `y`.
pub fn Int::fmod_nz(x: Int, y: Int, h: ¬(y = 0)): Int {
  Int::sub(x, Int::mul(y, Int::fdiv_nz(x, y, h)))
}

pub fn Int::eq(x: Int, y: Int): Bool {
  match x {
    IntOfNat(a) => ⊢ Bool from match y {
      IntOfNat(b) => a == b
      IntNegSucc(b) => false
    }
    IntNegSucc(a) => ⊢ Bool from match y {
      IntOfNat(b) => false
      IntNegSucc(b) => a == b
    }
  }
}

// `y` is not 0 when `Int::eq` says so.
pub theorem Int::ne_zero(y: Int, h: Int::eq(y, 0) = false): ¬(y = 0) {
  (e: y = 0) => true_ne_false(Eq::trans(Eq::sym(Eq::congr(⟦Int::eq(□, 0)⟧, e)), h))
}

// `tdiv`, or `None` when `y` is 0.
pub fn Int::checked_tdiv(x: Int, y: Int): Option(Int) {
  match Int::eq(y, 0) eqn h {
    false => Some(Int::tdiv_nz(x, y, Int::ne_zero(y, h)))
    true => None
  }
}

// `x / y` rounded toward zero, or `divzero` when `y` is 0.
pub fn Int::tdiv(x: Int, y: Int): Int ! {divzero} {
  or_div_zero(Int::checked_tdiv(x, y))
}

// `tmod`, or `None` when `y` is 0.
pub fn Int::checked_tmod(x: Int, y: Int): Option(Int) {
  match Int::eq(y, 0) eqn h {
    false => Some(Int::tmod_nz(x, y, Int::ne_zero(y, h)))
    true => None
  }
}

// The remainder of `tdiv`, with the sign of `x`, or `divzero` when `y` is 0.
pub fn Int::tmod(x: Int, y: Int): Int ! {divzero} {
  or_div_zero(Int::checked_tmod(x, y))
}

// `fdiv`, or `None` when `y` is 0.
pub fn Int::checked_fdiv(x: Int, y: Int): Option(Int) {
  match Int::eq(y, 0) eqn h {
    false => Some(Int::fdiv_nz(x, y, Int::ne_zero(y, h)))
    true => None
  }
}

// `x / y` rounded down, or `divzero` when `y` is 0.
pub fn Int::fdiv(x: Int, y: Int): Int ! {divzero} {
  or_div_zero(Int::checked_fdiv(x, y))
}

// `fmod`, or `None` when `y` is 0.
pub fn Int::checked_fmod(x: Int, y: Int): Option(Int) {
  match Int::eq(y, 0) eqn h {
    false => Some(Int::fmod_nz(x, y, Int::ne_zero(y, h)))
    true => None
  }
}

// The remainder of `fdiv`, with the sign of `y`, or `divzero` when `y` is 0.
pub fn Int::fmod(x: Int, y: Int): Int ! {divzero} {
  or_div_zero(Int::checked_fmod(x, y))
}

pub fn Int::lt(x: Int, y: Int): Bool {
  match x {
    IntOfNat(a) => ⊢ Bool from match y {
      IntOfNat(b) => a < b
      IntNegSucc(b) => false
    }
    IntNegSucc(a) => ⊢ Bool from match y {
      IntOfNat(b) => true
      IntNegSucc(b) => b < a
    }
  }
}

pub fn Int::le(x: Int, y: Int): Bool {
  Int::lt(x, y) || Int::eq(x, y)
}

pub theorem Int::neg_neg(x: Int): Int::neg(Int::neg(x)) = x {
  match x {
    IntOfNat(n) => ⊢ Int::neg(Int::neg(IntOfNat(n))) = IntOfNat(n) from match n {
      Zero => Refl
      Succ(k) => Refl
    }
    IntNegSucc(n) => Refl
  }
}

pub theorem Int::add_zero(x: Int): Int::add(x, IntOfNat(Zero)) = x {
  match x {
    IntOfNat(n) => Refl
    IntNegSucc(n) => Refl
  }
}

pub theorem Int::examples(): Int::sub(3, 5) = -2 {
  Refl
}
