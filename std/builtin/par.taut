// Parallel primitives. A task is started by performing `spawn` and its result
// is taken by `Task::join`;
// where its body runs is up to the handler of `spawn`.

import std::builtin::os { argv, env, environ, fs_canonicalize, fs_copy, fs_create_dir, fs_list_dir, fs_lock, fs_read, fs_read_bytes, fs_read_bytes_under, fs_read_link, fs_read_under, fs_remove, fs_rename, fs_set_mode, fs_stat, fs_temp_dir, fs_unlock, fs_write, fs_write_bytes, fs_write_new, hash_seed, host_width, monotonic_clock, net, net_addr, net_cancel, net_close, net_finish, net_open, net_read, net_resolve, net_write, permission, proc_close, proc_close_stdin, proc_read, proc_run, proc_spawn, proc_wait, proc_write, random, secure_random, shutdown_token, sleep, stderr, stdin_bytes, stdout, stdout_flush, tcp_accept, tcp_close, tcp_connect, tcp_listen, tcp_read, tcp_shutdown, tcp_unlisten, tcp_write, timer, tls_accept, tls_close, tls_connect, tls_read, tls_shutdown, tls_write, uhost_add, uhost_mul, uhost_of_u64, uhost_sub, wall_clock }
import std::prelude::collections { Vec }
import std::prelude::num { divzero, overflow }
import std::prelude::std { List, Option }

// A flag raised once and never lowered: a task finishing, a mutex's content
// being handed over, or a cancellation request. Only the externs make flags.
pub struct(shared) Signal {}
struct(shared) CancelSource {}

extern {
  pub fn Signal::fresh(): CancelSource
  pub fn Signal::raise(s: CancelSource): Unit
  pub fn Signal::listen(s: CancelSource): Signal
  pub fn Signal::is_raised(s: Signal): Bool
  pub fn Signal::either(a: Signal, b: Signal): Signal
}

// A request is a notification. A task acknowledges it by returning normally.
pub struct(shared) Cancellation { source: CancelSource }
pub struct(shared) CancelToken { signal: Signal }
pub(open) struct(shared) Cancelled {}

pub fn Cancellation::new(): Cancellation { Cancellation { source: Signal::fresh() } }
pub fn Cancellation::token(c: Cancellation): CancelToken { CancelToken { signal: Signal::listen(c.source) } }
pub fn Cancellation::request(c: Cancellation): Unit { Signal::raise(c.source) }

pub fn CancelToken::signal(c: CancelToken): Signal { c.signal }
pub fn CancelToken::is_requested(c: CancelToken): Bool { Signal::is_raised(c.signal) }

// Waits until the signal is raised. Every wait between tasks is this one
// effect, so a host may run many tasks on one thread and go on with the
// others while one waits. It appears in a row, but the host alone answers
// it: no program's `handle` has an arm for it.
pub effect wait(s: Signal): Unit resume 1

// What a task will return: the value, or the task still running. The host
// that runs the bodies in parallel makes it the second.
pub struct(affine) Pending(A: Type) { holds: () -> A }

extern {
  pub fn Pending::ready<A>(v: A): Pending(A)
  // The result, once the signal of `Pending::signal` is raised.
  pub fn Pending::take<A>(p: Pending(A)): A
  pub fn Pending::is_ready<A>(p: &Pending(A)): Bool
  pub fn Pending::signal<A>(p: &Pending(A)): Signal
}

// A started task. Linear, so a task is joined or detached, never dropped.
pub(open) struct(linear) Task(A: Type) { result: Pending(A) }

// What a task may perform: it may diverge and may ask the host what a
// program may ask it, but for standard input and the exit
// (`docs/design/host-effects.md`). What the host answers is listed here only.
effect Host {
  div,
  budget,
  budget_memory,
  ref_new,
  ref_get,
  ref_set,
  weak_of,
  weak_get,
  mutex_new,
  mutex_claim,
  mutex_take_claimed,
  mutex_put,
  mutex_withdraw,
  atomic_new,
  atomic_load,
  atomic_store,
  atomic_fetch_add,
  stdout,
  stderr,
  stdin_bytes,
  stdout_flush,
  shutdown_token,
  argv,
  wall_clock,
  monotonic_clock,
  uhost_add,
  uhost_sub,
  uhost_mul,
  uhost_of_u64,
  host_width,
  hash_seed,
  sleep,
  timer,
  random,
  secure_random,
  fs_read,
  fs_write,
  fs_read_bytes,
  fs_write_bytes,
  fs_read_under,
  fs_read_bytes_under,
  fs_create_dir,
  fs_list_dir,
  fs_remove,
  fs_stat,
  fs_read_link,
  fs_write_new,
  fs_rename,
  fs_set_mode,
  fs_lock,
  fs_unlock,
  fs_copy,
  fs_canonicalize,
  fs_temp_dir,
  proc_spawn,
  proc_read,
  proc_write,
  proc_close_stdin,
  proc_wait,
  proc_close,
  proc_run,
  env,
  environ,
  permission,
  net,
  net_addr,
  net_resolve,
  net_open,
  net_write,
  net_finish,
  net_cancel,
  net_read,
  net_close,
  tcp_listen,
  tcp_accept,
  tcp_connect,
  tcp_read,
  tcp_write,
  tcp_shutdown,
  tcp_close,
  tcp_unlisten,
  tls_accept,
  tls_connect,
  tls_read,
  tls_write,
  tls_shutdown,
  tls_close,
  wait,
  ∀ T. spawn(() -> T ! {})
}

// A task may start tasks of its own: `spawn` is in `Host`, and the tasks it
// starts ask the host the same, under the same permissions.
//
// The host answers what a task performs, under the run's permissions: a task
// runs apart from the handlers around its `spawn`, so none of them answers
// what it asks. A task that performs an effect of its own puts its handler
// in its body. A function that starts tasks takes their bodies with a row
// variable bounded by `Host` (`<h: Host>`, `() -> A ! h`), and its caller
// passes a body wrapped in its own handler.
pub(open) effect spawn<A>(f: affine () -> A ! {Host, overflow, divzero}): Task(A) resume 1

pub fn Pending::join<A>(p: Pending(A)): A ! {wait} {
  perform wait(Pending::signal(&p))
  Pending::take(p)
}

pub fn Task::join<A>(t: Task(A)): A ! {wait} {
  match t {
    Task { result } => Pending::join(result)
  }
}

// Waits until `s` is raised or `deadline`, a value of `monotonic_clock`,
// passes: whether `s` was raised. A signal already raised is not waited for.
pub fn wait_until(s: Signal, deadline: i64): Bool ! {wait, timer} {
  if Signal::is_raised(s) {
    true
  } else {
    perform wait(Signal::either(s, perform timer(deadline)))
    Signal::is_raised(s)
  }
}

// A task looked at without waiting: its result, or the task given back to
// be looked at or joined later.
pub(open) enum(linear) Polled(A: Type) {
  Finished(A),
  Running(Task(A)),
}

// Whether the task has ended, without waiting for it: a loop that has other
// work can look again later instead of blocking in `Task::join`.
pub fn Task::poll<A>(t: Task(A)): Polled(A) {
  match t {
    Task { result } => if Pending::is_ready(&result) {
      Finished(Pending::take(result))
    } else {
      Running(Task { result: result })
    }
  }
}

// Waits for the task until `deadline` passes, then looks at it: its
// result, or the task given back, still running, to be joined or detached.
pub fn Task::join_until<A>(t: Task(A), deadline: i64): Polled(A) ! {wait, timer} {
  match t {
    Task { result } => {
      let s := Pending::signal(&result)
      wait_until(s, deadline)
      Task::poll(Task { result: result })
    }
  }
}

pub fn Task::detach<A>(t: Task(A)): Unit {
  match t {
    Task { result } => #()
  }
}

pub fn Task::join_all<A>(ts: List(Task(A))): List(A) ! {wait} {
  match ts {
    Nil => Nil
    Cons(t, rest) => {
      let a := Task::join(t)
      Cons(a, Task::join_all(rest))
    }
  }
}

// Two bodies at once: both are started before either is joined. A body
// may wait for another task, as through a mutex or a channel. Each body is
// called once, so it may own what it was given.
pub fn par<A, B>(
  f: affine () -> A ! {div, wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put, mutex_withdraw, atomic_new, atomic_load, atomic_store, atomic_fetch_add},
  g: affine () -> B ! {div, wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put, mutex_withdraw, atomic_new, atomic_load, atomic_store, atomic_fetch_add}
): A × B ! {∀ T. spawn(() -> T ! {div, wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put, mutex_withdraw, atomic_new, atomic_load, atomic_store, atomic_fetch_add}), wait} {
  let a := perform spawn(f)
  let b := perform spawn(g)
  #(Task::join(a), Task::join(b))
}

// Any number of bodies at once: all are started before any is joined. As
// with `par`, the bodies perform only `div`, `wait` and the mutex and atomic
// operations: what else a task asks of
// the host is in the row of the `spawn` that starts it, which here is the
// row the list writes for its bodies. The recursion is structural, so it
// performs no `div` and the started tasks may stay live across it; a
// recursion that may not end could leave them unjoined (`budget` drops what
// follows a `div`).
pub fn spawn_all<A>(
  bs: List(() -> A ! {div, wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put, mutex_withdraw, atomic_new, atomic_load, atomic_store, atomic_fetch_add})
): List(A) ! {∀ T. spawn(() -> T ! {div, wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put, mutex_withdraw, atomic_new, atomic_load, atomic_store, atomic_fetch_add}), wait} {
  Task::join_all(spawn_bodies(bs))
}

// Starts the last body first, so that no task is live across the
// recursion; `spawn` resumes once, so the started ones may stay live
// across it.
pub fn spawn_bodies<A>(
  bs: List(() -> A ! {div, wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put, mutex_withdraw, atomic_new, atomic_load, atomic_store, atomic_fetch_add})
): List(Task(A)) ! {∀ T. spawn(() -> T ! {div, wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put, mutex_withdraw, atomic_new, atomic_load, atomic_store, atomic_fetch_add})} {
  match bs {
    Nil => Nil
    Cons(f, rest) => {
      let ts := spawn_bodies(rest)
      Cons(perform spawn(f), ts)
    }
  }
}

// A cell any number of closures and tasks share. A `Ref` is a plain slot; a
// `Mutex` hands its content to one task at a time; an `Atomic` is a
// number tasks update without a lock. `Ref::get` copies the value and leaves
// it in the cell, so it asks `A: shared`; `Ref::set` moves `v` in and drops
// the value it replaces, which any `A` but a linear one allows.
pub struct(shared) Ref(A: Type) {}
// The content is reached only through `Mutex::lock`, so a `Mutex` is shared
// whatever it holds; the field only says the type mentions `A`.
pub struct(shared) Mutex(A: Type) { holds: () -> A }
pub struct(shared) Atomic {}
// A handle on a `Ref` that does not keep it alive: it is no edge of the
// graph the cycle check keeps acyclic (`docs/design/shared-levels.md`).
// `Weak::get` gives the `Ref` back while a strong handle on it remains. When
// it stops doing so is the backend's: after the last use of the last handle
// where storages are counted, after a collection where a collector frees
// them.
pub struct(shared) Weak(A: Type) {}

// Making a `Ref`, reading and writing it, and its `Weak` handles are effects
// the host answers (`docs/design/host-effects.md`): a value never changes
// behind a row that does not say so. Only the host makes a `Ref`; a handler
// may answer `ref_get`, `ref_set`, `weak_of` and `weak_get` by asking the
// host in turn.
pub(open) effect ref_new<A: Affine>(v: A): Ref(A) direct
pub(open) effect ref_get<A: Shared>(r: Ref(A)): A direct
pub(open) effect ref_set<A: Affine>(r: Ref(A), v: A): Unit direct
pub(open) effect weak_of<A: Affine>(r: Ref(A)): Weak(A) direct
pub(open) effect weak_get<A: Affine>(w: Weak(A)): Option(Ref(A)) direct

// What the host runs for those effects: `Host::run`'s arms call them.
extern {
  fn Ref::new<A>(v: A): Ref(A)
  fn Ref::get<A: Shared>(r: Ref(A)): A
  fn Ref::set<A>(r: Ref(A), v: A): Unit
}

extern {
  fn Weak::of<A>(r: Ref(A)): Weak(A)
  fn Weak::get<A>(w: Weak(A)): Option(Ref(A))
}

// Making a `Mutex` and an `Atomic`, and each step on them, are effects the
// host answers too, as the operations on a `Ref` are.
pub(open) effect mutex_new<A: Affine>(v: A): Mutex(A) direct
pub(open) effect mutex_claim<A: Affine>(m: Mutex(A)): Signal direct
pub(open) effect mutex_take_claimed<A: Affine>(m: Mutex(A), s: Signal): A direct
pub(open) effect mutex_put<A: Affine>(m: Mutex(A), v: A): Unit direct
pub(open) effect mutex_withdraw<A: Affine>(m: Mutex(A), s: Signal): Option(A) direct
pub(open) effect atomic_new(n: u64): Atomic direct
pub(open) effect atomic_load(a: Atomic): u64 direct
pub(open) effect atomic_store(a: Atomic, n: u64): Unit direct
pub(open) effect atomic_fetch_add(a: Atomic, n: u64): u64 direct

// What the host runs for those effects: `Host::run`'s arms call them.
extern {
  fn Mutex::new<A>(v: A): Mutex(A)
  // A place in the line for the mutex's content. The signal is raised
  // once the content is handed to this place: at once if the mutex is full
  // and no one is ahead, or at the `Mutex::put` that comes to its turn.
  fn Mutex::claim<A>(m: Mutex(A)): Signal
  fn Mutex::take_claimed<A>(m: Mutex(A), s: Signal): A
  // Hands `v` to the first place in the line, or keeps it if there is none.
  fn Mutex::put<A>(m: Mutex(A), v: A): Unit
  // Leaves the place `s` in the mutex's line: `None` if the content was not
  // handed to it yet, and the content if it was, which is then the
  // caller's as after `Mutex::take_claimed`.
  fn Mutex::withdraw<A>(m: Mutex(A), s: Signal): Option(A)
}

// Takes the mutex's content, waiting while another task has it. The slot
// stays empty until `Mutex::put` gives a content back.
pub fn Mutex::take<A: NoBorrow>(m: Mutex(A)): A ! {wait, mutex_claim, mutex_take_claimed} {
  let s := perform mutex_claim(m)
  perform wait(s)
  perform mutex_take_claimed(m, s)
}

// Takes the mutex's content as `Mutex::take` does, but waits only until
// `deadline` passes: `None` then, and the place in the line is left.
pub fn Mutex::take_until<A: NoBorrow>(m: Mutex(A), deadline: i64): Option(A) ! {wait, timer, mutex_claim, mutex_take_claimed, mutex_withdraw} {
  let s := perform mutex_claim(m)
  if wait_until(s, deadline) { Some(perform mutex_take_claimed(m, s)) } else { perform mutex_withdraw(m, s) }
}

// Takes the mutex's content, waiting while another task has it, and holds
// it in a guard: the content goes back to the mutex when the guard is
// dropped, at the end of the block that binds it.
pub fn Mutex::lock<A: NoBorrow>(m: Mutex(A)): MutexGuard(A) ! {wait, mutex_claim} {
  let s := perform mutex_claim(m)
  perform wait(s)
  MutexGuard::claimed(m, s)
}

// The content of a locked mutex. The host gives the content back to the
// mutex when the guard is dropped, so the lock is released with the block
// that binds the guard; there is no unlock to call. The content is reached by
// borrowing the guard, and the borrow keeps the guard from being dropped.
pub struct(affine) MutexGuard(A: Type) { holds: () -> A }

extern {
  // The content handed to the place `s` in the mutex's line.
  pub fn MutexGuard::claimed<A>(m: Mutex(A), s: Signal): MutexGuard(A)
  pub fn MutexGuard::get<A>(g: &MutexGuard(A)): &A
  pub fn MutexGuard::get_mut<A>(g: &mut MutexGuard(A)): &mut A
}

extern {
  fn Atomic::new(n: u64): Atomic
  fn Atomic::load(a: Atomic): u64
  fn Atomic::store(a: Atomic, n: u64): Unit
  fn Atomic::fetch_add(a: Atomic, n: u64): u64
}

// A count of permits tasks take and give back: `Semaphore::acquire` waits
// while none is left, so at most the starting count of tasks are between an
// acquire and its release.
//
// It is built on two mutexes, as in Barz's semaphore: `count` holds the
// number of permits left, and `gate` is full exactly when that number is
// above zero, so a task that finds none left waits on `gate` without holding
// `count`.
pub(open) struct(shared) Semaphore { count: Mutex(u64), gate: Mutex(Unit) }

pub fn Semaphore::new(n: u64): Semaphore ! {mutex_new, mutex_claim, mutex_take_claimed} {
  let gate := perform mutex_new(#())
  // No one else has the new `gate` yet, so the claim is handed it at once.
  if n == 0 { perform mutex_take_claimed(gate, perform mutex_claim(gate)) } else { #() }
  Semaphore { count: perform mutex_new(n), gate: gate }
}

pub fn Semaphore::acquire(s: Semaphore): Unit ! {wait, mutex_claim, mutex_take_claimed, mutex_put} {
  match s {
    Semaphore { count, gate } => {
      Mutex::take(gate)
      let n := Mutex::take(count)
      if n > 1 { perform mutex_put(gate, #()) } else { #() }
      // A permit was free (the gate was open), so `n` is at least 1.
      perform mutex_put(count, handle { n - 1 } with { overflow() => 0 })
    }
  }
}

// Takes a permit as `Semaphore::acquire` does, waiting for one only until
// `deadline` passes: whether it took one.
pub fn Semaphore::acquire_until(s: Semaphore, deadline: i64): Bool ! {wait, timer, mutex_claim, mutex_take_claimed, mutex_withdraw, mutex_put} {
  match s {
    Semaphore { count, gate } => match Mutex::take_until(gate, deadline) {
      Some(u) => {
        let n := Mutex::take(count)
        if n > 1 { perform mutex_put(gate, u) } else { #() }
        // A permit was free (the gate was open), so `n` is at least 1.
        perform mutex_put(count, handle { n - 1 } with { overflow() => 0 })
        true
      }
      None => false
    }
  }
}

pub fn Semaphore::release(s: Semaphore): Unit ! {wait, mutex_claim, mutex_take_claimed, mutex_put} {
  match s {
    Semaphore { count, gate } => {
      let n := Mutex::take(count)
      if n == 0 { perform mutex_put(gate, #()) } else { #() }
      // More permits than `2^64` are not handed out.
      perform mutex_put(count, handle { n + 1 } with { overflow() => n })
    }
  }
}

// A queue of values between tasks that holds at most `capacity` of them:
// `Channel::send` waits while it is full, which slows a sender down to the
// pace of its receivers, and `Channel::recv` waits while it is empty. Values
// come out in the order they went in. `slots` counts the free places and
// `items` the values in the queue, plus one once the channel is closed.
pub(open) struct(shared) Channel(A: Type) {
  queue: Mutex(Fifo(A)),
  slots: Semaphore,
  items: Semaphore
}

// What `Channel::recv_until` finds: a value, the channel closed and empty,
// or no value yet when the deadline passed.
pub(open) enum(affine) Received(A: Type) {
  Arrived(A),
  Closed,
  NotYet,
}

// Values are pushed on `back` and popped from `front`; when `front` runs
// out, `back` is moved onto it in reverse.
pub(open) struct(affine) Fifo(A: Type) { front: Vec(A), back: Vec(A), closed: Bool }

pub fn Channel::new<A: NoBorrow>(capacity: u64): Channel(A) ! {mutex_new, mutex_claim, mutex_take_claimed} {
  Channel {
    queue: perform mutex_new(Fifo { front: Vec::new(), back: Vec::new(), closed: false }),
    slots: Semaphore::new(capacity),
    items: Semaphore::new(0),
  }
}

pub fn Channel::send<A: NoBorrow>(ch: Channel(A), v: A): Unit ! {wait, mutex_claim, mutex_take_claimed, mutex_put} {
  match ch {
    Channel { queue, slots, items } => {
      Semaphore::acquire(slots)
      match Mutex::take(queue) {
        Fifo { front, back, closed } => {
          var b := back
          Vec::push(&mut b, v)
          perform mutex_put(queue, Fifo { front: front, back: b, closed: closed })
        }
      }
      Semaphore::release(items)
    }
  }
}

// Tells the receivers that no more values come: once the values sent before
// are taken, `Channel::recv` gives `None` instead of waiting.
pub fn Channel::close<A: NoBorrow>(ch: Channel(A)): Unit ! {wait, mutex_claim, mutex_take_claimed, mutex_put} {
  match ch {
    Channel { queue, slots, items } => {
      match Mutex::take(queue) {
        Fifo { front, back, closed } => perform mutex_put(
          queue,
          Fifo { front: front, back: back, closed: true }
        )
      }
      Semaphore::release(items)
    }
  }
}

// The next value, or `None` when the channel is closed and empty. A
// receiver that finds it so gives the permit of the close back, for the
// next receiver to find the same.
pub fn Channel::recv<A: NoBorrow>(ch: Channel(A)): Option(A) ! {wait, mutex_claim, mutex_take_claimed, mutex_put} {
  Semaphore::acquire(ch.items)
  Channel::pop(ch)
}

// The next value as `Channel::recv` gives it, waiting for one only until
// `deadline` passes.
pub fn Channel::recv_until<A: NoBorrow>(ch: Channel(A), deadline: i64): Received(A) ! {wait, timer, mutex_withdraw, mutex_claim, mutex_take_claimed, mutex_put} {
  if Semaphore::acquire_until(ch.items, deadline) {
    match Channel::pop(ch) {
      Some(v) => Arrived(v)
      None => Closed
    }
  } else {
    NotYet
  }
}

// Moves the `left` last values of `b` to `f`, the last first, and gives
// back what is left of `b`: `left` shrinks at each call, so the recursion
// ends without `div`. `b` goes in by value, so `f` takes in no borrow of it.
fn Channel::refill<A>(f: &mut Vec(A), b: Vec(A), left: u64): Vec(A) {
  if left == 0 {
    b
  } else {
    var rest := b
    match Vec::pop(&mut rest) {
      Some(x) => Vec::push(&mut f, x)
      None => #()
    }
    Channel::refill(&mut f, rest, handle { left - 1 } with { overflow() => 0 })
  }
}

// Takes the next value once a permit of `items` is held.
fn Channel::pop<A: NoBorrow>(ch: Channel(A)): Option(A) ! {wait, mutex_claim, mutex_take_claimed, mutex_put} {
  match ch {
    Channel { queue, slots, items } => match Mutex::take(queue) {
      Fifo { front, back, closed } => {
        var f := front
        let b := if Vec::len(&f) == 0 {
          let n := Vec::len(&back)
          Channel::refill(&mut f, back, n)
        } else { back }
        let got := Vec::pop(&mut f)
        perform mutex_put(queue, Fifo { front: f, back: b, closed: closed })
        match got {
          Some(v) => {
            Semaphore::release(slots)
            Some(v)
          }
          None => {
            Semaphore::release(items)
            None
          }
        }
      }
    }
  }
}
