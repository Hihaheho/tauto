// Secret values (`docs/design/secret.md`), such as a key, a token or what is
// computed from one. The content of a `Secret` is never read by a `match`,
// compared with `==` or shown: a program makes one with `secret`, takes the
// content out with `expose` where it means to make it public, and computes
// on it in between only with the `ct_` functions below, each of which runs
// in a time and touches memory in a way that does not depend on it. A
// backend that cannot run the `ct_` functions in constant time refuses a
// program that uses them.
pub struct(shared) Secret(A: Type) {}

extern {
  pub fn secret<A: Shared>(v: A): Secret(A)
  pub fn expose<A: Shared>(s: Secret(A)): A
}

// Arithmetic modulo `2^w`, the bits, shifts and rotations by a public `s`
// modulo the width, comparisons whose answer stays secret, and the choice
// between two secrets by a secret.
extern {
  pub fn Ct::u8_add(a: Secret(u8), b: Secret(u8)): Secret(u8)
  pub fn Ct::u8_sub(a: Secret(u8), b: Secret(u8)): Secret(u8)
  pub fn Ct::u8_mul(a: Secret(u8), b: Secret(u8)): Secret(u8)
  pub fn Ct::u8_and(a: Secret(u8), b: Secret(u8)): Secret(u8)
  pub fn Ct::u8_or(a: Secret(u8), b: Secret(u8)): Secret(u8)
  pub fn Ct::u8_xor(a: Secret(u8), b: Secret(u8)): Secret(u8)
  pub fn Ct::u8_not(a: Secret(u8)): Secret(u8)
  pub fn Ct::u8_shl(a: Secret(u8), s: u64): Secret(u8)
  pub fn Ct::u8_shr(a: Secret(u8), s: u64): Secret(u8)
  pub fn Ct::u8_rotl(a: Secret(u8), s: u64): Secret(u8)
  pub fn Ct::u8_rotr(a: Secret(u8), s: u64): Secret(u8)
  pub fn Ct::u8_eq(a: Secret(u8), b: Secret(u8)): Secret(Bool)
  pub fn Ct::u8_lt(a: Secret(u8), b: Secret(u8)): Secret(Bool)
  pub fn Ct::u8_select(c: Secret(Bool), a: Secret(u8), b: Secret(u8)): Secret(u8)
  pub fn Ct::u32_add(a: Secret(u32), b: Secret(u32)): Secret(u32)
  pub fn Ct::u32_sub(a: Secret(u32), b: Secret(u32)): Secret(u32)
  pub fn Ct::u32_mul(a: Secret(u32), b: Secret(u32)): Secret(u32)
  pub fn Ct::u32_and(a: Secret(u32), b: Secret(u32)): Secret(u32)
  pub fn Ct::u32_or(a: Secret(u32), b: Secret(u32)): Secret(u32)
  pub fn Ct::u32_xor(a: Secret(u32), b: Secret(u32)): Secret(u32)
  pub fn Ct::u32_not(a: Secret(u32)): Secret(u32)
  pub fn Ct::u32_shl(a: Secret(u32), s: u64): Secret(u32)
  pub fn Ct::u32_shr(a: Secret(u32), s: u64): Secret(u32)
  pub fn Ct::u32_rotl(a: Secret(u32), s: u64): Secret(u32)
  pub fn Ct::u32_rotr(a: Secret(u32), s: u64): Secret(u32)
  pub fn Ct::u32_eq(a: Secret(u32), b: Secret(u32)): Secret(Bool)
  pub fn Ct::u32_lt(a: Secret(u32), b: Secret(u32)): Secret(Bool)
  pub fn Ct::u32_select(c: Secret(Bool), a: Secret(u32), b: Secret(u32)): Secret(u32)
  pub fn Ct::u64_add(a: Secret(u64), b: Secret(u64)): Secret(u64)
  pub fn Ct::u64_sub(a: Secret(u64), b: Secret(u64)): Secret(u64)
  pub fn Ct::u64_mul(a: Secret(u64), b: Secret(u64)): Secret(u64)
  pub fn Ct::u64_and(a: Secret(u64), b: Secret(u64)): Secret(u64)
  pub fn Ct::u64_or(a: Secret(u64), b: Secret(u64)): Secret(u64)
  pub fn Ct::u64_xor(a: Secret(u64), b: Secret(u64)): Secret(u64)
  pub fn Ct::u64_not(a: Secret(u64)): Secret(u64)
  pub fn Ct::u64_shl(a: Secret(u64), s: u64): Secret(u64)
  pub fn Ct::u64_shr(a: Secret(u64), s: u64): Secret(u64)
  pub fn Ct::u64_rotl(a: Secret(u64), s: u64): Secret(u64)
  pub fn Ct::u64_rotr(a: Secret(u64), s: u64): Secret(u64)
  pub fn Ct::u64_eq(a: Secret(u64), b: Secret(u64)): Secret(Bool)
  pub fn Ct::u64_lt(a: Secret(u64), b: Secret(u64)): Secret(Bool)
  pub fn Ct::u64_select(c: Secret(Bool), a: Secret(u64), b: Secret(u64)): Secret(u64)
  pub fn Ct::u64_mul_hi(a: Secret(u64), b: Secret(u64)): Secret(u64)
}

// Changes of width: a wider word holds the narrower one, a narrower word
// keeps the low bits.
extern {
  pub fn Ct::u64_of_u8(a: Secret(u8)): Secret(u64)
  pub fn Ct::u64_of_u32(a: Secret(u32)): Secret(u64)
  pub fn Ct::u32_of_u8(a: Secret(u8)): Secret(u32)
  pub fn Ct::u8_of_u32(a: Secret(u32)): Secret(u8)
  pub fn Ct::u8_of_u64(a: Secret(u64)): Secret(u8)
  pub fn Ct::u32_of_u64(a: Secret(u64)): Secret(u32)
}

extern {
  pub fn Ct::bool_and(a: Secret(Bool), b: Secret(Bool)): Secret(Bool)
  pub fn Ct::bool_or(a: Secret(Bool), b: Secret(Bool)): Secret(Bool)
  pub fn Ct::bool_not(a: Secret(Bool)): Secret(Bool)
  pub fn Ct::bool_select(c: Secret(Bool), a: Secret(Bool), b: Secret(Bool)): Secret(Bool)
}

// A secret byte string, such as what `secure_random` gives, one byte at a
// time. Its length is public and so is the index; the byte stays secret.
extern {
  pub fn Ct::bytes_len(s: Secret(Bytes)): u64
  pub fn Ct::bytes_get(s: Secret(Bytes), i: u64): Option(Secret(u8))
}
