// The values a syntax makes.
// A syntax's own types are named `<syntax>_<Name>` and made from its grammar;
// these are the parts every one of them shares.

// Where a node was written: the number is a position in the file, as written.
// The origin of a node a macro makes is in `docs/design/macro.md`「Spans and origins」.
pub(open) struct SynSpan { id: u64 }

// The scopes a name carries (hygiene); empty outside macros.
pub(open) struct SynCtx { scopes: List(u64) }

pub(open) struct SynToken { text: Text, span: SynSpan, ctx: SynCtx }

// A token of a syntax's text as the functions registered with `syntax s … with fmt f, tokens g`
// read it: the terminal's name, the text, the bytes it covers (from 0, in the text) and whether
// the grammar skips it (white space and comments are tokens here).
pub(open) struct SynTok { kind: Text, text: Text, start: u64, end: u64, skipped: Bool }

// The lossless tree of a syntax's text: a node is a non-terminal of the grammar with the tokens
// and nodes it holds in order, skipped tokens included, and the bytes it covers.
pub(open) enum SynCst {
  CstNode(Text, List(SynCst), u64, u64)
  CstTok(SynTok)
}

// A part of a syntax's text (bytes from 0) and what an editor colours it as: one of the kinds of
// the language server's legend (`keyword`, `number`, `string`, `variable`, `comment`, `operator`, `type`, …).
pub(open) struct SynHighlight { start: u64, end: u64, kind: Text }

// Why a text is not of a syntax, or what a macro objects to: the message, the
// byte it stopped at, the terminals that would have been taken there, the
// code a tool shows (`macro.error` for a macro's own), and the arguments of the
// message. A macro's own message is its text, with no arguments. A syntax error
// (`macro.syntax_error`) is a message of the tools: `message` is its id and
// `args` its arguments, and a tool writes it in the language it is set to.
pub(open) struct SynDiag {
  message: Text,
  at: u64,
  expected: List(Text),
  code: Text,
  args: List(SynArg)
}

// An argument of a message: its name and value. A name may come more than once,
// as `expected` does for each terminal that would have been taken.
pub(open) struct SynArg { name: Text, value: Text }

extern { type SynDeclaration }

pub(open) struct SynIdent {
  name: Text,
  ctx: SynCtx,
  span: SynSpan,
  declaration: Option(SynDeclaration)
}

// A binder: a name or an atom of a `Judgement`, the type when written, and
// where `^` marks an unused assertion on a named binder (none when absent).
pub(open) enum SynBinder {
  BName(SynIdent, Option(SynExpr), Option(SynSpan))
  BAtom(u64, Option(SynExpr))
}

// A parameter of a function type; it has a name when the result mentions it.
// `unused` is where `^` marks an unused assertion on that name (none when absent).
pub(open) struct SynParam { name: Option(SynIdent), ty: SynExpr, unused: Option(SynSpan) }

// An entry of an effect row: an effect or a row variable (`|e`) by its
// name, or an effect applied to its type arguments (`res(Pos)`), for every
// instance when the flag is set (`∀ A. res(A)`, with its names). The last
// field is where `^` marks the entry as declared but not performed (none when
// absent), as it does on a binder or a parameter.
pub(open) enum SynRowEntry {
  EffName(Text, Option(SynSpan))
  EffApplied(Text, List(SynExpr), Bool, List(Text), Option(SynSpan))
}

// An expression or a type, one constructor for each kind of term of the
// surface syntax (`TermKind` in `crates/tauto-surface/src/surface.rs`;
// `crates/tauto-surface/src/macros/syn.rs` turns each into the other). There is no
// unread syntax: a macro cannot make it. A hole is `?name`; a tactic leaves its goals as `?arm1`, `?arm2`, …
pub(open) enum SynExpr {
  ExVar(SynIdent)
  ExAtom(u64, SynSpan)
  ExNat(Text, SynSpan)
  ExText(Text, SynSpan)
  // A Float literal as written, `0.5`; the text is the digits, so it reads back unchanged.
  ExFloat(Text, SynSpan)
  ExBool(Bool, SynSpan)
  ExApp(SynExpr, List(SynExpr), SynSpan)
  ExPi(List(SynParam), SynExpr, Option(List(SynRowEntry)), SynSpan)
  ExLam(List(SynBinder), SynExpr, SynSpan)
  ExIf(SynExpr, SynExpr, Option(SynExpr), SynSpan)
  ExField(SynExpr, Text, SynSpan)
  ExBlock(List(SynStmt), SynSpan)
  ExPerform(SynIdent, List(SynExpr), SynSpan)
  ExHandle(SynExpr, List(SynHandler), SynSpan)
  ExBudget(SynExpr, SynExpr, SynSpan)
  ExBudgetMemory(SynExpr, SynExpr, SynSpan)
  // The Option(SynSpan) after the eqn binder is where `^` was written on it.
  ExMatch(SynExpr, Option(SynExpr), List(SynArm), Option(SynIdent), Option(SynSpan), SynSpan)
  ExRecord(SynIdent, List(SynExpr × Text), SynSpan)
  ExBorrow(Bool, SynExpr, SynSpan)
  ExUnion(List(SynExpr), SynSpan)
  ExProduct(List(SynExpr), SynSpan)
  ExTagged(Text, SynExpr, SynSpan)
  ExExists(SynBinder, SynExpr, SynExpr, SynSpan)
  ExFnKind(Text, SynExpr, SynSpan)
  ExBorrowLam(List(Option(Bool)), SynExpr, SynSpan)
  ExMacroCall(SynIdent, Text, SynSpan)
  // A call whose argument is an expression (an untyped or a typed macro).
  ExMacroExpr(SynIdent, SynExpr, SynSpan)
  // A step `by t!(arg): G0 { Δ ⊢ G from p … }` (`docs/design/macro-steps.md`):
  // the tactic, its argument, the goal before it (`None` where the step is the
  // whole proof of an arm) and the arms.
  ExStep(SynIdent, SynExpr, Option(SynExpr), List(SynStepArm), SynSpan)
  ExHole(Text, SynSpan)
  ExUnit(SynSpan)
}

pub(open) enum SynPattern {
  PtWild
  // The second field is where `^` was written on the bind, when marked unused.
  PtBind(SynIdent, Option(SynSpan))
  PtInt(i64)
  PtBool(Bool)
  PtText(Text)
  PtCtor(SynIdent, List(SynPattern))
  PtRecord(SynIdent, List(SynPattern × Text))
}

// An arm of a step: `Δ ⊢ goal from body`.
pub(open) struct SynStepArm { binders: List(SynBinder), goal: SynExpr, body: SynExpr }

pub(open) struct SynArm {
  pattern: SynPattern,
  guard: Option(SynExpr),
  goal: Option(SynExpr),
  body: SynExpr
}

pub(open) enum SynHandler {
  HReturn(SynPattern, SynExpr)
  // The last fields are the instance the arm answers: the names `∀` binds
  // and the type arguments (`∀ A. show<A>`: `A`, `A`), both empty when none
  // is written.
  // After the continuation name, Option(SynSpan) is where `^` was written on it.
  HOp(
    SynIdent,
    List(SynPattern),
    Option(SynIdent),
    Option(SynSpan),
    Option(SynExpr),
    SynExpr,
    List(Text),
    List(SynExpr)
  )
}

pub(open) struct SynFn {
  name: SynIdent
  generics: List(Text)
  generic_types: List(SynExpr)
  bounds: List(Option(Text))
  params: List(SynIdent)
  r#borrows: List(Option(Bool))
  param_types: List(Option(SynExpr))
  result: Option(SynExpr)
  effects: Option(List(SynRowEntry))
  // The `where C(T)` constraints the fn's signature carries.
  where_: List(SynConstraint)
  body: SynExpr
  span: SynSpan
  // Where `^` marks the function name unused, when written.
  unused: Option(SynSpan)
  // Where `^` marks each type parameter unused, aligned with `generics` (empty when none).
  unused_generics: List(Option(SynSpan))
  // Where `^` marks each parameter unused, aligned with `params` (empty when none).
  unused_params: List(Option(SynSpan))
}

pub(open) struct SynTheorem {
  name: SynIdent
  implicit: u64
  params: List(SynExpr × SynIdent)
  ty: SynExpr
  body: Option(SynExpr)
  span: SynSpan
  // Where `^` marks the declaration name unused, when written.
  unused: Option(SynSpan)
  // Where `^` marks each parameter unused, aligned with `params` (empty when none).
  unused_params: List(Option(SynSpan))
}

pub(open) struct SynCtor { name: SynIdent, fields: List(Option(SynIdent) × SynExpr) }

// A constructor of an `inductive` family: its generics come first among `params`
// (the first `implicit` of them), and `result` is the family applied to its indices.
pub(open) struct SynIndCtor {
  name: SynIdent
  implicit: u64
  params: List(SynExpr × SynIdent)
  result: SynExpr
}

pub(open) struct SynInductive {
  name: SynIdent
  params: List(SynExpr × SynIdent)
  sort: SynExpr
  ctors: List(SynIndCtor)
  span: SynSpan
}

pub(open) struct SynData {
  kind: Option(Text)
  name: SynIdent
  generics: List(Text)
  ctors: List(SynCtor)
  span: SynSpan
  // Where `^` marks each type parameter unused, aligned with `generics` (empty when none).
  unused_generics: List(Option(SynSpan))
}

pub(open) struct SynEffect {
  name: SynIdent
  generics: List(Text)
  params: List(Option(SynExpr))
  result: Option(SynExpr)
  r#resume: Option(Text)
  span: SynSpan
  // Where `^` marks each type parameter unused, aligned with `generics` (empty when none).
  unused_generics: List(Option(SynSpan))
}

// `class C(A: Type) { fn m(…): R … }`: a method has no body (`body` is `()`).
// `bound` is the parameter kind, `laws` the law items, and `parents` the class header constraints.
pub(open) struct SynClass {
  name: SynIdent
  params: List(SynExpr × SynIdent)
  bound: Option(Text)
  methods: List(SynFn)
  laws: List(SynTheorem)
  is_inductive: Bool
  span: SynSpan
  parents: List(SynConstraint)
  // Where `^` marks each class parameter unused, aligned with `params` (empty when none).
  unused_parameters: List(Option(SynSpan))
}

// A `where C(T)` of an instance: `ty` is `T`, and `arguments` follow it.
pub(open) struct SynConstraint {
  class_name: SynIdent
  ty: SynExpr
  arguments: List(SynExpr)
}

// `instance C(T) { fn m(…) … }`: `head` is `T`, and `arguments` are the class
// arguments after it.
pub(open) enum SynInferCondition {
  InferParameter(Text)
  InferAnd(SynInferCondition, SynInferCondition)
  InferOr(SynInferCondition, SynInferCondition)
}

pub(open) struct SynInstance {
  class_name: SynIdent
  generics: List(Text)
  generic_types: List(SynExpr)
  bounds: List(Option(Text))
  arguments: List(SynExpr)
  head: SynExpr
  infer_from: Option(SynInferCondition)
  where_: List(SynConstraint)
  methods: List(SynFn)
  laws: List(SynTheorem)
  span: SynSpan
  // Where `^` marks each type parameter unused, aligned with `generics` (empty when none).
  unused_generics: List(Option(SynSpan))
}

pub(open) enum SynStmt {
  // The sixth field is where `^` marks the binding unused (none when absent).
  StLet(SynIdent, Option(SynExpr), SynExpr, Bool, Bool, Option(SynSpan), SynSpan)
  StVar(SynIdent, Option(SynExpr), SynExpr, Bool, Option(SynSpan), SynSpan)
  StAssign(SynIdent, SynExpr, SynSpan)
  StFn(SynFn)
  StExpr(SynExpr)
  StWhile(SynExpr, SynExpr)
  StReturn(Option(SynExpr))
  StTheorem(SynTheorem)
  StDef(SynTheorem)
  StStruct(SynData)
  StEnum(SynData)
  StInductive(SynInductive)
  StEffect(SynEffect)
  StClass(SynClass)
  StInstance(SynInstance)
  StMutual(List(SynStmt), SynSpan)
  StModule(SynIdent, Bool, List(SynStmt), List(Text), SynSpan)
  StReexport(SynIdent, List(SynIdent), SynSpan)
  StMacroCall(SynIdent, Text, SynSpan)
}

// What a macro objects to (`macro_error`) and what it only remarks on
// (`macro_warn`). An error does not return.
pub(open) effect macro_error(d: SynDiag): Never resume 0
pub(open) effect macro_warn(d: SynDiag): Unit resume 1

pub fn Syn::error(at: SynSpan, message: Text): Never ! {macro_error} {
  perform macro_error(
    SynDiag { message: message, at: at.id, expected: Nil, code: "macro.error", args: Nil }
  )
}

// Where the macro is called: for an attribute macro, the attribute. An
// error at it points at the call.
pub fn Syn::call_span(): SynSpan {
  SynSpan { id: 0 }
}

pub fn Syn::ident(t: SynToken): SynIdent {
  SynIdent { declaration: None, name: t.text, ctx: t.ctx, span: t.span }
}

// A name that borrows the scopes of `model`: the way to capture a local of the
// caller, such as the `it` of an anaphoric macro
// (`docs/design/macro.md`「Hygiene (scope sets)」, 6).
pub fn Syn::ident_like(model: SynIdent, name: Text): SynIdent {
  SynIdent { declaration: None, name: name, ctx: model.ctx, span: model.span }
}

// The name of a declaration a macro makes for the caller to use (the
// `T_take` of `@derive!`), with the scopes of `model`: the caller sees the
// declaration (`docs/design/macro.md`「Hygiene (scope sets)」, 7). It is what
// `Syn::ident_like` is, written for a declaration's name; the lint
// `macro-capture` does not take it for a capture.
pub fn Syn::decl_name(model: SynIdent, name: Text): SynIdent {
  SynIdent { declaration: None, name: name, ctx: model.ctx, span: model.span }
}

// A name of the macro's own tote, as a `quote` writes it: it means the
// declaration the macro's tote sees (`Cons`, a lemma of the library), and no
// local of the caller takes it.
extern {
  pub fn Syn::global(name: Text): SynIdent
  pub fn Syn::same_declaration(a: SynDeclaration, b: SynDeclaration): Bool
  // The eliminator (`T::ind`) of the inductive type `d`, found by its
  // declaration and not by its name: it is the same wherever `T` is declared.
  pub fn Syn::eliminator(d: SynDeclaration): SynDeclaration
}

pub fn Syn::all_digits(t: Text, i: u64): Bool ! {div} {
  if i >= Text::len(&t) {
    true
  } else {
    match Text::byte(&t, i) {
      // `i < Text::len(t)`, so `i + 1` fits.
      Some(b) => if b >= 48 && b <= 57 {
        Syn::all_digits(t, handle { i + 1 } with { overflow() => i })
      } else { false }
      None => false
    }
  }
}

pub fn Syn::nat(t: SynToken): SynExpr ! {macro_error, div} {
  if Text::len(&t.text) > 0 && Syn::all_digits(t.text, 0) {
    ExNat(t.text, t.span)
  } else {
    Syn::error(t.span, concat("not a number: ", t.text))
  }
}

// A value known when the macro runs, as syntax: the one way to carry it to the run time.
pub fn Syn::lift_i64(n: i64, at: SynSpan): SynExpr ! {overflow} {
  if n < 0 {
    ExApp(
      ExVar(SynIdent { declaration: None, name: "-", ctx: SynCtx { scopes: Nil }, span: at }),
      Cons(ExNat(Text::of_i64(0 - n), at), Nil),
      at
    )
  } else {
    ExNat(Text::of_i64(n), at)
  }
}

pub fn Syn::lift_u64(n: u64, at: SynSpan): SynExpr { ExNat(Text::of_u64(n), at) }
pub fn Syn::lift_text(t: Text, at: SynSpan): SynExpr { ExText(t, at) }
pub fn Syn::lift_bool(b: Bool, at: SynSpan): SynExpr { ExBool(b, at) }

// The items of `a`, then those of `b`: what `$list` in a `quote stmts` is.
pub fn Syn::append<T>(a: List(T), b: List(T)): List(T) {
  match a {
    Nil => b
    Cons(x, rest) => Cons(x, Syn::append(rest, b))
  }
}

// ---------------------------------------------------------------------------
// Typed terms. A `Judgement` is what the
// checker saw of an expression: it is made by the host, and what a macro makes
// of it is checked again, so nothing here is trusted.

pub(open) struct Judgement::Binder { atom: u64, name: Text, ty: SynExpr }

// How the term uses a variable of the context: `moved`, `borrowed`,
// `borrowed_mut` or `unused`.
pub(open) struct Judgement::Use { atom: u64, how: Text }

// `ctx |- term : ty ! row`. `tys` holds the type of the subterms by their span.
// `generics` are the type parameters and the row variable (`!e`) that `ty`
// and `row` mention, written as a `fn` writes them: the type of a generic
// `fn` is its signature over them.
pub(open) struct Judgement {
  term: SynExpr
  ty: SynExpr
  row: List(Text)
  generics: List(Text)
  ctx: List(Judgement::Binder)
  fragment: Text
  tys: List(SynExpr × u64)
  usage: List(Judgement::Use)
  span: SynSpan
}

// A step of a proof, `by t!(arg): G0 { Δ ⊢ G from p … }`. A macro whose
// function takes a `ProofStep` is a tactic, called only after `by`. `before`
// is the goal written, as a `Judgement` (its term is the goal, its context the
// variables in scope); `arg` is what the call
// has in its parentheses, not checked; `after` are the goals written in the
// arms, in order, or `Nil` when a tool asks the tactic which goals it leaves.
// The tactic makes a term of `before` with a hole `?armK` for the goal of the
// K-th arm; each hole is under binders for the variables of its arm, by their
// atoms (`BAtom`).
pub(open) struct ProofStep { before: Judgement, arg: SynExpr, after: List(StepGoal), span: SynSpan }

// A goal of an arm: the variables it adds (each atom new, its type written
// in the context of the ones before) and the goal, in the context with them.
pub(open) struct StepGoal { binders: List(Judgement::Binder), ty: Judgement }

// The hole of the goal of the K-th arm, from 1.
pub fn Syn::hole(k: u64, at: SynSpan): SynExpr { ExHole(concat("arm", Text::of_u64(k)), at) }

// `Nat::add` and `Nat::mul` as the operators `+` and `*` they are written as: the same
// functions, so a name is compared by this.
pub fn Syn::op_name(name: Text): Text {
  if name == "Nat::add" {
    "+"
  } else if name == "Nat::mul" { "*" } else { name }
}

// Whether two expressions are written the same, apart from where they are and
// the scopes their names carry: what a tactic compares goals by. Resolved names
// are compared by declaration identity, unresolved names by their text, and
// atoms by their number; a form with binders, by its
// binders' names and types and its body. Only names, atoms, numerals, texts,
// booleans, applications, function types, functions `x => …`, `∃` and holes
// are compared; two expressions of any other form are not the same.
pub fn Syn::same_ident(a: SynIdent, b: SynIdent): Bool {
  match a.declaration {
    Some(x) => match b.declaration {
      Some(y) => Syn::same_declaration(x, y)
      None => false
    }
    None => match b.declaration {
      Some(_) => false
      None => Syn::op_name(a.name) == Syn::op_name(b.name)
    }
  }
}

pub fn Syn::same(a: SynExpr, b: SynExpr): Bool ! {div} {
  match a {
    ExVar(x) => match b {
      ExVar(y) => Syn::same_ident(x, y)
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExLam(_, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
      ExMatch(_, _, _, _, _, _) => false
      ExRecord(_, _, _) => false
      ExBorrow(_, _, _) => false
      ExUnion(_, _) => false
      ExProduct(_, _) => false
      ExTagged(_, _, _) => false
      ExExists(_, _, _, _) => false
      ExFnKind(_, _, _) => false
      ExBorrowLam(_, _, _) => false
      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExAtom(n, _) => match b {
      ExAtom(m, _) => n == m
      ExVar(_) => false
      ExNat(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExLam(_, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
      ExMatch(_, _, _, _, _, _) => false
      ExRecord(_, _, _) => false
      ExBorrow(_, _, _) => false
      ExUnion(_, _) => false
      ExProduct(_, _) => false
      ExTagged(_, _, _) => false
      ExExists(_, _, _, _) => false
      ExFnKind(_, _, _) => false
      ExBorrowLam(_, _, _) => false
      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExNat(n, _) => match b {
      ExNat(m, _) => n == m
      ExVar(_) => false
      ExAtom(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExLam(_, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
      ExMatch(_, _, _, _, _, _) => false
      ExRecord(_, _, _) => false
      ExBorrow(_, _, _) => false
      ExUnion(_, _) => false
      ExProduct(_, _) => false
      ExTagged(_, _, _) => false
      ExExists(_, _, _, _) => false
      ExFnKind(_, _, _) => false
      ExBorrowLam(_, _, _) => false
      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExText(n, _) => match b {
      ExText(m, _) => n == m
      ExFloat(_, _) => false
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExLam(_, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
      ExMatch(_, _, _, _, _, _) => false
      ExRecord(_, _, _) => false
      ExBorrow(_, _, _) => false
      ExUnion(_, _) => false
      ExProduct(_, _) => false
      ExTagged(_, _, _) => false
      ExExists(_, _, _, _) => false
      ExFnKind(_, _, _) => false
      ExBorrowLam(_, _, _) => false
      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExFloat(n, _) => match b {
      ExFloat(m, _) => n == m
      ExText(_, _) => false
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExLam(_, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
      ExMatch(_, _, _, _, _, _) => false
      ExRecord(_, _, _) => false
      ExBorrow(_, _, _) => false
      ExUnion(_, _) => false
      ExProduct(_, _) => false
      ExTagged(_, _, _) => false
      ExExists(_, _, _, _) => false
      ExFnKind(_, _, _) => false
      ExBorrowLam(_, _, _) => false
      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExBool(n, _) => match b {
      ExBool(m, _) => n == m
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExLam(_, _, _) => false
