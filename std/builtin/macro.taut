      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExPi(ps, r, _, _) => match b {
      ExPi(qs, t, _, _) => Syn::same_params(ps, qs) && Syn::same(r, t)
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExLam(_, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
      ExMatch(_, _, _, _, _, _) => false
      ExRecord(_, _, _) => false
      ExBorrow(_, _, _) => false
      ExUnion(_, _) => false
      ExProduct(_, _) => false
      ExTagged(_, _, _) => false
      ExExists(_, _, _, _) => false
      ExFnKind(_, _, _) => false
      ExBorrowLam(_, _, _) => false
      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExLam(bs, body, _) => match b {
      ExLam(cs, body2, _) => Syn::same_binders(bs, cs) && Syn::same(body, body2)
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
      ExMatch(_, _, _, _, _, _) => false
      ExRecord(_, _, _) => false
      ExBorrow(_, _, _) => false
      ExUnion(_, _) => false
      ExProduct(_, _) => false
      ExTagged(_, _, _) => false
      ExExists(_, _, _, _) => false
      ExFnKind(_, _, _) => false
      ExBorrowLam(_, _, _) => false
      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExExists(x, d, body, _) => match b {
      ExExists(y, d2, body2, _) => Syn::same_binders(
        Cons(x, Nil),
        Cons(y, Nil)
      ) && Syn::same(d, d2) && Syn::same(body, body2)
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExLam(_, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
      ExMatch(_, _, _, _, _, _) => false
      ExRecord(_, _, _) => false
      ExBorrow(_, _, _) => false
      ExUnion(_, _) => false
      ExProduct(_, _) => false
      ExTagged(_, _, _) => false
