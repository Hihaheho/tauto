      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExApp(f, xs, _) => match b {
      ExApp(g, ys, _) => Syn::same(f, g) && Syn::same_all(xs, ys)
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
