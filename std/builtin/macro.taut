    ExTagged(_, _, _) => false
    ExFnKind(_, _, _) => false
    ExBorrowLam(_, _, _) => false
    ExMacroCall(_, _, _) => false
    ExMacroExpr(_, _, _) => false
    ExStep(_, _, _, _, _) => false
    ExUnit(_) => match b {
      ExUnit(_) => true
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
