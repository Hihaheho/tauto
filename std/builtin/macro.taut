// One step into a term; the parts are `Judgement` too.
pub(open) enum CodeView {
  VAtom(u64)
  VConst(Text)
  VInt(Text)
  VText(Text)
  VBool(Bool)
  VApp(Judgement, List(Judgement))
  VIf(Judgement, Judgement, Option(Judgement))
  VField(Judgement, Text)
  // A `λ` with its first binder opened: the atom the binder is now, the binder's
  // type, and the body in a context that has the atom.
  VLam(u64, Judgement, Judgement)
  VOther(Judgement)
}

pub fn Judgement::term(c: Judgement): SynExpr { c.term }
pub fn Judgement::row(c: Judgement): List(Text) { c.row }
pub fn Judgement::generics(c: Judgement): List(Text) { c.generics }
pub fn Judgement::ctx(c: Judgement): List(Judgement::Binder) { c.ctx }
pub fn Judgement::fragment(c: Judgement): Text { c.fragment }
pub fn Judgement::span(c: Judgement): SynSpan { c.span }
pub fn Judgement::usage(c: Judgement): List(Judgement::Use) { c.usage }

pub fn Judgement::ty_of(c: Judgement, ty: SynExpr): Judgement {
  Judgement {
    term: ty
    ty: ExVar(
      SynIdent { declaration: None, name: "Type", ctx: SynCtx { scopes: Nil }, span: c.span }
    )
    row: Nil
    generics: c.generics
    ctx: c.ctx
    fragment: c.fragment
    tys: c.tys
    usage: c.usage
    span: c.span
  }
}

pub fn Judgement::type_of(c: Judgement): Judgement {
  Judgement {
    term: c.ty
    ty: ExVar(
      SynIdent { declaration: None, name: "Type", ctx: SynCtx { scopes: Nil }, span: c.span }
    )
    row: Nil
    generics: c.generics
    ctx: c.ctx
    fragment: c.fragment
    tys: c.tys
    usage: c.usage
    span: c.span
  }
}

pub fn Judgement::lookup(tys: List(SynExpr × u64), id: u64, other: SynExpr): SynExpr {
  match tys {
    Nil => other
    Cons(p, rest) => match p {
      #(t, k) => if k == id { t } else { Judgement::lookup(rest, id, other) }
    }
  }
}

pub fn Syn::expr_span(e: SynExpr): u64 {
  match e {
    ExVar(i) => i.span.id
    ExAtom(_, s) => s.id
    ExNat(_, s) => s.id
    ExText(_, s) => s.id
    ExFloat(_, s) => s.id
    ExBool(_, s) => s.id
    ExApp(_, _, s) => s.id
    ExPi(_, _, _, s) => s.id
    ExLam(_, _, s) => s.id
    ExIf(_, _, _, s) => s.id
    ExField(_, _, s) => s.id
    ExBlock(_, s) => s.id
    ExPerform(_, _, s) => s.id
    ExHandle(_, _, s) => s.id
    ExBudget(_, _, s) => s.id
    ExBudgetMemory(_, _, s) => s.id
    ExMatch(_, _, _, _, _, s) => s.id
    ExRecord(_, _, s) => s.id
    ExBorrow(_, _, s) => s.id
    ExUnion(_, s) => s.id
    ExProduct(_, s) => s.id
    ExTagged(_, _, s) => s.id
    ExExists(_, _, _, s) => s.id
    ExFnKind(_, _, s) => s.id
    ExBorrowLam(_, _, s) => s.id
    ExMacroCall(_, _, s) => s.id
    ExMacroExpr(_, _, s) => s.id
    ExStep(_, _, _, _, s) => s.id
    ExHole(_, s) => s.id
    ExUnit(s) => s.id
  }
}

pub fn Judgement::sub(c: Judgement, e: SynExpr): Judgement {
  let id := Syn::expr_span(e)
  Judgement {
    term: e
    ty: Judgement::lookup(
      c.tys,
      id,
      ExVar(SynIdent { declaration: None, name: "_", ctx: SynCtx { scopes: Nil }, span: c.span })
    )
    row: c.row
    generics: c.generics
    ctx: c.ctx
    fragment: c.fragment
    tys: c.tys
    usage: c.usage
    span: SynSpan { id: id }
  }
}

pub fn Judgement::subs(c: Judgement, es: List(SynExpr)): List(Judgement) {
  match es {
    Nil => Nil
    Cons(e, rest) => Cons(Judgement::sub(c, e), Judgement::subs(c, rest))
  }
}

pub fn Judgement::sub_opt(c: Judgement, e: Option(SynExpr)): Option(Judgement) {
  match e {
    None => None
    Some(x) => Some(Judgement::sub(c, x))
  }
}

pub fn Judgement::unknown(c: Judgement): SynExpr {
  ExVar(SynIdent { declaration: None, name: "_", ctx: SynCtx { scopes: Nil }, span: c.span })
}

pub fn Judgement::snoc(xs: List(Judgement::Binder), x: Judgement::Binder): List(Judgement::Binder) {
  match xs {
    Nil => Cons(x, Nil)
    Cons(h, t) => Cons(h, Judgement::snoc(t, x))
  }
}

pub fn Judgement::param_type(c: Judgement, ty: SynExpr): SynExpr {
  match ty {
    ExPi(ps, _, _, _) => match ps {
      Cons(p, _) => p.ty
      Nil => Judgement::unknown(c)
    }
    ExVar(_) => Judgement::unknown(c)
    ExAtom(_, _) => Judgement::unknown(c)
    ExNat(_, _) => Judgement::unknown(c)
    ExText(_, _) => Judgement::unknown(c)
    ExFloat(_, _) => Judgement::unknown(c)
    ExBool(_, _) => Judgement::unknown(c)
    ExApp(_, _, _) => Judgement::unknown(c)
    ExLam(_, _, _) => Judgement::unknown(c)
    ExIf(_, _, _, _) => Judgement::unknown(c)
    ExField(_, _, _) => Judgement::unknown(c)
    ExBlock(_, _) => Judgement::unknown(c)
    ExPerform(_, _, _) => Judgement::unknown(c)
    ExHandle(_, _, _) => Judgement::unknown(c)
    ExBudget(_, _, _) => Judgement::unknown(c)
    ExBudgetMemory(_, _, _) => Judgement::unknown(c)
    ExMatch(_, _, _, _, _, _) => Judgement::unknown(c)
    ExRecord(_, _, _) => Judgement::unknown(c)
    ExBorrow(_, _, _) => Judgement::unknown(c)
    ExUnion(_, _) => Judgement::unknown(c)
    ExProduct(_, _) => Judgement::unknown(c)
    ExTagged(_, _, _) => Judgement::unknown(c)
    ExExists(_, _, _, _) => Judgement::unknown(c)
    ExFnKind(_, _, _) => Judgement::unknown(c)
    ExBorrowLam(_, _, _) => Judgement::unknown(c)
    ExMacroCall(_, _, _) => Judgement::unknown(c)
    ExMacroExpr(_, _, _) => Judgement::unknown(c)
    ExStep(_, _, _, _, _) => Judgement::unknown(c)
    ExHole(_, _) => Judgement::unknown(c)
    ExUnit(_) => Judgement::unknown(c)
  }
}

pub fn Judgement::result_type(c: Judgement, ty: SynExpr): SynExpr {
  match ty {
    ExPi(ps, r, _, _) => match ps {
      Cons(_, rest) => match rest {
        Nil => r
        Cons(_, _) => Judgement::unknown(c)
      }
      Nil => Judgement::unknown(c)
    }
    ExVar(_) => Judgement::unknown(c)
    ExAtom(_, _) => Judgement::unknown(c)
    ExNat(_, _) => Judgement::unknown(c)
    ExText(_, _) => Judgement::unknown(c)
    ExFloat(_, _) => Judgement::unknown(c)
    ExBool(_, _) => Judgement::unknown(c)
    ExApp(_, _, _) => Judgement::unknown(c)
    ExLam(_, _, _) => Judgement::unknown(c)
    ExIf(_, _, _, _) => Judgement::unknown(c)
    ExField(_, _, _) => Judgement::unknown(c)
    ExBlock(_, _) => Judgement::unknown(c)
    ExPerform(_, _, _) => Judgement::unknown(c)
    ExHandle(_, _, _) => Judgement::unknown(c)
    ExBudget(_, _, _) => Judgement::unknown(c)
    ExBudgetMemory(_, _, _) => Judgement::unknown(c)
    ExMatch(_, _, _, _, _, _) => Judgement::unknown(c)
    ExRecord(_, _, _) => Judgement::unknown(c)
    ExBorrow(_, _, _) => Judgement::unknown(c)
    ExUnion(_, _) => Judgement::unknown(c)
    ExProduct(_, _) => Judgement::unknown(c)
    ExTagged(_, _, _) => Judgement::unknown(c)
    ExExists(_, _, _, _) => Judgement::unknown(c)
    ExFnKind(_, _, _) => Judgement::unknown(c)
    ExBorrowLam(_, _, _) => Judgement::unknown(c)
    ExMacroCall(_, _, _) => Judgement::unknown(c)
    ExMacroExpr(_, _, _) => Judgement::unknown(c)
    ExStep(_, _, _, _, _) => Judgement::unknown(c)
    ExHole(_, _) => Judgement::unknown(c)
    ExUnit(_) => Judgement::unknown(c)
  }
}

pub fn Judgement::lam_view(
  c: Judgement,
  bs: List(SynBinder),
  body: SynExpr,
  sp: SynSpan
): CodeView ! {overflow} {
  match bs {
    Nil => VOther(c)
    Cons(b, rest) => match b {
      BAtom(_, _) => VOther(c)
      BName(id, ann, _) => {
        // Apart from the host's atoms, which count from 1; the binder's
        // position keeps the atoms of two binders apart.
        let atom := 1000000000 + id.span.id
        let inner := match rest {
          Nil => body
          Cons(_, _) => ExLam(rest, body, sp)
        }
        match Syn::open(inner, id.name, atom) {
          None => VOther(c)
          Some(opened) => {
            let pty := match ann {
              Some(t) => t
              None => Judgement::param_type(c, c.ty)
            }
            let binder := Judgement::Binder { atom: atom, name: id.name, ty: pty }
            let ctx := Judgement::snoc(c.ctx, binder)
            VLam(atom, Judgement::ty_of(c, pty), Judgement {
              term: opened
              ty: Judgement::result_type(c, c.ty)
              row: c.row
              generics: c.generics
              ctx: ctx
              fragment: c.fragment
              tys: c.tys
              usage: c.usage
              span: SynSpan { id: Syn::expr_span(opened) }
            })
          }
        }
      }
    }
  }
}

// The top of a term, one step; a global is `VConst`, a variable of the context
// an atom. What is not listed is `VOther`, the term as it is.
pub fn Judgement::open(c: Judgement): CodeView ! {overflow} {
  match c.term {
    ExAtom(n, _) => VAtom(n)
    ExVar(i) => VConst(i.name)
    ExNat(t, _) => VInt(t)
    ExText(t, _) => VText(t)
    ExFloat(_, _) => VOther(c)
    ExBool(b, _) => VBool(b)
    ExApp(f, args, _) => VApp(Judgement::sub(c, f), Judgement::subs(c, args))
    ExIf(a, b, d, _) => VIf(Judgement::sub(c, a), Judgement::sub(c, b), Judgement::sub_opt(c, d))
    ExField(e, name, _) => VField(Judgement::sub(c, e), name)
    // Only the binder count is added to, so the count fits; the fallback is the term itself.
    ExLam(bs, body, sp) => handle { Judgement::lam_view(c, bs, body, sp) } with { overflow() => VOther(c) }
    ExPi(_, _, _, _) => VOther(c)
    ExBlock(_, _) => VOther(c)
    ExPerform(_, _, _) => VOther(c)
    ExHandle(_, _, _) => VOther(c)
    ExBudget(_, _, _) => VOther(c)
    ExBudgetMemory(_, _, _) => VOther(c)
    ExMatch(_, _, _, _, _, _) => VOther(c)
    ExRecord(_, _, _) => VOther(c)
    ExBorrow(_, _, _) => VOther(c)
    ExUnion(_, _) => VOther(c)
    ExProduct(_, _) => VOther(c)
    ExTagged(_, _, _) => VOther(c)
    ExExists(_, _, _, _) => VOther(c)
    ExFnKind(_, _, _) => VOther(c)
    ExBorrowLam(_, _, _) => VOther(c)
    ExMacroCall(_, _, _) => VOther(c)
    ExMacroExpr(_, _, _) => VOther(c)
    ExStep(_, _, _, _, _) => VOther(c)
    ExHole(_, _) => VOther(c)
    ExUnit(_) => VOther(c)
  }
}

extern {
  // Whether the atom is in the term of the `Judgement`, and whether the term is it.
  pub fn Judgement::mentions(c: Judgement, n: u64): Bool
  pub fn Judgement::same_atom(c: Judgement, n: u64): Bool
}

// Reads a text as the syntax whose grammar has this hash. Each syntax gets
// its own `<syntax>_parse` over this one.
extern {
  pub fn Syn::parse<T>(syntax: Text, sha: Text, t: Text): Result(T, SynDiag)
  // What fills a `$name` or a `$(e)` in an expression of a `quote`: a SynExpr
  // as it is, a SynIdent as the variable it names.
  pub fn Syn::expr_of<T>(x: T): SynExpr
  // The expression with the macro calls in it expanded (outside in, as the host does
  // for the output of a macro). A macro reads an argument that holds a call, such as
  // `lc!(`…`)`, as what the call makes by asking for it.
  pub fn Syn::expand(e: SynExpr): SynExpr
  // The variable `name` of an expression as the atom, to open its binder; `None`
  // when the name is written in the expression other than as a variable.
  pub fn Syn::open(e: SynExpr, name: Text, atom: u64): Option(SynExpr)
}

// What a macro asks the checker: the externs of `Raw` under the row `elab`,
// so that only a macro, which the expander runs, asks it.
pub fn Elab::whnf(c: Judgement): Judgement ! {elab} {
  Elab::Raw::whnf(c)
}
pub fn Elab::defeq(a: Judgement, b: Judgement): Bool ! {elab} {
  Elab::Raw::defeq(a, b)
}
pub fn Elab::check(
  e: SynExpr,
  ctx: Judgement,
  ty: Option(Judgement)
): Result(Judgement, SynDiag) ! {elab} {
  Elab::Raw::check(e, ctx, ty)
}
pub fn Elab::global(name: Text): Option(Judgement) ! {elab} {
  Elab::Raw::global(name)
}
pub fn Elab::resolve(id: SynIdent, ctx: Judgement): Option(Judgement) ! {elab} {
  Elab::Raw::resolve(id, ctx)
}
pub fn Elab::siblings(name: SynIdent): Option(List(SynIdent)) ! {elab} {
  Elab::Raw::siblings(name)
}
pub fn Elab::constructor_arity(name: SynIdent): Option(u64) ! {elab} {
  Elab::Raw::constructor_arity(name)
}
pub fn Elab::implicit_names(name: SynIdent): Option(List(Text)) ! {elab} {
  Elab::Raw::implicit_names(name)
}
pub fn Elab::data(name: SynIdent): Option(SynData) ! {elab} {
  Elab::Raw::data(name)
}
pub fn Elab::class_decl(name: SynIdent): Option(SynClass) ! {elab} {
  Elab::Raw::class_decl(name)
}

extern {
  // Ask the checker: reading the
  // declarations before the one in hand, changing nothing.
  pub fn Elab::Raw::whnf(c: Judgement): Judgement
  pub fn Elab::Raw::defeq(a: Judgement, b: Judgement): Bool
  pub fn Elab::Raw::check(
    e: SynExpr,
    ctx: Judgement,
    ty: Option(Judgement)
  ): Result(Judgement, SynDiag)
  pub fn Elab::Raw::global(name: Text): Option(Judgement)
  pub fn Elab::Raw::resolve(id: SynIdent, ctx: Judgement): Option(Judgement)
  // The constructors of the type `name` is a constructor of, in order; `None` when
  // `name` is not a constructor. An attribute macro may ask it too.
  pub fn Elab::Raw::siblings(name: SynIdent): Option(List(SynIdent))
  // The constructor's field count, including its own generics but excluding
  // the parameters of its family; None for a name that is not a constructor.
  pub fn Elab::Raw::constructor_arity(name: SynIdent): Option(u64)
  // The names of the implicit parameters of the declaration `name` names, in
  // order; `None` for a name that is not a declaration. A call a macro writes
  // gives its implicit arguments by these names, `f(<x: v>)`, as the source does.
  pub fn Elab::Raw::implicit_names(name: SynIdent): Option(List(Text))
  // The `struct` or `enum` declaration of the type `name` names, as written,
  // its field types naming the declarations they name; `None` when `name`
  // names no `struct` or `enum` before the one in hand.
  pub fn Elab::Raw::data(name: SynIdent): Option(SynData)
  // The `class` declaration `name` names, as written, its method and law
  // types naming the declarations they name; `None` when `name` names no
  // `class` before the one in hand.
  pub fn Elab::Raw::class_decl(name: SynIdent): Option(SynClass)
}

// `f` applied to `args`, the first of them given by the names of the implicit
// parameters of the declaration `f` names: `List::ind(A, m, …)` is written
// `List::ind(<A: A>, m, …)`, as the source writes it. A call whose head names
// no declaration, or whose declaration takes nothing implicit, is as it is.
pub fn Elab::call(f: SynExpr, args: List(SynExpr), sp: SynSpan): SynExpr ! {elab, div} {
  let names := match Syn::ident_of(f) {
    Some(i) => match Elab::implicit_names(i) {
      Some(ns) => ns
      None => Nil
    }
    None => Nil
  }
  match Elab::named(names, args) {
    #(Nil, rest) => ExApp(f, rest, sp)
    #(fields, rest) => ExApp(
      f,
      Cons(
        ExRecord(
          SynIdent { declaration: None, name: "@implicits", ctx: SynCtx { scopes: Nil }, span: sp },
          fields,
          sp
        ),
        rest
      ),
      sp
    )
  }
}

// Each name with the argument in its place, and the arguments after them.
fn Elab::named(
  names: List(Text),
  args: List(SynExpr)
): List(SynExpr × Text) × List(SynExpr) ! {div} {
  match #(names, args) {
    #(Cons(n, ns), Cons(a, rest)) => match Elab::named(ns, rest) {
      #(fields, after) => #(Cons(#(a, n), fields), after)
    }
    _ => #(Nil, args)
  }
}

// What a macro of the kernel's fragment may return instead of a bare term: the
// term, and a proof the kernel checks that it equals the expression it
// replaces.
pub(open) struct Proved { term: SynExpr, proof: SynExpr }

// The mark of a function that reads the checker's environment (the `elab_*`
// operations): it is allowed in a macro and nowhere else a macro may run.
pub(open) effect elab(): Unit resume 1
