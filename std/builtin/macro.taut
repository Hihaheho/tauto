      ExBorrowLam(_, _, _) => false
      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
      ExUnit(_) => false
    }
    ExHole(n, _) => match b {
      ExHole(m, _) => n == m
      ExVar(_) => false
      ExAtom(_, _) => false
      ExNat(_, _) => false
      ExText(_, _) => false
      ExFloat(_, _) => false
      ExBool(_, _) => false
      ExApp(_, _, _) => false
      ExPi(_, _, _, _) => false
      ExLam(_, _, _) => false
      ExIf(_, _, _, _) => false
      ExField(_, _, _) => false
      ExBlock(_, _) => false
      ExPerform(_, _, _) => false
      ExHandle(_, _, _) => false
      ExBudget(_, _, _) => false
      ExBudgetMemory(_, _, _) => false
