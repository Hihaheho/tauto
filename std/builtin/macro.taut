      ExMacroCall(_, _, _) => false
      ExMacroExpr(_, _, _) => false
      ExStep(_, _, _, _, _) => false
      ExHole(_, _) => false
    }
  }
}

pub fn Syn::same_all(xs: List(SynExpr), ys: List(SynExpr)): Bool ! {div} {
  match xs {
    Nil => match ys {
      Nil => true
      Cons(_, _) => false
    }
    Cons(x, xr) => match ys {
      Nil => false
      Cons(y, yr) => Syn::same(x, y) && Syn::same_all(xr, yr)
    }
  }
}

pub fn Syn::same_name(a: Option(SynIdent), b: Option(SynIdent)): Bool {
  match a {
    None => match b {
      None => true
      Some(_) => false
    }
    Some(x) => match b {
      None => false
      Some(y) => Syn::same_ident(x, y)
    }
  }
}

pub fn Syn::same_params(ps: List(SynParam), qs: List(SynParam)): Bool ! {div} {
  match ps {
    Nil => match qs {
      Nil => true
      Cons(_, _) => false
    }
    Cons(p, pr) => match qs {
      Nil => false
      Cons(q, qr) => Syn::same_name(
        p.name,
        q.name
      ) && Syn::same(p.ty, q.ty) && Syn::same_params(pr, qr)
    }
  }
}

pub fn Syn::same_ty(a: Option(SynExpr), b: Option(SynExpr)): Bool ! {div} {
  match a {
    None => match b {
      None => true
      Some(_) => false
    }
    Some(x) => match b {
      None => false
      Some(y) => Syn::same(x, y)
    }
  }
}

pub fn Syn::same_binders(bs: List(SynBinder), cs: List(SynBinder)): Bool ! {div} {
  match bs {
    Nil => match cs {
      Nil => true
      Cons(_, _) => false
    }
    Cons(b, br) => match cs {
      Nil => false
      Cons(c, cr) => {
        let same := match b {
          BName(x, t, _) => match c {
            BName(y, u, _) => Syn::same_ident(x, y) && Syn::same_ty(t, u)
            BAtom(_, _) => false
          }
          BAtom(n, t) => match c {
            BAtom(m, u) => n == m && Syn::same_ty(t, u)
            BName(_, _, _) => false
          }
        }
        same && Syn::same_binders(br, cr)
      }
    }
  }
}

// `a` with `z` where `a` has `l` and `b` has `r`, the two being written the same
// elsewhere: the body of the motive that turns `b` into `a`. Only applications
// are looked into; `None` when `a` and `b` differ otherwise.
pub fn Syn::abstract(
  a: SynExpr,
  b: SynExpr,
  l: SynExpr,
  r: SynExpr,
  z: SynExpr
): Option(SynExpr) ! {div} {
  if Syn::same(a, b) {
    Some(a)
  } else if Syn::same(a, l) && Syn::same(b, r) {
    Some(z)
  } else {
    match a {
      ExApp(f, xs, sp) => match b {
        ExApp(g, ys, _) => match Syn::abstract(f, g, l, r, z) {
          Some(f2) => match Syn::abstract_all(xs, ys, l, r, z) {
            Some(zs) => Some(ExApp(f2, zs, sp))
            None => None
          }
          None => None
        }
        ExVar(_) => None
        ExAtom(_, _) => None
        ExNat(_, _) => None
        ExText(_, _) => None
        ExFloat(_, _) => None
        ExBool(_, _) => None
        ExPi(_, _, _, _) => None
        ExLam(_, _, _) => None
        ExIf(_, _, _, _) => None
        ExField(_, _, _) => None
        ExBlock(_, _) => None
        ExPerform(_, _, _) => None
        ExHandle(_, _, _) => None
        ExBudget(_, _, _) => None
        ExBudgetMemory(_, _, _) => None
        ExMatch(_, _, _, _, _, _) => None
        ExRecord(_, _, _) => None
        ExBorrow(_, _, _) => None
        ExUnion(_, _) => None
        ExProduct(_, _) => None
        ExTagged(_, _, _) => None
        ExExists(_, _, _, _) => None
        ExFnKind(_, _, _) => None
        ExBorrowLam(_, _, _) => None
        ExMacroCall(_, _, _) => None
        ExMacroExpr(_, _, _) => None
        ExStep(_, _, _, _, _) => None
        ExHole(_, _) => None
        ExUnit(_) => None
      }
      ExVar(_) => None
      ExAtom(_, _) => None
      ExNat(_, _) => None
      ExText(_, _) => None
      ExFloat(_, _) => None
      ExBool(_, _) => None
      ExPi(_, _, _, _) => None
      ExLam(_, _, _) => None
      ExIf(_, _, _, _) => None
      ExField(_, _, _) => None
      ExBlock(_, _) => None
      ExPerform(_, _, _) => None
      ExHandle(_, _, _) => None
      ExBudget(_, _, _) => None
      ExBudgetMemory(_, _, _) => None
      ExMatch(_, _, _, _, _, _) => None
      ExRecord(_, _, _) => None
      ExBorrow(_, _, _) => None
      ExUnion(_, _) => None
      ExProduct(_, _) => None
      ExTagged(_, _, _) => None
      ExExists(_, _, _, _) => None
      ExFnKind(_, _, _) => None
      ExBorrowLam(_, _, _) => None
      ExMacroCall(_, _, _) => None
      ExMacroExpr(_, _, _) => None
      ExStep(_, _, _, _, _) => None
      ExHole(_, _) => None
      ExUnit(_) => None
    }
  }
}

pub fn Syn::abstract_all(
  xs: List(SynExpr),
  ys: List(SynExpr),
  l: SynExpr,
  r: SynExpr,
  z: SynExpr
): Option(List(SynExpr)) {
  match xs {
    Nil => match ys {
      Nil => Some(Nil)
      Cons(_, _) => None
    }
    Cons(x, xr) => match ys {
      Nil => None
      Cons(y, yr) => match Syn::abstract(x, y, l, r, z) {
        Some(x2) => match Syn::abstract_all(xr, yr, l, r, z) {
          Some(rest) => Some(Cons(x2, rest))
          None => None
        }
        None => None
      }
    }
  }
}

// `e` with each `l` in it, looked for through applications, written `r`.
pub fn Syn::replace(e: SynExpr, l: SynExpr, r: SynExpr): SynExpr ! {div} {
  if Syn::same(e, l) {
    r
  } else {
    match e {
      ExApp(f, xs, sp) => ExApp(Syn::replace(f, l, r), Syn::replace_all(xs, l, r), sp)
      ExVar(_) => e
      ExAtom(_, _) => e
      ExNat(_, _) => e
      ExText(_, _) => e
      ExFloat(_, _) => e
      ExBool(_, _) => e
      ExPi(_, _, _, _) => e
      ExLam(_, _, _) => e
      ExIf(_, _, _, _) => e
      ExField(_, _, _) => e
      ExBlock(_, _) => e
      ExPerform(_, _, _) => e
      ExHandle(_, _, _) => e
      ExBudget(_, _, _) => e
      ExBudgetMemory(_, _, _) => e
      ExMatch(_, _, _, _, _, _) => e
      ExRecord(_, _, _) => e
      ExBorrow(_, _, _) => e
      ExUnion(_, _) => e
      ExProduct(xs, sp) => ExProduct(Syn::replace_all(xs, l, r), sp)
      ExTagged(_, _, _) => e
      ExExists(_, _, _, _) => e
      ExFnKind(_, _, _) => e
      ExBorrowLam(_, _, _) => e
      ExMacroCall(_, _, _) => e
      ExMacroExpr(_, _, _) => e
      ExStep(_, _, _, _, _) => e
      ExHole(_, _) => e
      ExUnit(_) => e
    }
  }
}

pub fn Syn::replace_all(xs: List(SynExpr), l: SynExpr, r: SynExpr): List(SynExpr) {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(Syn::replace(x, l, r), Syn::replace_all(rest, l, r))
  }
}

// Where `a` and `b` are not written the same: the smallest parts `l` of `a`
// and `r` of `b` such that `b` is `a` with some `l` written `r`, looking through
// applications with the same function and as many arguments. `None` when they
// are written the same.
pub fn Syn::diff(a: SynExpr, b: SynExpr): Option(@after SynExpr × @before SynExpr) ! {div} {
  if Syn::same(a, b) {
    None
  } else {
    match a {
      ExApp(f, xs, _) => match b {
        ExApp(g, ys, _) => if Syn::same(f, g) && Syn::same_length(xs, ys) {
          match Syn::diff_all(xs, ys, None) {
            Some(d) => d
            None => Some(#(@after b, @before a))
          }
        } else {
          Some(#(@after b, @before a))
        }
        ExVar(_) => Some(#(@after b, @before a))
        ExAtom(_, _) => Some(#(@after b, @before a))
        ExNat(_, _) => Some(#(@after b, @before a))
        ExText(_, _) => Some(#(@after b, @before a))
        ExFloat(_, _) => Some(#(@after b, @before a))
        ExBool(_, _) => Some(#(@after b, @before a))
        ExPi(_, _, _, _) => Some(#(@after b, @before a))
        ExLam(_, _, _) => Some(#(@after b, @before a))
        ExIf(_, _, _, _) => Some(#(@after b, @before a))
        ExField(_, _, _) => Some(#(@after b, @before a))
        ExBlock(_, _) => Some(#(@after b, @before a))
        ExPerform(_, _, _) => Some(#(@after b, @before a))
        ExHandle(_, _, _) => Some(#(@after b, @before a))
        ExBudget(_, _, _) => Some(#(@after b, @before a))
        ExBudgetMemory(_, _, _) => Some(#(@after b, @before a))
        ExMatch(_, _, _, _, _, _) => Some(#(@after b, @before a))
        ExRecord(_, _, _) => Some(#(@after b, @before a))
        ExBorrow(_, _, _) => Some(#(@after b, @before a))
        ExUnion(_, _) => Some(#(@after b, @before a))
        ExProduct(_, _) => Some(#(@after b, @before a))
        ExTagged(_, _, _) => Some(#(@after b, @before a))
        ExExists(_, _, _, _) => Some(#(@after b, @before a))
        ExFnKind(_, _, _) => Some(#(@after b, @before a))
        ExBorrowLam(_, _, _) => Some(#(@after b, @before a))
        ExMacroCall(_, _, _) => Some(#(@after b, @before a))
        ExMacroExpr(_, _, _) => Some(#(@after b, @before a))
        ExStep(_, _, _, _, _) => Some(#(@after b, @before a))
        ExHole(_, _) => Some(#(@after b, @before a))
        ExUnit(_) => Some(#(@after b, @before a))
      }
      ExVar(_) => Some(#(@after b, @before a))
      ExAtom(_, _) => Some(#(@after b, @before a))
      ExNat(_, _) => Some(#(@after b, @before a))
      ExText(_, _) => Some(#(@after b, @before a))
      ExFloat(_, _) => Some(#(@after b, @before a))
      ExBool(_, _) => Some(#(@after b, @before a))
      ExPi(_, _, _, _) => Some(#(@after b, @before a))
      ExLam(_, _, _) => Some(#(@after b, @before a))
      ExIf(_, _, _, _) => Some(#(@after b, @before a))
      ExField(_, _, _) => Some(#(@after b, @before a))
      ExBlock(_, _) => Some(#(@after b, @before a))
      ExPerform(_, _, _) => Some(#(@after b, @before a))
      ExHandle(_, _, _) => Some(#(@after b, @before a))
      ExBudget(_, _, _) => Some(#(@after b, @before a))
      ExBudgetMemory(_, _, _) => Some(#(@after b, @before a))
      ExMatch(_, _, _, _, _, _) => Some(#(@after b, @before a))
      ExRecord(_, _, _) => Some(#(@after b, @before a))
      ExBorrow(_, _, _) => Some(#(@after b, @before a))
      ExUnion(_, _) => Some(#(@after b, @before a))
      ExProduct(_, _) => Some(#(@after b, @before a))
      ExTagged(_, _, _) => Some(#(@after b, @before a))
      ExExists(_, _, _, _) => Some(#(@after b, @before a))
      ExFnKind(_, _, _) => Some(#(@after b, @before a))
      ExBorrowLam(_, _, _) => Some(#(@after b, @before a))
      ExMacroCall(_, _, _) => Some(#(@after b, @before a))
      ExMacroExpr(_, _, _) => Some(#(@after b, @before a))
      ExStep(_, _, _, _, _) => Some(#(@after b, @before a))
      ExHole(_, _) => Some(#(@after b, @before a))
      ExUnit(_) => Some(#(@after b, @before a))
    }
  }
}

// The one difference of the arguments, as `Some(d)`, when every argument that
// differs differs by the same `l` and `r`; `None` when they differ by several.
pub fn Syn::diff_all(
  xs: List(SynExpr),
  ys: List(SynExpr),
  found: Option(@after SynExpr × @before SynExpr)
): Option(Option(@after SynExpr × @before SynExpr)) ! {div} {
  match xs {
    Nil => Some(found)
    Cons(x, xr) => match ys {
      Nil => Some(found)
      Cons(y, yr) => match Syn::diff(x, y) {
        None => Syn::diff_all(xr, yr, found)
        Some(#(@after r, @before l)) => match found {
          None => Syn::diff_all(xr, yr, Some(#(@after r, @before l)))
          Some(#(@after r0, @before l0)) => if Syn::same(l, l0) && Syn::same(r, r0) {
            Syn::diff_all(xr, yr, found)
          } else {
            None
          }
        }
      }
    }
  }
}

pub fn Syn::same_length(xs: List(SynExpr), ys: List(SynExpr)): Bool {
  match xs {
    Nil => match ys {
      Nil => true
      Cons(_, _) => false
    }
    Cons(_, xr) => match ys {
      Nil => false
      Cons(_, yr) => Syn::same_length(xr, yr)
    }
  }
}

pub fn Syn::app_parts(e: SynExpr): Option(List(SynExpr) × SynExpr) {
  match e {
    ExApp(f, xs, _) => Some(#(xs, f))
    ExVar(_) => None
    ExAtom(_, _) => None
    ExNat(_, _) => None
    ExText(_, _) => None
    ExFloat(_, _) => None
    ExBool(_, _) => None
    ExPi(_, _, _, _) => None
    ExLam(_, _, _) => None
    ExIf(_, _, _, _) => None
    ExField(_, _, _) => None
    ExBlock(_, _) => None
    ExPerform(_, _, _) => None
    ExHandle(_, _, _) => None
    ExBudget(_, _, _) => None
    ExBudgetMemory(_, _, _) => None
    ExMatch(_, _, _, _, _, _) => None
    ExRecord(_, _, _) => None
    ExBorrow(_, _, _) => None
    ExUnion(_, _) => None
    ExProduct(_, _) => None
    ExTagged(_, _, _) => None
    ExExists(_, _, _, _) => None
    ExFnKind(_, _, _) => None
    ExBorrowLam(_, _, _) => None
    ExMacroCall(_, _, _) => None
    ExMacroExpr(_, _, _) => None
    ExStep(_, _, _, _, _) => None
    ExHole(_, _) => None
    ExUnit(_) => None
  }
}

pub fn Syn::nat_text(e: SynExpr): Option(Text) {
  match e {
    ExNat(n, _) => Some(n)
    ExVar(_) => None
    ExAtom(_, _) => None
    ExText(_, _) => None
    ExFloat(_, _) => None
    ExBool(_, _) => None
    ExApp(_, _, _) => None
    ExPi(_, _, _, _) => None
    ExLam(_, _, _) => None
    ExIf(_, _, _, _) => None
    ExField(_, _, _) => None
