import "Rewrite.taut" { Tac }
import "NatNorm.taut" { Nat, NatExpr }
import std::prelude::Macro {
  Elab,
  Judgement,
  ProofStep,
  Syn,
  SynCtx,
  SynExpr,
  SynIdent,
  SynSpan,
  elab,
  macro_error
}
import std::prelude::Std { List, Option, Result }
import std::prelude::Shared { concat }

// `nat_norm!()`, for a goal `l = r` on `Nat` whose sides are made of `Nat::add`,
// `Nat::mul` (or `+` and `*`, which are the same), `Succ`, `Zero`, numerals and anything else (which is a variable of the
// equation): reflection. The sides are read as `NatExpr`s (`std/NatNorm.taut`), and
// the term is `Nat::norm_eq(vars, l', r', Refl)`, whose `Refl` the kernel accepts
// only when the two sides have the same normal form. The theorem `Nat::norm_eq` is
// the trust; the reading here is not (a wrong one is a term that does not check).
// No goal is left: write no arm.
pub macro fn nat_norm(s: ProofStep): SynExpr ! {macro_error, elab, Div} {
  match s.after {
    Cons(_, _) => Syn::error(s.span, "nat_norm! leaves no goal: write no arm")
    Nil => match Tac::eq_goal(s.before) {
      None => Syn::error(s.span, "nat_norm!: the goal is not an equation of Nat")
      Some(#(@lhs l, @rhs r, @ty ty)) => if Syn::name_of(ty) == Some("Nat") {
        Tac::nat_norm_sides(s, l, r)
      } else {
        Syn::error(s.span, "nat_norm!: the goal is not an equation of Nat")
      }
    }
  }
}

// `nat_le!()`, for a goal `l <= r = true` or `l < r = true` (`Nat::le`, `Nat::lt`) on `Nat`,
// with `l` and `r` read as for `nat_norm!`. The term is `Nat::norm_le(vars, l', r', Refl)`,
// whose `Refl` the kernel accepts only when `Np::le_chk` says that every term of the normal
// form of `l'` is matched by one of `r'` with the same monomial and a coefficient that is not
// smaller; `l < r` is read as `Succ(l) <= r`. Hypotheses are not used: a goal that needs
// one is not proved. No goal is left: write no arm.
pub macro fn nat_le(s: ProofStep): SynExpr ! {macro_error, Div} {
  match s.after {
    Cons(_, _) => Syn::error(s.span, "nat_le! leaves no goal: write no arm")
    Nil => match Syn::app_parts(Judgement::term(s.before)) {
      None => Syn::error(
        s.span,
        "nat_le!: the goal is not `l <= r = true` or `l < r = true` on Nat"
      )
      Some(p) => match Tac::two((p: List(SynExpr))) {
        None => Syn::error(
          s.span,
          "nat_le!: the goal is not `l <= r = true` or `l < r = true` on Nat"
        )
        Some(#(@lhs l, @rhs r)) => if Syn::same(r, quote { true }) {
          Tac::nat_le_goal(s.span, l)
        } else {
          Syn::error(s.span, "nat_le!: the goal is not `l <= r = true` or `l < r = true` on Nat")
        }
      }
    }
  }
}

module Tac {
  // `l <= r` or `l < r`: the two sides and whether the comparison is strict.
  pub fn nat_le_goal(at: SynSpan, rel: SynExpr): SynExpr ! {macro_error, Div} {
    match Syn::app_parts(rel) {
      None => Syn::error(at, "nat_le!: the goal is not `l <= r = true` or `l < r = true` on Nat")
      Some(p) => match Syn::name_of((p: SynExpr)) {
        None => Syn::error(at, "nat_le!: the goal is not `l <= r = true` or `l < r = true` on Nat")
        Some(name) => match Tac::two((p: List(SynExpr))) {
          None => Syn::error(
            at,
            "nat_le!: the goal is not `l <= r = true` or `l < r = true` on Nat"
          )
          Some(#(@lhs l, @rhs r)) => if name == "Nat::le" || name == "<=" {
            Tac::nat_le_sides(at, false, l, r)
          } else if name == "Nat::lt" || name == "<" {
            Tac::nat_le_sides(at, true, l, r)
          } else {
            Syn::error(at, "nat_le!: the goal is not `l <= r = true` or `l < r = true` on Nat")
          }
        }
      }
    }
  }

  pub fn nat_le_sides(
    at: SynSpan,
    strict: Bool,
    l: SynExpr,
    r: SynExpr
  ): SynExpr ! {macro_error, Div} {
    let a := Tac::nn_read(l, Nil, at)
    let b := Tac::nn_read(r, (a: List(SynExpr)), at)
    let env := Tac::nn_list((b: List(SynExpr)))
    let x := (a: SynExpr)
    let y := (b: SynExpr)
    if strict {
      quote { Nat::norm_le($env, NeAdd($x, NeConst(Succ(Zero))), $y, Refl) }
    } else {
      quote { Nat::norm_le($env, $x, $y, Refl) }
    }
  }

  pub fn nat_norm_sides(s: ProofStep, l: SynExpr, r: SynExpr): SynExpr ! {macro_error, elab, Div} {
    let at := s.span
    let a := Tac::nn_read(l, Nil, at)
    let b := Tac::nn_read(r, (a: List(SynExpr)), at)
    let env := Tac::nn_list((b: List(SynExpr)))
    let x := (a: SynExpr)
    let y := (b: SynExpr)
    let proof := quote { Nat::norm_eq($env, $x, $y, Refl) }
    let goal := Judgement::ty_of(s.before, Judgement::term(s.before))
    match Elab::check(proof, s.before, Some(goal)) {
      Ok(_) => proof
      Err(_) => match Tac::elaborated(s.before) {
        None => proof
        Some(_) => match Elab::check(quote { Refl }, s.before, Some(goal)) {
          Ok(_) => proof
          Err(d) => Syn::error(
            at,
            concat(
              "nat_norm!: the two sides are not equal as polynomials of Nat (anything that is not `+`, `*`, `Succ`, `Zero` or a numeral is one variable): ",
              d.message
            )
          )
        }
      }
    }
  }

  // The `NatExpr` of `e`, with the variables met so far (in order) and then the ones
  // `e` adds.
  pub fn nn_read(
    e: SynExpr,
    vars: List(SynExpr),
    at: SynSpan
  ): SynExpr × List(SynExpr) ! {macro_error, Div} {
    match Syn::nat_text(e) {
      Some(n) => {
        let k := ExNat(n, at)
        #(quote { NeConst($k) }, vars)
      }
      None => match Syn::app_parts(e) {
        None => match Syn::name_of(e) {
          Some(name) => if name == "Zero" {
            #(quote { NeConst(Zero) }, vars)
          } else {
            Tac::nn_var(e, vars, at)
          }
          None => Tac::nn_var(e, vars, at)
        }
        Some(p) => match Syn::name_of((p: SynExpr)) {
          None => Tac::nn_var(e, vars, at)
          Some(name) => Tac::nn_call(e, name, (p: List(SynExpr)), vars, at)
        }
      }
    }
  }

  // A call of `name` with `args`: the operations of the semiring, or else a variable.
  pub fn nn_call(
    e: SynExpr,
    name: Text,
    args: List(SynExpr),
    vars: List(SynExpr),
    at: SynSpan
  ): SynExpr × List(SynExpr) ! {macro_error, Div} {
    match args {
      Nil => Tac::nn_var(e, vars, at)
      Cons(a, rest) => match rest {
        Nil => if name == "Succ" {
          let x := Tac::nn_read(a, vars, at)
          let one := quote { NeConst(Succ(Zero)) }
          let u := (x: SynExpr)
          #(quote { NeAdd($u, $one) }, (x: List(SynExpr)))
        } else {
          Tac::nn_var(e, vars, at)
        }
        Cons(b, extra) => match extra {
          Nil => if name == "Nat::add" || name == "+" {
            let x := Tac::nn_read(a, vars, at)
            let y := Tac::nn_read(b, (x: List(SynExpr)), at)
            let u := (x: SynExpr)
            let v := (y: SynExpr)
            #(quote { NeAdd($u, $v) }, (y: List(SynExpr)))
          } else if name == "Nat::mul" || name == "*" {
            let x := Tac::nn_read(a, vars, at)
            let y := Tac::nn_read(b, (x: List(SynExpr)), at)
            let u := (x: SynExpr)
            let v := (y: SynExpr)
            #(quote { NeMul($u, $v) }, (y: List(SynExpr)))
          } else {
            Tac::nn_var(e, vars, at)
          }
          Cons(_, _) => Tac::nn_var(e, vars, at)
        }
      }
    }
  }

  // `e` as a variable: its place in the list, which grows by `e` if it is new.
  pub fn nn_var(
    e: SynExpr,
    vars: List(SynExpr),
    at: SynSpan
  ): SynExpr × List(SynExpr) ! {macro_error, Div} {
    match Tac::nn_index(e, vars, 0) {
      Some(i) => #(Tac::nn_var_expr(i), vars)
      None => {
        let grown := Syn::append(vars, Cons(e, Nil))
        #(Tac::nn_var_expr(Tac::nn_length(vars, 0)), grown)
      }
    }
  }

  pub fn nn_var_expr(i: u64): SynExpr {
    let n := Tac::nn_nat(i)
    quote { NeVar($n) }
  }

  pub fn nn_index(e: SynExpr, vars: List(SynExpr), i: u64): Option(u64) {
    match vars {
      Nil => None
      Cons(v, rest) => if Syn::same(e, v) { Some(i) } else { Tac::nn_index(e, rest, i + 1) }
    }
  }

  pub fn nn_length(vars: List(SynExpr), n: u64): u64 {
    match vars {
      Nil => n
      Cons(_, rest) => Tac::nn_length(rest, n + 1)
    }
  }

  pub fn nn_nat(i: u64): SynExpr {
    if i == 0 {
      quote { Zero }
    } else {
      let k := Tac::nn_nat(i - 1)
      quote { Succ($k) }
    }
  }

  pub fn nn_list(vars: List(SynExpr)): SynExpr {
    match vars {
      Nil => quote { Nil }
      Cons(v, rest) => {
        let tail := Tac::nn_list(rest)
        quote { Cons($v, $tail) }
      }
    }
  }
}
