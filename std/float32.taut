import "base.taut" { Nat }
import "float.taut" { Float }
import "nat.taut" { Nat }
import "uint.taut" { Nat, UInt }
import std::prelude::std { Option }

// `Float32` (IEEE 754 binary32) as the proofs see it: its 32 bits.
// Extraction maps `Float32` onto Nib's `Float32` and the functions marked
// "Mapped" onto its operators and builtins (`docs/design/float.md`).
//
// Every `Float32` is a `Float`, and IEEE 754's `+ - * /` and square root of
// two `Float32`s are the `Float` results of the same numbers rounded to the
// nearest `Float32`: a `Float` keeps more than twice the digits, so the
// first rounding never changes the second. The definitions here say just
// that, through `Float::of_float32` and `Float32::of_float`, so a proof reuses
// what it knows of `Float`. The functions IEEE 754 does not round exactly
// (`Float32::exp`, …) are axioms, as the `Float` ones are.
//
// NaN has one set of bits, `0x7FC00000`, here and at run time.

pub(open) inductive Float32: Type {
  Mk(bits: UInt(32)): Float32
}

pub fn Float32::u32_of_nat_mod(n: Nat): UInt(32) {
  UInt::mk32(
    Nat::rem_nz(n, 4294967296, Nat::ne_zero(4294967296, Refl)),
    Nat::mod_lt(n, 4294967296, Refl)
  )
}

// The `Float32` whose bits are `n` (modulo `2^32`).
pub fn Float32::of_raw(n: Nat): Float32 {
  Float32::Mk(Float32::u32_of_nat_mod(n))
}

pub fn Float32::sign_of(n: Nat): Nat {
  Nat::div_nz(n, 2147483648, Nat::ne_zero(2147483648, Refl))
}

pub fn Float32::expo_of(n: Nat): Nat {
  Nat::rem_nz(Nat::div_nz(n, 8388608, Nat::ne_zero(8388608, Refl)), 256, Nat::ne_zero(256, Refl))
}

pub fn Float32::frac_of(n: Nat): Nat {
  Nat::rem_nz(n, 8388608, Nat::ne_zero(8388608, Refl))
}

pub fn Float32::nan_of(n: Nat): Bool {
  Float32::expo_of(n) == 255 && not(Float32::frac_of(n) == 0)
}

pub fn Float32::inf_of(n: Nat): Bool {
  Float32::expo_of(n) == 255 && Float32::frac_of(n) == 0
}

// A finite `Float32` is `m * 2^(e - 4000)` with `m < 2^24`, the same scale
// as `Float`'s (`Float::m_of`, `Float::e_of`); a subnormal has `e = 3851`.
pub fn Float32::m_of(n: Nat): Nat {
  match Float32::expo_of(n) == 0 {
    true => Float32::frac_of(n)
    false => Float32::frac_of(n) + 8388608
  }
}

pub fn Float32::e_of(n: Nat): Nat {
  match Float32::expo_of(n) == 0 {
    true => 3851
    false => Float32::expo_of(n) + 3850
  }
}

pub fn Float32::nan_raw(): Nat {
  2143289344
}

pub fn Float32::inf_raw(s: Nat): Nat {
  s * 2147483648 + 2139095040
}

pub fn Float32::zero_raw(s: Nat): Nat {
  s * 2147483648
}

// Mapped: the bits of `x` as a number, `0x7FC00000` for every NaN.
pub fn Float32::raw(x: Float32): Nat {
  match x {
    Mk(b) => ⊢ Nat from match Float32::nan_of(UInt::val32(b)) {
      true => Float32::nan_raw()
      false => UInt::val32(b)
    }
  }
}

// The bits of `m * 2^(t - 4000)` with sign `s`, for `m <= 2^24` and
// `t >= 3851`, or an infinity when it is too large.
pub fn Float32::encode(s: Nat, m: Nat, t: Nat): Nat {
  match (t - 3851) * 8388608 + m < 2139095040 {
    true => Float32::zero_raw(s) + ((t - 3851) * 8388608 + m)
    false => Float32::inf_raw(s)
  }
}

// `m * 2^(t - k - 4000)` with `k` binary digits dropped from `m`, rounded
// to the nearest, ties to even. With `m < 2^120`, 125 digits or more round
// to zero.
pub fn Float32::round_shift(s: Nat, m: Nat, t: Nat, k: Nat): Nat {
  match k < 125 {
    false => Float32::zero_raw(s)
    true => Float32::round_at(
      s,
      Nat::div_nz(m, Nat::pow2(k), Nat::pow2_ne_zero(k)),
      Nat::rem_nz(m, Nat::pow2(k), Nat::pow2_ne_zero(k)),
      Nat::pow2(k),
      t
    )
  }
}

pub fn Float32::round_at(s: Nat, q: Nat, r: Nat, p: Nat, t: Nat): Nat {
  match Nat::div_nz(p, 2, Nat::ne_zero(2, Refl)) < r {
    true => Float32::encode(s, Succ(q), t)
    false => ⊢ Nat from match r == Nat::div_nz(
      p,
      2,
      Nat::ne_zero(2, Refl)
    ) && Nat::rem_nz(q, 2, Nat::ne_zero(2, Refl)) == 1 {
      true => Float32::encode(s, Succ(q), t)
      false => Float32::encode(s, q, t)
    }
  }
}

// The nearest `Float32` to `m * 2^(e - 4000)` with sign `s`, for `m < 2^120`.
// As `Float::pack`, a last digit of 1 can stand for the part below.
pub fn Float32::pack(s: Nat, m: Nat, e: Nat): Nat {
  match m == 0 {
    true => Float32::zero_raw(s)
    false => Float32::pack_at(s, m, e, Nat::max(e + Float::len(m) - 24, 3851))
  }
}

pub fn Float32::pack_at(s: Nat, m: Nat, e: Nat, t: Nat): Nat {
  match t <= e {
    true => Float32::encode(s, m * Nat::pow2(e - t), t)
    false => Float32::round_shift(s, m, t, t - e)
  }
}

pub fn Float32::of_float_raw(a: Nat): Nat {
  match Float::nan_of(a) {
    true => Float32::nan_raw()
    false => ⊢ Nat from match Float::inf_of(a) {
      true => Float32::inf_raw(Float::sign_of(a))
      false => Float32::pack(Float::sign_of(a), Float::m_of(a), Float::e_of(a))
    }
  }
}

// Mapped: the nearest `Float32`, ties to even; an infinity past the largest.
pub fn Float32::of_float(x: Float): Float32 {
  Float32::of_raw(Float32::of_float_raw(Float::raw(x)))
}

pub fn Float::of_float32_raw(a: Nat): Nat {
  match Float32::nan_of(a) {
    true => Float::nan_raw()
    false => ⊢ Nat from match Float32::inf_of(a) {
      true => Float::inf_raw(Float32::sign_of(a))
      false => Float::pack(Float32::sign_of(a), Float32::m_of(a), Float32::e_of(a))
    }
  }
}

// Mapped: the same number as a `Float`.
pub fn Float::of_float32(x: Float32): Float {
  Float::of_raw(Float::of_float32_raw(Float32::raw(x)))
}

// The `Float32` nearest to the `Float` result of `f` on the same numbers.
pub fn Float32::via(f: (Float) -> Float, x: Float32): Float32 {
  Float32::of_float(f(Float::of_float32(x)))
}

pub fn Float32::via2(f: (Float, Float) -> Float, x: Float32, y: Float32): Float32 {
  Float32::of_float(f(Float::of_float32(x), Float::of_float32(y)))
}

// Mapped: the bits of `x`; every NaN has the bits `0x7FC00000`.
pub fn Float32::bits(x: Float32): UInt(32) {
  Float32::u32_of_nat_mod(Float32::raw(x))
}

// Mapped: the `Float32` with bits `b`.
pub fn Float32::of_bits(b: UInt(32)): Float32 {
  Float32::Mk(b)
}

// Mapped: `a + b`.
pub fn Float32::add(a: Float32, b: Float32): Float32 {
  Float32::via2(Float::add, a, b)
}

// Mapped: `a - b`.
pub fn Float32::sub(a: Float32, b: Float32): Float32 {
  Float32::via2(Float::sub, a, b)
}

// Mapped: `a * b`.
pub fn Float32::mul(a: Float32, b: Float32): Float32 {
  Float32::via2(Float::mul, a, b)
}

// Mapped: `-a`.
pub fn Float32::neg(a: Float32): Float32 {
  Float32::via(Float::neg, a)
}

// Mapped: whether `x` is `+0` or `-0`.
pub fn Float32::is_zero(x: Float32): Bool {
  Float::is_zero(Float::of_float32(x))
}

// Mapped: `a / b`, for a `b` that is not zero.
pub fn Float32::div(a: Float32, b: Float32, h: Float32::is_zero(b) = false): Float32 {
  Float32::of_float(Float::div(Float::of_float32(a), Float::of_float32(b), h))
}

pub fn Float32::checked_div(a: Float32, b: Float32): Option(Float32) {
  match Float::checked_div(Float::of_float32(a), Float::of_float32(b)) {
    None => None
    Some(q) => Some(Float32::of_float(q))
  }
}

// Mapped: whether `x` is NaN.
pub fn Float32::is_nan(x: Float32): Bool {
  Float::is_nan(Float::of_float32(x))
}

pub fn Float32::is_infinite(x: Float32): Bool {
  Float::is_infinite(Float::of_float32(x))
}

// Mapped: `a == b`, `a < b` and `a <= b`, as IEEE 754 compares.
pub fn Float32::eq(a: Float32, b: Float32): Bool {
  Float::eq(Float::of_float32(a), Float::of_float32(b))
}

pub fn Float32::lt(a: Float32, b: Float32): Bool {
  Float::lt(Float::of_float32(a), Float::of_float32(b))
}

pub fn Float32::le(a: Float32, b: Float32): Bool {
  Float::le(Float::of_float32(a), Float::of_float32(b))
}

// Mapped.
pub fn Float32::abs(x: Float32): Float32 {
  Float32::via(Float::abs, x)
}

pub fn Float32::sqrt(x: Float32): Float32 {
  Float32::via(Float::sqrt, x)
}

pub fn Float32::trunc(x: Float32): Float32 {
  Float32::via(Float::trunc, x)
}

pub fn Float32::floor(x: Float32): Float32 {
  Float32::via(Float::floor, x)
}

pub fn Float32::ceil(x: Float32): Float32 {
  Float32::via(Float::ceil, x)
}

pub fn Float32::round(x: Float32): Float32 {
  Float32::via(Float::round, x)
}

// Mapped. IEEE 754 does not round these exactly; each backend gives the
// `Float` function of the same number rounded to the nearest `Float32`. A
// proof may call them but knows nothing of their values, as of the `Float`
// ones (`std/Float::taut`).
pub axiom Float32::cbrt(x: Float32): Float32
pub axiom Float32::exp(x: Float32): Float32
pub axiom Float32::ln(x: Float32): Float32
pub axiom Float32::log2(x: Float32): Float32
pub axiom Float32::log10(x: Float32): Float32
pub axiom Float32::pow(x: Float32, y: Float32): Float32
pub axiom Float32::sin(x: Float32): Float32
pub axiom Float32::cos(x: Float32): Float32
pub axiom Float32::tan(x: Float32): Float32
pub axiom Float32::asin(x: Float32): Float32
pub axiom Float32::acos(x: Float32): Float32
pub axiom Float32::atan(x: Float32): Float32
pub axiom Float32::atan2(y: Float32, x: Float32): Float32
pub axiom Float32::sinh(x: Float32): Float32
pub axiom Float32::cosh(x: Float32): Float32
pub axiom Float32::tanh(x: Float32): Float32

// `0.1` as a `Float32` is `0x3DCCCCCD`, and adding `0.2` gives `0x3E99999A`.
pub theorem Float32::tenth(): Float32::raw(Float32::of_float(0.1)) = 1036831949 {
  Refl
}

pub theorem Float32::tenths(): Float32::raw(Float32::add(Float32::of_float(0.1), Float32::of_float(0.2))) = 1050253722 {
  Refl
}

// A `Float32` is the same number as a `Float`.
pub theorem Float32::widen_tenth(): Float::of_float32(Float32::of_float(0.1)) = 0.10000000149011612 {
  Refl
}
