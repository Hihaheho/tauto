  hhi: NatLe(S, 288230376151711744),
  hb: BitLen(S, 57)
): G(Float::pack_at(s, S, e, Nat::max(e + Succ(57) - 53, 2926))) {
  match float_yn_or(
    e + Succ(4) < 2926
  ): G(Float::pack_at(s, S, e, Nat::max(e + Succ(57) - 53, 2926))) {
    OrInl(hy) => Eq::subst(
      (w: Nat) => G(Float::pack_at(s, S, e, w)),
      Eq::sym(nat_max_yes(e + Succ(4), 2926, hy)),
      pack_sub(s, P, Q, S, e, 4, G, hs, fin, inf, hsc, hhi, And::right(hb), Refl, hy)
    )
    OrInr(hn) => Eq::subst(
      (w: Nat) => G(Float::pack_at(s, S, e, w)),
      Eq::sym(nat_max_no(e + Succ(4), 2926, hn)),
      pack_normal(
        s,
        P,
        Q,
        S,
        e,
        4,
        G,
        hs,
        fin,
        inf,
        hsc,
        hlo,
        And::left(hb),
        And::right(hb),
        Refl,
        Refl,
        hn
      )
    )
  }
}

pub theorem pack_58(
  s: Nat,
  P: Nat,
  Q: Nat,
  S: Nat,
  e: Nat,
  G: (Nat) -> Prop,
  hs: s < 2 = true,
  fin: FinK(s, P, Q, G),
  inf: G(Float::inf_raw(s)),
  hsc: ScaledOk(S, P, Q, Nat::pow2(e), Nat::pow2(4000)),
  hlo: NatLe(72057594037927936, S),
  hhi: NatLe(S, 288230376151711744),
  hb: BitLen(S, 58)
): G(Float::pack_at(s, S, e, Nat::max(e + Succ(58) - 53, 2926))) {
  match float_yn_or(
    e + Succ(5) < 2926
  ): G(Float::pack_at(s, S, e, Nat::max(e + Succ(58) - 53, 2926))) {
    OrInl(hy) => Eq::subst(
      (w: Nat) => G(Float::pack_at(s, S, e, w)),
      Eq::sym(nat_max_yes(e + Succ(5), 2926, hy)),
      pack_sub(s, P, Q, S, e, 5, G, hs, fin, inf, hsc, hhi, And::right(hb), Refl, hy)
    )
    OrInr(hn) => Eq::subst(
      (w: Nat) => G(Float::pack_at(s, S, e, w)),
      Eq::sym(nat_max_no(e + Succ(5), 2926, hn)),
      pack_normal(
        s,
        P,
        Q,
        S,
        e,
        5,
        G,
        hs,
        fin,
        inf,
        hsc,
        hlo,
        And::left(hb),
        And::right(hb),
        Refl,
        Refl,
        hn
      )
    )
  }
}

// The nearest `Float` to `S 2^(e - 4000)` for sticky digits `S` in `[2^56, 2^58]`.
pub theorem pack_ok(
  s: Nat,
  P: Nat,
  Q: Nat,
  S: Nat,
  e: Nat,
  G: (Nat) -> Prop,
  hs: s < 2 = true,
  fin: FinK(s, P, Q, G),
  inf: G(Float::inf_raw(s)),
  hsc: ScaledOk(S, P, Q, Nat::pow2(e), Nat::pow2(4000)),
  hlo: NatLe(72057594037927936, S),
  hhi: NatLe(S, 288230376151711744)
): G(Float::pack(s, S, e)) {
  let h1: NatLe(1, S) := one_le_of(S, hlo)
  let L: Nat := Float::bitlen(129, Nat::div_nz(S, 2, Nat::ne_zero(2, Refl)))
  let hb: BitLen(S, L) := len_spec(S, h1, hhi)
  let eq: Float::pack(
    s,
    S,
    e
  ) = Float::pack_at(
    s,
    S,
    e,
    Nat::max(e + Succ(L) - 53, 2926)
  ) := Eq::trans(
    float_pack_eq(s, S, e, h1),
    Eq::congr(⟦Float::pack_at(s, S, e, Nat::max(e + □ - 53, 2926))⟧, flen_of(S, h1))
  )
  let gL: G(
    Float::pack_at(s, S, e, Nat::max(e + Succ(L) - 53, 2926))
  ) := match len_cases(
    S,
    L,
    hb,
    hlo,
    hhi
  ): G(Float::pack_at(s, S, e, Nat::max(e + Succ(L) - 53, 2926))) {
    OrInl(e56) => Eq::subst(
      (w: Nat) => G(Float::pack_at(s, S, e, Nat::max(e + Succ(w) - 53, 2926))),
      Eq::sym(e56),
      pack_56(
        s,
        P,
        Q,
        S,
        e,
        G,
        hs,
        fin,
        inf,
        hsc,
        hlo,
        hhi,
        Eq::subst((w: Nat) => BitLen(S, w), e56, hb)
      )
    )
    OrInr(o) => match o: G(Float::pack_at(s, S, e, Nat::max(e + Succ(L) - 53, 2926))) {
      OrInl(e57) => Eq::subst(
        (w: Nat) => G(Float::pack_at(s, S, e, Nat::max(e + Succ(w) - 53, 2926))),
        Eq::sym(e57),
        pack_57(
          s,
          P,
          Q,
          S,
          e,
          G,
          hs,
          fin,
          inf,
          hsc,
          hlo,
          hhi,
          Eq::subst((w: Nat) => BitLen(S, w), e57, hb)
        )
      )
      OrInr(e58) => Eq::subst(
        (w: Nat) => G(Float::pack_at(s, S, e, Nat::max(e + Succ(w) - 53, 2926))),
        Eq::sym(e58),
        pack_58(
          s,
          P,
          Q,
          S,
          e,
          G,
          hs,
          fin,
          inf,
          hsc,
          hlo,
          hhi,
          Eq::subst((w: Nat) => BitLen(S, w), e58, hb)
        )
      )
    }
  }
  Eq::subst((w: Nat) => G(w), Eq::sym(eq), gL)
}

pub fn float_scaled_by(
  o: Bool,
  pack: (Nat, Nat, Nat) -> Nat,
  inf: Nat,
  s: Nat,
  p: Nat,
  q: Nat,
  up: Nat,
  down: Nat
): Nat {
  match o: Nat {
    true => float_scaled_up_by(up - down < 2100, pack, s, p, q, up, down)
    false => float_scaled_down_by(down - up < 1100, pack, inf, s, p, q, up, down)
  }
}

pub fn float_scaled_up_by(
  o: Bool,
  pack: (Nat, Nat, Nat) -> Nat,
  s: Nat,
  p: Nat,
  q: Nat,
  up: Nat,
  down: Nat
): Nat {
  match o: Nat {
    true => pack(s, Float::sticky(p * Nat::pow2(up - down), q), 3999 - (up - down))
    false => pack(s, 0, 0)
  }
}

pub fn float_scaled_down_by(
  o: Bool,
  pack: (Nat, Nat, Nat) -> Nat,
  inf: Nat,
  s: Nat,
  p: Nat,
  q: Nat,
  up: Nat,
  down: Nat
): Nat {
  match o: Nat {
    true => pack(s, Float::sticky(p, q * Nat::pow2(down - up)), 3999 + (down - up))
    false => inf
  }
}

pub theorem pow2_split_at(
  a: Nat,
  b: Nat,
  z: Nat,
  h: a + b = z
): And(
  NatLe(Nat::pow2(z), Nat::pow2(a) * Nat::pow2(b)),
  NatLe(Nat::pow2(a) * Nat::pow2(b), Nat::pow2(z))
) {
  Eq::subst(
    (w: Nat) => And(
      NatLe(Nat::pow2(w), Nat::pow2(a) * Nat::pow2(b)),
      NatLe(Nat::pow2(a) * Nat::pow2(b), Nat::pow2(w))
    ),
    h,
    pow2_split_eq(a, b)
  )
}

pub theorem pow2_4000_le(): And(
  NatLe(Nat::pow2(4000), 2 * Nat::pow2(3999)),
  NatLe(2 * Nat::pow2(3999), Nat::pow2(4000))
) {
  Eq::subst(
    (w: Nat) => And(NatLe(w, 2 * Nat::pow2(3999)), NatLe(2 * Nat::pow2(3999), w)),
    Eq::sym(float_pow2_succ_eq(3999)),
    AndIntro(
      Int::le_refl(IntOfNat(2 * Nat::pow2(3999))),
      Int::le_refl(IntOfNat(2 * Nat::pow2(3999)))
    )
  )
}

// Scaled up by `k < 2100`: the sticky digits of `p 2^k / q`, at `e = 3999 - k`.
pub theorem frac_up(
  s: Nat,
  P: Nat,
  q0: Nat,
  LP: Nat,
  LQ: Nat,
  G: (Nat) -> Prop,
  hs: s < 2 = true,
  fin: FinK(s, P, Succ(q0), G),
  inf: G(Float::inf_raw(s)),
  hbP: BitLen(P, LP),
  hbQ: BitLen(Succ(q0), LQ),
  hle: Succ(LP) <= 56 + Succ(LQ) = true,
  hk: 56 + Succ(LQ) - Succ(LP) < 2100 = true
): G(
  Float::pack(
    s,
    Float::sticky(P * Nat::pow2(56 + Succ(LQ) - Succ(LP)), Succ(q0)),
    3999 - (56 + Succ(LQ) - Succ(LP))
  )
) {
  let k: Nat := 56 + Succ(LQ) - Succ(LP)
  let Q: Nat := Succ(q0)
  let K2: Nat := Nat::pow2(k)
  let e: Nat := 3999 - k
  let S: Nat := Float::sticky(P * K2, Q)
  let hst: StickyOk(S, P * K2, Q) := sticky_ok(P * K2, q0)
  let ek: 3999 = k + e := Nat::le_gap(
    k,
    3999,
    yn_of_nat_le(k, 3999, k_le_3999(k, nat_le_of_yn(Succ(k), 2100, hk)))
  )
  let hke: And(
    NatLe(Nat::pow2(3999), K2 * Nat::pow2(e)),
    NatLe(K2 * Nat::pow2(e), Nat::pow2(3999))
  ) := Eq::subst(
    (w: Nat) => And(NatLe(Nat::pow2(w), K2 * Nat::pow2(e)), NatLe(K2 * Nat::pow2(e), Nat::pow2(w))),
    Eq::sym(ek),
    pow2_split_eq(k, e)
  )
  let z4: And(
    NatLe(Nat::pow2(4000), 2 * Nat::pow2(3999)),
    NatLe(2 * Nat::pow2(3999), Nat::pow2(4000))
  ) := pow2_4000_le()
  let za1: NatLe(
    2 * (K2 * Nat::pow2(e)),
    Nat::pow2(4000)
  ) := Int::le_trans(
    IntOfNat(2 * (K2 * Nat::pow2(e))),
    IntOfNat(2 * Nat::pow2(3999)),
    IntOfNat(Nat::pow2(4000)),
    dbl_le(K2 * Nat::pow2(e), Nat::pow2(3999), And::right(hke)),
    And::right(z4)
  )
  let za2: NatLe(
    Nat::pow2(4000),
    2 * (K2 * Nat::pow2(e))
  ) := Int::le_trans(
    IntOfNat(Nat::pow2(4000)),
    IntOfNat(2 * Nat::pow2(3999)),
    IntOfNat(2 * (K2 * Nat::pow2(e))),
    And::left(z4),
    dbl_le(Nat::pow2(3999), K2 * Nat::pow2(e), And::left(hke))
  )
  let hsc: ScaledOk(
    S,
    P,
    Q,
    Nat::pow2(e),
    Nat::pow2(4000)
  ) := AndIntro(
    scaled_a1(S, P, Q, K2, Nat::pow2(e), Nat::pow2(4000), And::left(hst), za1),
    scaled_a2(S, P, Q, K2, Nat::pow2(e), Nat::pow2(4000), And::right(hst), za2)
  )
  let eu: 56 + Succ(LQ) = Succ(LP) + k := Nat::le_gap(Succ(LP), 56 + Succ(LQ), hle)
  let r1: And(
    NatLe(Nat::pow2(56 + Succ(LQ)), Nat::pow2(Succ(LP)) * K2),
    NatLe(Nat::pow2(Succ(LP)) * K2, Nat::pow2(56 + Succ(LQ)))
  ) := Eq::subst(
    (w: Nat) => And(
      NatLe(Nat::pow2(w), Nat::pow2(Succ(LP)) * K2),
      NatLe(Nat::pow2(Succ(LP)) * K2, Nat::pow2(w))
    ),
    Eq::sym(eu),
    pow2_split_eq(Succ(LP), k)
  )
  let r2: And(
    NatLe(Nat::pow2(56 + Succ(LQ)), Nat::pow2(56) * Nat::pow2(Succ(LQ))),
    NatLe(Nat::pow2(56) * Nat::pow2(Succ(LQ)), Nat::pow2(56 + Succ(LQ)))
  ) := pow2_split_eq(56, Succ(LQ))
  let rel1: NatLe(
    Nat::pow2(Succ(LP)) * K2,
    Nat::pow2(56) * Nat::pow2(Succ(LQ))
  ) := Int::le_trans(
    IntOfNat(Nat::pow2(Succ(LP)) * K2),
    IntOfNat(Nat::pow2(56 + Succ(LQ))),
    IntOfNat(Nat::pow2(56) * Nat::pow2(Succ(LQ))),
    And::right(r1),
    And::left(r2)
  )
  let rel2: NatLe(
    Nat::pow2(56) * Nat::pow2(Succ(LQ)),
    Nat::pow2(Succ(LP)) * K2
  ) := Int::le_trans(
    IntOfNat(Nat::pow2(56) * Nat::pow2(Succ(LQ))),
    IntOfNat(Nat::pow2(56 + Succ(LQ))),
    IntOfNat(Nat::pow2(Succ(LP)) * K2),
    And::right(r2),
    And::left(r1)
  )
  let hlo: NatLe(
    72057594037927936,
    S
  ) := match int_lt_or_ge(IntOfNat(S), IntOfNat(72057594037927936)): NatLe(72057594037927936, S) {
    OrInl(l) => False::elim(
      a_lo_contra(
        S,
        P,
        Q,
        K2,
        Nat::pow2(LP),
        Nat::pow2(LQ),
        nat_lt_le(S, 72057594037927936, l),
        And::right(hst),
        And::left(hbP),
        rel2,
        And::right(hbQ)
      )
    )
    OrInr(l) => l
  }
  let hhi: NatLe(
    S,
    288230376151711744
  ) := match int_lt_or_ge(IntOfNat(288230376151711744), IntOfNat(S)): NatLe(S, 288230376151711744) {
    OrInl(l) => False::elim(
      a_hi_contra(
        S,
        P,
        Q,
        K2,
        Nat::pow2(LP),
        Nat::pow2(LQ),
        nat_lt_le(288230376151711744, S, l),
        And::left(hst),
        And::right(hbP),
        rel1,
        And::left(hbQ),
        pow2_pos(k)
      )
    )
    OrInr(l) => l
  }
  pack_ok(s, P, Q, S, e, G, hs, fin, inf, hsc, hlo, hhi)
}

// Scaled up by `k >= 2100`: below every subnormal, a zero.
pub theorem frac_up_zero(
  s: Nat,
  P: Nat,
  q0: Nat,
  LP: Nat,
  LQ: Nat,
  G: (Nat) -> Prop,
  hs: s < 2 = true,
  fin: FinK(s, P, Succ(q0), G),
  hbP: BitLen(P, LP),
  hbQ: BitLen(Succ(q0), LQ),
  hle: Succ(LP) <= 56 + Succ(LQ) = true,
  hn: 56 + Succ(LQ) - Succ(LP) < 2100 = false
): G(Float::pack(s, 0, 0)) {
  let k: Nat := 56 + Succ(LQ) - Succ(LP)
  let Q: Nat := Succ(q0)
  let K2: Nat := Nat::pow2(k)
  let eu: 56 + Succ(LQ) = Succ(LP) + k := Nat::le_gap(Succ(LP), 56 + Succ(LQ), hle)
  let r1: And(
    NatLe(Nat::pow2(56 + Succ(LQ)), Nat::pow2(Succ(LP)) * K2),
    NatLe(Nat::pow2(Succ(LP)) * K2, Nat::pow2(56 + Succ(LQ)))
  ) := Eq::subst(
    (w: Nat) => And(
      NatLe(Nat::pow2(w), Nat::pow2(Succ(LP)) * K2),
      NatLe(Nat::pow2(Succ(LP)) * K2, Nat::pow2(w))
    ),
    Eq::sym(eu),
    pow2_split_eq(Succ(LP), k)
  )
  let rel1: NatLe(
    Nat::pow2(Succ(LP)) * K2,
    Nat::pow2(56) * Nat::pow2(Succ(LQ))
  ) := Int::le_trans(
    IntOfNat(Nat::pow2(Succ(LP)) * K2),
    IntOfNat(Nat::pow2(56 + Succ(LQ))),
    IntOfNat(Nat::pow2(56) * Nat::pow2(Succ(LQ))),
    And::right(r1),
    And::left(pow2_split_eq(56, Succ(LQ)))
  )
  let yb: NatLe(
    P * Nat::pow2(4000),
    Q * Nat::pow2(2926)
  ) := a_zero_yb(
    P,
    Nat::pow2(4000),
    Q,
    Nat::pow2(2926),
    Nat::pow2(LP),
    Nat::pow2(LQ),
    K2,
    Nat::pow2(1900),
    Nat::pow2(2100),
    Nat::pow2(1026),
    And::right(hbP),
    And::left(hbQ),
    rel1,
    pow2_le(2100, k, nat_ge_of_not_lt(k, 2100, hn)),
    And::left(pow2_split_at(2100, 1900, 4000, Refl)),
    And::right(pow2_split_at(1026, 1900, 2926, Refl)),
    pow2_le(57, 1026, Refl)
  )
  let g: G(
    Float::encode(s, 0, 2926)
  ) := fin(
    0,
    2926,
    float_decode_sub(s, 0, hs, Refl),
    AndIntro(
      err0_a(Nat::pow2(2926), Q, P * Nat::pow2(4000), yb),
      err0_b(Nat::pow2(2926), Q, P * Nat::pow2(4000), yb)
    )
  )
  Eq::subst((w: Nat) => G(w), enc_zero(s), g)
}

// `up < down` from `nat_le(down, up) = no`.
pub theorem up_le_down(up: Nat, down: Nat, h: down <= up = false): NatLe(up, down) {
  match int_lt_or_ge(IntOfNat(down), IntOfNat(up)): NatLe(up, down) {
    OrInl(l) => False::elim(
      false_ne_true(
        Eq::trans(Eq::sym(h), yn_of_nat_le(down, up, int_le_of_lt(IntOfNat(down), IntOfNat(up), l)))
      )
    )
    OrInr(l) => l
  }
}

// Scaled down by `k < 1100`: the sticky digits of `p / (q 2^k)`, at `e = 3999 + k`.
pub theorem frac_down(
  s: Nat,
  P: Nat,
  q0: Nat,
  LP: Nat,
  LQ: Nat,
  G: (Nat) -> Prop,
  hs: s < 2 = true,
  fin: FinK(s, P, Succ(q0), G),
  inf: G(Float::inf_raw(s)),
  hbP: BitLen(P, LP),
  hbQ: BitLen(Succ(q0), LQ),
  hle: Succ(LP) <= 56 + Succ(LQ) = false
): G(
  Float::pack(
    s,
    Float::sticky(P, Succ(q0) * Nat::pow2(Succ(LP) - (56 + Succ(LQ)))),
    3999 + (Succ(LP) - (56 + Succ(LQ)))
  )
) {
  let k: Nat := Succ(LP) - (56 + Succ(LQ))
  let Q: Nat := Succ(q0)
  let K2: Nat := Nat::pow2(k)
  let e: Nat := 3999 + k
  let Q2: Nat := Q * K2
  let S: Nat := Float::sticky(P, Q2)
  let eq2: Q2 = Succ(Q2 - 1) := succ_pred(Q2, qk_one(q0, K2, pow2_pos(k)))
  let hst: StickyOk(
    S,
    P,
    Q2
  ) := Eq::subst(
    (w: Nat) => StickyOk(Float::sticky(P, w), P, w),
    Eq::sym(eq2),
    sticky_ok(P, Q2 - 1)
  )
  let hpe: And(
    NatLe(Nat::pow2(e), Nat::pow2(3999) * K2),
    NatLe(Nat::pow2(3999) * K2, Nat::pow2(e))
  ) := pow2_split_eq(3999, k)
  let z4: And(
    NatLe(Nat::pow2(4000), 2 * Nat::pow2(3999)),
    NatLe(2 * Nat::pow2(3999), Nat::pow2(4000))
  ) := pow2_4000_le()
  let hsc: ScaledOk(
    S,
    P,
    Q,
    Nat::pow2(e),
    Nat::pow2(4000)
  ) := AndIntro(
    scaled_b1(
      S,
      P,
      Q,
      K2,
      Nat::pow2(e),
      Nat::pow2(4000),
      Nat::pow2(3999),
      And::left(hst),
      And::left(hpe),
      And::right(hpe),
      And::right(z4)
    ),
    scaled_b2(
      S,
      P,
      Q,
      K2,
      Nat::pow2(e),
      Nat::pow2(4000),
      Nat::pow2(3999),
      And::right(hst),
      And::right(hpe),
      And::left(z4)
    )
  )
  let ed: Succ(
    LP
  ) = 56 + Succ(
    LQ
  ) + k := Nat::le_gap(
    56 + Succ(LQ),
    Succ(LP),
    yn_of_nat_le(56 + Succ(LQ), Succ(LP), up_le_down(56 + Succ(LQ), Succ(LP), hle))
  )
  let r1: And(
    NatLe(Nat::pow2(Succ(LP)), Nat::pow2(56 + Succ(LQ)) * K2),
    NatLe(Nat::pow2(56 + Succ(LQ)) * K2, Nat::pow2(Succ(LP)))
  ) := Eq::subst(
    (w: Nat) => And(
      NatLe(Nat::pow2(w), Nat::pow2(56 + Succ(LQ)) * K2),
      NatLe(Nat::pow2(56 + Succ(LQ)) * K2, Nat::pow2(w))
    ),
    Eq::sym(ed),
    pow2_split_eq(56 + Succ(LQ), k)
  )
  let r2: And(
    NatLe(Nat::pow2(56 + Succ(LQ)), Nat::pow2(56) * Nat::pow2(Succ(LQ))),
    NatLe(Nat::pow2(56) * Nat::pow2(Succ(LQ)), Nat::pow2(56 + Succ(LQ)))
  ) := pow2_split_eq(56, Succ(LQ))
  let rel1: NatLe(
    2 * Nat::pow2(LP),
    Nat::pow2(56) * (2 * Nat::pow2(LQ) * K2)
  ) := relb1(
    Nat::pow2(Succ(LP)),
    Nat::pow2(56 + Succ(LQ)),
    K2,
    Nat::pow2(56),
    Nat::pow2(LQ),
    And::left(r1),
    And::left(r2)
  )
  let rel2: NatLe(
    Nat::pow2(56) * (2 * Nat::pow2(LQ) * K2),
    2 * Nat::pow2(LP)
  ) := relb2(
    Nat::pow2(Succ(LP)),
    Nat::pow2(56 + Succ(LQ)),
    K2,
    Nat::pow2(56),
    Nat::pow2(LQ),
    And::right(r1),
    And::right(r2)
  )
  let hlo: NatLe(
    72057594037927936,
    S
  ) := match int_lt_or_ge(IntOfNat(S), IntOfNat(72057594037927936)): NatLe(72057594037927936, S) {
    OrInl(l) => False::elim(
      b_lo_contra(
        S,
        P,
        Q,
        K2,
        Nat::pow2(LP),
        Nat::pow2(LQ),
        nat_lt_le(S, 72057594037927936, l),
        And::right(hst),
        And::left(hbP),
        rel2,
        And::right(hbQ),
        pow2_pos(k)
      )
    )
    OrInr(l) => l
  }
  let hhi: NatLe(
    S,
    288230376151711744
  ) := match int_lt_or_ge(IntOfNat(288230376151711744), IntOfNat(S)): NatLe(S, 288230376151711744) {
    OrInl(l) => False::elim(
      b_hi_contra(
        S,
        P,
        Q,
        K2,
        Nat::pow2(LP),
        Nat::pow2(LQ),
        nat_lt_le(288230376151711744, S, l),
        And::left(hst),
        And::right(hbP),
        rel1,
        And::left(hbQ)
      )
    )
    OrInr(l) => l
  }
  pack_ok(s, P, Q, S, e, G, hs, fin, inf, hsc, hlo, hhi)
}

// The bits of `±(p0 + 1) / (q0 + 1)`: a finite result within the error, or an infinity.
pub theorem frac_ok(
  s: Nat,
  p0: Nat,
  q0: Nat,
  G: (Nat) -> Prop,
  hs: s < 2 = true,
  fin: FinK(s, Succ(p0), Succ(q0), G),
  inf: G(Float::inf_raw(s))
): G(Float::of_frac(s, Succ(p0), Succ(q0))) {
  let LP: Nat := Float::bitlen(p0, Nat::div_nz(Succ(p0), 2, Nat::ne_zero(2, Refl)))
  let LQ: Nat := Float::bitlen(q0, Nat::div_nz(Succ(q0), 2, Nat::ne_zero(2, Refl)))
  let hbP: BitLen(Succ(p0), LP) := rat_len_spec(p0)
  let hbQ: BitLen(Succ(q0), LQ) := rat_len_spec(q0)
  let up: Nat := 56 + Succ(LQ)
  let down: Nat := Succ(LP)
  let r: G(
    float_scaled_by(down <= up, Float::pack, Float::inf_raw(s), s, Succ(p0), Succ(q0), up, down)
  ) := match float_yn_or(
    down <= up
  ): G(
    float_scaled_by(down <= up, Float::pack, Float::inf_raw(s), s, Succ(p0), Succ(q0), up, down)
  ) {
    OrInl(hle) => Eq::subst(
      (o: Bool) => G(float_scaled_by(o, Float::pack, Float::inf_raw(s), s, Succ(p0), Succ(q0), up, down)),
      Eq::sym(hle),
      match float_yn_or(up - down < 2100): G(float_scaled_up_by(up - down < 2100, Float::pack, s, Succ(p0), Succ(q0), up, down)) {
        OrInl(hk) => Eq::subst(
          (o: Bool) => G(float_scaled_up_by(o, Float::pack, s, Succ(p0), Succ(q0), up, down)),
          Eq::sym(hk),
          frac_up(s, Succ(p0), q0, LP, LQ, G, hs, fin, inf, hbP, hbQ, hle, hk)
        )
        OrInr(hn) => Eq::subst(
          (o: Bool) => G(float_scaled_up_by(o, Float::pack, s, Succ(p0), Succ(q0), up, down)),
          Eq::sym(hn),
          frac_up_zero(s, Succ(p0), q0, LP, LQ, G, hs, fin, hbP, hbQ, hle, hn)
        )
      }
    )
    OrInr(hle) => Eq::subst(
      (o: Bool) => G(float_scaled_by(o, Float::pack, Float::inf_raw(s), s, Succ(p0), Succ(q0), up, down)),
      Eq::sym(hle),
      match float_yn_or(down - up < 1100): G(float_scaled_down_by(down - up < 1100, Float::pack, Float::inf_raw(s), s, Succ(p0), Succ(q0), up, down)) {
        OrInl(hk) => Eq::subst(
          (o: Bool) => G(float_scaled_down_by(o, Float::pack, Float::inf_raw(s), s, Succ(p0), Succ(q0), up, down)),
          Eq::sym(hk),
          frac_down(s, Succ(p0), q0, LP, LQ, G, hs, fin, inf, hbP, hbQ, hle)
        )
        OrInr(hn) => Eq::subst(
          (o: Bool) => G(float_scaled_down_by(o, Float::pack, Float::inf_raw(s), s, Succ(p0), Succ(q0), up, down)),
          Eq::sym(hn),
          inf
        )
      }
    )
  }
  r
}
