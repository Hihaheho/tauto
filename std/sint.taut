// `a / b` rounded toward zero, `divzero` when `b` is 0, or `overflow` when it does not fit.
pub fn SInt::tdiv64(a: SInt(64), b: SInt(64)): SInt(64) ! {divzero, overflow} {
  ⊢ SInt(64) from match Int::eq(SInt::val64(b), 0) {
    false => SInt::or_overflow64(SInt::checked_tdiv64(a, b))
    true => Never::elim(perform divzero())
  }
}

// The remainder of `tdiv_nz`, with the sign of `a`, or `None` when it does not fit.
pub fn SInt::tmod_nz64(a: SInt(64), b: SInt(64), h: ¬(SInt::val64(b) = 0)): Option(SInt(64)) {
  SInt::of_int64(Int::tmod_nz(SInt::val64(a), SInt::val64(b), h))
}

// `tmod`, or `None` when `b` is 0 or it does not fit.
pub fn SInt::checked_tmod64(a: SInt(64), b: SInt(64)): Option(SInt(64)) {
  match Int::eq(SInt::val64(b), 0) eqn h {
    false => SInt::tmod_nz64(a, b, Int::ne_zero(SInt::val64(b), h))
    true => None
  }
}

// The remainder of `tdiv`, with the sign of `a`, `divzero` when `b` is 0, or `overflow` when it does not fit.
pub fn SInt::tmod64(a: SInt(64), b: SInt(64)): SInt(64) ! {divzero, overflow} {
  ⊢ SInt(64) from match Int::eq(SInt::val64(b), 0) {
    false => SInt::or_overflow64(SInt::checked_tmod64(a, b))
    true => Never::elim(perform divzero())
  }
}

// `a / b` rounded down for a `b` that `h` says is not 0, or `None` when it does not fit.
pub fn SInt::fdiv_nz64(a: SInt(64), b: SInt(64), h: ¬(SInt::val64(b) = 0)): Option(SInt(64)) {
  SInt::of_int64(Int::fdiv_nz(SInt::val64(a), SInt::val64(b), h))
}

// `fdiv`, or `None` when `b` is 0 or it does not fit.
pub fn SInt::checked_fdiv64(a: SInt(64), b: SInt(64)): Option(SInt(64)) {
  match Int::eq(SInt::val64(b), 0) eqn h {
    false => SInt::fdiv_nz64(a, b, Int::ne_zero(SInt::val64(b), h))
    true => None
  }
}

// `a / b` rounded down, `divzero` when `b` is 0, or `overflow` when it does not fit.
pub fn SInt::fdiv64(a: SInt(64), b: SInt(64)): SInt(64) ! {divzero, overflow} {
  ⊢ SInt(64) from match Int::eq(SInt::val64(b), 0) {
    false => SInt::or_overflow64(SInt::checked_fdiv64(a, b))
    true => Never::elim(perform divzero())
  }
}

// The remainder of `fdiv_nz`, with the sign of `b`, or `None` when it does not fit.
pub fn SInt::fmod_nz64(a: SInt(64), b: SInt(64), h: ¬(SInt::val64(b) = 0)): Option(SInt(64)) {
  SInt::of_int64(Int::fmod_nz(SInt::val64(a), SInt::val64(b), h))
}

// `fmod`, or `None` when `b` is 0 or it does not fit.
pub fn SInt::checked_fmod64(a: SInt(64), b: SInt(64)): Option(SInt(64)) {
  match Int::eq(SInt::val64(b), 0) eqn h {
    false => SInt::fmod_nz64(a, b, Int::ne_zero(SInt::val64(b), h))
    true => None
  }
}

// The remainder of `fdiv`, with the sign of `b`, `divzero` when `b` is 0, or `overflow` when it does not fit.
pub fn SInt::fmod64(a: SInt(64), b: SInt(64)): SInt(64) ! {divzero, overflow} {
  ⊢ SInt(64) from match Int::eq(SInt::val64(b), 0) {
    false => SInt::or_overflow64(SInt::checked_fmod64(a, b))
    true => Never::elim(perform divzero())
  }
}

// `overflow` caught as `None`.
pub fn SInt::catch64(o: Option(SInt(64))): Option(SInt(64)) {
  handle { Some(SInt::or_overflow64(o)) } with {
    overflow() => None
  }
}

pub theorem SInt::catch_is64(o: Option(SInt(64))): SInt::catch64(o) = o {
  match o {
    Some(x) => Refl
    None => Refl
  }
}

pub theorem SInt::add_val64(
  a: SInt(64),
  b: SInt(64),
  h: SInt::fits64(Int::add(SInt::val64(a), SInt::val64(b))) = true
): SInt::val64(SInt::add64(a, b, h)) = Int::add(SInt::val64(a), SInt::val64(b)) {
  Refl
}

pub theorem SInt::sub_val64(
  a: SInt(64),
  b: SInt(64),
  h: SInt::fits64(Int::sub(SInt::val64(a), SInt::val64(b))) = true
): SInt::val64(SInt::sub64(a, b, h)) = Int::sub(SInt::val64(a), SInt::val64(b)) {
  Refl
}

pub theorem SInt::mul_val64(
  a: SInt(64),
  b: SInt(64),
  h: SInt::fits64(Int::mul(SInt::val64(a), SInt::val64(b))) = true
): SInt::val64(SInt::mul64(a, b, h)) = Int::mul(SInt::val64(a), SInt::val64(b)) {
  Refl
}
