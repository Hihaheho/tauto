// The standard library's source. A tote named `std` is the library itself:
// every file here is a module `std::…`, and `import std::…` in it reads this
// directory, not the copy tauto was built with. It depends on nothing.
package {
  name = "std"
  version = "0.1.0"
  // The library declares the prelude: its files import what they use of it.
  prelude = false
}

// The laws of the rationals and the error bounds of rounding normalise many integer equations with
// int_norm! steps; FloatRound consists of such bounds.
check {
  // The quotient's soundness is the one axiom of the library.
  axioms {
    "quot.taut" = ["Quot::sound"]
    "rat_field.taut" = ["Quot::sound"]
  }
  slow {
    "float_bounds_a.taut" = 30
    "float_bounds_b.taut" = 30
    "float_bounds_c.taut" = 30
    "float_decode.taut" = 30
    "float_encode.taut" = 40
    "float_error.taut" = 40
    "float_round.taut" = 60
    "rat_laws.taut" = 60
  }
}
