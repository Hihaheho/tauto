              Int::add(
                Int::mul(IntOfNat(1), IntOfNat(Nat::mul(p, Nat::mul(zm, u)))),
                Int::add(
                  Int::mul(IntOfNat(1), IntOfNat(Nat::mul(p, zm))),
                  Int::add(
                    Int::mul(IntOfNat(1), IntOfNat(Nat::mul(p, u))),
                    Int::add(
                      Int::mul(IntOfNat(1), IntOfNat(p)),
                      Int::add(
                        Int::mul(
                          IntOfNat(1),
                          IntOfNat(Nat::mul(q0, Nat::mul(q0, Nat::mul(zm, f1))))
                        ),
                        Int::add(
                          Int::mul(IntOfNat(1), IntOfNat(Nat::mul(q0, Nat::mul(q0, zm)))),
                          Int::add(
                            Int::mul(IntOfNat(1), IntOfNat(Nat::mul(q0, Nat::mul(q0, f1)))),
                            Int::add(
                              Int::mul(IntOfNat(1), IntOfNat(Nat::mul(q0, q0))),
                              Int::add(
                                Int::mul(IntOfNat(2), IntOfNat(Nat::mul(q0, Nat::mul(zm, f1)))),
                                Int::add(
                                  Int::mul(IntOfNat(2), IntOfNat(Nat::mul(q0, zm))),
                                  Int::add(
                                    Int::mul(IntOfNat(2), IntOfNat(Nat::mul(q0, f1))),
                                    Int::add(
                                      Int::mul(IntOfNat(2), IntOfNat(q0)),
                                      Int::add(
                                        Int::mul(IntOfNat(1), IntOfNat(Nat::mul(zm, f1))),
                                        Int::add(
                                          Int::mul(IntOfNat(1), IntOfNat(zm)),
                                          Int::add(
                                            Int::mul(IntOfNat(1), IntOfNat(f1)),
                                            Int::mul(IntOfNat(1), IntOfNat(1))
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      ),
      IntOfNat(0)
    )
  ) {}
}

// ---- from the raw forms to `rat_dist` -------------------------------------------

// The bound of `float_of_rat`'s error at `r`: `2^-52 |r| + 2^-A`.
pub fn float_round_err(r: Rat, A: Nat): Rat {
  Rat::add(Rat::mul(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A))
}

// `|x| <= e` from `x <= e` and `-x <= e`.
pub theorem rat_abs_le(
  x: Rat,
  e: Rat,
  h1: RatLe(x, e),
  h2: RatLe(Rat::neg(x), e)
): RatLe(Rat::abs(x), e) {
  match x: RatLe(Rat::abs(x), e) {
    Rat::Mk(n, d) => match n: RatLe(Rat::abs(Rat::Mk(n, d)), e) {
      IntOfNat(k) => h1
      IntNegSucc(k) => h2
    }
  }
}

// `2^Z = 2^A 2^B`, each written as a successor.
pub theorem float_pow2_split(
  Z: Nat,
  A: Nat,
  B: Nat,
  hAB: Eq(Nat, Nat::add(A, B), Z)
): Eq(Nat, Succ(Nat::sub(Nat::pow2(Z), 1)), Nat::mul(Succ(Nat::sub(Nat::pow2(A), 1)), Nat::pow2(B))) {
  Eq::trans(
    Eq::sym(nat_pow2_succ(Z)),
    Eq::trans(
      Eq::congr(Nat::pow2, Eq::sym(hAB)),
      Eq::trans(nat_pow2_add(A, B), Eq::congr((w: Nat) => Nat::mul(w, Nat::pow2(B)), nat_pow2_succ(A)))
    )
  )
}

// `v - r` and the bound, as the raw forms `rat_err_pos` and `rat_err_neg` read.
pub theorem float_sub_raw(
  v: Rat,
  v2: Rat,
  r: Rat,
  hv: Rat::equiv(v, v2)
): Rat::equiv(Rat::add_raw(v2, Rat::neg(r)), Rat::sub(v, r)) {
  Rat::equiv_symm(
    Rat::sub(v, r),
    Rat::add_raw(v2, Rat::neg(r)),
    Rat::equiv_trans(
      Rat::sub(v, r),
      Rat::add_raw(v, Rat::neg(r)),
      Rat::add_raw(v2, Rat::neg(r)),
      Rat::add_val(v, Rat::neg(r)),
      Rat::add_raw_congl(v, v2, Rat::neg(r), hv)
    )
  )
}

pub theorem float_err_raw(
  r: Rat,
  A: Nat
): Rat::equiv(
  Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
  float_round_err(r, A)
) {
  Rat::equiv_symm(
    float_round_err(r, A),
    Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
    Rat::equiv_trans(
      float_round_err(r, A),
      Rat::add_raw(Rat::mul(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
      Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
      Rat::add_val(Rat::mul(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
      Rat::add_raw_congl(
        Rat::mul(Rat::abs(r), Rat::pow2_neg(52)),
        Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)),
        Rat::pow2_neg(A),
        Rat::mul_val(Rat::abs(r), Rat::pow2_neg(52))
      )
    )
  )
}

// From both halves on the raw forms to `|v - r| <= bound`.
pub theorem float_dist_le(
  v: Rat,
  v2: Rat,
  r: Rat,
  A: Nat,
  hv: Rat::equiv(v, v2),
  h: And(
    RatLe(
      Rat::add_raw(v2, Rat::neg(r)),
      Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A))
    ),
    RatLe(
      Rat::neg(Rat::add_raw(v2, Rat::neg(r))),
      Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A))
    )
  )
): RatLe(Rat::dist(v, r), float_round_err(r, A)) {
  let ex: Rat::equiv(Rat::add_raw(v2, Rat::neg(r)), Rat::sub(v, r)) := float_sub_raw(v, v2, r, hv)
  let ee: Rat::equiv(
    Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
    float_round_err(r, A)
  ) := float_err_raw(r, A)
  rat_abs_le(
    Rat::sub(v, r),
    float_round_err(r, A),
    Rat::le_congr(
      Rat::sub(v, r),
      Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
      float_round_err(r, A),
      ee,
      Rat::le_congl(
        Rat::add_raw(v2, Rat::neg(r)),
        Rat::sub(v, r),
        Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
        ex,
        And::left(h)
      )
    ),
    Rat::le_congr(
      Rat::neg(Rat::sub(v, r)),
      Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
      float_round_err(r, A),
      ee,
      Rat::le_congl(
        Rat::neg(Rat::add_raw(v2, Rat::neg(r))),
        Rat::neg(Rat::sub(v, r)),
        Rat::add_raw(Rat::mul_raw(Rat::abs(r), Rat::pow2_neg(52)), Rat::pow2_neg(A)),
        Rat::neg_congr(Rat::add_raw(v2, Rat::neg(r)), Rat::sub(v, r), ex),
        And::right(h)
      )
    )
  )
}

// A positive `r = p / (q0 + 1)` and a value `v = c 2^t / 2^Z`.
pub theorem float_dist_pos(
  c: Nat,
  t: Nat,
  p: Nat,
  q0: Nat,
  v: Rat,
  Z: Nat,
  A: Nat,
  B: Nat,
  hAB: Eq(Nat, Nat::add(A, B), Z),
  hv: Rat::equiv(v, float_scaledz(Z, 0, c, t)),
  he: ErrOk(
    Nat::mul(Nat::mul(c, Nat::pow2(t)), Succ(q0)),
    Nat::mul(p, Nat::pow2(Z)),
    Nat::mul(Succ(q0), Nat::pow2(B))
  )
): RatLe(Rat::dist(v, Rat::Mk(IntOfNat(p), q0)), float_round_err(Rat::Mk(IntOfNat(p), q0), A)) {
  float_dist_le(
    v,
    float_scaledz(Z, 0, c, t),
    Rat::Mk(IntOfNat(p), q0),
    A,
    hv,
    rat_err_pos(
      c,
      Nat::pow2(t),
      p,
      q0,
      Nat::sub(Nat::pow2(Z), 1),
      Nat::sub(Nat::pow2(A), 1),
      Nat::pow2(B),
      4503599627370495,
      float_pow2_split(Z, A, B, hAB),
      Refl,
      Eq::subst(
        (w: Nat) => ErrOk(
          Nat::mul(Nat::mul(c, Nat::pow2(t)), Succ(q0)),
          Nat::mul(p, w),
          Nat::mul(Succ(q0), Nat::pow2(B))
        ),
        Eq::trans(nat_pow2_succ(Z), float_pow2_split(Z, A, B, hAB)),
        he
      )
    )
  )
}

// A negative `r = -(p0 + 1) / (q0 + 1)` and a value `v = -c 2^t / 2^Z`.
pub theorem float_dist_neg(
  c: Nat,
  t: Nat,
  p0: Nat,
  q0: Nat,
  v: Rat,
  Z: Nat,
  A: Nat,
  B: Nat,
  hAB: Eq(Nat, Nat::add(A, B), Z),
  hv: Rat::equiv(v, float_scaledz(Z, 1, c, t)),
  he: ErrOk(
    Nat::mul(Nat::mul(c, Nat::pow2(t)), Succ(q0)),
    Nat::mul(Succ(p0), Nat::pow2(Z)),
    Nat::mul(Succ(q0), Nat::pow2(B))
  )
): RatLe(Rat::dist(v, Rat::Mk(IntNegSucc(p0), q0)), float_round_err(Rat::Mk(IntNegSucc(p0), q0), A)) {
  float_dist_le(
    v,
    float_scaledz(Z, 1, c, t),
    Rat::Mk(IntNegSucc(p0), q0),
    A,
    hv,
    rat_err_neg(
      c,
      Nat::pow2(t),
      Succ(p0),
      q0,
      Nat::sub(Nat::pow2(Z), 1),
      Nat::sub(Nat::pow2(A), 1),
      Nat::pow2(B),
      4503599627370495,
      float_pow2_split(Z, A, B, hAB),
      Refl,
      Eq::subst(
        (w: Nat) => ErrOk(
          Nat::mul(Nat::mul(c, Nat::pow2(t)), Succ(q0)),
          Nat::mul(Succ(p0), w),
          Nat::mul(Succ(q0), Nat::pow2(B))
        ),
        Eq::trans(nat_pow2_succ(Z), float_pow2_split(Z, A, B, hAB)),
        he
      )
    )
  )
}
