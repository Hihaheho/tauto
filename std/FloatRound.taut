// The rounding error of `float_of_rat`: the pieces of `FloatError.taut` and
// `FloatEncode.taut` put together, and read as rationals.

import "FloatError.taut"
import "FloatEncode.taut"

// ---- the error as rationals ------------------------------------------------------

pub theorem rat_err_pos(
  c: Nat,
  T: Nat,
  p: Nat,
  q0: Nat,
  zm: Nat,
  u: Nat,
  D: Nat,
  f1: Nat,
  hz: Eq(Nat, Succ(zm), Nat::mul(Succ(u), D)),
  hf: Eq(Nat, Succ(f1), 4503599627370496),
  he: ErrOk(Nat::mul(Nat::mul(c, T), Succ(q0)), Nat::mul(p, Nat::mul(Succ(u), D)), Nat::mul(Succ(q0), D))
): And(
  RatLe(
    Rat::add_raw(Rat::Mk(IntOfNat(Nat::mul(c, T)), zm), Rat::Mk(Int::neg(IntOfNat(p)), q0)),
    Rat::add_raw(Rat::mul_raw(Rat::Mk(IntOfNat(p), q0), Rat::Mk(IntOfNat(1), f1)), Rat::Mk(IntOfNat(1), u))
  ),
  RatLe(
    Rat::neg(Rat::add_raw(Rat::Mk(IntOfNat(Nat::mul(c, T)), zm), Rat::Mk(Int::neg(IntOfNat(p)), q0))),
    Rat::add_raw(Rat::mul_raw(Rat::Mk(IntOfNat(p), q0), Rat::Mk(IntOfNat(1), f1)), Rat::Mk(IntOfNat(1), u))
