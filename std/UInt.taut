  // Mapped: `a` rotated right by `s` modulo 32.
  pub fn rotr(a: U32, s: Nat): U32 {
    U32::Mk(
      Nat::rem_nz(
        Nat::add(
          Nat::div_nz(
            val(a),
            Nat::pow2(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl))),
            Nat::pow2_ne_zero(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))
          ),
          Nat::rem_nz(
            Nat::mul(val(a), Nat::pow2(32 - Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))),
            4294967296,
            Nat::ne_zero(4294967296, Refl)
          )
        ),
        4294967296,
        Nat::ne_zero(4294967296, Refl)
      ),
      Nat::mod_lt(
        Nat::add(
          Nat::div_nz(
            val(a),
            Nat::pow2(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl))),
            Nat::pow2_ne_zero(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))
          ),
          Nat::rem_nz(
            Nat::mul(val(a), Nat::pow2(32 - Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))),
            4294967296,
            Nat::ne_zero(4294967296, Refl)
          )
        ),
        4294967296,
        Refl
      )
    )
  }

  pub theorem and_val(
    a: U32,
    b: U32
  ): val(
    and(a, b)
  ) = Nat::rem_nz(Nat::bits_and(32, val(a), val(b)), 4294967296, Nat::ne_zero(4294967296, Refl)) {
    Refl
  }

  pub theorem or_val(
    a: U32,
    b: U32
  ): val(
    or(a, b)
  ) = Nat::rem_nz(Nat::bits_or(32, val(a), val(b)), 4294967296, Nat::ne_zero(4294967296, Refl)) {
    Refl
  }

  pub theorem xor_val(
    a: U32,
    b: U32
  ): val(
    xor(a, b)
  ) = Nat::rem_nz(Nat::bits_xor(32, val(a), val(b)), 4294967296, Nat::ne_zero(4294967296, Refl)) {
    Refl
  }

  pub theorem shl_val(
    a: U32,
    s: Nat
  ): val(
    shl(a, s)
  ) = Nat::rem_nz(
    Nat::mul(val(a), Nat::pow2(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))),
    4294967296,
    Nat::ne_zero(4294967296, Refl)
  ) {
    Refl
  }

  pub theorem shr_val(
    a: U32,
    s: Nat
  ): val(
    shr(a, s)
  ) = Nat::rem_nz(
    Nat::div_nz(
      val(a),
      Nat::pow2(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl))),
      Nat::pow2_ne_zero(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))
    ),
    4294967296,
    Nat::ne_zero(4294967296, Refl)
  ) {
    Refl
  }

  pub theorem rotl_val(
    a: U32,
    s: Nat
  ): val(
    rotl(a, s)
  ) = Nat::rem_nz(
    Nat::add(
      Nat::rem_nz(
        Nat::mul(val(a), Nat::pow2(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))),
        4294967296,
        Nat::ne_zero(4294967296, Refl)
      ),
      Nat::div_nz(
        val(a),
        Nat::pow2(32 - Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl))),
        Nat::pow2_ne_zero(32 - Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))
      )
    ),
    4294967296,
    Nat::ne_zero(4294967296, Refl)
  ) {
    Refl
  }

  pub theorem rotr_val(
    a: U32,
    s: Nat
  ): val(
    rotr(a, s)
  ) = Nat::rem_nz(
    Nat::add(
      Nat::div_nz(
        val(a),
        Nat::pow2(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl))),
        Nat::pow2_ne_zero(Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))
      ),
      Nat::rem_nz(
        Nat::mul(val(a), Nat::pow2(32 - Nat::rem_nz(s, 32, Nat::ne_zero(32, Refl)))),
        4294967296,
        Nat::ne_zero(4294967296, Refl)
      )
    ),
    4294967296,
    Nat::ne_zero(4294967296, Refl)
  ) {
    Refl
  }
}
