@ cases.a-handler-answers-an-overflow
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
description = "A fixed-width result that does not fit performs `overflow`; a handler around it answers it."
source = ```tauto
fn next(x: u64): u64 ! {overflow} { x + 1 }
let r := handle { next(18446744073709551615) } with { overflow() => 7 }
show(&r)
let s := handle { next(41) } with { overflow() => 0 }
show(&s)
```
stdout = "7\n42\n"

@ cases.a-handler-answers-a-float-division-by-zero
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
description = "`/` on `Float` by zero performs `divzero`; a handler around it answers it."
source = ```tauto
fn half(x: Float, y: Float): Float ! {divzero} { x / y }
let r := handle { half(1.0, 0.0) } with { divzero() => 2.5 }
show(&r)
```
stdout = "2.5\n"

@ cases.an-overflow-nothing-handles-stops-the-program
description = "The host answers an `overflow` that nothing handles by stopping the program."
source = ```tauto
fn next(x: u64): u64 ! {overflow} { x + 1 }
show(&next(18446744073709551615))
```
run_error = "the number is too large"

@ cases.a-handler-answers-an-integer-division-by-zero
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
description = "`div` and `mod` of integers by zero perform `divzero`; a handler around them answers it."
source = ```tauto
fn q(x: i64, y: i64): i64 ! {divzero} { div(x, y) }
fn r(x: u64, y: u64): u64 ! {divzero} { mod(x, y) }
show(&handle { q(7, 0) } with { divzero() => 11 })
show(&handle { r(7, 0) } with { divzero() => 12 })
show(&handle { q(7, 2) } with { divzero() => 0 })
show(&handle { r(7, 2) } with { divzero() => 0 })
```
stdout = "11\n12\n3\n1\n"

