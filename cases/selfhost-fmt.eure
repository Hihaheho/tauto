@ cases.fmt-hard-long-record-literal
source = ```tauto
fn f(): () {
  let r = Request { method: method, url: target, headers: host_paired_headers(headers), body: body }
  Pair { fst: a, snd: b } => yn_cases(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, c)
  f(Request { method: method, url: target, headers: host_paired_headers(headers), body: body })
}
```
differential = "fmt"

@ cases.fmt-hard-nested-record-literals
source = ```tauto
fn nest(a: List(Nat), b: List(Nat)): Pair(Pair(List(Nat), List(Nat)), Pair(Pair(List(Nat), List(Nat)), Pair(List(Nat), List(Nat)))) {
  Pair { fst: Pair { fst: Nil, snd: a }, snd: Pair { fst: Pair { fst: Nil, snd: List.map((x: Nat) => x, b) }, snd: Pair { fst: Pair { fst: Nil, snd: List.map((x: Nat) => x, a) }, snd: Pair { fst: Nil, snd: b } } } }
}
fn f(g: () -> Nat ! {Div, stdout, stderr, argv, wall_clock, monotonic_clock, sleep, random, fs_read, fs_write}): Nat {
  zero
}
```
differential = "fmt"

@ cases.fmt-short-blocks-on-one-line
source = ```tauto
pub(open) inductive R: Type {
  R0: R
  R1: R,
  R2: R
}
fn next(r: R): R {
  match r {
    R0 => R1
    R1 => R2
    R2 => R0
  }
}
fn path(r: R): Nat {
  match r {
    R::R0 => 0
    _ => 1
  }
}
fn noted(r: R): Nat {
  match r {
    R0 => 0 // zero
    _ => 1
  }
}
fn called(r: R): Nat {
  match r {
    R0 => f(0)
    _ => 1
  }
}
fn inside(r: R): Nat {
  f(match r {
    R0 => 0
    _ => 1
  })
}
```
differential = "fmt"

// An implicit-argument block `<A: A, R: R>` stays on one line: its commas do not split the call's arguments.
@ cases.fmt-implicit-arguments-stay-on-one-line
source = ```tauto
fn t(): Nat {
  Acc::ind(
    <A: A, R: R>,
    x2 => a2 => fix(R, B, F, x2, a2) = F(x2, y => r => fix(R, B, F, y, wf(y))),
    x
  )
}
```
differential = "fmt"
