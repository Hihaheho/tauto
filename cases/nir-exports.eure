package {
  name = "app"
  version = "0.1.0"
}
exports = ["keep"]
```
files."app/src/main.taut" = ```tauto
pub fn keep<A>(a: A): A { a }
#()
```
nir.error = "exports names `keep`, which has generics"

@ cases.an-export-of-a-tote-not-read-is-an-error
files_tote = "app"
files."app/Tauto.eure" = ```eure
package {
  name = "app"
  version = "0.1.0"
}
exports = ["other::*"]
```
files."app/src/main.taut" = ```tauto
#()
```
nir.error = "`other` is not a tote the program reads"

// `tauto build FILE`: a file entry reads the `exports` and the dependencies of
// the tote that holds it, as `--tote` does, and `--export` adds to them. A tote
// is named as in its `Tauto.eure`: `fire-systems`, with the `-`.

@ cases.file-entry-exports-a-whole-dependency-tote
files."fire-systems/Tauto.eure" = ```eure
package {
  name = "fire-systems"
  version = "0.1.0"
}
```
files."fire-systems/src/lib.taut" = ```tauto
pub fn steer(): Text { "fire" }
pub fn burner(): Text { "burn" }
```
files."other/Tauto.eure" = ```eure
package {
  name = "other"
  version = "0.1.0"
}
```
files."app/Tauto.eure" = ```eure
package {
  name = "app"
  version = "0.1.0"
}
dependencies {
  fire-systems { path = "../fire-systems" }
  other { path = "../other" }
}
```
files."app/src/main.taut" = ```tauto
import std::builtin::os
import fire_systems::lib { steer }
fn go(): Unit ! {stdout} { perform stdout(steer()) }
perform main(() => go())
```
entry = "app/src/main.taut"
extract = true
nir.target = "llvm"
nir.export = ["fire-systems::*"]
nir.exports = ```nir
export "fire-systems::lib::steer" = steer@2 row() foreign_row() pure_borrow_callbacks()
export "fire-systems::lib::burner" = burner@3 row() foreign_row() pure_borrow_callbacks()
```

// A dependency the entry does not import is exported all the same: the
// entry's `Tauto.eure` names it, so `TOTE::*` reads its sources.
@ cases.file-entry-exports-a-dependency-tote-it-does-not-import
files."fire-systems/Tauto.eure" = ```eure
package {
  name = "fire-systems"
  version = "0.1.0"
}
```
files."fire-systems/src/lib.taut" = ```tauto
pub fn steer(): Text { "fire" }
```
files."other/Tauto.eure" = ```eure
package {
  name = "other"
  version = "0.1.0"
}
```
files."other/src/lib.taut" = ```tauto
pub fn only_other(): Text { "oo" }
fn hidden(): Text { "no" }
```
files."app/Tauto.eure" = ```eure
package {
  name = "app"
  version = "0.1.0"
}
dependencies {
  fire-systems { path = "../fire-systems" }
  other { path = "../other" }
}
```
files."app/src/main.taut" = ```tauto
import std::builtin::os
import fire_systems::lib { steer }
fn go(): Unit ! {stdout} { perform stdout(steer()) }
perform main(() => go())
```
entry = "app/src/main.taut"
extract = true
nir.target = "llvm"
nir.export = ["other::*", "fire-systems::*"]
nir.exports = ```nir
export "other::lib::only_other" = only_other@3 row() foreign_row() pure_borrow_callbacks()
export "fire-systems::lib::steer" = steer@2 row() foreign_row() pure_borrow_callbacks()
```

