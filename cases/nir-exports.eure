// `TOTE::*` exports each method of every instance the tote writes, called or
// not: an instance has no `pub`. The line names it
// `TOTE::MODULE::instance CLASS(TYPE)::METHOD`, where the instance is written,
// the class and the type each named as an export names a declaration, so that
// a host lists the instances a tote declares from the export lines alone. A
// builtin type is written as it is. An instance with generics has no code of
// its own and is left out, as a generic function is.
@ cases.a-whole-tote-exports-the-methods-of-its-instances
files."lib/Tauto.eure" = ```eure
package {
  name = "lib"
  version = "0.1.0"
}
```
files."lib/src/lib.taut" = ```tauto
pub(open) class Named(T: Shared) {
  fn label(v: T): Text
}

pub fn describe<T: Shared>(v: T): Text where Named(T) { Named::label(v) }
```
files."shapes/Tauto.eure" = ```eure
package {
  name = "shapes"
  version = "0.1.0"
}
dependencies {
  lib { path = "../lib" }
}
```
files."shapes/src/lib.taut" = ```tauto
import lib::lib { Named, describe }

pub struct Circle { r: i64 }
pub struct Square { side: i64 }
pub struct Wrap(A: Shared) { a: A }

instance Named(Circle) { fn label(v: Circle): Text { "circle" } }
instance Named(Square) { fn label(v: Square): Text { "square" } }
instance Named(i64) { fn label(v: i64): Text { "int" } }
instance<A: Shared> Named(Wrap(A)) { fn label(v: Wrap(A)): Text { "wrap" } }

pub fn plain(): Text { "plain" }
pub fn uses_circle(): Text { describe(Circle { r: 1 }) }
```
files."app/Tauto.eure" = ```eure
package {
  name = "app"
  version = "0.1.0"
}
dependencies {
  lib { path = "../lib" }
  shapes { path = "../shapes" }
}
```
files."app/src/main.taut" = ```tauto
import std::builtin::os
import shapes::lib { plain, uses_circle }

fn go(): Unit ! {stdout} {
  perform stdout(plain())
  perform stdout(uses_circle())
}

perform main(() => go())
```
entry = "app/src/main.taut"
extract = true
nir.target = "llvm"
nir.export = ["shapes::*"]
nir.exports = ```nir
export "shapes::lib::instance lib::lib::Named(shapes::lib::Circle)::label" = $"Named::label@Circle"@2 row() foreign_row() pure_borrow_callbacks()
export "shapes::lib::instance lib::lib::Named(shapes::lib::Square)::label" = $"Named::label@Square"@3 row() foreign_row() pure_borrow_callbacks()
export "shapes::lib::instance lib::lib::Named(i64)::label" = $"Named::label@i64"@4 row() foreign_row() pure_borrow_callbacks()
export "shapes::lib::plain" = plain@5 row() foreign_row() pure_borrow_callbacks()
export "shapes::lib::uses_circle" = uses_circle@6 row() foreign_row() pure_borrow_callbacks()
```

// An instance an attribute macro makes is exported as one written there: it is
