// `exports` in a tote's manifest: the functions a host calls by name. Each is
// a root of the package and an `export` line, whatever its row. The line names
// it `TOTE::MODULE::FUNCTION`, the tote as its `Tauto.eure` names it, whatever
// else the program declares; a file outside every tote is `MODULE::FUNCTION`.

@ cases.named-functions-and-a-whole-tote-are-exported
files_tote = "app"
files."app/Tauto.eure" = ```eure
package {
  name = "app"
  version = "0.1.0"
}
dependencies {
  game { path = "../game" }
}
exports = ["game::*", "double"]
```
files."app/src/main.taut" = ```tauto
pub fn double(x: i64): i64 ! {overflow} { x * 2 }
fn unlisted(x: i64): i64 ! {overflow} { x + 3 }
#()
```
files."game/Tauto.eure" = ```eure
package {
  name = "game"
  version = "0.1.0"
}
```
files."game/src/systems.taut" = ```tauto
import std::builtin::os
pub fn step(x: i64): i64 ! {overflow} { x + 1 }
pub fn report(x: i64): i64 ! {stdout} { print("tick\n"); x }
fn hidden(x: i64): i64 ! {overflow} { x + 2 }
pub fn keep<A>(a: A): A { a }
```
nir.target = "llvm"
nir.exports = ```nir
export "game::systems::step" = step@1 row("overflow") foreign_row("overflow") pure_borrow_callbacks()
export "game::systems::report" = report@2 row("stdout") foreign_row() pure_borrow_callbacks()
export "app::main::double" = double@3 row("overflow") foreign_row("overflow") pure_borrow_callbacks()
```

@ cases.an-unknown-export-is-an-error
files_tote = "app"
files."app/Tauto.eure" = ```eure
package {
  name = "app"
  version = "0.1.0"
}
exports = ["missing"]
```
files."app/src/main.taut" = ```tauto
#()
```
nir.error = "exports names `missing`, which is not a function of the program"

@ cases.a-generic-export-is-an-error
files_tote = "app"
