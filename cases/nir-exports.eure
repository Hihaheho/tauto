// An imported file's `pub` function nobody calls is a root all the same when
// it is named: extraction keeps it.
@ cases.file-entry-exports-uncalled-imported-functions
files."main.taut" = ```tauto
import std::builtin::os
import "a.taut" { steer, burner }
pub fn lonely(): Text { "lonely" }
fn go(): Unit ! {stdout} { perform stdout(steer()) }
perform main(() => go())
```
files."a.taut" = ```tauto
pub fn steer(): Text { "a" }
pub fn burner(): Text { "burn" }
```
entry = "main.taut"
extract = true
nir.target = "llvm"
nir.export = ["lonely", "steer", "burner"]
nir.exports = ```nir
export "main::lonely" = lonely@4 row() foreign_row() pure_borrow_callbacks()
export "a::steer" = steer@2 row() foreign_row() pure_borrow_callbacks()
export "a::burner" = burner@3 row() foreign_row() pure_borrow_callbacks()
```

// A function a macro attribute rewrites, and what the macro makes, are the
// program's own functions: they are exported by name like any other.
@ cases.macro-made-functions-are-exported
files."gen.taut" = ```tauto
import std::builtin::macro

pub macro fn gen(_e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error} {
  match s {
    StFn(f) => {
      let n := Syn::decl_name(f.name, concat(f.name.name, "_runs"))
      Cons(s, quote stmts { pub fn $n(): i64 { 42 } })
    }
    _ => Syn::error(Syn::call_span(), "expected a function")
  }
}
```
files."main.taut" = ```tauto
import std::builtin::os
import "gen.taut" { gen }

@gen!() => replace fn tick, fn tick_runs
pub fn tick(): i64 { 1 }

fn go(): Unit ! {stdout} { perform stdout("hi\n") }
perform main(() => go())
```
entry = "main.taut"
extract = true
nir.target = "llvm"
nir.export = ["tick", "tick_runs"]
nir.exports = ```nir
export "main::tick" = tick@2 row() foreign_row() pure_borrow_callbacks()
export "main::tick_runs" = tick_runs@3 row() foreign_row() pure_borrow_callbacks()
```

// Two files declare a `steer`: a bare name does not say which, and the error
