export "shapes::lib::plain" = plain@3 row() foreign_row() pure_borrow_callbacks()
```

// A function extraction writes out anew (here one that returns a `Text`, with
// `std::map` in the program) is exported by the tote and module of the file it
// was written in, like one extraction keeps as it is.
@ cases.extracted-function-is-exported-by-its-tote-and-module
files."a/Tauto.eure" = ```eure
package {
  name = "a"
  version = "0.1.0"
}
```
files."a/src/main.taut" = ```tauto
import std::builtin::os
import std::map
import "lib.taut" { count }
fn go(): Unit ! {stdout} { perform stdout("x") }
perform main(() => go())
```
files."a/src/lib.taut" = ```tauto
import std::map

pub fn label(): Text { "a" }
pub fn count(): i64 { 1 }
```
entry = "a/src/main.taut"
extract = true
nir.target = "llvm"
nir.export = ["a::*"]
nir.exports = ```nir
export "a::lib::label" = label@2 row() foreign_row() pure_borrow_callbacks()
export "a::lib::count" = count@3 row() foreign_row() pure_borrow_callbacks()
```

// The export lines are in the order the list gives its entries, whatever
// order the program reads its files in. A `TOTE::*` brings the tote's
// functions and instance methods by module path, and in a module in the order
// they are written. A function two entries bring is where the first puts it.
@ cases.exports-are-in-the-order-the-list-gives-them
files_tote = "app"
files."app/Tauto.eure" = ```eure
package {
  name = "app"
  version = "0.1.0"
}
dependencies {
  game { path = "../game" }
}
exports = ["double", "game::*", "step"]
```
files."app/src/main.taut" = ```tauto
pub fn double(x: i64): i64 ! {overflow} { x * 2 }
#()
```
files."game/Tauto.eure" = ```eure
package {
  name = "game"
  version = "0.1.0"
}
```
files."game/src/systems.taut" = ```tauto
pub fn step(x: i64): i64 ! {overflow} { x + 1 }
pub fn reset(x: i64): i64 { 0 }
```
files."game/src/audio.taut" = ```tauto
pub fn volume(x: i64): i64 { x }
pub fn mute(x: i64): i64 { 0 }
```
nir.target = "llvm"
nir.exports = ```nir
export "app::main::double" = double@5 row("overflow") foreign_row("overflow") pure_borrow_callbacks()
export "game::audio::volume" = volume@1 row() foreign_row() pure_borrow_callbacks()
export "game::audio::mute" = mute@2 row() foreign_row() pure_borrow_callbacks()
export "game::systems::step" = step@3 row("overflow") foreign_row("overflow") pure_borrow_callbacks()
export "game::systems::reset" = reset@4 row() foreign_row() pure_borrow_callbacks()
```
