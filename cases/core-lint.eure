@ cases.a-step-a-literal-says-calls-a-tactic-of-std-nonstandard
source = ````tauto
theorem t(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  proof!(```
    We have Nat::add(a, b) = Nat::add(b, a) by auto!.
    ```)
}
````
lint = ["step-tactic: `by auto!(…)` calls a tactic std does not have (rewrite, nat_norm, nat_le, int_norm)"]

@ cases.a-step-a-literal-says-calls-a-tactic-of-std-standard
source = ````tauto
theorem t(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  proof!(```
    We have Nat::add(a, b) = Nat::add(b, a) by nat_norm!.
    ```)
}
````
lint = []

