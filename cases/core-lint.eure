@ cases.a-typed-macro-in-a-proof-is-found
source = ```tauto
macro fn m(c: Judgement): SynExpr { c }
theorem t(): Eq(Nat, 3, 3) { m!(Refl(Nat, 3)) }
```
lint = ["typed-macro-in-proof: `m!(…)` in a proof; write the expansion (tauto macro expand)"]

@ cases.a-typed-macro-in-a-program-is-fine
source = ```tauto
