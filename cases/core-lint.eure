@ cases.an-indexed-match-with-goals-is-fine
source = ```tauto
inductive Le: (n: Nat, m: Nat) -> Prop {
  LeRefl<n: Nat>: Le(n, n),
}
theorem t(a: Nat, b: Nat, h: Le(a, b)): Le(a, b) {
  ⊢ Le(a, b) from match h {
    LeRefl => ⊢ Le(a, a) from LeRefl,
  }
}
```
lint = []

@ cases.an-indexed-match-without-goals-is-found
source = ```tauto
inductive Le: (n: Nat, m: Nat) -> Prop {
  LeRefl<n: Nat>: Le(n, n),
}
theorem t(a: Nat, b: Nat, h: Le(a, b)): Le(a, b) {
  ⊢ Le(a, b) from match h {
    LeRefl => LeRefl,
  }
}
```
lint = ["indexed-arm-goal: an arm of a `match` over a type with indices writes its goal (`C => ⊢ G from p`)"]

@ cases.a-motive-that-takes-the-hypothesis-again-is-found
source = ```tauto
theorem t(b: Bool, h: b = true): b = true {
  (⊢ (b = true) -> b = true from match b {
    true => (h2: true = true) => h2,
    false => (h2: false = true) => h2,
  })(h)
}
```
lint = ["hand-generalize: "]

