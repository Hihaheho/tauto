fn g(x: i64): i64 { m!(x) }
```
lint = []

@ cases.a-capture-is-found
source = ```tauto
fn f(c: Judgement): SynIdent { Syn::ident_like(c, "it") }
```
lint = ["macro-capture: `Syn::ident_like` captures a name of the caller"]

@ cases.a-step-calls-a-tactic-of-std
source = ```tauto
theorem t(a: Nat, h: a = Zero): a = Zero {
  by rewrite!(h): a = Zero {
    ⊢ Eq(Nat, Zero, Zero) from Refl
  }
}
```
lint = []

@ cases.a-step-calls-a-tactic-of-std-nonstandard
source = ```tauto
theorem t(a: Nat, h: a = Zero): a = Zero {
  by auto!(h): a = Zero {
    ⊢ Eq(Nat, Zero, Zero) from Refl
  }
}
```
lint = ["step-tactic: `by auto!(…)` calls a tactic std does not have (rewrite, nat_norm, nat_le, int_norm)"]

@ cases.inside-a-theorem
source = ```tauto
theorem t(n: Nat): Eq(n, n) { match n { Zero => Refl, _ => Refl } }
```
lint = ["a `_ =>` arm: name every constructor instead"]


