@ cases.a-braced-name-in-a-syntax-literal-is-found
source = ```tauto
theorem t(n: Nat): nat!(`${n} + ${Succ(n)} = $n`) { ?x }
```
lint = ["a hole `?x`: a finished file has none", "braced-name: write `$n`, not `${n}`", "braced-name: write `$Succ(n)`, not `${Succ(n)}`"]

@ cases.a-braced-operation-in-a-syntax-literal-gets-parentheses
source = ```tauto
theorem t(n: Nat): nat!(`${n + 0} = $n`) { ?x }
```
lint = ["a hole `?x`: a finished file has none", "braced-name: write `$(n + 0)`, not `${n + 0}`"]

@ cases.braces-around-statements-in-a-syntax-literal-are-fine
source = ```tauto
theorem t(n: Nat): nat!(`${ let m := n; m } = $n`) { ?x }
```
lint = ["a hole `?x`: a finished file has none"]

@ cases.a-default-arm-is-found
source = ```tauto
