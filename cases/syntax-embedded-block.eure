@ cases.binding-stays-inside
entry = "src/main.taut"
backends = ["rust", "javascript", "vm"]
files."Tauto.eure" = 'package { name = "embedded-block" version = "0.1.0" }'
files."src/syntax-defs.taut" = ````tauto
import std::prelude::Macro
syntax!(caller, ```par
{{par:caller_expression}}```) => struct Root, fn parse
macro fn caller(e: caller::Root): SynExpr {
  let body := e.tauto_expr
  quote { (() => $body)() }
}
````
files."src/main.taut" = ````tauto
import std::prelude::Macro
import "syntax-defs.taut"
fn read(n: i64): i64 {
  let inner := 1
  let outer := caller!(```caller
    (${
      let inner := n
      inner
    })
  ```)
  outer + inner
}
perform show("read", read(5))
````
types = "ok"
rows = "ok"
lin = "ok"
shows = ["read = 6"]

