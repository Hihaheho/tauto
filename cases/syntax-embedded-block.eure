description = "The text of `${ … }` in a syntax literal is a block body: statements may come before the value, and their bindings stay inside."
@ cases.let-before-value
entry = "src/main.taut"
backends = ["rust", "javascript", "vm"]
files."Tauto.eure" = 'package { name = "embedded-block" version = "0.1.0" }'
files."src/syntax-defs.taut" = ````tauto
import std::prelude::Macro
syntax!(caller, ```par
{{par:caller_expression}}```) => struct Root, fn parse
macro fn caller(e: caller::Root): SynExpr {
  let body := e.tauto_expr
  quote { (() => $body)() }
}
````
files."src/main.taut" = ````tauto
import std::prelude::Macro
import "syntax-defs.taut"
fn mark(n: i64): i64 {
  caller!(```caller
    (${
      let doubled := n + n
      doubled + 1
    })
  ```)
}
perform show("mark", mark(20))
````
types = "ok"
rows = "ok"
lin = "ok"
shows = ["mark = 41"]

