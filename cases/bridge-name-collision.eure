description = "A tote's own bridge crate answers its extern by the declared name, even when another tote of the program has a function of that name."

@ cases.own-bridge-extern-sharing-a-bare-name
description = "`dev` declares `extern fn open` and has a bridge crate; a dependency's private `open` makes the extern's full name `dev::src::render::open`, and the bridge function is still `dev_bridge::open`."
tote = path`../examples/rust/bridge-name-collision/dev`
stdout = "ok\n"
eval.unimplemented = "extern dev::src::render::open: extern is not runnable: dev::src::render::open"
javascript.unimplemented = "unsupported: host extern bindings"
vm.unimplemented = "generate: the extern dev::src::render::open, which has no binding on the machine"
llvm.unimplemented = "generate: the LLVM backend does not write an `extern`"
