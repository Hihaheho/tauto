@ cases.an-empty-first-list-does-not-fix-a-shared-row
backends = ["rust", "javascript", "vm"]
source = ```tauto
import std::prelude::Shared

shared struct Stored(!e) { run: (n: u64) -> u64 ! {Div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), n: u64): u64 ! {Div} ∪ e {
  match values { Nil => n, Cons(value, rest) => (value.run)(n) }
}
fn dispatch<!e>(first: List(Stored(!e)), second: List(Stored(!e)), n: u64): u64 ! {Div} ∪ e {
  if n == 0 { invoke(first, n) } else { invoke(second, n) }
}
fn plus_one(n: u64): u64 ! {Div} { n + 1 }
fn handlers(): List(Stored(!{})) { [Stored { run: plus_one }] }
let functions := handlers()
perform show("result", dispatch(Nil, functions, 1))
```
shows = ["result = 2"]

