@ cases.an-empty-first-list-preserves-a-shared-effect
source = ```tauto

struct(shared) Stored(!e) { run: (n: nat) -> nat ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), n: nat): nat ! {div} ∪ e {
  match values { Nil => n, Cons(value, rest) => (value.run)(n) }
}
fn dispatch<!e>(first: List(Stored(!e)), second: List(Stored(!e)), n: nat): nat ! {div} ∪ e {
  if n == 0 { invoke(first, n) } else { invoke(second, n) }
}
effect request(): nat direct
fn queried(n: nat): nat ! {div, request} { n + perform request() }
fn handlers(): List(Stored(!{request})) { [Stored { run: queried }] }
let functions := handlers()
let result := handle { dispatch(Nil, functions, 1) } with {
  request(), k => k(4)
  return value => value
}
show(&result)
```
stdout = "5\n"

