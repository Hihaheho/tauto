@ cases.an-empty-first-list-does-not-fix-a-shared-row
source = ```tauto

struct(shared) Stored(!e) { run: (n: nat) -> nat ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), n: nat): nat ! {div} ∪ e {
  match values { Nil => n, Cons(value, rest) => (value.run)(n) }
}
fn dispatch<!e>(first: List(Stored(!e)), second: List(Stored(!e)), n: nat): nat ! {div} ∪ e {
  if n == 0 { invoke(first, n) } else { invoke(second, n) }
}
fn plus_one(n: nat): nat ! {div} { n + 1 }
fn handlers(): List(Stored(!{})) { [Stored { run: plus_one }] }
let functions := handlers()
show(&dispatch(Nil, functions, 1))
```
stdout = "2\n"

