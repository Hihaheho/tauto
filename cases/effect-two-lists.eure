@ cases.an-empty-list-cannot-erase-the-other-lists-effect
source = ```tauto

struct(shared) Stored(!e) { run: (n: nat) -> nat ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), n: nat): nat ! {div} ∪ e {
  match values { Nil => n, Cons(value, rest) => (value.run)(n) }
}
fn dispatch<!e>(first: List(Stored(!e)), second: List(Stored(!e)), n: nat): nat ! {div} ∪ e {
  if n == 0 { invoke(first, n) } else { invoke(second, n) }
}
effect request(): nat direct
fn queried(n: nat): nat ! {div, request} { n + perform request() }
fn handlers(): List(Stored(!{request})) { [Stored { run: queried }] }
fn pure(): nat ! {div} { dispatch(Nil, handlers(), 1) }
```
types = "ok"
rows = "error: `pure` may perform request but its row is {div}"

@ cases.a-fixed-empty-row-is-not-an-uninferred-row
source = ```tauto

struct(shared) Stored(!e) { run: (n: nat) -> nat ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), n: nat): nat ! {div} ∪ e {
  match values { Nil => n, Cons(value, rest) => (value.run)(n) }
}
fn dispatch<!e>(first: List(Stored(!e)), second: List(Stored(!e)), n: nat): nat ! {div} ∪ e {
  if n == 0 { invoke(first, n) } else { invoke(second, n) }
}
effect request(): nat direct
fn queried(n: nat): nat ! {div, request} { n + perform request() }
fn handlers(): List(Stored(!{request})) { [Stored { run: queried }] }
fn quiet(): List(Stored(!{})) { Nil }
let result := dispatch(quiet(), handlers(), 1)
```
types = "ok"
rows = "error: a function value may perform request but its type permits {}"

@ cases.an-inline-callback-list-fixes-a-shared-row
llvm.unimplemented = "unsupported: row variable `e` of `dispatch` is carried by a record and specialized to a suspending row"
source = ```tauto

struct(shared) Stored(!e) { run: (n: u64) -> u64 ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), n: u64): u64 ! {div} ∪ e {
  match values { Nil => n, Cons(value, rest) => (value.run)(n) }
}
fn dispatch<!e>(first: List(Stored(!e)), second: List(Stored(!e)), n: u64): u64 ! {div} ∪ e {
  if n == 0 { invoke(first, n) } else { invoke(second, n) }
}
fn plus_one(n: u64): u64 ! {div, overflow} { n + 1 }
show(&dispatch(Nil, [Stored { run: plus_one }], 1))
```
stdout = "2\n"
