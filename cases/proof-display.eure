files."main.taut" = ```tauto
pub theorem shared_equation<A: Type, a: A, b: A>(h: a = b): (b = a) ∧ (b = a) {
  let reversed: b = a := Eq::sym(h);
  AndIntro(reversed, reversed)
}
```
