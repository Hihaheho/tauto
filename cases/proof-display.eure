@ cases.match-let
files."main.taut" = ```tauto
pub theorem refl_nat(n: Nat): Eq(Nat, n, n) {
  ⊢ Eq(Nat, n, n) from match n {
    Zero => Refl(Nat, Zero)
    Succ(k) => {
      let h: Eq(Nat, Succ(k), Succ(k)) := Refl(Nat, Succ(k))
      h
    }
  }
}
```
entry = "main.taut"
checks_all = "ok"
proofs = [
  { format => "tree", output => path`expected/proof-display/match-let-01-tree.txt` },
  { format => "natural", output => path`expected/proof-display/match-let-02-natural.txt` },
]

