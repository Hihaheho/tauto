@ cases.reference-uses
files."main.taut" = ```tauto
pub theorem unused_intermediate(P: Prop, Q: Prop, g: (P) -> Q, h: P, f: (Q) -> Nat): Eq(Nat, f(g(h)), f(g(h))) {
  Refl(Nat, f(g(h)))
}
pub theorem nested_reference(P: Prop, Q: Prop, R: Prop, g: (P) -> Q, h: P,
  f: (Q) -> Nat, k: (Nat) -> R): R {
  k(f(g(h)))
}
pub theorem renumbered_reference(P: Prop, Q: Prop, S: Prop, g: (P) -> Q, h: P,
  f: (Q) -> Nat, j: (Eq(Nat, f(g(h)), f(g(h)))) -> S): S {
  j(Refl(Nat, f(g(h))))
}
```
entry = "main.taut"
checks.unused_intermediate = "ok"
checks.nested_reference = "ok"
checks.renumbered_reference = "ok"
proofs = [
  { output => path`expected/proof-display/reference-uses-01-natural.txt` },
]

