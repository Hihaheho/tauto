@ cases.views
files."main.taut" = ```tauto
pub theorem identity(P: Prop, h: P): P { h }
pub theorem compose(P: Prop, Q: Prop, R: Prop, f: (P) -> Q, g: (Q) -> R): (P) -> R {
  p => g(f(p))
}
```
entry = "main.taut"
checks_all = "ok"
proofs = [
  { name => "identity", format => "tree", output => path`expected/proof-display/views-01-tree.txt`, failed => false, incomplete => false },
  { name => "compose", format => "natural", output => path`expected/proof-display/views-02-natural.txt` },
  { name => "compose", format => "block", output => path`expected/proof-display/views-03-block.html` },
  { name => "compose", format => "node", output => path`expected/proof-display/views-04-node.html` },
  { name => "missing", error => "proof: no matching theorem with a body in the entry file" },
]

