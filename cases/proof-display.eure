@ cases.natural-congr2
files."main.taut" = ```tauto
pub theorem congr2<A: Type, B: Type, C: Type, f: (A) -> (B) -> C, a: A, b: A, c: B, d: B>(ab: a = b, cd: c = d): f(a, c) = f(b, d) {
  let first: f(a, c) = f(b, c) := Eq::congr(x => f(x, c), ab);
  let second: f(b, c) = f(b, d) := Eq::congr(y => f(b, y), cd);
  Eq::trans(first, second)
}
```
entry = "main.taut"
checks_all = "ok"
proofs = [
  { output => path`expected/proof-display/natural-congr2.txt` },
]

@ cases.natural-decomposition
files."main.taut" = ```tauto
pub inductive Bundle(P: Prop, Q: Prop): Prop {
  Mk(p: P, q: Q): Bundle(P, Q)
}
pub theorem first<P: Prop, Q: Prop>(bundle: Bundle(P, Q)): P {
  match bundle {
    Bundle::Mk(p, q) => p
  }
}
```
