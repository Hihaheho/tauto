@ cases.natural-divisibility
files."main.taut" = ```tauto
import std::Base
import std::Nat
pub(open) inductive Divides(a: Nat, b: Nat): Prop {
  By(k: Nat, equation: Nat::mul(a, k) = b): Divides(a, b)
}
pub theorem divides_trans(a: Nat, b: Nat, c: Nat, ab: Divides(a, b), bc: Divides(b, c)): Divides(a, c) {
  ⊢ Divides(a, c) from match ab {
    By(k, hk) => ⊢ Divides(a, c) from match bc {
      By(l, hl) => By(Nat::mul(k, l), Eq::trans(
        Eq::sym(Nat::mul_assoc(a, k, l)),
        Eq::trans(Eq::congr((x: Nat) => Nat::mul(x, l), hk), hl)))
    }
  }
}
```
entry = "main.taut"
checks_all = "ok"
proofs = [
  { output => path`expected/proof-display/natural-divisibility.txt` },
]

@ cases.natural-dependent-cases
files."main.taut" = ```tauto
pub inductive Indexed: (n: Nat) -> Prop {
  AtZero: Indexed(Zero)
  AtSucc(k: Nat): Indexed(Succ(k))
}
pub theorem indexed_refl(n: Nat, witness: Indexed(n)): n = n {
  match witness {
    Indexed::AtZero => Refl(Nat, Zero)
    Indexed::AtSucc(k) => Refl(Nat, Succ(k))
  }
}
```
entry = "main.taut"
checks_all = "ok"
proofs = [
  { output => path`expected/proof-display/natural-dependent-cases.txt` },
]

