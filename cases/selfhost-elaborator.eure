// A `match` on a product of variables is the case tree of matches on them, so that a call on a
// field of a component is a structural recursion (`structural-recursion-tuple-scrutinee`).
@ cases.elaborator-recursion-through-a-tuple-scrutinee
source = ```tauto
inductive T: Type {
  Leaf: T
  Node(l: T, r: T): T
}
fn both(a: T, b: T): Bool {
  match #(a, b) {
    #(Node(l, _), Node(r, _)) => both(l, r)
    _ => true
  }
}
fn all3(a: T, b: T, c: T): Bool {
  match #(a, b, c) {
    #(Node(x, _), Node(y, _), Node(z, _)) => all3(x, y, z)
    #(Leaf, Leaf, Leaf) => true
    _ => false
  }
}
```
differential = "elaborator"

// A field one arm binds by name and another writes `_` for is given a fresh name in the case
// tree, and the written name stands for it: a recursive call on that name is structural.
@ cases.elaborator-recursion-through-a-pattern-alias
source = ```tauto
inductive T: Type {
  Leaf: T
  Node(l: T, r: T): T
}
fn both(a: T, b: T): Bool {
  match #(a, b) {
    #(Node(l, _), Node(r, _)) => both(l, r)
    #(Leaf, Leaf) => true
    #(Leaf, Node(_, _)) => true
    #(Node(_, _), Leaf) => true
  }
}
fn two(a: T, b: T): Bool {
  match a {
    Node(x, Leaf) => match b {
      Node(y, _) => two(x, y)
      Leaf => true
    }
    Node(_, Node(_, _)) => true
    Leaf => false
  }
}
```
differential = "elaborator"
