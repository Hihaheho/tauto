// `==` on `List`, `Option`, `Result`, `Ordering` and pairs is the derived `F::beq`, with the function that compares each argument.
@ cases.equality-by-type-reads-the-derived-beq-054
source = ```tauto
fn g(x: Option(Nat), y: Option(Nat)): Bool { x == y }
fn h(x: Ordering, y: Ordering): Bool { x != y }
fn l(x: List(Nat), y: List(Nat)): Bool { x == y }
fn ll(x: List(List(Bool)), y: List(List(Bool))): Bool { x == y }
fn r(x: Result(Nat, Bool), y: Result(Nat, Bool)): Bool { x == y }
fn p(x: Nat × Bool, y: Nat × Bool): Bool { x == y }
theorem s(a: List(Nat), b: List(Nat), h: List::beq(Nat::eq, a, b) = true): a = b { List::beq_sound(Nat::eq, Nat::eq_sound, a, b, h) }
```
differential = "elaborator"

// A match on a part nested in a family generalizes the hypotheses over it, by the nested member's recursor.
@ cases.a-match-on-a-nested-part-with-dependents-055
source = ```tauto
pub(open) inductive Tr: Type {
  Node(n: Nat, kids: List(Tr)): Tr
}
fn kn(ts: List(Tr), a: Nat): Option(Nat) {
  match ts {
    Nil => None
    Cons(c, rest) => match c {
      Node(n, ks) => match n == a {
        true => Some(0)
        false => match kn(rest, a) {
          None => None
          Some(k) => Some(Succ(k))
        }
      }
    }
  }
}
theorem ks(ts: List(Tr), a: Nat, j: Nat, e: kn(ts, a) = Some(j)): j = j {
  match ts {
    Nil => Refl
    Cons(c, rest) => Refl
  }
}
```
differential = "elaborator"

// A parameter that is a function with effects: its row as a local, a named function or a λ passed for it, a row variable shared with the callback.
@ cases.a-callback-with-a-row-is-a-function-to-comp-057
source = ```tauto
effect ask(): Nat
fn app1(f: (Nat) -> Nat ! {ask}, n: Nat): Nat ! {ask} { f(n) }
fn app2<!e>(f: (Nat) -> Nat ! e, n: Nat): Nat ! e { f(n) }
fn tw(n: Nat): Nat ! {ask} { perform ask() }
fn u1(n: Nat): Nat ! {ask} { app1(tw, n) }
fn u2(n: Nat): Nat ! {ask} { app2(tw, n) }
fn u3(n: Nat): Nat ! {ask} { app2((x) => x, n) }
fn u4(n: Nat): Nat ! {ask} { app2((x) => perform ask(), n) }
```
