// A hypothesis an arm rebinds is generalized once, where it was declared, in a match on an equation.
@ cases.an-arm-hypothesis-shadows-the-one-it-replaces-056
source = ```tauto
fn checked<T: Type>(c: Option(Nat), x: T): Option(T) {
  match c {
    None => Some(x)
    Some(p) => Some(x)
  }
}
theorem cv<T: Type>(c: Option(Nat), x: T, g: T, e: checked(c, x) = Some(g)): x = g {
  match c {
    None => ⊢ x = g from match e {
      Refl => Refl
    }
    Some(p) => ⊢ x = g from match e {
      Refl => Refl
    }
  }
}
```
differential = "elaborator"

// A row with two instances of one effect: the host orders them by the declaration of their types, `Nat`, `Bool` and `Unit` before the program's own types, which follow in the order they are declared; so does the tote.
@ cases.instances-of-one-effect-are-ordered-by-their-types-060
source = ```tauto
effect get<A>(): A
effect put<A>(a: A): Unit
inductive A: Type { MkA: A }
inductive B: Type { MkB: B }
fn r1(n: Nat): Nat ! {get(Nat), get(Bool)} { n }
fn r2(n: Nat): Nat ! {get(B), get(A)} { n }
fn r3(n: Nat): Nat ! {get(A), get(Unit), get(Nat)} { n }
fn r4(n: Nat): Nat ! {put(B), get(A), get(Bool)} { n }
fn r5(n: Nat): Nat ! {get(Bool), put(Nat), get(Nat)} { n }
fn r6(n: Nat): Nat ! {get(Nat), get(Bool)} { r1(n) }
fn r7(n: Nat): Nat ! {get(B), get(A), get(Nat)} { r2(n) }
```
