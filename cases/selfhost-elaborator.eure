// Differential cases: each named route compares the self-hosted component with its oracle, not only evaluator success.

@ cases.elaborator-infer-from-owned-type
source = ```tauto
inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, I: Type) { fn choose(value: A): I }
instance Choose(Local, Nat) infer from A {
  fn choose(value: Local): Nat { 3 }
}
fn use(value: Local): Nat {
  let result := Choose::choose(value)
  result
}
```
differential = "elaborator"

@ cases.elaborator-infer-from-conflict
source = ```tauto
inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, I: Type) { fn choose(value: A): I }
instance Choose(Local, Nat) infer from A { fn choose(value: Local): Nat { 3 } }
instance Choose(Local, Bool) infer from A { fn choose(value: Local): Bool { true } }
```
differential = "elaborator"

