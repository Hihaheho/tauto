// A recursion whose calls write an implicit the matched type lacks generalizes it.
@ cases.a-recursion-writing-an-implicit-the-matched-type-lacks-058
source = ```tauto
import std::text
pub(open) inductive P(T: Type): Type {
  Good(v: T): P(T)
  Bad(n: Nat): P(T)
}
fn f<T>(i: Nat, conv: (Text) -> Option(T), vs: List(Text)): P(List(T)) {
  match vs {
    Nil => Good(Nil)
    Cons(t, rest) => match conv(t) {
      None => Bad(i)
      Some(x) => match f(<T: T>, i, conv, rest) {
        Good(xs) => Good(Cons(x, xs))
        Bad(p) => Bad(p)
      }
    }
  }
}
```
differential = "elaborator"

// A recursion generalizes the hypotheses that depend on the matched list.
@ cases.a-recursion-over-a-dependent-hypothesis-061
source = ```tauto
import std::base
import std::nat
import std::list
fn inl(k: Nat, l: List(Nat)): Bool {
  match l {
    Nil => false
    Cons(x, r) => Bool::or(Nat::eq(x, k), inl(k, r))
  }
}
fn dp(x: Nat, r: List(Nat), b: Bool): List(Nat) {
  match b {
    true => r
    false => Cons(x, r)
  }
}
fn dk(vs: List(Nat), k: Nat): List(Nat) {
  match vs {
    Nil => Nil
    Cons(x, t) => dp(x, dk(t, k), Nat::eq(x, k))
  }
}
theorem dac(y: Nat, r: List(Nat), k: Nat, ih: (inl(k, r) = false) -> dk(r, k) = r, h: Nat::eq(y, k) = false ∧ inl(k, r) = false): dk(Cons(y, r), k) = Cons(y, r) {
  Eq::trans(
    Eq::congr((b: Bool) => dp(y, dk(r, k), b), And::left(h)),
    Eq::congr((l: List(Nat)) => Cons(y, l), ih(And::right(h)))
  )
}
theorem da(t: List(Nat), k: Nat, e: inl(k, t) = false): dk(t, k) = t {
  match t {
    Nil => Refl
    Cons(y, r) => dac(y, r, k, (hr: inl(k, r) = false) => da(r, k, hr), Bool::or_false_split(Nat::eq(y, k), inl(k, r), e))
  }
}
```
differential = "elaborator"

