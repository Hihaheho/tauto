fn q(n: Nat, b: Bool): Nat ! {pair(Nat, Bool)} { perform pair(n, b) }
fn r(n: Nat): Nat {
  handle { q(n, true) } with {
    pair<Nat, Bool>(x, y), k => k(x)
  }
}
fn s(n: Nat): Unit {
  handle { p(n) } with {
    put<Nat>(x), k => k(#())
    return v => v
  }
}
fn gen<A>(a: A): Unit ! {put(A)} { perform put(a) }
fn user(n: Nat): Unit ! {put(Nat)} { gen(n) }
