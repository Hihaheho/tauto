@ cases.reuse-a-parent-law-in-a-generic-proof
source = ```tauto
inductive class Parent(A: Type) {
  fn apply(x: A): A
  theorem identity(x: A): Parent::apply(x) = x
}
inductive class Child(A: Type) where Parent(A) {
  fn get(x: A): A
}
theorem inherited<A>(x: A): Parent::apply(x) = x where Child(A) {
  Parent::identity(x)
}
```
