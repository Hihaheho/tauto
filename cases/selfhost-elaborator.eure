inductive class Choose(A: Type, I: Type) { fn choose(value: A): I }
instance Choose(Local, Nat) infer from A { fn choose(value: Local): Nat { 3 } }
fn use(value: Local): Nat {
  let result := Choose::choose(value)
  result
}
```
differential = "elaborator"

