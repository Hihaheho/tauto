// Thunks, a callee that handles its callback's effect, and λs read in the callee's row from rows with and without effects.
@ cases.callbacks-that-a-function-handles-or-passes-on-058
source = ```tauto
effect ask(): Nat
effect tell(n: Nat): Unit
fn thunk(f: () -> Nat ! {ask}): Nat ! {ask} { f() }
fn twice(f: () -> Nat ! {ask}): Nat ! {ask} {
  let a := f()
  a + f()
}
fn run<!e>(f: () -> Nat ! {ask} ∪ e): Nat ! e {
  handle { f() } with {
    ask(), k => k(1)
  }
}
fn pure_user(): Nat { run(() => perform ask()) }
fn user(): Nat ! {tell} { run(() => perform ask()) }
fn user2(): Nat ! {tell} { run(() => { perform tell(1); perform ask() }) }
fn gen<!e>(f: (Nat) -> Nat ! e, n: Nat): Nat ! e { f(f(n)) }
fn t1(n: Nat): Nat ! {ask} { perform ask() }
fn user3(n: Nat): Nat ! {ask} { gen(t1, n) }
fn user4(n: Nat): Nat { gen((x) => x, n) }
fn user5(n: Nat): Nat ! {ask, tell} { gen((x) => perform ask(), n) }
```
