// `match` and `if` with effects in the arms, a recursive call, a generic function.
@ cases.match-if-recursion-and-generics-read-with-effects-034
source = ```tauto
effect ask(): Nat
fn m(n: Nat): Nat ! {ask} {
  match n {
    Zero => perform ask()
    Succ(k) => k
  }
}
fn i(b: Bool): Nat ! {ask} {
  if b { perform ask() } else { 0 }
}
fn rec(n: Nat): Nat ! {ask} {
  match n {
    Zero => perform ask()
    Succ(k) => rec(k)
  }
}
fn gen<A>(a: A): A ! {ask} {
  let x := perform ask()
  a
}
```
differential = "elaborator"

// `handle`: a handler that leaves effects, one that leaves none, with and without `return`.
@ cases.handle-reads-partial-nested-and-complete-handlers-035
source = ```tauto
effect ask(): Nat
effect tell(n: Nat): Unit
fn two(n: Nat): Nat ! {ask, tell} {
  let a := perform ask()
  perform tell(a)
  perform ask()
}
fn partial(n: Nat): Nat ! {tell} {
  handle { two(n) } with {
    ask(), k => k(7)
  }
}
fn full(n: Nat): Nat {
  handle { two(n) } with {
    ask(), k => k(7)
    tell(x), k => k(#())
    return v => v
  }
}
fn nested(n: Nat): Nat ! {tell} {
  handle {
    handle { two(n) } with {
      ask(), k => k(1)
    }
  } with {
    tell(m), k => k(#())
  }
}
```
differential = "elaborator"

