// Recursion, `return`, and a generic function called at its own type.
@ cases.recursion-return-and-a-generic-call-044
source = ```tauto
effect get<A>(): A
effect tell(n: Nat): Unit
fn a(n: Nat): Nat ! {get(Nat), tell} {
  let x := perform get()
  perform tell(x)
  x
}
fn rec(n: Nat): Nat ! {get(Nat), tell} {
  match n {
    Zero => perform get()
    Succ(k) => rec(k)
  }
}
fn ret(n: Nat): Nat {
  handle { rec(n) } with {
    get<Nat>(), k => k(2)
    tell(m), k => k(#())
    return v => v
  }
}
fn gen<A>(a: A): A ! {get(A)} {
  let x := perform get()
  x
}
fn callgen(n: Nat): Nat ! {get(Nat)} {
  gen(n)
}
```
differential = "elaborator"

// Effects with several generics; a call whose instance the row lacks and an arm the host cannot read are skipped as the host skips them.
