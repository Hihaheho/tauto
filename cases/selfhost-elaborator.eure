// An arm `∀ A. get<A>(…)` for every instance is not read, the host skips the function; an arm's `∀` on an effect without type generics is ignored.
@ cases.arms-for-every-instance-are-skipped-059
source = ```tauto
effect get<A>(): A
effect ask(): Nat
fn g(n: Nat): Nat ! {get(Nat)} { perform get() }
fn a(n: Nat): Nat {
  handle { perform ask() } with {
    ∀ A. ask(), k => k(1)
  }
}
fn b(n: Nat): Nat {
  handle { g(n) } with {
    ∀ A. get<A>(), k => k(1)
  }
}
fn c(n: Nat): Nat {
  handle { g(n) } with {
    get<Nat, Nat>(), k => k(1)
  }
}
fn d(n: Nat): Nat ! {ask} {
  handle { g(n) } with {
    ∀ A. get<A>(), k => k(1)
  }
}
```
