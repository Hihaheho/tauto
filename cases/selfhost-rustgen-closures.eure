@ cases.immutable_text_capture
source = ```tauto
fn prefix(prefix_text: Text): (Text) -> Text ! {} {
  suffix => Text::concat(prefix_text, suffix)
}
fn answer(): Text {
  let japanese := "日本"
  let append := prefix(japanese)
  Text::concat(append("語"), japanese)
}
```
differential = "rustgen"
selfhost_entry = "answer"
