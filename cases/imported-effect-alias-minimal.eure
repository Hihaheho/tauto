@ cases.single-file-forbidden-callback-control
entry = "main.taut"
files."main.taut" = ```tauto
effect touch(): i64 direct
pub effect rt { touch }
pub fn run_handler(): i64 ! {rt} { perform touch() }
pub fn batch(f: () -> i64 ! {rt}): i64 ! {rt} { f() }
effect unexpected(): i64 direct
fn bad(): i64 ! {rt} { batch(() => perform unexpected()) }
```
types = "ok"
rows = "error: unexpected"

