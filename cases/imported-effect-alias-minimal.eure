// Concrete callbacks isolate alias expansion from proof-library extraction.

@ cases.single-file-control
entry = "main.taut"
files."main.taut" = ```tauto
effect touch(): i64 direct
pub effect rt { touch }
pub fn run_handler(): i64 ! {rt} { perform touch() }
pub fn batch(f: () -> i64 ! {rt}): i64 ! {rt} { f() }
fn fire(): i64 ! {rt} { batch(() => run_handler()) }
```
types = "ok"
rows = "ok"

@ cases.imported-alias-callback
entry = "main.taut"
files."runtime.taut" = ```tauto
effect touch(): i64 direct
pub effect rt { touch }
pub fn run_handler(): i64 ! {rt} { perform touch() }
pub fn batch(f: () -> i64 ! {rt}): i64 ! {rt} { f() }
```
files."main.taut" = ```tauto
import "runtime.taut"
fn fire(): i64 ! {rt} { batch(() => run_handler()) }
```
types = "ok"
rows = "ok"

@ cases.explicit-list-public-alias
