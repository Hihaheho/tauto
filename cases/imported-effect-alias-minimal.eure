@ cases.a-private-alias-does-not-shadow-the-callers-alias
entry = "main.taut"
files."runtime.taut" = ```tauto
effect touch(): i64 direct
effect rt { touch }
pub fn run_handler(): i64 ! {rt} { perform touch() }
```
files."main.taut" = ```tauto
import "runtime.taut"
effect other(): i64 direct
effect rt { other }
fn bad(): i64 ! {rt} { run_handler() }
```
types = "ok"
rows = "error: touch"

@ cases.two-public-aliases-need-an-unambiguous-name
entry = "main.taut"
files."a.taut" = ```tauto
effect first(): i64 direct
pub effect rt { first }
```
files."b.taut" = ```tauto
effect second(): i64 direct
pub effect rt { second }
```
files."main.taut" = ```tauto
import "a.taut"
import "b.taut"
fn bad(): i64 ! {rt} { 0 }
```
macro_error = "ambiguous"

@ cases.a-qualified-public-alias-is-listed-by-its-source-name
entry = "main.taut"
files."runtime.taut" = ```tauto
effect touch(): i64 direct
pub effect rt { touch }
pub fn run_handler(): i64 ! {rt} { perform touch() }
```
files."main.taut" = ```tauto
import "runtime.taut" { rt, run_handler }
fn fire(): i64 ! {runtime::rt} { run_handler() }
```
types = "ok"
rows = "ok"

@ cases.a-transitive-import-does-not-bring-an-alias
entry = "main.taut"
files."hidden.taut" = ```tauto
pub effect touch(): i64 direct
pub effect rt { touch }
```
files."bridge.taut" = ```tauto
import "hidden.taut"
pub fn bridge(): i64 ! {rt} { perform touch() }
```
files."main.taut" = ```tauto
import "bridge.taut"
fn bad(): i64 ! {hidden::rt} { bridge() }
```
macro_error = "does not import"

@ cases.alias-visibility-does-not-hide-an-open-field
entry = "main.taut"
files."main.taut" = ```tauto
pub(open) struct OpenRecord { source: i64 }
let record := OpenRecord { source: 7 }
perform show("source", record.source)
```
types = "ok"
shows = ["source = 7"]
