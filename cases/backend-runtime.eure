fn scan(values: Array(Entry), n: i64): i64 ! {div, overflow} {
  var i := 0
  var total := 0
  while i < n {
    total := total + match Array::get(values, 0) {
      Some(Entry { tag, payload: _ }) => tag
      None => 0
    }
    i := i + 1
  }
  total
}
fn run(steps: u64): i64 ! {budget, overflow} {
