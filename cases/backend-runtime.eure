rust_shows = ["abort = Err(\"exhausted\")", "normal = Err(\"exhausted\")", "abort = Err(\"exhausted\")", "normal = Err(\"exhausted\")", "abort = Err(\"exhausted\")", "normal = Err(\"exhausted\")", "abort = Err(\"exhausted\")", "normal = Err(\"exhausted\")", "abort = Err(\"exhausted\")", "normal = Err(\"exhausted\")", "abort = Ok(3)", "normal = Err(\"exhausted\")", "abort = Ok(3)", "normal = Ok(10)", "abort = Ok(3)", "normal = Ok(10)", "abort = Ok(3)", "normal = Ok(10)", "abort = Ok(3)", "normal = Ok(10)", "abort = Ok(3)", "normal = Ok(10)", "abort = Ok(3)", "normal = Ok(10)"]
backends = ["rust", "javascript"]
source = ```tauto
effect stop(value: u64): Never resume 0
fn value(index: u64): u64 { index + 1 }
fn scan(&read: (u64) -> u64, size: u64, abort_at: u64): u64 ! {Div, stop} {
  var index: u64 := 0
  var total: u64 := 0
  while index < size {
    if index == abort_at { perform stop(total) }
    total := total + read(index)
    index := index + 1
  }
  total
}
fn forward(&read: (u64) -> u64, size: u64, abort_at: u64): u64 ! {Div, stop} {
  scan(&(index) => read(index), size, abort_at)
}
fn run(steps: i64, abort_at: u64): Result(u64, Text) {
  handle { budget(steps: steps) { Ok(forward(&value, 4, abort_at)) } } with {
    stop(total) => Ok(total)
    exceeded(info), k => Err("exhausted")
  }
}
var fuel := 0
while fuel < 12 {
  perform show("abort", run(fuel, 2))
  perform show("normal", run(fuel, 9))
  fuel := fuel + 1
}
```
