@ cases.nonresuming_budget-closed_shared_callbacks_forward_through_helpers_and_compose_with_abort
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
rust_budget_steps = 107
source = ```tauto
effect stop(value: u64): Never resume 0
fn value(index: u64): u64 ! {overflow} { index + 1 }
fn scan(read: &((u64) -> u64 ! {overflow}), size: u64, abort_at: u64): u64 ! {div, overflow, stop} {
  var index: u64 := 0
  var total: u64 := 0
  while index < size {
    if index == abort_at { perform stop(total) }
    total := total + read(index)
    index := index + 1
  }
  total
}
fn forward(read: &((u64) -> u64 ! {overflow}), size: u64, abort_at: u64): u64 ! {div, overflow, stop} {
  scan((index) => read(index), size, abort_at)
}
fn run(steps: u64, abort_at: u64): Result(u64, Text) ! {budget} {
  handle { perform budget(steps, () => { Ok(forward(&value, 4, abort_at)) }) } with {
    stop(total) => Ok(total)
    exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted")
  }
}
var fuel := 0
while fuel < 12 {
  show(&run(fuel, 2))
  show(&run(fuel, 9))
  fuel := fuel + 1
}
```
