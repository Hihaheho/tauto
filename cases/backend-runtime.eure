// The bytecode machine runs the standard effects through the prelude's
// handler, which answers `secure_random` with a `Secret`: a program that
// uses only `fs_read` needs `secret` too.
@ cases.vm-std_effects_with_secret
backends = ["vm"]
files."b.txt" = "hello"
files."main.nib" = ```nib
import std::prelude::Os
import std::prelude::Secret
import std::prelude::Shared

match perform argv() {
  Cons(path, Nil) => perform show("x", perform fs_read(path))
  _ => #()
}
perform show("n", match perform secure_random(32) { Ok(s) => Bytes::len(expose(s)), Err(_) => 0 })
perform show("s", secret(1))
```
permissions = ["--allow-read={dir}"]
args = ["{dir}/b.txt"]
shows = ["x = Ok(\"hello\")", "n = 32", "s = Secret"]

@ cases.product-named-pair-pattern
extract = true
backends = ["rust", "javascript", "vm"]
source = ```tauto
import std::Map
import std::Base
let table := Ordmap::insert(Ordmap::empty(), 1, 4, Ordmap::compare_nat)
let result := match Ordmap::floor(table, 3, Ordmap::compare_nat) {
  None => 0
  Some(entry) => match entry { Pair { fst: start, snd: last } => Nat::add(start, last) }
}
perform show("result", result)
```
shows = ["result = 5"]
