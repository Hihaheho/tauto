@ cases.nonresuming_budget-closed_shared_callback_alone_keeps_exact_fuel_and_invocation_counts
rust_budget_steps = 57
rust_shows = ["result = Err(\"exhausted\")", "result = Err(\"exhausted\")", "result = Err(\"exhausted\")", "result = Err(\"exhausted\")", "result = Err(\"exhausted\")", "result = Err(\"exhausted\")", "result = Ok(10)", "result = Ok(10)", "result = Ok(10)", "result = Ok(10)", "result = Ok(10)", "result = Ok(10)"]
backends = ["rust", "javascript"]
source = ```tauto
fn value(index: u64): u64 { index + 1 }
fn sum(&read: (u64) -> u64, size: u64): u64 ! {Div} {
  var index: u64 := 0
  var total: u64 := 0
  while index < size { total := total + read(index)
    index := index + 1 }
  total
}
fn forward(&read: (u64) -> u64, size: u64): u64 ! {Div} {
  sum(&(index) => read(index), size)
}
fn run(steps: i64): Result(u64, Text) {
  handle { budget(steps: steps) { Ok(forward(&(index) => value(index), 4)) } } with {
    exceeded(info), k => Err("exhausted")
  }
}
var fuel := 0
while fuel < 12 { perform show("result", run(fuel))
  fuel := fuel + 1 }
