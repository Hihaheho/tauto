@ cases.javascript-direct_forms_agree_with_the_evaluator
llvm.unimplemented = "generate: the LLVM backend does not write a guard on a `match` that takes its value apart yet"
source = ```tauto
fn fib(n: u64): u64 ! {div, overflow} { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
fn total(n: u64): u64 ! {div, overflow} {
  var s := 0
  var i := 0
  while i < n {
    let d := i * 2
    s := s + d
    i := i + 1
  }
  s
}
fn build(n: u64, acc: List(u64)): List(u64) ! {overflow} { if n == 0 { acc } else { build(n - 1, Cons(n, acc)) } }
fn insert(x: u64, l: List(u64)): List(u64) {
  match l {
    Nil => Cons(x, Nil)
    Cons(y, t) => if x <= y { Cons(x, Cons(y, t)) } else { Cons(y, insert(x, t)) }
  }
}
fn sort(l: List(u64)): List(u64) {
  match l {
    Nil => Nil
    Cons(x, t) => insert(x, sort(t))
  }
}
fn length(l: &List(u64)): u64 ! {overflow} {
  match l {
    Nil => 0
    Cons(_, t) => 1 + length(&t)
  }
}
fn first_big(l: List(u64)): u64 {
  match l {
    Nil => 0
    Cons(x, t) if x > 3 => x
    Cons(_, t) => first_big(t)
  }
}
fn name(t: Text): u64 {
  match t {
    "one" => 1
    other => 0
  }
}
show(&fib(15))
show(&total(100))
let l := sort(Cons(5, Cons(1, Cons(4, build(3, Nil)))))
show(&length(&l))
show(&first_big(l))
show(&(name("one") + name("two")))
```
stdout = ```
610
9900
6
4
1
```

