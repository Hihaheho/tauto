@ cases.budget_closures-divergent_callbacks_preserve_budgets_captures_and_resumption
backends = ["rust", "javascript"]
source = ```tauto
import std::prelude::Shared


fn visit(n: i64): Unit ! {Div} {
  if n > 0 { visit(n - 1) }
}
fn apply<!e>(&f: (i64) -> Unit ! e, n: i64): Unit ! e {
  each(Cons(n, Nil), &f)
}
fn apply_div(&f: (i64) -> Unit ! {Div}, n: i64): Unit ! {Div} {
  f(n)
}
fn concrete(steps: i64): Bool {
  handle { budget(steps: steps) {
    apply_div((n) => visit(n), 3)
    true
  } } with { exceeded(info), k => false }
}
fn borrowed_parameter(steps: i64): Bool {
  handle { budget(steps: steps) {
    apply_div((&n) => visit(n), 3)
    true
  } } with { exceeded(info), k => false }
}
fn borrowed_parameter_resume(): i64 {
  var count := 0
  handle { budget(steps: 0) {
    apply_div((&n) => {
      count := count + 1
      visit(n)
    }, 3)
    count
  } } with { exceeded(info), k => info.more(2) }
}
fn run(steps: i64): Bool {
  handle { budget(steps: steps) {
    each(Cons(3, Nil), (n) => visit(n))
    true
  } } with { exceeded(info), k => false }
}
fn captured(steps: i64): Bool {
  let offset := 4
  handle { budget(steps: steps) {
    apply((n) => visit(n + offset), 3)
    true
  } } with { exceeded(info), k => false }
}
fn resume_more(): i64 {
  var count := 0
  handle { budget(steps: 0) {
    each(Cons(3, Cons(2, Nil)), (n) => {
      count := count + 1
      visit(n)
    })
    count
  } } with { exceeded(info), k => info.more(2) }
}
fn resume_unbounded(): i64 {
  var count := 0
  handle { budget(steps: 0) {
    each(Cons(3, Cons(2, Nil)), (n) => {
      count := count + 1
      visit(n)
    })
    count
  } } with { exceeded(info), k => info.unbounded() }
}
fn loop_callback(steps: i64): Bool {
  var count := 0
  handle { budget(steps: steps) {
    each(Cons(8, Nil), (n) => {
      while count < n { count := count + 1 }
    })
    count == 8
  } } with { exceeded(info), k => false }
}
fn inner_zero(): Bool {
  handle { budget(steps: 1000) {
    budget(steps: 0) {
      each(Cons(8, Nil), (n) => visit(n))
      true
    }
  } } with { exceeded(info), k => false }
}
fn nested(steps: i64): Bool {
  handle { budget(steps: steps) {
    budget(steps: 1000) {
      apply((n) => visit(n), 10)
      true
    }
    true
  } } with { exceeded(info), k => false }
}
apply((n) => visit(n), 2)
perform show("large", run(1000))
perform show("zero", run(0))
perform show("small", run(1))
perform show("captured", captured(1000))
perform show("captured_zero", captured(0))
perform show("more", resume_more())
perform show("unbounded", resume_unbounded())
perform show("nested", nested(1000))
perform show("nested_zero", nested(0))
perform show("inner_zero", inner_zero())
perform show("loop", loop_callback(1000))
perform show("loop_zero", loop_callback(0))
let pure := handle { budget(steps: 1000) {
  each(Cons(3, Nil), (n) => #())
  true
} } with { exceeded(info), k => false }
perform show("pure", pure)
perform show("concrete", concrete(1000))
perform show("concrete_zero", concrete(0))
perform show("borrowed_parameter", borrowed_parameter(1000))
perform show("borrowed_parameter_zero", borrowed_parameter(0))
perform show("borrowed_parameter_resume", borrowed_parameter_resume())
let widened := handle { budget(steps: 1000) {
  apply_div((n) => #(), 3)
  true
} } with { exceeded(info), k => false }
perform show("widened", widened)

```
shows = ["large = true", "zero = false", "small = false", "captured = true", "captured_zero = false", "more = 2", "unbounded = 2", "nested = true", "nested_zero = false", "inner_zero = false", "loop = true", "loop_zero = false", "pure = true", "concrete = true", "concrete_zero = false", "borrowed_parameter = true", "borrowed_parameter_zero = false", "borrowed_parameter_resume = 1", "widened = true"]

@ cases.budget_closures-owned_divergent_callbacks_and_closures
backends = ["rust", "javascript"]
source = ```tauto

fn spin(): i64 {
  while true { }
  0
}
fn visit(n: i64): Unit ! {Div} {
  if n > 0 { visit(n - 1) }
}
fn twice(f: (i64) -> i64 ! {Div}, x: i64): i64 {
  f(f(x))
}
fn owned_callback(steps: i64): i64 {
  handle { budget(steps: steps) {
    twice((x) => { visit(x)
      x + 1 }, 3)
  } } with { exceeded(info), k => 0 - 1 }
}
fn owned_callback_spins(): i64 {
  handle { budget(steps: 1000) {
    twice((x) => x + spin(), 3)
  } } with { exceeded(info), k => 7 }
}
fn owned_callback_resumes(): i64 {
  handle { budget(steps: 0) {
    twice((x) => {
      visit(x)
      x * 2
    }, 3)
  } } with { exceeded(info), k => info.unbounded() }
}
fn owned_closure(steps: i64): i64 {
  let offset := 4
  handle { budget(steps: steps) {
    let g := (x) => { visit(x)
      x + offset }
    g(g(1))
  } } with { exceeded(info), k => 0 - 1 }
}
fn owned_closure_answers(): i64 {
  handle { budget(steps: 1000) {
    let g := (x) => x + spin()
    g(5)
  } } with { exceeded(info), k => 9 }
}
perform show("callback", owned_callback(1000))
perform show("callback_zero", owned_callback(0))
perform show("callback_spins", owned_callback_spins())
perform show("callback_resumes", owned_callback_resumes())
perform show("closure", owned_closure(1000))
perform show("closure_zero", owned_closure(0))
perform show("closure_answers", owned_closure_answers())
```
shows = ["callback = 5", "callback_zero = -1", "callback_spins = 7", "callback_resumes = 12", "closure = 9", "closure_zero = -1", "closure_answers = 9"]

