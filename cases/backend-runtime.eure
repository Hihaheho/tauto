// The bytecode machine runs the standard effects through the prelude's
// handler, which answers `secure_random` with a `Secret`: a program that
// uses only `fs_read` needs `secret` too.
@ cases.vm-std_effects_with_secret
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `secure_random` yet"
files."b.txt" = "hello"
files."main.nib" = ```nib
import std::builtin::os
import std::builtin::secret

match perform argv() {
  Cons(path, Nil) => show(&(perform fs_read(path)))
  _ => #()
}
show(&(match perform secure_random(32) { Ok(s) => Bytes::len(expose(s)), Err(_) => 0 }))
show(&secret(1))
```
permissions = ["--allow-read={dir}"]
args = ["{dir}/b.txt"]
stdout = ```
Ok("hello")
32
Secret { .. }
```

@ cases.product-named-pair-pattern
source = ```tauto
import std::map
import std::base
let table := Ordmap::insert(Ordmap::empty(), 1, 4, Ordmap::compare_nat)
let result := match Ordmap::floor(table, 3, Ordmap::compare_nat) {
  None => 0
  Some(entry) => match entry { #(start, last) => Nat::add(start, last) }
}
show(&result)
```
stdout = "5\n"
