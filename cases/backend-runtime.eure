@ cases.budget_closures-owned_divergent_callbacks_and_closures
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto

fn spin(): i64 ! {div} {
  while true { }
  0
}
fn visit(n: i64): Unit ! {div, overflow} {
  if n > 0 { visit(n - 1) }
}
fn twice(f: (i64) -> i64 ! {div, overflow}, x: i64): i64 ! {div, overflow} {
  f(f(x))
}
fn owned_callback(steps: u64): i64 ! {budget, overflow} {
  handle { perform budget(steps, () => {
    twice((x) => { visit(x)
      x + 1 }, 3)
  }) } with { exceeded(info), k => 0 - 1 }
}
fn owned_callback_spins(): i64 ! {budget, overflow} {
  handle { perform budget(1000, () => {
    twice((x) => x + spin(), 3)
  }) } with { exceeded(info), k => 7 }
}
fn owned_callback_resumes(): i64 ! {budget, div, overflow} {
  handle { perform budget(0, () => {
    twice((x) => {
      visit(x)
      x * 2
    }, 3)
  }) } with { exceeded(info), k => info.unbounded() }
}
fn owned_closure(steps: u64): i64 ! {budget, overflow} {
  let offset := 4
  handle { perform budget(steps, () => {
    let g := (x) => { visit(x)
      x + offset }
    g(g(1))
  }) } with { exceeded(info), k => 0 - 1 }
}
fn owned_closure_answers(): i64 ! {budget, overflow} {
  handle { perform budget(1000, () => {
    let g := (x) => x + spin()
    g(5)
  }) } with { exceeded(info), k => 9 }
}
show(&owned_callback(1000))
show(&owned_callback(0))
show(&owned_callback_spins())
show(&owned_callback_resumes())
show(&owned_closure(1000))
show(&owned_closure(0))
show(&owned_closure_answers())
