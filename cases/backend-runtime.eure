@ cases.budget_closures-divergent_callbacks_preserve_budgets_captures_and_resumption
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto


fn visit(n: i64): Unit ! {div, overflow} {
  if n > 0 { visit(n - 1) }
}
fn apply<!e>(f: &((i64) -> Unit ! e), n: i64): Unit ! e {
  each(Cons(n, Nil), &f)
}
fn apply_div(f: &((i64) -> Unit ! {div, overflow}), n: i64): Unit ! {div, overflow} {
  f(n)
}
fn concrete(steps: u64): Bool ! {budget, overflow} {
  handle { perform budget(steps, () => {
    apply_div((n) => visit(n), 3)
    true
  }) } with { exceeded(info), k => false }
}
fn borrowed_parameter(steps: u64): Bool ! {budget, overflow} {
  handle { perform budget(steps, () => {
    apply_div((n) => visit(n), 3)
    true
  }) } with { exceeded(info), k => false }
}
fn borrowed_parameter_resume(): i64 ! {budget, overflow} {
  var count := 0
  handle { perform budget(0, () => {
    apply_div((n) => {
      count := count + 1
      visit(n)
    }, 3)
    count
  }) } with { exceeded(info), k => info.more(2) }
}
fn run(steps: u64): Bool ! {budget, overflow} {
  handle { perform budget(steps, () => {
    each(Cons(3, Nil), (n) => visit(n))
    true
  }) } with { exceeded(info), k => false }
}
fn captured(steps: u64): Bool ! {budget, overflow} {
  let offset := 4
  handle { perform budget(steps, () => {
    apply((n) => visit(n + offset), 3)
    true
  }) } with { exceeded(info), k => false }
}
fn resume_more(): i64 ! {budget, overflow} {
  var count := 0
  handle { perform budget(0, () => {
    each(Cons(3, Cons(2, Nil)), (n) => {
      count := count + 1
      visit(n)
    })
    count
  }) } with { exceeded(info), k => info.more(2) }
}
fn resume_unbounded(): i64 ! {budget, div, overflow} {
  var count := 0
  handle { perform budget(0, () => {
    each(Cons(3, Cons(2, Nil)), (n) => {
      count := count + 1
      visit(n)
    })
    count
  }) } with { exceeded(info), k => info.unbounded() }
}
fn loop_callback(steps: u64): Bool ! {budget, overflow} {
  var count := 0
  handle { perform budget(steps, () => {
    each(Cons(8, Nil), (n) => {
      while count < n { count := count + 1 }
    })
    count == 8
  }) } with { exceeded(info), k => false }
}
fn inner_zero(): Bool ! {budget, overflow} {
  handle { perform budget(1000, () => {
    perform budget(0, () => {
      each(Cons(8, Nil), (n) => visit(n))
      true
    })
  }) } with { exceeded(info), k => false }
}
fn nested(steps: u64): Bool ! {budget, overflow} {
  handle { perform budget(steps, () => {
    perform budget(1000, () => {
      apply((n) => visit(n), 10)
      true
    })
    true
  }) } with { exceeded(info), k => false }
}
apply((n) => visit(n), 2)
show(&run(1000))
show(&run(0))
show(&run(1))
show(&captured(1000))
show(&captured(0))
show(&resume_more())
show(&resume_unbounded())
show(&nested(1000))
show(&nested(0))
show(&inner_zero())
show(&loop_callback(1000))
show(&loop_callback(0))
let pure := handle { perform budget(1000, () => {
  each(Cons(3, Nil), (n) => #())
  true
}) } with { exceeded(info), k => false }
show(&pure)
show(&concrete(1000))
show(&concrete(0))
show(&borrowed_parameter(1000))
show(&borrowed_parameter(0))
show(&borrowed_parameter_resume())
let widened := handle { perform budget(1000, () => {
  apply_div((n) => #(), 3)
  true
}) } with { exceeded(info), k => false }
show(&widened)

