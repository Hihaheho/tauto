@ cases.constructor_resolution-generic_recursive_shared_constructors
backends = ["rust", "javascript"]
source = ```tauto

enum Left(A: Type) { Same(A), Next(Left(A)), Empty }
enum Right(A: Type) { Same(A), Next(Right(A)), Empty }
fn left(x: Left(i64)): i64 {
    match x { Same(n) => n, Next(rest) => left(rest), Empty => 0 }
}
fn right(x: Right(Text)): Text {
    match x { Same(text) => text, Next(rest) => right(rest), Empty => "empty" }
}
let l: Left(i64) := Next(Same(42))
let r: Right(Text) := Next(Same("recursive"))
perform show("left", left(l))
perform show("right", right(r))
```
shows = ["left = 42", "right = \"recursive\""]

