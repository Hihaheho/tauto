description = "`fn f(): T !?` asks for its row to be written: it is an error of `tauto check` (exit 1), the program does not run, and `tauto check --fix` writes the row its body performs."

@ cases.a-row-hole-is-an-error-with-the-row-in-the-note
entry = "main.taut"
files."main.taut" = ```tauto
effect ask(q: i64): i64
fn f(): i64 !? { perform ask(1) }
```
check_report = "the row of `f` is `!?`: it is not written yet"
rows = "error: the row of `f` is `!?`: it is not written yet"
inferred_rows.f = ["ask"]

@ cases.a-pure-body-has-the-empty-row
source = ```tauto
fn f(x: i64): i64 !? { x }
fn g(): i64 ! {} { f(1) }
```
rows = "error: the row of `f` is `!?`: it is not written yet"
inferred_rows.f = []

