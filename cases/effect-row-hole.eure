@ cases.a-row-hole-is-not-a-type
entry = "main.taut"
files."main.taut" = ```tauto
fn f(g: (i64) -> i64 !?): i64 { 0 }
```
load_error = "`!?` (a row not written yet) is written only after the result of a `fn` with a body"

