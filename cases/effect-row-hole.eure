@ cases.check-fix-writes-the-row-of-the-body
entry = "main.taut"
files."main.taut" = ```tauto
effect ask(q: i64): i64
fn f(): i64 !? { perform ask(1) }
```
fixes.applied = ["write `! {ask}`"]
fixes.files."main.taut" = ```tauto
effect ask(q: i64): i64
fn f(): i64 ! {ask} { perform ask(1) }
```

@ cases.check-fix-takes-the-hole-away-from-a-pure-body
entry = "main.taut"
files."main.taut" = ```tauto
fn f(x: i64): i64 !? { x }
```
fixes.applied = ["remove `!?`"]
fixes.files."main.taut" = ```tauto
fn f(x: i64): i64 { x }
```

@ cases.check-fix-writes-the-rows-of-a-chain-in-one-run
entry = "main.taut"
files."main.taut" = ```tauto
effect ask(q: i64): i64
fn g(): i64 !? { perform ask(1) }
fn f(): i64 !? { g() }
```
fixes.applied = ["write `! {ask}`", "write `! {ask}`"]
fixes.files."main.taut" = ```tauto
effect ask(q: i64): i64
fn g(): i64 ! {ask} { perform ask(1) }
fn f(): i64 ! {ask} { g() }
```

@ cases.check-fix-writes-div-for-a-row-hole-that-calls-itself
entry = "main.taut"
files."main.taut" = ```tauto
fn f(n: i64): i64 !? { f(n) }
```
fixes.applied = ["write `! {div}`"]
fixes.files."main.taut" = ```tauto
fn f(n: i64): i64 ! {div} { f(n) }
```

@ cases.check-fix-writes-the-fixed-point-of-two-row-holes-that-call-each-other
entry = "main.taut"
files."main.taut" = ```tauto
effect ask(q: i64): i64
fn f(n: i64): i64 !? { if n == 0 { perform ask(1) } else { g(n) } }
fn g(n: i64): i64 !? { f(n) }
```
fixes.applied = ["write `! {ask, div}`", "write `! {ask, div}`"]
fixes.files."main.taut" = ```tauto
effect ask(q: i64): i64
fn f(n: i64): i64 ! {ask, div} { if n == 0 { perform ask(1) } else { g(n) } }
fn g(n: i64): i64 ! {ask, div} { f(n) }
```

@ cases.check-fix-lets-a-handler-in-a-cycle-take-away-what-it-answers
entry = "main.taut"
files."main.taut" = ```tauto
effect ask(q: i64): i64
fn f(n: i64): i64 !? {
  handle { g(n) } with {
    ask(q), k => k(q)
    return v => v
  }
}
fn g(n: i64): i64 !? { if n == 0 { perform ask(1) } else { f(n) } }
```
fixes.applied = ["write `! {div}`", "write `! {ask, div}`"]
fixes.files."main.taut" = ```tauto
effect ask(q: i64): i64
fn f(n: i64): i64 ! {div} {
  handle { g(n) } with {
    ask(q), k => k(q)
    return v => v
  }
}
fn g(n: i64): i64 ! {ask, div} { if n == 0 { perform ask(1) } else { f(n) } }
```

@ cases.check-fix-gives-up-when-the-row-cannot-be-followed
entry = "main.taut"
files."main.taut" = ```tauto
fn f(n: i64): i64 !? { f(n) + missing(n) }
```
fixes.applied = []

