  Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Cons(6, Cons(7, Cons(8, Cons(9, Cons(10, Cons(11, Cons(12, Cons(13, Cons(14, Cons(15, Cons(16, Cons(17, Cons(18, Cons(19, Cons(20, Cons(21, Cons(22, Cons(23, Cons(24, Cons(25, Cons(26, Cons(27, Cons(28, 28, Cons(29, Cons(30, Nil))))))))))))))))))))))))))))))
}
```
checks."names" = "error: "
