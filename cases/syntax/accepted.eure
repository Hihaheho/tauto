  1 +
  2
```

@ cases.empty
parses = true
source = ""

@ cases.loops
parses = true
source = ```nib
let v := loop { break 3 }
```

@ cases.struct-and-enum
parses = true
source = ```nib
struct Point { x: Float, y: Float }
enum Shape(T: Type) {
  Circle(Float)
  Rect { w: Float, h: Float }
  Empty
}
let p := Point { x: 1.0, y: 2.0 }
let q := Shape::Circle(1.0)
```

@ cases.record-literal-over-lines
description = "`#{` opens a record without a name, even when its first field is on the next line"
parses = true
source = ```nib
let r := #{

  x: 1
  y: 2
}
```

@ cases.a-brace-is-a-block
description = "`{` is always a block: what follows it is read as statements"
parses = true
source = ```nib
let b := {
  x
}
```

@ cases.a-named-struct-literal-with-a-single-field
parses = true
source = ```nib
let p := Point { x: 1 }
let e := Unit { }
```

@ cases.a-proposition-equation
description = "`a = b` in a type, an argument, a goal and the type of a `let`"
parses = true
source = ```tauto
theorem t1(a: Nat, b: Nat, h: a = b): b = a { Eq::sym(h) }
theorem t2(a: Nat, b: Nat): a = b ∧ b = a { ?h }
theorem t3(a: Nat, b: Nat, h: a = b): ¬(a = Succ(b)) { ?h }
theorem t4(): ∀ n: Nat. n = n { (n: Nat) => Refl }
theorem t5(a: Nat, b: Nat, h: a = b): And(a = b, b = a) {
  let k: a = b := h
  ?h
}
```

@ cases.an-equation-is-not-a-binding
description = "`let` binds with `:=`; the `=` after the type is the proposition's"
parses = true
source = ```tauto
theorem t(a: Nat, b: Nat, h: a = b): b = a {
  let k: b = a := Eq::sym(h)
  k
}
```

@ cases.ascii-escapes-of-signs
description = "`\\times \\land \\lor \\iff \\neg \\vdash \\omega \\forall \\exists` are read as the signs"
parses = true
source = ```tauto
theorem t(P: Prop, Q: Prop): P \land Q \iff Q \land P { ?h }
theorem u(): \forall n: Nat. n = n { (n: Nat) => Refl }
theorem v(): \exists n: Nat. n = n { ExIntro(0, Refl) }
theorem w(P: Prop): \neg P \lor P { ?h }
```

@ cases.match
parses = true
source = ```nib
let a := match s {
  Shape::Circle(r) => r * r
  Shape::Rect { w, h: hh } if w > 0 => w * hh,
  -1 => 2
  _ => 0
}
```

@ cases.function-types
parses = true
source = "let g: (i64, Text) -> Bool := (x: i64, y: Text) => true"

@ cases.effects-and-handlers
parses = true
source = ```nib
effect ask(q: Text): i64

fn total(): i64 ! {ask} {
  perform ask("a") + perform ask("b")
}

let result := handle { total() } with {
  ask(q), k => k(10)
  return v => v * 2
}
```

@ cases.effect-rows
description = "A row binds to the nearest arrow"
parses = true
source = ```nib
fn apply<A, B>(x: A, f: (A) -> B ! {e}): B ! {e} { f(x) }
fn h(): (i64) -> i64 ! {ask} ∪ e { x => x }
```

@ cases.tags
parses = true
source = ```nib
let v := @price 3
```

