@ cases.an-effect-operation-has-its-parameters-in-parentheses
parses = true
source = ```nib
effect ask(question: Text): i64
effect choose(): Bool resume ω
effect show<A>(name: Text, value: A): Unit
effect Talk {ask, choose}
effect State(T: Type) {ask}
```

@ cases.type-parameters-are-declared-in-parentheses
parses = true
source = ```nib
enum Option(A: Type) { None, Some(A) }
struct Pair(A: Type, B: Type) { fst: A, snd: B }
affine struct Box(A: Linear) { value: A }
class Ord(A: Linear) {
  fn compare(&a: A, &b: A): Ordering
}
```

@ cases.spaces-do-not-change-a-macro-call
description = "`m!(x)` and `m! (x)` are the same call; `m!()` passes the unit"
parses = true
source = ```nib
let a := m!(x)
let b := m! (x)
let c := m!()
```

@ cases.an-empty-struct-literal-is-braces
description = "`F {}` and `F { }` are the same struct literal"
parses = true
source = ```nib
let a := F {}
let b := F { }
let c := F {
}
```

@ cases.a-struct-literal-in-a-condition-is-parenthesized
description = "after `if`, `while` and `match` a `{` begins the block; a struct literal is written `(ready {})`"
parses = true
source = ```nib
fn f(ready: Ready): i64 {
  if (ready {}) { 1 } else { 2 }
}
fn g(x: Bool): i64 {
  while x { }
  match x { }
}
```

