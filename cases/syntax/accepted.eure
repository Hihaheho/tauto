@ cases.kinds-on-declarations
parses = true
source = ```nib
affine struct File {}
linear struct Handshake { step: i64 }
copy struct Point { x: i64, y: i64 }
shared enum Tree(A: Type) { Leaf, Node(Tree(A), A, Tree(A)) }
```

@ cases.the-kind-of-a-function-type
parses = true
source = ```nib
fn once(f: affine () -> i64): i64 { f() }
fn exactly(f: linear (Handshake) -> Unit): Unit { #() }
```

@ cases.resume-quantities
parses = true
source = ```nib
effect ask(): i64
effect choose(): Bool resume ω
effect fail(msg: Text): Never resume 0
effect step(): Unit resume 1
effect pick(): i64 resume <=1
```

@ cases.borrowed-parameters-and-results
parses = true
source = ```nib
fn len(&v: Vec(i64)): u64 { Vec::len(&v) }
fn push(&mut v: Vec(i64), x: i64): Unit { Vec::push(&mut v, x) }
fn first(&v: Vec(File)): &File { Vec::index(&v, 0) }
```

@ cases.let-of-a-borrow
parses = true
source = ```nib
fn f(&v: Vec(File)): i64 {
  let &x := Vec::index(&v, 0)
  0
}
```

@ cases.bounds-on-generics
parses = true
source = ```nib
fn twice<A: Shared>(x: A): Pair(A, A) { pair(x, x) }
fn keep<A: Linear>(x: A): A { x }
fn with_file<A, !e: <=1>(path: Text, &body: (&f: File) -> A ! e): A ! e { body(&f) }
```

@ cases.kinds-are-universe-names
parses = true
source = ```nib
fn leveled<A: Linear, F: (Type) -> Copy>(x: F(A)): F(A) { x }
struct Handlers(!e: <=1, A: Shared) { on_key: (k: A) -> i64 ! e }
```

@ cases.an-extern-block
parses = true
source = ```nib
affine struct File {}
affine struct IoError {}
extern {
  fn file_open(&path: Text): Result(File, IoError)
  fn file_close(f: File): Unit
}
```
build = "error: has no rust binding"

@ cases.match-on-a-borrow
parses = true
source = ```nib
fn size(&e: Expr): i64 {
  match &e {
    Num(n) => 1
    Add(l, r) => size(&l) + size(&r)
  }
}
```

