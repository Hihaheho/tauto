// Programs Nib's grammar accepts. Only the parser runs: types and names are
// not checked here.

@ cases.let-var-and-assignment
parses = true
source = ```nib
let rate := 10
var total := 0
total := total + 100
```

@ cases.a-lambda
parses = true
source = "x => x * 2"

@ cases.a-lambda-with-a-block
parses = true
source = ```nib
x => {
  if x == 0 {
    return 0
  }
  x * 2
}
```

@ cases.several-parameters
parses = true
source = "(price, count) => price * count"

@ cases.typed-parameter
parses = true
source = "(x: i64) => x * 2"

@ cases.named-function-and-while
parses = true
source = ```nib
fn factorial(n: i64): i64 {
  var result := 1
  var i := 2
  while i <= n {
    result := result * i
    i := i + 1
  }
  result
}
```

@ cases.else-if
parses = true
source = "if a > 0 { 1 } else if a < 0 { -1 } else { 0 }"

@ cases.operators
parses = true
source = ```nib
let a := -2 + 3 * 4 - 1
let b := x == 1 && not(c) || y != 2
```

@ cases.fields-and-comments
parses = true
source = ```nib
r.price * r.count // a comment
/* a comment
 over lines */ 1
```

@ cases.newlines-inside-parentheses
description = "A newline inside ( ) does not end the statement; `;` does"
parses = true
source = ```nib
f(
  a,
  b
); 1; 2
```

@ cases.continued-binary-operator
parses = true
source = ```nib
