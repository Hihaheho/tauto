description = "An effect declared in the proof language keeps its parameter names when it is extracted, so the extracted program reads back."

@ cases.named-effect-params-run
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
effect ask(key: Nat, bonus: Nat): Nat
fn use_it(): Nat ! {ask} { perform ask(1, 2) }
fn answer(): Nat {
  handle { use_it() } with {
    ask(k, b), r => r(Nat::add(k, b))
  }
}
perform show("v", answer())
```
shows = ["v = 3"]

@ cases.applied-type-effect-param-run
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
effect disk_append(cells: List(Nat)): Unit
effect disk_load(): List(Nat)
fn count(xs: List(Nat)): Nat {
  ⊢ Nat from match xs {
    Nil => 0
    Cons(x, rest) => Succ(count(rest))
  }
}
fn save_and_count(): Nat ! {disk_append, disk_load} {
  perform disk_append(Cons(1, Cons(2, Nil)))
  count(perform disk_load())
}
fn answer(): Nat {
  handle { save_and_count() } with {
    disk_append(cs), r => r(#())
    disk_load(), r => r(Cons(3, Cons(4, Cons(5, Nil))))
  }
}
perform show("v", answer())
```
shows = ["v = 3"]

@ cases.inductive-effect-param-run
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
inductive Cells: Type { Mk(cs: List(Nat)): Cells }
effect disk_append(c: Cells): Unit
fn save(): Nat ! {disk_append} {
  perform disk_append(Cells::Mk(Cons(1, Nil)))
  1
}
fn answer(): Nat {
  handle { save() } with {
    disk_append(c), r => r(#())
  }
}
perform show("v", answer())
```
shows = ["v = 1"]
