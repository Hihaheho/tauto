@ cases.weak-upgrades-while-a-strong-handle-remains
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Ref::new` yet"
source = ```nib
import std::builtin::par
let r := perform ref_new(5)
let w := perform weak_of(r)
perform ref_set(r, 6)
let seen := match perform weak_get(w) { Some(s) => perform ref_get(s), None => 0 }
show(&(seen + perform ref_get(r) - 6))
```
stdout = "6\n"

@ cases.weak-sees-the-slot-the-ref-shares
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Ref::new` yet"
source = ```nib
import std::builtin::par
let r := perform ref_new(1)
let w := perform weak_of(r)
match perform weak_get(w) {
  Some(s) => perform ref_set(s, 9)
  None => ()
}
show(&perform ref_get(r))
```
stdout = "9\n"
