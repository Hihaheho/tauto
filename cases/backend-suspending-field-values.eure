@ cases.a-named-local-suspending-function-keeps-its-shared-capture
backends = ["rust", "javascript", "vm"]
source = ```tauto
import std::prelude::Par
import std::prelude::Shared
shared struct Callback { run: () -> u64 ! {wait} }
fn stored(): Callback {
  let mutex := Mutex::new((42: u64))
  fn locked_value(): u64 ! {wait} {
    let guard := Mutex::lock(mutex)
    let &value := MutexGuard::get(&guard)
    value
  }
  Callback { run: locked_value }
}
let callback := stored()
perform show("result", (callback.run)())
```
shows = ["result = 42"]
rust_shows = ["result = 42"]
javascript_shows = ["result = 42"]

@ cases.a-pattern-bound-function-is-stored-in-another-suspending-field
backends = ["rust", "javascript", "vm"]
source = ```tauto
import std::prelude::Par
import std::prelude::Shared

shared struct Callback { run: () -> u64 ! {wait} }
fn locked_value(): u64 ! {wait} {
  let mutex := Mutex::new((42: u64))
  let guard := Mutex::lock(mutex)
  let &value := MutexGuard::get(&guard)
  value
}
fn transfer(callback: Callback): Callback {
  match callback { Callback { run } => Callback { run: run } }
}
let callback := transfer(Callback { run: locked_value })
perform show("result", (callback.run)())
```
shows = ["result = 42"]
rust_shows = ["result = 42"]
javascript_shows = ["result = 42"]
