@ cases.a-named-local-suspending-function-keeps-its-shared-capture
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```tauto
import std::builtin::par
struct(shared) Callback { run: () -> u64 ! {wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put} }
fn stored(): Callback ! {mutex_new} {
  let mutex := perform mutex_new((42: u64))
  fn locked_value(): u64 ! {wait, mutex_claim} {
    let guard := Mutex::lock(mutex)
    let value := MutexGuard::get(&guard)
    value
  }
  Callback { run: locked_value }
}
let callback := stored()
show(&((callback.run)()))
```
stdout = "42\n"

@ cases.a-pattern-bound-function-is-stored-in-another-suspending-field
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```tauto
import std::builtin::par

struct(shared) Callback { run: () -> u64 ! {wait, mutex_new, mutex_claim, mutex_take_claimed, mutex_put} }
fn locked_value(): u64 ! {wait, mutex_claim, mutex_new} {
  let mutex := perform mutex_new((42: u64))
  let guard := Mutex::lock(mutex)
  let value := MutexGuard::get(&guard)
  value
}
fn transfer(callback: Callback): Callback {
  match callback { Callback { run } => Callback { run: run } }
}
let callback := transfer(Callback { run: locked_value })
show(&((callback.run)()))
```
stdout = "42\n"
