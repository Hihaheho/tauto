@ cases.a-named-suspending-function-is-stored-in-a-shared-field
backends = ["rust", "javascript", "vm"]
source = ```tauto
import std::prelude::Par
import std::prelude::Shared

shared struct Callback { run: () -> u64 ! {wait} }
fn locked_value(): u64 ! {wait} {
  let mutex := Mutex::new((42: u64))
  let guard := Mutex::lock(mutex)
  let &value := MutexGuard::get(&guard)
  value
}
let callback := Callback { run: locked_value }
perform show("result", (callback.run)())
```
shows = ["result = 42"]
rust_shows = ["result = 42"]
javascript_shows = ["result = 42"]

