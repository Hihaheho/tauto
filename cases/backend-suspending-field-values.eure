@ cases.a-named-function-field-suspends-when-called
llvm.unimplemented = "generate: the LLVM backend does not write a function value that may stop yet"
source = ```tauto
import std::builtin::os
struct(shared) Callback { run: (value: nat) -> nat ! {sleep} }
fn delayed(value: nat): nat ! {sleep} { perform sleep(1); value + 1 }
let callback := Callback { run: delayed }
show(&((callback.run)(41)))
```
stdout = "42\n"

