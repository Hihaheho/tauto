// `VecModel` policy is `pf_laws()` (Prefix / Unit), not `tb_laws`.
@ cases.slots-model-pf-laws
differential = "extract"
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::uhost
import std::uint
import std::slots { Prefix, SlotsModel }
import std::vec { pf_used, pf_laws }
fn make(): SlotsModel(Prefix, Unit, Nat, pf_used) {
  SlotsModel::new(UHost::zero(), pf_laws())
}
```
