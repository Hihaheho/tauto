description = "Extraction of indexed and refined values to nominal opaque Nib boundaries, including definitionally equal contracts and rejection of forged or mismatched values."

@ cases.same-contract-roundtrip
files_tote = "app"
extract = true
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
files."app/src/lib.taut" = ```tauto
import std::Nat
import std::Refined

pub(open) inductive Vec(A: Type): (Nat) -> Type {
  Nil: Vec(A, Zero)
  Cons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Succ(n))
}
pub fn empty(): Vec(Nat, 0) { Nil }
pub fn one(x: Nat): Vec(Nat, 1) { Cons(0, x, Nil) }
pub fn head_one(v: Vec(Nat, 1)): Nat {
  ⊢ Nat from match v { Cons(k, x, xs) => x }
}
pub fn OneVec(): Type { Vec(Nat, Succ(Zero)) }
pub fn head_alias(v: OneVec()): Nat { head_one(v) }

pub fn is_pos(n: Nat): Bool {
  ⊢ Bool from match n {
    Zero => false
    Succ(k) => true
  }
}
pub fn Pos(n: Nat): Prop { is_pos(n) = true }
pub fn check_positive(n: Nat): Option(Refined(Nat, Pos)) { refine_by(is_pos, n) }
pub fn zero_only(): Refined(Nat, y => y = 0) { Refined::Mk(0, Refl) }
fn pos_pred(n: Nat, h: Pos(n)): Nat {
  ⊢ Nat from match n {
    Zero => ⊢ Nat from match h {}
    Succ(k) => k
  }
}
pub fn predecessor(p: Refined(Nat, Pos)): Nat {
  ⊢ Nat from match p { Mk(v, h) => pos_pred(v, h) }
}
pub fn read_positive(p: Refined(Nat, y => is_pos(y) = true)): Nat { p.val }
pub fn optional_positive(xs: Option(Refined(Nat, Pos))): Nat {
  ⊢ Nat from match xs {
    None => 0
    Some(p) => predecessor(p)
  }
}
```
files."app/src/main.taut" = ```tauto
import "lib.taut"
perform show("head", head_one(one(10)))
perform show("alias", head_alias(one(11)))
match check_positive(7) {
  None => perform show("missing", 0)
  Some(p) => {
    perform show("pred", predecessor(p))
    perform show("read", read_positive(p))
  }
}
match check_positive(0) {
  None => perform show("rejected", true)
  Some(p) => perform show("value", read_positive(p))
}
```
shows = ["head = 10", "alias = 11", "pred = 6", "read = 7", "rejected = true"]
backends = ["rust", "javascript"]
rust_shows = ["head = 10", "alias = 11", "pred = 6", "read = 7", "rejected = true"]
javascript_shows = ["head = 10", "alias = 11", "pred = 6", "read = 7", "rejected = true"]
extracted_nib.check_positive = ```nib
pub fn check_positive(n: nat): Option(TautoErasedOpaque28_1) { TautoErasedUnpack6_1(TautoErasedFn1_1(TautoErasedValue_1::TautoErasedNat_1(n))) }
```
extracted_nib.head_one = ```nib
pub fn head_one(v: TautoErasedOpaque30_1): nat { TautoErasedGetNat_1(TautoErasedFn15_1(v.value)) }
```
extracted_nib.read_positive = ```nib
pub fn read_positive(p: TautoErasedOpaque28_1): nat { TautoErasedGetNat_1(TautoErasedFn26_1(p.value)) }
```

