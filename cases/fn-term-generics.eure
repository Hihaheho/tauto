description = "Implicit value parameters retain their checked types and executable values."

@ cases.nat-parameter-and-transparent-computation
source = ```tauto
fn remember<n: Nat>(): Nat { n }
fn forward<n: Nat>(): Nat { remember(<n: n>) }
theorem remembers(): remember(<n: 7>) = 7 { Refl }
theorem forwards(): forward(<n: 9>) = 9 { Refl }
```
checks_all = "ok"

@ cases.dependent-telescope
source = ```tauto
fn choose<A: Type, x: A>(): A { x }
theorem natural(): choose(<A: Nat, x: 4>) = 4 { Refl }
theorem boolean(): choose(<A: Bool, x: true>) = true { Refl }
```
checks_all = "ok"

@ cases.value-type-mismatch
source = ```tauto
fn remember<n: Nat>(): Nat { n }
theorem wrong(): remember(<n: true>) = 7 { Refl }
```
checks.remember = "checked"
checks.wrong = "error: "

@ cases.inferred-index-is-retained
imports = [path`../std/nat.taut`]
source = ```tauto
inductive At(n: Nat): Type { Mk: At(n) }
fn index<n: Nat>(w: At(n)): Nat { n }
fn demo(): Nat { index(At::Mk(<n: 17>)) }
show(&demo())
```
stdout = "17\n"

@ cases.dynamic-value-generics-run
imports = [path`../std/nat.taut`]
source = ```tauto
fn choose<A: Type, x: A>(): A { x }
fn pass(n: Nat): Nat { choose(<A: Nat, x: n>) }
show(&pass(23))
```
stdout = "23\n"

@ cases.text-value-generic-runs
imports = [path`../std/text.taut`]
source = ```tauto
fn text_value<s: Text>(): Text { s }
fn pass_text(s: Text): Text { text_value(<s: s>) }
theorem literal_text(): text_value(<s: "日本語">) = "日本語" { Refl }
show(&pass_text("日本語"))
```
stdout = "\"日本語\"\n"

@ cases.constructor-value-generic-runs
imports = [path`../std/nat.taut`]
source = ```tauto
inductive Choice: Type { First: Choice, Second: Choice }
fn select<c: Choice>(): Nat { ⊢ Nat from match c { First => 11, Second => 22 } }
fn pass_choice(c: Choice): Nat { select(<c: c>) }
theorem selects(): select(<c: Second>) = 22 { Refl }
show(&pass_choice(First))
show(&pass_choice(Second))
```
stdout = ```
11
22
```

@ cases.function-value-generic-runs
imports = [path`../std/nat.taut`]
source = ```tauto
fn apply<f: (Nat) -> Nat>(n: Nat): Nat { f(n) }
fn identity(n: Nat): Nat { n }
fn pass_callback(f: (Nat) -> Nat, n: Nat): Nat { apply(<f: f>, n) }
theorem applies(): apply(<f: identity>, 31) = 31 { Refl }
show(&pass_callback(identity, 31))
```
stdout = "31\n"

@ cases.proof-value-generic-is-erased
imports = [path`../std/nat.taut`]
source = ```tauto
fn justified<n: Nat, h: Eq(Nat, n, n)>(): Nat { n }
fn pass_proof(n: Nat): Nat { justified(<n: n, h: Refl>) }
theorem proves(): justified(<n: 41, h: Refl>) = 41 { Refl }
show(&pass_proof(41))
```
stdout = "41\n"

@ cases.runtime-calls-mixed-generic-directly
imports = [path`../std/nat.taut`]
source = ```tauto
fn choose<A: Type, x: A>(): A { x }
let number := 53
show(&choose(<A: Nat, x: number>))
```
stdout = "53\n"

@ cases.checked-function-value-generic-runs
imports = [path`../std/nat.taut`]
source = ```tauto
fn apply<f: (Nat) -> Nat>(n: Nat): Nat { f(n) }
fn identity(n: Nat): Nat { n }
fn pass_callback(f: (Nat) -> Nat, n: Nat): Nat { apply(<f: f>, n) }
fn demo(): Nat { pass_callback(identity, 31) }
show(&demo())
```
stdout = "31\n"

@ cases.function-value-generic-return-boundary
imports = [path`../std/nat.taut`]
source = ```tauto
fn forward<f: (Nat) -> Nat>(): (Nat) -> Nat { f }
fn identity(n: Nat): Nat { n }
show(&(forward(identity)(32)))
```
stdout = "32\n"

@ cases.multiple-argument-function-generic-boundary
imports = [path`../std/nat.taut`]
source = ```tauto
fn apply_two<f: (Nat, Nat) -> Nat>(x: Nat, y: Nat): Nat { f(x, y) }
fn first(x: Nat, y: Nat): Nat { x }
show(&apply_two(first, 61, 62))
```
stdout = "61\n"
