@ cases.multiple-argument-function-generic-boundary
extract = true
imports = [path`../std/Nat.taut`]
source = ```tauto
fn apply_two<f: (Nat, Nat) -> Nat>(x: Nat, y: Nat): Nat { f(x, y) }
fn first(x: Nat, y: Nat): Nat { x }
perform show("two", apply_two(first, 61, 62))
```
shows = ["two = 61"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["two = 61"]
javascript_shows = ["two = 61"]
