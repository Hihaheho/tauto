// The self calls in tail position NIR marks `recur`, and the ones it leaves
// as calls. `crates/tauto-nir/tests/tail_marks.rs` reads the marks.
@ cases.tail_marks_an_owned_accumulator
source = ```tauto
fn count(n: u64, done: u64): u64 {
    if n == 0 { done } else { count(n - 1, done + 1) }
}
perform show("count", count(3, 0))
```
shows = ["count = 3"]

@ cases.tail_marks_a_borrow_passed_on
source = ```tauto
import std::prelude::Affine

fn sum_from(&v: Vec(u64), i: u64, left: u64, acc: u64): u64 {
    if left == 0 {
        acc
    } else {
        let &x := Vec::index(&v, i)
        let next := if i + 1 == Vec::len(&v) { 0 } else { i + 1 }
        sum_from(&v, next, left - 1, acc + x)
    }
}
var v: Vec(u64) := Vec::new()
Vec::push(&mut v, 1)
Vec::push(&mut v, 2)
perform show("sum", handle { sum_from(&v, 0, 3, 0) } with { out_of_bounds() => 0 })
```
shows = ["sum = 4"]

@ cases.tail_marks_a_borrow_of_a_parameters_part
source = ```tauto
fn reverse_onto<A>(l: List(A), acc: List(A)): List(A) {
    ⊢ List(A) from match l {
        Nil => acc
        Cons(h, t) => reverse_onto(t, Cons(h, acc))
    }
}
fn len<A>(l: List(A), n: u64): u64 {
    ⊢ u64 from match l {
        Nil => n
        Cons(_, t) => len(t, n + 1)
    }
}
let xs: List(u64) := Cons(1, Cons(2, Cons(3, Nil)))
let ys := reverse_onto(xs, Nil)
let n := len(ys, 0) + len(xs, 0)
perform show("len", n)
```
shows = ["len = 6"]
backends = ["rust", "javascript"]

