@ cases.plain_recursive_borrow
source = ```tauto
enum Tree { Leaf(i64), Branch(Tree, Tree) }
fn read(t: Tree): i64 ! {overflow} { match t { Leaf(n) => n, Branch(l, r) => read(l) + read(r) } }
fn run(): i64 ! {overflow} { read(Leaf(1)) }
show(&run())
```
stdout = "1\n"

@ cases.closure_recursive_borrow
source = ```tauto
enum Tree { Leaf(i64), Branch(Tree, Tree) }
fn read(t: Tree): i64 ! {overflow} { match t { Leaf(n) => n, Branch(l, r) => read(l) + read(r) } }
fn run(): i64 ! {overflow} { let outer := () => { let inner := () => read(Leaf(1))
inner() }
outer() }
show(&run())
```
stdout = "1\n"

