@ cases.tail_leaves_a_borrow_of_a_local
source = ```tauto
import std::prelude::Affine

fn walk(&v: Vec(u64), left: u64): u64 {
    if left == 0 {
        Vec::len(&v)
    } else {
        var w: Vec(u64) := Vec::new()
        Vec::push(&mut w, left)
        walk(&w, left - 1)
    }
}
var v: Vec(u64) := Vec::new()
perform show("len", walk(&v, 2))
```
shows = ["len = 1"]

@ cases.tail_leaves_a_call_in_a_handle
source = ```tauto
effect ask(): u64 direct
fn inner(n: u64): u64 {
    handle {
        if n == 0 { perform ask() } else { inner(n - 1) }
    } with {
        ask(), k => k(7)
    }
}
perform show("r", inner(3))
```
shows = ["r = 7"]

@ cases.tail_leaves_a_function_that_holds_an_extern_value
source = ```tauto
extern {
  affine type Tally
  fn tally_new(n: i64): Tally
  fn tally_get(&t: Tally): i64
}
fn drain(n: i64, acc: i64): i64 {
    if n == 0 {
        acc
    } else {
        let t := tally_new(n)
        let v := tally_get(&t)
        drain(n - 1, acc + v)
    }
}
```
types = "ok"
rows = "ok"
lin = "ok"

@ cases.tail_leaves_a_function_of_the_m_tier
source = ```tauto
effect choose(): Bool resume ω
fn pick(n: u64, acc: u64): u64 ! {choose} {
    if n == 0 {
        acc
    } else {
        let b := perform choose()
        pick(n - 1, if b { acc + 1 } else { acc })
    }
}
fn all(): u64 {
    handle { pick(2, 0) } with {
        choose(), k => k(true) + k(false)
        return v => v
    }
}
perform show("sum", all())
```
shows = ["sum = 4"]
