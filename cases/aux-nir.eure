@ cases.plain_recursive_borrow
source = ```tauto
enum Tree { Leaf(i64), Branch(Tree, Tree) }
fn read(t: Tree): i64 { match t { Leaf(n) => n, Branch(l, r) => read(l) + read(r) } }
fn run(): i64 { read(Leaf(1)) }
perform show("value", run())
```
shows = ["value = 1"]
backends = ["rust", "javascript"]

@ cases.closure_recursive_borrow
source = ```tauto
enum Tree { Leaf(i64), Branch(Tree, Tree) }
fn read(t: Tree): i64 { match t { Leaf(n) => n, Branch(l, r) => read(l) + read(r) } }
fn run(): i64 { let outer := () => { let inner := () => read(Leaf(1))
inner() }
outer() }
perform show("value", run())
```
shows = ["value = 1"]
backends = ["rust", "javascript"]

@ cases.extraction_markers_do_not_certify_totality
