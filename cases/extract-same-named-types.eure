@ cases.source-roundtrip-selects-runtime-constructors
extract = true
extract_source = true
backends = ["rust", "javascript"]
source = ```tauto
enum Left { Same(i64), Empty, Wildcard { n: i64 } }
enum Right { Same(Text), Empty, Wildcard { text: Text } }

fn left_value(x: Left): i64 {
  match x { Same(n) => n, Empty => 0, Wildcard { n } => n }
}
fn right_value(x: Right): Text {
  match x { Same(text) => text, Empty => "empty", Wildcard { text } => text }
}
fn make_left(): Left { Same(21) }
fn make_right(): Right { Same("日本語") }
let a: Left := Same(42)
let b: Right := Same("right")
let empty_left: Left := Empty
let empty_right: Right := Empty
let record_left: Left := Wildcard { n: 7 }
let record_right: Right := Wildcard { text: "record" }
perform show("a", left_value(a))
perform show("b", right_value(b))
perform show("function_left", left_value(make_left()))
perform show("function_right", right_value(make_right()))
perform show("arg_left", left_value(Same(12)))
perform show("arg_right", right_value(Same("argument")))
perform show("empty_left", left_value(empty_left))
perform show("empty_right", right_value(empty_right))
perform show("record_left", left_value(record_left))
perform show("record_right", right_value(record_right))
perform show("qualified_left", left_value(Left::Same(13)))
perform show("qualified_right", right_value(Right::Same("qualified")))
```
shows = ["a = 42", "b = \"right\"", "function_left = 21", "function_right = \"日本語\"", "arg_left = 12", "arg_right = \"argument\"", "empty_left = 0", "empty_right = \"empty\"", "record_left = 7", "record_right = \"record\"", "qualified_left = 13", "qualified_right = \"qualified\""]

