@ cases.source-roundtrip-keeps-handler-pattern-owners
extract = true
extract_source = true
backends = ["rust", "javascript"]
source = ```tauto
enum Left { Same(i64) }
enum Right { Same(i64) }
effect choose(value: Left): Right
let answer: i64 := handle { perform choose(Left::Same(7)) } with {
  choose(Same(n)), k => k(Right::Same(n + 1))
  choose(_), k => k(Right::Same(0))
  return Same(m) => m
}
perform show("answer", answer)
```
shows = ["answer = 8"]

