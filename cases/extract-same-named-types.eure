description = "Types of one name in two files are extracted apart: each file's constructor builds its own type."

// Two files each declare `Cut` with a constructor `Mk`, one private and one
// open, and each uses its own. The function that builds each struct is
// written in the module of that struct, so the program has one for each file.
@ cases.two-files-declare-a-constructor-of-one-name
extract = true
entry = "main.taut"
files."left.taut" = ```tauto
import std::Base
inductive Cut: Type { Mk(value: Nat, extra: Nat): Cut }
pub fn left(): Nat {
  let cut := Cut::Mk(1, 10)
  ⊢ Nat from match cut { Cut::Mk(value, extra) => value }
}
```
files."right.taut" = ```tauto
import std::Base
pub(open) inductive Cut: Type { Mk(value: Nat, extra: Nat, third: Nat): Cut }
pub fn right(): Nat {
  let cut := Cut::Mk(2, 20, 200)
  ⊢ Nat from match cut { Cut::Mk(value, extra, third) => value }
}
```
files."main.taut" = ```tauto
import "left.taut"
import "right.taut"
perform show("value", left() + right())
```
shows = ["value = 3"]
rust_shows = ["value = 3"]
javascript_shows = ["value = 3"]

// Code that runs matches a constructor two types of one file and the
// prelude's `BelowPair` name `Mk`: a value taken from a field of a matched
// list has the list's element type, whose constructor the pattern is.
@ cases.a-field-of-a-matched-value-has-the-field-type
extract = true
entry = "main.taut"
files."d.taut" = ```tauto
import std::Base
pub(open) inductive Draw: Type {
  Fill(x: Nat): Draw
  ClipPop: Draw
}
pub(open) inductive Item: Type { Mk(id: Nat, d: Draw): Item }
pub(open) inductive DisplayList: Type { Mk(items: List(Item)): DisplayList }
```
files."main.taut" = ```tauto
import std::Base
import std::prelude::Affine
import "d.taut"
fn paint(&mut px: Vec(u32), l: List(Item)): Unit {
  match l {
    Nil => #()
    Cons(it, rest) => {
      match it {
        Mk(id, d) => match d {
          Fill(x) => {
            Vec::push(&mut px, 1)
            paint(&mut px, rest)
          }
          ClipPop => paint(&mut px, rest)
        }
      }
    }
  }
}
fn main(): Unit {
  var v: Vec(u32) := Vec::new()
  paint(&mut v, Cons(Item::Mk(0, Fill(1)), Cons(Item::Mk(1, ClipPop), Nil)))
  perform show("n", Vec::len(&v))
}
main()
```
shows = ["n = 1"]
rust_shows = ["n = 1"]
javascript_shows = ["n = 1"]

