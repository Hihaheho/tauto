@ cases.a-runtime-body-keeps-its-definition-file-constructor
files_tote = "app"
files."app/Tauto.eure" = ```eure
package { name = "app" }
dependencies { lib { path = "../lib" } }
```
files."lib/Tauto.eure" = 'package { name = "lib" }'
files."lib/src/library.taut" = ```tauto
pub fn three(): Nat {
  let value := Some(3)
  perform show("inside", 0)
  match value { Some(number) => number, None => 0 }
}
```
files."app/src/main.taut" = ```tauto
import lib::library
enum Piece { Whole(Nat), Some }
fn tag(piece: Piece): Nat { match piece { Whole(number) => number, Some => 7 } }
perform show("three", three())
perform show("tag", tag(Some))
```
shows = ["inside = 0", "three = 3", "tag = 7"]
rust_shows = ["inside = 0", "three = 3", "tag = 7"]
javascript_shows = ["inside = 0", "three = 3", "tag = 7"]

@ cases.imported-fully-qualified-constructor-keeps-its-reference
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/tree.taut" = ```tauto
pub(open) inductive Tree: Type { Mk(children: List(Tree)): Tree }
pub(open) inductive Span: Type { Mk(start: Nat): Span }
```
files."app/src/other.taut" = ```tauto
pub(open) inductive Tree: Type { Leaf: Tree }
```
files."app/src/main.taut" = ```tauto
import "tree.taut"
import "other.taut"
mutual {
  fn size(tree: app::src::tree::Tree): Nat {
    ⊢ Nat from match tree { Mk(children) => Succ(sizes(children)) }
  }
  fn sizes(trees: List(app::src::tree::Tree)): Nat {
    ⊢ Nat from match trees { Nil => 0, Cons(tree, rest) => size(tree) + sizes(rest) }
  }
}
perform show("size", size(app::src::tree::Tree { children: Cons(app::src::tree::Tree { children: Nil }, Nil) }))
```
shows = ["size = 2"]
rust_shows = ["size = 2"]
javascript_shows = ["size = 2"]

@ cases.shared-fuel-recursion-preserves-constructor-selections
extract = true
source = ```tauto
pub(open) inductive Left: Type { Mk(value: Nat): Left }
pub(open) inductive Right: Type { Mk(value: Nat): Right }
mutual {
  fn left(fuel: Nat): Left {
    ⊢ Left from match fuel {
      Zero => Mk(1)
      Succ(rest) => ⊢ Left from match right(rest) { Mk(value) => Mk(value + 1) }
    }
  }
  fn right(steps: Nat): Right {
    ⊢ Right from match steps {
      Zero => Mk(2)
      Succ(smaller) => ⊢ Right from match left(smaller) { Mk(value) => Mk(value + 1) }
    }
  }
}
theorem left_result(): left(3) = Left::Mk(5) { Refl }
theorem right_result(): right(3) = Right::Mk(4) { Refl }
perform show("left", match left(3) { Mk(value) => value })
perform show("right", match right(3) { Mk(value) => value })
```
shows = ["left = 5", "right = 4"]
rust_shows = ["left = 5", "right = 4"]
javascript_shows = ["left = 5", "right = 4"]

@ cases.dependent-families-preserve-equal-constructor-spellings
extract = true
source = ```tauto
inductive Left: (Nat) -> Type { Mk(value: Nat): Left(1) }
inductive Right: (Nat) -> Type { Mk(value: Nat): Right(1) }
fn left(item: Left(1)): Nat { ⊢ Nat from match item { Mk(value) => value } }
fn right(item: Right(1)): Nat { ⊢ Nat from match item { Mk(value) => value } }
fn result(): Nat { left(Left::Mk(4)) + right(Right::Mk(7)) }
theorem sum(): result() = 11 { Refl }
perform show("sum", result())
```
shows = ["sum = 11"]
rust_shows = ["sum = 11"]
javascript_shows = ["sum = 11"]
