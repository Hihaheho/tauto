@ cases.source-roundtrip-keeps-handler-pattern-owners
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
extract_source = true
source = ```tauto
enum Left { Same(i64) }
enum Right { Same(i64) }
effect choose(value: Left): Right
let answer: i64 := handle { perform choose(Left::Same(7)) } with {
  choose(Same(n)), k => k(Right::Same(n + 1))
  choose(_), k => k(Right::Same(0))
  return Same(m) => m
}
show(&answer)
```
stdout = "8\n"

