@ cases.copy-captures-remain-readable
source = ```nib
struct(copy) Stamp { value: i64 }
let original := Stamp { value: 17 }
let read := () => original.value
show(&read())
show(&original.value)
show(&read())
```
stdout = ```
17
17
17
```

@ cases.shared-capture-last-use-remains-repeatable
source = ```nib
fn make_read(): () -> Text {
  let text := "kept"
  () => text
}
let read := make_read()
show(&read())
show(&read())
```
stdout = ```
"kept"
"kept"
```

@ cases.nested-affine-capture
llvm.unimplemented = "generate: the LLVM backend does not write a closure whose body moves what it captured yet"
source = ```nib
struct(affine) Token { value: i64 }
let original := Token { value: 23 }
let outer: affine () -> affine () -> Token := () => () => original
let inner := outer()
let result := inner()
show(&(match result { Token { value } => value }))
```
stdout = "23\n"

