@ cases.copy-captures-remain-readable
backends = ["rust", "javascript"]
source = ```nib
copy struct Stamp { value: i64 }
let original := Stamp { value: 17 }
let read := () => original.value
perform show("first", read())
perform show("original", original.value)
perform show("second", read())
```
shows = ["first = 17", "original = 17", "second = 17"]

@ cases.shared-capture-last-use-remains-repeatable
backends = ["rust", "javascript"]
source = ```nib
fn make_read(): () -> Text {
  let text := "kept"
  () => text
}
let read := make_read()
perform show("first", read())
perform show("second", read())
```
shows = ["first = \"kept\"", "second = \"kept\""]

@ cases.nested-affine-capture
backends = ["rust", "javascript"]
source = ```nib
affine struct Token { value: i64 }
let original := Token { value: 23 }
let outer: affine () -> affine () -> Token := () => () => original
let inner := outer()
let result := inner()
perform show("nested", match result { Token { value } => value })
```
shows = ["nested = 23"]

@ cases.linear-capture-is-consumed
