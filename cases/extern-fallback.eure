@ cases.fallback-body-calls-imported-fn
description = "A fn body inside a replaceable extern block calls a function it imports, as a fn outside the block does."
source = ```tauto
import std::uint { UInt }

extern {
  pub fn widen(n: Nat): UInt(64) {
    UInt::of_nat_mod64(n)
  }
}

pub fn widen_outside(n: Nat): UInt(64) {
  UInt::of_nat_mod64(n)
}

show(&widen(42))
show(&widen_outside(42))
```
format = ```
import std::uint { UInt }

extern {
  pub fn widen(n: Nat): UInt(64) {
    UInt::of_nat_mod64(n)
  }
}

pub fn widen_outside(n: Nat): UInt(64) {
  UInt::of_nat_mod64(n)
}

show(&widen(42))
show(&widen_outside(42))
```
stdout = "42\n42\n"

@ cases.fallback-body-calls-bound-class-method
description = "A fn body inside a replaceable extern block calls a method of a class its `where` bounds, as a fn outside the block does."
source = ```tauto
pub class Size(A: Shared) { fn size(a: &A): i64 }
instance Size(i64) { fn size(a: &i64): i64 { a } }

extern {
  pub fn doubled<A: Shared>(a: &A): i64 ! {overflow} where Size(A) {
    Size::size(a) + Size::size(a)
  }
}

pub fn doubled_outside<A: Shared>(a: &A): i64 ! {overflow} where Size(A) {
  Size::size(a) + Size::size(a)
}

show(&doubled(&21))
show(&doubled_outside(&21))
```
stdout = "42\n42\n"

@ cases.fallback-body-calls-generic-class-method
description = "A fallback body under a `where` calls a class method with generics of its own, and a struct of the block holds the result: each call gets its own copy of the body, inside the block, on every backend."
source = ```tauto
pub class Fold(A: Shared) { fn fold<H>(a: &A, h: H, step: &((H, i64) -> H)): H }
instance Fold(i64) { fn fold<H>(a: &i64, h: H, step: &((H, i64) -> H)): H { step(h, a) } }

extern {
  pub struct Total { sum: i64 }

  pub fn total<A: Shared>(a: &A): Total where Fold(A) {
    Total { sum: Fold::fold(a, 0, &((h: i64, w: i64) => w)) }
  }

  pub fn sum(t: &Total): i64 {
    t.sum
  }
}

show(&sum(&total(&41)))
```
stdout = "41\n"
