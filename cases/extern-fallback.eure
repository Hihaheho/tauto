// Replaceable `extern` blocks: Tauto bodies as fallback, host bindings as a
// whole-block replacement, with a sealed representation boundary.

@ cases.bodyful-fn-only-fallback
description = "An extern block of functions with bodies runs the Tauto implementation when no host bindings are configured."
source = ```tauto
extern {
  pub fn double(n: i64): i64 ! {overflow} {
    n + n
  }
}
show(&double(21))
```
format = ```
extern {
  pub fn double(n: i64): i64 ! {overflow} {
    n + n
  }
}
show(&double(21))
```
stdout = "42\n"

@ cases.replaceable-cell-fallback
description = "A replaceable struct and its operations use the Tauto representation when unbound."
source = ```tauto
extern {
  pub struct(affine) Cell {
    value: i64,
  }

  pub fn Cell::new(value: i64): Cell {
    Cell { value: value }
  }

  pub fn Cell::get(c: &Cell): i64 {
    c.value
  }

  pub fn Cell::set(c: &mut Cell, value: i64): Unit {
    c.value := value
  }
}

pub fn Cell::bump(c: &mut Cell): Unit ! {overflow} {
  Cell::set(c, Cell::get(c) + 1)
}

var c := Cell::new(40)
Cell::bump(&mut c)
Cell::bump(&mut c)
show(&Cell::get(&c))
```
stdout = "42\n"

@ cases.replaceable-derived-outside
description = "A function outside the replaceable block may call the published operations."
source = ```tauto
extern {
  pub struct(affine) Cell {
    value: i64,
  }

  pub fn Cell::new(value: i64): Cell {
    Cell { value: value }
  }

  pub fn Cell::get(c: &Cell): i64 {
    c.value
  }
}

pub fn Cell::is_zero(c: &Cell): Bool {
  Cell::get(c) == 0
}

show(&Cell::is_zero(&Cell::new(0)))
```
stdout = "true\n"

@ cases.mix-required-and-replaceable
description = "A block cannot mix bodiless required signatures with Tauto bodies."
source = ```tauto
extern {
  type(affine) Host
  fn make(): Host {
    Host {}
  }
}
```
compile_errors.rust = "front: an `extern` block cannot mix"
compile_errors.javascript = "front: an `extern` block cannot mix"
compile_errors.vm = "front: an `extern` block cannot mix"

