@ cases.replaceable-body-as-definition
description = "A pure replaceable body is a kernel definition, so equality proofs can use it."
entry = "main.taut"
files."main.taut" = ```tauto
import std::nat

extern {
  pub fn identity(n: Nat): Nat {
    n
  }
}

theorem id_zero(): identity(Zero) = Zero {
  Refl(<A: Nat, a: Zero>)
}
```
check_errors = []

