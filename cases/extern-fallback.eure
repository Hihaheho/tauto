@ cases.sealed-construction-outside
description = "Code outside a replaceable block cannot construct its type."
entry = "main.taut"
files."main.taut" = ```tauto
extern {
  pub struct(affine) Cell {
    value: i64,
  }

  pub fn Cell::new(value: i64): Cell {
    Cell { value: value }
  }
}

let c := Cell { value: 1 }
show(&0)
```
check_errors = ["`Cell` is a replaceable extern type"]
compile_errors.rust = "front: `Cell` is a replaceable extern type"
compile_errors.javascript = "front: `Cell` is a replaceable extern type"

@ cases.bodiless-extern-still-requires-binding
description = "An existing bodiless extern still needs a host binding."
source = ```tauto
extern {
  fn need_host(n: i64): i64
}
show(&need_host(1))
```
compile_errors.rust = "build: need_host has no rust binding"
javascript.unimplemented = "unsupported: host extern bindings"
vm.unimplemented = "generate: the extern need_host, which has no binding on the machine"

@ cases.sealed-field-outside
description = "Code outside a replaceable block cannot project its fields."
entry = "main.taut"
files."main.taut" = ```tauto
extern {
  pub struct(affine) Cell {
    value: i64,
  }

  pub fn Cell::new(value: i64): Cell {
    Cell { value: value }
  }
}

fn peek(c: &Cell): i64 {
  c.value
}
show(&peek(&Cell::new(1)))
```
check_errors = ["`Cell` is a replaceable extern type"]
compile_errors.rust = "front: `Cell` is a replaceable extern type"
compile_errors.javascript = "front: `Cell` is a replaceable extern type"

