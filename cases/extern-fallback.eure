@ cases.sealed-assign-outside
description = "Code outside a replaceable block cannot update its fields."
entry = "main.taut"
files."main.taut" = ```tauto
extern {
  pub struct(affine) Cell {
    value: i64,
  }

  pub fn Cell::new(value: i64): Cell {
    Cell { value: value }
  }
}

fn poke(c: &mut Cell): Unit {
  c.value := 99
}
show(&0)
```
check_errors = ["`Cell` is a replaceable extern type"]

@ cases.sealed-match-outside
description = "Code outside a replaceable block cannot match on its type."
entry = "main.taut"
files."main.taut" = ```tauto
extern {
  pub struct(affine) Cell {
    value: i64,
  }

  pub fn Cell::new(value: i64): Cell {
    Cell { value: value }
  }
}

fn peek(c: Cell): i64 {
  match c {
    Cell { value: v } => v
  }
}
show(&0)
```
check_errors = ["`Cell` is a replaceable extern type"]

@ cases.replaceable-affine-dup-refused
description = "A replaceable body that duplicates an affine value is refused."
source = ```tauto
extern {
  pub fn twice<A>(x: A): A × A {
    #(x, x)
  }
}
show(&0)
```
lin = "error: x is used after move"

@ cases.replaceable-effect-row-checked
description = "A replaceable body that performs outside its written row is refused."
source = ```tauto
effect noise(): Unit

extern {
  pub fn quiet(): Unit ! {} {
    perform noise()
  }
}
show(&0)
```
rows = "error: `quiet` may perform noise but its row is {}"

