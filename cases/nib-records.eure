description = "A record without a name: the type `{ a: A, b: B }` and the value `#{ a: x, b: y }`. A record is the same type wherever it has the same field names with the same types, in any order; it is not a product."

@ cases.a-record-is-read-by-its-fields
source = ```tauto
fn area(r: { w: u64, h: u64 }): u64 ! {overflow} { r.w * r.h }
show(&area(#{ w: 3, h: 4 }))
```
types = "ok"
stdout = "12\n"

@ cases.the-order-of-the-fields-is-not-part-of-the-type
source = ```tauto
fn swap(r: { b: u64, a: u64 }): { a: u64, b: u64 } { #{ b: r.a, a: r.b } }
let s := swap(#{ a: 1, b: 2 })
show(&s.a)
show(&s.b)
```
types = "ok"
stdout = ```
2
1
```

@ cases.a-record-holds-functions
source = ```tauto
fn run(r: { body: () -> nat, failed: (nat) -> nat }): nat {
  let v := (r.body)()
  if v == 0 { (r.failed)(v) } else { v }
}
show(&run(#{ failed: (e) => e + 100, body: () => 7 }))
show(&run(#{ failed: (e) => e + 100, body: () => 0 }))
```
types = "ok"
stdout = ```
7
100
```

@ cases.a-record-of-lambdas-takes-the-rows-its-parameter-writes
llvm.unimplemented = "unsupported: row variable `e` of `run@u64` is carried by a record and specialized to a suspending row"
source = ```tauto
fn run<E, !e>(r: { body: () -> u64 ! {div, fail(E)} ∪ e, failed: (E) -> u64 ! {div} ∪ e }): u64 ! {div} ∪ e {
  handle { (r.body)() } with {
    fail<E>(why) => (r.failed)(why)
    return v => v
  }
}
fn load(): u64 ! {div, fail(u64)} { let w: u64 := 5; perform fail(w) }
show(&run(#{ failed: (e) => e + 100, body: () => load() }))
show(&run(#{ failed: (e) => e + 100, body: () => 7 }))
```
types = "ok"
rows = "ok"
stdout = ```
105
7
```

@ cases.a-record-of-lambdas-takes-the-row-index-its-parameter-writes
source = ```tauto
struct Ui(!e) { n: nat }
effect ui<!e>(): Ui(e) direct
fn current<!e>(): Ui(e) ! {ui(e)} { perform ui() }
fn run<!e>(r: { body: () -> nat ! {ui(e)} ∪ e, failed: (nat) -> nat ! {ui(e)} ∪ e }): nat ! {ui(e)} ∪ e {
  (r.body)() + (r.failed)(1)
}
fn with_ui<A, !e, !f>(u: Ui(e), body: () -> A ! {ui(e)} ∪ f): A ! f {
  handle { body() } with {
    ui(), k => k(u)
    return v => v
  }
}
fn page(): nat ! {ui(!{})} {
  run(#{ body: () => current().n, failed: (x) => x + current().n })
}
let u: Ui(!{}) := Ui { n: 10 }
show(&with_ui(u, () => page()))
```
types = "ok"
stdout = "21\n"

@ cases.a-record-with-another-field-is-another-type
source = ```tauto
fn f(o: { a: u64 }): u64 { o.a }
let x := f(#{ a: 1, b: 2 })
```
types = "error: { a: i64, b: i64 } does not fit { a: u64 }"

@ cases.a-record-is-not-a-product
source = ```tauto
fn f(o: { a: u64, b: Bool }): u64 { o.a }
let x := f(#(1, true))
```
types = "error: an argument: i64 × Bool does not fit { a: u64, b: Bool }"

@ cases.a-field-is-written-once
source = ```tauto
fn f(o: { a: u64, a: u64 }): u64 { 1 }
```
types = "error: `a` is written twice in the record"

@ cases.a-block-is-not-a-record
source = ```tauto
fn f(a: u64): u64 ! {overflow} {
  let r := { a }
  r + 1
}
show(&f(1))
```
types = "ok"
stdout = "2\n"

@ cases.a-record-type-spans-lines
source = ```tauto
fn run(b: {
  failed: (nat) -> nat,
  body: () -> nat
}): nat {
  let v := (b.body)()
  if v == 0 { (b.failed)(v) } else { v }
}
let empty := {
}
show(&run(#{
  failed: (e) => e + 1,
  body: () => 0,
}))
```
types = "ok"
stdout = "1\n"

// A record a file that calls a macro names is the same struct as the record another file
// of the package names: it is declared once.
@ cases.a-record-in-a-file-with-a-macro-is-the-record-of-the-other-files
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/lib.taut" = ````tauto
pub fn pick(b: { failed: (why: Text) -> u64, body: () -> u64 }): u64 { (b.body)() }
````
files."app/src/mac.taut" = ````tauto
import std::builtin::macro
pub macro fn wrap(e: SynExpr): SynExpr {
  quote { (() => $e)() }
}
````
files."app/src/main.taut" = ````tauto
import "lib.taut"
import "mac.taut"
fn start(): u64 ! {overflow} { wrap!(1) + pick(#{ failed: (why: Text) => 0, body: () => 1 }) }
perform main(() => {
  show(&start())
})
````
stdout = "2\n"
