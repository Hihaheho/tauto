@ cases.halting-closure-call-inside-handled-callback
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Ref::new` yet"
source = ```nib
import std::builtin::par
effect halt(): Never resume 0
struct Located { path: Text }
struct Kind { locate: Option((Text) -> Located ! {halt, div}) }
fn in_frame(body: () -> Text ! {halt, div, ref_set}): Result(Text, Text) ! {div, ref_set} {
  handle { Ok(body()) } with { halt() => Err("halted") }
}
fn run(c: Kind, key: Text): Option(Located) ! {div, ref_get, ref_new, ref_set} {
  match c.locate {
    None => None
    Some(f) => {
      let answer := perform ref_new(Located { path: "pending" })
      let r := in_frame(() => {
        perform ref_set(answer, f(key))
        ""
      })
      match r {
        Ok(x) => Some(perform ref_get(answer))
        Err(e) => None
      }
    }
  }
}
let kind := Kind { locate: Some((k) => Located { path: k }) }
show(&(match run(kind, "a.txt") { Some(l) => l.path, None => "none" }))
```
stdout = ```
"a.txt"
```

@ cases.halting-closure-in-option-field-called-directly
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```nib
effect halt(): Never resume 0
struct Located { path: Text }
struct Kind { locate: Option((Text) -> Located ! {halt, div}) }
fn run(c: Kind, key: Text): Option(Located) ! {halt, div} {
  match c.locate {
    None => None
    Some(f) => Some(f(key))
  }
}
let kind := Kind { locate: Some((k) => Located { path: k }) }
let r := handle { run(kind, "a.txt") } with { halt() => None }
show(&(match r { Some(l) => l.path, None => "none" }))
```
stdout = ```
"a.txt"
```
