description = "The collections of std run: double-ended queue, priority queue, ordered set, hash map and hash set."

@ cases.deque-runs
imports = [path`../std/deque.taut`]
source = ```tauto
let d := Deque::push_front(Deque::push_back(Deque::push_back(Deque::new(), 1), 2), 0)
show(&Deque::to_list(d))
show(&Deque::len(d))
show(&Deque::peek_front(d))
show(&Deque::peek_back(d))
let rest := ⊢ Deque(Nat) from match Deque::pop_back(d) {
  None => Deque::new()
  Some(#(value, remaining)) => remaining
}
show(&Deque::to_list(rest))
let rest2 := ⊢ Deque(Nat) from match Deque::pop_front(rest) {
  None => Deque::new()
  Some(#(value, remaining)) => remaining
}
show(&Deque::to_list(Deque::push_back(rest2, 3)))
let none: Deque(Nat) := Deque::new()
show(&Deque::is_empty(none))
```
stdout = ```
[0, 1, 2]
3
Some(0)
Some(2)
[0, 1]
[1, 3]
true
```

@ cases.heap-runs
imports = [path`../std/heap.taut`, path`../std/map.taut`]
source = ```tauto
let h := Heap::of_list(Ordmap::compare_nat, Cons(5, Cons(1, Cons(4, Cons(1, Cons(3, Cons(9, Cons(2, Nil))))))))
show(&Heap::len(h))
show(&Heap::peek(h))
show(&Heap::into_sorted(Ordmap::compare_nat, h))
let m := Heap::merge(Ordmap::compare_nat, h, Heap::push(Ordmap::compare_nat, Heap::new(), 0))
show(&Heap::into_sorted(Ordmap::compare_nat, m))
let popped := ⊢ Nat from match Heap::pop(Ordmap::compare_nat, m) {
  None => 100
  Some(#(value, remaining)) => value
}
show(&popped)
let none: Heap(Nat) := Heap::new()
show(&Heap::peek(none))
```
stdout = ```
7
Some(1)
[1, 1, 2, 3, 4, 5, 9]
[0, 1, 1, 2, 3, 4, 5, 9]
0
None
```

@ cases.ordset-runs
imports = [path`../std/set.taut`, path`../std/map.taut`]
source = ```tauto
let a := Ordset::of_list(Cons(3, Cons(1, Cons(4, Cons(1, Cons(5, Nil))))), Ordmap::compare_nat)
let b := Ordset::of_list(Cons(4, Cons(5, Cons(6, Nil))), Ordmap::compare_nat)
show(&Ordset::to_list(a))
show(&Ordset::size(a))
show(&Ordset::contains(a, 4, Ordmap::compare_nat))
show(&Ordset::contains(a, 2, Ordmap::compare_nat))
show(&Ordset::to_list(Ordset::remove(a, 3, Ordmap::compare_nat)))
show(&Ordset::to_list(Ordset::union(a, b, Ordmap::compare_nat)))
show(&Ordset::to_list(Ordset::intersection(a, b, Ordmap::compare_nat)))
show(&Ordset::to_list(Ordset::difference(a, b, Ordmap::compare_nat)))
```
stdout = ```
[1, 3, 4, 5]
4
true
false
[1, 4, 5]
[1, 3, 4, 5, 6]
[4, 5]
[1, 3]
```

@ cases.hashmap-runs
imports = [path`../std/hash_map.taut`, path`../std/base.taut`, path`../std/map.taut`]
source = ```tauto
// Keys from 2 on share a hash, so their entries share a bucket.
fn small_hash(k: Nat): Nat {
  Nat::min(k, 2)
}

fn key_eq(a: Nat, b: Nat): Bool {
  ⊢ Bool from match Ordmap::compare_nat(a, b) {
    Less => false
    Equal => true
    Greater => false
  }
}

let m0 := Hmap::of_list(Cons(#(1, 10), Cons(#(2, 20), Cons(#(3, 30), Nil))), small_hash, key_eq)
let m1 := Hmap::insert(m0, 2, 22, small_hash, key_eq)
show(&Hmap::get(m1, 2, small_hash, key_eq))
show(&Hmap::get(m1, 3, small_hash, key_eq))
show(&Hmap::size(m1))
let m2 := Hmap::remove(m1, 3, small_hash, key_eq)
show(&Hmap::get(m2, 3, small_hash, key_eq))
show(&Hmap::size(m2))
show(&Hmap::size(Hmap::remove(m2, 7, small_hash, key_eq)))
show(&Hmap::entries(m2))
let s := Hset::insert(Hset::insert(Hset::insert(Hset::empty(), 5, small_hash, key_eq), 0, small_hash, key_eq), 5, small_hash, key_eq)
show(&Hset::to_list(s))
show(&Hset::contains(s, 0, small_hash, key_eq))
show(&Hset::contains(Hset::remove(s, 0, small_hash, key_eq), 0, small_hash, key_eq))
```
stdout = ```
Some(22)
Some(30)
3
None
2
2
[#(1, 10), #(2, 22)]
[0, 5]
true
false
```
