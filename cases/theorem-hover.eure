@ cases.names_and_keyword
files."main.taut" = ```tauto
theorem identity<P: Prop>(p: P): P { p }
theorem use_identity<Q: Prop>(q: Q): Q { identity(q) }
```
entry = "main.taut"
hovers = [
  { at => "theorem", proof => "identity", contains => ["theorem identity", "_theorem_"] },
  { at => "identity<P", proof => "identity" },
  { at => "identity(q)", proof => "identity" },
  { at => "p }", contains => ["parameter" ] }
]

@ cases.unsaved_import
files."lib.taut" = ```tauto
pub(open) theorem original<P: Prop>(p: P): P { p }
```
files."main.taut" = ```tauto
import "lib.taut"
theorem use<Q: Prop>(q: Q): Q { replacement(q) }
```
entry = "main.taut"
hovers = [{
  at => "replacement(q)", proof => "replacement", proof_file => "lib.taut",
  buffers => { "lib.taut" => ```tauto
pub(open) theorem replacement<P: Prop>(p: P): P { p }
``` }
}]

@ cases.unsaved_entry
files."main.taut" = ```tauto
theorem old<P: Prop>(p: P): P { p }
```
entry = "main.taut"
hovers = [{
  at => "theorem", proof => "edited",
  buffers => { "main.taut" => ```tauto
theorem edited<P: Prop>(p: P): P { p }
``` }
}]

@ cases.incomplete
