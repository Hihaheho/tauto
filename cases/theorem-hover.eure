hovers = [{ at => "theorem comment", absent => true }]

@ cases.axiom_dependency
files."main.taut" = ```tauto
axiom trusted<P: Prop>(p: P): P
theorem dependent<Q: Prop>(q: Q): Q { trusted(q) }
```
entry = "main.taut"
hovers = [{ at => "dependent", proof => "dependent", contains => ["trusted"] }]

@ cases.mutual
files."main.taut" = ```tauto
mutual {
  theorem first<P: Prop>(p: P): P { p }
  theorem second<Q: Prop>(q: Q): Q { q }
}
```
entry = "main.taut"
hovers = [
  { at => "theorem", occurrence => 1, proof => "second" },
  { at => "first<P", proof => "first" }
]
