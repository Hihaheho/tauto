
@ cases.virtual_imports_compile_original_files
entry = "src/main.taut"
files."lib/value.taut" = ```tauto
fn value(): i64 { 21 }
```
files."src/main.taut" = ```tauto
import "../lib/value.taut"
fn answer(): i64 { value() + value() }
```
selfhost_entry = "answer"
selfhost_stdout = "42\n"
differential = "rustgen"

@ cases.unused_imported_proof_is_not_erased
entry = "main.taut"
files."proof.taut" = ```tauto
theorem retained(A: Prop, a: A): A { a }
```
files."main.taut" = ```tauto
import "proof.taut"
fn answer(): i64 { 42 }
```
selfhost_entry = "answer"
selfhost_compile_error = "unsupported declaration: StTheorem"
differential = "rustgen"

