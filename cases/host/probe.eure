@ cases.a-borrowed-temporary-is-dropped-at-the-end-of-its-statement
llvm.unimplemented = "generate: the LLVM backend does not write an `extern` (the native backend has no host) yet"
files_tote = "p"
stdout = ```
1
2
```
probe_drops = ["t", "u", "a"]

files."p/Tauto.eure" = 'package { name = "p" }'
files."p/src/main.taut" = ```tauto
import std::builtin::os
struct(affine) Probe {}
extern {
  fn Probe::new(name: &Text): Probe
}
fn look(probe: &Probe): i64 { 1 }
fn scope(): i64 ! {stdout, stdout_flush} {
  let a := Probe::new("a")
  let n := look(&Probe::new("t"))
  show(&n)
  look(&Probe::new("u"))
  2
}
perform main(() => {
  let r := scope()
  show(&r)
})
```
