@ cases.captures-and-temporaries-left-by-a-resume-0-effect-are-dropped
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
files_tote = "p"
stdout = "0\n"
probe_drops = ["t", "b", "c"]

files."p/Tauto.eure" = 'package { name = "p" }'
files."p/src/main.taut" = ```tauto
struct(affine) Probe {}
extern {
  fn Probe::new(name: &Text): Probe
}
effect stop(): Never resume 0
fn pair(x: Probe, y: i64): i64 { 1 }
fn leave(): i64 ! {stop} {
  let c := Probe::new("c")
  let f := () => c
  let b := Probe::new("b")
  pair(Probe::new("t"), perform stop())
}
perform main(() => {
  let s := handle { leave() } with { stop() => 0 }
  show(&s)
})
```

