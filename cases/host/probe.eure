// The case host gives every runner the same extern: `Probe::new(name)` makes a
// value whose drop the run writes down by name. `probe_drops` compares the
// names in the order the program drops them, on every backend.

@ cases.values-are-dropped-in-reverse-order-of-declaration
llvm.unimplemented = "generate: the LLVM backend does not write an `extern` (the native backend has no host) yet"
files_tote = "p"
stdout = ```
1
2
```
probe_drops = ["b", "a", "c"]

files."p/Tauto.eure" = 'package { name = "p" }'
files."p/src/main.taut" = ```tauto
struct(affine) Probe {}
extern {
  fn Probe::new(name: &Text): Probe
}
fn scope(): i64 {
  let a := Probe::new("a")
  let b := Probe::new("b")
  1
}
perform main(() => {
  let r := scope()
  show(&r)
  let c := Probe::new("c")
  show(&2)
})
```

@ cases.values-left-by-a-resume-0-effect-are-dropped-in-reverse-order
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
files_tote = "p"
stdout = ```
1
2
0
```
probe_drops = ["b", "a", "d", "c"]

files."p/Tauto.eure" = 'package { name = "p" }'
files."p/src/main.taut" = ```tauto
import std::builtin::os { stdout, stdout_flush }
struct(affine) Probe {}
extern {
  fn Probe::new(name: &Text): Probe
}
effect stop(): Never resume 0
fn scope(): i64 ! {stdout, stdout_flush} {
  let a := Probe::new("a")
  let b := Probe::new("b")
  show(&1)
  2
}
fn leave(): i64 ! {stop} {
  let c := Probe::new("c")
  let d := Probe::new("d")
  perform stop()
}
perform main(() => {
  let r := scope()
  show(&r)
  let s := handle { leave() } with { stop() => 0 }
  show(&s)
})
```

