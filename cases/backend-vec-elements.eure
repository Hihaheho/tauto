// A `Vec` of numbers, of texts and of structs that hold a text: pushed,
// read in place, written through a borrow, popped, truncated, cleared and
// swapped, and every element it still holds is released with it.
@ cases.vec-elements
stdout = ```
3
true
true
2
true
true
7
true
