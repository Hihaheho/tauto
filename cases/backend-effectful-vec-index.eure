// `Vec::index` in functions whose rows hold other effects (suspending,
// resuming once or many times, a row variable, a `Never` effect without
// `resume 0`): the index is a plain call of the runtime that may abort with
// `out_of_bounds`, at whatever tier the function around it runs.
@ cases.vec-index-in-a-suspending-function
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```tauto
import std::builtin::os
import std::prelude::collections

fn pick(v: &Vec(u64), i: u64): u64 ! {sleep, out_of_bounds, overflow} {
  perform sleep(1)
  let a := Vec::index(&v, i)
  let b := Vec::index(&v, 0)
  a + b
}
var v := Vec::new()
Vec::push(&mut v, 10)
Vec::push(&mut v, 20)
handle { show(&pick(&v, 1)) } with { out_of_bounds() => show(&0) }
```
stdout = "30\n"

@ cases.vec-index-in-a-multi-shot-function
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```tauto
import std::prelude::collections

effect choose(): Bool resume ω
fn pick(v: &Vec(u64)): u64 ! {choose, out_of_bounds, overflow} {
  let i := if perform choose() { 1 } else { 0 }
  let a := Vec::index(&v, i)
  a + 1
}
var v := Vec::new()
Vec::push(&mut v, 10)
Vec::push(&mut v, 20)
let r := handle { pick(&v) } with {
  choose(), k => k(true) + k(false)
  out_of_bounds() => 0
}
show(&r)
```
stdout = "32\n"

