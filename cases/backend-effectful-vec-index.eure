@ cases.vec-index-in-a-loop-of-a-resuming-function
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```tauto
import std::prelude::collections

effect ask(): u64 resume 1
fn has(v: &Vec(u64)) ! {div, ask, out_of_bounds, overflow} {
  let x := perform ask()
  var i: u64 := 0
  var found := false
  while i < Vec::len(&v) && not(found) {
    let y := Vec::index(&v, i)
    if y == x {
      found := true
    }
    i := i + 1
  }
  found
}
var v := Vec::new()
Vec::push(&mut v, 10)
Vec::push(&mut v, 20)
let r := handle { has(&v) } with {
  ask(), k => k(20)
  out_of_bounds() => false
}
show(&r)
```
stdout = "true\n"

@ cases.vec-index-beside-a-never-effect
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```tauto
import std::prelude::collections

effect boom(): Never
fn pick(v: &Vec(u64), i: u64): u64 ! {boom, out_of_bounds, overflow} {
  if i > 5 { perform boom() } else { #() }
  let a := Vec::index(&v, i)
  a + 1
}
fn outer(v: &Vec(u64)): u64 ! {boom, out_of_bounds, overflow} { pick(&v, 1) }
var v := Vec::new()
Vec::push(&mut v, 10)
Vec::push(&mut v, 20)
let r := handle { outer(&v) } with {
  boom(), k => 0
  out_of_bounds() => 0
}
show(&r)
```
stdout = "21\n"
