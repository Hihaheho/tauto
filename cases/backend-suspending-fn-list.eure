  List::Nil => 0u64,
  List::Cons(f#7: fn() -> u64 shared O, rest#8: List(fn() -> u64 shared O)) => add<u64>(call@6(move f#7) tier O: u64, run_all@2(move rest#8) tier O: u64),
}
```

@ cases.pattern-bound-function-lent-to-a-borrowed-callback
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```nib
import std::builtin::os

fn call_ref<!e>(g: &(() -> u64 ! e)): u64 ! e {
  g()
}
fn run_all(bs: List(() -> u64 ! {sleep})): u64 ! {sleep, overflow} {
  match bs {
    Nil => 0
    Cons(f, rest) => call_ref(&f) + run_all(rest)
  }
}
fn lend(f: () -> u64 ! {sleep}): u64 ! {sleep} {
  call_ref(&f)
}
show(&run_all([() => { perform sleep(1); 4 }, () => 5]))
show(&lend(() => { perform sleep(1); 6 }))
```
stdout = ```
9
6
```
nir.fns.call_ref = ```nir
fn call_ref@7(fnref g#13: &fn() -> u64 shared O): u64 O = g#13() tier O: u64
```
nir.fns.run_all = ```nir
fn run_all@2(bs#6: List(fn() -> u64 shared O)): u64 O = match move bs#6 {
  List::Nil => 0u64,
  List::Cons(f#7: fn() -> u64 shared O, rest#8: List(fn() -> u64 shared O)) => add<u64>(call_ref@7(&f#7) tier O: u64, run_all@2(move rest#8) tier O: u64),
}
```
nir.fns.lend = ```nir
fn lend@4(f#10: fn() -> u64 shared O): u64 O = call_ref@7(&f#10) tier O: u64
