@ cases.pattern-bound-function-specializes-a-row-variable
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```nib
import std::builtin::os

fn call<!e>(g: () -> u64 ! e): u64 ! e {
  g()
}
fn run_all(bs: List(() -> u64 ! {sleep})): u64 ! {sleep, overflow} {
  match bs {
    Nil => 0
    Cons(f, rest) => call(f) + run_all(rest)
  }
}
show(&run_all([() => { perform sleep(1); 1 }, () => 2]))
```
