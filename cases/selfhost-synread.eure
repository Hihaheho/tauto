// Differential cases for `totes/synread`: the first line of a case's source is `NAME SHA256` (and `.START` for
// another start symbol) of the tables in `.tauto-syntax`, the rest is the literal. The tote writes the parser's
// text and the value the literal is read into; `tools/selfhost-harness/tests/synread.rs` compares both with
// `tauto_syntax` and the host's reader of a literal.

// an lalr sum of numbers
@ cases.an-lalr-sum-of-numbers
source = ```synread
lalr_sum 217889452ee1a277575c49ee08ae56b240d90c7c465b87bcd93390a2d40b2068
1 + 2 = 3
```
differential = "synread"

// a left recursive sum is read left first
@ cases.a-left-recursive-sum-is-read-left-first
source = ```synread
lalr_sum 217889452ee1a277575c49ee08ae56b240d90c7c465b87bcd93390a2d40b2068
1 + 2 + 3 = 6
```
differential = "synread"

// a parenthesised lalr sum
@ cases.a-parenthesised-lalr-sum
source = ```synread
lalr_sum 217889452ee1a277575c49ee08ae56b240d90c7c465b87bcd93390a2d40b2068
(1 + (2 + 3)) = 4
```
differential = "synread"

