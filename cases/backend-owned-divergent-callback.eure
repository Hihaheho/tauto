@ cases.total-callback-that-runs-a-budget-under-a-budget
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
fn count(n: nat): nat ! {div} {
  var i: nat := 0
  while i < n { i := i + 1 }
  i
}
fn bounded(n: nat): nat ! {budget} {
  handle { perform budget(1000, () => { count(n) }) } with {
    exceeded(info), k => 0
  }
}
fn apply<A: Shared>(f: (A) -> A ! {budget}, n: A): A ! {budget} { f(n) }
let value := handle {
  perform budget(1000, () => { apply((x) => bounded(x), 5) })
} with {
  exceeded(info), k => 0
}
show(&value)
```
stdout = "5\n"

// A function value that is resumed at most once, called in code that an
// operation of `resume ω` runs again: each run makes the call, and the call
// stops for its operation until the handler outside answers.
@ cases.a-function-value-called-under-multi-shot-stops-for-an-outer-handler
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```tauto
effect ask(): nat
effect choose(): Bool resume ω
fn body<!r>(f: () -> nat ! {div} ∪ r): nat ! {choose, div} ∪ r {
  let b := perform choose()
  let v := f()
  if b { v } else { v + 10 }
}
fn both(f: () -> nat ! {ask, div}): nat ! {ask, div} {
  handle { body(f) } with {
    choose(), k => k(true) + k(false)
    return x => x
  }
}
show(&(handle { both(() => perform ask() + perform ask()) } with {
  ask(), k => k(1)
  return v => v
}))
let z := handle { perform budget(1000, () => { 7 }) } with {
  exceeded(info), k => 0
}
show(&z)
```
stdout = "14\n7\n"

// The same call ended by an operation of `resume 0` that the handler of the
// `resume ω` operation takes: the call is dropped where it stopped.
@ cases.a-function-value-called-under-multi-shot-aborts-to-its-handler
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```tauto
effect stop(n: nat): Never resume 0
effect ask(): nat
effect choose(): Bool resume ω
fn body<!r>(f: () -> nat ! {div} ∪ r): nat ! {choose, div} ∪ r {
  let b := perform choose()
  let v := f()
  if b { v } else { v + 10 }
}
fn both(f: () -> nat ! {ask, stop, div}): nat ! {ask, div} {
  handle { body(f) } with {
    choose(), k => k(true) + k(false)
    stop(n) => n
    return x => x
  }
}
show(&(handle { both(() => { let a := perform ask(); if a > 0 { perform stop(a + 5) } else { a } }) } with {
  ask(), k => k(1)
  return v => v
}))
let z := handle { perform budget(1000, () => { 7 }) } with {
  exceeded(info), k => 0
}
show(&z)
```
stdout = "12\n7\n"
