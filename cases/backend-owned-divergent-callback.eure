@ cases.nested-owned-callback-under-multi-shot-budget
backends = ["rust", "javascript"]
source = ```tauto
effect ask(): i64 resume ω
fn twice(f: (i64) -> i64 ! {Div}, x: i64): i64 { f(f(x)) }
let value := handle {
  let n := perform ask()
  handle { budget(steps: 0) { twice(x => x + n, 3) } } with {
    exceeded(info), k => info.unbounded()
  }
} with {
  ask(), k => k(1) + k(2)
}
perform show("value", value)
```
shows = ["value = 12"]

