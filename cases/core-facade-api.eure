description = "Class extraction inputs, macro reports and syntax API contracts."

@ cases.prelude_class_extraction
imports = [path`../std/Base.taut`]
source = ```tauto
inductive P: Type {
  Mk: P
}
instance Ord(P) {
  fn compare(&a: P, &b: P): Ordering { Equal }
}
fn is_less<A>(a: A, b: A): Bool where Ord(A) {
  ⊢ Bool from match Ord::compare(a, b) {
    Less => true
    Equal => false
    Greater => false
  }
}
fn use_it(a: P, b: P): Bool { is_less(a, b) }
```
checks."P" = "ok"
checks."is_less" = "ok"
checks."use_it" = "ok"

@ cases.declared_class_extraction
imports = [path`../std/Base.taut`]
source = ```tauto
class Key(A: Type) {
  fn key(a: A): Nat
  theorem same<a: A>(): Key::key(a) = Key::key(a)
}
instance Key(Nat) {
  fn key(a: Nat): Nat { a }
  theorem same<a: Nat>(): Key::key(a) = Key::key(a) { Refl }
}
fn key_of<A>(a: A): Nat where Key(A) { Key::key(a) }
```
checks."Key" = "ok"
checks."key_of" = "ok"

@ cases.class_missing_law_filled
imports = [path`../std/Base.taut`]
source = ```tauto

class Cmp(A: Type) {
  fn compare(a: A, b: A): Ordering
  theorem refl<a: A>(): Cmp::compare(a, a) = Equal
  theorem irrefl<a: A>(h: Cmp::compare(a, a) = Less): False
}

fn nat_cmp(a: Nat, b: Nat): Ordering {
  ⊢ Ordering from match a {
    Zero => ⊢ Ordering from match b {
      Zero => Equal
      Succ(b2) => Less
    }
    Succ(a2) => ⊢ Ordering from match b {
      Zero => Greater
      Succ(b2) => nat_cmp(a2, b2)
    }
  }
}

theorem nat_cmp_refl(a: Nat): nat_cmp(a, a) = Equal {
  ⊢ nat_cmp(a, a) = Equal from match a {
    Zero => Refl
    Succ(k) => nat_cmp_refl(k)
  }
}

instance Cmp(Nat) {
  fn compare(a: Nat, b: Nat): Ordering { nat_cmp(a, b) }
  theorem refl<a: Nat>(): Cmp::compare(a, a) = Equal { nat_cmp_refl(a) }
  theorem irrefl<a: Nat>(h: Cmp::compare(a, a) = Less): False {
    less_ne_equal(Eq::trans(Eq::sym(h), nat_cmp_refl(a)))
  }
}

inductive P: Type {
  Mk: P
}
instance Cmp(P) {
  fn compare(a: P, b: P): Ordering { Equal }
  theorem refl<a: P>(): Cmp::compare(a, a) = Equal { Refl }
  theorem irrefl<a: P>(h: Cmp::compare(a, a) = Less): False { False::elim(equal_ne_less(h)) }
}
theorem uses_the_missing_law(a: P, h: Cmp::compare(a, a) = Less): False {
  Cmp::irrefl(h)
}
theorem uses_a_law_it_has(a: P): Cmp::compare(a, a) = Equal { Cmp::refl() }
fn still_compares(a: P, b: P): Ordering { Cmp::compare(a, b) }
```
checks."Cmp::laws@P" = "ok"
checks."uses_the_missing_law" = "ok"
checks."uses_a_law_it_has" = "ok"

@ cases.macro_report_syntax
files."math.nib" = ````tauto
syntax!(math, ```par
%start Eqn
%title "math"
%%
Eqn: Sum Equals Sum;
Sum: Term { Plus Term };
Term: Num | Paren;
Paren: LParen Sum RParen;
Num: /[0-9]+/;
Equals: '=';
Plus: '+';
LParen: '(';
RParen: ')';
```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1, enum Term,
  fn parse

pub fn math_term(t: math::Term): SynExpr ! {macro_error, Div} {
  match t {
    Num(tok) => Syn::nat(tok)
    Paren(p) => math_sum(p.sum)
  }
}

pub fn math_rest(acc: SynExpr, rest: List(math::Sum_Rep1)): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => {
      let t := math_term(r.term)
      math_rest(quote { $acc + $t }, more)
    }
  }
}

pub fn math_sum(s: math::Sum): SynExpr ! {macro_error, Div} {
  math_rest(math_term(s.term), s.rep)
}

pub macro fn math(e: math::Eqn): SynExpr ! {macro_error, Div} {
  let l := math_sum(e.sum)
  let r := math_sum(e.sum_2)
  quote { Eq(Nat, $l, $r) }
}
````
files."main.nib" = ```tauto
import "math.nib"
theorem one_plus_two(): math!(`1 + 2 = 3`) { Refl(Nat, 3) }
```
checks."one_plus_two" = "ok"
trace = ["math"]

@ cases.macro_report_typed
files."lib.nib" = ```tauto
pub macro fn keep(c: Judgement): SynExpr { Judgement::term(c) }
```
files."main.nib" = ```tauto
import "lib.nib"
theorem in_type(n: Nat): keep!(n = n) { Refl(Nat, n) }
theorem in_param(n: keep!(Nat)): n = n { Refl(Nat, n) }
```
checks."in_type" = "ok"
checks."in_param" = "ok"
trace = ["keep", "keep"]

