@ cases.nested-reborrow-updates-the-owner
source = ```nib
struct(copy) Point { x: i64, y: i64 }
struct(copy) Boxed { point: Point, mark: i64 }
fn through(value: &mut Boxed): &mut Point { &mut value.point }
fn forward(point: &mut Point): &mut Point { &mut point }
fn set(n: &mut i64, value: i64): Unit { *n := value }
var boxed := Boxed { point: Point { x: 10, y: 20 }, mark: 30 }
{
  let borrowed := through(&mut boxed)
  set(&mut borrowed.x, 40)
  {
    let again := forward(&mut borrowed)
    set(&mut again.y, 50)
  }
  show(&borrowed.x)
}
show(&boxed)
```
stdout = ```
40
Boxed { point: Point { x: 40, y: 50 }, mark: 30 }
```

@ cases.borrowed-tail-survives-multiple-resumptions
llvm.unimplemented = "generate: the LLVM backend does not write a `var` shared with a closure yet"
source = ```nib
effect choose(): Bool resume ω
fn sum(items: &List(i64)): i64 ! {div, overflow} {
  match items { Nil => 0, Cons(head, tail) => head + sum(&tail) }
}
fn pick(items: &List(i64)): i64 ! {choose, div, overflow} {
  match items {
    Nil => 0
    Cons(head, tail) => if perform choose() { head + sum(&tail) } else { sum(&tail) }
  }
}
var items := [1, 2, 4, 8]
let result := handle { pick(&items) } with {
  choose(), k => k(true) + k(false)
}
show(&result)
items := [20, 30]
show(&sum(&items))
```
stdout = ```
29
50
```

@ cases.collection-entry-and-named-field-reborrows
llvm.unimplemented = "generate: the LLVM backend does not write internal: a value of one type where a value of another is read yet"
source = ```nib
import std::indexed_map { IndexedMap }

struct(copy) Point { x: i64, y: i64 }
struct Store { items: Vec(Point), entries: IndexedMap(Text, Point) }
fn set(n: &mut i64, value: i64): Unit { *n := value }
var store := Store { items: Vec::new(), entries: IndexedMap::new() }
Vec::push(&mut store.items, Point { x: 1, y: 2 })
IndexedMap::insert(&mut store.entries, "a", Point { x: 3, y: 4 })
match Vec::get_mut(&mut store.items, 0) {
  Some(at) => set(&mut at.y, 20)
  None => #()
}
match IndexedMap::get_mut(&mut store.entries, "a") {
  Some(at) => set(&mut at.x, 30)
  None => #()
}
show(&Vec::get(&store.items, 0))
show(&IndexedMap::get(&store.entries, "a"))
```
stdout = ```
Some(Point { x: 1, y: 20 })
Some(Point { x: 30, y: 4 })
```
