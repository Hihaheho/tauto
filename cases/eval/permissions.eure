files."allowed/a.txt" = "inside"
files."main.nib" = ```nib
import std::builtin::os

match perform argv() {
  Cons(inside, Cons(outside, Nil)) => {
    show(&(match perform permission("read", inside) {
      Some(_) => "covered"
      None => "not covered"
    }))
    show(&(perform permission("read", outside)))
    show(&(perform permission("env", "HOME")))
  }
  _ => #()
}
