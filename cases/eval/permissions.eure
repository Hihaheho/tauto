// Under a grant of every path the check gives a path back resolved, as it
// does under a grant of some paths: `permission("read", ".")` is the
// current directory's absolute path, never `.` itself.
@ cases.a-path-the-check-covers-comes-back-resolved-under-allow-all
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `permission` yet"
files."sub/a.txt" = "inside"
files."main.nib" = ```nib
import std::builtin::os

fn resolved(path: Text): Option(Text) ! {permission, fs_canonicalize} {
  match perform fs_canonicalize(path) {
    Ok(p) => Some(p)
    Err(_) => None
  }
}
match perform argv() {
  Cons(dir, Nil) => {
    let got := perform permission("read", concat(dir, "/sub/.."))
    show(&(if got == resolved(dir) { "resolved" } else { "as written" }))
    let dot := perform permission("read", ".")
    show(&(if dot == resolved(".") { "resolved" } else { "as written" }))
    show(&(perform permission("run", "sh")))
  }
  _ => #()
}
```
permissions = ["--allow-all"]
args = ["{dir}"]
stdout = ```
"resolved"
"resolved"
Some("sh")
```

// A program asks the host's permission check itself: covered, the target
// as the host will use it; not covered, `None`. Asking needs no flag.
@ cases.a-program-asks-the-permission-check
