import std::builtin::os
fn held(r: Result(FileLock, IoError)): Text ! {fs_unlock} {
  match r {
    Ok(l) => {
      perform fs_unlock(l)
      perform fs_unlock(l)
      "held or unavailable"
    }
    Err(Denied(_)) => "denied"
    Err(_) => "held or unavailable"
  }
}
match perform argv() {
  Cons(d, Nil) => {
    let ^created := perform fs_create_dir(d)
    let f := concat(d, "/state.lock")
    let ^removed := perform fs_remove(f)
    show(&held(perform fs_lock(f)))
    show(&held(perform fs_lock(f)))
    show(&held(perform fs_lock("/tmp/outside-the-grant.lock")))
    let ^removed := perform fs_remove(f)
  }
  _ => #()
}
