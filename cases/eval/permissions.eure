import std::builtin::os
import std::builtin::par

fn read_in_task(path: Text): Result(Text, IoError) ! {∀ A. spawn(() -> A ! {fs_read}), wait} {
  Task::join(perform spawn(() => perform fs_read(path)))
}
match perform argv() {
  Cons(inside, Cons(outside, Nil)) => {
    let both := #(read_in_task(inside), read_in_task(outside))
    show(&both.fst)
    match both.snd {
      Ok(t) => show(&t)
      Err(Denied(_)) => show(&"denied")
      Err(Failed(_)) => show(&"failed")
      Err(TimedOut) => show(&"timed out")
    }
  }
  _ => #()
}
