  dir: "",
  env: [#("X", "set")],
  stdin: Bytes::of_text("in")
}
match perform proc_run(p) {
  Ok(o) => {
    show(&o.status)
    show(&Text::of_bytes(o.stdout))
    show(&o.stderr)
  }
  Err(_) => show(&"failed")
}
match perform proc_run(Process { program: "env", args: [], dir: "", env: [], stdin: Bytes::of_text("") }) {
  Ok(_) => show(&"ran")
  Err(Denied(_)) => show(&"denied")
  Err(_) => show(&"failed")
}
