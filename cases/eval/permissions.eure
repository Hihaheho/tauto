// `fs_set_mode` makes a file read-only or writable and executable or not,
// and `fs_stat` reads the executable bit back. It needs the write
// permission for the file. (Whether a read-only file can be written is not
// shown: the superuser may write it.)
@ cases.set-mode-sets-what-stat-reads-back
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `fs_create_dir` yet"
files."main.nib" = ```nib
import std::builtin::os
fn exe(r: Result(Option(FileStat), IoError)): Text {
  match r {
    Ok(Some(st)) => if st.executable { "x" } else { "-" }
    Ok(None) => "none"
    Err(_) => "failed"
  }
}
fn done(r: Result(Unit, IoError)): Text {
  match r {
    Ok(_) => "ok"
    Err(Denied(_)) => "denied"
    Err(_) => "failed"
  }
}
match perform argv() {
  Cons(d, Nil) => {
    let ^created := perform fs_create_dir(d)
    let a := concat(d, "/a.sh")
    let ^removed := perform fs_remove(a)
    let ^written := perform fs_write(a, "echo hi")
    show(&exe(perform fs_stat(a)))
    show(&done(perform fs_set_mode(a, false, true)))
    show(&exe(perform fs_stat(a)))
    show(&done(perform fs_set_mode(a, true, false)))
    show(&exe(perform fs_stat(a)))
    show(&done(perform fs_set_mode(a, true, true)))
    show(&exe(perform fs_stat(a)))
    show(&done(perform fs_set_mode(a, false, false)))
    show(&exe(perform fs_stat(a)))
    show(&done(perform fs_set_mode(concat(d, "/absent"), false, false)))
    show(&done(perform fs_set_mode("/tmp/outside-the-grant.txt", false, false)))
    let ^removed := perform fs_remove(a)
  }
  _ => #()
}
