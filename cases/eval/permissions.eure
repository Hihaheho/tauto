// `fs_stat` tells a file from a directory and what is not there, `fs_rename`
// and `fs_copy` need `--allow-write` for the path they write, and
// `fs_canonicalize` gives the path the host will use.
@ cases.a-path-is-statted-renamed-and-copied
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `fs_create_dir` yet"
files."main.nib" = ```nib
import std::builtin::os
fn kind(r: Result(Option(FileStat), IoError)): Text {
  match r {
    Ok(None) => "absent"
    Ok(Some(s)) => match s.kind {
      IsFile => concat("file ", Text::of_u64(s.size))
      IsDir => "dir"
      IsOther => "other"
    }
    Err(_) => "failed"
  }
}
match perform argv() {
  Cons(d, Nil) => {
    let a := concat(d, "/a.txt")
    let b := concat(d, "/b.txt")
    let ^created := perform fs_create_dir(d)
    let ^written := perform fs_write(a, "abc")
    let ^removed := perform fs_remove(b)
    show(&kind(perform fs_stat(a)))
    show(&kind(perform fs_stat(d)))
    show(&kind(perform fs_stat(b)))
    show(&(perform fs_copy(a, b)))
    show(&kind(perform fs_stat(b)))
    show(&(perform fs_rename(b, concat(d, "/c.txt"))))
    show(&kind(perform fs_stat(b)))
    show(&kind(perform fs_stat(concat(d, "/c.txt"))))
    show(&(match perform fs_canonicalize(concat(d, "/./a.txt")) {
      Ok(p) => match perform fs_canonicalize(a) {
        Ok(q) => p == q
        Err(_) => false
      }
      Err(_) => false
    }))
    let ^removed := perform fs_remove(concat(d, "/c.txt"))
  }
  _ => #()
}
```
