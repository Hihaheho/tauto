// `fs_read_link` reads a link as it is and `fs_write_new` makes a file only where nothing is:
// not over a file, not over a link (even one that points at nothing), and never through one.
// The permission covers the place of the entry, so a link that points out of the granted
// directory can be read, and a file cannot be made through it.
@ cases.a-link-is-read-and-a-new-file-never-goes-through-it
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `fs_create_dir` yet"
files."main.nib" = ```nib
import std::builtin::os
fn target(r: Result(Option(Text), IoError)): Text {
  match r {
    Ok(None) => "none"
    Ok(Some(t)) => t
    Err(Denied(_)) => "denied"
    Err(_) => "failed"
  }
}
fn done(r: Result(Unit, IoError)): Text {
  match r {
    Ok(_) => "made"
    Err(Denied(_)) => "denied"
    Err(_) => "failed"
  }
}
match perform argv() {
  Cons(d, Nil) => {
    let ^created := perform fs_create_dir(d)
    let a := concat(d, "/a.txt")
    let l := concat(d, "/l")
    let dangling := concat(d, "/dangling")
    let ^removed := perform fs_remove(a)
    let ^removed := perform fs_remove(l)
    let ^removed := perform fs_remove(dangling)
    let ^written := perform fs_write(a, "abc")
    let ln := Process { program: "ln", args: ["-s", "a.txt", l], dir: "", env: [] stdin: Bytes::of_text("") }
    let ln2 := Process { program: "ln", args: ["-s", "nowhere", dangling], dir: "", env: [] stdin: Bytes::of_text("") }
    let ^ran := perform proc_run(ln)
    let ^ran := perform proc_run(ln2)
    show(&target(perform fs_read_link(l)))
    show(&target(perform fs_read_link(dangling)))
    show(&target(perform fs_read_link(a)))
    show(&target(perform fs_read_link(concat(d, "/absent"))))
    show(&done(perform fs_write_new(a, "x")))
    show(&done(perform fs_write_new(l, "x")))
    show(&done(perform fs_write_new(dangling, "x")))
    show(&(perform fs_read(a)))
    show(&target(perform fs_read_link(dangling)))
    show(&done(perform fs_write_new(concat(d, "/fresh.txt"), "new")))
    show(&(perform fs_read(concat(d, "/fresh.txt"))))
    show(&done(perform fs_write_new("/tmp/outside-the-grant.txt", "x")))
    show(&done(perform fs_write_new(concat(d, "/.."), "x")))
    let ^removed := perform fs_remove(concat(d, "/fresh.txt"))
  }
  _ => #()
}
```
