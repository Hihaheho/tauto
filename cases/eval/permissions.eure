files."main.nib" = ```nib
import std::builtin::os

match perform argv() {
  Cons(d, Nil) => {
    // The case runs twice in the same directory: put `sub` back first.
    let ^created := perform fs_create_dir(concat(d, "/sub"))
    let ^written := perform fs_write(concat(d, "/sub/c.txt"), "")
    show(&(perform fs_list_dir(d)))
    show(&(perform fs_remove(concat(d, "/sub"))))
    show(&(perform fs_list_dir(d)))
  }
  _ => #()
}
