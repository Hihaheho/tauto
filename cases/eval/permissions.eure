// A deadline already passed still takes bytes that have already arrived,
// without waiting: a program can check a connection it is not waiting on.
// The first read waits so the bytes are known to be there; the second takes
// the rest past its deadline, and only a third, with nothing left, times out.
@ cases.a-stream-read-past-its-deadline-takes-what-arrived
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `monotonic_clock` yet"
files."main.nib" = ```nib
import std::builtin::os

fn bytes_text(r: Result(Bytes, IoError)): Text {
  match r {
    Ok(bs) => match Text::of_bytes(bs) {
      Some(t) => t
      None => "not UTF-8"
    }
    Err(e) => io_message(e)
  }
}
let later := perform monotonic_clock() + 5000000000
match perform tcp_listen("127.0.0.1:0") {
  Ok(l) => match perform tcp_connect(TcpListener::address(&l), Some(later)) {
    Ok(c) => match perform tcp_accept(l, Some(later)) {
      TcpAccepted { listener, got } => match got {
        Ok(s) => match perform tcp_write(c, Bytes::of_list([104, 105, 33]), None) {
          TcpWritten { stream: c2, result } => {
            show(&result)
            match perform tcp_read(s, 1, Some(later)) {
              TcpRead { stream: s2, got: first } => {
                show(&bytes_text(first))
                match perform tcp_read(s2, 16, Some(perform monotonic_clock())) {
                  TcpRead { stream: s3, got: rest } => {
                    show(&bytes_text(rest))
                    match perform tcp_read(s3, 16, Some(perform monotonic_clock())) {
                      TcpRead { stream: s4, got: none } => {
                        show(&none)
                        perform tcp_close(s4)
                        perform tcp_close(c2)
                      }
                    }
                  }
                }
              }
            }
          }
        }
        Err(e) => show(&io_message(e))
      }
    }
    Err(e) => show(&io_message(e))
  }
  Err(e) => show(&io_message(e))
}
