// Byte streams (`tcp_*`): one program listens, connects to itself and
// echoes. The connection waits in the system's backlog until the accept,
// so one task is enough.
@ cases.a-stream-connects-to-its-own-listener
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `monotonic_clock` yet"
files."main.nib" = ```nib
import std::builtin::os

fn bytes_text(r: Result(Bytes, IoError)): Text {
  match r {
    Ok(bs) => match Text::of_bytes(bs) {
      Some(t) => t
      None => "not UTF-8"
    }
    Err(e) => io_message(e)
  }
}
let later := perform monotonic_clock() + 5000000000
match perform tcp_listen("127.0.0.1:0") {
  Ok(l) => match perform tcp_connect(TcpListener::address(&l), Some(later)) {
    Ok(c) => match perform tcp_accept(l, Some(later)) {
      TcpAccepted { listener, got } => match got {
        Ok(s) => {
          let stop := TcpStream::stopper(&c)
          match perform tcp_write(c, Bytes::of_list([104, 105, 33]), None) {
            TcpWritten { stream: c2, result } => {
              show(&result)
              show(&(perform tcp_shutdown(stop, ShutdownWrite)))
              match perform tcp_read(s, 2, Some(later)) {
                TcpRead { stream: s2, got: two } => {
                  show(&bytes_text(two))
                  match perform tcp_read(s2, 16, Some(later)) {
                    TcpRead { stream: s3, got: rest } => {
                      show(&bytes_text(rest))
                      match perform tcp_read(s3, 16, Some(later)) {
                        TcpRead { stream: s4, got: end } => {
                          show(&end)
                          perform tcp_close(s4)
                          perform tcp_close(c2)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        Err(e) => show(&io_message(e))
      }
    }
    Err(e) => show(&io_message(e))
  }
  Err(e) => show(&io_message(e))
}
```
permissions = ["--allow-net=127.0.0.1"]
stdout = ```
Ok(())
Ok(())
"hi"
"!"
Ok(Bytes[])
```

// What a read gives may be written back: an echo.
@ cases.a-stream-echoes-what-it-reads
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `tcp_listen` yet"
files."main.nib" = ```nib
import std::builtin::os

match perform tcp_listen("127.0.0.1:0") {
  Ok(l) => match perform tcp_connect(TcpListener::address(&l), None) {
    Ok(c) => match perform tcp_accept(l, None) {
      TcpAccepted { listener, got } => match got {
        Ok(s) => match perform tcp_write(c, Bytes::of_list([1, 2, 3]), None) {
          TcpWritten { stream: c2, result } => {
            show(&result)
            match perform tcp_read(s, 16, None) {
              TcpRead { stream: s2, got: read } => {
                match read {
                  Ok(bs) => match perform tcp_write(s2, bs, None) {
                    TcpWritten { stream: s3, result: echo } => {
                      show(&echo)
                      perform tcp_close(s3)
                    }
                  }
                  Err(e) => {
                    show(&io_message(e))
                    perform tcp_close(s2)
                  }
                }
                match perform tcp_read(c2, 16, None) {
                  TcpRead { stream: c3, got: back } => {
                    show(&back)
                    perform tcp_close(c3)
                  }
                }
              }
            }
          }
        }
        Err(e) => show(&io_message(e))
      }
    }
    Err(e) => show(&io_message(e))
  }
  Err(e) => show(&io_message(e))
}
