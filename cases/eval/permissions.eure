// A program sees only the environment `env` gives it. `perform environ()`
// is the run's own, as far as `--allow-env` covers it, and is changed as a
// list: `EnvVars::set` puts a variable in over one of the same name, and
// `EnvVars::without` takes variables out.
@ cases.a-program-sees-only-the-environment-it-is-given
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `environ` yet"
files."main.nib" = ```nib
import std::builtin::os

pub fn home(env: List(Text × Text)): Text ! {proc_run} {
  let p := Process {
    program: "sh",
    args: ["-c", "printf \"${HOME-none}\""],
    dir: "",
    env: env,
    stdin: Bytes::of_text("")
  }
  match perform proc_run(p) {
    Ok(o) => match Text::of_bytes(o.stdout) {
      Some(t) => t
      None => "?"
    }
    Err(_) => "failed"
  }
}

show(&home([]))
show(&EnvVars::names(EnvVars::set(perform environ(), [#("HOME", "mine")])))
show(&home(EnvVars::set(perform environ(), [#("HOME", "mine")])))
show(&home(EnvVars::without(perform environ(), ["HOME"])))
```
permissions = ["--allow-run=sh", "--allow-env=HOME"]
stdout = ```
"none"
["HOME"]
"mine"
"none"
```

// `fs_lock` needs `--allow-write` for the file, makes it when there is none,
// and a lock let go of with `fs_unlock` can be taken again. A host without
// file locks answers `Failed`, the same each time.
@ cases.a-file-lock-is-taken-let-go-and-taken-again
