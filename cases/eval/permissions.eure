// A deadline that passes is `Err(TimedOut)`: an accept no one connects to,
// and a read from a peer that sends nothing.
@ cases.a-stream-request-past-its-deadline-times-out
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `tcp_listen` yet"
files."main.nib" = ```nib
import std::builtin::os

match perform tcp_listen("127.0.0.1:0") {
  Ok(l) => {
    let soon := perform monotonic_clock() + 30000000
    let at := TcpListener::address(&l)
    let stop := TcpListener::stopper(&l)
    match perform tcp_accept(l, Some(soon)) {
      TcpAccepted { listener, got } => show(&(match got {
        Ok(s) => {
          perform tcp_close(s)
          "accepted"
        }
        Err(TimedOut) => "Err(TimedOut)"
        Err(e) => io_message(e)
      }))
    }
    match perform tcp_connect(at, None) {
      Ok(c) => {
        let soon := perform monotonic_clock() + 30000000
        match perform tcp_read(c, 8, Some(soon)) {
          TcpRead { stream, got } => {
            show(&got)
            perform tcp_close(stream)
          }
        }
      }
      Err(e) => show(&io_message(e))
    }
    perform tcp_unlisten(stop)
  }
  Err(e) => show(&io_message(e))
}
