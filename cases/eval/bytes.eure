// `Bytes` builtins (`std/prelude/collections.taut`): read-only bytes whose slices
// share their storage. `std/bytes.taut` says what each does.

@ cases.bytes-of-a-list-keep-every-byte
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_list` yet"
source = ```nib

let b := Bytes::of_list(Cons(0, Cons(255, Cons(128, Nil))))
show(&b)
show(&Bytes::len(b))
show(&Bytes::to_list(b))
```
stdout = ```
Bytes[0, 255, 128]
3
[0, 255, 128]
```

@ cases.bytes-get-in-and-out-of-range
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```nib

let b := Bytes::of_text("ab")
show(&Bytes::get(b, 1))
show(&Bytes::get(b, 2))
```
stdout = ```
Some(98)
None
```

@ cases.bytes-slice-needs-start-before-end-within-the-length
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```nib

let b := Bytes::of_text("hello")
show(&Bytes::slice(b, 1, 3))
show(&Bytes::slice(b, 5, 5))
show(&Bytes::slice(b, 4, 6))
show(&Bytes::slice(b, 3, 1))
```
stdout = ```
Some(Bytes[101, 108])
Some(Bytes[])
None
None
```

@ cases.a-slice-of-a-slice-counts-from-its-own-start
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```nib

let b := Bytes::of_text("abcdef")
match Bytes::slice(b, 2, 6) {
  Some(s) => show(&Bytes::slice(s, 1, 2))
  None => #()
}
```
stdout = "Some(Bytes[100])\n"

@ cases.text-of-bytes-checks-utf-8
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```nib

let b := Bytes::of_text("é")
show(&Text::of_bytes(b))
match Bytes::slice(b, 0, 1) {
  Some(half) => show(&Text::of_bytes(half))
  None => #()
}
show(&Text::of_bytes(Bytes::of_list(Cons(255, Nil))))
```
stdout = ```
Some("é")
None
None
```

@ cases.bytes-concat-and-eq
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```nib

let a := Bytes::concat(Bytes::of_text("h"), Bytes::of_list(Cons(255, Nil)))
show(&a)
show(&Bytes::eq(a, Bytes::of_list(Cons(104, Cons(255, Nil)))))
show(&Bytes::eq(a, Bytes::of_text("h")))
```
stdout = ```
Bytes[104, 255]
true
false
```

@ cases.bytes-find-searches-from-start-before-end
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```nib

let b := Bytes::of_text("a:b:c")
show(&Bytes::find(b, 58, 0, 5))
show(&Bytes::find(b, 58, 2, 5))
show(&Bytes::find(b, 58, 2, 3))
show(&Bytes::find(b, 59, 0, 5))
show(&Bytes::find(b, 120, 0, 9))
show(&Bytes::find(b, 97, 5, 5))
```
stdout = ```
1
3
3
5
9
5
```
