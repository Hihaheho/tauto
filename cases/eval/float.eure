niri.unimplemented = "output: the value is too large"
llvm.unimplemented = "generate: the LLVM backend does not write arithmetic on a type that is not a number yet"
source = ```nib
show(&I64::of_float(Float::sqrt(-1.0)))
```
run_error = "the number is too large"

