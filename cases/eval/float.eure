description = "`Float` (IEEE 754 binary64): literals, arithmetic, comparisons, the digits `show` writes, the functions of `std/prelude/num.taut`, and conversions, with the same output on every backend (`docs/design/float.md`)."

// Literals with a point or an exponent; `+ - *` and unary `-` are IEEE 754's, and
// `==` says `0.0 == -0.0` and NaN is not equal to itself.
@ cases.float-arithmetic
llvm.unimplemented = "generate: the LLVM backend does not write a `Float` yet"
source = ```nib
struct Point { x: Float, y: Float }
fn norm(p: Point): Float { Float::sqrt(p.x * p.x + p.y * p.y) }
fn sum(xs: List(Float)): Float {
  match xs {
    Nil => 0.0
    Cons(x, rest) => x + sum(rest)
  }
}
show(&([1.5, 2e10, 6.02e23, 1.0e-3, 0.1]))
show(&(0.1 + 0.2))
show(&(1.0 - 3.5))
show(&(1.5 * -4.0))
show(&(1.0 / 3.0))
show(&(-(0.0)))
show(&(Point { x: 3.0, y: 4.0 }))
show(&norm(Point { x: 3.0, y: 4.0 }))
show(&sum([0.1, 0.2, 0.3]))
show(&(0.1 + 0.2 > 0.3))
show(&(0.0 == -0.0))
show(&(Float::sqrt(-1.0) == Float::sqrt(-1.0)))
show(&(1e300 * 1e10))
```
stdout = ```
[1.5, 20000000000, 602000000000000000000000, 0.001, 0.1]
0.30000000000000004
-2.5
-6
0.3333333333333333
-0
Point { x: 3, y: 4 }
5
0.6
true
true
false
inf
```

// The shortest digits that read back as the same `Float`, never with an
// exponent; of two as near, the larger (`tie`).
@ cases.float-shown-digits
llvm.unimplemented = "generate: the LLVM backend does not write a `Float` yet"
source = ```nib
show(&1.0)
show(&0.1)
show(&(1e21))
show(&(1e-7))
show(&Float::of_bits(1))
show(&Float::of_bits(9218868437227405311))
show(&-0.0)
show(&Float::sqrt(-1.0))
show(&(1e308 * 10.0))
show(&(-1e308 * 10.0))
show(&568843492673848.25)
show(&Text::of_float(2.0 / 3.0))
```
stdout = ```
1
0.1
1000000000000000000000
0.0000001
0.

-0
NaN
inf
-inf
568843492673848.3
"0.6666666666666666"
```

// The functions that are not exact in IEEE 754 are the runtime's own, so
// every backend prints these digits.
@ cases.float-functions
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Float::sqrt` yet"
source = ```nib
show(&Float::sqrt(2.0))
show(&Float::cbrt(-27.0))
show(&Float::exp(1.0))
show(&Float::ln(10.0))
show(&Float::log2(10.0))
show(&Float::log10(2.0))
show(&Float::pow(1.0001, 10000.0))
show(&Float::sin(1e22))
show(&Float::cos(0.5))
show(&Float::tan(1.5))
show(&Float::asin(0.3))
show(&Float::acos(-0.7))
show(&Float::atan(10.0))
show(&Float::atan2(-1.0, -1.0))
show(&Float::sinh(2.5))
show(&Float::cosh(-3.0))
show(&Float::tanh(0.4))
show(&Float::abs(-2.5))
show(&Float::floor(-2.5))
show(&Float::ceil(-2.5))
show(&Float::trunc(-2.5))
show(&([Float::round(-2.5), Float::round(2.5), Float::round(0.49999999999999994), Float::round(-0.3)]))
show(&([Float::is_nan(Float::ln(-1.0)), Float::is_nan(1.0)]))
```
stdout = ```
1.4142135623730951
-3
2.7182818284590455
2.302585092994046
3.321928094887362
0.3010299956639812
2.7181459268249255
-0.8522008497671888
0.8775825618903728
14.101419947171719
0.3046926540153975
2.34619382340565
1.4711276743037347
-2.356194490192345
6.0502044810397875
10.067661995777765
0.3799489622552249
2.5
-3
-2
-2
[-3, 3, 0, -0]
[true, false]
```

// `float_of_i64` rounds to the nearest; `i64_of_float` takes the integer part.
@ cases.float-conversions
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Float::of_i64` yet"
source = ```nib
show(&Float::of_i64(9007199254740993))
show(&([I64::of_float(-2.9), I64::of_float(2.9), I64::of_float(-9.223372036854775808e18)]))
show(&([Float::bits(1.0), Float::bits(-0.0)]))
show(&Float::of_bits(4614253070214989087))
show(&([Float::of_text("-2.5E-3"), Float::of_text("1e400"), Float::of_text(".5"), Float::of_text("inf"), Float::of_text("12")]))
```
stdout = ```
9007199254740992
[-2, 2, -9223372036854775808]
[4607182418800017408, 9223372036854775808]
3.14
[Some(-0.0025), Some(inf), None, None, Some(12)]
```

// `Float` through closures, recursion, `var` and `while`, a handler, a `Vec`
// and a product: a copy value like the integers. The product shows its members
// in its one order (labels, then the types by name), so `Float` before `Text`.
@ cases.float-in-programs
llvm.unimplemented = "generate: the LLVM backend does not write a `Float` yet"
source = ```nib

effect ask(): Float
fn scale(f: (Float) -> Float, xs: List(Float)): List(Float) {
  match xs { Nil => Nil, Cons(x, rest) => Cons(f(x), scale(f, rest)) }
}
fn mean(xs: List(Float), n: Float, acc: Float): Float ! {divzero} {
  match xs { Nil => acc / n, Cons(x, rest) => mean(rest, n, acc + x) }
}
fn total(n: i64): Float ! {div, overflow} {
  var s := 0.0
  var i := 0
  while i < n {
    s := s + Float::of_i64(i) * 0.5
    i := i + 1
  }
  s
}
let k := 2.5
show(&scale(x => x * k, [1.0, 2.0]))
show(&mean([1.0, 2.0, 4.0], 3.0, 0.0))
show(&total(10))
show(&(handle { perform ask() + 1.0 } with { ask(), k => k(41.0) }))
var v := Vec::new()
Vec::push(&mut v, 1.25)
Vec::push(&mut v, -3.5)
show(&Vec::into_list(v))
show(&(#(1.0, "a")))
show(&Some(Float::pow(2.0, -1074.0)))
```
stdout = ```
[2.5, 5]
2.3333333333333335
22.5
42
[1.25, -3.5]
#(1, "a")
Some(0.)
```

// `/` by zero, of either sign, is a run-time error rather than an infinity.
@ cases.float-division-by-zero
llvm.unimplemented = "generate: the LLVM backend does not write arithmetic on a type that is not a number yet"
source = ```nib
fn ratio(a: Float, b: Float): Float ! {divzero} { a / b }
show(&ratio(1.0, -0.0))
```
run_error = "division by zero"

