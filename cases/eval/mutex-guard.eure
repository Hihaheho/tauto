@ cases.a-guard-borrow-bound-by-let-writes-a-field-of-the-content
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
description = "A field of the content is written through a `&mut` of `MutexGuard::get_mut` inside a function, and read back through `MutexGuard::get`."
source = ```nib
import std::builtin::par

struct Counter { count: u64 }

fn bump(g: &mut MutexGuard(Counter)): Unit ! {overflow} {
  let c := MutexGuard::get_mut(g)
  c.count := c.count + 1
}

var g: MutexGuard(Counter) := Mutex::lock(perform mutex_new(Counter { count: 0 }))
bump(&mut g)
bump(&mut g)
let c := MutexGuard::get(&g)
show(&c.count)
```
stdout = "2\n"
