@ cases.unbounded-in-m
source = ```nib
effect choose: () -> Bool resume ω
fn count(n: i64) -> i64 {
  var i = 0
  while i < n {
    i := i + 1
  }
  i
}
let d = handle {
  let b = perform choose()
  budget(steps: 5) {
    count(if b { 30 } else { 20 })
  }
} with {
  choose(), k => k(true) + k(false)
  exceeded(info), k => k(info.unbounded())
}
perform show("d", d)
```
shows = ["d = 50"]
rust_shows = ["d = 50"]

@ cases.return-from-inside-a-budget-in-m
source = ```nib
effect choose: () -> Bool resume ω
fn pick() -> i64 {
  let r = handle {
    let b = perform choose()
    budget(steps: 100) {
      if b {
        return 9
      }
      1
    }
  } with {
    choose(), k => k(false) + k(true)
    exceeded(info), k => k(0)
  }
  r + 1000
}
perform show("p", pick())
```
shows = ["p = 9"]
rust_shows = ["p = 9"]

@ cases.nested-budgets-in-m
source = ```nib
effect choose: () -> Bool resume ω
fn spin() -> i64 {
  while true { }
  0
}
let d = handle {
  let b = perform choose()
  budget(steps: 1000) {
    budget(steps: 20) {
      if b {
        spin()
      } else {
        3
      }
    }
  }
} with {
  choose(), k => k(true) + k(false)
  exceeded(info), k => k(100)
}
perform show("d", d)
```
shows = ["d = 103"]
rust_shows = ["d = 103"]
