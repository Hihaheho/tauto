@ cases.unbounded-in-m
source = ```nib
effect choose(): Bool resume ω
fn count(n: i64): i64 {
  var i := 0
  while i < n {
    i := i + 1
  }
  i
}
let d := handle {
  let b := perform choose()
  budget(steps: 5) {
    count(if b { 30 } else { 20 })
  }
} with {
  choose(), k => k(true) + k(false)
  exceeded(info), k => k(info.unbounded())
}
perform show("d", d)
```
shows = ["d = 50"]
rust_shows = ["d = 50"]

@ cases.return-from-inside-a-budget-in-m
source = ```nib
effect choose(): Bool resume ω
fn pick(): i64 {
  let r := handle {
    let b := perform choose()
    budget(steps: 100) {
      if b {
        return 9
      }
      1
    }
  } with {
    choose(), k => k(false) + k(true)
    exceeded(info), k => k(0)
  }
  r + 1000
}
perform show("p", pick())
```
shows = ["p = 9"]
rust_shows = ["p = 9"]

@ cases.nested-budgets-in-m
source = ```nib
effect choose(): Bool resume ω
fn spin(): i64 {
  while true { }
  0
}
let d := handle {
  let b := perform choose()
  budget(steps: 1000) {
    budget(steps: 20) {
      if b {
        spin()
      } else {
        3
      }
    }
  }
} with {
  choose(), k => k(true) + k(false)
  exceeded(info), k => k(100)
}
perform show("d", d)
```
shows = ["d = 103"]
rust_shows = ["d = 103"]

// Cells are shared between resumptions (`semantics.md`「Cells across
// resumptions」): a write made in one resumption is seen by the next one,
// also for a `var` made inside the captured part of the body.
@ cases.resumptions-share-a-var-made-before-the-handle
source = ```nib
effect choose(): Bool resume ω
var n := 0
let r := handle {
  let b := perform choose()
  n := n + 1
  if b { n * 10 } else { n }
} with {
  choose(), k => k(true) + k(false)
}
perform show("r", r)
perform show("n", n)
```
shows = ["r = 12", "n = 2"]
rust_shows = ["r = 12", "n = 2"]
javascript_shows = ["r = 12", "n = 2"]

