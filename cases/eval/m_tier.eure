@ cases.a-while-that-resumes-twice-keeps-its-vars
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
description = "each round and the code after the loop see the vars the last round left"
source = ```nib
effect ask(): i64 resume ω
let d := handle {
  var i := 0
  var s := 0
  while i < 2 {
    s := s + perform ask()
    i := i + 1
  }
  s * 10 + i
} with {
  ask(), k => k(1) + k(2)
}
show(&d)
```
stdout = "128\n"

@ cases.an-if-that-resumes-twice-keeps-its-vars
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
description = "the code after an `if` sees the var its branch assigned"
source = ```nib
effect ask(): i64 resume ω
let d := handle {
  var s := 1
  if s > 0 {
    s := perform ask()
  } else {
    s := 3
  }
  s + 10
} with {
  ask(), k => k(2) + k(5)
}
show(&d)
```
stdout = "27\n"

@ cases.a-match-that-resumes-twice-keeps-its-vars
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
