// The M tier: a `return` inside a handle that may resume more than once, and
// a `budget` inside one.

@ cases.return-from-a-handle-that-resumes-twice
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect choose(): Bool resume ω
fn pick(): i64 ! {overflow} {
  let r := handle {
    let b := perform choose()
    if b {
      return 100
    }
    1
  } with {
    choose(), k => k(true) + k(false)
  }
  r + 1000
}
show(&pick())
```
stdout = "100\n"

@ cases.the-second-resume-returns
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
import std::builtin::os
effect choose(): Bool resume ω
fn pick(): i64 ! {overflow, stdout, stdout_flush} {
  let r := handle {
    let b := perform choose()
    if b {
      2
    } else {
      return 7
    }
  } with {
    choose(), k => {
      let a := k(true)
      show(&a)
      a + k(false)
    }
  }
  r + 1000
}
show(&pick())
```
stdout = ```
2
7
```

@ cases.no-return-taken
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect choose(): Bool resume ω
fn pick(n: i64): i64 ! {overflow} {
  let r := handle {
    let b := perform choose()
    if n > 5 {
      return 0 - 1
    }
    if b { 10 } else { 20 }
  } with {
    choose(), k => k(true) + k(false)
  }
  r + 1000
}
show(&pick(1))
show(&pick(9))
```
stdout = ```
1030
-1
```

@ cases.return-from-a-while-in-the-body
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect pick(): i64 resume ω
fn first_big(): i64 ! {div, overflow} {
  let r := handle {
    var i := 0
    while i < 5 {
      let x := perform pick()
      if x + i > 3 {
        return x + i
      }
      i := i + 1
    }
    0
  } with {
    pick(), k => k(1) + k(2)
  }
  r
}
show(&first_big())
```
stdout = "4\n"

@ cases.return-in-a-function-that-suspends
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect choose(): Bool resume ω
effect ask(): i64
fn pick(): i64 ! {ask, overflow} {
  let r := handle {
    let b := perform choose()
    if b {
      return perform ask() + 1
    }
    1
  } with {
    choose(), k => k(true) + k(false)
  }
  r + 1000
}
let v := handle { pick() } with {
  ask(), k => k(41)
}
show(&v)
```
stdout = "42\n"

@ cases.return-in-a-function-that-aborts
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```nib
effect choose(): Bool resume ω
effect fail(): Never resume 0
fn pick(): i64 ! {fail, overflow} {
  let r := handle {
    let b := perform choose()
    if b {
      return 5
    }
    if perform choose() {
      perform fail()
    } else {
      3
    }
  } with {
    choose(), k => k(true) + k(false)
  }
  r + 1000
}
let v := handle { pick() } with {
  fail() => 0 - 1
}
show(&v)
```
stdout = "5\n"

@ cases.a-budget-in-a-handle-that-resumes-twice
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect choose(): Bool resume ω
fn spin(): i64 ! {div} {
  while true { }
  0
}
let d := handle {
  let b := perform choose()
  perform budget(50, () => {
    if b {
      spin()
    } else {
      5
    }
  })
} with {
  choose(), k => k(true) + k(false)
  exceeded(info), k => k(0 - 1)
}
show(&d)
```
stdout = "4\n"

@ cases.more-steps-resume-the-body-in-m
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect choose(): Bool resume ω
fn count(n: i64): i64 ! {div, overflow} {
  var i := 0
  while i < n {
    i := i + 1
  }
  i
}
let d := handle {
  let b := perform choose()
  perform budget(50, () => {
    if b {
      count(100)
    } else {
      count(10)
    }
  })
} with {
  choose(), k => k(true) + k(false)
  exceeded(info), k => k(info.more(200))
}
show(&d)
```
stdout = "110\n"

