// A continuation copies the `var`s of the captured part of the body
// (`semantics.md`「Variables across resumptions」): each resumption starts
// from the value `n` had at the `perform`.
@ cases.each-resumption-copies-a-var-made-in-the-body
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect choose(): Bool resume ω
let r := handle {
  var n := 0
  let b := perform choose()
  n := n + 1
  if b { n * 10 } else { n }
} with {
  choose(), k => k(true) + k(false)
}
show(&r)
```
stdout = "11\n"


// A loop in the body of a budget, before a handle whose body runs out of its
// own budget, all in the arm of an outer one: the round of the loop captures
// the names in scope, and the budget's target is not one of them, since it is
// moved into the frame where the budget starts.
@ cases.a-loop-in-a-budget-in-an-exceeded-arm
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
fn spin(): i64 ! {div} {
  while true { }
  0
}
fn count(n: i64): i64 ! {div, overflow} {
  var i := 0
  var s := 0
  while i < n {
    i := i + 1
    s := s + i
  }
  s
}
show(&(handle { perform budget(3, () => { spin() }) } with {
  exceeded(info), k => k(handle { perform budget(2, () => { count(30) + (handle { perform budget(155, () => { spin() }) } with {
    exceeded(info), k => k(5)
  }) }) } with {
    exceeded(info), k => info.unbounded()
  })
}))
```
stdout = "470\n"
