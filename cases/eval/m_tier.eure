// A loop in the body of a budget, before a handle whose body runs out of its
// own budget, all in the arm of an outer one: the round of the loop captures
// the names in scope, and the budget's target is not one of them, since it is
// moved into the frame where the budget starts.
@ cases.a-loop-in-a-budget-in-an-exceeded-arm
source = ```nib
fn spin(): i64 {
  while true { }
  0
}
fn count(n: i64): i64 {
  var i := 0
  var s := 0
  while i < n {
    i := i + 1
    s := s + i
  }
  s
}
perform show("d", handle { budget(steps: 3) { spin() } } with {
  exceeded(info), k => k(handle { budget(steps: 2) { count(30) + (handle { budget(steps: 155) { spin() } } with {
    exceeded(info), k => k(5)
  }) } } with {
    exceeded(info), k => info.unbounded()
  })
})
```
shows = ["d = 470"]
rust_shows = ["d = 470"]
@ cases.a-nested-budget-runs-out-inside-an-outer-one
source = ```nib
fn spin(): i64 {
  while true {
  }
  0
}
fn f1(): i64 {
  handle {
    budget(steps: 100) {
      spin()
    }
  } with {
    exceeded(info), k => k(1)
  }
}
perform show("v", handle {
  budget(steps: 1000000) {
    f1()
  }
} with {
  exceeded(info), k => k(0)
})
```
shows = ["v = 1"]

