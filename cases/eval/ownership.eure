3
"hello big world"
"ab"
```

@ cases.higher-order-functions-take-closures-by-borrow
source = ```nib

var seen := 0
let xs := Cons(1, Cons(2, Cons(3, Nil)))
each(xs, (x) => {
  seen := seen + x
})
let ys := map(Cons(1, Cons(2, Nil)), (x) => x * 10)
show(&seen)
show(&ys)
```
stdout = ```
6
[10, 20]
```

@ cases.a-vec-of-affine-values
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```nib

struct(affine) Job { id: i64 }
var jobs := Vec::new()
Vec::push(&mut jobs, Job { id: 1 })
Vec::push(&mut jobs, Job { id: 2 })
var sum := 0
Vec::each(&jobs, (j) => {
  sum := sum + j.id
})
Vec::consume(jobs, (j) => {
  match j {
    Job { id } => show(&id)
  }
})
show(&sum)
```
stdout = ```
1
2
3
```

