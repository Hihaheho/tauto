// Running structs, enums, borrows and the affine standard library.
// Every `shows` case also runs with the dynamic ownership check, which must
// agree.

@ cases.structs-and-enums
source = ```nib
struct P { x: i64, y: i64 }
enum Shape { Circle(i64), Rect { w: i64, h: i64 }, Empty }
fn area(s: Shape): i64 ! {overflow} {
  match s {
    Circle(r) => 3 * r * r
    Rect { w, h } => w * h
    Empty => 0
  }
}
let p := P { x: 1, y: 2 }
show(&p)
show(&p.x)
show(&(area(Circle(2)) + area(Rect { w: 2, h: 5 }) + area(Empty)))
```
stdout = ```
P { x: 1, y: 2 }
1
22
```

@ cases.vec-and-borrows
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```nib

fn total(v: &Vec(i64)): i64 ! {div, overflow} {
  var s := 0
  var i: u64 := 0
  while i < Vec::len(&v) {
    let n := handle { Vec::index(&v, i) } with {
      out_of_bounds() => 0
    }
    s := s + n
    i := i + 1
  }
  s
}
var v := Vec::new()
Vec::push(&mut v, 1)
Vec::push(&mut v, 2)
Vec::push(&mut v, 3)
show(&Vec::len(&v))
show(&total(&v))
show(&Vec::pop(&mut v))
show(&v)
```
stdout = ```
3
6
Some(3)
Vec[1, 2]
```

@ cases.a-mutable-borrow-writes-the-owner
source = ```nib
struct Counter { n: i64 }
fn bump(c: &mut Counter): Unit ! {overflow} {
  *c := Counter { n: c.n + 1 }
}
var c := Counter { n: 0 }
bump(&mut c)
bump(&mut c)
show(&c.n)
```
stdout = "2\n"

@ cases.a-field-is-assigned-through-a-mutable-borrow
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```nib

struct In { k: i64 }
struct Wl { n: u64, items: Vec(i64), inner: In }
fn bump(wl: &mut Wl): Unit ! {overflow} {
  wl.n := wl.n + 1
  wl.inner.k := 7
  var v := Vec::new()
  Vec::push(&mut v, 3)
  wl.items := v
}
var w := Wl { n: 1, items: Vec::new(), inner: In { k: 0 } }
bump(&mut w)
var i: u64 := 0
while i < 3 {
  w.n := w.n + i
  i := i + 1
}
show(&w)
```
stdout = "Wl { n: 5, items: Vec[3], inner: In { k: 7 } }\n"

@ cases.a-field-of-a-var-is-a-place
source = ```nib

struct Two { a: Vec(i64), b: Vec(i64) }
fn put(x: &mut Vec(i64), y: &mut Vec(i64)): Unit {
  Vec::push(&mut x, 1)
  Vec::push(&mut y, 2)
  Vec::push(&mut y, 3)
}
var t := Two { a: Vec::new(), b: Vec::new() }
put(&mut t.a, &mut t.b)
show(&Vec::len(&t.a))
show(&Vec::len(&t.b))
```
stdout = ```
1
2
```

@ cases.replace-and-clone
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Buf::of` yet"
source = ```nib

enum(affine) Expr { Lit(Buf), Add(Expr, Expr) }
fn size(e: &Expr): i64 ! {overflow} {
  match e {
    Lit(b) => 1
    Add(l, r) => size(l) + size(r)
  }
}
var e := Add(Lit(Buf::of("a")), Lit(Buf::of("b")))
let r#copy := clone(&e)
let old := replace(&mut e, Lit(Buf::of("c")))
show(&size(&old))
show(&size(&r#copy))
show(&size(&e))
```
stdout = ```
2
2
1
```

@ cases.buffers-and-text
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Buf::of` yet"
source = ```nib

let b := Buf::of("hello big world")
let n := fold(words(Text::of(Buf::clone(&b))), 0, (acc, w) => acc + 1)
show(&n)
show(&Text::of(b))
show(&concat("a", "b"))
```
