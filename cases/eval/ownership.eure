@ cases.a-resume-zero-arm-ends-the-handle
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```nib
effect fail(msg: Text): Never resume 0
fn safe_div(a: i64, b: i64): i64 ! {fail, divzero} {
  if b == 0 { perform fail("zero") } else { div(a, b) }
}
let r := handle { safe_div(1, 0) } with {
  fail(m) => 0 - 1
}
show(&r)
```
stdout = "-1\n"

@ cases.a-linear-value-is-consumed-once
llvm.unimplemented = "generate: the LLVM backend does not write a `linear` type yet"
source = ```nib
struct(linear) Handshake { id: i64 }
fn hello(id: i64): Handshake { Handshake { id: id } }
fn finish(h: Handshake): i64 {
  match h {
    Handshake { id } => id
  }
}
let h := hello(7)
show(&finish(h))
```
stdout = "7\n"

@ cases.ref-mutex-and-atomic-are-shared-cells
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::par

let r := perform ref_new(1)
let bump := () => perform ref_set(r, perform ref_get(r) + 1)
bump()
bump()
let m := perform mutex_new(Vec::new())
{
  var g := Mutex::lock(m)
  let v := MutexGuard::get_mut(&mut g)
  Vec::push(&mut v, 7)
}
{
  var g := Mutex::lock(m)
  let v := MutexGuard::get_mut(&mut g)
  Vec::push(&mut v, 8)
}
let n := {
  let g := Mutex::lock(m)
  let v := MutexGuard::get(&g)
  Vec::len(&v)
}
let a := perform atomic_new(10)
let old := perform atomic_fetch_add(a, 5)
show(&perform ref_get(r))
show(&n)
show(&(old + perform atomic_load(a)))
```
stdout = ```
3
2
25
```

@ cases.a-slot-assigned-a-call-on-itself-keeps-the-value
llvm.unimplemented = "generate: the LLVM backend does not write internal: a value of one type where a value of another is read yet"
source = ```nib

fn same(x: u32, keep: Bool): u32 { if keep { x } else { 7 } }
fn bump(v: &mut Vec(u32)): Unit {
  match Vec::get_mut(&mut v, 0) {
    Some(slot) => {
      *slot := same(slot, true)
    }
    None => #()
  }
}
var v := Vec::new()
Vec::push(&mut v, 5)
bump(&mut v)
show(&Vec::get(&v, 0))
```
stdout = "Some(5)\n"

@ cases.a-slot-assigned-data-built-from-itself-keeps-the-value
llvm.unimplemented = "generate: the LLVM backend does not write internal: a value of one type where a value of another is read yet"
source = ```nib

fn push(v: &mut Vec(List(u64)), p: u64): Unit {
  match Vec::get_mut(&mut v, 0) {
    Some(slot) => {
      *slot := Cons(p, slot)
    }
    None => #()
  }
}
var v: Vec(List(u64)) := Vec::new()
Vec::push(&mut v, Nil)
push(&mut v, 1)
push(&mut v, 2)
show(&Vec::get(&v, 0))
```
stdout = "Some([2, 1])\n"

@ cases.a-guard-that-moves-a-bound-name-leaves-the-value-to-the-next-arm
source = ```nib
struct(affine) Token { n: i64 }
fn take(t: Token): Bool {
  match t {
    Token { n } => n > 100
  }
}
fn pick(o: Option(Token)): i64 {
  match o {
    Some(t) if take(t) => 1
    Some(u) => match u {
      Token { n } => n
    }
    None => 0
  }
}
show(&pick(Some(Token { n: 7 })))
```
stdout = ```
7
```
