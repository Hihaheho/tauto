@ cases.hash-maps
source = ```nib
import std::indexed_map { IndexedMap }

var m: IndexedMap(Text, i64) := IndexedMap::new()
let old := IndexedMap::insert(&mut m, "a", 1)
let again := IndexedMap::insert(&mut m, "a", 2)
let one := match IndexedMap::get(&m, "a") { Some(v) => v, None => 0 }
let none := match IndexedMap::get(&m, "z") { Some(v) => v, None => 0 - 1 }
show(&old)
show(&again)
show(&one)
show(&none)
```
stdout = ```
#(None, None)
#(Some(#("a", 1)), None)
2
-1
```

@ cases.persistent-maps
source = ```nib

let m := Map::insert(Map::insert(Map::empty(), "a", 1), "b", 2)
let m2 := Map::insert(m, "a", 3)
show(&Map::get(m, "a"))
show(&Map::get(m2, "a"))
show(&Map::get(m2, "c"))
```
