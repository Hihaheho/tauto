// `[a, b, c]` is `Cons(a, Cons(b, Cons(c, Nil)))` and `[]` is `Nil`: the
// reader writes the constructors, so every backend and the kernel see the
// terms written out.

@ cases.a-list-literal-is-its-constructors
source = ```nib
fn len<A>(xs: List(A)): i64 {
  match xs {
    Nil => 0
    Cons(x, rest) => 1 + len(rest)
  }
}
let t := [["aaa", "bbb"], [], [
  "c",
  "d"
]]
perform show("len", len(t))
perform show("t", t)
```
shows = [
  "len = 3",
  "t = Cons(Cons(\"aaa\", Cons(\"bbb\", Nil)), Cons(Nil, Cons(Cons(\"c\", Cons(\"d\", Nil)), Nil)))",
]

// Arms that take a list two elements at a time cover it with no `_`: the
// fields of `Cons` are covered together, so `Cons(x, Cons(y, r))` and
// `Cons(x, Nil)` between them take every non-empty list.
@ cases.nested-arms-cover-a-list-without-a-wildcard
source = ```nib
fn pairs(xs: List(i64)): List(i64) {
  match xs {
    Cons(a, Cons(b, rest)) => Cons(a + b, pairs(rest))
    Cons(a, Nil) => Cons(a, Nil)
    Nil => Nil
  }
}
perform show("p", pairs([1, 2, 3, 4, 5]))
```
shows = [
  "p = Cons(3, Cons(7, Cons(5, Nil)))",
]
