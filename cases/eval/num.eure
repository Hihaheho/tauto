// Explicit changes of an integer's width (`std/prelude/num.taut`).

@ cases.num-widen
source = ```nib
show(&U64::of_u8(255))
show(&I64::of_i32(7))
show(&U64::of_u32(7))
```
stdout = ```
255
7
7
```

@ cases.num-narrow-fails
niri.unimplemented = "output: does not fit"
source = ```nib
show(&U8::of_u64(256))
```
run_error = "the number is too large"

@ cases.num-narrow-fits
source = ```nib
show(&U8::of_u64(255))
show(&U32::of_u64(4294967295))
show(&I32::of_i64(0 - 2147483648))
```
stdout = ```
255
4294967295
-2147483648
```

@ cases.num-i32-of-i64-fails
niri.unimplemented = "output: does not fit"
source = ```nib
show(&I32::of_i64(2147483648))
```
run_error = "the number is too large"

@ cases.num-i64-of-u64
source = ```nib
show(&I64::of_u64(5))
```
stdout = "5\n"

@ cases.num-u64-of-i64-negative-fails
niri.unimplemented = "output: does not fit"
source = ```nib
show(&U64::of_i64(0 - 1))
```
run_error = "the number is too large"

@ cases.num-i64-min-div-minus-one-fails
niri.unimplemented = "output: does not fit"
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `divzero` yet"
source = ```nib
show(&div((0 - 9223372036854775807 - 1), (0 - 1)))
```
run_error = "the number is too large"

@ cases.num-u64-past-i64-max
source = ```nib
let b: u64 := 9223372036854775807
let m: u64 := 18446744073709551615
show(&(b + 1))
show(&(b * 2 + 1))
show(&(m - 1))
show(&div(m, 2))
show(&(m > b))
show(&(m == m))
```
stdout = ```
9223372036854775808
18446744073709551615
18446744073709551614
9223372036854775807
true
true
```

@ cases.num-u64-max-plus-one-fails
source = ```nib
let m: u64 := 18446744073709551615
show(&(m + 1))
```
run_error = "the number is too large"

@ cases.num-u64-below-zero-fails
source = ```nib
let z: u64 := 0
show(&(z - 1))
```
run_error = "the number is too large"

@ cases.num-atomic-fetch-add-wraps-at-u64
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Atomic::new` yet"
source = ```nib
import std::builtin::par

let a := perform atomic_new(18446744073709551615)
show(&perform atomic_fetch_add(a, 0))
show(&perform atomic_fetch_add(a, 1))
show(&perform atomic_load(a))
show(&perform atomic_fetch_add(a, 18446744073709551615))
show(&perform atomic_load(a))
```
stdout = ```
18446744073709551615
18446744073709551615
0
0
18446744073709551615
```

// `U64::of_text` reads the decimal digits `Text::of_u64` writes, up to
// `2^64 - 1`; anything else is `None` (`std/prelude/collections.taut`).
@ cases.u64-of-text
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```nib
show(&([U64::of_text("0"), U64::of_text("42"), U64::of_text("007"), U64::of_text("18446744073709551615")]))
show(&([U64::of_text(""), U64::of_text("-1"), U64::of_text("1a"), U64::of_text(" 1"), U64::of_text("18446744073709551616"), U64::of_text("99999999999999999999")]))
show(&U64::of_text(Text::of_u64(1234567890)))
```
stdout = ```
[Some(0), Some(42), Some(7), Some(18446744073709551615)]
[None, None, None, None, None, None]
Some(1234567890)
```
