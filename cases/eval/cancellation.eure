@ cases.a-user-type-can-have-the-source-capability-spelling
source = ```nib
import std::prelude::Par

struct CancelSource { value: u64 }
let own := CancelSource { value: 7 }
let cancellation := Cancellation::new()
Cancellation::request(cancellation)
perform show("own", own.value)
perform show("requested", CancelToken::is_requested(Cancellation::token(cancellation)))
```
shows = ["own = 7", "requested = true"]
backends = ["rust", "javascript", "vm"]

@ cases.requests-do-not-propagate-between-sources
source = ```nib
import std::prelude::Par

let first := Cancellation::new()
let second := Cancellation::new()
let a := Cancellation::token(first)
let b := Cancellation::token(second)
let choice := Signal::either(CancelToken::signal(a), CancelToken::signal(b))
Cancellation::request(first)
perform wait(choice)
perform show("first", CancelToken::is_requested(a))
perform show("second", CancelToken::is_requested(b))
perform show("choice", Signal::is_raised(choice))
```
shows = ["first = true", "second = false", "choice = true"]
backends = ["rust", "javascript", "vm"]

@ cases.request-before-spawn-still-runs-the-task-and-its-cleanup
source = ```nib
import std::prelude::Par
import std::prelude::Std

linear struct Ticket {}
fn work(cancel: CancelToken, cleaned: Atomic): Result(u64, Cancelled) ! {wait} {
  let ticket := Ticket {}
  perform wait(CancelToken::signal(cancel))
  match ticket { Ticket {} => Atomic::store(cleaned, 1) }
  Err(Cancelled)
}

let cancellation := Cancellation::new()
let cleaned := Atomic::new(0)
Cancellation::request(cancellation)
let token := Cancellation::token(cancellation)
let task := perform spawn(() => work(token, cleaned))
let outcome := Task::join(task)
let cancelled := match outcome {
  Ok(value) => false
  Err(reason) => true
}
perform show("cancelled", cancelled)
perform show("cleaned", Atomic::load(cleaned))
```
shows = ["cancelled = true", "cleaned = 1"]
backends = ["rust", "javascript", "vm"]

// A request to end the run from outside (Ctrl-C, SIGTERM) raises the token of
// `shutdown_token`; until one comes it is not requested, and a fresh token
// stands apart from the earlier one and from the program's own cancellations.
@ cases.shutdown-token-is-not-requested-without-a-request-from-outside
source = ```nib
import std::prelude::Par
import std::prelude::Os

let token := perform shutdown_token()
let again := perform shutdown_token()
let own := Cancellation::new()
Cancellation::request(own)
perform show("token", CancelToken::is_requested(token))
perform show("again", CancelToken::is_requested(again))
let either := Signal::either(CancelToken::signal(token), CancelToken::signal(Cancellation::token(own)))
perform wait(either)
perform show("either", Signal::is_raised(either))
```
shows = ["token = false", "again = false", "either = true"]
backends = ["rust", "javascript", "vm"]
