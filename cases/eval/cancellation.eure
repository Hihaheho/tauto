true
true
```

@ cases.either-observes-both-inputs-and-nested-choices
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::par

let left := Cancellation::new()
let right := Cancellation::new()
let a := CancelToken::signal(Cancellation::token(left))
let b := CancelToken::signal(Cancellation::token(right))
let choice := Signal::either(a, b)
let nested := Signal::either(choice, choice)
show(&Signal::is_raised(nested))
Cancellation::request(right)
perform wait(nested)
show(&Signal::is_raised(choice))
show(&Signal::is_raised(a))
show(&Signal::is_raised(Signal::either(b, b)))
```
stdout = ```
false
true
false
true
```

