@ cases.request-is-visible-to-existing-and-later-tokens
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::par

let source := Cancellation::new()
let token := Cancellation::token(source)
show(&CancelToken::is_requested(token))
Cancellation::request(source)
Cancellation::request(source)
show(&CancelToken::is_requested(token))
show(&CancelToken::is_requested(Cancellation::token(source)))
perform wait(CancelToken::signal(token))
```
