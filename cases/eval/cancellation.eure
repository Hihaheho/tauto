@ cases.request-is-visible-to-existing-and-later-tokens
source = ```nib
import std::prelude::Par

let source := Cancellation::new()
let token := Cancellation::token(source)
perform show("before", CancelToken::is_requested(token))
Cancellation::request(source)
Cancellation::request(source)
perform show("after", CancelToken::is_requested(token))
perform show("later", CancelToken::is_requested(Cancellation::token(source)))
perform wait(CancelToken::signal(token))
```
shows = ["before = false", "after = true", "later = true"]
backends = ["rust", "javascript", "vm"]

@ cases.either-observes-both-inputs-and-nested-choices
source = ```nib
import std::prelude::Par

let left := Cancellation::new()
let right := Cancellation::new()
let a := CancelToken::signal(Cancellation::token(left))
let b := CancelToken::signal(Cancellation::token(right))
let choice := Signal::either(a, b)
let nested := Signal::either(choice, choice)
perform show("before", Signal::is_raised(nested))
Cancellation::request(right)
perform wait(nested)
perform show("right", Signal::is_raised(choice))
perform show("left", Signal::is_raised(a))
perform show("duplicate", Signal::is_raised(Signal::either(b, b)))
```
shows = ["before = false", "right = true", "left = false", "duplicate = true"]
backends = ["rust", "javascript", "vm"]

