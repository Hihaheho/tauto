// `stdout`: what the program shows with `show(&v)`, one value a line, as
// `Debug` writes it.

@ cases.arithmetic
source = ```nib
let a := 1 + 2 * 3
let f := (x, y) => x * y
show(&a)
show(&f(a, 2))
```
stdout = ```
7
14
```

@ cases.a-loop
source = ```nib
fn sum(n: i64): i64 ! {div, overflow} {
  var i := 0
  var s := 0
  while i < n {
    i := i + 1
    s := s + i
  }
  s
}
show(&sum(100))
```
stdout = "5050\n"

