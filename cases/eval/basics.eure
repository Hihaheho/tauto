@ cases.a-handle-directly-in-a-handle-body-keeps-its-own-arms
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
description = "the inner handle's arms and return arm belong to it alone; the outer handle gets only its own"
source = ```nib
effect emit(x: i64): Unit resume ω
effect fetch(i: i64): i64 resume ω
let c := handle {
  handle { perform emit(1) } with {
    emit(x), k => 100
    return v => 7
  }
} with {
  fetch(i), k => k(i)
  return v => v
}
let d := handle {
  handle { perform fetch(5) + 1 } with {
    emit(x), k => k(#())
    return v => v * 2
  }
} with {
  fetch(i), k => k(i * 10)
  return v => v + 1000
}
show(&c)
show(&d)
```
stdout = ```
100
1102
```

@ cases.show-is-ordered-with-the-handled-computation
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect ask(): i64 resume ω
let c := handle {
  show(&1)
  let v := perform ask()
  show(&v)
  v
} with {
  ask(), k => k(2) + k(3)
}
show(&c)
```
stdout = ```
1
2
3
5
```

