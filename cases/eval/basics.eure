@ cases.a-channel-hands-values-over-in-order
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::par

let ch := Channel::new(3)
let r := {
  let t := perform spawn(() => {
    Channel::send(ch, 1)
    Channel::send(ch, 2)
    Channel::send(ch, 3)
  })
  Task::join(t)
  let a := Channel::recv(ch)
  let b := Channel::recv(ch)
  Channel::send(ch, 4)
  Channel::close(ch)
  let c := Channel::recv(ch)
  let d := Channel::recv(ch)
  let e := Channel::recv(ch)
  let f := Channel::recv(ch)
  [a, b, c, d, e, f]
}
show(&r)
```
stdout = "[Some(1), Some(2), Some(3), Some(4), None, None]\n"

