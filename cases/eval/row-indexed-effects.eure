@ cases.a-lambda-field-of-a-record-takes-the-row-the-fields-type-writes
source = ```nib
effect ui<!e>(): Unit
effect out(t: Text): Unit
struct Boundary(!e) { failed: (why: Text) -> Unit ! {ui(e)} ∪ e }
fn error_boundary<!e>(b: Boundary(e)): Unit ! {ui(e)} ∪ e { (b.failed)("x") }
fn ui_label<!e>(key: Text): Unit ! {ui(e)} { perform ui() }
fn go(): Unit ! {ui(!{})} {
  error_boundary(Boundary { failed: (key: Text) => ui_label(key) })
}
```
types = "ok"
rows = "ok"

@ cases.a-lambda-bound-by-an-annotated-let-takes-the-row-the-annotation-writes
