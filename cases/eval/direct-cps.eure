source = ```taut
import std::Int
theorem declaration_literal(): e_value(CvDeclaration(7)) = MvDeclaration(7) { Refl }
fn empty(): MCx { Mcx(MtLeaf, 0, None, IntOfNat(0), IntOfNat(0), Nil, None, Nil, false) }
theorem arithmetic(): e_eval(8, Nil, Nil,
  MkCPrim(CprArith(2, 1), [CPure(CvInt(IntOfNat(6))), CPure(CvInt(IntOfNat(7)))]), empty()) =
  ErValue(MvInt(IntOfNat(42)), empty()) { Refl }
theorem selected_branch(): e_eval(3, Nil, Nil,
  CBranch(CPure(CvBool(false)), CCall(CPure(CvFn(0)), Nil, false), CPure(CvText("else"))), empty()) =
  ErValue(MvText("else"), empty()) { Refl }
theorem sequence_value(): e_eval(6, Nil, Nil,
  CSeq([CPure(CvInt(IntOfNat(1))), CPure(CvInt(IntOfNat(2)))]), empty()) =
  ErValue(MvInt(IntOfNat(2)), empty()) { Refl }
theorem source_local(): e_eval(1, Nil,
  [Pair { fst: 42, snd: EbValue(MvText("bound")) }], CRead(42, false), empty()) =
  ErValue(MvText("bound"), empty()) { Refl }
theorem exhausted(): e_eval(0, Nil, Nil, CPure(CvUnit), empty()) = ErFuel { Refl }
theorem unbound(): e_eval(1, Nil, Nil, CRead(4, false), empty()) =
  ErError("internal: an unbound local") { Refl }
theorem wrong_arity(): e_eval(8, Nil, Nil,
  MkCPrim(CprArith(0, 1), [CPure(CvInt(IntOfNat(1)))]), empty()) =
  ErError("internal: a primitive has the wrong arity") { Refl }
theorem division_by_zero(): e_eval(8, Nil, Nil,
  MkCPrim(CprDivide(false, 1), [CPure(CvInt(IntOfNat(7))), CPure(CvInt(IntOfNat(0)))]), empty()) =
  ErError(m_division_by_zero()) { Refl }
theorem first_error(): e_eval(8, Nil, Nil,
  MkCPrim(CprArith(0, 1), [CRead(4, false), CCall(CPure(CvFn(0)), Nil, false)]), empty()) =
  ErError("internal: an unbound local") { Refl }
theorem unsupported(): e_eval(1, Nil, Nil, CPerform("show", 0, Nil), empty()) =
  ErUnsupported("perform") { Refl }
fn observed(r: EResult(MVal)): List(MVal) {
  match r {
    ErValue(v, cx) => [v, cx_cell(cx, 0), cx_cell(cx, 1), MvInt(IntOfNat(cx_next(cx)))]
    ErError(message) => Nil
    ErFuel => Nil
    ErUnsupported(construct) => Nil
  }
}
theorem left_to_right(): observed(e_eval(8, Nil, Nil,
  MkCPrim(CprProduct([Pair { fst: 0, snd: None }, Pair { fst: 1, snd: None }]),
    [CMap(CPure(CvInt(IntOfNat(11))), CuTempRef), CMap(CPure(CvInt(IntOfNat(22))), CuTempRef)]), empty())) =
  [MvProduct([MvRef(0, MrPath(Nil)), MvRef(1, MrPath(Nil))]),
   MvInt(IntOfNat(11)), MvInt(IntOfNat(22)), MvInt(IntOfNat(2))] { Refl }
theorem cell_read(): e_eval(1, Nil, [Pair { fst: 17, snd: EbCell(0) }], CRead(17, false),
  cx_put(empty(), 0, MoCell(MvText("cell")))) =
  ErValue(MvText("cell"), cx_put(empty(), 0, MoCell(MvText("cell")))) { Refl }
```
