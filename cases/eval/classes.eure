@ cases.hkt-partial-application
source = ```nib
class Functor<F: (shared) -> shared> {
  fn map<A: shared, B: shared>(x: F(A), f: (A) -> B) -> F(B)
}
instance Functor(List) {
  fn map<A: shared, B: shared>(x: List(A), f: (A) -> B) -> List(B) {
    match x {
      Nil => Nil
      Cons(h, t) => Cons(f(h), Functor.map(t, f))
    }
  }
}
instance Functor(Option) {
  fn map<A: shared, B: shared>(x: Option(A), f: (A) -> B) -> Option(B) {
    match x {
      None => None
      Some(v) => Some(f(v))
    }
  }
}
instance<E: shared> Functor(Result(E)) {
  fn map<A: shared, B: shared>(x: Result(E, A), f: (A) -> B) -> Result(E, B) {
    match x {
      Ok(v) => Ok(v)
      Err(e) => Err(f(e))
    }
  }
}
fn double_all<F: (shared) -> shared>(x: F(i64)) -> F(i64) where Functor(F) {
  Functor.map(x, (n: i64) => n * 2)
}
fn twice<F: (shared) -> shared>(x: F(i64)) -> F(i64) where Functor(F) {
  double_all(double_all(x))
}
let r: Result(Text, i64) = Err(5)
perform show("a", Functor.map(r, (n: i64) => n + 1))
let ok: Result(Text, i64) = Ok("x")
perform show("b", Functor.map(ok, (n: i64) => n + 1))
```
shows = ["a = Err(6)", "b = Ok(\"x\")"]

@ cases.method-row-variable
source = ```nib
class Walk<F: (shared) -> shared> {
  fn each<A: shared, e>(x: F(A), f: (A) -> () ! {Div|e}) -> () ! {Div|e}
}
instance Walk(List) {
  fn each<A: shared, e>(x: List(A), f: (A) -> () ! {Div|e}) -> () ! {Div|e} {
    match x {
      Nil => ()
      Cons(h, t) => {
        f(h)
        Walk.each(t, f)
      }
    }
  }
}
fn show_all<F: (shared) -> shared>(x: F(i64)) -> () where Walk(F) {
  Walk.each(x, (n: i64) => perform show("n", n))
}
show_all(Cons(1, Cons(2, Nil)))
```
shows = ["n = 1", "n = 2"]
