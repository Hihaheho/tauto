@ cases.method-generics-fold
source = ```nib

class Fold(A: Type) {
  fn fold<B: Shared>(a: &A, init: B, f: (B, i64) -> B ! {overflow}): B ! {overflow}
}
instance Fold(i64) {
  fn fold<B: Shared>(a: &i64, init: B, f: (B, i64) -> B ! {overflow}): B ! {overflow} { f(init, a) }
}
fn both<A>(x: A): Text ! {overflow} where Fold(A) {
  let n := Fold::fold(&x, 10, (acc, v) => acc + v)
  let t := Fold::fold(&x, "n", (acc, v) => concat(acc, Text::of_i64(v)))
  concat(t, Text::of_i64(n))
}
show(&both(5))
```
stdout = ```
"n515"
```

@ cases.method-generics-passed-on
source = ```nib
class Fold(A: Type) {
  fn fold<B: Shared>(a: &A, init: B, f: (B, nat) -> B): B
}
instance Fold(nat) {
  fn fold<B: Shared>(a: &nat, init: B, f: (B, nat) -> B): B { f(init, a) }
}
fn inner<A>(x: A): nat where Fold(A) { Fold::fold(&x, 1, (acc, v) => acc + v) }
fn outer<A>(x: A): nat where Fold(A) { inner(x) * 2 }
let n: nat := 5
show(&outer(n))
```
stdout = "12\n"

@ cases.method-generics-nested-instance
source = ```nib
class Fold(A: Type) {
  fn fold<B: Shared>(a: &A, init: B, f: (B, nat) -> B): B
}
instance Fold(nat) {
  fn fold<B: Shared>(a: &nat, init: B, f: (B, nat) -> B): B { f(init, a) }
}
instance<A: Shared> Fold(List(A)) where Fold(A) {
  fn fold<B: Shared>(a: &List(A), init: B, f: (B, nat) -> B): B {
    match a {
      Nil => init
      Cons(x, rest) => Fold::fold(&rest, Fold::fold(&x, init, f), f)
    }
  }
}
fn total<A>(x: A): nat where Fold(A) { Fold::fold(&x, 0, (acc, v) => acc + v) }
let xs: List(nat) := Cons(1, Cons(2, Cons(3, Nil)))
show(&total(xs))
```
stdout = "6\n"

@ cases.hkt-functor-list
source = ```nib
class Functor(F: (Shared) -> Shared) {
  fn map<A: Shared, B: Shared>(x: F(A), f: (A) -> B): F(B)
}
instance Functor(List) {
  fn map<A: Shared, B: Shared>(x: List(A), f: (A) -> B): List(B) {
    match x {
      Nil => Nil
      Cons(h, t) => Cons(f(h), Functor::map(t, f))
    }
  }
}
instance Functor(Option) {
  fn map<A: Shared, B: Shared>(x: Option(A), f: (A) -> B): Option(B) {
    match x {
      None => None
      Some(v) => Some(f(v))
    }
  }
}
instance<E: Shared> Functor(Result(E)) {
  fn map<A: Shared, B: Shared>(x: Result(E, A), f: (A) -> B): Result(E, B) {
    match x {
      Ok(v) => Ok(v)
      Err(e) => Err(f(e))
    }
  }
}
fn double_all<F: (Shared) -> Shared>(x: F(nat)): F(nat) where Functor(F) {
  Functor::map(x, (n: nat) => n * 2)
}
fn twice<F: (Shared) -> Shared>(x: F(nat)): F(nat) where Functor(F) {
  double_all(double_all(x))
}
show(&Functor::map(Cons(1, Cons(2, Nil)), (n: nat) => n + 1))
```
stdout = "[2, 3]\n"

@ cases.hkt-generic-use
source = ```nib
class Functor(F: (Shared) -> Shared) {
  fn map<A: Shared, B: Shared>(x: F(A), f: (A) -> B): F(B)
}
instance Functor(List) {
  fn map<A: Shared, B: Shared>(x: List(A), f: (A) -> B): List(B) {
    match x {
      Nil => Nil
      Cons(h, t) => Cons(f(h), Functor::map(t, f))
    }
  }
}
instance Functor(Option) {
  fn map<A: Shared, B: Shared>(x: Option(A), f: (A) -> B): Option(B) {
    match x {
      None => None
      Some(v) => Some(f(v))
    }
  }
}
instance<E: Shared> Functor(Result(E)) {
  fn map<A: Shared, B: Shared>(x: Result(E, A), f: (A) -> B): Result(E, B) {
    match x {
      Ok(v) => Ok(v)
      Err(e) => Err(f(e))
    }
  }
}
