@ cases.hkt-partial-application
source = ```nib
class Functor(F: (Shared) -> Shared) {
  fn map<A: Shared, B: Shared>(x: F(A), f: (A) -> B): F(B)
}
instance Functor(List) {
  fn map<A: Shared, B: Shared>(x: List(A), f: (A) -> B): List(B) {
    match x {
      Nil => Nil
      Cons(h, t) => Cons(f(h), Functor::map(t, f))
    }
  }
}
instance Functor(Option) {
  fn map<A: Shared, B: Shared>(x: Option(A), f: (A) -> B): Option(B) {
    match x {
      None => None
      Some(v) => Some(f(v))
    }
  }
}
instance<E: Shared> Functor(Result(E)) {
  fn map<A: Shared, B: Shared>(x: Result(E, A), f: (A) -> B): Result(E, B) {
    match x {
      Ok(v) => Ok(v)
      Err(e) => Err(f(e))
    }
  }
}
fn double_all<F: (Shared) -> Shared>(x: F(i64)): F(i64) where Functor(F) {
  Functor::map(x, (n: i64) => n * 2)
}
fn twice<F: (Shared) -> Shared>(x: F(i64)): F(i64) where Functor(F) {
  double_all(double_all(x))
}
let r: Result(Text, i64) := Err(5)
perform show("a", Functor::map(r, (n: i64) => n + 1))
let ok: Result(Text, i64) := Ok("x")
perform show("b", Functor::map(ok, (n: i64) => n + 1))
```
shows = ["a = Err(6)", "b = Ok(\"x\")"]

@ cases.method-row-variable
source = ```nib
class Walk(F: (Shared) -> Shared) {
  fn each<A: Shared, !e>(x: F(A), f: (A) -> Unit ! {Div} ∪ e): Unit ! {Div} ∪ e
}
instance Walk(List) {
  fn each<A: Shared, !e>(x: List(A), f: (A) -> Unit ! {Div} ∪ e): Unit ! {Div} ∪ e {
    match x {
      Nil => #()
      Cons(h, t) => {
        f(h)
        Walk::each(t, f)
      }
    }
  }
}
fn show_all<F: (Shared) -> Shared>(x: F(i64)): Unit where Walk(F) {
  Walk::each(x, (n: i64) => perform show("n", n))
}
show_all(Cons(1, Cons(2, Nil)))
```
shows = ["n = 1", "n = 2"]

// A proved function over `Ord` runs as it checks.

@ cases.ord-method-argument-lent-once
source = ```tauto
import std::Ord
import std::prelude::Ord
fn key_eq<K>(a: K, b: K): Bool where Ord(K) {
  ⊢ Bool from match Ord::compare(&a, &b) {
    Less => false
    Equal => true
    Greater => false
  }
}
perform show("x", key_eq(1, 1))
```
shows = ["x = true"]
extract = true

@ cases.ord-result-over-borrowed-parameters
source = ```tauto
import std::prelude::Ord

fn key_order<K: Shared>(&a: K, &b: K): Ordering where Ord(K) {
  Ord::compare(&a, &b)
}
perform show("o", key_order(&1, &2))
```
shows = ["o = Less"]
extract = true

@ cases.instance-method-matches-a-record
source = ```tauto
class Join(A: Type) {
  fn join(a: A, b: A): A
}
instance Join(Nat) {
  fn join(a: Nat, b: Nat): Nat { b }
}
instance<A, B> Join(Pair(A, B)) where Join(A), Join(B) {
  fn join(p: Pair(A, B), q: Pair(A, B)): Pair(A, B) {
    ⊢ Pair(A, B) from match p {
      Pair { fst: a, snd: b } => ⊢ Pair(A, B) from match q {
        Pair { fst: c, snd: d } => Pair { fst: Join::join(a, c), snd: Join::join(b, d) }
      }
    }
  }
}
fn pick(p: Pair(Nat, Nat), q: Pair(Nat, Nat)): Pair(Nat, Nat) { Join::join(p, q) }
perform show("j", pick(Pair { fst: Zero, snd: Zero }, Pair { fst: Succ(Zero), snd: Zero }))
```
shows = ["j = #(1, 0)"]
extract = true

// A type error in a reachable function is reported beside a class call,
// rather than attributing that error to the method call.
@ cases.type-error-beside-a-class-call
source = ```tauto
import std::prelude::Ord
import std::prelude::Os

fn f(x: i64): Ordering { Ord::compare(&x, &x) }
fn g(): Unit { Os::print("a") }
g()
perform show("r", f(1))
```
run_error = "Os::print is how the host answers the standard effects"
compile_errors.rust = "front: Os::print is how the host answers the standard effects"
compile_errors.javascript = "front: Os::print is how the host answers the standard effects"
compile_errors.vm = "front: Os::print is how the host answers the standard effects"
extract = true

// A host primitive carries the effect it answers in its row, and a program
// cannot call it: the call would skip the program's own handlers and the
// permission check.
@ cases.a-host-primitive-with-an-effect-row-is-rejected-at-the-call
source = ```tauto
import std::prelude::Os

fn g(): u64 ! {random} { Os::random() }
perform show("r", g())
```
run_error = "Os::random is how the host answers the standard effects"
compile_errors.rust = "front: Os::random is how the host answers the standard effects"
compile_errors.javascript = "front: Os::random is how the host answers the standard effects"
compile_errors.vm = "front: Os::random is how the host answers the standard effects"
extract = true

