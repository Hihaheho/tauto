// Classes run: the expansion gives each constraint the methods as arguments.

@ cases.class-call
source = ```nib
class Cmp(A: Linear) {
  fn cmp(&a: A, &b: A): i64
}
instance Cmp(i64) {
  fn cmp(&a: i64, &b: i64): i64 { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
}
perform show("c", Cmp::cmp(&1, &2))
```
shows = ["c = -1"]

@ cases.class-nested-instance
source = ```nib
class Cmp(A: Linear) {
  fn cmp(&a: A, &b: A): i64
}
instance Cmp(i64) {
  fn cmp(&a: i64, &b: i64): i64 { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
}
instance<A> Cmp(List(A)) where Cmp(A) {
  fn cmp(&a: List(A), &b: List(A)): i64 {
    match a {
      Nil => match b {
        Nil => 0
        Cons(y, ys) => 0 - 1
      }
      Cons(x, xs) => match b {
        Nil => 1
        Cons(y, ys) => {
          let c := Cmp::cmp(&x, &y)
          if c == 0 { Cmp::cmp(&xs, &ys) } else { c }
        }
      }
    }
  }
}
perform show("a", Cmp::cmp(&Cons(1, Cons(2, Nil)), &Cons(1, Cons(3, Nil))))
perform show("b", Cmp::cmp(&Cons(1, Nil), &Cons(1, Nil)))
```
shows = ["a = -1", "b = 0"]

@ cases.class-constrained-function
source = ```nib
class Cmp(A: Linear) {
  fn cmp(&a: A, &b: A): i64
}
instance Cmp(i64) {
  fn cmp(&a: i64, &b: i64): i64 { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
}
fn bigger<A: Shared>(a: A, b: A): A where Cmp(A) {
  if Cmp::cmp(&a, &b) < 0 { b } else { a }
}
perform show("m", bigger(3, 7))
```
shows = ["m = 7"]

@ cases.class-two-methods
source = ```nib
class Shape(A: Shared) {
  fn area(&a: A): i64
  fn name(&a: A): Text
}
struct Sq { side: i64 }
instance Shape(Sq) {
  fn area(&a: Sq): i64 { a.side * a.side }
  fn name(&a: Sq): Text { "square" }
}
fn describe<A: Shared>(s: A): Text where Shape(A) {
  Shape::name(&s)
}
perform show("n", describe(Sq { side: 3 }))
perform show("a", Shape::area(&Sq { side: 3 }))
```
shows = ["n = \"square\"", "a = 9"]

@ cases.class-closure-returns
source = ```nib
class Cmp(A: Linear) {
  fn cmp(&a: A, &b: A): i64
}
instance Cmp(i64) {
  fn cmp(&a: i64, &b: i64): i64 { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
}
fn rank<A: Shared>(base: A): (A) -> i64 where Cmp(A) {
  (x: A) => Cmp::cmp(&x, &base)
}
let f := rank(5)
perform show("r", f(9))
```
shows = ["r = 1"]

@ cases.class-method-as-value
source = ```nib
class Cmp(A: Linear) {
  fn cmp(&a: A, &b: A): i64
}
instance Cmp(i64) {
  fn cmp(&a: i64, &b: i64): i64 { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
}
fn twice(f: (&i64, &i64) -> i64): i64 { f(&1, &2) + f(&2, &1) }
perform show("t", twice(Cmp::cmp))
```
shows = ["t = 0"]

@ cases.std-ord
source = ```nib
import std::prelude::Ord

perform show("a", Ord::compare(&1, &2))
perform show("b", Ord::compare(&Cons(1, Nil), &Cons(1, Cons(0, Nil))))
perform show("c", Ord::compare(&Some(3), &None))
perform show("d", Ord::compare(&Pair { fst: 1, snd: "b" }, &Pair { fst: 1, snd: "a" }))
```
shows = ["a = Less", "b = Less", "c = Greater", "d = Greater"]

@ cases.std-sort-and-extremes
source = ```nib
import std::prelude::Affine
import std::prelude::Classes

var v := Vec::new()
Vec::push(&mut v, 3)
Vec::push(&mut v, 1)
Vec::push(&mut v, 2)
Vec::sort(&mut v)
perform show("v", Vec::into_list(v))
perform show("max", List::max(Cons(2, Cons(9, Cons(4, Nil)))))
perform show("min", List::min(Cons(2, Cons(9, Cons(4, Nil)))))
```
shows = ["v = Cons(1, Cons(2, Cons(3, Nil)))", "max = Some(9)", "min = Some(2)"]

@ cases.std-to-text
source = ```nib
import std::prelude::Classes

perform show("a", ToText::to_text(&Cons(1, Cons(2, Nil))))
perform show("b", join(Cons(1, Cons(2, Cons(3, Nil))), "-"))
perform show("c", ToText::to_text(&Some(true)))
perform show("d", ToText::to_text(&Pair { fst: 7, snd: "x" }))
```
shows = ["a = \"[1, 2]\"", "b = \"1-2-3\"", "c = \"Some(true)\"", "d = \"(7, x)\""]

// A product has instances of `Ord` and `ToText` of its own: in the order of its members,
// and a product of three is its first member and the product of the other two.
@ cases.std-ord-and-to-text-of-products
source = ```nib
import std::prelude::Affine
import std::prelude::Classes
import std::prelude::Ord

perform show("a", Ord::compare(&#(1, 2), &#(1, 3)))
perform show("b", Ord::compare(&#(2, 0), &#(1, 9)))
perform show("c", Ord::compare(&#(1, 2, 3), &#(1, 2, 3)))
perform show("d", Ord::compare(&#(1, 2, 4), &#(1, 2, 3)))
perform show("e", ToText::to_text(&#(7, "x")))
perform show("f", ToText::to_text(&#(1, 2, 3)))
var v := Vec::new()
Vec::push(&mut v, #(2, 1))
Vec::push(&mut v, #(1, 5))
Vec::push(&mut v, #(2, 0))
Vec::push(&mut v, #(1, 2))
Vec::sort(&mut v)
perform show("sorted", ToText::to_text(&Vec::into_list(v)))
var w := Vec::new()
Vec::push(&mut w, #(1, 2, 3))
Vec::push(&mut w, #(1, 1, 9))
Vec::push(&mut w, #(0, 5, 5))
Vec::sort(&mut w)
perform show("sorted3", ToText::to_text(&Vec::into_list(w)))
perform show("max", List::max(Cons(#(1, 9), Cons(#(3, 0), Cons(#(2, 7), Nil)))))
```
shows = [
  "a = Less",
  "b = Greater",
  "c = Equal",
  "d = Greater",
  "e = \"(7, x)\"",
  "f = \"(1, (2, 3))\"",
  "sorted = \"[(1, 2), (1, 5), (2, 0), (2, 1)]\"",
  "sorted3 = \"[(0, (5, 5)), (1, (1, 9)), (1, (2, 3))]\"",
  "max = Some(#(3, 0))",
]

@ cases.user-instance-for-a-std-class
source = ```nib
import std::prelude::Affine
import std::prelude::Classes
import std::prelude::Ord

struct P { x: i64 }
instance Ord(P) {
  fn compare(&a: P, &b: P): Ordering { Ord::compare(&a.x, &b.x) }
}
var v := Vec::new()
Vec::push(&mut v, P { x: 5 })
Vec::push(&mut v, P { x: 2 })
Vec::sort(&mut v)
let first := handle { Vec::index(&v, 0).x } with {
  out_of_bounds() => 0
}
perform show("first", first)
```
shows = ["first = 2"]

@ cases.method-generics-fold
source = ```nib
import std::prelude::Shared

class Fold(A: Type) {
  fn fold<B: Shared>(&a: A, init: B, f: (B, i64) -> B): B
}
instance Fold(i64) {
  fn fold<B: Shared>(&a: i64, init: B, f: (B, i64) -> B): B { f(init, a) }
}
fn both<A>(x: A): Text where Fold(A) {
  let n := Fold::fold(&x, 10, (acc, v) => acc + v)
  let t := Fold::fold(&x, "n", (acc, v) => concat(acc, Text::of_i64(v)))
  concat(t, Text::of_i64(n))
}
perform show("r", both(5))
```
shows = ["r = \"n515\""]

@ cases.method-generics-passed-on
source = ```nib
class Fold(A: Type) {
  fn fold<B: Shared>(&a: A, init: B, f: (B, i64) -> B): B
}
instance Fold(i64) {
  fn fold<B: Shared>(&a: i64, init: B, f: (B, i64) -> B): B { f(init, a) }
}
fn inner<A>(x: A): i64 where Fold(A) { Fold::fold(&x, 1, (acc, v) => acc + v) }
fn outer<A>(x: A): i64 where Fold(A) { inner(x) * 2 }
perform show("r", outer(5))
```
shows = ["r = 12"]

@ cases.method-generics-nested-instance
source = ```nib
class Fold(A: Type) {
  fn fold<B: Shared>(&a: A, init: B, f: (B, i64) -> B): B
}
instance Fold(i64) {
  fn fold<B: Shared>(&a: i64, init: B, f: (B, i64) -> B): B { f(init, a) }
}
instance<A: Shared> Fold(List(A)) where Fold(A) {
  fn fold<B: Shared>(&a: List(A), init: B, f: (B, i64) -> B): B {
    match a {
      Nil => init
      Cons(x, rest) => Fold::fold(&rest, Fold::fold(&x, init, f), f)
    }
  }
}
fn total<A>(x: A): i64 where Fold(A) { Fold::fold(&x, 0, (acc, v) => acc + v) }
perform show("r", total(Cons(1, Cons(2, Cons(3, Nil)))))
```
shows = ["r = 6"]

@ cases.hkt-functor-list
source = ```nib
class Functor(F: (Shared) -> Shared) {
  fn map<A: Shared, B: Shared>(x: F(A), f: (A) -> B): F(B)
}
instance Functor(List) {
  fn map<A: Shared, B: Shared>(x: List(A), f: (A) -> B): List(B) {
    match x {
      Nil => Nil
      Cons(h, t) => Cons(f(h), Functor::map(t, f))
    }
  }
}
instance Functor(Option) {
  fn map<A: Shared, B: Shared>(x: Option(A), f: (A) -> B): Option(B) {
    match x {
      None => None
      Some(v) => Some(f(v))
    }
  }
}
instance<E: Shared> Functor(Result(E)) {
  fn map<A: Shared, B: Shared>(x: Result(E, A), f: (A) -> B): Result(E, B) {
    match x {
      Ok(v) => Ok(v)
      Err(e) => Err(f(e))
    }
  }
}
fn double_all<F: (Shared) -> Shared>(x: F(i64)): F(i64) where Functor(F) {
  Functor::map(x, (n: i64) => n * 2)
}
fn twice<F: (Shared) -> Shared>(x: F(i64)): F(i64) where Functor(F) {
  double_all(double_all(x))
}
perform show("r", Functor::map(Cons(1, Cons(2, Nil)), (n: i64) => n + 1))
```
shows = ["r = Cons(2, Cons(3, Nil))"]

@ cases.hkt-generic-use
source = ```nib
class Functor(F: (Shared) -> Shared) {
  fn map<A: Shared, B: Shared>(x: F(A), f: (A) -> B): F(B)
}
instance Functor(List) {
  fn map<A: Shared, B: Shared>(x: List(A), f: (A) -> B): List(B) {
    match x {
      Nil => Nil
      Cons(h, t) => Cons(f(h), Functor::map(t, f))
    }
  }
}
instance Functor(Option) {
  fn map<A: Shared, B: Shared>(x: Option(A), f: (A) -> B): Option(B) {
    match x {
      None => None
      Some(v) => Some(f(v))
    }
  }
}
instance<E: Shared> Functor(Result(E)) {
  fn map<A: Shared, B: Shared>(x: Result(E, A), f: (A) -> B): Result(E, B) {
    match x {
      Ok(v) => Ok(v)
      Err(e) => Err(f(e))
    }
  }
}
fn double_all<F: (Shared) -> Shared>(x: F(i64)): F(i64) where Functor(F) {
  Functor::map(x, (n: i64) => n * 2)
}
fn twice<F: (Shared) -> Shared>(x: F(i64)): F(i64) where Functor(F) {
  double_all(double_all(x))
}
perform show("a", double_all(Some(2)))
perform show("b", double_all(Cons(1, Cons(2, Nil))))
```
shows = ["a = Some(4)", "b = Cons(2, Cons(4, Nil))"]

