instance Ord(P) {
  fn compare(&a: P, &b: P) -> Ordering { Ord.compare(&a.x, &b.x) }
}
var v = vec_new()
vec_push(&mut v, P { x: 5 })
vec_push(&mut v, P { x: 2 })
vec_sort(&mut v)
perform show("first", vec_index(&v, 0).x)
```
