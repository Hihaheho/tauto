// Classes run: the expansion gives each constraint the methods as arguments.

@ cases.class-call
source = ```nib
class Cmp(A: Linear) {
  fn cmp(a: &A, b: &A): i64
}
instance Cmp(i64) {
  fn cmp(a: &i64, b: &i64): i64 { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
}
show(&Cmp::cmp(&1, &2))
```
stdout = "-1\n"

@ cases.class-nested-instance
source = ```nib
class Cmp(A: Linear) {
  fn cmp(a: &A, b: &A): i64
}
instance Cmp(i64) {
  fn cmp(a: &i64, b: &i64): i64 { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
}
instance<A> Cmp(List(A)) where Cmp(A) {
  fn cmp(a: &List(A), b: &List(A)): i64 {
    match a {
      Nil => match b {
        Nil => 0
        Cons(y, ys) => 0 - 1
      }
      Cons(x, xs) => match b {
        Nil => 1
        Cons(y, ys) => {
          let c := Cmp::cmp(&x, &y)
          if c == 0 { Cmp::cmp(&xs, &ys) } else { c }
        }
      }
    }
  }
}
show(&Cmp::cmp(&Cons(1, Cons(2, Nil)), &Cons(1, Cons(3, Nil))))
show(&Cmp::cmp(&Cons(1, Nil), &Cons(1, Nil)))
```
stdout = ```
-1
0
```

@ cases.class-constrained-function
source = ```nib
class Cmp(A: Linear) {
  fn cmp(a: &A, b: &A): i64
}
instance Cmp(i64) {
  fn cmp(a: &i64, b: &i64): i64 { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
}
fn bigger<A: Shared>(a: A, b: A): A where Cmp(A) {
  if Cmp::cmp(&a, &b) < 0 { b } else { a }
}
show(&bigger(3, 7))
```
stdout = "7\n"

@ cases.class-two-methods
source = ```nib
class Shape(A: Shared) {
  fn area(a: &A): nat
  fn name(a: &A): Text
}
struct Sq { side: nat }
instance Shape(Sq) {
  fn area(a: &Sq): nat { a.side * a.side }
  fn name(a: &Sq): Text { "square" }
}
fn describe<A: Shared>(s: A): Text where Shape(A) {
  Shape::name(&s)
}
show(&describe(Sq { side: 3 }))
show(&Shape::area(&Sq { side: 3 }))
```
stdout = ```
"square"
9
```

