}
show(&key_order(&1, &2))
```
stdout = "Less\n"

@ cases.instance-method-matches-a-record
source = ```tauto
class Join(A: Type) {
  fn join(a: A, b: A): A
}
instance Join(Nat) {
  fn join(a: Nat, b: Nat): Nat { b }
}
instance<A, B> Join(A × B) where Join(A), Join(B) {
  fn join(p: A × B, q: A × B): A × B {
    ⊢ (A × B) from match p {
      #(a, b) => ⊢ (A × B) from match q {
        #(c, d) => #(Join::join(a, c), Join::join(b, d))
      }
    }
  }
}
fn pick(p: Nat × Nat, q: Nat × Nat): Nat × Nat { Join::join(p, q) }
show(&pick(#(Zero, Zero), #(Succ(Zero), Zero)))
```
stdout = "#(1, 0)\n"

// A type error in a reachable function is reported beside a class call,
// rather than attributing that error to the method call.
@ cases.type-error-beside-a-class-call
entry = "main.taut"
files."main.taut" = ```tauto
import std::builtin::ord
import std::builtin::os

fn f(x: i64): Ordering { Ord::compare(&x, &x) }
fn g(): Unit { Os::print("a") }
g()
show(&f(1))
```
macro_error = "`Os::print` is not `pub` in the standard library"

// The host's own functions (the externs of `module Os`, the functions of
// `module Host`) are not `pub` in the standard library, so a program cannot
// call them: the call would skip the program's own handlers and the
// permission check.
@ cases.a-host-primitive-with-an-effect-row-is-rejected-at-the-call
entry = "main.taut"
files."main.taut" = ```tauto
import std::builtin::os

fn g(): u64 ! {random} { Os::random() }
show(&g())
```
macro_error = "`Os::random` is not `pub` in the standard library"

@ cases.a-function-of-the-host-module-is-rejected-at-the-call
entry = "main.taut"
files."main.taut" = ```tauto
import std::builtin::os
import std::builtin::par

fn g(): Result(List(Text), IoError) ! {wait} { Host::resolve("localhost") }
show(&g())
```
macro_error = "`Host::resolve` is not `pub` in the standard library"

// A class without laws may have methods with effects; it runs as written, with
// its instances.
@ cases.a-class-whose-methods-have-effects-runs
source = ```tauto
effect tick(): Unit
class Render(A: Shared) {
  fn render(build: () -> A ! {tick}): i64 ! {tick}
}
instance Render(i64) {
  fn render(build: () -> i64 ! {tick}): i64 ! {tick} { build() }
}
let v := handle { Render::render(() => { perform tick(); 1 }) } with {
  tick(), k => k(#())
  return x => x
}
show(&v)
```
stdout = "1\n"

// An instance head names a type even where a constructor shares its name:
// `Cancelled` of `std::builtin::par` is both.
@ cases.instance-head-is-the-type-where-a-constructor-shares-its-name
source = ```nib
import std::builtin::par

class Describe(A: Type) {
  fn describe(x: &A): Text
}

instance Describe(Cancelled) {
  fn describe(x: &Cancelled): Text { "cancelled" }
}

let c := Cancelled {}
show(&Describe::describe(&c))
show(&Describe::describe(&Cancelled {}))
```
stdout = ```
"cancelled"
"cancelled"
```

