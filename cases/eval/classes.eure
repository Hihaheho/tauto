// A class without laws may have methods with effects; it runs as written, with
// its instances.
@ cases.a-class-whose-methods-have-effects-runs
source = ```tauto
import std::prelude::Shared
effect tick(): Unit
class Render(A: Shared) {
  fn render(build: () -> A ! {tick}): i64 ! {tick}
}
instance Render(i64) {
  fn render(build: () -> i64 ! {tick}): i64 ! {tick} { build() }
}
let v := handle { Render::render(() => { perform tick(); 1 }) } with {
  tick(), k => k(#())
  return x => x
}
perform show("v", v)
```
shows = ["v = 1"]
