// A product has instances of `Ord` and `ToText` of its own: in the order of its members,
// and a product of three is its first member and the product of the other two.
@ cases.std-ord-and-to-text-of-products
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Vec::into_list` yet"
source = ```nib
import std::builtin::classes
import std::builtin::ord

show(&Ord::compare(&#(1, 2), &#(1, 3)))
show(&Ord::compare(&#(2, 0), &#(1, 9)))
show(&Ord::compare(&#(1, 2, 3), &#(1, 2, 3)))
show(&Ord::compare(&#(1, 2, 4), &#(1, 2, 3)))
show(&ToText::to_text(&#(7, "x")))
show(&ToText::to_text(&#(1, 2, 3)))
var v := Vec::new()
Vec::push(&mut v, #(2, 1))
Vec::push(&mut v, #(1, 5))
Vec::push(&mut v, #(2, 0))
Vec::push(&mut v, #(1, 2))
Vec::sort(&mut v)
show(&ToText::to_text(&Vec::into_list(v)))
var w := Vec::new()
Vec::push(&mut w, #(1, 2, 3))
Vec::push(&mut w, #(1, 1, 9))
Vec::push(&mut w, #(0, 5, 5))
Vec::sort(&mut w)
show(&ToText::to_text(&Vec::into_list(w)))
show(&List::max(Cons(#(1, 9), Cons(#(3, 0), Cons(#(2, 7), Nil)))))
```
stdout = ```
Less
Greater
Equal
Greater
"(7, x)"
"(1, (2, 3))"
"[(1, 2), (1, 5), (2, 0), (2, 1)]"
"[(0, (5, 5)), (1, (1, 9)), (1, (2, 3))]"
Some(#(3, 0))
```

