// `Text` and `Buf` builtins. Positions are UTF-8 bytes.

@ cases.text-len-counts-bytes
source = ```nib
perform show("n", text_len("aあ"))
```
shows = ["n = 4"]

@ cases.text-byte-in-range
source = ```nib
perform show("b", text_byte("ab", 1))
```
shows = ["b = Some(98)"]

@ cases.text-byte-out-of-range
source = ```nib
perform show("b", text_byte("ab", 2))
```
shows = ["b = None"]

@ cases.text-slice-ok
source = ```nib
perform show("s", text_slice("hello", 1, 3))
```
shows = ["s = Some(\"el\")"]

@ cases.text-slice-not-boundary
source = ```nib
perform show("s", text_slice("あ", 0, 1))
```
shows = ["s = None"]

@ cases.text-slice-reversed
source = ```nib
perform show("s", text_slice("ab", 2, 1))
```
shows = ["s = None"]

@ cases.text-slice-past-the-end
source = ```nib
perform show("s", text_slice("ab", 0, 3))
```
shows = ["s = None"]

@ cases.text-compare
source = ```nib
perform show("lt", text_compare("a", "b"))
perform show("gt", text_compare("b", "a"))
perform show("eq", text_compare("a", "a"))
perform show("prefix", text_compare("a", "ab"))
```
shows = ["lt = -1", "gt = 1", "eq = 0", "prefix = -1"]

@ cases.text-of-code-point
source = ```nib
perform show("a", text_of_code_point(12354))
perform show("surrogate", text_of_code_point(55296))
perform show("beyond", text_of_code_point(1114112))
```
shows = ["a = Some(\"あ\")", "surrogate = None", "beyond = None"]

@ cases.text-of-i64
source = ```nib
perform show("t", text_of_i64(0 - 12))
```
shows = ["t = \"-12\""]

@ cases.text-of-u64
source = ```nib
perform show("t", text_of_u64(12))
```
shows = ["t = \"12\""]

@ cases.buf-push
source = ```nib
var b = buf_new()
buf_push(&mut b, &"ab")
buf_push(&mut b, &"c")
perform show("t", text_of(b))
```
shows = ["t = \"abc\""]

// Text literals: `"…"` resolves escapes, `'…'` and plaintext`…` are taken as written.

@ cases.escapes-in-double-quotes
source = ```nib
perform show("a", "x\ny\t\"z\" \\ \u{e9}\0")
```
shows = ["a = \"x\\ny\\t\\\"z\\\" \\\\ é\\0\""]

@ cases.single-quotes-have-no-escapes
source = ```nib
perform show("b", 'a\nb')
```
shows = ["b = \"a\\\\nb\""]

@ cases.plaintext-has-no-escapes
source = ```nib
perform show("c", plaintext`a\nb "q"`)
```
shows = ["c = \"a\\\\nb \\\"q\\\"\""]

@ cases.the-three-forms-agree
source = ```nib
perform show("d", concat("a\\b", 'c') == concat(plaintext`a\b`, "c"))
```
shows = ["d = true"]
