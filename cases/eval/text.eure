// `Text` and `Buf` builtins (`std/prelude/Text.taut`). Positions are UTF-8 bytes.

@ cases.text-len-counts-bytes
source = ```nib
perform show("n", Text::len("aあ"))
```
shows = ["n = 4"]

@ cases.text-byte-in-range
source = ```nib
perform show("b", Text::byte("ab", 1))
```
shows = ["b = Some(98)"]

@ cases.text-byte-out-of-range
source = ```nib
perform show("b", Text::byte("ab", 2))
```
shows = ["b = None"]

@ cases.text-slice-ok
source = ```nib
perform show("s", Text::slice("hello", 1, 3))
```
shows = ["s = Some(\"el\")"]

@ cases.text-slice-not-boundary
source = ```nib
perform show("s", Text::slice("あ", 0, 1))
```
shows = ["s = None"]

@ cases.text-slice-reversed
source = ```nib
perform show("s", Text::slice("ab", 2, 1))
```
shows = ["s = None"]

@ cases.text-slice-past-the-end
source = ```nib
perform show("s", Text::slice("ab", 0, 3))
```
shows = ["s = None"]

@ cases.text-compare
source = ```nib
perform show("lt", Text::compare("a", "b"))
perform show("gt", Text::compare("b", "a"))
perform show("eq", Text::compare("a", "a"))
perform show("prefix", Text::compare("a", "ab"))
perform show("empty", Text::compare("", ""))
perform show("empty-first", Text::compare("", "😀"))
perform show("empty-last", Text::compare("😀", ""))
perform show("scalar-order", Text::compare("\u{e000}", "\u{10000}"))
perform show("reverse-scalar-order", Text::compare("\u{10000}", "\u{e000}"))
perform show("non-bmp-equal", Text::compare("😀あ", "😀あ"))
perform show("non-bmp-prefix", Text::compare("😀", "😀あ"))
perform show("reverse-non-bmp-prefix", Text::compare("😀あ", "😀"))
perform show("late", Text::compare("😀あ😀あx", "😀あ😀あy"))
perform show("not-normalized", Text::compare("e\u{301}", "é"))
```
shows = ["lt = -1", "gt = 1", "eq = 0", "prefix = -1", "empty = 0", "empty-first = -1", "empty-last = 1", "scalar-order = -1", "reverse-scalar-order = 1", "non-bmp-equal = 0", "non-bmp-prefix = -1", "reverse-non-bmp-prefix = 1", "late = -1", "not-normalized = -1"]

@ cases.text-of-code-point
source = ```nib
perform show("a", Text::of_code_point(12354))
perform show("surrogate", Text::of_code_point(55296))
perform show("beyond", Text::of_code_point(1114112))
```
shows = ["a = Some(\"あ\")", "surrogate = None", "beyond = None"]

@ cases.text-of-i64
source = ```nib
perform show("t", Text::of_i64(0 - 12))
```
shows = ["t = \"-12\""]

@ cases.text-of-u64
source = ```nib
perform show("t", Text::of_u64(12))
```
shows = ["t = \"12\""]

@ cases.buf-push
source = ```nib
import std::prelude::Affine

var b := Buf::new()
Buf::push(&mut b, &"ab")
Buf::push(&mut b, &"c")
perform show("t", Text::of(b))
```
shows = ["t = \"abc\""]

// Text literals: `"…"` resolves escapes, `'…'` and plaintext`…` are taken as written.

@ cases.escapes-in-double-quotes
source = ```nib
perform show("a", "x\ny\t\"z\" \\ \u{e9}\0")
```
shows = ["a = \"x\\ny\\t\\\"z\\\" \\\\ é\\0\""]

@ cases.single-quotes-have-no-escapes
source = ```nib
perform show("b", 'a\nb')
```
shows = ["b = \"a\\\\nb\""]

@ cases.plaintext-has-no-escapes
source = ```nib
perform show("c", plaintext`a\nb "q"`)
```
shows = ["c = \"a\\\\nb \\\"q\\\"\""]

@ cases.the-three-forms-agree
source = ```nib
import std::prelude::Shared

perform show("d", concat("a\\b", 'c') == concat(plaintext`a\b`, "c"))
```
shows = ["d = true"]

@ cases.text-of-utf8
source = ```nib
perform show("ok", Text::of_utf8(Cons(104, Cons(227, Cons(129, Cons(130, Nil))))))
perform show("empty", Text::of_utf8(Nil))
perform show("cut", Text::of_utf8(Cons(227, Cons(129, Nil))))
perform show("overlong", Text::of_utf8(Cons(192, Cons(175, Nil))))
perform show("surrogate", Text::of_utf8(Cons(237, Cons(160, Cons(128, Nil)))))
perform show("beyond", Text::of_utf8(Cons(244, Cons(144, Cons(128, Cons(128, Nil))))))
```
shows = ["ok = Some(\"hあ\")", "empty = Some(\"\")", "cut = None", "overlong = None", "surrogate = None", "beyond = None"]
