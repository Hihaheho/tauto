@ cases.borrowed_callback_budget
source = ```tauto

fn sum(read: &((u64) -> u64), size: u64): u64 ! {div, overflow} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(i)
    i := i + 1
  }
  total
}

fn run(read: &((u64) -> u64), size: u64): Result(u64, Text) ! {budget, overflow} {
  handle {
    perform budget(1000, () => {
      Ok(sum((i) => read(i), size))
    })
  } with {
    exceeded(info), k => Err("exhausted")
  }
}

fn run_array(values: Array(u64)): Result(u64, Text) ! {budget, overflow} {
  handle {
    perform budget(1000, () => {
      Ok(sum(
        (i) => match Array::get(values, i) {
          None => 0,
          Some(v) => v
        },
        Array::len(values)
      ))
    })
  } with {
    exceeded(info), k => Err("exhausted")
  }
}
```
types = "ok"
rows = "ok"
lin = "ok"

