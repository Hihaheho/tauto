@ cases.runtime_syntax_unicode_diagnostics
files."main.tauto" = ````tauto
import std::prelude::Macro

syntax!(ident, ```par
%start Decl
%title "ident"
%%
Decl: Name Equals Value;
Name: /[\p{L}_][\p{L}\p{N}_]*/;
Equals: '=';
Value: /[0-9]+/;
```) => struct Decl, fn parse

match ident::parse("日本語=12") {
  Ok(ast) => {
    perform show("name", ast.name.text)
    perform show("name-at", ast.name.span.id)
    perform show("value", ast.value.text)
    perform show("value-at", ast.value.span.id)
  }
  Err(diag) => perform show("unexpected", diag.message)
}
match ident::parse("日本語=@") {
  Err(diag) => {
    perform show("bad-at", diag.at)
    perform show("bad-code", diag.code)
    perform show("bad-message", diag.message)
    perform show("bad-expected", diag.expected)
  }
  Ok(ast) => perform show("unexpected", ast.name.text)
}
match ident::parse("日本語=") {
  Err(diag) => { perform show("eof-at", diag.at); perform show("eof-expected", diag.expected) }
  Ok(ast) => perform show("unexpected", ast.name.text)
}
````
entry = "main.tauto"
shows = ["name = \"日本語\"", "name-at = 0", "value = \"12\"", "value-at = 10", "bad-at = 10", "bad-code = \"macro.syntax_error\"", "bad-message = \"macro-syntax-not-a-token\"", "bad-expected = Nil", "eof-at = 10", "eof-expected = Cons(\"Value\", Nil)"]
backends = ["rust", "javascript"]

@ cases.borrowed_callback_host_equivalent_outputs
source = ```tauto
import std::prelude::Shared


fn names(callback: u64, &arg0: (u64) -> u64): u64 { arg0(callback) }
fn apply(&f: (u64) -> u64, value: u64): u64 { f(value) }
fn read_first(&f: (u64) -> u64): u64 { f(0) }
fn read_if(&f: (u64) -> u64, enabled: Bool): u64 { if enabled { f(0) } else { 0 } }
fn twice(&f: (u64) -> u64, value: u64): u64 { f(value) + f(value) }
fn both(&left: (u64) -> u64, &right: (u64, u64) -> u64): u64 { right(left(0), left(1)) }
fn produce(&f: () -> u64): u64 { f() }
fn notify(&f: () -> Unit, value: u64): u64 { f(); value }
fn text_value(&f: (Option(Text)) -> Option(Text), value: Option(Text)): Option(Text) { f(value) }
fn borrow_text(&f: (&Text) -> Text, &value: Text): Text { f(&value) }

let values := Array::of_list(Cons(10, Cons(20, Cons(30, Nil))))
let read := (index: u64) => match Array::get(values, index) { Some(value) => value, None => 0 }
perform show("names", names(1, read))
perform show("apply-one", apply(read, 1))
perform show("apply-two", apply(read, 2))
perform show("twice", twice(read, 0))
perform show("both", both(read, (a, b) => a + b))
var calls: u64 := 0
let lazy := (index: u64) => { calls := calls + 1; read(index) }
perform show("disabled", read_if(lazy, false))
perform show("calls-disabled", calls)
perform show("first", read_first(lazy))
perform show("calls-first", calls)
perform show("produced", produce(() => 20))
perform show("notified", notify(() => #(), 1))
perform show("text", text_value((value) => value, Some("日本語")))
perform show("no-text", text_value((value) => value, None))
```
shows = ["names = 20", "apply-one = 20", "apply-two = 30", "twice = 20", "both = 30", "disabled = 0", "calls-disabled = 0", "first = 10", "calls-first = 1", "produced = 20", "notified = 1", "text = Some(\"日本語\")", "no-text = None"]
backends = ["rust", "javascript"]

@ cases.runtime_syntax_keyword_fields
files."main.tauto" = ````tauto
syntax!(ident, ```par
%start Decl
%title "ident"
%%
Decl: Name Equals Value;
Name: /[\p{L}_][\p{L}\p{N}_]*/;
Equals: '=';
Value: /[0-9]+/;
```) => struct Decl, fn parse
syntax!(keywords, ```par
%start Root
%title "keyword fields"
%%
Root: '['^ Value ']'^;
Value: 'true' | 'false';
```) => struct Root, enum Value, fn parse

fn token(input: Text): Pair(Text, u64) {
  match keywords::parse(input) {
    Ok(tree) => match tree.value {
      keywords::Value::True { span: _, true_field } => Pair { fst: true_field.text, snd: true_field.span.id }
      keywords::Value::False { span: _, false_field } => Pair { fst: false_field.text, snd: false_field.span.id }
    }
    Err(diag) => Pair { fst: diag.code, snd: diag.at }
  }
}
perform show("true", token("[true]"))
perform show("false", token("[false]"))
perform show("invalid", match keywords::parse("[maybe]") { Ok(tree) => false, Err(diag) => true })
````
entry = "main.tauto"
shows = ["true = #(\"true\", 1)", "false = #(\"false\", 1)", "invalid = true"]
backends = ["rust", "javascript"]

