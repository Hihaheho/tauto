@ cases.runtime_syntax_keyword_fields
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Syn::parse` yet"
files."main.tauto" = ````tauto
syntax!(ident, ```par
%start Decl
%title "ident"
%%
Decl: Name Equals Value;
Name: /[\p{L}_][\p{L}\p{N}_]*/;
Equals: '=';
Value: /[0-9]+/;
```) => struct Decl, fn parse
syntax!(keywords, ```par
%start Root
%title "keyword fields"
%%
Root: '['^ Value ']'^;
Value: 'true' | 'false';
```) => struct Root, enum Value, fn parse

fn token(input: Text): Text × u64 {
  match keywords::parse(input) {
    Ok(tree) => match tree.value {
      keywords::Value::True { span: _, true_field } => #(true_field.text, true_field.span.id)
      keywords::Value::False { span: _, false_field } => #(false_field.text, false_field.span.id)
    }
    Err(diag) => #(diag.code, diag.at)
  }
}
show(&token("[true]"))
show(&token("[false]"))
show(&(match keywords::parse("[maybe]") { Ok(tree) => false, Err(diag) => true }))
````
