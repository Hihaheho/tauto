@ cases.borrowed_callback_budget_lifetimes
source = ```tauto

fn sum(read: &((u64) -> u64 ! {overflow}), size: u64): u64 ! {div, overflow} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(i)
    i := i + 1
  }
  total
}

fn run(read: &((u64) -> u64 ! {overflow}), size: u64): Result(u64, Text) ! {budget} {
  handle {
    perform budget(1000, () => {
      Ok(sum((i) => read(i), size))
    })
  } with {
    exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted")
  }
}

fn run_array(values: Array(u64)): Result(u64, Text) ! {budget} {
  handle {
    perform budget(1000, () => {
      Ok(sum(
        (i) => match Array::get(values, i) {
          None => 0,
          Some(v) => v
        },
        Array::len(values)
      ))
    })
  } with {
    exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted")
  }
}

fn r#direct(read: &((u64) -> u64 ! {overflow}), size: u64): Result(u64, Text) ! {budget} {
  handle { perform budget(1000, () => { Ok(sum(read, size)) }) } with { exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted") }
}
fn direct_loop(read: &((u64) -> u64 ! {overflow}), size: u64): Result(u64, Text) ! {budget} {
  handle { perform budget(1000, () => {
    var i: u64 := 0
    var total: u64 := 0
    while i < size {
      total := total + read(i)
      i := i + 1
    }
    Ok(total)
  }) } with { exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted") }
}
fn apply(f: &((u64) -> u64 ! {overflow}), value: u64): u64 ! {overflow} { f(value) }
fn nested(read: &((u64) -> u64 ! {overflow}), size: u64): Result(u64, Text) ! {budget} {
  handle { perform budget(1000, () => {
    Ok(sum((i) => apply((j) => read(i + j), 0), size))
  }) } with { exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted") }
}
fn sum_text(read: &((&Text) -> u64 ! {overflow}), size: u64): u64 ! {div, overflow} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    let text := concat("local", " text")
    total := total + read(&text)
    i := i + 1
  }
  total
}
fn sum_owned_text(read: &((Text) -> u64 ! {overflow}), size: u64): u64 ! {div, overflow} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(concat("local", " text"))
    i := i + 1
  }
  total
}
fn text_owned(read: &((&Text) -> u64 ! {overflow}), size: u64): Result(u64, Text) ! {budget} {
  handle { perform budget(1000, () => {
    Ok(sum_owned_text((text) => read(&text), size))
  }) } with { exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted") }
}
fn text_direct(read: &((&Text) -> u64 ! {overflow}), size: u64): Result(u64, Text) ! {budget} {
  handle { perform budget(1000, () => { Ok(sum_text(read, size)) }) } with { exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted") }
}
fn text_forwarded(read: &((&Text) -> u64 ! {overflow}), size: u64): Result(u64, Text) ! {budget} {
  handle { perform budget(1000, () => {
    Ok(sum_text((text) => read(&text), size))
  }) } with { exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted") }
}
```
types = "ok"
rows = "ok"
lin = "ok"

@ cases.constructor_index_rejected
