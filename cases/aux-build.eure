files."main.tauto" = ````tauto
import std::builtin::macro

syntax!(ident, ```par
%start Decl
%title "ident"
%%
Decl: Name Equals Value;
Name: /[\p{L}_][\p{L}\p{N}_]*/;
Equals: '=';
Value: /[0-9]+/;
```) => struct Decl, fn parse

match ident::parse("日本語=12") {
  Ok(ast) => {
    show(&ast.name.text)
    show(&ast.name.span.id)
    show(&ast.value.text)
    show(&ast.value.span.id)
  }
  Err(diag) => show(&diag.message)
}
match ident::parse("日本語=@") {
  Err(diag) => {
    show(&diag.at)
    show(&diag.code)
    show(&diag.message)
    show(&diag.expected)
  }
  Ok(ast) => show(&ast.name.text)
}
match ident::parse("日本語=") {
  Err(diag) => { show(&diag.at); show(&diag.expected) }
  Ok(ast) => show(&ast.name.text)
}
