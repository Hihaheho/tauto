@ cases.build_rs_rust_borrows_callbacks_for_one_call_without_static_captures
source = ```tauto

fn names(callback: u64, &arg0: (u64) -> u64): u64 { arg0(callback) }
fn apply(&f: (u64) -> u64, value: u64): u64 { f(value) }
fn read_first(&f: (u64) -> u64): u64 { f(0) }
fn read_if(&f: (u64) -> u64, enabled: Bool): u64 { if enabled { f(0) } else { 0 } }
fn twice(&f: (u64) -> u64, value: u64): u64 { f(value) + f(value) }
fn both(&left: (u64) -> u64, &right: (u64, u64) -> u64): u64 { right(left(0), left(1)) }
fn produce(&f: () -> u64): u64 { f() }
fn notify(&f: () -> Unit, value: u64): u64 { f(); value }
fn text_value(&f: (Option(Text)) -> Option(Text), value: Option(Text)): Option(Text) { f(value) }
fn borrow_text(&f: (&Text) -> Text, &value: Text): Text { f(&value) }
```
types = "ok"
rows = "ok"
lin = "ok"

@ cases.borrowed_callback_budget_lifetimes
source = ```tauto

fn sum(&read: (u64) -> u64, size: u64): u64 ! {Div} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(i)
    i := i + 1
  }
  total
}

fn run(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle {
    budget(steps: 1000) {
      Ok(sum(&(i) => read(i), size))
    }
  } with {
    exceeded(info), k => Err("exhausted")
  }
}

fn run_array(values: Array(u64)): Result(u64, Text) {
  handle {
    budget(steps: 1000) {
      Ok(sum(
        &(i) => match Array::get(values, i) {
          None => 0,
          Some(v) => v
        },
        Array::len(values)
      ))
    }
  } with {
    exceeded(info), k => Err("exhausted")
  }
}

fn r#direct(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) { Ok(sum(read, size)) } } with { exceeded(info), k => Err("exhausted") }
}
fn direct_loop(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) {
    var i: u64 := 0
    var total: u64 := 0
    while i < size {
      total := total + read(i)
      i := i + 1
    }
    Ok(total)
  } } with { exceeded(info), k => Err("exhausted") }
}
fn apply(&f: (u64) -> u64, value: u64): u64 { f(value) }
fn nested(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) {
    Ok(sum(&(i) => apply((j) => read(i + j), 0), size))
  } } with { exceeded(info), k => Err("exhausted") }
}
fn sum_text(&read: (&Text) -> u64, size: u64): u64 ! {Div} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    let text := concat("local", " text")
    total := total + read(&text)
    i := i + 1
  }
  total
}
fn sum_owned_text(&read: (Text) -> u64, size: u64): u64 ! {Div} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(concat("local", " text"))
    i := i + 1
  }
  total
}
fn text_owned(&read: (&Text) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) {
    Ok(sum_owned_text((&text) => read(&text), size))
  } } with { exceeded(info), k => Err("exhausted") }
}
fn text_direct(&read: (&Text) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) { Ok(sum_text(read, size)) } } with { exceeded(info), k => Err("exhausted") }
}
fn text_forwarded(&read: (&Text) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) {
    Ok(sum_text((&text) => read(&text), size))
  } } with { exceeded(info), k => Err("exhausted") }
}
```
types = "ok"
rows = "ok"
lin = "ok"

@ cases.constructor_index_rejected
source = ```tauto

enum Token { True, False }
inductive Box: Type { Mk(value: Nat): Box }
fn Valid(b: Option(Box), n: Nat): Prop {
  ⊢ Prop from match b { None => False, Some(v) => n = Zero }
}
theorem box_zero(): Valid(Some(Box::Mk(Zero)), Succ(Zero)) { Refl }
```
checks."Box" = "ok"
checks."Valid" = "ok"
checks."box_zero" = "error: type mismatch: expected `Succ(Zero) = Zero`, found `Succ(Zero) = Succ(Zero)`\n  differing part: expected `Zero`, found `Succ(Zero)`"
diagnostics = [{ "name" => "box_zero", "message" => "type mismatch: expected `Succ(Zero) = Zero`, found `Succ(Zero) = Succ(Zero)`\n  differing part: expected `Zero`, found `Succ(Zero)`", "span" => "«Refl»" }]

@ cases.constructor_missing_predicate
source = ```tauto

enum Token { True, False }
inductive Box: Type { Mk(value: Nat): Box }
fn Valid(b: Option(Box), n: Nat): Prop {
  ⊢ Prop from match b { None => missing_predicate, Some(v) => n = Zero }
}
theorem box_zero(): Valid(Some(Box::Mk(Zero)), Zero) { Refl }
```
checks."Box" = "ok"
checks."Valid" = "error: `missing_predicate` is not defined"
checks."box_zero" = "error: uses `Valid`, which did not check; what follows may come from that: cannot infer the generic `A` of `Eq::Refl`: neither its arguments nor the expected type fix it; write the generics as its first arguments, `Eq::Refl(A, a, …)`"
diagnostics = [{ "name" => "Valid", "message" => "`missing_predicate` is not defined", "span" => "«missing_predicate»" }, { "name" => "box_zero", "message" => "uses `Valid`, which did not check; what follows may come from that: cannot infer the generic `A` of `Eq::Refl`: neither its arguments nor the expected type fix it; write the generics as its first arguments, `Eq::Refl(A, a, …)`", "span" => "«Refl»" }]

@ cases.borrowed_callback_budget_outputs
source = ```tauto
import std::prelude::Affine
import std::prelude::Shared


fn sum(&read: (u64) -> u64, size: u64): u64 ! {Div} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(i)
    i := i + 1
  }
  total
}

fn run(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle {
    budget(steps: 1000) {
      Ok(sum(&(i) => read(i), size))
    }
  } with {
    exceeded(info), k => Err("exhausted")
  }
}

fn run_array(values: Array(u64)): Result(u64, Text) {
  handle {
    budget(steps: 1000) {
      Ok(sum(
        &(i) => match Array::get(values, i) {
          None => 0,
          Some(v) => v
        },
        Array::len(values)
      ))
    }
  } with {
    exceeded(info), k => Err("exhausted")
  }
}

var calls: u64 := 0
let read := (index: u64) => { calls := calls + 1; (index + 1) * 10 }
perform show("empty", run(read, 0))
perform show("calls-empty", calls)
perform show("sum", run(read, 3))
perform show("calls-sum", calls)
calls := 0
perform show("exhausted", run(read, 10000))
perform show("calls-bounded", calls > 0 && calls < 10000)
perform show("recovered", run(read, 3))
perform show("array-empty", run_array(Array::of_list(Nil)))
perform show("array", run_array(Array::of_list(Cons(10, Cons(20, Cons(30, Nil))))))
var items := Vec::new()
var index: u64 := 0
while index < 10000 { Vec::push(&mut items, 1); index := index + 1 }
perform show("array-exhausted", run_array(Vec::into_array(items)))
```
shows = ["empty = Ok(0)", "calls-empty = 0", "sum = Ok(60)", "calls-sum = 3", "exhausted = Err(\"exhausted\")", "calls-bounded = true", "recovered = Ok(60)", "array-empty = Ok(0)", "array = Ok(60)", "array-exhausted = Err(\"exhausted\")"]
backends = ["rust", "javascript"]

@ cases.borrowed_callback_lifetime_outputs
source = ```tauto
import std::prelude::Shared


fn sum(&read: (u64) -> u64, size: u64): u64 ! {Div} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(i)
    i := i + 1
  }
  total
}

fn run(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle {
    budget(steps: 1000) {
      Ok(sum(&(i) => read(i), size))
    }
  } with {
    exceeded(info), k => Err("exhausted")
  }
}

fn run_array(values: Array(u64)): Result(u64, Text) {
  handle {
    budget(steps: 1000) {
      Ok(sum(
        &(i) => match Array::get(values, i) {
          None => 0,
          Some(v) => v
        },
        Array::len(values)
      ))
    }
  } with {
    exceeded(info), k => Err("exhausted")
  }
}

fn r#direct(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) { Ok(sum(read, size)) } } with { exceeded(info), k => Err("exhausted") }
}
fn direct_loop(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) {
    var i: u64 := 0
    var total: u64 := 0
    while i < size {
      total := total + read(i)
      i := i + 1
    }
    Ok(total)
  } } with { exceeded(info), k => Err("exhausted") }
}
fn apply(&f: (u64) -> u64, value: u64): u64 { f(value) }
fn nested(&read: (u64) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) {
    Ok(sum(&(i) => apply((j) => read(i + j), 0), size))
  } } with { exceeded(info), k => Err("exhausted") }
}
fn sum_text(&read: (&Text) -> u64, size: u64): u64 ! {Div} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    let text := concat("local", " text")
    total := total + read(&text)
    i := i + 1
  }
  total
}
fn sum_owned_text(&read: (Text) -> u64, size: u64): u64 ! {Div} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(concat("local", " text"))
    i := i + 1
  }
  total
}
fn text_owned(&read: (&Text) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) {
    Ok(sum_owned_text((&text) => read(&text), size))
  } } with { exceeded(info), k => Err("exhausted") }
}
fn text_direct(&read: (&Text) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) { Ok(sum_text(read, size)) } } with { exceeded(info), k => Err("exhausted") }
}
fn text_forwarded(&read: (&Text) -> u64, size: u64): Result(u64, Text) {
  handle { budget(steps: 1000) {
    Ok(sum_text((&text) => read(&text), size))
  } } with { exceeded(info), k => Err("exhausted") }
}

perform show("direct-sum", r#direct(&(i) => (i + 1) * 10, 3))
perform show("direct-exhausted", r#direct(&(i) => (i + 1) * 10, 10000))
perform show("direct_loop-sum", direct_loop(&(i) => (i + 1) * 10, 3))
perform show("direct_loop-exhausted", direct_loop(&(i) => (i + 1) * 10, 10000))
perform show("nested-sum", nested(&(i) => (i + 1) * 10, 3))
perform show("nested-exhausted", nested(&(i) => (i + 1) * 10, 10000))
perform show("text_direct-sum", text_direct((&text) => Text::len(text), 3))
perform show("text_direct-exhausted", text_direct((&text) => Text::len(text), 10000))
perform show("text_forwarded-sum", text_forwarded((&text) => Text::len(text), 3))
perform show("text_forwarded-exhausted", text_forwarded((&text) => Text::len(text), 10000))
perform show("text_owned-sum", text_owned((&text) => Text::len(text), 3))
perform show("text_owned-exhausted", text_owned((&text) => Text::len(text), 10000))
```
shows = ["direct-sum = Ok(60)", "direct-exhausted = Err(\"exhausted\")", "direct_loop-sum = Ok(60)", "direct_loop-exhausted = Err(\"exhausted\")", "nested-sum = Ok(60)", "nested-exhausted = Err(\"exhausted\")", "text_direct-sum = Ok(30)", "text_direct-exhausted = Err(\"exhausted\")", "text_forwarded-sum = Ok(30)", "text_forwarded-exhausted = Err(\"exhausted\")", "text_owned-sum = Ok(30)", "text_owned-exhausted = Err(\"exhausted\")"]
