theorem identity_zero(): identity(Zero) = Zero { Refl }
fn checked_value(n: u64): u64 { U64::of_nat(identity(Nat::of_u64(n))) }
fn add_one(n: i64): i64 { n + 1 }
fn shouted(t: &Text): Text { upper(&t) }
```
