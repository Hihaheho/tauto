llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Array::of_list` yet"
source = ```tauto


fn names(callback: u64, arg0: &((u64) -> u64 ! {overflow})): u64 ! {overflow} { arg0(callback) }
fn apply(f: &((u64) -> u64 ! {overflow}), value: u64): u64 ! {overflow} { f(value) }
fn read_first(f: &((u64) -> u64 ! {overflow})): u64 ! {overflow} { f(0) }
fn read_if(f: &((u64) -> u64 ! {overflow}), enabled: Bool): u64 ! {overflow} { if enabled { f(0) } else { 0 } }
fn twice(f: &((u64) -> u64 ! {overflow}), value: u64): u64 ! {overflow} { f(value) + f(value) }
fn both(left: &((u64) -> u64 ! {overflow}), right: &((u64, u64) -> u64 ! {overflow})): u64 ! {overflow} { right(left(0), left(1)) }
fn produce(f: &(() -> u64 ! {overflow})): u64 ! {overflow} { f() }
fn notify(f: &(() -> Unit ! {overflow}), value: u64): u64 ! {overflow} { f(); value }
fn text_value(f: &((Option(Text)) -> Option(Text) ! {overflow}), value: Option(Text)): Option(Text) ! {overflow} { f(value) }
fn borrow_text(f: &((&Text) -> Text ! {overflow}), value: &Text): Text ! {overflow} { f(&value) }

let values := Array::of_list(Cons(10, Cons(20, Cons(30, Nil))))
let read := (index: u64) => match Array::get(values, index) { Some(value) => value, None => 0 }
show(&names(1, read))
show(&apply(read, 1))
show(&apply(read, 2))
show(&twice(read, 0))
show(&both(read, (a, b) => a + b))
var calls: u64 := 0
let lazy := (index: u64) => { calls := calls + 1; read(index) }
show(&read_if(lazy, false))
show(&calls)
show(&read_first(lazy))
show(&calls)
show(&produce(() => 20))
show(&notify(() => #(), 1))
show(&text_value((value) => value, Some("日本語")))
show(&text_value((value) => value, None))
