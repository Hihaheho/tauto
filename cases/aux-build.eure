source = ```tauto


fn sum(read: &((u64) -> u64 ! {overflow}), size: u64): u64 ! {div, overflow} {
  var i: u64 := 0
  var total: u64 := 0
  while i < size {
    total := total + read(i)
    i := i + 1
  }
  total
}

fn run(read: &((u64) -> u64 ! {overflow}), size: u64): Result(u64, Text) ! {budget} {
  handle {
    perform budget(1000, () => {
      Ok(sum((i) => read(i), size))
    })
  } with {
    exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted")
  }
}

fn run_array(values: Array(u64)): Result(u64, Text) ! {budget} {
  handle {
    perform budget(1000, () => {
      Ok(sum(
        (i) => match Array::get(values, i) {
          None => 0,
          Some(v) => v
        },
        Array::len(values)
      ))
    })
  } with {
    exceeded(info), k => Err("exhausted"), overflow() => Err("exhausted")
  }
}

var calls: u64 := 0
let read := (index: u64) => { calls := calls + 1; (index + 1) * 10 }
show(&run(read, 0))
show(&calls)
show(&run(read, 3))
show(&calls)
calls := 0
show(&run(read, 10000))
show(&(calls > 0 && calls < 10000))
show(&run(read, 3))
show(&run_array(Array::of_list(Nil)))
show(&run_array(Array::of_list(Cons(10, Cons(20, Cons(30, Nil))))))
var items := Vec::new()
var index: u64 := 0
while index < 10000 { Vec::push(&mut items, 1); index := index + 1 }
show(&run_array(Vec::into_array(items)))
```
