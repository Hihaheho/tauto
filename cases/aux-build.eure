checks."Valid" = "error: `missing_predicate` is not defined"
checks."box_zero" = "error: uses `Valid`, which did not check; what follows may come from that: cannot infer the generic `A` of `Eq::Refl`: neither its arguments nor the expected type fix it; write them by name, `Eq::Refl(<A: …, a: …>, …)`"

