// A product written as an effect's argument is the instance a `perform` of a
// tuple infers: `fail(Text × i64)` is the `fail` of `Pair(Text, i64)`.
@ cases.a-product-argument-of-an-effect-is-the-pair-it-names
llvm.unimplemented = "generate: the LLVM backend does not write the operation `fail@Pair(Text,i64)` yet"
source = ```nib
fn g(): i64 ! {fail(Text × i64)} { perform fail(#("a", 2)) }
fn h(): i64 ! {fail(Text × Text × Text)} { perform fail(#("a", "b", "c")) }
let r: Result(i64, Text × i64) := catch(() => g())
let s: Result(i64, Text × Text × Text) := catch(() => h())
show(&(match r {
  Ok(_) => "ok"
  Err(#(t, n)) => t
}))
show(&(match s {
  Ok(_) => "ok"
  Err(#(a, b, c)) => c
}))
```
types = "ok"
stdout = "\"a\"\n\"c\"\n"

// `fail(E)` is an effect for each `E`: each `catch` takes the one its result
// says.
@ cases.catch-takes-the-fail-its-result-names
llvm.unimplemented = "generate: the LLVM backend does not write the operation `fail@main::IoError` yet"
source = ```nib
struct IoError { code: i64 }
fn read(): i64 ! {fail(IoError)} { perform fail(IoError { code: 7 }) }
fn parse(): i64 ! {fail(Text)} { perform fail("bad") }
fn both(): i64 ! {fail(IoError), fail(Text), overflow} { read() + parse() }
let r: Result(Result(i64, Text), IoError) := catch(() => catch(() => both()))
let shown := match r {
  Ok(inner) => match inner {
    Ok(v) => "ok"
    Err(t) => t
  }
  Err(e) => "io"
}
show(&shown)
```
types = "ok"
stdout = "\"io\"\n"

@ cases.a-catch-whose-fail-is-not-known-is-an-error
source = ```nib
