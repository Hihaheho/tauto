@ cases.a-field-that-performs-two-instances-does-not-choose-one
source = ```nib
effect wait<A>(a: A): i64
struct(shared) Pos { x: i64 }
struct(shared) Vel { v: i64 }
fn at(p: Pos): i64 ! {wait(Pos)} { perform wait(p) }
fn speed(v: Vel): i64 ! {wait(Vel)} { perform wait(v) }
struct Opts(R: Shared) { run: () -> i64 ! {wait(R)} }
fn drive<R: Shared>(o: Opts(R)): i64 {
  handle { (o.run)() } with {
    wait<R>(a), k => k(1)
    return v => v
  }
}
fn go(): i64 { drive(Opts { run: () => at(Pos { x: 1 }) + speed(Vel { v: 2 }) }) }
```
types = "error: `drive` indexes an effect by `R`: the argument performs it as Pos and Vel; write which with the result's type"

