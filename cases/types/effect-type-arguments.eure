// `perform e(<T: A>, x)` writes the instance at the `perform`: a callback's
// row does not tell it, and the written one is the instance wherever the
// `perform` stands.
@ cases.a-perform-names-its-type-arguments-in-a-callback
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
effect take<T>(n: i64): T
fn sum(): Unit ! {take(i64), take(Text)} {
  each(Cons(1, Cons(2, Nil)), (n: i64) => {
    let a := perform take(<T: i64>, n)
    let b := perform take(<T: Text>, a)
  })
}
handle { sum() } with {
  take<i64>(n), k => { show(&n); k(n + 10) }
  take<Text>(n), k => { show(&n); k("t") }
}
```
types = "ok"
stdout = "1\n11\n2\n12\n"

