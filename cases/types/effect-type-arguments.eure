// A generic that only a field's row of a parameter's data type writes as an
// index is read from what that field of the record built at the call
// performs, as `catch`'s `E` is read from what its body fails with. The
// result's type and the instance waited on are separate generics.
@ cases.a-field-of-a-parameters-data-type-reads-the-index-from-what-it-performs
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```nib
effect wait<A>(a: A): i64
struct(shared) Pos { x: i64 }
fn at(p: Pos): i64 ! {wait(Pos)} { perform wait(p) }
struct Opts(B: Shared, R: Shared) { run: () -> B ! {wait(R)}, done: (b: B) -> Unit }
fn drive<B: Shared, R: Shared>(o: Opts(B, R)): B {
  let b := handle { (o.run)() } with {
    wait<R>(a), k => k(1)
    return v => v
  }
  (o.done)(b)
  b
}
fn go(): Text {
  drive(Opts { run: () => if at(Pos { x: 1 }) == 1 { "one" } else { "other" }, done: b => #() })
}
show(&go())
```
types = "ok"
rows = "ok"
stdout = "\"one\"\n"

