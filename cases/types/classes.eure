@ cases.a-type-applied-to-a-function-type-does-not-get-a-derived-debug
source = ```tauto
struct Q(T: Shared) { same: (T, T) -> Bool, pick: Option((T) -> T) }
fn mk(): Q(u64) { Q { same: (a: u64, b: u64) => a == b, pick: Some((a: u64) => U64::wrapping_add(a, 1)) } }
fn use_it(q: Q(u64)): Bool {
  let same := q.same
  match q.pick {
    Some(p) => same(p(1), 2)
    None => false
  }
}
show(&use_it(mk()))
```
types = "ok"
stdout = "true\n"

@ cases.class-method-where
source = ```nib
class D(H: Type) { fn put(h: H, w: i64): H }
class C(A: Type) { fn feed<H>(a: &A, h: H): H where D(H) }
struct S { v: i64 }
instance D(S) { fn put(h: S, w: i64): S { S { v: w } } }
instance C(i64) { fn feed<H>(a: &i64, h: H): H where D(H) { D::put(h, a) } }
let s: S := C::feed(&7, S { v: 0 })
show(&s.v)
```
stdout = "7\n"

