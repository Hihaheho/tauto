// Classes and instances. The standard library's classes come with
// the library; these declare their own.

@ cases.class-call
source = ```nib
class Ord<A: linear> {
  fn compare(&a: A, &b: A) -> i64
}
instance Ord(i64) {
  fn compare(&a: i64, &b: i64) -> i64 { if a < b { 0 } else { 1 } }
}
Ord.compare(&1, &2)
```
types = "ok"

@ cases.class-nested-instance
source = ```nib
class Ord<A: linear> {
  fn compare(&a: A, &b: A) -> i64
}
instance Ord(i64) {
  fn compare(&a: i64, &b: i64) -> i64 { if a < b { 0 } else { 1 } }
}
instance<A> Ord(List(A)) where Ord(A) {
  fn compare(&a: List(A), &b: List(A)) -> i64 {
    match a {
      Nil => 0
      Cons(x, xs) => match b {
        Nil => 1
        Cons(y, ys) => Ord.compare(&x, &y)
      }
    }
  }
}
Ord.compare(&Cons(1, Nil), &Cons(2, Nil))
```
types = "ok"

@ cases.class-missing-instance
source = ```nib
class Ord<A: linear> {
  fn compare(&a: A, &b: A) -> i64
}
fn f(x: i64) -> i64 { x }
Ord.compare(&f, &f)
```
types = "error: no instance Ord((i64) -> i64)"

@ cases.class-missing-context
source = ```nib
class Ord<A: linear> {
