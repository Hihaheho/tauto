@ cases.law-effectful-method
source = ```nib
effect ask: () -> i64
class C<A> {
  fn m(&a: A) -> () ! {ask}
  law l<a: A>(): Eq(i64, 1, 1)
}
```
types = "error: C.m performs effects, so C cannot have laws"

@ cases.law-in-a-class-without-effects-is-fine
source = ```nib
class C<A> {
  fn m(&a: A) -> i64
  law l<a: A>(): Eq(i64, 1, 1)
}
instance C(i64) {
  fn m(&a: i64) -> i64 { a }
  law l<a: i64>(): Eq(i64, 1, 1) { refl() }
}
```
types = "ok"

