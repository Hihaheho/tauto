// Classes and instances. The standard library's classes come with
// the library; these declare their own.

@ cases.class-call
source = ```nib
class Ord(A: Linear) {
  fn compare(&a: A, &b: A): i64
}
instance Ord(i64) {
  fn compare(&a: i64, &b: i64): i64 { if a < b { 0 } else { 1 } }
}
Ord::compare(&1, &2)
```
types = "ok"

@ cases.class-nested-instance
source = ```nib
class Ord(A: Linear) {
  fn compare(&a: A, &b: A): i64
}
instance Ord(i64) {
  fn compare(&a: i64, &b: i64): i64 { if a < b { 0 } else { 1 } }
}
instance<A> Ord(List(A)) where Ord(A) {
  fn compare(&a: List(A), &b: List(A)): i64 {
    match a {
      Nil => 0
      Cons(x, xs) => match b {
        Nil => 1
        Cons(y, ys) => Ord::compare(&x, &y)
      }
    }
  }
}
Ord::compare(&Cons(1, Nil), &Cons(2, Nil))
```
types = "ok"

@ cases.class-missing-instance
source = ```nib
class Ord(A: Linear) {
  fn compare(&a: A, &b: A): i64
}
fn f(x: i64): i64 { x }
Ord::compare(&f, &f)
```
types = "error: no instance main::Ord((i64) -> i64)"

@ cases.class-missing-context
source = ```nib
class Ord(A: Linear) {
  fn compare(&a: A, &b: A): i64
}
fn m<A>(&a: A, &b: A): i64 { Ord::compare(&a, &b) }
```
types = "error: main::Ord::compare needs main::Ord(A): add where main::Ord(A)"

@ cases.class-with-context
source = ```nib
class Ord(A: Linear) {
  fn compare(&a: A, &b: A): i64
}
fn m<A>(&a: A, &b: A): i64 where Ord(A) { Ord::compare(&a, &b) }
```
types = "ok"

@ cases.class-overlap
source = ```nib
class C(A: Type) { fn m(&a: A): i64 }
struct P { x: i64 }
instance C(P) { fn m(&a: P): i64 { 1 } }
instance C(P) { fn m(&a: P): i64 { 2 } }
```
types = "error: C already has an instance for P"

@ cases.class-head-repeated-generic
source = ```nib
