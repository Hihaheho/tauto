@ cases.class-overlap
source = ```nib
class C<A> { fn m(&a: A) -> i64 }
struct P { x: i64 }
instance C(P) { fn m(&a: P) -> i64 { 1 } }
instance C(P) { fn m(&a: P) -> i64 { 2 } }
```
types = "error: C already has an instance for P"

@ cases.class-head-repeated-generic
