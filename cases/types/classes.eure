@ cases.class-method-no-borrow-generic
description = "A class method's own type parameter keeps its `NoBorrow` in the class's dictionary: a generic caller with the same bound passes its `F(T)` and gets its `T` back."
source = ```tauto
pub(open) struct(shared) Box(T: Shared + NoBorrow) { v: T }
pub class Readable(F: (Shared) -> Shared) { fn read<T: Shared + NoBorrow>(s: F(T)): T }
instance Readable(Box) { fn read<T: Shared + NoBorrow>(s: Box(T)): T { s.v } }
pub fn get<F: (Shared) -> Shared, T: Shared + NoBorrow>(s: F(T)): T where Readable(F) { Readable::read(s) }
show(&get(Box { v: 1 }))
```
stdout = "1\n"

@ cases.class-parameter-no-borrow
description = "A class parameter takes no `NoBorrow`: one error says so, and the class's uses are still read as uses of a class."
source = ```tauto
pub class C(A: Shared + NoBorrow) { fn f(a: A): A }
instance C(i64) { fn f(a: i64): i64 { a } }
pub fn g<A: Shared + NoBorrow>(a: A): A where C(A) { C::f(a) }
```
types = "error: the parameter of class C cannot be bounded by NoBorrow"
