@ cases.two-arg-class-decl-instance-and-call
description = "A class of two type parameters declares, instances, and resolves at both arguments."
source = ```nib
class Convert(A: Type, B: Type) { fn convert(value: A): B }
instance Convert(i64, Bool) { fn convert(value: i64): Bool { true } }
instance Convert(i64, i64) { fn convert(value: i64): i64 { value } }
fn to_bool(value: i64): Bool { Convert::convert(value) }
fn to_same(value: i64): i64 { Convert::convert(value) }
fn under_where<A, B>(value: A): B where Convert(A, B) { Convert::convert(value) }
fn via_where(value: i64): Bool { under_where(value) }
show(&to_bool(7))
show(&to_same(9))
show(&via_where(3))
```
stdout = ```
true
9
true
```

