@ cases.float-key-is-rejected
description = "A map key needs `Key`; `Float` has none."
entry = "main.taut"
files."main.taut" = ```tauto
import std::indexed_map { IndexedMap }
fn put(k: Float): Unit {
  var m := IndexedMap::new()
  let _r := IndexedMap::insert(&mut m, k, 1)
}
```
check_errors = ["no instance Key(Float)"]

@ cases.function-key-is-rejected
description = "A function is not a map key: it has no `Key`."
entry = "main.taut"
files."main.taut" = ```tauto
import std::indexed_map { IndexedMap }
fn f(x: i64): i64 { x }
var m := IndexedMap::new()
let _r := IndexedMap::insert(&mut m, f, 2)
```
check_errors = ["no instance Key((i64) -> i64)"]

