@ cases.law-written-twice
source = ```nib
class C(A: Type) {
  fn m(&a: A): i64
  theorem l<a: A>(): Eq(i64, 1, 1)
}
instance C(i64) {
  fn m(&a: i64): i64 { a }
  theorem l<a: i64>(): Eq(i64, 1, 1) { Refl }
  theorem l<a: i64>(): Eq(i64, 1, 1) { Refl }
}
```
types = "error: the law l of the instance is written twice"
