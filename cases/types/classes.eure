@ cases.class-method-where-nested-two-deep-runs
source = ```nib
class D(H: Type) { fn put(h: H, w: i64): H }
class F(H: Type) { fn get<G>(h: &H, g: G): G where D(G) }
class C(A: Type) { fn feed<H>(a: &A, h: H, g: H): H where F(H), D(H) }
struct S { v: i64 }
instance D(S) { fn put(h: S, w: i64): S { S { v: w } } }
instance F(S) { fn get<G>(h: &S, g: G): G where D(G) { g } }
instance C(i64) { fn feed<H>(a: &i64, h: H, g: H): H where F(H), D(H) { F::get(&h, g) } }
let s: S := C::feed(&7, S { v: 3 }, S { v: 4 })
show(&s.v)
```
stdout = "4\n"

