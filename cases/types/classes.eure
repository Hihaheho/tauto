@ cases.law-written-twice
source = ```nib
class C<A> {
  fn m(&a: A) -> i64
  law l<a: A>(): Eq(i64, 1, 1)
}
instance C(i64) {
  fn m(&a: i64) -> i64 { a }
  law l<a: i64>(): Eq(i64, 1, 1) { refl() }
  law l<a: i64>(): Eq(i64, 1, 1) { refl() }
}
```
types = "error: the law l of the instance is written twice"
