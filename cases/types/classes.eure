@ cases.law-effectful-method
source = ```nib
effect ask(): i64
class C(A: Type) {
  fn m(&a: A): Unit ! {ask}
  theorem l<a: A>(): Eq(i64, 1, 1)
}
```
types = "error: C::m performs effects, so C cannot have laws"

@ cases.law-in-a-class-without-effects-is-fine
source = ```nib
