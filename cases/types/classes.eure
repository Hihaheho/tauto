}
instance Functor(Pair(_, i64)) {
  fn map<A: shared, B: shared>(x: Pair(A, i64), f: (A) -> B) -> Pair(B, i64) { x }
}
```
types = "error: an instance head applies a type to distinct generics"

@ cases.hkt-not-an-application
source = ```nib
class Functor<F: (shared) -> shared> {
  fn map<A: shared, B: shared>(x: F(A), f: (A) -> B) -> F(B)
}
instance Functor(List) {
  fn map<A: shared, B: shared>(x: List(A), f: (A) -> B) -> List(B) { Nil }
}
fn double_all<F: (shared) -> shared>(x: F(i64)) -> F(i64) where Functor(F) { x }
double_all(3)
```
types = "error: i64 is not an application of a type constructor"

