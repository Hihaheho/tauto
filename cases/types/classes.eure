// Structural predicates and `where`.

@ cases.eq-on-functions
source = ```nib
fn f(x: i64): i64 { x }
f == f
```
types = "error: == needs PartialEq((i64) -> i64)"

@ cases.eq-on-vec
source = ```nib
var v := Vec::new()
Vec::push(&mut v, 1)
v == v
```
types = "error: == needs PartialEq(Vec(i64))"

@ cases.eq-on-struct
source = ```nib
struct P { x: i64 }
perform show("e", P { x: 1 } == P { x: 1 })
```
shows = ["e = true"]

@ cases.eq-on-struct-with-function
source = ```nib
struct Q { f: (i64) -> i64 }
fn id(x: i64): i64 { x }
let q := Q { f: id }
q == q
```
types = "error: == needs PartialEq(Q)"

@ cases.eq-on-recursive-enum
source = ```nib
enum L { N, C(i64, L) }
C(1, N) == C(1, N)
```
types = "ok"

@ cases.eq-on-generic-unconstrained
source = ```nib
