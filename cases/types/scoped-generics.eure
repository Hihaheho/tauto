@ cases.nested-shadow-own-parameter-and-capture
source = ```tauto
fn outer<A: Shared>(value: A): i64 {
  fn inner<A: Shared>(other: A): i64 {
    let local: A := other
    perform show("captured", value)
    perform show("own", local)
    7
  }
  inner(9)
}
perform show("answer", outer("text"))
```
types = "ok"
lin = "ok"
shows = ['captured = "text"', 'own = 9', 'answer = 7']

