@ cases.generic-named-borrowed-affine-capture-can-be-read-repeatedly
source = ```tauto
import std::prelude::Affine

fn outer(&value: Buf): Unit {
  fn read<A: Shared>(marker: A): Text {
    let local: A := marker
    Text::of(Buf::clone(&value))
  }
