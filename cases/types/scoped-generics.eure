@ cases.inferred-local-self-keeps-where-evidence
source = ```tauto
fn outer<A: Shared>(value: A): A where DecEq(A) {
  fn repeat<A: Shared>(other: A, again: Bool) where DecEq(A) {
    if again {
      let same := other == other
      repeat(other, false)
    } else { other }
  }
  repeat(value, false)
}
perform show("answer", outer("text"))
```
types = "ok"
shows = ['answer = "text"']

@ cases.inferred-local-self-keeps-constructor-bounds
source = ```tauto
fn outer<F: (Shared) -> Type, A: Shared>(value: F(A)): F(A) {
  fn repeat<F: (Shared) -> Type, A: Shared>(other: F(A), again: Bool) {
    if again { repeat(other, false) } else { other }
  }
  repeat(value, false)
}
```
types = "ok"

@ cases.inferred-local-self-keeps-user-class-evidence
source = ```tauto
class Render(A: Shared) { fn render(value: A): Text }
instance Render(Text) { fn render(value: Text): Text { value } }
fn outer<A: Shared>(value: A): Text where Render(A) {
  fn repeat<A: Shared>(other: A, again: Bool) where Render(A) {
    if again { repeat(other, false) } else { Render::render(other) }
  }
  repeat(value, false)
}
perform show("answer", outer("text"))
```
types = "ok"
shows = ['answer = "text"']

