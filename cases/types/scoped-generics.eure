@ cases.nested-generic-where-is-instantiated-per-call
source = ```tauto
fn outer(): Unit {
  fn same<A: Shared>(left: A, right: A): Bool where DecEq(A) {
    let local: A := left
    local == right
  }
  perform show("number", same(7, 7))
  perform show("text", same("a", "b"))
}
outer()
```
types = "ok"
shows = ['number = true', 'text = false']

@ cases.outer-constraint-does-not-constrain-inner-binder
source = ```tauto
fn outer<A: Shared>(value: A): Unit where DecEq(A) {
  fn inner<A: Shared>(left: A, right: A): Bool {
    let local: A := left
    local == right
  }
}
```
types = "error: == needs PartialEq(A): add where PartialEq(A)"

@ cases.nested-generic-dictionaries-follow-their-binders
source = ```tauto
class Render(A: Shared) { fn render(value: A): Text }
instance Render(i64) { fn render(value: i64): Text { "number" } }
instance Render(Text) { fn render(value: Text): Text { value } }
fn outer<A: Shared>(value: A): Text where Render(A) {
  fn inner<A: Shared>(item: A): Text where Render(A) {
    let local: A := item
    Render::render(local)
  }
  inner(value)
}
perform show("first", outer(7))
perform show("second", outer("text"))
```
types = "ok"
shows = ['first = "number"', 'second = "text"']

@ cases.inner-dictionary-does-not-constrain-captured-outer-binder
source = ```tauto
class Render(A: Shared) { fn render(value: A): Text }
fn outer<A: Shared>(value: A): Unit where Render(A) {
  fn inner<A: Shared>(item: A): Text where Render(A) {
    Render::render(value)
  }
}
```
types = "error: Render::render needs Render(A): add where Render(A)"

