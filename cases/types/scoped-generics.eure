@ cases.generic-named-owned-capture-keeps-declaration-binding
source = ```tauto
import std::prelude::Affine

fn outer(): Text {
  let original := "original"
  let value := Buf::of(&original)
  fn consume<A: Shared>(marker: A): Text { Text::of(value) }
  let shadow := "shadow"
  let value := Buf::of(&shadow)
  consume(7)
}
perform show("answer", outer())
```
types = "ok"
lin = "ok"
shows = ['answer = "original"']


@ cases.recursive-shared-capture-keeps-declaration-binding
source = ```tauto
fn outer(): Text {
  let value := "original"
  fn read(count: i64): Text {
    if count == 0 { value } else {
      let value := "shadow"
      read(count - 1)
    }
  }
  read(1)
}
perform show("answer", outer())
```
types = "ok"
lin = "ok"
rust_shows = ['answer = "original"']
javascript_shows = ['answer = "original"']

