@ cases.nested-generic-affine-capture-is-borrowed
source = ```tauto
import std::prelude::Affine

fn outer(): u64 {
  var values := Vec::new()
  Vec::push(&mut values, 7)
  fn size<A: Shared>(marker: A): u64 {
    let local: A := marker
    Vec::len(&values)
  }
  let first := size("one")
  let second := size(true)
  first + second
}
perform show("size", outer())
```
types = "ok"
lin = "ok"
shows = ['size = 2']

