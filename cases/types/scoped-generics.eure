shows = ['answer = "text"']

@ cases.var-uses-function-type-parameter
source = ```tauto
import std::prelude::Affine

fn collect<A: Shared>(first: A, second: A): List(A) {
  var values: Vec(A) := Vec::new()
  Vec::push(&mut values, first)
  Vec::push(&mut values, second)
  Vec::into_list(values)
}
perform show("items", collect("a", "b"))
```
types = "ok"
shows = ['items = Cons("a", Cons("b", Nil))']

@ cases.var-reassignment-keeps-function-type-parameter
