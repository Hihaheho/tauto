@ cases.generic-union-results-use-the-callers-representation
source = ```tauto
fn choose<B: Shared, A: Shared>(first: B, second: A, pick: Bool): (B | A) {
  if pick { first } else { second }
}
perform show("left", choose("known", 7, true))
perform show("right", choose("known", 7, false))
let alias := choose
perform show("alias", alias("other", 8, false))
```
types = "ok"
shows = ['left = "known"', 'right = 7', 'alias = 8']

@ cases.local-generic-union-alias-keeps-authoritative-type-arguments
source = ```tauto
fn outer(): Text {
  fn observe<B: Shared, A: Shared>(known: B, input: B | A): B { known }
  let alias := observe
  let number: i64 := 7
  let input := if true { number } else { "unseen" }
  alias("known", input)
}
perform show("answer", outer())
```
types = "ok"
shows = ['answer = "known"']

@ cases.generic-union-collapsed-members-cross-the-abi
source = ```tauto
fn choose<B: Shared, A: Shared>(first: B, second: A, pick: Bool): (B | A) {
  if pick { first } else { second }
}
fn observe<B: Shared, A: Shared>(known: B, witness: A, input: B | A): B { known }
perform show("left", choose("left", "right", true))
perform show("right", choose("left", "right", false))
perform show("answer", observe("known", "witness", "input"))
```
types = "ok"
shows = ['left = "left"', 'right = "right"', 'answer = "known"']

@ cases.generic-union-abi-keeps-caller-and-callee-parameters-distinct
source = ```tauto
fn outer<A: Shared, B: Shared>(left: A, right: B): (A | B) {
  fn choose<B: Shared, A: Shared>(first: B, second: A): (B | A) {
    if true { first } else { second }
  }
  choose(left, right)
}
perform show("answer", outer("known", 7))
```
types = "ok"
shows = ['answer = "known"']

@ cases.captured-generic-union-alias-adapts-arguments-and-results
source = ```tauto
fn outer<C: Shared>(captured: C): Unit {
  fn choose<B: Shared, A: Shared>(known: B, witness: A, input: B | A, first: Bool): (B | A) {
    perform show("captured", captured)
    if first { known } else { input }
  }
  let alias := choose
  let number: i64 := 7
  let input := if true { number } else { "unseen" }
  perform show("direct", choose("known", number, input, false))
  perform show("alias", alias("known", number, input, true))
}
outer("kept")
```
types = "ok"
shows = ['captured = "kept"', 'direct = 7', 'captured = "kept"', 'alias = "known"']


@ cases.generic-union-forwarding-and-catch-keep-inferred-instantiations
source = ```tauto
fn forward<T: Shared>(value: T): T ! {} { value }
fn choose(flag: Bool): (i64 | Text) ! {fail(Text)} {
  let result: Result(i64, Text) := if flag { Ok(7) } else { Err("stopped") }
  let number := raise(result)
  if flag { number } else { "unseen" }
}
let value := if true { 7 } else { "kept" }
perform show("forward", forward(value))
perform show("ok", catch(() => choose(true)))
perform show("bad", catch(() => choose(false)))
```
types = "ok"
shows = ['forward = 7', 'ok = Ok(7)', 'bad = Err("stopped")']

