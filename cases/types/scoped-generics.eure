@ cases.generic-union-forwarding-and-catch-keep-inferred-instantiations
llvm.unimplemented = "generate: the LLVM backend does not write a union yet"
source = ```tauto
import std::builtin::os
fn say(v: i64 | Text): Unit ! {stdout, stdout_flush} {
  match v {
    t: Text => show(&t)
    n: i64 => show(&n)
  }
}
fn forward<T: Shared>(value: T): T ! {} { value }
fn choose(flag: Bool): (i64 | Text) ! {fail(Text)} {
  let result: Result(i64, Text) := if flag { Ok(7) } else { Err("stopped") }
  let number := raise(result)
  if flag { number } else { "unseen" }
}
let value := if true { 7 } else { "kept" }
say(forward(value))
let caught_true: Result(i64 | Text, Text) := catch(() => choose(true))
match caught_true {
  Ok(v) => say(v)
  Err(e) => show(&e)
}
let caught_false: Result(i64 | Text, Text) := catch(() => choose(false))
match caught_false {
  Ok(v) => say(v)
  Err(e) => show(&e)
}
```
types = "ok"
stdout = "7\n7\n\"stopped\"\n"

