// Syntax literals.

@ cases.untagged-backtick-text-needs-the-syntax-name
source = "let a = `abc`"
types = "error: a syntax literal needs the syntax's name"

@ cases.plaintext-literal-is-text
source = "let a = plaintext`abc`"
types = "ok"

@ cases.unknown-syntax-is-an-error
source = "let a = nosuch`abc`"
types = "error: `nosuch` is not a syntax"
