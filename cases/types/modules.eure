// A function declared with a `T::` prefix is called by its full name.

@ cases.prefixed-call
source = ```nib
fn M::one(): i64 { 1 }
show(&M::one())
```
stdout = "1\n"

@ cases.prefixed-name-is-not-short
source = ```nib
fn M::one(): i64 { 1 }
one()
```
types = "error: one is not defined"

@ cases.prefix-and-type-same-name
source = ```nib
struct P { x: i64 }
fn P::mk(): i64 { 1 }
P::mk()
```
types = "ok"

@ cases.prefix-may-be-any-capitalized-name
source = ```nib
fn Tac::intro(): i64 { 1 }
show(&Tac::intro())
```
stdout = "1\n"

@ cases.nested-prefix
source = ```nib
fn A::B::f(): i64 { 1 }
A::B::f()
```
types = "ok"

@ cases.prefixed-function-argument-shadow
source = ```nib
fn M::f(): i64 { 1 }
fn M::g(f: () -> i64): i64 { f() }
show(&M::g(() => 42))
```
stdout = "42\n"

@ cases.prefixed-local-binding-shadow
source = ```nib
fn M::f(): i64 { 1 }
fn M::g(): i64 ! {overflow} {
  let f := M::f() + 41
  f
}
show(&M::g())
```
stdout = "42\n"

@ cases.prefixed-same-short-name-as-top-level
source = ```nib
fn f(): i64 { 1 }
fn M::f(): i64 { 2 }
fn M::g(): i64 { M::f() }
show(&(M::g() + f()))
```
stdout = "3\n"

@ cases.imported-constructor-named-like-a-prelude-module
files."state.taut" = ```taut
pub(open) enum State { Pending, Done }
```
files."main.taut" = ```taut
import "state.taut"
fn label(s: State): Text { match s { Pending => "pending", Done => "done" } }
show(&label(Pending))
```
entry = "main.taut"
stdout = ```
"pending"
```

@ cases.self-module-import
files."a.taut" = ```taut
import self::b { two }
pub fn three(): i64 ! {overflow} { two() + 1 }
```
files."a/b.taut" = ```taut
import self::c { one }
pub fn two(): i64 ! {overflow} { one() + 1 }
```
files."a/b/c.taut" = ```taut
pub fn one(): i64 { 1 }
```
files."main.taut" = ```taut
import "a.taut" { three }
show(&three())
```
entry = "main.taut"
stdout = "3\n"
