// A bound written on an operation's generic is checked where it is performed.
@ cases.an-operation-bound-is-checked-at-the-perform
source = ```nib
struct(affine) Tok { n: i64 }
effect dup<A: Shared>(v: &A): A
let t := Tok { n: 1 }
let r := handle { perform dup(&t) } with { ∀ A. dup<A>(v), k => k(v) }
```
types = "error: affine does not fit shared: Tok for a type parameter"

// An arm for every instance may use a value as the bound lets it.
@ cases.an-arm-for-every-instance-keeps-the-operation-bound
source = ```nib
effect twice<A: Shared>(v: A): A × A
let r := handle { perform twice(3) } with { ∀ A. twice<A>(v), k => k(#(v, v)) }
show(&r.fst)
```
types = "ok"
stdout = "3\n"

// Without a bound, the arm's generic is affine: it cannot be copied.
@ cases.an-arm-for-every-instance-without-a-bound-cannot-copy
source = ```nib
effect twice<A>(v: A): A × A
let r := handle { perform twice(3) } with { ∀ A. twice<A>(v), k => k(#(v, v)) }
show(&r.fst)
```
lin = "error: v is used after move"
