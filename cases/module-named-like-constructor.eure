description = "A module's functions keep their own names where another file of the program has a constructor of the module's name."

// `escape.taut` has a constructor `Digit`, so the type `Digit` of
// `status.taut` is told apart by its full name. `Digit::value_zero` that
// `status.taut` writes is still the theorem of its own `module Digit`, though
// `status.taut` does not import `escape.taut` and the program expands macros
// (`std::NatDiv` has them).
@ cases.a-module-function-is-not-renamed-with-its-type
entry = "src/main.taut"
files."src/escape.taut" = ```tauto
pub(open) inductive Escape: Type {
  Plain: Escape
  Percent: Escape
  Digit(h: Nat): Escape
}
pub fn unescaped(n: Nat): Nat { n }
```
files."src/status.taut" = ```tauto
pub(open) inductive Digit: Type {
  D0: Digit
}
pub(open) inductive Status: Type {
  Mk(d: Digit): Status
}
module Digit {
  pub fn value(d: Digit): Nat { 0 }
  pub theorem value_zero(d: Digit): Digit::value(d) = 0 {
    ⊢ Digit::value(d) = 0 from match d {
      D0 => Refl
    }
  }
}
module Status {
  pub fn value(s: Status): Nat {
    ⊢ Nat from match s {
      Mk(d) => Digit::value(d)
    }
  }
  pub theorem value_zero(s: Status): Status::value(s) = 0 {
    ⊢ Status::value(s) = 0 from match s {
      Mk(d) => Digit::value_zero(d)
    }
  }
}
```
files."src/http.taut" = ```tauto
import "status.taut" { Status }
pub fn same(s: Status): Status { s }
```
files."src/percent.taut" = ```tauto
import "escape.taut" { unescaped }
pub fn zero(): Nat { unescaped(0) }
```
files."src/main.taut" = ```tauto
import std::NatDiv
import "http.taut"
import "percent.taut"
```
checks."Digit::value_zero" = "ok"
checks."Status::value_zero" = "ok"

// `percent.taut` imports the dependency's `escape` with a list that does not
// write `Escape`, whose constructor `Percent` has the name of the file's own
// `module Percent`: `Percent::encoded_id` is the module's theorem.
@ cases.a-local-module-wins-over-an-unlisted-constructor
files_tote = "app"
files."app/Tauto.eure" = ```eure
package { name = "app" }
dependencies { lib { path = "../lib" } }
```
files."lib/Tauto.eure" = 'package { name = "lib" }'
files."lib/src/escape.taut" = ```tauto
pub(open) inductive Escape: Type {
  Plain: Escape
  Percent: Escape
}
pub fn unescaped(n: Nat): Nat { n }
```
files."app/src/percent.taut" = ```tauto
import lib::escape { unescaped }
module Percent {
  pub fn encoded(n: Nat): Nat { unescaped(n) }
}
module Percent {
  theorem encoded_id(n: Nat): Percent::encoded(n) = n { Refl }
}
module Percent {
  pub theorem zero_encoded(): Percent::encoded(0) = 0 { Percent::encoded_id(0) }
}
```
files."app/src/main.taut" = ```tauto
import "percent.taut"
```
checks."Percent::encoded_id" = "ok"
checks."Percent::zero_encoded" = "ok"
