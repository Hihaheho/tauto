@ cases.a-value-of-an-rc-pool-leaves-the-function
llvm.unimplemented = "generate: the LLVM backend does not write a `RcPlace` yet"
description = "A place of an `RcPool` borrows nothing, so the value may leave, and values of an `RcBump` and an `RcPool` meet outside."

source = ```tauto
import std::bump
import std::pool
import std::builtin::region { RcPlaced, RcPlace, rc_place }

struct Node { v: u64 }
fn pooled(): RcPlaced(Node) {
  let a := RcPool::new(64, 4)
  handle { RcPlaced::new(Node { v: 7 }) } with { rc_place<Node>(), k => k(RcPool::place(a)) }
}
fn bumped(): RcPlaced(Node) {
  let a := RcBump::new(64, 64)
  handle { RcPlaced::new(Node { v: 8 }) } with { rc_place<Node>(), k => k(RcBump::place(a)) }
}
show(&(pooled().v + bumped().v))
```
stdout = "15\n"

@ cases.a-value-of-a-pool-does-not-leave-it
description = "A placed value borrows its `Pool`, so a function cannot return one of its own."

extract = true
source = ```tauto
import std::pool
import std::builtin::region { Placed, place }

struct Node { v: u64 }
fn bad(): Placed(Node) {
  let a := Pool::new(64, 4)
  handle { Placed::new(Node { v: 1 }) } with { place<Node>(), k => k(Pool::place(&a)) }
}
```
lin = "error: a borrow of a cannot be returned: the value borrows it through place(Node), whose handle answers with it"
