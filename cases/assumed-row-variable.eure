// A row variable that a parameter carries only inside a callback's own
// parameter, `run: (() -> i64 ! e) -> …`, is one the argument assumes and
// no argument supplies. The callee hands `run` thunks of row `e` for every
// `e`, so a call instantiates it with the empty row, and every backend
// specializes it to the synchronous tier.
@ cases.assumed-row-variable-runs
source = ```tauto
import std::builtin::os

effect ask(): i64

fn twice<!e, !h>(run: (() -> i64 ! e) -> i64 ! h, x: i64): i64 ! {overflow} ∪ h {
  let y := x + 1
  run(() => x) + run(() => y)
}

fn asked(): i64 ! {ask, overflow} {
  twice((k) => k() + perform ask(), 3)
}

print(Text::of_i64(handle { asked() } with {
  ask(), k => k(10)
  return v => v
}))
```
stdout = "27"

// Thunks of row `e` are made for every `e`: one that performs anything is
// not one of them.
@ cases.assumed-row-variable-thunk-must-not-perform
source = ```tauto
effect ask(): i64
fn sneaky<!e, !h>(run: (() -> i64 ! e) -> i64 ! h): i64 ! h { run(() => perform ask()) }
print(Text::of_i64(sneaky((k) => k())))
```
rows = "error: a function value may perform ask but its type permits {|e}"

// What the callback performs is still its caller's.
@ cases.assumed-row-variable-keeps-the-callback-row
source = ```tauto
effect ask(): i64
fn twice<!e, !h>(run: (() -> i64 ! e) -> i64 ! h): i64 ! h { run(() => 1) }
fn quiet(): i64 ! {} { twice((k) => k() + perform ask()) }
print(Text::of_i64(quiet()))
```
rows = "error: `quiet` may perform ask but its row is {}"

// A row variable that a direct callback parameter supplies, `b`, may also
// be in a callback's own parameter, `part` of `lift`: the body makes `part`
// at the tier `b` gives the row, and `lift`'s argument is called with it
// whatever it performs itself, here a handled `ask`.
@ cases.assumed-and-supplied-row-variable-runs
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```tauto
import std::builtin::os

effect ask(): i64

fn run_by<!e>(lift: (part: () -> i64 ! e) -> i64 ! {overflow}, b: () -> i64 ! e): i64 ! {div, overflow} {
  let r := lift(() => b())
  match r {
    0 => run_by(lift, b)
    other => other
  }
}

fn by_handler(part: () -> i64 ! {ask}): i64 ! {overflow} {
  handle { part() } with {
    ask(), k => k(10) + 1000
    return v => v
  }
}

print(Text::of_i64(run_by(by_handler, () => 1)))
print(Text::of_i64(run_by(by_handler, () => perform ask())))
```
stdout = "11010"
