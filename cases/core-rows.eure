@ cases.perform-is-in-the-row-and-must-be-written-1
source = ```tauto
effect ask(q: i64): i64
fn f(): i64 ! {ask} { perform ask(1) }
```
rows = "ok"

@ cases.perform-is-in-the-row-and-must-be-written-2
source = ```tauto
