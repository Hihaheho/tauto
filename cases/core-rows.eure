@ cases.loops-and-recursion-diverge-and-budget-bounds-them-1
source = ```tauto
fn spin(): i64 ! {div} { while true { }
 0 }
fn rec(n: i64): i64 ! {div} { rec(n) }
let d := handle { perform budget(10, () => { spin() }) } with {
  exceeded(i), k => 0
  return v => v
}
```
