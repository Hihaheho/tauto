```
rows = "ok"
inferred_rows.g = ["ask"]

@ cases.handle-removes-what-it-answers-1
source = ```tauto
effect ask(q: i64): i64
fn f(): i64 { perform ask(1) }
let r := handle { f() } with {
  ask(q), k => k(q)
  return v => v
}
```
rows = "ok"

