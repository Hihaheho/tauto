@ cases.a-function-a-handle-gives-performs-what-its-arms-do
source = ```tauto
effect get(): i64
effect ping(): ()
fn incr(): i64 ! {get} { perform get() }
fn quiet(): i64 ! {} {
  let run := handle { incr() } with {
    get(), k => (s) => k(s)(s)
    return v => (s) => v
  }
  run(5)
}
fn loud(): i64 ! {} {
  let run := handle { incr() } with {
    get(), k => (s) => { perform ping(); k(s)(s) }
    return v => (s) => v
  }
  run(5)
}
```
rows = "error: `loud` may perform ping but its row is {}"

@ cases.structural-recursion-does-not-perform-div
source = ```tauto
fn len(xs: List(i64)): i64 { match xs {
  Nil => 0
  Cons(x, rest) => len(rest)
} }
fn same(xs: List(i64)): i64 { match xs {
  Nil => 0
  Cons(x, rest) => same(xs)
} }
fn down(n: i64): i64 { if n == 0 { 0 } else { down(n) } }
```
inferred_rows.len = []
inferred_rows.same = ["div"]
inferred_rows.down = ["div"]

@ cases.extracted-nat-recursion-does-not-perform-div
source = ```tauto
fn half(n: u64): u64 ! {overflow} {
  if n == 0 { 0 } else {
    let k := (n - 1)
    if k == 0 { 0 } else {
      let j := (k - 1)
      (half(j) + 1)
    }
  }
}
fn back(n: u64): u64 ! {overflow} { if 0 == n { 0 } else { back(n - 2) } }
fn same(n: u64): u64 ! {div} { if n == 0 { 0 } else { same(n) } }
fn up(n: u64): u64 ! {div, overflow} { if n == 0 { 0 } else { up(n + 1) } }
fn unguarded(n: u64): u64 ! {div, overflow} { if n == 1 { 0 } else { unguarded(n - 1) } }
fn signed(n: i64): i64 ! {div, overflow} { if n == 0 { 0 } else { let k := (n - 1)
 signed(k) } }
fn redone(n: u64): u64 ! {div, overflow} { var m: u64 := n
 if m == 0 { 0 } else { redone(m - 1) } }
fn twice(n: u64): u64 ! {overflow} { (half(n) + half((n + 1))) }
fn apply(f: (u64) -> u64 ! {overflow}, n: u64): u64 ! {overflow} { f(n) }
fn main(): u64 ! {overflow} { apply((c) => twice(c), 3) }
```
rows = "ok"
inferred_rows.half = ["overflow"]
inferred_rows.back = ["overflow"]
inferred_rows.twice = ["overflow"]
inferred_rows.same = ["div"]
inferred_rows.up = ["div", "overflow"]
inferred_rows.unguarded = ["div", "overflow"]
inferred_rows.signed = ["div", "overflow"]
inferred_rows.redone = ["div", "overflow"]

@ cases.mutual-structural-recursion-with-different-arities-does-not-perform-div
source = ```tauto
fn val(f: List(i64), l: i64): i64 { match f {
  Nil => l
  Cons(x, g) => items(g, 1, l)
} }
fn items(f: List(i64), close: i64, l: i64): i64 { match f {
  Nil => close
  Cons(x, g) => val(g, l)
} }
fn stuck(f: List(i64), l: i64): i64 ! {div} { match f {
  Nil => l
  Cons(x, g) => stuck_items(g, 1, l)
} }
fn stuck_items(f: List(i64), close: i64, l: i64): i64 ! {div} { match f {
  Nil => close
  Cons(x, g) => stuck(f, l)
} }
fn apply(k: (i64) -> i64, n: i64): i64 { k(n) }
fn main(): i64 { apply((c) => items(Cons(c, Nil), c, c), 3) }
```
rows = "ok"
inferred_rows.val = []
inferred_rows.items = []
inferred_rows.main = []
inferred_rows.stuck = ["div"]
inferred_rows.stuck_items = ["div"]

@ cases.ascription-does-not-hide-structural-recursion
source = ```tauto
fn walk(xs: List(i64), m: i64): i64 { match xs {
  Nil => m
  Cons(x, rest) => walk((rest: List(i64)), (m: i64))
} }
fn same(xs: List(i64)): i64 ! {div} { match xs {
  Nil => 0
  Cons(x, rest) => same((xs: List(i64)))
} }
fn apply(k: (i64) -> i64, n: i64): i64 { k(n) }
fn main(): i64 { apply((c) => walk(Cons(c, Nil), (c: i64)), 3) }
```
rows = "ok"
inferred_rows.walk = []
inferred_rows.main = []
inferred_rows.same = ["div"]

@ cases.an-effect-the-row-leaves-out-is-written-in-it-1
source = ```tauto
effect ask(q: i64): i64
effect tell(t: i64): Unit
fn f(): i64 ! {tell} { perform tell(1)
  perform ask(1) }
```
@ cases.an-effect-the-row-leaves-out-is-written-in-it-1.diagnostics[]
stage = "rows"
message = "`f` may perform ask but its row is {tell}"
fix = ", ask"
fix_span = ""
fixed_source = ```tauto
effect ask(q: i64): i64
effect tell(t: i64): Unit
fn f(): i64 ! {tell, ask} { perform tell(1)
  perform ask(1) }
```

