@ cases.a_lambda_does_not_capture_a_variable_of_its_expected_type
source = ```tauto
inductive T: Type {
  A: T
  B(x: T): T
}
inductive W: Type {
  Mk(x: T): W
}
fn unw(u: W): T {
  ⊢ T from match u {
    Mk(y) => y
  }
}
theorem cap(x: T, u: W): x = unw(u) {
  W::ind(v => x = unw(v), x => Refl(T, x), u)
}
```
checks."cap" = "error: mismatch"

@ cases.a_pattern_variable_does_not_capture_a_variable_of_the_result
source = ```tauto
inductive T: Type {
  A: T
  B(x: T): T
}
inductive W: Type {
  Mk(x: T): W
}
fn unw(u: W): T {
  ⊢ T from match u {
    Mk(y) => y
  }
}
theorem cap(x: T, u: W): x = unw(u) {
  ⊢ x = unw(u) from match u {
    Mk(x) => Refl(T, x)
  }
}
```
checks."cap" = "error: mismatch"

