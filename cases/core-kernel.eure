@ cases.core_a_deep_wrong_argument_is_rejected_in_linear_steps_1
source = ```tauto
fn pow2(n: Nat): Nat { ⊢ Nat from match n { Zero => 1
 Succ(k) => 2 * pow2(k) } }
fn big(s: Nat): Nat { pow2(s + 400) }
fn is_zero(n: Nat): Bool { ⊢ Bool from match n { Zero => true
 Succ(k) => false } }
fn pos(x: Nat): Prop { is_zero(x) = false }
```
checks."pow2" = "checked"
checks."big" = "checked"
checks."is_zero" = "checked"
