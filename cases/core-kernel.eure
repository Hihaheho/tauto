// A sum whose first operand reduces to another such sum, as deep as the
// number: computed one after another, not one inside another, so the depth
// of the number does not reach the depth of the checker's stack.
@ cases.core_a_deep_chain_of_sums_is_computed_without_nesting
source = ```tauto
fn count(n: Nat): Nat { ⊢ Nat from match n { Zero => 0
 Succ(k) => count(k) + 1 } }
theorem counted(): count(250000) = 250000 { Refl }
```
checks."count" = "checked"
checks."counted" = "checked"

// A sum whose second operand is a sum with a large numeral is that many
// `Succ`s on the sum of the bases; two such sides with different bases are
// found different by their bases, not by taking the `Succ`s off one at a time.
@ cases.core_a_large_offset_inside_the_second_operand_is_taken_at_once
source = ```tauto
theorem t(s: Nat, T: Nat): s * 9223372036854775808 + (T * 4503599627370496 + 9007199254740992) = 9223372036854775808 * s + (4503599627370496 * Succ(Succ(T)) + 0) { Refl }
```
checks."t" = "error: mismatch"

// Two sides that reduce to a long chain of `Succ`s are compared one pair
// below another without the comparison going as deep as the chain.
@ cases.core_a_long_chain_of_succ_is_compared_without_nesting
source = ```tauto
fn up(n: Nat, x: Nat): Nat { ⊢ Nat from match n { Zero => x
 Succ(k) => Succ(up(k, x)) } }
theorem same(x: Nat): up(400000, x) = x + 400000 { Refl }
```
checks."up" = "checked"
checks."same" = "checked"

// A shared borrow is the value it borrows to the kernel: a kernel-checked
// function takes `&T` parameters and is called with `&x`, beside `&mut`
// parameters read as states, and a theorem about it reads the borrow away.
@ cases.core_a_shared_borrow_is_read_as_its_value
source = ```tauto
fn len<A>(xs: &List(A)): Nat {
  ⊢ Nat from match xs {
    Nil => 0
    Cons(h, t) => Succ(len(&t))
  }
}
fn apply<A, B>(f: &(A) -> B, x: A): B { f(x) }
fn same(k: &Nat, k2: Nat): Bool { Nat::eq(k, &k2) }
theorem t(): len(&Cons(1, Nil)) = 1 { Refl }
theorem u(): apply(&((n: Nat) => Succ(n)), 1) = 2 { Refl }
fn add_len<A>(n: &mut Nat, xs: &List(A)): Unit { *n := n + len(xs) }
```
checks."len" = "checked"
checks."apply" = "checked"
checks."same" = "checked"
checks."t" = "checked"
checks."u" = "checked"
checks."add_len" = "checked"

// The body of a λ that borrows its parameter sees the `let`s around it and
// may match, as the body of any λ does: the kernel reads `&` as erased.
@ cases.a_borrowing_lambda_sees_the_lets_around_it
source = ```tauto
inductive N: Type {
  Z: N
  S(n: N): N
}
fn look(g: (&N) -> N, x: N): N { g(x) }
fn outer(x: N): N {
  let k: N := N::S(x)
  look((y: &N) => k, x)
}
fn matched(x: N): N {
  look((y: &N) => match y {
    Z => N::Z
    S(m) => m
  }, x)
}
```
checks."outer" = "checked"
checks."matched" = "checked"

