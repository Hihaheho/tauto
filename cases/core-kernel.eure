// A function on `Nat` that calls itself on the number one less, with its
// other arguments as they were or one less too, comes round to the same call
// after one `Succ`: with a large numeral, or `x + n` for one, in the places
// that go down the kernel takes as many turns at once as the least of them
// has `Succ`s.
// It is any function of that shape, the prelude's or one declared here, and
// what it gives is what unfolding gives.
@ cases.core_a_loop_on_a_large_numeral_is_taken_at_once_1
source = ```tauto
fn below(a: Nat, b: Nat): Bool {
  ⊢ Bool from match b {
    Zero => false
    Succ(b2) => ⊢ Bool from match a {
      Zero => true
      Succ(a2) => below(a2, b2)
    }
  }
}
fn skip(n: Nat): Nat {
  ⊢ Nat from match n {
    Zero => 7
    Succ(k) => skip(k)
  }
}
theorem kept(x: Nat, h: below(x, 5) = true): below(x + 9007199254740992, 9007199254740997) = true { h }
theorem past(x: Nat): below(x + 9007199254740992, 9007199254740990) = false { Refl }
fn carry(n: Nat, d: Nat): Nat {
  ⊢ Nat from match n {
    Zero => d
    Succ(k) => carry(k, d)
  }
}
theorem skipped(): skip(9007199254740992) = 7 { Refl }
theorem carried(): carry(9007199254740992, 9007199254740993) = 9007199254740993 { Refl }
theorem lt(x: Nat, h: Nat::lt(5, x) = true): Nat::lt(9007199254740997, x + 9007199254740992) = true { h }
theorem eq(x: Nat): Nat::eq(x + 9007199254740992, 9007199254740990) = false { Refl }
```
checks_all = "checked"

@ cases.core_a_loop_on_a_large_numeral_is_taken_at_once_2
source = ```tauto
fn below(a: Nat, b: Nat): Bool {
  ⊢ Bool from match b {
    Zero => false
    Succ(b2) => ⊢ Bool from match a {
      Zero => true
      Succ(a2) => below(a2, b2)
    }
  }
}
theorem unknown(x: Nat): below(x + 9007199254740992, 9007199254740997) = true { Refl }
```
checks."below" = "checked"
checks."unknown" = "error: mismatch"

// A function that changes what it carries on each turn does not come round
// to the same call: it is reduced a turn at a time.
@ cases.core_a_loop_that_changes_its_state_is_not_taken_at_once
source = ```tauto
fn flip(b: Bool): Bool {
  ⊢ Bool from match b {
    false => true
    true => false
  }
}
fn parity(n: Nat, b: Bool): Bool {
  ⊢ Bool from match n {
    Zero => b
    Succ(k) => parity(k, flip(b))
  }
}
theorem odd(): parity(5001, false) = true { Refl }
```
checks_all = "checked"

// A reduction that waits for a part of its term (the scrutinee of a
// `match`, the result of the call below it) does not take the checker's
// stack for each one that waits: a number of a declared type is taken apart
// as deep as it is, and so is a function that works on what its own call
// returns.
@ cases.core_a_deep_reduction_does_not_nest_on_the_stack
source = ```tauto
inductive My: Type {
  Z: My
  S(n: My): My
}
fn of_nat(n: Nat): My {
  ⊢ My from match n {
    Zero => Z
    Succ(k) => S(of_nat(k))
  }
}
fn my_pred(n: My): My {
  ⊢ My from match n {
    Z => Z
    S(k) => k
  }
}
fn my_sub(a: My, b: My): My {
  ⊢ My from match b {
    Z => a
    S(k) => my_pred(my_sub(a, k))
  }
}
fn count(n: My): Nat {
  ⊢ Nat from match n {
    Z => 0
    S(k) => Succ(count(k))
  }
}
fn flip(b: Bool): Bool {
  ⊢ Bool from match b {
    false => true
    true => false
  }
}
fn even(n: Nat): Bool {
  ⊢ Bool from match n {
    Zero => true
    Succ(k) => flip(even(k))
  }
}
theorem stuck(x: My, h: my_sub(x, of_nat(200000)) = Z): my_sub(x, of_nat(200000)) = Z { h }
theorem left(): count(my_sub(of_nat(200000), of_nat(199999))) = 1 { Refl }
theorem parity(): even(200000) = true { Refl }
```
checks_all = "checked"

@ cases.mutable_a_lent_place_is_read_after_the_later_arguments
source = ```tauto
fn bump(w: &mut Nat): Nat { *w := Succ(w); Zero }
fn pair(w: &mut Nat, v: Nat): Nat { w }
fn lent(): Nat {
  var w: Nat := Zero
  pair(&mut w, bump(&mut w))
}
fn assigned(): Nat {
  var w: Nat := Zero
  pair(&mut w, { w := Succ(w); Zero })
}
theorem lent_sees_the_write(): lent() = Succ(Zero) { Refl }
theorem assigned_sees_the_write(): assigned() = Succ(Zero) { Refl }
```
checks_all = "checked"

@ cases.mutable_a_shared_borrow_is_not_written_by_a_later_argument
source = ```tauto
fn bump(w: &mut Nat): Nat { *w := Succ(w); Zero }
fn seen(w: &Nat, v: Nat): Nat { w }
fn read_only(): Nat {
  var w: Nat := Zero
  seen(&w, bump(&mut w))
}
```
checks."read_only" = "error: w is borrowed by this call and written by an argument after it; bind that argument with `let` first"
