@ cases.induction_by_a_recursive_theorem_1
source = ```tauto
fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}
theorem plus_zero(n: Nat): plus(n, Zero) = n {
  ⊢ plus(n, Zero) = n from match n {
    Zero => Refl(Nat, Zero)
    Succ(k) => Eq::subst(Nat, plus(k, Zero), k, y => Succ(plus(k, Zero)) = Succ(y), plus_zero(k), Refl(Nat, Succ(plus(k, Zero))))
  }
}
```
