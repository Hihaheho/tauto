inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}

fn bump(&mut c: Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn before(&mut c: Counter): Nat {
  let n := c.n
  bump(&mut c)
  n
}

theorem old(): before(Counter::Mk(Zero, Zero)) = mut1(Zero, Counter::Mk(Succ(Zero), Succ(Zero))) {
  Refl(Mut1(Nat, Counter), mut1(Zero, Counter::Mk(Succ(Zero), Succ(Zero))))
}
```
