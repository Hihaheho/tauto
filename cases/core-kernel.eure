@ cases.add_zero_by_induction_1
source = ```tauto
fn add(n: Nat, m: Nat): Nat {
  Nat::rec(k => Nat, m, k => ih => Succ(ih), n)
}
theorem add_zero(n: Nat): add(n, Zero) = n {
  Nat::ind(
    k => add(k, Zero) = k,
    Refl(Nat, Zero),
    k => ih => Eq::subst(Nat, add(k, Zero), k, y => Succ(add(k, Zero)) = Succ(y), ih, Refl(Nat, Succ(add(k, Zero)))),
    n)
}
```
checks."add_zero" = "checked"

@ cases.add_zero_by_induction_2
source = ```tauto
fn add(n: Nat, m: Nat): Nat {
  Nat::rec(k => Nat, m, k => ih => Succ(ih), n)
}
theorem add_zero(n: Nat): add(n, Zero) = n {
  Nat::ind(
    k => add(k, Zero) = k,
    Refl(Nat, Zero),
    k => ih => Eq::subst(Nat, add(k, Zero), k, y => Succ(add(k, Zero)) = Succ(y), Refl(Nat, Zero), Refl(Nat, Succ(add(k, Zero)))),
    n)
}
```
checks."add_zero" = "error: mismatch"

