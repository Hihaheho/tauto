@ cases.mutable_a_mut_parameter_comes_back_with_the_value
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}

fn bump(&mut c: Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

theorem bumped(): bump(Counter::Mk(Zero, Zero)) = mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Zero))) {
  Refl(Mut1(Nat, Counter), mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Zero))))
}
```
checks_all = "checked"

@ cases.mutable_calls_and_vars_pass_the_state_along
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}

fn bump(&mut c: Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn twice(&mut c: Counter): Nat {
  var last: Nat := bump(&mut c)
  last := bump(&mut c)
  last
}

theorem two(): twice(Counter::Mk(Zero, Zero)) = mut1(Succ(Succ(Zero)), Counter::Mk(Succ(Succ(Zero)), Succ(Succ(Zero)))) {
  Refl(Mut1(Nat, Counter), mut1(Succ(Succ(Zero)), Counter::Mk(Succ(Succ(Zero)), Succ(Succ(Zero)))))
}
```
checks_all = "checked"

@ cases.mutable_a_match_that_changes_the_state_returns_it
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}

fn bump(&mut c: Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn maybe(&mut c: Counter, go: Bool): Nat {
  if go {
    set_to(&mut c.hits, Succ(c.hits))
  }
  match go {
    true => bump(&mut c)
    false => c.n
  }
}

theorem yes_twice(): maybe(Counter::Mk(Zero, Zero), true) = mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Succ(Zero)))) {
  Refl(Mut1(Nat, Counter), mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Succ(Zero)))))
}

theorem no_never(): maybe(Counter::Mk(Zero, Zero), false) = mut1(Zero, Counter::Mk(Zero, Zero)) {
  Refl(Mut1(Nat, Counter), mut1(Zero, Counter::Mk(Zero, Zero)))
}
```
checks_all = "checked"

