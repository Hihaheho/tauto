@ cases.mutable_a_mut_parameter_comes_back_with_the_value
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(slot: &mut A, v: A): Unit {
  *slot := v
}

fn bump(c: &mut Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

theorem bumped(): bump(Counter::Mk(Zero, Zero)) = mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Zero))) {
  Refl(<A: Mut1(Nat, Counter), a: mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Zero)))>)
}
```
checks_all = "checked"

@ cases.mutable_calls_and_vars_pass_the_state_along
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(slot: &mut A, v: A): Unit {
  *slot := v
}

fn bump(c: &mut Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn twice(c: &mut Counter): Nat {
  var last: Nat := bump(&mut c)
  last := bump(&mut c)
  last
}

theorem two(): twice(Counter::Mk(Zero, Zero)) = mut1(Succ(Succ(Zero)), Counter::Mk(Succ(Succ(Zero)), Succ(Succ(Zero)))) {
  Refl(<A: Mut1(Nat, Counter), a: mut1(Succ(Succ(Zero)), Counter::Mk(Succ(Succ(Zero)), Succ(Succ(Zero))))>)
}
```
checks_all = "checked"

@ cases.mutable_a_match_that_changes_the_state_returns_it
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(slot: &mut A, v: A): Unit {
  *slot := v
}

fn bump(c: &mut Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn maybe(c: &mut Counter, go: Bool): Nat {
  if go {
    set_to(&mut c.hits, Succ(c.hits))
  }
  match go {
    true => bump(&mut c)
    false => c.n
  }
}

theorem yes_twice(): maybe(Counter::Mk(Zero, Zero), true) = mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Succ(Zero)))) {
  Refl(<A: Mut1(Nat, Counter), a: mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Succ(Zero))))>)
}

theorem no_never(): maybe(Counter::Mk(Zero, Zero), false) = mut1(Zero, Counter::Mk(Zero, Zero)) {
  Refl(<A: Mut1(Nat, Counter), a: mut1(Zero, Counter::Mk(Zero, Zero))>)
}
```
checks_all = "checked"

@ cases.mutable_a_let_reads_the_state_where_it_is_written
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(slot: &mut A, v: A): Unit {
  *slot := v
}

fn bump(c: &mut Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn before(c: &mut Counter): Nat {
  let n := c.n
  bump(&mut c)
  n
}

theorem old(): before(Counter::Mk(Zero, Zero)) = mut1(Zero, Counter::Mk(Succ(Zero), Succ(Zero))) {
  Refl(<A: Mut1(Nat, Counter), a: mut1(Zero, Counter::Mk(Succ(Zero), Succ(Zero)))>)
}
```
checks_all = "checked"

@ cases.mutable_the_right_of_and_changes_the_state_only_when_it_runs
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(slot: &mut A, v: A): Unit {
  *slot := v
}

fn bump(c: &mut Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn is_zero(n: Nat): Bool {
  ⊢ Bool from match n {
    Zero => true
    Succ(m) => false
  }
}

fn maybe_bump(c: &mut Counter, go: Bool): Bool {
  go && is_zero(bump(&mut c))
}

theorem not_bumped(): maybe_bump(Counter::Mk(Zero, Zero), false) = mut1(false, Counter::Mk(Zero, Zero)) {
  Refl(<A: Mut1(Bool, Counter), a: mut1(false, Counter::Mk(Zero, Zero))>)
}
```
checks_all = "checked"

@ cases.mutable_a_matched_variable_stays_in_scope
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(slot: &mut A, v: A): Unit {
  *slot := v
}

fn bump(c: &mut Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn again(c: &mut Counter, n: Nat): Nat {
  match n {
    Zero => bump(&mut c)
    _ => n
  }
}

theorem kept(): again(Counter::Mk(Zero, Zero), Succ(Zero)) = mut1(Succ(Zero), Counter::Mk(Zero, Zero)) {
  Refl(<A: Mut1(Nat, Counter), a: mut1(Succ(Zero), Counter::Mk(Zero, Zero))>)
}
```
