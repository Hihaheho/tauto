@ cases.a_lambda_does_not_capture_a_variable_of_its_expected_type
source = ```tauto
inductive T: Type {
  A: T
  B(x: T): T
}
inductive W: Type {
  Mk(x: T): W
}
fn unw(u: W): T {
  ⊢ T from match u {
    Mk(y) => y
  }
}
theorem cap(x: T, u: W): x = unw(u) {
  W::ind(v => x = unw(v), x => Refl(<A: T, a: x>), u)
}
```
checks."cap" = "error: mismatch"

