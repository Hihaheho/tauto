@ cases.the_head_of_a_nonempty_vector_1
source = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  Vnil: Vec(A, Zero)
  Vcons(n: Nat, h: A, t: Vec(A, n)): Vec(A, Succ(n))
}
fn head(A: Type, n: Nat, v: Vec(A, Succ(n))): A {
  Vec::rec(A, m => w => Nat::rec(q => Type, Unit, k => ih => A, m), Star, k => h => t => ih => h, Succ(n), v)
}
theorem t(): head(Nat, 0, Vcons(Nat, 0, 7, Vnil(Nat))) = 7 { Refl(Nat, 7) }
```
