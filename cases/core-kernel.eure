@ cases.the_prelude_struct_is_a_family_written_as_a_record
source = ```tauto
fn first(p: Pair(Nat, Nat)): Nat {
  ⊢ Nat from match p {
    Pair { fst: a, snd: b } => a
  }
}
theorem t(): first(Pair { fst: 1, snd: 2 }) = 1 { Refl }
```
checks."first" = "checked"
checks."t" = "checked"

@ cases.the_prelude_result_is_a_family
source = ```tauto
fn safe_pred(n: Nat): Result(Nat, Bool) {
  ⊢ Result(Nat, Bool) from match n {
    Zero => Err(false)
    Succ(m) => Ok(m)
  }
}
fn map_ok<T, U, E>(f: (T) -> U, r: Result(T, E)): Result(U, E) {
  ⊢ Result(U, E) from match r {
    Ok(v) => Ok(f(v))
    Err(e) => Err(e)
  }
}
theorem t(n: Nat): safe_pred(Succ(n)) = Ok(n) { Refl }
theorem u<T, E>(r: Result(T, E)): map_ok((x) => x, r) = r {
  ⊢ map_ok((x) => x, r) = r from match r {
    Ok(v) => Refl
    Err(e) => Refl
  }
}
```
checks."safe_pred" = "checked"
checks."map_ok" = "checked"
checks."t" = "checked"
checks."u" = "checked"

@ cases.the_prelude_ord_has_its_laws_for_the_prelude_data
source = ```tauto
theorem t<A>(xs: List(A), ys: List(A), e: Ord::compare(xs, ys) = Equal): xs = ys where Ord(A) {
  ord_equal_eq(xs, ys, e)
}
```
checks."t" = "checked"

// The product `A × B` has its instance of `Ord`, written once in the prelude (the kernel reads it
// for `Pair` and for the product): a product of products takes it member by member.
@ cases.the_prelude_ord_has_its_laws_for_products
source = ```tauto
theorem t<A, B>(p: A × B, q: A × B, e: Ord::compare(p, q) = Equal): p = q where Ord(A), Ord(B) {
  ord_equal_eq(p, q, e)
}
theorem u<A, B, C>(p: A × B × C, q: A × B × C, e: Ord::compare(p, q) = Equal): p = q where Ord(A), Ord(B), Ord(C) {
  ord_equal_eq(p, q, e)
}
fn v<A, B>(p: A × B, q: A × B): Ordering where Ord(A), Ord(B) { Ord::compare(p, q) }
fn w<A, B>(p: Pair(A, B), q: Pair(A, B)): Ordering where Ord(A), Ord(B) { Ord::compare(p, q) }
```
checks."t" = "checked"
checks."u" = "checked"
checks."v" = "checked"
checks."w" = "checked"

// A generic's type is written as a product without parentheses: `<p: A × B>`.
@ cases.a_generic_binder_has_a_product_type
source = ```tauto
theorem t<A, B, p: A × B, q: A × B>(e: Ord::compare(p, q) = Equal): p = q where Ord(A), Ord(B) {
  ord_equal_eq(p, q, e)
}
theorem u<A, B, C, p: A × B × C>(): p = p {
  ⊢ p = p from match p {
    #(x, y, z) => Refl
  }
}
```
checks."t" = "checked"
checks."u" = "checked"

