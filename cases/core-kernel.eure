@ cases.induction_by_a_recursive_theorem_1
source = ```tauto
fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}
theorem plus_zero(n: Nat): plus(n, Zero) = n {
  ⊢ plus(n, Zero) = n from match n {
    Zero => Refl(<A: Nat, a: Zero>)
    Succ(k) => Eq::subst(<A: Nat, a: plus(k, Zero), b: k>, y => Succ(plus(k, Zero)) = Succ(y), plus_zero(k), Refl(<A: Nat, a: Succ(plus(k, Zero))>))
  }
}
```
checks."plus_zero" = "checked"

