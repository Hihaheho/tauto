@ cases.structural_recursion_on_a_type_in_a_module
source = ```tauto
module M {
  inductive T: Type {
    Leaf: T
    Node(t: T): T
  }
  fn depth(t: T): Nat {
    ⊢ Nat from match t {
      Leaf => 0
      Node(u) => Succ(depth(u))
    }
  }
  theorem t(): depth(Node(Node(Leaf))) = 2 { Refl(Nat, 2) }
}
```
