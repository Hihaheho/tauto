@ cases.a_stuck_index_waits_for_an_impossible_one
source = ```tauto
inductive T: Type {
  Lam(b: T): T
  Ap(f: T, a: T): T
}
fn inst(b: T, a: T): T {
  ⊢ T from match b {
    Lam(c) => c
    Ap(f, x) => a
  }
}
inductive P: (T, T) -> Prop {
  PLam(b: T, b2: T, h: P(b, b2)): P(Lam(b), Lam(b2))
  PBeta(b: T, a: T): P(Ap(Lam(b), a), inst(b, a))
}
theorem inv(b: T, d: T, h: P(Lam(b), Lam(d))): P(b, d) {
  match h {
    PLam(b0, b2, h1) => h1
  }
}
```
checks."inv" = "checked"

@ cases.a_constructor_generic_is_inferred_and_may_be_left_out_of_a_pattern
source = ```tauto
inductive St: (Nat, Nat) -> Prop {
  StRefl(n: Nat): St(n, n)
  StSucc<n: Nat, m: Nat>(h: St(n, m)): St(n, Succ(m))
}
theorem two(): St(0, 2) { StSucc(StSucc(StRefl(0))) }
theorem full(): St(0, 1) { StSucc(0, 0, StRefl(0)) }
theorem up<n: Nat, m: Nat>(h: St(n, m)): St(Succ(n), Succ(m)) {
  match h {
    StRefl(k) => StRefl(Succ(k))
    StSucc(h1) => StSucc(up(h1))
  }
}
```
