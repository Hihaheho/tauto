import std::array

inductive class Sized(T: Type) {
  fn size(t: T): Nat
  theorem size_eq(t: T): Sized::size(t) = Sized::size(t)
}

instance Sized(Array(Nat)) {
  fn size(t: Array(Nat)): Nat { Array::len(t) }
  theorem size_eq(t: Array(Nat)): Array::len(t) = Array::len(t) { Refl }
}
```
