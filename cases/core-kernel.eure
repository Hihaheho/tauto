@ cases.mutable_the_right_of_and_changes_the_state_only_when_it_runs
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}

fn bump(&mut c: Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn is_zero(n: Nat): Bool {
  ⊢ Bool from match n {
    Zero => true
    Succ(m) => false
  }
}

fn maybe_bump(&mut c: Counter, go: Bool): Bool {
  go && is_zero(bump(&mut c))
}

theorem not_bumped(): maybe_bump(Counter::Mk(Zero, Zero), false) = mut1(false, Counter::Mk(Zero, Zero)) {
  Refl(Mut1(Bool, Counter), mut1(false, Counter::Mk(Zero, Zero)))
}
```
checks_all = "checked"

@ cases.mutable_a_matched_variable_stays_in_scope
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}

fn bump(&mut c: Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn again(&mut c: Counter, n: Nat): Nat {
  match n {
    Zero => bump(&mut c)
    _ => n
  }
}

theorem kept(): again(Counter::Mk(Zero, Zero), Succ(Zero)) = mut1(Succ(Zero), Counter::Mk(Zero, Zero)) {
  Refl(Mut1(Nat, Counter), mut1(Succ(Zero), Counter::Mk(Zero, Zero)))
}
```
checks_all = "checked"

@ cases.mutable_mut_lends_only_the_state
source = ```tauto


inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}

fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}

fn bump(&mut c: Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}

fn wrong(c: Counter): Nat {
  bump(&mut c)
}
```
checks.wrong = "error: `&mut` lends"


@ cases.a_function_type_is_written_where_an_expression_is
source = ```tauto
fn Imp(o: Bool, p: Prop, q: Prop): Prop {
  ⊢ Prop from match o {
    false => (p) -> q
    true => (h: p) -> q
  }
}
theorem imp_id(o: Bool, p: Prop): Imp(o, p, p) {
  match o {
    false => (h: p) => h
    true => (h: p) => h
  }
}
theorem cases_with_a_hypothesis(P: (Bool) -> Prop, o: Bool, a: P(false), b: P(true)): (o = o) -> P(o) {
  Bool::ind((x: Bool) => (x = x) -> P(x), (e: false = false) => a, (e: true = true) => b, o)
}
```
checks."imp_id" = "checked"
checks."cases_with_a_hypothesis" = "checked"


@ cases.an_argument_used_twice_is_reduced_once
source = ```tauto
inductive Seq: Type {
  Stop: Seq
  More(n: Nat, rest: Seq): Seq
}
fn r#copy(s: Seq): Seq {
  ⊢ Seq from match s {
    Stop => Stop
    More(n, rest) => More(n, r#copy(rest))
  }
}
fn longer(s: Seq): Nat {
  ⊢ Nat from match s {
    Stop => 0
    More(n, rest) => Succ(longer(rest))
  }
}
fn keep(k: Nat, s: Seq): Seq {
  (⊢ (Seq) -> Seq from match k {
    Zero => (t: Seq) => r#copy(t)
    Succ(j) => (t: Seq) => t
  })(s)
}
fn step(s: Seq): Seq {
  keep(longer(s), s)
}
fn grow(k: Nat): Seq {
  ⊢ Seq from match k {
    Zero => More(1, More(2, More(3, Stop)))
    Succ(j) => step(grow(j))
  }
}
theorem t(): grow(16) = More(1, More(2, More(3, Stop))) { Refl }
```
checks."t" = "checked"

