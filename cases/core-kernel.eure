@ cases.an_effectful_or_executable_function_is_not_a_proof_term
source = ```tauto
effect ask(q: Int): Int
fn noisy(): Nat ! {ask} { 0 }
fn imperative(n: Nat): Nat {
  var i := 0
  while i < n {
    i := i + 1
  }
  i
}
theorem a(): noisy() = 0 { Refl(Nat, 0) }
theorem b(): imperative(1) = 0 { Refl(Nat, 0) }
```
checks."noisy" = "skipped"
checks."imperative" = "skipped"
checks."a" = "error: not defined"
checks."b" = "error: not defined"

@ cases.a_constructor_in_another_case_convention_is_named
source = ```tauto
inductive Held: Type {
  HeldRoot: Held
  HeldEdge(h: Held): Held
}
theorem a(): Held { held_root }
theorem b(): Held { held_edg }
theorem c(): Held { HeldEdge(HeldRoot) }
```
checks."a" = "error: `held_root` is not defined; did you mean the constructor `HeldRoot`?"
checks."b" = "error: `held_edg` is not defined"
checks."c" = "ok"

// Whether a name is defined does not depend on a type: a declaration that
// fails at one name that is not defined is told of every other one in it,
// a name bound only in its type (`\forall p`) among them.
@ cases.every_name_that_is_not_defined_in_a_declaration_is_told
source = ```tauto
inductive Two: Type {
  One: Two
  Other: Two
}
theorem t(a: Two): twice(a) = add(twice(a), a) {
  let s: \forall p: Two. p = p := (q: Two) => Refl(Two, p)
  Refl(Two, a)
}
```
checks."t" = "error: `twice` is not defined"
diagnostics = [
  { "name" => "t", "message" => "`twice` is not defined", "span" => "): «twice»(a) =" },
  { "name" => "t", "message" => "`add` is not defined", "span" => "= «add»(" },
  { "name" => "t", "message" => "`twice` is not defined", "span" => "add(«twice»(a)" },
  { "name" => "t", "message" => "`p` is not defined", "span" => "Refl(Two, «p»)" },
]

@ cases.a_lambda_keeps_its_parameters_and_its_if
source = ```tauto
fn is_zero(n: Nat): Bool {
  ⊢ Bool from match n {
    Zero => true
    Succ(m) => false
  }
}
fn ap(k: (Nat) -> Nat): Nat { k(0) }
fn pick(): Nat { ap((x: Nat) => if is_zero(x) { 2 } else { 3 }) }
theorem pick_two(): pick() = 2 { Refl(Nat, 2) }
fn ap2(k: (Nat, Nat) -> Nat): Nat { k(1, 2) }
fn second(l: Nat): Nat {
  let q: Nat := l
  ap2((a: Nat, b: Nat) => ⊢ Nat from match a {
    Zero => q
    Succ(x) => b
  })
}
theorem second_two(): second(5) = 2 { Refl(Nat, 2) }
mutual {
  fn even(n: Nat): Nat {
    ⊢ Nat from match n {
      Zero => 0
      Succ(g) => ap2((a: Nat, b: Nat) => odd(g, b))
    }
  }
  fn odd(n: Nat, x: Nat): Nat {
    ⊢ Nat from match n {
      Zero => x
      Succ(g) => even(g)
    }
  }
}
theorem even_two(): even(1) = 2 { Refl(Nat, 2) }
```
checks."pick" = "checked"
checks."pick_two" = "checked"
checks."second" = "checked"
checks."second_two" = "checked"
checks."even" = "checked"
checks."odd" = "checked"
checks."even_two" = "checked"

