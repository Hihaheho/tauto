@ cases.the_head_of_a_nonempty_vector_1
source = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  Vnil: Vec(A, Zero)
  Vcons(n: Nat, h: A, t: Vec(A, n)): Vec(A, Succ(n))
}
fn head(A: Type, n: Nat, v: Vec(A, Succ(n))): A {
  Vec::rec(<A: A>, m => w => Nat::rec(q => Type, Unit, k => ih => A, m), Star, k => h => t => ih => h, Succ(n), v)
}
theorem t(): head(Nat, 0, Vcons(<A: Nat>, 0, 7, Vnil(<A: Nat>))) = 7 { Refl(<A: Nat, a: 7>) }
```
checks."head" = "checked"
checks."t" = "checked"

