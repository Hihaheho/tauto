description = "An assignment to a top-level `var` names that `var`, though another file of the tote declares something spelled alike (here a `ghost fn left`). The program checks, so its generated functions are expanded as any other program's."

@ cases.assigning-a-var-shadows-a-declaration-of-another-file
files_tote = "app"
tote_errors = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/main.taut" = ```tauto
import std::builtin::os
var left := 3
left := 2
perform main(() => {
  print("done\n")
})
```
files."app/src/spec.taut" = ```tauto
pub ghost fn left(A: Type, B: Type): Nat { 0 }
```
