description = "An extern of a dependency is bound by the dependency's bridge crate."

@ cases.dependency-bridge-extern-sharing-a-bare-name
description = "A dependency's extern whose bare name another dependency also declares is named in full, and its bridge binding still applies."
tote = path`../examples/rust/dependency-bridge/app`
stdout = "1\n"
eval.unimplemented = "extern dev::src::render::open: extern is not runnable: dev::src::render::open"
javascript.unimplemented = "unsupported: host extern bindings"
vm.unimplemented = "generate: the extern dev::src::render::open, which has no binding on the machine"
llvm.unimplemented = "generate: the LLVM backend does not write an `extern`"
