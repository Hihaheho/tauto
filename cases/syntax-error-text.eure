// A syntax error names what is written in the source, not the grammar's name for it.

@ cases.unexpected-character-is-shown-as-written
description = "A character no token takes is shown as itself, not as the grammar's `Error` terminal."
entry = "main.taut"
files."main.taut" = 'pub theorem t(): 1 = 1 {
  let h § 1
  Eq::Refl
}'
load_error = "unexpected `§`"

@ cases.unexpected-token-is-shown-as-written
description = "An unexpected token is shown by its text, not by its terminal's name (`RParen`)."
entry = "main.taut"
files."main.taut" = 'fn f(): Nat { (1)) }'
load_error = "unexpected `)`"
