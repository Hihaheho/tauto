  Answer { name: name, run: (arg: Text) => run() }
}
struct App(!e) { resources: List(Answer(e)) }
fn run_app<!e>(app: App(e)): Text ! {Div} ∪ e { "x" }
fn load(): Result(Text, Text) ! {Div, read_db} { Ok(perform read_db("k")) }
fn main(): Text ! {Div} {
  run_app(App { resources: Cons(loading("m", load), Nil) })
}
```
