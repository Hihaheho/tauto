@ cases.open-row-of-a-call-is-inferred-through-a-constructed-list
source = ```tauto

struct Answer(!e) { name: Text, run: (arg: Text) -> Result(Text, Text) ! {Div} ∪ e }
fn loading<!e>(name: Text, run: () -> Result(Text, Text) ! {Div} ∪ e): Answer(e) {
  Answer { name: name, run: (arg: Text) => run() }
}
struct App(!e) { resources: List(Answer(e)) }
fn run_app<!e>(app: App(e)): Text ! {Div} ∪ e { "x" }
fn now(): Result(Text, Text) ! {Div} { Ok("a") }
fn main(): Text ! {Div} {
  run_app(App { resources: Cons(loading("m", now), Nil) })
}
```
rows = "ok"
types = "ok"

@ cases.effect-of-a-call-is-inferred-through-a-constructed-list
source = ```tauto

