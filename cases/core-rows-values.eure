@ cases.typed-aliases-fields-and-returned-functions-keep-rows-1
source = ```tauto

struct Holder { read: () -> Text ! {} }
fn alias(source: () -> Text ! {}): Text ! {} {
  let read: () -> Text ! {} := source
  read()
}
fn field(h: Holder): Text ! {} {
  let read: () -> Text ! {} := h.read
  read()
}
fn direct_field(h: Holder): Text ! {} { h.read() }
fn make(): (() -> Text ! {}) ! {} { () => "ok" }
fn returned(): Text ! {} { make()() }
```
rows = "ok"
types = "ok"

@ cases.open-rows-survive-aliases-and-generic-record-fields-1
source = ```tauto

struct View(!e) { read: () -> Text ! e }
fn alias<!e>(source: () -> Text ! e): Text ! e {
  let read: () -> Text ! e := source
  read()
}
fn r#view<!e>(v: View(e)): Text ! e { v.read() }
fn forwarded<!outer>(v: View(outer)): Text ! outer { r#view(v) }
```
rows = "ok"
types = "ok"

