@ cases.escaping-continuation-performs-the-rest-of-the-body
source = ```tauto

effect pause(): Unit resume ω
effect ask(): Text
fn leak(): (() -> Text ! {}) ! {ask} {
  handle { perform pause(); perform ask() } with {
    pause(), k => () => k(#())()
    return value => () => value
  }
}
fn caller(): Text ! {} {
  let f := handle { leak() } with { ask(), k => k("answered") }
  f()
}
```
rows = "error: a function value may perform ask but its type permits {}"
types = "ok"

