@ cases.native-value-generic-prefix-can-be-partially-applied
extract = true
imports = [path`../std/Nat.taut`]
source = ```tauto
fn first<n: Nat>(x: Nat, y: Nat): Nat { n }
let partial: (nat, nat) -> nat := first(97)
perform show("partial", partial(1, 2))
```
shows = ["partial = 97"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["partial = 97"]
javascript_shows = ["partial = 97"]

@ cases.native-direct-row-first-value-generic-keeps-value
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
fn keep<!e, n: Nat>(callback: () -> Unit ! e): Nat ! {} ∪ e { callback(); n }
perform show("row", keep(103, () => #()))
```
shows = ["row = 103"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["row = 103"]
javascript_shows = ["row = 103"]

@ cases.native-partial-prefix-is-evaluated-once-before-call
extract = true
imports = [path`../std/Nat.taut`]
source = ```tauto
fn first<n: Nat>(x: Nat, y: Nat): Nat { n }
let partial: (nat, nat) -> nat := first({ perform show("prefix", 1); 107 })
perform show("between", 2)
perform show("partial", partial(3, 4))
```
shows = ["prefix = 1", "between = 2", "partial = 107"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["prefix = 1", "between = 2", "partial = 107"]
javascript_shows = ["prefix = 1", "between = 2", "partial = 107"]

@ cases.native-effectful-partial-is-not-treated-as-pure
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
effect tick(): Unit resume 1
fn first<n: Nat>(x: Nat, y: Nat): Nat ! {tick} { perform tick(); n }
let partial := first(109)
```
load_error = "native partial term-generic application needs a pure owned checked telescope"

@ cases.match-elaboration-keeps-inferred-term-call-identity
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
inductive At(n: Nat): Type { Mk: At(n) }
fn index<n: Nat>(w: At(n)): Nat { n }
fn answer(n: Nat): Nat {
  ⊢ Nat from match n { Zero => 0, Succ(k) => index(At::Mk(k)) }
}
perform show("matched", answer(114))
```
shows = ["matched = 113"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["matched = 113"]
javascript_shows = ["matched = 113"]
