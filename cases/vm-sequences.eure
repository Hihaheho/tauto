@ cases.truncate-regrow-and-borrowed-updates
llvm.unimplemented = "generate: the LLVM backend does not write internal: a value of one type where a value of another is read yet"
source = ```nib

var v: Vec(i64) := Vec::new()
Vec::push(&mut v, 1)
Vec::push(&mut v, 2)
Vec::push(&mut v, 3)
Vec::truncate(&mut v, 1)
Vec::push(&mut v, 9)
show(&Vec::get(&v, 2))
show(&Vec::get(&v, 1))
Vec::truncate(&mut v, 99)
show(&Vec::len(&v))
handle { Vec::swap(&mut v, 0, 1) } with {
  out_of_bounds() => show(&true)
}
match Vec::get_mut(&mut v, 1) { Some(at) => { *at := 7 }, None => #() }
show(&Vec::get(&v, 0))
show(&Vec::pop(&mut v))
show(&Vec::get(&v, 1))
match Vec::last_mut(&mut v) { Some(at) => { *at := 11 }, None => #() }
let a := Vec::into_array(v)
show(&Array::to_list(a))
show(&Array::get(a, 1))
let b := Array::of_list([4, 5])
show(&Array::get(b, 1))
var empty: Vec(i64) := Vec::new()
show(&Vec::pop(&mut empty))
Vec::push(&mut empty, 20)
Vec::clear(&mut empty)
Vec::push(&mut empty, 21)
show(&Vec::into_list(empty))
```
stdout = ```
None
Some(9)
2
Some(9)
Some(7)
None
[11]
None
Some(5)
None
[21]
```
