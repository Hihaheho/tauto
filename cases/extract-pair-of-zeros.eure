// `Zero` extracts as a `nat`, also where nothing else says what a numeral is:
// `Ord::compare` of two `#(Zero, Zero)` needs `Ord(nat × nat)`, not the instance
// for the integer a bare numeral defaults to. The product extraction writes fits
// a written `nat × nat`.
@ cases.pair-of-zeros
source = ```tauto
import std::builtin::ord
import std::ord

fn same(p: Nat): Nat × Nat { #(p, p) }
fn one(): Nat × Nat { #(Zero, Succ(Zero)) }
fn zeros(): Ordering { Ord::compare(#(Zero, Zero), #(Zero, Zero)) }

fn snd(p: Nat × Nat): Nat {
  ⊢ Nat from match p {
    #(a, b) => b
  }
}

show(&zeros())
show(&snd(one()))
show(&snd(same(Succ(Zero))))
```
stdout = ```
Equal
1
1
```
