@ cases.imported-effect-set-bounds-keep-definition-effect-identities
files_tote = "app"
files."app/Tauto.eure" = ```eure
package { name = "app"
version = "0.1.0" }
```
files."app/src/runtime.taut" = ```tauto
import std::Base
import std::prelude::Par

effect access_runtime(): Unit direct
pub effect rt { access_runtime, wait }
pub fn run_handler(): Unit ! {rt, Div} {
  perform access_runtime()
}
pub fn batch<T>(f: () -> T ! {rt, Div}): T ! {rt, Div} {
  f()
}

pub fn drive(body: () -> Unit ! {rt, Div}): Unit ! {wait, Div} {
  handle { body() } with {
    access_runtime(), k => k(#())
  }
}

pub effect all_rt {rt, Div}
pub fn forward<!e: all_rt>(f: () -> Unit ! e): Unit ! e { f() }
```
files."app/src/main.taut" = ```tauto
import std::Base
import "runtime.taut"

pub fn fire<!e: all_rt>(f: () -> Unit ! e): Unit ! e { forward(f) }
drive(() => fire(() => run_handler()))
```
tote_errors = []
