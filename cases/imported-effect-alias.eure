@ cases.imported-effect-set-expands-in-caller-and-callback-rows
files_tote = "app"
files."app/Tauto.eure" = ```eure
package { name = "app"
version = "0.1.0" }
```
files."app/src/runtime.taut" = ```tauto
import std::Base
import std::prelude::Par

effect access_runtime(): Unit direct
pub effect rt { access_runtime, wait }
pub fn run_handler(): Unit ! {rt, Div} {
  perform access_runtime()
}
pub fn batch<T>(f: () -> T ! {rt, Div}): T ! {rt, Div} {
  f()
}

pub fn drive(body: () -> Unit ! {rt, Div}): Unit ! {wait, Div} {
  handle { body() } with {
    access_runtime(), k => k(#())
  }
}
```
files."app/src/main.taut" = ```tauto
import std::Base
import "runtime.taut"

pub fn fire(): Unit ! {rt, Div} {
  batch(() => run_handler())
}
drive(() => fire())
```
