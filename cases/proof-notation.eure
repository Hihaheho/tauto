import std::prelude::Macro
pub macro fn identity_expr(e: SynExpr): SynExpr { e }
```
files."main.taut" = ```tauto
import std::Text
import "expr.taut"
pub theorem escaped_dsl(): identity_expr!(Eq(Text, "<script>&", "<script>&")) {
  Refl(Text, "<script>&")
}
```
