@ cases.dsl
files."math.taut" = path`fixtures/proof-notation.taut`
files."main.taut" = ```tauto
import "math.taut"
pub theorem dsl_sum(): math!(`1 + 2 = 3`) { Refl(Nat, 3) }
```
entry = "main.taut"
checks.dsl_sum = "ok"
proofs = [
  { format => "natural", output => path`expected/proof-display/notation-dsl-01-natural.txt` },
  { format => "natural", full => true, output => path`expected/proof-display/notation-dsl-02-natural-full.txt` },
  { format => "tree", output => path`expected/proof-display/notation-dsl-03-tree.txt` },
  { format => "block", output => path`expected/proof-display/notation-dsl-04-block.html` },
  { format => "node", output => path`expected/proof-display/notation-dsl-05-node.html` },
  { format => "tree-html", output => path`expected/proof-display/notation-dsl-06-tree-html.html` },
  { format => "json", output => path`expected/proof-display/notation-dsl-07-json.json` },
]

@ cases.parameters
