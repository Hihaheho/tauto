@ cases.constant-motive
files."expr.taut" = ```tauto
import std::prelude::Macro
pub macro fn identity_expr(e: SynExpr): SynExpr { e }
```
files."main.taut" = ```tauto
import "expr.taut"
pub theorem motive(P: Prop, h: P, n: Nat): identity_expr!(P) {
  ⊢ identity_expr!(P) from match n {
    Zero => h
    Succ(k) => h
  }
}
```
entry = "main.taut"
checks.motive = "ok"
proofs = [
  { output => path`expected/proof-display/notation-constant-motive.txt` },
  { format => "tree", output => path`expected/proof-display/notation-constant-motive-tree.txt` },
]

@ cases.global-motive-scope
files."expr.taut" = ```tauto
import std::prelude::Macro
pub macro fn identity_expr(e: SynExpr): SynExpr { e }
```
files."main.taut" = ```tauto
import "expr.taut"
pub theorem global_motive(n: Nat): identity_expr!(Eq(Nat, 0, 0)) {
  ⊢ identity_expr!(Eq(Nat, 0, 0)) from match n {
    Zero => Refl(Nat, 0)
    Succ(k) => Refl(Nat, 0)
  }
}
```
entry = "main.taut"
checks.global_motive = "ok"
proofs = [
  { output => path`expected/proof-display/notation-global-motive-scope.txt` },
]
