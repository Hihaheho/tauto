// Differential cases: each named route compares the self-hosted component with its oracle, not only evaluator success.

// a_tote_runs_and_prints
@ cases.a-tote-runs-and-prints-001
source = ```tauto
match perform argv() {
  Nil => print("none")
  Cons(first, rest) => print(first)
}
```
differential = "smoke"

