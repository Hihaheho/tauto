// A named implicit argument, `List::Nil(<A: T>)`, only fixes a generic: the
// types are erased, so a backend lowers the call as if it were not written.

@ cases.a-constructor-with-a-named-implicit
source = ```tauto

let xs: List(i64) := List::Nil(<A: i64>)
match xs {
  Nil => show(&1)
  Cons(_, _) => show(&2)
}
```
stdout = "1\n"
