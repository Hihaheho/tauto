// A host call whose row has no wait cannot be answered later: the run refuses
// the Promise, and the temporary lent to the call is released once.
@ cases.temporary-releases-when-a-direct-host-call-refuses-suspension
llvm.unimplemented = "generate: the LLVM backend does not write an `extern` (the native backend has no host) yet"
run_error = "returned a Promise but its row has no wait"
probe_drops = ["Probe"]
host.make.owner = "Probe"
host.make.value = 7
host.wait.answers = "later"
eval.unimplemented = "extern make: extern is not runnable: make"
rust.unimplemented = "build: error: make has no rust binding (add it to rust.extern in Tauto.eure)"
vm.unimplemented = "generate: the extern make, which has no binding on the machine"
source = ```tauto
import std::builtin::par
struct(affine) Probe { value: i64 }
extern {
    fn make(): Probe
    fn wait(): Unit
}
fn read_probe(probe: &Probe): i64 { probe.value }
fn inspect_probe(probe: &Probe): i64 {
    let first := read_probe(&probe);
    wait();
    first
}
effect ask(): i64 direct
let result := handle { perform ask() } with { ask(), k => k(inspect_probe(&make())) }
show(&result)
```
