  perform log(g)
}
```
check_errors = []

@ cases.marked-fn-type-applied-effect-but-used-is-an-error
entry = "main.taut"
files."main.taut" = ```tauto
pub(open) effect log<E>(e: E): Unit resume 1

fn f(g: () -> Unit): Unit ! { ^log(() -> Unit) } {
  perform log(g)
}
```
check_report = "unused_marker_used"

@ cases.marked-generic-applied-effect-specialized-is-an-error
entry = "main.taut"
files."main.taut" = ```tauto
pub(open) effect log<E>(e: E): Unit resume 1

fn f<A: NoBorrow>(x: A): Unit ! { ^log(A) } {
  perform log(x)
}

fn main(): Unit ! { log(Text) } {
  f("hi")
}
```
check_report = "unused_marker_used"

@ cases.generic-applied-effect-specialized-counts-as-used
entry = "main.taut"
files."main.taut" = ```tauto
pub(open) effect log<E>(e: E): Unit resume 1

fn f<A: NoBorrow>(x: A): Unit ! { log(A) } {
  perform log(x)
}

fn main(): Unit ! { log(Text) } {
  f("hi")
}
```
check_errors = []
