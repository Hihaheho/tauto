class Parent(A: Shared) { fn step(x: A): A }
class Child(A: Shared) where Parent(A) { fn get(x: A): A }
```
differential = "surface"

@ cases.a-child-bound-also-needs-the-parent-at-the-call
entry = "main.taut"
files."main.taut" = ```tauto
class Parent(A: Shared) { fn step(x: A): A }
class Child(A: Shared) where Parent(A) { fn get(x: A): A }
instance Child(Bool) { fn get(x: Bool): Bool { x } }
fn via_child<A: Shared>(x: A): A where Child(A) { Parent::step(x) }
show(&via_child(true))
```
types = "error: no instance Parent(Bool)"

@ cases.parent-parameter-is-a-type
entry = "main.taut"
files."main.taut" = ```tauto
inductive class Parent(key: Nat) { fn get(): Nat }
inductive class Child(key: Nat) where Parent(key) { fn read(): Nat }
```
macro_error = "the parent class must take the child's single type parameter"
