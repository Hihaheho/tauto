@ cases.budget-body-borrows-outside
// Stopped, the body is `info`, which the arm may keep past `finish(h)`.
source = ```nib
linear struct H { n: i64 }
affine enum R { Done(i64), Paused(Info(R)) }
fn finish(h: H) -> i64 { match h { H { n } => n } }
fn peek(&h: H, x: i64) -> i64 { match &h { H { n } => n + x } }
fn top() -> R {
  let h = H { n: 5 }
  let r = handle { Done(budget(steps: 5) { peek(&h, 1 + 2) }) } with {
    exceeded(info), k => Paused(info)
  }
  let s = finish(h)
  r
}
```
lin = "error: h is borrowed in a budget, whose stopped body may outlive it"

@ cases.budget-body-borrows-inside
source = ```nib
affine struct H { n: i64 }
fn finish(h: H) -> i64 { match h { H { n } => n } }
fn peek(&h: H, x: i64) -> i64 { match &h { H { n } => n + x } }
let r = handle {
  budget(steps: 50) {
    let h = H { n: 5 }
    let v = peek(&h, 1)
    finish(h) + v
  }
} with {
  exceeded(info), k => k(0)
}
```
lin = "ok"

@ cases.borrowing-return-arm-pins-k
// The continuation holds the `return` arm too.
source = ```nib
effect choose: () -> Bool
affine struct H { n: i64 }
affine enum R { Done(i64), More(affine (Bool) -> R ! {}) }
fn finish(h: H) -> i64 { match h { H { n } => n } }
fn peek(&h: H, b: Bool) -> i64 { match &h { H { n } => if b { n } else { 0 } } }
fn go(k: affine (Bool) -> R ! {}) -> i64 ! {} { match k(true) { Done(v) => v, More(_) => 0 } }
fn top() -> i64 ! {} {
  let h = H { n: 5 }
  let r = handle { perform choose() } with {
    return v => Done(peek(&h, v))
    choose(), k => More(k)
  }
  let s = finish(h)
  match r { Done(v) => v, More(k) => s + go(k) }
}
```
lin = "error: k holds a borrow of h, so it may only be called in its arm"
