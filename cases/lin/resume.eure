@ cases.outer-owned-used-after-omega
source = ```nib
effect choose(): Bool resume ω
struct(affine) F { n: i64 }
fn consume(x: F): i64 { match x { F { n } => n } }
fn g(b: Bool, n: i64): i64 { n }
let a := F { n: 5 }
let r := handle { g(perform choose(), consume(a)) } with {
  choose(), k => k(true) + k(false)
}
```
lin = "error: a is live across choose"

// What a handle's body moves before it can perform an operation with an arm
// is gone when the arm runs: the arm's `k` may then be called where the rest
// of the row resumes many times.
@ cases.moved-before-the-handled-operation-is-not-live-in-the-arm
source = ```nib
effect log(s: Text): Unit
struct(affine) F { n: i64 }
fn quiet<!e>(f: (x: F) -> i64 ! {log} ∪ e, x: F): i64 ! e {
  handle { f(x) } with {
    log(s), k => k(#())
  }
}
```
lin = "ok"

// The body may perform the operation while it still owns `x`: the arm runs
// with `x` live.
@ cases.owned-at-the-handled-operation-is-live-in-the-arm
source = ```nib
effect log(s: Text): Unit
struct(affine) F { n: i64 }
fn quiet<!e>(f: (x: F) -> i64 ! {log} ∪ e, x: F): i64 ! e {
  handle {
    perform log("first")
    f(x)
  } with {
    log(s), k => k(#())
  }
}
```
lin = "error: x is live across e, which resumes ω"

// A callback whose row is a row variable may perform the handled operation.
@ cases.owned-at-a-row-variable-call-is-live-in-the-arm
source = ```nib
effect log(s: Text): Unit
struct(affine) F { n: i64 }
fn quiet<!e>(first: () -> Unit ! e, f: (x: F) -> i64 ! {log} ∪ e, x: F): i64 ! e {
  handle {
    first()
    f(x)
  } with {
    log(s), k => k(#())
  }
}
```
lin = "error: x is live across e, which resumes ω"

@ cases.mut-borrow-live-across-omega
source = ```nib
effect choose(): Bool resume ω
fn f(v: &mut Vec(i64)): Unit ! {choose} {
  let b := perform choose()
  Vec::push(&mut v, 1)
}
```
lin = "error: v is live across choose"

// A continuation copies the body's environment, so a `var` from outside the
// handle would differ between resumptions and reach no code after it.
@ cases.a-var-from-outside-cannot-cross-many-resumptions
source = ```nib
effect choose(): Bool resume ω
var n := 0
let r := handle {
  let b := perform choose()
  n := n + 1
  if b { n * 10 } else { n }
} with {
  choose(), k => k(true) + k(false)
}
show(&r)
show(&n)
```
lin = "error: `var n` from outside the handle is used across choose, which resumes ω: each resumption would have its own copy of it"

@ cases.linear-live-across-le-one
source = ```nib
effect ask(): i64
struct(linear) H {}
fn hello(): H { H {} }
fn finish(h: H): i64 { match h { H {} => 0 } }
fn f(): i64 ! {ask} {
  let h := hello()
  let n := perform ask()
  finish(h) + n
}
```
lin = "error: h is live across ask, which may not resume"

@ cases.linear-moved-before-le-one
source = ```nib
effect ask(): i64
