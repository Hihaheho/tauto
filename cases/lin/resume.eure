@ cases.borrowing-return-arm-pins-k
// The continuation holds the `return` arm too.
source = ```nib
effect choose(): Bool
struct(affine) H { n: i64 }
enum(affine) R { Done(i64), More(affine (Bool) -> R ! {}) }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(h: &H, b: Bool): i64 { match &h { H { n } => if b { n } else { 0 } } }
fn go(k: affine (Bool) -> R ! {}): i64 ! {} { match k(true) { Done(v) => v, More(_) => 0 } }
fn top(): i64 ! {} {
  let h := H { n: 5 }
  let r := handle { perform choose() } with {
    return v => Done(peek(&h, v))
    choose(), k => More(k)
  }
  let s := finish(h)
  match r { Done(v) => v, More(k) => s + go(k) }
}
```
lin = "error: k holds a borrow of h, so it may only be called in its arm"

// `div` resumes 0: a `budget` turns it into `exceeded` and drops the rest of
// the computation, and the host's step limit stops it. A linear `k` waiting
// across it would be dropped without being called.
@ cases.linear-k-live-across-div
source = ```nib
effect step(): i64 resume 1
fn spin(n: i64): i64 ! {div} { if n <= 0 { 0 } else { spin(n - 1) } }
fn f(): i64 ! {div} {
  handle { perform step() } with {
    step(), k => {
      let m := spin(3)
      k(m)
    }
  }
}
```
lin = "error: k is live across div, which may not resume; finish the loop before the arm (in the body), give it fuel so it has no div, or declare the operation resume <=1"

@ cases.linear-k-div-in-body
source = ```nib
effect step(n: i64): i64 resume 1
fn spin(n: i64): i64 ! {div} { if n <= 0 { 0 } else { spin(n - 1) } }
fn f(): i64 ! {div} {
  handle { perform step(spin(3)) } with {
    step(n), k => k(n)
  }
}
```
lin = "ok"

