@ cases.info-is-affine
source = ```nib
fn spin() -> i64 {
  while true { }
  0
}
let d = handle { budget(steps: 50) { spin() } } with {
  exceeded(info), k => {
    let a = info.more(1)
    let b = info.more(2)
    a
  }
}
```
lin = "error: info is used after move"

@ cases.an-argument-waits-across-the-later-ones
// `f`'s first argument is moved into the call before the second runs: the
// continuation of `ask` holds it.
source = ```nib
affine struct F {}
effect ask: () -> i64 resume ω
fn f(x: F, n: i64) -> i64 { match x { F {} => n } }
fn g() -> i64 ! {ask} {
  let x = F {}
  f(x, perform ask())
}
```
lin = "error: x is live across ask, which resumes ω"

