@ cases.borrowing-k-kept-in-value
source = ```nib
effect choose: () -> Bool
linear struct H { n: i64 }
affine enum R { Done(i64), More(affine (Bool) -> R ! {}) }
fn finish(h: H) -> i64 { match h { H { n } => n } }
fn peek(&h: H, b: Bool) -> i64 { match &h { H { n } => if b { n } else { 0 } } }
fn go(k: affine (Bool) -> R ! {}) -> i64 ! {} { match k(true) { Done(v) => v, More(_) => 0 } }
fn top() -> i64 ! {} {
  let h = H { n: 5 }
  let r = handle { peek(&h, perform choose()) } with {
    return v => Done(v)
    choose(), k => More(k)
  }
  let s = finish(h)
  match r { Done(v) => v, More(k) => s + go(k) }
}
```
lin = "error: k holds a borrow of h, so it may only be called in its arm"

@ cases.borrowing-k-in-closure
source = ```nib
effect choose: () -> Bool resume ω
linear struct H { n: i64 }
fn finish(h: H) -> i64 { match h { H { n } => n } }
fn peek(&h: H, b: Bool) -> i64 { match &h { H { n } => if b { n } else { 0 } } }
fn top() -> i64 ! {} {
  let h = H { n: 5 }
  let f = handle { let v = peek(&h, perform choose()); x => v } with {
    choose(), k => x => k(true)(x)
  }
  let s = finish(h)
  s + f(1)
}
```
lin = "error: k holds a borrow of h, so it may only be called in its arm"

