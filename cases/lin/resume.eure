@ cases.affine-live-across-omega
source = ```nib
effect choose: () -> Bool resume ω
let c = handle {
  var w = vec_new()
  vec_push(&mut w, 1)
  if perform choose() { vec_len(&w) } else { 0 }
} with {
  choose(), k => k(true) + k(false)
}
```
lin = "error: w is live across choose"

