  handle { perform budget(5, () => { read(x) }) } with { exceeded(^info), ^k => 0 }
}
```
lin = "ok"

// Using `info` keeps the stopped body, and with it the borrow.
@ cases.budget-body-borrows-outside-info-used
source = ```nib
struct(affine) H { n: i64 }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(h: &H, x: i64): i64 { match &h { H { n } => n + x } }
fn drop_info(i: Info(i64)): i64 { 0 }
fn top(): i64 ! {budget} {
  let h := H { n: 5 }
  let r := handle { perform budget(5, () => { peek(&h, 1 + 2) }) } with {
    exceeded(info), k => drop_info(info)
  }
  finish(h) + r
}
```
lin = "error: h is borrowed in a budget, whose stopped body may outlive it"

// A `budget` that is not the whole body sends its stop past code the arm
// does not see: the rule stays.
@ cases.budget-body-borrows-outside-not-whole-body
source = ```nib
fn run(read: &((i64) -> i64 ! {}), x: i64): i64 ! {budget} {
  handle { 1 + perform budget(5, () => { read(x) }) } with { exceeded(^info), ^k => 0 }
}
```
lin = "error: read is borrowed in a budget, whose stopped body may outlive it"

@ cases.budget-body-borrows-inside
source = ```nib
struct(affine) H { n: i64 }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(h: &H, x: i64): i64 { match &h { H { n } => n + x } }
let r := handle {
  perform budget(50, () => {
    let h := H { n: 5 }
    let v := peek(&h, 1)
    finish(h) + v
