@ cases.arm-captures-affine
source = ```nib
effect ask(): i64
struct(affine) F {}
fn use_it(f: &F): i64 { 1 }
let f := F {}
let r := handle { perform ask() } with {
  ask(), k => {
    let n := use_it(&f)
    k(n)
  }
}
```
lin = "error: arm captures affine f"

@ cases.arm-threads-affine-as-parameter
source = ```nib
effect get(): i64
struct(affine) F {}
fn size(f: &F): i64 { 3 }
let run := handle { perform get() + 1 } with {
  get(), k => (m) => k(size(&m))(m)
  return v => (m) => v
}
let r := run(F {})
```
lin = "ok"

