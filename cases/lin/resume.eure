@ cases.budget-rejects-linear
source = ```nib
linear struct H {}
fn hello() -> H { H {} }
fn finish(h: H) -> i64 { match h { H {} => 0 } }
let r = handle {
  budget(steps: 10) {
    let h = hello()
    finish(h)
  }
} with {
  exceeded(info), k => k(0)
}
```
lin = "error: h is live across Exceeded"

