@ cases.linear-live-across-le-one
source = ```nib
effect ask: () -> i64
linear struct H {}
fn hello() -> H { H {} }
fn finish(h: H) -> i64 { match h { H {} => 0 } }
fn f() -> i64 ! {ask} {
  let h = hello()
  let n = perform ask()
  finish(h) + n
}
```
lin = "error: h is live across ask, which may not resume"

