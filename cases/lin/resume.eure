@ cases.arm-captures-affine
source = ```nib
effect ask: () -> i64
affine struct F {}
fn use_it(&f: F) -> i64 { 1 }
let f = F {}
let r = handle { perform ask() } with {
  ask(), k => {
    let n = use_it(&f)
    k(n)
  }
}
```
lin = "error: arm captures affine f"

@ cases.arm-threads-affine-as-parameter
