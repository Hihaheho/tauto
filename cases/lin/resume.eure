@ cases.outer-owned-used-after-omega
source = ```nib
effect choose: () -> Bool resume ω
affine struct F { n: i64 }
fn consume(x: F) -> i64 { match x { F { n } => n } }
fn g(b: Bool, n: i64) -> i64 { n }
let a = F { n: 5 }
let r = handle { g(perform choose(), consume(a)) } with {
  choose(), k => k(true) + k(false)
}
```
