fn g(): i64 ! {ask} {
  let x := F {}
  f(x, perform ask())
}
```
lin = "ok"

@ cases.borrowing-k-kept-in-value
source = ```nib
effect choose(): Bool
struct(linear) H { n: i64 }
enum(affine) R { Done(i64), More(affine (Bool) -> R ! {}) }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(h: &H, b: Bool): i64 { match &h { H { n } => if b { n } else { 0 } } }
fn go(k: affine (Bool) -> R ! {}): i64 ! {} { match k(true) { Done(v) => v, More(_) => 0 } }
fn top(): i64 ! {} {
  let h := H { n: 5 }
  let r := handle { peek(&h, perform choose()) } with {
    return v => Done(v)
    choose(), k => More(k)
  }
  let s := finish(h)
  match r { Done(v) => v, More(k) => s + go(k) }
}
```
lin = "error: k holds a borrow of h, so it may only be called in its arm"

@ cases.borrowing-k-in-closure
source = ```nib
effect choose(): Bool resume ω
struct(linear) H { n: i64 }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(h: &H, b: Bool): i64 { match &h { H { n } => if b { n } else { 0 } } }
fn top(): i64 ! {} {
  let h := H { n: 5 }
  let f := handle { let v := peek(&h, perform choose()); x => v } with {
    choose(), k => x => k(true)(x)
  }
  let s := finish(h)
  s + f(1)
}
```
lin = "error: k holds a borrow of h, so it may only be called in its arm"

@ cases.borrowing-k-called-in-place
source = ```nib
effect choose(): Bool resume ω
struct(linear) H { n: i64 }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(h: &H, b: Bool): i64 { match &h { H { n } => if b { n } else { 0 } } }
fn top(): i64 ! {} {
  let h := H { n: 5 }
  let r := handle { peek(&h, perform choose()) } with {
    choose(), k => { let first := k(true)
      k(false) }
  }
  finish(h) + r
}
```
lin = "ok"

@ cases.budget-body-borrows-outside
// Stopped, the body is `info`, which the arm may keep past `finish(h)`.
source = ```nib
struct(linear) H { n: i64 }
enum(affine) R { Done(i64), Paused(Info(R)) }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(h: &H, x: i64): i64 { match &h { H { n } => n + x } }
fn top(): R ! {budget} {
  let h := H { n: 5 }
  let r := handle { Done(perform budget(5, () => { peek(&h, 1 + 2) })) } with {
    exceeded(info), k => Paused(info)
  }
  let s := finish(h)
  r
}
```
lin = "error: h is borrowed in a budget, whose stopped body may outlive it"

// An `exceeded` arm that uses neither `info` nor `k` drops the stopped body
// inside the `handle`, before anything it borrows can go: the body may borrow.
@ cases.budget-body-borrows-outside-dropped-in-arm
source = ```nib
struct(affine) H { n: i64 }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(h: &H, x: i64): i64 { match &h { H { n } => n + x } }
fn top(): i64 ! {budget} {
  let h := H { n: 5 }
  let r := handle { perform budget(5, () => { peek(&h, 1 + 2) }) } with {
    exceeded(info), k => 0
  }
  finish(h) + r
}
```
lin = "ok"

@ cases.borrowed-callback-in-budget-dropped-in-arm
source = ```nib
