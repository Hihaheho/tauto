// Resume quantities and control-flow linearity.

@ cases.default-is-le-one
source = ```nib
effect ask(): i64
let r := handle { perform ask() } with {
  ask(), k => k(1) + k(2)
}
```
lin = "error: k is used after move"

@ cases.omega-allows-two-calls
source = ```nib
effect ask(): i64 resume ω
let r := handle { perform ask() } with {
  ask(), k => k(1) + k(2)
}
```
lin = "ok"

