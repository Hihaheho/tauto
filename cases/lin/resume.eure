@ cases.omega-lending-shared-borrows
description = "An operation whose answer lends only shared borrows may resume any number of times: the kept results share their loans (`EffectLend.many_ok_shared`)."
source = ```nib
struct Node { v: u64 }
effect look(): &Node resume ω
let n := Node { v: 1 }
let r := handle { let p := perform look()
  p.v } with {
  look(), k => k(&n) + k(&n)
}
```
lin = "ok"

@ cases.omega-lending-mutable-borrow
description = "An operation whose answer lends a mutable borrow resumes at most once: two kept results could hold the same mutable loan (`EffectLend.many_mut_conflict`)."
source = ```nib
struct Node { v: u64 }
effect poke(): &mut Node resume ω
var n := Node { v: 1 }
let r := handle { let p := perform poke()
  p.v } with {
  poke(), k => k(&mut n) + k(&mut n)
}
```
lin = "error: `poke` answers a value that may hold a mutable borrow, so it resumes at most once: declare it `resume 1` or `resume <=1`"
