@ cases.mut-param-borrow-freezes-callers-owner
source = ```nib

struct(affine) F { n: i64 }
fn size(f: &F): i64 { f.n }
fn take(f: F): i64 { f.n }
fn put(o: &mut Option(&F), x: &F): () { *o := Some(x) }
fn go(): i64 {
  let a := F { n: 1 }
  var o: Option(&F) := None
  put(&mut o, &a)
  let t := take(a)
  match o {
    Some(r) => t + size(r)
    None => t
  }
}
```
lin = "error: a is frozen by o"

@ cases.closure-mut-param-takes-captured-borrow-does-not-live-long-enough
source = ```nib
struct(affine) F { n: i64 }
fn size(f: &F): i64 { f.n }
fn go(): i64 {
  var o: Option(&F) := None
  let z := {
    let a := F { n: 1 }
    let f := (p: &mut Option(&F)) => { *p := Some(&a) }
    f(&mut o)
    0
  }
  match o {
    Some(r) => z + size(r)
    None => z
  }
}
```
lin = "error: a does not live as long as p"

@ cases.closure-mut-param-takes-lent-borrow-is-ok
source = ```nib
struct(affine) F { n: i64 }
struct Holder { r: &F }
fn go(): i64 {
  let a := F { n: 1 }
  var keep := Vec::new()
  let k := (v: &mut Vec(Holder), h: Holder) => { Vec::push(&mut v, h)
    1 }
  k(&mut keep, Holder { r: &a })
}
```
lin = "ok"

@ cases.closure-stores-received-holder-in-capture-does-not-live-long-enough
source = ```nib
struct(affine) F { n: i64 }
struct Holder { r: &F }
fn size(f: &F): i64 { f.n }
fn go(): i64 { var keep := Vec::new()
  let k := (h: Holder) => { Vec::push(&mut keep, h)
    1 }
  let n := { let b := F { n: 4 }
    k(Holder { r: &b }) }
  match Vec::pop(&mut keep) { Some(h) => n + size(&h.r)
    None => n } }
```
lin = "error: h does not live as long as keep"

// An in-place closure that borrows a local is lent to a `&((A) -> B)` parameter.
@ cases.in-place-borrowing-closure-is-lent-to-a-borrowed-fn-parameter
source = ```nib
struct(affine) F { n: i64 }
fn size(f: &F): i64 { f.n }
fn twice(cb: &((i64) -> i64 ! {})): i64 { 1 }
fn m(): i64 {
  let b := F { n: 7 }
  twice((x: i64) => size(&b))
}
```
lin = "ok"
