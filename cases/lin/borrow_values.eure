@ cases.generic-identity-keeps-the-borrow
source = ```nib
struct(affine) F {}
struct Pick { f: &F }
fn id<A>(x: A): A { x }
fn take(f: F): i64 { 1 }
let a := F {}
let p := id(Pick { f: &a })
take(a)
let used_later := &p
```
lin = "error: a is frozen by p"

@ cases.generic-effect-argument-needs-no-borrow
source = ```nib
effect keep<A>(x: A): Unit
fn send<A>(x: A): Unit ! {∀ A. keep(A)} { perform keep(x) }
```
types = "error: a value of A, which may hold a borrow, cannot be an effect argument"

