@ cases.borrowing-closure-result-used-in-place-is-ok
source = ```nib
struct(affine) F { n: i64 }
struct Pick { f: &F }
fn size(f: &F): i64 { f.n }
fn through(a: &F): i64 {
  let get := () => Pick { f: &a }
  let p := get()
  size(&p.f)
}
let a := F { n: 5 }
show(&through(&a))
```
stdout = "5\n"

// A `&mut` parameter is the caller's binding: what is put into it may borrow
// only what the caller lent, the parameters passed as borrows, whatever the
// order of the parameters. An owned parameter and a local die with the call.
@ cases.mut-param-cannot-borrow-owned-param
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn put(x: F, o: &mut Option(Holder)): () { *o := Some(Holder { r: &x }) }
```
lin = "error: x does not live as long as o"

