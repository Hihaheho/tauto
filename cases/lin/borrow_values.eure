// Values that hold borrows in type arguments, containers and `var`s: a type
// variable may stand for a type that holds a borrow unless it is bounded by
// `NoBorrow`. A binding that a `&mut` call or an assignment puts a borrow
// into absorbs what the borrow borrows, and freezes it while the binding is
// live (`last_use.eure`); an owner declared after it must outlive its last use. `F` is an
// affine struct, so that the freeze is the point (a `&i64` is an `i64`).

@ cases.vec-of-borrows-reads
llvm.unimplemented = "generate: the LLVM backend does not write a `Vec` of borrows yet"
source = ```nib

struct(affine) F { n: i64 }
fn size(f: &F): i64 { f.n }
let a := F { n: 1 }
let b := F { n: 2 }
var v := Vec::new()
Vec::push(&mut v, &a)
Vec::push(&mut v, &b)
let n := match Vec::get(&v, 1) {
  Some(f) => size(&f)
  None => 0
}
show(&n)
```
stdout = "2\n"

@ cases.vec-of-borrows-freezes-owner
source = ```nib

struct(affine) F {}
fn take(f: F): i64 { 1 }
let a := F {}
var v := Vec::new()
Vec::push(&mut v, &a)
take(a)
let used_later := &v
```
lin = "error: a is frozen by v"

@ cases.vec-of-borrows-freeze-ends-with-block
source = ```nib

struct(affine) F {}
fn take(f: F): i64 { 1 }
let a := F {}
{
  var v := Vec::new()
  Vec::push(&mut v, &a)
}
take(a)
```
lin = "ok"

