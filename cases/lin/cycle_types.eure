// What a type says the cycle check: a value whose type holds no storage and
// no closure is not followed, however the analysis merged it with others
// (`docs/design/shared-levels.md`).

@ cases.a-list-field-holds-no-storage
// The tail of a `List(A)` is a `List(A)` again: its `A` stands for the
// argument already read, not for an unknown type. `pass` merges the
// storage with the record, so the record is kept apart only by its type.
source = ```nib
struct Node { items: List(i64) }
fn pass<T>(x: T): T { x }
let r := Ref::new(Node { items: Nil })
let same := pass(r)
Ref::set(r, pass(Node { items: Cons(1, Nil) }))
```
lin = "ok"

@ cases.a-list-of-storages-in-itself-is-a-cycle
source = ```nib
struct Node { items: List(Ref(Node)) }
let r := Ref::new(Node { items: Nil })
let s := Ref::new(Node { items: Nil })
Ref::set(r, Node { items: Cons(s, Nil) })
Ref::set(s, Node { items: Cons(r, Nil) })
```
lin = "error: strong reference cycle"


@ cases.deeply-nested-data-is-read-once
// Each type reaches the next one through two fields, so the paths through
// the fields double at every level. A type read once is not read again, so
// the check stays linear in the number of types.
source = ```nib
enum T40 { A40, B40(i64) }
enum T39 { A39(T40), B39(T40) }
