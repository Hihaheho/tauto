fn keep(v: &Ver): i64 × &Ver { #( 1, v ) }
```
lin = "ok"

// A `&A` of a duplicable `A` is a borrow too (`&A → A` is a copy only where
// an `A` is wanted): a struct that holds one freezes the owner.
@ cases.borrow-field-of-duplicable-freezes-owner
source = ```nib
struct Pick { t: &Text }
var a := "x"
let p := Pick { t: &a }
a := "y"
let used_later := &p
```
lin = "error: a is frozen by p"

// Where an `A` is wanted, the borrow is copied and nothing stays frozen.
@ cases.borrow-of-duplicable-copied-where-value-wanted
source = ```nib
struct Keep { t: Text }
var a := "x"
let p := Keep { t: &a }
a := "y"
let used_later := &p
```
lin = "ok"

@ cases.borrow-field-relent-without-ampersand
source = ```nib
struct(affine) Tok { v: i64 }
struct View { r: &Tok, k: i64 }
fn peek(t: &Tok): i64 { t.v }
let t1 := Tok { v: 3 }
let w1 := View { r: &t1, k: 2 }
show(&(peek(w1.r) + w1.k))
```
stdout = "5\n"

@ cases.borrow-field-relent-still-freezes-owner
source = ```nib
struct(affine) Tok { v: i64 }
struct View { r: &Tok, k: i64 }
fn peek(t: &Tok): i64 { t.v }
fn take(t: Tok): i64 { t.v }
let t1 := Tok { v: 3 }
let w1 := View { r: &t1, k: 2 }
let a := peek(w1.r)
take(t1)
let used_later := &w1
```
lin = "error: t1 is frozen by w1"
