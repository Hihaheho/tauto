@ cases.borrow-field-freeze-ends-with-block
source = ```nib
struct(affine) F {}
struct Pick { f: &F }
fn size(f: &F): i64 { 1 }
fn take(f: F): i64 { 1 }
let a := F {}
let n := {
  let p := Pick { f: &a }
  size(&p.f)
}
take(a)
```
lin = "ok"

@ cases.borrow-field-from-function
source = ```nib
struct(affine) F { n: i64 }
struct Both { l: &F, r: &F }
fn both(a: &F, b: &F): Both { Both { l: &a, r: &b } }
fn size(f: &F): i64 { f.n }
let a := F { n: 1 }
let b := F { n: 2 }
let p := both(&a, &b)
show(&(size(&p.l) * 10 + size(&p.r)))
```
stdout = "12\n"

@ cases.borrow-field-from-function-freezes
source = ```nib
struct(affine) F {}
struct Both { l: &F, r: &F }
fn both(a: &F, b: &F): Both { Both { l: &a, r: &b } }
var a := F {}
let b := F {}
let p := both(&a, &b)
a := F {}
let used_later := &p
```
lin = "error: a is frozen by p"

