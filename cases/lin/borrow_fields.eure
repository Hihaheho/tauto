@ cases.local_wrap_via_let
description = "A local borrowed into a field, bound, then returned still cannot escape."
source = ```nib
struct Ver { version: i64, value: i64 }
struct Wrap { view: &Ver }

fn local_wrap(): Wrap {
  let v := Ver { version: 0, value: 7 }
  let w := Wrap { view: &v }
  w
}
```
lin = "error: a borrow of v cannot be returned"

@ cases.local_wrap_product
description = "A local behind `&` in a product result cannot escape when the inner type is duplicable."
source = ```nib
struct Ver { version: i64, value: i64 }

fn local_wrap(): i64 × &Ver {
  let v := Ver { version: 0, value: 7 }
  #( 1, &v )
}
```
lin = "error: a borrow of v cannot be returned"

@ cases.keep_product
description = "A product of a borrowed parameter may leave."
