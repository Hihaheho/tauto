@ cases.borrow-field-cannot-be-effect-argument
source = ```nib
struct(affine) F {}
struct Pick { f: &F }
effect e(p: Pick): Unit
let a := F {}
let p := Pick { f: &a }
perform e(p)
```
lin = "error: a borrow cannot be an effect argument"

@ cases.borrow-field-without-a-lender-is-checked-in-the-body
description = "A result that may hold a borrow needs no lender in the signature: the body is checked to lend nothing, and one that never returns lends nothing."
source = ```nib
struct(affine) F {}
struct Pick { f: &F }
fn mk(): Pick { mk() }
```
lin = "ok"

@ cases.borrow-field-cannot-return-local
source = ```nib
struct(affine) F {}
struct Pick { f: &F }
fn mk(a: &F): Pick {
  let b := F {}
  Pick { f: &b }
}
```
lin = "error: a borrow of b cannot be returned"

@ cases.borrow-field-kept-continuation
source = ```nib
effect choose(): Bool
struct Pick { v: &Vec(i64) }
enum(affine) R { Done(u64), More(affine (Bool) -> R ! {}) }
fn pick(p: &Pick, b: Bool): u64 { Vec::len(&p.v) }
fn mk(): R ! {} {
  var v := Vec::new()
  Vec::push(&mut v, 1)
  handle {
    let p := Pick { v: &v }
    pick(&p, perform choose())
  } with {
    return x => Done(x)
    choose(), k => More(k)
  }
}
```
lin = "error: k holds a borrow of v"

@ cases.borrow-field-in-budget
source = ```nib
struct(linear) H { n: i64 }
struct Pick { h: &H }
enum(affine) R { Done(i64), Paused(Info(R)) }
fn finish(h: H): i64 { match h { H { n } => n } }
fn peek(p: &Pick, x: i64): i64 { x }
fn top(): R ! {budget} {
  let h := H { n: 5 }
  let r := handle {
    Done(perform budget(5, () => {
      let p := Pick { h: &h }
      peek(&p, 1 + 2)
    }))
  } with {
    exceeded(info), k => Paused(info)
  }
  let s := finish(h)
  r
}
```
lin = "error: h is borrowed in a budget"

@ cases.only-an-extern-type-is-declared-to-hold-a-borrow
description = "A type with fields holds a borrow when a field does; `borrow` is written only on an extern type."
source = ```nib
struct(affine) F {}
struct(borrow) Pick { f: &F }
```
parses = false

@ cases.an-extern-type-declared-to-hold-a-borrow-freezes-its-owner
description = "`type(affine, borrow)` is an opaque type that holds a borrow: the owner it borrows from stays frozen while it lives."
source = ```nib

struct(affine) F {}
extern {
  type(affine, borrow) Guard
  fn lock(v: &Vec(F)): Guard
  fn peek(g: &Guard): i64
}
var v := Vec::new()
Vec::push(&mut v, F {})
let g := lock(&v)
let w := v
peek(&g)
```
lin = "error: v is frozen by g"

@ cases.an-extern-type-declared-to-hold-a-borrow-is-affine
description = "`type(borrow)` without a kind is affine: the value that holds the borrow is not copied."
source = ```nib

struct(affine) F {}
extern {
  type(borrow) Guard
  fn lock(v: &Vec(F)): Guard
  fn unlock(g: Guard): Unit
}
var v := Vec::new()
Vec::push(&mut v, F {})
let g := lock(&v)
unlock(g)
unlock(g)
```
lin = "error: g is used after move"

// A function without a borrowed parameter returns a value that borrows
// nothing: its signature may name a type that may hold a borrow, and its
// body is checked to lend nothing out. Only a result written `&T` or
// `&mut T` itself needs a lender in the signature.

@ cases.a-function-without-a-lender-returns-an-empty-holder
description = "`None` of a type that may hold a borrow borrows nothing, so a function without a borrowed parameter may return it."
source = ```nib
struct(affine) F { n: i64 }
struct Holder { r: &F }
fn none(): Option(Holder) { None }
let h := none()
show(&(match h { Some(x) => 1, None => 0 }))
```
lin = "ok"

@ cases.a-function-without-a-lender-returns-an-extern-holder-that-borrows-nothing
description = "An extern function without a borrowed parameter makes a value of an extern `type(borrow)` that borrows nothing, and a function with a body may pass it on."
source = ```nib
extern {
  type(borrow) Token
  fn token(): Token
  fn spend(t: Token): i64
}
fn make(): Token { token() }
fn twice(): Token {
  let t := make()
  t
}
fn used(): i64 { spend(twice()) }
```
lin = "ok"

@ cases.a-function-without-a-lender-returns-a-holder-of-what-it-was-given
description = "A holder passed by value holds borrows of the caller's owners, not of the function's own bindings, so returning it lends nothing of the body."
source = ```nib
struct(affine) F { n: i64 }
struct Holder { r: &F }
fn wrap(h: Holder): Option(Holder) { Some(h) }
let a := F { n: 3 }
let w := wrap(Holder { r: &a })
show(&(match w { Some(h) => h.r.n, None => 0 }))
```
lin = "ok"

@ cases.a-function-without-a-lender-cannot-return-a-borrow-of-its-own-binding
description = "Without a borrowed parameter the result borrows nothing: a holder of the body's own binding cannot be returned."
source = ```nib
struct(affine) F { n: i64 }
struct Holder { r: &F }
fn bad(): Holder {
  let b := F { n: 1 }
  Holder { r: &b }
}
```
lin = "error: a borrow of b cannot be returned"

@ cases.a-function-without-a-lender-cannot-return-a-borrow-in-a-constructor
description = "A borrow of the body's own binding written in a constructor's argument cannot be the result."
source = ```nib
struct(affine) F { n: i64 }
fn bad(): Option(&F) {
  let b := F { n: 1 }
  Some(&b)
}
```
lin = "error: a borrow of b cannot be returned"

@ cases.a-function-without-a-lender-cannot-return-a-call-that-borrows-its-binding
description = "A call in the tail that borrows the body's own binding cannot be the result."
source = ```nib
struct(affine) F { n: i64 }
fn pick(f: &F): Option(&F) { Some(&f) }
fn bad(): Option(&F) {
  let b := F { n: 1 }
  pick(&b)
}
```
lin = "error: a borrow of b cannot be returned"

@ cases.local_wrap
description = "A local put in a borrow field cannot escape, even when the borrowed type is duplicable."
source = ```nib
struct Ver { version: i64, value: i64 }
struct Wrap { view: &Ver }

fn local_wrap(): Wrap {
  let v := Ver { version: 0, value: 7 }
  Wrap { view: &v }
}
```
lin = "error: a borrow of v cannot be returned"

@ cases.keep
description = "A record of a borrowed parameter may leave; the borrow is the parameter's."
source = ```nib
struct Ver { version: i64, value: i64 }
struct Wrap { view: &Ver }

fn keep(v: &Ver): Wrap { Wrap { view: v } }
```
lin = "ok"

