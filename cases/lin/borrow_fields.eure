@ cases.borrow-field-match
source = ```nib
struct(affine) F { n: i64 }
struct Pick { f: &F, k: i64 }
fn size(f: &F): i64 { f.n }
fn pick(f: &F, k: i64): Pick { Pick { f: &f, k: k } }
let a := F { n: 3 }
let n := match pick(&a, 4) {
  Pick { f: g, k: j } => size(&g) + j
}
show(&n)
```
stdout = "7\n"

@ cases.borrow-field-enum-match
source = ```nib
struct(affine) F { n: i64 }
enum Look { Some(&F), None }
fn size(f: &F): i64 { f.n }
fn look(f: &F, here: Bool): Look { if here { Look::Some(&f) } else { Look::None } }
let a := F { n: 3 }
let l := look(&a, true)
let n := match l {
  Look::Some(g) => size(&g)
  Look::None => 0
}
show(&n)
```
stdout = "3\n"

@ cases.borrow-field-enum-freezes
source = ```nib
struct(affine) F {}
enum Look { Some(&F), None }
fn take(f: F): i64 { 1 }
let a := F {}
let l := Look::Some(&a)
take(a)
let used_later := &l
```
lin = "error: a is frozen by l"

