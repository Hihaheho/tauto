data copy enum ChildStream clone copy {
  ChildStream::ChildStdout,
  ChildStream::ChildStderr,
}

data shared struct Request clone as "Request" {
  Request::Mk(method: Text, url: Text, headers: List(Pair(Text, Text)), body: std Bytes),
}

data shared struct Response clone as "Response" {
  Response::Mk(status: u64, headers: List(Pair(Text, Text)), body: std Bytes),
}

data shared struct RequestHead clone as "RequestHead" {
  RequestHead::Mk(method: Text, url: Text, headers: List(Pair(Text, Text))),
}

data shared struct ResponseHead clone as "ResponseHead" {
