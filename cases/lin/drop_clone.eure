}

data shared struct Cancellation clone as "Cancellation" {
  Cancellation::Mk(source: std CancelSource),
}

data shared struct CancelToken clone as "CancelToken" {
  CancelToken::Mk(signal: std Signal),
}

data affine struct Pending<'A> as "Pending" {
  Pending::Mk(holds: fn() -> 'A shared S),
}

data linear struct Task<'A> linear as "Task" {
