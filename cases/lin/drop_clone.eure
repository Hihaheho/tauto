}

data affine enum Finished {
  Finished::Responded(Opened),
  Finished::Unanswered(RequestBody),
  Finished::NoResponse(IoError),
}

data affine struct Written as "Written" {
  Written::Mk(body: RequestBody, result: Result(Unit, IoError)),
}

data affine struct Piece as "Piece" {
  Piece::Mk(body: ResponseBody, got: Result(std Bytes, IoError)),
}

data affine struct TcpListener as "TcpListener" {
  TcpListener::Mk(id: u64, address: Text),
}

data affine struct TcpStream as "TcpStream" {
  TcpStream::Mk(id: u64, local: Text, peer: Text),
}

data copy struct TcpStopper clone copy as "TcpStopper" {
  TcpStopper::Mk(id: u64),
}

data copy struct ListenStopper clone copy as "ListenStopper" {
  ListenStopper::Mk(id: u64),
}

data affine struct TcpAccepted as "TcpAccepted" {
  TcpAccepted::Mk(listener: TcpListener, got: Result(TcpStream, IoError)),
}

data affine struct TcpRead as "TcpRead" {
  TcpRead::Mk(stream: TcpStream, got: Result(std Bytes, IoError)),
}

data affine struct TcpWritten as "TcpWritten" {
  TcpWritten::Mk(stream: TcpStream, result: Result(Unit, IoError)),
}

data copy enum Shutdown clone copy {
  Shutdown::ShutdownRead,
  Shutdown::ShutdownWrite,
  Shutdown::ShutdownBoth,
}

data shared struct TlsCert clone as "TlsCert" {
  TlsCert::Mk(names: List(Text), chain: std Bytes, key: std Secret(std Bytes)),
}

data shared struct TlsServer clone as "TlsServer" {
  TlsServer::Mk(certs: List(TlsCert), alpn: List(Text), client_roots: Option(std Bytes)),
