  Polled::Running(Task('A)),
}

data shared struct Mutex<'A> clone as "Mutex" {
  Mutex::Mk(holds: fn() -> 'A shared S),
}

data affine struct MutexGuard<'A> as "MutexGuard" {
  MutexGuard::Mk(holds: fn() -> 'A shared S),
}

data shared struct Semaphore clone as "Semaphore" {
  Semaphore::Mk(count: std Mutex(u64), gate: std Mutex(Unit)),
}

data shared struct Channel<'A> clone as "Channel" {
  Channel::Mk(queue: std Mutex(Fifo('A)), slots: Semaphore, items: Semaphore),
}

data affine enum Received<'A> {
  Received::Arrived('A),
  Received::Closed,
  Received::NotYet,
}

data affine struct Fifo<'A> clone as "Fifo" {
  Fifo::Mk(front: Vec('A), back: Vec('A), closed: Bool),
}

data affine struct Placed<'T> clone view as "Placed" {
  Placed::Mk(value: 'T, at: std Place('T)),
}

data shared struct RcPlaced<'T> clone as "RcPlaced" {
  RcPlaced::Mk(value: 'T, at: std RcPlace('T)),
}

data affine struct A as "A" {
  A::Mk,
}

data affine struct B as "B" {
  B::Mk,
}

fn $"<top>"@0(): Unit S = {
  let a#1 := A::Mk: A;
  let b#2 := B::Mk: B;
  {
    let dropped_after#4294967295 := keep@1(move a#1): Unit;
    builtin drop(move b#2): Unit;
    move dropped_after#4294967295
  }
}

fn keep@1(a#3: A): Unit S = {
  let dropped_after#4294967294 := {};
  builtin drop(move a#3): Unit;
  move dropped_after#4294967294
}

top $"<top>"@0
