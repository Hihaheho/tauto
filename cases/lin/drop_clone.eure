data affine struct TlsStream as "TlsStream" {
  TlsStream::Mk(id: u64, alpn: Option(Text), server_name: Option(Text), peer_certificate: Option(std Bytes)),
}

data copy struct TlsStopper clone copy as "TlsStopper" {
  TlsStopper::Mk(id: u64),
