}

data shared enum IoError clone {
  IoError::Denied(Text),
  IoError::Failed(Text),
  IoError::TimedOut,
}

data copy enum FileKind clone copy {
  FileKind::IsFile,
  FileKind::IsDir,
  FileKind::IsOther,
}

data copy struct FileStat clone copy as "FileStat" {
  FileStat::Mk(kind: FileKind, size: u64, modified_ms: u64, executable: Bool),
}

data shared struct Process clone as "Process" {
  Process::Mk(program: Text, args: List(Text), dir: Text, env: List(Pair(Text, Text)), stdin: std Bytes),
}

data shared struct ProcessOutput clone as "ProcessOutput" {
  ProcessOutput::Mk(status: Option(u64), stdout: std Bytes, stderr: Text),
