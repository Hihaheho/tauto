@ cases.holder-with-drop-lives-to-scope-end
source = ```nib

struct(affine) F {}
extern {
  type(affine, borrow) Guard
  fn lock(v: &Vec(F)): Guard
  fn peek(g: &Guard): i64
}
var v := Vec::new()
Vec::push(&mut v, F {})
let g := lock(&v)
peek(&g)
let w := v
```
lin = "error: v is frozen by g"

@ cases.borrow-param-dead-after-last-use
source = ```nib

struct(affine) F { n: i64 }
fn size(f: &F): i64 { f.n }
fn twice(v: &mut Vec(F)): i64 {
  let first := Vec::get(v, 0)
  let n := match first {
    Some(f) => size(&f)
    None => 0
  }
  Vec::push(v, F { n: n })
  n
}
var v := Vec::new()
twice(&mut v)
```
lin = "ok"

