// A value that holds a borrow freezes its owner only while it is live: while
// the code after it may still read it before a whole write replaces it
// (`docs/design/ownership.md`「凍結は最後の使用で解ける」). A value whose type
// has an opaque view in it (`type(affine, borrow)`) may use what it borrows
// when it is dropped, so it lives to the end of its scope. `F` is an affine
// struct, so that the freeze is the point.

@ cases.holder-dead-after-last-use-frees-owner
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn show_h(h: &Holder): i64 { h.r.n }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
let h := Holder { r: &a }
show_h(&h)
take(a)
```
lin = "ok"

@ cases.holder-used-later-keeps-owner-frozen
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn show_h(h: &Holder): i64 { h.r.n }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
let h := Holder { r: &a }
take(a)
show_h(&h)
```
lin = "error: a is frozen by h"

@ cases.var-holder-overwritten-frees-owner
source = ```nib

struct(affine) F { n: i64 }
fn peek(o: &Option(&F)): i64 { 1 }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
var o := Some(&a)
peek(&o)
o := None
take(a)
```
lin = "ok"

@ cases.var-holder-overwritten-before-next-read-frees-owner
description = "Between the move and the write, nothing reads `o`: the read after the write reads the new value."
source = ```nib

struct(affine) F { n: i64 }
fn peek(o: &Option(&F)): i64 { 1 }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
var o := Some(&a)
peek(&o)
take(a)
o := None
peek(&o)
```
lin = "ok"

@ cases.var-holder-read-in-next-iteration-keeps-frozen
source = ```nib

struct(affine) F { n: i64 }
fn peek(o: &Option(&F)): i64 { 1 }
var v := Vec::new()
Vec::push(&mut v, F { n: 1 })
var cur := Vec::get(&v, 0)
var i := 0
while i < 2 {
  peek(&cur)
  Vec::push(&mut v, F { n: 2 })
  i := i + 1
}
```
lin = "error: v is frozen by cur"

