@ cases.var-holder-assigned-before-next-read-frees-owner
description = "The write at the end of the turn replaces `cur` before the next turn reads it."
source = ```nib

struct(affine) F { n: i64 }
fn peek(o: &Option(&F)): i64 { 1 }
var v := Vec::new()
Vec::push(&mut v, F { n: 1 })
var cur := Vec::get(&v, 0)
var i := 0
while i < 2 {
  peek(&cur)
  cur := None
  Vec::push(&mut v, F { n: 2 })
  cur := Vec::get(&v, 0)
  i := i + 1
}
```
lin = "ok"

@ cases.holder-dead-in-both-arms-frees-owner
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn size(h: &Holder): i64 { h.r.n }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
let h := Holder { r: &a }
let n := if true { size(&h) } else { 0 }
show(&(n + take(a)))
```
stdout = "2\n"

@ cases.holder-read-through-another-holder-keeps-frozen
source = ```nib

struct(affine) F { n: i64 }
fn size(f: Option(&F)): i64 { match f { Some(f) => f.n, None => 0 } }
var v := Vec::new()
Vec::push(&mut v, F { n: 1 })
let o := Vec::get(&v, 0)
let p := #(o, 1)
Vec::push(&mut v, F { n: 2 })
let q := p
```
lin = "error: v is frozen by p"

@ cases.mut-borrow-counts-as-read
description = "`&mut h` reads `h`: what `h` borrows stays frozen up to it."
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F, k: i64 }
fn bump(h: &mut Holder): i64 { 1 }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
var h := Holder { r: &a, k: 0 }
let m := take(a)
bump(&mut h)
```
lin = "error: a is frozen by h"

@ cases.holder-moved-into-let-frees-owner-after-new-holder
description = "`let g := h` moves the holder `h`: `g` holds what `h` borrowed, and the freeze follows `g` (`LastUse.move_let_same`)."
source = ```nib

struct(affine) F { n: i64 }
struct(affine) Holder { r: &F }
fn show_h(h: &Holder): i64 { h.r.n }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
let h := Holder { r: &a }
let g := h
show_h(&g)
take(a)
```
lin = "ok"

@ cases.holder-moved-into-let-keeps-owner-frozen-while-new-holder-live
source = ```nib

struct(affine) F { n: i64 }
struct(affine) Holder { r: &F }
fn show_h(h: &Holder): i64 { h.r.n }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
let h := Holder { r: &a }
let g := h
take(a)
show_h(&g)
```
lin = "error: a is frozen by g"

@ cases.holder-moved-into-call-result-keeps-owner-frozen
description = "A holder moved into a call whose result holds a borrow: the result freezes what the holder borrowed while it is live."
source = ```nib

struct(affine) F { n: i64 }
struct(affine) Holder { r: &F }
fn keep(h: Holder): Holder { h }
fn show_h(h: &Holder): i64 { h.r.n }
fn take(f: F): i64 { f.n }
let a := F { n: 1 }
let h := Holder { r: &a }
let g := keep(h)
take(a)
show_h(&g)
```
lin = "error: a is frozen by g"
