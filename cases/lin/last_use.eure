@ cases.holder-live-in-one-arm-only
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn show_h(h: &Holder): i64 { h.r.n }
fn take(f: F): i64 { f.n }
fn pick(c: Bool): i64 {
  let a := F { n: 1 }
  let h := Holder { r: &a }
  if c {
    take(a)
  } else {
    show_h(&h)
  }
}
pick(true)
```
lin = "ok"

@ cases.holder-live-in-other-arm-after-move-keeps-frozen
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn show_h(h: &Holder): i64 { h.r.n }
fn take(f: F): i64 { f.n }
fn pick(c: Bool): i64 {
  let a := F { n: 1 }
  let h := Holder { r: &a }
  if c {
    take(a)
  } else {
    0
  }
  show_h(&h)
}
pick(true)
```
lin = "error: a is frozen by h"

