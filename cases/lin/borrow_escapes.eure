fn both(f: &((i64) -> i64 ! {}), g: &((i64) -> i64 ! {})): i64 { f(1) + g(2) }
fn go(on: &((i64) -> i64 ! {})): i64 {
  let g := on
  both(g, on)
}
```
lin = "error: on is borrowed twice in one call"

@ cases.borrowed-function-lent-twice-through-its-borrow
source = ```nib
fn both(f: &((i64) -> i64 ! {}), g: &((i64) -> i64 ! {})): i64 { f(1) + g(2) }
fn go(on: &((i64) -> i64 ! {})): i64 {
