// A closure written in place that calls a lent function holds it for the call.
@ cases.borrowed-function-lent-and-called-by-a-closure-in-one-call
source = ```nib
fn both(f: &((i64) -> i64 ! {}), g: &((i64) -> i64 ! {})): i64 { f(1) + g(2) }
fn go(on: &((i64) -> i64 ! {})): i64 { both(on, (x: i64) => on(x)) }
```
lin = "error: on is borrowed twice in one call"

// Calling a lent function is an exclusive use of it too: an argument
