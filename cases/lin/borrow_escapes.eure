// Borrows that must not leave their scope: the value of a block or a match
// arm cannot borrow a binding of that block or arm, a value put into a `&mut`
// argument freezes what it holds as a borrow does, and a value that holds a
// borrow is no more an effect argument than the borrow is.

@ cases.block-tail-holder-of-inner-local
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn size(f: &F): i64 { f.n }
fn take(f: F): i64 { f.n }
effect keep(h: Holder): ()
effect keepo(h: Option(Holder)): ()
fn wrap(x: &F): Holder { Holder { r: x } }

fn go(): i64 { let h := { let b := F { n: 2 }
  let k := Holder { r: &b }
  k }
  size(&h.r) }
show(&go())
```
lin = "error: a borrow of b cannot be returned"

@ cases.block-tail-borrow-of-inner-local
