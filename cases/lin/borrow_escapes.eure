  match o {
    Some(f) => f(1)
    None => 0
  }
}
```
lin = "ok"

// Owned data holds no lent function, so a `&` of a function read out of it
// is the function (`&A ≡ A`).
@ cases.function-copied-out-of-owned-data-is-kept
extract = true
source = ```nib
import std::indexed_map { IndexedMap }
fn find(m: &IndexedMap(u64, (i64) -> i64 ! {}), w: u64): Option((i64) -> i64 ! {}) {
  match IndexedMap::get(&m, &w) {
    None => None
    Some(f) => Some(f)
  }
}
```
lin = "ok"

// A borrowed function parameter is lent on to another `&` parameter, as in a
// recursion: the reborrow ends with the call, so it does not outlive the
// closure the caller lent.
@ cases.borrowed-function-parameter-lent-on-is-ok
source = ```nib
fn each(xs: List(i64), on: &((i64) -> i64 ! {})): i64 {
  match xs {
    Nil => 0
    Cons(x, rest) => on(x) + each(rest, on)
  }
}
fn twice(on: &((i64) -> i64 ! {})): i64 { each(Cons(1, Nil), &on) + each(Nil, on) }
```
lin = "ok"

// Lending a borrowed function is an exclusive use: it is lent to one
// parameter of a call at a time.
@ cases.borrowed-function-parameter-lent-twice-in-one-call
source = ```nib
fn both(f: &((i64) -> i64 ! {}), g: &((i64) -> i64 ! {})): i64 { f(1) + g(2) }
fn go(on: &((i64) -> i64 ! {})): i64 { both(on, on) }
```
lin = "error: on is borrowed twice in one call"

// Another name of a lent function is the same function.
@ cases.borrowed-function-lent-twice-under-another-name
