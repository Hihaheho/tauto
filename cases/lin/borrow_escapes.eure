// A `-> &F` function gives back the function it was lent: its result is
// lent as its argument is.
@ cases.result-of-borrowed-function-is-lent
source = ```nib
fn same(cb: &((i64) -> i64 ! {})): &((i64) -> i64 ! {}) { cb }
fn make(): (i64) -> i64 ! {} {
  var n := 0
  let g := same((x: i64) => { n := n + x; n })
  g
}
```
lin = "error: a borrow of n cannot be returned"

// A closure written in place that owns an affine value is dropped when the
// call returns, so nothing of the call's value may be that closure.
@ cases.result-of-owning-closure-written-in-place-is-not-kept
source = ```nib
struct(affine) F { n: i64 }
fn size(f: &F): i64 { f.n }
fn same(cb: &((i64) -> i64 ! {})): &((i64) -> i64 ! {}) { cb }
fn make(): i64 {
  let b := F { n: 7 }
  let g := same((x: i64) => size(&b))
  g(1)
}
```
lin = "error: a borrowed function cannot be kept: it can only be called or lent"

// A type parameter stands for values that are kept: `x: &A` is copied out as
// an `A`, so a lent function is not given to it.
@ cases.borrowed-function-is-not-lent-to-a-type-parameter
source = ```nib
struct(affine) F { n: i64 }
fn size(f: &F): i64 { f.n }
fn keep<A: Shared>(x: &A): A { x }
fn make(): (i64) -> i64 ! {} {
  let b := F { n: 7 }
  keep((x: i64) => size(&b))
}
```
lin = "error: a borrowed function can only be lent to a parameter declared as a borrowed function"

// A value that holds a lent function borrows what the function does.
@ cases.holder-of-borrowed-function-borrows-its-captures
source = ```nib
struct(affine) F { n: i64 }
struct Holder { f: &((i64) -> i64 ! {}) }
fn size(f: &F): i64 { f.n }
fn hold(cb: &((i64) -> i64 ! {})): Holder { Holder { f: &cb } }
fn make(): Holder {
  var b := F { n: 7 }
  hold((x: i64) => size(&b))
}
```
lin = "error: a borrow of b cannot be returned"

@ cases.function-matched-out-of-borrowed-holder-is-lent
