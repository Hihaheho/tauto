@ cases.borrowed-function-lent-under-another-name-in-separate-calls-is-ok
source = ```nib
fn apply(f: &((i64) -> i64 ! {})): i64 { f(1) }
fn go(on: &((i64) -> i64 ! {})): i64 {
  let g := on
  apply(g) + apply(on) + apply((x: i64) => on(x))
}
```
lin = "ok"
