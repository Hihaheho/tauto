@ cases.push-holder-freezes-owner
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn size(f: &F): i64 { f.n }
fn take(f: F): i64 { f.n }

let b := F { n: 2 }
var v := Vec::new()
Vec::push(&mut v, Holder { r: &b })
show(&take(b))
match Vec::pop(&mut v) {
  Some(h) => show(&size(&h.r))
  None => show(&0)
}
```
lin = "error: b is frozen by v"

@ cases.push-holder-of-inner-local-does-not-live-long-enough
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn size(f: &F): i64 { f.n }
fn take(f: F): i64 { f.n }
var v := Vec::new()
{
  let b := F { n: 2 }
  Vec::push(&mut v, Holder { r: &b })
}
show(&Vec::len(&v))
```
lin = "error: b does not live as long as v, which borrows it"

@ cases.effect-argument-holder-literal
source = ```nib

struct(affine) F { n: i64 }
struct Holder { r: &F }
fn size(f: &F): i64 { f.n }
fn take(f: F): i64 { f.n }
effect keep(h: Holder): ()
effect keepo(h: Option(Holder)): ()
fn wrap(x: &F): Holder { Holder { r: x } }

fn go(): () ! {keep} { let b := F { n: 2 }
  perform keep(Holder { r: &b }) }
```
lin = "error: a borrow cannot be an effect argument"

