// A function behind `&` may be a closure that borrows its caller's locals,
// or one that owns what it captured and is gone when the call returns. Such a
// lent function is called or lent on; it is not copied out as `&A ≡ A` copies
// duplicable data. The cases follow one from each place it could leave by.
@ cases.borrowed-function-parameter-cannot-be-returned
source = ```nib
fn keep(cb: &((i64) -> i64 ! {})): (i64) -> i64 ! {} { cb }
```
lin = "error: a borrowed function cannot be kept: it can only be called or lent"

@ cases.closure-capturing-borrowed-function-parameter-cannot-be-returned
source = ```nib
fn keep(cb: &((i64) -> i64 ! {})): (i64) -> i64 ! {} { (x: i64) => cb(x) }
```
lin = "error: this closure borrows cb and cannot be stored"

@ cases.borrowed-function-parameter-called-is-ok
source = ```nib
struct(affine) F { n: i64 }
fn size(f: &F): i64 { f.n }
fn twice(cb: &((i64) -> i64 ! {})): i64 { cb(1) + cb(2) }
fn make(): i64 {
  let b := F { n: 7 }
  twice((x: i64) => size(&b))
}
```
lin = "ok"

@ cases.borrowed-function-is-lent-on-and-renamed
source = ```nib
fn apply(f: &((i64) -> i64 ! {})): i64 { f(1) }
fn same(cb: &((i64) -> i64 ! {})): &((i64) -> i64 ! {}) { cb }
fn twice(cb: &((i64) -> i64 ! {})): i64 {
  let g := same(cb)
  let h := cb
  apply(cb) + apply(g) + g(2) + h(3) + apply((x: i64) => cb(x))
}
```
lin = "ok"

