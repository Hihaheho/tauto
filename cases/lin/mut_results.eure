// `): &mut A` and `let x`.

@ cases.get-mut-writes-through
source = ```nib

var v := Vec::new()
Vec::push(&mut v, 1)
match Vec::get_mut(&mut v, 0) {
  Some(x) => { *x := 5 }
  None => #()
}
match Vec::get(&v, 0) {
  Some(x) => show(&x)
  None => #()
}
```
stdout = "5\n"

@ cases.hashmap-get-mut-writes-through
source = ```nib
import std::indexed_map { IndexedMap }

var m := IndexedMap::new()
IndexedMap::insert(&mut m, "a", 1)
match IndexedMap::get_mut(&mut m, "a") {
  Some(x) => { *x := x + 41 }
  None => #()
}
match IndexedMap::get(&m, "a") {
  Some(x) => show(&x)
  None => #()
}
```
stdout = "42\n"

@ cases.let-mut-freezes-all
source = ```nib
struct(affine) F {}
var v := Vec::new()
Vec::push(&mut v, F {})
let x := Vec::last_mut(&mut v)
Vec::len(&v)
let used_later := &x
```
lin = "error: v is frozen by x"

@ cases.let-mut-ends-with-block
source = ```nib
struct(affine) F {}
var v := Vec::new()
Vec::push(&mut v, F {})
{
  let x := Vec::last_mut(&mut v)
}
Vec::len(&v)
```
lin = "ok"

@ cases.mut-result-needs-mut-param
source = "fn f(x: &i64): &mut i64 { x }"
types = "error: -> &mut i64 needs a &mut parameter"

@ cases.mut-result-of-dup-binds-borrow
source = ```nib
fn last(x: &mut i64): &mut i64 { x }
var n := 1
let m := last(&mut n)
```
lin = "ok"

@ cases.mut-result-writes-through
source = ```nib
fn same(x: &mut i64): &mut i64 { x }
var n := 1
{
  let m := same(&mut n)
  *m := 9
}
show(&n)
```
stdout = "9\n"

@ cases.mut-result-lends-a-field
source = ```nib
struct S { n: u64 }
fn field(s: &mut S): &mut u64 { s.n }
var s := S { n: 1 }
{
  let n := field(&mut s)
  *n := n + 1
}
show(&s.n)
```
stdout = "2\n"

@ cases.mut-result-lends-an-affine-field-by-branch
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```nib

struct In { v: Vec(i64), k: i64 }
struct Out { a: In, b: In }
fn pick(o: &mut Out, left: Bool): &mut In {
  if left { o.a } else { o.b }
}
var o := Out { a: In { v: Vec::new(), k: 0 }, b: In { v: Vec::new(), k: 0 } }
{
  let x := pick(&mut o, false)
  x.k := 5
  Vec::push(&mut x.v, 9)
}
o.a.k := 1
show(&o)
```
stdout = "Out { a: In { v: Vec[], k: 1 }, b: In { v: Vec[9], k: 5 } }\n"

@ cases.closure-mut-result-freezes-owner
source = ```nib
var v := Vec::new()
Vec::push(&mut v, 1)
let g := (v: &mut Vec(i64)) => Vec::last_mut(&mut v)
let r := g(&mut v)
Vec::push(&mut v, 2)
let used_later := &r
```
lin = "error: v is frozen by r"
