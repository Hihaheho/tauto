// Continuations kept in a storage: the cycle check reads what they hold
// (`docs/design/shared-levels.md`).

@ cases.a-generator-kept-in-a-mutex-runs
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `mutex_new` yet"
source = ```nib
import std::builtin::par

effect tick(n: nat): Unit
enum(affine) S { Done, More(nat, affine (Unit) -> S ! {}) }
fn gen(n: nat): S ! {} {
  handle {
    perform tick(n)
    perform tick(n + 1)
  } with {
    return _ => Done
    tick(x), k => More(x, k)
  }
}
fn step(m: Mutex(S)): nat ! {wait, mutex_claim, mutex_take_claimed, mutex_put} {
  match Mutex::take(m) {
    More(x, k) => {
      perform mutex_put(m, k(#()))
      x
    }
    Done => {
      perform mutex_put(m, Done)
      0
    }
  }
}
let m := perform mutex_new(gen(1))
let a := step(m)
let b := step(m)
let c := step(m)
show(&a)
show(&b)
show(&c)
```
lin = "ok"
stdout = ```
1
2
0
```

@ cases.a-multi-shot-continuation-kept-in-a-mutex-runs
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `mutex_new` yet"
source = ```nib
import std::builtin::par

effect choose(): Bool resume ω
enum S { Done(i64), More((Bool) -> S ! {}) }
fn pick(): S ! {} {
  handle {
    let b := perform choose()
    if b { 10 } else { 20 }
  } with {
    return v => Done(v)
    choose(), k => More(k)
  }
}
fn run(s: S, b: Bool): i64 {
  match s {
    More(k) => match k(b) {
      Done(v) => v
      More(_) => 0
    }
    Done(v) => v
  }
}
let m := perform mutex_new(pick())
let s := Mutex::take(m)
show(&run(s, true))
show(&run(s, false))
perform mutex_put(m, s)
```
lin = "ok"
stdout = ```
10
20
```

@ cases.a-kept-continuation-shows-where-it-is-resumed
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
// What the body performs and does not handle goes to the code that resumes it.
source = ```nib
import std::builtin::os
effect tick(): Unit
enum(affine) S { Done, More(affine (Unit) -> S ! {Show}) }
fn say(n: i64): Unit ! {Show} { show(&n) }
fn gen(): S ! {stdout, stdout_flush} {
  handle {
    show(&1)
    perform tick()
    say(2)
    perform tick()
    show(&3)
    Done
  } with {
    return s => s
    tick(), k => More(k)
  }
}
fn step(s: S): S ! {Show} {
  match s { More(k) => k(#()), Done => Done }
}
let s0 := gen()
let s1 := step(s0)
let s2 := step(s1)
show(&0)
```
lin = "ok"
stdout = ```
1
2
3
0
```

@ cases.a-kept-continuation-meets-the-direct-handlers-of-its-resumer
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
// A `direct` handler inside the body is part of the continuation; the one
// around each resume answers what goes out of it.
source = ```nib
import std::builtin::os
effect tick(): Unit
effect log(n: u64): Unit direct
enum(affine) S { Done, More(affine (Unit) -> S ! {log}) }
fn gen(): S ! {log} {
  handle {
    perform log(1)
    perform tick()
    handle {
      perform log(2)
      perform tick()
      perform log(3)
    } with {
      log(n), k => k(perform log(U64::wrapping_mul(n, 10)))
    }
    Done
  } with {
    return s => s
    tick(), k => More(k)
  }
}
fn step(s: S, tag: u64): S ! {stdout, stdout_flush} {
  handle {
    match s { More(k) => k(#()), Done => Done }
  } with {
    log(n), k => k(show(&(U64::wrapping_add(U64::wrapping_mul(tag, 1000), n))))
  }
}
let s0 := handle { gen() } with { log(n), k => k(show(&n)) }
let s1 := step(s0, 1)
let s2 := step(s1, 2)
show(&0)
```
lin = "ok"
stdout = ```
1
1020
2030
0
```

@ cases.a-kept-multi-shot-continuation-shows-each-time
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
import std::builtin::os
effect choose(): Bool resume ω
enum S { Done(i64), More((Bool) -> S ! {Show}) }
fn pick(): S ! {stdout, stdout_flush} {
  handle {
    let b := perform choose()
    show(&b)
    if b { 10 } else { 20 }
  } with {
    return v => Done(v)
    choose(), k => More(k)
  }
}
fn run(s: S, b: Bool): i64 ! {Show} {
  match s {
    More(k) => match k(b) { Done(v) => v, More(_) => 0 }
    Done(v) => v
  }
}
let s := pick()
show(&run(s, true))
show(&run(s, false))
```
