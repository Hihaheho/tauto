@ cases.an-arm-that-keeps-its-continuation-in-a-mutex-it-sees-is-a-cycle
// A resume reinstalls the handler, and the handler holds the mutex.
source = ```nib
effect tick(): Unit
enum(affine) S { Done, More(affine (Unit) -> S ! {}) }
fn top(): Unit {
  let m := perform mutex_new(Done)
  let t := handle {
    perform tick()
    Done
  } with {
    tick(), k => {
      perform mutex_put(m, More(k))
      Done
    }
  }
}
```
lin = "error: strong reference cycle"

@ cases.a-finished-call-is-not-on-the-stack-of-a-kept-continuation
// `holder` returned before `tick`, and its row has no effect a kept
// continuation captures, so its frame is not held.
source = ```nib
import std::builtin::par
effect tick(): Unit
effect slot(): Mutex(S) direct
enum(affine) S { Done, More(affine (Unit) -> S ! {slot, mutex_put}) }
fn holder(): Unit ! {slot, mutex_put} { perform mutex_put(perform slot(), Done) }
fn through<!e>(f: () -> Unit ! e): Unit ! e { f() }
fn body(): S ! {slot, tick, mutex_put} { holder(); perform tick(); Done }
fn gen(): S ! {slot, mutex_put} {
  handle { body() } with {
    return _ => Done
    tick(), k => More(k)
  }
}
fn top(): Unit ! {mutex_new, mutex_put} {
  let m := perform mutex_new(Done)
  let s := handle { gen() } with {
    slot(), k => k(m)
  }
  perform mutex_put(m, s)
}
top()
```
lin = "ok"

@ cases.a-call-that-can-suspend-is-on-the-stack-of-a-kept-continuation
// `body` performs `tick` while it holds `q`, so `k` holds the mutex.
source = ```nib
import std::builtin::par
effect tick(): Unit
effect slot(): Mutex(S) direct
enum(affine) S { Done, More(affine (Unit) -> S ! {slot, mutex_put}) }
fn holder(): Unit ! {slot, mutex_put} { perform mutex_put(perform slot(), Done) }
fn through<!e>(f: () -> Unit ! e): Unit ! e { f() }
fn body(): S ! {slot, tick, mutex_put} { let q := perform slot(); perform tick(); perform mutex_put(q, Done); Done }
fn gen(): S ! {slot, mutex_put} {
  handle { body() } with {
    return _ => Done
    tick(), k => More(k)
  }
}
fn top(): Unit ! {mutex_new, mutex_put} {
  let m := perform mutex_new(Done)
  let s := handle { gen() } with {
    slot(), k => k(m)
  }
  perform mutex_put(m, s)
}
top()
```
lin = "error: strong reference cycle"

@ cases.a-kept-continuation-that-calls-a-function-value-is-dropped
llvm.unimplemented = "unsupported: a function value that performs a direct operation, in a continuation kept as a value"
vm.unimplemented = "unsupported: the host request Probe::new"
// The continuation owns what its body holds: run once, or dropped without
// being run, it drops it.
files_tote = "p"
stdout = ```
1
2
0
```
probe_drops = ["ran", "kept"]

files."p/Tauto.eure" = 'package { name = "p" }'
files."p/src/main.taut" = ```tauto
struct(affine) Probe {}
extern {
  fn Probe::new(name: &Text): Probe
}
effect tick(): Unit
enum(affine) S { Done, More(affine (Unit) -> S ! {Show}) }
fn each(f: (i64) -> Unit ! {Show}): Unit ! {Show} { f(1); f(2) }
fn gen(held: Probe): S ! {Show} {
  handle {
    let mine := held
    perform tick()
    each((n) => show(&n))
    Done
  } with {
    return s => s
    tick(), k => More(k)
  }
}
perform main(() => {
  match gen(Probe::new("ran")) { More(k) => { let ^continued := k(#()) }, Done => #() }
  let kept := gen(Probe::new("kept"))
  show(&0)
})
```

@ cases.a-generic-root-keeps-a-multi-shot-continuation-under-a-direct-handler
llvm.unimplemented = "unsupported: a function value that performs a direct operation, in a continuation kept as a value"
// The body is a function value of the M tier, and the value the arm keeps
// resumes it again: the `direct` handler of the same `handle` answers what
// the body performs each time, and an operation it does not answer goes to
// the code that runs the value.
source = ```tauto
import std::builtin::par { Ref, ref_get, ref_new }
import std::builtin::os { stdout }

enum Forked { Child, Parent(() -> Nat ! {ref_get}) }
enum Out(T: Type) { Built(T), Ran(Nat) }
effect fork(): Forked resume ω
effect ui(): Nat direct
effect done(n: Nat): Never resume 0

fn rooted<T>(t: Nat, body: () -> T ! {ui, fork, done, ref_get}): Option(T) ! {ref_get} {
  let out := handle { Built(body()) } with {
    ui(), k => k(t)
    fork(), k => k(Parent(() => match k(Child) { Ran(n) => n, Built(_) => 0 }))
    done(n) => Ran(n)
    return x => x
  }
  match out { Built(x) => Some(x), _ => None }
}

fn build(r: Ref(Nat)): Nat ! {ui, fork, done, ref_get} {
  match perform fork() {
    Child => perform done(perform ui() + perform ref_get(r))
    Parent(run) => run() + 1
  }
}

let r: Ref(Nat) := perform ref_new(40)
match rooted(1, () => build(r)) {
  Some(n) => perform stdout(concat(debug(&n), "\n"))
  None => perform stdout("none\n")
}
```
stdout = ```
42
```

@ cases.a-kept-continuation-asks-the-handlers-of-whoever-resumes-it
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
// The continuation is made under one `direct` handler of `ask` and resumed
// under two others: each time, the one around the code that resumes it
// answers.
source = ```tauto
import std::builtin::os { stdout }

enum Kept { Got(Nat), Paused(() -> Nat ! {ask}) }
effect ask(): Nat direct
effect pause(): () resume ω

fn start(): Kept ! {ask} {
  handle {
    perform pause()
    Got(perform ask())
  } with {
    pause(), k => Paused(() => match k(()) { Got(n) => n, Paused(_) => 0 })
    return x => x
  }
}

let kept := handle { start() } with { ask(), k => k(0) }
match kept {
  Paused(run) => {
    let a := handle { run() } with { ask(), k => k(1) }
    let b := handle { run() } with { ask(), k => k(2) }
    perform stdout(concat(debug(&a), concat(" ", concat(debug(&b), "\n"))))
  }
  Got(_) => perform stdout("none\n")
}
```
stdout = ```
1 2
```
