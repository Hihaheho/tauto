@ cases.a-kept-continuation-that-calls-a-showing-function-value
llvm.unimplemented = "unsupported: a function value that performs a direct operation, in a continuation kept as a value"
// A function value is given its handlers at the call: in a kept
// continuation, those of the code that resumes it.
source = ```nib
import std::builtin::os
effect tick(): Unit
enum(affine) S { Done, More(affine (Unit) -> S ! {Show}) }
fn each(f: (i64) -> Unit ! {Show}): Unit ! {Show} { f(1); f(2) }
fn gen(): S ! {stdout, stdout_flush} {
  handle {
    perform tick()
    each((n) => show(&n))
    Done
  } with {
    return s => s
    tick(), k => More(k)
  }
}
match gen() { More(k) => { let ^continued := k(#()) }, Done => #() }
```
