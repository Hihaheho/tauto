@ cases.a-multi-shot-continuation-in-a-function-value-reads-a-ref
llvm.unimplemented = "unsupported: a function value that performs a direct operation, in a continuation kept as a value"
// The arm hands the body a function value that resumes the body again; the
// value reads a `Ref` there, which the code that runs it answers.
source = ```tauto
import std::builtin::par { Ref, ref_get, ref_new }
import std::builtin::os { stdout }

effect fork(): Option(() -> Nat ! {ref_get}) resume ω

fn body(r: Ref(Nat)): Nat ! {fork, ref_get} {
  match perform fork() {
    None => perform ref_get(r)
    Some(run) => run() + 1
  }
}

fn rooted(r: Ref(Nat)): Nat ! {ref_get} {
  handle { body(r) } with {
    fork(), k => k(Some(() => k(None)))
    return x => x
  }
}

let r: Ref(Nat) := perform ref_new(41)
perform stdout(concat(debug(&rooted(r)), "\n"))
```
stdout = ```
42
```

@ cases.a-function-value-in-a-kept-continuation-meets-the-direct-handlers-inside-it
llvm.unimplemented = "unsupported: a function value that performs a direct operation, in a continuation kept as a value"
// A `direct` handler inside the body answers what a function value called
// there performs, before the handlers of the code that resumes the body.
source = ```nib
import std::builtin::os
effect fork(): Option(() -> u64 ! {log}) resume ω
effect log(n: u64): Unit direct
fn body(): u64 ! {fork, log} {
  handle {
    match perform fork() {
      None => { perform log(1); 1 }
      Some(run) => { let v := run(); perform log(2); U64::wrapping_add(v, 1) }
    }
  } with {
    log(n), k => k(perform log(U64::wrapping_mul(n, 10)))
  }
}
fn rooted(): u64 ! {log} {
  handle { body() } with {
    fork(), k => k(Some(() => { perform log(5); k(None) }))
    return x => x
  }
}
let r := handle { rooted() } with { log(n), k => k(show(&n)) }
show(&r)
```
lin = "ok"
stdout = ```
50
100
20
2
```

@ cases.a-continuation-whose-body-holds-its-mutex-is-a-cycle
source = ```nib
effect tick(): Unit
enum(affine) S { Done, More(affine (Unit) -> S ! {}) }
let m := perform mutex_new(Done)
let s := handle {
  perform tick()
  perform mutex_put(m, Done)
} with {
  return _ => Done
  tick(), k => More(k)
}
perform mutex_put(m, s)
```
lin = "error: strong reference cycle"

