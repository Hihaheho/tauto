// `direct` operations: an arm that continues with
// `k(e)` at the end of every path, and runs as an ordinary call.

@ cases.direct-arm-k-of-e
source = ```nib
effect log: (t: Text) -> () direct
let r = handle { perform log("a") } with {
  log(t), k => k(())
}
```
types = "ok"

@ cases.direct-arm-block-tail
source = ```nib
effect log: (t: Text) -> () direct
let r = handle { perform log("a") } with {
  log(t), k => {
    perform show("t", t)
    k(())
  }
}
```
types = "ok"

@ cases.direct-arm-if-tail
source = ```nib
effect log: (t: Text) -> () direct
let r = handle { perform log("a") } with {
  log(t), k => if t == "a" { k(()) } else {
    perform show("t", t)
    k(())
  }
}
```
types = "ok"

@ cases.direct-arm-match-tail
source = ```nib
effect get: () -> i64 direct
let o: Option(i64) = Some(1)
let r = handle { perform get() } with {
  get(), k => match o {
    Some(v) => k(v)
    None => k(0)
  }
}
```
types = "ok"

@ cases.direct-arm-k-twice-rejected
source = ```nib
effect log: (t: Text) -> () direct
let r = handle { perform log("a") } with {
  log(t), k => k(k(()))
}
```
types = "error: log is direct; every path of its arm must end in k(e)"

