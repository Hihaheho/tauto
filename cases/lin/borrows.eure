@ cases.match-on-borrow-binds-borrows
source = ```nib
enum(affine) Expr { Num(i64), Add(Expr, Expr) }
fn eval(e: &Expr): i64 {
  match e {
    Num(n) => n
    Add(l, r) => eval(l) + eval(r)
  }
}
```
lin = "ok"

@ cases.match-consumes-owner
source = ```nib
enum(affine) Expr { Num(i64), Add(Expr, Expr) }
fn s(e: Expr): Expr {
  match e {
    Add(Num(0), r) => r
    _ => e
  }
}
```
lin = "error: e is used after move"

@ cases.match-rebinds-owner
source = ```nib
enum(affine) Expr { Num(i64), Add(Expr, Expr) }
fn s(e: Expr): Expr {
  match e {
    Add(Num(0), r) => r
    other => other
  }
}
```
lin = "ok"

