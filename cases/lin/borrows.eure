```
lin = "ok"

@ cases.affine-field-by-value
source = ```nib
affine struct F {}
struct W { f: F }
fn f(s: W): F { s.f }
```
lin = "error: s.f is affine; destructure s"

@ cases.moved-inside-a-loop
source = ```nib
affine struct F {}
fn consume(f: F): Unit { }
let f := F {}
var i := 0
while i < 3 {
  consume(f)
  i := i + 1
}
```
lin = "error: f is moved inside a loop"

@ cases.continuation-with-borrow-escapes
source = ```nib
effect choose(): Bool
affine enum R { Done(u64), More(affine (Bool) -> R ! {}) }
fn pick(&v: Vec(i64), b: Bool): u64 { Vec::len(&v) }
fn mk(): R ! {} {
  var v := Vec::new()
  Vec::push(&mut v, 1)
  handle { pick(&v, perform choose()) } with {
    return x => Done(x)
    choose(), k => More(k)
  }
}
```
lin = "error: k holds a borrow of v, so it may only be called in its arm"

// A closure that captures a `var` shares its cell, whatever the content, so
// it borrows (`docs/design/ownership.md`「`let` と `var`」「借用閉包」): it is lent to a `&f` parameter
// or called in place, and never kept, returned or sent.

@ cases.var-closure-returned
source = ```nib
fn counter(): () -> i64 {
  var n := 0
  () => { n := n + 1
    n }
}
```
lin = "error: this closure borrows n and cannot be stored"

@ cases.var-closure-stored
source = ```nib
var n := 0
let f := () => { n := n + 1 }
let h := Pair { fst: f, snd: 1 }
```
lin = "error: f borrows n and cannot be stored"

@ cases.var-local-fn-returned
source = ```nib
fn counter(step: i64): () -> i64 {
  var n := 0
  fn next(): i64 {
    n := n + step
    n
  }
  next
}
```
lin = "error: next borrows n and cannot be stored"

@ cases.var-local-fn-passed-by-value
source = ```nib
fn apply(f: (i64) -> i64, x: i64): i64 { f(x) }
fn go(): i64 {
  var total := 0
  fn bump(r#by: i64): i64 {
    total := total + r#by
    total
  }
  apply(bump, 1)
}
```
lin = "error: bump borrows total and cannot be stored"

@ cases.var-closure-lent-to-a-borrowed-parameter
source = ```nib
fn go(): i64 {
  var total := 0
  each(Cons(1, Cons(2, Nil)), (x) => { total := total + x })
  total
}
```
lin = "ok"

@ cases.var-closure-called-in-place
source = ```nib
var total := 0
let add := (x) => { total := total + x }
add(5)
add(6)
```
lin = "ok"

@ cases.k-shares-a-var-of-an-arm
source = ```nib
effect choose(): Bool
affine enum R { Done(i64), More(affine (Bool) -> R ! {}) }
fn top(): R ! {} {
  var count := 0
  handle { if perform choose() { 1 } else { 2 } } with {
    return x => Done(x)
    choose(), k => {
      count := count + 1
      More(k)
    }
  }
}
```
lin = "error: k shares var count, so it may only be called in its arm"

@ cases.k-shares-a-var-of-the-body
source = ```nib
effect choose(): Bool
affine enum R { Done(i64), More(affine (Bool) -> R ! {}) }
fn top(): R ! {} {
  handle {
    var i := 0
    let b := perform choose()
    i := i + 1
    i
  } with {
    return x => Done(x)
    choose(), k => More(k)
  }
}
```
lin = "error: k shares var i, so it may only be called in its arm"

@ cases.k-called-in-place-with-a-var
source = ```nib
effect choose(): Bool resume ω
fn top(): i64 ! {} {
  var count := 0
  handle { if perform choose() { 1 } else { 2 } } with {
    choose(), k => {
      count := count + 1
      k(true) + k(false)
    }
  }
}
```
lin = "ok"

@ cases.field-assignment-needs-var-or-mut-borrow
source = ```nib
struct P { x: i64 }
fn set(&p: P): Unit { p.x := 3 }
```
types = "error: `p.x` assigns a field of a `var` or a `&mut` parameter"

@ cases.field-assignment-checks-the-field-type
source = ```nib
struct P { x: i64 }
var p := P { x: 1 }
p.x := "a"
```
types = "error: `p.x`: Text does not fit i64"

@ cases.field-assignment-after-move
source = ```nib
struct Q { v: Vec(i64), n: i64 }
var q := Q { v: Vec::new(), n: 1 }
let r := q
q.n := 2
```
lin = "error: q is used after move"

@ cases.a-var-in-a-function-value-of-the-arm-is-not-shared-with-k
source = ```nib
import std::prelude::Par

effect pause(): Unit
affine enum S { Done, More(affine (Unit) -> S ! {}) }
fn top(): S ! {} {
  handle { perform pause(); Done } with {
    pause(), k => {
      let keep := () => {
        var n := 0
        n := n + 1
        n
      }
      More(k)
    }
  }
}
```
lin = "ok"

@ cases.a-var-the-arm-declares-outside-a-function-value-still-pins-k
source = ```nib
effect pause(): Unit
affine enum S { Done, More(affine (Unit) -> S ! {}) }
fn top(): S ! {} {
  handle { perform pause(); Done } with {
    pause(), k => {
      var n := 0
      n := n + 1
      More(k)
    }
  }
}
```
lin = "error: k shares var n, so it may only be called in its arm"
