@ cases.borrow-cannot-be-field
source = "struct S { r: &Vec(i64) }"
types = "error: a borrow cannot be a field"

@ cases.borrow-cannot-be-effect-argument
source = ```nib
effect e: (v: Vec(i64)) -> ()
var v = vec_new()
vec_push(&mut v, 1)
let r = handle { perform e(&v) } with {
  e(x), k => k(())
}
```
lin = "error: a borrow cannot be an effect argument"

@ cases.let-borrow-freezes
source = ```nib
affine struct F {}
fn size(&f: F) -> i64 { 1 }
var v = vec_new()
vec_push(&mut v, F {})
let r = handle {
  let &p = vec_index(&v, 0)
  vec_push(&mut v, F {})
  size(&p)
} with {
  out_of_bounds() => 0
}
```
lin = "error: v is frozen by p"

@ cases.freeze-ends-with-block
source = ```nib
affine struct F {}
fn size(&f: F) -> i64 { 1 }
var v = vec_new()
vec_push(&mut v, F {})
let r = handle {
  let n = {
    let &p = vec_index(&v, 0)
    size(&p)
  }
  vec_push(&mut v, F {})
  n
} with {
  out_of_bounds() => 0
}
```
lin = "ok"

@ cases.borrow-of-dup-is-value
source = ```nib
fn first(&v: Vec(i64)) -> &i64 ! {out_of_bounds} { vec_index(&v, 0) }
var v = vec_new()
vec_push(&mut v, 1)
let r = handle {
  let n = first(&v)
  vec_push(&mut v, n)
  n
} with {
  out_of_bounds() => 0
}
```
lin = "ok"

@ cases.returned-borrow-derives-from-args
source = ```nib
affine struct F {}
fn pick(&a: Vec(F), &b: Vec(F)) -> &F ! {out_of_bounds} { vec_index(a, 0) }
var p = vec_new()
var q = vec_new()
vec_push(&mut p, F {})
vec_push(&mut q, F {})
let r = handle {
  let &x = pick(&p, &q)
  vec_push(&mut q, F {})
  0
} with {
  out_of_bounds() => 0
}
```
lin = "error: q is frozen by x"

@ cases.borrow-returning-needs-borrow-arg
source = ```nib
affine struct F {}
fn mk() -> &F { F {} }
```
types = "error: -> &F needs a borrowed parameter"

@ cases.closure-returning-borrow
source = ```nib
affine struct F {}
let g = (&v: Vec(F)) => vec_index(v, 0)
```
types = "error: a closure cannot return a borrow"

@ cases.match-on-borrow-binds-borrows
source = ```nib
affine enum Expr { Num(i64), Add(Expr, Expr) }
fn eval(&e: Expr) -> i64 {
  match e {
    Num(n) => n
    Add(l, r) => eval(l) + eval(r)
  }
}
```
lin = "ok"

@ cases.match-consumes-owner
source = ```nib
affine enum Expr { Num(i64), Add(Expr, Expr) }
fn s(e: Expr) -> Expr {
  match e {
    Add(Num(0), r) => r
    _ => e
  }
}
```
lin = "error: e is used after move"

@ cases.match-rebinds-owner
source = ```nib
affine enum Expr { Num(i64), Add(Expr, Expr) }
fn s(e: Expr) -> Expr {
  match e {
    Add(Num(0), r) => r
    other => other
  }
}
```
lin = "ok"

@ cases.borrow-closure-passed-to-borrow-param
source = ```nib
affine struct File {}
fn open() -> File { File {} }
fn write_line(&mut f: File, row: Text) -> () { }
var f = open()
each(Cons("a", Cons("b", Nil)), (row) => write_line(&mut f, row))
```
lin = "ok"

@ cases.borrow-closure-stored
source = ```nib
affine struct File {}
fn open() -> File { File {} }
fn write_line(&mut f: File, row: Text) -> () { }
var f = open()
let g = (s) => write_line(&mut f, s)
let h = Pair { fst: g, snd: 1 }
```
lin = "error: g borrows f and cannot be stored"

@ cases.var-move-out-in-straight-line
source = ```nib
affine struct Socket {}
fn connect() -> Socket { Socket {} }
fn write(&mut s: Socket) -> () { }
fn shutdown(s: Socket) -> () { }
var s = connect()
write(&mut s)
shutdown(s)
```
lin = "ok"

@ cases.var-move-out-in-closure
source = ```nib
affine struct Socket {}
fn connect() -> Socket { Socket {} }
fn shutdown(s: Socket) -> () { }
var s = connect()
let g = () => shutdown(s)
```
lin = "error: s is a var and cannot be moved out of a closure"

