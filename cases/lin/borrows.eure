var v := Vec::new()
Vec::push(&mut v, 1)
f(&mut v, &v)
```
lin = "error: v is borrowed twice in one call"

@ cases.shared-and-nested-mut-in-one-call
source = ```nib
fn get(a: &Vec(i64)): u64 { Vec::len(&a) }
fn grow(a: &mut Vec(i64)): u64 {
  Vec::push(&mut a, 1)
  Vec::len(&a)
}
fn add(a: &Vec(i64), n: u64): u64 { if n == 0 { get(&a) } else { n } }
var w := Vec::new()
let x := add(&w, grow(&mut w))
```
lin = "error: w is borrowed again inside an argument while an earlier argument of the call around still borrows it"

