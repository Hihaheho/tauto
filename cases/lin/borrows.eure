// Second-class borrows.

@ cases.borrow-does-not-move
source = ```nib
fn len(&v: Vec(i64)) -> u64 { vec_len(&v) }
var v = vec_new()
vec_push(&mut v, 1)
let a = len(&v)
let b = len(&v)
```
lin = "ok"

@ cases.mut-borrow-needs-var
source = ```nib
let v = vec_new()
vec_push(&mut v, 1)
```
types = "error: v is not a var"

@ cases.mut-and-shared-in-one-call
source = ```nib
fn f(&mut a: Vec(i64), &b: Vec(i64)) -> () { vec_push(&mut a, 1) }
var v = vec_new()
vec_push(&mut v, 1)
f(&mut v, &v)
```
lin = "error: v is borrowed twice in one call"

@ cases.disjoint-fields-may-both-be-mut
source = ```nib
struct P { a: Vec(i64), b: Vec(i64) }
fn f(&mut x: Vec(i64), &mut y: Vec(i64)) -> () { vec_push(&mut x, 1) }
var p = P { a: vec_new(), b: vec_new() }
f(&mut p.a, &mut p.b)
```
lin = "ok"

@ cases.move-and-borrow-in-one-call
source = ```nib
fn g(a: Vec(i64), &b: Vec(i64)) -> () { }
var v = vec_new()
vec_push(&mut v, 1)
g(v, &v)
```
lin = "error: v is borrowed after move"

