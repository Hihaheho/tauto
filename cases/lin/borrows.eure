@ cases.let-borrow-freezes
source = ```nib
struct(affine) F {}
fn size(f: &F): i64 { 1 }
var v := Vec::new()
Vec::push(&mut v, F {})
let r := handle {
  let p := Vec::index(&v, 0)
  Vec::push(&mut v, F {})
  size(&p)
} with {
  out_of_bounds() => 0
}
```
lin = "error: v is frozen by p"

@ cases.freeze-ends-with-block
source = ```nib
struct(affine) F {}
fn size(f: &F): i64 { 1 }
var v := Vec::new()
Vec::push(&mut v, F {})
let r := handle {
  let n := {
    let p := Vec::index(&v, 0)
    size(&p)
  }
  Vec::push(&mut v, F {})
  n
} with {
  out_of_bounds() => 0
}
```
lin = "ok"

// `&A` of a duplicable `A` is a borrow: an unannotated `let` keeps it, so
// the owner stays frozen while it is used.
@ cases.borrow-of-dup-kept-by-let-freezes
source = ```nib
fn first(v: &Vec(i64)): &i64 ! {out_of_bounds} { Vec::index(&v, 0) }
var v := Vec::new()
Vec::push(&mut v, 1)
let r := handle {
  let n := first(&v)
  Vec::push(&mut v, n)
  n
} with {
  out_of_bounds() => 0
}
```
lin = "error: v is frozen by n"

// Where an `A` is wanted, the borrow is copied (`&A → A`) and frees the owner.
@ cases.borrow-of-dup-copied-where-value-wanted
source = ```nib
fn first(v: &Vec(i64)): &i64 ! {out_of_bounds} { Vec::index(&v, 0) }
var v := Vec::new()
Vec::push(&mut v, 1)
let r := handle {
  let n: i64 := first(&v)
  Vec::push(&mut v, n)
  n
} with {
  out_of_bounds() => 0
}
```
lin = "ok"

@ cases.returned-borrow-derives-from-args
source = ```nib
struct(affine) F {}
fn pick(a: &Vec(F), b: &Vec(F)): &F ! {out_of_bounds} { Vec::index(a, 0) }
var p := Vec::new()
var q := Vec::new()
Vec::push(&mut p, F {})
Vec::push(&mut q, F {})
let r := handle {
  let x := pick(&p, &q)
  Vec::push(&mut q, F {})
  let used_later := &x
  0
} with {
  out_of_bounds() => 0
}
```
lin = "error: q is frozen by x"

