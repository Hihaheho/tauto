@ cases.a-var-in-a-function-value-of-the-arm-is-not-shared-with-k
source = ```nib
import std::builtin::par

effect pause(): Unit
enum(affine) S { Done, More(affine (Unit) -> S ! {}) }
fn top(): S ! {} {
  handle { perform pause(); Done } with {
    pause(), k => {
      let keep := () => {
        var n := 0
        n := n + 1
        n
      }
      More(k)
    }
  }
}
```
lin = "ok"

