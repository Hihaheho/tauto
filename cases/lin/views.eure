@ cases.view-var-advance
source = ```nib
extern {
  type(borrow) Iter(A: Type)
  fn vec_iter<A: Linear>(v: &Vec(A)): Iter(A)
  fn iter_next<A: Linear>(it: &mut Iter(A)): Option(&A)
}
var v := Vec::new()
Vec::push(&mut v, 1)
var it := vec_iter(&v)
let first := iter_next(&mut it)
```
lin = "ok"

@ cases.view-var-reassign
source = ```nib
extern {
  type(borrow) Iter(A: Type)
  fn vec_iter<A: Linear>(v: &Vec(A)): Iter(A)
}
var v := Vec::new()
Vec::push(&mut v, 1)
var it := vec_iter(&v)
it := vec_iter(&v)
```
lin = "ok"

@ cases.view-let-not-mut
source = ```nib
extern {
  type(borrow) Iter(A: Type)
  fn vec_iter<A: Linear>(v: &Vec(A)): Iter(A)
  fn iter_next<A: Linear>(it: &mut Iter(A)): Option(&A)
}
var v := Vec::new()
Vec::push(&mut v, 1)
let it := vec_iter(&v)
iter_next(&mut it)
```
types = "error: it is not a var"

@ cases.view-without-a-lender-borrows-nothing
description = "A result that may hold a borrow needs no lender in the signature when the body lends nothing."
source = "fn mk(): Option(&i64) { None }"
lin = "ok"

@ cases.view-needs-borrow-param
source = "fn mk(): &i64 { mk() }"
types = "error: -> &i64 needs a borrowed parameter"

@ cases.view-not-effect-argument
source = ```nib
struct(affine) F {}
effect e(o: Option(&F)): Unit
var v := Vec::new()
Vec::push(&mut v, F {})
let o := Vec::get(&v, 0)
perform e(o)
```
lin = "error: a borrow cannot be an effect argument"

@ cases.view-of-dup-is-value
source = ```nib
fn first(v: &Vec(i64)): Option(&i64) { Vec::get(&v, 0) }
var v := Vec::new()
Vec::push(&mut v, 1)
let o := first(&v)
Vec::push(&mut v, 1)
```
lin = "ok"

@ cases.view-result-can-be-returned
source = ```nib

fn second(v: &Vec(i64)): Option(&i64) { Vec::get(&v, 1) }
var v := Vec::new()
Vec::push(&mut v, 4)
Vec::push(&mut v, 5)
match second(&v) {
  Some(x) => show(&x)
  None => #()
}
```
stdout = "5\n"

@ cases.hashmap-get-is-an-option
source = ```nib
import std::indexed_map { IndexedMap }

var m := IndexedMap::new()
IndexedMap::insert(&mut m, "a", 1)
match IndexedMap::get(&m, "a") {
  Some(x) => show(&x)
  None => #()
}
match IndexedMap::get(&m, "b") {
  Some(x) => show(&x)
  None => show(&0)
}
```
stdout = ```
1
0
```

// A view's duplicable value is copied out where the result wants the value:
// the wanted `Option(A)` fixes `Some`'s argument, and `&A ≡ A`.
@ cases.view-value-is-copied-into-a-result
source = ```nib
import std::indexed_map { IndexedMap }

fn find(m: &IndexedMap(u64, u64), k: u64): Option(u64) {
  match IndexedMap::get(&m, &k) {
    None => None
    Some(x) => Some(x)
  }
}
var m: IndexedMap(u64, u64) := IndexedMap::new()
let old := IndexedMap::insert(&mut m, 1, 5)
match find(&m, 1) {
  None => #()
  Some(x) => show(&x)
}
```
stdout = "5\n"

@ cases.view-function-is-copied-into-a-result
source = ```nib
import std::indexed_map { IndexedMap }

fn find(m: &IndexedMap(u64, () -> Unit ! {Show}), k: u64): Option(() -> Unit ! {Show}) {
  match IndexedMap::get(&m, &k) {
    None => None
    Some(f) => Some(f)
  }
}
var m: IndexedMap(u64, () -> Unit ! {Show}) := IndexedMap::new()
let old := IndexedMap::insert(&mut m, 1, () => show(&1))
match find(&m, 1) {
  None => #()
  Some(f) => f()
}
```
stdout = "1\n"

@ cases.view-is-kept-where-the-result-is-a-view
source = ```nib
import std::indexed_map { IndexedMap }

fn find(m: &IndexedMap(u64, u64), k: u64): Option(&u64) {
  match IndexedMap::get(&m, &k) {
    None => None
    Some(x) => Some(x)
  }
}
var m: IndexedMap(u64, u64) := IndexedMap::new()
let old := IndexedMap::insert(&mut m, 1, 5)
match find(&m, 1) {
  None => #()
  Some(x) => show(&x)
}
```
stdout = "5\n"

