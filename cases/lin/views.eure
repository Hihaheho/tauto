// View types: `Option(&A)`, `Result(&A, E)`,
// `Pair(&A, &B)` and the extern `view struct`s hold borrows and are received
// as borrows are. Elements are `F`, an affine struct, where the freeze is the
// point: a `&i64` is an `i64`.

@ cases.option-borrow-match
source = ```nib
import std::prelude::Affine

var v := Vec::new()
Vec::push(&mut v, 7)
match Vec::get(&v, 0) {
  Some(x) => perform show("x", x)
  None => #()
}
```
shows = ["x = 7"]

@ cases.option-borrow-match-miss
source = ```nib
import std::prelude::Affine

var v := Vec::new()
Vec::push(&mut v, 7)
match Vec::get(&v, 3) {
  Some(x) => perform show("x", x)
  None => perform show("none", 0)
}
```
shows = ["none = 0"]

@ cases.option-borrow-let
source = ```nib
affine struct F {}
var v := Vec::new()
Vec::push(&mut v, F {})
let &o := Vec::get(&v, 0)
Vec::push(&mut v, F {})
```
lin = "error: v is frozen by o"

@ cases.option-borrow-match-unfreezes
source = ```nib
affine struct F {}
fn size(&f: F): i64 { 1 }
var v := Vec::new()
Vec::push(&mut v, F {})
let n := match Vec::get(&v, 0) {
  Some(f) => size(&f)
  None => 0
}
Vec::push(&mut v, F {})
```
lin = "ok"

@ cases.option-borrow-match-freezes
source = ```nib
affine struct F {}
var v := Vec::new()
Vec::push(&mut v, F {})
match Vec::get(&v, 0) {
  Some(f) => Vec::push(&mut v, F {})
  None => #()
}
```
lin = "error: v is frozen by f"

@ cases.view-not-type-argument
source = ```nib
fn id<A>(x: A): A { x }
var v := Vec::new()
Vec::push(&mut v, 1)
let &o := Vec::get(&v, 0)
id(o)
```
types = "error: a view cannot be a type argument"

@ cases.view-in-pair-is-view
source = ```nib
affine struct F {}
var v := Vec::new()
Vec::push(&mut v, F {})
let &o := Vec::get(&v, 0)
let &p := Pair { fst: o, snd: 1 }
```
lin = "ok"

