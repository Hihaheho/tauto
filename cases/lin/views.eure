@ cases.option-borrow-let-if
source = ```nib
struct(affine) F {}
var v := Vec::new()
Vec::push(&mut v, F {})
let o := if true { Vec::get(&v, 0) } else { Vec::get(&v, 1) }
Vec::push(&mut v, F {})
let used_later := &o
```
lin = "error: v is frozen by o"

@ cases.option-borrow-let-match
source = ```nib
struct(affine) F {}
var v := Vec::new()
Vec::push(&mut v, F {})
let o := match 0 {
  0 => Vec::get(&v, 0)
  n => Vec::get(&v, n)
}
Vec::push(&mut v, F {})
let used_later := &o
```
lin = "error: v is frozen by o"

@ cases.a-struct-holding-a-struct-that-holds-a-view-is-a-view
description = "`Placed` holds a `Place`, an extern `type(borrow)`; a struct that holds a `Placed` holds a view too, however deep (the types report marks each of them)."
source = ```nib
import std::builtin::region { Placed, Place, place }

struct Node { v: u64 }
struct Holder { p: Placed(Node) }
struct Outer { h: Holder, n: u64 }
fn make(): Outer ! {place(Node)} { Outer { h: Holder { p: Placed::new(Node { v: 1 }) }, n: 2 } }
```
lin = "ok"
