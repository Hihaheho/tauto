// Types that hold a borrow: `Option(&A)`, `Result(&A, E)`,
// `Pair(&A, &B)` and an extern `type(borrow)`, received as borrows are. Elements are `F`, an affine struct, where the freeze is the
// point: a `&i64` is an `i64`.

@ cases.option-borrow-match
source = ```nib

var v := Vec::new()
Vec::push(&mut v, 7)
match Vec::get(&v, 0) {
  Some(x) => show(&x)
  None => #()
}
```
stdout = "7\n"

@ cases.option-borrow-match-miss
source = ```nib

var v := Vec::new()
Vec::push(&mut v, 7)
match Vec::get(&v, 3) {
  Some(x) => show(&x)
  None => show(&0)
}
```
stdout = "0\n"

@ cases.option-borrow-let
source = ```nib
struct(affine) F {}
var v := Vec::new()
Vec::push(&mut v, F {})
let o := Vec::get(&v, 0)
Vec::push(&mut v, F {})
let used_later := &o
```
lin = "error: v is frozen by o"

@ cases.option-borrow-match-unfreezes
source = ```nib
struct(affine) F {}
fn size(f: &F): i64 { 1 }
var v := Vec::new()
Vec::push(&mut v, F {})
let n := match Vec::get(&v, 0) {
  Some(f) => size(&f)
  None => 0
}
Vec::push(&mut v, F {})
```
lin = "ok"

@ cases.option-borrow-match-freezes
source = ```nib
struct(affine) F {}
var v := Vec::new()
Vec::push(&mut v, F {})
match Vec::get(&v, 0) {
  Some(f) => {
    Vec::push(&mut v, F {})
    let used_later := &f
  }
  None => #()
}
```
lin = "error: v is frozen by f"

