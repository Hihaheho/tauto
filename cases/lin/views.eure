@ cases.view-var-advance
source = ```nib
view struct Iter(A: Type) {}
extern {
  fn vec_iter<A: Linear>(&v: Vec(A)): Iter(A)
  fn iter_next<A: Linear>(&mut it: Iter(A)): Option(&A)
}
var v := Vec::new()
Vec::push(&mut v, 1)
var &it := vec_iter(&v)
let first := iter_next(&mut it)
```
lin = "ok"

@ cases.view-var-reassign
source = ```nib
view struct Iter(A: Type) {}
extern {
  fn vec_iter<A: Linear>(&v: Vec(A)): Iter(A)
}
var v := Vec::new()
Vec::push(&mut v, 1)
var &it := vec_iter(&v)
it := vec_iter(&v)
```
types = "error: a view var cannot be reassigned"

@ cases.view-let-not-mut
source = ```nib
view struct Iter(A: Type) {}
extern {
  fn vec_iter<A: Linear>(&v: Vec(A)): Iter(A)
  fn iter_next<A: Linear>(&mut it: Iter(A)): Option(&A)
}
var v := Vec::new()
Vec::push(&mut v, 1)
let &it := vec_iter(&v)
iter_next(&mut it)
```
types = "error: it is not a var"

@ cases.view-needs-borrow-param
source = "fn mk(): Option(&i64) { None }"
types = "error: -> Option(&i64) needs a borrowed parameter"

@ cases.view-not-effect-argument
source = ```nib
affine struct F {}
effect e(o: Option(&F)): Unit
var v := Vec::new()
Vec::push(&mut v, F {})
let &o := Vec::get(&v, 0)
perform e(o)
```
lin = "error: a borrow cannot be an effect argument"

@ cases.view-of-dup-is-value
source = ```nib
fn first(&v: Vec(i64)): Option(&i64) { Vec::get(&v, 0) }
var v := Vec::new()
Vec::push(&mut v, 1)
let o := first(&v)
Vec::push(&mut v, 1)
```
lin = "ok"

@ cases.view-result-can-be-returned
source = ```nib
import std::prelude::Affine

fn second(&v: Vec(i64)): Option(&i64) { Vec::get(&v, 1) }
var v := Vec::new()
Vec::push(&mut v, 4)
Vec::push(&mut v, 5)
match second(&v) {
  Some(x) => perform show("x", x)
  None => #()
}
```
shows = ["x = 5"]

@ cases.hashmap-get-is-an-option
source = ```nib
import std::prelude::Affine

var m := HashMap::new()
HashMap::insert(&mut m, "a", 1)
match HashMap::get(&m, "a") {
  Some(x) => perform show("a", x)
  None => #()
}
match HashMap::get(&m, "b") {
  Some(x) => perform show("b", x)
  None => perform show("b", 0)
}
```
shows = ["a = 1", "b = 0"]

// A view's duplicable value is copied out where the result wants the value:
// the wanted `Option(A)` fixes `Some`'s argument, and `&A ≡ A`.
@ cases.view-value-is-copied-into-a-result
source = ```nib
import std::prelude::Affine

fn find(&m: HashMap(u64, u64), k: u64): Option(u64) {
  match HashMap::get(&m, &k) {
    None => None
    Some(x) => Some(x)
  }
}
var m: HashMap(u64, u64) := HashMap::new()
let old := HashMap::insert(&mut m, 1, 5)
match find(&m, 1) {
  None => #()
  Some(x) => perform show("x", x)
}
```
shows = ["x = 5"]

@ cases.view-function-is-copied-into-a-result
source = ```nib
import std::prelude::Affine

fn find(&m: HashMap(u64, () -> Unit ! {∀ A. show(A)}), k: u64): Option(() -> Unit ! {∀ A. show(A)}) {
  match HashMap::get(&m, &k) {
    None => None
    Some(f) => Some(f)
  }
}
var m: HashMap(u64, () -> Unit ! {∀ A. show(A)}) := HashMap::new()
let old := HashMap::insert(&mut m, 1, () => perform show("x", 1))
match find(&m, 1) {
  None => #()
  Some(f) => f()
}
```
shows = ["x = 1"]

@ cases.view-is-kept-where-the-result-is-a-view
source = ```nib
import std::prelude::Affine

fn find(&m: HashMap(u64, u64), k: u64): Option(&u64) {
  match HashMap::get(&m, &k) {
    None => None
    Some(x) => Some(x)
  }
}
var m: HashMap(u64, u64) := HashMap::new()
let old := HashMap::insert(&mut m, 1, 5)
match find(&m, 1) {
  None => #()
  Some(x) => perform show("x", x)
}
```
shows = ["x = 5"]
