// View types: `Option(&A)`, `Result(&A, E)`,
// `Pair(&A, &B)` and the extern `view struct`s hold borrows and are received
// as borrows are. Elements are `F`, an affine struct, where the freeze is the
// point: a `&i64` is an `i64`.

@ cases.option-borrow-match
source = ```nib
var v = vec_new()
vec_push(&mut v, 7)
match vec_get(&v, 0) {
  Some(x) => perform show("x", x)
  None => ()
}
```
shows = ["x = 7"]

@ cases.option-borrow-match-miss
source = ```nib
var v = vec_new()
vec_push(&mut v, 7)
match vec_get(&v, 3) {
  Some(x) => perform show("x", x)
  None => perform show("none", 0)
}
```
shows = ["none = 0"]

@ cases.option-borrow-let
source = ```nib
affine struct F {}
var v = vec_new()
vec_push(&mut v, F {})
let &o = vec_get(&v, 0)
vec_push(&mut v, F {})
```
lin = "error: v is frozen by o"

@ cases.option-borrow-match-unfreezes
source = ```nib
affine struct F {}
fn size(&f: F) -> i64 { 1 }
var v = vec_new()
vec_push(&mut v, F {})
let n = match vec_get(&v, 0) {
  Some(f) => size(&f)
  None => 0
}
vec_push(&mut v, F {})
```
lin = "ok"

@ cases.option-borrow-match-freezes
source = ```nib
affine struct F {}
var v = vec_new()
vec_push(&mut v, F {})
match vec_get(&v, 0) {
  Some(f) => vec_push(&mut v, F {})
  None => ()
}
```
lin = "error: v is frozen by f"

@ cases.view-not-type-argument
source = ```nib
fn id<A>(x: A) -> A { x }
var v = vec_new()
vec_push(&mut v, 1)
let &o = vec_get(&v, 0)
id(o)
```
types = "error: a view cannot be a type argument"

@ cases.view-in-pair-is-view
source = ```nib
affine struct F {}
var v = vec_new()
vec_push(&mut v, F {})
let &o = vec_get(&v, 0)
let &p = Pair { fst: o, snd: 1 }
```
lin = "ok"

@ cases.view-cannot-be-field
source = "struct S { o: Option(&i64) }"
types = "error: a borrow cannot be a field"

@ cases.view-cannot-be-let
source = ```nib
affine struct F {}
var v = vec_new()
vec_push(&mut v, F {})
let o = vec_get(&v, 0)
```
types = "error: a borrow cannot be stored"

@ cases.view-var-advance
source = ```nib
view struct Iter<A> {}
extern {
  fn vec_iter<A: linear>(&v: Vec(A)) -> Iter(A)
  fn iter_next<A: linear>(&mut it: Iter(A)) -> Option(&A)
}
var v = vec_new()
vec_push(&mut v, 1)
var &it = vec_iter(&v)
let first = iter_next(&mut it)
```
lin = "ok"

@ cases.view-var-reassign
source = ```nib
view struct Iter<A> {}
extern {
  fn vec_iter<A: linear>(&v: Vec(A)) -> Iter(A)
}
var v = vec_new()
vec_push(&mut v, 1)
var &it = vec_iter(&v)
it := vec_iter(&v)
```
types = "error: a view var cannot be reassigned"

@ cases.view-let-not-mut
source = ```nib
view struct Iter<A> {}
extern {
  fn vec_iter<A: linear>(&v: Vec(A)) -> Iter(A)
  fn iter_next<A: linear>(&mut it: Iter(A)) -> Option(&A)
}
var v = vec_new()
vec_push(&mut v, 1)
let &it = vec_iter(&v)
iter_next(&mut it)
```
types = "error: it is not a var"

@ cases.view-needs-borrow-param
source = "fn mk() -> Option(&i64) { None }"
types = "error: -> Option(&i64) needs a borrowed parameter"

@ cases.view-not-effect-argument
source = ```nib
affine struct F {}
effect e: (o: Option(&F)) -> ()
var v = vec_new()
vec_push(&mut v, F {})
let &o = vec_get(&v, 0)
perform e(o)
```
lin = "error: a borrow cannot be an effect argument"

@ cases.view-of-dup-is-value
source = ```nib
fn first(&v: Vec(i64)) -> Option(&i64) { vec_get(&v, 0) }
var v = vec_new()
vec_push(&mut v, 1)
let o = first(&v)
vec_push(&mut v, 1)
```
lin = "ok"

@ cases.view-result-can-be-returned
source = ```nib
fn second(&v: Vec(i64)) -> Option(&i64) { vec_get(&v, 1) }
var v = vec_new()
vec_push(&mut v, 4)
vec_push(&mut v, 5)
match second(&v) {
  Some(x) => perform show("x", x)
  None => ()
}
```
shows = ["x = 5"]

@ cases.hashmap-get-is-an-option
source = ```nib
var m = hashmap_new()
hashmap_insert(&mut m, "a", 1)
match hashmap_get(&m, "a") {
  Some(x) => perform show("a", x)
  None => ()
}
match hashmap_get(&m, "b") {
  Some(x) => perform show("b", x)
  None => perform show("b", 0)
}
```
shows = ["a = 1", "b = 0"]
