@ cases.order-and-shared-reads
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Vec::into_array` yet"
source = ```nib

var values := Vec::new()
Vec::push(&mut values, "日本語")
Vec::push(&mut values, "two")
let array := Vec::into_array(values)
show(&Array::len(array))
show(&Array::get(array, 0))
show(&Array::get(array, 1))
show(&Array::get(array, 2))
```
stdout = ```
2
Some("日本語")
Some("two")
None
```

@ cases.empty
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Vec::into_array` yet"
source = ```nib

let array: Array(i64) := Vec::into_array(Vec::new())
show(&Array::len(array))
show(&Array::get(array, 0))
```
stdout = ```
0
None
```

@ cases.large-flat
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Vec::into_array` yet"
source = ```nib

var values := Vec::new()
var i: u64 := 0
while i < 100000 {
  Vec::push(&mut values, i)
  i := i + 1
}
let array := Vec::into_array(values)
show(&Array::len(array))
show(&Array::get(array, 99999))
```
stdout = ```
100000
Some(99999)
```
