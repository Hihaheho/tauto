// A function the kernel accepts as structurally recursive does not diverge,
// so a closure that calls it fits a callable type without `div`, also when
// the program's top-level statements run under the host.
@ cases.closure-call-under-host
imports = [path`../std/base.taut`]
source = ```tauto
import std::builtin::os

fn after(o: Option(Nat), next: (Nat) -> Option(Nat)): Option(Nat) {
  ⊢ Option(Nat) from match o {
    None => None
    Some(x) => next(x)
  }
}

fn count(fuel: Nat, n: Nat): Option(Nat) {
  ⊢ Option(Nat) from match fuel {
    Zero => Some(n)
    Succ(f) => after(Some(n), (x: Nat) => count(f, Succ(x)))
  }
}

match count(3, 0) {
  None => print("none")
  Some(n) => print(Text::of_nat(n))
}
```
stdout = "3"
stderr = ""
exit = 0

@ cases.closure-call-shown
stdout = "Some(3)\n"
imports = [path`../std/base.taut`]
source = ```tauto
fn after(o: Option(Nat), next: (Nat) -> Option(Nat)): Option(Nat) {
  ⊢ Option(Nat) from match o {
    None => None
    Some(x) => next(x)
  }
}

fn count(fuel: Nat, n: Nat): Option(Nat) {
  ⊢ Option(Nat) from match fuel {
    Zero => Some(n)
    Succ(f) => after(Some(n), (x: Nat) => count(f, Succ(x)))
  }
}

show(&count(3, 0))
```

// Functions that call one another, each call on a part of the same argument,
// end as one function does, so a function value of one fits a callable type
// without `div` under the host as well.
@ cases.mutual-functions-as-a-function-value-under-host
imports = [path`../std/base.taut`]
source = ```tauto
import std::builtin::os

inductive K: Type {
  Leaf(n: Nat): K
  Many(xs: List(K)): K
}

fn find<A: Shared>(eq: (A, A) -> Bool, k: A, l: List(A)): Bool {
  match l {
    Nil => false
    Cons(h, t) => match eq(h, k) {
      true => true
      false => find(eq, k, t)
    }
  }
}

mutual {
  fn keq(a: K, b: K): Bool {
    match a {
      Leaf(x) => match b {
        Leaf(y) => x == y
        Many(_) => false
      }
      Many(xs) => match b {
        Leaf(_) => false
        Many(ys) => keqs(xs, ys)
      }
    }
  }
  fn keqs(a: List(K), b: List(K)): Bool {
    match a {
      Nil => match b {
        Nil => true
        Cons(_, _) => false
      }
      Cons(x, xs) => match b {
        Nil => false
        Cons(y, ys) => match keq(x, y) {
          true => keqs(xs, ys)
          false => false
        }
      }
    }
  }
}

fn use_it(l: List(K), k: K): Bool { find(keq, k, l) }

match perform argv() {
  args => match use_it(Cons(Leaf(1), Nil), Leaf(1)) {
    true => print("found")
    false => print("missing")
  }
}
```
stdout = "found"
stderr = ""
exit = 0

// A function the kernel accepts though its recursion is not on a part
// written as one (`last(Cons(h2, t2))` rebuilds `t`) does not diverge either:
// a closure that calls it fits a callable type without `div` under the host,
// as `tauto check` accepts it.
@ cases.kernel-accepted-recursion-under-host
source = ```tauto
import std::list
import std::builtin::os

fn apply(k: (List(Nat)) -> Bool, l: List(Nat)): Bool { k(l) }

fn ends_with_zero(l: List(Nat)): Bool {
  match List::last(l) {
    None => false
    Some(c) => Nat::eq(c, 0)
  }
}

let b := apply((x: List(Nat)) => ends_with_zero(x), [1, 0])
print(if b { "yes" } else { "no" })
```
stdout = "yes"
stderr = ""
exit = 0

// The same where another function is copied for the declared function it is
// given (`twice(succ, 1)`): the copied program is judged with the evidence
// the program it is made from was judged with.
@ cases.kernel-accepted-recursion-beside-a-copied-function
source = ```tauto
import std::list
import std::builtin::os

fn apply(k: (List(Nat)) -> Bool, l: List(Nat)): Bool { k(l) }

fn ends_with_zero(l: List(Nat)): Bool {
  match List::last(l) {
    None => false
    Some(c) => Nat::eq(c, 0)
  }
}

fn twice(k: (Nat) -> Nat, n: Nat): Nat { k(k(n)) }

fn succ(n: Nat): Nat { Succ(n) }

let b := apply((x: List(Nat)) => ends_with_zero(x), [1, 0])
print(if b { "yes" } else { "no" })
print(Text::of_nat(twice(succ, 1)))
```
stdout = "yes3"
stderr = ""
exit = 0
