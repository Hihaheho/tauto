@ cases.text-keys-preserve-replacement-and-borrowed-updates
llvm.unimplemented = "generate: the LLVM backend does not write internal: a value of one type where a value of another is read yet"
source = ```nib
import std::indexed_map { IndexedMap }

var entries: IndexedMap(Text, i64) := IndexedMap::new()
IndexedMap::insert(&mut entries, "", 1)
IndexedMap::insert(&mut entries, "日本語", 2)
IndexedMap::insert(&mut entries, "last", 3)
show(&IndexedMap::insert(&mut entries, "日本語", 20))
show(&IndexedMap::get(&entries, ""))
show(&IndexedMap::get(&entries, "日本語"))
show(&IndexedMap::get(&entries, "last"))
show(&IndexedMap::get(&entries, "missing"))
match IndexedMap::get_mut(&mut entries, "last") {
  Some(value) => { *value := 30 }
  None => #()
}
show(&IndexedMap::get(&entries, "last"))
show(&Vec::len(&IndexedMap::into_vec(entries)))
```
stdout = ```
#(Some(#("日本語", 2)), None)
Some(1)
Some(20)
Some(3)
None
Some(30)
3
```

@ cases.nontext-keys-use-the-general-comparison
llvm.unimplemented = "generate: the LLVM backend does not write internal: a value of one type where a value of another is read yet"
source = ```nib
import std::indexed_map { IndexedMap }

var entries: IndexedMap(i64, i64) := IndexedMap::new()
IndexedMap::insert(&mut entries, -2, 7)
IndexedMap::insert(&mut entries, 4, 8)
show(&IndexedMap::insert(&mut entries, -2, 9))
show(&IndexedMap::get(&entries, &(-2)))
show(&IndexedMap::get(&entries, &4))
show(&IndexedMap::get(&entries, &0))
```
stdout = ```
#(Some(#(-2, 7)), None)
Some(9)
Some(8)
None
```
