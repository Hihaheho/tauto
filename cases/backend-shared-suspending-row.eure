// Two function arguments that share a row variable, called with functions
// that suspend: each argument is made for the same tier, and both are
// called in the body.
@ cases.two-callbacks-share-a-suspending-row
llvm.unimplemented = "generate: the LLVM backend does not write a call that may stop yet"
source = ```nib
import std::builtin::os

fn both<!e>(load: (k: nat) -> nat ! e, put: (v: nat) -> nat ! e): nat ! e {
  put(load(1)) + put(load(2))
}
fn load(k: nat): nat ! {sleep} { perform sleep(1); k * 10 }
fn put(v: nat): nat ! {sleep} { perform sleep(1); v + 1 }
show(&both(load, put))
```
stdout = "32\n"

@ cases.two-callbacks-share-a-suspending-row-passed-down
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```nib
import std::builtin::os

fn steps<!e>(ks: List(u64), load: (k: u64) -> Result(u64, u64) ! {div} ∪ e, put: (v: u64) -> Bool ! {div} ∪ e): Option(u64) ! {div, overflow} ∪ e {
  match ks {
    Nil => Some(0)
    Cons(k, rest) => match load(k) {
      Ok(v) => if put(v) {
        match steps(rest, load, put) {
          Some(n) => Some(n + v)
          None => None
        }
      } else { None }
      Err(_) => None
    }
  }
}
fn go<!e>(load: (k: u64) -> Result(u64, u64) ! {div} ∪ e, put: (v: u64) -> Bool ! {div} ∪ e): Option(u64) ! {div, overflow} ∪ e {
  if put(0) { steps([1, 2, 3], load, put) } else { None }
}
let r := go((k) => { perform sleep(1); Ok(k * 10) }, (v) => { perform sleep(1); show(&v); true })
match r {
  Some(n) => show(&n)
  None => show(&0)
}
```
stdout = ```
0
10
20
30
60
```

@ cases.two-callbacks-share-a-suspending-row-captured
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```nib
import std::builtin::os

fn each<!e>(ks: List(nat), f: (k: nat) -> nat ! e): nat ! e {
  match ks {
    Nil => 0
    Cons(k, rest) => f(k) + each(rest, f)
  }
}
fn go<!e>(load: (k: nat) -> nat ! {div} ∪ e, put: (v: nat) -> nat ! {div} ∪ e): nat ! {div} ∪ e {
  each([1, 2, 3], (k) => put(load(k)))
}
show(&go((k) => { perform sleep(1); k * 10 }, (v) => { perform sleep(1); v + 1 }))
```
stdout = "63\n"

@ cases.callback-of-a-smaller-row-passed-with-a-suspending-one
llvm.unimplemented = "generate: the LLVM backend does not write a call that may stop yet"
source = ```nib
import std::builtin::os

fn both<!e>(load: (k: u64) -> u64 ! {div} ∪ e, put: (v: u64) -> u64 ! {div} ∪ e): u64 ! {div, overflow} ∪ e {
  put(load(1)) + put(load(2))
}
fn go<!e>(load: (k: u64) -> u64 ! {div} ∪ e): u64 ! {div, sleep, overflow} ∪ e {
  both(load, (v) => { perform sleep(1); v + 1 })
}
show(&go((k) => k * 10))
```
stdout = "32\n"

@ cases.wrapped-callback-of-a-smaller-row-passed-with-a-suspending-one
llvm.unimplemented = "generate: the LLVM backend does not write a call that may stop yet"
source = ```nib
import std::builtin::os

fn both<!e>(load: (k: u64) -> Result(u64, u64) ! {div} ∪ e, put: (v: u64) -> Bool ! {div} ∪ e): Bool ! {div} ∪ e {
  match load(1) {
    Ok(v) => put(v)
    Err(_) => false
  }
}
fn go<!e>(load: (k: u64) -> Result(u64, u64) ! {div} ∪ e): Bool ! {div, sleep} ∪ e {
  let fetch := (k) => load(k)
  both(fetch, (v) => { perform sleep(1); v == 10 })
}
show(&go((k) => Ok(k * 10)))
```
stdout = "true\n"

// A call's result passed as a callback has the row row checking followed
// it to, which specializes the callee's row variable.
@ cases.callback-made-by-a-call-specializes-the-row-variable
source = ```tauto
fn reported<!e>(what: Text, f: (k: Text, a: Text) -> Text ! {div} ∪ e): (k: Text, a: Text) -> Text ! {div} ∪ e {
  (k: Text, a: Text) => concat(what, f(k, a))
}

fn use_it<!e>(load: (k: Text) -> Text ! {div} ∪ e, f: (k: Text, a: Text) -> Text ! {div} ∪ e): Text ! {div} ∪ e {
  concat(load("y"), f("x", ""))
}

fn go<!e>(load: (k: Text) -> Text ! {div} ∪ e, call: (k: Text, a: Text) -> Text ! {div} ∪ e): Text ! {div} ∪ e {
  let loads := reported("load:", (k: Text, a: Text) => load(k))
  use_it((k: Text) => loads(k, ""), reported("call:", call))
}

show(&go((k: Text) => k, (k: Text, a: Text) => k))
```
stdout = ```
"load:ycall:x"
```
