checks."input/main.taut::sign" = "error: is not a `Nat`"

@ cases.int-norm-reads-a-numeral-where-an-int-is-expected-as-a-constant
imports = [path`../../std/IntNorm.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
theorem self_cancel(x: Int): Int::add(x, Int::neg(x)) = 0 {
  by int_norm!(): Int::add(x, Int::neg(x)) = 0 {}
}
theorem shift_numeral(x: Int): Int::add(x, 3) = Int::sub(x, -3) {
  by int_norm!(): Int::add(x, 3) = Int::sub(x, -3) {}
}
theorem negative_numeral(x: Int): Int::add(x, -2) = Int::sub(x, 2) {
  by int_norm!(): Int::add(x, -2) = Int::sub(x, 2) {}
}
```

checks."input/main.taut::self_cancel" = "ok"
checks."input/main.taut::shift_numeral" = "ok"
checks."input/main.taut::negative_numeral" = "ok"
