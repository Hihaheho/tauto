import "Simp.taut"
theorem sym_rule(a:Nat,b:Nat,h:a = b):b = a { Eq::sym(h) }
theorem test(P:(Nat)->Prop,a:Nat,b:Nat,h:a = b,pa:P(a)):P(b) { by simp_only!(rules(1,sym_rule(a,b,h))): P(b) { ⊢ P(a) from pa } }
```

