@ cases.a-lambda-parameter-without-a-type-is-matched-at-the-type-of-the-goal-0
imports = [path`../../examples/lambda/Typing.taut`, path`../../examples/lambda/Lib.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

// Lambda arg without annotation, then match
theorem t2<G: List(Ty), D: List(Ty), xi: (Nat) -> Nat>(r: RenOk(xi, G, D)): RenOk(xi, G, D) {
  i => A => h => ⊢ Has(D, xi(i), A) from match i {
    Zero => r(Zero, A, h)
    Succ(m) => r(Succ(m), A, h)
  }
}
```

