@ cases.a-quantifier-is-written-in-an-arm-and-in-a-parenthesized-lambda-body-0
imports = [path`../../examples/lambda/Typing.taut`, path`../../examples/lambda/Lib.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

fn Red2(A: Ty, t: Tm): Prop {
  ⊢ Prop from match A {
    Tunit => t = t
    Arr(A1, B1) => ∀ w: Tm. (Red2(A1, w)) -> Red2(B1, App(t, w))
  }
}

def Ap(P: (Tm) -> Prop, t: Tm): Prop := P(t)

def Stuck(t: Tm): Prop := Ap(w => (∀ u: Tm. (Step(w, u)) -> u = w), t)
```

