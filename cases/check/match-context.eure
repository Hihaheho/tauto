@ cases.a-hypothesis-indexed-like-the-matched-value-is-refined-in-the-arm-0
imports = [path`../../examples/lambda/Typing.taut`, path`../../examples/lambda/Lib.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::prelude::Macro


theorem progress2<t: Tm, A: Ty>(h: lc!(`|- $t : $A`)): Prog(t) {
  ⊢ Prog(t) from match h {
    TVar(G1, i, A1, hv) => ⊢ Prog(Tvar(i)) from match hv {
    }
    TLam(G1, A1, B1, b, hb) => OrInl(Value::VLam)
    TApp(G1, A1, B1, f, a, hf, ha) => ⊢ Prog(App(f, a)) from match progress(<t: f, A: Arr(A1, B1)>, hf) {
      OrInl(vf) => ⊢ Prog(App(f, a)) from match vf {
        Value::VLam(A0, b) => OrInr(CanStep::Mk(SBeta))
        VStar => False::elim(star_not_arr(hf))
      }
      OrInr(cf) => ⊢ Prog(App(f, a)) from match cf {
        Mk(f2, s) => OrInr(CanStep::Mk(SAppL(s)))
      }
    }
    TStar(G1) => OrInl(VStar)
  }
}
```

