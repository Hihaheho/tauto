@ cases.the-result-type-of-a-nested-match-needs-no-explicit-type-arguments-0
imports = [path`../../examples/lambda/Typing.taut`, path`../../examples/lambda/Lib.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

theorem t5a<G: List(Ty), C: Ty, A: Ty, i: Nat>(h: Has(Cons(C, G), i, A)): Has(Cons(C, G), i, A) {
  ⊢ Has(Cons(C, G), i, A) from match h {
    HasHere(g, a) => HasHere
    HasThere(h0) => HasThere(h0)
  }
}
theorem t5b<G: List(Ty), C: Ty, A: Ty, i: Nat>(h: Has(Cons(C, G), i, A)): Has(Cons(C, G), i, A) {
  ⊢ Has(Cons(C, G), i, A) from match i {
    Zero => ⊢ Has(Cons(C, G), Zero, A) from match h {
      HasHere(g, a) => HasHere
    }
    Succ(m) => h
  }
}
```

