@ cases.checked-completion-policy
source = path`../../examples/effect-proofs/src/policy.taut`
checks_all = "ok"
checks.stale_ignored = "ok"
checks.current_accepted = "ok"
checks.late_cannot_replace_current = "ok"

@ cases.handled-out-of-order-completions
tote = path`../../examples/effect-proofs`
shows = ["displayed = 20", "displayed = 20", "final generation = 2", "final value = 20"]
