@ cases.a-declaration-without-pub-is-seen-only-in-its-file
files."lib.taut" = ```tauto
fn hidden(): i64 { 1 }
pub fn shown(): i64 { hidden() }
```
files."main.nib" = ```tauto
import "lib.taut"
fn f(): i64 { hidden() }
```
checks.f = "error: `hidden` is private to the file `lib`; write `pub` before its declaration there to use it from another file"

@ cases.a-private-declaration-a-macro-names-stays-private-to-its-file
files."lib.taut" = ```tauto
import std::builtin::macro { SynExpr }
fn hidden(): i64 { 7 }
pub macro fn get(e: SynExpr): SynExpr { quote { hidden() } }
```
files."main.nib" = ```tauto
import "lib.taut"
fn f(): i64 { hidden() }
```
checks.f = "error: `hidden` is private to the file `lib`; write `pub` before its declaration there to use it from another file"

@ cases.a-macro-uses-a-private-declaration-of-its-own-file
files."lib.taut" = ```tauto
import std::builtin::macro { SynExpr }
fn hidden(): i64 { 7 }
pub macro fn get(e: SynExpr): SynExpr { quote { hidden() } }
```
files."main.nib" = ```tauto
import "lib.taut"
import std::builtin::os
print(Text::of_i64(get!(0)))
```
stdout = "7"

@ cases.a-pub-type-cannot-be-built-outside-its-file
files."lib.taut" = ```tauto
pub struct Html { html: Text }
pub fn escape(t: Text): Html { Html { html: t } }
```
files."main.nib" = ```tauto
import "lib.taut"
fn f(): Html { Html { html: "<b>" } }
```
checks.f = "error: `Html` is a constructor of `Html`, which the file `lib` declares without `pub(open)`: outside that file the type is abstract; use the functions it makes public"

@ cases.a-pub-type-has-no-fields-outside-its-file
files."lib.taut" = ```tauto
pub struct Html { html: Text }
