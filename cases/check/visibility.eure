import std::prelude::Par

fn f(): Atomic { Atomic {} }
```
checks."main.nib::macro" = "error: `Atomic` is a constructor of `Atomic`, which the prelude declares without `pub(open)`: outside that file the type is abstract; use the functions it makes public"

@ cases.a-constructor-of-a-file-not-imported-does-not-take-a-pattern-name
files."http.taut" = ```tauto
pub(open) enum Method { Get, Head }
pub fn method(): Method { Head }
```
files."view.taut" = ```tauto
pub fn first(xs: List(i64)): i64 {
  match xs {
    Cons(head, _) => head
    Nil => 0
  }
}
```
files."main.nib" = ```tauto
import "http.taut"
import "view.taut"
import std::prelude::Os
print(Text::of_i64(first([4, 5])))
```
stdout = "4"

@ cases.a-field-of-an-open-inductive-is-not-taken-for-a-prelude-field
