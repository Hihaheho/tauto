@ cases.only-the-declaring-file-writes-instances-of-a-pub-class
files."lib.taut" = ```tauto
pub class Size(A: Type) {
  fn size(a: A): i64
}
instance Size(i64) {
  fn size(a: i64): i64 { a }
}
```
files."main.nib" = ```tauto
import "lib.taut"
instance Size(Bool) {
  fn size(a: Bool): i64 { 1 }
}
```
checks."main.nib::macro" = "error: `Size` is a class the file `lib` declares without `pub(open)`: only that file may write its instances; use the instances that file writes, or ask for `pub(open)` there"

@ cases.a-pub-open-class-takes-instances-from-another-file
files."lib.taut" = ```tauto
pub(open) class Same(A: Type) {
  fn same(a: A): A
}
```
files."main.nib" = ```tauto
import "lib.taut"
instance Same(Bool) {
  fn same(a: Bool): Bool { a }
}
fn f(): Bool { Same::same(true) }
```
checks_all = "ok"

@ cases.a-pub-function-cannot-bound-a-private-class
files."main.nib" = ```tauto
class Size(A: Type) {
  fn size(a: A): i64
}
pub fn twice<A>(a: A): i64 where Size(A) { Size::size(a) + Size::size(a) }
```
checks."main.nib::macro" = "error: `twice` is `pub`, but its `where` names `Size`, a class this file declares without `pub`: no other file could meet it; write `pub` before the class, or leave the function private"

