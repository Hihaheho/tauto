@ cases.nat-norm-proves-the-equations-of-the-semiring-0
imports = [path`../../std/Base.taut`, path`../../std/Tactic.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn double(n: Nat): Nat { Nat::add(n, n) }
theorem square(a: Nat, b: Nat): Nat::mul(Nat::add(a, b), Nat::add(a, b)) = Nat::add(Nat::add(Nat::mul(a, a), Nat::mul(b, b)), Nat::mul(2, Nat::mul(a, b))) {
  by nat_norm!(): Nat::mul(Nat::add(a, b), Nat::add(a, b)) = Nat::add(Nat::add(Nat::mul(a, a), Nat::mul(b, b)), Nat::mul(2, Nat::mul(a, b))) {}
}
theorem calls_are_variables(a: Nat, b: Nat): Nat::add(Succ(a), Nat::mul(2, double(b))) = Nat::add(Nat::mul(2, double(b)), Succ(a)) {
  by nat_norm!(): Nat::add(Succ(a), Nat::mul(2, double(b))) = Nat::add(Nat::mul(2, double(b)), Succ(a)) {}
}
theorem operators(a: Nat, b: Nat): (a + b) * (a + b) = a * a + 2 * a * b + b * b {
  by nat_norm!(): (a + b) * (a + b) = a * a + 2 * a * b + b * b {}
}
theorem in_a_chain(a: Nat, b: Nat, h: a = b): Nat::add(Nat::mul(a, a), Nat::mul(a, b)) = Nat::mul(a, Nat::add(b, b)) {
  by rewrite!(h): Nat::add(Nat::mul(a, a), Nat::mul(a, b)) = Nat::mul(a, Nat::add(b, b)) {
    ⊢ Nat::add(Nat::mul(b, b), Nat::mul(b, b)) = Nat::mul(b, Nat::add(b, b)) from by nat_norm!() {}
  }
}
```

