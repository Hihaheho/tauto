@ cases.rewrite-reads-an-equation-whose-sides-are-calls-with-implicit-arguments-0
imports = [path`../../std/Base.taut`, path`../../std/List.taut`, path`../../std/Nat.taut`, path`../../std/Tactic.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
theorem under_a_call<A: Type>(l: List(A), n: Nat, h: List::length(l) = n): List::length(List::reverse(l)) = n {
  by rewrite!(List::length_reverse(l)): List::length(List::reverse(l)) = n {
    ⊢ List::length(l) = n from h
  }
}

theorem under_an_operator(a: Nat, b: Nat, c: Nat, h: a + b = c): b + a = c {
  by rewrite!(Nat::add_comm(b, a)): b + a = c {
    ⊢ Nat::add(a, b) = c from h
  }
}
```

