@ cases.rewrite-writes-the-motive-from-the-two-goals-0
imports = [path`../../std/Base.taut`, path`../../std/Nat.taut`, path`../../std/Tactic.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
theorem comm(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  ⊢ Nat::add(a, b) = Nat::add(b, a) from match b {
    Zero => Eq::sym(Nat::add_zero_left(a))
    Succ(k) => by rewrite!(comm(a, k)): Succ(Nat::add(a, k)) = Nat::add(Succ(k), a) {
      ⊢ Succ(Nat::add(k, a)) = Nat::add(Succ(k), a) from by rewrite!(Nat::add_succ_left(k, a)) {
      ⊢ Succ(Nat::add(k, a)) = Succ(Nat::add(k, a)) from Refl
    }}
  }
}

theorem twice(a: Nat, b: Nat, h: a = b): Nat::add(a, a) = Nat::add(b, b) {
  by rewrite!(h): Nat::add(a, a) = Nat::add(b, b) {
    ⊢ Nat::add(b, b) = Nat::add(b, b) from Refl
  }
}

theorem one_side(a: Nat, b: Nat, h: a = b): Nat::add(a, a) = Nat::add(b, a) {
  by rewrite!(h): Nat::add(a, a) = Nat::add(b, a) {
    ⊢ Nat::add(b, a) = Nat::add(b, a) from Refl
  }
}
```

