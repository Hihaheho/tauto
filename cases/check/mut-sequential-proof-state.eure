@ cases.merged-leaf-proof-about-input-only-ok
source = ```tauto
inductive S: Type {
  Mk(n: Nat): S
}

fn n_of(s: S): Nat {
  match s {
    Mk(n) => n
  }
}

// One leaf: the proof mentions only the input, never an intermediate `&mut` state.
fn bump(v: &mut S, h0: n_of(v) = Zero, h: n_of(Mk(Succ(n_of(v)))) = Succ(Zero)): Unit {
  *v := Mk(Succ(n_of(v)))
}

theorem bump_ok(): bump(Mk(Zero), Refl, Refl) = mut1(Star, Mk(Succ(Zero))) {
  Refl
}
```
checks_all = "ok"
