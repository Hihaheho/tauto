// A function with no row has the row `{}`, so each function of the selfhost
// totes and of the scripts names the effects it may perform. These files
// are what `tauto check totes/elaborator`, `tauto check totes/build` and the
// project commands read; the cases check them as imports.

@ cases.the-elaborator-names-div-in-its-mutually-recursive-functions
imports = [path`../../totes/elaborator/src/mutable.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
let one := 1
```

check_errors = []

@ cases.the-build-tote-names-the-ref-effects-of-its-queries
imports = [path`../../totes/build/src/queries.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
let one := 1
```

check_errors = []
