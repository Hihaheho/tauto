files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
fn none_of<A>(): Option(A) {
  None
}
fn three(): Nat {
  3
}
fn called(): Option(Nat) {
  let x: Option(Nat) := none_of();
  x
}
fn bare(): Option(Nat) {
  let x: Option(Nat) := none_of;
  x
}
fn bare_plain(): Nat {
  three
}
fn take(n: Nat): Nat {
  n
}
fn bare_argument(): Nat {
  take(three)
}
