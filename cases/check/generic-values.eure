// A recursive call in a nested match takes its generic from the arm's expected
// type, the motive applied to the pattern (`(t => A)(Succ(k))`): applied, it is
// `A`, so the call passes the generic unchanged and the recursion is structural.
@ cases.a-recursive-call-in-a-nested-match-passes-its-generic-unchanged
source = ```tauto
pub fn get<A>(zero: A, env: List(A), i: Nat): A {
  ⊢ A from match env {
    Nil => zero
    Cons(h, t) => ⊢ A from match i {
      Zero => h
      Succ(k) => get(zero, t, k)
    }
  }
}
```
checks.get = "ok"
diagnostics = []
