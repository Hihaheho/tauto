@ cases.a-generic-function-passed-bare-takes-its-generics-from-the-expected-type
files."Base.taut" = path`../../std/Base.taut`
files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
theorem cons_eq<A: Type>(x: A, l: List(A), m: List(A), e: l = m): Cons(x, l) = Cons(x, m) {
  Eq::congr((z: List(A)) => Cons(x, z), e)
}

theorem length_eq<A: Type>(x: A, l: List(A), m: List(A), e: l = m): List::length(Cons(x, l)) = List::length(Cons(x, m)) {
  Eq::congr(List::length, cons_eq(x, l, m, e))
}
```
checks_all = "ok"
checks.cons_eq = "ok"
checks.length_eq = "ok"

@ cases.nested-congruences-on-functions-take-their-types-from-the-inner-one
files."Base.taut" = path`../../std/Base.taut`
files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
theorem length_eq<A: Type>(x: A, l: List(A), m: List(A), e: l = m): List::length(Cons(x, l)) = List::length(Cons(x, m)) {
  Eq::congr((z: List(A)) => List::length(z), Eq::congr((z: List(A)) => Cons(x, z), e))
}

theorem succ_add(a: Nat, b: Nat, e: a = b): Nat::add(Succ(a), 1) = Nat::add(Succ(b), 1) {
  Eq::congr((z: Nat) => Nat::add(z, 1), Eq::congr(Succ, e))
}
```
checks_all = "ok"
checks.length_eq = "ok"
checks.succ_add = "ok"

