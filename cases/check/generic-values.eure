@ cases.a-lambda-waiting-for-its-type-is-not-compared-with-the-expected-type-as-written
// `at2` is generic in its result `R`. Its λ argument is elaborated only once
// `R` is known; as written it lacks the generics of the calls in its body
// (`expose(br)` for `expose(U64, br)`), so comparing the call's type with the
// expected one while the λ is still as written can never succeed, and tried
// to by unfolding the word arithmetic of both sides as far as it goes.
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::Secret
import std::UInt
import std::prelude::Secret

fn w_0(): U64 {
  U64::Mk(0, Refl)
}
fn w_1(): U64 {
  U64::Mk(1, Refl)
}
fn w_base(): U64 {
  U64::Mk(65536, Refl)
}
fn w_at(l: List(U64)): U64 {
  ⊢ U64 from match l {
    Nil => w_0()
    Cons(h, t) => h
  }
}
fn w_tail(l: List(U64)): List(U64) {
  ⊢ List(U64) from match l {
    Nil => Nil
    Cons(h, t) => t
  }
}
fn w_diff(x: U64, y: U64, br: U64): U64 {
  U64::wrapping_sub(U64::wrapping_add(x, w_base()), U64::wrapping_add(y, br))
}
fn w_next(d: U64): U64 {
  U64::wrapping_sub(w_1(), U64::shr(d, 16))
}
fn w_borrow(n: Nat, a: List(U64), b: List(U64), br: U64): U64 {
  ⊢ U64 from match n {
    Zero => br
    Succ(k) => w_borrow(k, w_tail(a), w_tail(b), w_next(w_diff(w_at(a), w_at(b), br)))
  }
}
fn s_at(l: List(Secret(U64))): Secret(U64) {
  ⊢ Secret(U64) from match l {
    Nil => Secret::Mk(w_0())
    Cons(h, t) => h
  }
}
fn s_tail(l: List(Secret(U64))): List(Secret(U64)) {
  ⊢ List(Secret(U64)) from match l {
    Nil => Nil
    Cons(h, t) => t
  }
}
fn s_expose(l: List(Secret(U64))): List(U64) {
  ⊢ List(U64) from match l {
    Nil => Nil
    Cons(h, t) => Cons(expose(h), s_expose(t))
  }
}
fn s_diff(x: Secret(U64), y: Secret(U64), br: Secret(U64)): Secret(U64) {
  Ct::u64_sub(Ct::u64_add(x, Secret::Mk(w_base())), Ct::u64_add(y, br))
}
fn s_next(d: Secret(U64)): Secret(U64) {
  Ct::u64_sub(Secret::Mk(w_1()), Ct::u64_shr(d, 16))
}
fn s_borrow(n: Nat, a: List(Secret(U64)), b: List(Secret(U64)), br: Secret(U64)): Secret(U64) {
  ⊢ Secret(U64) from match n {
    Zero => br
    Succ(k) => s_borrow(k, s_tail(a), s_tail(b), s_next(s_diff(s_at(a), s_at(b), br)))
  }
}
theorem at1<R>(f: (U64, List(U64)) -> R, a: List(Secret(U64))): f(expose(s_at(a)), s_expose(s_tail(a))) = f(w_at(s_expose(a)), w_tail(s_expose(a))) {
  ⊢ f(expose(s_at(a)), s_expose(s_tail(a))) = f(w_at(s_expose(a)), w_tail(s_expose(a))) from match a {
    Nil => Refl
    Cons(h, t) => Refl
  }
}
theorem at2<R>(f: (U64, U64, List(U64), List(U64)) -> R, a: List(Secret(U64)), b: List(Secret(U64))): f(expose(s_at(a)), expose(s_at(b)), s_expose(s_tail(a)), s_expose(s_tail(b))) = f(w_at(s_expose(a)), w_at(s_expose(b)), w_tail(s_expose(a)), w_tail(s_expose(b))) {
  Eq::trans(
    at1((x: U64, ta: List(U64)) => f(x, expose(s_at(b)), ta, s_expose(s_tail(b))), a),
    at1((y: U64, tb: List(U64)) => f(w_at(s_expose(a)), y, w_tail(s_expose(a)), tb), b)
  )
}
theorem borrow_eq(n: Nat, a: List(Secret(U64)), b: List(Secret(U64)), br: Secret(U64)): expose(s_borrow(n, a, b, br)) = w_borrow(n, s_expose(a), s_expose(b), expose(br)) {
  ⊢ expose(s_borrow(n, a, b, br)) = w_borrow(n, s_expose(a), s_expose(b), expose(br)) from match n {
    Zero => Refl
    Succ(k) => {
      let bv := expose(br)
      Eq::trans(
        borrow_eq(k, s_tail(a), s_tail(b), s_next(s_diff(s_at(a), s_at(b), br))),
        at2((x: U64, y: U64, ta: List(U64), tb: List(U64)) => w_borrow(k, ta, tb, w_next(w_diff(x, y, bv))), a, b)
      )
    }
  }
}
```

