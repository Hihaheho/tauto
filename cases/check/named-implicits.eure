// `f(<x: v>, h)` writes implicit arguments by name, before the explicit ones.
// The names are the generics' names; a value is a postfix expression.

@ cases.named-implicits-fix-the-generics
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
pub(open) inductive enum 記号 { M, I, U }

fn app(a: List(記号), b: List(記号)): List(記号) {
  match a {
    Nil => b
    Cons(h, t) => Cons(h, app(t, b))
  }
}

pub(open) inductive 導出可能: List(記号) -> Prop {
  公理: 導出可能([M, I])
  規則1<x: List(記号)>(h: 導出可能(app(x, [I]))): 導出可能(app(x, [I, U]))
  規則2<x: List(記号)>(h: 導出可能([M, ..x])): 導出可能([M, ..app(x, x)])
  規則3<x: List(記号), y: List(記号)>(h: 導出可能(app(x, [I, I, I, ..y]))): 導出可能(app(x, [U, ..y]))
}

theorem MIIIIUは作れる(): 導出可能([M, I, I, I, I, U]) {
  let mii: 導出可能([M, I, I]) := 規則2(公理)
  let miiii: 導出可能([M, I, I, I, I]) := 規則2(mii)
  規則1(<x: [M, I, I, I]>, miiii)
}

theorem MUIは作れる(): 導出可能([M, U, I]) {
  let mii: 導出可能([M, I, I]) := 規則2(公理)
  let miiii: 導出可能([M, I, I, I, I]) := 規則2(mii)
  規則3(<x: [M], y: [I]>, miiii)
}

theorem 演算は括弧の中(): 導出可能([M, I, I, I, I, U]) {
  let mii: 導出可能([M, I, I]) := 規則2(公理)
  let miiii: 導出可能([M, I, I, I, I]) := 規則2(mii)
  規則1(<x: app([M], [I, I, I])>, miiii)
}
```
checks_all = "ok"

@ cases.named-implicit-unknown-name
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
pub(open) inductive enum 記号 { M, I, U }

fn app(a: List(記号), b: List(記号)): List(記号) {
  match a {
    Nil => b
    Cons(h, t) => Cons(h, app(t, b))
  }
}

pub(open) inductive 導出可能: List(記号) -> Prop {
  公理: 導出可能([M, I])
  規則1<x: List(記号)>(h: 導出可能(app(x, [I]))): 導出可能(app(x, [I, U]))
  規則2<x: List(記号)>(h: 導出可能([M, ..x])): 導出可能([M, ..app(x, x)])
  規則3<x: List(記号), y: List(記号)>(h: 導出可能(app(x, [I, I, I, ..y]))): 導出可能(app(x, [U, ..y]))
}

theorem T(): 導出可能([M, I, I, I, I, U]) {
  let mii: 導出可能([M, I, I]) := 規則2(公理)
  let miiii: 導出可能([M, I, I, I, I]) := 規則2(mii)
  規則1(<z: [M, I, I, I]>, miiii)
}
```
checks."T" = "error: has no implicit parameter `z`"

