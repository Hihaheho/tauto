// A call written in the source does not pass implicit arguments by position.
@ cases.positional-implicits-are-an-error-in-source
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
pub(open) inductive enum 記号 { M, I, U }

fn app(a: List(記号), b: List(記号)): List(記号) {
  match a {
    Nil => b
    Cons(h, t) => Cons(h, app(t, b))
  }
}

pub(open) inductive 導出可能: List(記号) -> Prop {
  公理: 導出可能([M, I])
  規則1<x: List(記号)>(h: 導出可能(app(x, [I]))): 導出可能(app(x, [I, U]))
  規則2<x: List(記号)>(h: 導出可能([M, ..x])): 導出可能([M, ..app(x, x)])
  規則3<x: List(記号), y: List(記号)>(h: 導出可能(app(x, [I, I, I, ..y]))): 導出可能(app(x, [U, ..y]))
}

theorem T(): 導出可能([M, I, I, I, I, U]) {
  let mii: 導出可能([M, I, I]) := 規則2(公理)
  let miiii: 導出可能([M, I, I, I, I]) := 規則2(mii)
  規則1([M, I, I, I], miiii)
}
```
checks."T" = "error: implicit arguments are written by name"

// A call that a recursion through a λ moves under new names keeps its named
// arguments pointing at the same variables.
@ cases.named-implicits-follow-renamed-variables
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
pub(open) inductive R(a: Nat, b: Nat): Type {
  Yes(h: a = b): R(a, b)
  No: R(a, b)
}

pub fn go(a: Nat, b: Nat, rec: (x: Nat) -> (y: Nat) -> R(x, y)): R(a, b) { rec(a, b) }

pub fn f(fuel: Nat, a: Nat, b: Nat): R(a, b) {
  ⊢ R(a, b) from match fuel {
    Zero => No(<a: a, b: b>)
    Succ(k) => go(a, b, x => y => f(k, x, y))
  }
}
```
checks_all = "ok"

// A recursive call under a match names its implicit arguments as any call does.
@ cases.named-implicits-in-a-recursive-call
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
pub fn s<R: Type>(r: R, n: Nat): R {
  ⊢ R from match n {
    Zero => r
    Succ(k) => s(<R: R>, r, k)
  }
}
```
checks_all = "ok"
