@ cases.a-nullary-def-type-names-runtime-types-0
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
pub struct Position { x: i64, y: i64 }

def Nats(): Type := Nat
def Pair(): Type := { x: i64, y: i64 }
def Boids(): Type := {
  position: &Position,
}

fn first(p: Pair): i64 { p.x }
fn at(b: Boids): i64 { b.position.x }
fn count(n: Nats): Nat { n }
```

