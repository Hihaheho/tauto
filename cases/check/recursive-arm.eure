@ cases.a-call-on-a-field-matched-again-stays-structural-0
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive L: Type {
  Nl: L
  Cs(rest: L): L
}

// `rest` is matched again; the call on it is still a call on a field.
fn drop_last(xs: L): L {
  ⊢ L from match xs {
    Nl => Nl
    Cs(rest) => ⊢ L from match rest {
      Nl => Nl
      Cs(more) => Cs(drop_last(rest))
    }
  }
}

theorem drops_last(): drop_last(Cs(Cs(Cs(Nl)))) = Cs(Cs(Nl)) {
  Refl
}
```

