@ cases.the-matched-variable-in-a-recursive-arm-is-the-arm-constructor-in-recursive-calls-0
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive T: Type {
  Lf: T
  Nd(l: T, r: T): T
}

// `t` in the inner arm is `Nd(l, r)`, whatever the outermost call was given.
fn keep(t: T): T {
  ⊢ T from match t {
    Lf => Lf
    Nd(l, r) => ⊢ T from match keep(l) {
      Lf => t
      Nd(a, b) => Nd(keep(l), r)
    }
  }
}

theorem keeps(): keep(Nd(Nd(Lf, Lf), Lf)) = Nd(Nd(Lf, Lf), Lf) {
  Refl
}
```

checks_all = "ok"
checks."input/main.taut::T" = "ok"
checks."input/main.taut::keep" = "ok"
checks."input/main.taut::keeps" = "ok"

@ cases.a-call-on-a-matched-part-written-as-its-arm-constructor-is-structural-0
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive L: Type {
  Nl: L
  Cs(rest: L): L
}

// `Cs(more)` in the inner arm is `rest`, rebuilt from its fields.
fn drop_last(xs: L): L {
  ⊢ L from match xs {
    Nl => Nl
    Cs(rest) => ⊢ L from match rest {
      Nl => Nl
      Cs(more) => Cs(drop_last(Cs(more)))
    }
  }
}

theorem drops_last(): drop_last(Cs(Cs(Cs(Nl)))) = Cs(Cs(Nl)) {
  Refl
}
```

