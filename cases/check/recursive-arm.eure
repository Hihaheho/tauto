@ cases.a-call-on-a-rebuilt-part-has-the-type-of-the-arm-constructor-0
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive L: Type {
  Nl: L
  Cs(rest: L): L
}

inductive U: Type {
  Mk: U
}

fn T(xs: L): Type {
  ⊢ Type from match xs {
    Nl => U
    Cs(r) => T(r)
  }
}

// The arm's goal is `T(Cs(more))`, which a call on `rest` would not have.
fn mk(xs: L, a: T(xs)): T(xs) {
  ⊢ T(xs) from match xs {
    Nl => a
    Cs(rest) => (⊢ (T(rest)) -> T(rest) from match rest {
      Nl => (p) => p
      Cs(more) => (p) => mk(Cs(more), p)
    })(a)
  }
}
```

checks_all = "ok"
checks."input/main.taut::L" = "ok"
checks."input/main.taut::U" = "ok"
checks."input/main.taut::T" = "ok"
checks."input/main.taut::mk" = "ok"

@ cases.a-match-applied-to-its-hypotheses-one-at-a-time-is-structural-0
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive L: Type {
  Nl: L
  Cs(rest: L): L
}

// `(match …)(a)(b)` is `(match …)(a, b)`.
theorem same(xs: L, a: xs = xs, b: xs = xs): xs = xs {
  (⊢ (xs = xs) -> (xs = xs) -> xs = xs from match xs {
    Nl => (p) => (q) => p
    Cs(rest) => (p) => (q) => ⊢ Cs(rest) = Cs(rest) from match same(rest, Refl, Refl) {
      Refl => p
    }
  })(a)(b)
}
```

checks_all = "ok"
checks."input/main.taut::L" = "ok"
checks."input/main.taut::same" = "ok"

@ cases.the-matched-value-rebuilt-or-a-rebuilt-part-under-a-binder-is-not-structural-0
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive L: Type {
  Nl: L
  Cs(rest: L): L
}

// `Cs(rest)` is `xs` itself, not a part of it.
fn again(xs: L): L {
  ⊢ L from match xs {
    Nl => Nl
    Cs(rest) => again(Cs(rest))
  }
}

// Under the λ, `more` is the λ's parameter, so `Cs(more)` is not `rest`.
fn under(xs: L): L {
  ⊢ L from match xs {
    Nl => Nl
    Cs(rest) => ⊢ L from match rest {
      Nl => Nl
      Cs(more) => ((more: L) => under(Cs(more)))(Cs(rest))
    }
  }
}
```

checks_all = "ok"
checks."input/main.taut::L" = "ok"
checks."input/main.taut::again" = "error: "
checks."input/main.taut::under" = "error: "
