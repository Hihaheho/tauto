@ cases.a-recursive-call-of-a-function-with-a-where-passes-a-later-argument-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::prelude::Ord

inductive Walk(K: Type): (K, List(K)) -> Prop {
  WHere(c: K): Walk(K, c, Nil)
  WStep(a: K, i: K, vs: List(K), p: Walk(K, i, vs)): Walk(K, a, Cons(a, vs))
}

theorem step<K>(vs: List(K), ih: (vs = vs) -> True): True { ih(Refl) }

theorem down<K>(b: K, vs: List(K), p: Walk(K, b, vs), a: K, h: vs = vs, e: vs = vs): True where Ord(K) {
  ⊢ True from match p {
    WHere(c) => Trivial
    WStep(c, i, vs0, p0) => step(vs0, (e0: vs0 = vs0) => down(i, vs0, p0, a, e0, e0))
  }
}
```

checks_all = "ok"
checks."input/main.taut::Walk" = "ok"
checks."input/main.taut::step" = "ok"
checks."input/main.taut::down" = "ok"

@ cases.a-recursive-call-of-a-function-with-a-where-on-the-same-value-is-rejected-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::prelude::Ord

inductive Walk(K: Type): (K, List(K)) -> Prop {
  WHere(c: K): Walk(K, c, Nil)
  WStep(a: K, i: K, vs: List(K), p: Walk(K, i, vs)): Walk(K, a, Cons(a, vs))
}

theorem stay<K>(b: K, vs: List(K), p: Walk(K, b, vs), h: vs = vs): True where Ord(K) {
  ⊢ True from match p {
    WHere(c) => Trivial
    WStep(c, i, vs0, p0) => stay(b, vs, p, h)
  }
}
```

