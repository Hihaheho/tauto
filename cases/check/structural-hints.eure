checks."input/main.taut::two" = "error: "
@ cases.a-recursive-call-with-the-arguments-in-another-order-says-where-to-pass-the-part-0.diagnostics[]
file = "input/main.taut"
name = "two"
message = "`two(a, k)` is not structural: `two` matches on its parameter `a`, so the argument for `a` is a part of the value matched here (a field, a field of a field matched in the arm, a function-typed field applied to all its arguments, or a part matched in the arm written as the arm's constructor), and `a` is not. `k` is a part of `a`, but this call passes it for `b`; pass it for `a`, as in `two(k, a)` (the arguments are in the order of the parameters)"
span = "Succ(k) => «two(a, k)»"

