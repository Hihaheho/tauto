// A text or float literal is core: a file that sees the prelude states one in a theorem without importing
// the model the kernel reads it through (`std::text`, `std::float`).

@ cases.a-theorem-states-a-text-literal-without-an-import
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
theorem same(): "a" = "a" { Refl }
theorem length(): Text::len("ab") = 2 { Refl }
```
checks."input/main.taut::same" = "ok"
checks."input/main.taut::length" = "ok"

@ cases.a-theorem-states-a-float-literal-without-an-import
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
theorem same(): 1.5 = 1.5 { Refl }
```
checks."input/main.taut::same" = "ok"
