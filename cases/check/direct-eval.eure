source = ```taut
import std::Int
fn empty(): MCx { Mcx(MtLeaf, 0, None, IntOfNat(0), IntOfNat(0), Nil, None, Nil, false) }
fn program(): MProgram { Mprogram(Nil, Nil, 0) }
fn compiler(): CSt { Cst(Nil, 0, Nil, Nil, 0, None) }
fn expression(): Cps { CMap(CMap(CPure(CvBool(true)), CuTempRef), CuDeref) }
fn final_heap(): MCx {
  match cx_temp(empty(), MvBool(true)) {
    Pair { fst: ref, snd: heap } => heap
  }
}
theorem nested_eval(): e_eval(9, Nil, Nil, expression(), empty()) =
  ErValue(MvBool(true), final_heap()) { Refl }
theorem nested_compiler_state(k: MCode): e_compile_state(c_expr(9, expression(), k, compiler())) = compiler() {
  e_unary_compile_state(EuMap(CuDeref, EuMap(CuTempRef, EuLiteral(CvBool(true)))), 6, k, compiler())
}
theorem nested_compiled(k: MCode, slots: List(MVal), stack: List(MVal), frames: List(MFrame)): mrun(program(), 3,
    Mstate(e_code(c_expr(9, expression(), k, compiler())), slots, stack, frames, empty())) =
  MstepNext(Mstate(k, slots, Cons(MvBool(true), stack), frames, final_heap())) {
  e_unary_expr_mrun(
    EuMap(CuDeref, EuMap(CuTempRef, EuLiteral(CvBool(true)))), 9,
    program(), Nil, empty(), MvBool(true), final_heap(),
    k, compiler(), slots, stack, frames, nested_eval()
  )
}
```

