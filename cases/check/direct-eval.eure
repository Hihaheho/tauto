source = ```taut
import std::Int
fn empty(): MCx { Mcx(MtLeaf, 0, None, IntOfNat(0), IntOfNat(0), Nil, None, Nil, false) }
fn program(): MProgram { Mprogram(Nil, Nil, 0) }
fn literal(n: Nat): Cps { CPure(CvInt(IntOfNat(n))) }
fn allocate(cx: MCx, n: Nat): MCx {
  match cx_temp(cx, MvInt(IntOfNat(n))) {
    Pair { fst: ref, snd: heap } => heap
  }
}
fn ordered(): Cps {
  MkCPrim(CprProduct([Pair { fst: 0, snd: None }, Pair { fst: 1, snd: None }]),
    [CMap(literal(11), CuTempRef), CMap(literal(22), CuTempRef)])
}
fn ordered_value(): MVal {
  MvProduct([MvRef(0, MrPath(Nil)), MvRef(1, MrPath(Nil))])
}
fn ordered_heap(): MCx { allocate(allocate(empty(), 11), 22) }
theorem ordered_eval(): e_eval(8, Nil, Nil, ordered(), empty()) = ErValue(ordered_value(), ordered_heap()) { Refl }
theorem ordered_compiler_state(k: MCode, cs: CSt): e_compile_state(c_expr(8, ordered(), k, cs)) = cs {
  And::left(e_primitive_expr_correct(8, ordered(), AndIntro(Trivial, AndIntro(Trivial, Trivial)),
    program(), Nil, empty(), ordered_value(), ordered_heap(), k, cs, Nil, Nil, Nil, ordered_eval()))
}
theorem ordered_compiled(k: MCode, cs: CSt, slots: List(MVal), stack: List(MVal), frames: List(MFrame)): mrun(program(), 5,
  Mstate(e_code(c_expr(8, ordered(), k, cs)), slots, stack, frames, empty())) =
  MstepNext(Mstate(k, slots, Cons(ordered_value(), stack), frames, ordered_heap())) {
  e_primitive_expr_mrun(8, ordered(), AndIntro(Trivial, AndIntro(Trivial, Trivial)),
    program(), Nil, empty(), ordered_value(), ordered_heap(), k, cs, slots, stack, frames, ordered_eval())
}
fn nested(): Cps {
  MkCPrim(CprArith(1, 1), [MkCPrim(CprArith(2, 1), [literal(6), literal(7)]),
    CSeq([CMap(literal(9), CuTempRef), literal(2)])])
}
theorem nested_eval(): e_eval(12, Nil, Nil, nested(), empty()) = ErValue(MvInt(IntOfNat(40)), allocate(empty(), 9)) { Refl }
theorem nested_compiled(k: MCode, cs: CSt, slots: List(MVal), stack: List(MVal), frames: List(MFrame)): mrun(program(), 8,
  Mstate(e_code(c_expr(12, nested(), k, cs)), slots, stack, frames, empty())) =
  MstepNext(Mstate(k, slots, Cons(MvInt(IntOfNat(40)), stack), frames, allocate(empty(), 9))) {
  e_primitive_expr_mrun(12, nested(), AndIntro(AndIntro(Trivial, AndIntro(Trivial, Trivial)),
      AndIntro(AndIntro(Trivial, AndIntro(Trivial, Trivial)), Trivial)),
    program(), Nil, empty(), MvInt(IntOfNat(40)), allocate(empty(), 9), k, cs, slots, stack, frames, nested_eval())
}
fn empty_sequence(): Cps { CSeq([CSeq(Nil)]) }
theorem empty_eval(): e_eval(4, Nil, Nil, empty_sequence(), empty()) = ErValue(MvUnit, empty()) { Refl }
theorem empty_compiled(k: MCode, cs: CSt, slots: List(MVal), stack: List(MVal), frames: List(MFrame)): mrun(program(), 1,
  Mstate(e_code(c_expr(4, empty_sequence(), k, cs)), slots, stack, frames, empty())) =
  MstepNext(Mstate(k, slots, Cons(MvUnit, stack), frames, empty())) {
  e_primitive_expr_mrun(4, empty_sequence(), AndIntro(Trivial, Trivial),
    program(), Nil, empty(), MvUnit, empty(), k, cs, slots, stack, frames, empty_eval())
}
fn zero_args(): Cps { MkCPrim(CprProduct(Nil), Nil) }
theorem zero_args_eval(): e_eval(2, Nil, Nil, zero_args(), empty()) = ErValue(MvProduct(Nil), empty()) { Refl }
theorem zero_args_compiled(k: MCode, cs: CSt, slots: List(MVal), stack: List(MVal), frames: List(MFrame)): mrun(program(), 1,
  Mstate(e_code(c_expr(2, zero_args(), k, cs)), slots, stack, frames, empty())) =
  MstepNext(Mstate(k, slots, Cons(MvProduct(Nil), stack), frames, empty())) {
  e_primitive_expr_mrun(2, zero_args(), Trivial,
    program(), Nil, empty(), MvProduct(Nil), empty(), k, cs, slots, stack, frames, zero_args_eval())
}
