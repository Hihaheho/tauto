// `.` takes a field and `::` a declaration's name; a product's members of
// the same type are told apart by labels.

@ cases.dot-before-a-declaration-name-is-rejected
entry = "main.taut"
files."main.taut" = ```tauto
fn len(l: List(Nat)): Nat { List.length(l) }
```
check_errors = ["`List` is a type, and a field is read from a value: for `x` of type `List`, write `x.length`"]

@ cases.a-path-after-an-expression-does-not-parse
source = ```tauto
fn f(l: List(Nat)): Nat { id(l)::length }
```
parses = false

@ cases.ascription-of-a-product-with-two-members-of-the-type-is-rejected
source = ```tauto
fn first(p: Nat × Nat): Nat { (p: Nat) }
```
checks."first" = "error: two members of a product have the type `Nat`, so the members cannot be matched by their types; write the members by position, or tell them apart with a label (`@x Nat`)"

@ cases.labels-tell-members-of-the-same-type-apart
source = ```tauto
fn first(p: @a Nat × @b Nat): Nat { (p: @a Nat) }
```
checks."first" = "ok"

@ cases.a-constructor-pattern-on-a-labelled-value-says-to-label-the-pattern
description = "`@a List(T)` is a type of its own: a bare `Nil` does not match it, and the error points to `@a Nil` and to the annotation without the label"
source = ```tauto
fn len<T>(out: @requests List(T)): Nat {
  match (out: @requests List(T)) {
    Nil => Zero
    Cons(_, t) => Succ(Zero)
  }
}
```
checks."len" = "error: `List::Nil` is a constructor of `List`, but the value matched is under the label `@requests`"

@ cases.a-label-in-the-pattern-or-off-in-the-annotation-matches-a-labelled-value
source = ```tauto
fn by_pattern<T>(out: @requests List(T)): Nat {
  match out {
    @requests Nil => Zero
    @requests Cons(_, t) => Succ(Zero)
  }
}
fn by_annotation<T>(out: @requests List(T)): Nat {
  match (out: List(T)) {
    Nil => Zero
    Cons(_, t) => Succ(Zero)
  }
}
```
checks."by_pattern" = "ok"
checks."by_annotation" = "ok"
