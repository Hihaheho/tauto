@ cases.a-written-eliminator-call-without-its-implicit-argument-types-the-binders-of-its-cases
entry = "main.taut"
files."main.taut" = ```tauto
import std::base
inductive S: Type {
  I: S
  O: S
}
fn count(l: List(S)): Nat {
  match l {
    Nil => Zero
    Cons(c, r) => match c {
      I => Succ(count(r))
      O => count(r)
    }
  }
}
fn cat(a: List(S), b: List(S)): List(S) {
  match a {
    Nil => b
    Cons(c, r) => Cons(c, cat(r, b))
  }
}
fn plus(a: Nat, b: Nat): Nat {
  match a {
    Zero => b
    Succ(p) => Succ(plus(p, b))
  }
}
theorem count_cat_left(a: List(S), b: List(S)): count(cat(a, b)) = plus(count(a), count(b)) {
  List::ind(
    t => (b2: List(S)) -> count(cat(t, b2)) = plus(count(t), count(b2)),
    b3 => Refl,
    (c, r, ih: (b4: List(S)) -> count(cat(r, b4)) = plus(count(r), count(b4)), b6) =>
      ⊢ count(cat(Cons(c, r), b6)) = plus(count(Cons(c, r)), count(b6)) from match c {
        I => Eq::congr(Succ, ih(b6))
        O => ih(b6)
      },
    a,
    b
  )
}
```
checks.count_cat_left = "ok"

