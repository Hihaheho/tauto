import std::base
fn len(l: List(Nat)): Nat { List::length(l) }
theorem len_self(l: List(Nat)): len(l) = len(l) {
  List::ind(
    Nat,
    (k) => len(k) = len(k),
    Refl,
    (h, t, ih) => ⊢ len(Cons(h, t)) = len(Cons(h, t)) from match h {
      Zero => Refl
      Succ(p) => Refl
    },
    l
  )
}
```
checks.len_self = "ok"

