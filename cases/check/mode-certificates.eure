@ cases.type-inference-contract
imports = [path`../../examples/lambda/Lib.taut`]
source = ```tauto
fn inferred_type(t: Tm, G: List(Ty)): Option(Ty) {
  ⊢ Option(Ty) from match infer(t, G) {
    inferred(A, h, unique) => Some(A)
    not_inferred(refute) => None
  }
}
theorem infer_identity(): Eq(Option(Ty), inferred_type(Lam(Tunit, Tvar(Zero)), Nil), Some(Arr(Tunit, Tunit))) { Refl }
theorem infer_application(): Eq(Option(Ty), inferred_type(App(Lam(Tunit, Tvar(Zero)), Tstar), Nil), Some(Tunit)) { Refl }
theorem reject_shape(): Eq(Option(Ty), inferred_type(App(Tstar, Tstar), Nil), None) { Refl }
theorem reject_argument(): Eq(Option(Ty), inferred_type(App(Lam(Arr(Tunit, Tunit), Tstar), Tstar), Nil), None) { Refl }
theorem reject_variable(): Eq(Option(Ty), inferred_type(Tvar(Zero), Nil), None) { Refl }
theorem infer_unique(t: Tm, G: List(Ty), A: Ty, B: Ty, ha: Typing(G, t, A), hb: Typing(G, t, B)): Eq(Ty, A, B) {
  ⊢ Eq(Ty, A, B) from match infer(t, G) {
    inferred(C, h, unique) => Eq::trans(unique(A, ha), Eq::sym(unique(B, hb)))
    not_inferred(refute) => False::elim(refute(A, ha))
  }
}
fn infer_contract(t: Tm, G: List(Ty)): Or(Exists(Ty, A => Typing(G, t, A)), (∀ A: Ty. (Typing(G, t, A)) -> False)) {
  ⊢ Or(Exists(Ty, A => Typing(G, t, A)), (∀ A: Ty. (Typing(G, t, A)) -> False)) from match infer(t, G) {
    inferred(A, h, unique) => OrInl(ExIntro(A, h))
    not_inferred(refute) => OrInr(refute)
  }
}
```
checks.infer = "ok"
checks.inferred_type = "ok"
checks.lookup = "ok"
checks.infer_identity = "ok"
checks.infer_application = "ok"
checks.reject_shape = "ok"
checks.reject_argument = "ok"
checks.reject_variable = "ok"
checks.infer_unique = "ok"
checks.infer_contract = "ok"
diagnostics = []

@ cases.position-names-do-not-capture
imports = [path`../../std/Mode.taut`]
source = ```tauto
@mode!(`named(rec h, in unique, out mode_other) -> NamedAnswer { NamedYes | NamedNo }`) => inductive NamedAnswer, fn named
inductive Named: (Nat, Nat, Nat) -> Prop {
  NamedRule<x: Nat, y: Nat>: Named(x, y, x)
}
fn named_contract(h: Nat, unique: Nat): Or(Exists(Nat, n => Named(h, unique, n)), (∀ n: Nat. (Named(h, unique, n)) -> False)) {
  ⊢ Or(Exists(Nat, n => Named(h, unique, n)), (∀ n: Nat. (Named(h, unique, n)) -> False)) from match named(h, unique) {
    NamedYes(n, proof, one) => OrInl(ExIntro(n, proof))
    NamedNo(absent) => OrInr(absent)
  }
}
@mode!(`labels(rec B, in A, in pair, out n) -> LabelsAnswer { LabelsYes | LabelsNo }`) => inductive LabelsAnswer, fn labels
inductive Labels: (A: Type) -> (B: Type) -> (Pair(A, B)) -> (Nat) -> Prop {
  LabelsRule<X: Type, Y: Type, p: Pair(X, Y)>: Labels(X, Y, p, Zero)
}
fn labels_value(A: Type, B: Type, p: Pair(A, B)): Nat {
  ⊢ Nat from match labels(A, B, p) {
    LabelsYes(n, proof, one) => n
    LabelsNo(absent) => Zero
  }
}
theorem labels_zero(): Eq(Nat, labels_value(Nat, Bool, Pair { fst: Succ(Zero), snd: true }), Zero) { Refl }
```
checks.named = "ok"
checks.named_contract = "ok"
checks.labels = "ok"
checks.labels_zero = "ok"
diagnostics = []

@ cases.type-input-contract
imports = [path`../../std/Mode.taut`]
source = ```tauto
@mode!(
  `label(rec T, in value, out result) -> LabelAnswer { LabelYes | LabelNo }`
) => inductive LabelAnswer, fn label
inductive Label: (A: Type) -> (A) -> (Nat) -> Prop {
  LabelRule<A: Type, x: A>: Label(A, x, Zero)
}
fn label_value(A: Type, x: A): Nat {
  ⊢ Nat from match label(A, x) {
    LabelYes(n, h, unique) => n
    LabelNo(refute) => Zero
  }
}
theorem label_contract(): Eq(Nat, label_value(Nat, Succ(Zero)), Zero) { Refl }
```
checks.Label = "ok"
checks.LabelAnswer = "ok"
checks.label = "ok"
checks.label_value = "ok"
checks.label_contract = "ok"
diagnostics = []
