@mode!(`f(rec n, out m) -> Answer { Yes | No } eq Nat: dec { Same | Diff }`) => inductive Answer, fn f
inductive R: (Nat, Nat) -> Prop {
  RZero: R(Zero, Zero)
  RSucc<n: Nat>(h: R(n, n)): R(Succ(n), n)
}
```
