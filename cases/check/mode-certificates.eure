@ cases.via-needs-uniqueness
imports = [path`../../std/Mode.taut`]
source = ```tauto
inductive Other: (Nat, Nat) -> Prop { OtherRule<n: Nat>: Other(n, n) }
inductive OldAnswer(n: Nat): Type {
  Good(out: Nat, h: Other(n, out)): OldAnswer(n)
  Bad(refute: (∀ out: Nat. (Other(n, out)) -> False)): OldAnswer(n)
}
fn other(n: Nat): OldAnswer(n) { Good(n, OtherRule) }
@mode!(`f(rec n, out m) -> Answer { Yes | No } via Other: other { Good | Bad }`) => inductive Answer, fn f
inductive R: (Nat, Nat) -> Prop { Rule<n: Nat, m: Nat>(h: Other(n, m)): R(n, m) }
```
macro_error = "via Other success needs output, derivation and uniqueness"

@ cases.via-needs-refutation
imports = [path`../../std/Mode.taut`]
source = ```tauto
inductive Other: (Nat, Nat) -> Prop { OtherRule<n: Nat>: Other(n, n) }
inductive OldAnswer(n: Nat): Type {
  Good(out: Nat, h: Other(n, out), unique: (∀ y: Nat. (Other(n, y)) -> Eq(Nat, y, out))): OldAnswer(n)
  Bad: OldAnswer(n)
}
fn other(n: Nat): OldAnswer(n) { Good(n, OtherRule, y => h => ⊢ Eq(Nat, y, n) from match h { OtherRule(k) => Refl }) }
@mode!(`f(rec n, out m) -> Answer { Yes | No } via Other: other { Good | Bad }`) => inductive Answer, fn f
inductive R: (Nat, Nat) -> Prop { Rule<n: Nat, m: Nat>(h: Other(n, m)): R(n, m) }
```
macro_error = "via Other rejection needs a refutation"

@ cases.constructor-metadata
entry = "main.taut"
files."lib.taut" = ```tauto
import std::prelude::Macro

pub macro fn metadata(c: Judgement): SynExpr ! {elab} {
  let list_ok := match Elab::constructor_arity(SynIdent { declaration: None, name: "Cons", ctx: SynCtx { scopes: Nil }, span: SynSpan { id: 0 } }) { Some(n) => n == 2
    None => false }
  let packet_ok := match Elab::constructor_arity(SynIdent { declaration: None, name: "Packet", ctx: SynCtx { scopes: Nil }, span: SynSpan { id: 0 } }) { Some(n) => n == 2
    None => false }
  let bool_ok := match Elab::constructor_arity(SynIdent { declaration: None, name: "true", ctx: SynCtx { scopes: Nil }, span: SynSpan { id: 0 } }) { Some(n) => n == 0
    None => false }
  let missing_ok := match Elab::constructor_arity(SynIdent { declaration: None, name: "Payload", ctx: SynCtx { scopes: Nil }, span: SynSpan { id: 0 } }) { Some(_) => false
    None => true }
  if list_ok && packet_ok && bool_ok && missing_ok { quote { Zero } } else { quote { Succ(Zero) } }
}
```
files."main.taut" = ```tauto
import "lib.taut"
inductive Payload(A: Type): (Nat) -> Type {
  Packet<k: Nat>(value: A): Payload(A, k)
}
theorem metadata_contract(): Eq(Nat, metadata!(Zero), Zero) { Refl }
```
checks.metadata_contract = "ok"
diagnostics = []

@ cases.via-uniqueness-type-is-checked
imports = [path`../../std/Mode.taut`]
source = ```tauto
inductive Other: (Nat, Nat) -> Prop { OtherRule<n: Nat>: Other(n, n) }
inductive OldAnswer(n: Nat): Type {
  Good(out: Nat, h: Other(n, out), unique: (∀ y: Nat. (Other(n, y)) -> True)): OldAnswer(n)
  Bad(refute: (∀ y: Nat. (Other(n, y)) -> False)): OldAnswer(n)
}
fn other(n: Nat): OldAnswer(n) { Good(n, OtherRule, y => h => Trivial) }
@mode!(`f(rec n, out m) -> Answer { Yes | No } via Other: other { Good | Bad }`) => inductive Answer, fn f
inductive R: (Nat, Nat) -> Prop { Rule<n: Nat, m: Nat>(h: Other(n, m)): R(n, m) }
```
checks.other = "ok"
checks.f = "error: "

@ cases.via-refutation-type-is-checked
imports = [path`../../std/Mode.taut`]
source = ```tauto
inductive Other: (Nat, Nat) -> Prop { OtherRule<n: Nat>: Other(n, n) }
inductive OldAnswer(n: Nat): Type {
  Good(out: Nat, h: Other(n, out), unique: (∀ y: Nat. (Other(n, y)) -> Eq(Nat, y, out))): OldAnswer(n)
  Bad(refute: (∀ y: Nat. (Other(n, y)) -> True)): OldAnswer(n)
}
fn other(n: Nat): OldAnswer(n) {
  Good(n, OtherRule, y => h => ⊢ Eq(Nat, y, n) from match h { OtherRule(k) => Refl })
}
@mode!(`f(rec n, out m) -> Answer { Yes | No } via Other: other { Good | Bad }`) => inductive Answer, fn f
inductive R: (Nat, Nat) -> Prop { Rule<n: Nat, m: Nat>(h: Other(n, m)): R(n, m) }
```
checks.other = "ok"
checks.f = "error: type mismatch"

