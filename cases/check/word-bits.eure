description = "The bits of a word: and, or, exclusive or, shifts and rotations of `UInt(32)` and `UInt(64)`, decided by `Refl` in the kernel and run the same on every backend."

@ cases.word-bits-agree
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `UInt::and32` yet"
source = ```tauto
import std::uint
import std::base
import std::nat
fn w(n: Nat): UInt(32) { UInt::mk32(Nat::rem_nz(n, 4294967296, Nat::ne_zero_of_pos(4294967296, Refl)), Nat::mod_lt(n, 4294967296, Refl)) }
theorem and_v(): UInt::val32(UInt::and32(w(4042322160), w(4278255360))) = 4026593280 { Refl }
theorem xor_v(): UInt::val32(UInt::xor32(w(1732584193), w(4023233417))) = 2290649224 { Refl }
theorem rotl_v(): UInt::val32(UInt::rotl32(w(2147483649), 1)) = 3 { Refl }
theorem rotr_v(): UInt::val32(UInt::rotr32(w(3), 1)) = 2147483649 { Refl }
theorem shl_v(): UInt::val32(UInt::shl32(w(4294967295), 4)) = 4294967280 { Refl }
fn show_all(): List(Nat) {
  Cons(UInt::val32(UInt::and32(w(4042322160), w(4278255360))),
  Cons(UInt::val32(UInt::or32(w(240), w(15))),
  Cons(UInt::val32(UInt::xor32(w(1732584193), w(4023233417))),
  Cons(UInt::val32(UInt::rotl32(w(2147483649), 33)),
  Cons(UInt::val32(UInt::rotr32(w(3), 1)),
  Cons(UInt::val32(UInt::shr32(w(256), 4)),
  Cons(UInt::val32(UInt::rotr32(w(3), 1000001)),
  Cons(UInt::val32(UInt::shr32(w(256), Nat::add(2, 2))),
  Cons(⊢ Nat from match UInt::of_nat_checked64(1) { Some(x) => UInt::val64(UInt::rotl64(x, 62)), None => 0 }, Nil)))))))))
}
show(&show_all())
```
checks.and_v = "checked"
checks.xor_v = "checked"
checks.rotl_v = "checked"
checks.rotr_v = "checked"
checks.shl_v = "checked"
stdout = "[4026593280, 255, 2290649224, 3, 2147483649, 16, 2147483649, 16, 4611686018427387904]\n"

// A SHA-1 test vector (one block, eighty rounds) as a theorem: the kernel
// computes the words' bits on numerals, so `Refl` decides it.
@ cases.sha1-test-vector-by-refl
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Nat::of_u64` yet"
source = ```tauto
import std::uint
import std::base
import std::nat
fn w(n: Nat): UInt(32) { UInt::mk32(Nat::rem_nz(n, 4294967296, Nat::ne_zero_of_pos(4294967296, Refl)), Nat::mod_lt(n, 4294967296, Refl)) }
fn add(a: UInt(32), b: UInt(32)): UInt(32) { UInt::wrapping_add32(a, b) }
fn not32(a: UInt(32)): UInt(32) { UInt::xor32(a, w(4294967295)) }
fn at(l: List(UInt(32)), n: Nat): UInt(32) {
  ⊢ UInt(32) from match l {
    Nil => w(0)
    Cons(x, rest) => ⊢ UInt(32) from match n { Zero => x, Succ(k) => at(rest, k) }
  }
}
fn tail_of(l: List(UInt(32))): List(UInt(32)) { ⊢ List(UInt(32)) from match l { Nil => Nil, Cons(x, rest) => rest } }
fn snoc(l: List(UInt(32)), y: UInt(32)): List(UInt(32)) {
  ⊢ List(UInt(32)) from match l { Nil => Cons(y, Nil), Cons(x, rest) => Cons(x, snoc(rest, y)) }
}
inductive St: Type { Mk(a: UInt(32), b: UInt(32), c: UInt(32), d: UInt(32), e: UInt(32)): St }
fn f_of(t: Nat, b: UInt(32), c: UInt(32), d: UInt(32)): UInt(32) {
  ⊢ UInt(32) from match Nat::lt(t, 20) {
    true => UInt::or32(UInt::and32(b, c), UInt::and32(not32(b), d))
    false => ⊢ UInt(32) from match Nat::lt(t, 40) {
      true => UInt::xor32(UInt::xor32(b, c), d)
      false => ⊢ UInt(32) from match Nat::lt(t, 60) {
        true => UInt::or32(UInt::or32(UInt::and32(b, c), UInt::and32(b, d)), UInt::and32(c, d))
        false => UInt::xor32(UInt::xor32(b, c), d)
      }
    }
  }
}
fn k_of(t: Nat): UInt(32) {
  ⊢ UInt(32) from match Nat::lt(t, 20) {
    true => w(1518500249)
    false => ⊢ UInt(32) from match Nat::lt(t, 40) {
      true => w(1859775393)
      false => ⊢ UInt(32) from match Nat::lt(t, 60) { true => w(2400959708), false => w(3395469782) }
    }
  }
}
fn rounds(n: Nat, t: Nat, win: List(UInt(32)), s: St): St {
  ⊢ St from match n {
    Zero => s
    Succ(m) => ⊢ St from match s {
      Mk(a, b, c, d, e) => {
        let wt := at(win, 0)
        let next := UInt::rotl32(UInt::xor32(UInt::xor32(at(win, 13), at(win, 8)), UInt::xor32(at(win, 2), at(win, 0))), 1)
        let temp := add(add(add(UInt::rotl32(a, 5), f_of(t, b, c, d)), add(e, k_of(t))), wt)
        rounds(m, Succ(t), snoc(tail_of(win), next), St::Mk(temp, a, UInt::rotl32(b, 30), c, d))
      }
    }
  }
}
fn h0(): St { St::Mk(w(1732584193), w(4023233417), w(2562383102), w(271733878), w(3285377520)) }
fn digest(block: List(UInt(32))): List(Nat) {
  ⊢ List(Nat) from match rounds(80, 0, block, h0()) {
    Mk(a, b, c, d, e) => ⊢ List(Nat) from match h0() {
      Mk(a0, b0, c0, d0, e0) => Cons(UInt::val32(add(a, a0)), Cons(UInt::val32(add(b, b0)), Cons(UInt::val32(add(c, c0)),
        Cons(UInt::val32(add(d, d0)), Cons(UInt::val32(add(e, e0)), Nil)))))
    }
  }
}
fn abc(): List(UInt(32)) {
  Cons(w(1633837952), Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(0),
  Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(0), Cons(w(24), Nil))))))))))))))))
}
theorem sha1_abc(): digest(abc()) = Cons(2845392438, Cons(1191608682, Cons(3124634993, Cons(2018558572, Cons(2630932637, Nil))))) { Refl }
show(&digest(abc()))
```
checks.sha1_abc = "checked"
stdout = "[2845392438, 1191608682, 3124634993, 2018558572, 2630932637]\n"
