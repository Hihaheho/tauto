description = "Generated class dictionaries infer field universes without relaxing user-written inductive universe checks."

@ cases.type-returning-class-method
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
class HasChild(Env: Type) { fn child_type(&env: Env): Type }
instance HasChild(Nat) { fn child_type(&env: Nat): Type { Nat } }
fn child(): Type { HasChild::child_type(0) }
fn value(): child() { 7 }
```
checks_all = "ok"

