@ cases.pure-law-can-instantiate-method-local-type
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
class Identity(A: Type) {
  fn apply<B>(owner: A, value: B): B
  theorem identity<B>(owner: A, value: B): Identity::apply(owner, value) = value
}
instance Identity(Nat) {
  fn apply<B>(owner: Nat, value: B): B { value }
  theorem identity<B>(owner: Nat, value: B): Identity::apply(owner, value) = value { Refl }
}
theorem computes(): Eq(Nat, Identity::apply(0, 7), 7) { Identity::identity(0, 7) }
```
checks_all = "ok"
