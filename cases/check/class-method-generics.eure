inductive class Key(K: Type) { fn digest<H>(a: &K, h: H): H where Mix(H) }
instance Key(Nat) { fn digest<H>(a: &Nat, h: H): H { h } }
```
checks."input/main.taut::Key(Nat)" = "error: has 2 parameters, but the class has 3"
