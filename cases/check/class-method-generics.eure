@ cases.pure-law-can-instantiate-method-local-type
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive class Identity(A: Type) {
  fn apply<B>(owner: A, value: B): B
  theorem identity<B>(owner: A, value: B): Identity::apply(owner, value) = value
}
instance Identity(Nat) {
  fn apply<B>(owner: Nat, value: B): B { value }
  theorem identity<B>(owner: Nat, value: B): Identity::apply(owner, value) = value { Refl }
}
theorem computes(): Eq(Nat, Identity::apply(0, 7), 7) { Identity::identity(0, 7) }
```
checks_all = "ok"

@ cases.borrowed-parameters-on-a-generic-method-are-read-as-their-values
imports = [path`../../std/base.taut`, path`../../std/uint.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive class Key(K: Type) {
  fn eq(a: &K, b: &K): Bool
  fn feed<H>(a: &K, h: H, step: &((H, UInt(64)) -> H)): H
  theorem feed_const<a: K, H: Type, s: H, step: (H, UInt(64)) -> H>(): Key::feed(a, s, step) = s
}
instance Key(Nat) {
  fn eq(a: &Nat, b: &Nat): Bool { true }
  fn feed<H>(a: &Nat, h: H, step: &((H, UInt(64)) -> H)): H { h }
  theorem feed_const<a: Nat, H: Type, s: H, step: (H, UInt(64)) -> H>(): Key::feed(a, s, step) = s { Refl }
}
fn fed(a: Nat, h: Nat): Nat { Key::feed(&a, h, &((x: Nat, w: UInt(64)) => x)) }
theorem computes(): Eq(Nat, fed(1, 7), 7) { Refl }
```
checks_all = "ok"

@ cases.method-where-in-an-inductive-class
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive class Mix(H: Type) { fn put(h: H, w: Nat): H }
inductive class Key(K: Type) {
  fn digest<H>(a: &K, h: H): H where Mix(H)
}
instance Mix(Nat) { fn put(h: Nat, w: Nat): Nat { w } }
instance Key(Nat) {
  fn digest<H>(a: &Nat, h: H): H where Mix(H) { Mix::put(h, a) }
}
fn digest_of(a: Nat): Nat { Key::digest(&a, 0) }
theorem computes(): Eq(Nat, digest_of(5), 5) { Refl }
```
checks_all = "ok"

@ cases.theorem-about-a-method-with-where
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive class Mix(H: Type) { fn put(h: H, w: Nat): H }
inductive class Key(K: Type) {
  fn digest<H>(a: &K, h: H): H where Mix(H)
}
instance Mix(Nat) { fn put(h: Nat, w: Nat): Nat { w } }
instance Key(Nat) {
  fn digest<H>(a: &Nat, h: H): H where Mix(H) { Mix::put(h, a) }
}
theorem stays<H: Type>(s: H): Key::digest(3, s) = Key::digest(3, s) where Mix(H) { Refl }
```
checks_all = "ok"

@ cases.instance-must-repeat-the-method-where
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
