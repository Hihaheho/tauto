@ cases.a-calc-chain-is-the-transitivity-it-stands-for
entry = "input/main.taut"
files."input/main.taut" = ````tauto
import std::Calc { calc }
theorem chain(a: Nat, b: Nat, c: Nat, h1: a = b, h2: b = c): a = c {
  calc!(```
    $a
    = $b from $h1
    = $c from $h2
    = $c from $Refl
    ```)
}
````

checks."input/main.taut::chain" = "ok"

@ cases.a-calc-step-whose-proof-does-not-fit-is-rejected
entry = "input/main.taut"
files."input/main.taut" = ````tauto
import std::Calc { calc }
theorem chain(a: Nat, b: Nat, c: Nat, h1: a = b, h2: b = c): a = c {
  calc!(```
    $a
    = $b from $h2
    = $c from $h2
    ```)
}
````

checks."input/main.taut::chain" = "error: type mismatch: expected `a = b`, found `b = c`"

@ cases.a-context-with-a-box-is-a-function
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn ctx(x1: Bool, y: Bool): (Bool) -> Bool { ⟦Bool::and(Bool::or(x1, □), y)⟧ }
theorem cg(x1: Bool, y: Bool, a: Bool, b: Bool, h: a = b): Bool::and(Bool::or(x1, a), y) = Bool::and(Bool::or(x1, b), y) {
  Eq::congr(Bool, Bool, a, b, ⟦Bool::and(Bool::or(x1, □), y)⟧, h)
}
```

checks."input/main.taut::ctx" = "ok"
checks."input/main.taut::cg" = "ok"

