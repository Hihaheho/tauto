@ cases.a-product-and-the-unit-are-written-with-hash
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn swap(p: Nat × Nat): Nat × Nat {
  match p {
    #(a, b) => #(b, a)
  }
}
theorem swap_ok(): swap(#(1, 2)) = #(2, 1) { Refl }
fn unit(): Unit { #() }
```

checks."input/main.taut::swap" = "ok"
checks."input/main.taut::swap_ok" = "ok"
checks."input/main.taut::unit" = "ok"

@ cases.a-pattern-names-an-implicit-argument-it-reads
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  VNil: Vec(A, Zero)
  VCons<n: Nat>(x: A, xs: Vec(A, n)): Vec(A, Succ(n))
}
fn vlen(A: Type, k: Nat, v: Vec(A, k)): Nat {
  ⊢ Nat from match v {
    VNil => Zero
    VCons<n: m>(x, xs) => Succ(m)
  }
}
theorem vlen_two(): vlen(Nat, 2, VCons(1, VCons(2, VNil))) = 2 { Refl }
```

checks."input/main.taut::vlen" = "ok"
checks."input/main.taut::vlen_two" = "ok"

@ cases.a-pattern-names-an-implicit-argument-the-constructor-does-not-have
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  VNil: Vec(A, Zero)
  VCons<n: Nat>(x: A, xs: Vec(A, n)): Vec(A, Succ(n))
}
fn vlen(A: Type, k: Nat, v: Vec(A, k)): Nat {
  ⊢ Nat from match v {
    VNil => Zero
    VCons<len: m>(x, xs) => Succ(m)
  }
}
```

checks."input/main.taut::vlen" = "error: `main::Vec::VCons` has no implicit argument named `len`"
