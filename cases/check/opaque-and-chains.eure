@ cases.an-opaque-fn-is-its-body-its-name-and-its-equation
entry = "input/main.taut"
files."input/main.taut" = ```tauto
opaque fn double(n: Nat): Nat => theorem double::eq {
  match n {
    Zero => Zero
    Succ(k) => Succ(Succ(double(k)))
  }
}
```

checks."input/main.taut::double@body" = "ok"
checks."input/main.taut::double" = "ok"
checks."input/main.taut::double::eq" = "ok"

@ cases.an-opaque-fn-does-not-unfold-by-conversion
entry = "input/main.taut"
files."input/main.taut" = ```tauto
opaque fn double(n: Nat): Nat => theorem double::eq {
  match n {
    Zero => Zero
    Succ(k) => Succ(Succ(double(k)))
  }
}
theorem double_one(): double(1) = 2 { Refl }
```

checks."input/main.taut::double" = "ok"
checks."input/main.taut::double::eq" = "ok"
checks."input/main.taut::double_one" = "error: type mismatch"

@ cases.an-opaque-fn-unfolds-by-a-rewrite-with-its-equation
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::Tactic
opaque fn double(n: Nat): Nat => theorem double::eq {
  match n {
    Zero => Zero
    Succ(k) => Succ(Succ(double(k)))
  }
}
theorem double_one(): double(1) = 2 {
  by rewrite!(double::eq(1)): double(1) = 2 {
    ⊢ Eq(Nat, 2, 2) from Refl
  }
}
```

checks."input/main.taut::double::eq" = "ok"
checks."input/main.taut::double_one" = "ok"

@ cases.a-match-on-text-literals-with-a-named-last-arm-is-checked
imports = [path`../../std/Text.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn kind(s: Text): Nat {
  ⊢ Nat from match s {
    "a" => 1
    "b" => 2
    other => List::length(Text::bytes(other))
  }
}
theorem kind_b(): kind("b") = 2 { Refl }
theorem kind_other(): kind("xyz") = 3 { Refl }
```

checks."input/main.taut::kind" = "ok"
checks."input/main.taut::kind_b" = "ok"
checks."input/main.taut::kind_other" = "ok"

