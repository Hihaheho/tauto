}
```

@ cases.the-tote-named-std-reads-its-builtin-files-as-the-prelude
description = "The tote named std does not read its own copy of `builtin/` as files of its own: they are the prelude every program has, and reading them again would declare the prelude's operations a second time under other identities (a `Mutex` operation in a row would not be the host's)."
files_tote = "lib"
tote_errors = []
files."lib/Tauto.eure" = ```eure
package {
  name = "std"
  prelude = false
}
```
files."lib/builtin/par.taut" = real`../../std/builtin/par.taut`
files."lib/Small.taut" = ```tauto
pub inductive Two: Type {
  One: Two
  Other: Two
}
```

@ cases.another-tote-reads-no-text-of-its-own-as-the-library
description = "A file of the tote named std is a module of the library, with its privileges: another tote that reaches by a path a file whose text is not the one tauto comes with would hand its declarations those privileges, so it is refused."
files_tote = "app"
load_error = "is a file of the tote named `std`, the standard library's source"
files."lib/Tauto.eure" = ```eure
package {
  name = "std"
  prelude = false
}
```
files."lib/Never.taut" = ```tauto
pub inductive Never: Type {
  Mk: Never
}
```
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/main.taut" = ```tauto
import "../../lib/Never.taut"

pub fn f(): Nat { 1 }
```

