@ cases.a-macro-expansion-error-of-the-program-is-reported
description = "An argument of the wrong type in a macro's `$` expression stops the program from loading: `tauto check` of the tote says so, as `tauto check src/main.taut` and `tauto run` do."
files_tote = "app"
tote_errors = ["`embedded#1`: Text does not fit nat"]
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/wrap_macro.taut" = ```tauto
import std::builtin::macro

pub macro fn wrap(e: SynExpr): SynExpr ! {macro_error, div} {
  quote {
    {
      let embedded: Nat := $e
      embedded
    }
  }
}
```
files."app/src/main.taut" = ```tauto
import "wrap_macro.taut"

perform main(() => {
  let bad := wrap!("x")
})
```

@ cases.a-macro-of-another-file-calls-a-mutual-block-with-a-function-not-by-match
description = "A macro of another file calls a `mutual` block whose `count` is not defined by a `match` and calls itself through `one`: the later file checks. The block's functions are functions of the library the macro runs in, and writing out `count` stops at its own call instead of writing it out without end."
files_tote = "app"
tote_errors = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/defs.taut" = ````tauto
import std::builtin::macro { SynExpr }
import std::text { Text }
inductive_syntax!(ab, ```par
%start Word
%%
Word: { Letter };
Letter: A | B;
A: 'a';
B: 'b';
```) =>
  enum Letter, struct Word, fn parse, inductive Letter::I, inductive Word::I,
  fn Letter::to_i, fn Word::to_i, fn Letter_list::to_i

mutual {
  fn count(ls: List(ab::Letter)): SynExpr ! {div} {
    let none := quote { 0 }
    match ls {
      [] => none
      [l, ..rest] => one(l, rest)
    }
  }
  fn one(l: ab::Letter, rest: List(ab::Letter)): SynExpr ! {div} {
    match l {
      A(_) => {
        let r := count(rest)
        quote { 1 + $r }
      }
      B(_) => count(rest)
    }
  }
}

pub macro fn count_a(w: ab::Word): SynExpr ! {div} { count(w.letter) }
````
files."app/src/use.taut" = ```tauto
import "defs.taut" { count_a }
theorem t(): count_a!(`aba`) = 2 { Refl }
```
files."app/.tauto-syntax/a46f41972cba9ee3fc3b4750b73baabbc9620ed0401bbe6bd0e9b88fe1f8cd05.tables" = path`../../crates/tauto/tests/syntax_fixtures/.tauto-syntax/a46f41972cba9ee3fc3b4750b73baabbc9620ed0401bbe6bd0e9b88fe1f8cd05.tables`

@ cases.a-macro-of-another-file-calls-the-length-of-a-text-where-a-nat-is-taken
description = "A macro of another file calls a `mutual` block that gives `Text::len` of std to `Text::slice_or_empty`: the library the macro runs in has the length as the `nat` that extraction writes at a call, as it has what takes it, and the later file checks."
files_tote = "app"
tote_errors = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/defs.taut" = ````tauto
import std::builtin::macro { SynExpr }
import std::text { Text }
inductive_syntax!(ab, ```par
%start Word
%%
Word: { Letter };
Letter: A | B;
A: 'a';
B: 'b';
```) =>
  enum Letter, struct Word, fn parse, inductive Letter::I, inductive Word::I,
  fn Letter::to_i, fn Word::to_i, fn Letter_list::to_i

mutual {
  fn count(ls: List(ab::Letter)): SynExpr ! {div} {
    let none := quote { 0 }
    match ls {
      [] => none
      [l, ..rest] => one(l, rest)
    }
  }
  fn one(l: ab::Letter, rest: List(ab::Letter)): SynExpr ! {div} {
    match l {
      A(_) => {
        let r := count(rest)
        quote { 1 + $r }
      }
      B(_) => {
        let tail := Text::slice_or_empty("xyz", 1, Text::len("xyz"))
        match tail == "yz" {
          true => count(rest)
          false => quote { 0 }
        }
      }
    }
  }
}

pub macro fn count_a(w: ab::Word): SynExpr ! {div} { count(w.letter) }
````
files."app/src/use.taut" = ```tauto
import "defs.taut" { count_a }
theorem t(): count_a!(`aba`) = 2 { Refl }
```
files."app/.tauto-syntax/a46f41972cba9ee3fc3b4750b73baabbc9620ed0401bbe6bd0e9b88fe1f8cd05.tables" = path`../../crates/tauto/tests/syntax_fixtures/.tauto-syntax/a46f41972cba9ee3fc3b4750b73baabbc9620ed0401bbe6bd0e9b88fe1f8cd05.tables`

@ cases.a-macro-of-another-file-joins-texts-with-text-concat
description = "A macro of another file calls `Text::concat` of std: its source writes the constructor of `Text`, which the library the macro runs in does not have, so the library has it as the builtin that extraction writes at a call, and the later file checks."
files_tote = "app"
tote_errors = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/defs.taut" = ```tauto
import std::builtin::macro { SynExpr }
import std::text { Text }

pub macro fn greet(e: SynExpr): SynExpr {
  let t := Text::concat("a", Text::concat("b", "c"))
  match t == "abc" {
    true => quote { 1 }
    false => quote { 0 }
  }
}
```
files."app/src/use.taut" = ```tauto
import "defs.taut" { greet }
theorem t(): Eq(Nat, greet!(1), 1) { Refl }
```

@ cases.a-rule-of-a-syntax-named-as-a-declaration-of-a-file-not-imported
description = "A rule named `Proved` makes the constructor `Stmt::Proved`, and `std::builtin::macro` declares a `Proved` the file does not import: a pattern on a `g::Stmt` reads `Proved` as the matched type's constructor, as it does for an enum written by hand, and a later file uses the macro."
files_tote = "app"
tote_errors = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/a.taut" = ````tauto
import std::builtin::macro { SynExpr }
import std::syn_tree

inductive_syntax!(g, ```par
%start Stmt
%%
Stmt: Proved | Other;
Proved: PTok Other;
Other: 'o';
PTok: 'p';
```) => enum Stmt, struct Proved, fn parse, inductive Stmt::I, inductive Proved::I, fn Stmt::to_i, fn Proved::to_i

pub macro fn f(s: g::Stmt): SynExpr {
  match s {
    Proved(p) => {
      let b := quote { 0 }
      quote { Some($b) }
    }
    Other(_) => quote { None }
  }
}
````
files."app/src/b.taut" = ```tauto
import "a.taut" { f }

fn t(): Option(Nat) { f!(`po`) }
```
files."app/.tauto-syntax/7fde99fa5796565882999e2f84170dad5b511b1025a154b0cce79f92446c3777.tables" = path`../../crates/tauto/tests/syntax_fixtures/.tauto-syntax/7fde99fa5796565882999e2f84170dad5b511b1025a154b0cce79f92446c3777.tables`

@ cases.a-name-the-prelude-and-an-imported-library-module-declare-is-ambiguous-when-the-prelude-file-is-imported
description = "std::prelude::Collections is part of the prelude, which a file sees without an import; a file that imports it as well sees Array from two files it imports, std::array and Collections, on equal terms, and neither wins."
files_tote = "app"
tote_errors = ["`Array` is ambiguous: it is declared as `std::array::Array` and `std::prelude::Array`, and this file imports both"]
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/main.taut" = ```tauto
import std::array
import std::prelude::collections

pub fn zero(a: Array(Nat)): Nat { 0 }
```

