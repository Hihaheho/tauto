@ cases.a-comparison-written-on-an-arm-goal-is-compiled-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
theorem arm_goal(b: Nat, r: Nat): Nat::eq(Succ(r), b) == false = Nat::eq(Succ(r), b) == false {
  ⊢ Nat::eq(Succ(r), b) == false = Nat::eq(Succ(r), b) == false from match Succ(r) == b {
    false => ⊢ false == false = false == false from Refl
    true => ⊢ true == false = true == false from Refl
  }
}
```

