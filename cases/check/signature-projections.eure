@ cases.a-field-projection-in-a-theorem-type-is-the-match-a-body-gets
files."base.taut" = path`../../std/base.taut`
files."std.taut" = path`../../std/std.taut`
files."data.taut" = path`../../std/data.taut`
files."main.nib" = ```tauto
import "data.taut"
theorem first<A: Type>(p: A × A): p.fst = Product::fst(p) { Refl(<A: A, a: Product::fst(p)>) }
theorem assumed<A: Type>(p: A × A, h: p.fst = p.snd): Product::fst(p) = p.snd { h }
theorem under_forall<A: Type>(p: A × A): ∀ q: (A × A). ∀ h: (p.fst = q.fst). Product::fst(p) = q.fst {
  (q, h) => h
}
theorem matched<A: Type>(p: A × A): (⊢ A from match p { #(x, y) => x }) = p.fst {
  Refl(<A: A, a: Product::fst(p)>)
}
theorem wrong<A: Type>(p: A × A): p.fst = p.snd { Refl(<A: A, a: p.fst>) }
theorem missing<A: Type>(p: A × A): p.nope = p.snd { Refl(<A: A, a: p.snd>) }
```
checks.first = "ok"
checks.assumed = "ok"
checks.under_forall = "ok"
checks.matched = "ok"
checks.wrong = "error: type mismatch"
checks.missing = "error: `Pair` has no field `nope`"

@ cases.implicit-type-arguments-are-found-through-a-local-function-and-none
files."base.taut" = path`../../std/base.taut`
files."std.taut" = path`../../std/std.taut`
files."data.taut" = path`../../std/data.taut`
files."main.nib" = ```tauto
import "data.taut"
inductive Box(A: Type): Type {
  Mk(a: A): Box(A)
}
theorem same<A: Type>(s: Box(A), q: Option(A) × Box(A)): q = q {
  Refl(<A: (Option(A) × Box(A)), a: q>)
}
theorem through_local<A: Type>(
  s: Box(A),
  next: (Box(A)) -> (Option(A) × Box(A))
): next(s) = next(s) {
  same(s, next(s))
}
theorem through_none<A: Type>(s: Box(A)): Eq(Option(A) × Box(A), #(None, s), #(None, s)) {
  same(s, #(None, s))
}
theorem none_alone<A: Type>(a: A): Option::or(None, Some(a)) = Some(a) { Refl(<A: Option(A), a: Some(a)>) }
```
checks.through_local = "ok"
checks.through_none = "ok"
checks.none_alone = "ok"

@ cases.a-field-projection-under-a-lambda-in-a-theorem-type
files."base.taut" = path`../../std/base.taut`
files."std.taut" = path`../../std/std.taut`
files."data.taut" = path`../../std/data.taut`
files."main.nib" = ```tauto
import "data.taut"
theorem lam<A: Type>(p: A × A): ((e: A × A) => e.snd)(p) = Product::snd(p) { Refl(<A: A, a: Product::snd(p)>) }
theorem arrow<A: Type>(p: A × A): (p.fst = p.snd) -> (⊢ A from match p { #(x, y) => x }) = p.fst {
  (h) => Refl(<A: A, a: Product::fst(p)>)
}
theorem keep<A: Type>(m: (A × A) -> Type, p: A × A, h: m(p)): m(p) { h }
theorem motive<A: Type>(p: A × A, h: (p.fst = p.snd) -> (Product::fst(p) = p.snd)): (p.fst = p.snd) -> (Product::fst(p) = p.snd) {
  keep(A, (c: A × A) => (c.fst = c.snd) -> (⊢ A from match c { #(x, y) => x }) = c.snd, p, h)
}
```
checks.lam = "ok"
checks.motive = "ok"
checks.arrow = "ok"

@ cases.a-field-projection-under-an-exists-in-a-theorem-type
entry = "main.taut"
files."base.taut" = path`../../std/base.taut`
files."std.taut" = path`../../std/std.taut`
files."data.taut" = path`../../std/data.taut`
files."Url.taut" = ```tauto
import "data.taut"
pub(open) inductive struct Url {
  query: Nat
  path: Nat
}
```
files."main.taut" = ```tauto
import "Url.taut"
theorem witness(t: Url): ∃ n: Nat. n = t.query { ExIntro(Nat, (n: Nat) => n = t.query, t.query, Refl(Nat, t.query)) }
theorem bound<A: Type>(p: A × A): ∃ q: (A × A). q.fst = p.fst {
  ExIntro(A × A, (q: A × A) => q.fst = p.fst, p, Refl(<A: A, a: p.fst>))
}
theorem wrong(t: Url): ∃ n: Nat. n = t.query { ExIntro(Nat, (n: Nat) => n = t.query, t.path, Refl(Nat, t.path)) }
```
checks.witness = "ok"
checks.bound = "ok"
checks.wrong = "error: type mismatch"
