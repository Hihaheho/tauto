@ cases.a-use-of-a-failed-mutual-theorem-says-so-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
def P<A: Type>(a: A, n: Nat): Prop := n = n

mutual {
  theorem ev(n: Nat): P(n, n) {
    ⊢ P(n, n) from match n {
      Zero => Refl
      Succ(k) => od(Zero)
    }
  }
  theorem od(n: Nat): P(n, Succ(n)) {
    ⊢ P(n, Succ(n)) from match n {
      Zero => Refl
      Succ(k) => ev(k)
    }
  }
}

theorem use_ev(n: Nat): P(n, n) { ev(n) }
```

checks_all = "ok"
checks."input/main.taut::P" = "ok"
checks."input/main.taut::ev" = "error: "
checks."input/main.taut::od" = "error: "
checks."input/main.taut::use_ev" = "error: "
@ cases.a-use-of-a-failed-mutual-theorem-says-so-0.diagnostics[]
file = "input/main.taut"
name = "ev"
message = "`od(Zero)` is not structural: `od` matches on its parameter `n`, so the argument for `n` is a part of the value matched here (a field, a field of a field matched in the arm, a function-typed field applied to all its arguments, or a part matched in the arm written as the arm's constructor), and `Zero` is not. Pass a variable bound by a pattern of the `match` on `n` (a field of the value) for `n`"
span = "«od(Zero)»"
@ cases.a-use-of-a-failed-mutual-theorem-says-so-0.diagnostics[]
file = "input/main.taut"
name = "od"
message = "`od(Zero)` is not structural: `od` matches on its parameter `n`, so the argument for `n` is a part of the value matched here (a field, a field of a field matched in the arm, a function-typed field applied to all its arguments, or a part matched in the arm written as the arm's constructor), and `Zero` is not. Pass a variable bound by a pattern of the `match` on `n` (a field of the value) for `n`"
span = "«od(Zero)»"
@ cases.a-use-of-a-failed-mutual-theorem-says-so-0.diagnostics[]
file = "input/main.taut"
