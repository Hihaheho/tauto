@ cases.a-proof-states-facts-about-a-program-enum-and-struct-0
description = "an `inductive enum` and an `inductive struct` are inductive families of the same shape, so the functions over them are checked and a proof can use them"
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::Text

inductive enum Route {
  Home
  About
  Post(Nat)
}

inductive struct Link {
  to: Route
  label: Text
}

fn segments(r: Route): List(Text) {
  match r {
    Home => Nil
    About => Cons("about", Nil)
    Post(id) => Cons("posts", Cons(Text::of_nat(id), Nil))
  }
}

fn route(segs: List(Text)): Option(Route) {
  match segs {
    Nil => Some(Home)
    Cons(a, rest) => match rest {
      Nil => if a == "about" { Some(About) } else { None }
      Cons(b, more) => None
    }
  }
}

fn target(l: Link): List(Text) { segments(l.to) }

theorem about_back(): route(segments(About)) = Some(About) { Refl }

theorem link_home(): target(Link { to: Home, label: "home" }) = Nil { Refl }
```

checks_all = "ok"
checks."input/main.taut::segments" = "ok"
checks."input/main.taut::route" = "ok"
checks."input/main.taut::target" = "ok"
checks."input/main.taut::about_back" = "ok"
checks."input/main.taut::link_home" = "ok"

