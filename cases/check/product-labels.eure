@ cases.a-labelled-type-is-a-subtype-of-what-it-labels
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn unlabel(x: @w Nat): Nat { (x: Nat) }

fn label(n: Nat): @w Nat { (n: @w Nat) }

fn member(p: @w Nat × Bool): Nat { (p: Nat) }

fn clash(p: @w Nat × @h Nat): Nat { (p: Nat) }

theorem round(n: Nat): Eq(Nat, ((n: @w Nat): Nat), n) { Refl(Nat, n) }
```

