checks."input/main.taut::label" = "ok"
checks."input/main.taut::member" = "ok"
checks."input/main.taut::clash" = "error: "
checks."input/main.taut::round" = "ok"

@ cases.a-labelled-value-and-pattern
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::Text

fn attribute(): @name Text × @value Text { #(@name "style", @value "display:contents") }

fn value_of(a: @name Text × @value Text): Text {
  ⊢ Text from match a {
    #(@name n, @value v) => v
  }
}

fn wrapped(n: Nat): @w Nat { @w n }

theorem read_back(): Eq(Text, value_of(attribute()), "display:contents") { Refl(Text, "display:contents") }
```

checks_all = "ok"
checks."input/main.taut::attribute" = "ok"
checks."input/main.taut::value_of" = "ok"
checks."input/main.taut::wrapped" = "ok"
checks."input/main.taut::read_back" = "ok"

@ cases.a-tuple-pattern-takes-its-members-by-position-and-label
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::Data

fn cur(pr: @b Nat × @a Bool): Nat {
  ⊢ Nat from match pr {
    #(@b c, @a r) => c
  }
}

fn rest(pr: @b Nat × @a Bool × Nat): Bool {
  ⊢ Bool from match pr {
    #(@b c, @a r, n) => r
  }
}

theorem read_back(): Eq(Nat, cur(#(@b 7, @a true)), 7) { Refl(Nat, 7) }
```

checks_all = "ok"
checks."input/main.taut::cur" = "ok"
checks."input/main.taut::rest" = "ok"
checks."input/main.taut::read_back" = "ok"

