@ cases.a-labelled-pattern-rebuilds-the-product
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::Data

fn step(pr: @cur Nat × @rest Bool): @cur Nat × @rest Bool {
  ⊢ @cur Nat × @rest Bool from match pr {
    #(@cur cur, @rest rest) => #(@cur cur, @rest rest)
  }
}

fn swap_names(pr: @cur Nat × @rest Bool): @cur Nat × @rest Bool {
  ⊢ @cur Nat × @rest Bool from match pr {
    #(@cur rest, @rest cur) => #(@cur rest, @rest cur)
  }
}
```

checks_all = "ok"
checks."input/main.taut::step" = "ok"
checks."input/main.taut::swap_names" = "ok"
