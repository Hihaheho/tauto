// Sugar for programs in the proof language: generics on
// a function, a `match` inside a term, and a `match` on a term. Each is
// elaborated into the terms the kernel already takes (implicit arguments,
// eliminator applications), and the kernel checks the result.

@ cases.a-function-takes-generics-as-implicit-arguments
parses = true
source = ```tauto
inductive Seq(A: Type): Type {
  Nil: Seq(A)
  Cons(h: A, t: Seq(A)): Seq(A)
}
fn len<A>(l: Seq(A)): Nat {
  ⊢ Nat from match l {
    Nil => Zero
    Cons(h, t) => Succ(len(t))
  }
}
theorem two(): len(Cons(1, Cons(2, Nil))) = 2 { Refl }
```
checks.len = "ok"
checks.two = "ok"

@ cases.a-function-that-returns-a-function-takes-generics-as-implicit-arguments
parses = true
source = ```tauto
fn comp2<A, B, C>(f: (A) -> B, g: (B) -> C): (A) -> C {
  (x: A) => g(f(x))
}
theorem same<A: Type, B: Type, C: Type>(f: (A) -> B, g: (B) -> C, a: A): comp2(f, g)(a) = g(f(a)) {
  Refl
}
theorem written<A: Type, B: Type, C: Type>(f: (A) -> B, g: (B) -> C, a: A): comp2(A, B, C, f, g)(a) = g(f(a)) {
  Refl
}
```
checks.comp2 = "ok"
checks.same = "ok"
checks.written = "ok"

@ cases.a-call-in-a-motive-takes-generics-as-implicit-arguments
parses = true
source = ```tauto
inductive Opt(A: Type): Type {
  None: Opt(A)
  Some(a: A): Opt(A)
}
inductive Out(R: Type, E: Type): Type {
  Ok(r: R): Out(R, E)
  Err(e: E): Out(R, E)
}
inductive P2(A: Type, B: Type): Type {
  Mk(fst: A, snd: B): P2(A, B)
}
fn step<S, R, E>(s: S, o: Opt(E), r: R): P2(Out(R, E), S) {
  ⊢ P2(Out(R, E), S) from match o {
    None => Mk(Ok(r), s)
    Some(e) => Mk(Err(e), s)
  }
}
theorem t<S: Type, R: Type, E: Type>(s: S, r: R, e: E, o: Opt(E), p: Some(e) = o): step(s, o, r) = Mk(Err(e), s) {
  Eq::subst((q: Opt(E)) => step(s, q, r) = Mk(Err(e), s), p, Refl)
}
```
checks.step = "ok"
checks.t = "ok"

@ cases.a-function-that-uses-a-skipped-one-is-skipped
parses = true
source = ```tauto
fn inner(x: Nat): Result(Nat, String) { Ok(x) }
fn outer(x: Nat): Nat {
  match inner(x) {
    Ok(_) => Zero
    Err(_) => Succ(Zero)
  }
}
fn top(x: Nat): Nat { outer(x) }
```
checks.inner = "skipped"
checks.outer = "skipped"
checks.top = "skipped"

@ cases.a-match-on-a-term-is-a-case-analysis
parses = true
source = ```tauto
fn lt(a: Nat, b: Nat): Bool {
  ⊢ Bool from match a {
    Zero => ⊢ Bool from match b {
      Zero => false
      Succ(b2) => true
    }
    Succ(a2) => ⊢ Bool from match b {
      Zero => false
      Succ(b2) => lt(a2, b2)
    }
  }
}
fn max(a: Nat, b: Nat): Nat {
  ⊢ Nat from match lt(a, b) {
    false => a
    true => b
  }
}
fn capped(n: Nat): Nat {
  Succ(⊢ Nat from match lt(n, 3) {
    false => 3
    true => n
  })
}
theorem max_3_5(): max(3, 5) = 5 { Refl }
theorem capped_7(): capped(7) = 4 { Refl }
```
checks.max = "ok"
checks.capped = "ok"
checks.max_3_5 = "ok"
checks.capped_7 = "ok"

@ cases.recursion-may-pass-through-a-match-on-a-term
parses = true
source = ```tauto
fn even(n: Nat): Bool {
  ⊢ Bool from match n {
    Zero => true
    Succ(k) => ⊢ Bool from match even(k) {
      false => true
      true => false
    }
  }
}
fn evens(n: Nat): Nat {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(k) => ⊢ Nat from match even(k) {
      false => evens(k)
      true => Succ(evens(k))
    }
  }
}
theorem evens_10(): evens(10) = 5 { Refl }
```
checks.even = "ok"
checks.evens = "ok"
checks.evens_10 = "ok"

@ cases.a-match-on-a-term-does-not-recurse-on-its-fields
