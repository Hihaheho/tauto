checks.down = "error: calls itself"

@ cases.records-and-operators-are-sugar
parses = true
source = ```tauto
fn nat_add(a: Nat, b: Nat): Nat {
  ⊢ Nat from match b {
    Zero => a
    Succ(c) => Succ(nat_add(a, c))
  }
}
fn nat_lt_in(b: Nat, a: Nat): Bool {
  ⊢ Bool from match b {
    Zero => false
    Succ(c) => ⊢ Bool from match a {
      Zero => true
      Succ(d) => nat_lt_in(c, d)
    }
  }
}
inductive Point: Type {
  Mk(x: Nat, y: Nat): Point
}
fn sum(p: Point): Nat {
  ⊢ Nat from match p {
    Point { x, y } => x + y
  }
}
theorem three(): sum(Point { y: 2, x: 1 }) = 3 { Refl }
theorem bigger(): (3 > 2) = true { Refl }
```
checks.nat_add = "ok"
checks.nat_lt_in = "ok"
checks.Point = "ok"
checks.sum = "ok"
checks.three = "ok"
checks.bigger = "ok"

@ cases.fields-equality-and-lets-are-sugar
parses = true
source = ```tauto
inductive Point: Type {
  Mk(x: Nat, y: Nat): Point
}
fn diagonal(p: Point): Bool {
  let a := p.x
  a == p.y
}
fn swapped(p: Point): Point {
  let q := p
  Point::Mk(q.y, q.x)
}
theorem on(): diagonal(Point::Mk(2, 2)) = true { Refl }
theorem off(): diagonal(Point::Mk(2, 3)) = false { Refl }
theorem swap(): swapped(Point::Mk(1, 2)) = Point::Mk(2, 1) { Refl }
```
checks.Point = "ok"
checks.diagonal = "ok"
checks.swapped = "ok"
checks.on = "ok"
checks.off = "ok"
checks.swap = "ok"

@ cases.a-mut-parameter-comes-back-with-the-value
parses = true
source = ```tauto
inductive Counter: Type {
  Mk(n: Nat, hits: Nat): Counter
}
fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}
fn bump(&mut c: Counter): Nat {
  set_to(&mut c.n, Succ(c.n))
  set_to(&mut c.hits, Succ(c.hits))
  c.n
}
fn maybe(&mut c: Counter, go: Bool): Nat {
  var seen: Nat := Zero
  if go {
    seen := bump(&mut c)
  }
  seen
}
theorem once(): maybe(Counter::Mk(Zero, Zero), true) = mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Zero))) {
  Refl(Mut1(Nat, Counter), mut1(Succ(Zero), Counter::Mk(Succ(Zero), Succ(Zero))))
}
theorem never(): maybe(Counter::Mk(Zero, Zero), false) = mut1(Zero, Counter::Mk(Zero, Zero)) {
  Refl(Mut1(Nat, Counter), mut1(Zero, Counter::Mk(Zero, Zero)))
}
```
checks.set_to = "ok"
checks.bump = "ok"
checks.maybe = "ok"
checks.once = "ok"
checks.never = "ok"

@ cases.mut-functions-can-share-a-step-count
parses = true
source = ```tauto
fn set_to<A>(&mut slot: A, v: A): Unit {
  slot := v
}
mutual {
  // Counts down `n` into `seen`, a step at a time; out of steps, `seen` is
  // what it was.
  fn down(k: Nat, &mut seen: Nat, n: Nat): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match n {
        Zero => true
        Succ(m) => {
          set_to(&mut seen, Succ(seen))
          again(j, &mut seen, m)
        }
      }
    }
  }
  fn again(k: Nat, &mut seen: Nat, n: Nat): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => down(j, &mut seen, n)
    }
  }
}
theorem done(): down(10, Zero, 2) = mut1(true, 2) { Refl(Mut1(Bool, Nat), mut1(true, 2)) }
theorem short(): down(2, Zero, 5) = mut1(false, 1) { Refl(Mut1(Bool, Nat), mut1(false, 1)) }
```
checks.down = "ok"
checks.again = "ok"
checks.done = "ok"
checks.short = "ok"

@ cases.a-handler-arm-may-change-an-outer-var
parses = true
source = ```tauto
affine struct Platform {}
extern {
  fn platform_new(): Platform
  fn platform_bump(&mut p: Platform, n: i64): Unit
  fn platform_get(&p: Platform): i64
}
effect tick(n: i64): Unit direct
effect peek(): i64 direct
fn app(): i64 ! {tick, peek} {
  perform tick(1)
  perform tick(2)
  perform peek()
}
// The arms resume through `k`, so the state cannot be passed along by name:
// the function stays executable code.
fn run(): i64 {
  var p := platform_new()
  handle { app() } with {
    tick(n), k => { platform_bump(&mut p, n); k(#()) }
    peek(), k => k(platform_get(&p))
  }
}
```
checks.run = "skipped"
