fn pred(n: Nat): Nat {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(k) => k
  }
}
fn down(n: Nat): Nat {
  ⊢ Nat from match pred(n) {
    Zero => Zero
    Succ(k) => down(k)
  }
}
```
