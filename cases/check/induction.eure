@ cases.mutual-tree-and-forest-sizes
parses = true
source = ```tauto
fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}
mutual {
  inductive Tree: Type {
    Node(x: Nat, f: Forest): Tree
  }
  inductive Forest: Type {
    Nil: Forest
    Cons(t: Tree, rest: Forest): Forest
  }
}
mutual {
  fn tree_size(t: Tree): Nat {
    ⊢ Nat from match t {
      Node(x, f) => Succ(forest_size(f))
    }
  }
  fn forest_size(f: Forest): Nat {
    ⊢ Nat from match f {
      Nil => Zero
      Cons(t, rest) => plus(tree_size(t), forest_size(rest))
    }
  }
}
```
checks.tree_size = "ok"
checks.forest_size = "ok"

@ cases.mutual-call-passes-a-changed-earlier-parameter
parses = true
source = ```tauto
fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}
inductive L(A: Type): Type {
  Nil: L(A)
  Cons(head: A, tail: L(A)): L(A)
}
inductive T: Type {
  Leaf(n: Nat): T
  Node(ts: L(T)): T
}
mutual {
  fn step(acc: Nat, t: T): Nat {
    ⊢ Nat from match t {
      Leaf(n) => plus(acc, n)
      Node(ts) => steps(acc, ts)
    }
  }
  fn steps(acc: Nat, ts: L(T)): Nat {
    ⊢ Nat from match ts {
      Nil => acc
      Cons(t, rest) => steps(step(acc, t), rest)
    }
  }
}
theorem sum(): steps(0, Cons(Leaf(1), Cons(Leaf(2), Nil))) = 3 { Refl }
theorem stale(): steps(0, Cons(Leaf(1), Cons(Leaf(2), Nil))) = 2 { Refl }
```
checks.plus = "ok"
checks.step = "ok"
checks.steps = "ok"
checks.sum = "ok"
checks.stale = "error: type mismatch"

