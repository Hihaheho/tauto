@ cases.a-recursion-on-a-deeper-part-of-a-family-with-a-function-typed-field
parses = true
source = ```tauto
inductive W: Type {
  Wleaf: W
  Wnode(k: (Nat) -> W, t: W): W
}
fn f(w: W): Nat {
  ⊢ Nat from match w {
    Wleaf => Zero
    Wnode(k, t) => ⊢ Nat from match t {
      Wleaf => Succ(f(k(Zero)))
      Wnode(k2, t2) => Succ(f(t2))
    }
  }
}
theorem f_ok(): f(Wnode(n => Wleaf, Wnode(n => Wleaf, Wnode(n => Wnode(m => Wleaf, Wleaf), Wleaf)))) = 3 { Refl }
```
checks.f = "ok"
checks.f_ok = "ok"

@ cases.functions-of-a-block-that-match-on-the-same-family
parses = true
source = ```tauto
mutual {
  fn evens(n: Nat): Nat {
    ⊢ Nat from match n {
      Zero => Succ(Zero)
      Succ(k) => odds(k)
    }
  }
  fn odds(n: Nat): Nat {
    ⊢ Nat from match n {
      Zero => Zero
      Succ(k) => evens(k)
    }
  }
}
theorem evens_4(): evens(4) = 1 { Refl }
theorem odds_4(): odds(4) = 0 { Refl }
inductive Even: (Nat) -> Prop {
  EvZero: Even(Zero)
  EvSs(n: Nat, h: Even(n)): Even(Succ(Succ(n)))
}
mutual {
  theorem ev(n: Nat): Or(Even(n), Even(Succ(n))) {
    ⊢ Or(Even(n), Even(Succ(n))) from match n {
      Zero => OrInl(EvZero)
      Succ(k) => ⊢ Or(Even(Succ(k)), Even(Succ(Succ(k)))) from match od(k) {
        OrInl(a) => OrInl(a)
        OrInr(b) => OrInr(EvSs(k, b))
      }
    }
  }
  theorem od(n: Nat): Or(Even(Succ(n)), Even(n)) {
    ⊢ Or(Even(Succ(n)), Even(n)) from match n {
      Zero => OrInr(EvZero)
      Succ(k) => ⊢ Or(Even(Succ(Succ(k))), Even(Succ(k))) from match ev(k) {
        OrInl(a) => OrInl(EvSs(k, a))
        OrInr(b) => OrInr(b)
      }
    }
  }
}
```
checks.evens = "ok"
checks.odds = "ok"
checks.evens_4 = "ok"
checks.odds_4 = "ok"
checks.ev = "ok"
checks.od = "ok"

@ cases.a-hypothesis-taken-by-a-lambda-in-a-nested-match-still-recurses
parses = true
source = ```tauto
inductive Le: (Nat, Nat) -> Prop {
  LeZero(m: Nat): Le(Zero, m)
  LeSs(n: Nat, m: Nat, h: Le(n, m)): Le(Succ(n), Succ(m))
}
theorem le_pred<d: Nat, n: Nat>(h: Le(Succ(d), Succ(n))): Le(d, n) {
  match h {
    LeSs(a, b, k) => k
  }
}
fn walk(n: Nat, m: Nat, h: Le(n, m)): Nat {
  (⊢ (Le(n, m)) -> Nat from match n {
    Zero => k => m
    Succ(a) => k => (⊢ (Le(Succ(a), m)) -> Nat from match m {
      Zero => k2 => Zero
      Succ(b) => k2 => walk(a, b, le_pred(k2))
    })(k)
  })(h)
}
```
checks.walk = "ok"

@ cases.a-helper-with-the-same-match-unfolds-to-the-same-term
parses = true
source = ```tauto
fn km(x: Nat): Bool {
  ⊢ Bool from match x {
    Zero => true
    Succ(p) => false
  }
}
fn find_step(o: Bool, y: Nat, later: Option(Nat)): Option(Nat) {
  ⊢ Option(Nat) from match o {
    true => Some(y)
    false => later
  }
}
fn find(vs: List(Nat)): Option(Nat) {
  ⊢ Option(Nat) from match vs {
    Nil => None
    Cons(x, rest) => ⊢ Option(Nat) from match km(x) {
      true => Some(x)
      false => find(rest)
    }
  }
}
theorem find_cons(x: Nat, rest: List(Nat)): find(Cons(x, rest)) = find_step(km(x), x, find(rest)) {
  Refl
}
```
checks.find_cons = "ok"

@ cases.a-helper-unfolds-the-same-over-a-list-of-a-mutual-type
parses = true
source = ```tauto
mutual {
  inductive Elem: Type {
    ElText(n: Nat): Elem
    ElSel(vs: List(Variant)): Elem
  }
  inductive Variant: Type {
    Mk(k: Nat, e: Elem): Variant
  }
}
fn km(x: Variant): Bool {
  ⊢ Bool from match x {
    Mk(k, e) => true
  }
}
fn find_step(o: Bool, y: Variant, later: Option(Variant)): Option(Variant) {
  ⊢ Option(Variant) from match o {
    true => Some(y)
    false => later
  }
}
fn find(vs: List(Variant)): Option(Variant) {
  ⊢ Option(Variant) from match vs {
    Nil => None
    Cons(x, rest) => ⊢ Option(Variant) from match km(x) {
      true => Some(x)
      false => find(rest)
    }
  }
}
theorem find_cons(x: Variant, rest: List(Variant)): find(Cons(x, rest)) = find_step(km(x), x, find(rest)) {
  Refl
}
```
checks.find_cons = "ok"

@ cases.a-recursive-call-may-change-a-later-parameter
parses = true
source = ```tauto
fn rev_onto(xs: List(Nat), acc: List(Nat)): List(Nat) {
  ⊢ List(Nat) from match xs {
    Nil => acc
    Cons(x, rest) => rev_onto(rest, Cons(x, acc))
  }
}
theorem rev_three(): rev_onto(Cons(1, Cons(2, Nil)), Nil) = Cons(2, Cons(1, Nil)) { Refl }
```
checks.rev_onto = "ok"
checks.rev_three = "ok"
