  Arr(a: Ty, b: Ty): Ty
}
theorem arr_inj(a: Ty, b: Ty, c: Ty, d: Ty, e: Arr(a, b) = Arr(c, d)): a = c {
  Ty::noconf(a = c, Arr(a, b), Arr(c, d), e, p => q => p)
}
theorem base_not_arr(a: Ty, b: Ty, e: Base = Arr(a, b)): False {
