    Succ(k) => Succ(plus(k, m))
  }
}
inductive Tree: Type {
  Node(x: Nat, cs: Seq(Tree)): Tree
}
fn leaf(x: Nat): Tree { Node(x, Nil) }
mutual {
  fn size(t: Tree): Nat {
    ⊢ Nat from match t {
      Node(x, cs) => Succ(sizes(cs))
    }
  }
  fn sizes(l: Seq(Tree)): Nat {
    ⊢ Nat from match l {
      Nil => Zero
      Cons(h, rest) => plus(size(h), sizes(rest))
    }
  }
}
theorem t(): size(Node(7, Cons(leaf(1), Cons(leaf(2), Nil)))) = 3 { Refl }
```
