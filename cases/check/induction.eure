@ cases.decreasing-by-names-the-parameter-of-a-structural-recursion
parses = true
source = ```tauto
inductive Le: (Nat, Nat) -> Prop {
  LeZero(m: Nat): Le(Zero, m)
  LeSs(n: Nat, m: Nat, h: Le(n, m)): Le(Succ(n), Succ(m))
}
inductive Tree: Type {
  Leaf: Tree
  Node(l: Tree, r: Tree): Tree
}
theorem le_pred<d: Nat, n: Nat>(h: Le(Succ(d), Succ(n))): Le(d, n) {
  match h {
    LeSs(a, b, k) => k
  }
}
fn add(a: Nat, b: Nat): Nat {
  ⊢ Nat from match a {
    Zero => b
    Succ(k) => Succ(add(k, b))
  }
}
fn size(fuel: Nat, t: Tree): Nat decreasing_by fuel {
  ⊢ Nat from match t {
    Leaf => Succ(Zero)
    Node(l, r) => ⊢ Nat from match fuel {
      Zero => Zero
      Succ(f) => add(size(f, l), size(f, r))
    }
  }
}
theorem size_ok(): size(5, Node(Leaf, Node(Leaf, Leaf))) = 3 { Refl }
theorem le_trans(a: Nat, b: Nat, c: Nat, h1: Le(a, b), h2: Le(b, c)): Le(a, c) decreasing_by a {
  (⊢ (Le(a, b)) -> (Le(b, c)) -> Le(a, c) from match b {
    Zero => k1 => k2 => (⊢ (Le(a, Zero)) -> Le(a, c) from match a {
      Zero => _k => LeZero(c)
      Succ(a2) => k => ⊢ Le(Succ(a2), c) from match k {
      }
    })(k1)
    Succ(b2) => k1 => k2 => (⊢ (Le(Succ(b2), c)) -> Le(a, c) from match c {
      Zero => k => ⊢ Le(a, Zero) from match k {
      }
      Succ(c2) => k => (⊢ (Le(a, Succ(b2))) -> Le(a, Succ(c2)) from match a {
        Zero => _k => LeZero(Succ(c2))
        Succ(a2) => j => LeSs(a2, c2, le_trans(a2, b2, c2, le_pred(j), le_pred(k)))
      })(k1)
    })(k2)
  })(h1)(h2)
}
```
