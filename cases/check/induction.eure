@ cases.match-unifies-the-index-of-a-family
parses = true
source = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  Vnil: Vec(A, Zero)
  Vcons(n: Nat, h: A, t: Vec(A, n)): Vec(A, Succ(n))
}
fn head(A: Type, n: Nat, v: Vec(A, Succ(n))): A {
  ⊢ A from match v {
    Vcons(k, h, t) => h
  }
}
fn second(A: Type, n: Nat, v: Vec(A, Succ(Succ(n)))): A {
  ⊢ A from match v {
    Vcons(k, h, t) => ⊢ A from match t {
      Vcons(j, h2, t2) => h2
    }
  }
}
theorem only(A: Type, v: Vec(A, 0)): v = Vnil(A) {
  ⊢ v = Vnil(A) from match v {
    Vnil => Refl(Vec(A, 0), Vnil(A))
  }
}
theorem snd(): second(Nat, 0, Vcons(Nat, 1, 4, Vcons(Nat, 0, 9, Vnil(Nat)))) = 9 { Refl(Nat, 9) }
```
checks.head = "ok"
checks.second = "ok"
checks.only = "ok"
checks.snd = "ok"

