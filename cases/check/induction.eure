@ cases.constructors-are-injective-and-disjoint
parses = true
source = ```tauto
inductive Ty(): Type {
  base(): Ty
  arr(a: Ty, b: Ty): Ty
}
theorem arr_inj(a: Ty, b: Ty, c: Ty, d: Ty, e: Eq(Ty, arr(a, b), arr(c, d))): Eq(Ty, a, c) {
  Ty_noconf(Eq(Ty, a, c), arr(a, b), arr(c, d), e, p => q => p)
}
theorem base_not_arr(a: Ty, b: Ty, e: Eq(Ty, base, arr(a, b))): False {
  Ty_noconf(False, base, arr(a, b), e)
}
```
checks.arr_inj = "ok"
checks.base_not_arr = "ok"

@ cases.a-nested-inductive-recurses-through-a-seq
parses = true
source = ```tauto
inductive Seq(A: Type): Type {
  nil(): Seq(A)
  cons(h: A, t: Seq(A)): Seq(A)
}
fn plus(n: Nat, m: Nat) -> Nat {
  match n -> Nat {
    zero => m
    succ(k) => succ(plus(k, m))
  }
}
inductive Tree(): Type {
  node(x: Nat, cs: Seq(Tree)): Tree
}
fn leaf(x: Nat) -> Tree { node(x, nil) }
mutual {
  fn size(t: Tree) -> Nat {
    match t -> Nat {
      node(x, cs) => succ(sizes(cs))
    }
  }
  fn sizes(l: Seq(Tree)) -> Nat {
    match l -> Nat {
      nil => zero
      cons(h, rest) => plus(size(h), sizes(rest))
    }
  }
}
theorem t(): Eq(Nat, size(node(7, cons(leaf(1), cons(leaf(2), nil)))), 3) { refl() }
```
checks.Tree = "ok"
checks.size = "ok"
checks.sizes = "ok"
checks.t = "ok"

