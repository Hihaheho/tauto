@ cases.mutual-tree-and-forest-sizes
parses = true
source = ```tauto
fn plus(n: Nat, m: Nat) -> Nat {
  match n -> Nat {
    zero => m
    succ(k) => succ(plus(k, m))
  }
}
mutual {
  inductive Tree(): Type {
    node(x: Nat, f: Forest): Tree
  }
  inductive Forest(): Type {
    nil(): Forest
    cons(t: Tree, rest: Forest): Forest
  }
}
mutual {
  fn tree_size(t: Tree) -> Nat {
    match t -> Nat {
      node(x, f) => succ(forest_size(f))
    }
  }
  fn forest_size(f: Forest) -> Nat {
    match f -> Nat {
      nil => zero
      cons(t, rest) => plus(tree_size(t), forest_size(rest))
    }
  }
}
```
checks.tree_size = "ok"
checks.forest_size = "ok"

@ cases.mutual-recursion-must-follow-fields
parses = true
source = ```tauto
mutual {
  inductive Tree(): Type {
    node(x: Nat, f: Forest): Tree
  }
  inductive Forest(): Type {
    nil(): Forest
    cons(t: Tree, rest: Forest): Forest
  }
}
mutual {
  fn tree_size(t: Tree) -> Nat {
    match t -> Nat {
      node(x, f) => succ(forest_size(f))
    }
  }
  fn forest_size(f: Forest) -> Nat {
    match f -> Nat {
      nil => zero
      cons(t, rest) => forest_size(f)
    }
  }
}
```
checks.tree_size = "error: not structural"

@ cases.match-unifies-the-index-of-a-family
parses = true
source = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  vnil(): Vec(A, zero)
  vcons(n: Nat, h: A, t: Vec(A, n)): Vec(A, succ(n))
}
fn head(A: Type, n: Nat, v: Vec(A, succ(n))) -> A {
  match v -> A {
    vcons(k, h, t) => h
  }
}
fn second(A: Type, n: Nat, v: Vec(A, succ(succ(n)))) -> A {
  match v -> A {
    vcons(k, h, t) => match t -> A {
      vcons(j, h2, t2) => h2
    }
  }
}
theorem only(A: Type, v: Vec(A, 0)): Eq(Vec(A, 0), v, vnil(A)) {
  match v -> Eq(Vec(A, 0), v, vnil(A)) {
    vnil => refl(Vec(A, 0), vnil(A))
  }
}
theorem snd(): Eq(Nat, second(Nat, 0, vcons(Nat, 1, 4, vcons(Nat, 0, 9, vnil(Nat)))), 9) { refl(Nat, 9) }
```
checks.head = "ok"
checks.second = "ok"
checks.only = "ok"
checks.snd = "ok"

