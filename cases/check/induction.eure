@ cases.a-recursion-inside-a-match-applied-to-its-generalized-arguments
parses = true
source = ```tauto
inductive Le: (Nat, Nat) -> Prop {
  LeZero(m: Nat): Le(Zero, m)
  LeSs(n: Nat, m: Nat, h: Le(n, m)): Le(Succ(n), Succ(m))
}
theorem le_pred<d: Nat, n: Nat>(h: Le(Succ(d), Succ(n))): Le(d, n) {
  match h {
    LeSs(a, b, k) => k
  }
}
fn shift(n: Nat, acc: Nat): Nat {
  (⊢ (Nat) -> Nat from match n {
    Zero => a => a
    Succ(k) => a => shift(k, Succ(a))
  })(acc)
}
theorem shift_ok(): shift(2, 3) = 5 { Refl }
theorem le_succ_any(n: Nat, h: Le(n, n)): Le(n, Succ(n)) {
  (⊢ (Le(n, n)) -> Le(n, Succ(n)) from match n {
    Zero => k => LeZero(Succ(Zero))
    Succ(m) => k => LeSs(m, Succ(m), le_succ_any(m, le_pred(k)))
  })(h)
}
```
