// What the kernel accepts and rejects once inductive types, eliminators and
// structural recursion are in.

@ cases.addition-by-structural-recursion
parses = true
source = ```tauto
fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}
theorem two_plus_three(): plus(2, 3) = 5 { Refl(Nat, 5) }
```
checks.plus = "ok"
checks.two_plus_three = "ok"

@ cases.n-plus-zero-by-induction
parses = true
source = ```tauto
fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}
theorem plus_zero(n: Nat): plus(n, Zero) = n {
  ⊢ plus(n, Zero) = n from match n {
    Zero => Refl(Nat, Zero)
    Succ(k) => Eq::subst(Nat, plus(k, Zero), k, y => Succ(plus(k, Zero)) = Succ(y), plus_zero(k), Refl(Nat, Succ(plus(k, Zero))))
  }
}
```
checks.plus_zero = "ok"

