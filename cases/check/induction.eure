@ cases.a-recursive-call-may-change-an-earlier-parameter
parses = true
source = ```tauto
fn pred(t: Nat): Nat {
  ⊢ Nat from match t {
    Zero => Zero
    Succ(k) => k
  }
}
fn sub(t: Nat, n: Nat): Nat {
  ⊢ Nat from match n {
    Zero => t
    Succ(k) => sub(pred(t), k)
  }
}
fn count(acc: Nat, n: Nat, extra: Nat): Nat {
  ⊢ Nat from match n {
    Zero => acc
    Succ(k) => count(Succ(acc), k, extra)
  }
}
theorem five_minus_two(): sub(5, 2) = 3 { Refl }
theorem two_plus_three(): count(2, 3, 0) = 5 { Refl }
```
