@ cases.mutual-functions-can-share-a-step-count
parses = true
source = ```tauto
mutual {
  fn even(k: Nat, n: Nat): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match n {
        Zero => true
        Succ(m) => odd(j, m)
      }
    }
  }
  fn odd(k: Nat, n: Nat): Bool {
    ⊢ Bool from match k {
      Zero => false
      Succ(j) => ⊢ Bool from match n {
        Zero => false
        Succ(m) => even(j, m)
      }
    }
  }
  fn halves(k: Nat, n: Nat): Nat {
    ⊢ Nat from match k {
      Zero => Zero
      Succ(j) => ⊢ Nat from match even(j, n) {
        true => n
        false => halves(j, Succ(n))
      }
    }
  }
}
theorem four(): even(10, 4) = true { Refl }
theorem five(): odd(10, 5) = true { Refl }
theorem up(): halves(10, 3) = 4 { Refl }
```
checks.even = "ok"
checks.odd = "ok"
checks.halves = "ok"
checks.four = "ok"
checks.five = "ok"
checks.up = "ok"

