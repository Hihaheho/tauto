@ cases.eq-substitution
parses = true
source = ```tauto
theorem sym(A: Type, a: A, b: A, e: Eq(A, a, b)): Eq(A, b, a) {
  Eq_subst(A, a, b, y => Eq(A, y, a), e, refl(A, a))
}
```
checks.sym = "ok"

@ cases.head-of-a-nonempty-vector
parses = true
source = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  vnil(): Vec(A, zero)
  vcons(n: Nat, h: A, t: Vec(A, n)): Vec(A, succ(n))
}
fn head(A: Type, n: Nat, v: Vec(A, succ(n))) -> A {
  Vec_rec(A, m => w => Nat_rec(q => Type, Unit, k => ih => A, m), star, k => h => t => ih => h, succ(n), v)
}
theorem first(): Eq(Nat, head(Nat, 0, vcons(Nat, 0, 7, vnil(Nat))), 7) { refl(Nat, 7) }
```
checks.head = "ok"
checks.first = "ok"

