@ cases.a-recursion-on-a-part-in-an-arm-of-a-match-on-it
parses = true
source = ```tauto
inductive L: Type {
  Nil: L
  Cons(h: Nat, t: L): L
}
fn tail2(l: L): Nat {
  ⊢ Nat from match l {
    Nil => Zero
    Cons(a, r) => ⊢ Nat from match r {
      Nil => Zero
      Cons(b, s) => ⊢ Nat from match s {
        Nil => Succ(tail2(s))
        Cons(c, rest) => Succ(tail2(s))
      }
    }
  }
}
fn skip3(l: L): Nat {
  ⊢ Nat from match l {
    Nil => Zero
    Cons(a, r) => ⊢ Nat from match r {
      Nil => Zero
      Cons(b, s) => ⊢ Nat from match s {
        Nil => Zero
        Cons(c, t) => ⊢ Nat from match t {
          Nil => skip3(s)
          Cons(d, rest) => Succ(skip3(s))
        }
      }
    }
  }
}
theorem skip3_six(): skip3(Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Cons(6, Nil))))))) = 2 { Refl }
theorem tail2_five(): tail2(Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Nil)))))) = 2 { Refl }
