// What the kernel accepts and rejects once inductive types, eliminators and
// structural recursion are in.

@ cases.addition-by-structural-recursion
parses = true
source = ```tauto
fn plus(n: Nat, m: Nat) -> Nat {
  match n -> Nat {
    zero => m
    succ(k) => succ(plus(k, m))
  }
}
theorem two_plus_three(): Eq(Nat, plus(2, 3), 5) { refl(Nat, 5) }
```
checks.plus = "ok"
checks.two_plus_three = "ok"

@ cases.n-plus-zero-by-induction
parses = true
source = ```tauto
fn plus(n: Nat, m: Nat) -> Nat {
  match n -> Nat {
    zero => m
    succ(k) => succ(plus(k, m))
  }
}
theorem plus_zero(n: Nat): Eq(Nat, plus(n, zero), n) {
  match n -> Eq(Nat, plus(n, zero), n) {
    zero => refl(Nat, zero)
    succ(k) => Eq_subst(Nat, plus(k, zero), k, y => Eq(Nat, succ(plus(k, zero)), succ(y)), plus_zero(k), refl(Nat, succ(plus(k, zero))))
  }
}
```
checks.plus_zero = "ok"

@ cases.a-non-structural-recursion-is-rejected
parses = true
source = ```tauto
fn again(n: Nat) -> Nat {
  match n -> Nat {
    zero => zero
    succ(k) => again(n)
  }
}
```
checks.again = "error: not structural"

