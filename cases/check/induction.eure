@ cases.a-recursive-call-leaves-the-generics-out
parses = true
source = ```tauto
inductive Le: (Nat, Nat) -> Prop {
  LeZero(m: Nat): Le(Zero, m)
  LeSs(n: Nat, m: Nat, h: Le(n, m)): Le(Succ(n), Succ(m))
}
theorem le_pred<d: Nat, n: Nat>(h: Le(Succ(d), Succ(n))): Le(d, n) {
  match h {
    LeSs(a, b, k) => k
  }
}
theorem le_again<d: Nat, n: Nat>(h: Le(d, n)): Le(d, n) {
  ⊢ Le(d, n) from match d {
    Zero => LeZero(n)
    Succ(d2) => ⊢ Le(Succ(d2), n) from match n {
      Zero => h
      Succ(n2) => LeSs(d2, n2, le_again(le_pred(h)))
    }
  }
}
```
checks.le_again = "ok"

@ cases.a-recursion-on-a-field-of-a-field
parses = true
source = ```tauto
inductive L: Type {
  Nil: L
  Cons(h: Nat, t: L): L
}
fn len(l: L): Nat {
  ⊢ Nat from match l {
    Nil => Zero
    Cons(a, r) => Succ(len(r))
  }
}
fn dbl(l: L): L {
  ⊢ L from match l {
    Nil => Nil
    Cons(a, r) => Cons(a, Cons(a, dbl(r)))
  }
}
fn halve(l: L): Nat {
  ⊢ Nat from match l {
    Nil => Zero
    Cons(a, Nil) => Zero
    Cons(a, Cons(b, rest)) => Succ(halve(rest))
  }
}
fn thirds(acc: Nat, l: L): Nat {
  ⊢ Nat from match l {
    Nil => acc
    Cons(a, r) => ⊢ Nat from match r {
      Nil => acc
      Cons(b, s) => ⊢ Nat from match s {
        Nil => acc
        Cons(c, rest) => thirds(Succ(acc), rest)
      }
    }
  }
}
theorem halve_dbl(l: L): halve(dbl(l)) = len(l) {
  ⊢ halve(dbl(l)) = len(l) from match l {
    Nil => Refl
    Cons(a, r) => Eq::congr(Succ, halve_dbl(r))
  }
}
theorem halve_self(l: L): halve(l) = halve(l) {
  ⊢ halve(l) = halve(l) from match l {
    Nil => Refl
    Cons(a, Nil) => Refl
    Cons(a, Cons(b, rest)) => Eq::congr(Succ, halve_self(rest))
  }
}
theorem halve_five(): halve(Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Nil)))))) = 2 { Refl }
theorem thirds_seven(): thirds(0, Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Cons(6, Cons(7, Nil)))))))) = 2 {
  Refl
}
```
checks.halve = "ok"
checks.thirds = "ok"
checks.halve_dbl = "ok"
checks.halve_self = "ok"
checks.halve_five = "ok"
checks.thirds_seven = "ok"

