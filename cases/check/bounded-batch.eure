@ cases.checked-batch-contract
source = path`../../examples/bounded-batch/src/batch.taut`
checks_all = "ok"
checks.batch_items = "ok"
checks.batch_remaining = "ok"
checks.batch_reassembles = "ok"
checks.batch_size_bounded = "ok"
checks.batch_fills = "ok"
checks.batch_short_queue = "ok"
