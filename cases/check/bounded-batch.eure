@ cases.runtime-batches-keep-order-duplicates-and-boundaries
tote = path`../../examples/bounded-batch`
backends = ["rust", "javascript", "vm"]
shows = [
  "first = Cons(7, Cons(7, Nil))",
  "remaining = Cons(9, Nil)",
  "last = Cons(9, Nil)",
  "drained = Nil",
  "paused = Nil",
  "paused remaining = Cons(7, Cons(7, Cons(9, Nil)))",
  "oversized = Cons(7, Cons(7, Cons(9, Nil)))",
  "oversized remaining = Nil",
  "empty = Nil",
  "empty remaining = Nil",
]
