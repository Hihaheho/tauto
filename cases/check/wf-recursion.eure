@ cases.a-call-must-end-with-its-proof-0
imports = [path`../../std/WellFounded.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

fn id_nat(n: Nat): Nat { n }

fn down(n: Nat): Nat decreasing_by measure(id_nat) => theorem down::eq {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(m) => down(m)
  }
}
```

