@ cases.a-proof-of-another-fact-is-not-a-proof-that-it-descends-0
imports = [path`../../std/WellFounded.taut`, path`../../std/Nat.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

fn id_nat(n: Nat): Nat { n }

fn loop_(n: Nat): Nat decreasing_by measure(id_nat) => theorem loop_::eq {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(m) => loop_(Succ(m), Nat::le_refl(Succ(m)))
  }
}
```

checks_all = "ok"
checks."calc_is_white" = "skipped"
checks."calc_syntax::parse" = "skipped"
checks."calc_is_rel" = "skipped"
checks."calc_multiline" = "skipped"
checks."calc_lay" = "skipped"
checks."calc_fmt" = "skipped"
checks."calc_tokens" = "skipped"
checks."calc_iff" = "skipped"
checks."calc_last" = "skipped"
checks."calc_steps" = "skipped"
checks."calc" = "skipped"
checks."input/main.taut::id_nat" = "ok"
checks."input/main.taut::loop_@step" = "error: "
checks."input/main.taut::loop_" = "error: "
checks."input/main.taut::loop_::eq" = "error: "
@ cases.a-proof-of-another-fact-is-not-a-proof-that-it-descends-0.diagnostics[]
file = "input/main.taut"
name = "loop_@step"
message = "type mismatch: expected `Nat::lt(id_nat(Succ(m)), id_nat(Succ(m))) = true`, found `Nat::le(Succ(m), Succ(m)) = true`\n  differing part: expected `Nat::lt(id_nat(Succ(m)), id_nat(Succ(m)))`, found `Nat::le(Succ(m), Succ(m))`"
span = "«Nat::le_refl(Succ(m))»"
@ cases.a-proof-of-another-fact-is-not-a-proof-that-it-descends-0.diagnostics[]
file = "input/main.taut"
name = "loop_"
message = "uses `loop_@step`, which did not check"
span = "«fn loop_(n: Nat): Nat decreasing_by measure(id_nat) => theorem loop_::eq {\n  ⊢ Nat from match n {\n    Zero => Zero\n    Succ(m) => loop_(Succ(m), Nat::le_refl(Succ(m)))\n  }\n}»"
@ cases.a-proof-of-another-fact-is-not-a-proof-that-it-descends-0.diagnostics[]
file = "input/main.taut"
name = "loop_::eq"
message = "uses `loop_`, which did not check; what follows may come from that: type mismatch: expected `loop_(n) = loop_@step(n, n' => r' => loop_(n'))`, found `wf_fix(Nat, wf_rel_lt(Nat, measure(Nat, id_nat)), n' => Nat, wf_rel_wf(Nat, measure(Nat, id_nat)), loop_@step, n) = loop_@step(n, y => r => wf_fix(Nat, wf_rel_lt(Nat, measure(Nat, id_nat)), n' => Nat, wf_rel_wf(Nat, measure(Nat, id_nat)), loop_@step, y))`\n  differing part: expected `loop_(n)`, found `wf_fix(Nat, wf_rel_lt(Nat, measure(Nat, id_nat)), n' => Nat, wf_rel_wf(Nat, measure(Nat, id_nat)), loop_@step, n)`"
span = "«fn loop_(n: Nat): Nat decreasing_by measure(id_nat) => theorem loop_::eq {\n  ⊢ Nat from match n {\n    Zero => Zero\n    Succ(m) => loop_(Succ(m), Nat::le_refl(Succ(m)))\n  }\n}»"

