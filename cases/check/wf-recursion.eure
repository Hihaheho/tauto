@ cases.the-function-is-not-a-value-in-its-own-body-0
imports = [path`../../std/WellFounded.taut`, path`../../std/Nat.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

fn id_nat(n: Nat): Nat { n }

fn down(n: Nat): Nat decreasing_by measure(id_nat) => theorem down::eq {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(m) => Succ(m)
  }
}

fn again(n: Nat): Nat decreasing_by measure(id_nat) => theorem again::eq {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(m) => again(m, Nat::le_refl(m)) + again
  }
}
```

