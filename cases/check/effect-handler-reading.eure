description = "Handlers read in proofs: a handler that takes the computation it handles as a function, and one whose value a `let` takes while it writes a `var`."

@ cases.handler-of-a-function-argument-with-a-var
imports = [path`../../std/base.taut`]
source = ```tauto
effect tick(): Nat
fn run_with<T>(start: Nat, body: () -> T ! {tick}): T × Nat {
  var n: Nat := start
  let v := handle { body() } with {
    tick(), k => {
      n := Nat::add(n, 1)
      k(n)
    }
  }
  #(v, n)
}
fn twice(f: () -> Nat ! {tick}): Nat ! {tick} { Nat::add(f(), f()) }
fn session(): Nat ! {tick} { Nat::add(perform tick(), perform tick()) }
fn session_twice(): Nat ! {tick} { twice(session) }
fn from_ten(): Nat × Nat { run_with(10, session) }
fn from_zero(): Nat × Nat { run_with(0, session_twice) }
theorem from_ten_value(): from_ten() = (#(23, 12)) { Refl }
theorem from_zero_value(): from_zero() = (#(10, 4)) { Refl }
show(&from_ten())
show(&from_zero())
```
checks.run_with = "checked"
checks.twice = "checked"
checks.from_ten_value = "checked"
checks.from_zero_value = "checked"
stdout = ```
#(23, 12)
#(10, 4)
```

@ cases.let-takes-a-handler-that-writes-a-var
imports = [path`../../std/base.taut`]
source = ```tauto
effect tick(): Nat
fn count(): Nat ! {tick} { perform tick() }
fn counted(): Nat × Nat {
  var n: Nat := 0
  let v := handle { count() } with {
    tick(), k => {
      n := Nat::add(n, 1)
      k(n)
    }
  }
  #(v, n)
}
theorem counted_value(): counted() = (#(1, 1)) { Refl }
```
checks.counted = "checked"
checks.counted_value = "checked"

// A function with effects whose row is open is read with its row variable
// as a parameter, its `var`s and handlers as in any other row.
@ cases.open-row-handler-with-a-var-is-read
imports = [path`../../std/base.taut`]
source = ```tauto
effect tick(): Nat
fn counted<T, !e>(body: &(() -> T ! {tick} ∪ e)): (T × Nat) ! {tick} ∪ e {
  var n: Nat := 0
  let v := handle { body() } with {
    tick(), k => {
      n := Nat::add(n, 1)
      k(perform tick())
    }
  }
  #(v, n)
}
fn two(): Nat ! {tick} { Nat::add(perform tick(), perform tick()) }
fn counted_two(): (Nat × Nat) ! {tick} { counted(two) }
fn fives(): Nat × Nat {
  handle { counted_two() } with {
    tick(), k => k(5)
  }
}
theorem fives_value(): fives() = (#(10, 2)) { Refl }
```
checks.counted = "checked"
checks.fives_value = "checked"

// A handler that leaves no effect is read as the value its fold gives, so a
// theorem about it with symbolic arguments holds by `Refl` even when an arm
// goes through a `match` that does not reduce before it resumes.
@ cases.a-handler-with-a-stuck-match-in-an-arm-reduces-on-symbolic-arguments
imports = [path`../../std/base.taut`, path`../../std/nat.taut`]
source = ```tauto
effect add(a: Nat, b: Nat): Nat

fn limit(n: Nat, c: Bool): Option(Nat) {
  match c {
    true => Some(n)
    false => None
  }
}

fn add3(a: Nat, b: Nat, c: Nat): Nat ! {add} {
  let x := perform add(a, b)
  perform add(x, c)
}

fn one(a: Nat, b: Nat): Nat ! {add} {
  perform add(a, b)
}

fn run3(m: Nat, a: Nat, b: Nat, c: Nat): Option(Nat) {
  handle { add3(a, b, c) } with {
    add(x, y), k => match limit(Nat::add(x, y), Nat::lt(Nat::add(x, y), m)) {
      Some(r) => k(r)
      None => None
    }
    return v => Some(v)
  }
}

fn run1(m: Nat, a: Nat, b: Nat): Option(Nat) {
  handle { one(a, b) } with {
    add(x, y), k => match limit(Nat::add(x, y), Nat::lt(Nat::add(x, y), m)) {
      Some(r) => k(r)
      None => None
    }
    return v => Some(v)
  }
}

fn spec1(m: Nat, a: Nat, b: Nat): Option(Nat) {
  match limit(Nat::add(a, b), Nat::lt(Nat::add(a, b), m)) {
    Some(r) => Some(r)
    None => None
  }
}

fn spec3(m: Nat, a: Nat, b: Nat, c: Nat): Option(Nat) {
  match limit(Nat::add(a, b), Nat::lt(Nat::add(a, b), m)) {
    Some(r) => match limit(Nat::add(r, c), Nat::lt(Nat::add(r, c), m)) {
      Some(s) => Some(s)
      None => None
    }
    None => None
  }
}

theorem run3_is_spec3(m: Nat, a: Nat, b: Nat, c: Nat): run3(m, a, b, c) = spec3(m, a, b, c) { Refl }
theorem run1_is_spec1(m: Nat, a: Nat, b: Nat): run1(m, a, b) = spec1(m, a, b) { Refl }
```
checks.run3_is_spec3 = "checked"
checks.run1_is_spec1 = "checked"

// A callback passed to a function with an open row, from a function with no
// effect: the callback's own effects, handled by the callee, are not the
// caller's. The callback may be written as a λ.
@ cases.a-callback-handled-by-the-callee-is-read-from-a-pure-caller
imports = [path`../../std/base.taut`, path`../../std/nat.taut`]
source = ```tauto
effect tick(): Nat

fn h<A, !e>(n: Nat, c: &(() -> A ! {tick} ∪ e)): Option(A) ! e {
  handle { c() } with {
    tick(), k => k(n)
    return v => Some(v)
  }
}

fn thunk(): Nat ! {tick} { perform tick() }
fn named(n: Nat): Option(Nat) { h(n, thunk) }
fn lambda(n: Nat): Option(Nat) { h(n, &(() => Nat::add(perform tick(), perform tick()))) }
fn called(n: Nat): Option(Nat) { h(n, &(() => thunk())) }

theorem named_value(): named(4) = Some(4) { Refl }
theorem lambda_value(): lambda(4) = Some(8) { Refl }
theorem called_value(): called(4) = Some(4) { Refl }
```
checks.named_value = "checked"
checks.lambda_value = "checked"
checks.called_value = "checked"
