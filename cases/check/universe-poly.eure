@ cases.levels-over-template-parameters-0
source = ```tauto
theorem id_poly<u: Level, A: Type(u)>(x: A): A { x }
theorem lift<u: Level>(A: Type(u)): Type(u + 1) { id_poly(u + 1, Type(u), A) }
def Arrow<u: Level, v: Level>(A: Type(u), B: Type(v)): Type(max(u, v)) := (A) -> B
inductive UBox(u: Level, A: Type(u)): Type(u) { Ubox(value: A): UBox(u, A) }
theorem unbox_type<u: Level>(b: UBox(u + 1, Type(u))): Type(u) {
  let open := recursor(UBox(u + 1), u + 1)
  open(Type(u), x => Type(u), t => t, b)
}
theorem used(): Type1 { lift(0, Nat) }
theorem arrow(): Type2 { Arrow(0, 2, Nat, Type1) }
theorem unboxed(): Type { unbox_type(0, Ubox(1, Type, Nat)) }
```
checks_all = "ok"

