@ cases.polymorphic-declarations-call-each-other-0
source = ```tauto
theorem id_poly<u: Level, A: Type(u)>(x: A): A { x }

theorem twice<u: Level, A: Type(u)>(x: A): A { id_poly(u, id_poly(u, x)) }
theorem go(n: Nat): Nat { twice(0, n) }
theorem big(T: Type1): Type1 { twice(2, T) }
```
