}
```

checks_all = "ok"
checks."input/main.taut::wrong" = "error: type mismatch"

// The kernel computes closed numbers below 2^256: the bounds of 128-bit
// integers and the products of their values.
@ cases.closed-numbers-below-2-256-are-computed
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn two_pow(n: Nat): Nat {
  ⊢ Nat from match n {
    Zero => 1
    Succ(k) => 2 * two_pow(k)
  }
}
theorem pow128(): two_pow(128) = 340282366920938463463374607431768211456 {
  Refl
}
theorem max_squared(): Nat::sub(two_pow(128), 1) * Nat::sub(two_pow(128), 1) = 115792089237316195423570985008687907852589419931798687112530834793049593217025 {
  Refl
}
theorem quotient(hq: ¬(Nat::sub(two_pow(128), 1) = 0)): Nat::div_nz(two_pow(255), Nat::sub(two_pow(128), 1), hq) = 170141183460469231731687303715884105728 {
  Refl
}
theorem below(): Nat::lt(two_pow(128) + 1, two_pow(255)) = true {
  Refl
}
```

checks_all = "ok"

