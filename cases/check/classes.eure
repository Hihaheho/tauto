@ cases.an-instance-with-a-where-is-found-through-its-records-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

class Cmp(A: Type) {
  fn compare(a: A, b: A): Ordering
  theorem refl<a: A>(): Cmp::compare(a, a) = Equal
  theorem irrefl<a: A>(h: Cmp::compare(a, a) = Less): False
}

fn nat_cmp(a: Nat, b: Nat): Ordering {
  ⊢ Ordering from match a {
    Zero => ⊢ Ordering from match b {
      Zero => Equal
      Succ(b2) => Less
    }
    Succ(a2) => ⊢ Ordering from match b {
      Zero => Greater
      Succ(b2) => nat_cmp(a2, b2)
    }
  }
}

theorem nat_cmp_refl(a: Nat): nat_cmp(a, a) = Equal {
  ⊢ nat_cmp(a, a) = Equal from match a {
    Zero => Refl
    Succ(k) => nat_cmp_refl(k)
  }
}

instance Cmp(Nat) {
  fn compare(a: Nat, b: Nat): Ordering { nat_cmp(a, b) }
  theorem refl<a: Nat>(): Cmp::compare(a, a) = Equal { nat_cmp_refl(a) }
  theorem irrefl<a: Nat>(h: Cmp::compare(a, a) = Less): False {
    less_ne_equal(Eq::trans(Eq::sym(h), nat_cmp_refl(a)))
  }
}

fn cmp_then(a: Ordering, b: Ordering): Ordering {
  ⊢ Ordering from match a {
    Less => Less
    Equal => b
    Greater => Greater
  }
}
instance<A> Cmp(List(A)) where Cmp(A) {
  fn compare(xs: List(A), ys: List(A)): Ordering {
    ⊢ Ordering from match xs {
      Nil => ⊢ Ordering from match ys {
        Nil => Equal
        Cons(y, ys2) => Less
      }
      Cons(x, xs2) => ⊢ Ordering from match ys {
        Nil => Greater
        Cons(y, ys2) => cmp_then(Cmp::compare(x, y), Cmp::compare(xs2, ys2))
      }
    }
  }
  theorem refl<a: List(A)>(): Cmp::compare(a, a) = Equal {
    ⊢ Cmp::compare(a, a) = Equal from match a {
      Nil => Refl
      Cons(x, xs) => Eq::subst(
        Ordering, Equal, Cmp::compare(x, x),
        y => cmp_then(y, Cmp::compare(xs, xs)) = Equal,
        Eq::sym(Cmp::refl()),
        Eq::subst(
          Ordering, Equal, Cmp::compare(xs, xs),
          z => cmp_then(Equal, z) = Equal,
          Eq::sym(Cmp::refl(xs)),
          Refl
        )
      )
    }
  }
  theorem irrefl<a: List(A)>(h: Cmp::compare(a, a) = Less): False {
    less_ne_equal(Eq::trans(Eq::sym(h), Cmp::refl()))
  }
}
theorem refl_lists(xs: List(List(Nat))): Cmp::compare(xs, xs) = Equal { Cmp::refl() }
```

