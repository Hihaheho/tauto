@ cases.an-instance-generic-is-not-captured-by-a-caller-generic-of-the-same-name
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
class Tag(A: Type) {
  fn tag(a: A): Nat
}
inductive Two(K: Type, V: Type): Type {
  Mk(k: K, v: V): Two(K, V)
}
instance Tag(Nat) {
  fn tag(a: Nat): Nat { a }
}
instance<K, V> Tag(Two(K, V)) where Tag(K), Tag(V) {
  fn tag(a: Two(K, V)): Nat {
    ⊢ Nat from match a {
      Mk(k, v) => Nat::add(Tag::tag(k), Tag::tag(v))
    }
  }
}
fn f<V>(s: Two(V, Nat)): Nat where Tag(V) { Tag::tag(s) }
fn g<T>(s: Two(T, Nat)): Nat where Tag(T) { Tag::tag(s) }
```

