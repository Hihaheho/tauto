description = "Secret values (`docs/design/secret.md`): the proofs read a `Secret`, code that runs reaches it only through the `ct_` functions and `expose`, the Rust backend runs them, and the JavaScript backend refuses them."

// A table lookup that reads every entry, so the index stays secret, and the
// kernel's view of what the secret words compute.
@ cases.secret-lookup-runs-and-its-words-are-proved
backends = ["rust", "javascript"]
extract = true
source = ```tauto
import std::Secret
import std::prelude::Secret
import std::UInt
fn w(n: Nat): U64 { U64::wrap(n) }
fn lookup(t: List(Secret(U64)), i: Secret(U64), k: Nat, acc: Secret(U64)): Secret(U64) {
  ⊢ Secret(U64) from match t {
    Nil => acc
    Cons(x, rest) => lookup(rest, i, Succ(k), Ct::u64_select(Ct::u64_eq(i, Secret::Mk(w(k))), x, acc))
  }
}
theorem add_wraps(): expose(Ct::u64_add(Secret::Mk(w(18446744073709551615)), Secret::Mk(w(2)))) = w(1) { Refl }
theorem lt_is_secret(): expose(Ct::u32_lt(Secret::Mk(U32::wrap(3)), Secret::Mk(U32::wrap(5)))) = true { Refl }
theorem select_reads_no_bit(c: Secret(Bool), a: Secret(U8), b: Secret(U8), h: expose(c) = true): Ct::u8_select(c, a, b) = a {
  Ct::u8_select_true(c, a, b, h)
}
let t := Cons(Secret::Mk(w(10)), Cons(Secret::Mk(w(20)), Cons(Secret::Mk(w(30)), Nil)))
perform show("found", U64::val(expose(lookup(t, Secret::Mk(w(2)), 0, Secret::Mk(w(0))))))
perform show("hidden", lookup(t, Secret::Mk(w(1)), 0, Secret::Mk(w(0))))
perform show("hi", U64::val(expose(Ct::u64_mul_hi(Secret::Mk(w(18446744073709551615)), Secret::Mk(w(18446744073709551615))))))
perform show("rot", U8::val(expose(Ct::u8_rotl(Secret::Mk(U8::wrap(129)), 9))))
perform show("low", U8::val(expose(Ct::u8_of_u64(Secret::Mk(w(511))))))
```
checks.add_wraps = "checked"
checks.lt_is_secret = "checked"
checks.select_reads_no_bit = "checked"
shows = ["found = 30", "hidden = Secret", "hi = 18446744073709551614", "rot = 3", "low = 255"]
compile_errors.javascript = "generate: secret words, which it cannot run in constant time"

// A secret byte string, read one byte at a time by a public index, without
// `expose`: the bytes stay secret.
@ cases.secret-bytes-are-read-one-by-one
backends = ["rust"]
extract = true
source = ```tauto
import std::Secret
import std::prelude::Secret
import std::UInt
import std::prelude::Shared
import std::Bytes
fn sum(s: Secret(Bytes), i: Nat, fuel: Nat, acc: Secret(U8)): Secret(U8) {
  ⊢ Secret(U8) from match fuel {
    Zero => acc
    Succ(f) => ⊢ Secret(U8) from match Ct::bytes_get(s, i) {
      None => acc
      Some(x) => sum(s, Succ(i), f, Ct::u8_add(acc, x))
    }
  }
}
theorem len_is_public(): Ct::bytes_len(Secret::Mk(Bytes::of_text("abc"))) = 3 { Refl }
let k := Secret::Mk(Bytes::of_text("abc"))
perform show("len", Ct::bytes_len(k))
perform show("byte", Ct::bytes_get(k, 1))
perform show("past", Ct::bytes_get(k, 3))
perform show("sum", U8::val(expose(sum(k, 0, Ct::bytes_len(k), Secret::Mk(U8::wrap(0))))))
```
checks.len_is_public = "checked"
shows = ["len = 3", "byte = Some(Secret)", "past = None", "sum = 38"]

// A proof may read a secret; code that runs may not.
@ cases.a-match-on-a-secret-does-not-run
extract = true
entry = "main.taut"
files."main.taut" = ```tauto
import std::Secret
import std::prelude::Secret
fn leak(s: Secret(Bool)): Nat {
  ⊢ Nat from match s {
    Secret::Mk(v) => ⊢ Nat from match v { true => 1, false => 0 }
  }
}
perform show("x", leak(Secret::Mk(true)))
```
load_error = "a match on a `Secret` reads it in code that runs"

// Code that runs sees the prelude's `Secret`, which the prelude declares
// without `pub(open)`: a program cannot build one but with `secret`.
@ cases.a-secret-has-no-literal
files."main.nib" = ```tauto
import std::prelude::Secret

fn f(): Secret(u64) { Secret {} }
```
checks."main.nib::macro" = "error: `Secret` is a constructor of `Secret`, which the prelude declares without `pub(open)`: outside that file the type is abstract; use the functions it makes public"
