description = "Secret values (`docs/design/secret.md`): the proofs read a `Secret`, code that runs reaches it only through the `ct_` functions and `expose`, the Rust backend runs them, and the JavaScript backend refuses them."

// A table lookup that reads every entry, so the index stays secret, and the
// kernel's view of what the secret words compute.
@ cases.secret-lookup-runs-and-its-words-are-proved
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `secret` yet"
compile_errors.vm = "generate: secret words, which it cannot run in constant time"
source = ```tauto
import std::secret
import std::uint
fn w(n: Nat): UInt(64) { UInt::wrap64(n) }
fn lookup(t: List(Secret(UInt(64))), i: Secret(UInt(64)), k: Nat, acc: Secret(UInt(64))): Secret(UInt(64)) {
  ⊢ Secret(UInt(64)) from match t {
    Nil => acc
    Cons(x, rest) => lookup(rest, i, Succ(k), Ct::u64_select(Ct::u64_eq(i, Secret::Mk(w(k))), x, acc))
  }
}
theorem add_wraps(): expose(Ct::u64_add(Secret::Mk(w(18446744073709551615)), Secret::Mk(w(2)))) = w(1) { Refl }
theorem lt_is_secret(): expose(Ct::u32_lt(Secret::Mk(UInt::wrap32(3)), Secret::Mk(UInt::wrap32(5)))) = true { Refl }
theorem select_reads_no_bit(c: Secret(Bool), a: Secret(UInt(8)), b: Secret(UInt(8)), h: expose(c) = true): Ct::u8_select(c, a, b) = a {
  Ct::u8_select_true(c, a, b, h)
}
let t := Cons(Secret::Mk(w(10)), Cons(Secret::Mk(w(20)), Cons(Secret::Mk(w(30)), Nil)))
show(&UInt::val64(expose(lookup(t, Secret::Mk(w(2)), 0, Secret::Mk(w(0))))))
show(&lookup(t, Secret::Mk(w(1)), 0, Secret::Mk(w(0))))
show(&UInt::val64(expose(Ct::u64_mul_hi(Secret::Mk(w(18446744073709551615)), Secret::Mk(w(18446744073709551615))))))
show(&UInt::val8(expose(Ct::u8_rotl(Secret::Mk(UInt::wrap8(129)), 9))))
show(&UInt::val8(expose(Ct::u8_of_u64(Secret::Mk(w(511))))))
```
checks.add_wraps = "checked"
checks.lt_is_secret = "checked"
checks.select_reads_no_bit = "checked"
stdout = ```
30
Secret { .. }
18446744073709551614
3
255
```
compile_errors.javascript = "generate: secret words, which it cannot run in constant time"

// A secret byte string, read one byte at a time by a public index, without
// `expose`: the bytes stay secret.
@ cases.secret-bytes-are-read-one-by-one
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
compile_errors.vm = "generate: secret words, which it cannot run in constant time"
compile_errors.javascript = "generate: secret words, which it cannot run in constant time"
source = ```tauto
import std::secret
import std::uint
import std::bytes
fn sum(s: Secret(Bytes), i: Nat, fuel: Nat, acc: Secret(UInt(8))): Secret(UInt(8)) {
  ⊢ Secret(UInt(8)) from match fuel {
    Zero => acc
    Succ(f) => ⊢ Secret(UInt(8)) from match Ct::bytes_get(s, i) {
      None => acc
      Some(x) => sum(s, Succ(i), f, Ct::u8_add(acc, x))
    }
  }
}
theorem len_is_public(): Ct::bytes_len(Secret::Mk(Bytes::of_text("abc"))) = 3 { Refl }
let k := Secret::Mk(Bytes::of_text("abc"))
show(&Ct::bytes_len(k))
show(&Ct::bytes_get(k, 1))
show(&Ct::bytes_get(k, 3))
show(&UInt::val8(expose(sum(k, 0, Ct::bytes_len(k), Secret::Mk(UInt::wrap8(0))))))
```
checks.len_is_public = "checked"
stdout = ```
3
Some(Secret { .. })
None
38
```

// A proof may read a secret; code that runs may not.
@ cases.a-match-on-a-secret-does-not-run
extract = true
entry = "main.taut"
files."main.taut" = ```tauto
import std::secret
fn leak(s: Secret(Bool)): Nat {
  ⊢ Nat from match s {
    Secret::Mk(v) => ⊢ Nat from match v { true => 1, false => 0 }
  }
}
show(&leak(Secret::Mk(true)))
```
load_error = "a match on a `Secret` reads it in code that runs"

// Code that runs sees the prelude's `Secret`, which the prelude declares
// without `pub(open)`: a program cannot build one but with `secret`.
@ cases.a-secret-has-no-literal
files."main.nib" = ```tauto
import std::builtin::secret

fn f(): Secret(u64) { Secret {} }
```
checks.f = "error: `Secret` is a constructor of `Secret`, which the prelude declares without `pub(open)`: outside that file the type is abstract; use the functions it makes public"
