@ cases.an-ascription-takes-the-members-of-a-product-by-their-types
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn first(p: Nat × Bool): Nat { (p: Nat) }

fn second(p: Nat × Bool): Bool { (p: Bool) }

fn same(p: Nat × Bool): Nat × Bool { (p: Nat × Bool) }

fn fewer(p: Nat × Bool × Unit): Nat × Unit { (p: Nat × Unit) }

fn swapped(p: Nat × Bool): Bool × Nat { (p: Bool × Nat) }

theorem first_of(): (#(Zero, true): Nat) = Zero { Refl(Nat, Zero) }

theorem swapped_of(): (#(Zero, true): Bool × Nat) = #(true, Zero) { Refl(Bool × Nat, #(true, Zero)) }
```

checks_all = "ok"
checks."input/main.taut::first" = "ok"
checks."input/main.taut::second" = "ok"
checks."input/main.taut::same" = "ok"
checks."input/main.taut::fewer" = "ok"
checks."input/main.taut::swapped" = "ok"
checks."input/main.taut::first_of" = "ok"
checks."input/main.taut::swapped_of" = "ok"

