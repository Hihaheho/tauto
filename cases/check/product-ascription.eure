@ cases.a-product-is-ordered-and-a-closed-permutation-is-a-subtype
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn flip(p: Nat × Bool): Bool × Nat { p }

fn labelled(p: @a Nat × @b Nat): @b Nat × @a Nat { p }

fn both(n: Nat, b: Bool): Bool × Nat { #(n, b) }

fn tagged(m: Nat, n: Nat): @a Nat × @b Nat { #(@b n, @a m) }

fn first(p: Bool × Nat): Nat {
  match p {
    #(x, y) => y
  }
}

theorem flip_of(): flip(#(Zero, true)) = #(true, Zero) { Refl }
```

checks_all = "ok"
checks."input/main.taut::flip" = "ok"
checks."input/main.taut::labelled" = "ok"
checks."input/main.taut::both" = "ok"
checks."input/main.taut::tagged" = "ok"
checks."input/main.taut::first" = "ok"
checks."input/main.taut::flip_of" = "ok"

