@ cases.an-expected-type-takes-the-members-of-a-product
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn double(n: Nat): Nat { n + n }

fn argument(p: Nat × Bool): Nat { double(p) }

fn result(p: Nat × Bool × Unit): Unit × Nat { p }

fn annotated(p: Nat × Bool): Bool {
  let b: Bool := p
  b
}

theorem argument_of(): argument(#(Succ(Zero), true)) = Succ(Succ(Zero)) { Refl }
```

checks_all = "ok"
checks."input/main.taut::double" = "ok"
checks."input/main.taut::argument" = "ok"
checks."input/main.taut::result" = "ok"
checks."input/main.taut::annotated" = "ok"
checks."input/main.taut::argument_of" = "ok"

