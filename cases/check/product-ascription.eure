@ cases.a-generic-call-fixes-the-members-of-a-product-by-its-arguments
entry = "input/main.taut"
files."input/main.taut" = ```tauto
pub(open) inductive Table(K: Type, V: Type): Type {
  Mk(keys: List(K), values: List(V)): Table(K, V)
}

fn entries<K, V>(t: Table(K, V)): List(K × V) { Nil }

fn keys_of<K>(es: List(K × Bool)): List(K) {
  ⊢ List(K) from match es {
    Nil => Nil
    Cons(#(k, b), rest) => Cons(k, keys_of(rest))
  }
}

fn to_list<K>(t: Table(K, Bool)): List(K) { keys_of(entries(t)) }
```

checks_all = "ok"
checks."input/main.taut::entries" = "ok"
checks."input/main.taut::keys_of" = "ok"
checks."input/main.taut::to_list" = "ok"
