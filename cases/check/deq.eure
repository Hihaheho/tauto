checks."input/main.taut::Fun#2" = "error: "
@ cases.a-field-of-an-undecidable-type-cannot-list-an-equality-0.diagnostics[]
file = "input/main.taut"
name = "Fun"
message = "`Fun` lists a decidable equality that cannot be made: the field `f` of `Fun::Mk` has type `(Nat) -> Nat`, which has no decidable equality (a type that has one lists `fn T::beq, theorem T::beq_refl, theorem T::beq_sound, theorem T::deq` after its sort)"
span = "«=> fn Fun::beq, theorem Fun::beq_refl, theorem Fun::beq_sound, theorem Fun::deq»"

@ cases.a-parameter-is-compared-by-a-function-given-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

inductive Color: Type => fn Color::beq, theorem Color::beq_refl, theorem Color::beq_sound, theorem Color::deq {
  Red: Color
  Green: Color
  Blue: Color
}
inductive Cell: Type => fn Cell::beq, theorem Cell::beq_refl, theorem Cell::beq_sound, theorem Cell::deq {
  Empty: Cell
  CellOf(c: Color, n: Nat, b: Bool): Cell
}
inductive Tree: Type => fn Tree::beq, theorem Tree::beq_refl, theorem Tree::beq_sound, theorem Tree::deq {
  Leaf: Tree
  Node(l: Tree, v: Nat, r: Tree): Tree
}

inductive Box(A: Type): Type => fn Box::beq, theorem Box::beq_refl, theorem Box::beq_sound, theorem Box::deq {
  Mk(a: A, t: Tree): Box(A)
}
fn same_boxes(a: Box(Nat), b: Box(Nat)): Bool { a == b }
fn same_lists(a: List(Nat), b: List(Nat)): Bool { a == b }
fn same_options(a: Option(Pair(Nat, Color)), b: Option(Pair(Nat, Color))): Bool { a != b }
theorem sound(a: List(Nat), b: List(Nat), h: Eq(Bool, a == b, true)): a = b {
  List::beq_sound(Nat::eq, Nat::eq_sound, a, b, h)
}
theorem iff_box(a: Box(Color), b: Box(Color)): Iff(Box::beq(Color::beq, a, b) = true, a = b) {
  Box::deq(Color::beq, Color::beq_sound, Color::beq_refl, a, b)
}
```

