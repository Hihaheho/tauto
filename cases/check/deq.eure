// The decidable equality needs no import: what it is made from is the kernel's prelude.
@ cases.a-generated-equality-runs-without-an-import-0
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::prelude::Os

inductive Color: Type => fn Color::beq, theorem Color::beq_refl, theorem Color::beq_sound, theorem Color::deq {
  Red: Color
  Blue: Color
}

fn apply2(f: (Color, Color) -> Bool, a: Color, b: Color): Bool {
  f(a, b)
}

match Color::beq(Red, Blue) {
  true => perform stdout("same\n")
  false => perform stdout("different\n")
}
match apply2(Color::beq, Blue, Blue) {
  true => perform stdout("same\n")
  false => perform stdout("different\n")
}
```

checks_all = "ok"
checks."input/main.taut::Color" = "ok"
checks."input/main.taut::apply2" = "ok"
