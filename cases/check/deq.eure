checks."input/main.taut::same_lists" = "ok"
checks."input/main.taut::same_options" = "ok"
checks."input/main.taut::sound" = "ok"
checks."input/main.taut::iff_box" = "ok"

@ cases.an-inductive-of-numbers-decisions-and-itself-is-decidable-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

inductive Color: Type => fn Color::beq, theorem Color::beq_refl, theorem Color::beq_sound, theorem Color::deq {
  Red: Color
  Green: Color
  Blue: Color
}
inductive Cell: Type => fn Cell::beq, theorem Cell::beq_refl, theorem Cell::beq_sound, theorem Cell::deq {
  Empty: Cell
  CellOf(c: Color, n: Nat, b: Bool): Cell
}
inductive Tree: Type => fn Tree::beq, theorem Tree::beq_refl, theorem Tree::beq_sound, theorem Tree::deq {
  Leaf: Tree
  Node(l: Tree, v: Nat, r: Tree): Tree
}

fn same_color(a: Color, b: Color): Bool { a == b }
fn same_tree(a: Tree, b: Tree): Bool { a != b }
theorem sound(a: Tree, b: Tree, h: Tree::beq(a, b) = true): a = b { Tree::beq_sound(a, b, h) }
theorem refl_cell(c: Cell): Cell::beq(c, c) = true { Cell::beq_refl(c) }
theorem iff_color(a: Color, b: Color): Iff(Color::beq(a, b) = true, a = b) { Color::deq(a, b) }
theorem green_is_not_blue(h: Green = Blue): False {
  false_ne_true(Eq::subst(Color, Green, Blue, (z: Color) => Color::beq(Green, z) = true, h, Color::beq_refl(Green)))
}
```

checks_all = "ok"
checks."input/main.taut::Color" = "ok"
checks."input/main.taut::Cell" = "ok"
checks."input/main.taut::Tree" = "ok"
checks."input/main.taut::same_color" = "ok"
checks."input/main.taut::same_tree" = "ok"
checks."input/main.taut::sound" = "ok"
checks."input/main.taut::refl_cell" = "ok"
checks."input/main.taut::iff_color" = "ok"
checks."input/main.taut::green_is_not_blue" = "ok"

@ cases.an-inductive-that-does-not-list-an-equality-has-none-0
