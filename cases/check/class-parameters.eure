checks."input/main.taut::Read(Nat, 1)" = "error: class argument count does not match its parameter telescope"

@ cases.class-cyclic-dictionary-is-rejected
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Tagged(n: Nat): Type { Tag(value: Nat): Tagged(n) }
class Read(n: Nat) { fn read(value: Tagged(n)): Nat }
instance<n: Nat> Read(n) where Read(n) {
  fn read(value: Tagged(n)): Nat { 0 }
}
fn one(value: Tagged(1)): Nat { Read::read(value) }
```
checks_all = "ok"
checks."input/main.taut::one" = "error: instance resolution contains a cyclic constraint"

@ cases.class-universal-instance-at-runtime-index
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Tagged(n: Nat): Type { Tag(value: Nat): Tagged(n) }
class Read(n: Nat) { fn read(value: Tagged(n)): Nat }
instance<n: Nat> Read(n) { fn read(value: Tagged(n)): Nat { n } }
fn read_any<n: Nat>(value: Tagged(n)): Nat { Read::read(value) }
fn read_one(value: Tagged(1)): Nat { read_any(value) }
theorem one_result(): read_one(Tag(9)) = 1 { Refl }
```
checks_all = "ok"

@ cases.class-natural-constructor-patterns
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Tagged(n: Nat): Type { Tag(value: Nat): Tagged(n) }
class Read(n: Nat) { fn read(value: Tagged(n)): Nat }
instance Read(0) { fn read(value: Tagged(0)): Nat { 0 } }
instance<n: Nat> Read(Succ(n)) { fn read(value: Tagged(Succ(n))): Nat { n } }
fn read_three(value: Tagged(3)): Nat { Read::read(value) }
theorem predecessor_result(): read_three(Tag(9)) = 2 { Refl }
```
checks_all = "ok"
