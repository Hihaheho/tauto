@ cases.affine-suspending-callback-keeps-owned-capture
source = ```nib
import std::prelude::Affine

effect ask(): i64
fn apply_once(callback: affine () -> Text ! {ask}): Text ! {ask} { callback() }
let text := "kept"
let buffer := Buf::of(&text)
let result := handle {
  apply_once(() => {
    let ignored := perform ask()
    Text::of(buffer)
  })
} with {
  ask(), k => k(42)
  return value => value
}
perform show("value", result)
```
types = "ok"
rows = "ok"
lin = "ok"
shows = ['value = "kept"']
