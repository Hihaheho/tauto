@ cases.record-carried-row-suspends-the-call
source = ```nib
effect ask(n: i64): i64 resume 1
struct Handlers(!e) { on_key: (k: i64) -> i64 ! e }
fn dispatch<!e>(&h: Handlers(e), k: i64): i64 ! e { (h.on_key)(k) }
let r := handle {
  let h := Handlers { on_key: (k) => perform ask(k) + 1 }
  dispatch(&h, 3)
} with { ask(n), k => k(n * 10) }
perform show("r", r)
```
types = "ok"
rows = "ok"
lin = "ok"

@ cases.record-carried-row-resumes-many-times
source = ```nib
effect pick(): i64 resume ω
struct Handlers(!e) { on_key: (k: i64) -> i64 ! e }
fn dispatch<!e>(h: Handlers(e), k: i64): i64 ! e { (h.on_key)(k) }
let r := handle {
  dispatch(Handlers { on_key: (k) => perform pick() + k }, 3)
} with {
  pick(), k => k(1) + k(2)
  return v => v
}
perform show("r", r)
```
