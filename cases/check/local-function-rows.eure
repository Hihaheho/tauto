fn invoke(&callback: () -> i64 ! {}): i64 ! {} {
  let handled := handle { apply(() => perform ask()) } with {
    ask(), k => k(40)
    return value => value
  }
  handled + callback()
}
perform show("value", invoke(() => 2))
```
