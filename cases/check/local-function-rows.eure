@ cases.borrowed-result-keeps-independent-lifetime-after-handled-callback
source = ```nib
effect ask(): i64
struct Holder { text: Text }
fn apply<!e>(callback: () -> i64 ! e): i64 ! e { callback() }
fn select(&holder: Holder): &Text ! {} {
  let ignored := handle { apply(() => perform ask()) } with {
    ask(), k => k(42)
    return value => value
  }
  &holder.text
}
let holder := Holder { text: "kept" }
let &text := select(&holder)
perform show("value", clone(text))
```
types = "ok"
rows = "ok"
lin = "ok"
shows = ['value = "kept"']

@ cases.borrowed-sync-callback-survives-locally-handled-suspension
source = ```nib
effect ask(): i64
