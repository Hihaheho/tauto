@ cases.suspending-callback-capturing-borrowed-record-copies-it
source = ```nib
effect ask(): i64
struct Holder { text: Text }
fn apply<!e>(callback: () -> i64 ! e): i64 ! e { callback() }
fn select(&holder: Holder): &Text ! {} {
  let ignored := handle {
    apply(() => if holder.text == "kept" { perform ask() } else { 0 })
  } with {
    ask(), k => k(42)
    return value => value
  }
  &holder.text
}
let holder := Holder { text: "kept" }
let &text := select(&holder)
perform show("value", clone(text))
```
types = "ok"
rows = "ok"
lin = "ok"
shows = ['value = "kept"']

