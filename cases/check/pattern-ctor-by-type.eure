// A constructor written in a pattern by its short name is read as the
// constructor of that name of the matched value's type, when that type is
// written where the value is bound: two imported types may share
// constructor names, and the pattern still names one.

@ cases.a-pattern-constructor-is-the-one-of-the-matched-type
files."a.taut" = ```tauto
pub(open) inductive Fault: Type {
  Short: Fault
  Long: Fault
}
```
files."b.taut" = ```tauto
pub(open) inductive Error: Type {
  Short: Error
  Long: Error
  Odd: Error
}
```
files."main.nib" = ```tauto
import "a.taut"
import "b.taut"
fn code(f: Fault): Nat {
  ⊢ Nat from match f {
    Short => 1
    Long => 2
  }
}
fn ecode(e: Error): Nat {
  ⊢ Nat from match e {
    Short => 1
    Long => 2
    Odd => 3
  }
}
theorem code_short(): code(a.Short) = 1 { Refl }
theorem ecode_short(): ecode(b.Short) = 1 { Refl }
```
checks.code = "ok"
checks.ecode = "ok"
checks.code_short = "ok"
checks.ecode_short = "ok"

