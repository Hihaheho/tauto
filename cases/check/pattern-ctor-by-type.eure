@ cases.a-constructor-of-another-type-is-refused
files."a.taut" = ```tauto
pub(open) inductive Fault: Type {
  Short: Fault
  Long: Fault
}
```
files."b.taut" = ```tauto
pub(open) inductive Error: Type {
  Short: Error
  Long: Error
  Odd: Error
}
