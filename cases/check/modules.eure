@ cases.a-prelude-name-of-an-imported-file-of-a-dependency-tote-is-that-file-s
files_tote = "app"
files."app/Tauto.eure" = ```eure
package { name = "app" }
dependencies { lib { path = "../lib" } }
```
files."lib/Tauto.eure" = 'package { name = "lib" }'
files."lib/src/stmt.taut" = ```tauto
pub(open) enum Stmt { StExpr(Nat), StOther }
```
files."app/src/main.taut" = ```tauto
import "../../lib/src/stmt.taut"
fn one(n: Nat): List(Stmt) { Cons(StExpr(n), Nil) }
fn first(xs: List(Stmt)): Nat {
  match xs {
    Cons(StExpr(n), rest) => n
    Cons(StOther, rest) => 0
    Nil => 0
  }
}
perform show("p", first(one(3)))
```
shows = ["p = 3"]

