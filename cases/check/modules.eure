@ cases.an-imported-enum-named-prop-does-not-hide-the-sort
files."a.taut" = `enum Prop(P: Type) { Static(P) }`
files."b.taut" = ```tauto
fn Model(B: (Nat) -> Prop, n: Nat): (Nat) -> Prop {
  ⊢ (Nat) -> Prop from match n {
    Zero => B
    Succ(k) => Model((m: Nat) => B(Succ(m)), k)
  }
}
fn InModel(n: Nat, f: Nat): Prop {
  Model((g: Nat) => g = 0, n)(f)
}
```
files."main.taut" = ```tauto
import "a.taut"
import "b.taut"
theorem t(): Eq(Nat, 1, 1) { Refl }
```
entry = "main.taut"
checks_all = "ok"

