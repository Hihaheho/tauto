@ cases.the-wanted-type-picks-a-constructor-two-imported-files-declare
files."p/a.taut" = `pub(open) inductive E: Type { Oops: E }`
files."q/b.taut" = `pub(open) inductive F: Type { Oops: F }`
files."main.nib" = ```tauto
import "q/b.taut"
import "p/a.taut"
fn f(): F { Oops }
fn e(): E {
  let x: E := Oops
  x
}
fn pick(y: Bool): F { if y { Oops } else { Oops } }
fn back(x: E): F {
  ⊢ F from match x {
    Oops => Oops
  }
}
```
checks_all = "ok"

