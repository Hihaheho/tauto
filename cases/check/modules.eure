pub fn get(): St { st_a() }
```
files."app/src/main.taut" = ```tauto
fn run(): Nat {
  match get() {
    StB(n) => n
    StA => 7
  }
}
perform show("p", run())
```
load_error = "`StA` alone in this pattern binds a new variable, which matches every value, but `StA` is a constructor of `St`, which this file does not import: import the file that declares it to match the constructor, or to bind the value write a name that is not a constructor, like `stA_`"

@ cases.a-constructor-a-file-imports-is-matched-in-a-pattern
files_tote = "app"
files."app/Tauto.eure" = ```eure
package { name = "app" }
dependencies { lib { path = "../lib" } }
```
files."lib/Tauto.eure" = 'package { name = "lib" }'
files."lib/src/st.taut" = ```tauto
pub(open) enum St { StA, StB(Nat) }
pub fn st_a(): St { StA }
```
files."app/src/get.taut" = ```tauto
import "../../lib/src/st.taut"
pub fn get(): St { st_a() }
```
files."app/src/main.taut" = ```tauto
import "../../lib/src/st.taut"
import "get.taut"
fn run(): Nat {
  match get() {
    StB(n) => n
    StA => 7
  }
}
perform show("p", run())
```
shows = ["p = 7"]

// A type the prelude has the name of is renamed; a module of the same name
// is not, and `Bytes::size` still names its function, in its file and in
// one that imports it.
@ cases.a-module-named-as-a-renamed-type-keeps-its-functions
files."a.taut" = ```tauto
pub(open) inductive Bytes: Type {
  Mk(n: Nat): Bytes
}
module Bytes {
  pub fn size(b: Bytes): Nat {
    ⊢ Nat from match b {
      Mk(n) => n
    }
  }
}
module Other {
  pub fn twice(b: Bytes): Nat { Bytes::size(b) + Bytes::size(b) }
}
```
files."main.nib" = ```tauto
import "a.taut"
theorem size_three(): Bytes::size(Bytes::Mk(3)) = 3 { Refl }
theorem twice_three(): Other::twice(Bytes::Mk(3)) = 6 { Refl }
```
checks."main.nib::size_three" = "ok"
checks."main.nib::twice_three" = "ok"

// `M::P { x: 1 }` is the struct literal of the struct `M` declares, as the pattern
// `M::P { x }` matches it, and `..b` takes its other fields.
@ cases.a-struct-a-module-declares-is-written-with-its-module
files."main.nib" = ```tauto
module M {
  pub(open) inductive struct P { x: Nat, y: Nat }
}
fn x_of(p: M::P): Nat {
  match p {
    M::P { x, y: _ } => x
  }
}
fn base(): M::P { M::P { x: 1, y: 2 } }
fn moved(): M::P { M::P { x: 3, ..base() } }
fn pick(b: Bool): Nat {
  if b { x_of((M::P { x: 4, y: 0 })) } else { 0 }
}
theorem first(): x_of(M::P { x: 1, y: 2 }) = 1 { Refl }
theorem rest(): moved().y = 2 { Refl }
theorem cond(): pick(true) = 4 { Refl }
```
checks_all = "ok"

// A file sees its own declarations, the `pub` declarations of the files it imports directly and
// the prelude's: what an import imports is not seen through it.
@ cases.an-import-of-an-import-is-not-seen
files."a.taut" = `pub fn one(n: Nat): Nat { n }`
files."b.taut" = ```tauto
import "a.taut"
pub fn two(n: Nat): Nat { one(n) }
```
files."main.nib" = ```tauto
import "b.taut"
fn three(n: Nat): Nat { one(n) }
```
checks."main.nib::macro" = "error: `one` is declared by"

@ cases.a-file-the-program-reads-but-this-one-does-not-import-changes-nothing
files."a.taut" = `pub fn pick(n: Nat): Nat { n }`
files."other.taut" = `pub fn pick(n: Nat): Nat { 0 }`
files."side.taut" = ```tauto
import "other.taut"
pub fn side(n: Nat): Nat { pick(n) }
```
files."main.nib" = ```tauto
import "a.taut"
import "side.taut"
theorem t(): pick(1) = 1 { Refl }
```
checks."main.nib::t" = "ok"

@ cases.a-name-not-imported-is-not-found-in-another-file-of-the-program
files."a.taut" = `pub fn only(n: Nat): Nat { n }`
files."side.taut" = ```tauto
import "a.taut"
pub fn side(n: Nat): Nat { only(n) }
```
files."main.nib" = ```tauto
import "side.taut"
theorem t(): only(1) = 1 { Refl }
```
checks."main.nib::macro" = "error: `only` is declared by"

@ cases.a-type-two-imported-files-declare-is-ambiguous
files."a.taut" = `pub struct P { x: Nat }`
files."b.taut" = `pub struct P { x: Nat }`
files."main.nib" = ```tauto
