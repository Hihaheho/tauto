@ cases.a-parenthesized-comparison-is-the-left-of-an-equality-in-a-type
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::Base

fn lt_proof(i: Nat, n: Nat, q: (i < n) = true): (i < n) = true { q }

fn le_succ(i: Nat, n: Nat, q: (i <= n + 1) = true): (i <= n + 1) = true { q }

fn by_lambda(i: Nat, n: Nat): ((q: (i < n) = true) -> (i < n) = true) {
  (q: (i < n) = true) => q
}

theorem zero_lt_one(): (Zero < Succ(Zero)) = true { Refl }
```

checks_all = "ok"
checks."input/main.taut::lt_proof" = "ok"
checks."input/main.taut::le_succ" = "ok"
checks."input/main.taut::by_lambda" = "ok"
checks."input/main.taut::zero_lt_one" = "ok"

