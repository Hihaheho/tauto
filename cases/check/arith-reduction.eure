@ cases.nothing-is-below-zero-whatever-the-number-0
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::Base

theorem lt_zero(n: Nat): Nat::lt(n, Zero) = false { Refl }
theorem succ_le_zero(n: Nat): Nat::le(Succ(n), Zero) = false { Refl }
theorem zero_lt_succ(n: Nat): Nat::lt(Zero, Succ(n)) = true { Refl }
theorem succ_lt_succ(n: Nat, m: Nat): Nat::lt(Succ(n), Succ(m)) = Nat::lt(n, m) { Refl }
```

checks_all = "ok"
