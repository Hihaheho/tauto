@ cases.plus-and-times-compute-on-their-second-operand-0
imports = [path`../../examples/nat/Order.taut`, path`../../examples/nat/Lib.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

theorem plus_zero(n: Nat): n + 0 = n { Refl }
theorem plus_succ(n: Nat, m: Nat): n + Succ(m) = Succ(n + m) { Refl }
theorem plus_numeral(n: Nat): n + 2 = Succ(Succ(n)) { Refl }
theorem times_zero(n: Nat): n * 0 = 0 { Refl }
theorem times_succ(n: Nat, m: Nat): n * Succ(m) = n * m + n { Refl }
theorem numerals(n: Nat): 2 + 3 * 4 = 14 { Refl }
```

