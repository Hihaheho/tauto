@ cases.host-result-keeps-generic-callback-boundaries
source = ```tauto
effect ask(): Text resume ω
struct Holder(A: Type) { run: (A) -> Text ! {} }
extern { fn make(): Holder(() -> Text ! {ask}) }
let holder := make()
let result := holder.run(() => perform ask())
```
