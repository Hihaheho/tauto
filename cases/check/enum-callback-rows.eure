@ cases.a-hashmap-of-functions-keeps-their-row
source = ```nib
import std::prelude::Affine
import std::prelude::Os

fn hi(): i64 ! {stdout} {
  perform stdout("hi")
  1
}
fn call(&m: HashMap(i64, () -> i64 ! {stdout}), k: i64): i64 ! {stdout} {
  match HashMap::get(&m, &k) {
    None => 0
    Some(f) => f()
  }
}
var m: HashMap(i64, () -> i64 ! {stdout}) := HashMap::new()
let old := HashMap::insert(&mut m, 1, hi)
perform show("n", call(&m, 1))
```
backends = ["rust", "javascript"]
types = "ok"
rows = "ok"
shows = ["n = 1"]

@ cases.a-hashmap-of-pure-functions
source = ```nib
import std::prelude::Affine

fn find(&m: HashMap(u64, (x: i64) -> i64), w: u64): Option((x: i64) -> i64) {
  match HashMap::get(&m, &w) {
    None => None
    Some(f) => Some(f)
  }
}
var m: HashMap(u64, (x: i64) -> i64) := HashMap::new()
let old := HashMap::insert(&mut m, 1, (x: i64) => x + 1)
match find(&m, 1) {
  None => perform show("n", 0)
  Some(f) => perform show("n", f(41))
}
```
backends = ["rust", "javascript"]
types = "ok"
rows = "ok"
shows = ["n = 42"]

@ cases.a-callable-field-read-out-of-a-hashmap-keeps-its-row
source = ```nib
import std::prelude::Affine
import std::prelude::Os

fn hi(): i64 ! {stdout} {
  perform stdout("hi")
  1
}
affine struct Watcher { run: () -> i64 ! {stdout} }
fn call(&m: HashMap(u64, Option(Watcher)), k: u64): i64 ! {stdout} {
  let f := match HashMap::get(&m, &k) {
    None => None
    Some(o) => match o {
      None => None
      Some(w) => Some(w.run)
    }
  }
  match f {
    None => 0
    Some(g) => g()
  }
}
var m: HashMap(u64, Option(Watcher)) := HashMap::new()
let old := HashMap::insert(&mut m, 1, Some(Watcher { run: hi }))
perform show("n", call(&m, 1))
```
types = "ok"
rows = "ok"
shows = ["n = 1"]

@ cases.a-mutex-callback-is-given-what-the-mutex-holds
source = ```nib
import std::prelude::Affine
import std::prelude::Os
import std::prelude::Par

fn hi(): i64 ! {stdout} {
  perform stdout("hi")
  1
}
affine struct Watcher { run: () -> i64 ! {stdout} }
fn call(held: Mutex(HashMap(u64, Watcher)), k: u64): i64 ! {stdout, wait} {
  let f := {
    let g := Mutex::lock(held)
    let &m := MutexGuard::get(&g)
    match HashMap::get(&m, &k) {
      None => None
      Some(w) => Some(w.run)
    }
  }
  match f {
    None => 0
    Some(g) => g()
  }
}
var m: HashMap(u64, Watcher) := HashMap::new()
let old := HashMap::insert(&mut m, 1, Watcher { run: hi })
perform show("n", call(Mutex::new(m), 1))
```
types = "ok"
rows = "ok"
shows = ["n = 1"]

@ cases.a-none-branch-does-not-hide-the-other-branchs-row
source = ```nib
fn hi(): i64 ! {stdout} {
  perform stdout("hi")
  1
}
fn call(b: Bool): i64 ! {} {
  let f := if b { None } else { Some(hi) }
  match f {
    None => 0
    Some(g) => g()
  }
}
perform show("n", call(false))
```
types = "ok"
rows = "error: may perform stdout"

