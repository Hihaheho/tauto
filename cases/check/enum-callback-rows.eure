rows = "error: cannot follow the effects of calling `holder.run`"

@ cases.distinct-symbolic-rows-are-inferred-independently
// The row analysis is independent of the value type checker's generic inference.
source = ```tauto
enum Reader(!e) { Read(() -> Text ! e) }
struct Inputs(!a, !b) { first: Reader(a), second: Reader(b) }
fn read<!e: direct>(value: Reader(e)): Text ! e {
  match value { Read(callback) => callback() }
}
fn second<!a: direct, !b: direct>(value: Inputs(a, b)): Text ! b {
  read(value.second)
}
fn forward<!x: direct, !y: direct>(value: Inputs(x, y)): Text ! y {
  second(value)
}
```
rows = "ok"

// Functions in the type arguments of a generic type keep their written
// row: what is put in must fit it, and what is taken out performs it.
@ cases.a-list-of-functions-keeps-their-row
source = ```nib
import std::prelude::Os

fn hi(): i64 ! {stdout} {
  perform stdout("hi")
  1
}
fn run_all(fs: List(() -> i64 ! {stdout})): i64 ! {stdout} {
  match fs {
    Nil => 0
    Cons(f, rest) => f() + run_all(rest)
  }
}
perform show("n", run_all([() => 2, hi, hi]))
```
backends = ["rust", "javascript"]
types = "ok"
rows = "ok"
lin = "ok"
shows = ["n = 4"]

