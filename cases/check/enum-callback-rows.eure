@ cases.qualified-constructor-alias
source = ```tauto
effect ask(): Text direct
enum Reader(!e) { Read(() -> Text ! e) }
fn read<!e: direct>(value: Reader(e)): Text ! e {
  match value { Read(callback) => callback() }
}
let make := Reader::Read
let result := handle { read(make(() => perform ask())) } with {
  ask(), k => k("alias")
  return text => text
}
perform show("value", result)
```
types = "ok"
rows = "ok"
lin = "ok"
shows = ["value = \"alias\""]
backend_known_failure.rust = "unsupported: the constructor `Reader::Read` used as a function"
