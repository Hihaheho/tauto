@ cases.ambient-row-is-forwarded
source = ```tauto
effect ask(): Text direct
enum Reader(!e) { Read(() -> Text ! e) }
fn read<!e: direct>(value: Reader(e)): Text ! e {
  match value { Read(callback) => callback() }
}
fn forward<!e: direct>(value: Reader(e)): Text ! e { read(value) }
let result := handle { forward(Read(() => perform ask())) } with {
  ask(), k => k("forwarded")
  return text => text
}
perform show("value", result)
```
types = "ok"
rows = "ok"
lin = "ok"
shows = ["value = \"forwarded\""]
