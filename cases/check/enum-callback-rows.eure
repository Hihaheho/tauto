@ cases.unknown-generic-answer-stays-unknown
source = ```tauto
effect get<A>(value: A): A
enum Box(A: Type) { Held(A) }
let result := handle {
  let value := perform get(Held(() => "ok"))
  match value { Held(callback) => callback() }
} with {
  ∀ A. get<A>(value), k => k(value)
  return text => text
}
```
types = "ok"
rows = "error: cannot follow the effects of calling `callback`"

