@ cases.concrete-payload
source = ```tauto
effect ask(): Text direct
enum Reader { Read(() -> Text ! {ask}) }
fn read(value: Reader): Text ! {ask} {
  match value { Read(callback) => callback() }
}
let result := handle { read(Read(() => perform ask())) } with {
  ask(), k => k("handled")
  return text => text
}
perform show("value", result)
```
types = "ok"
rows = "ok"
lin = "ok"
shows = ["value = \"handled\""]

@ cases.generic-row-and-alternatives
source = ```tauto
effect ask(): Text direct
enum Reader(!e) { Read(() -> Text ! e), Empty }
fn read<!e: direct>(value: Reader(e)): Text ! e {
  match value { Read(callback) => callback(), Empty => "empty" }
}
let result := handle { read(Read(() => perform ask())) } with {
  ask(), k => k("generic")
  return text => text
}
perform show("value", result)
```
types = "ok"
rows = "ok"
lin = "ok"
shows = ["value = \"generic\""]
// Effect-only enum parameters do not have a Rust data representation.
rust = "skip: eval-only"

