@ cases.recursive-enum-keeps-scalar-arguments
source = ```tauto
enum Tree(A: Type) { Leaf(A, () -> Text ! {}), Branch(Tree(A), Tree(A)) }
let value: Tree(u64) := Leaf(1, () => "Leaf")
let result := match value {
  Leaf(number, callback) => callback()
  Branch(left, right) => "branch"
}
perform show("value", result)
```
types = "ok"
rows = "ok"
lin = "ok"
shows = ["value = \"Leaf\""]

@ cases.expanding-recursion-does-not-expand-contracts
source = ```tauto
struct Pair(A: Type, B: Type) { first: A, second: B }
enum Grow(A: Type) { Next(Grow(Pair(A, A))), Callback(() -> Text ! {}) }
fn identity(value: Grow(u64)): Grow(u64) ! {} { value }
```
