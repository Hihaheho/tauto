// Functions with effects read as computation trees in proofs.

@ cases.handler-proofs-example
source = path`../../examples/handler-proofs.taut`
checks_all = "ok"

@ cases.a-wrong-handled-result-is-rejected
source = ```tauto
effect tick(n: Nat): Nat

fn twice(x: Nat): Nat ! {tick} {
  let a := perform tick(x)
  let b := perform tick(a)
  Succ(b)
}

fn count(x: Nat): Nat {
  handle { twice(x) } with {
    tick(n), k => k(Succ(n))
  }
}

theorem right(x: Nat): count(x) = Succ(Succ(Succ(x))) { Refl }
theorem wrong(x: Nat): count(x) = Succ(Succ(x)) { Refl }
```
checks.right = "ok"
checks.wrong = "error: type mismatch"

@ cases.a-call-in-a-smaller-row-is-forwarded
source = ```tauto
effect tick(n: Nat): Nat
effect emit(x: Nat): Unit

fn bump(x: Nat): Nat ! {tick} {
  perform tick(x)
}

fn bump_emit(x: Nat): Unit ! {emit, tick} {
  perform emit(bump(x))
}

fn emitted(x: Nat): Nat {
  var last: Nat := Zero
  handle { bump_emit(x) } with {
    emit(y), k => {
      last := y
      k(Star)
    }
    tick(n), k => k(Succ(Succ(n)))
  }
  last
}

theorem emitted_is(x: Nat): emitted(x) = Succ(Succ(x)) { Refl }
```
checks_all = "ok"

@ cases.an-effect-of-executable-types-is-not-read
source = ```tauto
effect ask(n: i64): i64

fn asked(x: i64): i64 ! {ask} {
  perform ask(x)
}
```
checks.asked = "skipped"

// With the import, `i64` is the kernel's `SInt(64)`: the effect is read and the
// handler proved as written.
@ cases.an-effect-of-machine-integers-is-read-with-their-module
extract = true
source = ```tauto
import std::sint

effect ask(n: i64): i64

fn asked(x: i64): i64 ! {ask} {
  perform ask(x)
}

fn answered(x: i64, y: i64): i64 {
  handle { asked(x) } with {
    ask(n), k => k(y)
  }
}

theorem answered_is(x: SInt(64), y: SInt(64)): answered(x, y) = y { Refl }

// A number at `i64` is the kernel's `SInt::mk64(1, Refl)`: it is checked.
fn one(): i64 { 1 }
```
checks.asked = "checked"
checks.answered = "checked"
checks.answered_is = "ok"
checks.one = "ok"

