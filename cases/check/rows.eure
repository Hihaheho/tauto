// `rows`: "ok" or "error: <part of the message>" from the effect-row check.

@ cases.a-written-row-must-hold-the-body
parses = true
source = ```nib
effect ask(q: i64): i64
fn f(): i64 ! {} { perform ask(1) }
```
rows = "error: may perform ask"

@ cases.a-handler-answers-the-effect
parses = true
source = ```nib
effect ask(q: i64): i64
fn f(): i64 ! {ask} { perform ask(1) }
let r := handle { f() } with {
  ask(q), k => k(q)
  return v => v
}
```
rows = "ok"

@ cases.budget-leaves-exceeded
parses = true
source = ```nib
fn spin(): i64 ! {div} {
  while true { }
  0
}
let d := perform budget(10, () => { spin() })
```
rows = "error: unhandled effect exceeded"

@ cases.an-extern-has-no-row
source = ```nib
struct(affine) File {}
effect io_error(): Never resume 0
extern {
  fn file_open(path: &Text): File ! {io_error}
}
```
rows = "error: an extern can perform only wait; wrap other effects in a tauto function"

@ cases.an-extern-may-wait-on-the-host
source = ```nib
import std::builtin::par
extern {
  fn host_sleep(ms: u64): Bool ! {wait}
}
fn start(): Bool ! {wait} { host_sleep(10) }
```
rows = "ok"

@ cases.a-waiting-extern-shows-in-the-caller-row
source = ```nib
import std::builtin::par
extern {
  fn host_sleep(ms: u64): Bool ! {wait}
}
fn start(): Bool ! {} { host_sleep(10) }
```
rows = "error: may perform wait"

@ cases.a-waiting-extern-is-not-called-in-a-direct-arm
source = ```nib
import std::builtin::par
effect ask(): Bool direct
extern {
  fn host_sleep(ms: u64): Bool ! {wait}
}
fn go(): Bool ! {wait} {
  handle { perform ask() } with { ask(), k => k(host_sleep(1)) }
}
```
rows = "error: the arm of ask performs wait, which is not direct"

@ cases.a-closure-for-an-extern-cannot-suspend
source = ```nib
effect ask(): i64
extern {
  fn each_byte(f: &((n: i64) -> Unit)): Unit
}
fn go(): Unit ! {ask} {
  each_byte((n) => { perform ask() })
}
```
rows = "error: a closure passed to an extern cannot perform ask, which may suspend"

@ cases.a-direct-closure-for-an-extern-is-fine
source = ```nib
effect log(t: Text): Unit direct
extern {
  fn each_byte(f: &((n: i64) -> Unit)): Unit
}
fn go(): Unit ! {log} {
  each_byte((n) => { perform log("x") })
}
```
rows = "ok"
build = "error: has no rust binding"
