@ cases.instance-infer-independent-nested-call
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, I: Type) { fn choose(value: A): I }
inductive class Nested(A: Type, I: Type) { fn get(value: A): I }
instance Choose(Local, Nat) infer from A {
  fn choose(value: Local): Nat { 3 }
}
instance Nested(Local, Nat) infer from A {
  fn get(value: Local): Nat { 4 }
}
fn outer<A: Type, I: Type>(value: A, unrelated: Nat): I where Choose(A, I) {
  Choose::choose(value)
}
fn test(): Nat {
  let result := outer(Local::Mk, Nested::get(Local::Mk))
  result
}
```
checks_all = "ok"
differential = "elaborator"

@ cases.instance-infer-default-and-specific
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, S: Type, I: Type) { fn choose(value: A, state: S): I }
instance Choose(Local, Nat, Nat) infer from A {
  fn choose(value: Local, state: Nat): Nat { 3 }
}
instance Choose(Local, Bool, Bool) infer from A ∧ S {
  fn choose(value: Local, state: Bool): Bool { true }
}
fn use_nat(value: Local, state: Nat): Nat {
  let result := Choose::choose(value, state)
  result
}
fn use_bool(value: Local, state: Bool): Bool {
  let result := Choose::choose(value, state)
  result
}
```
checks_all = "ok"

