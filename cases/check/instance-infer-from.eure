@ cases.instance-infer-does-not-chain
extract = false
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Local: Type { Mk: Local }
inductive Middle: Type { Mk: Middle }
inductive class First(A: Type, I: Type) { fn get(value: A): I }
inductive class Second(I: Type, R: Type) { fn make(value: I): R }
instance First(Local, Middle) infer from A {
  fn get(value: Local): Middle { Middle::Mk }
}
instance Second(Middle, Nat) infer from I {
  fn make(value: Middle): Nat { 5 }
}
fn build<A: Type, I: Type, R: Type>(value: A): R where First(A, I), Second(I, R) {
  Second::make(<I: I, R: R>, First::get(<A: A, I: I>, value))
}
fn consume<T: Type>(value: T): Nat { 0 }
fn test(): Nat {
  let result := build(Local::Mk)
  consume(result)
}
```
checks_all = "ok"
checks."input/main.taut::build" = "ok"
checks."input/main.taut::test" = "error: cannot infer"
differential = "elaborator"

@ cases.instance-infer-with-known-value-parameter
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, n: Nat, I: Type) { fn choose(value: A): I }
instance Choose(Local, 2, Bool) infer from A {
  fn choose(value: Local): Bool { true }
}
fn use<A: Type, I: Type>(value: A): I where Choose(A, 2, I) {
  Choose::choose(<A: A, n: 2, I: I>, value)
}
fn test(): Bool {
  let result := use(Local::Mk)
  result
}
```
checks_all = "ok"
differential = "elaborator"

