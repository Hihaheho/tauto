description = "An instance's infer from condition determines only type arguments justified by ordinary matching."

@ cases.instance-infer-from-owned-type
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, I: Type) { fn choose(value: A): I }
instance Choose(Local, Nat) infer from A {
  fn choose(value: Local): Nat { 3 }
}
fn use(value: Local): Nat {
  let result := Choose::choose(value)
  result
}
```
checks_all = "ok"

