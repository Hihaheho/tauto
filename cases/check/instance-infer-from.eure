@ cases.instance-infer-from-expected-argument
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, I: Type) { fn make(): I }
instance Choose(Local, Nat) infer from A {
  fn make(): Nat { 3 }
}
fn accept(value: Local, number: Nat): Nat { number }
fn make<A: Type, I: Type>(value: A): I where Choose(A, I) {
  Choose::make(<A: A, I: I>)
}
fn use(value: Local): Nat {
  let result := make(value)
  accept(value, result)
}
```
checks_all = "ok"

@ cases.instance-infer-does-not-fill-value-parameter
extract = false
imports = [path`../../std/base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, n: Nat) { fn choose(value: A): Nat }
instance Choose(Local, 2) infer from A {
  fn choose(value: Local): Nat { 3 }
}
fn use<A: Type, n: Nat>(value: A): Nat where Choose(A, n) {
  Choose::choose(<A: A, n: n>, value)
}
fn test(): Nat { use(Local::Mk) }
```
checks_all = "ok"
checks."input/main.taut::use" = "ok"
checks."input/main.taut::test" = "error: infer from does not determine all required type arguments"
