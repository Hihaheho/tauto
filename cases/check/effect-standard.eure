description = "The standard effects read in proofs: a file that imports `std::os` has its functions that perform `stdout`, `stdin`, the clocks and the like read as computation trees, and a handler states what a host answers."

@ cases.a-handler-stands-for-the-host
source = ```tauto
import std::os
import std::text
import std::builtin::os

fn greet(): Unit ! {stdout} {
  perform stdout("hi")
  perform stdout("there")
}

fn last_of(): Text {
  var last: Text := ""
  handle { greet() } with {
    stdout(t), k => {
      last := t
      k(Star)
    }
  }
  last
}

theorem last_is(): last_of() = "there" { Refl }

greet()
```
checks.greet = "checked"
checks.last_of = "checked"
checks.last_is = "ok"
stdout = "hithere"

// The host is the answers it gives, in order. A run that ends was given
// finitely many, so what holds for every list holds for that run.
@ cases.whatever-the-host-answers
extract = true
source = ```tauto
import std::os
import std::text
import std::builtin::os

fn ask_name(): Unit ! {stdin, stdout} {
  perform stdout("name?")
  let line := perform stdin()
  ⊢ Unit from match line {
    None => perform stdout("bye")
    Some(name) => {
      perform stdout(name)
      perform stdout("bye")
    }
  }
}

fn asked(answers: List(Option(Text))): List(Text) {
  var rest: List(Option(Text)) := answers
  var out: List(Text) := Nil
  handle { ask_name() } with {
    stdin(), k => {
      ⊢ Unit from match rest {
        Nil => k(None)
        Cons(a, more) => {
          rest := more
          k(a)
        }
      }
    }
    stdout(t), k => {
      out := Cons(t, out)
      k(Star)
    }
  }
  out
}

fn last_written(out: List(Text)): Option(Text) {
  ⊢ Option(Text) from match out {
    Nil => None
    Cons(t, more) => Some(t)
  }
}

theorem leaves_politely(answers: List(Option(Text))): last_written(asked(answers)) = Some("bye") {
  ⊢ last_written(asked(answers)) = Some("bye") from match answers {
    Nil => Refl
    Cons(a, more) => ⊢ last_written(asked(Cons(a, more))) = Some("bye") from match a {
      None => Refl
      Some(name) => Refl
    }
  }
}
```
checks.ask_name = "checked"
checks.asked = "checked"
checks.leaves_politely = "ok"

// `u64` is `UInt(64)` and `i64` is `SInt(64)` in the operation the kernel reads.
@ cases.machine-integers-are-their-models
extract = true
source = ```tauto
import std::os
import std::sint
import std::uint
import std::builtin::os

fn waited(ms: UInt(64)): SInt(64) ! {monotonic_clock, sleep} {
  perform sleep(ms)
  perform monotonic_clock()
}

fn at(ms: UInt(64), now: SInt(64)): SInt(64) {
  handle { waited(ms) } with {
    sleep(n), k => k(Star)
    monotonic_clock(), k => k(now)
  }
}

theorem at_is(ms: UInt(64), now: SInt(64)): at(ms, now) = now { Refl }
```
checks.waited = "checked"
checks.at_is = "ok"

