// The prelude's `IoError` and `FileStat` are families of the same shape, so
// a handler answers a file effect with any value of them.
@ cases.file-effects-answer-with-the-preludes-data
extract = true
source = ```tauto
import std::os
import std::text
import std::uint
import std::builtin::os

fn load(p: Text): Text ! {fs_read} {
  let r := perform fs_read(p)
  ⊢ Text from match r {
    Ok(t) => t
    Err(e) => ⊢ Text from match e {
      Denied(m) => "denied"
      Failed(m) => "failed"
      TimedOut => "timeout"
    }
  }
}

fn load_from(answer: Result(Text, IoError)): Text {
  handle { load("a.txt") } with {
    fs_read(p), k => k(answer)
  }
}

theorem denied_is_said(m: Text): load_from(Err(Denied(m))) = "denied" { Refl }
theorem content_is_returned(t: Text): load_from(Ok(t)) = t { Refl }

fn size_of(p: Text): Nat ! {fs_stat} {
  let r := perform fs_stat(p)
  ⊢ Nat from match r {
    Ok(o) => ⊢ Nat from match o {
      Some(s) => UInt::val64(s.size)
      None => 0
    }
    Err(e) => 0
  }
}

fn size_with(n: UInt(64)): Nat {
  handle { size_of("x") } with {
    fs_stat(p), k => k(Ok(Some(FileStat { kind: IsFile, size: n, modified_ms: n, executable: false })))
  }
}

theorem size_is(n: UInt(64)): size_with(n) = UInt::val64(n) { Refl }
```
checks.load = "checked"
checks.denied_is_said = "ok"
checks.content_is_returned = "ok"
checks.size_of = "checked"
checks.size_is = "ok"

// What a function writes, whatever it writes it for.
@ cases.a-function-writes-only-the-path-it-is-given
extract = true
source = ```tauto
import std::os
import std::text
import std::builtin::os

fn save(root: Text, name: Text, body: Text): Bool ! {env, fs_write} {
  let skip := perform env("SKIP")
  ⊢ Bool from match skip {
    Ok(v) => ⊢ Bool from match v {
      Some(s) => false
      None => {
        let r := perform fs_write(Text::concat(root, name), body)
        ⊢ Bool from match r {
          Ok(u) => true
          Err(e) => false
        }
      }
    }
    Err(e) => false
  }
}

fn written(root: Text, name: Text, body: Text): List(Text) {
  var paths: List(Text) := Nil
  handle { save(root, name, body) } with {
    env(n), k => k(Ok(None))
    fs_write(p, c), k => {
      paths := Cons(p, paths)
      k(Ok(Star))
    }
  }
  paths
}

theorem writes_one_path_under_root(
  root: Text,
  name: Text,
  body: Text
): written(root, name, body) = Cons(Text::concat(root, name), Nil) {
  Refl
}
```
checks.save = "checked"
checks.writes_one_path_under_root = "ok"

