@ cases.unreachable-payload-is-collected
imports = [path`../../meta/Memory.taut`]
source = ```tauto
def live0(n: Nat): Prop := n = Zero
def no_root(n: Nat): Prop := False
def no_edge(a: Nat, b: Nat): Prop := False
fn rank0(n: Nat): Nat { Zero }

theorem zero_count(): ZeroCount(Nat, live0, no_root, no_edge, Zero) {
  AndIntro(h => h, u => hu => he => he)
}
theorem collected(): HeapDrain(Nat, no_root, no_edge, live0, RemoveLive(Nat, live0, Zero)) {
  DrainFree(live0, RemoveLive(Nat, live0, Zero), Zero, Refl, zero_count(), DrainDone(RemoveLive(Nat, live0, Zero)))
}
theorem terminal(): HeapTerminal(Nat, RemoveLive(Nat, live0, Zero), no_root, no_edge) {
  v => hv => False::elim(And::right(hv)(And::left(hv)))
}
theorem exact(n: Nat): Iff(RemoveLive(Nat, live0, Zero, n), HeapReach(Nat, live0, no_root, no_edge, n)) {
  ranked_drain_exact(rank0, u => v => he => False::elim(he), collected(), terminal(), n)
}
```
