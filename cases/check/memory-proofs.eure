@ cases.unreachable-chain-is-collected
imports = [path`../../meta/Memory.taut`, path`../../std/WellFounded.taut`]
source = ```tauto
inductive Obj: Type {
  Left: Obj
  Right: Obj
}
inductive Edge: (Obj, Obj) -> Prop {
  Link: Edge(Left, Right)
}
def Live(v: Obj): Prop := True
def Root(v: Obj): Prop := False
def AfterLeft(v: Obj): Prop := RemoveLive(Obj, Live, Left, v)
def AfterBoth(v: Obj): Prop := RemoveLive(Obj, AfterLeft, Right, v)
fn rank(v: Obj): Nat {
  ⊢ Nat from match v {
    Left => Zero
    Right => Succ(Zero)
  }
}
theorem increasing<u: Obj, v: Obj>(h: Edge(u, v)): NatLt(rank(u), rank(v)) {
  ⊢ NatLt(rank(u), rank(v)) from match h {
    Link => Refl
  }
}
theorem no_incoming_left<u: Obj>(h: Edge(u, Left)): False {
  ⊢ False from match h {
  }
}
theorem right_zero<u: Obj>(h: Edge(u, Right), hl: AfterLeft(u)): False {
  ⊢ False from match h {
    Link => And::right(hl)(Refl)
  }
}
theorem terminal_node(v: Obj, h: AfterBoth(v)): Held(Obj, AfterBoth, Root, Edge, v) {
  ⊢ Held(Obj, AfterBoth, Root, Edge, v) from match v {
    Left => False::elim(And::right(And::left(h))(Refl))
    Right => False::elim(And::right(h)(Refl))
  }
}
theorem drained(): HeapDrain(Obj, Root, Edge, Live, AfterBoth) {
  DrainFree(Live, AfterBoth, Left, Trivial,
    AndIntro(h => h, u => hu => he => no_incoming_left(he)),
    DrainFree(AfterLeft, AfterBoth, Right,
      AndIntro(Trivial, e => Obj::noconf(False, Right, Left, e)),
      AndIntro(h => h, u => hu => he => right_zero(he, hu)),
      DrainDone(Obj, Root, Edge, AfterBoth)))
}
theorem exact(v: Obj): Iff(AfterBoth(v), HeapReach(Obj, Live, Root, Edge, v)) {
  ranked_drain_exact(rank, u => w => he => increasing(he), drained(), terminal_node, v)
}
```
