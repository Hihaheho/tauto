@ cases.cyclic-terminal-heap-has-no-rank
imports = [path`../../meta/Memory.taut`, path`../../std/WellFounded.taut`]
source = ```tauto
def live(n: Nat): Prop := True
def root(n: Nat): Prop := False
def edge(a: Nat, b: Nat): Prop := a = b

theorem terminal(): HeapTerminal(Nat, live, root, edge) {
  v => hv => HeldEdge(v, Trivial, Refl)
}
theorem no_rank(rank: (Nat) -> Nat,
  increasing: ∀ u: Nat. ∀ v: Nat. (edge(u, v)) -> NatLt(rank(u), rank(v))): False {
  ranked_edges_acyclic(edge, rank, increasing)(Zero, PathEdge(Nat, edge, Zero, Zero, Refl))
}
theorem no_reach<n: Nat>(h: HeapReach(Nat, live, root, edge, n)): False {
  ⊢ False from match h {
    ReachRoot(x, hl, hr) => hr
    ReachEdge(x, y, hx, hy, he) => no_reach(hx)
  }
}
```
