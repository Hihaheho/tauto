@ cases.root-and-child-survive
imports = [path`../../meta/Memory.taut`, path`../../std/WellFounded.taut`, path`../../std/Nat.taut`]
source = ```tauto
def all_live(n: Nat): Prop := True
def root0(n: Nat): Prop := n = Zero
def next_edge(a: Nat, b: Nat): Prop := b = Succ(a)
fn rank(n: Nat): Nat { n }

theorem increasing(u: Nat, v: Nat, h: next_edge(u, v)): NatLt(rank(u), rank(v)) {
  Eq::subst(z => NatLt(u, z), Eq::sym(h), Nat::le_refl(u))
}
theorem held(v: Nat): Held(Nat, all_live, root0, next_edge, v) {
  ⊢ Held(Nat, all_live, root0, next_edge, v) from match v {
    Zero => HeldRoot(Refl)
    Succ(k) => HeldEdge(k, Trivial, Refl)
  }
}
theorem terminal(): HeapTerminal(Nat, all_live, root0, next_edge) {
  v => hv => held(v)
}
theorem exact(n: Nat): Iff(all_live(n), HeapReach(Nat, all_live, root0, next_edge, n)) {
  ranked_drain_exact(rank, increasing, DrainDone(Nat, root0, next_edge, all_live), terminal(), n)
}
```
