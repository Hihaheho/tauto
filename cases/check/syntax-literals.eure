@ cases.options-repetitions-and-groups-0
entry = "syntax/main.taut"
files."syntax/main.taut" = ````tauto
import std::prelude::Macro

syntax!(lists, ```par
%start Doc
%title "lists"
%%
Doc: [ Head ] { Item } ( Bang | Tilde );
Head: KwHead Name;
Item: Name [ Colon Name ];
KwHead: 'head';
Name: /[a-z]+/;
Colon: ':';
Bang: '!';
Tilde: '~';
```) => struct Doc, enum Doc_Group1, struct Head, struct Item,
  struct Item_Opt1, fn parse
let d := lists`head x a:b c !`
perform show("d", d)
````
