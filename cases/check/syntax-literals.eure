@ cases.a-literal-is-the-typed-tree-0
entry = "syntax/main.taut"
files."syntax/main.taut" = ````tauto
import std::prelude::Macro

syntax!(math, ```par
%start Eqn
%title "math"
%%
Eqn: Sum Equals Sum;
Sum: Term { Plus Term };
Term: Num | Paren;
Paren: LParen Sum RParen;
Num: /[0-9]+/;
Equals: '=';
Plus: '+';
LParen: '(';
RParen: ')';
```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1, enum Term,
  fn parse
let e := math`1 + 2 = 3`
perform show("e", e)
````
