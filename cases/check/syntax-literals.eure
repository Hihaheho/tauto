@ cases.an-inductive-syntax-holds-an-embedded-expression-as-its-tree-0
entry = "syntax/main.taut"
diagnostics = []
files."syntax/main.taut" = ````tauto
import std::prelude::Macro
import std::SynTree
import std::Text
import std::Std

inductive_syntax!(math, ```par
%start Eqn
%title "math"
%%
Eqn: Sum Equals Sum;
Sum: Term { Plus Term };
Term: Num | Paren | Embed;
Paren: LParen Sum RParen;
Embed: TautoExpr;
Num: /[0-9]+/;
Equals: '=';
Plus: '+';
LParen: '(';
RParen: ')';
```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1, enum Term,
  fn parse, inductive Eqn::I, inductive Paren::I, inductive Sum::I, inductive Sum_Rep1::I, inductive Term::I,
  fn Eqn::to_i, fn Paren::to_i, fn Sum::to_i, fn Sum_Rep1::to_i, fn Term::to_i, fn Sum_Rep1_list::to_i

theorem embed_is_a_tree(e: SynExprI): math::Term::I { Embed_I(e) }
````
