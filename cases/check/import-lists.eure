@ cases.a-private-name-of-an-imported-file-does-not-shadow-the-prelude
differential_program = "elaborator"
description = "A declaration without `pub` is the file's own: a file that imports it does not see it, so the name means the prelude's `expect` there."
files."lib.taut" = ```tauto
pub fn one(): Nat { if helper(1) { 1 } else { 0 } }
fn expect(n: Nat): Bool { n == 1 }
fn helper(n: Nat): Bool { expect(n) }
```
files."main.taut" = ```tauto
import "lib.taut" { one }
pub fn check_one(): Unit ! {fail(Text)} { expect(one() == 1, "one") }
```
entry = "main.taut"
checks."main.taut::check_one" = "skipped"

@ cases.a-constructor-two-types-share-is-listed-by-its-type
description = "A constructor whose name two types of the imported file share is listed by the type it is matched against, as any constructor is: the list that writes `Mode` brings `Scheduled` of `Mode`."
files_tote = "app"
tote_errors = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/schedule.taut" = ```tauto
pub(open) enum Mode { Serial, Scheduled }
pub(open) enum Body { Scheduled(List(Nat)), Empty }
```
files."app/src/main.taut" = ```tauto
import "schedule.taut" { Mode }
pub fn bind(m: Mode): Nat { match m { Serial => 0, Scheduled => 1 } }
pub fn scheduled(): Mode { Mode::Scheduled }
```

@ cases.a-constructor-two-types-share-is-listed-by-its-type-in-a-dependency
description = "A file read as a dependency of a dependency is checked as it is at its own root: its constructor of a shared name, listed by its type, is accepted."
files_tote = "app"
tote_errors = []
files."app/Tauto.eure" = ```eure
package { name = "app" }
dependencies { engine { path = "../engine" } }
```
files."engine/Tauto.eure" = ```eure
package { name = "engine" }
dependencies { sched { path = "../sched" } }
```
files."sched/Tauto.eure" = 'package { name = "sched" }'
files."sched/src/schedule.taut" = ```tauto
pub(open) enum Mode { Serial, Scheduled }
pub(open) enum Body { Scheduled(List(Nat)), Empty }
```
files."sched/src/declaration.taut" = ```tauto
import "schedule.taut" { Mode }
pub fn bind(m: Mode): Nat { match m { Serial => 0, Scheduled => 1 } }
```
files."engine/src/engine.taut" = ```tauto
import sched::declaration { bind }
import sched::schedule { Mode }
pub fn run(): Nat { bind(Mode::Scheduled) }
```
files."app/src/main.taut" = ```tauto
import engine::engine { run }
pub fn go(): Nat { run() }
```
