@ cases.a-list-leaves-out-what-would-be-ambiguous
files."a.taut" = ```tauto
pub fn size(): Nat { 1 }
pub fn one(): Nat { 1 }
```
files."b.taut" = ```tauto
pub fn size(): Nat { 2 }
```
files."main.taut" = ```tauto
import "a.taut" { one }
import "b.taut" { size }
pub fn two(): Nat { size() }
pub fn also(): Nat { one() }
```
entry = "main.taut"
checks."main.taut::two" = "ok"

