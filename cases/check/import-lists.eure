@ cases.a-name-a-quote-writes-is-used-through-the-import
files."value.taut" = ```tauto
pub fn zero(): Nat { 0 }
pub fn one(): Nat { 1 }
```
files."main.nib" = ```tauto
import "value.taut" { one }
import std::builtin::macro { SynCtx, SynExpr, SynIdent, SynSpan }
pub macro fn z(e: SynExpr): SynExpr { quote { zero() } }
fn two(): Nat { one() }
```
checks.z = 'error: `zero` comes through `import "value.taut"`, whose list does not write it; write `zero` in its list'

