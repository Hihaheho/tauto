@ cases.a-listed-type-brings-its-constructors-while-another-file-has-a-constructor-of-its-name
entry = "main.taut"
files."pick.taut" = ```tauto
pub(open) enum Selected(A: Type, B: Type) { First(A), Second(B) }
pub fn pick(): Selected(Nat, Nat) { Second(2) }
```
files."attr.taut" = ```tauto
pub(open) enum Attr { Selected(Bool), Hidden(Bool) }
pub fn attr(): Attr { Hidden(true) }
```
files."a.taut" = ```tauto
import "pick.taut" { Selected, pick }
pub fn a(): Bool { match pick() { Second(_) => true, _ => false } }
```
files."main.taut" = ```tauto
import "attr.taut"
import "a.taut" { a }
pub fn b(): Bool { match attr() { Hidden(_) => a(), Selected(_) => a() } }
```
checks.a = "ok"
checks.b = "ok"
diagnostics = []

@ cases.a-list-names-the-module-whose-function-a-prelude-file-adds
