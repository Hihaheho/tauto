// A `match` written in an arm's goal `⊢ G from p` and in a nested match's result type is
// compiled as in a theorem statement, not rejected as a term the kernel does not read.
@ cases.a-match-in-an-arm-goal-and-a-motive-reads-as-in-a-statement-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
fn pick(a: Bool, b: Bool, c: Nat): Nat {
  ⊢ Nat from match a {
    false => ⊢ Nat from match b {
      false => c
      true => c
    }
    true => 1
  }
}
theorem in_goal(a: Bool, b: Bool, c: Nat): pick(a, b, c) = pick(a, b, c) {
  ⊢ pick(a, b, c) = pick(a, b, c) from match a {
    false => ⊢ (⊢ Nat from match b {
      false => c
      true => c
    }) = (⊢ Nat from match b {
      false => c
      true => c
    }) from match b {
      false => ⊢ c = c from Refl
      true => ⊢ c = c from Refl
    }
    true => Refl
  }
}
```

checks_all = "ok"
checks."input/main.taut::pick" = "ok"
checks."input/main.taut::in_goal" = "ok"
