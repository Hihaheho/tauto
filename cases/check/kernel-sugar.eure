checks."input/main.taut::in_goal" = "ok"

// `if c { a } else { b }` in a kernel term is `match c: T { true => a  false => b }`; `T` is
// the type expected there, or the type of the `then` branch, or of the `else` branch.
@ cases.an-if-in-a-kernel-term-is-a-match-on-bool-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
inductive Sym: Type {
  Pad: Sym
  Digit(n: Nat): Sym
}
inductive Opt(A: Type): Type {
  No: Opt(A)
  Yes(a: A): Opt(A)
}
inductive SymBack(c: Nat, o: Opt(Sym)): Prop {
  Any: SymBack(c, o)
}
fn pad_if(z: Bool): Opt(Sym) {
  ⊢ Opt(Sym) from match z {
    true => Yes(Pad)
    false => No
  }
}
theorem in_type(c: Nat, z: Bool): SymBack(c, if z { Yes(Pad) } else { No }) {
  Any
}
theorem else_typed(): if true { No } else { Yes(Pad) } = pad_if(false) {
  Refl
}
theorem in_proof(z: Bool, p: True): True {
  if z { p } else { Trivial }
}
```

