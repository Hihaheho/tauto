// `a == b` in a type reads as in a body: in a parameter's type, a `let` annotation and a
// match's result type.
@ cases.a-comparison-in-a-type-reads-as-in-a-body-0
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
theorem from_param(a: Nat, b: Nat, h: a == b = true): Nat::eq(a, b) = true {
  h
}
theorem in_result(a: Nat): a == a = true {
  Nat::eq_refl(a)
}
theorem in_let(a: Nat): Nat::eq(a, a) = true {
  let h: a == a = true := Nat::eq_refl(a)
  h
}
theorem in_goal(a: Nat, b: Bool): Nat::eq(a, a) = true {
  ⊢ a == a = true from match b {
    true => Nat::eq_refl(a)
    false => Nat::eq_refl(a)
  }
}
```

