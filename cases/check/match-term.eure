@ cases.the-term-is-put-for-the-matched-value-in-an-argument-where-a-function-shows-it-once-unfolded
files."Base.taut" = path`../../std/Base.taut`
files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
fn quote_as(p: Bool, l: List(Nat)): List(Nat) {
  ⊢ List(Nat) from match p {
    true => l
    false => Cons(34, l)
  }
}

fn plain(l: List(Nat)): Bool {
  ⊢ Bool from match l {
    Nil => true
    Cons(c, r) => Bool::and(Nat::eq(c, 34), plain(r))
  }
}

fn r#quote(l: List(Nat)): List(Nat) {
  quote_as(plain(l), l)
}

fn quote_step(s: Bool, next: (Bool) -> Nat): Nat {
  ⊢ Nat from match s {
    true => Succ(next(false))
    false => next(true)
  }
}

fn walk(s: Bool, l: List(Nat)): Nat {
  ⊢ Nat from match l {
    Nil => Zero
    Cons(c, r) => quote_step(s, (s2: Bool) => walk(s2, r))
  }
}

theorem quoted(
  l: List(Nat),
  x: List(Nat)
): walk(true, List::append(r#quote(l), x)) = walk(true, List::append(r#quote(l), x)) {
  ⊢ walk(true, List::append(r#quote(l), x)) = walk(true, List::append(r#quote(l), x)) from match plain(l) eqn e {
    true => ⊢ walk(true, List::append(l, x)) = walk(true, List::append(l, x)) from Refl
    false => ⊢ Succ(walk(false, List::append(l, x))) = Succ(walk(false, List::append(l, x))) from Refl
  }
}
```
checks_all = "ok"
checks.walk = "ok"
checks.quoted = "ok"

@ cases.the-term-is-put-for-the-matched-value-in-an-assumption-and-where-a-recursive-function-shows-it-once-unfolded
files."Base.taut" = path`../../std/Base.taut`
files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
fn step(o: Ordering, next: (Bool) -> Nat): Nat {
  ⊢ Nat from match o {
    Less => next(true)
    Equal => Zero
    Greater => Succ(next(false))
  }
}

fn count(f: (Nat) -> Ordering, s: Bool, l: List(Nat)): Nat {
  ⊢ Nat from match l {
    Nil => Zero
    Cons(c, r) => step(f(c), (s2: Bool) => count(f, s2, r))
  }
}

theorem unfolded(
  f: (Nat) -> Ordering,
  c: Nat,
  t: List(Nat),
  x: List(Nat),
  h: f(c) = f(c)
): count(f, true, List::append(Cons(c, t), x)) = count(f, true, List::append(Cons(c, t), x)) {
  (⊢ (f(c) = f(c)) -> (count(f, true, List::append(Cons(c, t), x)) = count(f, true, List::append(Cons(c, t), x))) from match f(c) eqn e {
    Less => ⊢ (Less = Less) -> (count(f, true, List::append(t, x)) = count(f, true, List::append(t, x))) from (hc: Less = Less) => Refl
    Equal => ⊢ (Equal = Equal) -> (Zero = Zero) from (hc: Equal = Equal) => Refl
    Greater => (hc: Greater = Greater) => Refl
  })(h)
}
```
checks_all = "ok"
checks.unfolded = "ok"

