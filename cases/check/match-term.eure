@ cases.a-match-on-a-term-is-convertible-with-the-same-match-in-a-function
files."main.nib" = ```tauto
fn pick(s: Bool, a: Nat, b: Nat): Nat {
  ⊢ Nat from match s {
    true => a
    false => b
  }
}
fn pick_inline(a: Nat, b: Nat): Nat {
  ⊢ Nat from match Nat::eq(a, a) {
    true => a
    false => b
  }
}
theorem factored(a: Nat, b: Nat): pick_inline(a, b) = pick(Nat::eq(a, a), a, b) {
  Refl
}
fn dep(s: Bool, h: s = true, n: Nat): Nat {
  ⊢ Nat from match s {
    true => n
    false => Zero
  }
}
theorem dep_true(n: Nat): dep(true, Refl(Bool, true), n) = n {
  Refl
}
```
checks_all = "ok"
checks.factored = "ok"
checks.dep_true = "ok"

@ cases.an-arm-written-with-the-goal-as-it-reads-is-checked-against-the-goal-not-unfolded
files."Base.taut" = path`../../std/Base.taut`
files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
fn put(f: (Nat) -> Nat, k: Nat, a: Nat): (Nat) -> Nat {
  (x: Nat) => ⊢ Nat from match Nat::eq(x, k) {
    true => a
    false => f(x)
  }
}
theorem put_hit(f: (Nat) -> Nat, k: Nat, a: Nat, x: Nat, e: Nat::eq(x, k) = true): put(f, k, a)(x) = a {
  ⊢ put(f, k, a)(x) = a from match Nat::eq(x, k) eqn e2 {
    true => Refl
    false => False::elim(false_ne_true(e))
  }
}
theorem kept(f: (Nat) -> Nat, k: Nat, a: Nat, x: Nat, m: Nat, h: put(f, k, a)(x) = m): put(f, k, a)(x) = m {
  (⊢ (∀ h2: put(f, k, a)(x) = m. Eq(Nat, put(f, k, a)(x), m)) from match Nat::eq(x, k) eqn e {
    true => (h2: put(f, k, a)(x) = m) => Eq::trans(Eq::trans(put_hit(f, k, a, x, e), Eq::sym(put_hit(f, k, a, x, e))), h2)
    false => (h2: put(f, k, a)(x) = m) => h2
  })(h)
}
```
checks_all = "ok"
checks.put_hit = "ok"
checks.kept = "ok"

@ cases.a-closed-part-of-the-goal-is-not-unfolded-to-find-the-matched-term
files."Base.taut" = path`../../std/Base.taut`
files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
fn spin(n: Nat): Nat {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(m) => spin(m)
  }
}

fn pick(a: Nat, f: (Nat) -> Ordering, n: Nat): Nat {
  ⊢ Nat from match f(n) {
    Less => a
    Equal => a
    Greater => a
  }
}

theorem closed(
  f: (Nat) -> Ordering,
  n: Nat
): pick(spin(200000), f, n) = pick(spin(200000), f, n) {
  ⊢ pick(spin(200000), f, n) = pick(spin(200000), f, n) from match f(n) eqn e {
    Less => Refl
    Equal => Refl
    Greater => Refl
  }
}
```
checks_all = "ok"
checks.spin = "ok"
checks.pick = "ok"
checks.closed = "ok"

