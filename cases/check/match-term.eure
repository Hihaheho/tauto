@ cases.the-equation-of-a-match-on-a-term-is-in-each-arm
files."Base.taut" = path`../../std/Base.taut`
files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
theorem via(
  f: (Nat) -> Ordering,
  g: (Nat) -> Ordering,
  n: Nat,
  h: g(n) = f(n)
): Or(g(n) = Less, Or(g(n) = Equal, g(n) = Greater)) {
  ⊢ Or(g(n) = Less, Or(g(n) = Equal, g(n) = Greater)) from match f(n) eqn e {
    Less => OrInl(h)
    Equal => OrInr(OrInl(h))
    Greater => OrInr(OrInr(h))
  }
}
```
checks_all = "ok"
checks.via = "ok"

@ cases.the-term-is-put-for-the-matched-value-where-a-function-shows-it-once-unfolded
files."Base.taut" = path`../../std/Base.taut`
files."Std.taut" = path`../../std/Std.taut`
files."main.nib" = ```tauto
import "Base.taut"
fn flag(f: (Nat) -> Ordering, n: Nat): Nat {
  ⊢ Nat from match f(n) {
    Less => 0
    Equal => 1
    Greater => 2
  }
}

theorem hidden(
  f: (Nat) -> Ordering,
  n: Nat
): Or(flag(f, n) = 0, Or(flag(f, n) = 1, flag(f, n) = 2)) {
  ⊢ Or(flag(f, n) = 0, Or(flag(f, n) = 1, flag(f, n) = 2)) from match f(n) eqn e {
    Less => ⊢ Or(Eq(Nat, 0, 0), Or(Eq(Nat, 0, 1), Eq(Nat, 0, 2))) from OrInl(Refl)
    Equal => OrInr(OrInl(Refl))
    Greater => OrInr(OrInr(Refl))
  }
}
```
checks_all = "ok"
checks.flag = "ok"
checks.hidden = "ok"

