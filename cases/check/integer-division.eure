@ cases.integer-slash-in-a-proof-points-to-the-named-functions
imports = [path`../../std/Base.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
theorem half(): 7 / 2 = 3 { Refl }
```

checks_all = "ok"
checks."input/main.taut::half" = "error: "
@ cases.integer-slash-in-a-proof-points-to-the-named-functions.diagnostics[]
file = "input/main.taut"
name = "half"
message = "`/` is the division of fractions, and the proofs do not define it on integers; write `Nat::div(a, b)`, `Nat::rem(a, b)`, `Int::tdiv`, `Int::tmod`, `Int::fdiv` or `Int::fmod` (and `U8::div`, `I32::tdiv`, … for the fixed widths), and `Rat::div` for fractions"
span = "«7 / 2»"
