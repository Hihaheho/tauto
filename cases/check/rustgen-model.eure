@ cases.closures-and-futures-have-explicit-environments
imports = [path`../../std/Base.taut`, path`../../totes/rustgen/model/core.taut`, path`../../totes/rustgen/model/store.taut`, path`../../totes/rustgen/model/control.taut`, path`../../totes/rustgen/model/semantics.taut`]
source = ```tauto
pub fn no_runtime_calls(): RsRuntime {
  RsRuntimeOf((name, args, heap, out, next, trace) => False)
}
pub theorem construct_once(): RsEval(
  Nil, no_runtime_calls(), Nil, RsLambda(RsFnOnce, 0, Nil, RsLit(RsUnit)),
  RsHeap(Nil), RsDone(RsHandle(0)), RsHeap(Cons(Some(RsClosure(RsFnOnce, 0, Nil, RsLit(RsUnit))), Nil)), Nil
) { RsEvalLambda(RsEvalsNil, Refl, Refl) }
pub theorem invoke_once_consumes_the_environment(): RsApply(
  Nil, no_runtime_calls(), RsHandle(0), Nil,
  RsHeap(Cons(Some(RsClosure(RsFnOnce, 0, Nil, RsLit(RsUnit))), Nil)),
  RsDone(RsScalar(RsUnit)), RsHeap(Cons(None, Nil)), Nil
) {
  RsApplyClosure(Refl, Refl, Refl, RsEvalLiteral, RsFunctionDone,
    RsCallCleanupFnOnce(RsPermutationNil), RsFinishNil)
}
pub theorem await_consumes_the_suspended_computation(): RsEval(
  Nil, no_runtime_calls(), Nil, RsAwait(RsFuture(Nil, RsLit(RsUnit))),
  RsHeap(Nil), RsDone(RsScalar(RsUnit)), RsHeap(Cons(None, Nil)), Nil
) {
  RsEvalAwait(RsEvalFuture(RsEvalsNil, Refl, Refl), Refl, RsEvalLiteral,
    RsFunctionDone, RsPermutationNil, RsFinishNil)
}
