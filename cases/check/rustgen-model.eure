@ cases.checked-integers-use-the-written-width
imports = [path`../../std/Base.taut`, path`../../std/Int.taut`, path`../../totes/rustgen/model/core.taut`, path`../../totes/rustgen/model/integer.taut`]
source = ```tauto

pub theorem signed_range(): rs_integer_fits(IntOfNat(127), true, 8) = true { Refl }
pub theorem signed_overflow(): rs_integer_fits(IntOfNat(128), true, 8) = false { Refl }
pub theorem signed_minimum(): rs_integer_fits(IntNegSucc(127), true, 8) = true { Refl }
pub theorem signed_underflow(): rs_integer_fits(IntNegSucc(128), true, 8) = false { Refl }
pub theorem unsigned_negative(): rs_integer_fits(IntNegSucc(0), false, 64) = false { Refl }
pub theorem checked_add(): rs_integer_binary(
  "add", RsInteger(IntOfNat(127), true, 8), RsInteger(IntOfNat(1), true, 8), RsHeap(Nil)
) = RsResultOf(RsPanic, RsHeap(Nil), Cons(RsFailure("integer-overflow"), Nil)) { Refl }
pub theorem checked_neg_minimum(): rs_integer_neg(
  RsInteger(IntNegSucc(127), true, 8), RsHeap(Nil)
) = RsResultOf(RsPanic, RsHeap(Nil), Cons(RsFailure("integer-overflow"), Nil)) { Refl }
pub theorem native_natural_subtraction_is_checked(): rs_natural_binary(
  "sub", 2, 3, RsHeap(Nil)
) = RsResultOf(RsPanic, RsHeap(Nil), Cons(RsFailure("integer-overflow"), Nil)) { Refl }
pub theorem native_naturals_do_not_overflow_u64(): rs_natural_binary(
  "add", 18446744073709551615, 1, RsHeap(Nil)
) = RsResultOf(RsDone(RsScalar(RsNatural(18446744073709551616))), RsHeap(Nil), Nil) { Refl }

