@ cases.guards-preview-before-committing-pattern-moves
imports = [path`../../std/Base.taut`, path`../../std/Int.taut`, path`../../totes/rustgen/model/core.taut`, path`../../totes/rustgen/model/pattern.taut`]
source = ```tauto

pub theorem preview_preserves_storage(): rs_match_at(
  RsPreview, RsHeap(Cons(Some(RsScalar(RsBool(true))), Nil)), RsBind(RsMove), RsAddr(0, Nil)
) = Some(#(Cons(RsScalar(RsBool(true)), Nil), RsHeap(Cons(Some(RsScalar(RsBool(true))), Nil)))) { Refl }
pub theorem commit_marks_the_source_moved(): rs_match_at(
  RsCommit, RsHeap(Cons(Some(RsScalar(RsBool(true))), Nil)), RsBind(RsMove), RsAddr(0, Nil)
) = Some(#(Cons(RsScalar(RsBool(true)), Nil), RsHeap(Cons(Some(RsUninitialized), Nil)))) { Refl }
pub theorem guard_binding_borrows_the_original_place(): rs_guard_prepare(
  RsHeap(Cons(Some(RsScalar(RsBool(true))), Nil)), RsBind(RsCopy), RsAddr(0, Nil)
) = Some(RsGuardScopeOf(Cons(RsAddr(0, Nil), Nil), Nil, RsHeap(Cons(Some(RsScalar(RsBool(true))), Nil)))) { Refl }
pub theorem wildcard_can_skip_an_already_moved_field(): rs_match_at(
  RsCommit, RsHeap(Cons(Some(RsData(7, false, Cons(RsUninitialized, Cons(RsScalar(RsBool(false)), Nil)))), Nil)),
  RsConstructor(7, Cons(RsIgnore, Cons(RsBind(RsCopy), Nil))), RsAddr(0, Nil)
) = Some(#(Cons(RsScalar(RsBool(false)), Nil), RsHeap(Cons(Some(RsData(7, false, Cons(RsUninitialized, Cons(RsScalar(RsBool(false)), Nil)))), Nil)))) { Refl }
pub theorem reference_pattern_preserves_the_source(): rs_match_at(
  RsCommit, RsHeap(Cons(Some(RsScalar(RsBool(true))), Nil)), RsBindReference(RsShared), RsAddr(0, Nil)
) = Some(#(Cons(RsReference(RsShared, RsAddr(0, Nil)), Nil), RsHeap(Cons(Some(RsScalar(RsBool(true))), Nil)))) { Refl }
```
