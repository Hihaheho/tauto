@ cases.source-trees-and-function-bodies-reach-the-operational-rules
imports = [path`../../std/Base.taut`, path`../../totes/rustgen/model/syntax.taut`, path`../../totes/rustgen/model/core.taut`, path`../../totes/rustgen/model/store.taut`, path`../../totes/rustgen/model/control.taut`, path`../../totes/rustgen/model/semantics.taut`, path`../../totes/rustgen/model/source_context.taut`, path`../../totes/rustgen/model/source_forms.taut`, path`../../totes/rustgen/model/source_construct.taut`, path`../../totes/rustgen/model/source_literals.taut`, path`../../totes/rustgen/model/source.taut`, path`../../totes/rustgen/model/program.taut`]
source = ```tauto
pub fn model_signature(): RsSourceSignature {
  RsSourceSignatureOf(
    Cons(RsSourceTypeOf(rs_source_type_name(Cons("bool", Nil)), RsCopy, None, Nil, None),
      Cons(RsSourceTypeOf(FunctionTy_I(rs::FunctionTy::I::Mk("fn", "(", rs::Types::I::Mk(None), ")", "->", rs::TupleTy::I::Mk("(", rs::Types::I::Mk(Some(rs::Types_Opt1::I::Mk(rs_source_type_name(Cons("bool", Nil)), Nil, None))), ")"))), RsCopy, None, Nil,
        Some(RsSourceCallOf(RsFn, Nil, 0))), Nil)),
    Cons(RsSourceFunctionOf(rs_source_path(Cons("entry", Nil)), 1), Nil),
    Nil, Nil, Nil, Nil, 64)
}
pub fn no_runtime_calls(): RsRuntime {
  RsRuntimeOf((name, args, heap, out, next, trace) => False)
}
pub theorem boolean_source_evaluation(): RsSourceEval(
  Nil, no_runtime_calls(), model_signature(), Nil, RsSourceControlOf(0, Nil),
  rs_source_bool(true), 0, Nil, RsHeap(Nil), RsDone(RsScalar(RsBool(true))), RsHeap(Nil), Nil
) {
  let literal_form: RsSourceLiteral(model_signature(), RsBool(true), 0, rs_source_bool(true)) := RsSourceBool(Refl)
  RsSourceEvaluated(Refl, RsRepresentsLiteral(literal_form), RsEvalLiteral)
}
pub theorem function_source_evaluation(): RsProgramRuns(
  model_signature(), no_runtime_calls(),
  rs::Program::I::Mk(Cons(rs::Item::I::Mk(None, None, Function_I(
    rs_source_function(model_signature(), "entry", rs::Generics::I::Mk(None), Nil, 0, rs_source_bool(true)))), Nil)),
  0, Nil, RsHeap(Nil), RsDone(RsScalar(RsBool(true))), RsHeap(Nil), Nil
) {
  let literal_form: RsSourceLiteral(model_signature(), RsBool(true), 0, rs_source_bool(true)) := RsSourceBool(Refl)
  let represented: RsRepresents(model_signature(), Nil, RsSourceControlOf(0, Nil), RsLit(RsBool(true)), 0, rs_source_bool(true)) := RsRepresentsLiteral(literal_form)
  RsProgramRan(
    RsSourceProgramOf(RsSourceBodiesFunction(None,
      RsSourceDefinitionOf(rs::Generics::I::Mk(None), Refl, Refl, Refl, Refl, represented),
      RsSourceBodiesNil(Refl))),
    RsApplyGlobal(Refl, Refl, Refl, RsEvalLiteral, RsFunctionDone, RsFinishNil))
}
```
checks.model_signature = "ok"
checks.no_runtime_calls = "ok"
checks.boolean_source_evaluation = "ok"
checks.function_source_evaluation = "ok"

@ cases.nested-destructors-retain-the-unwind-state
imports = [path`../../std/Base.taut`, path`../../std/Text.taut`, path`../../totes/rustgen/model/core.taut`, path`../../totes/rustgen/model/store.taut`, path`../../totes/rustgen/model/control.taut`]
source = ```tauto
pub(open) inductive PanicDrop: (Text, List(RsValue), RsStore, RsOutcome(RsValue), RsStore, List(RsEvent)) -> Prop {
  PanicDropFirst<heap: RsStore>: PanicDrop("drop_handle", Cons(RsScalar(RsBool(true)), Cons(RsHandle(0), Nil)), heap, RsPanic, heap, Cons(RsFailure("drop-first"), Nil))
}
pub theorem successful_drop_during_unwind_does_not_panic(): rs_destructor_result(true, RsDone(RsScalar(RsUnit))) = RsDone(RsScalar(RsUnit)) { Refl }
pub theorem completed_fields_resume_the_original_unwind(): rs_drop_completed(true, RsPanic) = RsDone(RsScalar(RsUnit)) { Refl }
pub theorem nested_normal_drop_preserves_the_original_panic(heap: RsStore): RsDrop(
  RsRuntimeOf(PanicDrop), true, RsData(9, false, Nil), heap, RsDone(RsScalar(RsUnit)), heap, Nil
) {
  let fields_dropped: RsFinish(RsRuntimeOf(PanicDrop), Nil, heap, RsPanic, RsPanic, heap, Nil) := RsFinishNil
  RsDropData(Refl, fields_dropped)
}
pub theorem nested_second_panic_skips_the_remaining_field(): RsDrop(
  RsRuntimeOf(PanicDrop), true, RsData(9, false, Cons(RsHandle(0), Cons(RsHandle(1), Nil))),
  RsHeap(Cons(Some(RsScalar(RsUnit)), Cons(Some(RsScalar(RsUnit)), Nil))), RsAbort, RsHeap(Cons(Some(RsScalar(RsUnit)), Cons(Some(RsScalar(RsUnit)), Cons(None, Cons(Some(RsHandle(1)), Nil))))), Cons(RsFailure("drop-first"), Nil)
) {
  let first_dropped: RsDrop(RsRuntimeOf(PanicDrop), true, RsHandle(0), RsHeap(Cons(Some(RsScalar(RsUnit)), Cons(Some(RsScalar(RsUnit)), Cons(None, Cons(Some(RsHandle(1)), Nil))))), RsAbort, RsHeap(Cons(Some(RsScalar(RsUnit)), Cons(Some(RsScalar(RsUnit)), Cons(None, Cons(Some(RsHandle(1)), Nil))))), Cons(RsFailure("drop-first"), Nil)) :=
    RsDropHandle(Refl, PanicDropFirst, RsDestructorPanic)
  let fields_dropped: RsFinish(
    RsRuntimeOf(PanicDrop), Cons(2, Cons(3, Nil)),
    RsHeap(Cons(Some(RsScalar(RsUnit)), Cons(Some(RsScalar(RsUnit)), Cons(Some(RsHandle(0)), Cons(Some(RsHandle(1)), Nil))))),
    RsPanic, RsAbort, RsHeap(Cons(Some(RsScalar(RsUnit)), Cons(Some(RsScalar(RsUnit)), Cons(None, Cons(Some(RsHandle(1)), Nil))))), Cons(RsFailure("drop-first"), Nil)
  ) := RsFinishValue(RsUnwindsPanic, Refl, Refl, first_dropped, RsFinishAbort)
  RsDropData(Refl, fields_dropped)
}
```
