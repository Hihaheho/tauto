@ cases.control-and-scope-exit-are-distinct
imports = [path`../../std/Base.taut`, path`../../std/Int.taut`, path`../../totes/rustgen/model/core.taut`, path`../../totes/rustgen/model/control.taut`, path`../../totes/rustgen/model/semantics.taut`]
source = ```tauto

pub fn no_runtime_calls(): RsRuntime {
  RsRuntimeOf((name, args, heap, out, next, trace) => False)
}
pub theorem short_circuit(): RsEval(
  Nil, no_runtime_calls(), Nil,
  RsIf(RsLit(RsBool(true)), RsLit(RsUnit), RsPrimitive("unreachable", Nil)),
  RsHeap(Nil), RsDone(RsScalar(RsUnit)), RsHeap(Nil), Nil
) { RsEvalIfTrue(RsEvalLiteral, RsEvalLiteral) }
pub theorem break_leaves_its_loop(): RsEval(
  Nil, no_runtime_calls(), Nil, RsLoop(4, RsBreak(4, RsLit(RsBool(true)))),
  RsHeap(Nil), RsDone(RsScalar(RsBool(true))), RsHeap(Nil), Nil
) { RsEvalLoopBreak(RsEvalBreak(RsEvalLiteral)) }
pub theorem exit_does_not_destroy_locals(): RsFinish(
  no_runtime_calls(), Cons(0, Nil), RsHeap(Cons(Some(RsHandle(1)), Nil)),
  RsExit(IntOfNat(7)), RsExit(IntOfNat(7)), RsHeap(Cons(Some(RsHandle(1)), Nil)), Nil
) { RsFinishExit }
pub theorem another_panic_during_unwinding_aborts(): rs_drop_panic(RsPanic) = RsAbort { Refl }
pub theorem unique_references_are_not_copyable(address: RsAddress,
  h: RsCopyable(RsReference(RsUnique, address))): False {
  ⊢ False from match h {}
}
