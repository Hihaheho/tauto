@ cases.partial-moves-preserve-other-fields-and-borrowed-addresses
imports = [path`../../std/Base.taut`, path`../../std/Int.taut`, path`../../totes/rustgen/model/core.taut`, path`../../totes/rustgen/model/store.taut`]
source = ```tauto

pub theorem partial_move(): rs_save(
  RsHeap(Cons(Some(RsData(7, false, Cons(RsScalar(RsBool(true)), Cons(RsScalar(RsBool(false)), Nil)))), Nil)),
  RsAddr(0, Cons(0, Nil)), RsUninitialized
) = Some(RsHeap(Cons(Some(RsData(7, false, Cons(RsUninitialized, Cons(RsScalar(RsBool(false)), Nil)))), Nil))) { Refl }
pub theorem moved_field_cannot_be_read(): rs_load(
  RsHeap(Cons(Some(RsData(7, false, Cons(RsUninitialized, Cons(RsScalar(RsBool(false)), Nil)))), Nil)),
  RsAddr(0, Cons(0, Nil))
) = None { Refl }
pub theorem another_field_remains_live(): rs_load(
  RsHeap(Cons(Some(RsData(7, false, Cons(RsUninitialized, Cons(RsScalar(RsBool(false)), Nil)))), Nil)),
  RsAddr(0, Cons(1, Nil))
) = Some(RsScalar(RsBool(false))) { Refl }
pub theorem incomplete_aggregate_cannot_be_read_as_a_whole(): rs_load(
  RsHeap(Cons(Some(RsData(7, false, Cons(RsUninitialized, Cons(RsScalar(RsBool(false)), Nil)))), Nil)),
  RsAddr(0, Nil)
) = None { Refl }
pub theorem released_storage_cannot_be_resurrected(): rs_save(
  RsHeap(Cons(None, Nil)), RsAddr(0, Nil), RsScalar(RsBool(true))
) = None { Refl }
pub theorem boxed_dereference_keeps_identity(): rs_address(
  Cons(RsAddr(1, Nil), Nil),
  RsHeap(Cons(Some(RsScalar(RsBool(true))), Cons(Some(RsHandle(0)), Nil))),
  RsDeref(RsLocal(0))
) = Some(RsAddr(0, Nil)) { Refl }
pub theorem dereference_keeps_identity(): rs_address(
  Cons(RsAddr(1, Nil), Nil),
  RsHeap(Cons(Some(RsScalar(RsBool(true))), Cons(Some(RsReference(RsUnique, RsAddr(0, Nil))), Nil))),
  RsDeref(RsLocal(0))
) = Some(RsAddr(0, Nil)) { Refl }
```
