@ cases.an-error-in-a-theorem-using-macros-is-placed-at-the-written-term-0.diagnostics[]
file = "input/main.taut"
name = "bad"
message = "type mismatch: expected `a + 1 = a`, found `a + 1 = a + 1`\n  differing part: expected `a`, found `a + 1`"
span = " «Refl» "

