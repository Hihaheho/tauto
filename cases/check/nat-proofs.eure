@ cases.an-error-in-a-theorem-using-macros-is-placed-at-the-written-term-0
imports = [path`../../examples/nat/More.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto

theorem bad(a: Nat): nat!(`${a} + 1 = ${a}`) { Refl }

theorem later(): Eq(Nat, 1, 1) {
  Refl
}
```

