@ cases.cannot-forge-addition
imports = [path`../../examples/stack-check/src/typing.taut`, path`../../examples/stack-check/src/machine.taut`]
source = ```tauto
theorem forged_add(): Typing(Exec(Add), Empty, NumOn(Empty)) {
  TExec(<op: Add, input: NumOn(NumOn(Empty)), output: NumOn(Empty)>, TAdd(<tail: Empty>))
}
```
checks.forged_add = "error: type mismatch"
