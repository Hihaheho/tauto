imports = [path`../../std/Std.taut`]
entry = "input/main.taut"
files."input/lib.taut" = ```tauto
import std::prelude::Macro

pub macro fn gen_again(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, Div} {
  ⊢ List(SynStmt) from match s {
    StInductive(d) => Cons(StInductive(d), Cons(StTheorem(SynTheorem {
        name: Syn::ident_like(d.name, "isz_proof")
        implicit: 0
        params: Nil
        ty: ExApp(ExVar(Syn::ident_like(d.name, "IsZ")), Cons(quote { Zero }, Nil), d.span)
        body: Some(ExVar(Syn::ident_like(d.name, "IszZero")))
        span: d.span
      }), Nil))
    _ => Nil
  }
}
```
