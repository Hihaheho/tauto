@ cases.an-output-that-is-not-definitionally-equal-breaks-the-use-0
imports = [path`../../std/Std.taut`]
entry = "input/main.nib"
files."input/lib.nib" = ```tauto
import std::prelude::Macro


pub fn is_const(c: Judgement, name: Text): Bool {
  match Judgement::open(c) {
    VConst(n) => n == name
    _ => false
  }
}

pub macro fn dzl(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(z, Cons(m, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") { Judgement::term(m) } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}

pub macro fn dzr(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") { Judgement::term(m) } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}
```
files."input/main.nib" = ```tauto
import "lib.nib"
theorem t2(n: Nat): plus(n, Zero) = plus(n, Zero) { Refl(Nat, dzr!(plus(n, Zero))) }
```
