@ cases.a-macro-is-not-run-in-the-file-that-declares-it-0
entry = "input/main.nib"
files."input/main.nib" = ````tauto
import std::prelude::Macro

syntax!(math, ```par
%start Eqn
%title "math"
%%
Eqn: Sum Equals Sum;
Sum: Term { Plus Term };
Term: Num | Paren;
Paren: LParen Sum RParen;
Num: /[0-9]+/;
Equals: '=';
Plus: '+';
LParen: '(';
RParen: ')';
```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1, enum Term,
  fn parse

fn math_term(t: math::Term): SynExpr ! {macro_error, Div} {
  match t {
    Num(tok) => Syn::nat(tok)
    Paren(p) => math_sum(p.sum)
  }
}

fn math_rest(acc: SynExpr, rest: List(math::Sum_Rep1)): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => {
      let t := math_term(r.term)
      math_rest(quote { $acc + $t }, more)
    }
  }
}

fn math_sum(s: math::Sum): SynExpr ! {macro_error, Div} {
  math_rest(math_term(s.term), s.rep)
}

macro fn math(e: math::Eqn): SynExpr ! {macro_error, Div} {
  let l := math_sum(e.sum)
  let r := math_sum(e.sum_2)
  quote { Eq(Nat, $l, $r) }
}

theorem t(): math!(`1 = 1`) { Refl(Nat, 1) }
````
