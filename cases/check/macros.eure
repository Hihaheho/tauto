@ cases.an-attribute-list-must-not-leave-out-what-the-macro-makes-0
imports = [path`../../std/Std.taut`]
entry = "input/main.taut"
files."input/lib.taut" = ```tauto
import std::prelude::Macro



pub macro fn gen_proof(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, Div} {
  ⊢ List(SynStmt) from match s {
    StInductive(d) => Cons(StTheorem(SynTheorem {
        name: Syn::ident_like(d.name, "isz_proof")
        implicit: 0
        params: Nil
        ty: ExApp(ExVar(Syn::ident_like(d.name, "IsZ")), Cons(quote { Zero }, Nil), d.span)
        body: Some(ExVar(Syn::ident_like(d.name, "IszZero")))
        span: d.span
      }), Nil)
    _ => Nil
  }
}
```
files."input/main.taut" = ```tauto
import "lib.taut"

@gen_proof!(0)
inductive IsZ: (Nat) -> Prop {
  IszZero: IsZ(Zero)
}

theorem t(): IsZ(Zero) { isz_proof }
```
