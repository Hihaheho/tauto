@ cases.a-proof-of-another-statement-is-rejected-0
imports = [path`../../std/Std.taut`]
entry = "input/main.nib"
files."input/lib.nib" = ```tauto
import std::prelude::Macro
import std::Std


pub theorem plus_n_zero(n: Nat): plus(n, Zero) = n {
  ⊢ plus(n, Zero) = n from match n {
    Zero => Refl(Nat, Zero)
    Succ(k) => Eq::congr(x => Succ(x), plus_n_zero(k))
  }
}

pub fn is_const(c: Judgement, name: Text): Bool {
  match Judgement::open(c) {
    VConst(n) => n == name
    _ => false
  }
}

pub macro fn simp0(c: Judgement): Proved ! {macro_error, elab} {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") {
        let mt := Judgement::term(m)
        Proved { term: mt, proof: quote { plus_n_zero($mt) } }
      } else { Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)") }
      _ => Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)")
    }
    _ => Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)")
  }
}

pub macro fn wrong0(c: Judgement): Proved ! {macro_error, elab} {
  Proved { term: quote { Zero }, proof: quote { Refl(Nat, Zero) } }
}
```
files."input/main.nib" = ```tauto
import "lib.nib"
fn f(n: Nat): Nat { wrong0!(plus(n, Zero)) }
```
