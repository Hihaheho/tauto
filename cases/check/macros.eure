@ cases.a-macro-finds-a-declaration-before-it-0
imports = [path`../../std/Std.taut`]
entry = "input/main.nib"
files."input/lib.nib" = ```tauto
import std::prelude::Macro


pub macro fn nf(c: Judgement): SynExpr ! {elab} { Judgement::term(Elab::whnf(c)) }

pub macro fn to_zero(c: Judgement): SynExpr ! {elab, macro_error} {
  match Elab::check(quote { Zero }, c, None) {
    Ok(z) => if Elab::defeq(c, z) { Judgement::term(z) } else { Judgement::term(c) }
    Err(d) => Syn::error(Judgement::span(c), "no zero")
  }
}

pub macro fn has_plus(c: Judgement): SynExpr ! {elab} {
  match Elab::global("plus") {
    Some(p) => quote { Zero }
    None => quote { Succ(Zero) }
  }
}
```
files."input/main.nib" = ```tauto
import "lib.nib"
theorem t(): Zero = Zero { Refl(Nat, has_plus!(Zero)) }
```
