entry = "input/main.taut"
files."input/lib.taut" = ```tauto
import std::prelude::Macro

pub macro fn gen_pred(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, Div} {
  ⊢ List(SynStmt) from match s {
    StInductive(d) => {
      let name := Syn::decl_name(d.name, "my_pred")
      quote stmts {
        theorem $name(n: Nat): Nat {
          ⊢ Nat from match n {
            Zero => Zero
            Succ(m) => m
          }
        }
      }
    }
    _ => Nil
  }
}
```
