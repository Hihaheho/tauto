@ cases.a-macro-function-rejects-a-constructor-of-another-type
entry = "input/main.nib"
files."input/lib.nib" = ```tauto
import std::prelude::Macro


pub(open) inductive Bx: Type { Mk(n: Nat): Bx }

pub fn peel(l: List(Text)): u64 ! {Div} {
  match l {
    Nil => 0
    Mk(a) => 1
  }
}

pub macro fn use_peel(e: SynExpr): SynExpr ! {macro_error, Div} {
  let k := peel(Nil)
  e
}
```
files."input/main.nib" = ```tauto
import "lib.nib"
theorem t(): use_peel!(Nat) { Zero }
```
