@ cases.a-macro-function-keeps-model-calls-separate-from-builtins
entry = "input/main.nib"
files."input/lib.nib" = ```tauto
import std::Text
import std::prelude::Macro

pub macro fn strip(e: SynExpr): SynExpr ! {macro_error, Div} {
  match e {
    ExVar(v) => {
      let t := v.name
      let n := Text::slice(t, 1, Text::len(t) - 1)
      e
    }
    _ => e
  }
}
```
files."input/main.nib" = ```tauto
import "lib.nib"
fn f(x: Nat): Nat { strip!(x) }
```

