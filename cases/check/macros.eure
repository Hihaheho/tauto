  ⊢ List(SynStmt) from match s {
    StInductive(d) => Cons(StTheorem(SynTheorem {
        name: Syn::ident_like(d.name, "isz_proof")
        implicit: 0
        params: Nil
        ty: ExApp(ExVar(Syn::ident_like(d.name, "IsZ")), Cons(quote { Zero }, Nil), d.span)
        body: Some(ExVar(Syn::ident_like(d.name, "IszZero")))
        span: d.span
      }), Nil)
    _ => Nil
  }
}
```
files."input/main.taut" = ```tauto
import "lib.taut"

@gen_proof!(0) => theorem isz_proof
inductive IsZ: (Nat) -> Prop {
  IszZero: IsZ(Zero)
}

theorem t(): IsZ(Zero) { isz_proof }
```
