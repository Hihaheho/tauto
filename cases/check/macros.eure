@ cases.top-level-statements-in-imported-files-do-not-stop-macros-0
entry = "input/main.taut"
files."input/lib.taut" = ```tauto
pub macro fn passthrough(e: SynExpr): SynExpr { e }
```
files."input/a.taut" = ```tauto
pub fn fa(): Bool { true }
let x := fa()
```
files."input/b.taut" = ```tauto
pub fn same(n: Nat): n = n { Refl(Nat, n) }
let y := same(Zero)
```
files."input/main.taut" = ```tauto
import "lib.taut"
import "a.taut"
import "b.taut"
