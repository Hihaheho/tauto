import std::prelude::Macro

pub macro fn gen_made(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, Div} {
  ⊢ List(SynStmt) from match s {
    StStruct(d) => Cons(StTheorem(SynTheorem {
        name: Syn::ident_like(d.name, "made")
        implicit: 0
        params: Nil
        ty: quote { Nat }
        body: Some(quote { Zero })
        span: d.span
      }), Nil)
    StEnum(d) => Cons(StTheorem(SynTheorem {
        name: Syn::ident_like(d.name, "made_too")
        implicit: 0
        params: Nil
        ty: quote { Nat }
        body: Some(quote { Zero })
        span: d.span
      }), Nil)
    _ => Nil
  }
}
```
