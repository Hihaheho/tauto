@ cases.a-proof-that-uses-a-function-that-runs-as-written-says-why-0
entry = "input/main.taut"
files."input/lib.taut" = ```tauto
import std::prelude::Macro

pub macro fn gen_show(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, Div} {
  ⊢ List(SynStmt) from match s {
    StInductive(d) => {
      let name := Syn::decl_name(d.name, "show_path")
      quote stmts {
        fn $name(n: Nat): Text { Text::of_nat(n) }
      }
    }
    _ => Nil
  }
}
```
