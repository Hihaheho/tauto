@ cases.a-temporary-of-a-macro-does-not-take-the-users-name-0
entry = "input/macro-entry.taut"
files."input/main.nib" = ```tauto
var tmp := 1
var other := 2
swap!(`tmp other`)
perform show("tmp", tmp)
perform show("other", other)
```
files."input/macro-entry.taut" = ```tauto
import "swap.nib"
import "main.nib"
```
files."input/swap.nib" = ````tauto
import std::prelude::Macro

syntax!(swp, ```par
%start Pair
%%
Pair: Name Name;
Name: /[\p{L}_][\p{L}\p{N}_]*/;
```) => struct Pair, fn parse

pub macro fn swap(p: swp::Pair): List(SynStmt) {
  let a := Syn::ident(p.name)
  let b := Syn::ident(p.name_2)
  quote stmts {
    let tmp := $a
    $a := $b
    $b := tmp
  }
}
````
