@ cases.an-untyped-macro-may-ask-for-the-expansion-of-its-argument-0
entry = "input/main.nib"
files."input/ex.nib" = ```tauto
import "math.nib"
import std::prelude::Macro

pub macro fn eq_sides(e: SynExpr): SynExpr ! {macro_error, Div} {
  match Syn::expand(e) {
    ExApp(f, args, sp) => match f {
      ExVar(id) => if id.name == "Eq" { quote { Eq(Nat, 3, 3) } } else { Syn::error(sp, "not an Eq") }
      _ => Syn::error(sp, "not a variable")
    }
    _ => Syn::error(SynSpan { id: Syn::expr_span(e) }, "not an application")
  }
}

pub macro fn expanded(e: SynExpr): SynExpr ! {macro_error, Div} { Syn::expand(e) }
```
files."input/main.nib" = ```tauto
import "ex.nib"
theorem a(): eq_sides!(math!(`1 + 2 = 3`)) { Refl(Nat, 3) }
theorem b(): expanded!(math!(`1 + 2 = 3`)) { Refl(Nat, 3) }
```
