@ cases.a-list-is-put-in-where-a-list-goes-0
entry = "input/main.taut"
files."input/lib.taut" = ```tauto
import std::prelude::Macro
import std::prelude::Shared

pub macro fn gen_swap(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, Div} {
  ⊢ List(SynStmt) from match s {
    StInductive(d) => {
      let name := Syn::decl_name(d.name, "pair_swap")
      let ty := ExVar(d.name)
      let ctor := Syn::decl_name(d.name, concat(d.name.name, "::Mk"))
      let x := Syn::decl_name(d.name, "x")
      let y := Syn::decl_name(d.name, "y")
      let pats := Cons(PtBind(x), Cons(PtBind(y), Nil))
      let args := Cons(quote { $y }, Cons(quote { $x }, Nil))
      quote stmts {
        theorem $name(p: $ty): $ty {
          ⊢ $ty from match p {
            $ctor($pats...) => $ctor($args...)
          }
        }
      }
    }
    _ => Nil
  }
}
```
files."input/main.taut" = ```tauto
import "lib.taut"

@gen_swap!(0) => theorem pair_swap
inductive Pair2: Type {
  Mk(a: Nat, b: Nat): Pair2
}
```
