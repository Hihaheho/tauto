@ cases.nonresuming-effect-has-no-resume-even-for-empty-result
imports = [path`../../meta/mutable_permissions.taut`]
source = ```tauto
ghost fn dead_body(impossible: OpNone): Body(Nat, OpNone, Unit) { match impossible {} }
ghost fn forbidden(): Body(Nat, OpNone, Unit) { Resume(0, dead_body) }
theorem forged(): BodySafe(Never, 0, forbidden()) {
  let cannot_resume: MayResume(Never, 0) := Trivial
  AndIntro(cannot_resume, (impossible: OpNone) => ⊢ BodySafe(Never, 1, dead_body(impossible)) from match impossible {})
}
```
checks_all = "ok"
checks.forged = "error: type mismatch"

