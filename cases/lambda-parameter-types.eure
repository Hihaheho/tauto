@ cases.a-written-parameter-type-follows-a-match-that-renames-what-it-names
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn is_zero(n: Nat): Yn {
  match n {
    Zero => Yes
    Succ(m) => No
  }
}
fn pick(f: Nat, n: Nat): Nat {
  match f {
    Zero => n
    Succ(f2) => pick(f2, Succ(n))
  }
}
theorem bool_split(P: (Yn) -> Prop, o: Yn, a: (o = No) -> P(No), b: (o = Yes) -> P(Yes)): P(o) {
  ⊢ P(o) from match o {
    No => a(Refl)
    Yes => b(Refl)
  }
}
theorem t(f: Nat, n: Nat): pick(f, n) = pick(f, n) {
  ⊢ pick(f, n) = pick(f, n) from match f {
    Zero => Refl
    Succ(f2) => bool_split(
      (y: Yn) => pick(f2, Succ(n)) = pick(f2, Succ(n)),
      is_zero(n),
      (e: is_zero(n) = No) => t(f2, Succ(n)),
      (e: is_zero(n) = Yes) => Refl
    )
  }
}
```
checks."t" = "checked"

@ cases.a-wrong-written-parameter-type-is-caught-after-a-match-renames
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn is_zero(n: Nat): Yn {
  match n {
    Zero => Yes
    Succ(m) => No
  }
}
fn pick(f: Nat, n: Nat): Nat {
  match f {
    Zero => n
    Succ(f2) => pick(f2, Succ(n))
  }
}
theorem bool_split(P: (Yn) -> Prop, o: Yn, a: (o = No) -> P(No), b: (o = Yes) -> P(Yes)): P(o) {
  ⊢ P(o) from match o {
    No => a(Refl)
    Yes => b(Refl)
  }
}
theorem t(f: Nat, n: Nat): pick(f, n) = pick(f, n) {
  ⊢ pick(f, n) = pick(f, n) from match f {
    Zero => Refl
    Succ(f2) => bool_split(
      (y: Yn) => pick(f2, Succ(n)) = pick(f2, Succ(n)),
      is_zero(n),
      (e: is_zero(n) = Yes) => t(f2, Succ(n)),
      e => Refl
    )
  }
}
```
checks."t" = "error: the parameter `e` is written as"
@ cases.a-written-type-follows-a-parameter-the-match-renames
files."main.tauto" = ```tauto
import std::Base
import std::Data
theorem walk(es: List(Nat), k: Nat, cmp: (Nat, Nat) -> Ordering): True {
  ⊢ True from match es {
    Nil => Trivial
    Cons(p, rest) => Ordering::cases(
      (c: Ordering) => True,
      cmp(k, p),
      (f: cmp(k, p) = Less) => walk(rest, k + 1, cmp),
      (f: cmp(k, p) = Equal) => Trivial,
      (f: cmp(k, p) = Greater) => walk(rest, k, cmp)
    )
  }
}
```
checks.walk = "checked"
entry = "main.tauto"

@ cases.a-wrong-written-type-under-a-renamed-parameter-is-rejected
files."main.tauto" = ```tauto
import std::Base
import std::Data
theorem walk(es: List(Nat), k: Nat, cmp: (Nat, Nat) -> Ordering): True {
  ⊢ True from match es {
    Nil => Trivial
    Cons(p, rest) => Ordering::cases(
      (c: Ordering) => True,
      cmp(k, p),
      (f: cmp(k, p) = Greater) => walk(rest, k + 1, cmp),
      (f: cmp(k, p) = Equal) => Trivial,
      (f: cmp(k, p) = Greater) => walk(rest, k, cmp)
    )
  }
}
```
