description = "A λ given to a function whose parameter type mentions a match or a generic function."

@ cases.a-refl-arm-of-yn-cases-after-a-match
files."main.tauto" = ```tauto
import std::Nat

fn walk(f: Nat, lim: Nat, n: Nat): Nat {
  ⊢ Nat from match f {
    Zero => n
    Succ(g) => ⊢ Nat from match Nat::lt(n, lim) {
      true => n
      false => walk(g, lim, n)
    }
  }
}

theorem walk_n(f: Nat, lim: Nat, n: Nat): walk(f, lim, n) = n {
  ⊢ walk(f, lim, n) = n from match f {
    Zero => Refl
    Succ(g) => Bool::cases(
      (o: Bool) => (⊢ Nat from match o {
        true => n
        false => walk(g, lim, n)
      }) = n,
      Nat::lt(n, lim),
      (e: Nat::lt(n, lim) = false) => walk_n(g, lim, n),
      (e: Nat::lt(n, lim) = true) => Refl
    )
  }
}
```
entry = "main.tauto"
checks.walk = "checked"
checks.walk_n = "checked"

@ cases.a-match-under-an-arrow-in-a-motive
files."main.tauto" = ```tauto
import std::Nat
theorem t(o: Bool, h: (⊢ Bool from match o {
  true => true
  false => false
}) = true): o = true {
  Bool::cases(
    (p: Bool) => ((⊢ Bool from match p {
      true => true
      false => false
    }) = true) -> (p = true),
    o,
    (e: o = false) => (h2: false = true) => h2,
    (e: o = true) => (h2: true = true) => h2
  )(h)
}
```
entry = "main.tauto"
checks.t = "checked"

@ cases.a-written-parameter-type-is-compared-once-implicits-are-written
files."main.tauto" = ```tauto
import std::Nat

inductive Box(A: Type): Type {
  Mk(
    f: (A) -> Bool,
    r#law: ∀ a: A. (f(a) = true) -> (f(a) = true)
  ): Box(A)
}

fn always<A>(a: A): Bool {
  true
}

def b<A: Type>(): Box(A) := Box::Mk(
  (a: A) => always(a),
  (a: A, h: always(a) = true) => h
)
```
entry = "main.tauto"
checks.b = "checked"

