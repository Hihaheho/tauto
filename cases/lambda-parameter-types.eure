@ cases.a-later-written-type-names-an-earlier-parameter-in-a-match-arm
source = ```tauto
inductive T: Type {
  A: T
  V(i: Nat): T
}
theorem oc<A: Type>(
  P: (Option(A)) -> Prop,
  o: Option(A),
  q: (o = None) -> P(None),
  r: ∀ x: A. (o = Some(x)) -> P(Some(x))
): P(o) {
  ⊢ P(o) from match o {
    None => q(Refl)
    Some(x) => r(x, Refl)
  }
}
fn get(i: Nat): Option(T) { None }
theorem m(t: T): t = t {
  ⊢ t = t from match t {
    V(i) => oc(
      (o: Option(T)) => V(i) = V(i),
      get(i),
      (e: get(i) = None) => Refl,
      (y: T, e: get(i) = Some(y)) => Refl
    )
    A => Refl
  }
}
```
checks.m = "checked"

@ cases.a-wrong-later-written-type-is-caught
source = ```tauto
theorem k(P: Prop, r: ∀ x: Nat. (x = x) -> P): P { r(Zero, Refl) }
theorem m(): Zero = Zero {
  k(Zero = Zero, (y: Nat, e: y = Succ(y)) => Refl)
}
```
checks.m = "error: the parameter `e` is written as"

@ cases.a-written-type-in-an-arm-reads-the-matched-value-as-the-constructor
source = ```tauto
inductive T: Type {
  A: T
  V(i: Nat): T
  W(i: Nat): T
}
fn kind(t: T): Nat {
  match t {
    A => Zero
    V(i) => i
    W(i) => i
  }
}
theorem m(t: T, n: Nat, h: kind(t) = n): kind(t) = n {
  (⊢ (kind(t) = n) -> kind(t) = n from match t {
    A => (h: Zero = n) => h
    V(i) => (h: kind(t) = n) => h
    _ => (h: kind(t) = n) => h
  })(h)
}
```
checks.m = "checked"

@ cases.a-bare-nil-takes-its-generic-from-a-goal-the-match-reduced
source = ```tauto
inductive Mu(A: Type): Type {
  Mk(a: A, n: Nat): Mu(A)
}
def Fr<A: Type>(c: Nat, m: Mu(A)): Prop := m = m
theorem ret<A: Type>(c: Nat, v: A): Fr(c, Mu::Mk(v, c)) { Refl }
fn each(c: Nat, ts: List(Nat)): Mu(List(Nat)) {
  ⊢ Mu(List(Nat)) from match ts {
    Nil => Mu::Mk(Nil, c)
    Cons(t, rest) => each(c, rest)
  }
}
theorem t(c: Nat, ts: List(Nat)): Fr(c, each(c, ts)) {
  ⊢ Fr(c, each(c, ts)) from match ts {
    Nil => ret(c, Nil)
    Cons(x, rest) => t(c, rest)
  }
}
```
checks.t = "checked"
