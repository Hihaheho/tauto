description = "Rejected, exhausted and duplicate declarations restore the elaborator environment."
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Nat::of_u64` yet"
imports = [
  path`../totes/elaborator/src/elaborate.taut`,
  path`../totes/elaborator/src/program.taut`,
  path`../totes/kernel/src/data.taut`,
  path`../totes/surface/src/surface.taut`,
  path`../totes/identity/src/identity.taut`,
]
source = ```tauto
import std::base
import std::map

fn rejected(r: ElabResult(ElabDeclaration)): Bool {
  match r { ElabErr(e) => true
    ElabOk(d) => false }
}
// A fresh kernel holds three globals: `+`, `*` and `-`.
fn clean(c: KernelCore): Bool {
  c.next == 0 && not(c.exhausted) && Ordmap::size(c.locals) == 0 && Ordmap::size(c.globals) == 3
}
let prop := surface_term_mk(SkVar(NameSpelled("Prop")), 0, 0)
let ty := surface_term_mk(SkVar(NameSpelled("A")), 0, 0)
let value := surface_term_mk(SkVar(NameSpelled("a")), 0, 0)
let params := Cons(SurfaceNamed {name: "A", ty: prop}, Cons(SurfaceNamed {name: "a", ty: ty}, Nil))
let valid := SurfaceTheorem {name: "identity", implicit: 0, params: params, ty: ty, body: Some(value), start: 0, end: 0}
let bad := SurfaceTheorem {name: "identity", implicit: 0, params: params, ty: ty, body: Some(prop), start: 0, end: 0}
let imps: List(ElabBinding) := Nil
var core := kernel_new()
let exhausted := rejected(elab_declaration_checked(0, &mut core, valid, false, imps)) && clean(core)
let mismatch := rejected(elab_declaration_checked(2000, &mut core, bad, false, imps)) && clean(core)
let accepted := match elab_declaration_checked(2000, &mut core, valid, false, imps) {
  ElabErr(e) => false
  ElabOk(d) => kernel_closed(d.value) && kernel_closed(d.ty) && not(core.exhausted) && Ordmap::size(core.locals) == 0
}
let saved_next := core.next
let duplicate := rejected(elab_declaration_checked(2000, &mut core, valid, false, imps)) && core.next == saved_next && Ordmap::size(core.globals) == 4 && not(core.exhausted)
show(&(exhausted && mismatch && accepted && duplicate))
```
extract = true
stdout = "true\n"
