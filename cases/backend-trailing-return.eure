// A body that ends in `return` has the function's type, not `()`.
@ cases.trailing-return
source = ```nib
fn early(n: i64): i64 ! {overflow} {
  return n * 2
}
fn after_let(n: i64): i64 ! {overflow} {
  let m := n + 1
  return m
}
fn in_branch(n: i64): i64 ! {overflow} {
  if n > 0 { return n } else { return 0 - n }
}
show(&early(5))
show(&after_let(5))
show(&in_branch(0 - 3))
```
stdout = ```
10
6
3
```
