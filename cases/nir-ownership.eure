// No program the compiler accepts moves a value twice; the check is asked
// about a package written as text.
@ cases.a-value-moved-twice-is-found
nir.source = ```nir
fn twice@0(t#1: Text): Pair(Text, Text) S = Pair::Mk(fst = move t#1, snd = move t#1): Pair(Text, Text)
```
nir.passes = ["check-ownership"]
nir.error = "twice@0"

@ cases.a-value-moved-on-the-right-of-or-is-dropped-where-the-left-decides
source = ```tauto
fn any<A>(p: (&A) -> Bool, l: &List(A)): Bool {
  match l {
    Nil => false
    Cons(h, t) => p(h) || any(p, t)
  }
}
show(&any((x: &u64) => x == 2, &[1, 2, 3]))
```
stdout = "true\n"
nir.passes = ["anf", "ownership", "check-ownership"]
nir.fns.any = ```nir
fn any@2<'A: Clone>(p#5: fn(&'A) -> Bool shared S, ref l#6: &List('A)): Bool S = match by_ref &l#6 {
  List::Nil => {
    let dropped_after#4294967290 := false;
    builtin drop(move p#5): Unit;
    move dropped_after#4294967290
  },
  List::Cons(ref h#7: &'A, ref t#8: &List('A)) => if p#5(&h#7): Bool then {
    let dropped_after#4294967291 := true;
    builtin drop(move p#5): Unit;
    move dropped_after#4294967291
  } else any@2<'A>(move p#5, &t#8): Bool,
}
```


@ cases.a-move-on-the-right-of-or-without-a-drop-where-it-is-skipped-is-found
nir.source = ```nir
fn f@0(b#1: Bool, t#2: Text): Bool S = or(copy b#1, builtin Text::is_empty(move t#2): Bool)
```
nir.passes = ["check-ownership"]
nir.error = "f@0: `t` is not moved on a path"
