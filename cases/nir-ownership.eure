// `ownership`: where each owned value is dropped. `check-ownership` asks that
// every owned local is moved or dropped once on every path.

@ cases.an-unused-owned-parameter-is-dropped-after-the-result-is-made
source = ```tauto
fn keep(t: Text, u: Text): Text { t }
show(&keep("a", "b"))
```
stdout = ```
"a"
```
nir.passes = ["anf", "ownership", "check-ownership"]
nir.fns.keep = ```nir
fn keep@2(t#4: Text, u#5: Text): Text S = {
  let dropped_after#4294967291 := move t#4;
  builtin drop(move u#5): Unit;
  move dropped_after#4294967291
}
```

@ cases.a-value-moved-in-one-branch-is-dropped-in-the-other
source = ```tauto
