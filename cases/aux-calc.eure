@ cases.parse_failure_is_not_budget_exhaustion
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
fn invalid(source: Text): Bool ! {budget} {
  match calc_parse(source) {
    Err(raw) => match calc_read(source, 100000) {
      Err(CalcParseFailed(domain)) => domain.code == "macro.syntax_error" && domain.at == raw.at && domain.message == raw.message
      _ => false
    }
    Ok(tree) => false
  }
}
show(&invalid("2 + * 3"))
show(&invalid("("))
show(&invalid("日本語"))
show(&invalid("1 trailing"))
```
imports = [path`../examples/calc/src/calc.taut`, path`../examples/calc/src/api.taut`]
budget = 100000000
stdout = ```
true
true
true
true
```

@ cases.zero_budgets
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
import std::builtin::os
fn exhausted(steps: u64): Unit ! {budget, stdout, stdout_flush} {
  show(&(match calc_read("1", steps) { Err(CalcBudgetExceeded) => true, _ => false }))
  show(&(match calc_fold_bounded(ELit(1), steps) { Err(CalcBudgetExceeded) => true, _ => false }))
  show(&(match calc_eval_bounded(ELit(1), steps) { Err(CalcBudgetExceeded) => true, _ => false }))
  show(&(match calc_run_bounded(ELit(1), steps) { Err(CalcBudgetExceeded) => true, _ => false }))
}
exhausted(0)
```
