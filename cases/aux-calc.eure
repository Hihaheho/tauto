@ cases.native_host_arithmetic_contract
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
import std::builtin::os
fn results(source: Text): Unit ! {budget, stdout, stdout_flush} {
  match calc_read(source, 100000) {
    Ok(original) => match calc_fold_bounded(original, 100000) {
      Ok(folded) => {
        show(&(match folded { ELit(value) => Some(value), _ => None }))
        show(&calc_eval_bounded(original, 100000))
        show(&calc_eval_bounded(folded, 100000))
        show(&calc_run_bounded(original, 100000))
        show(&calc_run_bounded(folded, 100000))
      }
      Err(failure) => show(&failure)
    }
    Err(failure) => show(&failure)
  }
}
results("0")
results("12")
results("1 + 2 * 3")
results("(2 + 3) * (4 + 5)")
results("(7+0)*1")
results("12345 * 6789")
show(&(match calc_parse("12") { Ok(ast) => ast.span.id, Err(diag) => 999 }))
```
