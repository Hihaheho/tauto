// SlotsModel::mark_at / state: template indices leave room for policy
// implicits; the tote right-aligns the written arguments.
@ cases.slots-model-mark
differential = "extract"
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::uhost
import std::uint
import std::slots { Byte, SlotsModel, Table }
import std::hash_table { tb_used }
fn mark_of(t: &SlotsModel(Table, Byte, Nat, tb_used), i: UHost): Byte {
  SlotsModel::mark_at(t, i)
}
fn st(t: &SlotsModel(Table, Byte, Nat, tb_used)): Table {
  SlotsModel::state(t)
}
```
