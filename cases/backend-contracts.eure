@ cases.budget_closures-unused_owned_closure
backends = ["rust", "javascript"]
source = ```tauto
fn visit(n: i64): Unit ! {Div} { if n > 0 { visit(n - 1) } }
let r := handle { budget(steps: 0) { let f := (n) => visit(n)
true } } with { exceeded(info), k => false }
perform show("r", r)
```
// What counts as a step is up to each implementation: the evaluator counts
// every step of its machine, so a zero budget runs out on its `let`, while the
// compiled backends take no step until the closure is called.
rust_shows = ["r = true"]
javascript_shows = ["r = true"]

