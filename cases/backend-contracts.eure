@ cases.nonresuming_budget-host_added_drop_on_generated_noncopy_data_keeps_original_order
backends = ["rust", "javascript"]
source = ```tauto
struct Held { text: Text }
fn hold(value: Held, n: i64): Held ! {Div} {
  var i := 0
  while i < n { i := i + 1 }
  value
}
fn run(steps: i64): Held {
  handle { budget(steps: steps) { hold(Held { text: "body" }, 5) } } with {
    exceeded(info), k => { let temporary := Held { text: "arm" }
      Held { text: "handler" } }
  }
}
perform show("result", run(1))
```
shows = ["result = Held { text: \"handler\" }"]

