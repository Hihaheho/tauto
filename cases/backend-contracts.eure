enum(affine) R { Done(Bool), Paused(Info(R)) }
let f := (n) => visit(n)
let r := handle { Done(perform budget(0, () => { each(Cons(3, Nil), &f)
true })) } with { exceeded(info), k => Paused(info) }
```
