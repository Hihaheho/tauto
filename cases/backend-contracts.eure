@ cases.nonresuming_budget-host_added_drop_on_generated_noncopy_data_keeps_original_order
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
struct Held { text: Text }
fn hold(value: Held, n: i64): Held ! {div, overflow} {
  var i := 0
  while i < n { i := i + 1 }
  value
}
fn run(steps: u64): Held ! {budget, overflow} {
  handle { perform budget(steps, () => { hold(Held { text: "body" }, 5) }) } with {
    exceeded(info), k => { let temporary := Held { text: "arm" }
      Held { text: "handler" } }
  }
}
show(&run(1))
```
stdout = ```
Held { text: "handler" }
```

