@ cases.budget_closures-a_helper_without_div_takes_a_div_callback
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
stdout = "true\n"
source = ```tauto
fn visit(n: i64): Unit ! {div, overflow} { if n > 0 { visit(n - 1) } }
fn ignore_div(f: &((i64) -> Unit ! {div, overflow}), n: i64): Unit { #() }
let r := handle { perform budget(10, () => { each(Cons(1, Nil), (n) => ignore_div((k) => #(), n))
true }) } with { exceeded(info), k => false }
show(&r)
```
// The helper's own instance takes the callback at the tier that counts a
// budget's steps.

@ cases.budget_closures-total_closure_lends_an_uncalled_divergent_one
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
stdout = "true\n"
source = ```tauto
fn visit(n: i64): Unit ! {div, overflow} { if n > 0 { visit(n - 1) } }
fn ignore<!e>(f: &((i64) -> Unit ! e), n: i64): Unit { #() }
let r := handle { perform budget(10, () => { each(Cons(1, Nil), (n) => ignore((k) => visit(k), n))
true }) } with { exceeded(info), k => false }
show(&r)
```
// What counts as a step is the implementation's: the evaluator counts each
// step of its machine, and spends more than 10 on the call itself.

@ cases.constructor_resolution-shared_names-forward
source = ```tauto
enum Left { Same(i64), Empty, Wildcard { n: i64 } }
enum Right { Same(Text), Empty, Wildcard { text: Text } }

fn left_value(x: Left): i64 {
  match x { Same(n) => n, Empty => 0, Wildcard { n } => n }
}
fn right_value(x: Right): Text {
  match x { Same(text) => text, Empty => "empty", Wildcard { text } => text }
}
fn make_left(): Left { Same(21) }
fn make_right(): Right { Same("日本語") }
let a: Left := Same(42)
let b: Right := Same("right")
let empty_left: Left := Empty
let empty_right: Right := Empty
let record_left: Left := Wildcard { n: 7 }
let record_right: Right := Wildcard { text: "record" }
show(&left_value(a))
show(&right_value(b))
show(&left_value(make_left()))
show(&right_value(make_right()))
show(&left_value(Same(12)))
show(&right_value(Same("argument")))
show(&left_value(empty_left))
show(&right_value(empty_right))
show(&left_value(record_left))
show(&right_value(record_right))
show(&left_value(Left::Same(13)))
show(&right_value(Right::Same("qualified")))
```
stdout = ```
42
"right"
21
"日本語"
12
"argument"
0
"empty"
7
"record"
13
"qualified"
```

@ cases.constructor_resolution-shared_names-reverse
