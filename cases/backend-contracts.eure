@ cases.budget_closures-made_outside_a_budget
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
stdout = "false\n"
source = ```tauto
fn visit(n: i64): Unit ! {div, overflow} { if n > 0 { visit(n - 1) } }
let f := (n) => visit(n)
let r := handle { perform budget(0, () => { f(3)
true }) } with { exceeded(info), k => false }
show(&r)
```
// A divergent function value made outside a budget is held at the tier that
// counts the steps of a budget it is called under.

@ cases.budget_closures-lent_outside_a_budget
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
source = ```tauto
fn visit(n: i64): Unit ! {div, overflow} { if n > 0 { visit(n - 1) } }
let f := (n) => visit(n)
let r := handle { perform budget(0, () => { each(Cons(3, Nil), &f)
true }) } with { exceeded(info), k => false }
show(&r)
```
// The `exceeded` arm uses neither `info` nor `k`, so the stopped body, which
// borrows `f`, is dropped inside the `handle`: lending `f` into it is allowed.
stdout = "false\n"

// Keeping `info` keeps the stopped body and its borrow of `f`.
@ cases.budget_closures-unsupported-2
source = ```tauto
