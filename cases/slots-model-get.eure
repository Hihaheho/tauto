// Proof `hu` must be dropped: right-aligning it would shift `$1`/`$2`.
@ cases.slots-model-get
differential = "extract"
entry = "input/main.taut"
files."input/main.taut" = ```tauto
import std::uhost
import std::uint
import std::slots { Byte, SlotsModel, Table }
import std::hash_table { tb_used }
fn get_of(t: &SlotsModel(Table, Byte, Nat, tb_used), i: UHost, hu: tb_used(SlotsModel::state(t), i, SlotsModel::mark_at(t, i)) = true): &Nat {
  SlotsModel::get(t, i, hu)
}
```
