@ cases.editor_tokens_in_quote
files."math.nib" = ````nib
import std::prelude::Macro

pub fn math_end(ts: List(SynTok), at: u64): u64 {
  match ts {
    Nil => at
    Cons(t, rest) => math_end(rest, t.end)
  }
}

pub fn math_tokens(ts: List(SynTok)): List(SynHighlight) ! {Div} {
  match ts {
    Nil => Nil
    Cons(t, rest) => {
      if t.kind == "Num" {
        Cons(SynHighlight { start: t.start, end: t.end, kind: "enumMember" }, math_tokens(rest))
      } else {
        if t.kind == "Plus" {
          Cons(SynHighlight { start: t.start, end: math_end(rest, t.end), kind: "string" }, Nil)
        } else {
          math_tokens(rest)
        }
      }
    }
  }
}

