@ cases.incremental_library
source = ```tauto
theorem and_swap(A: Prop, B: Prop, p: A ∧ B): B ∧ A {
  AndIntro(B, A, And::right(A, B, p), And::left(A, B, p))
}

theorem compose(A: Prop, B: Prop, C: Prop, f: (A) -> B, g: (B) -> C): (A) -> C {
  a => g(f(a))
}

theorem id_proof(A: Prop, a: A): A {
  a
}
```
checks."and_swap" = "ok"
checks."compose" = "ok"
checks."id_proof" = "ok"

