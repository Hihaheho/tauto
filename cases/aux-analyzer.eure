pub fn math_tokens(ts: List(SynTok)): List(SynHighlight) ! {Div} {
  match ts {
    Nil => Nil
    Cons(t, rest) => Cons(SynHighlight { start: t.start, end: t.end, kind: "string" }, math_tokens(rest))
  }
}

syntax!(math, ```par
{{par:math}}```, with(tokens: math_tokens)) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1,
  enum Term, fn parse
pub macro fn math(e: math::Eqn): SynExpr ! {macro_error, Div} { quote { Eq(Nat, 1, 1) } }
````
