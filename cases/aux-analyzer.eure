@ cases.navigate_fields_enums_and_modules
source = ```tauto
struct Point { x: i64, y: i64 }
enum Shape { Dot(Point), Empty }
fn area(s: Shape): i64 {
  match s {
    Shape::Dot(p) => p.x + p.y
    Empty => 0
  }
}
fn origin(): Point { Point { x: 0, y: 0 } }
```
parses = true
types = "ok"
rows = "ok"
lin = "ok"

