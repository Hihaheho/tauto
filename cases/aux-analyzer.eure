@ cases.editor_tokens_grammar
description = "The grammar of a `syntax` and a fenced block of par in a comment are coloured by the words the table generators read: directives, non-terminals, terminals, comments, types after `:`, members after `@` and scanner modes."
files."math.nib" = ````nib
syntax!(math, ```par
%start Eqn
%title "math"
%%
Eqn: Sum Equals Sum;
Sum: Term { Plus Term };
Term: Num | Paren;
Paren: LParen Sum RParen;
Num: /[0-9]+/;
Equals: '=';
Plus: '+';
LParen: '(';
RParen: ')';
```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1, enum Term,
  fn parse
pub macro fn math(e: math::Eqn): SynExpr ! {macro_error, Div} { quote { Eq(Nat, 1, 1) } }
// ```par
// %scanner Str { %auto_newline_off }
// %%
// /* start */ A: B@b: Text <Str>"x" ;
// ```
fn documented(): Nat { 0 }
````
