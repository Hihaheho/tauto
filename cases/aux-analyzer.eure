@ cases.navigation_scopes
source = ```tauto
fn twice(n: i64): i64 { n + n }
fn main(): i64 {
  let n := 3
  let m := twice(n)
  let k := match Some(m) {
    Some(n) => n + 1
    None => 0
  }
  let add := (n: i64) => n + k
  add(m)
}
```
parses = true
types = "ok"
rows = "ok"
lin = "ok"

