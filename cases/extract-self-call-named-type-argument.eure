imports = [path`../std/base.taut`, path`../std/list.taut`]
source = ```tauto
fn pad<T: Shared>(n: Nat, x: T): List(T) {
  match n {
    Zero => Nil
    Succ(m) => Cons(x, pad(<T: T>, m, x))
  }
}
show(&pad(2, 7))
