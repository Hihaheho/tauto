@ cases.a-picked-member-is-untagged
source = ```tauto
fn key_is(p: @key i64 × @val i64, x: i64): Bool { (p: @key i64) == x }
let p := #(@key 1, @val 2)
let k := (p: @key i64)
let pair := #(@response (p: @key i64), @state (p: @val i64))
show(&key_is(p, 1))
```
types = "ok"
inferred_types.k = "i64"
inferred_types.pair = "@response i64 × @state i64"
stdout = "true\n"

