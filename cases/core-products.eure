// The product is written `A × B` and `#(…)` only: the prelude's `Pair`, the record the checker
// reads a product as, is not written by its name, as a type, a value or a pattern.
@ cases.the-prelude-pair-is-not-written-as-a-type
source = ```tauto
fn f(p: Pair(Nat, Bool)): Nat { 0 }
```
types = "error: `Pair` is not written by its name: a product is written `A × B` and `#(a, b)`, and taken apart by `#(…)`, by the type of a member or by `.fst` and `.snd`"

@ cases.the-prelude-pair-is-not-written-as-a-value
source = ```tauto
fn f(): Nat × Bool { Pair { fst: 0, snd: true } }
```
types = "error: `Pair` is not written by its name: a product is written `A × B` and `#(a, b)`, and taken apart by `#(…)`, by the type of a member or by `.fst` and `.snd`"

@ cases.the-prelude-pair-is-not-written-as-a-pattern
source = ```tauto
fn f(p: Nat × Bool): Nat {
  match p {
    Pair { fst: n, snd: b } => n
  }
}
```
types = "error: `Pair` is not written by its name: a product is written `A × B` and `#(a, b)`, and taken apart by `#(…)`, by the type of a member or by `.fst` and `.snd`"

// A program's own `Pair` is its own declaration, written by its name as any other.
@ cases.a-program-declares-its-own-pair
source = ```tauto
struct Pair(A: Type, B: Type) { left: A, right: B }
fn f(p: Pair(Nat, Bool)): Nat { p.left }
```
types = "ok"

@ cases.a-product-is-cast-to-its-first-member
source = ```tauto
theorem t(p: Nat × Bool): Nat { (p: Nat) }
```
checks.t = "checked"

// A `match` on a labeled product refines a hypothesis that mentions the matched value: the
// value the hypothesis is refined with is the product the pattern rebuilds.
@ cases.a-match-on-a-labeled-product-refines-a-hypothesis
source = ```tauto
fn all_ok(ps: List(@name Bool × @value Bool)): Bool {
  ⊢ Bool from match ps {
    Nil => true
    Cons(p, t) => all_ok(t)
  }
}

theorem t(ps: List(@name Bool × @value Bool), ok: all_ok(ps) = true): true = true {
  match ps {
    Nil => Refl
    Cons(p, t) => match p {
      #(@name k, @value v) => Refl
    }
  }
}
```
checks_all = "checked"

// A member of a `List(A × B)` passed to a parameter `A × B`: the element the kernel reads off
// the list is the product.
@ cases.a-list-member-of-a-product-is-passed-as-the-product
source = ```tauto
fn one(b: List(Nat) × Bool): Nat {
  match b {
    #(ns, f) => Zero
  }
}

fn all(bs: List(List(Nat) × Bool)): Nat {
  match bs {
    Nil => Zero
    Cons(b, rest) => one(b)
  }
}
```
checks_all = "checked"

@ cases.a-local-function-uses-the-outer-debug
source = ```tauto
import std::builtin::os
fn outer<A: Shared>(value: A): i64 ! {stdout, stdout_flush} where Debug(A) {
  fn inner<B: Shared>(other: B): i64 ! {stdout, stdout_flush} where Debug(B) {
    show(&value)
    show(&other)
    7
  }
  inner(9)
}
show(&outer("text"))
```
stdout = ```
"text"
9
7
```

@ cases.a-function-field-shows-as-dots
source = ```tauto
struct Hold { n: i64, f: (i64) -> i64 }
enum Pick { One(i64, (i64) -> i64) }
fn id(x: i64): i64 { x }
show(&Hold { n: 1, f: id })
show(&Pick::One(2, id))
```
stdout = ```
Hold { n: 1, .. }
One(2, ..)
```

@ cases.a-recursive-type-shows-to-a-depth
source = ```tauto
enum Tree { Leaf(i64), Node(Tree, Tree) }
enum Chain(A: Shared) { End, Link(A, Chain(A)) }
fn long(n: u64, c: Chain(u64)): Chain(u64) ! {div} {
  if n == 0 { c } else { long(U64::wrapping_sub(n, 1), Link(n, c)) }
}
show(&Node(Leaf(1), Node(Leaf(2), Leaf(3))))
show(&Link("a", Link("b", End)))
show(&long(66, End))
```
stdout = ```
Node(Leaf(1), Node(Leaf(2), Leaf(3)))
Link("a", Link("b", End))
Link(1, Link(2, Link(3, Link(4, Link(5, Link(6, Link(7, Link(8, Link(9, Link(10, Link(11, Link(12, Link(13, Link(14, Link(15, Link(16, Link(17, Link(18, Link(19, Link(20, Link(21, Link(22, Link(23, Link(24, Link(25, Link(26, Link(27, Link(28, Link(29, Link(30, Link(31, Link(32, Link(33, Link(34, Link(35, Link(36, Link(37, Link(38, Link(39, Link(40, Link(41, Link(42, Link(43, Link(44, Link(45, Link(46, Link(47, Link(48, Link(49, Link(50, Link(51, Link(52, Link(53, Link(54, Link(55, Link(56, Link(57, Link(58, Link(59, Link(60, Link(61, Link(62, Link(63, Link(64, ..))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
```

@ cases.a-union-shows-the-member-it-holds
llvm.unimplemented = "generate: the LLVM backend does not write a union yet"
source = ```nib
enum Shape { Circle(i64), Rect(i64, i64) }
let a: i64 | Text := "a"
let b: i64 | Text := 3
let c: Shape | Bool := Rect(2, 3)
show(&a)
show(&b)
show(&c)
show(&[a, b])
```
stdout = ```
"a"
3
Rect(2, 3)
["a", 3]
```

