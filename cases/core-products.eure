  Debug::debug(&x)
}
```
types = "error: no instance Debug(i64 | A)"

@ cases.types-recursive-through-each-other-show-whole
source = ```tauto
enum Tree { Leaf(i64), Node(Forest) }
struct Forest { kids: List(Tree), extra: Option(Tree) }
enum Json { Null, Arr(List(Json)), Obj(List(Entry)) }
struct Entry { key: Text, value: Json }
enum Env { Empty, Bind(List(Env × Text), u64) }
show(&Node(Forest { kids: [Leaf(1), Node(Forest { kids: [], extra: None })], extra: Some(Leaf(2)) }))
show(&Obj([Entry { key: "a", value: Arr([Null, Null]) }, Entry { key: "b", value: Null }]))
show(&Bind([], 3))
```
stdout = ```
Node(Forest { kids: [Leaf(1), Node(Forest { kids: [], extra: None })], extra: Some(Leaf(2)) })
Obj([Entry { key: "a", value: Arr([Null, Null]) }, Entry { key: "b", value: Null }])
Bind(.., 3)
```
