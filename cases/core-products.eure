@ cases.a-product-of-three-members-is-an-argument-to-a-generic-function
source = ```tauto
var v: Vec(i64 × Bool × Text) := Vec::new()
Vec::push(&mut v, #(1, true, "a"))
var w: Vec(@code i64 × @at i64 × @face i64) := Vec::new()
let p := #(@code 7, @at 8)
Vec::push(&mut w, #(@code (p: @code i64), @at (p: @at i64), @face 9))
let q := match Vec::get(&v, 0) { Some(q) => q, None => #(0, false, "") }
let r := match Vec::get(&w, 0) { Some(r) => r, None => #(@code 0, @at 0, @face 0) }
show(&((q: Text)))
show(&((r: @face i64)))
```
types = "ok"
stdout = ```
"a"
9
```

