theorem t(p: Pair(Nat, Bool)): Nat × Bool { p }
```
checks.t = "checked"

@ cases.a-product-is-cast-to-its-first-member
source = ```tauto
theorem t(p: Nat × Bool): Nat { (p: Nat) }
```
checks.t = "checked"

// A `match` on a labeled product refines a hypothesis that mentions the matched value: the
// value the hypothesis is refined with is the product the pattern rebuilds, not a `Pair`
// written by its name.
@ cases.a-match-on-a-labeled-product-refines-a-hypothesis
source = ```tauto
fn all_ok(ps: List(@name Bool × @value Bool)): Bool {
  ⊢ Bool from match ps {
    Nil => true
    Cons(p, t) => all_ok(t)
  }
}

theorem t(ps: List(@name Bool × @value Bool), ok: all_ok(ps) = true): true = true {
  match ps {
    Nil => Refl
    Cons(p, t) => match p {
      #(@name k, @value v) => Refl
    }
  }
}
```
checks_all = "checked"

// A member of a `List(A × B)` passed to a parameter `A × B`: the element the kernel reads off
// the list is a `Pair`, the same type as the product.
@ cases.a-list-member-of-a-product-is-passed-as-the-product
source = ```tauto
fn one(b: List(Nat) × Bool): Nat {
  match b {
    #(ns, f) => Zero
  }
}

fn all(bs: List(List(Nat) × Bool)): Nat {
  match bs {
    Nil => Zero
    Cons(b, rest) => one(b)
  }
}
```
checks_all = "checked"
