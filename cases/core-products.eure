// A product on the left of a product is one member, not spread into the outer product.
@ cases.a-product-on-the-left-is-one-member
source = ```tauto
fn f(n: Nat): (List(Nat) × List(Bool) × List(Bool)) × Nat {
  #(#(Nil, Nil, Nil), n)
}

fn g(n: Nat): (Nat × Bool) × Nat {
  #(#(n, true), n)
}

theorem g_left(): g(Zero).fst.snd = true {
  Refl
}
```
checks_all = "checked"

