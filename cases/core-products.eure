@ cases.members-are-evaluated-in-the-order-written
source = ```tauto
import std::builtin::os
fn t(name: Text, v: i64): i64 ! {stdout, stdout_flush} { show(&v)
  v }
let p := #(@y t("first", 1), @x t("second", 2))
show(&p)
```
stdout = ```
1
2
#(1, 2)
```

