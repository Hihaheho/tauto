@ cases.unread-field-warns
entry = "main.taut"
files."main.taut" = ```tauto
struct P { x: i64, y: i64 }
fn main(): i64 {
  let p := P { x: 1, y: 2 }
  p.x
}
```
check_report = "main.taut:1:1: the field `y` of `P` is never read"

@ cases.marked-unread-field-is-ok
files_tote = "app"
tote_warnings = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/main.taut" = ```tauto
struct P { x: i64, ^y: i64 }
fn main(): i64 {
  let p := P { x: 1, y: 2 }
  p.x
}
```

@ cases.read-fields-do-not-warn
files_tote = "app"
tote_warnings = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/main.taut" = ```tauto
struct P { x: i64, y: i64, z: i64 }
fn first(p: P): i64 {
  match p {
    P { x, y: _, z: _ } => x
  }
}
fn second(p: P): P {
  P { x: 0, ..p }
}
fn main(): i64 {
  first(second(P { x: 1, y: 2, z: 3 }))
}
```

@ cases.marked-field-read-by-dot-is-an-error
entry = "main.taut"
files."main.taut" = ```tauto
struct P { ^x: i64 }
fn main(): i64 {
  let p := P { x: 1 }
  p.x
}
```
check_report = "main.taut:1:12: `x` is marked unused with `^` but is used"

@ cases.marked-field-read-by-pattern-is-an-error
