@ cases.quote-plain-fn-with-generics
description = "Quoting an unmarked fn with generics succeeds (SynFn.unused_generics)."
entry = "main.taut"
files."mk.taut" = ````tauto
import std::base
import std::builtin::macro

pub macro fn mk_id(e: SynExpr): List(SynStmt) {
  match Syn::ident_of(e) {
    None => Nil
    Some(at) => {
      let name := Syn::decl_name(at, "id")
      quote stmts {
        fn $name<A>(x: A): A { x }
      }
    }
  }
}
````
files."main.taut" = ````tauto
import std::base
import "mk.taut"

mk_id!(here) => fn id
let r := id(0)
show(&r)
````
stdout = "0\n"

