@ cases.unmarked-unused-match-arm-binding-warns
description = "A name a `match` arm binds and nothing reads warns like a `let`."
entry = "main.taut"
files."main.taut" = ```tauto
struct P { x: i64, y: i64 }
fn main(p: P): i64 {
  match p {
    P { x, y } => x
  }
}
```
check_report = "unused_binding"

@ cases.marked-unused-match-arm-binding-is-ok
description = "`^y` in a `match` arm says the binding is meant to go unread and silences the warning."
entry = "main.taut"
files."main.taut" = ```tauto
struct P { x: i64, y: i64 }
fn main(p: P): i64 {
  match p {
    P { x, ^y } => x
  }
}
```
check_errors = []

