files."app/src/lib.taut" = ````tauto
import std::base
pub fn helper(): i64 { 0 }
````
files."app/src/main.taut" = ````tauto
import std::base
import "lib.taut"
fn id<^A>(x: A): A { x }
let r := id(helper())
````

@ cases.dependency-macro-used-marker-is-kept-on-tote-check
description = "A tote keeps unused_marker_used for a decl it generated even when the diag displays at a dependency quote."
files_tote = "app"
tote_warnings = ["marked unused with `^` but is used"]
tote_errors = []
files."Tauto.eure" = ```eure
workspace {
  members = ["app", "lib"]
}
```
files."app/Tauto.eure" = ```eure
package { name = "app" version = "0.1.0" }
workspace = ".."
dependencies {
  lib: workspace
}
```
files."lib/Tauto.eure" = ```eure
package { name = "lib" version = "0.1.0" }
workspace = ".."
```
files."lib/src/mk.taut" = ````tauto
import std::base
import std::builtin::macro

pub macro fn mk_id(e: SynExpr): List(SynStmt) {
  match Syn::ident_of(e) {
    None => Nil
    Some(at) => {
      let name := Syn::decl_name(at, "id")
      quote stmts {
        fn $name<^A>(x: A): A { x }
      }
    }
  }
}
````
files."app/src/main.taut" = ````tauto
import std::base
import lib::mk { mk_id }

mk_id!(here) => fn id
let r := id(0)
````

