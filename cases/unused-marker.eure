description = "Unused assertion `^name`: suppress unused warnings when confirmed unused; error when used; lone `_` is not a binding Ident; `_name` does not suppress; Wild patterns stay; a field nothing reads warns, and `^` on a struct's field asserts it is never read."

@ cases.marked-unused-binding-is-ok
entry = "main.taut"
files."main.taut" = ```tauto
fn main(): i64 {
  let ^x := 1
  0
}
```
check_errors = []

