// A lexical capture keeps the defining activation across calls and resumptions.
@ cases.borrowed-recursive-capture
source = ```nib
fn pure_helper(): Unit { #() }
fn plain(n: i64, previous: &(() -> i64)): i64 ! {div, overflow} {
  var x := n
  if n == 0 { previous() } else { plain(n - 1, () => x) }
}
fn with_helper(n: i64, previous: &(() -> i64)): i64 ! {div, overflow} {
  var x := n
  if n == 0 { previous() } else { with_helper(n - 1, () => { pure_helper(); x }) }
}
show(&plain(1, () => 99))
show(&with_helper(1, () => 99))
```
stdout = ```
1
1
```
nir.fns.plain = ```nir
fn plain@2(n#4: i64, fnref previous#5: &fn() -> i64 shared S): i64 A = {
  var x#6 := copy n#4;
  if eq(copy n#4, 0i64) then previous#5(): i64 else plain@2(sub<i64>(copy n#4, 1i64), closure borrowed() -> i64 as fn() -> i64 copy S => copy x#6) tier A tick host: i64
}
```
nir.fns.with_helper = ```nir
fn with_helper@4(n#8: i64, fnref previous#9: &fn() -> i64 shared S): i64 A = {
  var x#10 := copy n#8;
  if eq(copy n#8, 0i64) then previous#9(): i64 else with_helper@4(sub<i64>(copy n#8, 1i64), closure borrowed() -> i64 as fn() -> i64 copy S => {
    pure_helper@6(): Unit;
    copy x#10
  }) tier A tick host: i64
}
```

