// A function item lent with `&` to a borrowed parameter whose row has a
// handler is called in that parameter's tier, as the item lent without `&` is.
@ cases.borrowed-fn-item-explicit-ref
llvm.unimplemented = "generate: the LLVM backend does not write a function value that may stop yet"
source = ```tauto
effect tick(): i64
fn run<T>(start: i64, body: &(() -> T ! {tick})): (T × i64) ! {div, overflow} {
  var n := start
  let v := handle { body() } with {
    tick(), k => {
      n := n + 1
      k(n)
    }
  }
  #(v, n)
}
fn session(): i64 ! {tick} {
  let a := perform tick()
  perform tick()
}
show(&(run(0, &session).fst))
show(&(run(0, session).fst))
```
stdout = ```
2
2
```
nir.fns.run = ```nir
fn run@2<'T: Static>(start#4: i64, fnref body#5: &fn() -> 'T shared O): Pair('T, i64) A = {
  var sharedvar_copy n#6 := copy start#4;
  let v#8 := handle 1 O captures(n#6) clones(n#6) do body#5() tier O: 'T with {
    suspend tick() params() answer i64 k k#7 instance() -> i64 legacy => {
      set n#6 := add<i64>(copy n#6, 1i64);
      resume k#7(copy n#6): 'T
    },
  }: 'T;
  Pair::Mk(fst = move v#8, snd = copy n#6): Pair('T, i64)
}
```
nir.fns.session = ```nir
fn session@3(): i64 O = {
  let a#9 := perform tick() resume <=1 instance() -> i64 legacy: i64;
  perform tick() resume <=1 instance() -> i64 legacy: i64
}
```

