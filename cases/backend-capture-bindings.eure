fn with_tick<T, !e>(body: &(() -> T ! {tick} ∪ e)): T ! e {
  handle { body() } with {
    tick(), k => k(5)
  }
}
fn movement(): i64 ! {tick, overflow} { perform tick() + 1 }
show(&with_tick(movement))
show(&with_tick(() => movement()))
```
