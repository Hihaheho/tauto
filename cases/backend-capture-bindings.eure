```

// A handler with a direct arm, around a body that suspends, answers with a
// local of the handling function. The direct arm reads the local itself; the
// handler of the suspending body keeps a clone of its own.
@ cases.direct-arm-local-around-suspending-body
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::par { wait, Ref, Semaphore, ref_new, ref_get, mutex_new, mutex_claim, mutex_take_claimed, mutex_put }
struct(shared) Rt { next: Ref(i64), gate: Semaphore }
effect ask(): Rt direct
fn run<T, !e>(body: &(() -> T ! {ask} ∪ e)): T ! {div, wait, ref_new, mutex_new, mutex_claim, mutex_take_claimed} ∪ e {
  let r := Rt { next: perform ref_new(1), gate: Semaphore::new(1) }
  handle { body() } with {
    ask(), k => k(r)
    return v => v
  }
}
fn read(): i64 ! {ask, wait, ref_get, mutex_claim, mutex_take_claimed, mutex_put} {
  let r := perform ask()
  Semaphore::acquire(r.gate)
  Semaphore::release(r.gate)
  perform ref_get(r.next)
}
show(&run(() => read()))
```
stdout = "1\n"
nir.fns.run = ```nir
fn run@2<'T: Static>(fnref body#12: &fn() -> 'T shared O): 'T O = {
  let r#13 := Rt::Mk(next = perform ref_new(1i64) direct instance<i64>(i64) -> std Ref(i64) legacy: std Ref(i64), gate = Semaphore::new@6(1u64): Semaphore): Rt;
  handle 1 O captures(r#13) clones(r#13) do body#12() tier O: 'T with {
    return v#14: 'T => move v#14,
    direct ask() params() answer Unit instance() -> Rt legacy => clone r#13,
  }: 'T
}
```
nir.fns.read = ```nir
fn read@3(): i64 O = {
  let r#15 := perform ask() direct instance() -> Rt legacy: Rt;
  Semaphore::acquire@7(clone r#15.gate: Semaphore) tier O: Unit;
  Semaphore::release@8(clone r#15.gate: Semaphore) tier O: Unit;
  perform ref_get(clone r#15.next: std Ref(i64)) direct instance<i64>(std Ref(i64)) -> i64 legacy: i64
}
```

// A borrowing closure that captures a `&mut` parameter writes through that
// borrow: each call pushes onto the caller's vector, on every backend.
@ cases.borrowing-closure-writes-through-mut-param
source = ```nib
fn apply(f: &(() -> Unit ! {})): Unit ! {} { f(); f() }
fn fill(v: &mut Vec(i64)): Unit ! {} { apply(() => Vec::push(v, 1)) }
fn fill_local(v: &mut Vec(i64)): Unit ! {} {
  let f := () => Vec::push(v, 2)
  f()
  f()
}
fn go(): u64 ! {} {
  var v := Vec::new()
  fill(&mut v)
  fill_local(&mut v)
  Vec::len(&v)
}
show(&go())
```
stdout = "4\n"
