// A closure that matches on a captured var and assigns it in an arm.
@ cases.captured-var-assigned-in-match-arm
llvm.unimplemented = "generate: the LLVM backend does not write a `var` shared with a closure yet"
source = ```nib
fn pop_twice(): i64 {
  var stack := Cons(1, Cons(2, Cons(3, Nil)))
  let pop := () => {
    match stack {
      Nil => #()
      Cons(_, rest) => { stack := rest }
    }
  }
  pop()
  pop()
  match stack { Nil => 0, Cons(o, _) => o }
}
show(&pop_twice())
```
stdout = "3\n"
nir.fns.pop_twice = ```nir
fn pop_twice@2(): i64 S = {
  var sharedvar stack#4 := List::Cons(1i64, List::Cons(2i64, List::Cons(3i64, List::Nil: List(i64)): List(i64)): List(i64)): List(i64);
  let pop#6 := closure() -> Unit as fn() -> Unit copy S clones(stack#4) => match clone stack#4 {
    List::Nil => (),
    List::Cons(_, rest#5: List(i64)) => {
      set stack#4 := clone rest#5;
    },
  };
  pop#6(): Unit;
  pop#6(): Unit;
  match clone stack#4 {
    List::Nil => 0i64,
    List::Cons(o#7: i64, _) => copy o#7,
  }
}
```

// A borrowing closure that calls an owned function that suspends borrows the
// function, and each call of the closure calls it again.
@ cases.borrowing-closure-calls-owned-suspending-fn
source = ```nib
import std::builtin::par
fn call<T, !e>(body: &(() -> T ! e)): T ! e { body() }
fn twice<!e>(body: &(() -> nat ! e)): nat ! e { body() + body() }
fn render(draw: () -> Text ! {wait}): Text ! {wait} { call(() => draw()) }
fn render_twice(draw: () -> nat ! {wait}): nat ! {wait} { twice(() => draw()) }
show(&render(() => "ok"))
show(&render_twice(() => 21))
```
