// A constructor of a file's own type means that constructor wherever the
// file writes its name alone, also when the name is one the language keeps
// for itself with no declaration in the standard library (`Info`,
// `Div`, `Exceeded`, `Level`), as it does for a name the library declares
// (`List`). The library's type of the name still means the type.
@ cases.constructor-named-like-library
source = ```tauto
pub(open) enum Level { Debug, Info }
enum Sym { Char, Div, Exceeded, Level, List }

fn info(): Level { Info }

fn rank(x: Level): Nat {
  match x {
    Debug => 0
    Info => 1
  }
}

fn sym(x: Sym): Nat {
  match x {
    Char => 0
    Div => 1
    Exceeded => 2
    Level => 3
    List => 4
  }
}

show(&rank(info()))
show(&sym(Level))
show(&sym(Char))
```
stdout = "1\n3\n0\n"

// `#(a, b)` and `#()` are the language's products also in a file with
// constructors named `Pair` and `Star`: the syntax is read as the library's
// `Pair::Mk` and `Star`, so an expression names the file's constructor with its
// type (`Atom::Pair`). A pattern names it alone.
@ cases.constructors-named-pair-and-star-leave-products-alone
source = ```tauto
enum Atom { Star, Pair(Bool) }

fn pair(): Nat × Nat { #(1, 2) }

fn none(): Unit { #() }

fn atom(a: Atom): Bool {
  match a {
    Star => false
    Pair(b) => b
  }
}

show(&pair())
show(&atom(Atom::Pair(true)))
```
stdout = "#(1, 2)\ntrue\n"

// A name written where a type is wanted is the library's type, also when the
// file has a constructor of that name: a constructor is never a type.
@ cases.constructors-named-like-types-in-type-position
source = ```tauto
enum Sym { Bool, Option, Unit }

fn flip(b: Bool): Bool { not(b) }

fn first(o: Option(Nat)): Nat {
  match o {
    Some(n) => n
    None => 0
  }
}

fn nothing(u: Unit): Unit { u }

fn sym(s: Sym): Nat {
  match s {
    Bool => 0
    Option => 1
    Unit => 2
  }
}

show(&flip(true))
show(&first(Some(3)))
show(&sym(Unit))
```
stdout = "false\n3\n2\n"
