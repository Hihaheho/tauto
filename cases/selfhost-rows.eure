// Differential cases: each named route compares the self-hosted component with its oracle, not only evaluator success.

// rows_match_on_hard_cases
@ cases.rows-match-on-hard-cases-001
source = ```tauto
effect ask(q: i64): i64
fn f(): i64 ! {ask} { perform ask(1) }
```
differential = "rows"

