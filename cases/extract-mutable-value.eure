@ cases.a-mutable-borrow-returned-as-a-value-is-copied
source = ```tauto
fn advance(state: &mut Nat): Nat { *state := state + 1; state }
fn combine(first: Nat, second: Nat): Nat { first * 10 + second }
fn result(): Nat {
  var state := 2;
  let combined := combine(state, advance(&mut state));
  combined + state * 100
}
theorem ordered(): result() = 323 { Refl }
show(&result())
```
checks_all = "ok"
stdout = "323\n"

@ cases.a-place-lent-to-a-call-is-written-by-an-argument-before-it
source = ```tauto
fn advance(state: &mut Nat): Nat { *state := state + 1; 5 }
fn combine(first: Nat, state: &mut Nat): Nat { state * 10 + first }
fn result(): Nat {
  var state := 2;
  combine(advance(&mut state), &mut state)
}
theorem ordered(): result() = 35 { Refl }
show(&result())
```
checks_all = "ok"
stdout = "35\n"

@ cases.a-place-lent-to-a-call-is-written-by-an-argument-after-it
source = ```tauto
fn advance(state: &mut Nat): Nat { *state := state + 1; 5 }
fn combine(state: &mut Nat, second: Nat): Nat { state * 10 + second }
fn result(): Nat {
  var state := 2;
  combine(&mut state, advance(&mut state))
}
theorem ordered(): result() = 35 { Refl }
show(&result())
```
checks_all = "ok"
