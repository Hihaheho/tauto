// kernel_replays_mutual_nested_and_universe_declarations
@ cases.kernel-replays-mutual-nested-and-universe-declarations-025
source = ```tauto

mutual {
  inductive Tree0: Type { Node0(ts: Forest0): Tree0 }
  inductive Forest0: Type { Empty0: Forest0
 More0(t: Tree0, ts: Forest0): Forest0 }
}
inductive Seq0(A: Type): Type { Seqnil0: Seq0(A)
 Seqcons0(h: A, t: Seq0(A)): Seq0(A) }
inductive Nested0: Type { Mk(ts: Seq0(Nested0)): Nested0 }
mutual {
  fn tree_size0(t: Tree0): Nat {
    ⊢ Nat from match t { Node0(ts) => Succ(forest_size0(ts)) }
  }
  fn forest_size0(ts: Forest0): Nat {
    ⊢ Nat from match ts {
      Empty0 => 0
      More0(t, tail) => tree_size0(t) + forest_size0(tail)
    }
  }
}
theorem mutual_result0(): tree_size0(Node0(More0(Node0(Empty0), Empty0))) = 2 { Refl }
mutual {
  fn nested_size0(t: Nested0): Nat {
    ⊢ Nat from match t { Mk(ts) => Succ(seq_size0(ts)) }
  }
  fn seq_size0(ts: Seq0(Nested0)): Nat {
    ⊢ Nat from match ts {
      Seqnil0 => 0
      Seqcons0(h, tail) => nested_size0(h) + seq_size0(tail)
    }
  }
}
theorem nested_result0(): nested_size0(Nested0::Mk(Seqcons0(Nested0::Mk(Seqnil0), Seqnil0))) = 2 { Refl }
theorem universe0<u: Level, A: Type(u)>(x: A): A { x }
theorem instantiated0(): Nat { universe0(0, 3) }
```
checks_all = "checked"
differential = "kernel"

