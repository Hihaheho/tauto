description = "Expanding a macro in a program that has a class method with generics of its own and imports `std::hashmap`: the macro runtime copies each use of the method, and the calls in the propositions of std's hash table theorems, which the checker gives no type arguments to, do not stop the copy."

@ cases.macro-beside-generic-class-method-and-hashmap
entry = "main.taut"
files."lib.taut" = ````tauto
import std::builtin::macro
import std::hashmap { HashMap }
pub(open) struct(shared) Box(T: Shared + NoBorrow) { v: T }
pub class Readable(F: (Shared) -> Shared) { fn read<T: Shared + NoBorrow>(s: F(T)): T }
instance Readable(Box) { fn read<T: Shared + NoBorrow>(s: Box(T)): T { s.v } }
pub fn get<F: (Shared) -> Shared, T: Shared + NoBorrow>(s: F(T)): T where Readable(F) { Readable::read(s) }
pub fn size(m: &HashMap(u64, u64)): u64 { 0 }
pub macro fn m(e: SynExpr): SynExpr { quote { 1 } }
````
files."main.taut" = ````tauto
import "lib.taut"
let x := m!(0)
show(&get(Box { v: x }))
````
stdout = "1\n"
