// Syntax macros over LALR(1) grammars (`%grammar_type 'LALR(1)'`). A
// `{{par:NAME}}` is the grammar in `grammars/NAME.par`; its tables are in
// `.tauto-syntax`, made by `scripts/generate-syntax-fixtures.sh`.

// A left recursive rule makes the same kind of typed tree as any rule: an enum
// with a variant for each alternative, and the declarations listed are the
// ones made.
@ cases.a-left-recursive-rule-makes-a-typed-tree
files."main.nib" = ````nib
import std::prelude::Macro

syntax!(lalr_sum, ```par
{{par:lalr_sum}}```) => struct Eqn, struct Paren, enum Sum, enum Term, fn parse
````
expands = ```nib
module lalr_sum {
  pub(open) struct Eqn {
    span: SynSpan, sum: lalr_sum::Sum, equals: SynToken, sum_2: lalr_sum::Sum
  }
  pub(open) struct Paren {
    span: SynSpan, l_paren: SynToken, sum: lalr_sum::Sum, r_paren: SynToken
  }
  pub(open) enum Sum {
    SumPlusTerm { span: SynSpan, sum: lalr_sum::Sum, plus: SynToken, term: lalr_sum::Term }
    Term(lalr_sum::Term)
  }
  pub(open) enum Term {
    Num(SynToken)
    Paren(lalr_sum::Paren)
  }
  pub(open) fn parse(t: Text): Result(lalr_sum::Eqn, SynDiag) { Syn::parse("lalr_sum", "217889452ee1a277575c49ee08ae56b240d90c7c465b87bcd93390a2d40b2068", t) }
}
```

// The list of the declarations made must be what the grammar makes.
@ cases.the-declarations-of-an-lalr-grammar-are-listed-in-full
files."main.nib" = ````nib
import std::prelude::Macro

syntax!(lalr_sum, ```par
{{par:lalr_sum}}```) => struct Eqn, struct Paren, enum Term, fn parse
