// A macro reads the left recursive tree: `1 + 2 + 3` is `(1 + 2) + 3`.
@ cases.a-macro-folds-a-left-recursive-tree
files."lalr.nib" = ````nib
import std::builtin::macro
syntax!(lalr_sum, ```par
{{par:lalr_sum}}```) => struct Eqn, struct Paren, enum Sum, enum Term, fn parse
pub fn ls_term(t: lalr_sum::Term): SynExpr ! {macro_error, div} {
  match t {
    Num(tok) => Syn::nat(tok)
    Paren(p) => ls_sum(p.sum)
  }
}

pub fn ls_sum(s: lalr_sum::Sum): SynExpr ! {macro_error, div} {
  match s {
    SumPlusTerm(span, left, plus, term) => {
      let l := ls_sum(left)
      let r := ls_term(term)
      quote { $l + $r }
    }
    Term(t) => ls_term(t)
  }
}

pub macro fn lalr_sum(e: lalr_sum::Eqn): SynExpr ! {macro_error, div} {
  let l := ls_sum(e.sum)
  let r := ls_sum(e.sum_2)
  quote { Eq(Nat, $l, $r) }
}
````
files."main.nib" = ````nib
import "lalr.nib"
theorem sums(): lalr_sum!(`1 + 2 + 3 = 6`) { Refl(Nat, 6) }
theorem nested(): lalr_sum!(`(1 + 2) + 3 + 4 = 10`) { Refl(Nat, 10) }
````
expands = ```nib
theorem sums(): 1 + 2 + 3 = 6 { Eq::Refl(Nat, 6) }
theorem nested(): 1 + 2 + 3 + 4 = 10 { Eq::Refl(Nat, 10) }
```

// The parser runs at run time: the tree of `1 + 2 + 3` has the sum of
// `1 + 2` on its left, and a syntax error says what was expected.
@ cases.an-lalr-parser-runs
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Syn::parse` yet"
entry = "main.taut"
stdout = ```
2
"1"
"3"
"6"
1
"paren"
"macro-syntax-expected-found"
"macro-syntax-expected-end"
```
files."main.taut" = ````tauto
import std::builtin::macro

syntax!(lalr_sum, ```par
{{par:lalr_sum}}```) => struct Eqn, struct Paren, enum Sum, enum Term, fn parse

fn term_text(t: lalr_sum::Term): Text {
  match t {
    Num(tok) => tok.text
    Paren(p) => "paren"
  }
}

// The sums nest on the left: the number of `+` above the first term.
fn depth(s: lalr_sum::Sum): u64 ! {overflow} {
  match s {
    SumPlusTerm(span, left, plus, term) => depth(left) + 1
    Term(t) => 0
  }
}

fn first(s: lalr_sum::Sum): Text {
  match s {
    SumPlusTerm(span, left, plus, term) => first(left)
    Term(t) => term_text(t)
  }
}

fn last(s: lalr_sum::Sum): Text {
  match s {
    SumPlusTerm(span, left, plus, term) => term_text(term)
    Term(t) => term_text(t)
  }
}

match lalr_sum::parse("1 + 2 + 3 = 6") {
  Ok(e) => {
    show(&depth(e.sum))
    show(&first(e.sum))
    show(&last(e.sum))
    show(&last(e.sum_2))
  }
  Err(d) => show(&d.message)
}
match lalr_sum::parse("(1 + 2) + 3 = 3") {
  Ok(e) => {
    show(&depth(e.sum))
    show(&first(e.sum))
  }
  Err(d) => show(&d.message)
}
match lalr_sum::parse("1 + = 3") {
  Ok(e) => show(&e.equals.text)
  Err(d) => show(&d.message)
}
match lalr_sum::parse("1 + 2") {
  Ok(e) => show(&e.equals.text)
  Err(d) => show(&d.message)
}
````

// A parse at run time reads the program's own data, so a text longer than the
// limit on a syntax literal (1 MiB) is read: here a number of 2^20 digits, then ` = 2`.
@ cases.a-run-time-parse-reads-a-text-longer-than-a-macro-input
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Syn::parse` yet"
entry = "main.taut"
stdout = ```
0
"2"
```
// The JavaScript backend's parse of a text this long takes more than node's 2 GB heap.
javascript.bug = "runtime: JavaScript heap out of memory"
files."main.taut" = ````tauto
import std::builtin::macro
import std::prelude::std { concat }

syntax!(lalr_sum, ```par
{{par:lalr_sum}}```) => struct Eqn, struct Paren, enum Sum, enum Term, fn parse

fn depth(s: lalr_sum::Sum): u64 ! {overflow} {
  match s {
    SumPlusTerm(span, left, plus, term) => depth(left) + 1
    Term(t) => 0
  }
}

fn rhs(s: lalr_sum::Sum): Text {
  match s {
    SumPlusTerm(span, left, plus, term) => "sum"
    Term(t) => match t {
      Num(tok) => tok.text
      Paren(p) => "paren"
    }
  }
}

// `t` written 2^n times.
fn doubled(t: Text, n: u64): Text ! {overflow} {
  if n == 0 { t } else { doubled(concat(t, t), n - 1) }
}

match lalr_sum::parse(concat(doubled("1", 20), " = 2")) {
  Ok(e) => {
    show(&depth(e.sum))
    show(&rhs(e.sum_2))
  }
  Err(d) => show(&d.message)
}
````
