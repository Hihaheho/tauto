files."main.nib" = ````nib
import "nat.nib"
theorem lit(b: Nat): nat!(`Zero + b == b`) { Refl(Nat, b) }
````
macro_error = "macro.argument: macro nat takes an expression, not a syntax literal"

@ cases.a-product-type-is-written-in-a-quote
files."pair.nib" = ````nib
import std::prelude::Macro

pub macro fn with_count(e: SynExpr): SynExpr { quote { $e × Nat × Bool } }
````
files."main.nib" = ````nib
import "pair.nib"
fn count_of(p: with_count!(Text)): Nat {
  match p {
    #(_, n, _) => n
  }
}
fn main() { count_of(#("a", 3, true)); }
````
expands = ```nib
fn count_of(p: Text × Nat × Bool): Nat { match p {
  #(_, n, _) => n
} }
fn main() { count_of(#("a", 3, true)) }
```
trace = ["with_count"]
