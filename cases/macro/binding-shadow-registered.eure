import std::prelude::Macro
import std::prelude::Par

fn tree(): Unit {
  let cell := Ref::new(false)
  Ref::set(cell, true)
}

pub fn pick_fmt(ts: List(SynTok), width: u64): Option(Text) ! {Div} {
  match ts {
    Nil => None
    Cons(tree, rest) => Some(tree.text)
  }
}

