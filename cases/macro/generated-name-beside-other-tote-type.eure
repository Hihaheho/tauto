// A macro makes a definition whose body names the prelude's `Unit` (`def Point::kind := Unit`),
// and a tote that depends on the macro's tote reads it. Another dependency declares types
// named `Point` and `Unit` too. The body is read with the names of the tote the macro was
// written in, so `Unit` there is still the prelude's.
@ cases.a-made-definition-names-the-prelude-type-beside-other-tote-types
files_tote = "app"
tote_errors = []
files."macros/Tauto.eure" = ```eure
package {
  name = "macros"
  version = "0.1.0"
}
```
files."macros/src/tag.taut" = ````tauto
import std::builtin::macro
import std::base

fn kind_def(model: SynIdent, at: SynSpan): SynStmt ! {macro_error} {
  let quoted := quote stmts {
    def kind(): Type := Unit
  }
  match quoted {
    Cons(StDef(t), Nil) => StDef(SynTheorem {
      name: Syn::decl_name(model, concat(model.name, "::kind")),
      implicit: t.implicit,
      params: t.params,
      ty: t.ty,
      body: t.body,
      span: at,
      unused: t.unused,
      unused_params: t.unused_params,
    })
    other => Syn::error(at, "tag! did not build a def")
  }
}

pub macro fn tag(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error} {
  match s {
    StStruct(d) => [kind_def(d.name, d.span)]
    other => Syn::error(Syn::call_span(), "tag! goes on a struct")
  }
}
````
files."macros/src/use_tag.taut" = ```tauto
import "tag.taut" { tag }

@tag!("x") => def Point::kind
pub struct Point { x: i64 }

pub fn point_kind(): Type { Point::kind() }
```
