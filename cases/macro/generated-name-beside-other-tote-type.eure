// A macro makes a declaration under a type's name (`=> fn S::made`), and the file that calls
// the macro uses it (`S::made()`). Another tote that the importer also depends on declares a
// type of the same name `S`, so the two `S` are named apart by their full names. The call
// `S::made()` still means the declaration the macro made, as it does for one the file writes
// itself (`fn S::twice`): checking the importer and checking the macro's tote alone agree.

@ cases.a-made-function-under-a-type-name-another-tote-also-declares
files_tote = "app"
tote_errors = []
files."macros/Tauto.eure" = ```eure
package {
  name = "macros"
  version = "0.1.0"
}
```
files."macros/src/made.taut" = ````tauto
import std::builtin::macro
import std::base

pub macro fn made(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error} {
  let quoted := quote stmts {
    fn made(): i64 { 7 }
  }
  match #(s, quoted) {
    #(StStruct(d), Cons(StFn(f), Nil)) => [StFn(SynFn {
      name: Syn::decl_name(d.name, concat(d.name.name, "::made")),
      generics: f.generics, generic_types: f.generic_types, bounds: f.bounds,
      params: f.params, r#borrows: f.r#borrows, param_types: f.param_types,
      result: f.result, effects: f.effects, where_: f.where_, body: f.body,
      span: d.span, unused: f.unused, unused_params: f.unused_params,
      unused_generics: f.unused_generics,
    })]
    other => Syn::error(Syn::call_span(), "made! goes on a struct")
  }
}
````
files."lib/Tauto.eure" = ```eure
package {
  name = "lib"
  version = "0.1.0"
}

dependencies {
  macros { path = "../macros" }
}
```
files."lib/src/shapes.taut" = ```tauto
import macros::made { made }

@made!("s") => fn S::made
pub(open) struct S { a: i64 }

pub fn S::twice(): i64 ! {overflow} { S::made() + S::made() }
```
files."other/Tauto.eure" = ```eure
