  other { path = "../other" }
}
```
files."app/src/main.taut" = ```tauto
import lib::shapes { S }
import other::kinds { T }

fn f(t: T, s: S): i64 ! {overflow} { t.x + s.a + S::made() + S::twice() }

perform main(() => show(&f(T { x: 1 }, S { a: 2 })))
```
stdout = "24\n"

// The importer names only the two types (`S` from the macro's tote, `T` from the other tote that
// also declares an `S`) and never calls the macro-made function itself. Checking it still reads
// `lib`'s `S::twice`, which calls `S::made()`, against `lib`'s own `S`.
@ cases.a-made-function-is-found-when-the-importer-names-only-the-types
