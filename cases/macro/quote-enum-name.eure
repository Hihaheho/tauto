// A quote fills `SynIdent` at a declaration name: `enum $name { Execute(…) }`
// checks like a literal enum name. Constructors that callers use are named
// with `Syn::decl_name` (same as other quote-made declarations).

@ cases.a-macro-with-a-spliced-enum-name-checks
source = path`../fixtures/macro-quote-enum-name.taut`
checks_all = "ok"
checks.mk = "skipped"

@ cases.a-quote-splices-synident-into-an-enum-name
entry = "main.taut"
files."mk.taut" = path`../fixtures/macro-quote-enum-name.taut`
files."main.taut" = ````tauto
import "mk.taut"

@mk!(0) => enum E
fn seed(): i64 { 0 }

show(&1)
````
stdout = "1\n"

@ cases.a-spliced-enum-constructor-named-for-callers-is-usable
entry = "main.taut"
files."mk.taut" = ````tauto
import std::builtin::macro

pub macro fn mk(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error} {
  match s {
    StFn(f) => {
      let name := Syn::decl_name(f.name, "E")
      let ctor := Syn::decl_name(f.name, "Execute")
      quote stmts {
        enum $name { $ctor(i64) }
      }
    }
    other => Syn::error(Syn::call_span(), "fn")
  }
}
````
files."main.taut" = ````tauto
import "mk.taut"

@mk!(0) => enum E
fn seed(): i64 { 0 }

fn use_e(x: E): i64 {
  match x {
    Execute(n) => n
  }
}

show(&use_e(Execute(3)))
````
stdout = "3\n"
