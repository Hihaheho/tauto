// An attribute macro is given its declaration once the declaration checks
// with what is before it. What the file imports from another file is the
// declaration of that file there too: a rule whose index calls a function of
// this file that calls an imported one is read and expanded.

@ cases.an-attribute-macro-reads-a-declaration-that-uses-an-imported-function
files_tote = "r"
files."r/Tauto.eure" = 'package { name = "r"  version = "0.1.0" }'
files."r/src/ty.taut" = ````tauto
pub(open) inductive Ty: Type {
  TZ: Ty
  TS(t: Ty): Ty
}

pub fn bump(t: Ty): Ty { TS(t) }
````
files."r/src/rules.taut" = ````tauto
import std::mode { mode }
import "ty.taut" { Ty, bump }

pub fn shift(t: Ty): Ty { bump(t) }

@mode!(`step(rec t, out u) -> Step { Stepped | Stuck }`) => inductive Step, fn step
pub(open) inductive Steps: (Ty, Ty) -> Prop {
  SZ: Steps(TZ, shift(TZ))
}

pub fn steps(t: Ty): Nat {
  match step(t) {
    Stepped(u, h, unique) => 1
    Stuck(refute) => 0
  }
}
````
files."r/src/main.taut" = ````tauto
import "ty.taut" { Ty }
import "rules.taut" { steps }

perform main(() => {
  show(&steps(TZ))
  show(&steps(TS(TZ)))
})
````
stdout = ```
1
0
```

// A declaration that does not check is not given to the macro, and the
// macro's attribute says so rather than making nothing without a word.
@ cases.an-attribute-macro-whose-declaration-does-not-check-says-it-did-not-run
imports = [path`../../std/mode.taut`]
entry = "input/main.taut"
files."input/main.taut" = ```tauto
@mode!(`depth(rec l, out n) -> Measured { measured | unmeasured }`) => inductive Measured, fn depth
inductive Depth: (List(Nat)) -> (Nat) -> Prop {
  DNil: Depth(Nil, Nil)
}
```
diagnostics[] {
  stage = "checks"
  message = "cannot infer the generic `A` of `List::Nil`"
}
diagnostics[] {
  stage = "checks"
  message = "was not run"
}
