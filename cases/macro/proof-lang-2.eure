@ cases.a-case-analysis-after-a-file-that-declares-never
entry = "main.taut"
files."main.taut" = ````tauto
import std::base
import std::uint
import std::proof::lang { proof }
import std::proof::forms { proof_by, proof_case, proof_consider }

theorem same(b: Bool): b = b {
  proof!(```
    Consider b.
      Case true. By Refl.
      Case false. By Refl.
  ```)
}
````
