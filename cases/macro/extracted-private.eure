{{par:aif}}```, with(fmt: pretty)) => struct Aif, fn parse
fn Helper::keep(value: SynExpr): SynExpr { leaf(value) }
pub macro fn view(value: view::Aif): SynExpr { Helper::keep(value.tauto_expr) }
