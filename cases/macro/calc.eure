source = ````tauto
theorem t(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(a, b) {
  calc!(```
    $Nat::add(a, b)
    = $Nat::add(b, a) from $(Refl)
    = $Nat::add(a, b) from $Nat::add_comm(b, a)
    ```)
}
````
checks.t = "error: "

@ cases.calc-macro-rejects-mixed-relations
imports = [path`../../std/Calc.taut`, path`../../std/Base.taut`]
source = ````tauto
theorem t(p: Bool): p = p {
  calc!(```
    $p
    = $p from $(Refl)
    ↔ $p from $(Refl)
    ```)
}
````
macro_error = "macro.error"

// A `$` expression is resolved in the scope of the module that calls the macro.
@ cases.calc-macro-resolves-in-the-calling-module
imports = [path`../../std/Calc.taut`, path`../../std/Base.taut`, path`../../std/Nat.taut`]
source = ````tauto
module Nat {
  pub theorem plain(a: Nat, b: Nat): add(a, b) = add(b, a) {
    Nat::add_comm(a, b)
  }

  pub theorem via_calc(a: Nat, b: Nat): add(a, b) = add(b, a) {
    calc!(```
      $add(a, b)
      = $add(b, a) from $Nat::add_comm(a, b)
      ```)
  }
}
````
checks."Nat::plain" = "ok"
checks."Nat::via_calc" = "ok"
diagnostics = []

// A `$` name is read as tauto reads a name: it may go on in any letter.
@ cases.calc-macro-reads-a-non-ascii-name
imports = [path`../../std/Calc.taut`, path`../../std/Base.taut`]
source = ````tauto
fn Iの数(n: Nat): Nat { n }

theorem t(n: Nat): Iの数(n) = Iの数(n) {
  calc!(```
    $Iの数(n)
    = $Iの数(n) from $(Refl)
    ```)
}
````
checks.t = "ok"
