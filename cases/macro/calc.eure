import "lib/Calc.taut"

theorem t(a: Nat, b: Nat, c: Nat): Nat::add(Nat::add(a, b), c) = Nat::add(Nat::add(a, c), b) {
  calc!(```
    $Nat::add(Nat::add(a, b), c)
       = $Nat::add(a, Nat::add(b, c))   from $Nat::add_assoc(a, b, c)
    =   $Nat::add(a, Nat::add(c, b)) from   $Eq::congr(⟦Nat::add(a, □)⟧, Nat::add_comm(b, c))

    = $Nat::add(Nat::add(a, c), b) from $Eq::sym(Nat::add_assoc(a, c, b))
    ```)
}

theorem both(p: Bool): Iff(p, p) {
  calc!(```
    $p
        ↔   $p from $Iff::refl(p)

    ↔ $p   from $Iff::refl(p)
    ```)
}

theorem one(n: Nat): n = n {
  calc!(`$n   =   $n  from  $(Refl)`)
}
