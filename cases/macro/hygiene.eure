// Hygiene (`docs/design/macro-semantics.md`).

@ cases.a-temporary-of-a-macro-does-not-take-the-users-name
files."swap.nib" = ````nib
syntax swp => struct swp_Pair, fn swp_parse = ```par
{{par:swap}}```
fn swap_expand(p: swp_Pair) -> List(SynStmt) {
  let a = syn_ident(p.name)
  let b = syn_ident(p.name_2)
  quote stmts {
    let tmp = $a
    $a := $b
    $b := tmp
  }
}

macro swap = swap_expand
````
files."main.nib" = ````nib
import "swap.nib"
var tmp = 1
var other = 2
swap!(`tmp other`)
perform show("tmp", tmp)
perform show("other", other)
````
shows = ["tmp = 2", "other = 1"]
expands = ```nib
var tmp = 1
var other = 2
let tmp#1 = tmp
tmp := other
other := tmp#1
perform show("tmp", tmp)
perform show("other", other)
```
trace = ["swap"]

// An explicit capture: the binder `it` borrows the context of the call
// (`syn_ident_like`), so the user's `${it + 1}` is bound by it. The lint
// `macro-capture` forbids this in `std/` and `meta/`.
@ cases.an-anaphoric-name-is-captured-explicitly
files."aif.nib" = ````nib
syntax aif => struct aif_Aif, fn aif_parse = ```par
{{par:aif}}```
fn aif_expand(a: aif_Aif) -> SynExpr {
  let it = syn_ident_like(syn_ident(a.kw_then), "it")
  let c = a.tauto_expr
  let t = a.tauto_expr_2
  let e = a.tauto_expr_3
  quote {
    match $c {
      Some($it) => $t
      None => $e
    }
  }
}
macro aif = aif_expand
````
files."main.nib" = ````nib
import "aif.nib"
fn lookup(k: u64) -> Option(u64) { if k == 1 { Some(41) } else { None } }
let n = aif!(`${lookup(1)} then ${it + 1} else ${0}`)
let m = aif!(`${lookup(2)} then ${it + 1} else ${0}`)
perform show("n", n)
perform show("m", m)
````
expands = ```nib
fn lookup(k: u64) -> Option(u64) { if k == 1 { Some(41) } else { None } }
let n = match lookup(1) {
  Some(it) => it + 1
  None => 0
}
let m = match lookup(2) {
  Some(it) => it + 1
  None => 0
}
perform show("n", n)
perform show("m", m)
```
shows = ["n = 42", "m = 0"]

// Without `syn_ident_like` the `it` of the `quote` has the macro's scope, and
// the user's `it` is not bound by it (running it says `it is not defined`).
@ cases.a-name-of-a-quote-does-not-bind-the-users-name
files."aif.nib" = ````nib
syntax aif => struct aif_Aif, fn aif_parse = ```par
{{par:aif}}```
fn aif_expand(a: aif_Aif) -> SynExpr {
  let c = a.tauto_expr
  let t = a.tauto_expr_2
  let e = a.tauto_expr_3
  quote {
    match $c {
      Some(it) => $t
      None => $e
    }
  }
}
macro aif = aif_expand
````
files."main.nib" = ````nib
import "aif.nib"
fn lookup(k: u64) -> Option(u64) { if k == 1 { Some(41) } else { None } }
let n = aif!(`${lookup(1)} then ${it + 1} else ${0}`)
````
expands = ```nib
fn lookup(k: u64) -> Option(u64) { if k == 1 { Some(41) } else { None } }
let n = match lookup(1) {
  Some(it#1) => it + 1
  None => 0
}
```
