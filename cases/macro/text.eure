// Templates of the syntax `text` (`std/template.taut`): `text!`, the options called in a hole,
// and macros of other files that read a template through `std::template`.

@ cases.text-renders-holes-with-to-text
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Buf::new` yet"
entry = "main.taut"
files."main.taut" = ````tauto
import std::template { text }
struct Req { path: Text, status: i64 }
fn greet(name: Text, n: i64): Text ! {overflow} {
  text!(`Hello, $name! You have ${n + 1} new messages ($$5 each).`)
}
fn hello(name: Text): Text ! {} { text!(`Hello, $name`) }
fn served(r: Req): Text { text!(`$(r.path): $(r.status)`) }
fn plain(): Text { text!(`no holes`) }
fn one(n: i64): Text { text!(`$n`) }
show(&greet("Ryo", 2))
show(&hello("Ryo"))
show(&served(Req { path: "/a", status: 200 }))
show(&plain())
show(&one(7))
````
stdout = ```
"Hello, Ryo! You have 3 new messages ($5 each)."
"Hello, Ryo"
"/a: 200"
"no holes"
"7"
```

