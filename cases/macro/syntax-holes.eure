// Holes and start symbols of an `inductive_syntax!` (`docs/design/macro.md`「Holes and start
// symbols」). A `{{par:NAME}}` is the grammar in `grammars/NAME.par`; its tables are in
// `.tauto-syntax`, made by `scripts/generate-syntax-fixtures.taut`.

// `one` takes a `Value`, the second start symbol, so its argument is one value. A hole is a
// macro argument's: `Value::I` has no constructor for it.
@ cases.a-macro-takes-the-second-start-symbol-and-a-hole
files."ir.taut" = ````tauto
import std::builtin::macro { SynExpr, Syn, macro_error }
import std::text { Text }

inductive_syntax!(ir, ```par
{{par:ir_holes}}```) =>
  struct Block, enum Value, fn parse, inductive Block::I, inductive Value::I, fn Block::to_i,
  fn Value::to_i, fn Value_list::to_i

pub macro fn one(v: ir::Value): SynExpr ! {macro_error, div} {
  match v {
    Hole(e) => e
    Num(t) => Syn::nat(t)
  }
}
````
files."main.taut" = ````tauto
import "ir.taut" { ir, one }

theorem a_hole(n: Nat): one!(`$n`) = n { Refl }
theorem a_number(): Eq(Nat, one!(`7`), 7) { Refl }

// `Value::I` has no constructor for a hole: one arm covers it.
fn digits(v: ir::Value::I): Text {
  match v {
    Num_I(t) => t
  }
}

// `to_i` is `None` on a tree that holds a hole.
fn proof_tree(b: ir::Block): Option(ir::Block::I) {
  ir::Block::to_i(b)
}
````
entry = "main.taut"
checks.a_hole = "ok"
checks.a_number = "ok"

// The same with LALR(1) tables: the second start symbol's tables have states of their own.
