@ cases.a-match-variable-hides-a-global-function-of-the-same-name
files."binding-defs.taut" = ````taut
import std::builtin::macro
import std::builtin::par

fn first(): Unit ! {ref_new, ref_set} {
  let cell := perform ref_new(false)
  perform ref_set(cell, true)
}
fn choose(flag: Option(Bool), value: SynExpr): SynExpr {
  match flag {
    Some(first) => if first { value } else { quote { 0 } }
    None => quote { 0 }
  }
}
pub macro fn answer(value: SynExpr): SynExpr { choose(Some(true), value) }
````
files."binding.taut" = ````taut
import "binding-defs.taut"
show(&(answer!(42)))
````
entry = "binding.taut"
stdout = "42\n"

@ cases.a-macro-function-may-use-a-shared-cell
files."binding-defs.taut" = ````taut
import std::builtin::macro
import std::builtin::par

fn first(): Unit ! {ref_new, ref_set} {
  let cell := perform ref_new(false)
  perform ref_set(cell, true)
}
fn choose(value: SynExpr): SynExpr ! {ref_new, ref_set} {
  first()
  value
}
pub macro fn answer(value: SynExpr): SynExpr ! {ref_new, ref_set} { choose(value) }
````
files."binding.taut" = ````taut
import "binding-defs.taut"
show(&(answer!(42)))
````
