@ cases.a-list-literal-with-a-rest-and-nested-lists-in-the-prose
entry = "main.taut"
files."main.taut" = ````tauto
import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_we }

theorem append_cons<A>(x: A, rest: List(A), ys: List(A)): List::append([x, ..rest], ys) = [x, ..List::append(rest, ys)] {
  proof!(```
    We have List::append($[x, ..rest], ys) = $[x, ..List::append(rest, ys)].
  ```)
}

theorem append_nested(a: Nat, b: Nat): List::append([[a]], [[b]]) = [[a], [b]] {
  proof!(```
    We have List::append($[[a]], $[[b]]) = $[[a], [b]].
  ```)
}
````
checks.append_cons = "ok"
checks.append_nested = "ok"
diagnostics = []

@ cases.an-induction-whose-case-is-a-case-analysis
entry = "main.taut"
files."main.taut" = ````tauto
import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_by, proof_case, proof_consider }

pub(open) inductive S: Type {
  I: S
  O: S
}

pub fn count(xs: List(S)): Nat {
  match xs {
    Nil => Zero
    Cons(c, r) => match c {
      I => Succ(count(r))
      O => count(r)
    }
  }
}

pub fn cat(a: List(S), b: List(S)): List(S) {
  match a {
    Nil => b
    Cons(c, r) => Cons(c, cat(r, b))
  }
}

pub fn plus(n: Nat, m: Nat): Nat {
  match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}

theorem count_cat(a: List(S), b: List(S)): count(cat(a, b)) = plus(count(a), count(b)) {
  proof!(```
    By induction on a.
      Case Nil. By Refl.
      Case Cons(c, r). Consider c.
        [i] Case I. By Eq::congr.
        Case O. By ih(b).
    %%
    [i] (Succ, ih(b))
  ```)
}
````
checks.count_cat = "ok"
diagnostics = []

@ cases.the-induction-hypothesis-over-a-generalized-variable-is-applied-to-it
entry = "main.taut"
files."main.taut" = ````tauto
import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_by, proof_case, proof_consider }

pub(open) inductive S: Type {
  I: S
  O: S
}

pub fn count(xs: List(S)): Nat {
  match xs {
    Nil => Zero
    Cons(c, r) => match c {
      I => Succ(count(r))
      O => count(r)
    }
  }
}

pub fn cat(a: List(S), b: List(S)): List(S) {
  match a {
    Nil => b
    Cons(c, r) => Cons(c, cat(r, b))
  }
}

pub fn plus(n: Nat, m: Nat): Nat {
  match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}

theorem count_cat(a: List(S), b: List(S)): count(cat(a, b)) = plus(count(a), count(b)) {
  proof!(```
    By induction on a.
      Case Nil. By Refl.
      Case Cons(c, r). Consider c.
        [i] Case I. By Eq::congr.
        Case O. By the induction hypothesis.
    %%
    [i] (Succ, ih(b))
  ```)
}
````
checks.count_cat = "ok"
diagnostics = []

@ cases.the-induction-hypothesis-as-a-reason-of-its-own
entry = "main.taut"
files."main.taut" = ````tauto
import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_by, proof_case }

theorem zero_add(n: Nat): Nat::add(0, n) = n {
  proof!(```
    By induction on n.
      Case Zero. By the induction hypothesis.
      [succ] Case Succ(k). By Eq::congr.
    %%
    [succ] (Succ, ih)
  ```)
}
````
checks."main.taut::macro" = "error: "
