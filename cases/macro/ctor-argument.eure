entry = "main.taut"
files."mk.taut" = ````tauto
import std::base
import std::text
import std::builtin::macro

pub(open) inductive Pair: Type { Mk(left: Text, right: Text): Pair }

// The file is longer than the one that calls the macro, so that a place of this file is no place there.
// The file is longer than the one that calls the macro, so that a place of this file is no place there.
// The file is longer than the one that calls the macro, so that a place of this file is no place there.
// The file is longer than the one that calls the macro, so that a place of this file is no place there.

pub macro fn right(e: SynExpr): SynExpr {
  quote { "right" }
}
````
files."main.taut" = ````tauto
import std::base
import std::text
import "mk.taut" { Pair, right }
fn show_pair(p: Pair): Text { match p { Mk(l, r) => Text::concat_all([l, "+", r]) } }
show(&show_pair(Pair::Mk("a", right!(1))))
````
