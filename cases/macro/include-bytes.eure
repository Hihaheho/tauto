// `include_bytes!("path")`: read as `include_text!` is (`include.eure`), but
// the file may hold any bytes. The reader replaces the call by
// `Bytes::of_list([b0, b1, …])`, a `Bytes` of `std::prelude::collections`, so the
// file that writes it imports that prelude. A `{{bytes:ff}}` in a text is that
// byte.

@ cases.a-binary-file-is-read-as-bytes
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_list` yet"
files."main.nib" = ````nib

let b := include_bytes!("data/vector.bin")
show(&b)
show(&Bytes::len(b))
````
files."data/vector.bin" = "{{bytes:00}}{{bytes:ff}}{{bytes:e9}}a"
expands = ```nib
let b := Bytes::of_list(List::Cons(0, List::Cons(255, List::Cons(233, List::Cons(97, List::Nil)))))
show(&b)
show(&Bytes::len(b))
```
stdout = ```
Bytes[0, 255, 233, 97]
4
```

@ cases.an-empty-file-is-empty-bytes
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_list` yet"
files."main.nib" = ````nib

show(&Bytes::len(include_bytes!("empty.bin")))
````
files."empty.bin" = ""
stdout = "0\n"

@ cases.the-bytes-of-a-text-file-are-its-utf-8
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_list` yet"
files."main.nib" = ````nib

show(&Bytes::eq(include_bytes!("a.txt"), Bytes::of_text(include_text!("a.txt"))))
````
files."a.txt" = "é"
stdout = "true\n"

@ cases.a-file-of-the-tote-is-read-as-bytes-from-a-file-below-it
llvm.unimplemented = "generate: the LLVM backend does not write a closure that may stop yet"
files."Tauto.eure" = ```eure
package {
  name = "t"
  version = "0.1.0"
}
```
files."src/main.nib" = ````nib

perform main(() => show(&(include_bytes!("../data/v.bin"))))
````
files."data/v.bin" = "{{bytes:01}}{{bytes:02}}"
entry = "src/main.nib"
stdout = "Bytes[1, 2]\n"

@ cases.an-absolute-path-to-bytes-is-refused
files."main.nib" = ````nib
let t := include_bytes!("/etc/hosts")
````
macro_error = "include.absolute"

@ cases.a-path-to-bytes-out-of-the-tote-is-refused
files."tote/Tauto.eure" = ```eure
package {
  name = "t"
  version = "0.1.0"
}
```
files."tote/src/main.nib" = ````nib
let t := include_bytes!("../../secret.bin")
````
files."secret.bin" = "no"
entry = "tote/src/main.nib"
macro_error = "include.outside"

@ cases.a-missing-binary-file-is-refused
files."main.nib" = ````nib
let t := include_bytes!("missing.bin")
````
macro_error = "include.read"

@ cases.the-bytes-argument-is-a-text-literal
files."main.nib" = ````nib
let p := "a.bin"
let t := include_bytes!(p)
````
files."a.bin" = "a"
macro_error = "include.argument"

@ cases.a-macro-cannot-take-the-bytes-name
files."lib.nib" = ````nib
pub macro fn include_bytes(e: SynExpr): SynExpr { e }
````
files."main.nib" = ````nib
import "lib.nib"
let t := 1
````
macro_error = "macro.reserved"

// A macro cannot read a file: a call it makes is not read.
@ cases.a-bytes-call-a-macro-makes-is-refused
files."lib.nib" = ````nib
pub macro fn reads(e: SynExpr): SynExpr ! {macro_error, div} {
  match Syn::ident_of(e) {
    Some(id) => ExMacroExpr(Syn::ident_like(id, "include_bytes"), ExText("a.bin", id.span), id.span)
    None => e
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
let t := reads!(x)
````
files."a.bin" = "a"
macro_error = "macro.include_bytes"

// The literal nests one term per byte, so a read is at most 16 KiB.
@ cases.a-binary-file-over-the-limit-is-refused
files."main.nib" = ````nib
let t := include_bytes!("big.bin")
````
files."big.bin" = ""
macro_error = "include.too_large"
