// after the change (`f(n) ≡ n` by δ).
@ cases.a-proved-change-is-used-by-what-follows
files."lib.nib" = ````nib
pub fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}

pub theorem plus_n_zero(n: Nat): (plus(n, Zero) = n) {
  ⊢ (plus(n, Zero) = n) from match n {
    Zero => Refl(Nat, Zero)
    Succ(k) => Eq::congr(x => Succ(x), plus_n_zero(k))
  }
}

pub fn is_const(c: Judgement, name: Text): Bool {
  match Judgement::open(c) {
    VConst(n) => n == name
    _ => false
  }
}

pub macro fn dzl(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(z, Cons(m, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") { Judgement::term(m) } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}

pub macro fn dzr(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") { Judgement::term(m) } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}

pub macro fn simp0(c: Judgement): Proved ! {macro_error, elab} {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") {
        let mt := Judgement::term(m)
        Proved { term: mt, proof: quote { plus_n_zero($mt) } }
      } else { Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)") }
      _ => Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)")
    }
    _ => Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)")
  }
}
````
