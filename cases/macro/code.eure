fn eta(c: Code) -> SynExpr {
  match code_view(c) {
    VLam(n, ty, body) => match code_view(body) {
      VApp(f, args) => match args {
        Cons(a, Nil) => if code_same_atom(a, n) && !code_mentions(f, n) { code_term(f) } else { code_term(c) }
        _ => code_term(c)
      }
      _ => code_term(c)
    }
    _ => code_term(c)
  }
}
macro eta_reduce = eta
````
