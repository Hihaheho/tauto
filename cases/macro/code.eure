// Copying a `Judgement` copies the handle, not the value: splicing a copy value
// twice is accepted (an affine one is not, above).
@ cases.a-macro-may-splice-a-copy-value-twice
files."lib.nib" = ````nib
import std::prelude::Macro

pub macro fn dup(c: Judgement): SynExpr { quote { $c + $c } }
````
files."main.nib" = ````nib
import "lib.nib"
fn double(x: u64): u64 { dup!(x + 1) }
perform show("double", double(2))
````
expands = ```nib
fn double(x: u64): u64 { x + 1 + (x + 1) }
perform show("double", double(2))
```
shows = ["double = 6"]

// Moving a `let` to its use keeps the type and the row, yet the affine `t`
// is then live across `choose`, which may resume more than once.
@ cases.a-macro-may-not-move-an-affine-use-across-a-multi-shot-effect
files."lib.nib" = ````nib
pub(open) affine struct Ticket {}
pub(open) effect choose(): Bool resume ω
pub fn redeem(t: Ticket): u64 { match t { Ticket {} => 1 } }

// { let x := e; if c { x } else { d } } as if c { e } else { d }
pub macro fn sink(c: Judgement): SynExpr {
  match Judgement::term(c) {
    ExBlock(Cons(StLet(x, ty, e, a, b, s), Cons(StExpr(ExIf(cond, ExVar(y), d, sp)), Nil)), bs) => ExIf(cond, e, d, sp)
    _ => Judgement::term(c)
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
fn pick(t: Ticket): u64 ! {choose} {
  sink!({
    let n := redeem(t)
    if perform choose() { n } else { 0 }
  })
}
````
macro_error = "macro.ownership_rejected: what the macro made breaks ownership: t is live across choose, which resumes ω"

// A handler the macro wraps around the input resumes `ask` twice; `ask`
// resumes once, so the path that moves `t` would run twice.
@ cases.a-macro-may-not-resume-a-one-shot-continuation-twice
files."lib.nib" = ````nib
pub(open) affine struct Ticket {}
pub(open) effect ask(): Bool resume 1
pub fn redeem(t: Ticket): u64 { match t { Ticket {} => 1 } }
pub macro fn guard(c: Judgement): SynExpr {
  quote { handle { $c } with { ask(), k => k(true) + k(false) } }
}
````
files."main.nib" = ````nib
import "lib.nib"
fn g(t: Ticket): u64 ! {ask} {
  guard!(if perform ask() { redeem(t) } else { 0 })
}
