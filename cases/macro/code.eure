@ cases.a-macro-reads-the-type-and-rows-of-a-fn-declared-before-it
files."lib.nib" = ````nib
import std::builtin::macro

pub fn row_names(r: List(SynRowEntry)): Text ! {div} {
  match r {
    Nil => ""
    Cons(e, rest) => {
      let n := match e {
        EffName(n, _) => n
        EffApplied(n, _, _, _, _) => n
      }
      concat(concat(n, " "), row_names(rest))
    }
  }
}

pub fn texts(ts: List(Text)): Text ! {div} {
  match ts {
    Nil => ""
    Cons(t, rest) => concat(concat(t, " "), texts(rest))
  }
}

pub fn param_rows(ps: List(SynParam)): Text ! {div} {
  match ps {
    Nil => ""
    Cons(p, rest) => {
      let here := match p.ty {
        ExPi(_, _, Some(r), _) => concat("{", concat(row_names(r), "}"))
        _ => "-"
      }
      concat(concat(here, " "), param_rows(rest))
    }
  }
}

pub fn shape(ty: SynExpr): Text ! {div} {
  match ty {
    ExPi(ps, _, Some(r), _) => concat(param_rows(ps), concat("-> ", row_names(r)))
    _ => "not a function type"
  }
}

// `@sig!(f)` on a `fn g(): Text` rebuilds `g` to give what `Elab::global` says
// of `f`: its generics, the rows of its parameters, and its own row.
pub macro fn sig(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, elab, div} {
  let at := Syn::call_span()
  match s {
    StFn(g) => match Syn::ident_of(e) {
      None => Syn::error(at, "not a name")
      Some(i) => match Elab::global(i.name) {
        None => Syn::error(at, "not a declaration")
        Some(j) => {
          let text := concat(
            concat(Judgement::fragment(j), ": "),
            concat(concat(texts(Judgement::generics(j)), "| "), shape(Judgement::type_of(j).term))
          )
          [StFn(SynFn {
            name: g.name, generics: g.generics, generic_types: g.generic_types, bounds: g.bounds,
            params: g.params, r#borrows: g.r#borrows, param_types: g.param_types, result: g.result,
            effects: g.effects, where_: g.where_, body: ExText(text, at), span: g.span,
            unused: g.unused, unused_generics: g.unused_generics, unused_params: g.unused_params
          })]
        }
      }
    }
    _ => Syn::error(at, "not a fn")
  }
}
````
files."main.nib" = ````nib
