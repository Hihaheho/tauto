fn plus(n: Nat, m: Nat) -> Nat {
  match n -> Nat {
    zero => m
    succ(k) => succ(plus(k, m))
  }
}

theorem plus_n_zero(n: Nat): Eq(Nat, plus(n, zero), n) {
  match n -> Eq(Nat, plus(n, zero), n) {
    zero => refl(Nat, zero)
    succ(k) => Eq_congr(x => succ(x), plus_n_zero(k))
  }
}

fn is_const(c: Code, name: Text) -> Bool {
  match code_view(c) {
    VConst(n) => n == name
    _ => false
  }
}

fn drop_zero_left(c: Code) -> SynExpr {
  match code_view(c) {
    VApp(f, args) => match args {
      Cons(z, Cons(m, Nil)) => if is_const(f, "plus") && is_const(z, "zero") { code_term(m) } else { code_term(c) }
      _ => code_term(c)
    }
    _ => code_term(c)
  }
}
macro dzl = drop_zero_left

fn drop_zero_right(c: Code) -> SynExpr {
  match code_view(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "zero") { code_term(m) } else { code_term(c) }
      _ => code_term(c)
    }
    _ => code_term(c)
  }
}
macro dzr = drop_zero_right

fn simp_zero(c: Code) -> Proved ! {macro_error, elab} {
  match code_view(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "zero") {
        let mt = code_term(m)
        Proved { term: mt, proof: quote { plus_n_zero($mt) } }
      } else { syn_error(code_span(c), "simp_zero: not plus(_, zero)") }
      _ => syn_error(code_span(c), "simp_zero: not plus(_, zero)")
    }
    _ => syn_error(code_span(c), "simp_zero: not plus(_, zero)")
  }
}
macro simp0 = simp_zero
