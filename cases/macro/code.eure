@ cases.a-macro-reads-the-methods-of-a-class
files."lib.nib" = ````nib
import std::builtin::macro

fn method_names(ms: List(SynFn)): Text ! {div} {
  match ms {
    Nil => ""
    Cons(m, rest) => {
      let result := match m.result {
        Some(r) => match Syn::ident_of(r) {
          Some(i) => i.name
          None => "?"
        }
        None => "()"
      }
      concat(concat(concat(concat(m.name.name, ":"), result), " "), method_names(rest))
    }
  }
}

// `@methods!(C)` on a `fn f(): Text` rebuilds `f` to give the methods of
// the class `C` with their result types, and how many laws it has.
pub macro fn methods(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, elab, div} {
  let at := Syn::call_span()
  match s {
    StFn(f) => match Syn::ident_of(e) {
      None => Syn::error(at, "not a class name")
      Some(i) => match Elab::class_decl(i) {
        None => Syn::error(at, "not a class")
        Some(c) => {
          let laws := match c.laws {
            Nil => "no laws"
            _ => "laws"
          }
          let text := concat(concat(method_names(c.methods), c.name.name), concat(" ", laws))
          [StFn(SynFn {
          name: f.name, generics: f.generics, generic_types: f.generic_types, bounds: f.bounds,
          params: f.params, r#borrows: f.r#borrows, param_types: f.param_types, result: f.result,
          effects: f.effects, where_: f.where_, body: ExText(text, at), span: f.span,
          unused: f.unused, unused_generics: f.unused_generics, unused_params: f.unused_params
        })]
        }
      }
    }
    _ => Syn::error(at, "not a fn")
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
pub class Size(A: Type) {
  fn size(a: A): u64
  fn label(a: A): Text
}
@methods!(Size) => replace fn described
fn described(): Text { "" }
show(&described())
````
stdout = ```
"size:u64 label:Text Size no laws"
```

@ cases.a-macro-asks-a-class-of-a-name-that-is-no-class
files."lib.nib" = ````nib
import std::builtin::macro

pub macro fn is_class(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, elab} {
  let at := Syn::call_span()
  match s {
    StFn(f) => match Syn::ident_of(e) {
      None => Syn::error(at, "not a name")
      Some(i) => {
        let answer := match Elab::class_decl(i) {
          None => "no"
          Some(_) => "yes"
        }
        [StFn(SynFn {
          name: f.name, generics: f.generics, generic_types: f.generic_types, bounds: f.bounds,
          params: f.params, r#borrows: f.r#borrows, param_types: f.param_types, result: f.result,
          effects: f.effects, where_: f.where_, body: ExText(answer, at), span: f.span,
          unused: f.unused, unused_generics: f.unused_generics, unused_params: f.unused_params
        })]
      }
    }
    _ => Syn::error(at, "not a fn")
  }
}
````
