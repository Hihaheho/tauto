macro_error = "macro.ownership_rejected: what the macro made breaks ownership: k#1 is used after move"

// The macro stage runs the function, so the rows written in the library hold
// there as they do in a run: a helper that may perform macro_error under a row
// that leaves it out is refused before it runs.
@ cases.a-macro-function-holds-the-rows-it-declares
files."lib.nib" = ````nib
pub fn check(c: Judgement): Judgement ! {macro_error, Div} {
  Syn::error(Judgement::span(c), "never")
}
pub fn quiet(c: Judgement): Judgement ! {Div} { check(c) }
pub macro fn wrap(c: Judgement): SynExpr ! {macro_error, Div} {
  let d := quiet(c)
  quote { $d }
}
````
files."main.nib" = ````nib
import "lib.nib"
fn f(w: i64): i64 { wrap!(w + 1) }
````
macro_error = "macro.row"

@ cases.typed-input-keeps-selected-constructor-reference
files."lib.nib" = ```nib
import std::prelude::Macro
pub macro fn keep(c: Judgement): SynExpr { Judgement::term(c) }
```
files."main.nib" = ```nib
import "lib.nib"
enum Left { Same(i64) }
enum Right { Same(Text) }
fn left(): Left { keep!(Same(17)) }
fn right(): Right { keep!(Same("right")) }
perform show("left", left())
perform show("right", right())
```
