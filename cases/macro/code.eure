pub fn trace<!e>(k: () -> u64 ! {note} ∪ e): u64 ! {stdout} ∪ e {
  handle { k() } with {
    note(t), r => { print(t); r(()) }
  }
}
@sig!(trace) => replace fn described
fn described(): Text { "" }
show(&described())
