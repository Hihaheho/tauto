@ cases.unroll-leaves-a-variable-exponent
files."lib.nib" = ````nib
fn pow(x: i64, n: u64) -> i64 ! {Div} {
  if n == 0 { 1 } else { x * pow(x, n - 1) }
}

fn is_pow_call(f: Code) -> Bool {
  match code_view(f) {
    VConst(name) => name == "pow"
    _ => false
  }
}

fn unroll_pow(c: Code) -> SynExpr ! {macro_error} {
  match code_view(c) {
    VApp(f, args) => match args {
      Cons(x, Cons(n, Nil)) => if is_pow_call(f) {
        match code_view(n) {
          VInt(text) => syn_error(code_span(c), "a literal exponent")
          _ => code_term(c)
        }
      } else { code_term(c) }
      _ => code_term(c)
    }
    _ => code_term(c)
  }
}

macro unroll = unroll_pow
````
files."main.nib" = ````nib
import "lib.nib"
fn power(x: i64, n: u64) -> i64 ! {Div} { unroll!(pow(x, n)) }
````
expands = ```nib
fn power(x: i64, n: u64) -> i64 ! {Div} { pow(x, n) }
```

@ cases.eta-reduces-a-lambda-it-can-open
files."lib.nib" = ````nib
fn eta(c: Code) -> SynExpr {
  match code_view(c) {
    VLam(n, ty, body) => match code_view(body) {
      VApp(f, args) => match args {
        Cons(a, Nil) => if code_same_atom(a, n) && !code_mentions(f, n) { code_term(f) } else { code_term(c) }
        _ => code_term(c)
      }
      _ => code_term(c)
    }
    _ => code_term(c)
  }
}
macro eta_reduce = eta
````
files."main.nib" = ````nib
import "lib.nib"
fn mk(g: (i64) -> i64) -> (i64) -> i64 { eta_reduce!((y: i64) => g(y)) }
fn keep(g: (i64) -> i64) -> (i64) -> i64 { eta_reduce!((y: i64) => g(y) + 1) }
````
expands = ```nib
fn mk(g: (i64) -> i64) -> (i64) -> i64 { g }
fn keep(g: (i64) -> i64) -> (i64) -> i64 { y => g(y) + 1 }
```

@ cases.an-atom-cannot-leave-the-binder-that-opened-it
files."lib.nib" = ````nib
fn bad(c: Code) -> SynExpr {
  match code_view(c) {
    VLam(n, ty, body) => code_term(body)
    _ => code_term(c)
  }
}
macro bad_eta = bad
````
files."main.nib" = ````nib
import "lib.nib"
fn f(g: (i64) -> i64) -> i64 {
  let h = bad_eta!((y: i64) => g(y))
  h(1)
}
````
macro_error = "macro.scope_extrusion"

@ cases.a-macro-may-not-change-the-signature-it-inferred
files."lib.nib" = ````nib
fn pow(x: i64, n: u64) -> i64 ! {Div} {
  if n == 0 { 1 } else { x * pow(x, n - 1) }
}
fn cube(c: Code) -> SynExpr { quote { 0 } }
macro cube = cube
````
files."main.nib" = ````nib
