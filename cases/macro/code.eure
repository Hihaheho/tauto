@ cases.a-macro-is-given-a-type-and-reads-its-declaration
files."lib.nib" = ````nib
import std::builtin::macro

fn names(fs: List(Option(SynIdent) × SynExpr)): Text ! {div} {
  match fs {
    Nil => ""
    Cons(#(n, ty), rest) => {
      let t := match Syn::ident_of(ty) {
        Some(i) => i.name
        None => "?"
      }
      let f := match n {
        Some(x) => x.name
        None => "_"
      }
      concat(concat(concat(concat(f, ":"), t), " "), names(rest))
    }
  }
}

pub macro fn fields(j: Judgement): SynExpr ! {macro_error, elab, div} {
  match Syn::ident_of(j.term) {
    None => Syn::error(Syn::call_span(), "not a type name")
    Some(i) => match Elab::data(i) {
      None => Syn::error(Syn::call_span(), "not a struct or an enum")
      Some(d) => match d.ctors {
        Cons(c, _) => ExText(names(c.fields), Syn::call_span())
        Nil => ExText("", Syn::call_span())
      }
    }
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
pub(open) struct Point { x: u64, label: Text }
fn described(): Text { fields!(Point) }
show(&described())
````
stdout = ```
"x:u64 label:Text "
```

@ cases.a-type-argument-gives-the-call-the-type-of-its-output
files."lib.nib" = ````nib
import std::builtin::macro

// `first!(T)` is a function giving the first field of a `T`.
pub macro fn first(j: Judgement): SynExpr ! {macro_error, elab, div} {
  let at := Syn::call_span()
  match Syn::ident_of(j.term) {
    None => Syn::error(at, "not a type name")
    Some(i) => match Elab::data(i) {
      Some(d) => match d.ctors {
        [c] => match c.fields {
          Cons(#(Some(f), _), _) => {
            let v := SynIdent { declaration: None, name: "v", ctx: SynCtx { scopes: Nil }, span: at }
            ExLam([BName(v, Some(j.term), None)], ExField(ExVar(v), f.name, at), at)
          }
          _ => Syn::error(at, "no named field")
        }
        _ => Syn::error(at, "not a struct")
      }
      None => Syn::error(at, "not a struct or an enum")
    }
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
pub(open) struct Pair { left: i64, right: i64 }
fn left_of(p: Pair): i64 ! {overflow} { first!(Pair)(p) + 1 }
show(&left_of(Pair { left: 41, right: 0 }))
````
