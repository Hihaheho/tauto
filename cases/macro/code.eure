import std::prelude::Macro

pub(open) affine struct Ticket {}
pub fn redeem(t: Ticket): u64 { match t { Ticket {} => 1 } }
pub macro fn how(c: Judgement): SynExpr {
  match Judgement::usage(c) {
    Cons(u, _) => if u.how == "moved" { quote { 1 } } else { quote { 0 } }
    Nil => quote { 0 }
  }
}
