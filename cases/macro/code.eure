@ cases.unroll-leaves-a-variable-exponent
files."lib.nib" = ````nib
import std::prelude::Macro

pub fn pow(x: i64, n: u64): i64 ! {Div} {
  if n == 0 { 1 } else { x * pow(x, n - 1) }
}

pub fn is_pow_call(f: Judgement): Bool {
  match Judgement::open(f) {
    VConst(name) => name == "pow"
    _ => false
  }
}

pub macro fn unroll(c: Judgement): SynExpr ! {macro_error} {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(x, Cons(n, Nil)) => if is_pow_call(f) {
        match Judgement::open(n) {
          VInt(text) => Syn::error(Judgement::span(c), "a literal exponent")
          _ => Judgement::term(c)
        }
      } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
fn power(x: i64, n: u64): i64 ! {Div} { unroll!(pow(x, n)) }
````
expands = ```nib
fn power(x: i64, n: u64): i64 ! {Div} { pow(x, n) }
```

