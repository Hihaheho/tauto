@ cases.eta-reduces-a-lambda-it-can-open
files."lib.nib" = ````nib
import std::prelude::Macro

pub macro fn eta_reduce(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VLam(n, ty, body) => match Judgement::open(body) {
      VApp(f, args) => match args {
        Cons(a, Nil) => if Judgement::same_atom(a, n) && not(Judgement::mentions(f, n)) { Judgement::term(f) } else { Judgement::term(c) }
        _ => Judgement::term(c)
      }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
fn mk(g: (i64) -> i64): (i64) -> i64 { eta_reduce!((y: i64) => g(y)) }
fn keep(g: (i64) -> i64): (i64) -> i64 { eta_reduce!((y: i64) => g(y) + 1) }
````
expands = ```nib
fn mk(g: (i64) -> i64): (i64) -> i64 { g }
fn keep(g: (i64) -> i64): (i64) -> i64 { (y: i64) => g(y) + 1 }
```

