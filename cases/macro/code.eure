// `Judgement::type_of` and `Elab::check` read the type; `Elab::defeq` compares.
@ cases.a-macro-branches-on-the-type
files."lib.nib" = ````nib
import std::prelude::Macro

pub fn is_type(c: Judgement, t: SynExpr): Bool ! {elab} {
  match Elab::check(t, c, None) {
    Ok(tc) => Elab::defeq(Judgement::type_of(c), tc)
    Err(d) => false
  }
}

pub macro fn bump(c: Judgement): SynExpr ! {macro_error, elab} {
  if is_type(c, quote { Nat }) { quote { Succ($c) } } else { Judgement::term(c) }
}
````
files."main.nib" = ````nib
import "lib.nib"
theorem n1(n: Nat): Nat { bump!(n) }
theorem b1(b: Bool): Bool { bump!(b) }
````
expands = ```nib
theorem n1(n: Nat): Nat { Succ(n) }
theorem b1(b: Bool): Bool { b }
```

@ cases.a-macro-branches-on-a-type-of-the-program
unimplemented = "Elab::check answers only in the kernel's fragment; i32 is not in it, so is_type is false"
files."lib.nib" = ````nib
pub fn is_type(c: Judgement, t: SynExpr): Bool ! {elab} {
  match Elab::check(t, c, None) {
    Ok(tc) => Elab::defeq(Judgement::type_of(c), tc)
    Err(d) => false
  }
}

pub macro fn widen_sum(c: Judgement): SynExpr ! {macro_error, elab} {
  if is_type(c, quote { i32 }) {
    quote { I64::of_i32($c) }
  } else { Judgement::term(c) }
}
````
files."main.nib" = ````nib
import "lib.nib"
fn f(a: i32, b: i32): u64 {
  let s := widen_sum!(a + b)
  1
}
````
