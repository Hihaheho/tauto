// Typed macros.

@ cases.unroll-a-power
files."unroll.nib" = ````nib
import std::prelude::Macro

pub fn pow(x: i64, n: u64): i64 ! {Div} {
  if n == 0 { 1 } else { x * pow(x, n - 1) }
}

pub fn is_pow_call(f: Judgement): Bool {
  match Judgement::open(f) {
    VConst(name) => name == "pow"
    _ => false
  }
}

pub macro fn unroll(c: Judgement): SynExpr ! {macro_error, elab} {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(x, Cons(n, Nil)) => if is_pow_call(f) {
        match Judgement::open(n) {
          VInt(text) => unroll_times(x, text)
          _ => Judgement::term(c)
        }
      } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}

pub fn unroll_times(x: Judgement, text: Text): SynExpr ! {macro_error} {
  if text == "3" {
    quote {
      let t := $x
      t * t * t
    }
  } else { Syn::error(Judgement::span(x), "unroll handles only the exponent 3 in this example") }
}
````
files."main.nib" = ````nib
import "unroll.nib"
fn cube(x: i64): i64 ! {Div} { unroll!(pow(x, 3)) }
perform show("c", cube(3))
````
shows = ["c = 27"]
trace = ["unroll"]
expands = ```nib
fn cube(x: i64): i64 ! {Div} {
  let t#1 := x
  t#1 * t#1 * t#1
}
perform show("c", cube(3))
```

