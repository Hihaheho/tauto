@ cases.a-macro-may-not-use-an-affine-value-twice
files."lib.nib" = ````nib
affine struct Ticket {}
fn redeem(t: Ticket) -> u64 { 1 }
fn twice(c: Code) -> SynExpr { quote { $c + $c } }
macro dup = twice
````
files."main.nib" = ````nib
import "lib.nib"
fn bad(t: Ticket) -> u64 { dup!(redeem(t)) }
````
macro_error = "macro.ownership_rejected"

