// Type preservation is not preservation of meaning: `$c * $c * $c` has the
// type and the row of `$c`, and runs its effect three times (`unroll` binds
// it once with `let`).
@ cases.a-splice-used-three-times-runs-its-effect-three-times
files."lib.nib" = ````nib
import std::prelude::Macro

pub macro fn naive(c: Judgement): SynExpr { quote { $c * $c * $c } }
````
files."main.nib" = ````nib
import "lib.nib"
fn two(): i64 ! {∀ A. show(A)} {
  perform show("x", 2)
  2
}
fn cube(): i64 ! {∀ A. show(A)} { naive!(two()) }
perform show("cube", cube())
````
expands = ```nib
fn two(): i64 ! {show} {
  perform show("x", 2)
  2
}
fn cube(): i64 ! {show} { two() * two() * two() }
perform show("cube", cube())
```
shows = ["x = 2", "x = 2", "x = 2", "cube = 8"]

