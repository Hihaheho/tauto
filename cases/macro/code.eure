@ cases.a-macro-reads-how-a-value-is-used
files."lib.nib" = ````nib
affine struct Ticket {}
fn redeem(t: Ticket) -> u64 { match t { Ticket {} => 1 } }
fn uses_of(c: Code) -> SynExpr {
  match code_usage(c) {
    Cons(u, _) => if u.how == "moved" { quote { 1 } } else { quote { 0 } }
    Nil => quote { 0 }
  }
}
macro how = uses_of
````
files."main.nib" = ````nib
import "lib.nib"
fn moved(t: Ticket) -> u64 { how!(redeem(t)) }
fn not_used(x: u64) -> u64 { how!(x + 1) }
````
expands = ```nib
fn moved(t: Ticket) -> u64 { 1 }
fn not_used(x: u64) -> u64 { 0 }
```
