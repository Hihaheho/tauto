@ cases.unroll-leaves-a-variable-exponent
files."lib.nib" = ````nib
fn pow(x: i64, n: u64) -> i64 ! {Div} {
  if n == 0 { 1 } else { x * pow(x, n - 1) }
}

fn is_pow_call(f: Code) -> Bool {
  match code_view(f) {
    VConst(name) => name == "pow"
    _ => false
  }
}

fn unroll_pow(c: Code) -> SynExpr ! {macro_error} {
  match code_view(c) {
    VApp(f, args) => match args {
      Cons(x, Cons(n, Nil)) => if is_pow_call(f) {
        match code_view(n) {
          VInt(text) => syn_error(code_span(c), "a literal exponent")
          _ => code_term(c)
        }
      } else { code_term(c) }
      _ => code_term(c)
    }
    _ => code_term(c)
  }
}

macro unroll = unroll_pow
````
