@ cases.a-macro-reads-the-row-of-a-function-argument
files."lib.nib" = ````nib
import std::builtin::macro

pub fn row_names(r: List(SynRowEntry)): Text ! {div} {
  match r {
    Nil => ""
    Cons(e, rest) => {
      let n := match e {
        EffName(n, _) => n
        EffApplied(n, _, _, _, _) => n
      }
      concat(concat(n, " "), row_names(rest))
    }
  }
}

// `rows_of!(f)` objects with the row of the function `f`.
pub macro fn rows_of(c: Judgement): SynExpr ! {div, macro_error} {
  let at := Judgement::span(c)
  match Judgement::type_of(c).term {
    ExPi(_, _, Some(r), _) => Syn::error(at, concat("row: ", row_names(r)))
    _ => Syn::error(at, "no row")
  }
}
````
