// Typed macros.

@ cases.unroll-a-power
files."unroll.nib" = ````nib
fn pow(x: i64, n: u64) -> i64 ! {Div} {
  if n == 0 { 1 } else { x * pow(x, n - 1) }
}

fn is_pow_call(f: Code) -> Bool {
  match code_view(f) {
    VConst(name) => name == "pow"
    _ => false
  }
}

fn unroll_pow(c: Code) -> SynExpr ! {macro_error, elab} {
  match code_view(c) {
    VApp(f, args) => match args {
      Cons(x, Cons(n, Nil)) => if is_pow_call(f) {
        match code_view(n) {
          VInt(text) => unroll_times(x, text)
          _ => code_term(c)
        }
      } else { code_term(c) }
      _ => code_term(c)
    }
    _ => code_term(c)
  }
}

fn unroll_times(x: Code, text: Text) -> SynExpr ! {macro_error} {
  if text == "3" {
    quote {
      let t = $x
      t * t * t
    }
  } else { syn_error(code_span(x), "unroll handles only the exponent 3 in this example") }
}

macro unroll = unroll_pow
````
files."main.nib" = ````nib
import "unroll.nib"
fn cube(x: i64) -> i64 ! {Div} { unroll!(pow(x, 3)) }
perform show("c", cube(3))
````
shows = ["c = 27"]
trace = ["unroll"]
expands = ```nib
fn cube(x: i64) -> i64 ! {Div} {
  let t#1 = x
  t#1 * t#1 * t#1
}
perform show("c", cube(3))
```

@ cases.a-macro-may-not-add-an-effect
files."lib.nib" = ````nib
fn trace_calls(c: Code) -> SynExpr {
  quote {
    let r = $c
    perform show("value", r)
    r
  }
}
macro traced = trace_calls
````
files."main.nib" = ````nib
import "lib.nib"
fn area(w: i64, h: i64) -> i64 { traced!(w * h) }
````
macro_error = "macro.row_grew"

