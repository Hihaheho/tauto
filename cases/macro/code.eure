// Moving a `let` to its use keeps the type and the row, yet the affine `t`
// is then live across `choose`, which may resume more than once.
@ cases.a-macro-may-not-move-an-affine-use-across-a-multi-shot-effect
files."lib.nib" = ````nib
affine struct Ticket {}
effect choose: () -> Bool resume ω
fn redeem(t: Ticket) -> u64 { match t { Ticket {} => 1 } }

// { let x = e; if c { x } else { d } } as if c { e } else { d }
fn sink_let(c: Code) -> SynExpr {
  match code_term(c) {
    ExBlock(Cons(StLet(x, ty, e, a, b, s), Cons(StExpr(ExIf(cond, ExVar(y), d, sp)), Nil)), bs) => ExIf(cond, e, d, sp)
    _ => code_term(c)
  }
}
macro sink = sink_let
````
files."main.nib" = ````nib
import "lib.nib"
fn pick(t: Ticket) -> u64 ! {choose} {
  sink!({
    let n = redeem(t)
    if perform choose() { n } else { 0 }
  })
}
````
macro_error = "macro.ownership_rejected: what the macro made breaks ownership: t is live across choose, which resumes ω"

