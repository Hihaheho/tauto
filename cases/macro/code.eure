// `plus` recurses on its first argument: `plus(Zero, m) ≡ m`, and
// `plus(n, Zero)` does not reduce.
@ cases.a-definitionally-equal-output-is-accepted-in-a-proof
files."lib.nib" = ````nib
pub fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}

pub theorem plus_n_zero(n: Nat): (plus(n, Zero) = n) {
  ⊢ (plus(n, Zero) = n) from match n {
    Zero => Refl(Nat, Zero)
    Succ(k) => Eq::congr(x => Succ(x), plus_n_zero(k))
  }
}

pub fn is_const(c: Judgement, name: Text): Bool {
  match Judgement::open(c) {
    VConst(n) => n == name
    _ => false
  }
}

pub macro fn dzl(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(z, Cons(m, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") { Judgement::term(m) } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}

pub macro fn dzr(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") { Judgement::term(m) } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}

pub macro fn simp0(c: Judgement): Proved ! {macro_error, elab} {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") {
        let mt := Judgement::term(m)
        Proved { term: mt, proof: quote { plus_n_zero($mt) } }
      } else { Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)") }
      _ => Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)")
    }
    _ => Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)")
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
theorem t1(n: Nat): (plus(Zero, n) = n) {
  Refl(Nat, dzl!(plus(Zero, n)))
}
````
expands = ```nib
theorem t1(n: Nat): plus(Zero, n) = n { Eq::Refl(Nat, n) }
```
checks.t1 = "ok"

// The type of the position is kept (`Nat`), but the type of `Refl(…)`
// depends on the term, and `n` is not `plus(n, Zero)` by conversion.
@ cases.an-output-that-is-not-definitionally-equal-breaks-a-dependent-use
files."lib.nib" = ````nib
pub fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}

pub theorem plus_n_zero(n: Nat): (plus(n, Zero) = n) {
  ⊢ (plus(n, Zero) = n) from match n {
    Zero => Refl(Nat, Zero)
    Succ(k) => Eq::congr(x => Succ(x), plus_n_zero(k))
  }
}

pub fn is_const(c: Judgement, name: Text): Bool {
  match Judgement::open(c) {
    VConst(n) => n == name
    _ => false
  }
}

pub macro fn dzl(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(z, Cons(m, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") { Judgement::term(m) } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}

pub macro fn dzr(c: Judgement): SynExpr {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") { Judgement::term(m) } else { Judgement::term(c) }
      _ => Judgement::term(c)
    }
    _ => Judgement::term(c)
  }
}

pub macro fn simp0(c: Judgement): Proved ! {macro_error, elab} {
  match Judgement::open(c) {
    VApp(f, args) => match args {
      Cons(m, Cons(z, Nil)) => if is_const(f, "plus") && is_const(z, "Zero") {
        let mt := Judgement::term(m)
        Proved { term: mt, proof: quote { plus_n_zero($mt) } }
      } else { Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)") }
      _ => Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)")
    }
    _ => Syn::error(Judgement::span(c), "simp_zero: not plus(_, Zero)")
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
theorem t2(n: Nat): plus(n, Zero) = plus(n, Zero) {
  Refl(Nat, dzr!(plus(n, Zero)))
}
````
