// A proof about a type the file declares itself: the macro's check gives the
// kernel the file's `inductive enum` as the family the file's check gives it.
@ cases.a-proof-about-an-inductive-enum-of-the-file
entry = "main.taut"
files."main.taut" = ````tauto
import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_by }

inductive enum N { Z, S(N) }

theorem same(n: N): n = n {
  proof!(```
    By Refl.
  ```)
}
````
checks.same = "ok"
