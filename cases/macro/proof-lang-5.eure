import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_by }

theorem congr<A: Type, B: Type, x: A, y: A>(f: (A) -> B, e: x = y): f(x) = f(y) {
  Eq::congr(f, e)
}

theorem succ_cong(a: Nat, b: Nat, h: a = b): Succ(a) = Succ(b) {
  proof!(```
    By congr.
  ```)
}
