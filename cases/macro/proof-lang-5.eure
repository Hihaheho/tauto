@ cases.the-goal-determines-the-arguments-of-a-lemma
entry = "main.taut"
files."main.taut" = ````tauto
import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_by }

theorem congr<A: Type, B: Type, x: A, y: A>(f: (A) -> B, e: x = y): f(x) = f(y) {
  Eq::congr(f, e)
}

theorem cancel(a: Nat, b: Nat, c: Nat, h: Nat::add(a, c) = Nat::add(b, c)): a = b {
  ⊢ a = b from match c {
    Zero => h
    Succ(k) => cancel(a, b, k, Eq::congr(Nat::pred, h))
  }
}

theorem succ_cong(a: Nat, b: Nat, h: a = b): Succ(a) = Succ(b) {
  proof!(```
    [c] By congr.
    %%
    [c] h
  ```)
}

theorem cancel_zero(a: Nat, b: Nat, h: Nat::add(a, Zero) = Nat::add(b, Zero)): a = b {
  proof!(```
    [c] By cancel.
    %%
    [c] (Zero, h)
  ```)
}
````
checks.succ_cong = "ok"
checks.cancel_zero = "ok"
diagnostics = []

