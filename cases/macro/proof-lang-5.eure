@ cases.the-skeleton-of-a-proof
entry = "main.taut"
files."main.taut" = ````tauto
import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_by, proof_case, proof_consider, proof_this, proof_let, proof_assume, proof_take, proof_obtain, proof_we }

theorem none_not_some(x: Nat, e: None = Some(x)): False {
  ⊢ False from match e {
  }
}

// C: the hypothesis `e` mentions `o`; each case reads it with its own type.
theorem opt_inv(o: Option(Nat), k: Nat, e: o = Some(k)): Some(k) = o {
  proof!(```
    Consider o.
      Case None. This is impossible by e.
      [s] Case Some(j). By Eq::sym.
    %%
    [s] e
  ```)
}

// B
theorem imp_refl(P: Prop): (P) -> P {
  proof!(```
    Assume h. By h.
  ```)
}

theorem all_refl(): ∀ n: Nat. n = n {
  proof!(```
    Let n: Nat. By Refl.
  ```)
}

theorem ex_zero(): ∃ n: Nat. n = Zero {
  proof!(```
    Take n = Zero. By Refl.
  ```)
}

theorem and_swap(P: Prop, Q: Prop, h: And(P, Q)): And(Q, P) {
  proof!(```
    Obtain p and q from h.
      We show both.
        By q.
        By p.
  ```)
}

theorem or_left(P: Prop, Q: Prop, p: P): Or(P, Q) {
  proof!(```
    We show the left. By p.
  ```)
}

// A
theorem trans<A: Type, a: A, b: A, c: A>(h1: a = b, h2: b = c): a = c { Eq::trans(h1, h2) }

theorem chain(a: Nat, b: Nat, c: Nat, d: Nat, h1: a = b, h2: b = c, h3: c = d): a = d {
  proof!(```
    By transitivity of trans on h1, h2, h3.
  ```)
}
````
checks.opt_inv = "ok"
checks.imp_refl = "ok"
checks.all_refl = "ok"
checks.ex_zero = "ok"
checks.and_swap = "ok"
checks.or_left = "ok"
checks.chain = "ok"
diagnostics = []
