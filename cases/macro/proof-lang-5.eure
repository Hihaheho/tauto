import std::base
import std::proof::lang { proof }
import std::proof::forms { proof_by }
import "lib.taut" { intro }

theorem refl_all(): ∀ n: Nat. n = n {
  proof!(```
    By $intro!(()).
      Let m: Nat. We show m = m. By Refl.
  ```)
}
````
