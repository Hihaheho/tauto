@ cases.generated-module-name-cannot-be-written-in-a-row
differential = "macro-sealed-expansion"
files."macro.nib" = ```nib
import std::builtin::macro { SynStmt, SynExpr }

pub macro fn make(e: SynExpr): List(SynStmt) {
  quote stmts {
    module sealed {
      effect a_sealed(): i64
      pub(handle) effect a(): i64
      pub fn perform_a(): i64 ! {a} { perform a() }
    }
    pub import sealed { a, perform_a }
  }
}
```
files."main.nib" = ```nib
import "macro.nib"
make!(0) => module sealed, effect sealed::a_sealed, effect sealed::a, fn sealed::perform_a, effect a, fn perform_a
fn attempt(): i64 ! {sealed::a_sealed} { 0 }
```
check_errors = ["`sealed::a_sealed`, which is not a declared effect"]

@ cases.generated-module-name-cannot-be-performed
differential = "macro-sealed-expansion"
files."macro.nib" = ```nib
import std::builtin::macro { SynStmt, SynExpr }

pub macro fn make(e: SynExpr): List(SynStmt) {
  quote stmts {
    module sealed {
      effect a_sealed(): i64
      pub(handle) effect a(): i64
      pub fn perform_a(): i64 ! {a} { perform a() }
    }
    pub import sealed { a, perform_a }
  }
}
```
files."main.nib" = ```nib
import "macro.nib"
make!(0) => module sealed, effect sealed::a_sealed, effect sealed::a, fn sealed::perform_a, effect a, fn perform_a
fn attempt(): i64 { perform sealed::a_sealed() }
```
check_errors = ["no effect `sealed::a_sealed` is declared"]

@ cases.handle-only-effect-cannot-be-performed-outside-its-module
files."macro.nib" = ```nib
import std::builtin::macro { SynStmt, SynExpr }

pub macro fn make(e: SynExpr): List(SynStmt) {
  quote stmts {
    module sealed {
      effect a_sealed(): i64
      pub(handle) effect a(): i64
      pub fn perform_a(): i64 ! {a} { perform a() }
    }
    pub import sealed { a, perform_a }
  }
}
```
files."main.nib" = ```nib
import "macro.nib"
make!(0) => module sealed, effect sealed::a_sealed, effect sealed::a, fn sealed::perform_a, effect a, fn perform_a
fn attempt(): i64 ! {a} { perform a() }
```
check_errors = ["`a` is declared with `pub(handle)` and may only be performed in its declaring scope"]

