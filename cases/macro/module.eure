import std::builtin::macro
macro fn Log::answer(value: SynExpr): SynExpr { value }
````
files."main.taut" = ````tauto
import "macro.taut"
import std::builtin::os
show(&(Log::answer!(1)))
````
macro_error = "macro.private"


@ cases.an-attribute-macro-with-a-prefix-is-called-by-its-path
entry = "main.taut"
files."macro.taut" = ````tauto
import std::builtin::macro
pub macro fn Gen::keep(e: SynExpr, s: SynStmt): List(SynStmt) ! {macro_error, div} { Nil }
````
files."main.taut" = ````tauto
import "macro.taut"
import std::builtin::os
@Gen::keep!(1)
fn one(): i64 { 1 }
show(&one())
````
stdout = "1\n"
