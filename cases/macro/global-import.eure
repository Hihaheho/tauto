@ cases.quoted-declaration-values-keep-identity-in-executable-code
backends = ["javascript", "rust", "vm"]
source = ```tauto
import std::prelude::Macro
fn first(): i64 { 1 }
fn second(): i64 { 2 }
let a := quote { first }
let b := quote { first }
let c := quote { second }
perform show("same", Syn::same(a, b))
perform show("different", Syn::same(a, c))
```
shows = ["same = true", "different = false"]

@ cases.nested-expansions-preserve-inputs-generated-bindings-and-definition-globals
backends = ["javascript", "rust", "vm"]
files."lib.nib" = ```nib
import std::prelude::Macro
fn value(): i64 { 7 }
pub macro fn inner(e: SynExpr): SynExpr {
  quote { { let tmp := 10; $e + tmp + value() } }
}
pub macro fn outer(e: SynExpr): SynExpr {
  quote { { let tmp := 20; inner!($e) + tmp } }
}
pub macro fn capture(e: SynExpr): SynExpr {
  match e {
    ExVar(id) => {
      let picked := Syn::ident_like(id, "it")
      quote { { let $picked := 30; $e + value() } }
    }
    _ => e
  }
}
pub macro fn outer_capture(e: SynExpr): SynExpr {
  quote { { let tmp := 20; capture!($e) + tmp } }
}
```
files."main.nib" = ```nib
import "lib.nib"
fn value(): i64 { 99 }
let tmp := 1
perform show("direct", inner!(tmp))
perform show("nested", outer!(tmp))
perform show("capture", capture!(it))
perform show("nested_capture", outer_capture!(it))
```
shows = ["direct = 18", "nested = 38", "capture = 37", "nested_capture = 57"]

