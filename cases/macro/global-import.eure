// A listed name a macro's file uses only as the text it gives `Syn::global`, written there
// or in a helper that takes the name (`call("name", ..)`), is used: the expansion names the
// declaration the list brings, so `tauto lint --fix` must not take it away.
@ cases.a-listed-name-only-given-to-syn-global-is-used
files_tote = "app"
tote_warnings = []
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/defs.taut" = ````tauto
pub fn answer_request(text: Text): Text { text }
pub fn other_request(text: Text): Text { text }
pub fn direct_request(text: Text): Text { text }
````
files."app/src/lib.taut" = ````tauto
import std::builtin::macro
import "defs.taut" { answer_request, other_request, direct_request }

fn call(name: Text, args: List(SynExpr), at: SynSpan): SynExpr {
  ExApp(ExVar(Syn::global(name)), args, at)
}

fn by_name(args: List(SynExpr), at: SynSpan): SynExpr {
  ExApp(ExVar(Syn::global("direct_request")), args, at)
}

pub macro fn answer(request: SynExpr): SynExpr {
  let at := Syn::call_span()
  call("answer_request", [call("other_request", [by_name([request], at)], at)], at)
}
````
files."app/src/main.taut" = ````tauto
import "lib.taut"
perform main(() => {
  show(&(answer!("ok")))
})
````
