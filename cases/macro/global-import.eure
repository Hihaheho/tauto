// The caller declares a `Payload` of its own: the macro's `Payload` is still the one its
// file sees, when the program is checked and when it is read again to run.
@ cases.a-global-a-macro-writes-means-the-macros-declaration-beside-the-callers-own
backends = ["javascript"]
files."defs.nib" = ````nib
pub(open) shared struct Payload { value: Text }
````
files."lib.nib" = ````nib
import std::prelude::Macro
import "defs.nib"
pub macro fn make(name: SynExpr): List(SynStmt) {
  let id := match name { ExVar(id) => id
    _ => Syn::global("invalid") }
  let at := Syn::call_span()
  [StFn(SynFn {
    name: id, generics: Nil, generic_types: Nil, bounds: Nil, params: Nil, borrows: Nil, param_types: Nil,
    result: Some(ExVar(Syn::global("Payload"))), effects: None,
    body: ExRecord(Syn::global("Payload"), [#(ExText("macro", at), "value")], at), span: at
  })]
}
````
files."main.nib" = ````nib
import "lib.nib"
pub(open) shared struct Payload { count: Nat }
make!(answer) => fn answer
perform show("value", answer().value)
````
shows = ["value = \"macro\""]


@ cases.editing-an-identifiers-display-does-not-change-its-declaration
backends = ["javascript", "rust", "vm"]
files."lib.nib" = ````nib
import std::prelude::Macro
pub fn original(): i64 { 7 }
pub fn other(): i64 { 9 }
pub macro fn keep(value: SynExpr): SynExpr {
  let bound := Syn::global("original")
  let renamed := SynIdent {
    name: "other", ctx: bound.ctx, span: bound.span, declaration: bound.declaration
  }
  ExApp(ExVar(renamed), [], Syn::call_span())
}
````
files."main.nib" = ````nib
import "lib.nib"
perform show("result", keep!(0))
````
shows = ["result = 7"]

@ cases.a-quoted-global-retains-its-declaration-when-its-display-is-edited
backends = ["javascript", "rust", "vm"]
files."lib.nib" = ````nib
import std::prelude::Macro
pub fn original(): i64 { 7 }
pub fn other(): i64 { 9 }
pub macro fn keep(value: SynExpr): SynExpr {
  match quote { original() } {
    ExApp(ExVar(bound), args, at) => {
      let renamed := SynIdent {
        name: "other", ctx: bound.ctx, span: bound.span, declaration: bound.declaration
      }
      ExApp(ExVar(renamed), args, at)
    }
    _ => value
  }
}
````
files."main.nib" = ````nib
import "lib.nib"
perform show("result", keep!(0))
````
shows = ["result = 7"]

// A `macro fn` of an imported file is kept as written in the program read again to run, so its calls
// expand there too.
