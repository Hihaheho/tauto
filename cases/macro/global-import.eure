@ cases.implicit-library-constructors-have-definition-site-identities
backends = ["rust", "javascript", "vm"]
files."lib.nib" = ```nib
import std::prelude::Macro
pub macro fn singleton(value: SynExpr): SynExpr {
  ExApp(ExVar(Syn::global("List::Cons")),
    [value, ExVar(Syn::global("List::Nil"))], Syn::call_span())
}
```
files."main.nib" = ```nib
import "lib.nib"
enum Other { Cons(Text), Nil }
let items: List(i64) := singleton!(7)
match items {
  List::Cons(first, rest) => perform show("first", first)
  List::Nil => perform show("first", 0)
}
```
shows = ["first = 7"]

