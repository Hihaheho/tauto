// A name a macro writes with `Syn::global` is held to the imports of the file of the
// macro, as a name in a `quote` is; the file that calls the macro need not import it
// (`docs/design/macro.md`「衛生（スコープ集合）」).

@ cases.a-global-a-macro-writes-with-syn-global-is-not-held-to-the-callers-imports
backends = ["javascript"]
files."lib.nib" = ````nib
import std::prelude::Macro
import std::prelude::Shared
pub macro fn hello(value: SynExpr): SynExpr {
  ExApp(ExVar(Syn::global("concat")), [value, ExText("!", Syn::call_span())], Syn::call_span())
}
````
files."main.nib" = ````nib
import "lib.nib"
perform show("result", hello!("Hello"))
````
shows = ["result = \"Hello!\""]

@ cases.a-global-a-macro-writes-with-syn-global-needs-the-import-in-the-macros-file
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/lib.taut" = ````tauto
import std::prelude::Macro
pub macro fn hello(value: SynExpr): SynExpr {
  ExApp(ExVar(Syn::global("concat")), [value, ExText("!", Syn::call_span())], Syn::call_span())
}
````
files."app/src/main.taut" = ````tauto
import "lib.taut"
perform show("result", hello!("Hello"))
````
load_error = "main.taut:2:24: macro: macro.runtime: macro hello: macro.global: concat is not a unique declaration visible in the macro definition"

// Every name a macro's expansion writes is read where the macro is written, wherever it
// stands in the output: the result type of a function the macro makes is not held to the
// caller's imports either.
@ cases.a-global-a-macro-writes-in-a-result-type-is-not-held-to-the-callers-imports
backends = ["javascript"]
files."defs.nib" = ````nib
pub(open) shared struct Payload { value: Text }
````
files."lib.nib" = ````nib
import std::prelude::Macro
import "defs.nib"
pub macro fn make(name: SynExpr): List(SynStmt) {
  let id := match name { ExVar(id) => id
    _ => Syn::global("invalid") }
  let at := Syn::call_span()
  [StFn(SynFn {
    name: id, generics: Nil, generic_types: Nil, bounds: Nil, params: Nil, borrows: Nil, param_types: Nil,
    result: Some(ExVar(Syn::global("Payload"))), effects: None,
    body: ExRecord(Syn::global("Payload"), [#(ExText("ok", at), "value")], at), span: at
  })]
}
````
files."main.nib" = ````nib
import "lib.nib"
make!(answer) => fn answer
perform show("value", answer().value)
````
shows = ["value = \"ok\""]

