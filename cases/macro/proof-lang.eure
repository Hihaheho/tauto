@ cases.a-case-analysis-on-a-boolean-and-a-rewrite
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::Nat
import std::proof::Lang { proof }
import std::proof::Forms { proof_consider, proof_case, proof_using }

fn pick(b: Bool, n: Nat): Nat {
  ⊢ Nat from match b {
    true => n
    false => Zero
  }
}

theorem pick_zero(b: Bool, n: Nat): Nat::le(pick(b, Zero), n) = true {
  proof!(```
    Consider whether b holds.
      [not_b] Case h: not(b). Using h, the claim follows from Nat::le_zero.
      [b] Case h: b. Using h, the claim follows from Nat::le_zero.
    %%
    [not_b] (n)
    [b] (n)
  ```)
}
````
checks.pick_zero = "ok"
diagnostics = []

