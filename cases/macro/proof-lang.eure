@ cases.names-in-unicode-letters
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case }

pub(open) inductive 記号: Type {
  M: 記号
  I: 記号
}

pub(open) inductive 導出可能: (List(記号)) -> Prop {
  公理: 導出可能(Cons(M, Cons(I, Nil)))
  規則2(x: List(記号), h: 導出可能(Cons(M, x))): 導出可能(Cons(M, List::append(x, x)))
}

theorem 例(): 導出可能(Cons(M, Cons(I, Cons(I, Nil)))) {
  proof!(```
    We have 導出1: 導出可能(Cons(M, Cons(I, Cons(I, Nil)))) by 規則2(Cons(I, Nil), 公理). By 導出1.
  ```)
}

theorem 零足す(数: Nat): Nat::add(0, 数) = 数 {
  proof!(```
    By induction on 数.
      Case Zero. By Refl.
      [後者] Case Succ(前). We have 仮定: Nat::add(0, 前) = 前 by the induction hypothesis. By Eq::congr.
    %%
    [後者] (Succ, 仮定)
  ```)
}
````
checks."例" = "ok"
checks."零足す" = "ok"
