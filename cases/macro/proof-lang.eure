import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_we }

theorem append_cons<A>(x: A, rest: List(A), ys: List(A)): List::append([x, ..rest], ys) = [x, ..List::append(rest, ys)] {
  proof!(```
    We have List::append($[x, ..rest], ys) = $[x, ..List::append(rest, ys)].
  ```)
}

theorem append_nested(a: Nat, b: Nat): List::append([[a]], [[b]]) = [[a], [b]] {
  proof!(```
    We have List::append($[[a]], $[[b]]) = $[[a], [b]].
  ```)
}
