@ cases.a-step-by-a-call-of-the-theorem-itself
entry = "main.taut"
files."main.taut" = ````tauto
import std::proof::Lang { proof }
import std::proof::Forms { proof_we }

pub(open) inductive K: Type {
  A: K
  B: K
}

pub fn f(k: K): K {
  match k {
    A => B
    B => A
  }
}

theorem g(k: K): f(f(k)) = k {
  ⊢ f(f(k)) = k from match k {
    A => Refl
    B => Refl
  }
}

theorem by_named(n: Nat, k: K): f(f(f(k))) = f(k) {
  ⊢ f(f(f(k))) = f(k) from match n {
    Zero => g(f(k))
    Succ(m) => {
      let ih: f(f(f(k))) = f(k) := by_named(m, k)
      proof!(```
        We have f(f(f(k))) = f(k) by ih.
      ```)
    }
  }
}

theorem by_call(n: Nat, k: K): f(f(f(k))) = f(k) {
  ⊢ f(f(f(k))) = f(k) from match n {
    Zero => g(f(k))
    Succ(m) => proof!(```
      We have f(f(f(k))) = f(k) by by_call(m, k).
    ```)
  }
}
````
checks.by_named = "ok"
checks.by_call = "ok"
diagnostics = []

