theorem add_zero_left(n: Nat): Nat::add(0, n) = n {
  proof!(```
    By induction on n.
      Case Zero. By Refl.
      [succ] Case Succ(k). By the induction hypothesis, p: Nat::add(0, k) = k. Let s = Succ. By Eq::congr.
