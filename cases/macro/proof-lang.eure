import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_we }

theorem swap_inside<A>(
  op: (A, A) -> A,
  comm: (a: A, b: A) -> op(a, b) = op(b, a),
  f: (A) -> A,
  a: A,
  b: A,
  c: A
): f(op(op(a, b), c)) = f(op(op(b, a), c)) {
  proof!(```
    We have f(op(op(a, b), c)) = f(op(op(b, a), c)) by comm(a, b).
  ```)
}
````
checks.swap_inside = "ok"
