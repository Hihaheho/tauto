@ cases.an-induction-whose-case-is-a-case-analysis
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_consider }

pub(open) inductive S: Type {
  I: S
  O: S
}

pub fn count(xs: List(S)): Nat {
  match xs {
    Nil => Zero
    Cons(c, r) => match c {
      I => Succ(count(r))
      O => count(r)
    }
  }
}

pub fn cat(a: List(S), b: List(S)): List(S) {
  match a {
    Nil => b
    Cons(c, r) => Cons(c, cat(r, b))
  }
}

pub fn plus(n: Nat, m: Nat): Nat {
  match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}

theorem count_cat(a: List(S), b: List(S)): count(cat(a, b)) = plus(count(a), count(b)) {
  proof!(```
    By induction on a.
      Case Nil. By Refl.
      Case Cons(c, r). Consider c.
        [i] Case I. By Eq::congr.
        Case O. By ih(b).
    %%
    [i] (Succ, ih(b))
  ```)
}
````
checks.count_cat = "ok"
diagnostics = []

@ cases.the-induction-hypothesis-over-a-generalized-variable-is-applied-to-it
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_consider }

pub(open) inductive S: Type {
  I: S
  O: S
}

pub fn count(xs: List(S)): Nat {
  match xs {
    Nil => Zero
    Cons(c, r) => match c {
      I => Succ(count(r))
      O => count(r)
    }
  }
}

pub fn cat(a: List(S), b: List(S)): List(S) {
  match a {
    Nil => b
    Cons(c, r) => Cons(c, cat(r, b))
  }
}

pub fn plus(n: Nat, m: Nat): Nat {
  match n {
    Zero => m
    Succ(k) => Succ(plus(k, m))
  }
}

theorem count_cat(a: List(S), b: List(S)): count(cat(a, b)) = plus(count(a), count(b)) {
  proof!(```
    By induction on a.
      Case Nil. By Refl.
      Case Cons(c, r). Consider c.
        [i] Case I. By Eq::congr.
        Case O. By the induction hypothesis.
    %%
    [i] (Succ, ih(b))
  ```)
}
````
checks.count_cat = "ok"
diagnostics = []

