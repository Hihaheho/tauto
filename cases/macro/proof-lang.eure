// The place of a congruence is where the sides of the equation are, not the
// deepest place where the two terms differ: by `a ⋆ b = a ⋆ c` the place is
// `a ⋆ b`, although the terms first differ at `b`.
@ cases.congruence-at-the-sides-of-the-equation
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_we }

theorem inside<A>(op: (A, A) -> A, i: A, a: A, b: A, c: A, h: op(a, b) = op(a, c)): op(i, op(a, b)) = op(i, op(a, c)) {
  proof!(```
    We have op(i, op(a, b)) = op(i, op(a, c)) by h.
  ```)
}
````
checks.inside = "ok"
