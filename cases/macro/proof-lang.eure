@ cases.a-let-in-the-body-is-not-a-premise-of-the-induction-hypothesis
entry = "main.taut"
files."main.taut" = ````tauto
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_consider }

pub(open) inductive K: Type {
  A: K
  B: K
}

pub fn f(a: List(K), b: List(K)): List(K) {
  match a {
    [] => b
    [x, ..rest] => f(rest, b)
  }
}

theorem f_end(a: List(K), b: List(K)): f(a, b) = b {
  let g: ∀ k: K. k = k := (k) => Refl
  proof!(```
    By induction on a.
      Case Nil. By Refl.
      Case Cons(c, rest). Consider c.
        Case A. By the induction hypothesis, ih: ${∀ d: List(K). f(rest, d) = d}. By ${ih(b)}.
        Case B. By the induction hypothesis, ih: ${∀ d: List(K). f(rest, d) = d}. By ${ih(b)}.
  ```)
}

theorem uses_g(a: List(K), b: List(K)): K::A = K::A {
  let g: ∀ k: K. k = k := (k) => Refl
  proof!(```
    By induction on a.
      Case Nil. By ${g(K::A)}.
      Case Cons(c, rest). By ${g(K::A)}.
  ```)
}
````
checks.f_end = "ok"
checks.uses_g = "ok"
diagnostics = []

@ cases.an-induction-hypothesis-written-without-its-generalized-variables-says-its-form
entry = "main.taut"
files."main.taut" = ````tauto
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_consider }

pub(open) inductive K: Type {
  A: K
  B: K
}

pub fn f(a: List(K), b: List(K)): List(K) {
  match a {
    [] => b
    [x, ..rest] => f(rest, b)
  }
}

theorem f_end(a: List(K), b: List(K)): f(a, b) = b {
  let g: ∀ k: K. k = k := (k) => Refl
  proof!(```
    By induction on a.
      Case Nil. By Refl.
      Case Cons(c, rest). Consider c.
        Case A. By the induction hypothesis, ih: f(rest, b) = b. By ${ih}.
        Case B. By the induction hypothesis, ih: f(rest, b) = b. By ${ih}.
  ```)
}
````
