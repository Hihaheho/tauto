import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_we }

theorem named<A>(
  op: (A, A) -> A,
  unit: A,
  a: A,
  b: A,
  h1: op(a, b) = a,
  h2: a = unit
): unit = op(a, b) {
  proof!(```
    [main] We have h: op(a, b) = a by h1 = unit by h2. By Eq::sym.
