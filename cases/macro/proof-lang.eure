@ cases.a-sentence-names-a-let-of-the-body
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_we }

theorem add_zero_left(n: Nat): Nat::add(0, n) = n {
  proof!(```
    By induction on n.
      Case Zero. By Refl.
      Case Succ(k). We have Nat::add(0, Succ(k)) = ${Succ(0 + k)} = Succ(k) by the induction hypothesis.
  ```)
}

theorem twice(n: Nat): Nat::add(0, Nat::add(0, n)) = n {
  let base: Nat::add(0, n) = n := add_zero_left(n)
  proof!(```
    We have Nat::add(0, Nat::add(0, n)) = Nat::add(0, n) by add_zero_left(Nat::add(0, n)) = n by base.
  ```)
}
````
checks.add_zero_left = "ok"
checks.twice = "ok"
