import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case }

theorem zero_add(n: Nat): Nat::add(0, n) = n {
  proof!(```
    By induction on n.
      Case Zero. By the induction hypothesis.
      [succ] Case Succ(k). By Eq::congr.
    %%
    [succ] (Succ, ih)
  ```)
}
````
