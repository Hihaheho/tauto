@ cases.a-chain-of-equations-with-congruence
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_we }

theorem add_zero_left(n: Nat): Nat::add(0, n) = n {
  proof!(```
    By induction on n.
      Case Zero. By Refl.
      Case Succ(k). We have Nat::add(0, Succ(k)) = ${Succ(0 + k)} = Succ(k) by the induction hypothesis.
  ```)
}

theorem add_zero_left_named(n: Nat): Nat::add(0, n) = n {
  proof!(```
    By induction on n.
      Case Zero. By Refl.
      [succ] Case Succ(k). We have q: Nat::add(0, k) = k by the induction hypothesis. By Eq::congr.
    %%
    [succ] (Succ, q)
  ```)
}
````
checks.add_zero_left = "ok"
checks.add_zero_left_named = "ok"
diagnostics = []

