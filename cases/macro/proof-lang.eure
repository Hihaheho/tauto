@ cases.a-tactic-as-a-reason-of-a-sentence
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::Tactic { nat_norm }
import std::Rewrite { rewrite }
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_we }

theorem chain(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  proof!(```
    We have Nat::add(a, b) = Nat::add(b, a) by $nat_norm!(()).
  ```)
}

theorem fact(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  proof!(```
    We have h: Nat::add(a, b) = Nat::add(b, a) by $nat_norm!(()). By h.
  ```)
}

theorem whole(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  proof!(```
    By $nat_norm!(()).
  ```)
}

theorem suffices(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  proof!(```
    By $rewrite!(Nat::add_comm(a, b)), it suffices to show Nat::add(b, a) = Nat::add(b, a). By Refl.
  ```)
}

theorem under(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  proof!(```
    By $rewrite!(Nat::add_comm(a, b)).
      We show Nat::add(b, a) = Nat::add(b, a). By Refl.
  ```)
}
````
checks."main.taut::chain" = "ok"
checks."main.taut::fact" = "ok"
checks."main.taut::whole" = "ok"
checks."main.taut::suffices" = "ok"
checks."main.taut::under" = "ok"
diagnostics = []

