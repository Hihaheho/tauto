@ cases.induction-on-a-type-with-parameters-and-a-generalized-hypothesis
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_we }

fn product<A>(op: (A, A) -> A, unit: A, xs: List(A)): A {
  ⊢ A from match xs {
    Nil => unit
    Cons(x, rest) => op(x, product(op, unit, rest))
  }
}

fn append<A>(xs: List(A), ys: List(A)): List(A) {
  ⊢ List(A) from match xs {
    Nil => ys
    Cons(x, rest) => Cons(x, append(rest, ys))
  }
}

theorem product_append<A>(
  op: (A, A) -> A,
  unit: A,
  assoc: (a: A, b: A, c: A) -> op(op(a, b), c) = op(a, op(b, c)),
  left_unit: (a: A) -> op(unit, a) = a,
  xs: List(A),
  ys: List(A)
): product(op, unit, append(xs, ys)) = op(product(op, unit, xs), product(op, unit, ys)) {
  proof!(```
    By induction on xs.
      [nil] Case Nil. By Eq::sym.
      Case Cons(x, rest). We have op(x, product(op, unit, append(rest, ys)))
        = op(x, op(product(op, unit, rest), product(op, unit, ys))) by the induction hypothesis
        = op(op(x, product(op, unit, rest)), product(op, unit, ys)) by assoc(x, product(op, unit, rest), product(op, unit, ys)).
    %%
    [nil] left_unit(product(op, unit, ys))
  ```)
}
````
checks.product_append = "ok"
diagnostics = []

@ cases.induction-with-qualified-constructors
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_we }

fn product<A>(op: (A, A) -> A, unit: A, xs: List(A)): A {
  ⊢ A from match xs {
    Nil => unit
    Cons(x, rest) => op(x, product(op, unit, rest))
  }
}

fn map_list<A, B>(f: (A) -> B, xs: List(A)): List(B) {
  ⊢ List(B) from match xs {
    Nil => Nil
    Cons(x, rest) => Cons(f(x), map_list(f, rest))
  }
}

theorem map_product<A, B>(
  op: (A, A) -> A,
  unit: A,
  target: (B, B) -> B,
  target_unit: B,
  f: (A) -> B,
  preserves_unit: f(unit) = target_unit,
  preserves_op: (a: A, b: A) -> f(op(a, b)) = target(f(a), f(b)),
  xs: List(A)
): f(product(op, unit, xs)) = product(target, target_unit, map_list(f, xs)) {
  proof!(```
    By induction on xs.
      Case List::Nil. By preserves_unit.
      Case List::Cons(x, rest). We have f(op(x, product(op, unit, rest)))
        = target(f(x), f(product(op, unit, rest))) by preserves_op(x, product(op, unit, rest))
        = target(f(x), product(target, target_unit, map_list(f, rest))) by the induction hypothesis.
  ```)
}
````
checks.map_product = "ok"
diagnostics = []

