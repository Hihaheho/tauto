files."lib.taut" = ````tauto
import std::prelude::Macro
import std::prelude::Par
import std::prelude::Shared
import std::prelude::Affine

pub fn texts(ts: List(SynTok)): List(Text) ! {Div} {
  map(ts, (t: SynTok) => concat(t.text, "!"))
}

pub fn total(xs: List(Text)): u64 ! {Div} {
  let m: HashMap(Text, u64) := HashMap::new()
  HashMap::insert(m, "a", 1)
  Vec::len(HashMap::into_vec(m))
}

pub fn count_fmt(ts: List(SynTok), width: u64): Option(Text) ! {Div} {
  if total(texts(ts)) == 0 { None } else { Some("abc") }
}

syntax!(count, ```par
%start Doc
%title "count"
%%
Doc: Word;
Word: /[a-z]+/;
```, with(fmt: count_fmt)) => struct Doc, fn parse
