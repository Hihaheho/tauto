// The value computed when the macro runs is carried to the output as a
// literal (`syn_lift_u64`): the one way across the stages.
@ cases.a-macro-computes-at-compile-time
files."fib.nib" = ````nib
syntax fibn = ```par
{{par:fibn}}```
fn fib(n: u64) -> u64 ! {Div} { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

fn digits(t: Text, i: u64, acc: u64) -> u64 ! {Div} {
  match text_byte(t, i) {
    Some(b) => digits(t, i + 1, acc * 10 + (u64_of_u8(b) - 48))
    None => acc
  }
}

fn fib_const(n: fibn_N) -> SynExpr ! {macro_error, Div} {
  syn_lift_u64(fib(digits(n.digits.text, 0, 0)), n.span)
}
macro fib = fib_const
````
files."main.nib" = ````nib
import "fib.nib"
let x = fib!(`20`)
perform show("x", x)
````
expands = ```nib
let x = 6765
perform show("x", x)
```
shows = ["x = 6765"]

@ cases.a-compile-time-computation-runs-out-of-its-budget
files."fib.nib" = ````nib
syntax fibn = ```par
{{par:fibn}}```
fn fib(n: u64) -> u64 ! {Div} { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

fn digits(t: Text, i: u64, acc: u64) -> u64 ! {Div} {
  match text_byte(t, i) {
    Some(b) => digits(t, i + 1, acc * 10 + (u64_of_u8(b) - 48))
    None => acc
  }
}

fn fib_const(n: fibn_N) -> SynExpr ! {macro_error, Div} {
  syn_lift_u64(fib(digits(n.digits.text, 0, 0)), n.span)
}
macro fib = fib_const
````
files."main.nib" = ````nib
import "fib.nib"
let x = fib!(`30`)
````
