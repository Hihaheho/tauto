// A callable alias does not bypass the macro builtin boundary.
@ cases.a-macro-that-reaches-the-os-through-a-variable-is-refused
files."math.nib" = ````nib
syntax!(math, ```par
{{par:math}}```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1,
  enum Term, fn parse
pub macro fn leak(e: math::Eqn): SynExpr {
  let f := read_file
  match f("/etc/passwd") {
    Ok(t) => Syn::lift_text(t, e.span)
    Err(m) => Syn::lift_text(m, e.span)
  }
}
````
files."main.nib" = ````nib
import "math.nib"
let x := leak!(`1 = 1`)
````
macro_error = "macro.row"

@ cases.a-macro-function-may-not-show
files."math.nib" = ````nib
syntax!(math, ```par
{{par:math}}```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1,
  enum Term, fn parse
pub macro fn noisy(e: math::Eqn): SynExpr ! {∀ A. show(A)} {
  perform show("e", 1)
  quote { 0 }
}
````
files."main.nib" = ````nib
import "math.nib"
let x := noisy!(`1 = 1`)
````
macro_error = "macro.row: the function of a macro may perform macro_error, macro_warn, elab and Div, and `noisy` performs show"

