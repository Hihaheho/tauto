// What a `syntax` declaration makes: a type for each rule that is not a token
// (a token is a `SynToken` field, `TautoExpr` a `SynExpr`), none for the
// rules the generator adds (`SumList`), and the parser.
@ cases.a-syntax-declaration-makes-types-and-a-parser
files."main.nib" = ````nib
syntax math = ```par
{{par:math}}```
````
expands = ```nib
struct math_Eqn {
  span: SynSpan, sum: math_Sum, equals: SynToken, sum_2: math_Sum
}
struct math_Paren {
  span: SynSpan, l_paren: SynToken, sum: math_Sum, r_paren: SynToken
}
struct math_Sum {
  span: SynSpan, term: math_Term, rep: List(math_Sum_Rep1)
}
struct math_Sum_Rep1 {
  span: SynSpan, plus: SynToken, term: math_Term
}
enum math_Term {
  Num(SynToken)
  Paren(math_Paren)
  Embed(SynExpr)
}
fn math_parse(
  t: Text
) -> Result(
  math_Eqn,
  SynDiag
) { syn_parse("math", "de0f4cb98b624e291bdc49d8877eaa936ccc4a26b3371d17270d4ba64e6c9791", t) }
```

// A literal that no macro reads is the value of the typed AST. It runs no
// code of the user, so it may be in the file of the `syntax` declaration.
@ cases.a-literal-without-a-macro-is-a-value
files."main.nib" = ````nib
syntax math = ```par
{{par:math}}```
let e = math`(1 + 2) + 3 = 6`
let lhs = match e.sum.term {
  Num(tok) => "num"
  Paren(p) => "paren"
  Embed(x) => "embed"
}
let rhs = match e.sum_2.term {
  Num(tok) => tok.text
  Paren(p) => "paren"
  Embed(x) => "embed"
}
perform show("lhs", lhs)
perform show("equals", e.equals.text)
perform show("rhs", rhs)
````
shows = ["lhs = \"paren\"", "equals = \"=\"", "rhs = \"6\""]

