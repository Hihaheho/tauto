````
macro_error = "macro.not_allowed_builtin"

@ cases.a-macro-that-never-stops-runs-out-of-its-budget
files."math.nib" = ````nib
syntax math = ```par
{{par:math}}```
fn spin(n: i64) -> i64 ! {Div} { spin(n) }
fn math_bad(e: math_Eqn) -> SynExpr ! {macro_error, Div} {
  let _ = spin(0)
  quote { Eq(Nat, 1, 1) }
}
macro math = math_bad
````
files."main.nib" = ````nib
import "math.nib"
theorem t(): math!(`1 = 1`) { refl(Nat, 1) }
````
macro_error = "macro.budget_exceeded"

