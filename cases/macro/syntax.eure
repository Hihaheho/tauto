// The value computed when the macro runs is carried to the output as a
// literal (`Syn::lift_u64`): the one way across the stages.
@ cases.a-macro-computes-at-compile-time
files."fib.nib" = ````nib
import std::prelude::Macro

syntax!(fibn, ```par
{{par:fibn}}```) => struct N, fn parse
pub fn fib_value(n: u64): u64 ! {Div} { if n < 2 { n } else { fib_value(n - 1) + fib_value(n - 2) } }

pub fn digits(t: Text, i: u64, acc: u64): u64 ! {Div} {
  match Text::byte(t, i) {
    Some(b) => digits(t, i + 1, acc * 10 + (U64::of_u8(b) - 48))
    None => acc
  }
}

macro fn fib(n: fibn::N): SynExpr ! {macro_error, Div} {
  Syn::lift_u64(fib_value(digits(n.digits.text, 0, 0)), n.span)
}
````
files."main.nib" = ````nib
import "fib.nib"
let x := fib!(`20`)
perform show("x", x)
````
expands = ```nib
let x := 6765
perform show("x", x)
```
shows = ["x = 6765"]

