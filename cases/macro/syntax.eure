// A terminal named `Text` makes a constructor `Text`; the parse function and
// the files that read the standard library's `Text` still mean the type.
@ cases.a-terminal-named-text-does-not-hide-the-text-type
files."atom.nib" = ````nib
import std::Text
syntax!(atom, ```par
{{par:text_atom}}```) => enum Atom, fn parse
pub fn atom_name(a: atom::Atom): std.prelude.Text {
  match a {
    Num(t) => "num"
    Text(t) => t.text
  }
}

pub fn atom_kind(src: std.prelude.Text): std.prelude.Text {
  match atom::parse(src) {
    Ok(a) => atom_name(a)
    Err(d) => "error"
  }
}
````
files."main.nib" = ````nib
import "atom.nib"
import std::Text
theorem len(): Text::len("ab") = 2 { Refl }
````
checks.len = "ok"

// The names a syntax literal's value is built with (`SynToken`, `SynSpan`) are written by the
// literal's expansion: the file that uses the literal need not import `std::prelude::Macro`.
@ cases.a-syntax-literal-does-not-need-the-macro-import
files."atom.nib" = ````nib
import std::prelude::Macro
syntax!(atom, ```par
{{par:text_atom}}```) => enum Atom, fn parse
````
files."main.nib" = ````nib
import "atom.nib"

fn other(): atom::Atom {
  atom`42`
}
````
types = "ok"
