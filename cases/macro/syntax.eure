// Macros over several files. A
// `{{par:NAME}}` is the grammar in `grammars/NAME.par`; its tables are in
// `.tauto-syntax`, made by `scripts/generate-syntax-fixtures.sh`.

@ cases.a-syntax-macro-makes-the-theorem-statement
files."math.nib" = ````nib
syntax!(math, ```par
{{par:math}}```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1,
  enum Term, fn parse
pub fn math_term(t: math::Term): SynExpr ! {macro_error, Div} {
  match t {
    Num(tok) => Syn::nat(tok)
    Paren(p) => math_sum(p.sum)
    Embed(e) => e
  }
}

pub fn math_rest(acc: SynExpr, rest: List(math::Sum_Rep1)): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => {
      let t := math_term(r.term)
      math_rest(quote { $acc + $t }, more)
    }
  }
}

pub fn math_sum(s: math::Sum): SynExpr ! {macro_error, Div} {
  math_rest(math_term(s.term), s.rep)
}

pub macro fn math(e: math::Eqn): SynExpr ! {macro_error, Div} {
  let l := math_sum(e.sum)
  let r := math_sum(e.sum_2)
  quote { Eq(Nat, $l, $r) }
}
````
files."main.nib" = ````nib
import "math.nib"
theorem one_plus_two(): math!(`1 + 2 = 3`) { Refl }
theorem succ_eq(n: Nat): math!(`$n + 1 = $n + 1`) { Refl }
theorem embed_sum(n: Nat): math!(`$n + (1 + 2) = ${n + 3}`) { Refl }
````
checks.one_plus_two = "ok"
checks.succ_eq = "ok"
checks.embed_sum = "ok"
expands = ```nib
theorem one_plus_two(): 1 + 2 = 3 { Eq::Refl }
theorem succ_eq(n: Nat): n + 1 = n + 1 { Eq::Refl }
theorem embed_sum(n: Nat): n + (1 + 2) = n + 3 { Eq::Refl }
```
trace = ["math", "math", "math"]

