// Through a variable the reach of a function is not followed, so it is refused too.
@ cases.a-macro-that-reaches-the-os-through-a-variable-is-refused
files."math.nib" = ````nib
syntax math = ```par
{{par:math}}```
fn leak(e: math_Eqn) -> SynExpr {
  let f = os_read_file
  match f("/etc/passwd") {
    Ok(t) => syn_lift_text(t, e.span)
    Err(m) => syn_lift_text(m, e.span)
  }
}
macro leak = leak
````
files."main.nib" = ````nib
import "math.nib"
let x = leak!(`1 = 1`)
````
macro_error = "macro.unchecked_effect"

@ cases.a-macro-function-may-not-show
files."math.nib" = ````nib
syntax math = ```par
{{par:math}}```
fn noisy(e: math_Eqn) -> SynExpr ! {show} {
  perform show("e", 1)
  quote { 0 }
}
macro noisy = noisy
````
files."main.nib" = ````nib
import "math.nib"
let x = noisy!(`1 = 1`)
````
macro_error = "macro.row: the function of a macro may perform macro_error, macro_warn, elab and Div, and `noisy` performs show"

