// A second macro of the same syntax, with another meaning.
@ cases.two-macros-read-one-syntax
files."math.nib" = ````nib
import std::prelude::Macro

syntax!(math, ```par
{{par:math}}```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1,
  enum Term, fn parse
pub fn math_term(t: math::Term): SynExpr ! {macro_error, Div} {
  match t {
    Num(tok) => Syn::nat(tok)
    Paren(p) => math_sum(p.sum)
    Embed(e) => e
  }
}

pub fn math_rest(acc: SynExpr, rest: List(math::Sum_Rep1)): SynExpr ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => {
      let t := math_term(r.term)
      math_rest(quote { $acc + $t }, more)
    }
  }
}

pub fn math_sum(s: math::Sum): SynExpr ! {macro_error, Div} {
  math_rest(math_term(s.term), s.rep)
}

pub macro fn math(e: math::Eqn): SynExpr ! {macro_error, Div} {
  let l := math_sum(e.sum)
  let r := math_sum(e.sum_2)
  quote { Eq(Nat, $l, $r) }
}
````
files."check.nib" = ````nib
import "math.nib"
import std::prelude::Macro

pub fn digits(t: Text, i: u64, acc: u64): u64 ! {Div} {
  match Text::byte(t, i) {
    Some(b) => digits(t, i + 1, acc * 10 + (U64::of_u8(b) - 48))
    None => acc
  }
}

pub fn math_term_value(t: math::Term, at: SynSpan): u64 ! {macro_error, Div} {
  match t {
    Num(tok) => digits(tok.text, 0, 0)
    Paren(p) => math_value(p.sum)
    Embed(e) => Syn::error(at, "math_check: an expression has no value here")
  }
}

pub fn math_rest_value(acc: u64, rest: List(math::Sum_Rep1)): u64 ! {macro_error, Div} {
  match rest {
    Nil => acc
    Cons(r, more) => math_rest_value(acc + math_term_value(r.term, r.span), more)
  }
}

pub fn math_value(s: math::Sum): u64 ! {macro_error, Div} {
  math_rest_value(math_term_value(s.term, s.span), s.rep)
}

pub macro fn math_check(e: math::Eqn): SynExpr ! {macro_error, Div} {
  if math_value(e.sum) == math_value(e.sum_2) { quote { true } } else { quote { false } }
}
````
files."main.nib" = ````nib
import "check.nib"
theorem t(): math!(`1 + 2 = 3`) { Refl }
let ok := math_check!(`1 + 2 = 3`)
let ng := math_check!(math`(1 + 2) + 10 = 4`)
perform show("ok", ok)
perform show("ng", ng)
````
expands = ```nib
theorem t(): 1 + 2 = 3 { Eq::Refl }
let ok := true
let ng := false
perform show("ok", ok)
perform show("ng", ng)
```
trace = ["math", "math_check", "math_check"]
shows = ["ok = true", "ng = false"]

