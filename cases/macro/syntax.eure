// What a `syntax` declaration makes: a type for each rule that is not a token
// (a token is a `SynToken` field, `TautoExpr` a `SynExpr`), none for the
// rules the generator adds (`SumList`), and the parser.
@ cases.a-syntax-declaration-makes-types-and-a-parser
files."main.nib" = ````nib
import std::prelude::Macro

syntax!(math, ```par
{{par:math}}```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1,
  enum Term, fn parse
````
expands = ```nib
module math {
  pub(open) struct Eqn {
    span: SynSpan, sum: math::Sum, equals: SynToken, sum_2: math::Sum
  }
  pub(open) struct Paren {
    span: SynSpan, l_paren: SynToken, sum: math::Sum, r_paren: SynToken
  }
  pub(open) struct Sum {
    span: SynSpan, term: math::Term, rep: List(math::Sum_Rep1)
  }
  pub(open) struct Sum_Rep1 {
    span: SynSpan, plus: SynToken, term: math::Term
  }
  pub(open) enum Term {
    Num(SynToken)
    Paren(math::Paren)
    Embed(SynExpr)
  }
  pub(open) fn parse(t: Text): Result(math::Eqn, SynDiag) { Syn::parse("math", "de0f4cb98b624e291bdc49d8877eaa936ccc4a26b3371d17270d4ba64e6c9791", t) }
}
```

// A literal that no macro reads is the value of the typed AST. It runs no
// code of the user, so it may be in the file of the `syntax` declaration.
@ cases.a-literal-without-a-macro-is-a-value
files."main.nib" = ````nib
import std::prelude::Macro

syntax!(math, ```par
{{par:math}}```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1,
  enum Term, fn parse
let e := math`(1 + 2) + 3 = 6`
let lhs := match e.sum.term {
  Num(tok) => "num"
  Paren(p) => "paren"
  Embed(x) => "embed"
}
let rhs := match e.sum_2.term {
  Num(tok) => tok.text
  Paren(p) => "paren"
  Embed(x) => "embed"
}
perform show("lhs", lhs)
perform show("equals", e.equals.text)
perform show("rhs", rhs)
````
shows = ["lhs = \"paren\"", "equals = \"=\"", "rhs = \"6\""]

