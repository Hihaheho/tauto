@ cases.definition-reference
entry = "src/main.taut"
files."Tauto.eure" = 'package { name = "view-caller-name" version = "0.1.0" }'
files."src/library.taut" = `pub fn element(): i64 { 0 }`
files."src/syntax-defs.taut" = ````tauto
import std::builtin::macro
import "library.taut"
syntax!(caller, ```par
{{par:caller_expression}}```) => struct Root, fn parse
pub macro fn caller(e: caller::Root): SynExpr {
  let body := e.tauto_expr
  quote { (() => $body)() }
}
pub macro fn defined(e: SynExpr): SynExpr { quote { element() } }
````
files."src/main.taut" = ````tauto
import std::builtin::macro
import "syntax-defs.taut"
fn element(): i64 { 42 }
perform main(() => {
  show(&(caller!(```caller
    (${element()})
  ```)))
  show(&(defined!(true)))
})
````
types = "ok"
rows = "ok"
lin = "ok"
stdout = ```
42
0
```

@ cases.annotated-lambda
description = "A lambda with a typed parameter written in an embedded expression is run as the macro makes it again."
entry = "src/main.taut"
files."Tauto.eure" = 'package { name = "view-caller-name" version = "0.1.0" }'
files."src/syntax-defs.taut" = ````tauto
import std::builtin::macro
syntax!(caller, ```par
{{par:caller_expression}}```) => struct Root, fn parse
pub macro fn caller(e: caller::Root): SynExpr {
  let body := e.tauto_expr
  quote { ($body)(one()) }
}
pub fn one(): Nat { 1 }
````
files."src/main.taut" = ````tauto
import std::builtin::macro
import "syntax-defs.taut"
fn key(k: Nat): u64 { 7 }
fn run(): u64 {
  caller!(```caller
    (${(k: Nat) => key(k)})
  ```)
}
perform main(() => {
  show(&run())
})
````
types = "ok"
rows = "ok"
lin = "ok"
stdout = "7\n"
