// `tail`: a call of the function itself in tail position whose frame may be
// discarded is marked `recur`; one whose frame is still needed stays a call.

@ cases.tail-marks-an-owned-accumulator
source = ```tauto
fn count(n: u64, done: u64): u64 ! {overflow} {
    if n == 0 { done } else { count(n - 1, done + 1) }
}
show(&count(3, 0))
```
stdout = "3\n"
nir.fns.count = ```nir
fn count@2(n#4: u64, done#5: u64): u64 A = if eq(copy n#4, 0u64) then copy done#5 else count@2(sub<u64>(copy n#4, 1u64), add<u64>(copy done#5, 1u64)) tier A recur: u64
```

@ cases.tail-marks-a-borrow-passed-on
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```tauto

fn sum_from(v: &Vec(u64), i: u64, left: u64, acc: u64): u64 ! {out_of_bounds, overflow} {
    if left == 0 {
        acc
    } else {
        let x := Vec::index(&v, i)
        let next := if i + 1 == Vec::len(&v) { 0 } else { i + 1 }
        sum_from(&v, next, left - 1, acc + x)
    }
}
var v: Vec(u64) := Vec::new()
Vec::push(&mut v, 1)
Vec::push(&mut v, 2)
show(&(handle { sum_from(&v, 0, 3, 0) } with { out_of_bounds() => 0 }))
```
stdout = "4\n"
nir.fns.sum_from = ```nir
fn sum_from@2(ref v#5: &Vec(u64), i#6: u64, left#7: u64, acc#8: u64): u64 A = if eq(copy left#7, 0u64) then copy acc#8 else {
  let ref x#9 := Vec::index@5<u64>(&v#5, copy i#6) tier A: &u64;
  let next#10 := if eq(add<u64>(copy i#6, 1u64), builtin Vec::len(&v#5): u64) then 0u64 else add<u64>(copy i#6, 1u64);
  sum_from@2(&v#5, copy next#10, sub<u64>(copy left#7, 1u64), add<u64>(copy acc#8, copy x#9)) tier A recur: u64
}
```

@ cases.tail-marks-a-borrow-of-a-parameters-part
source = ```tauto
fn reverse_onto<A>(l: List(A), acc: List(A)): List(A) {
    ⊢ List(A) from match l {
        Nil => acc
        Cons(h, t) => reverse_onto(t, Cons(h, acc))
    }
}
fn len<A>(l: List(A), n: u64): u64 ! {overflow} {
    ⊢ u64 from match l {
        Nil => n
        Cons(_, t) => len(t, n + 1)
    }
}
let xs: List(u64) := Cons(1, Cons(2, Cons(3, Nil)))
let ys := reverse_onto(xs, Nil)
let n := len(ys, 0) + len(xs, 0)
show(&n)
```
stdout = "6\n"
nir.fns.reverse_onto = ```nir
fn reverse_onto@1<'A: Clone>(l#5: List('A), acc#6: List('A)): List('A) S = match move l#5 {
  List::Nil => move acc#6,
  List::Cons(h#7: 'A, t#8: List('A)) => reverse_onto@1<'A>(move t#8, List::Cons(move h#7, move acc#6): List('A)) recur: List('A),
}
```
nir.fns.len = ```nir
fn len@2<'A: Clone>(l#9: List('A), n#10: u64): u64 A = match move l#9 {
  List::Nil => copy n#10,
  List::Cons(_, t#11: List('A)) => len@2<'A>(move t#11, add<u64>(copy n#10, 1u64)) tier A recur: u64,
}
```

@ cases.tail-leaves-a-call-whose-value-is-used
source = ```tauto
fn count(n: u64): u64 ! {overflow} {
    if n == 0 { 0 } else { 1 + count(n - 1) }
}
show(&count(3))
```
stdout = "3\n"
