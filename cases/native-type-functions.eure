@ cases.unused-type-function-rejects-unborrowed-slice
extract = true
entry = "main.taut"
files."main.taut" = ```tauto
import std::prelude::Affine
fn Bad(A: Type): Type { Slice(A) }
perform show("ok", 0)
```
load_error = "Slice(A) can only be borrowed"

@ cases.ignored-type-argument-rejects-kind-on-nonfunction
extract = true
entry = "main.taut"
files."main.taut" = ```tauto
struct Payload { n: nat }
fn Constant(A: Type): Type { Payload }
let payload: Constant(affine nat) := Payload { n: 1 }
perform show("ok", payload.n)
```
load_error = "is the kind of a function type"

@ cases.type-function-keeps-borrow-context-for-slice
extract = true
source = ```tauto
import std::prelude::Affine
fn View(A: Type): Type { &Slice(A) }
perform show("ok", 1)
```
shows = ["ok = 1"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["ok = 1"]
javascript_shows = ["ok = 1"]
