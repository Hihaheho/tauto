@ cases.explicit-arm-goals
source = `````tauto
fn f(x: Bool): Nat {
  ⊢ Nat from match x {
    true => ⊢ Nat from {
      match x {
        true => 1
        false => 2
      }
    }
    false => 0
  }
}
`````
format = `````tauto
fn f(x: Bool): Nat {
  ⊢ Nat from match x {
    true => ⊢ Nat from match x { true => 1, false => 2 }
    false => 0
  }
}
`````
differential = "fmt"

