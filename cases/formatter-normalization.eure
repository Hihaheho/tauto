    }
    false => 0
  }
}
`````
format = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => {
      if x { 1 } else { 2 };
    }
    false => 0
  }
}
`````
differential = "fmt"

@ cases.quantifier-binders-stay-one-parameter
description = "The commas of `∀ x: A, y: A.` separate binders of one parameter's type, so a broken parameter list keeps them on one line."
source = `````tauto
pub theorem t<A>(h: ∀ x: A, y: A. x = y, a: A, b: A, c: A, d: A, e: A, f: A, g: A, ok: A, ok2: A): a = a {
  Eq::Refl
}
`````
format = `````tauto
pub theorem t<A>(
  h: ∀ x: A, y: A. x = y,
  a: A,
  b: A,
  c: A,
  d: A,
  e: A,
  f: A,
  g: A,
  ok: A,
  ok2: A
): a = a {
  Eq::Refl
}
`````
differential = "fmt"

@ cases.one-item-group-stays-whole
description = "A group of one item that cannot break (`Option(A)`) is not broken, a later group breaks instead: breaking it would only move the item to a line of its own."
source = `````tauto
class Ord2(A: Type) {
  theorem swap<a: Option(A), b: Option(A)>(): Ord::compare(a, b) = Less ↔ Ord::compare(b, a) = Greater
}
`````
format = `````tauto
class Ord2(A: Type) {
  theorem swap<a: Option(A), b: Option(A)>(): Ord::compare(
    a,
    b
  ) = Less ↔ Ord::compare(b, a) = Greater
}
`````
differential = "fmt"

@ cases.raw-borrows-keeps-its-prefix
source = `````tauto
struct S {
  r#borrows: Bool
}
`````
format = `````tauto
struct S {
  r#borrows: Bool
}
`````
differential = "fmt"

@ cases.long-effect-row-breaks
description = "An over-long effect-row literal breaks one effect per line, as a call's arguments do."
source = `````tauto
fn f(g: () -> Nat ! {div, stdout, stderr, argv, wall_clock, monotonic_clock, sleep, random, fs_read, fs_write}): Nat {
  zero
}
`````
format = `````tauto
fn f(
  g: () -> Nat ! {
    div,
    stdout,
    stderr,
    argv,
    wall_clock,
    monotonic_clock,
    sleep,
    random,
    fs_read,
    fs_write
  }
): Nat {
  zero
}
`````
differential = "fmt"

@ cases.multiline-effect-row-kept
description = "A row literal already broken across lines is left as written."
source = `````tauto
fn burn(): Unit ! {
  query(Flames),
  query(Kindling),
  entity_not_found,
  component_not_found,
  component_already_exists,
  insert(Burning),
  update(Health),
} {
  #()
}
`````
format = `````tauto
fn burn(): Unit ! {
  query(Flames),
  query(Kindling),
  entity_not_found,
  component_not_found,
  component_already_exists,
  insert(Burning),
  update(Health),
} {
  #()
}
`````
differential = "fmt"

@ cases.one-line-effect-row-drops-trailing-comma
description = "A one-line effect row that ends with a comma loses that comma under `tauto fmt`."
source = `````tauto
fn f(): Unit ! {div,} { #() }
`````
format = `````tauto
fn f(): Unit ! {div} { #() }
`````
differential = "fmt"

@ cases.orig-borrow-keeps-its-word
description = "`&orig` in a type and in a term is written back as `&orig`, not as `&`."
source = `````tauto
fn first(b: &orig Bag): u64 { b.n }
let f := first(&orig b)
`````
format = `````tauto
fn first(b: &orig Bag): u64 { b.n }
let f := first(&orig b)
`````
