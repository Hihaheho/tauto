@ cases.quantifier-binders-stay-one-parameter
description = "The commas of `∀ x: A, y: A.` separate binders of one parameter's type, so a broken parameter list keeps them on one line."
source = `````tauto
pub theorem t<A>(h: ∀ x: A, y: A. x = y, a: A, b: A, c: A, d: A, e: A, f: A, g: A, ok: A, ok2: A): a = a {
  Eq::Refl
}
`````
format = `````tauto
pub theorem t<A>(
  h: ∀ x: A, y: A. x = y,
  a: A,
  b: A,
  c: A,
  d: A,
  e: A,
  f: A,
  g: A,
  ok: A,
  ok2: A
): a = a {
  Eq::Refl
}
`````
differential = "fmt"

@ cases.one-item-group-stays-whole
description = "A group of one item that cannot break (`Option(A)`) is not broken, a later group breaks instead: breaking it would only move the item to a line of its own."
source = `````tauto
class Ord2(A: Type) {
  theorem swap<a: Option(A), b: Option(A)>(): Ord::compare(a, b) = Less ↔ Ord::compare(b, a) = Greater
}
`````
format = `````tauto
class Ord2(A: Type) {
  theorem swap<a: Option(A), b: Option(A)>(): Ord::compare(
    a,
    b
  ) = Less ↔ Ord::compare(b, a) = Greater
}
`````
differential = "fmt"
