@ cases.nested-match-arms
source = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => {
      match x {
        true => 1
        false => 2
      }
    }
    false => 0
  }
}
`````
format = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => match x {
      true => 1
      false => 2
    }
    false => 0
  }
}
`````
differential = "fmt"

@ cases.if-arm-and-else-if
source = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => {
      if x { 1 } else {
        if x { 2 } else { 3 }
      }
    }
    false => 0
  }
}
`````
format = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => if x { 1 } else if x { 2 } else { 3 }
    false => 0
  }
}
`````
differential = "fmt"

@ cases.bindings-and-while-keep-their-blocks
source = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => {
      let y := 1
      if x { y } else { 2 }
    }
    false => {
      while x {
        break
      }
    }
  }
}
`````
format = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => {
      let y := 1
      if x { y } else { 2 }
    }
    false => {
      while x {
        break
      }
    }
  }
}
`````
differential = "fmt"

@ cases.comments-keep-boundary-blocks
source = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => {
      // keep this boundary
      match x {
        true => 1
        false => 2
      }
    }
    false => {
      if x { 3 } else { 4 }
      // keep the closing boundary
    }
  }
}
`````
format = `````tauto
fn f(x: Bool): Nat {
  match x {
    true => {
      // keep this boundary
      match x {
        true => 1
        false => 2
      }
    }
    false => {
      if x { 3 } else { 4 }
      // keep the closing boundary
    }
  }
}
`````
differential = "fmt"

@ cases.quote-and-macro-input-keep-blocks
source = `````tauto
macro fn q(e: SynExpr): SynExpr { quote {
  match x {
    true => {
      match y {
          true => 1
          false => 2
        }
    }
    false => 0
  }
} }
let x := q!(match z {
  true => {
    if y { 1 } else { 2 }
  }
  false => 0
})
`````
format = `````tauto
macro fn q(e: SynExpr): SynExpr { quote {
    match x {
      true => {
        match y {
          true => 1
          false => 2
        }
      }
      false => 0
    }
  } }
let x := q!(match z {
  true => {
    if y { 1 } else { 2 }
  }
  false => 0
})
`````
differential = "fmt"

@ cases.block-literal-attaches-to-call
source = `````tauto
fn f() {
  let reward := view!(
    ```view
  $t <span>
    ${text_dyn(t, () => token.value)}
  </span>
  ```
  )
}
`````
format = `````tauto
fn f() {
  let reward := view!(```view
    $t <span>
      ${text_dyn(t, () => token.value)}
    </span>
    ```)
}
`````
differential = "fmt"

