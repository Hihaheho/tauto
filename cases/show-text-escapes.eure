description = "`show` of a `Text` writes `\\u{…}` for each character past ASCII that is not printed: a control character, a format character, a combining mark and an unassigned or private one. Every other character, of every width, is written as it is."

@ cases.unprinted-characters-are-escaped
source = ```tauto
show(&"a\u{85}b\u{301}c\u{200B}é\u{1F600}\u{7F}\u{1}\u{E0001}日\u{FEFF}")
```
stdout = ```
"a\u{85}b\u{301}c\u{200b}é😀\u{7f}\u{1}\u{e0001}日\u{feff}"
```
