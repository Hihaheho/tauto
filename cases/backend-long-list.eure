// Rust and JavaScript drop long recursive values without using stack
// space in proportion to the number of cells.
@ cases.a-long-list-from-bytes-is-dropped
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```tauto
import std::builtin::os

var b := Bytes::of_text("a")
var i: u64 := 0
while i < 20 {
  b := Bytes::concat(b, b)
  i := i + 1
}
match Bytes::to_list(b) {
  Nil => print("nil")
  Cons(x, rest) => print(Text::of_nat(Nat::of_u64(U64::of_u8(x))))
}
```
stdout = "97"
stderr = ""
exit = 0

// Both backends drop a long chain of a program-defined recursive type.
@ cases.a-long-chain-of-a-program-type-is-dropped
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
stdout = "98\n"
scenarios = ["eval", "rust", "javascript", "vm", "llvm", "niri"]
source = ```tauto
enum Chain {
  End
  Link(u8, Chain)
}

fn chain(l: List(u8), acc: Chain): Chain {
  ⊢ Chain from match l {
    Nil => acc
    Cons(x, rest) => chain(rest, Link(x, acc))
  }
}

var b := Bytes::of_text("ab")
var i: u64 := 0
while i < 19 {
  b := Bytes::concat(b, b)
  i := i + 1
}
match chain(Bytes::to_list(b), End) {
  End => show(&0)
  Link(x, rest) => show(&Nat::of_u64(U64::of_u8(x)))
}
```

// JavaScript compares two long lists with `==` without using stack space in
// proportion to their length.
@ cases.long-lists-are-compared
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Bytes::of_text` yet"
source = ```tauto
import std::builtin::os

var b := Bytes::of_text("a")
var i: u64 := 0
while i < 20 {
  b := Bytes::concat(b, b)
  i := i + 1
}
if Bytes::to_list(b) == Bytes::to_list(b) { print("same") } else { print("differ") }
```
stdout = "same"
stderr = ""
exit = 0
