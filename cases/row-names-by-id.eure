// An entry of a row is read as the one declaration it means, by its
// reference, whichever way it is written: by its short name, by its full
// name, or as a set whose members are other declarations.

@ cases.a-row-names-a-library-effect-by-its-full-name
files."main.taut" = ```tauto
import std::builtin::os { print, stdout }

fn hello(): Unit ! {std::builtin::os::stdout} {
  print("hello\n")
}
```
entry = "main.taut"
check_errors = []

@ cases.a-row-names-the-host-set-by-its-full-name
