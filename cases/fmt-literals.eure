format_literals = ````tauto
import "lib.taut"
import std::prelude::Macro

// Nothing uses it, and it does not check.
fn broken(): Nat {
  let d := layout`a, b`
  true
}

pub macro fn m(e: layout::Doc): SynExpr ! {macro_error, Div} {
  quote { f(layout`x, y`) }
}

/// ```layout
/// p, q, r, 1, 2
/// ```
fn documented(): Nat { 0 }

/*
 * ```layout
 * s, t
 * ```
 */
fn blocked(): Nat { 0 }

fn other(): outline::Doc {
  outline`a ,  1`
}
````

