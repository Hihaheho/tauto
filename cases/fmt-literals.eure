files."lib.taut" = ````tauto
import std::prelude::Macro

pub fn layout_white(t: SynTok): Bool { t.kind == "Newline" || t.kind == "Whitespace" }

pub fn layout_sep(glue: Bool): Text {
  if glue { "" } else { " " }
}

// Items on a line, a space after each comma; a line comment (which holds its newline) ends the line.
pub fn layout_go(ts: List(SynTok), glue: Bool): Text ! {Div} {
  match ts {
    Nil => ""
    Cons(t, rest) => {
      if layout_white(t) {
        layout_go(rest, glue)
      } else {
        if t.kind == "Comma" {
          concat(",", layout_go(rest, false))
        } else {
          if t.kind == "LineComment" {
            concat(layout_sep(glue), concat(t.text, layout_go(rest, true)))
          } else {
            concat(layout_sep(glue), concat(t.text, layout_go(rest, false)))
          }
        }
      }
    }
  }
}

pub fn layout_fmt(ts: List(SynTok), width: u64): Option(Text) ! {Div} {
  Some(layout_go(ts, true))
}

pub fn layout_tokens(ts: List(SynTok)): List(SynHighlight) ! {Div} {
  match ts {
    Nil => Nil
    Cons(t, rest) => {
      if t.kind == "Num" {
        Cons(SynHighlight { start: t.start, end: t.end, kind: "number" }, layout_tokens(rest))
      } else {
        if t.kind == "Word" {
          Cons(SynHighlight { start: t.start, end: t.end, kind: "function" }, layout_tokens(rest))
        } else {
          layout_tokens(rest)
        }
      }
    }
  }
}

syntax!(layout, ```par
{{par:layout}}```, with(fmt: layout_fmt, tokens: layout_tokens)) => struct Doc, struct Doc_Rep1,
  enum Item, fn parse

pub fn outline_append(a: List(SynHighlight), b: List(SynHighlight)): List(SynHighlight) {
  match a {
    Nil => b
    Cons(x, rest) => Cons(x, outline_append(rest, b))
  }
}

pub fn outline_each(cs: List(SynCst)): List(SynHighlight) ! {Div} {
  match cs {
    Nil => Nil
    Cons(c, rest) => outline_append(outline_marks(c), outline_each(rest))
  }
}

// A number is a number and a word a type, by the node the grammar reads it as.
pub fn outline_marks(c: SynCst): List(SynHighlight) ! {Div} {
  match c {
    CstTok(t) => Nil
    CstNode(name, children, start, end) => {
      if name == "Num" {
        Cons(SynHighlight { start: start, end: end, kind: "number" }, Nil)
      } else {
        if name == "Word" {
          Cons(SynHighlight { start: start, end: end, kind: "type" }, Nil)
        } else {
          outline_each(children)
        }
      }
    }
  }
}

syntax!(outline, ```par
{{par:outline}}```, with(tokens: outline_marks)) => struct Doc, struct Doc_Rep1, enum Item,
  fn parse
````
