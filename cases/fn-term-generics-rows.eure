@ cases.inferred-value-row-first
imports = [path`../std/base.taut`]
source = ```tauto
inductive At(n: Nat): Type { Mk: At(n) }
fn index<!e, n: Nat>(w: At(n), callback: () -> Unit ! e): Nat ! {} ∪ e { callback(); n }
fn answer(): Nat { index(At::Mk(<n: 23>), () => #()) }
show(&answer())
```
stdout = "23\n"

@ cases.inferred-value-row-middle
imports = [path`../std/base.taut`]
source = ```tauto
inductive At(n: Nat): Type { Mk: At(n) }
fn index<A: Type, !e, n: Nat>(x: A, w: At(n), callback: () -> Unit ! e): Nat ! {} ∪ e { callback(); n }
fn answer(): Nat { index(true, At::Mk(<n: 23>), () => #()) }
show(&answer())
```
stdout = "23\n"

@ cases.inferred-value-row-last
imports = [path`../std/base.taut`]
source = ```tauto
inductive At(n: Nat): Type { Mk: At(n) }
fn index<n: Nat, !e>(w: At(n), callback: () -> Unit ! e): Nat ! {} ∪ e { callback(); n }
fn answer(): Nat { index(At::Mk(<n: 23>), () => #()) }
show(&answer())
```
stdout = "23\n"

@ cases.explicit-value-row-keeps-effects
imports = [path`../std/base.taut`]
source = ```tauto
effect tick(): Unit resume 1
fn keep<!e, n: Nat>(callback: () -> Unit ! e): Nat ! {tick} ∪ e { perform tick(); callback(); n }
fn answer(): Nat {
  handle { keep(29, () => #()) } with { tick(), k => k(#()) }
}
show(&answer())
```
stdout = "29\n"

@ cases.explicit-value-prefix-keeps-callback-row
imports = [path`../std/base.taut`]
source = ```tauto
effect ask(): Nat resume 1
fn asked(): Nat ! {ask} { perform ask() }
fn run<!e, n: Nat>(f: () -> Nat ! e): Nat ! e { f(); n }
fn answer(): Nat {
  handle { run(31, asked) } with { ask(), k => k(7) }
}
show(&answer())
```
stdout = "31\n"
