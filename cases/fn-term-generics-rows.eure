description = "Row parameters keep value generic telescopes and effect calls aligned."

@ cases.explicit-value-row-first
imports = [path`../std/base.taut`]
source = ```tauto
fn keep<!e, n: Nat>(callback: () -> Unit ! e): Nat ! {} ∪ e { callback(); n }
fn answer(): Nat { keep(<n: 13>, () => #()) }
show(&answer())
```
stdout = "13\n"

@ cases.explicit-value-row-middle
imports = [path`../std/base.taut`]
source = ```tauto
fn keep<a: Nat, !e, n: Nat>(callback: () -> Unit ! e): Nat ! {} ∪ e { callback(); n }
fn answer(): Nat { keep(<a: 1, n: 17>, () => #()) }
show(&answer())
```
stdout = "17\n"

