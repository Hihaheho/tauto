@ cases.inferred-value-row-first
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
inductive At(n: Nat): Type { Mk: At(n) }
fn index<!e, n: Nat>(w: At(n), callback: () -> Unit ! e): Nat ! {} ∪ e { callback(); n }
fn answer(): Nat { index(At::Mk(23), () => #()) }
perform show("value", answer())
```
shows = ["value = 23"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["value = 23"]
javascript_shows = ["value = 23"]

