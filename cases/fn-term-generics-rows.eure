description = "Row parameters keep value generic telescopes and effect calls aligned."

@ cases.explicit-value-row-first
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
fn keep<!e, n: Nat>(callback: () -> Unit ! e): Nat ! {} ∪ e { callback(); n }
fn answer(): Nat { keep(13, () => #()) }
perform show("value", answer())
```
shows = ["value = 13"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["value = 13"]
javascript_shows = ["value = 13"]

