@ cases.explicit-value-row-keeps-effects
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
effect tick(): Unit resume 1
fn keep<!e, n: Nat>(callback: () -> Unit ! e): Nat ! {tick} ∪ e { perform tick(); callback(); n }
fn answer(): Nat {
  handle { keep(29, () => #()) } with { tick(), k => k(#()) }
}
perform show("value", answer())
```
shows = ["value = 29"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["value = 29"]
javascript_shows = ["value = 29"]

@ cases.explicit-value-prefix-keeps-callback-row
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
effect ask(): Nat resume 1
fn asked(): Nat ! {ask} { perform ask() }
fn run<!e, n: Nat>(f: () -> Nat ! e): Nat ! e { f(); n }
fn answer(): Nat {
  handle { run(31, asked) } with { ask(), k => k(7) }
}
perform show("value", answer())
```
shows = ["value = 31"]
backends = ["rust", "javascript", "vm"]
rust_shows = ["value = 31"]
javascript_shows = ["value = 31"]
