// A constructor without fields called with no arguments is its value,
// written short (`Ka`) or qualified (`K::Ka`), as `Ka` is: checked,
// run and built alike.
@ cases.nullary-constructor-call
extract = true
source = ```tauto
inductive K: Type { Ka: K, Kb: K }

fn kf(x: K): Nat {
  ⊢ Nat from match x {
    Ka => Zero
    Kb => Succ(Zero)
  }
}

perform show("short", kf(Ka))
perform show("qualified", kf(K::Kb))
perform show("bare", kf(K::Ka))
```
shows = ['short = 0', 'qualified = 1', 'bare = 0']
rust_shows = ['short = 0', 'qualified = 1', 'bare = 0']
javascript_shows = ['short = 0', 'qualified = 1', 'bare = 0']
