// A function without parameters is called with `()` in proofs as in
// programs, and the type a `let` writes fixes its generic on every route.
@ cases.generic-fixed-by-the-let-type
extract = true
imports = [path`../std/Base.taut`]
source = ```tauto
fn none_of<A>(): Option(A) { None }

fn count(o: Option(Nat)): Nat {
  match o {
    None => 0
    Some(n) => n
  }
}

fn start(): Nat {
  let x: Option(Nat) := none_of();
  count(x)
}

perform show("start", start())
```
shows = ["start = 0"]
rust_shows = ["start = 0"]
javascript_shows = ["start = 0"]
