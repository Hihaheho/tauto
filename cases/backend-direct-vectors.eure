// Code over vectors, bytes, `Buf` and the fields of structs, through shared
// and mutable borrows, runs in direct form and gives what the evaluator gives.
@ cases.direct-vectors-in-place
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `U32::of_u64` yet"
stdout = ```
258
9007199254740995
3
2
"tea and tea"
9
1
14
0
253
9
```
source = ```tauto
struct Canvas { w: u64, h: u64 }

fn blend(dst: u32, src: u32): u32 { U32::or(dst, src) }

// A pixel through a cell: read, then written back.
fn put(px: &mut Vec(u32), i: u64, src: u32): Unit {
  let old := match Vec::get(&px, i) {
    Some(x) => x
    None => 0
  }
  match Vec::get_mut(&mut px, i) {
    Some(at) => {
      *at := blend(old, src)
    }
    None => #()
  }
}

fn fill(px: &mut Vec(u32), cv: Canvas, src: u32): Unit ! {div, overflow} {
  var y: u64 := 0
  while y < cv.h {
    var x: u64 := 0
    while x < cv.w {
      put(&mut px, y * cv.w + x, src)
      x := x + 1
    }
    y := y + 1
  }
}

fn sum(px: &Vec(u32)): u64 ! {div, overflow} {
  var s: u64 := 0
  var i: u64 := 0
  while i < Vec::len(&px) {
    s := s + match Vec::get(&px, i) { Some(x) => U64::of_u32(x), None => 0 }
    i := i + 1
  }
  s
}

fn bump(n: &mut u64, r#by: u64): Unit ! {overflow} { *n := n + r#by }

fn swap_in(v: &mut Vec(u64)): Vec(u64) ! {div} {
  var w: Vec(u64) := Vec::new()
  Vec::push(&mut w, 7)
  Vec::push(&mut w, 8)
  replace(&mut v, w)
}

fn words(t: &Text): Text ! {div} {
  var b := Buf::new()
  Buf::push(&mut b, t)
  let sp := " and "
  Buf::push(&mut b, &sp)
  Buf::push(&mut b, t)
  Text::of(b)
}

fn trim(v: &mut Vec(u64)): u64 ! {div} {
  let popped := match Vec::pop(&mut v) { Some(x) => x, None => 0 }
  Vec::truncate(&mut v, 1)
  popped
}

fn last_twice(v: &mut Vec(u64)): Unit ! {overflow} {
  match Vec::last_mut(&mut v) { Some(at) => { *at := at * 2 }, None => #() }
}

fn bytes_sum(b: Bytes): u64 ! {div, overflow} {
  var s: u64 := 0
  var i: u64 := 0
  while i < Bytes::len(b) {
    s := s + match Bytes::get(b, i) { Some(x) => U64::of_u8(x), None => 0 }
    i := i + 1
  }
  s
}

fn rows(cv: &Canvas): u64 { cv.h }

var px: Vec(u32) := Vec::new()
var i: u64 := 0
while i < 12 { Vec::push(&mut px, U32::of_u64(i)); i := i + 1 }
fill(&mut px, Canvas { w: 4, h: 3 }, 16)
show(&sum(&px))
var n: u64 := 5
bump(&mut n, 9007199254740990)
show(&n)
var v: Vec(u64) := Vec::new()
Vec::push(&mut v, 1)
Vec::push(&mut v, 2)
Vec::push(&mut v, 3)
let old := swap_in(&mut v)
show(&Vec::len(&old))
show(&Vec::len(&v))
show(&words("tea"))
Vec::push(&mut v, 9)
show(&trim(&mut v))
last_twice(&mut v)
show(&Vec::len(&v))
show(&(match Vec::get(&v, 0) { Some(x) => x, None => 0 }))
var e: Vec(u64) := Vec::new()
Vec::push(&mut e, 4)
Vec::clear(&mut e)
show(&Vec::len(&e))
show(&bytes_sum(Bytes::of_list([1, 2, 250])))
let cv := Canvas { w: 2, h: 9 }
show(&rows(&cv))
```
nir.fns.put = ```nir
fn put@13(refmut px#40: &mut Vec(u32), i#41: u64, src#42: u32): Unit S = {
  let old#44 := match builtin Vec::get(&px#40, copy i#41): Option(&u32) {
    Option::Some(ref x#43: &u32) => copy x#43,
    Option::None => 0u32,
  };
  match builtin Vec::get_mut(&mut px#40, copy i#41): Option(&mut u32) {
    Option::Some(refmut at#45: &mut u32) => {
      set at#45 := blend@15(copy old#44, copy src#42): u32;
    },
    Option::None => (),
  }
}
```
nir.fns.bump = ```nir
fn bump@5(refmut n#22: &mut u64, by#23: u64): Unit A = {
  set n#22 := add<u64>(copy n#22, copy by#23);
}
```
nir.fns.last_twice = ```nir
fn last_twice@10(refmut v#33: &mut Vec(u64)): Unit A = match builtin Vec::last_mut(&mut v#33): Option(&mut u64) {
  Option::Some(refmut at#34: &mut u64) => {
    set at#34 := mul<u64>(copy at#34, 2u64);
  },
  Option::None => (),
}
```
nir.fns.rows = ```nir
fn rows@12(ref cv#39: &Canvas): u64 S = copy cv#39.h: u64
```
nir.fns.sum = ```nir
fn sum@3(ref px#17: &Vec(u32)): u64 A = {
  var s#18 := 0u64;
  var i#19 := 0u64;
  while lt(copy i#19, builtin Vec::len(&px#17): u64) tick host do {
    set s#18 := add<u64>(copy s#18, match builtin Vec::get(&px#17, copy i#19): Option(&u32) {
      Option::Some(ref x#20: &u32) => builtin U64::of_u32(copy x#20): u64,
      Option::None => 0u64,
    });
    set i#19 := add<u64>(copy i#19, 1u64);
  };
  copy s#18
}
```

// A recursion deeper than the host stack starts again in continuation form;
// what the direct form changed in place before that is undone first.
@ cases.direct-changes-undone-on-restart
stdout = ```
30000
30001
30005
30000
30003
30000
1
1
```
source = ```tauto
fn fill(v: &mut Vec(u64), n: u64): u64 ! {div, overflow} {
  if n == 0 {
    0
  } else {
    Vec::push(&mut v, n)
    match Vec::get_mut(&mut v, 0) { Some(at) => { *at := at + 1 }, None => #() }
    1 + fill(&mut v, n - 1)
  }
}

fn count(c: &mut u64, n: u64): u64 ! {div, overflow} {
  if n == 0 { 0 } else { *c := c + 1; 1 + count(&mut c, n - 1) }
}

fn churn(v: &mut Vec(u64), n: u64): u64 ! {div, overflow} {
  if n == 0 {
    0
  } else {
    Vec::clear(&mut v)
    Vec::push(&mut v, n)
    Vec::push(&mut v, n)
    Vec::truncate(&mut v, 1)
    1 + churn(&mut v, n - 1)
  }
}

var v: Vec(u64) := Vec::new()
Vec::push(&mut v, 5)
show(&fill(&mut v, 30000))
show(&Vec::len(&v))
show(&(match Vec::get(&v, 0) { Some(x) => x, None => 0 }))
var c: u64 := 3
show(&count(&mut c, 30000))
show(&c)
var w: Vec(u64) := Vec::new()
Vec::push(&mut w, 1)
Vec::push(&mut w, 2)
show(&churn(&mut w, 30000))
show(&Vec::len(&w))
show(&(match Vec::get(&w, 0) { Some(x) => x, None => 0 }))
```
nir.fns.fill = ```nir
fn fill@2(refmut v#9: &mut Vec(u64), n#10: u64): u64 A = if eq(copy n#10, 0u64) then 0u64 else {
  builtin Vec::push(&mut v#9, copy n#10): Unit;
  match builtin Vec::get_mut(&mut v#9, 0u64): Option(&mut u64) {
    Option::Some(refmut at#11: &mut u64) => {
      set at#11 := add<u64>(copy at#11, 1u64);
    },
    Option::None => (),
  };
  add<u64>(1u64, fill@2(&mut v#9, sub<u64>(copy n#10, 1u64)) tier A tick host: u64)
}
```
nir.fns.count = ```nir
fn count@4(refmut c#13: &mut u64, n#14: u64): u64 A = if eq(copy n#14, 0u64) then 0u64 else {
  set c#13 := add<u64>(copy c#13, 1u64);
  add<u64>(1u64, count@4(&mut c#13, sub<u64>(copy n#14, 1u64)) tier A tick host: u64)
}
```
nir.fns.churn = ```nir
fn churn@5(refmut v#15: &mut Vec(u64), n#16: u64): u64 A = if eq(copy n#16, 0u64) then 0u64 else {
  builtin Vec::clear(&mut v#15): Unit;
  builtin Vec::push(&mut v#15, copy n#16): Unit;
  builtin Vec::push(&mut v#15, copy n#16): Unit;
  builtin Vec::truncate(&mut v#15, 1u64): Unit;
  add<u64>(1u64, churn@5(&mut v#15, sub<u64>(copy n#16, 1u64)) tier A tick host: u64)
}
```
