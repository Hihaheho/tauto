description = "Workspace membership, NAME: workspace resolution, and mismatch errors."

@ cases.workspace-dependency-resolves-by-package-name
files_tote = "app"
tote_errors = []
files."Tauto.eure" = ```eure
workspace {
  members = ["app", "lib"]
}
```
files."app/Tauto.eure" = ```eure
package { name = "app" version = "0.1.0" }
workspace = ".."
dependencies {
  lib: workspace
}
```
files."lib/Tauto.eure" = ```eure
package { name = "lib" version = "0.1.0" }
workspace = ".."
```
files."lib/src/a.taut" = ```tauto
import std::base
pub fn two(): Nat { Succ(Succ(Zero)) }
```
files."app/src/main.taut" = ```tauto
import lib::a { two }
theorem t(): two() = Succ(Succ(Zero)) { Refl }
```

@ cases.workspace-dependency-from-non-member-is-refused
files_tote = "app"
load_error = "is not a workspace member"
files."app/Tauto.eure" = ```eure
package { name = "app" version = "0.1.0" }
dependencies {
  lib: workspace
}
```
files."app/src/main.taut" = ```tauto
import std::base
fn one(): Nat { Succ(Zero) }
```

