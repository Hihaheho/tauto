@ cases.parent-cycle-is-refused
files_tote = "a/demo"
load_error = "cycle"
files."a/Tauto.eure" = ```eure
workspace {
  parent = "../b"
  members = ["demo"]
}
```
files."b/Tauto.eure" = ```eure
workspace {
  parent = "../a"
  members = ["other"]
}
```
files."a/demo/Tauto.eure" = ```eure
package { name = "demo" version = "0.1.0" }
workspace = ".."
```
files."a/demo/src/main.taut" = ```tauto
import std::base
theorem t(): Succ(Zero) = Succ(Zero) { Refl }
```
