```

@ cases.glob-candidate-without-affiliation-is-dropped
files_tote = "app"
tote_errors = []
files."Tauto.eure" = ```eure
workspace {
  members = ["app", glob`pkgs/*`]
}
```
files."pkgs/skip/Tauto.eure" = ```eure
package { name = "skip" version = "0.1.0" }
```
files."pkgs/skip/src/a.taut" = ```tauto
import std::base
fn one(): Nat { Succ(Zero) }
```
files."pkgs/lib/Tauto.eure" = ```eure
package { name = "lib" version = "0.1.0" }
workspace = "../.."
```
files."pkgs/lib/src/a.taut" = ```tauto
import std::base
pub fn two(): Nat { Succ(Succ(Zero)) }
```
files."app/Tauto.eure" = ```eure
package { name = "app" version = "0.1.0" }
workspace = ".."
dependencies {
  lib: workspace
}
```
files."app/src/main.taut" = ```tauto
import lib::a { two }
theorem t(): two() = Succ(Succ(Zero)) { Refl }
```

@ cases.path-and-workspace-on-one-entry-is-refused
files_tote = "app"
load_error = "cannot be combined"
files."Tauto.eure" = ```eure
workspace {
  members = ["app", "lib"]
}
```
files."lib/Tauto.eure" = ```eure
package { name = "lib" version = "0.1.0" }
workspace = ".."
```
files."app/Tauto.eure" = ```eure
package { name = "app" version = "0.1.0" }
workspace = ".."
dependencies {
  lib {
    path = "../lib"
    workspace = true
  }
}
```
files."app/src/main.taut" = ```tauto
import std::base
fn one(): Nat { Succ(Zero) }
```

@ cases.nested-workspace-member-via-path-keeps-its-own-resolution
files_tote = "game"
tote_errors = []
files."Tauto.eure" = ```eure
workspace {
  members = ["game", "nested"]
}
```
files."game/Tauto.eure" = ```eure
package { name = "game" version = "0.1.0" }
workspace = ".."
dependencies {
  demo { path = "../nested/demo" }
}
```
files."game/src/main.taut" = ```tauto
import demo::a { one }
theorem t(): one() = Succ(Zero) { Refl }
```
files."nested/Tauto.eure" = ```eure
package { name = "nested" version = "0.1.0" }
workspace {
  parent = ".."
  members = ["demo"]
}
```
files."nested/src/a.taut" = ```tauto
import std::base
fn unused(): Nat { Zero }
```
files."nested/demo/Tauto.eure" = ```eure
package { name = "demo" version = "0.1.0" }
workspace = ".."
```
files."nested/demo/src/a.taut" = ```tauto
import std::base
pub fn one(): Nat { Succ(Zero) }
```

@ cases.glob-starstar-finds-nested-member-directories
files_tote = "app"
tote_errors = []
files."Tauto.eure" = ```eure
workspace {
  members = ["app", glob`plugins/**`]
}
```
files."plugins/fire/Tauto.eure" = ```eure
package { name = "fire" version = "0.1.0" }
workspace = "../.."
```
files."plugins/fire/src/a.taut" = ```tauto
import std::base
pub fn spark(): Nat { Succ(Zero) }
```
files."plugins/ice/deep/Tauto.eure" = ```eure
package { name = "iced" version = "0.1.0" }
workspace = "../../.."
```
files."plugins/ice/deep/src/a.taut" = ```tauto
import std::base
pub fn chill(): Nat { Succ(Succ(Zero)) }
```
files."app/Tauto.eure" = ```eure
package { name = "app" version = "0.1.0" }
workspace = ".."
dependencies {
  fire: workspace
  iced: workspace
}
```
files."app/src/main.taut" = ```tauto
import fire::a { spark }
import iced::a { chill }
theorem t(): spark() = Succ(Zero) { Refl }
theorem u(): chill() = Succ(Succ(Zero)) { Refl }
```
