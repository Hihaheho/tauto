// lin_match_on_tail_lending
@ cases.lin-tail-lending-block
source = ```tauto
struct(affine) F {}
fn f(): i64 {
  var v := Vec::new()
  Vec::push(&mut v, F {})
  let o := {
    let i := 0
    Vec::get(&v, i)
  }
  Vec::push(&mut v, F {})
  0
}
```
differential = "lin"

// lin_match_on_tail_lending
@ cases.lin-tail-lending-if
source = ```tauto
struct(affine) F {}
fn f(): i64 {
  var v := Vec::new()
  Vec::push(&mut v, F {})
  let o := if true { Vec::get(&v, 0) } else { Vec::get(&v, 1) }
  Vec::push(&mut v, F {})
  0
}
```
differential = "lin"

// lin_match_on_tail_lending
@ cases.lin-tail-lending-match
source = ```tauto
struct(affine) F {}
fn f(): i64 {
  var v := Vec::new()
  Vec::push(&mut v, F {})
  let o := match 0 {
    0 => Vec::get(&v, 0)
    n => Vec::get(&v, n)
  }
  Vec::push(&mut v, F {})
  0
}
```
differential = "lin"

// Replaceable extern bodies are ownership-checked like ordinary functions.
@ cases.lin-replaceable-affine-dup-refused
source = ```tauto
extern {
  pub fn twice<A>(x: A): A × A {
    #(x, x)
  }
}
```
differential = "lin"

// Mix of required host signatures and replaceable bodies is refused via --lin.
@ cases.lin-replaceable-mix-required
source = ```tauto
extern {
  type(affine) Host
  fn make(): Host {
    Host {}
  }
}
```
differential = "lin"

// `pub(open)` on a replaceable extern struct is refused via --lin.
@ cases.lin-replaceable-open
source = ```tauto
extern {
  pub(open) struct Cell {
    value: i64,
  }

  pub fn Cell::new(value: i64): Cell {
    Cell { value: value }
  }
}
```
differential = "lin"

// A `var` from outside a handle used across an operation that resumes ω.
@ cases.lin-outer-var-across-many
source = ```tauto
effect choose(): Bool resume ω
fn f(): i64 ! {overflow} {
  var n := 0
  handle {
    let b := perform choose()
    n := n + 1
    n
  } with {
    choose(), k => k(true) + k(false)
  }
}
```
differential = "lin"

// A `&A` field read out of a borrowed value is lent again to a `&` parameter.
@ cases.lin-relend-borrowed-field
source = ```tauto
struct(affine) Tok { v: i64 }
struct View { r: &Tok, k: i64 }
fn peek(t: &Tok): i64 { t.v }
fn f(): i64 {
  let t1 := Tok { v: 3 }
  let w1 := View { r: &t1, k: 2 }
  peek(w1.r) + w1.k
}
```
differential = "lin"

// The lent-again field still freezes its owner.
@ cases.lin-relend-borrowed-field-freezes-owner
source = ```tauto
struct(affine) Tok { v: i64 }
struct View { r: &Tok, k: i64 }
fn peek(t: &Tok): i64 { t.v }
fn take(t: Tok): i64 { t.v }
fn f(): i64 {
  let t1 := Tok { v: 3 }
  let w1 := View { r: &t1, k: 2 }
  let a := peek(w1.r)
  let b := take(t1)
  let u := &w1
  a + b
}
```
differential = "lin"
