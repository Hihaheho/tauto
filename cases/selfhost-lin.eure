// lin_match_on_hard_cases
@ cases.lin-match-on-hard-cases-023
source = ```tauto
effect pick(): i64 resume ω
struct(linear) L { n: i64 }
fn mk(): L { L { n: 1 } }
fn eat(l: L): i64 { match l { L { n: k } => k } }
fn f(): i64 {
  let a := mk()
  let r := handle { perform pick() } with {
    pick(), k => k(1) + k(2)
    return v => v
  }
  eat(a) + r
}
```
differential = "lin"

// lin_match_on_hard_cases
@ cases.lin-match-on-hard-cases-024
source = ```tauto
effect stop(): i64 resume 0
struct(linear) L { n: i64 }
fn mk(): L { L { n: 1 } }
fn eat(l: L): i64 { match l { L { n: k } => k } }
fn f(): i64 {
  let a := mk()
  let r := handle { perform stop() } with {
    stop() => 0
    return v => v
  }
  eat(a) + r
}
```
differential = "lin"

