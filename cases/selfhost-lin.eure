// lin_match_on_hard_cases
@ cases.lin-match-on-hard-cases-023
source = ```tauto
effect pick(): i64 resume ω
linear struct L { n: i64 }
fn mk(): L { L { n: 1 } }
fn eat(l: L): i64 { match l { L { n: k } => k } }
fn f(): i64 {
  let a := mk()
  let r := handle { perform pick() } with {
    pick(), k => k(1) + k(2)
    return v => v
  }
  eat(a) + r
}
```
differential = "lin"

