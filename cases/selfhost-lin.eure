// Differential cases: each named route compares the self-hosted component with its oracle, not only evaluator success.

// lin_match_on_hard_cases
@ cases.lin-match-on-hard-cases-001
source = ```tauto
linear struct L { n: i64 }
fn mk(): L { L { n: 1 } }
fn eat(l: L): i64 { match l { L { n: k } => k } }
fn f(): i64 { let a := mk()
 0 }
```
differential = "lin"

