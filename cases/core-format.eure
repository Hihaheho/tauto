@ cases.product-members-keep-the-order-they-are-written-in
source = ```tauto
fn f(p: Nat × @b Bool × @a Nat): Nat {
  ⊢ Nat from match p {
    #(x, @b y, @a w) => x
  }
}
fn g(x: Nat, y: Bool): Bool × Nat { #(y, x) }
```
format = ```tauto
fn f(p: Nat × @b Bool × @a Nat): Nat {
  ⊢ Nat from match p {
    #(x, @b y, @a w) => x
  }
}
fn g(x: Nat, y: Bool): Bool × Nat { #(y, x) }
```

