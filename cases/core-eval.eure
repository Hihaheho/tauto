@ cases.div-and-mod-1
source = ```tauto
perform show("q", div(7, 2))
perform show("r", mod(7, 2))
```
shows = ["q = 3", "r = 1"]

@ cases.div-and-mod-2
source = ```tauto
let a := 7 / 2
```
types = "error: integer `/`"
run_error = "type error:"
compile_errors.rust = "front: integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)"
compile_errors.javascript = "front: integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)"
compile_errors.vm = "front: integer `/` is a type error: write div(a, b), mod(a, b), or decimal(a) / decimal(b)"

@ cases.names-are-case-sensitive
source = ```tauto
fn f(): i64 { 1 }
let a := F()
```
types = "error: F"
run_error = "`F` is not defined"
compile_errors.rust = "front: F is not defined"
compile_errors.javascript = "front: F is not defined"
compile_errors.vm = "front: F is not defined"

@ cases.an-unhandled-effect-is-an-error
source = ```tauto
effect ask(n: i64): i64
let c := perform ask(1)
```
