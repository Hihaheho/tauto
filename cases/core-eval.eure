@ cases.recursion-and-if
source = ```tauto
fn fact(n: i64): i64 ! {div, overflow} { if n <= 1 { 1 } else { n * fact(n - 1) } }
show(&fact(10))
```
stdout = "3628800\n"

@ cases.var-and-while
source = ```tauto
fn sum(n: i64): i64 ! {div, overflow} {
  var i := 0
  var s := 0
  while i < n {
    i := i + 1
    s := s + i
  }
  s
}
show(&sum(100))
```
stdout = "5050\n"

@ cases.loop-break-continue
source = ```tauto
fn first_square_over(limit: i64): i64 ! {div, overflow} {
  var i := 0
  var found := 0
  loop {
    i := i + 1
    if i * i <= limit { continue }
    found := i
    break
  }
  found
}
fn odd_sum(n: i64): i64 ! {div, overflow} {
  var i := 0
  var s := 0
  while i < n {
    i := i + 1
    if i == 2 { continue }
    if i == 4 { continue }
    if i == 6 { continue }
    if i == 8 { continue }
    if i > 7 { break }
    s := s + i
  }
  s
}
fn nested(): i64 ! {div, overflow} {
  var count := 0
  var i := 0
  while i < 3 {
    i := i + 1
    var j := 0
    loop {
      j := j + 1
      if j > i { break }
      count := count + 1
    }
  }
  count
}
show(&first_square_over(50))
show(&odd_sum(100))
show(&nested())
```
stdout = ```
8
16
6
```

@ cases.a-continuation-resumes-twice
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
effect ask(n: i64): i64 resume ω
let c := handle { perform ask(5) + 1 } with {
  ask(n), k => k(n) + k(n + 1)
  return v => v
}
show(&c)
```
stdout = "13\n"

@ cases.return-clause-wraps-the-result
source = ```tauto
effect ask(n: i64): i64
let c := handle { perform ask(1) } with {
  ask(n), k => k(n)
  return v => v * 100
}
show(&c)
```
stdout = "100\n"

@ cases.budget-exceeded-is-handled
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
fn spin(): i64 ! {div} { while true { }
  0 }
let d := handle { perform budget(50, () => { spin() }) } with {
  exceeded(info), k => k(0 - 1)
}
show(&d)
```
stdout = "-1\n"

@ cases.more-steps-resume-the-body
llvm.unimplemented = "generate: the LLVM backend does not write a `var` shared with a closure yet"
source = ```tauto
fn count(n: i64): i64 ! {div, overflow} {
  var i := 0
  while i < n { i := i + 1 }
  i
}
var stops := 0
let d := handle { perform budget(50, () => { count(100) }) } with {
  exceeded(info), k => {
    stops := stops + 1
    info.more(50)
  }
}
show(&d)
show(&(stops > 0))
```
stdout = ```
100
true
```

@ cases.unbounded-runs-the-body-to-the-end
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```tauto
fn count(n: i64): i64 ! {div, overflow} {
  var i := 0
  while i < n { i := i + 1 }
  i
}
let d := handle { perform budget(10, () => { count(1000) }) } with {
  exceeded(info), k => info.unbounded()
}
show(&d)
```
stdout = "1000\n"

@ cases.show-inside-a-handled-computation
source = ```tauto
effect ask(): i64
let c := handle { show(&1)
  perform ask() } with {
  ask(), k => k(2)
}
show(&c)
```
stdout = ```
1
2
```

