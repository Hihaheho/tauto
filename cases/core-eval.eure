@ cases.the-session-limit-interrupts
source = ```tauto
fn spin(): i64 { while true { }
  0 }
let d := spin()
```
budget = 1000
run_error = "interrupted: the step limit ran out"


@ cases.the-session-limit-counts-calls-not-machine-steps-1
source = ```tauto
fn deep(n: i64): i64 {
  if n == 0 { 0 } else { let a := { { { { 1 } } } }
  let b := { { { { a } } } }
  b + deep(n - 1) }
}
let r := deep(100)
perform show("r", r)
```
budget = 500
shows = ["r = 100"]

@ cases.the-session-limit-counts-calls-not-machine-steps-2
source = ```tauto
fn deep(n: i64): i64 {
  if n == 0 { 0 } else { let a := { { { { 1 } } } }
  let b := { { { { a } } } }
  b + deep(n - 1) }
}
let r := deep(100)
```
budget = 50
run_error = "interrupted: the step limit ran out"
