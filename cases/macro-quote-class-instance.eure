@ cases.a-typed-macro-queries-with-an-inference-rule-in-its-prefix
entry = "main.taut"
files."normalize.taut" = ```tauto
import std::base
import std::builtin::macro
pub macro fn normalize(c: Judgement): SynExpr ! {elab} {
  Judgement::term(Elab::whnf(c))
}
```
files."main.taut" = ```tauto
import std::base
import "normalize.taut"
inductive Owned: Type { Mk: Owned }
inductive class Select(A: Type, I: Type) { fn choose(value: A): I }
instance Select(Owned, Nat) infer from A {
  fn choose(value: Owned): Nat { 7 }
}
fn use(value: Owned): Nat { normalize!(Select::choose(value)) }
show(&use(Owned::Mk))
```
stdout = "7\n"

@ cases.a-macro-queries-its-own-inference-rule
entry = "main.taut"
files."lib.taut" = ```tauto
import std::base
import std::builtin::macro
pub(open) inductive Owned: Type { Mk: Owned }
pub(open) inductive class Select(A: Type, I: Type) { fn choose(value: A): I }
instance Select(Owned, Nat) infer from A {
  fn choose(value: Owned): Nat { 7 }
}
pub macro fn normalize(c: Judgement): SynExpr ! {elab, macro_error} {
  match Elab::check(quote { Select::choose(Owned::Mk) }, c, None) {
    Ok(value) => if Elab::defeq(value, Elab::whnf(value)) {
      Judgement::term(value)
    } else { Syn::error(Judgement::span(c), "normalization changed the value") }
    Err(d) => Syn::error(Judgement::span(c), d.message)
  }
}
```
files."main.taut" = ```tauto
import std::base
import "lib.taut"
def use(): Nat := normalize!(7)
theorem result(): use() = 7 { Refl }
```
checks_all = "ok"
checks."lib.taut::normalize" = "skipped"

// A class written in a `quote` as it is written in a file, without a name
// from the call, is made once the call lists it.
@ cases.a-class-written-in-a-quote-is-listed-by-the-call
entry = "main.taut"
files."mk.taut" = ````tauto
import std::base
import std::builtin::macro

pub macro fn make_contract(e: SynExpr): List(SynStmt) {
  quote stmts {
    class Contract(Env: Type) {
      fn execute(env: &mut Env): Unit
    }
  }
}
````
files."main.taut" = ````tauto
import "mk.taut"

make_contract!(#()) => class Contract
show(&1)
````
stdout = "1\n"

// A fn written in a `quote stmts` keeps its `where` constraint, so its body
// can call the class's method on the generic type.
@ cases.a-fn-in-a-quote-keeps-its-where
entry = "main.taut"
files."mk.taut" = ````tauto
import std::base
import std::builtin::macro

pub(open) class Value(A: Type) {
  fn read(value: &A): Nat
}

pub macro fn make_reader(e: SynExpr): List(SynStmt) ! {macro_error} {
  let at := match e {
    ExVar(id) => id
    _ => Syn::error(Syn::call_span(), "expected a function name")
  }
  let name := Syn::decl_name(at, at.name)
  quote stmts {
    fn $name<A>(value: &A): Nat where Value(A) {
      Value::read(&value)
    }
  }
}
````
files."main.taut" = ````tauto
import std::base
import "mk.taut"

instance Value(Nat) { fn read(value: &Nat): Nat { value } }

make_reader!(read_it) => fn read_it

let three: Nat := 3
show(&read_it(&three))
````
stdout = "3\n"

// An instance a macro makes is listed by its class as the call's file spells it
// (`instance Said`), though the macro made it with the class of its own file.
@ cases.an-instance-is-listed-by-its-class-as-the-source-spells-it
entry = "main.taut"
files."mk.taut" = ````tauto
import std::base
import std::builtin::macro

pub(open) class Said(A: Type) {}

pub macro fn make_said(e: SynExpr): List(SynStmt) {
  quote stmts {
    instance Said(Nat) {}
  }
}
````
files."main.taut" = ````tauto
import std::base
import "mk.taut"

make_said!(here) => instance Said

show(&Succ(Zero))
````
stdout = "1\n"
