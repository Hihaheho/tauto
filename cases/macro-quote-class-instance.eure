description = "A macro makes a class and an instance with `quote stmts`, and the call lists them (`=> class C, instance C`)."

// The class and its method are named from the call, so the caller uses them.
@ cases.a-macro-makes-a-class-and-an-instance
entry = "main.taut"
files."mk.taut" = ````tauto
import std::base
import std::builtin::macro

pub macro fn make_class(e: SynExpr): List(SynStmt) {
  match Syn::ident_of(e) {
    None => Nil
    Some(at) => {
      let c := Syn::decl_name(at, "Twice")
      let m := Syn::decl_name(at, "twice")
      quote stmts {
        inductive class $c(A: Type) { fn $m(owner: A): A }
      }
    }
  }
}

pub macro fn make_instance(e: SynExpr): List(SynStmt) {
  match Syn::ident_of(e) {
    None => Nil
    Some(at) => {
      let c := Syn::decl_name(at, "Twice")
      let m := Syn::decl_name(at, "twice")
      quote stmts {
        instance $c(Nat) { fn $m(owner: Nat): Nat { owner + owner } }
      }
    }
  }
}
````
files."main.taut" = ````tauto
import std::base
import "mk.taut"

make_class!(here) => class Twice
make_instance!(here) => instance Twice

fn go(owner: Nat): Nat { Twice::twice(owner) }
show(&go(Succ(Succ(Zero))))
````
stdout = "4\n"

@ cases.a-macro-class-parameter-label-selects-inference
entry = "main.taut"
files."mk.taut" = ````tauto
import std::base
import std::builtin::macro

pub macro fn make_class(e: SynExpr): List(SynStmt) {
  match Syn::ident_of(e) {
    None => Nil
    Some(at) => {
      let c := Syn::decl_name(at, "Choose")
      let m := Syn::decl_name(at, "choose")
      quote stmts {
        inductive class $c(A: Type, I: Type) { fn $m(value: A): I }
      }
    }
  }
}

pub macro fn make_instance(e: SynExpr): List(SynStmt) {
  match Syn::ident_of(e) {
    None => Nil
    Some(at) => {
      let c := Syn::decl_name(at, "Choose")
      let m := Syn::decl_name(at, "choose")
      quote stmts {
        instance $c($e, Nat) infer from A {
          fn $m(value: $e): Nat { 3 }
        }
      }
    }
  }
}
````
files."main.taut" = ````tauto
import std::base
import "mk.taut"

inductive Local: Type { Mk: Local }
make_class!(Local) => class Choose
make_instance!(Local) => instance Choose

fn use(value: Local): Nat { Choose::choose(value) }
show(&use(Local::Mk))
````
stdout = "3\n"

@ cases.an-attribute-roundtrips-an-inference-condition
entry = "main.taut"
files."keep.taut" = ````tauto
import std::base
import std::builtin::macro
pub macro fn keep(e: SynExpr, s: SynStmt): List(SynStmt) { Cons(s, Nil) }
````
files."main.taut" = ````tauto
import std::base
import "keep.taut"

inductive Local: Type { Mk: Local }
inductive class Choose(A: Type, I: Type) { fn choose(value: A): I }
@keep!(0) => replace instance Choose
instance Choose(Local, Nat) infer from A {
  fn choose(value: Local): Nat { 5 }
}
fn use(value: Local): Nat { Choose::choose(value) }
show(&use(Local::Mk))
````
stdout = "5\n"

