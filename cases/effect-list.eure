@ cases.a-list-of-shared-callback-records-specializes-an-empty-row
llvm.unimplemented = "unsupported: row variable `e` of `invoke` is carried by a record and specialized to a suspending row"
source = ```tauto

struct(shared) Stored(!e) { run: (value: u64) -> u64 ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), arg: u64): u64 ! {div} ∪ e {
  match values {
    Nil => 0
    Cons(value, rest) => (value.run)(arg)
  }
}
fn plus_one(value: u64): u64 ! {div, overflow} { value + 1 }
show(&invoke([Stored { run: plus_one }], 1))
```
types = "ok"
rows = "ok"
lin = "ok"
stdout = "2\n"

@ cases.a-list-of-shared-callback-records-preserves-a-handled-row
llvm.unimplemented = "unsupported: row variable `e` of `invoke` is carried by a record and specialized to a suspending row"
source = ```tauto

struct(shared) Stored(!e) { run: (value: u64) -> u64 ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), arg: u64): u64 ! {div} ∪ e {
  match values {
    Nil => 0
    Cons(value, rest) => (value.run)(arg)
  }
}
effect request(): u64 direct
fn queried(value: u64): u64 ! {div, request, overflow} { value + perform request() }
let result := handle { invoke([Stored { run: queried }], 1) } with {
  request(), k => k(4)
  return value => value
}
show(&result)
```
types = "ok"
rows = "ok"
lin = "ok"
stdout = "5\n"

@ cases.a-list-callback-cannot-erase-an-unhandled-effect
source = ```tauto

struct(shared) Stored(!e) { run: (value: u64) -> u64 ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), arg: u64): u64 ! {div} ∪ e {
  match values {
    Nil => 0
    Cons(value, rest) => (value.run)(arg)
  }
}
effect request(): u64 direct
fn queried(value: u64): u64 ! {div, request, overflow} { value + perform request() }
fn pure(): u64 ! {div, overflow} { invoke([Stored { run: queried }], 1) }
```
types = "ok"
rows = "error: `pure` may perform request but its row is {div, overflow}"

@ cases.a-forwarded-list-preserves-its-callers-row
llvm.unimplemented = "unsupported: row variable `e` of `forward` is carried by a record and specialized to a suspending row"
source = ```tauto

struct(shared) Stored(!e) { run: (value: u64) -> u64 ! {div} ∪ e }
fn invoke<!e>(values: List(Stored(!e)), arg: u64): u64 ! {div} ∪ e {
  match values {
    Nil => 0
    Cons(value, rest) => (value.run)(arg)
  }
}
fn forward<!e>(values: List(Stored(!e)), arg: u64): u64 ! {div} ∪ e { invoke(values, arg) }
effect request(): u64 direct
fn queried(value: u64): u64 ! {div, request, overflow} { value + perform request() }
let result := handle { forward([Stored { run: queried }], 2) } with {
  request(), k => k(5)
  return value => value
}
show(&result)
```
types = "ok"
rows = "ok"
lin = "ok"
stdout = "7\n"
