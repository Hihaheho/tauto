
@ cases.swap-holes
source = ```tauto
theorem swap<A: Prop, B: Prop>(p: And(A, B)): And(B, A) {
  AndIntro(?l, ?r)
}
```
checks.swap = "incomplete: ?l, ?r"
holes = [{ declaration => "swap", name => "l", goal => "B", context => ["A: Prop", "B: Prop", "p: And(A, B)"] }, { declaration => "swap", name => "r", goal => "A", context => ["A: Prop", "B: Prop", "p: And(A, B)"] }]

@ cases.swap-left-filled
source = ```tauto
theorem swap<A: Prop, B: Prop>(p: And(A, B)): And(B, A) {
  AndIntro(And::right(p), ?r)
}
```
checks.swap = "incomplete: ?r"

@ cases.swap-filled
source = ```tauto
theorem swap<A: Prop, B: Prop>(p: And(A, B)): And(B, A) {
  AndIntro(And::right(p), And::left(p))
}
```
checks.swap = "ok"

@ cases.swap-wrong-candidate
source = ```tauto
theorem swap<A: Prop, B: Prop>(p: And(A, B)): And(B, A) {
  AndIntro(And::left(p), ?r)
}
```
checks.swap = "error: cannot infer the generic `B` of `And::AndIntro`: neither its arguments nor the expected type fix it; write the generics as its first arguments, `And::AndIntro(A, B, …)`"

@ cases.trusted-extern
source = ```tauto
affine struct File {}
affine struct IoError {}
extern {
  fn file_open(&path: Text): Result(File, IoError)
}
```
types = "ok"

@ cases.include-cache-before
files."main.tauto" = ```tauto
import std::Text
theorem t(): Eq(Text, include_text!("d.txt"), "a") { Refl }
```
files."d.txt" = 'a'
checks.t = "checked"
entry = "main.tauto"

@ cases.include-cache-after
files."main.tauto" = ```tauto
import std::Text
theorem t(): Eq(Text, include_text!("d.txt"), "a") { Refl }
```
files."d.txt" = 'b'
checks.t = "error: mismatch"
entry = "main.tauto"

