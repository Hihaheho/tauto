checks.read_kind = "checked"

@ cases.extract-proof-record
source = ```tauto
inductive RuntimeRecord: Type {
  Mk(kind: Nat): RuntimeRecord
}
fn read_kind(r: RuntimeRecord): Nat { r.kind }

inductive ProofRecord: Prop {
  Mk(kind: Nat): ProofRecord
}
```
checks.RuntimeRecord = "checked"
checks.read_kind = "checked"
checks.ProofRecord = "checked"

@ cases.extract-record-field-named-like-global
files."main.tauto" = ```tauto
import std::Text
inductive Token: Type {
  Mk(width: Nat, text: Text): Token
}
fn token_text(t: Token): Text { t.text }
fn make_token(s: Text): Token { Token { width: 1, text: s } }
```
entry = "main.tauto"
checks.Token = "checked"
checks.token_text = "checked"
checks.make_token = "checked"

