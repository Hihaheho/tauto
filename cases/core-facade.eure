@ cases.checked-extraction-snapshot
files."main.tauto" = ```tauto
fn twice(n: Nat): Nat {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(k) => Succ(Succ(twice(k)))
  }
}
fn message(): Text { include_text!("message.txt") }
perform show("value", twice(2))
```
files."message.txt" = 'checked text'
imports = [path`../std/Base.taut`]
entry = "main.tauto"
checks.twice = "checked"

@ cases.unchecked-extraction-replacement
source = ```tauto
fn twice(n: Nat): Nat { twice(n) }
```
checks.twice = "error: calls itself"

