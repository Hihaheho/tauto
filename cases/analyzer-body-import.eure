// The editor reads an import at the head of a declaration's body as the checker does: the
// body sees what it brings.

@ cases.a-name-a-body-imports-is-found-in-that-body
files."words.taut" = ```tauto
pub fn word(): Text { "w" }
```
files."main.taut" = ```tauto
fn say(): Text {
  import "words.taut"
  word()
}
```
entry = "main.taut"
hovers = [{ at => "word()", contains => ["fn word(): Text"] }]
