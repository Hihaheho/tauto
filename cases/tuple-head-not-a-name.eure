description = "A product the syntax writes (`#()`, `#(a, b)`, the `()` of `m!()`) is headed by the library's `Tuple`, not by the name `Tuple`: a constructor of that spelling the file sees, its own or one a grammar makes, does not take it over."

// The file declares a constructor `Tuple` and writes the unit.
@ cases.own-constructor-named-tuple
source = ```tauto
pub(open) inductive Atom: Type {
  Tuple: Atom
  Name(n: Nat): Atom
}

pub theorem unit_ok(): #() = #() { Refl }

pub theorem atom_ok(): Tuple = Atom::Tuple { Refl }
```
checks."unit_ok" = "ok"
checks."atom_ok" = "ok"
diagnostics = []

// A grammar of an imported syntax makes `Atom::Tuple`; the `()` of a tactic step is the unit.
@ cases.grammar-constructor-named-tuple-through-an-import
entry = "main.taut"
files."main.taut" = ````tauto
import std::Base { Nat }
import std::Tactic { nat_norm }
import std::proof::Lang { proof }
import std::proof::Forms { proof_by }

pub theorem comm(a: Nat, b: Nat): Nat::add(a, b) = Nat::add(b, a) {
  by nat_norm!(): Nat::add(a, b) = Nat::add(b, a) {}
}

pub theorem zero_right(n: Nat): Nat::add(n, 0) = n {
  proof!(```
    By Refl.
  ```)
}
````
checks."comm" = "ok"
checks."zero_right" = "ok"
diagnostics = []

// A name the file writes in a literal, which a sentence macro puts into its output, is bound in
// the file's scope: the import that brings it is used.
@ cases.a-name-in-a-literal-uses-its-import
entry = "main.taut"
files."lem.taut" = ```tauto
import std::Base { Nat }

pub theorem lem(n: Nat): Nat::add(n, 0) = n { Refl }
```
files."main.taut" = ````tauto
import std::Base { Nat }
import std::proof::Lang { proof }
import std::proof::Forms { proof_by }
import "lem.taut" { lem }

theorem t(n: Nat): Nat::add(n, 0) = n {
  proof!(```
    By lem(n).
  ```)
}
````
checks."t" = "ok"
diagnostics = []
