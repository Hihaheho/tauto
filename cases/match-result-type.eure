fn bad(): Yn { ap((o: Nat) => Yes) }
```
checks."bad" = "error: is written as"

@ cases.a_lambda_parameter_type_that_matches_the_call
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn ap(f: (Yn) -> Yn): Yn { f(Yes) }
fn good(): Yn { ap((o: Yn) => o) }
```
checks."good" = "checked"

@ cases.a_lambda_parameter_type_is_checked_where_a_generic_fixes_it
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn ap2<A: Type>(f: (A) -> Yn, a: A): Yn { f(a) }
fn bad(): Yn { ap2((o: Nat) => Yes, Yes) }
```
checks."bad" = "error: is written as"

@ cases.a_lambda_parameter_type_gives_a_match_its_scrutinee_type
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn get(o: Option(Yn)): Yn {
  match o {
    None => No
    Some(x) => x
  }
}
theorem t(a: Option(Yn), b: Option(Yn), p: Eq(Option(Yn), a, b)): Eq(Yn, get(a), get(b)) {
  Eq::congr((o: Option(Yn)) => ⊢ Yn from match o {
    None => No
    Some(x) => x
  }, p)
}
```
checks."t" = "checked"

@ cases.a_lambda_parameter_has_the_type_written_on_it
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn flip(a: Yn): Yn {
  match a {
    Yes => No
    No => Yes
  }
}
theorem t(x: Yn, h: Eq(Yn, Yes, x)): Eq(Yn, flip(x), No) {
  Eq::subst((z: Yn) => Eq(Yn, match z {
    Yes => No
    No => Yes
  }, No), h, Refl)
}
```
checks."t" = "checked"

@ cases.a_lambda_parameter_has_its_type_from_arguments_after_it
