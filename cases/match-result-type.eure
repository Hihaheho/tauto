description = "Where a kernel match takes its result type from, and the default arm beside nested patterns."

@ cases.a_lambda_parameter_has_its_type_from_the_call
source = ```tauto
theorem t<A: Prop, B: Prop>(p: Or(And(A, B), B)): B {
  Or::elim(p, y => match y { AndIntro(a, b) => b }, h => h)
}
```
checks."t" = "checked"

@ cases.an_argument_match_has_the_parameter_type
source = ```tauto
theorem t<A: Prop, B: Prop>(p: And(A, B)): Or(B, A) {
  OrInl(match p { AndIntro(a, b) => b })
}
```
checks."t" = "checked"

@ cases.an_argument_match_is_checked_at_the_parameter_type
source = ```tauto
theorem t<A: Prop, B: Prop>(p: And(A, B)): Or(B, A) {
  OrInl(match p { AndIntro(a, b) => a })
}
```
checks."t" = "error: type mismatch"

@ cases.an_argument_match_on_a_term_names_its_equation
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn yn_not(a: Yn): Yn {
  match a {
    Yes => No
    No => Yes
  }
}
theorem t(a: Yn): And(True, Or(Eq(Yn, yn_not(a), Yes), Eq(Yn, yn_not(a), No))) {
  AndIntro(Trivial, match yn_not(a) eqn e {
    Yes => OrInl(Refl)
    No => OrInr(Refl)
  })
}
```
checks."t" = "checked"

@ cases.an_equation_unfolded_into_the_goal_keeps_the_term
source = ```tauto
fn f(m: Nat, h: Nat::eq(m, 0) = false): Nat { m }
fn g(m: Nat): Nat {
  ⊢ Nat from match Nat::eq(m, 0) eqn h {
    true => m
    false => f(m, h)
  }
}
theorem t(m: Nat): g(m) = m {
  ⊢ g(m) = m from match Nat::eq(m, 0) eqn hg {
    true => ⊢ m = m from Refl
    false => ⊢ f(m, hg) = m from Refl
  }
}
```
checks."t" = "checked"

@ cases.a_match_whose_type_is_not_known_needs_one
source = ```tauto
theorem t<A: Prop, B: Prop>(p: And(A, B)): B {
  (x => x)(match p { AndIntro(a, b) => b })
}
```
checks."t" = "error: needs its result type"

@ cases.a_default_arm_beside_nested_patterns
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn last_true(l: List(Yn)): Yn {
  match l {
    Cons(Yes, Nil) => Yes
    _ => No
  }
}
theorem t1(): Eq(Yn, last_true(Cons(Yes, Nil)), Yes) { Refl }
theorem t2(): Eq(Yn, last_true(Cons(Yes, Cons(Yes, Nil))), No) { Refl }
theorem t3(): Eq(Yn, last_true(Cons(No, Nil)), No) { Refl }
theorem t4(): Eq(Yn, last_true(Nil), No) { Refl }
theorem t5(l: List(Yn)): Or(Eq(Yn, last_true(l), Yes), Eq(Yn, last_true(l), No)) {
  match l {
    Cons(Yes, Nil) => OrInl(Refl)
    _ => OrInr(Refl)
  }
}
```
checks."t1" = "checked"
checks."t2" = "checked"
checks."t3" = "checked"
checks."t4" = "checked"
checks."t5" = "checked"

@ cases.a_default_arm_beside_nested_patterns_reaches_a_case
source = ```tauto
fn f(l: List(Nat)): Nat {
  match l {
    Nil => Zero
    Cons(Zero, t) => Zero
    Cons(Succ(k), t) => k
    _ => Zero
  }
}
```
checks."f" = "error: matches no value"

@ cases.a_default_arm_beside_nested_patterns_is_the_last
source = ```tauto
fn f(l: List(Nat)): Nat {
  match l {
    _ => Zero
    Cons(Zero, Nil) => Zero
  }
}
```
checks."f" = "error: must be the last"

@ cases.a_named_field_beside_split_ones_is_reported
source = ```tauto
fn f(l: List(Nat)): Nat {
  match l {
    Nil => Zero
    Cons(Zero, t) => Zero
    Cons(k, t) => k
  }
}
```
checks."f" = "error: only a last `_ =>` stands for the other cases"

@ cases.a_lambda_parameter_type_is_checked_against_the_call
source = ```tauto
inductive Yn: Type {
  Yes: Yn
