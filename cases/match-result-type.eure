  }
}
theorem t(x: Yn, h: Eq(Yn, Yes, x)): Eq(Yn, flip(x), No) {
  Eq::subst(z => Eq(Yn, match z {
    Yes => No
    No => Yes
  }, No), h, Refl)
}
```
checks."t" = "checked"

@ cases.a_lambda_parameter_written_with_a_wrong_type_is_rejected
source = ```tauto
theorem t<A: Prop, B: Prop>(p: Or(And(A, B), B)): B {
  Or::elim(p, (y: And(B, A)) => match y { AndIntro(a, b) => a }, h => h)
}
```
checks."t" = "error: the parameter `y` is written as `And(B, A)`"

