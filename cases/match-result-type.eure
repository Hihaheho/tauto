@ cases.a_match_in_a_type_is_on_the_parameters
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn flip(a: Yn): Yn {
  match a {
    Yes => No
    No => Yes
  }
}
theorem inline_is_flip(a: Yn): Eq(Yn, match a {
  Yes => No
  No => Yes
}, flip(a)) {
  match a {
    Yes => Refl
    No => Refl
  }
}
theorem with_result(a: Yn): Eq(Yn, flip(a), ⊢ Yn from match a {
  Yes => No
  No => Yes
}) {
  match a {
    Yes => Refl
    No => Refl
  }
}
theorem wrong(a: Yn): Eq(Yn, match a {
  Yes => Yes
  No => Yes
}, flip(a)) {
  match a {
    Yes => Refl
    No => Refl
  }
}
theorem true_false_absurd(h: Eq(Yn, No, Yes)): Eq(Yn, Yes, No) {
  match h {
  }
}
theorem in_hyp(a: Yn, h: Eq(Yn, match a {
  Yes => No
  No => Yes
}, Yes)): Eq(Yn, a, No) {
  match a {
    Yes => true_false_absurd(h)
    No => Refl
  }
}
```
checks."inline_is_flip" = "checked"
checks."with_result" = "checked"
checks."wrong" = "error: type mismatch"
checks."in_hyp" = "checked"

@ cases.a_function_body_match_is_the_match_written_inline
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn pick(y: Yn, a: Nat, b: Nat): Nat {
  match y {
    Yes => a
    No => b
  }
}
fn pick_last(a: Nat, b: Nat, y: Yn): Nat {
  match y {
    Yes => a
    No => b
  }
}
theorem same_first(y: Yn, a: Nat, b: Nat): Eq(Nat, pick(y, a, b), match y {
  Yes => a
  No => b
}) {
  Refl
}
theorem same_last(y: Yn, a: Nat, b: Nat): Eq(Nat, pick_last(a, b, y), match y {
  Yes => a
  No => b
}) {
  Refl
}
```
checks."same_first" = "checked"
checks."same_last" = "checked"

@ cases.a_scrutinee_carries_its_own_type
source = ```tauto
inductive Yn: Type {
  Yes: Yn
  No: Yn
}
fn get(o: Option(Yn)): Yn {
  ⊢ Yn from match (o: Option(Yn)) {
    None => No
    Some(x) => x
  }
}
fn get_untyped_result(o: Option(Yn)): Yn {
  match (o: Option(Yn)) {
    None => No
    Some(x) => x
  }
}
```
checks."get" = "checked"
checks."get_untyped_result" = "checked"
