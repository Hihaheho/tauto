import std::Nat

inductive Expr: (Type) -> Type1 {
  Number(n: Nat): Expr(Nat)
  Truth(b: Bool): Expr(Bool)
}
fn eval(T: Type, e: Expr(T)): T {
  ⊢ T from match e { Number(n) => n
    Truth(b) => b }
}
fn demo(): Nat {
  ⊢ Nat from match eval(Bool, Truth(true)) {
    false => 0
    true => eval(Nat, Number(17))
  }
}
perform show("result", demo())
```
