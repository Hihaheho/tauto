@ cases.implicit-from-generalized-index-run
llvm.unimplemented = "generate: the LLVM backend does not write a guard on a `match` that takes its value apart yet"
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
extract = true
files."app/src/main.taut" = ```tauto
inductive Tm: Type {
  A: Tm
  B: Tm
}
inductive Conv: (Tm, Tm) -> Prop {
  Refl(a: Tm): Conv(a, a)
}
inductive Step(t: Tm): Type {
  Stuck: Step(t)
  Stepped(t2: Tm): Step(t)
}
inductive Res(t: Tm): Type {
  Wh<t2: Tm>(h: Conv(t, t2)): Res(t)
}
fn go(t: Tm, r: Step(t)): Res(t) {
  ⊢ Res(t) from match r {
    Stuck => Wh(Refl(t))
    Stepped(t2) => Wh(Refl(t))
  }
}
fn by_fuel(fuel: Nat, t: Tm): Res(t) {
  ⊢ Res(t) from match fuel {
    Zero => Wh(Refl(t))
    Succ(k) => by_fuel(k, t)
  }
}
fn go_rec(t: Tm, r: Step(t), rec: ∀ u: Tm. Res(u)): Res(t) {
  ⊢ Res(t) from match r {
    Stuck => Wh(Refl(t))
    Stepped(t2) => rec(t)
  }
}
fn by_rec(fuel: Nat, t: Tm): Res(t) {
  ⊢ Res(t) from match fuel {
    Zero => Wh(Refl(t))
    Succ(k) => go_rec(t, Stuck, u => by_rec(k, u))
  }
}
fn result(t: Tm, r: Res(t)): Nat {
  ⊢ Nat from match r {
    Wh(t2, h) => 7
  }
}
fn demo(): Nat {
  result(B, go(B, Stuck)) + result(A, by_fuel(2, A)) + result(B, by_rec(2, B))
}
perform main(() => {
  show(&demo())
})
```
stdout = "21\n"

@ cases.proof-carrying-arithmetic
description = "The forms of `-` on `Nat`, `neg` and the divisions that take a proof have no path that fails, and the kernel computes them."
imports = [path`../std/sint.taut`, path`../std/int.taut`, path`../std/uint.taut`, path`../std/nat.taut`, path`../std/base.taut`]
source = ```tauto
theorem nat_sub(): Nat::sub_ge(7, 3, Refl) = 4 { Refl }
theorem nat_checked(): Nat::checked_sub(3, 7) = None { Refl }
theorem neg_five(): SInt::val64(SInt::neg64(SInt::mk64(IntOfNat(5), Refl), Refl)) = IntNegSucc(4) { Refl }
```
checks.nat_sub = "ok"
checks.nat_checked = "ok"
checks.neg_five = "ok"

// A function that takes `&mut` and assigns through it, in a package whose data
// carries a proof, is lowered with the borrow kept; a helper that takes apart
// the `Mut1` the kernel makes for it is for proofs and is not lowered.
@ cases.mut-parameters-run-in-a-checked-dependent-program
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
files."app/src/main.taut" = ```tauto
import std::nat
import std::base

inductive Small: Type {
  Mk(n: Nat, h: n < 10 = true): Small
}

fn small_val(s: Small): Nat {
  match s {
    Mk(n, h) => n
  }
}

fn set_three(s: &mut Small): Unit {
  *s := Small::Mk(3, Refl)
}

fn set_both(a: &mut Small, b: &mut Small): Unit {
  set_three(&mut a)
  set_three(&mut b)
}

fn after(m: Mut1(Unit, Small)): Small {
  match m {
    mut1(u, r) => r
  }
}

theorem set_three_is(s: Small): after(set_three(s)) = Small::Mk(3, Refl) { Refl }

fn pair_value(a: Small, b: Small): Nat {
  Nat::add(small_val(a), small_val(b))
}

fn demo(): Nat {
  pair_value(Small::Mk(1, Refl), Small::Mk(2, Refl))
}

perform main(() => {
  show(&demo())
})
```
stdout = "3\n"

// An unreachable arm (a `match` on a proof with no arms) in a function that
// returns an element of any kind: the helper it extracts to is not limited to
// shared types.
@ cases.an-empty-match-on-a-proof-in-a-function-over-an-affine-element-is-extracted
imports = [path`../std/base.taut`]
source = ```tauto
fn is_some<A>(o: Option(A)): Bool {
  match o {
    Some(x) => true
    None => false
  }
}

fn unwrap<A>(o: Option(A), h: is_some(o) = true): A {
  match o {
    Some(x) => x
    None => match h {}
  }
}
```
checks_all = "ok"
extract = true

@ cases.std-models-of-uhost-builtins-check
description = "`std::uhost`'s proof-carrying `UHost::succ_below_proved`, `sub_proved` and the others share a builtin's name and take more arguments than it: that is allowed, so a file that imports `std::uhost` checks."
imports = [path`../std/uhost.taut`]
source = ```tauto
fn next(a: UHost, bound: UHost, h: UHost::val(a) < UHost::val(bound) = true): UHost {
  UHost::succ_below_proved(a, bound, h)
}
```
checks_all = "ok"

@ cases.uhost-extracts-with-the-slots-model
description = "Checked code that takes and gives a `UHost` extracts: it crosses the boundary of native code as the machine word `uhost`."
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
extract = true
files."app/src/main.taut" = ```tauto
import std::uhost

fn twice(w: Width, a: UHost): Option(UHost) {
  UHost::add_in(w, a, a)
}
perform main(() => {
  show(&21)
})
```
stdout = "21\n"
