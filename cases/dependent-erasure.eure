imports = [path`../std/Nat.taut`]
source = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  Nil: Vec(A, Zero)
  Cons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Succ(n))
}

fn repeat<A>(n: Nat, x: A): Vec(A, n) {
  ⊢ Vec(A, n) from match n {
    Zero => Nil

    Succ(k) => Cons(k, x, repeat(k, x))
  }
}
fn count<A>(n: Nat, xs: Vec(A, n)): Nat {
  ⊢ Nat from match xs { Nil => 0
    Cons(k, x, rest) => Succ(count(k, rest)) }
}
fn roundtrip(n: Nat): Nat { count(n, repeat(n, 7)) }
fn demo(): Nat { roundtrip(4) }
```
