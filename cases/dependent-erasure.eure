fn is_pos(n: Nat): Bool {
  ⊢ Bool from match n { Zero => false
    Succ(k) => true }
}
fn pos_pred(n: Nat, h: is_pos(n) = true): Nat {
  ⊢ Nat from match n { Zero => ⊢ Nat from match h {}
    Succ(k) => k }
}
fn pred_of(r: Refined(Nat, y => is_pos(y) = true)): Nat {
  ⊢ Nat from match r { Mk(v, h) => pos_pred(v, h) }
}
fn checked_pred(n: Nat): Nat {
  ⊢ Nat from match refine_by(is_pos, n) {
    None => 0
    Some(r) => pred_of(r)
  }
}
fn demo(): Nat { checked_pred(7) }
