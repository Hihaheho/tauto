description = "Checked dependent programs, extracted Nib declarations, and execution results."

@ cases.vec-check
imports = [path`../std/Nat.taut`]
source = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  Nil: Vec(A, Zero)
  Cons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Succ(n))
}

fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n { Zero => m
    Succ(k) => Succ(plus(k, m)) }
}
fn head<A>(n: Nat, v: Vec(A, Succ(n))): A {
  ⊢ A from match v {
    Cons(k, x, xs) => x }
}
fn append<A>(n: Nat, m: Nat, xs: Vec(A, n), ys: Vec(A, m)): Vec(A, plus(n, m)) {
  ⊢ Vec(A, plus(n, m)) from match xs {
    Nil => ys

    Cons(k, x, rest) => Cons(plus(k, m), x, append(k, m, rest, ys))
  }
}
theorem head_cons<A>(n: Nat, x: A, xs: Vec(A, n)): head(n, Cons(n, x, xs)) = x { Refl }
fn demo(): Nat {
  let left := Cons(Zero, 10, Nil)
  let right := Cons(Zero, 20, Nil)
  let joined := append(Succ(Zero), Succ(Zero), left, right)
  head(Succ(Zero), joined)
}
```
checks_all = "ok"

@ cases.vec-run
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
extract = true
files."app/src/main.taut" = ```tauto
import std::Nat

inductive Vec(A: Type): (Nat) -> Type {
  Nil: Vec(A, Zero)
  Cons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Succ(n))
}

fn plus(n: Nat, m: Nat): Nat {
  ⊢ Nat from match n { Zero => m
    Succ(k) => Succ(plus(k, m)) }
}
fn head<A>(n: Nat, v: Vec(A, Succ(n))): A {
  ⊢ A from match v {
    Cons(k, x, xs) => x }
}
fn append<A>(n: Nat, m: Nat, xs: Vec(A, n), ys: Vec(A, m)): Vec(A, plus(n, m)) {
  ⊢ Vec(A, plus(n, m)) from match xs {
    Nil => ys

    Cons(k, x, rest) => Cons(plus(k, m), x, append(k, m, rest, ys))
  }
}
theorem head_cons<A>(n: Nat, x: A, xs: Vec(A, n)): head(n, Cons(n, x, xs)) = x { Refl }
fn demo(): Nat {
  let left := Cons(Zero, 10, Nil)
  let right := Cons(Zero, 20, Nil)
  let joined := append(Succ(Zero), Succ(Zero), left, right)
  head(Succ(Zero), joined)
}
perform show("result", demo())
```
shows = ["result = 10"]
backends = ["rust", "javascript"]
rust_shows = ["result = 10"]
javascript_shows = ["result = 10"]
