fn to_nat(n: Nat, i: Fin(n)): Nat {
  ⊢ Nat from match i { First(k) => Zero
    Next(k, rest) => Succ(to_nat(k, rest)) }
}
fn demo(): Nat { to_nat(2, Next(1, First(0))) }
perform show("result", demo())
