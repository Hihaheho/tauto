@ cases.fin-check
imports = [path`../std/Nat.taut`]
source = ```tauto
inductive Fin: (Nat) -> Type {
  First(n: Nat): Fin(Succ(n))
  Next(n: Nat, i: Fin(n)): Fin(Succ(n))
}

fn to_nat(n: Nat, i: Fin(n)): Nat {
  ⊢ Nat from match i { First(k) => Zero
    Next(k, rest) => Succ(to_nat(k, rest)) }
}
fn demo(): Nat { to_nat(2, Next(1, First(0))) }
```
checks_all = "ok"

