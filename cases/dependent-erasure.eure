imports = [path`../std/Nat.taut`]
source = ```tauto
inductive Vec(A: Type): (Nat) -> Type {
  Nil: Vec(A, Zero)
  Cons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Succ(n))
}

inductive Packed(A: Type): Type {
  Pack(n: Nat, xs: Vec(A, n)): Packed(A)
}
fn length<A>(p: Packed(A)): Nat {
  ⊢ Nat from match p { Pack(n, xs) => n }
}
fn demo(): Nat { length(Pack(1, Cons(0, 7, Nil))) }
```
