// A constructor's fields are covered jointly: rows split by the first field
// cover the product when the rest of each row takes every value.
@ cases.types-match-covers-fields-jointly-product
source = ```tauto
fn f(p: Bool × Bool): i64 {
  match p {
    #(true, x) => 1
    #(false, y) => 2
  }
}
```
differential = "types"

@ cases.types-match-covers-fields-jointly-enum
source = ```tauto
enum Two {
  Mk(Bool, Bool)
  None2
}
fn f(p: Two): i64 {
  match p {
    Mk(true, x) => 1
    Mk(false, y) => 2
    None2 => 3
  }
}
```
differential = "types"

@ cases.types-match-misses-a-joint-row
source = ```tauto
fn f(p: Bool × Bool × Bool): i64 {
  match p {
    #(true, x, true) => 1
    #(true, y, false) => 2
    #(false, true, z) => 3
  }
}
```
differential = "types"

// The prelude's instances for the product `A × B` are `Pair`'s: a class used at a
// product resolves through them, and `#(…)` covers a product.
@ cases.types-product-instance-001
source = ```tauto
pub fn order(): Ordering { Ord::compare(&#(1, 2), &#(1, 3)) }
pub fn first(p: i64 × Bool × Text): i64 { match p { #(a, b, c) => a } }
```
differential = "types"

// A type of a module is the same type written `T` inside the module and `M::T`
// outside it: in a field, a signature, a `let` and a record alike.
@ cases.types-module-type-short-and-qualified
source = ```tauto
pub(open) struct J::B { a: u64 }
pub(open) struct C { ctx: List(J::B) }
pub fn J::ctx(c: C): List(J::B) { c.ctx }
pub fn J::first(c: C): Option(J::B) {
  let bs: List(J::B) := c.ctx
  match bs { Cons(b, rest) => Some(b), Nil => None }
}
pub fn J::make(): J::B { J::B { a: 1 } }
pub fn J::keep<T>(t: T, b: J::B): J::B { b }
fn main(): u64 { J::make().a }
```
differential = "types"

// A body written as the index of an effect (`spawn(() -> T ! e)`, `main(() -> Unit ! {Host})`)
// is the family's label with the body's row as its index, not an instance named after a type.
@ cases.types-body-index-label-001
source = ```tauto
pub fn start(f: () -> i64 ! {div, wait}): i64 ! {∀ T. spawn(() -> T ! {div, wait}), wait} {
  Task::join(perform spawn(f))
}
pub fn entry(top: &(() -> Unit ! {main(() -> Unit ! {Host}), div, overflow, divzero})): Unit ! {Host, overflow, divzero} {
  handle { top() } with { main(body), k => body() }
}
```
differential = "types"

// A row that writes every instance of `spawn` without the body's row hides what the body performs.
@ cases.types-body-index-label-002
source = ```tauto
pub fn start(f: () -> i64 ! {div, wait}): i64 ! {∀ T. spawn(T), wait} {
  Task::join(perform spawn(f))
}
```
differential = "types"

// types_match_on_hard_cases
@ cases.types-match-on-class-method-where
source = ```tauto
class D(H: Type) { fn put(h: H, w: i64): H }
class C(A: Type) { fn feed<H>(a: &A, h: H): H where D(H) }
struct S { v: i64 }
instance D(S) { fn put(h: S, w: i64): S { S { v: w } } }
instance C(i64) { fn feed<H>(a: &i64, h: H): H where D(H) { D::put(h, a) } }
let s: S := C::feed(&7, S { v: 0 })
```
differential = "types"

// Replaceable extern: field update outside the block is sealed (fn-body StAssign place).
@ cases.types-replaceable-sealed-assign-outside
source = ```tauto
extern {
  pub struct(affine) Cell {
    value: i64,
  }

  pub fn Cell::new(value: i64): Cell {
    Cell { value: value }
  }
}

fn poke(c: &mut Cell): Unit {
  c.value := 99
}
```
differential = "types"

// Replaceable extern: write-through `*c.r` outside the block is sealed.
@ cases.types-replaceable-sealed-deref-assign-outside
source = ```tauto
extern {
  pub struct(affine) Cell {
    r: &mut i64,
  }

  pub fn Cell::new(r: &mut i64): Cell {
    Cell { r: r }
  }
}

fn poke(c: &mut Cell): Unit {
  *c.r := 5
}
```
differential = "types"

