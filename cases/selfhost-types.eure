differential = "types"

// `uhost` is an integer type: it is compared and tested for equality as the
// other widths are, and a literal below 2^32 is one.
@ cases.types-uhost-compares-as-a-number
source = ```tauto
fn lt(a: uhost, b: uhost): Bool { a < b }
fn eq(a: uhost, b: uhost): Bool { a == b }
fn lit(a: uhost): Bool { a < 4294967295 }
```
types = "ok"
differential = "types"

// `match (x: T)` and `match x: T` hold the scrutinee to `T` (a member of a
// product here); `T` is not the type of the whole `match`.
@ cases.types-match-on-an-ascribed-scrutinee
source = ```tauto
fn status(r: Bytes × List(Text)): u64 {
  match (r: List(Text)) {
    Cons(s, _) => Text::len(s)
    Nil => 0
  }
}
fn size(r: Bytes × List(Text)): i64 {
  match r: List(Text) {
    Cons(s, _) => 1
    Nil => 0
  }
}
