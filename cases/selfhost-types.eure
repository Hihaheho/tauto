```
differential = "types"

// types_match_on_hard_cases
@ cases.types-match-on-hard-cases-049
source = ```tauto
effect ask(q: i64): i64
effect zero(): i64 resume 0
let r := handle { perform ask(1) } with {
  ask(q), k => k(q)
  zero(), k => 1
  nope(), k => 2
  ask(1, 2), k => 3
  return v => v
}
```
differential = "types"

