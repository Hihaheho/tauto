@ cases.a-bounded-channel-holds-back-a-faster-sender
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::par
fn produce(ch: Channel(u64), n: u64): u64 ! {div, overflow, wait, mutex_claim, mutex_put, mutex_take_claimed} {
  var i: u64 := 0
  while i < n {
    i := i + 1
    Channel::send(ch, i)
  }
  Channel::close(ch)
  n
}
fn consume(ch: Channel(u64)): u64 ! {div, overflow, wait, mutex_claim, mutex_put, mutex_take_claimed} {
  var sum: u64 := 0
  var open := true
  while open {
    match Channel::recv(ch) {
      Some(v) => { sum := sum + v }
      None => { open := false }
    }
  }
  sum
}
let ch := Channel::new(2)
let r := {
  let t := perform spawn(() => produce(ch, 100))
  let u := perform spawn(() => consume(ch))
  Task::join(t) + Task::join(u)
}
show(&r)
```
// The evaluator runs a body at its `spawn`, so the sender would wait on a
// full channel before the receiver starts.
stdout = "5150\n"

@ cases.a-semaphore-bounds-the-tasks-inside
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::par

fn guarded(s: Semaphore, inside: Mutex(u64), most: Mutex(u64)): u64 ! {div, overflow, wait, mutex_claim, mutex_put, mutex_take_claimed} {
  Semaphore::acquire(s)
  let now := {
    var g := Mutex::lock(inside)
    let n := MutexGuard::get_mut(&mut g)
    *n := n + 1
    n + 0
  }
  {
    var g := Mutex::lock(most)
    let m := MutexGuard::get_mut(&mut g)
    if now > m { *m := now } else { #() }
  }
  var i: u64 := 0
  while i < 1000 { i := i + 1 }
  {
    var g := Mutex::lock(inside)
    let n := MutexGuard::get_mut(&mut g)
    *n := n - 1
  }
  Semaphore::release(s)
  1
}
let s := Semaphore::new(2)
let inside := perform mutex_new(0)
let most := perform mutex_new(0)
let xs := {
  let a := perform spawn(() => guarded(s, inside, most))
  let b := perform spawn(() => guarded(s, inside, most))
  let c := perform spawn(() => guarded(s, inside, most))
  let d := perform spawn(() => guarded(s, inside, most))
  let e := perform spawn(() => guarded(s, inside, most))
  let f := perform spawn(() => guarded(s, inside, most))
  [Task::join(a), Task::join(b), Task::join(c), Task::join(d), Task::join(e), Task::join(f)]
}
show(&xs)
let ok := {
  let g := Mutex::lock(most)
  let m := MutexGuard::get(&g)
  m <= 2
}
show(&ok)
```
stdout = ```
[1, 1, 1, 1, 1, 1]
true
```

// Each task sleeps, and the host goes on with the others meanwhile: on the
// reactor the tasks share a few threads (`docs/design/host-effects.md`「Slow answers」).
@ cases.many-tasks-sleep-at-once
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::os
import std::builtin::par

fn start(n: u64, done: Atomic): List(Task(u64)) ! {∀ T. spawn(() -> T ! {sleep, atomic_fetch_add}), sleep, overflow} {
  if n == 0 {
    Nil
  } else {
    let rest := start(n - 1, done)
    let t := perform spawn(() => {
      perform sleep(1)
      let before := perform atomic_fetch_add(done, 1)
      n
    })
    Cons(t, rest)
  }
}
fn sum(ts: List(Task(u64))): u64 ! {wait, overflow} {
  match ts {
    Nil => 0
    Cons(t, rest) => {
      let v := Task::join(t)
      U64::wrapping_add(v, sum(rest))
    }
  }
}
let done := perform atomic_new(0)
let total := sum(start(2000, done))
show(&total)
show(&perform atomic_load(done))
```
stdout = ```
2001000
2000
```

