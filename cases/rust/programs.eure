// `rust_shows` instead of `shows` where the dynamic ownership check (`--check-ownership`)
// rejects a program that `lin.rs` accepts: a `var` captured by a closure (reported).
// Programs the Rust backend must run as the evaluator does.

@ cases.data-and-show
source = ```nib
enum Shape { Circle(i64), Rect(i64, i64), Empty }
struct P { x: i64, y: i64 }
struct Unit {}
enum Tree { Leaf, Node(Tree, i64, Tree) }
fn area(s: Shape): i64 ! {overflow} {
  match s {
    Circle(r) => 3 * r * r
    Rect(w, h) => w * h
    Empty => 0
  }
}
fn sum(t: Tree): i64 ! {overflow} {
  match t {
    Leaf => 0
    Node(l, v, r) => sum(l) + v + sum(r)
  }
}
fn depth(t: &Tree): i64 ! {overflow} {
  match t {
    Leaf => 0
    Node(l, v, r) => {
      let a := depth(l)
      let b := depth(r)
      if a > b { a + 1 } else { b + 1 }
    }
  }
}
show(&area(Circle(2)))
show(&area(Rect(3, 4)))
show(&Empty)
show(&(P { x: 1, y: 2 }))
show(&(Unit {}))
let t := Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf))
show(&t)
show(&depth(&t))
show(&sum(t))
show(&Some(3))
let none: Option(i64) := None
show(&none)
let ok: Result(i64, Text) := Ok(1)
show(&ok)
show(&(#(1, "x")))
show(&true)
show(&(#()))
```
stdout = ```
12
12
Empty
P { x: 1, y: 2 }
main::Unit
Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf))
2
6
Some(3)
None
Ok(1)
#(1, "x")
true
()
```

