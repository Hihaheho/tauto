effect ask(): i64 resume ω
effect tick(n: i64): Unit resume 1
effect fail(e: Text): Never resume 0

fn work(n: i64): i64 ! {ask, tick, fail, overflow} {
  perform tick(n)
  let a := perform ask()
  if a > 100 { perform fail("too big") }
  perform tick(a)
  a + n
}

let r := handle {
  handle { work(1) + work(2) } with {
    tick(n), k => { show(&n)
      k(#()) }
  }
} with {
  ask(), k => k(10) + k(20)
  fail(e) => { show(&e)
    0 }
}
show(&r)

let s := handle {
  handle { work(5) } with {
    tick(n), k => k(#())
  }
} with {
  ask(), k => k(200) + k(1)
  fail(e) => 1000
}
