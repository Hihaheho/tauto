@ cases.m-closures-called-twice
source = ```nib
effect choose(): Bool resume ω
fn apply<!e>(f: () -> i64 ! e): i64 ! e { f() }
fn twice<!e>(f: (i64) -> i64 ! e, x: i64): i64 ! e { f(f(x)) }
fn mk(n: i64): i64 ! {choose} {
  twice(x => if perform choose() { x + n } else { x * 2 }, 1)
}
let r := handle { apply(() => if perform choose() { 1 } else { 2 }) } with {
  choose(), k => k(true) + k(false)
}
perform show("r", r)
let s := handle { mk(10) } with {
  choose(), k => k(true) + k(false)
}
perform show("s", s)
let p := handle { twice(x => x + 1, 5) } with {
  choose(), k => k(true) + k(false)
}
perform show("p", p)
```
