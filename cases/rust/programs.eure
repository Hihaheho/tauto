@ cases.a-local-fn-that-captures-a-vec-is-passed-as-a-borrowed-function
source = ```nib
import std::prelude::Affine

fn apply(&f: (i64) -> i64, x: i64): i64 { let y := f(x)
  f(y) }
fn go(k: i64, xs: Vec(i64)): i64 {
  fn pick(i: i64): i64 { i + I64::of_u64(Vec::len(&xs)) + k }
  apply(pick, 1) + apply(pick, 2)
}
var xs := Vec::new()
Vec::push(&mut xs, 4)
Vec::push(&mut xs, 5)
perform show("r", go(10, xs))
```
shows = ["r = 51"]

@ cases.a-local-fn-that-assigns-a-var-is-passed-as-a-borrowed-function
source = ```nib
fn apply(&f: (i64) -> i64, x: i64): i64 { let y := f(x)
  f(y) }
fn go(): i64 {
  var total := 0
  fn bump(r#by: i64): i64 {
    total := total + r#by
    total
  }
  let a := apply(bump, 1)
  a * 100 + total
}
perform show("r", go())
```
shows = ["r = 202"]

@ cases.a-local-fn-that-borrows-a-parameter-is-passed-as-a-value
source = ```nib
import std::prelude::Affine

fn apply(f: (&Vec(i64)) -> i64, v: Vec(i64)): i64 { f(&v) }
fn go(k: i64): i64 {
  fn total(&xs: Vec(i64)): i64 { I64::of_u64(Vec::len(&xs)) + k }
  var v := Vec::new()
  Vec::push(&mut v, 1)
  apply(total, v)
}
perform show("r", go(10))
```
shows = ["r = 11"]

@ cases.a-local-fn-that-loops-is-passed-as-a-value
source = ```nib
fn apply(f: (i64) -> i64 ! {Div}, x: i64): i64 ! {Div} { f(x) }
fn go(step: i64): i64 ! {Div} {
  fn count(n: i64): i64 ! {Div} {
    var i := 0
    var s := 0
    while i < n {
      s := s + step
      i := i + 1
    }
    s
  }
  apply(count, 4)
}
perform show("r", go(3))
```
shows = ["r = 12"]

