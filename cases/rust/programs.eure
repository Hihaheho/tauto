@ cases.views-vec-get-and-get-mut
source = ```nib
import std::prelude::Affine

var v := Vec::new()
Vec::push(&mut v, 1)
Vec::push(&mut v, 2)
match Vec::get(&v, 1) {
  Some(x) => perform show("x", x)
  None => #()
}
match Vec::get_mut(&mut v, 0) {
  Some(x) => { x := 7 }
  None => #()
}
match Vec::get(&v, 0) {
  Some(x) => perform show("y", x)
  None => #()
}
var m := HashMap::new()
HashMap::insert(&mut m, "a", 1)
match HashMap::get(&m, &"a") {
  Some(x) => perform show("m", x)
  None => #()
}
```
shows = ["x = 2", "y = 7", "m = 1"]

