@ cases.a-divergent-callback-runs-out-inside-a-multi-shot-handler
source = ```nib
effect ask(n: i64): i64 resume ω
fn count(n: i64): i64 {
  var i := 0
  while i < n { i := i + 1 }
  i
}
fn twice(&f: (i64) -> i64 ! {Div}, x: i64): i64 { f(f(x)) }
fn more(): i64 {
  handle {
    perform ask(1) + (handle { budget(steps: 10) { twice((l) => count(l + 20), 0) } } with {
      exceeded(info), k => info.more(10)
    })
  } with { ask(n), k => k(n) }
}
fn stop(): i64 {
  handle {
    perform ask(1) + (handle { budget(steps: 10) { twice((l) => count(l + 20), 0) } } with {
      exceeded(info), k => k(100)
    })
  } with { ask(n), k => k(n) }
}
perform show("more", more())
perform show("stop", stop())
```
shows = ["more = 41", "stop = 101"]

