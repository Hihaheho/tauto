@ cases.generics-and-patterns
llvm.unimplemented = "generate: the LLVM backend does not write a `var` shared with a closure yet"
source = ```nib
fn id<A>(x: A): A { x }
fn pair<A, B>(a: A, b: B): A × B { #(a, b) }
fn apply<A, B>(f: (A) -> B ! {overflow}, x: A): B ! {overflow} { f(x) }
fn compose<A, B, C>(f: (A) -> B ! {overflow}, g: (B) -> C ! {overflow}): (A) -> C ! {overflow} { (x) => g(f(x)) }
fn fold<A, B>(xs: List(A), z: B, f: (B, A) -> B ! {overflow}): B ! {overflow} {
  match xs {
    Nil => z
    Cons(h, t) => fold(t, f(z, h), f)
  }
}
fn classify(n: i64): Text {
  match n {
    0 => "zero"
    1 => "one"
    k if k < 0 => "neg"
    other => "many"
  }
}
fn greet(s: Text): i64 {
  match s {
    "hi" => 1
    "bye" => 2
    other => 0
  }
}
show(&id(5))
show(&id("t"))
show(&pair(1, "a"))
show(&apply((x) => x * 2, 21))
let h := compose((x) => x + 1, (y) => y * 10)
show(&h(4))
show(&fold(Cons(1, Cons(2, Cons(3, Nil))), 0, (a, b) => a + b))
show(&classify(0))
show(&classify(1))
show(&classify(0 - 5))
show(&classify(9))
show(&greet("hi"))
show(&greet("bye"))
show(&greet("x"))
var n := 0
let bump := () => { n := n + 1 }
bump()
bump()
show(&n)
```
