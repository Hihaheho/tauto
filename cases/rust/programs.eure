@ cases.a-named-closure-is-lent-at-the-tier-its-body-gave-it
source = ```nib
effect tick(): u64 resume <=1
fn lend<A, !e>(&body: () -> A ! {tick} ∪ e): A ! {Div} ∪ e {
  handle { body() } with {
    tick(), k => k(1)
    return v => v
  }
}
fn work(): u64 ! {tick} {
  perform tick()
}
let body := () => work() + 1
perform show("n", lend(&body))
```
shows = ["n = 2"]

@ cases.a-nested-pattern-tests-boxed-fields-in-order
source = ```nib
enum Node { Tok(Text), Group(Text, Items, Text) }
enum Nodes { NodesOf(Node, Nodes), NoNodes }
enum Items { ItemsOf(Nodes, Items), NoItems }
fn kind(n: Node): Text {
  match n {
    Group(open, ItemsOf(NodesOf(Tok("x"), NoNodes), NoItems), close) => open
    Group(_, _, close) => close
    Tok(t) => t
  }
}
perform show("hit", kind(Group("(", ItemsOf(NodesOf(Tok("x"), NoNodes), NoItems), ")")))
perform show("lit", kind(Group("(", ItemsOf(NodesOf(Tok("y"), NoNodes), NoItems), ")")))
perform show("more", kind(Group("(", ItemsOf(NodesOf(Tok("x"), NodesOf(Tok("x"), NoNodes)), NoItems), ")")))
perform show("tok", kind(Tok("t")))
```
shows = ["hit = \"(\"", "lit = \")\"", "more = \")\"", "tok = \"t\""]
