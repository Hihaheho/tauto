@ cases.a-shared-struct-holds-an-affine-value-in-a-mutex
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
// A `Mutex` is a shared handle whatever it holds: a struct with a
// `Mutex(IndexedMap(u64, Option(Body)))` field is shared even when `Body` is
// affine, and the Rust backend copies the handle without cloning the content.
source = ```nib
import std::indexed_map { IndexedMap }
import std::builtin::par

struct(affine) Body { n: i64 }
struct Net { requests: Mutex(IndexedMap(u64, Option(Body))) }
fn put(net: Net, k: u64, n: i64): Unit ! {wait, mutex_claim} {
  var g := Mutex::lock(net.requests)
  let m := MutexGuard::get_mut(&mut g)
  let old := IndexedMap::insert(&mut m, k, Some(Body { n: n }))
}
fn read(net: Net, k: u64): i64 ! {wait, mutex_claim} {
  let g := Mutex::lock(net.requests)
  let m := MutexGuard::get(&g)
  match IndexedMap::get(&m, k) {
    Some(Some(b)) => b.n
    _ => 0
  }
}
let net := Net { requests: perform mutex_new(IndexedMap::new()) }
put(net, 1, 10)
put(net, 2, 20)
show(&(read(net, 1) + read(net, 2)))
```
