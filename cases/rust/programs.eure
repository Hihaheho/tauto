@ cases.fail-raise-catch-and-forwarding
llvm.unimplemented = "generate: the LLVM backend does not write the standard effect `divzero` yet"
source = ```nib
fn safe_div(a: i64, b: i64): Result(i64, Text) ! {divzero} {
  if b == 0 { Err("div0") } else { Ok(div(a, b)) }
}
fn compute(a: i64, b: i64): i64 ! {fail(Text), overflow, divzero} {
  raise(safe_div(a, b)) + 1
}
let ok: Result(i64, Text) := catch(() => compute(10, 2))
let bad: Result(i64, Text) := catch(() => compute(1, 0))
show(&ok)
show(&bad)
fn first(r: Result(i64, Text)): i64 {
  match r { Ok(v) => v, Err(e) => 0 }
}
show(&first(ok))
let nested: Result(i64, Text) := catch(() => {
  let a := raise(safe_div(8, 2))
  let b := raise(safe_div(a, 0))
  a + b
})
show(&nested)
effect warn(m: Text): Unit direct
fn work(): i64 ! {warn} {
  perform warn("one")
  perform warn("two")
  5
}
let w := handle { handle { work() } with { warn(m), k => { show(&m); k(#()) } } } with { warn(m), k => k(#()) }
show(&w)
let w2 := handle { handle { work() } with { warn(m), k => { perform warn(m); k(#()) } } } with { warn(m), k => { show(&m); k(#()) } }
show(&w2)
```
stdout = ```
Ok(6)
Err("div0")
6
Err("div0")
"one"
"two"
5
"one"
"two"
5
```

