@ cases.spawn-all-runs-any-number-of-tasks
source = ```nib
import std::prelude::Par

fn bump(a: Atomic, n: u64): u64 {
  var i: u64 := 0
  while i < n {
    let before := Atomic::fetch_add(a, 1)
    i := i + 1
  }
  n
}
let total := Atomic::new(0)
let xs := spawn_all([() => bump(total, 1000), () => bump(total, 2000), () => bump(total, 3000)])
perform show("xs", xs)
perform show("total", Atomic::load(total))
```
shows = ["xs = Cons(1000, Cons(2000, Cons(3000, Nil)))", "total = 6000"]

@ cases.a-bounded-channel-holds-back-a-faster-sender
source = ```nib
fn produce(ch: Channel(u64), n: u64): u64 {
  var i: u64 := 0
  while i < n {
    i := i + 1
    Channel::send(ch, i)
  }
  Channel::close(ch)
  n
}
fn consume(ch: Channel(u64)): u64 {
  var sum: u64 := 0
  var open := true
  while open {
    match Channel::recv(ch) {
      Some(v) => { sum := sum + v }
      None => { open := false }
    }
  }
  sum
}
let ch := Channel::new(2)
let r := {
  let t := perform spawn(() => produce(ch, 100))
  let u := perform spawn(() => consume(ch))
  Task::join(t) + Task::join(u)
}
perform show("r", r)
```
// The evaluator runs a body at its `spawn`, so the sender would wait on a
// full channel before the receiver starts.
rust_shows = ["r = 5150"]
javascript_shows = ["r = 5150"]

@ cases.a-semaphore-bounds-the-tasks-inside
source = ```nib
import std::prelude::Par

fn guarded(s: Semaphore, inside: Mutex(u64), most: Mutex(u64)): u64 {
  Semaphore::acquire(s)
  let now := {
    var g := Mutex::lock(inside)
    let &mut n := MutexGuard::get_mut(&mut g)
    n := n + 1
    n + 0
  }
  {
    var g := Mutex::lock(most)
    let &mut m := MutexGuard::get_mut(&mut g)
    if now > m { m := now } else { #() }
  }
  var i: u64 := 0
  while i < 1000 { i := i + 1 }
  {
    var g := Mutex::lock(inside)
    let &mut n := MutexGuard::get_mut(&mut g)
    n := n - 1
  }
  Semaphore::release(s)
  1
}
let s := Semaphore::new(2)
let inside := Mutex::new(0)
let most := Mutex::new(0)
let xs := {
  let a := perform spawn(() => guarded(s, inside, most))
  let b := perform spawn(() => guarded(s, inside, most))
  let c := perform spawn(() => guarded(s, inside, most))
  let d := perform spawn(() => guarded(s, inside, most))
  let e := perform spawn(() => guarded(s, inside, most))
  let f := perform spawn(() => guarded(s, inside, most))
  [Task::join(a), Task::join(b), Task::join(c), Task::join(d), Task::join(e), Task::join(f)]
}
perform show("xs", xs)
let ok := {
  let g := Mutex::lock(most)
  let &m := MutexGuard::get(&g)
  m <= 2
}
perform show("at most two", ok)
```
shows = ["xs = Cons(1, Cons(1, Cons(1, Cons(1, Cons(1, Cons(1, Nil))))))", "at most two = true"]

// Each task sleeps, and the host goes on with the others meanwhile: on the
// reactor the tasks share a few threads (`docs/design/host-effects.md`「時間のかかる答え」).
@ cases.many-tasks-sleep-at-once
backends = ["rust", "javascript"]
source = ```nib
import std::prelude::Os
import std::prelude::Par

fn start(n: u64, done: Atomic): List(Task(u64)) ! {∀ T. spawn(T), sleep} {
  if n == 0 {
    Nil
  } else {
    let t := perform spawn(() => {
      perform sleep(1)
      let before := Atomic::fetch_add(done, 1)
      n
    })
    Cons(t, start(n - 1, done))
  }
}
fn sum(ts: List(Task(u64))): u64 ! {wait} {
  match ts {
    Nil => 0
    Cons(t, rest) => {
      let v := Task::join(t)
      v + sum(rest)
    }
  }
}
let done := Atomic::new(0)
let total := sum(start(2000, done))
perform show("total", total)
perform show("done", Atomic::load(done))
```
shows = ["total = 2001000", "done = 2000"]

// The bodies of `spawn_all` and `par` may wait for each other.
@ cases.spawn-all-bodies-take-turns-at-a-mutex
source = ```nib
import std::prelude::Os
import std::prelude::Par

let m := Mutex::new(0)
fn add(m: Mutex(u64), n: u64): u64 ! {wait} {
  let v := Mutex::take(m)
  Mutex::put(m, v + n)
  n
}
let r := spawn_all(Cons(() => add(m, 1), Cons(() => add(m, 2), Cons(() => add(m, 3), Nil))))
let p := par(() => add(m, 10), () => add(m, 20))
perform show("r", r)
perform show("p", p.fst + p.snd)
perform show("m", Mutex::take(m))
```
shows = ["r = Cons(1, Cons(2, Cons(3, Nil)))", "p = 30", "m = 36"]

// `rust.executor = "threads"`: a thread for each task, whose waits block it.
// The evaluator runs each task to its end at its `spawn`, where the consumer
// would wait for values the producer has not sent yet.
@ cases.tasks-on-threads-wait-for-each-other
tote = path`../../examples/rust/threads`
backends = ["rust"]
rust_shows = ["r = 5150", "slept = true"]

@ cases.task-poll-waits-for-nothing
source = ```nib
import std::prelude::Par

fn wait(t: Task(u64), polls: u64): u64 ! {Div} {
  match Task::poll(t) {
    Finished(v) => v
    Running(t) => wait(t, polls + 1)
  }
}
let r := {
  let t := perform spawn(() => {
    var i: u64 := 0
    while i < 10000 { i := i + 1 }
    i
  })
  wait(t, 0)
}
perform show("r", r)
```
shows = ["r = 10000"]

@ cases.a-function-that-only-reads-a-tree-takes-it-by-reference
source = ```nib
enum Tree { Leaf, Node(Tree, i64, Tree) }
fn insert(t: Tree, x: i64): Tree {
  match t {
    Leaf => Node(Leaf, x, Leaf)
    Node(l, v, r) => if x < v { Node(insert(l, x), v, r) } else { Node(l, v, insert(r, x)) }
  }
}
fn has(t: Tree, x: i64): i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => if x == v { 1 } else if x < v { has(l, x) } else { has(r, x) }
  }
}
fn size(t: Tree): i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => size(l) + 1 + size(r)
  }
}
fn left(t: Tree): Tree {
  match t {
    Leaf => Leaf
    Node(l, v, r) => l
  }
}
fn pair(a: Tree, b: Tree): i64 { size(a) * 10 + size(b) }
fn root(t: Tree): i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => v
  }
}
let t := insert(insert(insert(insert(Leaf, 5), 2), 8), 3)
let u := t
perform show("has3", has(t, 3))
perform show("has4", has(t, 4))
perform show("size", size(t))
perform show("same twice", pair(t, t))
perform show("size of left", size(left(t)))
perform show("shared", size(u) + size(t))
perform show("temp", size(insert(t, 9)))
perform show("root", root(t) + root(left(t)))
```
shows = ["has3 = 1", "has4 = 0", "size = 4", "same twice = 44", "size of left = 2", "shared = 8", "temp = 5", "root = 7"]

