@ cases.a-closure-that-does-not-suspend-passed-where-one-may
llvm.unimplemented = "generate: the LLVM backend does not write the builtin `Ref::new` yet"
source = ```nib
import std::builtin::par

effect ask(): i64 resume <=1
struct Job { owner: i64, run: () -> Unit ! {ask, div} }
fn call(f: () -> Unit ! {ask, div, ref_set}): Unit ! {ask, div, ref_set} {
  f()
}
fn keep(owner: i64): Job ! {ask} {
  Job { owner: perform ask(), run: () => { let n := perform ask() } }
}
fn go(log: Ref(i64)): Unit ! {ask, div, overflow, ref_get, ref_set} {
  call(() => perform ref_set(log, 7))
  let j := keep(1)
  let f := j.run
  f()
  perform ref_set(log, perform ref_get(log) + j.owner)
}
let log := perform ref_new(0)
handle { go(log) } with {
  ask(), k => k(3)
}
show(&perform ref_get(log))
```
