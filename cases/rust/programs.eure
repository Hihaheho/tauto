@ cases.a-resuming-arm-passes-a-field-to-a-reading-function
// `count` only reads its list, so the backend passes it by reference; the
// call in the arm that resumes must pass a reference too.
source = ```nib
struct Bag { items: List(i64), n: i64 }
effect give(b: Bag): i64
fn count(xs: List(i64)): i64 {
  match xs {
    Nil => 0
    Cons(_, t) => 1 + count(t)
  }
}
let r := handle { perform give(Bag { items: Cons(1, Cons(2, Nil)), n: 3 }) } with {
  give(b), k => k(count(b.items) + b.n)
}
perform show("r", r)
```
shows = ["r = 5"]

@ cases.an-arm-wraps-k-and-counts
source = ```nib
effect ask(n: i64): i64
effect log(t: Text): Unit direct
fn total(): i64 ! {ask, log} {
  perform log("start")
  let a := perform ask(1)
  perform log("mid")
  let b := perform ask(2)
  a + b
}
var count := 0
let r := handle { total() } with {
  ask(n), k => {
    count := count + 1
    k(n * 10) + 1
  }
  log(t), k => k(perform show("log", t))
}
perform show("r", r)
perform show("count", count)
```
shows = ["log = \"start\"", "log = \"mid\"", "r = 32", "count = 2"]

@ cases.a-state-handler-passes-k-in-a-function
source = ```nib
effect get(): i64
effect put(s: i64): Unit
fn incr(): i64 ! {get, put} {
  let s := perform get()
  perform put(s + 1)
  let t := perform get()
  perform put(t + 10)
  perform get()
}
let run := handle { incr() } with {
  get(), k => (s) => k(s)(s)
  put(s2), k => (s) => k(#())(s2)
  return v => (s) => v
}
perform show("state", run(5))
```
shows = ["state = 16"]

@ cases.a-resume-zero-effect-through-a-handler
source = ```nib
effect ask(n: i64): i64
effect fail(m: Text): Never resume 0
fn f(n: i64): i64 ! {ask, fail} {
  let a := perform ask(n)
  if a > 25 { perform fail("big") } else { a }
}
let r := handle {
  handle { f(1) + f(2) + f(3) } with {
    ask(n), k => k(n * 10)
  }
} with {
  fail(m) => 0 - 1
}
perform show("r", r)
let r2 := handle { f(1) + f(2) } with {
  ask(n), k => k(n * 10)
  fail(m) => 0 - 1
}
perform show("r2", r2)
```
shows = ["r = -1", "r2 = 30"]

@ cases.a-borrow-in-a-function-that-suspends
source = ```nib
import std::prelude::Affine

effect yield(n: i64): Unit resume <=1
fn gen(&v: Vec(i64)): Unit ! {yield, Div} {
  var i := 0
  while i < Vec::len(&v) {
    handle {
      perform yield(Vec::index(&v, i))
    } with {
      out_of_bounds() => #()
    }
    i := i + 1
  }
}
fn sum_all(&v: Vec(i64)): i64 ! {Div} {
  var total := 0
  handle { gen(&v) } with {
    yield(n), k => {
      total := total + n
      k(#())
    }
  }
  total
}
var v := Vec::new()
Vec::push(&mut v, 3)
Vec::push(&mut v, 4)
Vec::push(&mut v, 5)
perform show("sum", sum_all(&v))
```
shows = ["sum = 12"]

@ cases.an-arm-that-drops-k
source = ```nib
effect stop(n: i64): Never resume <=1
fn search(n: i64): i64 ! {stop, Div} {
  var i := 0
  while i < n {
    if i * i > 50 { perform stop(i) }
    i := i + 1
  }
  0 - 1
}
let r := handle { search(100) } with {
  stop(n), k => n * 1000
}
perform show("r", r)
let r2 := handle { search(5) } with {
  stop(n), k => n * 1000
}
perform show("r2", r2)
```
shows = ["r = 8000", "r2 = -1"]

