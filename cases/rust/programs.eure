fn map(xs: List(nat), f: (nat) -> nat): List(nat) {
  match xs {
    Nil => Nil
    Cons(h, t) => Cons(f(h), map(t, f))
  }
}
fn len(xs: &List(nat)): nat {
  match xs {
    Nil => 0
    Cons(h, t) => 1 + len(t)
  }
}
