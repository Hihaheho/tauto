@ cases.a-closure-that-does-not-suspend-passed-where-one-may
source = ```nib
import std::prelude::Par

effect ask(): i64 resume <=1
struct Job { owner: i64, run: () -> Unit ! {ask, Div} }
fn call(f: () -> Unit ! {ask, Div}): Unit ! {ask, Div} {
  f()
}
fn keep(owner: i64): Job ! {ask} {
  Job { owner: perform ask(), run: () => { let n := perform ask() } }
}
fn go(log: Ref(i64)): Unit ! {ask, Div} {
  call(() => Ref::set(log, 7))
  let j := keep(1)
  let f := j.run
  f()
  Ref::set(log, Ref::get(log) + j.owner)
}
let log := Ref::new(0)
handle { go(log) } with {
  ask(), k => k(3)
}
perform show("log", Ref::get(log))
```
shows = ["log = 10"]

@ cases.a-memory-budget-stops-allocation
description = "budget(memory: n) counts the cells its body allocates; a body that allocates more performs exceeded"
source = ```nib
enum L { Nil, Cons(i64, L) }
fn build(n: i64, acc: L): L ! {Div} {
  if n == 0 { acc } else { build(n - 1, Cons(n, acc)) }
}
fn len(l: L): i64 ! {Div} {
  match l { Nil => 0, Cons(_, t) => 1 + len(t) }
}
let d := handle { budget(steps: 1000000, memory: 50) { len(build(1000, Nil)) } } with {
  exceeded(info), k => k(0 - 1)
}
perform show("d", d)
let e := handle { budget(memory: 50) { len(build(10, Nil)) } } with {
  exceeded(info), k => k(0 - 1)
}
perform show("e", e)
```
shows = ["d = -1", "e = 10"]

@ cases.more-memory-resumes-the-body
description = "info.more(m) gives a stopped memory budget m more cells"
source = ```nib
enum L { Nil, Cons(i64, L) }
fn build(n: i64, acc: L): L ! {Div} {
  if n == 0 { acc } else { build(n - 1, Cons(n, acc)) }
}
fn len(l: L): i64 ! {Div} {
  match l { Nil => 0, Cons(_, t) => 1 + len(t) }
}
var stops := 0
let f := handle { budget(memory: 50) { len(build(100, Nil)) } } with {
  exceeded(info), k => {
    stops := stops + 1
    info.more(50)
  }
}
perform show("f", f)
perform show("stopped", stops > 0)
```
shows = ["f = 100", "stopped = true"]

// Secret words (`std/prelude/Secret.taut`): a secret shows as `Secret`, and
// the content leaves only through `expose`.
@ cases.secret-words
source = ```nib
import std::prelude::Secret

let k := secret(U64::of_nat(200))
let m := secret(U64::of_nat(55))
let y := Ct::u64_select(Ct::u64_lt(m, k), Ct::u64_add(k, m), m)
let wrap := Ct::u32_add(secret(U32::of_u64(4294967295)), secret(U32::of_u64(2)))
let byte := Ct::u8_xor(secret(U8::of_u64(240)), secret(U8::of_u64(15)))
let both := Ct::bool_and(Ct::u8_eq(byte, secret(U8::of_u64(255))), Ct::bool_not(Ct::u64_eq(k, m)))
perform show("y", expose(y))
perform show("wrap", expose(wrap))
perform show("byte", expose(byte))
perform show("both", expose(both))
perform show("hidden", y)
```
shows = ["y = 255", "wrap = 1", "byte = 255", "both = true", "hidden = Secret"]
compile_errors.javascript = "generate: secret words, which it cannot run in constant time"
backend_known_failure.vm = "unsupported: the builtin Ct::bool_and"

// A secret that is only carried, not computed on, runs on every backend.
@ cases.a-carried-secret-runs-everywhere
source = ```nib
import std::prelude::Secret
import std::prelude::Shared

let k := secret(Bytes::of_text("key"))
perform show("hidden", k)
perform show("len", Bytes::len(expose(k)))
```
shows = ["hidden = Secret", "len = 3"]

@ cases.row-generic-only-in-data-argument
description = "A generic given only to a data type's row parameter (`App(R, e)`) is erased from the function's Rust generics, as it is from the data type, so a call from a closure leaves no Rust type parameter to infer"
source = ```nib
enum Route { Home, About }
shared struct App(R: Shared, !e) {
  hooks: List(() -> i64 ! e),
  score: (R) -> i64
}
fn page_at<R: Shared, !e>(a: App(R, e), r: R): i64 { (a.score)(r) }
fn apply_to(f: (Route) -> i64, r: Route): i64 { f(r) }
fn run_app<R: Shared, !e>(a: App(R, e), r: R, g: ((R) -> i64, R) -> i64): i64 ! e {
  g((p: R) => page_at(a, p), r)
}
fn score(r: Route): i64 { match r { Home => 1, About => 2 } }
let a: App(Route, !{}) := App { hooks: Nil, score: score }
perform show("v", run_app(a, About, apply_to))
```
shows = ["v = 2"]

