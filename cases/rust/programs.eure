@ cases.m-nondeterminism-loops-and-recursion
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect choose(): Bool resume ω
effect fail(): Never resume 0

fn pick(n: i64): i64 ! {choose, div, overflow} {
  var acc := 0
  var i := 0
  while i < n {
    let b := perform choose()
    if b { acc := acc + i }
    i := i + 1
  }
  acc
}

fn rec(n: i64): i64 ! {choose, div, overflow} {
  if n <= 0 { 0 } else {
    let b := perform choose()
    (if b { n } else { 0 }) + rec(n - 1)
  }
}

let all := handle { pick(3) } with {
  choose(), k => k(true) + k(false)
}
show(&all)

let r := handle { rec(4) } with {
  choose(), k => k(true) + k(false)
}
show(&r)

