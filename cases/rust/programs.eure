import std::builtin::par

fn bump(a: Atomic, n: u64): u64 ! {div, overflow, atomic_fetch_add} {
  var i: u64 := 0
  while i < n {
    let before := perform atomic_fetch_add(a, 1)
    i := i + 1
  }
  n
}
