// A task starts tasks of its own; a wait with a deadline gives up once it
// passes, and leaves the line it stood in.
@ cases.a-task-spawns-and-timed-waits-give-up-at-the-deadline
llvm.unimplemented = "generate: the LLVM backend does not write a function that may stop (`<top>`) yet"
source = ```nib
import std::builtin::os
import std::builtin::par

fn received(r: Received(u64)): u64 {
  match r {
    Arrived(v) => v
    Closed => 1
    NotYet => 2
  }
}
let soon := perform monotonic_clock() + 1000000
let ch := Channel::new(1)
let empty := received(Channel::recv_until(ch, soon))
Channel::send(ch, 7)
let got := received(Channel::recv_until(ch, soon))
Channel::close(ch)
let closed := received(Channel::recv_until(ch, soon))
let deadline := perform monotonic_clock() + 1000000000
let t := perform spawn(() => {
  let inner := perform spawn(() => 40)
  Task::join(inner) + 2
})
let joined := match Task::join_until(t, deadline) {
  Finished(v) => v
  Running(t) => {
    Task::detach(t)
    0
  }
}
let m := perform mutex_new(5)
let held := Mutex::take(m)
let late := match Mutex::take_until(m, perform monotonic_clock() + 1000000) {
  Some(v) => v
  None => 0
}
perform mutex_put(m, held + 1)
let s := Semaphore::new(1)
let first := Semaphore::acquire_until(s, perform monotonic_clock() + 1000000)
let second := Semaphore::acquire_until(s, perform monotonic_clock() + 1000000)
show(&([empty, got, closed]))
show(&joined)
show(&late)
show(&Mutex::take(m))
show(&(#(first, second)))
```
stdout = ```
[2, 7, 1]
42
0
6
#(true, false)
```

@ cases.a-function-that-only-reads-a-tree-takes-it-by-reference
source = ```nib
enum Tree { Leaf, Node(Tree, i64, Tree) }
fn insert(t: Tree, x: i64): Tree {
  match t {
    Leaf => Node(Leaf, x, Leaf)
    Node(l, v, r) => if x < v { Node(insert(l, x), v, r) } else { Node(l, v, insert(r, x)) }
  }
}
fn has(t: Tree, x: i64): i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => if x == v { 1 } else if x < v { has(l, x) } else { has(r, x) }
  }
}
fn size(t: Tree): i64 ! {overflow} {
  match t {
    Leaf => 0
    Node(l, v, r) => size(l) + 1 + size(r)
  }
}
fn left(t: Tree): Tree {
  match t {
    Leaf => Leaf
    Node(l, v, r) => l
  }
}
fn pair(a: Tree, b: Tree): i64 ! {overflow} { size(a) * 10 + size(b) }
fn root(t: Tree): i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => v
  }
}
let t := insert(insert(insert(insert(Leaf, 5), 2), 8), 3)
let u := t
show(&has(t, 3))
show(&has(t, 4))
show(&size(t))
show(&pair(t, t))
show(&size(left(t)))
show(&(size(u) + size(t)))
show(&size(insert(t, 9)))
show(&(root(t) + root(left(t))))
```
stdout = ```
1
0
4
44
2
8
5
7
```

