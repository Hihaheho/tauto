@ cases.a-borrowing-closure-performs-an-effect-across-an-await
source = ```nib
import std::prelude::Affine

effect ask(n: i64): i64 resume 1
fn run(xs: Vec(i64), scale: i64): Vec(i64) ! {ask} {
  var total := Vec::new()
  let tag := 7
  Vec::each(&xs, (&x: i64) => { let n := perform ask(x * scale); Vec::push(&mut total, n + tag) })
  total
}
fn apply(&f: (i64) -> i64 ! {ask}, x: i64): i64 ! {ask} { f(f(x)) }
fn go(): i64 ! {ask} {
  var xs := Vec::new()
  Vec::push(&mut xs, 1)
  Vec::push(&mut xs, 2)
  Vec::push(&mut xs, 3)
  let t := run(xs, 2)
  let base := 100
  let r := apply((y: i64) => perform ask(y + base), 1)
  r + I64::of_u64(Vec::len(&t))
}
let r := handle { go() } with { ask(n), k => k(n * 10) }
perform show("r", r)
```
shows = ["r = 11103"]

@ cases.walk-a-list-with-a-running-flag
source = ```nib
fn count(xs: List(i64)): i64 {
  var rest := xs
  var n := 0
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        rest := more
        n := n + x
      }
    }
  }
  n
}
fn build(n: i64): List(i64) { if n == 0 { Nil } else { Cons(n, build(n - 1)) } }
let xs := build(100)
perform show("n", count(xs))
perform show("again", count(xs))
```
shows = ["n = 5050", "again = 5050"]

