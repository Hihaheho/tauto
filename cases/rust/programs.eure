llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that does not resume yet"
source = ```nib
import std::indexed_map { IndexedMap }

fn show_all(v: &Vec(i64)): i64 ! {out_of_bounds, div, overflow} {
  var i: u64 := 0
  var s := 0
  while i < Vec::len(&v) {
    let x := Vec::index(&v, i)
    s := s + x
    i := i + 1
  }
  s
}
var items := Vec::new()
Vec::push(&mut items, 5)
Vec::push(&mut items, 7)
show(&(handle { show_all(&items) } with { out_of_bounds() => 0 }))
show(&items)
var b := Buf::new()
Buf::push(&mut b, "ab")
Buf::push(&mut b, "cd")
let t := Text::of(b)
show(&t)
var m := IndexedMap::new()
IndexedMap::insert(&mut m, "a", 1)
IndexedMap::insert(&mut m, "b", 2)
let r := match IndexedMap::get(&m, "b") { Some(x) => x, None => 0 }
show(&r)
let miss := match IndexedMap::get(&m, "zz") { Some(x) => x, None => 0 - 1 }
show(&miss)
show(&m)
```
