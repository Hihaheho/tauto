@ cases.tasks-share-an-atomic-and-a-mutex
source = ```nib
import std::prelude::Affine
import std::prelude::Par

fn bump(a: Atomic, n: u64): u64 {
  var i: u64 := 0
  while i < n {
    let before := Atomic::fetch_add(a, 1)
    i := i + 1
  }
  n
}
let total := Atomic::new(0)
let m := Mutex::new(Vec::new())
let r := {
  let a := perform spawn(() => bump(total, 1000))
  let b := perform spawn(() => bump(total, 2000))
  let c := perform spawn(() => {
    {
      var g := Mutex::lock(m)
      let &mut v := MutexGuard::get_mut(&mut g)
      Vec::push(&mut v, 1)
    }
    3
  })
  Task::join(a) + Task::join(b) + Task::join(c)
}
let n := {
  let g := Mutex::lock(m)
  let &v := MutexGuard::get(&g)
  Vec::len(&v)
}
perform show("r", r)
perform show("total", Atomic::load(total))
perform show("n", n)
```
shows = ["r = 3003", "total = 3000", "n = 1"]

