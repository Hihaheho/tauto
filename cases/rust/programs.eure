enum L { Nil, Cons(i64, L) }
fn build(n: i64, acc: L): L ! {div, overflow} {
  if n == 0 { acc } else { build(n - 1, Cons(n, acc)) }
}
fn len(l: L): i64 ! {div, overflow} {
  match l { Nil => 0, Cons(_, t) => 1 + len(t) }
}
let d := handle { perform budget(1000000, () => perform budget_memory(50, () => { len(build(1000, Nil)) })) } with {
  exceeded(info), k => k(0 - 1)
}
show(&d)
