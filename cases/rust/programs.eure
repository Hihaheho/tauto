@ cases.a-program-option-and-list-are-not-the-prelude-ones
source = ```nib
import std::prelude::Classes

enum List { Nil, Cons(i64, List) }
enum Option(A: Type) { None, Some(A) }
fn first(xs: List): Option(i64) {
  match xs {
    Nil => None
    Cons(x, r) => Some(x)
  }
}
perform show("l", Cons(1, Nil))
perform show("f", first(Cons(1, Nil)))
perform show("j", join(std::prelude::Cons(1, std::prelude::Cons(2, std::prelude::Nil)), ","))
