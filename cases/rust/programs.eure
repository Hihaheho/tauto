@ cases.walk-a-list-with-a-running-flag
source = ```nib
fn count(xs: List(i64)): i64 ! {div, overflow} {
  var rest := xs
  var n := 0
  var running := true
  while running {
    match rest {
      Nil => {
        running := false
      }
      Cons(x, more) => {
        rest := more
        n := n + x
      }
    }
  }
  n
}
fn build(n: i64): List(i64) ! {div, overflow} { if n == 0 { Nil } else { Cons(n, build(n - 1)) } }
let xs := build(100)
show(&count(xs))
show(&count(xs))
```
