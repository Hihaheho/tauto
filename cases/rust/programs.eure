@ cases.resume-1-and-resume-0-handlers
source = ```nib
effect ask(n: i64): i64 resume 1
effect fail(m: Text): Never resume 0
fn work(): i64 ! {ask, fail} {
  let a := perform ask(1)
  if a > 5 { perform fail("too big") } else { a }
}
let r := handle {
  handle { work() } with {
    fail(m) => 0 - 1
  }
} with {
  ask(n), k => k(n * 9)
}
perform show("r", r)
fn safe(): i64 {
  handle { work() } with {
    ask(n), k => k(n)
    fail(m) => 0 - 2
  }
}
perform show("safe", safe())
```
shows = ["r = -1", "safe = 1"]

