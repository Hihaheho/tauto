@ cases.m-data-and-return-arm
llvm.unimplemented = "generate: the LLVM backend does not write a `handle` with an arm that keeps its continuation yet"
source = ```nib
effect choose(): Bool resume ω
effect fail(e: Text): Never resume 0
enum L { Nil, Cons(i64, L) }
struct P { x: i64, y: Text }

fn gen(n: i64): L ! {choose, div, overflow} {
  if n <= 0 { Nil } else {
    let b := perform choose()
    let rest := gen(n - 1)
    if b { Cons(n, rest) } else { rest }
  }
}

fn len(xs: L): i64 ! {overflow} {
  match xs {
    Nil => 0
    Cons(_, t) => 1 + len(t)
  }
}

fn sum(xs: L): i64 ! {overflow} {
  match xs {
    Nil => 0
    Cons(h, t) => h + sum(t)
  }
}

let total := handle { len(gen(3)) } with {
  choose(), k => k(true) + k(false)
}
show(&total)

let s := handle { sum(gen(4)) } with {
  choose(), k => k(true) + k(false)
  return v => v * 2
}
show(&s)

fn pp(n: i64): P ! {choose, overflow} {
  let b := perform choose()
  P { x: if b { n } else { 0 - n }, y: "p" }
}
let q := handle {
  let p := pp(3)
  let r := pp(4)
  p.x * r.x
} with {
  choose(), k => k(true) + k(false)
}
show(&q)

let t := handle {
  let b := perform choose()
  if b { perform fail("no") } else { 5 }
} with {
  choose(), k => k(true) + k(false)
  fail(e) => 100
}
show(&t)

let u := handle {
  let b := perform choose()
  let c := perform choose()
  if b && c { 1 } else { if b || c { 10 } else { 100 } }
} with {
  choose(), k => k(true) + k(false)
}
show(&u)
```
