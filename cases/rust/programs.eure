      let v := MutexGuard::get_mut(&mut g)
      Vec::push(&mut v, 1)
    }
    3
  })
  U64::wrapping_add(U64::wrapping_add(Task::join(a), Task::join(b)), Task::join(c))
}
let n := {
  let g := Mutex::lock(m)
  let v := MutexGuard::get(&g)
  Vec::len(&v)
}
show(&r)
