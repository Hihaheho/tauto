import std::prelude::Macro


pub macro fn exact(s: ProofStep): SynExpr { s.arg }

pub macro fn same(s: ProofStep): SynExpr { Syn::hole(1, s.span) }

pub macro fn intro(s: ProofStep): SynExpr ! {macro_error} {
  match s.after {
    Cons(g, rest) => match g.binders {
      Cons(b, more) => ExLam(Cons(BAtom(b.atom, None), Nil), Syn::hole(1, s.span), s.span)
      Nil => Syn::error(s.span, "intro! binds a variable")
    }
    Nil => Syn::error(s.span, "intro! leaves one goal")
  }
}

pub macro fn intro_x(s: ProofStep): SynExpr {
  quote { x => ?arm1 }
}

pub macro fn none(s: ProofStep): SynExpr { quote { Refl } }

pub macro fn plain(e: SynExpr): SynExpr { e }
