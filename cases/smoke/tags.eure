// Tag sets are equal when they have the same members (lean/Proto/Tags.lean).

@ cases.order-is-irrelevant
a = ["x", "y"]
b = ["y", "x"]
equal = true

@ cases.duplicates-are-irrelevant
a = ["x", "x", "y"]
b = ["x", "y"]
equal = true

@ cases.different-members-differ
a = ["x"]
b = ["y"]
equal = false

@ cases.not-yet-supported
description = "A case marked `unimplemented` must fail; this one states a wrong answer on purpose, to check the mark"
unimplemented = "the answer is wrong on purpose"
a = ["x"]
b = ["x", "y"]
equal = true
