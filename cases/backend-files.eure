@ cases.tote-variant-renamed-for-a-clash
description = "A variant whose short name another declaration has (`ExVar` of the prelude's syntax trees) is renamed to its full name (`app.src.lang.Expr.ExVar`); extraction writes it under its type (`Expr.ExVar`), as its type declares it."
files_tote = "app"
stdout = ```
true
false
```
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/lang.taut" = ```tauto
pub inductive Expr: Type {
  ExNum(n: Nat): Expr
  ExVar(name: List(Nat)): Expr
}

pub fn named(e: Expr): Bool {
  ⊢ Bool from match e {
    ExVar(v) => true
    ExNum(n) => false
  }
}

pub fn var_of(v: List(Nat)): Expr {
  ExVar(v)
}

pub fn num_of(n: Nat): Expr {
  ExNum(n)
}
```
files."app/src/main.taut" = ```tauto
import "lang.taut"
perform main(() => {
  show(&named(var_of(Nil)))
  show(&named(num_of(1)))
})
```

@ cases.tote-path-dependency-module-path
description = "A dependency's names are qualified by its path (`dep.src.text.bytes.join`); extraction writes each segment as a nested module."
files_tote = "app"
stdout = "[47, 47]\n"
files."dep/Tauto.eure" = 'package { name = "dep" version = "0.1.0" }'
files."dep/src/text/bytes.taut" = ```tauto
pub fn join(c: Nat, ps: List(List(Nat))): List(Nat) {
  match ps {
    Nil => Nil,
    Cons(p, rest) => Cons(c, join(c, rest)),
  }
}
```
files."app/Tauto.eure" = ```eure
package { name = "app" version = "0.1.0" }
dependencies { dep { path = "../dep" } }
```
files."app/src/main.taut" = ```tauto
import "../../dep/src/text/bytes.taut"

pub fn joined(ps: List(List(Nat))): List(Nat) {
  join(47, ps)
}

perform main(() => {
  show(&joined(Cons(Nil, Cons(Nil, Nil))))
})
```

// `include-from` lets a tote's files read a directory of the workspace besides the tote's own.
@ cases.include-text-reads-a-directory-the-tote-lists
files_tote = "app"
stdout = "\"shared text\"\n"
files."shared/msg.txt" = 'shared text'
files."Tauto.eure" = 'package { name = "workspace" }'
files."app/Tauto.eure" = ```eure
package {
  name = "app"
  include-from = ["../shared"]
}
```
files."app/src/main.taut" = ```tauto
perform main(() => show(&include_text!("../../shared/msg.txt")))
```

@ cases.include-text-refuses-a-directory-the-tote-does-not-list
files_tote = "app"
load_error = "include.outside"
files."shared/msg.txt" = 'shared text'
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/main.taut" = ```tauto
perform main(() => show(&include_text!("../../shared/msg.txt")))
```

@ cases.programs-use_error_in_an_unreached_imported_function
description = "A use error in a function of an imported file is an error of the run, though nothing the run reaches calls the function: a program `tauto check` rejects is not one `tauto run` runs."
entry = "main.taut"
extract = true
load_error = "use error: a borrow of v cannot be returned"
files."lib.taut" = ```tauto
pub fn borrow_ver(cell: &Option(i64)): Option(&i64) {
  let v := 1
  Some(&v)
}
pub fn one(): i64 { 1 }
```
files."main.taut" = ```tauto
import "lib.taut"
show(&one())
```
