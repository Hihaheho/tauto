@ cases.programs-import_brings_functions
backends = ["rust", "javascript"]
shows = ["x = 1"]
files."a.nib" = 'pub fn one(): i64 { 1 }'
files."main.nib" = 'import "a.nib"
perform show("x", one())'

@ cases.programs-import_is_relative_to_the_importer
backends = ["rust", "javascript"]
shows = ["x = 3"]
files."sub/c.nib" = 'pub fn two(): i64 { 2 }'
files."sub/b.nib" = 'import "c.nib"
pub fn three(): i64 { two() + 1 }'
files."main.nib" = 'import "sub/b.nib"
perform show("x", three())'

@ cases.programs-import_twice_reads_once
backends = ["rust", "javascript"]
shows = ["x = 2"]
files."a.nib" = 'pub fn one(): i64 { 1 }'
files."b.nib" = 'import "a.nib"
pub fn two(): i64 { one() + 1 }'
files."main.nib" = 'import "a.nib"
import "b.nib"
perform show("x", two())'

@ cases.programs-import_cycle_is_an_error
entry = "a.nib"
load_error = "imports itself through a cycle"
files."a.nib" = 'import "b.nib"'
files."b.nib" = 'import "a.nib"'

@ cases.programs-same_name_in_two_files
backends = ["rust", "javascript"]
shows = ["a = 1", "b = 2"]
files."a.nib" = 'pub fn f(): i64 { 1 }'
files."b.nib" = 'pub fn f(): i64 { 2 }'
files."main.nib" = 'import "a.nib"
import "b.nib"
perform show("a", a::f())
perform show("b", b::f())'

