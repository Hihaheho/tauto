syntax!(keywords, ```par
%start Root
%title "keyword fields"
%%
Root: '['^ Value ']'^;
Value: 'true' | 'false';
```) => struct Root, enum Value, fn parse

fn keyword_text(root: keywords::Root): Text {
  match root {
    keywords::Root { span: root_span, value: node } => match node {
      True { span: true_span, true_field: yes } => yes.text
      False { span: false_span, false_field: no } => no.text
    }
  }
}
fn keyword_result(text: Text): Text {
  match keywords::parse(text) {
    Ok(root) => keyword_text(root)
    Err(diag) => diag.code
  }
}
show(&keyword_result("[true]"))
show(&keyword_result("[false]"))
show(&keyword_result("[maybe]"))
show(&alias::parse("別名=3"))
show(&alias::parse("別名="))
show(&records::parse("((日本語:値))"))
show(&records::parse("!"))
show(&math::parse("((1+2)+3)=6"))
show(&lists::parse("head first one:two three !"))
show(&lists::parse("~"))
show(&ident::parse("日本語=12"))
show(&math::parse("1+=3"))
show(&math::parse("1="))
show(&ident::parse("日本語=@"))
````

