files."inputs/main.taut" = ````tauto
import std::builtin::macro

syntax!(math, ```par
%start Eqn
%title "math"
%%
Eqn: Sum Equals Sum;
Sum: Term { Plus Term };
Term: Num | Paren;
Paren: LParen Sum RParen;
Num: /[0-9]+/;
Equals: '=';
Plus: '+';
LParen: '(';
RParen: ')';
```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1, enum Term, fn parse
syntax!(lists, ```par
%start Doc
%title "lists"
%%
Doc: [ Head ] { Item } ( Bang | Tilde );
Head: KwHead Name;
Item: Name [ Colon Name ];
KwHead: 'head';
Name: /[a-z]+/;
Colon: ':';
Bang: '!';
Tilde: '~';
```) => struct Doc, enum Doc_Group1, struct Head, struct Item, struct Item_Opt1, fn parse
syntax!(ident, ```par
%start Decl
%title "ident"
%%
Decl: Name Equals Value;
Name: /[\p{L}_][\p{L}\p{N}_]*/;
Equals: '=';
Value: /[0-9]+/;
```) => struct Decl, fn parse
syntax!(records, ```par
%start Expr
%title "records"
%%
Expr: Name Colon Name | LParen Expr RParen | Bang;
Name: /[\p{L}_][\p{L}\p{N}_]*/;
Colon: ':';
LParen: '(';
RParen: ')';
Bang: '!';
```) => enum Expr, fn parse
syntax!(alias, ```par
%start Decl
%title "ident"
%%
Decl: Name Equals Value;
Name: /[\p{L}_][\p{L}\p{N}_]*/;
Equals: '=';
Value: /[0-9]+/;
```) => struct Decl, fn parse
syntax!(keywords, ```par
%start Root
%title "keyword fields"
%%
Root: '['^ Value ']'^;
Value: 'true' | 'false';
```) => struct Root, enum Value, fn parse

fn keyword_text(root: keywords::Root): Text {
  match root {
    keywords::Root { span: root_span, value: node } => match node {
      True { span: true_span, true_field: yes } => yes.text
      False { span: false_span, false_field: no } => no.text
    }
  }
}
fn keyword_result(text: Text): Text {
  match keywords::parse(text) {
    Ok(root) => keyword_text(root)
    Err(diag) => diag.code
  }
}
show(&keyword_result("[true]"))
show(&keyword_result("[false]"))
show(&keyword_result("[maybe]"))
show(&alias::parse("別名=3"))
show(&alias::parse("別名="))
show(&records::parse("((日本語:値))"))
show(&records::parse("!"))
show(&math::parse("((1+2)+3)=6"))
show(&lists::parse("head first one:two three !"))
show(&lists::parse("~"))
show(&ident::parse("日本語=12"))
show(&math::parse("1+=3"))
show(&math::parse("1="))
show(&ident::parse("日本語=@"))

show(&keyword_text(keywords`[true]`))
````


