backends = ["rust", "javascript"]
shows = ["tree = Ok(math::Eqn { span: SynSpan { id: 0 }, sum: math::Sum { span: SynSpan { id: 0 }, term: Paren(math::Paren { span: SynSpan { id: 0 }, l_paren: SynToken { text: \"(\", span: SynSpan { id: 0 }, ctx: SynCtx { scopes: Nil } }, sum: math::Sum { span: SynSpan { id: 1 }, term: Num(SynToken { text: \"1\", span: SynSpan { id: 1 }, ctx: SynCtx { scopes: Nil } }), rep: Cons(math::Sum_Rep1 { span: SynSpan { id: 2 }, plus: SynToken { text: \"+\", span: SynSpan { id: 2 }, ctx: SynCtx { scopes: Nil } }, term: Num(SynToken { text: \"2\", span: SynSpan { id: 3 }, ctx: SynCtx { scopes: Nil } }) }, Nil) }, r_paren: SynToken { text: \")\", span: SynSpan { id: 4 }, ctx: SynCtx { scopes: Nil } } }), rep: Nil }, equals: SynToken { text: \"=\", span: SynSpan { id: 5 }, ctx: SynCtx { scopes: Nil } }, sum_2: math::Sum { span: SynSpan { id: 6 }, term: Num(SynToken { text: \"3\", span: SynSpan { id: 6 }, ctx: SynCtx { scopes: Nil } }), rep: Nil } })", "error = Err(SynDiag { message: \"macro-syntax-expected-found\", at: 2, expected: Cons(\"Num\", Cons(\"LParen\", Nil)), code: \"macro.syntax_error\", args: Cons(SynArg { name: \"syntax\", value: \"math\" }, Cons(SynArg { name: \"expected\", value: \"Num\" }, Cons(SynArg { name: \"expected\", value: \"LParen\" }, Cons(SynArg { name: \"found\", value: \"Equals\" }, Nil)))) })"]
files."main.taut" = ````tauto
import std::prelude::Macro

syntax!(math, ```par
%start Eqn
%title "math"
%%
Eqn: Sum Equals Sum;
Sum: Term { Plus Term };
Term: Num | Paren;
Paren: LParen Sum RParen;
Num: /[0-9]+/;
Equals: '=';
Plus: '+';
LParen: '(';
RParen: ')';
```) => struct Eqn, struct Paren, struct Sum, struct Sum_Rep1, enum Term, fn parse
perform show("tree", math::parse("(1+2)=3"))
perform show("error", math::parse("1+="))
````

