@ cases.tote-variant-renamed-for-a-clash
description = "A variant whose short name another declaration has (`ExVar` of the prelude's syntax trees) is renamed to its full name (`app.src.lang.Expr.ExVar`); extraction writes it under its type (`Expr.ExVar`), as its type declares it."
files_tote = "app"
backends = ["rust", "javascript"]
shows = ["named = true", "number = false"]
files."app/Tauto.eure" = 'package { name = "app" }'
files."app/src/lang.taut" = ```tauto
pub inductive Expr: Type {
  ExNum(n: Nat): Expr
  ExVar(name: List(Nat)): Expr
}

pub fn named(e: Expr): Bool {
  ⊢ Bool from match e {
    ExVar(v) => true
    ExNum(n) => false
  }
}

pub fn var_of(v: List(Nat)): Expr {
  ExVar(v)
}

pub fn num_of(n: Nat): Expr {
  ExNum(n)
}
```
files."app/src/main.taut" = ```tauto
import "lang.taut"
perform show("named", named(var_of(Nil)))
perform show("number", named(num_of(1)))
```

@ cases.tote-path-dependency-module-path
description = "A dependency's names are qualified by its path (`dep.src.text.bytes.join`); extraction writes each segment as a nested module."
files_tote = "app"
backends = ["rust", "javascript"]
shows = ["joined = Cons(47, Cons(47, Nil))"]
files."dep/Tauto.eure" = 'package { name = "dep" version = "0.1.0" }'
files."dep/src/text/bytes.taut" = ```tauto
pub fn join(c: Nat, ps: List(List(Nat))): List(Nat) {
  match ps {
    Nil => Nil,
    Cons(p, rest) => Cons(c, join(c, rest)),
  }
}
```
files."app/Tauto.eure" = ```eure
package { name = "app" version = "0.1.0" }
dependencies { dep { path = "../dep" } }
```
files."app/src/main.taut" = ```tauto
import "../../dep/src/text/bytes.taut"

pub fn joined(ps: List(List(Nat))): List(Nat) {
  join(47, ps)
}

perform show("joined", joined(Cons(Nil, Cons(Nil, Nil))))
```
