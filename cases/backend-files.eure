@ cases.macro_borrow_identity-nested_repeated_and_generic_quoted_borrows_agree_in_all_backends
backends = ["rust", "javascript"]
shows = ["direct = 10", "repeated = 10", "nested = 7", "duplicated = 20", "integer = 6", "generic = 10", "named = 10", "typed = 10", "typed_duplicated = 20"]
files."support/lib.tauto" = ```tauto
import std::prelude::Classes
import std::prelude::Macro


pub(open) enum Item { Item(Text) }
pub fn inspect(item: Item): u64 { match item { Item(text) => Text::len(text) } }
pub fn forward(item: Item, read: () -> Text): u64 { inspect(item) + Text::len(read()) }
pub macro fn example(expr: SynExpr): SynExpr {
    let read := quote { { let value := $expr; ToText::to_text(&value) } }
    quote { forward(Item("hello"), () => $read) }
}
pub macro fn named(expr: SynExpr): SynExpr {
    let read := quote { { let value := $expr; ToText::to_text(&value) } }
    quote { { let item := Item("hello"); forward(item, () => $read) } }
}
pub macro fn twice(expr: SynExpr): SynExpr { quote { Pair { fst: $expr, snd: $expr } } }
pub fn identity<A: Shared>(&value: A): A { value }
pub macro fn generic_example(expr: SynExpr): SynExpr {
    let read := quote { { let value := $expr; let r#copy := identity(&value); ToText::to_text(&r#copy) } }
    quote { forward(Item("hello"), () => $read) }
}
pub macro fn keep(code: Judgement): SynExpr { Judgement::term(code) }
```
files."app/main.tauto" = ```tauto


perform show("direct", example!("hello"))
perform show("repeated", example!("world"))
perform show("nested", example!(example!("hello")))
let pair := twice!(example!("hello"))
perform show("duplicated", pair.fst + pair.snd)
perform show("integer", example!(7))
perform show("generic", generic_example!("hello"))
perform show("named", named!("hello"))
perform show("typed", keep!(example!("hello")))
let typed_pair := twice!(keep!(example!("hello")))
perform show("typed_duplicated", typed_pair.fst + typed_pair.snd)
```
files."main.nib" = ```nib
import "support/lib.tauto"
import "app/main.tauto"
```

@ cases.checked-extraction-recursive-callback
backends = ["rust", "javascript"]
extract = true
entry = "main.tauto"
imports = [path`../std/Base.taut`]
shows = ["value = Cons(4, Nil)"]
files."lib.tauto" = ```tauto
import std::Base
pub fn twice(n: Nat): Nat {
  ⊢ Nat from match n {
    Zero => Zero
    Succ(k) => Succ(Succ(twice(k)))
  }
}
pub fn mapped(xs: List(Nat)): List(Nat) { List::map(twice, xs) }
```
files."app.tauto" = ```tauto
import "lib.tauto"
perform show("value", mapped(Cons(2, Nil)))
```
files."main.tauto" = ```tauto
import "lib.tauto"
import "app.tauto"
```

@ cases.checked-extraction-mutual-callback
description = "Mutual recursion on Nat the kernel accepts as structural; the row check does not derive it from the extracted text alone."
backends = ["rust", "javascript"]
extract = true
entry = "main.tauto"
imports = [path`../std/Base.taut`]
// The evaluator runs the row check on the extracted text, which wrongly
// rejects the callback; it is marked unimplemented until the row check
// accepts it.
unimplemented = true
shows = ["value = Cons(true, Nil)"]
files."lib.tauto" = ```tauto
mutual {
  pub fn even(n: Nat): Bool {
    ⊢ Bool from match n {
      Zero => true
      Succ(k) => odd(k)
    }
  }
  pub fn odd(n: Nat): Bool {
    ⊢ Bool from match n {
      Zero => false
      Succ(k) => even(k)
    }
  }
}
pub fn evens(xs: List(Nat)): List(Bool) { List::map(even, xs) }
```
files."app.tauto" = ```tauto
perform show("value", evens(Cons(2, Nil)))
```
files."main.tauto" = ```tauto
import "lib.tauto"
import "app.tauto"
```

@ cases.runtime-syntax-tree-and-diagnostic
