@ cases.expansion-preserves-operands-and-order
imports = [path`../std/asm.taut`, path`../std/UInt.taut`]
source = ```taut
fn code(): List(Asm::Instr) { asm!(`mov x0, x1; add x0, x0, x2; sub x2, x1, x0`) }
theorem lowering_exact(): code() = [
  Asm::Instr::Mov(Asm::Reg::X0, Asm::Reg::X1),
  Asm::Instr::Add(Asm::Reg::X0, Asm::Reg::X0, Asm::Reg::X2),
  Asm::Instr::Sub(Asm::Reg::X2, Asm::Reg::X1, Asm::Reg::X0)
] { Refl }
```
checks.code = "ok"
checks.lowering_exact = "ok"
diagnostics = []

@ cases.wrong-destination
imports = [path`../std/asm.taut`, path`../std/UInt.taut`]
source = ```taut
fn code(): List(Asm::Instr) { asm!(`add x1, x1, x2`) }
theorem wrong(s: Asm::State): Asm::read(Asm::run(code(), s), Asm::Reg::X0) = U64::wrapping_add(Asm::read(s, Asm::Reg::X1), Asm::read(s, Asm::Reg::X2)) { Refl }
```
checks.code = "ok"
checks.wrong = "error: type mismatch"
diagnostics = [{ name => "wrong", message => "type mismatch" }]

@ cases.wrong-subtraction-order
imports = [path`../std/asm.taut`, path`../std/UInt.taut`]
source = ```taut
fn code(): List(Asm::Instr) { asm!(`sub x0, x2, x1`) }
theorem wrong(s: Asm::State): Asm::read(Asm::run(code(), s), Asm::Reg::X0) = U64::wrapping_sub(Asm::read(s, Asm::Reg::X1), Asm::read(s, Asm::Reg::X2)) { Refl }
```
checks.code = "ok"
checks.wrong = "error: type mismatch"
diagnostics = [{ name => "wrong", message => "type mismatch" }]

@ cases.unbounded-addition-is-not-proved
imports = [path`../std/asm.taut`, path`../std/UInt.taut`]
source = ```taut
fn code(): List(Asm::Instr) { asm!(`add x0, x1, x2`) }
theorem wrong(): U64::val(Asm::read(Asm::run(code(), Asm::State {
  x0: U64::of_nat_mod(0), x1: U64::of_nat_mod(18446744073709551615), x2: U64::of_nat_mod(1)
}), Asm::Reg::X0)) = 18446744073709551616 { Refl }
```
checks.code = "ok"
checks.wrong = "error: type mismatch"
diagnostics = [{ name => "wrong", message => "type mismatch" }]

