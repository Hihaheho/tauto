import std::Nat
inductive Token: (Nat) -> Type { Mk(n: Nat): Token(n) }
inductive Wrap(A: Type): Type { Box(value: A): Wrap(A) }
fn inspect(w: Wrap(Nat), t: Token(0)): Nat {
  ⊢ Nat from match w {
    Box(Zero) => 0
    Box(Succ(Zero)) => 1
    Box(Succ(Succ(Zero))) => 2
    Box(Succ(Succ(Succ(rest)))) => rest + 10
  }
}
fn wildcard(n: Nat, t: Token(0)): Nat {
  ⊢ Nat from match n { Zero => 0
    Succ(Zero) => 1
    Succ(Succ(_)) => 2 }
}
fn run(n: Nat): Nat { inspect(Box(n), Mk(0)) + wildcard(n, Mk(0)) }
perform show("zero", run(0))
perform show("one", run(1))
perform show("two", run(2))
perform show("three", run(3))
perform show("ten", run(10))
```
