@ cases.partial-dependent-match-result
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
extract = true
files."app/src/main.taut" = ```tauto
import std::Nat
inductive Token: (Nat) -> Type { Mk(n: Nat): Token(n) }
fn choose(b: Bool, t: Token(0)): Nat {
  let f := ⊢ (h: Eq(Nat, Zero, Zero), x: Nat) -> Nat from match b {
    false => (h, x) => x
    true => (h, x) => x + 1
  }
  let partial := f(Refl)
  partial(8)
}
fn run(b: Bool): Nat { choose(b, Mk(0)) }
perform show("false", run(false))
perform show("true", run(true))
```
