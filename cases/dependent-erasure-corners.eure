import std::Base
inductive Box: (Nat) -> Type { Mk(n: Nat): Box(n) }
effect choose(): Bool resume ω
fn request(box: Box(0)): Nat ! {choose} { if perform choose() { 1 } else { 2 } }
fn run(): Nat {
  var visits: Nat := 0
  let result := handle { request(Mk(0)) } with {
    choose(), k => {
      let left := k(true)
      let right := k(false)
      left + right
    }
    return value => {
      visits := visits + 1
      value
    }
  }
  result + visits
}
theorem run_correct(): run() = 5 { Refl }
perform show("value", run())
