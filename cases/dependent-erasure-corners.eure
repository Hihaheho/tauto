@ cases.opaque-function-roundtrip
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
extract = true
files."app/src/main.taut" = ```tauto
import std::Nat
inductive Vec(A: Type): (Nat) -> Type {
  Nil: Vec(A, Zero)
  Cons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Succ(n))
}
fn repeat(n: Nat, x: Nat): Vec(Nat, n) {
  ⊢ Vec(Nat, n) from match n { Zero => Nil
    Succ(k) => Cons(k, x, repeat(k, x)) }
}
fn make(): (n: Nat) -> Vec(Nat, n) { n => repeat(n, 17) }
fn pass(f: (n: Nat) -> Vec(Nat, n)): (m: Nat) -> Vec(Nat, m) { f }
fn first(f: (n: Nat) -> Vec(Nat, n)): Nat {
  ⊢ Nat from match f(1) { Cons(k, x, xs) => x }
}
fn proof_fn(): (h: Eq(Nat, Zero, Zero)) -> Nat { h => 23 }
fn use_proof(f: (h: Eq(Nat, Zero, Zero)) -> Nat): Nat { f(Refl) }
perform show("vector", first(pass(make())))
perform show("proof", use_proof(proof_fn()))
```
