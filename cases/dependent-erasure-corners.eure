@ cases.quotient-through-dependent-code
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
extract = true
files."app/src/main.taut" = ```tauto
import std::Base
import std::Quot
inductive Token: (Nat) -> Type { Mk(n: Nat): Token(n) }
def Parity(a: Nat, b: Nat): Prop := Nat::rem_nz(a, 2, Nat::ne_zero(2, Refl)) = Nat::rem_nz(b, 2, Nat::ne_zero(2, Refl))
fn token(): Token(0) { Mk(0) }
fn class_of(n: Nat): Quot(Nat, Parity) { Quot::mk(Nat, Parity, n) }
fn parity_of(q: Quot(Nat, Parity), t: Token(0)): Nat {
  Quot::lift(Nat, Parity, Nat, n => Nat::rem_nz(n, 2, Nat::ne_zero(2, Refl)), a => b => p => p, q)
}
fn same_parity(p: Quot(Nat, Parity), q: Quot(Nat, Parity), t: Token(0)): Bool {
  Quot::lift2(
    Parity,
    Parity,
    (a, b) => Nat::eq(Nat::rem_nz(a, 2, Nat::ne_zero(2, Refl)), Nat::rem_nz(b, 2, Nat::ne_zero(2, Refl))),
    a1 => a2 => b => h => Eq::congr(Nat, Bool, Nat::rem_nz(a1, 2, Nat::ne_zero(2, Refl)), Nat::rem_nz(a2, 2, Nat::ne_zero(2, Refl)), x => Nat::eq(x, Nat::rem_nz(b, 2, Nat::ne_zero(2, Refl))), h),
    a => b1 => b2 => h => Eq::congr(Nat, Bool, Nat::rem_nz(b1, 2, Nat::ne_zero(2, Refl)), Nat::rem_nz(b2, 2, Nat::ne_zero(2, Refl)), y => Nat::eq(Nat::rem_nz(a, 2, Nat::ne_zero(2, Refl)), y), h),
    p,
    q
  )
}
perform show("odd", parity_of(class_of(7), token()))
perform show("same", same_parity(class_of(3), class_of(9), token()))
perform show("different", same_parity(class_of(4), class_of(9), token()))
```
