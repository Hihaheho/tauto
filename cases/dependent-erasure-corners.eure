import std::Nat
import std::Refined
fn use(f: (n: Nat, h: n = n) -> Nat, p: Refined(Nat, x => x = x)): Nat {
  ⊢ Nat from match p { Mk(v, h) => f(v, h) }
}
fn choose(f: (A: Type, value: A) -> A, t: Refined(Nat, x => x = x)): Nat {
  let F: (k: Nat) -> Type := k => Nat
  f(F(0), t.val)
}
inductive Evidence: Type { Proof(n: Nat, h: Eq(Nat, Zero, Zero)): Evidence }
fn fixed(f: (h: Eq(Nat, Zero, Zero)) -> Nat, p: Evidence): Nat { f(p.h) }
fn run(): Nat {
  use((m, hm) => m, Refined::Mk(8, Refl)) + choose((B, item) => item, Refined::Mk(9, Refl)) + fixed(h => 5, Proof(3, Refl))
}
perform show("fields", run())
