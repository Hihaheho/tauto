    TautoErasedValue_1::TautoErasedNat_1(0) => TautoErasedValue_1::TautoErasedNat_1(10)
    TautoErasedValue_1::TautoErasedNat_1(TautoErasedNat3_1) if TautoErasedNat3_1 == 1 => TautoErasedValue_1::TautoErasedNat_1(20)
    TautoErasedValue_1::TautoErasedNat_1(TautoErasedNat4_1) if TautoErasedNat4_1 >= 2 => {
      let k := TautoErasedValue_1::TautoErasedNat_1(TautoErasedNat4_1 - 2)
      TautoErasedValue_1::TautoErasedNat_1(TautoErasedGetNat_1(k) + TautoErasedGetNat_1(TautoErasedValue_1::TautoErasedNat_1(30)))
    }
    _ => extract_unreachable()
  }
}
fn TautoErasedFn5_1(n: TautoErasedValue_1): TautoErasedValue_1 { TautoErasedFn1_1(n, TautoErasedValue_1::TautoErasedCtor6_1(TautoErasedValue_1::TautoErasedNat_1(0))) }
```

@ cases.returned-closure
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
extract = true
files."app/src/main.taut" = ```tauto
import std::Nat
inductive Token: (Nat) -> Type { Mk(n: Nat): Token(n) }
fn make(n: Nat, t: Token(0)): (x: Nat) -> Nat { x => x + n }
fn generic<A>(a: A, t: Token(0)): (x: Nat) -> A { x => a }
fn zero(): (x: Nat) -> Nat { make(2, Mk(0)) }
fn run(n: Nat): Nat {
  let f := make(n, Mk(0))
  let g := generic(n, Mk(0))
  let h := zero()
  f(7) + g(99) + h(3)
}
perform show("captured", run(5))
```
