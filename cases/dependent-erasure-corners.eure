description = "Dependent erasure across nested patterns and higher-order boundaries."
@ cases.nested-natural-patterns
files_tote = "app"
files."app/Tauto.eure" = 'package { name = "app"
version = "0.1.0" }'
extract = true
files."app/src/main.taut" = ```tauto
import std::Nat
inductive Token: (Nat) -> Type { Mk(n: Nat): Token(n) }
fn nested(n: Nat, t: Token(0)): Nat {
  ⊢ Nat from match n {
    Zero => 10
    Succ(Zero) => 20
    Succ(Succ(k)) => k + 30
  }
}
fn run(n: Nat): Nat { nested(n, Mk(0)) }
perform show("zero", run(0))
perform show("one", run(1))
perform show("two", run(2))
perform show("seven", run(7))
```
shows = ["zero = 10", "one = 20", "two = 30", "seven = 35"]
backends = ["rust", "javascript"]
rust_shows = ["zero = 10", "one = 20", "two = 30", "seven = 35"]
javascript_shows = ["zero = 10", "one = 20", "two = 30", "seven = 35"]
extracted_nib."TautoErasedFn*" = ```nib
