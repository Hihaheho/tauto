inductive Token: (Nat) -> Type { Mk(n: Nat): Token(n) }
fn generic<A>(a: A, t: Token(0)): (x: Nat) -> A { x => a }
fn run(): Nat {
  let factory := generic
  let partial := generic(Nat)
  let chosen := partial(7, Mk(0))
  generic(5, Mk(0), 99) + factory(6, Mk(0), 88) + chosen(77)
}
perform show("result", run())
