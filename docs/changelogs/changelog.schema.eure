$types {
  @ change
  $variant: record
  area = `text`
  summary = `text.markdown`
  details = `text.markdown`
  details.$optional = true
  breaking = `boolean`
  breaking.$optional = true
  migration = `text.markdown`
  migration.$optional = true
}

$variant: record

// Required fields
// The public main commit this release is diffed against.
base = `text`
summary = `text.markdown`

// Changes, grouped by kind. Omit a kind that has no entries.
added = [`$types.change`]
added.$optional = true
changed = [`$types.change`]
changed.$optional = true
removed = [`$types.change`]
removed.$optional = true
fixed = [`$types.change`]
fixed.$optional = true
deprecated = [`$types.change`]
deprecated.$optional = true
security = [`$types.change`]
security.$optional = true

// Optional fields
tags = [`text`]
tags.$optional = true
