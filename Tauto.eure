// Project manifest for the standard library and core proofs.
package {
  name = "tauto-lib"
  version = "0.1.0"
  // The project has no `src`; its .taut files are under these directories, and `import` paths are relative to the importing file.
  additional-sources = ["std", "meta"]
  // The standard library declares the prelude: its files import what they use of it.
  prelude = false
}

// The laws of the rationals and the error bounds of rounding normalise many integer equations with
// int_norm! steps; FloatRound is about 17000 lines of such bounds.
check {
  // The quotient's soundness is the one axiom of the library.
  axioms {
    "std/Quot.taut" = ["Quot::sound"]
    "std/RatField.taut" = ["Quot::sound"]
  }
  slow {
    "std/FloatBoundsA.taut" = 30
    "std/FloatBoundsB.taut" = 30
    "std/FloatEncode.taut" = 40
    "std/FloatError.taut" = 40
    "std/FloatRound.taut" = 60
    "std/RatLaws.taut" = 60
  }
}
