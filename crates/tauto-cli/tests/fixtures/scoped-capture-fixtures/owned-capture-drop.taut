import std::builtin::os { stdout, stdout_flush }
struct(affine) Probe {}
extern { fn Probe::new(name: &Text): Probe }
fn outer(): Unit ! {stdout, stdout_flush} {
  let captured := Probe::new("captured")
  {
    fn unused(): Probe { captured }
    #()
  }
  show(&1)
}
perform main(() => {
  outer()
})
