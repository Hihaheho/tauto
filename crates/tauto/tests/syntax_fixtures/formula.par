%start Formula
%title "natural-deduction"
%%
Formula: Disj [ Arrow Formula ];
Disj: Conj { OrTok Conj };
Conj: Unary { AndTok Unary };
Unary: Neg | Atom;
Neg: NotTok Unary;
Atom: Bot | Prop | Var | Paren;
Paren: LParen Formula RParen;
Prop: /P[0-9]+/;
Var: /[a-z][A-Za-z0-9_]*/;
Bot: '⊥';
NotTok: '¬';
AndTok: '∧';
OrTok: '∨';
Arrow: '→';
LParen: '(';
RParen: ')';
