tauto-not-imported = { $message }{ $hint }
tauto-in-std = ; it is in the standard library: `import std::{ $module }`
tauto-why-builtin = it is a built-in of the prelude{ $hint }
tauto-why-inductive-struct = it is an `inductive struct` the kernel cannot be given
tauto-why-inductive-enum = it is an `inductive enum` the kernel cannot be given
tauto-why-struct = it is a `struct`, not one of the kernel's types; write `inductive struct` for the proofs to see it
tauto-why-enum = it is an `enum`, not one of the kernel's types; write `inductive enum` for the proofs to see it
tauto-why-extern = it is an `extern` function of the host
tauto-why-let = it is a top-level `let` or `var`
tauto-why-effect = it is an effect the kernel does not read
tauto-why-uses-because = it uses `{ $name }`, which runs as written: { $why }
tauto-why-uses = it uses `{ $name }`, which runs as written
tauto-why-unread = it has effects, or a part, that the kernel does not read
tauto-runs-as-written = `{ $name }` is not defined in proofs: it runs as written and is not checked by the kernel, because { $reason }; a proof uses only what the kernel checked
tauto-runs-as-written-builtin = `{ $name }` is not defined in proofs: it runs as written and is not checked by the kernel, because { $reason }; a proof uses only what the kernel checked; when a kernel declaration of that name was meant, import it where the name is written: a name a macro's `quote` writes means what the macro's own file sees
tauto-lint-typed-macro-in-proof = typed-macro-in-proof: `{ $name }!(…)` in a proof; write the expansion (tauto macro expand)
tauto-lint-step-tactic = step-tactic: `by { $tactic }!(…)` calls a tactic std does not have ({ $tactics })
tauto-lint-macro-capture = macro-capture: `Syn::ident_like` captures a name of the caller; for the name of a declaration the caller uses, write `Syn::decl_name`, and for a global of the macro's tote, `Syn::global`
tauto-lint-escape = escape: write the sign for `{ $escape }` (tauto fmt does)
tauto-lint-wild-arm = a `_ =>` arm: name every constructor instead
tauto-lint-rest-arm = rest-arm: a named rest arm follows only literals of an integer, a character or `Text`; name every constructor instead
tauto-lint-indexed-arm-goal = indexed-arm-goal: an arm of a `match` over a type with indices writes its goal (`C => ⊢ G from p`)
tauto-lint-hole = a hole `?{ $name }`: a finished file has none
tauto-lint-braced-name = braced-name: write `${ $name }`, not `${"{"}{ $name }{"}"}`
tauto-lint-hand-generalize = hand-generalize: the motive ends in `->` and an arm takes the hypothesis again with a λ; `match` generalizes the arguments after the matched one, and `match e eqn h` names the equation
tauto-lint-bool-cases = bool-cases: split a `Bool` with `match`, not `Bool::cases`
tauto-lint-bool-mix = bool-mix: write `&&` and `||` mixed in parentheses: `(a && b) || c`
tauto-lint-mk-constructor = mk-constructor: `{ $name }` is a constructor of `{ $ty }`, which has more than one; `Mk` names the constructor of a type with one
tauto-lint-raw-local = raw-local: the local `r#{ $name }`; `r#` is for a field, a public name or a name at a boundary, so name the local otherwise
tauto-lint-pair-projection = pair-projection: write `e.{ $field }`, not `{ $name }(e)`
tauto-lint-named-prop = named-prop: write `{ $sign }`, not `{ $name }(…)`
tauto-lint-explicit-implicit = explicit-implicit: `{ $name }(…)` writes out implicit arguments first-order matching determines; pass the explicit ones only
tauto-lint-unused-forall = unused-forall: `∀ { $name }` binds a name nothing uses; write `(P) -> Q`
tauto-dead-function = the function `{ $name }` is never called
tauto-dead-import = nothing of `{ $path }` is used
tauto-dead-binding = the { $what } `{ $name }` is defined but not used
tauto-dead-after-return = this statement is after a `return` and never runs
tauto-fmt-unclosed-comment = an unclosed block comment
tauto-fmt-unclosed-string = an unclosed string
tauto-fmt-too-deep = the source nests too deeply
tauto-fmt-unmatched = an unmatched `{ $token }`
tauto-fmt-unclosed = an unclosed `{ $token }`
tauto-fmt-unclosed-bracket = an unclosed bracket
tauto-fmt-changes-tokens = the layout would change the tokens
tauto-fmt-not-read = the file is not among the files read
tauto-fmt-does-not-fit = the laid-out text does not fit the literal's form
tauto-fmt-literal-left = syntax { $syntax }: the literal is left as written ({ $why })
tauto-fmt-parse-failed = the file does not parse, so no syntax literal or fence is laid out ({ $why })
tauto-fmt-load-failed = the program does not load, so no syntax literal or fence is laid out ({ $why })
tauto-fmt-fence-unclosed = the fenced block in the comment is not closed
tauto-fmt-block-inline = the closing fence does not start its line
tauto-fmt-not-usable = the `fmt` function of the syntax is not usable (see the errors of the program)
tauto-dep-fetched-from-git = dependency { $name }: { $dir } was fetched from Git; read it through the project whose Tauto.lock fixes its dependencies
tauto-dep-not-locked = dependency { $name } ({ $source }) is not in { $lock }; run `tauto lock` there
tauto-dep-lock-differs = dependency { $name }: { $lock } fixes { $locked }, but it is asked for as { $source }; run `tauto lock` in { $project }
tauto-dep-offline = dependency { $name } ({ $url } at { $rev }) has not been fetched, and the network is off; run `tauto fetch` in { $project }
tauto-dep-fetching = Fetching { $name } { $rev } from { $url }
tauto-dep-error = dependency { $name }: { $error }
tauto-import-error = `import { $name }`: { $message }
tauto-import-no-std-module = the standard library has no module { $module }
tauto-import-not-dependency = { $dependency } is not a dependency of this file's tote; name it in `dependencies` of Tauto.eure, or import std as `import std::List`
tauto-import-misnamed = { $dir } is named { $found }, not { $dependency }
tauto-import-name-module = name a module, as `import { $dependency }.Module`
tauto-import-no-module = { $dependency } has no module { $module } (looked for { $stem }.taut under { $sources })
tauto-import-many-modules = { $dependency } has more than one module { $module }: { $paths }
tauto-imports-need-path = imports need a file path: use check_file
tauto-skipped-runs = runs as written; not checked by the kernel
tauto-in-expansion =
    { $message }
    {"  "}in the expansion of `{ $name }!`
tauto-in-expansion-at =
    { $message }
    {"  "}in the expansion of `{ $name }!` (byte { $byte })
tauto-written-in-macro-at =
    { $message }
    {"  "}written in the macro at { $file }:{ $line }:{ $column }
tauto-not-a-term = `{ $expr }` does not read as a term: { $error }
tauto-program-too-large = the program is too large
tauto-no-command = the tote { $tote } has no command { $name }
tauto-tote-panicked = tote checking panicked
tauto-command-main-missing = the command { $name } of { $tote } runs { $main }, which is not a file in { $dir }
tauto-command-main-elsewhere = the command { $name } of { $tote } runs { $main }, which is not a file of the tote { $tote }
tauto-tote-cycle = the totes depend on each other: { $totes }
tauto-tote-named-twice = two totes are named { $name }: { $first } and { $second }; a project has one of each
tauto-dep-of-error = dependency { $name } of { $tote }: { $error }
tauto-dep-misnamed = { $tote } depends on { $name }, but { $dir } is named { $found }
tauto-untrusted-externs =
    dependency { $tote } declares extern functions, whose host access no --allow-* permission covers:
    { $externs }
    to run them anyway, add `trust {"{"} extern = ["{ $tote }"] {"}"}` to the project's Tauto.eure
tauto-include-argument = include.argument: { $name }! takes one text literal, the path of the file
tauto-include-empty = include.path: the path is empty
tauto-include-absolute-relative = include.absolute: `{ $path }` is absolute; the path is relative to the file that writes it
tauto-include-outside = include.outside: `{ $path }` leaves { $root }; a file may read only inside its tote
tauto-include-absolute = include.absolute: `{ $path }` is absolute
tauto-include-symlink = include.outside: `{ $path }` leads out of { $root } through a symbolic link
tauto-include-read = include.read: `{ $path }`: { $error }
tauto-include-not-utf8 = include.not_utf8: `{ $path }` is not UTF-8
tauto-reg = syntax { $syntax }: `{ $function }`, the { $role } function, { $problem }
tauto-reg-not-defined = is not defined
tauto-reg-not-function = is not a function
tauto-reg-wrong = { $what }; it is `{ $wanted }`
tauto-reg-arity = takes { $count } arguments
tauto-reg-reads = reads { $ty }
tauto-reg-width = takes { $ty } as the width
tauto-reg-makes = makes { $ty }
tauto-reg-unknown-effect = performs an effect that cannot be followed ({ $effect })
tauto-reg-effect = may perform Div and macro_error only, and it performs { $effect }
tauto-reg-host-effect = performs the host effect { $effect }, which the host that runs it does not answer
tauto-reg-call-error = `{ $function }`: { $error }
tauto-reg-not-text = `{ $function }` did not make a Text
tauto-reg-not-option = `{ $function }` did not make an Option
tauto-reg-not-idempotent = `{ $function }` is not idempotent: laying out its own output changes it
tauto-reg-not-list = `{ $function }` did not make a List
tauto-reg-malformed = `{ $function }` made a malformed SynHighlight
tauto-reg-colour = `{ $function }` made the colour `{ $kind }`, which the legend does not list
tauto-reg-range = `{ $function }` made a range outside the text ({ $start }..{ $end })
tauto-reg-not-token = this text is not a token of the syntax (byte { $byte })
tauto-reg-not-syntax = this text is not of the syntax (byte { $byte })
tauto-reg-too-deep = the tree is deeper than a function may be given
tauto-reg-laid-not-token = the text is not a token of the syntax (byte { $byte })
tauto-reg-laid-not-syntax = the laid-out text is not of the syntax
tauto-reg-laid-changes = the laid-out text changes more than white space
tauto-manifest-dep-leaves = dependency { $name }: { $path } leads out of the tote fetched in { $tree }
tauto-manifest-unknown-key = unknown key { $key } in Tauto.eure
