# The errors of the evaluator: those of `tauto run` while it runs a program,
# and those of a macro it runs.

eval-is-not-a-constructor = { $ctor } is not a constructor
eval-takes-values-got = { $ctor } takes { $fields } values, got { $fields2 }
eval-a-quote-s-hole-is-not = a quote's hole is not a value
eval-is-not-syntax = { $other } is not syntax
eval-a-list-was-expected = a List was expected
eval-an-option-i64-was-expected = an Option(i64) was expected
eval-unknown-builtin = unknown builtin { $name }
eval-takes-other-arguments = { $name } takes other arguments
eval-takes-a-list-text = { $what } takes a List(Text)
eval-takes-a-list-bytes = { $what } takes a List(Bytes)
eval-takes-a-list-u8 = { $what } takes a List(u8)
eval-a-linear-is-dropped = a linear { $ty } is dropped
eval-not-supported-yet-byte = not supported yet: { $what } (byte { $start })
eval-a-syntax-or-macro-is-not = a syntax or macro is not expanded (byte { $start })
eval-is-used-after-move = { $name } is used after move
eval-is-not-defined = { $name } is not defined
eval-is-borrowed-after-move = { $name } is borrowed after move
eval-is-not-a-var = { $name } is not a var
eval-no-field = no field `{ $name }`
eval-has-no-field = { $ty } has no field `{ $name }`
eval-only-a-var-or-its-field = only a var or its field lends `&mut`
eval-is-too-large = { $n } is too large
eval-is-not-a-float = { $x } is not a Float
eval-a-borrowing-lambda-without-a-lambda = a borrowing lambda without a lambda
eval-a-product-s-member-of-unknown = a product's member of unknown type
eval-not-supported-yet = not supported yet: { $other }
eval-is-not-a-struct = { $name } is not a struct
eval-a-field-is-missing = { $name }: a field is missing
eval-expected-a-boolean-got = expected a boolean, got { $other }
eval-a-loop-frame-without-a-loop = a loop frame without a loop
eval-a-guard-must-be-a-boolean = a guard must be a boolean, got { $other }
eval-the-return-arm-s-pattern-does = the return arm's pattern does not match
eval-budget-must-be-a-number-got = budget { $limit } must be a number, got { $other }
eval-return-outside-a-function = `return` outside a function
eval-a-function-takes-values-got = a function takes { $params } values, got { $args }
eval-a-continuation-takes-one-value = a continuation takes one value
eval-a-continuation-that-resumes-at-most = a continuation that resumes at most once is resumed twice
eval-extern-is-not-runnable = extern is not runnable: { $name }
eval-more-takes-a-number-unbounded-nothing = `more` takes a number, `unbounded` nothing
eval-is-not-a-function = { $other } is not a function
eval-is-not-filled-in-as-an = { $other } is not filled in as an expression; use a SynExpr or a SynIdent
eval-is-for-a-typed-macro = { $op } is for a typed macro
eval-text-of-takes-a-buf = Text.of takes a Buf
eval-weak-get-takes-a-weak = Weak.get takes a Weak
eval-cell-get-takes-a-cell = cell_get takes a cell
eval-cell-set-takes-a-cell = cell_set takes a cell
eval-mutex-claim-takes-a-mutex = Mutex.claim takes a Mutex
eval-mutex-take-claimed-takes-a-mutex = Mutex.take_claimed takes a Mutex
eval-mutex-guard-get-takes-a-guard = MutexGuard.get takes a MutexGuard
eval-mutex-take-claimed-of-an-empty = Mutex.take_claimed of an empty Mutex: its signal was not raised
eval-atomic-fetch-add-takes-an-atomic = Atomic.fetch_add takes an Atomic
eval-buf-push-takes-a-buf = Buf.push takes a Buf
eval-vec-push-takes-a-vec = Vec.push takes a Vec
eval-vec-pop-takes-a-vec = Vec.pop takes a Vec
eval-vec-swap-takes-a-vec = Vec.swap takes a Vec
eval-vec-len-takes-a-vec = Vec.len takes a Vec
eval-vec-index-takes-a-vec = Vec.index takes a Vec
eval-takes-a-vec = { $name } takes a Vec
eval-vec-into-list-takes-a-vec = Vec.into_list takes a Vec
eval-vec-into-array-takes-a-vec = Vec.into_array takes a Vec
eval-vec-get-takes-a-vec = Vec.get takes a Vec
eval-vec-get-mut-takes-a-vec = Vec.get_mut takes a Vec
eval-vec-last-mut-takes-a-vec = Vec.last_mut takes a Vec
eval-hashmap-get-takes-a-hashmap = HashMap.get takes a HashMap
eval-hashmap-index-takes-a-hashmap = HashMap.index takes a HashMap
eval-hashmap-insert-takes-a-hashmap = HashMap.insert takes a HashMap
eval-hashmap-into-vec-takes-a-hashmap = HashMap.into_vec takes a HashMap
eval-text-of-utf8-takes-bytes = Text.of_utf8 takes bytes
eval-ct-bytes-len-takes-secret-bytes = Ct::bytes_len takes secret bytes
eval-ct-bytes-get-takes-secret-bytes = Ct::bytes_get takes secret bytes
eval-a-header-is-text = a header is text
eval-replace-takes-mut-x = replace takes `&mut x`
eval-cannot-take = { $name } cannot take { $join }
eval-guards-on-handler-arms-are-not = guards on handler arms are not supported yet
eval-deadlock = { $deadlock } (the evaluator runs each spawned task to its end, so a Mutex.take of an empty Mutex waits for a Mutex.put that never comes)
eval-nothing-handles-because = { $unhandled }: { $why }
eval-may-resume-more-than-once-and = { $effect } may resume more than once, and its continuation holds { $ty }
eval-may-resume-more-than-once-and-2 = { $effect } may resume more than once, and its continuation holds { $node } ({ $ty })
eval-has-no-field-2 = { $other } has no field `{ $name }`
eval-cannot-apply-to = cannot apply { $op } to { $join }
eval-cannot-apply-to-nat = cannot apply { $op } to nat
eval-cannot-apply-to-float = cannot apply { $op } to Float
eval-cannot-apply-to-float32 = cannot apply { $op } to Float32
eval-is-not-a-secret-operation = { $name } is not a secret operation
eval-takes-secret-yes-or-no = { $name } takes secret yes or no
eval-takes-one-secret-word = { $name } takes one secret word
eval-cannot-compare-containers = cannot compare containers
eval-cannot-compare-with = cannot compare { $a } with { $b }
eval-the-product-has-no-member = the product has no member { $key }
eval-the-product-has-no-member-of = the product has no member of { $to }
eval-syntax-error = syntax error: { $error }
eval-type-error = type error: { $error }
eval-use-error = use error: { $error }
eval-ownership-check = ownership check: { $error }
eval-exited = exited
eval-not-allowed-in-macro = { $name } is not allowed in a macro
eval-macro-too-many-values = the macro made too many values
eval-macro-asked-for-expansion = the macro asked for an expansion
eval-macro-stopped-evaluator = the macro stopped the evaluator
eval-takes-secret-words = { $name } takes secret words
