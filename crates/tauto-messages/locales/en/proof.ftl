proof-usage = usage: { $usage }
proof-title = Tauto proof
proof-no-theorem = proof: no matching theorem with a body in the entry file
proof-ambiguous = proof: ambiguous theorem name { $name }
proof-axioms = checked; axioms: { $names }
proof-incomplete = incomplete: { $details }
proof-failed = failed: { $details }
proof-skipped = skipped: { $details }
proof-derivation-note = Each block is an inference. Its inputs are premise judgments and its output is the conclusion. Contexts specify the assumptions in scope; introductions discharge their local assumptions.
proof-no-derivation = No derivation is available: the proof did not reach a successful core check.
proof-contexts = Assumptions in each context
proof-premise = Premise
proof-discharge = Local assumptions discharged here: { $names }
proof-suppose = Suppose { $assumptions }.
proof-rule-assumption = Hypothesis
proof-rule-constant = Declaration
proof-rule-literal = Numeral
proof-rule-sort = Universe
proof-rule-formation = Function type formation
proof-rule-introduction = Function introduction
proof-rule-application = Function elimination
proof-rule-conversion = Conversion / cumulativity
proof-rule-reduction = Beta reduction
proof-rule-hole = Unproved goal
proof-rule-unverified = Unproved reference
proof-open-rule = open: { $rule }
proof-natural-context = Assume { $assumptions }.
proof-natural-goal = We prove { $goal }.
proof-natural-assumption = By hypothesis { $term }, { $goal } holds.
proof-natural-declaration = The declared statement { $term } gives { $goal }.
proof-natural-introduction = By { $premises }, discharging { $names }, we obtain { $goal }.
proof-natural-application = Using { $call }, we obtain { $goal }.
proof-natural-congruence = Applying { $function } to both sides of { $hypothesis }, congruence { $lemma } gives { $goal }.
proof-natural-reflexivity = By reflexivity, { $goal } holds.
proof-natural-calculation = Calculating { $premises } by { $reason }, we obtain { $goal }.
proof-natural-conversion = From { $premises }, by { $reason }, we obtain { $goal }.
proof-natural-definitional = definitional equality checked by the kernel
proof-natural-cumulative = universe cumulativity checked by the kernel
proof-natural-recorded-conversion = the recorded type conversion
proof-natural-computation = computation
proof-natural-definitions = the definitions of { $names }
proof-natural-hole = It remains to prove { $goal } (open goal { $term }). This is not an established conclusion.
proof-natural-unverified = The reference { $term } has declared type { $goal }, but its proof is not available in the core.
proof-natural-pending = To establish { $goal }, the obligations in { $premises } must still be completed.
proof-natural-judgment = By { $premises } and { $rule }, we obtain { $goal }.
proof-natural-rule = By { $rule }, we obtain { $goal }.
proof-natural-reverse-calculation = The following calculation by { $reason } identifies the types; from { $premises }, we obtain { $goal }.
proof-natural-goal-typed = We establish { $goal }.
proof-full-leaf = By { $rule }, { $claim }.
proof-full-step = From { $premises }, by { $rule }, { $claim }.
proof-full-open = Open inference ({ $rule }): { $claim }. The premises { $premises } include unproved obligations.
proof-full-open-leaf = Open leaf ({ $rule }): { $claim }. No proof is recorded.
proof-chain-congruence = { $proof } and congruence
proof-chain-congruence-reverse = { $proof }, congruence and symmetry
proof-chain-reverse = { $proof } in reverse
proof-construct = Choose { $constructor } with data { $data }. The conditions are { $conditions }. This proves { $goal }.
proof-induction = By induction on { $term }, prove { $goal }.
proof-decompose = Decompose { $term } to prove { $goal }.
proof-cases = By cases on { $term }, prove { $goal }.
proof-branch = { $constructor }: assume [{ $assumptions }]; goal: { $goal }.
proof-branches-conclude = These branches establish { $goal }.
proof-construct-empty = { $constructor } establishes { $goal }.
proof-construct-conditions = The conditions are { $conditions }. Applying { $constructor } proves { $goal }.
proof-construct-data = Choose { $data } for { $constructor }. This proves { $goal }.
proof-branch-empty = { $constructor }: goal: { $goal }.
