# `tauto assumptions`. The statuses (ok, skipped, …) stay as they are.

assumptions-usage = usage: { $usage }
assumptions-no-declaration = assumptions: { $path } declares no { $name }
assumptions-none = none
assumptions-axioms = axioms:  { $names }
assumptions-externs = externs: { $names }
assumptions-holes = holes:   { $names }
assumptions-uses-incomplete = uses incomplete: { $names }
