proof-usage = 使い方: { $usage }
proof-title = Tauto の証明
proof-no-theorem = proof: 対象ファイルに本文を持つ該当の定理がありません
proof-ambiguous = proof: 定理名 { $name } が一意に決まりません
proof-axioms = 検査済み; 公理: { $names }
proof-incomplete = 未完成: { $details }
proof-failed = 検査失敗: { $details }
proof-skipped = 検査対象外: { $details }
proof-derivation-note = 各ブロックは推論を表します。入力は前提の判断、出力は結論です。文脈に仮定の範囲を示し、導入規則では局所的な仮定を閉じます。
proof-no-derivation = 導出はありません。証明はカーネルでの検査成功に至っていません。
proof-contexts = 各文脈の仮定
proof-premise = 前提
proof-discharge = ここで閉じる局所的な仮定: { $names }
proof-suppose = { $assumptions } と仮定する。
proof-rule-assumption = 仮定
proof-rule-constant = 宣言の参照
proof-rule-literal = 数の型
proof-rule-sort = 宇宙
proof-rule-formation = 関数型の形成
proof-rule-introduction = 関数の導入
proof-rule-application = 関数の除去
proof-rule-conversion = 型の変換・宇宙の包含
proof-rule-reduction = β簡約
proof-rule-hole = 未証明のゴール
proof-rule-unverified = 未証明の参照
proof-open-rule = 未完成: { $rule }
proof-natural-context = { $assumptions } と仮定する。
proof-natural-goal = { $goal } を示す。
proof-natural-assumption = 仮定 { $term } より、{ $goal } が成り立つ。
proof-natural-declaration = 宣言 { $term } により、{ $goal } が成り立つ。
proof-natural-introduction = { $premises } より、仮定 { $names } を閉じて { $goal } を得る。
proof-natural-application = { $call } を用いて、{ $goal } を得る。
proof-natural-congruence = { $hypothesis } の両辺に { $function } を適用すると、等号の合同性 { $lemma } により { $goal } を得る。
proof-natural-reflexivity = 反射性により、{ $goal } が成り立つ。
proof-natural-calculation = { $premises } を { $reason }により計算すると、{ $goal } を得る。
proof-natural-conversion = { $premises } より、{ $reason } によって { $goal } を得る。
proof-natural-definitional = カーネルが確かめた型の同一視
proof-natural-cumulative = カーネルが確かめた宇宙の包含
proof-natural-recorded-conversion = 記録された型の変換
proof-natural-computation = 計算規則
proof-natural-definitions = { $names } の定義
proof-natural-hole = 残るゴールは { $goal }（穴 { $term }）。これは未証明であり、確立した結論ではない。
proof-natural-unverified = 参照 { $term } には型 { $goal } が宣言されているが、その証明はカーネルに登録されていない。
proof-natural-pending = { $goal } を示すには、{ $premises } の未証明のゴールを完成させる必要がある。
proof-natural-judgment = { $premises } と { $rule } により、{ $goal } を得る。
proof-natural-rule = { $rule } により、{ $goal } を得る。
proof-natural-reverse-calculation = { $reason }による次の計算で型が一致するので、{ $premises } より { $goal } を得る。
proof-natural-goal-typed = { $goal } を示す。
proof-full-leaf = { $rule } により、{ $claim }。
proof-full-step = { $premises } より、{ $rule } により、{ $claim }。
proof-full-open = 未完成の推論（{ $rule }）: { $claim }。前提 { $premises } に未証明のものがある。
proof-full-open-leaf = 未証明の葉（{ $rule }）: { $claim }。証明は記録されていない。
proof-chain-congruence = { $proof } と合同性より
proof-chain-congruence-reverse = { $proof } と合同性・対称性より
proof-chain-reverse = { $proof } を逆向きに使う
proof-construct = { $constructor } のデータとして { $data } を選ぶ。条件は { $conditions }。これにより { $goal } を得る。
proof-induction = { $term } に関する帰納法で { $goal } を示す。
proof-decompose = { $term } を分解し、{ $goal } を示す。
proof-cases = { $term } で場合分けし、{ $goal } を示す。
proof-branch = { $constructor }: [{ $assumptions }] を仮定する。目標は { $goal }。
proof-branches-conclude = 各分岐から { $goal } を得る。
proof-construct-empty = { $constructor } により { $goal } を得る。
proof-construct-conditions = 条件は { $conditions }。{ $constructor } により { $goal } を得る。
proof-construct-data = { $constructor } のデータとして { $data } を選ぶ。これにより { $goal } を得る。
proof-branch-empty = { $constructor }: 目標は { $goal }。
