// Not part of the standard library's tote at the root: the .taut files here are
// test inputs and fixtures (some fail, or have holes, on purpose) and kernel
// sources, which the tests and the build read themselves. Without this file a
// `tauto check` at the root would check them as files of the root's tote.
package {
  name = "crates-inputs"
  version = "0.0.0"
}
