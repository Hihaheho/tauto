@ cases.a-pattern-inside-a-recursive-field
source = ```nib
enum Tree { Leaf, Node(Tree, i64, Tree) }
fn by_value(t: Tree) -> i64 {
  match t {
    Node(Node(a, x, b), y, Leaf) => x + y
    Node(Leaf, y, _) => y
    _ => 0
  }
}
fn deep(t: &Tree) -> i64 {
  match t {
    Node(Node(Node(_, z, _), x, _), y, _) => z * 100 + x * 10 + y
    Node(Node(_, x, r), y, _) => x * 10 + y
    Node(l, y, _) => y
    Leaf => 0
  }
}
let small = Node(Node(Leaf, 1, Leaf), 2, Leaf)
let big = Node(Node(Node(Leaf, 3, Leaf), 1, Leaf), 2, Leaf)
perform show("value", by_value(small))
perform show("deep3", deep(&big))
perform show("deep2", deep(&small))
perform show("leaf", deep(&Leaf))
```
shows = ["value = 3", "deep3 = 312", "deep2 = 12", "leaf = 0"]

@ cases.a-guard-reads-a-name-from-a-recursive-field
source = ```nib
enum Tree { Leaf, Node(Tree, i64, Tree) }
fn sum(t: &Tree) -> i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => sum(l) + v + sum(r)
  }
}
fn heavy_left(t: &Tree) -> i64 {
  match t {
    Node(l, y, _) if sum(l) > 0 => y
    _ => 0
  }
}
let t = Node(Node(Leaf, 1, Leaf), 2, Leaf)
perform show("heavy", heavy_left(&t))
perform show("none", heavy_left(&Node(Leaf, 5, Leaf)))
```
shows = ["heavy = 2", "none = 0"]

