@ cases.a-borrow-in-a-function-that-suspends
source = ```nib
effect yield: (n: i64) -> () resume <=1
fn gen(&v: Vec(i64)) -> () ! {yield, Div} {
  var i = 0
  while i < vec_len(&v) {
    handle {
      perform yield(vec_index(&v, i))
    } with {
      out_of_bounds() => ()
    }
    i := i + 1
  }
}
fn sum_all(&v: Vec(i64)) -> i64 ! {Div} {
  var total = 0
  handle { gen(&v) } with {
    yield(n), k => {
      total := total + n
      k(())
    }
  }
  total
}
var v = vec_new()
vec_push(&mut v, 3)
vec_push(&mut v, 4)
vec_push(&mut v, 5)
perform show("sum", sum_all(&v))
```
shows = ["sum = 12"]

