@ cases.tasks-share-an-atomic-and-a-mutex
source = ```nib
fn bump(a: Atomic, n: u64) -> u64 {
  var i: u64 = 0
  while i < n {
    let before = atomic_fetch_add(a, 1)
    i := i + 1
  }
  n
}
let total = atomic_new(0)
let m = mutex_new(vec_new())
let r = run_eager(() => {
  let a = perform spawn(() => bump(total, 1000))
  let b = perform spawn(() => bump(total, 2000))
  let c = perform spawn(() => {
    mutex_with(m, (&mut v) => vec_push(&mut v, 1))
    3
  })
  task_join(a) + task_join(b) + task_join(c)
})
let n = mutex_with(m, (&mut v) => vec_len(&v))
perform show("r", r)
perform show("total", atomic_load(total))
perform show("n", n)
```
shows = ["r = 3003", "total = 3000", "n = 1"]

@ cases.a-function-that-only-reads-a-tree-takes-it-by-reference
source = ```nib
enum Tree { Leaf, Node(Tree, i64, Tree) }
fn insert(t: Tree, x: i64) -> Tree {
  match t {
    Leaf => Node(Leaf, x, Leaf)
    Node(l, v, r) => if x < v { Node(insert(l, x), v, r) } else { Node(l, v, insert(r, x)) }
  }
}
fn has(t: Tree, x: i64) -> i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => if x == v { 1 } else if x < v { has(l, x) } else { has(r, x) }
  }
}
fn size(t: Tree) -> i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => size(l) + 1 + size(r)
  }
}
fn left(t: Tree) -> Tree {
  match t {
    Leaf => Leaf
    Node(l, v, r) => l
  }
}
fn pair(a: Tree, b: Tree) -> i64 { size(a) * 10 + size(b) }
fn root(t: Tree) -> i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => v
  }
}
let t = insert(insert(insert(insert(Leaf, 5), 2), 8), 3)
let u = t
perform show("has3", has(t, 3))
perform show("has4", has(t, 4))
perform show("size", size(t))
perform show("same twice", pair(t, t))
perform show("size of left", size(left(t)))
perform show("shared", size(u) + size(t))
perform show("temp", size(insert(t, 9)))
perform show("root", root(t) + root(left(t)))
```
shows = ["has3 = 1", "has4 = 0", "size = 4", "same twice = 44", "size of left = 2", "shared = 8", "temp = 5", "root = 7"]
