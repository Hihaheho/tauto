@ cases.m-nondeterminism-loops-and-recursion
source = ```nib
effect choose: () -> Bool resume ω
effect fail: () -> Never resume 0

fn pick(n: i64) -> i64 ! {choose, Div} {
  var acc = 0
  var i = 0
  while i < n {
    let b = perform choose()
    if b { acc := acc + i }
    i := i + 1
  }
  acc
}

fn rec(n: i64) -> i64 ! {choose, Div} {
  if n <= 0 { 0 } else {
    let b = perform choose()
    (if b { n } else { 0 }) + rec(n - 1)
  }
}

let all = handle { pick(3) } with {
  choose(), k => k(true) + k(false)
}
perform show("all", all)

let r = handle { rec(4) } with {
  choose(), k => k(true) + k(false)
}
perform show("r", r)

let first = handle { rec(3) } with {
  choose(), k => k(true)
}
perform show("first", first)

let two = handle {
  handle { perform choose() } with {
    choose(), k => if k(true) { false } else { true }
    return v => v
  }
} with {
  choose(), k => k(true)
}
perform show("two", two)
```
shows = ["all = 12", "r = 80", "first = 6", "two = false"]

@ cases.m-with-one-shot-and-abort-effects
source = ```nib
effect ask: () -> i64 resume ω
effect tick: (n: i64) -> () resume 1
effect fail: (e: Text) -> Never resume 0

fn work(n: i64) -> i64 ! {ask, tick, fail} {
  perform tick(n)
  let a = perform ask()
  if a > 100 { perform fail("too big") }
  perform tick(a)
  a + n
}

let r = handle {
  handle { work(1) + work(2) } with {
    tick(n), k => { perform show("tick", n)
      k(()) }
  }
} with {
  ask(), k => k(10) + k(20)
  fail(e) => { perform show("fail", e)
    0 }
}
perform show("r", r)

let s = handle {
  handle { work(5) } with {
    tick(n), k => k(())
  }
} with {
  ask(), k => k(200) + k(1)
  fail(e) => 1000
}
perform show("s", s)
```
shows = ["tick = 1", "tick = 10", "tick = 2", "tick = 10", "tick = 20", "tick = 20", "tick = 2", "tick = 10", "tick = 20", "r = 132", "s = 1006"]

@ cases.m-data-and-return-arm
source = ```nib
effect choose: () -> Bool resume ω
effect fail: (e: Text) -> Never resume 0
enum L { Nil, Cons(i64, L) }
struct P { x: i64, y: Text }

fn gen(n: i64) -> L ! {choose, Div} {
  if n <= 0 { Nil } else {
    let b = perform choose()
    let rest = gen(n - 1)
    if b { Cons(n, rest) } else { rest }
  }
}

fn len(xs: L) -> i64 {
  match xs {
    Nil => 0
    Cons(_, t) => 1 + len(t)
  }
}

fn sum(xs: L) -> i64 {
  match xs {
    Nil => 0
    Cons(h, t) => h + sum(t)
  }
}

let total = handle { len(gen(3)) } with {
  choose(), k => k(true) + k(false)
}
perform show("total", total)

let s = handle { sum(gen(4)) } with {
  choose(), k => k(true) + k(false)
  return v => v * 2
}
perform show("s", s)

fn pp(n: i64) -> P ! {choose} {
  let b = perform choose()
  P { x: if b { n } else { 0 - n }, y: "p" }
}
let q = handle {
  let p = pp(3)
  let r = pp(4)
  p.x * r.x
} with {
  choose(), k => k(true) + k(false)
}
perform show("q", q)

let t = handle {
  let b = perform choose()
  if b { perform fail("no") } else { 5 }
} with {
  choose(), k => k(true) + k(false)
  fail(e) => 100
}
perform show("t", t)

let u = handle {
  let b = perform choose()
  let c = perform choose()
  if b && c { 1 } else { if b || c { 10 } else { 100 } }
} with {
  choose(), k => k(true) + k(false)
}
perform show("u", u)
```
shows = ["total = 12", "s = 160", "q = 0", "t = 105", "u = 121"]

@ cases.m-inside-a-and-o-functions
source = ```nib
effect choose: () -> Bool resume ω
effect fail: (e: Text) -> Never resume 0
effect get: () -> i64 resume 1

fn early(n: i64) -> i64 ! {choose} {
  let b = perform choose()
  if b { return n }
  n * 100
}

fn inA(n: i64) -> i64 ! {fail} {
  let r = handle { early(n) + early(n + 1) } with {
    choose(), k => k(true) + k(false)
  }
  if r > 1000 { perform fail("big") }
  r
}

fn inO(n: i64) -> i64 ! {get} {
  let r = handle { early(n) + perform get() } with {
    choose(), k => k(true) + k(false)
  }
  r + perform get()
}

let a = handle { inA(1) } with { fail(e) => 0 - 1 }
perform show("a", a)
let a2 = handle { inA(50) } with { fail(e) => 0 - 1 }
perform show("a2", a2)
let o = handle { inO(2) } with { get(), k => k(7) }
perform show("o", o)

let d = handle {
  handle {
    let x = perform choose()
    perform show("x", x)
    x
  } with {
    show(l, s), k => { k(()) }
  }
} with {
  choose(), k => if k(true) { k(false) } else { false }
}
perform show("d", d)

fn count(n: i64) -> i64 ! {choose, Div} {
  var i = 0
  var c = 0
  while i < n {
    i := i + 1
    if perform choose() { c := c + 1 }
  }
  c
}
let w = handle { count(4) } with {
  choose(), k => k(true) + k(false)
}
perform show("w", w)
```
shows = ["a = 606", "a2 = -1", "o = 223", "d = false", "w = 20"]

