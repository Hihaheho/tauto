}
let r = handle {
  handle { f(1) + f(2) + f(3) } with {
    ask(n), k => k(n * 10)
  }
} with {
  fail(m) => 0 - 1
}
perform show("r", r)
let r2 = handle { f(1) + f(2) } with {
