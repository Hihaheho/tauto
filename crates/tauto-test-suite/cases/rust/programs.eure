// Programs the Rust backend must run as the evaluator does. A case uses
// `rust_shows` instead of `shows` where the dynamic ownership check
// (`--check-ownership`) rejects a program that the static use check accepts:
// a `var` captured by a closure (reported).

@ cases.data-and-show
source = ```nib
enum Shape { Circle(i64), Rect(i64, i64), Empty }
struct P { x: i64, y: i64 }
struct Unit {}
enum Tree { Leaf, Node(Tree, i64, Tree) }
fn area(s: Shape) -> i64 {
  match s {
    Circle(r) => 3 * r * r
    Rect(w, h) => w * h
    Empty => 0
  }
}
fn sum(t: Tree) -> i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => sum(l) + v + sum(r)
  }
}
fn depth(t: &Tree) -> i64 {
  match t {
    Leaf => 0
    Node(l, v, r) => {
      let a = depth(l)
      let b = depth(r)
      if a > b { a + 1 } else { b + 1 }
    }
  }
}
perform show("a", area(Circle(2)))
perform show("b", area(Rect(3, 4)))
perform show("c", Empty)
perform show("p", P { x: 1, y: 2 })
perform show("u", Unit {})
let t = Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf))
perform show("t", t)
perform show("d", depth(&t))
perform show("s", sum(t))
perform show("o", Some(3))
perform show("n", None)
perform show("r", Ok(1))
perform show("pair", Pair { fst: 1, snd: "x" })
perform show("b", true)
perform show("unit", Tuple())
```
shows = [
  "a = 12",
  "b = 12",
  "c = Empty",
  "p = P { x: 1, y: 2 }",
  "u = Unit {}",
  "t = Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf))",
  "d = 2",
  "s = 6",
  "o = Some(3)",
  "n = None",
  "r = Ok(1)",
  "pair = Pair { fst: 1, snd: \"x\" }",
  "b = true",
  "unit = ()",
]

@ cases.lists-closures-loops
source = ```nib
fn map(xs: List(i64), f: (i64) -> i64) -> List(i64) {
  match xs {
    Nil => Nil
    Cons(h, t) => Cons(f(h), map(t, f))
  }
}
fn len(xs: &List(i64)) -> i64 {
  match xs {
    Nil => 0
    Cons(h, t) => 1 + len(t)
  }
}
fn adder(n: i64) -> (i64) -> i64 { (x) => x + n }
let xs = Cons(1, Cons(2, Cons(3, Nil)))
let ys = map(xs, adder(10))
perform show("ys", ys)
perform show("len", len(&ys))
perform show("xs", xs)
var total = 0
var i = 0
while i < 5 {
  total := total + i
  i := i + 1
}
perform show("total", total)
let f = adder(1)
perform show("f", f(f(1)))
```
rust_shows = [
  "ys = Cons(11, Cons(12, Cons(13, Nil)))",
  "len = 3",
  "xs = Cons(1, Cons(2, Cons(3, Nil)))",
  "total = 10",
  "f = 3",
]

@ cases.direct-handlers
source = ```nib
effect get: () -> i64 direct
effect put: (n: i64) -> () direct
fn counter() -> i64 ! {get, put} {
  perform put(perform get() + 1)
  perform get()
}
let r = handle { counter() } with {
  get(), k => k(41)
  put(n), k => k(())
}
perform show("r", r)
let s = handle {
  perform show("inner", 1)
  2
} with {
  show(name, v), k => {
    perform show("wrapped", name)
    k(())
  }
}
perform show("s", s)
effect stop: () -> Never resume 0
fn guard(n: i64) -> i64 ! {stop} { if n > 3 { perform stop() } else { n } }
let t = handle { guard(2) + guard(10) } with {
  stop() => 99
  return v => v + 1000
}
perform show("t", t)
let u = handle { guard(1) } with {
  stop() => 99
  return v => v + 1000
}
perform show("u", u)
```
shows = [
  "r = 41",
  "wrapped = \"inner\"",
  "s = 2",
  "t = 99",
  "u = 1001",
]

@ cases.generics-and-patterns
source = ```nib
fn id<A>(x: A) -> A { x }
fn pair<A, B>(a: A, b: B) -> Pair(A, B) { Pair { fst: a, snd: b } }
fn apply<A, B>(f: (A) -> B, x: A) -> B { f(x) }
fn compose<A, B, C>(f: (A) -> B, g: (B) -> C) -> (A) -> C { (x) => g(f(x)) }
fn fold<A, B>(xs: List(A), z: B, f: (B, A) -> B) -> B {
  match xs {
    Nil => z
    Cons(h, t) => fold(t, f(z, h), f)
  }
}
fn classify(n: i64) -> Text {
  match n {
    0 => "zero"
    1 => "one"
    k if k < 0 => "neg"
    _ => "many"
  }
}
fn greet(s: Text) -> i64 {
  match s {
    "hi" => 1
    "bye" => 2
    _ => 0
  }
}
perform show("id", id(5))
perform show("idt", id("t"))
perform show("pair", pair(1, "a"))
perform show("apply", apply((x) => x * 2, 21))
let h = compose((x) => x + 1, (y) => y * 10)
perform show("compose", h(4))
perform show("fold", fold(Cons(1, Cons(2, Cons(3, Nil))), 0, (a, b) => a + b))
perform show("c0", classify(0))
perform show("c1", classify(1))
perform show("c-", classify(0 - 5))
perform show("c9", classify(9))
perform show("g1", greet("hi"))
perform show("g2", greet("bye"))
perform show("g3", greet("x"))
var n = 0
let bump = () => { n := n + 1 }
bump()
bump()
perform show("n", n)
```
rust_shows = [
  "id = 5",
  "idt = \"t\"",
  "pair = Pair { fst: 1, snd: \"a\" }",
  "apply = 42",
  "compose = 50",
  "fold = 6",
  "c0 = \"zero\"",
  "c1 = \"one\"",
  "c- = \"neg\"",
  "c9 = \"many\"",
  "g1 = 1",
  "g2 = 2",
  "g3 = 0",
  "n = 2",
]

@ cases.vec-buf-map
source = ```nib
fn show_all(&v: Vec(i64)) -> i64 ! {out_of_bounds, Div} {
  var i: u64 = 0
  var s = 0
  while i < vec_len(&v) {
    let &x = vec_index(&v, i)
    s := s + x
    i := i + 1
  }
  s
}
var items = vec_new()
vec_push(&mut items, 5)
vec_push(&mut items, 7)
perform show("sum", handle { show_all(&items) } with { out_of_bounds() => 0 })
perform show("items", items)
var b = buf_new()
buf_push(&mut b, "ab")
buf_push(&mut b, "cd")
let t = text_of(b)
perform show("t", t)
var m = hashmap_new()
hashmap_insert(&mut m, "a", 1)
hashmap_insert(&mut m, "b", 2)
let r = handle { hashmap_index(&m, "b") } with { missing() => 0 }
perform show("r", r)
let miss = handle { hashmap_index(&m, "zz") } with { missing() => 0 - 1 }
perform show("miss", miss)
perform show("m", m)
```
shows = [
  "sum = 12",
  "items = Vec[5, 7]",
  "t = \"abcd\"",
  "r = 2",
  "miss = -1",
  "m = HashMap{\"a\": 1, \"b\": 2}",
]

@ cases.linear-and-borrowed-enums
source = ```nib
linear struct Handle { id: i64 }
fn open(n: i64) -> Handle { Handle { id: n } }
fn close(h: Handle) -> i64 {
  match h {
    Handle { id } => id
  }
}
let h = open(3)
perform show("closed", close(h))
affine struct Box2 { v: i64 }
fn unbox(b: Box2) -> i64 { match b { Box2 { v } => v } }
perform show("u", unbox(Box2 { v: 8 }))
enum E { A(i64), B(Text) }
fn f(e: &E) -> i64 { match e { A(n) => n, B(t) => 0 } }
let e = A(4)
perform show("f", f(&e))
perform show("f2", f(&B("z")))
```
shows = [
  "closed = 3",
  "u = 8",
  "f = 4",
  "f2 = 0",
]

@ cases.fail-raise-catch-and-forwarding
source = ```nib
fn safe_div(a: i64, b: i64) -> Result(i64, Text) {
  if b == 0 { Err("div0") } else { Ok(div(a, b)) }
}
fn compute(a: i64, b: i64) -> i64 ! {fail} {
  raise(safe_div(a, b)) + 1
}
let ok = catch(() => compute(10, 2))
let bad = catch(() => compute(1, 0))
perform show("ok", ok)
perform show("bad", bad)
fn first(r: Result(i64, Text)) -> i64 {
  match r { Ok(v) => v, Err(e) => 0 }
}
perform show("first", first(ok))
let nested = catch(() => {
  let a = raise(safe_div(8, 2))
  let b = raise(safe_div(a, 0))
  a + b
})
perform show("nested", nested)
effect warn: (m: Text) -> () direct
fn work() -> i64 ! {warn} {
  perform warn("one")
  perform warn("two")
  5
}
let w = handle { handle { work() } with { warn(m), k => { perform show("inner", m); k(()) } } } with { warn(m), k => k(()) }
perform show("w", w)
let w2 = handle { handle { work() } with { warn(m), k => { perform warn(m); k(()) } } } with { warn(m), k => { perform show("outer", m); k(()) } }
perform show("w2", w2)
```
shows = [
  "ok = Ok(6)",
  "bad = Err(\"div0\")",
  "first = 6",
  "nested = Err(\"div0\")",
  "inner = \"one\"",
  "inner = \"two\"",
  "w = 5",
  "outer = \"one\"",
  "outer = \"two\"",
  "w2 = 5",
]

