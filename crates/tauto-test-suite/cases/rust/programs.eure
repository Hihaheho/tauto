@ cases.a-state-handler-passes-k-in-a-function
source = ```nib
effect get: () -> i64
effect put: (s: i64) -> ()
fn incr() -> i64 ! {get, put} {
  let s = perform get()
  perform put(s + 1)
  let t = perform get()
  perform put(t + 10)
  perform get()
}
let run = handle { incr() } with {
  get(), k => (s) => k(s)(s)
  put(s2), k => (s) => k(())(s2)
  return v => (s) => v
}
perform show("state", run(5))
```
