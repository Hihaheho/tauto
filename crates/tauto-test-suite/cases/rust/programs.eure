source = ```nib
effect choose: () -> Bool resume ω
fn apply<e>(f: () -> i64 ! {|e}) -> i64 ! {|e} { f() }
fn twice<e>(f: (i64) -> i64 ! {|e}, x: i64) -> i64 ! {|e} { f(f(x)) }
fn mk(n: i64) -> i64 ! {choose} {
  twice(x => if perform choose() { x + n } else { x * 2 }, 1)
}
