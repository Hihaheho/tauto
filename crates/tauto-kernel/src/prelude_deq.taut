// The decisions on `Bool` and the lemmas that connect `Nat::eq`, `Bool::eq` and
// `Bool::and` to equality: what the decidable equality an inductive lists
// (`=> fn T::beq, theorem T::beq_refl, theorem T::beq_sound, theorem T::deq`)
// is generated from. They are here, not in a library, so that an inductive
// gets its decidable equality without importing anything.

fn Bool::and(a: Bool, b: Bool): Bool {
  match a {
    false => false
    true => b
  }
}

// `a || b`: the operator reads as this function wherever `a && b` reads as `Bool::and`.
fn Bool::or(a: Bool, b: Bool): Bool {
  match a {
    false => b
    true => true
  }
}

fn not(a: Bool): Bool {
  match a {
    false => true
    true => false
  }
}

fn Bool::eq(a: Bool, b: Bool): Bool {
  match a {
    false => not(b)
    true => b
  }
}

theorem Bool::eq_refl(a: Bool): (Bool::eq(a, a) = true) {
  match a {
    false => Refl
    true => Refl
  }
}

theorem true_ne_false(e: true = false): False {
  match e {
  }
}

theorem Nat::eq_refl(n: Nat): (Nat::eq(n, n) = true) {
  match n {
    Zero => Refl
    Succ(k) => Nat::eq_refl(k)
  }
}

theorem Nat::eq_sound(a: Nat, b: Nat, e: Nat::eq(a, b) = true): (a = b) {
  match a {
    Zero => ⊢ (Zero = b) from match b {
      Zero => Refl
      Succ(b2) => False::elim(true_ne_false(Eq::sym(e)))
    }
    Succ(a2) => ⊢ (Succ(a2) = b) from match b {
      Zero => False::elim(true_ne_false(Eq::sym(e)))
      Succ(b2) => Eq::congr(Succ, Nat::eq_sound(a2, b2, e))
    }
  }
}

theorem false_ne_true(e: false = true): False {
  true_ne_false(Eq::sym(e))
}

theorem Bool::eq_sound(a: Bool, b: Bool, e: Bool::eq(a, b) = true): (a = b) {
  match a {
    false => ⊢ false = b from match b {
      false => Refl
      true => False::elim(false_ne_true(e))
    }
    true => ⊢ true = b from match b {
      false => False::elim(false_ne_true(e))
      true => Refl
    }
  }
}

theorem Bool::and_intro(
  p: Bool,
  q: Bool,
  hp: p = true,
  hq: q = true
): (Bool::and(p, q) = true) {
  match p {
    false => False::elim(false_ne_true(hp))
    true => hq
  }
}

theorem Bool::and_split(
  p: Bool,
  q: Bool,
  e: Bool::and(p, q) = true
): And(p = true, q = true) {
  match p {
    false => False::elim(false_ne_true(e))
    true => AndIntro(Refl, e)
  }
}
