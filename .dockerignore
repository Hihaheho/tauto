# Allowlist: only what `cargo build -p tauto-cli` reads.
*

!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!.cargo/config.toml

!crates/**/*.rs
!crates/**/Cargo.toml
!tools/selfhost-harness/Cargo.toml
!tools/selfhost-harness/**/*.rs

# Members of the root workspace: cargo loads every member manifest and its targets.
!tools/tauto-test-suite/Cargo.toml
!tools/tauto-test-suite/src/**/*.rs
!tools/tauto-test-suite/tests/**/*.rs
!tools/tauto-test-suite/benches/**/*.rs
!tools/lsp-bench/Cargo.toml
!tools/lsp-bench/src/**/*.rs
!totes/*/bridge/Cargo.toml
!totes/*/bridge/src/**/*.rs

!crates/**/*.js
!crates/tauto-parol/*.par
!crates/tauto-kernel/src/*.taut
!crates/tauto-jsgen/src/*.wasm
!crates/tauto-messages/locales/**/*.ftl
# std/*.taut and std/prelude/*.taut are compiled in (include_str!).
!std/**/*.taut
# Build scripts of the tauto-cli-tote-* crates, tauto-analyzer and totebag-index compile these totes.
!totes/**/*.eure
!totes/**/*.taut
!totes/**/*.txt
!**/.tauto-syntax/*.tables
