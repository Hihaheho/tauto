= `$types.case`
$types {
  diagnostic {
    stage = `text`
    stage.$optional = true
    name = `text`
    name.$optional = true
    file = `text`
    file.$optional = true
    message = `text`
    message.$optional = true
    span = `text`
    span.$optional = true
    fix = `text`
    fix.$optional = true
    fix_span = `text`
    fix_span.$optional = true
    fixed_source = `text`
    fixed_source.$optional = true
  }
  hole {
    declaration = `text`
    declaration.$optional = true
    name = `text`
    name.$optional = true
    file = `text`
    file.$optional = true
    goal = `text`
    goal.$optional = true
    context = [`text`]
    context.$optional = true
  }
  fix-run {
    lint = `boolean`
    lint.$optional = true
    applied = [`text`]
    applied.$optional = true
    reverted = [`text`]
    reverted.$optional = true
    diff = `text`
    diff.$optional = true
    @ files
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
  }
  proof-view {
    name = `text`
    name.$optional = true
    format = `text`
    format.$optional = true
    output = `text`
    output.$optional = true
    error = `text`
    error.$optional = true
    failed = `boolean`
    failed.$optional = true
    incomplete = `boolean`
    incomplete.$optional = true
    full = `boolean`
    full.$optional = true
  }
  hover-view {
    at = `text`
    at.$optional = true
    occurrence = `integer`
    occurrence.$optional = true
    contains = [`text`]
    contains.$optional = true
    absent = `boolean`
    absent.$optional = true
    proof = `text`
    proof.$optional = true
    proof_file = `text`
    proof_file.$optional = true
    @ buffers
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
  }
  unimplemented-mark {
    $variant = "union"
    variants = { flag => `boolean`, reason => `text` }
  }
  fixture {
    source = `text`
    source.$optional = true
    reason = `text`
    reason.$optional = true
  }
  case {
    source = `text`
    source.$optional = true
    tote = `text`
    tote.$optional = true
    files_tote = `text`
    files_tote.$optional = true
    entry = `text`
    entry.$optional = true
    imports = [`text`]
    imports.$optional = true
    extract = `boolean`
    extract.$optional = true
    extract_source = `boolean`
    extract_source.$optional = true
    a = [`text`]
    a.$optional = true
    b = [`text`]
    b.$optional = true
    equal = `boolean`
    equal.$optional = true
    parses = `boolean`
    parses.$optional = true
    types = `text`
    types.$optional = true
    rows = `text`
    rows.$optional = true
    rows_javascript = `text`
    rows_javascript.$optional = true
    lin = `text`
    lin.$optional = true
    format = `text`
    format.$optional = true
    format_error = `text`
    format_error.$optional = true
    format_literals = `text`
    format_literals.$optional = true
    format_literals_warnings = [`text`]
    format_literals_warnings.$optional = true
    editor_tokens = [`text`]
    editor_tokens.$optional = true
    editor_token_warnings = [`text`]
    editor_token_warnings.$optional = true
    lint = [`text`]
    lint.$optional = true
    tote_warnings = [`text`]
    tote_warnings.$optional = true
    tote_errors = [`text`]
    tote_errors.$optional = true
    checks_all = `text`
    checks_all.$optional = true
    declarations = [`text`]
    declarations.$optional = true
    diagnostics = [`$types.diagnostic`]
    diagnostics.$optional = true
    holes = [`$types.hole`]
    holes.$optional = true
    shows = [`text`]
    shows.$optional = true
    tests = [`text`]
    tests.$optional = true
    stdout = `text`
    stdout.$optional = true
    stderr = `text`
    stderr.$optional = true
    exit = `integer`
    exit.$optional = true
    run_error = `text`
    run_error.$optional = true
    drops = [`text`]
    drops.$optional = true
    probe_drops = [`text`]
    probe_drops.$optional = true
    budget = `integer`
    budget.$optional = true
    rust_budget_steps = `integer`
    rust_budget_steps.$optional = true
    args = [`text`]
    args.$optional = true
    permissions = [`text`]
    permissions.$optional = true
    macro_error = `text`
    macro_error.$optional = true
    load_error = `text`
    load_error.$optional = true
    expands = `text`
    expands.$optional = true
    trace = [`text`]
    trace.$optional = true
    rust_shows = [`text`]
    rust_shows.$optional = true
    rust_error = `text`
    rust_error.$optional = true
    build = `text`
    build.$optional = true
    rust = `text`
    rust.$optional = true
    backends = [`text`]
    backends.$optional = true
    differential = `text`
    differential.$optional = true
    javascript_shows = [`text`]
    javascript_shows.$optional = true
    javascript_error = `text`
    javascript_error.$optional = true
    selfhost_entry = `text`
    selfhost_entry.$optional = true
    selfhost_stdout = `text`
    selfhost_stdout.$optional = true
    selfhost_compile_error = `text`
    selfhost_compile_error.$optional = true
    selfhost_run_error = `text`
    selfhost_run_error.$optional = true
    fixes = `$types.fix-run`
    fixes.$optional = true
    proofs = [`$types.proof-view`]
    proofs.$optional = true
    hovers = [`$types.hover-view`]
    hovers.$optional = true
    unimplemented = `$types.unimplemented-mark`
    unimplemented.$optional = true
    scenarios = [`text`]
    scenarios.$optional = true
    description = `text`
    description.$optional = true
    @ files
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ inferred_types
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ inferred_rows
    $variant = "map"
    $optional = true
    key = `text`
    value = [`text`]
    @ inferred_kinds
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ checks
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ evals
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ links
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ extracted_nib
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ compile_errors
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ backend_known_failure
    $variant = "map"
    $optional = true
    key = `text`
    value = `text`
    @ cases
    $variant = "map"
    $optional = true
    key = `text`
    value = `$types.case`
    @ fixtures
    $variant = "map"
    $optional = true
    key = `text`
    value = `$types.fixture`
  }
}
