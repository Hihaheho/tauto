import "../../../../totes/identity/src/identity.taut"
import "../../../../totes/nibcheck/src/modules.taut"
import "../../../../totes/surface/src/surface.taut"
import std::map
import std::text
import std::builtin::os
import "../../../../totes/text/src/text.taut"
import "../../../../totes/nibcheck/src/modules_head.taut"

fn scope_term(name: Text): SurfaceTerm {
  SurfaceTerm { occurrence: None, kind: SkVar(NameSpelled(name)), start: 0, end: 1 }
}

fn scope_name(term: SurfaceTerm): Text {
  match term.kind { SkVar(name) => surface_name_text(name)
    _ => "not a name" }
}

fn scope_print(label: Text, value: Text): () ! {stdout} {
  print(Text::concat_all(Cons(label, Cons(" = ", Cons(value, Cons(text_newline(), Nil))))))
}

perform main(() => {
  var state := ModState {
    modules: Ordmap::insert(Ordmap::empty(), "M", true, Ordmap::compare_text),
    fns: Ordmap::insert(Ordmap::empty(), "M::f", true, Ordmap::compare_text),
    types: Ordmap::empty(),
    ctors: Ordmap::empty(),
    ctor_fulls: Ordmap::empty(),
    locals: Nil,
    errors: Nil
  }
  let path := Cons("M", Nil)
  let function := SurfaceFn {
    name: "g", generics: Nil, generic_types: Nil, bounds: Nil, params: Cons("f", Nil),
    r#borrows: Nil, param_types: Nil, result: None, effects: None, wheres: Nil,
    start: 0, end: 1, body: scope_term("f"), lends: None, bound_starts: Nil, visibility: VisPrivate,
    row_hole: None, unused: None, unused_generics: Nil, unused_params: Nil
  }
  let resolved := mod_fn(function, &mut state, path)
  scope_print("argument", scope_name(resolved.body))
  let lambda := mod_term(
    SurfaceTerm { occurrence: None, kind: SkLam(Cons("f", Nil), scope_term("f"), Nil, Nil), start: 0, end: 1 },
    &mut state,
    path
  )
  scope_print("lambda", ⊢ Text from match lambda.kind { SkLam(params, body, _, _) => scope_name(body)
      _ => "not a lambda" })
  let arm := mod_arm(
    SurfaceArm { pattern: PtBind("f", None), guard: None, goal: None, body: scope_term("f") },
    &mut state,
    path
  )
  scope_print("pattern", scope_name(arm.body))
  let handler := mod_handler(HdReturn(PtBind("f", None), scope_term("f")), &mut state, path)
  scope_print("handler", ⊢ Text from match handler { HdReturn(pattern, body) => scope_name(body)
      _ => "not a return" })
  let block := mod_term(
    SurfaceTerm { occurrence: None, kind: SkBlock(
      Cons(StLet("f", None, scope_term("f"), false, false, None, None), Cons(StExpr(scope_term("f")), Nil))
    ), start: 0, end: 1 },
    &mut state,
    path
  )
  scope_print("block", ⊢ Text from match block.kind {
    SkBlock(Cons(StLet(name, ty, initial, r#borrow, mutable, unused, stack), Cons(StExpr(value), Nil))) => Text::concat_all(Cons(scope_name(initial), Cons("/", Cons(scope_name(value), Nil))))
    _ => "not a block"
  })
  let after := mod_term(scope_term("f"), &mut state, path)
  scope_print("after", scope_name(after))
})
