import "../../../../totes/nibcheck/src/modules.taut"

fn scope_term(name: Text): SurfaceTerm {
  SurfaceTerm { kind: SkVar(name), start: 0, end: 1 }
}

fn scope_name(term: SurfaceTerm): Text {
  match term.kind: Text { SkVar(name) => name
    _ => "not a name" }
}

fn scope_print(label: Text, value: Text): () {
  print(Text.concat_all(Cons(label, Cons(" = ", Cons(value, Cons(text_newline(), Nil))))))
}

var state := ModState {
  modules: Ordmap.insert(Ordmap.empty(), "M", true, Ordmap.compare_text),
  fns: Ordmap.insert(Ordmap.empty(), "M.f", true, Ordmap.compare_text),
  locals: Nil,
  errors: Nil
}
let path := Cons("M", Nil)
let function := SurfaceFn {
  name: "g", generics: Nil, bounds: Nil, params: Cons("f", Nil),
  borrows: Nil, param_types: Nil, result: None, effects: None, wheres: Nil,
  start: 0, end: 1, body: scope_term("f")
}
let resolved := mod_fn(function, &mut state, path)
scope_print("argument", scope_name(resolved.body))
let lambda := mod_term(
  SurfaceTerm { kind: SkLam(Cons("f", Nil), scope_term("f")), start: 0, end: 1 },
  &mut state,
  path
)
scope_print("lambda", match lambda.kind: Text { SkLam(params, body) => scope_name(body)
    _ => "not a lambda" })
let arm := mod_arm(
  SurfaceArm { pattern: PtBind("f"), guard: None, goal: None, body: scope_term("f") },
  &mut state,
  path
)
scope_print("pattern", scope_name(arm.body))
let handler := mod_handler(HdReturn(PtBind("f"), scope_term("f")), &mut state, path)
scope_print("handler", match handler: Text { HdReturn(pattern, body) => scope_name(body)
    _ => "not a return" })
let block := mod_term(
  SurfaceTerm { kind: SkBlock(
    Cons(StLet("f", None, scope_term("f"), false, false), Cons(StExpr(scope_term("f")), Nil))
  ), start: 0, end: 1 },
  &mut state,
  path
)
scope_print("block", match block.kind: Text {
  SkBlock(Cons(StLet(name, ty, initial, borrow, mutable), Cons(StExpr(value), Nil))) => Text.concat_all(Cons(scope_name(initial), Cons("/", Cons(scope_name(value), Nil))))
  _ => "not a block"
})
let after := mod_term(scope_term("f"), &mut state, path)
scope_print("after", scope_name(after))
